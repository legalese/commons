IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cp4-nouns`
IMPORT `cp4-assignment`

-- Tests of sections 65 and 65.1. Every expected value is worked out by hand from the text, as written beside
-- the assertion. All amounts and dates are invented.

§ `Tests -- sections 65 and 65.1`


§§ `Section 65(1) and (1.1)`

-- An assignment of a benefit is void unless the Minister approved it under section 65.1.
#ASSERT `s 65(1) — the transaction is void` `an assignment of a benefit` FALSE EQUALS TRUE
-- An assignment the Minister approved under section 65.1 is not void.
#ASSERT `s 65(1) — the transaction is void` `an assignment of a benefit` TRUE EQUALS FALSE
#ASSERT `s 65(1) — the transaction is void` `a charge on a benefit` FALSE EQUALS TRUE
#ASSERT `s 65(1) — the transaction is void` `an attachment of a benefit` FALSE EQUALS TRUE
#ASSERT `s 65(1) — the transaction is void` `an anticipation of a benefit` FALSE EQUALS TRUE
#ASSERT `s 65(1) — the transaction is void` `a giving of a benefit as security` FALSE EQUALS TRUE
-- The Minister's approval under section 65.1 is of an assignment only.
#ASSERT `s 65(1) — the transaction is void` `a charge on a benefit` TRUE EQUALS TRUE
#ASSERT `s 65(1) — the transaction is void` `another transaction in a benefit` FALSE EQUALS FALSE
#ASSERT `s 65(1.1) — the benefit is exempt from seizure and execution` TRUE EQUALS JUST TRUE
#ASSERT `s 65(1.1) — the benefit is exempt from seizure and execution` FALSE EQUALS NOTHING

§§ `Section 65(2) and (3)`

-- A welfare payment of 400 that would not have been made had the benefit been paid; the benefit for the period is 1000.
#ASSERT `s 65(2) — the most the Minister may deduct from the benefit and pay to the provincial or municipal authority` TRUE TRUE TRUE 400 1000 EQUALS JUST 400
-- The advance exceeds the benefit: no more than the benefit can be deducted from it.
#ASSERT `s 65(2) — the most the Minister may deduct from the benefit and pay to the provincial or municipal authority` TRUE TRUE TRUE 1500 1000 EQUALS JUST 1000
#ASSERT `s 65(2) — the most the Minister may deduct from the benefit and pay to the provincial or municipal authority` FALSE TRUE TRUE 400 1000 EQUALS NOTHING
#ASSERT `s 65(2) — the most the Minister may deduct from the benefit and pay to the provincial or municipal authority` TRUE FALSE TRUE 400 1000 EQUALS NOTHING
#ASSERT `s 65(2) — the most the Minister may deduct from the benefit and pay to the provincial or municipal authority` TRUE TRUE FALSE 400 1000 EQUALS NOTHING
-- A payment of 300 under a disability income program; consent and record received within a year; more than $50.
#ASSERT `s 65(3) — the most the Minister may deduct from the benefit and pay to the administrator of a disability income program` `a disability pension` TRUE TRUE TRUE TRUE TRUE 300 1000 TRUE EQUALS JUST 300
#ASSERT `s 65(3) — the most the Minister may deduct from the benefit and pay to the administrator of a disability income program` `a post-retirement disability benefit` TRUE TRUE TRUE TRUE TRUE 300 1000 TRUE EQUALS JUST 300
-- The payment is more than the benefit: no more than the benefit.
#ASSERT `s 65(3) — the most the Minister may deduct from the benefit and pay to the administrator of a disability income program` `a disability pension` TRUE TRUE TRUE TRUE TRUE 300 200 TRUE EQUALS JUST 200
-- Regulation 76.1(1)(c): the amount must exceed $50; 50 does not.
#ASSERT `s 65(3) — the most the Minister may deduct from the benefit and pay to the administrator of a disability income program` `a disability pension` TRUE TRUE TRUE TRUE TRUE 50 1000 TRUE EQUALS NOTHING
#ASSERT `s 65(3) — the most the Minister may deduct from the benefit and pay to the administrator of a disability income program` `a disability pension` TRUE TRUE TRUE TRUE TRUE 50.01 1000 TRUE EQUALS JUST 50.01
-- Only a benefit under paragraph 44(1)(b) or (h).
#ASSERT `s 65(3) — the most the Minister may deduct from the benefit and pay to the administrator of a disability income program` `a retirement pension` TRUE TRUE TRUE TRUE TRUE 300 1000 TRUE EQUALS NOTHING
-- The administrator is not approved by the Minister.
#ASSERT `s 65(3) — the most the Minister may deduct from the benefit and pay to the administrator of a disability income program` `a disability pension` FALSE TRUE TRUE TRUE TRUE 300 1000 TRUE EQUALS NOTHING
#ASSERT `s 65(3) — the most the Minister may deduct from the benefit and pay to the administrator of a disability income program` `a disability pension` TRUE FALSE TRUE TRUE TRUE 300 1000 TRUE EQUALS NOTHING
#ASSERT `s 65(3) — the most the Minister may deduct from the benefit and pay to the administrator of a disability income program` `a disability pension` TRUE TRUE FALSE TRUE TRUE 300 1000 TRUE EQUALS NOTHING
-- No record and consent from the administrator.
#ASSERT `s 65(3) — the most the Minister may deduct from the benefit and pay to the administrator of a disability income program` `a disability pension` TRUE TRUE TRUE FALSE TRUE 300 1000 TRUE EQUALS NOTHING
-- Documents not received within a year of the consent.
#ASSERT `s 65(3) — the most the Minister may deduct from the benefit and pay to the administrator of a disability income program` `a disability pension` TRUE TRUE TRUE TRUE FALSE 300 1000 TRUE EQUALS NOTHING
-- Another deduction and payment has already been authorized for the payment (regulation 76.1(2)).
#ASSERT `s 65(3) — the most the Minister may deduct from the benefit and pay to the administrator of a disability income program` `a disability pension` TRUE TRUE TRUE TRUE TRUE 300 1000 FALSE EQUALS NOTHING

§§ `Section 65.1(3) and (4) -- agreements and court orders`

-- An agreement of 1990 expressly mentions the Act and the intention of no assignment, is permitted by provincial law, was made before the application and has not been invalidated.
#ASSERT `s 65.1(4) — a provision of the agreement binds the Minister, who shall not approve an assignment` (YMD 1990 1 1) TRUE TRUE (YMD 1995 1 1) FALSE EQUALS TRUE
-- Entered into on 4 June 1986: on or after that day.
#ASSERT `s 65.1(4) — a provision of the agreement binds the Minister, who shall not approve an assignment` (YMD 1986 6 4) TRUE TRUE (YMD 1995 1 1) FALSE EQUALS TRUE
-- 3 June 1986: before the day.
#ASSERT `s 65.1(4) — a provision of the agreement binds the Minister, who shall not approve an assignment` (YMD 1986 6 3) TRUE TRUE (YMD 1995 1 1) FALSE EQUALS FALSE
-- No provision that expressly mentions the Act and the intention.
#ASSERT `s 65.1(4) — a provision of the agreement binds the Minister, who shall not approve an assignment` (YMD 1990 1 1) FALSE TRUE (YMD 1995 1 1) FALSE EQUALS FALSE
-- Not permitted by provincial law.
#ASSERT `s 65.1(4) — a provision of the agreement binds the Minister, who shall not approve an assignment` (YMD 1990 1 1) TRUE FALSE (YMD 1995 1 1) FALSE EQUALS FALSE
-- Entered into on the day of the application: not before it.
#ASSERT `s 65.1(4) — a provision of the agreement binds the Minister, who shall not approve an assignment` (YMD 1995 1 1) TRUE TRUE (YMD 1995 1 1) FALSE EQUALS FALSE
#ASSERT `s 65.1(4) — a provision of the agreement binds the Minister, who shall not approve an assignment` (YMD 1995 1 2) TRUE TRUE (YMD 1995 1 1) FALSE EQUALS FALSE
-- Invalidated by a court order.
#ASSERT `s 65.1(4) — a provision of the agreement binds the Minister, who shall not approve an assignment` (YMD 1990 1 1) TRUE TRUE (YMD 1995 1 1) TRUE EQUALS FALSE
-- Entered into after 3 June 1986 and subsection (4) does not apply: not binding.
#ASSERT `s 65.1(3) — the provisions of the agreement or court order are not binding on the Minister` (YMD 1990 1 1) FALSE EQUALS JUST TRUE
-- Subsection (4) applies: binding.
#ASSERT `s 65.1(3) — the provisions of the agreement or court order are not binding on the Minister` (YMD 1990 1 1) TRUE EQUALS JUST FALSE
#ASSERT `s 65.1(3) — the provisions of the agreement or court order are not binding on the Minister` (YMD 1986 6 4) FALSE EQUALS JUST TRUE
-- Before 4 June 1986: the subsection does not speak of it.
#ASSERT `s 65.1(3) — the provisions of the agreement or court order are not binding on the Minister` (YMD 1986 6 3) FALSE EQUALS NOTHING

§§ `Section 65.1(6) and (7) -- double and single assignment`

-- A retirement pension is payable to both under the Act.
#ASSERT `s 65.1(6) — the circumstances of a double assignment exist` TRUE FALSE FALSE EQUALS TRUE
-- One under the Act and one under a provincial plan, and an agreement under section 80 provides for assignment.
#ASSERT `s 65.1(6) — the circumstances of a double assignment exist` FALSE TRUE TRUE EQUALS TRUE
#ASSERT `s 65.1(6) — the circumstances of a double assignment exist` FALSE TRUE FALSE EQUALS FALSE
#ASSERT `s 65.1(6) — the circumstances of a double assignment exist` FALSE FALSE TRUE EQUALS FALSE
#ASSERT `s 65.1(6) — the circumstances of a double assignment exist` FALSE FALSE FALSE EQUALS FALSE
-- The non-contributor, born 5 May 1960, reaches 60 on 5 May 2020 and is deemed to on 1 June 2020.
#ASSERT `s 65.1(7) — the circumstances of a single assignment exist` TRUE TRUE (YMD 1960 5 5) (YMD 2020 6 1) EQUALS TRUE
#ASSERT `s 65.1(7) — the circumstances of a single assignment exist` TRUE TRUE (YMD 1960 5 5) (YMD 2020 5 31) EQUALS FALSE
#ASSERT `s 65.1(7) — the circumstances of a single assignment exist` FALSE TRUE (YMD 1960 5 5) (YMD 2020 6 1) EQUALS FALSE
#ASSERT `s 65.1(7) — the circumstances of a single assignment exist` TRUE FALSE (YMD 1960 5 5) (YMD 2020 6 1) EQUALS FALSE
#ASSERT `s 65.1(6) and (7) — the pensions the assignment is made in respect of` TRUE FALSE EQUALS `both retirement pensions`
#ASSERT `s 65.1(6) and (7) — the pensions the assignment is made in respect of` FALSE TRUE EQUALS `only the contributor's retirement pension`
#ASSERT `s 65.1(6) and (7) — the pensions the assignment is made in respect of` FALSE FALSE EQUALS `no assignment, for neither set of circumstances exists`
#ASSERT `s 65.1(1) — the Minister may approve the assignment` TRUE TRUE FALSE EQUALS TRUE
#ASSERT `s 65.1(1) — the Minister may approve the assignment` FALSE TRUE FALSE EQUALS FALSE
#ASSERT `s 65.1(1) — the Minister may approve the assignment` TRUE FALSE FALSE EQUALS FALSE
-- A binding agreement: the Minister shall not approve.
#ASSERT `s 65.1(1) — the Minister may approve the assignment` TRUE TRUE TRUE EQUALS FALSE
#ASSERT `s 65.1(5) — the Minister must at once notify the other spouse or common-law partner` TRUE EQUALS TRUE
#ASSERT `s 65.1(5) — the Minister must at once notify the other spouse or common-law partner` FALSE EQUALS FALSE

§§ `Section 65.1(8) -- definitions`

-- Both contributors; the elder (born 10 March 1950) is 18 on 10 March 1968, deemed so from April 1968; the later of the two contributory periods ends in May 2012: April 1968 to May 2012, 530 months. Subsection (6) does not apply, so the 10 excluded months are not subtracted.
#ASSERT `s 65.1(8) — the number of months in the joint contributory period` (YMD 1950 3 10) (YMD 1952 7 20) TRUE (YMD 2012 5 1) (YMD 2005 12 1) (YMD 1952 7 20) (YMD 2013 3 1) FALSE 10 EQUALS 530
-- Subsection (6) applies: the 10 months excluded from the contributory period of both are subtracted.
#ASSERT `s 65.1(8) — the number of months in the joint contributory period` (YMD 1950 3 10) (YMD 1952 7 20) TRUE (YMD 2012 5 1) (YMD 2005 12 1) (YMD 1952 7 20) (YMD 2013 3 1) TRUE 10 EQUALS 520
-- Only one is a contributor, whose period ends December 2005; the non-contributor (born 20 July 1952) is 70 in July 2022 and the application is approved in March 2013, the earlier; the later of December 2005 and March 2013 is March 2013: April 1968 to March 2013, 540 months.
#ASSERT `s 65.1(8) — the number of months in the joint contributory period` (YMD 1950 3 10) (YMD 1952 7 20) FALSE (YMD 2012 5 1) (YMD 2005 12 1) (YMD 1952 7 20) (YMD 2013 3 1) FALSE 0 EQUALS 540
-- The elder is 18 in 1958, before 1966, so the period starts January 1966; the non-contributor (born 15 January 1940) is 70 in January 2010, deemed so from February 2010, earlier than the approval; the later of December 2005 and February 2010 is February 2010: January 1966 to February 2010, 530 months.
#ASSERT `s 65.1(8) — the number of months in the joint contributory period` (YMD 1940 1 15) (YMD 1945 6 1) FALSE (YMD 2012 5 1) (YMD 2005 12 1) (YMD 1940 1 15) (YMD 2013 3 1) FALSE 0 EQUALS 530
-- The elder was 18 long before 2019, so the period starts January 2019 and, both being contributors, ends June 2024: 66 months.
#ASSERT `s 65.1(8) — the number of months in the first additional joint contributory period` (YMD 1980 1 1) (YMD 1985 6 15) TRUE (YMD 2024 6 1) (YMD 2024 6 1) (YMD 1985 6 15) (YMD 2024 7 1) EQUALS 66
-- Starts January 2024, ends June 2024: 6 months.
#ASSERT `s 65.1(8) — the number of months in the second additional joint contributory period` (YMD 1980 1 1) (YMD 1985 6 15) TRUE (YMD 2024 6 1) (YMD 2024 6 1) (YMD 1985 6 15) (YMD 2024 7 1) EQUALS 6
-- The later contributory period ends before the period starts: no months.
#ASSERT `s 65.1(8) — the number of months in the second additional joint contributory period` (YMD 1980 1 1) (YMD 1985 6 15) TRUE (YMD 2023 6 1) (YMD 2023 6 1) (YMD 1985 6 15) (YMD 2024 7 1) EQUALS 0
-- Marriage solemnized in August 1990; they cohabited to May 2012, the month the joint contributory period ends: August 1990 to May 2012, 262 months.
#ASSERT `s 65.1(8) — the number of months in the period of cohabitation` (YMD 1990 8 20) (YMD 2012 5 15) (YMD 1968 4 1) (YMD 2012 5 1) EQUALS 262
-- Cohabitation continued to January 2015, but the period is deemed to end with the month the joint contributory period ends.
#ASSERT `s 65.1(8) — the number of months in the period of cohabitation` (YMD 1990 8 20) (YMD 2015 1 15) (YMD 1968 4 1) (YMD 2012 5 1) EQUALS 262
-- Cohabitation began before the joint contributory period: no month outside it is counted.
#ASSERT `s 65.1(8) — the number of months in the period of cohabitation` (YMD 1960 1 10) (YMD 2012 5 15) (YMD 1968 4 1) (YMD 2012 5 1) EQUALS 530
-- All the cohabitation is outside the joint contributory period.
#ASSERT `s 65.1(8) — the number of months in the period of cohabitation` (YMD 2015 1 10) (YMD 2016 5 15) (YMD 1968 4 1) (YMD 2012 5 1) EQUALS 0

§§ `Section 65.1(9) -- the portion assigned`

#ASSERT `cp4 a term of the portion assigned` 600 262 530 EQUALS JUST (600 TIMES 0.5 TIMES 262 DIVIDED BY 530)
-- A nil portion gives a nil term whatever the months.
#ASSERT `cp4 a term of the portion assigned` 0 262 0 EQUALS JUST 0
-- A portion with no months in its joint contributory period: no ratio.
#ASSERT `cp4 a term of the portion assigned` 100 262 0 EQUALS NOTHING
-- Five months of cohabitation: 50% of 5/530 of 600, of 5/66 of 100 and of 5/6 of 40.
#ASSERT `s 65.1(9) — the portion of the contributor's retirement pension to be assigned` (`cp4 Retirement pension portions` OF 600, 100, 40) 5 530 66 6 EQUALS JUST ((600 TIMES 0.5 TIMES 5 DIVIDED BY 530) PLUS (100 TIMES 0.5 TIMES 5 DIVIDED BY 66) PLUS (40 TIMES 0.5 TIMES 5 DIVIDED BY 6))
-- FINDING: the same 262 months of cohabitation are divided by the shorter first and second additional joint contributory periods (66 and 6 months), so the ratios exceed 1 and the portion assigned of the first additional portion (about 198) is above the portion itself (100). The text says so, and nothing caps it.
#ASSERT `s 65.1(9) — the portion of the contributor's retirement pension to be assigned` (`cp4 Retirement pension portions` OF 600, 100, 40) 262 530 66 6 EQUALS JUST ((600 TIMES 0.5 TIMES 262 DIVIDED BY 530) PLUS (100 TIMES 0.5 TIMES 262 DIVIDED BY 66) PLUS (40 TIMES 0.5 TIMES 262 DIVIDED BY 6))
-- A pension with no first or second additional portion: those terms are nil, though their periods are empty.
#ASSERT `s 65.1(9) — the portion of the contributor's retirement pension to be assigned` (`cp4 Retirement pension portions` OF 600, 0, 0) 262 530 0 0 EQUALS JUST (600 TIMES 0.5 TIMES 262 DIVIDED BY 530)
#ASSERT `s 65.1(9) — the portion of the contributor's retirement pension to be assigned` (`cp4 Retirement pension portions` OF 600, 100, 0) 262 530 0 0 EQUALS NOTHING
#ASSERT `s 65.1(9) — the portion of the contributor's retirement pension to be assigned` (`cp4 Retirement pension portions` OF 600, 0, 0) 262 0 0 0 EQUALS NOTHING

§§ `Section 65.1(10) to (12) -- starting, stopping, notice`

-- Approved in May 2020: commences with June 2020.
#ASSERT `s 65.1(10) — the month with which the assignment commences` (YMD 2020 5 17) EQUALS (YMD 2020 6 1)
#ASSERT `s 65.1(10) — the month with which the assignment commences` (YMD 2020 12 31) EQUALS (YMD 2021 1 1)
-- Death in March 2025; separation in November 2023 (twelfth month following: November 2024); becoming a contributor in September 2024 with subsection (7) applying; a divorce in June 2024; a request to cancel approved on 30 March 2024 (the month following: April 2024). The earliest is April 2024.
#ASSERT `s 65.1(11) — the month with which the assignment ceases` (JUST (YMD 2025 3 10)) (JUST (YMD 2023 11 5)) TRUE (JUST (YMD 2024 9 1)) (JUST (YMD 2024 6 20)) (JUST (YMD 2024 3 30)) EQUALS JUST (YMD 2024 4 1)
-- Without the cancellation: the divorce in June 2024.
#ASSERT `s 65.1(11) — the month with which the assignment ceases` (JUST (YMD 2025 3 10)) (JUST (YMD 2023 11 5)) TRUE (JUST (YMD 2024 9 1)) (JUST (YMD 2024 6 20)) NOTHING EQUALS JUST (YMD 2024 6 1)
-- Without the divorce: becoming a contributor, September 2024.
#ASSERT `s 65.1(11) — the month with which the assignment ceases` (JUST (YMD 2025 3 10)) (JUST (YMD 2023 11 5)) TRUE (JUST (YMD 2024 9 1)) NOTHING NOTHING EQUALS JUST (YMD 2024 9 1)
-- Subsection (7) does not apply, so becoming a contributor is not an event; the twelfth month after separation, November 2024.
#ASSERT `s 65.1(11) — the month with which the assignment ceases` (JUST (YMD 2025 3 10)) (JUST (YMD 2023 11 5)) FALSE (JUST (YMD 2024 9 1)) NOTHING NOTHING EQUALS JUST (YMD 2024 11 1)
-- Only a death: March 2025.
#ASSERT `s 65.1(11) — the month with which the assignment ceases` (JUST (YMD 2025 3 10)) NOTHING FALSE NOTHING NOTHING NOTHING EQUALS JUST (YMD 2025 3 1)
-- No event yet: the text gives no end.
#ASSERT `s 65.1(11) — the month with which the assignment ceases` NOTHING NOTHING TRUE NOTHING NOTHING NOTHING EQUALS NOTHING
-- Separation in March 2024: the twelfth month following is March 2025, the same month as the death.
#ASSERT `s 65.1(11) — the month with which the assignment ceases` (JUST (YMD 2025 3 10)) (JUST (YMD 2024 3 31)) FALSE NOTHING NOTHING NOTHING EQUALS JUST (YMD 2025 3 1)
#ASSERT `s 65.1(11.1) — either spouse or either common-law partner may request in writing that the assignment be reinstated` TRUE EQUALS TRUE
#ASSERT `s 65.1(11.1) — either spouse or either common-law partner may request in writing that the assignment be reinstated` FALSE EQUALS FALSE
-- Request approved in April 2024: reinstated on 1 May 2024.
#ASSERT `s 65.1(11.2) — the day the assignment is reinstated` (YMD 2024 4 20) EQUALS (YMD 2024 5 1)
#ASSERT `s 65.1(12) — both spouses or both common-law partners must be notified` TRUE EQUALS TRUE
#ASSERT `s 65.1(12) — both spouses or both common-law partners must be notified` FALSE EQUALS FALSE
