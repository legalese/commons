IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cp6-offences`

-- Tests of cp6-offences.l4 (sections 102 and 103, lines 2709 to 2720 of the Act file).

§ `Tests -- offences and prosecution`

§§ `Section 102(1): false or misleading information, knowingly given in an application for a number`

-- Inputs: furnished information in an application for a number; it was false or misleading; the person knew.
#ASSERT `s 102(1) — the person is guilty of an offence for false or misleading information in an application for a Social Insurance Number` TRUE TRUE TRUE
-- Each element is needed.
#ASSERT NOT (`s 102(1) — the person is guilty of an offence for false or misleading information in an application for a Social Insurance Number` FALSE TRUE TRUE)
#ASSERT NOT (`s 102(1) — the person is guilty of an offence for false or misleading information in an application for a Social Insurance Number` TRUE FALSE TRUE)
-- A false statement made by mistake, without knowing, is not the offence.
#ASSERT NOT (`s 102(1) — the person is guilty of an offence for false or misleading information in an application for a Social Insurance Number` TRUE TRUE FALSE)

§§ `Section 102(2): knowingly applying again`

-- Inputs: a number has been assigned to the person; the person made an application again; the person knew a number had been assigned.
#ASSERT `s 102(2) — the person is guilty of an offence for applying again for a Social Insurance Number` TRUE TRUE TRUE
#ASSERT NOT (`s 102(2) — the person is guilty of an offence for applying again for a Social Insurance Number` FALSE TRUE TRUE)
#ASSERT NOT (`s 102(2) — the person is guilty of an offence for applying again for a Social Insurance Number` TRUE FALSE TRUE)
#ASSERT NOT (`s 102(2) — the person is guilty of an offence for applying again for a Social Insurance Number` TRUE TRUE FALSE)

§§ `Section 102(3): an employer who fails to comply`

-- Inputs: the person is an employer; failed to comply with subsection 98(5); failed to comply with a regulation under paragraph 101(1)(a).
#ASSERT `s 102(3) — the employer is guilty of an offence for failing to require or record a Social Insurance Number` TRUE TRUE FALSE
#ASSERT `s 102(3) — the employer is guilty of an offence for failing to require or record a Social Insurance Number` TRUE FALSE TRUE
#ASSERT `s 102(3) — the employer is guilty of an offence for failing to require or record a Social Insurance Number` TRUE TRUE TRUE
#ASSERT NOT (`s 102(3) — the employer is guilty of an offence for failing to require or record a Social Insurance Number` TRUE FALSE FALSE)
#ASSERT NOT (`s 102(3) — the employer is guilty of an offence for failing to require or record a Social Insurance Number` FALSE TRUE TRUE)

§§ `Section 102: the greatest fine the text states, and how each offence is prosecuted`

-- Subsections (1) and (2) state no maximum: not covered, not zero.
#ASSERT `s 102 — the greatest fine the text states for the offence` `furnishing false or misleading information in an application for a Social Insurance Number` EQUALS NOTHING
#ASSERT `s 102 — the greatest fine the text states for the offence` `applying again for a Social Insurance Number after one has been assigned` EQUALS NOTHING
-- Subsection (3): "a fine not exceeding one hundred dollars".
#ASSERT `s 102 — the greatest fine the text states for the offence` `an employer's failure to comply with subsection 98(5) or a regulation under paragraph 101(1)(a)` EQUALS JUST 100
#ASSERT `s 102 — the way the offence is prosecuted` `furnishing false or misleading information in an application for a Social Insurance Number` EQUALS `on summary conviction`
#ASSERT `s 102 — the way the offence is prosecuted` `applying again for a Social Insurance Number after one has been assigned` EQUALS `on summary conviction`
#ASSERT `s 102 — the way the offence is prosecuted` `an employer's failure to comply with subsection 98(5) or a regulation under paragraph 101(1)(a)` EQUALS `on summary conviction`

§§ `Section 103(1): five years`

-- The subject-matter arose on 10 March 2021: five years after is 10 March 2026.
#ASSERT `s 103(1) — the last day on which a prosecution for an offence under this Act may be commenced` (YearMonthDay 2021 3 10) EQUALS YearMonthDay 2026 3 10
#ASSERT `s 103(1) — a prosecution for an offence under this Act may be commenced on a day` (YearMonthDay 2021 3 10) (YearMonthDay 2026 3 10)
#ASSERT NOT (`s 103(1) — a prosecution for an offence under this Act may be commenced on a day` (YearMonthDay 2021 3 10) (YearMonthDay 2026 3 11))
#ASSERT `s 103(1) — a prosecution for an offence under this Act may be commenced on a day` (YearMonthDay 2021 3 10) (YearMonthDay 2025 3 9)
#ASSERT `s 103(1) — a prosecution for an offence under this Act may be commenced on a day` (YearMonthDay 2021 3 10) (YearMonthDay 2021 3 10)
-- A subject-matter that arose on 29 February 2024: the core's month-end clamp (its fork F1) puts the fifth anniversary on 28 February 2029.
#ASSERT `s 103(1) — the last day on which a prosecution for an offence under this Act may be commenced` (YearMonthDay 2024 2 29) EQUALS YearMonthDay 2029 2 28

§§ `Section 103(2): a corporation's officer, director or agent`

-- Inputs: a corporation commits an offence under this Act; the person is an officer, director or agent; the part the person took.
#ASSERT `s 103(2) — the officer, director or agent is a party to and guilty of the corporation's offence` TRUE TRUE `directed the commission of the offence`
#ASSERT `s 103(2) — the officer, director or agent is a party to and guilty of the corporation's offence` TRUE TRUE `authorized the commission of the offence`
#ASSERT `s 103(2) — the officer, director or agent is a party to and guilty of the corporation's offence` TRUE TRUE `assented to the commission of the offence`
#ASSERT `s 103(2) — the officer, director or agent is a party to and guilty of the corporation's offence` TRUE TRUE `acquiesced in the commission of the offence`
#ASSERT `s 103(2) — the officer, director or agent is a party to and guilty of the corporation's offence` TRUE TRUE `participated in the commission of the offence`
#ASSERT NOT (`s 103(2) — the officer, director or agent is a party to and guilty of the corporation's offence` TRUE TRUE `took none of those parts`)
#ASSERT NOT (`s 103(2) — the officer, director or agent is a party to and guilty of the corporation's offence` TRUE FALSE `directed the commission of the offence`)
#ASSERT NOT (`s 103(2) — the officer, director or agent is a party to and guilty of the corporation's offence` FALSE TRUE `directed the commission of the offence`)

§§ `Section 103(3): section 41(6) applies outside Part I`

#ASSERT `s 103(3) — subsection 41(6) applies to the information or complaint` TRUE
#ASSERT NOT (`s 103(3) — subsection 41(6) applies to the information or complaint` FALSE)
