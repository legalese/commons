IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cr2-nouns`
IMPORT `cr2-maintenance-and-school`

-- Tests of cr2-maintenance-and-school.l4 (regulations 65 to 67). Layer 1.
-- Every expected value was decided by reading the regulations before the rules were run.

§ `Tests -- regulations 65 to 67`

§§ `65 -- wholly or substantially: more than 50 per cent`

-- Arguments: what the survivor provides; what all persons other than the children provide (the survivor included).
#ASSERT `reg 65 — the survivor maintains the dependent children wholly or substantially` 600 1000
#ASSERT `reg 65 — the survivor maintains the dependent children wholly or substantially` 501 1000
-- exactly half is not "more than 50 per cent"
#ASSERT NOT (`reg 65 — the survivor maintains the dependent children wholly or substantially` 500 1000)
#ASSERT `reg 65 — the survivor maintains the dependent children wholly or substantially` 100 100
#ASSERT NOT (`reg 65 — the survivor maintains the dependent children wholly or substantially` 0 0)

§§ `65.1 -- maintaining the child`

-- Arguments: financial provision made periodically (until the contributor's death); the amount provided; the benefit payable.
#ASSERT `reg 65.1(a) — a person maintains the child of a deceased contributor` TRUE 100 100
#ASSERT `reg 65.1(a) — a person maintains the child of a deceased contributor` TRUE 250 100
#ASSERT NOT (`reg 65.1(a) — a person maintains the child of a deceased contributor` TRUE 99.99 100)
#ASSERT NOT (`reg 65.1(a) — a person maintains the child of a deceased contributor` FALSE 250 100)
#ASSERT `reg 65.1(b) — a person maintains the child of a disabled contributor` TRUE 100 100
#ASSERT NOT (`reg 65.1(b) — a person maintains the child of a disabled contributor` TRUE 99.99 100)
#ASSERT NOT (`reg 65.1(b) — a person maintains the child of a disabled contributor` FALSE 250 100)

§§ `66(1) -- full-time and part-time attendance`

-- Arguments: attends an institution of the described nature; enrolled in a course load the institution recognizes as full-time; the share of a full course load.
#ASSERT `reg 66(1) — the attendance of a child at a school or university` TRUE TRUE 1 EQUALS `full-time attendance at a school or university`
-- full-time study as the institution recognizes it, whatever the share
#ASSERT `reg 66(1) — the attendance of a child at a school or university` TRUE TRUE 0.1 EQUALS `full-time attendance at a school or university`
-- part-time: not full-time, and at least 20 per cent of a full course load
#ASSERT `reg 66(1) — the attendance of a child at a school or university` TRUE FALSE 0.2 EQUALS `part-time attendance at a school or university`
#ASSERT `reg 66(1) — the attendance of a child at a school or university` TRUE FALSE 0.5 EQUALS `part-time attendance at a school or university`
#ASSERT `reg 66(1) — the attendance of a child at a school or university` TRUE FALSE 0.19 EQUALS `no attendance at a school or university`
-- not at an institution of the described nature
#ASSERT `reg 66(1) — the attendance of a child at a school or university` FALSE TRUE 1 EQUALS `no attendance at a school or university`

§§ `66(2) to (5) -- absences counted as attendance`

-- 66(2): arguments: the attendance apart from the absence; the reason for the absence.
#ASSERT `reg 66(2) — the child is considered to be in attendance during a normal period of scholastic vacation` `full-time attendance at a school or university` `the child is absent during a normal period of scholastic vacation`
#ASSERT `reg 66(2) — the child is considered to be in attendance during a normal period of scholastic vacation` `part-time attendance at a school or university` `the child is absent during a normal period of scholastic vacation`
#ASSERT NOT (`reg 66(2) — the child is considered to be in attendance during a normal period of scholastic vacation` `no attendance at a school or university` `the child is absent during a normal period of scholastic vacation`)
#ASSERT NOT (`reg 66(2) — the child is considered to be in attendance during a normal period of scholastic vacation` `part-time attendance at a school or university` `the child is not absent`)
#ASSERT NOT (`reg 66(2) — the child is considered to be in attendance during a normal period of scholastic vacation` `part-time attendance at a school or university` `the child is absent because of illness`)
-- 66(3): arguments: the attendance apart from the absence; the reason; resumes immediately in the same academic year; Minister found the child unable to; resumes in the following academic year.
#ASSERT `reg 66(3) — the child absent because of illness is considered to be in attendance during the absence` `full-time attendance at a school or university` `the child is absent because of illness` TRUE FALSE FALSE
#ASSERT `reg 66(3) — the child absent because of illness is considered to be in attendance during the absence` `part-time attendance at a school or university` `the child is absent because of illness` FALSE TRUE TRUE
-- resumed only the following year without the Minister's determination
#ASSERT NOT (`reg 66(3) — the child absent because of illness is considered to be in attendance during the absence` `full-time attendance at a school or university` `the child is absent because of illness` FALSE FALSE TRUE)
-- the Minister's determination but the child did not resume
#ASSERT NOT (`reg 66(3) — the child absent because of illness is considered to be in attendance during the absence` `full-time attendance at a school or university` `the child is absent because of illness` FALSE TRUE FALSE)
#ASSERT NOT (`reg 66(3) — the child absent because of illness is considered to be in attendance during the absence` `no attendance at a school or university` `the child is absent because of illness` TRUE FALSE FALSE)
#ASSERT NOT (`reg 66(3) — the child absent because of illness is considered to be in attendance during the absence` `full-time attendance at a school or university` `the child is absent for some other reason` TRUE FALSE FALSE)
-- 66(4): arguments: a child referred to in 66(3)(b); the end of the vacation; the day.
#ASSERT `reg 66(4) — the child is considered to be in attendance on a day` TRUE (YearMonthDay 2026 8 31) (YearMonthDay 2026 8 31)
#ASSERT NOT (`reg 66(4) — the child is considered to be in attendance on a day` TRUE (YearMonthDay 2026 8 31) (YearMonthDay 2026 9 1))
#ASSERT NOT (`reg 66(4) — the child is considered to be in attendance on a day` FALSE (YearMonthDay 2026 8 31) (YearMonthDay 2026 8 1))
-- 66(5): the child dies or ceases to be a dependent child on 10 March 2026 during an absence for illness: in attendance until the end of March.
#ASSERT `reg 66(5) — the last day the child is considered to have been in attendance` TRUE TRUE (YearMonthDay 2026 3 10) EQUALS (YearMonthDay 2026 3 31)
#ASSERT `reg 66(5) — the child is considered to have been in attendance on a day` TRUE TRUE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 31)
#ASSERT NOT (`reg 66(5) — the child is considered to have been in attendance on a day` TRUE TRUE (YearMonthDay 2026 3 10) (YearMonthDay 2026 4 1))
#ASSERT NOT (`reg 66(5) — the child is considered to have been in attendance on a day` FALSE TRUE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 20))
#ASSERT NOT (`reg 66(5) — the child is considered to have been in attendance on a day` TRUE FALSE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 20))

§§ `67 -- the attestation for a child of 18 or more`

#ASSERT `reg 67 — the applicant or beneficiary must file an attestation signed by the child and supporting documentation` TRUE TRUE
#ASSERT NOT (`reg 67 — the applicant or beneficiary must file an attestation signed by the child and supporting documentation` TRUE FALSE)
#ASSERT NOT (`reg 67 — the applicant or beneficiary must file an attestation signed by the child and supporting documentation` FALSE TRUE)
#ASSERT `reg 67 — what is filed meets the regulation` TRUE TRUE
#ASSERT NOT (`reg 67 — what is filed meets the regulation` TRUE FALSE)
#ASSERT NOT (`reg 67 — what is filed meets the regulation` FALSE TRUE)
