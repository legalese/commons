IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-age`
IMPORT `cp3-nouns`
IMPORT `cp3-part2-interpretation`
IMPORT `cp3-contributory-period`
IMPORT `cp3-average-earnings`

-- Tests of cp3-average-earnings.l4 (sections 47 to 48.2). Expected values are worked by hand from the
-- text. The basic number of contributory months is an input, so the small lists below use small values
-- of it to test the arithmetic; the 120 of subsection (4) is fixed in the text, so its tests use long lists.

-- Test fixtures: one month of a record, and a run of months.
GIVEN month IS A DATE
      earnings IS A NUMBER
      recipient IS A BOOLEAN
GIVETH A `cp3 Month of a contributory period`
`a test month` month earnings recipient MEANS
    `cp3 Month of a contributory period` WITH
        `the month of the record` IS month
        `pensionable earnings for that month` IS earnings
        `a family allowance recipient in that month` IS recipient

GIVEN count IS A NUMBER
      start IS A DATE
      earnings IS A NUMBER
      recipient IS A BOOLEAN
GIVETH A LIST OF `cp3 Month of a contributory period`
`a run of test months` count start earnings recipient MEANS
    IF count AT MOST 0
    THEN EMPTY
    ELSE (`a test month` start earnings recipient) FOLLOWED BY (`a run of test months` (count MINUS 1) (`add months` start 1) earnings recipient)

§ `Tests -- section 47`

-- a pension commencing with December 1975: 120000 / 120 = 1000
#ASSERT `s 47 — the average monthly pensionable earnings of a contributor whose retirement pension commences before 1976` (YearMonthDay 1975 12 1) 120000 120 EQUALS JUST 1000
-- January 1976 is not before 1976: section 48 applies instead
#ASSERT `s 47 — the average monthly pensionable earnings of a contributor whose retirement pension commences before 1976` (YearMonthDay 1976 1 1) 120000 120 EQUALS NOTHING
-- a basic number of zero: not covered
#ASSERT `s 47 — the average monthly pensionable earnings of a contributor whose retirement pension commences before 1976` (YearMonthDay 1975 12 1) 120000 0 EQUALS NOTHING

§ `Tests -- section 48(1)`

-- 100 months, basic number 120: the greater is 120; 120000 / 120 = 1000
#ASSERT `s 48(1) — the average monthly pensionable earnings before the deductions` (YearMonthDay 2010 1 1) 120000 100 120 EQUALS JUST 1000
-- 150 months: the greater is 150; 120000 / 150 = 800
#ASSERT `s 48(1) — the average monthly pensionable earnings before the deductions` (YearMonthDay 2010 1 1) 120000 150 120 EQUALS JUST 800
-- exactly 120 months
#ASSERT `s 48(1) — the average monthly pensionable earnings before the deductions` (YearMonthDay 2010 1 1) 120000 120 120 EQUALS JUST 1000
-- January 1976 is "after December, 1975"
#ASSERT `s 48(1) — the average monthly pensionable earnings before the deductions` (YearMonthDay 1976 1 1) 120000 120 120 EQUALS JUST 1000
-- a pension commencing with December 1975: section 47, not this section
#ASSERT `s 48(1) — the average monthly pensionable earnings before the deductions` (YearMonthDay 1975 12 1) 120000 120 120 EQUALS NOTHING
-- no months and a basic number of zero: not covered
#ASSERT `s 48(1) — the average monthly pensionable earnings before the deductions` (YearMonthDay 2010 1 1) 0 0 0 EQUALS NOTHING

§ `Tests -- section 48(2)`

-- the number of months below which the deduction may not go
#ASSERT `s 48(2)(a) — the number of months below which the deduction may not reduce the contributory period` `a retirement pension` NOTHING 120 EQUALS 120
#ASSERT `s 48(2)(a) — the number of months below which the deduction may not reduce the contributory period` `a death benefit` NOTHING 120 EQUALS 36
#ASSERT `s 48(2)(a) — the number of months below which the deduction may not reduce the contributory period` `a survivor's pension` NOTHING 120 EQUALS 36
-- a disability pension, deemed disabled after December 31, 1997: 48
#ASSERT `s 48(2)(a) — the number of months below which the deduction may not reduce the contributory period` `a disability pension` (JUST (YearMonthDay 1998 1 1)) 120 EQUALS 48
#ASSERT `s 48(2)(a) — the number of months below which the deduction may not reduce the contributory period` `a post-retirement disability benefit` (JUST (YearMonthDay 2015 6 1)) 120 EQUALS 48
-- deemed disabled in 1997: 24; on 31 December 1997 the last day of that year
#ASSERT `s 48(2)(a) — the number of months below which the deduction may not reduce the contributory period` `a disability pension` (JUST (YearMonthDay 1997 12 31)) 120 EQUALS 24
#ASSERT `s 48(2)(a) — the number of months below which the deduction may not reduce the contributory period` `a disability pension` (JUST (YearMonthDay 1997 1 1)) 120 EQUALS 24
-- deemed disabled in 1996: the basic number
#ASSERT `s 48(2)(a) — the number of months below which the deduction may not reduce the contributory period` `a disability pension` (JUST (YearMonthDay 1996 12 31)) 120 EQUALS 120
-- no day of deemed disablement: the basic number
#ASSERT `s 48(2)(a) — the number of months below which the deduction may not reduce the contributory period` `a disability pension` NOTHING 120 EQUALS 120
-- a disabled contributor's child's benefit is not a "disability benefit" in this reading
#ASSERT `s 48(2)(a) — the number of months below which the deduction may not reduce the contributory period` `a disabled contributor's child's benefit` (JUST (YearMonthDay 2015 6 1)) 120 EQUALS 120

-- Eight months: six of 100 and two family allowance months of 20. P = 640, average without the deductions = 640 / max(8, 4) = 80.
-- The two months of 20 are family allowance months below 80: both deducted when the floor is 4 (8 - 4 = 4 allows two).
#ASSERT count (`s 48(2) — the months of the contributory period that remain after the deduction for child-raising years` (append (`a run of test months` 6 (YearMonthDay 2020 1 1) 100 FALSE) (`a run of test months` 2 (YearMonthDay 2020 7 1) 20 TRUE)) (YearMonthDay 2021 1 1) 4 4) EQUALS 6
#ASSERT `cp3 — the pensionable earnings of a list of months` (`s 48(2) — the months of the contributory period that remain after the deduction for child-raising years` (append (`a run of test months` 6 (YearMonthDay 2020 1 1) 100 FALSE) (`a run of test months` 2 (YearMonthDay 2020 7 1) 20 TRUE)) (YearMonthDay 2021 1 1) 4 4) EQUALS 600
-- the floor is 7: only one month (8 - 7) may go, the one of least earnings (one of the two equal months of 20)
#ASSERT count (`s 48(2) — the months of the contributory period that remain after the deduction for child-raising years` (append (`a run of test months` 6 (YearMonthDay 2020 1 1) 100 FALSE) (`a run of test months` 2 (YearMonthDay 2020 7 1) 20 TRUE)) (YearMonthDay 2021 1 1) 7 7) EQUALS 7
#ASSERT `cp3 — the pensionable earnings of a list of months` (`s 48(2) — the months of the contributory period that remain after the deduction for child-raising years` (append (`a run of test months` 6 (YearMonthDay 2020 1 1) 100 FALSE) (`a run of test months` 2 (YearMonthDay 2020 7 1) 20 TRUE)) (YearMonthDay 2021 1 1) 7 7) EQUALS 620
-- the floor is 36 (a survivor's pension): 8 - 36 is negative, so nothing may go
#ASSERT count (`s 48(2) — the months of the contributory period that remain after the deduction for child-raising years` (append (`a run of test months` 6 (YearMonthDay 2020 1 1) 100 FALSE) (`a run of test months` 2 (YearMonthDay 2020 7 1) 20 TRUE)) (YearMonthDay 2021 1 1) 36 4) EQUALS 8
-- a benefit payable for a month before 1978: the subsection does not apply
#ASSERT count (`s 48(2) — the months of the contributory period that remain after the deduction for child-raising years` (append (`a run of test months` 6 (YearMonthDay 2020 1 1) 100 FALSE) (`a run of test months` 2 (YearMonthDay 2020 7 1) 20 TRUE)) (YearMonthDay 1977 12 1) 4 4) EQUALS 8
-- the benefit payable for January 1978: the subsection applies
#ASSERT count (`s 48(2) — the months of the contributory period that remain after the deduction for child-raising years` (append (`a run of test months` 6 (YearMonthDay 2020 1 1) 100 FALSE) (`a run of test months` 2 (YearMonthDay 2020 7 1) 20 TRUE)) (YearMonthDay 1978 1 1) 4 4) EQUALS 6
-- months that are not family allowance months are never deducted, however low: two months of 20 that are not family allowance months
#ASSERT count (`s 48(2) — the months of the contributory period that remain after the deduction for child-raising years` (append (`a run of test months` 6 (YearMonthDay 2020 1 1) 100 FALSE) (`a run of test months` 2 (YearMonthDay 2020 7 1) 20 FALSE)) (YearMonthDay 2021 1 1) 4 4) EQUALS 8
-- a family allowance month whose earnings equal the average is not "less than" it: six months of 100, two family allowance months of 100
#ASSERT count (`s 48(2) — the months of the contributory period that remain after the deduction for child-raising years` (append (`a run of test months` 6 (YearMonthDay 2020 1 1) 100 FALSE) (`a run of test months` 2 (YearMonthDay 2020 7 1) 100 TRUE)) (YearMonthDay 2021 1 1) 4 4) EQUALS 8

§ `Tests -- section 48(3)`

-- Eight months January to August 2020; earnings 100 x 6, then 50 and 10. Born 15 June 1955: 65 on 15 June 2020, deemed 1 July 2020.
-- The period ends in August 2020, after June 2020 (the month before the month of reaching 65). Basic number 4.
-- Months after reaching 65: July and August, 2; 8 - 4 = 4; the lesser is 2: the two months of least earnings (10 and 50) go: 600 left in 6 months.
#ASSERT count (`s 48(3) — the months of the contributory period that remain after the deduction for months after age 65` (append (`a run of test months` 6 (YearMonthDay 2020 1 1) 100 FALSE) (LIST (`a test month` (YearMonthDay 2020 7 1) 50 FALSE), (`a test month` (YearMonthDay 2020 8 1) 10 FALSE))) (YearMonthDay 2020 8 1) (YearMonthDay 1955 6 15) 4) EQUALS 6
#ASSERT `cp3 — the pensionable earnings of a list of months` (`s 48(3) — the months of the contributory period that remain after the deduction for months after age 65` (append (`a run of test months` 6 (YearMonthDay 2020 1 1) 100 FALSE) (LIST (`a test month` (YearMonthDay 2020 7 1) 50 FALSE), (`a test month` (YearMonthDay 2020 8 1) 10 FALSE))) (YearMonthDay 2020 8 1) (YearMonthDay 1955 6 15) 4) EQUALS 600
-- basic number 7: 8 - 7 = 1 is the lesser: only the month of least earnings (10) goes: 650 left in 7 months
#ASSERT `cp3 — the pensionable earnings of a list of months` (`s 48(3) — the months of the contributory period that remain after the deduction for months after age 65` (append (`a run of test months` 6 (YearMonthDay 2020 1 1) 100 FALSE) (LIST (`a test month` (YearMonthDay 2020 7 1) 50 FALSE), (`a test month` (YearMonthDay 2020 8 1) 10 FALSE))) (YearMonthDay 2020 8 1) (YearMonthDay 1955 6 15) 7) EQUALS 650
-- the months deducted are the months of least earnings wherever they are: a month of 5 before 65 goes as well. Months: 5 + 5 x 100 + 50 + 10 = 565; 2 months go (5 and 10): 550 is left
#ASSERT `cp3 — the pensionable earnings of a list of months` (`s 48(3) — the months of the contributory period that remain after the deduction for months after age 65` (append (LIST (`a test month` (YearMonthDay 2020 1 1) 5 FALSE)) (append (`a run of test months` 5 (YearMonthDay 2020 2 1) 100 FALSE) (LIST (`a test month` (YearMonthDay 2020 7 1) 50 FALSE), (`a test month` (YearMonthDay 2020 8 1) 10 FALSE)))) (YearMonthDay 2020 8 1) (YearMonthDay 1955 6 15) 4) EQUALS 550
-- the period ends in June 2020, the month before the month of reaching 65: the subsection does not apply
#ASSERT count (`s 48(3) — the months of the contributory period that remain after the deduction for months after age 65` (`a run of test months` 8 (YearMonthDay 2019 11 1) 100 FALSE) (YearMonthDay 2020 6 1) (YearMonthDay 1955 6 15) 4) EQUALS 8
-- the period ends in July 2020, the month of reaching 65: it applies; one month after 65; 8 - 4 = 4: one month goes
#ASSERT count (`s 48(3) — the months of the contributory period that remain after the deduction for months after age 65` (`a run of test months` 8 (YearMonthDay 2019 12 1) 100 FALSE) (YearMonthDay 2020 7 1) (YearMonthDay 1955 6 15) 4) EQUALS 7
-- no more months than the basic number: nothing goes
#ASSERT count (`s 48(3) — the months of the contributory period that remain after the deduction for months after age 65` (`a run of test months` 8 (YearMonthDay 2019 12 1) 100 FALSE) (YearMonthDay 2020 7 1) (YearMonthDay 1955 6 15) 8) EQUALS 8

§ `Tests -- section 48(4) and 48(5)`

-- the percentages
#ASSERT `s 48(4)(a)(i) — the percentage of the months remaining that is deducted` (YearMonthDay 2011 12 1) EQUALS 15%
#ASSERT `s 48(4)(a)(i) — the percentage of the months remaining that is deducted` (YearMonthDay 2012 1 1) EQUALS 16%
#ASSERT `s 48(4)(a)(i) — the percentage of the months remaining that is deducted` (YearMonthDay 2013 12 1) EQUALS 16%
#ASSERT `s 48(4)(a)(i) — the percentage of the months remaining that is deducted` (YearMonthDay 2014 1 1) EQUALS 17%
-- 190 months remain: 15% is 28.5, a fraction counted as a month: 29; the excess over 120 is 70: 29
#ASSERT `s 48(4)(a) — the number of months deducted from the months remaining` 190 (YearMonthDay 2010 1 1) NOTHING EQUALS 29
-- 16% of 190 is 30.4: 31
#ASSERT `s 48(4)(a) — the number of months deducted from the months remaining` 190 (YearMonthDay 2012 1 1) NOTHING EQUALS 31
-- 17% of 190 is 32.3: 33
#ASSERT `s 48(4)(a) — the number of months deducted from the months remaining` 190 (YearMonthDay 2014 1 1) NOTHING EQUALS 33
-- 125 months remain at 17%: 21.25 is 22, but the excess over 120 is only 5
#ASSERT `s 48(4)(a) — the number of months deducted from the months remaining` 125 (YearMonthDay 2014 1 1) NOTHING EQUALS 5
-- exactly 120 months remain: no deduction
#ASSERT `s 48(4)(a) — the number of months deducted from the months remaining` 120 (YearMonthDay 2014 1 1) NOTHING EQUALS 0
-- 121 months: the excess is 1
#ASSERT `s 48(4)(a) — the number of months deducted from the months remaining` 121 (YearMonthDay 2010 1 1) NOTHING EQUALS 1
-- subsection (5): the percentage used for another benefit (15%) governs although this benefit commences in 2014: 29
#ASSERT `s 48(4)(a) — the number of months deducted from the months remaining` 190 (YearMonthDay 2014 1 1) (JUST (15%)) EQUALS 29
-- 130 months, the first 20 of earnings 0 and the other 110 of 1000, benefit commencing in 2010 (15%): 15% of 130 is 19.5, 20; the excess is 10; the ten of least earnings go
#ASSERT count (`s 48(4) — the months of the contributory period that remain after the deduction for months over 120` (append (`a run of test months` 20 (YearMonthDay 2000 1 1) 0 FALSE) (`a run of test months` 110 (YearMonthDay 2001 9 1) 1000 FALSE)) (YearMonthDay 2010 1 1) NOTHING) EQUALS 120
#ASSERT `cp3 — the pensionable earnings of a list of months` (`s 48(4) — the months of the contributory period that remain after the deduction for months over 120` (append (`a run of test months` 20 (YearMonthDay 2000 1 1) 0 FALSE) (`a run of test months` 110 (YearMonthDay 2001 9 1) 1000 FALSE)) (YearMonthDay 2010 1 1) NOTHING) EQUALS 110000
-- 100 months: nothing goes
#ASSERT count (`s 48(4) — the months of the contributory period that remain after the deduction for months over 120` (`a run of test months` 100 (YearMonthDay 2000 1 1) 1000 FALSE) (YearMonthDay 2010 1 1) NOTHING) EQUALS 100

§ `Tests -- section 48: the three deductions together`

-- 130 months of 1000 each with 20 of them family allowance months of 0; the benefit is a retirement pension commencing with January 2010 (15%), payable for January 2010.
-- Born 1 January 1950, 65 on 1 January 2015, deemed 1 February 2015; the period ends in October 2010, so subsection (3) does not apply.
-- Basic number 120 (no month excluded). Average without regard to (3) and (4): (110 x 1000) / max(130, 120) = 110000 / 130 = 846.15...
-- Subsection (2): the 20 family allowance months of 0 are below it; the floor is 120, so 130 - 120 = 10 may go: 10 months go. 120 months remain, 110000 in earnings.
-- Subsection (4): 120 months remain, not over 120: nothing more. Average: 110000 / 120 = 2750 / 3.
#ASSERT `s 48 — the average monthly pensionable earnings after the deductions` (append (`a run of test months` 20 (YearMonthDay 2000 1 1) 0 TRUE) (`a run of test months` 110 (YearMonthDay 2001 9 1) 1000 FALSE)) `a retirement pension` (YearMonthDay 2010 1 1) (YearMonthDay 2010 1 1) (YearMonthDay 2010 10 1) (YearMonthDay 1950 1 1) NOTHING 0 NOTHING EQUALS JUST (2750 DIVIDED BY 3)
-- the same months without any family allowance flag: subsection (2) deducts nothing; (4) deducts min(ceil(15% of 130) = 20, 10) = 10 of the least: 110000 left in 120 months: the same
#ASSERT `s 48 — the average monthly pensionable earnings after the deductions` (append (`a run of test months` 20 (YearMonthDay 2000 1 1) 0 FALSE) (`a run of test months` 110 (YearMonthDay 2001 9 1) 1000 FALSE)) `a retirement pension` (YearMonthDay 2010 1 1) (YearMonthDay 2010 1 1) (YearMonthDay 2010 10 1) (YearMonthDay 1950 1 1) NOTHING 0 NOTHING EQUALS JUST (2750 DIVIDED BY 3)
-- no deduction available (60 months of 1000, nothing over 120, basic number 120): 60000 / max(60, 120) = 500
#ASSERT `s 48 — the average monthly pensionable earnings after the deductions` (`a run of test months` 60 (YearMonthDay 2005 1 1) 1000 FALSE) `a retirement pension` (YearMonthDay 2010 1 1) (YearMonthDay 2010 1 1) (YearMonthDay 2009 12 1) (YearMonthDay 1950 1 1) NOTHING 0 NOTHING EQUALS JUST 500
-- 12 months excluded by reason of disability: the basic number is 108: 60000 / max(60, 108) = 555.55... = 5000 / 9
#ASSERT `s 48 — the average monthly pensionable earnings after the deductions` (`a run of test months` 60 (YearMonthDay 2005 1 1) 1000 FALSE) `a retirement pension` (YearMonthDay 2010 1 1) (YearMonthDay 2010 1 1) (YearMonthDay 2009 12 1) (YearMonthDay 1950 1 1) NOTHING 12 NOTHING EQUALS JUST (5000 DIVIDED BY 9)
-- a pension commencing before 1976: not covered by section 48
#ASSERT `s 48 — the average monthly pensionable earnings after the deductions` (`a run of test months` 60 (YearMonthDay 1970 1 1) 1000 FALSE) `a retirement pension` (YearMonthDay 1975 6 1) (YearMonthDay 1975 6 1) (YearMonthDay 1975 5 1) (YearMonthDay 1920 1 1) NOTHING 0 NOTHING EQUALS NOTHING

§ `Tests -- sections 48.1 and 48.2`

-- 480 months or fewer: the total divided by 480: 240000 / 480 = 500
#ASSERT `s 48.1(a) — the first additional monthly pensionable earnings when the first additional contributory period is not more than 480 months` 240000 EQUALS 500
#ASSERT `s 48.2(a) — the second additional monthly pensionable earnings when the second additional contributory period is not more than 480 months` 120000 EQUALS 250
-- more than 480: the 480 highest months over 480. Five months of 10, 20, 30, 40, 50 stand in for the whole list with the divisor still 480:
-- the aggregate of the 480 highest is the whole sum of 150 (there are only five months), so the 481-month tests below use a long list.
-- 481 months: 1 month of 0 and 480 months of 1000: the 480 highest are the 480 months of 1000: 480000 / 480 = 1000
#ASSERT `s 48.1(b) — the first additional monthly pensionable earnings when the first additional contributory period exceeds 480 months` (append (LIST 0) (map (GIVEN m YIELD 1000) (`a run of test months` 480 (YearMonthDay 1980 1 1) 0 FALSE))) EQUALS 1000
#ASSERT `s 48.2(b) — the second additional monthly pensionable earnings when the second additional contributory period exceeds 480 months` (append (LIST 0) (map (GIVEN m YIELD 1000) (`a run of test months` 480 (YearMonthDay 1980 1 1) 0 FALSE))) EQUALS 1000
-- the whole function chooses by the length of the period: 481 months uses the 480 highest
#ASSERT `s 48.1 — the first additional monthly pensionable earnings of a contributor` (append (LIST 0) (map (GIVEN m YIELD 1000) (`a run of test months` 480 (YearMonthDay 1980 1 1) 0 FALSE))) EQUALS 1000
-- exactly 480 months of 1000 and 481 months where the one extra month is the highest: the extra month replaces the lowest
-- 480 months of 1000: 1000
#ASSERT `s 48.1 — the first additional monthly pensionable earnings of a contributor` (map (GIVEN m YIELD 1000) (`a run of test months` 480 (YearMonthDay 1980 1 1) 0 FALSE)) EQUALS 1000
-- 479 months of 1000: 479000 / 480
#ASSERT `s 48.1 — the first additional monthly pensionable earnings of a contributor` (map (GIVEN m YIELD 1000) (`a run of test months` 479 (YearMonthDay 1980 1 1) 0 FALSE)) EQUALS (479000 DIVIDED BY 480)
-- 481 months where one month is 2000 and the others 1000, then the 480 highest are 2000 and 479 of 1000: (2000 + 479000) / 480
#ASSERT `s 48.1 — the first additional monthly pensionable earnings of a contributor` (append (LIST 2000) (map (GIVEN m YIELD 1000) (`a run of test months` 480 (YearMonthDay 1980 1 1) 0 FALSE))) EQUALS (481000 DIVIDED BY 480)
#ASSERT `s 48.2 — the second additional monthly pensionable earnings of a contributor` (append (LIST 2000) (map (GIVEN m YIELD 1000) (`a run of test months` 480 (YearMonthDay 1980 1 1) 0 FALSE))) EQUALS (481000 DIVIDED BY 480)
#ASSERT `s 48.2 — the second additional monthly pensionable earnings of a contributor` (LIST 480, 960) EQUALS 3
