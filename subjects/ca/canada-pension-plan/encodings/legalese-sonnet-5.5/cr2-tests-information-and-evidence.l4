IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cr2-nouns`
IMPORT `cr2-information-and-evidence`

-- Tests of cr2-information-and-evidence.l4 (regulations 52 to 54.1). Layer 1.
-- Every expected value was decided by reading the regulations before the rules were run: an item is still to be set
-- out or furnished when it applies, has not been furnished, and the duty is due (the application is being made or
-- the Minister has asked in writing).

§ `Tests -- regulations 52 to 54.1`

`item 52(a)(i)` MEANS `reg 52(a)(i) — the name at birth, present name, sex, address and Social Insurance Number of the applicant or beneficiary`
`item 52(b)(i)` MEANS `reg 52(b)(i) — the date and place of birth of the applicant or beneficiary`
`item 52(c)` MEANS `reg 52(c) — the date and place of death of the contributor`
`item 52(n)` MEANS `reg 52(n) — such additional documents, statements or records as will assist the Minister in ascertaining the accuracy of the information and evidence in paragraphs (a) to (m)`
`item 53(a)` MEANS `reg 53(a) — the name and date of birth of all children for whom the contributor received family allowance benefits or Canada child benefits`
`item 53(c)` MEANS `reg 53(c) — the periods during which the contributor received those benefits for those children`
`item 54(1) chapeau` MEANS `reg 54(1) chapeau — the information required under regulation 52, with any modifications that the circumstances require`
`item 54(1)(d)` MEANS `reg 54(1)(d) — the date and place of marriage and the certificate of marriage, a copy of it or a copy of the act of marriage`
`item 54(1)(k)` MEANS `reg 54(1)(k) — a copy of any written agreement between the persons subject to a division that was made before June 4, 1986, or on or after that date and binds the Minister under subsection 55.2(3) of the Act`
`item 54(2)(a)` MEANS `reg 54(2)(a) — the name at birth, present name, sex, address and Social Insurance Number of each of the former spouses`
`item 54(2)(i)` MEANS `reg 54(2)(i) — a copy of any written agreement between the persons subject to a division that was made before June 4, 1986, or on or after that date and binds the Minister under subsection 55.2(3) of the Act`
`item 54.1(1)(e)` MEANS `reg 54.1(1)(e) — the month in which the spouses or common-law partners commenced to live together in a conjugal relationship`
`item 54.1(1)(g)` MEANS `reg 54.1(1)(g) — documentary evidence of the dissolution of any previous marriage of the applicant`

§§ `52 -- any benefit`

-- Arguments: the application is being made; the Minister has asked in writing; the items that apply; the items already furnished.
-- Applying now; (a)(i), (b)(i) and (c) apply; (a)(i) is already in the application: (b)(i) and (c) are still to come.
#ASSERT `reg 52 — the items the applicant or beneficiary still has to set out or furnish` TRUE FALSE (LIST `item 52(a)(i)`, `item 52(b)(i)`, `item 52(c)`) (LIST `item 52(a)(i)`) EQUALS (LIST `item 52(b)(i)`, `item 52(c)`)
-- Not applying now, but the Minister has asked in writing: the same answer.
#ASSERT `reg 52 — the items the applicant or beneficiary still has to set out or furnish` FALSE TRUE (LIST `item 52(a)(i)`, `item 52(b)(i)`, `item 52(c)`) (LIST `item 52(a)(i)`) EQUALS (LIST `item 52(b)(i)`, `item 52(c)`)
-- Neither: nothing is due yet.
#ASSERT `reg 52 — the items the applicant or beneficiary still has to set out or furnish` FALSE FALSE (LIST `item 52(a)(i)`, `item 52(b)(i)`) EMPTY EQUALS EMPTY
-- All applicable items furnished, including one that does not apply: nothing is still owed.
#ASSERT `reg 52 — the items the applicant or beneficiary still has to set out or furnish` TRUE TRUE (LIST `item 52(a)(i)`) (LIST `item 52(a)(i)`, `item 52(n)`) EQUALS EMPTY
-- Nothing applies.
#ASSERT `reg 52 — the items the applicant or beneficiary still has to set out or furnish` TRUE TRUE EMPTY EMPTY EQUALS EMPTY

§§ `53 -- family allowance months`

#ASSERT `reg 53 — the items the applicant still has to set out or furnish about family allowance months` TRUE FALSE (LIST `item 53(a)`, `item 53(c)`) (LIST `item 53(c)`) EQUALS (LIST `item 53(a)`)
#ASSERT `reg 53 — the items the applicant still has to set out or furnish about family allowance months` FALSE FALSE (LIST `item 53(a)`) EMPTY EQUALS EMPTY
#ASSERT `reg 53 — the items the applicant still has to set out or furnish about family allowance months` FALSE TRUE (LIST `item 53(a)`) EMPTY EQUALS (LIST `item 53(a)`)

§§ `54(1) -- a division of unadjusted pensionable earnings`

#ASSERT `reg 54(1) — the items the applicant still has to set out or furnish for a division` TRUE FALSE (LIST `item 54(1) chapeau`, `item 54(1)(d)`, `item 54(1)(k)`) (LIST `item 54(1)(d)`) EQUALS (LIST `item 54(1) chapeau`, `item 54(1)(k)`)
#ASSERT `reg 54(1) — the items the applicant still has to set out or furnish for a division` FALSE FALSE (LIST `item 54(1)(d)`) EMPTY EQUALS EMPTY
#ASSERT `reg 54(1) — the items the applicant still has to set out or furnish for a division` FALSE TRUE (LIST `item 54(1)(d)`) (LIST `item 54(1)(d)`) EQUALS EMPTY

§§ `54(2) -- the information relating to the marriage`

-- No timing in this subsection: the information is simply what is prescribed for paragraph 55.1(1)(a).
#ASSERT `reg 54(2) — the information relating to the marriage that is still lacking` (LIST `item 54(2)(a)`, `item 54(2)(i)`) (LIST `item 54(2)(a)`) EQUALS (LIST `item 54(2)(i)`)
#ASSERT `reg 54(2) — the information relating to the marriage that is still lacking` (LIST `item 54(2)(a)`) (LIST `item 54(2)(a)`) EQUALS EMPTY

§§ `54(3) and 54.1(2) -- the original certificate of marriage`

#ASSERT `reg 54(3) — the Minister may require the original certificate of marriage or a copy of the act of marriage issued by the competent authority` TRUE
#ASSERT NOT (`reg 54(3) — the Minister may require the original certificate of marriage or a copy of the act of marriage issued by the competent authority` FALSE)
#ASSERT `reg 54.1(2) — the Minister may require the original certificate of marriage or a copy of the act of marriage issued by the competent authority` TRUE
#ASSERT NOT (`reg 54.1(2) — the Minister may require the original certificate of marriage or a copy of the act of marriage issued by the competent authority` FALSE)

§§ `54.1(1) -- an assignment of a portion of a retirement pension`

#ASSERT `reg 54.1(1) — the items the applicant still has to set out or furnish for an assignment` TRUE FALSE (LIST `item 54.1(1)(e)`, `item 54.1(1)(g)`) (LIST `item 54.1(1)(g)`) EQUALS (LIST `item 54.1(1)(e)`)
#ASSERT `reg 54.1(1) — the items the applicant still has to set out or furnish for an assignment` FALSE FALSE (LIST `item 54.1(1)(e)`) EMPTY EQUALS EMPTY
#ASSERT `reg 54.1(1) — the items the applicant still has to set out or furnish for an assignment` FALSE TRUE (LIST `item 54.1(1)(e)`) EMPTY EQUALS (LIST `item 54.1(1)(e)`)
