IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cp5-months`
IMPORT `cp5-g-general`

-- Tests of sections 87 to 90.2 (cp5-g-general.l4). Expected values were worked out by hand from the text
-- (and, for section 87's prescribed conditions, from regulation 51).

§ `Tests of sections 87 to 90.2`

§§ `Section 87`

-- A census taken on 1 June 1990 and a request on 2 June 2021: more than thirty years.
#ASSERT `s 87 — the Minister is entitled to obtain from Statistics Canada the information about the person's age that the census returns contain` TRUE (YearMonthDay 1990 6 1) (YearMonthDay 2021 6 2) TRUE
-- Exactly thirty years (request on 1 June 2020): not more than thirty.
#ASSERT NOT (`s 87 — the Minister is entitled to obtain from Statistics Canada the information about the person's age that the census returns contain` TRUE (YearMonthDay 1990 6 1) (YearMonthDay 2020 6 1) TRUE)
#ASSERT `s 87 — the Minister is entitled to obtain from Statistics Canada the information about the person's age that the census returns contain` TRUE (YearMonthDay 1990 5 31) (YearMonthDay 2020 6 1) TRUE
-- The purpose, or the prescribed conditions, missing.
#ASSERT NOT (`s 87 — the Minister is entitled to obtain from Statistics Canada the information about the person's age that the census returns contain` FALSE (YearMonthDay 1990 5 31) (YearMonthDay 2020 6 1) TRUE)
#ASSERT NOT (`s 87 — the Minister is entitled to obtain from Statistics Canada the information about the person's age that the census returns contain` TRUE (YearMonthDay 1990 5 31) (YearMonthDay 2020 6 1) FALSE)
-- Regulation 51: all four conditions.
#ASSERT `s 87 — the conditions prescribed by regulation 51 are met` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 87 — the conditions prescribed by regulation 51 are met` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 87 — the conditions prescribed by regulation 51 are met` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 87 — the conditions prescribed by regulation 51 are met` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 87 — the conditions prescribed by regulation 51 are met` TRUE TRUE TRUE FALSE)

§§ `Section 88`

#ASSERT `s 88(1) — the date on which the person is deemed to have died` TRUE TRUE (JUST (YearMonthDay 2020 5 5)) EQUALS JUST (YearMonthDay 2020 5 5)
#ASSERT `s 88(1) — the date on which the person is deemed to have died` FALSE TRUE (JUST (YearMonthDay 2020 5 5)) EQUALS NOTHING
#ASSERT `s 88(1) — the date on which the person is deemed to have died` TRUE FALSE (JUST (YearMonthDay 2020 5 5)) EQUALS NOTHING
-- The Minister has not determined a date.
#ASSERT `s 88(1) — the date on which the person is deemed to have died` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 88(2) — the date on which the person is deemed to have died after the Minister determines a different date` TRUE TRUE (JUST (YearMonthDay 2021 1 1)) EQUALS JUST (YearMonthDay 2021 1 1)
#ASSERT `s 88(2) — the date on which the person is deemed to have died after the Minister determines a different date` TRUE FALSE (JUST (YearMonthDay 2021 1 1)) EQUALS NOTHING
#ASSERT `s 88(2) — the date on which the person is deemed to have died after the Minister determines a different date` FALSE TRUE (JUST (YearMonthDay 2021 1 1)) EQUALS NOTHING
#ASSERT `s 88(2) — the Minister must forthwith cause to be paid any benefit that would have been payable if the determination of death had not been made` TRUE
#ASSERT NOT (`s 88(2) — the Minister must forthwith cause to be paid any benefit that would have been payable if the determination of death had not been made` FALSE)
#ASSERT `s 88(3) — the Minister must forthwith cause to be paid any benefit that would have been payable in respect of the person had the determination not been made` TRUE TRUE
#ASSERT NOT (`s 88(3) — the Minister must forthwith cause to be paid any benefit that would have been payable in respect of the person had the determination not been made` TRUE FALSE)
#ASSERT NOT (`s 88(3) — the Minister must forthwith cause to be paid any benefit that would have been payable in respect of the person had the determination not been made` FALSE TRUE)
-- Subsection (4): the benefit ceases, and what was paid before is deemed validly paid.
#ASSERT `s 88(4) — the benefit ceases forthwith to be payable` TRUE TRUE
#ASSERT `s 88(4) — the benefit paid before the Minister was satisfied that the other person is alive is deemed to have been validly paid` TRUE TRUE
#ASSERT NOT (`s 88(4) — the benefit ceases forthwith to be payable` TRUE FALSE)
#ASSERT NOT (`s 88(4) — the benefit paid before the Minister was satisfied that the other person is alive is deemed to have been validly paid` FALSE TRUE)
-- Subsection (5): the Minister is not bound by a death certificate, issued or revoked.
#ASSERT NOT (`s 88(5) — the Minister is bound by the issuance or revocation of a death certificate by another authority` TRUE)
#ASSERT NOT (`s 88(5) — the Minister is bound by the issuance or revocation of a death certificate by another authority` FALSE)

§§ `Section 90`

#ASSERT `s 90(1) — the person is guilty of an offence punishable on summary conviction` TRUE FALSE FALSE FALSE FALSE
-- The second limb of paragraph (a) has no "knowingly" in this text (NOTES.md, fork F16).
#ASSERT `s 90(1) — the person is guilty of an offence punishable on summary conviction` FALSE TRUE FALSE FALSE FALSE
#ASSERT `s 90(1) — the person is guilty of an offence punishable on summary conviction` FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 90(1) — the person is guilty of an offence punishable on summary conviction` FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 90(1) — the person is guilty of an offence punishable on summary conviction` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 90(1) — the person is guilty of an offence punishable on summary conviction` FALSE FALSE FALSE FALSE FALSE)
-- The Minister became aware on 10 March 2020: proceedings by 10 March 2025.
#ASSERT `s 90(2) — the last day on which proceedings in respect of an offence may be commenced` (YearMonthDay 2020 3 10) EQUALS YearMonthDay 2025 3 10
#ASSERT `s 90(2) — proceedings in respect of the offence may be commenced on that day` (YearMonthDay 2020 3 10) (YearMonthDay 2025 3 10)
#ASSERT NOT (`s 90(2) — proceedings in respect of the offence may be commenced on that day` (YearMonthDay 2020 3 10) (YearMonthDay 2025 3 11))
-- Subsection (3).
#ASSERT `s 90(3) — no proceeding shall be commenced under section 90 or the Criminal Code for the act or omission` TRUE
#ASSERT NOT (`s 90(3) — no proceeding shall be commenced under section 90 or the Criminal Code for the act or omission` FALSE)

§§ `Section 90.1`

#ASSERT `s 90.1(1) — the Minister may impose a penalty on the person` TRUE TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 90.1(1) — the Minister may impose a penalty on the person` TRUE FALSE TRUE FALSE FALSE FALSE
#ASSERT `s 90.1(1) — the Minister may impose a penalty on the person` TRUE FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 90.1(1) — the Minister may impose a penalty on the person` TRUE FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 90.1(1) — the Minister may impose a penalty on the person` TRUE FALSE FALSE FALSE FALSE TRUE
-- No act or omission of the five: no penalty. The Minister's opinion missing: no penalty.
#ASSERT NOT (`s 90.1(1) — the Minister may impose a penalty on the person` TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 90.1(1) — the Minister may impose a penalty on the person` FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT `s 90.1(1.1) — the purpose of the penalty` EQUALS `to promote compliance with this Act and not to punish`
-- At most $10,000 for each act or omission.
#ASSERT `s 90.1(2) — the most the Minister may set as the penalty for each act or omission` EQUALS 10000
#ASSERT `s 90.1(2) — the most the Minister may set as the penalty for the acts or omissions` 3 EQUALS 30000
#ASSERT `s 90.1(2) — the most the Minister may set as the penalty for the acts or omissions` 0 EQUALS 0
#ASSERT `s 90.1(2) — the amount set for the act or omission is within the maximum` 10000
#ASSERT NOT (`s 90.1(2) — the amount set for the act or omission is within the maximum` 10000.01)
-- Subsection (3): a prosecution has been initiated, or five years have passed since the Minister became aware (10 March 2020).
#ASSERT `s 90.1(3) — a penalty shall not be imposed on the person` TRUE (YearMonthDay 2020 3 10) (YearMonthDay 2021 1 1)
#ASSERT NOT (`s 90.1(3) — a penalty shall not be imposed on the person` FALSE (YearMonthDay 2020 3 10) (YearMonthDay 2025 3 9))
#ASSERT `s 90.1(3) — a penalty shall not be imposed on the person` FALSE (YearMonthDay 2020 3 10) (YearMonthDay 2025 3 10)
-- Subsection (4): each ground alone.
#ASSERT `s 90.1(4) — the Minister may rescind the imposition of the penalty, or reduce it` TRUE FALSE FALSE FALSE
#ASSERT `s 90.1(4) — the Minister may rescind the imposition of the penalty, or reduce it` FALSE TRUE FALSE FALSE
#ASSERT `s 90.1(4) — the Minister may rescind the imposition of the penalty, or reduce it` FALSE FALSE TRUE FALSE
#ASSERT `s 90.1(4) — the Minister may rescind the imposition of the penalty, or reduce it` FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 90.1(4) — the Minister may rescind the imposition of the penalty, or reduce it` FALSE FALSE FALSE FALSE)

§§ `Section 90.2`

-- The definitions.
#ASSERT `s 90.2(1) — a thing is a document` `moneys as a kind of document` EQUALS JUST TRUE
#ASSERT `s 90.2(1) — a thing is a document` `machine-readable records as a kind of document` EQUALS JUST TRUE
#ASSERT `s 90.2(1) — a thing is a document` `a copy or printout of any of those things as a kind of document` EQUALS JUST TRUE
#ASSERT `s 90.2(1) — a thing is a document` `another kind of thing that the definition of document does not list` EQUALS NOTHING
#ASSERT `s 90.2(1) — a place is a dwelling-house` TRUE FALSE FALSE
#ASSERT `s 90.2(1) — a place is a dwelling-house` FALSE TRUE FALSE
#ASSERT `s 90.2(1) — a place is a dwelling-house` FALSE FALSE TRUE
#ASSERT NOT (`s 90.2(1) — a place is a dwelling-house` FALSE FALSE FALSE)
#ASSERT `s 90.2(1) — a person is a judge` TRUE FALSE
#ASSERT `s 90.2(1) — a person is a judge` FALSE TRUE
#ASSERT NOT (`s 90.2(1) — a person is a judge` FALSE FALSE)
-- Subsection (3): a dwelling-house needs the occupant's consent or a warrant.
#ASSERT `s 90.2(3) — the Minister may enter the dwelling-house` FALSE FALSE FALSE
#ASSERT NOT (`s 90.2(3) — the Minister may enter the dwelling-house` TRUE FALSE FALSE)
#ASSERT `s 90.2(3) — the Minister may enter the dwelling-house` TRUE TRUE FALSE
#ASSERT `s 90.2(3) — the Minister may enter the dwelling-house` TRUE FALSE TRUE
-- Subsection (2)(a): entry, at a reasonable time, for the purpose, where a document is believed kept, subject to (3).
#ASSERT `s 90.2(2)(a) — the Minister may enter the premises or place` TRUE TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT (`s 90.2(2)(a) — the Minister may enter the premises or place` TRUE TRUE TRUE TRUE FALSE FALSE)
#ASSERT `s 90.2(2)(a) — the Minister may enter the premises or place` TRUE TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT (`s 90.2(2)(a) — the Minister may enter the premises or place` FALSE TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`s 90.2(2)(a) — the Minister may enter the premises or place` TRUE FALSE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`s 90.2(2)(a) — the Minister may enter the premises or place` TRUE TRUE FALSE FALSE FALSE FALSE)
-- Subsection (2)(b): the owner, occupant or person in charge.
#ASSERT `s 90.2(2)(b) — the person must give the Minister all reasonable assistance, answer all proper questions and attend at the place` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 90.2(2)(b) — the person must give the Minister all reasonable assistance, answer all proper questions and attend at the place` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`s 90.2(2)(b) — the person must give the Minister all reasonable assistance, answer all proper questions and attend at the place` FALSE TRUE TRUE TRUE)
-- Subsections (4) and (5): the judge.
#ASSERT `s 90.2(4) — a judge may issue a warrant authorizing the Minister to enter the dwelling-house` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 90.2(4) — a judge may issue a warrant authorizing the Minister to enter the dwelling-house` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`s 90.2(4) — a judge may issue a warrant authorizing the Minister to enter the dwelling-house` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 90.2(4) — a judge may issue a warrant authorizing the Minister to enter the dwelling-house` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 90.2(4) — a judge may issue a warrant authorizing the Minister to enter the dwelling-house` FALSE TRUE TRUE TRUE)
#ASSERT `s 90.2(5) — a judge may order the occupant to provide the Minister with reasonable access to the document and make any other appropriate order` TRUE TRUE
#ASSERT NOT (`s 90.2(5) — a judge may order the occupant to provide the Minister with reasonable access to the document and make any other appropriate order` TRUE FALSE)
-- Subsections (6) and (7): a requirement, and the unnamed persons.
#ASSERT `s 90.2(7) — the Minister may impose the requirement on the third party` FALSE FALSE
#ASSERT NOT (`s 90.2(7) — the Minister may impose the requirement on the third party` TRUE FALSE)
#ASSERT `s 90.2(7) — the Minister may impose the requirement on the third party` TRUE TRUE
#ASSERT `s 90.2(6) — the person must provide the information or document within the time stipulated in the notice` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 90.2(6) — the person must provide the information or document within the time stipulated in the notice` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 90.2(6) — the person must provide the information or document within the time stipulated in the notice` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 90.2(6) — the person must provide the information or document within the time stipulated in the notice` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`s 90.2(6) — the person must provide the information or document within the time stipulated in the notice` FALSE TRUE TRUE TRUE)
-- Subsection (8): authorization.
#ASSERT `s 90.2(8) — a judge may authorize the Minister to impose the requirement on the third party` TRUE TRUE TRUE
#ASSERT NOT (`s 90.2(8) — a judge may authorize the Minister to impose the requirement on the third party` TRUE FALSE TRUE)
#ASSERT NOT (`s 90.2(8) — a judge may authorize the Minister to impose the requirement on the third party` TRUE TRUE FALSE)
-- Subsection (9): served together with the notice.
#ASSERT `s 90.2(9) — the authorization has been served as the subsection requires` TRUE TRUE
#ASSERT NOT (`s 90.2(9) — the authorization has been served as the subsection requires` TRUE FALSE)
#ASSERT `s 90.2(9) — the authorization has been served as the subsection requires` FALSE FALSE
-- Subsection (10): the notice served on 1 March 2023, fifteen days: 16 March 2023.
#ASSERT `s 90.2(10) — the last day on which the third party may apply for a review of the authorization` (YearMonthDay 2023 3 1) EQUALS YearMonthDay 2023 3 16
#ASSERT `s 90.2(10) — the third party may apply for a review of the authorization` TRUE (YearMonthDay 2023 3 1) (YearMonthDay 2023 3 16)
#ASSERT NOT (`s 90.2(10) — the third party may apply for a review of the authorization` TRUE (YearMonthDay 2023 3 1) (YearMonthDay 2023 3 17))
#ASSERT NOT (`s 90.2(10) — the third party may apply for a review of the authorization` FALSE (YearMonthDay 2023 3 1) (YearMonthDay 2023 3 10))
-- 15 days across a month end: 25 February 2023 plus 15 days is 12 March 2023 (3 days to 28 February, 12 more).
#ASSERT `s 90.2(10) — the last day on which the third party may apply for a review of the authorization` (YearMonthDay 2023 2 25) EQUALS YearMonthDay 2023 3 12
-- Subsection (11).
#ASSERT `s 90.2(11) — the judge may cancel the authorization previously granted` FALSE TRUE
#ASSERT `s 90.2(11) — the judge may cancel the authorization previously granted` TRUE FALSE
#ASSERT NOT (`s 90.2(11) — the judge may cancel the authorization previously granted` TRUE TRUE)
#ASSERT `s 90.2(11) — the judge may confirm or vary the authorization` TRUE TRUE
#ASSERT NOT (`s 90.2(11) — the judge may confirm or vary the authorization` TRUE FALSE)
-- Subsections (12) and (13).
#ASSERT `s 90.2(12) — the copy is evidence of the nature and content of the original document and has the same probative force` TRUE TRUE
#ASSERT NOT (`s 90.2(12) — the copy is evidence of the nature and content of the original document and has the same probative force` TRUE FALSE)
#ASSERT `s 90.2(13) — the person contravened the prohibition on interfering with or preventing a person doing what section 90.2 authorizes` TRUE TRUE
#ASSERT NOT (`s 90.2(13) — the person contravened the prohibition on interfering with or preventing a person doing what section 90.2 authorizes` TRUE FALSE)
