IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cr2-nouns`
IMPORT `cr2-reconsideration`

-- Tests of cr2-reconsideration.l4 (regulations 74 to 74.2). Layer 1.
-- Every expected value was decided by reading the regulations and counting on a calendar before the rules were run.

§ `Tests -- regulations 74 to 74.2`

`item 74.1(1)(a)` MEANS `reg 74.1(1)(a) — the name, address and Social Insurance Number of the contributor`
`item 74.1(1)(b)` MEANS `reg 74.1(1)(b) — where the person making the request is not the contributor, that person's name and address and relationship to the contributor`
`item 74.1(1)(c)` MEANS `reg 74.1(1)(c) — the grounds for the request and a statement of the facts that form the basis of it`

§§ `74 -- on behalf of a person incapable of managing their affairs`

-- Arguments: the Minister or the Tribunal is satisfied the person is incapable; the other is authorized by law; none so authorized; the other is considered qualified.
#ASSERT `reg 74 — a request for reconsideration or an appeal may be made on behalf of a person incapable of managing their affairs` TRUE TRUE FALSE FALSE
#ASSERT `reg 74 — a request for reconsideration or an appeal may be made on behalf of a person incapable of managing their affairs` TRUE FALSE TRUE TRUE
#ASSERT NOT (`reg 74 — a request for reconsideration or an appeal may be made on behalf of a person incapable of managing their affairs` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`reg 74 — a request for reconsideration or an appeal may be made on behalf of a person incapable of managing their affairs` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`reg 74 — a request for reconsideration or an appeal may be made on behalf of a person incapable of managing their affairs` FALSE TRUE FALSE FALSE)

§§ `74.1(1) -- what the request sets out`

#ASSERT `reg 74.1(1) — the items the request has to set out` FALSE EQUALS (LIST `item 74.1(1)(a)`, `item 74.1(1)(c)`)
#ASSERT `reg 74.1(1) — the items the request has to set out` TRUE EQUALS (LIST `item 74.1(1)(a)`, `item 74.1(1)(b)`, `item 74.1(1)(c)`)
-- Arguments: the person making the request is not the contributor; the items already set out.
#ASSERT `reg 74.1(1) — the items the request still has to set out` TRUE (LIST `item 74.1(1)(a)`) EQUALS (LIST `item 74.1(1)(b)`, `item 74.1(1)(c)`)
#ASSERT `reg 74.1(1) — the items the request still has to set out` FALSE (LIST `item 74.1(1)(a)`) EQUALS (LIST `item 74.1(1)(c)`)
#ASSERT `reg 74.1(1) — the items the request still has to set out` FALSE (LIST `item 74.1(1)(a)`, `item 74.1(1)(c)`) EQUALS EMPTY
-- item (b) set out by a contributor is superfluous, and nothing is owed for it
#ASSERT `reg 74.1(1) — the items the request still has to set out` FALSE (LIST `item 74.1(1)(a)`, `item 74.1(1)(b)`, `item 74.1(1)(c)`) EQUALS EMPTY
#ASSERT `reg 74.1(1) — a request for reconsideration is made as the Regulations require` TRUE
#ASSERT NOT (`reg 74.1(1) — a request for reconsideration is made as the Regulations require` FALSE)

§§ `74.1(2) to (4) -- a longer period`

#ASSERT `reg 74.1(2) — the Minister may take any steps to obtain the information that is necessary to rectify the failure` TRUE
#ASSERT NOT (`reg 74.1(2) — the Minister may take any steps to obtain the information that is necessary to rectify the failure` FALSE)
-- Notified in writing on 1 January 2026: the 365-day period ends 1 January 2027.
#ASSERT `reg 74.1(4)(a) — the last day of the 365-day period after the notification` (YearMonthDay 2026 1 1) EQUALS (YearMonthDay 2027 1 1)
-- Notified 1 January 2023: 365 days after is 1 January 2024 (2023 is not a leap year).
#ASSERT `reg 74.1(4)(a) — the last day of the 365-day period after the notification` (YearMonthDay 2023 1 1) EQUALS (YearMonthDay 2024 1 1)
-- Notified 1 January 2024: 365 days after is 31 December 2024 (2024 is a leap year).
#ASSERT `reg 74.1(4)(a) — the last day of the 365-day period after the notification` (YearMonthDay 2024 1 1) EQUALS (YearMonthDay 2024 12 31)
-- 74.1(4) applies: arguments: date notified; date of the request; applied again for the same benefit; requested the Minister to rescind or amend under section 81(3).
#ASSERT `reg 74.1(4) — the Minister must also be satisfied of a reasonable chance of success and no prejudice` (YearMonthDay 2026 1 1) (YearMonthDay 2027 1 2) FALSE FALSE
-- on the last day of the 365-day period, the request is not "after" it
#ASSERT NOT (`reg 74.1(4) — the Minister must also be satisfied of a reasonable chance of success and no prejudice` (YearMonthDay 2026 1 1) (YearMonthDay 2027 1 1) FALSE FALSE)
#ASSERT `reg 74.1(4) — the Minister must also be satisfied of a reasonable chance of success and no prejudice` (YearMonthDay 2026 1 1) (YearMonthDay 2026 6 1) TRUE FALSE
#ASSERT `reg 74.1(4) — the Minister must also be satisfied of a reasonable chance of success and no prejudice` (YearMonthDay 2026 1 1) (YearMonthDay 2026 6 1) FALSE TRUE
#ASSERT NOT (`reg 74.1(4) — the Minister must also be satisfied of a reasonable chance of success and no prejudice` (YearMonthDay 2026 1 1) (YearMonthDay 2026 6 1) FALSE FALSE)
-- 74.1(3): arguments: reasonable explanation; continuing intention; subsection (4) applies; reasonable chance of success; no prejudice.
#ASSERT `reg 74.1(3) — the Minister may allow a longer period to make a request for reconsideration` TRUE TRUE FALSE FALSE FALSE
#ASSERT `reg 74.1(3) — the Minister may allow a longer period to make a request for reconsideration` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 74.1(3) — the Minister may allow a longer period to make a request for reconsideration` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`reg 74.1(3) — the Minister may allow a longer period to make a request for reconsideration` TRUE TRUE TRUE TRUE FALSE)
#ASSERT NOT (`reg 74.1(3) — the Minister may allow a longer period to make a request for reconsideration` FALSE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 74.1(3) — the Minister may allow a longer period to make a request for reconsideration` TRUE FALSE FALSE TRUE TRUE)

§§ `74.2 -- notification of an appealable decision`

#ASSERT `reg 74.2 — a notification referred to in subsection 81(1) or (1.1) of the Act is given as the Regulations require` TRUE TRUE
#ASSERT NOT (`reg 74.2 — a notification referred to in subsection 81(1) or (1.1) of the Act is given as the Regulations require` TRUE FALSE)
#ASSERT NOT (`reg 74.2 — a notification referred to in subsection 81(1) or (1.1) of the Act is given as the Regulations require` FALSE TRUE)
