§ `Tests -- section 9(2) and (3)`

-- 9(2): immediate succession, and a formation or dissolution of a corporation, or an acquisition with the former employer's agreement or by operation of law.
#ASSERT `s 9(2) — the successor employer may take into account the amounts the former employer paid, deducted, remitted or contributed` TRUE TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `s 9(2) — the successor employer may take into account the amounts the former employer paid, deducted, remitted or contributed` TRUE FALSE TRUE TRUE FALSE EQUALS TRUE
#ASSERT `s 9(2) — the successor employer may take into account the amounts the former employer paid, deducted, remitted or contributed` TRUE FALSE TRUE FALSE TRUE EQUALS TRUE
#ASSERT `s 9(2) — the successor employer may take into account the amounts the former employer paid, deducted, remitted or contributed` TRUE FALSE TRUE FALSE FALSE EQUALS FALSE
#ASSERT `s 9(2) — the successor employer may take into account the amounts the former employer paid, deducted, remitted or contributed` TRUE FALSE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `s 9(2) — the successor employer may take into account the amounts the former employer paid, deducted, remitted or contributed` FALSE TRUE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `s 9(2) — the amount the successor employer may take into account as if it had paid, deducted, remitted or contributed it` TRUE 1_200 EQUALS JUST 1_200
#ASSERT `s 9(2) — the amount the successor employer may take into account as if it had paid, deducted, remitted or contributed it` FALSE 1_200 EQUALS NOTHING
#ASSERT `s 9(2) — the successor employer must also take the amounts into account with respect to the employee's contributions` TRUE EQUALS TRUE
#ASSERT `s 9(2) — the successor employer must also take the amounts into account with respect to the employee's contributions` FALSE EQUALS FALSE

-- 9(3): self-employed, ceases, becomes an employee of a corporation the person controls.
#ASSERT `s 9(3) — the corporation may take into account the person's self-employment` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `s 9(3) — the corporation may take into account the person's self-employment` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `s 9(3) — the corporation may take into account the person's self-employment` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `s 9(3) — the corporation may take into account the person's self-employment` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `s 9(3)(a) — the amount the corporation may take into account as contributory salary and wages paid to the employee in that year` TRUE 30_000 EQUALS JUST 30_000
#ASSERT `s 9(3)(a) — the amount the corporation may take into account as contributory salary and wages paid to the employee in that year` FALSE 30_000 EQUALS NOTHING
-- 9(3)(b): the person's self-employed contributions of 3,000 count one half (1,500) for the employee side and one half (1,500) for the employer side (fork, NOTES.md).
#ASSERT `s 9(3)(b) — the amount the corporation may take into account in relation to the employee's contributions for that year` TRUE 3_000 EQUALS JUST 1_500
#ASSERT `s 9(3)(b) — the amount the corporation may take into account in relation to the employer's contributions for that year` TRUE 3_000 EQUALS JUST 1_500
#ASSERT `s 9(3)(b) — the amount the corporation may take into account in relation to the employee's contributions for that year` FALSE 3_000 EQUALS NOTHING
#ASSERT `s 9(3)(b) — the amount the corporation may take into account in relation to the employer's contributions for that year` FALSE 3_000 EQUALS NOTHING

-- Helper (not a provision): the amount by which one amount exceeds another is 0 where it does not exceed.
#ASSERT `the amount by which one amount exceeds another` 10 4 EQUALS 6
#ASSERT `the amount by which one amount exceeds another` 4 10 EQUALS 0
#ASSERT `the amount by which one amount exceeds another` 5 5 EQUALS 0
