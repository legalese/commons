IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-age`
IMPORT `cp3-nouns`
IMPORT `cp3-benefits-not-payable`

-- Tests of cp3-benefits-not-payable.l4 (sections 44.1 and 44.2). Expected values are worked by hand from the text.

§ `Tests -- the conviction (44.1(3), (6), (7), (8))`

-- Arguments: convicted of murder, convicted of manslaughter, convicted outside Canada of an equivalent offence, the Minister deems it, released on a probation order.
#ASSERT `s 44.1 — a conviction that engages this section` TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 44.1 — a conviction that engages this section` FALSE TRUE FALSE FALSE FALSE
-- a conviction outside Canada the Minister deems to be one
#ASSERT `s 44.1 — a conviction that engages this section` FALSE FALSE TRUE TRUE FALSE
-- a conviction outside Canada the Minister has not deemed to be one
#ASSERT NOT `s 44.1 — a conviction that engages this section` FALSE FALSE TRUE FALSE FALSE
-- no conviction at all
#ASSERT NOT `s 44.1 — a conviction that engages this section` FALSE FALSE FALSE FALSE FALSE
-- manslaughter, but released on the conditions of a probation order under paragraph 731(1)(a): the section does not apply
#ASSERT NOT `s 44.1 — a conviction that engages this section` FALSE TRUE FALSE FALSE TRUE
-- the probation-order exception is for manslaughter only: a murder conviction is not saved by it
#ASSERT `s 44.1 — a conviction that engages this section` TRUE FALSE FALSE FALSE TRUE

§ `Tests -- reinstatement (44.1(2))`

#ASSERT `s 44.1(2) — the individual's entitlement is reinstated and any amount recovered is repaid` TRUE TRUE
-- the appeals are not exhausted
#ASSERT NOT `s 44.1(2) — the individual's entitlement is reinstated and any amount recovered is repaid` TRUE FALSE
-- the Minister is not informed and satisfied of a reversal, withdrawal or stay
#ASSERT NOT `s 44.1(2) — the individual's entitlement is reinstated and any amount recovered is repaid` FALSE TRUE

§ `Tests -- the three benefits (44.1(1))`

-- Arguments of (a) and (b): the Minister is informed and satisfied of the conviction, the conviction engages the section, entitlement reinstated.
#ASSERT `s 44.1(1)(a) — a survivor's pension is not payable to an individual convicted of killing the contributor` TRUE TRUE FALSE
#ASSERT NOT `s 44.1(1)(a) — a survivor's pension is not payable to an individual convicted of killing the contributor` FALSE TRUE FALSE
#ASSERT NOT `s 44.1(1)(a) — a survivor's pension is not payable to an individual convicted of killing the contributor` TRUE FALSE FALSE
-- reinstated under subsection (2): payable again
#ASSERT NOT `s 44.1(1)(a) — a survivor's pension is not payable to an individual convicted of killing the contributor` TRUE TRUE TRUE
#ASSERT `s 44.1(1)(b) — a death benefit is not payable to an individual convicted of killing the contributor` TRUE TRUE FALSE
#ASSERT NOT `s 44.1(1)(b) — a death benefit is not payable to an individual convicted of killing the contributor` FALSE TRUE FALSE
#ASSERT NOT `s 44.1(1)(b) — a death benefit is not payable to an individual convicted of killing the contributor` TRUE TRUE TRUE
-- Arguments of (c): informed and satisfied of the conviction, engaged, adult sentence, date of birth, the date asked, reinstated.
-- born 10 March 2000: 18 on 10 March 2018, deemed 1 April 2018. On 31 March 2018 not yet 18: payable
#ASSERT NOT `s 44.1(1)(c) — an orphan's benefit is not payable to an individual convicted of killing the contributor` TRUE TRUE TRUE (YMD 2000 3 10) (YMD 2018 3 31) FALSE
-- on 1 April 2018: 18 reached, with an adult sentence: not payable
#ASSERT `s 44.1(1)(c) — an orphan's benefit is not payable to an individual convicted of killing the contributor` TRUE TRUE TRUE (YMD 2000 3 10) (YMD 2018 4 1) FALSE
-- no adult sentence: still payable
#ASSERT NOT `s 44.1(1)(c) — an orphan's benefit is not payable to an individual convicted of killing the contributor` TRUE TRUE FALSE (YMD 2000 3 10) (YMD 2018 4 1) FALSE
-- not informed and satisfied of the conviction
#ASSERT NOT `s 44.1(1)(c) — an orphan's benefit is not payable to an individual convicted of killing the contributor` FALSE TRUE TRUE (YMD 2000 3 10) (YMD 2018 4 1) FALSE
-- the conviction does not engage the section
#ASSERT NOT `s 44.1(1)(c) — an orphan's benefit is not payable to an individual convicted of killing the contributor` TRUE FALSE TRUE (YMD 2000 3 10) (YMD 2018 4 1) FALSE
-- reinstated
#ASSERT NOT `s 44.1(1)(c) — an orphan's benefit is not payable to an individual convicted of killing the contributor` TRUE TRUE TRUE (YMD 2000 3 10) (YMD 2018 4 1) TRUE

§ `Tests -- recovery (44.1(4)) and the time of being informed (44.1(5))`

-- 1000 + 1000 + 250 received, a bar applies: 2250 is a debt
#ASSERT `s 44.1(4) — the amount received that is a debt due to Her Majesty` TRUE TRUE (LIST 1000, 1000, 250) EQUALS JUST 2250
-- no bar: no debt under this subsection
#ASSERT `s 44.1(4) — the amount received that is a debt due to Her Majesty` TRUE FALSE (LIST 1000, 1000, 250) EQUALS NOTHING
-- nothing received
#ASSERT `s 44.1(4) — the amount received that is a debt due to Her Majesty` FALSE TRUE (LIST 1000) EQUALS NOTHING
-- received but nothing in the list: a debt of nothing
#ASSERT `s 44.1(4) — the amount received that is a debt due to Her Majesty` TRUE TRUE EMPTY EQUALS JUST 0

#ASSERT `s 44.1(5) — this section applies to a conviction of which the Minister is informed at a given time` `before the coming into force of section 44.1`
#ASSERT `s 44.1(5) — this section applies to a conviction of which the Minister is informed at a given time` `on the coming into force of section 44.1`
#ASSERT `s 44.1(5) — this section applies to a conviction of which the Minister is informed at a given time` `after the coming into force of section 44.1`

§ `Tests -- section 44.2`

-- Arguments: a division under paragraph 55.1(1)(b), its day, cohabiting in a new relationship at the death, the day that began, the day of death.
-- a division on 1 January 2025 and no new relationship: not payable
#ASSERT `s 44.2 — a survivor's pension is not payable to an individual after a division of earnings` TRUE (YMD 2025 1 1) FALSE (YMD 2020 1 1) (YMD 2026 6 1)
-- a division on 31 December 2024: before the day, so section 44.2 does not bar it
#ASSERT NOT `s 44.2 — a survivor's pension is not payable to an individual after a division of earnings` TRUE (YMD 2024 12 31) FALSE (YMD 2020 1 1) (YMD 2026 6 1)
-- no division at all
#ASSERT NOT `s 44.2 — a survivor's pension is not payable to an individual after a division of earnings` FALSE (YMD 2025 1 1) FALSE (YMD 2020 1 1) (YMD 2026 6 1)
-- a new conjugal relationship begun 1 March 2025 and a death on 1 March 2026: a year to the day: the exception holds
#ASSERT NOT `s 44.2 — a survivor's pension is not payable to an individual after a division of earnings` TRUE (YMD 2025 1 1) TRUE (YMD 2025 3 1) (YMD 2026 3 1)
-- a death one day short of the year: the exception fails
#ASSERT `s 44.2 — a survivor's pension is not payable to an individual after a division of earnings` TRUE (YMD 2025 1 1) TRUE (YMD 2025 3 1) (YMD 2026 2 28)
-- the relationship lasted well over a year
#ASSERT NOT `s 44.2 — a survivor's pension is not payable to an individual after a division of earnings` TRUE (YMD 2025 1 1) TRUE (YMD 2025 2 1) (YMD 2028 2 1)
