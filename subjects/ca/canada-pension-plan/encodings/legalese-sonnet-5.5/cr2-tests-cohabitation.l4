IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cr2-nouns`
IMPORT `cr2-cohabitation`

-- Tests of cr2-cohabitation.l4 (regulations 78, 78.1 and 78.2). Layer 1.
-- Every expected value was decided by reading the regulations and counting months on a calendar before the rules were run.

§ `Tests -- regulations 78, 78.1 and 78.2`

§§ `78(2) -- does a separation interrupt the cohabitation`

-- Arguments: days separated; separated by occupation, employment or illness without intending to live apart; had completed the 36-month minimum
-- before the separation; resumed cohabitation for more than 90 days.
#ASSERT `reg 78(2) — a separation interrupts the cohabitation of the former spouses` 91 FALSE FALSE FALSE
-- exactly 90 days is not "more than 90 days"
#ASSERT NOT (`reg 78(2) — a separation interrupts the cohabitation of the former spouses` 90 FALSE FALSE FALSE)
#ASSERT NOT (`reg 78(2) — a separation interrupts the cohabitation of the former spouses` 0 FALSE FALSE FALSE)
-- a separation by reason of occupation, employment or illness is no interruption, however long
#ASSERT NOT (`reg 78(2) — a separation interrupts the cohabitation of the former spouses` 200 TRUE FALSE FALSE)
-- after the 36-month minimum, a separation followed by more than 90 days of resumed cohabitation is deemed no interruption
#ASSERT NOT (`reg 78(2) — a separation interrupts the cohabitation of the former spouses` 200 FALSE TRUE TRUE)
#ASSERT `reg 78(2) — a separation interrupts the cohabitation of the former spouses` 200 FALSE TRUE FALSE
-- the deeming needs the 36 months to have been completed first
#ASSERT `reg 78(2) — a separation interrupts the cohabitation of the former spouses` 200 FALSE FALSE TRUE
#ASSERT `reg 78(3) — the first day of the year before which the cohabitation is deemed to have ceased` 2019 EQUALS (YMD 2019 1 1)

§§ `78(1)(a) and (b) -- the months that count`

-- Arguments: a day in the month; lived together as husband and wife in the month; the month is during the marriage; the year an interruption commenced (or nothing).
#ASSERT `reg 78(1)(a) — the month is a month of cohabitation without interruption for more than 90 days` (YMD 2018 3 20) TRUE TRUE NOTHING
-- an interruption commenced in 2019: the cohabitation is deemed to have ceased immediately before 2019
#ASSERT `reg 78(1)(a) — the month is a month of cohabitation without interruption for more than 90 days` (YMD 2018 3 20) TRUE TRUE (JUST 2019)
#ASSERT `reg 78(1)(a) — the month is a month of cohabitation without interruption for more than 90 days` (YMD 2018 12 31) TRUE TRUE (JUST 2019)
#ASSERT NOT (`reg 78(1)(a) — the month is a month of cohabitation without interruption for more than 90 days` (YMD 2019 1 1) TRUE TRUE (JUST 2019))
#ASSERT NOT (`reg 78(1)(a) — the month is a month of cohabitation without interruption for more than 90 days` (YMD 2019 3 20) TRUE TRUE (JUST 2019))
#ASSERT NOT (`reg 78(1)(a) — the month is a month of cohabitation without interruption for more than 90 days` (YMD 2018 3 20) FALSE TRUE NOTHING)
#ASSERT NOT (`reg 78(1)(a) — the month is a month of cohabitation without interruption for more than 90 days` (YMD 2018 3 20) TRUE FALSE NOTHING)
-- (b): during the marriage and before the minimum 36 months of cohabitation
#ASSERT `reg 78(1)(b) — the month is in a period of the marriage preceding the minimum period of 36 consecutive months of cohabitation` TRUE TRUE
#ASSERT NOT (`reg 78(1)(b) — the month is in a period of the marriage preceding the minimum period of 36 consecutive months of cohabitation` TRUE FALSE)
#ASSERT NOT (`reg 78(1)(b) — the month is in a period of the marriage preceding the minimum period of 36 consecutive months of cohabitation` FALSE TRUE)
-- Arguments: a day in the month; lived together; during the marriage; the interruption year; precedes the 36-month minimum.
#ASSERT `reg 78(1) — the month is a month during which the former spouses have cohabited` (YMD 2018 3 20) TRUE TRUE NOTHING FALSE
-- a month after the interruption year does not count under (a) ...
#ASSERT NOT (`reg 78(1) — the month is a month during which the former spouses have cohabited` (YMD 2019 3 20) TRUE TRUE (JUST 2019) FALSE)
-- ... but counts under (b) if it precedes the 36-month minimum
#ASSERT `reg 78(1) — the month is a month during which the former spouses have cohabited` (YMD 2019 3 20) TRUE TRUE (JUST 2019) TRUE
-- (b) counts a month though the spouses did not live together in it
#ASSERT `reg 78(1) — the month is a month during which the former spouses have cohabited` (YMD 2019 3 20) FALSE TRUE NOTHING TRUE
-- but only a month of the marriage
#ASSERT NOT (`reg 78(1) — the month is a month during which the former spouses have cohabited` (YMD 2019 3 20) FALSE FALSE NOTHING TRUE)

§§ `78.1 -- cohabitation for the division of unadjusted pensionable earnings`

-- (1)(a): the months are reckoned from the first month of the year of the marriage or of commencing to cohabit.
#ASSERT `reg 78.1(1)(a) — the first month of cohabitation` (YMD 2010 6 15) EQUALS (YMD 2010 1 1)
#ASSERT `reg 78.1(1)(a) — the first month of cohabitation` (YMD 2010 12 31) EQUALS (YMD 2010 1 1)
-- (1)(b): no cohabitation at any time in the year of the divorce, annulment or of commencing to live apart.
#ASSERT `reg 78.1(1)(b) — the persons are considered not to have cohabited at any time during the month` (YMD 2018 9 15) (LIST (YMD 2013 3 10), (YMD 2018 9 20))
#ASSERT `reg 78.1(1)(b) — the persons are considered not to have cohabited at any time during the month` (YMD 2013 11 1) (LIST (YMD 2013 3 10), (YMD 2018 9 20))
#ASSERT NOT (`reg 78.1(1)(b) — the persons are considered not to have cohabited at any time during the month` (YMD 2017 9 15) (LIST (YMD 2013 3 10), (YMD 2018 9 20)))
#ASSERT NOT (`reg 78.1(1)(b) — the persons are considered not to have cohabited at any time during the month` (YMD 2017 9 15) EMPTY)
-- (1)(c): a separation of a year or more followed by at least a year of resumed cohabitation counts from the first month of the year they
-- commenced to live apart to the last month of the year before they resumed: here January 2013 to December 2014.
`separation 2013 to 2015` MEANS `cr2 Separation followed by resumed cohabitation` WITH
    `the date they commenced to live separate and apart` IS YMD 2013 3 10
    `they lived separate and apart for one year or more` IS TRUE
    `the date they resumed cohabitation` IS YMD 2015 2 1
    `they resumed cohabitation for at least one year` IS TRUE
`separation 2013 resumed for under a year` MEANS `cr2 Separation followed by resumed cohabitation` WITH
    `the date they commenced to live separate and apart` IS YMD 2013 3 10
    `they lived separate and apart for one year or more` IS TRUE
    `the date they resumed cohabitation` IS YMD 2015 2 1
    `they resumed cohabitation for at least one year` IS FALSE
`separation 2013 of under a year` MEANS `cr2 Separation followed by resumed cohabitation` WITH
    `the date they commenced to live separate and apart` IS YMD 2013 3 10
    `they lived separate and apart for one year or more` IS FALSE
    `the date they resumed cohabitation` IS YMD 2013 9 1
    `they resumed cohabitation for at least one year` IS TRUE
#ASSERT `reg 78.1(1)(c) — the month falls within the period of the separation` (YMD 2013 1 31) `separation 2013 to 2015`
#ASSERT `reg 78.1(1)(c) — the month falls within the period of the separation` (YMD 2014 12 31) `separation 2013 to 2015`
#ASSERT NOT (`reg 78.1(1)(c) — the month falls within the period of the separation` (YMD 2012 12 15) `separation 2013 to 2015`)
#ASSERT NOT (`reg 78.1(1)(c) — the month falls within the period of the separation` (YMD 2015 1 15) `separation 2013 to 2015`)
#ASSERT NOT (`reg 78.1(1)(c) — the month falls within the period of the separation` (YMD 2014 6 1) `separation 2013 resumed for under a year`)
#ASSERT NOT (`reg 78.1(1)(c) — the month falls within the period of the separation` (YMD 2013 6 1) `separation 2013 of under a year`)
-- (1): arguments: a day in the month; lived together in the month; marriage or cohabitation began; divorce, annulment or separation dates; qualifying separations.
-- Married 15 June 2010; commenced to live apart 10 March 2013 and resumed 1 February 2015; divorced 20 September 2018.
-- before the first month (January 2010)
#ASSERT NOT (`reg 78.1(1) — the month is a month during which the persons cohabited` (YMD 2009 12 1) TRUE (YMD 2010 6 15) (LIST (YMD 2013 3 10), (YMD 2018 9 20)) (LIST `separation 2013 to 2015`))
-- the first month of the year of the marriage counts, though the marriage was in June
#ASSERT `reg 78.1(1) — the month is a month during which the persons cohabited` (YMD 2010 1 20) TRUE (YMD 2010 6 15) (LIST (YMD 2013 3 10), (YMD 2018 9 20)) (LIST `separation 2013 to 2015`)
#ASSERT `reg 78.1(1) — the month is a month during which the persons cohabited` (YMD 2012 6 1) TRUE (YMD 2010 6 15) (LIST (YMD 2013 3 10), (YMD 2018 9 20)) (LIST `separation 2013 to 2015`)
-- a month in which they did not live together does not count
#ASSERT NOT (`reg 78.1(1) — the month is a month during which the persons cohabited` (YMD 2012 6 1) FALSE (YMD 2010 6 15) (LIST (YMD 2013 3 10), (YMD 2018 9 20)) (LIST `separation 2013 to 2015`))
-- the year they commenced to live apart (2013)
#ASSERT NOT (`reg 78.1(1) — the month is a month during which the persons cohabited` (YMD 2013 6 1) TRUE (YMD 2010 6 15) (LIST (YMD 2013 3 10), (YMD 2018 9 20)) (LIST `separation 2013 to 2015`))
-- 2014 is inside the separation period of (c), though no event falls in it
#ASSERT NOT (`reg 78.1(1) — the month is a month during which the persons cohabited` (YMD 2014 6 1) TRUE (YMD 2010 6 15) (LIST (YMD 2013 3 10), (YMD 2018 9 20)) (LIST `separation 2013 to 2015`))
-- ... but not if the separation is not one that qualifies
#ASSERT `reg 78.1(1) — the month is a month during which the persons cohabited` (YMD 2014 6 1) TRUE (YMD 2010 6 15) (LIST (YMD 2013 3 10), (YMD 2018 9 20)) (LIST `separation 2013 resumed for under a year`)
-- after the resumption
#ASSERT `reg 78.1(1) — the month is a month during which the persons cohabited` (YMD 2015 3 1) TRUE (YMD 2010 6 15) (LIST (YMD 2013 3 10), (YMD 2018 9 20)) (LIST `separation 2013 to 2015`)
-- the year of the divorce
#ASSERT NOT (`reg 78.1(1) — the month is a month during which the persons cohabited` (YMD 2018 5 1) TRUE (YMD 2010 6 15) (LIST (YMD 2013 3 10), (YMD 2018 9 20)) (LIST `separation 2013 to 2015`))
-- (2): from the month of the marriage to the month before they commenced to live apart.
#ASSERT `reg 78.1(2) — the number of consecutive months from the month of the marriage or of commencing to cohabit to the month before they commenced to live separate and apart` (YMD 2010 6 15) (YMD 2011 6 10) EQUALS 12
#ASSERT `reg 78.1(2) — the number of consecutive months from the month of the marriage or of commencing to cohabit to the month before they commenced to live separate and apart` (YMD 2010 6 15) (YMD 2011 5 10) EQUALS 11
#ASSERT `reg 78.1(2) — the number of consecutive months from the month of the marriage or of commencing to cohabit to the month before they commenced to live separate and apart` (YMD 2010 3 1) (YMD 2012 3 31) EQUALS 24
#ASSERT `reg 78.1(2) — the period of cohabitation is a continuous period of at least one year` (YMD 2010 6 15) (YMD 2011 6 10)
#ASSERT NOT (`reg 78.1(2) — the period of cohabitation is a continuous period of at least one year` (YMD 2010 6 15) (YMD 2011 5 10))
#ASSERT `reg 78.1(2) — the period of cohabitation is a continuous period of at least one year` (YMD 2010 3 1) (YMD 2012 3 31)
-- (3)
#ASSERT `reg 78.1(3) — the separation does not constitute interruption of cohabitation` TRUE TRUE
#ASSERT NOT (`reg 78.1(3) — the separation does not constitute interruption of cohabitation` TRUE FALSE)
#ASSERT NOT (`reg 78.1(3) — the separation does not constitute interruption of cohabitation` FALSE TRUE)

§§ `78.2 -- cohabitation for an assignment of a retirement pension`

-- Arguments: they cohabited in the month; the month is the month of the marriage or of commencing to cohabit; the month is within their joint contributory period.
#ASSERT `reg 78.2 — the month is in the period of cohabitation` TRUE FALSE TRUE
-- the month of the marriage or of commencing to cohabit is included even if they did not cohabit throughout it
#ASSERT `reg 78.2 — the month is in the period of cohabitation` FALSE TRUE TRUE
-- not within the joint contributory period: excluded
#ASSERT NOT (`reg 78.2 — the month is in the period of cohabitation` TRUE FALSE FALSE)
#ASSERT NOT (`reg 78.2 — the month is in the period of cohabitation` TRUE TRUE FALSE)
#ASSERT NOT (`reg 78.2 — the month is in the period of cohabitation` FALSE FALSE TRUE)
