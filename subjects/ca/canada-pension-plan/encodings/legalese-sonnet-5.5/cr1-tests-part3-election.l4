IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cr1-part1-contributions`
IMPORT `cr1-part3-election`

-- Tests of cr1-part3-election.l4 (regulations 29 to 34.1). Every expected value is written from the text
-- (C.R.C.-c.-385.txt lines 358 to 390) before the run.

§ `Tests of regulations 29 to 34.1`

§§ `Regulation 29(f): paying in time`

-- Contributions for 2025: within one year after April 30, 2026, that is on or before April 30, 2027.
GIVETH A MAYBE DATE
`cr1 test no refund` MEANS NOTHING

#ASSERT `reg 29(f) — the employee has paid the contributions referred to in section 10 of the Act in time` 2025 (YMD 2027 4 30) `cr1 test no refund`
#ASSERT `reg 29(f) — the employee has paid the contributions referred to in section 10 of the Act in time` 2025 (YMD 2026 3 1) `cr1 test no refund`
#ASSERT NOT (`reg 29(f) — the employee has paid the contributions referred to in section 10 of the Act in time` 2025 (YMD 2027 5 1) `cr1 test no refund`)
-- Or within one year after the day an amount is refunded under section 38 of the Act (a refund on 15 November 2026 opens a window to 15 November 2027).
#ASSERT `reg 29(f) — the employee has paid the contributions referred to in section 10 of the Act in time` 2025 (YMD 2027 8 1) (JUST (YMD 2026 11 15))
#ASSERT `reg 29(f) — the employee has paid the contributions referred to in section 10 of the Act in time` 2025 (YMD 2027 11 15) (JUST (YMD 2026 11 15))
#ASSERT NOT (`reg 29(f) — the employee has paid the contributions referred to in section 10 of the Act in time` 2025 (YMD 2027 11 16) (JUST (YMD 2026 11 15)))
#ASSERT `reg 29(f) — the employee has paid within one year after the day an amount was refunded` (YMD 2027 8 1) (JUST (YMD 2026 11 15))
#ASSERT NOT (`reg 29(f) — the employee has paid within one year after the day an amount was refunded` (YMD 2027 8 1) NOTHING)
#ASSERT NOT (`reg 29(f) — the employee has paid within one year after the day an amount was refunded` (YMD 2026 11 14) (JUST (YMD 2026 11 15)))

§§ `Regulation 29(c) to (f) and regulations 29 to 33`

-- Arguments: year; resident in Canada; not otherwise pensionable; elects under 13(3); day paid; refund day.
#ASSERT `reg 29(c) to (f) — the employee complies with the requirements` 2025 TRUE TRUE TRUE (YMD 2027 4 30) NOTHING
#ASSERT NOT (`reg 29(c) to (f) — the employee complies with the requirements` 2025 FALSE TRUE TRUE (YMD 2027 4 30) NOTHING)
#ASSERT NOT (`reg 29(c) to (f) — the employee complies with the requirements` 2025 TRUE FALSE TRUE (YMD 2027 4 30) NOTHING)
#ASSERT NOT (`reg 29(c) to (f) — the employee complies with the requirements` 2025 TRUE TRUE FALSE (YMD 2027 4 30) NOTHING)
#ASSERT NOT (`reg 29(c) to (f) — the employee complies with the requirements` 2025 TRUE TRUE TRUE (YMD 2027 5 1) NOTHING)

-- 29: in Canada; excepted by section 28 or by paragraph 6(2)(a), (b) or (j) of the Act; the employee complies.
#ASSERT `reg 29 — pensionable employment includes the employment in Canada excepted by section 28 or the Act` TRUE TRUE FALSE TRUE
#ASSERT `reg 29 — pensionable employment includes the employment in Canada excepted by section 28 or the Act` TRUE FALSE TRUE TRUE
#ASSERT NOT (`reg 29 — pensionable employment includes the employment in Canada excepted by section 28 or the Act` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`reg 29 — pensionable employment includes the employment in Canada excepted by section 28 or the Act` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`reg 29 — pensionable employment includes the employment in Canada excepted by section 28 or the Act` FALSE TRUE FALSE TRUE)
-- 30: in Canada, excepted by 22(1), and the employee complies.
#ASSERT `reg 30 — pensionable employment includes the employment in Canada excepted by subsection 22(1)` TRUE TRUE TRUE
#ASSERT NOT (`reg 30 — pensionable employment includes the employment in Canada excepted by subsection 22(1)` TRUE TRUE FALSE)
#ASSERT NOT (`reg 30 — pensionable employment includes the employment in Canada excepted by subsection 22(1)` TRUE FALSE TRUE)
#ASSERT NOT (`reg 30 — pensionable employment includes the employment in Canada excepted by subsection 22(1)` FALSE TRUE TRUE)
-- 31: excepted by 17(2), the employee complies, and is not required to contribute to a similar plan abroad.
#ASSERT `reg 31 — pensionable employment includes the employment in international transportation excepted by subsection 17(2)` TRUE TRUE FALSE
#ASSERT NOT (`reg 31 — pensionable employment includes the employment in international transportation excepted by subsection 17(2)` TRUE TRUE TRUE)
#ASSERT NOT (`reg 31 — pensionable employment includes the employment in international transportation excepted by subsection 17(2)` TRUE FALSE FALSE)
#ASSERT NOT (`reg 31 — pensionable employment includes the employment in international transportation excepted by subsection 17(2)` FALSE TRUE FALSE)
-- 32: outside Canada, would be pensionable in Canada, the employee complies, not required to contribute to a similar plan.
#ASSERT `reg 32 — pensionable employment includes the employment outside Canada that would be pensionable in Canada` TRUE TRUE TRUE FALSE
#ASSERT NOT (`reg 32 — pensionable employment includes the employment outside Canada that would be pensionable in Canada` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 32 — pensionable employment includes the employment outside Canada that would be pensionable in Canada` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`reg 32 — pensionable employment includes the employment outside Canada that would be pensionable in Canada` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`reg 32 — pensionable employment includes the employment outside Canada that would be pensionable in Canada` FALSE TRUE TRUE FALSE)
-- 33: no employer's contribution. It follows from regulation 7 as well: no employee's contribution is required to be deducted, so the employer's, which equals it, is nil.
#ASSERT `reg 33 — the employer is not required to pay an employer's contribution` TRUE
#ASSERT NOT (`reg 33 — the employer is not required to pay an employer's contribution` FALSE)
#ASSERT `reg 7 — the employer's contribution to remit in respect of a payment` (JUST 0) EQUALS JUST 0

§§ `Regulation 29.1: employment of an Indian`

#ASSERT `reg 29.1(1)(b) — the day the employer's election takes effect` (YMD 2026 3 1) (JUST (YMD 2026 4 1)) EQUALS (YMD 2026 4 1)
#ASSERT `reg 29.1(1)(b) — the day the employer's election takes effect` (YMD 2026 3 1) (JUST (YMD 2026 2 1)) EQUALS (YMD 2026 3 1)
#ASSERT `reg 29.1(1)(b) — the day the employer's election takes effect` (YMD 2026 3 1) (JUST (YMD 2026 3 1)) EQUALS (YMD 2026 3 1)
#ASSERT `reg 29.1(1)(b) — the day the employer's election takes effect` (YMD 2026 3 1) NOTHING EQUALS (YMD 2026 3 1)
-- Arguments of (1): an Indian as defined in the Indian Act; in Canada in the year; excepted solely by 6(2)(j.1); resident in Canada for tax; the employer has elected.
#ASSERT `reg 29.1(1) — pensionable employment includes the employment of an Indian when the employer has elected` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 29.1(1) — pensionable employment includes the employment of an Indian when the employer has elected` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 29.1(1) — pensionable employment includes the employment of an Indian when the employer has elected` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 29.1(1) — pensionable employment includes the employment of an Indian when the employer has elected` TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 29.1(1) — pensionable employment includes the employment of an Indian when the employer has elected` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`reg 29.1(1) — pensionable employment includes the employment of an Indian when the employer has elected` TRUE TRUE TRUE TRUE FALSE)
-- Arguments of (2): year; an Indian; the employer has not elected; excepted solely by 6(2)(j.1); resident; not otherwise pensionable; the Indian elects under 13(3); day paid; refund day.
#ASSERT `reg 29.1(2) — pensionable employment may include the employment of an Indian when the employer has not elected` 2025 TRUE TRUE TRUE TRUE TRUE TRUE (YMD 2027 4 30) NOTHING
#ASSERT NOT (`reg 29.1(2) — pensionable employment may include the employment of an Indian when the employer has not elected` 2025 TRUE TRUE TRUE TRUE TRUE TRUE (YMD 2027 5 1) NOTHING)
#ASSERT NOT (`reg 29.1(2) — pensionable employment may include the employment of an Indian when the employer has not elected` 2025 TRUE FALSE TRUE TRUE TRUE TRUE (YMD 2027 4 30) NOTHING)
#ASSERT NOT (`reg 29.1(2) — pensionable employment may include the employment of an Indian when the employer has not elected` 2025 TRUE TRUE TRUE FALSE TRUE TRUE (YMD 2027 4 30) NOTHING)
#ASSERT NOT (`reg 29.1(2) — pensionable employment may include the employment of an Indian when the employer has not elected` 2025 TRUE TRUE TRUE TRUE FALSE TRUE (YMD 2027 4 30) NOTHING)
#ASSERT NOT (`reg 29.1(2) — pensionable employment may include the employment of an Indian when the employer has not elected` 2025 TRUE TRUE TRUE TRUE TRUE FALSE (YMD 2027 4 30) NOTHING)
#ASSERT `reg 29.1(2) — pensionable employment may include the employment of an Indian when the employer has not elected` 2025 TRUE TRUE TRUE TRUE TRUE TRUE (YMD 2027 9 1) (JUST (YMD 2027 1 15))

§§ `Regulation 34: placement and employment agencies`

#ASSERT `reg 34(2) — a person or organization is a placement or employment agency` TRUE EQUALS JUST TRUE
#ASSERT `reg 34(2) — a person or organization is a placement or employment agency` FALSE EQUALS NOTHING
#ASSERT `reg 34(1) — the placed individual's employment is included in pensionable employment` TRUE TRUE
#ASSERT NOT (`reg 34(1) — the placed individual's employment is included in pensionable employment` TRUE FALSE)
#ASSERT NOT (`reg 34(1) — the placed individual's employment is included in pensionable employment` FALSE TRUE)
#ASSERT `reg 34(1) — the party deemed to be the employer of the placed individual` TRUE TRUE FALSE EQUALS JUST `the placement or employment agency`
#ASSERT `reg 34(1) — the party deemed to be the employer of the placed individual` TRUE FALSE TRUE EQUALS JUST `the client of the placement or employment agency`
-- Both or neither paying: the text says "whichever pays", so it does not answer.
#ASSERT `reg 34(1) — the party deemed to be the employer of the placed individual` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `reg 34(1) — the party deemed to be the employer of the placed individual` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 34(1) — the party deemed to be the employer of the placed individual` FALSE TRUE FALSE EQUALS NOTHING

§§ `Regulation 34.1`

-- Arguments of (1)(a): the legislation of Canada applies; excepted by 6(2) paragraphs; employer operating in Canada; undertaking given; undertaking complied with; the person complies with 29(c) to (f).
#ASSERT `reg 34.1(1)(a) — pensionable employment includes the employment under an agreement when the legislation of Canada applies` TRUE FALSE TRUE FALSE FALSE FALSE
#ASSERT `reg 34.1(1)(a) — pensionable employment includes the employment under an agreement when the legislation of Canada applies` TRUE FALSE FALSE TRUE FALSE FALSE
#ASSERT `reg 34.1(1)(a) — pensionable employment includes the employment under an agreement when the legislation of Canada applies` TRUE FALSE FALSE FALSE FALSE TRUE
#ASSERT `reg 34.1(1)(a) — pensionable employment includes the employment under an agreement when the legislation of Canada applies` TRUE FALSE FALSE TRUE FALSE TRUE
#ASSERT NOT (`reg 34.1(1)(a) — pensionable employment includes the employment under an agreement when the legislation of Canada applies` TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`reg 34.1(1)(a) — pensionable employment includes the employment under an agreement when the legislation of Canada applies` FALSE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 34.1(1)(a) — pensionable employment includes the employment under an agreement when the legislation of Canada applies` TRUE TRUE TRUE TRUE TRUE TRUE)
#ASSERT `reg 34.1(1)(b) — the employment under an agreement is excepted when the legislation of the other country applies` TRUE
#ASSERT NOT (`reg 34.1(1)(b) — the employment under an agreement is excepted when the legislation of the other country applies` FALSE)
#ASSERT `reg 34.1(2) — paragraph 15(1)(b) of the Act does not apply to the employment included by virtue of the undertaking` TRUE TRUE
#ASSERT NOT (`reg 34.1(2) — paragraph 15(1)(b) of the Act does not apply to the employment included by virtue of the undertaking` TRUE FALSE)
#ASSERT NOT (`reg 34.1(2) — paragraph 15(1)(b) of the Act does not apply to the employment included by virtue of the undertaking` FALSE TRUE)
