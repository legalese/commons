IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cr1-part4-interest`

-- Tests of cr1-part4-interest.l4 (regulations 35 and 36). Every expected value is written from the text
-- (C.R.C.-c.-385.txt lines 393 to 414) before the run. The Treasury Bill yields are invented numbers.

§ `Tests of regulations 35 and 36`

§§ `Regulation 36(1): the quarters`

#ASSERT `reg 36(1) — the number of the quarter of a year that contains a day` (YMD 2026 1 1) EQUALS 1
#ASSERT `reg 36(1) — the number of the quarter of a year that contains a day` (YMD 2026 3 31) EQUALS 1
#ASSERT `reg 36(1) — the number of the quarter of a year that contains a day` (YMD 2026 4 1) EQUALS 2
#ASSERT `reg 36(1) — the number of the quarter of a year that contains a day` (YMD 2026 6 30) EQUALS 2
#ASSERT `reg 36(1) — the number of the quarter of a year that contains a day` (YMD 2026 7 1) EQUALS 3
#ASSERT `reg 36(1) — the number of the quarter of a year that contains a day` (YMD 2026 9 30) EQUALS 3
#ASSERT `reg 36(1) — the number of the quarter of a year that contains a day` (YMD 2026 10 1) EQUALS 4
#ASSERT `reg 36(1) — the number of the quarter of a year that contains a day` (YMD 2026 12 31) EQUALS 4
#ASSERT `reg 36(1) — the first day of the quarter that contains a day` (YMD 2026 2 14) EQUALS (YMD 2026 1 1)
#ASSERT `reg 36(1) — the first day of the quarter that contains a day` (YMD 2026 5 20) EQUALS (YMD 2026 4 1)
#ASSERT `reg 36(1) — the first day of the quarter that contains a day` (YMD 2026 8 8) EQUALS (YMD 2026 7 1)
#ASSERT `reg 36(1) — the first day of the quarter that contains a day` (YMD 2026 11 30) EQUALS (YMD 2026 10 1)
-- The first month of the preceding quarter.
#ASSERT `reg 36(2)(a)(i) — the first month of the quarter preceding the quarter that contains a day` (YMD 2026 2 14) EQUALS (YMD 2025 10 1)
#ASSERT `reg 36(2)(a)(i) — the first month of the quarter preceding the quarter that contains a day` (YMD 2026 4 1) EQUALS (YMD 2026 1 1)
#ASSERT `reg 36(2)(a)(i) — the first month of the quarter preceding the quarter that contains a day` (YMD 2026 9 30) EQUALS (YMD 2026 4 1)
#ASSERT `reg 36(2)(a)(i) — the first month of the quarter preceding the quarter that contains a day` (YMD 2026 12 31) EQUALS (YMD 2026 7 1)

§§ `Regulation 36(2): the prescribed rates`

-- The mean rounded up to the next whole percentage unless it is a whole percentage.
#ASSERT `reg 36(2)(a)(i) — the whole percentage that is the mean of the Treasury Bill yields` (LIST 4, 4) EQUALS JUST 4
#ASSERT `reg 36(2)(a)(i) — the whole percentage that is the mean of the Treasury Bill yields` (LIST 2, 3, 4) EQUALS JUST 3
#ASSERT `reg 36(2)(a)(i) — the whole percentage that is the mean of the Treasury Bill yields` (LIST 3, 4) EQUALS JUST 4
#ASSERT `reg 36(2)(a)(i) — the whole percentage that is the mean of the Treasury Bill yields` (LIST 4.37, 4.39, 4.40, 4.41) EQUALS JUST 5
#ASSERT `reg 36(2)(a)(i) — the whole percentage that is the mean of the Treasury Bill yields` (LIST 4.01) EQUALS JUST 5
#ASSERT `reg 36(2)(a)(i) — the whole percentage that is the mean of the Treasury Bill yields` EMPTY EQUALS NOTHING
-- (a): that percentage plus 4: 4 + 4 = 8 per cent; 5 + 4 = 9 per cent.
#ASSERT `reg 36(2)(a) — the prescribed rate on an amount payable to the Receiver General` (LIST 4, 4) EQUALS JUST 0.08
#ASSERT `reg 36(2)(a) — the prescribed rate on an amount payable to the Receiver General` (LIST 4.37, 4.39, 4.40, 4.41) EQUALS JUST 0.09
#ASSERT `reg 36(2)(a) — the prescribed rate on an amount payable to the Receiver General` EMPTY EQUALS NOTHING
-- (b): that percentage plus 0 for a corporation, 2 in any other case.
#ASSERT `reg 36(2)(b) — the prescribed rate on an amount payable by the Minister` (LIST 4, 4) TRUE EQUALS JUST 0.04
#ASSERT `reg 36(2)(b) — the prescribed rate on an amount payable by the Minister` (LIST 4, 4) FALSE EQUALS JUST 0.06
#ASSERT `reg 36(2)(b) — the prescribed rate on an amount payable by the Minister` (LIST 4.37, 4.39, 4.40, 4.41) FALSE EQUALS JUST 0.07
#ASSERT `reg 36(2)(b) — the prescribed rate on an amount payable by the Minister` (LIST 4.37, 4.39, 4.40, 4.41) TRUE EQUALS JUST 0.05
#ASSERT `reg 36(2)(b) — the prescribed rate on an amount payable by the Minister` EMPTY FALSE EQUALS NOTHING

§§ `Regulation 35(a): refund to an employee or a self-employed person`

-- Contributions paid for 2025: May 1, 2026 is the first of the three days; the latest governs.
#ASSERT `reg 35(a) — the first day of the period for which interest runs on an overpayment refunded to an employee or a self-employed person` 2025 (JUST (YMD 2026 6 10)) (YMD 2025 12 31) EQUALS (YMD 2026 6 10)
#ASSERT `reg 35(a) — the first day of the period for which interest runs on an overpayment refunded to an employee or a self-employed person` 2025 (JUST (YMD 2026 3 1)) (YMD 2025 12 31) EQUALS (YMD 2026 5 1)
#ASSERT `reg 35(a) — the first day of the period for which interest runs on an overpayment refunded to an employee or a self-employed person` 2025 (JUST (YMD 2026 3 1)) (YMD 2026 7 1) EQUALS (YMD 2026 7 1)
#ASSERT `reg 35(a) — the first day of the period for which interest runs on an overpayment refunded to an employee or a self-employed person` 2025 (JUST (YMD 2026 5 1)) (YMD 2025 12 31) EQUALS (YMD 2026 5 1)
-- No application: the other two days govern.
#ASSERT `reg 35(a) — the first day of the period for which interest runs on an overpayment refunded to an employee or a self-employed person` 2025 NOTHING (YMD 2025 12 31) EQUALS (YMD 2026 5 1)
#ASSERT `reg 35(a) — the first day of the period for which interest runs on an overpayment refunded to an employee or a self-employed person` 2025 NOTHING (YMD 2026 8 20) EQUALS (YMD 2026 8 20)
#ASSERT `reg 35(a)(ii) — the day the application for the refund was received, or the day the overpayment arose where there was no application` (JUST (YMD 2026 6 10)) (YMD 2025 12 31) EQUALS (YMD 2026 6 10)
#ASSERT `reg 35(a)(ii) — the day the application for the refund was received, or the day the overpayment arose where there was no application` NOTHING (YMD 2025 12 31) EQUALS (YMD 2025 12 31)

§§ `Regulation 35(b): refund to an employer`

-- The later of the day the remittance was received and the day it was due.
#ASSERT `reg 35(b) — the first day of the period for which interest runs on an overpayment refunded to an employer` (YMD 2026 3 10) (YMD 2026 3 15) EQUALS (YMD 2026 3 15)
#ASSERT `reg 35(b) — the first day of the period for which interest runs on an overpayment refunded to an employer` (YMD 2026 3 20) (YMD 2026 3 15) EQUALS (YMD 2026 3 20)
#ASSERT `reg 35(b) — the first day of the period for which interest runs on an overpayment refunded to an employer` (YMD 2026 3 15) (YMD 2026 3 15) EQUALS (YMD 2026 3 15)
