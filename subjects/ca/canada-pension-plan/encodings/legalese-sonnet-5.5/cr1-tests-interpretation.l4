IMPORT prelude
IMPORT `cpp-core`
IMPORT `cr1-interpretation`

-- Tests of cr1-interpretation.l4 (Regulations, regulation 2). Each expected value is written from the text
-- (C.R.C.-c.-385.txt lines 13 to 52) before the run; none is copied from the module's own output.
-- Short helper names carry the prefix `cr1 test` so that they cannot clash with a name in another piece.

§ `Tests of regulation 2`

§§ `Regulation 2(1): Minister -- (a) Parts I to IV, (b) Part V, and nothing for Part VIII`

#ASSERT `reg 2(1) — the Minister in a Part of the Regulations` `the Regulations' Part I` EQUALS JUST `the Minister of National Revenue`
#ASSERT `reg 2(1) — the Minister in a Part of the Regulations` `the Regulations' Part II` EQUALS JUST `the Minister of National Revenue`
#ASSERT `reg 2(1) — the Minister in a Part of the Regulations` `the Regulations' Part III` EQUALS JUST `the Minister of National Revenue`
#ASSERT `reg 2(1) — the Minister in a Part of the Regulations` `the Regulations' Part IV` EQUALS JUST `the Minister of National Revenue`
#ASSERT `reg 2(1) — the Minister in a Part of the Regulations` `the Regulations' Part V` EQUALS JUST `the Minister of Employment and Social Development`
-- The text defines "Minister" for no other Part, so Part VIII has no answer (finding 1).
#ASSERT `reg 2(1) — the Minister in a Part of the Regulations` `the Regulations' Part VIII` EQUALS NOTHING

§§ `Regulation 2(2): the instruments the definitions apply to`

#ASSERT `reg 2(2) — the definitions of subsection (2) apply to an instrument` `the Act`
#ASSERT `reg 2(2) — the definitions of subsection (2) apply to an instrument` `these Regulations`
#ASSERT NOT (`reg 2(2) — the definitions of subsection (2) apply to an instrument` `another instrument`)

§§ `Regulation 2(2): agriculture`

GIVEN op IS A `cr1 Operation in the definition of agriculture`
      farm IS A BOOLEAN
      farmer IS A BOOLEAN
      incidental IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`cr1 test agriculture` op farm farmer incidental MEANS
    `reg 2(2) — an operation is agriculture` op farm farmer incidental

-- The general core: "the operations of farming when carried on on a farm for the benefit of ... a farmer".
#ASSERT `cr1 test agriculture` `the operations of farming` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `cr1 test agriculture` `the operations of farming` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `cr1 test agriculture` `the operations of farming` TRUE FALSE FALSE EQUALS JUST FALSE
-- Paragraphs (a) to (i) carry the same two conditions.
#ASSERT `cr1 test agriculture` `the clearing of land for the purposes of farming` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `cr1 test agriculture` `the clearing of land for the purposes of farming` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `cr1 test agriculture` `the cultivation of the soil` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `cr1 test agriculture` `the conservation of the soil, including tile drainage systems, ditches, canals, reservoirs or waterways exclusively for farming` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `cr1 test agriculture` `the producing, harvesting, storing or grading of a natural product of farming` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `cr1 test agriculture` `the preparation of land for or the harvesting of wild berries` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `cr1 test agriculture` `the raising of bees and producing of honey` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `cr1 test agriculture` `the breeding or raising of horses, beasts of burden, cattle, sheep, goats, swine, furbearing animals or birds, or the production of eggs` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `cr1 test agriculture` `dairy farming and the processing of milk, butter or cheese on the farm where it is produced` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `cr1 test agriculture` `producing maple sap, maple syrup or maple sugar` TRUE TRUE FALSE EQUALS JUST TRUE
-- Paragraph (j): off the farm, for the farmer, and incidental.
#ASSERT `cr1 test agriculture` `offering for sale or selling, off the farm, the products of the operations described` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `cr1 test agriculture` `offering for sale or selling, off the farm, the products of the operations described` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `cr1 test agriculture` `offering for sale or selling, off the farm, the products of the operations described` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `cr1 test agriculture` `offering for sale or selling, off the farm, the products of the operations described` FALSE TRUE FALSE EQUALS JUST FALSE
-- Paragraph (k): the same three conditions.
#ASSERT `cr1 test agriculture` `exhibiting, advertising, assembling, freezing, storing, grading, processing, packing or transporting, off the farm, the products of that offering for sale or selling` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `cr1 test agriculture` `exhibiting, advertising, assembling, freezing, storing, grading, processing, packing or transporting, off the farm, the products of that offering for sale or selling` FALSE TRUE FALSE EQUALS JUST FALSE
-- An operation the definition does not name is not decided (fork F1).
#ASSERT `cr1 test agriculture` `an operation that the definition does not name` TRUE TRUE FALSE EQUALS NOTHING

§§ `Regulation 2(2): agricultural enterprise, fishing, hunting, trapping`

#ASSERT `reg 2(2) — a business is an agricultural enterprise` TRUE TRUE
#ASSERT NOT (`reg 2(2) — a business is an agricultural enterprise` TRUE FALSE)
#ASSERT NOT (`reg 2(2) — a business is an agricultural enterprise` FALSE TRUE)

#ASSERT `reg 2(2) — an activity is fishing` TRUE `a fish, including shellfish, crustaceans or molluscs`
#ASSERT `reg 2(2) — an activity is fishing` TRUE `an aquatic animal or plant`
#ASSERT NOT (`reg 2(2) — an activity is fishing` TRUE `something else that is not a fish or an aquatic animal or plant`)
#ASSERT NOT (`reg 2(2) — an activity is fishing` FALSE `a fish, including shellfish, crustaceans or molluscs`)

#ASSERT `reg 2(2) — an activity is hunting` TRUE FALSE
#ASSERT NOT (`reg 2(2) — an activity is hunting` TRUE TRUE)
#ASSERT NOT (`reg 2(2) — an activity is hunting` FALSE FALSE)

#ASSERT `reg 2(2) — an activity is trapping` TRUE FALSE
#ASSERT NOT (`reg 2(2) — an activity is trapping` TRUE TRUE)
#ASSERT NOT (`reg 2(2) — an activity is trapping` FALSE FALSE)

§§ `Regulation 2(2): forestry, logging, lumbering; regulation 2(3): timber`

#ASSERT `reg 2(2) — a place is a forest, a woodlot or a tree farm` `in a forest`
#ASSERT `reg 2(2) — a place is a forest, a woodlot or a tree farm` `on a woodlot`
#ASSERT `reg 2(2) — a place is a forest, a woodlot or a tree farm` `on a tree farm`
#ASSERT NOT (`reg 2(2) — a place is a forest, a woodlot or a tree farm` `at another place`)

#ASSERT `reg 2(2) — an operation is forestry` `planting trees` `in a forest` FALSE
#ASSERT `reg 2(2) — an operation is forestry` `harvesting trees` `on a tree farm` FALSE
#ASSERT NOT (`reg 2(2) — an operation is forestry` `measuring trees` `at another place` FALSE)
#ASSERT `reg 2(2) — an operation is forestry` `a service incidental to those activities` `at another place` TRUE
#ASSERT NOT (`reg 2(2) — an operation is forestry` `a service incidental to those activities` `in a forest` FALSE)
#ASSERT NOT (`reg 2(2) — an operation is forestry` `another operation on trees` `in a forest` TRUE)

-- logging: converting trees into timber, in a forest, on a woodlot or on a tree farm.
#ASSERT `reg 2(2) — an activity is logging` TRUE `logs of any size` FALSE `on a woodlot`
#ASSERT `reg 2(2) — an activity is logging` TRUE `other crude wood` FALSE `in a forest`
#ASSERT NOT (`reg 2(2) — an activity is logging` TRUE `logs of any size` FALSE `at another place`)
#ASSERT NOT (`reg 2(2) — an activity is logging` FALSE `logs of any size` FALSE `in a forest`)
#ASSERT NOT (`reg 2(2) — an activity is logging` TRUE `wood that is not one of those` FALSE `in a forest`)
-- crude wood that has already been milled is not timber, so converting trees into it is not logging.
#ASSERT NOT (`reg 2(2) — an activity is logging` TRUE `other crude wood` TRUE `in a forest`)

-- lumbering: milling timber into lumber or boards (or preparing it for milling) in such a place.
#ASSERT `reg 2(2) — an activity is lumbering` TRUE `logs of any size` `in a forest`
#ASSERT `reg 2(2) — an activity is lumbering` TRUE `other crude wood` `on a tree farm`
#ASSERT NOT (`reg 2(2) — an activity is lumbering` TRUE `logs of any size` `at another place`)
#ASSERT NOT (`reg 2(2) — an activity is lumbering` FALSE `logs of any size` `in a forest`)
#ASSERT NOT (`reg 2(2) — an activity is lumbering` TRUE `wood that is not one of those` `in a forest`)

#ASSERT `reg 2(3) — wood is timber` `logs of any size` TRUE
#ASSERT `reg 2(3) — wood is timber` `chips` FALSE
#ASSERT `reg 2(3) — wood is timber` `other crude wood` FALSE
#ASSERT NOT (`reg 2(3) — wood is timber` `other crude wood` TRUE)
#ASSERT NOT (`reg 2(3) — wood is timber` `wood that is not one of those` FALSE)

§§ `Regulation 2(2): horticulture and international organization`

#ASSERT `reg 2(2) — an operation is horticulture` `breeding, producing, raising or harvesting vegetables, flowers, shrubs or ornamental grasses` FALSE FALSE
#ASSERT `reg 2(2) — an operation is horticulture` `breeding, producing, raising or harvesting seeds, seedlings, grafts or cuttings of vegetables, flowers, shrubs or ornamental grasses` FALSE FALSE
#ASSERT `reg 2(2) — an operation is horticulture` `landscape gardening` TRUE FALSE
#ASSERT NOT (`reg 2(2) — an operation is horticulture` `landscape gardening` FALSE TRUE)
#ASSERT `reg 2(2) — an operation is horticulture` `a service incidental to those operations` FALSE TRUE
#ASSERT NOT (`reg 2(2) — an operation is horticulture` `a service incidental to those operations` TRUE FALSE)
#ASSERT NOT (`reg 2(2) — an operation is horticulture` `another operation in gardening` TRUE TRUE)

#ASSERT `reg 2(2) — a body is an international organization` TRUE TRUE FALSE FALSE
#ASSERT NOT (`reg 2(2) — a body is an international organization` TRUE FALSE FALSE FALSE)
#ASSERT `reg 2(2) — a body is an international organization` FALSE FALSE TRUE TRUE
#ASSERT NOT (`reg 2(2) — a body is an international organization` FALSE FALSE TRUE FALSE)
#ASSERT NOT (`reg 2(2) — a body is an international organization` FALSE FALSE FALSE FALSE)
