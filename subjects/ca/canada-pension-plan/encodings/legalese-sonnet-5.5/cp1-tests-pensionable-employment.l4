-- Section 7(4): a regulation may require an employer's contribution from a foreign government or an international
-- organization only if made pursuant to an agreement referred to in paragraph 7(1)(f).
#ASSERT `s 7(4) — a regulation under section 7 may require an employer's contribution from a foreign government or an international organization` TRUE TRUE EQUALS TRUE
#ASSERT `s 7(4) — a regulation under section 7 may require an employer's contribution from a foreign government or an international organization` TRUE FALSE EQUALS FALSE
#ASSERT `s 7(4) — a regulation under section 7 may require an employer's contribution from a foreign government or an international organization` FALSE FALSE EQUALS TRUE
#ASSERT `s 7(4) — a regulation under section 7 may require an employer's contribution from a foreign government or an international organization` FALSE TRUE EQUALS TRUE
