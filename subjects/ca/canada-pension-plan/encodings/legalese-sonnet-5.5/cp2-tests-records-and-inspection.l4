IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-definitions`
IMPORT `cp2-employer-deduct-and-remit`
IMPORT `cp2-records-and-inspection`

-- Tests of cp2-records-and-inspection.l4 (Act sections 24, 25 and 26).
-- Expected values were decided by reading the section, then written down; none was copied from the rule's output.

§ `Tests -- records and inspection`

§§ `s 24 -- books and records`

`the records test: an employer paying an employee in pensionable employment` MEANS `cp2 Employment relationship` WITH
    `payer is liable to pay salary, wages or other remuneration in relation to the employment` IS TRUE
    `payee is employed under an express or implied contract of service or apprenticeship` IS TRUE
    `payee holds an office` IS FALSE
    `payee, as an officer, receives their remuneration from the payer` IS FALSE
    `employment is pensionable employment` IS TRUE

`the records test: employment that is not pensionable` MEANS `cp2 Employment relationship` WITH
    `payer is liable to pay salary, wages or other remuneration in relation to the employment` IS TRUE
    `payee is employed under an express or implied contract of service or apprenticeship` IS TRUE
    `payee holds an office` IS FALSE
    `payee, as an officer, receives their remuneration from the payer` IS FALSE
    `employment is pensionable employment` IS FALSE

#ASSERT `s 24(1) — the employer must keep records and books of account` `the records test: an employer paying an employee in pensionable employment` TRUE
#ASSERT NOT (`s 24(1) — the employer must keep records and books of account` `the records test: an employer paying an employee in pensionable employment` FALSE)
#ASSERT NOT (`s 24(1) — the employer must keep records and books of account` `the records test: employment that is not pensionable` TRUE)
#ASSERT `s 24(1) — the employer may keep its records at the place` `the employer's place of business in Canada`
#ASSERT `s 24(1) — the employer may keep its records at the place` `the employer's residence in Canada`
#ASSERT `s 24(1) — the employer may keep its records at the place` `a place the Minister has designated`
#ASSERT NOT (`s 24(1) — the employer may keep its records at the place` `any other place`)
#ASSERT `s 24(1) — the employer must keep the records and books of account that the Minister specified` TRUE TRUE
#ASSERT NOT (`s 24(1) — the employer must keep the records and books of account that the Minister specified` TRUE FALSE)
#ASSERT NOT (`s 24(1) — the employer must keep the records and books of account that the Minister specified` FALSE TRUE)

-- (2): records for 2026 are kept until six years from the end of the year, which is 31 December 2032.
#ASSERT `s 24(2) — the last day the employer must retain the records and books of account` 2026 NOTHING EQUALS YMD 2032 12 31
-- Written permission to dispose earlier ends the duty on the day of the permission.
#ASSERT `s 24(2) — the last day the employer must retain the records and books of account` 2026 (JUST (YMD 2029 5 1)) EQUALS YMD 2029 5 1
-- A permission given after the six years have run changes nothing.
#ASSERT `s 24(2) — the last day the employer must retain the records and books of account` 2026 (JUST (YMD 2034 1 1)) EQUALS YMD 2032 12 31
#ASSERT `s 24(2) — the last day the employer must retain the records and books of account` 2026 (JUST (YMD 2032 12 31)) EQUALS YMD 2032 12 31
#ASSERT `s 24(2) — the employer must still retain the records and books of account on the day` (YMD 2032 12 31) 2026 NOTHING
#ASSERT NOT (`s 24(2) — the employer must still retain the records and books of account on the day` (YMD 2033 1 1) 2026 NOTHING)
#ASSERT NOT (`s 24(2) — the employer must still retain the records and books of account on the day` (YMD 2029 5 2) 2026 (JUST (YMD 2029 5 1)))
#ASSERT `s 24(2) — the employer must still retain the records and books of account on the day` (YMD 2029 5 1) 2026 (JUST (YMD 2029 5 1))

#ASSERT `s 24(2.2) — the employer is exempt from the requirement to retain electronic records in an electronically readable format` TRUE TRUE
#ASSERT NOT (`s 24(2.2) — the employer is exempt from the requirement to retain electronic records in an electronically readable format` TRUE FALSE)
#ASSERT NOT (`s 24(2.2) — the employer is exempt from the requirement to retain electronic records in an electronically readable format` FALSE TRUE)
#ASSERT `s 24(2.1) — the employer must retain the records in an electronically readable format for the retention period` TRUE FALSE
#ASSERT NOT (`s 24(2.1) — the employer must retain the records in an electronically readable format for the retention period` TRUE TRUE)
#ASSERT NOT (`s 24(2.1) — the employer must retain the records in an electronically readable format for the retention period` FALSE FALSE)

-- (3): ruling pending; ruling made but appeal pending; appeal disposed of but further appeal open; all over.
#ASSERT `s 24(3) — the employer must still retain every record, book of account, account and voucher necessary for the ruling or appeal` TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT (`s 24(3) — the employer must still retain every record, book of account, account and voucher necessary for the ruling or appeal` TRUE TRUE FALSE FALSE FALSE)
#ASSERT `s 24(3) — the employer must still retain every record, book of account, account and voucher necessary for the ruling or appeal` TRUE TRUE TRUE FALSE FALSE
#ASSERT `s 24(3) — the employer must still retain every record, book of account, account and voucher necessary for the ruling or appeal` FALSE FALSE TRUE TRUE FALSE
#ASSERT NOT (`s 24(3) — the employer must still retain every record, book of account, account and voucher necessary for the ruling or appeal` FALSE FALSE TRUE TRUE TRUE)
#ASSERT `s 24(3) — the employer must still retain every record, book of account, account and voucher necessary for the ruling or appeal` TRUE TRUE TRUE TRUE FALSE
#ASSERT NOT (`s 24(3) — the employer must still retain every record, book of account, account and voucher necessary for the ruling or appeal` FALSE FALSE FALSE FALSE FALSE)

§§ `s 25(1) -- the defined words`

#ASSERT `s 25(1) — an authorized person` TRUE
#ASSERT NOT (`s 25(1) — an authorized person` FALSE)
#ASSERT `s 25(1) — documents` `money, as a document` EQUALS JUST TRUE
#ASSERT `s 25(1) — documents` `securities, as a document` EQUALS JUST TRUE
#ASSERT `s 25(1) — documents` `statements, financial or otherwise, whether computerized or not` EQUALS JUST TRUE
#ASSERT `s 25(1) — documents` `invoices, whether computerized or not` EQUALS JUST TRUE
-- "includes": a thing outside the list is not decided (NOTHING), not excluded.
#ASSERT `s 25(1) — documents` `another kind of thing` EQUALS NOTHING
#ASSERT `s 25(1) — a dwelling-house` TRUE FALSE FALSE
#ASSERT `s 25(1) — a dwelling-house` FALSE TRUE FALSE
#ASSERT `s 25(1) — a dwelling-house` FALSE FALSE TRUE
#ASSERT NOT (`s 25(1) — a dwelling-house` FALSE FALSE FALSE)
#ASSERT `s 25(1) — a judge` TRUE FALSE
#ASSERT `s 25(1) — a judge` FALSE TRUE
#ASSERT NOT (`s 25(1) — a judge` FALSE FALSE)

§§ `s 25(2) to (4) -- inspection, entry and warrants`

#ASSERT `s 25(2) — the authorized person may inspect, audit or examine the document` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 25(2) — the authorized person may inspect, audit or examine the document` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 25(2) — the authorized person may inspect, audit or examine the document` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 25(2) — the authorized person may inspect, audit or examine the document` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 25(2) — the authorized person may inspect, audit or examine the document` TRUE TRUE TRUE FALSE)
-- (3): a dwelling-house cannot be entered without the occupant's consent unless there is a warrant.
#ASSERT `s 25(3) — the authorized person may enter the premises or place` FALSE FALSE FALSE
#ASSERT `s 25(3) — the authorized person may enter the premises or place` TRUE TRUE FALSE
#ASSERT `s 25(3) — the authorized person may enter the premises or place` TRUE FALSE TRUE
#ASSERT NOT (`s 25(3) — the authorized person may enter the premises or place` TRUE FALSE FALSE)
-- (2)(a): the entry needs every condition of (2) and then (3).
#ASSERT `s 25(2)(a) — the authorized person may enter the premises or place` TRUE TRUE TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT (`s 25(2)(a) — the authorized person may enter the premises or place` TRUE TRUE TRUE TRUE TRUE FALSE FALSE)
#ASSERT `s 25(2)(a) — the authorized person may enter the premises or place` TRUE TRUE TRUE TRUE TRUE TRUE FALSE
#ASSERT `s 25(2)(a) — the authorized person may enter the premises or place` TRUE TRUE TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT (`s 25(2)(a) — the authorized person may enter the premises or place` TRUE TRUE TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 25(2)(a) — the authorized person may enter the premises or place` FALSE TRUE TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`s 25(2)(a) — the authorized person may enter the premises or place` TRUE FALSE TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`s 25(2)(a) — the authorized person may enter the premises or place` TRUE TRUE FALSE TRUE FALSE FALSE FALSE)
#ASSERT `s 25(2)(b) — the owner, occupant or person in charge must give all reasonable assistance, answer all proper questions and attend` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 25(2)(b) — the owner, occupant or person in charge must give all reasonable assistance, answer all proper questions and attend` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`s 25(2)(b) — the owner, occupant or person in charge must give all reasonable assistance, answer all proper questions and attend` FALSE TRUE TRUE TRUE)

-- (4): the warrant on all of (a), (b), (c); the access order when entry is not found necessary; and the gap.
#ASSERT `s 25(4) — what the judge must do on the Minister's application` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS `the judge must issue a warrant authorizing an authorized person to enter the dwelling-house`
#ASSERT `s 25(4) — what the judge must do on the Minister's application` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS `the judge must order the occupant to give an authorized person reasonable access to the documents, and make any other appropriate order`
#ASSERT `s 25(4) — what the judge must do on the Minister's application` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS `the judge must order the occupant to give an authorized person reasonable access to the documents, and make any other appropriate order`
-- Entry necessary but not refused, and (a) satisfied: neither limb of the subsection decides it.
#ASSERT `s 25(4) — what the judge must do on the Minister's application` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS `the text does not say what the judge must do on the application`
-- Not necessary but access neither refused nor expected to be: the order is only "to the extent that" it is.
#ASSERT `s 25(4) — what the judge must do on the Minister's application` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS `the text does not say what the judge must do on the application`
#ASSERT `s 25(4) — what the judge must do on the Minister's application` TRUE TRUE FALSE FALSE TRUE FALSE EQUALS `the text does not say what the judge must do on the application`
-- No ex parte application by the Minister: not covered.
#ASSERT `s 25(4) — what the judge must do on the Minister's application` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS `the text does not say what the judge must do on the application`
-- Entry necessary and refused, but no reasonable grounds that it is a premises of (2): the warrant limb fails and the order limb does not apply.
#ASSERT `s 25(4) — what the judge must do on the Minister's application` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS `the text does not say what the judge must do on the application`

§§ `s 25(5) to (11) -- requirements to provide information or documents`

#ASSERT `s 25(5) — the person must provide the information or document the notice requires` TRUE TRUE FALSE TRUE TRUE
#ASSERT `s 25(5) — the person must provide the information or document the notice requires` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT (`s 25(5) — the person must provide the information or document the notice requires` TRUE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`s 25(5) — the person must provide the information or document the notice requires` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 25(5) — the person must provide the information or document the notice requires` TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 25(5) — the person must provide the information or document the notice requires` TRUE TRUE TRUE TRUE FALSE)
-- (6): a requirement about unnamed persons needs a judge's authorization first.
#ASSERT `s 25(6) — the Minister may impose the requirement on the third party` FALSE FALSE
#ASSERT `s 25(6) — the Minister may impose the requirement on the third party` TRUE TRUE
#ASSERT NOT (`s 25(6) — the Minister may impose the requirement on the third party` TRUE FALSE)
#ASSERT `s 25(7) — the judge may authorize the Minister to impose the requirement relating to unnamed persons` TRUE TRUE TRUE
#ASSERT NOT (`s 25(7) — the judge may authorize the Minister to impose the requirement relating to unnamed persons` TRUE TRUE FALSE)
#ASSERT NOT (`s 25(7) — the judge may authorize the Minister to impose the requirement relating to unnamed persons` TRUE FALSE TRUE)
#ASSERT NOT (`s 25(7) — the judge may authorize the Minister to impose the requirement relating to unnamed persons` FALSE TRUE TRUE)
#ASSERT `s 25(8) — the authorization has been served as required` TRUE TRUE
#ASSERT NOT (`s 25(8) — the authorization has been served as required` TRUE FALSE)
#ASSERT `s 25(8) — the authorization has been served as required` FALSE FALSE
-- (9): 15 days after service on 1 March 2026 ends on 16 March 2026.
#ASSERT `s 25(9) — the third party may apply for a review of the authorization` TRUE TRUE (YMD 2026 3 1) (YMD 2026 3 16)
#ASSERT NOT (`s 25(9) — the third party may apply for a review of the authorization` TRUE TRUE (YMD 2026 3 1) (YMD 2026 3 17))
#ASSERT `s 25(9) — the third party may apply for a review of the authorization` TRUE TRUE (YMD 2026 3 1) (YMD 2026 3 1)
#ASSERT NOT (`s 25(9) — the third party may apply for a review of the authorization` TRUE TRUE (YMD 2026 3 1) (YMD 2026 2 28))
#ASSERT NOT (`s 25(9) — the third party may apply for a review of the authorization` FALSE TRUE (YMD 2026 3 1) (YMD 2026 3 5))
#ASSERT NOT (`s 25(9) — the third party may apply for a review of the authorization` TRUE FALSE (YMD 2026 3 1) (YMD 2026 3 5))
#ASSERT `s 25(10) — what the judge may do on the review` TRUE EQUALS `the judge may confirm or vary the authorization`
#ASSERT `s 25(10) — what the judge may do on the review` FALSE EQUALS `the judge may cancel the authorization`
#ASSERT `s 25(11) — the court may make such order as it deems proper to enforce compliance with the requirement` TRUE
#ASSERT NOT (`s 25(11) — the court may make such order as it deems proper to enforce compliance with the requirement` FALSE)

§§ `s 25(12) and (13) -- copies, and compliance`

#ASSERT `s 25(12) — a copy or print-out of the document may be made` TRUE TRUE
#ASSERT NOT (`s 25(12) — a copy or print-out of the document may be made` TRUE FALSE)
#ASSERT NOT (`s 25(12) — a copy or print-out of the document may be made` FALSE TRUE)
#ASSERT `s 25(12) — the certified copy is evidence of the nature and content of the original with the same probative force` TRUE
#ASSERT NOT (`s 25(12) — the certified copy is evidence of the nature and content of the original with the same probative force` FALSE)
#ASSERT `s 25(13) — the person contravenes the prohibition on hindering a person acting under section 25` TRUE
#ASSERT NOT (`s 25(13) — the person contravenes the prohibition on hindering a person acting under section 25` FALSE)
-- "unless he is unable to do so": inability excuses the failure.
#ASSERT `s 25(13) — the person fails to do everything required under section 25` FALSE FALSE
#ASSERT NOT (`s 25(13) — the person fails to do everything required under section 25` FALSE TRUE)
#ASSERT NOT (`s 25(13) — the person fails to do everything required under section 25` TRUE FALSE)
#ASSERT NOT (`s 25(13) — the person fails to do everything required under section 25` TRUE TRUE)

§§ `s 26 -- deducting, and the Minister's receipt`

#ASSERT `s 26(1) — no action lies against the person for the deduction` TRUE TRUE
#ASSERT NOT (`s 26(1) — no action lies against the person for the deduction` TRUE FALSE)
#ASSERT NOT (`s 26(1) — no action lies against the person for the deduction` FALSE TRUE)
#ASSERT `s 26(2) — the extent to which the Minister's receipt discharges the debtor's liability to the creditor` TRUE 300 300 EQUALS 300
#ASSERT `s 26(2) — the extent to which the Minister's receipt discharges the debtor's liability to the creditor` TRUE 200 300 EQUALS 200
#ASSERT `s 26(2) — the extent to which the Minister's receipt discharges the debtor's liability to the creditor` TRUE 300 200 EQUALS 200
#ASSERT `s 26(2) — the extent to which the Minister's receipt discharges the debtor's liability to the creditor` FALSE 300 300 EQUALS 0
