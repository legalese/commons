IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cr2-division-dates`

-- Tests of cr2-division-dates.l4 (regulations 54.2 to 54.4). Layer 1.
-- Every expected value was decided by reading the regulation before the rules were run.

§ `Tests -- regulations 54.2 to 54.4`

§§ `54.2(1) -- the last day of the month in which the information or application is received`

#ASSERT `reg 54.2(1)(a) — the effective date of the taking place of a division` (YMD 2026 3 15) EQUALS (YMD 2026 3 31)
-- the first and the last day of the month receive the same date
#ASSERT `reg 54.2(1)(a) — the effective date of the taking place of a division` (YMD 2026 3 1) EQUALS (YMD 2026 3 31)
#ASSERT `reg 54.2(1)(a) — the effective date of the taking place of a division` (YMD 2026 3 31) EQUALS (YMD 2026 3 31)
-- February of a leap year
#ASSERT `reg 54.2(1)(a) — the effective date of the taking place of a division` (YMD 2024 2 10) EQUALS (YMD 2024 2 29)
#ASSERT `reg 54.2(1)(a) — the effective date of the taking place of a division` (YMD 2025 2 10) EQUALS (YMD 2025 2 28)
-- December
#ASSERT `reg 54.2(1)(a) — the effective date of the taking place of a division` (YMD 2026 12 5) EQUALS (YMD 2026 12 31)
#ASSERT `reg 54.2(1)(b) — the effective date of the approval of a division` (YMD 2026 4 30) EQUALS (YMD 2026 4 30)
#ASSERT `reg 54.2(1)(b) — the effective date of the approval of a division` (YMD 2026 4 1) EQUALS (YMD 2026 4 30)
#ASSERT `reg 54.2(1)(b) — the effective date of the approval of a division` (YMD 2026 12 31) EQUALS (YMD 2026 12 31)

§§ `54.2(2) -- attribution from the first day of the following month`

#ASSERT `reg 54.2(2) — the effective date of the attribution of pensionable earnings following the division` (YMD 2026 3 31) EQUALS (YMD 2026 4 1)
#ASSERT `reg 54.2(2) — the effective date of the attribution of pensionable earnings following the division` (YMD 2026 12 31) EQUALS (YMD 2027 1 1)
-- a received date of 15 March gives an effective date of 31 March and an attribution date of 1 April
#ASSERT `reg 54.2(2) — the effective date of the attribution of pensionable earnings following the division` (`reg 54.2(1)(a) — the effective date of the taking place of a division` (YMD 2026 3 15)) EQUALS (YMD 2026 4 1)

§§ `54.4 -- the special case`

#ASSERT `reg 54.4 — the Minister's powers may be exercised in accordance with subsection 58(7) of the Act` TRUE TRUE
#ASSERT NOT (`reg 54.4 — the Minister's powers may be exercised in accordance with subsection 58(7) of the Act` FALSE TRUE)
#ASSERT NOT (`reg 54.4 — the Minister's powers may be exercised in accordance with subsection 58(7) of the Act` TRUE FALSE)
