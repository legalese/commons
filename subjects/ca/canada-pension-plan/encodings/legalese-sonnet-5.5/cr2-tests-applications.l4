IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cr2-nouns`
IMPORT `cr2-applications`

-- Tests of cr2-applications.l4 (regulations 42 to 46.1). Layer 1.
-- Every expected value was decided by reading the regulation and counting days on a calendar before the rules
-- were run. A day count is "N days after the day named": that day plus N.

§ `Tests -- regulations 42 to 46.1`

§§ `42 -- deduction of an overpayment from a benefit`

-- Arguments: overpayment owing; a benefit payable under the Act or another program; amount to deduct; benefit payable; overpayment still owing; undue hardship.
#ASSERT `reg 42 — an amount owing may be deducted and retained out of a benefit payable` TRUE TRUE 100 500 300 FALSE
-- the whole of the benefit may be taken when it is all owed: amounts equal
#ASSERT `reg 42 — an amount owing may be deducted and retained out of a benefit payable` TRUE TRUE 300 300 300 FALSE
-- more than the benefit payable cannot be deducted out of it
#ASSERT NOT (`reg 42 — an amount owing may be deducted and retained out of a benefit payable` TRUE TRUE 600 500 700 FALSE)
-- more than the overpayment still owing would not "recover the overpayment" but exceed it
#ASSERT NOT (`reg 42 — an amount owing may be deducted and retained out of a benefit payable` TRUE TRUE 400 500 300 FALSE)
-- undue hardship bars the deduction
#ASSERT NOT (`reg 42 — an amount owing may be deducted and retained out of a benefit payable` TRUE TRUE 100 500 300 TRUE)
-- nothing owing; no benefit payable; nothing to deduct
#ASSERT NOT (`reg 42 — an amount owing may be deducted and retained out of a benefit payable` FALSE TRUE 100 500 300 FALSE)
#ASSERT NOT (`reg 42 — an amount owing may be deducted and retained out of a benefit payable` TRUE FALSE 100 500 300 FALSE)
#ASSERT NOT (`reg 42 — an amount owing may be deducted and retained out of a benefit payable` TRUE TRUE 0 500 300 FALSE)

§§ `43(1) -- an application is made in writing`

#ASSERT `reg 43(1) — an application for a benefit, a division or an assignment is made as the Regulations require` TRUE
#ASSERT NOT (`reg 43(1) — an application for a benefit, a division or an assignment is made as the Regulations require` FALSE)

§§ `43(1.1) -- a denied disability application that may be deemed a retirement pension application`

-- Arguments: denied; date of birth; date of the application; date of denial; would have been entitled to a retirement pension.
-- Born 1 March 1962: 60th birthday 1 March 2022, deemed reached on 1 April 2022 (section 2(2) of the Act).
#ASSERT `reg 43(1.1) — a denied application for a disability pension is one that may be deemed an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 1 1) (YearMonthDay 2022 6 1) FALSE
-- denied on the very day 60 is reached: inside the period
#ASSERT `reg 43(1.1) — a denied application for a disability pension is one that may be deemed an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 1 1) (YearMonthDay 2022 4 1) FALSE
-- denied the day before 60 is reached: not reached by then, and not otherwise entitled
#ASSERT NOT (`reg 43(1.1) — a denied application for a disability pension is one that may be deemed an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 1 1) (YearMonthDay 2022 3 31) FALSE)
-- applied on the very day 60 is reached: inside the period
#ASSERT `reg 43(1.1) — a denied application for a disability pension is one that may be deemed an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 4 1) (YearMonthDay 2022 9 1) FALSE
-- applied the day after 60 was reached: 60 was reached before the application, so the first limb is out
#ASSERT NOT (`reg 43(1.1) — a denied application for a disability pension is one that may be deemed an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 4 2) (YearMonthDay 2022 9 1) FALSE)
-- ... but the second limb: entitled to a retirement pension had they applied then
#ASSERT `reg 43(1.1) — a denied application for a disability pension is one that may be deemed an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 4 2) (YearMonthDay 2022 9 1) TRUE
-- not denied: nothing to deem
#ASSERT NOT (`reg 43(1.1) — a denied application for a disability pension is one that may be deemed an application for a retirement pension` FALSE (YearMonthDay 1962 3 1) (YearMonthDay 2022 1 1) (YearMonthDay 2022 6 1) TRUE)

§§ `43(1.1)(b) -- the last day for the request`

-- Notified of the denial on any day of March 2026: the month ends 31 March; 90 days after that is 29 June 2026.
#ASSERT `reg 43(1.1)(b) — the last day for the request` (YearMonthDay 2026 3 15) NOTHING EQUALS (YearMonthDay 2026 6 29)
#ASSERT `reg 43(1.1)(b) — the last day for the request` (YearMonthDay 2026 3 1) NOTHING EQUALS (YearMonthDay 2026 6 29)
#ASSERT `reg 43(1.1)(b) — the last day for the request` (YearMonthDay 2026 3 31) NOTHING EQUALS (YearMonthDay 2026 6 29)
-- The next day starts April: 30 April + 90 days = 29 July 2026.
#ASSERT `reg 43(1.1)(b) — the last day for the request` (YearMonthDay 2026 4 1) NOTHING EQUALS (YearMonthDay 2026 7 29)
-- Notified of a final confirmation on appeal on 10 January 2027: 90 days after that day is 10 April 2027.
#ASSERT `reg 43(1.1)(b) — the last day for the request` (YearMonthDay 2026 3 15) (JUST (YearMonthDay 2027 1 10)) EQUALS (YearMonthDay 2027 4 10)

§§ `43(1.1) -- the application is deemed to be a retirement pension application`

-- Arguments: denied; date of birth; date of application; date of denial; would have been entitled; request by or for the applicant;
-- request in writing; date of request; date notified of denial; date notified of confirmation on appeal (or nothing).
-- Born 1 March 1962, applied 1 January 2022, denied 1 June 2022, notified 10 June 2022: month ends 30 June; +90 days = 28 September 2022.
#ASSERT `reg 43(1.1) — the application for a disability pension is deemed to be an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 1 1) (YearMonthDay 2022 6 1) FALSE TRUE TRUE (YearMonthDay 2022 9 28) (YearMonthDay 2022 6 10) NOTHING
#ASSERT NOT (`reg 43(1.1) — the application for a disability pension is deemed to be an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 1 1) (YearMonthDay 2022 6 1) FALSE TRUE TRUE (YearMonthDay 2022 9 29) (YearMonthDay 2022 6 10) NOTHING)
-- not in writing
#ASSERT NOT (`reg 43(1.1) — the application for a disability pension is deemed to be an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 1 1) (YearMonthDay 2022 6 1) FALSE TRUE FALSE (YearMonthDay 2022 9 1) (YearMonthDay 2022 6 10) NOTHING)
-- made by a stranger
#ASSERT NOT (`reg 43(1.1) — the application for a disability pension is deemed to be an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 1 1) (YearMonthDay 2022 6 1) FALSE FALSE TRUE (YearMonthDay 2022 9 1) (YearMonthDay 2022 6 10) NOTHING)
-- the application does not qualify (not denied)
#ASSERT NOT (`reg 43(1.1) — the application for a disability pension is deemed to be an application for a retirement pension` FALSE (YearMonthDay 1962 3 1) (YearMonthDay 2022 1 1) (YearMonthDay 2022 6 1) FALSE TRUE TRUE (YearMonthDay 2022 9 1) (YearMonthDay 2022 6 10) NOTHING)
-- Confirmed on appeal, notified 15 November 2022: 90 days after is 13 February 2023.
#ASSERT `reg 43(1.1) — the application for a disability pension is deemed to be an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 1 1) (YearMonthDay 2022 6 1) FALSE TRUE TRUE (YearMonthDay 2023 2 13) (YearMonthDay 2022 6 10) (JUST (YearMonthDay 2022 11 15))
#ASSERT NOT (`reg 43(1.1) — the application for a disability pension is deemed to be an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 1 1) (YearMonthDay 2022 6 1) FALSE TRUE TRUE (YearMonthDay 2023 2 14) (YearMonthDay 2022 6 10) (JUST (YearMonthDay 2022 11 15)))
-- after confirmation, a request on 1 December 2022 is in time though 28 September 2022 has passed
#ASSERT `reg 43(1.1) — the application for a disability pension is deemed to be an application for a retirement pension` TRUE (YearMonthDay 1962 3 1) (YearMonthDay 2022 1 1) (YearMonthDay 2022 6 1) FALSE TRUE TRUE (YearMonthDay 2022 12 1) (YearMonthDay 2022 6 10) (JUST (YearMonthDay 2022 11 15))

§§ `43(2) -- forwarding an application to a provincial plan`

#ASSERT `reg 43(2) — the Minister must forward the application to the authority charged under the provincial plan` TRUE FALSE
#ASSERT `reg 43(2) — the Minister must forward the application to the authority charged under the provincial plan` FALSE TRUE
#ASSERT NOT (`reg 43(2) — the Minister must forward the application to the authority charged under the provincial plan` FALSE FALSE)

§§ `44 -- who may apply for someone else`

-- Arguments: Minister satisfied the person is incapable; Minister satisfied the other is authorized by law; none so authorized; the other is approved.
#ASSERT `reg 44(1) — an application may be made on behalf of a person incapable of managing their own affairs` TRUE TRUE FALSE FALSE
#ASSERT `reg 44(1) — an application may be made on behalf of a person incapable of managing their own affairs` TRUE FALSE TRUE TRUE
-- nobody authorized and the Minister has not approved the other
#ASSERT NOT (`reg 44(1) — an application may be made on behalf of a person incapable of managing their own affairs` TRUE FALSE TRUE FALSE)
-- approval does not help where someone is authorized by law but this one is not the authorized one
#ASSERT NOT (`reg 44(1) — an application may be made on behalf of a person incapable of managing their own affairs` TRUE FALSE FALSE TRUE)
-- not satisfied that the person is incapable
#ASSERT NOT (`reg 44(1) — an application may be made on behalf of a person incapable of managing their own affairs` FALSE TRUE FALSE FALSE)
-- Arguments: a division application of the kind named; a person is deceased; by the personal representative; by or for a child.
#ASSERT `reg 44(2) — an application for a division may be made after a death` TRUE TRUE TRUE FALSE
#ASSERT `reg 44(2) — an application for a division may be made after a death` TRUE TRUE FALSE TRUE
#ASSERT NOT (`reg 44(2) — an application for a division may be made after a death` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`reg 44(2) — an application for a division may be made after a death` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`reg 44(2) — an application for a division may be made after a death` FALSE TRUE TRUE FALSE)

§§ `45 -- withdrawing an application`

-- Arguments: no payment made; date of application; notice in writing; sent before payment commences.
#ASSERT `reg 45(1) — an applicant may withdraw an application for a benefit` TRUE (YearMonthDay 1975 5 29) TRUE TRUE
#ASSERT `reg 45(1) — an applicant may withdraw an application for a benefit` TRUE (YearMonthDay 2020 1 1) TRUE TRUE
-- an application made on or before 28 May 1975 is not within the regulation
#ASSERT NOT (`reg 45(1) — an applicant may withdraw an application for a benefit` TRUE (YearMonthDay 1975 5 28) TRUE TRUE)
#ASSERT NOT (`reg 45(1) — an applicant may withdraw an application for a benefit` TRUE (YearMonthDay 2020 1 1) TRUE FALSE)
#ASSERT NOT (`reg 45(1) — an applicant may withdraw an application for a benefit` TRUE (YearMonthDay 2020 1 1) FALSE TRUE)
#ASSERT NOT (`reg 45(1) — an applicant may withdraw an application for a benefit` FALSE (YearMonthDay 2020 1 1) TRUE TRUE)
#ASSERT NOT (`reg 45(2) — the application may be used afterwards to determine the applicant's eligibility for a benefit` TRUE)
#ASSERT `reg 45(2) — the application may be used afterwards to determine the applicant's eligibility for a benefit` FALSE
-- Notification received 1 January 2026: 60 days after is 2 March 2026.
#ASSERT `reg 45(3) — the last day to withdraw an application for a division` (YearMonthDay 2026 1 1) EQUALS (YearMonthDay 2026 3 2)
-- Arguments: a division application of the kind named; date notification received; date notice sent; notice in writing.
#ASSERT `reg 45(3) — an applicant may withdraw an application for a division` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 3 2) TRUE
#ASSERT NOT (`reg 45(3) — an applicant may withdraw an application for a division` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 3 3) TRUE)
#ASSERT `reg 45(3) — an applicant may withdraw an application for a division` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 1) TRUE
#ASSERT NOT (`reg 45(3) — an applicant may withdraw an application for a division` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2025 12 31) TRUE)
#ASSERT NOT (`reg 45(3) — an applicant may withdraw an application for a division` FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 2 1) TRUE)
#ASSERT NOT (`reg 45(3) — an applicant may withdraw an application for a division` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 2 1) FALSE)
#ASSERT NOT (`reg 45(4) — the application may be used afterwards to determine whether the person is eligible for the division` TRUE)
#ASSERT `reg 45(4) — the application may be used afterwards to determine whether the person is eligible for the division` FALSE
#ASSERT `reg 45(5) — the Minister must give written notice of the withdrawal to the other spouse, former spouse or former common-law partner or their estates` TRUE TRUE
#ASSERT NOT (`reg 45(5) — the Minister must give written notice of the withdrawal to the other spouse, former spouse or former common-law partner or their estates` TRUE FALSE)
#ASSERT NOT (`reg 45(5) — the Minister must give written notice of the withdrawal to the other spouse, former spouse or former common-law partner or their estates` FALSE TRUE)

§§ `46 and 46.1 -- notifying a division and an assignment`

#ASSERT `reg 46(1) — a notification required by subsection 55.2(4) of the Act is effected as the Regulations require` TRUE
#ASSERT NOT (`reg 46(1) — a notification required by subsection 55.2(4) of the Act is effected as the Regulations require` FALSE)

`item (a)` MEANS `reg 46(2)(a) — the dates of marriage and dissolution of marriage of the persons subject to the division`
`item (b)` MEANS `reg 46(2)(b) — the period of cohabitation for which the division has been made`
`item (c)` MEANS `reg 46(2)(c) — the unadjusted pensionable earnings of the persons before the division`
`item (g)` MEANS `reg 46(2)(g) — any other information that the Minister deems necessary`

-- The applicable items are (a), (b), (c) and (g); the notice contains (a) and (c): (b) and (g) are lacking.
#ASSERT `reg 46(2) — the items a notification of a division still lacks` (LIST `item (a)`, `item (b)`, `item (c)`, `item (g)`) (LIST `item (a)`, `item (c)`) EQUALS (LIST `item (b)`, `item (g)`)
#ASSERT `reg 46(2) — the items a notification of a division still lacks` (LIST `item (a)`, `item (b)`) (LIST `item (b)`, `item (a)`, `item (c)`) EQUALS EMPTY
-- an item the notice contains but that does not apply is not lacking, and nothing applies: nothing lacking
#ASSERT `reg 46(2) — the items a notification of a division still lacks` EMPTY (LIST `item (a)`) EQUALS EMPTY
#ASSERT `reg 46(2) — a notification required by subsection 55(8) or 55.2(10) of the Act is effected as the Regulations require` TRUE (LIST `item (a)`) (LIST `item (a)`)
#ASSERT NOT (`reg 46(2) — a notification required by subsection 55(8) or 55.2(10) of the Act is effected as the Regulations require` TRUE (LIST `item (a)`, `item (b)`) (LIST `item (a)`))
#ASSERT NOT (`reg 46(2) — a notification required by subsection 55(8) or 55.2(10) of the Act is effected as the Regulations require` FALSE (LIST `item (a)`) (LIST `item (a)`))
#ASSERT `reg 46(2) — a notification required by subsection 55(8) or 55.2(10) of the Act is effected as the Regulations require` TRUE EMPTY EMPTY
-- Division made 1 January 2026: 60 days after is 2 March 2026.
#ASSERT `reg 46(3) — the last day to cancel a division under subsection 55.1(5) of the Act` (YearMonthDay 2026 1 1) EQUALS (YearMonthDay 2026 3 2)
#ASSERT `reg 46(3) — a division may be cancelled under subsection 55.1(5) of the Act` (YearMonthDay 2026 1 1) (YearMonthDay 2026 3 2)
#ASSERT `reg 46(3) — a division may be cancelled under subsection 55.1(5) of the Act` (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 1)
#ASSERT NOT (`reg 46(3) — a division may be cancelled under subsection 55.1(5) of the Act` (YearMonthDay 2026 1 1) (YearMonthDay 2026 3 3))
#ASSERT NOT (`reg 46(3) — a division may be cancelled under subsection 55.1(5) of the Act` (YearMonthDay 2026 1 1) (YearMonthDay 2025 12 31))
#ASSERT `reg 46.1(1) — a notification required by subsection 65.1(5) of the Act is effected as the Regulations require` TRUE
#ASSERT NOT (`reg 46.1(1) — a notification required by subsection 65.1(5) of the Act is effected as the Regulations require` FALSE)
-- Arguments: in writing; states the commencing month; states the portion assigned; states the right to reconsideration.
#ASSERT `reg 46.1(2) — a notification required by subsection 65.1(12) of the Act is effected as the Regulations require` TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 46.1(2) — a notification required by subsection 65.1(12) of the Act is effected as the Regulations require` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 46.1(2) — a notification required by subsection 65.1(12) of the Act is effected as the Regulations require` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 46.1(2) — a notification required by subsection 65.1(12) of the Act is effected as the Regulations require` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`reg 46.1(2) — a notification required by subsection 65.1(12) of the Act is effected as the Regulations require` TRUE TRUE TRUE FALSE)
