IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-age`
IMPORT `cp3-nouns`
IMPORT `cp3-benefits-payable`

-- Tests of cp3-benefits-payable.l4 (subsection 44(1)). Expected values are worked by hand from the text.

§ `Tests -- the retirement pension (a)`

-- born 15 June 1960: 60 on 15 June 2020, deemed on 1 July 2020
#ASSERT NOT `s 44(1)(a) — a retirement pension is payable to a contributor who has reached sixty years of age` TRUE (YearMonthDay 1960 6 15) (YearMonthDay 2020 6 30)
#ASSERT NOT `s 44(1)(a) — a retirement pension is payable to a contributor who has reached sixty years of age` TRUE (YearMonthDay 1960 6 15) (YearMonthDay 2020 6 15)
#ASSERT `s 44(1)(a) — a retirement pension is payable to a contributor who has reached sixty years of age` TRUE (YearMonthDay 1960 6 15) (YearMonthDay 2020 7 1)
#ASSERT `s 44(1)(a) — a retirement pension is payable to a contributor who has reached sixty years of age` TRUE (YearMonthDay 1960 6 15) (YearMonthDay 2030 1 1)
-- not a contributor
#ASSERT NOT `s 44(1)(a) — a retirement pension is payable to a contributor who has reached sixty years of age` FALSE (YearMonthDay 1960 6 15) (YearMonthDay 2030 1 1)

§ `Tests -- the disability pension (b)`

-- Arguments: a contributor, date of birth, date asked, a retirement pension payable, disabled, minimum qualifying period, counterfactual (ii), counterfactual (iii).
#ASSERT `s 44(1)(b) — a disability pension is payable to a contributor who is disabled` TRUE (YearMonthDay 1980 1 1) (YearMonthDay 2025 1 1) FALSE TRUE TRUE FALSE FALSE
-- limb (ii) alone
#ASSERT `s 44(1)(b) — a disability pension is payable to a contributor who is disabled` TRUE (YearMonthDay 1980 1 1) (YearMonthDay 2025 1 1) FALSE TRUE FALSE TRUE FALSE
-- limb (iii) alone
#ASSERT `s 44(1)(b) — a disability pension is payable to a contributor who is disabled` TRUE (YearMonthDay 1980 1 1) (YearMonthDay 2025 1 1) FALSE TRUE FALSE FALSE TRUE
-- none of the three limbs
#ASSERT NOT `s 44(1)(b) — a disability pension is payable to a contributor who is disabled` TRUE (YearMonthDay 1980 1 1) (YearMonthDay 2025 1 1) FALSE TRUE FALSE FALSE FALSE
-- a retirement pension is payable
#ASSERT NOT `s 44(1)(b) — a disability pension is payable to a contributor who is disabled` TRUE (YearMonthDay 1980 1 1) (YearMonthDay 2025 1 1) TRUE TRUE TRUE FALSE FALSE
-- not disabled
#ASSERT NOT `s 44(1)(b) — a disability pension is payable to a contributor who is disabled` TRUE (YearMonthDay 1980 1 1) (YearMonthDay 2025 1 1) FALSE FALSE TRUE FALSE FALSE
-- not a contributor
#ASSERT NOT `s 44(1)(b) — a disability pension is payable to a contributor who is disabled` FALSE (YearMonthDay 1980 1 1) (YearMonthDay 2025 1 1) FALSE TRUE TRUE FALSE FALSE
-- born 10 March 1960: 65 on 10 March 2025, deemed 1 April 2025. On 31 March 2025 not yet 65; on 1 April 2025 65
#ASSERT `s 44(1)(b) — a disability pension is payable to a contributor who is disabled` TRUE (YearMonthDay 1960 3 10) (YearMonthDay 2025 3 31) FALSE TRUE TRUE FALSE FALSE
#ASSERT NOT `s 44(1)(b) — a disability pension is payable to a contributor who is disabled` TRUE (YearMonthDay 1960 3 10) (YearMonthDay 2025 4 1) FALSE TRUE TRUE FALSE FALSE

§ `Tests -- the death benefit (c)`

#ASSERT `s 44(1)(c) — a death benefit is payable to the estate or succession of a deceased contributor` TRUE TRUE TRUE
#ASSERT NOT `s 44(1)(c) — a death benefit is payable to the estate or succession of a deceased contributor` FALSE TRUE TRUE
#ASSERT NOT `s 44(1)(c) — a death benefit is payable to the estate or succession of a deceased contributor` TRUE FALSE TRUE
#ASSERT NOT `s 44(1)(c) — a death benefit is payable to the estate or succession of a deceased contributor` TRUE TRUE FALSE

§ `Tests -- the survivor's pension (d)`

-- Arguments of (i): a survivor, the minimum qualifying period, the survivor's date of birth, the date asked, the day of death, survivor with dependent children at the death, disabled.
-- aged 27 at the death, no children, not disabled, before 65: none of (A), (I), (II), (III)
#ASSERT NOT `s 44(1)(d)(i) — a survivor's pension is payable before 2019` TRUE TRUE (YearMonthDay 1990 1 1) (YearMonthDay 2018 6 1) (YearMonthDay 2017 3 1) FALSE FALSE
-- with dependent children at the death
#ASSERT `s 44(1)(d)(i) — a survivor's pension is payable before 2019` TRUE TRUE (YearMonthDay 1990 1 1) (YearMonthDay 2018 6 1) (YearMonthDay 2017 3 1) TRUE FALSE
-- disabled now
#ASSERT `s 44(1)(d)(i) — a survivor's pension is payable before 2019` TRUE TRUE (YearMonthDay 1990 1 1) (YearMonthDay 2018 6 1) (YearMonthDay 2017 3 1) FALSE TRUE
-- born 10 March 1975: 35 on 10 March 2010, deemed 1 April 2010; the contributor died 31 March 2010: not yet 35
#ASSERT NOT `s 44(1)(d)(i) — a survivor's pension is payable before 2019` TRUE TRUE (YearMonthDay 1975 3 10) (YearMonthDay 2018 6 1) (YearMonthDay 2010 3 31) FALSE FALSE
-- died 1 April 2010: 35 reached
#ASSERT `s 44(1)(d)(i) — a survivor's pension is payable before 2019` TRUE TRUE (YearMonthDay 1975 3 10) (YearMonthDay 2018 6 1) (YearMonthDay 2010 4 1) FALSE FALSE
-- 65 or over: payable whatever else
#ASSERT `s 44(1)(d)(i) — a survivor's pension is payable before 2019` TRUE TRUE (YearMonthDay 1950 1 1) (YearMonthDay 2018 6 1) (YearMonthDay 2017 3 1) FALSE FALSE
-- no minimum qualifying period
#ASSERT NOT `s 44(1)(d)(i) — a survivor's pension is payable before 2019` TRUE FALSE (YearMonthDay 1950 1 1) (YearMonthDay 2018 6 1) (YearMonthDay 2017 3 1) TRUE TRUE
-- not a survivor
#ASSERT NOT `s 44(1)(d)(i) — a survivor's pension is payable before 2019` FALSE TRUE (YearMonthDay 1950 1 1) (YearMonthDay 2018 6 1) (YearMonthDay 2017 3 1) TRUE TRUE
#ASSERT `s 44(1)(d)(ii) — a survivor's pension is payable after 2018` TRUE TRUE
#ASSERT NOT `s 44(1)(d)(ii) — a survivor's pension is payable after 2018` TRUE FALSE
#ASSERT NOT `s 44(1)(d)(ii) — a survivor's pension is payable after 2018` FALSE TRUE
-- the whole paragraph: the same young survivor on 31 December 2018 (paragraph (i): no) and 1 January 2019 (paragraph (ii): yes)
#ASSERT NOT `s 44(1)(d) — a survivor's pension is payable to the survivor of a deceased contributor` TRUE TRUE (YearMonthDay 1990 1 1) (YearMonthDay 2018 12 31) (YearMonthDay 2017 3 1) FALSE FALSE
#ASSERT `s 44(1)(d) — a survivor's pension is payable to the survivor of a deceased contributor` TRUE TRUE (YearMonthDay 1990 1 1) (YearMonthDay 2019 1 1) (YearMonthDay 2017 3 1) FALSE FALSE
#ASSERT `s 44(1)(d) — a survivor's pension is payable to the survivor of a deceased contributor` TRUE TRUE (YearMonthDay 1990 1 1) (YearMonthDay 2018 12 31) (YearMonthDay 2017 3 1) TRUE FALSE

§ `Tests -- the disabled contributor's child's benefit (e)`

-- Arguments: a disabled contributor's child, a disability pension payable, a post-retirement disability benefit payable, minimum qualifying period under (2), under (4), counterfactual (ii), counterfactual (iii).
#ASSERT `s 44(1)(e) — a disabled contributor's child's benefit is payable to a child of a disabled contributor` TRUE TRUE FALSE TRUE FALSE FALSE FALSE
-- a disability pension is payable but only the subsection (4) test is met: the wrong test
#ASSERT NOT `s 44(1)(e) — a disabled contributor's child's benefit is payable to a child of a disabled contributor` TRUE TRUE FALSE FALSE TRUE FALSE FALSE
-- a post-retirement disability benefit is payable and the subsection (4) test is met
#ASSERT `s 44(1)(e) — a disabled contributor's child's benefit is payable to a child of a disabled contributor` TRUE FALSE TRUE FALSE TRUE FALSE FALSE
-- a post-retirement disability benefit is payable but only the subsection (2) test is met
#ASSERT NOT `s 44(1)(e) — a disabled contributor's child's benefit is payable to a child of a disabled contributor` TRUE FALSE TRUE TRUE FALSE FALSE FALSE
-- limb (ii) alone, limb (iii) alone
#ASSERT `s 44(1)(e) — a disabled contributor's child's benefit is payable to a child of a disabled contributor` TRUE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 44(1)(e) — a disabled contributor's child's benefit is payable to a child of a disabled contributor` TRUE FALSE FALSE FALSE FALSE FALSE TRUE
-- none
#ASSERT NOT `s 44(1)(e) — a disabled contributor's child's benefit is payable to a child of a disabled contributor` TRUE FALSE FALSE FALSE FALSE FALSE FALSE
-- not a disabled contributor's child
#ASSERT NOT `s 44(1)(e) — a disabled contributor's child's benefit is payable to a child of a disabled contributor` FALSE TRUE FALSE TRUE FALSE TRUE TRUE

§ `Tests -- the orphan's benefit (f) and the post-retirement benefit (g)`

#ASSERT `s 44(1)(f) — an orphan's benefit is payable to an orphan of a deceased contributor` TRUE TRUE
#ASSERT NOT `s 44(1)(f) — an orphan's benefit is payable to an orphan of a deceased contributor` TRUE FALSE
#ASSERT NOT `s 44(1)(f) — an orphan's benefit is payable to an orphan of a deceased contributor` FALSE TRUE
#ASSERT `s 44(1)(g) — a post-retirement benefit is payable to a beneficiary of a retirement pension` TRUE TRUE
#ASSERT NOT `s 44(1)(g) — a post-retirement benefit is payable to a beneficiary of a retirement pension` TRUE FALSE
#ASSERT NOT `s 44(1)(g) — a post-retirement benefit is payable to a beneficiary of a retirement pension` FALSE TRUE

§ `Tests -- the post-retirement disability benefit (h)`

-- Arguments: a beneficiary of a retirement pension, date of birth, date asked, disabled, the minimum qualifying period, the month determined disabled, counterfactual (ii), counterfactual (iii).
-- born 10 March 1960: 65 deemed 1 April 2025. On 31 March 2025 not yet 65. The period ends January 2019: after 2018
#ASSERT `s 44(1)(h) — a post-retirement disability benefit is payable to a beneficiary of a retirement pension who is disabled` TRUE (YearMonthDay 1960 3 10) (YearMonthDay 2025 3 31) TRUE TRUE (YearMonthDay 2019 1 1) FALSE FALSE
-- the period ends December 2018: not after 2018
#ASSERT NOT `s 44(1)(h) — a post-retirement disability benefit is payable to a beneficiary of a retirement pension who is disabled` TRUE (YearMonthDay 1960 3 10) (YearMonthDay 2025 3 31) TRUE TRUE (YearMonthDay 2018 12 1) FALSE FALSE
-- the same, but limb (ii) holds
#ASSERT `s 44(1)(h) — a post-retirement disability benefit is payable to a beneficiary of a retirement pension who is disabled` TRUE (YearMonthDay 1960 3 10) (YearMonthDay 2025 3 31) TRUE TRUE (YearMonthDay 2018 12 1) TRUE FALSE
#ASSERT `s 44(1)(h) — a post-retirement disability benefit is payable to a beneficiary of a retirement pension who is disabled` TRUE (YearMonthDay 1960 3 10) (YearMonthDay 2025 3 31) TRUE FALSE (YearMonthDay 2018 12 1) FALSE TRUE
-- 65 on 1 April 2025
#ASSERT NOT `s 44(1)(h) — a post-retirement disability benefit is payable to a beneficiary of a retirement pension who is disabled` TRUE (YearMonthDay 1960 3 10) (YearMonthDay 2025 4 1) TRUE TRUE (YearMonthDay 2019 1 1) FALSE FALSE
-- not disabled
#ASSERT NOT `s 44(1)(h) — a post-retirement disability benefit is payable to a beneficiary of a retirement pension who is disabled` TRUE (YearMonthDay 1960 3 10) (YearMonthDay 2025 3 31) FALSE TRUE (YearMonthDay 2019 1 1) TRUE TRUE
-- not a beneficiary of a retirement pension
#ASSERT NOT `s 44(1)(h) — a post-retirement disability benefit is payable to a beneficiary of a retirement pension who is disabled` FALSE (YearMonthDay 1960 3 10) (YearMonthDay 2025 3 31) TRUE TRUE (YearMonthDay 2019 1 1) FALSE FALSE
