IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cp6-provinces-and-consent`
IMPORT `cp6-rates-review`
IMPORT `cp6-statements-and-reports`

-- Tests of cp6-statements-and-reports.l4 (sections 112, 115 and 117).

§ `Tests -- statements and reports`

§§ `Not a provision: counting sitting days`

-- Seven sitting days in March 2026, earliest first.
`cp6 test sitting days` MEANS LIST (YMD 2026 3 2), (YMD 2026 3 3), (YMD 2026 3 4), (YMD 2026 3 5), (YMD 2026 3 6), (YMD 2026 3 9), (YMD 2026 3 10)

-- After 1 March: the first five are 2 to 6 March.
#ASSERT `the first sitting days after a date` (YMD 2026 3 1) `cp6 test sitting days` 5 EQUALS LIST (YMD 2026 3 2), (YMD 2026 3 3), (YMD 2026 3 4), (YMD 2026 3 5), (YMD 2026 3 6)
-- After 3 March: the first five are 4, 5, 6, 9 and 10 March (the sitting on the 3rd itself is not after it).
#ASSERT `the first sitting days after a date` (YMD 2026 3 3) `cp6 test sitting days` 5 EQUALS LIST (YMD 2026 3 4), (YMD 2026 3 5), (YMD 2026 3 6), (YMD 2026 3 9), (YMD 2026 3 10)
-- Fewer than five left: all of them.
#ASSERT `the first sitting days after a date` (YMD 2026 3 9) `cp6 test sitting days` 5 EQUALS LIST (YMD 2026 3 10)

§§ `Section 112: annual financial statements`

#ASSERT `s 112(1) — the Minister must as soon as possible prepare one set of annual financial statements for the fiscal year` TRUE
#ASSERT NOT (`s 112(1) — the Minister must as soon as possible prepare one set of annual financial statements for the fiscal year` FALSE)
#ASSERT `s 112(1) — the annual financial statements must set out the item` `a statement combining the amounts credited to or charged to the two accounts and the accounts of the Investment Board during the year` FALSE
#ASSERT `s 112(1) — the annual financial statements must set out the item` `a schedule combining the base plan amounts credited or charged during the year` FALSE
#ASSERT `s 112(1) — the annual financial statements must set out the item` `a schedule combining the additional plan amounts credited or charged during the year` FALSE
#ASSERT `s 112(1) — the annual financial statements must set out the item` `a statement combining the accounts of the two accounts and the Investment Board as at the end of the year` FALSE
#ASSERT `s 112(1) — the annual financial statements must set out the item` `a schedule combining the base plan accounts as at the end of the year` FALSE
#ASSERT `s 112(1) — the annual financial statements must set out the item` `a schedule combining the additional plan accounts as at the end of the year` FALSE
-- Paragraph (g) depends on the Minister's view.
#ASSERT `s 112(1) — the annual financial statements must set out the item` `any other accounts and information that the Minister considers appropriate to present fairly the financial transactions and the financial position of the Canada Pension Plan for the year` TRUE
#ASSERT NOT (`s 112(1) — the annual financial statements must set out the item` `any other accounts and information that the Minister considers appropriate to present fairly the financial transactions and the financial position of the Canada Pension Plan for the year` FALSE)
#ASSERT NOT (`s 112(1) — the annual financial statements must set out the item` `something else` TRUE)
#ASSERT `s 112(2) — the Minister may rely on the financial statements` TRUE
#ASSERT NOT (`s 112(2) — the Minister may rely on the financial statements` FALSE)
#ASSERT `s 112(3) — the statements must be audited annually by the Auditor General of Canada, who makes a report of the audit to the Minister` TRUE
#ASSERT NOT (`s 112(3) — the statements must be audited annually by the Auditor General of Canada, who makes a report of the audit to the Minister` FALSE)
#ASSERT `s 112(4) — the Investment Board and its auditor must provide the records, accounts, statements or other information to the Auditor General of Canada` TRUE
#ASSERT NOT (`s 112(4) — the Investment Board and its auditor must provide the records, accounts, statements or other information to the Auditor General of Canada` FALSE)

§§ `Section 115(1): in time, and as at a proper date`

-- The three-year period 2025 to 2027: prepared in the first year, as at a date not earlier than 31 December 2024.
#ASSERT `s 115(1) — the Chief Actuary's report is prepared in time and as at a proper date` 2025 (YMD 2025 6 15) (YMD 2024 12 31)
#ASSERT `s 115(1) — the Chief Actuary's report is prepared in time and as at a proper date` 2025 (YMD 2025 12 31) (YMD 2025 3 31)
#ASSERT NOT (`s 115(1) — the Chief Actuary's report is prepared in time and as at a proper date` 2025 (YMD 2025 6 15) (YMD 2024 12 30))
-- Prepared in the second year, or before the period: not in time.
#ASSERT NOT (`s 115(1) — the Chief Actuary's report is prepared in time and as at a proper date` 2025 (YMD 2026 1 1) (YMD 2025 12 31))
#ASSERT NOT (`s 115(1) — the Chief Actuary's report is prepared in time and as at a proper date` 2025 (YMD 2024 12 31) (YMD 2024 12 31))

§§ `Section 115(1.1) to (1.3): contents`

#ASSERT `s 115(1.1)(a) — the number of years after the date of the examination for which the estimates are stated` EQUALS 30
#ASSERT `s 115(1.1)(b) — the least number of years from the date of the examination in the period` EQUALS 75
-- An estimate for each fifth year of a period of at least 75 years: 5, 10, ... 75 (and further if the period is longer).
#ASSERT `s 115(1.1)(b) — an estimate of the percentage is stated for the year` 5 75
#ASSERT `s 115(1.1)(b) — an estimate of the percentage is stated for the year` 10 75
#ASSERT `s 115(1.1)(b) — an estimate of the percentage is stated for the year` 75 75
#ASSERT `s 115(1.1)(b) — an estimate of the percentage is stated for the year` 80 80
#ASSERT NOT (`s 115(1.1)(b) — an estimate of the percentage is stated for the year` 74 75)
#ASSERT NOT (`s 115(1.1)(b) — an estimate of the percentage is stated for the year` 3 75)
#ASSERT NOT (`s 115(1.1)(b) — an estimate of the percentage is stated for the year` 0 75)
#ASSERT NOT (`s 115(1.1)(b) — an estimate of the percentage is stated for the year` 80 75)
-- A period shorter than 75 years is not the period the paragraph speaks of.
#ASSERT NOT (`s 115(1.1)(b) — an estimate of the percentage is stated for the year` 70 70)
#ASSERT `s 115(1.1)(c) to (e) — the least number of years after the three-year period for which each rate is specified` EQUALS 75
-- (c), (d), (e): the two rates combined. Base: 9.8% and 0.1% combine to 9.9%; first additional: 1.9% and 0.1% to 2.0%; second additional: 7.9% and 0.1% to 8.0%.
#ASSERT `s 115(1.1)(c) — the contribution rate specified for self-employed persons for the base Canada Pension Plan` (9.8%) (0.1%) EQUALS (9.9%)
#ASSERT `s 115(1.1)(d) — the first additional contribution rate specified for self-employed persons` (1.9%) (0.1%) EQUALS (2.0%)
#ASSERT `s 115(1.1)(e) — the second additional contribution rate specified for self-employed persons` (7.9%) (0.1%) EQUALS (8.0%)
-- With no changes the rate is the first alone.
#ASSERT `s 115(1.1)(c) — the contribution rate specified for self-employed persons for the base Canada Pension Plan` (9.9%) (0%) EQUALS (9.9%)
#ASSERT `s 115(1.1) — the Chief Actuary must state the content in the report` `the estimated revenues, investment income and payments for the base Canada Pension Plan for each of the 30 years`
#ASSERT `s 115(1.1) — the Chief Actuary must state the content in the report` `the estimated revenues, investment income and payments for the additional Canada Pension Plan for each of the 30 years`
#ASSERT `s 115(1.1) — the Chief Actuary must state the content in the report` `an estimate of the percentage of contributory salaries and wages and contributory self-employed earnings required in each fifth year`
#ASSERT `s 115(1.1) — the Chief Actuary must state the content in the report` `the contribution rate specified for self-employed persons for the base Canada Pension Plan`
#ASSERT `s 115(1.1) — the Chief Actuary must state the content in the report` `the first additional contribution rate specified for self-employed persons`
#ASSERT `s 115(1.1) — the Chief Actuary must state the content in the report` `the second additional contribution rate specified for self-employed persons`
#ASSERT `s 115(1.1) — the Chief Actuary must state the content in the report` `the rates referred to in paragraphs (c) to (e) and the manner in which they were calculated`
#ASSERT NOT (`s 115(1.1) — the Chief Actuary must state the content in the report` `something else`)
-- (1.11): the first report prepared after 2015 and every third report that follows: reports 1, 4, 7.
#ASSERT `s 115(1.11) — the Chief Actuary must specify the adjustment factors in the report` 1
#ASSERT `s 115(1.11) — the Chief Actuary must specify the adjustment factors in the report` 4
#ASSERT `s 115(1.11) — the Chief Actuary must specify the adjustment factors in the report` 7
#ASSERT NOT (`s 115(1.11) — the Chief Actuary must specify the adjustment factors in the report` 2)
#ASSERT NOT (`s 115(1.11) — the Chief Actuary must specify the adjustment factors in the report` 3)
#ASSERT NOT (`s 115(1.11) — the Chief Actuary must specify the adjustment factors in the report` 0)
-- The Chief Actuary may also specify them in any report after 2015 if considered necessary.
#ASSERT `s 115(1.11) — the Chief Actuary may specify the adjustment factors in the report` 2 TRUE
#ASSERT NOT (`s 115(1.11) — the Chief Actuary may specify the adjustment factors in the report` 2 FALSE)
#ASSERT `s 115(1.11) — the Chief Actuary may specify the adjustment factors in the report` 4 FALSE
#ASSERT NOT (`s 115(1.11) — the Chief Actuary may specify the adjustment factors in the report` 0 TRUE)
-- (1.2): the same relation as 113.1(7)(a) and (b).
#ASSERT `s 115(1.2) — the rates for the year stand in the required relation` (4.95%) (4.95%) (9.9%)
#ASSERT NOT (`s 115(1.2) — the rates for the year stand in the required relation` (4.95%) (4.95%) (9.8%))
#ASSERT NOT (`s 115(1.2) — the rates for the year stand in the required relation` (4.9%) (5.0%) (9.9%))
-- (1.3): the two-thirds consent of section 114(4).
#ASSERT `s 115(1.3) — the regulations prescribing the manner of the calculation may be made or changed` 9 6 30000000 20000000
#ASSERT NOT (`s 115(1.3) — the regulations prescribing the manner of the calculation may be made or changed` 9 5 30000000 20000000)

§§ `Section 115(2), (3) and (8)`

-- Inputs: a Bill is introduced; in the Chief Actuary's opinion it would materially affect the estimates; the Minister of Finance has requested the report.
#ASSERT `s 115(2) — the Chief Actuary must prepare a report on the Bill` TRUE TRUE TRUE
#ASSERT NOT (`s 115(2) — the Chief Actuary must prepare a report on the Bill` FALSE TRUE TRUE)
#ASSERT NOT (`s 115(2) — the Chief Actuary must prepare a report on the Bill` TRUE FALSE TRUE)
#ASSERT NOT (`s 115(2) — the Chief Actuary must prepare a report on the Bill` TRUE TRUE FALSE)
#ASSERT `s 115(3) — the report on the Bill must also use other actuarial assumptions and another basis` TRUE
#ASSERT NOT (`s 115(3) — the report on the Bill must also use other actuarial assumptions and another basis` FALSE)
#ASSERT `s 115(8) — the way the Minister of Finance must make the report public` `Parliament is then sitting` EQUALS `lay it before the House of Commons forthwith on its receipt`
#ASSERT `s 115(8) — the way the Minister of Finance must make the report public` `Parliament is then not sitting` EQUALS `lay it before the House of Commons on any of the first five days next thereafter that Parliament is sitting`
#ASSERT `s 115(8) — the way the Minister of Finance must make the report public` `Parliament is then dissolved` EQUALS `cause a copy to be published in the Canada Gazette forthwith`
-- Received on 1 March while Parliament is not sitting: the first five sitting days after are 2 to 6 March; the sixth, 9 March, is too late; the day of receipt is not "thereafter".
#ASSERT `s 115(8) — the day is one of the first five days next thereafter that Parliament is sitting` (YMD 2026 3 1) `cp6 test sitting days` (YMD 2026 3 2)
#ASSERT `s 115(8) — the day is one of the first five days next thereafter that Parliament is sitting` (YMD 2026 3 1) `cp6 test sitting days` (YMD 2026 3 6)
#ASSERT NOT (`s 115(8) — the day is one of the first five days next thereafter that Parliament is sitting` (YMD 2026 3 1) `cp6 test sitting days` (YMD 2026 3 9))
#ASSERT NOT (`s 115(8) — the day is one of the first five days next thereafter that Parliament is sitting` (YMD 2026 3 1) `cp6 test sitting days` (YMD 2026 3 1))

§§ `Section 117: the annual report`

#ASSERT `s 117(1) — the Ministers must as soon as possible together prepare a report on the administration of the Act during the year` TRUE
#ASSERT NOT (`s 117(1) — the Ministers must as soon as possible together prepare a report on the administration of the Act during the year` FALSE)
#ASSERT `s 117(1) — the annual report must include the item` `the annual financial statements for the year under section 112 and the report of the Auditor General on those statements` FALSE
#ASSERT `s 117(1) — the annual report must include the item` `the number of contributors during the year and the number of persons to whom benefits were payable during the year` FALSE
#ASSERT `s 117(1) — the annual report must include the item` `any other information that the Ministers and the appropriate provincial Ministers consider appropriate` TRUE
#ASSERT NOT (`s 117(1) — the annual report must include the item` `any other information that the Ministers and the appropriate provincial Ministers consider appropriate` FALSE)
#ASSERT NOT (`s 117(1) — the annual report must include the item` `something else` TRUE)

-- Twenty sitting days, 2 to 27 March 2026 (weekdays).
`cp6 test twenty sitting days` MEANS LIST (YMD 2026 3 2), (YMD 2026 3 3), (YMD 2026 3 4), (YMD 2026 3 5), (YMD 2026 3 6), (YMD 2026 3 9), (YMD 2026 3 10), (YMD 2026 3 11), (YMD 2026 3 12), (YMD 2026 3 13), (YMD 2026 3 16), (YMD 2026 3 17), (YMD 2026 3 18), (YMD 2026 3 19), (YMD 2026 3 20), (YMD 2026 3 23), (YMD 2026 3 24), (YMD 2026 3 25), (YMD 2026 3 26), (YMD 2026 3 27)

-- Report prepared on 1 March: the first 15 sitting days are 2 March to 20 March; the 16th is 23 March.
#ASSERT `s 117(2) — the day is one of the first 15 days on which the House sits after the report is prepared` (YMD 2026 3 1) `cp6 test twenty sitting days` (YMD 2026 3 2)
#ASSERT `s 117(2) — the day is one of the first 15 days on which the House sits after the report is prepared` (YMD 2026 3 1) `cp6 test twenty sitting days` (YMD 2026 3 20)
#ASSERT NOT (`s 117(2) — the day is one of the first 15 days on which the House sits after the report is prepared` (YMD 2026 3 1) `cp6 test twenty sitting days` (YMD 2026 3 23))
-- A day on which the House does not sit is not among them.
#ASSERT NOT (`s 117(2) — the day is one of the first 15 days on which the House sits after the report is prepared` (YMD 2026 3 1) `cp6 test twenty sitting days` (YMD 2026 3 7))
#ASSERT `s 117(3) — the Ministers must as soon as possible send the report to the appropriate provincial Minister of every province` TRUE
#ASSERT NOT (`s 117(3) — the Ministers must as soon as possible send the report to the appropriate provincial Minister of every province` FALSE)
#ASSERT `s 117(4) — the minister is the appropriate provincial Minister of the province` TRUE
#ASSERT NOT (`s 117(4) — the minister is the appropriate provincial Minister of the province` FALSE)
