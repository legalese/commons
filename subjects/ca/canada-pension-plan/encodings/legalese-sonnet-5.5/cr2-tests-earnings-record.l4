IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cr2-nouns`
IMPORT `cr2-earnings-record`

-- Tests of cr2-earnings-record.l4 (regulations 39 to 41). Layer 1.
-- Every expected value was decided by reading the regulations before the rules were run.

§ `Tests -- regulations 39 to 41`

§§ `39 -- application for a statement of earnings`

-- Arguments: way; includes name; includes address with postal code; includes SIN; includes postal code.
-- In writing: name, address (including postal code) and SIN. The separate postal code is not needed.
#ASSERT `reg 39 — an application for a statement of earnings is made as the Regulations require` `an application in writing to the Minister` TRUE TRUE TRUE FALSE
#ASSERT NOT (`reg 39 — an application for a statement of earnings is made as the Regulations require` `an application in writing to the Minister` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 39 — an application for a statement of earnings is made as the Regulations require` `an application in writing to the Minister` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 39 — an application for a statement of earnings is made as the Regulations require` `an application in writing to the Minister` TRUE TRUE FALSE TRUE)
-- By the Internet: name, SIN and postal code. The street address is not needed.
#ASSERT `reg 39 — an application for a statement of earnings is made as the Regulations require` `an application to the Minister by way of the Internet on the electronic form prescribed for that purpose` TRUE FALSE TRUE TRUE
#ASSERT NOT (`reg 39 — an application for a statement of earnings is made as the Regulations require` `an application to the Minister by way of the Internet on the electronic form prescribed for that purpose` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`reg 39 — an application for a statement of earnings is made as the Regulations require` `an application to the Minister by way of the Internet on the electronic form prescribed for that purpose` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`reg 39 — an application for a statement of earnings is made as the Regulations require` `an application to the Minister by way of the Internet on the electronic form prescribed for that purpose` FALSE TRUE TRUE TRUE)
-- Any other way is not one the regulation provides for.
#ASSERT NOT (`reg 39 — an application for a statement of earnings is made as the Regulations require` `an application made in some other way` TRUE TRUE TRUE TRUE)

§§ `40 -- notice of a reduction in the Record of Earnings`

#ASSERT `reg 40 — the contributor must be notified of the reduction in writing, addressed to the contributor's latest known address` TRUE
#ASSERT NOT (`reg 40 — the contributor must be notified of the reduction in writing, addressed to the contributor's latest known address` FALSE)
#ASSERT `reg 40 — a notice of a reduction is in writing addressed to the contributor at the latest known address` TRUE TRUE
#ASSERT NOT (`reg 40 — a notice of a reduction is in writing addressed to the contributor at the latest known address` TRUE FALSE)
#ASSERT NOT (`reg 40 — a notice of a reduction is in writing addressed to the contributor at the latest known address` FALSE TRUE)
#ASSERT NOT (`reg 40 — a notice of a reduction is in writing addressed to the contributor at the latest known address` FALSE FALSE)

§§ `41 -- salary and wages on which a contribution has been made under a provincial pension plan`

-- 41(1): contributions 2,700 at a plan rate of 5.4 per cent. Half the rate is 2.7; 2,700 x 100 / 2.7 = 100,000.
#ASSERT `reg 41(1) — the salary and wages on which a base contribution has been made under a provincial pension plan` 2019 2700 5.4 EQUALS JUST 100000
#ASSERT `reg 41(1) — the salary and wages on which a base contribution has been made under a provincial pension plan` 2030 2700 5.4 EQUALS JUST 100000
-- the text starts with the year 2019
#ASSERT `reg 41(1) — the salary and wages on which a base contribution has been made under a provincial pension plan` 2018 2700 5.4 EQUALS NOTHING
-- no rate, nothing to divide by
#ASSERT `reg 41(1) — the salary and wages on which a base contribution has been made under a provincial pension plan` 2019 2700 0 EQUALS NOTHING
-- nothing contributed: nothing on which a contribution was made
#ASSERT `reg 41(1) — the salary and wages on which a base contribution has been made under a provincial pension plan` 2019 0 5.4 EQUALS JUST 0
-- 41(2): first additional, 500 at a rate of 1 per cent: 500 x 100 / 0.5 = 100,000.
#ASSERT `reg 41(2) — the salary and wages on which a first additional contribution has been made under a provincial pension plan` 2019 500 1 EQUALS JUST 100000
#ASSERT `reg 41(2) — the salary and wages on which a first additional contribution has been made under a provincial pension plan` 2018 500 1 EQUALS NOTHING
#ASSERT `reg 41(2) — the salary and wages on which a first additional contribution has been made under a provincial pension plan` 2019 500 0 EQUALS NOTHING
-- 41(3): second additional, from 2024: 300 at a rate of 4 per cent: 300 x 100 / 2 = 15,000.
#ASSERT `reg 41(3) — the salary and wages on which a second additional contribution has been made under a provincial pension plan` 2024 300 4 EQUALS JUST 15000
#ASSERT `reg 41(3) — the salary and wages on which a second additional contribution has been made under a provincial pension plan` 2023 300 4 EQUALS NOTHING
#ASSERT `reg 41(3) — the salary and wages on which a second additional contribution has been made under a provincial pension plan` 2024 300 0 EQUALS NOTHING
