IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cr1-interpretation`
IMPORT `cr1-part2-returns`

-- Tests of cr1-part2-returns.l4 (Regulations 9 to 14). Every expected value is worked out by hand from the text
-- (C.R.C.-c.-385.txt lines 197 to 216) and a calendar before the run.

§ `Tests of regulations 9 to 14`

§§ `Regulation 9`

#ASSERT `reg 9 — the Part whose words and expressions a Part uses` `the Regulations' Part II` EQUALS JUST `the Regulations' Part I`
-- Reg 9 says nothing about any other Part.
#ASSERT `reg 9 — the Part whose words and expressions a Part uses` `the Regulations' Part III` EQUALS NOTHING
#ASSERT `reg 9 — the Part whose words and expressions a Part uses` `the Regulations' Part I` EQUALS NOTHING

§§ `Regulation 10: when the return is filed`

#ASSERT `reg 10(1) — the person must file an information return for the year` TRUE
#ASSERT NOT (`reg 10(1) — the person must file an information return for the year` FALSE)
-- The last day of February of the year next following.
#ASSERT `reg 10(1) — the last day of February of the year next following` 2026 EQUALS (YMD 2027 2 28)
#ASSERT `reg 10(1) — the last day of February of the year next following` 2027 EQUALS (YMD 2028 2 29)
#ASSERT `reg 10(1) — the last day of February of the year next following` 2023 EQUALS (YMD 2024 2 29)
-- 10(2): within 30 days of ceasing.
#ASSERT `reg 10(2) — the day by which an information return must be filed after ceasing to carry on a business` (YMD 2026 12 20) EQUALS (YMD 2027 1 19)
#ASSERT `reg 10(2) — the day by which an information return must be filed after ceasing to carry on a business` (YMD 2026 6 10) EQUALS (YMD 2026 7 10)
-- The two together (fork F7: the earlier).
#ASSERT `reg 10 — the day by which the information return for a year must be filed` 2026 NOTHING EQUALS (YMD 2027 2 28)
#ASSERT `reg 10 — the day by which the information return for a year must be filed` 2026 (JUST (YMD 2026 12 20)) EQUALS (YMD 2027 1 19)
#ASSERT `reg 10 — the day by which the information return for a year must be filed` 2026 (JUST (YMD 2027 2 20)) EQUALS (YMD 2027 2 28)

§§ `Regulation 11: on demand by registered letter`

#ASSERT `reg 11 — the person must make an information return on demand` TRUE TRUE
#ASSERT NOT (`reg 11 — the person must make an information return on demand` TRUE FALSE)
#ASSERT NOT (`reg 11 — the person must make an information return on demand` FALSE TRUE)
#ASSERT `reg 11 — the return demanded was filed in time` (YMD 2026 8 14) (YMD 2026 8 14)
#ASSERT `reg 11 — the return demanded was filed in time` (YMD 2026 8 13) (YMD 2026 8 14)
#ASSERT NOT (`reg 11 — the return demanded was filed in time` (YMD 2026 8 15) (YMD 2026 8 14))

§§ `Regulation 12: legal representatives and others`

-- 90 days from 1 May 2026 is 30 July 2026.
#ASSERT `reg 12(1) — the day by which the legal representatives must file the return` (YMD 2026 5 1) EQUALS (YMD 2026 7 30)
-- The year of death: the part before the death; an earlier year: all of it.
#ASSERT `reg 12(1) — the last day the return covers` 2026 (YMD 2026 5 1) EQUALS (YMD 2026 5 1)
#ASSERT `reg 12(1) — the last day the return covers` 2025 (YMD 2026 5 1) EQUALS (YMD 2025 12 31)
#ASSERT `reg 12(2) — the person must file the return on the other's behalf` `a trustee in bankruptcy` TRUE
#ASSERT `reg 12(2) — the person must file the return on the other's behalf` `an assignee` TRUE
#ASSERT `reg 12(2) — the person must file the return on the other's behalf` `a liquidator` TRUE
#ASSERT `reg 12(2) — the person must file the return on the other's behalf` `a curator` TRUE
#ASSERT `reg 12(2) — the person must file the return on the other's behalf` `a receiver` TRUE
#ASSERT `reg 12(2) — the person must file the return on the other's behalf` `a trustee` TRUE
#ASSERT `reg 12(2) — the person must file the return on the other's behalf` `a committee` TRUE
#ASSERT `reg 12(2) — the person must file the return on the other's behalf` `an agent or other person administering, managing, winding up, controlling or otherwise dealing with the property, business or estate` TRUE
#ASSERT NOT (`reg 12(2) — the person must file the return on the other's behalf` `none of those` TRUE)
#ASSERT NOT (`reg 12(2) — the person must file the return on the other's behalf` `a receiver` FALSE)

§§ `Regulation 13: the employee's portion`

#ASSERT `reg 13(1) — the number of copies of the employee's portion the person must supply` TRUE EQUALS JUST 2
#ASSERT `reg 13(1) — the number of copies of the employee's portion the person must supply` FALSE EQUALS NOTHING
-- 13(2): by mail or in person, on or before the day the return is to be filed with the Minister.
#ASSERT `reg 13(2) — the copies were supplied in the way and by the day required` TRUE FALSE (YMD 2027 2 28) (YMD 2027 2 28)
#ASSERT `reg 13(2) — the copies were supplied in the way and by the day required` FALSE TRUE (YMD 2027 2 27) (YMD 2027 2 28)
#ASSERT NOT (`reg 13(2) — the copies were supplied in the way and by the day required` TRUE FALSE (YMD 2027 3 1) (YMD 2027 2 28))
#ASSERT NOT (`reg 13(2) — the copies were supplied in the way and by the day required` FALSE FALSE (YMD 2027 2 27) (YMD 2027 2 28))
-- 13(3) and (4): electronic with consent, or without it unless precluded.
#ASSERT `reg 13(3) and (4) — the person may supply the employee's portion in an electronic format` TRUE TRUE
#ASSERT `reg 13(3) and (4) — the person may supply the employee's portion in an electronic format` TRUE FALSE
#ASSERT `reg 13(3) and (4) — the person may supply the employee's portion in an electronic format` FALSE FALSE
#ASSERT NOT (`reg 13(3) and (4) — the person may supply the employee's portion in an electronic format` FALSE TRUE)
-- How many copies: a single copy only when it goes electronically and may; otherwise two.
#ASSERT `reg 13 — the number of copies the employee must be given` TRUE TRUE TRUE EQUALS JUST 1
#ASSERT `reg 13 — the number of copies the employee must be given` TRUE TRUE FALSE EQUALS JUST 2
#ASSERT `reg 13 — the number of copies the employee must be given` TRUE FALSE TRUE EQUALS JUST 2
#ASSERT `reg 13 — the number of copies the employee must be given` FALSE TRUE TRUE EQUALS NOTHING

§§ `Regulation 14: penalties`

-- $10 for each day of default, but not more than $250 in all.
#ASSERT `reg 14 — the amount of the penalty for a number of days of default` 0 EQUALS 0
#ASSERT `reg 14 — the amount of the penalty for a number of days of default` 1 EQUALS 10
#ASSERT `reg 14 — the amount of the penalty for a number of days of default` 24 EQUALS 240
#ASSERT `reg 14 — the amount of the penalty for a number of days of default` 25 EQUALS 250
#ASSERT `reg 14 — the amount of the penalty for a number of days of default` 26 EQUALS 250
#ASSERT `reg 14 — the amount of the penalty for a number of days of default` 400 EQUALS 250
#ASSERT `reg 14 — the amount of the penalty for a number of days of default` (0 MINUS 3) EQUALS 0
-- Days of default: from the due day to the day done. 28 February to 5 March 2027 is 5 days.
#ASSERT `reg 14 — the number of days of default` (YMD 2027 2 28) (YMD 2027 3 5) EQUALS 5
#ASSERT `reg 14 — the number of days of default` (YMD 2027 2 28) (YMD 2027 2 28) EQUALS 0
#ASSERT `reg 14 — the number of days of default` (YMD 2027 2 28) (YMD 2027 2 20) EQUALS 0
#ASSERT `reg 14(1) — the penalty for failing to file a return as and when required` TRUE 5 EQUALS JUST 50
#ASSERT `reg 14(1) — the penalty for failing to file a return as and when required` TRUE 40 EQUALS JUST 250
#ASSERT `reg 14(1) — the penalty for failing to file a return as and when required` FALSE 5 EQUALS NOTHING
#ASSERT `reg 14(2) — the penalty for failing to comply with section 13` TRUE 5 EQUALS JUST 50
#ASSERT `reg 14(2) — the penalty for failing to comply with section 13` FALSE 5 EQUALS NOTHING
