IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-definitions`

-- Tests for cpp-core-definitions.l4 (section 2(1)). Every expected value is worked out by hand from
-- the definition's own words. A comment says what the case shows.

§ `Tests of section 2(1)`

§§ `applicant (Part II)`

-- Limb (a): a person or estate that has applied for a benefit.
#ASSERT `s 2(1) — an applicant, in Part II` TRUE FALSE FALSE
-- Limb (b): a person who has applied for a division of unadjusted pensionable earnings.
#ASSERT `s 2(1) — an applicant, in Part II` FALSE TRUE FALSE
-- Limb (c): a person in respect of whom a division has been approved.
#ASSERT `s 2(1) — an applicant, in Part II` FALSE FALSE TRUE
-- None of the three limbs: not an applicant.
#ASSERT NOT (`s 2(1) — an applicant, in Part II` FALSE FALSE FALSE)

§§ `beneficiary`

-- A benefit has become payable to the person, estate or other body.
#ASSERT `s 2(1) — a beneficiary` TRUE
-- No benefit has become payable.
#ASSERT NOT (`s 2(1) — a beneficiary` FALSE)

§§ `contributor`

-- Made an employee's contribution.
#ASSERT `s 2(1) — a contributor` TRUE FALSE EMPTY FALSE
-- Made a contribution on own self-employed earnings.
#ASSERT `s 2(1) — a contributor` FALSE TRUE EMPTY FALSE
-- Included: earnings contributed on for a year, as in 53(1)(b)(i), exceed zero in one year of two.
#ASSERT `s 2(1) — a contributor` FALSE FALSE (LIST 0, 1500) FALSE
-- Zero in every year does not "exceed zero".
#ASSERT NOT (`s 2(1) — a contributor` FALSE FALSE (LIST 0, 0) FALSE)
-- Included: unadjusted pensionable earnings attributed under section 55, 55.1 or 55.2.
#ASSERT `s 2(1) — a contributor` FALSE FALSE EMPTY TRUE
-- None of the four: not a contributor.
#ASSERT NOT (`s 2(1) — a contributor` FALSE FALSE EMPTY FALSE)

§§ `representative`

-- Listed capacity: a guardian.
#ASSERT `s 2(1) — a representative of a person` `a guardian`
-- Listed capacity: a curator.
#ASSERT `s 2(1) — a representative of a person` `a curator`
-- Listed capacity: a committee.
#ASSERT `s 2(1) — a representative of a person` `a committee`
-- Listed capacity: an executor.
#ASSERT `s 2(1) — a representative of a person` `an executor`
-- Listed capacity: a liquidator of a succession.
#ASSERT `s 2(1) — a representative of a person` `a liquidator of a succession`
-- Listed capacity: an administrator.
#ASSERT `s 2(1) — a representative of a person` `an administrator`
-- Listed capacity: another legal representative.
#ASSERT `s 2(1) — a representative of a person` `another legal representative`
-- Not acting in any listed capacity.
#ASSERT NOT (`s 2(1) — a representative of a person` `not a representative`)

§§ `employment, employee, employer`

-- The state of being employed under a contract of service or apprenticeship.
#ASSERT `s 2(1) — employment` TRUE FALSE
-- Includes the tenure of an office.
#ASSERT `s 2(1) — employment` FALSE TRUE
-- Neither.
#ASSERT NOT (`s 2(1) — employment` FALSE FALSE)
-- In employment.
#ASSERT `s 2(1) — an employee` TRUE FALSE
-- Employee includes an officer.
#ASSERT `s 2(1) — an employee` FALSE TRUE
-- Neither in employment nor an officer.
#ASSERT NOT (`s 2(1) — an employee` FALSE FALSE)
-- Liable to pay salary, wages or other remuneration in relation to employment.
#ASSERT `s 2(1) — an employer` TRUE FALSE FALSE
-- In relation to an officer, includes the person from whom the officer receives their remuneration.
#ASSERT `s 2(1) — an employer` FALSE TRUE TRUE
-- The other is an officer but this person does not pay the officer.
#ASSERT NOT (`s 2(1) — an employer` FALSE TRUE FALSE)
-- The inclusion applies only in relation to an officer.
#ASSERT NOT (`s 2(1) — an employer` FALSE FALSE TRUE)

§§ `office and officer`

-- Listed, so an office even with no fixed or ascertainable stipend: a judicial office.
#ASSERT `s 2(1) — an office` `a judicial office` FALSE
-- Listed, so an office even with no fixed or ascertainable stipend: the office of a minister of the Crown.
#ASSERT `s 2(1) — an office` `the office of a minister of the Crown` FALSE
-- Listed, so an office even with no fixed or ascertainable stipend: the office of a lieutenant governor.
#ASSERT `s 2(1) — an office` `the office of a lieutenant governor` FALSE
-- Listed, so an office even with no fixed or ascertainable stipend: the office of a member of the Senate or House of Commons.
#ASSERT `s 2(1) — an office` `the office of a member of the Senate or House of Commons` FALSE
-- Listed, so an office even with no fixed or ascertainable stipend: the office of a member of a legislative assembly.
#ASSERT `s 2(1) — an office` `the office of a member of a legislative assembly` FALSE
-- Listed, so an office even with no fixed or ascertainable stipend: the office of a member of a legislative or executive council.
#ASSERT `s 2(1) — an office` `the office of a member of a legislative or executive council` FALSE
-- Listed, so an office even with no fixed or ascertainable stipend: an office whose incumbent is elected by popular vote.
#ASSERT `s 2(1) — an office` `an office whose incumbent is elected by popular vote` FALSE
-- Listed, so an office even with no fixed or ascertainable stipend: an office whose incumbent is elected or appointed in a representative capacity.
#ASSERT `s 2(1) — an office` `an office whose incumbent is elected or appointed in a representative capacity` FALSE
-- Listed, so an office even with no fixed or ascertainable stipend: the position of a corporation director.
#ASSERT `s 2(1) — an office` `the position of a corporation director` FALSE
-- Any other position with a fixed or ascertainable stipend or remuneration.
#ASSERT `s 2(1) — an office` `another position` TRUE
-- Any other position with no stipend: not an office.
#ASSERT NOT (`s 2(1) — an office` `another position` FALSE)
-- Holds a listed office.
#ASSERT `s 2(1) — an officer` TRUE `a judicial office` FALSE
-- A listed office that the person does not hold.
#ASSERT NOT (`s 2(1) — an officer` FALSE `a judicial office` FALSE)
-- Holds a position that is not an office.
#ASSERT NOT (`s 2(1) — an officer` TRUE `another position` FALSE)
-- Holds a position with a fixed stipend: an office.
#ASSERT `s 2(1) — an officer` TRUE `another position` TRUE

§§ `business`

-- Listed: a profession.
#ASSERT `s 2(1) — a business` `a profession` EQUALS (JUST TRUE)
-- Listed: a calling.
#ASSERT `s 2(1) — a business` `a calling` EQUALS (JUST TRUE)
-- Listed: a trade.
#ASSERT `s 2(1) — a business` `a trade` EQUALS (JUST TRUE)
-- Listed: a manufacture.
#ASSERT `s 2(1) — a business` `a manufacture` EQUALS (JUST TRUE)
-- Listed: an undertaking of any kind whatever.
#ASSERT `s 2(1) — a business` `an undertaking of any kind whatever` EQUALS (JUST TRUE)
-- Listed: an adventure or concern in the nature of trade.
#ASSERT `s 2(1) — a business` `an adventure or concern in the nature of trade` EQUALS (JUST TRUE)
-- Expressly excluded.
#ASSERT `s 2(1) — a business` `an office` EQUALS (JUST FALSE)
-- Expressly excluded.
#ASSERT `s 2(1) — a business` `an employment` EQUALS (JUST FALSE)
-- "Includes" does not exhaust the meaning; the text does not decide, so not covered.
#ASSERT `s 2(1) — a business` `another activity` EQUALS NOTHING

§§ `benefit, pension, contribution, Social Insurance Number`

-- benefit: the condition holds.
#ASSERT `s 2(1) — a benefit` TRUE
-- benefit: the condition does not hold.
#ASSERT NOT (`s 2(1) — a benefit` FALSE)
-- pension: the condition holds.
#ASSERT `s 2(1) — a pension` TRUE
-- pension: the condition does not hold.
#ASSERT NOT (`s 2(1) — a pension` FALSE)
-- contribution: the condition holds.
#ASSERT `s 2(1) — a contribution` TRUE
-- contribution: the condition does not hold.
#ASSERT NOT (`s 2(1) — a contribution` FALSE)
-- Social Insurance Number: the condition holds.
#ASSERT `s 2(1) — a Social Insurance Number` TRUE
-- Social Insurance Number: the condition does not hold.
#ASSERT NOT (`s 2(1) — a Social Insurance Number` FALSE)
-- Social Insurance Number Card: the condition holds.
#ASSERT `s 2(1) — a Social Insurance Number Card` TRUE
-- Social Insurance Number Card: the condition does not hold.
#ASSERT NOT (`s 2(1) — a Social Insurance Number Card` FALSE)

§§ `base, first additional and second additional contribution`

-- A contribution under subsection 8(1) is a base contribution.
#ASSERT `s 2(1) — the tier of a contribution made under a subsection` "8(1)" EQUALS (JUST `the base tier`)
-- A contribution under subsection 9(1) is a base contribution.
#ASSERT `s 2(1) — the tier of a contribution made under a subsection` "9(1)" EQUALS (JUST `the base tier`)
-- A contribution under subsection 10(1) is a base contribution.
#ASSERT `s 2(1) — the tier of a contribution made under a subsection` "10(1)" EQUALS (JUST `the base tier`)
-- A contribution under subsection 8(1.1) is a first additional contribution.
#ASSERT `s 2(1) — the tier of a contribution made under a subsection` "8(1.1)" EQUALS (JUST `the first additional tier`)
-- A contribution under subsection 9(1.1) is a first additional contribution.
#ASSERT `s 2(1) — the tier of a contribution made under a subsection` "9(1.1)" EQUALS (JUST `the first additional tier`)
-- A contribution under subsection 10(1.1) is a first additional contribution.
#ASSERT `s 2(1) — the tier of a contribution made under a subsection` "10(1.1)" EQUALS (JUST `the first additional tier`)
-- A contribution under subsection 8(1.2) is a second additional contribution.
#ASSERT `s 2(1) — the tier of a contribution made under a subsection` "8(1.2)" EQUALS (JUST `the second additional tier`)
-- A contribution under subsection 9(1.2) is a second additional contribution.
#ASSERT `s 2(1) — the tier of a contribution made under a subsection` "9(1.2)" EQUALS (JUST `the second additional tier`)
-- A contribution under subsection 10(1.2) is a second additional contribution.
#ASSERT `s 2(1) — the tier of a contribution made under a subsection` "10(1.2)" EQUALS (JUST `the second additional tier`)
-- Subsection 8(2) is none of the nine.
#ASSERT `s 2(1) — the tier of a contribution made under a subsection` "8(2)" EQUALS NOTHING
-- Section 11 is none of the nine.
#ASSERT `s 2(1) — the tier of a contribution made under a subsection` "11(1)" EQUALS NOTHING
-- the base tier, employee: subsection 8(1).
#ASSERT `s 2(1) — the subsection that imposes a contribution of a tier and capacity` `the base tier` `contributing as an employee` EQUALS "8(1)"
-- the first additional tier, employee: subsection 8(1.1).
#ASSERT `s 2(1) — the subsection that imposes a contribution of a tier and capacity` `the first additional tier` `contributing as an employee` EQUALS "8(1.1)"
-- the second additional tier, employee: subsection 8(1.2).
#ASSERT `s 2(1) — the subsection that imposes a contribution of a tier and capacity` `the second additional tier` `contributing as an employee` EQUALS "8(1.2)"
-- the base tier, employer: subsection 9(1).
#ASSERT `s 2(1) — the subsection that imposes a contribution of a tier and capacity` `the base tier` `contributing as an employer` EQUALS "9(1)"
-- the first additional tier, employer: subsection 9(1.1).
#ASSERT `s 2(1) — the subsection that imposes a contribution of a tier and capacity` `the first additional tier` `contributing as an employer` EQUALS "9(1.1)"
-- the second additional tier, employer: subsection 9(1.2).
#ASSERT `s 2(1) — the subsection that imposes a contribution of a tier and capacity` `the second additional tier` `contributing as an employer` EQUALS "9(1.2)"
-- the base tier, self-employed person: subsection 10(1).
#ASSERT `s 2(1) — the subsection that imposes a contribution of a tier and capacity` `the base tier` `contributing as a self-employed person` EQUALS "10(1)"
-- the first additional tier, self-employed person: subsection 10(1.1).
#ASSERT `s 2(1) — the subsection that imposes a contribution of a tier and capacity` `the first additional tier` `contributing as a self-employed person` EQUALS "10(1.1)"
-- the second additional tier, self-employed person: subsection 10(1.2).
#ASSERT `s 2(1) — the subsection that imposes a contribution of a tier and capacity` `the second additional tier` `contributing as a self-employed person` EQUALS "10(1.2)"

§§ `unadjusted pensionable earnings`

-- The base amount of a record with three amounts.
#ASSERT `s 2(1) — the unadjusted pensionable earnings of a tier` (`Unadjusted pensionable earnings` WITH `base unadjusted pensionable earnings` IS 50000, `first additional unadjusted pensionable earnings` IS 7000, `second additional unadjusted pensionable earnings` IS 900) `the base tier` EQUALS 50000
-- The first additional amount.
#ASSERT `s 2(1) — the unadjusted pensionable earnings of a tier` (`Unadjusted pensionable earnings` WITH `base unadjusted pensionable earnings` IS 50000, `first additional unadjusted pensionable earnings` IS 7000, `second additional unadjusted pensionable earnings` IS 900) `the first additional tier` EQUALS 7000
-- The second additional amount.
#ASSERT `s 2(1) — the unadjusted pensionable earnings of a tier` (`Unadjusted pensionable earnings` WITH `base unadjusted pensionable earnings` IS 50000, `first additional unadjusted pensionable earnings` IS 7000, `second additional unadjusted pensionable earnings` IS 900) `the second additional tier` EQUALS 900

§§ `year`

-- A year is a calendar year.
#ASSERT `s 2(1) — the year that contains a date` (YearMonthDay 2026 3 17) EQUALS 2026
-- The calendar year begins on 1 January.
#ASSERT `s 2(1) — the first day of a year` 2026 EQUALS (YearMonthDay 2026 1 1)
-- The calendar year ends on 31 December.
#ASSERT `s 2(1) — the last day of a year` 2026 EQUALS (YearMonthDay 2026 12 31)

§§ `balance-due day`

-- Alive: case (b), April 30 of the following year.
#ASSERT `s 2(1) — the balance-due day of a person for a year` 2025 NOTHING EQUALS (YearMonthDay 2026 4 30)
-- Died on the last day of October: not "after October", so case (b).
#ASSERT `s 2(1) — the balance-due day of a person for a year` 2025 (JUST (YearMonthDay 2025 10 31)) EQUALS (YearMonthDay 2026 4 30)
-- Died on 1 November: case (a), six months later is 1 May 2026.
#ASSERT `s 2(1) — the balance-due day of a person for a year` 2025 (JUST (YearMonthDay 2025 11 1)) EQUALS (YearMonthDay 2026 5 1)
-- Died 30 November: six months later is 30 May 2026.
#ASSERT `s 2(1) — the balance-due day of a person for a year` 2025 (JUST (YearMonthDay 2025 11 30)) EQUALS (YearMonthDay 2026 5 30)
-- Died 31 December: no 31 June, so 30 June 2026 (assumed month-end clamp, fork F1).
#ASSERT `s 2(1) — the balance-due day of a person for a year` 2025 (JUST (YearMonthDay 2025 12 31)) EQUALS (YearMonthDay 2026 6 30)
-- Died in January of the following year: case (a).
#ASSERT `s 2(1) — the balance-due day of a person for a year` 2025 (JUST (YearMonthDay 2026 1 15)) EQUALS (YearMonthDay 2026 7 15)
-- Died 31 March: no 31 September, so 30 September 2026 (assumed month-end clamp, fork F1).
#ASSERT `s 2(1) — the balance-due day of a person for a year` 2025 (JUST (YearMonthDay 2026 3 31)) EQUALS (YearMonthDay 2026 9 30)
-- Died on 30 April, the last day "before May": case (a).
#ASSERT `s 2(1) — the balance-due day of a person for a year` 2025 (JUST (YearMonthDay 2026 4 30)) EQUALS (YearMonthDay 2026 10 30)
-- Died on 1 May: not "before May", so case (b); the day is already past.
#ASSERT `s 2(1) — the balance-due day of a person for a year` 2025 (JUST (YearMonthDay 2026 5 1)) EQUALS (YearMonthDay 2026 4 30)
-- Died earlier in the year (June): case (b).
#ASSERT `s 2(1) — the balance-due day of a person for a year` 2025 (JUST (YearMonthDay 2025 6 15)) EQUALS (YearMonthDay 2026 4 30)
-- A different year: death on 28 February 2025 falls in the window for 2024, so six months on is 28 August 2025.
#ASSERT `s 2(1) — the balance-due day of a person for a year` 2024 (JUST (YearMonthDay 2025 2 28)) EQUALS (YearMonthDay 2025 8 28)

§§ `common-law partner`

-- Cohabiting, and exactly one year has passed since the cohabitation began.
#ASSERT `s 2(1) — a common-law partner of a contributor at a relevant time` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 1)
-- One day short of a year.
#ASSERT NOT (`s 2(1) — a common-law partner of a contributor at a relevant time` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 2 28))
-- Lived together long ago but not cohabiting at the relevant time.
#ASSERT NOT (`s 2(1) — a common-law partner of a contributor at a relevant time` FALSE (YearMonthDay 2020 1 1) (YearMonthDay 2026 3 1))
-- Cohabiting for over six years.
#ASSERT `s 2(1) — a common-law partner of a contributor at a relevant time` TRUE (YearMonthDay 2020 1 1) (YearMonthDay 2026 3 1)
-- At a contributor's death the relevant time is the date of death: one year exactly.
#ASSERT `s 2(1) — a common-law partner of a contributor at the contributor's death` TRUE (YearMonthDay 2025 3 1) (YearMonthDay 2026 3 1)
-- Death one day short of a year of cohabitation.
#ASSERT NOT (`s 2(1) — a common-law partner of a contributor at the contributor's death` TRUE (YearMonthDay 2025 3 2) (YearMonthDay 2026 3 1))
-- Not cohabiting at the time of death.
#ASSERT NOT (`s 2(1) — a common-law partner of a contributor at the contributor's death` FALSE (YearMonthDay 2020 1 1) (YearMonthDay 2026 3 1))

§§ `prescribed`

-- Form: authorized by the Minister administering the Part.
#ASSERT `s 2(1) — prescribed` `a form or the information to be given on a form` TRUE FALSE FALSE
-- Form: a regulation or rules do not make a form prescribed; only the Minister's authorization does.
#ASSERT NOT (`s 2(1) — prescribed` `a form or the information to be given on a form` FALSE TRUE TRUE)
-- Other matter: prescribed by regulation.
#ASSERT `s 2(1) — prescribed` `any other matter` FALSE TRUE FALSE
-- Other matter: determined in accordance with rules prescribed by regulation.
#ASSERT `s 2(1) — prescribed` `any other matter` FALSE FALSE TRUE
-- Other matter: the Minister's authorization is not enough.
#ASSERT NOT (`s 2(1) — prescribed` `any other matter` TRUE FALSE FALSE)
-- Other matter: neither.
#ASSERT NOT (`s 2(1) — prescribed` `any other matter` FALSE FALSE FALSE)
