#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `plain person 1980` 68_500 EQUALS JUST 68_500   -- no event in the year
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person reaching 18 on 10 March 2024` 68_500 EQUALS JUST 51_375   -- (a): 9 months (April to December) of 12 ; 68,500 x 9/12
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person reaching 70 on 20 August 2024` 68_500 EQUALS JUST (137_000 DIVIDED BY 3)   -- (a): 8 months (January to August) ; 68,500 x 8/12
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person who dies on 15 June 2024` 68_500 EQUALS JUST 34_250   -- (a): 6 months (January to June), the month of death included
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person whose contributory period ends on 10 May 2024` 68_500 EQUALS JUST (85_625 DIVIDED BY 3)   -- (a): 5 months (January to May) ; 68,500 x 5/12
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person whose disability pension ceases on 20 September 2024` 68_500 EQUALS JUST 17_125   -- (a): 3 months (October to December)
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person with a pension ceasing in March and a period ending in September 2024` 68_500 EQUALS JUST 34_250   -- (a): April to September, 6 months
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person born 20 August 1954 who dies on 15 June 2024` 68_500 EQUALS JUST 34_250   -- (a): before the 70th birthday month (August) and before death (June): the shorter, 6 months
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person aged 66 who makes a 12(1)(c)(ii) election on 12 June 2024` 68_500 EQUALS JUST 34_250   -- (b): 6 months before the election takes effect on 1 July
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `same person with January and February 2024 excluded by disability` 68_500 EQUALS JUST (68_500 DIVIDED BY 3)   -- (b): (6 - 2) months of 12
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person with a 13(1)(b) election deemed made on 1 July 2024` 68_500 EQUALS JUST 34_250   -- (b): 6 months before 1 July
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person aged 66 who revokes a 12(1)(c)(ii) election on 20 March 2024` 68_500 EQUALS JUST 51_375   -- (c): 9 months from 1 April, less 0 after 70
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person aged 70 who revokes a 12(1)(c)(ii) election on 20 March 2024` 68_500 EQUALS JUST 0   -- (c): 9 months less the 10 months after the actual 70th birthday, below zero taken as none
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person who dies on 15 June 2024 after revoking an election on 10 February` 68_500 EQUALS JUST (68_500 DIVIDED BY 3)   -- (c): 10 months from 1 March less the 6 months after the death (July to December)
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person with a 13(1)(c) revocation deemed on 1 October 2024` 68_500 EQUALS JUST 17_125   -- (c): 3 months (October to December)
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year` `person with two election events in 2024` 68_500 EQUALS NOTHING   -- a 12(1)(c)(ii) election made and a 13(1)(c) revocation in one year: not covered
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year, determined without taking into account paragraphs (b) and (c)` `person aged 66 who makes a 12(1)(c)(ii) election on 12 June 2024` 68_500 EQUALS JUST 68_500   -- paragraphs (b) and (c) left out: nothing else happens in the year
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year, determined without taking into account paragraphs (b) and (c)` `person aged 66 who revokes a 12(1)(c)(ii) election on 20 March 2024` 68_500 EQUALS JUST 68_500
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year, determined without taking into account paragraphs (b) and (c)` `person with two election events in 2024` 68_500 EQUALS JUST 68_500   -- the election events do not matter when (b) and (c) are left out
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year, determined without taking into account paragraphs (b) and (c)` `person reaching 18 on 10 March 2024` 68_500 EQUALS JUST 51_375   -- (a) still applies
#ASSERT `s 17 — the maximum pensionable earnings of a person for a year, determined without taking into account paragraphs (b) and (c)` `person who dies on 15 June 2024 after revoking an election on 10 February` 68_500 EQUALS JUST 34_250   -- (a): death in the year, 6 months
#ASSERT `s 17.1 — the additional maximum pensionable earnings of a person for a year` `plain person 1980` 73_200 EQUALS JUST 73_200
#ASSERT `s 17.1 — the additional maximum pensionable earnings of a person for a year` `person reaching 18 on 10 March 2024` 73_200 EQUALS JUST 54_900
#ASSERT `s 17.1 — the additional maximum pensionable earnings of a person for a year` `person who dies on 15 June 2024` 73_200 EQUALS JUST 36_600
#ASSERT `s 17.1 — the additional maximum pensionable earnings of a person for a year` `person aged 66 who makes a 12(1)(c)(ii) election on 12 June 2024` 73_200 EQUALS JUST 36_600
#ASSERT `s 17.1 — the additional maximum pensionable earnings of a person for a year` `person aged 70 who revokes a 12(1)(c)(ii) election on 20 March 2024` 73_200 EQUALS JUST 0
#ASSERT `s 17.1 — the additional maximum pensionable earnings of a person for a year` `person with two election events in 2024` 73_200 EQUALS NOTHING
#ASSERT `s 17.1 — the additional maximum pensionable earnings of a person for a year, determined without taking into account paragraphs (b) and (c)` `person aged 66 who makes a 12(1)(c)(ii) election on 12 June 2024` 73_200 EQUALS JUST 73_200
#ASSERT `s 17.1 — the additional maximum pensionable earnings of a person for a year, determined without taking into account paragraphs (b) and (c)` `person with two election events in 2024` 73_200 EQUALS JUST 73_200

§ `Tests -- section 19: the basic exemption`
#ASSERT `s 19 — the basic exemption of a person for a year` `plain person 1980` 3_500 68_500 0 EQUALS JUST 3_500
#ASSERT `s 19 — the basic exemption of a person for a year` `person reaching 18 on 10 March 2024` 3_500 68_500 0 EQUALS JUST 2_625
#ASSERT `s 19 — the basic exemption of a person for a year` `person reaching 70 on 20 August 2024` 3_500 68_500 0 EQUALS JUST (7_000 DIVIDED BY 3)
#ASSERT `s 19 — the basic exemption of a person for a year` `person who dies on 15 June 2024` 3_500 68_500 0 EQUALS JUST 1_750
#ASSERT `s 19 — the basic exemption of a person for a year` `person aged 66 who makes a 12(1)(c)(ii) election on 12 June 2024` 3_500 68_500 0 EQUALS JUST 1_750
#ASSERT `s 19 — the basic exemption of a person for a year` `person aged 70 who revokes a 12(1)(c)(ii) election on 20 March 2024` 3_500 68_500 0 EQUALS JUST 0
#ASSERT `s 19 — the basic exemption of a person for a year` `person with a 13(1)(c) revocation deemed on 1 October 2024` 3_500 68_500 0 EQUALS JUST 875
#ASSERT `s 19 — the basic exemption of a person for a year` `person with two election events in 2024` 3_500 68_500 0 EQUALS NOTHING
#ASSERT `s 19 — the basic exemption of a person for a year, determined without taking into account paragraphs (b) and (c)` `person aged 66 who makes a 12(1)(c)(ii) election on 12 June 2024` 3_500 68_500 0 EQUALS JUST 3_500
#ASSERT `s 19 — the basic exemption of a person for a year, determined without taking into account paragraphs (b) and (c)` `person with two election events in 2024` 3_500 68_500 0 EQUALS JUST 3_500
