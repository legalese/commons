IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cr2-nouns`
IMPORT `cr2-payment-of-benefits`

-- Tests of cr2-payment-of-benefits.l4 (regulations 55 to 59). Layer 1.
-- Every expected value was decided by reading the regulations before the rules were run.

§ `Tests -- regulations 55 to 59`

§§ `55 -- payment on behalf of a beneficiary`

-- Arguments: Minister satisfied the beneficiary is incapable; satisfied the person or agency is authorized by law; none so authorized; the person or agency is approved.
#ASSERT `reg 55(1) — the Minister may direct that a benefit be paid on behalf of a beneficiary to a person or agency` TRUE TRUE FALSE FALSE
#ASSERT `reg 55(1) — the Minister may direct that a benefit be paid on behalf of a beneficiary to a person or agency` TRUE FALSE TRUE TRUE
#ASSERT NOT (`reg 55(1) — the Minister may direct that a benefit be paid on behalf of a beneficiary to a person or agency` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`reg 55(1) — the Minister may direct that a benefit be paid on behalf of a beneficiary to a person or agency` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`reg 55(1) — the Minister may direct that a benefit be paid on behalf of a beneficiary to a person or agency` FALSE TRUE TRUE TRUE)
-- Arguments: undertook to administer and expend as the agreement says; undertook to furnish information and do what the Act requires.
#ASSERT `reg 55(2) — the benefit may be paid to the person or agency the Minister has directed` TRUE TRUE
#ASSERT NOT (`reg 55(2) — the benefit may be paid to the person or agency the Minister has directed` TRUE FALSE)
#ASSERT NOT (`reg 55(2) — the benefit may be paid to the person or agency the Minister has directed` FALSE TRUE)
#ASSERT `reg 55(3) — the person or agency must account to the Minister for the benefit payments received and the disbursements made` TRUE
#ASSERT NOT (`reg 55(3) — the person or agency must account to the Minister for the benefit payments received and the disbursements made` FALSE)

§§ `56 -- a benefit of less than $2 a month`

-- Arguments: the basic monthly amount; an Old Age Security pension is then payable to the person.
#ASSERT `reg 56 — the Minister may direct that the benefit be paid in arrears at intervals` 1.99 FALSE
#ASSERT `reg 56 — the Minister may direct that the benefit be paid in arrears at intervals` 0.5 FALSE
-- exactly $2 is not "less than $2"
#ASSERT NOT (`reg 56 — the Minister may direct that the benefit be paid in arrears at intervals` 2 FALSE)
#ASSERT NOT (`reg 56 — the Minister may direct that the benefit be paid in arrears at intervals` 1.99 TRUE)
#ASSERT `reg 56 — an interval the Minister specifies is not greater than yearly` 12
#ASSERT `reg 56 — an interval the Minister specifies is not greater than yearly` 1
#ASSERT NOT (`reg 56 — an interval the Minister specifies is not greater than yearly` 13)
#ASSERT NOT (`reg 56 — an interval the Minister specifies is not greater than yearly` 0)

§§ `57 -- who is paid a benefit unpaid at death`

-- Arguments: an amount is payable to the deceased; a returned payment; there is an estate.
#ASSERT `reg 57 — the payee of a benefit payment unpaid at death` TRUE FALSE TRUE EQUALS `the estate of the deceased beneficiary`
#ASSERT `reg 57 — the payee of a benefit payment unpaid at death` TRUE FALSE FALSE EQUALS `a person or agency designated by the Minister`
#ASSERT `reg 57 — the payee of a benefit payment unpaid at death` FALSE TRUE TRUE EQUALS `the estate of the deceased beneficiary`
#ASSERT `reg 57 — the payee of a benefit payment unpaid at death` FALSE TRUE FALSE EQUALS `a person or agency designated by the Minister`
#ASSERT `reg 57 — the payee of a benefit payment unpaid at death` TRUE TRUE FALSE EQUALS `a person or agency designated by the Minister`
-- neither paragraph (a) nor paragraph (b): the regulation pays nobody
#ASSERT `reg 57 — the payee of a benefit payment unpaid at death` FALSE FALSE TRUE EQUALS `nobody under regulation 57`
#ASSERT `reg 57 — the payee of a benefit payment unpaid at death` FALSE FALSE FALSE EQUALS `nobody under regulation 57`

§§ `58 -- single monthly payment`

#ASSERT `reg 58(1) — the Minister may direct that a single monthly payment be made` TRUE TRUE
#ASSERT NOT (`reg 58(1) — the Minister may direct that a single monthly payment be made` TRUE FALSE)
#ASSERT NOT (`reg 58(1) — the Minister may direct that a single monthly payment be made` FALSE TRUE)
#ASSERT `reg 58(2) — the portion of the payment is charged to the Canada Pension Plan Account` TRUE TRUE
#ASSERT NOT (`reg 58(2) — the portion of the payment is charged to the Canada Pension Plan Account` TRUE FALSE)
#ASSERT NOT (`reg 58(2) — the portion of the payment is charged to the Canada Pension Plan Account` FALSE TRUE)
#ASSERT `reg 58(2) — the amount remitted by the Government of Quebec is credited to the Canada Pension Plan Account` TRUE TRUE
#ASSERT NOT (`reg 58(2) — the amount remitted by the Government of Quebec is credited to the Canada Pension Plan Account` TRUE FALSE)
#ASSERT NOT (`reg 58(2) — the amount remitted by the Government of Quebec is credited to the Canada Pension Plan Account` FALSE TRUE)

§§ `59 -- withholding`

-- Notice given 1 January 2026: 30 days after is 31 January 2026.
#ASSERT `reg 59(1) — the earliest day payment of the benefit may be withheld` (YearMonthDay 2026 1 1) EQUALS (YearMonthDay 2026 1 31)
-- Notice given 15 February 2026: 30 days after is 17 March 2026.
#ASSERT `reg 59(1) — the earliest day payment of the benefit may be withheld` (YearMonthDay 2026 2 15) EQUALS (YearMonthDay 2026 3 17)
-- Arguments: evidence required; the Minister has requested it; not complied; Minister not satisfied; date of the notice; day withholding starts.
#ASSERT `reg 59(1) — the Minister may withhold payment of the benefit from a day` TRUE TRUE TRUE FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 31)
#ASSERT `reg 59(1) — the Minister may withhold payment of the benefit from a day` TRUE TRUE FALSE TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 2 15)
-- one day short of the 30 days
#ASSERT NOT (`reg 59(1) — the Minister may withhold payment of the benefit from a day` TRUE TRUE TRUE FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 30))
-- the beneficiary complied and the Minister is satisfied
#ASSERT NOT (`reg 59(1) — the Minister may withhold payment of the benefit from a day` TRUE TRUE FALSE FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 2 15))
#ASSERT NOT (`reg 59(1) — the Minister may withhold payment of the benefit from a day` TRUE FALSE TRUE TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 2 15))
#ASSERT NOT (`reg 59(1) — the Minister may withhold payment of the benefit from a day` FALSE TRUE TRUE TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 2 15))
-- Until the evidence is furnished AND the Minister is satisfied.
#ASSERT NOT (`reg 59(1) — payment of the benefit may still be withheld` TRUE TRUE)
#ASSERT `reg 59(1) — payment of the benefit may still be withheld` TRUE FALSE
#ASSERT `reg 59(1) — payment of the benefit may still be withheld` FALSE TRUE
#ASSERT `reg 59(1) — payment of the benefit may still be withheld` FALSE FALSE
#ASSERT `reg 59(2) — the benefit is paid for a day of the period of withholding` TRUE TRUE
#ASSERT NOT (`reg 59(2) — the benefit is paid for a day of the period of withholding` TRUE FALSE)
#ASSERT NOT (`reg 59(2) — the benefit is paid for a day of the period of withholding` FALSE TRUE)
