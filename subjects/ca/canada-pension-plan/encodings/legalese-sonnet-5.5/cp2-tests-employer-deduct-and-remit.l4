IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-definitions`
IMPORT `cp2-employer-deduct-and-remit`

-- Tests of cp2-employer-deduct-and-remit.l4 (Act sections 21, 21.01, 21.1).
-- Every expected value was decided by reading the section, then written down; none was copied from the
-- output of the rule. One assertion to a line.

§ `Tests -- employer deductions and remittances`

§§ `s 21(1) -- who must deduct, how much, and where to remit`

`a typical employee` MEANS `cp2 Employment relationship` WITH
    `payer is liable to pay salary, wages or other remuneration in relation to the employment` IS TRUE
    `payee is employed under an express or implied contract of service or apprenticeship` IS TRUE
    `payee holds an office` IS FALSE
    `payee, as an officer, receives their remuneration from the payer` IS FALSE
    `employment is pensionable employment` IS TRUE

`an employee in employment that is not pensionable` MEANS `cp2 Employment relationship` WITH
    `payer is liable to pay salary, wages or other remuneration in relation to the employment` IS TRUE
    `payee is employed under an express or implied contract of service or apprenticeship` IS TRUE
    `payee holds an office` IS FALSE
    `payee, as an officer, receives their remuneration from the payer` IS FALSE
    `employment is pensionable employment` IS FALSE

-- A payer who is not liable to pay the remuneration and does not pay an officer is not an "employer" (s 2(1)).
`a payer who is not an employer` MEANS `cp2 Employment relationship` WITH
    `payer is liable to pay salary, wages or other remuneration in relation to the employment` IS FALSE
    `payee is employed under an express or implied contract of service or apprenticeship` IS TRUE
    `payee holds an office` IS FALSE
    `payee, as an officer, receives their remuneration from the payer` IS FALSE
    `employment is pensionable employment` IS TRUE

-- "employer ... includes the person from whom the officer receives their remuneration" (s 2(1)).
`an officer paid by a payer not otherwise liable` MEANS `cp2 Employment relationship` WITH
    `payer is liable to pay salary, wages or other remuneration in relation to the employment` IS FALSE
    `payee is employed under an express or implied contract of service or apprenticeship` IS FALSE
    `payee holds an office` IS TRUE
    `payee, as an officer, receives their remuneration from the payer` IS TRUE
    `employment is pensionable employment` IS TRUE

`an officer not paid by the payer` MEANS `cp2 Employment relationship` WITH
    `payer is liable to pay salary, wages or other remuneration in relation to the employment` IS FALSE
    `payee is employed under an express or implied contract of service or apprenticeship` IS FALSE
    `payee holds an office` IS TRUE
    `payee, as an officer, receives their remuneration from the payer` IS FALSE
    `employment is pensionable employment` IS TRUE

#ASSERT `s 21(1) — the employer must deduct from the remuneration` `a typical employee` TRUE
#ASSERT NOT (`s 21(1) — the employer must deduct from the remuneration` `a typical employee` FALSE)
#ASSERT NOT (`s 21(1) — the employer must deduct from the remuneration` `an employee in employment that is not pensionable` TRUE)
#ASSERT NOT (`s 21(1) — the employer must deduct from the remuneration` `a payer who is not an employer` TRUE)
#ASSERT `s 21(1) — the employer must deduct from the remuneration` `an officer paid by a payer not otherwise liable` TRUE
#ASSERT NOT (`s 21(1) — the employer must deduct from the remuneration` `an officer not paid by the payer` TRUE)
#ASSERT `s 21(1) — the amount the employer must deduct` `a typical employee` TRUE 125.50 EQUALS 125.50
#ASSERT `s 21(1) — the amount the employer must deduct` `a typical employee` FALSE 125.50 EQUALS 0
#ASSERT `s 21(1) — the amount the employer must deduct` `an employee in employment that is not pensionable` TRUE 125.50 EQUALS 0
#ASSERT `s 21(1) — the amount the employer must remit` `a typical employee` TRUE 125.50 125.50 EQUALS 251
#ASSERT `s 21(1) — the amount the employer must remit` `a typical employee` FALSE 125.50 125.50 EQUALS 0
#ASSERT `s 21(1) — where the employer must remit` TRUE EQUALS `the amount is remitted to the account of the Receiver General at a financial institution`
#ASSERT `s 21(1) — where the employer must remit` FALSE EQUALS `the amount is remitted to the Receiver General`

§§ `s 21(1.1) -- a prescribed person who pays the Receiver General a day early`

-- "at least one day before the day on which the amount is due": the day before is early enough; the due day is not.
#ASSERT `s 21(1.1) — the prescribed person is deemed to have remitted to the account at a financial institution` TRUE (YMD 2026 1 14) (YMD 2026 1 15)
#ASSERT `s 21(1.1) — the prescribed person is deemed to have remitted to the account at a financial institution` TRUE (YMD 2026 1 1) (YMD 2026 1 15)
#ASSERT NOT (`s 21(1.1) — the prescribed person is deemed to have remitted to the account at a financial institution` TRUE (YMD 2026 1 15) (YMD 2026 1 15))
#ASSERT NOT (`s 21(1.1) — the prescribed person is deemed to have remitted to the account at a financial institution` TRUE (YMD 2026 1 16) (YMD 2026 1 15))
#ASSERT NOT (`s 21(1.1) — the prescribed person is deemed to have remitted to the account at a financial institution` FALSE (YMD 2026 1 14) (YMD 2026 1 15))
-- Month and year ends: 31 December is one day before 1 January.
#ASSERT `s 21(1.1) — the prescribed person is deemed to have remitted to the account at a financial institution` TRUE (YMD 2025 12 31) (YMD 2026 1 1)

-- The manner required (subsections (1) and (1.1) together).
#ASSERT `s 21(1) — the amount was remitted in the manner required` FALSE FALSE (YMD 2026 1 15) (YMD 2026 1 15)
#ASSERT `s 21(1) — the amount was remitted in the manner required` TRUE TRUE (YMD 2026 1 15) (YMD 2026 1 15)
#ASSERT `s 21(1) — the amount was remitted in the manner required` TRUE FALSE (YMD 2026 1 14) (YMD 2026 1 15)
#ASSERT NOT (`s 21(1) — the amount was remitted in the manner required` TRUE FALSE (YMD 2026 1 15) (YMD 2026 1 15))

§§ `s 21(2) and (3) -- liability, and the ruling that removes it`

#ASSERT `s 21(2) — the employer is liable to pay Her Majesty the whole amount` TRUE FALSE
#ASSERT NOT (`s 21(2) — the employer is liable to pay Her Majesty the whole amount` TRUE TRUE)
#ASSERT NOT (`s 21(2) — the employer is liable to pay Her Majesty the whole amount` FALSE FALSE)
#ASSERT NOT (`s 21(2) — the employer is liable to pay Her Majesty the whole amount` FALSE TRUE)
#ASSERT `s 21(2) — the amount the employer is liable to pay Her Majesty` TRUE FALSE 800 EQUALS 800
#ASSERT `s 21(2) — the amount the employer is liable to pay Her Majesty` TRUE TRUE 800 EQUALS 0
#ASSERT `s 21(2) — the amount the employer is liable to pay Her Majesty` FALSE FALSE 800 EQUALS 0
#ASSERT `s 21(2) — the time from which the liability to pay runs` (YMD 2026 3 31) EQUALS YMD 2026 3 31

-- (3): all three of (a), (b) and (c) are needed; (b) is a negative.
#ASSERT `s 21(3) — the employer is not liable for the amount it failed to deduct, or for interest or penalties` TRUE FALSE TRUE
#ASSERT NOT (`s 21(3) — the employer is not liable for the amount it failed to deduct, or for interest or penalties` FALSE FALSE TRUE)
#ASSERT NOT (`s 21(3) — the employer is not liable for the amount it failed to deduct, or for interest or penalties` TRUE TRUE TRUE)
#ASSERT NOT (`s 21(3) — the employer is not liable for the amount it failed to deduct, or for interest or penalties` TRUE FALSE FALSE)

-- (3.1): after the decision is communicated the employer owes the employer's own contribution, with no interest or penalties.
#ASSERT `s 21(3.1) — the employer is liable, without interest or penalties, to pay the contribution required of the employer` TRUE TRUE
#ASSERT NOT (`s 21(3.1) — the employer is liable, without interest or penalties, to pay the contribution required of the employer` TRUE FALSE)
#ASSERT NOT (`s 21(3.1) — the employer is liable, without interest or penalties, to pay the contribution required of the employer` FALSE TRUE)
#ASSERT `s 21(3.1) — the contribution the employer must pay, without interest or penalties` TRUE TRUE 300 EQUALS 300
#ASSERT `s 21(3.1) — the contribution the employer must pay, without interest or penalties` TRUE FALSE 300 EQUALS 0
#ASSERT `s 21(3.1) — the employee is deemed to have notified the Minister of the employer's failure to deduct` TRUE TRUE TRUE
#ASSERT NOT (`s 21(3.1) — the employee is deemed to have notified the Minister of the employer's failure to deduct` TRUE TRUE FALSE)
#ASSERT NOT (`s 21(3.1) — the employee is deemed to have notified the Minister of the employer's failure to deduct` TRUE FALSE TRUE)

§§ `s 21(4) and (5) -- a later deduction, and the deemed receipt`

-- 12 months after 15 January 2026 ends on 15 January 2027, and that day is inside the limit.
#ASSERT `s 21(4) — the employer may deduct the missed amount from a subsequent payment of remuneration` TRUE (YMD 2026 1 15) (YMD 2027 1 15) 1
#ASSERT NOT (`s 21(4) — the employer may deduct the missed amount from a subsequent payment of remuneration` TRUE (YMD 2026 1 15) (YMD 2027 1 16) 1)
#ASSERT `s 21(4) — the employer may deduct the missed amount from a subsequent payment of remuneration` TRUE (YMD 2026 1 15) (YMD 2026 1 15) 1
#ASSERT NOT (`s 21(4) — the employer may deduct the missed amount from a subsequent payment of remuneration` TRUE (YMD 2026 1 15) (YMD 2026 1 14) 1)
-- Not more than one earlier missed amount in the one payment.
#ASSERT NOT (`s 21(4) — the employer may deduct the missed amount from a subsequent payment of remuneration` TRUE (YMD 2026 1 15) (YMD 2026 6 15) 2)
#ASSERT NOT (`s 21(4) — the employer may deduct the missed amount from a subsequent payment of remuneration` FALSE (YMD 2026 1 15) (YMD 2026 6 15) 1)
-- Month-end (fork F1 of the keel: month arithmetic clamps to the last day of a shorter month).
-- A payment on 29 February 2028 plus 12 months is 28 February 2029, not 1 March 2029.
#ASSERT `s 21(4) — the employer may deduct the missed amount from a subsequent payment of remuneration` TRUE (YMD 2028 2 29) (YMD 2029 2 28) 1
#ASSERT NOT (`s 21(4) — the employer may deduct the missed amount from a subsequent payment of remuneration` TRUE (YMD 2028 2 29) (YMD 2029 3 1) 1)

#ASSERT `s 21(5) — the employee is deemed to have received the amount deducted` TRUE
#ASSERT NOT (`s 21(5) — the employee is deemed to have received the amount deducted` FALSE)
#ASSERT `s 21(5) — the time at which the employee is deemed to have received the amount` (YMD 2026 5 29) EQUALS YMD 2026 5 29

§§ `s 21(6) -- interest on an amount not remitted`

-- 10,000 at 5% a year for the 73 days from 1 January to 15 March 2026 is 10,000 x 0.05 x 73 / 365 = 100.
#ASSERT `s 21(6) — the interest the employer must pay the Receiver General` 10000 (YMD 2026 1 1) (YMD 2026 3 15) 5% EQUALS 100
#ASSERT `s 21(6) — the interest the employer must pay the Receiver General` 10000 (YMD 2026 1 1) (YMD 2027 1 1) 5% EQUALS 500
-- Remitted on the required day or before it: no days run.
#ASSERT `s 21(6) — the interest the employer must pay the Receiver General` 10000 (YMD 2026 1 1) (YMD 2026 1 1) 5% EQUALS 0
#ASSERT `s 21(6) — the interest the employer must pay the Receiver General` 10000 (YMD 2026 1 15) (YMD 2026 1 1) 5% EQUALS 0

§§ `s 21(7) -- the penalty for failing to remit`

-- The amount was due on 15 January 2026. Each row is a day of receipt against the 3 / 5 / 7 / 10 per cent bands.
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 15)) TRUE FALSE FALSE EQUALS 0
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 15)) FALSE FALSE FALSE EQUALS 3%
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 10)) FALSE FALSE FALSE EQUALS 3%
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 16)) TRUE FALSE FALSE EQUALS 3%
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 18)) TRUE FALSE FALSE EQUALS 3%
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 19)) TRUE FALSE FALSE EQUALS 5%
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 20)) TRUE FALSE FALSE EQUALS 5%
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 21)) TRUE FALSE FALSE EQUALS 7%
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 22)) TRUE FALSE FALSE EQUALS 7%
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 23)) TRUE FALSE FALSE EQUALS 10%
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) NOTHING TRUE FALSE FALSE EQUALS 10%
-- (b) wins over (a): an earlier penalty in the year, and a knowing or grossly negligent failure.
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 16)) TRUE TRUE TRUE EQUALS 20%
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) NOTHING TRUE TRUE TRUE EQUALS 20%
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 16)) TRUE TRUE FALSE EQUALS 3%
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 16)) TRUE FALSE TRUE EQUALS 3%
-- (b) needs a failure: a timely remittance in the manner required attracts nothing, however careless the history.
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 15)) TRUE TRUE TRUE EQUALS 0
#ASSERT `s 21(7) — the employer failed to remit the amount at the time required` (YMD 2026 1 15) NOTHING TRUE
#ASSERT NOT (`s 21(7) — the employer failed to remit the amount at the time required` (YMD 2026 1 15) (JUST (YMD 2026 1 15)) TRUE)
#ASSERT `s 21(7) — the employer failed to remit the amount at the time required` (YMD 2026 1 15) (JUST (YMD 2026 1 15)) FALSE
#ASSERT `s 21(7) — the employer failed to remit the amount at the time required` (YMD 2026 1 15) (JUST (YMD 2026 1 16)) TRUE
-- The amount of the penalty is the rate on the amount required to be remitted.
#ASSERT `s 21(7) — the penalty for failing to remit` 10000 (YMD 2026 1 15) (JUST (YMD 2026 1 15)) FALSE FALSE FALSE EQUALS 300
#ASSERT `s 21(7) — the penalty for failing to remit` 10000 (YMD 2026 1 15) (JUST (YMD 2026 1 20)) TRUE FALSE FALSE EQUALS 500
#ASSERT `s 21(7) — the penalty for failing to remit` 10000 (YMD 2026 1 15) NOTHING TRUE TRUE TRUE EQUALS 2000
-- (1.1) and (7)(a)(i) together: a prescribed person who pays the Receiver General the day before the due day is
-- taken to have paid at the financial institution, so there is no failure; paying the Receiver General on the due day is 3%.
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 14)) (`s 21(1) — the amount was remitted in the manner required` TRUE FALSE (YMD 2026 1 14) (YMD 2026 1 15)) FALSE FALSE EQUALS 0
#ASSERT `s 21(7) — the rate of the penalty for failing to remit` (YMD 2026 1 15) (JUST (YMD 2026 1 15)) (`s 21(1) — the amount was remitted in the manner required` TRUE FALSE (YMD 2026 1 15) (YMD 2026 1 15)) FALSE FALSE EQUALS 3%

§§ `s 21.01 -- an excess payment made by mistake`

-- A deduction in 2016 on an excess payment made by clerical error; election and repayment in 2018; no correcting return.
#ASSERT `s 21.01(1) — the amount deducted is deemed not to have been deducted` 2016 TRUE (JUST (YMD 2018 6 1)) (JUST (YMD 2018 7 1)) NOTHING TRUE
-- "for a year after 2015": 2015 is out, 2016 is in.
#ASSERT NOT (`s 21.01(1) — the amount deducted is deemed not to have been deducted` 2015 TRUE (JUST (YMD 2017 6 1)) (JUST (YMD 2017 7 1)) NOTHING TRUE)
-- "before the end of the third year after the calendar year": 31 December 2019 for a 2016 deduction.
#ASSERT `s 21.01(1) — the amount deducted is deemed not to have been deducted` 2016 TRUE (JUST (YMD 2019 12 31)) (JUST (YMD 2019 12 31)) NOTHING TRUE
#ASSERT NOT (`s 21.01(1) — the amount deducted is deemed not to have been deducted` 2016 TRUE (JUST (YMD 2020 1 1)) (JUST (YMD 2019 12 31)) NOTHING TRUE)
#ASSERT NOT (`s 21.01(1) — the amount deducted is deemed not to have been deducted` 2016 TRUE (JUST (YMD 2019 12 31)) (JUST (YMD 2020 1 1)) NOTHING TRUE)
-- Both the election and the repayment (or arrangement) must have happened.
#ASSERT NOT (`s 21.01(1) — the amount deducted is deemed not to have been deducted` 2016 TRUE NOTHING (JUST (YMD 2018 7 1)) NOTHING TRUE)
#ASSERT NOT (`s 21.01(1) — the amount deducted is deemed not to have been deducted` 2016 TRUE (JUST (YMD 2018 6 1)) NOTHING NOTHING TRUE)
-- (b): a correcting return filed before the election defeats it; one filed on or after the election day does not.
#ASSERT NOT (`s 21.01(1) — the amount deducted is deemed not to have been deducted` 2016 TRUE (JUST (YMD 2018 6 1)) (JUST (YMD 2018 7 1)) (JUST (YMD 2018 5 31)) TRUE)
#ASSERT `s 21.01(1) — the amount deducted is deemed not to have been deducted` 2016 TRUE (JUST (YMD 2018 6 1)) (JUST (YMD 2018 7 1)) (JUST (YMD 2018 6 1)) TRUE
#ASSERT `s 21.01(1) — the amount deducted is deemed not to have been deducted` 2016 TRUE (JUST (YMD 2018 6 1)) (JUST (YMD 2018 7 1)) (JUST (YMD 2018 6 2)) TRUE
-- Not an error payment, or the Minister's additional conditions unmet.
#ASSERT NOT (`s 21.01(1) — the amount deducted is deemed not to have been deducted` 2016 FALSE (JUST (YMD 2018 6 1)) (JUST (YMD 2018 7 1)) NOTHING TRUE)
#ASSERT NOT (`s 21.01(1) — the amount deducted is deemed not to have been deducted` 2016 TRUE (JUST (YMD 2018 6 1)) (JUST (YMD 2018 7 1)) NOTHING FALSE)

-- (2): the lesser of the amount deducted and A minus B.
#ASSERT `s 21.01(2) — the amount deemed not to have been deducted` 500 3000 2800 EQUALS 200
#ASSERT `s 21.01(2) — the amount deemed not to have been deducted` 500 3000 2000 EQUALS 500
#ASSERT `s 21.01(2) — the amount deemed not to have been deducted` 500 3000 2500 EQUALS 500

§§ `s 21.1 -- directors`

#ASSERT `s 21.1(1) — the director is jointly and severally liable with the corporation` TRUE TRUE
#ASSERT NOT (`s 21.1(1) — the director is jointly and severally liable with the corporation` FALSE TRUE)
#ASSERT NOT (`s 21.1(1) — the director is jointly and severally liable with the corporation` TRUE FALSE)
#ASSERT `s 21.1(1) — the amount for which the director is liable to Her Majesty with the corporation` TRUE TRUE 1000 50 100 EQUALS 1150
#ASSERT `s 21.1(1) — the amount for which the director is liable to Her Majesty with the corporation` FALSE TRUE 1000 50 100 EQUALS 0
#ASSERT `s 21.1(2) — the director is liable after the Income Tax Act provisions applied by this subsection` TRUE FALSE
#ASSERT NOT (`s 21.1(2) — the director is liable after the Income Tax Act provisions applied by this subsection` TRUE TRUE)
#ASSERT NOT (`s 21.1(2) — the director is liable after the Income Tax Act provisions applied by this subsection` FALSE FALSE)
#ASSERT `s 21.1(3) — the assessment provisions and the rights of an assessed employer apply to the director` TRUE
#ASSERT NOT (`s 21.1(3) — the assessment provisions and the rights of an assessed employer apply to the director` FALSE)
