IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`

-- Tests for cpp-core-calendar.l4. Every expected value is worked out by hand from the calendar,
-- not copied from the rule's output.

§ `Tests of the calendar helpers`

§§ `Months`

-- 17 March 2026 is in March 2026, whose first day is 1 March.
#ASSERT `the month of a date` (YearMonthDay 2026 3 17) EQUALS (YearMonthDay 2026 3 1)
-- The month after December 2026 is January 2027.
#ASSERT `the month following the month of a date` (YearMonthDay 2026 12 31) EQUALS (YearMonthDay 2027 1 1)
-- The month after March 2026 is April 2026, whatever the day.
#ASSERT `the month following the month of a date` (YearMonthDay 2026 3 17) EQUALS (YearMonthDay 2026 4 1)
-- The month after the month containing the last day of a month.
#ASSERT `the month following the month of a date` (YearMonthDay 2026 1 31) EQUALS (YearMonthDay 2026 2 1)
-- 2026 times 12 is 24312, plus 3 is 24315.
#ASSERT `the month number of a date` (YearMonthDay 2026 3 1) EQUALS 24315
-- January to March is two months apart; the days are ignored.
#ASSERT `the number of months from the month of one date to the month of another` (YearMonthDay 2026 1 31) (YearMonthDay 2026 3 1) EQUALS 2
-- December 2025 to January 2026 is one month, across the year end.
#ASSERT `the number of months from the month of one date to the month of another` (YearMonthDay 2025 12 15) (YearMonthDay 2026 1 15) EQUALS 1
-- Within one month it is nil.
#ASSERT `the number of months from the month of one date to the month of another` (YearMonthDay 2026 5 1) (YearMonthDay 2026 5 31) EQUALS 0
-- The second date in an earlier month gives a negative count.
#ASSERT `the number of months from the month of one date to the month of another` (YearMonthDay 2026 3 1) (YearMonthDay 2026 1 1) EQUALS (0 MINUS 2)
-- Five years apart in the same month is sixty months.
#ASSERT `the number of months from the month of one date to the month of another` (YearMonthDay 2021 6 1) (YearMonthDay 2026 6 1) EQUALS 60

§§ `Time limits that run forward`

-- January has 31 days, February 2026 has 28 and March has 31: 90 days after 1 January is 1 April.
#ASSERT `the date a time limit ends` (YearMonthDay 2026 1 1) (`a number of days` WITH `number of days` IS 90) EQUALS (YearMonthDay 2026 4 1)
-- Six months after 30 November is 30 May.
#ASSERT `the date a time limit ends` (YearMonthDay 2025 11 30) (`a number of months` WITH `number of months` IS 6) EQUALS (YearMonthDay 2026 5 30)
-- Six months after 31 August lands in a month with 28 days, so it is 28 February (assumed clamp, fork F1).
#ASSERT `the date a time limit ends` (YearMonthDay 2026 8 31) (`a number of months` WITH `number of months` IS 6) EQUALS (YearMonthDay 2027 2 28)
-- One year after 1 March 2020 is 1 March 2021.
#ASSERT `the date a time limit ends` (YearMonthDay 2020 3 1) (`a number of years` WITH `number of years` IS 1) EQUALS (YearMonthDay 2021 3 1)
-- One year after 29 February 2024 has no 29 February to land on, so it is 28 February 2025 (assumed clamp, fork F1).
#ASSERT `the date a time limit ends` (YearMonthDay 2024 2 29) (`a number of years` WITH `number of years` IS 1) EQUALS (YearMonthDay 2025 2 28)

§§ `Time limits that run back from a date`

-- Twelve months before 1 January 2028 is 1 January 2027.
#ASSERT `the date a time limit before a date goes back to` (YearMonthDay 2028 1 1) (`a number of months` WITH `number of months` IS 12) EQUALS (YearMonthDay 2027 1 1)
-- Thirty days before 1 March 2026: February 2026 has 28 days, so 29 January is 31 days back and 30 January is 30 days back.
#ASSERT `the date a time limit before a date goes back to` (YearMonthDay 2026 3 1) (`a number of days` WITH `number of days` IS 30) EQUALS (YearMonthDay 2026 1 30)
-- One year before 1 March 2026 is 1 March 2025.
#ASSERT `the date a time limit before a date goes back to` (YearMonthDay 2026 3 1) (`a number of years` WITH `number of years` IS 1) EQUALS (YearMonthDay 2025 3 1)
-- One month before 31 March 2026 has no 31 February, so it is 28 February 2026 (assumed clamp, fork F1).
#ASSERT `the date a time limit before a date goes back to` (YearMonthDay 2026 3 31) (`a number of months` WITH `number of months` IS 1) EQUALS (YearMonthDay 2026 2 28)

§§ `Whether a date is within a time limit`

-- The last day of the 90 days is inside.
#ASSERT `a date is within a time limit after a start date` (YearMonthDay 2026 4 1) (YearMonthDay 2026 1 1) (`a number of days` WITH `number of days` IS 90)
-- The day after is outside.
#ASSERT NOT (`a date is within a time limit after a start date` (YearMonthDay 2026 4 2) (YearMonthDay 2026 1 1) (`a number of days` WITH `number of days` IS 90))
-- A date before the start is outside.
#ASSERT NOT (`a date is within a time limit after a start date` (YearMonthDay 2025 12 31) (YearMonthDay 2026 1 1) (`a number of days` WITH `number of days` IS 90))
-- The start date itself is inside.
#ASSERT `a date is within a time limit after a start date` (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 1) (`a number of months` WITH `number of months` IS 6)
