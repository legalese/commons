IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cr2-pension-index`

-- Tests of cr2-pension-index.l4 (regulation 75). Layer 1.
-- Every expected value was decided by reading the regulation and doing the arithmetic by hand before the rules were run.

§ `Tests -- regulation 75`

§§ `75(2) -- one digit after the decimal point (the second digit decides)`

#ASSERT `reg 75(2) — a quotient adjusted to one digit after the decimal point` 103.44 EQUALS 103.4
#ASSERT `reg 75(2) — a quotient adjusted to one digit after the decimal point` 103.449 EQUALS 103.4
#ASSERT `reg 75(2) — a quotient adjusted to one digit after the decimal point` 103.45 EQUALS 103.5
#ASSERT `reg 75(2) — a quotient adjusted to one digit after the decimal point` 103.46 EQUALS 103.5
#ASSERT `reg 75(2) — a quotient adjusted to one digit after the decimal point` 103.96 EQUALS 104
#ASSERT `reg 75(2) — a quotient adjusted to one digit after the decimal point` 103.5 EQUALS 103.5

§§ `75(1) -- the average of twelve months`

-- 100, 101, ..., 111 sum to 1,266; divided by 12 is 105.5.
#ASSERT `reg 75(1) — the Pension Index for a year` (LIST 100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111) EQUALS JUST 105.5
-- twelve months of 103.45: the average is 103.45, adjusted to 103.5
#ASSERT `reg 75(1) — the Pension Index for a year` (LIST 103.45, 103.45, 103.45, 103.45, 103.45, 103.45, 103.45, 103.45, 103.45, 103.45, 103.45, 103.45) EQUALS JUST 103.5
-- eleven months at 100 and one at 105: sum 1,205; average 100.4166..., second digit 1, adjusted to 100.4
#ASSERT `reg 75(1) — the Pension Index for a year` (LIST 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 105) EQUALS JUST 100.4
-- the twelve-month period needs twelve months
#ASSERT `reg 75(1) — the Pension Index for a year` (LIST 100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110) EQUALS NOTHING
#ASSERT `reg 75(1) — the Pension Index for a year` (LIST 100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112) EQUALS NOTHING
#ASSERT `reg 75(1) — the Pension Index for a year` EMPTY EQUALS NOTHING
