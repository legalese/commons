IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-age`
IMPORT `cpp-core-definitions`
IMPORT `cp1-nouns`
IMPORT `cp1-months-helpers`
IMPORT `cp1-div-b-contributory-salary-and-wages`

-- Tests of cp1-months-helpers.l4 and cp1-div-b-contributory-salary-and-wages.l4: section 12.
-- Every expected value was worked out by hand from the text before the file was run. The ages are tested through
-- section 2(2): a person is deemed to reach an age on the first day of the month after the birthday.

§ `Tests -- the month helpers`

#ASSERT `the twelve months of a year` 2024 EQUALS LIST (YearMonthDay 2024 1 1), (YearMonthDay 2024 2 1), (YearMonthDay 2024 3 1), (YearMonthDay 2024 4 1), (YearMonthDay 2024 5 1), (YearMonthDay 2024 6 1), (YearMonthDay 2024 7 1), (YearMonthDay 2024 8 1), (YearMonthDay 2024 9 1), (YearMonthDay 2024 10 1), (YearMonthDay 2024 11 1), (YearMonthDay 2024 12 1)
-- Months of a year from one month number to another, both ends in. January 2024 is 2024 x 12 + 1 = 24289.
#ASSERT `the number of months of a year from one month number to another` 2024 24289 24300 EQUALS 12
#ASSERT `the number of months of a year from one month number to another` 2024 24292 24296 EQUALS 5
#ASSERT `the number of months of a year from one month number to another` 2024 24300 24300 EQUALS 1
#ASSERT `the number of months of a year from one month number to another` 2024 24280 24289 EQUALS 1
#ASSERT `the number of months of a year from one month number to another` 2024 24289 24288 EQUALS 0
#ASSERT `the number of months of a year from one month number to another` 2024 24301 24310 EQUALS 0
#ASSERT `the number of months of a year from one month number to another` 2024 24270 24288 EQUALS 0
#ASSERT `the number of months of a year from one month number to another` 2024 24280 24310 EQUALS 12

`a run of months from March to August 2024` MEANS `cp1 Month period` WITH `first month of the month period` IS YearMonthDay 2024 3 1, `last month of the month period` IS JUST (YearMonthDay 2024 8 1)
`a run of months from March 2024 with no end` MEANS `cp1 Month period` WITH `first month of the month period` IS YearMonthDay 2024 3 1, `last month of the month period` IS NOTHING
#ASSERT `a month falls in a month period` (YearMonthDay 2024 2 28) `a run of months from March to August 2024` EQUALS FALSE
#ASSERT `a month falls in a month period` (YearMonthDay 2024 3 1) `a run of months from March to August 2024` EQUALS TRUE
#ASSERT `a month falls in a month period` (YearMonthDay 2024 8 31) `a run of months from March to August 2024` EQUALS TRUE
#ASSERT `a month falls in a month period` (YearMonthDay 2024 9 1) `a run of months from March to August 2024` EQUALS FALSE
#ASSERT `a month falls in a month period` (YearMonthDay 2030 1 15) `a run of months from March 2024 with no end` EQUALS TRUE
#ASSERT `a month falls in a month period` (YearMonthDay 2024 2 29) `a run of months from March 2024 with no end` EQUALS FALSE
#ASSERT `a month falls in one of the month periods` (YearMonthDay 2024 5 5) (LIST `a run of months from March to August 2024`) EQUALS TRUE
#ASSERT `a month falls in one of the month periods` (YearMonthDay 2024 5 5) EMPTY EQUALS FALSE
#ASSERT `a month is at or after the month of an optional date` (YearMonthDay 2024 6 30) (JUST (YearMonthDay 2024 6 1)) EQUALS TRUE
#ASSERT `a month is at or after the month of an optional date` (YearMonthDay 2024 5 31) (JUST (YearMonthDay 2024 6 1)) EQUALS FALSE
#ASSERT `a month is at or after the month of an optional date` (YearMonthDay 2024 5 31) NOTHING EQUALS FALSE
#ASSERT `an optional date falls in a year` (JUST (YearMonthDay 2024 12 31)) 2024 EQUALS TRUE
#ASSERT `an optional date falls in a year` (JUST (YearMonthDay 2025 1 1)) 2024 EQUALS FALSE
#ASSERT `an optional date falls in a year` NOTHING 2024 EQUALS FALSE

§ `Tests -- section 12(1.1): the election to exclude income after sixty-five`

-- (b) and (c): the election commences, and ceases, on the first day of the month following the month it is made, or revoked.
#ASSERT `s 12(1.1)(b) — the first day on which the election has effect` (YearMonthDay 2023 9 12) EQUALS YearMonthDay 2023 10 1
#ASSERT `s 12(1.1)(b) — the first day on which the election has effect` (YearMonthDay 2023 9 30) EQUALS YearMonthDay 2023 10 1
#ASSERT `s 12(1.1)(b) — the first day on which the election has effect` (YearMonthDay 2023 12 31) EQUALS YearMonthDay 2024 1 1
#ASSERT `s 12(1.1)(c) — the first day on which the election ceases to have effect` (YearMonthDay 2024 3 20) EQUALS YearMonthDay 2024 4 1
#ASSERT `s 12(1.1)(c) — the first day on which the election ceases to have effect` (YearMonthDay 2024 12 1) EQUALS YearMonthDay 2025 1 1
-- In effect from the first day of the month after it is made until the day before the first day of the month after it is revoked.
#ASSERT `s 12(1.1) — an election under subparagraph 12(1)(c)(ii) has effect in a month` (YearMonthDay 2023 9 30) (JUST (YearMonthDay 2023 9 12)) NOTHING EQUALS FALSE
#ASSERT `s 12(1.1) — an election under subparagraph 12(1)(c)(ii) has effect in a month` (YearMonthDay 2023 10 1) (JUST (YearMonthDay 2023 9 12)) NOTHING EQUALS TRUE
#ASSERT `s 12(1.1) — an election under subparagraph 12(1)(c)(ii) has effect in a month` (YearMonthDay 2030 1 1) (JUST (YearMonthDay 2023 9 12)) NOTHING EQUALS TRUE
#ASSERT `s 12(1.1) — an election under subparagraph 12(1)(c)(ii) has effect in a month` (YearMonthDay 2024 3 31) (JUST (YearMonthDay 2023 9 12)) (JUST (YearMonthDay 2024 3 20)) EQUALS TRUE
#ASSERT `s 12(1.1) — an election under subparagraph 12(1)(c)(ii) has effect in a month` (YearMonthDay 2024 4 1) (JUST (YearMonthDay 2023 9 12)) (JUST (YearMonthDay 2024 3 20)) EQUALS FALSE
#ASSERT `s 12(1.1) — an election under subparagraph 12(1)(c)(ii) has effect in a month` (YearMonthDay 2024 3 31) NOTHING NOTHING EQUALS FALSE
-- (a), (d), (e), (f), (g)
#ASSERT `s 12(1.1)(a) — the election or the revocation is valid in form` TRUE EQUALS TRUE
#ASSERT `s 12(1.1)(a) — the election or the revocation is valid in form` FALSE EQUALS FALSE
#ASSERT `s 12(1.1)(d) — the election may be made in the year` FALSE EQUALS TRUE
#ASSERT `s 12(1.1)(d) — the election may be made in the year` TRUE EQUALS FALSE
#ASSERT `s 12(1.1)(e) — the election may be revoked in the year` 2023 2023 EQUALS FALSE
#ASSERT `s 12(1.1)(e) — the election may be revoked in the year` 2023 2024 EQUALS TRUE
#ASSERT `s 12(1.1)(f) — the election may be made in the year` TRUE EQUALS FALSE
#ASSERT `s 12(1.1)(f) — the election may be made in the year` FALSE EQUALS TRUE
#ASSERT `s 12(1.1) — a valid election under subparagraph 12(1)(c)(ii) may be made` TRUE FALSE FALSE EQUALS TRUE
#ASSERT `s 12(1.1) — a valid election under subparagraph 12(1)(c)(ii) may be made` FALSE FALSE FALSE EQUALS FALSE
#ASSERT `s 12(1.1) — a valid election under subparagraph 12(1)(c)(ii) may be made` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `s 12(1.1) — a valid election under subparagraph 12(1)(c)(ii) may be made` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `s 12(1.1) — a valid revocation of the election may be made` TRUE 2023 2024 EQUALS TRUE
#ASSERT `s 12(1.1) — a valid revocation of the election may be made` TRUE 2023 2023 EQUALS FALSE
#ASSERT `s 12(1.1) — a valid revocation of the election may be made` FALSE 2023 2024 EQUALS FALSE
#ASSERT `s 12(1.1)(g) — an election under subparagraph 12(1)(c)(ii) is deemed an election in respect of the kind of income` `income from a pensionable employment` EQUALS TRUE
#ASSERT `s 12(1.1)(g) — an election under subparagraph 12(1)(c)(ii) is deemed an election in respect of the kind of income` `self-employed earnings` EQUALS TRUE
#ASSERT `s 12(1.1)(g) — an election under subparagraph 12(1)(c)(ii) is deemed an election in respect of the kind of income` `another kind of income` EQUALS FALSE

§ `Tests -- section 12(1): the income that is left out`

-- Alice, born 15 June 1990: nothing excluded in 2024.
`Alice in 2024` MEANS `cp1 Facts about a person for a year` WITH
    `the year at hand` IS 2024
    `date of birth of the person` IS (YearMonthDay 1990 6 15)
    `date of death of the person` IS NOTHING
    `date the contributory period of the person ends by reason of disability` IS NOTHING
    `date the disability pension ceases to be payable to the person` IS NOTHING
    `months excluded from the contributory period of the person by reason of disability` IS EMPTY
    `month from which a retirement pension is payable to the person` IS NOTHING
    `date the person makes an election under subparagraph 12(1)(c)(ii)` IS NOTHING
    `date the person revokes the election under subparagraph 12(1)(c)(ii)` IS NOTHING
    `month referred to in the election of the person under paragraph 13(1)(b)` IS NOTHING
    `month referred to in the revocation by the person under paragraph 13(1)(c)` IS NOTHING
`Alice pay of 5,000 on 15 January 2024` MEANS `cp1 Income receipt` WITH `date the income is received` IS (YearMonthDay 2024 1 15), `amount of the income received` IS 5000
`Alice pay of 5,000 on 15 December 2024` MEANS `cp1 Income receipt` WITH `date the income is received` IS (YearMonthDay 2024 12 15), `amount of the income received` IS 5000
#ASSERT `s 12(1) — the contributory salary and wages of a person for a year` `Alice in 2024` (LIST `Alice pay of 5,000 on 15 January 2024`, `Alice pay of 5,000 on 15 December 2024`) 100 EQUALS 10_100
#ASSERT `s 12(1) — the contributory salary and wages of a person for a year` `Alice in 2024` EMPTY 0 EQUALS 0
#ASSERT `s 12(1) — income received on a date is not included in the contributory salary and wages` `Alice in 2024` (YearMonthDay 2024 1 15) EQUALS FALSE

-- Bob, born 10 March 2006: reaches 18 on 10 March 2024, deemed on 1 April 2024 (section 2(2)). Income before 1 April 2024 is left out (paragraph (a)).
`Bob in 2024` MEANS `cp1 Facts about a person for a year` WITH
    `the year at hand` IS 2024
    `date of birth of the person` IS (YearMonthDay 2006 3 10)
    `date of death of the person` IS NOTHING
    `date the contributory period of the person ends by reason of disability` IS NOTHING
    `date the disability pension ceases to be payable to the person` IS NOTHING
    `months excluded from the contributory period of the person by reason of disability` IS EMPTY
    `month from which a retirement pension is payable to the person` IS NOTHING
    `date the person makes an election under subparagraph 12(1)(c)(ii)` IS NOTHING
    `date the person revokes the election under subparagraph 12(1)(c)(ii)` IS NOTHING
    `month referred to in the election of the person under paragraph 13(1)(b)` IS NOTHING
    `month referred to in the revocation by the person under paragraph 13(1)(c)` IS NOTHING
#ASSERT `s 12(1)(a) — the income is received before the person reaches eighteen years of age` `Bob in 2024` (YearMonthDay 2024 1 15) EQUALS TRUE   -- January
#ASSERT `s 12(1)(a) — the income is received before the person reaches eighteen years of age` `Bob in 2024` (YearMonthDay 2024 3 9) EQUALS TRUE   -- the day before the birthday
#ASSERT `s 12(1)(a) — the income is received before the person reaches eighteen years of age` `Bob in 2024` (YearMonthDay 2024 3 10) EQUALS TRUE   -- the birthday itself: not yet deemed to reach 18
#ASSERT `s 12(1)(a) — the income is received before the person reaches eighteen years of age` `Bob in 2024` (YearMonthDay 2024 3 31) EQUALS TRUE   -- the last day of the birthday month
#ASSERT `s 12(1)(a) — the income is received before the person reaches eighteen years of age` `Bob in 2024` (YearMonthDay 2024 4 1) EQUALS FALSE   -- the first day of the next month: deemed to have reached 18
#ASSERT `s 12(1)(a) — the income is received before the person reaches eighteen years of age` `Bob in 2024` (YearMonthDay 2024 4 15) EQUALS FALSE   -- later
`Bob pay of 2,000 on 15 February 2024` MEANS `cp1 Income receipt` WITH `date the income is received` IS (YearMonthDay 2024 2 15), `amount of the income received` IS 2000
`Bob pay of 500 on 31 March 2024` MEANS `cp1 Income receipt` WITH `date the income is received` IS (YearMonthDay 2024 3 31), `amount of the income received` IS 500
`Bob pay of 3,000 on 1 April 2024` MEANS `cp1 Income receipt` WITH `date the income is received` IS (YearMonthDay 2024 4 1), `amount of the income received` IS 3000
`Bob pay of 3,000 on 15 April 2024` MEANS `cp1 Income receipt` WITH `date the income is received` IS (YearMonthDay 2024 4 15), `amount of the income received` IS 3000
#ASSERT `s 12(1) — the contributory salary and wages of a person for a year` `Bob in 2024` (LIST `Bob pay of 2,000 on 15 February 2024`, `Bob pay of 500 on 31 March 2024`, `Bob pay of 3,000 on 1 April 2024`, `Bob pay of 3,000 on 15 April 2024`) 0 EQUALS 6_000

-- Carol, born 20 February 1954: reaches 70 on 20 February 2024, deemed on 1 March 2024. Income from 1 March 2024 is left out (paragraph (d)).
`Carol in 2024` MEANS `cp1 Facts about a person for a year` WITH
    `the year at hand` IS 2024
    `date of birth of the person` IS (YearMonthDay 1954 2 20)
    `date of death of the person` IS NOTHING
    `date the contributory period of the person ends by reason of disability` IS NOTHING
    `date the disability pension ceases to be payable to the person` IS NOTHING
    `months excluded from the contributory period of the person by reason of disability` IS EMPTY
    `month from which a retirement pension is payable to the person` IS NOTHING
    `date the person makes an election under subparagraph 12(1)(c)(ii)` IS NOTHING
    `date the person revokes the election under subparagraph 12(1)(c)(ii)` IS NOTHING
    `month referred to in the election of the person under paragraph 13(1)(b)` IS NOTHING
    `month referred to in the revocation by the person under paragraph 13(1)(c)` IS NOTHING
#ASSERT `s 12(1)(d) — the income is received after the person reaches seventy years of age` `Carol in 2024` (YearMonthDay 2024 2 19) EQUALS FALSE
#ASSERT `s 12(1)(d) — the income is received after the person reaches seventy years of age` `Carol in 2024` (YearMonthDay 2024 2 20) EQUALS FALSE
#ASSERT `s 12(1)(d) — the income is received after the person reaches seventy years of age` `Carol in 2024` (YearMonthDay 2024 2 29) EQUALS FALSE
#ASSERT `s 12(1)(d) — the income is received after the person reaches seventy years of age` `Carol in 2024` (YearMonthDay 2024 3 1) EQUALS TRUE
#ASSERT `s 12(1)(d) — the income is received after the person reaches seventy years of age` `Carol in 2024` (YearMonthDay 2024 12 31) EQUALS TRUE
`Carol pay of 1,000 on 29 February 2024` MEANS `cp1 Income receipt` WITH `date the income is received` IS (YearMonthDay 2024 2 29), `amount of the income received` IS 1000
`Carol pay of 1,000 on 1 March 2024` MEANS `cp1 Income receipt` WITH `date the income is received` IS (YearMonthDay 2024 3 1), `amount of the income received` IS 1000
#ASSERT `s 12(1) — the contributory salary and wages of a person for a year` `Carol in 2024` (LIST `Carol pay of 1,000 on 29 February 2024`, `Carol pay of 1,000 on 1 March 2024`) 0 EQUALS 1_000

-- Dan, born 10 May 1958: reaches 65 on 10 May 2023, deemed on 1 June 2023. A retirement pension is payable from June 2023. He makes the election on 12 September 2023 (effective 1 October 2023), and revokes it on 20 March 2024 (ceases 1 April 2024).
`Dan with an election in force` MEANS `cp1 Facts about a person for a year` WITH
    `the year at hand` IS 2023
    `date of birth of the person` IS (YearMonthDay 1958 5 10)
    `date of death of the person` IS NOTHING
    `date the contributory period of the person ends by reason of disability` IS NOTHING
    `date the disability pension ceases to be payable to the person` IS NOTHING
    `months excluded from the contributory period of the person by reason of disability` IS EMPTY
    `month from which a retirement pension is payable to the person` IS JUST (YearMonthDay 2023 6 1)
    `date the person makes an election under subparagraph 12(1)(c)(ii)` IS JUST (YearMonthDay 2023 9 12)
    `date the person revokes the election under subparagraph 12(1)(c)(ii)` IS NOTHING
    `month referred to in the election of the person under paragraph 13(1)(b)` IS NOTHING
    `month referred to in the revocation by the person under paragraph 13(1)(c)` IS NOTHING
`Dan with the election revoked` MEANS `cp1 Facts about a person for a year` WITH
    `the year at hand` IS 2024
    `date of birth of the person` IS (YearMonthDay 1958 5 10)
    `date of death of the person` IS NOTHING
    `date the contributory period of the person ends by reason of disability` IS NOTHING
    `date the disability pension ceases to be payable to the person` IS NOTHING
    `months excluded from the contributory period of the person by reason of disability` IS EMPTY
    `month from which a retirement pension is payable to the person` IS JUST (YearMonthDay 2023 6 1)
    `date the person makes an election under subparagraph 12(1)(c)(ii)` IS JUST (YearMonthDay 2023 9 12)
    `date the person revokes the election under subparagraph 12(1)(c)(ii)` IS JUST (YearMonthDay 2024 3 20)
    `month referred to in the election of the person under paragraph 13(1)(b)` IS NOTHING
    `month referred to in the revocation by the person under paragraph 13(1)(c)` IS NOTHING
`Dan with no election` MEANS `cp1 Facts about a person for a year` WITH
    `the year at hand` IS 2023
    `date of birth of the person` IS (YearMonthDay 1958 5 10)
    `date of death of the person` IS NOTHING
    `date the contributory period of the person ends by reason of disability` IS NOTHING
    `date the disability pension ceases to be payable to the person` IS NOTHING
    `months excluded from the contributory period of the person by reason of disability` IS EMPTY
    `month from which a retirement pension is payable to the person` IS JUST (YearMonthDay 2023 6 1)
    `date the person makes an election under subparagraph 12(1)(c)(ii)` IS NOTHING
    `date the person revokes the election under subparagraph 12(1)(c)(ii)` IS NOTHING
    `month referred to in the election of the person under paragraph 13(1)(b)` IS NOTHING
    `month referred to in the revocation by the person under paragraph 13(1)(c)` IS NOTHING
`Dan with an election but no pension payable` MEANS `cp1 Facts about a person for a year` WITH
    `the year at hand` IS 2023
    `date of birth of the person` IS (YearMonthDay 1958 5 10)
    `date of death of the person` IS NOTHING
    `date the contributory period of the person ends by reason of disability` IS NOTHING
    `date the disability pension ceases to be payable to the person` IS NOTHING
    `months excluded from the contributory period of the person by reason of disability` IS EMPTY
    `month from which a retirement pension is payable to the person` IS NOTHING
    `date the person makes an election under subparagraph 12(1)(c)(ii)` IS JUST (YearMonthDay 2023 9 12)
    `date the person revokes the election under subparagraph 12(1)(c)(ii)` IS NOTHING
    `month referred to in the election of the person under paragraph 13(1)(b)` IS NOTHING
    `month referred to in the revocation by the person under paragraph 13(1)(c)` IS NOTHING
#ASSERT `s 12(1)(c) — the income is received after the person reaches sixty-five years of age while a retirement pension is payable and an election to exclude it has effect` `Dan with an election in force` (YearMonthDay 2023 9 30) EQUALS FALSE   -- the election is not yet in effect (it commences on 1 October)
#ASSERT `s 12(1)(c) — the income is received after the person reaches sixty-five years of age while a retirement pension is payable and an election to exclude it has effect` `Dan with an election in force` (YearMonthDay 2023 10 1) EQUALS TRUE   -- the first day the election has effect
#ASSERT `s 12(1)(c) — the income is received after the person reaches sixty-five years of age while a retirement pension is payable and an election to exclude it has effect` `Dan with an election in force` (YearMonthDay 2024 6 1) EQUALS TRUE   -- not revoked
#ASSERT `s 12(1)(c) — the income is received after the person reaches sixty-five years of age while a retirement pension is payable and an election to exclude it has effect` `Dan with the election revoked` (YearMonthDay 2024 3 31) EQUALS TRUE   -- revoked on 20 March: still in effect until 31 March
#ASSERT `s 12(1)(c) — the income is received after the person reaches sixty-five years of age while a retirement pension is payable and an election to exclude it has effect` `Dan with the election revoked` (YearMonthDay 2024 4 1) EQUALS FALSE   -- the election ceases to have effect on 1 April
#ASSERT `s 12(1)(c) — the income is received after the person reaches sixty-five years of age while a retirement pension is payable and an election to exclude it has effect` `Dan with no election` (YearMonthDay 2023 10 1) EQUALS FALSE   -- no election
#ASSERT `s 12(1)(c) — the income is received after the person reaches sixty-five years of age while a retirement pension is payable and an election to exclude it has effect` `Dan with an election but no pension payable` (YearMonthDay 2023 10 1) EQUALS FALSE   -- no retirement pension payable
#ASSERT `s 12(1)(c) — the income is received after the person reaches sixty-five years of age while a retirement pension is payable and an election to exclude it has effect` `Dan with an election in force` (YearMonthDay 2023 5 31) EQUALS FALSE   -- before he is deemed to reach 65 (1 June 2023)
#ASSERT `s 12(1)(c) — the income is received after the person reaches sixty-five years of age while a retirement pension is payable and an election to exclude it has effect` `Dan with an election in force` (YearMonthDay 2023 6 1) EQUALS FALSE   -- deemed 65 on 1 June but the election is not yet in effect

-- Edna, born 1 January 1990: a disability excludes March to August 2024 from her contributory period (paragraph (b)).
`a run of months from March to August 2024 for Edna` MEANS `cp1 Month period` WITH `first month of the month period` IS (YearMonthDay 2024 3 1), `last month of the month period` IS JUST (YearMonthDay 2024 8 1)
`Edna in 2024` MEANS `cp1 Facts about a person for a year` WITH
    `the year at hand` IS 2024
    `date of birth of the person` IS (YearMonthDay 1990 1 1)
    `date of death of the person` IS NOTHING
    `date the contributory period of the person ends by reason of disability` IS NOTHING
    `date the disability pension ceases to be payable to the person` IS NOTHING
    `months excluded from the contributory period of the person by reason of disability` IS LIST `a run of months from March to August 2024 for Edna`
    `month from which a retirement pension is payable to the person` IS NOTHING
    `date the person makes an election under subparagraph 12(1)(c)(ii)` IS NOTHING
    `date the person revokes the election under subparagraph 12(1)(c)(ii)` IS NOTHING
    `month referred to in the election of the person under paragraph 13(1)(b)` IS NOTHING
    `month referred to in the revocation by the person under paragraph 13(1)(c)` IS NOTHING
#ASSERT `s 12(1)(b) — the income is received during a month excluded from the contributory period by reason of disability` `Edna in 2024` (YearMonthDay 2024 2 29) EQUALS FALSE
#ASSERT `s 12(1)(b) — the income is received during a month excluded from the contributory period by reason of disability` `Edna in 2024` (YearMonthDay 2024 3 1) EQUALS TRUE
#ASSERT `s 12(1)(b) — the income is received during a month excluded from the contributory period by reason of disability` `Edna in 2024` (YearMonthDay 2024 8 31) EQUALS TRUE
#ASSERT `s 12(1)(b) — the income is received during a month excluded from the contributory period by reason of disability` `Edna in 2024` (YearMonthDay 2024 9 1) EQUALS FALSE
`Edna pay of 4,000 on 28 February 2024` MEANS `cp1 Income receipt` WITH `date the income is received` IS (YearMonthDay 2024 2 28), `amount of the income received` IS 4000
`Edna pay of 4,000 on 15 May 2024` MEANS `cp1 Income receipt` WITH `date the income is received` IS (YearMonthDay 2024 5 15), `amount of the income received` IS 4000
`Edna pay of 4,000 on 1 September 2024` MEANS `cp1 Income receipt` WITH `date the income is received` IS (YearMonthDay 2024 9 1), `amount of the income received` IS 4000
#ASSERT `s 12(1) — the contributory salary and wages of a person for a year` `Edna in 2024` (LIST `Edna pay of 4,000 on 28 February 2024`, `Edna pay of 4,000 on 15 May 2024`, `Edna pay of 4,000 on 1 September 2024`) 250 EQUALS 8_250
#ASSERT `s 12(1) — income received on a date is not included in the contributory salary and wages` `Edna in 2024` (YearMonthDay 2024 5 15) EQUALS TRUE
#ASSERT `s 12(1) — income received on a date is not included in the contributory salary and wages` `Edna in 2024` (YearMonthDay 2024 9 1) EQUALS FALSE

§ `Tests -- section 12(1.2) to (3)`

#ASSERT `s 12(1.2) — the contributory salary and wages from an employer for sections 8 and 9` TRUE 30_000 EQUALS 0
#ASSERT `s 12(1.2) — the contributory salary and wages from an employer for sections 8 and 9` FALSE 30_000 EQUALS 30_000
-- One year after the balance-due day: for 2023 the balance-due day is 30 April 2024, so the time runs to 30 April 2025.
#ASSERT `s 12(1.2) — the person may make an election under subsection 13(3) and pay the contributions required under section 10 on a date` 2023 NOTHING (YearMonthDay 2025 4 30) EQUALS TRUE
#ASSERT `s 12(1.2) — the person may make an election under subsection 13(3) and pay the contributions required under section 10 on a date` 2023 NOTHING (YearMonthDay 2025 5 1) EQUALS FALSE
#ASSERT `s 12(1.2) — the person may make an election under subsection 13(3) and pay the contributions required under section 10 on a date` 2023 NOTHING (YearMonthDay 2024 4 30) EQUALS TRUE
-- A person who died on 15 December 2023: the balance-due day is 15 June 2024, so the time runs to 15 June 2025.
#ASSERT `s 12(1.2) — the person may make an election under subsection 13(3) and pay the contributions required under section 10 on a date` 2023 (JUST (YearMonthDay 2023 12 15)) (YearMonthDay 2025 6 15) EQUALS TRUE
#ASSERT `s 12(1.2) — the person may make an election under subsection 13(3) and pay the contributions required under section 10 on a date` 2023 (JUST (YearMonthDay 2023 12 15)) (YearMonthDay 2025 6 16) EQUALS FALSE
#ASSERT `s 12(2) — the salary of a contributor under the Public Service Superannuation Act included in the contributory salary and wages` TRUE 7_000 EQUALS JUST 7_000
#ASSERT `s 12(2) — the salary of a contributor under the Public Service Superannuation Act included in the contributory salary and wages` FALSE 7_000 EQUALS NOTHING
#ASSERT `s 12(2.1) — the income of an Indian from employment otherwise excepted that is included in the contributory salary and wages` TRUE 9_000 EQUALS JUST 9_000
#ASSERT `s 12(2.1) — the income of an Indian from employment otherwise excepted that is included in the contributory salary and wages` FALSE 9_000 EQUALS NOTHING
#ASSERT `s 12(3) — the contributory salary and wages for remuneration paid in a province providing a comprehensive pension plan` TRUE 41_000 40_000 EQUALS 41_000
