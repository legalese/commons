IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-definitions`
IMPORT `cp2-rulings-and-appeals`

-- Tests of cp2-rulings-and-appeals.l4 (Act sections 26.1 to 29).
-- Expected values were decided by reading the section, then written down; none was copied from the rule's output.

§ `Tests -- rulings and appeals`

§§ `s 26.1 -- rulings`

-- (1): who may ask, and about what.
#ASSERT `s 26.1(1) — the person may request a ruling on the question` `an employer requesting a ruling` `whether an employment is pensionable`
#ASSERT `s 26.1(1) — the person may request a ruling on the question` `an employee requesting a ruling` `whether a contribution is payable`
#ASSERT `s 26.1(1) — the person may request a ruling on the question` `a person claiming to be an employee requesting a ruling` `who is the employer of a person in pensionable employment`
#ASSERT `s 26.1(1) — the person may request a ruling on the question` `a person claiming to be an employer requesting a ruling` `how long an employment lasts, including the dates on which it begins and ends`
#ASSERT `s 26.1(1) — the person may request a ruling on the question` `the Minister of Employment and Social Development requesting a ruling` `what is the amount of a contribution that is payable`
#ASSERT `s 26.1(1) — the person may request a ruling on the question` `an employee requesting a ruling` `what is the amount of any earnings from pensionable employment`
#ASSERT NOT (`s 26.1(1) — the person may request a ruling on the question` `another person requesting a ruling` `whether an employment is pensionable`)
#ASSERT NOT (`s 26.1(1) — the person may request a ruling on the question` `an employee requesting a ruling` `another question`)

-- (2): the Minister of ESDC at any time; everyone else before 30 June of the year after the year in question.
#ASSERT `s 26.1(2) — the request is made in time` `the Minister of Employment and Social Development requesting a ruling` 2020 (YearMonthDay 2031 1 1)
#ASSERT `s 26.1(2) — the request is made in time` `an employee requesting a ruling` 2025 (YearMonthDay 2026 6 29)
#ASSERT NOT (`s 26.1(2) — the request is made in time` `an employee requesting a ruling` 2025 (YearMonthDay 2026 6 30))
#ASSERT NOT (`s 26.1(2) — the request is made in time` `an employer requesting a ruling` 2025 (YearMonthDay 2026 7 1))
#ASSERT `s 26.1(2) — the request is made in time` `an employer requesting a ruling` 2025 (YearMonthDay 2026 1 1)
#ASSERT `s 26.1(2) — the request is made in time` `an employee requesting a ruling` 2025 (YearMonthDay 2025 12 31)
#ASSERT NOT (`s 26.1(2) — the request is made in time` `a person claiming to be an employee requesting a ruling` 2024 (YearMonthDay 2025 6 30))
#ASSERT `s 26.1(3) — the authorized officer has made the ruling as required` TRUE TRUE
#ASSERT NOT (`s 26.1(3) — the authorized officer has made the ruling as required` TRUE FALSE)
#ASSERT NOT (`s 26.1(3) — the authorized officer has made the ruling as required` FALSE TRUE)

-- (4): the presumption, and its absence once a ruling has been requested.
#ASSERT `s 26.1(4) — what the Act presumes about the amount` FALSE TRUE EQUALS `the amount is deemed to have been deducted or paid in accordance with this Act`
#ASSERT `s 26.1(4) — what the Act presumes about the amount` FALSE FALSE EQUALS `the amount is deemed not to have been required to be deducted or paid in accordance with this Act`
#ASSERT `s 26.1(4) — what the Act presumes about the amount` TRUE TRUE EQUALS `no presumption arises under subsection 26.1(4)`
#ASSERT `s 26.1(4) — what the Act presumes about the amount` TRUE FALSE EQUALS `no presumption arises under subsection 26.1(4)`

§§ `s 27 to 27.3 -- appeals to the Minister`

-- 90 days after 1 March 2026 is 30 May 2026 (31 + 30 + ... : 1 March plus 90 days).
#ASSERT `s 27 — the last day for a person concerned to appeal the ruling to the Minister` (YearMonthDay 2026 3 1) EQUALS YearMonthDay 2026 5 30
#ASSERT `s 27 — the appeal from the ruling is in time` FALSE TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 30)
#ASSERT NOT (`s 27 — the appeal from the ruling is in time` FALSE TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 5 31))
#ASSERT `s 27 — the appeal from the ruling is in time` FALSE TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 1)
#ASSERT NOT (`s 27 — the appeal from the ruling is in time` FALSE TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 2 28))
-- The Minister of ESDC may appeal at any time.
#ASSERT `s 27 — the appeal from the ruling is in time` TRUE FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2031 3 1)
-- Someone who is neither the Minister of ESDC nor a person concerned has no right of appeal.
#ASSERT NOT (`s 27 — the appeal from the ruling is in time` FALSE FALSE (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 2))

#ASSERT `s 27.1 — the last day for the employer to appeal the assessment to the Minister` (YearMonthDay 2026 1 1) EQUALS YearMonthDay 2026 4 1
#ASSERT `s 27.1 — the employer may appeal the assessment to the Minister for reconsideration` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 4 1)
#ASSERT NOT (`s 27.1 — the employer may appeal the assessment to the Minister for reconsideration` TRUE (YearMonthDay 2026 1 1) (YearMonthDay 2026 4 2))
#ASSERT NOT (`s 27.1 — the employer may appeal the assessment to the Minister for reconsideration` FALSE (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 2))

#ASSERT `s 27.2(1) — the Minister must notify the person and give the person an opportunity to provide information and make representations` TRUE TRUE
#ASSERT NOT (`s 27.2(1) — the Minister must notify the person and give the person an opportunity to provide information and make representations` TRUE FALSE)
#ASSERT NOT (`s 27.2(1) — the Minister must notify the person and give the person an opportunity to provide information and make representations` FALSE TRUE)
#ASSERT `s 27.2(2) — the appeal is addressed and sent as required` TRUE TRUE FALSE
#ASSERT `s 27.2(2) — the appeal is addressed and sent as required` TRUE FALSE TRUE
#ASSERT NOT (`s 27.2(2) — the appeal is addressed and sent as required` TRUE FALSE FALSE)
#ASSERT NOT (`s 27.2(2) — the appeal is addressed and sent as required` FALSE TRUE TRUE)
#ASSERT `s 27.2(3) — the Minister has decided the appeal and notified the affected persons as required` TRUE TRUE
#ASSERT NOT (`s 27.2(3) — the Minister has decided the appeal and notified the affected persons as required` TRUE FALSE)
#ASSERT NOT (`s 27.2(3) — the Minister has decided the appeal and notified the affected persons as required` FALSE TRUE)
#ASSERT `s 27.3 — sections 26.1 to 27.2 do not restrict the Minister's authority in the case` TRUE FALSE
#ASSERT `s 27.3 — sections 26.1 to 27.2 do not restrict the Minister's authority in the case` FALSE TRUE
#ASSERT NOT (`s 27.3 — sections 26.1 to 27.2 do not restrict the Minister's authority in the case` FALSE FALSE)

§§ `s 28 and 29 -- the Tax Court of Canada, finality and allowances`

-- (1.1): the Tax Court rule, if there is one, fixes the day; otherwise the day the decision was in fact communicated.
#ASSERT `s 28(1.1) — the day the decision on the appeal to the Minister is communicated to the person` (JUST (YearMonthDay 2026 2 10)) (YearMonthDay 2026 2 3) EQUALS YearMonthDay 2026 2 10
#ASSERT `s 28(1.1) — the day the decision on the appeal to the Minister is communicated to the person` NOTHING (YearMonthDay 2026 2 3) EQUALS YearMonthDay 2026 2 3

-- (1): 90 days after 1 February 2026 is 2 May 2026; the application for more time can be made until 31 July 2026.
#ASSERT `s 28(1) — the last day for appealing to the Tax Court of Canada without more time` (YearMonthDay 2026 2 1) EQUALS YearMonthDay 2026 5 2
#ASSERT `s 28(1) — the last day for applying to the Tax Court of Canada for a longer time` (YearMonthDay 2026 2 1) EQUALS YearMonthDay 2026 7 31
#ASSERT `s 28(1) — the appeal to the Tax Court of Canada may be brought` TRUE FALSE (YearMonthDay 2026 2 1) (YearMonthDay 2026 5 2) FALSE NOTHING
#ASSERT NOT (`s 28(1) — the appeal to the Tax Court of Canada may be brought` TRUE FALSE (YearMonthDay 2026 2 1) (YearMonthDay 2026 5 3) FALSE NOTHING)
#ASSERT `s 28(1) — the appeal to the Tax Court of Canada may be brought` FALSE TRUE (YearMonthDay 2026 2 1) (YearMonthDay 2026 3 1) FALSE NOTHING
#ASSERT NOT (`s 28(1) — the appeal to the Tax Court of Canada may be brought` FALSE FALSE (YearMonthDay 2026 2 1) (YearMonthDay 2026 3 1) FALSE NOTHING)
-- A longer time: allowed on a timely application, the appeal is in time until the last day the Court allowed.
#ASSERT `s 28(1) — the appeal to the Tax Court of Canada may be brought` TRUE FALSE (YearMonthDay 2026 2 1) (YearMonthDay 2026 6 30) TRUE (JUST (YearMonthDay 2026 6 30))
#ASSERT NOT (`s 28(1) — the appeal to the Tax Court of Canada may be brought` TRUE FALSE (YearMonthDay 2026 2 1) (YearMonthDay 2026 7 1) TRUE (JUST (YearMonthDay 2026 6 30)))
-- No longer time was allowed on a timely application: the extension does not help.
#ASSERT NOT (`s 28(1) — the appeal to the Tax Court of Canada may be brought` TRUE FALSE (YearMonthDay 2026 2 1) (YearMonthDay 2026 6 30) FALSE (JUST (YearMonthDay 2026 6 30)))
#ASSERT NOT (`s 28(1) — the appeal to the Tax Court of Canada may be brought` TRUE FALSE (YearMonthDay 2026 2 1) (YearMonthDay 2026 6 30) TRUE NOTHING)

#ASSERT `s 28(1.2) — section 167 of the Income Tax Act, except paragraph 167(5)(a), applies to the application` TRUE
#ASSERT NOT (`s 28(1.2) — section 167 of the Income Tax Act, except paragraph 167(5)(a), applies to the application` FALSE)

-- (2): vacate, confirm and vary on either kind of appeal; referral back only on an appeal from an assessment under section 27.1.
#ASSERT `s 28(2) — the Tax Court of Canada may make the order on the appeal` `an appeal from a decision on an appeal to the Minister under section 27` `vacate the decision or assessment`
#ASSERT `s 28(2) — the Tax Court of Canada may make the order on the appeal` `an appeal from a decision on an appeal to the Minister under section 27` `confirm the decision or assessment`
#ASSERT `s 28(2) — the Tax Court of Canada may make the order on the appeal` `an appeal from a decision on an appeal to the Minister under section 27` `vary the decision or assessment`
#ASSERT NOT (`s 28(2) — the Tax Court of Canada may make the order on the appeal` `an appeal from a decision on an appeal to the Minister under section 27` `refer the matter back to the Minister for reconsideration and reassessment`)
#ASSERT `s 28(2) — the Tax Court of Canada may make the order on the appeal` `an appeal from an assessment that was the subject of an appeal to the Minister under section 27.1` `refer the matter back to the Minister for reconsideration and reassessment`
#ASSERT `s 28(2) — the Tax Court of Canada may make the order on the appeal` `an appeal from an assessment that was the subject of an appeal to the Minister under section 27.1` `vary the decision or assessment`
#ASSERT `s 28(2)(a) — the Court has notified the parties of its decision as required` TRUE TRUE
#ASSERT NOT (`s 28(2)(a) — the Court has notified the parties of its decision as required` TRUE FALSE)
#ASSERT NOT (`s 28(2)(a) — the Court has notified the parties of its decision as required` FALSE TRUE)
#ASSERT `s 28(2)(b) — the Court's reasons must be in writing` TRUE
#ASSERT NOT (`s 28(2)(b) — the Court's reasons must be in writing` FALSE)

#ASSERT `s 29(1) — the authority of the Minister or the Tax Court of Canada includes deciding the question` TRUE TRUE
#ASSERT NOT (`s 29(1) — the authority of the Minister or the Tax Court of Canada includes deciding the question` FALSE TRUE)
#ASSERT NOT (`s 29(1) — the authority of the Minister or the Tax Court of Canada includes deciding the question` TRUE FALSE)
#ASSERT `s 29(2) — the decision or ruling is final and binding for all purposes of this Act` TRUE FALSE
#ASSERT NOT (`s 29(2) — the decision or ruling is final and binding for all purposes of this Act` TRUE TRUE)
#ASSERT NOT (`s 29(2) — the decision or ruling is final and binding for all purposes of this Act` FALSE FALSE)
#ASSERT `s 29(3) — the person must be paid the travel and other allowances approved by the Treasury Board` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 29(3) — the person must be paid the travel and other allowances approved by the Treasury Board` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`s 29(3) — the person must be paid the travel and other allowances approved by the Treasury Board` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 29(3) — the person must be paid the travel and other allowances approved by the Treasury Board` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 29(3) — the person must be paid the travel and other allowances approved by the Treasury Board` FALSE TRUE TRUE TRUE)
#ASSERT `s 29(3) — the allowances the person must be paid` TRUE 240 EQUALS 240
#ASSERT `s 29(3) — the allowances the person must be paid` FALSE 240 EQUALS 0
