IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-definitions`
IMPORT `cp2-self-employed-returns`

-- Tests of cp2-self-employed-returns.l4 (Act sections 30, 31, 32 and 35).
-- Expected values were decided by reading the section, then written down; none was copied from the rule's output.

§ `Tests -- returns of self-employed earnings`

§§ `s 30(1) -- who files, and by when`

#ASSERT `s 30(1) — a return of the person's self-employed earnings for the year must be filed without notice or demand` TRUE
#ASSERT NOT (`s 30(1) — a return of the person's self-employed earnings for the year must be filed without notice or demand` FALSE)

#ASSERT `s 30(1) — who must file the return` TRUE FALSE `not a representative` EQUALS `the person must file the return`
-- Unable to file: the representative files, when there is one of any of the kinds the Act lists.
#ASSERT `s 30(1) — who must file the return` TRUE TRUE `an executor` EQUALS `the person's representative must file the return`
#ASSERT `s 30(1) — who must file the return` TRUE TRUE `a guardian` EQUALS `the person's representative must file the return`
#ASSERT `s 30(1) — who must file the return` TRUE TRUE `another legal representative` EQUALS `the person's representative must file the return`
-- Unable to file and no representative: the text does not say who files.
#ASSERT `s 30(1) — who must file the return` TRUE TRUE `not a representative` EQUALS `the text does not say who must file the return`
-- Not required to contribute: no return under subsection (1) at all, whoever the representative is.
#ASSERT `s 30(1) — who must file the return` FALSE FALSE `not a representative` EQUALS `no return is required under subsection 30(1)`
#ASSERT `s 30(1) — who must file the return` FALSE TRUE `an executor` EQUALS `no return is required under subsection 30(1)`
-- A person able to file files personally, even if there is a representative.
#ASSERT `s 30(1) — who must file the return` TRUE FALSE `an executor` EQUALS `the person must file the return`

-- "on or before" the day the income tax return is due: that day is in time, the next day is not.
#ASSERT `s 30(1) — the last day for filing the return of self-employed earnings` (YMD 2027 4 30) EQUALS YMD 2027 4 30
#ASSERT `s 30(1) — the return is filed in time` (YMD 2027 4 30) (YMD 2027 4 30)
#ASSERT `s 30(1) — the return is filed in time` (YMD 2027 4 29) (YMD 2027 4 30)
#ASSERT NOT (`s 30(1) — the return is filed in time` (YMD 2027 5 1) (YMD 2027 4 30))
-- Year end: filed on 1 January against a due day of 31 December is late.
#ASSERT NOT (`s 30(1) — the return is filed in time` (YMD 2028 1 1) (YMD 2027 12 31))

§§ `s 30(2) and (3) -- a demand, and a return by someone administering another's affairs`

#ASSERT `s 30(2) — the person must file a return of self-employed earnings for the year designated in the demand` TRUE TRUE FALSE
#ASSERT `s 30(2) — the person must file a return of self-employed earnings for the year designated in the demand` TRUE FALSE TRUE
#ASSERT NOT (`s 30(2) — the person must file a return of self-employed earnings for the year designated in the demand` TRUE FALSE FALSE)
#ASSERT NOT (`s 30(2) — the person must file a return of self-employed earnings for the year designated in the demand` FALSE TRUE TRUE)
#ASSERT `s 30(2) — the return is filed within the time the demand stipulates` (YMD 2026 9 15) (YMD 2026 9 15)
#ASSERT NOT (`s 30(2) — the return is filed within the time the demand stipulates` (YMD 2026 9 16) (YMD 2026 9 15))
#ASSERT `s 30(3) — the person must file a return of the other person's self-employed earnings for the year` TRUE TRUE
#ASSERT NOT (`s 30(3) — the person must file a return of the other person's self-employed earnings for the year` TRUE FALSE)
#ASSERT NOT (`s 30(3) — the person must file a return of the other person's self-employed earnings for the year` FALSE TRUE)

§§ `s 30(4) -- the province of residence`

#ASSERT `s 30(4) — the day as at which the return must identify the person's province of residence` 2026 EQUALS YMD 2026 12 31
#ASSERT `s 30(4) — the return identifies the province as required` "Ontario" "Ontario"
#ASSERT NOT (`s 30(4) — the return identifies the province as required` "Ontario" "Alberta")

§§ `s 30(5) -- no return for four years`

-- Return due 30 April 2027: the day four years after is 30 April 2031.
-- Not filed and not assessed by then: the contribution is deemed zero.
#ASSERT `s 30(5) — the contribution for the year is deemed to be zero` (YMD 2027 4 30) NOTHING NOTHING
-- Filed before 30 April 2031: the subsection does not apply, however late.
#ASSERT NOT (`s 30(5) — the contribution for the year is deemed to be zero` (YMD 2027 4 30) (JUST (YMD 2031 4 29)) NOTHING)
-- Filed on 30 April 2031 is not "before" that day: (a) is satisfied.
#ASSERT `s 30(5) — the contribution for the year is deemed to be zero` (YMD 2027 4 30) (JUST (YMD 2031 4 30)) NOTHING
#ASSERT `s 30(5) — the contribution for the year is deemed to be zero` (YMD 2027 4 30) (JUST (YMD 2031 5 1)) NOTHING
-- Assessed by the end of the four years: not zero.
#ASSERT NOT (`s 30(5) — the contribution for the year is deemed to be zero` (YMD 2027 4 30) NOTHING (JUST (YMD 2030 12 31)))
#ASSERT NOT (`s 30(5) — the contribution for the year is deemed to be zero` (YMD 2027 4 30) NOTHING (JUST (YMD 2031 4 30)))
-- Assessed after the four years: too late to save the Minister's claim.
#ASSERT `s 30(5) — the contribution for the year is deemed to be zero` (YMD 2027 4 30) NOTHING (JUST (YMD 2031 5 1))
-- Both: filed in time defeats (a).
#ASSERT NOT (`s 30(5) — the contribution for the year is deemed to be zero` (YMD 2027 4 30) (JUST (YMD 2027 4 30)) (JUST (YMD 2031 5 1)))
-- Leap day: a return due 29 February 2028 has four years running to 29 February 2032, which exists (2032 is a leap year).
#ASSERT NOT (`s 30(5) — the contribution for the year is deemed to be zero` (YMD 2028 2 29) (JUST (YMD 2032 2 28)) NOTHING)
#ASSERT `s 30(5) — the contribution for the year is deemed to be zero` (YMD 2028 2 29) (JUST (YMD 2032 2 29)) NOTHING
#ASSERT `s 30(5) — the contribution required for the year after subsection 30(5)` 3200 TRUE EQUALS 0
#ASSERT `s 30(5) — the contribution required for the year after subsection 30(5)` 3200 FALSE EQUALS 3200

§§ `s 31 and 32 -- the estimate, and the assessment`

#ASSERT `s 31 — the person must estimate in the return the contributions to be made on the self-employed earnings` TRUE
#ASSERT NOT (`s 31 — the person must estimate in the return the contributions to be made on the self-employed earnings` FALSE)
#ASSERT `s 32 — the Minister must examine the return, assess the contributions, interest and penalties, and send a notice of assessment to the person who filed the return` TRUE
#ASSERT NOT (`s 32 — the Minister must examine the return, assess the contributions, interest and penalties, and send a notice of assessment to the person who filed the return` FALSE)
#ASSERT `s 32 — the total the assessment states` 3200 40 160 EQUALS 3400
#ASSERT `s 32 — the total the assessment states` 3200 0 0 EQUALS 3200

§§ `s 35 -- penalties for not filing`

-- (1): 5% of the part unpaid when the time for filing expired.
#ASSERT `s 35(1) — the penalty for failing to file the return` TRUE 2000 EQUALS 100
#ASSERT `s 35(1) — the penalty for failing to file the return` TRUE 0 EQUALS 0
#ASSERT `s 35(1) — the penalty for failing to file the return` FALSE 2000 EQUALS 0
-- The Minister may reduce or remit only where the Income Tax Act penalty applies.
#ASSERT `s 35(1) — the penalty after any reduction or remission by the Minister` 100 TRUE 40 EQUALS 60
#ASSERT `s 35(1) — the penalty after any reduction or remission by the Minister` 100 TRUE 100 EQUALS 0
#ASSERT `s 35(1) — the penalty after any reduction or remission by the Minister` 100 TRUE 500 EQUALS 0
#ASSERT `s 35(1) — the penalty after any reduction or remission by the Minister` 100 FALSE 40 EQUALS 100
#ASSERT `s 35(1) — the penalty after any reduction or remission by the Minister` 100 TRUE 0 EQUALS 100
-- (2): $5 a day, never more than $50 in all.
#ASSERT `s 35(2) — the penalty for failing to file the return required by subsection 30(3)` TRUE 1 EQUALS 5
#ASSERT `s 35(2) — the penalty for failing to file the return required by subsection 30(3)` TRUE 9 EQUALS 45
#ASSERT `s 35(2) — the penalty for failing to file the return required by subsection 30(3)` TRUE 10 EQUALS 50
#ASSERT `s 35(2) — the penalty for failing to file the return required by subsection 30(3)` TRUE 11 EQUALS 50
#ASSERT `s 35(2) — the penalty for failing to file the return required by subsection 30(3)` TRUE 400 EQUALS 50
#ASSERT `s 35(2) — the penalty for failing to file the return required by subsection 30(3)` TRUE 0 EQUALS 0
#ASSERT `s 35(2) — the penalty for failing to file the return required by subsection 30(3)` FALSE 12 EQUALS 0
