IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-age`
IMPORT `cp5-months`

-- Tests of the month helpers (cp5-months.l4). Not a provision: the expected values are plain calendar facts,
-- written by hand. A month is the first day of the month.

§ `Tests of the month helpers`

#ASSERT `cp5 helper -- the later of two months that may not apply` (JUST (YearMonthDay 2020 3 1)) (JUST (YearMonthDay 2021 1 1)) EQUALS JUST (YearMonthDay 2021 1 1)
#ASSERT `cp5 helper -- the later of two months that may not apply` (JUST (YearMonthDay 2021 1 1)) (JUST (YearMonthDay 2020 3 1)) EQUALS JUST (YearMonthDay 2021 1 1)
#ASSERT `cp5 helper -- the later of two months that may not apply` NOTHING (JUST (YearMonthDay 2020 3 1)) EQUALS JUST (YearMonthDay 2020 3 1)
#ASSERT `cp5 helper -- the later of two months that may not apply` (JUST (YearMonthDay 2020 3 1)) NOTHING EQUALS JUST (YearMonthDay 2020 3 1)
#ASSERT `cp5 helper -- the later of two months that may not apply` NOTHING NOTHING EQUALS NOTHING

#ASSERT `cp5 helper -- the earlier of two months that may not apply` (JUST (YearMonthDay 2020 3 1)) (JUST (YearMonthDay 2021 1 1)) EQUALS JUST (YearMonthDay 2020 3 1)
#ASSERT `cp5 helper -- the earlier of two months that may not apply` (JUST (YearMonthDay 2021 1 1)) (JUST (YearMonthDay 2020 3 1)) EQUALS JUST (YearMonthDay 2020 3 1)
#ASSERT `cp5 helper -- the earlier of two months that may not apply` NOTHING (JUST (YearMonthDay 2020 3 1)) EQUALS JUST (YearMonthDay 2020 3 1)
#ASSERT `cp5 helper -- the earlier of two months that may not apply` NOTHING NOTHING EQUALS NOTHING

-- The latest of the months that apply: absent months are skipped; an empty list gives NOTHING.
#ASSERT `cp5 helper -- the latest of the months that apply` (LIST JUST (YearMonthDay 2020 3 1), NOTHING, JUST (YearMonthDay 2022 5 1), JUST (YearMonthDay 2021 1 1)) EQUALS JUST (YearMonthDay 2022 5 1)
#ASSERT `cp5 helper -- the latest of the months that apply` (LIST NOTHING, NOTHING) EQUALS NOTHING
#ASSERT `cp5 helper -- the latest of the months that apply` (EMPTY) EQUALS NOTHING
#ASSERT `cp5 helper -- the earliest of the months that apply` (LIST JUST (YearMonthDay 2020 3 1), NOTHING, JUST (YearMonthDay 2022 5 1), JUST (YearMonthDay 2019 12 1)) EQUALS JUST (YearMonthDay 2019 12 1)
#ASSERT `cp5 helper -- the earliest of the months that apply` (LIST NOTHING) EQUALS NOTHING

-- Going back across a year end: the eleventh month before February 2021 is March 2020, and one month before January 2021 is December 2020.
#ASSERT `cp5 helper -- the month a number of months from the month of a date` (YearMonthDay 2021 2 17) (0 MINUS 11) EQUALS YearMonthDay 2020 3 1
#ASSERT `cp5 helper -- the month a number of months from the month of a date` (YearMonthDay 2021 1 31) (0 MINUS 1) EQUALS YearMonthDay 2020 12 1
#ASSERT `cp5 helper -- the month a number of months from the month of a date` (YearMonthDay 2021 11 5) 3 EQUALS YearMonthDay 2022 2 1

#ASSERT `cp5 helper -- the month of a date that may be absent` (JUST (YearMonthDay 2021 11 5)) EQUALS JUST (YearMonthDay 2021 11 1)
#ASSERT `cp5 helper -- the month of a date that may be absent` NOTHING EQUALS NOTHING
#ASSERT `cp5 helper -- the month following the month of a date that may be absent` (JUST (YearMonthDay 2021 12 31)) EQUALS JUST (YearMonthDay 2022 1 1)
#ASSERT `cp5 helper -- the month following the month of a date that may be absent` NOTHING EQUALS NOTHING

-- A month kept only on one side of a day.
#ASSERT `cp5 helper -- the month if it falls before a day` (JUST (YearMonthDay 1986 12 1)) (YearMonthDay 1987 1 1) EQUALS JUST (YearMonthDay 1986 12 1)
#ASSERT `cp5 helper -- the month if it falls before a day` (JUST (YearMonthDay 1987 1 1)) (YearMonthDay 1987 1 1) EQUALS NOTHING
#ASSERT `cp5 helper -- the month if it falls on or after a day` (JUST (YearMonthDay 1987 1 1)) (YearMonthDay 1987 1 1) EQUALS JUST (YearMonthDay 1987 1 1)
#ASSERT `cp5 helper -- the month if it falls on or after a day` (JUST (YearMonthDay 1986 12 1)) (YearMonthDay 1987 1 1) EQUALS NOTHING
#ASSERT `cp5 helper -- the month if it falls on or after a day` NOTHING (YearMonthDay 1987 1 1) EQUALS NOTHING

-- Section 2(2): a person born on 15 June 1960 is treated as reaching 65 on 1 July 2025, the month after the birthday's month.
#ASSERT `cp5 helper -- the day the person is treated as reaching an age under section 2(2)` (YearMonthDay 1960 6 15) 65 EQUALS YearMonthDay 2025 7 1
#ASSERT `cp5 helper -- the month in which the person reaches an age under section 2(2)` (YearMonthDay 1960 6 15) 65 EQUALS YearMonthDay 2025 7 1
#ASSERT `cp5 helper -- the person has reached an age on a day under section 2(2)` (YearMonthDay 1960 6 15) 65 (YearMonthDay 2025 7 1)
#ASSERT NOT (`cp5 helper -- the person has reached an age on a day under section 2(2)` (YearMonthDay 1960 6 15) 65 (YearMonthDay 2025 6 30))
#ASSERT NOT (`cp5 helper -- the person has reached an age on a day under section 2(2)` (YearMonthDay 1960 6 15) 65 (YearMonthDay 2025 6 15))

-- The first reading that gives a month, in the order listed.
#ASSERT `cp5 helper -- the first reading that gives a month` (LIST NOTHING, JUST (YearMonthDay 2020 3 1), JUST (YearMonthDay 2021 3 1)) EQUALS JUST (YearMonthDay 2020 3 1)
#ASSERT `cp5 helper -- the first reading that gives a month` (LIST NOTHING, NOTHING) EQUALS NOTHING
#ASSERT `cp5 helper -- the first reading that gives a month` (EMPTY) EQUALS NOTHING
