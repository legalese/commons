IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cp2-assessment-and-recovery`

-- Tests of cp2-assessment-and-recovery.l4 (Act sections 22 and 23).
-- Expected values were decided by reading the section, then written down; none was copied from the rule's output.

§ `Tests -- assessment, debt and trust`

§§ `s 22 -- assessment`

#ASSERT `s 22(1) — the Minister may assess the employer for the amount` TRUE
#ASSERT NOT (`s 22(1) — the Minister may assess the employer for the amount` FALSE)

-- (2): a notice sent makes the assessment valid and binding and the employer liable at once; vacating it on appeal undoes that.
#ASSERT `s 22(2) — the assessment is valid and binding, and the employer is liable to pay the amount forthwith` TRUE FALSE
#ASSERT NOT (`s 22(2) — the assessment is valid and binding, and the employer is liable to pay the amount forthwith` FALSE FALSE)
#ASSERT NOT (`s 22(2) — the assessment is valid and binding, and the employer is liable to pay the amount forthwith` TRUE TRUE)
#ASSERT `s 22(2) — the amount the employer is liable to pay forthwith` TRUE FALSE 4200 EQUALS 4200
#ASSERT `s 22(2) — the amount the employer is liable to pay forthwith` FALSE FALSE 4200 EQUALS 0
#ASSERT `s 22(2) — the amount the employer is liable to pay forthwith` TRUE TRUE 4200 EQUALS 0

-- (3): four years from the earliest due day, 15 January 2020, ends on 15 January 2024 (fork F1: the last day is in time).
#ASSERT `s 22(3) — the Minister may still make the assessment` (YMD 2024 1 15) (YMD 2020 1 15) FALSE
#ASSERT `s 22(3) — the Minister may still make the assessment` (YMD 2020 1 15) (YMD 2020 1 15) FALSE
#ASSERT NOT (`s 22(3) — the Minister may still make the assessment` (YMD 2024 1 16) (YMD 2020 1 15) FALSE)
-- A misrepresentation or fraud lifts the limit however late the assessment is.
#ASSERT `s 22(3) — the Minister may still make the assessment` (YMD 2031 6 1) (YMD 2020 1 15) TRUE
-- A due day of 29 February 2020 runs to 29 February 2024, which exists (2024 is a leap year).
#ASSERT `s 22(3) — the Minister may still make the assessment` (YMD 2024 2 29) (YMD 2020 2 29) FALSE
#ASSERT NOT (`s 22(3) — the Minister may still make the assessment` (YMD 2024 3 1) (YMD 2020 2 29) FALSE)

§§ `s 23(1) and (2) -- debt, and the Income Tax Act provisions`

#ASSERT `s 23(1) — the amount is a debt due to Her Majesty` TRUE
#ASSERT NOT (`s 23(1) — the amount is a debt due to Her Majesty` FALSE)
#ASSERT `s 23(1) — Her Majesty may recover the debt in that forum or manner` TRUE TRUE FALSE
#ASSERT `s 23(1) — Her Majesty may recover the debt in that forum or manner` TRUE FALSE TRUE
#ASSERT NOT (`s 23(1) — Her Majesty may recover the debt in that forum or manner` TRUE FALSE FALSE)
#ASSERT NOT (`s 23(1) — Her Majesty may recover the debt in that forum or manner` FALSE TRUE TRUE)
#ASSERT `s 23(2) — the listed provisions of the Income Tax Act apply to the amount` TRUE
#ASSERT NOT (`s 23(2) — the listed provisions of the Income Tax Act apply to the amount` FALSE)
#ASSERT `s 23(2)(b) — subsection 224(1.2) of the Income Tax Act applies to the amount` TRUE FALSE
#ASSERT NOT (`s 23(2)(b) — subsection 224(1.2) of the Income Tax Act applies to the amount` TRUE TRUE)
#ASSERT NOT (`s 23(2)(b) — subsection 224(1.2) of the Income Tax Act applies to the amount` FALSE FALSE)

§§ `s 23(3) to (4.1) -- the deemed trust`

#ASSERT `s 23(3) — the employer is deemed to hold the amount in trust for Her Majesty` TRUE FALSE
#ASSERT NOT (`s 23(3) — the employer is deemed to hold the amount in trust for Her Majesty` TRUE TRUE)
#ASSERT NOT (`s 23(3) — the employer is deemed to hold the amount in trust for Her Majesty` FALSE FALSE)
#ASSERT `s 23(3) — the amount the employer is deemed to hold in trust for Her Majesty` 900 400 EQUALS 500
#ASSERT `s 23(3) — the amount the employer is deemed to hold in trust for Her Majesty` 900 900 EQUALS 0
#ASSERT `s 23(3) — the amount the employer is deemed to hold in trust for Her Majesty` 900 0 EQUALS 900

#ASSERT `s 23(4) — the value of the property deemed to be held in trust for Her Majesty` 500 FALSE EQUALS 500
#ASSERT `s 23(4) — the value of the property deemed to be held in trust for Her Majesty` 500 TRUE EQUALS 0
#ASSERT `s 23(4)(a) — the time from which the property is deemed to be held in trust` (YMD 2026 2 27) EQUALS YMD 2026 2 27
#ASSERT `s 23(4) — Her Majesty's claim to the property and its proceeds ranks ahead of the security interest` 500 TRUE FALSE
#ASSERT NOT (`s 23(4) — Her Majesty's claim to the property and its proceeds ranks ahead of the security interest` 0 TRUE FALSE)
#ASSERT NOT (`s 23(4) — Her Majesty's claim to the property and its proceeds ranks ahead of the security interest` 500 FALSE FALSE)
#ASSERT NOT (`s 23(4) — Her Majesty's claim to the property and its proceeds ranks ahead of the security interest` 500 TRUE TRUE)

-- (4.1): a prescribed security interest is not a "security interest" for (3) and (4).
#ASSERT `s 23(4.1) — the interest is a security interest for subsections 23(3) and 23(4)` TRUE FALSE
#ASSERT NOT (`s 23(4.1) — the interest is a security interest for subsections 23(3) and 23(4)` TRUE TRUE)
#ASSERT NOT (`s 23(4.1) — the interest is a security interest for subsections 23(3) and 23(4)` FALSE FALSE)

§§ `s 23(5) to (6) -- the person who winds up another's affairs`

#ASSERT `s 23(5) — the person is a responsible representative` `an executor dealing with another person's estate` TRUE
#ASSERT `s 23(5) — the person is a responsible representative` `a receiver-manager dealing with another person's property` TRUE
#ASSERT `s 23(5) — the person is a responsible representative` `a liquidator of a succession dealing with another person's estate` TRUE
#ASSERT `s 23(5) — the person is a responsible representative` `another like person dealing with another person's property` TRUE
#ASSERT NOT (`s 23(5) — the person is a responsible representative` `a trustee in bankruptcy dealing with another person's property` TRUE)
#ASSERT NOT (`s 23(5) — the person is a responsible representative` `a person of no such kind` TRUE)
#ASSERT NOT (`s 23(5) — the person is a responsible representative` `an executor dealing with another person's estate` FALSE)
#ASSERT `s 23(5) — the responsible representative must obtain a certificate from the Minister before distributing` TRUE TRUE
#ASSERT NOT (`s 23(5) — the responsible representative must obtain a certificate from the Minister before distributing` TRUE FALSE)
#ASSERT NOT (`s 23(5) — the responsible representative must obtain a certificate from the Minister before distributing` FALSE TRUE)
-- The certificate certifies that both sets of amounts are paid, or that security has been accepted.
#ASSERT `s 23(5) — the Minister may certify that the amounts are covered` TRUE TRUE FALSE
#ASSERT `s 23(5) — the Minister may certify that the amounts are covered` FALSE FALSE TRUE
#ASSERT NOT (`s 23(5) — the Minister may certify that the amounts are covered` TRUE FALSE FALSE)
#ASSERT NOT (`s 23(5) — the Minister may certify that the amounts are covered` FALSE TRUE FALSE)

#ASSERT `s 23(5.1) — the responsible representative is personally liable for the amounts` TRUE TRUE FALSE
#ASSERT NOT (`s 23(5.1) — the responsible representative is personally liable for the amounts` TRUE TRUE TRUE)
#ASSERT NOT (`s 23(5.1) — the responsible representative is personally liable for the amounts` TRUE FALSE FALSE)
#ASSERT NOT (`s 23(5.1) — the responsible representative is personally liable for the amounts` FALSE TRUE FALSE)
-- The liability is limited to the value of the property distributed.
#ASSERT `s 23(5.1) — the amount for which the responsible representative is personally liable` TRUE TRUE FALSE 10000 6000 EQUALS 6000
#ASSERT `s 23(5.1) — the amount for which the responsible representative is personally liable` TRUE TRUE FALSE 10000 25000 EQUALS 10000
#ASSERT `s 23(5.1) — the amount for which the responsible representative is personally liable` TRUE TRUE FALSE 10000 10000 EQUALS 10000
#ASSERT `s 23(5.1) — the amount for which the responsible representative is personally liable` TRUE TRUE TRUE 10000 6000 EQUALS 0

#ASSERT `s 23(6) — the trustee in bankruptcy is deemed to be the agent of the bankrupt for all purposes of this Act` TRUE TRUE
#ASSERT NOT (`s 23(6) — the trustee in bankruptcy is deemed to be the agent of the bankrupt for all purposes of this Act` TRUE FALSE)
#ASSERT NOT (`s 23(6) — the trustee in bankruptcy is deemed to be the agent of the bankrupt for all purposes of this Act` FALSE TRUE)
