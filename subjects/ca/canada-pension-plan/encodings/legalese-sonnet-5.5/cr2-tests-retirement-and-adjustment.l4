IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cr2-retirement-and-adjustment`

-- Tests of cr2-retirement-and-adjustment.l4 (regulations 61 and 62). Layer 1.
-- Every expected value was decided by reading the regulation and doing the arithmetic by hand before the rules were run.

§ `Tests -- regulations 61 and 62`

§§ `61 -- the statement an applicant files`

-- Arguments: an applicant for a retirement pension; the year of the application; the Minister requires the preceding year; the year in question.
#ASSERT `reg 61 — the applicant must file a statement of contributory salary and wages and contributory self-employed earnings for a year` TRUE 2026 FALSE 2026
#ASSERT NOT (`reg 61 — the applicant must file a statement of contributory salary and wages and contributory self-employed earnings for a year` TRUE 2026 FALSE 2025)
#ASSERT `reg 61 — the applicant must file a statement of contributory salary and wages and contributory self-employed earnings for a year` TRUE 2026 TRUE 2025
#ASSERT `reg 61 — the applicant must file a statement of contributory salary and wages and contributory self-employed earnings for a year` TRUE 2026 TRUE 2026
-- no other year, whatever the Minister requires
#ASSERT NOT (`reg 61 — the applicant must file a statement of contributory salary and wages and contributory self-employed earnings for a year` TRUE 2026 TRUE 2024)
#ASSERT NOT (`reg 61 — the applicant must file a statement of contributory salary and wages and contributory self-employed earnings for a year` TRUE 2026 TRUE 2027)
#ASSERT NOT (`reg 61 — the applicant must file a statement of contributory salary and wages and contributory self-employed earnings for a year` FALSE 2026 FALSE 2026)
#ASSERT `reg 61 — the years for which the applicant must file a statement` 2026 FALSE EQUALS (LIST 2026)
#ASSERT `reg 61 — the years for which the applicant must file a statement` 2026 TRUE EQUALS (LIST 2026, 2025)

§§ `62(2) -- the product adjusted to the nearest cent (the third digit decides)`

-- third digit less than five: dropped
#ASSERT `reg 62(2) — a product adjusted to the nearest cent` 1.234 EQUALS 1.23
#ASSERT `reg 62(2) — a product adjusted to the nearest cent` 1.2349 EQUALS 1.23
-- third digit five: the second digit is increased by one
#ASSERT `reg 62(2) — a product adjusted to the nearest cent` 1.235 EQUALS 1.24
#ASSERT `reg 62(2) — a product adjusted to the nearest cent` 1.236 EQUALS 1.24
-- a carry through the cents
#ASSERT `reg 62(2) — a product adjusted to the nearest cent` 1.995 EQUALS 2
-- fewer than three digits: unchanged
#ASSERT `reg 62(2) — a product adjusted to the nearest cent` 1.99 EQUALS 1.99
#ASSERT `reg 62(2) — a product adjusted to the nearest cent` 100 EQUALS 100
-- a fraction with endless digits whose third digit is 3
#ASSERT `reg 62(2) — a product adjusted to the nearest cent` (10 DIVIDED BY 3) EQUALS 3.33
#ASSERT `reg 62(2) — a product adjusted to the nearest cent` (20 DIVIDED BY 3) EQUALS 6.67

§§ `62(3) -- the ratio expressed as a decimal fraction (the fourth digit decides)`

#ASSERT `reg 62(3) — a ratio expressed as a decimal fraction` 1.0234 EQUALS 1.023
#ASSERT `reg 62(3) — a ratio expressed as a decimal fraction` 1.02349 EQUALS 1.023
#ASSERT `reg 62(3) — a ratio expressed as a decimal fraction` 1.0235 EQUALS 1.024
#ASSERT `reg 62(3) — a ratio expressed as a decimal fraction` 1.0236 EQUALS 1.024
#ASSERT `reg 62(3) — a ratio expressed as a decimal fraction` 0.9995 EQUALS 1
#ASSERT `reg 62(3) — a ratio expressed as a decimal fraction` 1.5 EQUALS 1.5
#ASSERT `reg 62(3) — a ratio expressed as a decimal fraction` 1.023 EQUALS 1.023

§§ `62(1) -- the adjusted basic monthly amount`

-- 800.00 x ratio 1.0235 (expressed as 1.024) = 819.20.
#ASSERT `reg 62(1) — the basic monthly amount of a benefit after the annual adjustment` 800 1.0235 EQUALS 819.2
-- 725.37 x 1.024 = 742.77888: the third digit is 7, so the cents become 78. (With the unrounded ratio it would be 742.42.)
#ASSERT `reg 62(1) — the basic monthly amount of a benefit after the annual adjustment` 725.37 1.0235 EQUALS 742.78
-- a ratio of exactly 1 leaves the amount alone
#ASSERT `reg 62(1) — the basic monthly amount of a benefit after the annual adjustment` 725.37 1 EQUALS 725.37
