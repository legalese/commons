IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cr2-cancellation`

-- Tests of cr2-cancellation.l4 (regulation 46.2). Layer 1.
-- Every expected value was decided by reading regulation 46.2 and counting on a calendar before the rules were run.

§ `Tests -- regulation 46.2`

§§ `46.2(1) -- 12 months from the commencement of payment`

-- Payment began 15 March 2026: the 12 months expire on 15 March 2027.
#ASSERT `reg 46.2(1) — the last day to ask for the cancellation of a benefit` (YearMonthDay 2026 3 15) EQUALS (YearMonthDay 2027 3 15)
-- Payment began on a leap day: the same day a year on does not exist, so the last day of February (fork F1 of the core).
#ASSERT `reg 46.2(1) — the last day to ask for the cancellation of a benefit` (YearMonthDay 2024 2 29) EQUALS (YearMonthDay 2025 2 28)
-- Arguments: date payment began; date of the request; the request is in writing.
#ASSERT `reg 46.2(1) — a beneficiary's request that a benefit be cancelled is made in time and in writing` (YearMonthDay 2026 3 15) (YearMonthDay 2027 3 15) TRUE
#ASSERT `reg 46.2(1) — a beneficiary's request that a benefit be cancelled is made in time and in writing` (YearMonthDay 2026 3 15) (YearMonthDay 2026 3 15) TRUE
#ASSERT NOT (`reg 46.2(1) — a beneficiary's request that a benefit be cancelled is made in time and in writing` (YearMonthDay 2026 3 15) (YearMonthDay 2027 3 16) TRUE)
#ASSERT NOT (`reg 46.2(1) — a beneficiary's request that a benefit be cancelled is made in time and in writing` (YearMonthDay 2026 3 15) (YearMonthDay 2026 3 14) TRUE)
#ASSERT NOT (`reg 46.2(1) — a beneficiary's request that a benefit be cancelled is made in time and in writing` (YearMonthDay 2026 3 15) (YearMonthDay 2026 6 1) FALSE)

§§ `46.2(2) -- deemed request`

-- Arguments: in receipt of a retirement pension; a day in the month deemed disabled; a day in the month the retirement pension became payable.
#ASSERT `reg 46.2(2) — the application for a disability pension is deemed to be a request for the cancellation of the retirement pension` TRUE (YearMonthDay 2019 12 31) (YearMonthDay 2020 1 1)
-- the same month is not "before the month in which the retirement pension became payable"
#ASSERT NOT (`reg 46.2(2) — the application for a disability pension is deemed to be a request for the cancellation of the retirement pension` TRUE (YearMonthDay 2020 1 31) (YearMonthDay 2020 1 1))
#ASSERT NOT (`reg 46.2(2) — the application for a disability pension is deemed to be a request for the cancellation of the retirement pension` TRUE (YearMonthDay 2020 2 1) (YearMonthDay 2020 1 1))
#ASSERT NOT (`reg 46.2(2) — the application for a disability pension is deemed to be a request for the cancellation of the retirement pension` FALSE (YearMonthDay 2019 6 1) (YearMonthDay 2020 1 1))

§§ `46.2(2.1) -- comparable provincial benefit`

-- Notice of the decision received 1 February 2026: 90 days after is 2 May 2026.
#ASSERT `reg 46.2(2.1) — the last day to ask for the cancellation of the retirement pension` (YearMonthDay 2026 2 1) EQUALS (YearMonthDay 2026 5 2)
-- Arguments: in receipt of a retirement pension; a day in the month deemed disabled; a day in the month the pension became payable;
-- day payment of the retirement pension began; date notice received; date of the request; request in writing.
#ASSERT `reg 46.2(2.1) — an applicant for a comparable provincial benefit may request the cancellation of the retirement pension` TRUE (YearMonthDay 2024 11 5) (YearMonthDay 2025 6 1) (YearMonthDay 2025 6 1) (YearMonthDay 2026 2 1) (YearMonthDay 2026 5 2) TRUE
#ASSERT NOT (`reg 46.2(2.1) — an applicant for a comparable provincial benefit may request the cancellation of the retirement pension` TRUE (YearMonthDay 2024 11 5) (YearMonthDay 2025 6 1) (YearMonthDay 2025 6 1) (YearMonthDay 2026 2 1) (YearMonthDay 2026 5 3) TRUE)
-- before payment of the retirement pension began there is nothing to cancel
#ASSERT NOT (`reg 46.2(2.1) — an applicant for a comparable provincial benefit may request the cancellation of the retirement pension` TRUE (YearMonthDay 2024 11 5) (YearMonthDay 2025 6 1) (YearMonthDay 2025 6 1) (YearMonthDay 2026 2 1) (YearMonthDay 2025 5 31) TRUE)
#ASSERT NOT (`reg 46.2(2.1) — an applicant for a comparable provincial benefit may request the cancellation of the retirement pension` TRUE (YearMonthDay 2024 11 5) (YearMonthDay 2025 6 1) (YearMonthDay 2025 6 1) (YearMonthDay 2026 2 1) (YearMonthDay 2026 3 1) FALSE)
-- disabled in the same month the pension became payable: not before it
#ASSERT NOT (`reg 46.2(2.1) — an applicant for a comparable provincial benefit may request the cancellation of the retirement pension` TRUE (YearMonthDay 2025 6 20) (YearMonthDay 2025 6 1) (YearMonthDay 2025 6 1) (YearMonthDay 2026 2 1) (YearMonthDay 2026 3 1) TRUE)
#ASSERT NOT (`reg 46.2(2.1) — an applicant for a comparable provincial benefit may request the cancellation of the retirement pension` FALSE (YearMonthDay 2024 11 5) (YearMonthDay 2025 6 1) (YearMonthDay 2025 6 1) (YearMonthDay 2026 2 1) (YearMonthDay 2026 3 1) TRUE)

§§ `46.2(2.2) -- cancelling the disability pension`

-- Notice of entitlement received 1 February 2026: 60 days after is 2 April 2026.
#ASSERT `reg 46.2(2.2) — the last day to ask for the cancellation of the disability pension` (YearMonthDay 2026 2 1) EQUALS (YearMonthDay 2026 4 2)
-- Arguments: an applicant referred to in subsection (2); date notice received; date of the request; request in writing.
#ASSERT `reg 46.2(2.2) — an applicant may request the cancellation of the disability pension and the reinstatement of the retirement pension` TRUE (YearMonthDay 2026 2 1) (YearMonthDay 2026 4 2) TRUE
#ASSERT `reg 46.2(2.2) — an applicant may request the cancellation of the disability pension and the reinstatement of the retirement pension` TRUE (YearMonthDay 2026 2 1) (YearMonthDay 2026 2 1) TRUE
#ASSERT NOT (`reg 46.2(2.2) — an applicant may request the cancellation of the disability pension and the reinstatement of the retirement pension` TRUE (YearMonthDay 2026 2 1) (YearMonthDay 2026 4 3) TRUE)
#ASSERT NOT (`reg 46.2(2.2) — an applicant may request the cancellation of the disability pension and the reinstatement of the retirement pension` TRUE (YearMonthDay 2026 2 1) (YearMonthDay 2026 1 31) TRUE)
#ASSERT NOT (`reg 46.2(2.2) — an applicant may request the cancellation of the disability pension and the reinstatement of the retirement pension` FALSE (YearMonthDay 2026 2 1) (YearMonthDay 2026 3 1) TRUE)
#ASSERT NOT (`reg 46.2(2.2) — an applicant may request the cancellation of the disability pension and the reinstatement of the retirement pension` TRUE (YearMonthDay 2026 2 1) (YearMonthDay 2026 3 1) FALSE)

§§ `46.2(3) -- the Minister must grant the request`

-- Arguments: in accordance with (1); with (2.1); with (2.2); deemed under (2).
#ASSERT `reg 46.2(3) — the Minister must grant the request` TRUE FALSE FALSE FALSE
#ASSERT `reg 46.2(3) — the Minister must grant the request` FALSE TRUE FALSE FALSE
#ASSERT `reg 46.2(3) — the Minister must grant the request` FALSE FALSE TRUE FALSE
#ASSERT `reg 46.2(3) — the Minister must grant the request` FALSE FALSE FALSE TRUE
#ASSERT NOT (`reg 46.2(3) — the Minister must grant the request` FALSE FALSE FALSE FALSE)

§§ `46.2(4) -- repaying within 12 months following the month of granting`

-- Granted 10 March 2026: the 12 months following March 2026 end with March 2027.
#ASSERT `reg 46.2(4) — the last day to repay the amount described in subsection 66.1(2) of the Act` (YearMonthDay 2026 3 10) EQUALS (YearMonthDay 2027 3 31)
-- Granted on the first or last day of the month: the same month.
#ASSERT `reg 46.2(4) — the last day to repay the amount described in subsection 66.1(2) of the Act` (YearMonthDay 2026 1 31) EQUALS (YearMonthDay 2027 1 31)
#ASSERT `reg 46.2(4) — the last day to repay the amount described in subsection 66.1(2) of the Act` (YearMonthDay 2026 1 1) EQUALS (YearMonthDay 2027 1 31)
-- Granted in December: the 12 months run to the following December.
#ASSERT `reg 46.2(4) — the last day to repay the amount described in subsection 66.1(2) of the Act` (YearMonthDay 2026 12 1) EQUALS (YearMonthDay 2027 12 31)
-- Granted in February 2023: the 12 months end with February 2024, a leap year.
#ASSERT `reg 46.2(4) — the last day to repay the amount described in subsection 66.1(2) of the Act` (YearMonthDay 2023 2 15) EQUALS (YearMonthDay 2024 2 29)
-- Arguments: a request referred to in subsection 66.1(2) is granted; date granted; date of repayment.
#ASSERT `reg 46.2(4) — a repayment is made within the time the regulation allows` TRUE (YearMonthDay 2026 3 10) (YearMonthDay 2027 3 31)
#ASSERT `reg 46.2(4) — a repayment is made within the time the regulation allows` TRUE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 10)
#ASSERT NOT (`reg 46.2(4) — a repayment is made within the time the regulation allows` TRUE (YearMonthDay 2026 3 10) (YearMonthDay 2027 4 1))
#ASSERT NOT (`reg 46.2(4) — a repayment is made within the time the regulation allows` TRUE (YearMonthDay 2026 3 10) (YearMonthDay 2026 3 9))
#ASSERT NOT (`reg 46.2(4) — a repayment is made within the time the regulation allows` FALSE (YearMonthDay 2026 3 10) (YearMonthDay 2026 6 1))
