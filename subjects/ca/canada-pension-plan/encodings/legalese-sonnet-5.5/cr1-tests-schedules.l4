IMPORT prelude
IMPORT `cpp-core`
IMPORT `cr1-schedules`

-- Tests of cr1-schedules.l4 (Schedules III to IX). Every expected value is written from the text
-- (C.R.C.-c.-385.txt lines 899 to 1154) before the run. The counts are counted by hand from the text: Schedule III
-- 9 items; IV 69 lettered or unlettered paragraphs (Ontario 2, Alberta 3, Manitoba 1, Newfoundland 4, Nova Scotia 2
-- because (c) is repealed, British Columbia 1, Saskatchewan 2 because (a) is repealed, Prince Edward Island 3, New
-- Brunswick 51 = its opening words and (a) to (xx)); V 6; VI 18 (4+2+2+2+4+4); VII 9 (the others are repealed);
-- VIII 24 (3+3+3+4+3+1+1+3+3); IX 51 rows.

§ `Tests of Schedules III to IX`

§§ `The data: how many paragraphs each Schedule carries`

#ASSERT count `Schedule III` EQUALS 9
#ASSERT count `Schedule IV` EQUALS 69
#ASSERT count `Schedule V` EQUALS 6
#ASSERT count `Schedule VI` EQUALS 18
#ASSERT count `Schedule VII` EQUALS 9
#ASSERT count `Schedule VIII` EQUALS 24
#ASSERT count `Schedule IX` EQUALS 51
-- A few words, copied by hand from the text lines named.
#ASSERT (`Schedule III, item 1`'s `the words of the paragraph`) EQUALS "1 Province of Ontario."
#ASSERT (`Schedule IV, item 1, paragraph (a)`'s `the words of the paragraph`) EQUALS "(a) Employment as a judge appointed by the Government of Canada."
#ASSERT (`Schedule IV, item 9, paragraph (xx)`'s `the item heading`) EQUALS "Province of New Brunswick"
#ASSERT (`Schedule VII, item 21`'s `the words of the paragraph`) EQUALS "21 Senegal."
#ASSERT (`Schedule VIII, item 6, paragraph (b)`'s `the paragraph`) EQUALS "(b)"
#ASSERT (`Schedule IX, row 1`'s `the item heading`) EQUALS "Antigua and Barbuda"

§§ `Schedule III: the nine provinces`

#ASSERT `Schedule III — the province is named` "Province of Ontario"
#ASSERT `Schedule III — the province is named` "Province of Alberta"
#ASSERT `Schedule III — the province is named` "Province of Manitoba"
#ASSERT `Schedule III — the province is named` "Province of Newfoundland"
#ASSERT `Schedule III — the province is named` "Province of Nova Scotia"
#ASSERT `Schedule III — the province is named` "Province of British Columbia"
#ASSERT `Schedule III — the province is named` "Province of Saskatchewan"
#ASSERT `Schedule III — the province is named` "Province of Prince Edward Island"
#ASSERT `Schedule III — the province is named` "Province of New Brunswick"
-- Quebec, which has its own plan, and the territories are not named.
#ASSERT NOT (`Schedule III — the province is named` "Province of Quebec")
#ASSERT NOT (`Schedule III — the province is named` "Yukon")

§§ `Schedule IV: employment set out for a province`

#ASSERT `Schedule IV — the employment is set out` "Province of Ontario" "(a)" TRUE FALSE
#ASSERT `Schedule IV — the employment is set out` "Province of Ontario" "(b)" TRUE FALSE
#ASSERT NOT (`Schedule IV — the employment is set out` "Province of Ontario" "(a)" FALSE FALSE)
-- Ontario has no paragraph (c) and no unlettered paragraph.
#ASSERT NOT (`Schedule IV — the employment is set out` "Province of Ontario" "(c)" TRUE FALSE)
#ASSERT NOT (`Schedule IV — the employment is set out` "Province of Ontario" "" TRUE FALSE)
#ASSERT `Schedule IV — the employment is set out` "Province of Alberta" "(c)" TRUE FALSE
-- Manitoba and British Columbia have one unlettered paragraph each.
#ASSERT `Schedule IV — the employment is set out` "Province of Manitoba" "" TRUE FALSE
#ASSERT `Schedule IV — the employment is set out` "Province of British Columbia" "" TRUE FALSE
#ASSERT `Schedule IV — the employment is set out` "Province of Newfoundland" "(d)" TRUE FALSE
#ASSERT `Schedule IV — the employment is set out` "Province of Nova Scotia" "(b)" TRUE FALSE
-- Nova Scotia (c) and Saskatchewan (a) are repealed.
#ASSERT NOT (`Schedule IV — the employment is set out` "Province of Nova Scotia" "(c)" TRUE FALSE)
#ASSERT NOT (`Schedule IV — the employment is set out` "Province of Saskatchewan" "(a)" TRUE FALSE)
#ASSERT `Schedule IV — the employment is set out` "Province of Saskatchewan" "(b)" TRUE FALSE
#ASSERT `Schedule IV — the employment is set out` "Province of Prince Edward Island" "(c)" TRUE FALSE
-- New Brunswick: a listed board, but not for a full-time salaried member or employee; the opening words alone set nothing out.
#ASSERT `Schedule IV — the employment is set out` "Province of New Brunswick" "(f)" TRUE FALSE
#ASSERT `Schedule IV — the employment is set out` "Province of New Brunswick" "(xx)" TRUE FALSE
#ASSERT NOT (`Schedule IV — the employment is set out` "Province of New Brunswick" "(f)" TRUE TRUE)
#ASSERT NOT (`Schedule IV — the employment is set out` "Province of New Brunswick" "(f)" FALSE FALSE)
#ASSERT NOT (`Schedule IV — the employment is set out` "Province of New Brunswick" "" TRUE FALSE)
#ASSERT NOT (`Schedule IV — the employment is set out` "Province of New Brunswick" "(yy)" TRUE FALSE)
-- The full-time salaried exception is New Brunswick's only.
#ASSERT `Schedule IV — the employment is set out` "Province of Ontario" "(a)" TRUE TRUE

§§ `Schedule V: the six organizations`

#ASSERT `Schedule V — the organization is named` "Northwest Atlantic Fisheries Organization"
#ASSERT `Schedule V — the organization is named` "International Pacific Salmon Fisheries Commission"
#ASSERT `Schedule V — the organization is named` "International North Pacific Fisheries Commission"
#ASSERT `Schedule V — the organization is named` "Commonwealth of Learning"
#ASSERT `Schedule V — the organization is named` "North Pacific Marine Science Organization"
#ASSERT `Schedule V — the organization is named` "North Pacific Anadromous Fish Commission"
#ASSERT NOT (`Schedule V — the organization is named` "United Nations")

§§ `Schedule VI: employment by an organization that is excepted`

GIVEN facts IS A LIST OF STRING
GIVETH A `cr1 Person employed by an international organization`
`cr1 test organization person` facts MEANS `cr1 Person employed by an international organization` WITH
    `exempt from Canadian income tax by virtue of a Tax Convention to which Canada is a party` IS elem "convention" facts
    `exempt from Canadian income tax by virtue of paragraph 149(1)(a) of the Income Tax Act` IS elem "149a" facts
    `exempt from Canadian income tax by virtue of an order of the Governor in Council` IS elem "order" facts
    `a citizen within the meaning of section 3 of the Citizenship Act` IS elem "citizen" facts
    `a permanent resident as defined in subsection 2(1) of the Immigration Act` IS elem "resident" facts
    `an official of the Commonwealth of Learning` IS elem "official" facts

-- Items 1, 5 and 6: (a) tax convention, (b) paragraph 149(1)(a), (c) order of the Governor in Council, (d) neither a citizen nor a permanent resident.
#ASSERT `Schedule VI — the employment is set out` "Northwest Atlantic Fisheries Organization" (`cr1 test organization person` (LIST "convention", "citizen")) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "Northwest Atlantic Fisheries Organization" (`cr1 test organization person` (LIST "149a", "citizen")) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "Northwest Atlantic Fisheries Organization" (`cr1 test organization person` (LIST "order", "resident")) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "Northwest Atlantic Fisheries Organization" (`cr1 test organization person` EMPTY) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "Northwest Atlantic Fisheries Organization" (`cr1 test organization person` (LIST "citizen")) EQUALS JUST FALSE
#ASSERT `Schedule VI — the employment is set out` "Northwest Atlantic Fisheries Organization" (`cr1 test organization person` (LIST "resident")) EQUALS JUST FALSE
#ASSERT `Schedule VI — the employment is set out` "Northwest Atlantic Fisheries Organization" (`cr1 test organization person` (LIST "citizen", "resident")) EQUALS JUST FALSE
#ASSERT `Schedule VI — the employment is set out` "North Pacific Marine Science Organization" (`cr1 test organization person` (LIST "order", "citizen")) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "North Pacific Marine Science Organization" (`cr1 test organization person` (LIST "resident")) EQUALS JUST FALSE
#ASSERT `Schedule VI — the employment is set out` "North Pacific Anadromous Fish Commission" (`cr1 test organization person` (LIST "convention", "resident")) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "North Pacific Anadromous Fish Commission" (`cr1 test organization person` EMPTY) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "North Pacific Anadromous Fish Commission" (`cr1 test organization person` (LIST "citizen")) EQUALS JUST FALSE
-- Items 2 and 3: (a) tax convention, (b) paragraph 149(1)(a); an order of the Governor in Council, or no citizenship, is not enough.
#ASSERT `Schedule VI — the employment is set out` "International Pacific Salmon Fisheries Commission" (`cr1 test organization person` (LIST "convention", "citizen")) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "International Pacific Salmon Fisheries Commission" (`cr1 test organization person` (LIST "149a")) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "International Pacific Salmon Fisheries Commission" (`cr1 test organization person` (LIST "order")) EQUALS JUST FALSE
#ASSERT `Schedule VI — the employment is set out` "International Pacific Salmon Fisheries Commission" (`cr1 test organization person` EMPTY) EQUALS JUST FALSE
#ASSERT `Schedule VI — the employment is set out` "International North Pacific Fisheries Commission" (`cr1 test organization person` (LIST "convention")) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "International North Pacific Fisheries Commission" (`cr1 test organization person` (LIST "149a")) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "International North Pacific Fisheries Commission" (`cr1 test organization person` (LIST "order")) EQUALS JUST FALSE
-- Item 4: (a) an official of the Commonwealth of Learning, (b) paragraph 149(1)(a).
#ASSERT `Schedule VI — the employment is set out` "Commonwealth of Learning" (`cr1 test organization person` (LIST "official")) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "Commonwealth of Learning" (`cr1 test organization person` (LIST "149a")) EQUALS JUST TRUE
#ASSERT `Schedule VI — the employment is set out` "Commonwealth of Learning" (`cr1 test organization person` (LIST "convention", "order")) EQUALS JUST FALSE
-- An organization with no entry in Schedule VI.
#ASSERT `Schedule VI — the employment is set out` "United Nations" (`cr1 test organization person` (LIST "convention")) EQUALS NOTHING
-- The keys used by the rule are headings that Schedule VI carries.
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VI` "Northwest Atlantic Fisheries Organization"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VI` "International Pacific Salmon Fisheries Commission"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VI` "International North Pacific Fisheries Commission"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VI` "Commonwealth of Learning"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VI` "North Pacific Marine Science Organization"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VI` "North Pacific Anadromous Fish Commission"

§§ `Schedule VII: the governments`

#ASSERT `Schedule VII — the government is named` "New Zealand"
#ASSERT `Schedule VII — the government is named` "Australia"
#ASSERT `Schedule VII — the government is named` "France"
#ASSERT `Schedule VII — the government is named` "United States"
#ASSERT `Schedule VII — the government is named` "Japan"
#ASSERT `Schedule VII — the government is named` "India"
#ASSERT `Schedule VII — the government is named` "South Africa"
#ASSERT `Schedule VII — the government is named` "Malaysia"
#ASSERT `Schedule VII — the government is named` "Senegal"
#ASSERT NOT (`Schedule VII — the government is named` "Germany")

§§ `Schedule VIII: employment by those governments that is excepted`

GIVEN facts IS A LIST OF STRING
GIVETH A `cr1 Person employed by a foreign government`
`cr1 test foreign person` facts MEANS `cr1 Person employed by a foreign government` WITH
    `a subject or citizen of New Zealand` IS elem "nz" facts
    `exempt from Canadian income tax by virtue of the New Zealand-Canada Tax Convention` IS elem "nz tax" facts
    `a citizen of Canada` IS elem "canadian" facts
    `permanently resident in Canada` IS elem "resident" facts
    `contributes to a pension plan of the French Republic, or has contributions made on their behalf to such a plan by the French Republic` IS elem "french plan" facts
    `exempt from Canadian income tax` IS elem "exempt" facts
    `a citizen of the United States` IS elem "us" facts
    `participates in the Civil Service Retirement System of the United States or another pension plan financed by the Government of the United States, has done so continuously since before October 1, 1983 and has elected not to participate in the Canada Pension Plan` IS elem "csrs" facts
    `a locally engaged employee of the Government of the United States` IS elem "local" facts
    `a national of Japan` IS elem "japanese" facts
    `a national of Canada` IS elem "national of canada" facts
    `exempt from Canadian income tax by virtue of the Canada-Japan Income Tax Convention Act, 1965` IS elem "japan tax" facts
    `exempt from Canadian income tax by virtue of paragraph 149(1)(a) of the Income Tax Act` IS elem "149a" facts
    `exempt from Canadian income tax by virtue of paragraph 149(1)(b) of the Income Tax Act` IS elem "149b" facts
    `participates in the Government of Malaysia's non-contributory gratuity scheme` IS elem "gratuity" facts
    `a citizen of Senegal` IS elem "senegalese" facts

#ASSERT `Schedule VIII — the employment is set out` "New Zealand" (`cr1 test foreign person` (LIST "nz")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "New Zealand" (`cr1 test foreign person` (LIST "nz tax")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "New Zealand" (`cr1 test foreign person` (LIST "canadian", "resident")) EQUALS JUST FALSE
-- Australia: (a) is not a citizen of Canada; or (b) is not permanently resident in Canada.
#ASSERT `Schedule VIII — the employment is set out` "Australia" (`cr1 test foreign person` (LIST "resident")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "Australia" (`cr1 test foreign person` (LIST "canadian")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "Australia" (`cr1 test foreign person` EMPTY) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "Australia" (`cr1 test foreign person` (LIST "canadian", "resident")) EQUALS JUST FALSE
#ASSERT `Schedule VIII — the employment is set out` "France" (`cr1 test foreign person` (LIST "french plan")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "France" (`cr1 test foreign person` (LIST "exempt")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "France" (`cr1 test foreign person` EMPTY) EQUALS JUST FALSE
-- United States: (a) citizen, (b) the pension-plan participant, (c) not a locally engaged employee.
#ASSERT `Schedule VIII — the employment is set out` "United States" (`cr1 test foreign person` (LIST "us", "local")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "United States" (`cr1 test foreign person` (LIST "csrs", "local")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "United States" (`cr1 test foreign person` EMPTY) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "United States" (`cr1 test foreign person` (LIST "local")) EQUALS JUST FALSE
-- Japan: (a) a national of Japan and neither a national of Canada nor permanently resident in Canada; (b) the Canada-Japan convention.
#ASSERT `Schedule VIII — the employment is set out` "Japan" (`cr1 test foreign person` (LIST "japanese")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "Japan" (`cr1 test foreign person` (LIST "japanese", "resident")) EQUALS JUST FALSE
#ASSERT `Schedule VIII — the employment is set out` "Japan" (`cr1 test foreign person` (LIST "japanese", "national of canada")) EQUALS JUST FALSE
#ASSERT `Schedule VIII — the employment is set out` "Japan" (`cr1 test foreign person` (LIST "japan tax", "resident")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "Japan" (`cr1 test foreign person` EMPTY) EQUALS JUST FALSE
-- India and South Africa: paragraph 149(1)(a) or (b) of the Income Tax Act.
#ASSERT `Schedule VIII — the employment is set out` "India" (`cr1 test foreign person` (LIST "149a")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "India" (`cr1 test foreign person` (LIST "149b")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "India" (`cr1 test foreign person` EMPTY) EQUALS JUST FALSE
#ASSERT `Schedule VIII — the employment is set out` "South Africa" (`cr1 test foreign person` (LIST "149b")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "South Africa" (`cr1 test foreign person` (LIST "exempt")) EQUALS JUST FALSE
-- Malaysia: (a) paragraph 149(1)(a) only, (b) the gratuity scheme.
#ASSERT `Schedule VIII — the employment is set out` "Malaysia" (`cr1 test foreign person` (LIST "149a")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "Malaysia" (`cr1 test foreign person` (LIST "gratuity")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "Malaysia" (`cr1 test foreign person` (LIST "149b")) EQUALS JUST FALSE
-- Senegal: (a) a citizen of Senegal not permanently resident in Canada; (b) paragraph 149(1)(a) or (b).
#ASSERT `Schedule VIII — the employment is set out` "Senegal" (`cr1 test foreign person` (LIST "senegalese")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "Senegal" (`cr1 test foreign person` (LIST "senegalese", "resident")) EQUALS JUST FALSE
#ASSERT `Schedule VIII — the employment is set out` "Senegal" (`cr1 test foreign person` (LIST "149a", "resident")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "Senegal" (`cr1 test foreign person` (LIST "149b")) EQUALS JUST TRUE
#ASSERT `Schedule VIII — the employment is set out` "Senegal" (`cr1 test foreign person` EMPTY) EQUALS JUST FALSE
-- A government with no entry in Schedule VIII (Schedule VII's repealed items have none either).
#ASSERT `Schedule VIII — the employment is set out` "Germany" (`cr1 test foreign person` (LIST "exempt")) EQUALS NOTHING
-- The keys used by the rule are headings that Schedule VIII carries.
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VIII` "New Zealand"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VIII` "Australia"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VIII` "France"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VIII` "United States"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VIII` "Japan"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VIII` "India"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VIII` "South Africa"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VIII` "Malaysia"
#ASSERT `cr1 helper: a Schedule names an item` `Schedule VIII` "Senegal"

§§ `Schedule IX: the agreements`

#ASSERT `Schedule IX — the country has an agreement referred to` "Australia"
#ASSERT `Schedule IX — the country has an agreement referred to` "Austria (Republic of)"
#ASSERT `Schedule IX — the country has an agreement referred to` "United States of America"
#ASSERT `Schedule IX — the country has an agreement referred to` "Uruguay (Eastern Republic of)"
#ASSERT NOT (`Schedule IX — the country has an agreement referred to` "China")
-- A country with several agreements has several rows: the United States has four, Australia two.
#ASSERT count (filter (GIVEN row YIELD (row's `the item heading`) EQUALS "United States of America") `Schedule IX`) EQUALS 4
#ASSERT count (filter (GIVEN row YIELD (row's `the item heading`) EQUALS "Australia") `Schedule IX`) EQUALS 2
