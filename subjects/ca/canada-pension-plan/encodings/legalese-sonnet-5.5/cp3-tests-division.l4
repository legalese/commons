IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-age`
IMPORT `cp3-nouns`
IMPORT `cp3-division`

-- Tests of cp3-division.l4 (sections 55, 55.1, 55.11 and 55.2(1) to (5.1)). Expected values are worked by hand from the text.

§ `Tests -- section 55(1)`

-- Arguments: in writing to the Minister, by an authorised person, the judgment day, the application day, both agree in writing.
-- a judgment on 15 June 1985, an application on 15 June 1988: 36 months to the day: in time
#ASSERT `s 55(1) — an application for a division of the unadjusted pensionable earnings of former spouses may be made` TRUE TRUE (YMD 1985 6 15) (YMD 1988 6 15) FALSE
-- one day later: out of time unless both agree
#ASSERT NOT `s 55(1) — an application for a division of the unadjusted pensionable earnings of former spouses may be made` TRUE TRUE (YMD 1985 6 15) (YMD 1988 6 16) FALSE
#ASSERT `s 55(1) — an application for a division of the unadjusted pensionable earnings of former spouses may be made` TRUE TRUE (YMD 1985 6 15) (YMD 1995 1 1) TRUE
-- a judgment before 1978
#ASSERT NOT `s 55(1) — an application for a division of the unadjusted pensionable earnings of former spouses may be made` TRUE TRUE (YMD 1977 12 31) (YMD 1978 6 1) FALSE
#ASSERT `s 55(1) — an application for a division of the unadjusted pensionable earnings of former spouses may be made` TRUE TRUE (YMD 1978 1 1) (YMD 1978 6 1) FALSE
-- a judgment in 1987 or later is for section 55.1
#ASSERT `s 55(1) — an application for a division of the unadjusted pensionable earnings of former spouses may be made` TRUE TRUE (YMD 1986 12 31) (YMD 1987 6 1) FALSE
#ASSERT NOT `s 55(1) — an application for a division of the unadjusted pensionable earnings of former spouses may be made` TRUE TRUE (YMD 1987 1 1) (YMD 1987 6 1) FALSE
-- not in writing; not by someone who may apply
#ASSERT NOT `s 55(1) — an application for a division of the unadjusted pensionable earnings of former spouses may be made` FALSE TRUE (YMD 1985 6 15) (YMD 1986 6 15) FALSE
#ASSERT NOT `s 55(1) — an application for a division of the unadjusted pensionable earnings of former spouses may be made` TRUE FALSE (YMD 1985 6 15) (YMD 1986 6 15) FALSE
-- an application before the judgment cannot be "after the date of a judgment"
#ASSERT NOT `s 55(1) — an application for a division of the unadjusted pensionable earnings of former spouses may be made` TRUE TRUE (YMD 1985 6 15) (YMD 1985 6 1) TRUE

§ `Tests -- sections 55(2) to (5)`

#ASSERT `s 55(2)(a) — the former spouses cohabited for at least thirty-six consecutive months during the marriage` 36
#ASSERT NOT `s 55(2)(a) — the former spouses cohabited for at least thirty-six consecutive months during the marriage` 35
#ASSERT `s 55(2)(b) — the day on which the marriage is deemed solemnized or nullified or a divorce is deemed made final` (YMD 1982 3 10) EQUALS (YMD 1981 12 31)
#ASSERT `s 55(2)(b) — the day on which the marriage is deemed solemnized or nullified or a divorce is deemed made final` (YMD 1982 1 1) EQUALS (YMD 1981 12 31)
-- Arguments of (c): the year, the year the marriage was solemnized, the year of the divorce, the former spouses actually cohabited that year.
-- the year of the marriage: deemed cohabiting although they did not
#ASSERT `s 55(2)(c) — the former spouses are deemed to have cohabited during a year` 1970 1970 1985 FALSE
-- the year of the divorce: deemed not, although they did
#ASSERT NOT `s 55(2)(c) — the former spouses are deemed to have cohabited during a year` 1985 1970 1985 TRUE
-- any other year: as it was
#ASSERT `s 55(2)(c) — the former spouses are deemed to have cohabited during a year` 1975 1970 1985 TRUE
#ASSERT NOT `s 55(2)(c) — the former spouses are deemed to have cohabited during a year` 1975 1970 1985 FALSE

-- (3): months of the marriage that are also months of cohabitation (a listed day other than the first still names its month)
#ASSERT `s 55(3) — the months considered in determining the period for which the earnings are divided` (LIST (YMD 2000 1 1), (YMD 2000 2 1), (YMD 2000 3 1), (YMD 2000 4 1)) (LIST (YMD 2000 2 15), (YMD 2000 4 1), (YMD 2001 1 1)) EQUALS LIST (YMD 2000 2 1), (YMD 2000 4 1)
#ASSERT `s 55(3) — the months considered in determining the period for which the earnings are divided` (LIST (YMD 2000 1 1)) EMPTY EQUALS EMPTY

-- (4): (12000 + 4000) / 2 = 8000 each
#ASSERT `s 55(4) — the unadjusted pensionable earnings attributed to each former spouse on a division` TRUE 12000 4000 EQUALS JUST 8000
#ASSERT `s 55(4) — the unadjusted pensionable earnings attributed to each former spouse on a division` FALSE 12000 4000 EQUALS NOTHING
#ASSERT `s 55(5) — the total unadjusted pensionable earnings of a contributor for a year of division under this Act and a provincial pension plan` 6000 2500 EQUALS 8500

§ `Tests -- section 55(6)`

-- Arguments: the month, the former spouses' total earnings in the year, the Year's Basic Exemption, the two dates of birth, retirement pension beneficiary (first, second), excluded for disability (first, second).
-- 10000 > 2 x 3500 = 7000, both over 18 and under 70, no pension, no exclusion: a division is made
#ASSERT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 2005 5 1) 10000 3500 (YMD 1960 6 15) (YMD 1962 8 10) FALSE FALSE FALSE FALSE
-- total equal to twice the exemption: "does not exceed": no division
#ASSERT NOT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 2005 5 1) 7000 3500 (YMD 1960 6 15) (YMD 1962 8 10) FALSE FALSE FALSE FALSE
#ASSERT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 2005 5 1) 7000.01 3500 (YMD 1960 6 15) (YMD 1962 8 10) FALSE FALSE FALSE FALSE
-- born 1 January 1950 and 1 January 1951: 18 deemed on 1 February 1968 and 1 February 1969. January 1968: the first is not yet 18
#ASSERT NOT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 1968 1 1) 10000 3500 (YMD 1950 1 1) (YMD 1951 1 1) FALSE FALSE FALSE FALSE
-- January 1969: the second is not yet 18
#ASSERT NOT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 1969 1 1) 10000 3500 (YMD 1950 1 1) (YMD 1951 1 1) FALSE FALSE FALSE FALSE
-- February 1969: both have reached 18
#ASSERT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 1969 2 1) 10000 3500 (YMD 1950 1 1) (YMD 1951 1 1) FALSE FALSE FALSE FALSE
-- 70: the first is deemed to reach 70 on 1 February 2020; January 2020 is before, February 2020 is after
#ASSERT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 2020 1 1) 10000 3500 (YMD 1950 1 1) (YMD 1951 1 1) FALSE FALSE FALSE FALSE
#ASSERT NOT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 2020 2 1) 10000 3500 (YMD 1950 1 1) (YMD 1951 1 1) FALSE FALSE FALSE FALSE
-- the second's 70th: 1 February 2021
#ASSERT NOT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 2021 2 1) 10000 3500 (YMD 1930 1 1) (YMD 1951 1 1) FALSE FALSE FALSE FALSE
-- a beneficiary of a retirement pension: either one
#ASSERT NOT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 2005 5 1) 10000 3500 (YMD 1960 6 15) (YMD 1962 8 10) TRUE FALSE FALSE FALSE
#ASSERT NOT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 2005 5 1) 10000 3500 (YMD 1960 6 15) (YMD 1962 8 10) FALSE TRUE FALSE FALSE
-- a month excluded by reason of disability: either one
#ASSERT NOT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 2005 5 1) 10000 3500 (YMD 1960 6 15) (YMD 1962 8 10) FALSE FALSE TRUE FALSE
#ASSERT NOT `s 55(6) — a division is made for a month of the period of cohabitation` (YMD 2005 5 1) 10000 3500 (YMD 1960 6 15) (YMD 1962 8 10) FALSE FALSE FALSE TRUE

§ `Tests -- sections 55(7) and 55(8)`

#ASSERT `s 55(7) — the month from which the benefit adjusted for the division is paid` TRUE TRUE (YMD 2005 3 17) EQUALS JUST (YMD 2005 4 1)
#ASSERT `s 55(7) — the month from which the benefit adjusted for the division is paid` TRUE TRUE (YMD 2005 12 31) EQUALS JUST (YMD 2006 1 1)
#ASSERT `s 55(7) — the month from which the benefit adjusted for the division is paid` FALSE TRUE (YMD 2005 3 17) EQUALS NOTHING
#ASSERT `s 55(7) — the month from which the benefit adjusted for the division is paid` TRUE FALSE (YMD 2005 3 17) EQUALS NOTHING
#ASSERT `s 55(8) — the applicant and the former spouse or the former spouse's estate must be notified of the approval` TRUE
#ASSERT NOT `s 55(8) — the applicant and the former spouse or the former spouse's estate must be notified of the approval` FALSE
#ASSERT `s 55(8) — an applicant or a former spouse who is dissatisfied with the division has the right of appeal` TRUE TRUE
#ASSERT NOT `s 55(8) — an applicant or a former spouse who is dissatisfied with the division has the right of appeal` TRUE FALSE
#ASSERT NOT `s 55(8) — an applicant or a former spouse who is dissatisfied with the division has the right of appeal` FALSE TRUE

§ `Tests -- section 55.1(1)`

#ASSERT `s 55.1(1)(a) — a division takes place on a judgment granting a divorce or of nullity of the marriage` TRUE TRUE TRUE
#ASSERT NOT `s 55.1(1)(a) — a division takes place on a judgment granting a divorce or of nullity of the marriage` FALSE TRUE TRUE
#ASSERT NOT `s 55.1(1)(a) — a division takes place on a judgment granting a divorce or of nullity of the marriage` TRUE FALSE TRUE
#ASSERT NOT `s 55.1(1)(a) — a division takes place on a judgment granting a divorce or of nullity of the marriage` TRUE TRUE FALSE

-- Arguments of (b): spouses, application approved, the day of separation, the day of the application, the day one died.
-- separated 15 January 2020, application 15 January 2021: a year to the day
#ASSERT `s 55.1(1)(b) — a division takes place on the approval of an application by spouses living separate and apart` TRUE TRUE (YMD 2020 1 15) (YMD 2021 1 15) NOTHING
#ASSERT NOT `s 55.1(1)(b) — a division takes place on the approval of an application by spouses living separate and apart` TRUE TRUE (YMD 2020 1 15) (YMD 2021 1 14) NOTHING
-- one died on 1 March 2022 after more than a year apart: the application must be made within three years after: by 1 March 2025
#ASSERT `s 55.1(1)(b) — a division takes place on the approval of an application by spouses living separate and apart` TRUE TRUE (YMD 2020 1 15) (YMD 2025 3 1) (JUST (YMD 2022 3 1))
#ASSERT NOT `s 55.1(1)(b) — a division takes place on the approval of an application by spouses living separate and apart` TRUE TRUE (YMD 2020 1 15) (YMD 2025 3 2) (JUST (YMD 2022 3 1))
-- one died on 1 October 2020, before a year apart: limb (i) is not met
#ASSERT NOT `s 55.1(1)(b) — a division takes place on the approval of an application by spouses living separate and apart` TRUE TRUE (YMD 2020 1 15) (YMD 2021 3 1) (JUST (YMD 2020 10 1))
-- no approval; not spouses
#ASSERT NOT `s 55.1(1)(b) — a division takes place on the approval of an application by spouses living separate and apart` TRUE FALSE (YMD 2020 1 15) (YMD 2021 1 15) NOTHING
#ASSERT NOT `s 55.1(1)(b) — a division takes place on the approval of an application by spouses living separate and apart` FALSE TRUE (YMD 2020 1 15) (YMD 2021 1 15) NOTHING

-- Arguments of (c): former common-law partners, approved, the day of separation, the day of the application, the day one died, both agree after four years.
#ASSERT `s 55.1(1)(c) — a division takes place on the approval of an application by former common-law partners living separate and apart` TRUE TRUE (YMD 2020 1 15) (YMD 2021 1 15) NOTHING FALSE
-- under a year apart and no death
#ASSERT NOT `s 55.1(1)(c) — a division takes place on the approval of an application by former common-law partners living separate and apart` TRUE TRUE (YMD 2020 1 15) (YMD 2021 1 14) NOTHING FALSE
-- one died during the separation, before a year: limb (i) is met by the death
#ASSERT `s 55.1(1)(c) — a division takes place on the approval of an application by former common-law partners living separate and apart` TRUE TRUE (YMD 2020 1 15) (YMD 2020 8 1) (JUST (YMD 2020 6 1)) FALSE
-- four years to the day: in time
#ASSERT `s 55.1(1)(c) — a division takes place on the approval of an application by former common-law partners living separate and apart` TRUE TRUE (YMD 2020 1 15) (YMD 2024 1 15) NOTHING FALSE
-- one day later: out of time unless both agree
#ASSERT NOT `s 55.1(1)(c) — a division takes place on the approval of an application by former common-law partners living separate and apart` TRUE TRUE (YMD 2020 1 15) (YMD 2024 1 16) NOTHING FALSE
#ASSERT `s 55.1(1)(c) — a division takes place on the approval of an application by former common-law partners living separate and apart` TRUE TRUE (YMD 2020 1 15) (YMD 2024 1 16) NOTHING TRUE
#ASSERT NOT `s 55.1(1)(c) — a division takes place on the approval of an application by former common-law partners living separate and apart` FALSE TRUE (YMD 2020 1 15) (YMD 2021 1 15) NOTHING FALSE
#ASSERT NOT `s 55.1(1)(c) — a division takes place on the approval of an application by former common-law partners living separate and apart` TRUE FALSE (YMD 2020 1 15) (YMD 2021 1 15) NOTHING FALSE

§ `Tests -- sections 55.1(2) to (5)`

#ASSERT `s 55.1(2)(a) — the persons are deemed to have lived separate and apart for a period` TRUE TRUE
#ASSERT NOT `s 55.1(2)(a) — the persons are deemed to have lived separate and apart for a period` TRUE FALSE
#ASSERT NOT `s 55.1(2)(a) — the persons are deemed to have lived separate and apart for a period` FALSE TRUE
-- Arguments of (b): only reason is incapacity, it appears to the Minister the separation would have continued, only reason is resumed cohabitation, total days, reconciliation the primary purpose.
#ASSERT `s 55.1(2)(b) — a period of living separate and apart is not considered to have been interrupted or terminated` TRUE TRUE FALSE 0 FALSE
#ASSERT NOT `s 55.1(2)(b) — a period of living separate and apart is not considered to have been interrupted or terminated` TRUE FALSE FALSE 0 FALSE
#ASSERT `s 55.1(2)(b) — a period of living separate and apart is not considered to have been interrupted or terminated` FALSE FALSE TRUE 90 TRUE
#ASSERT NOT `s 55.1(2)(b) — a period of living separate and apart is not considered to have been interrupted or terminated` FALSE FALSE TRUE 91 TRUE
#ASSERT NOT `s 55.1(2)(b) — a period of living separate and apart is not considered to have been interrupted or terminated` FALSE FALSE TRUE 30 FALSE
#ASSERT NOT `s 55.1(2)(b) — a period of living separate and apart is not considered to have been interrupted or terminated` FALSE FALSE FALSE 0 FALSE
#ASSERT `s 55.1(3) — the persons subject to a division cohabited for a continuous period of at least one year` TRUE
#ASSERT NOT `s 55.1(3) — the persons subject to a division cohabited for a continuous period of at least one year` FALSE
#ASSERT `s 55.1(4) — the months considered in determining the period for which the earnings are divided` (LIST (YMD 2000 1 1), (YMD 2000 2 1), (YMD 2000 3 1)) (LIST (YMD 2000 3 20), (YMD 1999 12 1)) EQUALS LIST (YMD 2000 3 1)
#ASSERT `s 55.1(5) — the Minister may refuse to make or may cancel a division` TRUE TRUE TRUE
#ASSERT NOT `s 55.1(5) — the Minister may refuse to make or may cancel a division` FALSE TRUE TRUE
#ASSERT NOT `s 55.1(5) — the Minister may refuse to make or may cancel a division` TRUE FALSE TRUE
#ASSERT NOT `s 55.1(5) — the Minister may refuse to make or may cancel a division` TRUE TRUE FALSE

-- The whole section: arguments (a), (b), (c), a continuous year of cohabitation, a binding agreement, a refusal or cancellation.
#ASSERT `s 55.1 — a division of unadjusted pensionable earnings takes place` TRUE FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 55.1 — a division of unadjusted pensionable earnings takes place` FALSE TRUE FALSE TRUE FALSE FALSE
#ASSERT `s 55.1 — a division of unadjusted pensionable earnings takes place` FALSE FALSE TRUE TRUE FALSE FALSE
#ASSERT NOT `s 55.1 — a division of unadjusted pensionable earnings takes place` FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT NOT `s 55.1 — a division of unadjusted pensionable earnings takes place` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT `s 55.1 — a division of unadjusted pensionable earnings takes place` TRUE FALSE FALSE TRUE TRUE FALSE
#ASSERT NOT `s 55.1 — a division of unadjusted pensionable earnings takes place` TRUE FALSE FALSE TRUE FALSE TRUE

§ `Tests -- section 55.11`

-- Arguments: the judgment day (if any), the day of separation (if any), spouses in the old sense, spouses or common-law partners, the day the section came into force (invented: 31 July 2000).
-- (a): a judgment on 1 January 1987; on 31 December 1986 it is not
#ASSERT `s 55.11 — section 55.1 applies to the case` (JUST (YMD 1987 1 1)) NOTHING TRUE FALSE (YMD 2000 7 31)
#ASSERT NOT `s 55.11 — section 55.1 applies to the case` (JUST (YMD 1986 12 31)) NOTHING FALSE FALSE (YMD 2000 7 31)
-- (b): spouses who commence to live apart between 1 January 1987 and the coming into force
#ASSERT `s 55.11 — section 55.1 applies to the case` NOTHING (JUST (YMD 1990 5 1)) TRUE FALSE (YMD 2000 7 31)
#ASSERT `s 55.11 — section 55.1 applies to the case` NOTHING (JUST (YMD 1987 1 1)) TRUE FALSE (YMD 2000 7 31)
#ASSERT NOT `s 55.11 — section 55.1 applies to the case` NOTHING (JUST (YMD 1986 12 31)) TRUE FALSE (YMD 2000 7 31)
-- (b) is for spouses in the old sense; (c) is for spouses and former common-law partners, after the coming into force
#ASSERT `s 55.11 — section 55.1 applies to the case` NOTHING (JUST (YMD 2001 1 1)) FALSE TRUE (YMD 2000 7 31)
#ASSERT NOT `s 55.11 — section 55.1 applies to the case` NOTHING (JUST (YMD 2001 1 1)) FALSE FALSE (YMD 2000 7 31)
-- a separation commencing on the very day of the coming into force: not "before" (b), not "after" (c): neither paragraph reaches it (finding 8)
#ASSERT NOT `s 55.11 — section 55.1 applies to the case` NOTHING (JUST (YMD 2000 7 31)) TRUE TRUE (YMD 2000 7 31)
-- no judgment and no separation
#ASSERT NOT `s 55.11 — section 55.1 applies to the case` NOTHING NOTHING TRUE TRUE (YMD 2000 7 31)

§ `Tests -- section 55.2`

-- (2): arguments: an agreement or order on or after 4 June 1986, subsection (3) makes it binding
#ASSERT `s 55.2(2) — an agreement or court order does not bind the Minister in a division` TRUE FALSE
#ASSERT NOT `s 55.2(2) — an agreement or court order does not bind the Minister in a division` TRUE TRUE
#ASSERT NOT `s 55.2(2) — an agreement or court order does not bind the Minister in a division` FALSE FALSE

-- (3): arguments: an agreement on or after 4 June 1986, it mentions the Act and says no division, the provincial law permits, a division under 55 or 55.1(1)(b) or (c), a division under 55.1(1)(a), the day of the agreement, the day of the application, the day of the judgment, not invalidated.
#ASSERT `s 55.2(3) — a provision of an agreement is binding on the Minister and the Minister shall not make a division` TRUE TRUE TRUE TRUE FALSE (YMD 2005 1 1) (YMD 2006 1 1) (YMD 2006 1 1) TRUE
-- made on the day of the application: not "before" it
#ASSERT NOT `s 55.2(3) — a provision of an agreement is binding on the Minister and the Minister shall not make a division` TRUE TRUE TRUE TRUE FALSE (YMD 2006 1 1) (YMD 2006 1 1) (YMD 2006 1 1) TRUE
-- a division under paragraph 55.1(1)(a): before the judgment
#ASSERT `s 55.2(3) — a provision of an agreement is binding on the Minister and the Minister shall not make a division` TRUE TRUE TRUE FALSE TRUE (YMD 2005 1 1) (YMD 2006 1 1) (YMD 2007 1 1) TRUE
#ASSERT NOT `s 55.2(3) — a provision of an agreement is binding on the Minister and the Minister shall not make a division` TRUE TRUE TRUE FALSE TRUE (YMD 2008 1 1) (YMD 2006 1 1) (YMD 2007 1 1) TRUE
-- the agreement was made before 4 June 1986
#ASSERT NOT `s 55.2(3) — a provision of an agreement is binding on the Minister and the Minister shall not make a division` FALSE TRUE TRUE TRUE FALSE (YMD 1985 1 1) (YMD 2006 1 1) (YMD 2006 1 1) TRUE
-- it does not mention the Act and say there is to be no division
#ASSERT NOT `s 55.2(3) — a provision of an agreement is binding on the Minister and the Minister shall not make a division` TRUE FALSE TRUE TRUE FALSE (YMD 2005 1 1) (YMD 2006 1 1) (YMD 2006 1 1) TRUE
-- the provincial law does not permit it
#ASSERT NOT `s 55.2(3) — a provision of an agreement is binding on the Minister and the Minister shall not make a division` TRUE TRUE FALSE TRUE FALSE (YMD 2005 1 1) (YMD 2006 1 1) (YMD 2006 1 1) TRUE
-- invalidated by a court order
#ASSERT NOT `s 55.2(3) — a provision of an agreement is binding on the Minister and the Minister shall not make a division` TRUE TRUE TRUE TRUE FALSE (YMD 2005 1 1) (YMD 2006 1 1) (YMD 2006 1 1) FALSE

#ASSERT `s 55.2(4) — each person subject to the division must be notified without delay` TRUE FALSE
#ASSERT `s 55.2(4) — each person subject to the division must be notified without delay` FALSE TRUE
#ASSERT NOT `s 55.2(4) — each person subject to the division must be notified without delay` FALSE FALSE

-- (5): (10000 + 6000) / 2 = 8000 each
#ASSERT `s 55.2(5) — the base unadjusted pensionable earnings attributed to each person on a division under section 55.1` TRUE 10000 6000 EQUALS JUST 8000
#ASSERT `s 55.2(5) — the base unadjusted pensionable earnings attributed to each person on a division under section 55.1` FALSE 10000 6000 EQUALS NOTHING
#ASSERT `s 55.2(5.1) — the first additional unadjusted pensionable earnings attributed to each person on a division under section 55.1` TRUE 1000 500 EQUALS JUST 750
#ASSERT `s 55.2(5.1) — the first additional unadjusted pensionable earnings attributed to each person on a division under section 55.1` FALSE 1000 500 EQUALS NOTHING
