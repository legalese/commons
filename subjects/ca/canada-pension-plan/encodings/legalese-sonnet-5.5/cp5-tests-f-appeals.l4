IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cp5-months`
IMPORT `cp5-f-appeals`

-- Tests of sections 81 to 86.1 (cp5-f-appeals.l4). Expected values were worked out by hand from the text
-- (and from regulations 74.1 and 74.2 for the form, the notification and the longer period).

§ `Tests of sections 81 to 83`

§§ `Subsection 81(1) -- who may ask, and about what decision`

#ASSERT `s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `a spouse, former spouse, common-law partner, former common-law partner or estate dissatisfied under paragraph 81(1)(a)` `a decision made under section 55, 55.1, 55.2 or 55.3 that subsection 81(1) names` TRUE
#ASSERT NOT (`s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `a spouse, former spouse, common-law partner, former common-law partner or estate dissatisfied under paragraph 81(1)(a)` `a decision made under section 60 that subsection 81(1) names` TRUE)
#ASSERT `s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `an applicant dissatisfied under paragraph 81(1)(b)` `a decision made under section 60 that subsection 81(1) names` TRUE
#ASSERT NOT (`s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `an applicant dissatisfied under paragraph 81(1)(b)` `a determination as to the amount of a benefit payable to the beneficiary or as to the beneficiary's eligibility to receive a benefit that subsection 81(1) names` TRUE)
#ASSERT `s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `a beneficiary dissatisfied under paragraph 81(1)(c) or (d)` `a determination as to the amount of a benefit payable to the beneficiary or as to the beneficiary's eligibility to receive a benefit that subsection 81(1) names` TRUE
#ASSERT `s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `a beneficiary dissatisfied under paragraph 81(1)(c) or (d)` `a decision made under section 65.1 that subsection 81(1) names` TRUE
#ASSERT NOT (`s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `a beneficiary dissatisfied under paragraph 81(1)(c) or (d)` `a decision made under section 60 that subsection 81(1) names` TRUE)
#ASSERT `s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `a beneficiary's spouse or common-law partner dissatisfied under paragraph 81(1)(d)` `a decision made under section 65.1 that subsection 81(1) names` TRUE
#ASSERT NOT (`s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `a beneficiary's spouse or common-law partner dissatisfied under paragraph 81(1)(d)` `a determination as to the amount of a benefit payable to the beneficiary or as to the beneficiary's eligibility to receive a benefit that subsection 81(1) names` TRUE)
#ASSERT `s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `a person who made a request under section 70.1, a child of that person or, in relation to that child, a person or agency referred to in section 75, dissatisfied under paragraph 81(1)(e)` `a decision made under section 70.1 that subsection 81(1) names` TRUE
#ASSERT NOT (`s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `a person who made a request under section 70.1, a child of that person or, in relation to that child, a person or agency referred to in section 75, dissatisfied under paragraph 81(1)(e)` `a decision made under section 65.1 that subsection 81(1) names` TRUE)
-- Not dissatisfied, or a person none of paragraphs (a) to (e) names, or a decision they do not name.
#ASSERT NOT (`s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `an applicant dissatisfied under paragraph 81(1)(b)` `a decision made under section 60 that subsection 81(1) names` FALSE)
#ASSERT NOT (`s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `a person to whom none of paragraphs 81(1)(a) to (e) refers` `a decision made under section 60 that subsection 81(1) names` TRUE)
#ASSERT NOT (`s 81(1) — the person is a dissatisfied party who may ask the Minister to reconsider the decision or determination` `an applicant dissatisfied under paragraph 81(1)(b)` `a decision that subsection 81(1) does not name` TRUE)
-- On behalf of the dissatisfied party, subject to the regulations.
#ASSERT `s 81(1) — the person may make the request for the dissatisfied party` TRUE FALSE
#ASSERT `s 81(1) — the person may make the request for the dissatisfied party` FALSE TRUE
#ASSERT NOT (`s 81(1) — the person may make the request for the dissatisfied party` FALSE FALSE)

§§ `Subsections 81(1) and (1.1) -- the time`

#ASSERT `s 81(1) — the person was notified in the prescribed manner under regulation 74.2` TRUE TRUE
#ASSERT NOT (`s 81(1) — the person was notified in the prescribed manner under regulation 74.2` FALSE TRUE)
#ASSERT NOT (`s 81(1) — the person was notified in the prescribed manner under regulation 74.2` TRUE FALSE)
-- Notified on 10 January 2023: 90 days later is 10 April 2023 (21 days to 31 January, 28 to 28 February, 31 to 31 March, 10 more).
#ASSERT `s 81(1) and (1.1) — the last day of the ninety days for the request` (JUST (YearMonthDay 2023 1 10)) EQUALS JUST (YearMonthDay 2023 4 10)
#ASSERT `s 81(1) and (1.1) — the last day of the ninety days for the request` NOTHING EQUALS NOTHING
#ASSERT `s 81(1) and (1.1) — the request for reconsideration is made in time` (JUST (YearMonthDay 2023 1 10)) NOTHING (YearMonthDay 2023 4 10)
#ASSERT NOT (`s 81(1) and (1.1) — the request for reconsideration is made in time` (JUST (YearMonthDay 2023 1 10)) NOTHING (YearMonthDay 2023 4 11))
-- A longer period the Minister allowed, to 30 June 2023, whether allowed before or after the ninety days ran out.
#ASSERT `s 81(1) and (1.1) — the request for reconsideration is made in time` (JUST (YearMonthDay 2023 1 10)) (JUST (YearMonthDay 2023 6 30)) (YearMonthDay 2023 6 30)
#ASSERT NOT (`s 81(1) and (1.1) — the request for reconsideration is made in time` (JUST (YearMonthDay 2023 1 10)) (JUST (YearMonthDay 2023 6 30)) (YearMonthDay 2023 7 1))
-- Not yet notified in the prescribed manner: the ninety days have not begun to run.
#ASSERT `s 81(1) and (1.1) — the request for reconsideration is made in time` NOTHING NOTHING (YearMonthDay 2030 1 1)
-- Regulation 74.1(3): a reasonable explanation and a continuing intention.
#ASSERT `s 81(1) — the Minister may allow a longer period to make the request, under regulation 74.1(3) and (4)` TRUE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`s 81(1) — the Minister may allow a longer period to make the request, under regulation 74.1(3) and (4)` FALSE TRUE FALSE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`s 81(1) — the Minister may allow a longer period to make the request, under regulation 74.1(3) and (4)` TRUE FALSE FALSE FALSE FALSE TRUE TRUE)
-- Regulation 74.1(4): after the 365-day period, or applied again, or asked to rescind or amend: also a reasonable chance of success and no prejudice.
#ASSERT `s 81(1) — the Minister may allow a longer period to make the request, under regulation 74.1(3) and (4)` TRUE TRUE TRUE FALSE FALSE TRUE TRUE
#ASSERT NOT (`s 81(1) — the Minister may allow a longer period to make the request, under regulation 74.1(3) and (4)` TRUE TRUE TRUE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`s 81(1) — the Minister may allow a longer period to make the request, under regulation 74.1(3) and (4)` TRUE TRUE TRUE FALSE FALSE TRUE FALSE)
#ASSERT `s 81(1) — the Minister may allow a longer period to make the request, under regulation 74.1(3) and (4)` TRUE TRUE FALSE TRUE FALSE TRUE TRUE
#ASSERT NOT (`s 81(1) — the Minister may allow a longer period to make the request, under regulation 74.1(3) and (4)` TRUE TRUE FALSE TRUE FALSE FALSE FALSE)
#ASSERT `s 81(1) — the Minister may allow a longer period to make the request, under regulation 74.1(3) and (4)` TRUE TRUE FALSE FALSE TRUE TRUE TRUE
#ASSERT NOT (`s 81(1) — the Minister may allow a longer period to make the request, under regulation 74.1(3) and (4)` TRUE TRUE FALSE FALSE TRUE FALSE TRUE)
-- Regulation 74.1(1): the form.
#ASSERT `s 81(1) — the request is made in the prescribed form and manner of regulation 74.1(1)` TRUE TRUE FALSE TRUE TRUE
#ASSERT `s 81(1) — the request is made in the prescribed form and manner of regulation 74.1(1)` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT (`s 81(1) — the request is made in the prescribed form and manner of regulation 74.1(1)` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 81(1) — the request is made in the prescribed form and manner of regulation 74.1(1)` TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 81(1) — the request is made in the prescribed form and manner of regulation 74.1(1)` TRUE TRUE FALSE FALSE TRUE)
#ASSERT NOT (`s 81(1) — the request is made in the prescribed form and manner of regulation 74.1(1)` TRUE TRUE TRUE TRUE FALSE)
-- Subsection 81(1.1).
#ASSERT `s 81(1.1) — the person may ask the Minister to reconsider the decision to impose a penalty or its amount` TRUE TRUE
#ASSERT NOT (`s 81(1.1) — the person may ask the Minister to reconsider the decision to impose a penalty or its amount` TRUE FALSE)
#ASSERT NOT (`s 81(1.1) — the person may ask the Minister to reconsider the decision to impose a penalty or its amount` FALSE TRUE)

§§ `Subsections 81(2), 81(3) and section 82`

#ASSERT `s 81(2) — the Minister must reconsider the decision or determination without delay and notify the requester in writing of the decision and of the reasons for it` TRUE
#ASSERT NOT (`s 81(2) — the Minister must reconsider the decision or determination without delay and notify the requester in writing of the decision and of the reasons for it` FALSE)
#ASSERT `s 81(3) — the Minister may rescind or amend the decision` TRUE
#ASSERT NOT (`s 81(3) — the Minister may rescind or amend the decision` FALSE)
#ASSERT `s 82 — the party may appeal the decision of the Minister to the Social Security Tribunal` TRUE
#ASSERT NOT (`s 82 — the party may appeal the decision of the Minister to the Social Security Tribunal` FALSE)

§§ `Section 83 -- stay of benefits`

-- No Tribunal decision: nothing to stay.
#ASSERT `s 83 — the last day to which the Minister may stay payment of the benefit` FALSE (YearMonthDay 2023 9 30) (YearMonthDay 2023 10 30) NOTHING EQUALS NOTHING
-- The later of the two periods: 30 October 2023.
#ASSERT `s 83 — the last day to which the Minister may stay payment of the benefit` TRUE (YearMonthDay 2023 9 30) (YearMonthDay 2023 10 30) NOTHING EQUALS JUST (YearMonthDay 2023 10 30)
-- The leave period ends later: 15 November 2023.
#ASSERT `s 83 — the last day to which the Minister may stay payment of the benefit` TRUE (YearMonthDay 2023 11 15) (YearMonthDay 2023 10 30) NOTHING EQUALS JUST (YearMonthDay 2023 11 15)
-- Her Majesty applied for judicial review and the proceedings were completed in March 2024: through the end of March 2024.
#ASSERT `s 83 — the last day to which the Minister may stay payment of the benefit` TRUE (YearMonthDay 2023 9 30) (YearMonthDay 2023 10 30) (JUST (YearMonthDay 2024 3 12)) EQUALS JUST (YearMonthDay 2024 3 31)
-- Proceedings completed in September 2023, earlier than the expiry of the periods: the periods govern.
#ASSERT `s 83 — the last day to which the Minister may stay payment of the benefit` TRUE (YearMonthDay 2023 9 30) (YearMonthDay 2023 10 30) (JUST (YearMonthDay 2023 9 12)) EQUALS JUST (YearMonthDay 2023 10 30)
-- A year end: completed in December 2023, through 31 December 2023.
#ASSERT `s 83 — the last day to which the Minister may stay payment of the benefit` TRUE (YearMonthDay 2023 9 30) (YearMonthDay 2023 10 30) (JUST (YearMonthDay 2023 12 5)) EQUALS JUST (YearMonthDay 2023 12 31)
