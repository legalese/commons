IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-definitions`
IMPORT `cp2-regulations-and-offences`

-- Tests of cp2-regulations-and-offences.l4 (Act sections 40 and 41).
-- Expected values were decided by reading the section, then written down; none was copied from the rule's output.

§ `Tests -- regulations and offences`

§§ `s 40 -- the penalty ceiling, and the effective dates`

-- (1)(d): $10 a day, never more than $250 in all.
#ASSERT `s 40(1)(d) — the most a regulation may prescribe as the penalty for not filing an information return` 5 EQUALS 50
#ASSERT `s 40(1)(d) — the most a regulation may prescribe as the penalty for not filing an information return` 25 EQUALS 250
#ASSERT `s 40(1)(d) — the most a regulation may prescribe as the penalty for not filing an information return` 26 EQUALS 250
#ASSERT `s 40(1)(d) — the most a regulation may prescribe as the penalty for not filing an information return` 0 EQUALS 0
#ASSERT `s 40(1)(d) — the penalty a regulation prescribes is within the limit the paragraph allows` 50 5
#ASSERT NOT (`s 40(1)(d) — the penalty a regulation prescribes is within the limit the paragraph allows` 51 5)
#ASSERT `s 40(1)(d) — the penalty a regulation prescribes is within the limit the paragraph allows` 250 25
#ASSERT `s 40(1)(d) — the penalty a regulation prescribes is within the limit the paragraph allows` 250 90
#ASSERT NOT (`s 40(1)(d) — the penalty a regulation prescribes is within the limit the paragraph allows` 251 30)

-- (3): the day of publication, unless the regulation names an earlier or a later day.
#ASSERT `s 40(3) — the day the regulation prescribing the rules for subsection 21(1) has effect from` (YMD 2026 3 1) NOTHING EQUALS YMD 2026 3 1
#ASSERT `s 40(3) — the day the regulation prescribing the rules for subsection 21(1) has effect from` (YMD 2026 3 1) (JUST (YMD 2026 1 1)) EQUALS YMD 2026 1 1
#ASSERT `s 40(3) — the day the regulation prescribing the rules for subsection 21(1) has effect from` (YMD 2026 3 1) (JUST (YMD 2026 6 1)) EQUALS YMD 2026 6 1

-- (4): all three conditions.
#ASSERT `s 40(4) — the agreement has effect with reference to a period before it was entered into` TRUE TRUE TRUE
#ASSERT NOT (`s 40(4) — the agreement has effect with reference to a period before it was entered into` FALSE TRUE TRUE)
#ASSERT NOT (`s 40(4) — the agreement has effect with reference to a period before it was entered into` TRUE FALSE TRUE)
#ASSERT NOT (`s 40(4) — the agreement has effect with reference to a period before it was entered into` TRUE TRUE FALSE)

§§ `s 41(1) to (3) -- the employer, records and returns`

#ASSERT `s 41(1) — the employer is guilty of an offence` TRUE FALSE
#ASSERT `s 41(1) — the employer is guilty of an offence` FALSE TRUE
#ASSERT `s 41(1) — the employer is guilty of an offence` TRUE TRUE
#ASSERT NOT (`s 41(1) — the employer is guilty of an offence` FALSE FALSE)
#ASSERT `s 41(1) — the most the court may fine the employer` TRUE EQUALS JUST 5000
#ASSERT `s 41(1) — the most the court may fine the employer` FALSE EQUALS NOTHING
#ASSERT `s 41(1) — the longest term of imprisonment, in months, that may be imposed with the fine` TRUE EQUALS JUST 6
#ASSERT `s 41(1) — the longest term of imprisonment, in months, that may be imposed with the fine` FALSE EQUALS NOTHING

#ASSERT `s 41(2) — the person is guilty of an offence punishable on summary conviction` TRUE FALSE
#ASSERT `s 41(2) — the person is guilty of an offence punishable on summary conviction` FALSE TRUE
#ASSERT NOT (`s 41(2) — the person is guilty of an offence punishable on summary conviction` FALSE FALSE)
-- Subsection (2) names no maximum: not covered, whether or not the person is guilty.
#ASSERT `s 41(2) — the most the court may fine the person` TRUE EQUALS NOTHING
#ASSERT `s 41(2) — the most the court may fine the person` FALSE EQUALS NOTHING

#ASSERT `s 41(3) — the person is guilty of an offence` TRUE FALSE
#ASSERT `s 41(3) — the person is guilty of an offence` FALSE TRUE
#ASSERT NOT (`s 41(3) — the person is guilty of an offence` FALSE FALSE)
-- At least $25 a day; 40 days is exactly $1,000; beyond that the cap of $1,000 governs.
#ASSERT `s 41(3) — the least the court may fine the person` TRUE 10 EQUALS JUST 250
#ASSERT `s 41(3) — the least the court may fine the person` TRUE 40 EQUALS JUST 1000
#ASSERT `s 41(3) — the least the court may fine the person` TRUE 41 EQUALS JUST 1000
#ASSERT `s 41(3) — the least the court may fine the person` TRUE 0 EQUALS JUST 0
#ASSERT `s 41(3) — the least the court may fine the person` FALSE 10 EQUALS NOTHING
#ASSERT `s 41(3) — the most the court may fine the person` TRUE EQUALS JUST 1000
#ASSERT `s 41(3) — the most the court may fine the person` FALSE EQUALS NOTHING

§§ `s 41(4) -- false statements, destroyed records and evasion`

#ASSERT `s 41(4) — the person is guilty of an offence` TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 41(4) — the person is guilty of an offence` FALSE TRUE FALSE FALSE FALSE
#ASSERT `s 41(4) — the person is guilty of an offence` FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 41(4) — the person is guilty of an offence` FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 41(4) — the person is guilty of an offence` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 41(4) — the person is guilty of an offence` FALSE FALSE FALSE FALSE FALSE)
#ASSERT `s 41(4)(f) — the least the court may fine the person` TRUE EQUALS JUST 25
#ASSERT `s 41(4)(f) — the least the court may fine the person` FALSE EQUALS NOTHING
-- $5,000, plus in an appropriate case up to double the contribution evaded.
#ASSERT `s 41(4)(f) — the most the court may fine the person` TRUE FALSE 800 EQUALS JUST 5000
#ASSERT `s 41(4)(f) — the most the court may fine the person` TRUE TRUE 800 EQUALS JUST 6600
#ASSERT `s 41(4)(f) — the most the court may fine the person` TRUE TRUE 0 EQUALS JUST 5000
#ASSERT `s 41(4)(f) — the most the court may fine the person` FALSE TRUE 800 EQUALS NOTHING
#ASSERT `s 41(4)(g) — the longest term of imprisonment, in months, that may be imposed with the fine` TRUE EQUALS JUST 6
#ASSERT `s 41(4)(g) — the longest term of imprisonment, in months, that may be imposed with the fine` FALSE EQUALS NOTHING

§§ `s 41(5) and (6) -- the saving, and who may lay the information`

-- Convicted: the penalty is not also payable unless assessed or demanded BEFORE the information was laid (on 1 February 2026).
#ASSERT `s 41(5) — the person is not liable to pay the penalty for the same failure` TRUE NOTHING (YMD 2026 2 1)
#ASSERT `s 41(5) — the person is not liable to pay the penalty for the same failure` TRUE (JUST (YMD 2026 2 1)) (YMD 2026 2 1)
#ASSERT `s 41(5) — the person is not liable to pay the penalty for the same failure` TRUE (JUST (YMD 2026 3 1)) (YMD 2026 2 1)
#ASSERT NOT (`s 41(5) — the person is not liable to pay the penalty for the same failure` TRUE (JUST (YMD 2026 1 31)) (YMD 2026 2 1))
#ASSERT NOT (`s 41(5) — the person is not liable to pay the penalty for the same failure` FALSE NOTHING (YMD 2026 2 1))

#ASSERT `s 41(6) — the person may lay or make an information or complaint under section 41` TRUE FALSE FALSE
#ASSERT `s 41(6) — the person may lay or make an information or complaint under section 41` FALSE TRUE FALSE
#ASSERT `s 41(6) — the person may lay or make an information or complaint under section 41` FALSE FALSE TRUE
#ASSERT NOT (`s 41(6) — the person may lay or make an information or complaint under section 41` FALSE FALSE FALSE)
#ASSERT `s 41(6) — the person may call in question the informant's or complainant's lack of authority` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 41(6) — the person may call in question the informant's or complainant's lack of authority` TRUE FALSE EQUALS JUST FALSE
-- An information that does not purport to be laid under section 41: the text does not decide.
#ASSERT `s 41(6) — the person may call in question the informant's or complainant's lack of authority` FALSE TRUE EQUALS NOTHING
#ASSERT `s 41(6) — the person may call in question the informant's or complainant's lack of authority` FALSE FALSE EQUALS NOTHING
