IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-application`

-- Tests for cpp-core-application.l4 (sections 3, 4 and 4.1). Every expected value is worked out by
-- hand from the text. The provinces are invented ("Province A", "Province B"): the Act names none.

§ `Tests of sections 3 to 4.1`

§§ `Fixtures`

-- A province whose status is that of a province providing a comprehensive pension plan.
ProvinceA MEANS Province WITH `name of the province` IS "Province A", `a province providing a comprehensive pension plan` IS TRUE
-- A province that is not.
ProvinceB MEANS Province WITH `name of the province` IS "Province B", `a province providing a comprehensive pension plan` IS FALSE


§§ `Section 3(1): the date, province providing a comprehensive pension plan`

-- 3 May 1965.
#ASSERT `s 3(1) — the date that divides paragraph (a) from paragraph (b)` EQUALS (YMD 1965 5 3)
-- Paragraph (a): intention signified on 3 May 1965, "on or before"; contributions from 1966; comparable benefits.
#ASSERT `s 3(1) — a province providing a comprehensive pension plan` TRUE (JUST (YMD 1965 5 3)) NOTHING 1966 TRUE FALSE
-- Paragraph (a) fails: intention signified one day after the cut-off, and no notice.
#ASSERT NOT (`s 3(1) — a province providing a comprehensive pension plan` TRUE (JUST (YMD 1965 5 4)) NOTHING 1966 TRUE FALSE)
-- Paragraph (a) fails: contributions must commence with 1966.
#ASSERT NOT (`s 3(1) — a province providing a comprehensive pension plan` TRUE (JUST (YMD 1964 12 1)) NOTHING 1967 TRUE FALSE)
-- Paragraph (a) fails: benefits not comparable.
#ASSERT NOT (`s 3(1) — a province providing a comprehensive pension plan` TRUE (JUST (YMD 1964 12 1)) NOTHING 1966 FALSE FALSE)
-- Not prescribed by regulation: never a province providing a plan, however the facts read.
#ASSERT NOT (`s 3(1) — a province providing a comprehensive pension plan` FALSE (JUST (YMD 1964 12 1)) NOTHING 1966 TRUE TRUE)
-- Paragraph (b): notice in 1990; the third year following 1990 is 1993; benefits comparable; obligations assumed.
#ASSERT `s 3(1) — a province providing a comprehensive pension plan` TRUE NOTHING (JUST (YMD 1990 6 15)) 1993 TRUE TRUE
-- Paragraph (b)(i) fails: 1992 is only the second year following 1990.
#ASSERT NOT (`s 3(1) — a province providing a comprehensive pension plan` TRUE NOTHING (JUST (YMD 1990 6 15)) 1992 TRUE TRUE)
-- Paragraph (b)(ii) fails: the plan does not assume the obligations and liabilities.
#ASSERT NOT (`s 3(1) — a province providing a comprehensive pension plan` TRUE NOTHING (JUST (YMD 1990 6 15)) 1993 TRUE FALSE)
-- Paragraph (b)(i) fails: benefits not comparable.
#ASSERT NOT (`s 3(1) — a province providing a comprehensive pension plan` TRUE NOTHING (JUST (YMD 1990 6 15)) 1993 FALSE TRUE)
-- Paragraph (b) needs notice "after May 3, 1965"; notice on 3 May 1965 is not after it.
#ASSERT NOT (`s 3(1) — a province providing a comprehensive pension plan` TRUE NOTHING (JUST (YMD 1965 5 3)) 1968 TRUE TRUE)
-- Notice on 4 May 1965, the first day after the cut-off; the third year following 1965 is 1968.
#ASSERT `s 3(1) — a province providing a comprehensive pension plan` TRUE NOTHING (JUST (YMD 1965 5 4)) 1968 TRUE TRUE
-- Neither an intention signified nor a notice given.
#ASSERT NOT (`s 3(1) — a province providing a comprehensive pension plan` TRUE NOTHING NOTHING 1966 TRUE TRUE)
-- Provision made as described in (a) or (b), under a law of such a province.
#ASSERT `s 3(1) — a provincial pension plan` TRUE TRUE
-- Under a law of some other province.
#ASSERT NOT (`s 3(1) — a provincial pension plan` TRUE FALSE)
-- No provision made as described.
#ASSERT NOT (`s 3(1) — a provincial pension plan` FALSE TRUE)

§§ `Sections 3(2) and 3(3): prescription after notice, and its effect`

-- Notice in 2020: the third year following is 2023; its first day is 1 January 2023; twelve months before is 1 January 2022.
#ASSERT `s 3(2) — the last day by which the legislature must have provided by law` (YMD 2020 6 1) EQUALS (YMD 2022 1 1)
-- The same for notice given on the last day of 2020: the year of the notice governs, not the day.
#ASSERT `s 3(2) — the last day by which the legislature must have provided by law` (YMD 2020 12 31) EQUALS (YMD 2022 1 1)
-- Notice on 1 January 2021: the deadline moves a year later.
#ASSERT `s 3(2) — the last day by which the legislature must have provided by law` (YMD 2021 1 1) EQUALS (YMD 2023 1 1)
-- Law made on the last permitted day, 1 January 2022 ("not later than").
#ASSERT `s 3(2) — the Governor in Council must prescribe the province` (YMD 2020 6 1) (JUST (YMD 2022 1 1)) TRUE
-- Law made one day late.
#ASSERT NOT (`s 3(2) — the Governor in Council must prescribe the province` (YMD 2020 6 1) (JUST (YMD 2022 1 2)) TRUE)
-- Law made well before the deadline.
#ASSERT `s 3(2) — the Governor in Council must prescribe the province` (YMD 2020 6 1) (JUST (YMD 2021 3 1)) TRUE
-- No law yet.
#ASSERT NOT (`s 3(2) — the Governor in Council must prescribe the province` (YMD 2020 6 1) NOTHING TRUE)
-- A law in time but not providing for the plan and the assumption of obligations.
#ASSERT NOT (`s 3(2) — the Governor in Council must prescribe the province` (YMD 2020 6 1) (JUST (YMD 2021 3 1)) FALSE)
-- Effective on the first day of the third year following the year of the notice.
#ASSERT `s 3(3) — the day a regulation under subsection (2) becomes effective` (YMD 2020 6 1) EQUALS (YMD 2023 1 1)
-- Same for notice on 31 December 2020.
#ASSERT `s 3(3) — the day a regulation under subsection (2) becomes effective` (YMD 2020 12 31) EQUALS (YMD 2023 1 1)

§§ `Section 4(1)(a): employment`

-- Employment in a province providing a plan, no subsection (2) exception: the provisions do not apply.
#ASSERT NOT (`s 4(1)(a) — the Act's provisions on employee and employer contributions reach the employment` TRUE FALSE)
-- Subsection (2) treats the employment as employment in another province: they apply.
#ASSERT `s 4(1)(a) — the Act's provisions on employee and employer contributions reach the employment` TRUE TRUE
-- Employment in a province without a plan: they apply.
#ASSERT `s 4(1)(a) — the Act's provisions on employee and employer contributions reach the employment` FALSE FALSE
-- Outside such a province the exception is moot: still apply.
#ASSERT `s 4(1)(a) — the Act's provisions on employee and employer contributions reach the employment` FALSE TRUE

§§ `Section 4(1)(b): self-employed persons`

-- Resident on the last day of the year in a province providing a plan: they do not apply.
#ASSERT NOT (`s 4(1)(b) — the Act's provisions on self-employed contributions reach the person for the year` (JUST ProvinceA))
-- Resident in a province without a plan: they apply.
#ASSERT `s 4(1)(b) — the Act's provisions on self-employed contributions reach the person for the year` (JUST ProvinceB)
-- Not resident in any province on that day (for example resident outside Canada): paragraph (b) does not take the person out.
#ASSERT `s 4(1)(b) — the Act's provisions on self-employed contributions reach the person for the year` NOTHING

§§ `Sections 4(2) and 4(3)`

-- Paragraph (a): employment by Her Majesty in right of Canada or her agent, in a province providing a plan.
#ASSERT `s 4(2) — the employment is described in subsection (2)` TRUE TRUE FALSE
-- Paragraph (b): the plan's operation for those persons is outside the province's legislative authority.
#ASSERT `s 4(2) — the employment is described in subsection (2)` TRUE FALSE TRUE
-- Neither paragraph.
#ASSERT NOT (`s 4(2) — the employment is described in subsection (2)` TRUE FALSE FALSE)
-- Paragraph (a) is about employment in a province providing a plan; elsewhere it is moot.
#ASSERT NOT (`s 4(2) — the employment is described in subsection (2)` FALSE TRUE FALSE)
-- Described in subsection (2) and no agreement: the Act applies.
#ASSERT `s 4(2) — the Act applies to the employment as though it were employment in another province` TRUE FALSE
-- "Subject to subsection (3)": under an agreement the provincial plan governs instead.
#ASSERT NOT (`s 4(2) — the Act applies to the employment as though it were employment in another province` TRUE TRUE)
-- Not described in subsection (2).
#ASSERT NOT (`s 4(2) — the Act applies to the employment as though it were employment in another province` FALSE FALSE)
-- Described in subsection (2) and an agreement in force.
#ASSERT `s 4(3) — the employment is subject to the provincial pension plan under an agreement` TRUE TRUE
-- No agreement.
#ASSERT NOT (`s 4(3) — the employment is subject to the provincial pension plan under an agreement` TRUE FALSE)
-- An agreement covers only employment described in subsection (2).
#ASSERT NOT (`s 4(3) — the employment is subject to the provincial pension plan under an agreement` FALSE TRUE)

§§ `Section 4(4): the province in which a person is deemed employed`

-- Reports for work at an establishment in Province A, remuneration paid from Province B: Province A.
#ASSERT (`s 4(4) — the province in which a person is deemed employed` (JUST ProvinceA) ProvinceB)'s `name of the province` EQUALS "Province A"
-- Not required to report for work at any establishment: the province of the establishment that pays.
#ASSERT (`s 4(4) — the province in which a person is deemed employed` NOTHING ProvinceB)'s `name of the province` EQUALS "Province B"
-- The deemed province carries its own status: Province B has no plan.
#ASSERT (`s 4(4) — the province in which a person is deemed employed` (JUST ProvinceB) ProvinceA)'s `a province providing a comprehensive pension plan` EQUALS FALSE

§§ `Section 4(5): the last day of the year`

-- Did not reside in Canada at any time in the year: the last day of the year.
#ASSERT `s 4(5) — the day taken as the last day of a year for paragraph (1)(b)` 2025 NOTHING EQUALS (YMD 2025 12 31)
-- Resided in Canada to the end of the year: the last day of the year.
#ASSERT `s 4(5) — the day taken as the last day of a year for paragraph (1)(b)` 2025 (JUST (YMD 2025 12 31)) EQUALS (YMD 2025 12 31)
-- Ceased to reside in Canada on 30 June: that is the day taken.
#ASSERT `s 4(5) — the day taken as the last day of a year for paragraph (1)(b)` 2025 (JUST (YMD 2025 6 30)) EQUALS (YMD 2025 6 30)
-- Resided in Canada only on 1 January: that day.
#ASSERT `s 4(5) — the day taken as the last day of a year for paragraph (1)(b)` 2025 (JUST (YMD 2025 1 1)) EQUALS (YMD 2025 1 1)
-- Ceased to reside one day before the last day.
#ASSERT `s 4(5) — the day taken as the last day of a year for paragraph (1)(b)` 2025 (JUST (YMD 2025 12 30)) EQUALS (YMD 2025 12 30)

§§ `Section 4.1: electronic means`

-- The Minister of National Revenue, dealing with documents or information under this Act.
#ASSERT `s 4.1 — this section permits the Minister to use electronic means` `the Minister of National Revenue` TRUE
-- Not under this Act.
#ASSERT NOT (`s 4.1 — this section permits the Minister to use electronic means` `the Minister of National Revenue` FALSE)
-- The section names only the Minister of National Revenue; it gives the other Minister no permission.
#ASSERT NOT (`s 4.1 — this section permits the Minister to use electronic means` `the Minister of Employment and Social Development` TRUE)

