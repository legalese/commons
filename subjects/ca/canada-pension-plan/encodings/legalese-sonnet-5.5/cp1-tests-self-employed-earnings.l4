§ `Tests -- section 13(1.1) and (1.2)`
#ASSERT `s 13(1.1)(a) — the election or the revocation is valid in form` TRUE EQUALS TRUE
#ASSERT `s 13(1.1)(a) — the election or the revocation is valid in form` FALSE EQUALS FALSE
#ASSERT `s 13(1.1)(b) — the election may be made for the year` FALSE EQUALS TRUE
#ASSERT `s 13(1.1)(b) — the election may be made for the year` TRUE EQUALS FALSE
#ASSERT `s 13(1.1)(c) — the election may be revoked for the year` 2024 2024 EQUALS FALSE
#ASSERT `s 13(1.1)(c) — the election may be revoked for the year` 2024 2025 EQUALS TRUE
#ASSERT `s 13(1.1)(d) — the election may be made for the year` TRUE EQUALS FALSE
#ASSERT `s 13(1.1)(d) — the election may be made for the year` FALSE EQUALS TRUE
#ASSERT `s 13(1.1)(e) — the day on which the election is deemed to be made or revoked` (YearMonthDay 2024 7 19) EQUALS YearMonthDay 2024 7 1
#ASSERT `s 13(1.1)(f) — the election may be made for the year in view of income from pensionable employment` TRUE EQUALS FALSE
#ASSERT `s 13(1.1)(f) — the election may be made for the year in view of income from pensionable employment` FALSE EQUALS TRUE
#ASSERT `s 13(1.1) — a valid election under paragraph 13(1)(b) may be made for the year` TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `s 13(1.1) — a valid election under paragraph 13(1)(b) may be made for the year` TRUE TRUE FALSE FALSE EQUALS FALSE
#ASSERT `s 13(1.1) — a valid election under paragraph 13(1)(b) may be made for the year` TRUE FALSE TRUE FALSE EQUALS FALSE
#ASSERT `s 13(1.1) — a valid election under paragraph 13(1)(b) may be made for the year` TRUE FALSE FALSE TRUE EQUALS FALSE
#ASSERT `s 13(1.1) — a valid election under paragraph 13(1)(b) may be made for the year` FALSE FALSE FALSE FALSE EQUALS FALSE
