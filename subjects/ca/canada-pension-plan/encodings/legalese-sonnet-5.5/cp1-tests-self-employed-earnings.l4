#ASSERT `a paragraph (a) event occurs in the year` `plain person 1980` FALSE EQUALS FALSE
#ASSERT `a paragraph (a) event occurs in the year` `person reaching 18 on 10 March 2024` FALSE EQUALS TRUE
#ASSERT `the number of months counted under paragraph (a)` `person reaching 18 on 10 March 2024` FALSE EQUALS 9   -- April to December: the deemed date is 1 April (section 2(2))
#ASSERT `a paragraph (a) event occurs in the year` `person who turns 18 on 20 December 2024` FALSE EQUALS FALSE   -- 18 is deemed reached on 1 January 2025, so not in 2024
#ASSERT `a paragraph (a) event occurs in the year` `person reaching 70 on 20 August 2024` FALSE EQUALS TRUE
#ASSERT `the number of months counted under paragraph (a)` `person reaching 70 on 20 August 2024` FALSE EQUALS 8   -- January to August: the birthday month is included (section 2(2)(a))
#ASSERT `the number of months counted under paragraph (a)` `person whose contributory period ends on 10 May 2024` FALSE EQUALS 5   -- January to May: before the month following the month in which it ends
#ASSERT `the number of months counted under paragraph (a)` `person whose disability pension ceases on 20 September 2024` FALSE EQUALS 3   -- October to December: after the month in which it ceases
#ASSERT `the number of months counted under paragraph (a)` `person with a pension ceasing in March and a period ending in September 2024` FALSE EQUALS 6   -- April to September: every event of the year is satisfied
#ASSERT `a paragraph (a) event occurs in the year` `person who dies on 15 June 2024` FALSE EQUALS FALSE   -- section 13 does not list death
#ASSERT `a paragraph (a) event occurs in the year` `person who dies on 15 June 2024` TRUE EQUALS TRUE   -- sections 17, 17.1 and 19 do
#ASSERT `the number of months counted under paragraph (a)` `person who dies on 15 June 2024` TRUE EQUALS 6   -- January to June: the month of death is included

§ `Tests -- section 14 and 14.1: self-employed earnings`
`an ordinary business` MEANS `cp1 Business carried on by a person` WITH `income of the person for the year from the business` IS 30_000, `losses sustained by the person in the year in carrying on the business` IS 2_000, `more than fifty per cent of the gross revenue of the business consisted of rent from land or buildings` IS FALSE, `the income or losses are from services described in paragraph 7(1)(d) that a regulation has included in pensionable employment` IS FALSE
`a rental business` MEANS `cp1 Business carried on by a person` WITH `income of the person for the year from the business` IS 10_000, `losses sustained by the person in the year in carrying on the business` IS 500, `more than fifty per cent of the gross revenue of the business consisted of rent from land or buildings` IS TRUE, `the income or losses are from services described in paragraph 7(1)(d) that a regulation has included in pensionable employment` IS FALSE
`a business of services included in pensionable employment` MEANS `cp1 Business carried on by a person` WITH `income of the person for the year from the business` IS 5_000, `losses sustained by the person in the year in carrying on the business` IS 1_000, `more than fifty per cent of the gross revenue of the business consisted of rent from land or buildings` IS FALSE, `the income or losses are from services described in paragraph 7(1)(d) that a regulation has included in pensionable employment` IS TRUE
`a losing business` MEANS `cp1 Business carried on by a person` WITH `income of the person for the year from the business` IS 1_000, `losses sustained by the person in the year in carrying on the business` IS 4_000, `more than fifty per cent of the gross revenue of the business consisted of rent from land or buildings` IS FALSE, `the income or losses are from services described in paragraph 7(1)(d) that a regulation has included in pensionable employment` IS FALSE
#ASSERT `s 14(a) — the income from businesses, less the losses sustained in carrying them on` (LIST `an ordinary business`) EQUALS 28_000   -- 30,000 - 2,000
#ASSERT `s 14(a) — the income from businesses, less the losses sustained in carrying them on` (LIST `an ordinary business`, `a rental business`, `a business of services included in pensionable employment`) EQUALS 28_000   -- the rental business and the 7(1)(d) services are left out
#ASSERT `s 14(a) — the income from businesses, less the losses sustained in carrying them on` (LIST `an ordinary business`, `a losing business`) EQUALS 25_000   -- 31,000 - 6,000
#ASSERT `s 14(a) — the income from businesses, less the losses sustained in carrying them on` (LIST `a losing business`) EQUALS (0 MINUS 3_000)   -- a net loss is a negative amount (no floor in the text)
#ASSERT `s 14(a) — the income from businesses, less the losses sustained in carrying them on` EMPTY EQUALS 0
#ASSERT `s 14(b) — the income from employment described in paragraph 7(2)(e) that has been excepted from pensionable employment` 4_000 EQUALS 4_000
#ASSERT `s 14(c) — the income of an Indian from self-employment on a reserve` TRUE 2_500 EQUALS JUST 2_500
#ASSERT `s 14(c) — the income of an Indian from self-employment on a reserve` FALSE 2_500 EQUALS NOTHING
#ASSERT `s 14 — the self-employed earnings of a person for a year` 28_000 4_000 (JUST 2_500) EQUALS 34_500
#ASSERT `s 14 — the self-employed earnings of a person for a year` 28_000 4_000 NOTHING EQUALS 32_000
#ASSERT `s 14.1 — the income deemed to be the member's income from a business carried on by the member` TRUE 6_000 EQUALS JUST 6_000
#ASSERT `s 14.1 — the income deemed to be the member's income from a business carried on by the member` FALSE 6_000 EQUALS NOTHING

