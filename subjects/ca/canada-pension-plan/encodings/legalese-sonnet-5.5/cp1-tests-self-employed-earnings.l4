#ASSERT `s 13(1.2)(b) — the month is not before the month in which the retirement pension becomes payable` (YearMonthDay 2023 8 1) (YearMonthDay 2023 8 1) EQUALS TRUE
#ASSERT `s 13(1.2)(c) — the month is not after the month in which the person reaches seventy years of age` (YearMonthDay 2023 8 1) (YearMonthDay 1958 5 10) EQUALS TRUE
#ASSERT `s 13(1.2)(a) — the month is not before the month in which the person reaches sixty-five years of age` (YearMonthDay 2028 5 31) (YearMonthDay 1958 5 10) EQUALS TRUE
#ASSERT `s 13(1.2)(b) — the month is not before the month in which the retirement pension becomes payable` (YearMonthDay 2028 5 31) (YearMonthDay 2023 8 1) EQUALS TRUE
#ASSERT `s 13(1.2)(c) — the month is not after the month in which the person reaches seventy years of age` (YearMonthDay 2028 5 31) (YearMonthDay 1958 5 10) EQUALS TRUE
#ASSERT `s 13(1.2)(a) — the month is not before the month in which the person reaches sixty-five years of age` (YearMonthDay 2028 6 1) (YearMonthDay 1958 5 10) EQUALS TRUE
#ASSERT `s 13(1.2)(b) — the month is not before the month in which the retirement pension becomes payable` (YearMonthDay 2028 6 1) (YearMonthDay 2023 8 1) EQUALS TRUE
#ASSERT `s 13(1.2)(c) — the month is not after the month in which the person reaches seventy years of age` (YearMonthDay 2028 6 1) (YearMonthDay 1958 5 10) EQUALS FALSE
#ASSERT `s 13(1.2) — the month referred to in the election or revocation is allowed` (YearMonthDay 2024 3 1) (YearMonthDay 1958 5 10) (YearMonthDay 2023 8 1) EQUALS TRUE
#ASSERT `s 13(1.2) — the month referred to in the election or revocation is allowed` (YearMonthDay 2023 7 1) (YearMonthDay 1958 5 10) (YearMonthDay 2023 8 1) EQUALS FALSE
#ASSERT `s 13(1.2) — the month referred to in the election or revocation is allowed` (YearMonthDay 2028 6 1) (YearMonthDay 1958 5 10) (YearMonthDay 2023 8 1) EQUALS FALSE
#ASSERT `s 13(1.2) — the month referred to in the election or revocation is allowed` (YearMonthDay 2023 5 1) (YearMonthDay 1958 5 10) (YearMonthDay 2020 1 1) EQUALS FALSE
-- 13(1.2)(c) uses the actual birthday: a person born 31 December 1958 reaches 70 on 31 December 2028, so December 2028 is allowed and January 2029 is not;
-- under the deemed date (1 January 2029) January 2029 would be the month in which they reach 70 and would be allowed.
#ASSERT `s 13(1.2)(c) — the month is not after the month in which the person reaches seventy years of age` (YearMonthDay 2028 12 1) (YearMonthDay 1958 12 31) EQUALS TRUE
#ASSERT `s 13(1.2)(c) — the month is not after the month in which the person reaches seventy years of age` (YearMonthDay 2029 1 1) (YearMonthDay 1958 12 31) EQUALS FALSE
#ASSERT `s 13(1.2)(a) — the month is not before the month in which the person reaches sixty-five years of age` (YearMonthDay 2023 12 1) (YearMonthDay 1958 12 31) EQUALS FALSE   -- deemed 65 on 1 January 2024, so December 2023 is before it
#ASSERT `s 13(1.2)(a) — the month is not before the month in which the person reaches sixty-five years of age` (YearMonthDay 2024 1 1) (YearMonthDay 1958 12 31) EQUALS TRUE

§ `Tests -- section 13(2)(b), (3) to (3.2) and (4)`
-- (3) in time: within one year from 15 June of the following year, or from the day of a refund under section 38.
#ASSERT `s 13(3) — the election is made in time` 2023 (YearMonthDay 2025 6 15) NOTHING EQUALS TRUE
#ASSERT `s 13(3) — the election is made in time` 2023 (YearMonthDay 2025 6 16) NOTHING EQUALS FALSE
#ASSERT `s 13(3) — the election is made in time` 2023 (YearMonthDay 2024 1 1) NOTHING EQUALS TRUE   -- before June 15: the text sets no start (fork)
#ASSERT `s 13(3) — the election is made in time` 2023 (YearMonthDay 2025 9 1) (JUST (YearMonthDay 2024 9 1)) EQUALS TRUE   -- one year from the refund of 1 September 2024
#ASSERT `s 13(3) — the election is made in time` 2023 (YearMonthDay 2025 9 2) (JUST (YearMonthDay 2024 9 1)) EQUALS FALSE
#ASSERT `s 13(3) — the election is made in time` 2023 (YearMonthDay 2025 8 1) (JUST (YearMonthDay 2024 9 1)) EQUALS TRUE   -- later than June 15 but within a year of the refund
#ASSERT `s 13(3) — the election is made in time` 2023 (YearMonthDay 2025 6 16) NOTHING EQUALS FALSE
-- (3): lesser of wages and the maximum pensionable earnings, over what has been contributed on and the exemption already deducted (the lesser of that and the exemption).
#ASSERT `s 13(3) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1)` 50_000 68_500 46_500 NOTHING 3_500 3_500 EQUALS 0   -- (a) 50,000 ; (b) 46,500 + 3,500
#ASSERT `s 13(3) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1)` 50_000 68_500 0 NOTHING 0 3_500 EQUALS 50_000   -- nothing contributed on, no exemption deducted
#ASSERT `s 13(3) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1)` 80_000 68_500 65_000 NOTHING 3_500 3_500 EQUALS 0
#ASSERT `s 13(3) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1)` 80_000 68_500 55_000 (JUST 10_000) 3_500 3_500 EQUALS 0   -- (b) 55,000 + 10,000 + 3,500
#ASSERT `s 13(3) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1)` 80_000 68_500 20_000 NOTHING 0 3_500 EQUALS 48_500   -- (a) 68,500 ; (b) 20,000 + 0
#ASSERT `s 13(3) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1)` 80_000 68_500 20_000 NOTHING 10_000 3_500 EQUALS 45_000   -- the exemption counts only to the basic exemption: min(10,000; 3,500) = 3,500 ; (b) = 23,500
#ASSERT `s 13(3.1) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1.1)` 2024 TRUE 80_000 68_500 20_000 NOTHING 0 3_500 EQUALS JUST 48_500
#ASSERT `s 13(3.1) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1.1)` 2019 TRUE 80_000 68_500 20_000 NOTHING 0 3_500 EQUALS JUST 48_500
#ASSERT `s 13(3.1) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1.1)` 2018 TRUE 80_000 68_500 20_000 NOTHING 0 3_500 EQUALS NOTHING
#ASSERT `s 13(3.1) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1.1)` 2024 FALSE 80_000 68_500 20_000 NOTHING 0 3_500 EQUALS NOTHING
#ASSERT `s 13(3.2) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1.2)` 2024 TRUE 80_000 73_200 65_000 0 NOTHING NOTHING 3_500 3_500 NOTHING EQUALS JUST 4_700   -- (a) 73,200 ; (b) 65,000 + 0 + 3,500
#ASSERT `s 13(3.2) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1.2)` 2024 TRUE 80_000 73_200 65_000 0 NOTHING NOTHING 3_500 3_500 (JUST 1_000) EQUALS JUST 3_700   -- less the amount under (3) or (3.1)
#ASSERT `s 13(3.2) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1.2)` 2023 TRUE 80_000 73_200 65_000 0 NOTHING NOTHING 3_500 3_500 NOTHING EQUALS NOTHING
#ASSERT `s 13(3.2) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1.2)` 2024 FALSE 80_000 73_200 65_000 0 NOTHING NOTHING 3_500 3_500 NOTHING EQUALS NOTHING
#ASSERT `s 13(3.2) — the amount included in the contributory self-employed earnings for the purposes of subsection 10(1.2)` 2024 TRUE 60_000 73_200 65_000 0 NOTHING NOTHING 3_500 3_500 NOTHING EQUALS JUST 0   -- wages below what has been contributed on: no excess
-- (4): earnings computed under a provincial pension plan
#ASSERT `s 13(4) — the contributory self-employed earnings of a person resident in a province providing a comprehensive pension plan` TRUE 55_000 50_000 EQUALS 55_000
#ASSERT `s 13(4) — the contributory self-employed earnings of a person resident in a province providing a comprehensive pension plan` FALSE 55_000 50_000 EQUALS 50_000
