IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cr1-schedules`
IMPORT `cr1-part8-misc`
IMPORT `cr1-part8-mpe`
IMPORT `cr1-part8-interest`

-- Tests of cr1-part8-misc.l4, cr1-part8-mpe.l4 and cr1-part8-interest.l4 (regulations 79 to 88). Every expected
-- value is written from the text (C.R.C.-c.-385.txt lines 823 to 891) before the run.

§ `Tests of regulations 79 to 88`

§§ `Regulation 79`

#ASSERT `reg 79 — the Minister of National Revenue may enter into the agreement on behalf of the Government of Canada` `the government of a country other than Canada` `paragraph 6(2)(h) of the Act`
#ASSERT `reg 79 — the Minister of National Revenue may enter into the agreement on behalf of the Government of Canada` `an international organization` `paragraph 7(1)(e) of the Act`
#ASSERT `reg 79 — the Minister of National Revenue may enter into the agreement on behalf of the Government of Canada` `the government of a province` `paragraph 7(1)(f) of the Act`
#ASSERT NOT (`reg 79 — the Minister of National Revenue may enter into the agreement on behalf of the Government of Canada` `any other party` `paragraph 6(2)(h) of the Act`)
#ASSERT NOT (`reg 79 — the Minister of National Revenue may enter into the agreement on behalf of the Government of Canada` `the government of a province` `any other provision`)

§§ `Regulations 82 to 83.2: the elections`

#ASSERT `reg 82 — the election referred to in paragraph 11(2)(a) of the Act is made` TRUE TRUE
#ASSERT NOT (`reg 82 — the election referred to in paragraph 11(2)(a) of the Act is made` FALSE TRUE)
#ASSERT NOT (`reg 82 — the election referred to in paragraph 11(2)(a) of the Act is made` TRUE FALSE)
#ASSERT `reg 83 — the individual has revoked the election under section 11 of the Act` TRUE TRUE
#ASSERT NOT (`reg 83 — the individual has revoked the election under section 11 of the Act` TRUE FALSE)
#ASSERT NOT (`reg 83 — the individual has revoked the election under section 11 of the Act` FALSE TRUE)
#ASSERT `reg 83.1 — the election referred to in subsection 12(1.1) of the Act is made or revoked` TRUE TRUE
#ASSERT NOT (`reg 83.1 — the election referred to in subsection 12(1.1) of the Act is made or revoked` FALSE TRUE)
#ASSERT NOT (`reg 83.1 — the election referred to in subsection 12(1.1) of the Act is made or revoked` TRUE FALSE)
-- 83.2: within one year from June 15 in the year following the year of the return, that is June 15 two years on.
#ASSERT `reg 83.2 — the last day for filing the form to make or revoke the election referred to in subsection 13(1.1) of the Act` 2025 EQUALS (YMD 2027 6 15)
#ASSERT `reg 83.2 — the last day for filing the form to make or revoke the election referred to in subsection 13(1.1) of the Act` 2026 EQUALS (YMD 2028 6 15)
-- Arguments: the year of the return; filed with the return; filed after the return; form authorized; day filed.
#ASSERT `reg 83.2 — the election referred to in subsection 13(1.1) of the Act is made or revoked` 2025 TRUE FALSE TRUE (YMD 2027 6 15)
#ASSERT `reg 83.2 — the election referred to in subsection 13(1.1) of the Act is made or revoked` 2025 FALSE TRUE TRUE (YMD 2026 12 1)
#ASSERT NOT (`reg 83.2 — the election referred to in subsection 13(1.1) of the Act is made or revoked` 2025 TRUE FALSE TRUE (YMD 2027 6 16))
#ASSERT NOT (`reg 83.2 — the election referred to in subsection 13(1.1) of the Act is made or revoked` 2025 FALSE FALSE TRUE (YMD 2026 12 1))
#ASSERT NOT (`reg 83.2 — the election referred to in subsection 13(1.1) of the Act is made or revoked` 2025 TRUE FALSE FALSE (YMD 2026 12 1))

§§ `Regulation 84 and 84.1`

#ASSERT `reg 84(2) — the last day for filing the form` 2025 EQUALS (YMD 2027 4 30)
#ASSERT `reg 84(2) — the last day for filing the form` 2024 EQUALS (YMD 2026 4 30)
-- Arguments: 13(3) applies; the year; form filed with the return or the Minister; form authorized; day filed.
#ASSERT `reg 84 — the individual's contributory salary and wages for the year are included as self-employed earnings` TRUE 2025 TRUE TRUE (YMD 2027 4 30)
#ASSERT NOT (`reg 84 — the individual's contributory salary and wages for the year are included as self-employed earnings` TRUE 2025 TRUE TRUE (YMD 2027 5 1))
#ASSERT NOT (`reg 84 — the individual's contributory salary and wages for the year are included as self-employed earnings` FALSE 2025 TRUE TRUE (YMD 2027 4 30))
#ASSERT NOT (`reg 84 — the individual's contributory salary and wages for the year are included as self-employed earnings` TRUE 2025 FALSE TRUE (YMD 2027 4 30))
#ASSERT NOT (`reg 84 — the individual's contributory salary and wages for the year are included as self-employed earnings` TRUE 2025 TRUE FALSE (YMD 2027 4 30))
#ASSERT `reg 84.1 — the extent of the income of the Indian for the year from self-employment on a reserve` TRUE 12000 EQUALS JUST 12000
#ASSERT `reg 84.1 — the extent of the income of the Indian for the year from self-employment on a reserve` FALSE 12000 EQUALS NOTHING

§§ `Regulation 86: the agreements and common-law partners`

-- Cohabiting from 1 January 2025: a year is complete on 1 January 2026 (the core's reading, fork F7 of the keel).
#ASSERT `reg 86 — the agreement is applied so that the person has the treatment afforded to a spouse` "Australia" TRUE (YMD 2025 1 1) (YMD 2026 1 1)
#ASSERT NOT (`reg 86 — the agreement is applied so that the person has the treatment afforded to a spouse` "Australia" TRUE (YMD 2025 1 1) (YMD 2025 12 31))
#ASSERT NOT (`reg 86 — the agreement is applied so that the person has the treatment afforded to a spouse` "Australia" FALSE (YMD 2025 1 1) (YMD 2026 1 1))
#ASSERT NOT (`reg 86 — the agreement is applied so that the person has the treatment afforded to a spouse` "China" TRUE (YMD 2025 1 1) (YMD 2026 1 1))

§§ `Regulation 88: the Social Insurance Number`

#ASSERT `reg 88(1) — a Minister may cause a Social Insurance Number to be assigned to the individual` FALSE
#ASSERT NOT (`reg 88(1) — a Minister may cause a Social Insurance Number to be assigned to the individual` TRUE)
#ASSERT `reg 88(2) — a Minister may cause a Social Insurance Number Card to be issued to the individual` TRUE
#ASSERT NOT (`reg 88(2) — a Minister may cause a Social Insurance Number Card to be issued to the individual` FALSE)

§§ `Regulation 85: the Year's Maximum Pensionable Earnings`

-- (1): the calculation follows the publication (fork F18: from the next day).
#ASSERT `reg 85(1) — the first day on which the Year's Maximum Pensionable Earnings for a year is calculated` (YMD 2026 9 15) EQUALS (YMD 2026 9 16)
-- (4): the first three digits after the decimal point; the third decides.
#ASSERT `reg 85(4) — an amount adjusted to two digits after the decimal point` 1.2349 EQUALS 1.23
#ASSERT `reg 85(4) — an amount adjusted to two digits after the decimal point` 1.235 EQUALS 1.24
#ASSERT `reg 85(4) — an amount adjusted to two digits after the decimal point` 1.2345 EQUALS 1.23
#ASSERT `reg 85(4) — an amount adjusted to two digits after the decimal point` 2.999 EQUALS 3
#ASSERT `reg 85(4) — an amount adjusted to two digits after the decimal point` 5 EQUALS 5
#ASSERT `reg 85(4) — an amount adjusted to two digits after the decimal point` 0.004 EQUALS 0
#ASSERT `reg 85(4) — an amount adjusted to two digits after the decimal point` 0.005 EQUALS 0.01
-- (3): the first four digits; the fourth decides, and the third goes up.
#ASSERT `reg 85(3) — a ratio adjusted to three digits after the decimal point` 1.00349 EQUALS 1.003
#ASSERT `reg 85(3) — a ratio adjusted to three digits after the decimal point` 1.0035 EQUALS 1.004
#ASSERT `reg 85(3) — a ratio adjusted to three digits after the decimal point` 0.99995 EQUALS 1
#ASSERT `reg 85(3) — a ratio adjusted to three digits after the decimal point` 0.9994 EQUALS 0.999
#ASSERT `reg 85(3) — a ratio adjusted to three digits after the decimal point` 3 EQUALS 3
-- (2): the aggregate of the monthly Wage Measure divided by the number of months, adjusted as in (4).
#ASSERT `reg 85(2) — the average of the Wage Measure for a period` (LIST 1000, 1001, 1002) EQUALS JUST 1001
#ASSERT `reg 85(2) — the average of the Wage Measure for a period` (LIST 1, 2) EQUALS JUST 1.5
#ASSERT `reg 85(2) — the average of the Wage Measure for a period` (LIST 1000, 1000, 1001) EQUALS JUST 1000.33
#ASSERT `reg 85(2) — the average of the Wage Measure for a period` (LIST 2.005) EQUALS JUST 2.01
#ASSERT `reg 85(2) — the average of the Wage Measure for a period` EMPTY EQUALS NOTHING

§§ `Regulation 87(1): the definitions`

#ASSERT `reg 87(1) — the average bank rate` (LIST 0.0425, 0.045) EQUALS JUST 0.04375
#ASSERT `reg 87(1) — the average bank rate` EMPTY EQUALS NOTHING
#ASSERT `reg 87(1) — an amount owing is a debt` `a debt due under subsection 66(2) of the Act in respect of which a penalty has been imposed under section 90.1 of the Act`
#ASSERT `reg 87(1) — an amount owing is a debt` `a debt due under subsection 66(2.02) of the Act`
#ASSERT NOT (`reg 87(1) — an amount owing is a debt` `any other amount owing`)
#ASSERT `reg 87(1) — a communication is a demand for payment` TRUE FALSE
#ASSERT `reg 87(1) — a communication is a demand for payment` FALSE TRUE
#ASSERT NOT (`reg 87(1) — a communication is a demand for payment` FALSE FALSE)
-- A schedule: any day a scheduled payment is to be made. No schedule: 120 days after the demand (1 January + 120 days is 1 May 2026).
#ASSERT `reg 87(1) — a day is a due date of the debt` (YMD 2026 6 1) TRUE (LIST (YMD 2026 5 1), (YMD 2026 6 1)) (YMD 2026 1 1)
#ASSERT NOT (`reg 87(1) — a day is a due date of the debt` (YMD 2026 5 15) TRUE (LIST (YMD 2026 5 1), (YMD 2026 6 1)) (YMD 2026 1 1))
#ASSERT `reg 87(1) — a day is a due date of the debt` (YMD 2026 5 1) FALSE (LIST (YMD 2026 6 1)) (YMD 2026 1 1)
#ASSERT NOT (`reg 87(1) — a day is a due date of the debt` (YMD 2026 4 30) FALSE (LIST (YMD 2026 4 30)) (YMD 2026 1 1))

§§ `Regulation 87(2) to (4)`

#ASSERT `reg 87(2) — interest is payable on the debt` TRUE
#ASSERT NOT (`reg 87(2) — interest is payable on the debt` FALSE)
#ASSERT `reg 87(3) — the day the accrual of interest on the debt begins` (YMD 2026 5 1) EQUALS (YMD 2026 5 1)
#ASSERT `reg 87(4) — the rate at which interest accrues on the debt` 0.04375 EQUALS 0.07375
-- 10,000 at 7.3 per cent for 31 days of a 365-day year: 10,000 x 0.073 x 31 / 365 = 62 exactly (fork F19: the basis is an input).
#ASSERT `reg 87(4) — the interest that accrues on a balance in one month` 10000 0.073 31 365 EQUALS 62
#ASSERT `reg 87(4) — the balance after the month's interest is compounded` 10000 0.073 31 365 EQUALS 10062

§§ `Regulation 87(5) to (7)`

#ASSERT `reg 87(5) — interest accrues on the debt on the day` FALSE FALSE FALSE
#ASSERT NOT (`reg 87(5) — interest accrues on the debt on the day` TRUE FALSE FALSE)
#ASSERT NOT (`reg 87(5) — interest accrues on the debt on the day` FALSE TRUE FALSE)
#ASSERT NOT (`reg 87(5) — interest accrues on the debt on the day` FALSE FALSE TRUE)
#ASSERT `reg 87(6)(c)(ii) — the day of the latest of the decisions` (JUST (YMD 2026 3 1)) (JUST (YMD 2026 5 1)) EQUALS JUST (YMD 2026 5 1)
#ASSERT `reg 87(6)(c)(ii) — the day of the latest of the decisions` (JUST (YMD 2026 6 1)) (JUST (YMD 2026 5 1)) EQUALS JUST (YMD 2026 6 1)
#ASSERT `reg 87(6)(c)(ii) — the day of the latest of the decisions` (JUST (YMD 2026 3 1)) NOTHING EQUALS JUST (YMD 2026 3 1)
#ASSERT `reg 87(6)(c)(ii) — the day of the latest of the decisions` NOTHING NOTHING EQUALS NOTHING
-- Arguments: payment received; remitted under 66(3); reduced or rescinded under 90.1(4); the latest decision; interest remitted; the debtor dies.
-- The day before the day a payment is received (10 June) is 9 June.
#ASSERT `reg 87(6) — the day the accrual of interest on the debt ceases` (JUST (YMD 2026 6 10)) NOTHING NOTHING NOTHING NOTHING (JUST (YMD 2026 6 20)) EQUALS JUST (YMD 2026 6 9)
#ASSERT `reg 87(6) — the day the accrual of interest on the debt ceases` (JUST (YMD 2026 6 10)) (JUST (YMD 2026 5 30)) NOTHING NOTHING NOTHING NOTHING EQUALS JUST (YMD 2026 5 30)
#ASSERT `reg 87(6) — the day the accrual of interest on the debt ceases` (JUST (YMD 2026 6 10)) NOTHING (JUST (YMD 2026 4 15)) (JUST (YMD 2026 8 1)) NOTHING NOTHING EQUALS JUST (YMD 2026 4 15)
#ASSERT `reg 87(6) — the day the accrual of interest on the debt ceases` NOTHING NOTHING NOTHING (JUST (YMD 2026 8 1)) NOTHING NOTHING EQUALS JUST (YMD 2026 8 1)
#ASSERT `reg 87(6) — the day the accrual of interest on the debt ceases` NOTHING NOTHING NOTHING NOTHING (JUST (YMD 2026 9 9)) (JUST (YMD 2026 9 10)) EQUALS JUST (YMD 2026 9 9)
#ASSERT `reg 87(6) — the day the accrual of interest on the debt ceases` NOTHING NOTHING NOTHING NOTHING NOTHING (JUST (YMD 2026 12 24)) EQUALS JUST (YMD 2026 12 24)
#ASSERT `reg 87(6) — the day the accrual of interest on the debt ceases` NOTHING NOTHING NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING
-- 87(7): all four conditions together.
#ASSERT `reg 87(7) — the Minister may remit the interest in whole or in part` TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 87(7) — the Minister may remit the interest in whole or in part` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 87(7) — the Minister may remit the interest in whole or in part` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 87(7) — the Minister may remit the interest in whole or in part` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`reg 87(7) — the Minister may remit the interest in whole or in part` TRUE TRUE TRUE FALSE)
