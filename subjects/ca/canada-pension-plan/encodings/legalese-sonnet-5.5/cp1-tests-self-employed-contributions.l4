IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cp1-nouns`
IMPORT `cp1-div-a-employee-employer-contributions`
IMPORT `cp1-div-a-self-employed-contributions`

-- Tests of cp1-div-a-self-employed-contributions.l4: sections 10 and 11.
-- Every expected value was worked out by hand from the text before the file was run. The rates and maximums are
-- ILLUSTRATIVE 2024-style figures (self-employed base rate (9.9%), first additional (2%), second additional (8%); maximum
-- pensionable earnings 68,500; additional maximum 73,200; exemption 3,500; maximum contributory earnings 65,000).
-- They are test inputs, not readings of Schedules 1 and 2 (piece cp6).

§ `Tests -- section 10(1): the base contribution on self-employed earnings`

-- (9.9%) of the lesser of (a) earnings - (exemption not already deducted) and (b) maximum contributory earnings - (salary and wages already contributed on, provincial amount).
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` TRUE 80_000 (9.9%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS JUST 6_435
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` TRUE 30_000 (9.9%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS JUST 2_623.5
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` TRUE 30_000 (9.9%) 3_500 3_500 0 65_000 NOTHING NOTHING EQUALS JUST 2_970
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` TRUE 30_000 (9.9%) 3_500 1_000 500 65_000 NOTHING NOTHING EQUALS JUST 2_772
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` TRUE 30_000 (9.9%) 3_500 5_000 0 65_000 NOTHING NOTHING EQUALS JUST 2_970
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` TRUE 80_000 (9.9%) 3_500 0 0 65_000 (JUST 40_000) NOTHING EQUALS JUST 2_475
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` TRUE 80_000 (9.9%) 3_500 0 0 65_000 (JUST 40_000) (JUST 10_000) EQUALS JUST 1_485
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` TRUE 80_000 (9.9%) 3_500 0 0 65_000 NOTHING (JUST 10_000) EQUALS JUST 5_445
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` TRUE 68_500 (9.9%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS JUST 6_435
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` TRUE 1_000 (9.9%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS JUST (0 MINUS 247.5)
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` FALSE 80_000 (9.9%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` TRUE 0 (9.9%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 10(1) — the individual's base contribution on self-employed earnings for the year` TRUE (0 MINUS 500) (9.9%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS NOTHING

§ `Tests -- section 10(1.1) and (1.2): the first and second additional contributions`
#ASSERT `s 10(1.1) — the individual's first additional contribution on self-employed earnings for the year` 2024 TRUE 80_000 (2%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS JUST 1_300
#ASSERT `s 10(1.1) — the individual's first additional contribution on self-employed earnings for the year` 2019 TRUE 80_000 (2%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS JUST 1_300
#ASSERT `s 10(1.1) — the individual's first additional contribution on self-employed earnings for the year` 2018 TRUE 80_000 (2%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 10(1.1) — the individual's first additional contribution on self-employed earnings for the year` 2024 TRUE 30_000 (2%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS JUST 530
#ASSERT `s 10(1.1) — the individual's first additional contribution on self-employed earnings for the year` 2024 TRUE 80_000 (2%) 3_500 0 0 65_000 (JUST 5_000) NOTHING EQUALS JUST 1_200
#ASSERT `s 10(1.1) — the individual's first additional contribution on self-employed earnings for the year` 2024 FALSE 80_000 (2%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 10(1.1) — the individual's first additional contribution on self-employed earnings for the year` 2024 TRUE 0 (2%) 3_500 0 0 65_000 NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 10(1.2) — the individual's second additional contribution on self-employed earnings for the year` 2024 TRUE 80_000 (8%) 73_200 68_500 NOTHING NOTHING EQUALS JUST 376
#ASSERT `s 10(1.2) — the individual's second additional contribution on self-employed earnings for the year` 2024 TRUE 80_000 (8%) 73_200 68_500 (JUST 1_000) (JUST 500) EQUALS JUST 256
#ASSERT `s 10(1.2) — the individual's second additional contribution on self-employed earnings for the year` 2024 TRUE 60_000 (8%) 73_200 68_500 NOTHING NOTHING EQUALS JUST 0
#ASSERT `s 10(1.2) — the individual's second additional contribution on self-employed earnings for the year` 2024 TRUE 68_500 (8%) 73_200 68_500 NOTHING NOTHING EQUALS JUST 0
#ASSERT `s 10(1.2) — the individual's second additional contribution on self-employed earnings for the year` 2024 TRUE 73_200 (8%) 73_200 68_500 NOTHING NOTHING EQUALS JUST 376
#ASSERT `s 10(1.2) — the individual's second additional contribution on self-employed earnings for the year` 2024 TRUE 200_000 (8%) 73_200 68_500 NOTHING NOTHING EQUALS JUST 376
#ASSERT `s 10(1.2) — the individual's second additional contribution on self-employed earnings for the year` 2023 TRUE 80_000 (8%) 73_200 68_500 NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 10(1.2) — the individual's second additional contribution on self-employed earnings for the year` 2024 FALSE 80_000 (8%) 73_200 68_500 NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 10(1.2) — the individual's second additional contribution on self-employed earnings for the year` 2024 TRUE 0 (8%) 73_200 68_500 NOTHING NOTHING EQUALS NOTHING

§ `Tests -- section 10(2): employment succeeded by self-employment`
#ASSERT `s 10(2) — the person may take into account the corporation's payments` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `s 10(2) — the person may take into account the corporation's payments` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `s 10(2) — the person may take into account the corporation's payments` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `s 10(2) — the person may take into account the corporation's payments` TRUE FALSE FALSE EQUALS FALSE
#ASSERT `s 10(2) — the person may take into account the corporation's payments` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `s 10(2) — the person may take into account the corporation's payments` FALSE TRUE FALSE EQUALS FALSE
#ASSERT `s 10(2) — the person may take into account the corporation's payments` FALSE FALSE TRUE EQUALS FALSE
#ASSERT `s 10(2) — the person may take into account the corporation's payments` FALSE FALSE FALSE EQUALS FALSE
#ASSERT `s 10(2)(a) — the amount the person may take into account as contributory self-employed earnings in the year` TRUE 50_000 EQUALS JUST 50_000
#ASSERT `s 10(2)(a) — the amount the person may take into account as contributory self-employed earnings in the year` FALSE 50_000 EQUALS NOTHING
#ASSERT `s 10(2)(b) — the amount the person may take into account as contributions by the person in respect of self-employment earnings in that year` TRUE 2_000 2_500 EQUALS JUST 4_500
#ASSERT `s 10(2)(b) — the amount the person may take into account as contributions by the person in respect of self-employment earnings in that year` FALSE 2_000 2_500 EQUALS NOTHING

§ `Tests -- section 11: the election not to contribute`
-- (2): filed in 2020, approved, in the prescribed manner, revocation received in 2023: effective for 2020 to 2023 (from January 1 of the year filed; to January 1 of the year after the revocation is received).
#ASSERT `s 11(2) — the election has effect for a year` 2019 TRUE TRUE 2020 (JUST 2023) EQUALS FALSE
#ASSERT `s 11(2) — the election has effect for a year` 2020 TRUE TRUE 2020 (JUST 2023) EQUALS TRUE
#ASSERT `s 11(2) — the election has effect for a year` 2021 TRUE TRUE 2020 (JUST 2023) EQUALS TRUE
#ASSERT `s 11(2) — the election has effect for a year` 2023 TRUE TRUE 2020 (JUST 2023) EQUALS TRUE
#ASSERT `s 11(2) — the election has effect for a year` 2024 TRUE TRUE 2020 (JUST 2023) EQUALS FALSE
#ASSERT `s 11(2) — the election has effect for a year` 2030 TRUE TRUE 2020 NOTHING EQUALS TRUE
#ASSERT `s 11(2) — the election has effect for a year` 2020 TRUE FALSE 2020 NOTHING EQUALS FALSE
#ASSERT `s 11(2) — the election has effect for a year` 2020 FALSE TRUE 2020 NOTHING EQUALS FALSE
#ASSERT `s 11(2) — the election has effect for a year` 2019 TRUE TRUE 2020 NOTHING EQUALS FALSE
#ASSERT `s 11(2)(b) — the first year for which the election has effect` TRUE 2020 EQUALS JUST 2020
#ASSERT `s 11(2)(b) — the first year for which the election has effect` FALSE 2020 EQUALS NOTHING
#ASSERT `s 11(2)(c) — the last year for which the election has effect` (JUST 2023) EQUALS JUST 2023
#ASSERT `s 11(2)(c) — the last year for which the election has effect` NOTHING EQUALS NOTHING
-- (3): the Minister must approve the election if satisfied of all four matters.
#ASSERT `s 11(3) — the Minister must approve the election` TRUE TRUE TRUE TRUE EQUALS TRUE
#ASSERT `s 11(3) — the Minister must approve the election` TRUE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `s 11(3) — the Minister must approve the election` TRUE TRUE FALSE TRUE EQUALS FALSE
#ASSERT `s 11(3) — the Minister must approve the election` TRUE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `s 11(3) — the Minister must approve the election` FALSE TRUE TRUE TRUE EQUALS FALSE
-- (6): the Minister must certify the sect if satisfied of the three matters and the sect has applied.
#ASSERT `s 11(6) — the Minister must certify the religious sect or division` TRUE TRUE TRUE TRUE EQUALS TRUE
#ASSERT `s 11(6) — the Minister must certify the religious sect or division` TRUE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `s 11(6) — the Minister must certify the religious sect or division` TRUE TRUE FALSE TRUE EQUALS FALSE
#ASSERT `s 11(6) — the Minister must certify the religious sect or division` TRUE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `s 11(6) — the Minister must certify the religious sect or division` FALSE TRUE TRUE TRUE EQUALS FALSE
-- (5): one election only: a person who elected and revoked may not elect again for a subsequent year.
#ASSERT `s 11(5) — the individual may make an election under section 11 with respect to a subsequent year` TRUE EQUALS FALSE
#ASSERT `s 11(5) — the individual may make an election under section 11 with respect to a subsequent year` FALSE EQUALS TRUE
-- (1): section 10 does not apply to a member of a certified sect who has an effective election and may make one.
#ASSERT `s 11(1) — section 10 does not apply with respect to the year to the individual` TRUE TRUE TRUE TRUE EQUALS TRUE
#ASSERT `s 11(1) — section 10 does not apply with respect to the year to the individual` TRUE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `s 11(1) — section 10 does not apply with respect to the year to the individual` TRUE TRUE FALSE TRUE EQUALS FALSE
#ASSERT `s 11(1) — section 10 does not apply with respect to the year to the individual` TRUE FALSE TRUE TRUE EQUALS FALSE
#ASSERT `s 11(1) — section 10 does not apply with respect to the year to the individual` FALSE TRUE TRUE TRUE EQUALS FALSE
-- (4): a contribution made for a year the contributor elects not to contribute is returned on application.
#ASSERT `s 11(4) — the contribution must be returned to the contributor` TRUE TRUE TRUE EQUALS TRUE
#ASSERT `s 11(4) — the contribution must be returned to the contributor` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `s 11(4) — the contribution must be returned to the contributor` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `s 11(4) — the contribution must be returned to the contributor` TRUE FALSE FALSE EQUALS FALSE
#ASSERT `s 11(4) — the contribution must be returned to the contributor` FALSE TRUE TRUE EQUALS FALSE
#ASSERT `s 11(4) — the contribution must be returned to the contributor` FALSE TRUE FALSE EQUALS FALSE
#ASSERT `s 11(4) — the contribution must be returned to the contributor` FALSE FALSE TRUE EQUALS FALSE
#ASSERT `s 11(4) — the contribution must be returned to the contributor` FALSE FALSE FALSE EQUALS FALSE
