IMPORT prelude
IMPORT daydate
IMPORT `cpp-core`
IMPORT `cpp-core-calendar`
IMPORT `cpp-core-age`
IMPORT `cpp-core-definitions`
IMPORT `cp5-months`
IMPORT `cp5-d-death-survivor`

-- Tests of sections 71 to 73 (cp5-d-death-survivor.l4). Expected values were worked out by hand from the text
-- (and, for the figures section 71(2) leaves to regulations, from regulation 64(1) of the Regulations).

§ `Tests of sections 71 to 73`

§§ `Section 71 -- the prescribed time interval, regulation 64(1)`

-- 60 days after 10 January 2023 is 11 March 2023 (21 days to 31 January, 28 to 28 February, 11 more).
#ASSERT `s 71(2)(b) — the last day of the prescribed time interval following the contributor's death` (YearMonthDay 2023 1 10) EQUALS YearMonthDay 2023 3 11
-- Considered on 12 March 2023 with no application by the estate: has not applied within the interval.
#ASSERT `s 71(2)(b) — the estate has not applied for the death benefit within the prescribed time interval following the contributor's death` (YearMonthDay 2023 1 10) NOTHING (YearMonthDay 2023 3 12)
-- On the last day of the interval the interval has not yet run out.
#ASSERT NOT (`s 71(2)(b) — the estate has not applied for the death benefit within the prescribed time interval following the contributor's death` (YearMonthDay 2023 1 10) NOTHING (YearMonthDay 2023 3 11))
-- The estate applied on the last day of the interval: within it.
#ASSERT NOT (`s 71(2)(b) — the estate has not applied for the death benefit within the prescribed time interval following the contributor's death` (YearMonthDay 2023 1 10) (JUST (YearMonthDay 2023 3 11)) (YearMonthDay 2023 3 20))
-- The estate applied the day after: not within it.
#ASSERT `s 71(2)(b) — the estate has not applied for the death benefit within the prescribed time interval following the contributor's death` (YearMonthDay 2023 1 10) (JUST (YearMonthDay 2023 3 12)) (YearMonthDay 2023 3 20)

§§ `Section 71 -- the prescribed amount, regulation 64(1)`

-- A death in 2010: $2,387.
#ASSERT `s 71(2)(c) — the prescribed amount for the death benefit of a contributor who died before 2019` (YearMonthDay 2010 5 5) 36000 EQUALS JUST 2387
-- The last day of 1997: two thirds of 10% of the Year's Maximum Pensionable Earnings (36000 gives 2400).
#ASSERT `s 71(2)(c) — the prescribed amount for the death benefit of a contributor who died before 2019` (YearMonthDay 1997 12 31) 36000 EQUALS JUST 2400
-- The first day of 1998: the $2,387 regime begins.
#ASSERT `s 71(2)(c) — the prescribed amount for the death benefit of a contributor who died before 2019` (YearMonthDay 1998 1 1) 36000 EQUALS JUST 2387
-- The last day of 2018: still $2,387. The first day of 2019: paragraph (c) is out of play.
#ASSERT `s 71(2)(c) — the prescribed amount for the death benefit of a contributor who died before 2019` (YearMonthDay 2018 12 31) 36000 EQUALS JUST 2387
#ASSERT `s 71(2)(c) — the prescribed amount for the death benefit of a contributor who died before 2019` (YearMonthDay 2019 1 1) 36000 EQUALS NOTHING

§§ `Section 71(2) -- the Minister may direct payment`

-- (a) no estate.
#ASSERT `s 71(2) — the Minister may direct payment of the death benefit in whole or in part to a prescribed person or body` TRUE (YearMonthDay 2023 1 10) NOTHING (YearMonthDay 2023 1 20) 5000 36000
-- (b) the estate has not applied within the interval.
#ASSERT `s 71(2) — the Minister may direct payment of the death benefit in whole or in part to a prescribed person or body` FALSE (YearMonthDay 2023 1 10) NOTHING (YearMonthDay 2023 3 12) 5000 36000
-- (c) a death in 2010, benefit $2,386.99 is less than $2,387.
#ASSERT `s 71(2) — the Minister may direct payment of the death benefit in whole or in part to a prescribed person or body` FALSE (YearMonthDay 2010 5 5) (JUST (YearMonthDay 2010 5 20)) (YearMonthDay 2010 8 1) 2386.99 36000
-- ... but $2,387 is not less than $2,387.
#ASSERT NOT (`s 71(2) — the Minister may direct payment of the death benefit in whole or in part to a prescribed person or body` FALSE (YearMonthDay 2010 5 5) (JUST (YearMonthDay 2010 5 20)) (YearMonthDay 2010 8 1) 2387 36000)
-- A death in 2023 with a small benefit: paragraph (c) is only for deaths before 2019.
#ASSERT NOT (`s 71(2) — the Minister may direct payment of the death benefit in whole or in part to a prescribed person or body` FALSE (YearMonthDay 2023 1 10) (JUST (YearMonthDay 2023 1 20)) (YearMonthDay 2023 3 20) 100 36000)
-- A death on 31 December 1997, benefit 2399 < 2400.
#ASSERT `s 71(2) — the Minister may direct payment of the death benefit in whole or in part to a prescribed person or body` FALSE (YearMonthDay 1997 12 31) (JUST (YearMonthDay 1998 1 5)) (YearMonthDay 1998 4 1) 2399 36000
#ASSERT NOT (`s 71(2) — the Minister may direct payment of the death benefit in whole or in part to a prescribed person or body` FALSE (YearMonthDay 1997 12 31) (JUST (YearMonthDay 1998 1 5)) (YearMonthDay 1998 4 1) 2400 36000)

§§ `Section 71 as a whole, and regulation 64(1) to (3)`

#ASSERT `s 71 — to whom the death benefit is paid` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 71 — to whom the death benefit is paid` TRUE FALSE TRUE EQUALS JUST `the death benefit is paid to the estate of the contributor`
#ASSERT `s 71 — to whom the death benefit is paid` TRUE TRUE FALSE EQUALS JUST `the death benefit is paid to the estate of the contributor`
#ASSERT `s 71 — to whom the death benefit is paid` TRUE TRUE TRUE EQUALS JUST `the death benefit is paid to a prescribed person or body as the Minister directs`
#ASSERT `s 71(2) — the person or body to whom payment may be directed under regulation 64(1)` TRUE TRUE TRUE EQUALS `payment is directed to the individual or institution who has paid or is responsible for the funeral expenses`
#ASSERT `s 71(2) — the person or body to whom payment may be directed under regulation 64(1)` FALSE TRUE TRUE EQUALS `payment is directed to the survivor of the deceased contributor`
#ASSERT `s 71(2) — the person or body to whom payment may be directed under regulation 64(1)` FALSE FALSE TRUE EQUALS `payment is directed to the next of kin of the deceased contributor`
#ASSERT `s 71(2) — the person or body to whom payment may be directed under regulation 64(1)` FALSE FALSE FALSE EQUALS `payment cannot be directed to anyone whom regulation 64(1) describes`
-- Funeral expenses of $3,000 against a $2,500 benefit: all of it; with expenses of $1,000: $1,000 and the remaining $1,500 as if that person were absent.
#ASSERT `s 71(2) — the most that may be paid to the individual or institution who paid the funeral expenses under regulation 64(2)` 2500 3000 EQUALS 2500
#ASSERT `s 71(2) — the remainder of the death benefit that may be directed as if the individual or institution who paid the funeral expenses were absent under regulation 64(3)` 2500 3000 EQUALS 0
#ASSERT `s 71(2) — the most that may be paid to the individual or institution who paid the funeral expenses under regulation 64(2)` 2500 1000 EQUALS 1000
#ASSERT `s 71(2) — the remainder of the death benefit that may be directed as if the individual or institution who paid the funeral expenses were absent under regulation 64(3)` 2500 1000 EQUALS 1500
-- Subsection 71(3).
#ASSERT `s 71(3) — the Minister is not liable to make that payment to any subsequent applicant` TRUE
#ASSERT NOT (`s 71(3) — the Minister is not liable to make that payment to any subsequent applicant` FALSE)

§§ `Section 72 -- the survivor's pension begins`

-- The earliest month by reason of the application: the eleventh month before the month of the application (the twelfth before the month after).
#ASSERT `s 72 — the earliest month for which a survivor's pension is payable, by reason of the application` (YearMonthDay 2017 6 10) EQUALS YearMonthDay 2016 7 1
#ASSERT `s 72 — the earliest month for which a survivor's pension is payable, by reason of the application` (YearMonthDay 2017 1 10) EQUALS YearMonthDay 2016 2 1
-- A survivor born 10 January 1970 (45 at the death on 20 March 2015), (i) applies, application 10 June 2015: April 2015.
#ASSERT `s 72 — the first month for which a survivor's pension is payable` TRUE TRUE FALSE (YearMonthDay 1970 1 10) (YearMonthDay 2015 3 20) FALSE NOTHING (YearMonthDay 2015 6 10) EQUALS JUST (YearMonthDay 2015 4 1)
-- The same survivor applying late (10 June 2017): not earlier than July 2016.
#ASSERT `s 72 — the first month for which a survivor's pension is payable` TRUE TRUE FALSE (YearMonthDay 1970 1 10) (YearMonthDay 2015 3 20) FALSE NOTHING (YearMonthDay 2017 6 10) EQUALS JUST (YearMonthDay 2016 7 1)
-- A survivor born 10 January 1985 (30 at the death), with dependent children: (i)(i), April 2015.
#ASSERT `s 72 — the first month for which a survivor's pension is payable` TRUE TRUE FALSE (YearMonthDay 1985 1 10) (YearMonthDay 2015 3 20) TRUE NOTHING (YearMonthDay 2015 6 10) EQUALS JUST (YearMonthDay 2015 4 1)
-- Without dependent children but disabled from 5 August 2016 (not yet 65): the month following August 2016, September 2016.
#ASSERT `s 72 — the first month for which a survivor's pension is payable` TRUE TRUE FALSE (YearMonthDay 1985 1 10) (YearMonthDay 2015 3 20) FALSE (JUST (YearMonthDay 2016 8 5)) (YearMonthDay 2016 9 15) EQUALS JUST (YearMonthDay 2016 9 1)
-- Disabled before the contributor died: the month following the month of the death, April 2015.
#ASSERT `s 72 — the first month for which a survivor's pension is payable` TRUE TRUE FALSE (YearMonthDay 1985 1 10) (YearMonthDay 2015 3 20) FALSE (JUST (YearMonthDay 2014 8 5)) (YearMonthDay 2015 6 10) EQUALS JUST (YearMonthDay 2015 4 1)
-- Neither (i) nor (ii): the month following the month the survivor reaches 65. Born 10 January 1985: 65 on 10 January 2050, so February 2050.
#ASSERT `s 72 — the first month for which a survivor's pension is payable` TRUE TRUE FALSE (YearMonthDay 1985 1 10) (YearMonthDay 2015 3 20) FALSE NOTHING (YearMonthDay 2050 3 1) EQUALS JUST (YearMonthDay 2050 2 1)
#ASSERT `s 72(a) — the first month for which a survivor's pension under subparagraph 44(1)(d)(i) is payable` (YearMonthDay 1985 1 10) (YearMonthDay 2015 3 20) FALSE NOTHING EQUALS JUST (YearMonthDay 2050 2 1)
-- Born 15 March 1980, died 20 March 2015: section 2(2) treats the survivor as reaching 35 only on 1 April 2015, so not "had reached 35".
-- No dependent children, not disabled: the month following the 65th birthday (15 March 2045), April 2045.
#ASSERT `s 72(a) — the first month for which a survivor's pension under subparagraph 44(1)(d)(i) is payable` (YearMonthDay 1980 3 15) (YearMonthDay 2015 3 20) FALSE NOTHING EQUALS JUST (YearMonthDay 2045 4 1)
-- Died on 1 April 2015 instead: 35 is reached, so the month following the death, May 2015.
#ASSERT `s 72(a) — the first month for which a survivor's pension under subparagraph 44(1)(d)(i) is payable` (YearMonthDay 1980 3 15) (YearMonthDay 2015 4 1) FALSE NOTHING EQUALS JUST (YearMonthDay 2015 5 1)
-- Disabled only on the 65th birthday's day or later does not count as "not having reached 65": the survivor born 10 January 1960 became disabled on 15 February 2025
-- (65 reached 1 February 2025 under section 2(2)), so (iii): the actual 65th birthday was 10 January 2025, February 2025.
-- (The survivor was 30 when the contributor died on 20 March 1990, so (i) does not apply.)
#ASSERT `s 72(a) — the first month for which a survivor's pension under subparagraph 44(1)(d)(i) is payable` (YearMonthDay 1960 1 10) (YearMonthDay 1990 3 20) FALSE (JUST (YearMonthDay 2025 2 15)) EQUALS JUST (YearMonthDay 2025 2 1)
-- Disabled on 31 December 2024, before 65 is reached: (ii), the month following the disability month, January 2025.
#ASSERT `s 72(a) — the first month for which a survivor's pension under subparagraph 44(1)(d)(i) is payable` (YearMonthDay 1960 1 10) (YearMonthDay 1990 3 20) FALSE (JUST (YearMonthDay 2024 12 31)) EQUALS JUST (YearMonthDay 2025 1 1)
-- (b): after 2018, the month following the month of the death. Died 5 May 2020, application 1 July 2020: June 2020.
#ASSERT `s 72 — the first month for which a survivor's pension is payable` TRUE FALSE TRUE (YearMonthDay 1990 1 10) (YearMonthDay 2020 5 5) FALSE NOTHING (YearMonthDay 2020 7 1) EQUALS JUST (YearMonthDay 2020 6 1)
-- (b) with a late application (1 July 2022): not earlier than August 2021.
#ASSERT `s 72 — the first month for which a survivor's pension is payable` TRUE FALSE TRUE (YearMonthDay 1990 1 10) (YearMonthDay 2020 5 5) FALSE NOTHING (YearMonthDay 2022 7 1) EQUALS JUST (YearMonthDay 2021 8 1)
-- Both subparagraphs apply: the earlier of the two months. Born 1990, died 20 December 2018, disabled 10 June 2019, application 1 July 2019:
-- (a)(ii) July 2019, (b) January 2019. The earlier, January 2019, is not before the August 2018 floor.
#ASSERT `s 72 — the first month for which a survivor's pension is payable` TRUE TRUE TRUE (YearMonthDay 1990 1 10) (YearMonthDay 2018 12 20) FALSE (JUST (YearMonthDay 2019 6 10)) (YearMonthDay 2019 7 1) EQUALS JUST (YearMonthDay 2019 1 1)
-- Not approved, or neither subparagraph applies: nothing.
#ASSERT `s 72 — the first month for which a survivor's pension is payable` FALSE TRUE FALSE (YearMonthDay 1970 1 10) (YearMonthDay 2015 3 20) FALSE NOTHING (YearMonthDay 2015 6 10) EQUALS NOTHING
#ASSERT `s 72 — the first month for which a survivor's pension is payable` TRUE FALSE FALSE (YearMonthDay 1970 1 10) (YearMonthDay 2015 3 20) FALSE NOTHING (YearMonthDay 2015 6 10) EQUALS NOTHING
#ASSERT `s 72(b) — the month following the month in which the contributor died` (YearMonthDay 2020 12 31) EQUALS YearMonthDay 2021 1 1

§§ `Section 73 -- how long the survivor's pension is paid`

#ASSERT `s 73(1) — the last month for which a survivor's pension is paid on account of the beneficiary's death` (JUST (YearMonthDay 2025 8 31)) EQUALS JUST (YearMonthDay 2025 8 1)
#ASSERT `s 73(1) — the last month for which a survivor's pension is paid on account of the beneficiary's death` NOTHING EQUALS NOTHING
-- Subsection (2): died 5 May 2000, subsection (2) in force on 31 July 2000 (a stated input), both conditions met.
#ASSERT `s 73(2) — the approval of a survivor's pension to the common-law partner does not affect the right of the survivor who had been married to the contributor to continue to receive the survivor's pension` (YearMonthDay 2000 5 5) (YearMonthDay 2000 7 31) TRUE TRUE EQUALS JUST TRUE
-- Died before 1998: not covered.
#ASSERT `s 73(2) — the approval of a survivor's pension to the common-law partner does not affect the right of the survivor who had been married to the contributor to continue to receive the survivor's pension` (YearMonthDay 1997 12 31) (YearMonthDay 2000 7 31) TRUE TRUE EQUALS NOTHING
-- Died on 1 January 1998: covered.
#ASSERT `s 73(2) — the approval of a survivor's pension to the common-law partner does not affect the right of the survivor who had been married to the contributor to continue to receive the survivor's pension` (YearMonthDay 1998 1 1) (YearMonthDay 2000 7 31) TRUE TRUE EQUALS JUST TRUE
-- Died on the day subsection (2) came into force: not "before the coming into force".
#ASSERT `s 73(2) — the approval of a survivor's pension to the common-law partner does not affect the right of the survivor who had been married to the contributor to continue to receive the survivor's pension` (YearMonthDay 2000 7 31) (YearMonthDay 2000 7 31) TRUE TRUE EQUALS NOTHING
-- No pension was payable to a married survivor, or the other survivor was a spouse under the old paragraph (a)(ii).
#ASSERT `s 73(2) — the approval of a survivor's pension to the common-law partner does not affect the right of the survivor who had been married to the contributor to continue to receive the survivor's pension` (YearMonthDay 2000 5 5) (YearMonthDay 2000 7 31) FALSE TRUE EQUALS NOTHING
#ASSERT `s 73(2) — the approval of a survivor's pension to the common-law partner does not affect the right of the survivor who had been married to the contributor to continue to receive the survivor's pension` (YearMonthDay 2000 5 5) (YearMonthDay 2000 7 31) TRUE FALSE EQUALS NOTHING
-- Subsection (3): a division approved effective 15 June 2023, no new conjugal relationship: the pension ceases with the payment for June 2023.
#ASSERT `s 73(3) — the last month for which a survivor's pension is paid because of a division of unadjusted pensionable earnings` (JUST (YearMonthDay 2023 6 15)) FALSE (YearMonthDay 2020 1 1) (YearMonthDay 2021 2 1) EQUALS JUST (YearMonthDay 2023 6 1)
-- A new conjugal relationship, cohabiting from 1 January 2020 and the contributor died 1 February 2021 (more than a year): the exception holds.
#ASSERT `s 73(3) — the last month for which a survivor's pension is paid because of a division of unadjusted pensionable earnings` (JUST (YearMonthDay 2023 6 15)) TRUE (YearMonthDay 2020 1 1) (YearMonthDay 2021 2 1) EQUALS NOTHING
-- Cohabiting from 1 February 2020 and the death on 1 February 2021: exactly a year, at least one year: the exception holds.
#ASSERT `s 73(3) — the last month for which a survivor's pension is paid because of a division of unadjusted pensionable earnings` (JUST (YearMonthDay 2023 6 15)) TRUE (YearMonthDay 2020 2 1) (YearMonthDay 2021 2 1) EQUALS NOTHING
-- Cohabiting from 2 February 2020 and the death on 1 February 2021: one day short of a year: no exception.
#ASSERT `s 73(3) — the last month for which a survivor's pension is paid because of a division of unadjusted pensionable earnings` (JUST (YearMonthDay 2023 6 15)) TRUE (YearMonthDay 2020 2 2) (YearMonthDay 2021 2 1) EQUALS JUST (YearMonthDay 2023 6 1)
-- No division: subsection (3) does not end the pension.
#ASSERT `s 73(3) — the last month for which a survivor's pension is paid because of a division of unadjusted pensionable earnings` NOTHING FALSE (YearMonthDay 2020 1 1) (YearMonthDay 2021 2 1) EQUALS NOTHING
-- Paid for a month: from January 2022 through the earlier of the two last months.
#ASSERT `s 73 — a survivor's pension is paid for a month` (YearMonthDay 2023 5 1) (YearMonthDay 2022 1 1) NOTHING (JUST (YearMonthDay 2023 6 15)) FALSE (YearMonthDay 2020 1 1) (YearMonthDay 2021 2 1)
#ASSERT `s 73 — a survivor's pension is paid for a month` (YearMonthDay 2023 6 30) (YearMonthDay 2022 1 1) NOTHING (JUST (YearMonthDay 2023 6 15)) FALSE (YearMonthDay 2020 1 1) (YearMonthDay 2021 2 1)
#ASSERT NOT (`s 73 — a survivor's pension is paid for a month` (YearMonthDay 2023 7 1) (YearMonthDay 2022 1 1) NOTHING (JUST (YearMonthDay 2023 6 15)) FALSE (YearMonthDay 2020 1 1) (YearMonthDay 2021 2 1))
#ASSERT NOT (`s 73 — a survivor's pension is paid for a month` (YearMonthDay 2021 12 31) (YearMonthDay 2022 1 1) NOTHING (JUST (YearMonthDay 2023 6 15)) FALSE (YearMonthDay 2020 1 1) (YearMonthDay 2021 2 1))
-- With a death in March 2023 before the division: paid through March 2023.
#ASSERT `s 73 — a survivor's pension is paid for a month` (YearMonthDay 2023 3 31) (YearMonthDay 2022 1 1) (JUST (YearMonthDay 2023 3 9)) (JUST (YearMonthDay 2023 6 15)) FALSE (YearMonthDay 2020 1 1) (YearMonthDay 2021 2 1)
#ASSERT NOT (`s 73 — a survivor's pension is paid for a month` (YearMonthDay 2023 4 1) (YearMonthDay 2022 1 1) (JUST (YearMonthDay 2023 3 9)) (JUST (YearMonthDay 2023 6 15)) FALSE (YearMonthDay 2020 1 1) (YearMonthDay 2021 2 1))
