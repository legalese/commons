IMPORT prelude
IMPORT `cpp-core`
IMPORT `cpp-seat`

-- Cases for the contributor's and survivor's seat (cpp-seat.l4) and the regulative rules of the core (cpp-core.l4).
-- Every expected value was worked by hand from the deposited Act and Regulations, never copied from the encoding's
-- output; the arithmetic is in the comment above each. No scenario life raised this Act: the people are the
-- encoder's, HYPOTHETICAL throughout.
--
-- HYPOTHETICAL FIGURES. The Year's Maximum Pensionable Earnings is an input: the cases use $70,000 for 2026 and
-- $60,000 for 2021, which are NOT the published figures; so are the flat rate benefits ($600 disability, $200
-- survivor's) and every earnings-record figure. The statutory figures (the $3,500 exemption, the Schedule rates, the
-- 1.07 and 1.14 factors, the $2,500 and $5,000 death benefits) are the Act's.
--
-- A breached or still-pending DEONTIC cannot be asserted on the stable l4, so regulative rules are asserted where the
-- trace ends FULFILLED, and #TRACEd with an "-- expect:" line where it does not. Clock: days.

-- =====================================================================================================================
-- Part I: contributions. Answers: year; YMPE; months that count; wages; self-employed earnings; resident.
-- With YMPE 70,000 for 2026: YAMPE = 1.14 x 70,000 = 79,800 (a multiple of 100); basic exemption 3,500; maximum
-- contributory earnings 66,500.
-- =====================================================================================================================

-- s 18.1: 2024, 1.07 x 68,500 = 73,295, down to 73,200; 2025, 1.14 x 71,300 = 81,282, down to 81,200; 2023: none.
#ASSERT `the Year's Additional Maximum Pensionable Earnings` 2024 68500 EQUALS 73200
#ASSERT `the Year's Additional Maximum Pensionable Earnings` 2025 71300 EQUALS 81200
#ASSERT `the Year's Additional Maximum Pensionable Earnings` 2023 66600 EQUALS 66600

-- Employee, wages 50,000: band 50,000 - 3,500 = 46,500. Base 4.95% = 2,301.75; first additional 1% = 465; second nil.
#ASSERT `What is my total CPP contribution` 2026 70000 12 50000 0 TRUE EQUALS `the amount, in Canadian dollars, is` 2766.75
#ASSERT `What must I contribute to the CPP` 2026 70000 12 50000 0 TRUE EQUALS `my contributions are` (`Contributions` WITH `employee's base contribution` IS 2301.75, `employee's first additional contribution` IS 465, `employee's second additional contribution` IS 0, `self-employed base contribution` IS 0, `self-employed first additional contribution` IS 0, `self-employed second additional contribution` IS 0)
-- Employee, wages 90,000: band capped at 66,500: base 3,291.75, first 665; s 8(1.2): min(90,000, 79,800) - 70,000 =
-- 9,800 x 4% = 392. Total 4,348.75.
#ASSERT `What is my total CPP contribution` 2026 70000 12 90000 0 TRUE EQUALS `the amount, in Canadian dollars, is` 4348.75
-- Self-employed only, 50,000: s 10(1): 50,000 - 3,500 = 46,500 x 9.9% = 4,603.50; 2% = 930. Total 5,533.50.
#ASSERT `What is my total CPP contribution` 2026 70000 12 0 50000 TRUE EQUALS `the amount, in Canadian dollars, is` 5533.5
-- Self-employed only, 90,000: 66,500 x 9.9% = 6,583.50; x 2% = 1,330; s 10(1.2): 9,800 x 8% = 784. Total 8,697.50.
#ASSERT `What is my total CPP contribution` 2026 70000 12 0 90000 TRUE EQUALS `the amount, in Canadian dollars, is` 8697.5
-- Wages 30,000 and self-employed 20,000: employee band 26,500: 1,311.75 + 265. s 10(1): exemption all used by the
-- employer; lesser of 20,000 and 66,500 - 26,500 = 40,000: 20,000 x 9.9% = 1,980; x 2% = 400. Total 3,956.75.
#ASSERT `What is my total CPP contribution` 2026 70000 12 30000 20000 TRUE EQUALS `the amount, in Canadian dollars, is` 3956.75
-- Wages 70,000 and self-employed 10,000 (finding 3): employee 3,291.75 + 665, employee second band nil; s 10(1)(b)
-- leaves no base room; s 10(1.2) compares 10,000 alone with 70,000: nil. So 80,000 of earnings pay no second additional
-- contribution. Total 3,956.75.
#ASSERT `What must I contribute to the CPP` 2026 70000 12 70000 10000 TRUE EQUALS `my contributions are` (`Contributions` WITH `employee's base contribution` IS 3291.75, `employee's first additional contribution` IS 665, `employee's second additional contribution` IS 0, `self-employed base contribution` IS 0, `self-employed first additional contribution` IS 0, `self-employed second additional contribution` IS 0)
-- Wages under the exemption: nothing.
#ASSERT `What is my total CPP contribution` 2026 70000 12 2000 0 TRUE EQUALS `the amount, in Canadian dollars, is` 0
-- The year of turning 70, six months before: ss 17(a), 17.1(a), 19(a): MPE 35,000, exemption 1,750, maximum
-- contributory 33,250; wages counted (before 70, s 12(1)(d)) 25,000: band 23,250; base 1,150.875 to the cent 1,150.88;
-- first 232.50. Total 1,383.38.
#ASSERT `What is my total CPP contribution` 2026 70000 6 25000 0 TRUE EQUALS `the amount, in Canadian dollars, is` 1383.38
-- 2021 (YMPE 60,000): band 46,500; base 2,301.75; first additional 0.5% = 232.50; no second. Total 2,534.25.
#ASSERT `What is my total CPP contribution` 2021 60000 12 50000 0 TRUE EQUALS `the amount, in Canadian dollars, is` 2534.25
-- s 10(1): not resident in Canada for income tax: no self-employed contribution.
#ASSERT `What is my total CPP contribution` 2026 70000 12 0 50000 FALSE EQUALS `the amount, in Canadian dollars, is` 0
-- 2018: not covered.
#ASSERT `What must I contribute to the CPP` 2018 55900 12 50000 0 TRUE EQUALS `not covered: a year before 2019`

-- =====================================================================================================================
-- Part II: the retirement pension.
-- =====================================================================================================================
#ASSERT `Can I get a CPP retirement pension` 60 TRUE EQUALS `a retirement pension is payable on application (s 44(1)(a))`
#ASSERT `Can I get a CPP retirement pension` 59 TRUE EQUALS `no retirement pension: under 60 (s 44(1)(a))`
#ASSERT `Can I get a CPP retirement pension` 66 FALSE EQUALS `no retirement pension: not a contributor (s 2)`

-- s 67(3.1): apply at 63y4m (760): the month after, 761.
#ASSERT `From what age can my CPP pension start` 760 0 EQUALS 761
-- Apply at 58y4m (700): not before 60 (720).
#ASSERT `From what age can my CPP pension start` 700 0 EQUALS 720
-- Apply at 66y8m (800): 11 months back, 789.
#ASSERT `From what age can my CPP pension start` 800 0 EQUALS 789
-- Apply at 65y10m (790): 11 months back would be 779, but not before 65 (780).
#ASSERT `From what age can my CPP pension start` 790 0 EQUALS 780
-- Apply at 760, choosing 790: 790.
#ASSERT `From what age can my CPP pension start` 760 790 EQUALS 790

-- s 46(1): AMPE 5,000, first additional 600, second additional 300: 1,250 + 49.98 + 99.99 = 1,399.97 at 65.
#ASSERT `How much is my CPP retirement pension` 65 TRUE 5000 600 300 780 EQUALS `the amount, in Canadian dollars, is` 1399.97
-- Regulations s 78.3: starting at 60: 60 months x 0.006 = 0.36; 1,399.97 x 0.64 = 895.9808, 895.98.
#ASSERT `How much is my CPP retirement pension` 60 TRUE 5000 600 300 720 EQUALS `the amount, in Canadian dollars, is` 895.98
-- Starting at 62y6m (750): 30 months: x 0.82 = 1,147.9754, 1,147.98.
#ASSERT `How much is my CPP retirement pension` 62 TRUE 5000 600 300 750 EQUALS `the amount, in Canadian dollars, is` 1147.98
-- Regulations s 78.4: starting at 70: 60 months x 0.007 = 0.42; x 1.42 = 1,987.9574, 1,987.96.
#ASSERT `How much is my CPP retirement pension` 70 TRUE 5000 600 300 840 EQUALS `the amount, in Canadian dollars, is` 1987.96
-- Starting at 75: the interval is capped at 60 months: the same 1,987.96 (finding 4).
#ASSERT `How much is my CPP retirement pension` 75 TRUE 5000 600 300 900 EQUALS `the amount, in Canadian dollars, is` 1987.96
-- Under 60: none, and why.
#ASSERT `How much is my CPP retirement pension` 59 TRUE 5000 600 300 720 EQUALS `no retirement pension` `no retirement pension: under 60 (s 44(1)(a))`

-- s 48(4): 564 months remaining: 17% = 95.88, a complete month 96; 564 - 120 = 444: drop 96.
#ASSERT `the months dropped under s 48(4)` 564 EQUALS 96
-- 130 months: 17% = 22.1, so 23, but only 10 over 120: drop 10. 120: none.
#ASSERT `the months dropped under s 48(4)` 130 EQUALS 10
#ASSERT `the months dropped under s 48(4)` 120 EQUALS 0

-- =====================================================================================================================
-- Part II: the disability pension. Eligibility answers: age; retirement pension payable; severe; prolonged; years of
-- the last six; years in all; every year since an earlier benefit.
-- =====================================================================================================================
#ASSERT `Can I get a CPP disability pension` 50 FALSE TRUE TRUE 4 20 FALSE EQUALS `a disability pension is payable on application (s 44(1)(b))`
-- s 44(2)(a)(i.1): 3 of the last 6 and 26 in all.
#ASSERT `Can I get a CPP disability pension` 58 FALSE TRUE TRUE 3 26 FALSE EQUALS `a disability pension is payable on application (s 44(1)(b))`
-- 3 of the last 6 and 20 in all: neither (i) nor (i.1).
#ASSERT `Can I get a CPP disability pension` 50 FALSE TRUE TRUE 3 20 FALSE EQUALS `no disability pension: the minimum qualifying period is not met (s 44(2))`
-- 2 of the last 6 and 30 in all: (i.1) needs 3 of the last 6.
#ASSERT `Can I get a CPP disability pension` 60 FALSE TRUE TRUE 2 30 FALSE EQUALS `no disability pension: the minimum qualifying period is not met (s 44(2))`
-- s 44(2)(a)(ii): every year since the earlier benefit ceased.
#ASSERT `Can I get a CPP disability pension` 50 FALSE TRUE TRUE 1 10 TRUE EQUALS `a disability pension is payable on application (s 44(1)(b))`
#ASSERT `Can I get a CPP disability pension` 50 FALSE FALSE TRUE 4 20 FALSE EQUALS `no disability pension: not determined to have a severe and prolonged disability (s 42(2)(a))`
#ASSERT `Can I get a CPP disability pension` 65 FALSE TRUE TRUE 4 20 FALSE EQUALS `no disability pension: 65 or over, or a retirement pension is payable (s 44(1)(b))`
#ASSERT `Can I get a CPP disability pension` 62 TRUE TRUE TRUE 4 20 FALSE EQUALS `no disability pension: 65 or over, or a retirement pension is payable (s 44(1)(b))`

-- s 56(1): flat 600 + 75% x (25% x 4,000 + 8.33% x 200) = 600 + 75% x 1,016.66 = 600 + 762.495 = 1,362.495, 1,362.50.
#ASSERT `How much is my CPP disability pension` 600 50 FALSE TRUE TRUE 4 20 FALSE 4000 200 0 EQUALS `the amount, in Canadian dollars, is` 1362.5
#ASSERT `How much is my CPP disability pension` 600 50 FALSE TRUE TRUE 3 20 FALSE 4000 200 0 EQUALS `no disability pension` `no disability pension: the minimum qualifying period is not met (s 44(2))`
-- s 56(4): 200,000 over 30 months is divided by 48 (4,166.67 rounded here only in this comment); 480,000 over 120 months, by 120.
#ASSERT `the s 56(4) average monthly pensionable earnings` 480000 120 EQUALS 4000
#ASSERT `the s 56(4) average monthly pensionable earnings` 192000 30 EQUALS 4000

-- ss 42(2)(b), 69: disabled 20 months before applying: deemed no earlier than 15 months back; paid from the fourth month
-- after: 15 - 4 = 11 months before the application month.
#ASSERT `How far back can my CPP disability pension be paid` 20 FALSE EQUALS 11
-- Disabled 2 months before: 2 - 4 = -2, two months after the application month.
#ASSERT `How far back can my CPP disability pension be paid` 2 FALSE EQUALS (-2)
-- With an earlier disability pension in the five years: 12 months back, from the month after: 12 - 1 = 11.
#ASSERT `How far back can my CPP disability pension be paid` 20 TRUE EQUALS 11

-- =====================================================================================================================
-- Part II: after a death. Survivor answers: relationship; contributor's contribution years; years in the contributory
-- period; convicted; divided after 2024 without a new year of cohabitation.
-- =====================================================================================================================
#ASSERT `Can I get a CPP survivor's pension` `the common-law partner at death` 10 40 FALSE FALSE EQUALS `a survivor's pension is payable on application (s 44(1)(d)(ii))`
-- s 42(1): a married spouse is the survivor only "if there is no person described in paragraph (b)".
#ASSERT `Can I get a CPP survivor's pension` `married at death, but the contributor had a common-law partner` 10 40 FALSE FALSE EQUALS `no survivor's pension: not the survivor (s 42(1))`
#ASSERT `Can I get a CPP survivor's pension` `married at death, and there was no common-law partner` 10 40 FALSE FALSE EQUALS `a survivor's pension is payable on application (s 44(1)(d)(ii))`
-- s 44(3): 5 years of 30 (5 x 3 = 15 < 30, and under 10): not met.
#ASSERT `Can I get a CPP survivor's pension` `the common-law partner at death` 5 30 FALSE FALSE EQUALS `no survivor's pension: the contributor did not meet the minimum qualifying period (s 44(3))`
-- 4 of 12 (one third, and at least 3): met.
#ASSERT `Can I get a CPP survivor's pension` `the common-law partner at death` 4 12 FALSE FALSE EQUALS `a survivor's pension is payable on application (s 44(1)(d)(ii))`
-- 2 of 6 (one third, but under 3): not met.
#ASSERT `Can I get a CPP survivor's pension` `the common-law partner at death` 2 6 FALSE FALSE EQUALS `no survivor's pension: the contributor did not meet the minimum qualifying period (s 44(3))`
#ASSERT `Can I get a CPP survivor's pension` `the common-law partner at death` 10 40 TRUE FALSE EQUALS `no survivor's pension: convicted of the contributor's murder or manslaughter (s 44.1(1)(a))`
#ASSERT `Can I get a CPP survivor's pension` `married at death, and there was no common-law partner` 10 40 FALSE TRUE EQUALS `no survivor's pension: a division of pensionable earnings after 2024 and no new cohabitation of a year (s 44.2)`

-- s 58(1)(a.1): age 50, contributor's pension 1,000, flat 200: 200 + 375 = 575. No age reduction after 2018 (finding 6).
#ASSERT `How much is my CPP survivor's pension` 200 `the common-law partner at death` 10 40 FALSE FALSE 30 FALSE 1000 EQUALS `the amount, in Canadian dollars, is` 575
-- s 58(1)(b): age 70: 60% = 600.
#ASSERT `How much is my CPP survivor's pension` 200 `the common-law partner at death` 10 40 FALSE FALSE 70 FALSE 1000 EQUALS `the amount, in Canadian dollars, is` 600
-- With a retirement pension of one's own: s 58(2), not covered.
#ASSERT `How much is my CPP survivor's pension` 200 `the common-law partner at death` 10 40 FALSE FALSE 70 TRUE 1000 EQUALS `not covered: the survivor also has a retirement pension (s 58(2))`
#ASSERT `How much is my CPP survivor's pension` 200 `neither` 10 40 FALSE FALSE 50 FALSE 1000 EQUALS `no survivor's pension` `no survivor's pension: not the survivor (s 42(1))`

-- s 57(1.2): death in 2026, never on a CPP pension, no survivor's pension: $5,000.
#ASSERT `How much is the CPP death benefit` 2026 10 40 FALSE FALSE EQUALS `the amount, in Canadian dollars, is` 5000
-- s 57(1)(b): a survivor's pension is payable: $2,500.
#ASSERT `How much is the CPP death benefit` 2026 10 40 FALSE TRUE EQUALS `the amount, in Canadian dollars, is` 2500
-- Had received a retirement pension: $2,500.
#ASSERT `How much is the CPP death benefit` 2026 10 40 TRUE FALSE EQUALS `the amount, in Canadian dollars, is` 2500
-- Death in 2020 (before 2025): $2,500 even with no survivor.
#ASSERT `How much is the CPP death benefit` 2020 10 40 FALSE FALSE EQUALS `the amount, in Canadian dollars, is` 2500
#ASSERT `How much is the CPP death benefit` 2026 2 30 FALSE FALSE EQUALS `no death benefit: the contributor did not meet the minimum qualifying period (s 44(3))`
#ASSERT `How much is the CPP death benefit` 2015 10 40 FALSE FALSE EQUALS `not covered: a year before 2019, or a death before 2019`

-- =====================================================================================================================
-- Regulative rules (cpp-core.l4). Day 0 is the day the rule starts.
-- =====================================================================================================================
-- s 30(1): self-employed, 120 days to the due date, filed on day 100: fulfilled.
#ASSERT EVALTRACE (`s 30(1) -- a self-employed contributor must file a return of self-employed earnings by the income tax due date` TRUE 120) 0 (LIST (EVENT `the contributor or beneficiary` `file a return of self-employed earnings` 100)) EQUALS FULFILLED
#ASSERT EVALTRACE (`s 30(1) -- a self-employed contributor must file a return of self-employed earnings by the income tax due date` FALSE 120) 0 (LIST (EVENT `the contributor or beneficiary` `file a return of self-employed earnings` 100)) EQUALS FULFILLED
-- expect: BREACH BY the contributor or beneficiary, "s 30(1): ..." (filed on day 130)
#TRACE `s 30(1) -- a self-employed contributor must file a return of self-employed earnings by the income tax due date` TRUE 120 AT 0 WITH
    PARTY `the contributor or beneficiary` DOES `file a return of self-employed earnings` AT 130

-- s 66(1): returned on day 10: fulfilled.
#ASSERT EVALTRACE `s 66(1) -- a person overpaid must return the overpayment forthwith` 0 (LIST (EVENT `the contributor or beneficiary` `return the overpayment` 10)) EQUALS FULFILLED

-- s 81: request on day 60, the Minister's decision with reasons on day 90: fulfilled.
#ASSERT EVALTRACE `s 81 -- I may ask for a reconsideration within 90 days, and the Minister must then reconsider and give reasons in writing` 0 (LIST (EVENT `the contributor or beneficiary` `request a reconsideration` 60), (EVENT `the Minister` `reconsider and notify the decision with reasons` 90)) EQUALS FULFILLED
-- expect: the Minister's duty still pending after the request on day 60 (no number of days; "without delay")
#TRACE `s 81 -- I may ask for a reconsideration within 90 days, and the Minister must then reconsider and give reasons in writing` AT 0 WITH
    PARTY `the contributor or beneficiary` DOES `request a reconsideration` AT 60

-- Regulations s 70.1: back at work, tells the Minister on day 2: fulfilled; not back at work: nothing owed.
#ASSERT EVALTRACE (`Regulations s 70.1 -- a disability beneficiary who returns to work must tell the Minister without delay` TRUE) 0 (LIST (EVENT `the contributor or beneficiary` `inform the Minister of a return to work` 2)) EQUALS FULFILLED
#ASSERT EVALTRACE (`Regulations s 70.1 -- a disability beneficiary who returns to work must tell the Minister without delay` FALSE) 0 (LIST (EVENT `the contributor or beneficiary` `inform the Minister of a return to work` 2)) EQUALS FULFILLED

-- Regulations s 46.2: cancellation asked on day 200, repaid on day 400: fulfilled.
#ASSERT EVALTRACE `Regulations s 46.2 -- I may cancel my benefit within 12 months of its start, then must repay within 12 months` 0 (LIST (EVENT `the contributor or beneficiary` `request cancellation of the benefit` 200), (EVENT `the contributor or beneficiary` `repay the benefit` 400)) EQUALS FULFILLED
-- expect: BREACH BY the contributor or beneficiary, "Regulations s 46.2(4) ..." (repaid on day 600, 400 days after the request)
#TRACE `Regulations s 46.2 -- I may cancel my benefit within 12 months of its start, then must repay within 12 months` AT 0 WITH
    PARTY `the contributor or beneficiary` DOES `request cancellation of the benefit` AT 200
    PARTY `the contributor or beneficiary` DOES `repay the benefit` AT 600

-- Regulations s 71(2): asks for reinstatement on day 300: fulfilled.
#ASSERT EVALTRACE `Regulations s 71(2) -- I may ask for my disability pension back within 12 months of becoming unable to work again` 0 (LIST (EVENT `the contributor or beneficiary` `request reinstatement of the disability pension` 300)) EQUALS FULFILLED
