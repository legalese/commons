IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc12-logic`
IMPORT `ccc12-part9-interpretation`

-- Tests of section 321. Expected values are hand-written from the text of s 321 before each run. Arguments are positional, in the GIVEN order of each function.

§ `s 321 break`
-- (a) or (b), either suffices ("(a) ... or (b)"); neither is the text's no ("break means").
#ASSERT `s 321 the person breaks` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 321 the person breaks` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 321 the person breaks` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 321 the person breaks` FALSE FALSE EQUALS JUST FALSE

§ `s 321 credit card`
-- device, issued, purpose (a), purpose (b)
#ASSERT `s 321 the thing is a credit card` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 321 the thing is a credit card` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 321 the thing is a credit card` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 321 the thing is a credit card` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 321 the thing is a credit card` TRUE FALSE TRUE TRUE EQUALS JUST FALSE

§ `s 321 document`
-- paper-or-material, recorded, credit card answer, trademark/inscription
#ASSERT `s 321 the thing is a document` TRUE TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 321 the thing is a document` TRUE TRUE NOTHING FALSE EQUALS JUST TRUE
-- paper with nothing recorded and not a credit card: "document means" is the text's no.
#ASSERT `s 321 the thing is a document` TRUE FALSE (JUST FALSE) FALSE EQUALS JUST FALSE
-- a credit card is a document ("includes a credit card") though it is not paper.
#ASSERT `s 321 the thing is a document` FALSE FALSE (JUST TRUE) FALSE EQUALS JUST TRUE
-- the exclusion: a trademark or inscription is not a document, even if paper with something recorded on it.
#ASSERT `s 321 the thing is a document` TRUE TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 321 the thing is a document` TRUE TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
-- the paper limb fails and the credit card answer was not given: not covered.
#ASSERT `s 321 the thing is a document` FALSE TRUE NOTHING FALSE EQUALS NOTHING

§ `s 321 exchequer bill`
#ASSERT `s 321 the thing is an exchequer bill` `s 321 a bank-note` TRUE EQUALS JUST TRUE
#ASSERT `s 321 the thing is an exchequer bill` `s 321 a bond` TRUE EQUALS JUST TRUE
#ASSERT `s 321 the thing is an exchequer bill` `s 321 a note` TRUE EQUALS JUST TRUE
#ASSERT `s 321 the thing is an exchequer bill` `s 321 a debenture` TRUE EQUALS JUST TRUE
#ASSERT `s 321 the thing is an exchequer bill` `s 321 a security` TRUE EQUALS JUST TRUE
#ASSERT `s 321 the thing is an exchequer bill` `s 321 an instrument of another kind` TRUE EQUALS JUST FALSE
-- a bond not issued or guaranteed by Her Majesty under the authority of Parliament or a legislature
#ASSERT `s 321 the thing is an exchequer bill` `s 321 a bond` FALSE EQUALS JUST FALSE

§ `s 321 exchequer bill paper`
#ASSERT `s 321 the paper is exchequer bill paper` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 321 the paper is exchequer bill paper` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 321 the paper is exchequer bill paper` FALSE TRUE EQUALS JUST FALSE

§ `s 321 false document`
-- document answer, (a) purports, (a)(i) did not make or authorize, (a)(ii) did not exist, (b) made by the purported maker, (b) false in a material particular, (c) in the name of an existing person by him or under his authority, (c) fraudulent intention
#ASSERT `s 321 the document is a false document` (JUST TRUE) TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 321 the document is a false document` (JUST TRUE) TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 321 the document is a false document` (JUST TRUE) TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 321 the document is a false document` (JUST TRUE) FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 321 the document is a false document` (JUST TRUE) FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 321 the document is a false document` (JUST TRUE) FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 321 the document is a false document` (JUST TRUE) FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 321 the document is a false document` (JUST TRUE) FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- not a document at all: "false document means a document"
#ASSERT `s 321 the document is a false document` (JUST FALSE) TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- a limb holds but the document answer is not given: NOTHING; no limb holds: JUST FALSE whatever the document answer
#ASSERT `s 321 the document is a false document` NOTHING TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 321 the document is a false document` NOTHING FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§ `s 321 revenue paper`
-- paper, used to make stamps, licences or permits, used for a purpose connected with the public revenue
#ASSERT `s 321 the paper is revenue paper` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 321 the paper is revenue paper` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 321 the paper is revenue paper` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 321 the paper is revenue paper` FALSE TRUE TRUE EQUALS JUST FALSE
