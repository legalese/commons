IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc23-publication`

-- ccc23-tests-publication.l4 -- tests for sections 672.501 and 672.5011. Expected values are written from the text, never copied from the code.

§ `s 672.501`
-- (1) args: a Review Board hearing for a person declared NCR or unfit; the offence is referred to in 486.4(1) (by that section)
#ASSERT `s 672.501(1) the Review Board must make an order restricting publication of information that could identify a victim or a witness under eighteen` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 672.501(1) the Review Board must make an order restricting publication of information that could identify a victim or a witness under eighteen` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 672.501(1) the Review Board must make an order restricting publication of information that could identify a victim or a witness under eighteen` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 672.501(1) the Review Board must make an order restricting publication of information that could identify a victim or a witness under eighteen` FALSE (JUST TRUE) EQUALS JUST FALSE
-- (2) args: the hearing; the offence as a provision of the Code. Section 163.1 is named by number.
#ASSERT `s 672.501(2) the Review Board must make an order restricting publication of information that could identify a witness under eighteen or a person who is the subject of child sexual abuse and exploitation material` TRUE (`Provision of the Code` OF 163.1, "(2)") EQUALS JUST TRUE
#ASSERT `s 672.501(2) the Review Board must make an order restricting publication of information that could identify a witness under eighteen or a person who is the subject of child sexual abuse and exploitation material` TRUE (`Provision of the Code` OF 163.2, "") EQUALS JUST FALSE
#ASSERT `s 672.501(2) the Review Board must make an order restricting publication of information that could identify a witness under eighteen or a person who is the subject of child sexual abuse and exploitation material` FALSE (`Provision of the Code` OF 163.1, "(2)") EQUALS JUST FALSE
-- (3) args: hearing for another offence; the prosecutor, a victim or a witness applies; satisfied that the order is necessary for the proper administration of justice
#ASSERT `s 672.501(3) the Review Board may make an order restricting publication of information that could identify the victim or witness` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.501(3) the Review Board may make an order restricting publication of information that could identify the victim or witness` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.501(3) the Review Board may make an order restricting publication of information that could identify the victim or witness` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 672.501(3) the Review Board may make an order restricting publication of information that could identify the victim or witness` FALSE TRUE TRUE EQUALS NOTHING
-- (4) args: disclosure in the course of the administration of justice; the purpose is to make the information known in the community
#ASSERT `s 672.501(4) the order applies in respect of the disclosure of information` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.501(4) the order applies in respect of the disclosure of information` TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.501(4) the order applies in respect of the disclosure of information` FALSE FALSE EQUALS NOTHING
-- (5), (6)
#ASSERT `s 672.501(5) the applicant has applied and given notice as the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.501(5) the applicant has applied and given notice as the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.501(5) the applicant has applied and given notice as the subsection requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.501(6) the applicant has set out the grounds` TRUE EQUALS JUST TRUE
#ASSERT `s 672.501(6) the applicant has set out the grounds` FALSE EQUALS JUST FALSE
-- (7), (9)
#ASSERT `s 672.501(7) the Review Board may hold a hearing, in private, to determine whether an order should be made` TRUE EQUALS JUST TRUE
#ASSERT `s 672.501(7) the Review Board may hold a hearing, in private, to determine whether an order should be made` FALSE EQUALS NOTHING
#ASSERT `s 672.501(9) the order may be subject to any conditions that the Review Board thinks fit` TRUE EQUALS JUST TRUE
#ASSERT `s 672.501(9) the order may be subject to any conditions that the Review Board thinks fit` FALSE EQUALS NOTHING
-- (8) args: determining under (3); (a) to (h)
#ASSERT `s 672.501(8) the Review Board must consider the factor` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.501(8) the Review Board must consider the factor` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.501(8) the Review Board must consider the factor` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.501(8) the Review Board must consider the factor` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.501(8) the Review Board must consider the factor` TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.501(8) the Review Board must consider the factor` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.501(8) the Review Board must consider the factor` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.501(8) the Review Board must consider the factor` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.501(8) the Review Board must consider the factor` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.501(8) the Review Board must consider the factor` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (10) args: (a) contents of an application; (b) evidence or submissions at a (7) hearing; (c) other identifying information; the Review Board refuses to make the order
#ASSERT `s 672.501(10) the section bars publication of the application, the hearing or identifying information` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.501(10) the section bars publication of the application, the hearing or identifying information` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.501(10) the section bars publication of the application, the hearing or identifying information` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- "Unless the Review Board refuses to make an order": the text's own exception
#ASSERT `s 672.501(10) the section bars publication of the application, the hearing or identifying information` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.501(10) the section bars publication of the application, the hearing or identifying information` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (11), (12)
#ASSERT `s 672.501(11) the punishment of the person who fails to comply with the order` TRUE EQUALS JUST (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 672.501(11) the punishment of the person who fails to comply with the order` FALSE EQUALS NOTHING
#ASSERT `s 672.501(12) the order also prohibits publication in the proceedings against the person who fails to comply` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.501(12) the order also prohibits publication in the proceedings against the person who fails to comply` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.501(12) the order also prohibits publication in the proceedings against the person who fails to comply` FALSE TRUE EQUALS NOTHING

§ `s 672.5011`
-- (1) args: the person or someone for them applies; the Review Board's opinion that it may affect another protected person's privacy
#ASSERT `s 672.5011(1) the Review Board must vary or revoke the order without holding a hearing` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5011(1) the Review Board must vary or revoke the order without holding a hearing` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.5011(1) the Review Board must vary or revoke the order without holding a hearing` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.5011(2) the prosecutor must make an application to vary or revoke the order` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5011(2) the prosecutor must make an application to vary or revoke the order` FALSE EQUALS JUST FALSE
#ASSERT `s 672.5011(3) the Review Board must hold a hearing to determine whether the order should be varied or revoked` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5011(3) the Review Board must hold a hearing to determine whether the order should be varied or revoked` FALSE EQUALS JUST FALSE
#ASSERT `s 672.5011(4) the Review Board must consider whether it is possible to vary the order in a manner that protects the privacy interests of any other protected person` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5011(4) the Review Board must consider whether it is possible to vary the order in a manner that protects the privacy interests of any other protected person` FALSE EQUALS JUST FALSE
-- (5), (6): the text says no to notice to the accused and to the accused's submissions
#ASSERT `s 672.5011(5) the applicant is required to provide notice of the application to the accused` TRUE EQUALS JUST FALSE
#ASSERT `s 672.5011(5) the applicant is required to provide notice of the application to the accused` FALSE EQUALS NOTHING
#ASSERT `s 672.5011(6) the accused is permitted to make submissions in relation to the application` TRUE EQUALS JUST FALSE
#ASSERT `s 672.5011(6) the accused is permitted to make submissions in relation to the application` FALSE EQUALS NOTHING
#ASSERT `s 672.5011(7) the prosecutor must notify the accused` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5011(7) the prosecutor must notify the accused` FALSE EQUALS JUST FALSE
