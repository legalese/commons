IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc20-part16-interpretation`
IMPORT `ccc20-part16-prisoners-and-entry`
IMPORT `ccc20-tests-fixtures`

-- ccc20-tests-prisoners-and-entry.l4 -- tests for ccc20-part16-prisoners-and-entry.l4 (ss 527 to 529.5). Expected values are hand-written from the text of lines 11762-11827.

§ `Tests -- section 527: procuring the attendance of a prisoner`
-- (1) args: the person is a judge of a superior court of criminal jurisdiction; s 2 prison; (a) affidavit and warrant produced; (b) the judge is satisfied that the ends of justice require an order
#ASSERT `s 527(1) the judge may order in writing that a person who is confined in a prison be brought before the court, judge, justice or provincial court judge` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 527(1) the judge may order in writing that a person who is confined in a prison be brought before the court, judge, justice or provincial court judge` TRUE (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 527(1) the judge may order in writing that a person who is confined in a prison be brought before the court, judge, justice or provincial court judge` TRUE (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 527(1) the judge may order in writing that a person who is confined in a prison be brought before the court, judge, justice or provincial court judge` FALSE (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 527(1) the judge may order in writing that a person who is confined in a prison be brought before the court, judge, justice or provincial court judge` TRUE (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 527(1) the judge may order in writing that a person who is confined in a prison be brought before the court, judge, justice or provincial court judge` TRUE NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 527(1) the judge may order in writing that a person who is confined in a prison be brought before the court, judge, justice or provincial court judge` TRUE NOTHING FALSE FALSE EQUALS NOTHING
-- (2) arg: the person whose attendance is required is within the province in which the provincial court judge has jurisdiction
#ASSERT `s 527(2) a provincial court judge has the same powers for the purposes of subsection (1) or (7) as a judge has under that subsection` TRUE EQUALS JUST TRUE
#ASSERT `s 527(2) a provincial court judge has the same powers for the purposes of subsection (1) or (7) as a judge has under that subsection` FALSE EQUALS JUST FALSE
-- (3) the order is addressed to the person who has custody; the duty on receipt: (a) args: received; the order names a person to receive; (b) args: received; the reasonable charges have been paid
#ASSERT `s 527(3) the order must be addressed to the person who has custody of the prisoner` TRUE EQUALS JUST TRUE
#ASSERT `s 527(3) the order must be addressed to the person who has custody of the prisoner` FALSE EQUALS JUST FALSE
#ASSERT `s 527(3)(a) the person who has custody of the prisoner must deliver the prisoner to the person named in the order to receive the prisoner, or do what paragraph (b) requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 527(3)(a) the person who has custody of the prisoner must deliver the prisoner to the person named in the order to receive the prisoner, or do what paragraph (b) requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 527(3)(a) the person who has custody of the prisoner must deliver the prisoner to the person named in the order to receive the prisoner, or do what paragraph (b) requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 527(3)(a) the person who has custody of the prisoner must deliver the prisoner to the person named in the order to receive the prisoner, or do what paragraph (b) requires` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 527(3)(b) the person who has custody of the prisoner must bring the prisoner before the court, judge, justice or provincial court judge, or do what paragraph (a) requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 527(3)(b) the person who has custody of the prisoner must bring the prisoner before the court, judge, justice or provincial court judge, or do what paragraph (a) requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 527(3)(b) the person who has custody of the prisoner must bring the prisoner before the court, judge, justice or provincial court judge, or do what paragraph (a) requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 527(3)(b) the person who has custody of the prisoner must bring the prisoner before the court, judge, justice or provincial court judge, or do what paragraph (a) requires` FALSE FALSE EQUALS JUST FALSE
-- (4) arg: the prisoner is required as a witness
#ASSERT `s 527(4) the judge or provincial court judge must direct in the order the manner in which the prisoner is to be kept in custody and returned to the prison` TRUE EQUALS JUST TRUE
#ASSERT `s 527(4) the judge or provincial court judge must direct in the order the manner in which the prisoner is to be kept in custody and returned to the prison` FALSE EQUALS JUST FALSE
-- (5) arg: the appearance of the prisoner is required for the purposes of (1); then the direction for each decision on the charge
#ASSERT `s 527(5) the judge or provincial court judge must give appropriate directions in the order with respect to the manner in which the prisoner is to be kept in custody or returned` TRUE EQUALS JUST TRUE
#ASSERT `s 527(5) the judge or provincial court judge must give appropriate directions in the order with respect to the manner in which the prisoner is to be kept in custody or returned` FALSE EQUALS JUST FALSE
#ASSERT `s 527(5) the direction for the decision on the charge` `an order to stand trial` EQUALS `s 527(5)(a) the prisoner is to be kept in custody`
#ASSERT `s 527(5) the direction for the decision on the charge` `a discharge at the preliminary inquiry` EQUALS `s 527(5)(b) the prisoner is to be returned`
#ASSERT `s 527(5) the direction for the decision on the charge` `an acquittal` EQUALS `s 527(5)(b) the prisoner is to be returned`
#ASSERT `s 527(5) the direction for the decision on the charge` `a finding of guilt` EQUALS `s 527(5) the paragraphs give no direction for the decision`
#ASSERT `s 527(5) the direction for the decision on the charge` `a verdict of not criminally responsible on account of mental disorder` EQUALS `s 527(5) the paragraphs give no direction for the decision`
#ASSERT `s 527(5) the direction for the decision on the charge` `a verdict of unfit to stand trial` EQUALS `s 527(5) the paragraphs give no direction for the decision`
#ASSERT `s 527(5) the direction for the decision on the charge` `a stay of proceedings` EQUALS `s 527(5) the paragraphs give no direction for the decision`
#ASSERT `s 527(5) the direction for the decision on the charge` `a withdrawal of the charge` EQUALS `s 527(5) the paragraphs give no direction for the decision`
-- (6) args: the section (R1); the prisoner is convicted and sentenced to imprisonment
#ASSERT `s 527(6) the section applies where the prisoner is convicted and sentenced to imprisonment` (`Provision of the Code` OF 718.3, "") TRUE EQUALS JUST TRUE
#ASSERT `s 527(6) the section applies where the prisoner is convicted and sentenced to imprisonment` (`Provision of the Code` OF 743.1, "") TRUE EQUALS JUST TRUE
#ASSERT `s 527(6) the section applies where the prisoner is convicted and sentenced to imprisonment` (`Provision of the Code` OF 718.3, "") FALSE EQUALS JUST FALSE
#ASSERT `s 527(6) the section applies where the prisoner is convicted and sentenced to imprisonment` (`Provision of the Code` OF 743.1, "") FALSE EQUALS JUST FALSE
#ASSERT `s 527(6) the section applies where the prisoner is convicted and sentenced to imprisonment` (`Provision of the Code` OF 718, "") TRUE EQUALS NOTHING
#ASSERT `s 527(6) the section applies where the prisoner is convicted and sentenced to imprisonment` (`Provision of the Code` OF 743, "") TRUE EQUALS NOTHING
#ASSERT `s 527(6) the section applies where the prisoner is convicted and sentenced to imprisonment` (`Provision of the Code` OF 719, "") FALSE EQUALS NOTHING
-- (7) args: the person is a judge of a superior court; the prosecutor has applied; the prisoner consents in writing; the judge is satisfied that the transfer is required. A missing consent answers NOTHING whatever the other gates say
#ASSERT `s 527(7) the judge may order the transfer of the prisoner or other person to the custody of a peace officer named in the order for a period specified in the order` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 527(7) the judge may order the transfer of the prisoner or other person to the custody of a peace officer named in the order for a period specified in the order` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 527(7) the judge may order the transfer of the prisoner or other person to the custody of a peace officer named in the order for a period specified in the order` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 527(7) the judge may order the transfer of the prisoner or other person to the custody of a peace officer named in the order for a period specified in the order` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 527(7) the judge may order the transfer of the prisoner or other person to the custody of a peace officer named in the order for a period specified in the order` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 527(7) the judge may order the transfer of the prisoner or other person to the custody of a peace officer named in the order for a period specified in the order` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 527(7) the judge may order the transfer of the prisoner or other person to the custody of a peace officer named in the order for a period specified in the order` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 527(7) the judge may order the transfer of the prisoner or other person to the custody of a peace officer named in the order for a period specified in the order` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (8) arg: the order is made under (7); the person who has custody has received it
#ASSERT `s 527(8) the order must be addressed to the person who has custody of the prisoner` TRUE EQUALS JUST TRUE
#ASSERT `s 527(8) the order must be addressed to the person who has custody of the prisoner` FALSE EQUALS JUST FALSE
#ASSERT `s 527(8) the person who has custody of the prisoner must deliver the prisoner to the peace officer who is named in the order to receive the prisoner` TRUE EQUALS JUST TRUE
#ASSERT `s 527(8) the person who has custody of the prisoner must deliver the prisoner to the peace officer who is named in the order to receive the prisoner` FALSE EQUALS JUST FALSE
-- (9) arg: the purposes of the order have been carried out
#ASSERT `s 527(9) the prisoner must be returned to the place where the prisoner was confined at the time the order was made` TRUE EQUALS JUST TRUE
#ASSERT `s 527(9) the prisoner must be returned to the place where the prisoner was confined at the time the order was made` FALSE EQUALS JUST FALSE

§ `Tests -- section 528: endorsement of a warrant`
-- (1) args: a warrant for arrest or committal in a Part XXVIII form; it cannot be executed under s 514 or 703; the justice has jurisdiction where the accused is or is believed to be; an application is made; proof of the signature of the issuing justice
#ASSERT `s 528(1) the justice must authorize the arrest of the accused within the justice's jurisdiction by making an endorsement on the warrant` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 528(1) the justice must authorize the arrest of the accused within the justice's jurisdiction by making an endorsement on the warrant` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 528(1) the justice must authorize the arrest of the accused within the justice's jurisdiction by making an endorsement on the warrant` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 528(1) the justice must authorize the arrest of the accused within the justice's jurisdiction by making an endorsement on the warrant` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 528(1) the justice must authorize the arrest of the accused within the justice's jurisdiction by making an endorsement on the warrant` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 528(1) the justice must authorize the arrest of the accused within the justice's jurisdiction by making an endorsement on the warrant` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- (1) Form 28 (the text permits it and says nothing of another form)
#ASSERT `s 528(1) the endorsement may be in Form 28` TRUE EQUALS JUST TRUE
#ASSERT `s 528(1) the endorsement may be in Form 28` FALSE EQUALS NOTHING
-- (1.1) arg: the copy is of an affidavit or warrant submitted by a means of telecommunication that produces a writing
#ASSERT `s 528(1.1) the copy has the same probative force as the original for the purposes of subsection (1)` TRUE EQUALS JUST TRUE
#ASSERT `s 528(1.1) the copy has the same probative force as the original for the purposes of subsection (1)` FALSE EQUALS NOTHING
-- (2) args: the endorsement is made on a warrant pursuant to (1); the peace officer is one to whom the warrant was originally directed or one within the jurisdiction of the endorsing justice
#ASSERT `s 528(2) the endorsement is sufficient authority to the peace officer to execute the warrant and to take the accused before a justice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 528(2) the endorsement is sufficient authority to the peace officer to execute the warrant and to take the accused before a justice` TRUE FALSE EQUALS NOTHING
#ASSERT `s 528(2) the endorsement is sufficient authority to the peace officer to execute the warrant and to take the accused before a justice` FALSE TRUE EQUALS NOTHING
#ASSERT `s 528(2) the endorsement is sufficient authority to the peace officer to execute the warrant and to take the accused before a justice` FALSE FALSE EQUALS NOTHING
#ASSERT `s 528(2) the justice is one before whom the accused may be taken under the endorsement` TRUE EQUALS JUST TRUE
#ASSERT `s 528(2) the justice is one before whom the accused may be taken under the endorsement` FALSE EQUALS NOTHING

§ `Tests -- sections 529 to 529.5: entering a dwelling-house to arrest`
-- 529(1) args: the warrant is a warrant to arrest or apprehend issued by a judge or justice; s 2 dwelling-house; the judge or justice is satisfied by information on oath in writing
#ASSERT `s 529(1) the warrant may authorize a peace officer to enter a dwelling-house described in the warrant for the purpose of arresting or apprehending the person` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 529(1) the warrant may authorize a peace officer to enter a dwelling-house described in the warrant for the purpose of arresting or apprehending the person` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 529(1) the warrant may authorize a peace officer to enter a dwelling-house described in the warrant for the purpose of arresting or apprehending the person` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 529(1) the warrant may authorize a peace officer to enter a dwelling-house described in the warrant for the purpose of arresting or apprehending the person` TRUE TRUE FALSE EQUALS NOTHING
-- 529(2) args: an authorization has been granted under (1); the peace officer has reasonable grounds to believe, immediately before entering, that the person is present
#ASSERT `s 529(2) the peace officer is barred from entering the dwelling-house` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 529(2) the peace officer is barred from entering the dwelling-house` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 529(2) the peace officer is barred from entering the dwelling-house` FALSE TRUE EQUALS NOTHING
#ASSERT `s 529(2) the peace officer is barred from entering the dwelling-house` FALSE FALSE EQUALS NOTHING
-- 529.1 args: the judge or justice is satisfied by information on oath; (a) a warrant is in force anywhere in Canada; (b) grounds to arrest without warrant under 495(1)(a) or (b) or 672.91; (c) grounds to arrest or apprehend without warrant under another Act
#ASSERT `s 529.1 the judge or justice may issue a warrant in Form 7.1 authorizing a peace officer to enter a dwelling-house described in the warrant` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 529.1 the judge or justice may issue a warrant in Form 7.1 authorizing a peace officer to enter a dwelling-house described in the warrant` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 529.1 the judge or justice may issue a warrant in Form 7.1 authorizing a peace officer to enter a dwelling-house described in the warrant` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 529.1 the judge or justice may issue a warrant in Form 7.1 authorizing a peace officer to enter a dwelling-house described in the warrant` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 529.1 the judge or justice may issue a warrant in Form 7.1 authorizing a peace officer to enter a dwelling-house described in the warrant` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 529.1 the judge or justice may issue a warrant in Form 7.1 authorizing a peace officer to enter a dwelling-house described in the warrant` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- 529.2 args: the warrant is one referred to in 529 or 529.1; the term is one the judge or justice considers advisable
#ASSERT `s 529.2 the judge or justice must include the term or condition in the warrant` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 529.2 the judge or justice must include the term or condition in the warrant` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 529.2 the judge or justice must include the term or condition in the warrant` FALSE TRUE EQUALS JUST FALSE
-- 529.3(1) args: reasonable grounds to believe the person is present; the conditions for a warrant under 529.1 exist; exigent circumstances make it impracticable to obtain a warrant
#ASSERT `s 529.3(1) the peace officer may enter the dwelling-house for the purpose of arresting or apprehending a person without a warrant` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 529.3(1) the peace officer may enter the dwelling-house for the purpose of arresting or apprehending a person without a warrant` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 529.3(1) the peace officer may enter the dwelling-house for the purpose of arresting or apprehending a person without a warrant` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 529.3(1) the peace officer may enter the dwelling-house for the purpose of arresting or apprehending a person without a warrant` TRUE TRUE FALSE EQUALS NOTHING
-- 529.3(2) args: (a) reasonable grounds to suspect entry is necessary to prevent imminent bodily harm or death; (b) reasonable grounds to believe evidence is present and entry is necessary to prevent its imminent loss; the offence the evidence relates to (an indictable offence: s 493.01)
#ASSERT `s 529.3(2) the circumstances are exigent circumstances` TRUE FALSE `s 493.01 fixture summary` EQUALS JUST TRUE
#ASSERT `s 529.3(2) the circumstances are exigent circumstances` FALSE TRUE `s 493.01 fixture indictable` EQUALS JUST TRUE
#ASSERT `s 529.3(2) the circumstances are exigent circumstances` FALSE TRUE `s 493.01 fixture hybrid` EQUALS JUST TRUE
#ASSERT `s 529.3(2) the circumstances are exigent circumstances` FALSE TRUE `s 493.01 fixture hybrid elected` EQUALS NOTHING
#ASSERT `s 529.3(2) the circumstances are exigent circumstances` FALSE TRUE `s 493.01 fixture summary` EQUALS NOTHING
#ASSERT `s 529.3(2) the circumstances are exigent circumstances` FALSE FALSE `s 493.01 fixture indictable` EQUALS NOTHING
-- 529.4(1) args: (a) the judge or justice is satisfied that prior announcement would expose a person to imminent bodily harm or death; (b) ... would result in the imminent loss or destruction of evidence; the offence
#ASSERT `s 529.4(1) the judge or justice may authorize the peace officer to enter the dwelling-house without prior announcement` TRUE FALSE `s 493.01 fixture summary` EQUALS JUST TRUE
#ASSERT `s 529.4(1) the judge or justice may authorize the peace officer to enter the dwelling-house without prior announcement` FALSE TRUE `s 493.01 fixture indictable` EQUALS JUST TRUE
#ASSERT `s 529.4(1) the judge or justice may authorize the peace officer to enter the dwelling-house without prior announcement` FALSE TRUE `s 493.01 fixture hybrid elected` EQUALS NOTHING
#ASSERT `s 529.4(1) the judge or justice may authorize the peace officer to enter the dwelling-house without prior announcement` FALSE TRUE `s 493.01 fixture summary` EQUALS NOTHING
#ASSERT `s 529.4(1) the judge or justice may authorize the peace officer to enter the dwelling-house without prior announcement` FALSE FALSE `s 493.01 fixture indictable` EQUALS NOTHING
-- 529.4(2) args: an authorization under this section; (a) reasonable grounds to suspect imminent bodily harm or death; (b) reasonable grounds to believe imminent loss or destruction of evidence; the offence
#ASSERT `s 529.4(2) the peace officer is barred from entering the dwelling-house without prior announcement despite being authorized to do so` FALSE TRUE FALSE `s 493.01 fixture indictable` EQUALS NOTHING
#ASSERT `s 529.4(2) the peace officer is barred from entering the dwelling-house without prior announcement despite being authorized to do so` TRUE TRUE FALSE `s 493.01 fixture indictable` EQUALS JUST FALSE
#ASSERT `s 529.4(2) the peace officer is barred from entering the dwelling-house without prior announcement despite being authorized to do so` TRUE FALSE TRUE `s 493.01 fixture indictable` EQUALS JUST FALSE
#ASSERT `s 529.4(2) the peace officer is barred from entering the dwelling-house without prior announcement despite being authorized to do so` TRUE FALSE TRUE `s 493.01 fixture hybrid` EQUALS JUST FALSE
#ASSERT `s 529.4(2) the peace officer is barred from entering the dwelling-house without prior announcement despite being authorized to do so` TRUE FALSE TRUE `s 493.01 fixture hybrid elected` EQUALS JUST TRUE
#ASSERT `s 529.4(2) the peace officer is barred from entering the dwelling-house without prior announcement despite being authorized to do so` TRUE FALSE TRUE `s 493.01 fixture summary` EQUALS JUST TRUE
#ASSERT `s 529.4(2) the peace officer is barred from entering the dwelling-house without prior announcement despite being authorized to do so` TRUE FALSE FALSE `s 493.01 fixture indictable` EQUALS JUST TRUE
-- 529.4(3) args: the peace officer enters without a warrant under 529.3; (a); (b); the offence
#ASSERT `s 529.4(3) the peace officer is barred from entering the dwelling-house without prior announcement` FALSE TRUE FALSE `s 493.01 fixture indictable` EQUALS NOTHING
#ASSERT `s 529.4(3) the peace officer is barred from entering the dwelling-house without prior announcement` TRUE TRUE FALSE `s 493.01 fixture indictable` EQUALS JUST FALSE
#ASSERT `s 529.4(3) the peace officer is barred from entering the dwelling-house without prior announcement` TRUE FALSE TRUE `s 493.01 fixture indictable` EQUALS JUST FALSE
#ASSERT `s 529.4(3) the peace officer is barred from entering the dwelling-house without prior announcement` TRUE FALSE TRUE `s 493.01 fixture hybrid elected` EQUALS JUST TRUE
#ASSERT `s 529.4(3) the peace officer is barred from entering the dwelling-house without prior announcement` TRUE FALSE FALSE `s 493.01 fixture indictable` EQUALS JUST TRUE
#ASSERT `s 529.4(3) the peace officer is barred from entering the dwelling-house without prior announcement` TRUE FALSE TRUE `s 493.01 fixture summary` EQUALS JUST TRUE
-- 529.5 arg: the application is for a warrant under 529.1 or an authorization under 529 or 529.4
#ASSERT `s 529.5 the application may be submitted, and the warrant or authorization may be issued, by a means of telecommunication` TRUE EQUALS JUST TRUE
#ASSERT `s 529.5 the application may be submitted, and the warrant or authorization may be issued, by a means of telecommunication` FALSE EQUALS NOTHING
#ASSERT `s 529.5 section 487.1 applies for those purposes with any necessary modifications` TRUE EQUALS JUST TRUE
#ASSERT `s 529.5 section 487.1 applies for those purposes with any necessary modifications` FALSE EQUALS NOTHING
