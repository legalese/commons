#ASSERT `s 816(1.1) the person having the custody of the appellant is required to release the appellant immediately` FALSE EQUALS JUST FALSE
#ASSERT `s 816(2) sections 495.1, 512.3 and 524 apply to the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 816(2) sections 495.1, 512.3 and 524 apply to the proceedings` FALSE EQUALS NOTHING
-- 817(1): (the prosecutor by whom an appeal is taken, filed the notice and proof of service, the 817(3) answer).
#ASSERT `s 817(1) the prosecutor is required to appear before a justice` TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 817(1) the prosecutor is required to appear before a justice` TRUE FALSE NOTHING EQUALS JUST FALSE
