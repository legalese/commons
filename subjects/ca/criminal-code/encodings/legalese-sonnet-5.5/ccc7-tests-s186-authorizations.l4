#ASSERT `s 186(4) the authorization has the content the subsection requires` TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 186(4) the authorization has the content the subsection requires` TRUE TRUE TRUE TRUE NOTHING EQUALS NOTHING
-- (5) and (5.1)
#ASSERT `s 186(5) the person may intercept private communications under authorizations` TRUE EQUALS JUST TRUE
#ASSERT `s 186(5) the person may intercept private communications under authorizations` FALSE EQUALS NOTHING
#ASSERT `s 186(5.1) the authorization includes the authority to do the act on the device` TRUE `s 186(5.1) installing the device covertly` EQUALS JUST TRUE
#ASSERT `s 186(5.1) the authorization includes the authority to do the act on the device` TRUE `s 186(5.1) maintaining the device covertly` EQUALS JUST TRUE
#ASSERT `s 186(5.1) the authorization includes the authority to do the act on the device` TRUE `s 186(5.1) removing the device covertly` EQUALS JUST TRUE
#ASSERT `s 186(5.1) the authorization includes the authority to do the act on the device` TRUE `s 186(5.1) an act on the device that is none of those` EQUALS NOTHING
#ASSERT `s 186(5.1) the authorization includes the authority to do the act on the device` FALSE `s 186(5.1) installing the device covertly` EQUALS NOTHING
-- (5.2) args: ex parte, in writing, supported by affidavit; the judge; for covert removal after expiry; the day the specified period begins; the day it ends
#ASSERT `s 186(5.2) a further authorization for the covert removal of the device may be given` TRUE TRUE TRUE (Date 1 3 2025) (Date 29 4 2025) EQUALS JUST TRUE
-- "not more than sixty days": 61 days is outside the grant
#ASSERT `s 186(5.2) a further authorization for the covert removal of the device may be given` TRUE TRUE TRUE (Date 1 3 2025) (Date 30 4 2025) EQUALS NOTHING
#ASSERT `s 186(5.2) a further authorization for the covert removal of the device may be given` FALSE TRUE TRUE (Date 1 3 2025) (Date 29 4 2025) EQUALS NOTHING
#ASSERT `s 186(5.2) a further authorization for the covert removal of the device may be given` TRUE FALSE TRUE (Date 1 3 2025) (Date 29 4 2025) EQUALS NOTHING
#ASSERT `s 186(5.2) a further authorization for the covert removal of the device may be given` TRUE TRUE FALSE (Date 1 3 2025) (Date 29 4 2025) EQUALS NOTHING
-- (6)
#ASSERT `s 186(6) a renewal of an authorization may be given on the application` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 186(6) a renewal of an authorization may be given on the application` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 186(6) a renewal of an authorization may be given on the application` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 186(6) a renewal of an authorization may be given on the application` TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 186(6) a renewal of an authorization may be given on the application` TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 186(6) a renewal of an authorization may be given on the application` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING
-- (7)
#ASSERT `s 186(7) a renewal of an authorization may be given` TRUE EQUALS JUST TRUE
#ASSERT `s 186(7) a renewal of an authorization may be given` FALSE EQUALS NOTHING
#ASSERT `s 186(7) the renewal is for a period within the limit` (Date 1 3 2025) (Date 29 4 2025) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 186(7) the renewal is for a period within the limit` (Date 1 3 2025) (Date 30 4 2025) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 186(7) the renewal is for a period within the limit` (Date 1 3 2025) (Date 30 4 2025) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 186(7) the renewal is for a period within the limit` (Date 1 3 2025) (Date 30 4 2025) NOTHING EQUALS NOTHING
-- (8) args: the warrant or order, at the same time, the judge's opinion
#ASSERT `s 186(8) the judge may at the same time issue the related warrant or make the related order` (`Provision of the Code` OF 487.017 , "") TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 186(8) the judge may at the same time issue the related warrant or make the related order` (`Provision of the Code` OF 492.1 , "") TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 186(8) the judge may at the same time issue the related warrant or make the related order` (`Provision of the Code` OF 492.3 , "") TRUE TRUE EQUALS NOTHING
#ASSERT `s 186(8) the judge may at the same time issue the related warrant or make the related order` (`Provision of the Code` OF 487 , "") TRUE FALSE EQUALS NOTHING

§ `Tests -- section 188`

-- (1) args: ex parte to a designated judge, who designated, federal prosecution, the peace officer is specially designated in writing, urgency
#ASSERT `s 188(1) an application for an authorization may be made to a specially appointed judge` TRUE `s 188(1) the Minister of Public Safety and Emergency Preparedness` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 188(1) an application for an authorization may be made to a specially appointed judge` TRUE `s 188(1) the Attorney General of a province` FALSE TRUE TRUE EQUALS JUST TRUE
-- the Minister designates only for an offence the Government of Canada may prosecute; a province's Attorney General for "any other offence"
#ASSERT `s 188(1) an application for an authorization may be made to a specially appointed judge` TRUE `s 188(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 188(1) an application for an authorization may be made to a specially appointed judge` TRUE `s 188(1) the Attorney General of a province` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 188(1) an application for an authorization may be made to a specially appointed judge` TRUE `s 188(1) someone else` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 188(1) an application for an authorization may be made to a specially appointed judge` FALSE `s 188(1) the Minister of Public Safety and Emergency Preparedness` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 188(1) an application for an authorization may be made to a specially appointed judge` TRUE `s 188(1) the Minister of Public Safety and Emergency Preparedness` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 188(1) an application for an authorization may be made to a specially appointed judge` TRUE `s 188(1) the Minister of Public Safety and Emergency Preparedness` TRUE TRUE FALSE EQUALS NOTHING
-- (2) args: satisfied of urgency, in writing, period in hours: "up to thirty-six hours"
#ASSERT `s 188(2) the judge may give an authorization for a period of up to thirty-six hours` TRUE TRUE 36 EQUALS JUST TRUE
#ASSERT `s 188(2) the judge may give an authorization for a period of up to thirty-six hours` TRUE TRUE 37 EQUALS NOTHING
#ASSERT `s 188(2) the judge may give an authorization for a period of up to thirty-six hours` TRUE TRUE 1 EQUALS JUST TRUE
#ASSERT `s 188(2) the judge may give an authorization for a period of up to thirty-six hours` TRUE FALSE 24 EQUALS NOTHING
-- "Where" fails: JUST FALSE under the guide's ruling (b) (F11)
#ASSERT `s 188(2) the judge may give an authorization for a period of up to thirty-six hours` FALSE TRUE 24 EQUALS JUST FALSE
-- (4) the Chief Justice, for each province and territory
#ASSERT `s 188(4) Chief Justice` Ontario EQUALS `s 188(4) the Chief Justice of the Ontario Court`
#ASSERT `s 188(4) Chief Justice` Quebec EQUALS `s 188(4) the Chief Justice of the Superior Court`
#ASSERT `s 188(4) Chief Justice` `Nova Scotia` EQUALS `s 188(4) the Chief Justice of the Supreme Court`
#ASSERT `s 188(4) Chief Justice` `British Columbia` EQUALS `s 188(4) the Chief Justice of the Supreme Court`
#ASSERT `s 188(4) Chief Justice` `Prince Edward Island` EQUALS `s 188(4) the Chief Justice of the Supreme Court`
#ASSERT `s 188(4) Chief Justice` `Newfoundland and Labrador` EQUALS `s 188(4) the Chief Justice of the Supreme Court`
#ASSERT `s 188(4) Chief Justice` Yukon EQUALS `s 188(4) the Chief Justice of the Supreme Court`
#ASSERT `s 188(4) Chief Justice` `Northwest Territories` EQUALS `s 188(4) the Chief Justice of the Supreme Court`
#ASSERT `s 188(4) Chief Justice` `New Brunswick` EQUALS `s 188(4) the Chief Justice of the Court of Queen’s Bench`
#ASSERT `s 188(4) Chief Justice` Manitoba EQUALS `s 188(4) the Chief Justice of the Court of Queen’s Bench`
#ASSERT `s 188(4) Chief Justice` Saskatchewan EQUALS `s 188(4) the Chief Justice of the Court of Queen’s Bench`
#ASSERT `s 188(4) Chief Justice` Alberta EQUALS `s 188(4) the Chief Justice of the Court of Queen’s Bench`
#ASSERT `s 188(4) Chief Justice` Nunavut EQUALS `s 188(4) the Chief Justice of the Nunavut Court of Justice`
-- (5) args: obtained pursuant to a subsequent authorization under s 188, same facts, same person(s), same offence
#ASSERT `s 188(5) the trial judge may deem the evidence inadmissible` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 188(5) the trial judge may deem the evidence inadmissible` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 188(5) the trial judge may deem the evidence inadmissible` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- fork F12: same persons and same offence but not the same facts
#ASSERT `s 188(5) the trial judge may deem the evidence inadmissible` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 188(5) the trial judge may deem the evidence inadmissible` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 188(5) the trial judge may deem the evidence inadmissible` FALSE TRUE TRUE TRUE EQUALS NOTHING
