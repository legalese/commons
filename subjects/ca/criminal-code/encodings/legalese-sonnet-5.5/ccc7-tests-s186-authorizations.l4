§ `Tests -- sections 188.1 and 188.2`

#ASSERT `s 188.1 the authorization may be executed at the place` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 188.1 the authorization may be executed at the place` TRUE FALSE EQUALS NOTHING
#ASSERT `s 188.1 the authorization may be executed at the place` FALSE TRUE EQUALS NOTHING
#ASSERT `s 188.1 the peace officer who executes the authorization has the authority the section requires` TRUE EQUALS JUST TRUE
#ASSERT `s 188.1 the peace officer who executes the authorization has the authority the section requires` FALSE EQUALS JUST FALSE
-- 188.2 args: the instrument is an authorization (s 183), acts in accordance with it, acts under 184.1 or 184.4, aids in good faith a person believed on reasonable grounds to be so acting, reasonably done
#ASSERT `s 188.2 the person incurs no criminal or civil liability` (JUST TRUE) TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 188.2 the person incurs no criminal or civil liability` (JUST FALSE) FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 188.2 the person incurs no criminal or civil liability` (JUST FALSE) FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- not "reasonably done": outside the immunity, which does not say they incur liability
#ASSERT `s 188.2 the person incurs no criminal or civil liability` (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 188.2 the person incurs no criminal or civil liability` (JUST FALSE) TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 188.2 the person incurs no criminal or civil liability` NOTHING TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 188.2 the person incurs no criminal or civil liability` (JUST FALSE) FALSE FALSE FALSE TRUE EQUALS NOTHING

