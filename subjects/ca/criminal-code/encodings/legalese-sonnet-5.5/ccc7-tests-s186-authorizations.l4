#ASSERT `s 186(4) the authorization has the content the subsection requires` FALSE TRUE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 186(4) the authorization has the content the subsection requires` TRUE FALSE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 186(4) the authorization has the content the subsection requires` TRUE TRUE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
