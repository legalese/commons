#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: a prohibited device other than a replica firearm` FALSE EQUALS JUST (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS (`imprisonment for a term of` (`Length of time` OF 3, 0, 0, FALSE)), `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- a first offence, the object is a prohibited device other than a replica firearm: minimum three years
#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: a prohibited device other than a replica firearm` TRUE EQUALS JUST (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS (`imprisonment for a term of` `five years`), `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- a second or subsequent offence, the object is a prohibited device other than a replica firearm: minimum five years
#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: a firearm part` FALSE EQUALS JUST (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS (`imprisonment for a term of` (`Length of time` OF 3, 0, 0, FALSE)), `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- a first offence, the object is a firearm part: minimum three years
#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: a firearm part` TRUE EQUALS JUST (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS (`imprisonment for a term of` `five years`), `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- a second or subsequent offence, the object is a firearm part: minimum five years
#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: ammunition other than prohibited ammunition` FALSE EQUALS JUST (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS (`imprisonment for a term of` (`Length of time` OF 3, 0, 0, FALSE)), `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- a first offence, the object is a ammunition other than prohibited ammunition: minimum three years
#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: ammunition other than prohibited ammunition` TRUE EQUALS JUST (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS (`imprisonment for a term of` `five years`), `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- a second or subsequent offence, the object is a ammunition other than prohibited ammunition: minimum five years
#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: prohibited ammunition` FALSE EQUALS JUST (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS (`imprisonment for a term of` (`Length of time` OF 3, 0, 0, FALSE)), `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- a first offence, the object is a prohibited ammunition: minimum three years
#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: prohibited ammunition` TRUE EQUALS JUST (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS (`imprisonment for a term of` `five years`), `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- a second or subsequent offence, the object is a prohibited ammunition: minimum five years
#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: a prohibited weapon` FALSE EQUALS NOTHING   -- the object is a prohibited weapon: subsection (3) governs
#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: a restricted weapon` FALSE EQUALS NOTHING   -- the object is a restricted weapon: subsection (3) governs
#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: a cross-bow` FALSE EQUALS NOTHING   -- the object is a cross-bow: subsection (3) governs
#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: an explosive substance` FALSE EQUALS NOTHING   -- the object is a explosive substance: subsection (3) governs
#ASSERT `s 100(2) the punishment when the object in question is a firearm, device, part or ammunition` `s 84(1) kind: a thing that is none of those` FALSE EQUALS NOTHING   -- the object is a thing that is none of the classes: subsection (3) governs

-- `s 100(3) the class of the offence`
#ASSERT `s 100(3) the class of the offence` EQUALS `an indictable offence`  -- indictable only

-- `s 100(3) the punishment in any other case`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing the object in question is (`s 84(1) kind of thing`)
#ASSERT `s 100(3) the punishment in any other case` `s 84(1) kind: a prohibited weapon` EQUALS JUST (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the object is a prohibited weapon: any other case, not more than 14 years
#ASSERT `s 100(3) the punishment in any other case` `s 84(1) kind: a restricted weapon` EQUALS JUST (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the object is a restricted weapon: any other case, not more than 14 years
#ASSERT `s 100(3) the punishment in any other case` `s 84(1) kind: a thing that is none of those` EQUALS JUST (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the object is a thing that is none of the classes: any other case, not more than 14 years
#ASSERT `s 100(3) the punishment in any other case` `s 84(1) kind: a prohibited firearm` EQUALS NOTHING   -- the object is a prohibited firearm: subsection (2) governs
#ASSERT `s 100(3) the punishment in any other case` `s 84(1) kind: a restricted firearm` EQUALS NOTHING   -- the object is a restricted firearm: subsection (2) governs
#ASSERT `s 100(3) the punishment in any other case` `s 84(1) kind: a non-restricted firearm` EQUALS NOTHING   -- the object is a non-restricted firearm: subsection (2) governs
#ASSERT `s 100(3) the punishment in any other case` `s 84(1) kind: a replica firearm` EQUALS NOTHING   -- the object is a replica firearm: subsection (2) governs
#ASSERT `s 100(3) the punishment in any other case` `s 84(1) kind: a prohibited device other than a replica firearm` EQUALS NOTHING   -- the object is a prohibited device other than a replica firearm: subsection (2) governs
#ASSERT `s 100(3) the punishment in any other case` `s 84(1) kind: a firearm part` EQUALS NOTHING   -- the object is a firearm part: subsection (2) governs
#ASSERT `s 100(3) the punishment in any other case` `s 84(1) kind: ammunition other than prohibited ammunition` EQUALS NOTHING   -- the object is a ammunition other than prohibited ammunition: subsection (2) governs
#ASSERT `s 100(3) the punishment in any other case` `s 84(1) kind: prohibited ammunition` EQUALS NOTHING   -- the object is a prohibited ammunition: subsection (2) governs

§§ `Section 101`

-- `s 101(1) the person commits an offence of transfer without authority`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing (`s 84(1) kind of thing`)
--   2. s 84(1) transfer: the person transfers it to any person (MAYBE BOOLEAN)
--   3. the transfer is under the authority of the Firearms Act or any other Act of Parliament or any regulations made under an Act of Parliament (BOOLEAN)
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a prohibited firearm` (JUST TRUE) FALSE EQUALS JUST TRUE   -- transfers a prohibited firearm otherwise than under the authority of an Act or regulations
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a prohibited firearm` (JUST TRUE) TRUE EQUALS NOTHING   -- transfers it under the authority of the Firearms Act: "otherwise than under the authority" limits the prohibition
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a prohibited firearm` (JUST FALSE) FALSE EQUALS JUST FALSE   -- does not transfer it
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a prohibited firearm` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the thing is a prohibited firearm
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a restricted firearm` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the thing is a restricted firearm
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a non-restricted firearm` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the thing is a non-restricted firearm
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a prohibited weapon` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the thing is a prohibited weapon
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a restricted weapon` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the thing is a restricted weapon
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a replica firearm` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the thing is a replica firearm
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a prohibited device other than a replica firearm` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the thing is a prohibited device other than a replica firearm
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a firearm part` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the thing is a firearm part
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: ammunition other than prohibited ammunition` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the thing is a ammunition other than prohibited ammunition
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: prohibited ammunition` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the thing is a prohibited ammunition
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a cross-bow` (JUST TRUE) FALSE EQUALS JUST FALSE   -- a cross-bow is not named
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: an explosive substance` (JUST TRUE) FALSE EQUALS JUST FALSE   -- a explosive substance is not named
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a thing that is none of those` (JUST TRUE) FALSE EQUALS JUST FALSE   -- a thing that is none of the classes is not named
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a prohibited firearm` NOTHING FALSE EQUALS NOTHING   -- whether the act is a transfer is not covered
#ASSERT `s 101(1) the person commits an offence of transfer without authority` `s 84(1) kind: a cross-bow` NOTHING FALSE EQUALS JUST FALSE   -- whether the act is a transfer is not covered and the thing is not named

-- `s 101(2) the class of the offence`
#ASSERT `s 101(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`  -- both indictable and punishable on summary conviction

-- `s 101(2)(a) the punishment on indictment`
#ASSERT `s 101(2)(a) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `five years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 101(2)(b) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 101(2)(b) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

§ `Assembling Offence`

§§ `Section 102`

-- `s 102(1) the person commits an offence of making an automatic firearm`
-- inputs, in the order of the GIVEN:
--   1. the person alters a firearm so that it is capable of discharging projectiles in rapid succession during one pressure of the trigger (BOOLEAN)
--   2. the person manufactures or assembles a firearm that is capable of discharging projectiles in rapid succession during one pressure of the trigger (BOOLEAN)
--   3. the person has a lawful excuse (BOOLEAN)
#ASSERT `s 102(1) the person commits an offence of making an automatic firearm` TRUE FALSE FALSE EQUALS JUST TRUE   -- alters a firearm so that it is capable of discharging projectiles in rapid succession during one pressure of the trigger
#ASSERT `s 102(1) the person commits an offence of making an automatic firearm` FALSE TRUE FALSE EQUALS JUST TRUE   -- manufactures or assembles such a firearm
#ASSERT `s 102(1) the person commits an offence of making an automatic firearm` FALSE FALSE FALSE EQUALS JUST FALSE   -- neither
#ASSERT `s 102(1) the person commits an offence of making an automatic firearm` TRUE FALSE TRUE EQUALS NOTHING   -- with lawful excuse: "without lawful excuse" limits the prohibition
#ASSERT `s 102(1) the person commits an offence of making an automatic firearm` FALSE FALSE TRUE EQUALS JUST FALSE   -- with lawful excuse, doing neither

-- `s 102(2) the class of the offence`
#ASSERT `s 102(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`  -- both indictable and punishable on summary conviction

-- `s 102(2)(a) the punishment on indictment`
#ASSERT `s 102(2)(a) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `ten years`), `minimum imprisonment` IS (`imprisonment for a term of` (`Length of time` OF 1, 0, 0, FALSE)), `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 102(2)(b) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 102(2)(b) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

§ `Computer Data Offence`

§§ `Section 102.1`

-- `s 102.1(1) the person commits an offence of possession of computer data`
-- inputs, in the order of the GIVEN:
--   1. s 102.1(4) computer data: the thing is computer data (MAYBE BOOLEAN)
--   2. the person possesses or accesses it (BOOLEAN)
--   3. the data pertain to a firearm other than a firearm that is deemed under subsection 84(3) not to be a firearm, or to a prohibited device (BOOLEAN)
--   4. the data are capable of being used with a 3D printer, metal milling machine or similar computer system for the purpose of manufacturing or trafficking a firearm or prohibited device derived from that computer data (BOOLEAN)
--   5. the person acts under the authority of the Firearms Act or any other Act of Parliament or any regulations made under an Act of Parliament (BOOLEAN)
#ASSERT `s 102.1(1) the person commits an offence of possession of computer data` (JUST TRUE) TRUE TRUE TRUE FALSE EQUALS JUST TRUE   -- possesses or accesses computer data pertaining to a firearm, capable of being used with a 3D printer ..., without authority
#ASSERT `s 102.1(1) the person commits an offence of possession of computer data` (JUST FALSE) TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- the thing is not computer data (section 342.1(2))
#ASSERT `s 102.1(1) the person commits an offence of possession of computer data` NOTHING TRUE TRUE TRUE FALSE EQUALS NOTHING   -- whether the thing is computer data is not covered
#ASSERT `s 102.1(1) the person commits an offence of possession of computer data` (JUST TRUE) TRUE TRUE TRUE TRUE EQUALS NOTHING   -- under the authority of the Firearms Act or another Act: "otherwise than under the authority of"
#ASSERT `s 102.1(1) the person commits an offence of possession of computer data` (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS JUST FALSE   -- the data pertain only to a firearm deemed under subsection 84(3) not to be a firearm
#ASSERT `s 102.1(1) the person commits an offence of possession of computer data` (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- the data are not capable of being used with a 3D printer ... for manufacturing or trafficking
#ASSERT `s 102.1(1) the person commits an offence of possession of computer data` (JUST TRUE) FALSE TRUE TRUE FALSE EQUALS JUST FALSE   -- does not possess or access it
#ASSERT `s 102.1(1) the person commits an offence of possession of computer data` (JUST TRUE) FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- does not possess it and acts under authority

-- `s 102.1(2) the person commits an offence of distribution of computer data`
-- inputs, in the order of the GIVEN:
--   1. s 102.1(4) computer data: the thing is computer data (MAYBE BOOLEAN)
--   2. the person distributes, publishes or makes it available (BOOLEAN)
--   3. the data pertain to a firearm other than a firearm that is deemed under subsection 84(3) not to be a firearm, or to a prohibited device (BOOLEAN)
--   4. the data are capable of being used with a 3D printer, metal milling machine or similar computer system (BOOLEAN)
--   5. the person knows that the data are intended to be used for the purpose of manufacturing or trafficking a firearm or prohibited device derived from that computer data (BOOLEAN)
--   6. the person acts under the authority of the Firearms Act or any other Act of Parliament or any regulations made under an Act of Parliament (BOOLEAN)
#ASSERT `s 102.1(2) the person commits an offence of distribution of computer data` (JUST TRUE) TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE   -- distributes, publishes or makes available such data knowing they are intended for manufacturing or trafficking, without authority
#ASSERT `s 102.1(2) the person commits an offence of distribution of computer data` (JUST TRUE) FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- does not distribute, publish or make it available
#ASSERT `s 102.1(2) the person commits an offence of distribution of computer data` (JUST TRUE) TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE   -- the data pertain only to a firearm deemed not to be a firearm by subsection 84(3)
#ASSERT `s 102.1(2) the person commits an offence of distribution of computer data` (JUST TRUE) TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE   -- the data are not capable of being used with a 3D printer ...
#ASSERT `s 102.1(2) the person commits an offence of distribution of computer data` (JUST TRUE) TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- does not know that the data are intended for that purpose
#ASSERT `s 102.1(2) the person commits an offence of distribution of computer data` (JUST FALSE) TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- the thing is not computer data
#ASSERT `s 102.1(2) the person commits an offence of distribution of computer data` NOTHING TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING   -- whether the thing is computer data is not covered
#ASSERT `s 102.1(2) the person commits an offence of distribution of computer data` (JUST TRUE) TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING   -- under the authority of the Firearms Act or another Act

-- `s 102.1(3) the class of the offence`
#ASSERT `s 102.1(3) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`  -- both indictable and punishable on summary conviction

-- `s 102.1(3)(a) the punishment on indictment`
#ASSERT `s 102.1(3)(a) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `ten years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 102.1(3)(b) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 102.1(3)(b) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

-- `s 102.1(4) computer data`
-- inputs, in the order of the GIVEN:
--   1. s 342.1(2) the thing is computer data (MAYBE BOOLEAN)
#ASSERT `s 102.1(4) computer data` (JUST TRUE) EQUALS JUST TRUE   -- the answer of section 342.1(2) is a yes
#ASSERT `s 102.1(4) computer data` (JUST FALSE) EQUALS JUST FALSE   -- a no
#ASSERT `s 102.1(4) computer data` NOTHING EQUALS NOTHING   -- not covered

-- `s 102.1(4) computer system`
-- inputs, in the order of the GIVEN:
--   1. s 342.1(2) the thing is a computer system (MAYBE BOOLEAN)
#ASSERT `s 102.1(4) computer system` (JUST TRUE) EQUALS JUST TRUE   -- the answer of section 342.1(2) is a yes
#ASSERT `s 102.1(4) computer system` (JUST FALSE) EQUALS JUST FALSE   -- a no
#ASSERT `s 102.1(4) computer system` NOTHING EQUALS NOTHING   -- not covered

§ `Export and Import Offences`

§§ `Section 103`

-- `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing (`s 84(1) kind of thing`)
--   2. it is a component or part, other than a firearm part, designed exclusively for use in the manufacture of or assembly into an automatic firearm (BOOLEAN)
--   3. s 84(1) import: the act is an import (MAYBE BOOLEAN)
--   4. s 84(1) export: the act is an export (MAYBE BOOLEAN)
--   5. the person knows that the person is not authorized to do so under the Firearms Act or any other Act of Parliament or any regulations made under any Act of Parliament (BOOLEAN)
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a prohibited firearm` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE   -- (a) imports a prohibited firearm knowing the person is not authorized
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a prohibited firearm` FALSE (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST TRUE   -- (a) exports it
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a prohibited firearm` FALSE (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST FALSE   -- neither imports nor exports
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a prohibited firearm` FALSE (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE   -- does not know that the person is not authorized
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a prohibited firearm` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE   -- (a) the thing is a prohibited firearm
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a restricted firearm` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE   -- (a) the thing is a restricted firearm
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a non-restricted firearm` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE   -- (a) the thing is a non-restricted firearm
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a prohibited weapon` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE   -- (a) the thing is a prohibited weapon
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a restricted weapon` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE   -- (a) the thing is a restricted weapon
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a replica firearm` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE   -- (a) the thing is a replica firearm
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a prohibited device other than a replica firearm` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE   -- (a) the thing is a prohibited device other than a replica firearm
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a firearm part` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE   -- (a) the thing is a firearm part
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: prohibited ammunition` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE   -- (a) the thing is a prohibited ammunition
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: ammunition other than prohibited ammunition` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE   -- ordinary ammunition is not named in (a): only "any prohibited ammunition"
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a cross-bow` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE   -- a cross-bow is not named
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a thing that is none of those` TRUE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE   -- (b) a component or part, other than a firearm part, designed exclusively for use in manufacturing or assembling an automatic firearm
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a thing that is none of those` FALSE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE   -- a thing that is none of the classes and not such a component or part
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a prohibited firearm` FALSE NOTHING (JUST FALSE) TRUE EQUALS NOTHING   -- whether the act is an import is not covered, and no export
#ASSERT `s 103(1) the person commits an offence of importing or exporting knowing it is unauthorized` `s 84(1) kind: a prohibited firearm` FALSE NOTHING (JUST TRUE) TRUE EQUALS JUST TRUE   -- whether the act is an import is not covered, but the person exports it

-- `s 103(2) the class of the offence`
#ASSERT `s 103(2) the class of the offence` EQUALS `an indictable offence`  -- indictable only

-- `s 103(2) the punishment when the object in question is a firearm, device, part or prohibited ammunition`
-- inputs, in the order of the GIVEN:
