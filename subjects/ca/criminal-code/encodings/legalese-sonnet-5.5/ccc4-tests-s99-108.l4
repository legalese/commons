§§ `Section 100`

-- `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing (`s 84(1) kind of thing`)
--   2. the person possesses it (BOOLEAN)
--   3. s 84(1) transfer: the person possesses it for the purpose of transferring it, whether or not for consideration (MAYBE BOOLEAN)
--   4. the person possesses it for the purpose of offering to transfer it (BOOLEAN)
--   5. the person knows that the person is not authorized to transfer it under the Firearms Act or any other Act of Parliament or any regulations made under any Act of Parliament (BOOLEAN)
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a prohibited firearm` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- (a) possesses it for the purpose of transferring it, whether or not for consideration
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a prohibited firearm` TRUE (JUST FALSE) TRUE TRUE EQUALS JUST TRUE   -- (b) possesses it for the purpose of offering to transfer it
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a prohibited firearm` TRUE (JUST FALSE) FALSE TRUE EQUALS JUST FALSE   -- with neither purpose
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a prohibited firearm` FALSE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE   -- does not possess it
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a prohibited firearm` TRUE (JUST TRUE) FALSE FALSE EQUALS JUST FALSE   -- does not know that the person is not authorized to transfer it
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a prohibited firearm` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- the thing is a prohibited firearm
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a restricted firearm` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- the thing is a restricted firearm
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a non-restricted firearm` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- the thing is a non-restricted firearm
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a prohibited weapon` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- the thing is a prohibited weapon
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a restricted weapon` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- the thing is a restricted weapon
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a replica firearm` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- the thing is a replica firearm
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a prohibited device other than a replica firearm` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- the thing is a prohibited device other than a replica firearm
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a firearm part` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- the thing is a firearm part
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: ammunition other than prohibited ammunition` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- the thing is a ammunition other than prohibited ammunition
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: prohibited ammunition` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- the thing is a prohibited ammunition
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a cross-bow` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE   -- a cross-bow is not named
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: an explosive substance` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE   -- a explosive substance is not named
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a thing that is none of those` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE   -- a thing that is none of the classes is not named
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a prohibited firearm` TRUE NOTHING FALSE TRUE EQUALS NOTHING   -- whether the purpose is a transfer is not covered, and no offer is intended
#ASSERT `s 100(1) the person commits an offence of possession for the purpose of weapons trafficking` `s 84(1) kind: a prohibited firearm` TRUE NOTHING TRUE TRUE EQUALS JUST TRUE   -- whether the purpose is a transfer is not covered, but the person intends to offer to transfer it

-- `s 100(2) the class of the offence`
#ASSERT `s 100(2) the class of the offence` EQUALS `an indictable offence`  -- indictable only

