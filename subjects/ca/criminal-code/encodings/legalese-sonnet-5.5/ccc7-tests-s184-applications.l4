IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc7-s183-base`
IMPORT `ccc7-s184-applications`

-- ccc7-tests-s184-applications.l4 -- tests for ccc7-s184-applications.l4 (ss 184.2 and 184.3). Expected values are written by hand from the text, beside each assertion.

§ `Tests -- section 184.2(1)`

-- args: device, private communication, consent of a party, an authorization has been obtained under (3)
#ASSERT `s 184.2(1) a person may intercept a private communication with the consent of a party and an authorization` (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
-- a "may ... where" grant: where the "where" fails the guide's ruling (b) gives JUST FALSE (listed for a lawyer, fork F11)
#ASSERT `s 184.2(1) a person may intercept a private communication with the consent of a party and an authorization` (JUST TRUE) (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 184.2(1) a person may intercept a private communication with the consent of a party and an authorization` (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 184.2(1) a person may intercept a private communication with the consent of a party and an authorization` (JUST TRUE) (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
-- the gate holds but the device or the communication is not covered
#ASSERT `s 184.2(1) a person may intercept a private communication with the consent of a party and an authorization` NOTHING (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 184.2(1) a person may intercept a private communication with the consent of a party and an authorization` (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS NOTHING

§ `Tests -- section 184.2(2)`

-- args: peace officer, public officer, appointed/designated with enforcement duties, ex parte, in writing, judge, affidavit, (a), (b), (c), (d), previously granted, particulars of it
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST TRUE) (JUST FALSE) FALSE TRUE TRUE `s 184.2(2) a provincial court judge` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- a public officer who is appointed or designated and whose duties include enforcement
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST FALSE) (JUST TRUE) TRUE TRUE TRUE `s 184.2(2) a judge of a superior court of criminal jurisdiction` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST FALSE) (JUST TRUE) TRUE TRUE TRUE `s 184.2(2) a judge as defined in section 552` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- a public officer who is not appointed or designated with enforcement duties
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST FALSE) (JUST TRUE) FALSE TRUE TRUE `s 184.2(2) a provincial court judge` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- not ex parte; not in writing; to a judge of none of the three kinds; without the affidavit; each matter missing
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST TRUE) (JUST FALSE) FALSE FALSE TRUE `s 184.2(2) a provincial court judge` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST TRUE) (JUST FALSE) FALSE TRUE FALSE `s 184.2(2) a provincial court judge` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST TRUE) (JUST FALSE) FALSE TRUE TRUE `s 184.2(2) a judge of none of those kinds` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST TRUE) (JUST FALSE) FALSE TRUE TRUE `s 184.2(2) a provincial court judge` FALSE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST TRUE) (JUST FALSE) FALSE TRUE TRUE `s 184.2(2) a provincial court judge` TRUE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST TRUE) (JUST FALSE) FALSE TRUE TRUE `s 184.2(2) a provincial court judge` TRUE TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST TRUE) (JUST FALSE) FALSE TRUE TRUE `s 184.2(2) a provincial court judge` TRUE TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST TRUE) (JUST FALSE) FALSE TRUE TRUE `s 184.2(2) a provincial court judge` TRUE TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- (e): where an authorization was previously granted the particulars must be deposed; where none was, nothing more is required
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST TRUE) (JUST FALSE) FALSE TRUE TRUE `s 184.2(2) a provincial court judge` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` (JUST TRUE) (JUST FALSE) FALSE TRUE TRUE `s 184.2(2) a provincial court judge` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- the applicant is a peace officer or public officer only as section 2 (which says "includes") answers: not covered
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` NOTHING (JUST FALSE) FALSE TRUE TRUE `s 184.2(2) a provincial court judge` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 184.2(2) the application meets the requirements of the subsection` NOTHING (JUST TRUE) FALSE TRUE TRUE `s 184.2(2) a provincial court judge` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- the affidavit
#ASSERT `s 184.2(2) the affidavit may be sworn on information and belief` TRUE EQUALS JUST TRUE
#ASSERT `s 184.2(2) the affidavit may be sworn on information and belief` FALSE EQUALS NOTHING

§ `Tests -- section 184.2(3) to (5)`

#ASSERT `s 184.2(3) an authorization may be given under section 184.2` TRUE TRUE TRUE EQUALS JUST TRUE
-- a failed "if" gate on a "may be given" grant is NOT COVERED (ruling of 2026-11-12), one test per limb
#ASSERT `s 184.2(3) an authorization may be given under section 184.2` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 184.2(3) an authorization may be given under section 184.2` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 184.2(3) an authorization may be given under section 184.2` TRUE TRUE FALSE EQUALS NOTHING
-- (4)(e): "not exceeding sixty days": 1 March to 29 April is 60 days, both ends counted; to 30 April is 61
#ASSERT `s 184.2(4)(e) the period of the authorization is within the limit` (Date 1 3 2025) (Date 29 4 2025) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 184.2(4)(e) the period of the authorization is within the limit` (Date 1 3 2025) (Date 30 4 2025) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 184.2(4)(e) the period of the authorization is within the limit` (Date 1 3 2025) (Date 1 3 2025) (JUST FALSE) EQUALS JUST TRUE
-- a longer period where section 186.1 permits it ("Notwithstanding paragraphs 184.2(4)(e) and 186(4)(e)")
#ASSERT `s 184.2(4)(e) the period of the authorization is within the limit` (Date 1 3 2025) (Date 30 4 2025) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 184.2(4)(e) the period of the authorization is within the limit` (Date 1 3 2025) (Date 30 4 2025) NOTHING EQUALS NOTHING
-- the leap day counts: 1 January to 29 February 2024 is 60 days; to 1 March 2024 is 61
#ASSERT `s 184.2(4)(e) the period of the authorization is within the limit` (Date 1 1 2024) (Date 29 2 2024) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 184.2(4)(e) the period of the authorization is within the limit` (Date 1 1 2024) (Date 1 3 2024) (JUST FALSE) EQUALS JUST FALSE
-- (4) as a whole: args (a), (b), (c), (d), and the answer for (e)
#ASSERT `s 184.2(4) the authorization has the content the subsection requires` TRUE TRUE TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 184.2(4) the authorization has the content the subsection requires` FALSE TRUE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 184.2(4) the authorization has the content the subsection requires` TRUE FALSE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 184.2(4) the authorization has the content the subsection requires` TRUE TRUE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 184.2(4) the authorization has the content the subsection requires` TRUE TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 184.2(4) the authorization has the content the subsection requires` TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 184.2(4) the authorization has the content the subsection requires` TRUE TRUE TRUE TRUE NOTHING EQUALS NOTHING
-- (5): the listed sections 487, 487.01, 487.014 to 487.018, 487.02, 492.1 and 492.2
#ASSERT `s 184.2(5) the section is one of those the subsection lists` (`Provision of the Code` OF 487 , "")
#ASSERT `s 184.2(5) the section is one of those the subsection lists` (`Provision of the Code` OF 487.01 , "")
#ASSERT `s 184.2(5) the section is one of those the subsection lists` (`Provision of the Code` OF 487.014 , "")
#ASSERT `s 184.2(5) the section is one of those the subsection lists` (`Provision of the Code` OF 487.016 , "")
#ASSERT `s 184.2(5) the section is one of those the subsection lists` (`Provision of the Code` OF 487.018 , "")
#ASSERT `s 184.2(5) the section is one of those the subsection lists` (`Provision of the Code` OF 487.02 , "")
#ASSERT `s 184.2(5) the section is one of those the subsection lists` (`Provision of the Code` OF 492.1 , "")
#ASSERT `s 184.2(5) the section is one of those the subsection lists` (`Provision of the Code` OF 492.2 , "")
#ASSERT NOT (`s 184.2(5) the section is one of those the subsection lists` (`Provision of the Code` OF 487.019 , ""))
#ASSERT NOT (`s 184.2(5) the section is one of those the subsection lists` (`Provision of the Code` OF 487.011 , ""))
#ASSERT NOT (`s 184.2(5) the section is one of those the subsection lists` (`Provision of the Code` OF 488 , ""))
#ASSERT NOT (`s 184.2(5) the section is one of those the subsection lists` (`Provision of the Code` OF 492 , ""))
-- args: the warrant or order requested, at the same time, the judge's opinion
#ASSERT `s 184.2(5) the judge may at the same time issue the related warrant or make the related order` (`Provision of the Code` OF 487.01 , "") TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184.2(5) the judge may at the same time issue the related warrant or make the related order` (`Provision of the Code` OF 487.01 , "") TRUE FALSE EQUALS NOTHING
#ASSERT `s 184.2(5) the judge may at the same time issue the related warrant or make the related order` (`Provision of the Code` OF 487.01 , "") FALSE TRUE EQUALS NOTHING
#ASSERT `s 184.2(5) the judge may at the same time issue the related warrant or make the related order` (`Provision of the Code` OF 488 , "") TRUE TRUE EQUALS NOTHING

§ `Tests -- section 184.3`

#ASSERT `s 184.3(1) the person may submit the application by a means of telecommunication that produces a writing` `s 184.3(1) an application for an authorization under subsection 184.2(2)` TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(1) the person may submit the application by a means of telecommunication that produces a writing` `s 184.3(1) an application for an authorization under subsection 185(1)` TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(1) the person may submit the application by a means of telecommunication that produces a writing` `s 184.3(1) an application for an authorization under subsection 186(5.2)` TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(1) the person may submit the application by a means of telecommunication that produces a writing` `s 184.3(1) an application for an authorization under subsection 188(1)` TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(1) the person may submit the application by a means of telecommunication that produces a writing` `s 184.3(1) an application for an extension under subsection 185(2)` TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(1) the person may submit the application by a means of telecommunication that produces a writing` `s 184.3(1) an application for an extension under subsection 196(2)` TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(1) the person may submit the application by a means of telecommunication that produces a writing` `s 184.3(1) an application for an extension under subsection 196.1(2)` TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(1) the person may submit the application by a means of telecommunication that produces a writing` `s 184.3(1) an application to renew an authorization under subsection 186(6)` TRUE EQUALS JUST TRUE
-- not permitted to make that application; an application the list does not name: not covered
#ASSERT `s 184.3(1) the person may submit the application by a means of telecommunication that produces a writing` `s 184.3(1) an application for an authorization under subsection 188(1)` FALSE EQUALS NOTHING
#ASSERT `s 184.3(1) the person may submit the application by a means of telecommunication that produces a writing` `s 184.3(1) an application of another kind` TRUE EQUALS NOTHING
#ASSERT `s 184.3(2) the judge is bound to cause the application to be placed and sealed in the packet` TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(2) the judge is bound to cause the application to be placed and sealed in the packet` FALSE EQUALS NOTHING
#ASSERT `s 184.3(3) the person may submit the application by a means of telecommunication that does not produce a writing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(3) the person may submit the application by a means of telecommunication that does not produce a writing` TRUE FALSE EQUALS NOTHING
#ASSERT `s 184.3(3) the person may submit the application by a means of telecommunication that does not produce a writing` FALSE TRUE EQUALS NOTHING
-- (4): args: the application was submitted without a writing, it includes the statement
#ASSERT `s 184.3(4) the application includes the statement of circumstances the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(4) the application includes the statement of circumstances the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 184.3(4) the application includes the statement of circumstances the subsection requires` FALSE FALSE EQUALS NOTHING
#ASSERT `s 184.3(5) the oath may be administered by a means of telecommunication` TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(5) the oath may be administered by a means of telecommunication` FALSE EQUALS NOTHING
#ASSERT `s 184.3(6) the judge is bound to record the application verbatim and cause it to be placed and sealed in the packet` TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(6) the judge is bound to record the application verbatim and cause it to be placed and sealed in the packet` FALSE EQUALS NOTHING
#ASSERT `s 184.3(6) a recording sealed in the packet is treated as a document for the purposes of section 187` TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(6) a recording sealed in the packet is treated as a document for the purposes of section 187` FALSE EQUALS NOTHING
-- (7): the bar. args: submitted without a writing, the judge is satisfied that the application discloses reasonable grounds for dispensing with a writing
#ASSERT `s 184.3(7) the judge shall not give the authorization` TRUE FALSE EQUALS JUST TRUE
-- "unless he or she is satisfied": the exception is met
#ASSERT `s 184.3(7) the judge shall not give the authorization` TRUE TRUE EQUALS JUST FALSE
-- "If an application is submitted by a means of telecommunication that does not produce a writing": otherwise the bar does not apply
#ASSERT `s 184.3(7) the judge shall not give the authorization` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 184.3(8) the judge may give the authorization, extension or renewal by a means of telecommunication` TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(8) the judge may give the authorization, extension or renewal by a means of telecommunication` FALSE EQUALS NOTHING
-- (8)(a)-(d), args: given by telecommunication, (a) completed and signed, produces a writing, (b) copy transmitted, (c) applicant transcribed, (d) sealed immediately
#ASSERT `s 184.3(8) the steps the subsection requires have been taken` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 184.3(8) the steps the subsection requires have been taken` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- the step for a writing was not taken; the step for no writing was not taken; not signed; not sealed
#ASSERT `s 184.3(8) the steps the subsection requires have been taken` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 184.3(8) the steps the subsection requires have been taken` TRUE TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 184.3(8) the steps the subsection requires have been taken` TRUE FALSE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 184.3(8) the steps the subsection requires have been taken` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 184.3(8) the steps the subsection requires have been taken` FALSE TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING

