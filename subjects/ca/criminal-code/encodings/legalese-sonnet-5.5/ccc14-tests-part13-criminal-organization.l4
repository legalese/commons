IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc14-part13-criminal-organization`

-- ccc14-tests-part13-criminal-organization.l4 -- tests for ccc14-part13-criminal-organization.l4 (Criminal Code, ss 467.1 to 467.2).
-- Every expected value is written from the text of the section named beside it, before the run; none is copied from the module's output.
-- Y = JUST TRUE; N = JUST FALSE; NA = NOTHING (not covered).

`ccc14 Y` MEANS JUST TRUE
`ccc14 N` MEANS JUST FALSE

GIVEN s IS A NUMBER
GIVETH A `Provision of the Code`
`ccc14 test at` MEANS `Provision of the Code` OF s, ""

-- independent constructions of the expected punishments
GIVEN y IS A NUMBER
GIVETH A Punishment
`ccc14 test ind` MEANS Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF y, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
`ccc14 test sum` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `s 467.1 -- Definitions`

-- criminal organization: args (a group, however organized; the number of persons; a main purpose or activity is the facilitation or commission of offences; they would likely bring a material benefit; they are serious offences (s 467.1(1)); a group that forms randomly for a single offence)
#ASSERT `s 467.1(1) the group is a criminal organization` TRUE 3 TRUE TRUE `ccc14 Y` FALSE EQUALS `ccc14 Y`
#ASSERT `s 467.1(1) the group is a criminal organization` TRUE 50 TRUE TRUE `ccc14 Y` FALSE EQUALS `ccc14 Y`
#ASSERT `s 467.1(1) the group is a criminal organization` TRUE 2 TRUE TRUE `ccc14 Y` FALSE EQUALS `ccc14 N`
#ASSERT `s 467.1(1) the group is a criminal organization` TRUE 3 TRUE TRUE `ccc14 Y` TRUE EQUALS `ccc14 N`
#ASSERT `s 467.1(1) the group is a criminal organization` FALSE 3 TRUE TRUE `ccc14 Y` FALSE EQUALS `ccc14 N`
#ASSERT `s 467.1(1) the group is a criminal organization` TRUE 3 FALSE TRUE `ccc14 Y` FALSE EQUALS `ccc14 N`
#ASSERT `s 467.1(1) the group is a criminal organization` TRUE 3 TRUE FALSE `ccc14 Y` FALSE EQUALS `ccc14 N`
#ASSERT `s 467.1(1) the group is a criminal organization` TRUE 3 TRUE TRUE `ccc14 N` FALSE EQUALS `ccc14 N`
#ASSERT `s 467.1(1) the group is a criminal organization` TRUE 3 TRUE TRUE NOTHING FALSE EQUALS NOTHING

-- serious offence: args (class of the offence; its maximum imprisonment (indictable limb or only limb); prescribed by regulation)
#ASSERT `s 467.1(1) the offence is a serious offence` `an indictable offence` (`imprisonment for a term of` `five years`) FALSE EQUALS `ccc14 Y`
#ASSERT `s 467.1(1) the offence is a serious offence` `an indictable offence` (`imprisonment for a term of` (`Length of time` OF 4, 11, 0, FALSE)) FALSE EQUALS `ccc14 N`
#ASSERT `s 467.1(1) the offence is a serious offence` `an indictable offence` (`imprisonment for a term of` (`Length of time` OF 5, 0, 0, TRUE)) FALSE EQUALS `ccc14 N`
#ASSERT `s 467.1(1) the offence is a serious offence` `an indictable offence` (`imprisonment for a term of` `fourteen years`) FALSE EQUALS `ccc14 Y`
#ASSERT `s 467.1(1) the offence is a serious offence` `an indictable offence` `imprisonment for life` FALSE EQUALS `ccc14 Y`
#ASSERT `s 467.1(1) the offence is a serious offence` `an indictable offence` `no imprisonment is stated` FALSE EQUALS NOTHING
#ASSERT `s 467.1(1) the offence is a serious offence` `an offence punishable on summary conviction` (`imprisonment for a term of` `ten years`) FALSE EQUALS `ccc14 N`
#ASSERT `s 467.1(1) the offence is a serious offence` `an offence that the section makes both indictable and punishable on summary conviction` (`imprisonment for a term of` `ten years`) FALSE EQUALS `ccc14 Y`
#ASSERT `s 467.1(1) the offence is a serious offence` `an offence that the section makes both indictable and punishable on summary conviction` (`imprisonment for a term of` `two years`) FALSE EQUALS `ccc14 N`
#ASSERT `s 467.1(1) the offence is a serious offence` `an offence punishable on summary conviction` `no imprisonment is stated` TRUE EQUALS `ccc14 Y`
#ASSERT `s 467.1(1) the offence is a serious offence` `an indictable offence` (`imprisonment for a term of` `two years`) TRUE EQUALS `ccc14 Y`

-- (2) args: the provision in question; the requirement is knowledge of a particular offence; the requirement is that an offence actually be committed
#ASSERT `s 467.1(2) facilitation of an offence requires knowledge of a particular offence, or that an offence actually be committed` (`ccc14 test at` 467.11) TRUE FALSE EQUALS `ccc14 N`
#ASSERT `s 467.1(2) facilitation of an offence requires knowledge of a particular offence, or that an offence actually be committed` (`ccc14 test at` 467.1) FALSE TRUE EQUALS `ccc14 N`
#ASSERT `s 467.1(2) facilitation of an offence requires knowledge of a particular offence, or that an offence actually be committed` (`ccc14 test at` 467.111) TRUE TRUE EQUALS `ccc14 N`
#ASSERT `s 467.1(2) facilitation of an offence requires knowledge of a particular offence, or that an offence actually be committed` (`ccc14 test at` 467.12) TRUE FALSE EQUALS NOTHING
#ASSERT `s 467.1(2) facilitation of an offence requires knowledge of a particular offence, or that an offence actually be committed` (`ccc14 test at` 467.11) FALSE FALSE EQUALS NOTHING

-- (3) args: the provision in question; is a party to the offence; counsels any person to be a party to it
#ASSERT `s 467.1(3) the person commits the offence` (`ccc14 test at` 467.12) TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 467.1(3) the person commits the offence` (`ccc14 test at` 467.13) FALSE TRUE EQUALS `ccc14 Y`
#ASSERT `s 467.1(3) the person commits the offence` (`ccc14 test at` 467.111) TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 467.1(3) the person commits the offence` (`ccc14 test at` 467.1) TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 467.1(3) the person commits the offence` (`ccc14 test at` 467.12) FALSE FALSE EQUALS `ccc14 N`
#ASSERT `s 467.1(3) the person commits the offence` (`ccc14 test at` 467.14) TRUE FALSE EQUALS NOTHING
#ASSERT `s 467.1(3) the person commits the offence` (`ccc14 test at` 467.2) TRUE TRUE EQUALS NOTHING

#ASSERT `s 467.1(4) the regulation-making power, as the text shows it` EQUALS "The Governor in Council may make regulations prescribing offences that are included in the definition serious offence in subsection (1)."

§ `s 467.11 -- Participation in activities of criminal organization`

-- (1) args: the group is a criminal organization (s 467.1(1)); for the purpose of enhancing its ability; knowingly; participates in or contributes to any activity
#ASSERT `s 467.11(1) the person commits the offence of participating in the activities of a criminal organization` `ccc14 Y` TRUE TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 467.11(1) the person commits the offence of participating in the activities of a criminal organization` `ccc14 Y` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 467.11(1) the person commits the offence of participating in the activities of a criminal organization` `ccc14 Y` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 467.11(1) the person commits the offence of participating in the activities of a criminal organization` `ccc14 Y` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 467.11(1) the person commits the offence of participating in the activities of a criminal organization` NOTHING TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 467.11(1) the person commits the offence of participating in the activities of a criminal organization` `ccc14 N` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 467.11(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 467.11(1) the punishment` EQUALS LIST (`ccc14 test ind` 5), (`ccc14 test sum`)
-- (2) "it is not necessary for the prosecutor to prove that": each of (a) to (d) is a no
#ASSERT `s 467.11(2) it is necessary for the prosecutor to prove the matter` TRUE `s 467.11(2)(a) the criminal organization actually facilitated or committed an indictable offence` EQUALS `ccc14 N`
#ASSERT `s 467.11(2) it is necessary for the prosecutor to prove the matter` TRUE `s 467.11(2)(b) the participation or contribution of the accused actually enhanced the ability of the criminal organization to facilitate or commit an indictable offence` EQUALS `ccc14 N`
#ASSERT `s 467.11(2) it is necessary for the prosecutor to prove the matter` TRUE `s 467.11(2)(c) the accused knew the specific nature of any indictable offence that may have been facilitated or committed by the criminal organization` EQUALS `ccc14 N`
#ASSERT `s 467.11(2) it is necessary for the prosecutor to prove the matter` TRUE `s 467.11(2)(d) the accused knew the identity of any of the persons who constitute the criminal organization` EQUALS `ccc14 N`
#ASSERT `s 467.11(2) it is necessary for the prosecutor to prove the matter` TRUE `s 467.11(2) a matter that is none of those` EQUALS NOTHING
#ASSERT `s 467.11(2) it is necessary for the prosecutor to prove the matter` FALSE `s 467.11(2)(a) the criminal organization actually facilitated or committed an indictable offence` EQUALS NOTHING
-- (3) "among other factors"
#ASSERT `s 467.11(3) the court may consider the factor in determining whether the accused participates in or contributes to an activity of a criminal organization` `s 467.11(3)(a) uses a name, word, symbol or other representation that identifies, or is associated with, the criminal organization` EQUALS `ccc14 Y`
#ASSERT `s 467.11(3) the court may consider the factor in determining whether the accused participates in or contributes to an activity of a criminal organization` `s 467.11(3)(b) frequently associates with any of the persons who constitute the criminal organization` EQUALS `ccc14 Y`
#ASSERT `s 467.11(3) the court may consider the factor in determining whether the accused participates in or contributes to an activity of a criminal organization` `s 467.11(3)(c) receives any benefit from the criminal organization` EQUALS `ccc14 Y`
#ASSERT `s 467.11(3) the court may consider the factor in determining whether the accused participates in or contributes to an activity of a criminal organization` `s 467.11(3)(d) repeatedly engages in activities at the instruction of any of the persons who constitute the criminal organization` EQUALS `ccc14 Y`
#ASSERT `s 467.11(3) the court may consider the factor in determining whether the accused participates in or contributes to an activity of a criminal organization` `s 467.11(3) a factor that is none of those named` EQUALS NOTHING

§ `s 467.111 -- Recruitment of members by a criminal organization`

-- args: the group is a criminal organization (s 467.1(1)); for the purpose of enhancing its ability; recruits, solicits, encourages, coerces or invites a person to join
#ASSERT `s 467.111 the person commits the offence of recruiting members for a criminal organization` `ccc14 Y` TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 467.111 the person commits the offence of recruiting members for a criminal organization` `ccc14 Y` FALSE TRUE EQUALS NOTHING
#ASSERT `s 467.111 the person commits the offence of recruiting members for a criminal organization` `ccc14 Y` TRUE FALSE EQUALS NOTHING
#ASSERT `s 467.111 the person commits the offence of recruiting members for a criminal organization` NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 467.111 the class of the offence` EQUALS `an indictable offence`
-- (a) under 18: not exceeding five years and a minimum of six months; (b) any other case: not exceeding five years
#ASSERT `s 467.111 the punishment` TRUE EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 5, 0, 0, FALSE), `imprisonment for a term of` (`Length of time` OF 0, 6, 0, FALSE), `no fine is stated`, `no fine is stated`)
#ASSERT `s 467.111 the punishment` FALSE EQUALS LIST (`ccc14 test ind` 5)

§ `s 467.12 -- Commission of offence for criminal organization`

-- args: the group is a criminal organization (s 467.1(1)); the person commits an indictable offence (s 467.1(3)); for the benefit of, at the direction of, or in association with it
#ASSERT `s 467.12(1) the person commits the offence of committing an offence for a criminal organization` `ccc14 Y` `ccc14 Y` TRUE EQUALS `ccc14 Y`
#ASSERT `s 467.12(1) the person commits the offence of committing an offence for a criminal organization` `ccc14 Y` `ccc14 Y` FALSE EQUALS NOTHING
#ASSERT `s 467.12(1) the person commits the offence of committing an offence for a criminal organization` `ccc14 Y` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 467.12(1) the person commits the offence of committing an offence for a criminal organization` `ccc14 Y` `ccc14 N` TRUE EQUALS NOTHING
#ASSERT `s 467.12(1) the person commits the offence of committing an offence for a criminal organization` NOTHING `ccc14 Y` TRUE EQUALS NOTHING
#ASSERT `s 467.12(1) the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 467.12(1) the punishment` EQUALS LIST (`ccc14 test ind` 14)
#ASSERT `s 467.12(2) it is necessary for the prosecutor to prove that the accused knew the identity of any of the persons who constitute the criminal organization` TRUE EQUALS `ccc14 N`
#ASSERT `s 467.12(2) it is necessary for the prosecutor to prove that the accused knew the identity of any of the persons who constitute the criminal organization` FALSE EQUALS NOTHING

§ `s 467.13 -- Instructing commission of offence for criminal organization`

-- args: the group is a criminal organization (s 467.1(1)); the person is one of its members; knowingly instructs any person to commit an offence; for the benefit of, at the direction of, or in association with it
#ASSERT `s 467.13(1) the person commits the offence of instructing the commission of an offence for a criminal organization` `ccc14 Y` TRUE TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 467.13(1) the person commits the offence of instructing the commission of an offence for a criminal organization` `ccc14 Y` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 467.13(1) the person commits the offence of instructing the commission of an offence for a criminal organization` `ccc14 Y` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 467.13(1) the person commits the offence of instructing the commission of an offence for a criminal organization` `ccc14 Y` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 467.13(1) the person commits the offence of instructing the commission of an offence for a criminal organization` NOTHING TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 467.13(1) the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 467.13(1) the punishment` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 467.13(2) it is necessary for the prosecutor to prove the matter` TRUE `s 467.13(2)(a) an offence other than the offence under subsection (1) was actually committed` EQUALS `ccc14 N`
#ASSERT `s 467.13(2) it is necessary for the prosecutor to prove the matter` TRUE `s 467.13(2)(b) the accused instructed a particular person to commit an offence` EQUALS `ccc14 N`
#ASSERT `s 467.13(2) it is necessary for the prosecutor to prove the matter` TRUE `s 467.13(2)(c) the accused knew the identity of all of the persons who constitute the criminal organization` EQUALS `ccc14 N`
#ASSERT `s 467.13(2) it is necessary for the prosecutor to prove the matter` TRUE `s 467.13(2) a matter that is none of those` EQUALS NOTHING
#ASSERT `s 467.13(2) it is necessary for the prosecutor to prove the matter` FALSE `s 467.13(2)(b) the accused instructed a particular person to commit an offence` EQUALS NOTHING

§ `s 467.14 and s 467.2`

-- args: the provision the sentence is imposed under; another punishment for an offence from the same event; another sentence the person is subject to
#ASSERT `s 467.14 the sentence is to be served consecutively to the other punishment or sentence` (`ccc14 test at` 467.11) TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 467.14 the sentence is to be served consecutively to the other punishment or sentence` (`ccc14 test at` 467.111) FALSE TRUE EQUALS `ccc14 Y`
#ASSERT `s 467.14 the sentence is to be served consecutively to the other punishment or sentence` (`ccc14 test at` 467.12) TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 467.14 the sentence is to be served consecutively to the other punishment or sentence` (`ccc14 test at` 467.13) FALSE TRUE EQUALS `ccc14 Y`
#ASSERT `s 467.14 the sentence is to be served consecutively to the other punishment or sentence` (`ccc14 test at` 467.11) FALSE FALSE EQUALS NOTHING
#ASSERT `s 467.14 the sentence is to be served consecutively to the other punishment or sentence` (`ccc14 test at` 467.14) TRUE TRUE EQUALS NOTHING
#ASSERT `s 467.14 the sentence is to be served consecutively to the other punishment or sentence` (`ccc14 test at` 467.1) TRUE FALSE EQUALS NOTHING

#ASSERT `s 467.2 as the text shows it` EQUALS "467.2 [Repealed, 2019, c. 25, s. 185]"
