IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc29-xxvii-a-interpretation-penalty`

-- ccc29-tests-xxvii-a.l4 -- tests for sections 785, 786 and 787 of the Criminal Code (Canada).
-- Every expected value is written from the text before the run, beside its assertion; none is copied from the code's output.

§ `Tests -- section 785`

-- "clerk of the appeal court includes a local clerk": a local clerk is one; the clerk is one; anyone else: "includes" leaves the list open.
-- 785 lead-in: Part XXVII is sections 785 to 840.
#ASSERT `s 785 the definitions apply` 785 EQUALS JUST TRUE
#ASSERT `s 785 the definitions apply` 840 EQUALS JUST TRUE
#ASSERT `s 785 the definitions apply` 784 EQUALS NOTHING
#ASSERT `s 785 the definitions apply` 841 EQUALS NOTHING
#ASSERT `s 785 clerk of the appeal court` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 785 clerk of the appeal court` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 785 clerk of the appeal court` FALSE FALSE EQUALS NOTHING

-- "informant means a person who lays an information": a person who does is one; a person who does not is not.
#ASSERT `s 785 informant` TRUE EQUALS JUST TRUE
#ASSERT `s 785 informant` FALSE EQUALS JUST FALSE

-- "information includes (a) a count ... (b) a complaint ...".
#ASSERT `s 785 information` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 information` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 785 information` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 785 information` FALSE FALSE FALSE EQUALS NOTHING

-- "order means any order, including an order for the payment of money".
#ASSERT `s 785 order` TRUE EQUALS JUST TRUE
#ASSERT `s 785 order` FALSE EQUALS JUST FALSE

-- "proceedings means (a) ... and (b) ...": either limb brings a case within; neither does not.
#ASSERT `s 785 proceedings` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 785 proceedings` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 785 proceedings` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 785 proceedings` FALSE FALSE EQUALS JUST FALSE

-- "prosecutor means the Attorney General or, where the Attorney General does not intervene, the informant, and includes counsel or an agent acting on behalf of either of them".
#ASSERT `s 785 prosecutor` `s 785 prosecutor: the Attorney General` EQUALS JUST TRUE
#ASSERT `s 785 prosecutor` `s 785 prosecutor: the informant, where the Attorney General does not intervene` EQUALS JUST TRUE
#ASSERT `s 785 prosecutor` `s 785 prosecutor: the informant, where the Attorney General intervenes` EQUALS JUST FALSE
#ASSERT `s 785 prosecutor` `s 785 prosecutor: counsel or an agent acting on behalf of the Attorney General or of the informant` EQUALS JUST TRUE
#ASSERT `s 785 prosecutor` `s 785 prosecutor: a person who is none of those` EQUALS JUST FALSE

-- "sentence includes (a) a declaration made under subsection 199(3)": that subsection; not 199(2); not 200(3).
#ASSERT `s 785 sentence` (`Provision of the Code` OF 199, "(3)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 199, "(2)") FALSE FALSE EQUALS NOTHING
#ASSERT `s 785 sentence` (`Provision of the Code` OF 200, "(3)") FALSE FALSE EQUALS NOTHING
-- (b) "an order made under subsection 109(1) or 110(1)": the two subsections named, and not 109(2) or 111(1).
#ASSERT `s 785 sentence` (`Provision of the Code` OF 109, "(1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 110, "(1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 109, "(2)") FALSE FALSE EQUALS NOTHING
#ASSERT `s 785 sentence` (`Provision of the Code` OF 111, "(1)") FALSE FALSE EQUALS NOTHING
-- (b) "section 320.24" (a whole section, so any subsection of it) but not the next section 320.25.
#ASSERT `s 785 sentence` (`Provision of the Code` OF 320.24, "(2)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 320.25, "(2)") FALSE FALSE EQUALS NOTHING
-- (b) "subsection 730(1)": 730(1) is in, 730(2) is not.
#ASSERT `s 785 sentence` (`Provision of the Code` OF 730, "(1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 730, "(2)") FALSE FALSE EQUALS NOTHING
-- (b) "subsection ... 737(2.1) or (3)": both are in; 737(2) is not.
#ASSERT `s 785 sentence` (`Provision of the Code` OF 737, "(2.1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 737, "(3)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 737, "(2)") FALSE FALSE EQUALS NOTHING
-- (b) "section 738, 739, 742.1 or 742.3": whole sections; 740 and 742.2 are not named.
#ASSERT `s 785 sentence` (`Provision of the Code` OF 738, "(1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 739, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 742.1, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 742.3, "(2)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 740, "") FALSE FALSE EQUALS NOTHING
#ASSERT `s 785 sentence` (`Provision of the Code` OF 742.2, "") FALSE FALSE EQUALS NOTHING
-- (c) "a disposition made under section 731 or 732 or subsection 732.2(3) or (5), 742.4(3) or 742.6(9)".
#ASSERT `s 785 sentence` (`Provision of the Code` OF 731, "(1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 732, "(1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 732.2, "(3)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 732.2, "(5)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 732.2, "(4)") FALSE FALSE EQUALS NOTHING
#ASSERT `s 785 sentence` (`Provision of the Code` OF 742.4, "(3)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 742.4, "(2)") FALSE FALSE EQUALS NOTHING
#ASSERT `s 785 sentence` (`Provision of the Code` OF 742.6, "(9)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 742.6, "(8)") FALSE FALSE EQUALS NOTHING
-- (d) and (e): an order under subsection 16(1) of the Controlled Drugs and Substances Act; under 94(1) of the Cannabis Act.
#ASSERT `s 785 sentence` (`Provision of the Code` OF 1, "") TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 1, "") FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 785 sentence` (`Provision of the Code` OF 1, "") FALSE FALSE EQUALS NOTHING

-- "summary conviction court means a person who has jurisdiction in the territorial division ... and who (a) is given jurisdiction by the enactment, (b) is a justice or provincial court judge, where the enactment does not expressly give jurisdiction to any person or class, or (c) is a provincial court judge, where the enactment gives jurisdiction to two or more justices".
-- args: jurisdiction in the division; (a) given jurisdiction; (b) justice or PCJ; enactment expressly gives it to a person or class; (c) PCJ; enactment gives it to two or more justices.
#ASSERT `s 785 summary conviction court` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 summary conviction court` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 785 summary conviction court` TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 785 summary conviction court` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 785 summary conviction court` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 785 summary conviction court` FALSE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 785 summary conviction court` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- "trial includes the hearing of a complaint".
#ASSERT `s 785 trial` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 785 trial` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 785 trial` FALSE FALSE EQUALS NOTHING

§ `Tests -- section 786`

-- 786(1): the Part applies to proceedings as defined, except where the law provides otherwise.
#ASSERT `s 786(1) this Part applies to the proceedings` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 786(1) this Part applies to the proceedings` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 786(1) this Part applies to the proceedings` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 786(1) this Part applies to the proceedings` NOTHING FALSE EQUALS NOTHING

-- 786(2): 12 months. Subject matter arose 15 January 2024: 15 January 2025 is the last day within the 12 months; 16 January 2025 is more than 12 months after.
#ASSERT `s 786(2) the day on which the 12 months end` (Date 15 1 2024) EQUALS Date 15 1 2025
#ASSERT `s 786(2) the proceedings are barred because they were instituted more than 12 months after the subject matter arose` (Date 15 1 2024) (Date 15 1 2025) FALSE EQUALS JUST FALSE
#ASSERT `s 786(2) the proceedings are barred because they were instituted more than 12 months after the subject matter arose` (Date 15 1 2024) (Date 16 1 2025) FALSE EQUALS JUST TRUE
-- the same facts, but the prosecutor and the defendant agree: "unless the prosecutor and the defendant so agree".
#ASSERT `s 786(2) the proceedings are barred because they were instituted more than 12 months after the subject matter arose` (Date 15 1 2024) (Date 16 1 2025) TRUE EQUALS JUST FALSE
-- a matter that arose on 29 February 2024: 12 months end on 28 February 2025 (the month has no 29th) -- fork F-786-2.
#ASSERT `s 786(2) the day on which the 12 months end` (Date 29 2 2024) EQUALS Date 28 2 2025
#ASSERT `s 786(2) the proceedings are barred because they were instituted more than 12 months after the subject matter arose` (Date 29 2 2024) (Date 28 2 2025) FALSE EQUALS JUST FALSE
#ASSERT `s 786(2) the proceedings are barred because they were instituted more than 12 months after the subject matter arose` (Date 29 2 2024) (Date 1 3 2025) FALSE EQUALS JUST TRUE
-- instituted early in the 12 months.
#ASSERT `s 786(2) the proceedings are barred because they were instituted more than 12 months after the subject matter arose` (Date 15 1 2024) (Date 1 2 2024) FALSE EQUALS JUST FALSE

§ `Tests -- section 787`

-- 787(1): the general penalty is a fine of not more than $5,000 or imprisonment of not more than two years less a day, or both.
#ASSERT (`s 787(1) the general penalty as stated in section 787(1)`'s `mode`) EQUALS `on summary conviction`
#ASSERT (`s 787(1) the general penalty as stated in section 787(1)`'s `maximum fine`) EQUALS (`a fine of` 5000)
#ASSERT (`s 787(1) the general penalty as stated in section 787(1)`'s `maximum imprisonment`) EQUALS (`imprisonment for a term of` `two years less a day`)
#ASSERT (`s 787(1) the general penalty as stated in section 787(1)`'s `minimum fine`) EQUALS `no fine is stated`
#ASSERT (`s 787(1) the general penalty as stated in section 787(1)`'s `minimum imprisonment`) EQUALS `no imprisonment is stated`
-- "Unless otherwise provided by law": it applies to an offence punishable on summary conviction, unless the law provides otherwise; an offence that is not so punishable is outside the sentence.
#ASSERT `s 787(1) the general penalty applies to the offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 787(1) the general penalty applies to the offence` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 787(1) the general penalty applies to the offence` FALSE FALSE EQUALS NOTHING
-- "not more than $5,000": 5,000 is within; 5,000.01 is not.
#ASSERT `s 787(1) the fine is not more than $5,000` 5000 EQUALS JUST TRUE
#ASSERT `s 787(1) the fine is not more than $5,000` 5000.01 EQUALS JUST FALSE
#ASSERT `s 787(1) the fine is not more than $5,000` 0 EQUALS JUST TRUE
-- "not more than two years less a day", in whole months: 23 months is within; 24 months (two years) is not.
#ASSERT `s 787(1) the term of imprisonment is not more than two years less a day` 23 EQUALS JUST TRUE
#ASSERT `s 787(1) the term of imprisonment is not more than two years less a day` 24 EQUALS JUST FALSE
#ASSERT `s 787(1) the term of imprisonment is not more than two years less a day` 6 EQUALS JUST TRUE
-- 787(2): "If ... authorized by law, but the law does not provide that imprisonment may be imposed in default ..., the court may order".
#ASSERT `s 787(2) the court may order imprisonment in default of payment of the fine or compliance with the order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 787(2) the court may order imprisonment in default of payment of the fine or compliance with the order` TRUE TRUE EQUALS NOTHING
#ASSERT `s 787(2) the court may order imprisonment in default of payment of the fine or compliance with the order` FALSE FALSE EQUALS NOTHING
#ASSERT `s 787(2) the longest term of imprisonment the court may order in default` EQUALS (`imprisonment for a term of` `two years less a day`)
