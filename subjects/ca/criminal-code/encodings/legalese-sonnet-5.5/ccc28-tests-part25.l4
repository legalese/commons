IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc28-part25-forfeiture`

-- ccc28-tests-part25.l4 -- tests of sections 762 to 773. Expected values are written by hand from the words of each provision, on both sides of every threshold.

§ `s 762: where applications for forfeiture are made`

#ASSERT `s 762(1) the application for forfeiture is made to the court the schedule designates` `a release order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 762(1) the application for forfeiture is made to the court the schedule designates` `an undertaking` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 762(1) the application for forfeiture is made to the court the schedule designates` `a recognizance` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 762(1) the application for forfeiture is made to the court the schedule designates` `a recognizance` TRUE FALSE EQUALS JUST FALSE   -- "must be made to the courts designated in column II"
#ASSERT `s 762(1) the application for forfeiture is made to the court the schedule designates` `a recognizance` FALSE TRUE EQUALS NOTHING   -- not an application for forfeiture of an amount in the document
#ASSERT `s 762(1) the application for forfeiture is made to the court the schedule designates` `a summons` TRUE TRUE EQUALS NOTHING   -- a summons is not one of the three documents
#ASSERT `s 762(2) the person is the clerk of the court` TRUE EQUALS JUST TRUE
#ASSERT `s 762(2) the person is the clerk of the court` FALSE EQUALS JUST FALSE   -- "means"
#ASSERT `s 762(2) the document is the schedule` TRUE EQUALS JUST TRUE
#ASSERT `s 762(2) the document is the schedule` FALSE EQUALS JUST FALSE

§ `s 763: the document continues to bind`

#ASSERT `s 763(1) the person and their sureties continue to be bound` `an undertaking` TRUE TRUE FALSE EQUALS JUST TRUE   -- adjourned
#ASSERT `s 763(1) the person and their sureties continue to be bound` `a release order` TRUE FALSE TRUE EQUALS JUST TRUE   -- an order changing the place of trial
#ASSERT `s 763(1) the person and their sureties continue to be bound` `a recognizance` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 763(1) the person and their sureties continue to be bound` `a recognizance` TRUE FALSE FALSE EQUALS JUST FALSE   -- neither an adjournment nor a change of the place of trial
#ASSERT `s 763(1) the person and their sureties continue to be bound` `a recognizance` FALSE TRUE FALSE EQUALS JUST FALSE   -- not bound to appear
#ASSERT `s 763(1) the person and their sureties continue to be bound` `a summons` TRUE TRUE FALSE EQUALS NOTHING   -- a summons is not named
#ASSERT `s 763(2) the document sets out a summary of section 763 as it must` `an undertaking` TRUE EQUALS JUST TRUE
#ASSERT `s 763(2) the document sets out a summary of section 763 as it must` `a release order` FALSE EQUALS JUST FALSE   -- a bare "must" not done
#ASSERT `s 763(2) the document sets out a summary of section 763 as it must` `a recognizance` FALSE EQUALS JUST FALSE
#ASSERT `s 763(2) the document sets out a summary of section 763 as it must` `a summons` FALSE EQUALS NOTHING

§ `ss 764 and 765: bound until discharged or sentenced`

#ASSERT `s 764(1) the undertaking or release order continues to bind the accused and their sureties for their appearance` `an undertaking` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 764(1) the undertaking or release order continues to bind the accused and their sureties for their appearance` `a release order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 764(1) the undertaking or release order continues to bind the accused and their sureties for their appearance` `a release order` TRUE TRUE EQUALS JUST FALSE   -- "until the accused is discharged or sentenced"
#ASSERT `s 764(1) the undertaking or release order continues to bind the accused and their sureties for their appearance` `a release order` FALSE FALSE EQUALS JUST FALSE   -- not bound to appear for trial
#ASSERT `s 764(1) the undertaking or release order continues to bind the accused and their sureties for their appearance` `a recognizance` TRUE FALSE EQUALS NOTHING   -- a recognizance is not named
#ASSERT `s 764(2) the court, provincial court judge or justice may take this step` TRUE FALSE `s 764(2) commit the accused to prison` EQUALS JUST TRUE
#ASSERT `s 764(2) the court, provincial court judge or justice may take this step` TRUE FALSE `s 764(2) require the accused to furnish new or additional sureties for their appearance` EQUALS JUST TRUE
#ASSERT `s 764(2) the court, provincial court judge or justice may take this step` TRUE FALSE `s 764(2) a step the subsection does not name` EQUALS NOTHING
#ASSERT `s 764(2) the court, provincial court judge or justice may take this step` TRUE TRUE `s 764(2) commit the accused to prison` EQUALS JUST FALSE   -- the accused is discharged or sentenced
#ASSERT `s 764(2) the court, provincial court judge or justice may take this step` FALSE FALSE `s 764(2) commit the accused to prison` EQUALS NOTHING   -- not bound by an undertaking or release order to appear for trial
#ASSERT `s 764(3) the sureties of the accused are discharged` `a release order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 764(3) the sureties of the accused are discharged` `a release order` TRUE FALSE EQUALS JUST FALSE   -- not committed to prison under subsection (2)
#ASSERT `s 764(3) the sureties of the accused are discharged` `a release order` FALSE TRUE EQUALS JUST FALSE   -- not bound to appear for trial
#ASSERT `s 764(3) the sureties of the accused are discharged` `an undertaking` TRUE TRUE EQUALS NOTHING   -- only a release order is named
#ASSERT `s 764(3) the sureties of the accused are discharged` `a recognizance` TRUE TRUE EQUALS NOTHING
#ASSERT `s 764(4) the document sets out a summary of subsections (1) to (3) as it must` `an undertaking` TRUE EQUALS JUST TRUE
#ASSERT `s 764(4) the document sets out a summary of subsections (1) to (3) as it must` `a release order` FALSE EQUALS JUST FALSE
#ASSERT `s 764(4) the document sets out a summary of subsections (1) to (3) as it must` `a recognizance` FALSE EQUALS NOTHING   -- a recognizance is not named
#ASSERT `s 765 the undertaking or release order continues to bind the accused and their sureties despite the arrest on another charge` `an undertaking` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 765 the undertaking or release order continues to bind the accused and their sureties despite the arrest on another charge` `a release order` TRUE TRUE EQUALS JUST FALSE   -- discharged or sentenced in respect of the offence
#ASSERT `s 765 the undertaking or release order continues to bind the accused and their sureties despite the arrest on another charge` `a release order` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 765 the undertaking or release order continues to bind the accused and their sureties despite the arrest on another charge` `a recognizance` TRUE FALSE EQUALS NOTHING

§ `ss 766 to 769: render of the accused by sureties`

#ASSERT `s 766(1) the surety may apply to be relieved of their obligation` `a release order` TRUE EQUALS JUST TRUE
#ASSERT `s 766(1) the surety may apply to be relieved of their obligation` `a recognizance` TRUE EQUALS JUST TRUE
#ASSERT `s 766(1) the surety may apply to be relieved of their obligation` `a recognizance` FALSE EQUALS NOTHING   -- not by an application in writing: the way named is not said to be the only way
#ASSERT `s 766(1) the surety may apply to be relieved of their obligation` `an undertaking` TRUE EQUALS NOTHING   -- an undertaking is not named
#ASSERT `s 766(1) the court, provincial court judge or justice shall make an order in writing for committal of the person` `a release order` TRUE EQUALS JUST TRUE
#ASSERT `s 766(1) the court, provincial court judge or justice shall make an order in writing for committal of the person` `a recognizance` FALSE EQUALS JUST FALSE   -- no application by the surety
#ASSERT `s 766(1) the court, provincial court judge or justice shall make an order in writing for committal of the person` `an undertaking` TRUE EQUALS NOTHING
#TRACE `s 766(1) the court's duty to commit the person on the surety's application` AT 0 WITH
    PARTY `the court` DOES `s 766(1) make an order in writing for committal of the person to the prison named in the order` AT 2

#ASSERT `s 766(2) the order is given to the surety as it must be` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 766(2) the order is given to the surety as it must be` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 766(2) the order is given to the surety as it must be` FALSE TRUE EQUALS NOTHING   -- not an order issued under subsection (1)
#ASSERT `s 766(2) this person may arrest the person named in the order and deliver them to the keeper of the prison` `s 766(2) the surety` TRUE EQUALS JUST TRUE
#ASSERT `s 766(2) this person may arrest the person named in the order and deliver them to the keeper of the prison` `s 766(2) a peace officer` TRUE EQUALS JUST TRUE
#ASSERT `s 766(2) this person may arrest the person named in the order and deliver them to the keeper of the prison` `s 766(2) another person` TRUE EQUALS NOTHING   -- the persons named are not said to be the only ones
#ASSERT `s 766(2) this person may arrest the person named in the order and deliver them to the keeper of the prison` `s 766(2) the surety` FALSE EQUALS JUST FALSE   -- "on receipt of it"
#ASSERT `s 766(2) the keeper shall receive and imprison the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 766(2) the keeper shall receive and imprison the person` TRUE TRUE EQUALS JUST FALSE   -- "until the person is discharged according to law"
#ASSERT `s 766(2) the keeper shall receive and imprison the person` FALSE FALSE EQUALS NOTHING
#TRACE `s 766(2) the keeper's duty to receive and imprison the person` AT 0 WITH
    PARTY `the keeper of a prison` DOES `s 766(2) receive and imprison the person` AT 1

#ASSERT `s 766(3) the court, provincial court judge or justice shall order an entry of the committal to be endorsed on the document` `a release order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 766(3) the court, provincial court judge or justice shall order an entry of the committal to be endorsed on the document` `a recognizance` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 766(3) the court, provincial court judge or justice shall order an entry of the committal to be endorsed on the document` `a recognizance` TRUE FALSE EQUALS JUST FALSE   -- no certificate from the sheriff yet
#ASSERT `s 766(3) the court, provincial court judge or justice shall order an entry of the committal to be endorsed on the document` `a recognizance` FALSE TRUE EQUALS JUST FALSE   -- no order under subsection (1)
#ASSERT `s 766(3) the court, provincial court judge or justice shall order an entry of the committal to be endorsed on the document` `an undertaking` TRUE TRUE EQUALS NOTHING
#TRACE `s 766(3) the court's duty to order an entry of the committal to be endorsed` AT 0 WITH
    PARTY `the court` DOES `s 766(3) order an entry of the committal to be endorsed on the release order or recognizance` AT 4

#ASSERT `s 766(4) the release order or recognizance is cancelled and the sureties are discharged` TRUE EQUALS JUST TRUE
#ASSERT `s 766(4) the release order or recognizance is cancelled and the sureties are discharged` FALSE EQUALS NOTHING
#ASSERT `s 767 the surety may bring the person before the court` `a release order` `s 767 the court where the person is required to appear` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 767 the surety may bring the person before the court` `a recognizance` `s 767 the court where the person entered into the recognizance` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 767 the surety may bring the person before the court` `a recognizance` `s 767 another court` TRUE TRUE EQUALS NOTHING
#ASSERT `s 767 the surety may bring the person before the court` `a recognizance` `s 767 the court where the person is required to appear` FALSE TRUE EQUALS JUST FALSE   -- not during the sittings
#ASSERT `s 767 the surety may bring the person before the court` `a recognizance` `s 767 the court where the person is required to appear` TRUE FALSE EQUALS JUST FALSE   -- not before the person's trial
#ASSERT `s 767 the surety may bring the person before the court` `an undertaking` `s 767 the court where the person is required to appear` TRUE TRUE EQUALS NOTHING
#ASSERT `s 767 the surety discharges their obligation under the release order or recognizance` TRUE EQUALS JUST TRUE
#ASSERT `s 767 the surety discharges their obligation under the release order or recognizance` FALSE EQUALS NOTHING
#ASSERT `s 767 the court shall commit the person to prison` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 767 the court shall commit the person to prison` TRUE TRUE EQUALS JUST FALSE   -- "until the person is discharged according to law"
#ASSERT `s 767 the court shall commit the person to prison` FALSE FALSE EQUALS JUST FALSE   -- "shall then commit"
#TRACE `s 767 the court's duty to commit the person to prison` AT 0 WITH
    PARTY `the court` DOES `s 767 commit the person to prison` AT 0

#ASSERT `s 767.1(1) the court, justice or provincial court judge may substitute another person for the surety` TRUE FALSE TRUE EQUALS JUST TRUE   -- the surety gave the person into custody under 767
#ASSERT `s 767.1(1) the court, justice or provincial court judge may substitute another person for the surety` FALSE TRUE TRUE EQUALS JUST TRUE   -- the surety applied to be relieved under 766(1)
#ASSERT `s 767.1(1) the court, justice or provincial court judge may substitute another person for the surety` FALSE FALSE TRUE EQUALS NOTHING   -- neither: a grant limited by an "if", not covered
#ASSERT `s 767.1(1) the court, justice or provincial court judge may substitute another person for the surety` TRUE FALSE FALSE EQUALS NOTHING   -- the other person is not suitable: not covered
#ASSERT `s 767.1(2) the original surety is discharged` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 767.1(2) the original surety is discharged` TRUE FALSE EQUALS JUST FALSE   -- the substituted person does not sign
#ASSERT `s 767.1(2) the original surety is discharged` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 768 this Part limits the surety's right of taking and giving the person into custody` TRUE EQUALS JUST FALSE   -- "Nothing in this Part limits"
#ASSERT `s 768 this Part limits the surety's right of taking and giving the person into custody` FALSE EQUALS NOTHING
#ASSERT `s 769 the interim release provisions of Parts XVI, XXI and XXVII apply in respect of the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 769 the interim release provisions of Parts XVI, XXI and XXVII apply in respect of the person` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 769 the interim release provisions of Parts XVI, XXI and XXVII apply in respect of the person` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 769 the person shall forthwith be taken before a justice or judge` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 769 the person shall forthwith be taken before a justice or judge` FALSE TRUE EQUALS JUST FALSE

§ `s 770: default to be endorsed`

#ASSERT `s 770(1) the court, provincial court judge or justice shall endorse or cause to be endorsed a certificate` `an undertaking` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 770(1) the court, provincial court judge or justice shall endorse or cause to be endorsed a certificate` `a recognizance` FALSE TRUE TRUE EQUALS JUST FALSE   -- not in proceedings to which this Act applies
#ASSERT `s 770(1) the court, provincial court judge or justice shall endorse or cause to be endorsed a certificate` `a recognizance` TRUE FALSE TRUE EQUALS JUST FALSE   -- the person complied
#ASSERT `s 770(1) the court, provincial court judge or justice shall endorse or cause to be endorsed a certificate` `a recognizance` TRUE TRUE FALSE EQUALS JUST FALSE   -- the court has no knowledge of the facts
#ASSERT `s 770(1) the court, provincial court judge or justice shall endorse or cause to be endorsed a certificate` `a summons` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 770(1) the certificate is as the subsection requires` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 770(1) the certificate is as the subsection requires` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE   -- the reason is not known, so it need not be set out
#ASSERT `s 770(1) the certificate is as the subsection requires` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- the reason is known and not set out
#ASSERT `s 770(1) the certificate is as the subsection requires` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- not in Form 33
#ASSERT `s 770(1) the certificate is as the subsection requires` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- (a) missing
#ASSERT `s 770(1) the certificate is as the subsection requires` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- (c) missing
#ASSERT `s 770(1) the certificate is as the subsection requires` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- (d) missing
#TRACE `s 770(1) the duty of the court, provincial court judge or justice to endorse the certificate` AT 0 WITH
    PARTY `the court` DOES `s 770(1) endorse or cause to be endorsed a certificate in Form 33 on the undertaking, release order or recognizance` AT 0

#ASSERT `s 770(2) the document is sent to the clerk of the court as it must be` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 770(2) the document is sent to the clerk of the court as it must be` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 770(2) the document is sent to the clerk of the court as it must be` FALSE TRUE EQUALS JUST FALSE   -- "Once endorsed"
#ASSERT `s 770(2) the clerk keeps the document with the records of the court as they shall` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 770(2) the clerk keeps the document with the records of the court as they shall` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 770(2) the clerk keeps the document with the records of the court as they shall` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 770(3) the certificate is evidence of the default to which it relates` TRUE EQUALS JUST TRUE
#ASSERT `s 770(3) the certificate is evidence of the default to which it relates` FALSE EQUALS NOTHING
#ASSERT `s 770(4) the money is sent to the clerk of the court with the defaulted document as it must be` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 770(4) the money is sent to the clerk of the court with the defaulted document as it must be` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 770(4) the money is sent to the clerk of the court with the defaulted document as it must be` FALSE FALSE EQUALS JUST FALSE   -- no deposit

§ `s 771: proceedings in case of default`

#ASSERT `s 771(1)(a) a judge of the court shall fix a time and place for the hearing of an application for forfeiture` TRUE `s 771(1)(a) the clerk of the court` EQUALS JUST TRUE
#ASSERT `s 771(1)(a) a judge of the court shall fix a time and place for the hearing of an application for forfeiture` TRUE `s 771(1)(a) the Attorney General` EQUALS JUST TRUE
#ASSERT `s 771(1)(a) a judge of the court shall fix a time and place for the hearing of an application for forfeiture` TRUE `s 771(1)(a) counsel acting on the Attorney General's or counsel's behalf` EQUALS JUST TRUE
#ASSERT `s 771(1)(a) a judge of the court shall fix a time and place for the hearing of an application for forfeiture` TRUE `s 771(1)(a) another person` EQUALS NOTHING
#ASSERT `s 771(1)(a) a judge of the court shall fix a time and place for the hearing of an application for forfeiture` FALSE `s 771(1)(a) the clerk of the court` EQUALS JUST FALSE   -- not yet endorsed and received
#ASSERT `s 771(1)(b) the clerk of the court sends the notice as the paragraph requires` 10 TRUE TRUE TRUE EQUALS JUST TRUE   -- exactly ten days
#ASSERT `s 771(1)(b) the clerk of the court sends the notice as the paragraph requires` 9 TRUE TRUE TRUE EQUALS JUST FALSE   -- nine days is less than ten
#ASSERT `s 771(1)(b) the clerk of the court sends the notice as the paragraph requires` 30 FALSE TRUE TRUE EQUALS JUST FALSE   -- neither registered mail nor served as directed
#ASSERT `s 771(1)(b) the clerk of the court sends the notice as the paragraph requires` 30 TRUE FALSE TRUE EQUALS JUST FALSE   -- not to each principal and surety at the address in the certificate
#ASSERT `s 771(1)(b) the clerk of the court sends the notice as the paragraph requires` 30 TRUE TRUE FALSE EQUALS JUST FALSE   -- a notice that does not require the person to appear to show cause
#TRACE `s 771(1)(b) the clerk of the court's duty to send the notice` 15 AT 0 WITH
    PARTY `the clerk of the court` DOES `s 771(1)(b) send or have served on each principal and surety a notice requiring the person to appear to show cause why the amount should not be forfeited` AT 5

#TRACE `s 771(1)(b) the clerk of the court's duty to send the notice` 15 AT 0 WITH
    PARTY `the clerk of the court` DOES `s 771(1)(b) send or have served on each principal and surety a notice requiring the person to appear to show cause why the amount should not be forfeited` AT 6

#ASSERT `s 771(2) the judge may take this course` TRUE TRUE `s 771(2) grant the application` EQUALS JUST TRUE
#ASSERT `s 771(2) the judge may take this course` TRUE TRUE `s 771(2) refuse the application` EQUALS JUST TRUE
#ASSERT `s 771(2) the judge may take this course` TRUE TRUE `s 771(2) make an order with respect to the forfeiture of the amount that the judge considers proper` EQUALS JUST TRUE
#ASSERT `s 771(2) the judge may take this course` TRUE TRUE `s 771(2) a course the subsection does not name` EQUALS NOTHING
#ASSERT `s 771(2) the judge may take this course` TRUE FALSE `s 771(2) grant the application` EQUALS JUST FALSE   -- the parties have not been given an opportunity to be heard
#ASSERT `s 771(2) the judge may take this course` FALSE TRUE `s 771(2) grant the application` EQUALS NOTHING   -- subsection (1) not complied with: a grant limited by an "if", not covered
#ASSERT `s 771(2) the judge may take this course` FALSE FALSE `s 771(2) grant the application` EQUALS JUST FALSE
#ASSERT `s 771(3) the principal and their sureties become judgment debtors of the Crown` TRUE EQUALS JUST TRUE
#ASSERT `s 771(3) the principal and their sureties become judgment debtors of the Crown` FALSE EQUALS JUST FALSE
#ASSERT `s 771(3.1) the order may be filed with the clerk of the superior court` TRUE EQUALS JUST TRUE
#ASSERT `s 771(3.1) the order may be filed with the clerk of the superior court` FALSE EQUALS NOTHING
#ASSERT `s 771(3.1) the clerk shall issue a writ of fieri facias and deliver it to the sheriff of this territorial division` TRUE `s 771(3.1) the principal or a surety resides there` EQUALS JUST TRUE
#ASSERT `s 771(3.1) the clerk shall issue a writ of fieri facias and deliver it to the sheriff of this territorial division` TRUE `s 771(3.1) the principal or a surety carries on business there` EQUALS JUST TRUE
#ASSERT `s 771(3.1) the clerk shall issue a writ of fieri facias and deliver it to the sheriff of this territorial division` TRUE `s 771(3.1) the principal or a surety has property there` EQUALS JUST TRUE
#ASSERT `s 771(3.1) the clerk shall issue a writ of fieri facias and deliver it to the sheriff of this territorial division` TRUE `s 771(3.1) none of those` EQUALS NOTHING
#ASSERT `s 771(3.1) the clerk shall issue a writ of fieri facias and deliver it to the sheriff of this territorial division` FALSE `s 771(3.1) the principal or a surety resides there` EQUALS JUST FALSE   -- no order filed
#TRACE `s 771(3.1) the clerk's duty to issue and deliver the writ` AT 0 WITH
    PARTY `the clerk of the court` DOES `s 771(3.1) issue a writ of fieri facias in Form 34 and deliver it to the sheriff of each territorial division` AT 0

#ASSERT `s 771(4) no writ of fieri facias may be issued` TRUE EQUALS JUST TRUE
#ASSERT `s 771(4) no writ of fieri facias may be issued` FALSE EQUALS JUST FALSE
#ASSERT `s 771(4) the deposit is transferred to the person entitled by law to receive it as it must be` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 771(4) the deposit is transferred to the person entitled by law to receive it as it must be` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 771(4) the deposit is transferred to the person entitled by law to receive it as it must be` FALSE TRUE EQUALS JUST FALSE

§ `s 772: levy under the writ`

#ASSERT `s 772(1) the sheriff executes the writ and deals with the proceeds as the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 772(1) the sheriff executes the writ and deals with the proceeds as the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 772(1) the sheriff executes the writ and deals with the proceeds as the subsection requires` FALSE TRUE EQUALS JUST FALSE
#TRACE `s 772(1) the sheriff's duty to execute the writ` AT 0 WITH
    PARTY `s 772 the sheriff to whom the writ is delivered` DOES `s 772(1) execute the writ and deal with the proceeds in the same manner as in civil proceedings in the province` AT 0

#ASSERT `s 772(2) the Crown is entitled to the costs of execution and of proceedings incidental thereto` TRUE EQUALS JUST TRUE
#ASSERT `s 772(2) the Crown is entitled to the costs of execution and of proceedings incidental thereto` FALSE EQUALS JUST FALSE
#ASSERT `s 772(2) the tariff that fixes the costs` Quebec EQUALS JUST `s 772(2) the tariff applicable in the Superior Court in civil proceedings (the Province of Quebec)`
#ASSERT `s 772(2) the tariff that fixes the costs` Ontario EQUALS JUST `s 772(2) the tariff applicable in the superior court of the province in civil proceedings (any other province)`
#ASSERT `s 772(2) the tariff that fixes the costs` `Nova Scotia` EQUALS JUST `s 772(2) the tariff applicable in the superior court of the province in civil proceedings (any other province)`
#ASSERT `s 772(2) the tariff that fixes the costs` `British Columbia` EQUALS JUST `s 772(2) the tariff applicable in the superior court of the province in civil proceedings (any other province)`
#ASSERT `s 772(2) the tariff that fixes the costs` `Prince Edward Island` EQUALS JUST `s 772(2) the tariff applicable in the superior court of the province in civil proceedings (any other province)`
#ASSERT `s 772(2) the tariff that fixes the costs` `Newfoundland and Labrador` EQUALS JUST `s 772(2) the tariff applicable in the superior court of the province in civil proceedings (any other province)`
#ASSERT `s 772(2) the tariff that fixes the costs` `New Brunswick` EQUALS JUST `s 772(2) the tariff applicable in the superior court of the province in civil proceedings (any other province)`
#ASSERT `s 772(2) the tariff that fixes the costs` Manitoba EQUALS JUST `s 772(2) the tariff applicable in the superior court of the province in civil proceedings (any other province)`
#ASSERT `s 772(2) the tariff that fixes the costs` Saskatchewan EQUALS JUST `s 772(2) the tariff applicable in the superior court of the province in civil proceedings (any other province)`
#ASSERT `s 772(2) the tariff that fixes the costs` Alberta EQUALS JUST `s 772(2) the tariff applicable in the superior court of the province in civil proceedings (any other province)`
#ASSERT `s 772(2) the tariff that fixes the costs` Yukon EQUALS NOTHING   -- a territory is not a province
#ASSERT `s 772(2) the tariff that fixes the costs` `Northwest Territories` EQUALS NOTHING
#ASSERT `s 772(2) the tariff that fixes the costs` Nunavut EQUALS NOTHING

§ `s 773: committal when a writ is not satisfied`

#ASSERT `s 773(1) a judge of the court may fix a time and place for the sureties to show cause` TRUE TRUE FALSE TRUE EQUALS JUST TRUE   -- goods cannot be found
#ASSERT `s 773(1) a judge of the court may fix a time and place for the sureties to show cause` TRUE FALSE TRUE TRUE EQUALS JUST TRUE   -- the proceeds are not sufficient
#ASSERT `s 773(1) a judge of the court may fix a time and place for the sureties to show cause` TRUE FALSE FALSE TRUE EQUALS JUST FALSE   -- neither appears from the certificate
#ASSERT `s 773(1) a judge of the court may fix a time and place for the sureties to show cause` FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- no writ issued
#ASSERT `s 773(1) a judge of the court may fix a time and place for the sureties to show cause` TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- "upon the application of the Attorney General or counsel"
#ASSERT `s 773(2) the number of clear days of notice` (Date 1 3 2021) (Date 9 3 2021) EQUALS 7   -- 2 to 8 March are seven clear days
#ASSERT `s 773(2) the notice given to the sureties is seven clear days notice` (Date 1 3 2021) (Date 9 3 2021) EQUALS JUST TRUE
#ASSERT `s 773(2) the notice given to the sureties is seven clear days notice` (Date 1 3 2021) (Date 8 3 2021) EQUALS JUST FALSE   -- six clear days
#ASSERT `s 773(2) the notice given to the sureties is seven clear days notice` (Date 25 2 2021) (Date 5 3 2021) EQUALS JUST TRUE   -- 26, 27, 28 February and 1, 2, 3, 4 March are seven clear days (2021 is not a leap year)
#ASSERT `s 773(2) the notice given to the sureties is seven clear days notice` (Date 25 2 2021) (Date 4 3 2021) EQUALS JUST FALSE
#ASSERT `s 773(3) the judge inquires into the circumstances of the case as the judge shall` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 773(3) the judge inquires into the circumstances of the case as the judge shall` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 773(3) the judge inquires into the circumstances of the case as the judge shall` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 773(3) the judge may make this order in their discretion` TRUE `s 773(3)(a) order the discharge of the amount for which the surety is liable` EQUALS JUST TRUE
#ASSERT `s 773(3) the judge may make this order in their discretion` TRUE `s 773(3)(b) make an order with respect to the surety and to the surety's imprisonment that the judge considers proper and issue a warrant of committal in Form 27` EQUALS JUST TRUE
#ASSERT `s 773(3) the judge may make this order in their discretion` TRUE `s 773(3) an order the subsection does not name` EQUALS NOTHING
#ASSERT `s 773(3) the judge may make this order in their discretion` FALSE `s 773(3)(a) order the discharge of the amount for which the surety is liable` EQUALS JUST FALSE   -- not at the hearing held pursuant to subsection (1)
#ASSERT `s 773(4) the warrant authorizes the sheriff to confine the person in this prison` TRUE `s 773(4) a prison in the territorial division in which the writ was issued` FALSE EQUALS JUST TRUE
#ASSERT `s 773(4) the warrant authorizes the sheriff to confine the person in this prison` TRUE `s 773(4) the prison nearest to the court` FALSE EQUALS JUST TRUE
#ASSERT `s 773(4) the warrant authorizes the sheriff to confine the person in this prison` TRUE `s 773(4) another prison` FALSE EQUALS NOTHING
#ASSERT `s 773(4) the warrant authorizes the sheriff to confine the person in this prison` TRUE `s 773(4) the prison nearest to the court` TRUE EQUALS JUST FALSE   -- "until satisfaction is made or until the period of imprisonment fixed by the judge has expired"
#ASSERT `s 773(4) the warrant authorizes the sheriff to confine the person in this prison` FALSE `s 773(4) the prison nearest to the court` FALSE EQUALS NOTHING
#ASSERT `s 773(5) the person is the Attorney General for the purposes of section 771 and this section` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 773(5) the person is the Attorney General for the purposes of section 771 and this section` (JUST TRUE) FALSE EQUALS JUST FALSE   -- where 734.4(2) applies, "means" the Attorney General of Canada
#ASSERT `s 773(5) the person is the Attorney General for the purposes of section 771 and this section` (JUST FALSE) TRUE EQUALS NOTHING   -- 734.4(2) does not apply: the subsection gives no meaning
#ASSERT `s 773(5) the person is the Attorney General for the purposes of section 771 and this section` NOTHING TRUE EQUALS NOTHING
