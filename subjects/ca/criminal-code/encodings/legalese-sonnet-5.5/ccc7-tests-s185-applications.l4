IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc7-s183-base`
IMPORT `ccc7-s183-offence`
IMPORT `ccc7-s185-applications`

-- ccc7-tests-s185-applications.l4 -- tests for ccc7-s185-applications.l4 (section 185). Expected values are written by hand from the text, beside each assertion.

§ `Tests -- section 185(1.1)`

GIVEN statute IS A `s 183 statute`
      n IS A NUMBER
      sub IS A STRING
GIVETH A `s 183 provision of an Act`
`s 185 test provision` MEANS `s 183 provision of an Act` WITH `statute` IS statute, `section` IS n, `subsection` IS sub

-- args: the offence the application is in relation to, committed for the benefit of a group, the group is a criminal organization (s 2), the offence is a terrorism offence (s 2)
-- (a): an offence under section 52, 52.1, 52.2, 467.11, 467.111, 467.12 or 467.13 of the Criminal Code
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 52 "") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 52.1 "") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 52.2 "") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 467.11 "") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 467.111 "") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 467.12 "") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 467.13 "") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- neighbours of the list: 53, 51, 467.1 and 467.14 are not named
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 53 "") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 51 "") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 467.14 "") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- the same section number in another Act is not the Criminal Code section
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Cannabis Act` 52 "") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- (b.1): subsection 20(1), 20.1(1), 20.2(1), 20.3(1) or 20.4(1) of the Foreign Interference and Security of Information Act
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Foreign Interference and Security of Information Act` 20 "(1)") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Foreign Interference and Security of Information Act` 20.1 "(1)") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Foreign Interference and Security of Information Act` 20.2 "(1)") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Foreign Interference and Security of Information Act` 20.3 "(1)") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Foreign Interference and Security of Information Act` 20.4 "(1)") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- 20(2) is not named; section 21 is not named
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Foreign Interference and Security of Information Act` 20 "(2)") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Foreign Interference and Security of Information Act` 21 "(1)") FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- (b): an offence committed for the benefit of, at the direction of or in association with a criminal organization
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 380 "") TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
-- the group is not a criminal organization
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 380 "") TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- not committed for the benefit of any group
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 380 "") FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- whether the group is a criminal organization is for s 467.1(1) and is not covered: not covered, not "does not apply"
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 380 "") TRUE NOTHING (JUST FALSE) EQUALS NOTHING
-- (c): a terrorism offence
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 380 "") FALSE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 380 "") FALSE (JUST FALSE) NOTHING EQUALS NOTHING
-- a terrorism offence that is not covered does not defeat a limb that holds
#ASSERT `s 185(1.1) paragraph (1)(h) does not apply to the application` (`s 185 test provision` `s 183 the Criminal Code` 52 "") FALSE (JUST FALSE) NOTHING EQUALS JUST TRUE

§ `Tests -- section 185(1)`

-- args: ex parte, in writing, to a judge of a superior court of criminal jurisdiction or a judge as defined in 552, signatory, the offence is one the Government of Canada may prosecute,
-- affidavit, (c) facts and particulars, (d) type, (e) names and place and manner, (f) earlier applications, (g) period, (h) other investigative procedures, answer for (1.1)
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) the Attorney General of the province in which the application is made` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
-- the signatory: an agent designated by the Minister or Deputy Minister only if the offence is one the Government of Canada may prosecute ((a)); by the Attorney General or Deputy Attorney General of a province in any other case ((b))
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) an agent specially designated in writing by the Minister personally` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) an agent specially designated in writing by the Deputy Minister of Public Safety and Emergency Preparedness personally` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) an agent specially designated in writing by the Minister personally` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) an agent specially designated in writing by the Attorney General of a province personally` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) an agent specially designated in writing by the Deputy Attorney General of a province personally` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) an agent specially designated in writing by the Attorney General of a province personally` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) a person who is none of those` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
-- not ex parte; not in writing; not to such a judge; no affidavit; each of the matters (c) to (g) missing
#ASSERT `s 185(1) the application meets the requirements of the subsection` FALSE TRUE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE FALSE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE FALSE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE FALSE TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE TRUE FALSE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE TRUE TRUE FALSE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE TRUE TRUE TRUE FALSE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE TRUE TRUE TRUE TRUE FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
-- (h): other investigative procedures: required unless subsection (1.1) says it does not apply
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE TRUE TRUE TRUE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE TRUE TRUE TRUE TRUE TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
-- (1.1) is not covered: a deposed (h) matter still suffices; without it the answer is not covered
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 185(1) the application meets the requirements of the subsection` TRUE TRUE TRUE `s 185(1) the Minister of Public Safety and Emergency Preparedness` FALSE TRUE TRUE TRUE TRUE TRUE TRUE FALSE NOTHING EQUALS NOTHING

§ `Tests -- section 185(2) to (4)`

-- three years: 36 months is within the limit, 36 months and one day is not; 2 years 11 months is within it; 3 years less a day is within it
#ASSERT `s 185(2) the period does not exceed three years` (`Length of time` OF 3 , 0 , 0 , FALSE)
#ASSERT `s 185(2) the period does not exceed three years` (`Length of time` OF 2 , 11 , 30 , FALSE)
#ASSERT `s 185(2) the period does not exceed three years` (`Length of time` OF 3 , 0 , 0 , TRUE)
#ASSERT `s 185(2) the period does not exceed three years` (`Length of time` OF 0 , 36 , 0 , FALSE)
#ASSERT NOT (`s 185(2) the period does not exceed three years` (`Length of time` OF 3 , 0 , 1 , FALSE))
#ASSERT NOT (`s 185(2) the period does not exceed three years` (`Length of time` OF 3 , 1 , 0 , FALSE))
#ASSERT NOT (`s 185(2) the period does not exceed three years` (`Length of time` OF 0 , 37 , 0 , FALSE))
#ASSERT NOT (`s 185(2) the period does not exceed three years` (`Length of time` OF 4 , 0 , 0 , FALSE))
-- (2) args: personally signed by the Attorney General of the province or the Minister, asks for a longer period than 196(1), the longer period
#ASSERT `s 185(2) the application for an authorization may be accompanied by an application for a longer period for notification` TRUE TRUE (`Length of time` OF 3 , 0 , 0 , FALSE) EQUALS JUST TRUE
#ASSERT `s 185(2) the application for an authorization may be accompanied by an application for a longer period for notification` TRUE TRUE (`Length of time` OF 3 , 0 , 1 , FALSE) EQUALS NOTHING
#ASSERT `s 185(2) the application for an authorization may be accompanied by an application for a longer period for notification` FALSE TRUE (`Length of time` OF 1 , 0 , 0 , FALSE) EQUALS NOTHING
#ASSERT `s 185(2) the application for an authorization may be accompanied by an application for a longer period for notification` TRUE FALSE (`Length of time` OF 0 , 0 , 90 , FALSE) EQUALS NOTHING
-- (3) args: accompanied by an application referred to in (2), the judge is of the opinion that the interests of justice warrant the granting
#ASSERT `s 185(3) the judge is bound to fix a period in substitution for the period mentioned in subsection 196(1)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 185(3) the judge is bound to fix a period in substitution for the period mentioned in subsection 196(1)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 185(3) the judge is bound to fix a period in substitution for the period mentioned in subsection 196(1)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 185(3) the period the judge fixes is within the limit` (`Length of time` OF 3 , 0 , 0 , FALSE) EQUALS JUST TRUE
#ASSERT `s 185(3) the period the judge fixes is within the limit` (`Length of time` OF 3 , 0 , 1 , FALSE) EQUALS JUST FALSE
-- (4) args: the judge refused to fix a period, the judge fixed a shorter period than the one asked for
#ASSERT `s 185(4) the person submitting the application for the authorization may withdraw it` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 185(4) the person submitting the application for the authorization may withdraw it` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 185(4) the person submitting the application for the authorization may withdraw it` FALSE FALSE EQUALS NOTHING
#ASSERT `s 185(4) the judge shall not proceed to consider the application or to give the authorization` TRUE EQUALS JUST TRUE
#ASSERT `s 185(4) the judge shall not proceed to consider the application or to give the authorization` FALSE EQUALS JUST FALSE
#ASSERT `s 185(4) the judge is bound to destroy, or return to the person who submitted them, both applications and all other material` TRUE EQUALS JUST TRUE
#ASSERT `s 185(4) the judge is bound to destroy, or return to the person who submitted them, both applications and all other material` FALSE EQUALS JUST FALSE

-- assertions written: 71; assertions satisfied: 71 (l4 1.6.110 and 1.6.109, check.sh, 2026-11-13)
