IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc3-proceedings`

-- ccc3-tests-proceedings.l4 -- tests of sections 83.24 to 83.29. Expected values are hand-written from the text beside each assertion.

§ `Tests of sections 83.24 to 83.29`

-- ---- 83.24. Arguments: terrorism offence (s 2), an offence under 83.12, the Attorney General has consented.
#ASSERT `s 83.24 the proceedings are barred from being commenced` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE   -- a terrorism offence, no consent
#ASSERT `s 83.24 the proceedings are barred from being commenced` (JUST FALSE) TRUE FALSE EQUALS JUST TRUE   -- an offence under section 83.12, no consent
#ASSERT `s 83.24 the proceedings are barred from being commenced` (JUST TRUE) FALSE TRUE EQUALS NOTHING   -- with consent: the bar says nothing
#ASSERT `s 83.24 the proceedings are barred from being commenced` (JUST FALSE) FALSE FALSE EQUALS NOTHING   -- neither a terrorism offence nor an offence under 83.12
#ASSERT `s 83.24 the proceedings are barred from being commenced` NOTHING FALSE FALSE EQUALS NOTHING
-- ---- 83.25.
#ASSERT `s 83.25(1) the proceedings may be commenced at the instance of the Government of Canada` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 83.25(1) the proceedings may be commenced at the instance of the Government of Canada` (JUST FALSE) TRUE TRUE EQUALS JUST TRUE   -- an offence under 83.12
#ASSERT `s 83.25(1) the proceedings may be commenced at the instance of the Government of Canada` (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- the offence is not alleged to have occurred outside the province
#ASSERT `s 83.25(1) the proceedings may be commenced at the instance of the Government of Canada` (JUST FALSE) FALSE TRUE EQUALS JUST FALSE   -- "Where": not a terrorism offence nor an offence under 83.12
#ASSERT `s 83.25(1) the proceedings may be commenced at the instance of the Government of Canada` NOTHING FALSE TRUE EQUALS NOTHING
#ASSERT `s 83.25(2) the accused may be tried and punished as if the offence had been committed in the territorial division` TRUE EQUALS JUST TRUE
#ASSERT `s 83.25(2) the accused may be tried and punished as if the offence had been committed in the territorial division` FALSE EQUALS NOTHING
-- ---- 83.26(a): arguments: the offence, the sentence is life, the other punishment is life, same event or series of events.
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.02, "") FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.04, "") FALSE FALSE TRUE EQUALS JUST TRUE   -- the last of "83.02 to 83.04"
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.03, "(2)") FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.031, "") FALSE FALSE TRUE EQUALS JUST TRUE   -- 83.031 lies between 83.02 and 83.04 (a decimal range)
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.05, "") FALSE FALSE TRUE EQUALS NOTHING   -- just after 83.04
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.18, "(1)") FALSE FALSE TRUE EQUALS JUST TRUE   -- the first of "83.18 to 83.23"
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.181, "") FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.222, "(1)") FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.23, "(1)") FALSE FALSE TRUE EQUALS JUST TRUE   -- the last of "83.18 to 83.23"
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.231, "(1)") FALSE FALSE TRUE EQUALS NOTHING   -- the hoax offence is NOT within "83.18 to 83.23"
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.17, "") FALSE FALSE TRUE EQUALS NOTHING   -- just before 83.18
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.12, "(1)") FALSE FALSE TRUE EQUALS NOTHING   -- an offence under 83.12 is not in the list
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.02, "") TRUE FALSE TRUE EQUALS JUST FALSE   -- a life sentence is excluded
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.02, "") FALSE TRUE TRUE EQUALS JUST FALSE   -- the other punishment is life
#ASSERT `s 83.26(a) the sentence is to be served consecutively to the other punishment` (`Provision of the Code` OF 83.02, "") FALSE FALSE FALSE EQUALS NOTHING   -- not an offence arising out of the same event or series of events
-- ---- 83.26(b): arguments: the offence, the sentence is life, the other sentence is life, subject to it at the time, the other sentence is for an offence under those sections.
#ASSERT `s 83.26(b) the sentence is to be served consecutively to the other sentence` (`Provision of the Code` OF 83.18, "(1)") FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.26(b) the sentence is to be served consecutively to the other sentence` (`Provision of the Code` OF 83.231, "(1)") FALSE FALSE TRUE TRUE EQUALS NOTHING   -- 83.231 is outside the list
#ASSERT `s 83.26(b) the sentence is to be served consecutively to the other sentence` (`Provision of the Code` OF 83.18, "(1)") TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 83.26(b) the sentence is to be served consecutively to the other sentence` (`Provision of the Code` OF 83.18, "(1)") FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 83.26(b) the sentence is to be served consecutively to the other sentence` (`Provision of the Code` OF 83.18, "(1)") FALSE FALSE FALSE TRUE EQUALS NOTHING   -- not subject to the other sentence at the time
#ASSERT `s 83.26(b) the sentence is to be served consecutively to the other sentence` (`Provision of the Code` OF 83.18, "(1)") FALSE FALSE TRUE FALSE EQUALS NOTHING   -- the other sentence is not for an offence under those sections
-- ---- 83.27. Arguments: convicted of an indictable offence, life is the minimum punishment, the act also constitutes a terrorist activity.
#ASSERT `s 83.27(1) the person is liable to imprisonment for life` TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 83.27(1) the person is liable to imprisonment for life` FALSE FALSE (JUST TRUE) EQUALS NOTHING   -- not convicted of an indictable offence
#ASSERT `s 83.27(1) the person is liable to imprisonment for life` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE   -- "other than an offence for which ... life ... as a minimum punishment"
#ASSERT `s 83.27(1) the person is liable to imprisonment for life` TRUE FALSE (JUST FALSE) EQUALS JUST FALSE   -- the act is not also a terrorist activity
#ASSERT `s 83.27(1) the person is liable to imprisonment for life` TRUE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 83.27(1) the punishment the person is liable to`'s `maximum imprisonment` EQUALS `imprisonment for life`
#ASSERT `s 83.27(2) subsection (1) does not apply` FALSE EQUALS JUST TRUE   -- no notice before the plea
#ASSERT `s 83.27(2) subsection (1) does not apply` TRUE EQUALS NOTHING   -- notified: the "unless" is met
#ASSERT `s 83.27 the person is liable to imprisonment for life, subject to subsection (2)` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 83.27 the person is liable to imprisonment for life, subject to subsection (2)` (JUST TRUE) FALSE EQUALS JUST FALSE   -- not notified before the plea
#ASSERT `s 83.27 the person is liable to imprisonment for life, subject to subsection (2)` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 83.27 the person is liable to imprisonment for life, subject to subsection (2)` NOTHING TRUE EQUALS NOTHING
