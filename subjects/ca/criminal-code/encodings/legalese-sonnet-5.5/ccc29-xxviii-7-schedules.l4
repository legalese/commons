        IF `the provision`'s `section` EQUALS 362 THEN JUST TRUE   -- (m) line 17365
        IF `the provision`'s `section` EQUALS 363 THEN JUST TRUE   -- (n) line 17366
        IF `the provision`'s `section` EQUALS 366 THEN JUST TRUE   -- (o) line 17367
        IF `the provision`'s `section` EQUALS 368 THEN JUST TRUE   -- (p) line 17368
        IF `the provision`'s `section` EQUALS 375 THEN JUST TRUE   -- (q) line 17369
        IF `the provision`'s `section` EQUALS 378 THEN JUST TRUE   -- (r) line 17370
        IF `the provision`'s `section` EQUALS 380 THEN JUST TRUE   -- (s) line 17371
        IF `the provision`'s `section` EQUALS 382 THEN JUST TRUE   -- (t) line 17372
        IF `the provision`'s `section` EQUALS 382.1 THEN JUST TRUE   -- (u) line 17373
        IF `the provision`'s `section` EQUALS 383 THEN JUST TRUE   -- (v) line 17374
        IF `the provision`'s `section` EQUALS 389 THEN JUST TRUE   -- (w) line 17375
        IF `the provision`'s `section` EQUALS 390 THEN JUST TRUE   -- (x) line 17376
        IF `the provision`'s `section` EQUALS 391 THEN JUST TRUE   -- (x.1) line 17377
        IF `the provision`'s `section` EQUALS 392 THEN JUST TRUE   -- (y) line 17378
        IF `the provision`'s `section` EQUALS 397 THEN JUST TRUE   -- (z) line 17379
        IF `the provision`'s `section` EQUALS 400 THEN JUST TRUE   -- (z.1) line 17380
        IF `the provision`'s `section` EQUALS 418 THEN JUST TRUE   -- (z.2) line 17381
        IF `the provision`'s `section` EQUALS 426 THEN JUST TRUE   -- (z.3) line 17382
        IF `the provision`'s `section` EQUALS 462.31 THEN JUST TRUE   -- (z.4) line 17383
        OTHERWISE NOTHING   -- NOTHING-kind (list not closed): the schedule lists provisions and does not say that no other offence is covered

@ref Criminal Code sch XXII.1 para 1 to sch XXII.1 para 1(z.4) (src:17352-17383)
GIVEN `the provision` IS A `Provision of the Code`
GIVETH A MAYBE STRING
`sch XXII.1 para 1 the words of the entry that names the provision` MEANS
    BRANCH
        IF `the provision`'s `section` EQUALS 119 OR `the provision`'s `section` EQUALS 120 THEN JUST "(a) section 119 or 120 (bribery of officers);"   -- line 17353
        IF `the provision`'s `section` EQUALS 121 THEN JUST "(b) section 121 (frauds on the government);"   -- line 17354
        IF `the provision`'s `section` EQUALS 123 THEN JUST "(c) section 123 (municipal corruption);"   -- line 17355
        IF `the provision`'s `section` EQUALS 124 THEN JUST "(d) section 124 (selling or purchasing office);"   -- line 17356
        IF `the provision`'s `section` EQUALS 125 THEN JUST "(e) section 125 (influencing or negotiating appointments or dealing in offices);"   -- line 17357
        IF (`the provision`'s `section` EQUALS 139 AND `the provision`'s `subsection` EQUALS "(3)") THEN JUST "(f) subsection 139(3) (obstructing justice);"   -- line 17358
        IF `the provision`'s `section` EQUALS 322 THEN JUST "(g) section 322 (theft);"   -- line 17359
        IF `the provision`'s `section` EQUALS 330 THEN JUST "(h) section 330 (theft by person required to account);"   -- line 17360
        IF `the provision`'s `section` EQUALS 332 THEN JUST "(i) section 332 (misappropriation of money held under direction);"   -- line 17361
