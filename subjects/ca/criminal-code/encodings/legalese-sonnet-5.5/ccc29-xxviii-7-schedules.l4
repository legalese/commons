        IF `the provision`'s `section` EQUALS 390 THEN JUST "(x) section 390 (fraudulent receipts under Bank Act);"   -- line 17376
        IF `the provision`'s `section` EQUALS 391 THEN JUST "(x.1) section 391 (trade secret);"   -- line 17377
        IF `the provision`'s `section` EQUALS 392 THEN JUST "(y) section 392 (disposal of property to defraud creditors);"   -- line 17378
        IF `the provision`'s `section` EQUALS 397 THEN JUST "(z) section 397 (books and documents);"   -- line 17379
        IF `the provision`'s `section` EQUALS 400 THEN JUST "(z.1) section 400 (false prospectus);"   -- line 17380
        IF `the provision`'s `section` EQUALS 418 THEN JUST "(z.2) section 418 (selling defective stores to Her Majesty); and"   -- line 17381
