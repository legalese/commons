        IF `the provision`'s `section` EQUALS 362 THEN JUST "(m) section 362 (false pretence or false statement);"   -- line 17365
        IF `the provision`'s `section` EQUALS 363 THEN JUST "(n) section 363 (obtaining execution of valuable security by fraud);"   -- line 17366
        IF `the provision`'s `section` EQUALS 366 THEN JUST "(o) section 366 (forgery);"   -- line 17367
        IF `the provision`'s `section` EQUALS 368 THEN JUST "(p) section 368 (use, trafficking or possession of forged document);"   -- line 17368
        IF `the provision`'s `section` EQUALS 375 THEN JUST "(q) section 375 (obtaining by instrument based on forged document);"   -- line 17369
        IF `the provision`'s `section` EQUALS 378 THEN JUST "(r) section 378 (offences in relation to registers);"   -- line 17370
        IF `the provision`'s `section` EQUALS 380 THEN JUST "(s) section 380 (fraud);"   -- line 17371
        IF `the provision`'s `section` EQUALS 382 THEN JUST "(t) section 382 (fraudulent manipulation of stock exchange transactions);"   -- line 17372
