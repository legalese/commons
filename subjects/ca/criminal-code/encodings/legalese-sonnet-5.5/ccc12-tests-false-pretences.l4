IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc12-logic`
IMPORT `ccc12-tests-fixtures`
IMPORT `ccc12-part9-false-pretences`

-- Tests of ss 361 to 365. Expected values are hand-written from the text before each run. Arguments are positional, in the GIVEN order of each function.

§ `s 361 false pretence`
-- a representation of a matter of fact present or past, known by the maker to be false, made with a fraudulent intent to induce the person to act on it
#ASSERT `s 361(1) the representation is a false pretence` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 361(1) the representation is a false pretence` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 361(1) the representation is a false pretence` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 361(1) the representation is a false pretence` TRUE TRUE FALSE EQUALS JUST FALSE
-- (2): exaggerated commendation or depreciation, carried to the extent of a fraudulent misrepresentation
#ASSERT `s 361(2) the exaggerated commendation or depreciation is a false pretence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 361(2) the exaggerated commendation or depreciation is a false pretence` TRUE TRUE EQUALS NOTHING
#ASSERT `s 361(2) the exaggerated commendation or depreciation is a false pretence` FALSE FALSE EQUALS NOTHING
#ASSERT `s 361(2) the exaggerated commendation or depreciation is a false pretence` FALSE TRUE EQUALS NOTHING
#ASSERT `s 361(3) the question is a question of fact` TRUE EQUALS JUST TRUE
#ASSERT `s 361(3) the question is a question of fact` FALSE EQUALS NOTHING

§ `s 362 false pretence or false statement`
-- (a): obtains anything in respect of which theft may be committed or causes it to be delivered; the means is a false pretence (s 361(1))
#ASSERT `s 362(1)(a) the person commits the offence of obtaining a thing by a false pretence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 362(1)(a) the person commits the offence of obtaining a thing by a false pretence` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 362(1)(a) the person commits the offence of obtaining a thing by a false pretence` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 362(1)(a) the person commits the offence of obtaining a thing by a false pretence` FALSE (JUST TRUE) EQUALS JUST FALSE
-- (b): obtains credit; by a false pretence (s 361(1)); by fraud
#ASSERT `s 362(1)(b) the person commits the offence of obtaining credit by a false pretence or by fraud` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 362(1)(b) the person commits the offence of obtaining credit by a false pretence or by fraud` TRUE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 362(1)(b) the person commits the offence of obtaining credit by a false pretence or by fraud` TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 362(1)(b) the person commits the offence of obtaining credit by a false pretence or by fraud` TRUE NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 362(1)(b) the person commits the offence of obtaining credit by a false pretence or by fraud` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 362(1)(b) the person commits the offence of obtaining credit by a false pretence or by fraud` FALSE (JUST TRUE) TRUE EQUALS JUST FALSE
-- (c): knowingly makes a false statement in writing, with intent that it be relied on, about financial condition or means, for the purpose of procuring one of (i) to (vi)
#ASSERT `s 362(1)(c) the person commits the offence of making a false statement in writing about financial condition or means to procure a benefit` TRUE TRUE TRUE `s 362(1)(c)(i) the delivery of personal property` EQUALS JUST TRUE
#ASSERT `s 362(1)(c) the person commits the offence of making a false statement in writing about financial condition or means to procure a benefit` TRUE TRUE TRUE `s 362(1)(c)(ii) the payment of money` EQUALS JUST TRUE
#ASSERT `s 362(1)(c) the person commits the offence of making a false statement in writing about financial condition or means to procure a benefit` TRUE TRUE TRUE `s 362(1)(c)(iii) the making of a loan` EQUALS JUST TRUE
#ASSERT `s 362(1)(c) the person commits the offence of making a false statement in writing about financial condition or means to procure a benefit` TRUE TRUE TRUE `s 362(1)(c)(iv) the grant or extension of credit` EQUALS JUST TRUE
#ASSERT `s 362(1)(c) the person commits the offence of making a false statement in writing about financial condition or means to procure a benefit` TRUE TRUE TRUE `s 362(1)(c)(v) the discount of an account receivable` EQUALS JUST TRUE
#ASSERT `s 362(1)(c) the person commits the offence of making a false statement in writing about financial condition or means to procure a benefit` TRUE TRUE TRUE `s 362(1)(c)(vi) the making, accepting, discounting or endorsing of a bill of exchange, cheque, draft or promissory note` EQUALS JUST TRUE
#ASSERT `s 362(1)(c) the person commits the offence of making a false statement in writing about financial condition or means to procure a benefit` TRUE TRUE TRUE `s 362(1)(c) none of those` EQUALS JUST FALSE
#ASSERT `s 362(1)(c) the person commits the offence of making a false statement in writing about financial condition or means to procure a benefit` FALSE TRUE TRUE `s 362(1)(c)(i) the delivery of personal property` EQUALS JUST FALSE
#ASSERT `s 362(1)(c) the person commits the offence of making a false statement in writing about financial condition or means to procure a benefit` TRUE FALSE TRUE `s 362(1)(c)(i) the delivery of personal property` EQUALS JUST FALSE
#ASSERT `s 362(1)(c) the person commits the offence of making a false statement in writing about financial condition or means to procure a benefit` TRUE TRUE FALSE `s 362(1)(c)(i) the delivery of personal property` EQUALS JUST FALSE
-- (d): knowing that a false statement in writing has been made, procures on the faith of it one of (i) to (vi)
#ASSERT `s 362(1)(d) the person commits the offence of procuring a benefit on the faith of a false statement in writing` TRUE `s 362(1)(c)(ii) the payment of money` EQUALS JUST TRUE
#ASSERT `s 362(1)(d) the person commits the offence of procuring a benefit on the faith of a false statement in writing` TRUE `s 362(1)(c)(vi) the making, accepting, discounting or endorsing of a bill of exchange, cheque, draft or promissory note` EQUALS JUST TRUE
#ASSERT `s 362(1)(d) the person commits the offence of procuring a benefit on the faith of a false statement in writing` TRUE `s 362(1)(c) none of those` EQUALS JUST FALSE
#ASSERT `s 362(1)(d) the person commits the offence of procuring a benefit on the faith of a false statement in writing` FALSE `s 362(1)(c)(ii) the payment of money` EQUALS JUST FALSE
-- (1) as a whole: one of paragraphs (a) to (d)
#ASSERT `s 362(1) the person commits the offence of false pretence or false statement` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 362(1) the person commits the offence of false pretence or false statement` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 362(1) the person commits the offence of false pretence or false statement` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 362(1) the person commits the offence of false pretence or false statement` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 362(1) the person commits the offence of false pretence or false statement` NOTHING (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- (2): the value of what is obtained, a testamentary instrument (s 2), the general penalty
#ASSERT `s 362(2) the punishment for an offence under paragraph (1)(a)` (JUST FALSE) 5000 `ccc12 fixture general summary penalty` EQUALS JUST (LIST `ccc12 fixture indictable, up to two years`, `ccc12 fixture general summary penalty`)
#ASSERT `s 362(2) the punishment for an offence under paragraph (1)(a)` (JUST FALSE) 5000.01 `ccc12 fixture general summary penalty` EQUALS JUST (LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`)
#ASSERT `s 362(2) the punishment for an offence under paragraph (1)(a)` (JUST TRUE) 20 `ccc12 fixture general summary penalty` EQUALS JUST (LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`)
#ASSERT `s 362(2) the punishment for an offence under paragraph (1)(a)` NOTHING 20 `ccc12 fixture general summary penalty` EQUALS NOTHING
#ASSERT `s 362(2) the punishment for an offence under paragraph (1)(a)` NOTHING 9000 `ccc12 fixture general summary penalty` EQUALS JUST (LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`)
#ASSERT `s 362(3) the punishment for an offence under paragraph (1)(b), (c) or (d)` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`
-- (4): the proceedings, a thing obtained by means of a cheque, dishonoured for want of funds, the court satisfied of a reasonable belief that it would be honoured
#ASSERT `s 362(4) the thing is presumed to have been obtained by a false pretence` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 362(4) the thing is presumed to have been obtained by a false pretence` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 362(4) the thing is presumed to have been obtained by a false pretence` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 362(4) the thing is presumed to have been obtained by a false pretence` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 362(4) the thing is presumed to have been obtained by a false pretence` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- (5): cheque includes
#ASSERT `s 362(5) the instrument is a cheque` `s 362(5) a cheque in its ordinary meaning` EQUALS JUST TRUE
#ASSERT `s 362(5) the instrument is a cheque` `s 362(5) a bill of exchange drawn on an institution that makes it a business practice to honour bills of exchange or any particular kind thereof drawn on it by depositors` EQUALS JUST TRUE
#ASSERT `s 362(5) the instrument is a cheque` `s 362(5) another instrument` EQUALS NOTHING

§ `ss 363 to 365`
-- 363: intent to defraud or injure, by a false pretence (s 361(1)), (a) causes or induces execution of a valuable security (s 2), (b) causes or induces a name or seal to be affixed
#ASSERT `s 363 the person commits the offence of obtaining execution of a valuable security by fraud` TRUE (JUST TRUE) TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 363 the person commits the offence of obtaining execution of a valuable security by fraud` TRUE (JUST TRUE) FALSE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 363 the person commits the offence of obtaining execution of a valuable security by fraud` TRUE (JUST TRUE) TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 363 the person commits the offence of obtaining execution of a valuable security by fraud` TRUE (JUST TRUE) FALSE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 363 the person commits the offence of obtaining execution of a valuable security by fraud` TRUE (JUST FALSE) TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 363 the person commits the offence of obtaining execution of a valuable security by fraud` FALSE (JUST TRUE) TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 363 the person commits the offence of obtaining execution of a valuable security by fraud` TRUE NOTHING TRUE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 363 the person commits the offence of obtaining execution of a valuable security by fraud` TRUE (JUST TRUE) TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 363 the person commits the offence of obtaining execution of a valuable security by fraud` TRUE (JUST TRUE) FALSE NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 363 the punishment for the offence` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to five years`, `ccc12 fixture general summary penalty`
-- 364(1): fraudulently obtains food, a beverage or accommodation at a place that is in that business; summary conviction only
#ASSERT `s 364(1) the person commits the offence of fraudulently obtaining food, beverage or accommodation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 364(1) the person commits the offence of fraudulently obtaining food, beverage or accommodation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 364(1) the person commits the offence of fraudulently obtaining food, beverage or accommodation` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 364(1) the punishment for the offence` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture general summary penalty`
-- 364(2): proceedings under s 364, obtained, did not pay, (a) false show of baggage, (b) false baggage, (c) removed baggage, (d) absconded, (e) false statement to obtain credit, (f) worthless cheque, evidence to the contrary
#ASSERT `s 364(2) the evidence is proof of fraud` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 364(2) the evidence is proof of fraud` TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 364(2) the evidence is proof of fraud` TRUE TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 364(2) the evidence is proof of fraud` TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 364(2) the evidence is proof of fraud` TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 364(2) the evidence is proof of fraud` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 364(2) the evidence is proof of fraud` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 364(2) the evidence is proof of fraud` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 364(2) the evidence is proof of fraud` FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 364(2) the evidence is proof of fraud` TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 364(2) the evidence is proof of fraud` TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 364(3) the instrument is a cheque` `s 364(3) a cheque in its ordinary meaning` EQUALS JUST TRUE
#ASSERT `s 364(3) the instrument is a cheque` `s 364(3) a bill of exchange drawn on an institution that makes it a business practice to honour bills of exchange or any particular kind thereof drawn on it by depositors` EQUALS JUST TRUE
#ASSERT `s 364(3) the instrument is a cheque` `s 364(3) another instrument` EQUALS NOTHING
#ASSERT `s 365 as the text shows it` EQUALS "365 [Repealed, 2018, c. 29, s. 41]"
