IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc23-verdict`

-- ccc23-tests-verdict.l4 -- tests for sections 672.34 to 672.37. Expected values are written from the text, never copied from the code.
-- Argument order is the order of the GIVEN lines in ccc23-verdict.l4.

§ `s 672.34 -- the verdict`
-- args: finds that the accused committed the act or made the omission; finds that the accused was suffering from mental disorder so as to be exempt under s 16(1)
#ASSERT `s 672.34 the jury or the judge must render a verdict of not criminally responsible on account of mental disorder` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.34 the jury or the judge must render a verdict of not criminally responsible on account of mental disorder` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.34 the jury or the judge must render a verdict of not criminally responsible on account of mental disorder` FALSE TRUE EQUALS JUST FALSE

§ `ss 672.35 and 672.36 -- effect of the verdict`
#ASSERT `s 672.35 the section bars a finding of guilt or a conviction of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 672.35 the section bars a finding of guilt or a conviction of the offence` FALSE EQUALS NOTHING
-- (a) args: verdict rendered; the subsequent charge relates to that offence
#ASSERT `s 672.35(a) the accused may plead autrefois acquit in respect of a subsequent charge relating to that offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.35(a) the accused may plead autrefois acquit in respect of a subsequent charge relating to that offence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.35(a) the accused may plead autrefois acquit in respect of a subsequent charge relating to that offence` FALSE TRUE EQUALS JUST FALSE
-- (b) args: verdict rendered; considering interim release; considering dispositions or sentence for any other offence
#ASSERT `s 672.35(b) any court may take the verdict into account` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.35(b) any court may take the verdict into account` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.35(b) any court may take the verdict into account` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.35(b) any court may take the verdict into account` FALSE TRUE TRUE EQUALS JUST FALSE
-- (c) args: verdict rendered; the parole board is considering the accused's application for parole or a record suspension for another offence
#ASSERT `s 672.35(c) the Parole Board of Canada or a provincial parole board may take the verdict into account` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.35(c) the Parole Board of Canada or a provincial parole board may take the verdict into account` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.35(c) the Parole Board of Canada or a provincial parole board may take the verdict into account` FALSE TRUE EQUALS JUST FALSE
-- 672.36 args: it is an NCR verdict; the offence is under an Act of Parliament with a greater punishment by reason of previous convictions. The text says it is NOT a previous conviction.
#ASSERT `s 672.36 the verdict is a previous conviction for the purposes of an offence that carries a greater punishment by reason of previous convictions` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.36 the verdict is a previous conviction for the purposes of an offence that carries a greater punishment by reason of previous convictions` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.36 the verdict is a previous conviction for the purposes of an offence that carries a greater punishment by reason of previous convictions` FALSE TRUE EQUALS NOTHING

§ `s 672.37 -- application for federal employment`
-- (1) args: an application form; (a) department; (b) Crown corporation; (c) Canadian Forces; (d) work, undertaking or business within the legislative authority of Parliament
#ASSERT `s 672.37(1) application for federal employment` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.37(1) application for federal employment` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.37(1) application for federal employment` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.37(1) application for federal employment` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.37(1) application for federal employment` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.37(1) application for federal employment` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- (2) args: application for federal employment (by (1)); the question asks about an NCR charge or finding; discharged absolutely; no longer subject to any disposition
#ASSERT `s 672.37(2) the section bars the application for federal employment from containing the question` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.37(2) the section bars the application for federal employment from containing the question` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST TRUE
-- still subject to a disposition and not discharged absolutely: the bar does not speak
#ASSERT `s 672.37(2) the section bars the application for federal employment from containing the question` (JUST TRUE) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.37(2) the section bars the application for federal employment from containing the question` (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.37(2) the section bars the application for federal employment from containing the question` (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.37(2) the section bars the application for federal employment from containing the question` NOTHING TRUE TRUE TRUE EQUALS NOTHING
-- (3) args: uses or authorizes the use; the application contravenes (2)
#ASSERT `s 672.37(3) the punishment of the person who uses or authorizes the use of a contravening application` TRUE TRUE EQUALS JUST (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 672.37(3) the punishment of the person who uses or authorizes the use of a contravening application` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.37(3) the punishment of the person who uses or authorizes the use of a contravening application` FALSE TRUE EQUALS NOTHING
