IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc27-s745-life-sentence`

-- ccc27-tests-s745.l4 -- tests for sections 745 to 745.52. Every expected value is written from the text, beside the assertion.

§ `Tests -- section 745`

`s 745 test a` MEANS `s 745(a) life, without eligibility for parole until twenty-five years of the sentence have been served`
`s 745 test b` MEANS `s 745(b) life, without eligibility for parole until twenty-five years have been served (second degree murder after a previous murder)`
`s 745 test b.1` MEANS `s 745(b.1) life, without eligibility for parole until twenty-five years have been served (second degree murder after a previous intentional killing under the Crimes Against Humanity and War Crimes Act)`
`s 745 test c` MEANS `s 745(c) life, without eligibility for parole until at least ten years have been served, or the greater number substituted under section 745.4`
`s 745 test c.1` MEANS `s 745(c.1) life, without eligibility for parole until at least 10 years have been served, or the greater number substituted under paragraph 745.52(1)(a)`
`s 745 test d` MEANS `s 745(d) life, with normal eligibility for parole`
`s 745 test 745.1` MEANS `s 745.1 the sentence is fixed by section 745.1`

-- args: kind; previous murder; previous intentional killing; manslaughter in 236(2); under 18
#ASSERT `s 745 the sentence for the kind of homicide offence` `first degree murder` FALSE FALSE FALSE FALSE EQUALS `s 745 test a`   -- (a) first degree murder
#ASSERT `s 745 the sentence for the kind of homicide offence` `first degree murder` FALSE FALSE FALSE TRUE EQUALS `s 745 test 745.1`   -- "Subject to section 745.1"
#ASSERT `s 745 the sentence for the kind of homicide offence` `second degree murder` TRUE FALSE FALSE FALSE EQUALS `s 745 test b`   -- (b): a previous murder
#ASSERT `s 745 the sentence for the kind of homicide offence` `second degree murder` FALSE TRUE FALSE FALSE EQUALS `s 745 test b.1`   -- (b.1): a previous intentional killing under the Crimes Against Humanity and War Crimes Act
#ASSERT `s 745 the sentence for the kind of homicide offence` `second degree murder` TRUE TRUE FALSE FALSE EQUALS `s 745 test b`   -- both: (b) comes first (the years are the same)
#ASSERT `s 745 the sentence for the kind of homicide offence` `second degree murder` FALSE FALSE FALSE FALSE EQUALS `s 745 test c`   -- (c)
#ASSERT `s 745 the sentence for the kind of homicide offence` `second degree murder` TRUE FALSE FALSE TRUE EQUALS `s 745 test 745.1`   -- under 18: section 745.1
#ASSERT `s 745 the sentence for the kind of homicide offence` `manslaughter` FALSE FALSE TRUE FALSE EQUALS `s 745 test c.1`   -- (c.1): manslaughter in the circumstances of paragraphs 236(2)(a) to (d)
#ASSERT `s 745 the sentence for the kind of homicide offence` `manslaughter` FALSE FALSE TRUE TRUE EQUALS `s 745 test 745.1`
#ASSERT `s 745 the sentence for the kind of homicide offence` `manslaughter` FALSE FALSE FALSE FALSE EQUALS `s 745 test d`   -- (d): any other offence
#ASSERT `s 745 the sentence for the kind of homicide offence` `manslaughter` FALSE FALSE FALSE TRUE EQUALS `s 745 test d`   -- manslaughter outside 236(2): section 745.1 does not name it
#ASSERT `s 745 the sentence for the kind of homicide offence` `infanticide` FALSE FALSE FALSE FALSE EQUALS `s 745 test d`
-- args: to be sentenced for life; high treason; neither high treason nor a kind of homicide offence; the kind; previous murder; previous intentional killing; 236(2); under 18
#ASSERT `s 745 the sentence to be pronounced` TRUE TRUE FALSE NOTHING FALSE FALSE FALSE FALSE EQUALS JUST `s 745 test a`   -- (a): high treason, whatever the kind
#ASSERT `s 745 the sentence to be pronounced` TRUE TRUE FALSE NOTHING FALSE FALSE FALSE TRUE EQUALS JUST `s 745 test a`   -- under 18 and high treason: section 745.1 does not name high treason
#ASSERT `s 745 the sentence to be pronounced` TRUE FALSE FALSE (JUST `first degree murder`) FALSE FALSE FALSE FALSE EQUALS JUST `s 745 test a`
#ASSERT `s 745 the sentence to be pronounced` TRUE FALSE FALSE (JUST `second degree murder`) FALSE FALSE FALSE FALSE EQUALS JUST `s 745 test c`
#ASSERT `s 745 the sentence to be pronounced` TRUE FALSE FALSE NOTHING FALSE FALSE FALSE FALSE EQUALS NOTHING   -- section 231 does not decide the kind
#ASSERT `s 745 the sentence to be pronounced` FALSE FALSE FALSE (JUST `second degree murder`) FALSE FALSE FALSE FALSE EQUALS NOTHING   -- not to be sentenced to life
#ASSERT `s 745 the sentence to be pronounced` TRUE FALSE TRUE NOTHING FALSE FALSE FALSE FALSE EQUALS JUST `s 745 test d`   -- (d): a life sentence for an offence that is neither high treason nor a homicide offence, whatever section 231 says
#ASSERT `s 745 the sentence to be pronounced` TRUE TRUE TRUE NOTHING FALSE FALSE FALSE FALSE EQUALS JUST `s 745 test a`   -- high treason first: (a)
#ASSERT `s 745 the years when a greater number may be substituted for ten` NOTHING EQUALS JUST 10   -- "at least ten years"
#ASSERT `s 745 the years when a greater number may be substituted for ten` (JUST 15) EQUALS JUST 15
#ASSERT `s 745 the years when a greater number may be substituted for ten` (JUST 25) EQUALS JUST 25   -- "not being more than twenty-five"
#ASSERT `s 745 the years when a greater number may be substituted for ten` (JUST 26) EQUALS NOTHING
#ASSERT `s 745 the years when a greater number may be substituted for ten` (JUST 10) EQUALS NOTHING   -- not a greater number
#ASSERT `s 745 the years of the sentence the person must serve before eligibility for parole` `s 745 test a` NOTHING NOTHING EQUALS JUST 25
#ASSERT `s 745 the years of the sentence the person must serve before eligibility for parole` `s 745 test b` NOTHING NOTHING EQUALS JUST 25
#ASSERT `s 745 the years of the sentence the person must serve before eligibility for parole` `s 745 test b.1` NOTHING NOTHING EQUALS JUST 25
#ASSERT `s 745 the years of the sentence the person must serve before eligibility for parole` `s 745 test c` NOTHING NOTHING EQUALS JUST 10
#ASSERT `s 745 the years of the sentence the person must serve before eligibility for parole` `s 745 test c` (JUST 18) NOTHING EQUALS JUST 18   -- substituted under section 745.4
#ASSERT `s 745 the years of the sentence the person must serve before eligibility for parole` `s 745 test c` NOTHING (JUST 18) EQUALS JUST 10   -- a number substituted under 745.52 does not touch paragraph (c)
#ASSERT `s 745 the years of the sentence the person must serve before eligibility for parole` `s 745 test c.1` NOTHING (JUST 20) EQUALS JUST 20   -- substituted under paragraph 745.52(1)(a)
#ASSERT `s 745 the years of the sentence the person must serve before eligibility for parole` `s 745 test c.1` NOTHING NOTHING EQUALS JUST 10
#ASSERT `s 745 the years of the sentence the person must serve before eligibility for parole` `s 745 test d` NOTHING NOTHING EQUALS NOTHING   -- normal eligibility: no number here
#ASSERT `s 745 the years of the sentence the person must serve before eligibility for parole` `s 745 test 745.1` NOTHING NOTHING EQUALS NOTHING

§ `Tests -- section 745.01`

#ASSERT `s 745.01(1) the judge shall state the information for the record` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 745.01(1) the judge shall state the information for the record` TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- "Except where subsection 745.6(2) applies"
#ASSERT `s 745.01(1) the judge shall state the information for the record` TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- subsection (2): an offence committed on or after the day it comes into force
#ASSERT `s 745.01(1) the judge shall state the information for the record` FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- not a sentencing under paragraph 745(a), (b) or (c)
#ASSERT `s 745.01(2) the exception applies: the offence was committed on or after the day the subsection comes into force` TRUE EQUALS TRUE
#ASSERT `s 745.01(2) the exception applies: the offence was committed on or after the day the subsection comes into force` FALSE EQUALS FALSE
#ASSERT `s 745.01(1) the judge shall state the information for the record` TRUE FALSE FALSE FALSE EQUALS NOTHING   -- a judge who did not preside at the trial
#ASSERT `s 745.01(1) the statement the judge shall state` EQUALS "The offender has been found guilty of (state offence) and sentenced to imprisonment for life. The offender is not eligible for parole until (state date). However, after serving at least 15 years of the sentence, the offender may apply under section 745.6 of the Criminal Code for a reduction in the number of years of imprisonment without eligibility for parole. If the jury hearing the application reduces the period of parole ineligibility, the offender may then make an application for parole under the Corrections and Conditional Release Act at the end of that reduced period."

§ `Tests -- section 745.1`

-- args: age at the offence; kind (section 231); manslaughter in 236(2); period specified by the judge
#ASSERT `s 745.1 the years without eligibility for parole` 15 (JUST `first degree murder`) FALSE NOTHING EQUALS JUST 5   -- (a): under sixteen, none specified: five years
#ASSERT `s 745.1 the years without eligibility for parole` 15 (JUST `first degree murder`) FALSE (JUST 6) EQUALS JUST 6   -- (a): specified between five and seven
#ASSERT `s 745.1 the years without eligibility for parole` 15 (JUST `second degree murder`) FALSE (JUST 7) EQUALS JUST 7   -- seven is within "between five and seven" (F-8)
#ASSERT `s 745.1 the years without eligibility for parole` 15 (JUST `second degree murder`) FALSE (JUST 5) EQUALS JUST 5
#ASSERT `s 745.1 the years without eligibility for parole` 15 (JUST `second degree murder`) FALSE (JUST 8) EQUALS NOTHING   -- outside five to seven
#ASSERT `s 745.1 the years without eligibility for parole` 15 (JUST `second degree murder`) FALSE (JUST 4) EQUALS NOTHING
#ASSERT `s 745.1 the years without eligibility for parole` 15 (JUST `manslaughter`) TRUE NOTHING EQUALS JUST 5   -- manslaughter in the circumstances of 236(2)
#ASSERT `s 745.1 the years without eligibility for parole` 15 (JUST `manslaughter`) FALSE NOTHING EQUALS NOTHING   -- manslaughter in other circumstances: not named
#ASSERT `s 745.1 the years without eligibility for parole` 16 (JUST `first degree murder`) FALSE NOTHING EQUALS JUST 10   -- (b): sixteen, first degree murder
#ASSERT `s 745.1 the years without eligibility for parole` 17 (JUST `first degree murder`) FALSE NOTHING EQUALS JUST 10   -- (b): seventeen
#ASSERT `s 745.1 the years without eligibility for parole` 16 (JUST `second degree murder`) FALSE NOTHING EQUALS JUST 7   -- (c)
#ASSERT `s 745.1 the years without eligibility for parole` 17 (JUST `manslaughter`) TRUE NOTHING EQUALS JUST 7   -- (c): manslaughter in the circumstances of 236(2)
#ASSERT `s 745.1 the years without eligibility for parole` 17 (JUST `manslaughter`) FALSE NOTHING EQUALS NOTHING
#ASSERT `s 745.1 the years without eligibility for parole` 18 (JUST `first degree murder`) FALSE NOTHING EQUALS NOTHING   -- not under 18
#ASSERT `s 745.1 the years without eligibility for parole` 15 NOTHING FALSE NOTHING EQUALS NOTHING   -- section 231 does not decide the kind
#ASSERT `s 745.1 the years without eligibility for parole` 15 (JUST `infanticide`) FALSE NOTHING EQUALS NOTHING

§ `Tests -- sections 745.2 to 745.3`

-- args: the jury finds guilty of second degree murder; section 745.3 applies; the judge put the question before discharging the jury
#ASSERT `s 745.2 the judge has put the question to the jury as the section requires` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 745.2 the judge has put the question to the jury as the section requires` TRUE FALSE FALSE EQUALS JUST FALSE   -- not put before discharging the jury
#ASSERT `s 745.2 the judge has put the question to the jury as the section requires` FALSE FALSE TRUE EQUALS JUST FALSE   -- the jury does not find second degree murder
#ASSERT `s 745.2 the judge has put the question to the jury as the section requires` TRUE TRUE TRUE EQUALS NOTHING   -- "Subject to section 745.3"
#ASSERT `s 745.21(1) the judge has put the question to the jury as the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 745.21(1) the judge has put the question to the jury as the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 745.21(1) the judge has put the question to the jury as the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE   -- no previous conviction for murder
#ASSERT `s 745.21(1) the judge has put the question to the jury as the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE   -- the jury does not find murder
#ASSERT `s 745.21(2) subsection (1) applies to the offender` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 745.21(2) subsection (1) applies to the offender` FALSE TRUE EQUALS NOTHING   -- murders committed before the day: a scope limit with no "only"
#ASSERT `s 745.21(2) subsection (1) applies to the offender` TRUE FALSE EQUALS NOTHING
#ASSERT `s 745.3 the judge has put the question to the jury as the section requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 745.3 the judge has put the question to the jury as the section requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 745.3 the judge has put the question to the jury as the section requires` TRUE FALSE TRUE EQUALS JUST FALSE   -- sixteen or over
#ASSERT `s 745.3 the judge has put the question to the jury as the section requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 745.2 the question the judge shall put` EQUALS "You have found the accused guilty of second degree murder and the law requires that I now pronounce a sentence of imprisonment for life against the accused. Do you wish to make any recommendation with respect to the number of years that the accused must serve before the accused is eligible for release on parole? You are not required to make any recommendation but if you do, your recommendation will be considered by me when I am determining whether I should substitute for the ten year period, which the law would otherwise require the accused to serve before the accused is eligible to be considered for release on parole, a number of years that is more than ten but not more than twenty-five."
#ASSERT `s 745.21(1) the question the judge shall put` EQUALS "You have found the accused guilty of murder. The law requires that I now pronounce a sentence of imprisonment for life against the accused. Do you wish to make any recommendation with respect to the period without eligibility for parole to be served for this murder consecutively to the period without eligibility for parole imposed for the previous murder? You are not required to make any recommendation, but if you do, your recommendation will be considered by me when I make my determination."   -- the question as the text prints it (read mechanically from line 16126 of the text)
#ASSERT `s 745.3 the question the judge shall put` EQUALS "You have found the accused guilty of first degree murder (or second degree murder) and the law requires that I now pronounce a sentence of imprisonment for life against the accused. Do you wish to make any recommendation with respect to the period of imprisonment that the accused must serve before the accused is eligible for release on parole? You are not required to make any recommendation but if you do, your recommendation will be considered by me when I am determining the period of imprisonment that is between five years and seven years that the law would require the accused to serve before the accused is eligible to be considered for release on parole."   -- the question as the text prints it (read mechanically from line 16131 of the text)

§ `Tests -- sections 745.4 to 745.52`

-- the judges
#ASSERT `s 745.4 the judge is one the sections allow to make the order` `s 745.4 the judge who presided at the trial of the offender` FALSE EQUALS TRUE
#ASSERT `s 745.4 the judge is one the sections allow to make the order` `s 745.4 another judge of the same court` TRUE EQUALS TRUE   -- the presiding judge is unable to do so
#ASSERT `s 745.4 the judge is one the sections allow to make the order` `s 745.4 another judge of the same court` FALSE EQUALS FALSE
#ASSERT `s 745.4 the judge is one the sections allow to make the order` `s 745.4 a judge of another court` TRUE EQUALS FALSE
-- 745.4: args: the sentencing is under 745 of an offender convicted of second degree murder; section 745.5 applies; the judge; the presiding judge is unable; years
#ASSERT `s 745.4 the judge may, by order, substitute for ten years a number of years of imprisonment without eligibility for parole` TRUE FALSE `s 745.4 the judge who presided at the trial of the offender` FALSE 15 EQUALS JUST TRUE
#ASSERT `s 745.4 the judge may, by order, substitute for ten years a number of years of imprisonment without eligibility for parole` TRUE FALSE `s 745.4 the judge who presided at the trial of the offender` FALSE 25 EQUALS JUST TRUE   -- twenty-five
#ASSERT `s 745.4 the judge may, by order, substitute for ten years a number of years of imprisonment without eligibility for parole` TRUE FALSE `s 745.4 the judge who presided at the trial of the offender` FALSE 10 EQUALS NOTHING   -- not more than ten
#ASSERT `s 745.4 the judge may, by order, substitute for ten years a number of years of imprisonment without eligibility for parole` TRUE FALSE `s 745.4 the judge who presided at the trial of the offender` FALSE 26 EQUALS NOTHING   -- more than twenty-five
#ASSERT `s 745.4 the judge may, by order, substitute for ten years a number of years of imprisonment without eligibility for parole` TRUE FALSE `s 745.4 another judge of the same court` TRUE 15 EQUALS JUST TRUE
#ASSERT `s 745.4 the judge may, by order, substitute for ten years a number of years of imprisonment without eligibility for parole` TRUE FALSE `s 745.4 another judge of the same court` FALSE 15 EQUALS NOTHING   -- the presiding judge is able to do so
#ASSERT `s 745.4 the judge may, by order, substitute for ten years a number of years of imprisonment without eligibility for parole` TRUE TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE 15 EQUALS NOTHING   -- "Subject to section 745.5"
#ASSERT `s 745.4 the judge may, by order, substitute for ten years a number of years of imprisonment without eligibility for parole` FALSE FALSE `s 745.4 the judge who presided at the trial of the offender` FALSE 15 EQUALS JUST FALSE   -- not a sentencing of an offender convicted of second degree murder ("At the time of")
-- 745.5: args: the sentencing is under 745.1 of an under-sixteen offender convicted of first or second degree murder; the judge; unable; years
#ASSERT `s 745.5 the judge may, by order, decide the period of imprisonment the offender is to serve without eligibility for parole` TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE 6 EQUALS JUST TRUE
#ASSERT `s 745.5 the judge may, by order, decide the period of imprisonment the offender is to serve without eligibility for parole` TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE 5 EQUALS JUST TRUE   -- five (F-8)
#ASSERT `s 745.5 the judge may, by order, decide the period of imprisonment the offender is to serve without eligibility for parole` TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE 7 EQUALS JUST TRUE   -- seven (F-8)
#ASSERT `s 745.5 the judge may, by order, decide the period of imprisonment the offender is to serve without eligibility for parole` TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE 8 EQUALS NOTHING
#ASSERT `s 745.5 the judge may, by order, decide the period of imprisonment the offender is to serve without eligibility for parole` TRUE `s 745.4 a judge of another court` TRUE 6 EQUALS NOTHING
#ASSERT `s 745.5 the judge may, by order, decide the period of imprisonment the offender is to serve without eligibility for parole` FALSE `s 745.4 the judge who presided at the trial of the offender` FALSE 6 EQUALS JUST FALSE   -- not an under-sixteen offender convicted of first or second degree murder
-- 745.51
#ASSERT `s 745.51(1) the judge may, by order, decide that the periods without eligibility for parole for each murder conviction are to be served consecutively` TRUE TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE EQUALS JUST TRUE
#ASSERT `s 745.51(1) the judge may, by order, decide that the periods without eligibility for parole for each murder conviction are to be served consecutively` FALSE TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE EQUALS JUST FALSE   -- no earlier murder conviction ("At the time of")
#ASSERT `s 745.51(1) the judge may, by order, decide that the periods without eligibility for parole for each murder conviction are to be served consecutively` TRUE FALSE `s 745.4 the judge who presided at the trial of the offender` FALSE EQUALS NOTHING   -- subsection (3): murders before the day are not covered
#ASSERT `s 745.51(1) the judge may, by order, decide that the periods without eligibility for parole for each murder conviction are to be served consecutively` TRUE TRUE `s 745.4 another judge of the same court` TRUE EQUALS JUST TRUE
#ASSERT `s 745.51(1) the judge may, by order, decide that the periods without eligibility for parole for each murder conviction are to be served consecutively` TRUE TRUE `s 745.4 another judge of the same court` FALSE EQUALS NOTHING
#ASSERT `s 745.51(2) the judge shall give reasons for the decision to make or not to make an order under subsection (1)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 745.51(2) the judge shall give reasons for the decision to make or not to make an order under subsection (1)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 745.51(2) the judge shall give reasons for the decision to make or not to make an order under subsection (1)` FALSE TRUE EQUALS JUST FALSE   -- no decision under subsection (1)
-- 745.52
#ASSERT `s 745.52(1) the judge may, by order, decide the number of years without eligibility for parole` `s 745.52(1)(a) a sentencing under paragraph 745(c.1)` TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE 15 EQUALS JUST TRUE   -- (a)
#ASSERT `s 745.52(1) the judge may, by order, decide the number of years without eligibility for parole` `s 745.52(1)(a) a sentencing under paragraph 745(c.1)` TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE 10 EQUALS NOTHING   -- (a): "a greater number"
#ASSERT `s 745.52(1) the judge may, by order, decide the number of years without eligibility for parole` `s 745.52(1)(a) a sentencing under paragraph 745(c.1)` TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE 25 EQUALS JUST TRUE   -- (a): "of up to 25"
#ASSERT `s 745.52(1) the judge may, by order, decide the number of years without eligibility for parole` `s 745.52(1)(a) a sentencing under paragraph 745(c.1)` TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE 26 EQUALS NOTHING
#ASSERT `s 745.52(1) the judge may, by order, decide the number of years without eligibility for parole` `s 745.52(1)(b) a sentencing under paragraph 745.1(a)` TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE 6 EQUALS JUST TRUE   -- (b)
#ASSERT `s 745.52(1) the judge may, by order, decide the number of years without eligibility for parole` `s 745.52(1)(b) a sentencing under paragraph 745.1(a)` TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE 15 EQUALS NOTHING   -- (b): between five and seven
#ASSERT `s 745.52(1) the judge may, by order, decide the number of years without eligibility for parole` `s 745.52(1)(a) a sentencing under paragraph 745(c.1)` FALSE `s 745.4 the judge who presided at the trial of the offender` FALSE 15 EQUALS JUST FALSE   -- not manslaughter in the circumstances of 236(2)
#ASSERT `s 745.52(1) the judge may, by order, decide the number of years without eligibility for parole` `s 745.52(1) a sentencing of another kind` TRUE `s 745.4 the judge who presided at the trial of the offender` FALSE 15 EQUALS JUST FALSE   -- not a sentencing under paragraph 745(c.1) or 745.1(a)
#ASSERT `s 745.52(1) the judge may, by order, decide the number of years without eligibility for parole` `s 745.52(1)(a) a sentencing under paragraph 745(c.1)` TRUE `s 745.4 a judge of another court` TRUE 15 EQUALS NOTHING
#ASSERT `s 745.52(2) the judge shall have regard to the matter` `s 745.52(2) the character of the offender` FALSE EQUALS JUST TRUE
#ASSERT `s 745.52(2) the judge shall have regard to the matter` `s 745.52(2) the nature of the offence` FALSE EQUALS JUST TRUE
#ASSERT `s 745.52(2) the judge shall have regard to the matter` `s 745.52(2) the circumstances surrounding the commission of the offence` FALSE EQUALS JUST TRUE
#ASSERT `s 745.52(2) the judge shall have regard to the matter` `s 745.52(2) the age of the offender` TRUE EQUALS JUST TRUE   -- a decision under paragraph (1)(b)
#ASSERT `s 745.52(2) the judge shall have regard to the matter` `s 745.52(2) the age of the offender` FALSE EQUALS NOTHING   -- a decision under paragraph (1)(a)
#ASSERT `s 745.52(2) the judge shall have regard to the matter` `s 745.52(2) another matter` TRUE EQUALS NOTHING

-- Subsection 745.51(3): the scope limit on subsections (1) and (2).
#ASSERT `s 745.51(3) subsections (1) and (2) apply: the murders were committed after the day the section comes into force, and the offender is sentenced under this Act, the National Defence Act or the Crimes Against Humanity and War Crimes Act` TRUE EQUALS TRUE
#ASSERT `s 745.51(3) subsections (1) and (2) apply: the murders were committed after the day the section comes into force, and the offender is sentenced under this Act, the National Defence Act or the Crimes Against Humanity and War Crimes Act` FALSE EQUALS FALSE
