IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc2-drilling-entry`

-- ccc2-tests-drilling-entry.l4 -- tests for ccc2-drilling-entry.l4 (ss 70 to 73). Expected values are written beside each assertion from the text of the
-- provision, before the run. The s 787(1) penalty is a seam input: the tests pass a placeholder that states nothing.

§ `Tests -- section 70, unlawful drilling (lines 1102-1114)`

--                                                              kind                                                                                                                              by the GIC  by proclamation
#ASSERT `s 70(1) the Governor in Council may make the order` `s 70(1)(a)(i) an order prohibiting assemblies, without lawful authority, of persons for the purpose of training or drilling themselves` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 70(1) the Governor in Council may make the order` `s 70(1)(a)(ii) an order prohibiting assemblies, without lawful authority, of persons for the purpose of being trained or drilled to the use of arms` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 70(1) the Governor in Council may make the order` `s 70(1)(a)(iii) an order prohibiting assemblies, without lawful authority, of persons for the purpose of practising military exercises` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 70(1) the Governor in Council may make the order` `s 70(1)(b) an order prohibiting persons when assembled for any purpose from training or drilling themselves or from being trained or drilled` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 70(1) the Governor in Council may make the order` `s 70(1) an order of another kind` TRUE TRUE EQUALS NOTHING
#ASSERT `s 70(1) the Governor in Council may make the order` `s 70(1)(b) an order prohibiting persons when assembled for any purpose from training or drilling themselves or from being trained or drilled` FALSE TRUE EQUALS NOTHING   -- not made by the Governor in Council
#ASSERT `s 70(1) the Governor in Council may make the order` `s 70(1)(b) an order prohibiting persons when assembled for any purpose from training or drilling themselves or from being trained or drilled` TRUE FALSE EQUALS NOTHING   -- not by proclamation
-- the power as a regulative rule: exercised -> FULFILLED; unused -> a standing permission (a MAY lapses without consequence).
#TRACE `s 70(1) the power of the Governor in Council` AT 0 WITH
    PARTY `the Governor in Council` DOES `s 70(1) makes an order by proclamation` AT 1
#TRACE `s 70(1) the power of the Governor in Council` AT 0 WITH
    WAITUNTIL 5
--                                                              general  particular  specified
#ASSERT `s 70(2) the order applies to the place, district or assembly` TRUE  FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 70(2) the order applies to the place, district or assembly` FALSE TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `s 70(2) the order applies to the place, district or assembly` FALSE TRUE  FALSE EQUALS NOTHING   -- a particular order that does not specify this place
#ASSERT `s 70(2) the order applies to the place, district or assembly` FALSE FALSE FALSE EQUALS NOTHING
--                                                       order made answer  applies answer  contravenes
#ASSERT `s 70(3) the person contravenes an order made under section 70` (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 70(3) the person contravenes an order made under section 70` (JUST TRUE) (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 70(3) the person contravenes an order made under section 70` NOTHING (JUST TRUE) TRUE EQUALS NOTHING   -- the order is not shown to be one made under section 70
#ASSERT `s 70(3) the person contravenes an order made under section 70` (JUST TRUE) NOTHING TRUE EQUALS NOTHING   -- the order is not shown to apply
#ASSERT `s 70(3) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 70(3) the punishment` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` `five years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)

§ `Tests -- section 71 (repealed)`

#ASSERT `s 71 as the text shows it` EQUALS "71 [Repealed, 2018, c. 29, s. 4]"

§ `Tests -- sections 72 and 73, forcible entry and detainer (lines 1120-1131)`

--                                                enters  peaceable possession of another  manner likely to cause a breach
#ASSERT `s 72(1) the person commits forcible entry` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 72(1) the person commits forcible entry` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 72(1) the person commits forcible entry` TRUE FALSE TRUE EQUALS JUST FALSE   -- the property is not in the actual and peaceable possession of another
#ASSERT `s 72(1) the person commits forcible entry` TRUE TRUE FALSE EQUALS JUST FALSE   -- not in a manner likely to cause a breach of the peace
#ASSERT `s 72(1.1) the person's entitlement to enter the real property, or intention of taking possession of it, is material` TRUE EQUALS JUST FALSE   -- "it is immaterial"
#ASSERT `s 72(1.1) the person's entitlement to enter the real property, or intention of taking possession of it, is material` FALSE EQUALS NOTHING
--                                                   actual possession  without colour of right  manner  against a person entitled
#ASSERT `s 72(2) the person commits forcible detainer` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 72(2) the person commits forcible detainer` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 72(2) the person commits forcible detainer` TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- with colour of right
#ASSERT `s 72(2) the person commits forcible detainer` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 72(2) the person commits forcible detainer` TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- not against a person entitled by law to possession
#ASSERT `s 72(3) the question is a question of law` `s 72(3) whether a person is in actual and peaceable possession` EQUALS JUST TRUE
#ASSERT `s 72(3) the question is a question of law` `s 72(3) whether a person is in actual possession without colour of right` EQUALS JUST TRUE
#ASSERT `s 72(3) the question is a question of law` `s 72(3) another question` EQUALS NOTHING
#ASSERT `s 73 the person commits forcible entry or forcible detainer` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 73 the person commits forcible entry or forcible detainer` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 73 the person commits forcible entry or forcible detainer` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 73 the person commits forcible entry or forcible detainer` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 73 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 73 the punishment` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` `two years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
