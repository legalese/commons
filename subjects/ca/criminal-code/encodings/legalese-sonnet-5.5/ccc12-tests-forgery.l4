IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc12-logic`
IMPORT `ccc12-tests-fixtures`
IMPORT `ccc12-part9-forgery`

-- Tests of ss 366 to 378. Expected values are hand-written from the text before each run. Arguments are positional, in the GIVEN order of each function.

§ `s 366 forgery`
-- the document is a false document (s 321), the person makes it (s 366(2) included), knows it to be false, intent (a) used or acted on as genuine to the prejudice of any one, intent (b) that a person be induced by the belief that it is genuine
#ASSERT `s 366(1) the person commits forgery` (JUST TRUE) (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 366(1) the person commits forgery` (JUST TRUE) (JUST TRUE) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 366(1) the person commits forgery` (JUST TRUE) (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 366(1) the person commits forgery` (JUST TRUE) (JUST TRUE) FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 366(1) the person commits forgery` (JUST FALSE) (JUST TRUE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 366(1) the person commits forgery` (JUST TRUE) (JUST FALSE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 366(1) the person commits forgery` NOTHING (JUST TRUE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 366(1) the person commits forgery` (JUST TRUE) NOTHING TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 366(1) the person commits forgery` NOTHING (JUST FALSE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 366(1) the person commits forgery` NOTHING (JUST TRUE) FALSE TRUE TRUE EQUALS JUST FALSE
-- (2): making a false document includes
#ASSERT `s 366(2) the act is making a false document` `s 366(2)(a) altering a genuine document in any material part` EQUALS JUST TRUE
#ASSERT `s 366(2) the act is making a false document` `s 366(2)(b) making a material addition to a genuine document or adding to it a false date, attestation, seal or other thing that is material` EQUALS JUST TRUE
#ASSERT `s 366(2) the act is making a false document` `s 366(2)(c) making a material alteration in a genuine document by erasure, obliteration, removal or in any other way` EQUALS JUST TRUE
#ASSERT `s 366(2) the act is making a false document` `s 366(2) another act` EQUALS NOTHING
-- (3): complete as soon as a document is made with the knowledge and intent
#ASSERT `s 366(3) forgery is complete` TRUE EQUALS JUST TRUE
#ASSERT `s 366(3) forgery is complete` FALSE EQUALS JUST FALSE
-- (4): incomplete or not purporting to be binding in law; such as to indicate that it was intended to be acted on as genuine
#ASSERT `s 366(4) forgery is complete notwithstanding that the false document is incomplete or does not purport to be binding in law` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 366(4) forgery is complete notwithstanding that the false document is incomplete or does not purport to be binding in law` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 366(4) forgery is complete notwithstanding that the false document is incomplete or does not purport to be binding in law` FALSE TRUE EQUALS NOTHING
#ASSERT `s 366(4) forgery is complete notwithstanding that the false document is incomplete or does not purport to be binding in law` FALSE FALSE EQUALS NOTHING
-- (5): in good faith, at the request of a police force, the Canadian Forces or a government department or agency
#ASSERT `s 366(5) the person commits forgery by reason only of making a false document in good faith at the request of a police force, the Canadian Forces or a government department or agency` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 366(5) the person commits forgery by reason only of making a false document in good faith at the request of a police force, the Canadian Forces or a government department or agency` TRUE FALSE EQUALS NOTHING
#ASSERT `s 366(5) the person commits forgery by reason only of making a false document in good faith at the request of a police force, the Canadian Forces or a government department or agency` FALSE TRUE EQUALS NOTHING
#ASSERT `s 367 the punishment for forgery` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`

§ `ss 368 to 371`
-- 368(1): knows or believes the document is forged, (a) uses/deals with/acts on it, (b) causes or attempts to cause another to, (c) transfers/sells/offers/makes available, (c) knowing or reckless that an offence under (a) or (b) will be committed, (d) possesses with intent to commit (a) to (c)
#ASSERT `s 368(1) the person commits the offence of using, trafficking in or possessing a forged document` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 368(1) the person commits the offence of using, trafficking in or possessing a forged document` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 368(1) the person commits the offence of using, trafficking in or possessing a forged document` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 368(1) the person commits the offence of using, trafficking in or possessing a forged document` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 368(1) the person commits the offence of using, trafficking in or possessing a forged document` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 368(1) the person commits the offence of using, trafficking in or possessing a forged document` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 368(1) the person commits the offence of using, trafficking in or possessing a forged document` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 368(1) the person commits the offence of using, trafficking in or possessing a forged document` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 368(1.1) the punishment for the offence` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`
-- (2): the place where the document was forged is not material
#ASSERT `s 368(2) the place where the document was forged is material` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 368(2) the place where the document was forged is material` TRUE FALSE EQUALS NOTHING
#ASSERT `s 368(2) the place where the document was forged is material` FALSE TRUE EQUALS NOTHING
-- 368.1
#ASSERT `s 368.1 the person commits the offence of possessing a forgery instrument` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 368.1 the person commits the offence of possessing a forgery instrument` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 368.1 the person commits the offence of possessing a forgery instrument` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 368.1 the person commits the offence of possessing a forgery instrument` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 368.1 the punishment for the offence` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to fourteen years`, `ccc12 fixture general summary penalty`
-- 368.2: the offence (sections 366 to 368.1), a public officer (s 25.1(1)), for the sole purpose of a covert identity
#ASSERT `s 368.2 the public officer is guilty of an offence under any of sections 366 to 368.1` (`Provision of the Code` OF 366, "(1)") (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 368.2 the public officer is guilty of an offence under any of sections 366 to 368.1` (`Provision of the Code` OF 367, "") (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 368.2 the public officer is guilty of an offence under any of sections 366 to 368.1` (`Provision of the Code` OF 368, "(1)") (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 368.2 the public officer is guilty of an offence under any of sections 366 to 368.1` (`Provision of the Code` OF 368.1, "") (JUST TRUE) TRUE EQUALS JUST FALSE
-- 365 precedes the range; 368.2 and 369 follow it
#ASSERT `s 368.2 the public officer is guilty of an offence under any of sections 366 to 368.1` (`Provision of the Code` OF 365, "") (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 368.2 the public officer is guilty of an offence under any of sections 366 to 368.1` (`Provision of the Code` OF 368.2, "") (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 368.2 the public officer is guilty of an offence under any of sections 366 to 368.1` (`Provision of the Code` OF 369, "") (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 368.2 the public officer is guilty of an offence under any of sections 366 to 368.1` (`Provision of the Code` OF 366, "(1)") (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 368.2 the public officer is guilty of an offence under any of sections 366 to 368.1` (`Provision of the Code` OF 366, "(1)") NOTHING TRUE EQUALS NOTHING
#ASSERT `s 368.2 the public officer is guilty of an offence under any of sections 366 to 368.1` (`Provision of the Code` OF 366, "(1)") (JUST TRUE) FALSE EQUALS NOTHING
-- 369: without lawful authority or excuse, (a) makes/uses/possesses, exchequer bill paper (s 321), revenue paper (s 321), paper used to make bank-notes, paper intended to resemble it, (b) makes/reproduces/uses a public seal
#ASSERT `s 369 the person commits the offence of dealing in exchequer bill paper, revenue paper or public seals` TRUE TRUE (JUST TRUE) (JUST FALSE) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 369 the person commits the offence of dealing in exchequer bill paper, revenue paper or public seals` TRUE TRUE (JUST FALSE) (JUST TRUE) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 369 the person commits the offence of dealing in exchequer bill paper, revenue paper or public seals` TRUE TRUE (JUST FALSE) (JUST FALSE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 369 the person commits the offence of dealing in exchequer bill paper, revenue paper or public seals` TRUE TRUE (JUST FALSE) (JUST FALSE) FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 369 the person commits the offence of dealing in exchequer bill paper, revenue paper or public seals` TRUE TRUE (JUST FALSE) (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 369 the person commits the offence of dealing in exchequer bill paper, revenue paper or public seals` TRUE FALSE (JUST TRUE) (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 369 the person commits the offence of dealing in exchequer bill paper, revenue paper or public seals` TRUE FALSE (JUST FALSE) (JUST FALSE) FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 369 the person commits the offence of dealing in exchequer bill paper, revenue paper or public seals` FALSE TRUE (JUST TRUE) (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 369 the person commits the offence of dealing in exchequer bill paper, revenue paper or public seals` TRUE TRUE NOTHING (JUST FALSE) FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 369 the person commits the offence of dealing in exchequer bill paper, revenue paper or public seals` TRUE TRUE NOTHING (JUST FALSE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 369 the punishment for the offence` EQUALS LIST `ccc12 fixture indictable, up to fourteen years`
#ASSERT `s 370 as the text shows it` EQUALS "370 [Repealed, 2018, c. 29, s. 42]"
#ASSERT `s 371 as the text shows it` EQUALS "371 [Repealed, 2018, c. 29, s. 42]"

§ `s 372 false information and communications`
#ASSERT `s 372(1) the person commits the offence of conveying false information` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 372(1) the person commits the offence of conveying false information` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 372(1) the person commits the offence of conveying false information` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 372(2) the person commits the offence of making an indecent communication` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 372(2) the person commits the offence of making an indecent communication` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 372(2) the person commits the offence of making an indecent communication` FALSE TRUE EQUALS JUST FALSE
-- (3): without lawful excuse, intent to harass, repeatedly communicates
#ASSERT `s 372(3) the person commits the offence of making harassing communications` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 372(3) the person commits the offence of making harassing communications` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 372(3) the person commits the offence of making harassing communications` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 372(3) the person commits the offence of making harassing communications` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 372(4) the punishment for an offence under section 372` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to two years`, `ccc12 fixture general summary penalty`
#ASSERT `s 373 as the text shows it` EQUALS "373 [Repealed, R.S., 1985, c. 27 (1st Supp.), s. 53]"

§ `ss 374 to 378`
-- 374: a document (s 321), (a) with intent to defraud and without lawful authority makes/executes/draws/signs/accepts/endorses it in another's name, (b) makes use of or utters it knowing
#ASSERT `s 374 the person commits the offence of drawing or using a document without authority` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 374 the person commits the offence of drawing or using a document without authority` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 374 the person commits the offence of drawing or using a document without authority` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 374 the person commits the offence of drawing or using a document without authority` (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 374 the person commits the offence of drawing or using a document without authority` NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 374 the person commits the offence of drawing or using a document without authority` NOTHING FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 374 the punishment for the offence` EQUALS LIST `ccc12 fixture indictable, up to fourteen years`
-- 375
#ASSERT `s 375 the person commits the offence of obtaining a thing by an instrument based on a forged document` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 375 the person commits the offence of obtaining a thing by an instrument based on a forged document` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 375 the person commits the offence of obtaining a thing by an instrument based on a forged document` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 375 the person commits the offence of obtaining a thing by an instrument based on a forged document` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 375 the punishment for the offence` EQUALS LIST `ccc12 fixture indictable, up to fourteen years`
-- 376(3): mark, stamp
#ASSERT `s 376(3) the thing is a mark` TRUE `s 376(3)(a) used by or on behalf of the government of Canada or a province` EQUALS JUST TRUE
#ASSERT `s 376(3) the thing is a mark` TRUE `s 376(3)(b) used by or on behalf of the government of a state other than Canada` EQUALS JUST TRUE
#ASSERT `s 376(3) the thing is a mark` TRUE `s 376(3)(c) used by or on behalf of a department, board, commission or agent established by a government mentioned in paragraph (a) or (b) in connection with the service or business of that government` EQUALS JUST TRUE
#ASSERT `s 376(3) the thing is a mark` TRUE `s 376(3) used by no one of those` EQUALS JUST FALSE
#ASSERT `s 376(3) the thing is a mark` FALSE `s 376(3)(a) used by or on behalf of the government of Canada or a province` EQUALS JUST FALSE
#ASSERT `s 376(3) the thing is a stamp` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 376(3) the thing is a stamp` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 376(3) the thing is a stamp` TRUE FALSE EQUALS JUST FALSE
-- 376(1): a stamp (s 376(3)), (a) fraudulently uses/mutilates/..., (b)(i) possesses a counterfeit stamp, (b)(ii) possesses a thing bearing a stamp partly erased, (c) makes or possesses a die
#ASSERT `s 376(1) the person commits the offence of counterfeiting a stamp` (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 376(1) the person commits the offence of counterfeiting a stamp` (JUST TRUE) FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 376(1) the person commits the offence of counterfeiting a stamp` (JUST TRUE) FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 376(1) the person commits the offence of counterfeiting a stamp` (JUST TRUE) FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 376(1) the person commits the offence of counterfeiting a stamp` (JUST TRUE) FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 376(1) the person commits the offence of counterfeiting a stamp` (JUST FALSE) TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 376(1) the person commits the offence of counterfeiting a stamp` NOTHING TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 376(1) the person commits the offence of counterfeiting a stamp` NOTHING FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 376(1) the punishment for the offence` EQUALS LIST `ccc12 fixture indictable, up to fourteen years`
-- 376(2): without lawful authority, a mark (s 376(3)), (a) makes a mark, (b) sells/exposes/possesses a counterfeit mark, (c) affixes a mark to another thing, (d) affixes a counterfeit mark
#ASSERT `s 376(2) the person commits the offence of counterfeiting a mark` TRUE (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 376(2) the person commits the offence of counterfeiting a mark` TRUE (JUST TRUE) FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 376(2) the person commits the offence of counterfeiting a mark` TRUE (JUST TRUE) FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 376(2) the person commits the offence of counterfeiting a mark` TRUE (JUST TRUE) FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 376(2) the person commits the offence of counterfeiting a mark` TRUE (JUST TRUE) FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 376(2) the person commits the offence of counterfeiting a mark` FALSE (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 376(2) the person commits the offence of counterfeiting a mark` TRUE (JUST FALSE) TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 376(2) the person commits the offence of counterfeiting a mark` TRUE NOTHING TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 376(2) the punishment for the offence` EQUALS LIST `ccc12 fixture indictable, up to fourteen years`
-- 377(2): election document
#ASSERT `s 377(2) the document is an election document` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 377(2) the document is an election document` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 377(2) the document is an election document` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 377(2) the document is an election document` TRUE TRUE FALSE EQUALS JUST FALSE
-- 377(1): unlawfully, (a) a register of births etc., (b) a false entry in a register, an election document (s 377(2)), (c) destroys/damages an election document, (d) erasure/alteration of an election document
#ASSERT `s 377(1) the person commits the offence of damaging documents` TRUE TRUE FALSE (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 377(1) the person commits the offence of damaging documents` TRUE FALSE TRUE (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 377(1) the person commits the offence of damaging documents` TRUE FALSE FALSE (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 377(1) the person commits the offence of damaging documents` TRUE FALSE FALSE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 377(1) the person commits the offence of damaging documents` TRUE FALSE FALSE (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 377(1) the person commits the offence of damaging documents` TRUE FALSE FALSE (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 377(1) the person commits the offence of damaging documents` TRUE FALSE FALSE NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 377(1) the person commits the offence of damaging documents` TRUE FALSE FALSE NOTHING FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 377(1) the person commits the offence of damaging documents` TRUE TRUE FALSE NOTHING FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 377(1) the person commits the offence of damaging documents` FALSE TRUE TRUE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 377(1) the punishment for the offence` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to five years`, `ccc12 fixture general summary penalty`
-- 378: (a) authorized, knowingly issues a false certified copy; (b) not authorized, fraudulently issues a copy purporting to be certified; (c) authorized to make a certificate or declaration, knowingly and falsely makes it
#ASSERT `s 378 the person commits an offence in relation to registers` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 378 the person commits an offence in relation to registers` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 378 the person commits an offence in relation to registers` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
