IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc17-privilege`

-- ccc17-tests-privilege.l4 -- tests for ccc17-privilege.l4 (s 488.1). Expected values are written from the text, beside each assertion.

§ `Tests: s 488.1(1) definitions`

#ASSERT `s 488.1(1) custodian` TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(1) custodian` FALSE EQUALS JUST FALSE
#ASSERT `s 488.1(1) document` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 488.1(1) document` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 488.1(1) document` NOTHING EQUALS NOTHING
#ASSERT `s 488.1(1) judge` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(1) judge` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 488.1(1) judge` FALSE TRUE EQUALS JUST FALSE
-- "lawyer": in Quebec an advocate, lawyer or notary; in any other province a barrister or solicitor; the territories are not provinces
#ASSERT `s 488.1(1) lawyer` Quebec `s 488.1(1) an advocate, lawyer or notary` EQUALS JUST TRUE
#ASSERT `s 488.1(1) lawyer` Quebec `s 488.1(1) a barrister or solicitor` EQUALS JUST FALSE
#ASSERT `s 488.1(1) lawyer` Quebec `s 488.1(1) neither` EQUALS JUST FALSE
#ASSERT `s 488.1(1) lawyer` Ontario `s 488.1(1) a barrister or solicitor` EQUALS JUST TRUE
#ASSERT `s 488.1(1) lawyer` Alberta `s 488.1(1) an advocate, lawyer or notary` EQUALS JUST FALSE
#ASSERT `s 488.1(1) lawyer` `British Columbia` `s 488.1(1) neither` EQUALS JUST FALSE
#ASSERT `s 488.1(1) lawyer` Yukon `s 488.1(1) a barrister or solicitor` EQUALS NOTHING
#ASSERT `s 488.1(1) lawyer` `Northwest Territories` `s 488.1(1) a barrister or solicitor` EQUALS NOTHING
#ASSERT `s 488.1(1) lawyer` Nunavut `s 488.1(1) an advocate, lawyer or notary` EQUALS NOTHING
#ASSERT `s 488.1(1) officer` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 488.1(1) officer` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 488.1(1) officer` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 488.1(1) officer` NOTHING (JUST FALSE) EQUALS NOTHING

§ `Tests: s 488.1(2), (3): seizing, sealing, applying to a judge, the periods`

#ASSERT `s 488.1(2) the officer shall, without examining or making copies of the document, seize it and place it in a package, suitably sealed and identified` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(2) the officer shall, without examining or making copies of the document, seize it and place it in a package, suitably sealed and identified` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 488.1(2) the officer shall, without examining or making copies of the document, seize it and place it in a package, suitably sealed and identified` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 488.1(2) the officer shall, without examining or making copies of the document, seize it and place it in a package, suitably sealed and identified` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 488.1(2)(b) the package shall be placed in the custody of` TRUE TRUE FALSE EQUALS JUST `s 488.1(2)(b) the sheriff of the district or county in which the seizure was made`
#ASSERT `s 488.1(2)(b) the package shall be placed in the custody of` TRUE TRUE TRUE EQUALS JUST `s 488.1(2)(b) the specified person named in a written agreement`
#ASSERT `s 488.1(2)(b) the package shall be placed in the custody of` FALSE TRUE TRUE EQUALS NOTHING
-- (3)(a): placed in custody 1 March 2026: the fourteenth day is 15 March 2026
#ASSERT `s 488.1(3)(a) the last day to apply to a judge` (Date 1 3 2026) EQUALS Date 15 3 2026
#ASSERT `s 488.1(3)(a) the person may apply to a judge for an order appointing a place and a day for the determination of the question and requiring the custodian to produce the document` `s 488.1(3) the client` TRUE (Date 1 3 2026) (Date 15 3 2026) 2 EQUALS JUST TRUE
#ASSERT `s 488.1(3)(a) the person may apply to a judge for an order appointing a place and a day for the determination of the question and requiring the custodian to produce the document` `s 488.1(3) the lawyer on behalf of the client` TRUE (Date 1 3 2026) (Date 2 3 2026) 3 EQUALS JUST TRUE
#ASSERT `s 488.1(3)(a) the person may apply to a judge for an order appointing a place and a day for the determination of the question and requiring the custodian to produce the document` `s 488.1(3) the Attorney General` TRUE (Date 1 3 2026) (Date 10 3 2026) 2 EQUALS JUST TRUE
#ASSERT `s 488.1(3)(a) the person may apply to a judge for an order appointing a place and a day for the determination of the question and requiring the custodian to produce the document` `s 488.1(3) the client` TRUE (Date 1 3 2026) (Date 16 3 2026) 2 EQUALS JUST FALSE
#ASSERT `s 488.1(3)(a) the person may apply to a judge for an order appointing a place and a day for the determination of the question and requiring the custodian to produce the document` `s 488.1(3) the client` TRUE (Date 1 3 2026) (Date 10 3 2026) 1 EQUALS JUST FALSE
#ASSERT `s 488.1(3)(a) the person may apply to a judge for an order appointing a place and a day for the determination of the question and requiring the custodian to produce the document` `s 488.1(3) someone else` TRUE (Date 1 3 2026) (Date 10 3 2026) 2 EQUALS NOTHING
#ASSERT `s 488.1(3)(a) the person may apply to a judge for an order appointing a place and a day for the determination of the question and requiring the custodian to produce the document` `s 488.1(3) the client` FALSE (Date 1 3 2026) (Date 10 3 2026) 2 EQUALS NOTHING
-- (3)(a)(i): order dated 1 March 2026: the determination to be appointed not later than 22 March 2026; (3)(b): serve within six days: 7 March 2026
#ASSERT `s 488.1(3)(a)(i) the latest day that may be appointed for the determination of the question` (Date 1 3 2026) EQUALS Date 22 3 2026
#ASSERT `s 488.1(3)(b) the last day to serve a copy of the order on all other persons entitled to make application and on the custodian` (Date 1 3 2026) EQUALS Date 7 3 2026
#ASSERT `s 488.1(3)(b) the copy of the order is served within six days` (Date 1 3 2026) (Date 7 3 2026) EQUALS TRUE
#ASSERT `s 488.1(3)(b) the copy of the order is served within six days` (Date 1 3 2026) (Date 8 3 2026) EQUALS FALSE
#ASSERT `s 488.1(3)(c) the person may apply at the appointed time and place for an order determining the question` `s 488.1(3) the client` TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(3)(c) the person may apply at the appointed time and place for an order determining the question` `s 488.1(3) the client` FALSE EQUALS NOTHING
#ASSERT `s 488.1(3)(c) the person may apply at the appointed time and place for an order determining the question` `s 488.1(3) someone else` TRUE EQUALS NOTHING

§ `Tests: s 488.1(4) to (11)`

#ASSERT `s 488.1(4)(a) the judge may inspect the document` TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(4)(a) the judge may inspect the document` FALSE EQUALS NOTHING
#ASSERT `s 488.1(4)(b) the judge may allow the Attorney General to inspect the document` TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(4)(b) the judge may allow the Attorney General to inspect the document` FALSE EQUALS NOTHING
#ASSERT `s 488.1(4)(c) the judge shall allow the Attorney General and the person who objects to the disclosure of the document to make representations` TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(4)(c) the judge shall allow the Attorney General and the person who objects to the disclosure of the document to make representations` FALSE EQUALS JUST FALSE
#ASSERT `s 488.1(4)(d) the order the judge shall make` TRUE TRUE FALSE EQUALS JUST `s 488.1(4)(d)(i) repackage and reseal the document and order the custodian to deliver it to the lawyer who claimed the solicitor-client privilege or to the client`
#ASSERT `s 488.1(4)(d) the order the judge shall make` TRUE FALSE TRUE EQUALS JUST `s 488.1(4)(d)(ii) order the custodian to deliver the document to the officer who seized it or some other person designated by the Attorney General, subject to such restrictions or conditions as the judge deems appropriate`
#ASSERT `s 488.1(4)(d) the order the judge shall make` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 488.1(4)(d) the order the judge shall make` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 488.1(4) the judge shall, at the same time, deliver concise reasons for the determination in which the nature of the document is described without divulging the details` TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(4) the judge shall, at the same time, deliver concise reasons for the determination in which the nature of the document is described without divulging the details` FALSE EQUALS JUST FALSE
#ASSERT `s 488.1(5) the document remains privileged and inadmissible as evidence` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 488.1(5) the document remains privileged and inadmissible as evidence` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 488.1(5) the document remains privileged and inadmissible as evidence` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 488.1(5) the document remains privileged and inadmissible as evidence` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 488.1(6) the judge shall order the custodian to deliver the document to the officer who seized it or to some other person designated by the Attorney General` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(6) the judge shall order the custodian to deliver the document to the officer who seized it or to some other person designated by the Attorney General` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 488.1(6) the judge shall order the custodian to deliver the document to the officer who seized it or to some other person designated by the Attorney General` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 488.1(7) subsequent applications under paragraph (3)(c) may be made to another judge` TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(7) subsequent applications under paragraph (3)(c) may be made to another judge` FALSE EQUALS JUST FALSE
#ASSERT `s 488.1(8) the officer is barred from examining, making copies of or seizing the document` FALSE EQUALS JUST TRUE
#ASSERT `s 488.1(8) the officer is barred from examining, making copies of or seizing the document` TRUE EQUALS NOTHING
#ASSERT `s 488.1(9) the judge may authorize the person to examine the document or make a copy of it in the presence of the custodian or the judge` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(9) the judge may authorize the person to examine the document or make a copy of it in the presence of the custodian or the judge` TRUE FALSE EQUALS NOTHING
#ASSERT `s 488.1(9) the judge may authorize the person to examine the document or make a copy of it in the presence of the custodian or the judge` FALSE TRUE EQUALS NOTHING
#ASSERT `s 488.1(10) the application shall be heard in private` TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(10) the application shall be heard in private` FALSE EQUALS NOTHING
#ASSERT `s 488.1(11) this section does not apply` TRUE EQUALS JUST TRUE
#ASSERT `s 488.1(11) this section does not apply` FALSE EQUALS JUST FALSE
