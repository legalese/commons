IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc30-forms-actors`
IMPORT `ccc30-forms-dna`

-- ccc30-tests-forms-dna.l4 -- tests for ccc30-forms-dna.l4 (Forms 5.01 to 5.09, raw lines 17721-17909). Every expected value is written by hand from the text of the
-- Form named; the five authority functions share one table of cases because the five Forms say the same thing in the same order.
-- A #TRACE prints its outcome and no assertion line: the expected outcome is written above each trace and read by eye.

§ `Tests -- Form 5.02, who may take the samples`

-- able, a peace officer, within the number, terms complied with
#ASSERT `form 5.02 the warrant authorizes the person to take the samples` TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- not a peace officer but taking them under the direction of a peace officer
#ASSERT `form 5.02 the warrant authorizes the person to take the samples` TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- a peace officer who is also under direction
#ASSERT `form 5.02 the warrant authorizes the person to take the samples` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- not able by training or experience: 'provided that the person taking the samples is able'
#ASSERT `form 5.02 the warrant authorizes the person to take the samples` FALSE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- neither a peace officer nor under the direction of one: 'provided that, if the person ... is not a peace officer'
#ASSERT `form 5.02 the warrant authorizes the person to take the samples` TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- unable and not a peace officer: the first failed limb is the answer
#ASSERT `form 5.02 the warrant authorizes the person to take the samples` FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- more samples than the number reasonably required: outside the grant, not an express no
#ASSERT `form 5.02 the warrant authorizes the person to take the samples` TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING
-- terms and conditions not complied with: the text says the instrument is 'subject to' them, not what follows
#ASSERT `form 5.02 the warrant authorizes the person to take the samples` TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING

