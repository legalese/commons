IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc10-sexual-services`

-- ccc10-tests-sexual-services.l4 -- tests for ccc10-sexual-services.l4 (ss 286.1 to 286.5). Expected values are written by hand from the text, beside each assertion.

`s 286.1 fixture: the general summary conviction penalty` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
-- Expected punishments of s 286.1(1), written from the text: on indictment five years and a minimum fine; on summary conviction a fine of not more than $5,000 or two years less a day and a minimum fine.
GIVEN minimum IS A NUMBER
GIVETH A MAYBE Punishment
`s 286.1 fixture: on indictment with a minimum fine of` MEANS JUST (Punishment OF `by indictment`, (`imprisonment for a term of` `five years`), `no imprisonment is stated`, `no fine is stated`, (`a fine of` minimum))
GIVEN minimum IS A NUMBER
GIVETH A MAYBE Punishment
`s 286.1 fixture: on summary conviction with a minimum fine of` MEANS JUST (Punishment OF `on summary conviction`, (`imprisonment for a term of` `two years less a day`), `no imprisonment is stated`, (`a fine of` 5000), (`a fine of` minimum))
GIVEN maximum IS A NUMBER
      minimum IS A NUMBER
GIVETH A Punishment
`s 286.1 fixture: at most and at least` MEANS Punishment OF `by indictment`, (`imprisonment for a term of` (`Length of time` OF maximum, 0, 0, FALSE)), (`imprisonment for a term of` (`Length of time` OF minimum, 0, 0, FALSE)), `no fine is stated`, `no fine is stated`

§ `s 286.1 -- Obtaining sexual services for consideration`

#ASSERT `s 286.1(5) the place is a place, as in subsection 197(1)` (JUST TRUE) EQUALS JUST TRUE   -- the answer of s 197(1), passed through
#ASSERT `s 286.1(5) the place is a place, as in subsection 197(1)` (JUST FALSE) EQUALS JUST FALSE   -- passed through
#ASSERT `s 286.1(5) the place is a place, as in subsection 197(1)` NOTHING EQUALS NOTHING   -- not determined: not turned into FALSE
#ASSERT `s 286.1(5) the place is a public place, as in subsection 197(1)` (JUST TRUE) EQUALS JUST TRUE   -- passed through
#ASSERT `s 286.1(5) the place is a public place, as in subsection 197(1)` NOTHING EQUALS NOTHING   -- not determined
-- Argument order of (1): the place (s 197(1)); the person obtains or communicates for sexual services.
#ASSERT `s 286.1(1) the person is guilty of the offence of obtaining sexual services for consideration` (JUST TRUE) TRUE EQUALS JUST TRUE   -- "in any place, obtains for consideration"
#ASSERT `s 286.1(1) the person is guilty of the offence of obtaining sexual services for consideration` (JUST TRUE) FALSE EQUALS NOTHING   -- no obtaining or communicating
#ASSERT `s 286.1(1) the person is guilty of the offence of obtaining sexual services for consideration` (JUST FALSE) TRUE EQUALS NOTHING   -- not a "place" as s 197(1) has it
#ASSERT `s 286.1(1) the person is guilty of the offence of obtaining sexual services for consideration` NOTHING TRUE EQUALS NOTHING   -- s 197(1) not determined
#ASSERT `s 286.1(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
-- Argument order of (a)(i): the place is a public place (s 197(1)); open to public view; is or is next to a park, school or religious grounds, or where persons under 18 can be expected.
#ASSERT `s 286.1(1)(a)(i) the offence is committed in a place of the kind described` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- a public place next to a park
#ASSERT `s 286.1(1)(a)(i) the offence is committed in a place of the kind described` (JUST FALSE) TRUE TRUE EQUALS JUST TRUE   -- "or in any place open to public view"
#ASSERT `s 286.1(1)(a)(i) the offence is committed in a place of the kind described` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE   -- a public place not near one: "in any other case"
#ASSERT `s 286.1(1)(a)(i) the offence is committed in a place of the kind described` (JUST FALSE) FALSE TRUE EQUALS JUST FALSE   -- not public, not open to view
#ASSERT `s 286.1(1)(a)(i) the offence is committed in a place of the kind described` NOTHING FALSE TRUE EQUALS NOTHING   -- whether it is a public place is not determined
#ASSERT `s 286.1(1)(a)(i) the offence is committed in a place of the kind described` NOTHING TRUE TRUE EQUALS JUST TRUE   -- open to public view whatever s 197(1) says
#ASSERT `s 286.1(1)(a)(i) the offence is committed in a place of the kind described` NOTHING FALSE FALSE EQUALS JUST FALSE   -- not near a park: (ii) whatever s 197(1) says
-- Argument order of the punishment: the mode; the answer of (a)(i); the answer as to a subsequent offence (JUST TRUE) or a first offence (JUST FALSE).
#ASSERT `s 286.1(1) the punishment` `by indictment` (JUST TRUE) (JUST FALSE) EQUALS `s 286.1 fixture: on indictment with a minimum fine of` 2000   -- (a)(i)(A): first offence, $2,000
#ASSERT `s 286.1(1) the punishment` `by indictment` (JUST TRUE) (JUST TRUE) EQUALS `s 286.1 fixture: on indictment with a minimum fine of` 4000   -- (a)(i)(B): each subsequent, $4,000
#ASSERT `s 286.1(1) the punishment` `by indictment` (JUST FALSE) (JUST FALSE) EQUALS `s 286.1 fixture: on indictment with a minimum fine of` 1000   -- (a)(ii)(A): any other case, first, $1,000
#ASSERT `s 286.1(1) the punishment` `by indictment` (JUST FALSE) (JUST TRUE) EQUALS `s 286.1 fixture: on indictment with a minimum fine of` 2000   -- (a)(ii)(B): subsequent, $2,000
#ASSERT `s 286.1(1) the punishment` `on summary conviction` (JUST TRUE) (JUST FALSE) EQUALS `s 286.1 fixture: on summary conviction with a minimum fine of` 1000   -- (b)(i)(A): $1,000
#ASSERT `s 286.1(1) the punishment` `on summary conviction` (JUST TRUE) (JUST TRUE) EQUALS `s 286.1 fixture: on summary conviction with a minimum fine of` 2000   -- (b)(i)(B): $2,000
#ASSERT `s 286.1(1) the punishment` `on summary conviction` (JUST FALSE) (JUST FALSE) EQUALS `s 286.1 fixture: on summary conviction with a minimum fine of` 500   -- (b)(ii)(A): $500
#ASSERT `s 286.1(1) the punishment` `on summary conviction` (JUST FALSE) (JUST TRUE) EQUALS `s 286.1 fixture: on summary conviction with a minimum fine of` 1000   -- (b)(ii)(B): $1,000
#ASSERT `s 286.1(1) the punishment` `by indictment` NOTHING (JUST FALSE) EQUALS NOTHING   -- the kind of place is not determined
#ASSERT `s 286.1(1) the punishment` `on summary conviction` (JUST FALSE) NOTHING EQUALS NOTHING   -- whether subsequent is not determined
-- (3) and (4). Record: the offence; the offence was under 212(4) as it read before the day the subsection comes into force; the day of the conviction.
#ASSERT `s 286.1(3) the conviction is of an offence to be considered as an earlier offence` (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 286.1, "(2)"), FALSE, (Date 1 3 2015)) EQUALS JUST TRUE   -- (a): an offence under that subsection
#ASSERT `s 286.1(3) the conviction is of an offence to be considered as an earlier offence` (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 286.1, "(1)"), FALSE, (Date 1 3 2015)) EQUALS NOTHING   -- subsection (1) is not "that subsection"
#ASSERT `s 286.1(3) the conviction is of an offence to be considered as an earlier offence` (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 212, "(4)"), TRUE, (Date 1 3 2015)) EQUALS JUST TRUE   -- (b): subsection 212(4) as it read before
#ASSERT `s 286.1(3) the conviction is of an offence to be considered as an earlier offence` (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 212, "(4)"), FALSE, (Date 1 3 2015)) EQUALS NOTHING   -- 212(4) as it reads now is not that
#ASSERT `s 286.1(4) the conviction is earlier in the sequence of convictions` (Date 1 1 2010) (Date 1 1 2015) EQUALS JUST TRUE   -- convicted first
#ASSERT `s 286.1(4) the conviction is earlier in the sequence of convictions` (Date 1 1 2016) (Date 1 1 2015) EQUALS JUST FALSE   -- convicted after
#ASSERT `s 286.1(4) the conviction is earlier in the sequence of convictions` (Date 1 1 2015) (Date 1 1 2015) EQUALS NOTHING   -- the same day
#ASSERT `s 286.1(2) the person has committed a subsequent offence` (EMPTY) (Date 1 3 2020) EQUALS JUST FALSE   -- a first offence
#ASSERT `s 286.1(2) the person has committed a subsequent offence` (LIST (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 286.1, "(2)"), FALSE, (Date 1 3 2015))) (Date 1 3 2020) EQUALS JUST TRUE   -- an earlier offence under (2)
#ASSERT `s 286.1(2) the person has committed a subsequent offence` (LIST (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 212, "(4)"), TRUE, (Date 1 3 2015))) (Date 1 3 2020) EQUALS JUST TRUE   -- an earlier offence under former 212(4)
#ASSERT `s 286.1(2) the person has committed a subsequent offence` (LIST (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 286.1, "(1)"), FALSE, (Date 1 3 2015))) (Date 1 3 2020) EQUALS NOTHING   -- an offence under (1): not listed for (2)
#ASSERT `s 286.1(2) the person has committed a subsequent offence` (LIST (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 286.1, "(2)"), FALSE, (Date 1 3 2025))) (Date 1 3 2020) EQUALS JUST FALSE   -- convicted later: not earlier, whatever the commission dates
#ASSERT `s 286.1(2) the person has committed a subsequent offence` (LIST (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 286.1, "(2)"), FALSE, (Date 1 3 2020))) (Date 1 3 2020) EQUALS NOTHING   -- the same day
#ASSERT `s 286.1(2) the person has committed a subsequent offence` (LIST (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 286.1, "(1)"), FALSE, (Date 1 3 2015)), (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 286.1, "(2)"), FALSE, (Date 1 3 2016))) (Date 1 3 2020) EQUALS JUST TRUE   -- one counting conviction decides it
#ASSERT `s 286.1(1) the person has committed a subsequent offence` (EMPTY) (Date 1 3 2020) EQUALS JUST FALSE   -- a first offence
#ASSERT `s 286.1(1) the person has committed a subsequent offence` (LIST (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 286.1, "(1)"), FALSE, (Date 1 3 2015))) (Date 1 3 2020) EQUALS JUST TRUE   -- an earlier offence under (1), by sequence of convictions (fork F35)
#ASSERT `s 286.1(1) the person has committed a subsequent offence` (LIST (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 286.1, "(2)"), FALSE, (Date 1 3 2015))) (Date 1 3 2020) EQUALS NOTHING   -- an offence under (2): the text does not say it makes (1) a subsequent offence
#ASSERT `s 286.1(1) the person has committed a subsequent offence` (LIST (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 286.1, "(1)"), FALSE, (Date 1 3 2025))) (Date 1 3 2020) EQUALS JUST FALSE   -- convicted later
#ASSERT `s 286.1(1) the person has committed a subsequent offence` (LIST (`s 286.1(3) earlier conviction` OF (`Provision of the Code` OF 286.1, "(1)"), FALSE, (Date 1 3 2020))) (Date 1 3 2020) EQUALS NOTHING   -- the same day
-- (2): the offence against a person under 18.
#ASSERT `s 286.1(2) the person is guilty of the offence of obtaining sexual services from a person under 18 years` (JUST TRUE) TRUE EQUALS JUST TRUE   -- "the sexual services of a person under the age of 18 years"
#ASSERT `s 286.1(2) the person is guilty of the offence of obtaining sexual services from a person under 18 years` (JUST TRUE) FALSE EQUALS NOTHING   -- not a person under 18
#ASSERT `s 286.1(2) the person is guilty of the offence of obtaining sexual services from a person under 18 years` NOTHING TRUE EQUALS NOTHING   -- the place is not determined
#ASSERT `s 286.1(2) the class of the offence` EQUALS `an indictable offence`   -- "guilty of an indictable offence"

-- (2) punishment: "a minimum punishment of imprisonment for a term of (a) for a first offence, six months; and (b) for each subsequent offence, one year", maximum fourteen years.
`s 286.1(2) fixture: fourteen years with a minimum of six months` MEANS JUST (Punishment OF `by indictment`, (`imprisonment for a term of` `fourteen years`), (`imprisonment for a term of` `six months`), `no fine is stated`, `no fine is stated`)
`s 286.1(2) fixture: fourteen years with a minimum of one year` MEANS JUST (Punishment OF `by indictment`, (`imprisonment for a term of` `fourteen years`), (`imprisonment for a term of` (`Length of time` OF 1, 0, 0, FALSE)), `no fine is stated`, `no fine is stated`)
#ASSERT `s 286.1(2) the punishment` (JUST FALSE) EQUALS `s 286.1(2) fixture: fourteen years with a minimum of six months`   -- (a): a first offence
#ASSERT `s 286.1(2) the punishment` (JUST TRUE) EQUALS `s 286.1(2) fixture: fourteen years with a minimum of one year`   -- (b): each subsequent offence
#ASSERT `s 286.1(2) the punishment` NOTHING EQUALS NOTHING   -- first or subsequent not determined

§ `s 286.2 -- Material benefit from sexual services`

#ASSERT `s 286.2(1) the person is guilty of the offence of receiving a material benefit from sexual services` TRUE TRUE EQUALS JUST TRUE   -- receives a benefit, knowing
#ASSERT `s 286.2(1) the person is guilty of the offence of receiving a material benefit from sexual services` TRUE FALSE EQUALS NOTHING   -- no knowledge
#ASSERT `s 286.2(1) the person is guilty of the offence of receiving a material benefit from sexual services` FALSE TRUE EQUALS NOTHING   -- no benefit
#ASSERT `s 286.2(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT (`s 286.2(1) the punishment` `by indictment` `s 286.1 fixture: the general summary conviction penalty`)'s `maximum imprisonment` EQUALS `imprisonment for a term of` `ten years`   -- (a): "not more than 10 years"
#ASSERT `s 286.2(1) the punishment` `on summary conviction` `s 286.1 fixture: the general summary conviction penalty` EQUALS `s 286.1 fixture: the general summary conviction penalty`   -- (b): s 787(1)
#ASSERT `s 286.2(2) the person is guilty of the offence of receiving a material benefit from sexual services provided by a person under 18 years` TRUE TRUE EQUALS JUST TRUE   -- receives a benefit, knowing
#ASSERT `s 286.2(2) the person is guilty of the offence of receiving a material benefit from sexual services provided by a person under 18 years` TRUE FALSE EQUALS NOTHING   -- no knowledge
#ASSERT `s 286.2(2) the class of the offence` EQUALS `an indictable offence`   -- "guilty of an indictable offence"
#ASSERT `s 286.2(2) the punishment` EQUALS `s 286.1 fixture: at most and at least` 14 2   -- "not more than 14 years and to a minimum punishment of imprisonment for a term of two years"
-- Argument order of (3): lives with or is habitually in the company of a person who offers or provides sexual services; evidence to the contrary.
#ASSERT `s 286.2(3) the evidence is proof that the person received a financial or other material benefit from those services` TRUE FALSE EQUALS JUST TRUE   -- the presumption operates
#ASSERT `s 286.2(3) the evidence is proof that the person received a financial or other material benefit from those services` TRUE TRUE EQUALS NOTHING   -- evidence to the contrary
#ASSERT `s 286.2(3) the evidence is proof that the person received a financial or other material benefit from those services` FALSE FALSE EQUALS NOTHING   -- no cohabitation or company
-- Argument order of (5): commits an offence under (1) or (2); (a) violence, intimidation or coercion; (b) abused a position; (c) provided a drug; (d) conduct that would constitute an offence under 286.3; (e) a commercial enterprise.
#ASSERT `s 286.2(5) subsection (4) does not apply to the person` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 286.2(5) subsection (4) does not apply to the person` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- (b)
#ASSERT `s 286.2(5) subsection (4) does not apply to the person` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- (c)
#ASSERT `s 286.2(5) subsection (4) does not apply to the person` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE   -- (d)
#ASSERT `s 286.2(5) subsection (4) does not apply to the person` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- (e)
#ASSERT `s 286.2(5) subsection (4) does not apply to the person` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- none of (a) to (e)
#ASSERT `s 286.2(5) subsection (4) does not apply to the person` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- not a person who commits an offence under (1) or (2)
-- Argument order of (4): (a) legitimate living arrangement; (b) legal or moral obligation; (c) service or good offered to the general public; (d) a service not offered to the public, not counselled or encouraged, the benefit proportionate; the answer of (5).
#ASSERT `s 286.2(4) subsections (1) and (2) do not apply to the person who receives the benefit` TRUE FALSE FALSE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE   -- (a)
#ASSERT `s 286.2(4) subsections (1) and (2) do not apply to the person who receives the benefit` FALSE TRUE FALSE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE   -- (b)
#ASSERT `s 286.2(4) subsections (1) and (2) do not apply to the person who receives the benefit` FALSE FALSE TRUE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE   -- (c)
#ASSERT `s 286.2(4) subsections (1) and (2) do not apply to the person who receives the benefit` FALSE FALSE FALSE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE   -- (d): all three conditions
#ASSERT `s 286.2(4) subsections (1) and (2) do not apply to the person who receives the benefit` FALSE FALSE FALSE TRUE FALSE TRUE (JUST FALSE) EQUALS JUST FALSE   -- (d): they counselled or encouraged
#ASSERT `s 286.2(4) subsections (1) and (2) do not apply to the person who receives the benefit` FALSE FALSE FALSE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE   -- (d): not proportionate
#ASSERT `s 286.2(4) subsections (1) and (2) do not apply to the person who receives the benefit` FALSE FALSE FALSE FALSE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE   -- (d): no such service
#ASSERT `s 286.2(4) subsections (1) and (2) do not apply to the person who receives the benefit` FALSE FALSE FALSE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST FALSE   -- none of (a) to (d)
#ASSERT `s 286.2(4) subsections (1) and (2) do not apply to the person who receives the benefit` TRUE FALSE FALSE FALSE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE   -- "Subject to subsection (5)": (5) applies, the exception does not
#ASSERT `s 286.2(4) subsections (1) and (2) do not apply to the person who receives the benefit` TRUE FALSE FALSE FALSE FALSE FALSE NOTHING EQUALS NOTHING   -- (5) is not determined
#ASSERT `s 286.2(4) subsections (1) and (2) do not apply to the person who receives the benefit` FALSE FALSE FALSE FALSE FALSE FALSE NOTHING EQUALS JUST FALSE   -- no limb holds, so (5) does not matter
#ASSERT `s 286.2(6) the court shall consider as an aggravating factor that the person received the benefit in the context of a commercial enterprise` TRUE TRUE EQUALS JUST TRUE   -- convicted, commercial enterprise
#ASSERT `s 286.2(6) the court shall consider as an aggravating factor that the person received the benefit in the context of a commercial enterprise` TRUE FALSE EQUALS NOTHING   -- no commercial enterprise
#ASSERT `s 286.2(6) the court shall consider as an aggravating factor that the person received the benefit in the context of a commercial enterprise` FALSE TRUE EQUALS NOTHING   -- not convicted under this section
-- #TRACE (read): the court considers it at time 1 -> FULFILLED.
#TRACE `s 286.2(6) the duty of the court` AT 0 WITH
    PARTY `the court` DOES `s 286.2(6) consider as an aggravating factor that the person received the benefit in the context of a commercial enterprise that offers sexual services for consideration` AT 1

§ `ss 286.3 and 286.4 -- Procuring and advertising`

#ASSERT `s 286.3(1) the person is guilty of the offence of procuring` TRUE FALSE EQUALS JUST TRUE   -- procures
#ASSERT `s 286.3(1) the person is guilty of the offence of procuring` FALSE TRUE EQUALS JUST TRUE   -- recruits, holds ... for the purpose of facilitating
#ASSERT `s 286.3(1) the person is guilty of the offence of procuring` FALSE FALSE EQUALS NOTHING   -- neither
#ASSERT `s 286.3(1) the class of the offence` EQUALS `an indictable offence`   -- "guilty of an indictable offence"
#ASSERT (`s 286.3(1) the punishment`)'s `maximum imprisonment` EQUALS `imprisonment for a term of` `fourteen years`   -- "not more than 14 years"
#ASSERT (`s 286.3(1) the punishment`)'s `minimum imprisonment` EQUALS `no imprisonment is stated`   -- no minimum is stated
#ASSERT `s 286.3(2) the person is guilty of the offence of procuring a person under 18 years` TRUE FALSE EQUALS JUST TRUE   -- procures a person under 18
#ASSERT `s 286.3(2) the person is guilty of the offence of procuring a person under 18 years` FALSE TRUE EQUALS JUST TRUE   -- recruits ... for the purpose of facilitating an offence under 286.1(2)
#ASSERT `s 286.3(2) the person is guilty of the offence of procuring a person under 18 years` FALSE FALSE EQUALS NOTHING   -- neither
#ASSERT `s 286.3(2) the class of the offence` EQUALS `an indictable offence`   -- "guilty of an indictable offence"
#ASSERT `s 286.3(2) the punishment` EQUALS `s 286.1 fixture: at most and at least` 14 5   -- "not more than 14 years and to a minimum punishment of imprisonment for a term of five years"
#ASSERT `s 286.4 the person is guilty of the offence of advertising sexual services` TRUE EQUALS JUST TRUE   -- knowingly advertises
#ASSERT `s 286.4 the person is guilty of the offence of advertising sexual services` FALSE EQUALS NOTHING   -- no advertisement
#ASSERT `s 286.4 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT (`s 286.4 the punishment` `by indictment` `s 286.1 fixture: the general summary conviction penalty`)'s `maximum imprisonment` EQUALS `imprisonment for a term of` `five years`   -- (a): "not more than five years"
#ASSERT `s 286.4 the punishment` `on summary conviction` `s 286.1 fixture: the general summary conviction penalty` EQUALS `s 286.1 fixture: the general summary conviction penalty`   -- (b): s 787(1)

§ `s 286.5 -- Immunities`

#ASSERT `s 286.5(1)(a) the person is immune from prosecution for an offence under section 286.2` (`Provision of the Code` OF 286.2, "(1)") TRUE EQUALS JUST TRUE   -- the benefit is from their own sexual services
#ASSERT `s 286.5(1)(a) the person is immune from prosecution for an offence under section 286.2` (`Provision of the Code` OF 286.2, "(2)") FALSE EQUALS JUST FALSE   -- not their own: this section gives no immunity on these facts
#ASSERT `s 286.5(1)(a) the person is immune from prosecution for an offence under section 286.2` (`Provision of the Code` OF 286.4, "") TRUE EQUALS NOTHING   -- not an offence under section 286.2
#ASSERT `s 286.5(1)(b) the person is immune from prosecution for an offence under section 286.4` (`Provision of the Code` OF 286.4, "") TRUE EQUALS JUST TRUE   -- the advertisement of their own sexual services
#ASSERT `s 286.5(1)(b) the person is immune from prosecution for an offence under section 286.4` (`Provision of the Code` OF 286.4, "") FALSE EQUALS JUST FALSE   -- not their own: this section gives no immunity on these facts
#ASSERT `s 286.5(1)(b) the person is immune from prosecution for an offence under section 286.4` (`Provision of the Code` OF 286.2, "(1)") TRUE EQUALS NOTHING   -- not an offence under section 286.4
-- The compositions. Argument order: the offence; subsection (4); the immunity.
#ASSERT `s 286.2 and s 286.5(1)(a) the person is guilty of the offence after the exception and the immunity` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- no exception, no immunity
#ASSERT `s 286.2 and s 286.5(1)(a) the person is guilty of the offence after the exception and the immunity` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE   -- subsection (4): "do not apply"
#ASSERT `s 286.2 and s 286.5(1)(a) the person is guilty of the offence after the exception and the immunity` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE   -- the immunity: "No person shall be prosecuted"
#ASSERT `s 286.2 and s 286.5(1)(a) the person is guilty of the offence after the exception and the immunity` (JUST TRUE) NOTHING (JUST FALSE) EQUALS NOTHING   -- (4) not determined
#ASSERT `s 286.2 and s 286.5(1)(a) the person is guilty of the offence after the exception and the immunity` (JUST TRUE) (JUST FALSE) NOTHING EQUALS NOTHING   -- the immunity is not determined
#ASSERT `s 286.2 and s 286.5(1)(a) the person is guilty of the offence after the exception and the immunity` NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING   -- the offence is not determined
#ASSERT `s 286.4 and s 286.5(1)(b) the person is guilty of the offence after the immunity` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- no immunity
#ASSERT `s 286.4 and s 286.5(1)(b) the person is guilty of the offence after the immunity` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE   -- immune
#ASSERT `s 286.4 and s 286.5(1)(b) the person is guilty of the offence after the immunity` (JUST TRUE) NOTHING EQUALS NOTHING   -- not determined
#ASSERT `s 286.4 and s 286.5(1)(b) the person is guilty of the offence after the immunity` NOTHING (JUST FALSE) EQUALS NOTHING   -- the offence is not determined
-- (2): aiding, abetting, conspiring, attempting, accessory after the fact, counselling. Argument order: the offence; accused as such a party; relates to their own sexual services.
#ASSERT `s 286.5(2) the person is immune from prosecution for being a party to an offence under any of sections 286.1 to 286.4` (`Provision of the Code` OF 286.1, "(1)") TRUE TRUE EQUALS JUST TRUE   -- section 286.1
#ASSERT `s 286.5(2) the person is immune from prosecution for being a party to an offence under any of sections 286.1 to 286.4` (`Provision of the Code` OF 286.3, "(1)") TRUE TRUE EQUALS JUST TRUE   -- section 286.3
#ASSERT `s 286.5(2) the person is immune from prosecution for being a party to an offence under any of sections 286.1 to 286.4` (`Provision of the Code` OF 286.4, "") TRUE TRUE EQUALS JUST TRUE   -- section 286.4
#ASSERT `s 286.5(2) the person is immune from prosecution for being a party to an offence under any of sections 286.1 to 286.4` (`Provision of the Code` OF 286.2, "(1)") TRUE FALSE EQUALS JUST FALSE   -- not their own sexual services: no immunity on these facts
#ASSERT `s 286.5(2) the person is immune from prosecution for being a party to an offence under any of sections 286.1 to 286.4` (`Provision of the Code` OF 286.5, "(1)") TRUE TRUE EQUALS NOTHING   -- section 286.5 is outside 286.1 to 286.4
#ASSERT `s 286.5(2) the person is immune from prosecution for being a party to an offence under any of sections 286.1 to 286.4` (`Provision of the Code` OF 286, "") TRUE TRUE EQUALS NOTHING   -- section 286 precedes 286.1
#ASSERT `s 286.5(2) the person is immune from prosecution for being a party to an offence under any of sections 286.1 to 286.4` (`Provision of the Code` OF 286.2, "(1)") FALSE TRUE EQUALS NOTHING   -- not accused as a party but as the principal
