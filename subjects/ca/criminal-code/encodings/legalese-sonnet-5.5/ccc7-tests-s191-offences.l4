IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc7-s183-base`
IMPORT `ccc7-s191-offences`

-- ccc7-tests-s191-offences.l4 -- tests for ccc7-s191-offences.l4 (ss 191, 192, 193, 193.1, 194). Expected values are written by hand from the text, beside each assertion.

`s 191 test the penalty of section 787(1)` MEANS
    Punishment WITH `mode` IS `on summary conviction`
                    `maximum imprisonment` IS `imprisonment for a term of` `two years less a day`
                    `minimum imprisonment` IS `no imprisonment is stated`
                    `maximum fine` IS `a fine of` 5000
                    `minimum fine` IS `no fine is stated`

§ `Tests -- section 191(2): the exemptions`

-- (a) args: police officer (s 183), in possession of a device or component, in the course of his employment
#ASSERT `s 191(2)(a) a police officer is in possession in the course of employment` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 191(2)(a) a police officer is in possession in the course of employment` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 191(2)(a) a police officer is in possession in the course of employment` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 191(2)(a) a police officer is in possession in the course of employment` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 191(2)(a) a police officer is in possession in the course of employment` NOTHING TRUE TRUE EQUALS NOTHING
-- (b) args: the instrument is an authorization (s 183), in possession to use it in an interception in accordance with it
#ASSERT `s 191(2)(b) a person is in possession to use it in an interception in accordance with an authorization` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 191(2)(b) a person is in possession to use it in an interception in accordance with an authorization` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 191(2)(b) a person is in possession to use it in an interception in accordance with an authorization` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 191(2)(b) a person is in possession to use it in an interception in accordance with an authorization` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 191(2)(b.1) a person is in possession under the direction of a police officer to assist that officer` TRUE EQUALS JUST TRUE
#ASSERT `s 191(2)(b.1) a person is in possession under the direction of a police officer to assist that officer` FALSE EQUALS JUST FALSE
#ASSERT `s 191(2)(c) an officer, servant or member of the Canadian Forces is in possession in the course of duties` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 191(2)(c) an officer, servant or member of the Canadian Forces is in possession in the course of duties` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 191(2)(c) an officer, servant or member of the Canadian Forces is in possession in the course of duties` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 191(2)(d) a person is in possession under the authority of a licence` TRUE EQUALS JUST TRUE
#ASSERT `s 191(2)(d) a person is in possession under the authority of a licence` FALSE EQUALS JUST FALSE
-- (2) args (a), (b), (b.1), (c), (d)
#ASSERT `s 191(2) subsection (1) does not apply to the person` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 191(2) subsection (1) does not apply to the person` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 191(2) subsection (1) does not apply to the person` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 191(2) subsection (1) does not apply to the person` (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING

§ `Tests -- section 191(1): the offence`

-- args: possesses, sells (s 183), purchases, device (s 183), component, knowing, exemption (s 191(2))
#ASSERT `s 191(1) the person is guilty of an offence under the subsection` TRUE (JUST FALSE) FALSE (JUST TRUE) FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
-- "possesses, sells or purchases": each suffices
#ASSERT `s 191(1) the person is guilty of an offence under the subsection` FALSE (JUST TRUE) FALSE (JUST TRUE) FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 191(1) the person is guilty of an offence under the subsection` FALSE (JUST FALSE) TRUE (JUST TRUE) FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
-- "any device or any component of it"
#ASSERT `s 191(1) the person is guilty of an offence under the subsection` TRUE (JUST FALSE) FALSE (JUST FALSE) TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
-- none of the three acts
#ASSERT `s 191(1) the person is guilty of an offence under the subsection` FALSE (JUST FALSE) FALSE (JUST TRUE) FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
-- neither a device nor a component
#ASSERT `s 191(1) the person is guilty of an offence under the subsection` TRUE (JUST FALSE) FALSE (JUST FALSE) FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
-- without knowing that its design renders it primarily useful for surreptitious interception
#ASSERT `s 191(1) the person is guilty of an offence under the subsection` TRUE (JUST FALSE) FALSE (JUST TRUE) FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
-- an exemption applies: "Subsection (1) does not apply to"
#ASSERT `s 191(1) the person is guilty of an offence under the subsection` TRUE (JUST FALSE) FALSE (JUST TRUE) FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
-- not covered: an act "sell includes" does not name; an exemption turning on a term not covered
#ASSERT `s 191(1) the person is guilty of an offence under the subsection` FALSE NOTHING FALSE (JUST TRUE) FALSE TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 191(1) the person is guilty of an offence under the subsection` TRUE (JUST FALSE) FALSE (JUST TRUE) FALSE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 191(1)(a) the punishment on indictment`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `two years`
#ASSERT `s 191(1)(a) the punishment on indictment`'s `mode` EQUALS `by indictment`
#ASSERT (`s 191(1) the punishments` `s 191 test the penalty of section 787(1)`) EQUALS (LIST `s 191(1)(a) the punishment on indictment` , `s 191 test the penalty of section 787(1)`)
#ASSERT `s 191(1)(b) the punishment on summary conviction` `s 191 test the penalty of section 787(1)` EQUALS `s 191 test the penalty of section 787(1)`
#ASSERT `s 191(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
-- 191(3): the licence terms
#ASSERT `s 191(3) the licence may contain the term` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 191(3) the licence may contain the term` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 191(3) the licence may contain the term` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 191(3) the licence may contain the term` TRUE TRUE FALSE EQUALS NOTHING

§ `Tests -- section 192`

#ASSERT `s 192(1) the device may be ordered forfeited to Her Majesty` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 192(1) the device may be ordered forfeited to Her Majesty` TRUE FALSE EQUALS NOTHING
-- "Where a person is convicted of an offence under section 184 or 191": a failed "Where" is JUST FALSE under the guide's ruling (b) (F11)
#ASSERT `s 192(1) the device may be ordered forfeited to Her Majesty` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 192(1) the forfeited device may be disposed of as the Attorney General directs` TRUE EQUALS JUST TRUE
#ASSERT `s 192(1) the forfeited device may be disposed of as the Attorney General directs` FALSE EQUALS NOTHING
-- (2) args: the thing is a provider's facilities or equipment by means of which a section 184 offence was committed, the provider was a party to the offence
#ASSERT `s 192(2) no order for forfeiture shall be made` TRUE FALSE EQUALS JUST TRUE
-- "if that person was not a party to the offence": the bar falls away where the provider was a party
#ASSERT `s 192(2) no order for forfeiture shall be made` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 192(2) no order for forfeiture shall be made` FALSE FALSE EQUALS NOTHING

§ `Tests -- section 193(2) and (3): the exemptions`

#ASSERT `s 193(2)(a) the disclosure is in the course of or for the purpose of giving evidence` TRUE EQUALS JUST TRUE
#ASSERT `s 193(2)(a) the disclosure is in the course of or for the purpose of giving evidence` FALSE EQUALS JUST FALSE
-- (b) args: in the course of a criminal investigation, lawfully intercepted
#ASSERT `s 193(2)(b) the disclosure is in the course of or for the purpose of a criminal investigation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 193(2)(b) the disclosure is in the course of or for the purpose of a criminal investigation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 193(2)(b) the disclosure is in the course of or for the purpose of a criminal investigation` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 193(2)(c) the disclosure is in giving notice under section 189 or furnishing further particulars under section 190` TRUE EQUALS JUST TRUE
#ASSERT `s 193(2)(c) the disclosure is in giving notice under section 189 or furnishing further particulars under section 190` FALSE EQUALS JUST FALSE
-- (d) args: communication service to the public, department or agency, computer system services, computer system (s 342.1(2)), necessarily incidental to an interception in 184(2)(c), (d) or (e)
#ASSERT `s 193(2)(d) the disclosure is necessarily incidental to an interception described in paragraph 184(2)(c), (d) or (e)` TRUE FALSE FALSE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 193(2)(d) the disclosure is necessarily incidental to an interception described in paragraph 184(2)(c), (d) or (e)` FALSE TRUE FALSE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 193(2)(d) the disclosure is necessarily incidental to an interception described in paragraph 184(2)(c), (d) or (e)` FALSE FALSE TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
-- not "necessarily incidental"
#ASSERT `s 193(2)(d) the disclosure is necessarily incidental to an interception described in paragraph 184(2)(c), (d) or (e)` TRUE FALSE FALSE (JUST FALSE) FALSE EQUALS JUST FALSE
-- none of the three operations
#ASSERT `s 193(2)(d) the disclosure is necessarily incidental to an interception described in paragraph 184(2)(c), (d) or (e)` FALSE FALSE FALSE (JUST FALSE) TRUE EQUALS JUST FALSE
-- computer-system services where the thing is not a computer system as defined in 342.1(2); where that is not covered
#ASSERT `s 193(2)(d) the disclosure is necessarily incidental to an interception described in paragraph 184(2)(c), (d) or (e)` FALSE FALSE TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 193(2)(d) the disclosure is necessarily incidental to an interception described in paragraph 184(2)(c), (d) or (e)` FALSE FALSE TRUE NOTHING TRUE EQUALS NOTHING
-- (e) and (f)
#ASSERT `s 193(2)(e) the disclosure is made to a peace officer, prosecutor or foreign authority in the interests of the administration of justice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 193(2)(e) the disclosure is made to a peace officer, prosecutor or foreign authority in the interests of the administration of justice` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 193(2)(e) the disclosure is made to a peace officer, prosecutor or foreign authority in the interests of the administration of justice` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 193(2)(f) the disclosure is made to the Director of the Canadian Security Intelligence Service or an employee of the Service` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 193(2)(f) the disclosure is made to the Director of the Canadian Security Intelligence Service or an employee of the Service` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 193(2)(f) the disclosure is made to the Director of the Canadian Security Intelligence Service or an employee of the Service` FALSE TRUE EQUALS JUST FALSE
-- (2) args (a) to (f)
#ASSERT `s 193(2) subsection (1) does not apply to the person` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 193(2) subsection (1) does not apply to the person` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 193(2) subsection (1) does not apply to the person` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 193(2) subsection (1) does not apply to the person` (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 193(3) subsection (1) does not apply to a person who discloses what was already lawfully disclosed in evidence` TRUE EQUALS JUST TRUE
#ASSERT `s 193(3) subsection (1) does not apply to a person who discloses what was already lawfully disclosed in evidence` FALSE EQUALS JUST FALSE

§ `Tests -- section 193(1) and (1.1): the offence`

-- args: private communication (s 183), intercepted by a device (s 183), the interception was without the consent of a party, the person lacked the express consent, knowingly, uses or discloses it, discloses its existence, exemption (193(2) or (3))
#ASSERT `s 193(1) the person commits an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
-- (b) discloses the existence
#ASSERT `s 193(1) the person commits an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
-- neither use/disclosure nor disclosure of the existence
#ASSERT `s 193(1) the person commits an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
-- the offence's own "If" clause: the interception was with the consent (express or implied) of a party
#ASSERT `s 193(1) the person commits an offence under the subsection` (JUST TRUE) (JUST TRUE) FALSE TRUE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
-- the person had the express consent
#ASSERT `s 193(1) the person commits an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE FALSE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
-- not knowingly
#ASSERT `s 193(1) the person commits an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE TRUE FALSE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
-- not intercepted by a device; not a private communication
#ASSERT `s 193(1) the person commits an offence under the subsection` (JUST TRUE) (JUST FALSE) TRUE TRUE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 193(1) the person commits an offence under the subsection` (JUST FALSE) (JUST TRUE) TRUE TRUE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
-- exempted by 193(2) or (3)
#ASSERT `s 193(1) the person commits an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
-- not covered
#ASSERT `s 193(1) the person commits an offence under the subsection` NOTHING (JUST TRUE) TRUE TRUE TRUE TRUE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 193(1) the person commits an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE TRUE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 193(1.1)(a) the punishment on indictment`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `two years`
#ASSERT (`s 193(1.1) the punishments` `s 191 test the penalty of section 787(1)`) EQUALS (LIST `s 193(1.1)(a) the punishment on indictment` , `s 191 test the penalty of section 787(1)`)
#ASSERT `s 193(1.1)(b) the punishment on summary conviction` `s 191 test the penalty of section 787(1)` EQUALS `s 191 test the penalty of section 787(1)`
#ASSERT `s 193(1.1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`

§ `Tests -- section 193.1`

-- (1) args: radio-based telephone communication (s 183), uses or discloses (or discloses its existence), knowingly, (a) in Canada, (b) intercepted without consent, (c) the person lacks consent, exemption by 193.1(2)
#ASSERT `s 193.1(1) the person is guilty of an offence under the subsection` (JUST TRUE) TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
-- the "if" clause: each of (a), (b), (c) failing
#ASSERT `s 193.1(1) the person is guilty of an offence under the subsection` (JUST TRUE) TRUE TRUE FALSE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 193.1(1) the person is guilty of an offence under the subsection` (JUST TRUE) TRUE TRUE TRUE FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 193.1(1) the person is guilty of an offence under the subsection` (JUST TRUE) TRUE TRUE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 193.1(1) the person is guilty of an offence under the subsection` (JUST TRUE) FALSE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 193.1(1) the person is guilty of an offence under the subsection` (JUST TRUE) TRUE FALSE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 193.1(1) the person is guilty of an offence under the subsection` (JUST FALSE) TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
-- exempted by 193(2) or (3) as they apply by 193.1(2); not covered
#ASSERT `s 193.1(1) the person is guilty of an offence under the subsection` (JUST TRUE) TRUE TRUE TRUE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 193.1(1) the person is guilty of an offence under the subsection` (JUST TRUE) TRUE TRUE TRUE TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 193.1(1) the person is guilty of an offence under the subsection` NOTHING TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 193.1(1)(a) the punishment on indictment`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `two years`
#ASSERT (`s 193.1(1) the punishments` `s 191 test the penalty of section 787(1)`) EQUALS (LIST `s 193.1(1)(a) the punishment on indictment` , `s 191 test the penalty of section 787(1)`)
#ASSERT `s 193.1(1)(b) the punishment on summary conviction` `s 191 test the penalty of section 787(1)` EQUALS `s 191 test the penalty of section 787(1)`
#ASSERT `s 193.1(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 193.1(2) subsections 193(2) and (3) apply to the disclosure` TRUE EQUALS JUST TRUE
#ASSERT `s 193.1(2) subsections 193(2) and (3) apply to the disclosure` FALSE EQUALS NOTHING

§ `Tests -- section 194`

-- (2) args: the person has commenced an action under Part II of the Crown Liability Act
#ASSERT `s 194(2) no amount shall be ordered to be paid to the person` TRUE EQUALS JUST TRUE
#ASSERT `s 194(2) no amount shall be ordered to be paid to the person` FALSE EQUALS NOTHING
-- (1) args: the offence of which the accused is convicted, on the application of a person aggrieved, at the time sentence is imposed, the amount in dollars, the answer for (2)
#ASSERT `s 194(1) the court may order the accused to pay punitive damages to the person aggrieved` (`Provision of the Code` OF 184 , "(1)") TRUE TRUE 5000 NOTHING EQUALS JUST TRUE
#ASSERT `s 194(1) the court may order the accused to pay punitive damages to the person aggrieved` (`Provision of the Code` OF 184.5 , "(1)") TRUE TRUE 1 (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 194(1) the court may order the accused to pay punitive damages to the person aggrieved` (`Provision of the Code` OF 193 , "(1)") TRUE TRUE 100 NOTHING EQUALS JUST TRUE
#ASSERT `s 194(1) the court may order the accused to pay punitive damages to the person aggrieved` (`Provision of the Code` OF 193.1 , "(1)") TRUE TRUE 2500 NOTHING EQUALS JUST TRUE
-- "an amount not exceeding five thousand dollars": 5,000.01 is outside the grant
#ASSERT `s 194(1) the court may order the accused to pay punitive damages to the person aggrieved` (`Provision of the Code` OF 184 , "(1)") TRUE TRUE 5000.01 NOTHING EQUALS NOTHING
-- not an offence under section 184, 184.5, 193 or 193.1; no application; not at the time of sentence
#ASSERT `s 194(1) the court may order the accused to pay punitive damages to the person aggrieved` (`Provision of the Code` OF 191 , "(1)") TRUE TRUE 100 NOTHING EQUALS NOTHING
#ASSERT `s 194(1) the court may order the accused to pay punitive damages to the person aggrieved` (`Provision of the Code` OF 184 , "(1)") FALSE TRUE 100 NOTHING EQUALS NOTHING
#ASSERT `s 194(1) the court may order the accused to pay punitive damages to the person aggrieved` (`Provision of the Code` OF 184 , "(1)") TRUE FALSE 100 NOTHING EQUALS NOTHING
-- "Subject to subsection (2)": the person has commenced a Crown Liability Act action
#ASSERT `s 194(1) the court may order the accused to pay punitive damages to the person aggrieved` (`Provision of the Code` OF 184 , "(1)") TRUE TRUE 100 (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 194(1) the most that may be ordered as punitive damages, in dollars` EQUALS 5000
-- (3) args: the amount is not paid forthwith, the order is filed in the superior court of the province in which the trial was held
#ASSERT `s 194(3) the applicant may enter the order as a judgment` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 194(3) the applicant may enter the order as a judgment` TRUE FALSE EQUALS NOTHING
-- "Where ... is not paid forthwith": a failed "Where" is JUST FALSE under the guide's ruling (b) (F11)
#ASSERT `s 194(3) the applicant may enter the order as a judgment` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 194(3) the judgment is enforceable against the accused as a civil judgment of the court` TRUE EQUALS JUST TRUE
#ASSERT `s 194(3) the judgment is enforceable against the accused as a civil judgment of the court` FALSE EQUALS NOTHING
-- (4) args: an amount has been ordered, moneys found in the possession of the accused at arrest, a dispute by claimants other than the accused
#ASSERT `s 194(4) the amount may be taken out of the moneys found in the possession of the accused` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 194(4) the amount may be taken out of the moneys found in the possession of the accused` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 194(4) the amount may be taken out of the moneys found in the possession of the accused` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 194(4) the amount may be taken out of the moneys found in the possession of the accused` FALSE TRUE FALSE EQUALS NOTHING

