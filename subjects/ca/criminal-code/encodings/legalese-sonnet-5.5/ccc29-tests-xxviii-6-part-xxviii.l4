IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc29-xxviii-6-part-xxviii`

-- ccc29-tests-xxviii-6-part-xxviii.l4 -- tests for sections 841 to 849 of the Criminal Code (Canada).
-- Every expected value is written from the text before the run, beside its assertion. Argument order is the GIVEN order of each function.

§ `Tests -- section 841`

#ASSERT `s 841 the definitions apply` 841 EQUALS JUST TRUE
#ASSERT `s 841 the definitions apply` 842 EQUALS JUST TRUE
#ASSERT `s 841 the definitions apply` 847 EQUALS JUST TRUE
#ASSERT `s 841 the definitions apply` 840 EQUALS NOTHING
#ASSERT `s 841 the definitions apply` 848 EQUALS NOTHING
#ASSERT `s 841 data` TRUE EQUALS JUST TRUE
#ASSERT `s 841 data` FALSE EQUALS JUST FALSE
-- electronic document: (data, recorded or stored, can be read, a display or print-out or other output, a document ... that contains the data).
#ASSERT `s 841 electronic document` (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 841 electronic document` (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 841 electronic document` (JUST TRUE) FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 841 electronic document` (JUST FALSE) TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 841 electronic document` (JUST FALSE) FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 841 electronic document` (JUST FALSE) FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 841 electronic document` NOTHING TRUE TRUE FALSE FALSE EQUALS NOTHING

§ `Tests -- sections 842 to 849`

#ASSERT `s 842 a court may create, collect, receive, store, transfer, distribute, publish or otherwise deal with electronic documents` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 842 a court may create, collect, receive, store, transfer, distribute, publish or otherwise deal with electronic documents` TRUE FALSE EQUALS NOTHING
#ASSERT `s 842 a court may create, collect, receive, store, transfer, distribute, publish or otherwise deal with electronic documents` FALSE TRUE EQUALS NOTHING
-- 843(1): (a court accepting, origin law, receiving law).
#ASSERT `s 843(1) a court may accept the transfer of data by electronic means` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 843(1) a court may accept the transfer of data by electronic means` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 843(1) a court may accept the transfer of data by electronic means` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 843(1) a court may accept the transfer of data by electronic means` FALSE TRUE TRUE EQUALS NOTHING
-- 843(2): (required to be filed and filed by electronic transfer, accepted by the court).
#ASSERT `s 843(2) the filing is complete` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 843(2) the filing is complete` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 843(2) the filing is complete` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 844 the requirement that a document be made in writing is satisfied` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 844 the requirement that a document be made in writing is satisfied` TRUE FALSE EQUALS NOTHING
#ASSERT `s 844 the requirement that a document be made in writing is satisfied` FALSE TRUE EQUALS NOTHING
#ASSERT `s 845 the court may accept a signature in an electronic document` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 845 the court may accept a signature in an electronic document` TRUE FALSE EQUALS NOTHING
#ASSERT `s 845 the court may accept a signature in an electronic document` FALSE TRUE EQUALS NOTHING
-- 846: (an information etc. is to be made, (a), (b), (c)).
#ASSERT `s 846 the court may accept the information, affidavit, solemn declaration or statement in the form of an electronic document` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 846 the court may accept the information, affidavit, solemn declaration or statement in the form of an electronic document` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 846 the court may accept the information, affidavit, solemn declaration or statement in the form of an electronic document` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 846 the court may accept the information, affidavit, solemn declaration or statement in the form of an electronic document` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 846 the court may accept the information, affidavit, solemn declaration or statement in the form of an electronic document` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- 847: (entitled to a copy, the document is in electronic form, pays a reasonable fee).
#ASSERT `s 847 the person is entitled to obtain a printed copy of the electronic document from the court` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 847 the person is entitled to obtain a printed copy of the electronic document from the court` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 847 the person is entitled to obtain a printed copy of the electronic document from the court` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 847 the person is entitled to obtain a printed copy of the electronic document from the court` FALSE TRUE TRUE EQUALS NOTHING
-- 849.
#ASSERT `s 849(1) the form is deemed to be good, valid and sufficient` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 849(1) the form is deemed to be good, valid and sufficient` TRUE FALSE EQUALS NOTHING
#ASSERT `s 849(1) the form is deemed to be good, valid and sufficient` FALSE TRUE EQUALS NOTHING
#ASSERT `s 849(2) the justice is required to attach or affix a seal` TRUE EQUALS JUST FALSE
#ASSERT `s 849(2) the justice is required to attach or affix a seal` FALSE EQUALS NOTHING
#ASSERT `s 849(3) the pre-printed portion is required to be printed in both official languages` TRUE EQUALS JUST TRUE
#ASSERT `s 849(3) the pre-printed portion is required to be printed in both official languages` FALSE EQUALS NOTHING
