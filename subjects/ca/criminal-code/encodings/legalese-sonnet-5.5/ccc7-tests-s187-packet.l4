IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc7-s183-base`
IMPORT `ccc7-s187-packet`

-- ccc7-tests-s187-packet.l4 -- tests for ccc7-s187-packet.l4 (ss 187, 189, 190). Expected values are written by hand from the text, beside each assertion.

§ `Tests -- section 187(1) and (1.1)`

#ASSERT `s 187(1) the document is confidential` TRUE EQUALS JUST TRUE
#ASSERT `s 187(1) the document is confidential` FALSE EQUALS NOTHING
-- (1.1) args: an authorization given under this Part, under 184.3(8) the original is in the hands of the judge
#ASSERT `s 187(1.1) the authorization need not be placed in the packet` TRUE FALSE EQUALS JUST TRUE
-- "except if, under subsection 184.3(8), the original authorization is in the hands of the judge"
#ASSERT `s 187(1.1) the authorization need not be placed in the packet` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 187(1.1) the authorization need not be placed in the packet` FALSE FALSE EQUALS NOTHING
#ASSERT `s 187(1.1) the judge must place the original authorization in the packet and the copy remains with the applicant` TRUE EQUALS JUST TRUE
#ASSERT `s 187(1.1) the judge must place the original authorization in the packet and the copy remains with the applicant` FALSE EQUALS JUST FALSE
-- (1) args: the document relates to an application under this Part, the answer for (1.1)
#ASSERT `s 187(1) the document must be placed in a packet and sealed` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 187(1) the document must be placed in a packet and sealed` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 187(1) the document must be placed in a packet and sealed` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 187(1) the document must be placed in a packet and sealed` FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 187(1) the packet is kept as the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 187(1) the packet is kept as the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 187(1) the packet is kept as the subsection requires` FALSE TRUE EQUALS JUST FALSE
-- "shall not be dealt with except in accordance with subsections (1.2) to (1.5)": the bar
#ASSERT `s 187(1) the packet shall not be dealt with in that way` `s 187(1) opening it to deal with an application for a further authorization or a renewal, under subsection (1.2)` EQUALS JUST FALSE
#ASSERT `s 187(1) the packet shall not be dealt with in that way` `s 187(1) opening it on an order of a judge, under subsection (1.3)` EQUALS JUST FALSE
#ASSERT `s 187(1) the packet shall not be dealt with in that way` `s 187(1) opening it on an order of the trial judge, under subsection (1.4)` EQUALS JUST FALSE
#ASSERT `s 187(1) the packet shall not be dealt with in that way` `s 187(1) destroying its contents on an order, under subsection (1.5)` EQUALS JUST FALSE
#ASSERT `s 187(1) the packet shall not be dealt with in that way` `s 187(1) any other dealing with it` EQUALS JUST TRUE
-- the sealing duty as a rule: the traces are read in NOTES.md (a DEONTIC cannot be asserted on the stable binary)
#TRACE `s 187(1) the duty to seal the packet as a rule` AT 0 WITH
    PARTY `s 183 a judge` DOES `s 187(1) places the documents in a packet and seals it` AT 0
#TRACE `s 187(1) the duty to seal the packet as a rule` AT 0 WITH
    (WAITUNTIL 5)

§ `Tests -- section 187(1.2) to (1.5)`

#ASSERT `s 187(1.2) the sealed packet may be opened and its contents removed` TRUE EQUALS JUST TRUE
#ASSERT `s 187(1.2) the sealed packet may be opened and its contents removed` FALSE EQUALS NOTHING
#ASSERT `s 187(1.3) the judge may order that the sealed packet be opened and its contents removed` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 187(1.3) the judge may order that the sealed packet be opened and its contents removed` TRUE FALSE EQUALS NOTHING
#ASSERT `s 187(1.3) the judge may order that the sealed packet be opened and its contents removed` FALSE TRUE EQUALS NOTHING
-- (1.4) args: a judge before whom a trial is to be held with jurisdiction in the province, (a) a matter relevant to the authorization or the evidence is in issue, (b) the accused applies to prepare for trial
#ASSERT `s 187(1.4) the trial judge may order that the sealed packet be opened and its contents removed` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 187(1.4) the trial judge may order that the sealed packet be opened and its contents removed` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 187(1.4) the trial judge may order that the sealed packet be opened and its contents removed` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 187(1.4) the trial judge may order that the sealed packet be opened and its contents removed` TRUE TRUE FALSE EQUALS NOTHING
-- (1.5) args: a sealed packet has been opened, the destruction is pursuant to an order of a judge of the same court
#ASSERT `s 187(1.5) the contents shall not be destroyed` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 187(1.5) the contents shall not be destroyed` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 187(1.5) the contents shall not be destroyed` FALSE FALSE EQUALS JUST FALSE

§ `Tests -- section 187(2) to (8)`

-- (2) args: the order concerns documents relating to an application under s 185, 186(6) or 196(2), the Attorney General or Minister has been given an opportunity to be heard
#ASSERT `s 187(2) the order may be made` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 187(2) the order may be made` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 187(2) the order may be made` FALSE FALSE EQUALS NOTHING
#ASSERT `s 187(3) the order may be made` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 187(3) the order may be made` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 187(3) the order may be made` FALSE TRUE EQUALS NOTHING
-- (4) args: a prosecution has been commenced and the accused applies under (1.3) or (1.4), the prosecutor has deleted the parts: "until" bar JUST TRUE before, JUST FALSE after
#ASSERT `s 187(4) the judge shall not yet provide a copy of the document to the accused` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 187(4) the judge shall not yet provide a copy of the document to the accused` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 187(4) the judge shall not yet provide a copy of the document to the accused` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 187(4) the prosecutor’s deletion covers the part` `s 187(4) a part that could compromise the identity of any confidential informant` EQUALS JUST TRUE
#ASSERT `s 187(4) the prosecutor’s deletion covers the part` `s 187(4) a part that could compromise the nature and extent of ongoing investigations` EQUALS JUST TRUE
#ASSERT `s 187(4) the prosecutor’s deletion covers the part` `s 187(4) a part that could endanger persons engaged in particular intelligence-gathering techniques and thereby prejudice future investigations in which similar techniques would be used` EQUALS JUST TRUE
#ASSERT `s 187(4) the prosecutor’s deletion covers the part` `s 187(4) a part that could prejudice the interests of innocent persons` EQUALS JUST TRUE
#ASSERT `s 187(4) the prosecutor’s deletion covers the part` `s 187(4) another part that the prosecutor believes would be prejudicial to the public interest` EQUALS JUST TRUE
#ASSERT `s 187(4) the prosecutor’s deletion covers the part` `s 187(4) a part that the prosecutor does not believe would be prejudicial to the public interest` EQUALS NOTHING
-- (5), (6)
#ASSERT `s 187(5) the accused is to be provided with an edited copy of the document` TRUE EQUALS JUST TRUE
#ASSERT `s 187(5) the accused is to be provided with an edited copy of the document` FALSE EQUALS JUST FALSE
#ASSERT `s 187(6) the prosecutor is bound to keep a copy of the original document` TRUE EQUALS JUST TRUE
#ASSERT `s 187(6) the prosecutor is bound to keep a copy of the original document` FALSE EQUALS JUST FALSE
#ASSERT `s 187(6) the edited copy and the original document are returned to the packet and the packet resealed` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 187(6) the edited copy and the original document are returned to the packet and the packet resealed` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 187(6) the edited copy and the original document are returned to the packet and the packet resealed` TRUE FALSE EQUALS JUST FALSE
#TRACE `s 187(6) the duty to keep a copy of the original document as a rule` AT 0 WITH
    PARTY `s 183 the prosecutor` DOES `s 187(6) keeps a copy of the original document` AT 1
-- (7) args: an edited copy has been provided under (5), the request is to the trial judge; the part is required for full answer and defence, a judicial summary would not be sufficient
#ASSERT `s 187(7) the accused may request that the deleted part be made available` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 187(7) the accused may request that the deleted part be made available` FALSE TRUE EQUALS NOTHING
#ASSERT `s 187(7) the accused may request that the deleted part be made available` TRUE FALSE EQUALS NOTHING
#ASSERT `s 187(7) the judge shall order that a copy of the part be made available to the accused` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 187(7) the judge shall order that a copy of the part be made available to the accused` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 187(7) the judge shall order that a copy of the part be made available to the accused` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 187(8) the rules of the section apply to the documents` TRUE EQUALS JUST TRUE
#ASSERT `s 187(8) the rules of the section apply to the documents` FALSE EQUALS NOTHING

§ `Tests -- sections 189 and 190`

-- 189(5) args: contents of a private communication obtained under this Part, reasonable notice given, form, transcript, statement of full particulars, statement of time, place, date and parties
-- the "unless" is met: notice with a transcript of a recording and the time/place/date statement
#ASSERT `s 189(5) the contents shall not be received in evidence` TRUE TRUE `s 189(5) in the form of a recording` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 189(5) the contents shall not be received in evidence` TRUE TRUE `s 189(5) viva voce` FALSE TRUE TRUE EQUALS JUST FALSE
-- notice not given
#ASSERT `s 189(5) the contents shall not be received in evidence` TRUE FALSE `s 189(5) in the form of a recording` TRUE FALSE TRUE EQUALS JUST TRUE
-- a recording with no transcript (only particulars): the wrong document for the form
#ASSERT `s 189(5) the contents shall not be received in evidence` TRUE TRUE `s 189(5) in the form of a recording` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 189(5) the contents shall not be received in evidence` TRUE TRUE `s 189(5) viva voce` TRUE FALSE TRUE EQUALS JUST TRUE
-- no statement of time, place, date and parties
#ASSERT `s 189(5) the contents shall not be received in evidence` TRUE TRUE `s 189(5) in the form of a recording` TRUE FALSE FALSE EQUALS JUST TRUE
-- some other form of adducing: outside paragraph (a)'s two limbs
#ASSERT `s 189(5) the contents shall not be received in evidence` TRUE TRUE `s 189(5) in some other form` TRUE TRUE TRUE EQUALS NOTHING
-- not contents obtained under this Part
#ASSERT `s 189(5) the contents shall not be received in evidence` FALSE FALSE `s 189(5) in the form of a recording` FALSE FALSE FALSE EQUALS NOTHING
#TRACE `s 189(5) the duty to give the accused reasonable notice as a rule` AT 0 WITH
    PARTY `s 183 the party intending to adduce the intercepted communication` DOES `s 189(5) gives the accused reasonable notice with the transcript or the statement of particulars and the statement of time, place, date and parties` AT 2
-- 189(6) args: obtained by an interception, privileged but for the interception, the person enjoying the privilege consents
#ASSERT `s 189(6) the information remains privileged and inadmissible as evidence` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 189(6) the information remains privileged and inadmissible as evidence` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 189(6) the information remains privileged and inadmissible as evidence` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 189(6) the information remains privileged and inadmissible as evidence` FALSE TRUE FALSE EQUALS NOTHING
-- 190 args: an accused has been given notice under 189(5), the person is a judge of the court of the trial
#ASSERT `s 190 the judge may order that further particulars be given of the private communication` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 190 the judge may order that further particulars be given of the private communication` TRUE FALSE EQUALS NOTHING
-- "Where" fails: JUST FALSE under the guide's ruling (b) (F11)
#ASSERT `s 190 the judge may order that further particulars be given of the private communication` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 190 the judge may order that further particulars be given of the private communication` FALSE FALSE EQUALS JUST FALSE

-- assertions written: 77; assertions satisfied: 77 (l4 1.6.110 and 1.6.109, check.sh, 2026-11-13)
