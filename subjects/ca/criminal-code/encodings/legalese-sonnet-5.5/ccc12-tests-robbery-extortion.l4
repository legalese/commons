IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc12-logic`
IMPORT `ccc12-tests-fixtures`
IMPORT `ccc12-part9-robbery-extortion`

-- Tests of ss 343 to 346.1. Expected values are hand-written from the text before each run. Arguments are positional, in the GIVEN order of each function.

§ `s 343 robbery`
-- steals (s 2), (a) uses violence or threats for the purpose of extorting or overcoming resistance, steals from any person, (b) at that time wounds/beats/strikes/uses personal violence to that person, (c) assaults with intent to steal, armed with an offensive weapon (s 2), armed with an imitation
#ASSERT `s 343 the person commits robbery` (JUST TRUE) TRUE FALSE FALSE FALSE (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 343 the person commits robbery` (JUST TRUE) FALSE TRUE TRUE FALSE (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 343 the person commits robbery` (JUST TRUE) FALSE TRUE FALSE FALSE (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 343 the person commits robbery` (JUST FALSE) FALSE FALSE FALSE TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 343 the person commits robbery` (JUST TRUE) FALSE TRUE FALSE FALSE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 343 the person commits robbery` (JUST TRUE) FALSE TRUE FALSE FALSE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 343 the person commits robbery` (JUST TRUE) FALSE FALSE FALSE FALSE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 343 the person commits robbery` (JUST FALSE) TRUE TRUE TRUE FALSE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 343 the person commits robbery` NOTHING TRUE FALSE FALSE FALSE (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 343 the person commits robbery` NOTHING FALSE FALSE FALSE TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 343 the person commits robbery` (JUST TRUE) FALSE TRUE FALSE FALSE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 343 the person commits robbery` (JUST TRUE) FALSE FALSE FALSE FALSE NOTHING FALSE EQUALS JUST FALSE

§ `s 344 robbery: punishment and earlier offences`
-- a restricted firearm (s 2.1), a prohibited firearm (s 2.1), any firearm (s 2), for the benefit of a criminal organization, the group is a criminal organization (s 2), second or subsequent offence
#ASSERT `s 344(1) the punishment for robbery` (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE) FALSE EQUALS JUST (LIST `ccc12 fixture indictable, life, minimum five years`)
#ASSERT `s 344(1) the punishment for robbery` (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE) TRUE EQUALS JUST (LIST `ccc12 fixture indictable, life, minimum seven years`)
#ASSERT `s 344(1) the punishment for robbery` (JUST FALSE) (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE) FALSE EQUALS JUST (LIST `ccc12 fixture indictable, life, minimum five years`)
#ASSERT `s 344(1) the punishment for robbery` (JUST FALSE) (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE) TRUE EQUALS JUST (LIST `ccc12 fixture indictable, life, minimum seven years`)
-- any firearm and a criminal organization
#ASSERT `s 344(1) the punishment for robbery` (JUST FALSE) (JUST FALSE) (JUST TRUE) TRUE (JUST TRUE) FALSE EQUALS JUST (LIST `ccc12 fixture indictable, life, minimum five years`)
#ASSERT `s 344(1) the punishment for robbery` (JUST FALSE) (JUST FALSE) (JUST TRUE) TRUE (JUST TRUE) TRUE EQUALS JUST (LIST `ccc12 fixture indictable, life, minimum seven years`)
-- any firearm but not for a criminal organization: "in any other case", life
#ASSERT `s 344(1) the punishment for robbery` (JUST FALSE) (JUST FALSE) (JUST TRUE) FALSE (JUST TRUE) FALSE EQUALS JUST (LIST `ccc12 fixture indictable, life`)
#ASSERT `s 344(1) the punishment for robbery` (JUST FALSE) (JUST FALSE) (JUST TRUE) TRUE (JUST FALSE) FALSE EQUALS JUST (LIST `ccc12 fixture indictable, life`)
-- no firearm at all
#ASSERT `s 344(1) the punishment for robbery` (JUST FALSE) (JUST FALSE) (JUST FALSE) TRUE (JUST TRUE) FALSE EQUALS JUST (LIST `ccc12 fixture indictable, life`)
-- an answer not given
#ASSERT `s 344(1) the punishment for robbery` NOTHING (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 344(1) the punishment for robbery` NOTHING (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE) FALSE EQUALS JUST (LIST `ccc12 fixture indictable, life, minimum five years`)
#ASSERT `s 344(1) the punishment for robbery` (JUST FALSE) (JUST FALSE) NOTHING TRUE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 344(1)(a.1) as the text shows it` EQUALS "(a.1) [Repealed, 2022, c. 15, s. 12]"
-- the ten years: earlier conviction 1 January 2010; exactly ten years later the earlier offence is no longer counted, a day sooner it still is
#ASSERT `s 344(2) ten years have elapsed between the convictions, not taking into account any time in custody` (Date 1 1 2010) (Date 1 1 2020) 0 EQUALS JUST TRUE
#ASSERT `s 344(2) ten years have elapsed between the convictions, not taking into account any time in custody` (Date 1 1 2010) (Date 31 12 2019) 0 EQUALS JUST FALSE
#ASSERT `s 344(2) ten years have elapsed between the convictions, not taking into account any time in custody` (Date 1 1 2010) (Date 1 1 2025) 0 EQUALS JUST TRUE
-- 100 days in custody are not counted: the tenth year ends 100 days later (10 April 2020)
#ASSERT `s 344(2) ten years have elapsed between the convictions, not taking into account any time in custody` (Date 1 1 2010) (Date 10 4 2020) 100 EQUALS JUST TRUE
#ASSERT `s 344(2) ten years have elapsed between the convictions, not taking into account any time in custody` (Date 1 1 2010) (Date 9 4 2020) 100 EQUALS JUST FALSE
#ASSERT `s 344(2) ten years have elapsed between the convictions, not taking into account any time in custody` (Date 1 1 2010) (Date 1 1 2020) 100 EQUALS JUST FALSE
