IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc23-high-risk`

-- ccc23-tests-high-risk.l4 -- tests for sections 672.64 to 672.71. Expected values are written from the text, never copied from the code.

§ `s 672.64`
-- (1) args: application by the prosecutor before any disposition to discharge absolutely; NCR for a serious personal injury offence (by 672.81(1.3)); 18 or more at the time; (a) substantial likelihood of violence; (b) brutal acts
#ASSERT `s 672.64(1) the court may find the accused to be a high-risk accused` TRUE (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.64(1) the court may find the accused to be a high-risk accused` TRUE (JUST TRUE) TRUE FALSE TRUE EQUALS JUST TRUE
-- neither (a) nor (b)
#ASSERT `s 672.64(1) the court may find the accused to be a high-risk accused` TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS NOTHING
-- under 18 at the time
#ASSERT `s 672.64(1) the court may find the accused to be a high-risk accused` TRUE (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING
-- not a serious personal injury offence, or that answer is itself not covered
#ASSERT `s 672.64(1) the court may find the accused to be a high-risk accused` TRUE (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.64(1) the court may find the accused to be a high-risk accused` TRUE NOTHING TRUE TRUE TRUE EQUALS NOTHING
-- no application before a discharge
#ASSERT `s 672.64(1) the court may find the accused to be a high-risk accused` FALSE (JUST TRUE) TRUE TRUE TRUE EQUALS JUST FALSE
-- (2) args: deciding whether to find; (a); (b); (c); (d); (e); other relevant evidence
#ASSERT `s 672.64(2) the court must consider the evidence` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.64(2) the court must consider the evidence` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.64(2) the court must consider the evidence` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.64(2) the court must consider the evidence` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.64(2) the court must consider the evidence` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.64(2) the court must consider the evidence` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.64(2) the court must consider the evidence` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.64(2) the court must consider the evidence` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (3) the duty
#ASSERT `s 672.64(3) the court must make a disposition under paragraph 672.54(c)` TRUE EQUALS JUST TRUE
#ASSERT `s 672.64(3) the court must make a disposition under paragraph 672.54(c)` FALSE EQUALS JUST FALSE
-- (3) the bar. args: a high-risk accused; (a) appropriate in the person in charge's opinion; escorted by an authorized person; (b) structured plan
#ASSERT `s 672.64(3) the section bars a condition that would permit the high-risk accused to be absent from the hospital` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.64(3) the section bars a condition that would permit the high-risk accused to be absent from the hospital` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.64(3) the section bars a condition that would permit the high-risk accused to be absent from the hospital` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.64(3) the section bars a condition that would permit the high-risk accused to be absent from the hospital` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- the text's own "unless": (a) and (b) both met
#ASSERT `s 672.64(3) the section bars a condition that would permit the high-risk accused to be absent from the hospital` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.64(3) the section bars a condition that would permit the high-risk accused to be absent from the hospital` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- (4), (5)
#ASSERT `s 672.64(4) the decision is deemed to be a disposition for the purpose of sections 672.72 to 672.78` TRUE EQUALS JUST TRUE
#ASSERT `s 672.64(4) the decision is deemed to be a disposition for the purpose of sections 672.72 to 672.78` FALSE EQUALS NOTHING
#ASSERT `s 672.64(5) the finding is a disposition and sections 672.72 to 672.78 apply to it` TRUE EQUALS JUST TRUE
#ASSERT `s 672.64(5) the finding is a disposition and sections 672.72 to 672.78 apply to it` FALSE EQUALS NOTHING
-- 672.65 and 672.66: the text shows no sections
#ASSERT `s 672.65 and s 672.66 as the text shows them` EQUALS "672.65 and 672.66 [No sections 672.65 and 672.66]"

§ `ss 672.67 and 672.68`
-- 672.67 args: dual status offender (by 672.1(1)); the court imposes a sentence of imprisonment; the court imposes a custodial disposition; the Review Board has made a placement decision
#ASSERT `s 672.67 which of the two takes precedence` (JUST TRUE) TRUE FALSE FALSE EQUALS `s 672.67(1) the new sentence of imprisonment takes precedence over any prior custodial disposition`
#ASSERT `s 672.67 which of the two takes precedence` (JUST TRUE) FALSE TRUE FALSE EQUALS `s 672.67(2) the new custodial disposition takes precedence over any prior sentence of imprisonment`
#ASSERT `s 672.67 which of the two takes precedence` (JUST TRUE) TRUE FALSE TRUE EQUALS `s 672.67 the Review Board has made a placement decision and precedence is for it to say`
#ASSERT `s 672.67 which of the two takes precedence` (JUST TRUE) FALSE FALSE FALSE EQUALS `s 672.67 not covered`
#ASSERT `s 672.67 which of the two takes precedence` (JUST FALSE) TRUE FALSE FALSE EQUALS `s 672.67 not covered`
#ASSERT `s 672.67 which of the two takes precedence` NOTHING TRUE FALSE FALSE EQUALS `s 672.67 not covered`
-- 672.68(1)
#ASSERT `s 672.68(1) Minister` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.68(1) Minister` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.68(1) Minister` FALSE FALSE EQUALS JUST FALSE
-- 672.68(2) args: the Minister applies or own motion; dual status offender (by 672.1(1)); opinion that the place is inappropriate; reasonable notice given
#ASSERT `s 672.68(2) the Review Board must decide whether to place the offender in custody in a hospital or in a prison` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.68(2) the Review Board must decide whether to place the offender in custody in a hospital or in a prison` FALSE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.68(2) the Review Board must decide whether to place the offender in custody in a hospital or in a prison` TRUE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.68(2) the Review Board must decide whether to place the offender in custody in a hospital or in a prison` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.68(2) the Review Board must decide whether to place the offender in custody in a hospital or in a prison` TRUE (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.68(2) the Review Board must decide whether to place the offender in custody in a hospital or in a prison` TRUE NOTHING TRUE TRUE EQUALS NOTHING
-- 672.68(3) args: making a placement decision; (a) to (e)
#ASSERT `s 672.68(3) the Review Board must take the factor into consideration` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.68(3) the Review Board must take the factor into consideration` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.68(3) the Review Board must take the factor into consideration` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.68(3) the Review Board must take the factor into consideration` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.68(3) the Review Board must take the factor into consideration` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.68(3) the Review Board must take the factor into consideration` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.68(3) the Review Board must take the factor into consideration` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- 672.68(4) as a function: application received 1 March 2026; 30 days later is 31 March 2026. args: day of application or notice; day of the decision; the Review Board and the Minister agree; the longer period agreed in days (not exceeding sixty)
#ASSERT `s 672.68(4) the placement decision is made in time` (Date 1 3 2026) (Date 31 3 2026) FALSE 0 EQUALS JUST TRUE
#ASSERT `s 672.68(4) the placement decision is made in time` (Date 1 3 2026) (Date 1 4 2026) FALSE 0 EQUALS JUST FALSE
#ASSERT `s 672.68(4) the placement decision is made in time` (Date 1 3 2026) (Date 30 4 2026) TRUE 60 EQUALS JUST TRUE
#ASSERT `s 672.68(4) the placement decision is made in time` (Date 1 3 2026) (Date 1 5 2026) TRUE 60 EQUALS JUST FALSE
-- an agreed period above sixty days is not allowed
#ASSERT `s 672.68(4) the placement decision is made in time` (Date 1 3 2026) (Date 15 5 2026) TRUE 75 EQUALS JUST FALSE
#TRACE `s 672.68(4) the Review Board must make its placement decision within thirty days` AT 0 WITH
    PARTY `a Review Board` DOES `s 672.68(4) make the placement decision` AT 30
#TRACE `s 672.68(4) the Review Board must make its placement decision within thirty days` AT 0 WITH
    (WAITUNTIL 31)
-- 672.68(5)
#ASSERT `s 672.68(5) the Minister is responsible for the supervision and control of the offender` TRUE EQUALS JUST TRUE
#ASSERT `s 672.68(5) the Minister is responsible for the supervision and control of the offender` FALSE EQUALS JUST FALSE

§ `ss 672.69 to 672.71`
-- 672.69(1) args: a placement decision has been made; the access is for a review of the sentence or disposition
#ASSERT `s 672.69(1) the Minister and the Review Board are entitled to have access to the dual status offender` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.69(1) the Minister and the Review Board are entitled to have access to the dual status offender` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.69(1) the Minister and the Review Board are entitled to have access to the dual status offender` FALSE TRUE EQUALS NOTHING
-- 672.69(2) args: application by the Minister or the offender; satisfied that a significant change in circumstances requires it
#ASSERT `s 672.69(2) the Review Board must hold a hearing as soon as is practicable to review the placement decision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.69(2) the Review Board must hold a hearing as soon as is practicable to review the placement decision` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.69(2) the Review Board must hold a hearing as soon as is practicable to review the placement decision` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.69(3) the Review Board may of its own motion hold a hearing to review the placement decision` TRUE EQUALS JUST TRUE
#ASSERT `s 672.69(3) the Review Board may of its own motion hold a hearing to review the placement decision` FALSE EQUALS NOTHING
#ASSERT `s 672.69(4) the Minister is a party in the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 672.69(4) the Minister is a party in the proceedings` FALSE EQUALS NOTHING
#ASSERT `s 672.7(1) the Minister and the Review Board must each give written notice to the other of the time, place and conditions of the discharge` TRUE EQUALS JUST TRUE
#ASSERT `s 672.7(1) the Minister and the Review Board must each give written notice to the other of the time, place and conditions of the discharge` FALSE EQUALS JUST FALSE
#ASSERT `s 672.7(2) the Review Board must issue a warrant of committal of the accused` TRUE EQUALS JUST TRUE
#ASSERT `s 672.7(2) the Review Board must issue a warrant of committal of the accused` FALSE EQUALS JUST FALSE
-- 672.71(1) args: dual status offender (by 672.1(1)); detained pursuant to a placement decision or a custodial disposition
#ASSERT `s 672.71(1) each day of detention is a day of service of the term of imprisonment and the accused is deemed to be lawfully confined in a prison` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 672.71(1) each day of detention is a day of service of the term of imprisonment and the accused is deemed to be lawfully confined in a prison` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 672.71(1) each day of detention is a day of service of the term of imprisonment and the accused is deemed to be lawfully confined in a prison` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 672.71(1) each day of detention is a day of service of the term of imprisonment and the accused is deemed to be lawfully confined in a prison` NOTHING TRUE EQUALS NOTHING
-- 672.71(2) args: dual status offender (by 672.1(1)); convicted or discharged on the conditions of a probation order; not sentenced to a term of imprisonment
#ASSERT `s 672.71(2) the custodial disposition comes into force and takes precedence over the probation order` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.71(2) the custodial disposition comes into force and takes precedence over the probation order` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.71(2) the custodial disposition comes into force and takes precedence over the probation order` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.71(2) the custodial disposition comes into force and takes precedence over the probation order` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.71(2) the custodial disposition comes into force and takes precedence over the probation order` NOTHING TRUE TRUE EQUALS NOTHING
