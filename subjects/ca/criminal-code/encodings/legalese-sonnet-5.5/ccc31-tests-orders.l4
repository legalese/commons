IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc31-forms-periods`
IMPORT `ccc31-forms-orders`

-- ccc31-tests-orders.l4 -- tests for ccc31-forms-orders.l4 (Forms 46, 47, 48, 48.1 and 51).
-- Every expected value is written by hand from the text of the Form (line numbers are those of R.S.C.-1985-c.-C-46.txt), before the run.
-- A period begins ON the day named (ccc31-forms-periods, fork F16): one year from 1 January 2026 is 1 January to 31 December 2026.

§ `Form 46 (Section 732.1) -- Probation Order`

§§ `When the conditions begin (lines 18851-18858): from the date of this order, or, for (d), (e) and (f), from the date of expiration of the sentence`

#ASSERT `form 46 the conditions begin on` `form 46 (a) discharged on conditions` (Date 1 1 2026) (Date 1 1 2027) EQUALS Date 1 1 2026
#ASSERT `form 46 the conditions begin on` `form 46 (b) passing of sentence suspended and released on conditions` (Date 1 1 2026) (Date 1 1 2027) EQUALS Date 1 1 2026
#ASSERT `form 46 the conditions begin on` `form 46 (c) fine, imprisonment in default of payment, and conditions in addition` (Date 1 1 2026) (Date 1 1 2027) EQUALS Date 1 1 2026
#ASSERT `form 46 the conditions begin on` `form 46 (d) imprisoned and, in addition, conditions` (Date 1 1 2026) (Date 1 1 2027) EQUALS Date 1 1 2027
#ASSERT `form 46 the conditions begin on` `form 46 (e) conditions following the expiration of a conditional sentence order` (Date 1 1 2026) (Date 1 1 2027) EQUALS Date 1 1 2027
#ASSERT `form 46 the conditions begin on` `form 46 (f) conditions following the expiration of a sentence of imprisonment related to another offence` (Date 1 1 2026) (Date 1 1 2027) EQUALS Date 1 1 2027
#ASSERT `form 46 the conditions begin on` `form 46 (g) intermittent sentence, conditions when not in confinement` (Date 1 1 2026) (Date 1 1 2027) EQUALS Date 1 1 2026

§§ `Whether the conditions bind on a day (line 18858)`

-- (a), a period of one year from the date of this order, 1 January 2026: binds on 1 January 2026 and on 31 December 2026, not on 31 December 2025 and not on 1 January 2027.
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (a) discharged on conditions` (Date 1 1 2026) (Date 1 1 2027) (`Length of time` OF 1, 0, 0, FALSE) FALSE (Date 1 1 2026) EQUALS JUST TRUE
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (a) discharged on conditions` (Date 1 1 2026) (Date 1 1 2027) (`Length of time` OF 1, 0, 0, FALSE) FALSE (Date 31 12 2026) EQUALS JUST TRUE
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (a) discharged on conditions` (Date 1 1 2026) (Date 1 1 2027) (`Length of time` OF 1, 0, 0, FALSE) FALSE (Date 31 12 2025) EQUALS JUST FALSE
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (a) discharged on conditions` (Date 1 1 2026) (Date 1 1 2027) (`Length of time` OF 1, 0, 0, FALSE) FALSE (Date 1 1 2027) EQUALS JUST FALSE
-- Confinement does not matter outside (g): (a) binds in confinement too.
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (a) discharged on conditions` (Date 1 1 2026) (Date 1 1 2027) (`Length of time` OF 1, 0, 0, FALSE) TRUE (Date 1 6 2026) EQUALS JUST TRUE
-- (d): the sentence expires 1 July 2026; the period of one year runs from then: not on 30 June 2026, on 1 July 2026, on 30 June 2027, not on 1 July 2027.
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (d) imprisoned and, in addition, conditions` (Date 1 1 2026) (Date 1 7 2026) (`Length of time` OF 1, 0, 0, FALSE) FALSE (Date 30 6 2026) EQUALS JUST FALSE
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (d) imprisoned and, in addition, conditions` (Date 1 1 2026) (Date 1 7 2026) (`Length of time` OF 1, 0, 0, FALSE) FALSE (Date 1 7 2026) EQUALS JUST TRUE
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (d) imprisoned and, in addition, conditions` (Date 1 1 2026) (Date 1 7 2026) (`Length of time` OF 1, 0, 0, FALSE) FALSE (Date 30 6 2027) EQUALS JUST TRUE
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (d) imprisoned and, in addition, conditions` (Date 1 1 2026) (Date 1 7 2026) (`Length of time` OF 1, 0, 0, FALSE) FALSE (Date 1 7 2027) EQUALS JUST FALSE
-- (e) and (f) begin from the expiration too.
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (e) conditions following the expiration of a conditional sentence order` (Date 1 1 2026) (Date 1 7 2026) (`Length of time` OF 1, 0, 0, FALSE) FALSE (Date 1 3 2026) EQUALS JUST FALSE
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (f) conditions following the expiration of a sentence of imprisonment related to another offence` (Date 1 1 2026) (Date 1 7 2026) (`Length of time` OF 1, 0, 0, FALSE) FALSE (Date 2 7 2026) EQUALS JUST TRUE
-- (g) intermittent sentence: the conditions apply "when not in confinement": in confinement, no; out of confinement within the period, yes.
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (g) intermittent sentence, conditions when not in confinement` (Date 1 1 2026) (Date 1 1 2027) (`Length of time` OF 1, 0, 0, FALSE) TRUE (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (g) intermittent sentence, conditions when not in confinement` (Date 1 1 2026) (Date 1 1 2027) (`Length of time` OF 1, 0, 0, FALSE) FALSE (Date 1 6 2026) EQUALS JUST TRUE
-- (g) outside the period: no, in or out of confinement.
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (g) intermittent sentence, conditions when not in confinement` (Date 1 1 2026) (Date 1 1 2027) (`Length of time` OF 1, 0, 0, FALSE) FALSE (Date 1 1 2027) EQUALS JUST FALSE
-- A period in months and one "less a day": six months from 1 January 2026 end on 30 June; two years less a day end on 30 December 2027.
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (b) passing of sentence suspended and released on conditions` (Date 1 1 2026) (Date 1 1 2027) (`Length of time` OF 0, 6, 0, FALSE) FALSE (Date 30 6 2026) EQUALS JUST TRUE
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (b) passing of sentence suspended and released on conditions` (Date 1 1 2026) (Date 1 1 2027) (`Length of time` OF 0, 6, 0, FALSE) FALSE (Date 1 7 2026) EQUALS JUST FALSE
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (b) passing of sentence suspended and released on conditions` (Date 1 1 2026) (Date 1 1 2027) (`Length of time` OF 2, 0, 0, TRUE) FALSE (Date 30 12 2027) EQUALS JUST TRUE
#ASSERT `form 46 the offender must comply with the conditions on the day` `form 46 (b) passing of sentence suspended and released on conditions` (Date 1 1 2026) (Date 1 1 2027) (`Length of time` OF 2, 0, 0, TRUE) FALSE (Date 31 12 2027) EQUALS JUST FALSE

§§ `The four standing conditions (line 18858)`

-- Kept the peace; not required to appear; no change of name, address or employment: in compliance.
#ASSERT `form 46 the offender is in compliance with the standard conditions` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- Required to appear and appeared; changed address and notified in advance; changed employment and notified promptly: in compliance.
#ASSERT `form 46 the offender is in compliance with the standard conditions` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- Each duty in turn not met (fork F12): not in compliance.
#ASSERT `form 46 the offender is in compliance with the standard conditions` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `form 46 the offender is in compliance with the standard conditions` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `form 46 the offender is in compliance with the standard conditions` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `form 46 the offender is in compliance with the standard conditions` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- "additional conditions prescribed pursuant to subsection 732.1(3)".
#ASSERT `form 46 the additional condition may be stated` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `form 46 the additional condition may be stated` (JUST FALSE) EQUALS NOTHING
#ASSERT `form 46 the additional condition may be stated` NOTHING EQUALS NOTHING

§§ `The standing conditions as regulative rules`

-- Expected: nothing done in the 365 days of the period (the prohibition respected): FULFILLED.
#TRACE `form 46 the duty to keep the peace and be of good behaviour` 365 AT 0 WITH
    (WAITUNTIL 366)
-- Expected: the offender breaches the peace on day 100: BREACH BY the offender.
#TRACE `form 46 the duty to keep the peace and be of good behaviour` 365 AT 0 WITH
    PARTY `the offender` DOES `form 46 breach the peace or misbehave` AT 100
-- Expected: appears on day 10 of 30: FULFILLED. Does not appear in 30 days: BREACH.
#TRACE `form 46 the duty to appear before the court when required` 30 AT 0 WITH
    PARTY `the offender` DOES `form 46 appear before the court` AT 10
#TRACE `form 46 the duty to appear before the court when required` 30 AT 0 WITH
    (WAITUNTIL 31)
-- Expected: notifies on day 2 of 7: FULFILLED. Does not notify: BREACH.
#TRACE `form 46 the duty to notify the court or probation officer of a change` 7 AT 0 WITH
    PARTY `the offender` DOES `form 46 notify the court or probation officer of the change` AT 2
#TRACE `form 46 the duty to notify the court or probation officer of a change` 7 AT 0 WITH
    (WAITUNTIL 8)

§ `Form 47 (Section 462.48) -- Order To Disclose Income Tax Information (lines 18868-18870)`

#ASSERT `form 47 the order authorizes and requires the addressee to produce the information` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `form 47 the order authorizes and requires the addressee to produce the information` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `form 47 the order authorizes and requires the addressee to produce the information` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `form 47 the order authorizes and requires the addressee to produce the information` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `form 47 the production meets the order` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `form 47 the production meets the order` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `form 47 the production meets the order` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `form 47 the production meets the order` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `form 47 the production meets the order` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- Expected: production on the last day (day 30 of a 30-day period): FULFILLED. Nothing by day 31: BREACH.
#TRACE `form 47 the duty of the addressee` 30 AT 0 WITH
    PARTY `a public officer` DOES `form 47 produce the information and documents to one of the named police officers` AT 30
#TRACE `form 47 the duty of the addressee` 30 AT 0 WITH
    (WAITUNTIL 31)

§ `Form 48 (Section 672.13) -- Assessment Order of the Court`

§§ `The five purposes (lines 18878-18883)`

-- Purposes 1 and 2: no "if": the grounds suffice.
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 1 whether the accused is unfit to stand trial` TRUE FALSE (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 2 whether the accused suffered from a mental disorder so as to exempt the accused from criminal responsibility by virtue of subsection 16(1)` TRUE FALSE (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
-- Without the grounds the Form recites, any purpose: not covered.
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 1 whether the accused is unfit to stand trial` FALSE FALSE (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 4 the appropriate disposition under section 672.54, 672.58 or 672.64, or whether to revoke a finding that the accused is a high-risk accused` FALSE FALSE (JUST FALSE) TRUE TRUE EQUALS NOTHING
-- Purpose 3: a female person charged with an offence arising out of the death of her newly-born child (s 2 "newly-born child" answers yes).
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 3 whether the balance of the mind of the accused was disturbed at the time of commission of the alleged offence` TRUE TRUE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 3 whether the balance of the mind of the accused was disturbed at the time of commission of the alleged offence` TRUE FALSE (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
-- The child is not a newly-born child (s 2 says no), or s 2's answer is not covered.
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 3 whether the balance of the mind of the accused was disturbed at the time of commission of the alleged offence` TRUE TRUE (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 3 whether the balance of the mind of the accused was disturbed at the time of commission of the alleged offence` TRUE TRUE NOTHING FALSE FALSE EQUALS NOTHING
-- Purpose 4: "if a verdict of unfit to stand trial or a verdict of not criminally responsible ... has been rendered".
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 4 the appropriate disposition under section 672.54, 672.58 or 672.64, or whether to revoke a finding that the accused is a high-risk accused` TRUE FALSE (JUST FALSE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 4 the appropriate disposition under section 672.54, 672.58 or 672.64, or whether to revoke a finding that the accused is a high-risk accused` TRUE FALSE (JUST FALSE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 4 the appropriate disposition under section 672.54, 672.58 or 672.64, or whether to revoke a finding that the accused is a high-risk accused` TRUE FALSE (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
-- Purpose 5: "if a verdict of unfit to stand trial has been rendered" (a verdict of not criminally responsible does not do).
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 5 whether the court should order a stay of proceedings under section 672.851` TRUE FALSE (JUST FALSE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 5 whether the court should order a stay of proceedings under section 672.851` TRUE FALSE (JUST FALSE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `form 48 the court has grounds to order an assessment for the purpose` `form 48 purpose 5 whether the court should order a stay of proceedings under section 672.851` TRUE FALSE (JUST FALSE) FALSE FALSE EQUALS JUST FALSE

§§ `In force for a total of ___ days, including travelling time (line 18885), and the accused's status (lines 18886-18888)`

-- Thirty days from 1 January 2026: 1 to 30 January.
#ASSERT `form 48 the order is in force` (Date 1 1 2026) 30 (Date 30 1 2026) EQUALS JUST TRUE
#ASSERT `form 48 the order is in force` (Date 1 1 2026) 30 (Date 31 1 2026) EQUALS JUST FALSE
#ASSERT `form 48 the order is in force` (Date 1 1 2026) 30 (Date 31 12 2025) EQUALS JUST FALSE
#ASSERT `form 48 the accused is to remain in custody or out of custody` `form 48 in custody at the place named` `form 48 in custody at the place named` EQUALS JUST TRUE
#ASSERT `form 48 the accused is to remain in custody or out of custody` `form 48 in custody at the place named` `form 48 out of custody, on the conditions set out` EQUALS NOTHING
#ASSERT `form 48 the accused is to remain in custody or out of custody` `form 48 out of custody, on the conditions set out` `form 48 out of custody, on the conditions set out` EQUALS JUST TRUE
#ASSERT `form 48 the accused must comply with the condition` `form 48 out of custody, on the conditions set out` TRUE EQUALS JUST TRUE
#ASSERT `form 48 the accused must comply with the condition` `form 48 out of custody, on the conditions set out` FALSE EQUALS NOTHING
#ASSERT `form 48 the accused must comply with the condition` `form 48 in custody at the place named` TRUE EQUALS NOTHING

§ `Form 48.1 (Section 672.13) -- Assessment Order of the Review Board`

-- Purpose 1: "if a verdict of unfit to stand trial or a verdict of not criminally responsible on account of mental disorder has been rendered".
#ASSERT `form 48.1 the Review Board has grounds to order an assessment for the purpose` `form 48.1 purpose 1 to make a disposition under section 672.54 or determine whether to refer a high-risk finding for review under subsection 672.84(1)` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `form 48.1 the Review Board has grounds to order an assessment for the purpose` `form 48.1 purpose 1 to make a disposition under section 672.54 or determine whether to refer a high-risk finding for review under subsection 672.84(1)` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `form 48.1 the Review Board has grounds to order an assessment for the purpose` `form 48.1 purpose 1 to make a disposition under section 672.54 or determine whether to refer a high-risk finding for review under subsection 672.84(1)` TRUE FALSE FALSE EQUALS JUST FALSE
-- Purpose 2: "if a verdict of unfit to stand trial has been rendered".
#ASSERT `form 48.1 the Review Board has grounds to order an assessment for the purpose` `form 48.1 purpose 2 to determine whether to recommend an inquiry into a stay of proceedings under section 672.851` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `form 48.1 the Review Board has grounds to order an assessment for the purpose` `form 48.1 purpose 2 to determine whether to recommend an inquiry into a stay of proceedings under section 672.851` TRUE FALSE TRUE EQUALS JUST FALSE
-- No grounds: not covered.
#ASSERT `form 48.1 the Review Board has grounds to order an assessment for the purpose` `form 48.1 purpose 2 to determine whether to recommend an inquiry into a stay of proceedings under section 672.851` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `form 48.1 the order is in force` (Date 1 1 2026) 30 (Date 30 1 2026) EQUALS JUST TRUE
#ASSERT `form 48.1 the order is in force` (Date 1 1 2026) 30 (Date 31 1 2026) EQUALS JUST FALSE
#ASSERT `form 48.1 the accused is to remain in custody or out of custody` `form 48.1 in custody at the place named` `form 48.1 in custody at the place named` EQUALS JUST TRUE
#ASSERT `form 48.1 the accused is to remain in custody or out of custody` `form 48.1 in custody at the place named` `form 48.1 out of custody, on the conditions set out` EQUALS NOTHING
#ASSERT `form 48.1 the accused must comply with the condition` `form 48.1 out of custody, on the conditions set out` TRUE EQUALS JUST TRUE
#ASSERT `form 48.1 the accused must comply with the condition` `form 48.1 out of custody, on the conditions set out` FALSE EQUALS NOTHING
#ASSERT `form 48.1 the accused must comply with the condition` `form 48.1 in custody at the place named` TRUE EQUALS NOTHING

§ `Form 51 -- Notice of Obligation To Provide Samples of Bodily Substance`

#ASSERT `form 51 the person is subject to the obligation to provide samples` TRUE EQUALS JUST TRUE
#ASSERT `form 51 the person is subject to the obligation to provide samples` FALSE EQUALS NOTHING

§§ `Paragraph 1 (line 18993): a day not earlier than 24 hours after the day of service; any time from one time to another`

-- Served on 10 January 2026: the first report on 11 January or later; not on 10 January or before.
#ASSERT `form 51 para 1 the first report is on a permitted day` (Date 10 1 2026) (Date 11 1 2026) EQUALS JUST TRUE
#ASSERT `form 51 para 1 the first report is on a permitted day` (Date 10 1 2026) (Date 12 1 2026) EQUALS JUST TRUE
#ASSERT `form 51 para 1 the first report is on a permitted day` (Date 10 1 2026) (Date 10 1 2026) EQUALS JUST FALSE
#ASSERT `form 51 para 1 the first report is on a permitted day` (Date 10 1 2026) (Date 9 1 2026) EQUALS JUST FALSE
-- Across a month end: served 31 January 2026, 1 February is the next day.
#ASSERT `form 51 para 1 the first report is on a permitted day` (Date 31 1 2026) (Date 1 2 2026) EQUALS JUST TRUE
-- From 9:00 (540) to 10:00 (600), both included.
#ASSERT `form 51 para 1 the person reports within the hours stated` 570 540 600 EQUALS JUST TRUE
#ASSERT `form 51 para 1 the person reports within the hours stated` 540 540 600 EQUALS JUST TRUE
#ASSERT `form 51 para 1 the person reports within the hours stated` 600 540 600 EQUALS JUST TRUE
#ASSERT `form 51 para 1 the person reports within the hours stated` 539 540 600 EQUALS JUST FALSE
#ASSERT `form 51 para 1 the person reports within the hours stated` 601 540 600 EQUALS JUST FALSE

§§ `Paragraph 2 (line 18994): every N days after the first report, N not less than seven`

#ASSERT `form 51 para 2 the number of days stated is permitted` 7 EQUALS JUST TRUE
#ASSERT `form 51 para 2 the number of days stated is permitted` 30 EQUALS JUST TRUE
#ASSERT `form 51 para 2 the number of days stated is permitted` 6 EQUALS JUST FALSE
-- First report on 11 January 2026, every 7 days: 18 January, 25 January, 1 February; not 17 or 19 January; not the first report day itself; not before it.
#ASSERT `form 51 para 2 the person must report on the day` (Date 11 1 2026) 7 (Date 18 1 2026) EQUALS JUST TRUE
#ASSERT `form 51 para 2 the person must report on the day` (Date 11 1 2026) 7 (Date 25 1 2026) EQUALS JUST TRUE
#ASSERT `form 51 para 2 the person must report on the day` (Date 11 1 2026) 7 (Date 1 2 2026) EQUALS JUST TRUE
#ASSERT `form 51 para 2 the person must report on the day` (Date 11 1 2026) 7 (Date 17 1 2026) EQUALS JUST FALSE
#ASSERT `form 51 para 2 the person must report on the day` (Date 11 1 2026) 7 (Date 19 1 2026) EQUALS JUST FALSE
#ASSERT `form 51 para 2 the person must report on the day` (Date 11 1 2026) 7 (Date 11 1 2026) EQUALS JUST FALSE
#ASSERT `form 51 para 2 the person must report on the day` (Date 11 1 2026) 7 (Date 4 1 2026) EQUALS JUST FALSE
-- A number below seven is outside the Form: not covered.
#ASSERT `form 51 para 2 the person must report on the day` (Date 11 1 2026) 6 (Date 17 1 2026) EQUALS NOTHING

§§ `Paragraphs 3, 4 and 5 (lines 18995-18997)`

#ASSERT `form 51 para 3 the person may apply to terminate the obligation` TRUE EQUALS JUST TRUE
#ASSERT `form 51 para 3 the person may apply to terminate the obligation` FALSE EQUALS NOTHING
#ASSERT `form 51 para 3 the person may appeal the decision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `form 51 para 3 the person may appeal the decision` TRUE FALSE EQUALS NOTHING
#ASSERT `form 51 para 3 the person may appeal the decision` FALSE TRUE EQUALS NOTHING
-- Found to have not complied: a fine or imprisonment, or both; for a conditional sentence, proceedings under section 742.6. Not found: the notice states no consequence.
#ASSERT `form 51 para 4 the consequence of not complying` TRUE FALSE EQUALS JUST `form 51 a fine or imprisonment, or both`
#ASSERT `form 51 para 4 the consequence of not complying` TRUE TRUE EQUALS JUST `form 51 proceedings under section 742.6, the consequences of which may include imprisonment`
#ASSERT `form 51 para 4 the consequence of not complying` FALSE FALSE EQUALS JUST `form 51 the notice states no consequence, the person not having been found to have failed to comply`
#ASSERT `form 51 para 4 the consequence of not complying` FALSE TRUE EQUALS JUST `form 51 the notice states no consequence, the person not having been found to have failed to comply`
#ASSERT `form 51 para 5 the results of the analysis may be used in proceedings against the person` TRUE EQUALS JUST TRUE
#ASSERT `form 51 para 5 the results of the analysis may be used in proceedings against the person` FALSE EQUALS NOTHING
