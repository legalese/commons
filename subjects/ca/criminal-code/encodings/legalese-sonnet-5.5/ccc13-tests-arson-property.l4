IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc-definitions`
IMPORT `ccc13-arson-property`
IMPORT `ccc13-tests-support`

-- ccc13-tests-arson-property.l4 -- tests of ccc13-arson-property.l4 (ss 433 to 443). Expected values are decided from the text.

`ccc13 test the hybrid class` MEANS `an offence that the section makes both indictable and punishable on summary conviction`
GIVETH A `s 2 wreck kind`
`ccc13 test wreck` MEANS `the cargo of a vessel`
GIVETH A `s 2 wreck kind`
`ccc13 test not wreck` MEANS `a thing that is none of those`
GIVETH A `s 2 explosive substance kind`
`ccc13 test an explosive substance` MEANS `an incendiary grenade, fire bomb, molotov cocktail or other similar incendiary substance or device`
GIVETH A `s 2 explosive substance kind`
`ccc13 test not an explosive substance` MEANS `a thing that is none of those`

§ `s 433 arson -- disregard for human life`
-- inputs: intentionally or recklessly causes damage by fire or explosion; property (s 428); knows or is reckless as to whether inhabited or occupied; hurt or injury to another person; interferes with health or comfort; more than merely transient or trifling
#ASSERT `s 433 the conduct is the offence of arson -- disregard for human life` TRUE (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST TRUE                -- (a): inhabited or occupied
#ASSERT `s 433 the conduct is the offence of arson -- disregard for human life` TRUE (JUST TRUE) FALSE TRUE TRUE TRUE EQUALS JUST TRUE                 -- (b): bodily harm to another person, as s 2 "bodily harm" defines it
#ASSERT `s 433 the conduct is the offence of arson -- disregard for human life` TRUE (JUST TRUE) FALSE TRUE TRUE FALSE EQUALS JUST FALSE                -- a transient or trifling injury is not bodily harm
#ASSERT `s 433 the conduct is the offence of arson -- disregard for human life` TRUE (JUST TRUE) FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 433 the conduct is the offence of arson -- disregard for human life` FALSE (JUST TRUE) TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 433 the conduct is the offence of arson -- disregard for human life` TRUE (JUST FALSE) TRUE FALSE FALSE FALSE EQUALS JUST FALSE               -- not property in the sense of section 428
#ASSERT `s 433 the conduct is the offence of arson -- disregard for human life` TRUE NOTHING TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 433 the punishments`) EQUALS `imprisonment for life`
#ASSERT `s 433 the class of the offence` EQUALS `an indictable offence`

§ `s 434 to s 436.1 arson and negligence`
#ASSERT `s 434 the conduct is the offence of arson -- damage to property` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 434 the conduct is the offence of arson -- damage to property` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE      -- wholly owned by that person
#ASSERT `s 434 the conduct is the offence of arson -- damage to property` FALSE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 434 the conduct is the offence of arson -- damage to property` TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 434 the punishments`) EQUALS `imprisonment for a term of` `fourteen years`
#ASSERT `s 434 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 434.1 the conduct is the offence of arson -- own property` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 434.1 the conduct is the offence of arson -- own property` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 434.1 the conduct is the offence of arson -- own property` TRUE (JUST TRUE) TRUE FALSE EQUALS JUST FALSE      -- the fire does not seriously threaten another person
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 434.1 the punishments`) EQUALS `imprisonment for a term of` `fourteen years`
#ASSERT `s 434.1 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 435(1) the conduct is the offence of arson for a fraudulent purpose` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 435(1) the conduct is the offence of arson for a fraudulent purpose` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 435(1) the conduct is the offence of arson for a fraudulent purpose` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 435(1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `ten years`
#ASSERT `s 435(1) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 435(2) intent to defraud may be inferred by the court from the fact of the fire insurance policy` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 435(2) intent to defraud may be inferred by the court from the fact of the fire insurance policy` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 435(2) intent to defraud may be inferred by the court from the fact of the fire insurance policy` TRUE FALSE EQUALS NOTHING
-- inputs of 436(1): owns or controls; property (s 428); a cause by a marked departure; hurt; interferes; more than transient; damage to property
#ASSERT `s 436(1) the conduct is the offence of arson by negligence` TRUE (JUST TRUE) TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE      -- damage to property
#ASSERT `s 436(1) the conduct is the offence of arson by negligence` TRUE (JUST TRUE) TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE       -- bodily harm to another person
#ASSERT `s 436(1) the conduct is the offence of arson by negligence` TRUE (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE     -- neither
#ASSERT `s 436(1) the conduct is the offence of arson by negligence` FALSE (JUST TRUE) TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 436(1) the conduct is the offence of arson by negligence` TRUE (JUST TRUE) FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE     -- no marked departure from the standard of care
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 436(1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 436(1) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 436(2) a marked departure from the standard of care may be inferred by the court from the failure to comply with a law` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 436(2) a marked departure from the standard of care may be inferred by the court from the failure to comply with a law` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 436(2) a marked departure from the standard of care may be inferred by the court from the failure to comply with a law` TRUE FALSE EQUALS NOTHING
-- inputs of 436.1: possesses; incendiary material or device; the thing as an explosive substance (s 2); for the purpose of committing an offence under sections 433 to 436
#ASSERT `s 436.1 the conduct is the offence of possession of incendiary material` TRUE TRUE `ccc13 test not an explosive substance` TRUE EQUALS JUST TRUE
#ASSERT `s 436.1 the conduct is the offence of possession of incendiary material` TRUE FALSE `ccc13 test an explosive substance` TRUE EQUALS JUST TRUE
#ASSERT `s 436.1 the conduct is the offence of possession of incendiary material` TRUE FALSE `ccc13 test not an explosive substance` TRUE EQUALS NOTHING      -- s 2 explosive substance does not close its list
#ASSERT `s 436.1 the conduct is the offence of possession of incendiary material` TRUE TRUE `ccc13 test an explosive substance` FALSE EQUALS JUST FALSE        -- no such purpose
#ASSERT `s 436.1 the conduct is the offence of possession of incendiary material` FALSE TRUE `ccc13 test an explosive substance` TRUE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 436.1 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 436.1 the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 437 to s 443 other interference with property`
#ASSERT `s 437 the conduct is the offence of a false alarm of fire` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 437 the conduct is the offence of a false alarm of fire` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 437 the conduct is the offence of a false alarm of fire` TRUE FALSE TRUE EQUALS JUST FALSE       -- with reasonable cause
#ASSERT `s 437 the conduct is the offence of a false alarm of fire` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 437 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `two years`
#ASSERT `s 437 the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 438(1) the conduct is the offence of interfering with the saving of a wrecked vessel` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 438(1) the conduct is the offence of interfering with the saving of a wrecked vessel` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 438(1) the conduct is the offence of interfering with the saving of a wrecked vessel` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 438(1) the conduct is the offence of interfering with the saving of a wrecked vessel` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 438(1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 438(1) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 438(2) the conduct is the offence of interfering with the saving of wreck` `ccc13 test wreck` TRUE EQUALS JUST TRUE
#ASSERT `s 438(2) the conduct is the offence of interfering with the saving of wreck` `ccc13 test wreck` FALSE EQUALS JUST FALSE
#ASSERT `s 438(2) the conduct is the offence of interfering with the saving of wreck` `ccc13 test not wreck` TRUE EQUALS NOTHING
#ASSERT `ccc13 test the number of limbs` (`s 438(2) the punishments` `ccc13 test p787`) EQUALS 1
#ASSERT `s 438(2) the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 439(1) the conduct is the offence of making fast to a marine signal` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 439(1) the conduct is the offence of making fast to a marine signal` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 439(1) the conduct is the offence of making fast to a marine signal` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 439(1) the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 439(2) the conduct is the offence of interfering with a marine signal` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 439(2) the conduct is the offence of interfering with a marine signal` TRUE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 439(2) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `ten years`
#ASSERT `s 439(2) the class of the offence` EQUALS `ccc13 test the hybrid class`
-- inputs of 440: knowingly; without the written permission of the Minister of Transport; removes a natural bar or its protection
#ASSERT `s 440 the conduct is the offence of removing a natural bar without permission` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 440 the conduct is the offence of removing a natural bar without permission` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 440 the conduct is the offence of removing a natural bar without permission` TRUE FALSE TRUE EQUALS JUST FALSE     -- with the written permission
#ASSERT `s 440 the conduct is the offence of removing a natural bar without permission` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 440 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `two years`
#ASSERT `s 440 the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 441 the conduct is the offence of an occupant injuring a building` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 441 the conduct is the offence of an occupant injuring a building` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 441 the conduct is the offence of an occupant injuring a building` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 441 the conduct is the offence of an occupant injuring a building` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 441 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 441 the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 442 the conduct is the offence of interfering with boundary lines` TRUE EQUALS JUST TRUE
#ASSERT `s 442 the conduct is the offence of interfering with boundary lines` FALSE EQUALS JUST FALSE
#ASSERT `s 442 the class of the offence` EQUALS `an offence punishable on summary conviction`
-- inputs of 443(2): a land surveyor in their operations; (a) takes up and replaces; (b) takes up in surveying for a highway; (b) establishes a permanent record
#ASSERT `s 443(2) the land surveyor does not commit an offence under subsection (1)` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 443(2) the land surveyor does not commit an offence under subsection (1)` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 443(2) the land surveyor does not commit an offence under subsection (1)` TRUE FALSE TRUE FALSE EQUALS JUST FALSE      -- (b) needs the permanent record
#ASSERT `s 443(2) the land surveyor does not commit an offence under subsection (1)` FALSE TRUE FALSE FALSE EQUALS JUST FALSE     -- not a land surveyor in their operations
#ASSERT `s 443(2) the land surveyor does not commit an offence under subsection (1)` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- inputs of 443(1): intentionally pulls down, defaces, alters or removes; (a) an international, provincial, county or municipal boundary mark; (b) a surveyor's mark; the saving of (2)
#ASSERT `s 443(1) the conduct is the offence of interfering with international boundary marks, etc.` TRUE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 443(1) the conduct is the offence of interfering with international boundary marks, etc.` TRUE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 443(1) the conduct is the offence of interfering with international boundary marks, etc.` TRUE FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 443(1) the conduct is the offence of interfering with international boundary marks, etc.` FALSE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 443(1) the conduct is the offence of interfering with international boundary marks, etc.` TRUE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE        -- the land surveyor's saving
#ASSERT `s 443(1) the conduct is the offence of interfering with international boundary marks, etc.` TRUE FALSE TRUE NOTHING EQUALS NOTHING
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 443(1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 443(1) the class of the offence` EQUALS `ccc13 test the hybrid class`
