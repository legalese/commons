IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc2-nuclear-prize-fights`

-- ccc2-tests-nuclear-prize-fights.l4 -- tests for ccc2-nuclear-prize-fights.l4 (ss 82.2 to 83). Expected values are written beside each assertion from the
-- text of the provision, before the run. The s 787(1) penalty is a seam input: the tests pass a placeholder that states nothing.

§ `Tests -- section 82.2, device (lines 1219-1223)`

--                                                                                                   kind                                                 radioactive answer  capable
#ASSERT `s 82.2 the thing is a device for the purposes of sections 82.3 to 82.5` `s 82.2(a) a nuclear explosive device` NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 82.2 the thing is a device for the purposes of sections 82.3 to 82.5` `s 82.2(b) a device that disperses radioactive material` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 82.2 the thing is a device for the purposes of sections 82.3 to 82.5` `s 82.2(b) a device that disperses radioactive material` (JUST FALSE) FALSE EQUALS JUST FALSE   -- not radioactive material
#ASSERT `s 82.2 the thing is a device for the purposes of sections 82.3 to 82.5` `s 82.2(b) a device that disperses radioactive material` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 82.2 the thing is a device for the purposes of sections 82.3 to 82.5` `s 82.2(c) a device that emits ionizing radiation` NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 82.2 the thing is a device for the purposes of sections 82.3 to 82.5` `s 82.2(c) a device that emits ionizing radiation` NOTHING FALSE EQUALS JUST FALSE   -- not capable of causing death, serious bodily harm or substantial damage
#ASSERT `s 82.2 the thing is a device for the purposes of sections 82.3 to 82.5` `s 82.2 a device of none of those kinds` NOTHING TRUE EQUALS JUST FALSE   -- "means any of the following"

§ `Tests -- sections 82.3 to 82.5 (lines 1224-1229)`

--                                                                                                                               act                                                                                                                       intent  nuclear material  radioactive material  device  nuclear facility
#ASSERT `s 82.3 the person commits the offence of possessing or using nuclear material, radioactive material or a device with intent to harm` `s 82.3 makes a device` TRUE NOTHING NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 82.3 the person commits the offence of possessing or using nuclear material, radioactive material or a device with intent to harm` `s 82.3 makes a device` FALSE NOTHING NOTHING (JUST TRUE) NOTHING EQUALS NOTHING   -- no intent to cause death, serious bodily harm or substantial damage
#ASSERT `s 82.3 the person commits the offence of possessing or using nuclear material, radioactive material or a device with intent to harm` `s 82.3 makes a device` TRUE NOTHING NOTHING (JUST FALSE) NOTHING EQUALS JUST FALSE   -- not a device
#ASSERT `s 82.3 the person commits the offence of possessing or using nuclear material, radioactive material or a device with intent to harm` `s 82.3 makes a device` TRUE NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 82.3 the person commits the offence of possessing or using nuclear material, radioactive material or a device with intent to harm` `s 82.3 possesses, uses, transfers, exports, imports, alters or disposes of nuclear material` TRUE (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 82.3 the person commits the offence of possessing or using nuclear material, radioactive material or a device with intent to harm` `s 82.3 possesses, uses, transfers, exports, imports, alters or disposes of nuclear material` TRUE (JUST FALSE) NOTHING NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 82.3 the person commits the offence of possessing or using nuclear material, radioactive material or a device with intent to harm` `s 82.3 possesses, uses, transfers, exports, imports, alters or disposes of radioactive material` TRUE NOTHING (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 82.3 the person commits the offence of possessing or using nuclear material, radioactive material or a device with intent to harm` `s 82.3 possesses, uses, transfers, exports, imports, alters or disposes of a device` TRUE NOTHING NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 82.3 the person commits the offence of possessing or using nuclear material, radioactive material or a device with intent to harm` `s 82.3 commits an act against a nuclear facility` TRUE NOTHING NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 82.3 the person commits the offence of possessing or using nuclear material, radioactive material or a device with intent to harm` `s 82.3 commits an act that causes serious interference with or serious disruption of the operations of a nuclear facility` TRUE NOTHING NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 82.3 the person commits the offence of possessing or using nuclear material, radioactive material or a device with intent to harm` `s 82.3 commits an act against a nuclear facility` FALSE NOTHING NOTHING NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 82.3 the person commits the offence of possessing or using nuclear material, radioactive material or a device with intent to harm` `s 82.3 another act` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 82.3 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 82.3 the punishment` EQUALS LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
--                                                                                                                                  act                                    intent to compel  nuclear material  radioactive material  device  nuclear facility
#ASSERT `s 82.4 the person commits the offence of using or altering nuclear material, radioactive material or a device to compel` `s 82.4 uses or alters nuclear material` TRUE (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 82.4 the person commits the offence of using or altering nuclear material, radioactive material or a device to compel` `s 82.4 uses or alters nuclear material` FALSE (JUST TRUE) NOTHING NOTHING NOTHING EQUALS NOTHING   -- no intent to compel
#ASSERT `s 82.4 the person commits the offence of using or altering nuclear material, radioactive material or a device to compel` `s 82.4 uses or alters radioactive material` TRUE NOTHING (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 82.4 the person commits the offence of using or altering nuclear material, radioactive material or a device to compel` `s 82.4 uses or alters a device` TRUE NOTHING NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 82.4 the person commits the offence of using or altering nuclear material, radioactive material or a device to compel` `s 82.4 uses or alters a device` TRUE NOTHING NOTHING (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 82.4 the person commits the offence of using or altering nuclear material, radioactive material or a device to compel` `s 82.4 commits an act against a nuclear facility` TRUE NOTHING NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 82.4 the person commits the offence of using or altering nuclear material, radioactive material or a device to compel` `s 82.4 commits an act that causes serious interference with or serious disruption of the operations of a nuclear facility` TRUE NOTHING NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 82.4 the person commits the offence of using or altering nuclear material, radioactive material or a device to compel` `s 82.4 another act` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 82.4 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 82.4 the punishment` EQUALS LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
--                                                                                                                                      class of the offence                                                         object                                           nuclear material  radioactive material  device  nuclear facility
#ASSERT `s 82.5 the person commits an indictable offence with intent to obtain nuclear material, radioactive material or a device, or access to a nuclear facility` `an indictable offence` `s 82.5 to obtain nuclear material` (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 82.5 the person commits an indictable offence with intent to obtain nuclear material, radioactive material or a device, or access to a nuclear facility` `an indictable offence` `s 82.5 to obtain radioactive material` NOTHING (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 82.5 the person commits an indictable offence with intent to obtain nuclear material, radioactive material or a device, or access to a nuclear facility` `an indictable offence` `s 82.5 to obtain a device` NOTHING NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 82.5 the person commits an indictable offence with intent to obtain nuclear material, radioactive material or a device, or access to a nuclear facility` `an indictable offence` `s 82.5 to obtain access to a nuclear facility` NOTHING NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 82.5 the person commits an indictable offence with intent to obtain nuclear material, radioactive material or a device, or access to a nuclear facility` `an offence that the section makes both indictable and punishable on summary conviction` `s 82.5 to obtain nuclear material` (JUST TRUE) NOTHING NOTHING NOTHING EQUALS NOTHING   -- a dual-procedure offence: the text does not say (fork F14)
#ASSERT `s 82.5 the person commits an indictable offence with intent to obtain nuclear material, radioactive material or a device, or access to a nuclear facility` `an offence punishable on summary conviction` `s 82.5 to obtain nuclear material` (JUST TRUE) NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 82.5 the person commits an indictable offence with intent to obtain nuclear material, radioactive material or a device, or access to a nuclear facility` `an indictable offence` `s 82.5 to obtain nuclear material` (JUST FALSE) NOTHING NOTHING NOTHING EQUALS JUST FALSE   -- not nuclear material
#ASSERT `s 82.5 the person commits an indictable offence with intent to obtain nuclear material, radioactive material or a device, or access to a nuclear facility` `an indictable offence` `s 82.5 another object` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 82.5 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 82.5 the punishment` EQUALS LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `Tests -- sections 82.6 and 82.7 (lines 1230-1233)`

-- 82.6: "any of sections 82.3 to 82.5": both ends are in, 82.2 and 82.6 are out.
#ASSERT `s 82.6 the person threatens to commit an offence under any of sections 82.3 to 82.5` TRUE (`Provision of the Code` OF 82.3, "") EQUALS JUST TRUE
#ASSERT `s 82.6 the person threatens to commit an offence under any of sections 82.3 to 82.5` TRUE (`Provision of the Code` OF 82.4, "") EQUALS JUST TRUE
#ASSERT `s 82.6 the person threatens to commit an offence under any of sections 82.3 to 82.5` TRUE (`Provision of the Code` OF 82.5, "") EQUALS JUST TRUE
#ASSERT `s 82.6 the person threatens to commit an offence under any of sections 82.3 to 82.5` TRUE (`Provision of the Code` OF 82.2, "") EQUALS NOTHING
#ASSERT `s 82.6 the person threatens to commit an offence under any of sections 82.3 to 82.5` TRUE (`Provision of the Code` OF 82.6, "") EQUALS NOTHING
#ASSERT `s 82.6 the person threatens to commit an offence under any of sections 82.3 to 82.5` TRUE (`Provision of the Code` OF 83, "(1)") EQUALS NOTHING
#ASSERT `s 82.6 the person threatens to commit an offence under any of sections 82.3 to 82.5` FALSE (`Provision of the Code` OF 82.3, "") EQUALS NOTHING   -- does not threaten
#ASSERT `s 82.6 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 82.6 the punishment` EQUALS LIST Punishment OF `by indictment`, `imprisonment for a term of` `fourteen years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
--                                                                  armed conflict  in accordance with international law  military forces  governed by other rules of international law
#ASSERT `s 82.7 sections 82.3 to 82.6 apply to the act` TRUE  TRUE  FALSE FALSE EQUALS JUST FALSE   -- an act during an armed conflict that is in accordance with international law
#ASSERT `s 82.7 sections 82.3 to 82.6 apply to the act` TRUE  FALSE FALSE FALSE EQUALS NOTHING     -- in an armed conflict but not in accordance with the law applicable
#ASSERT `s 82.7 sections 82.3 to 82.6 apply to the act` FALSE TRUE  FALSE FALSE EQUALS NOTHING
#ASSERT `s 82.7 sections 82.3 to 82.6 apply to the act` FALSE FALSE TRUE  TRUE  EQUALS JUST FALSE   -- activities of military forces in the exercise of their official duties, governed by other rules of international law
#ASSERT `s 82.7 sections 82.3 to 82.6 apply to the act` FALSE FALSE TRUE  FALSE EQUALS NOTHING     -- "to the extent that" they are governed by other rules
#ASSERT `s 82.7 sections 82.3 to 82.6 apply to the act` FALSE FALSE FALSE TRUE  EQUALS NOTHING

§ `Tests -- section 83, prize fights (lines 1236-1247)`

--                                                       fists/hands/feet  between two  arrangement  amateur  IOC/IPC  designated  permission required  permission given  boxing/MMA  board
#ASSERT `s 83(2) the encounter is a prize fight` TRUE  TRUE  TRUE  FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 83(2) the encounter is a prize fight` FALSE TRUE  TRUE  FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- not with fists, hands or feet
#ASSERT `s 83(2) the encounter is a prize fight` TRUE  FALSE TRUE  FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- not between two persons
#ASSERT `s 83(2) the encounter is a prize fight` TRUE  TRUE  FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- no previous arrangement
-- (a) amateur contest, sport on the programme of the IOC or IPC; permission only if it is required.
#ASSERT `s 83(2) the encounter is a prize fight` TRUE TRUE TRUE TRUE TRUE  FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- (a), permission not required
#ASSERT `s 83(2) the encounter is a prize fight` TRUE TRUE TRUE TRUE TRUE  FALSE TRUE  TRUE  FALSE FALSE EQUALS JUST FALSE   -- (a), permission required and given
#ASSERT `s 83(2) the encounter is a prize fight` TRUE TRUE TRUE TRUE TRUE  FALSE TRUE  FALSE FALSE FALSE EQUALS JUST TRUE    -- (a), permission required and not given: not excluded
-- (b) amateur contest, sport designated by the lieutenant governor in council or the body specified.
#ASSERT `s 83(2) the encounter is a prize fight` TRUE TRUE TRUE TRUE FALSE TRUE  FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- (b), permission not required
#ASSERT `s 83(2) the encounter is a prize fight` TRUE TRUE TRUE TRUE FALSE TRUE  TRUE  FALSE FALSE FALSE EQUALS JUST TRUE    -- (b), permission required and not given
-- (c) amateur contest with the permission of the lieutenant governor in council or the body specified.
#ASSERT `s 83(2) the encounter is a prize fight` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE  FALSE FALSE EQUALS JUST FALSE   -- (c)
#ASSERT `s 83(2) the encounter is a prize fight` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE    -- amateur contest, no programme, no designation, no permission
-- (d) boxing or mixed martial arts contest with the permission or under the authority of an athletic board.
#ASSERT `s 83(2) the encounter is a prize fight` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE  TRUE  EQUALS JUST FALSE   -- (d)
#ASSERT `s 83(2) the encounter is a prize fight` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE  FALSE EQUALS JUST TRUE    -- boxing without the board's permission or authority
#ASSERT `s 83(1) the person takes part in a prize fight` `s 83(1)(a) engages as a principal in a prize fight` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 83(1) the person takes part in a prize fight` `s 83(1)(b) advises, encourages or promotes a prize fight` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 83(1) the person takes part in a prize fight` `s 83(1)(c) is present at a prize fight as an aid, second, surgeon, umpire, backer or reporter` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 83(1) the person takes part in a prize fight` `s 83(1)(a) engages as a principal in a prize fight` (JUST FALSE) EQUALS JUST FALSE   -- not a prize fight
#ASSERT `s 83(1) the person takes part in a prize fight` `s 83(1)(a) engages as a principal in a prize fight` NOTHING EQUALS NOTHING
#ASSERT `s 83(1) the person takes part in a prize fight` `s 83(1) an act that is none of those in paragraphs (a) to (c)` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 83(1) the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 83(1) the punishment` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
