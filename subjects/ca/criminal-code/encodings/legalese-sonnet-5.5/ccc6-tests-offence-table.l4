IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc6-offence-table`
IMPORT `ccc6-tests-support`

-- Tests for the seam table. Expected values decided from the text of each section.
-- s 787(1)'s penalty is a stand-in: 6 months, summary, with a fine in the discretion of the court.

`ss 151 to 182 test s 787(1) penalty` MEANS Punishment OF `on summary conviction`, `imprisonment for a term of` `six months`, `no imprisonment is stated`, `a fine in the discretion of the court`, `no fine is stated`

§ `ss 151 to 182 the class of the offence under the provision`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 151, "") EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 152, "(1)") EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 155, "(1)") EQUALS JUST `an indictable offence`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 160, "(1)") EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 160, "(5)") EQUALS JUST `an offence punishable on summary conviction`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 160, "") EQUALS NOTHING   -- section 160 has offences of two classes: a bare section number does not say which
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 163, "(2)") EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 165, "") EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`   -- section 165 is shown repealed but s 169 still names it
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 163.1, "(2)") EQUALS JUST `an indictable offence`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 163.1, "(4)") EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 163.1, "") EQUALS NOTHING
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 170, "") EQUALS JUST `an indictable offence`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 174, "(1)") EQUALS JUST `an offence punishable on summary conviction`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 175, "(1)") EQUALS JUST `an offence punishable on summary conviction`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 176, "(1)") EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 176, "(2)") EQUALS JUST `an offence punishable on summary conviction`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 176, "") EQUALS NOTHING
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 177, "") EQUALS JUST `an offence punishable on summary conviction`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 182, "") EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 150.1, "") EQUALS NOTHING   -- s 150.1 creates no offence
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 164, "(1)") EQUALS NOTHING
#ASSERT `ss 151 to 182 the class of the offence under the provision` (`Provision of the Code` OF 271, "") EQUALS NOTHING   -- an offence of another part

§ `ss 151 to 182 the punishments of the offence under the provision`
#ASSERT `ss 151 to 182 the punishments of the offence under the provision` (`Provision of the Code` OF 151, "") `ss 151 to 182 test s 787(1) penalty` EQUALS JUST (LIST (`ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) (`ss 150 to 182 test a term of years` 1)), (`ss 150 to 182 test a summary punishment` `ss 150 to 182 test a term of two years less a day` (`ss 150 to 182 test a term of days` 90)))
#ASSERT `ss 151 to 182 the punishments of the offence under the provision` (`Provision of the Code` OF 160, "(5)") `ss 151 to 182 test s 787(1) penalty` EQUALS JUST (LIST `ss 151 to 182 test s 787(1) penalty`)   -- only s 787(1)'s penalty
#ASSERT `ss 151 to 182 the punishments of the offence under the provision` (`Provision of the Code` OF 160, "(1)") `ss 151 to 182 test s 787(1) penalty` EQUALS JUST (LIST (`ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 10) `no imprisonment is stated`), `ss 151 to 182 test s 787(1) penalty`)
#ASSERT `ss 151 to 182 the punishments of the offence under the provision` (`Provision of the Code` OF 155, "(1)") `ss 151 to 182 test s 787(1) penalty` EQUALS JUST (LIST (`ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) (`ss 150 to 182 test a term of years` 5)), (`ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) `no imprisonment is stated`))   -- the minimum of five years if the other person is under 16, none otherwise
#ASSERT `ss 151 to 182 the punishments of the offence under the provision` (`Provision of the Code` OF 162.1, "(1)") `ss 151 to 182 test s 787(1) penalty` EQUALS JUST (LIST (`ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 10) `no imprisonment is stated`), (`ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) `no imprisonment is stated`), `ss 151 to 182 test s 787(1) penalty`)   -- (a)(i), (a)(ii), (b)
#ASSERT `ss 151 to 182 the punishments of the offence under the provision` (`Provision of the Code` OF 170, "") `ss 151 to 182 test s 787(1) penalty` EQUALS JUST (LIST (`ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) (`ss 150 to 182 test a term of years` 1)))   -- indictable only
#ASSERT `ss 151 to 182 the punishments of the offence under the provision` (`Provision of the Code` OF 173, "(2)") `ss 151 to 182 test s 787(1) penalty` EQUALS JUST (LIST (`ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 10) (`ss 150 to 182 test a term of days` 90)), (`ss 150 to 182 test a summary punishment` `ss 150 to 182 test a term of two years less a day` (`ss 150 to 182 test a term of days` 30)))
#ASSERT `ss 151 to 182 the punishments of the offence under the provision` (`Provision of the Code` OF 164, "(1)") `ss 151 to 182 test s 787(1) penalty` EQUALS NOTHING
#ASSERT `ss 151 to 182 the punishments of the offence under the provision` (`Provision of the Code` OF 160, "") `ss 151 to 182 test s 787(1) penalty` EQUALS NOTHING
