#ASSERT `Under section 445.2(1), is the animal a cetacean` FALSE TRUE EQUALS JUST TRUE      -- "including a whale, dolphin or porpoise"
#ASSERT `Under section 445.2(1), is the animal a cetacean` FALSE FALSE EQUALS NOTHING      -- "includes": the list is not closed, so the text does not say another animal is not a cetacean
