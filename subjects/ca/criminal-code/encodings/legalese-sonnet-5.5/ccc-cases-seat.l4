-- ====================================================================================================
-- cases-seat questions from part ccc1 (merged by the lead on 2026-11-12; unchanged text follows)
-- ====================================================================================================
-- ccc1-cases-seat.l4 -- cases for the seat layer ccc1-seat.l4 (sections 3.1 to 45 of the Criminal Code (Canada)).
-- Each assertion gives the facts a person in the seat would state, positionally in the order of the question's
-- inputs, and the answer the text requires, written by hand from the text before the run. Every question has at
-- least one case; most also have a case the text does not answer (NOTHING) or answers no (JUST FALSE).

-- Under section 4(3), do I have the thing in possession, or is it deemed to be in the custody and possession of each and all of the persons who have it?
#ASSERT `Under section 4(3), do I have the thing in possession, or is it deemed to be in the custody and possession of each and all of the persons who have it` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- 4(3)(a): "a person has anything in possession when he has it in his personal possession"
#ASSERT `Under section 4(3), do I have the thing in possession, or is it deemed to be in the custody and possession of each and all of the persons who have it` FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE   -- 4(3)(b): one of two or more persons has it with the knowledge and consent of the rest: deemed in the custody and possession of each and all of them
#ASSERT `Under section 4(3), do I have the thing in possession, or is it deemed to be in the custody and possession of each and all of the persons who have it` FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE   -- neither limb holds: the rest do not know and consent, and I do not have it myself

-- Under section 4(7), may the court require me to appear before it for examination or cross-examination?
#ASSERT `Under section 4(7), may the court require me to appear before it for examination or cross-examination` TRUE TRUE EQUALS JUST TRUE   -- as in the layer-1 test: the court may require the signatory to appear
#ASSERT `Under section 4(7), may the court require me to appear before it for examination or cross-examination` TRUE FALSE EQUALS NOTHING   -- as in the layer-1 test: on some other issue
#ASSERT `Under section 4(7), may the court require me to appear before it for examination or cross-examination` FALSE TRUE EQUALS NOTHING   -- as in the layer-1 test: not a signatory under (6) or (6.1)

-- Under section 6(1)(a), am I deemed not to be guilty of the offence?
#ASSERT `Under section 6(1)(a), am I deemed not to be guilty of the offence` TRUE FALSE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: before conviction or discharge
#ASSERT `Under section 6(1)(a), am I deemed not to be guilty of the offence` TRUE TRUE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: after conviction: the "until" bar has ended
#ASSERT `Under section 6(1)(a), am I deemed not to be guilty of the offence` TRUE FALSE TRUE EQUALS JUST FALSE   -- as in the layer-1 test: after discharge under section 730

-- Under section 6(1)(b), am I liable to the punishment?
#ASSERT `Under section 6(1)(b), am I liable to the punishment` TRUE TRUE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: not liable to a punishment other than the prescribed one
#ASSERT `Under section 6(1)(b), am I liable to the punishment` FALSE TRUE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: no enactment creating the offence: "Where an enactment creates an offence and authorizes a punishment"
#ASSERT `Under section 6(1)(b), am I liable to the punishment` TRUE TRUE TRUE EQUALS NOTHING   -- as in the layer-1 test: the paragraph does not itself make the person liable to the prescribed one
#ASSERT `Under section 6(1)(b), am I liable to the punishment` TRUE FALSE FALSE EQUALS NOTHING   -- as in the layer-1 test: not convicted or discharged: not covered

-- Under section 6(2), is my conviction or discharge under section 730 barred because the offence was committed outside Canada?
#ASSERT `Under section 6(2), is my conviction or discharge under section 730 barred because the offence was committed outside Canada` TRUE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: barred
#ASSERT `Under section 6(2), is my conviction or discharge under section 730 barred because the offence was committed outside Canada` TRUE TRUE EQUALS NOTHING   -- as in the layer-1 test: "Subject to this Act or any other Act of Parliament"
#ASSERT `Under section 6(2), is my conviction or discharge under section 730 barred because the offence was committed outside Canada` FALSE FALSE EQUALS NOTHING   -- as in the layer-1 test: committed in Canada: the subsection is silent

-- Under section 7(1), is what I did deemed to have been committed in Canada?
#ASSERT `Under section 7(1), is what I did deemed to have been committed in Canada` `s 7(1)(a)(i) an aircraft registered in Canada under regulations made under the Aeronautics Act` TRUE FALSE `an indictable offence` EQUALS JUST TRUE   -- as in the layer-1 test: (a)(i): registered in Canada, in flight; where the flight ended does not matter
#ASSERT `Under section 7(1), is what I did deemed to have been committed in Canada` `s 7(1)(a)(ii) an aircraft leased without crew and operated by a person who is qualified under regulations made under the Aeronautics Act to be registered as owner of an aircraft registered in Canada under those regulations` TRUE FALSE `an offence that the section makes both indictable and punishable on summary conviction` EQUALS JUST TRUE   -- as in the layer-1 test: (a)(ii), and an offence that is also punishable by indictment
#ASSERT `Under section 7(1), is what I did deemed to have been committed in Canada` `s 7(1)(b) any other aircraft` TRUE FALSE `an indictable offence` EQUALS JUST FALSE   -- as in the layer-1 test: (b): "if the flight terminated in Canada" is not met
#ASSERT `Under section 7(1), is what I did deemed to have been committed in Canada` `s 7(1)(a)(i) an aircraft registered in Canada under regulations made under the Aeronautics Act` FALSE TRUE `an indictable offence` EQUALS JUST FALSE   -- as in the layer-1 test: not in flight: "while the aircraft is in flight"
#ASSERT `Under section 7(1), is what I did deemed to have been committed in Canada` `s 7(1) not an aircraft` TRUE TRUE `an indictable offence` EQUALS NOTHING   -- as in the layer-1 test: not on or in respect of an aircraft: the subsection is silent
#ASSERT `Under section 7(1), is what I did deemed to have been committed in Canada` `s 7(1)(a)(i) an aircraft registered in Canada under regulations made under the Aeronautics Act` TRUE TRUE `an offence punishable on summary conviction` EQUALS NOTHING   -- as in the layer-1 test: an offence punishable only on summary conviction is not "an offence punishable by indictment"

-- Under section 7(2), is what I did deemed to have been committed in Canada?
#ASSERT `Under section 7(2), is what I did deemed to have been committed in Canada` TRUE `s 7(2)(a) on an aircraft, while the aircraft is in flight` 76 "" `s 7 the act or omission would be the offence itself` TRUE FALSE TRUE EQUALS JUST TRUE   -- as in the layer-1 test: (a): on an aircraft in flight, an offence against section 76, the person present in Canada after
#ASSERT `Under section 7(2), is what I did deemed to have been committed in Canada` TRUE `s 7(2)(a) on an aircraft, while the aircraft is in flight` 77 "(a)" `s 7 the act or omission would be the offence itself` TRUE FALSE TRUE EQUALS JUST TRUE   -- as in the layer-1 test: (a): paragraph 77(a)
#ASSERT `Under section 7(2), is what I did deemed to have been committed in Canada` TRUE `s 7(2)(a) on an aircraft, while the aircraft is in flight` 77 "(c)" `s 7 the act or omission would be the offence itself` TRUE TRUE TRUE EQUALS NOTHING   -- as in the layer-1 test: 77(c) is a paragraph (b) offence, not an offence of paragraph (a): not covered
#ASSERT `Under section 7(2), is what I did deemed to have been committed in Canada` TRUE `s 7(2)(b) in relation to an aircraft in service` 77 "(c)" `s 7 the act or omission would be the offence itself` TRUE FALSE TRUE EQUALS NOTHING   -- as in the layer-1 test: (b): the aircraft is not in service, so not "in relation to an aircraft in service"
#ASSERT `Under section 7(2), is what I did deemed to have been committed in Canada` TRUE `s 7(2)(a) on an aircraft, while the aircraft is in flight` 76 "" `s 7 the act or omission would be the offence itself` FALSE TRUE TRUE EQUALS JUST FALSE   -- as in the layer-1 test: (a): not in flight, "while the aircraft is in flight"
#ASSERT `Under section 7(2), is what I did deemed to have been committed in Canada` TRUE `s 7(2)(a) on an aircraft, while the aircraft is in flight` 76 "" `s 7 the act or omission would be the offence itself` TRUE TRUE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: the person is not present in Canada afterwards: "if the person is, after the commission thereof, present in Canada"

-- Under section 7(2.01), is what I did deemed to have been committed in Canada?
#ASSERT `Under section 7(2.01), is what I did deemed to have been committed in Canada` TRUE 322 "" `s 7 the act or omission would be the offence itself` TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: (a): a Canadian citizen
#ASSERT `Under section 7(2.01), is what I did deemed to have been committed in Canada` TRUE 322 "" `s 7 the act or omission would be the offence itself` TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: (b)
#ASSERT `Under section 7(2.01), is what I did deemed to have been committed in Canada` TRUE 322 "" `s 7 the act or omission would be the offence itself` TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: none of (a) to (c): "is deemed ... if the person"
#ASSERT `Under section 7(2.01), is what I did deemed to have been committed in Canada` TRUE 321 "" `s 7 the act or omission would be the offence itself` TRUE TRUE FALSE FALSE EQUALS NOTHING   -- as in the layer-1 test: section 321 is not one of the six sections
#ASSERT `Under section 7(2.01), is what I did deemed to have been committed in Canada` TRUE 323 "" `s 7 the act or omission would be the offence itself` TRUE TRUE FALSE FALSE EQUALS NOTHING   -- as in the layer-1 test: section 323 is not one of the six sections

-- Under section 7(2.1), is what I did deemed to have been committed in Canada?
#ASSERT `Under section 7(2.1), is what I did deemed to have been committed in Canada` TRUE TRUE 78.1 "" `s 7 the act or omission would be the offence itself` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: (a)
#ASSERT `Under section 7(2.1), is what I did deemed to have been committed in Canada` TRUE TRUE 78.1 "" `s 7 the act or omission would be the offence itself` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: (b)
#ASSERT `Under section 7(2.1), is what I did deemed to have been committed in Canada` TRUE TRUE 78.1 "" `s 7 the act or omission would be the offence itself` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: none of (a) to (g)
#ASSERT `Under section 7(2.1), is what I did deemed to have been committed in Canada` TRUE TRUE 78.1 "" `s 7 the act or omission has none of those relations to the offence` FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- as in the layer-1 test: no relation to the offence
#ASSERT `Under section 7(2.1), is what I did deemed to have been committed in Canada` TRUE TRUE 78 "" `s 7 the act or omission would be the offence itself` FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- as in the layer-1 test: section 78 is not section 78.1

-- Under section 7(2.2), is what I did deemed to have been committed in Canada?
#ASSERT `Under section 7(2.2), is what I did deemed to have been committed in Canada` TRUE TRUE 78.1 "" `s 7 the act or omission would be the offence itself` FALSE TRUE FALSE FALSE FALSE FALSE FALSE `s 7(2.2)(b)(i) a state, other than the state in which the act or omission was committed, that is a party to the Convention for the Suppression of Unlawful Acts against the Safety of Maritime Navigation, done at Rome on March 10, 1988, in respect of an offence committed against or on board a ship` EQUALS JUST TRUE   -- as in the layer-1 test: (a) by way of (2.1)(b) and (b)(i)
#ASSERT `Under section 7(2.2), is what I did deemed to have been committed in Canada` TRUE TRUE 78.1 "" `s 7 the act or omission would be the offence itself` FALSE FALSE FALSE FALSE FALSE FALSE TRUE `s 7(2.2)(b)(ii) a state, other than the state in which the act or omission was committed, that is a party to the Protocol for the Suppression of Unlawful Acts against the Safety of Fixed Platforms Located on the Continental Shelf, done at Rome on March 10, 1988, in respect of an offence committed against or on board a fixed platform` EQUALS JUST TRUE   -- as in the layer-1 test: (a) by way of (2.1)(g) and (b)(ii)
#ASSERT `Under section 7(2.2), is what I did deemed to have been committed in Canada` TRUE TRUE 78.1 "" `s 7 the act or omission would be the offence itself` TRUE FALSE FALSE FALSE FALSE FALSE FALSE `s 7(2.2)(b)(i) a state, other than the state in which the act or omission was committed, that is a party to the Convention for the Suppression of Unlawful Acts against the Safety of Maritime Navigation, done at Rome on March 10, 1988, in respect of an offence committed against or on board a ship` EQUALS JUST FALSE   -- as in the layer-1 test: only paragraph (2.1)(a) holds: "any of paragraphs (2.1)(b) to (g)" is not met
#ASSERT `Under section 7(2.2), is what I did deemed to have been committed in Canada` TRUE TRUE 78.1 "" `s 7 the act or omission would be the offence itself` FALSE FALSE TRUE FALSE FALSE FALSE FALSE `s 7(2.2)(b) a state that is none of those` EQUALS JUST FALSE   -- as in the layer-1 test: (b) is not met: both paragraphs are required ("and")
#ASSERT `Under section 7(2.2), is what I did deemed to have been committed in Canada` TRUE FALSE 78.1 "" `s 7 the act or omission would be the offence itself` FALSE FALSE TRUE FALSE FALSE FALSE FALSE `s 7(2.2)(b)(i) a state, other than the state in which the act or omission was committed, that is a party to the Convention for the Suppression of Unlawful Acts against the Safety of Maritime Navigation, done at Rome on March 10, 1988, in respect of an offence committed against or on board a ship` EQUALS NOTHING   -- as in the layer-1 test: the platform is attached to the continental shelf, or the ship navigates beyond the territorial sea: that is (2.1)
#ASSERT `Under section 7(2.2), is what I did deemed to have been committed in Canada` TRUE TRUE 78 "" `s 7 the act or omission would be the offence itself` FALSE FALSE TRUE FALSE FALSE FALSE FALSE `s 7(2.2)(b)(i) a state, other than the state in which the act or omission was committed, that is a party to the Convention for the Suppression of Unlawful Acts against the Safety of Maritime Navigation, done at Rome on March 10, 1988, in respect of an offence committed against or on board a ship` EQUALS NOTHING   -- as in the layer-1 test: not section 78.1

-- Under section 7(2.21), is what I did deemed to have been committed in Canada?
#ASSERT `Under section 7(2.21), is what I did deemed to have been committed in Canada` TRUE 82.3 "" `s 7 the act or omission would be the offence itself` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: section 82.3, the first section of the range; ground (a)
#ASSERT `Under section 7(2.21), is what I did deemed to have been committed in Canada` TRUE 82.6 "" `s 7 the act or omission would be the offence itself` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: section 82.6, the last section of the range; ground (b)(i)
#ASSERT `Under section 7(2.21), is what I did deemed to have been committed in Canada` TRUE 82.4 "" `s 7 the act or omission would be an attempt to commit the offence` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: no ground: "is deemed ... if"
#ASSERT `Under section 7(2.21), is what I did deemed to have been committed in Canada` TRUE 82.2 "" `s 7 the act or omission would be the offence itself` FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING   -- as in the layer-1 test: section 82.2 is before 82.3
#ASSERT `Under section 7(2.21), is what I did deemed to have been committed in Canada` TRUE 82.7 "" `s 7 the act or omission would be the offence itself` FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING   -- as in the layer-1 test: section 82.7 is after 82.6

-- Under section 7(2.3), is what I did deemed to have been committed in Canada?
#ASSERT `Under section 7(2.3), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` TRUE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: (a): on, or in relation to, a flight element
#ASSERT `Under section 7(2.3), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` FALSE TRUE EQUALS JUST TRUE   -- as in the layer-1 test: (b): on a means of transportation to or from the Space Station
#ASSERT `Under section 7(2.3), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` FALSE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: neither (a) nor (b): "if that act or omission is committed"
#ASSERT `Under section 7(2.3), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an offence punishable on summary conviction` TRUE FALSE EQUALS NOTHING   -- as in the layer-1 test: not an indictable offence
#ASSERT `Under section 7(2.3), is what I did deemed to have been committed in Canada` TRUE TRUE FALSE `an indictable offence` TRUE FALSE EQUALS NOTHING   -- as in the layer-1 test: committed in Canada

-- Under section 7(2.31), is what I did deemed to have been committed in Canada?
#ASSERT `Under section 7(2.31), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` TRUE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: (a): threatens the life or security of a Canadian crew member
#ASSERT `Under section 7(2.31), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` FALSE TRUE EQUALS JUST TRUE   -- as in the layer-1 test: (b): on or in relation to, or damages, a flight element provided by Canada
#ASSERT `Under section 7(2.31), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` FALSE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: neither (a) nor (b)
#ASSERT `Under section 7(2.31), is what I did deemed to have been committed in Canada` TRUE TRUE FALSE `an indictable offence` TRUE FALSE EQUALS NOTHING   -- as in the layer-1 test: not on a flight element or a means of transportation
#ASSERT `Under section 7(2.31), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an offence punishable on summary conviction` TRUE FALSE EQUALS NOTHING   -- as in the layer-1 test: not an indictable offence

-- Under section 7(2.35), is what I did deemed to have been committed in Canada?
#ASSERT `Under section 7(2.35), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` TRUE FALSE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: (a)
#ASSERT `Under section 7(2.35), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` FALSE TRUE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: (b)
#ASSERT `Under section 7(2.35), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` FALSE FALSE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: none of (a) to (c)
#ASSERT `Under section 7(2.35), is what I did deemed to have been committed in Canada` FALSE TRUE TRUE `an indictable offence` TRUE FALSE FALSE EQUALS NOTHING   -- as in the layer-1 test: not a Canadian crew member
#ASSERT `Under section 7(2.35), is what I did deemed to have been committed in Canada` TRUE TRUE FALSE `an indictable offence` TRUE FALSE FALSE EQUALS NOTHING   -- as in the layer-1 test: committed in Canada

-- Under section 7(2.36), is what I did deemed to have been committed in Canada?
#ASSERT `Under section 7(2.36), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` TRUE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: (a)
#ASSERT `Under section 7(2.36), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` FALSE TRUE EQUALS JUST TRUE   -- as in the layer-1 test: (b)
#ASSERT `Under section 7(2.36), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` FALSE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: neither
#ASSERT `Under section 7(2.36), is what I did deemed to have been committed in Canada` TRUE TRUE FALSE `an indictable offence` TRUE FALSE EQUALS NOTHING   -- as in the layer-1 test: not on the Gateway, a means of transportation or the surface of the Moon
#ASSERT `Under section 7(2.36), is what I did deemed to have been committed in Canada` FALSE TRUE TRUE `an indictable offence` TRUE FALSE EQUALS NOTHING   -- as in the layer-1 test: not a crew member of a Partner State

-- Under section 7(3), is what I did deemed to have been committed in Canada?
#ASSERT `Under section 7(3), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE 235 "" TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: section 235; ground (a)
#ASSERT `Under section 7(3), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE 235 "" FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: section 235; ground (b)(i)
#ASSERT `Under section 7(3), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE 235 "" FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: no ground: "is deemed to commit that act or omission in Canada if"
#ASSERT `Under section 7(3), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE 234 "" TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- as in the layer-1 test: section 234 is not listed
#ASSERT `Under section 7(3), is what I did deemed to have been committed in Canada` TRUE TRUE TRUE 237 "" TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- as in the layer-1 test: section 237 is not listed

-- Under section 7(3.1), is what I did deemed to have been committed in Canada?
#ASSERT `Under section 7(3.1), is what I did deemed to have been committed in Canada` TRUE 279.1 "" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: section 279.1; ground (a)
#ASSERT `Under section 7(3.1), is what I did deemed to have been committed in Canada` TRUE 279.1 "" FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- as in the layer-1 test: section 279.1; ground (b)(i)
#ASSERT `Under section 7(3.1), is what I did deemed to have been committed in Canada` TRUE 279.1 "" FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- as in the layer-1 test: no ground
#ASSERT `Under section 7(3.1), is what I did deemed to have been committed in Canada` TRUE 279 "" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- as in the layer-1 test: section 279 is not section 279.1
#ASSERT `Under section 7(3.1), is what I did deemed to have been committed in Canada` TRUE 279.2 "" TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- as in the layer-1 test: nor is 279.2

-- Under section 7(3.7), is what I did deemed to have been committed in Canada?
