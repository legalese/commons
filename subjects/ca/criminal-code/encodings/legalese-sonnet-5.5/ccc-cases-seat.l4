#ASSERT `Under section 830(1), may I appeal against the decision on the ground` TRUE TRUE `s 830(1) another ground` EQUALS NOTHING
#ASSERT `Under section 830(1), may I appeal against the decision on the ground` FALSE TRUE `s 830(1)(a) it is erroneous in point of law` EQUALS NOTHING

-- s 830(2) the appeal is required to be based on a transcript of the proceedings appealed from
