#ASSERT `Under section 26, am I criminally responsible for the excess of force I used` TRUE FALSE EQUALS NOTHING   -- as in the layer-1 test: authorized, no excess: the section speaks only of the excess
#ASSERT `Under section 26, am I criminally responsible for the excess of force I used` FALSE TRUE EQUALS NOTHING   -- as in the layer-1 test: not authorized by law to use force

