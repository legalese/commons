#ASSERT `Under section 457(4), is there a defence because my printed likeness of a Canadian bank-note is a different size` FALSE 0.5 1 TRUE FALSE EQUALS NOTHING
#ASSERT `Under section 458, have I committed the offence concerning instruments for counterfeiting` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 458, have I committed the offence concerning instruments for counterfeiting` TRUE TRUE FALSE EQUALS NOTHING
