#ASSERT `Under section 215(4), does a month's failure to provide for my child count as proof that I failed without lawful excuse` (Date 1 1 2024) (Date 1 2 2024) TRUE 5 FALSE EQUALS JUST TRUE
-- 31 January is before the month is complete
#ASSERT `Under section 215(4), does a month's failure to provide for my child count as proof that I failed without lawful excuse` (Date 1 1 2024) (Date 31 1 2024) TRUE 5 FALSE EQUALS JUST FALSE
-- "in the absence of evidence to the contrary": evidence to the contrary is given
#ASSERT `Under section 215(4), does a month's failure to provide for my child count as proof that I failed without lawful excuse` (Date 1 1 2024) (Date 1 2 2024) TRUE 5 TRUE EQUALS JUST FALSE
-- a child of sixteen: the provision is limited to a child under sixteen years
#ASSERT `Under section 215(4), does a month's failure to provide for my child count as proof that I failed without lawful excuse` (Date 1 1 2024) (Date 1 2 2024) TRUE 16 FALSE EQUALS NOTHING

