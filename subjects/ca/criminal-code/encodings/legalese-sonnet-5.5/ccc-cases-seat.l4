#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test the limbs of the answer` ((`Under section 394(5), am I guilty of an offence for contravening subsection (1), (2) or (3), and what are its class and punishments` TRUE TRUE TRUE TRUE TRUE `a mineral` 10000 TRUE TRUE TRUE TRUE TRUE 5000 24 TRUE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `imprisonment for a term of` `five years`      -- the greatest term by indictment the penalty provision gives (s 394(5))
#ASSERT `ccc13 test the maximum fine on summary conviction` (`ccc13 test the limbs of the answer` ((`Under section 394(5), am I guilty of an offence for contravening subsection (1), (2) or (3), and what are its class and punishments` TRUE TRUE TRUE TRUE TRUE `a mineral` 10000 TRUE TRUE TRUE TRUE TRUE 5000 24 TRUE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `a fine of` 5000      -- the summary limb is what the person gave for section 787(1)
#ASSERT `ccc13 test the maximum imprisonment on summary conviction` (`ccc13 test the limbs of the answer` ((`Under section 394(5), am I guilty of an offence for contravening subsection (1), (2) or (3), and what are its class and punishments` TRUE TRUE TRUE TRUE TRUE `a mineral` 10000 TRUE TRUE TRUE TRUE TRUE 5000 24 TRUE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `imprisonment for a term of` (`Length of time` OF 0, 24, 0, TRUE)      -- the summary limb is what the person gave for section 787(1): 24 months, less a day
#ASSERT `ccc13 test the maximum imprisonment on summary conviction` (`ccc13 test the limbs of the answer` ((`Under section 394(5), am I guilty of an offence for contravening subsection (1), (2) or (3), and what are its class and punishments` TRUE TRUE TRUE TRUE TRUE `a mineral` 10000 TRUE TRUE TRUE TRUE TRUE 5000 24 FALSE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `imprisonment for a term of` (`Length of time` OF 0, 24, 0, FALSE)      -- the same, when the person says the term is not "less a day"
-- Under section 394(6), apart from subsection (7), may the court order the thing forfeited to Her Majesty
#ASSERT `Under section 394(6), apart from subsection (7), may the court order the thing forfeited to Her Majesty` TRUE TRUE EQUALS JUST TRUE      -- "If a person is convicted of an offence under this section, the court may order anything by means of or in relation to which the offence was committed ... to be forfeited"
#ASSERT `Under section 394(6), apart from subsection (7), may the court order the thing forfeited to Her Majesty` FALSE TRUE EQUALS NOTHING      -- a "may" grant whose "if" gate fails answers NOTHING (2026-11-12 three limits, (1)); the other reading is JUST FALSE
#ASSERT `Under section 394(6), apart from subsection (7), may the court order the thing forfeited to Her Majesty` TRUE FALSE EQUALS NOTHING      -- the power reaches only "anything by means of or in relation to which the offence was committed"; outside it the text is silent
-- Under section 394(6), may the court order the thing forfeited, subject to subsection (7)
#ASSERT `Under section 394(6), may the court order the thing forfeited, subject to subsection (7)` TRUE TRUE FALSE FALSE EQUALS JUST TRUE      -- a thing that is not real property is outside subsection (7); subsection (6) lets the court order anything by means of or in relation to which the offence was committed forfeited
#ASSERT `Under section 394(6), may the court order the thing forfeited, subject to subsection (7)` TRUE TRUE TRUE FALSE EQUALS JUST FALSE      -- "Subsection (6) does not apply to real property" that was not built or significantly modified to facilitate the offence
#ASSERT `Under section 394(6), may the court order the thing forfeited, subject to subsection (7)` TRUE TRUE TRUE TRUE EQUALS JUST TRUE      -- subsection (7) excepts real property "other than" real property built or significantly modified to facilitate the offence, so subsection (6) still applies to it
#ASSERT `Under section 394(6), may the court order the thing forfeited, subject to subsection (7)` FALSE TRUE FALSE FALSE EQUALS NOTHING      -- a "may" grant whose "if" gate fails answers NOTHING (2026-11-12 three limits, (1))
-- Under section 394(7), does subsection (6) not apply to the thing
#ASSERT `Under section 394(7), does subsection (6) not apply to the thing` TRUE FALSE EQUALS JUST TRUE      -- "Subsection (6) does not apply to real property other than real property built or significantly modified for the purpose of facilitating the commission of an offence"
#ASSERT `Under section 394(7), does subsection (6) not apply to the thing` TRUE TRUE EQUALS JUST FALSE      -- the exception is "other than" real property built or modified to facilitate the offence, so subsection (6) does apply to it
#ASSERT `Under section 394(7), does subsection (6) not apply to the thing` FALSE TRUE EQUALS NOTHING      -- the exception names real property; for a thing that is not real property the subsection is silent
