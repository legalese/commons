§ `Trademarks and trade descriptions, ss 406 to 414`

-- Under section 406, do I forge a trademark
#ASSERT `Under section 406, do I forge a trademark` TRUE TRUE FALSE EQUALS JUST TRUE      -- paragraph (a): without the consent of the proprietor, makes or reproduces the trademark
#ASSERT `Under section 406, do I forge a trademark` FALSE FALSE TRUE EQUALS JUST TRUE      -- paragraph (b): falsifies a genuine trademark
#ASSERT `Under section 406, do I forge a trademark` FALSE TRUE FALSE EQUALS JUST FALSE      -- "every one forges a trademark who" does (a) or (b); with the proprietor’s consent, paragraph (a) is not met
#ASSERT `Under section 406, do I forge a trademark` FALSE FALSE FALSE EQUALS JUST FALSE      -- neither paragraph is met
