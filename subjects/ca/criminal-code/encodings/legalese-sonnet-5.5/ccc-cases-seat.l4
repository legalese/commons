#ASSERT (`Under section 445.2(2), is what I did the offence of keeping, breeding or obtaining cetaceans, and what are its class and punishments` TRUE TRUE TRUE TRUE TRUE `s 445.2(2)(b) breeds or impregnates a cetacean` FALSE (Date 15 3 2020) (Date 1 1 2020) (Date 1 9 2020) (Date 10 5 2020) FALSE FALSE FALSE FALSE FALSE FALSE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST TRUE      -- every element met
#ASSERT (`Under section 445.2(2), is what I did the offence of keeping, breeding or obtaining cetaceans, and what are its class and punishments` TRUE TRUE FALSE FALSE FALSE `s 445.2(2)(b) breeds or impregnates a cetacean` FALSE (Date 15 3 2020) (Date 1 1 2020) (Date 1 9 2020) (Date 10 5 2020) FALSE FALSE FALSE FALSE FALSE FALSE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST FALSE      -- none of paragraphs (a), (b) and (c) is met (fork F1)
#ASSERT (`Under section 445.2(2), is what I did the offence of keeping, breeding or obtaining cetaceans, and what are its class and punishments` TRUE TRUE FALSE TRUE TRUE `s 445.2(2)(b) breeds or impregnates a cetacean` FALSE (Date 15 3 2020) (Date 1 1 2020) (Date 1 9 2020) (Date 10 5 2020) FALSE FALSE FALSE FALSE FALSE TRUE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST FALSE      -- section 445.2(3.1): "Subsection (2) does not apply to a person who is conducting scientific research pursuant to a licence"
#ASSERT (`Under section 445.2(2), is what I did the offence of keeping, breeding or obtaining cetaceans, and what are its class and punishments` FALSE FALSE TRUE TRUE TRUE `s 445.2(2)(b) breeds or impregnates a cetacean` FALSE (Date 15 3 2020) (Date 1 1 2020) (Date 1 9 2020) (Date 10 5 2020) FALSE FALSE FALSE FALSE FALSE FALSE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS NOTHING      -- section 445.2(1): "cetacean includes": the text does not say this animal is not a cetacean
#ASSERT (`Under section 445.2(2), is what I did the offence of keeping, breeding or obtaining cetaceans, and what are its class and punishments` TRUE TRUE TRUE FALSE FALSE `s 445.2(2)(b) breeds or impregnates a cetacean` FALSE (Date 15 3 2020) (Date 1 1 2020) (Date 1 9 2020) (Date 10 5 2020) FALSE FALSE FALSE TRUE FALSE FALSE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST FALSE      -- section 445.2(3)(b): paragraph (2)(a) does not apply to a person who has the custody of a cetacean "for the purpose of providing it with assistance or care"
#ASSERT (`Under section 445.2(2), is what I did the offence of keeping, breeding or obtaining cetaceans, and what are its class and punishments` TRUE TRUE TRUE TRUE TRUE `s 445.2(2)(b) breeds or impregnates a cetacean` FALSE (Date 15 3 2020) (Date 1 1 2020) (Date 1 9 2020) (Date 10 5 2020) FALSE FALSE FALSE FALSE FALSE FALSE)'s `s 380 to 447.1 the class of the offence, if it is one` EQUALS JUST `an offence punishable on summary conviction`      -- the class the penalty provision gives (s 445.2(5))
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test the limbs of the answer` ((`Under section 445.2(2), is what I did the offence of keeping, breeding or obtaining cetaceans, and what are its class and punishments` TRUE TRUE TRUE TRUE TRUE `s 445.2(2)(b) breeds or impregnates a cetacean` FALSE (Date 15 3 2020) (Date 1 1 2020) (Date 1 9 2020) (Date 10 5 2020) FALSE FALSE FALSE FALSE FALSE FALSE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `no imprisonment is stated`      -- the greatest term by indictment the penalty provision gives (s 445.2(5))
#ASSERT `ccc13 test the number of limbs` (`ccc13 test the limbs of the answer` ((`Under section 445.2(2), is what I did the offence of keeping, breeding or obtaining cetaceans, and what are its class and punishments` TRUE TRUE TRUE TRUE TRUE `s 445.2(2)(b) breeds or impregnates a cetacean` FALSE (Date 15 3 2020) (Date 1 1 2020) (Date 1 9 2020) (Date 10 5 2020) FALSE FALSE FALSE FALSE FALSE FALSE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS 1      -- the penalty provision states one limb (s 445.2(5))
-- Under section 445.2(2.1), do paragraphs (2)(b) and (c) not apply in respect of the cetacean
#ASSERT `Under section 445.2(2.1), do paragraphs (2)(b) and (c) not apply in respect of the cetacean` `s 445.2(2)(b) breeds or impregnates a cetacean` TRUE (Date 15 3 2020) (Date 1 1 2020) (Date 1 9 2020) (Date 10 5 2020) EQUALS JUST TRUE      -- "If a cetacean is gestating on the day on which this subsection comes into force, paragraphs (2)(b) and (c) do not apply in respect of that cetacean for the period in which it gestates"; the act falls inside the period
#ASSERT `Under section 445.2(2.1), do paragraphs (2)(b) and (c) not apply in respect of the cetacean` `s 445.2(2)(b) breeds or impregnates a cetacean` FALSE (Date 15 3 2020) (Date 1 1 2020) (Date 1 9 2020) (Date 10 5 2020) EQUALS JUST FALSE      -- "If a cetacean is gestating on the day": an "if" gate, not met
#ASSERT `Under section 445.2(2.1), do paragraphs (2)(b) and (c) not apply in respect of the cetacean` `s 445.2(2)(b) breeds or impregnates a cetacean` TRUE (Date 15 3 2020) (Date 1 1 2020) (Date 1 9 2020) (Date 1 12 2020) EQUALS JUST FALSE      -- "for the period in which it gestates": the act is after the period (Periods ruling (a) of 2026-11-05)
#ASSERT `Under section 445.2(2.1), do paragraphs (2)(b) and (c) not apply in respect of the cetacean` `s 445.2(2)(a) owns, has the custody of or controls a cetacean that is kept in captivity` TRUE (Date 15 3 2020) (Date 1 1 2020) (Date 1 9 2020) (Date 10 5 2020) EQUALS NOTHING      -- only paragraphs (2)(b) and (c) are named; for paragraph (2)(a) the subsection is silent
-- Under section 445.2(2.2), does paragraph (2)(a) not apply to the offspring of a cetacean
#ASSERT `Under section 445.2(2.2), does paragraph (2)(a) not apply to the offspring of a cetacean` TRUE TRUE EQUALS JUST TRUE      -- "Paragraph (2)(a) does not apply to the offspring of a cetacean if that offspring was born immediately after a gestational period that included the day on which this subsection came into force"
#ASSERT `Under section 445.2(2.2), does paragraph (2)(a) not apply to the offspring of a cetacean` TRUE FALSE EQUALS JUST FALSE      -- an "if" saving whose condition is not met
#ASSERT `Under section 445.2(2.2), does paragraph (2)(a) not apply to the offspring of a cetacean` FALSE TRUE EQUALS JUST FALSE      -- this subsection gives no exception to an animal that is not the offspring of a cetacean (fork F12)
-- Under section 445.2(3), does paragraph (2)(a) not apply to the person
#ASSERT `Under section 445.2(3), does paragraph (2)(a) not apply to the person` TRUE FALSE FALSE EQUALS JUST TRUE      -- paragraph (3)(a): a cetacean kept in captivity at the coming into force and continuously since
#ASSERT `Under section 445.2(3), does paragraph (2)(a) not apply to the person` FALSE TRUE FALSE EQUALS JUST TRUE      -- paragraph (3)(b): custody for assistance, care or rehabilitation
#ASSERT `Under section 445.2(3), does paragraph (2)(a) not apply to the person` FALSE FALSE TRUE EQUALS JUST TRUE      -- paragraph (3)(c): authorized by a licence of the Lieutenant Governor in Council
#ASSERT `Under section 445.2(3), does paragraph (2)(a) not apply to the person` FALSE FALSE FALSE EQUALS JUST FALSE      -- a person in none of the three cases has no exception from this subsection (fork F12)
-- Under section 445.2(3.1), does subsection (2) not apply to the person
#ASSERT `Under section 445.2(3.1), does subsection (2) not apply to the person` TRUE EQUALS JUST TRUE      -- "Subsection (2) does not apply to a person who is conducting scientific research pursuant to a licence issued by the Lieutenant Governor in Council"
#ASSERT `Under section 445.2(3.1), does subsection (2) not apply to the person` FALSE EQUALS JUST FALSE      -- a person not conducting licensed scientific research has no exception from this subsection (fork F12)
-- Under section 445.2(4), is what I did the offence of promoting a performance by captive cetaceans, and what are its class and punishments
#ASSERT (`Under section 445.2(4), is what I did the offence of promoting a performance by captive cetaceans, and what are its class and punishments` TRUE TRUE FALSE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST TRUE      -- every element met
#ASSERT (`Under section 445.2(4), is what I did the offence of promoting a performance by captive cetaceans, and what are its class and punishments` FALSE TRUE FALSE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST FALSE      -- the first element is missing: the person promotes, arranges, conducts, assists in, receives money for or takes part in a
#ASSERT (`Under section 445.2(4), is what I did the offence of promoting a performance by captive cetaceans, and what are its class and punishments` TRUE TRUE TRUE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST FALSE      -- "unless the performance is authorized under a licence": the text closes it in its own words
#ASSERT (`Under section 445.2(4), is what I did the offence of promoting a performance by captive cetaceans, and what are its class and punishments` TRUE TRUE FALSE)'s `s 380 to 447.1 the class of the offence, if it is one` EQUALS JUST `an offence punishable on summary conviction`      -- the class the penalty provision gives (s 445.2(5))
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test the limbs of the answer` ((`Under section 445.2(4), is what I did the offence of promoting a performance by captive cetaceans, and what are its class and punishments` TRUE TRUE FALSE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `no imprisonment is stated`      -- the greatest term by indictment the penalty provision gives (s 445.2(5))
#ASSERT `ccc13 test the number of limbs` (`ccc13 test the limbs of the answer` ((`Under section 445.2(4), is what I did the offence of promoting a performance by captive cetaceans, and what are its class and punishments` TRUE TRUE FALSE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS 1      -- the penalty provision states one limb (s 445.2(5))
-- Under section 446(1), is what I did the offence of causing damage or injury to animals, and what are its class and punishments
#ASSERT (`Under section 446(1), is what I did the offence of causing damage or injury to animals, and what are its class and punishments` TRUE TRUE TRUE 5000 24 TRUE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST TRUE      -- every element met
#ASSERT (`Under section 446(1), is what I did the offence of causing damage or injury to animals, and what are its class and punishments` FALSE FALSE TRUE 5000 24 TRUE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST FALSE      -- neither paragraph (a) nor paragraph (b) is met
#ASSERT (`Under section 446(1), is what I did the offence of causing damage or injury to animals, and what are its class and punishments` FALSE TRUE FALSE 5000 24 TRUE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST FALSE      -- paragraph (b) needs the owner or custodian to abandon the animal or wilfully neglect it
#ASSERT (`Under section 446(1), is what I did the offence of causing damage or injury to animals, and what are its class and punishments` FALSE TRUE TRUE 5000 24 TRUE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST TRUE      -- paragraph (b) alone suffices: an owner who abandons the animal in distress
#ASSERT (`Under section 446(1), is what I did the offence of causing damage or injury to animals, and what are its class and punishments` TRUE TRUE TRUE 5000 24 TRUE)'s `s 380 to 447.1 the class of the offence, if it is one` EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`      -- the class the penalty provision gives (s 446(2))
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test the limbs of the answer` ((`Under section 446(1), is what I did the offence of causing damage or injury to animals, and what are its class and punishments` TRUE TRUE TRUE 5000 24 TRUE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `imprisonment for a term of` `two years`      -- the greatest term by indictment the penalty provision gives (s 446(2))
#ASSERT `ccc13 test the maximum fine on summary conviction` (`ccc13 test the limbs of the answer` ((`Under section 446(1), is what I did the offence of causing damage or injury to animals, and what are its class and punishments` TRUE TRUE TRUE 5000 24 TRUE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `a fine of` 5000      -- the summary limb is what the person gave for section 787(1)
#ASSERT `ccc13 test the maximum imprisonment on summary conviction` (`ccc13 test the limbs of the answer` ((`Under section 446(1), is what I did the offence of causing damage or injury to animals, and what are its class and punishments` TRUE TRUE TRUE 5000 24 TRUE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `imprisonment for a term of` (`Length of time` OF 0, 24, 0, TRUE)      -- the summary limb is what the person gave for section 787(1): 24 months, less a day
#ASSERT `ccc13 test the maximum imprisonment on summary conviction` (`ccc13 test the limbs of the answer` ((`Under section 446(1), is what I did the offence of causing damage or injury to animals, and what are its class and punishments` TRUE TRUE TRUE 5000 24 FALSE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `imprisonment for a term of` (`Length of time` OF 0, 24, 0, FALSE)      -- the same, when the person says the term is not "less a day"
-- Under section 446(3), is the evidence proof that the damage or injury was caused by wilful neglect
#ASSERT `Under section 446(3), is the evidence proof that the damage or injury was caused by wilful neglect` TRUE TRUE FALSE EQUALS JUST TRUE      -- "For the purposes of proceedings under paragraph (1)(a), evidence that a person failed to exercise reasonable care or supervision of an animal ... is, in the absence of any evidence to the contrary, proof that the damage or injury was caused by wilful neglect"
#ASSERT `Under section 446(3), is the evidence proof that the damage or injury was caused by wilful neglect` TRUE TRUE TRUE EQUALS JUST FALSE      -- works only "in the absence of any evidence to the contrary"
#ASSERT `Under section 446(3), is the evidence proof that the damage or injury was caused by wilful neglect` TRUE FALSE TRUE EQUALS NOTHING      -- without that evidence the subsection is silent
#ASSERT `Under section 446(3), is the evidence proof that the damage or injury was caused by wilful neglect` FALSE TRUE TRUE EQUALS JUST FALSE      -- "For the purposes of proceedings under paragraph (1)(a)": a proceeding scope read as a "where" gate (Periods ruling (b) of 2026-11-05)
-- Under section 447(1), is what I did the offence of keeping an arena for animal fighting, and what are its class and punishments
#ASSERT (`Under section 447(1), is what I did the offence of keeping an arena for animal fighting, and what are its class and punishments` TRUE TRUE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST TRUE      -- every element met
#ASSERT (`Under section 447(1), is what I did the offence of keeping an arena for animal fighting, and what are its class and punishments` FALSE FALSE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST FALSE      -- neither limb is met
#ASSERT (`Under section 447(1), is what I did the offence of keeping an arena for animal fighting, and what are its class and punishments` FALSE TRUE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST TRUE      -- "or allows such an arena to be built, made, maintained or kept on such premises" alone suffices
#ASSERT (`Under section 447(1), is what I did the offence of keeping an arena for animal fighting, and what are its class and punishments` TRUE TRUE)'s `s 380 to 447.1 the class of the offence, if it is one` EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`      -- the class the penalty provision gives (s 447(2))
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test the limbs of the answer` ((`Under section 447(1), is what I did the offence of keeping an arena for animal fighting, and what are its class and punishments` TRUE TRUE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `imprisonment for a term of` `five years`      -- the greatest term by indictment the penalty provision gives (s 447(2))
-- Under section 447.1(1)(a), may the court make an order prohibiting the accused from owning or having an animal or a bird
#ASSERT `Under section 447.1(1)(a), may the court make an order prohibiting the accused from owning or having an animal or a bird` 445 "(2)" EQUALS JUST TRUE      -- "The court may, in addition to any other sentence that it may impose under subsection 445(2), 445.1(2), 446(2) or 447(2), (a) make an order prohibiting the accused from owning"
#ASSERT `Under section 447.1(1)(a), may the court make an order prohibiting the accused from owning or having an animal or a bird` 447 "(2)" EQUALS JUST TRUE      -- subsection 447(2) is named
#ASSERT `Under section 447.1(1)(a), may the court make an order prohibiting the accused from owning or having an animal or a bird` 445 "(1)" EQUALS NOTHING      -- a sentence other than the four named is outside the grant, which has no "only"
#ASSERT `Under section 447.1(1)(a), may the court make an order prohibiting the accused from owning or having an animal or a bird` 380 "" EQUALS NOTHING      -- a sentence other than the four named is outside the grant
-- Under section 447.1(1)(a), must the prohibition be for a minimum of five years
#ASSERT `Under section 447.1(1)(a), must the prohibition be for a minimum of five years` TRUE EQUALS JUST TRUE      -- every fact the question asks is true
#ASSERT `Under section 447.1(1)(a), must the prohibition be for a minimum of five years` FALSE EQUALS JUST FALSE      -- the first fact is false: the offence is a second or subsequent offence
-- Under section 447.1(1)(b), may the court order the accused to pay the reasonable costs of taking care of the animal or bird
#ASSERT `Under section 447.1(1)(b), may the court order the accused to pay the reasonable costs of taking care of the animal or bird` 445.1 "(2)" TRUE TRUE TRUE EQUALS JUST TRUE      -- "(b) on application of the Attorney General or on its own motion, order that the accused pay to a person or an organization that has taken care of an animal ... the reasonable costs ..., if the costs are readily ascertainable"
#ASSERT `Under section 447.1(1)(b), may the court order the accused to pay the reasonable costs of taking care of the animal or bird` 445.1 "(2)" TRUE TRUE FALSE EQUALS NOTHING      -- "if the costs are readily ascertainable": a "may" grant whose "if" gate fails answers NOTHING (2026-11-12 three limits, (1); fork F7)
#ASSERT `Under section 447.1(1)(b), may the court order the accused to pay the reasonable costs of taking care of the animal or bird` 445.1 "(2)" FALSE TRUE TRUE EQUALS NOTHING      -- the order is made "on application of the Attorney General or on its own motion"; neither is given
#ASSERT `Under section 447.1(1)(b), may the court order the accused to pay the reasonable costs of taking care of the animal or bird` 380 "" TRUE TRUE TRUE EQUALS NOTHING      -- a sentence other than the four named is outside the grant
-- Under section 447.1(2), is what I did the offence of contravening an order of prohibition, and what are its class and punishments
#ASSERT (`Under section 447.1(2), is what I did the offence of contravening an order of prohibition, and what are its class and punishments` TRUE 5000 24 TRUE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST TRUE      -- every element met
#ASSERT (`Under section 447.1(2), is what I did the offence of contravening an order of prohibition, and what are its class and punishments` FALSE 5000 24 TRUE)'s `s 380 to 447.1 whether what I did is the offence` EQUALS JUST FALSE      -- the first element is missing: the person contravenes an order made under paragraph (1)(a)
#ASSERT (`Under section 447.1(2), is what I did the offence of contravening an order of prohibition, and what are its class and punishments` TRUE 5000 24 TRUE)'s `s 380 to 447.1 the class of the offence, if it is one` EQUALS JUST `an offence punishable on summary conviction`      -- the class the penalty provision gives (s 447.1(2))
#ASSERT `ccc13 test the number of limbs` (`ccc13 test the limbs of the answer` ((`Under section 447.1(2), is what I did the offence of contravening an order of prohibition, and what are its class and punishments` TRUE 5000 24 TRUE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS 1      -- the penalty provision states one limb (s 447.1(2))
#ASSERT `ccc13 test the maximum fine on summary conviction` (`ccc13 test the limbs of the answer` ((`Under section 447.1(2), is what I did the offence of contravening an order of prohibition, and what are its class and punishments` TRUE 5000 24 TRUE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `a fine of` 5000      -- the summary limb is what the person gave for section 787(1)
#ASSERT `ccc13 test the maximum imprisonment on summary conviction` (`ccc13 test the limbs of the answer` ((`Under section 447.1(2), is what I did the offence of contravening an order of prohibition, and what are its class and punishments` TRUE 5000 24 TRUE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `imprisonment for a term of` (`Length of time` OF 0, 24, 0, TRUE)      -- the summary limb is what the person gave for section 787(1): 24 months, less a day
#ASSERT `ccc13 test the maximum imprisonment on summary conviction` (`ccc13 test the limbs of the answer` ((`Under section 447.1(2), is what I did the offence of contravening an order of prohibition, and what are its class and punishments` TRUE 5000 24 FALSE)'s `s 380 to 447.1 the punishments the offence is liable to, if it is one`)) EQUALS `imprisonment for a term of` (`Length of time` OF 0, 24, 0, FALSE)      -- the same, when the person says the term is not "less a day"
-- Under section 447.1(3), do sections 740 to 741.2 apply to the order
#ASSERT `Under section 447.1(3), do sections 740 to 741.2 apply to the order` TRUE EQUALS JUST TRUE      -- "Sections 740 to 741.2 apply, with any modifications that the circumstances require, to orders made under paragraph (1)(b)"
#ASSERT `Under section 447.1(3), do sections 740 to 741.2 apply to the order` FALSE EQUALS NOTHING      -- an order under paragraph (1)(a) is not mentioned

-- ====================================================================================================
-- cases-seat questions from part ccc14 (merged by the lead on 2026-11-12; unchanged text follows)
-- ====================================================================================================
-- ccc14-cases-seat.l4 -- cases for ccc14-seat.l4: every seat question, asked with the facts a real person in the seat would state.
-- Every expected value is written from the text of the section named in the question, before the run; none is copied from the module's output.
-- Y = JUST TRUE (yes on the text's own words); N = JUST FALSE (the text says no in its own words); NA = NOTHING (not covered).

§ `PART XII -- Offences Relating to Currency`
-- A person found with a forged blank bank-note.
#ASSERT `Under section 448, is the thing counterfeit money` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- A coin washed to look like gold and meant to pass for a current gold coin.
#ASSERT `Under section 448, is the thing counterfeit money` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- None of the six: "includes" does not say no.
#ASSERT `Under section 448, is the thing counterfeit money` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `Under section 448, is the thing a counterfeit token of value` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 448, is the thing a counterfeit token of value` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 448, is the thing a counterfeit token of value` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 448, is the coin or paper money current` TRUE EQUALS JUST TRUE
#ASSERT `Under section 448, is the coin or paper money current` FALSE EQUALS JUST FALSE
#ASSERT `Under section 448, is what I did uttering` TRUE EQUALS JUST TRUE
#ASSERT `Under section 448, is what I did uttering` FALSE EQUALS NOTHING
-- The person made a counterfeit coin.
#ASSERT `Under section 449, have I committed the offence of making counterfeit money` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 449, have I committed the offence of making counterfeit money` TRUE FALSE EQUALS NOTHING
#ASSERT `Under section 449, have I committed the offence of making counterfeit money` FALSE TRUE EQUALS NOTHING
#ASSERT `Under section 449, what punishment can I be given for making counterfeit money` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 14, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
-- The person bought counterfeit money, with no lawful excuse.
#ASSERT `Under section 450, have I committed the offence of buying, having or bringing in counterfeit money` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- The person was found with it in their possession.
#ASSERT `Under section 450, have I committed the offence of buying, having or bringing in counterfeit money` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- The person had a lawful justification (for example, they were holding it for the police).
#ASSERT `Under section 450, have I committed the offence of buying, having or bringing in counterfeit money` TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `Under section 450, what punishment can I be given for buying, having or bringing in counterfeit money` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 14, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `Under section 451, have I committed the offence of having gold or silver clippings or filings` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- The person did not know where the gold came from.
#ASSERT `Under section 451, have I committed the offence of having gold or silver clippings or filings` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Under section 451, what punishment can I be given for having gold or silver clippings or filings` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 5, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
-- The person paid a shop with a counterfeit note.
#ASSERT `Under section 452, have I committed the offence of uttering counterfeit money or taking it out of Canada` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- The person took counterfeit money out of Canada.
#ASSERT `Under section 452, have I committed the offence of uttering counterfeit money or taking it out of Canada` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 452, have I committed the offence of uttering counterfeit money or taking it out of Canada` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Under section 452, what punishment can I be given for uttering counterfeit money` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 14, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
-- The person, intending to defraud, knowingly used a coin that is not current.
#ASSERT `Under section 453, have I committed the offence of uttering coin` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- The coin is current: this paragraph is not met.
#ASSERT `Under section 453, have I committed the offence of uttering coin` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING
-- A metal disc that resembles a current coin.
#ASSERT `Under section 453, have I committed the offence of uttering coin` TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 453, what punishment can I be given for uttering coin` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 2, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `Under section 454, have I committed the offence concerning slugs and tokens` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 454, have I committed the offence concerning slugs and tokens` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Under section 454, what punishment can I be given for slugs and tokens` EQUALS LIST (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `Under section 455, have I committed the offence of clipping coin or uttering clipped coin` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 455, have I committed the offence of clipping coin or uttering clipped coin` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Under section 455, what punishment can I be given for clipping or uttering clipped coin` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 14, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `Under section 456, have I committed the offence of defacing current coins` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 456, have I committed the offence of defacing current coins` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Under section 456, what punishment can I be given for defacing current coins` EQUALS LIST (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
-- A private printer prints a likeness of a current bank-note.
#ASSERT `Under section 457(3), have I committed the offence of making or circulating a likeness of a bank-note or of a government or bank obligation or security` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- RECONCILED 2026-11-12: was #ASSERT `Under section 457(3), have I committed the offence of making a likeness of a bank-note` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE; question retitled by the second seat audit (it now asks what the function answers), answer unchanged
-- A Bank of Canada employee carrying out their duties: subsection (1) does not apply.
#ASSERT `Under section 457(3), have I committed the offence of making or circulating a likeness of a bank-note or of a government or bank obligation or security` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was #ASSERT `Under section 457(3), have I committed the offence of making a likeness of a bank-note` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE; question retitled by the second seat audit (it now asks what the function answers), answer unchanged
#ASSERT `Under section 457(3), have I committed the offence of making or circulating a likeness of a bank-note or of a government or bank obligation or security` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- RECONCILED 2026-11-12: was #ASSERT `Under section 457(3), have I committed the offence of making a likeness of a bank-note` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING; question retitled by the second seat audit (it now asks what the function answers), answer unchanged
#ASSERT `Under section 457(3), what punishment can I be given for making or circulating a likeness of a bank-note or of a government or bank obligation or security` EQUALS LIST (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)   -- RECONCILED 2026-11-12: was #ASSERT `Under section 457(3), what punishment can I be given for making a likeness of a bank-note` EQUALS LIST (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`); question retitled by the second seat audit (it now asks what the function answers), answer unchanged
-- A black-and-white likeness half the length of the note.
#ASSERT `Under section 457(4), is there a defence because my printed likeness of a Canadian bank-note is a different size` TRUE 0.5 1 TRUE FALSE EQUALS JUST TRUE
-- Same size as the note: no defence.
