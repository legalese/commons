#ASSERT `Under section 490.023(2), must the court make an exemption order` FALSE EQUALS JUST FALSE   -- the court is not satisfied
#ASSERT `Under section 490.026(2), may I apply for a termination order now, the period since my sentence having elapsed` TRUE FALSE 10 (Date 1 6 2005) (Date 1 6 2010) EQUALS JUST TRUE   -- prosecuted summarily: five years
#ASSERT `Under section 490.026(2), may I apply for a termination order now, the period since my sentence having elapsed` TRUE FALSE 10 (Date 1 6 2005) (Date 31 5 2010) EQUALS NOTHING   -- a day short of five years
#ASSERT `Under section 490.026(2), may I apply for a termination order now, the period since my sentence having elapsed` FALSE TRUE 0 (Date 1 6 2005) (Date 1 6 2025) EQUALS JUST TRUE   -- life maximum: 20 years
#ASSERT `Under section 490.026(5), may I apply again for a termination order` TRUE (Date 1 3 2010) (Date 1 3 2015) FALSE FALSE FALSE EQUALS JUST TRUE   -- five years since the previous application
