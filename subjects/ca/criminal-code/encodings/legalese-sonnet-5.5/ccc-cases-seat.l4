#ASSERT `Under section 83.12(1), is what I did the offence of contravening the freezing, disclosure or audit sections` FALSE TRUE FALSE EQUALS JUST TRUE   -- contravenes section 83.1
#ASSERT `Under section 83.12(1), is what I did the offence of contravening the freezing, disclosure or audit sections` FALSE FALSE TRUE EQUALS JUST TRUE   -- contravenes section 83.11
#ASSERT `Under section 83.12(1), is what I did the offence of contravening the freezing, disclosure or audit sections` FALSE FALSE FALSE EQUALS JUST FALSE   -- contravenes none of the three sections
#ASSERT `Under section 83.12(1), what is the most I can be sentenced to` EQUALS "On indictment: imprisonment for a term of not more than 10 years ; On summary conviction: imprisonment for a term of not more than 2 years less a day; a fine of not more than $100000"   -- section 83.12(1): 10 years on indictment; on summary conviction a fine of not more than $100,000 or imprisonment of not more than two years less a day, or both
§ `Seizure, restraint and forfeiture of property (ss 83.13 to 83.17; if your property has been seized, restrained or forfeited)`

#ASSERT `Under section 83.13(6), must the judge require notice to be given to me, and may the judge hear me, before ordering the property destroyed` TRUE TRUE EQUALS JUST TRUE   -- about to order destruction, and you appear to have a valid interest: notice must be required, and the judge may hear you
#ASSERT `Under section 83.13(6), must the judge require notice to be given to me, and may the judge hear me, before ordering the property destroyed` TRUE FALSE EQUALS NOTHING   -- no valid interest appears
#ASSERT `Under section 83.13(6), must the judge require notice to be given to me, and may the judge hear me, before ordering the property destroyed` FALSE TRUE EQUALS NOTHING   -- no destruction order is about to be made
#ASSERT `Under section 83.14(3), is the Attorney General required to name me as a respondent to the forfeiture application` TRUE EQUALS JUST TRUE   -- known to own or control the property: must be named as a respondent
#ASSERT `Under section 83.14(3), is the Attorney General required to name me as a respondent to the forfeiture application` FALSE EQUALS JUST FALSE   -- "only those persons who are known": not known, not required
#ASSERT `Under section 83.14(7), am I entitled to be added as a respondent to the forfeiture application` TRUE EQUALS JUST TRUE   -- the judge has required notice to be given to you: you are entitled to be added
#ASSERT `Under section 83.14(7), am I entitled to be added as a respondent to the forfeiture application` FALSE EQUALS NOTHING   -- no notice required: the subsection says nothing
#ASSERT `Under section 83.14(8), must the judge order that my interest in the property is not affected by the forfeiture` TRUE TRUE TRUE FALSE EQUALS JUST TRUE   -- a notified person with an interest, who exercised reasonable care and is not a member of a terrorist group: the interest is not affected
#ASSERT `Under section 83.14(8), must the judge order that my interest in the property is not affected by the forfeiture` FALSE TRUE TRUE FALSE EQUALS JUST FALSE   -- not a person ordered to be given notice
#ASSERT `Under section 83.14(8), must the judge order that my interest in the property is not affected by the forfeiture` TRUE FALSE TRUE FALSE EQUALS JUST FALSE   -- no interest in the property
#ASSERT `Under section 83.14(8), must the judge order that my interest in the property is not affected by the forfeiture` TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- no reasonable care
#ASSERT `Under section 83.14(8), must the judge order that my interest in the property is not affected by the forfeiture` TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- a member of a terrorist group
#ASSERT `Under section 83.14(10), may I bring a motion to vary or set aside the forfeiture order` TRUE TRUE (Date 1 3 2026) (Date 30 4 2026) EQUALS JUST TRUE   -- the 60th day after the order: "not later than 60 days after"
#ASSERT `Under section 83.14(10), may I bring a motion to vary or set aside the forfeiture order` TRUE TRUE (Date 1 3 2026) (Date 1 5 2026) EQUALS JUST FALSE   -- the 61st day
#ASSERT `Under section 83.14(10), may I bring a motion to vary or set aside the forfeiture order` TRUE TRUE (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST TRUE   -- the day of the order
#ASSERT `Under section 83.14(10), may I bring a motion to vary or set aside the forfeiture order` FALSE TRUE (Date 1 3 2026) (Date 2 3 2026) EQUALS NOTHING   -- you claim no interest in the property
#ASSERT `Under section 83.14(10), may I bring a motion to vary or set aside the forfeiture order` TRUE FALSE (Date 1 3 2026) (Date 2 3 2026) EQUALS NOTHING   -- you did receive notice
#ASSERT `Under section 83.17(2), is my property subject to forfeiture under section 83.14(5)` TRUE FALSE EQUALS JUST TRUE   -- property of a terrorist group or used for terrorist activity, and not required for restitution or compensation
#ASSERT `Under section 83.17(2), is my property subject to forfeiture under section 83.14(5)` TRUE TRUE EQUALS JUST FALSE   -- "Property is not subject to forfeiture ... to the extent that it is required to satisfy" another provision on restitution or compensation
#ASSERT `Under section 83.17(2), is my property subject to forfeiture under section 83.14(5)` FALSE FALSE EQUALS NOTHING   -- not property referred to in 83.14(1): the subsection says nothing
#ASSERT `Under section 83.17(2), is my property subject to forfeiture under section 83.14(5)` FALSE TRUE EQUALS JUST FALSE   -- required to satisfy restitution or compensation
§ `Participating in, helping or hiding for a terrorist group (ss 83.18 to 83.23)`

#ASSERT `Under section 83.18(1), is what I did the offence of participating in or contributing to an activity of a terrorist group` TRUE TRUE `s 83.01(1) seat yes` EQUALS JUST TRUE   -- knowingly participates in an activity of a terrorist group for the purpose of enhancing its ability
#ASSERT `Under section 83.18(1), is what I did the offence of participating in or contributing to an activity of a terrorist group` TRUE TRUE `s 83.01(1) seat no` EQUALS JUST FALSE   -- the group is not a terrorist group
#ASSERT `Under section 83.18(1), is what I did the offence of participating in or contributing to an activity of a terrorist group` TRUE TRUE `s 83.01(1) seat I do not know` EQUALS NOTHING   -- whether the group is a terrorist group is not settled
#ASSERT `Under section 83.18(1), is what I did the offence of participating in or contributing to an activity of a terrorist group` FALSE TRUE `s 83.01(1) seat yes` EQUALS JUST FALSE   -- did not knowingly participate
#ASSERT `Under section 83.18(1), is what I did the offence of participating in or contributing to an activity of a terrorist group` TRUE FALSE `s 83.01(1) seat yes` EQUALS JUST FALSE   -- not for the purpose of enhancing the ability of a terrorist group
#ASSERT `Under section 83.18(2), is an offence under section 83.18(1) possible whether or not this circumstance occurred` `s 83.18(2)(a) a terrorist group actually facilitates or carries out a terrorist activity` EQUALS JUST TRUE   -- "whether or not (a) a terrorist group actually facilitates or carries out a terrorist activity"
#ASSERT `Under section 83.18(2), is an offence under section 83.18(1) possible whether or not this circumstance occurred` `s 83.18(2)(b) the participation or contribution of the accused actually enhances the ability of a terrorist group to facilitate or carry out a terrorist activity` EQUALS JUST TRUE   -- "(b) the participation or contribution ... actually enhances the ability of a terrorist group"
#ASSERT `Under section 83.18(2), is an offence under section 83.18(1) possible whether or not this circumstance occurred` `s 83.18(2)(c) the accused knows the specific nature of any terrorist activity that may be facilitated or carried out by a terrorist group` EQUALS JUST TRUE   -- "(c) the accused knows the specific nature of any terrorist activity"
#ASSERT `Under section 83.18(2), is an offence under section 83.18(1) possible whether or not this circumstance occurred` `s 83.18(2) another circumstance` EQUALS NOTHING   -- another circumstance: the subsection lists three and says nothing more
#ASSERT `Under section 83.18(3), is this conduct participating in or contributing to an activity of a terrorist group` `s 83.18(3)(a) providing, receiving or recruiting a person to receive training` `s 83.01(1) seat I do not know` EQUALS JUST TRUE   -- (a) providing, receiving or recruiting a person to receive training
#ASSERT `Under section 83.18(3), is this conduct participating in or contributing to an activity of a terrorist group` `s 83.18(3)(b) providing or offering to provide a skill or an expertise for the benefit of, at the direction of or in association with a terrorist group` `s 83.01(1) seat I do not know` EQUALS JUST TRUE   -- (b) providing a skill or expertise for a terrorist group
#ASSERT `Under section 83.18(3), is this conduct participating in or contributing to an activity of a terrorist group` `s 83.18(3)(d) entering or remaining in any country for the benefit of, at the direction of or in association with a terrorist group` `s 83.01(1) seat I do not know` EQUALS JUST TRUE   -- (d) entering or remaining in any country for a terrorist group
#ASSERT `Under section 83.18(3), is this conduct participating in or contributing to an activity of a terrorist group` `s 83.18(3)(c)(i) recruiting a person in order to facilitate or commit a terrorism offence` `s 83.01(1) seat yes` EQUALS JUST TRUE   -- (c)(i) recruiting a person in order to facilitate or commit a terrorism offence
#ASSERT `Under section 83.18(3), is this conduct participating in or contributing to an activity of a terrorist group` `s 83.18(3)(c)(i) recruiting a person in order to facilitate or commit a terrorism offence` `s 83.01(1) seat no` EQUALS JUST FALSE   -- recruiting to commit something that is not a terrorism offence
#ASSERT `Under section 83.18(3), is this conduct participating in or contributing to an activity of a terrorist group` `s 83.18(3) other conduct` `s 83.01(1) seat I do not know` EQUALS NOTHING   -- other conduct: the list is not closed
#ASSERT `Under section 83.18(4), may the court consider this factor in deciding whether I participated in or contributed to an activity of a terrorist group` `s 83.18(4)(a) the accused uses a name, word, symbol or other representation that identifies, or is associated with, the terrorist group` EQUALS JUST TRUE   -- (a) the accused uses a name, word, symbol or other representation associated with the group
