#ASSERT `Under section 82.4, have I committed the offence of using or altering nuclear material, radioactive material or a device, or of acting against a nuclear facility, to compel` `s 82.4 uses or alters nuclear material` FALSE `plutonium` 0 0 FALSE FALSE FALSE `a thing that is neither of those` `s 82.2 a device of none of those kinds` FALSE EQUALS NOTHING   -- RECONCILED 2026-11-12: was #ASSERT `Under section 82.4, have I committed the offence of using or altering nuclear material, radioactive material or a device to compel` `s 82.4 uses or alters nuclear material` FALSE `plutonium` 0 0 FALSE FALSE FALSE `a thing that is neither of those` `s 82.2 a device of none of those kinds` FALSE EQUALS NOTHING; retitled: the body also answers acts against a nuclear facility and acts that cause serious interference with its operations; answer unchanged (no intent to compel)
#ASSERT `Under section 82.4, what penalty does the section state for using or altering nuclear material, radioactive material or a device, or acting against a nuclear facility, to compel` EQUALS `Under sections 46 to 83, what the section states about the penalty` OF `an indictable offence`, `imprisonment for life`, `no imprisonment is stated`, FALSE   -- RECONCILED 2026-11-12: was #ASSERT `Under section 82.4, what penalty does the section state for using or altering nuclear material, radioactive material or a device to compel` EQUALS `Under sections 46 to 83, what the section states about the penalty` OF `an indictable offence`, `imprisonment for life`, `no imprisonment is stated`, FALSE; retitled: the penalty is for every act the section names, nuclear-facility acts included; answer unchanged
#ASSERT `Under section 82.5, have I committed an indictable offence with intent to obtain nuclear material, radioactive material or a device, or access to a nuclear facility` `an indictable offence` `s 82.5 to obtain nuclear material` `plutonium` 0 0 FALSE FALSE FALSE `a thing that is neither of those` `s 82.2 a device of none of those kinds` FALSE EQUALS JUST TRUE   -- an indictable offence, to obtain plutonium
#ASSERT `Under section 82.5, have I committed an indictable offence with intent to obtain nuclear material, radioactive material or a device, or access to a nuclear facility` `an offence that the section makes both indictable and punishable on summary conviction` `s 82.5 to obtain nuclear material` `plutonium` 0 0 FALSE FALSE FALSE `a thing that is neither of those` `s 82.2 a device of none of those kinds` FALSE EQUALS NOTHING   -- a dual-procedure offence: the text does not say (fork F14)
#ASSERT `Under section 82.5, what penalty does the section state for an indictable offence committed to obtain nuclear material, radioactive material or a device, or access to a nuclear facility` EQUALS `Under sections 46 to 83, what the section states about the penalty` OF `an indictable offence`, `imprisonment for life`, `no imprisonment is stated`, FALSE   -- RECONCILED 2026-11-12: was #ASSERT `Under section 82.5, what penalty does the section state for an indictable offence committed to obtain nuclear material, radioactive material or a device` EQUALS `Under sections 46 to 83, what the section states about the penalty` OF `an indictable offence`, `imprisonment for life`, `no imprisonment is stated`, FALSE; retitled: the penalty is for every object the section names, access to a nuclear facility included; answer unchanged
#ASSERT `Under section 82.6, have I threatened to commit an offence under any of sections 82.3 to 82.5` TRUE 82.3 EQUALS JUST TRUE
#ASSERT `Under section 82.6, have I threatened to commit an offence under any of sections 82.3 to 82.5` TRUE 82.5 EQUALS JUST TRUE
#ASSERT `Under section 82.6, have I threatened to commit an offence under any of sections 82.3 to 82.5` TRUE 82.6 EQUALS NOTHING   -- just above the range
#ASSERT `Under section 82.6, have I threatened to commit an offence under any of sections 82.3 to 82.5` FALSE 82.4 EQUALS NOTHING
#ASSERT `Under section 82.6, what penalty does the section state for a threat to commit an offence under any of sections 82.3 to 82.5` EQUALS `Under sections 46 to 83, what the section states about the penalty` OF `an indictable offence`, (`imprisonment for a term of` `fourteen years`), `no imprisonment is stated`, FALSE
#ASSERT `Under section 82.7, do sections 82.3 to 82.6 apply to the act I committed` TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- an act in accordance with the law applicable to an armed conflict
#ASSERT `Under section 82.7, do sections 82.3 to 82.6 apply to the act I committed` FALSE FALSE TRUE TRUE EQUALS JUST FALSE   -- military forces in the exercise of official duties
#ASSERT `Under section 82.7, do sections 82.3 to 82.6 apply to the act I committed` TRUE FALSE FALSE FALSE EQUALS NOTHING

§ `Cases -- Prize fights: section 83 (lines 1235-1247)`
#ASSERT `Under section 83, have I taken part in a prize fight` `s 83(1)(a) engages as a principal in a prize fight` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- engaging as a principal in a prize fight
#ASSERT `Under section 83, have I taken part in a prize fight` `s 83(1)(a) engages as a principal in a prize fight` TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- an amateur Olympic-sport contest: paragraph (a) of the definition excludes it
#ASSERT `Under section 83, have I taken part in a prize fight` `s 83(1)(c) is present at a prize fight as an aid, second, surgeon, umpire, backer or reporter` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE   -- a boxing contest under an athletic board: paragraph (d)
#ASSERT `Under section 83(1), what penalty does the section state for engaging in a prize fight` EQUALS `Under sections 46 to 83, what the section states about the penalty` OF `an offence punishable on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, TRUE

-- ====================================================================================================
-- cases-seat questions from part ccc3 (merged by the lead on 2026-11-12; unchanged text follows)
-- ====================================================================================================
-- ccc3-cases-seat.l4 -- cases for the seat layer `ccc3-seat.l4`: Criminal Code (Canada), Part II.1 Terrorism (ss 83.01 to 83.33).
-- Each case is what a person in the seat would state, and the answer the text of the Act gives. Expected values are hand-written from the text, with the reason beside each case.
-- JUST TRUE is yes, JUST FALSE is no (the text says no in its own words), NOTHING is not covered (the text is silent, or the case lies outside what the section says).
-- A case with NOTHING is a case outside the encoding; a caller must never turn it into FALSE.

§ `Part II.1 Terrorism -- the meaning of the words (s 83.01)`

#ASSERT `Under section 83.01(1), is the act or omission I am asking about a terrorist activity` `s 83.01(1) the act or omission itself` `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- a listed offence of paragraph (a) (the taking of hostages), nothing excluded
#ASSERT `Under section 83.01(1), is the act or omission I am asking about a terrorist activity` `s 83.01(1) the act or omission itself` `s 83.01(1)(a) none of the offences listed in subparagraphs (i) to (x)` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- paragraph (b): the purpose, the intention and an intentional death by violence
#ASSERT `Under section 83.01(1), is the act or omission I am asking about a terrorist activity` `s 83.01(1) a conspiracy to commit the act or omission` `s 83.01(1)(a) none of the offences listed in subparagraphs (i) to (x)` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- "includes a conspiracy ... to commit any such act or omission"
#ASSERT `Under section 83.01(1), is the act or omission I am asking about a terrorist activity` `s 83.01(1) the act or omission itself` `s 83.01(1)(a) none of the offences listed in subparagraphs (i) to (x)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- neither paragraph (a) nor (b): "terrorist activity means" is closed
#ASSERT `Under section 83.01(1), is the act or omission I am asking about a terrorist activity` `s 83.01(1) a form of conduct that is none of those` `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- a form of conduct the definition does not name
#ASSERT `Under section 83.01(1), is the act or omission I am asking about a terrorist activity` `s 83.01(1) the act or omission itself` `s 83.01(1)(a) none of the offences listed in subparagraphs (i) to (x)` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- (b)(ii)(E): the disruption resulted from advocacy, protest, dissent or stoppage of work that was not intended to result in death, harm or risk: carved out
#ASSERT `Under section 83.01(1), is the act or omission I am asking about a terrorist activity` `s 83.01(1) the act or omission itself` `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- "does not include an act ... during an armed conflict ... in accordance with ... international law"
#ASSERT `Under section 83.01(1), is the act or omission I am asking about a terrorist activity` `s 83.01(1) the act or omission itself` `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- during an armed conflict but NOT in accordance with international law: the exclusion needs both
#ASSERT `Under section 83.01(1), is the act or omission I am asking about a terrorist activity` `s 83.01(1) the act or omission itself` `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE   -- the activities of military forces in the exercise of official duties, to the extent governed by other rules of international law
#ASSERT `Under section 83.01(1), is the act or omission I am asking about a terrorist activity` `s 83.01(1) the act or omission itself` `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE   -- military activity not governed by other rules of international law: not excluded
#ASSERT `Under section 83.01(1), is the group I am asking about a terrorist group` `s 83.01(1) a group` TRUE FALSE FALSE EQUALS JUST TRUE   -- an entity one of whose purposes or activities is facilitating or carrying out any terrorist activity
#ASSERT `Under section 83.01(1), is the group I am asking about a terrorist group` `s 83.01(1) a person` FALSE TRUE FALSE EQUALS JUST TRUE   -- a listed entity is a terrorist group
#ASSERT `Under section 83.01(1), is the group I am asking about a terrorist group` `s 83.01(1) a group` FALSE FALSE FALSE EQUALS JUST FALSE   -- not listed, no such purpose, not an association: "terrorist group means" is closed
#ASSERT `Under section 83.01(1), is the group I am asking about a terrorist group` `s 83.01(1) none of those kinds of thing` TRUE FALSE FALSE EQUALS JUST FALSE   -- not an entity (not a person, group, trust, partnership, fund, unincorporated association or organization)
#ASSERT `Under section 83.01(1), is the group I am asking about a terrorist group` `s 83.01(1) none of those kinds of thing` FALSE TRUE FALSE EQUALS JUST FALSE   -- on the list but not an entity: a listed entity must be an entity
#ASSERT `Under section 83.01(1), is the group I am asking about a terrorist group` `s 83.01(1) a group` FALSE FALSE TRUE EQUALS JUST TRUE   -- an association of such entities
#ASSERT `Under section 83.01(1.1), does the expression of my political, religious or ideological thought, belief or opinion come within paragraph (b) of the definition of terrorist activity` TRUE `s 83.01(1) seat yes` EQUALS JUST TRUE   -- only an expression of thought, but it satisfies the criteria of paragraph (b): "unless it constitutes an act or omission that satisfies the criteria"
#ASSERT `Under section 83.01(1.1), does the expression of my political, religious or ideological thought, belief or opinion come within paragraph (b) of the definition of terrorist activity` TRUE `s 83.01(1) seat no` EQUALS JUST FALSE   -- only an expression of thought, and it does not satisfy the criteria: does not come within paragraph (b)
#ASSERT `Under section 83.01(1.1), does the expression of my political, religious or ideological thought, belief or opinion come within paragraph (b) of the definition of terrorist activity` TRUE `s 83.01(1) seat I do not know` EQUALS NOTHING   -- whether the criteria of paragraph (b) are satisfied is not settled
#ASSERT `Under section 83.01(1.1), does the expression of my political, religious or ideological thought, belief or opinion come within paragraph (b) of the definition of terrorist activity` FALSE `s 83.01(1) seat yes` EQUALS JUST TRUE   -- not only an expression: paragraph (b) answers
#ASSERT `Under section 83.01(1.1), does the expression of my political, religious or ideological thought, belief or opinion come within paragraph (b) of the definition of terrorist activity` FALSE `s 83.01(1) seat no` EQUALS JUST FALSE   -- not only an expression, and paragraph (b) is not satisfied
#ASSERT `Under section 83.01(1.2), does a suicide bombing come within paragraph (a) or (b) of the definition of terrorist activity` TRUE `s 83.01(1) seat yes` `s 83.01(1) seat no` EQUALS JUST TRUE   -- a suicide bombing that satisfies the criteria of paragraph (a)
#ASSERT `Under section 83.01(1.2), does a suicide bombing come within paragraph (a) or (b) of the definition of terrorist activity` TRUE `s 83.01(1) seat no` `s 83.01(1) seat yes` EQUALS JUST TRUE   -- a suicide bombing that satisfies the criteria of paragraph (b)
#ASSERT `Under section 83.01(1.2), does a suicide bombing come within paragraph (a) or (b) of the definition of terrorist activity` TRUE `s 83.01(1) seat no` `s 83.01(1) seat no` EQUALS JUST FALSE   -- a suicide bombing that satisfies neither: the "if" is not met
#ASSERT `Under section 83.01(1.2), does a suicide bombing come within paragraph (a) or (b) of the definition of terrorist activity` TRUE `s 83.01(1) seat I do not know` `s 83.01(1) seat no` EQUALS NOTHING   -- paragraph (a) not settled and (b) not satisfied
#ASSERT `Under section 83.01(1.2), does a suicide bombing come within paragraph (a) or (b) of the definition of terrorist activity` FALSE `s 83.01(1) seat yes` `s 83.01(1) seat yes` EQUALS NOTHING   -- not a suicide bombing: the subsection says nothing about it
§ `Collecting, providing and making available property (ss 83.02 and 83.03)`

#ASSERT `Under section 83.02, is what I did the offence of providing or collecting property to carry out terrorist offences` TRUE TRUE FALSE TRUE FALSE `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)` FALSE FALSE EQUALS JUST TRUE   -- provides property intending that it be used to carry out an offence referred to in (a)(i) to (ix)
#ASSERT `Under section 83.02, is what I did the offence of providing or collecting property to carry out terrorist offences` TRUE TRUE FALSE FALSE TRUE `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)` FALSE FALSE EQUALS JUST TRUE   -- "or knowing that it will be used"
#ASSERT `Under section 83.02, is what I did the offence of providing or collecting property to carry out terrorist offences` TRUE TRUE TRUE TRUE FALSE `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)` FALSE FALSE EQUALS JUST FALSE   -- with lawful justification or excuse
#ASSERT `Under section 83.02, is what I did the offence of providing or collecting property to carry out terrorist offences` TRUE FALSE FALSE TRUE FALSE `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)` FALSE FALSE EQUALS JUST FALSE   -- not wilfully
#ASSERT `Under section 83.02, is what I did the offence of providing or collecting property to carry out terrorist offences` TRUE TRUE FALSE FALSE FALSE `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)` FALSE FALSE EQUALS JUST FALSE   -- neither intending nor knowing
#ASSERT `Under section 83.02, is what I did the offence of providing or collecting property to carry out terrorist offences` TRUE TRUE FALSE TRUE FALSE `s 83.01(1)(a) none of the offences listed in subparagraphs (i) to (x)` TRUE TRUE EQUALS JUST TRUE   -- paragraph (b): another act intended to cause death or serious bodily harm to a civilian, with the intimidating purpose
#ASSERT `Under section 83.02, is what I did the offence of providing or collecting property to carry out terrorist offences` TRUE TRUE FALSE TRUE FALSE `s 83.01(1)(a) none of the offences listed in subparagraphs (i) to (x)` TRUE FALSE EQUALS JUST FALSE   -- paragraph (b) needs both the intended harm and the intimidating purpose
#ASSERT `Under section 83.02, is what I did the offence of providing or collecting property to carry out terrorist offences` TRUE TRUE FALSE TRUE FALSE `s 83.01(1)(a)(x) financing of terrorism (subsection 7(3.73); United Nations, 1999)` FALSE FALSE EQUALS JUST FALSE   -- subparagraph (a)(x), financing of terrorism, is not within "(a)(i) to (ix)"
#ASSERT `Under section 83.02, is what I did the offence of providing or collecting property to carry out terrorist offences` FALSE TRUE FALSE TRUE FALSE `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)` FALSE FALSE EQUALS JUST FALSE   -- did not provide or collect property
#ASSERT `Under section 83.03(1), is what I did the offence of providing or making available property or services for terrorist purposes` `s 83.03 collects property` TRUE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- collects property intending it be used to facilitate or carry out a terrorist activity
#ASSERT `Under section 83.03(1), is what I did the offence of providing or making available property or services for terrorist purposes` `s 83.03 provides property or financial or other related services` TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- provides services knowing they will be used to benefit a person facilitating a terrorist activity
#ASSERT `Under section 83.03(1), is what I did the offence of providing or making available property or services for terrorist purposes` `s 83.03 does none of those things` TRUE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- none of the acts the section names
#ASSERT `Under section 83.03(1), is what I did the offence of providing or making available property or services for terrorist purposes` `s 83.03 collects property` FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- not wilfully
#ASSERT `Under section 83.03(1), is what I did the offence of providing or making available property or services for terrorist purposes` `s 83.03 collects property` TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- with lawful justification or excuse
#ASSERT `Under section 83.03(1), is what I did the offence of providing or making available property or services for terrorist purposes` `s 83.03 collects property` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- neither intending nor knowing
#ASSERT `Under section 83.03(1), is what I did the offence of providing or making available property or services for terrorist purposes` `s 83.03 collects property` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- neither purpose of paragraph (a) nor (b)
#ASSERT `Under section 83.03(1), is what I did the offence of providing or making available property or services for terrorist purposes` `s 83.03 collects property` TRUE FALSE TRUE FALSE TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- subsection (4): sole purpose humanitarian assistance with reasonable efforts to minimize any benefit: "do not apply"
#ASSERT `Under section 83.03(1), is what I did the offence of providing or making available property or services for terrorist purposes` `s 83.03 collects property` TRUE FALSE TRUE FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- humanitarian purpose but no reasonable efforts: subsection (4) is not met, so the offence stands
#ASSERT `Under section 83.03(2), is what I did the offence of providing or making available property or services for use by a terrorist group` `s 83.03 collects property` TRUE FALSE TRUE `s 83.01(1) seat yes` FALSE FALSE FALSE EQUALS JUST TRUE   -- collects property knowing it will benefit a terrorist group
#ASSERT `Under section 83.03(2), is what I did the offence of providing or making available property or services for use by a terrorist group` `s 83.03 collects property` TRUE FALSE TRUE `s 83.01(1) seat no` FALSE FALSE FALSE EQUALS JUST FALSE   -- the group is not a terrorist group
#ASSERT `Under section 83.03(2), is what I did the offence of providing or making available property or services for use by a terrorist group` `s 83.03 collects property` TRUE FALSE TRUE `s 83.01(1) seat I do not know` FALSE FALSE FALSE EQUALS NOTHING   -- whether the group is a terrorist group is for section 83.01(1) and is not settled
#ASSERT `Under section 83.03(2), is what I did the offence of providing or making available property or services for use by a terrorist group` `s 83.03 collects property` TRUE FALSE TRUE `s 83.01(1) seat yes` TRUE FALSE FALSE EQUALS JUST FALSE   -- subsection (3): under and in accordance with an authorization granted under section 83.032
#ASSERT `Under section 83.03(2), is what I did the offence of providing or making available property or services for use by a terrorist group` `s 83.03 collects property` TRUE FALSE TRUE `s 83.01(1) seat yes` FALSE TRUE TRUE EQUALS JUST FALSE   -- subsection (4): humanitarian assistance
#ASSERT `Under section 83.03(2), is what I did the offence of providing or making available property or services for use by a terrorist group` `s 83.03 does none of those things` TRUE FALSE TRUE `s 83.01(1) seat yes` FALSE FALSE FALSE EQUALS JUST FALSE   -- none of the acts the section names
#ASSERT `Under section 83.03(2), is what I did the offence of providing or making available property or services for use by a terrorist group` `s 83.03 collects property` TRUE TRUE TRUE `s 83.01(1) seat yes` FALSE FALSE FALSE EQUALS JUST FALSE   -- with lawful justification or excuse
#ASSERT `Under section 83.03(2), is what I did the offence of providing or making available property or services for use by a terrorist group` `s 83.03 collects property` TRUE FALSE FALSE `s 83.01(1) seat yes` FALSE FALSE FALSE EQUALS JUST FALSE   -- does not know: subsection (2) has no "intending"
#ASSERT `Under section 83.03(3), does my authorization take me outside the offence in section 83.03(2)` TRUE EQUALS JUST TRUE   -- acting under and in accordance with an authorization
#ASSERT `Under section 83.03(3), does my authorization take me outside the offence in section 83.03(2)` FALSE EQUALS NOTHING   -- not under an authorization: the exception says nothing
#ASSERT `Under section 83.03(4), does my humanitarian assistance work take me outside the offences in sections 83.03(1) and (2)` TRUE TRUE EQUALS JUST TRUE   -- sole purpose humanitarian, with reasonable efforts to minimize any benefit to terrorist groups
#ASSERT `Under section 83.03(4), does my humanitarian assistance work take me outside the offences in sections 83.03(1) and (2)` TRUE FALSE EQUALS NOTHING   -- no reasonable efforts: the exception does not apply, and the text says nothing more
#ASSERT `Under section 83.03(4), does my humanitarian assistance work take me outside the offences in sections 83.03(1) and (2)` FALSE TRUE EQUALS NOTHING   -- not for the sole purpose of humanitarian assistance
#ASSERT `Under section 83.02, what is the most I can be sentenced to` EQUALS "On indictment: imprisonment for a term of not more than 10 years"   -- section 83.02: "liable to imprisonment for a term of not more than 10 years"
#ASSERT `Under section 83.03(1), what is the most I can be sentenced to` EQUALS "On indictment: imprisonment for a term of not more than 10 years"   -- section 83.03(1): not more than 10 years
#ASSERT `Under section 83.03(2), what is the most I can be sentenced to` EQUALS "On indictment: imprisonment for a term of not more than 10 years"   -- section 83.03(2): not more than 10 years
§ `Authorization to carry out an activity that would otherwise be an offence (ss 83.031 to 83.0392; if you have applied for, or hold, an authorization)`

#ASSERT `Under section 83.032(4), am I eligible to be granted an authorization` TRUE `s 83.01(1) seat no` EQUALS JUST TRUE   -- "if they are in Canada"
#ASSERT `Under section 83.032(4), am I eligible to be granted an authorization` FALSE `s 83.01(1) seat yes` EQUALS JUST TRUE   -- "or are a Canadian outside Canada"
#ASSERT `Under section 83.032(4), am I eligible to be granted an authorization` FALSE `s 83.01(1) seat no` EQUALS JUST FALSE   -- outside Canada and not a Canadian
#ASSERT `Under section 83.032(4), am I eligible to be granted an authorization` FALSE `s 83.01(1) seat I do not know` EQUALS NOTHING   -- whether a Canadian outside Canada is not settled
#ASSERT `Under section 83.032(1), may the Public Safety Minister authorize my activity` TRUE TRUE `s 83.01(1) seat no` TRUE TRUE `s 83.032(1)(a) providing or supporting the provision of health services` EQUALS JUST TRUE   -- on application, an eligible person, a specified area controlled by a terrorist group, an activity otherwise prohibited by 83.03(2), a listed purpose
#ASSERT `Under section 83.032(1), may the Public Safety Minister authorize my activity` TRUE TRUE `s 83.01(1) seat no` TRUE TRUE `s 83.032(1)(f) supporting operations of a federal minister or a department or agency of the Government of Canada conducted for another purpose` EQUALS JUST TRUE   -- paragraph (f), supporting federal operations, is a listed purpose
#ASSERT `Under section 83.032(1), may the Public Safety Minister authorize my activity` FALSE TRUE `s 83.01(1) seat no` TRUE TRUE `s 83.032(1)(a) providing or supporting the provision of health services` EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `#ASSERT `Under section 83.032(1), may the Public Safety Minister authorize my activity` FALSE TRUE `s 83.01(1) seat no` TRUE TRUE `s 83.032(1)(a) providing or supporting the provision of health services` EQUALS NOTHING`; no application: "On application" is a group (i) gate of a "may" function, JUST FALSE as ruling (b) of 2026-11-05 says (fork F-ccc3-11)
#ASSERT `Under section 83.032(1), may the Public Safety Minister authorize my activity` TRUE TRUE `s 83.01(1) seat no` FALSE TRUE `s 83.032(1)(a) providing or supporting the provision of health services` EQUALS NOTHING   -- the area is not controlled by a terrorist group
#ASSERT `Under section 83.032(1), may the Public Safety Minister authorize my activity` TRUE TRUE `s 83.01(1) seat no` TRUE FALSE `s 83.032(1)(a) providing or supporting the provision of health services` EQUALS NOTHING   -- the activity would not otherwise be prohibited under 83.03(2)
#ASSERT `Under section 83.032(1), may the Public Safety Minister authorize my activity` TRUE TRUE `s 83.01(1) seat no` TRUE TRUE `s 83.032(1) a purpose that is none of those` EQUALS NOTHING   -- not a purpose "from among the following"
#ASSERT `Under section 83.032(1), may the Public Safety Minister authorize my activity` TRUE FALSE `s 83.01(1) seat no` TRUE TRUE `s 83.032(1)(a) providing or supporting the provision of health services` EQUALS NOTHING   -- not an eligible person (outside Canada and not a Canadian)
#ASSERT `Under section 83.032(1), may the Public Safety Minister authorize my activity` TRUE FALSE `s 83.01(1) seat yes` TRUE TRUE `s 83.032(1)(a) providing or supporting the provision of health services` EQUALS JUST TRUE   -- outside Canada but a Canadian: eligible
#ASSERT `Under section 83.032(9), may the Public Safety Minister grant me the authorization` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- satisfied of (a) and (b), taking into account the referral, the security review and mitigation measures
#ASSERT `Under section 83.032(9), may the Public Safety Minister grant me the authorization` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING   -- (a): there is a practical way to carry out the activity without the risk
#ASSERT `Under section 83.032(9), may the Public Safety Minister grant me the authorization` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING   -- (b): the benefits do not outweigh the risk
#ASSERT `Under section 83.032(9), may the Public Safety Minister grant me the authorization` TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING   -- the referral was not taken into account
#ASSERT `Under section 83.032(9), may the Public Safety Minister grant me the authorization` TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING   -- the security review was not taken into account
#ASSERT `Under section 83.032(9), may the Public Safety Minister grant me the authorization` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING   -- mitigation measures and conditions were not taken into account
#ASSERT `Under section 83.032(13), does my authorization apply to me` TRUE TRUE EQUALS JUST TRUE   -- the person to whom it is granted, who is also involved in a specified activity in accordance with it
#ASSERT `Under section 83.032(13), does my authorization apply to me` FALSE TRUE EQUALS JUST TRUE   -- "not only to the person to whom it is granted but also to any other person involved ... in carrying out a specified activity in accordance with the authorization": another person who is involved
#ASSERT `Under section 83.032(13), does my authorization apply to me` TRUE FALSE EQUALS JUST TRUE   -- the person to whom it is granted
#ASSERT `Under section 83.032(13), does my authorization apply to me` FALSE FALSE EQUALS NOTHING   -- neither the person it is granted to nor involved in a specified activity under it
#ASSERT `Under section 83.032(14), is my authorization valid on a given day` (Date 1 1 2026) 2 0 0 FALSE (Date 31 12 2027) EQUALS JUST TRUE   -- two years from 1 January 2026: the last day is 31 December 2027
#ASSERT `Under section 83.032(14), is my authorization valid on a given day` (Date 1 1 2026) 2 0 0 FALSE (Date 1 1 2028) EQUALS JUST FALSE   -- the day after the two years end
#ASSERT `Under section 83.032(14), is my authorization valid on a given day` (Date 1 1 2026) 2 0 0 FALSE (Date 31 12 2025) EQUALS JUST FALSE   -- the day before it takes effect
#ASSERT `Under section 83.032(14), is my authorization valid on a given day` (Date 1 1 2026) 2 0 0 FALSE (Date 1 1 2026) EQUALS JUST TRUE   -- the first day
#ASSERT `Under section 83.032(14), is my authorization valid on a given day` (Date 1 1 2026) 10 0 0 FALSE (Date 1 1 2027) EQUALS JUST FALSE   -- a period of more than five years is not a valid period
#ASSERT `Under section 83.033(2), am I barred from making a new application for the same activity` TRUE (Date 1 6 2026) (Date 15 6 2026) FALSE EQUALS JUST TRUE   -- a new application for the same activity within 30 days of the notice, without a material change
#ASSERT `Under section 83.033(2), am I barred from making a new application for the same activity` TRUE (Date 1 6 2026) (Date 1 7 2026) FALSE EQUALS JUST TRUE   -- the 30th day after the notice: still within 30 days
#ASSERT `Under section 83.033(2), am I barred from making a new application for the same activity` TRUE (Date 1 6 2026) (Date 2 7 2026) FALSE EQUALS JUST FALSE   -- the 31st day: more than 30 days after the notice
#ASSERT `Under section 83.033(2), am I barred from making a new application for the same activity` TRUE (Date 1 6 2026) (Date 15 6 2026) TRUE EQUALS JUST FALSE   -- "unless the Minister ... is satisfied that there has been a material change of circumstances"
#ASSERT `Under section 83.033(2), am I barred from making a new application for the same activity` FALSE (Date 1 6 2026) (Date 15 6 2026) FALSE EQUALS NOTHING   -- an application about a different activity: the bar says nothing
#ASSERT `Under section 83.035(1), may the Public Safety Minister renew my authorization` TRUE TRUE (Date 31 12 2030) (Date 31 12 2030) 5 0 0 EQUALS JUST TRUE   -- applied on the last day on which the authorization is valid, for five years (assumed reading: "before the authorization expires" includes the last day, fork F-ccc3-7)
#ASSERT `Under section 83.035(1), may the Public Safety Minister renew my authorization` TRUE TRUE (Date 1 1 2031) (Date 31 12 2030) 5 0 0 EQUALS JUST FALSE   -- applied the day after the authorization expired
#ASSERT `Under section 83.035(1), may the Public Safety Minister renew my authorization` FALSE TRUE (Date 1 1 2030) (Date 31 12 2030) 5 0 0 EQUALS JUST FALSE   -- no application for renewal
#ASSERT `Under section 83.035(1), may the Public Safety Minister renew my authorization` TRUE FALSE (Date 1 1 2030) (Date 31 12 2030) 5 0 0 EQUALS JUST FALSE   -- outside any period the regulations set out
#ASSERT `Under section 83.035(1), may the Public Safety Minister renew my authorization` TRUE TRUE (Date 1 1 2030) (Date 31 12 2030) 5 0 1 EQUALS JUST FALSE   -- renewal for more than five years
#ASSERT `Under section 83.035(1), may the Public Safety Minister renew my authorization` TRUE TRUE (Date 1 1 2030) (Date 31 12 2030) 2 0 0 EQUALS JUST TRUE   -- renewal for two years
#ASSERT `Under section 83.037, may the Public Safety Minister suspend or revoke my authorization or restrict its scope` TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- (a): a person to whom it applies fails to comply with it
#ASSERT `Under section 83.037, may the Public Safety Minister suspend or revoke my authorization or restrict its scope` TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b): the holder fails without reasonable excuse to report or give the information requested
#ASSERT `Under section 83.037, may the Public Safety Minister suspend or revoke my authorization or restrict its scope` TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- (c): the Minister is no longer satisfied that the condition in 83.032(9)(b) is met
#ASSERT `Under section 83.037, may the Public Safety Minister suspend or revoke my authorization or restrict its scope` TRUE FALSE FALSE FALSE EQUALS NOTHING   -- none of the three grounds: the power is limited by its own wording
#ASSERT `Under section 83.037, may the Public Safety Minister suspend or revoke my authorization or restrict its scope` FALSE TRUE FALSE FALSE EQUALS NOTHING   -- not an authorization granted under section 83.032
§ `Using or possessing property (s 83.04)`

#ASSERT `Under section 83.04, is what I did the offence of using or possessing property for terrorist purposes` TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a): uses property for the purpose of facilitating or carrying out a terrorist activity
#ASSERT `Under section 83.04, is what I did the offence of using or possessing property for terrorist purposes` FALSE TRUE TRUE FALSE EQUALS JUST TRUE   -- (b): possesses property intending that it be used for that purpose
#ASSERT `Under section 83.04, is what I did the offence of using or possessing property for terrorist purposes` FALSE TRUE FALSE TRUE EQUALS JUST TRUE   -- (b): possesses property knowing that it will be used for that purpose
#ASSERT `Under section 83.04, is what I did the offence of using or possessing property for terrorist purposes` FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- possesses it but neither intends nor knows
#ASSERT `Under section 83.04, is what I did the offence of using or possessing property for terrorist purposes` FALSE FALSE TRUE TRUE EQUALS JUST FALSE   -- neither uses nor possesses
#ASSERT `Under section 83.04, what is the most I can be sentenced to` EQUALS "On indictment: imprisonment for a term of not more than 10 years"   -- section 83.04: not more than 10 years
§ `The list of terrorist entities (ss 83.05 to 83.07; if your group is on, or may be put on, the list)`

#ASSERT `Under section 83.05(1), may the Governor in Council place my group on the list of entities` TRUE TRUE FALSE EQUALS JUST TRUE   -- on the Minister's recommendation, reasonable grounds to believe (a): the entity has knowingly carried out, attempted, participated in or facilitated a terrorist activity
#ASSERT `Under section 83.05(1), may the Governor in Council place my group on the list of entities` TRUE FALSE TRUE EQUALS JUST TRUE   -- reasonable grounds to believe (b): acting on behalf of, at the direction of or in association with such an entity
#ASSERT `Under section 83.05(1), may the Governor in Council place my group on the list of entities` FALSE TRUE TRUE EQUALS NOTHING   -- no recommendation of the Minister: the power is limited by its own wording
#ASSERT `Under section 83.05(1), may the Governor in Council place my group on the list of entities` TRUE FALSE FALSE EQUALS NOTHING   -- no reasonable grounds
#ASSERT `Under section 83.05(5), may I apply to a judge for judicial review of the Minister's decision` (Date 10 6 2026) (Date 10 6 2026) EQUALS JUST TRUE   -- the day the notice was received
#ASSERT `Under section 83.05(5), may I apply to a judge for judicial review of the Minister's decision` (Date 10 6 2026) (Date 9 8 2026) EQUALS JUST TRUE   -- the 60th day after receipt of the notice: "within 60 days"
#ASSERT `Under section 83.05(5), may I apply to a judge for judicial review of the Minister's decision` (Date 10 6 2026) (Date 10 8 2026) EQUALS JUST FALSE   -- the 61st day
#ASSERT `Under section 83.05(5), may I apply to a judge for judicial review of the Minister's decision` (Date 10 6 2026) (Date 9 6 2026) EQUALS JUST FALSE   -- before the notice was received
#ASSERT `Under section 83.05(8), is my listed group barred from making another application to be removed from the list` TRUE FALSE FALSE EQUALS JUST TRUE   -- a previous application, no material change, no review since: "may not make another application"
#ASSERT `Under section 83.05(8), is my listed group barred from making another application to be removed from the list` TRUE TRUE FALSE EQUALS JUST FALSE   -- a material change in its circumstances since its last application
#ASSERT `Under section 83.05(8), is my listed group barred from making another application to be removed from the list` TRUE FALSE TRUE EQUALS JUST FALSE   -- the Minister has completed a review of it since then
#ASSERT `Under section 83.05(8), is my listed group barred from making another application to be removed from the list` FALSE FALSE FALSE EQUALS NOTHING   -- no previous application: "another application" does not arise
#ASSERT `Under section 83.07(1), may my entity apply in writing to the Minister for a certificate that it is not the listed entity` TRUE TRUE TRUE EQUALS JUST TRUE   -- same or similar name, claims not to be that listed entity, in writing
#ASSERT `Under section 83.07(1), may my entity apply in writing to the Minister for a certificate that it is not the listed entity` FALSE TRUE TRUE EQUALS NOTHING   -- the name is not the same as or similar to a listed name
#ASSERT `Under section 83.07(1), may my entity apply in writing to the Minister for a certificate that it is not the listed entity` TRUE FALSE TRUE EQUALS NOTHING   -- does not claim not to be that listed entity
#ASSERT `Under section 83.07(1), may my entity apply in writing to the Minister for a certificate that it is not the listed entity` TRUE TRUE FALSE EQUALS NOTHING   -- not in writing
#ASSERT `Under section 83.07(2), must the Minister issue me a certificate` TRUE EQUALS JUST TRUE   -- satisfied that the applicant is not the listed entity: "shall issue"
#ASSERT `Under section 83.07(2), must the Minister issue me a certificate` FALSE EQUALS JUST FALSE   -- not satisfied that the applicant is not that listed entity: no duty to issue ("if he or she is satisfied")
§ `Freezing of property (ss 83.08 to 83.12)`

#ASSERT `Under section 83.08(1), am I barred from the dealing, transaction or service I describe in respect of property of a terrorist group` TRUE `s 83.01(1) seat no` `s 83.08(1)(a) deals, directly or indirectly, in property that is owned or controlled by or on behalf of a terrorist group` TRUE TRUE `s 83.01(1) seat yes` EQUALS JUST TRUE   -- a person in Canada knowingly dealing in property owned by a terrorist group
#ASSERT `Under section 83.08(1), am I barred from the dealing, transaction or service I describe in respect of property of a terrorist group` TRUE `s 83.01(1) seat no` `s 83.08(1)(b) enters into or facilitates, directly or indirectly, a transaction in respect of that property` TRUE TRUE `s 83.01(1) seat yes` EQUALS JUST TRUE   -- entering into or facilitating a transaction in respect of that property
#ASSERT `Under section 83.08(1), am I barred from the dealing, transaction or service I describe in respect of property of a terrorist group` TRUE `s 83.01(1) seat no` `s 83.08(1)(c) provides financial or other related services in respect of that property to, for the benefit of or at the direction of a terrorist group` TRUE TRUE `s 83.01(1) seat yes` EQUALS JUST TRUE   -- providing financial or related services in respect of that property
#ASSERT `Under section 83.08(1), am I barred from the dealing, transaction or service I describe in respect of property of a terrorist group` FALSE `s 83.01(1) seat yes` `s 83.08(1)(a) deals, directly or indirectly, in property that is owned or controlled by or on behalf of a terrorist group` TRUE TRUE `s 83.01(1) seat yes` EQUALS JUST TRUE   -- a Canadian outside Canada
#ASSERT `Under section 83.08(1), am I barred from the dealing, transaction or service I describe in respect of property of a terrorist group` FALSE `s 83.01(1) seat no` `s 83.08(1)(a) deals, directly or indirectly, in property that is owned or controlled by or on behalf of a terrorist group` TRUE TRUE `s 83.01(1) seat yes` EQUALS NOTHING   -- outside Canada and not a Canadian: outside the section
#ASSERT `Under section 83.08(1), am I barred from the dealing, transaction or service I describe in respect of property of a terrorist group` FALSE `s 83.01(1) seat I do not know` `s 83.08(1)(a) deals, directly or indirectly, in property that is owned or controlled by or on behalf of a terrorist group` TRUE TRUE `s 83.01(1) seat yes` EQUALS NOTHING   -- whether a Canadian outside Canada is not settled
#ASSERT `Under section 83.08(1), am I barred from the dealing, transaction or service I describe in respect of property of a terrorist group` TRUE `s 83.01(1) seat no` `s 83.08(1) does none of those things` TRUE TRUE `s 83.01(1) seat yes` EQUALS NOTHING   -- none of the acts the section names
#ASSERT `Under section 83.08(1), am I barred from the dealing, transaction or service I describe in respect of property of a terrorist group` TRUE `s 83.01(1) seat no` `s 83.08(1)(a) deals, directly or indirectly, in property that is owned or controlled by or on behalf of a terrorist group` FALSE TRUE `s 83.01(1) seat yes` EQUALS NOTHING   -- not knowingly
#ASSERT `Under section 83.08(2), am I free from civil liability for measures I took to comply with section 83.08(1)` TRUE TRUE EQUALS JUST TRUE   -- acted reasonably and took all reasonable steps to satisfy yourself that the property belonged to a terrorist group: no civil action lies
#ASSERT `Under section 83.08(2), am I free from civil liability for measures I took to comply with section 83.08(1)` FALSE TRUE EQUALS NOTHING   -- did not act reasonably: the subsection says nothing about liability
#ASSERT `Under section 83.08(2), am I free from civil liability for measures I took to comply with section 83.08(1)` TRUE FALSE EQUALS NOTHING   -- did not take all reasonable steps to satisfy yourself
#ASSERT `Under section 83.09(4), am I outside sections 83.08, 83.1 and 83.11 because another person has a ministerial authorization` TRUE TRUE TRUE EQUALS JUST TRUE   -- another person has an authorization, you are involved in the authorized activity, and its terms are met
#ASSERT `Under section 83.09(4), am I outside sections 83.08, 83.1 and 83.11 because another person has a ministerial authorization` FALSE TRUE TRUE EQUALS NOTHING   -- no authorization was obtained
#ASSERT `Under section 83.09(4), am I outside sections 83.08, 83.1 and 83.11 because another person has a ministerial authorization` TRUE FALSE TRUE EQUALS NOTHING   -- you are not involved in the authorized activity
#ASSERT `Under section 83.09(4), am I outside sections 83.08, 83.1 and 83.11 because another person has a ministerial authorization` TRUE TRUE FALSE EQUALS NOTHING   -- the terms or conditions of the authorization are not met
