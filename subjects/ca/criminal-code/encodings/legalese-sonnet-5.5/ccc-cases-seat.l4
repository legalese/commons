-- Under section 425.1(1), do I contravene subsection (1)
#ASSERT `Under section 425.1(1), do I contravene subsection (1)` TRUE TRUE TRUE TRUE EQUALS JUST TRUE      -- "No employer ... shall take a disciplinary measure against, demote, terminate or otherwise adversely affect the employment of such an employee ... with the intent to compel the employee to abstain from providing information"
#ASSERT `Under section 425.1(1), do I contravene subsection (1)` FALSE TRUE TRUE TRUE EQUALS NOTHING      -- the prohibition is addressed to an employer or a person acting for one; for anyone else the text is silent (Periods ruling (c) of 2026-11-05)
#ASSERT `Under section 425.1(1), do I contravene subsection (1)` TRUE FALSE TRUE TRUE EQUALS NOTHING      -- the prohibition is limited to a disciplinary measure, demotion, termination or adverse effect
#ASSERT `Under section 425.1(1), do I contravene subsection (1)` TRUE TRUE FALSE FALSE EQUALS NOTHING      -- neither paragraph (a) (intent to compel) nor paragraph (b) (intent to retaliate)
