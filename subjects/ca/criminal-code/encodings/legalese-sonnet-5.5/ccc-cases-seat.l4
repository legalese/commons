§ `Sex offender registration: a notice served on you for an earlier conviction (sections 490.02 to 490.029)`
#ASSERT `Under section 490.02, may the Attorney General or minister of justice serve me with a notice` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- paragraph (a): still subject to a sentence on the commencement day
#ASSERT `Under section 490.02, may the Attorney General or minister of justice serve me with a notice` TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- paragraph (b): Ontario registry and resident of Ontario
#ASSERT `Under section 490.02, may the Attorney General or minister of justice serve me with a notice` TRUE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- paragraph (b): Ontario registry and offence committed in Ontario
#ASSERT `Under section 490.02, may the Attorney General or minister of justice serve me with a notice` TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- subsection (2)(a): finally acquitted or pardoned: a notice shall not be served
#ASSERT `Under section 490.02, may the Attorney General or minister of justice serve me with a notice` TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE   -- subsection (2)(b): an application under 490.012(3) has been made
#ASSERT `Under section 490.02, may the Attorney General or minister of justice serve me with a notice` TRUE FALSE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- subsection (2)(c): proof of a pardon under the Ontario Act
#ASSERT `Under section 490.02, may the Attorney General or minister of justice serve me with a notice` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- neither paragraph (a) nor paragraph (b)
#ASSERT `Under section 490.02, may the Attorney General or minister of justice serve me with a notice` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- not a listed offence
#ASSERT `Under section 490.021(1), was my notice served within one year after the day the Sex Offender Information Registration Act came into force` (Date 15 12 2004) (Date 15 12 2005) EQUALS JUST TRUE   -- the last day
#ASSERT `Under section 490.021(1), was my notice served within one year after the day the Sex Offender Information Registration Act came into force` (Date 15 12 2004) (Date 16 12 2005) EQUALS JUST FALSE   -- a day late
#ASSERT `Under section 490.021, is the way my notice was served one the section allows` `s 490.021(1) personal service` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- personal service is always allowed
#ASSERT `Under section 490.021, is the way my notice was served one the section allows` `s 490.021(2) registered mail at the last known address` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- subsection (2): unlawfully at large
#ASSERT `Under section 490.021, is the way my notice was served one the section allows` `s 490.021(2) registered mail at the last known address` FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- subsection (3): not in compliance with the Ontario Act
#ASSERT `Under section 490.021, is the way my notice was served one the section allows` `s 490.021(2) registered mail at the last known address` FALSE FALSE FALSE TRUE FALSE TRUE TRUE EQUALS JUST TRUE   -- subsection (4): complied, then failed within a year
#ASSERT `Under section 490.021, is the way my notice was served one the section allows` `s 490.021(2) registered mail at the last known address` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- registered mail where none of subsections (2) to (4) gives it: the notice shall be personally served
#ASSERT `Under section 490.021, is the way my notice was served one the section allows` `s 490.021(1) another manner of service` TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- any other manner
#ASSERT `Under section 490.022(1), on what day does my obligation to comply with the Sex Offender Information Registration Act begin` (Date 1 6 2006) FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) EQUALS Date 1 6 2007   -- one year after service
#ASSERT `Under section 490.022(1), on what day does my obligation to comply with the Sex Offender Information Registration Act begin` (Date 1 6 2006) TRUE (Date 1 9 2007) FALSE (Date 1 1 2000) EQUALS Date 1 9 2007   -- refusal after the year: the later
#ASSERT `Under section 490.022(1), on what day does my obligation to comply with the Sex Offender Information Registration Act begin` (Date 1 6 2006) FALSE (Date 1 1 2000) TRUE (Date 5 3 2008) EQUALS Date 5 3 2008   -- an exemption order quashed
#ASSERT `Under section 490.022, when does my obligation end, or does it apply for life` FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE FALSE 5 (Date 1 6 2005) FALSE FALSE EQUALS JUST (`s 490.022(3) ends on` (Date 1 6 2015))   -- five-year maximum: ends 10 years after sentence
#ASSERT `Under section 490.022, when does my obligation end, or does it apply for life` FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE FALSE 10 (Date 1 6 2005) FALSE FALSE EQUALS JUST (`s 490.022(3) ends on` (Date 1 6 2025))   -- ten-year maximum: ends 20 years after sentence
#ASSERT `Under section 490.022, when does my obligation end, or does it apply for life` FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE TRUE 0 (Date 1 6 2005) FALSE FALSE EQUALS JUST `s 490.022(3) applies for life`   -- life maximum
#ASSERT `Under section 490.022, when does my obligation end, or does it apply for life` FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) TRUE (Date 1 3 2010) FALSE FALSE 10 (Date 1 6 2005) FALSE FALSE EQUALS JUST (`s 490.022(3) ends on` (Date 1 3 2010))   -- proof of a pardon comes before the 20 years end
#ASSERT `Under section 490.022, when does my obligation end, or does it apply for life` FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE FALSE 5 (Date 1 6 2005) TRUE TRUE EQUALS JUST `s 490.022(3) applies for life`   -- paragraph (d): several offences, more than one listed in the notice
#ASSERT `Under section 490.023(1), may I apply for an exemption order` FALSE (Date 1 3 2006) (Date 1 3 2007) EQUALS JUST TRUE   -- not subject to a 490.012 order, within the year
