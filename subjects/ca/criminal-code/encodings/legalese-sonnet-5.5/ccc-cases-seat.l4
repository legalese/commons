#ASSERT `Under section 462.3(1), is the property proceeds of crime` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 462.3(1), is the property proceeds of crime` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 462.3(1), is the property proceeds of crime` FALSE TRUE TRUE EQUALS JUST FALSE
-- Moving money abroad to hide drug proceeds.
#ASSERT `Under section 462.31(1), have I committed the offence of laundering proceeds of crime` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 462.31(1), have I committed the offence of laundering proceeds of crime` TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- No intent to conceal or convert.
#ASSERT `Under section 462.31(1), have I committed the offence of laundering proceeds of crime` TRUE FALSE TRUE TRUE FALSE EQUALS NOTHING
