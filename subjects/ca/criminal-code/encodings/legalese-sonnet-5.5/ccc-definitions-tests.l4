#ASSERT `s 2.1 the term has the meaning it has in subsection 84(1)` `imitation firearm` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2.1 the term has the meaning it has in subsection 84(1)` `prohibited ammunition` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2.1 the term has the meaning it has in subsection 84(1)` `prohibited device` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2.1 the term has the meaning it has in subsection 84(1)` `prohibited firearm` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2.1 the term has the meaning it has in subsection 84(1)` `prohibited weapon` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2.1 the term has the meaning it has in subsection 84(1)` `replica firearm` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2.1 the term has the meaning it has in subsection 84(1)` `restricted firearm` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2.1 the term has the meaning it has in subsection 84(1)` `restricted weapon` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2.1 the term has the meaning it has in subsection 84(1)` `restricted weapon` NOTHING EQUALS NOTHING
#ASSERT `s 2.1 the term has the meaning it has in subsection 84(1)` `authorization, when used in relation to those words and expressions` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2.1 the term has the meaning it has in subsection 84(1)` `licence, when used in relation to those words and expressions` (JUST TRUE) EQUALS JUST TRUE
