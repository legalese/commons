#ASSERT `s 2 cattle` `neat cattle` EQUALS JUST TRUE
#ASSERT `s 2 cattle` `an animal of the bovine species by whatever technical or familiar name it is known` EQUALS JUST TRUE
#ASSERT `s 2 cattle` `a horse` EQUALS JUST TRUE
#ASSERT `s 2 cattle` `a mule` EQUALS JUST TRUE
#ASSERT `s 2 cattle` `an ass` EQUALS JUST TRUE
#ASSERT `s 2 cattle` `a pig` EQUALS JUST TRUE
#ASSERT `s 2 cattle` `a sheep` EQUALS JUST TRUE
#ASSERT `s 2 cattle` `a goat` EQUALS JUST TRUE
#ASSERT `s 2 cattle` `an animal that is none of those named in the definition of cattle` EQUALS JUST FALSE

