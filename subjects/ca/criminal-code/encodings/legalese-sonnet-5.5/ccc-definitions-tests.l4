#ASSERT `s 2 unfit to stand trial` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2 unfit to stand trial` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2 unfit to stand trial` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- United Nations operation: established under the Charter, conducted under UN authority and control, and (peace and security purpose or a declared exceptional risk); not a Chapter VII combat enforcement action.
--   columns: established | under UN authority and control | peace-and-security purpose | declared exceptional risk | Chapter VII enforcement action with combatants
#ASSERT `s 2 United Nations operation` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2 United Nations operation` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2 United Nations operation` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2 United Nations operation` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2 United Nations operation` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2 United Nations operation` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2 United Nations operation` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE

-- United Nations personnel means (a) or (b); (b) only when present in an official capacity in the area of the operation.
#ASSERT `s 2 United Nations personnel` `a person engaged or deployed by the Secretary-General of the United Nations as a member of the military, police or civilian components of a United Nations operation` EQUALS JUST TRUE
#ASSERT `s 2 United Nations personnel` `an official or expert on mission of the United Nations or one of its specialized agencies or the International Atomic Energy Agency who is present in an official capacity in the area where a United Nations operation is conducted` EQUALS JUST TRUE
#ASSERT `s 2 United Nations personnel` `an official or expert on mission of the United Nations or one of its specialized agencies or the International Atomic Energy Agency who is not present in an official capacity in the area where a United Nations operation is conducted` EQUALS JUST FALSE
#ASSERT `s 2 United Nations personnel` `a person who is none of those` EQUALS JUST FALSE

-- valuable mineral means a mineral of a value of at least $100 per kilogram, and includes precious metals, diamonds, gemstones and rock or ore containing them (at any value).
--   columns: the kind | dollars per kilogram
#ASSERT `s 2 valuable mineral` `a mineral` 100 EQUALS JUST TRUE
#ASSERT `s 2 valuable mineral` `a mineral` 250 EQUALS JUST TRUE
#ASSERT `s 2 valuable mineral` `a mineral` 99.99 EQUALS JUST FALSE
#ASSERT `s 2 valuable mineral` `a precious metal` 1 EQUALS JUST TRUE
#ASSERT `s 2 valuable mineral` `a diamond or other gemstone` 1 EQUALS JUST TRUE
#ASSERT `s 2 valuable mineral` `a rock or ore that contains those minerals` 1 EQUALS JUST TRUE
#ASSERT `s 2 valuable mineral` `a thing that is none of those` 500 EQUALS JUST FALSE

-- valuable security includes (a) to (e).
