IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc-definitions`

-- ccc-definitions-tests.l4 -- tests for ccc-definitions.l4 (section 2, section 2.1).
-- Every expected value is written by hand from the text of the definition (quoted in ccc-definitions.l4), before the
-- run, never copied from the encoding's output. A failing assertion is a finding. Each term is tested on every branch
-- of its function: each member the text names, a case the text does not name, and each threshold on both sides.
-- JUST TRUE = within the term; JUST FALSE = the text says no; NOTHING = not covered.

§ `Tests for section 2`

-- Act includes (a) to (d): each named kind is within the term; any other kind is not covered (includes).
#ASSERT `s 2 Act` `an Act of Parliament` EQUALS JUST TRUE
#ASSERT `s 2 Act` `an Act of the legislature of the former Province of Canada` EQUALS JUST TRUE
#ASSERT `s 2 Act` `an Act of the legislature of a province` EQUALS JUST TRUE
#ASSERT `s 2 Act` `an Act or ordinance of the legislature of a province, territory or place in force at the time that province, territory or place became a province of Canada` EQUALS JUST TRUE
#ASSERT `s 2 Act` `another kind of enactment, not named in the definition of Act` EQUALS NOTHING

-- appearance notice means a notice in Form 9 issued by a peace officer.
#ASSERT `s 2 appearance notice` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2 appearance notice` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2 appearance notice` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2 appearance notice` TRUE NOTHING EQUALS NOTHING

-- associated personnel means persons who are (a), (b) or (c) ... to carry out activities in support of the mandate of a UN operation.
#ASSERT `s 2 associated personnel` `assigned by a government or an intergovernmental organization with the agreement of the competent organ of the United Nations` TRUE EQUALS JUST TRUE
#ASSERT `s 2 associated personnel` `engaged by the Secretary-General of the United Nations, by a specialized agency of the United Nations or by the International Atomic Energy Agency` TRUE EQUALS JUST TRUE
#ASSERT `s 2 associated personnel` `deployed by a humanitarian non-governmental organization or agency under an agreement with the Secretary-General of the United Nations, by a specialized agency of the United Nations or by the International Atomic Energy Agency` TRUE EQUALS JUST TRUE
#ASSERT `s 2 associated personnel` `appointed in none of the ways (a), (b) or (c) of the definition of associated personnel` TRUE EQUALS JUST FALSE
#ASSERT `s 2 associated personnel` `assigned by a government or an intergovernmental organization with the agreement of the competent organ of the United Nations` FALSE EQUALS JUST FALSE

-- Attorney General: the list of persons who are the Attorney General in the proceedings.
--   columns of the facts: (a) this Act applies, taken in a province | referred to in 2.3(1) | (b)(i) territories | (b)(ii) federal instance | (c) Canada Elections Act
`a prosecution under the Code in a province` MEANS `s 2 Attorney General: facts of the proceedings` OF TRUE, FALSE, FALSE, FALSE, FALSE
`a prosecution under the Code in a province, referred to in 2.3(1)` MEANS `s 2 Attorney General: facts of the proceedings` OF TRUE, TRUE, FALSE, FALSE, FALSE
`a prosecution in a territory under the Code` MEANS `s 2 Attorney General: facts of the proceedings` OF FALSE, FALSE, TRUE, FALSE, FALSE
`a prosecution under the Code in a territory, as para (a) and para (b)(i) both say` MEANS `s 2 Attorney General: facts of the proceedings` OF TRUE, FALSE, TRUE, FALSE, FALSE
`a federal-instance prosecution under another Act of Parliament` MEANS `s 2 Attorney General: facts of the proceedings` OF FALSE, FALSE, FALSE, TRUE, FALSE
`a prosecution under the Canada Elections Act` MEANS `s 2 Attorney General: facts of the proceedings` OF FALSE, FALSE, FALSE, FALSE, TRUE
`proceedings none of the three paragraphs speaks to` MEANS `s 2 Attorney General: facts of the proceedings` OF FALSE, TRUE, FALSE, FALSE, FALSE
#ASSERT `s 2 Attorney General` `a prosecution under the Code in a province` EQUALS JUST (LIST `the Attorney General or Solicitor General of the province`)
#ASSERT `s 2 Attorney General` `a prosecution under the Code in a province, referred to in 2.3(1)` EQUALS JUST (LIST `the Attorney General or Solicitor General of the province`, `the Attorney General of Canada`)
#ASSERT `s 2 Attorney General` `a prosecution in a territory under the Code` EQUALS JUST (LIST `the Attorney General of Canada`)
#ASSERT `s 2 Attorney General` `a prosecution under the Code in a territory, as para (a) and para (b)(i) both say` EQUALS JUST (LIST `the Attorney General or Solicitor General of the province`, `the Attorney General of Canada`)
#ASSERT `s 2 Attorney General` `a federal-instance prosecution under another Act of Parliament` EQUALS JUST (LIST `the Attorney General of Canada`)
#ASSERT `s 2 Attorney General` `a prosecution under the Canada Elections Act` EQUALS JUST (LIST `the Director of Public Prosecutions`)
#ASSERT `s 2 Attorney General` `proceedings none of the three paragraphs speaks to` EQUALS NOTHING

-- audioconference means any means of telecommunication that allows the judge or justice and any individual to communicate orally in a proceeding.
#ASSERT `s 2 audioconference` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2 audioconference` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2 audioconference` FALSE TRUE EQUALS JUST FALSE

-- bank-note includes a negotiable instrument issued by a banker AND under lawful authority AND intended as money, and bank bills and bank post bills.
--   columns: negotiable instrument | (a) issued by a banker | (b) issued under lawful authority | intended as money | bank bill | bank post bill
`a banker's instrument issued under lawful authority and intended as money` MEANS `s 2 bank-note: facts of the instrument` OF TRUE, TRUE, TRUE, TRUE, FALSE, FALSE
`a negotiable instrument not issued under lawful authority` MEANS `s 2 bank-note: facts of the instrument` OF TRUE, TRUE, FALSE, TRUE, FALSE, FALSE
`a negotiable instrument not intended as money` MEANS `s 2 bank-note: facts of the instrument` OF TRUE, TRUE, TRUE, FALSE, FALSE, FALSE
`a bank bill` MEANS `s 2 bank-note: facts of the instrument` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
`a bank post bill` MEANS `s 2 bank-note: facts of the instrument` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
`a thing that is none of those` MEANS `s 2 bank-note: facts of the instrument` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
#ASSERT `s 2 bank-note` `a banker's instrument issued under lawful authority and intended as money` EQUALS JUST TRUE
#ASSERT `s 2 bank-note` `a negotiable instrument not issued under lawful authority` EQUALS NOTHING
#ASSERT `s 2 bank-note` `a negotiable instrument not intended as money` EQUALS NOTHING
#ASSERT `s 2 bank-note` `a bank bill` EQUALS JUST TRUE
#ASSERT `s 2 bank-note` `a bank post bill` EQUALS JUST TRUE
#ASSERT `s 2 bank-note` `a thing that is none of those` EQUALS NOTHING

-- bodily harm means any hurt or injury to a person that interferes with the health or comfort of the person and is more than merely transient or trifling.
#ASSERT `s 2 bodily harm` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2 bodily harm` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2 bodily harm` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2 bodily harm` FALSE TRUE TRUE EQUALS JUST FALSE

-- Canadian Forces means the armed forces of Her Majesty raised by Canada.
#ASSERT `s 2 Canadian Forces` TRUE EQUALS JUST TRUE
#ASSERT `s 2 Canadian Forces` FALSE EQUALS JUST FALSE

