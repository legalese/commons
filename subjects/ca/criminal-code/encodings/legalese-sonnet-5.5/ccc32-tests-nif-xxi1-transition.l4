IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc32-nif-xxi1-transition`

-- ccc32-tests-nif-xxi1-transition.l4 -- tests for ccc32-nif-xxi1-transition.l4 (2024 c. 33 ss 7 to 13; NOT IN FORCE).
-- Every expected value is decided by reading the provision, and written beside the assertion. A failing assertion is a finding.
-- Section 3 is taken to come into force on 1 March 2027 (a made-up day; the real one is not in the sources). The Minister's time limit ends on 30 June 2027 (made up).

§ `Section 7 -- definitions`
#ASSERT `2024 c 33 s 7 the definitions apply in the section` 7 EQUALS JUST TRUE
#ASSERT `2024 c 33 s 7 the definitions apply in the section` 8 EQUALS JUST TRUE
#ASSERT `2024 c 33 s 7 the definitions apply in the section` 13 EQUALS JUST TRUE
#ASSERT `2024 c 33 s 7 the definitions apply in the section` 6 EQUALS NOTHING
#ASSERT `2024 c 33 s 7 the definitions apply in the section` 14 EQUALS NOTHING
#ASSERT `2024 c 33 s 7 "applicant"` TRUE EQUALS JUST TRUE
#ASSERT `2024 c 33 s 7 "applicant"` FALSE EQUALS JUST FALSE
#ASSERT `2024 c 33 s 7 "commencement day"` (Date 1 3 2027) EQUALS Date 1 3 2027
#ASSERT `2024 c 33 s 7 "Commission"` TRUE EQUALS JUST TRUE
#ASSERT `2024 c 33 s 7 "Commission"` FALSE EQUALS JUST FALSE
#ASSERT `2024 c 33 s 7 "Minister"` TRUE EQUALS JUST TRUE
#ASSERT `2024 c 33 s 7 "Minister"` FALSE EQUALS JUST FALSE
-- new scheme: Part XXI.1 as it reads ON OR AFTER the commencement day (1 March 2027).
#ASSERT `2024 c 33 s 7 "new scheme"` TRUE (Date 1 3 2027) (Date 1 3 2027) EQUALS JUST TRUE
#ASSERT `2024 c 33 s 7 "new scheme"` TRUE (Date 2 3 2027) (Date 1 3 2027) EQUALS JUST TRUE
#ASSERT `2024 c 33 s 7 "new scheme"` TRUE (Date 28 2 2027) (Date 1 3 2027) EQUALS JUST FALSE
#ASSERT `2024 c 33 s 7 "new scheme"` FALSE (Date 1 3 2027) (Date 1 3 2027) EQUALS JUST FALSE
-- old scheme: the Code's Part XXI.1 and the Regulations as they read immediately before the commencement day (read as of 28 February 2027).
#ASSERT `2024 c 33 s 7 "old scheme"` `2024 c 33 s 7 Part XXI.1 of the Criminal Code` (Date 28 2 2027) (Date 1 3 2027) EQUALS JUST TRUE
#ASSERT `2024 c 33 s 7 "old scheme"` `2024 c 33 s 7 the Regulations Respecting Applications for Ministerial Review — Miscarriages of Justice` (Date 28 2 2027) (Date 1 3 2027) EQUALS JUST TRUE
#ASSERT `2024 c 33 s 7 "old scheme"` `2024 c 33 s 7 Part XXI.1 of the Criminal Code` (Date 1 3 2027) (Date 1 3 2027) EQUALS JUST FALSE
#ASSERT `2024 c 33 s 7 "old scheme"` `2024 c 33 s 7 Part XXI.1 of the Criminal Code` (Date 27 2 2027) (Date 1 3 2027) EQUALS JUST FALSE
#ASSERT `2024 c 33 s 7 "old scheme"` `2024 c 33 s 7 another text` (Date 28 2 2027) (Date 1 3 2027) EQUALS JUST FALSE

§ `Sections 8 to 13`
#TRACE `2024 c 33 s 8 the Minister must ask the applicant whether they consent to the transfer` AT 0 WITH
    PARTY `the Minister of Justice` DOES `2024 c 33 s 8 ask the applicant whether they consent to having the application transferred to the Commission to be dealt with in accordance with the new scheme` AT 1

#ASSERT `2024 c 33 s 8 the Minister owes the duty to ask the applicant whether they consent to the transfer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `2024 c 33 s 8 the Minister owes the duty to ask the applicant whether they consent to the transfer` FALSE TRUE EQUALS JUST FALSE
#ASSERT `2024 c 33 s 8 the Minister owes the duty to ask the applicant whether they consent to the transfer` TRUE FALSE EQUALS JUST FALSE
-- 9: written consent given within the time limit (30 June 2027 is the last day): deemed made to the Commission, and the Minister may disclose.
#ASSERT `2024 c 33 s 9 the application is deemed to have been made to the Commission under the new scheme` TRUE (Date 30 6 2027) (Date 30 6 2027) EQUALS JUST TRUE
#ASSERT `2024 c 33 s 9 the application is deemed to have been made to the Commission under the new scheme` TRUE (Date 1 6 2027) (Date 30 6 2027) EQUALS JUST TRUE
#ASSERT `2024 c 33 s 9 the application is deemed to have been made to the Commission under the new scheme` TRUE (Date 1 7 2027) (Date 30 6 2027) EQUALS JUST FALSE
#ASSERT `2024 c 33 s 9 the application is deemed to have been made to the Commission under the new scheme` FALSE (Date 1 6 2027) (Date 30 6 2027) EQUALS JUST FALSE
#ASSERT `2024 c 33 s 9 the Minister is authorized to disclose to the Commission all information pertaining to the application that is under the Minister’s control` TRUE (Date 30 6 2027) (Date 30 6 2027) EQUALS JUST TRUE
#ASSERT `2024 c 33 s 9 the Minister is authorized to disclose to the Commission all information pertaining to the application that is under the Minister’s control` TRUE (Date 1 6 2027) (Date 30 6 2027) EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `2024 c 33 s 9 the Minister is authorized to disclose to the Commission all information pertaining to the application that is under the Minister’s control` TRUE (Date 1 7 2027) (Date 30 6 2027) EQUALS JUST FALSE; the function is named for a power and its failed "if" gate is the text's limit on the grant, not the text's no, so the answer is NOTHING (name-test sweep, fork F21)
#ASSERT `2024 c 33 s 9 the Minister is authorized to disclose to the Commission all information pertaining to the application that is under the Minister’s control` TRUE (Date 1 7 2027) (Date 30 6 2027) EQUALS NOTHING
-- RECONCILED 2026-11-12: was #ASSERT `2024 c 33 s 9 the Minister is authorized to disclose to the Commission all information pertaining to the application that is under the Minister’s control` FALSE (Date 1 6 2027) (Date 30 6 2027) EQUALS JUST FALSE; the function is named for a power and its failed "if" gate is the text's limit on the grant, not the text's no, so the answer is NOTHING (name-test sweep, fork F21)
#ASSERT `2024 c 33 s 9 the Minister is authorized to disclose to the Commission all information pertaining to the application that is under the Minister’s control` FALSE (Date 1 6 2027) (Date 30 6 2027) EQUALS NOTHING
#ASSERT `2024 c 33 s 10(1) subsection (2) or (3) applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `2024 c 33 s 10(1) subsection (2) or (3) applies` FALSE TRUE EQUALS JUST TRUE
#ASSERT `2024 c 33 s 10(1) subsection (2) or (3) applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `2024 c 33 s 10(1) subsection (2) or (3) applies` FALSE FALSE EQUALS JUST FALSE
#ASSERT `2024 c 33 s 10(2) the old scheme continues to apply in respect of the application` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `2024 c 33 s 10(2) the old scheme continues to apply in respect of the application` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `2024 c 33 s 10(2) the old scheme continues to apply in respect of the application` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `2024 c 33 s 10(2) the old scheme continues to apply in respect of the application` NOTHING TRUE EQUALS NOTHING
#ASSERT `2024 c 33 s 10(3) the application is deemed not to have been made` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `2024 c 33 s 10(3) the application is deemed not to have been made` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `2024 c 33 s 10(3) the application is deemed not to have been made` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `2024 c 33 s 10(3) the applicant may apply to the Commission under the new scheme` (JUST TRUE) TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `2024 c 33 s 10(3) the applicant may apply to the Commission under the new scheme` (JUST TRUE) FALSE EQUALS JUST FALSE; the function is named for a power and its failed "if" gate is the text's limit on the grant, not the text's no, so the answer is NOTHING (name-test sweep, fork F23)
#ASSERT `2024 c 33 s 10(3) the applicant may apply to the Commission under the new scheme` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `2024 c 33 s 10(3) the applicant may apply to the Commission under the new scheme` (JUST FALSE) TRUE EQUALS NOTHING
-- 11: consent AFTER the time limit, the Minister completed the preliminary assessment before the commencement day, and received the consent before deciding under 10(2).
#ASSERT `2024 c 33 s 11 the application is deemed to have been made to the Commission under the new scheme` TRUE (Date 1 7 2027) (Date 30 6 2027) TRUE TRUE EQUALS JUST TRUE
#ASSERT `2024 c 33 s 11 the application is deemed to have been made to the Commission under the new scheme` TRUE (Date 30 6 2027) (Date 30 6 2027) TRUE TRUE EQUALS JUST FALSE
#ASSERT `2024 c 33 s 11 the application is deemed to have been made to the Commission under the new scheme` FALSE (Date 1 7 2027) (Date 30 6 2027) TRUE TRUE EQUALS JUST FALSE
#ASSERT `2024 c 33 s 11 the application is deemed to have been made to the Commission under the new scheme` TRUE (Date 1 7 2027) (Date 30 6 2027) FALSE TRUE EQUALS JUST FALSE
#ASSERT `2024 c 33 s 11 the application is deemed to have been made to the Commission under the new scheme` TRUE (Date 1 7 2027) (Date 30 6 2027) TRUE FALSE EQUALS JUST FALSE
#ASSERT `2024 c 33 s 11 the Minister is authorized to disclose to the Commission all information pertaining to the application that is under the Minister’s control` TRUE (Date 1 7 2027) (Date 30 6 2027) TRUE TRUE EQUALS JUST TRUE
