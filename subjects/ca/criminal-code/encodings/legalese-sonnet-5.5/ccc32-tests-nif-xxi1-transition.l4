#ASSERT `2024 c 33 s 11 the Minister is authorized to disclose to the Commission all information pertaining to the application that is under the Minister’s control` TRUE (Date 1 7 2027) (Date 30 6 2027) TRUE FALSE EQUALS NOTHING
#ASSERT `2024 c 33 s 12 the consent may be revoked` TRUE EQUALS JUST FALSE
#ASSERT `2024 c 33 s 12 the consent may be revoked` FALSE EQUALS NOTHING
#ASSERT `2024 c 33 s 13 the fact that the Minister dismissed the application under the old scheme prevents the applicant from applying under the new scheme` TRUE EQUALS JUST FALSE
#ASSERT `2024 c 33 s 13 the fact that the Minister dismissed the application under the old scheme prevents the applicant from applying under the new scheme` FALSE EQUALS NOTHING
