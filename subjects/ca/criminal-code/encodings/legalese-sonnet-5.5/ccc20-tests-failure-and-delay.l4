IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc20-part16-interpretation`
IMPORT `ccc20-part16-failure-and-delay`
IMPORT `ccc20-tests-fixtures`

-- ccc20-tests-failure-and-delay.l4 -- tests for ccc20-part16-failure-and-delay.l4 (ss 523.1 to 526). Expected values are hand-written from the text of lines 11667-11760.

§ `Tests -- section 523.1: judicial referral hearing`
-- (1)(a) args: the circumstances of (2) exist; the accused was released under 522(3) by a judge of the superior court
#ASSERT `s 523.1(1)(a) the justice must order that the accused appear before a judge of the superior court of criminal jurisdiction so that the judge may hear the matter` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 523.1(1)(a) the justice must order that the accused appear before a judge of the superior court of criminal jurisdiction so that the judge may hear the matter` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 523.1(1)(a) the justice must order that the accused appear before a judge of the superior court of criminal jurisdiction so that the judge may hear the matter` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 523.1(1)(a) the justice must order that the accused appear before a judge of the superior court of criminal jurisdiction so that the judge may hear the matter` FALSE FALSE EQUALS JUST FALSE
-- (1)(b)
#ASSERT `s 523.1(1)(b) the justice must hear the matter` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 523.1(1)(b) the justice must hear the matter` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 523.1(1)(b) the justice must hear the matter` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 523.1(1)(b) the justice must hear the matter` FALSE TRUE EQUALS JUST FALSE
-- (2)(a) args: an appearance notice has been issued for the failure; the prosecutor seeks a decision under this section
#ASSERT `s 523.1(2)(a) an appearance notice has been issued for the failure and the prosecutor seeks a decision under this section` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 523.1(2)(a) an appearance notice has been issued for the failure and the prosecutor seeks a decision under this section` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 523.1(2)(a) an appearance notice has been issued for the failure and the prosecutor seeks a decision under this section` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 523.1(2)(a) an appearance notice has been issued for the failure and the prosecutor seeks a decision under this section` FALSE FALSE EQUALS JUST FALSE
-- (2)(b) args: a charge has been laid for the contravention; the prosecutor seeks a decision
#ASSERT `s 523.1(2)(b) a charge has been laid for the contravention and the prosecutor seeks a decision under this section` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 523.1(2)(b) a charge has been laid for the contravention and the prosecutor seeks a decision under this section` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 523.1(2)(b) a charge has been laid for the contravention and the prosecutor seeks a decision under this section` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 523.1(2)(b) a charge has been laid for the contravention and the prosecutor seeks a decision under this section` FALSE FALSE EQUALS JUST FALSE
-- (2) args: the answer of (a); the answer of (b)
#ASSERT `s 523.1(2) the circumstances referred to in subsection (1) exist` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 523.1(2) the circumstances referred to in subsection (1) exist` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 523.1(2) the circumstances referred to in subsection (1) exist` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 523.1(2) the circumstances referred to in subsection (1) exist` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- (3) args: satisfied that the accused failed to comply; satisfied that the failure did not cause harm, damage or loss
#ASSERT `s 523.1(3) the judge or justice must review any conditions of release that have been imposed on the accused` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 523.1(3) the judge or justice must review any conditions of release that have been imposed on the accused` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 523.1(3) the judge or justice must review any conditions of release that have been imposed on the accused` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 523.1(3) the judge or justice must review any conditions of release that have been imposed on the accused` FALSE FALSE EQUALS JUST FALSE
-- (3)(a) take no action: a "may" whose "if" gate fails answers NOTHING
#ASSERT `s 523.1(3)(a) the judge or justice may take no action` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 523.1(3)(a) the judge or justice may take no action` TRUE FALSE EQUALS NOTHING
#ASSERT `s 523.1(3)(a) the judge or justice may take no action` FALSE TRUE EQUALS NOTHING
#ASSERT `s 523.1(3)(a) the judge or justice may take no action` FALSE FALSE EQUALS NOTHING
-- (3)(b) cancel any other summons, appearance notice, undertaking or release order
#ASSERT `s 523.1(3)(b) the judge or justice may cancel any other summons, appearance notice, undertaking or release order in respect of the accused` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 523.1(3)(b) the judge or justice may cancel any other summons, appearance notice, undertaking or release order in respect of the accused` TRUE FALSE EQUALS NOTHING
#ASSERT `s 523.1(3)(b) the judge or justice may cancel any other summons, appearance notice, undertaking or release order in respect of the accused` FALSE TRUE EQUALS NOTHING
-- (3)(b)(i) args: the two satisfactions; the judge or justice cancels any other summons, appearance notice, undertaking or release order
#ASSERT `s 523.1(3)(b)(i) the judge or justice may make a release order under section 515` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 523.1(3)(b)(i) the judge or justice may make a release order under section 515` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 523.1(3)(b)(i) the judge or justice may make a release order under section 515` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 523.1(3)(b)(i) the judge or justice may make a release order under section 515` FALSE TRUE TRUE EQUALS NOTHING
-- (3)(b)(ii) args: the two satisfactions; cancels; the prosecutor shows cause why detention is justified under 515(10)
#ASSERT `s 523.1(3)(b)(ii) the judge or justice may make an order that the accused be detained in custody until the accused is dealt with according to law` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 523.1(3)(b)(ii) the judge or justice may make an order that the accused be detained in custody until the accused is dealt with according to law` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 523.1(3)(b)(ii) the judge or justice may make an order that the accused be detained in custody until the accused is dealt with according to law` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 523.1(3)(b)(ii) the judge or justice may make an order that the accused be detained in custody until the accused is dealt with according to law` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 523.1(3)(b)(ii) the judge or justice may make an order that the accused be detained in custody until the accused is dealt with according to law` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- (3)(b)(ii) the statement of reasons: "if so detained" (arg: the order to detain is made)
#ASSERT `s 523.1(3)(b)(ii) the judge or justice must include in the record a statement of the reasons for making the order` TRUE EQUALS JUST TRUE
#ASSERT `s 523.1(3)(b)(ii) the judge or justice must include in the record a statement of the reasons for making the order` FALSE EQUALS JUST FALSE
-- (3)(c) remand for the purposes of the Identification of Criminals Act
#ASSERT `s 523.1(3)(c) the judge or justice may remand the accused to custody for the purposes of the Identification of Criminals Act` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 523.1(3)(c) the judge or justice may remand the accused to custody for the purposes of the Identification of Criminals Act` TRUE FALSE EQUALS NOTHING
#ASSERT `s 523.1(3)(c) the judge or justice may remand the accused to custody for the purposes of the Identification of Criminals Act` FALSE TRUE EQUALS NOTHING
-- (4) args: a charge has been laid for the failure referred to in (2)(a); the judge or justice makes a decision under (3)
#ASSERT `s 523.1(4) the judge or justice must dismiss the charge` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 523.1(4) the judge or justice must dismiss the charge` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 523.1(4) the judge or justice must dismiss the charge` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 523.1(4) the judge or justice must dismiss the charge` FALSE FALSE EQUALS JUST FALSE
-- (5) arg: the judge or justice makes a decision under (3): the bar
#ASSERT `s 523.1(5) the laying of an information or the preferring of an indictment against the accused for the failure referred to in paragraph (2)(a) is barred` TRUE EQUALS JUST TRUE
#ASSERT `s 523.1(5) the laying of an information or the preferring of an indictment against the accused for the failure referred to in paragraph (2)(a) is barred` FALSE EQUALS JUST FALSE

§ `Tests -- section 524: hearing on a contravention or a new offence`
-- (1)(a) and (b): as 523.1(1)
#ASSERT `s 524(1)(a) the justice must order that the accused be taken before a judge of the superior court of criminal jurisdiction so that the judge may hear the matter` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 524(1)(a) the justice must order that the accused be taken before a judge of the superior court of criminal jurisdiction so that the judge may hear the matter` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 524(1)(a) the justice must order that the accused be taken before a judge of the superior court of criminal jurisdiction so that the judge may hear the matter` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 524(1)(b) the justice must hear the matter` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 524(1)(b) the justice must hear the matter` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 524(1)(b) the justice must hear the matter` FALSE FALSE EQUALS JUST FALSE
-- (2)(a) args: arrested for the contravention or having been about to contravene; the prosecutor seeks to have it cancelled under this section
#ASSERT `s 524(2)(a) the accused has been arrested for a contravention and the prosecutor seeks to have the document cancelled under this section` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 524(2)(a) the accused has been arrested for a contravention and the prosecutor seeks to have the document cancelled under this section` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 524(2)(a) the accused has been arrested for a contravention and the prosecutor seeks to have the document cancelled under this section` FALSE TRUE EQUALS JUST FALSE
-- (2)(b) args: arrested for having committed an offence while subject to the document; the prosecutor seeks to have it cancelled
#ASSERT `s 524(2)(b) the accused has been arrested for an offence committed while subject to the document and the prosecutor seeks to have it cancelled under this section` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 524(2)(b) the accused has been arrested for an offence committed while subject to the document and the prosecutor seeks to have it cancelled under this section` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 524(2)(b) the accused has been arrested for an offence committed while subject to the document and the prosecutor seeks to have it cancelled under this section` FALSE TRUE EQUALS JUST FALSE
-- (2)
#ASSERT `s 524(2) the circumstances referred to in subsection (1) exist` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 524(2) the circumstances referred to in subsection (1) exist` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 524(2) the circumstances referred to in subsection (1) exist` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- (3) args: finds (a) contravened or about to contravene; finds (b) reasonable grounds to believe an offence was committed while subject
#ASSERT `s 524(3) the judge or justice must cancel the summons, appearance notice, undertaking or release order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 524(3) the judge or justice must cancel the summons, appearance notice, undertaking or release order` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 524(3) the judge or justice must cancel the summons, appearance notice, undertaking or release order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 524(3) the judge or justice must cancel the summons, appearance notice, undertaking or release order` FALSE FALSE EQUALS JUST FALSE
-- (4) the circumstances. args: found under (3)(a); found under (3)(b); the offence believed committed; one answer of s 515(6) or 522(2) for each outstanding charge
-- paragraph (a)
#ASSERT `s 524(4) the circumstances of paragraph (a), (b) or (c) exist` TRUE FALSE `s 493.01 fixture summary` (LIST (JUST FALSE)) EQUALS JUST TRUE
-- paragraph (b): the offence must be an indictable offence (s 493.01: a dual-procedure offence counts unless the prosecutor has elected summary conviction)
#ASSERT `s 524(4) the circumstances of paragraph (a), (b) or (c) exist` FALSE TRUE `s 493.01 fixture indictable` (LIST (JUST FALSE)) EQUALS JUST TRUE
#ASSERT `s 524(4) the circumstances of paragraph (a), (b) or (c) exist` FALSE TRUE `s 493.01 fixture hybrid` (LIST (JUST FALSE)) EQUALS JUST TRUE
#ASSERT `s 524(4) the circumstances of paragraph (a), (b) or (c) exist` FALSE TRUE `s 493.01 fixture hybrid elected` (LIST (JUST FALSE)) EQUALS JUST FALSE
#ASSERT `s 524(4) the circumstances of paragraph (a), (b) or (c) exist` FALSE TRUE `s 493.01 fixture summary` (LIST (JUST FALSE)) EQUALS JUST FALSE
-- paragraph (c): any of the outstanding charges is an offence referred to in 515(6) or 522(2)
#ASSERT `s 524(4) the circumstances of paragraph (a), (b) or (c) exist` FALSE FALSE `s 493.01 fixture indictable` (LIST (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `s 524(4) the circumstances of paragraph (a), (b) or (c) exist` FALSE FALSE `s 493.01 fixture indictable` (LIST (JUST FALSE), (JUST TRUE)) EQUALS JUST TRUE
#ASSERT `s 524(4) the circumstances of paragraph (a), (b) or (c) exist` FALSE FALSE `s 493.01 fixture indictable` (LIST (JUST FALSE), (JUST FALSE)) EQUALS JUST FALSE
#ASSERT `s 524(4) the circumstances of paragraph (a), (b) or (c) exist` FALSE FALSE `s 493.01 fixture indictable` (LIST (JUST FALSE), NOTHING) EQUALS NOTHING
#ASSERT `s 524(4) the circumstances of paragraph (a), (b) or (c) exist` FALSE FALSE `s 493.01 fixture indictable` (LIST (JUST TRUE), NOTHING) EQUALS JUST TRUE
#ASSERT `s 524(4) the circumstances of paragraph (a), (b) or (c) exist` TRUE TRUE `s 493.01 fixture indictable` (LIST NOTHING) EQUALS JUST TRUE
-- (4)(a), (b), (c) the three limbs. (a) arg: found under (3)(a). (b) args: found under (3)(b); the offence believed committed (s 493.01). (c) arg: one answer of s 515(6) or 522(2) for each outstanding charge
#ASSERT `s 524(4)(a) the judge or justice found under paragraph (3)(a) that the accused has contravened or had been about to contravene the summons, appearance notice, undertaking or release order` TRUE EQUALS JUST TRUE
#ASSERT `s 524(4)(a) the judge or justice found under paragraph (3)(a) that the accused has contravened or had been about to contravene the summons, appearance notice, undertaking or release order` FALSE EQUALS JUST FALSE
