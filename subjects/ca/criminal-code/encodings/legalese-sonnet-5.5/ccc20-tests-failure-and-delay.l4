#ASSERT `s 524(5) the judge or justice must make a release order referred to in section 515` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 524(5) the judge or justice must make a release order referred to in section 515` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 524(5) the judge or justice must make a release order referred to in section 515` FALSE FALSE EQUALS NOTHING
#ASSERT `s 524(5) the judge or justice must make a release order referred to in section 515` FALSE TRUE EQUALS NOTHING
