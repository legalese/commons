IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc27-s746-parole`

-- ccc27-tests-s746.l4 -- tests for sections 746 to 746.1. Every expected value is written from the text, beside the assertion.

§ `Tests -- section 746`

#ASSERT `s 746 the time spent in custody is included in calculating the period of imprisonment served` `s 746 section 745` `s 746(a) a sentence of imprisonment for life after July 25, 1976` EQUALS JUST TRUE
#ASSERT `s 746 the time spent in custody is included in calculating the period of imprisonment served` `s 746 section 745.1` `s 746(a) a sentence of imprisonment for life after July 25, 1976` EQUALS JUST TRUE
#ASSERT `s 746 the time spent in custody is included in calculating the period of imprisonment served` `s 746 section 745.4` `s 746(b) a sentence of death that has been or is deemed to have been commuted to a sentence of imprisonment for life` EQUALS JUST TRUE
#ASSERT `s 746 the time spent in custody is included in calculating the period of imprisonment served` `s 746 section 745.5` `s 746(a) a sentence of imprisonment for life after July 25, 1976` EQUALS JUST TRUE
#ASSERT `s 746 the time spent in custody is included in calculating the period of imprisonment served` `s 746 section 745.52` `s 746(a) a sentence of imprisonment for life after July 25, 1976` EQUALS JUST TRUE
#ASSERT `s 746 the time spent in custody is included in calculating the period of imprisonment served` `s 746 section 745.6` `s 746(b) a sentence of death that has been or is deemed to have been commuted to a sentence of imprisonment for life` EQUALS JUST TRUE
#ASSERT `s 746 the time spent in custody is included in calculating the period of imprisonment served` `s 746 another purpose` `s 746(a) a sentence of imprisonment for life after July 25, 1976` EQUALS NOTHING   -- not one of the six sections
#ASSERT `s 746 the time spent in custody is included in calculating the period of imprisonment served` `s 746 section 745` `s 746 a sentence of another kind` EQUALS NOTHING
#ASSERT `s 746(a) the sentence is a sentence of imprisonment for life after July 25, 1976` (Date 26 7 1976) EQUALS JUST TRUE
#ASSERT `s 746(a) the sentence is a sentence of imprisonment for life after July 25, 1976` (Date 25 7 1976) EQUALS NOTHING   -- "after July 25, 1976": the day itself is not after
#ASSERT `s 746(a) the sentence is a sentence of imprisonment for life after July 25, 1976` (Date 1 1 1970) EQUALS NOTHING
#ASSERT `s 746 the days spent in custody that are included` (Date 1 1 2020) (Date 11 1 2020) EQUALS JUST 10   -- the difference of the two dates (F-11)
#ASSERT `s 746 the days spent in custody that are included` (Date 1 1 2020) (Date 1 1 2021) EQUALS JUST 366   -- 2020 is a leap year
#ASSERT `s 746 the days spent in custody that are included` (Date 1 1 2020) (Date 1 1 2020) EQUALS JUST 0
#ASSERT `s 746 the days spent in custody that are included` (Date 2 1 2020) (Date 1 1 2020) EQUALS NOTHING   -- the sentence cannot come before the arrest

§ `Tests -- section 746.1`

-- (1): args: sentenced to life without eligibility for a specified number of years under this Act; Parliament has otherwise provided; the specified years have expired or been terminated
#ASSERT `s 746.1(1) the person is barred from being considered for parole or released pursuant to a grant of parole` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 746.1(1) the person is barred from being considered for parole or released pursuant to a grant of parole` TRUE TRUE FALSE EQUALS JUST FALSE   -- "Unless Parliament otherwise provides"
#ASSERT `s 746.1(1) the person is barred from being considered for parole or released pursuant to a grant of parole` TRUE FALSE TRUE EQUALS JUST FALSE   -- the "until" bar is gone after expiration or termination
#ASSERT `s 746.1(1) the person is barred from being considered for parole or released pursuant to a grant of parole` FALSE FALSE FALSE EQUALS NOTHING   -- not a sentence the section names
-- the kinds of release
#ASSERT `s 746.1 the kind of release is barred while the bar lasts` `s 746.1 day parole` FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 746.1 the kind of release is barred while the bar lasts` `s 746.1 an absence without escort` FALSE EQUALS JUST TRUE   -- (b)
#ASSERT `s 746.1 the kind of release is barred while the bar lasts` `s 746.1 an absence with escort, other than for medical reasons or to attend judicial proceedings or a coroner's inquest` FALSE EQUALS JUST TRUE   -- (c)
#ASSERT `s 746.1 the kind of release is barred while the bar lasts` `s 746.1 an absence with escort, other than for medical reasons or to attend judicial proceedings or a coroner's inquest` TRUE EQUALS JUST FALSE   -- "except with the approval of the Parole Board of Canada"
#ASSERT `s 746.1 the kind of release is barred while the bar lasts` `s 746.1 an absence with escort for medical reasons or to attend judicial proceedings or a coroner's inquest` FALSE EQUALS NOTHING   -- not caught by (c)
#ASSERT `s 746.1 the kind of release is barred while the bar lasts` `s 746.1 a release of another kind` FALSE EQUALS NOTHING
-- (2): all but three years. args: sentenced; under 18 murder; specified years; years served; kind; Board approves
#ASSERT `s 746.1(2) the kind of release is barred until the expiration of all but three years` TRUE FALSE 25 21 `s 746.1 day parole` FALSE EQUALS JUST TRUE   -- 21 of 25 years served: still three years short of "all but three"
#ASSERT `s 746.1(2) the kind of release is barred until the expiration of all but three years` TRUE FALSE 25 22 `s 746.1 day parole` FALSE EQUALS JUST FALSE   -- 22 = 25 less 3: the bar has expired
#ASSERT `s 746.1(2) the kind of release is barred until the expiration of all but three years` TRUE FALSE 25 10 `s 746.1 an absence without escort` FALSE EQUALS JUST TRUE
#ASSERT `s 746.1(2) the kind of release is barred until the expiration of all but three years` TRUE FALSE 25 10 `s 746.1 an absence with escort, other than for medical reasons or to attend judicial proceedings or a coroner's inquest` TRUE EQUALS JUST FALSE   -- approved by the Parole Board of Canada
#ASSERT `s 746.1(2) the kind of release is barred until the expiration of all but three years` TRUE FALSE 25 10 `s 746.1 an absence with escort, other than for medical reasons or to attend judicial proceedings or a coroner's inquest` FALSE EQUALS JUST TRUE
#ASSERT `s 746.1(2) the kind of release is barred until the expiration of all but three years` TRUE FALSE 25 10 `s 746.1 an absence with escort for medical reasons or to attend judicial proceedings or a coroner's inquest` FALSE EQUALS NOTHING
#ASSERT `s 746.1(2) the kind of release is barred until the expiration of all but three years` TRUE TRUE 7 3 `s 746.1 day parole` FALSE EQUALS NOTHING   -- under 18 and convicted of murder: subsection (3) decides ("Subject to subsection (3)")
#ASSERT `s 746.1(2) the kind of release is barred until the expiration of all but three years` FALSE FALSE 25 10 `s 746.1 day parole` FALSE EQUALS NOTHING   -- not a sentence the subsection names
-- (3): all but one fifth. args: convicted of first or second degree murder; under 18; sentenced; years without eligibility; years served; kind; approval
#ASSERT `s 746.1(3) the kind of release is barred until the expiration of all but one fifth of the period` TRUE TRUE TRUE 10 7 `s 746.1 day parole` FALSE EQUALS JUST TRUE   -- 7 of 10 years: four fifths is 8
#ASSERT `s 746.1(3) the kind of release is barred until the expiration of all but one fifth of the period` TRUE TRUE TRUE 10 8 `s 746.1 day parole` FALSE EQUALS JUST FALSE   -- 8 of 10 years: all but one fifth
#ASSERT `s 746.1(3) the kind of release is barred until the expiration of all but one fifth of the period` TRUE TRUE TRUE 5 3 `s 746.1 an absence without escort` FALSE EQUALS JUST TRUE   -- 3 of 5: four fifths is 4
#ASSERT `s 746.1(3) the kind of release is barred until the expiration of all but one fifth of the period` TRUE TRUE TRUE 5 4 `s 746.1 an absence without escort` FALSE EQUALS JUST FALSE
#ASSERT `s 746.1(3) the kind of release is barred until the expiration of all but one fifth of the period` TRUE TRUE TRUE 10 1 `s 746.1 an absence with escort, other than for medical reasons or to attend judicial proceedings or a coroner's inquest` TRUE EQUALS JUST FALSE   -- Board approval
#ASSERT `s 746.1(3) the kind of release is barred until the expiration of all but one fifth of the period` TRUE FALSE TRUE 10 1 `s 746.1 day parole` FALSE EQUALS NOTHING   -- 18 or over: not caught by subsection (3)
#ASSERT `s 746.1(3) the kind of release is barred until the expiration of all but one fifth of the period` FALSE TRUE TRUE 10 1 `s 746.1 day parole` FALSE EQUALS NOTHING   -- not convicted of murder
