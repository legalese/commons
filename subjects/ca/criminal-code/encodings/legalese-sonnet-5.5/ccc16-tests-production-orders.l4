#ASSERT `s 487.017(1) the justice or judge may order the person to prepare and produce a document containing tracking data` TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.017(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.017(2) the justice or judge has the satisfaction required before making the order` FALSE TRUE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 1)
#ASSERT `s 487.017(2) the justice or judge has the satisfaction required before making the order` TRUE FALSE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 2)
#ASSERT `s 487.017(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE FALSE EQUALS JUST FALSE   -- one ground or the oath missing (position 3)
#ASSERT `s 487.017(3) the order is in Form 5.007` TRUE EQUALS JUST TRUE
#ASSERT `s 487.017(3) the order is in Form 5.007` FALSE EQUALS JUST FALSE   -- "The order is to be in Form 5.007"
#ASSERT `s 487.017(4) the order is barred against the person under investigation for the offence` TRUE EQUALS JUST TRUE   -- a person who is under investigation for the offence may not be made subject to an order
#ASSERT `s 487.017(4) the order is barred against the person under investigation for the offence` FALSE EQUALS NOTHING   -- a person not under investigation for it: the subsection is silent

§ `s 487.018 -- financial data`
#ASSERT `s 487.018(1) the justice or judge may order the document to set out the data` TRUE TRUE `s 487.018(1)(a) the account number of a person named in the order or the name of a person whose account number is specified in the order, as well as, in the case of digital assets, including virtual currency, the name and account number of a person whose identifier associated with digital assets is specified in the order` EQUALS JUST TRUE
#ASSERT `s 487.018(1) the justice or judge may order the document to set out the data` TRUE TRUE `s 487.018(1)(b) the type of account` EQUALS JUST TRUE
#ASSERT `s 487.018(1) the justice or judge may order the document to set out the data` TRUE TRUE `s 487.018(1)(c) the status of the account` EQUALS JUST TRUE
#ASSERT `s 487.018(1) the justice or judge may order the document to set out the data` TRUE TRUE `s 487.018(1)(d) the date on which it was opened or closed` EQUALS JUST TRUE
#ASSERT `s 487.018(1) the justice or judge may order the document to set out the data` TRUE TRUE `s 487.018(1) other data` EQUALS NOTHING   -- not one of the four kinds
#ASSERT `s 487.018(1) the justice or judge may order the document to set out the data` FALSE TRUE `s 487.018(1)(b) the type of account` EQUALS NOTHING   -- no ex parte application by a peace officer or public officer
#ASSERT `s 487.018(1) the justice or judge may order the document to set out the data` TRUE FALSE `s 487.018(1)(b) the type of account` EQUALS NOTHING   -- not a financial institution or an entity of section 5 of the Proceeds of Crime (Money Laundering) and Terrorist Financing Act
#ASSERT `s 487.018(2) the order may also require the document to set out the identifying data` TRUE `s 487.018(2)(a) the date of birth of a person who is named or whose account number or identifier associated with digital assets is specified in the order` EQUALS JUST TRUE
#ASSERT `s 487.018(2) the order may also require the document to set out the identifying data` TRUE `s 487.018(2)(b) that person’s current address` EQUALS JUST TRUE
#ASSERT `s 487.018(2) the order may also require the document to set out the identifying data` TRUE `s 487.018(2)(c) any previous addresses of that person` EQUALS JUST TRUE
#ASSERT `s 487.018(2) the order may also require the document to set out the identifying data` TRUE `s 487.018(2) other data` EQUALS NOTHING
#ASSERT `s 487.018(2) the order may also require the document to set out the identifying data` FALSE `s 487.018(2)(b) that person’s current address` EQUALS NOTHING   -- not for the purpose of confirming identity
#ASSERT `s 487.018(3) the justice or judge has the satisfaction required before making the order` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.018(3) the justice or judge has the satisfaction required before making the order` FALSE TRUE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 1)
#ASSERT `s 487.018(3) the justice or judge has the satisfaction required before making the order` TRUE FALSE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 2)
#ASSERT `s 487.018(3) the justice or judge has the satisfaction required before making the order` TRUE TRUE FALSE EQUALS JUST FALSE   -- one ground or the oath missing (position 3)
#ASSERT `s 487.018(4) the order is in Form 5.008` TRUE EQUALS JUST TRUE
#ASSERT `s 487.018(4) the order is in Form 5.008` FALSE EQUALS JUST FALSE   -- "The order is to be in Form 5.008"
#ASSERT `s 487.018(5) the order is barred against the person under investigation for the offence` TRUE EQUALS JUST TRUE   -- a person who is under investigation for the offence may not be made subject to an order
#ASSERT `s 487.018(5) the order is barred against the person under investigation for the offence` FALSE EQUALS NOTHING   -- a person not under investigation for it: the subsection is silent

§ `s 487.019 -- conditions, effect, revoking or varying`
#ASSERT `s 487.019(1) the order may contain the condition` (`Provision of the Code` OF 487.013, "") TRUE EQUALS JUST TRUE   -- "any of sections 487.013 to 487.018": the first
#ASSERT `s 487.019(1) the order may contain the condition` (`Provision of the Code` OF 487.0131, "") TRUE EQUALS JUST TRUE
#ASSERT `s 487.019(1) the order may contain the condition` (`Provision of the Code` OF 487.018, "") TRUE EQUALS JUST TRUE   -- the last
#ASSERT `s 487.019(1) the order may contain the condition` (`Provision of the Code` OF 487.0191, "") TRUE EQUALS NOTHING   -- past 487.018
#ASSERT `s 487.019(1) the order may contain the condition` (`Provision of the Code` OF 487.012, "") TRUE EQUALS NOTHING   -- before 487.013
#ASSERT `s 487.019(1) the order may contain the condition` (`Provision of the Code` OF 487.014, "") FALSE EQUALS NOTHING   -- not a condition the justice or judge considers appropriate
#ASSERT `s 487.019(1) the order may contain the condition to protect a privileged communication` (`Provision of the Code` OF 487.014, "") TRUE EQUALS JUST TRUE
#ASSERT `s 487.019(1) the order may contain the condition to protect a privileged communication` (`Provision of the Code` OF 487.0141, "") TRUE EQUALS JUST TRUE
#ASSERT `s 487.019(1) the order may contain the condition to protect a privileged communication` (`Provision of the Code` OF 487.016, "") TRUE EQUALS NOTHING   -- "including, in the case of an order made under section 487.014 or 487.0141"
#ASSERT `s 487.019(2) the order has effect at the place` TRUE EQUALS JUST TRUE
#ASSERT `s 487.019(2) the order has effect at the place` FALSE EQUALS NOTHING
#ASSERT `s 487.019(3) the justice or judge may revoke or vary the order` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.019(3) the justice or judge may revoke or vary the order` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 487.019(3) the justice or judge may revoke or vary the order` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.019(3) the justice or judge may revoke or vary the order` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.019(3) the peace officer or public officer must give notice of the revocation or variation to the person who is subject to the order` TRUE EQUALS JUST TRUE
#ASSERT `s 487.019(3) the peace officer or public officer must give notice of the revocation or variation to the person who is subject to the order` FALSE EQUALS NOTHING

§ `s 487.0191 -- order prohibiting disclosure`
#ASSERT `s 487.0191(1) the justice or judge may make an order prohibiting the person from disclosing the existence or contents of the demand or order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.0191(1) the justice or judge may make an order prohibiting the person from disclosing the existence or contents of the demand or order` FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.0191(1) the justice or judge may make an order prohibiting the person from disclosing the existence or contents of the demand or order` TRUE FALSE EQUALS NOTHING
