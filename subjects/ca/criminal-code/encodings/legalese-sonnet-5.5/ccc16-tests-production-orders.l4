IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc16-production-orders`

-- ccc16-tests-production-orders.l4 -- tests for ccc16-production-orders.l4 (sections 487.014 to 487.03).
-- Expected values were decided from the text (lines 9119-9288) before the run and are written beside each assertion.

§ `s 487.014 -- general production order`
#ASSERT `s 487.014(1) the justice or judge may order the person to produce a document or to prepare and produce a document` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.014(1) the justice or judge may order the person to produce a document or to prepare and produce a document` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.014(1) the justice or judge may order the person to produce a document or to prepare and produce a document` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 487.014(1) the justice or judge may order the person to produce a document or to prepare and produce a document` TRUE TRUE TRUE EQUALS NOTHING   -- "Subject to sections 487.015 to 487.018": the order is one of those
#ASSERT `s 487.014(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.014(2) the justice or judge has the satisfaction required before making the order` FALSE TRUE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 1)
#ASSERT `s 487.014(2) the justice or judge has the satisfaction required before making the order` TRUE FALSE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 2)
#ASSERT `s 487.014(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE FALSE EQUALS JUST FALSE   -- one ground or the oath missing (position 3)
#ASSERT `s 487.014(3) the order is in Form 5.005` TRUE EQUALS JUST TRUE
#ASSERT `s 487.014(3) the order is in Form 5.005` FALSE EQUALS JUST FALSE   -- "The order is to be in Form 5.005"
#ASSERT `s 487.014(4) the order is barred against the person under investigation for the offence` TRUE EQUALS JUST TRUE   -- a person who is under investigation for the offence may not be made subject to an order
#ASSERT `s 487.014(4) the order is barred against the person under investigation for the offence` FALSE EQUALS NOTHING   -- a person not under investigation for it: the subsection is silent

§ `s 487.0141 -- production order -- specified dates`
#ASSERT `s 487.0141(1) the justice or judge may order the person to produce a document on any of the dates specified in the order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.0141(1) the justice or judge may order the person to produce a document on any of the dates specified in the order` FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.0141(1) the justice or judge may order the person to produce a document on any of the dates specified in the order` TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.0141(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.0141(2) the justice or judge has the satisfaction required before making the order` FALSE TRUE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 1)
#ASSERT `s 487.0141(2) the justice or judge has the satisfaction required before making the order` TRUE FALSE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 2)
#ASSERT `s 487.0141(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE FALSE EQUALS JUST FALSE   -- one ground or the oath missing (position 3)
#ASSERT `s 487.0141(3) the order is in Form 5.0051` TRUE EQUALS JUST TRUE
#ASSERT `s 487.0141(3) the order is in Form 5.0051` FALSE EQUALS JUST FALSE   -- "The order is to be in Form 5.0051"
-- (4) up to 10 dates that fall within the 60-day period after the day on which the order is made (1 January 2026: the days 2 January to 2 March 2026)
#ASSERT `s 487.0141(4) the order may specify the dates` (Date 1 1 2026) (LIST (Date 2 1 2026), (Date 2 3 2026)) EQUALS JUST TRUE   -- the first and the sixtieth day after
#ASSERT `s 487.0141(4) the order may specify the dates` (Date 1 1 2026) (LIST (Date 3 3 2026)) EQUALS JUST FALSE   -- the sixty-first day
#ASSERT `s 487.0141(4) the order may specify the dates` (Date 1 1 2026) (LIST (Date 1 1 2026)) EQUALS JUST FALSE   -- the day it is made is not "after" it
#ASSERT `s 487.0141(4) the order may specify the dates` (Date 1 1 2026) (LIST (Date 31 12 2025)) EQUALS JUST FALSE
#ASSERT `s 487.0141(4) the order may specify the dates` (Date 1 1 2026) (LIST (Date 2 1 2026), (Date 3 1 2026), (Date 4 1 2026), (Date 5 1 2026), (Date 6 1 2026), (Date 7 1 2026), (Date 8 1 2026), (Date 9 1 2026), (Date 10 1 2026), (Date 11 1 2026)) EQUALS JUST TRUE   -- ten dates
#ASSERT `s 487.0141(4) the order may specify the dates` (Date 1 1 2026) (LIST (Date 2 1 2026), (Date 3 1 2026), (Date 4 1 2026), (Date 5 1 2026), (Date 6 1 2026), (Date 7 1 2026), (Date 8 1 2026), (Date 9 1 2026), (Date 10 1 2026), (Date 11 1 2026), (Date 12 1 2026)) EQUALS JUST FALSE   -- eleven dates
#ASSERT `s 487.0141(5) the order may require the person to produce a copy of the reports` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.0141(5) the order may require the person to produce a copy of the reports` TRUE FALSE EQUALS NOTHING   -- not satisfied: "if the justice or judge is satisfied"
#ASSERT `s 487.0141(5) the order may require the person to produce a copy of the reports` FALSE TRUE EQUALS NOTHING
-- (6) the person must not be required to ...
#ASSERT `s 487.0141(6)(a) the person may be required to produce documents again` 71 EQUALS JUST FALSE   -- less than 72 hours after the last requirement
#ASSERT `s 487.0141(6)(a) the person may be required to produce documents again` 72 EQUALS NOTHING   -- 72 hours: not within one 72-hour period (fork F-72)
#ASSERT `s 487.0141(6)(a) the person may be required to produce documents again` 200 EQUALS NOTHING
#ASSERT `s 487.0141(6)(a) the person may be required to produce documents again` 0 EQUALS JUST FALSE
#ASSERT `s 487.0141(6)(b) the person may be required to produce a copy of a document that was in their possession or control before the day on which the order is made` TRUE EQUALS JUST FALSE
#ASSERT `s 487.0141(6)(b) the person may be required to produce a copy of a document that was in their possession or control before the day on which the order is made` FALSE EQUALS NOTHING
#ASSERT `s 487.0141(6)(c) the person may be required to prepare and produce a document that contains data that was in their possession or control before the day on which the order is made` TRUE EQUALS JUST FALSE
#ASSERT `s 487.0141(6)(c) the person may be required to prepare and produce a document that contains data that was in their possession or control before the day on which the order is made` FALSE EQUALS NOTHING
#ASSERT `s 487.0141(7) the order is barred against the person under investigation for the offence` TRUE EQUALS JUST TRUE   -- a person who is under investigation for the offence may not be made subject to an order
#ASSERT `s 487.0141(7) the order is barred against the person under investigation for the offence` FALSE EQUALS NOTHING   -- a person not under investigation for it: the subsection is silent
#ASSERT `s 487.0141(8) the order expires on the day` (Date 1 1 2026) EQUALS (Date 2 3 2026)   -- 60 days after the day on which it is made
#ASSERT `s 487.0141(8) the order is in effect on the day` (Date 1 1 2026) (Date 1 1 2026) NOTHING EQUALS JUST TRUE   -- the day it is made
#ASSERT `s 487.0141(8) the order is in effect on the day` (Date 1 1 2026) (Date 1 3 2026) NOTHING EQUALS JUST TRUE   -- the last day before it expires
#ASSERT `s 487.0141(8) the order is in effect on the day` (Date 1 1 2026) (Date 2 3 2026) NOTHING EQUALS JUST FALSE   -- the day it expires
#ASSERT `s 487.0141(8) the order is in effect on the day` (Date 1 1 2026) (Date 12 3 2026) NOTHING EQUALS JUST FALSE
#ASSERT `s 487.0141(8) the order is in effect on the day` (Date 1 1 2026) (Date 6 1 2026) (JUST (Date 6 1 2026)) EQUALS NOTHING   -- revoked earlier: the expiry clause is silent
#ASSERT `s 487.0141(9) the justice or judge may renew the order for the period` TRUE 60 EQUALS JUST TRUE   -- not more than 60 days: the boundary
#ASSERT `s 487.0141(9) the justice or judge may renew the order for the period` TRUE 61 EQUALS JUST FALSE   -- more than 60 days
#ASSERT `s 487.0141(9) the justice or judge may renew the order for the period` TRUE 1 EQUALS JUST TRUE
#ASSERT `s 487.0141(9) the justice or judge may renew the order for the period` FALSE 30 EQUALS NOTHING   -- no ex parte application indicating the reason and period
#ASSERT `s 487.0141(10) the justice or judge has the satisfaction required before renewing the order` TRUE EQUALS JUST TRUE
#ASSERT `s 487.0141(10) the justice or judge has the satisfaction required before renewing the order` FALSE EQUALS JUST FALSE
#ASSERT `s 487.0141(11) the renewed order may specify the dates` (Date 1 3 2026) (Date 30 4 2026) (LIST (Date 1 3 2026), (Date 30 4 2026)) EQUALS JUST TRUE   -- the first and the last day of the renewal period
#ASSERT `s 487.0141(11) the renewed order may specify the dates` (Date 1 3 2026) (Date 30 4 2026) (LIST (Date 28 2 2026)) EQUALS JUST FALSE   -- before the period
#ASSERT `s 487.0141(11) the renewed order may specify the dates` (Date 1 3 2026) (Date 30 4 2026) (LIST (Date 1 5 2026)) EQUALS JUST FALSE   -- after the period
#ASSERT `s 487.0141(11) the renewed order may specify the dates` (Date 1 3 2026) (Date 30 4 2026) (LIST (Date 1 3 2026), (Date 2 3 2026), (Date 3 3 2026), (Date 4 3 2026), (Date 5 3 2026), (Date 6 3 2026), (Date 7 3 2026), (Date 8 3 2026), (Date 9 3 2026), (Date 10 3 2026), (Date 11 3 2026)) EQUALS JUST FALSE   -- eleven dates

§ `s 487.015 -- production order to trace a specified communication`
#ASSERT `s 487.015(1) the justice or judge may order the person to prepare and produce a document containing transmission data` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.015(1) the justice or judge may order the person to prepare and produce a document containing transmission data` FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.015(1) the justice or judge may order the person to prepare and produce a document containing transmission data` TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.015(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.015(2) the justice or judge has the satisfaction required before making the order` FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 1)
#ASSERT `s 487.015(2) the justice or judge has the satisfaction required before making the order` TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 2)
#ASSERT `s 487.015(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 3)
#ASSERT `s 487.015(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- one ground or the oath missing (position 4)
#ASSERT `s 487.015(3) the order is in Form 5.006` TRUE EQUALS JUST TRUE
#ASSERT `s 487.015(3) the order is in Form 5.006` FALSE EQUALS JUST FALSE   -- "The order is to be in Form 5.006"
-- (4) service: (a) within 60 days after the day on which the order is made (made 1 January 2026: 2 March is the sixtieth day after); (b) within one year, for the longer cases
#ASSERT `s 487.015(4) the peace officer or public officer may serve the order on the person on the day` (Date 1 1 2026) (Date 2 3 2026) (`Provision of the Code` OF 380, "") (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- the sixtieth day after
#ASSERT `s 487.015(4) the peace officer or public officer may serve the order on the person on the day` (Date 1 1 2026) (Date 3 3 2026) (`Provision of the Code` OF 380, "") (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- the sixty-first day, not a longer case
#ASSERT `s 487.015(4) the peace officer or public officer may serve the order on the person on the day` (Date 1 1 2026) (Date 3 3 2026) (`Provision of the Code` OF 467.11, "") (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- section 467.11: one year
#ASSERT `s 487.015(4) the peace officer or public officer may serve the order on the person on the day` (Date 1 1 2026) (Date 3 3 2026) (`Provision of the Code` OF 467.12, "") (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 487.015(4) the peace officer or public officer may serve the order on the person on the day` (Date 1 1 2026) (Date 3 3 2026) (`Provision of the Code` OF 467.13, "") (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 487.015(4) the peace officer or public officer may serve the order on the person on the day` (Date 1 1 2026) (Date 3 3 2026) (`Provision of the Code` OF 380, "") (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- for the benefit of a criminal organization
#ASSERT `s 487.015(4) the peace officer or public officer may serve the order on the person on the day` (Date 1 1 2026) (Date 3 3 2026) (`Provision of the Code` OF 380, "") (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE   -- a terrorism offence
#ASSERT `s 487.015(4) the peace officer or public officer may serve the order on the person on the day` (Date 1 1 2026) (Date 3 3 2026) (`Provision of the Code` OF 380, "") NOTHING (JUST FALSE) EQUALS NOTHING   -- s 2 answers not given
#ASSERT `s 487.015(4) the peace officer or public officer may serve the order on the person on the day` (Date 1 1 2026) (Date 3 3 2026) (`Provision of the Code` OF 380, "") (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 487.015(4) the peace officer or public officer may serve the order on the person on the day` (Date 1 1 2026) (Date 1 1 2027) (`Provision of the Code` OF 467.11, "") (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- one year after: the last day
#ASSERT `s 487.015(4) the peace officer or public officer may serve the order on the person on the day` (Date 1 1 2026) (Date 2 1 2027) (`Provision of the Code` OF 467.11, "") (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- past one year
#ASSERT `s 487.015(4) the peace officer or public officer may serve the order on the person on the day` (Date 1 1 2026) (Date 31 12 2025) (`Provision of the Code` OF 467.11, "") (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- before the order is made
#ASSERT `s 487.015(5) the order is barred against the person under investigation for the offence` TRUE EQUALS JUST TRUE   -- a person who is under investigation for the offence may not be made subject to an order
#ASSERT `s 487.015(5) the order is barred against the person under investigation for the offence` FALSE EQUALS NOTHING   -- a person not under investigation for it: the subsection is silent
-- (6) the day the duty to report starts: the earlier of the identification and the end of the period of (4)
#ASSERT `s 487.015(6) the day from which the report is due as soon as feasible` (Date 1 1 2026) FALSE (JUST (Date 10 1 2026)) EQUALS (Date 10 1 2026)   -- identified before the end of 60 days
#ASSERT `s 487.015(6) the day from which the report is due as soon as feasible` (Date 1 1 2026) FALSE (JUST (Date 10 5 2026)) EQUALS (Date 2 3 2026)   -- identified after the 60 days have run out
#ASSERT `s 487.015(6) the day from which the report is due as soon as feasible` (Date 1 1 2026) FALSE NOTHING EQUALS (Date 2 3 2026)   -- nobody identified
#ASSERT `s 487.015(6) the day from which the report is due as soon as feasible` (Date 1 1 2026) TRUE NOTHING EQUALS (Date 1 1 2027)   -- the one-year period
#ASSERT `s 487.015(6) the day from which the report is due as soon as feasible` (Date 1 1 2026) TRUE (JUST (Date 10 5 2026)) EQUALS (Date 10 5 2026)
#ASSERT `s 487.015(6) the report states what is required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.015(6) the report states what is required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.015(6) the report states what is required` FALSE TRUE EQUALS JUST FALSE

§ `ss 487.016 and 487.017 -- transmission data and tracking data`
#ASSERT `s 487.016(1) the justice or judge may order the person to prepare and produce a document containing transmission data` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.016(1) the justice or judge may order the person to prepare and produce a document containing transmission data` FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.016(1) the justice or judge may order the person to prepare and produce a document containing transmission data` TRUE FALSE EQUALS NOTHING
