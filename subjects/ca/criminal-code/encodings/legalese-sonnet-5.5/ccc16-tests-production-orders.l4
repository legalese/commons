#ASSERT `s 487.0191(2) the justice or judge has the satisfaction required before making the order` FALSE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 1)
#ASSERT `s 487.0191(2) the justice or judge has the satisfaction required before making the order` TRUE FALSE EQUALS JUST FALSE   -- one ground or the oath missing (position 2)
#ASSERT `s 487.0191(3) the order is in Form 5.0091` TRUE EQUALS JUST TRUE
#ASSERT `s 487.0191(3) the order is in Form 5.0091` FALSE EQUALS JUST FALSE   -- "The order is to be in Form 5.0091"
#ASSERT `s 487.0191(4) the applicant may apply to revoke or vary the order` `s 487.0191(4) a peace officer or a public officer` TRUE `s 487.0191(4) the justice or judge who made the order` EQUALS JUST TRUE
#ASSERT `s 487.0191(4) the applicant may apply to revoke or vary the order` `s 487.0191(4) a person, financial institution or entity that is subject to an order made under subsection (1)` TRUE `s 487.0191(4) a judge in the judicial district where the order was made` EQUALS JUST TRUE
#ASSERT `s 487.0191(4) the applicant may apply to revoke or vary the order` `s 487.0191(4) another person` TRUE `s 487.0191(4) the justice or judge who made the order` EQUALS NOTHING
#ASSERT `s 487.0191(4) the applicant may apply to revoke or vary the order` `s 487.0191(4) a peace officer or a public officer` FALSE `s 487.0191(4) the justice or judge who made the order` EQUALS NOTHING   -- not in writing
#ASSERT `s 487.0191(4) the applicant may apply to revoke or vary the order` `s 487.0191(4) a peace officer or a public officer` TRUE `s 487.0191(4) another judge or justice` EQUALS NOTHING

§ `s 487.0192 -- particulars, form of production, non-application, probative force, original`
#ASSERT `s 487.0192(1) the order contains the particulars required` (`Provision of the Code` OF 487.014, "") TRUE EQUALS JUST TRUE
#ASSERT `s 487.0192(1) the order contains the particulars required` (`Provision of the Code` OF 487.0141, "") TRUE EQUALS JUST TRUE
#ASSERT `s 487.0192(1) the order contains the particulars required` (`Provision of the Code` OF 487.016, "") FALSE EQUALS JUST FALSE
#ASSERT `s 487.0192(1) the order contains the particulars required` (`Provision of the Code` OF 487.018, "") TRUE EQUALS JUST TRUE
#ASSERT `s 487.0192(1) the order contains the particulars required` (`Provision of the Code` OF 487.015, "") TRUE EQUALS NOTHING   -- section 487.015 is dealt with by subsection (2)
#ASSERT `s 487.0192(2) the order made under section 487.015 contains the particulars required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.0192(2) the order made under section 487.015 contains the particulars required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.0192(2) the order made under section 487.015 contains the particulars required` FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.0192(3) the order may specify that a document may be produced on or through an electro-magnetic medium` (`Provision of the Code` OF 487.015, "") EQUALS JUST TRUE
#ASSERT `s 487.0192(3) the order may specify that a document may be produced on or through an electro-magnetic medium` (`Provision of the Code` OF 487.013, "") EQUALS NOTHING
#ASSERT `s 487.0192(4) the provision applies to the document` (`Provision of the Code` OF 489.1, "") TRUE EQUALS JUST FALSE   -- "sections 489.1 and 490 do not apply"
#ASSERT `s 487.0192(4) the provision applies to the document` (`Provision of the Code` OF 490, "") TRUE EQUALS JUST FALSE
#ASSERT `s 487.0192(4) the provision applies to the document` (`Provision of the Code` OF 491, "") TRUE EQUALS NOTHING
#ASSERT `s 487.0192(4) the provision applies to the document` (`Provision of the Code` OF 489.1, "") FALSE EQUALS NOTHING
#ASSERT `s 487.0192(5) the copy is admissible in evidence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.0192(5) the copy is admissible in evidence` TRUE FALSE EQUALS NOTHING   -- no proof by affidavit
#ASSERT `s 487.0192(5) the copy is admissible in evidence` FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.0192(6) the document is considered to be original for the purposes of the Canada Evidence Act` TRUE EQUALS JUST TRUE
#ASSERT `s 487.0192(6) the document is considered to be original for the purposes of the Canada Evidence Act` FALSE EQUALS NOTHING

§ `s 487.01921 -- review of a keep account open or active order`
#ASSERT `s 487.01921(1) the person may apply to revoke or vary the order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.01921(1) the person may apply to revoke or vary the order` FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.01921(1) the person may apply to revoke or vary the order` TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.01921(2) the person may make the application` 3 EQUALS JUST TRUE   -- "at least three days' notice"
#ASSERT `s 487.01921(2) the person may make the application` 2 EQUALS JUST FALSE
#ASSERT `s 487.01921(2) the person may make the application` 10 EQUALS JUST TRUE
#ASSERT `s 487.01921(3) the person must comply with the order pending the decision` FALSE EQUALS JUST TRUE
#ASSERT `s 487.01921(3) the person must comply with the order pending the decision` TRUE EQUALS JUST FALSE   -- "until a decision is made"
-- (4) within 14 days after the application is made (made 1 January 2026: 15 January is the fourteenth day after) or as soon as practicable after that period
#ASSERT `s 487.01921(4) the hearing of the application is commenced as required` (Date 1 1 2026) (Date 15 1 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 487.01921(4) the hearing of the application is commenced as required` (Date 1 1 2026) (Date 16 1 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 487.01921(4) the hearing of the application is commenced as required` (Date 1 1 2026) (Date 16 1 2026) TRUE EQUALS JUST TRUE   -- as soon as practicable after that period
#ASSERT `s 487.01921(4) the hearing of the application is commenced as required` (Date 1 1 2026) (Date 1 1 2026) FALSE EQUALS JUST TRUE
-- the same duty as a regulative rule: run, not asserted (the stable binary has no assertion over a trace outcome); the decision function above is what the tests assert
#TRACE `s 487.01921(4) the hearing must be commenced` AT 0 WITH
    PARTY `s 487.01921(4) the justice or judge` DOES `s 487.01921(4) commences the hearing of the application` AT 14
#TRACE `s 487.01921(4) the hearing must be commenced` AT 0 WITH
    PARTY `s 487.01921(4) the justice or judge` DOES `s 487.01921(4) commences the hearing of the application` AT 15
#ASSERT `s 487.01921(5) the justice or judge may revoke or vary the order` TRUE EQUALS JUST TRUE
#ASSERT `s 487.01921(5) the justice or judge may revoke or vary the order` FALSE EQUALS NOTHING

§ `s 487.0193 -- review of a production order`
#ASSERT `s 487.0193(1) the person, financial institution or entity may apply to revoke or vary the order` (`Provision of the Code` OF 487.014, "") TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.0193(1) the person, financial institution or entity may apply to revoke or vary the order` (`Provision of the Code` OF 487.018, "") TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.0193(1) the person, financial institution or entity may apply to revoke or vary the order` (`Provision of the Code` OF 487.014, "") FALSE TRUE EQUALS NOTHING   -- after they are required to produce
#ASSERT `s 487.0193(1) the person, financial institution or entity may apply to revoke or vary the order` (`Provision of the Code` OF 487.014, "") TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.0193(1) the person, financial institution or entity may apply to revoke or vary the order` (`Provision of the Code` OF 487.013, "") TRUE TRUE EQUALS NOTHING   -- a preservation order, not a production order
-- (2) notice within 30 days after the day on which the order is made (made 1 January 2026: 31 January is the thirtieth day after)
#ASSERT `s 487.0193(2) the person, institution or entity may make the application` (Date 1 1 2026) (Date 31 1 2026) EQUALS JUST TRUE
#ASSERT `s 487.0193(2) the person, institution or entity may make the application` (Date 1 1 2026) (Date 1 2 2026) EQUALS JUST FALSE
#ASSERT `s 487.0193(2) the person, institution or entity may make the application` (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST TRUE
#ASSERT `s 487.0193(2) the person, institution or entity may make the application` (Date 1 1 2026) (Date 31 12 2025) EQUALS JUST FALSE
#TRACE `s 487.0193(2) the notice may be given` AT 0 WITH
    PARTY `s 487.0193(2) the person, institution or entity` DOES `s 487.0193(2) gives notice of their intention to apply to a peace officer or public officer named in the order` AT 30
#TRACE `s 487.0193(2) the notice may be given` AT 0 WITH
    PARTY `s 487.0193(2) the person, institution or entity` DOES `s 487.0193(2) gives notice of their intention to apply to a peace officer or public officer named in the order` AT 31
#ASSERT `s 487.0193(3) the person, institution or entity is required to prepare or produce the document` TRUE FALSE EQUALS JUST FALSE   -- until a final decision
#ASSERT `s 487.0193(3) the person, institution or entity is required to prepare or produce the document` TRUE TRUE EQUALS NOTHING   -- after it: the subsection is silent
#ASSERT `s 487.0193(3) the person, institution or entity is required to prepare or produce the document` FALSE FALSE EQUALS NOTHING   -- no application
#ASSERT `s 487.0193(4) the justice or judge may revoke or vary the order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.0193(4) the justice or judge may revoke or vary the order` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 487.0193(4) the justice or judge may revoke or vary the order` FALSE FALSE EQUALS NOTHING

§ `s 487.0194 -- destruction of preserved computer data and documents`
#ASSERT `s 487.0194(1) the person to whom a preservation demand is made must destroy it` `s 487.0194 the computer data that would not be retained in the ordinary course of business` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.0194(1) the person to whom a preservation demand is made must destroy it` `s 487.0194 any document that is prepared for the purpose of preserving computer data under that section` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.0194(1) the person to whom a preservation demand is made must destroy it` `s 487.0194 the computer data that would not be retained in the ordinary course of business` FALSE FALSE EQUALS JUST FALSE   -- the demand has not expired or been revoked
#ASSERT `s 487.0194(1) the person to whom a preservation demand is made must destroy it` `s 487.0194 the computer data that would not be retained in the ordinary course of business` TRUE TRUE EQUALS JUST FALSE   -- "unless they are subject to an order made under any of sections 487.013 to 487.017"
#ASSERT `s 487.0194(1) the person to whom a preservation demand is made must destroy it` `s 487.0194 something else` TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.0194(2) the person subject to a preservation order must destroy it` `s 487.0194 the computer data that would not be retained in the ordinary course of business` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.0194(2) the person subject to a preservation order must destroy it` `s 487.0194 the computer data that would not be retained in the ordinary course of business` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 487.0194(2) the person subject to a preservation order must destroy it` `s 487.0194 the computer data that would not be retained in the ordinary course of business` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 487.0194(2) the person subject to a preservation order must destroy it` `s 487.0194 something else` TRUE FALSE EQUALS NOTHING
-- (3) after the earlier of the day the production order is revoked and the day a document is produced
#ASSERT `s 487.0194(3) the earlier day after which the person must destroy the computer data as soon as feasible` (JUST (Date 5 3 2026)) (JUST (Date 9 3 2026)) EQUALS JUST (Date 5 3 2026)
#ASSERT `s 487.0194(3) the earlier day after which the person must destroy the computer data as soon as feasible` (JUST (Date 9 3 2026)) (JUST (Date 5 3 2026)) EQUALS JUST (Date 5 3 2026)
#ASSERT `s 487.0194(3) the earlier day after which the person must destroy the computer data as soon as feasible` (JUST (Date 5 3 2026)) NOTHING EQUALS JUST (Date 5 3 2026)
#ASSERT `s 487.0194(3) the earlier day after which the person must destroy the computer data as soon as feasible` NOTHING (JUST (Date 9 3 2026)) EQUALS JUST (Date 9 3 2026)
#ASSERT `s 487.0194(3) the earlier day after which the person must destroy the computer data as soon as feasible` NOTHING NOTHING EQUALS NOTHING   -- neither has happened: no day
#ASSERT `s 487.0194(4) the person must destroy the computer data when the document is obtained under a warrant` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.0194(4) the person must destroy the computer data when the document is obtained under a warrant` TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.0194(4) the person must destroy the computer data when the document is obtained under a warrant` FALSE TRUE EQUALS NOTHING

§ `ss 487.0195 and 487.0196`
#ASSERT `s 487.0195(1) a preservation demand, preservation order, keep account open or active order or production order is necessary for the officer to ask` `s 487.0195(1) to voluntarily preserve data that the person is not prohibited by law from preserving` TRUE EQUALS JUST FALSE
#ASSERT `s 487.0195(1) a preservation demand, preservation order, keep account open or active order or production order is necessary for the officer to ask` `s 487.0195(1) to voluntarily keep an account open or active that the person is not prohibited by law from keeping open or active` TRUE EQUALS JUST FALSE
#ASSERT `s 487.0195(1) a preservation demand, preservation order, keep account open or active order or production order is necessary for the officer to ask` `s 487.0195(1) to voluntarily provide a document to the officer that the person is not prohibited by law from disclosing` TRUE EQUALS JUST FALSE
#ASSERT `s 487.0195(1) a preservation demand, preservation order, keep account open or active order or production order is necessary for the officer to ask` `s 487.0195(1) to voluntarily provide a document to the officer that the person is not prohibited by law from disclosing` FALSE EQUALS NOTHING   -- the person is prohibited by law from disclosing it
#ASSERT `s 487.0195(1) a preservation demand, preservation order, keep account open or active order or production order is necessary for the officer to ask` `s 487.0195(1) something else` TRUE EQUALS NOTHING
#ASSERT `s 487.0195(2) the person incurs criminal or civil liability for doing so` TRUE EQUALS JUST FALSE
#ASSERT `s 487.0195(2) the person incurs criminal or civil liability for doing so` FALSE EQUALS NOTHING
#ASSERT `s 487.0196 the person is excused from complying with the order` TRUE TRUE EQUALS JUST FALSE   -- "No one is excused ... on the ground that the document ... may tend to incriminate them"
#ASSERT `s 487.0196 the person is excused from complying with the order` TRUE FALSE EQUALS NOTHING   -- some other ground
#ASSERT `s 487.0196 the person is excused from complying with the order` FALSE TRUE EQUALS NOTHING   -- not an order under sections 487.014 to 487.018
#ASSERT `s 487.0196 the document the individual was required to prepare may be used or received in evidence against them` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.0196 the document the individual was required to prepare may be used or received in evidence against them` TRUE TRUE TRUE EQUALS NOTHING   -- "other than a prosecution for an offence under section 132, 136 or 137": the exception, not covered
#ASSERT `s 487.0196 the document the individual was required to prepare may be used or received in evidence against them` FALSE TRUE FALSE EQUALS NOTHING   -- not a document the individual was required to prepare
#ASSERT `s 487.0196 the document the individual was required to prepare may be used or received in evidence against them` TRUE FALSE FALSE EQUALS NOTHING   -- not a criminal proceeding subsequently instituted against them

§ `ss 487.0197 to 487.0199 -- offences`
#ASSERT `s 487.0197 the person is guilty of an offence punishable on summary conviction` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.0197 the person is guilty of an offence punishable on summary conviction` TRUE TRUE EQUALS NOTHING   -- with a lawful excuse: the "without lawful excuse" limit (marginal reading (b))
#ASSERT `s 487.0197 the person is guilty of an offence punishable on summary conviction` FALSE FALSE EQUALS NOTHING
#ASSERT `s 487.0197 the punishment the section states`'s `mode` EQUALS `on summary conviction`
#ASSERT `s 487.0197 the punishment the section states`'s `maximum fine` EQUALS `a fine of` 5000
#ASSERT `s 487.0197 the punishment the section states`'s `maximum imprisonment` EQUALS `no imprisonment is stated`
#ASSERT `s 487.0197 the fine is within the maximum` 5000 EQUALS JUST TRUE   -- "not more than $5,000"
#ASSERT `s 487.0197 the fine is within the maximum` 5000.01 EQUALS JUST FALSE
#ASSERT `s 487.0197 the fine is within the maximum` 0 EQUALS JUST TRUE
#ASSERT `s 487.0198 the person, financial institution or entity is guilty of an offence punishable on summary conviction` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.0198 the person, financial institution or entity is guilty of an offence punishable on summary conviction` TRUE TRUE EQUALS NOTHING
#ASSERT `s 487.0198 the person, financial institution or entity is guilty of an offence punishable on summary conviction` FALSE FALSE EQUALS NOTHING
#ASSERT `s 487.0198 the punishment the section states`'s `maximum fine` EQUALS `a fine of` 250000
#ASSERT `s 487.0198 the punishment the section states`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `two years less a day`
#ASSERT `s 487.0198 the punishment the section states`'s `mode` EQUALS `on summary conviction`
-- "a fine of not more than $250,000 or to imprisonment for a term of not more than two years less a day, or to both": both limits are checked
#ASSERT `s 487.0198 the punishment is within the maximum` 250000 (`Length of time` OF 2, 0, 0, TRUE) EQUALS JUST TRUE
#ASSERT `s 487.0198 the punishment is within the maximum` 250001 (`Length of time` OF 2, 0, 0, TRUE) EQUALS JUST FALSE
#ASSERT `s 487.0198 the punishment is within the maximum` 0 (`Length of time` OF 2, 0, 0, FALSE) EQUALS JUST FALSE   -- two years is more than two years less a day
#ASSERT `s 487.0198 the punishment is within the maximum` 0 (`Length of time` OF 1, 11, 30, FALSE) EQUALS JUST TRUE
#ASSERT `s 487.0198 the punishment is within the maximum` 0 (`Length of time` OF 2, 0, 1, FALSE) EQUALS JUST FALSE
#ASSERT `s 487.0199 the person is guilty of an offence punishable on summary conviction` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.0199 the person is guilty of an offence punishable on summary conviction` TRUE TRUE EQUALS NOTHING
#ASSERT `s 487.0199 the person is guilty of an offence punishable on summary conviction` FALSE FALSE EQUALS NOTHING
#ASSERT `s 487.0199 the punishment the section states`'s `mode` EQUALS `on summary conviction`
#ASSERT `s 487.0199 the punishment the section states`'s `maximum fine` EQUALS `no fine is stated`

§ `s 487.02 -- assistance order`
#ASSERT `s 487.02(1) the judge or justice may order the person to provide assistance` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.02(1) the judge or justice may order the person to provide assistance` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 487.02(1) the judge or justice may order the person to provide assistance` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.02(1) the judge or justice may order the person to provide assistance` TRUE TRUE FALSE EQUALS NOTHING   -- the assistance is not reasonably required
#ASSERT `s 487.02(1) the assistance order has effect at the place` TRUE EQUALS JUST TRUE
#ASSERT `s 487.02(1) the assistance order has effect at the place` FALSE EQUALS NOTHING
#ASSERT `s 487.02(2) the order to provide assistance may be issued by a means of telecommunication` TRUE EQUALS JUST TRUE
#ASSERT `s 487.02(2) the order to provide assistance may be issued by a means of telecommunication` FALSE EQUALS NOTHING
