IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc22-juries`

-- ccc22-tests-juries.l4 -- tests for ccc22-juries.l4 (sections 626 to 644). Expected values are written from the text, beside the assertion. Arguments are in the order of each function's GIVEN lines.

§ `Sections 626 to 630`

-- 626(1): args: qualified according to the laws of the province, summoned in accordance with them, criminal proceedings in that province.
#ASSERT `s 626(1) the person is qualified to serve as a juror in criminal proceedings in the province` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 626(1) the person is qualified to serve as a juror in criminal proceedings in the province` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 626(1) the person is qualified to serve as a juror in criminal proceedings in the province` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 626(2) the person may be disqualified, exempted or excused from serving as a juror on that ground` TRUE EQUALS JUST FALSE   -- the ground is sex
#ASSERT `s 626(2) the person may be disqualified, exempted or excused from serving as a juror on that ground` FALSE EQUALS NOTHING
#ASSERT `s 626.1 the judge before whom the accused is tried may be this judge` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 626.1 the judge before whom the accused is tried may be this judge` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 626.1 the judge before whom the accused is tried may be this judge` FALSE FALSE EQUALS NOTHING
-- 627: args: the person is the judge, the juror has a physical disability, otherwise qualified.
#ASSERT `s 627 the judge may permit the juror to have technical, personal, interpretative or other support services` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 627 the judge may permit the juror to have technical, personal, interpretative or other support services` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 627 the judge may permit the juror to have technical, personal, interpretative or other support services` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 627 the judge may permit the juror to have technical, personal, interpretative or other support services` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 628 what the text shows` EQUALS "[Repealed, R.S., 1985, c. 27 (1st Supp.), s. 129]"
-- 629(1): args: the challenger is the accused or the prosecutor, the ground.
#ASSERT `s 629(1) the accused or the prosecutor may challenge the jury panel` TRUE `s 629(1) partiality on the part of the sheriff or other officer by whom the panel was returned` EQUALS JUST TRUE
#ASSERT `s 629(1) the accused or the prosecutor may challenge the jury panel` TRUE `s 629(1) fraud on the part of the sheriff or other officer by whom the panel was returned` EQUALS JUST TRUE
#ASSERT `s 629(1) the accused or the prosecutor may challenge the jury panel` TRUE `s 629(1) wilful misconduct on the part of the sheriff or other officer by whom the panel was returned` EQUALS JUST TRUE
#ASSERT `s 629(1) the accused or the prosecutor may challenge the jury panel` TRUE `s 629(1) some other ground` EQUALS JUST FALSE   -- "only on the ground"
#ASSERT `s 629(1) the accused or the prosecutor may challenge the jury panel` FALSE `s 629(1) fraud on the part of the sheriff or other officer by whom the panel was returned` EQUALS NOTHING
#ASSERT `s 629(2) the challenge is in the form subsection (2) requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 629(2) the challenge is in the form subsection (2) requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 629(2) the challenge is in the form subsection (2) requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 629(3) the challenge may be in Form 40` TRUE EQUALS JUST TRUE
#ASSERT `s 629(3) the challenge may be in Form 40` FALSE EQUALS NOTHING
-- 630: args: a challenge is made under section 629, the judge is satisfied that the ground is true.
#ASSERT `s 630 the judge must determine whether the ground is true and, if satisfied that it is, direct a new panel to be returned` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 630 the judge must determine whether the ground is true and, if satisfied that it is, direct a new panel to be returned` TRUE FALSE EQUALS NOTHING
#ASSERT `s 630 the judge must determine whether the ground is true and, if satisfied that it is, direct a new panel to be returned` FALSE FALSE EQUALS JUST FALSE

§ `Section 631`

#ASSERT `s 631(1) the name, number and address of each juror must be written on a separate card, the cards being as far as possible of equal size` TRUE EQUALS JUST TRUE
#ASSERT `s 631(1) the name, number and address of each juror must be written on a separate card, the cards being as far as possible of equal size` FALSE EQUALS NOTHING
#ASSERT `s 631(2) the sheriff or other officer who returns the panel must deliver the cards to the clerk of the court, who must have them placed in a box and shaken` TRUE EQUALS JUST TRUE
#ASSERT `s 631(2) the sheriff or other officer who returns the panel must deliver the cards to the clerk of the court, who must have them placed in a box and shaken` FALSE EQUALS NOTHING
-- (2.1): args: the judge considers alternates advisable, the number of alternate jurors, the clerk has drawn out the cards.
#ASSERT `s 631(2.1) the judge must order alternate jurors before the clerk of the court draws out the cards` TRUE 1 FALSE EQUALS JUST TRUE
#ASSERT `s 631(2.1) the judge must order alternate jurors before the clerk of the court draws out the cards` TRUE 2 FALSE EQUALS JUST TRUE
#ASSERT `s 631(2.1) the judge must order alternate jurors before the clerk of the court draws out the cards` TRUE 3 FALSE EQUALS NOTHING   -- "one or two"
#ASSERT `s 631(2.1) the judge must order alternate jurors before the clerk of the court draws out the cards` TRUE 0 FALSE EQUALS NOTHING
#ASSERT `s 631(2.1) the judge must order alternate jurors before the clerk of the court draws out the cards` TRUE 1 TRUE EQUALS JUST FALSE   -- the cards are already drawn
#ASSERT `s 631(2.1) the judge must order alternate jurors before the clerk of the court draws out the cards` FALSE 1 FALSE EQUALS JUST FALSE   -- the judge does not consider it advisable
#TRACE (`s 631(2.1) the judge must order alternate jurors before the draw` 10) AT 0 WITH
    PARTY `a judge` DOES `s 631(2.1) order that one or two alternate jurors be sworn` AT 5
-- expected: FULFILLED
#TRACE (`s 631(2.1) the judge must order alternate jurors before the draw` 10) AT 0 WITH
    (WAITUNTIL 11)
-- expected: BREACHED
-- (2.2): args: the judge considers it advisable, the number of jurors to be sworn, before the clerk draws.
#ASSERT `s 631(2.2) the judge may order that 13 or 14 jurors, instead of 12, be sworn` TRUE 13 TRUE EQUALS JUST TRUE
#ASSERT `s 631(2.2) the judge may order that 13 or 14 jurors, instead of 12, be sworn` TRUE 14 TRUE EQUALS JUST TRUE
#ASSERT `s 631(2.2) the judge may order that 13 or 14 jurors, instead of 12, be sworn` TRUE 15 TRUE EQUALS NOTHING
#ASSERT `s 631(2.2) the judge may order that 13 or 14 jurors, instead of 12, be sworn` TRUE 12 TRUE EQUALS NOTHING
#ASSERT `s 631(2.2) the judge may order that 13 or 14 jurors, instead of 12, be sworn` FALSE 13 TRUE EQUALS NOTHING
#ASSERT `s 631(2.2) the judge may order that 13 or 14 jurors, instead of 12, be sworn` TRUE 13 FALSE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `#ASSERT `s 631(2.2) the judge may order that 13 or 14 jurors, instead of 12, be sworn` TRUE 13 FALSE EQUALS NOTHING`; a period the text fixes in its own words (ruling (a) of 2026-11-05), so outside it the answer is JUST FALSE, listed in the fork register as [F:may-where] with the other reading NOTHING; the order is not made before the clerk draws out the cards
-- (3): args: the array is not challenged or the challenge does not lead to a new panel, the number who have answered is sufficient.
#ASSERT `s 631(3) the clerk of the court must draw out the cards one after another in open court` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 631(3) the clerk of the court must draw out the cards one after another in open court` TRUE TRUE EQUALS JUST FALSE   -- "until the number of persons who have answered is ... sufficient"
#ASSERT `s 631(3) the clerk of the court must draw out the cards one after another in open court` FALSE FALSE EQUALS JUST FALSE   -- a new panel is to be returned
#ASSERT `s 631(3.1) the court or judge may order the clerk of the court to call out the name and the number on each card` TRUE EQUALS JUST TRUE
#ASSERT `s 631(3.1) the court or judge may order the clerk of the court to call out the name and the number on each card` FALSE EQUALS NOTHING
#ASSERT `s 631(4) the clerk of the court must swear the person` `s 631(4) a member of the jury` EQUALS JUST TRUE
#ASSERT `s 631(4) the clerk of the court must swear the person` `s 631(4) an alternate juror` EQUALS JUST TRUE
#ASSERT `s 631(4) the clerk of the court must swear the person` `s 631(4) a person providing technical, personal, interpretative or other support services to a juror with a physical disability` EQUALS JUST TRUE
#ASSERT `s 631(4) the clerk of the court must swear the person` `s 631(4) someone else` EQUALS NOTHING
-- (5): args: insufficient number answered, jurors sworn, jurors required, the alternates ordered are sworn.
#ASSERT `s 631(5) the clerk of the court must proceed in accordance with subsections (3), (3.1) and (4)` TRUE 11 12 FALSE EQUALS JUST TRUE
#ASSERT `s 631(5) the clerk of the court must proceed in accordance with subsections (3), (3.1) and (4)` TRUE 12 12 FALSE EQUALS JUST TRUE   -- 12 sworn but the alternates are not
#ASSERT `s 631(5) the clerk of the court must proceed in accordance with subsections (3), (3.1) and (4)` TRUE 12 12 TRUE EQUALS JUST FALSE   -- "until 12 jurors ... and any alternate jurors are sworn"
#ASSERT `s 631(5) the clerk of the court must proceed in accordance with subsections (3), (3.1) and (4)` TRUE 13 14 TRUE EQUALS JUST TRUE   -- the judge ordered 14 under (2.2): 13 are not enough
#ASSERT `s 631(5) the clerk of the court must proceed in accordance with subsections (3), (3.1) and (4)` FALSE 5 12 FALSE EQUALS JUST FALSE
-- (6): args: application by the prosecutor or the court's own motion, satisfied that it is necessary, the order sought.
#ASSERT `s 631(6) the court or judge may make an order protecting the identity of a juror` TRUE TRUE `s 631(6)(a) that the identity of a juror or any information that could disclose their identity shall not be published in any document or broadcast or transmitted in any way` EQUALS JUST TRUE
#ASSERT `s 631(6) the court or judge may make an order protecting the identity of a juror` TRUE TRUE `s 631(6)(b) limiting access to or the use of that information` EQUALS JUST TRUE
#ASSERT `s 631(6) the court or judge may make an order protecting the identity of a juror` TRUE TRUE `s 631(6) some other order` EQUALS NOTHING
#ASSERT `s 631(6) the court or judge may make an order protecting the identity of a juror` FALSE TRUE `s 631(6)(b) limiting access to or the use of that information` EQUALS NOTHING   -- an application by the accused is not named
#ASSERT `s 631(6) the court or judge may make an order protecting the identity of a juror` TRUE FALSE `s 631(6)(b) limiting access to or the use of that information` EQUALS NOTHING
#ASSERT `s 631.1 electronic or other automated means may be used to select jurors` TRUE EQUALS JUST TRUE
#ASSERT `s 631.1 electronic or other automated means may be used to select jurors` FALSE EQUALS JUST FALSE   -- "so long as"

§ `Sections 632 to 637`

-- 632: args: the order is made before the commencement of the trial, the reason.
#ASSERT `s 632 the judge may order that the juror be excused from jury service` TRUE `s 632(a) personal interest in the matter to be tried` EQUALS JUST TRUE
#ASSERT `s 632 the judge may order that the juror be excused from jury service` TRUE `s 632(b) relationship with the judge presiding over the jury selection process, the judge before whom the accused is to be tried, the prosecutor, the accused, the counsel for the accused or a prospective witness` EQUALS JUST TRUE
#ASSERT `s 632 the judge may order that the juror be excused from jury service` TRUE `s 632(c) personal hardship or any other reasonable cause that, in the opinion of the judge, warrants that the juror be excused` EQUALS JUST TRUE
#ASSERT `s 632 the judge may order that the juror be excused from jury service` TRUE `s 632 some other reason` EQUALS NOTHING
#ASSERT `s 632 the judge may order that the juror be excused from jury service` FALSE `s 632(a) personal interest in the matter to be tried` EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `#ASSERT `s 632 the judge may order that the juror be excused from jury service` FALSE `s 632(a) personal interest in the matter to be tried` EQUALS NOTHING`; a period the text fixes in its own words (ruling (a) of 2026-11-05), so outside it the answer is JUST FALSE, listed in the fork register as [F:may-where] with the other reading NOTHING; after the commencement of the trial
-- 633: args: the juror has been called under 631(3) or (3.1), the reason.
#ASSERT `s 633 the judge may direct the juror to stand by` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 633 the judge may direct the juror to stand by` FALSE TRUE EQUALS NOTHING
#ASSERT `s 633 the judge may direct the juror to stand by` TRUE FALSE EQUALS NOTHING
#ASSERT `s 634 what the text shows` EQUALS "[Repealed, 2019, c. 25, s. 269]"
-- 635(1): args: the place of the juror, the party.
#ASSERT `s 635(1) the party is called on first to declare whether it challenges the juror for cause` 1 `s 635(1) the accused` EQUALS JUST TRUE   -- the first juror: the accused first
#ASSERT `s 635(1) the party is called on first to declare whether it challenges the juror for cause` 1 `s 635(1) the prosecutor` EQUALS JUST FALSE
#ASSERT `s 635(1) the party is called on first to declare whether it challenges the juror for cause` 2 `s 635(1) the prosecutor` EQUALS JUST TRUE   -- then alternately
#ASSERT `s 635(1) the party is called on first to declare whether it challenges the juror for cause` 2 `s 635(1) the accused` EQUALS JUST FALSE
#ASSERT `s 635(1) the party is called on first to declare whether it challenges the juror for cause` 3 `s 635(1) the accused` EQUALS JUST TRUE
#ASSERT `s 635(1) the party is called on first to declare whether it challenges the juror for cause` 4 `s 635(1) the prosecutor` EQUALS JUST TRUE
#ASSERT `s 635(1) the party is called on first to declare whether it challenges the juror for cause` 0 `s 635(1) the accused` EQUALS NOTHING
-- 635(2): args: two or more accused are to be tried together, the order.
#ASSERT `s 635(2) all of the accused exercise the challenges of the defence in turn in a permitted order` TRUE `s 635(2) the order in which their names appear in the indictment` EQUALS JUST TRUE
#ASSERT `s 635(2) all of the accused exercise the challenges of the defence in turn in a permitted order` TRUE `s 635(2) another order agreed on by them` EQUALS JUST TRUE
#ASSERT `s 635(2) all of the accused exercise the challenges of the defence in turn in a permitted order` TRUE `s 635(2) some other order` EQUALS JUST FALSE
#ASSERT `s 635(2) all of the accused exercise the challenges of the defence in turn in a permitted order` FALSE `s 635(2) some other order` EQUALS NOTHING
-- 635(2)(a), (b): args: the place of the juror, the accused go before the prosecutor.
#ASSERT `s 635(2)(a) the defence declares as the paragraph requires` 1 TRUE EQUALS JUST TRUE
#ASSERT `s 635(2)(a) the defence declares as the paragraph requires` 1 FALSE EQUALS JUST FALSE   -- the first juror: before the prosecutor
#ASSERT `s 635(2)(a) the defence declares as the paragraph requires` 2 FALSE EQUALS JUST TRUE   -- the remaining jurors: before or after
#ASSERT `s 635(2)(a) the defence declares as the paragraph requires` 2 TRUE EQUALS JUST TRUE
#ASSERT `s 636 and 637 what the text shows` EQUALS "[Repealed, 1992, c. 41, s. 2]"

§ `Sections 638 to 640`

-- 638(1): args: the challenger is a prosecutor or an accused, the ground, the facts bring the juror within the ground, the description on the panel sufficiently designates the person, an order under section 530 requires the language.
#ASSERT `s 638(1) the prosecutor or the accused is entitled to challenge the juror for cause on the ground` TRUE `s 638(1)(a) the name of the juror does not appear on the panel` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 638(1) the prosecutor or the accused is entitled to challenge the juror for cause on the ground` TRUE `s 638(1)(a) the name of the juror does not appear on the panel` TRUE TRUE FALSE EQUALS JUST FALSE   -- a misnomer that sufficiently designates the person
#ASSERT `s 638(1) the prosecutor or the accused is entitled to challenge the juror for cause on the ground` TRUE `s 638(1)(b) the juror is not impartial` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 638(1) the prosecutor or the accused is entitled to challenge the juror for cause on the ground` TRUE `s 638(1)(b) the juror is not impartial` FALSE FALSE FALSE EQUALS JUST FALSE   -- the ground is not made out
#ASSERT `s 638(1) the prosecutor or the accused is entitled to challenge the juror for cause on the ground` TRUE `s 638(1)(c) the juror has been convicted of an offence for which they were sentenced to a term of imprisonment of two years or more and for which no pardon or record suspension is in effect` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 638(1) the prosecutor or the accused is entitled to challenge the juror for cause on the ground` TRUE `s 638(1)(d) the juror is not a Canadian citizen` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 638(1) the prosecutor or the accused is entitled to challenge the juror for cause on the ground` TRUE `s 638(1)(e) the juror, even with the aid of support services provided under section 627, is physically unable to perform properly the duties of a juror` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 638(1) the prosecutor or the accused is entitled to challenge the juror for cause on the ground` TRUE `s 638(1)(f) the juror does not speak the official language of Canada that is the language of the accused or in which the accused can best give testimony, or both official languages, as an order under section 530 requires` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 638(1) the prosecutor or the accused is entitled to challenge the juror for cause on the ground` TRUE `s 638(1)(f) the juror does not speak the official language of Canada that is the language of the accused or in which the accused can best give testimony, or both official languages, as an order under section 530 requires` TRUE FALSE FALSE EQUALS JUST FALSE   -- no order under section 530
#ASSERT `s 638(1) the prosecutor or the accused is entitled to challenge the juror for cause on the ground` TRUE `s 638(1) some other ground` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 638(1) the prosecutor or the accused is entitled to challenge the juror for cause on the ground` FALSE `s 638(1)(b) the juror is not impartial` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 638(2) a challenge for cause is allowed on the ground` `s 638(1) some other ground` EQUALS JUST FALSE   -- "No challenge for cause shall be allowed on a ground not mentioned in subsection (1)"
#ASSERT `s 638(2) a challenge for cause is allowed on the ground` `s 638(1)(b) the juror is not impartial` EQUALS NOTHING
#ASSERT `s 638(3) and (4) what the text shows` EQUALS "[Repealed, 1997, c. 18, s. 74]"
#ASSERT `s 638(5) what the text shows` EQUALS "[Repealed, R.S., 1985, c. 31 (4th Supp.), s. 96]"
#ASSERT `s 639(1) the court may require the party that challenges to put the challenge in writing` TRUE EQUALS JUST TRUE
#ASSERT `s 639(1) the court may require the party that challenges to put the challenge in writing` FALSE EQUALS JUST FALSE   -- "Where a challenge is made" (ruling (b))
#ASSERT `s 639(2) the challenge may be in Form 41` TRUE EQUALS JUST TRUE
#ASSERT `s 639(2) the challenge may be in Form 41` FALSE EQUALS NOTHING
#ASSERT `s 639(3) the challenge may be denied by the other party` TRUE EQUALS JUST TRUE
#ASSERT `s 639(3) the challenge may be denied by the other party` FALSE EQUALS NOTHING
-- 640(1): args: a challenge is made, the judge is satisfied that the ground is true.
#ASSERT `s 640(1) the judge must determine whether the ground is true and, if satisfied that it is, the juror shall not be sworn` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 640(1) the judge must determine whether the ground is true and, if satisfied that it is, the juror shall not be sworn` TRUE FALSE EQUALS NOTHING
#ASSERT `s 640(1) the judge must determine whether the ground is true and, if satisfied that it is, the juror shall not be sworn` FALSE FALSE EQUALS JUST FALSE
-- 640(2): args: the application of the accused or the prosecutor or the judge's own motion, the judge is of the opinion that the order is necessary to preserve the impartiality.
#ASSERT `s 640(2) the judge may order the exclusion of all jurors from the court room until it is determined whether the ground of challenge is true` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 640(2) the judge may order the exclusion of all jurors from the court room until it is determined whether the ground of challenge is true` FALSE TRUE EQUALS NOTHING
#ASSERT `s 640(2) the judge may order the exclusion of all jurors from the court room until it is determined whether the ground of challenge is true` TRUE FALSE EQUALS NOTHING

§ `Sections 641 to 644`

-- 641(1): args: a full jury and alternates have not been sworn, no cards remain, the person is excused or challenged.
#ASSERT `s 641(1) the person who was directed to stand by must be called again and sworn` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 641(1) the person who was directed to stand by must be called again and sworn` TRUE TRUE TRUE EQUALS JUST FALSE   -- "unless excused by the judge or challenged"
#ASSERT `s 641(1) the person who was directed to stand by must be called again and sworn` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 641(1) the person who was directed to stand by must be called again and sworn` TRUE FALSE FALSE EQUALS JUST FALSE   -- cards remain to be drawn
#ASSERT `s 641(2) the prosecutor may require the cards of the other persons to be put into and drawn from the box` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 641(2) the prosecutor may require the cards of the other persons to be put into and drawn from the box` FALSE TRUE EQUALS NOTHING
#ASSERT `s 641(2) the prosecutor may require the cards of the other persons to be put into and drawn from the box` TRUE FALSE EQUALS NOTHING
#ASSERT `s 642(1) the court may order the sheriff or other proper officer to summon without delay as many persons as the court directs` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 642(1) the court may order the sheriff or other proper officer to summon without delay as many persons as the court directs` TRUE FALSE EQUALS NOTHING   -- no request of the prosecutor
#ASSERT `s 642(1) the court may order the sheriff or other proper officer to summon without delay as many persons as the court directs` FALSE TRUE EQUALS NOTHING
#ASSERT `s 642(2) jurors may be summoned by word of mouth` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 642(2) jurors may be summoned by word of mouth` TRUE FALSE EQUALS NOTHING
#ASSERT `s 642(3) the names are added to the general panel and the same proceedings are taken with respect to those persons as with respect to the persons named in the original panel` TRUE EQUALS JUST TRUE
#ASSERT `s 642(3) the names are added to the general panel and the same proceedings are taken with respect to those persons as with respect to the persons named in the original panel` FALSE EQUALS NOTHING
-- 642.1(1): args: the person is an alternate juror, the number of jurors absent, the place of the alternate in the order of the cards drawn.
#ASSERT `s 642.1(1) the alternate juror must replace an absent juror` TRUE 2 1 EQUALS JUST TRUE
#ASSERT `s 642.1(1) the alternate juror must replace an absent juror` TRUE 2 2 EQUALS JUST TRUE
#ASSERT `s 642.1(1) the alternate juror must replace an absent juror` TRUE 2 3 EQUALS JUST FALSE   -- no absent juror remains for the third alternate
#ASSERT `s 642.1(1) the alternate juror must replace an absent juror` TRUE 0 1 EQUALS JUST FALSE   -- a full jury is present
#ASSERT `s 642.1(1) the alternate juror must replace an absent juror` FALSE 2 1 EQUALS NOTHING
#ASSERT `s 642.1(2) the alternate juror must be excused` FALSE EQUALS JUST TRUE
#ASSERT `s 642.1(2) the alternate juror must be excused` TRUE EQUALS NOTHING
#ASSERT `s 643(1) the person is a member of the jury to hear the evidence on the merits` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 643(1) the person is a member of the jury to hear the evidence on the merits` TRUE FALSE EQUALS NOTHING
#ASSERT `s 643(1) the person is a member of the jury to hear the evidence on the merits` FALSE TRUE EQUALS NOTHING
-- 643(1.1): args: the juror is sworn, excused or verdict or discharged, an issue remains.
#ASSERT `s 643(1.1) the name of the juror must be kept apart` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 643(1.1) the name of the juror must be kept apart` TRUE TRUE EQUALS JUST FALSE   -- "until the juror is excused or the jury gives its verdict or is discharged"
#ASSERT `s 643(1.1) the name of the juror must be kept apart` FALSE FALSE EQUALS NOTHING
#ASSERT `s 643(1.1) the name must be returned to the box` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 643(1.1) the name must be returned to the box` TRUE FALSE EQUALS JUST FALSE   -- "as long as an issue remains to be tried before a jury"
#ASSERT `s 643(1.1) the name must be returned to the box` FALSE TRUE EQUALS JUST FALSE
-- 643(2): args: the jury previously tried another issue, a party objects or the court excuses a juror.
#ASSERT `s 643(2) the court may try an issue with the same jury without the jurors being sworn again` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 643(2) the court may try an issue with the same jury without the jurors being sworn again` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 643(2) the court may try an issue with the same jury without the jurors being sworn again` FALSE FALSE EQUALS NOTHING
#ASSERT `s 643(2) the court must order those persons to withdraw and direct that the required number of cards to make up a full jury be drawn` TRUE EQUALS JUST TRUE
#ASSERT `s 643(2) the court must order those persons to withdraw and direct that the required number of cards to make up a full jury be drawn` FALSE EQUALS JUST FALSE
-- 643(3): arg: the section whose directions were not complied with.
#ASSERT `s 643(3) the failure to comply affects the validity of a proceeding` 643 EQUALS JUST FALSE
#ASSERT `s 643(3) the failure to comply affects the validity of a proceeding` 631 EQUALS JUST FALSE
#ASSERT `s 643(3) the failure to comply affects the validity of a proceeding` 635 EQUALS JUST FALSE
#ASSERT `s 643(3) the failure to comply affects the validity of a proceeding` 641 EQUALS JUST FALSE
#ASSERT `s 643(3) the failure to comply affects the validity of a proceeding` 642 EQUALS NOTHING   -- section 642 is not named
#ASSERT `s 643(3) the failure to comply affects the validity of a proceeding` 636 EQUALS NOTHING
-- 644(1): arg: in the course of a trial the judge is satisfied that a juror should not continue to act.
#ASSERT `s 644(1) the judge may discharge the juror` TRUE EQUALS JUST TRUE
#ASSERT `s 644(1) the judge may discharge the juror` FALSE EQUALS JUST FALSE
-- 644(1.1): args: a juror cannot continue, the jury has not yet begun to hear evidence, the way.
#ASSERT `s 644(1.1) the judge may select another juror to take the place of the juror` TRUE TRUE `s 644(1.1) by drawing a name from a panel of persons who were summoned to act as jurors and who are available at the court at the time of replacing the juror` EQUALS JUST TRUE
#ASSERT `s 644(1.1) the judge may select another juror to take the place of the juror` TRUE TRUE `s 644(1.1) by using the procedure referred to in section 642` EQUALS JUST TRUE
#ASSERT `s 644(1.1) the judge may select another juror to take the place of the juror` TRUE TRUE `s 644(1.1) some other way` EQUALS NOTHING
#ASSERT `s 644(1.1) the judge may select another juror to take the place of the juror` TRUE FALSE `s 644(1.1) by using the procedure referred to in section 642` EQUALS NOTHING   -- the jury has begun to hear evidence
#ASSERT `s 644(1.1) the judge may select another juror to take the place of the juror` FALSE TRUE `s 644(1.1) by using the procedure referred to in section 642` EQUALS NOTHING
-- 644(2): args: a member of the jury dies or is discharged, the number of jurors remaining, the judge otherwise directs.
#ASSERT `s 644(2) the jury is deemed to remain properly constituted for all purposes of the trial` TRUE 11 FALSE EQUALS JUST TRUE
#ASSERT `s 644(2) the jury is deemed to remain properly constituted for all purposes of the trial` TRUE 10 FALSE EQUALS JUST TRUE   -- "not reduced below ten"
#ASSERT `s 644(2) the jury is deemed to remain properly constituted for all purposes of the trial` TRUE 9 FALSE EQUALS JUST FALSE
#ASSERT `s 644(2) the jury is deemed to remain properly constituted for all purposes of the trial` TRUE 11 TRUE EQUALS JUST FALSE   -- "unless the judge otherwise directs"
#ASSERT `s 644(2) the jury is deemed to remain properly constituted for all purposes of the trial` FALSE 11 FALSE EQUALS JUST FALSE
-- 644(3): args: the number of jurors is reduced below 10, the parties consent.
#ASSERT `s 644(3) the judge may discharge the jurors, continue the trial without a jury and render a verdict` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 644(3) the judge may discharge the jurors, continue the trial without a jury and render a verdict` TRUE FALSE EQUALS NOTHING   -- "with the consent of the parties"
#ASSERT `s 644(3) the judge may discharge the jurors, continue the trial without a jury and render a verdict` FALSE TRUE EQUALS NOTHING
