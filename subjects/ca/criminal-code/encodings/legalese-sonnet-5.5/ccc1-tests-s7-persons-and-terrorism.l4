IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc1-s7-base`
IMPORT `ccc1-s7-persons-and-terrorism`

-- ccc1-tests-s7-persons-and-terrorism.l4 -- tests for section 7(3) to (3.77) of the Criminal Code (Canada). Expected values are written by hand from the text.
-- Arguments are positional, in GIVEN order. The offence is the core record `Provision of the Code`.
-- (This file was laid out by a script from tables of grounds and sections written by hand beside it; the script reads the module's constructor names from the module itself,
-- and every expected value below is the hand-written one: TRUE where the table says a ground or a listed section is covered, NOTHING or FALSE where the text leaves it out.)

§ `s 7(3)  (outside Canada; internationally protected person by s 2; against the person or property of section 431; offence; grounds)`
#ASSERT `s 7(3) the act or omission is deemed to have been committed in Canada` TRUE (JUST TRUE) TRUE (`Provision of the Code` OF 235, "") (LIST `s 7(3)(a) the act or omission is committed on a ship that is registered or licensed, or for which an identification number has been issued, pursuant to any Act of Parliament`) EQUALS JUST TRUE   -- section 235; ground (a)
#ASSERT `s 7(3) the act or omission is deemed to have been committed in Canada` TRUE (JUST TRUE) TRUE (`Provision of the Code` OF 235, "") (LIST `s 7(3)(b)(i) the act or omission is committed on an aircraft registered in Canada under regulations made under the Aeronautics Act`) EQUALS JUST TRUE   -- section 235; ground (b)(i)
#ASSERT `s 7(3) the act or omission is deemed to have been committed in Canada` TRUE (JUST TRUE) TRUE (`Provision of the Code` OF 235, "") (LIST `s 7(3)(b)(ii) the act or omission is committed on an aircraft leased without crew and operated by a person who is qualified under regulations made under the Aeronautics Act to be registered as owner of an aircraft in Canada under those regulations`) EQUALS JUST TRUE   -- section 235; ground (b)(ii)
#ASSERT `s 7(3) the act or omission is deemed to have been committed in Canada` TRUE (JUST TRUE) TRUE (`Provision of the Code` OF 235, "") (LIST `s 7(3)(c) the person who commits the act or omission is a Canadian citizen or is, after the act or omission has been committed, present in Canada`) EQUALS JUST TRUE   -- section 235; ground (c)
#ASSERT `s 7(3) the act or omission is deemed to have been committed in Canada` TRUE (JUST TRUE) TRUE (`Provision of the Code` OF 235, "") (LIST `s 7(3)(d)(i) the act or omission is against a person who enjoys the status of an internationally protected person by virtue of the functions that person performs on behalf of Canada`) EQUALS JUST TRUE   -- section 235; ground (d)(i)
#ASSERT `s 7(3) the act or omission is deemed to have been committed in Canada` TRUE (JUST TRUE) TRUE (`Provision of the Code` OF 235, "") (LIST `s 7(3)(d)(ii) the act or omission is against a member of the family of a person described in subparagraph (i) who qualifies under paragraph (b) or (d) of the definition internationally protected person in section 2`) EQUALS JUST TRUE   -- section 235; ground (d)(ii)
#ASSERT `s 7(3) the act or omission is deemed to have been committed in Canada` TRUE (JUST TRUE) TRUE (`Provision of the Code` OF 235, "") EMPTY EQUALS JUST FALSE   -- no ground: "is deemed to commit that act or omission in Canada if"
#ASSERT `s 7(3) the act or omission is deemed to have been committed in Canada` TRUE (JUST TRUE) TRUE (`Provision of the Code` OF 236, "") (LIST `s 7(3)(a) the act or omission is committed on a ship that is registered or licensed, or for which an identification number has been issued, pursuant to any Act of Parliament`) EQUALS JUST TRUE   -- section 236 is listed (280 to 283 as a range)
#ASSERT `s 7(3) the act or omission is deemed to have been committed in Canada` TRUE (JUST TRUE) TRUE (`Provision of the Code` OF 266, "") (LIST `s 7(3)(a) the act or omission is committed on a ship that is registered or licensed, or for which an identification number has been issued, pursuant to any Act of Parliament`) EQUALS JUST TRUE   -- section 266 is listed (280 to 283 as a range)
