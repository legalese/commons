-- tests-independent.l4: independent test author's assertions, expected values from ANSWERS.md (written before opening any module).
-- Helper functions "t ..." are the test author's own, to read one field of a Punishment; they add no law.

`t sp` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

GIVEN i IS AN Imprisonment
GIVETH A NUMBER
`t years of` MEANS
    CONSIDER i
    WHEN `no imprisonment is stated` THEN -1
    WHEN `imprisonment for life` THEN 999
    WHEN `imprisonment for a term of` l THEN l's years + (l's months / 12) + (l's days / 365)

GIVEN ps IS A LIST OF Punishment
GIVETH A NUMBER
`t imax` MEANS
    CONSIDER ps
    WHEN EMPTY THEN -1
    WHEN p FOLLOWED BY rest THEN
        IF p's `mode` EQUALS `by indictment`
        THEN `t years of` (p's `maximum imprisonment`)
        ELSE `t imax` rest

GIVEN ps IS A LIST OF Punishment
GIVETH A NUMBER
`t imin` MEANS
    CONSIDER ps
    WHEN EMPTY THEN -1
    WHEN p FOLLOWED BY rest THEN
        IF p's `mode` EQUALS `by indictment`
        THEN `t years of` (p's `minimum imprisonment`)
        ELSE `t imin` rest

GIVEN ps IS A LIST OF Punishment
GIVETH A NUMBER
`t smax` MEANS
    CONSIDER ps
    WHEN EMPTY THEN -1
    WHEN p FOLLOWED BY rest THEN
        IF p's `mode` EQUALS `on summary conviction`
        THEN `t years of` (p's `maximum imprisonment`)
        ELSE `t smax` rest

GIVEN ps IS A LIST OF Punishment
GIVETH A BOOLEAN
`t hassum` MEANS
    CONSIDER ps
    WHEN EMPTY THEN FALSE
    WHEN p FOLLOWED BY rest THEN
        IF p's `mode` EQUALS `on summary conviction`
        THEN TRUE
        ELSE `t hassum` rest

GIVEN ps IS A LIST OF Punishment
GIVETH A BOOLEAN
`t hasind` MEANS
    CONSIDER ps
    WHEN EMPTY THEN FALSE
    WHEN p FOLLOWED BY rest THEN
        IF p's `mode` EQUALS `by indictment`
        THEN TRUE
        ELSE `t hasind` rest

GIVEN m IS A MAYBE (LIST OF Punishment)
GIVETH A NUMBER
`t imaxm` MEANS
    CONSIDER m
    WHEN NOTHING THEN -2
    WHEN JUST ps THEN `t imax` ps

GIVEN m IS A MAYBE (LIST OF Punishment)
GIVETH A BOOLEAN
`t hassumm` MEANS
    CONSIDER m
    WHEN NOTHING THEN FALSE
    WHEN JUST ps THEN `t hassum` ps

GIVEN ps IS A LIST OF Punishment
GIVETH A NUMBER
`t sfine` MEANS
    CONSIDER ps
    WHEN EMPTY THEN -1
    WHEN p FOLLOWED BY rest THEN
        IF p's `mode` EQUALS `on summary conviction`
        THEN (CONSIDER p's `maximum fine`
              WHEN `no fine is stated` THEN -1
              WHEN `a fine in the discretion of the court` THEN -3
              WHEN `a fine of` d THEN d)
        ELSE `t sfine` rest

GIVEN ps IS A LIST OF Punishment
GIVETH A BOOLEAN
`t slad` MEANS
    CONSIDER ps
    WHEN EMPTY THEN FALSE
    WHEN p FOLLOWED BY rest THEN
        IF p's `mode` EQUALS `on summary conviction`
        THEN (CONSIDER p's `maximum imprisonment`
              WHEN `imprisonment for a term of` l THEN l's `less a day`
              OTHERWISE FALSE)
        ELSE `t slad` rest

GIVEN ps IS A LIST OF Punishment
GIVETH A NUMBER
`t sminfine` MEANS
    CONSIDER ps
    WHEN EMPTY THEN -1
    WHEN p FOLLOWED BY rest THEN
        IF p's `mode` EQUALS `by indictment`
        THEN (CONSIDER p's `minimum fine`
              WHEN `a fine of` d THEN d
              OTHERWISE -1)
        ELSE `t sminfine` rest

GIVEN ps IS A LIST OF Punishment
GIVETH A NUMBER
`t smin` MEANS
    CONSIDER ps
    WHEN EMPTY THEN -1
    WHEN p FOLLOWED BY rest THEN
        IF p's `mode` EQUALS `on summary conviction`
        THEN `t years of` (p's `minimum imprisonment`)
        ELSE `t smin` rest

GIVEN m IS A MAYBE (LIST OF Punishment)
GIVETH A NUMBER
`t iminm` MEANS
    CONSIDER m
    WHEN NOTHING THEN -2
    WHEN JUST ps THEN `t imin` ps

GIVEN m IS A MAYBE (LIST OF Punishment)
GIVETH A NUMBER
`t sminm` MEANS
    CONSIDER m
    WHEN NOTHING THEN -2
    WHEN JUST ps THEN `t smin` ps

GIVEN m IS A MAYBE (LIST OF Punishment)
GIVETH A NUMBER
`t sminfinem` MEANS
    CONSIDER m
    WHEN NOTHING THEN -2
    WHEN JUST ps THEN `t sminfine` ps

GIVEN m IS A MAYBE (LIST OF Punishment)
GIVETH A NUMBER
`t smaxm` MEANS
    CONSIDER m
    WHEN NOTHING THEN -2
    WHEN JUST ps THEN `t smax` ps

GIVEN m IS A MAYBE (`s 462.37(4) band`)
GIVETH A NUMBER
`t bmin` MEANS
    CONSIDER m
    WHEN NOTHING THEN -2
    WHEN JUST b THEN `t years of` (b's `minimum`)

GIVEN m IS A MAYBE (`s 462.37(4) band`)
GIVETH A NUMBER
`t bmax` MEANS
    CONSIDER m
    WHEN NOTHING THEN -2
    WHEN JUST b THEN `t years of` (b's `maximum`)

GIVEN y IS A NUMBER
GIVETH A Punishment
`t pind` MEANS Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF y, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

`t pindlife` MEANS Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

GIVEN m IS A MAYBE (LIST OF Punishment)
GIVETH A BOOLEAN
`t hasindm` MEANS
    CONSIDER m
    WHEN NOTHING THEN FALSE
    WHEN JUST ps THEN `t hasind` ps

GIVEN sec IS A NUMBER
      sub IS A STRING
      how IS A `s 487.04 how the person is charged`
      pur IS A `s 487.04 the purpose the answer is wanted for`
      mb IS A BOOLEAN
      pi IS A BOOLEAN
      mx IS AN Imprisonment
GIVETH A `s 487.04 facts of the offence`
`t dfact` MEANS `s 487.04 facts of the offence` OF (`Provision of the Code` OF sec, sub), `s 487.04 this Act as it reads now`, how, pur, mb, pi, mx, FALSE

GIVEN ps IS A LIST OF Punishment
GIVETH A NUMBER
`t ifine` MEANS
    CONSIDER ps
    WHEN EMPTY THEN -1
    WHEN p FOLLOWED BY rest THEN
        IF p's `mode` EQUALS `by indictment`
        THEN (CONSIDER p's `maximum fine`
              WHEN `no fine is stated` THEN -1
              WHEN `a fine in the discretion of the court` THEN -3
              WHEN `a fine of` d THEN d)
        ELSE `t ifine` rest

GIVEN y IS A NUMBER
GIVETH AN Imprisonment
`t imp` MEANS `imprisonment for a term of` (`Length of time` OF y, 0, 0, FALSE)

GIVEN a IS A `s 380 to 447.1 answer about an offence`
GIVETH A MAYBE BOOLEAN
`t whether13` MEANS a's `s 380 to 447.1 whether what I did is the offence`

