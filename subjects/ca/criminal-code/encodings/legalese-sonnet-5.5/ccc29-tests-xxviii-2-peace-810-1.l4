IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc29-xxviii-2-peace-810-1`

-- ccc29-tests-xxviii-2-peace-810-1.l4 -- tests for sections 810.1 and 810.2 of the Criminal Code (Canada).
-- Every expected value is written from the text before the run, beside its assertion. Argument order is the GIVEN order of each function.

§ `Tests -- section 810.1`

-- 810.1(1): the feared offence is one of those listed: whole sections 151, 152, 155, 163.1, 170, 171, 171.1, 172.1, 172.2, 271, 272, 273, 279.011, 280, 281; subsections 153(1), 160(2) and (3), 173(2), 279.02(2), 279.03(2), 286.1(2), 286.2(2), 286.3(2).
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 151, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 152, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 155, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 163.1, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 170, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 171, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 171.1, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 172.1, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 172.2, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 271, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 272, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 273, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 279.011, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 280, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 281, "") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 153, "(1)") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 160, "(2)") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 160, "(3)") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 173, "(2)") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 279.02, "(2)") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 279.03, "(2)") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 286.1, "(2)") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 286.2, "(2)") EQUALS JUST TRUE
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 286.3, "(2)") EQUALS JUST TRUE
-- not listed: 153(2) (only 153(1) is named), 160(1), 173(1), 279.02(1), 286.1(1), a section not named, and the neighbours of each named section.
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 153, "(2)") EQUALS NOTHING
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 160, "(1)") EQUALS NOTHING
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 173, "(1)") EQUALS NOTHING
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 279.02, "(1)") EQUALS NOTHING
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 286.1, "(1)") EQUALS NOTHING
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 153, "") EQUALS NOTHING
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 150, "") EQUALS NOTHING
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 156, "") EQUALS NOTHING
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 274, "") EQUALS NOTHING
#ASSERT `s 810.1(1) the feared offence is one of those listed` (`Provision of the Code` OF 322, "") EQUALS NOTHING
-- who may lay an information: (fears on reasonable grounds, the offence is one of those listed (an s 810.1(1) answer), in respect of persons under 18).
#ASSERT `s 810.1(1) the person may lay an information before a provincial court judge` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(1) the person may lay an information before a provincial court judge` FALSE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 810.1(1) the person may lay an information before a provincial court judge` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 810.1(1) the person may lay an information before a provincial court judge` TRUE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 810.1(2) the provincial court judge may cause the parties to appear` TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(2) the provincial court judge may cause the parties to appear` FALSE EQUALS NOTHING
#ASSERT `s 810.1(3) the provincial court judge may order that the defendant enter into a recognizance` TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(3) the provincial court judge may order that the defendant enter into a recognizance` FALSE EQUALS NOTHING
#ASSERT `s 810.1(3) the period of the recognizance does not exceed 12 months` 12 EQUALS JUST TRUE
#ASSERT `s 810.1(3) the period of the recognizance does not exceed 12 months` 13 EQUALS JUST FALSE
#ASSERT `s 810.1(3.01) the provincial court judge may order that the defendant enter into the recognizance for a longer period` TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(3.01) the provincial court judge may order that the defendant enter into the recognizance for a longer period` FALSE EQUALS NOTHING
#ASSERT `s 810.1(3.01) the longer period of the recognizance is not more than two years` 24 EQUALS JUST TRUE
#ASSERT `s 810.1(3.01) the longer period of the recognizance is not more than two years` 25 EQUALS JUST FALSE
-- 810.1(3.02): (the condition, reasonable, considered desirable, the Attorney General makes the request).
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02)(a) to prohibit any contact with a person under the age of 18 years, unless under the supervision of a person whom the judge considers appropriate` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02)(a.1) to prohibit the use of the Internet or other digital network, unless in accordance with conditions set by the judge` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02)(b) to prohibit attending a public park or public swimming area where persons under 18 are present or a daycare centre, schoolground or playground` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02)(b.1) to prohibit communicating with any person identified in the recognizance, or going to any place specified in it` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02)(c) to require the defendant to participate in a treatment program` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02)(d) to require the defendant to wear an electronic monitoring device` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02)(d) to require the defendant to wear an electronic monitoring device` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02)(e) to require the defendant to remain within a specified geographic area unless written permission to leave that area is obtained from the provincial court judge` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02)(f) to require the defendant to return to and remain at their place of residence at specified times` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02)(g) to require the defendant to abstain from the consumption of drugs except in accordance with a medical prescription, of alcohol or of any other intoxicating substance` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02)(h) to require the defendant to provide a sample of a bodily substance on demand` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02)(i) to require the defendant to provide a sample of a bodily substance at regular intervals specified in a notice in Form 51` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02) another reasonable condition` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.1(3.02) the provincial court judge may add the condition to the recognizance` `s 810.1(3.02) another reasonable condition` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 810.1(3.03) the provincial court judge is required to consider whether a firearms prohibition is desirable` TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(3.03) the provincial court judge is required to consider whether a firearms prohibition is desirable` FALSE EQUALS NOTHING
#ASSERT `s 810.1(3.03) the provincial court judge is required to add the firearms condition and specify the period during which it applies` TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(3.03) the provincial court judge is required to add the firearms condition and specify the period during which it applies` FALSE EQUALS JUST FALSE
#ASSERT `s 810.1(3.04) the provincial court judge is required to specify in the recognizance how the things and authorizations are to be surrendered` TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(3.04) the provincial court judge is required to specify in the recognizance how the things and authorizations are to be surrendered` FALSE EQUALS JUST FALSE
#ASSERT `s 810.1(3.05) the provincial court judge is required to consider whether a reporting condition is desirable` TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(3.05) the provincial court judge is required to consider whether a reporting condition is desirable` FALSE EQUALS NOTHING
#ASSERT `s 810.1(3.05) the provincial court judge is required to add the reporting condition` TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(3.05) the provincial court judge is required to add the reporting condition` FALSE EQUALS JUST FALSE
#ASSERT `s 810.1(3.1) the provincial court judge may commit the defendant to prison` TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(3.1) the provincial court judge may commit the defendant to prison` FALSE EQUALS NOTHING
#ASSERT `s 810.1(3.1) the term of imprisonment does not exceed twelve months` 12 EQUALS JUST TRUE
#ASSERT `s 810.1(3.1) the term of imprisonment does not exceed twelve months` 13 EQUALS JUST FALSE
#ASSERT `s 810.1(4) the provincial court judge may vary the conditions fixed in the recognizance` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.1(4) the provincial court judge may vary the conditions fixed in the recognizance` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(4) the provincial court judge may vary the conditions fixed in the recognizance` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 810.1(5) subsections 810(4) and (5) apply to the recognizance` TRUE EQUALS JUST TRUE
#ASSERT `s 810.1(5) subsections 810(4) and (5) apply to the recognizance` FALSE EQUALS NOTHING

§ `Tests -- section 810.2`

#ASSERT `s 810.2(1) the person may lay an information before a provincial court judge` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(1) the person may lay an information before a provincial court judge` TRUE FALSE EQUALS NOTHING
#ASSERT `s 810.2(1) the person may lay an information before a provincial court judge` FALSE TRUE EQUALS NOTHING
#ASSERT `s 810.2(2) the provincial court judge may cause the parties to appear` TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(2) the provincial court judge may cause the parties to appear` FALSE EQUALS NOTHING
#ASSERT `s 810.2(3) the provincial court judge may order that the defendant enter into a recognizance` TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(3) the provincial court judge may order that the defendant enter into a recognizance` FALSE EQUALS NOTHING
#ASSERT `s 810.2(3) the period of the recognizance does not exceed 12 months` 12 EQUALS JUST TRUE
#ASSERT `s 810.2(3) the period of the recognizance does not exceed 12 months` 13 EQUALS JUST FALSE
#ASSERT `s 810.2(3.1) the provincial court judge may order that the defendant enter into the recognizance for a longer period` TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(3.1) the provincial court judge may order that the defendant enter into the recognizance for a longer period` FALSE EQUALS NOTHING
#ASSERT `s 810.2(3.1) the longer period of the recognizance does not exceed two years` 24 EQUALS JUST TRUE
#ASSERT `s 810.2(3.1) the longer period of the recognizance does not exceed two years` 25 EQUALS JUST FALSE
#ASSERT `s 810.2(4) the provincial court judge may commit the defendant to prison` TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(4) the provincial court judge may commit the defendant to prison` FALSE EQUALS NOTHING
#ASSERT `s 810.2(4) the term of imprisonment does not exceed twelve months` 12 EQUALS JUST TRUE
#ASSERT `s 810.2(4) the term of imprisonment does not exceed twelve months` 13 EQUALS JUST FALSE
#ASSERT `s 810.2(4.1) the provincial court judge may add the condition to the recognizance` `s 810.2(4.1)(a) to participate in a treatment program` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.2(4.1) the provincial court judge may add the condition to the recognizance` `s 810.2(4.1)(b) to wear an electronic monitoring device` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(4.1) the provincial court judge may add the condition to the recognizance` `s 810.2(4.1)(b) to wear an electronic monitoring device` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 810.2(4.1) the provincial court judge may add the condition to the recognizance` `s 810.2(4.1)(c) to remain within a specified geographic area unless written permission to leave that area is obtained from the provincial court judge` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.2(4.1) the provincial court judge may add the condition to the recognizance` `s 810.2(4.1)(d) to return to and remain at their place of residence at specified times` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.2(4.1) the provincial court judge may add the condition to the recognizance` `s 810.2(4.1)(e) to abstain from the consumption of drugs except in accordance with a medical prescription, of alcohol or of any other intoxicating substance` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.2(4.1) the provincial court judge may add the condition to the recognizance` `s 810.2(4.1)(f) to provide a sample of a bodily substance on demand` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.2(4.1) the provincial court judge may add the condition to the recognizance` `s 810.2(4.1)(g) to provide a sample of a bodily substance at regular intervals specified in a notice in Form 51` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.2(4.1) the provincial court judge may add the condition to the recognizance` `s 810.2(4.1) another reasonable condition` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 810.2(5) the provincial court judge is required to consider whether a firearms prohibition is desirable` TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(5) the provincial court judge is required to consider whether a firearms prohibition is desirable` FALSE EQUALS NOTHING
#ASSERT `s 810.2(5) the provincial court judge is required to add the firearms condition and specify the period during which it applies` TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(5) the provincial court judge is required to add the firearms condition and specify the period during which it applies` FALSE EQUALS JUST FALSE
#ASSERT `s 810.2(5.1) the provincial court judge is required to specify in the recognizance how the things and authorizations are to be surrendered` TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(5.1) the provincial court judge is required to specify in the recognizance how the things and authorizations are to be surrendered` FALSE EQUALS JUST FALSE
#ASSERT `s 810.2(5.2) the provincial court judge is required to include in the record a statement of the reasons for not adding the condition` TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(5.2) the provincial court judge is required to include in the record a statement of the reasons for not adding the condition` FALSE EQUALS JUST FALSE
#ASSERT `s 810.2(6) the provincial court judge is required to consider whether a reporting condition is desirable` TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(6) the provincial court judge is required to consider whether a reporting condition is desirable` FALSE EQUALS NOTHING
#ASSERT `s 810.2(6) the provincial court judge is required to add the reporting condition` TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(6) the provincial court judge is required to add the reporting condition` FALSE EQUALS JUST FALSE
#ASSERT `s 810.2(7) the provincial court judge may vary the conditions fixed in the recognizance` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 810.2(7) the provincial court judge may vary the conditions fixed in the recognizance` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.2(7) the provincial court judge may vary the conditions fixed in the recognizance` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(7) the provincial court judge may vary the conditions fixed in the recognizance` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 810.2(8) subsections 810(4) and (5) apply to the recognizance` TRUE EQUALS JUST TRUE
#ASSERT `s 810.2(8) subsections 810(4) and (5) apply to the recognizance` FALSE EQUALS NOTHING

§ `Regulative rules -- sections 810.1 and 810.2`

#TRACE `s 810.1(3.03) the judge is to consider the firearms condition` AT 0 WITH
    PARTY `a provincial court judge` DOES `s 810.1(3.03) consider the firearms condition` AT 1
    PARTY `a provincial court judge` DOES `s 810.1(3.03) add the firearms condition and specify the period` AT 2
#TRACE `s 810.1(3.04) the judge is to specify how the things and authorizations are to be surrendered` AT 0 WITH
    PARTY `a provincial court judge` DOES `s 810.1(3.04) specify how the things and authorizations are to be surrendered` AT 1
#TRACE `s 810.1(3.05) the judge is to consider the reporting condition` AT 0 WITH
    PARTY `a provincial court judge` DOES `s 810.1(3.05) consider the reporting condition` AT 1
    PARTY `a provincial court judge` DOES `s 810.1(3.05) add the reporting condition` AT 2
#TRACE `s 810.2(5) the judge is to consider the firearms condition` AT 0 WITH
    PARTY `a provincial court judge` DOES `s 810.2(5) consider the firearms condition` AT 1
    PARTY `a provincial court judge` DOES `s 810.2(5) add the firearms condition and specify the period` AT 2
#TRACE `s 810.2(5.1) the judge is to specify how the things and authorizations are to be surrendered` AT 0 WITH
    PARTY `a provincial court judge` DOES `s 810.2(5.1) specify how the things and authorizations are to be surrendered` AT 1
#TRACE `s 810.2(5.2) the judge is to include a statement of reasons in the record` AT 0 WITH
    PARTY `a provincial court judge` DOES `s 810.2(5.2) include a statement of reasons in the record` AT 1
#TRACE `s 810.2(6) the judge is to consider the reporting condition` AT 0 WITH
    PARTY `a provincial court judge` DOES `s 810.2(6) consider the reporting condition` AT 1
    PARTY `a provincial court judge` DOES `s 810.2(6) add the reporting condition` AT 2
