IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc23-hearings`

-- ccc23-tests-hearings.l4 -- tests for sections 672.45 to 672.49. Expected values are written from the text, never copied from the code.

§ `s 672.45`
-- (1) own motion: args = a verdict of NCR or unfit is rendered
#ASSERT `s 672.45(1) the court may of its own motion hold a disposition hearing` TRUE EQUALS JUST TRUE
#ASSERT `s 672.45(1) the court may of its own motion hold a disposition hearing` FALSE EQUALS JUST FALSE
-- (1) on application: args = verdict rendered; the accused or the prosecutor applies
#ASSERT `s 672.45(1) the court must hold a disposition hearing on application` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.45(1) the court must hold a disposition hearing on application` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.45(1) the court must hold a disposition hearing on application` FALSE TRUE EQUALS JUST FALSE
-- (1.1) args: no hearing under (1); in its possession
#ASSERT `s 672.45(1.1) the court must send the transcript, documents and exhibits to the Review Board without delay` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.45(1.1) the court must send the transcript, documents and exhibits to the Review Board without delay` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.45(1.1) the court must send the transcript, documents and exhibits to the Review Board without delay` FALSE TRUE EQUALS JUST FALSE
-- (2) args: can readily do so; should be made without delay
#ASSERT `s 672.45(2) the court must make a disposition at the hearing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.45(2) the court must make a disposition at the hearing` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.45(2) the court must make a disposition at the hearing` FALSE TRUE EQUALS JUST FALSE

§ `s 672.46`
-- (1) args: the court makes no disposition at the hearing; the order is in force at the verdict; the Review Board has made a disposition
#ASSERT `s 672.46(1) the order, release order, appearance notice, summons or undertaking continues in force` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.46(1) the order, release order, appearance notice, summons or undertaking continues in force` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.46(1) the order, release order, appearance notice, summons or undertaking continues in force` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.46(1) the order, release order, appearance notice, summons or undertaking continues in force` TRUE FALSE FALSE EQUALS JUST FALSE
-- (2) args: the Review Board has not yet made a disposition; cause is shown
#ASSERT `s 672.46(2) the court may vacate the order and make another order for detention or release` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.46(2) the court may vacate the order and make another order for detention or release` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.46(2) the court may vacate the order and make another order for detention or release` FALSE TRUE EQUALS JUST FALSE

§ `s 672.47`
-- (2) args: satisfied of exceptional circumstances; days after the verdict to which the time is extended (maximum 90)
#ASSERT `s 672.47(2) the court may extend the time for holding the hearing` TRUE 90 EQUALS JUST TRUE
#ASSERT `s 672.47(2) the court may extend the time for holding the hearing` TRUE 91 EQUALS JUST FALSE
#ASSERT `s 672.47(2) the court may extend the time for holding the hearing` FALSE 60 EQUALS JUST FALSE
-- (1) as a function: verdict 1 March 2026; 45 days later is 15 April 2026; 90 days later is 30 May 2026. args: verdict; hearing; extended under (2)
#ASSERT `s 672.47(1) the Review Board has held the hearing in time` (Date 1 3 2026) (Date 15 4 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 672.47(1) the Review Board has held the hearing in time` (Date 1 3 2026) (Date 16 4 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 672.47(1) the Review Board has held the hearing in time` (Date 1 3 2026) (Date 30 5 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 672.47(1) the Review Board has held the hearing in time` (Date 1 3 2026) (Date 31 5 2026) TRUE EQUALS JUST FALSE
-- (3) args: the court makes a disposition other than an absolute discharge; day of the court's disposition; day of the Review Board's hearing. 90 days after 1 March 2026 is 30 May 2026.
#ASSERT `s 672.47(3) the Review Board has held the hearing within ninety days after the court’s disposition` TRUE (Date 1 3 2026) (Date 30 5 2026) EQUALS JUST TRUE
#ASSERT `s 672.47(3) the Review Board has held the hearing within ninety days after the court’s disposition` TRUE (Date 1 3 2026) (Date 31 5 2026) EQUALS JUST FALSE
-- an absolute discharge: the subsection does not speak
#ASSERT `s 672.47(3) the Review Board has held the hearing within ninety days after the court’s disposition` FALSE (Date 1 3 2026) (Date 31 5 2026) EQUALS NOTHING
-- (4) args: disposition under 672.64(3); day of the disposition; day of the hearing; extended under (5)
#ASSERT `s 672.47(4) the Review Board has held the hearing within forty-five days after the court’s high-risk disposition` TRUE (Date 1 3 2026) (Date 15 4 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 672.47(4) the Review Board has held the hearing within forty-five days after the court’s high-risk disposition` TRUE (Date 1 3 2026) (Date 16 4 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 672.47(4) the Review Board has held the hearing within forty-five days after the court’s high-risk disposition` TRUE (Date 1 3 2026) (Date 30 5 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 672.47(4) the Review Board has held the hearing within forty-five days after the court’s high-risk disposition` FALSE (Date 1 3 2026) (Date 16 4 2026) FALSE EQUALS NOTHING
-- (5) args: satisfied; days after the disposition to which the time is extended (maximum 90)
#ASSERT `s 672.47(5) the court may extend the time for holding the hearing` TRUE 90 EQUALS JUST TRUE
#ASSERT `s 672.47(5) the court may extend the time for holding the hearing` TRUE 91 EQUALS JUST FALSE
#ASSERT `s 672.47(5) the court may extend the time for holding the hearing` FALSE 60 EQUALS NOTHING   -- RECONCILED 2026-11-12: was `... FALSE 60 EQUALS JUST FALSE`; the failed "If the court is satisfied" gate of a function named for a power answers NOTHING (name-test sweep, fork F-GRANT-IF)
#ASSERT `s 672.47(5) the court may extend the time for holding the hearing` FALSE 91 EQUALS JUST FALSE
-- the three regulative rules: a hearing on day 45 is in time (FULFILLED); the clock passes day 46 -> BREACH
#TRACE `s 672.47(1) the Review Board must hold a hearing within forty-five days after the verdict` AT 0 WITH
    PARTY `a Review Board` DOES `s 672.47 hold a hearing and make a disposition` AT 45
#TRACE `s 672.47(1) the Review Board must hold a hearing within forty-five days after the verdict` AT 0 WITH
    (WAITUNTIL 46)
#TRACE `s 672.47(3) the Review Board must hold a hearing within ninety days after the court’s disposition` AT 0 WITH
    PARTY `a Review Board` DOES `s 672.47 hold a hearing and make a disposition` AT 90
#TRACE `s 672.47(3) the Review Board must hold a hearing within ninety days after the court’s disposition` AT 0 WITH
    (WAITUNTIL 91)
#TRACE `s 672.47(4) the Review Board must hold a hearing within forty-five days after the court’s high-risk disposition` AT 0 WITH
    PARTY `a Review Board` DOES `s 672.47 hold a hearing and make a disposition` AT 45
#TRACE `s 672.47(4) the Review Board must hold a hearing within forty-five days after the court’s high-risk disposition` AT 0 WITH
    (WAITUNTIL 46)

§ `ss 672.48 and 672.49`
-- 672.48(1) args: a Review Board holds a hearing; found unfit
#ASSERT `s 672.48(1) the Review Board must determine whether the accused is fit to stand trial at the time of the hearing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.48(1) the Review Board must determine whether the accused is fit to stand trial at the time of the hearing` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.48(1) the Review Board must determine whether the accused is fit to stand trial at the time of the hearing` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.48(2) the Review Board must order that the accused be sent back to court` TRUE EQUALS JUST TRUE
#ASSERT `s 672.48(2) the Review Board must order that the accused be sent back to court` FALSE EQUALS JUST FALSE
-- 672.48(3) args: the accused consents; the person in charge of the hospital consents; opinion (a); opinion (b)
#ASSERT `s 672.48(3) the chairperson may order that the accused be sent back to court for trial of the issue` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.48(3) the chairperson may order that the accused be sent back to court for trial of the issue` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.48(3) the chairperson may order that the accused be sent back to court for trial of the issue` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.48(3) the chairperson may order that the accused be sent back to court for trial of the issue` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.48(3) the chairperson may order that the accused be sent back to court for trial of the issue` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- 672.49(1) args: a disposition made pursuant to 672.47; reasonable grounds to believe the accused would become unfit if released
#ASSERT `s 672.49(1) the Review Board or chairperson may require the accused to continue to be detained in a hospital` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.49(1) the Review Board or chairperson may require the accused to continue to be detained in a hospital` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.49(1) the Review Board or chairperson may require the accused to continue to be detained in a hospital` FALSE TRUE EQUALS NOTHING
#ASSERT `s 672.49(2) the Review Board or chairperson must send a copy of the disposition to the court and the Attorney General without delay` TRUE EQUALS JUST TRUE
#ASSERT `s 672.49(2) the Review Board or chairperson must send a copy of the disposition to the court and the Attorney General without delay` FALSE EQUALS JUST FALSE
