IMPORT prelude
IMPORT `ccc13-logic`

-- ccc13-tests-logic.l4 -- tests of the three helpers. Expected values are Kleene's three-valued rules, written by hand.

§ `ccc13 all of`
#ASSERT `ccc13 all of` (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `ccc13 all of` (LIST JUST TRUE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `ccc13 all of` (LIST JUST FALSE, NOTHING) EQUALS JUST FALSE
#ASSERT `ccc13 all of` (LIST NOTHING, JUST FALSE) EQUALS JUST FALSE
#ASSERT `ccc13 all of` (LIST JUST TRUE, NOTHING) EQUALS NOTHING
#ASSERT `ccc13 all of` (LIST NOTHING, NOTHING) EQUALS NOTHING
#ASSERT `ccc13 all of` (LIST JUST TRUE) EQUALS JUST TRUE

§ `ccc13 any of`
#ASSERT `ccc13 any of` (LIST JUST FALSE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `ccc13 any of` (LIST JUST FALSE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `ccc13 any of` (LIST NOTHING, JUST TRUE) EQUALS JUST TRUE
#ASSERT `ccc13 any of` (LIST JUST TRUE, NOTHING) EQUALS JUST TRUE
#ASSERT `ccc13 any of` (LIST JUST FALSE, NOTHING) EQUALS NOTHING
#ASSERT `ccc13 any of` (LIST NOTHING) EQUALS NOTHING

§ `ccc13 not`
#ASSERT `ccc13 not` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `ccc13 not` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `ccc13 not` NOTHING EQUALS NOTHING
