#ASSERT `s 207.1(4) lottery scheme` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 207.1(4) lottery scheme` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 207.1(4) lottery scheme` FALSE FALSE FALSE EQUALS JUST FALSE
