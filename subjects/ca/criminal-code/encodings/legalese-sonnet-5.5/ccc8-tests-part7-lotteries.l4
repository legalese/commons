-- (2) "For greater certainty, paragraph 207(1)(h) and subsection 207(5) apply for the purposes of this section."
#ASSERT `s 207.1(2) paragraph 207(1)(h) and subsection 207(5) apply` TRUE EQUALS JUST TRUE
#ASSERT `s 207.1(2) paragraph 207(1)(h) and subsection 207(5) apply` FALSE EQUALS NOTHING
-- (3) offence, as in section 207(3)
#ASSERT `s 207.1(3) the person commits the offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 207.1(3) the person commits the offence` TRUE TRUE EQUALS NOTHING
#ASSERT `s 207.1(3) the person commits the offence` FALSE FALSE EQUALS NOTHING
#ASSERT `s 207.1(3) the class of the offence` `s 207.1(3)(a) the person conducts, manages or operates the lottery scheme` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 207.1(3) the class of the offence` `s 207.1(3)(b) the person participates in the lottery scheme` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 207.1(3) the punishment` `s 207.1(3)(a) the person conducts, manages or operates the lottery scheme` `s 206(1) test fixture: a stand-in for the section 787(1) penalty` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 2, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), `s 206(1) test fixture: a stand-in for the section 787(1) penalty`
#ASSERT `s 207.1(3) the punishment` `s 207.1(3)(b) the person participates in the lottery scheme` `s 206(1) test fixture: a stand-in for the section 787(1) penalty` EQUALS LIST `s 206(1) test fixture: a stand-in for the section 787(1) penalty`

§ `Sections 209 and 213`

-- 209 "Every person who, with intent to defraud any person, cheats while playing a game or in holding the stakes for a game or in betting is guilty of (a) an indictable offence ... two years; or (b) an offence punishable on summary conviction"
#ASSERT `s 209 the person commits the offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 209 the person commits the offence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 209 the person commits the offence` FALSE TRUE EQUALS NOTHING
#ASSERT `s 209 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 209 the punishment` `s 206(1) test fixture: a stand-in for the section 787(1) penalty` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 2, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), `s 206(1) test fixture: a stand-in for the section 787(1) penalty`
-- 213(2) "public place includes any place to which the public have access as of right or by invitation, express or implied, and any motor vehicle located in a public place or in any place open to public view"
#ASSERT `s 213(2) public place` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 213(2) public place` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 213(2) public place` FALSE FALSE EQUALS NOTHING
-- 213(1) "Everyone is guilty of an offence punishable on summary conviction who, in a public place or in any place open to public view, for the purpose of offering, providing or obtaining sexual services for consideration, (a) stops or attempts to stop any motor vehicle; or (b) impedes the free flow of pedestrian or vehicular traffic"
#ASSERT `s 213(1) the person commits the offence` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 213(1) the person commits the offence` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 213(1) the person commits the offence` (JUST TRUE) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 213(1) the person commits the offence` (JUST TRUE) FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 213(1) the person commits the offence` NOTHING TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 213(1) the person commits the offence` (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 213(1) the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 213(1) the punishment` `s 206(1) test fixture: a stand-in for the section 787(1) penalty` EQUALS LIST `s 206(1) test fixture: a stand-in for the section 787(1) penalty`
-- 213(1.1) "communicates with any person — for the purpose of offering or providing sexual services for consideration — in a public place, or in any place open to public view, that is or is next to a school ground, playground or daycare centre"
#ASSERT `s 213(1.1) the person commits the offence` TRUE TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 213(1.1) the person commits the offence` FALSE TRUE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 213(1.1) the person commits the offence` TRUE FALSE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 213(1.1) the person commits the offence` TRUE TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 213(1.1) the person commits the offence` TRUE TRUE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 213(1.1) the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 213(1.1) the punishment` `s 206(1) test fixture: a stand-in for the section 787(1) penalty` EQUALS LIST `s 206(1) test fixture: a stand-in for the section 787(1) penalty`
