IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc2-riots`

-- ccc2-tests-riots.l4 -- tests for ccc2-riots.l4 (ss 63 to 69). Expected values are written beside each assertion from the text of the provision,
-- before the run. The s 787(1) penalty is a seam input: the tests pass a placeholder that states nothing.

§ `Tests -- section 63(1), unlawful assembly (lines 1060-1063)`

--                                                   persons intent manner reasonable fear (a) fear (b)
#ASSERT `s 63(1) the assembly is an unlawful assembly` 3   TRUE TRUE TRUE TRUE  FALSE EQUALS JUST TRUE   -- three persons: "three or more"
#ASSERT `s 63(1) the assembly is an unlawful assembly` 3   TRUE TRUE TRUE FALSE TRUE  EQUALS JUST TRUE   -- the (b) fear
#ASSERT `s 63(1) the assembly is an unlawful assembly` 100 TRUE TRUE TRUE TRUE  FALSE EQUALS JUST TRUE
#ASSERT `s 63(1) the assembly is an unlawful assembly` 2   TRUE TRUE TRUE TRUE  FALSE EQUALS JUST FALSE  -- two persons
#ASSERT `s 63(1) the assembly is an unlawful assembly` 3   FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE  -- no common purpose
#ASSERT `s 63(1) the assembly is an unlawful assembly` 3   TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE  -- no such manner or conduct
#ASSERT `s 63(1) the assembly is an unlawful assembly` 3   TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE  -- the fear is not on reasonable grounds
#ASSERT `s 63(1) the assembly is an unlawful assembly` 3   TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE  -- neither fear (a) nor fear (b)

§ `Tests -- section 63(2) and (3) (lines 1064-1067)`

--                                                                            lawfully assembled  common purpose  (1) answer
#ASSERT `s 63(2) persons who are lawfully assembled may become an unlawful assembly` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 63(2) persons who are lawfully assembled may become an unlawful assembly` FALSE TRUE (JUST TRUE) EQUALS NOTHING   -- not lawfully assembled to begin with
#ASSERT `s 63(2) persons who are lawfully assembled may become an unlawful assembly` TRUE FALSE (JUST TRUE) EQUALS NOTHING   -- the "if" gate fails: a "may" function answers NOTHING (fork F9)
#ASSERT `s 63(2) persons who are lawfully assembled may become an unlawful assembly` TRUE TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 63(2) persons who are lawfully assembled may become an unlawful assembly` TRUE TRUE NOTHING EQUALS NOTHING
--                                                                                                                      protect  dwelling answer  threatening  only reason
#ASSERT `s 63(3) the persons are unlawfully assembled by reason only that they are assembled to protect a dwelling-house` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 63(3) the persons are unlawfully assembled by reason only that they are assembled to protect a dwelling-house` FALSE (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 63(3) the persons are unlawfully assembled by reason only that they are assembled to protect a dwelling-house` TRUE NOTHING TRUE TRUE EQUALS NOTHING   -- s 2 "dwelling-house" leaves it open
#ASSERT `s 63(3) the persons are unlawfully assembled by reason only that they are assembled to protect a dwelling-house` TRUE (JUST FALSE) TRUE TRUE EQUALS NOTHING   -- not a dwelling-house: the subsection does not speak
#ASSERT `s 63(3) the persons are unlawfully assembled by reason only that they are assembled to protect a dwelling-house` TRUE (JUST TRUE) FALSE TRUE EQUALS NOTHING   -- no threat to break and enter
#ASSERT `s 63(3) the persons are unlawfully assembled by reason only that they are assembled to protect a dwelling-house` TRUE (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- not the only reason
-- the three together: (3) prevails; (1) makes it; (2) adds no criteria of its own.
--                                          persons intent manner reas. fearA fearB lawful common protect dwelling       threat only
#ASSERT `s 63 the persons are unlawfully assembled` 5 TRUE  TRUE  TRUE  TRUE  FALSE FALSE FALSE FALSE NOTHING     FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 63 the persons are unlawfully assembled` 5 TRUE  TRUE  TRUE  TRUE  FALSE FALSE FALSE TRUE  (JUST TRUE) TRUE  TRUE  EQUALS JUST FALSE   -- subsection (3) applies
#ASSERT `s 63 the persons are unlawfully assembled` 5 FALSE FALSE FALSE FALSE FALSE TRUE  TRUE  FALSE NOTHING     FALSE FALSE EQUALS JUST FALSE   -- not unlawful by (1); (2) does not reach it
#ASSERT `s 63 the persons are unlawfully assembled` 2 TRUE  TRUE  TRUE  TRUE  FALSE FALSE FALSE FALSE NOTHING     FALSE FALSE EQUALS JUST FALSE   -- two persons
#ASSERT `s 63 the persons are unlawfully assembled` 5 TRUE  TRUE  TRUE  TRUE  FALSE TRUE  TRUE  FALSE NOTHING     FALSE FALSE EQUALS JUST TRUE    -- lawfully assembled persons who conduct themselves in that manner

§ `Tests -- section 64, riot (lines 1068-1069)`

#ASSERT `s 64 the unlawful assembly is a riot` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 64 the unlawful assembly is a riot` (JUST TRUE) FALSE EQUALS JUST FALSE   -- has not begun to disturb the peace tumultuously
#ASSERT `s 64 the unlawful assembly is a riot` (JUST FALSE) TRUE EQUALS JUST FALSE   -- not an unlawful assembly
#ASSERT `s 64 the unlawful assembly is a riot` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 64 the unlawful assembly is a riot` NOTHING FALSE EQUALS JUST FALSE

§ `Tests -- sections 65 and 66, punishment (lines 1070-1083)`

#ASSERT `s 65(1) the person takes part in a riot` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 65(1) the person takes part in a riot` FALSE (JUST TRUE) EQUALS NOTHING   -- does not take part
#ASSERT `s 65(1) the person takes part in a riot` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 65(1) the person takes part in a riot` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 65(1) the class of the offence of taking part in a riot` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 65(1) the punishment for taking part in a riot` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` `two years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
--                                                                                        (1) answer   mask  lawful excuse
#ASSERT `s 65(2) the person commits an offence under subsection 65(1) while wearing a mask or other disguise` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 65(2) the person commits an offence under subsection 65(1) while wearing a mask or other disguise` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 65(2) the person commits an offence under subsection 65(1) while wearing a mask or other disguise` (JUST TRUE) TRUE TRUE EQUALS NOTHING   -- with lawful excuse
#ASSERT `s 65(2) the person commits an offence under subsection 65(1) while wearing a mask or other disguise` NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 65(2) the person commits an offence under subsection 65(1) while wearing a mask or other disguise` (JUST FALSE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 65(2) the class of the offence under subsection 65(2)` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 65(2) the punishment for an offence under subsection 65(2)` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` `ten years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 66(1) the person is a member of an unlawful assembly` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 66(1) the person is a member of an unlawful assembly` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 66(1) the person is a member of an unlawful assembly` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 66(1) the person is a member of an unlawful assembly` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 66(1) the class of the offence of being a member of an unlawful assembly` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 66(1) the punishment for being a member of an unlawful assembly` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 66(2) the person commits an offence under subsection 66(1) while wearing a mask or other disguise` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 66(2) the person commits an offence under subsection 66(1) while wearing a mask or other disguise` (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 66(2) the person commits an offence under subsection 66(1) while wearing a mask or other disguise` NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 66(2) the class of the offence under subsection 66(2)` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 66(2) the punishment for an offence under subsection 66(2)` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` `five years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)

§ `Tests -- section 67, reading proclamation (lines 1084-1090)`

--                                                       office                                                       notice  number the notice gives
#ASSERT `s 67 the person must go to that place` `s 67(a) a justice` TRUE 12 EQUALS JUST TRUE   -- "twelve or more persons"
#ASSERT `s 67 the person must go to that place` `s 67(a) a justice` TRUE 11 EQUALS NOTHING     -- eleven is not twelve or more
#ASSERT `s 67 the person must go to that place` `s 67(a) a justice` TRUE 40 EQUALS JUST TRUE
#ASSERT `s 67 the person must go to that place` `s 67(a) a mayor` TRUE 12 EQUALS JUST TRUE
#ASSERT `s 67 the person must go to that place` `s 67(a) a sheriff` TRUE 12 EQUALS JUST TRUE
#ASSERT `s 67 the person must go to that place` `s 67(a) the lawful deputy of a mayor or sheriff` TRUE 12 EQUALS JUST TRUE
#ASSERT `s 67 the person must go to that place` `s 67(b) a warden of a prison` TRUE 12 EQUALS JUST TRUE
#ASSERT `s 67 the person must go to that place` `s 67(b) a deputy warden of a prison` TRUE 12 EQUALS JUST TRUE
#ASSERT `s 67 the person must go to that place` `s 67(c) the institutional head of a penitentiary` TRUE 12 EQUALS JUST TRUE
#ASSERT `s 67 the person must go to that place` `s 67(c) the deputy of the institutional head of a penitentiary` TRUE 12 EQUALS JUST TRUE
#ASSERT `s 67 the person must go to that place` `s 67 another office` TRUE 12 EQUALS NOTHING   -- not one of the persons named
#ASSERT `s 67 the person must go to that place` `s 67(a) a justice` FALSE 12 EQUALS NOTHING   -- no notice received
--                                                                      office             notice number approached satisfied
#ASSERT `s 67 the person must command silence and make the proclamation` `s 67(a) a justice` TRUE 12 TRUE TRUE  EQUALS JUST TRUE
#ASSERT `s 67 the person must command silence and make the proclamation` `s 67(a) a justice` TRUE 12 TRUE FALSE EQUALS JUST FALSE   -- not satisfied that a riot is in progress: the "if" fails
#ASSERT `s 67 the person must command silence and make the proclamation` `s 67(a) a justice` TRUE 12 FALSE TRUE EQUALS NOTHING     -- has not yet approached as near as is safe
#ASSERT `s 67 the person must command silence and make the proclamation` `s 67(a) a justice` TRUE 11 TRUE TRUE  EQUALS NOTHING     -- the duty to go has not arisen
#ASSERT `s 67 the words of the proclamation` EQUALS "Her Majesty the Queen charges and commands all persons being assembled immediately to disperse and peaceably to depart to their habitations or to their lawful business on the pain of being guilty of an offence for which, on conviction, they may be sentenced to imprisonment for life. GOD SAVE THE QUEEN."
-- the duties as a regulative rule: going to the place and then proclaiming -> FULFILLED; going only -> the second duty stands; nothing -> breach on the first.
#TRACE `s 67 the duty of the person who receives notice` `s 67(a) a justice` AT 0 WITH
    PARTY `s 67(a) a justice` DOES `s 67 goes to that place` AT 1
    PARTY `s 67(a) a justice` DOES `s 67 commands silence and makes, or causes to be made, the proclamation` AT 2
#TRACE `s 67 the duty of the person who receives notice` `s 67(a) a justice` AT 0 WITH
    PARTY `s 67(a) a justice` DOES `s 67 goes to that place` AT 1

§ `Tests -- section 68, offences related to proclamation (lines 1091-1095)`

--                                                    act                                                                                                                                                                                     opposes notMade madeAtPlace grounds minutes
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68(a) opposes, hinders or assaults, wilfully and with force, a person who begins to make or is about to begin to make or is making the proclamation so that it is not made` TRUE TRUE FALSE FALSE 0 EQUALS JUST TRUE
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68(a) opposes, hinders or assaults, wilfully and with force, a person who begins to make or is about to begin to make or is making the proclamation so that it is not made` FALSE TRUE FALSE FALSE 0 EQUALS NOTHING
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68(a) opposes, hinders or assaults, wilfully and with force, a person who begins to make or is about to begin to make or is making the proclamation so that it is not made` TRUE FALSE FALSE FALSE 0 EQUALS NOTHING   -- the proclamation was made after all
-- (b): thirty minutes inclusive: at 30 the person is still within the period, at 31 the period is exceeded.
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68(b) does not peaceably disperse and depart from a place where the proclamation is made within thirty minutes after it is made` FALSE FALSE TRUE FALSE 30 EQUALS JUST FALSE
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68(b) does not peaceably disperse and depart from a place where the proclamation is made within thirty minutes after it is made` FALSE FALSE TRUE FALSE 31 EQUALS JUST TRUE
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68(b) does not peaceably disperse and depart from a place where the proclamation is made within thirty minutes after it is made` FALSE FALSE TRUE FALSE 29 EQUALS JUST FALSE
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68(b) does not peaceably disperse and depart from a place where the proclamation is made within thirty minutes after it is made` FALSE FALSE TRUE FALSE 0 EQUALS JUST FALSE
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68(b) does not peaceably disperse and depart from a place where the proclamation is made within thirty minutes after it is made` FALSE FALSE TRUE FALSE 120 EQUALS JUST TRUE
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68(b) does not peaceably disperse and depart from a place where the proclamation is made within thirty minutes after it is made` FALSE FALSE FALSE FALSE 120 EQUALS NOTHING   -- no proclamation was made at that place
-- (c): the same period, from the moment the person has the reasonable grounds.
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68(c) does not depart from a place within thirty minutes when he has reasonable grounds to believe that the proclamation would have been made in that place` FALSE FALSE FALSE TRUE 30 EQUALS JUST FALSE
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68(c) does not depart from a place within thirty minutes when he has reasonable grounds to believe that the proclamation would have been made in that place` FALSE FALSE FALSE TRUE 31 EQUALS JUST TRUE
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68(c) does not depart from a place within thirty minutes when he has reasonable grounds to believe that the proclamation would have been made in that place` FALSE FALSE FALSE FALSE 120 EQUALS NOTHING   -- no reasonable grounds
#ASSERT `s 68 the person commits an offence related to the proclamation` `s 68 an act that is none of those in paragraphs (a) to (c)` TRUE TRUE TRUE TRUE 120 EQUALS NOTHING
#ASSERT `s 68 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 68 the punishment` EQUALS LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
-- paragraph (b) as a duty, minutes on the trace's clock: dispersing at 30 is in time (FULFILLED); at 31 it is late (BREACH); not at all by 31 (BREACH).
#TRACE `s 68(b) the duty to disperse` AT 0 WITH
    PARTY `the accused` DOES `s 68(b) peaceably disperses and departs from the place` AT 30
#TRACE `s 68(b) the duty to disperse` AT 0 WITH
    PARTY `the accused` DOES `s 68(b) peaceably disperses and departs from the place` AT 31
#TRACE `s 68(b) the duty to disperse` AT 0 WITH
    WAITUNTIL 31

§ `Tests -- section 69, neglect by peace officer (lines 1096-1099)`

--                                                      peace officer answer  notice  excuse  fails
#ASSERT `s 69 the peace officer neglects to suppress a riot` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 69 the peace officer neglects to suppress a riot` (JUST TRUE) TRUE TRUE TRUE EQUALS NOTHING   -- with reasonable excuse
#ASSERT `s 69 the peace officer neglects to suppress a riot` (JUST TRUE) FALSE FALSE TRUE EQUALS NOTHING   -- no notice
#ASSERT `s 69 the peace officer neglects to suppress a riot` (JUST TRUE) TRUE FALSE FALSE EQUALS NOTHING   -- took all reasonable steps
#ASSERT `s 69 the peace officer neglects to suppress a riot` (JUST FALSE) TRUE FALSE TRUE EQUALS NOTHING   -- not a peace officer: the section is addressed to a peace officer only
#ASSERT `s 69 the peace officer neglects to suppress a riot` NOTHING TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 69 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 69 the punishment` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` `two years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
