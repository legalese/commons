IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc-definitions`
IMPORT `ccc24-appeal-right`

-- ccc24-tests-appeal-right.l4 -- tests for ccc24-appeal-right.l4 (Criminal Code ss 673 to 677).
-- Every expected value is written from the text of the section, beside the assertion, before the run.

§ `Section 673 -- definitions`

-- "court of appeal means the court of appeal ... for the province or territory in which the trial of a person by indictment is held" (a "means" definition).
#ASSERT `s 673 court of appeal` TRUE TRUE EQUALS JUST TRUE          -- the Court of Appeal, of the province of the trial
#ASSERT `s 673 court of appeal` FALSE TRUE EQUALS JUST FALSE        -- a court that is not the Court of Appeal: section 2 says "in all provinces, the Court of Appeal"
#ASSERT `s 673 court of appeal` TRUE FALSE EQUALS JUST FALSE        -- a Court of Appeal of another province: not "for the province ... in which the trial ... is held"
#ASSERT `s 673 court of appeal` FALSE FALSE EQUALS JUST FALSE

-- "indictment includes an information or charge in respect of which a person has been tried for an indictable offence under Part XIX"
#ASSERT `s 673 indictment` TRUE `a document that is none of those` EQUALS JUST TRUE                       -- the Part XIX extension
#ASSERT `s 673 indictment` FALSE `an information, or a count in an information` EQUALS JUST TRUE          -- section 2 "indictment" (a)
#ASSERT `s 673 indictment` FALSE `a document that is none of those` EQUALS NOTHING                        -- "includes": not covered either way

-- "registrar means the registrar or clerk of the court of appeal"
#ASSERT `s 673 registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 673 registrar` FALSE EQUALS JUST FALSE

-- "sentence includes (a) a declaration under 199(3), (b) an order under 109(1) or 110(1), section 161, ..., (c) a disposition under 731 or 732 or 732.2(3) or (5), 742.4(3) or 742.6(9), (d) CDSA 16(1), (e) Cannabis Act 94(1)"
#ASSERT `s 673 sentence` (`Provision of the Code` OF 199, "(3)") FALSE FALSE EQUALS JUST TRUE            -- (a)
#ASSERT `s 673 sentence` (`Provision of the Code` OF 199, "(2)") FALSE FALSE EQUALS NOTHING             -- 199(2) is not named: "includes"
#ASSERT `s 673 sentence` (`Provision of the Code` OF 109, "(1)") FALSE FALSE EQUALS JUST TRUE            -- (b)
#ASSERT `s 673 sentence` (`Provision of the Code` OF 109, "(2)") FALSE FALSE EQUALS NOTHING
#ASSERT `s 673 sentence` (`Provision of the Code` OF 110, "(1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 161, "") FALSE FALSE EQUALS JUST TRUE               -- "section 161": any subsection
#ASSERT `s 673 sentence` (`Provision of the Code` OF 161, "(1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 164.2, "(1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 164.2, "(2)") FALSE FALSE EQUALS NOTHING
#ASSERT `s 673 sentence` (`Provision of the Code` OF 194, "(1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 320.24, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 462.37, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 491.1, "(2)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 730, "(1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 737, "(2.1)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 737, "(3)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 737, "(2)") FALSE FALSE EQUALS NOTHING             -- 737(2) is not named
#ASSERT `s 673 sentence` (`Provision of the Code` OF 738, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 739, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 742.1, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 742.3, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 743.6, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 745.4, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 745.5, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 745.52, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 731, "") FALSE FALSE EQUALS JUST TRUE               -- (c)
#ASSERT `s 673 sentence` (`Provision of the Code` OF 732, "") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 732.2, "(3)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 732.2, "(5)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 732.2, "(4)") FALSE FALSE EQUALS NOTHING
#ASSERT `s 673 sentence` (`Provision of the Code` OF 742.4, "(3)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 742.6, "(9)") FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 673 sentence` (`Provision of the Code` OF 742.6, "(8)") FALSE FALSE EQUALS NOTHING
#ASSERT `s 673 sentence` (`Provision of the Code` OF 380, "(1)") TRUE FALSE EQUALS JUST TRUE            -- (d) an order under subsection 16(1) of the CDSA
#ASSERT `s 673 sentence` (`Provision of the Code` OF 380, "(1)") FALSE TRUE EQUALS JUST TRUE            -- (e) an order under subsection 94(1) of the Cannabis Act
#ASSERT `s 673 sentence` (`Provision of the Code` OF 380, "(1)") FALSE FALSE EQUALS NOTHING             -- a fraud sentence is not named: not covered

-- "trial court means the court by which an accused was tried and includes a judge or a provincial court judge acting under Part XIX"
#ASSERT `s 673 trial court` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 673 trial court` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 673 trial court` FALSE FALSE EQUALS JUST FALSE

§ `Section 674 -- procedure abolished`

#ASSERT `s 674 the proceedings are barred as an appeal not authorized by Part XXI or Part XXVI` TRUE FALSE EQUALS JUST TRUE    -- an appeal in an indictable matter that Part XXI and Part XXVI do not authorize
#ASSERT `s 674 the proceedings are barred as an appeal not authorized by Part XXI or Part XXVI` TRUE TRUE EQUALS JUST FALSE     -- an authorized one is outside the bar: "No proceedings other than those authorized"
#ASSERT `s 674 the proceedings are barred as an appeal not authorized by Part XXI or Part XXVI` FALSE FALSE EQUALS NOTHING      -- not an appeal in an indictable matter: the section does not speak to it

§ `Section 675 -- right of appeal of the person convicted`

-- (1)(a)(i) law alone: no leave; (ii) fact or mixed: leave of the court or a judge, or the trial judge's certificate; (iii) another sufficient ground: leave of the court of appeal.
#ASSERT `s 675(1)(a) the conditions that the ground carries are met` `s 675(1)(a)(i) a ground that involves a question of law alone` FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `s 675(1)(a) the conditions that the ground carries are met` `s 675(1)(a)(ii) a ground that involves a question of fact or a question of mixed law and fact` TRUE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `s 675(1)(a) the conditions that the ground carries are met` `s 675(1)(a)(ii) a ground that involves a question of fact or a question of mixed law and fact` FALSE TRUE FALSE FALSE EQUALS TRUE
#ASSERT `s 675(1)(a) the conditions that the ground carries are met` `s 675(1)(a)(ii) a ground that involves a question of fact or a question of mixed law and fact` FALSE FALSE TRUE FALSE EQUALS TRUE
#ASSERT `s 675(1)(a) the conditions that the ground carries are met` `s 675(1)(a)(ii) a ground that involves a question of fact or a question of mixed law and fact` FALSE FALSE FALSE FALSE EQUALS FALSE
#ASSERT `s 675(1)(a) the conditions that the ground carries are met` `s 675(1)(a)(iii) a ground not mentioned in subparagraph (i) or (ii) that appears to the court of appeal to be a sufficient ground` TRUE FALSE FALSE TRUE EQUALS TRUE
#ASSERT `s 675(1)(a) the conditions that the ground carries are met` `s 675(1)(a)(iii) a ground not mentioned in subparagraph (i) or (ii) that appears to the court of appeal to be a sufficient ground` FALSE FALSE FALSE TRUE EQUALS FALSE   -- sufficient but no leave of the court of appeal
#ASSERT `s 675(1)(a) the conditions that the ground carries are met` `s 675(1)(a)(iii) a ground not mentioned in subparagraph (i) or (ii) that appears to the court of appeal to be a sufficient ground` TRUE FALSE FALSE FALSE EQUALS FALSE   -- leave but the ground does not appear sufficient

#ASSERT `s 675(1)(a) the convicted person may appeal to the court of appeal against the conviction on the ground` TRUE `s 675(1)(a)(i) a ground that involves a question of law alone` TRUE EQUALS JUST TRUE
#ASSERT `s 675(1)(a) the convicted person may appeal to the court of appeal against the conviction on the ground` FALSE `s 675(1)(a)(i) a ground that involves a question of law alone` TRUE EQUALS NOTHING     -- not convicted by a trial court by indictment: the grant is not engaged
#ASSERT `s 675(1)(a) the convicted person may appeal to the court of appeal against the conviction on the ground` TRUE `s 675(1)(a)(ii) a ground that involves a question of fact or a question of mixed law and fact` FALSE EQUALS NOTHING   -- no leave and no certificate: not covered, not "may not"

-- (1)(b): sentence, with leave unless the sentence is fixed by law.
#ASSERT `s 675(1)(b) the convicted person may appeal to the court of appeal against the sentence passed by the trial court` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 675(1)(b) the convicted person may appeal to the court of appeal against the sentence passed by the trial court` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 675(1)(b) the convicted person may appeal to the court of appeal against the sentence passed by the trial court` TRUE FALSE TRUE EQUALS JUST TRUE    -- fixed by law: no leave needed on this reading (fork F675b)
#ASSERT `s 675(1)(b) the convicted person may appeal to the court of appeal against the sentence passed by the trial court` FALSE TRUE FALSE EQUALS NOTHING

-- (1.1): a summary conviction tried with an indictable offence, with leave, if (a), (b) and (c).
#ASSERT `s 675(1.1) the person may appeal a summary conviction or its sentence to the court of appeal as if it had been a conviction in proceedings by indictment` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 675(1.1) the person may appeal a summary conviction or its sentence to the court of appeal as if it had been a conviction in proceedings by indictment` FALSE TRUE TRUE TRUE EQUALS NOTHING     -- no leave
#ASSERT `s 675(1.1) the person may appeal a summary conviction or its sentence to the court of appeal as if it had been a conviction in proceedings by indictment` TRUE FALSE TRUE TRUE EQUALS NOTHING     -- (a) fails: there has already been an appeal
#ASSERT `s 675(1.1) the person may appeal a summary conviction or its sentence to the court of appeal as if it had been a conviction in proceedings by indictment` TRUE TRUE FALSE TRUE EQUALS NOTHING     -- (b) fails
#ASSERT `s 675(1.1) the person may appeal a summary conviction or its sentence to the court of appeal as if it had been a conviction in proceedings by indictment` TRUE TRUE TRUE FALSE EQUALS NOTHING     -- (c) fails

-- (2): second degree murder, or manslaughter in the 236(2)(a) to (d) circumstances; life without parole eligibility for a specified number of years in excess of 10.
#ASSERT `s 675(2) the person may appeal to the court of appeal against the number of years in excess of 10 of the imprisonment without eligibility for parole` `second degree murder` FALSE TRUE 15 EQUALS JUST TRUE
#ASSERT `s 675(2) the person may appeal to the court of appeal against the number of years in excess of 10 of the imprisonment without eligibility for parole` `second degree murder` FALSE TRUE 10 EQUALS NOTHING        -- exactly 10 is not "in excess of 10"
#ASSERT `s 675(2) the person may appeal to the court of appeal against the number of years in excess of 10 of the imprisonment without eligibility for parole` `second degree murder` FALSE TRUE 11 EQUALS JUST TRUE       -- 11 is in excess of 10
#ASSERT `s 675(2) the person may appeal to the court of appeal against the number of years in excess of 10 of the imprisonment without eligibility for parole` `manslaughter` TRUE TRUE 12 EQUALS JUST TRUE
#ASSERT `s 675(2) the person may appeal to the court of appeal against the number of years in excess of 10 of the imprisonment without eligibility for parole` `manslaughter` FALSE TRUE 12 EQUALS NOTHING               -- manslaughter outside 236(2)(a) to (d)
#ASSERT `s 675(2) the person may appeal to the court of appeal against the number of years in excess of 10 of the imprisonment without eligibility for parole` `first degree murder` FALSE TRUE 25 EQUALS NOTHING          -- first degree murder is not named in (2) (it is in (2.2), for a person under 18)
#ASSERT `s 675(2) the person may appeal to the court of appeal against the number of years in excess of 10 of the imprisonment without eligibility for parole` `second degree murder` FALSE FALSE 15 EQUALS NOTHING      -- not sentenced to life without eligibility for a specified number of years

-- (2.1) and (2.3): the sections 743.6 and 745.51(1) orders are other parts' answers, taken as inputs.
#ASSERT `s 675(2.1) the person against whom an order under section 743.6 has been made may appeal to the court of appeal against the order` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 675(2.1) the person against whom an order under section 743.6 has been made may appeal to the court of appeal against the order` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 675(2.1) the person against whom an order under section 743.6 has been made may appeal to the court of appeal against the order` (NOTHING) EQUALS NOTHING
#ASSERT `s 675(2.3) the person against whom an order under subsection 745.51(1) has been made may appeal to the court of appeal against the order` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 675(2.3) the person against whom an order under subsection 745.51(1) has been made may appeal to the court of appeal against the order` (JUST FALSE) EQUALS NOTHING

-- (2.2): a person under 18 at the time of the offence.
#ASSERT `s 675(2.2) the person may appeal to the court of appeal against the number of years in excess of the minimum number of years without eligibility for parole` TRUE `first degree murder` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 675(2.2) the person may appeal to the court of appeal against the number of years in excess of the minimum number of years without eligibility for parole` FALSE `first degree murder` FALSE TRUE TRUE EQUALS NOTHING     -- 18 or older: (2.2) does not reach them
#ASSERT `s 675(2.2) the person may appeal to the court of appeal against the number of years in excess of the minimum number of years without eligibility for parole` TRUE `manslaughter` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 675(2.2) the person may appeal to the court of appeal against the number of years in excess of the minimum number of years without eligibility for parole` TRUE `manslaughter` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 675(2.2) the person may appeal to the court of appeal against the number of years in excess of the minimum number of years without eligibility for parole` TRUE `infanticide` FALSE TRUE TRUE EQUALS NOTHING             -- infanticide is not named
#ASSERT `s 675(2.2) the person may appeal to the court of appeal against the number of years in excess of the minimum number of years without eligibility for parole` TRUE `second degree murder` FALSE TRUE FALSE EQUALS NOTHING   -- the period is not in excess of the minimum

-- (3): a verdict of not criminally responsible, or of unfit to stand trial.
#ASSERT `s 675(3) the person may appeal to the court of appeal against the verdict` `a verdict of not criminally responsible on account of mental disorder` TRUE EQUALS JUST TRUE
#ASSERT `s 675(3) the person may appeal to the court of appeal against the verdict` `a verdict of unfit to stand trial` TRUE EQUALS JUST TRUE
#ASSERT `s 675(3) the person may appeal to the court of appeal against the verdict` `a verdict of unfit to stand trial` FALSE EQUALS NOTHING            -- "subject to the conditions described therein" not met
#ASSERT `s 675(3) the person may appeal to the court of appeal against the verdict` `a finding of guilt` TRUE EQUALS NOTHING                           -- not one of the two verdicts: (1) governs, not (3)

-- (4): refusal of leave by a judge, otherwise than under (1)(b); notice within seven days after the refusal.
#ASSERT `s 675(4) the appellant may have the application for leave to appeal determined by the court of appeal` TRUE FALSE TRUE 7 EQUALS JUST TRUE         -- day 7: within seven days
#ASSERT `s 675(4) the appellant may have the application for leave to appeal determined by the court of appeal` TRUE FALSE TRUE 8 EQUALS JUST FALSE        -- day 8: "within seven days after the refusal" not met
#ASSERT `s 675(4) the appellant may have the application for leave to appeal determined by the court of appeal` TRUE FALSE FALSE 3 EQUALS NOTHING        -- still in time, notice not yet filed
#ASSERT `s 675(4) the appellant may have the application for leave to appeal determined by the court of appeal` TRUE FALSE FALSE 9 EQUALS JUST FALSE       -- out of time, not filed
#ASSERT `s 675(4) the appellant may have the application for leave to appeal determined by the court of appeal` TRUE TRUE TRUE 2 EQUALS JUST FALSE         -- the refusal was under (1)(b): "otherwise than under paragraph (1)(b)"
#ASSERT `s 675(4) the appellant may have the application for leave to appeal determined by the court of appeal` FALSE FALSE TRUE 2 EQUALS JUST FALSE       -- no judge refused leave under section 675

-- The same liberty as a regulative rule: a MAY with no LEST.  A filing on day 7 and a lapse both end FULFILLED (compared across both stable builds).
#TRACE `s 675(4) the appellant's liberty to have the application determined by the court of appeal` AT 0 WITH
    PARTY `the accused` DOES `s 675(4) file notice in writing with the court of appeal` AT 7

#TRACE `s 675(4) the appellant's liberty to have the application determined by the court of appeal` AT 0 WITH
    (WAITUNTIL 8)

§ `Section 676 -- right of the Attorney General to appeal`

#ASSERT `s 676(1)(a) the Attorney General may appeal to the court of appeal against the acquittal or verdict` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 676(1)(a) the Attorney General may appeal to the court of appeal against the acquittal or verdict` TRUE TRUE FALSE EQUALS NOTHING     -- a ground that is not law alone
#ASSERT `s 676(1)(a) the Attorney General may appeal to the court of appeal against the acquittal or verdict` FALSE TRUE TRUE EQUALS NOTHING     -- not the Attorney General or counsel instructed for the purpose
#ASSERT `s 676(1)(a) the Attorney General may appeal to the court of appeal against the acquittal or verdict` TRUE FALSE TRUE EQUALS NOTHING     -- not an acquittal or verdict of not criminally responsible
#ASSERT `s 676(1)(b) the Attorney General may appeal to the court of appeal against the order of a superior court of criminal jurisdiction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 676(1)(b) the Attorney General may appeal to the court of appeal against the order of a superior court of criminal jurisdiction` TRUE FALSE EQUALS NOTHING
#ASSERT `s 676(1)(b) the Attorney General may appeal to the court of appeal against the order of a superior court of criminal jurisdiction` FALSE TRUE EQUALS NOTHING
#ASSERT `s 676(1)(c) the Attorney General may appeal to the court of appeal against the order of a trial court` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 676(1)(c) the Attorney General may appeal to the court of appeal against the order of a trial court` TRUE FALSE EQUALS NOTHING
#ASSERT `s 676(1)(c) the Attorney General may appeal to the court of appeal against the order of a trial court` FALSE TRUE EQUALS NOTHING
#ASSERT `s 676(1)(d) the Attorney General may appeal to the court of appeal against the sentence passed by a trial court` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 676(1)(d) the Attorney General may appeal to the court of appeal against the sentence passed by a trial court` TRUE TRUE TRUE TRUE EQUALS JUST FALSE      -- "unless that sentence is one fixed by law"
#ASSERT `s 676(1)(d) the Attorney General may appeal to the court of appeal against the sentence passed by a trial court` TRUE TRUE FALSE FALSE EQUALS NOTHING     -- no leave
#ASSERT `s 676(1)(d) the Attorney General may appeal to the court of appeal against the sentence passed by a trial court` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 676(1.1) the Attorney General may appeal a summary acquittal or summary sentence to the court of appeal as if the proceeding was by indictment` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 676(1.1) the Attorney General may appeal a summary acquittal or summary sentence to the court of appeal as if the proceeding was by indictment` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING    -- no leave
#ASSERT `s 676(1.1) the Attorney General may appeal a summary acquittal or summary sentence to the court of appeal as if the proceeding was by indictment` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING    -- (a) fails
#ASSERT `s 676(1.1) the Attorney General may appeal a summary acquittal or summary sentence to the court of appeal as if the proceeding was by indictment` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING    -- (b) fails
#ASSERT `s 676(1.1) the Attorney General may appeal a summary acquittal or summary sentence to the court of appeal as if the proceeding was by indictment` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING    -- (c) fails
#ASSERT `s 676(1.1) the Attorney General may appeal a summary acquittal or summary sentence to the court of appeal as if the proceeding was by indictment` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING   -- not the Attorney General
#ASSERT `s 676(2) a judgment or verdict of acquittal includes the decision, for the purposes of section 676` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 676(2) a judgment or verdict of acquittal includes the decision, for the purposes of section 676` TRUE FALSE EQUALS NOTHING
#ASSERT `s 676(2) a judgment or verdict of acquittal includes the decision, for the purposes of section 676` FALSE TRUE EQUALS NOTHING
#ASSERT `s 676(3) the Attorney General may appeal to the court of appeal against a verdict that an accused is unfit to stand trial` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 676(3) the Attorney General may appeal to the court of appeal against a verdict that an accused is unfit to stand trial` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 676(3) the Attorney General may appeal to the court of appeal against a verdict that an accused is unfit to stand trial` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 676(3) the Attorney General may appeal to the court of appeal against a verdict that an accused is unfit to stand trial` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 676(4) the Attorney General may appeal to the court of appeal against the number of years of imprisonment without eligibility for parole, being less than 25` TRUE `second degree murder` FALSE 24 EQUALS JUST TRUE
#ASSERT `s 676(4) the Attorney General may appeal to the court of appeal against the number of years of imprisonment without eligibility for parole, being less than 25` TRUE `second degree murder` FALSE 25 EQUALS NOTHING     -- 25 is not "less than 25"
#ASSERT `s 676(4) the Attorney General may appeal to the court of appeal against the number of years of imprisonment without eligibility for parole, being less than 25` TRUE `manslaughter` TRUE 15 EQUALS JUST TRUE
#ASSERT `s 676(4) the Attorney General may appeal to the court of appeal against the number of years of imprisonment without eligibility for parole, being less than 25` TRUE `manslaughter` FALSE 15 EQUALS NOTHING
#ASSERT `s 676(4) the Attorney General may appeal to the court of appeal against the number of years of imprisonment without eligibility for parole, being less than 25` TRUE `first degree murder` FALSE 15 EQUALS NOTHING
#ASSERT `s 676(4) the Attorney General may appeal to the court of appeal against the number of years of imprisonment without eligibility for parole, being less than 25` FALSE `second degree murder` FALSE 15 EQUALS NOTHING
#ASSERT `s 676(5) the Attorney General may appeal to the court of appeal against the decision of the court not to make an order under section 743.6` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 676(5) the Attorney General may appeal to the court of appeal against the decision of the court not to make an order under section 743.6` TRUE FALSE EQUALS NOTHING
#ASSERT `s 676(5) the Attorney General may appeal to the court of appeal against the decision of the court not to make an order under section 743.6` FALSE TRUE EQUALS NOTHING
#ASSERT `s 676(6) the Attorney General may appeal to the court of appeal against the decision of the court not to make an order under subsection 745.51(1)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 676(6) the Attorney General may appeal to the court of appeal against the decision of the court not to make an order under subsection 745.51(1)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 676(6) the Attorney General may appeal to the court of appeal against the decision of the court not to make an order under subsection 745.51(1)` FALSE TRUE EQUALS NOTHING

§ `Section 676.1 -- appeal re costs`

#ASSERT `s 676.1 the party ordered to pay costs may appeal the order or the amount of costs ordered` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 676.1 the party ordered to pay costs may appeal the order or the amount of costs ordered` TRUE FALSE EQUALS NOTHING     -- no leave
#ASSERT `s 676.1 the party ordered to pay costs may appeal the order or the amount of costs ordered` FALSE TRUE EQUALS NOTHING    -- not a party ordered to pay costs

§ `Section 677 -- specifying grounds of dissent`

#ASSERT `s 677 the judgment of the court has specified the grounds in law of the dissent` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 677 the judgment of the court has specified the grounds in law of the dissent` TRUE FALSE EQUALS JUST FALSE         -- a judge dissents and the judgment does not specify: "shall specify"
#ASSERT `s 677 the judgment of the court has specified the grounds in law of the dissent` FALSE TRUE EQUALS NOTHING           -- no dissent: the duty is not engaged
#ASSERT `s 677 the judgment of the court has specified the grounds in law of the dissent` FALSE FALSE EQUALS NOTHING
