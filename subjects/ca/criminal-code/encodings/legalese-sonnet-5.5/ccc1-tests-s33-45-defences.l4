IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc1-s33-45-defences`

-- ccc1-tests-s33-45-defences.l4 -- tests for sections 33.1 to 45 of the Criminal Code (Canada). Expected values are written by hand from the text of each section.
-- Arguments are positional, in GIVEN order. The regulative rules of section 33.1(2) are run with #TRACE.

§ `s 33.1  (lacks the intent or voluntariness; by self-induced extreme intoxication by (4); an offence of (3); other elements; departed markedly)`
#ASSERT `s 33.1(1) the person nonetheless commits the offence` TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE   -- (a) and (b) are met
#ASSERT `s 33.1(1) the person nonetheless commits the offence` TRUE (JUST TRUE) (JUST TRUE) FALSE TRUE EQUALS JUST FALSE   -- (a): not all the other elements are present
#ASSERT `s 33.1(1) the person nonetheless commits the offence` TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS JUST FALSE   -- (b): no marked departure before the extreme intoxication
#ASSERT `s 33.1(1) the person nonetheless commits the offence` FALSE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS NOTHING   -- does not lack the intent or voluntariness: the section is about the person who does
#ASSERT `s 33.1(1) the person nonetheless commits the offence` TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS NOTHING   -- not extreme intoxication as (4) defines it
#ASSERT `s 33.1(1) the person nonetheless commits the offence` TRUE (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS NOTHING   -- not an offence referred to in (3)
#ASSERT `s 33.1(1) the person nonetheless commits the offence` TRUE NOTHING (JUST TRUE) TRUE TRUE EQUALS NOTHING   -- subsection (4) did not answer
#ASSERT `s 33.1(1) the person nonetheless commits the offence` TRUE (JUST TRUE) NOTHING TRUE TRUE EQUALS NOTHING   -- subsection (3) did not answer
#ASSERT `s 33.1(2) the court must consider the matter` TRUE `s 33.1(2) the objective foreseeability of the risk that the consumption of the intoxicating substances could cause extreme intoxication and lead the person to harm another person` EQUALS JUST TRUE   -- the objective foreseeability of the risk
#ASSERT `s 33.1(2) the court must consider the matter` TRUE `s 33.1(2) all relevant circumstances, including anything that the person did to avoid the risk` EQUALS JUST TRUE   -- all relevant circumstances, including what the person did to avoid the risk
#ASSERT `s 33.1(2) the court must consider the matter` TRUE `s 33.1(2) another matter` EQUALS NOTHING   -- "including": the list is not closed
#ASSERT `s 33.1(2) the court must consider the matter` FALSE `s 33.1(2) the objective foreseeability of the risk that the consumption of the intoxicating substances could cause extreme intoxication and lead the person to harm another person` EQUALS NOTHING   -- the court is not determining whether the person departed markedly from the standard of care
-- Expected by hand: the court considers the foreseeability, FULFILLED.
#TRACE `s 33.1(2) the duty of the court to consider the objective foreseeability of the risk` AT 0 WITH
    PARTY `the court` DOES `s 33.1(2) consider the objective foreseeability of the risk that the consumption of the intoxicating substances could cause extreme intoxication and lead the person to harm another person` AT 1
-- Expected by hand: the court considers all relevant circumstances, FULFILLED.
#TRACE `s 33.1(2) the duty of the court to consider all relevant circumstances` AT 0 WITH
    PARTY `the court` DOES `s 33.1(2) consider all relevant circumstances, including anything that the person did to avoid the risk` AT 1
#ASSERT `s 33.1(3) section 33.1 applies in respect of the offence` TRUE TRUE EQUALS JUST TRUE   -- an offence under an Act of Parliament with an element of assault or interference with bodily integrity
#ASSERT `s 33.1(3) section 33.1 applies in respect of the offence` TRUE FALSE EQUALS NOTHING   -- no such element
#ASSERT `s 33.1(3) section 33.1 applies in respect of the offence` FALSE TRUE EQUALS NOTHING   -- not an offence under an Act of Parliament
#ASSERT `s 33.1(4) extreme intoxication` TRUE TRUE FALSE EQUALS JUST TRUE   -- unaware of their behaviour
#ASSERT `s 33.1(4) extreme intoxication` TRUE FALSE TRUE EQUALS JUST TRUE   -- incapable of consciously controlling their behaviour
#ASSERT `s 33.1(4) extreme intoxication` TRUE TRUE TRUE EQUALS JUST TRUE   -- both
#ASSERT `s 33.1(4) extreme intoxication` TRUE FALSE FALSE EQUALS JUST FALSE   -- intoxication that leaves the person aware and in control: "means"
#ASSERT `s 33.1(4) extreme intoxication` FALSE TRUE TRUE EQUALS JUST FALSE   -- not intoxication

§ `s 34  (defence of person)`
#ASSERT `s 34(1) the person is not guilty of the offence` TRUE TRUE TRUE EQUALS JUST TRUE   -- (a), (b) and (c)
#ASSERT `s 34(1) the person is not guilty of the offence` FALSE TRUE TRUE EQUALS JUST FALSE   -- (a): no belief on reasonable grounds
#ASSERT `s 34(1) the person is not guilty of the offence` TRUE FALSE TRUE EQUALS JUST FALSE   -- (b): not for the purpose of defending or protecting
#ASSERT `s 34(1) the person is not guilty of the offence` TRUE TRUE FALSE EQUALS JUST FALSE   -- (c): not reasonable in the circumstances
#ASSERT `s 34(1) the person is not guilty of the offence` FALSE FALSE FALSE EQUALS JUST FALSE   -- none
#ASSERT `s 34(2) the court shall consider the factor` `s 34(2)(a) the nature of the force or threat` FALSE EQUALS JUST TRUE   -- factor (a) is named
#ASSERT `s 34(2) the court shall consider the factor` `s 34(2)(b) the extent to which the use of force was imminent and whether there were other means available to respond to the potential use of force` FALSE EQUALS JUST TRUE   -- factor (b) is named
#ASSERT `s 34(2) the court shall consider the factor` `s 34(2)(c) the person’s role in the incident` FALSE EQUALS JUST TRUE   -- factor (c) is named
#ASSERT `s 34(2) the court shall consider the factor` `s 34(2)(d) whether any party to the incident used or threatened to use a weapon` FALSE EQUALS JUST TRUE   -- factor (d) is named
#ASSERT `s 34(2) the court shall consider the factor` `s 34(2)(e) the size, age, gender and physical capabilities of the parties to the incident` FALSE EQUALS JUST TRUE   -- factor (e) is named
#ASSERT `s 34(2) the court shall consider the factor` `s 34(2)(f) the nature, duration and history of any relationship between the parties to the incident, including any prior use or threat of force and the nature of that force or threat` FALSE EQUALS JUST TRUE   -- factor (f) is named
#ASSERT `s 34(2) the court shall consider the factor` `s 34(2)(f.1) any history of interaction or communication between the parties to the incident` FALSE EQUALS JUST TRUE   -- factor (f.1) is named
#ASSERT `s 34(2) the court shall consider the factor` `s 34(2)(g) the nature and proportionality of the person’s response to the use or threat of force` FALSE EQUALS JUST TRUE   -- factor (g) is named
#ASSERT `s 34(2) the court shall consider the factor` `s 34(2)(h) whether the act committed was in response to a use or threat of force that the person knew was lawful` FALSE EQUALS JUST TRUE   -- factor (h) is named
#ASSERT `s 34(2) the court shall consider the factor` `s 34(2) another circumstance of the person, the other parties or the act` TRUE EQUALS JUST TRUE   -- "including, but not limited to": another relevant circumstance
#ASSERT `s 34(2) the court shall consider the factor` `s 34(2) another circumstance of the person, the other parties or the act` FALSE EQUALS NOTHING   -- a circumstance that is not relevant
#ASSERT `s 34(3) subsection (1) does not apply` TRUE FALSE EQUALS JUST TRUE   -- force used by someone enforcing the law, and no belief that they act unlawfully: (1) does not apply
#ASSERT `s 34(3) subsection (1) does not apply` TRUE TRUE EQUALS JUST FALSE   -- "unless the person ... believes on reasonable grounds that the other person is acting unlawfully"
#ASSERT `s 34(3) subsection (1) does not apply` FALSE FALSE EQUALS JUST FALSE   -- not force used or threatened in the administration or enforcement of the law
#ASSERT `s 34(3) subsection (1) does not apply` FALSE TRUE EQUALS JUST FALSE   -- same
#ASSERT `s 34 the person is not guilty of the offence, subject to subsection (3)` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE   -- (1) is met but (3) says (1) does not apply: no defence under section 34 on these facts
#ASSERT `s 34 the person is not guilty of the offence, subject to subsection (3)` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- (1) is met and (3) does not displace it
#ASSERT `s 34 the person is not guilty of the offence, subject to subsection (3)` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- (1) is not met
#ASSERT `s 34 the person is not guilty of the offence, subject to subsection (3)` (JUST TRUE) NOTHING EQUALS JUST TRUE   -- (3) not engaged

§ `s 35  (defence of property)`
#ASSERT `s 35(1) the person is not guilty of the offence` TRUE FALSE TRUE FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE   -- (a) believes in own peaceable possession; (b)(i) entering; (c)(i) to prevent entry; (d) reasonable
#ASSERT `s 35(1) the person is not guilty of the offence` FALSE TRUE FALSE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE   -- (a) lawfully assisting; (b)(ii) taking; (c)(ii) to prevent taking; (d)
#ASSERT `s 35(1) the person is not guilty of the offence` TRUE FALSE FALSE FALSE TRUE FALSE TRUE TRUE EQUALS JUST TRUE   -- (b)(iii) damaging; (c)(ii)
#ASSERT `s 35(1) the person is not guilty of the offence` FALSE FALSE TRUE FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE   -- (a) is not met
#ASSERT `s 35(1) the person is not guilty of the offence` TRUE FALSE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE   -- (b) is not met
#ASSERT `s 35(1) the person is not guilty of the offence` TRUE FALSE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- (c) is not met
#ASSERT `s 35(1) the person is not guilty of the offence` TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- (d) is not met
#ASSERT `s 35(2) subsection (1) does not apply because the other person is entitled to possession` TRUE TRUE EQUALS JUST TRUE   -- no claim of right and the other person is entitled to possession by law
#ASSERT `s 35(2) subsection (1) does not apply because the other person is entitled to possession` FALSE TRUE EQUALS JUST FALSE   -- a claim of right
#ASSERT `s 35(2) subsection (1) does not apply because the other person is entitled to possession` TRUE FALSE EQUALS JUST FALSE   -- the other person is not entitled
#ASSERT `s 35(3) subsection (1) does not apply because the other person is acting in the administration or enforcement of the law` TRUE FALSE EQUALS JUST TRUE   -- the other person acts in the administration or enforcement of the law, and no belief that they act unlawfully
#ASSERT `s 35(3) subsection (1) does not apply because the other person is acting in the administration or enforcement of the law` TRUE TRUE EQUALS JUST FALSE   -- "unless ... believes on reasonable grounds that the other person is acting unlawfully"
#ASSERT `s 35(3) subsection (1) does not apply because the other person is acting in the administration or enforcement of the law` FALSE FALSE EQUALS JUST FALSE   -- not so
#ASSERT `s 35 the person is not guilty of the offence, subject to subsections (2) and (3)` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- (1) met, neither limit
#ASSERT `s 35 the person is not guilty of the offence, subject to subsections (2) and (3)` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE   -- (2) limit
#ASSERT `s 35 the person is not guilty of the offence, subject to subsections (2) and (3)` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE   -- (3) limit
#ASSERT `s 35 the person is not guilty of the offence, subject to subsections (2) and (3)` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- (1) not met

§ `ss 36 to 42, 44  (repealed)`
#ASSERT `s 36 as the text shows it` EQUALS "[Repealed, 2012, c. 9, s. 2]"   -- the text shows s 36 repealed
#ASSERT `s 37 as the text shows it` EQUALS "[Repealed, 2012, c. 9, s. 2]"   -- the text shows s 37 repealed
#ASSERT `s 38 as the text shows it` EQUALS "[Repealed, 2012, c. 9, s. 2]"   -- the text shows s 38 repealed
#ASSERT `s 39 as the text shows it` EQUALS "[Repealed, 2012, c. 9, s. 2]"   -- the text shows s 39 repealed
#ASSERT `s 40 as the text shows it` EQUALS "[Repealed, 2012, c. 9, s. 2]"   -- the text shows s 40 repealed
#ASSERT `s 41 as the text shows it` EQUALS "[Repealed, 2012, c. 9, s. 2]"   -- the text shows s 41 repealed
#ASSERT `s 42 as the text shows it` EQUALS "[Repealed, 2012, c. 9, s. 2]"   -- the text shows s 42 repealed
#ASSERT `s 44 as the text shows it` EQUALS "[Repealed, 2001, c. 26, s. 294]"   -- the text shows s 44 repealed

§ `s 43  (who; under their care; by way of correction; the force does not exceed what is reasonable)`
#ASSERT `s 43 the person is justified in using force by way of correction toward the pupil or child` `s 43 a schoolteacher` TRUE TRUE TRUE EQUALS JUST TRUE   -- `s 43 a schoolteacher`, within reason
#ASSERT `s 43 the person is justified in using force by way of correction toward the pupil or child` `s 43 a schoolteacher` TRUE TRUE FALSE EQUALS JUST FALSE   -- "if the force does not exceed what is reasonable under the circumstances" is not met
#ASSERT `s 43 the person is justified in using force by way of correction toward the pupil or child` `s 43 a parent` TRUE TRUE TRUE EQUALS JUST TRUE   -- `s 43 a parent`, within reason
#ASSERT `s 43 the person is justified in using force by way of correction toward the pupil or child` `s 43 a parent` TRUE TRUE FALSE EQUALS JUST FALSE   -- "if the force does not exceed what is reasonable under the circumstances" is not met
#ASSERT `s 43 the person is justified in using force by way of correction toward the pupil or child` `s 43 a person standing in the place of a parent` TRUE TRUE TRUE EQUALS JUST TRUE   -- `s 43 a person standing in the place of a parent`, within reason
#ASSERT `s 43 the person is justified in using force by way of correction toward the pupil or child` `s 43 a person standing in the place of a parent` TRUE TRUE FALSE EQUALS JUST FALSE   -- "if the force does not exceed what is reasonable under the circumstances" is not met
#ASSERT `s 43 the person is justified in using force by way of correction toward the pupil or child` `s 43 another person` TRUE TRUE TRUE EQUALS NOTHING   -- not a schoolteacher, parent or person standing in the place of a parent
#ASSERT `s 43 the person is justified in using force by way of correction toward the pupil or child` `s 43 a parent` FALSE TRUE TRUE EQUALS NOTHING   -- not a child under their care
#ASSERT `s 43 the person is justified in using force by way of correction toward the pupil or child` `s 43 a parent` TRUE FALSE TRUE EQUALS NOTHING   -- not by way of correction

§ `s 45  (surgical operation)`
#ASSERT `s 45 the person is protected from criminal responsibility for performing the surgical operation` TRUE TRUE TRUE EQUALS JUST TRUE   -- (a) reasonable care and skill; (b) reasonable to perform
#ASSERT `s 45 the person is protected from criminal responsibility for performing the surgical operation` TRUE FALSE TRUE EQUALS JUST FALSE   -- (a) not met
#ASSERT `s 45 the person is protected from criminal responsibility for performing the surgical operation` TRUE TRUE FALSE EQUALS JUST FALSE   -- (b) not met
#ASSERT `s 45 the person is protected from criminal responsibility for performing the surgical operation` FALSE TRUE TRUE EQUALS NOTHING   -- not a surgical operation for the benefit of that person
