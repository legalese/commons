    IF NOT (offence's `section` EQUALS 319 AND (offence's `subsection` EQUALS "(2)" OR offence's `subsection` EQUALS "(2.1)" OR offence's `subsection` EQUALS "(2.2)"))
    THEN NOTHING   -- NOTHING-kind (limited by its own wording): "No proceeding for an offence under subsection (2), (2.1) or (2.2)"
    ELSE IF NOT `the Attorney General has consented to the proceeding`
         THEN JUST TRUE
         ELSE NOTHING   -- NOTHING-kind (limited by its own wording): "shall be instituted without the consent of the Attorney General" (with consent the bar does not apply)

