IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc4-s84-definitions`
IMPORT `ccc4-s85-98-use-possession`

-- ccc4-tests-s85-98.l4 -- tests of ccc4-s85-98-use-possession.l4 (sections 85 to 98.1 of the Criminal Code, Canada).
-- Generated by work/gentests.py from work/tests/t_s85_98.py.  Every expected value is written by hand from the text, beside the case, before the run.
-- Abbreviations in the case descriptions: "T" = JUST TRUE, "F" = JUST FALSE, "N" = NOTHING (not covered).
-- The summary-conviction limbs state no penalty and take the answer of section 787(1) as an input: the test passes a stand-in value that is NOT the penalty of section 787(1)
-- (which is in another part) and checks that the limb returns the input unchanged.

-- A stand-in for the penalty of section 787(1), which is in another part.  It is not that penalty: its figures are arbitrary.
`ccc4 test fixture: a stand-in for section 787(1)` MEANS Punishment WITH
    `mode` IS `on summary conviction`
    `maximum imprisonment` IS `imprisonment for a term of` `six months`
    `minimum imprisonment` IS `no imprisonment is stated`
    `maximum fine` IS `a fine of` 1234
    `minimum fine` IS `no fine is stated`

§ `Use Offences`

§§ `Section 85`

-- `s 85(1) the person commits an offence by using a firearm in the commission of an offence`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing used (`s 84(1) kind of thing`)
--   2. the person uses it (BOOLEAN)
--   3. the indictable offence the person is committing, attempting to commit or fleeing after (`Provision of the Code`)
--   4. the person uses it while committing an indictable offence (BOOLEAN)
--   5. the person uses it while attempting to commit an indictable offence (BOOLEAN)
--   6. the person uses it during flight after committing or attempting to commit an indictable offence (BOOLEAN)
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 334, "") TRUE FALSE FALSE EQUALS JUST TRUE   -- (a) uses a prohibited firearm while committing an indictable offence (section 334)
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a restricted firearm` TRUE (`Provision of the Code` OF 334, "") TRUE FALSE FALSE EQUALS JUST TRUE   -- (a) uses a restricted firearm
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a non-restricted firearm` TRUE (`Provision of the Code` OF 334, "") TRUE FALSE FALSE EQUALS JUST TRUE   -- (a) uses a non-restricted firearm
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a replica firearm` TRUE (`Provision of the Code` OF 334, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses a replica firearm: not a firearm
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited weapon` TRUE (`Provision of the Code` OF 334, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses a prohibited weapon: not a firearm
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a thing that is none of those` TRUE (`Provision of the Code` OF 334, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses a thing that is none of the classes
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 220, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses it while committing an offence under section 220 (criminal negligence causing death): excepted by "other than an offence under"
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 236, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses it while committing an offence under section 236 (manslaughter): excepted by "other than an offence under"
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 239, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses it while committing an offence under section 239 (attempted murder): excepted by "other than an offence under"
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 244, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses it while committing an offence under section 244 (discharging firearm with intent): excepted by "other than an offence under"
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 244.2, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses it while committing an offence under section 244.2 (discharging firearm - recklessness): excepted by "other than an offence under"
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 272, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses it while committing an offence under section 272 (sexual assault with a weapon): excepted by "other than an offence under"
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 273, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses it while committing an offence under section 273 (aggravated sexual assault): excepted by "other than an offence under"
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 279, "(1)") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses it while committing an offence under section 279(1) (kidnapping): excepted by "other than an offence under"
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 279.1, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses it while committing an offence under section 279.1 (hostage taking): excepted by "other than an offence under"
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 344, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses it while committing an offence under section 344 (robbery): excepted by "other than an offence under"
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 346, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) uses it while committing an offence under section 346 (extortion): excepted by "other than an offence under"
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 279, "(2)") TRUE FALSE FALSE EQUALS JUST TRUE   -- (a) subsection 279(2) is not excepted
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 245, "") TRUE FALSE FALSE EQUALS JUST TRUE   -- (a) section 245 is not excepted
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 344, "") FALSE TRUE FALSE EQUALS JUST TRUE   -- (b) uses it while attempting robbery: the exception is in paragraph (a) only
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 344, "") FALSE FALSE TRUE EQUALS JUST TRUE   -- (c) uses it during flight after robbery: the exception is in paragraph (a) only
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 344, "") TRUE FALSE TRUE EQUALS JUST TRUE   -- (a) robbery excepted but the person also uses it during flight
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE (`Provision of the Code` OF 334, "") FALSE FALSE FALSE EQUALS JUST FALSE   -- uses a firearm but none of (a), (b), (c)
#ASSERT `s 85(1) the person commits an offence by using a firearm in the commission of an offence` `s 84(1) kind: a prohibited firearm` FALSE (`Provision of the Code` OF 334, "") TRUE FALSE FALSE EQUALS JUST FALSE   -- does not use it

-- `s 85(2) the person commits an offence by using an imitation firearm in the commission of an offence`
-- inputs, in the order of the GIVEN:
--   1. s 84(1) imitation firearm: the thing used is an imitation firearm (MAYBE BOOLEAN)
--   2. the person uses it (BOOLEAN)
--   3. the person uses it while committing an indictable offence (BOOLEAN)
--   4. the person uses it while attempting to commit an indictable offence (BOOLEAN)
--   5. the person uses it during flight after committing or attempting to commit an indictable offence (BOOLEAN)
#ASSERT `s 85(2) the person commits an offence by using an imitation firearm in the commission of an offence` (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- (a) while committing an indictable offence
#ASSERT `s 85(2) the person commits an offence by using an imitation firearm in the commission of an offence` (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b) while attempting to commit an indictable offence
#ASSERT `s 85(2) the person commits an offence by using an imitation firearm in the commission of an offence` (JUST TRUE) TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- (c) during flight after committing or attempting to commit one
#ASSERT `s 85(2) the person commits an offence by using an imitation firearm in the commission of an offence` (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- none of (a), (b), (c)
#ASSERT `s 85(2) the person commits an offence by using an imitation firearm in the commission of an offence` (JUST FALSE) TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- the thing is not an imitation firearm
#ASSERT `s 85(2) the person commits an offence by using an imitation firearm in the commission of an offence` NOTHING TRUE TRUE FALSE FALSE EQUALS NOTHING   -- whether it is an imitation firearm is not covered
#ASSERT `s 85(2) the person commits an offence by using an imitation firearm in the commission of an offence` NOTHING TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- whether it is an imitation firearm is not covered but no limb holds
#ASSERT `s 85(2) the person commits an offence by using an imitation firearm in the commission of an offence` (JUST TRUE) FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- does not use it

-- `s 85(3) the class of the offence`
#ASSERT `s 85(3) the class of the offence` EQUALS `an indictable offence`  -- indictable only

-- `s 85(3) the punishment on indictment`
#ASSERT `s 85(3) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 85(4) the sentence must be served consecutively to the other punishment or sentence`
-- inputs, in the order of the GIVEN:
--   1. the sentence is imposed for an offence under subsection 85(1) or (2) (BOOLEAN)
--   2. the other punishment is imposed for an offence arising out of the same event or series of events (BOOLEAN)
--   3. the other sentence is one to which the person is subject at the time the sentence is imposed (BOOLEAN)
#ASSERT `s 85(4) the sentence must be served consecutively to the other punishment or sentence` TRUE TRUE FALSE EQUALS JUST TRUE   -- (i) another punishment for an offence arising out of the same event or series of events
#ASSERT `s 85(4) the sentence must be served consecutively to the other punishment or sentence` TRUE FALSE TRUE EQUALS JUST TRUE   -- (ii) another sentence to which the person is subject when this one is imposed
#ASSERT `s 85(4) the sentence must be served consecutively to the other punishment or sentence` TRUE TRUE TRUE EQUALS JUST TRUE   -- both
#ASSERT `s 85(4) the sentence must be served consecutively to the other punishment or sentence` TRUE FALSE FALSE EQUALS NOTHING   -- neither: the text is limited to those two
#ASSERT `s 85(4) the sentence must be served consecutively to the other punishment or sentence` FALSE TRUE FALSE EQUALS NOTHING   -- a sentence not imposed for an offence under subsection 85(1) or (2)

§§ `Section 86`

-- `s 86(1) the person commits an offence of careless use of a firearm, etc.`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing (`s 84(1) kind of thing`)
--   2. the person uses, carries, handles, ships, transports or stores it (BOOLEAN)
--   3. the person does so in a careless manner or without reasonable precautions for the safety of other persons (BOOLEAN)
--   4. the person has a lawful excuse (BOOLEAN)
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE EQUALS JUST TRUE   -- uses a prohibited firearm in a careless manner
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a restricted firearm` TRUE TRUE FALSE EQUALS JUST TRUE   -- the thing is a restricted firearm
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a non-restricted firearm` TRUE TRUE FALSE EQUALS JUST TRUE   -- the thing is a non-restricted firearm
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a prohibited weapon` TRUE TRUE FALSE EQUALS JUST TRUE   -- the thing is a prohibited weapon
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a restricted weapon` TRUE TRUE FALSE EQUALS JUST TRUE   -- the thing is a restricted weapon
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a replica firearm` TRUE TRUE FALSE EQUALS JUST TRUE   -- the thing is a replica firearm (a prohibited device)
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a prohibited device other than a replica firearm` TRUE TRUE FALSE EQUALS JUST TRUE   -- the thing is a prohibited device
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: ammunition other than prohibited ammunition` TRUE TRUE FALSE EQUALS JUST TRUE   -- the thing is a ammunition
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: prohibited ammunition` TRUE TRUE FALSE EQUALS JUST TRUE   -- the thing is a prohibited ammunition
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a firearm part` TRUE TRUE FALSE EQUALS JUST FALSE   -- the thing is a firearm part: not named
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a cross-bow` TRUE TRUE FALSE EQUALS JUST FALSE   -- the thing is a cross-bow: not named
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: an explosive substance` TRUE TRUE FALSE EQUALS JUST FALSE   -- the thing is a explosive substance: not named
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a thing that is none of those` TRUE TRUE FALSE EQUALS JUST FALSE   -- the thing is a thing that is none of the classes: not named
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a prohibited firearm` FALSE TRUE FALSE EQUALS JUST FALSE   -- does not use, carry, handle, ship, transport or store it
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a prohibited firearm` TRUE FALSE FALSE EQUALS JUST FALSE   -- neither careless nor without reasonable precautions
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a prohibited firearm` TRUE TRUE TRUE EQUALS NOTHING   -- has a lawful excuse: "without lawful excuse" limits the prohibition
#ASSERT `s 86(1) the person commits an offence of careless use of a firearm, etc.` `s 84(1) kind: a prohibited firearm` TRUE FALSE TRUE EQUALS JUST FALSE   -- has a lawful excuse but was not careless: the element fails first

-- `s 86(2) the person commits an offence by contravening a storage regulation, etc.`
-- inputs, in the order of the GIVEN:
--   1. the person contravenes a regulation made under paragraph 117(h) of the Firearms Act (BOOLEAN)
--   2. the regulation respects the storage, handling, transportation, shipping, display, advertising or mail-order sales of firearms or restricted weapons (BOOLEAN)
#ASSERT `s 86(2) the person commits an offence by contravening a storage regulation, etc.` TRUE TRUE EQUALS JUST TRUE   -- contravenes a regulation under paragraph 117(h) respecting storage etc.
#ASSERT `s 86(2) the person commits an offence by contravening a storage regulation, etc.` TRUE FALSE EQUALS JUST FALSE   -- contravenes a regulation that is not about storage etc.
#ASSERT `s 86(2) the person commits an offence by contravening a storage regulation, etc.` FALSE TRUE EQUALS JUST FALSE   -- no contravention

-- `s 86(3) the class of the offence`
#ASSERT `s 86(3) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`  -- both indictable and punishable on summary conviction

-- `s 86(3)(a) the punishment on indictment`
-- inputs, in the order of the GIVEN:
--   1. it is a second or subsequent offence (BOOLEAN)
#ASSERT `s 86(3)(a) the punishment on indictment` FALSE EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `two years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- a first offence
#ASSERT `s 86(3)(a) the punishment on indictment` TRUE EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `five years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- a second or subsequent offence

-- `s 86(3)(b) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 86(3)(b) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

§§ `Section 87`

-- `s 87(1) the person commits the offence of pointing a firearm`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing (`s 84(1) kind of thing`)
--   2. the person points it at another person (BOOLEAN)
--   3. the person has a lawful excuse (BOOLEAN)
#ASSERT `s 87(1) the person commits the offence of pointing a firearm` `s 84(1) kind: a prohibited firearm` TRUE FALSE EQUALS JUST TRUE   -- points a prohibited firearm at another person
#ASSERT `s 87(1) the person commits the offence of pointing a firearm` `s 84(1) kind: a restricted firearm` TRUE FALSE EQUALS JUST TRUE   -- points a restricted firearm
#ASSERT `s 87(1) the person commits the offence of pointing a firearm` `s 84(1) kind: a non-restricted firearm` TRUE FALSE EQUALS JUST TRUE   -- points a non-restricted firearm (loaded or unloaded makes no difference: no input)
#ASSERT `s 87(1) the person commits the offence of pointing a firearm` `s 84(1) kind: a replica firearm` TRUE FALSE EQUALS JUST FALSE   -- points a replica firearm: not a firearm
#ASSERT `s 87(1) the person commits the offence of pointing a firearm` `s 84(1) kind: a prohibited weapon` TRUE FALSE EQUALS JUST FALSE   -- points a prohibited weapon: not a firearm
#ASSERT `s 87(1) the person commits the offence of pointing a firearm` `s 84(1) kind: a prohibited firearm` FALSE FALSE EQUALS JUST FALSE   -- does not point it at another person
#ASSERT `s 87(1) the person commits the offence of pointing a firearm` `s 84(1) kind: a prohibited firearm` TRUE TRUE EQUALS NOTHING   -- with lawful excuse
#ASSERT `s 87(1) the person commits the offence of pointing a firearm` `s 84(1) kind: a prohibited firearm` FALSE TRUE EQUALS JUST FALSE   -- with lawful excuse but does not point it

-- `s 87(2) the class of the offence`
#ASSERT `s 87(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`  -- both indictable and punishable on summary conviction

-- `s 87(2)(a) the punishment on indictment`
#ASSERT `s 87(2)(a) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `five years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 87(2)(b) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 87(2)(b) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

§ `Possession Offences`

§§ `Section 88`

-- `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose`
-- inputs, in the order of the GIVEN:
--   1. s 2 weapon: the thing is a weapon (MAYBE BOOLEAN)
--   2. the thing is an imitation of a weapon (BOOLEAN)
--   3. the kind of thing (`s 84(1) kind of thing`)
--   4. the person carries or possesses it (BOOLEAN)
--   5. the purpose is dangerous to the public peace (BOOLEAN)
--   6. the purpose is the committing of an offence (BOOLEAN)
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` (JUST TRUE) FALSE `s 84(1) kind: a thing that is none of those` TRUE TRUE FALSE EQUALS JUST TRUE   -- carries a weapon for a purpose dangerous to the public peace
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` (JUST TRUE) FALSE `s 84(1) kind: a thing that is none of those` TRUE FALSE TRUE EQUALS JUST TRUE   -- carries a weapon for the purpose of committing an offence
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` (JUST TRUE) FALSE `s 84(1) kind: a thing that is none of those` TRUE FALSE FALSE EQUALS JUST FALSE   -- possesses a weapon with neither purpose
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` (JUST TRUE) FALSE `s 84(1) kind: a thing that is none of those` FALSE TRUE FALSE EQUALS JUST FALSE   -- does not carry or possess it
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` (JUST FALSE) TRUE `s 84(1) kind: a thing that is none of those` TRUE TRUE FALSE EQUALS JUST TRUE   -- an imitation of a weapon
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` (JUST FALSE) FALSE `s 84(1) kind: a replica firearm` TRUE TRUE FALSE EQUALS JUST TRUE   -- a replica firearm (a prohibited device)
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` (JUST FALSE) FALSE `s 84(1) kind: a prohibited device other than a replica firearm` TRUE TRUE FALSE EQUALS JUST TRUE   -- a prohibited device
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` (JUST FALSE) FALSE `s 84(1) kind: ammunition other than prohibited ammunition` TRUE TRUE FALSE EQUALS JUST TRUE   -- ammunition
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` (JUST FALSE) FALSE `s 84(1) kind: prohibited ammunition` TRUE TRUE FALSE EQUALS JUST TRUE   -- prohibited ammunition
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` (JUST FALSE) FALSE `s 84(1) kind: a firearm part` TRUE TRUE FALSE EQUALS JUST FALSE   -- a firearm part is not named, and it is not a weapon
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` (JUST FALSE) FALSE `s 84(1) kind: a thing that is none of those` TRUE TRUE FALSE EQUALS JUST FALSE   -- not a weapon and none of the things named
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` NOTHING FALSE `s 84(1) kind: a thing that is none of those` TRUE TRUE FALSE EQUALS NOTHING   -- whether it is a weapon is not covered, dangerous purpose
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` NOTHING FALSE `s 84(1) kind: ammunition other than prohibited ammunition` TRUE TRUE FALSE EQUALS JUST TRUE   -- whether it is a weapon is not covered but it is ammunition
#ASSERT `s 88(1) the person commits an offence of possession of a weapon for a dangerous purpose` NOTHING FALSE `s 84(1) kind: a thing that is none of those` TRUE FALSE FALSE EQUALS JUST FALSE   -- whether it is a weapon is not covered, no dangerous purpose

-- `s 88(2) the class of the offence`
#ASSERT `s 88(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`  -- both indictable and punishable on summary conviction

-- `s 88(2)(a) the punishment on indictment`
#ASSERT `s 88(2)(a) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `ten years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 88(2)(b) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 88(2)(b) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

§§ `Section 89`

-- `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting`
-- inputs, in the order of the GIVEN:
--   1. s 2 weapon: the thing is a weapon (MAYBE BOOLEAN)
--   2. the kind of thing (`s 84(1) kind of thing`)
--   3. the person carries it (BOOLEAN)
--   4. the person is attending or is on the way to attend a public meeting (BOOLEAN)
--   5. the person has a lawful excuse (BOOLEAN)
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` (JUST TRUE) `s 84(1) kind: a thing that is none of those` TRUE TRUE FALSE EQUALS JUST TRUE   -- carries a weapon while attending a public meeting
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` (JUST TRUE) `s 84(1) kind: a thing that is none of those` TRUE TRUE FALSE EQUALS JUST TRUE   -- on the way to attend a public meeting (the same input)
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` (JUST TRUE) `s 84(1) kind: a thing that is none of those` TRUE FALSE FALSE EQUALS JUST FALSE   -- not attending or on the way to a public meeting
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` (JUST TRUE) `s 84(1) kind: a thing that is none of those` FALSE TRUE FALSE EQUALS JUST FALSE   -- does not carry it
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` (JUST TRUE) `s 84(1) kind: a thing that is none of those` TRUE TRUE TRUE EQUALS NOTHING   -- with lawful excuse: "without lawful excuse" limits the prohibition
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` (JUST TRUE) `s 84(1) kind: a thing that is none of those` TRUE FALSE TRUE EQUALS JUST FALSE   -- with lawful excuse but not attending
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` (JUST FALSE) `s 84(1) kind: a prohibited device other than a replica firearm` TRUE TRUE FALSE EQUALS JUST TRUE   -- a prohibited device, not a weapon
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` (JUST FALSE) `s 84(1) kind: a replica firearm` TRUE TRUE FALSE EQUALS JUST TRUE   -- a replica firearm
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` (JUST FALSE) `s 84(1) kind: ammunition other than prohibited ammunition` TRUE TRUE FALSE EQUALS JUST TRUE   -- ammunition
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` (JUST FALSE) `s 84(1) kind: prohibited ammunition` TRUE TRUE FALSE EQUALS JUST TRUE   -- prohibited ammunition
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` (JUST FALSE) `s 84(1) kind: a thing that is none of those` TRUE TRUE FALSE EQUALS JUST FALSE   -- not a weapon and none of the things named
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` NOTHING `s 84(1) kind: a thing that is none of those` TRUE TRUE FALSE EQUALS NOTHING   -- whether it is a weapon is not covered
#ASSERT `s 89(1) the person commits an offence of carrying a weapon while attending a public meeting` NOTHING `s 84(1) kind: a prohibited device other than a replica firearm` TRUE TRUE FALSE EQUALS JUST TRUE   -- whether it is a weapon is not covered but it is a prohibited device

-- `s 89(2) the class of the offence`
#ASSERT `s 89(2) the class of the offence` EQUALS `an offence punishable on summary conviction`  -- summary conviction only

-- `s 89(2) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 89(2) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

§§ `Section 90`

-- `s 90(1) the person commits an offence of carrying a concealed weapon`
-- inputs, in the order of the GIVEN:
--   1. s 2 weapon: the thing is a weapon (MAYBE BOOLEAN)
--   2. the kind of thing (`s 84(1) kind of thing`)
--   3. the person carries it concealed (BOOLEAN)
--   4. the person is authorized under the Firearms Act to carry it concealed (BOOLEAN)
#ASSERT `s 90(1) the person commits an offence of carrying a concealed weapon` (JUST TRUE) `s 84(1) kind: a thing that is none of those` TRUE FALSE EQUALS JUST TRUE   -- carries a weapon concealed
#ASSERT `s 90(1) the person commits an offence of carrying a concealed weapon` (JUST TRUE) `s 84(1) kind: a thing that is none of those` TRUE TRUE EQUALS JUST FALSE   -- authorized under the Firearms Act to carry it concealed: "unless"
#ASSERT `s 90(1) the person commits an offence of carrying a concealed weapon` (JUST TRUE) `s 84(1) kind: a thing that is none of those` FALSE FALSE EQUALS JUST FALSE   -- does not carry it concealed
#ASSERT `s 90(1) the person commits an offence of carrying a concealed weapon` (JUST TRUE) `s 84(1) kind: a thing that is none of those` FALSE TRUE EQUALS JUST FALSE   -- authorized and not concealed
#ASSERT `s 90(1) the person commits an offence of carrying a concealed weapon` (JUST FALSE) `s 84(1) kind: a prohibited device other than a replica firearm` TRUE FALSE EQUALS JUST TRUE   -- a prohibited device, not a weapon
#ASSERT `s 90(1) the person commits an offence of carrying a concealed weapon` (JUST FALSE) `s 84(1) kind: a replica firearm` TRUE FALSE EQUALS JUST TRUE   -- a replica firearm
#ASSERT `s 90(1) the person commits an offence of carrying a concealed weapon` (JUST FALSE) `s 84(1) kind: prohibited ammunition` TRUE FALSE EQUALS JUST TRUE   -- prohibited ammunition
#ASSERT `s 90(1) the person commits an offence of carrying a concealed weapon` (JUST FALSE) `s 84(1) kind: ammunition other than prohibited ammunition` TRUE FALSE EQUALS JUST FALSE   -- ordinary ammunition is not named in this subsection
#ASSERT `s 90(1) the person commits an offence of carrying a concealed weapon` NOTHING `s 84(1) kind: a thing that is none of those` TRUE FALSE EQUALS NOTHING   -- whether it is a weapon is not covered
#ASSERT `s 90(1) the person commits an offence of carrying a concealed weapon` NOTHING `s 84(1) kind: a prohibited device other than a replica firearm` TRUE FALSE EQUALS JUST TRUE   -- whether it is a weapon is not covered but it is a prohibited device

-- `s 90(2) the class of the offence`
#ASSERT `s 90(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`  -- both indictable and punishable on summary conviction

-- `s 90(2)(a) the punishment on indictment`
#ASSERT `s 90(2)(a) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `five years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 90(2)(b) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 90(2)(b) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

§§ `Section 91`

-- `s 91(1) the person commits an offence of unauthorized possession of a firearm`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing possessed (`s 84(1) kind of thing`)
--   2. the person possesses it (BOOLEAN)
--   3. the person is the holder of a licence under which the person may possess it (BOOLEAN)
--   4. the person is the holder of a registration certificate for it (BOOLEAN)
--   5. s 91(4) subsections (1) and (2) do not apply to the person (MAYBE BOOLEAN)
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a prohibited firearm` TRUE FALSE FALSE NOTHING EQUALS JUST TRUE   -- a prohibited firearm, no licence and no registration certificate
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE NOTHING EQUALS JUST TRUE   -- a prohibited firearm, a licence but no registration certificate: (a) AND (b) are both required
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a prohibited firearm` TRUE FALSE TRUE NOTHING EQUALS JUST TRUE   -- a prohibited firearm, a registration certificate but no licence
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a prohibited firearm` TRUE TRUE TRUE NOTHING EQUALS NOTHING   -- a prohibited firearm, a licence and a registration certificate: "without being the holder of" limits the prohibition
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a restricted firearm` TRUE TRUE FALSE NOTHING EQUALS JUST TRUE   -- a restricted firearm, a licence but no registration certificate
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a restricted firearm` TRUE TRUE TRUE NOTHING EQUALS NOTHING   -- a restricted firearm, a licence and a registration certificate
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a non-restricted firearm` TRUE FALSE FALSE NOTHING EQUALS JUST TRUE   -- a non-restricted firearm, no licence
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a non-restricted firearm` TRUE TRUE FALSE NOTHING EQUALS NOTHING   -- a non-restricted firearm, a licence: no certificate is needed "in the case of a prohibited firearm or a restricted firearm"
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a non-restricted firearm` TRUE FALSE TRUE NOTHING EQUALS JUST TRUE   -- a non-restricted firearm, a registration certificate but no licence
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a prohibited firearm` FALSE FALSE FALSE NOTHING EQUALS JUST FALSE   -- does not possess it
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a prohibited weapon` TRUE FALSE FALSE NOTHING EQUALS JUST FALSE   -- a prohibited weapon is not named in subsection (1)
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a firearm part` TRUE FALSE FALSE NOTHING EQUALS JUST FALSE   -- a firearm part is not named
#ASSERT `s 91(1) the person commits an offence of unauthorized possession of a firearm` `s 84(1) kind: a prohibited firearm` TRUE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE   -- subsection (4) says (1) and (2) do not apply to the person

-- `s 91(2) the person commits an offence of unauthorized possession of a prohibited weapon or restricted weapon`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing possessed (`s 84(1) kind of thing`)
--   2. the person possesses it (BOOLEAN)
--   3. the person is the holder of a licence under which the person may possess it (BOOLEAN)
--   4. s 91(4) subsections (1) and (2) do not apply to the person (MAYBE BOOLEAN)
#ASSERT `s 91(2) the person commits an offence of unauthorized possession of a prohibited weapon or restricted weapon` `s 84(1) kind: a prohibited weapon` TRUE FALSE NOTHING EQUALS JUST TRUE   -- a prohibited weapon, no licence
#ASSERT `s 91(2) the person commits an offence of unauthorized possession of a prohibited weapon or restricted weapon` `s 84(1) kind: a restricted weapon` TRUE FALSE NOTHING EQUALS JUST TRUE   -- a restricted weapon
#ASSERT `s 91(2) the person commits an offence of unauthorized possession of a prohibited weapon or restricted weapon` `s 84(1) kind: a prohibited device other than a replica firearm` TRUE FALSE NOTHING EQUALS JUST TRUE   -- a prohibited device other than a replica firearm
#ASSERT `s 91(2) the person commits an offence of unauthorized possession of a prohibited weapon or restricted weapon` `s 84(1) kind: prohibited ammunition` TRUE FALSE NOTHING EQUALS JUST TRUE   -- prohibited ammunition
#ASSERT `s 91(2) the person commits an offence of unauthorized possession of a prohibited weapon or restricted weapon` `s 84(1) kind: a replica firearm` TRUE FALSE NOTHING EQUALS JUST FALSE   -- a replica firearm: "other than a replica firearm"
#ASSERT `s 91(2) the person commits an offence of unauthorized possession of a prohibited weapon or restricted weapon` `s 84(1) kind: ammunition other than prohibited ammunition` TRUE FALSE NOTHING EQUALS JUST FALSE   -- ordinary ammunition is not named
#ASSERT `s 91(2) the person commits an offence of unauthorized possession of a prohibited weapon or restricted weapon` `s 84(1) kind: a prohibited firearm` TRUE FALSE NOTHING EQUALS JUST FALSE   -- a prohibited firearm is named in subsection (1), not (2)
#ASSERT `s 91(2) the person commits an offence of unauthorized possession of a prohibited weapon or restricted weapon` `s 84(1) kind: a prohibited weapon` TRUE TRUE NOTHING EQUALS NOTHING   -- holder of a licence under which the person may possess it: "without being the holder of" limits the prohibition
#ASSERT `s 91(2) the person commits an offence of unauthorized possession of a prohibited weapon or restricted weapon` `s 84(1) kind: a prohibited weapon` FALSE FALSE NOTHING EQUALS JUST FALSE   -- does not possess it
#ASSERT `s 91(2) the person commits an offence of unauthorized possession of a prohibited weapon or restricted weapon` `s 84(1) kind: a prohibited weapon` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE   -- subsection (4) says (1) and (2) do not apply to the person

-- `s 91(3) the class of the offence`
#ASSERT `s 91(3) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`  -- both indictable and punishable on summary conviction

-- `s 91(3)(a) the punishment on indictment`
#ASSERT `s 91(3)(a) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `five years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 91(3)(b) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 91(3)(b) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

-- `s 91(4) subsections (1) and (2) do not apply to the person`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing (`s 84(1) kind of thing`)
--   2. the person is under the direct and immediate supervision of a person who may lawfully possess it (BOOLEAN)
--   3. the person possesses it for the purpose of using it in a manner in which the supervising person may lawfully use it (BOOLEAN)
--   4. the person comes into possession of it by the operation of law (BOOLEAN)
--   5. within a reasonable period after acquiring possession of it the person lawfully disposes of it (BOOLEAN)
--   6. within a reasonable period after acquiring possession of it the person obtains a licence under which the person may possess it (BOOLEAN)
--   7. within a reasonable period after acquiring possession of it the person obtains a registration certificate for it (BOOLEAN)
#ASSERT `s 91(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a) under the direct and immediate supervision of a person who may lawfully possess it, for the purpose of using it in the manner that person may lawfully use it
#ASSERT `s 91(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- (a) supervised but not for that purpose: not within the paragraph
#ASSERT `s 91(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- (a) for that purpose but not supervised
#ASSERT `s 91(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- (b)(i) comes into possession by the operation of law and lawfully disposes of it within a reasonable period
#ASSERT `s 91(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE FALSE TRUE FALSE TRUE TRUE EQUALS JUST TRUE   -- (b)(ii) by the operation of law, obtains a licence and (prohibited firearm) a registration certificate
#ASSERT `s 91(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE FALSE TRUE FALSE TRUE FALSE EQUALS NOTHING   -- (b)(ii) by the operation of law, obtains a licence but not the registration certificate a prohibited firearm needs
#ASSERT `s 91(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a restricted firearm` FALSE FALSE TRUE FALSE TRUE FALSE EQUALS NOTHING   -- (b)(ii) a restricted firearm: the registration certificate is needed too
#ASSERT `s 91(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a non-restricted firearm` FALSE FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b)(ii) a non-restricted firearm: a licence is enough
#ASSERT `s 91(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited weapon` FALSE FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b)(ii) a prohibited weapon: a licence is enough
#ASSERT `s 91(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING   -- (b) by the operation of law but neither disposes nor obtains
#ASSERT `s 91(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING   -- (b) disposes of it but did not come into possession by the operation of law
#ASSERT `s 91(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- neither paragraph: the text says nothing of anyone else

-- (5) is shown repealed
#ASSERT `s 91(5) as the text shows it` EQUALS "(5) [Repealed, 2012, c. 6, s. 2]"   -- the text shows "(5) [Repealed, 2012, c. 6, s. 2]"

§§ `Section 92`

-- `s 92(1) the person commits an offence of possession of a firearm knowing its possession is unauthorized`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing possessed (`s 84(1) kind of thing`)
--   2. the person possesses it (BOOLEAN)
--   3. the person is the holder of a licence under which the person may possess it (BOOLEAN)
--   4. the person is the holder of a registration certificate for it (BOOLEAN)
--   5. the person knows that the person is not the holder of what the subsection requires (BOOLEAN)
--   6. s 92(4) subsections (1) and (2) do not apply to the person (MAYBE BOOLEAN)
#ASSERT `s 92(1) the person commits an offence of possession of a firearm knowing its possession is unauthorized` `s 84(1) kind: a prohibited firearm` TRUE FALSE FALSE TRUE NOTHING EQUALS JUST TRUE   -- a prohibited firearm, no licence and no certificate, knowing it
#ASSERT `s 92(1) the person commits an offence of possession of a firearm knowing its possession is unauthorized` `s 84(1) kind: a prohibited firearm` TRUE FALSE FALSE FALSE NOTHING EQUALS JUST FALSE   -- the same, not knowing that the person is not the holder
#ASSERT `s 92(1) the person commits an offence of possession of a firearm knowing its possession is unauthorized` `s 84(1) kind: a prohibited firearm` TRUE TRUE TRUE TRUE NOTHING EQUALS JUST FALSE   -- a licence and a certificate: the person is the holder
#ASSERT `s 92(1) the person commits an offence of possession of a firearm knowing its possession is unauthorized` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE TRUE NOTHING EQUALS JUST TRUE   -- a prohibited firearm, a licence but no certificate, knowing it
#ASSERT `s 92(1) the person commits an offence of possession of a firearm knowing its possession is unauthorized` `s 84(1) kind: a non-restricted firearm` TRUE TRUE FALSE TRUE NOTHING EQUALS JUST FALSE   -- a non-restricted firearm, a licence: no certificate is needed
#ASSERT `s 92(1) the person commits an offence of possession of a firearm knowing its possession is unauthorized` `s 84(1) kind: a non-restricted firearm` TRUE FALSE FALSE TRUE NOTHING EQUALS JUST TRUE   -- a non-restricted firearm, no licence, knowing it
#ASSERT `s 92(1) the person commits an offence of possession of a firearm knowing its possession is unauthorized` `s 84(1) kind: a restricted firearm` TRUE FALSE TRUE TRUE NOTHING EQUALS JUST TRUE   -- a restricted firearm, a certificate but no licence, knowing it
#ASSERT `s 92(1) the person commits an offence of possession of a firearm knowing its possession is unauthorized` `s 84(1) kind: a prohibited firearm` FALSE FALSE FALSE TRUE NOTHING EQUALS JUST FALSE   -- does not possess it
#ASSERT `s 92(1) the person commits an offence of possession of a firearm knowing its possession is unauthorized` `s 84(1) kind: a prohibited weapon` TRUE FALSE FALSE TRUE NOTHING EQUALS JUST FALSE   -- a prohibited weapon is not named in subsection (1)
#ASSERT `s 92(1) the person commits an offence of possession of a firearm knowing its possession is unauthorized` `s 84(1) kind: a prohibited firearm` TRUE FALSE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE   -- subsection (4) says (1) and (2) do not apply to the person

-- `s 92(2) the person commits an offence of possession of a prohibited weapon, device or ammunition knowing its possession is unauthorized`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing possessed (`s 84(1) kind of thing`)
--   2. the person possesses it (BOOLEAN)
--   3. the person is the holder of a licence under which the person may possess it (BOOLEAN)
--   4. the person knows that the person is not the holder of a licence under which the person may possess it (BOOLEAN)
--   5. s 92(4) subsections (1) and (2) do not apply to the person (MAYBE BOOLEAN)
#ASSERT `s 92(2) the person commits an offence of possession of a prohibited weapon, device or ammunition knowing its possession is unauthorized` `s 84(1) kind: a prohibited weapon` TRUE FALSE TRUE NOTHING EQUALS JUST TRUE   -- a prohibited weapon, no licence, knowing it
#ASSERT `s 92(2) the person commits an offence of possession of a prohibited weapon, device or ammunition knowing its possession is unauthorized` `s 84(1) kind: a restricted weapon` TRUE FALSE TRUE NOTHING EQUALS JUST TRUE   -- a restricted weapon
#ASSERT `s 92(2) the person commits an offence of possession of a prohibited weapon, device or ammunition knowing its possession is unauthorized` `s 84(1) kind: a prohibited device other than a replica firearm` TRUE FALSE TRUE NOTHING EQUALS JUST TRUE   -- a prohibited device other than a replica firearm
#ASSERT `s 92(2) the person commits an offence of possession of a prohibited weapon, device or ammunition knowing its possession is unauthorized` `s 84(1) kind: prohibited ammunition` TRUE FALSE TRUE NOTHING EQUALS JUST TRUE   -- prohibited ammunition
#ASSERT `s 92(2) the person commits an offence of possession of a prohibited weapon, device or ammunition knowing its possession is unauthorized` `s 84(1) kind: a replica firearm` TRUE FALSE TRUE NOTHING EQUALS JUST FALSE   -- a replica firearm: "other than a replica firearm"
#ASSERT `s 92(2) the person commits an offence of possession of a prohibited weapon, device or ammunition knowing its possession is unauthorized` `s 84(1) kind: a prohibited weapon` TRUE FALSE FALSE NOTHING EQUALS JUST FALSE   -- not knowing that the person is not the holder of a licence
#ASSERT `s 92(2) the person commits an offence of possession of a prohibited weapon, device or ammunition knowing its possession is unauthorized` `s 84(1) kind: a prohibited weapon` TRUE TRUE TRUE NOTHING EQUALS JUST FALSE   -- the holder of a licence
#ASSERT `s 92(2) the person commits an offence of possession of a prohibited weapon, device or ammunition knowing its possession is unauthorized` `s 84(1) kind: a prohibited weapon` FALSE FALSE TRUE NOTHING EQUALS JUST FALSE   -- does not possess it
#ASSERT `s 92(2) the person commits an offence of possession of a prohibited weapon, device or ammunition knowing its possession is unauthorized` `s 84(1) kind: a prohibited weapon` TRUE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE   -- subsection (4) says (1) and (2) do not apply to the person

-- `s 92(3) the class of the offence`
#ASSERT `s 92(3) the class of the offence` EQUALS `an indictable offence`  -- indictable only

-- `s 92(3) the punishment on indictment`
#ASSERT `s 92(3) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `ten years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 92(4) subsections (1) and (2) do not apply to the person`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing (`s 84(1) kind of thing`)
--   2. the person is under the direct and immediate supervision of a person who may lawfully possess it (BOOLEAN)
--   3. the person possesses it for the purpose of using it in a manner in which the supervising person may lawfully use it (BOOLEAN)
--   4. the person comes into possession of it by the operation of law (BOOLEAN)
--   5. within a reasonable period after acquiring possession of it the person lawfully disposes of it (BOOLEAN)
--   6. within a reasonable period after acquiring possession of it the person obtains a licence under which the person may possess it (BOOLEAN)
--   7. within a reasonable period after acquiring possession of it the person obtains a registration certificate for it (BOOLEAN)
#ASSERT `s 92(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a) under the direct and immediate supervision of a person who may lawfully possess it, for the purpose of using it in the manner that person may lawfully use it
#ASSERT `s 92(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- (a) supervised but not for that purpose: not within the paragraph
#ASSERT `s 92(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- (a) for that purpose but not supervised
#ASSERT `s 92(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- (b)(i) comes into possession by the operation of law and lawfully disposes of it within a reasonable period
#ASSERT `s 92(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE FALSE TRUE FALSE TRUE TRUE EQUALS JUST TRUE   -- (b)(ii) by the operation of law, obtains a licence and (prohibited firearm) a registration certificate
#ASSERT `s 92(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE FALSE TRUE FALSE TRUE FALSE EQUALS NOTHING   -- (b)(ii) by the operation of law, obtains a licence but not the registration certificate a prohibited firearm needs
#ASSERT `s 92(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a restricted firearm` FALSE FALSE TRUE FALSE TRUE FALSE EQUALS NOTHING   -- (b)(ii) a restricted firearm: the registration certificate is needed too
#ASSERT `s 92(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a non-restricted firearm` FALSE FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b)(ii) a non-restricted firearm: a licence is enough
#ASSERT `s 92(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited weapon` FALSE FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b)(ii) a prohibited weapon: a licence is enough
#ASSERT `s 92(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING   -- (b) by the operation of law but neither disposes nor obtains
#ASSERT `s 92(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING   -- (b) disposes of it but did not come into possession by the operation of law
#ASSERT `s 92(4) subsections (1) and (2) do not apply to the person` `s 84(1) kind: a prohibited firearm` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- neither paragraph: the text says nothing of anyone else

-- (5) and (6) are shown repealed
#ASSERT `s 92(5) and (6) as the text shows them` EQUALS "(5) and (6) [Repealed, 2012, c. 6, s. 3]"   -- the text shows "(5) and (6) [Repealed, 2012, c. 6, s. 3]"

§§ `Section 93`

-- `s 93(1) the person commits an offence of possession at an unauthorized place`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing possessed (`s 84(1) kind of thing`)
--   2. the person is the holder of an authorization or a licence under which the person may possess it (BOOLEAN)
--   3. the person possesses it (BOOLEAN)
--   4. the place is indicated on the authorization or licence as being a place where the person may not possess it (BOOLEAN)
--   5. the place is other than a place indicated on the authorization or licence as being a place where the person may possess it (BOOLEAN)
--   6. the place is other than a place where it may be possessed under the Firearms Act (BOOLEAN)
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: a prohibited firearm` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- (a) a place indicated on the licence as one where the person may not possess it
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b) a place other than one indicated as a place where the person may possess it
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- (c) a place other than one where it may be possessed under the Firearms Act
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- the holder possesses it at none of those places
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: a prohibited firearm` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- not the holder of an authorization or a licence
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: a prohibited firearm` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- does not possess it
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: a replica firearm` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- a replica firearm: subsection (3)
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: a prohibited weapon` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- a prohibited weapon
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: a restricted weapon` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- a restricted weapon
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: a prohibited device other than a replica firearm` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- a prohibited device other than a replica firearm
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: prohibited ammunition` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- prohibited ammunition
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: a non-restricted firearm` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- a non-restricted firearm
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: ammunition other than prohibited ammunition` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- ordinary ammunition is not named ("prohibited ammunition")
#ASSERT `s 93(1) the person commits an offence of possession at an unauthorized place` `s 84(1) kind: a firearm part` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- a firearm part is not named

-- `s 93(2) the class of the offence`
#ASSERT `s 93(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`  -- both indictable and punishable on summary conviction

-- `s 93(2)(a) the punishment on indictment`
#ASSERT `s 93(2)(a) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `five years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 93(2)(b) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 93(2)(b) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

-- `s 93(3) subsection (1) does not apply to a person who possesses a replica firearm`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing possessed (`s 84(1) kind of thing`)
#ASSERT `s 93(3) subsection (1) does not apply to a person who possesses a replica firearm` `s 84(1) kind: a replica firearm` EQUALS JUST TRUE   -- a replica firearm
#ASSERT `s 93(3) subsection (1) does not apply to a person who possesses a replica firearm` `s 84(1) kind: a prohibited firearm` EQUALS NOTHING   -- a prohibited firearm: the text says nothing
#ASSERT `s 93(3) subsection (1) does not apply to a person who possesses a replica firearm` `s 84(1) kind: a prohibited device other than a replica firearm` EQUALS NOTHING   -- a prohibited device other than a replica firearm

§§ `Section 94`

-- `s 94(1)(a) the occupant is within the exception for a firearm`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing (`s 84(1) kind of thing`)
--   2. the person or any other occupant is the holder of a licence under which the person or other occupant may possess the firearm (BOOLEAN)
--   3. the person or any other occupant is the holder of an authorization and a registration certificate for it (BOOLEAN)
--   4. the person had reasonable grounds to believe that any other occupant was the holder of a licence under which that other occupant may possess the firearm (BOOLEAN)
--   5. the person had reasonable grounds to believe that any other occupant was the holder of an authorization and a registration certificate for it (BOOLEAN)
--   6. the person had reasonable grounds to believe that any other occupant was a person who could not be convicted of an offence under this Act by reason of sections 117.07 to 117.1 or any other Act of Parliament (BOOLEAN)
#ASSERT `s 94(1)(a) the occupant is within the exception for a firearm` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- (i) the person or another occupant holds a licence and, for a prohibited firearm, an authorization and a registration certificate
#ASSERT `s 94(1)(a) the occupant is within the exception for a firearm` `s 84(1) kind: a prohibited firearm` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- (i) a licence only, for a prohibited firearm
#ASSERT `s 94(1)(a) the occupant is within the exception for a firearm` `s 84(1) kind: a prohibited firearm` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- (i) an authorization and certificate only
#ASSERT `s 94(1)(a) the occupant is within the exception for a firearm` `s 84(1) kind: a non-restricted firearm` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- (i) a non-restricted firearm: a licence is enough
#ASSERT `s 94(1)(a) the occupant is within the exception for a firearm` `s 84(1) kind: a restricted firearm` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- (i) a restricted firearm: a licence only is not enough
#ASSERT `s 94(1)(a) the occupant is within the exception for a firearm` `s 84(1) kind: a prohibited firearm` FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE   -- (ii) reasonable grounds to believe another occupant held the licence and the authorization and certificate
#ASSERT `s 94(1)(a) the occupant is within the exception for a firearm` `s 84(1) kind: a prohibited firearm` FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- (ii) reasonable grounds to believe only a licence, for a prohibited firearm
#ASSERT `s 94(1)(a) the occupant is within the exception for a firearm` `s 84(1) kind: a non-restricted firearm` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- (ii) a non-restricted firearm: belief in a licence is enough
#ASSERT `s 94(1)(a) the occupant is within the exception for a firearm` `s 84(1) kind: a prohibited firearm` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- (iii) reasonable grounds to believe another occupant could not be convicted by reason of sections 117.07 to 117.1 or any other Act
#ASSERT `s 94(1)(a) the occupant is within the exception for a firearm` `s 84(1) kind: a prohibited firearm` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- none of (i), (ii), (iii)

-- `s 94(1)(b) the occupant is within the exception for a weapon, device or ammunition`
-- inputs, in the order of the GIVEN:
--   1. the person or any other occupant is the holder of an authorization or a licence under which the person or other occupant may transport it (BOOLEAN)
--   2. the person had reasonable grounds to believe that any other occupant was the holder of an authorization or a licence under which that other occupant may transport it (BOOLEAN)
--   3. the person had reasonable grounds to believe that any other occupant was a person who could not be convicted of an offence under this Act by reason of sections 117.07 to 117.1 or any other Act of Parliament (BOOLEAN)
#ASSERT `s 94(1)(b) the occupant is within the exception for a weapon, device or ammunition` TRUE FALSE FALSE EQUALS JUST TRUE   -- (i) the person or another occupant holds an authorization or licence to transport it
#ASSERT `s 94(1)(b) the occupant is within the exception for a weapon, device or ammunition` FALSE TRUE FALSE EQUALS JUST TRUE   -- (ii)(A) reasonable grounds to believe another occupant held one
#ASSERT `s 94(1)(b) the occupant is within the exception for a weapon, device or ammunition` FALSE FALSE TRUE EQUALS JUST TRUE   -- (ii)(B) reasonable grounds to believe another occupant could not be convicted by reason of sections 117.07 to 117.1 or any other Act
#ASSERT `s 94(1)(b) the occupant is within the exception for a weapon, device or ammunition` FALSE FALSE FALSE EQUALS JUST FALSE   -- none

-- `s 94(3) subsection (1) does not apply to an occupant who attempted to leave or left the motor vehicle`
-- inputs, in the order of the GIVEN:
--   1. on becoming aware of the presence of it in the motor vehicle the person attempted to leave the motor vehicle, to the extent that it was feasible to do so (BOOLEAN)
--   2. on becoming aware of the presence of it in the motor vehicle the person actually left the motor vehicle (BOOLEAN)
#ASSERT `s 94(3) subsection (1) does not apply to an occupant who attempted to leave or left the motor vehicle` TRUE FALSE EQUALS JUST TRUE   -- on becoming aware, attempted to leave to the extent feasible
#ASSERT `s 94(3) subsection (1) does not apply to an occupant who attempted to leave or left the motor vehicle` FALSE TRUE EQUALS JUST TRUE   -- on becoming aware, actually left
#ASSERT `s 94(3) subsection (1) does not apply to an occupant who attempted to leave or left the motor vehicle` FALSE FALSE EQUALS NOTHING   -- neither: the text says nothing of the occupant who stayed

-- `s 94(4) subsection (1) does not apply when an occupant came into possession by the operation of law`
-- inputs, in the order of the GIVEN:
--   1. the occupant or any other occupant is a person who came into possession of it by the operation of law (BOOLEAN)
#ASSERT `s 94(4) subsection (1) does not apply when an occupant came into possession by the operation of law` TRUE EQUALS JUST TRUE   -- the occupant or another occupant came into possession by the operation of law
#ASSERT `s 94(4) subsection (1) does not apply when an occupant came into possession by the operation of law` FALSE EQUALS NOTHING   -- no one did: the text says nothing

-- `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle`
-- inputs, in the order of the GIVEN:
--   1. s 2 motor vehicle: the vehicle is a motor vehicle (MAYBE BOOLEAN)
--   2. the person is an occupant of the vehicle (BOOLEAN)
--   3. the kind of thing (`s 84(1) kind of thing`)
--   4. the person knows there is such a thing in the vehicle (BOOLEAN)
--   5. s 94(1)(a) the occupant is within the exception for a firearm (MAYBE BOOLEAN)
--   6. s 94(1)(b) the occupant is within the exception for a weapon, device or ammunition (MAYBE BOOLEAN)
--   7. s 94(3) subsection (1) does not apply to an occupant who attempted to leave or left the motor vehicle (MAYBE BOOLEAN)
--   8. s 94(4) subsection (1) does not apply when an occupant came into possession by the operation of law (MAYBE BOOLEAN)
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a prohibited firearm` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST TRUE   -- an occupant who knows there is a prohibited firearm and no exception holds
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a restricted firearm` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST TRUE   -- a restricted firearm
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a non-restricted firearm` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST TRUE   -- a non-restricted firearm
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a prohibited weapon` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST TRUE   -- a prohibited weapon
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a restricted weapon` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST TRUE   -- a restricted weapon
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a prohibited device other than a replica firearm` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST TRUE   -- a prohibited device other than a replica firearm
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: prohibited ammunition` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST TRUE   -- prohibited ammunition
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a replica firearm` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE   -- a replica firearm: "other than a replica firearm"
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: ammunition other than prohibited ammunition` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE   -- ordinary ammunition is not named
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a firearm part` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE   -- a firearm part is not named
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) FALSE `s 84(1) kind: a prohibited firearm` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE   -- the person is not an occupant
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a prohibited firearm` FALSE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE   -- the person does not know there is such a thing in the vehicle
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a prohibited firearm` TRUE (JUST TRUE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE   -- "unless" (a): the exception for a firearm is met
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a prohibited firearm` TRUE (JUST FALSE) (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE   -- "unless" (b) is met but the thing is a firearm: the exception that applies is (a)
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a prohibited weapon` TRUE (JUST TRUE) (JUST FALSE) NOTHING NOTHING EQUALS JUST TRUE   -- a prohibited weapon with the firearm exception met: the exception that applies is (b)
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a prohibited weapon` TRUE (JUST FALSE) (JUST TRUE) NOTHING NOTHING EQUALS JUST FALSE   -- a prohibited weapon with the exception for weapons met
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a prohibited firearm` TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) NOTHING EQUALS JUST FALSE   -- subsection (3): attempted to leave or left
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST TRUE) TRUE `s 84(1) kind: a prohibited firearm` TRUE (JUST FALSE) (JUST FALSE) NOTHING (JUST TRUE) EQUALS JUST FALSE   -- subsection (4): an occupant came into possession by the operation of law
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` (JUST FALSE) TRUE `s 84(1) kind: a prohibited firearm` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE   -- the vehicle is not a motor vehicle
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` NOTHING TRUE `s 84(1) kind: a prohibited firearm` TRUE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS NOTHING   -- whether the vehicle is a motor vehicle is not covered
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` NOTHING TRUE `s 84(1) kind: a prohibited firearm` TRUE (JUST TRUE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE   -- whether the vehicle is a motor vehicle is not covered, but the exception is met
#ASSERT `s 94(1) the person commits an offence of unauthorized possession in a motor vehicle` NOTHING TRUE `s 84(1) kind: a prohibited firearm` FALSE (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE   -- whether the vehicle is a motor vehicle is not covered, and the person does not know of the thing

-- `s 94(2) the class of the offence`
#ASSERT `s 94(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`  -- both indictable and punishable on summary conviction

-- `s 94(2)(a) the punishment on indictment`
#ASSERT `s 94(2)(a) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `ten years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 94(2)(b) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 94(2)(b) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

-- (5) is shown repealed
#ASSERT `s 94(5) as the text shows it` EQUALS "(5) [Repealed, 2012, c. 6, s. 4]"   -- the text shows "(5) [Repealed, 2012, c. 6, s. 4]"

§§ `Section 95`

-- `s 95(1) the person commits an offence of possession of a prohibited or restricted firearm with ammunition`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing possessed (`s 84(1) kind of thing`)
--   2. the person possesses it in a place (BOOLEAN)
--   3. it is loaded (BOOLEAN)
--   4. it is unloaded and the person possesses readily accessible ammunition that is capable of being discharged in the firearm (BOOLEAN)
--   5. the person is the holder of an authorization or a licence under which the person may possess the firearm in that place (BOOLEAN)
--   6. the person is the holder of the registration certificate for the firearm (BOOLEAN)
--   7. s 95(3) subsection (1) does not apply to the person (MAYBE BOOLEAN)
#ASSERT `s 95(1) the person commits an offence of possession of a prohibited or restricted firearm with ammunition` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE FALSE FALSE NOTHING EQUALS JUST TRUE   -- a loaded prohibited firearm, no authorization or licence and no certificate
#ASSERT `s 95(1) the person commits an offence of possession of a prohibited or restricted firearm with ammunition` `s 84(1) kind: a prohibited firearm` TRUE FALSE TRUE FALSE FALSE NOTHING EQUALS JUST TRUE   -- an unloaded prohibited firearm together with readily accessible ammunition
#ASSERT `s 95(1) the person commits an offence of possession of a prohibited or restricted firearm with ammunition` `s 84(1) kind: a prohibited firearm` TRUE FALSE FALSE FALSE FALSE NOTHING EQUALS JUST FALSE   -- an unloaded prohibited firearm without readily accessible ammunition
#ASSERT `s 95(1) the person commits an offence of possession of a prohibited or restricted firearm with ammunition` `s 84(1) kind: a restricted firearm` TRUE TRUE FALSE FALSE FALSE NOTHING EQUALS JUST TRUE   -- a loaded restricted firearm
#ASSERT `s 95(1) the person commits an offence of possession of a prohibited or restricted firearm with ammunition` `s 84(1) kind: a non-restricted firearm` TRUE TRUE FALSE FALSE FALSE NOTHING EQUALS JUST FALSE   -- a loaded non-restricted firearm is not named
#ASSERT `s 95(1) the person commits an offence of possession of a prohibited or restricted firearm with ammunition` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE TRUE TRUE NOTHING EQUALS NOTHING   -- holder of both an authorization or licence for that place and the registration certificate
#ASSERT `s 95(1) the person commits an offence of possession of a prohibited or restricted firearm with ammunition` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE TRUE FALSE NOTHING EQUALS JUST TRUE   -- holder of the authorization or licence only: (a) and (b) are both required
#ASSERT `s 95(1) the person commits an offence of possession of a prohibited or restricted firearm with ammunition` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE FALSE TRUE NOTHING EQUALS JUST TRUE   -- holder of the certificate only
#ASSERT `s 95(1) the person commits an offence of possession of a prohibited or restricted firearm with ammunition` `s 84(1) kind: a prohibited firearm` FALSE TRUE FALSE FALSE FALSE NOTHING EQUALS JUST FALSE   -- does not possess it in a place
#ASSERT `s 95(1) the person commits an offence of possession of a prohibited or restricted firearm with ammunition` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE   -- subsection (3): using it under supervision

-- `s 95(2) the class of the offence`
#ASSERT `s 95(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`  -- both indictable and punishable on summary conviction

-- `s 95(2)(a) the punishment on indictment`
#ASSERT `s 95(2)(a) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 95(2)(b) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 95(2)(b) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

-- `s 95(3) subsection (1) does not apply to the person`
-- inputs, in the order of the GIVEN:
--   1. the person is using the firearm under the direct and immediate supervision of another person who is lawfully entitled to possess it (BOOLEAN)
--   2. the person is using the firearm in a manner in which that other person may lawfully use it (BOOLEAN)
#ASSERT `s 95(3) subsection (1) does not apply to the person` TRUE TRUE EQUALS JUST TRUE   -- using the firearm under the direct and immediate supervision of a person lawfully entitled to possess it, in the manner that person may lawfully use it
#ASSERT `s 95(3) subsection (1) does not apply to the person` TRUE FALSE EQUALS NOTHING   -- supervised but not in that manner
#ASSERT `s 95(3) subsection (1) does not apply to the person` FALSE TRUE EQUALS NOTHING   -- in that manner but not supervised

§§ `Section 96`

-- `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing possessed (`s 84(1) kind of thing`)
--   2. the person possesses it (BOOLEAN)
--   3. the person knows that it was obtained by the commission in Canada of an offence (BOOLEAN)
--   4. the person knows that it was obtained by an act or omission anywhere that, if it had occurred in Canada, would have constituted an offence (BOOLEAN)
--   5. s 96(3) subsection (1) does not apply to the person (MAYBE BOOLEAN)
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE NOTHING EQUALS JUST TRUE   -- possesses a prohibited firearm that the person knows was obtained by an offence committed in Canada
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE FALSE TRUE NOTHING EQUALS JUST TRUE   -- knows it was obtained by an act or omission abroad that would have been an offence in Canada
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE FALSE FALSE NOTHING EQUALS JUST FALSE   -- does not know how it was obtained
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: a restricted firearm` TRUE TRUE FALSE NOTHING EQUALS JUST TRUE   -- a restricted firearm
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: a non-restricted firearm` TRUE TRUE FALSE NOTHING EQUALS JUST TRUE   -- a non-restricted firearm
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: a prohibited weapon` TRUE TRUE FALSE NOTHING EQUALS JUST TRUE   -- a prohibited weapon
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: a restricted weapon` TRUE TRUE FALSE NOTHING EQUALS JUST TRUE   -- a restricted weapon
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: a replica firearm` TRUE TRUE FALSE NOTHING EQUALS JUST TRUE   -- a replica firearm (a prohibited device)
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: a prohibited device other than a replica firearm` TRUE TRUE FALSE NOTHING EQUALS JUST TRUE   -- a prohibited device
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: prohibited ammunition` TRUE TRUE FALSE NOTHING EQUALS JUST TRUE   -- a prohibited ammunition
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: ammunition other than prohibited ammunition` TRUE TRUE FALSE NOTHING EQUALS JUST FALSE   -- ordinary ammunition is not named ("any prohibited ammunition")
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: a firearm part` TRUE TRUE FALSE NOTHING EQUALS JUST FALSE   -- a firearm part is not named
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: a prohibited firearm` FALSE TRUE FALSE NOTHING EQUALS JUST FALSE   -- does not possess it
#ASSERT `s 96(1) the person commits an offence of possession of a weapon obtained by the commission of an offence` `s 84(1) kind: a prohibited firearm` TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE   -- subsection (3): came into possession by the operation of law and lawfully disposed of it

-- `s 96(2) the class of the offence`
#ASSERT `s 96(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`  -- both indictable and punishable on summary conviction

-- `s 96(2)(a) the punishment on indictment`
#ASSERT `s 96(2)(a) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS (`imprisonment for a term of` `fourteen years`), `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

-- `s 96(2)(b) the punishment on summary conviction`
-- inputs, in the order of the GIVEN:
--   1. s 787(1) the general penalty for an offence punishable on summary conviction (Punishment)
#ASSERT `s 96(2)(b) the punishment on summary conviction` `ccc4 test fixture: a stand-in for section 787(1)` EQUALS `ccc4 test fixture: a stand-in for section 787(1)`  -- the limb states no penalty: it returns the answer of section 787(1) given as input (a stand-in value)

-- `s 96(3) subsection (1) does not apply to the person`
-- inputs, in the order of the GIVEN:
--   1. the person comes into possession of it by the operation of law (BOOLEAN)
--   2. the person lawfully disposes of it within a reasonable period after acquiring possession of it (BOOLEAN)
#ASSERT `s 96(3) subsection (1) does not apply to the person` TRUE TRUE EQUALS JUST TRUE   -- came into possession by the operation of law and lawfully disposes of it within a reasonable period
#ASSERT `s 96(3) subsection (1) does not apply to the person` TRUE FALSE EQUALS NOTHING   -- by the operation of law but does not dispose of it
#ASSERT `s 96(3) subsection (1) does not apply to the person` FALSE TRUE EQUALS NOTHING   -- disposes of it but not by the operation of law

-- 97 is shown repealed
#ASSERT `s 97 as the text shows it` EQUALS "97 [Repealed before coming into force, 2008, c. 20, s. 3]"   -- the text shows "97 [Repealed before coming into force, 2008, c. 20, s. 3]"

§§ `Section 98`

-- `s 98(1) the person commits an offence of breaking and entering to steal a firearm`
-- inputs, in the order of the GIVEN:
--   1. the person breaks and enters a place (BOOLEAN)
--   2. the person intends to steal a firearm located in it (BOOLEAN)
--   3. the person steals a firearm located in it (BOOLEAN)
--   4. the person breaks out of a place (BOOLEAN)
--   5. the person had stolen a firearm located in the place before breaking out of it (BOOLEAN)
--   6. the person had entered the place with intent to steal a firearm located in it before breaking out of it (BOOLEAN)
#ASSERT `s 98(1) the person commits an offence of breaking and entering to steal a firearm` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a) breaks and enters a place with intent to steal a firearm located in it
#ASSERT `s 98(1) the person commits an offence of breaking and entering to steal a firearm` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- (b) breaks and enters a place and steals a firearm located in it
#ASSERT `s 98(1) the person commits an offence of breaking and entering to steal a firearm` FALSE FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE   -- (c)(i) breaks out of a place after stealing a firearm located in it
#ASSERT `s 98(1) the person commits an offence of breaking and entering to steal a firearm` FALSE FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE   -- (c)(ii) breaks out of a place after entering it with intent to steal a firearm located in it
#ASSERT `s 98(1) the person commits an offence of breaking and entering to steal a firearm` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- breaks and enters but has no intent and steals nothing
#ASSERT `s 98(1) the person commits an offence of breaking and entering to steal a firearm` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- intends to steal a firearm but does not break and enter
#ASSERT `s 98(1) the person commits an offence of breaking and entering to steal a firearm` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- breaks out of a place but had neither stolen a firearm nor entered with that intent
#ASSERT `s 98(1) the person commits an offence of breaking and entering to steal a firearm` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- steals a firearm but does not break and enter
#ASSERT `s 98(1) the person commits an offence of breaking and entering to steal a firearm` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- nothing

-- `s 98(2) place`
-- inputs, in the order of the GIVEN:
--   1. the thing (`s 98(2) kind of thing`)
#ASSERT `s 98(2) place` `s 98(2) place: a building` EQUALS JUST TRUE   -- building
#ASSERT `s 98(2) place` `s 98(2) place: a structure` EQUALS JUST TRUE   -- structure
#ASSERT `s 98(2) place` `s 98(2) place: part of a building or structure` EQUALS JUST TRUE   -- part of one
#ASSERT `s 98(2) place` `s 98(2) place: a motor vehicle` EQUALS JUST TRUE   -- motor vehicle
#ASSERT `s 98(2) place` `s 98(2) place: a vessel` EQUALS JUST TRUE   -- vessel
#ASSERT `s 98(2) place` `s 98(2) place: an aircraft` EQUALS JUST TRUE   -- aircraft
#ASSERT `s 98(2) place` `s 98(2) place: a railway vehicle` EQUALS JUST TRUE   -- railway vehicle
#ASSERT `s 98(2) place` `s 98(2) place: a container` EQUALS JUST TRUE   -- container
#ASSERT `s 98(2) place` `s 98(2) place: a trailer` EQUALS JUST TRUE   -- trailer
#ASSERT `s 98(2) place` `s 98(2) place: a thing that is none of those` EQUALS JUST FALSE   -- a thing that is none of those: "means" is closed

-- `s 98(2) break`
-- inputs, in the order of the GIVEN:
--   1. s 321 the person breaks (MAYBE BOOLEAN)
#ASSERT `s 98(2) break` (JUST TRUE) EQUALS JUST TRUE   -- the answer of section 321 is a yes
#ASSERT `s 98(2) break` (JUST FALSE) EQUALS JUST FALSE   -- a no
#ASSERT `s 98(2) break` NOTHING EQUALS NOTHING   -- not covered

-- `s 98(3)(a) the person enters`
-- inputs, in the order of the GIVEN:
--   1. any part of the person’s body is within the thing that is being entered (BOOLEAN)
--   2. any part of an instrument that the person uses is within the thing that is being entered (BOOLEAN)
#ASSERT `s 98(3)(a) the person enters` TRUE FALSE EQUALS JUST TRUE   -- any part of the body is within the thing being entered
#ASSERT `s 98(3)(a) the person enters` FALSE TRUE EQUALS JUST TRUE   -- any part of an instrument the person uses is within it
#ASSERT `s 98(3)(a) the person enters` FALSE FALSE EQUALS JUST FALSE   -- neither: not yet entered

-- `s 98(3)(b) the person is deemed to have broken and entered`
-- inputs, in the order of the GIVEN:
--   1. the person obtained entrance by a threat or an artifice or by collusion with a person within (BOOLEAN)
--   2. the person entered without lawful justification or excuse by a permanent or temporary opening (BOOLEAN)
#ASSERT `s 98(3)(b) the person is deemed to have broken and entered` TRUE FALSE EQUALS JUST TRUE   -- (i) obtained entrance by a threat or an artifice or by collusion with a person within
#ASSERT `s 98(3)(b) the person is deemed to have broken and entered` FALSE TRUE EQUALS JUST TRUE   -- (ii) entered without lawful justification or excuse by a permanent or temporary opening
#ASSERT `s 98(3)(b) the person is deemed to have broken and entered` FALSE FALSE EQUALS JUST FALSE   -- neither

-- `s 98(4) the class of the offence`
#ASSERT `s 98(4) the class of the offence` EQUALS `an indictable offence`  -- indictable only

-- `s 98(4) the punishment on indictment`
#ASSERT `s 98(4) the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS `imprisonment for life`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

§§ `Section 98.1`

-- `s 98.1 the person commits an offence of robbery to steal a firearm`
-- inputs, in the order of the GIVEN:
--   1. s 343 the person commits a robbery within the meaning of section 343 (MAYBE BOOLEAN)
--   2. the person commits it with intent to steal a firearm (BOOLEAN)
--   3. in the course of the robbery the person steals a firearm (BOOLEAN)
#ASSERT `s 98.1 the person commits an offence of robbery to steal a firearm` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE   -- a robbery within the meaning of section 343 with intent to steal a firearm
#ASSERT `s 98.1 the person commits an offence of robbery to steal a firearm` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- a robbery in the course of which the person steals a firearm
#ASSERT `s 98.1 the person commits an offence of robbery to steal a firearm` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE   -- a robbery with neither
#ASSERT `s 98.1 the person commits an offence of robbery to steal a firearm` (JUST FALSE) TRUE FALSE EQUALS JUST FALSE   -- not a robbery, with intent to steal a firearm
#ASSERT `s 98.1 the person commits an offence of robbery to steal a firearm` NOTHING TRUE FALSE EQUALS NOTHING   -- whether it is a robbery is not covered, with intent to steal a firearm
#ASSERT `s 98.1 the person commits an offence of robbery to steal a firearm` NOTHING FALSE FALSE EQUALS JUST FALSE   -- whether it is a robbery is not covered, and no intent and no theft of a firearm

-- `s 98.1 the class of the offence`
#ASSERT `s 98.1 the class of the offence` EQUALS `an indictable offence`  -- indictable only

-- `s 98.1 the punishment on indictment`
#ASSERT `s 98.1 the punishment on indictment` EQUALS (Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS `imprisonment for life`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`)   -- the indictable limb

