IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc6-builders`
IMPORT `ccc6-seizure`
IMPORT `ccc6-tests-support`

-- Tests for ss 164 to 164.3. Expected values decided from the text before each run.

§ `s 164(8) court means ...`
-- (the province, the court)
#ASSERT `s 164(8) court` Quebec `s 164(8)(a) the Court of Quebec` EQUALS JUST TRUE
#ASSERT `s 164(8) court` Quebec `s 164(8)(a) the municipal court of Montreal` EQUALS JUST TRUE
#ASSERT `s 164(8) court` Quebec `s 164(8)(a) the municipal court of Quebec` EQUALS JUST TRUE
#ASSERT `s 164(8) court` Ontario `s 164(8)(a) the Court of Quebec` EQUALS JUST FALSE   -- a court named for Quebec, offered for Ontario: the text's "means" closes the list (the keel's reading F7)
#ASSERT `s 164(8) court` Ontario `s 164(8)(a.1) the Superior Court of Justice` EQUALS JUST TRUE
#ASSERT `s 164(8) court` Quebec `s 164(8)(a.1) the Superior Court of Justice` EQUALS JUST FALSE
#ASSERT `s 164(8) court` `New Brunswick` `s 164(8)(b) the Court of Queen’s Bench` EQUALS JUST TRUE
#ASSERT `s 164(8) court` Manitoba `s 164(8)(b) the Court of Queen’s Bench` EQUALS JUST TRUE
#ASSERT `s 164(8) court` Saskatchewan `s 164(8)(b) the Court of Queen’s Bench` EQUALS JUST TRUE
#ASSERT `s 164(8) court` Alberta `s 164(8)(b) the Court of Queen’s Bench` EQUALS JUST TRUE
#ASSERT `s 164(8) court` Ontario `s 164(8)(b) the Court of Queen’s Bench` EQUALS JUST FALSE
#ASSERT `s 164(8) court` `Nova Scotia` `s 164(8)(d) the Supreme Court` EQUALS JUST TRUE
#ASSERT `s 164(8) court` `British Columbia` `s 164(8)(d) the Supreme Court` EQUALS JUST TRUE
#ASSERT `s 164(8) court` `Prince Edward Island` `s 164(8)(d) the Supreme Court` EQUALS JUST TRUE
#ASSERT `s 164(8) court` `Newfoundland and Labrador` `s 164(8)(d) the Supreme Court` EQUALS JUST TRUE
#ASSERT `s 164(8) court` Yukon `s 164(8)(d) the Supreme Court` EQUALS JUST TRUE
#ASSERT `s 164(8) court` `Northwest Territories` `s 164(8)(d) the Supreme Court` EQUALS JUST TRUE
#ASSERT `s 164(8) court` Alberta `s 164(8)(d) the Supreme Court` EQUALS JUST FALSE
#ASSERT `s 164(8) court` Nunavut `s 164(8)(e) the Nunavut Court of Justice` EQUALS JUST TRUE
#ASSERT `s 164(8) court` Yukon `s 164(8)(e) the Nunavut Court of Justice` EQUALS JUST FALSE
#ASSERT `s 164(8) court` Ontario `s 164(8) another court` EQUALS JUST FALSE
-- judge means a judge of a court: (the answer of s 164(8) court, the person is a judge of that court)
#ASSERT `s 164(8) judge` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 164(8) judge` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 164(8) judge` (JUST FALSE) TRUE EQUALS JUST FALSE   -- a judge of a body that is not a "court" of s 164(8)
#ASSERT `s 164(8) judge` NOTHING TRUE EQUALS NOTHING
-- illicit material means (a) to (g): seven limbs, each JUST TRUE, JUST FALSE or NOTHING
#ASSERT `s 164(8) illicit material` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- (a)
#ASSERT `s 164(8) illicit material` (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- (b)
#ASSERT `s 164(8) illicit material` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- (c)
#ASSERT `s 164(8) illicit material` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- (d)
#ASSERT `s 164(8) illicit material` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- (e)
#ASSERT `s 164(8) illicit material` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- (f)
#ASSERT `s 164(8) illicit material` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE   -- (g)
#ASSERT `s 164(8) illicit material` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- "means": none of the seven
#ASSERT `s 164(8) illicit material` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING   -- a limb not answered: not turned into "not illicit"
#ASSERT `s 164(8) illicit material` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING (JUST FALSE) EQUALS NOTHING   -- (f) is another part's offence
#ASSERT `s 164(8) illicit material` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- one limb holds whatever another says

§ `s 164(1) a warrant of seizure`
-- (reasonable grounds that the material is illicit, that copies are kept in premises within the jurisdiction, alleged to be described in paragraphs (a) to (d), reasonable grounds that copies are so kept for sale or distribution)
#ASSERT `s 164(1) a judge may issue a warrant authorizing seizure of copies of the material` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 164(1) a judge may issue a warrant authorizing seizure of copies of the material` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- material described in (a) to (d) and no ground that copies are kept for sale or distribution
#ASSERT `s 164(1) a judge may issue a warrant authorizing seizure of copies of the material` TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- (e) to (g) material: no sale or distribution limb
#ASSERT `s 164(1) a judge may issue a warrant authorizing seizure of copies of the material` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- no reasonable grounds that it is illicit: a power's "if" gate fails
#ASSERT `s 164(1) a judge may issue a warrant authorizing seizure of copies of the material` TRUE FALSE FALSE FALSE EQUALS NOTHING   -- not kept in premises within the jurisdiction

§ `s 164(2) the summons within seven days`
#ASSERT `s 164(2) the judge issued the summons within seven days of the day on which the warrant was issued` 0 EQUALS JUST TRUE
#ASSERT `s 164(2) the judge issued the summons within seven days of the day on which the warrant was issued` 7 EQUALS JUST TRUE   -- the seventh day: "within seven days"
#ASSERT `s 164(2) the judge issued the summons within seven days of the day on which the warrant was issued` 8 EQUALS JUST FALSE
#ASSERT `s 164(2) the judge issued the summons within seven days of the day on which the warrant was issued` -1 EQUALS JUST FALSE   -- before the warrant
-- the duty as a regulative rule (traces are read, not asserted: a DEONTIC value cannot be compared on the stable binary)
#TRACE `s 164(2) the judge's duty to issue the summons` AT 0 WITH
    PARTY `ss 164 to 164.3 the judge` DOES `s 164(2) issue a summons to the occupier of the premises requiring them to appear before the court and show cause why the seized thing should not be forfeited to His Majesty` AT 7
-- (expected: FULFILLED: the deadline is inclusive)
#TRACE `s 164(2) the judge's duty to issue the summons` AT 0 WITH
    (WAITUNTIL 8)
-- (expected: a BREACH by the judge: no summons within seven days)

§ `s 164(3) to (7)`
-- (3): (the owner, the maker, alleged to be illicit material)
#ASSERT `s 164(3) the person may appear and be represented in the proceedings to oppose the forfeiture` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 164(3) the person may appear and be represented in the proceedings to oppose the forfeiture` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 164(3) the person may appear and be represented in the proceedings to oppose the forfeiture` FALSE FALSE TRUE EQUALS NOTHING   -- neither the owner nor the maker
#ASSERT `s 164(3) the person may appear and be represented in the proceedings to oppose the forfeiture` TRUE TRUE FALSE EQUALS NOTHING   -- not alleged to be illicit material
-- (4)
#ASSERT `s 164(4) the court may make an order declaring the thing forfeited to His Majesty in right of the province` TRUE EQUALS JUST TRUE
#ASSERT `s 164(4) the court may make an order declaring the thing forfeited to His Majesty in right of the province` FALSE EQUALS NOTHING   -- not satisfied: a power's "if" gate fails
-- (5): (the court is satisfied that the thing is illicit material; the time for final appeal has expired)
#ASSERT `s 164(5) the court must order the thing restored to the person from whom it was seized` FALSE EQUALS JUST TRUE
#ASSERT `s 164(5) the court must order the thing restored to the person from whom it was seized` TRUE EQUALS JUST FALSE   -- the court is satisfied: the "if" fails
#ASSERT `s 164(5) the thing is to be restored now` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 164(5) the thing is to be restored now` FALSE FALSE EQUALS JUST FALSE   -- before the time for final appeal has expired
#ASSERT `s 164(5) the thing is to be restored now` TRUE TRUE EQUALS JUST FALSE
-- (6): (the order is made under (4) or (5), the person appeared, the ground)
#ASSERT `s 164(6) an appeal lies from the order` TRUE TRUE `s 164(6)(a) a question of law alone` EQUALS JUST TRUE
#ASSERT `s 164(6) an appeal lies from the order` TRUE TRUE `s 164(6)(b) a question of fact alone` EQUALS JUST TRUE
#ASSERT `s 164(6) an appeal lies from the order` TRUE TRUE `s 164(6)(c) a question of mixed law and fact` EQUALS JUST TRUE
#ASSERT `s 164(6) an appeal lies from the order` TRUE FALSE `s 164(6)(a) a question of law alone` EQUALS NOTHING   -- a person who did not appear in the proceedings
#ASSERT `s 164(6) an appeal lies from the order` FALSE TRUE `s 164(6)(a) a question of law alone` EQUALS NOTHING   -- an order not made under (4) or (5)
#ASSERT `s 164(6) an appeal lies from the order` TRUE TRUE `s 164(6) another ground` EQUALS NOTHING
-- (7): (an order has been made in the province, the proceedings are under, the same material, consent)
#ASSERT `s 164(7) no proceedings shall be instituted or continued without the consent of the Attorney General: the bar applies` TRUE (`Provision of the Code` OF 163, "(1)") TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 164(7) no proceedings shall be instituted or continued without the consent of the Attorney General: the bar applies` TRUE (`Provision of the Code` OF 160, "(3.1)") TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 164(7) no proceedings shall be instituted or continued without the consent of the Attorney General: the bar applies` TRUE (`Provision of the Code` OF 162, "(1)") TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 164(7) no proceedings shall be instituted or continued without the consent of the Attorney General: the bar applies` TRUE (`Provision of the Code` OF 162.1, "(1)") TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 164(7) no proceedings shall be instituted or continued without the consent of the Attorney General: the bar applies` TRUE (`Provision of the Code` OF 163.1, "(4)") TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 164(7) no proceedings shall be instituted or continued without the consent of the Attorney General: the bar applies` TRUE (`Provision of the Code` OF 286.4, "") TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 164(7) no proceedings shall be instituted or continued without the consent of the Attorney General: the bar applies` TRUE (`Provision of the Code` OF 320.103, "(1)") TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 164(7) no proceedings shall be instituted or continued without the consent of the Attorney General: the bar applies` TRUE (`Provision of the Code` OF 163, "(1)") TRUE TRUE EQUALS JUST FALSE   -- "without the consent": consent given
#ASSERT `s 164(7) no proceedings shall be instituted or continued without the consent of the Attorney General: the bar applies` TRUE (`Provision of the Code` OF 160, "(3)") TRUE FALSE EQUALS NOTHING   -- 160(3) is not 160(3.1)
#ASSERT `s 164(7) no proceedings shall be instituted or continued without the consent of the Attorney General: the bar applies` TRUE (`Provision of the Code` OF 163, "(1)") FALSE FALSE EQUALS NOTHING   -- other material
#ASSERT `s 164(7) no proceedings shall be instituted or continued without the consent of the Attorney General: the bar applies` FALSE (`Provision of the Code` OF 163, "(1)") TRUE FALSE EQUALS NOTHING   -- no order has been made

§ `s 164.1 material on a computer system`
-- (1): (reasonable grounds, what the judge orders)
#ASSERT `s 164.1(1) the judge may order the custodian of the computer system` TRUE `s 164.1(1)(a) give an electronic copy of the material to the court` EQUALS JUST TRUE
#ASSERT `s 164.1(1) the judge may order the custodian of the computer system` TRUE `s 164.1(1)(b) ensure that the material is no longer stored on and made available through the computer system` EQUALS JUST TRUE
#ASSERT `s 164.1(1) the judge may order the custodian of the computer system` TRUE `s 164.1(1)(c) provide the information necessary to identify and locate the person who posted the material` EQUALS JUST TRUE
#ASSERT `s 164.1(1) the judge may order the custodian of the computer system` TRUE `s 164.1(1) something else` EQUALS NOTHING
#ASSERT `s 164.1(1) the judge may order the custodian of the computer system` FALSE `s 164.1(1)(a) give an electronic copy of the material to the court` EQUALS NOTHING
-- (2)
#ASSERT `s 164.1(2) the judge must cause notice to be given to the person who posted the material` TRUE EQUALS JUST TRUE
#ASSERT `s 164.1(2) the judge must cause notice to be given to the person who posted the material` FALSE EQUALS JUST FALSE   -- before the judge has received the information: the duty has not arisen
#ASSERT `s 164.1(2) the judge may order the custodian to post the text of the notice` TRUE EQUALS JUST TRUE
#ASSERT `s 164.1(2) the judge may order the custodian to post the text of the notice` FALSE EQUALS NOTHING
#ASSERT `s 164.1(3) the person may appear and be represented in the proceedings to oppose the order` TRUE EQUALS JUST TRUE
#ASSERT `s 164.1(3) the person may appear and be represented in the proceedings to oppose the order` FALSE EQUALS NOTHING
#ASSERT `s 164.1(4) the court may proceed ex parte` TRUE EQUALS JUST TRUE
#ASSERT `s 164.1(4) the court may proceed ex parte` FALSE EQUALS NOTHING
#ASSERT `s 164.1(5) the court may order the custodian to delete the material` TRUE EQUALS JUST TRUE
#ASSERT `s 164.1(5) the court may order the custodian to delete the material` FALSE EQUALS NOTHING
-- (5.1)
#ASSERT `s 164.1(5.1) the court must order the custodian to delete the material within 48 hours` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 164.1(5.1) the court must order the custodian to delete the material within 48 hours` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 164.1(5.1) the court must order the custodian to delete the material within 48 hours` NOTHING EQUALS NOTHING
#ASSERT `s 164.1(5.1) the material was deleted within 48 hours after the order was made` 0 EQUALS JUST TRUE
#ASSERT `s 164.1(5.1) the material was deleted within 48 hours after the order was made` 48 EQUALS JUST TRUE
#ASSERT `s 164.1(5.1) the material was deleted within 48 hours after the order was made` 48.5 EQUALS JUST FALSE
#ASSERT `s 164.1(5.1) the material was deleted within 48 hours after the order was made` 49 EQUALS JUST FALSE
#TRACE `s 164.1(5.1) the custodian's duty to delete the intimate image` AT 0 WITH
    PARTY `ss 164 to 164.3 the custodian of the computer system` DOES `s 164.1(5.1) delete the material` AT 48
-- (expected: FULFILLED; the unit of this trace is an hour)
#TRACE `s 164.1(5.1) the custodian's duty to delete the intimate image` AT 0 WITH
    (WAITUNTIL 49)
-- (expected: a BREACH by the custodian)
-- (6), (7), (8), (9), (10)
#ASSERT `s 164.1(6) the court may order the destruction of the electronic copy in the court's possession` TRUE EQUALS JUST TRUE
#ASSERT `s 164.1(6) the court may order the destruction of the electronic copy in the court's possession` FALSE EQUALS JUST FALSE   -- a "When" gate: ruling (b) (fork F9)
#ASSERT `s 164.1(7) the court must order the electronic copy returned and terminate the order made under paragraph (1)(b)` FALSE EQUALS JUST TRUE
#ASSERT `s 164.1(7) the court must order the electronic copy returned and terminate the order made under paragraph (1)(b)` TRUE EQUALS JUST FALSE
#ASSERT `s 164.1(8) subsections 164(6) and (7) apply to the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 164.1(8) subsections 164(6) and (7) apply to the proceedings` FALSE EQUALS NOTHING
#ASSERT `s 164.1(9) the order cannot yet take effect` TRUE FALSE EQUALS JUST TRUE   -- the "until" bar: before the time for final appeal has expired
#ASSERT `s 164.1(9) the order cannot yet take effect` TRUE TRUE EQUALS JUST FALSE   -- after
#ASSERT `s 164.1(9) the order cannot yet take effect` FALSE FALSE EQUALS NOTHING   -- an order not made under (5) to (7)
#ASSERT `s 164.1(10) the term has the meaning given by subsection 342.1(2) or subsection 164(8)` `s 164.1(10) computer data` EQUALS JUST TRUE
#ASSERT `s 164.1(10) the term has the meaning given by subsection 342.1(2) or subsection 164(8)` `s 164.1(10) computer system` EQUALS JUST TRUE
#ASSERT `s 164.1(10) the term has the meaning given by subsection 342.1(2) or subsection 164(8)` `s 164.1(10) court` EQUALS JUST TRUE
#ASSERT `s 164.1(10) the term has the meaning given by subsection 342.1(2) or subsection 164(8)` `s 164.1(10) illicit material` EQUALS JUST TRUE
#ASSERT `s 164.1(10) the term has the meaning given by subsection 342.1(2) or subsection 164(8)` `s 164.1(10) judge` EQUALS JUST TRUE
#ASSERT `s 164.1(10) the term has the meaning given by subsection 342.1(2) or subsection 164(8)` `s 164.1(10) another term` EQUALS NOTHING

§ `s 164.2 Forfeiture after conviction`
-- (1): (the Attorney General applied, the offence, real property, used in the commission, property of a party, acquired from a party to avoid forfeiture)
#ASSERT `s 164.2(1) the court may order the thing forfeited to Her Majesty` TRUE (`Provision of the Code` OF 162.1, "(1)") FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 164.2(1) the court may order the thing forfeited to Her Majesty` TRUE (`Provision of the Code` OF 163.1, "(4)") FALSE TRUE FALSE TRUE EQUALS JUST TRUE   -- (b)(ii)
#ASSERT `s 164.2(1) the court may order the thing forfeited to Her Majesty` TRUE (`Provision of the Code` OF 172.1, "(1)") FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 164.2(1) the court may order the thing forfeited to Her Majesty` TRUE (`Provision of the Code` OF 172.2, "(1)") FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 164.2(1) the court may order the thing forfeited to Her Majesty` FALSE (`Provision of the Code` OF 162.1, "(1)") FALSE TRUE TRUE FALSE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `... FALSE (`Provision of the Code` OF 162.1, "(1)") FALSE TRUE TRUE FALSE EQUALS NOTHING`; no application of the Attorney General: an "On application" gate of the upon kind, listed by the sweep and answered as the guide does (ruling (b) of 2026-11-05), limb by limb
#ASSERT `s 164.2(1) the court may order the thing forfeited to Her Majesty` TRUE (`Provision of the Code` OF 162, "(1)") FALSE TRUE TRUE FALSE EQUALS NOTHING   -- an offence the subsection does not name
#ASSERT `s 164.2(1) the court may order the thing forfeited to Her Majesty` TRUE (`Provision of the Code` OF 162.1, "(1)") TRUE TRUE TRUE FALSE EQUALS NOTHING   -- real property
#ASSERT `s 164.2(1) the court may order the thing forfeited to Her Majesty` TRUE (`Provision of the Code` OF 162.1, "(1)") FALSE FALSE TRUE FALSE EQUALS NOTHING   -- not satisfied that it was used in the commission of the offence
#ASSERT `s 164.2(1) the court may order the thing forfeited to Her Majesty` TRUE (`Provision of the Code` OF 162.1, "(1)") FALSE TRUE FALSE FALSE EQUALS NOTHING   -- neither (b)(i) nor (b)(ii)
#ASSERT `s 164.2(2) the court must cause notice to be given to the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 164.2(2) the court must cause notice to be given to the person` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 164.2(2) the court must cause notice to be given to the person` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 164.2(2) the court may hear the person and declare the nature and extent of the person's interest` TRUE EQUALS JUST TRUE
#ASSERT `s 164.2(2) the court may hear the person and declare the nature and extent of the person's interest` FALSE EQUALS NOTHING
#ASSERT `s 164.2(3) the person may appeal to the court of appeal` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 164.2(3) the person may appeal to the court of appeal` FALSE TRUE EQUALS NOTHING
#ASSERT `s 164.2(3) the person may appeal to the court of appeal` TRUE FALSE EQUALS NOTHING
#ASSERT `s 164.2(4) the Attorney General may appeal to the court of appeal` TRUE EQUALS JUST TRUE
#ASSERT `s 164.2(4) the Attorney General may appeal to the court of appeal` FALSE EQUALS NOTHING
#ASSERT `s 164.2(5) Part XXI applies to the appeal` TRUE EQUALS JUST TRUE
#ASSERT `s 164.2(5) Part XXI applies to the appeal` FALSE EQUALS NOTHING

§ `s 164.3 Relief from forfeiture`
-- (1): (the person claims an interest, in writing, days from the order to the application)
#ASSERT `s 164.3(1) the person may apply for relief from forfeiture` TRUE TRUE 0 EQUALS JUST TRUE
#ASSERT `s 164.3(1) the person may apply for relief from forfeiture` TRUE TRUE 30 EQUALS JUST TRUE   -- the thirtieth day: "Within thirty days"
#ASSERT `s 164.3(1) the person may apply for relief from forfeiture` TRUE TRUE 31 EQUALS JUST FALSE   -- a period the text fixes: ruling (a)
#ASSERT `s 164.3(1) the person may apply for relief from forfeiture` TRUE TRUE -1 EQUALS NOTHING   -- before the order was made: not a case the text speaks to
#ASSERT `s 164.3(1) the person may apply for relief from forfeiture` FALSE TRUE 10 EQUALS NOTHING   -- a person who claims no interest
#ASSERT `s 164.3(1) the person may apply for relief from forfeiture` TRUE FALSE 10 EQUALS NOTHING   -- not in writing
#TRACE `s 164.3(1) the claimant's permission to apply` AT 0 WITH
    PARTY `ss 164 to 164.3 a person who claims an interest in the thing forfeited` DOES `s 164.3(1) apply in writing to a judge for an order under subsection (4)` AT 30
-- (expected: FULFILLED)
-- (2), (3)
#ASSERT `s 164.3(2) the day fixed for the hearing is one the judge may fix` 30 EQUALS JUST TRUE
#ASSERT `s 164.3(2) the day fixed for the hearing is one the judge may fix` 45 EQUALS JUST TRUE
#ASSERT `s 164.3(2) the day fixed for the hearing is one the judge may fix` 29 EQUALS JUST FALSE   -- "not less than thirty days"
#ASSERT `s 164.3(3) the applicant served notice on the Attorney General at least fifteen days before the hearing` 15 EQUALS JUST TRUE
#ASSERT `s 164.3(3) the applicant served notice on the Attorney General at least fifteen days before the hearing` 20 EQUALS JUST TRUE
#ASSERT `s 164.3(3) the applicant served notice on the Attorney General at least fifteen days before the hearing` 14 EQUALS JUST FALSE   -- "At least fifteen days"
#TRACE `s 164.3(3) the applicant's duty to serve notice on the Attorney General` 40 AT 0 WITH
    PARTY `ss 164 to 164.3 the applicant for relief from forfeiture` DOES `s 164.3(3) cause notice of the application and of the hearing day to be served on the Attorney General` AT 25
-- (expected: FULFILLED: the hearing is on day 40 and notice is served on day 25, fifteen days before)
#TRACE `s 164.3(3) the applicant's duty to serve notice on the Attorney General` 40 AT 0 WITH
    (WAITUNTIL 26)
-- (expected: a BREACH by the applicant: notice not served by day 25)
-- (4), (5), (6)
#ASSERT `s 164.3(4) the judge may declare that the applicant's interest in the thing is not affected by the forfeiture` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 164.3(4) the judge may declare that the applicant's interest in the thing is not affected by the forfeiture` FALSE TRUE EQUALS NOTHING   -- the applicant was a party to the offence
#ASSERT `s 164.3(4) the judge may declare that the applicant's interest in the thing is not affected by the forfeiture` TRUE FALSE EQUALS NOTHING   -- acquired from a party under suspect circumstances
#ASSERT `s 164.3(5) the person may appeal to the court of appeal` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 164.3(5) the person may appeal to the court of appeal` FALSE TRUE EQUALS NOTHING
#ASSERT `s 164.3(5) the person may appeal to the court of appeal` TRUE FALSE EQUALS NOTHING
-- (the person obtained an order and applied, the time allowed for an appeal has expired, an appeal was taken, the appeal has been finally disposed of)
#ASSERT `s 164.3(6) the Attorney General must direct that the thing be returned or its value paid` TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- no appeal taken
#ASSERT `s 164.3(6) the Attorney General must direct that the thing be returned or its value paid` TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- an appeal taken and finally disposed of
#ASSERT `s 164.3(6) the Attorney General must direct that the thing be returned or its value paid` TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- an appeal not yet finally disposed of
#ASSERT `s 164.3(6) the Attorney General must direct that the thing be returned or its value paid` TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- the time allowed for an appeal has not expired
#ASSERT `s 164.3(6) the Attorney General must direct that the thing be returned or its value paid` FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- no application by a person who obtained an order
