IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc21-nouns`
IMPORT `ccc21-part-19-absolute`
IMPORT `ccc21-part-18`

-- ccc21-tests-part-18-inquiry.l4 -- tests for ss 536.2 to 551 (procedures before and at the preliminary inquiry, powers of the justice, evidence, the decision). Expected values written by hand from the text.
-- Argument order is the GIVEN order of the function under test.

§ `Tests -- sections 536.2 to 536.5`

#ASSERT `s 536.2 the election or re-election may be made by a document in writing without the personal appearance of the accused` TRUE EQUALS JUST TRUE
#ASSERT `s 536.2 the election or re-election may be made by a document in writing without the personal appearance of the accused` FALSE EQUALS NOTHING
-- 536.3: request made, request made by the accused (, the accused has counsel)
#ASSERT `s 536.3 the prosecutor shall provide the statement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 536.3 the prosecutor shall provide the statement` FALSE FALSE EQUALS JUST FALSE   -- no request
#ASSERT `s 536.3 the prosecutor shall provide the statement` TRUE TRUE EQUALS JUST FALSE   -- the accused made the request: counsel for the accused provides it
#ASSERT `s 536.3 counsel for the accused shall provide the statement` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 536.3 counsel for the accused shall provide the statement` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 536.3 counsel for the accused shall provide the statement` TRUE FALSE TRUE EQUALS JUST FALSE   -- the prosecutor made the request
#ASSERT `s 536.3 counsel for the accused shall provide the statement` TRUE TRUE FALSE EQUALS NOTHING   -- the accused has no counsel: the text names counsel only
#ASSERT `s 536.3 the statement shall identify the item` TRUE `s 536.3(a) the issues on which the requesting party wants evidence to be given at the inquiry` EQUALS JUST TRUE
#ASSERT `s 536.3 the statement shall identify the item` TRUE `s 536.3(b) the witnesses that the requesting party wants to hear at the inquiry` EQUALS JUST TRUE
#ASSERT `s 536.3 the statement shall identify the item` FALSE `s 536.3(a) the issues on which the requesting party wants evidence to be given at the inquiry` EQUALS JUST FALSE
#ASSERT `s 536.3 the statement shall identify the item` TRUE `s 536.3 anything else` EQUALS NOTHING
-- 536.4(1): inquiry to be held, within the period, the purpose
#ASSERT `s 536.4(1) the justice may order that a hearing be held` TRUE TRUE `s 536.4(1)(a) to assist the parties to identify the issues on which evidence will be given at the inquiry` EQUALS JUST TRUE
#ASSERT `s 536.4(1) the justice may order that a hearing be held` TRUE TRUE `s 536.4(1)(b) to assist the parties to identify the witnesses to be heard at the inquiry, taking into account the witnesses’ needs and circumstances` EQUALS JUST TRUE
#ASSERT `s 536.4(1) the justice may order that a hearing be held` TRUE TRUE `s 536.4(1)(c) to encourage the parties to consider any other matters that would promote a fair and expeditious inquiry` EQUALS JUST TRUE
#ASSERT `s 536.4(1) the justice may order that a hearing be held` FALSE TRUE `s 536.4(1)(a) to assist the parties to identify the issues on which evidence will be given at the inquiry` EQUALS NOTHING
#ASSERT `s 536.4(1) the justice may order that a hearing be held` TRUE FALSE `s 536.4(1)(a) to assist the parties to identify the issues on which evidence will be given at the inquiry` EQUALS JUST FALSE   -- outside the period fixed
#ASSERT `s 536.4(1) the justice may order that a hearing be held` TRUE TRUE `s 536.4(1) any other purpose` EQUALS NOTHING
#ASSERT `s 536.4(2) the justice shall record any admissions of fact and any agreement reached by the parties` TRUE EQUALS JUST TRUE
#ASSERT `s 536.4(2) the justice shall record any admissions of fact and any agreement reached by the parties` FALSE EQUALS JUST FALSE
#ASSERT `s 536.5 the prosecutor and the accused may agree to limit the scope of the preliminary inquiry to specific issues` TRUE EQUALS JUST TRUE
#ASSERT `s 536.5 the prosecutor and the accused may agree to limit the scope of the preliminary inquiry to specific issues` FALSE EQUALS NOTHING
-- 536.5: agreement made, hearing held
#ASSERT `s 536.5 the agreement shall be filed with the court` TRUE FALSE EQUALS JUST TRUE   -- no hearing: filed with the court
#ASSERT `s 536.5 the agreement shall be filed with the court` TRUE TRUE EQUALS NOTHING
#ASSERT `s 536.5 the agreement shall be filed with the court` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 536.5 the agreement shall be recorded under subsection 536.4(2)` TRUE TRUE EQUALS JUST TRUE   -- a hearing was held: recorded
#ASSERT `s 536.5 the agreement shall be recorded under subsection 536.4(2)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 536.5 the agreement shall be recorded under subsection 536.4(2)` FALSE TRUE EQUALS JUST FALSE

§ `Tests -- section 537`

#ASSERT `s 537(1)(a) the justice may adjourn an inquiry from time to time and change the place of hearing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 537(1)(a) the justice may adjourn an inquiry from time to time and change the place of hearing` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 537(1)(a) the justice may adjourn an inquiry from time to time and change the place of hearing` FALSE TRUE EQUALS NOTHING
#ASSERT `s 537(1)(b) the justice may remand the accused to custody for the purposes of the Identification of Criminals Act` TRUE EQUALS JUST TRUE
#ASSERT `s 537(1)(b) the justice may remand the accused to custody for the purposes of the Identification of Criminals Act` FALSE EQUALS NOTHING
-- (c): acting, the accused is authorized to be at large
#ASSERT `s 537(1)(c) the justice may remand the accused to custody in a prison by warrant in Form 19` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 537(1)(c) the justice may remand the accused to custody in a prison by warrant in Form 19` TRUE TRUE EQUALS JUST FALSE   -- "except where the accused is authorized pursuant to Part XVI to be at large"
#ASSERT `s 537(1)(c) the justice may remand the accused to custody in a prison by warrant in Form 19` FALSE FALSE EQUALS NOTHING
-- (d): acting, consent
#ASSERT `s 537(1)(d) the justice may resume an inquiry before the expiration of the period for which it has been adjourned` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 537(1)(d) the justice may resume an inquiry before the expiration of the period for which it has been adjourned` TRUE FALSE EQUALS NOTHING
#ASSERT `s 537(1)(d) the justice may resume an inquiry before the expiration of the period for which it has been adjourned` FALSE TRUE EQUALS NOTHING
-- (e): acting, before the expiration of the remand
#ASSERT `s 537(1)(e) the justice may order in writing, in Form 30, that the accused be brought before the justice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 537(1)(e) the justice may order in writing, in Form 30, that the accused be brought before the justice` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 537(1)(e) the justice may order in writing, in Form 30, that the accused be brought before the justice` FALSE TRUE EQUALS NOTHING
#ASSERT `s 537(1)(f) the justice may grant or refuse permission to the prosecutor or his counsel to address the justice in support of the charge` TRUE EQUALS JUST TRUE
#ASSERT `s 537(1)(f) the justice may grant or refuse permission to the prosecutor or his counsel to address the justice in support of the charge` FALSE EQUALS NOTHING
#ASSERT `s 537(1)(g) the justice may receive evidence after hearing any evidence that has been given on behalf of either of them` TRUE EQUALS JUST TRUE
#ASSERT `s 537(1)(g) the justice may receive evidence after hearing any evidence that has been given on behalf of either of them` FALSE EQUALS NOTHING
-- (h): acting, appears to the justice that the ends of justice will be best served
#ASSERT `s 537(1)(h) the justice may order that no person other than the prosecutor, the accused and their counsel shall have access to or remain in the room` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 537(1)(h) the justice may order that no person other than the prosecutor, the accused and their counsel shall have access to or remain in the room` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 537(1)(h) the justice may order that no person other than the prosecutor, the accused and their counsel shall have access to or remain in the room` FALSE TRUE EQUALS NOTHING
-- (i): acting, consistent with this Act, in accordance with an admission or agreement, the justice is satisfied that to do so would be contrary to the best interests of the administration of justice
#ASSERT `s 537(1)(i) the justice may regulate the course of the inquiry` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 537(1)(i) the justice may regulate the course of the inquiry` TRUE TRUE FALSE TRUE EQUALS JUST TRUE   -- not in accordance, but the justice is satisfied that to do so would be contrary to the best interests of the administration of justice
#ASSERT `s 537(1)(i) the justice may regulate the course of the inquiry` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 537(1)(i) the justice may regulate the course of the inquiry` TRUE FALSE TRUE FALSE EQUALS NOTHING   -- not consistent with this Act
#ASSERT `s 537(1)(i) the justice may regulate the course of the inquiry` FALSE TRUE TRUE FALSE EQUALS NOTHING
-- (j): acting, the prosecutor and the accused consent, the part is one in which a witness's evidence is taken
#ASSERT `s 537(1)(j) the justice may allow the accused to appear by counsel for a part of the inquiry` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 537(1)(j) the justice may allow the accused to appear by counsel for a part of the inquiry` TRUE TRUE TRUE EQUALS JUST FALSE   -- "other than a part in which the evidence of a witness is taken"
#ASSERT `s 537(1)(j) the justice may allow the accused to appear by counsel for a part of the inquiry` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 537(1)(j) the justice may allow the accused to appear by counsel for a part of the inquiry` FALSE TRUE FALSE EQUALS NOTHING
-- (j.1): acting, the accused has requested
#ASSERT `s 537(1)(j.1) the justice may permit the accused to be out of court during the whole or any part of the inquiry` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 537(1)(j.1) the justice may permit the accused to be out of court during the whole or any part of the inquiry` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 537(1)(j.1) the justice may permit the accused to be out of court during the whole or any part of the inquiry` FALSE TRUE EQUALS NOTHING
#ASSERT `s 537(1)(k) repealed` EQUALS "(k) [Repealed, 2022, c. 17, s. 35]"
#ASSERT `s 537(1.001) the justice shall consider the interests of justice` TRUE EQUALS JUST TRUE
#ASSERT `s 537(1.001) the justice shall consider the interests of justice` FALSE EQUALS JUST FALSE
#ASSERT `s 537(1.001) the justice shall consider the interests of any victim of the offence in question` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 537(1.001) the justice shall consider the interests of any victim of the offence in question` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 537(1.001) the justice shall consider the interests of any victim of the offence in question` TRUE FALSE EQUALS JUST FALSE   -- information not readily available
#ASSERT `s 537(1.01) the justice may limit the scope of the preliminary inquiry to specific issues and limit the witnesses to be heard on them` TRUE EQUALS JUST TRUE
#ASSERT `s 537(1.01) the justice may limit the scope of the preliminary inquiry to specific issues and limit the witnesses to be heard on them` FALSE EQUALS NOTHING
#ASSERT `s 537(1.02) the Court must inform the accused that the evidence taken during their absence could still be admissible under section 715 or 715.01` TRUE EQUALS JUST TRUE
#ASSERT `s 537(1.02) the Court must inform the accused that the evidence taken during their absence could still be admissible under section 715 or 715.01` FALSE EQUALS JUST FALSE
#ASSERT `s 537(1.1) the justice shall order the immediate cessation of the part of the examination or cross-examination` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 537(1.1) the justice shall order the immediate cessation of the part of the examination or cross-examination` TRUE FALSE EQUALS NOTHING
#ASSERT `s 537(1.1) the justice shall order the immediate cessation of the part of the examination or cross-examination` FALSE TRUE EQUALS NOTHING
-- (2): changes the place under (1)(a), same province, in a division where the changing justice has jurisdiction, the continuing justice has jurisdiction in the new place
#ASSERT `s 537(2) the justice may continue the hearing in the place to which it is changed` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 537(2) the justice may continue the hearing in the place to which it is changed` FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 537(2) the justice may continue the hearing in the place to which it is changed` TRUE FALSE FALSE TRUE EQUALS JUST FALSE   -- another province
#ASSERT `s 537(2) the justice may continue the hearing in the place to which it is changed` TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- "other than a place in a territorial division in which the justice has jurisdiction"
#ASSERT `s 537(2) the justice may continue the hearing in the place to which it is changed` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 537(3) and (4) repealed` EQUALS "(3) and (4) [Repealed, 1991, c. 43, s. 9]"

§ `Tests -- sections 538 and 539`

#ASSERT `s 538 subsections 556(1) and (2) apply to the accused with such modifications as the circumstances require` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 538 subsections 556(1) and (2) apply to the accused with such modifications as the circumstances require` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 538 subsections 556(1) and (2) apply to the accused with such modifications as the circumstances require` NOTHING EQUALS NOTHING
-- 539(1)(a): application by the prosecutor, before the commencement of the taking of evidence
#ASSERT `s 539(1)(a) the justice may make an order restricting publication of the evidence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 539(1)(a) the justice may make an order restricting publication of the evidence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 539(1)(a) the justice may make an order restricting publication of the evidence` FALSE TRUE EQUALS NOTHING
#ASSERT `s 539(1)(b) the justice shall make an order restricting publication of the evidence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 539(1)(b) the justice shall make an order restricting publication of the evidence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 539(1)(b) the justice shall make an order restricting publication of the evidence` TRUE FALSE EQUALS JUST FALSE
-- 539(1)(c) and (d): an order was made, discharged, ordered to stand trial, trial has ended
#ASSERT `s 539(1) the order bars publication of the evidence taken at the inquiry` TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- before the accused is discharged or tried
#ASSERT `s 539(1) the order bars publication of the evidence taken at the inquiry` FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- no order was made
#ASSERT `s 539(1) the order bars publication of the evidence taken at the inquiry` TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- (c) discharged
#ASSERT `s 539(1) the order bars publication of the evidence taken at the inquiry` TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- ordered to stand trial, the trial not yet ended
#ASSERT `s 539(1) the order bars publication of the evidence taken at the inquiry` TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- (d) the trial has ended
-- 539(2)
#ASSERT `s 539(2) the justice shall inform the accused of the right to apply for an order restricting publication` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 539(2) the justice shall inform the accused of the right to apply for an order restricting publication` TRUE FALSE EQUALS JUST FALSE   -- represented by counsel
#ASSERT `s 539(2) the justice shall inform the accused of the right to apply for an order restricting publication` FALSE TRUE EQUALS JUST FALSE   -- evidence has begun
-- 539(3)
#ASSERT `s 539(3) the person is guilty of an offence punishable on summary conviction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 539(3) the person is guilty of an offence punishable on summary conviction` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 539(3) the person is guilty of an offence punishable on summary conviction` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 539(3) the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 539(3) the punishment the section states`'s `mode` EQUALS `on summary conviction`
#ASSERT `s 539(3) the punishment the section states`'s `maximum imprisonment` EQUALS `no imprisonment is stated`
#ASSERT `s 539(3) the punishment the section states`'s `maximum fine` EQUALS `no fine is stated`
#ASSERT `s 539(4) repealed` EQUALS "(4) [Repealed, 2005, c. 32, s. 18]"

§ `Tests -- section 540`

-- (1)(a): before a justice holding a preliminary inquiry, the justice has limited the witnesses under 537(1.01)
#ASSERT `s 540(1)(a) the justice shall take the evidence of the prosecution witnesses under oath and allow the accused or counsel to cross-examine them` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 540(1)(a) the justice shall take the evidence of the prosecution witnesses under oath and allow the accused or counsel to cross-examine them` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 540(1)(a) the justice shall take the evidence of the prosecution witnesses under oath and allow the accused or counsel to cross-examine them` TRUE TRUE EQUALS NOTHING   -- "subject to subsection 537(1.01)"
-- (1)(b): before a justice, how, a sound recording apparatus is authorized
#ASSERT `s 540(1)(b) the justice shall cause a record of the evidence of each witness to be taken in the way the paragraph allows` TRUE `s 540(1)(b)(i) in legible writing in the form of a deposition, in Form 31, or by a stenographer appointed by the justice or pursuant to law` FALSE EQUALS JUST TRUE
#ASSERT `s 540(1)(b) the justice shall cause a record of the evidence of each witness to be taken in the way the paragraph allows` TRUE `s 540(1)(b)(ii) by the type of sound recording apparatus authorized by or under provincial legislation for use in civil cases` TRUE EQUALS JUST TRUE
#ASSERT `s 540(1)(b) the justice shall cause a record of the evidence of each witness to be taken in the way the paragraph allows` TRUE `s 540(1)(b)(ii) by the type of sound recording apparatus authorized by or under provincial legislation for use in civil cases` FALSE EQUALS JUST FALSE   -- the province has not authorized the apparatus
#ASSERT `s 540(1)(b) the justice shall cause a record of the evidence of each witness to be taken in the way the paragraph allows` FALSE `s 540(1)(b)(i) in legible writing in the form of a deposition, in Form 31, or by a stenographer appointed by the justice or pursuant to law` FALSE EQUALS JUST FALSE
#ASSERT `s 540(1)(b) the justice shall cause a record of the evidence of each witness to be taken in the way the paragraph allows` TRUE `s 540(1)(b) any other way` TRUE EQUALS NOTHING
-- (2): deposition in writing, the justice has already asked about witnesses, the step
#ASSERT `s 540(2) the justice shall, in the presence of the accused, take the step before asking the accused if the accused wishes to call witnesses` TRUE FALSE `s 540(2)(a) cause the deposition to be read to the witness` EQUALS JUST TRUE
#ASSERT `s 540(2) the justice shall, in the presence of the accused, take the step before asking the accused if the accused wishes to call witnesses` TRUE FALSE `s 540(2)(b) cause the deposition to be signed by the witness` EQUALS JUST TRUE
#ASSERT `s 540(2) the justice shall, in the presence of the accused, take the step before asking the accused if the accused wishes to call witnesses` TRUE FALSE `s 540(2)(c) sign the deposition himself` EQUALS JUST TRUE
#ASSERT `s 540(2) the justice shall, in the presence of the accused, take the step before asking the accused if the accused wishes to call witnesses` FALSE FALSE `s 540(2)(a) cause the deposition to be read to the witness` EQUALS JUST FALSE
#ASSERT `s 540(2) the justice shall, in the presence of the accused, take the step before asking the accused if the accused wishes to call witnesses` TRUE TRUE `s 540(2)(a) cause the deposition to be read to the witness` EQUALS JUST FALSE   -- after asking: too late
#ASSERT `s 540(2) the justice shall, in the presence of the accused, take the step before asking the accused if the accused wishes to call witnesses` TRUE FALSE `s 540(2) any other step` EQUALS NOTHING
-- (3), (4)
#ASSERT `s 540(3) the justice may sign at the end of each deposition or at the end of several or of all of them` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 540(3) the justice may sign at the end of each deposition or at the end of several or of all of them` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 540(3) the justice may sign at the end of each deposition or at the end of several or of all of them` TRUE FALSE EQUALS NOTHING
#ASSERT `s 540(4) the stenographer shall make oath that they will truly and faithfully report the evidence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 540(4) the stenographer shall make oath that they will truly and faithfully report the evidence` TRUE TRUE EQUALS JUST FALSE   -- a duly sworn court stenographer
#ASSERT `s 540(4) the stenographer shall make oath that they will truly and faithfully report the evidence` FALSE FALSE EQUALS JUST FALSE
-- (5)
#ASSERT `s 540(5) the evidence need not be read to or signed by the witnesses` TRUE EQUALS JUST TRUE
#ASSERT `s 540(5) the evidence need not be read to or signed by the witnesses` FALSE EQUALS NOTHING
#ASSERT `s 540(5) the stenographer shall transcribe the evidence, in whole or in part` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 540(5) the stenographer shall transcribe the evidence, in whole or in part` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 540(5) the stenographer shall transcribe the evidence, in whole or in part` TRUE FALSE EQUALS JUST FALSE   -- no request of the justice or a party
#ASSERT `s 540(5)(a) the transcript shall be accompanied by an affidavit of the stenographer that it is a true report of the evidence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 540(5)(a) the transcript shall be accompanied by an affidavit of the stenographer that it is a true report of the evidence` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 540(5)(a) the transcript shall be accompanied by an affidavit of the stenographer that it is a true report of the evidence` NOTHING EQUALS NOTHING
#ASSERT `s 540(5)(b) the transcript shall be accompanied by a certificate that it is a true report of the evidence` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 540(5)(b) the transcript shall be accompanied by a certificate that it is a true report of the evidence` (JUST TRUE) FALSE EQUALS JUST FALSE   -- "if the stenographer is a duly sworn court stenographer"
#ASSERT `s 540(5)(b) the transcript shall be accompanied by a certificate that it is a true report of the evidence` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 540(5)(b) the transcript shall be accompanied by a certificate that it is a true report of the evidence` NOTHING TRUE EQUALS NOTHING
-- (6)-(9)
#ASSERT `s 540(6) the record shall be dealt with and transcribed and the transcription certified and used in accordance with the provincial legislation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 540(6) the record shall be dealt with and transcribed and the transcription certified and used in accordance with the provincial legislation` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 540(6) the record shall be dealt with and transcribed and the transcription certified and used in accordance with the provincial legislation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 540(7) the justice may receive the information as evidence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 540(7) the justice may receive the information as evidence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 540(7) the justice may receive the information as evidence` FALSE TRUE EQUALS NOTHING
-- (8): the justice orders otherwise, notice given
#ASSERT `s 540(8) the information may not be received as evidence under subsection (7)` FALSE FALSE EQUALS JUST TRUE   -- no notice, no order otherwise: barred
#ASSERT `s 540(8) the information may not be received as evidence under subsection (7)` TRUE FALSE EQUALS JUST FALSE   -- "Unless the justice orders otherwise"
#ASSERT `s 540(8) the information may not be received as evidence under subsection (7)` FALSE TRUE EQUALS JUST FALSE   -- "unless the party has given ... reasonable notice"
#ASSERT `s 540(9) the justice shall require the person to appear for examination or cross-examination` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 540(9) the justice shall require the person to appear for examination or cross-examination` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 540(9) the justice shall require the person to appear for examination or cross-examination` TRUE FALSE EQUALS NOTHING

§ `Tests -- sections 541 and 542`

#ASSERT `s 541(1) the justice shall hear the witnesses called by the accused` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 541(1) the justice shall hear the witnesses called by the accused` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 541(1) the justice shall hear the witnesses called by the accused` TRUE TRUE EQUALS NOTHING
-- (2): represented by counsel, the justice has begun to hear a witness called by the accused
#ASSERT `s 541(2) the justice shall address the accused in the words of subsection (2)` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 541(2) the justice shall address the accused in the words of subsection (2)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 541(2) the justice shall address the accused in the words of subsection (2)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 541(2) the words in which the justice addresses the accused` EQUALS "“Do you wish to say anything in answer to these charges or to any other charges which might have arisen from the evidence led by the prosecution? You are not obliged to say anything, but whatever you do say may be given in evidence against you at your trial. You should not make any confession or admission of guilt because of any promise or threat made to you but if you do make any statement it may be given in evidence against you at your trial in spite of the promise or threat.”"
-- (3): represented, says anything
#ASSERT `s 541(3) the answer shall be taken down in writing, signed by the justice and kept with the evidence of the witnesses` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 541(3) the answer shall be taken down in writing, signed by the justice and kept with the evidence of the witnesses` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 541(3) the answer shall be taken down in writing, signed by the justice and kept with the evidence of the witnesses` FALSE FALSE EQUALS JUST FALSE
-- (4): represented, (2) and (3) complied with
#ASSERT `s 541(4) the justice shall ask the accused if the accused wishes to call any witnesses` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 541(4) the justice shall ask the accused if the accused wishes to call any witnesses` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 541(4) the justice shall ask the accused if the accused wishes to call any witnesses` FALSE FALSE EQUALS JUST FALSE
-- (5): called by the accused, relevant, limited under 537(1.01)
#ASSERT `s 541(5) the justice shall hear the witness` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 541(5) the justice shall hear the witness` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 541(5) the justice shall hear the witness` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 541(5) the justice shall hear the witness` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 541(5) section 540 applies with any modifications that the circumstances require to the hearing of the witness` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 541(5) section 540 applies with any modifications that the circumstances require to the hearing of the witness` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 541(5) section 540 applies with any modifications that the circumstances require to the hearing of the witness` NOTHING EQUALS NOTHING
-- 542(1)
#ASSERT `s 542(1) the prosecutor may give the admission, confession or statement in evidence at the preliminary inquiry` TRUE EQUALS JUST TRUE
#ASSERT `s 542(1) the prosecutor may give the admission, confession or statement in evidence at the preliminary inquiry` FALSE EQUALS NOTHING
-- 542(2): publishes a report, discharged, ordered to stand trial, the trial has ended
#ASSERT `s 542(2) the person is guilty of an offence punishable on summary conviction` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 542(2) the person is guilty of an offence punishable on summary conviction` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 542(2) the person is guilty of an offence punishable on summary conviction` TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) the accused has been discharged
#ASSERT `s 542(2) the person is guilty of an offence punishable on summary conviction` TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- (b) the trial has ended
#ASSERT `s 542(2) the person is guilty of an offence punishable on summary conviction` TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- ordered to stand trial and the trial not ended
#ASSERT `s 542(2) the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 542(2) the punishment the section states`'s `mode` EQUALS `on summary conviction`
#ASSERT `s 542(2) the punishment the section states`'s `minimum imprisonment` EQUALS `no imprisonment is stated`
#ASSERT `s 542(3) repealed` EQUALS "(3) [Repealed, 2005, c. 32, s. 19]"

§ `Tests -- sections 543 and 544`

-- 543(1): the offence is alleged out of the jurisdiction, both parties have been heard
#ASSERT `s 543(1) the justice may order the accused to appear before a justice in the place where the offence is alleged to have been committed` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 543(1) the justice may order the accused to appear before a justice in the place where the offence is alleged to have been committed` FALSE TRUE EQUALS NOTHING
#ASSERT `s 543(1) the justice may order the accused to appear before a justice in the place where the offence is alleged to have been committed` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 543(1) the justice may issue a warrant in Form 15 to convey the accused` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 543(1) the justice may issue a warrant in Form 15 to convey the accused` (JUST TRUE) FALSE EQUALS NOTHING   -- not in custody
#ASSERT `s 543(1) the justice may issue a warrant in Form 15 to convey the accused` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 543(1) the justice may issue a warrant in Form 15 to convey the accused` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 543(1) the justice in the place where the offence is alleged to have been committed shall continue and complete the inquiry` TRUE EQUALS JUST TRUE
#ASSERT `s 543(1) the justice in the place where the offence is alleged to have been committed shall continue and complete the inquiry` FALSE EQUALS NOTHING
#ASSERT `s 543(2) the justice shall cause the transcript and the relevant documents to be transmitted to a justice having jurisdiction in the place where the offence is alleged to have been committed` TRUE EQUALS JUST TRUE
#ASSERT `s 543(2) the justice shall cause the transcript and the relevant documents to be transmitted to a justice having jurisdiction in the place where the offence is alleged to have been committed` FALSE EQUALS JUST FALSE
#ASSERT `s 543(2)(a) the evidence is deemed to have been taken by the justice to whom it is transmitted` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 543(2)(a) the evidence is deemed to have been taken by the justice to whom it is transmitted` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 543(2)(a) the evidence is deemed to have been taken by the justice to whom it is transmitted` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 543(2)(a) the evidence is deemed to have been taken by the justice to whom it is transmitted` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 543(2)(b) the document is deemed to have been issued, given or entered into in the jurisdiction where the offence is alleged to have been committed` (JUST TRUE) `an appearance notice` EQUALS JUST TRUE
#ASSERT `s 543(2)(b) the document is deemed to have been issued, given or entered into in the jurisdiction where the offence is alleged to have been committed` (JUST TRUE) `an undertaking` EQUALS JUST TRUE
#ASSERT `s 543(2)(b) the document is deemed to have been issued, given or entered into in the jurisdiction where the offence is alleged to have been committed` (JUST TRUE) `a release order` EQUALS JUST TRUE
#ASSERT `s 543(2)(b) the document is deemed to have been issued, given or entered into in the jurisdiction where the offence is alleged to have been committed` (JUST TRUE) `a summons` EQUALS NOTHING   -- not one of the three named
#ASSERT `s 543(2)(b) the document is deemed to have been issued, given or entered into in the jurisdiction where the offence is alleged to have been committed` (JUST FALSE) `a release order` EQUALS JUST FALSE
#ASSERT `s 543(2)(b) the document is deemed to have been issued, given or entered into in the jurisdiction where the offence is alleged to have been committed` NOTHING `a release order` EQUALS NOTHING
-- 544(1)
#ASSERT `s 544(1)(a) the accused is deemed to have waived the right to be present at the inquiry` TRUE EQUALS JUST TRUE
#ASSERT `s 544(1)(a) the accused is deemed to have waived the right to be present at the inquiry` FALSE EQUALS JUST FALSE
#ASSERT `s 544(1)(b)(i) the justice may continue the inquiry` TRUE EQUALS JUST TRUE
#ASSERT `s 544(1)(b)(i) the justice may continue the inquiry` FALSE EQUALS JUST FALSE
#ASSERT `s 544(1)(b)(i) the justice shall dispose of the inquiry in accordance with section 548` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 544(1)(b)(i) the justice shall dispose of the inquiry in accordance with section 548` (JUST TRUE) FALSE EQUALS JUST FALSE   -- "when all the evidence has been taken"
#ASSERT `s 544(1)(b)(i) the justice shall dispose of the inquiry in accordance with section 548` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 544(1)(b)(i) the justice shall dispose of the inquiry in accordance with section 548` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 544(1)(b)(ii) the justice may adjourn the inquiry to await the appearance of the accused` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 544(1)(b)(ii) the justice may adjourn the inquiry to await the appearance of the accused` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 544(1)(b)(ii) the justice may adjourn the inquiry to await the appearance of the accused` TRUE FALSE EQUALS NOTHING   -- no warrant issued
#ASSERT `s 544(1) the justice may continue the adjourned inquiry at any time` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 544(1) the justice may continue the adjourned inquiry at any time` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 544(1) the justice may continue the adjourned inquiry at any time` TRUE FALSE EQUALS NOTHING
#ASSERT `s 544(2) the justice may draw an inference adverse to the accused from the fact that the accused has absconded` TRUE EQUALS JUST TRUE
#ASSERT `s 544(2) the justice may draw an inference adverse to the accused from the fact that the accused has absconded` FALSE EQUALS JUST FALSE
-- 544(3): reappears at a continuing inquiry, the justice is satisfied of exceptional circumstances
#ASSERT `s 544(3) the accused is not entitled to have any part of the proceedings conducted in the absence of the accused re-opened` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 544(3) the accused is not entitled to have any part of the proceedings conducted in the absence of the accused re-opened` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 544(3) the accused is not entitled to have any part of the proceedings conducted in the absence of the accused re-opened` TRUE TRUE EQUALS JUST FALSE   -- "unless the justice is satisfied"
#ASSERT `s 544(4) counsel for the accused is not thereby deprived of any authority to continue to act for the accused` TRUE EQUALS JUST TRUE
#ASSERT `s 544(4) counsel for the accused is not thereby deprived of any authority to continue to act for the accused` FALSE EQUALS NOTHING
-- 544(5): continued and concluded, the accused absent, counsel present, limited under 537(1.01)
#ASSERT `s 544(5) counsel for the accused shall be given an opportunity to call witnesses on behalf of the accused` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 544(5) counsel for the accused shall be given an opportunity to call witnesses on behalf of the accused` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 544(5) counsel for the accused shall be given an opportunity to call witnesses on behalf of the accused` TRUE FALSE TRUE FALSE EQUALS JUST FALSE   -- the accused is present
#ASSERT `s 544(5) counsel for the accused shall be given an opportunity to call witnesses on behalf of the accused` TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- counsel is absent too
#ASSERT `s 544(5) counsel for the accused shall be given an opportunity to call witnesses on behalf of the accused` TRUE TRUE TRUE TRUE EQUALS NOTHING

§ `Tests -- sections 545 to 547.1`

-- 545(1): present and required, what the person did, offered a reasonable excuse
#ASSERT `s 545(1) the justice may adjourn the inquiry and commit the person to prison by warrant in Form 20` TRUE `s 545(1)(a) refused to be sworn` FALSE EQUALS JUST TRUE
#ASSERT `s 545(1) the justice may adjourn the inquiry and commit the person to prison by warrant in Form 20` TRUE `s 545(1)(b) having been sworn, refused to answer the questions that were put to the person` FALSE EQUALS JUST TRUE
#ASSERT `s 545(1) the justice may adjourn the inquiry and commit the person to prison by warrant in Form 20` TRUE `s 545(1)(c) failed to produce writings the person was required to produce` FALSE EQUALS JUST TRUE
#ASSERT `s 545(1) the justice may adjourn the inquiry and commit the person to prison by warrant in Form 20` TRUE `s 545(1)(d) refused to sign the person's deposition` FALSE EQUALS JUST TRUE
#ASSERT `s 545(1) the justice may adjourn the inquiry and commit the person to prison by warrant in Form 20` FALSE `s 545(1)(a) refused to be sworn` FALSE EQUALS JUST FALSE
#ASSERT `s 545(1) the justice may adjourn the inquiry and commit the person to prison by warrant in Form 20` TRUE `s 545(1) did none of those` FALSE EQUALS JUST FALSE
#ASSERT `s 545(1) the justice may adjourn the inquiry and commit the person to prison by warrant in Form 20` TRUE `s 545(1)(a) refused to be sworn` TRUE EQUALS JUST FALSE   -- a reasonable excuse was offered
-- the longest commitment: the lesser of eight clear days and the period of adjournment
#ASSERT `s 545(1) the longest period of commitment, in clear days` 3 EQUALS 3
#ASSERT `s 545(1) the longest period of commitment, in clear days` 8 EQUALS 8   -- boundary: the adjournment is exactly eight clear days
#ASSERT `s 545(1) the longest period of commitment, in clear days` 9 EQUALS 8   -- boundary: one day over
#ASSERT `s 545(1) the longest period of commitment, in clear days` 100 EQUALS 8
-- 545(2): brought before the justice on resumption, again refuses, has consented
#ASSERT `s 545(2) the justice may again adjourn the inquiry and commit the person to prison` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 545(2) the justice may again adjourn the inquiry and commit the person to prison` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 545(2) the justice may again adjourn the inquiry and commit the person to prison` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 545(2) the justice may again adjourn the inquiry and commit the person to prison` TRUE TRUE TRUE EQUALS JUST FALSE   -- "until the person consents to do what is required of him"
#ASSERT `s 545(3) this section does not prevent the justice from sending the case for trial` TRUE EQUALS JUST TRUE
#ASSERT `s 545(3) this section does not prevent the justice from sending the case for trial` FALSE EQUALS NOTHING
-- 546: at or after a preliminary inquiry, the defect
#ASSERT `s 546 the validity of the proceeding is not affected by the defect` TRUE `s 546(a) an irregularity or defect in the substance or form of the summons or warrant` EQUALS JUST TRUE
#ASSERT `s 546 the validity of the proceeding is not affected by the defect` TRUE `s 546(b) a variance between the charge set out in the summons or warrant and the charge set out in the information` EQUALS JUST TRUE
#ASSERT `s 546 the validity of the proceeding is not affected by the defect` TRUE `s 546(c) a variance between the charge set out in the summons, warrant or information and the evidence adduced by the prosecution at the inquiry` EQUALS JUST TRUE
#ASSERT `s 546 the validity of the proceeding is not affected by the defect` TRUE `s 546 any other defect` EQUALS NOTHING
#ASSERT `s 546 the validity of the proceeding is not affected by the defect` FALSE `s 546(a) an irregularity or defect in the substance or form of the summons or warrant` EQUALS NOTHING
#ASSERT `s 547 the justice may adjourn the inquiry` TRUE EQUALS JUST TRUE
#ASSERT `s 547 the justice may adjourn the inquiry` FALSE EQUALS JUST FALSE
#ASSERT `s 547 the justice may remand the accused or grant the accused interim release in accordance with Part XVI` TRUE EQUALS JUST TRUE
#ASSERT `s 547 the justice may remand the accused or grant the accused interim release in accordance with Part XVI` FALSE EQUALS JUST FALSE
-- 547.1: a justice commenced and died or is unable, evidence recorded, available
#ASSERT `s 547.1(a) another justice may continue taking the evidence at the point at which the interruption occurred` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 547.1(a) another justice may continue taking the evidence at the point at which the interruption occurred` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 547.1(a) another justice may continue taking the evidence at the point at which the interruption occurred` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 547.1(a) another justice may continue taking the evidence at the point at which the interruption occurred` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 547.1(b) another justice may commence taking the evidence as if no evidence had been taken` TRUE FALSE TRUE EQUALS JUST TRUE   -- no evidence was recorded
#ASSERT `s 547.1(b) another justice may commence taking the evidence as if no evidence had been taken` TRUE TRUE FALSE EQUALS JUST TRUE   -- the evidence is not available
#ASSERT `s 547.1(b) another justice may commence taking the evidence as if no evidence had been taken` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 547.1(b) another justice may commence taking the evidence as if no evidence had been taken` TRUE TRUE TRUE EQUALS JUST FALSE   -- recorded and available: (a) applies
#ASSERT `s 547.1(b) another justice may commence taking the evidence as if no evidence had been taken` FALSE FALSE FALSE EQUALS JUST FALSE

§ `Tests -- sections 548 to 551`

-- 548(1): all the evidence has been taken, in the justice's opinion there is sufficient evidence
#ASSERT `s 548 the decision the justice made at the preliminary inquiry` TRUE TRUE EQUALS JUST `an order to stand trial`
#ASSERT `s 548 the decision the justice made at the preliminary inquiry` TRUE FALSE EQUALS JUST `a discharge at the preliminary inquiry`
#ASSERT `s 548 the decision the justice made at the preliminary inquiry` FALSE TRUE EQUALS NOTHING   -- "When all the evidence has been taken"
#ASSERT `s 548 the decision the justice made at the preliminary inquiry` FALSE FALSE EQUALS NOTHING
#ASSERT `s 548(1)(a) the justice shall order the accused to stand trial` (JUST `an order to stand trial`) EQUALS JUST TRUE
#ASSERT `s 548(1)(a) the justice shall order the accused to stand trial` (JUST `a discharge at the preliminary inquiry`) EQUALS JUST FALSE
#ASSERT `s 548(1)(a) the justice shall order the accused to stand trial` NOTHING EQUALS NOTHING
#ASSERT `s 548(1)(b) the justice shall discharge the accused` (JUST `a discharge at the preliminary inquiry`) EQUALS JUST TRUE
#ASSERT `s 548(1)(b) the justice shall discharge the accused` (JUST `an order to stand trial`) EQUALS JUST FALSE
#ASSERT `s 548(1)(b) the justice shall discharge the accused` NOTHING EQUALS NOTHING
#ASSERT `s 548(2) the justice shall endorse on the information the charges on which the accused is ordered to stand trial` TRUE EQUALS JUST TRUE
#ASSERT `s 548(2) the justice shall endorse on the information the charges on which the accused is ordered to stand trial` FALSE EQUALS JUST FALSE
#ASSERT `s 548(2.1) the justice has the power to fix the date for the trial or the date on which the accused must appear in the trial court` TRUE EQUALS JUST TRUE
#ASSERT `s 548(2.1) the justice has the power to fix the date for the trial or the date on which the accused must appear in the trial court` FALSE EQUALS NOTHING
-- 548(3): the defect is apparent on the face, the court is of the opinion the accused has been misled or prejudiced
#ASSERT `s 548(3) the validity of the order to stand trial is not affected by the defect` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 548(3) the validity of the order to stand trial is not affected by the defect` TRUE TRUE EQUALS JUST FALSE   -- "unless ... misled or prejudiced"
#ASSERT `s 548(3) the validity of the order to stand trial is not affected by the defect` FALSE FALSE EQUALS NOTHING
