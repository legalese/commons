#ASSERT `s 549(1) the justice may order the accused to stand trial without taking or recording any evidence or further evidence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 549(1) the justice may order the accused to stand trial without taking or recording any evidence or further evidence` FALSE TRUE EQUALS NOTHING
