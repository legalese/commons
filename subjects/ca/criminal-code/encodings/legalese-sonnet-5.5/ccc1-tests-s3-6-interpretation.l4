IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc1-s3-6-interpretation`

-- ccc1-tests-s3-6-interpretation.l4 -- tests for sections 3.1 to 6 of the Criminal Code (Canada).
-- Every expected value is written by hand from the text of the section named in the comment beside the assertion, before the run.
-- Arguments are positional, in the order of the GIVEN lines of the function.

§ `s 3.1(1)  (court, justice or judge; otherwise provided or ordered)`
#ASSERT `s 3.1(1) what was done is effective from the moment it is done` TRUE FALSE EQUALS JUST TRUE   -- done by a court, nothing otherwise provided
#ASSERT `s 3.1(1) what was done is effective from the moment it is done` FALSE FALSE EQUALS NOTHING   -- not done by a court, justice or judge: not covered
#ASSERT `s 3.1(1) what was done is effective from the moment it is done` TRUE TRUE EQUALS NOTHING   -- "Unless otherwise provided or ordered" is met: not covered

§ `s 3.1(2)  (from the bench; reduced to writing; otherwise provided or ordered)`
#ASSERT `s 3.1(2) the clerk of the court may sign the writing` TRUE TRUE FALSE EQUALS JUST TRUE   -- done from the bench and reduced to writing
#ASSERT `s 3.1(2) the clerk of the court may sign the writing` TRUE FALSE FALSE EQUALS NOTHING   -- not reduced to writing: a grant, so not covered rather than "may not"
#ASSERT `s 3.1(2) the clerk of the court may sign the writing` FALSE TRUE FALSE EQUALS NOTHING   -- not done from the bench
#ASSERT `s 3.1(2) the clerk of the court may sign the writing` TRUE TRUE TRUE EQUALS NOTHING   -- otherwise provided or ordered

§ `s 4(1)  (postal card or stamp)`
#ASSERT `s 4(1) the postal card or stamp is deemed to be a chattel` TRUE EQUALS JUST TRUE   -- a postal card or stamp referred to in paragraph (c) of the definition property
#ASSERT `s 4(1) the postal card or stamp is deemed to be a chattel` FALSE EQUALS NOTHING   -- any other thing: not covered
#ASSERT `s 4(1) the postal card or stamp is deemed equal in value to the amount expressed on its face` TRUE 1.05 EQUALS JUST 1.05   -- a stamp with $1.05 expressed on its face is equal in value to $1.05
#ASSERT `s 4(1) the postal card or stamp is deemed equal in value to the amount expressed on its face` FALSE 1.05 EQUALS NOTHING   -- not such a card or stamp

§ `s 4(2)  (the value of a valuable security, by paragraph of the definition)`
#ASSERT `s 4(2) the value of the valuable security, where value is material` `s 4(2)(a) paragraph (a) of the definition valuable security` 100 200 300 EQUALS JUST 100   -- (a): the value of the share, interest, deposit or unpaid money
#ASSERT `s 4(2) the value of the valuable security, where value is material` `s 4(2)(a) paragraph (b) of the definition valuable security` 100 200 300 EQUALS JUST 100   -- (a) also covers paragraph (b) of the definition
#ASSERT `s 4(2) the value of the valuable security, where value is material` `s 4(2)(b) paragraph (c) of the definition valuable security` 100 200 300 EQUALS JUST 200   -- (b): the value of the lands, goods, chattel personal or interest
#ASSERT `s 4(2) the value of the valuable security, where value is material` `s 4(2)(b) paragraph (d) of the definition valuable security` 100 200 300 EQUALS JUST 200   -- (b) also covers paragraph (d) of the definition
#ASSERT `s 4(2) the value of the valuable security, where value is material` `s 4(2)(c) paragraph (e) of the definition valuable security` 100 200 300 EQUALS JUST 300   -- (c): the amount of money that has been paid
#ASSERT `s 4(2) the value of the valuable security, where value is material` `s 4(2) none of those paragraphs` 100 200 300 EQUALS NOTHING   -- a security in none of paragraphs (a) to (e): not covered

§ `s 4(3)(a)  (personal possession; knowingly in another's actual possession or custody; knowingly in a place for use or benefit)`
#ASSERT `s 4(3)(a) the person has the thing in possession` TRUE FALSE FALSE EQUALS JUST TRUE   -- in his personal possession
#ASSERT `s 4(3)(a) the person has the thing in possession` FALSE TRUE FALSE EQUALS JUST TRUE   -- knowingly in the actual possession or custody of another person
#ASSERT `s 4(3)(a) the person has the thing in possession` FALSE FALSE TRUE EQUALS JUST TRUE   -- knowingly in any place for the use or benefit of himself or another
#ASSERT `s 4(3)(a) the person has the thing in possession` FALSE FALSE FALSE EQUALS JUST FALSE   -- none of the ways: "a person has anything in possession when ..."

§ `s 4(3)(b)  (one of two or more persons has it; with the knowledge and consent of the rest)`
#ASSERT `s 4(3)(b) the thing is deemed to be in the custody and possession of each and all of them` TRUE TRUE EQUALS JUST TRUE   -- deemed in the custody and possession of each and all
#ASSERT `s 4(3)(b) the thing is deemed to be in the custody and possession of each and all of them` TRUE FALSE EQUALS JUST FALSE   -- without the knowledge and consent of the rest
#ASSERT `s 4(3)(b) the thing is deemed to be in the custody and possession of each and all of them` FALSE TRUE EQUALS JUST FALSE   -- not held by one of two or more persons
#ASSERT `s 4(3)(b) the thing is deemed to be in the custody and possession of each and all of them` FALSE FALSE EQUALS JUST FALSE   -- neither

§ `s 4(4)  (relates to a subject dealt with in another Act; this Act assigns its own meaning)`
#ASSERT `s 4(4) the word or expression has the meaning assigned to it in the other Act` TRUE FALSE EQUALS JUST TRUE   -- the other Act's meaning applies
#ASSERT `s 4(4) the word or expression has the meaning assigned to it in the other Act` TRUE TRUE EQUALS NOTHING   -- "subject to this Act": this Act's own meaning displaces it, and the text then points to this Act
#ASSERT `s 4(4) the word or expression has the meaning assigned to it in the other Act` FALSE FALSE EQUALS JUST FALSE   -- the offence does not relate to a subject dealt with in another Act
#ASSERT `s 4(4) the word or expression has the meaning assigned to it in the other Act` FALSE TRUE EQUALS JUST FALSE   -- same

§ `s 4(5)  (penetration; seed emitted)`
#ASSERT `s 4(5) sexual intercourse is complete` TRUE FALSE EQUALS JUST TRUE   -- complete on penetration although seed is not emitted
#ASSERT `s 4(5) sexual intercourse is complete` TRUE TRUE EQUALS JUST TRUE   -- emission makes no difference
#ASSERT `s 4(5) sexual intercourse is complete` FALSE FALSE EQUALS JUST FALSE   -- no penetration
#ASSERT `s 4(5) sexual intercourse is complete` FALSE TRUE EQUALS JUST FALSE   -- emission without penetration: still not complete

§ `s 4(6)  (the way of proof; whether the person is a peace officer by s 2)`
#ASSERT `s 4(6) the service or notice may be proved in that way` `s 4(6)(a) oral evidence given under oath by the person claiming to have served, given or sent it` (JUST FALSE) EQUALS JUST TRUE   -- (a): oral evidence under oath, whoever gives it
#ASSERT `s 4(6) the service or notice may be proved in that way` `s 4(6)(a) the affidavit or solemn declaration of the person claiming to have served, given or sent it` NOTHING EQUALS JUST TRUE   -- (a): the affidavit or solemn declaration
#ASSERT `s 4(6) the service or notice may be proved in that way` `s 4(6)(b) a statement in writing by a peace officer certifying that the document was served or the notice was given or sent by the peace officer` (JUST TRUE) EQUALS JUST TRUE   -- (b): a peace officer's statement
#ASSERT `s 4(6) the service or notice may be proved in that way` `s 4(6)(b) a statement in writing by a peace officer certifying that the document was served or the notice was given or sent by the peace officer` (JUST FALSE) EQUALS NOTHING   -- (b) is limited to a peace officer
#ASSERT `s 4(6) the service or notice may be proved in that way` `s 4(6)(b) a statement in writing by a peace officer certifying that the document was served or the notice was given or sent by the peace officer` NOTHING EQUALS NOTHING   -- whether the maker is a peace officer is itself not answered: carried through
#ASSERT `s 4(6) the service or notice may be proved in that way` `s 4(6) another way of proof` (JUST TRUE) EQUALS NOTHING   -- "may be proved" does not say "only"
#ASSERT `s 4(6)(b) the statement is deemed to be a statement made under oath` TRUE EQUALS JUST TRUE   -- deemed made under oath
#ASSERT `s 4(6)(b) the statement is deemed to be a statement made under oath` FALSE EQUALS NOTHING   -- any other statement: not covered

§ `s 4(6.1)  (offence created by a provincial law; proof in accordance with the province's laws)`
#ASSERT `s 4(6.1) the service of documents may be proved in accordance with the laws of the province` TRUE TRUE EQUALS JUST TRUE   -- provincial offence, proved under the provincial law
#ASSERT `s 4(6.1) the service of documents may be proved in accordance with the laws of the province` FALSE TRUE EQUALS NOTHING   -- not an offence created by a provincial law
#ASSERT `s 4(6.1) the service of documents may be proved in accordance with the laws of the province` TRUE FALSE EQUALS NOTHING   -- proof not under the provincial law
#ASSERT `s 4(6.1) the service of documents may be proved in accordance with the laws of the province` FALSE FALSE EQUALS NOTHING   -- neither

§ `s 4(7)  (appears to have signed; the examination is on proof of service or notice)`
#ASSERT `s 4(7) the court may require the person to appear before it for examination or cross-examination` TRUE TRUE EQUALS JUST TRUE   -- the court may require the signatory to appear
#ASSERT `s 4(7) the court may require the person to appear before it for examination or cross-examination` TRUE FALSE EQUALS NOTHING   -- on some other issue
#ASSERT `s 4(7) the court may require the person to appear before it for examination or cross-examination` FALSE TRUE EQUALS NOTHING   -- not a signatory under (6) or (6.1)

§ `s 4(8)  (an element of communication; the elements specify the means)`
#ASSERT `s 4(8) the communication may also be made by a means of telecommunication` TRUE FALSE EQUALS JUST TRUE   -- communication element, means not specified
#ASSERT `s 4(8) the communication may also be made by a means of telecommunication` FALSE FALSE EQUALS NOTHING   -- no communication element
#ASSERT `s 4(8) the communication may also be made by a means of telecommunication` TRUE TRUE EQUALS NOTHING   -- the elements specify the means

§ `s 5  (the law relates to the government of the Canadian Forces)`
#ASSERT `s 5 this Act affects the law` TRUE EQUALS JUST FALSE   -- "Nothing in this Act affects any law relating to the government of the Canadian Forces"
#ASSERT `s 5 this Act affects the law` FALSE EQUALS NOTHING   -- any other law: silent

§ `s 6(1)(a)  (an enactment creates the offence; convicted; discharged under section 730)`
#ASSERT `s 6(1)(a) the person is deemed not to be guilty of the offence` TRUE FALSE FALSE EQUALS JUST TRUE   -- before conviction or discharge
#ASSERT `s 6(1)(a) the person is deemed not to be guilty of the offence` TRUE TRUE FALSE EQUALS JUST FALSE   -- after conviction: the "until" bar has ended
#ASSERT `s 6(1)(a) the person is deemed not to be guilty of the offence` TRUE FALSE TRUE EQUALS JUST FALSE   -- after discharge under section 730
#ASSERT `s 6(1)(a) the person is deemed not to be guilty of the offence` TRUE TRUE TRUE EQUALS JUST FALSE   -- both
#ASSERT `s 6(1)(a) the person is deemed not to be guilty of the offence` FALSE FALSE FALSE EQUALS JUST FALSE   -- no enactment creating the offence: "Where an enactment creates an offence and authorizes a punishment" is not met
#ASSERT `s 6(1)(a) the person is deemed not to be guilty of the offence` FALSE TRUE FALSE EQUALS JUST FALSE   -- same, whatever the conviction

§ `s 6(1)(b)  (an enactment creates the offence; convicted or discharged; the punishment is the prescribed one)`
#ASSERT `s 6(1)(b) the person is liable to the punishment` TRUE TRUE FALSE EQUALS JUST FALSE   -- not liable to a punishment other than the prescribed one
#ASSERT `s 6(1)(b) the person is liable to the punishment` TRUE TRUE TRUE EQUALS NOTHING   -- the paragraph does not itself make the person liable to the prescribed one
#ASSERT `s 6(1)(b) the person is liable to the punishment` TRUE FALSE FALSE EQUALS NOTHING   -- not convicted or discharged: not covered
#ASSERT `s 6(1)(b) the person is liable to the punishment` TRUE FALSE TRUE EQUALS NOTHING   -- same
#ASSERT `s 6(1)(b) the person is liable to the punishment` FALSE TRUE FALSE EQUALS JUST FALSE   -- no enactment creating the offence: "Where an enactment creates an offence and authorizes a punishment"
#ASSERT `s 6(1)(b) the person is liable to the punishment` FALSE TRUE TRUE EQUALS JUST FALSE   -- same

§ `s 6(2)  (committed outside Canada; this Act or another Act of Parliament provides otherwise)`
#ASSERT `s 6(2) conviction or discharge under section 730 is barred because the offence was committed outside Canada` TRUE FALSE EQUALS JUST TRUE   -- barred
#ASSERT `s 6(2) conviction or discharge under section 730 is barred because the offence was committed outside Canada` TRUE TRUE EQUALS NOTHING   -- "Subject to this Act or any other Act of Parliament"
#ASSERT `s 6(2) conviction or discharge under section 730 is barred because the offence was committed outside Canada` FALSE FALSE EQUALS NOTHING   -- committed in Canada: the subsection is silent
#ASSERT `s 6(2) conviction or discharge under section 730 is barred because the offence was committed outside Canada` FALSE TRUE EQUALS NOTHING   -- same

§ `s 6(3)  (an Act of Parliament; a provincial Act creating an offence to which Part XXVII applies; a regulation under such an Act)`
#ASSERT `s 6(3) the instrument is an enactment` TRUE FALSE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 6(3) the instrument is an enactment` FALSE TRUE FALSE EQUALS JUST TRUE   -- (b)
#ASSERT `s 6(3) the instrument is an enactment` FALSE FALSE TRUE EQUALS JUST TRUE   -- "or any regulation made thereunder"
#ASSERT `s 6(3) the instrument is an enactment` FALSE FALSE FALSE EQUALS JUST FALSE   -- "enactment means": anything else is outside
