IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc26-interpretation`
IMPORT `ccc26-hearing`

-- ccc26-tests-hearing.l4 -- tests for ccc26-hearing.l4 (sections 723 to 729.1). Every expected value is written from the text (lines 15377-15466) before the run.


§ `s 723(1): before determining the sentence, the court shall give the prosecutor and the offender an opportunity to make submissions on the facts`

#ASSERT `s 723(1) the court must give the prosecutor and the offender an opportunity to make submissions on the facts` TRUE EQUALS JUST TRUE
-- the sentence has been determined
#ASSERT `s 723(1) the court must give the prosecutor and the offender an opportunity to make submissions on the facts` FALSE EQUALS JUST FALSE

§ `s 723(2): the court shall hear any relevant evidence presented by the prosecutor or the offender`

#ASSERT `s 723(2) the court must hear the evidence` TRUE TRUE EQUALS JUST TRUE
-- not relevant
#ASSERT `s 723(2) the court must hear the evidence` FALSE TRUE EQUALS NOTHING
-- presented by someone else
#ASSERT `s 723(2) the court must hear the evidence` TRUE FALSE EQUALS NOTHING

§ `s 723(3): the court may, on its own motion, after hearing argument, require the production of evidence that would assist it`

#ASSERT `s 723(3) the court may require the production of the evidence` TRUE TRUE TRUE EQUALS JUST TRUE
-- not on its own motion
#ASSERT `s 723(3) the court may require the production of the evidence` FALSE TRUE TRUE EQUALS JUST FALSE
-- argument not heard
#ASSERT `s 723(3) the court may require the production of the evidence` TRUE FALSE TRUE EQUALS JUST FALSE
-- the evidence would not assist
#ASSERT `s 723(3) the court may require the production of the evidence` TRUE TRUE FALSE EQUALS NOTHING

§ `s 723(4): where necessary in the interests of justice, the court may, after consulting the parties, compel the appearance of a compellable witness`

#ASSERT `s 723(4) the court may compel the appearance of the person` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- not necessary in the interests of justice
#ASSERT `s 723(4) the court may compel the appearance of the person` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- the parties were not consulted
#ASSERT `s 723(4) the court may compel the appearance of the person` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- not a compellable witness
#ASSERT `s 723(4) the court may compel the appearance of the person` TRUE TRUE FALSE TRUE EQUALS NOTHING
-- not to assist the court
#ASSERT `s 723(4) the court may compel the appearance of the person` TRUE TRUE TRUE FALSE EQUALS NOTHING

§ `s 723(5): hearsay evidence is admissible at sentencing proceedings; the court may compel a person to testify where the person has personal knowledge, is reasonably available and is a compellable witness`

#ASSERT `s 723(5) hearsay evidence is admissible at the sentencing proceedings` TRUE TRUE EQUALS JUST TRUE
-- not hearsay
#ASSERT `s 723(5) hearsay evidence is admissible at the sentencing proceedings` FALSE TRUE EQUALS NOTHING
-- not sentencing proceedings
#ASSERT `s 723(5) hearsay evidence is admissible at the sentencing proceedings` TRUE FALSE EQUALS NOTHING
#ASSERT `s 723(5) the court may compel the person to testify` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- no personal knowledge
#ASSERT `s 723(5) the court may compel the person to testify` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- not reasonably available
#ASSERT `s 723(5) the court may compel the person to testify` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- not a compellable witness
#ASSERT `s 723(5) the court may compel the person to testify` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- the court does not consider it in the interests of justice
#ASSERT `s 723(5) the court may compel the person to testify` TRUE TRUE TRUE FALSE EQUALS NOTHING

§ `s 724(1): in determining a sentence, a court may accept as proved any information disclosed at the trial or at the sentencing proceedings and any facts agreed on`

#ASSERT `s 724(1) the court may accept the information or facts as proved` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 724(1) the court may accept the information or facts as proved` TRUE FALSE TRUE EQUALS JUST TRUE
-- neither disclosed nor agreed
#ASSERT `s 724(1) the court may accept the information or facts as proved` TRUE FALSE FALSE EQUALS NOTHING
-- the court is not determining a sentence
#ASSERT `s 724(1) the court may accept the information or facts as proved` FALSE TRUE TRUE EQUALS JUST FALSE

§ `s 724(2): where the court is composed of a judge and jury`

#ASSERT `s 724(2)(a) the court must accept the fact as proven` TRUE TRUE EQUALS JUST TRUE
-- no jury
#ASSERT `s 724(2)(a) the court must accept the fact as proven` FALSE TRUE EQUALS JUST FALSE
-- not essential to the verdict
#ASSERT `s 724(2)(a) the court must accept the fact as proven` TRUE FALSE EQUALS NOTHING
#ASSERT `s 724(2)(b) the court may find the fact proven or hear evidence on it` TRUE TRUE EQUALS JUST TRUE
-- no jury
#ASSERT `s 724(2)(b) the court may find the fact proven or hear evidence on it` FALSE TRUE EQUALS JUST FALSE
-- not another relevant fact disclosed at the trial
#ASSERT `s 724(2)(b) the court may find the fact proven or hear evidence on it` TRUE FALSE EQUALS NOTHING

§ `s 724(3): where there is a dispute with respect to a fact relevant to the determination of a sentence`

#ASSERT `s 724(3)(a) the court must request that evidence be adduced as to the existence of the fact` TRUE FALSE EQUALS JUST TRUE
-- no dispute
#ASSERT `s 724(3)(a) the court must request that evidence be adduced as to the existence of the fact` FALSE FALSE EQUALS JUST FALSE
-- the court is satisfied that sufficient evidence was adduced at the trial: the "unless" is met
#ASSERT `s 724(3)(a) the court must request that evidence be adduced as to the existence of the fact` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 724(3)(b) the party has the burden of proving the fact` TRUE TRUE EQUALS JUST TRUE
-- no dispute
#ASSERT `s 724(3)(b) the party has the burden of proving the fact` FALSE TRUE EQUALS JUST FALSE
-- the party does not wish to rely on it
#ASSERT `s 724(3)(b) the party has the burden of proving the fact` TRUE FALSE EQUALS NOTHING
#ASSERT `s 724(3)(c) either party may cross-examine the witness` TRUE TRUE EQUALS JUST TRUE
-- no dispute
#ASSERT `s 724(3)(c) either party may cross-examine the witness` FALSE TRUE EQUALS JUST FALSE
-- not called by the other party
#ASSERT `s 724(3)(c) either party may cross-examine the witness` TRUE FALSE EQUALS NOTHING
#ASSERT `s 724(3)(d) the court must be satisfied on a balance of probabilities of the existence of the fact before relying on it` TRUE FALSE EQUALS JUST TRUE
-- an aggravating fact or a previous conviction: paragraph (e) governs
#ASSERT `s 724(3)(d) the court must be satisfied on a balance of probabilities of the existence of the fact before relying on it` TRUE TRUE EQUALS JUST FALSE
-- no dispute
#ASSERT `s 724(3)(d) the court must be satisfied on a balance of probabilities of the existence of the fact before relying on it` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 724(3)(e) the prosecutor must establish the fact by proof beyond a reasonable doubt` TRUE TRUE EQUALS JUST TRUE
-- not an aggravating fact or a previous conviction
#ASSERT `s 724(3)(e) the prosecutor must establish the fact by proof beyond a reasonable doubt` TRUE FALSE EQUALS NOTHING
-- no dispute
#ASSERT `s 724(3)(e) the prosecutor must establish the fact by proof beyond a reasonable doubt` FALSE TRUE EQUALS JUST FALSE

§ `s 725(1)(a): the court shall consider, if it is possible and appropriate, any other offences of which the offender was found guilty by the same court`

#ASSERT `s 725(1)(a) the court must consider the other offence` TRUE TRUE EQUALS JUST TRUE
-- not found guilty by the same court
#ASSERT `s 725(1)(a) the court must consider the other offence` FALSE TRUE EQUALS NOTHING
-- not possible and appropriate
#ASSERT `s 725(1)(a) the court must consider the other offence` TRUE FALSE EQUALS JUST FALSE
-- not found guilty by the same court
#ASSERT `s 725(1)(a) the court must consider the other offence` FALSE FALSE EQUALS NOTHING
#ASSERT `s 725(1)(a) the court must determine the sentence to be imposed for the other offence` TRUE EQUALS JUST TRUE
-- the court does not consider the offence under paragraph (a)
#ASSERT `s 725(1)(a) the court must determine the sentence to be imposed for the other offence` FALSE EQUALS NOTHING

§ `s 725(1)(b): the court shall consider outstanding charges if the Attorney General and the offender consent and the court has jurisdiction`

#ASSERT `s 725(1)(b) the court must consider the outstanding charge` (JUST TRUE) TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- who the Attorney General is, is for section 2
#ASSERT `s 725(1)(b) the court must consider the outstanding charge` NOTHING TRUE TRUE TRUE TRUE EQUALS NOTHING
-- the person who consented is not the Attorney General
#ASSERT `s 725(1)(b) the court must consider the outstanding charge` (JUST FALSE) TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- the Attorney General has not consented
#ASSERT `s 725(1)(b) the court must consider the outstanding charge` (JUST TRUE) FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- the offender has not consented
#ASSERT `s 725(1)(b) the court must consider the outstanding charge` (JUST TRUE) TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- no jurisdiction
#ASSERT `s 725(1)(b) the court must consider the outstanding charge` (JUST TRUE) TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- the offender does not plead guilty to the charge
#ASSERT `s 725(1)(b) the court must consider the outstanding charge` (JUST TRUE) TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 725(1)(b) the court must determine the sentence to be imposed for the charge` TRUE FALSE EQUALS JUST TRUE
-- the court is of the opinion that a separate prosecution is necessary in the public interest: the "unless" is met
#ASSERT `s 725(1)(b) the court must determine the sentence to be imposed for the charge` TRUE TRUE EQUALS JUST FALSE
-- the court does not consider the charge under paragraph (b)
#ASSERT `s 725(1)(b) the court must determine the sentence to be imposed for the charge` FALSE FALSE EQUALS NOTHING

§ `s 725(1)(b.1): the court shall consider outstanding charges unless a separate prosecution is necessary in the public interest, subject to five conditions`

#ASSERT `s 725(1)(b.1) the court must consider the outstanding charges` FALSE (JUST TRUE) TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- a separate prosecution is necessary in the public interest
#ASSERT `s 725(1)(b.1) the court must consider the outstanding charges` TRUE (JUST TRUE) TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- who the Attorney General is, is for section 2
#ASSERT `s 725(1)(b.1) the court must consider the outstanding charges` FALSE NOTHING TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
-- the person who consented is not the Attorney General
#ASSERT `s 725(1)(b.1) the court must consider the outstanding charges` FALSE (JUST FALSE) TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- condition (i): the Attorney General has not consented
#ASSERT `s 725(1)(b.1) the court must consider the outstanding charges` FALSE (JUST TRUE) FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- condition (i): the offender has not consented
#ASSERT `s 725(1)(b.1) the court must consider the outstanding charges` FALSE (JUST TRUE) TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- condition (ii): no jurisdiction
#ASSERT `s 725(1)(b.1) the court must consider the outstanding charges` FALSE (JUST TRUE) TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- condition (iii): not described in open court
#ASSERT `s 725(1)(b.1) the court must consider the outstanding charges` FALSE (JUST TRUE) TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- condition (iv): the offender has not agreed with the facts
#ASSERT `s 725(1)(b.1) the court must consider the outstanding charges` FALSE (JUST TRUE) TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- condition (v): the offender has not acknowledged the offence
#ASSERT `s 725(1)(b.1) the court must consider the outstanding charges` FALSE (JUST TRUE) TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE

§ `s 725(1)(c), (1.1) and (2)`

#ASSERT `s 725(1)(c) the court may consider the facts` TRUE TRUE EQUALS JUST TRUE
-- not part of the circumstances of the offence
#ASSERT `s 725(1)(c) the court may consider the facts` FALSE TRUE EQUALS NOTHING
-- could not be the basis for a separate charge
#ASSERT `s 725(1)(c) the court may consider the facts` TRUE FALSE EQUALS NOTHING
#ASSERT `s 725(1.1) the Attorney General must take the public interest into account before consenting` TRUE EQUALS JUST TRUE
-- not consenting for paragraph (1)(b) or (b.1)
#ASSERT `s 725(1.1) the Attorney General must take the public interest into account before consenting` FALSE EQUALS NOTHING
#ASSERT `s 725(2) the court must note the charge or fact on the information or indictment` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 725(2) the court must note the charge or fact on the information or indictment` FALSE TRUE EQUALS JUST TRUE
-- neither a (b.1) charge nor a (c) fact
#ASSERT `s 725(2) the court must note the charge or fact on the information or indictment` FALSE FALSE EQUALS NOTHING
#ASSERT `s 725(2) further proceedings are barred` TRUE FALSE EQUALS JUST TRUE
-- the conviction is set aside or quashed on appeal: the "unless" is met
#ASSERT `s 725(2) further proceedings are barred` TRUE TRUE EQUALS JUST FALSE
-- not an offence described in the noted charges or disclosed by the noted facts
#ASSERT `s 725(2) further proceedings are barred` FALSE FALSE EQUALS NOTHING

§ `s 726: before determining the sentence, the court shall ask whether the offender, if present, has anything to say`

#ASSERT `s 726 the court must ask whether the offender has anything to say` TRUE TRUE EQUALS JUST TRUE
-- the sentence is not about to be determined
#ASSERT `s 726 the court must ask whether the offender has anything to say` FALSE TRUE EQUALS JUST FALSE
-- the offender is not present
#ASSERT `s 726 the court must ask whether the offender has anything to say` TRUE FALSE EQUALS JUST FALSE

§ `s 726.1: in determining the sentence, a court shall consider any relevant information placed before it`

#ASSERT `s 726.1 the court must consider the information` TRUE TRUE EQUALS JUST TRUE
-- not determining the sentence
#ASSERT `s 726.1 the court must consider the information` FALSE TRUE EQUALS JUST FALSE
-- not relevant information placed before the court
#ASSERT `s 726.1 the court must consider the information` TRUE FALSE EQUALS NOTHING

§ `s 726.11: an offender found guilty of an offence under subsection 263.1(1)`

#ASSERT `s 726.11 the court must endorse the included offence that has been proved on the information or indictment` TRUE EQUALS JUST TRUE
#ASSERT `s 726.11 the court must endorse the included offence that has been proved on the information or indictment` FALSE EQUALS JUST FALSE
#ASSERT `s 726.11 the endorsement is proof of the included offence` TRUE FALSE EQUALS JUST TRUE
-- evidence to the contrary
#ASSERT `s 726.11 the endorsement is proof of the included offence` TRUE TRUE EQUALS JUST FALSE
-- no endorsement
#ASSERT `s 726.11 the endorsement is proof of the included offence` FALSE FALSE EQUALS NOTHING

§ `s 726.2: when imposing a sentence, a court shall state the terms of the sentence and the reasons and enter them into the record`

#ASSERT `s 726.2 the court must state the terms of the sentence and the reasons and enter them into the record` TRUE EQUALS JUST TRUE
#ASSERT `s 726.2 the court must state the terms of the sentence and the reasons and enter them into the record` FALSE EQUALS JUST FALSE

§ `s 726.21: guilty of an offence in which violence is used, threatened or attempted against the offender's intimate partner`

#ASSERT `s 726.21 the court must endorse that fact on the information or indictment` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
-- the person is not the intimate partner
#ASSERT `s 726.21 the court must endorse that fact on the information or indictment` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- not an offence in which violence is used, threatened or attempted
#ASSERT `s 726.21 the court must endorse that fact on the information or indictment` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
-- one limb is JUST FALSE and the other open: the conjunction fails
#ASSERT `s 726.21 the court must endorse that fact on the information or indictment` TRUE (JUST FALSE) NOTHING EQUALS JUST FALSE
-- whether the offence counts is for section 3.01
#ASSERT `s 726.21 the court must endorse that fact on the information or indictment` TRUE NOTHING (JUST TRUE) EQUALS NOTHING
-- whether the person is an intimate partner is for section 2
#ASSERT `s 726.21 the court must endorse that fact on the information or indictment` TRUE (JUST TRUE) NOTHING EQUALS NOTHING
-- the court has not determined that the offender is guilty
#ASSERT `s 726.21 the court must endorse that fact on the information or indictment` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 726.21 the endorsement is proof of that fact` TRUE FALSE EQUALS JUST TRUE
-- evidence to the contrary
#ASSERT `s 726.21 the endorsement is proof of that fact` TRUE TRUE EQUALS JUST FALSE
-- no endorsement
#ASSERT `s 726.21 the endorsement is proof of that fact` FALSE FALSE EQUALS NOTHING

§ `s 726.22: an offender found guilty of an offence under subsection 320.1001(1)`

#ASSERT `s 726.22 the court must endorse the included offence that has been proved on the information or indictment` TRUE EQUALS JUST TRUE
#ASSERT `s 726.22 the court must endorse the included offence that has been proved on the information or indictment` FALSE EQUALS JUST FALSE
#ASSERT `s 726.22 the endorsement is proof of the included offence` TRUE FALSE EQUALS JUST TRUE
-- evidence to the contrary
#ASSERT `s 726.22 the endorsement is proof of the included offence` TRUE TRUE EQUALS JUST FALSE
-- no endorsement
#ASSERT `s 726.22 the endorsement is proof of the included offence` FALSE FALSE EQUALS NOTHING

§ `s 726.3: when imposing a sentence, a court must inquire of the prosecutor and, if known, enter the victim's wishes into the record`

#ASSERT `s 726.3 the court must inquire of the prosecutor and enter the victim's wishes into the record` TRUE TRUE EQUALS JUST TRUE
-- not imposing a sentence
#ASSERT `s 726.3 the court must inquire of the prosecutor and enter the victim's wishes into the record` FALSE TRUE EQUALS JUST FALSE
-- the wishes are not known
#ASSERT `s 726.3 the court must inquire of the prosecutor and enter the victim's wishes into the record` TRUE FALSE EQUALS NOTHING

§ `s 727(1): no greater punishment by reason of previous convictions unless the prosecutor satisfies the court that the offender was notified before pleading`

#ASSERT `s 727(1) a greater punishment by reason of previous convictions is barred` TRUE FALSE FALSE EQUALS JUST TRUE
-- not an offence for which a greater punishment may be imposed by reason of previous convictions
#ASSERT `s 727(1) a greater punishment by reason of previous convictions is barred` FALSE FALSE FALSE EQUALS JUST FALSE
-- subsection (3) or (4) applies: "Subject to subsections (3) and (4)"
#ASSERT `s 727(1) a greater punishment by reason of previous convictions is barred` TRUE TRUE FALSE EQUALS JUST FALSE
-- the "unless" is met
#ASSERT `s 727(1) a greater punishment by reason of previous convictions is barred` TRUE FALSE TRUE EQUALS JUST FALSE

§ `s 727(2): on application by the prosecutor and on being satisfied the offender was notified, the court shall ask whether the offender was previously convicted`

#ASSERT `s 727(2) the court must ask whether the offender was previously convicted` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 727(2) the court must ask whether the offender was previously convicted` FALSE TRUE TRUE EQUALS JUST FALSE
-- no application by the prosecutor
#ASSERT `s 727(2) the court must ask whether the offender was previously convicted` TRUE FALSE TRUE EQUALS JUST FALSE
-- the court is not satisfied that the offender was notified
#ASSERT `s 727(2) the court must ask whether the offender was previously convicted` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 727(2) evidence of previous convictions may be adduced` TRUE TRUE EQUALS JUST TRUE
-- the offender admits to the previous convictions
#ASSERT `s 727(2) evidence of previous convictions may be adduced` TRUE FALSE EQUALS NOTHING
-- the court has not asked
#ASSERT `s 727(2) evidence of previous convictions may be adduced` FALSE TRUE EQUALS NOTHING

§ `s 727(3): a summary conviction court that holds a trial pursuant to subsection 803(2) and convicts the offender`

#ASSERT `s 727(3) the court may make inquiries and hear evidence with respect to previous convictions` TRUE EQUALS JUST TRUE
#ASSERT `s 727(3) the court may make inquiries and hear evidence with respect to previous convictions` FALSE EQUALS JUST FALSE
#ASSERT `s 727(3) the court may impose a greater punishment by reason of the previous conviction` TRUE TRUE EQUALS JUST TRUE
-- not a trial pursuant to subsection 803(2)
#ASSERT `s 727(3) the court may impose a greater punishment by reason of the previous conviction` FALSE TRUE EQUALS JUST FALSE
-- no previous conviction is proved
#ASSERT `s 727(3) the court may impose a greater punishment by reason of the previous conviction` TRUE FALSE EQUALS NOTHING

§ `s 727(4): if, under section 623, the court proceeds with the trial of an organization that has not appeared and pleaded, and convicts it`

#ASSERT `s 727(4) the court may make inquiries and hear evidence with respect to previous convictions of the organization` TRUE EQUALS JUST TRUE
-- not a trial under section 623 of an organization that has not appeared and pleaded
#ASSERT `s 727(4) the court may make inquiries and hear evidence with respect to previous convictions of the organization` FALSE EQUALS NOTHING
#ASSERT `s 727(4) the court may impose a greater punishment by reason of the previous conviction of the organization` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 727(4) the court may impose a greater punishment by reason of the previous conviction of the organization` FALSE TRUE EQUALS NOTHING
-- no previous conviction is proved
#ASSERT `s 727(4) the court may impose a greater punishment by reason of the previous conviction of the organization` TRUE FALSE EQUALS NOTHING

§ `s 727(5): this section does not apply to a person referred to in paragraph 745(b)`

#ASSERT `s 727(5) this section applies to the person` TRUE EQUALS JUST FALSE
-- the subsection says only whom the section does not apply to
#ASSERT `s 727(5) this section applies to the person` FALSE EQUALS NOTHING

§ `s 728: where one sentence is passed on a verdict of guilty on two or more counts, the sentence is good if any of the counts would have justified it`

#ASSERT `s 728 makes the sentence good` TRUE TRUE EQUALS JUST TRUE
-- one sentence was not passed on two or more counts
#ASSERT `s 728 makes the sentence good` FALSE TRUE EQUALS JUST FALSE
-- no count would have justified the sentence
#ASSERT `s 728 makes the sentence good` TRUE FALSE EQUALS JUST FALSE

§ `s 729(1): the certificate of an analyst in a probation or conditional-sentence proceeding about drugs`

#ASSERT `s 729(1) the certificate is admissible in evidence` TRUE FALSE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 729(1) the certificate is admissible in evidence` FALSE TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 729(1) the certificate is admissible in evidence` TRUE TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
-- neither (a) nor (b)
#ASSERT `s 729(1) the certificate is admissible in evidence` FALSE FALSE (JUST TRUE) TRUE EQUALS JUST FALSE
-- whether the signer is an analyst is for the Controlled Drugs and Substances Act and the Cannabis Act
#ASSERT `s 729(1) the certificate is admissible in evidence` TRUE FALSE NOTHING TRUE EQUALS NOTHING
-- the signer is not an analyst
#ASSERT `s 729(1) the certificate is admissible in evidence` TRUE FALSE (JUST FALSE) TRUE EQUALS NOTHING
-- the certificate does not purport and state what the paragraph describes
#ASSERT `s 729(1) the certificate is admissible in evidence` TRUE FALSE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 729(1) the certificate is proof of the statements contained in it, without proof of the signature or official character of the signer` (JUST TRUE) FALSE EQUALS JUST TRUE
-- evidence to the contrary
#ASSERT `s 729(1) the certificate is proof of the statements contained in it, without proof of the signature or official character of the signer` (JUST TRUE) TRUE EQUALS JUST FALSE
-- admissibility is open
#ASSERT `s 729(1) the certificate is proof of the statements contained in it, without proof of the signature or official character of the signer` NOTHING FALSE EQUALS NOTHING
-- not admissible under the subsection
#ASSERT `s 729(1) the certificate is proof of the statements contained in it, without proof of the signature or official character of the signer` (JUST FALSE) FALSE EQUALS NOTHING

§ `s 729(3), (6): notice and a copy; attendance of the analyst`

-- notice and a copy were given: the "unless" is met
#ASSERT `s 729(3) the certificate is barred from admission in evidence` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 729(3) the certificate is barred from admission in evidence` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 729(3) the certificate is barred from admission in evidence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 729(3) the certificate is barred from admission in evidence` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 729(6) the party may require the attendance of the analyst for cross-examination` TRUE TRUE EQUALS JUST TRUE
-- no leave of the court
#ASSERT `s 729(6) the party may require the attendance of the analyst for cross-examination` TRUE FALSE EQUALS JUST FALSE
-- no certificate of an analyst is produced against the party
#ASSERT `s 729(6) the party may require the attendance of the analyst for cross-examination` FALSE TRUE EQUALS NOTHING
-- no certificate of an analyst is produced against the party
#ASSERT `s 729(6) the party may require the attendance of the analyst for cross-examination` FALSE FALSE EQUALS NOTHING

§ `s 729(4) and (5): repealed`

#ASSERT `s 729(4) and (5), repealed` EQUALS "[Repealed, 2008, c. 18, s. 36]"

