IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc16-dna-definitions`
IMPORT `ccc16-open-court`
IMPORT `ccc16-publication-bans`

-- ccc16-tests-publication-bans.l4 -- tests for ccc16-publication-bans.l4 (sections 486.4 to 486.6).
-- Expected values were decided from the text (lines 8880-8991) before the run and are written beside each assertion.

`s 486.4 test: the prosecutor` MEANS `s 486.4 the prosecutor`
`s 486.4 test: the victim` MEANS `s 486.4 the victim`
`s 486.4 test: a witness under 18` MEANS `s 486.4 a witness under the age of 18 years`
`s 486.4 test: an adult witness` MEANS `s 486.4 a witness of the age of 18 years or more`
`s 486.4 test: a justice system participant` MEANS `s 486.4 a justice system participant`
`s 486.4 test: the accused` MEANS `s 486.4 the accused`
`s 486.4 test: another person` MEANS `s 486.4 another person`

GIVEN sec IS A NUMBER
      sub IS A STRING
      historic IS A BOOLEAN
      conduct IS A BOOLEAN
GIVETH A `s 486.4(1) offence charged`
`s 486.4 test: an offence` MEANS `s 486.4(1) offence charged` OF (`Provision of the Code` OF sec, sub), historic, conduct

§ `s 486.4(1) -- the offences, and the power`
-- (a)(i): section 151 (first), 160 (whole section), 213, 346, 347 (last); 345 and 150 are not named
#ASSERT `s 486.4(1)(a) the offence is one referred to in paragraph (a)` (`s 486.4 test: an offence` 151 "" FALSE FALSE)
#ASSERT `s 486.4(1)(a) the offence is one referred to in paragraph (a)` (`s 486.4 test: an offence` 160 "(2)" FALSE FALSE)
#ASSERT `s 486.4(1)(a) the offence is one referred to in paragraph (a)` (`s 486.4 test: an offence` 213 "" FALSE FALSE)
#ASSERT `s 486.4(1)(a) the offence is one referred to in paragraph (a)` (`s 486.4 test: an offence` 346 "" FALSE FALSE)
#ASSERT `s 486.4(1)(a) the offence is one referred to in paragraph (a)` (`s 486.4 test: an offence` 347 "" FALSE FALSE)
#ASSERT NOT (`s 486.4(1)(a) the offence is one referred to in paragraph (a)` (`s 486.4 test: an offence` 345 "" FALSE FALSE))
#ASSERT NOT (`s 486.4(1)(a) the offence is one referred to in paragraph (a)` (`s 486.4 test: an offence` 150 "" FALSE FALSE))
-- (a)(ii): an offence of this Act as it read before the day, if the conduct alleged would be an offence in (i) on or after that day: any section number
#ASSERT `s 486.4(1)(a) the offence is one referred to in paragraph (a)` (`s 486.4 test: an offence` 149 "" TRUE TRUE)
#ASSERT NOT (`s 486.4(1)(a) the offence is one referred to in paragraph (a)` (`s 486.4 test: an offence` 149 "" TRUE FALSE))
-- a historic provision whose number is now listed, but whose conduct would not be an offence in (i): not within (a)
#ASSERT NOT (`s 486.4(1)(a) the offence is one referred to in paragraph (a)` (`s 486.4 test: an offence` 151 "" TRUE FALSE))
-- (b): two or more offences in the same proceeding, at least one of which is in (a)
#ASSERT `s 486.4(1)(b) two or more offences are dealt with in the same proceeding, at least one of which is an offence referred to in paragraph (a)` (LIST (`s 486.4 test: an offence` 151 "" FALSE FALSE), (`s 486.4 test: an offence` 380 "" FALSE FALSE))
#ASSERT NOT (`s 486.4(1)(b) two or more offences are dealt with in the same proceeding, at least one of which is an offence referred to in paragraph (a)` (LIST (`s 486.4 test: an offence` 151 "" FALSE FALSE)))   -- one offence is not "two or more"
#ASSERT NOT (`s 486.4(1)(b) two or more offences are dealt with in the same proceeding, at least one of which is an offence referred to in paragraph (a)` (LIST (`s 486.4 test: an offence` 380 "" FALSE FALSE), (`s 486.4 test: an offence` 381 "" FALSE FALSE)))
#ASSERT `s 486.4(1) the presiding judge or justice may make an order directing that information that could identify the victim or a witness not be published` TRUE EQUALS JUST TRUE
#ASSERT `s 486.4(1) the presiding judge or justice may make an order directing that information that could identify the victim or a witness not be published` FALSE EQUALS NOTHING

§ `s 486.4(2) -- the mandatory order on application`
#ASSERT `s 486.4(2)(a) the presiding judge or justice must inform the person of the right to make an application for the order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 486.4(2)(a) the presiding judge or justice must inform the person of the right to make an application for the order` TRUE FALSE EQUALS NOTHING   -- an adult witness: not named
#ASSERT `s 486.4(2)(a) the presiding judge or justice must inform the person of the right to make an application for the order` FALSE TRUE EQUALS NOTHING
#ASSERT `s 486.4(2)(b) the presiding judge or justice must make the order` TRUE (`s 486.4 test: the victim`) EQUALS JUST TRUE
#ASSERT `s 486.4(2)(b) the presiding judge or justice must make the order` TRUE (`s 486.4 test: the prosecutor`) EQUALS JUST TRUE
#ASSERT `s 486.4(2)(b) the presiding judge or justice must make the order` TRUE (`s 486.4 test: a witness under 18`) EQUALS JUST TRUE
#ASSERT `s 486.4(2)(b) the presiding judge or justice must make the order` TRUE (`s 486.4 test: an adult witness`) EQUALS JUST FALSE   -- "any such witness" is a witness under 18
#ASSERT `s 486.4(2)(b) the presiding judge or justice must make the order` TRUE (`s 486.4 test: the accused`) EQUALS JUST FALSE
#ASSERT `s 486.4(2)(b) the presiding judge or justice must make the order` FALSE (`s 486.4 test: the victim`) EQUALS NOTHING
#ASSERT `s 486.4(2)(c) the presiding judge or justice must inform the witnesses and the victim of the order's existence and of their right to apply to revoke or vary it` TRUE EQUALS JUST TRUE
#ASSERT `s 486.4(2)(c) the presiding judge or justice must inform the witnesses and the victim of the order's existence and of their right to apply to revoke or vary it` FALSE EQUALS JUST FALSE
#ASSERT `s 486.4(2.1) the presiding judge or justice may make an order directing that information that could identify the victim not be published` TRUE 17 EQUALS JUST TRUE
#ASSERT `s 486.4(2.1) the presiding judge or justice may make an order directing that information that could identify the victim not be published` TRUE 18 EQUALS NOTHING   -- 18 is not under 18
#ASSERT `s 486.4(2.1) the presiding judge or justice may make an order directing that information that could identify the victim not be published` FALSE 17 EQUALS NOTHING   -- an offence referred to in subsection (1)
#ASSERT `s 486.4(2.2) the subsection applies to the proceedings` TRUE 17
#ASSERT NOT (`s 486.4(2.2) the subsection applies to the proceedings` TRUE 18)
#ASSERT `s 486.4(2.2)(a) the presiding judge or justice must inform the victim of their right to make an application for the order` TRUE EQUALS JUST TRUE
#ASSERT `s 486.4(2.2)(a) the presiding judge or justice must inform the victim of their right to make an application for the order` FALSE EQUALS NOTHING
#ASSERT `s 486.4(2.2)(b) the presiding judge or justice must make the order` TRUE (`s 486.4 test: the victim`) EQUALS JUST TRUE
#ASSERT `s 486.4(2.2)(b) the presiding judge or justice must make the order` TRUE (`s 486.4 test: the prosecutor`) EQUALS JUST TRUE
#ASSERT `s 486.4(2.2)(b) the presiding judge or justice must make the order` TRUE (`s 486.4 test: a witness under 18`) EQUALS JUST FALSE   -- (2.2)(b) names the victim and the prosecutor only
#ASSERT `s 486.4(2.2)(b) the presiding judge or justice must make the order` FALSE (`s 486.4 test: the victim`) EQUALS NOTHING
#ASSERT `s 486.4(2.2)(c) the presiding judge or justice must inform the victim of the existence of the order and of their right to apply to revoke or vary it` TRUE EQUALS JUST TRUE
#ASSERT `s 486.4(2.2)(c) the presiding judge or justice must inform the victim of the existence of the order and of their right to apply to revoke or vary it` FALSE EQUALS JUST FALSE

§ `s 486.4(3) to (5)`
#ASSERT `s 486.4(3) the judge or justice must make an order directing that information that could identify the person not be published` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE   -- a witness under eighteen
#ASSERT `s 486.4(3) the judge or justice must make an order directing that information that could identify the person not be published` TRUE FALSE (JUST TRUE) EQUALS JUST TRUE   -- the subject of child sexual abuse and exploitation material
#ASSERT `s 486.4(3) the judge or justice must make an order directing that information that could identify the person not be published` TRUE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 486.4(3) the judge or justice must make an order directing that information that could identify the person not be published` TRUE FALSE NOTHING EQUALS NOTHING   -- the answer of section 163.1 is not given
#ASSERT `s 486.4(3) the judge or justice must make an order directing that information that could identify the person not be published` FALSE TRUE (JUST TRUE) EQUALS NOTHING   -- not an offence under section 163.1
#ASSERT `s 486.4(3.1)(a), (b) the presiding judge or justice must inquire` TRUE TRUE EQUALS JUST `s 486.4(3.1) the victim or witness, whether they wish to be the subject of the order`
#ASSERT `s 486.4(3.1)(a), (b) the presiding judge or justice must inquire` TRUE FALSE EQUALS JUST `s 486.4(3.1) the prosecutor, whether before the application was made they determined if the victim or witness wishes to be the subject of the order`
#ASSERT `s 486.4(3.1)(a), (b) the presiding judge or justice must inquire` FALSE TRUE EQUALS NOTHING
#ASSERT `s 486.4(3.1)(c) the presiding judge or justice must advise the prosecutor of their duty under subsection (3.2)` TRUE EQUALS JUST TRUE
#ASSERT `s 486.4(3.1)(c) the presiding judge or justice must advise the prosecutor of their duty under subsection (3.2)` FALSE EQUALS NOTHING
#ASSERT `s 486.4(3.2) the prosecutor must inform the judge or justice of what they have done` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 486.4(3.2) the prosecutor must inform the judge or justice of what they have done` TRUE FALSE EQUALS JUST FALSE   -- no order yet
#ASSERT `s 486.4(3.2) the prosecutor must inform the judge or justice of what they have done` FALSE TRUE EQUALS JUST FALSE   -- the prosecutor did not make the application
#ASSERT `s 486.4(3.2) what the prosecutor informs the judge or justice of is complete` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 486.4(3.2) what the prosecutor informs the judge or justice of is complete` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 486.4(3.2) what the prosecutor informs the judge or justice of is complete` FALSE TRUE TRUE EQUALS JUST FALSE
-- (4) the order does not apply in (a) the administration of justice, not to make the information known in the community; or (b) the subject's own disclosure about themselves, without revealing another protected person
#ASSERT `s 486.4(4) the order applies to the disclosure of information` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 486.4(4) the order applies to the disclosure of information` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 486.4(4) the order applies to the disclosure of information` TRUE FALSE FALSE FALSE EQUALS NOTHING   -- the purpose was to make it known in the community
#ASSERT `s 486.4(4) the order applies to the disclosure of information` FALSE FALSE TRUE FALSE EQUALS NOTHING   -- the subject revealed another protected person
#ASSERT `s 486.4(4) the order applies to the disclosure of information` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (5) the victim's or witness's disclosure not to make it known to the public, including to a legal professional, a health care professional or a person in a relationship of trust
#ASSERT `s 486.4(5) the order applies to the disclosure of information by the victim or witness` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 486.4(5) the order applies to the disclosure of information by the victim or witness` TRUE TRUE TRUE EQUALS JUST FALSE   -- "including when" made to a legal professional
#ASSERT `s 486.4(5) the order applies to the disclosure of information by the victim or witness` TRUE TRUE FALSE EQUALS NOTHING   -- the purpose was to make it known to the public
#ASSERT `s 486.4(5) the order applies to the disclosure of information by the victim or witness` FALSE FALSE FALSE EQUALS NOTHING   -- not by the victim or witness

§ `s 486.5(1), (2), (2.1)`
#ASSERT `s 486.5(1) the judge or justice may make an order directing that information that could identify the victim or witness not be published` TRUE (`s 486.4 test: the prosecutor`) TRUE EQUALS JUST FALSE   -- "Unless an order is made under section 486.4"
#ASSERT `s 486.5(1) the judge or justice may make an order directing that information that could identify the victim or witness not be published` FALSE (`s 486.4 test: the prosecutor`) TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(1) the judge or justice may make an order directing that information that could identify the victim or witness not be published` FALSE (`s 486.4 test: the victim`) TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(1) the judge or justice may make an order directing that information that could identify the victim or witness not be published` FALSE (`s 486.4 test: an adult witness`) TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(1) the judge or justice may make an order directing that information that could identify the victim or witness not be published` FALSE (`s 486.4 test: the accused`) TRUE EQUALS NOTHING
#ASSERT `s 486.5(1) the judge or justice may make an order directing that information that could identify the victim or witness not be published` FALSE (`s 486.4 test: another person`) TRUE EQUALS NOTHING
#ASSERT `s 486.5(1) the judge or justice may make an order directing that information that could identify the victim or witness not be published` FALSE (`s 486.4 test: the prosecutor`) FALSE EQUALS NOTHING   -- no opinion: a failed "if" gate on a power
-- (2.1) the offences for the purposes of (2)
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 423.1, "") `s 486.5(2.1) this Act` (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 467.13, "") `s 486.5(2.1) this Act` (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 467.14, "") `s 486.5(2.1) this Act` (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 380, "") `s 486.5(2.1) this Act` (JUST TRUE) (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST TRUE   -- (a) a serious offence committed for a criminal organization
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 380, "") `s 486.5(2.1) this Act` (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE   -- a serious offence, not for a criminal organization
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 380, "") `s 486.5(2.1) this Act` (JUST FALSE) (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST TRUE   -- (b) a terrorism offence
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 380, "") `s 486.5(2.1) this Act` NOTHING (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING   -- s 2 "serious offence" not answered
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 380, "") `s 486.5(2.1) this Act` (JUST TRUE) NOTHING (JUST FALSE) FALSE EQUALS NOTHING   -- criminal organization not answered
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 380, "") `s 486.5(2.1) this Act` (JUST FALSE) (JUST FALSE) NOTHING FALSE EQUALS NOTHING   -- s 2 "terrorism offence" not answered
-- (c) subsections 16(1) or (2), 17(1), 19(1), 20(1), 20.1(1), 20.2(1), 20.3(1), 20.4(1), 22(1) of the Foreign Interference and Security of Information Act
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 16, "(1)") `s 486.5(2.1) the Foreign Interference and Security of Information Act` NOTHING NOTHING NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 16, "(2)") `s 486.5(2.1) the Foreign Interference and Security of Information Act` NOTHING NOTHING NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 22, "(1)") `s 486.5(2.1) the Foreign Interference and Security of Information Act` NOTHING NOTHING NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 18, "(1)") `s 486.5(2.1) the Foreign Interference and Security of Information Act` NOTHING NOTHING NOTHING FALSE EQUALS JUST FALSE
-- (d) subsection 21(1) or section 23 of that Act, committed in relation to an offence referred to in paragraph (c)
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 21, "(1)") `s 486.5(2.1) the Foreign Interference and Security of Information Act` NOTHING NOTHING NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 23, "") `s 486.5(2.1) the Foreign Interference and Security of Information Act` NOTHING NOTHING NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 23, "") `s 486.5(2.1) the Foreign Interference and Security of Information Act` NOTHING NOTHING NOTHING FALSE EQUALS JUST FALSE   -- not committed in relation to a (c) offence
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 21, "(1)") `s 486.5(2.1) the Foreign Interference and Security of Information Act` NOTHING NOTHING NOTHING FALSE EQUALS JUST FALSE
-- a number named in (c) but charged under this Act, not that Act
#ASSERT `s 486.5(2.1) the offence is one of the offences for the purposes of subsection (2)` (`Provision of the Code` OF 16, "(1)") `s 486.5(2.1) this Act` (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE
-- (2) justice system participants
#ASSERT `s 486.5(2) the judge or justice may make an order directing that information that could identify the justice system participant not be published` (JUST TRUE) TRUE (`s 486.4 test: the prosecutor`) TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(2) the judge or justice may make an order directing that information that could identify the justice system participant not be published` (JUST TRUE) TRUE (`s 486.4 test: a justice system participant`) TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(2) the judge or justice may make an order directing that information that could identify the justice system participant not be published` NOTHING TRUE (`s 486.4 test: the prosecutor`) TRUE EQUALS NOTHING   -- s 2 "justice system participant" not answered
#ASSERT `s 486.5(2) the judge or justice may make an order directing that information that could identify the justice system participant not be published` (JUST TRUE) FALSE (`s 486.4 test: the prosecutor`) TRUE EQUALS NOTHING   -- not involved in proceedings for an offence in (2.1)
#ASSERT `s 486.5(2) the judge or justice may make an order directing that information that could identify the justice system participant not be published` (JUST TRUE) TRUE (`s 486.4 test: an adult witness`) TRUE EQUALS NOTHING
#ASSERT `s 486.5(2) the judge or justice may make an order directing that information that could identify the justice system participant not be published` (JUST TRUE) TRUE (`s 486.4 test: the prosecutor`) FALSE EQUALS NOTHING

§ `s 486.5(3) to (9)`
#ASSERT `s 486.5(3) the order applies to the disclosure of information` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 486.5(3) the order applies to the disclosure of information` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 486.5(3) the order applies to the disclosure of information` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 486.5(3.1) the order applies to the disclosure of information by the victim, witness or justice system participant` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 486.5(3.1) the order applies to the disclosure of information by the victim, witness or justice system participant` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 486.5(3.1) the order applies to the disclosure of information by the victim, witness or justice system participant` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 486.5(3.1) the order applies to the disclosure of information by the victim, witness or justice system participant` FALSE FALSE FALSE EQUALS NOTHING
-- (4)(a) in writing, to the presiding judge or justice or, if not determined, to a judge of a superior court of criminal jurisdiction in the judicial district
#ASSERT `s 486.5(4)(a) the applicant has applied as required` TRUE `s 486.5(4) the presiding judge or justice` TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(4)(a) the applicant has applied as required` TRUE `s 486.5(4) a judge of a superior court of criminal jurisdiction in the judicial district where the proceedings will take place` FALSE EQUALS JUST TRUE
#ASSERT `s 486.5(4)(a) the applicant has applied as required` TRUE `s 486.5(4) a judge of a superior court of criminal jurisdiction in the judicial district where the proceedings will take place` TRUE EQUALS JUST FALSE   -- the presiding judge or justice has been determined
#ASSERT `s 486.5(4)(a) the applicant has applied as required` TRUE `s 486.5(4) the presiding judge or justice` FALSE EQUALS JUST FALSE   -- not determined: the text sends the application to the superior court judge
#ASSERT `s 486.5(4)(a) the applicant has applied as required` FALSE `s 486.5(4) the presiding judge or justice` TRUE EQUALS JUST FALSE   -- not in writing
#ASSERT `s 486.5(4)(a) the applicant has applied as required` TRUE `s 486.5(4) another judge or justice` TRUE EQUALS JUST FALSE
-- (4)(b) notice to the prosecutor, the accused and any other person affected that the judge or justice specifies
#ASSERT `s 486.5(4)(b) the applicant has provided notice of the application` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(4)(b) the applicant has provided notice of the application` TRUE FALSE TRUE EQUALS JUST FALSE   -- no notice to the accused
#ASSERT `s 486.5(4)(b) the applicant has provided notice of the application` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 486.5(4)(b) the applicant has provided notice of the application` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 486.5(5) the applicant has set out the grounds` TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(5) the applicant has set out the grounds` FALSE EQUALS JUST FALSE
#ASSERT `s 486.5(5.1)(a), (b) the judge or justice must inquire` TRUE TRUE EQUALS JUST `s 486.4(3.1) the victim or witness, whether they wish to be the subject of the order`
#ASSERT `s 486.5(5.1)(a), (b) the judge or justice must inquire` TRUE FALSE EQUALS JUST `s 486.4(3.1) the prosecutor, whether before the application was made they determined if the victim or witness wishes to be the subject of the order`
#ASSERT `s 486.5(5.1)(a), (b) the judge or justice must inquire` FALSE TRUE EQUALS NOTHING
#ASSERT `s 486.5(5.1)(c) the judge or justice must advise the prosecutor of their duty under subsection (8.2)` TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(5.1)(c) the judge or justice must advise the prosecutor of their duty under subsection (8.2)` FALSE EQUALS NOTHING
#ASSERT `s 486.5(6) the judge or justice may hold a hearing, and the hearing may be in private` TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(6) the judge or justice may hold a hearing, and the hearing may be in private` FALSE EQUALS NOTHING
#ASSERT `s 486.5(7) the judge or justice must consider the factor` (`s 486.5(7)(a) the right to a fair and public hearing`) TRUE FALSE EQUALS JUST TRUE   -- (a) is listed: always to be considered
#ASSERT `s 486.5(7) the judge or justice must consider the factor` (`s 486.5(7)(b) whether there is a real and substantial risk that the victim, witness or justice system participant would suffer harm if their identity were disclosed`) TRUE FALSE EQUALS JUST TRUE   -- (b) is listed: always to be considered
#ASSERT `s 486.5(7) the judge or justice must consider the factor` (`s 486.5(7)(c) whether the victim, witness or justice system participant needs the order for their security or to protect them from intimidation or retaliation`) TRUE FALSE EQUALS JUST TRUE   -- (c) is listed: always to be considered
#ASSERT `s 486.5(7) the judge or justice must consider the factor` (`s 486.5(7)(d) society’s interest in encouraging the reporting of offences and the participation of victims, witnesses and justice system participants in the criminal justice process`) TRUE FALSE EQUALS JUST TRUE   -- (d) is listed: always to be considered
#ASSERT `s 486.5(7) the judge or justice must consider the factor` (`s 486.5(7)(e) whether effective alternatives are available to protect the identity of the victim, witness or justice system participant`) TRUE FALSE EQUALS JUST TRUE   -- (e) is listed: always to be considered
#ASSERT `s 486.5(7) the judge or justice must consider the factor` (`s 486.5(7)(f) the salutary and deleterious effects of the proposed order`) TRUE FALSE EQUALS JUST TRUE   -- (f) is listed: always to be considered
#ASSERT `s 486.5(7) the judge or justice must consider the factor` (`s 486.5(7)(g) the impact of the proposed order on the freedom of expression of those affected by it`) TRUE FALSE EQUALS JUST TRUE   -- (g) is listed: always to be considered
#ASSERT `s 486.5(7) the judge or justice must consider the factor` (`s 486.5(7)(h) any other factor that the judge or justice considers relevant`) TRUE TRUE EQUALS JUST TRUE   -- (h): any other factor the judge or justice considers relevant
#ASSERT `s 486.5(7) the judge or justice must consider the factor` (`s 486.5(7)(h) any other factor that the judge or justice considers relevant`) TRUE FALSE EQUALS JUST FALSE   -- (h): a factor the judge or justice does not consider relevant
#ASSERT `s 486.5(7) the judge or justice must consider the factor` (`s 486.5(7)(a) the right to a fair and public hearing`) FALSE FALSE EQUALS NOTHING   -- outside the determination the lead-in names
#ASSERT `s 486.5(8) the order may be subject to the condition` TRUE EQUALS JUST TRUE
#ASSERT `s 486.5(8) the order may be subject to the condition` FALSE EQUALS NOTHING
