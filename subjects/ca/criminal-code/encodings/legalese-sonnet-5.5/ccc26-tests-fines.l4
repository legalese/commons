IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc26-interpretation`
IMPORT `ccc26-fines`

-- ccc26-tests-fines.l4 -- tests for ccc26-fines.l4. Every expected value is written from the text before the run.
-- (sections 734 to 736; lines 15645-15768 of the text)


§ `s 734(1): the power to fine`

-- in addition to another sanction
#ASSERT `s 734(1) the court may fine the offender by making an order under section 734.1` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- no minimum term: in lieu of another sanction is allowed
#ASSERT `s 734(1) the court may fine the offender by making an order under section 734.1` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- a minimum term: in addition to another sanction
#ASSERT `s 734(1) the court may fine the offender by making an order under section 734.1` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- a minimum term and a fine in lieu of another sanction: outside paragraph (b)
#ASSERT `s 734(1) the court may fine the offender by making an order under section 734.1` TRUE FALSE TRUE TRUE EQUALS NOTHING
-- no conviction
#ASSERT `s 734(1) the court may fine the offender by making an order under section 734.1` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- an organization: "other than an organization"
#ASSERT `s 734(1) the court may fine the offender by making an order under section 734.1` TRUE TRUE FALSE FALSE EQUALS NOTHING

§ `s 734(2): the ability-to-pay bar`

-- no minimum fine, not in lieu of forfeiture, the court is not satisfied of ability to pay
#ASSERT `s 734(2) the ability-to-pay condition bars the fine` FALSE FALSE FALSE EQUALS JUST TRUE
-- "only if the court is satisfied that the offender is able to pay": satisfied
#ASSERT `s 734(2) the ability-to-pay condition bars the fine` FALSE FALSE TRUE EQUALS JUST FALSE
-- "Except when the punishment ... includes a minimum fine"
#ASSERT `s 734(2) the ability-to-pay condition bars the fine` TRUE FALSE FALSE EQUALS JUST FALSE
-- "or a fine is imposed in lieu of a forfeiture order"
#ASSERT `s 734(2) the ability-to-pay condition bars the fine` FALSE TRUE FALSE EQUALS JUST FALSE

§ `s 734(3): default of payment`

-- paid in full by the time set out in the order
#ASSERT `s 734(3) the person is in default of payment of the fine` TRUE EQUALS JUST FALSE
#ASSERT `s 734(3) the person is in default of payment of the fine` FALSE EQUALS JUST TRUE

§ `s 734(4): the deemed term`

#ASSERT `s 734(4) a term of imprisonment is deemed to be imposed in default of payment of the fine` TRUE EQUALS JUST TRUE
-- not an offender fined under section 734
#ASSERT `s 734(4) a term of imprisonment is deemed to be imposed in default of payment of the fine` FALSE EQUALS NOTHING

§ `s 734(5): the term of imprisonment in default`

-- 2026-03-01 to 2028-03-01 includes 29 February 2028
#ASSERT `s 734(5)(b) the number of days in the term counted from the date of default` `two years` (Date 1 3 2026) EQUALS 731
#ASSERT `s 734(5)(b) the number of days in the term counted from the date of default` `two years less a day` (Date 1 3 2026) EQUALS 730
-- 2026-03-01 to 2031-03-01 includes 29 February 2028 only
#ASSERT `s 734(5)(b) the number of days in the term counted from the date of default` `five years` (Date 1 3 2026) EQUALS 1826
#ASSERT `s 734(5)(b) the number of days in the term counted from the date of default` (`Length of time` OF 0, 0, 10, FALSE) (Date 1 3 2026) EQUALS 10
-- one month from 1 March: to 1 April
#ASSERT `s 734(5)(b) the number of days in the term counted from the date of default` (`Length of time` OF 0, 1, 0, FALSE) (Date 1 3 2026) EQUALS 31
-- 1000 / 120 = 8.33, rounded down
#ASSERT `s 734(5)(a) the number of days that corresponds to the fraction, rounded down to the nearest whole number` 1000 0 15 EQUALS JUST 8
-- 960 / 120 = 8 exactly
#ASSERT `s 734(5)(a) the number of days that corresponds to the fraction, rounded down to the nearest whole number` 960 0 15 EQUALS JUST 8
-- the numerator is the unpaid amount plus the costs and charges
#ASSERT `s 734(5)(a) the number of days that corresponds to the fraction, rounded down to the nearest whole number` 900 60 15 EQUALS JUST 8
-- 959 / 120 = 7.99, rounded down
#ASSERT `s 734(5)(a) the number of days that corresponds to the fraction, rounded down to the nearest whole number` 959 0 15 EQUALS JUST 7
-- no positive hourly wage
#ASSERT `s 734(5)(a) the number of days that corresponds to the fraction, rounded down to the nearest whole number` 1000 0 0 EQUALS NOTHING
#ASSERT `s 734(5)(a) the number of days that corresponds to the fraction, rounded down to the nearest whole number` 1000 0 -1 EQUALS NOTHING
-- the maximum term the court could itself impose
#ASSERT `s 734(5)(b) the maximum number of days of the term` (`imprisonment for a term of` `two years`) `on summary conviction` (Date 1 3 2026) EQUALS JUST 731
-- no term of imprisonment in the punishment: five years on indictment
#ASSERT `s 734(5)(b) the maximum number of days of the term` `no imprisonment is stated` `by indictment` (Date 1 3 2026) EQUALS JUST 1826
-- no term of imprisonment in the punishment: two years less a day on summary conviction
#ASSERT `s 734(5)(b) the maximum number of days of the term` `no imprisonment is stated` `on summary conviction` (Date 1 3 2026) EQUALS JUST 730
-- imprisonment for life leaves paragraph (b) without a ceiling in days
#ASSERT `s 734(5)(b) the maximum number of days of the term` `imprisonment for life` `by indictment` (Date 1 3 2026) EQUALS NOTHING
-- the lesser: 8 days against a ceiling of 731
#ASSERT `s 734(5) the term of imprisonment in default of payment of the fine, in days` 1000 0 15 (`imprisonment for a term of` `two years`) `on summary conviction` (Date 1 3 2026) EQUALS JUST 8
-- the lesser: the five-year ceiling against 8333 days
#ASSERT `s 734(5) the term of imprisonment in default of payment of the fine, in days` 1000000 0 15 `no imprisonment is stated` `by indictment` (Date 1 3 2026) EQUALS JUST 1826
#ASSERT `s 734(5) the term of imprisonment in default of payment of the fine, in days` 1000000 0 15 `no imprisonment is stated` `on summary conviction` (Date 1 3 2026) EQUALS JUST 730
-- 219120 / 120 = 1826: equal to the ceiling
#ASSERT `s 734(5) the term of imprisonment in default of payment of the fine, in days` 219120 0 15 `no imprisonment is stated` `by indictment` (Date 1 3 2026) EQUALS JUST 1826
-- 1827 days against 1826
#ASSERT `s 734(5) the term of imprisonment in default of payment of the fine, in days` 219240 0 15 `no imprisonment is stated` `by indictment` (Date 1 3 2026) EQUALS JUST 1826
-- life: no ceiling, so paragraph (a)
#ASSERT `s 734(5) the term of imprisonment in default of payment of the fine, in days` 1000 0 15 `imprisonment for life` `by indictment` (Date 1 3 2026) EQUALS JUST 8
-- no positive wage
#ASSERT `s 734(5) the term of imprisonment in default of payment of the fine, in days` 1000 0 0 (`imprisonment for a term of` `two years`) `on summary conviction` (Date 1 3 2026) EQUALS NOTHING

§ `s 734(6): moneys found on the offender`

#ASSERT `s 734(6) all or any part of the fine may be taken out of the moneys found` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- the court has not so directed
#ASSERT `s 734(6) all or any part of the fine may be taken out of the moneys found` TRUE TRUE TRUE FALSE EQUALS NOTHING
-- ownership is disputed by claimants other than the offender
#ASSERT `s 734(6) all or any part of the fine may be taken out of the moneys found` TRUE TRUE FALSE TRUE EQUALS NOTHING
-- not moneys found at the time of the arrest
#ASSERT `s 734(6) all or any part of the fine may be taken out of the moneys found` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 734(6) all or any part of the fine may be taken out of the moneys found` FALSE TRUE TRUE TRUE EQUALS NOTHING

§ `s 734(8): application to a fine under any Act of Parliament`

#ASSERT `s 734(8) subsections 734(4) and (5) apply to the fine` TRUE FALSE FALSE EQUALS JUST TRUE
-- "calculated by a different method"
#ASSERT `s 734(8) subsections 734(4) and (5) apply to the fine` TRUE TRUE FALSE EQUALS JUST FALSE
-- "specified, either as a minimum or a maximum"
#ASSERT `s 734(8) subsections 734(4) and (5) apply to the fine` TRUE FALSE TRUE EQUALS JUST FALSE
-- not a fine imposed under an Act of Parliament
#ASSERT `s 734(8) subsections 734(4) and (5) apply to the fine` FALSE FALSE FALSE EQUALS NOTHING

§ `s 734.1: the terms of the order`

#ASSERT `s 734.1 the order clearly sets out the terms the section requires` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 734.1 the order clearly sets out the terms the section requires` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- other terms the court deems appropriate are not set out
#ASSERT `s 734.1 the order clearly sets out the terms the section requires` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- the amount is not clearly set out
#ASSERT `s 734.1 the order clearly sets out the terms the section requires` TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- the manner of payment
#ASSERT `s 734.1 the order clearly sets out the terms the section requires` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- the time or times of payment
#ASSERT `s 734.1 the order clearly sets out the terms the section requires` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- not a fine under section 734
#ASSERT `s 734.1 the order clearly sets out the terms the section requires` FALSE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING

§ `s 734.2: the obligations of the court`

#ASSERT `s 734.2(1)(a) the court must cause a copy of the order to be given to the offender` TRUE EQUALS JUST TRUE
-- no order is made under section 734.1
#ASSERT `s 734.2(1)(a) the court must cause a copy of the order to be given to the offender` FALSE EQUALS NOTHING
#ASSERT `s 734.2(1)(b) the court must explain the substance of sections 734 to 734.8 and 736 to the offender` TRUE EQUALS JUST TRUE
-- no order is made under section 734.1
#ASSERT `s 734.2(1)(b) the court must explain the substance of sections 734 to 734.8 and 736 to the offender` FALSE EQUALS NOTHING
#ASSERT `s 734.2(1)(c) the court must cause an explanation to be given to the offender of the procedure for applying for a change and of any available fine option programs` TRUE EQUALS JUST TRUE
-- no order is made under section 734.1
#ASSERT `s 734.2(1)(c) the court must cause an explanation to be given to the offender of the procedure for applying for a change and of any available fine option programs` FALSE EQUALS NOTHING
#ASSERT `s 734.2(1)(d) the court must take reasonable measures to ensure that the offender understands the order and the explanations` TRUE EQUALS JUST TRUE
-- no order is made under section 734.1
#ASSERT `s 734.2(1)(d) the court must take reasonable measures to ensure that the offender understands the order and the explanations` FALSE EQUALS NOTHING
#ASSERT `s 734.2(2) the failure leaves the validity of the order unaffected` TRUE EQUALS JUST TRUE
#ASSERT `s 734.2(2) the failure leaves the validity of the order unaffected` FALSE EQUALS NOTHING

§ `s 734.3: change in terms of the order`

#ASSERT `s 734.3 the court or its designate may change the term of the order` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- "on application by or on behalf of the offender"
#ASSERT `s 734.3 the court or its designate may change the term of the order` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- "except the amount of the fine"
#ASSERT `s 734.3 the court or its designate may change the term of the order` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- "subject to any rules made by the court under section 482 or 482.1": outside this text
#ASSERT `s 734.3 the court or its designate may change the term of the order` TRUE TRUE FALSE TRUE EQUALS NOTHING
-- not the court or its designate
#ASSERT `s 734.3 the court or its designate may change the term of the order` FALSE TRUE FALSE FALSE EQUALS NOTHING

§ `s 734.4: whose the proceeds are`

#ASSERT `s 734.4 whose the proceeds are` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST `s 734.4(1) Her Majesty in right of the province in which the fine or forfeiture was imposed or the amount was forfeited`
-- a contravention of a revenue law of Canada
#ASSERT `s 734.4 whose the proceeds are` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST `s 734.4(2) Her Majesty in right of Canada`
#ASSERT `s 734.4 whose the proceeds are` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST `s 734.4(2) Her Majesty in right of Canada`
#ASSERT `s 734.4 whose the proceeds are` TRUE TRUE FALSE FALSE TRUE FALSE EQUALS JUST `s 734.4(2) Her Majesty in right of Canada`
#ASSERT `s 734.4 whose the proceeds are` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST `s 734.4(2) Her Majesty in right of Canada`
-- another provision of law applies the proceeds
#ASSERT `s 734.4 whose the proceeds are` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- no fine or forfeiture
#ASSERT `s 734.4 whose the proceeds are` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 734.4(3)(a) the lieutenant governor in council of a province may direct that the proceeds be paid to that authority` TRUE TRUE EQUALS JUST TRUE
-- "If a provincial, municipal or local authority bears ... the expense": not met
#ASSERT `s 734.4(3)(a) the lieutenant governor in council of a province may direct that the proceeds be paid to that authority` FALSE TRUE EQUALS NOTHING
-- the proceeds do not belong to Her Majesty in right of the province
#ASSERT `s 734.4(3)(a) the lieutenant governor in council of a province may direct that the proceeds be paid to that authority` TRUE FALSE EQUALS NOTHING
#ASSERT `s 734.4(3)(b) the Governor in Council may direct that the proceeds be paid to that authority` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 734.4(3)(b) the Governor in Council may direct that the proceeds be paid to that authority` FALSE TRUE EQUALS NOTHING
#ASSERT `s 734.4(3)(b) the Governor in Council may direct that the proceeds be paid to that authority` TRUE FALSE EQUALS NOTHING

§ `s 734.5: licences, permits and similar instruments`

-- paragraph (a)
#ASSERT `s 734.5 the person responsible may refuse to issue or renew or may suspend the licence, permit or other instrument until the fine is paid in full` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- paragraph (b)
#ASSERT `s 734.5 the person responsible may refuse to issue or renew or may suspend the licence, permit or other instrument until the fine is paid in full` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
-- paragraph (c)
#ASSERT `s 734.5 the person responsible may refuse to issue or renew or may suspend the licence, permit or other instrument until the fine is paid in full` TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- proceeds of the province but a federal issuer: not described
#ASSERT `s 734.5 the person responsible may refuse to issue or renew or may suspend the licence, permit or other instrument until the fine is paid in full` TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING
-- "If an offender is in default of payment of a fine": not in default
#ASSERT `s 734.5 the person responsible may refuse to issue or renew or may suspend the licence, permit or other instrument until the fine is paid in full` FALSE TRUE FALSE TRUE FALSE EQUALS NOTHING
-- "where the proceeds of the fine belong to Her Majesty": they belong to neither
#ASSERT `s 734.5 the person responsible may refuse to issue or renew or may suspend the licence, permit or other instrument until the fine is paid in full` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE

§ `s 734.6: civil enforcement`

#ASSERT `s 734.6(1) the Attorney General may enter the amount of the fine or forfeiture, and costs, as a judgment in a civil court by filing the order` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
-- a forfeiture not paid; the Attorney General of Canada
#ASSERT `s 734.6(1) the Attorney General may enter the amount of the fine or forfeiture, and costs, as a judgment in a civil court by filing the order` FALSE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- "Where (a) an offender is in default of payment of a fine, or (b) a forfeiture ... is not paid"
#ASSERT `s 734.6(1) the Attorney General may enter the amount of the fine or forfeiture, and costs, as a judgment in a civil court by filing the order` FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
-- not one of the two Attorneys General the paragraphs name
#ASSERT `s 734.6(1) the Attorney General may enter the amount of the fine or forfeiture, and costs, as a judgment in a civil court by filing the order` TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING
-- no civil court with jurisdiction
#ASSERT `s 734.6(1) the Attorney General may enter the amount of the fine or forfeiture, and costs, as a judgment in a civil court by filing the order` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 734.6(2) the entered order is enforceable in the same manner as a judgment obtained by the Attorney General in civil proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 734.6(2) the entered order is enforceable in the same manner as a judgment obtained by the Attorney General in civil proceedings` FALSE EQUALS NOTHING

§ `s 734.7: warrant of committal`

-- no time has been allowed: subsection (2) applies instead
#ASSERT `s 734.7(1) the court is barred from issuing a warrant of committal in default of payment of the fine` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- "until the expiration of the time allowed"
#ASSERT `s 734.7(1) the court is barred from issuing a warrant of committal in default of payment of the fine` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- before the time expires, nothing the court is satisfied of lifts the bar
#ASSERT `s 734.7(1) the court is barred from issuing a warrant of committal in default of payment of the fine` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- the time has expired but the court is satisfied of neither (i) nor (ii)
#ASSERT `s 734.7(1) the court is barred from issuing a warrant of committal in default of payment of the fine` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- "unless the court is satisfied (i) that the mechanisms ... are not appropriate"
#ASSERT `s 734.7(1) the court is barred from issuing a warrant of committal in default of payment of the fine` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- "or (ii) that the offender has, without reasonable excuse, refused to pay"
#ASSERT `s 734.7(1) the court is barred from issuing a warrant of committal in default of payment of the fine` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 734.7(1) the court is barred from issuing a warrant of committal in default of payment of the fine` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- no time has been allowed
#ASSERT `s 734.7(1) the court's duty not to issue a warrant of committal before the time for payment has expired` FALSE 30 EQUALS FULFILLED
-- the court issues the warrant on day 10 of the 30 days allowed: breach
#TRACE `s 734.7(1) the court's duty not to issue a warrant of committal before the time for payment has expired` TRUE 30 AT 0 WITH
    PARTY `the court` DOES `s 734.7(1) issue a warrant of committal in default of payment of the fine` AT 10
-- nothing issued by day 31: fulfilled
#TRACE `s 734.7(1) the court's duty not to issue a warrant of committal before the time for payment has expired` TRUE 30 AT 0 WITH
    (WAITUNTIL 31)
#ASSERT `s 734.7(2) the court must state in the warrant the reason for immediate committal` TRUE TRUE EQUALS JUST TRUE
-- time was allowed
#ASSERT `s 734.7(2) the court must state in the warrant the reason for immediate committal` FALSE TRUE EQUALS JUST FALSE
-- no warrant is issued
#ASSERT `s 734.7(2) the court must state in the warrant the reason for immediate committal` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 734.7(2.1) the warrant must specify the period of imprisonment in default of payment of the fine` TRUE EQUALS JUST TRUE
#ASSERT `s 734.7(2.1) the warrant must specify the period of imprisonment in default of payment of the fine` FALSE EQUALS NOTHING
#ASSERT `s 734.7(3) the provisions of Parts XVI and XVIII for compelling the appearance of an accused apply to the proceeding` TRUE EQUALS JUST TRUE
#ASSERT `s 734.7(3) the provisions of Parts XVI and XVIII for compelling the appearance of an accused apply to the proceeding` FALSE EQUALS NOTHING
#ASSERT `s 734.7(4) the imprisonment terminates the operation of sections 734.5 and 734.6 in relation to the fine` TRUE EQUALS JUST TRUE
#ASSERT `s 734.7(4) the imprisonment terminates the operation of sections 734.5 and 734.6 in relation to the fine` FALSE EQUALS NOTHING

§ `s 734.8: part payment, and the application of money paid`

-- a quarter of the penalty paid takes a quarter off the term
#ASSERT `s 734.8(2) the number of days by which the term is reduced` 100 250 1000 EQUALS JUST 25
-- the text states the proportion and no rounding
#ASSERT `s 734.8(2) the number of days by which the term is reduced` 7 1 2 EQUALS JUST (7 DIVIDED BY 2)
#ASSERT `s 734.8(2) the number of days by which the term is reduced` 100 0 1000 EQUALS JUST 0
#ASSERT `s 734.8(2) the number of days by which the term is reduced` 100 1000 1000 EQUALS JUST 100
-- no total penalty
#ASSERT `s 734.8(2) the number of days by which the term is reduced` 100 10 0 EQUALS NOTHING
-- exactly one day
#ASSERT `s 734.8(3) acceptance of the part payment is barred` TRUE 1 TRUE EQUALS JUST FALSE
-- a whole number multiple of one day
#ASSERT `s 734.8(3) acceptance of the part payment is barred` TRUE 3 TRUE EQUALS JUST FALSE
-- half a day, after execution
#ASSERT `s 734.8(3) acceptance of the part payment is barred` TRUE (1 DIVIDED BY 2) TRUE EQUALS JUST TRUE
-- a day and a half, after execution
#ASSERT `s 734.8(3) acceptance of the part payment is barred` TRUE (3 DIVIDED BY 2) TRUE EQUALS JUST TRUE
-- before the warrant is executed the whole-day rule does not apply
#ASSERT `s 734.8(3) acceptance of the part payment is barred` FALSE (1 DIVIDED BY 2) TRUE EQUALS JUST FALSE
-- "no part payment shall be accepted until any fee ... has been paid"
#ASSERT `s 734.8(3) acceptance of the part payment is barred` FALSE 5 FALSE EQUALS JUST TRUE
#ASSERT `s 734.8(3) acceptance of the part payment is barred` TRUE 2 FALSE EQUALS JUST TRUE
#ASSERT `s 734.8(4) payment may be made to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 734.8(4) payment may be made to the person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 734.8(4) payment may be made to the person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 734.8(5) the part of the payment applied firstly to the costs and charges` 100 30 EQUALS 30
-- a payment short of the costs and charges is all applied to them
#ASSERT `s 734.8(5) the part of the payment applied firstly to the costs and charges` 20 30 EQUALS 20
#ASSERT `s 734.8(5) the part of the payment applied secondly to the victim surcharge imposed under section 737` 100 30 50 EQUALS 50
#ASSERT `s 734.8(5) the part of the payment applied secondly to the victim surcharge imposed under section 737` 100 30 100 EQUALS 70
-- nothing is left after the costs and charges
#ASSERT `s 734.8(5) the part of the payment applied secondly to the victim surcharge imposed under section 737` 20 30 50 EQUALS 0
#ASSERT `s 734.8(5) the part of the payment applied then to the part of the fine that remains unpaid` 100 30 50 1000 EQUALS 20
-- not more than the fine that remains unpaid
#ASSERT `s 734.8(5) the part of the payment applied then to the part of the fine that remains unpaid` 200 30 50 100 EQUALS 100
#ASSERT `s 734.8(5) the part of the payment applied then to the part of the fine that remains unpaid` 80 30 50 1000 EQUALS 0

§ `s 735: fines on organizations`

#ASSERT `s 735(1)(b) one hundred thousand dollars` EQUALS 100000
-- an indictable offence: in the discretion of the court
#ASSERT `s 735(1) the organization is liable to be fined in the amount, in lieu of any imprisonment prescribed` TRUE `by indictment` 1000000 EQUALS JUST TRUE
-- exactly one hundred thousand dollars
#ASSERT `s 735(1) the organization is liable to be fined in the amount, in lieu of any imprisonment prescribed` TRUE `on summary conviction` 100000 EQUALS JUST TRUE
-- over one hundred thousand dollars on summary conviction: outside the limit
#ASSERT `s 735(1) the organization is liable to be fined in the amount, in lieu of any imprisonment prescribed` TRUE `on summary conviction` 100001 EQUALS NOTHING
#ASSERT `s 735(1) the organization is liable to be fined in the amount, in lieu of any imprisonment prescribed` TRUE `on summary conviction` 50000 EQUALS JUST TRUE
-- not an organization convicted of an offence
#ASSERT `s 735(1) the organization is liable to be fined in the amount, in lieu of any imprisonment prescribed` FALSE `by indictment` 1000 EQUALS NOTHING
#ASSERT `s 735(1.1) the order clearly sets out the terms the subsection requires` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 735(1.1) the order clearly sets out the terms the subsection requires` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 735(1.1) the order clearly sets out the terms the subsection requires` TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 735(1.1) the order clearly sets out the terms the subsection requires` FALSE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 735(2) section 734.6 applies` TRUE EQUALS JUST TRUE
#ASSERT `s 735(2) section 734.6 applies` FALSE EQUALS NOTHING

§ `s 736(1): the fine option program`

-- exactly two years
#ASSERT `s 736(1) the offender may discharge the fine in whole or in part by earning credits for work performed in the program` TRUE TRUE FALSE FALSE TRUE `two years` EQUALS JUST TRUE
-- a program of the province of residence, with an agreement
#ASSERT `s 736(1) the offender may discharge the fine in whole or in part by earning credits for work performed in the program` TRUE FALSE TRUE TRUE TRUE `two years` EQUALS JUST TRUE
-- "(b) ... where an appropriate agreement is in effect": none
#ASSERT `s 736(1) the offender may discharge the fine in whole or in part by earning credits for work performed in the program` TRUE FALSE TRUE FALSE TRUE `two years` EQUALS JUST FALSE
-- "if the offender is admissible to such a program": not met
#ASSERT `s 736(1) the offender may discharge the fine in whole or in part by earning credits for work performed in the program` TRUE TRUE FALSE FALSE FALSE `two years` EQUALS NOTHING
-- over two years: outside the limit of the grant
#ASSERT `s 736(1) the offender may discharge the fine in whole or in part by earning credits for work performed in the program` TRUE TRUE FALSE FALSE TRUE (`Length of time` OF 2, 0, 1, FALSE) EQUALS NOTHING
#ASSERT `s 736(1) the offender may discharge the fine in whole or in part by earning credits for work performed in the program` TRUE TRUE FALSE FALSE TRUE `two years less a day` EQUALS JUST TRUE
-- not an offender fined under section 734
#ASSERT `s 736(1) the offender may discharge the fine in whole or in part by earning credits for work performed in the program` FALSE TRUE FALSE FALSE TRUE `two years` EQUALS NOTHING
-- no program of the kind the paragraphs describe
#ASSERT `s 736(1) the offender may discharge the fine in whole or in part by earning credits for work performed in the program` TRUE FALSE FALSE FALSE TRUE `two years` EQUALS NOTHING
#ASSERT `s 736(3) the credits are deemed to be payment in respect of a fine` TRUE EQUALS JUST TRUE
#ASSERT `s 736(3) the credits are deemed to be payment in respect of a fine` FALSE EQUALS NOTHING
#ASSERT `s 736(4) the offender may discharge the fine in whole or in part in a fine option program of a province` TRUE TRUE EQUALS JUST TRUE
-- "Where, by virtue of subsection 734.4(2), the proceeds ... belong to Her Majesty in right of Canada"
#ASSERT `s 736(4) the offender may discharge the fine in whole or in part in a fine option program of a province` FALSE TRUE EQUALS JUST FALSE
-- "where an appropriate agreement is in effect"
#ASSERT `s 736(4) the offender may discharge the fine in whole or in part in a fine option program of a province` TRUE FALSE EQUALS JUST FALSE
