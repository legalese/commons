IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc12-logic`
IMPORT `ccc12-tests-fixtures`
IMPORT `ccc12-part9-criminal-interest`

-- Tests of ss 347 to 347.1. Expected values are hand-written from the text (the 35 per cent, $5, $1,500 and 62 days of the text are tested on both sides) before each run.
-- Arguments are positional, in the GIVEN order of each function.

§ `s 347(1) the offence`
-- the rate is a criminal rate (s 347(2)), enters or offers to enter into an agreement, advertises an offer, receives a payment or partial payment
#ASSERT `s 347(1) the person commits the offence of receiving interest at a criminal rate` (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 347(1) the person commits the offence of receiving interest at a criminal rate` (JUST TRUE) FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 347(1) the person commits the offence of receiving interest at a criminal rate` (JUST TRUE) FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 347(1) the person commits the offence of receiving interest at a criminal rate` (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 347(1) the person commits the offence of receiving interest at a criminal rate` (JUST FALSE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 347(1) the person commits the offence of receiving interest at a criminal rate` NOTHING TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 347(1) the person commits the offence of receiving interest at a criminal rate` NOTHING FALSE FALSE FALSE EQUALS JUST FALSE
-- (a) indictable, not exceeding five years; (b) summary: a fine of not more than $25,000 or imprisonment of not more than two years less a day, or both
#ASSERT `s 347(1) the punishment for the offence` EQUALS LIST `ccc12 fixture indictable, up to five years`, Punishment OF `on summary conviction`, `imprisonment for a term of` `two years less a day`, `no imprisonment is stated`, `a fine of` 25000, `no fine is stated`

§ `s 347(2) definitions`
-- credit advanced = (money + monetary value of goods, services, benefits) - (required deposit balance + fees, fines, penalties, commissions and similar charges)
#ASSERT `s 347(2) credit advanced` 1000 0 0 0 EQUALS 1000
#ASSERT `s 347(2) credit advanced` 1000 500 100 50 EQUALS 1350
#ASSERT `s 347(2) credit advanced` 1000 0 0 1000 EQUALS 0
#ASSERT `s 347(2) credit advanced` 0 800 0 100 EQUALS 700
-- criminal rate: calculated in accordance with generally accepted actuarial practices and principles, exceeding 35 per cent
#ASSERT `s 347(2) the rate is a criminal rate` 35.01 TRUE EQUALS JUST TRUE
#ASSERT `s 347(2) the rate is a criminal rate` 36 TRUE EQUALS JUST TRUE
#ASSERT `s 347(2) the rate is a criminal rate` 100 TRUE EQUALS JUST TRUE
#ASSERT `s 347(2) the rate is a criminal rate` 35 TRUE EQUALS JUST FALSE
#ASSERT `s 347(2) the rate is a criminal rate` 34.99 TRUE EQUALS JUST FALSE
#ASSERT `s 347(2) the rate is a criminal rate` 60 FALSE EQUALS JUST FALSE
-- insurance charge: the cost of insuring the risk, face amount not exceeding the credit advanced
#ASSERT `s 347(2) the cost is an insurance charge` TRUE 100 100 EQUALS JUST TRUE
#ASSERT `s 347(2) the cost is an insurance charge` TRUE 0 100 EQUALS JUST TRUE
#ASSERT `s 347(2) the cost is an insurance charge` TRUE 101 100 EQUALS JUST FALSE
#ASSERT `s 347(2) the cost is an insurance charge` FALSE 50 100 EQUALS JUST FALSE
-- interest: aggregate of all charges, less repayment of credit, insurance charge, official fee, overdraft charge, required deposit balance and (mortgage only) property taxes
#ASSERT `s 347(2) interest` 1000 200 50 25 5 100 FALSE 40 EQUALS 620
#ASSERT `s 347(2) interest` 1000 200 50 25 5 100 TRUE 40 EQUALS 580
#ASSERT `s 347(2) interest` 500 0 0 0 0 0 FALSE 0 EQUALS 500
#ASSERT `s 347(2) interest` 500 0 0 0 0 0 TRUE 500 EQUALS 0
-- official fee: required by law, to a governmental authority, in connection with perfecting security
#ASSERT `s 347(2) the fee is an official fee` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 347(2) the fee is an official fee` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 347(2) the fee is an official fee` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 347(2) the fee is an official fee` TRUE TRUE FALSE EQUALS JUST FALSE
-- overdraft charge: not exceeding five dollars, for an overdraft, by a credit union or caisse populaire or a deposit taking institution
#ASSERT `s 347(2) the charge is an overdraft charge` 5 TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 347(2) the charge is an overdraft charge` 4.99 TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 347(2) the charge is an overdraft charge` 5.01 TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 347(2) the charge is an overdraft charge` 5 FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 347(2) the charge is an overdraft charge` 5 TRUE FALSE FALSE EQUALS JUST FALSE
-- required deposit balance
#ASSERT `s 347(2) the amount is a required deposit balance` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 347(2) the amount is a required deposit balance` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 347(2) the amount is a required deposit balance` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 347(2) the amount is a required deposit balance` TRUE TRUE FALSE EQUALS JUST FALSE

§ `s 347(3) to (8)`
-- (3): receives a payment of interest at a criminal rate, evidence to the contrary
#ASSERT `s 347(3) the person is deemed to have knowledge of the nature of the payment and that it was received at a criminal rate` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 347(3) the person is deemed to have knowledge of the nature of the payment and that it was received at a criminal rate` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 347(3) the person is deemed to have knowledge of the nature of the payment and that it was received at a criminal rate` FALSE FALSE EQUALS JUST FALSE
-- (4): proceedings under s 347, a certificate of a Fellow of the Canadian Institute of Actuaries, it states the calculation, it sets out the calculations and information, evidence to the contrary
#ASSERT `s 347(4) the certificate is proof of the annual percentage rate of interest without proof of the signature or official character of the person appearing to have signed it` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 347(4) the certificate is proof of the annual percentage rate of interest without proof of the signature or official character of the person appearing to have signed it` TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 347(4) the certificate is proof of the annual percentage rate of interest without proof of the signature or official character of the person appearing to have signed it` FALSE TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 347(4) the certificate is proof of the annual percentage rate of interest without proof of the signature or official character of the person appearing to have signed it` TRUE FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 347(4) the certificate is proof of the annual percentage rate of interest without proof of the signature or official character of the person appearing to have signed it` TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 347(4) the certificate is proof of the annual percentage rate of interest without proof of the signature or official character of the person appearing to have signed it` TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- (5): reasonable notice of the intention, a copy of the certificate
#ASSERT `s 347(5) the certificate may be received in evidence` TRUE TRUE EQUALS NOTHING
#ASSERT `s 347(5) the certificate may be received in evidence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 347(5) the certificate may be received in evidence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 347(5) the certificate may be received in evidence` FALSE FALSE EQUALS JUST FALSE
-- (6): a certificate is produced against the accused, the court has given leave
#ASSERT `s 347(6) the accused or defendant may require the attendance of the actuary for the purposes of cross-examination` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 347(6) the accused or defendant may require the attendance of the actuary for the purposes of cross-examination` TRUE FALSE EQUALS NOTHING
#ASSERT `s 347(6) the accused or defendant may require the attendance of the actuary for the purposes of cross-examination` FALSE TRUE EQUALS NOTHING
#ASSERT `s 347(7) as the text shows it` EQUALS "(7) [Repealed, 2024, c. 17, s. 336]"
-- (8): the Tax Rebate Discounting Act applies
#ASSERT `s 347(8) section 347 applies to the transaction` TRUE EQUALS JUST FALSE
#ASSERT `s 347(8) section 347 applies to the transaction` FALSE EQUALS NOTHING

§ `s 347.01 non-application`
-- provided for by regulation: the agreement or arrangement, the offer or advertisement
#ASSERT `s 347.01(1) section 347 applies to the agreement, arrangement, offer or advertisement` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 347.01(1) section 347 applies to the agreement, arrangement, offer or advertisement` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 347.01(1) section 347 applies to the agreement, arrangement, offer or advertisement` FALSE FALSE EQUALS NOTHING
#ASSERT `s 347.01(2) section 347 applies to the offer or advertisement of an offer` TRUE EQUALS JUST FALSE
#ASSERT `s 347.01(2) section 347 applies to the offer or advertisement of an offer` FALSE EQUALS NOTHING

§ `s 347.1 payday loans`
-- (1) interest has the same meaning as in s 347(2)
#ASSERT `s 347.1(1) interest` 1000 200 50 25 5 100 FALSE 40 EQUALS 620
#ASSERT `s 347.1(1) interest` 1000 200 50 25 5 100 TRUE 40 EQUALS 580
-- payday loan: an advancement of money, in exchange for a post-dated cheque etc., not for a guarantee etc., not through a margin loan etc.
#ASSERT `s 347.1(1) the advancement of money is a payday loan` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 347.1(1) the advancement of money is a payday loan` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 347.1(1) the advancement of money is a payday loan` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 347.1(1) the advancement of money is a payday loan` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 347.1(1) the advancement of money is a payday loan` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- (2): a financial institution (Bank Act), payday loan activity, amount of money, term in days, cost within the limit fixed by regulation, licensed, province designated
#ASSERT `s 347.1(2) section 347 and section 2 of the Interest Act apply to the person` FALSE TRUE 1500 62 TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 347.1(2) section 347 and section 2 of the Interest Act apply to the person` FALSE TRUE 1000 30 TRUE TRUE TRUE EQUALS JUST FALSE
-- one dollar over $1,500 (the text says "$1,500 or less"); one day over 62 days
#ASSERT `s 347.1(2) section 347 and section 2 of the Interest Act apply to the person` FALSE TRUE 1500.01 62 TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 347.1(2) section 347 and section 2 of the Interest Act apply to the person` FALSE TRUE 1500 63 TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 347.1(2) section 347 and section 2 of the Interest Act apply to the person` TRUE TRUE 1000 30 TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 347.1(2) section 347 and section 2 of the Interest Act apply to the person` FALSE FALSE 1000 30 TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 347.1(2) section 347 and section 2 of the Interest Act apply to the person` FALSE TRUE 1000 30 FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 347.1(2) section 347 and section 2 of the Interest Act apply to the person` FALSE TRUE 1000 30 TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 347.1(2) section 347 and section 2 of the Interest Act apply to the person` FALSE TRUE 1000 30 TRUE TRUE FALSE EQUALS NOTHING
-- (2.2): section 347 did not apply under (2) just before the regulation, the cost did not exceed the earlier limit
#ASSERT `s 347.1(2.2) section 347 applies to the person` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 347.1(2.2) section 347 applies to the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 347.1(2.2) section 347 applies to the person` FALSE TRUE EQUALS NOTHING
-- (3): requested, protective measures, limits on the total cost of borrowing
#ASSERT `s 347.1(3) the Governor in Council shall designate the province` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 347.1(3) the Governor in Council shall designate the province` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 347.1(3) the Governor in Council shall designate the province` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 347.1(3) the Governor in Council shall designate the province` TRUE TRUE FALSE EQUALS JUST FALSE
-- (4): requested to revoke, or the measures are no longer in force
#ASSERT `s 347.1(4) the Governor in Council shall revoke the designation` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 347.1(4) the Governor in Council shall revoke the designation` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 347.1(4) the Governor in Council shall revoke the designation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 347.1(4) the Governor in Council shall revoke the designation` FALSE FALSE EQUALS JUST FALSE
