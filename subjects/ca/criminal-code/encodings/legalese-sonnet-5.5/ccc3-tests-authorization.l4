IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc3-authorization`

-- ccc3-tests-authorization.l4 -- tests of sections 83.031 to 83.0392. Expected values are hand-written from the text beside each assertion.
-- Dates: `Date day month year`. A day count is added with PLUS; the expected dates below were counted by hand on the calendar (2026 is not a leap year; 2028 is).

§ `Tests of sections 83.031 to 83.0392`

-- ---- 83.031(1): in sections 83.032 to 83.0392, the Public Safety Minister is the Minister of Public Safety and Emergency Preparedness.
#ASSERT `s 83.031(1) Public Safety Minister` (`Provision of the Code` OF 83.032, "") TRUE EQUALS JUST TRUE   -- the first section in the range
#ASSERT `s 83.031(1) Public Safety Minister` (`Provision of the Code` OF 83.0392, "(1)") TRUE EQUALS JUST TRUE   -- the last section in the range
#ASSERT `s 83.031(1) Public Safety Minister` (`Provision of the Code` OF 83.0391, "") FALSE EQUALS JUST FALSE   -- "means": another person is not that Minister
#ASSERT `s 83.031(1) Public Safety Minister` (`Provision of the Code` OF 83.031, "(2)") TRUE EQUALS NOTHING   -- 83.031 is just before the range
#ASSERT `s 83.031(1) Public Safety Minister` (`Provision of the Code` OF 83.04, "") TRUE EQUALS NOTHING   -- 83.04 is just after it

-- ---- 83.031(2): any Minister referred to in 83.032 to 83.0392 may designate a person.
#ASSERT `s 83.031(2) the Minister may designate a person to exercise a power, or perform a duty or function` (`Provision of the Code` OF 83.037, "") TRUE EQUALS JUST TRUE
#ASSERT `s 83.031(2) the Minister may designate a person to exercise a power, or perform a duty or function` (`Provision of the Code` OF 83.037, "") FALSE EQUALS NOTHING   -- not a power conferred on a Minister
#ASSERT `s 83.031(2) the Minister may designate a person to exercise a power, or perform a duty or function` (`Provision of the Code` OF 83.09, "(1)") TRUE EQUALS NOTHING   -- 83.09 is outside "those sections"

-- ---- 83.032(1) (lines 1308-1315). Fixture: application made, area controlled, otherwise prohibited under 83.03(2), purpose.
`s 83.032(1) the health purpose` MEANS `s 83.032(1)(a) providing or supporting the provision of health services`
`s 83.032(1) the federal operations purpose` MEANS `s 83.032(1)(f) supporting operations of a federal minister or a department or agency of the Government of Canada conducted for another purpose`
`s 83.032(1) no purpose of the list` MEANS `s 83.032(1) a purpose that is none of those`
#ASSERT `s 83.032(1) the Public Safety Minister may authorize the activity` (`s 83.032(1) facts` OF TRUE, TRUE, TRUE, `s 83.032(1) the health purpose`) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 83.032(1) the Public Safety Minister may authorize the activity` (`s 83.032(1) facts` OF TRUE, TRUE, TRUE, `s 83.032(1) the federal operations purpose`) (JUST TRUE) EQUALS JUST TRUE   -- (f)
#ASSERT `s 83.032(1) the Public Safety Minister may authorize the activity` (`s 83.032(1) facts` OF FALSE, TRUE, TRUE, `s 83.032(1) the health purpose`) (JUST TRUE) EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `#ASSERT `s 83.032(1) the Public Safety Minister may authorize the activity` (`s 83.032(1) facts` OF FALSE, TRUE, TRUE, `s 83.032(1) the health purpose`) (JUST TRUE) EQUALS NOTHING`; "On application" is a group (i) gate of a "may" function, answered JUST FALSE as ruling (b) of 2026-11-05 says and listed under fork F-ccc3-11
#ASSERT `s 83.032(1) the Public Safety Minister may authorize the activity` (`s 83.032(1) facts` OF FALSE, FALSE, FALSE, `s 83.032(1) no purpose of the list`) (JUST FALSE) EQUALS JUST FALSE   -- no application, whatever else fails: the application gate comes first (fork F-ccc3-11)
#ASSERT `s 83.032(1) the Public Safety Minister may authorize the activity` (`s 83.032(1) facts` OF TRUE, FALSE, TRUE, `s 83.032(1) the health purpose`) (JUST TRUE) EQUALS NOTHING   -- the area is not controlled by a terrorist group
#ASSERT `s 83.032(1) the Public Safety Minister may authorize the activity` (`s 83.032(1) facts` OF TRUE, TRUE, FALSE, `s 83.032(1) the health purpose`) (JUST TRUE) EQUALS NOTHING   -- not otherwise prohibited under 83.03(2)
#ASSERT `s 83.032(1) the Public Safety Minister may authorize the activity` (`s 83.032(1) facts` OF TRUE, TRUE, TRUE, `s 83.032(1) no purpose of the list`) (JUST TRUE) EQUALS NOTHING   -- not a purpose "from among the following"
#ASSERT `s 83.032(1) the Public Safety Minister may authorize the activity` (`s 83.032(1) facts` OF TRUE, TRUE, TRUE, `s 83.032(1) the health purpose`) (JUST FALSE) EQUALS NOTHING   -- not an eligible person
#ASSERT `s 83.032(1) the Public Safety Minister may authorize the activity` (`s 83.032(1) facts` OF TRUE, TRUE, TRUE, `s 83.032(1) the health purpose`) NOTHING EQUALS NOTHING

-- ---- 83.032(2): a terrorist group controls an area if it exerts sufficient influence such that the activity could reasonably be expected to result in the group using or benefiting.
#ASSERT `s 83.032(2) the terrorist group controls the geographic area` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.032(2) the terrorist group controls the geographic area` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE   -- no reasonable expectation of the group using or benefiting
#ASSERT `s 83.032(2) the terrorist group controls the geographic area` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE   -- no sufficient influence
#ASSERT `s 83.032(2) the terrorist group controls the geographic area` (JUST FALSE) TRUE TRUE EQUALS NOTHING   -- not a terrorist group: the subsection speaks of "a terrorist group"
#ASSERT `s 83.032(2) the terrorist group controls the geographic area` NOTHING TRUE TRUE EQUALS NOTHING

-- ---- 83.032(2.1), (3), (4).
#ASSERT `s 83.032(2.1) the Public Safety Minister must provide information in writing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.032(2.1) the Public Safety Minister must provide information in writing` FALSE TRUE EQUALS JUST FALSE   -- no request: "at the request of"
#ASSERT `s 83.032(2.1) the Public Safety Minister must provide information in writing` TRUE FALSE EQUALS JUST FALSE   -- a request about something else
#ASSERT `s 83.032(3) the Public Safety Minister is barred from authorizing the grant or contribution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.032(3) the Public Safety Minister is barred from authorizing the grant or contribution` TRUE FALSE EQUALS NOTHING   -- a grant or contribution, but not for (1)(f) operations
#ASSERT `s 83.032(3) the Public Safety Minister is barred from authorizing the grant or contribution` FALSE TRUE EQUALS NOTHING
#ASSERT `s 83.032(4) the person is eligible to be granted an authorization` TRUE (JUST FALSE) EQUALS JUST TRUE   -- in Canada
#ASSERT `s 83.032(4) the person is eligible to be granted an authorization` FALSE (JUST TRUE) EQUALS JUST TRUE   -- a Canadian outside Canada
#ASSERT `s 83.032(4) the person is eligible to be granted an authorization` FALSE (JUST FALSE) EQUALS JUST FALSE   -- outside Canada and not a Canadian
#ASSERT `s 83.032(4) the person is eligible to be granted an authorization` FALSE NOTHING EQUALS NOTHING

-- ---- 83.032(5): the referral the application needs (lines 1324-1328). Fixture: (1)(a) to (f) purposes, referred by MCI, referred by MFA.
GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN, d IS A BOOLEAN, e IS A BOOLEAN, f IS A BOOLEAN, mci IS A BOOLEAN, mfa IS A BOOLEAN
GIVETH A `s 83.032(5) application`
`s 83.032(5) test application` MEANS `s 83.032(5) application` OF a, b, c, d, e, f, mci, mfa

#ASSERT `s 83.032(5) the Public Safety Minister may consider the application` (`s 83.032(5) test application` FALSE FALSE FALSE FALSE TRUE FALSE TRUE FALSE) EQUALS JUST TRUE   -- (a): only (e), referred by Citizenship and Immigration
#ASSERT `s 83.032(5) the Public Safety Minister may consider the application` (`s 83.032(5) test application` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE) EQUALS JUST FALSE   -- only (e), referred only by Foreign Affairs
#ASSERT `s 83.032(5) the Public Safety Minister may consider the application` (`s 83.032(5) test application` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE   -- (b): not (e), referred by Foreign Affairs
#ASSERT `s 83.032(5) the Public Safety Minister may consider the application` (`s 83.032(5) test application` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE   -- (b): two purposes, neither is (e)
#ASSERT `s 83.032(5) the Public Safety Minister may consider the application` (`s 83.032(5) test application` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE   -- not (e), referred only by Citizenship and Immigration
#ASSERT `s 83.032(5) the Public Safety Minister may consider the application` (`s 83.032(5) test application` TRUE FALSE FALSE FALSE TRUE FALSE TRUE TRUE) EQUALS JUST TRUE   -- (c): (a) and (e), referred by both
#ASSERT `s 83.032(5) the Public Safety Minister may consider the application` (`s 83.032(5) test application` TRUE FALSE FALSE FALSE TRUE FALSE TRUE FALSE) EQUALS JUST FALSE   -- (c): referred only by Citizenship and Immigration
#ASSERT `s 83.032(5) the Public Safety Minister may consider the application` (`s 83.032(5) test application` TRUE FALSE FALSE FALSE TRUE FALSE FALSE TRUE) EQUALS JUST FALSE   -- (c): referred only by Foreign Affairs
#ASSERT `s 83.032(5) the Public Safety Minister may consider the application` (`s 83.032(5) test application` FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE) EQUALS JUST FALSE   -- in respect of no purpose at all: none of (a), (b), (c)

-- ---- 83.032(6): all of (a) to (e).
#ASSERT `s 83.032(6) the Minister or Ministers may refer the application` (`s 83.032(6) conditions` OF TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 83.032(6) the Minister or Ministers may refer the application` (`s 83.032(6) conditions` OF FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `s 83.032(6) the Minister or Ministers may refer the application` (`s 83.032(6) conditions` OF TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `s 83.032(6) the Minister or Ministers may refer the application` (`s 83.032(6) conditions` OF TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `s 83.032(6) the Minister or Ministers may refer the application` (`s 83.032(6) conditions` OF TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS NOTHING
#ASSERT `s 83.032(6) the Minister or Ministers may refer the application` (`s 83.032(6) conditions` OF TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING

-- ---- 83.032(7): the request is made on 1 March 2026; the 60th day after it is 30 April 2026 (March: 30 more days to 31 March, then 30 days of April).
#ASSERT `s 83.032(7) the application may be deemed to be withdrawn` (Date 1 3 2026) NOTHING (Date 1 5 2026) EQUALS JUST TRUE   -- nothing provided; asked on the 61st day
#ASSERT `s 83.032(7) the application may be deemed to be withdrawn` (Date 1 3 2026) NOTHING (Date 30 4 2026) EQUALS NOTHING   -- asked on the 60th day: the period has not run out
#ASSERT `s 83.032(7) the application may be deemed to be withdrawn` (Date 1 3 2026) (JUST (Date 30 4 2026)) (Date 1 5 2026) EQUALS NOTHING   -- provided on the 60th day: within the period
#ASSERT `s 83.032(7) the application may be deemed to be withdrawn` (Date 1 3 2026) (JUST (Date 1 5 2026)) (Date 2 5 2026) EQUALS JUST TRUE   -- provided on the 61st day: too late
#ASSERT `s 83.032(7) the application may be deemed to be withdrawn` (Date 1 3 2026) NOTHING (Date 1 4 2026) EQUALS NOTHING   -- well within the 60 days

-- ---- 83.032(8): the referral sets out the assessment.
#ASSERT `s 83.032(8) the referral sets out the assessment` TRUE EQUALS JUST TRUE
#ASSERT `s 83.032(8) the referral sets out the assessment` FALSE EQUALS JUST FALSE

-- ---- 83.032(9): (a) AND (b), taking into account (i), (ii) and (iii).
#ASSERT `s 83.032(9) the Public Safety Minister may grant the authorization` (`s 83.032(9) conditions` OF TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 83.032(9) the Public Safety Minister may grant the authorization` (`s 83.032(9) conditions` OF FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING   -- (a): there is a practical way
#ASSERT `s 83.032(9) the Public Safety Minister may grant the authorization` (`s 83.032(9) conditions` OF TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS NOTHING   -- (b): the benefits do not outweigh the risk
#ASSERT `s 83.032(9) the Public Safety Minister may grant the authorization` (`s 83.032(9) conditions` OF TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS NOTHING   -- the referral was not taken into account
#ASSERT `s 83.032(9) the Public Safety Minister may grant the authorization` (`s 83.032(9) conditions` OF TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS NOTHING   -- the security review was not taken into account
#ASSERT `s 83.032(9) the Public Safety Minister may grant the authorization` (`s 83.032(9) conditions` OF TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING   -- the mitigation measures were not taken into account

-- ---- 83.032(10).
#ASSERT `s 83.032(10) the factor may be considered in the security review` `s 83.032(10)(a) whether the applicant or any person to be involved has any links to a terrorist group` EQUALS JUST TRUE
#ASSERT `s 83.032(10) the factor may be considered in the security review` `s 83.032(10)(b) the likelihood that the applicant or any person to be involved will be acting for the benefit of, at the direction of or in association with a terrorist group` EQUALS JUST TRUE
#ASSERT `s 83.032(10) the factor may be considered in the security review` `s 83.032(10)(c) whether the applicant or any person to be involved is being or has been investigated for, or has ever been charged with, a terrorism offence` EQUALS JUST TRUE
#ASSERT `s 83.032(10) the factor may be considered in the security review` `s 83.032(10) another factor` EQUALS NOTHING   -- "among other factors": the list is open
#ASSERT `s 83.032(10) the security review assesses the impact on the financing of terrorism` TRUE EQUALS JUST TRUE
#ASSERT `s 83.032(10) the security review assesses the impact on the financing of terrorism` FALSE EQUALS JUST FALSE

-- ---- 83.032(11), (12), (13).
#ASSERT `s 83.032(11) the Public Safety Minister may request additional information` TRUE EQUALS JUST TRUE
#ASSERT `s 83.032(11) the Public Safety Minister may request additional information` FALSE EQUALS NOTHING
#ASSERT `s 83.032(11) the Public Safety Minister may deem the application to be withdrawn` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.032(11) the Public Safety Minister may deem the application to be withdrawn` TRUE FALSE EQUALS NOTHING   -- failed, but with reasonable excuse
#ASSERT `s 83.032(11) the Public Safety Minister may deem the application to be withdrawn` FALSE TRUE EQUALS NOTHING   -- did not fail within the specified period
#ASSERT `s 83.032(12) the Public Safety Minister may make the authorization subject to the terms and conditions` TRUE EQUALS JUST TRUE
#ASSERT `s 83.032(12) the Public Safety Minister may make the authorization subject to the terms and conditions` FALSE EQUALS NOTHING
#ASSERT `s 83.032(13) the authorization applies to the person` TRUE FALSE EQUALS JUST TRUE   -- the person it is granted to
#ASSERT `s 83.032(13) the authorization applies to the person` FALSE TRUE EQUALS JUST TRUE   -- another person involved
#ASSERT `s 83.032(13) the authorization applies to the person` FALSE FALSE EQUALS NOTHING

-- ---- 83.032(14): "not more than five years". Length of time: years, months, days, less a day.
#ASSERT `s 83.032(14) the specified period is not more than five years` `five years` EQUALS JUST TRUE   -- exactly five years
#ASSERT `s 83.032(14) the specified period is not more than five years` (`Length of time` OF 4, 11, 0, FALSE) EQUALS JUST TRUE
#ASSERT `s 83.032(14) the specified period is not more than five years` (`Length of time` OF 5, 0, 1, FALSE) EQUALS JUST FALSE   -- five years and a day
#ASSERT `s 83.032(14) the specified period is not more than five years` (`Length of time` OF 5, 1, 0, FALSE) EQUALS JUST FALSE
#ASSERT `s 83.032(14) the specified period is not more than five years` `ten years` EQUALS JUST FALSE
-- An authorization taking effect on 1 January 2026 for two years is valid through 31 December 2027.
#ASSERT `s 83.032(14) the authorization is valid on the day` (Date 1 1 2026) `two years` (Date 31 12 2027) EQUALS JUST TRUE   -- the last day
#ASSERT `s 83.032(14) the authorization is valid on the day` (Date 1 1 2026) `two years` (Date 1 1 2028) EQUALS JUST FALSE   -- the day after
#ASSERT `s 83.032(14) the authorization is valid on the day` (Date 1 1 2026) `two years` (Date 1 1 2026) EQUALS JUST TRUE   -- the first day
#ASSERT `s 83.032(14) the authorization is valid on the day` (Date 1 1 2026) `two years` (Date 31 12 2025) EQUALS JUST FALSE   -- the day before
#ASSERT `s 83.032(14) the authorization is valid on the day` (Date 1 1 2026) `ten years` (Date 1 1 2027) EQUALS JUST FALSE   -- a period over five years is not a valid period

-- ---- 83.032(15).
#ASSERT `s 83.032(15) the Public Safety Minister may authorize the activity benefiting a listed entity under a Security Council sanctions regime` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- not a Security Council sanctions case
#ASSERT `s 83.032(15) the Public Safety Minister may authorize the activity benefiting a listed entity under a Security Council sanctions regime` TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 83.032(15) the Public Safety Minister may authorize the activity benefiting a listed entity under a Security Council sanctions regime` TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b)
#ASSERT `s 83.032(15) the Public Safety Minister may authorize the activity benefiting a listed entity under a Security Council sanctions regime` TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- (c)
#ASSERT `s 83.032(15) the Public Safety Minister may authorize the activity benefiting a listed entity under a Security Council sanctions regime` TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- "only if" the Minister of Foreign Affairs confirms: none is confirmed

-- ---- 83.032(16).
#ASSERT `s 83.032(16) the Statutory Instruments Act does not apply to the instrument` TRUE EQUALS JUST TRUE
#ASSERT `s 83.032(16) the Statutory Instruments Act does not apply to the instrument` FALSE EQUALS NOTHING

-- ---- 83.033(1), (2), (3).
#ASSERT `s 83.033(1) the notice of refusal is given within a reasonable time` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.033(1) the notice of refusal is given within a reasonable time` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 83.033(1) the notice of refusal is given within a reasonable time` TRUE FALSE EQUALS JUST FALSE   -- given, but not within a reasonable time
-- The notice is given on 1 June 2026: the bar lasts to the end of the 30th day after it, 1 July 2026.
#ASSERT `s 83.033(2) the applicant is barred from making a new application` TRUE (Date 1 6 2026) (Date 1 6 2026) FALSE EQUALS JUST TRUE   -- the same day
#ASSERT `s 83.033(2) the applicant is barred from making a new application` TRUE (Date 1 6 2026) (Date 1 7 2026) FALSE EQUALS JUST TRUE   -- the 30th day: still barred
#ASSERT `s 83.033(2) the applicant is barred from making a new application` TRUE (Date 1 6 2026) (Date 2 7 2026) FALSE EQUALS JUST FALSE   -- the 31st day: the bar has ended
#ASSERT `s 83.033(2) the applicant is barred from making a new application` TRUE (Date 1 6 2026) (Date 15 6 2026) TRUE EQUALS JUST FALSE   -- "unless" the Minister is satisfied of a material change
#ASSERT `s 83.033(2) the applicant is barred from making a new application` FALSE (Date 1 6 2026) (Date 15 6 2026) FALSE EQUALS NOTHING   -- a new application about a different activity
#ASSERT `s 83.033(3) the Public Safety Minister may consider the new application without a referral` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.033(3) the Public Safety Minister may consider the new application without a referral` TRUE FALSE EQUALS NOTHING
#ASSERT `s 83.033(3) the Public Safety Minister may consider the new application without a referral` FALSE TRUE EQUALS NOTHING

-- ---- 83.034: validity 1 January 2026 to 31 December 2030.
#ASSERT `s 83.034 the Public Safety Minister may conduct an additional security review` (Date 31 12 2030) (Date 1 1 2026) (Date 31 12 2030) TRUE EQUALS JUST TRUE   -- the last day
#ASSERT `s 83.034 the Public Safety Minister may conduct an additional security review` (Date 1 1 2026) (Date 1 1 2026) (Date 31 12 2030) TRUE EQUALS JUST TRUE   -- the first day
#ASSERT `s 83.034 the Public Safety Minister may conduct an additional security review` (Date 1 1 2031) (Date 1 1 2026) (Date 31 12 2030) TRUE EQUALS JUST FALSE   -- the day after
#ASSERT `s 83.034 the Public Safety Minister may conduct an additional security review` (Date 31 12 2025) (Date 1 1 2026) (Date 31 12 2030) TRUE EQUALS JUST FALSE   -- the day before
#ASSERT `s 83.034 the Public Safety Minister may conduct an additional security review` (Date 1 6 2028) (Date 1 1 2026) (Date 31 12 2030) FALSE EQUALS NOTHING   -- a person the authorization does not apply to
#ASSERT `s 83.034 the request for additional information may be made` TRUE EQUALS JUST TRUE
#ASSERT `s 83.034 the request for additional information may be made` FALSE EQUALS JUST FALSE   -- "must relate only to"

-- ---- 83.035(1): the last day on which the authorization is valid is 31 December 2030. Fixture order: application made, within the regulations' period, day of application, last day, period sought.
#ASSERT `s 83.035(1) the Public Safety Minister may renew the authorization` TRUE TRUE (Date 31 12 2030) (Date 31 12 2030) `five years` EQUALS JUST TRUE   -- made on the last day: "before the authorization expires" (fork F-ccc3-7)
#ASSERT `s 83.035(1) the Public Safety Minister may renew the authorization` TRUE TRUE (Date 1 1 2031) (Date 31 12 2030) `five years` EQUALS JUST FALSE   -- made the day after
#ASSERT `s 83.035(1) the Public Safety Minister may renew the authorization` FALSE TRUE (Date 1 1 2030) (Date 31 12 2030) `five years` EQUALS JUST FALSE   -- no application
#ASSERT `s 83.035(1) the Public Safety Minister may renew the authorization` TRUE FALSE (Date 1 1 2030) (Date 31 12 2030) `five years` EQUALS JUST FALSE   -- outside any period the regulations set out
#ASSERT `s 83.035(1) the Public Safety Minister may renew the authorization` TRUE TRUE (Date 1 1 2030) (Date 31 12 2030) (`Length of time` OF 5, 0, 1, FALSE) EQUALS JUST FALSE   -- over five years
#ASSERT `s 83.035(1) the Public Safety Minister may renew the authorization` TRUE TRUE (Date 1 1 2030) (Date 31 12 2030) `two years` EQUALS JUST TRUE
#ASSERT `s 83.035(2) the Public Safety Minister may renew the authorization on a late application` (Date 1 1 2031) (Date 31 12 2030) TRUE EQUALS JUST TRUE
#ASSERT `s 83.035(2) the Public Safety Minister may renew the authorization on a late application` (Date 1 1 2031) (Date 31 12 2030) FALSE EQUALS NOTHING   -- late, but no exceptional circumstances in the Minister's opinion
#ASSERT `s 83.035(2) the Public Safety Minister may renew the authorization on a late application` (Date 31 12 2030) (Date 31 12 2030) TRUE EQUALS NOTHING   -- not late: (1) governs

-- ---- 83.036 and 83.037.
#ASSERT `s 83.036(1) the Public Safety Minister may amend the authorization` TRUE EQUALS JUST TRUE
#ASSERT `s 83.036(1) the Public Safety Minister may amend the authorization` FALSE EQUALS NOTHING
#ASSERT `s 83.036(2) the Public Safety Minister is not permitted to make the amendment` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 83.036(2) the Public Safety Minister is not permitted to make the amendment` FALSE TRUE FALSE EQUALS JUST TRUE   -- replaces a purpose
#ASSERT `s 83.036(2) the Public Safety Minister is not permitted to make the amendment` FALSE FALSE TRUE EQUALS JUST TRUE   -- adds a purpose
#ASSERT `s 83.036(2) the Public Safety Minister is not permitted to make the amendment` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 83.036(3) the person to whom the authorization is granted must provide the information` TRUE EQUALS JUST TRUE
#ASSERT `s 83.036(3) the person to whom the authorization is granted must provide the information` FALSE EQUALS NOTHING
#ASSERT `s 83.037 the Public Safety Minister may suspend or revoke the authorization or restrict its scope` TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 83.037 the Public Safety Minister may suspend or revoke the authorization or restrict its scope` TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b)
#ASSERT `s 83.037 the Public Safety Minister may suspend or revoke the authorization or restrict its scope` TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- (c)
#ASSERT `s 83.037 the Public Safety Minister may suspend or revoke the authorization or restrict its scope` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 83.037 the Public Safety Minister may suspend or revoke the authorization or restrict its scope` FALSE TRUE FALSE FALSE EQUALS NOTHING   -- not an authorization granted under 83.032

-- ---- 83.038 and 83.039.
#ASSERT `s 83.038(1) the entity may assist the Public Safety Minister` `s 83.038(1)(a) the Canadian Security Intelligence Service` EQUALS JUST TRUE
#ASSERT `s 83.038(1) the entity may assist the Public Safety Minister` `s 83.038(1)(e) the Canadian Armed Forces` EQUALS JUST TRUE
#ASSERT `s 83.038(1) the entity may assist the Public Safety Minister` `s 83.038(1)(i) the Department of Citizenship and Immigration` EQUALS JUST TRUE
#ASSERT `s 83.038(1) the entity may assist the Public Safety Minister` `s 83.038(1)(j) another entity prescribed by regulation` EQUALS JUST TRUE
#ASSERT `s 83.038(1) the entity may assist the Public Safety Minister` `s 83.038(1) an entity that is neither named in paragraphs (a) to (i) nor prescribed by regulation` EQUALS NOTHING
#ASSERT `s 83.038(2) the use of the information is permitted` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.038(2) the use of the information is permitted` TRUE FALSE EQUALS JUST FALSE   -- "must only be used"
#ASSERT `s 83.038(2) the use of the information is permitted` FALSE TRUE EQUALS NOTHING   -- information not collected or disclosed under (1)
#ASSERT `s 83.038(3) the Public Safety Minister has taken reasonable steps` TRUE EQUALS JUST TRUE
#ASSERT `s 83.038(3) the Public Safety Minister has taken reasonable steps` FALSE EQUALS JUST FALSE
#ASSERT `s 83.039(1) the rules set out in subsection (2) apply to the proceedings` (`Provision of the Code` OF 83.032, "") TRUE EQUALS JUST TRUE
#ASSERT `s 83.039(1) the rules set out in subsection (2) apply to the proceedings` (`Provision of the Code` OF 83.038, "(1)") TRUE EQUALS JUST TRUE   -- the last section named: "under sections 83.032 to 83.038"
#ASSERT `s 83.039(1) the rules set out in subsection (2) apply to the proceedings` (`Provision of the Code` OF 83.039, "(1)") TRUE EQUALS NOTHING   -- 83.039 itself is outside the range
#ASSERT `s 83.039(1) the rules set out in subsection (2) apply to the proceedings` (`Provision of the Code` OF 83.031, "") TRUE EQUALS NOTHING
#ASSERT `s 83.039(1) the rules set out in subsection (2) apply to the proceedings` (`Provision of the Code` OF 83.034, "") FALSE EQUALS NOTHING
#ASSERT `s 83.039(2)(d) the judge must provide the applicant and the relevant Minister with an opportunity to be heard` TRUE EQUALS JUST TRUE
#ASSERT `s 83.039(2)(d) the judge must provide the applicant and the relevant Minister with an opportunity to be heard` FALSE EQUALS JUST FALSE
#ASSERT `s 83.039(2)(f) the judge must not base the decision on the evidence and must return it` TRUE FALSE EQUALS JUST TRUE   -- not relevant
#ASSERT `s 83.039(2)(f) the judge must not base the decision on the evidence and must return it` FALSE TRUE EQUALS JUST TRUE   -- withdrawn
#ASSERT `s 83.039(2)(f) the judge must not base the decision on the evidence and must return it` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 83.039(2)(g) the judge must ensure the confidentiality of the evidence the Minister withdraws` TRUE EQUALS JUST TRUE
#ASSERT `s 83.039(2)(g) the judge must ensure the confidentiality of the evidence the Minister withdraws` FALSE EQUALS NOTHING
#ASSERT `s 83.039(2.1) sections 38.2 to 38.45 of the Canada Evidence Act apply to the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 83.039(2.1) sections 38.2 to 38.45 of the Canada Evidence Act apply to the proceedings` FALSE EQUALS NOTHING
#ASSERT `s 83.039(3) subsection (2) applies to the appeal` TRUE EQUALS JUST TRUE
#ASSERT `s 83.039(3) subsection (2) applies to the appeal` FALSE EQUALS NOTHING
#ASSERT `s 83.039(4) judge` TRUE FALSE FALSE EQUALS JUST TRUE   -- the Chief Justice
#ASSERT `s 83.039(4) judge` FALSE TRUE TRUE EQUALS JUST TRUE   -- a judge of the Court designated by the Chief Justice
#ASSERT `s 83.039(4) judge` FALSE TRUE FALSE EQUALS JUST FALSE   -- a judge of the Court not designated
#ASSERT `s 83.039(4) judge` FALSE FALSE TRUE EQUALS JUST FALSE   -- designated, but not a judge of that Court
#ASSERT `s 83.039(4) judge` FALSE FALSE FALSE EQUALS JUST FALSE

-- ---- 83.0392. 1 January 2026 + 90 days = 1 April 2026 (31 + 28 + 31 = 90); 1 January 2028 + 90 days = 31 March 2028 (2028 is a leap year: 31 + 29 + 30 = 90).
#ASSERT `s 83.0392(1) the last day for laying the report` 2026 EQUALS Date 1 4 2026
#ASSERT `s 83.0392(1) the last day for laying the report` 2028 EQUALS Date 31 3 2028
#ASSERT `s 83.0392(1) the report is laid within the time` 2026 (Date 1 4 2026) EQUALS JUST TRUE   -- the 90th day
#ASSERT `s 83.0392(1) the report is laid within the time` 2026 (Date 2 4 2026) EQUALS JUST FALSE   -- the 91st day
#ASSERT `s 83.0392(1) the report is laid within the time` 2026 (Date 1 1 2026) EQUALS JUST TRUE
#ASSERT `s 83.0392(1) the report is laid within the time` 2026 (Date 31 12 2025) EQUALS NOTHING   -- before 1 January: the text is silent
#ASSERT `s 83.0392(1) the report is laid within the time` 2028 (Date 31 3 2028) EQUALS JUST TRUE
#ASSERT `s 83.0392(1) the report is laid within the time` 2028 (Date 1 4 2028) EQUALS JUST FALSE
#ASSERT `s 83.0392(1.1) the report sets out the numbers` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.0392(1.1) the report sets out the numbers` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 83.0392(1.1) the report sets out the numbers` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 83.0392(1.1) the report sets out the numbers` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 83.0392(1.2) the Public Safety Minister must forward the unredacted report` TRUE EQUALS JUST TRUE
#ASSERT `s 83.0392(1.2) the Public Safety Minister must forward the unredacted report` FALSE EQUALS JUST FALSE   -- no redactions: no duty
-- In force on 1 July 2024: the first anniversary is 1 July 2025; 180 days later is 28 December 2025 (31+31+30+31+30 = 153 to 1 December, +27); the next report: 1 July 2030 + 180 days = 28 December 2030.
#ASSERT `s 83.0392(2) the last day for the comprehensive review` (Date 1 7 2024) EQUALS Date 1 7 2025
#ASSERT `s 83.0392(2) the last day for the nth report` (Date 1 7 2024) 0 EQUALS Date 28 12 2025
#ASSERT `s 83.0392(2) the last day for the nth report` (Date 1 7 2024) 1 EQUALS Date 28 12 2030
#ASSERT `s 83.0392(3) the report must include a plan and a timeline` FALSE TRUE TRUE EQUALS JUST FALSE   -- no deficiencies identified: no duty
#ASSERT `s 83.0392(3) the report must include a plan and a timeline` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.0392(3) the report must include a plan and a timeline` TRUE FALSE TRUE EQUALS JUST FALSE   -- no plan
#ASSERT `s 83.0392(3) the report must include a plan and a timeline` TRUE TRUE FALSE EQUALS JUST FALSE   -- no timeline
