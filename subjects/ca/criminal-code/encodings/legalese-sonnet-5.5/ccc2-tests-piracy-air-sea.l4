IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc2-piracy-air-sea`

-- ccc2-tests-piracy-air-sea.l4 -- tests for ccc2-piracy-air-sea.l4 (ss 74 to 78.1). Expected values are written beside each assertion from the text
-- of the provision, before the run.

§ `Tests -- sections 74 and 75, piracy and piratical acts (lines 1134-1144)`

#ASSERT `s 74(1) the person commits piracy` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 74(1) the person commits piracy` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 74(1) the person commits piracy` NOTHING EQUALS NOTHING   -- the law of nations is outside the sources
#ASSERT `s 74(2) the person who commits piracy is guilty` (JUST TRUE) EQUALS JUST TRUE   -- while in or out of Canada: no place is asked
#ASSERT `s 74(2) the person who commits piracy is guilty` NOTHING EQUALS NOTHING
#ASSERT `s 74(2) the class of the offence of piracy` EQUALS `an indictable offence`
#ASSERT `s 74(2) the punishment for piracy` EQUALS LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
--                                              act                                                                                                                                              Canadian ship  without lawful authority
#ASSERT `s 75 the person commits a piratical act` `s 75(a) steals a Canadian ship` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 75 the person commits a piratical act` `s 75(a) steals a Canadian ship` FALSE FALSE EQUALS NOTHING   -- not a Canadian ship
#ASSERT `s 75 the person commits a piratical act` `s 75(b) steals anything that is part of the cargo, supplies or fittings in a Canadian ship` TRUE FALSE EQUALS JUST TRUE   -- stealing needs no "lawful authority" element
#ASSERT `s 75 the person commits a piratical act` `s 75(b) without lawful authority throws overboard, damages or destroys anything that is part of the cargo, supplies or fittings in a Canadian ship` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 75 the person commits a piratical act` `s 75(b) without lawful authority throws overboard, damages or destroys anything that is part of the cargo, supplies or fittings in a Canadian ship` TRUE FALSE EQUALS NOTHING   -- with lawful authority
#ASSERT `s 75 the person commits a piratical act` `s 75(c) does or attempts to do a mutinous act on a Canadian ship` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 75 the person commits a piratical act` `s 75(d) counsels a person to do anything mentioned in paragraph (a), (b) or (c)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 75 the person commits a piratical act` `s 75(d) counsels a person to do anything mentioned in paragraph (a), (b) or (c)` FALSE FALSE EQUALS NOTHING
#ASSERT `s 75 the person commits a piratical act` `s 75 an act that is none of those in paragraphs (a) to (d)` TRUE TRUE EQUALS NOTHING
#ASSERT `s 75 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 75 the punishment` EQUALS LIST Punishment OF `by indictment`, `imprisonment for a term of` `fourteen years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `Tests -- section 76, hijacking (lines 1147-1153)`

--                                         unlawfully  seizes by force, threat or intimidation  intent
#ASSERT `s 76 the person commits hijacking` TRUE TRUE `s 76(a) to cause any person on board the aircraft to be confined or imprisoned against his will` EQUALS JUST TRUE
#ASSERT `s 76 the person commits hijacking` TRUE TRUE `s 76(b) to cause any person on board the aircraft to be transported against his will to any place other than the next scheduled place of landing of the aircraft` EQUALS JUST TRUE
#ASSERT `s 76 the person commits hijacking` TRUE TRUE `s 76(c) to hold any person on board the aircraft for ransom or to service against his will` EQUALS JUST TRUE
#ASSERT `s 76 the person commits hijacking` TRUE TRUE `s 76(d) to cause the aircraft to deviate in a material respect from its flight plan` EQUALS JUST TRUE
#ASSERT `s 76 the person commits hijacking` TRUE TRUE `s 76 another intent` EQUALS NOTHING
#ASSERT `s 76 the person commits hijacking` FALSE TRUE `s 76(a) to cause any person on board the aircraft to be confined or imprisoned against his will` EQUALS NOTHING   -- not unlawfully
#ASSERT `s 76 the person commits hijacking` TRUE FALSE `s 76(a) to cause any person on board the aircraft to be confined or imprisoned against his will` EQUALS NOTHING   -- no seizure or control by force, threat or intimidation
#ASSERT `s 76 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 76 the punishment` EQUALS LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `Tests -- section 77, endangering safety of aircraft or airport (lines 1154-1163)`

--                                                                     act                                                                                                                                                   in flight  in service  intl airport  weapon  weapon/substance/device  serious injury  endangers  knows false
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(a) on board an aircraft in flight, commits an act of violence against a person that is likely to endanger the safety of the aircraft` TRUE  FALSE FALSE FALSE FALSE FALSE TRUE  FALSE EQUALS JUST TRUE
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(a) on board an aircraft in flight, commits an act of violence against a person that is likely to endanger the safety of the aircraft` FALSE FALSE FALSE FALSE FALSE FALSE TRUE  FALSE EQUALS NOTHING   -- not in flight
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(a) on board an aircraft in flight, commits an act of violence against a person that is likely to endanger the safety of the aircraft` TRUE  FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- not likely to endanger
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(b) using a weapon, commits an act of violence against a person at an airport serving international civil aviation that causes or is likely to cause serious injury or death and that endangers or is likely to endanger safety at the airport` FALSE FALSE TRUE TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(b) using a weapon, commits an act of violence against a person at an airport serving international civil aviation that causes or is likely to cause serious injury or death and that endangers or is likely to endanger safety at the airport` FALSE FALSE TRUE FALSE FALSE TRUE TRUE FALSE EQUALS NOTHING   -- no weapon
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(b) using a weapon, commits an act of violence against a person at an airport serving international civil aviation that causes or is likely to cause serious injury or death and that endangers or is likely to endanger safety at the airport` FALSE FALSE FALSE TRUE FALSE TRUE TRUE FALSE EQUALS NOTHING   -- not an airport serving international civil aviation
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(b) using a weapon, commits an act of violence against a person at an airport serving international civil aviation that causes or is likely to cause serious injury or death and that endangers or is likely to endanger safety at the airport` FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING   -- no serious injury or death likely
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(c) causes damage to an aircraft in service that renders the aircraft incapable of flight or that is likely to endanger the safety of the aircraft in flight` FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(c) causes damage to an aircraft in service that renders the aircraft incapable of flight or that is likely to endanger the safety of the aircraft in flight` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING   -- not in service
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(d) places or causes to be placed on board an aircraft in service anything that is likely to cause damage to the aircraft, that will render it incapable of flight or that is likely to endanger the safety of the aircraft in flight` FALSE TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(d) places or causes to be placed on board an aircraft in service anything that is likely to cause damage to the aircraft, that will render it incapable of flight or that is likely to endanger the safety of the aircraft in flight` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(e) causes damage to or interferes with the operation of any air navigation facility where the damage or interference is likely to endanger the safety of an aircraft in flight` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(e) causes damage to or interferes with the operation of any air navigation facility where the damage or interference is likely to endanger the safety of an aircraft in flight` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(f) using a weapon, substance or device, destroys or causes serious damage to the facilities of an airport serving international civil aviation or to any aircraft not in service located there, or causes disruption of services of the airport, that endangers or is likely to endanger safety at the airport` FALSE FALSE TRUE FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(f) using a weapon, substance or device, destroys or causes serious damage to the facilities of an airport serving international civil aviation or to any aircraft not in service located there, or causes disruption of services of the airport, that endangers or is likely to endanger safety at the airport` FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING   -- no weapon, substance or device
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(f) using a weapon, substance or device, destroys or causes serious damage to the facilities of an airport serving international civil aviation or to any aircraft not in service located there, or causes disruption of services of the airport, that endangers or is likely to endanger safety at the airport` FALSE FALSE FALSE FALSE TRUE FALSE TRUE FALSE EQUALS NOTHING   -- not an airport serving international civil aviation
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(g) endangers the safety of an aircraft in flight by communicating to any other person any information that the person knows to be false` TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(g) endangers the safety of an aircraft in flight by communicating to any other person any information that the person knows to be false` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING   -- does not know it is false
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77(g) endangers the safety of an aircraft in flight by communicating to any other person any information that the person knows to be false` FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS NOTHING   -- not an aircraft in flight
#ASSERT `s 77 the person endangers the safety of an aircraft or airport` `s 77 an act that is none of those in paragraphs (a) to (g)` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 77 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 77 the punishment` EQUALS LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `Tests -- section 78, offensive weapons and explosive substances (lines 1164-1170)`

--                                              aircraft  Canadian Forces answer  police  customs
#ASSERT `s 78(2) the aircraft is a civil aircraft` TRUE (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 78(2) the aircraft is a civil aircraft` TRUE (JUST TRUE)  FALSE FALSE EQUALS JUST FALSE   -- operated by the Canadian Forces
#ASSERT `s 78(2) the aircraft is a civil aircraft` TRUE (JUST FALSE) TRUE  FALSE EQUALS JUST FALSE   -- operated by a police force in Canada
#ASSERT `s 78(2) the aircraft is a civil aircraft` TRUE (JUST FALSE) FALSE TRUE  EQUALS JUST FALSE   -- operated by persons enforcing the Customs Act or the Excise Acts
#ASSERT `s 78(2) the aircraft is a civil aircraft` FALSE (JUST FALSE) FALSE FALSE EQUALS JUST FALSE   -- not an aircraft
#ASSERT `s 78(2) the aircraft is a civil aircraft` TRUE NOTHING FALSE FALSE EQUALS NOTHING   -- s 2 "Canadian Forces" leaves the operator open
#ASSERT `s 78(2) the aircraft is a civil aircraft` TRUE NOTHING TRUE FALSE EQUALS JUST FALSE
--                                                                                      peace officer  engaged  civil aircraft  takes  weapon       explosive    consent position
#ASSERT `s 78(1) the person takes an offensive weapon or an explosive substance on board a civil aircraft` (JUST FALSE) FALSE (JUST TRUE) TRUE (JUST TRUE) NOTHING `s 78(1)(a) without the consent of the owner or operator of the aircraft or of a person duly authorized by either of them to consent thereto` EQUALS JUST TRUE
#ASSERT `s 78(1) the person takes an offensive weapon or an explosive substance on board a civil aircraft` (JUST FALSE) FALSE (JUST TRUE) TRUE NOTHING (JUST TRUE) `s 78(1)(b) with the consent referred to in paragraph (a) but without complying with all terms and conditions on which the consent was given` EQUALS JUST TRUE
#ASSERT `s 78(1) the person takes an offensive weapon or an explosive substance on board a civil aircraft` (JUST TRUE) FALSE (JUST TRUE) TRUE (JUST TRUE) NOTHING `s 78(1)(a) without the consent of the owner or operator of the aircraft or of a person duly authorized by either of them to consent thereto` EQUALS JUST TRUE   -- a peace officer not engaged in the execution of his duty
#ASSERT `s 78(1) the person takes an offensive weapon or an explosive substance on board a civil aircraft` (JUST TRUE) TRUE (JUST TRUE) TRUE (JUST TRUE) NOTHING `s 78(1)(a) without the consent of the owner or operator of the aircraft or of a person duly authorized by either of them to consent thereto` EQUALS NOTHING   -- "other than a peace officer engaged in the execution of his duty"
#ASSERT `s 78(1) the person takes an offensive weapon or an explosive substance on board a civil aircraft` NOTHING TRUE (JUST TRUE) TRUE (JUST TRUE) NOTHING `s 78(1)(a) without the consent of the owner or operator of the aircraft or of a person duly authorized by either of them to consent thereto` EQUALS NOTHING   -- peace-officer status left open
#ASSERT `s 78(1) the person takes an offensive weapon or an explosive substance on board a civil aircraft` (JUST FALSE) FALSE (JUST FALSE) TRUE (JUST TRUE) NOTHING `s 78(1)(a) without the consent of the owner or operator of the aircraft or of a person duly authorized by either of them to consent thereto` EQUALS JUST FALSE   -- not a civil aircraft
#ASSERT `s 78(1) the person takes an offensive weapon or an explosive substance on board a civil aircraft` (JUST FALSE) FALSE NOTHING TRUE (JUST TRUE) NOTHING `s 78(1)(a) without the consent of the owner or operator of the aircraft or of a person duly authorized by either of them to consent thereto` EQUALS NOTHING
#ASSERT `s 78(1) the person takes an offensive weapon or an explosive substance on board a civil aircraft` (JUST FALSE) FALSE (JUST TRUE) FALSE (JUST TRUE) NOTHING `s 78(1)(a) without the consent of the owner or operator of the aircraft or of a person duly authorized by either of them to consent thereto` EQUALS NOTHING   -- does not take it on board
#ASSERT `s 78(1) the person takes an offensive weapon or an explosive substance on board a civil aircraft` (JUST FALSE) FALSE (JUST TRUE) TRUE NOTHING NOTHING `s 78(1)(a) without the consent of the owner or operator of the aircraft or of a person duly authorized by either of them to consent thereto` EQUALS NOTHING   -- s 2 leaves the thing open
#ASSERT `s 78(1) the person takes an offensive weapon or an explosive substance on board a civil aircraft` (JUST FALSE) FALSE (JUST TRUE) TRUE (JUST FALSE) (JUST FALSE) `s 78(1)(a) without the consent of the owner or operator of the aircraft or of a person duly authorized by either of them to consent thereto` EQUALS NOTHING   -- neither an offensive weapon nor an explosive substance
#ASSERT `s 78(1) the person takes an offensive weapon or an explosive substance on board a civil aircraft` (JUST FALSE) FALSE (JUST TRUE) TRUE (JUST TRUE) NOTHING `s 78(1) with that consent and in compliance with all its terms and conditions` EQUALS NOTHING   -- with consent and in compliance
#ASSERT `s 78(1) the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 78(1) the punishment` EQUALS LIST Punishment OF `by indictment`, `imprisonment for a term of` `fourteen years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

