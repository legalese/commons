#ASSERT `s 145(2)(a) the person at large on a release order fails without lawful excuse to attend court` TRUE TRUE TRUE NOTHING EQUALS NOTHING   -- element missing: the person has a lawful excuse
#ASSERT `s 145(2)(a) the person at large on a release order fails without lawful excuse to attend court` TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE   -- exception: the answer of s 145(8)

-- s 145(2)(b) the person who has appeared fails without lawful excuse to attend court again as required: expected values follow the text (s 145(2)(b))
