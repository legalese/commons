#ASSERT `s 145(3) the person named in an appearance notice or served with a summons fails without lawful excuse to appear or attend` TRUE FALSE TRUE FALSE TRUE (JUST TRUE) NOTHING EQUALS JUST TRUE   -- alternative present: the answer of s 145(6)
#ASSERT `s 145(3) the person named in an appearance notice or served with a summons fails without lawful excuse to appear or attend` TRUE FALSE TRUE FALSE FALSE NOTHING (JUST TRUE) EQUALS JUST FALSE   -- exception: the answer of s 145(8)

