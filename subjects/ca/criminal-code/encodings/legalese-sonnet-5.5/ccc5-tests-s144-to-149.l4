IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc5-s144-to-149`

-- Tests for ccc5-s144-to-149.l4. Every expected value was decided from the text before the run; a failing assertion is a finding.

-- s 144(a) the person by force or violence breaks a prison with intent to set at liberty a person confined in it: expected values follow the text (s 144(a))
#ASSERT `s 144(a) the person by force or violence breaks a prison with intent to set at liberty a person confined in it` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 144(a) the person by force or violence breaks a prison with intent to set at liberty a person confined in it` NOTHING TRUE TRUE EQUALS NOTHING   -- element missing: s 2 prison: the place is one
#ASSERT `s 144(a) the person by force or violence breaks a prison with intent to set at liberty a person confined in it` (JUST TRUE) FALSE TRUE EQUALS NOTHING   -- element missing: the person by force or violence breaks the prison
#ASSERT `s 144(a) the person by force or violence breaks a prison with intent to set at liberty a person confined in it` (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- element missing: the person acts with intent to set at liberty themselves or any other person confined in it
#ASSERT `s 144(a) the person by force or violence breaks a prison with intent to set at liberty a person confined in it` (JUST FALSE) TRUE TRUE EQUALS NOTHING   -- s 2 prison: the place is one: the other way it can fail ((JUST FALSE))

-- s 144(b) the person confined in a prison with intent to escape forcibly breaks out of, or makes a breach in, a cell or other place within it: expected values follow the text (s 144(b))
#ASSERT `s 144(b) the person confined in a prison with intent to escape forcibly breaks out of, or makes a breach in, a cell or other place within it` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 144(b) the person confined in a prison with intent to escape forcibly breaks out of, or makes a breach in, a cell or other place within it` NOTHING TRUE TRUE TRUE EQUALS NOTHING   -- element missing: s 2 prison: the place is one
#ASSERT `s 144(b) the person confined in a prison with intent to escape forcibly breaks out of, or makes a breach in, a cell or other place within it` (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING   -- element missing: the person is confined in a cell or other place within the prison
#ASSERT `s 144(b) the person confined in a prison with intent to escape forcibly breaks out of, or makes a breach in, a cell or other place within it` (JUST TRUE) TRUE FALSE TRUE EQUALS NOTHING   -- element missing: the person breaks out of, or makes any breach in, the cell or other place
#ASSERT `s 144(b) the person confined in a prison with intent to escape forcibly breaks out of, or makes a breach in, a cell or other place within it` (JUST TRUE) TRUE TRUE FALSE EQUALS NOTHING   -- element missing: the person acts with intent to escape forcibly
#ASSERT `s 144(b) the person confined in a prison with intent to escape forcibly breaks out of, or makes a breach in, a cell or other place within it` (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING   -- s 2 prison: the place is one: the other way it can fail ((JUST FALSE))

#ASSERT `s 144 the person is guilty of an offence under section 144` NOTHING NOTHING EQUALS NOTHING   -- no limb is made out
#ASSERT `s 144 the person is guilty of an offence under section 144` (JUST FALSE) (JUST FALSE) EQUALS NOTHING   -- a limb answered JUST FALSE is not a made-out limb
#ASSERT `s 144 the person is guilty of an offence under section 144` (JUST TRUE) NOTHING EQUALS JUST TRUE   -- limb s 144(a) made out
#ASSERT `s 144 the person is guilty of an offence under section 144` NOTHING (JUST TRUE) EQUALS JUST TRUE   -- limb s 144(b) made out

#ASSERT `s 144 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`

#ASSERT `s 144 the punishment on indictment`'s `mode` EQUALS `by indictment`
#ASSERT `s 144 the punishment on indictment`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `ten years`
#ASSERT `s 144 the punishment on indictment`'s `minimum imprisonment` EQUALS `no imprisonment is stated`
#ASSERT `s 144 the punishment on indictment`'s `maximum fine` EQUALS `no fine is stated`

#ASSERT (`s 144 the punishment on summary conviction` (Punishment WITH `mode` IS `on summary conviction`, `maximum imprisonment` IS `imprisonment for a term of` `six months`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 5000, `minimum fine` IS `no fine is stated`))'s `mode` EQUALS `on summary conviction`
#ASSERT (`s 144 the punishment on summary conviction` (Punishment WITH `mode` IS `on summary conviction`, `maximum imprisonment` IS `imprisonment for a term of` `six months`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 5000, `minimum fine` IS `no fine is stated`))'s `maximum imprisonment` EQUALS `imprisonment for a term of` `six months`   -- the limb returns exactly what section 787(1) is given as
#ASSERT (`s 144 the punishment on summary conviction` (Punishment WITH `mode` IS `on summary conviction`, `maximum imprisonment` IS `imprisonment for a term of` `six months`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 5000, `minimum fine` IS `no fine is stated`))'s `maximum fine` EQUALS `a fine of` 5000

-- s 145(8) the failure is with lawful excuse because the Attorney General has made an election under section 50 of the Contraventions Act: expected values follow the text (s 145(8))
#ASSERT `s 145(8) the failure is with lawful excuse because the Attorney General has made an election under section 50 of the Contraventions Act` TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 145(8) the failure is with lawful excuse because the Attorney General has made an election under section 50 of the Contraventions Act` FALSE TRUE EQUALS JUST FALSE   -- element missing: the failure is a failure to attend court in accordance with a summons, appearance notice, undertaking or release order, to comply with a condition of an undertaking or release order, or to appear at the time and place stated in a summons, an appearance notice or an undertaking for the purposes of the Identification of Criminals Act
#ASSERT `s 145(8) the failure is with lawful excuse because the Attorney General has made an election under section 50 of the Contraventions Act` TRUE FALSE EQUALS JUST FALSE   -- element missing: before the failure, the Attorney General, within the meaning of the Contraventions Act, makes an election under section 50 of that Act

-- s 145(6) a defective statement of the alleged offence in an appearance notice or undertaking is not a lawful excuse: expected values follow the text (s 145(6))
#ASSERT `s 145(6) a defective statement of the alleged offence in an appearance notice or undertaking is not a lawful excuse` TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 145(6) a defective statement of the alleged offence in an appearance notice or undertaking is not a lawful excuse` FALSE EQUALS NOTHING   -- element missing: the appearance notice or undertaking states defectively the substance of the alleged offence

-- s 145(1) the person escapes from lawful custody: expected values follow the text (s 145(1))
#ASSERT `s 145(1) the person escapes from lawful custody` TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 145(1) the person escapes from lawful custody` FALSE EQUALS NOTHING   -- element missing: the person escapes from lawful custody

-- s 145(1) the person is at large before the end of a term of imprisonment without lawful excuse: expected values follow the text (s 145(1))
#ASSERT `s 145(1) the person is at large before the end of a term of imprisonment without lawful excuse` TRUE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 145(1) the person is at large before the end of a term of imprisonment without lawful excuse` FALSE FALSE EQUALS NOTHING   -- element missing: the person is, before the expiration of a term of imprisonment to which they were sentenced, at large in or outside Canada
#ASSERT `s 145(1) the person is at large before the end of a term of imprisonment without lawful excuse` TRUE TRUE EQUALS NOTHING   -- element missing: the person has a lawful excuse

#ASSERT `s 145(1) the person is guilty of an offence under subsection (1)` NOTHING NOTHING EQUALS NOTHING   -- no limb is made out
#ASSERT `s 145(1) the person is guilty of an offence under subsection (1)` (JUST FALSE) (JUST FALSE) EQUALS NOTHING   -- a limb answered JUST FALSE is not a made-out limb
#ASSERT `s 145(1) the person is guilty of an offence under subsection (1)` (JUST TRUE) NOTHING EQUALS JUST TRUE   -- limb s 145(1) escape from lawful custody made out
#ASSERT `s 145(1) the person is guilty of an offence under subsection (1)` NOTHING (JUST TRUE) EQUALS JUST TRUE   -- limb s 145(1) at large without excuse made out

#ASSERT `s 145(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`

#ASSERT `s 145(1)(a) the punishment on indictment`'s `mode` EQUALS `by indictment`
#ASSERT `s 145(1)(a) the punishment on indictment`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `two years`
#ASSERT `s 145(1)(a) the punishment on indictment`'s `minimum imprisonment` EQUALS `no imprisonment is stated`
#ASSERT `s 145(1)(a) the punishment on indictment`'s `maximum fine` EQUALS `no fine is stated`

#ASSERT (`s 145(1)(b) the punishment on summary conviction` (Punishment WITH `mode` IS `on summary conviction`, `maximum imprisonment` IS `imprisonment for a term of` `six months`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 5000, `minimum fine` IS `no fine is stated`))'s `mode` EQUALS `on summary conviction`
#ASSERT (`s 145(1)(b) the punishment on summary conviction` (Punishment WITH `mode` IS `on summary conviction`, `maximum imprisonment` IS `imprisonment for a term of` `six months`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 5000, `minimum fine` IS `no fine is stated`))'s `maximum imprisonment` EQUALS `imprisonment for a term of` `six months`   -- the limb returns exactly what section 787(1) is given as
#ASSERT (`s 145(1)(b) the punishment on summary conviction` (Punishment WITH `mode` IS `on summary conviction`, `maximum imprisonment` IS `imprisonment for a term of` `six months`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 5000, `minimum fine` IS `no fine is stated`))'s `maximum fine` EQUALS `a fine of` 5000

-- s 145(2)(a) the person at large on a release order fails without lawful excuse to attend court: expected values follow the text (s 145(2)(a))
#ASSERT `s 145(2)(a) the person at large on a release order fails without lawful excuse to attend court` TRUE TRUE FALSE NOTHING EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 145(2)(a) the person at large on a release order fails without lawful excuse to attend court` FALSE TRUE FALSE NOTHING EQUALS NOTHING   -- element missing: s 515 the accused is bound by a release order
