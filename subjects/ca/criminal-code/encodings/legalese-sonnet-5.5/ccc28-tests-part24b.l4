#ASSERT `s 753.1(2)(a) the offence is one the paragraph names` (`s 753.1 test the offence` 279.03 "(2)" `s 752 convicted of the offence itself`) EQUALS JUST TRUE   -- 279.03(2): named in paragraph (a)
#ASSERT `s 753.1(2)(a) the offence is one the paragraph names` (`s 753.1 test the offence` 286.1 "(2)" `s 752 convicted of the offence itself`) EQUALS JUST TRUE   -- 286.1(2): named in paragraph (a)
#ASSERT `s 753.1(2)(a) the offence is one the paragraph names` (`s 753.1 test the offence` 286.2 "(2)" `s 752 convicted of the offence itself`) EQUALS JUST TRUE   -- 286.2(2): named in paragraph (a)
#ASSERT `s 753.1(2)(a) the offence is one the paragraph names` (`s 753.1 test the offence` 286.3 "(2)" `s 752 convicted of the offence itself`) EQUALS JUST TRUE   -- 286.3(2): named in paragraph (a)
#ASSERT `s 753.1(2)(a) the offence is one the paragraph names` (`s 753.1 test the offence` 150 "" `s 752 convicted of the offence itself`) EQUALS JUST FALSE   -- section 150 is not named
#ASSERT `s 753.1(2)(a) the offence is one the paragraph names` (`s 753.1 test the offence` 173 "(1)" `s 752 convicted of the offence itself`) EQUALS JUST FALSE   -- the paragraph names subsection 173(2), not 173(1)
#ASSERT `s 753.1(2)(a) the offence is one the paragraph names` (`s 753.1 test the offence` 279.02 "(1)" `s 752 convicted of the offence itself`) EQUALS JUST FALSE   -- the paragraph names subsection 279.02(2), not 279.02(1)
#ASSERT `s 753.1(2)(a) the offence is one the paragraph names` (`s 753.1 test the offence` 286.1 "(1)" `s 752 convicted of the offence itself`) EQUALS JUST FALSE   -- the paragraph names subsection 286.1(2), not 286.1(1)
#ASSERT `s 753.1(2)(a) the offence is one the paragraph names` (`s 753.1 test the offence` 279.01 "" `s 752 convicted of the offence itself`) EQUALS JUST FALSE   -- section 279.01 is not named (279.011 is)
#ASSERT `s 753.1(2)(a) the offence is one the paragraph names` (`s 753.1 test the offence` 151 "" `s 752 convicted of an attempt to commit the offence`) EQUALS NOTHING   -- an attempt is not "an offence under" section 151: silent
#ASSERT `s 753.1(2)(a) the offence is one the paragraph names` (`s 753.1 test the offence` 151 "" `s 752 convicted of a conspiracy to commit the offence`) EQUALS NOTHING   -- a conspiracy is not "an offence under" section 151: silent
#ASSERT `s 753.1(2)(a) the offence is one the paragraph names` (`s 753.1 test the offence` 150 "" `s 752 convicted of an attempt to commit the offence`) EQUALS JUST FALSE   -- the provision is not named

§ `s 753.1(2): the substantial risk the court shall be satisfied of`

#ASSERT `s 753.1(2) the court shall be satisfied that there is a substantial risk that the offender will reoffend` (`s 753.1 test the offence` 271 "" `s 752 convicted of the offence itself`) FALSE TRUE FALSE EQUALS JUST TRUE   -- (a) a listed offence, (b)(i)
#ASSERT `s 753.1(2) the court shall be satisfied that there is a substantial risk that the offender will reoffend` (`s 753.1 test the offence` 271 "" `s 752 convicted of the offence itself`) FALSE FALSE TRUE EQUALS JUST TRUE   -- (a) a listed offence, (b)(ii)
#ASSERT `s 753.1(2) the court shall be satisfied that there is a substantial risk that the offender will reoffend` (`s 753.1 test the offence` 271 "" `s 752 convicted of the offence itself`) FALSE FALSE FALSE EQUALS JUST FALSE   -- (a) but neither (b)(i) nor (b)(ii)
#ASSERT `s 753.1(2) the court shall be satisfied that there is a substantial risk that the offender will reoffend` (`s 753.1 test the offence` 150 "" `s 752 convicted of the offence itself`) FALSE TRUE FALSE EQUALS JUST FALSE   -- (b)(i) but no listed offence and no serious conduct of a sexual nature
#ASSERT `s 753.1(2) the court shall be satisfied that there is a substantial risk that the offender will reoffend` (`s 753.1 test the offence` 150 "" `s 752 convicted of the offence itself`) TRUE TRUE FALSE EQUALS JUST TRUE   -- (a) by serious conduct of a sexual nature in the commission of another offence
#ASSERT `s 753.1(2) the court shall be satisfied that there is a substantial risk that the offender will reoffend` (`s 753.1 test the offence` 271 "" `s 752 convicted of an attempt to commit the offence`) FALSE TRUE FALSE EQUALS NOTHING   -- (a): an attempt is not "an offence under" the listed sections: not covered
#ASSERT `s 753.1(2) the court shall be satisfied that there is a substantial risk that the offender will reoffend` (`s 753.1 test the offence` 271 "" `s 752 convicted of an attempt to commit the offence`) TRUE TRUE FALSE EQUALS JUST TRUE   -- (a): serious conduct of a sexual nature, whatever the conviction

§ `s 753.1(3), (3.1) and (6)`

#ASSERT `s 753.1(3) the sentence and order are within paragraphs (a) and (b)` TRUE `two years` `ten years` EQUALS JUST TRUE
#ASSERT `s 753.1(3) the sentence and order are within paragraphs (a) and (b)` TRUE `two years less a day` `ten years` EQUALS JUST FALSE   -- below the minimum punishment of two years
#ASSERT `s 753.1(3) the sentence and order are within paragraphs (a) and (b)` TRUE `two years` (`Length of time` OF 10, 0, 1, FALSE) EQUALS JUST FALSE   -- supervision for ten years and a day
#ASSERT `s 753.1(3) the sentence and order are within paragraphs (a) and (b)` TRUE `five years` `five years` EQUALS JUST TRUE
#ASSERT `s 753.1(3) the sentence and order are within paragraphs (a) and (b)` FALSE `two years` `ten years` EQUALS JUST FALSE   -- the court did not find a long-term offender
#ASSERT `s 753.1(3.1) the court may not impose a sentence under paragraph (3)(a)` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 753.1(3.1) the court may not impose a sentence under paragraph (3)(a)` FALSE (JUST TRUE) TRUE EQUALS JUST FALSE   -- the application was not made after the offender began to serve the sentence
#ASSERT `s 753.1(3.1) the court may not impose a sentence under paragraph (3)(a)` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE   -- not treated as an application under this section under paragraph 753(5)(a)
#ASSERT `s 753.1(3.1) the court may not impose a sentence under paragraph (3)(a)` TRUE (JUST FALSE) TRUE EQUALS JUST FALSE   -- not a case to which paragraphs 753(2)(a) and (b) apply
#ASSERT `s 753.1(3.1) the court may not impose a sentence under paragraph (3)(a)` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 753.1(6) the court shall impose sentence for the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 753.1(6) the court shall impose sentence for the offence` FALSE EQUALS JUST FALSE   -- the court finds the offender to be a long-term offender

§ `s 753.2: long-term supervision`

#ASSERT `s 753.2(1) the offender shall be supervised in the community` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 753.2(1) the offender shall be supervised in the community` TRUE FALSE TRUE EQUALS JUST FALSE   -- the sentence for the offence is not yet served
#ASSERT `s 753.2(1) the offender shall be supervised in the community` TRUE TRUE FALSE EQUALS JUST FALSE   -- another term of imprisonment is not yet served
#ASSERT `s 753.2(1) the offender shall be supervised in the community` FALSE TRUE TRUE EQUALS NOTHING   -- not subject to long-term supervision: the duty is limited to a named class
#ASSERT `s 753.2(2) the sentence is to be served concurrently with the long-term supervision` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 753.2(2) the sentence is to be served concurrently with the long-term supervision` TRUE TRUE EQUALS NOTHING   -- a sentence that requires imprisonment: the exception, silent
#ASSERT `s 753.2(2) the sentence is to be served concurrently with the long-term supervision` FALSE FALSE EQUALS NOTHING   -- not an offender referred to in subsection (1)
#ASSERT `s 753.2(3) the applicant may apply for an order reducing or terminating the period of long-term supervision` `s 753.2(3) the offender who is required to be supervised` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 753.2(3) the applicant may apply for an order reducing or terminating the period of long-term supervision` `s 753.2(3) a member of the Parole Board of Canada` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 753.2(3) the applicant may apply for an order reducing or terminating the period of long-term supervision` `s 753.2(3) the offender's parole supervisor with the approval of the Parole Board of Canada` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 753.2(3) the applicant may apply for an order reducing or terminating the period of long-term supervision` `s 753.2(3) the offender's parole supervisor without the approval of the Parole Board of Canada` (JUST TRUE) TRUE EQUALS JUST FALSE   -- "on approval of that Board"
#ASSERT `s 753.2(3) the applicant may apply for an order reducing or terminating the period of long-term supervision` `s 753.2(3) any other person` (JUST TRUE) TRUE EQUALS NOTHING   -- the persons named are not said to be the only ones
#ASSERT `s 753.2(3) the applicant may apply for an order reducing or terminating the period of long-term supervision` `s 753.2(3) the offender who is required to be supervised` (JUST TRUE) FALSE EQUALS NOTHING   -- another ground: the named ground is not said to be the only one
#ASSERT `s 753.2(3) the applicant may apply for an order reducing or terminating the period of long-term supervision` `s 753.2(3) the offender who is required to be supervised` (JUST FALSE) TRUE EQUALS NOTHING   -- not a superior court: the named court is not said to be the only one
#ASSERT `s 753.2(3) the applicant may apply for an order reducing or terminating the period of long-term supervision` `s 753.2(3) the offender who is required to be supervised` NOTHING TRUE EQUALS NOTHING   -- the answer of s 2 is not covered
#ASSERT `s 753.2(3) the onus of proving the ground is on the applicant` TRUE EQUALS JUST TRUE
#ASSERT `s 753.2(3) the onus of proving the ground is on the applicant` FALSE EQUALS NOTHING
#ASSERT `s 753.2(4) the notice is given at the time the application is made` (Date 5 5 2021) (Date 5 5 2021) EQUALS JUST TRUE
#ASSERT `s 753.2(4) the notice is given at the time the application is made` (Date 5 5 2021) (Date 6 5 2021) EQUALS JUST FALSE   -- the day after
#ASSERT `s 753.2(4) the notice is given at the time the application is made` (Date 5 5 2021) (Date 4 5 2021) EQUALS JUST FALSE   -- the day before: not at the time
#TRACE `s 753.2(4) the duty of the applicant to give notice to the Attorney General` AT 0 WITH
    PARTY `s 753.2(4) the applicant` DOES `s 753.2(4) give notice of the application to the Attorney General` AT 0

#TRACE `s 753.2(4) the duty of the applicant to give notice to the Attorney General` AT 0 WITH
    PARTY `s 753.2(4) the applicant` DOES `s 753.2(4) give notice of the application to the Attorney General` AT 1

#TRACE `s 753.2(4) the duty of the applicant to give notice to the Attorney General` AT 0 WITH
    (WAITUNTIL 1)

§ `s 753.3: breach of long-term supervision`

#ASSERT `s 753.3(1) the offender is guilty of an offence` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 753.3(1) the offender is guilty of an offence` TRUE TRUE TRUE EQUALS NOTHING   -- "without reasonable excuse": limited by its own wording
#ASSERT `s 753.3(1) the offender is guilty of an offence` TRUE FALSE FALSE EQUALS NOTHING   -- no failure or refusal to comply
#ASSERT `s 753.3(1) the offender is guilty of an offence` FALSE TRUE FALSE EQUALS NOTHING   -- not subject to long-term supervision
#ASSERT (`s 753.3(1) the punishment` `by indictment`)'s `maximum imprisonment` EQUALS `imprisonment for a term of` `ten years`   -- (a) not more than 10 years
#ASSERT (`s 753.3(1) the punishment` `on summary conviction`)'s `maximum imprisonment` EQUALS `no imprisonment is stated`   -- (b) states no punishment
#ASSERT `s 753.3(2) the accused may be tried and punished in this place` TRUE TRUE `s 753.3(2) the place where the offence is alleged to have been committed` FALSE EQUALS JUST TRUE
#ASSERT `s 753.3(2) the accused may be tried and punished in this place` TRUE TRUE `s 753.3(2) the place where the accused is found, is arrested or is in custody, within the province in which the offence is alleged to have been committed` FALSE EQUALS JUST TRUE
#ASSERT `s 753.3(2) the accused may be tried and punished in this place` TRUE TRUE `s 753.3(2) the place where the accused is found, is arrested or is in custody, outside the province in which the offence is alleged to have been committed` TRUE EQUALS JUST TRUE   -- with the consent of the Attorney General of that province
#ASSERT `s 753.3(2) the accused may be tried and punished in this place` TRUE TRUE `s 753.3(2) the place where the accused is found, is arrested or is in custody, outside the province in which the offence is alleged to have been committed` FALSE EQUALS JUST FALSE   -- "without the consent of the Attorney General of that province"
#ASSERT `s 753.3(2) the accused may be tried and punished in this place` TRUE TRUE `s 753.3(2) any other place` FALSE EQUALS NOTHING
#ASSERT `s 753.3(2) the accused may be tried and punished in this place` FALSE TRUE `s 753.3(2) the place where the offence is alleged to have been committed` FALSE EQUALS NOTHING   -- not charged with an offence under subsection (1)
#ASSERT `s 753.3(2) the accused may be tried and punished in this place` TRUE FALSE `s 753.3(2) the place where the offence is alleged to have been committed` FALSE EQUALS NOTHING   -- the court has no jurisdiction to try that offence

§ `s 753.4: a new offence while subject to long-term supervision`

#ASSERT `s 753.4(1) the long-term supervision is interrupted` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 753.4(1) the long-term supervision is interrupted` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- the offender has finished serving all the sentences
#ASSERT `s 753.4(1) the long-term supervision is interrupted` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- the court orders its termination
#ASSERT `s 753.4(1) the long-term supervision is interrupted` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- not subject to long-term supervision
#ASSERT `s 753.4(1) the long-term supervision is interrupted` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- no new offence
#ASSERT `s 753.4(1) the long-term supervision is interrupted` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- no sentence of imprisonment
#ASSERT `s 753.4(2) the court may order a reduction in the length of the period of long-term supervision` TRUE EQUALS JUST TRUE
#ASSERT `s 753.4(2) the court may order a reduction in the length of the period of long-term supervision` FALSE EQUALS NOTHING

§ `s 754: hearing of an application`

#ASSERT `s 754(1) the court may not hear the application` FALSE TRUE 7 TRUE TRUE EQUALS JUST FALSE   -- all of (a), (b) and (c): seven days notice
#ASSERT `s 754(1) the court may not hear the application` FALSE TRUE 6 TRUE TRUE EQUALS JUST TRUE   -- six days notice is not at least seven
#ASSERT `s 754(1) the court may not hear the application` FALSE FALSE 7 TRUE TRUE EQUALS JUST TRUE   -- no consent of the Attorney General
#ASSERT `s 754(1) the court may not hear the application` FALSE TRUE 7 FALSE TRUE EQUALS JUST TRUE   -- the notice was not given following the making of the application
#ASSERT `s 754(1) the court may not hear the application` FALSE TRUE 7 TRUE FALSE EQUALS JUST TRUE   -- no copy filed with the clerk or the judge
#ASSERT `s 754(1) the court may not hear the application` TRUE FALSE 0 FALSE FALSE EQUALS JUST FALSE   -- an application for remand for assessment is excepted
#ASSERT `s 754(2) the application is heard and determined by the court without a jury` TRUE EQUALS JUST TRUE
#ASSERT `s 754(2) the application is heard and determined by the court without a jury` FALSE EQUALS JUST FALSE
#ASSERT `s 754(3) no proof of the allegations is required` TRUE EQUALS JUST TRUE
#ASSERT `s 754(3) no proof of the allegations is required` FALSE EQUALS JUST FALSE   -- the offender does not admit them
#ASSERT `s 754(4) the document is proof of the nomination or consent` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 754(4) the document is proof of the nomination or consent` TRUE TRUE EQUALS JUST FALSE   -- there is evidence to the contrary
#ASSERT `s 754(4) the document is proof of the nomination or consent` FALSE FALSE EQUALS NOTHING   -- not a document of that kind

§ `s 755: the life sentence and the total of long-term supervision`

#ASSERT `s 755(1) the court shall not order that the offender be subject to long-term supervision` TRUE EQUALS JUST TRUE
#ASSERT `s 755(1) the court shall not order that the offender be subject to long-term supervision` FALSE EQUALS JUST FALSE
#ASSERT `s 755(2) the periods of long-term supervision do not total more than 10 years` (LIST `ten years`) EQUALS JUST TRUE   -- exactly ten years
#ASSERT `s 755(2) the periods of long-term supervision do not total more than 10 years` (LIST `five years`, `five years`) EQUALS JUST TRUE   -- two periods that total ten years
#ASSERT `s 755(2) the periods of long-term supervision do not total more than 10 years` (LIST `five years`, (`Length of time` OF 5, 0, 32, FALSE)) EQUALS JUST FALSE   -- ten years and 32 days is more than 10 years in every calendar
#ASSERT `s 755(2) the periods of long-term supervision do not total more than 10 years` (LIST `five years`, (`Length of time` OF 5, 0, 29, FALSE)) EQUALS JUST FALSE   -- ten years and 29 days is more than 10 years in every calendar
#ASSERT `s 755(2) the periods of long-term supervision do not total more than 10 years` (LIST `five years`, (`Length of time` OF 4, 11, 30, FALSE)) EQUALS NOTHING   -- 119 months and 30 days: more than 10 years in a 28-day or 29-day month, not in a 31-day one, so the calendar decides
#ASSERT `s 755(2) the periods of long-term supervision do not total more than 10 years` (LIST `five years`, (`Length of time` OF 4, 11, 32, FALSE)) EQUALS JUST FALSE   -- 119 months and 32 days is more than 120 months in every calendar
#ASSERT `s 755(2) the periods of long-term supervision do not total more than 10 years` (LIST `five years`, (`Length of time` OF 4, 11, 28, FALSE)) EQUALS JUST TRUE   -- ten years less no more than a month, and 28 days is within a month in every calendar
#ASSERT `s 755(2) the periods of long-term supervision do not total more than 10 years` (LIST `five years`, (`Length of time` OF 4, 11, 29, FALSE)) EQUALS NOTHING
#ASSERT `s 755(2) the periods of long-term supervision do not total more than 10 years` (LIST `five years`, `two years less a day`) EQUALS JUST TRUE
#ASSERT `s 755(2) the periods of long-term supervision do not total more than 10 years` (LIST `ten years`, (`Length of time` OF 0, 0, 1, FALSE)) EQUALS JUST FALSE   -- ten years and a day: more than ten years
#ASSERT `s 755(2) the periods of long-term supervision do not total more than 10 years` (LIST `ten years`, (`Length of time` OF 0, 1, 0, FALSE)) EQUALS JUST FALSE   -- ten years and a month
