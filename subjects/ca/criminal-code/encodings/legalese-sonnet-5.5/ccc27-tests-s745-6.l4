IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc27-s745-6-review`

-- ccc27-tests-s745-6.l4 -- tests for sections 745.6 to 745.64. Every expected value is written from the text, beside the assertion.

§ `Tests -- section 745.6`

-- the date helpers
#ASSERT `s 745.6 the day five years after` (Date 10 3 2020) EQUALS Date 10 3 2025
#ASSERT `s 745.6 the day five years after` (Date 29 2 2020) EQUALS Date 1 3 2025   -- 2025 has no 29 February: the date type rolls it to 1 March
#ASSERT `s 745.6 the day that many days after` (Date 25 12 2024) 90 EQUALS Date 25 3 2025   -- 6 + 31 + 28 + 25 = 90
#ASSERT `s 745.6 the day is within ninety days after the start` (Date 10 3 2025) (Date 10 3 2025) EQUALS TRUE   -- the start itself (F-9)
#ASSERT `s 745.6 the day is within ninety days after the start` (Date 8 6 2025) (Date 10 3 2025) EQUALS TRUE   -- the ninetieth day: 21 + 30 + 31 + 8 = 90
#ASSERT `s 745.6 the day is within ninety days after the start` (Date 9 6 2025) (Date 10 3 2025) EQUALS FALSE   -- the ninety-first day
#ASSERT `s 745.6 the day is within ninety days after the start` (Date 9 3 2025) (Date 10 3 2025) EQUALS FALSE   -- the day before the start

-- (1): murder or high treason; before the day of (a.1); more than fifteen years without eligibility; at least fifteen served; (2): more than one murder
-- args: convicted of murder or high treason; committed before the day; years without eligibility; years served; more than one murder; in writing to the Chief Justice
#ASSERT `s 745.6(1) the person may apply for a reduction in the number of years of imprisonment without eligibility for parole` TRUE TRUE 25 15 FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 745.6(1) the person may apply for a reduction in the number of years of imprisonment without eligibility for parole` TRUE TRUE 16 20 FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 745.6(1) the person may apply for a reduction in the number of years of imprisonment without eligibility for parole` TRUE TRUE 15 15 FALSE TRUE EQUALS NOTHING   -- "more than fifteen years": fifteen is not more (F-2)
#ASSERT `s 745.6(1) the person may apply for a reduction in the number of years of imprisonment without eligibility for parole` TRUE TRUE 25 14 FALSE TRUE EQUALS NOTHING   -- less than fifteen years served
#ASSERT `s 745.6(1) the person may apply for a reduction in the number of years of imprisonment without eligibility for parole` FALSE TRUE 25 15 FALSE TRUE EQUALS NOTHING   -- not convicted of murder or high treason
#ASSERT `s 745.6(1) the person may apply for a reduction in the number of years of imprisonment without eligibility for parole` TRUE FALSE 25 15 FALSE TRUE EQUALS NOTHING   -- committed on or after the day of (a.1)
#ASSERT `s 745.6(1) the person may apply for a reduction in the number of years of imprisonment without eligibility for parole` TRUE TRUE 25 15 FALSE FALSE EQUALS NOTHING   -- not in writing to the Chief Justice
#ASSERT `s 745.6(1) the person may apply for a reduction in the number of years of imprisonment without eligibility for parole` TRUE TRUE 25 15 TRUE TRUE EQUALS JUST FALSE   -- subsection (2): more than one murder, "may not"
#ASSERT `s 745.6(2) the person may not make an application under subsection (1)` TRUE EQUALS JUST TRUE
#ASSERT `s 745.6(2) the person may not make an application under subsection (1)` FALSE EQUALS NOTHING
-- (2.1): within 90 days after the day on which they have served 15 years
#ASSERT `s 745.6(2.1) the person may make an application under subsection (1) on the day` TRUE TRUE (Date 1 1 2030) (Date 1 1 2030) EQUALS JUST TRUE
#ASSERT `s 745.6(2.1) the person may make an application under subsection (1) on the day` TRUE TRUE (Date 1 1 2030) (Date 1 4 2030) EQUALS JUST TRUE   -- the ninetieth day (2030 is not a leap year: 31 + 28 + 31 = 90)
#ASSERT `s 745.6(2.1) the person may make an application under subsection (1) on the day` TRUE TRUE (Date 1 1 2030) (Date 2 4 2030) EQUALS JUST FALSE   -- the ninety-first day
#ASSERT `s 745.6(2.1) the person may make an application under subsection (1) on the day` TRUE TRUE (Date 1 1 2030) (Date 31 12 2029) EQUALS JUST FALSE   -- before the person has served 15 years
#ASSERT `s 745.6(2.1) the person may make an application under subsection (1) on the day` FALSE TRUE (Date 1 1 2030) (Date 1 1 2030) EQUALS NOTHING   -- not convicted of murder or high treason
#ASSERT `s 745.6(2.1) the person may make an application under subsection (1) on the day` TRUE FALSE (Date 1 1 2030) (Date 1 1 2030) EQUALS NOTHING   -- had served 15 years or more when the subsection came into force
-- (2.2): args: convicted; served at least 15 years when it came into force; day of the determination (optional); day it came into force; has not applied; day
#ASSERT `s 745.6(2.2) the person may make an application under subsection (1) on the day` TRUE TRUE (JUST (Date 1 6 2020)) (Date 1 1 2023) FALSE (Date 1 6 2025) EQUALS JUST TRUE   -- (a): the end of five years, first day
#ASSERT `s 745.6(2.2) the person may make an application under subsection (1) on the day` TRUE TRUE (JUST (Date 1 6 2020)) (Date 1 1 2023) FALSE (Date 30 8 2025) EQUALS JUST TRUE   -- (a): the ninetieth day (29 + 31 + 30 = 90)
#ASSERT `s 745.6(2.2) the person may make an application under subsection (1) on the day` TRUE TRUE (JUST (Date 1 6 2020)) (Date 1 1 2023) FALSE (Date 31 8 2025) EQUALS JUST FALSE   -- (a): the ninety-first day
#ASSERT `s 745.6(2.2) the person may make an application under subsection (1) on the day` TRUE TRUE (JUST (Date 1 6 2020)) (Date 1 1 2023) FALSE (Date 31 5 2025) EQUALS JUST FALSE   -- (a): before the five years end
#ASSERT `s 745.6(2.2) the person may make an application under subsection (1) on the day` TRUE TRUE NOTHING (Date 1 1 2023) TRUE (Date 1 1 2023) EQUALS JUST TRUE   -- (b): the day it came into force, no application made
#ASSERT `s 745.6(2.2) the person may make an application under subsection (1) on the day` TRUE TRUE NOTHING (Date 1 1 2023) TRUE (Date 1 4 2023) EQUALS JUST TRUE   -- (b): the ninetieth day (31 + 28 + 31 = 90)
#ASSERT `s 745.6(2.2) the person may make an application under subsection (1) on the day` TRUE TRUE NOTHING (Date 1 1 2023) TRUE (Date 2 4 2023) EQUALS JUST FALSE   -- (b): the ninety-first day
#ASSERT `s 745.6(2.2) the person may make an application under subsection (1) on the day` TRUE TRUE NOTHING (Date 1 1 2023) FALSE (Date 1 1 2023) EQUALS NOTHING   -- neither paragraph gives a window: no determination and an application already made
#ASSERT `s 745.6(2.2) the person may make an application under subsection (1) on the day` TRUE FALSE NOTHING (Date 1 1 2023) TRUE (Date 1 1 2023) EQUALS NOTHING   -- had not served 15 years: subsection (2.1) governs
-- (2.3)
#ASSERT `s 745.6(2.3) subsection (2.2) has an effect on the determination or decision` TRUE EQUALS JUST FALSE   -- "has no effect"
#ASSERT `s 745.6(2.3) subsection (2.2) has an effect on the determination or decision` FALSE EQUALS NOTHING
#ASSERT `s 745.6(2.3) the person may make an application under subsection (1) on the day` (JUST (Date 1 1 2024)) (Date 1 1 2024) EQUALS JUST TRUE
#ASSERT `s 745.6(2.3) the person may make an application under subsection (1) on the day` (JUST (Date 1 1 2024)) (Date 31 3 2024) EQUALS JUST TRUE   -- the ninetieth day after 1 January 2024 (a leap year: 31 + 29 = 60 days to 1 March, and 30 more to 31 March)
#ASSERT `s 745.6(2.3) the person may make an application under subsection (1) on the day` (JUST (Date 1 1 2024)) (Date 1 4 2024) EQUALS JUST FALSE   -- the ninety-first day
#ASSERT `s 745.6(2.3) the person may make an application under subsection (1) on the day` NOTHING (Date 1 1 2024) EQUALS NOTHING   -- no time was set
-- (2.4): a further five years
#ASSERT `s 745.6(2.4) the person may make an application under subsection (1) on the day` FALSE (Date 1 4 2025) (Date 1 4 2030) EQUALS JUST TRUE   -- five years after the end of the first 90 days
#ASSERT `s 745.6(2.4) the person may make an application under subsection (1) on the day` FALSE (Date 1 4 2025) (Date 30 6 2030) EQUALS JUST TRUE   -- the ninetieth day (29 + 31 + 30 = 90)
#ASSERT `s 745.6(2.4) the person may make an application under subsection (1) on the day` FALSE (Date 1 4 2025) (Date 1 7 2030) EQUALS JUST FALSE
#ASSERT `s 745.6(2.4) the person may make an application under subsection (1) on the day` FALSE (Date 1 4 2025) (Date 31 3 2030) EQUALS JUST FALSE   -- before the five years
#ASSERT `s 745.6(2.4) the person may make an application under subsection (1) on the day` TRUE (Date 1 4 2025) (Date 1 4 2030) EQUALS NOTHING   -- the person did make an application: "If the person does not make an application"
-- (2.5): args: made an application in accordance with (2.1), (2.2) or (2.3); end of the time set; day of the determination; day
#ASSERT `s 745.6(2.5) the person may make another application under subsection (1) on the day` TRUE (JUST (Date 1 1 2028)) NOTHING (Date 15 2 2028) EQUALS JUST TRUE   -- (a)
#ASSERT `s 745.6(2.5) the person may make another application under subsection (1) on the day` TRUE (JUST (Date 1 1 2028)) NOTHING (Date 1 6 2028) EQUALS JUST FALSE   -- (a): after the 90 days
#ASSERT `s 745.6(2.5) the person may make another application under subsection (1) on the day` TRUE NOTHING (JUST (Date 1 1 2022)) (Date 1 1 2027) EQUALS JUST TRUE   -- (b): the end of five years after the determination
#ASSERT `s 745.6(2.5) the person may make another application under subsection (1) on the day` TRUE NOTHING (JUST (Date 1 1 2022)) (Date 31 12 2026) EQUALS JUST FALSE   -- (b): a day before the five years end
#ASSERT `s 745.6(2.5) the person may make another application under subsection (1) on the day` TRUE NOTHING NOTHING (Date 1 1 2027) EQUALS NOTHING   -- no time set and no determination
#ASSERT `s 745.6(2.5) the person may make another application under subsection (1) on the day` FALSE (JUST (Date 1 1 2028)) NOTHING (Date 15 2 2028) EQUALS NOTHING   -- did not make an application
-- (2.6)
#ASSERT `s 745.6(2.6) the person may make a further application in accordance with subsection (2.5)` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 745.6(2.6) the person may make a further application in accordance with subsection (2.5)` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- neither (2.5)(a) nor (b) is applicable
#ASSERT `s 745.6(2.6) the person may make a further application in accordance with subsection (2.5)` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- disposed of before the day
-- (2.7): args: one of the 90-day limits in (2.1) to (2.5); by the Chief Justice or a designate; unable through circumstances beyond their control; the extended limit in days
#ASSERT `s 745.6(2.7) the time limit may be extended to the number of days` TRUE TRUE TRUE 180 EQUALS JUST TRUE   -- the maximum
#ASSERT `s 745.6(2.7) the time limit may be extended to the number of days` TRUE TRUE TRUE 181 EQUALS NOTHING   -- over the maximum
#ASSERT `s 745.6(2.7) the time limit may be extended to the number of days` TRUE TRUE FALSE 120 EQUALS NOTHING   -- able to apply in time
#ASSERT `s 745.6(2.7) the time limit may be extended to the number of days` FALSE TRUE TRUE 120 EQUALS NOTHING   -- not one of the 90-day limits
#ASSERT `s 745.6(2.7) the time limit may be extended to the number of days` TRUE FALSE TRUE 120 EQUALS NOTHING   -- not by the Chief Justice or a designate
-- (2.8)
#ASSERT `s 745.6(2.8) the Commissioner of Correctional Service Canada, or a designate, shall notify the relative in writing` TRUE `s 745.6(2.8) a parent, child, spouse or common-law partner of the victim` TRUE EQUALS JUST TRUE
#ASSERT `s 745.6(2.8) the Commissioner of Correctional Service Canada, or a designate, shall notify the relative in writing` TRUE `s 745.6(2.8) another relative of the victim` FALSE EQUALS JUST TRUE   -- it is not possible to notify the first kind
#ASSERT `s 745.6(2.8) the Commissioner of Correctional Service Canada, or a designate, shall notify the relative in writing` TRUE `s 745.6(2.8) another relative of the victim` TRUE EQUALS JUST FALSE   -- it is possible to notify the first kind: the other relative is not the one
#ASSERT `s 745.6(2.8) the Commissioner of Correctional Service Canada, or a designate, shall notify the relative in writing` TRUE `s 745.6(2.8) someone else` TRUE EQUALS NOTHING
#ASSERT `s 745.6(2.8) the Commissioner of Correctional Service Canada, or a designate, shall notify the relative in writing` FALSE `s 745.6(2.8) a parent, child, spouse or common-law partner of the victim` TRUE EQUALS JUST FALSE   -- the person made an application in time
#ASSERT `s 745.6(2.8) the notification meets the requirements of the subsection` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 745.6(2.8) the notification meets the requirements of the subsection` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 745.6(2.8) the notification meets the requirements of the subsection` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 745.6(2.8) the notification meets the requirements of the subsection` TRUE TRUE FALSE EQUALS JUST FALSE   -- does not specify the next date
-- (3): the appropriate Chief Justice, all thirteen
#ASSERT `s 745.6(3) the appropriate Chief Justice` Ontario EQUALS `s 745.6(3)(a) the Chief Justice of the Ontario Court`
#ASSERT `s 745.6(3) the appropriate Chief Justice` Quebec EQUALS `s 745.6(3)(b) the Chief Justice of the Superior Court`
#ASSERT `s 745.6(3) the appropriate Chief Justice` `New Brunswick` EQUALS `s 745.6(3)(d) the Chief Justice of the Court of Queen's Bench`
#ASSERT `s 745.6(3) the appropriate Chief Justice` Manitoba EQUALS `s 745.6(3)(d) the Chief Justice of the Court of Queen's Bench`
#ASSERT `s 745.6(3) the appropriate Chief Justice` Saskatchewan EQUALS `s 745.6(3)(d) the Chief Justice of the Court of Queen's Bench`
#ASSERT `s 745.6(3) the appropriate Chief Justice` Alberta EQUALS `s 745.6(3)(d) the Chief Justice of the Court of Queen's Bench`
#ASSERT `s 745.6(3) the appropriate Chief Justice` `Nova Scotia` EQUALS `s 745.6(3)(e) the Chief Justice of the Supreme Court`
#ASSERT `s 745.6(3) the appropriate Chief Justice` `British Columbia` EQUALS `s 745.6(3)(e) the Chief Justice of the Supreme Court`
#ASSERT `s 745.6(3) the appropriate Chief Justice` `Prince Edward Island` EQUALS `s 745.6(3)(e) the Chief Justice of the Supreme Court`
#ASSERT `s 745.6(3) the appropriate Chief Justice` `Newfoundland and Labrador` EQUALS `s 745.6(3)(e) the Chief Justice of the Supreme Court`
#ASSERT `s 745.6(3) the appropriate Chief Justice` Yukon EQUALS `s 745.6(3)(f) the Chief Justice of the Court of Appeal`
#ASSERT `s 745.6(3) the appropriate Chief Justice` `Northwest Territories` EQUALS `s 745.6(3)(f) the Chief Justice of the Court of Appeal`
#ASSERT `s 745.6(3) the appropriate Chief Justice` Nunavut EQUALS `s 745.6(3)(f) the Chief Justice of the Court of Appeal`

§ `Tests -- section 745.61`

#ASSERT `s 745.61(1) the Chief Justice shall determine, on the basis of the material, whether the applicant has shown a substantial likelihood that the application will succeed` TRUE `s 745.61(1)(a) the application` EQUALS JUST TRUE
#ASSERT `s 745.61(1) the Chief Justice shall determine, on the basis of the material, whether the applicant has shown a substantial likelihood that the application will succeed` TRUE `s 745.61(1)(b) any report provided by the Correctional Service of Canada or other correctional authorities` EQUALS JUST TRUE
#ASSERT `s 745.61(1) the Chief Justice shall determine, on the basis of the material, whether the applicant has shown a substantial likelihood that the application will succeed` TRUE `s 745.61(1)(c) any other written evidence presented to the Chief Justice or judge by the applicant or the Attorney General` EQUALS JUST TRUE
#ASSERT `s 745.61(1) the Chief Justice shall determine, on the basis of the material, whether the applicant has shown a substantial likelihood that the application will succeed` TRUE `s 745.61(1) other material` EQUALS NOTHING
#ASSERT `s 745.61(1) the Chief Justice shall determine, on the basis of the material, whether the applicant has shown a substantial likelihood that the application will succeed` FALSE `s 745.61(1)(a) the application` EQUALS JUST FALSE   -- no application received
#ASSERT `s 745.61(2) the Chief Justice or judge shall consider the criterion` `s 745.63(1)(a) the character of the applicant` EQUALS JUST TRUE
#ASSERT `s 745.61(2) the Chief Justice or judge shall consider the criterion` `s 745.63(1)(e) any other matters that the judge considers relevant in the circumstances` EQUALS JUST TRUE
#ASSERT `s 745.61(2) the Chief Justice or judge shall consider the criterion` `s 745.63(1) another criterion` EQUALS NOTHING
-- (3)(a): args: determined that the applicant has not shown; the date of the determination; the time set
#ASSERT `s 745.61(3)(a) the Chief Justice or judge may set the time` TRUE (Date 1 6 2025) (Date 1 6 2030) EQUALS JUST TRUE   -- exactly five years after
#ASSERT `s 745.61(3)(a) the Chief Justice or judge may set the time` TRUE (Date 1 6 2025) (Date 31 5 2030) EQUALS NOTHING   -- earlier than five years: not covered
#ASSERT `s 745.61(3)(a) the Chief Justice or judge may set the time` TRUE (Date 1 6 2025) (Date 1 1 2040) EQUALS JUST TRUE
#ASSERT `s 745.61(3)(a) the Chief Justice or judge may set the time` FALSE (Date 1 6 2025) (Date 1 6 2030) EQUALS NOTHING   -- no determination that the applicant has not shown a substantial likelihood (F-2)
#ASSERT `s 745.61(3)(b) the Chief Justice or judge may decide that the applicant may not make another application` TRUE EQUALS JUST TRUE
#ASSERT `s 745.61(3)(b) the Chief Justice or judge may decide that the applicant may not make another application` FALSE EQUALS NOTHING
-- (4): args: determined not shown; set a time or decided; date of the determination; day
#ASSERT `s 745.61(4) the applicant may make another application on the day` TRUE FALSE (Date 1 6 2025) (Date 1 6 2030) EQUALS JUST TRUE
#ASSERT `s 745.61(4) the applicant may make another application on the day` TRUE FALSE (Date 1 6 2025) (Date 31 5 2030) EQUALS JUST FALSE   -- a day before the five years end
#ASSERT `s 745.61(4) the applicant may make another application on the day` TRUE TRUE (Date 1 6 2025) (Date 1 6 2030) EQUALS NOTHING   -- a time was set or a decision made: subsection (3) governs
#ASSERT `s 745.61(4) the applicant may make another application on the day` FALSE FALSE (Date 1 6 2025) (Date 1 6 2030) EQUALS NOTHING
#ASSERT `s 745.61(5) the Chief Justice shall designate a judge of the superior court of criminal jurisdiction to empanel a jury to hear the application` TRUE EQUALS JUST TRUE
#ASSERT `s 745.61(5) the Chief Justice shall designate a judge of the superior court of criminal jurisdiction to empanel a jury to hear the application` FALSE EQUALS JUST FALSE

§ `Tests -- section 745.62`

#ASSERT `s 745.62(1) the appellant may appeal to the Court of Appeal on any question of law or fact or mixed law and fact` `s 745.62(1) the applicant` TRUE EQUALS JUST TRUE
#ASSERT `s 745.62(1) the appellant may appeal to the Court of Appeal on any question of law or fact or mixed law and fact` `s 745.62(1) the Attorney General` TRUE EQUALS JUST TRUE
#ASSERT `s 745.62(1) the appellant may appeal to the Court of Appeal on any question of law or fact or mixed law and fact` `s 745.62(1) someone else` TRUE EQUALS NOTHING
#ASSERT `s 745.62(1) the appellant may appeal to the Court of Appeal on any question of law or fact or mixed law and fact` `s 745.62(1) the applicant` FALSE EQUALS NOTHING   -- not from a determination or decision under section 745.61
#ASSERT `s 745.62(2) the appeal is determined on the basis of the document` `s 745.62(2) a document presented to the Chief Justice or judge who made the determination or decision` EQUALS JUST TRUE
#ASSERT `s 745.62(2) the appeal is determined on the basis of the document` `s 745.62(2) any reasons for the determination or decision` EQUALS JUST TRUE
#ASSERT `s 745.62(2) the appeal is determined on the basis of the document` `s 745.62(2) any other document that the Court of Appeal requires` EQUALS JUST TRUE
#ASSERT `s 745.62(2) the appeal is determined on the basis of the document` `s 745.62(2) another document` EQUALS NOTHING
#ASSERT `s 745.62(3) the provision applies to the appeal, with such modifications as the circumstances require` (`Provision of the Code` OF 673, "") EQUALS JUST TRUE
#ASSERT `s 745.62(3) the provision applies to the appeal, with such modifications as the circumstances require` (`Provision of the Code` OF 696, "") EQUALS JUST TRUE
#ASSERT `s 745.62(3) the provision applies to the appeal, with such modifications as the circumstances require` (`Provision of the Code` OF 676.1, "") EQUALS JUST TRUE   -- a decimal section inside the range (F-10)
#ASSERT `s 745.62(3) the provision applies to the appeal, with such modifications as the circumstances require` (`Provision of the Code` OF 672, "") EQUALS NOTHING
#ASSERT `s 745.62(3) the provision applies to the appeal, with such modifications as the circumstances require` (`Provision of the Code` OF 696.1, "") EQUALS NOTHING   -- after section 696

§ `Tests -- section 745.63`

#ASSERT `s 745.63(1) the jury shall consider the criterion` `s 745.63(1)(a) the character of the applicant` EQUALS JUST TRUE
#ASSERT `s 745.63(1) the jury shall consider the criterion` `s 745.63(1)(b) the applicant's conduct while serving the sentence` EQUALS JUST TRUE
#ASSERT `s 745.63(1) the jury shall consider the criterion` `s 745.63(1)(c) the nature of the offence for which the applicant was convicted` EQUALS JUST TRUE
#ASSERT `s 745.63(1) the jury shall consider the criterion` `s 745.63(1)(d) any information provided by a victim at the time of the imposition of the sentence or at the time of the hearing` EQUALS JUST TRUE
#ASSERT `s 745.63(1) the jury shall consider the criterion` `s 745.63(1)(e) any other matters that the judge considers relevant in the circumstances` EQUALS JUST TRUE
#ASSERT `s 745.63(1) the jury shall consider the criterion` `s 745.63(1) another criterion` EQUALS NOTHING
-- (1)(d): the seams
#ASSERT `s 745.63(1)(d) the information is information provided by a victim` TRUE FALSE (JUST TRUE) NOTHING EQUALS JUST TRUE   -- the victim, as section 2 defines it for the purpose of section 745.63
#ASSERT `s 745.63(1)(d) the information is information provided by a victim` TRUE FALSE (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 745.63(1)(d) the information is information provided by a victim` TRUE FALSE NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 745.63(1)(d) the information is information provided by a victim` FALSE TRUE NOTHING (JUST TRUE) EQUALS JUST TRUE   -- an individual who may act on the victim's behalf, by section 2.2
#ASSERT `s 745.63(1)(d) the information is information provided by a victim` FALSE TRUE NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 745.63(1)(d) the information is information provided by a victim` FALSE FALSE (JUST TRUE) (JUST TRUE) EQUALS NOTHING   -- neither the victim nor someone acting on the victim's behalf
-- (1.1)
#ASSERT `s 745.63(1.1) the information may be provided in the manner` TRUE `s 745.63(1.1) orally` FALSE EQUALS JUST TRUE
#ASSERT `s 745.63(1.1) the information may be provided in the manner` TRUE `s 745.63(1.1) in writing` FALSE EQUALS JUST TRUE
#ASSERT `s 745.63(1.1) the information may be provided in the manner` TRUE `s 745.63(1.1) in another manner` TRUE EQUALS JUST TRUE   -- another manner the judge considers appropriate
#ASSERT `s 745.63(1.1) the information may be provided in the manner` TRUE `s 745.63(1.1) in another manner` FALSE EQUALS NOTHING
#ASSERT `s 745.63(1.1) the information may be provided in the manner` FALSE `s 745.63(1.1) orally` FALSE EQUALS NOTHING   -- not information of a victim referred to in paragraph (1)(d)
-- (3): unanimous
#ASSERT `s 745.63(3) the determination to reduce the number of years is made by the vote the subsection requires` 12 12 EQUALS JUST TRUE
#ASSERT `s 745.63(3) the determination to reduce the number of years is made by the vote the subsection requires` 11 12 EQUALS JUST FALSE   -- "must be by unanimous vote"
-- (4)
#ASSERT `s 745.63(4) the applicant's number of years of imprisonment without eligibility for parole is not reduced` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 745.63(4) the applicant's number of years of imprisonment without eligibility for parole is not reduced` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 745.63(4) the applicant's number of years of imprisonment without eligibility for parole is not reduced` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 745.63(4) the applicant's number of years of imprisonment without eligibility for parole is not reduced` FALSE FALSE FALSE EQUALS JUST FALSE
-- (5): args: the jury determines it ought to be reduced; votes in favour; members; the action
#ASSERT `s 745.63(5) the jury may take the action` TRUE 8 12 `s 745.63(5)(a) substitute a lesser number of years of imprisonment without eligibility for parole than that then applicable` EQUALS JUST TRUE   -- eight of twelve is exactly two thirds
#ASSERT `s 745.63(5) the jury may take the action` TRUE 7 12 `s 745.63(5)(a) substitute a lesser number of years of imprisonment without eligibility for parole than that then applicable` EQUALS NOTHING   -- seven of twelve is less than two thirds
#ASSERT `s 745.63(5) the jury may take the action` TRUE 12 12 `s 745.63(5)(b) terminate the ineligibility for parole` EQUALS JUST TRUE
#ASSERT `s 745.63(5) the jury may take the action` TRUE 8 12 `s 745.63(5) another action` EQUALS NOTHING
#ASSERT `s 745.63(5) the jury may take the action` FALSE 12 12 `s 745.63(5)(b) terminate the ineligibility for parole` EQUALS NOTHING   -- the jury did not determine that the number of years ought to be reduced
-- (6): args: not reduced; the date of the determination or conclusion; the time set
#ASSERT `s 745.63(6)(a) the jury may set the time` TRUE (Date 1 6 2025) (Date 1 6 2030) EQUALS JUST TRUE
#ASSERT `s 745.63(6)(a) the jury may set the time` TRUE (Date 1 6 2025) (Date 31 5 2030) EQUALS NOTHING
#ASSERT `s 745.63(6)(a) the jury may set the time` FALSE (Date 1 6 2025) (Date 1 6 2030) EQUALS NOTHING
#ASSERT `s 745.63(6)(b) the jury may decide that the applicant may not make another application` TRUE EQUALS JUST TRUE
#ASSERT `s 745.63(6)(b) the jury may decide that the applicant may not make another application` FALSE EQUALS NOTHING
-- (7)
#ASSERT `s 745.63(7) the decision of the jury under paragraph (6)(a) or (b) is made by the vote the subsection requires` 8 12 EQUALS JUST TRUE
#ASSERT `s 745.63(7) the decision of the jury under paragraph (6)(a) or (b) is made by the vote the subsection requires` 7 12 EQUALS JUST FALSE   -- "must be made by not less than two thirds"
#ASSERT `s 745.63(7) the decision of the jury under paragraph (6)(a) or (b) is made by the vote the subsection requires` 12 12 EQUALS JUST TRUE
-- (8): args: the jury sets a date or decides; the date of the determination or conclusion; the day
#ASSERT `s 745.63(8) the applicant may make another application on the day` FALSE (Date 1 6 2025) (Date 1 6 2030) EQUALS JUST TRUE
#ASSERT `s 745.63(8) the applicant may make another application on the day` FALSE (Date 1 6 2025) (Date 31 5 2030) EQUALS JUST FALSE
#ASSERT `s 745.63(8) the applicant may make another application on the day` TRUE (Date 1 6 2025) (Date 1 6 2030) EQUALS NOTHING   -- the jury did set a date or decide: subsection (6) governs

§ `Tests -- section 745.64`

-- args: the Chief Justice is designating a judge for a screening or to empanel a jury; the province or territory of the conviction; the court
#ASSERT `s 745.64(2) the appropriate Chief Justice may designate the judge from the court` TRUE Yukon `s 745.64(2) the Court of Appeal of Yukon` EQUALS JUST TRUE
#ASSERT `s 745.64(2) the appropriate Chief Justice may designate the judge from the court` TRUE Yukon `s 745.64(2) the Supreme Court of Yukon` EQUALS JUST TRUE
#ASSERT `s 745.64(2) the appropriate Chief Justice may designate the judge from the court` TRUE `Northwest Territories` `s 745.64(2) the Court of Appeal of the Northwest Territories` EQUALS JUST TRUE
#ASSERT `s 745.64(2) the appropriate Chief Justice may designate the judge from the court` TRUE `Northwest Territories` `s 745.64(2) the Supreme Court of the Northwest Territories` EQUALS JUST TRUE
#ASSERT `s 745.64(2) the appropriate Chief Justice may designate the judge from the court` TRUE Nunavut `s 745.64(2) the Court of Appeal of Nunavut` EQUALS JUST TRUE
#ASSERT `s 745.64(2) the appropriate Chief Justice may designate the judge from the court` TRUE Nunavut `s 745.64(2) the Nunavut Court of Justice` EQUALS JUST TRUE
#ASSERT `s 745.64(2) the appropriate Chief Justice may designate the judge from the court` TRUE Yukon `s 745.64(2) the Nunavut Court of Justice` EQUALS NOTHING   -- a Nunavut court for a Yukon conviction: "as the case may be"
#ASSERT `s 745.64(2) the appropriate Chief Justice may designate the judge from the court` TRUE Nunavut `s 745.64(2) the Supreme Court of Yukon` EQUALS NOTHING
#ASSERT `s 745.64(2) the appropriate Chief Justice may designate the judge from the court` TRUE Yukon `s 745.64(2) another court` EQUALS NOTHING
#ASSERT `s 745.64(2) the appropriate Chief Justice may designate the judge from the court` TRUE Ontario `s 745.64(2) the Court of Appeal of Yukon` EQUALS JUST FALSE   -- a conviction in Ontario: not "in respect of a conviction that took place in Yukon, the Northwest Territories or Nunavut"
#ASSERT `s 745.64(2) the appropriate Chief Justice may designate the judge from the court` FALSE Yukon `s 745.64(2) the Court of Appeal of Yukon` EQUALS JUST FALSE   -- the Chief Justice is not designating for a screening or to empanel a jury
