IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc5-s118-to-130-1`

-- Tests for ccc5-s118-to-130-1.l4. Every expected value was decided from the text before the run; a failing assertion is a finding.

-- s 118 evidence or statement: expected values follow the text (s 118 "evidence or statement")
#ASSERT `s 118 evidence or statement` TRUE FALSE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 118 evidence or statement` FALSE FALSE FALSE EQUALS JUST FALSE   -- element missing: the thing is an assertion of fact, opinion, belief or knowledge
#ASSERT `s 118 evidence or statement` TRUE TRUE FALSE EQUALS JUST TRUE   -- "whether or not": the assertion is material present does not change the answer
#ASSERT `s 118 evidence or statement` TRUE FALSE FALSE EQUALS JUST TRUE   -- "whether or not": the assertion is material absent does not change the answer
#ASSERT `s 118 evidence or statement` TRUE FALSE TRUE EQUALS JUST TRUE   -- "whether or not": the assertion is admissible present does not change the answer
#ASSERT `s 118 evidence or statement` TRUE FALSE FALSE EQUALS JUST TRUE   -- "whether or not": the assertion is admissible absent does not change the answer


#ASSERT `s 118 government` `s 118(a) the Government of Canada` EQUALS JUST TRUE
#ASSERT `s 118 government` `s 118(b) the government of a province` EQUALS JUST TRUE
#ASSERT `s 118 government` `s 118(c) Her Majesty in right of Canada or a province` EQUALS JUST TRUE
#ASSERT `s 118 government` `s 118 a body not named in the definition of government` EQUALS JUST FALSE   -- "means": a closed list


#ASSERT `s 118 judicial proceeding` `s 118(a) in or under the authority of a court of justice` FALSE EQUALS JUST TRUE
#ASSERT `s 118 judicial proceeding` `s 118(a) in or under the authority of a court of justice` TRUE EQUALS JUST TRUE   -- "whether or not the proceeding is invalid"
#ASSERT `s 118 judicial proceeding` `s 118(b) before the Senate or House of Commons or a committee of either, or before a legislative council, legislative assembly or house of assembly or a committee of it authorized by law to administer an oath` FALSE EQUALS JUST TRUE
#ASSERT `s 118 judicial proceeding` `s 118(c) before a court, judge, justice, provincial court judge or coroner` FALSE EQUALS JUST TRUE
#ASSERT `s 118 judicial proceeding` `s 118(d) before an arbitrator or umpire, or a person or body of persons authorized by law to make an inquiry and take evidence therein under oath` FALSE EQUALS JUST TRUE
#ASSERT `s 118 judicial proceeding` `s 118(e) before a tribunal by which a legal right or legal liability may be established` TRUE EQUALS JUST TRUE
#ASSERT `s 118 judicial proceeding` `s 118 before none of those` FALSE EQUALS JUST FALSE


#ASSERT `s 118 office` `s 118(a) an office or appointment under the government` EQUALS JUST TRUE
#ASSERT `s 118 office` `s 118(b) a civil or military commission` EQUALS JUST TRUE
#ASSERT `s 118 office` `s 118(c) a position or an employment in a public department` EQUALS JUST TRUE
#ASSERT `s 118 office` `s 118 a position that is none of those` EQUALS NOTHING   -- "includes" does not close the list


#ASSERT `s 118 official` (JUST TRUE) FALSE EQUALS JUST TRUE   -- (a) holds an office
#ASSERT `s 118 official` (JUST FALSE) TRUE EQUALS JUST TRUE   -- (b) appointed or elected to discharge a public duty
#ASSERT `s 118 official` NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 118 official` (JUST FALSE) FALSE EQUALS JUST FALSE   -- "means a person who": neither limb
#ASSERT `s 118 official` NOTHING FALSE EQUALS NOTHING   -- what the person holds is not settled by "includes"


#ASSERT `s 118 witness` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- sworn, in a judicial proceeding
#ASSERT `s 118 witness` TRUE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE   -- "whether or not he is competent to be a witness"
#ASSERT `s 118 witness` FALSE (JUST TRUE) TRUE FALSE EQUALS JUST TRUE   -- the child of tender years, not sworn
#ASSERT `s 118 witness` FALSE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE   -- neither limb
#ASSERT `s 118 witness` TRUE (JUST FALSE) FALSE TRUE EQUALS JUST FALSE   -- not in a judicial proceeding
#ASSERT `s 118 witness` TRUE NOTHING FALSE TRUE EQUALS NOTHING   -- the proceeding is not settled

-- s 119(1)(a) the holder of a judicial office or legislator corruptly accepts or obtains a benefit: expected values follow the text (s 119(1)(a))
#ASSERT `s 119(1)(a) the holder of a judicial office or legislator corruptly accepts or obtains a benefit` TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 119(1)(a) the holder of a judicial office or legislator corruptly accepts or obtains a benefit` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- element missing: the person is the holder of a judicial office, or a member of Parliament or of the legislature of a province
#ASSERT `s 119(1)(a) the holder of a judicial office or legislator corruptly accepts or obtains a benefit` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- element missing: the person directly or indirectly accepts, obtains, agrees to accept or attempts to obtain, for themselves or another person, money, valuable consideration, office, place or employment
#ASSERT `s 119(1)(a) the holder of a judicial office or legislator corruptly accepts or obtains a benefit` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- element missing: the person acts corruptly
#ASSERT `s 119(1)(a) the holder of a judicial office or legislator corruptly accepts or obtains a benefit` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- element missing: the benefit is in respect of anything done or omitted or to be done or omitted by the person in their official capacity

-- s 119(1)(b) the person corruptly gives or offers a benefit to a judicial officer or legislator: expected values follow the text (s 119(1)(b))
#ASSERT `s 119(1)(b) the person corruptly gives or offers a benefit to a judicial officer or legislator` TRUE TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 119(1)(b) the person corruptly gives or offers a benefit to a judicial officer or legislator` FALSE TRUE TRUE EQUALS NOTHING   -- element missing: the person directly or indirectly gives or offers money, valuable consideration, office, place or employment to a person mentioned in paragraph (a), or to anyone for the benefit of that person
#ASSERT `s 119(1)(b) the person corruptly gives or offers a benefit to a judicial officer or legislator` TRUE FALSE TRUE EQUALS NOTHING   -- element missing: the person acts corruptly
#ASSERT `s 119(1)(b) the person corruptly gives or offers a benefit to a judicial officer or legislator` TRUE TRUE FALSE EQUALS NOTHING   -- element missing: the gift or offer is in respect of anything done or omitted or to be done or omitted by that person in their official capacity

#ASSERT `s 119(1) the person is guilty of an indictable offence under subsection (1)` NOTHING NOTHING EQUALS NOTHING   -- no limb is made out
#ASSERT `s 119(1) the person is guilty of an indictable offence under subsection (1)` (JUST FALSE) (JUST FALSE) EQUALS NOTHING   -- a limb answered JUST FALSE is not a made-out limb
#ASSERT `s 119(1) the person is guilty of an indictable offence under subsection (1)` (JUST TRUE) NOTHING EQUALS JUST TRUE   -- limb s 119(1)(a) made out
#ASSERT `s 119(1) the person is guilty of an indictable offence under subsection (1)` NOTHING (JUST TRUE) EQUALS JUST TRUE   -- limb s 119(1)(b) made out

#ASSERT `s 119(1) the class of the offence` EQUALS `an indictable offence`

#ASSERT `s 119(1) the punishment on indictment`'s `mode` EQUALS `by indictment`
#ASSERT `s 119(1) the punishment on indictment`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `fourteen years`
#ASSERT `s 119(1) the punishment on indictment`'s `minimum imprisonment` EQUALS `no imprisonment is stated`
#ASSERT `s 119(1) the punishment on indictment`'s `maximum fine` EQUALS `no fine is stated`

-- s 119(2) the proceedings against a holder of a judicial office are barred for want of the written consent of the Attorney General of Canada: expected values follow the text (s 119(2))
#ASSERT `s 119(2) the proceedings against a holder of a judicial office are barred for want of the written consent of the Attorney General of Canada` TRUE TRUE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 119(2) the proceedings against a holder of a judicial office are barred for want of the written consent of the Attorney General of Canada` FALSE TRUE FALSE EQUALS NOTHING   -- element missing: the proceedings are instituted under section 119
#ASSERT `s 119(2) the proceedings against a holder of a judicial office are barred for want of the written consent of the Attorney General of Canada` TRUE FALSE FALSE EQUALS NOTHING   -- element missing: the person against whom they are instituted holds a judicial office
#ASSERT `s 119(2) the proceedings against a holder of a judicial office are barred for want of the written consent of the Attorney General of Canada` TRUE TRUE TRUE EQUALS JUST FALSE   -- exception: the Attorney General of Canada has consented in writing

-- s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent: expected values follow the text (s 120(a))
#ASSERT `s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent` (JUST TRUE) NOTHING NOTHING FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent` NOTHING NOTHING NOTHING FALSE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: s 2 justice: the person is one / s 2 peace officer: the person is one / s 2 public officer: the person is one / the person is a police commissioner or an officer of a juvenile court, or is employed in the administration of criminal law
#ASSERT `s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent` (JUST TRUE) NOTHING NOTHING FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: s 2 justice: the person is one
#ASSERT `s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent` NOTHING (JUST TRUE) NOTHING FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: s 2 peace officer: the person is one
#ASSERT `s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent` NOTHING NOTHING (JUST TRUE) FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: s 2 public officer: the person is one
#ASSERT `s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent` NOTHING NOTHING NOTHING TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the person is a police commissioner or an officer of a juvenile court, or is employed in the administration of criminal law
#ASSERT `s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent` (JUST TRUE) NOTHING NOTHING FALSE FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: the person directly or indirectly accepts, obtains, agrees to accept or attempts to obtain, for themselves or another person, money, valuable consideration, office, place or employment
#ASSERT `s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent` (JUST TRUE) NOTHING NOTHING FALSE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: the person acts corruptly
#ASSERT `s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent` (JUST TRUE) NOTHING NOTHING FALSE TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING   -- element missing: the person acts with intent to interfere with the administration of justice / the person acts with intent to procure or facilitate the commission of an offence / the person acts with intent to protect from detection or punishment a person who has committed or who intends to commit an offence
#ASSERT `s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent` (JUST TRUE) NOTHING NOTHING FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the person acts with intent to interfere with the administration of justice
#ASSERT `s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent` (JUST TRUE) NOTHING NOTHING FALSE TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- alternative present: the person acts with intent to procure or facilitate the commission of an offence
#ASSERT `s 120(a) the officer or person employed in the administration of criminal law corruptly accepts or obtains a benefit with a stated intent` (JUST TRUE) NOTHING NOTHING FALSE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- alternative present: the person acts with intent to protect from detection or punishment a person who has committed or who intends to commit an offence

-- s 120(b) the person corruptly gives or offers a benefit to an officer with a stated intent: expected values follow the text (s 120(b))
#ASSERT `s 120(b) the person corruptly gives or offers a benefit to an officer with a stated intent` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 120(b) the person corruptly gives or offers a benefit to an officer with a stated intent` FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: the person directly or indirectly gives or offers money, valuable consideration, office, place or employment to a person mentioned in paragraph (a), or to anyone for the benefit of that person
#ASSERT `s 120(b) the person corruptly gives or offers a benefit to an officer with a stated intent` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: the person acts corruptly
#ASSERT `s 120(b) the person corruptly gives or offers a benefit to an officer with a stated intent` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING   -- element missing: the person acts with intent that the officer should interfere with the administration of justice / the person acts with intent that the officer should procure or facilitate the commission of an offence / the person acts with intent that the officer should protect from detection or punishment a person who has committed or who intends to commit an offence
#ASSERT `s 120(b) the person corruptly gives or offers a benefit to an officer with a stated intent` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the person acts with intent that the officer should interfere with the administration of justice
#ASSERT `s 120(b) the person corruptly gives or offers a benefit to an officer with a stated intent` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- alternative present: the person acts with intent that the officer should procure or facilitate the commission of an offence
#ASSERT `s 120(b) the person corruptly gives or offers a benefit to an officer with a stated intent` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- alternative present: the person acts with intent that the officer should protect from detection or punishment a person who has committed or who intends to commit an offence

#ASSERT `s 120 the person is guilty of an indictable offence under section 120` NOTHING NOTHING EQUALS NOTHING   -- no limb is made out
#ASSERT `s 120 the person is guilty of an indictable offence under section 120` (JUST FALSE) (JUST FALSE) EQUALS NOTHING   -- a limb answered JUST FALSE is not a made-out limb
#ASSERT `s 120 the person is guilty of an indictable offence under section 120` (JUST TRUE) NOTHING EQUALS JUST TRUE   -- limb s 120(a) made out
#ASSERT `s 120 the person is guilty of an indictable offence under section 120` NOTHING (JUST TRUE) EQUALS JUST TRUE   -- limb s 120(b) made out

#ASSERT `s 120 the class of the offence` EQUALS `an indictable offence`

#ASSERT `s 120 the punishment on indictment`'s `mode` EQUALS `by indictment`
#ASSERT `s 120 the punishment on indictment`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `fourteen years`
#ASSERT `s 120 the punishment on indictment`'s `minimum imprisonment` EQUALS `no imprisonment is stated`
#ASSERT `s 120 the punishment on indictment`'s `maximum fine` EQUALS `no fine is stated`

-- s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business: expected values follow the text (s 121(1)(a))
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` (JUST TRUE) TRUE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` NOTHING TRUE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: s 118 official: the person is one
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` (JUST TRUE) FALSE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: the person directly or indirectly gives, offers or agrees to give or offer to an official or to a member of an official's family, or to anyone for the benefit of an official / the person, being an official, directly or indirectly demands, accepts or offers or agrees to accept from any person for themselves or another person
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` (JUST TRUE) TRUE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the person directly or indirectly gives, offers or agrees to give or offer to an official or to a member of an official's family, or to anyone for the benefit of an official
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` (JUST TRUE) FALSE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the person, being an official, directly or indirectly demands, accepts or offers or agrees to accept from any person for themselves or another person
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` (JUST TRUE) TRUE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: what is given or received is a loan, reward, advantage or benefit of any kind
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` (JUST TRUE) TRUE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: it is given or received as consideration for cooperation, assistance, exercise of influence or an act or omission
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` (JUST TRUE) TRUE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING   -- element missing: in connection with the transaction of business with, or any matter of business relating to, the government / in connection with a claim against Her Majesty or any benefit that Her Majesty is authorized or is entitled to bestow
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` (JUST TRUE) TRUE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: in connection with the transaction of business with, or any matter of business relating to, the government
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` (JUST TRUE) TRUE FALSE TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- alternative present: in connection with a claim against Her Majesty or any benefit that Her Majesty is authorized or is entitled to bestow
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` (JUST FALSE) TRUE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING   -- s 118 official: the person is one: the other way it can fail ((JUST FALSE))
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` (JUST TRUE) TRUE FALSE TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE   -- "whether or not": the official is in fact able to cooperate, render assistance, exercise influence or do or omit to do what is proposed present does not change the answer
#ASSERT `s 121(1)(a) the person gives to an official, or an official takes, a benefit for cooperation or influence in government business` (JUST TRUE) TRUE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- "whether or not": the official is in fact able to cooperate, render assistance, exercise influence or do or omit to do what is proposed absent does not change the answer

-- s 121(1)(b) the person having dealings with the government pays or confers a benefit on its employee or official without written consent: expected values follow the text (s 121(1)(b))
#ASSERT `s 121(1)(b) the person having dealings with the government pays or confers a benefit on its employee or official without written consent` TRUE TRUE TRUE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 121(1)(b) the person having dealings with the government pays or confers a benefit on its employee or official without written consent` FALSE TRUE TRUE FALSE EQUALS NOTHING   -- element missing: the person has dealings of any kind with the government, directly or indirectly
#ASSERT `s 121(1)(b) the person having dealings with the government pays or confers a benefit on its employee or official without written consent` TRUE FALSE TRUE FALSE EQUALS NOTHING   -- element missing: the person pays a commission or reward to, or confers an advantage or benefit of any kind on, an employee or official of the government with which the dealings take place, or a member of that person's family, or anyone for that person's benefit
#ASSERT `s 121(1)(b) the person having dealings with the government pays or confers a benefit on its employee or official without written consent` TRUE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: it is with respect to those dealings
#ASSERT `s 121(1)(b) the person having dealings with the government pays or confers a benefit on its employee or official without written consent` TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- exception: the person has the consent in writing of the head of the branch of government with which the dealings take place

-- s 121(1)(c) the official or employee of the government takes a benefit from a person dealing with it without written consent: expected values follow the text (s 121(1)(c))
#ASSERT `s 121(1)(c) the official or employee of the government takes a benefit from a person dealing with it without written consent` TRUE TRUE TRUE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 121(1)(c) the official or employee of the government takes a benefit from a person dealing with it without written consent` FALSE TRUE TRUE FALSE EQUALS NOTHING   -- element missing: the person is an official or employee of the government
#ASSERT `s 121(1)(c) the official or employee of the government takes a benefit from a person dealing with it without written consent` TRUE FALSE TRUE FALSE EQUALS NOTHING   -- element missing: the person directly or indirectly demands, accepts or offers or agrees to accept a commission, reward, advantage or benefit of any kind for themselves or another person
#ASSERT `s 121(1)(c) the official or employee of the government takes a benefit from a person dealing with it without written consent` TRUE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: it is from a person who has dealings with the government
#ASSERT `s 121(1)(c) the official or employee of the government takes a benefit from a person dealing with it without written consent` TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- exception: the person has the consent in writing of the head of the branch of government that employs them or of which they are an official

-- s 121(1)(d) the person with, or pretending to have, influence demands or accepts a reward for it: expected values follow the text (s 121(1)(d))
#ASSERT `s 121(1)(d) the person with, or pretending to have, influence demands or accepts a reward for it` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 121(1)(d) the person with, or pretending to have, influence demands or accepts a reward for it` FALSE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: the person has, or pretends to have, influence with the government, a minister of the government or an official
#ASSERT `s 121(1)(d) the person with, or pretending to have, influence demands or accepts a reward for it` TRUE FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: the person directly or indirectly demands, accepts, or offers or agrees to accept, for themselves or another person, a reward, advantage or benefit of any kind
#ASSERT `s 121(1)(d) the person with, or pretending to have, influence demands or accepts a reward for it` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: it is as consideration for cooperation, assistance, exercise of influence or an act or omission
#ASSERT `s 121(1)(d) the person with, or pretending to have, influence demands or accepts a reward for it` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING   -- element missing: in connection with the transaction of business with, or any matter of business relating to, the government / in connection with a claim against Her Majesty or any benefit that Her Majesty is authorized or is entitled to bestow / in connection with the appointment of any person, including themselves, to an office
#ASSERT `s 121(1)(d) the person with, or pretending to have, influence demands or accepts a reward for it` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: in connection with the transaction of business with, or any matter of business relating to, the government
#ASSERT `s 121(1)(d) the person with, or pretending to have, influence demands or accepts a reward for it` TRUE TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- alternative present: in connection with a claim against Her Majesty or any benefit that Her Majesty is authorized or is entitled to bestow
#ASSERT `s 121(1)(d) the person with, or pretending to have, influence demands or accepts a reward for it` TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- alternative present: in connection with the appointment of any person, including themselves, to an office

-- s 121(1)(e) the person gives or offers a reward to a minister or an official for cooperation or influence: expected values follow the text (s 121(1)(e))
#ASSERT `s 121(1)(e) the person gives or offers a reward to a minister or an official for cooperation or influence` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 121(1)(e) the person gives or offers a reward to a minister or an official for cooperation or influence` FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING   -- element missing: the person directly or indirectly gives or offers, or agrees to give or offer, to a minister of the government or an official, or to anyone for the benefit of a minister or an official, a reward, advantage or benefit of any kind
