IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc-definitions`
IMPORT `ccc20-part16-taking-before-justice`

-- ccc20-tests-taking-before-justice.l4 -- tests for ccc20-part16-taking-before-justice.l4 (s 503). Expected values are hand-written from the text of lines 11201-11229.

§ `Tests -- section 503(1): taking before a justice`
-- args: the peace officer arrested the person (with or without warrant); has released the person under another provision or s 705.1
#ASSERT `s 503(1) the peace officer must cause the person to be taken before a justice` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 503(1) the peace officer must cause the person to be taken before a justice` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 503(1) the peace officer must cause the person to be taken before a justice` TRUE TRUE EQUALS JUST FALSE
-- timing. args: a justice is available within 24 hours of the arrest; hours until the person was taken before a justice; without unreasonable delay; as soon as possible
#ASSERT `s 503(1) the person was taken before a justice as paragraph (a) or (b) requires` TRUE 10 TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 503(1) the person was taken before a justice as paragraph (a) or (b) requires` TRUE 24 TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 503(1) the person was taken before a justice as paragraph (a) or (b) requires` TRUE 23.99 TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 503(1) the person was taken before a justice as paragraph (a) or (b) requires` TRUE 24.5 TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 503(1) the person was taken before a justice as paragraph (a) or (b) requires` TRUE 10 FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 503(1) the person was taken before a justice as paragraph (a) or (b) requires` TRUE 25 FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 503(1) the person was taken before a justice as paragraph (a) or (b) requires` FALSE 30 FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 503(1) the person was taken before a justice as paragraph (a) or (b) requires` FALSE 30 FALSE FALSE EQUALS JUST FALSE
-- the duty as a regulative rule (a DEONTIC cannot be compared in #ASSERT on the stable binary; these are traces): taken in time (FULFILLED), 25 hours pass (BREACH), no justice available, duty not arising
#TRACE `s 503(1) the duty to take the person before a justice` (JUST TRUE) TRUE AT 0 WITH
    PARTY `a peace officer` DOES `s 503(1) take the person before a justice` AT 20
#TRACE `s 503(1) the duty to take the person before a justice` (JUST TRUE) TRUE AT 0 WITH
    (WAITUNTIL 25)
#TRACE `s 503(1) the duty to take the person before a justice` (JUST TRUE) FALSE AT 0 WITH
    PARTY `a peace officer` DOES `s 503(1) take the person before a justice` AT 40
#TRACE `s 503(1) the duty to take the person before a justice` (JUST FALSE) TRUE AT 0 WITH
#ASSERT `s 503(1) the person was taken before a justice within the meaning of section 2` `a justice of the peace` EQUALS JUST TRUE
#ASSERT `s 503(1) the person was taken before a justice within the meaning of section 2` `a judicial officer who is none of those` EQUALS JUST FALSE

§ `Tests -- section 503(1.1) and (2)`
-- (1.1) args: before the expiry of the time; the officer is satisfied continued detention is no longer necessary; s 469 listing; issues an appearance notice; the person gives an undertaking
#ASSERT `s 503(1.1) the peace officer must release the person` TRUE TRUE (JUST FALSE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 503(1.1) the peace officer must release the person` TRUE TRUE (JUST FALSE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 503(1.1) the peace officer must release the person` TRUE TRUE (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 503(1.1) the peace officer must release the person` FALSE TRUE (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 503(1.1) the peace officer must release the person` TRUE FALSE (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 503(1.1) the peace officer must release the person` TRUE TRUE (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 503(1.1) the peace officer must release the person` TRUE TRUE NOTHING TRUE FALSE EQUALS NOTHING
-- (2) the 24 hours begin after delivery for a person delivered under 494(3) or placed in custody under the Customs Act; args: delivered, hours since the arrest, hours since delivery
#ASSERT `s 503(2) the hours that run against the 24-hour period` TRUE 30 5 EQUALS 5
#ASSERT `s 503(2) the hours that run against the 24-hour period` FALSE 30 5 EQUALS 30

§ `Tests -- section 503(3) and (3.1)`
-- (3) args (record): arrested without warrant for an indictable offence alleged outside the territorial division; the offence alleged within the province of arrest; taken before a justice of the place of the offence
#ASSERT `s 503(3) the person must, within the time prescribed in paragraph (1)(a) or (b), be taken before a justice within whose jurisdiction the person was arrested` (`s 503(3) the case` OF FALSE, FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 503(3) the person must, within the time prescribed in paragraph (1)(a) or (b), be taken before a justice within whose jurisdiction the person was arrested` (`s 503(3) the case` OF TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 503(3) the person must, within the time prescribed in paragraph (1)(a) or (b), be taken before a justice within whose jurisdiction the person was arrested` (`s 503(3) the case` OF TRUE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 503(3) the person must, within the time prescribed in paragraph (1)(a) or (b), be taken before a justice within whose jurisdiction the person was arrested` (`s 503(3) the case` OF TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 503(3) the person must, within the time prescribed in paragraph (1)(a) or (b), be taken before a justice within whose jurisdiction the person was arrested` (`s 503(3) the case` OF TRUE, FALSE, TRUE) EQUALS JUST TRUE
#ASSERT `s 503(3)(a) the justice must release the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 503(3)(a) the justice must release the person` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 503(3)(a) the justice must release the person` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 503(3)(b) the justice may take that step` TRUE TRUE FALSE `s 503(3)(b)(i) remand the person to the custody of a peace officer to await execution of a warrant in accordance with section 528` EQUALS JUST TRUE
#ASSERT `s 503(3)(b) the justice may take that step` TRUE TRUE TRUE `s 503(3)(b)(ii) order the person to be taken before a justice having jurisdiction with respect to the offence` EQUALS JUST TRUE
#ASSERT `s 503(3)(b) the justice may take that step` TRUE TRUE FALSE `s 503(3)(b)(ii) order the person to be taken before a justice having jurisdiction with respect to the offence` EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `s 503(3)(b) the justice may take that step` TRUE TRUE FALSE `s 503(3)(b)(ii) order the person to be taken before a justice having jurisdiction with respect to the offence` EQUALS NOTHING; the "where" gate on a "may" is the periods ruling (b): the function now answers the guide's JUST FALSE (the other reading is NOTHING, listed in the name-test sweep)
#ASSERT `s 503(3)(b) the justice may take that step` TRUE FALSE TRUE `s 503(3)(b)(i) remand the person to the custody of a peace officer to await execution of a warrant in accordance with section 528` EQUALS NOTHING
#ASSERT `s 503(3)(b) the justice may take that step` FALSE TRUE TRUE `s 503(3)(b)(i) remand the person to the custody of a peace officer to await execution of a warrant in accordance with section 528` EQUALS NOTHING
-- (3)(b)(i) six days: args remanded under (3)(b)(i); a warrant was executed within six days; days since the remand
#ASSERT `s 503(3)(b)(i) the person in whose custody the person then is must release them` TRUE FALSE 6 EQUALS JUST TRUE
#ASSERT `s 503(3)(b)(i) the person in whose custody the person then is must release them` TRUE FALSE 7 EQUALS JUST TRUE
#ASSERT `s 503(3)(b)(i) the person in whose custody the person then is must release them` TRUE FALSE 5.99 EQUALS JUST FALSE
#ASSERT `s 503(3)(b)(i) the person in whose custody the person then is must release them` TRUE TRUE 7 EQUALS JUST FALSE
#ASSERT `s 503(3)(b)(i) the person in whose custody the person then is must release them` FALSE FALSE 7 EQUALS JUST FALSE
-- (3.1) args: the person is one referred to in (3); the prosecutor consents; the release ordered; the conditions are within 515(2)(a) to (e), desirable and consented to
#ASSERT `s 503(3.1) the justice may order the person released` TRUE TRUE `s 503(3.1)(a) released without conditions` FALSE EQUALS JUST TRUE
#ASSERT `s 503(3.1) the justice may order the person released` TRUE TRUE `s 503(3.1)(b) released on the terms of a release order containing conditions referred to in paragraphs 515(2)(a) to (e) that the justice considers desirable and to which the prosecutor consents` TRUE EQUALS JUST TRUE
#ASSERT `s 503(3.1) the justice may order the person released` TRUE TRUE `s 503(3.1)(b) released on the terms of a release order containing conditions referred to in paragraphs 515(2)(a) to (e) that the justice considers desirable and to which the prosecutor consents` FALSE EQUALS NOTHING
#ASSERT `s 503(3.1) the justice may order the person released` TRUE FALSE `s 503(3.1)(a) released without conditions` FALSE EQUALS NOTHING
#ASSERT `s 503(3.1) the justice may order the person released` FALSE TRUE `s 503(3.1)(a) released without conditions` FALSE EQUALS NOTHING

§ `Tests -- section 503(4) and (5)`
#ASSERT `s 503(4) the peace officer must release the person as soon as practicable` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 503(4) the peace officer must release the person as soon as practicable` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 503(4) the peace officer must release the person as soon as practicable` FALSE TRUE EQUALS JUST FALSE
-- (5) args: the officer has custody of a person referred to in (4) and did not release before the expiry; proceedings under an Act of Parliament; alleged and established non-compliance with (4)
#ASSERT `s 503(5) the peace officer is deemed to be acting lawfully and in the execution of the peace officer's duty` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 503(5) the peace officer is deemed to be acting lawfully and in the execution of the peace officer's duty` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 503(5) the peace officer is deemed to be acting lawfully and in the execution of the peace officer's duty` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 503(5) the peace officer is deemed to be acting lawfully and in the execution of the peace officer's duty` TRUE FALSE FALSE EQUALS JUST TRUE
