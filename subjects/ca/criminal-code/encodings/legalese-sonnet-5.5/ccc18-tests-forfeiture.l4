#ASSERT `s 490.5(1) the person may apply for an order under subsection (4)` `s 490.5(1) an order under subsection 490.2(2)` TRUE TRUE FALSE FALSE (Date 1 3 2020) (Date 10 3 2020) TRUE EQUALS JUST TRUE   -- (a) is the exclusion for 490.1(1) only
#ASSERT `s 490.5(1) the person may apply for an order under subsection (4)` `s 490.5(1) an order under subsection 490.2(2)` TRUE FALSE TRUE FALSE (Date 1 3 2020) (Date 10 3 2020) TRUE EQUALS JUST FALSE   -- (b) charged: excluded for an order under 490.2(2)
#ASSERT `s 490.5(1) the person may apply for an order under subsection (4)` `s 490.5(1) an order under subsection 490.1(1)` TRUE FALSE TRUE FALSE (Date 1 3 2020) (Date 10 3 2020) TRUE EQUALS JUST TRUE   -- (b) is the exclusion for 490.2(2) only
#ASSERT `s 490.5(1) the person may apply for an order under subsection (4)` `s 490.5(1) an order under subsection 490.1(1)` TRUE FALSE FALSE TRUE (Date 1 3 2020) (Date 10 3 2020) TRUE EQUALS JUST FALSE   -- (c) took title to avoid forfeiture
