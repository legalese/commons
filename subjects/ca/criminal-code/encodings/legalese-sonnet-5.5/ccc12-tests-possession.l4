IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc12-logic`
IMPORT `ccc12-tests-fixtures`
IMPORT `ccc12-part9-possession`

-- Tests of ss 354 to 360. Expected values are hand-written from the text ($5,000 is "more than" above it, "not more than" at it) before each run.
-- Arguments are positional, in the GIVEN order of each function.

§ `s 354 possession of property obtained by crime`
-- has in possession, knows it was obtained from (a) an indictable offence in Canada, (b) an act anywhere that would be one in Canada
#ASSERT `s 354(1) the person commits the offence of possession of property obtained by crime` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 354(1) the person commits the offence of possession of property obtained by crime` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 354(1) the person commits the offence of possession of property obtained by crime` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 354(1) the person commits the offence of possession of property obtained by crime` FALSE TRUE TRUE EQUALS JUST FALSE
-- (2): proceedings in respect of (1), evidence of possession of a vehicle or part with its VIN removed or obliterated, evidence to the contrary
#ASSERT `s 354(2) the evidence is proof that the motor vehicle or part was obtained by an offence punishable by indictment` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 354(2) the evidence is proof that the motor vehicle or part was obtained by an offence punishable by indictment` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 354(2) the evidence is proof that the motor vehicle or part was obtained by an offence punishable by indictment` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 354(2) the evidence is proof that the motor vehicle or part was obtained by an offence punishable by indictment` TRUE FALSE FALSE EQUALS NOTHING
-- (3): a number or mark placed on a motor vehicle, to distinguish it from other similar vehicles
#ASSERT `s 354(3) the number or mark is a vehicle identification number` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 354(3) the number or mark is a vehicle identification number` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 354(3) the number or mark is a vehicle identification number` TRUE FALSE EQUALS JUST FALSE
-- (4): a peace officer (s 2), a person acting under a peace officer's direction, possesses for an investigation or in the execution of the peace officer's duties
#ASSERT `s 354(4) the person is guilty of an offence under section 354 by reason only of possessing the property for the purposes of an investigation or in the execution of the peace officer's duties` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 354(4) the person is guilty of an offence under section 354 by reason only of possessing the property for the purposes of an investigation or in the execution of the peace officer's duties` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 354(4) the person is guilty of an offence under section 354 by reason only of possessing the property for the purposes of an investigation or in the execution of the peace officer's duties` NOTHING TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 354(4) the person is guilty of an offence under section 354 by reason only of possessing the property for the purposes of an investigation or in the execution of the peace officer's duties` (JUST FALSE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 354(4) the person is guilty of an offence under section 354 by reason only of possessing the property for the purposes of an investigation or in the execution of the peace officer's duties` NOTHING FALSE TRUE EQUALS NOTHING
#ASSERT `s 354(4) the person is guilty of an offence under section 354 by reason only of possessing the property for the purposes of an investigation or in the execution of the peace officer's duties` (JUST TRUE) FALSE FALSE EQUALS NOTHING

§ `ss 355 to 355.5`
-- 355: testamentary instrument (s 2), value, the s 787(1) general penalty
#ASSERT `s 355 the punishment for the offence under section 354` (JUST FALSE) 5000 `ccc12 fixture general summary penalty` EQUALS JUST (LIST `ccc12 fixture indictable, up to two years`, `ccc12 fixture general summary penalty`)
#ASSERT `s 355 the punishment for the offence under section 354` (JUST FALSE) 5000.01 `ccc12 fixture general summary penalty` EQUALS JUST (LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`)
#ASSERT `s 355 the punishment for the offence under section 354` (JUST TRUE) 1 `ccc12 fixture general summary penalty` EQUALS JUST (LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`)
#ASSERT `s 355 the punishment for the offence under section 354` NOTHING 100 `ccc12 fixture general summary penalty` EQUALS NOTHING
#ASSERT `s 355 the punishment for the offence under section 354` NOTHING 6000 `ccc12 fixture general summary penalty` EQUALS JUST (LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`)
-- 355.1 traffic
#ASSERT `s 355.1 the person traffics` TRUE EQUALS JUST TRUE
#ASSERT `s 355.1 the person traffics` FALSE EQUALS JUST FALSE
-- 355.2: traffics (s 355.1), knows it was obtained from (a) or (b)
#ASSERT `s 355.2 the person commits the offence of trafficking in property obtained by crime` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 355.2 the person commits the offence of trafficking in property obtained by crime` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 355.2 the person commits the offence of trafficking in property obtained by crime` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 355.2 the person commits the offence of trafficking in property obtained by crime` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 355.2 the person commits the offence of trafficking in property obtained by crime` NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 355.2 the person commits the offence of trafficking in property obtained by crime` NOTHING FALSE FALSE EQUALS JUST FALSE
-- 355.3: importation or exportation; obtained from (a) or (b)
#ASSERT `s 355.3 the importation or exportation is prohibited` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 355.3 the importation or exportation is prohibited` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 355.3 the importation or exportation is prohibited` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 355.3 the importation or exportation is prohibited` FALSE TRUE TRUE EQUALS NOTHING
-- 355.4: has in possession, for the purpose of trafficking (s 355.1), knows (a), knows (b)
#ASSERT `s 355.4 the person commits the offence of possession of property obtained by crime for the purpose of trafficking` TRUE (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 355.4 the person commits the offence of possession of property obtained by crime for the purpose of trafficking` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 355.4 the person commits the offence of possession of property obtained by crime for the purpose of trafficking` TRUE (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 355.4 the person commits the offence of possession of property obtained by crime for the purpose of trafficking` FALSE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 355.4 the person commits the offence of possession of property obtained by crime for the purpose of trafficking` TRUE (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 355.4 the person commits the offence of possession of property obtained by crime for the purpose of trafficking` TRUE NOTHING TRUE FALSE EQUALS NOTHING
-- 355.5: more than $5,000: 14 years, indictable only; not more than $5,000: five years or summary
#ASSERT `s 355.5 the punishment for the offence under section 355.2 or 355.4` 5000.01 `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to fourteen years`
#ASSERT `s 355.5 the punishment for the offence under section 355.2 or 355.4` 6000 `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to fourteen years`
#ASSERT `s 355.5 the punishment for the offence under section 355.2 or 355.4` 5000 `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to five years`, `ccc12 fixture general summary penalty`
#ASSERT `s 355.5 the punishment for the offence under section 355.2 or 355.4` 4999.99 `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to five years`, `ccc12 fixture general summary penalty`
-- the class of the offence from the limbs: over $5,000 only indictable; not over, both
#ASSERT `ccc12 the class of the offence from its limbs` (`s 355.5 the punishment for the offence under section 355.2 or 355.4` 6000 `ccc12 fixture general summary penalty`) EQUALS JUST `an indictable offence`
#ASSERT `ccc12 the class of the offence from its limbs` (`s 355.5 the punishment for the offence under section 355.2 or 355.4` 100 `ccc12 fixture general summary penalty`) EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`

§ `ss 356 to 360`
-- 356(1): steals (s 2), (a)(i) post before delivery, (a)(i) post after delivery before the addressee has it, (a)(ii) a mail container, (a)(iii) a Canada Post key, (a.1) copy of a key with intent, (b) possession of what was used, (c) fraudulently redirects
#ASSERT `s 356(1) the person commits the offence of theft from mail` (JUST TRUE) TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 356(1) the person commits the offence of theft from mail` (JUST TRUE) FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 356(1) the person commits the offence of theft from mail` (JUST TRUE) FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 356(1) the person commits the offence of theft from mail` (JUST TRUE) FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 356(1) the person commits the offence of theft from mail` (JUST TRUE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 356(1) the person commits the offence of theft from mail` (JUST FALSE) TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 356(1) the person commits the offence of theft from mail` NOTHING TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 356(1) the person commits the offence of theft from mail` NOTHING FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 356(1) the person commits the offence of theft from mail` (JUST FALSE) FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 356(1) the person commits the offence of theft from mail` (JUST FALSE) FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 356(1) the person commits the offence of theft from mail` (JUST FALSE) FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 356(1) the person commits the offence of theft from mail` NOTHING FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- (2): no need to allege or prove value
#ASSERT `s 356(2) it is necessary to allege in the indictment or to prove on the trial that the thing had any value` TRUE EQUALS JUST FALSE
#ASSERT `s 356(2) it is necessary to allege in the indictment or to prove on the trial that the thing had any value` FALSE EQUALS NOTHING
#ASSERT `s 356(3) the punishment for the offence` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`
-- 357: brings into or has in Canada, obtained outside Canada, by an act that would have been theft or an offence under s 342 or 354
#ASSERT `s 357 the person commits the offence of bringing into Canada property obtained by crime` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 357 the person commits the offence of bringing into Canada property obtained by crime` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 357 the person commits the offence of bringing into Canada property obtained by crime` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 357 the person commits the offence of bringing into Canada property obtained by crime` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 357 the punishment for the offence` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`
-- 358: the offence (342, 354, 356(1)(b)), possession, control, aids in concealing or disposing
#ASSERT `s 358 the offence of having in possession is complete` (`Provision of the Code` OF 342, "(1)") TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 358 the offence of having in possession is complete` (`Provision of the Code` OF 354, "(1)") FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 358 the offence of having in possession is complete` (`Provision of the Code` OF 354, "(1)") FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 358 the offence of having in possession is complete` (`Provision of the Code` OF 356, "(1)(b)") TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 358 the offence of having in possession is complete` (`Provision of the Code` OF 342, "(1)") FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 358 the offence of having in possession is complete` (`Provision of the Code` OF 356, "(1)(a)") TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 358 the offence of having in possession is complete` (`Provision of the Code` OF 355.4, "") TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 359 as the text shows it` EQUALS "359 [Repealed, 2018, c. 29, s. 40]"
#ASSERT `s 360 as the text shows it` EQUALS "360 [Repealed, 2018, c. 29, s. 40]"
