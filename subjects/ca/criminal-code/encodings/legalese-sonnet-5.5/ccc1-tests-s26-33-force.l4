IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc1-s26-33-force`

-- ccc1-tests-s26-33-force.l4 -- tests for sections 26 to 33 of the Criminal Code (Canada). Expected values are written by hand from the text of each section.
-- Arguments are positional, in GIVEN order. The regulative rules are run with #TRACE (a regulative outcome cannot be asserted on the stable binary) and paired with decision functions that are asserted.

§ `s 26  (authorized by law to use force; the force exceeds what the law authorizes)`
#ASSERT `s 26 the person is criminally responsible for the excess of force` TRUE TRUE EQUALS JUST TRUE   -- authorized, and the excess
#ASSERT `s 26 the person is criminally responsible for the excess of force` TRUE FALSE EQUALS NOTHING   -- authorized, no excess: the section speaks only of the excess
#ASSERT `s 26 the person is criminally responsible for the excess of force` FALSE TRUE EQUALS NOTHING   -- not authorized by law to use force
#ASSERT `s 26 the person is criminally responsible for the excess of force` FALSE FALSE EQUALS NOTHING   -- neither

§ `s 27  (to prevent an offence; (a)(i) arrest without warrant; (a)(ii) immediate and serious injury; (b) belief on reasonable grounds; force reasonably necessary)`
#ASSERT `s 27 the person is justified in using the force` TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE   -- (a): an offence for which arrest is without warrant and that would be likely to cause immediate and serious injury
#ASSERT `s 27 the person is justified in using the force` TRUE FALSE TRUE FALSE TRUE EQUALS NOTHING   -- (a)(i) fails
#ASSERT `s 27 the person is justified in using the force` TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING   -- (a)(ii) fails
#ASSERT `s 27 the person is justified in using the force` FALSE TRUE TRUE FALSE TRUE EQUALS NOTHING   -- not to prevent the commission of an offence
#ASSERT `s 27 the person is justified in using the force` FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE   -- (b): to prevent anything the person on reasonable grounds believes would be an offence mentioned in (a)
#ASSERT `s 27 the person is justified in using the force` TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING   -- more force than is reasonably necessary: the section says "as much force as is reasonably necessary"
#ASSERT `s 27 the person is justified in using the force` FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING   -- same, limb (b)
#ASSERT `s 27 the person is justified in using the force` FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING   -- neither purpose

§ `s 27.1(1), (2)  (in flight by s 7(8); on the aircraft; an offence under an Act of Parliament; belief; force)`
#ASSERT `s 27.1(1) the person on the aircraft is justified in using the force` (JUST TRUE) TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- every conditions met
#ASSERT `s 27.1(1) the person on the aircraft is justified in using the force` (JUST FALSE) TRUE TRUE TRUE TRUE EQUALS NOTHING   -- not in flight
#ASSERT `s 27.1(1) the person on the aircraft is justified in using the force` NOTHING TRUE TRUE TRUE TRUE EQUALS NOTHING   -- section 7(8) did not answer
#ASSERT `s 27.1(1) the person on the aircraft is justified in using the force` (JUST TRUE) FALSE TRUE TRUE TRUE EQUALS NOTHING   -- not on the aircraft
#ASSERT `s 27.1(1) the person on the aircraft is justified in using the force` (JUST TRUE) TRUE FALSE TRUE TRUE EQUALS NOTHING   -- not an offence against an Act of Parliament
#ASSERT `s 27.1(1) the person on the aircraft is justified in using the force` (JUST TRUE) TRUE TRUE FALSE TRUE EQUALS NOTHING   -- no belief on reasonable grounds of likely immediate and serious injury
#ASSERT `s 27.1(1) the person on the aircraft is justified in using the force` (JUST TRUE) TRUE TRUE TRUE FALSE EQUALS NOTHING   -- more force than reasonably necessary
#ASSERT `s 27.1(2) section 27.1 applies in respect of the aircraft` TRUE FALSE EQUALS JUST TRUE   -- in flight in Canadian airspace
#ASSERT `s 27.1(2) section 27.1 applies in respect of the aircraft` FALSE TRUE EQUALS JUST TRUE   -- registered in Canada, in flight outside Canadian airspace
#ASSERT `s 27.1(2) section 27.1 applies in respect of the aircraft` TRUE TRUE EQUALS JUST TRUE   -- both
#ASSERT `s 27.1(2) section 27.1 applies in respect of the aircraft` FALSE FALSE EQUALS NOTHING   -- neither: the subsection is silent

§ `s 28(1)  (authorized to execute a warrant; good faith; reasonable grounds)`
#ASSERT `s 28(1) the person is protected from criminal responsibility for arresting the person who is not the person named in the warrant` TRUE TRUE TRUE EQUALS JUST TRUE   -- authorized, in good faith and on reasonable grounds
#ASSERT `s 28(1) the person is protected from criminal responsibility for arresting the person who is not the person named in the warrant` FALSE TRUE TRUE EQUALS JUST FALSE   -- not authorized to execute a warrant to arrest
#ASSERT `s 28(1) the person is protected from criminal responsibility for arresting the person who is not the person named in the warrant` TRUE FALSE TRUE EQUALS JUST FALSE   -- not in good faith
#ASSERT `s 28(1) the person is protected from criminal responsibility for arresting the person who is not the person named in the warrant` TRUE TRUE FALSE EQUALS JUST FALSE   -- not on reasonable grounds

§ `s 28(2)  (a person is authorized to execute a warrant; who; belief (a); belief (b))`
#ASSERT `s 28(2) the person is protected from criminal responsibility to the same extent as if the person arrested were the person named in the warrant` TRUE `s 28(2)(a) a person who, being called on to assist the person authorized to execute the warrant, is called on to assist in an arrest` TRUE FALSE EQUALS JUST TRUE   -- (a): called on to assist, believing it is the person named
#ASSERT `s 28(2) the person is protected from criminal responsibility to the same extent as if the person arrested were the person named in the warrant` TRUE `s 28(2)(a) a person who, being called on to assist the person authorized to execute the warrant, is called on to assist in an arrest` FALSE TRUE EQUALS NOTHING   -- (a) without that belief
#ASSERT `s 28(2) the person is protected from criminal responsibility to the same extent as if the person arrested were the person named in the warrant` TRUE `s 28(2)(b) a keeper of a prison who is required to receive and detain a person` FALSE TRUE EQUALS JUST TRUE   -- (b): a keeper who believes the person was arrested under the warrant
#ASSERT `s 28(2) the person is protected from criminal responsibility to the same extent as if the person arrested were the person named in the warrant` TRUE `s 28(2)(b) a keeper of a prison who is required to receive and detain a person` TRUE FALSE EQUALS NOTHING   -- (b) without that belief
#ASSERT `s 28(2) the person is protected from criminal responsibility to the same extent as if the person arrested were the person named in the warrant` TRUE `s 28(2) another person` TRUE TRUE EQUALS NOTHING   -- another person
#ASSERT `s 28(2) the person is protected from criminal responsibility to the same extent as if the person arrested were the person named in the warrant` FALSE `s 28(2)(a) a person who, being called on to assist the person authorized to execute the warrant, is called on to assist in an arrest` TRUE FALSE EQUALS JUST FALSE   -- "Where a person is authorized to execute a warrant to arrest" is not met
#ASSERT `s 28(2) the person is protected from criminal responsibility to the same extent as if the person arrested were the person named in the warrant` FALSE `s 28(2)(b) a keeper of a prison who is required to receive and detain a person` FALSE TRUE EQUALS JUST FALSE   -- same

§ `s 29(1)  (duties of a person who executes a process or warrant)`
#ASSERT `s 29(1) the person who executes a process or warrant has the duty to have it with them` TRUE TRUE EQUALS JUST TRUE   -- feasible: the duty to have it with them
#ASSERT `s 29(1) the person who executes a process or warrant has the duty to have it with them` TRUE FALSE EQUALS JUST FALSE   -- not feasible: "where it is feasible to do so"
#ASSERT `s 29(1) the person who executes a process or warrant has the duty to have it with them` FALSE TRUE EQUALS NOTHING   -- does not execute a process or warrant
#ASSERT `s 29(1) the person who executes a process or warrant has the duty to have it with them` FALSE FALSE EQUALS NOTHING   -- same
#ASSERT `s 29(1) the person who executes a process or warrant has the duty to produce it` TRUE TRUE EQUALS JUST TRUE   -- requested: the duty to produce it
#ASSERT `s 29(1) the person who executes a process or warrant has the duty to produce it` TRUE FALSE EQUALS JUST FALSE   -- not requested: "when requested to do so"
#ASSERT `s 29(1) the person who executes a process or warrant has the duty to produce it` FALSE TRUE EQUALS NOTHING   -- does not execute a process or warrant
-- Expected by hand: the duty is done, FULFILLED.
#TRACE `s 29(1) the duty to have the process or warrant with the person` AT 0 WITH
    PARTY `s 29 a person who executes a process or warrant` DOES `s 29(1) have the process or warrant with them` AT 1
-- Expected by hand: produced, FULFILLED.
#TRACE `s 29(1) the duty to produce the process or warrant when requested` AT 0 WITH
    PARTY `s 29 a person who executes a process or warrant` DOES `s 29(1) produce the process or warrant when requested` AT 1

§ `s 29(2), (3)`
#ASSERT `s 29(2) the person who arrests has the duty to give the person arrested notice` TRUE TRUE EQUALS JUST TRUE   -- arrests, feasible
#ASSERT `s 29(2) the person who arrests has the duty to give the person arrested notice` TRUE FALSE EQUALS JUST FALSE   -- not feasible: "where it is feasible to do so"
#ASSERT `s 29(2) the person who arrests has the duty to give the person arrested notice` FALSE TRUE EQUALS NOTHING   -- does not arrest
#ASSERT `s 29(2) the notice discharges the duty` `s 29(2)(a) the process or warrant under which the arrest is made` EQUALS JUST TRUE   -- (a)
#ASSERT `s 29(2) the notice discharges the duty` `s 29(2)(b) the reason for the arrest` EQUALS JUST TRUE   -- (b)
#ASSERT `s 29(2) the notice discharges the duty` `s 29(2) neither` EQUALS NOTHING   -- neither: the subsection is silent
-- Expected by hand: notice given, FULFILLED.
#TRACE `s 29(2) the duty to give notice of the process or warrant or of the reason for the arrest` AT 0 WITH
    PARTY `s 29 a person who arrests a person, whether with or without a warrant` DOES `s 29(2) give notice of the process or warrant under which the arrest is made, or of the reason for the arrest` AT 1
#ASSERT `s 29(3) the failure deprives the person of protection from criminal responsibility` TRUE TRUE EQUALS JUST FALSE   -- "does not of itself deprive"
#ASSERT `s 29(3) the failure deprives the person of protection from criminal responsibility` TRUE FALSE EQUALS NOTHING   -- other grounds are said to exist: silent
#ASSERT `s 29(3) the failure deprives the person of protection from criminal responsibility` FALSE TRUE EQUALS NOTHING   -- no failure to comply
#ASSERT `s 29(3) the failure deprives the person of protection from criminal responsibility` FALSE FALSE EQUALS NOTHING   -- neither

§ `s 30`
#ASSERT `s 30 the person is justified in interfering to prevent the continuance or renewal of the breach of the peace` TRUE TRUE EQUALS JUST TRUE   -- witnesses a breach of the peace and interferes to prevent its continuance
#ASSERT `s 30 the person is justified in interfering to prevent the continuance or renewal of the breach of the peace` TRUE FALSE EQUALS NOTHING   -- interferes for another purpose
#ASSERT `s 30 the person is justified in interfering to prevent the continuance or renewal of the breach of the peace` FALSE TRUE EQUALS NOTHING   -- does not witness a breach of the peace
#ASSERT `s 30 the person may detain the person who commits or is about to join in or to renew the breach of the peace` TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- witnesses; the detainee commits or is about to join or renew; to give into custody; no more force than reasonably necessary
#ASSERT `s 30 the person may detain the person who commits or is about to join in or to renew the breach of the peace` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- does not witness
#ASSERT `s 30 the person may detain the person who commits or is about to join in or to renew the breach of the peace` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- the detainee does not commit, join or renew
#ASSERT `s 30 the person may detain the person who commits or is about to join in or to renew the breach of the peace` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- not for the purpose of giving into the custody of a peace officer
#ASSERT `s 30 the person may detain the person who commits or is about to join in or to renew the breach of the peace` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- more force than reasonably necessary: a grant with an "if" gate

§ `s 31(1), (2)  (who; peace officer by s 2; found committing; reasonable belief)`
#ASSERT `s 31(1) the person is justified in arresting the person` `s 31(1) a peace officer who witnesses a breach of the peace` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE   -- a peace officer who finds the person committing the breach
#ASSERT `s 31(1) the person is justified in arresting the person` `s 31(1) a peace officer who witnesses a breach of the peace` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- a peace officer who on reasonable grounds believes the person is about to join or renew it
#ASSERT `s 31(1) the person is justified in arresting the person` `s 31(1) a peace officer who witnesses a breach of the peace` (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- neither ground
#ASSERT `s 31(1) the person is justified in arresting the person` `s 31(1) a peace officer who witnesses a breach of the peace` (JUST FALSE) TRUE FALSE EQUALS NOTHING   -- not a peace officer
#ASSERT `s 31(1) the person is justified in arresting the person` `s 31(1) a peace officer who witnesses a breach of the peace` NOTHING TRUE FALSE EQUALS NOTHING   -- section 2 did not answer
#ASSERT `s 31(1) the person is justified in arresting the person` `s 31(1) a person who lawfully assists the peace officer` (JUST FALSE) TRUE FALSE EQUALS JUST TRUE   -- one who lawfully assists the peace officer: section 2 does not matter
#ASSERT `s 31(1) the person is justified in arresting the person` `s 31(1) a person who lawfully assists the peace officer` NOTHING FALSE TRUE EQUALS JUST TRUE   -- same, on reasonable belief
#ASSERT `s 31(1) the person is justified in arresting the person` `s 31(1) another person` (JUST TRUE) TRUE TRUE EQUALS NOTHING   -- another person
#ASSERT `s 31(2) the peace officer is justified in receiving the person into custody` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE   -- given into charge by one who has witnessed the breach
#ASSERT `s 31(2) the peace officer is justified in receiving the person into custody` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST TRUE   -- given into charge by one the peace officer on reasonable grounds believes has witnessed it
#ASSERT `s 31(2) the peace officer is justified in receiving the person into custody` (JUST TRUE) TRUE FALSE FALSE EQUALS NOTHING   -- neither
#ASSERT `s 31(2) the peace officer is justified in receiving the person into custody` (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING   -- not given into charge as having been a party to a breach of the peace
#ASSERT `s 31(2) the peace officer is justified in receiving the person into custody` (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING   -- not a peace officer
#ASSERT `s 31(2) the peace officer is justified in receiving the person into custody` NOTHING TRUE TRUE TRUE EQUALS NOTHING   -- section 2 did not answer

§ `s 32  (riots)`
#ASSERT `s 32(1) the peace officer is justified in using or in ordering the use of the force` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE   -- believes the force necessary and not excessive
#ASSERT `s 32(1) the peace officer is justified in using or in ordering the use of the force` (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- does not believe it is not excessive
#ASSERT `s 32(1) the peace officer is justified in using or in ordering the use of the force` (JUST TRUE) FALSE TRUE EQUALS NOTHING   -- does not believe it is necessary
#ASSERT `s 32(1) the peace officer is justified in using or in ordering the use of the force` (JUST FALSE) TRUE TRUE EQUALS NOTHING   -- not a peace officer
#ASSERT `s 32(1) the peace officer is justified in using or in ordering the use of the force` NOTHING TRUE TRUE EQUALS NOTHING   -- section 2 did not answer
#ASSERT `s 32(2) the person is justified in obeying the command` TRUE TRUE FALSE EQUALS JUST TRUE   -- bound by military law, a command for the suppression of a riot, not manifestly unlawful
#ASSERT `s 32(2) the person is justified in obeying the command` TRUE TRUE TRUE EQUALS JUST FALSE   -- "unless the order is manifestly unlawful"
#ASSERT `s 32(2) the person is justified in obeying the command` FALSE TRUE FALSE EQUALS NOTHING   -- not bound by military law to obey
#ASSERT `s 32(2) the person is justified in obeying the command` TRUE FALSE FALSE EQUALS NOTHING   -- not a command for the suppression of a riot
#ASSERT `s 32(3) the person is justified in obeying the order of a peace officer to use force to suppress a riot` TRUE TRUE TRUE EQUALS JUST TRUE   -- good faith and not manifestly unlawful
#ASSERT `s 32(3) the person is justified in obeying the order of a peace officer to use force to suppress a riot` TRUE FALSE TRUE EQUALS JUST FALSE   -- (a) not met
#ASSERT `s 32(3) the person is justified in obeying the order of a peace officer to use force to suppress a riot` TRUE TRUE FALSE EQUALS JUST FALSE   -- (b) not met: the order is manifestly unlawful
#ASSERT `s 32(3) the person is justified in obeying the order of a peace officer to use force to suppress a riot` TRUE FALSE FALSE EQUALS JUST FALSE   -- neither
#ASSERT `s 32(3) the person is justified in obeying the order of a peace officer to use force to suppress a riot` FALSE TRUE TRUE EQUALS NOTHING   -- not an order of a peace officer to use force to suppress a riot
#ASSERT `s 32(4) the person is justified in using the force` TRUE TRUE TRUE EQUALS JUST TRUE   -- belief in serious mischief before a peace officer can attend; force necessary and not excessive
#ASSERT `s 32(4) the person is justified in using the force` FALSE TRUE TRUE EQUALS NOTHING   -- no such belief
#ASSERT `s 32(4) the person is justified in using the force` TRUE FALSE TRUE EQUALS NOTHING   -- force not believed necessary
#ASSERT `s 32(4) the person is justified in using the force` TRUE TRUE FALSE EQUALS NOTHING   -- force not believed not excessive
#ASSERT `s 32(5) the question whether an order is manifestly unlawful is a question of law` TRUE EQUALS JUST TRUE   -- a question of law
#ASSERT `s 32(5) the question whether an order is manifestly unlawful is a question of law` FALSE EQUALS NOTHING   -- another question

§ `s 33  (duty of officers if rioters do not disperse)`
#ASSERT `s 33(1) the person has the duty to disperse or to arrest persons who do not comply with the proclamation` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- a peace officer, the proclamation made, persons who do not comply
#ASSERT `s 33(1) the person has the duty to disperse or to arrest persons who do not comply with the proclamation` TRUE (JUST FALSE) TRUE TRUE EQUALS JUST TRUE   -- a person lawfully required by a peace officer to assist
#ASSERT `s 33(1) the person has the duty to disperse or to arrest persons who do not comply with the proclamation` TRUE (JUST FALSE) FALSE TRUE EQUALS NOTHING   -- neither a peace officer nor assisting one
#ASSERT `s 33(1) the person has the duty to disperse or to arrest persons who do not comply with the proclamation` TRUE NOTHING FALSE TRUE EQUALS NOTHING   -- section 2 did not answer
#ASSERT `s 33(1) the person has the duty to disperse or to arrest persons who do not comply with the proclamation` TRUE NOTHING TRUE TRUE EQUALS JUST TRUE   -- assisting: section 2 does not matter
#ASSERT `s 33(1) the person has the duty to disperse or to arrest persons who do not comply with the proclamation` TRUE (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- the persons comply
#ASSERT `s 33(1) the person has the duty to disperse or to arrest persons who do not comply with the proclamation` FALSE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE   -- "Where the proclamation referred to in section 67 has been made or an offence against paragraph 68(a) or (b) has been committed" is not met
-- Expected by hand: the peace officer disperses or arrests, FULFILLED.
#TRACE `s 33(1) the duty of the peace officer to disperse or arrest persons who do not comply with the proclamation` AT 0 WITH
    PARTY `a peace officer` DOES `s 33(1) disperse or arrest persons who do not comply with the proclamation` AT 1
#ASSERT `s 33(2) civil or criminal proceedings lie against the person in respect of the death or injury` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE   -- "No civil or criminal proceedings lie"
#ASSERT `s 33(2) civil or criminal proceedings lie against the person in respect of the death or injury` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE   -- a person lawfully required to assist
#ASSERT `s 33(2) civil or criminal proceedings lie against the person in respect of the death or injury` (JUST FALSE) FALSE TRUE EQUALS NOTHING   -- neither a peace officer nor assisting one
#ASSERT `s 33(2) civil or criminal proceedings lie against the person in respect of the death or injury` NOTHING FALSE TRUE EQUALS NOTHING   -- section 2 did not answer
#ASSERT `s 33(2) civil or criminal proceedings lie against the person in respect of the death or injury` (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- not a death or injury caused by reason of resistance in performing the duty of (1)
#ASSERT `s 33(3) section 33 limits or affects the power, duty or function` TRUE EQUALS JUST FALSE   -- "Nothing in this section limits or affects"
#ASSERT `s 33(3) section 33 limits or affects the power, duty or function` FALSE EQUALS NOTHING   -- another power, duty or function
