IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc7-s183-base`
IMPORT `ccc7-s184-interception`

-- ccc7-tests-s184-interception.l4 -- tests for ccc7-s184-interception.l4 (ss 184, 184.1, 184.4, 184.5, 184.6). Expected values are written by hand from the text, beside each assertion.
-- Argument order is the order of the GIVEN lines of each function. JUST TRUE / JUST FALSE / NOTHING are written (JUST TRUE) where they are arguments.

§ `Tests -- section 184(1): the offence`

-- args: device, intercepting, knowingly, private communication, subsection (1) does not apply (s 184(2))
-- every element holds and no saving limb applies: "Every person who, by means of any electro-magnetic, acoustic, mechanical or other device, knowingly intercepts a private communication is guilty of"
#ASSERT `s 184(1) the person is guilty of an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
-- a saving limb applies: "Subsection (1) does not apply to"
#ASSERT `s 184(1) the person is guilty of an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
-- the saving provision decides even where an element is not covered
#ASSERT `s 184(1) the person is guilty of an offence under the subsection` (JUST TRUE) NOTHING TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
-- the device is a hearing aid (section 183 says JUST FALSE): no device, no offence under this subsection
#ASSERT `s 184(1) the person is guilty of an offence under the subsection` (JUST FALSE) (JUST TRUE) TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- not knowingly
#ASSERT `s 184(1) the person is guilty of an offence under the subsection` (JUST TRUE) (JUST TRUE) FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- not a private communication
#ASSERT `s 184(1) the person is guilty of an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- what the person did is an act "intercept includes" does not name: not covered
#ASSERT `s 184(1) the person is guilty of an offence under the subsection` (JUST TRUE) NOTHING TRUE (JUST TRUE) (JUST FALSE) EQUALS NOTHING
-- one element not covered and another shown not to hold: the element shown not to hold decides
#ASSERT `s 184(1) the person is guilty of an offence under the subsection` (JUST TRUE) NOTHING FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- the saving provision is itself not covered, and the elements hold: not covered
#ASSERT `s 184(1) the person is guilty of an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE (JUST TRUE) NOTHING EQUALS NOTHING

-- the penalty: "(a) an indictable offence and liable to imprisonment for a term of not more than five years; or (b) an offence punishable on summary conviction"
#ASSERT `s 184(1)(a) the punishment on indictment`'s `mode` EQUALS `by indictment`
#ASSERT `s 184(1)(a) the punishment on indictment`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 184(1)(a) the punishment on indictment`'s `minimum imprisonment` EQUALS `no imprisonment is stated`
#ASSERT `s 184(1)(a) the punishment on indictment`'s `maximum fine` EQUALS `no fine is stated`
-- the summary limb states no penalty: it is the s 787(1) input, passed through
`s 184 test the penalty of section 787(1)` MEANS
    Punishment WITH `mode` IS `on summary conviction`
                    `maximum imprisonment` IS `imprisonment for a term of` `two years less a day`
                    `minimum imprisonment` IS `no imprisonment is stated`
                    `maximum fine` IS `a fine of` 5000
                    `minimum fine` IS `no fine is stated`
#ASSERT `s 184(1)(b) the punishment on summary conviction` `s 184 test the penalty of section 787(1)` EQUALS `s 184 test the penalty of section 787(1)`
#ASSERT (`s 184(1) the punishments` `s 184 test the penalty of section 787(1)`) EQUALS (LIST `s 184(1)(a) the punishment on indictment` , `s 184 test the penalty of section 787(1)`)
#ASSERT `s 184(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`

§ `Tests -- section 184(2): the saving provision`

-- (a) args: consent of the originator or intended recipient, s 183.1
#ASSERT `s 184(2)(a) the person has the consent to intercept` TRUE (JUST FALSE) EQUALS JUST TRUE
-- several persons: the consent of one of them is sufficient (s 183.1)
#ASSERT `s 184(2)(a) the person has the consent to intercept` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 184(2)(a) the person has the consent to intercept` FALSE NOTHING EQUALS NOTHING
#ASSERT `s 184(2)(a) the person has the consent to intercept` FALSE (JUST FALSE) EQUALS JUST FALSE
-- (b) args: instrument is an authorization, in accordance with it, pursuant to s 184.4, aids in good faith, believes on reasonable grounds
#ASSERT `s 184(2)(b) the person intercepts in accordance with an authorization or pursuant to section 184.4, or aids a person who is` (JUST TRUE) TRUE (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 184(2)(b) the person intercepts in accordance with an authorization or pursuant to section 184.4, or aids a person who is` (JUST FALSE) FALSE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 184(2)(b) the person intercepts in accordance with an authorization or pursuant to section 184.4, or aids a person who is` (JUST FALSE) FALSE (JUST FALSE) TRUE TRUE EQUALS JUST TRUE
-- an aider who does not believe on reasonable grounds is not within the limb
#ASSERT `s 184(2)(b) the person intercepts in accordance with an authorization or pursuant to section 184.4, or aids a person who is` (JUST FALSE) FALSE (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
-- an authorization that is not one in the section 183 sense, and nothing else
#ASSERT `s 184(2)(b) the person intercepts in accordance with an authorization or pursuant to section 184.4, or aids a person who is` (JUST FALSE) TRUE (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
-- the instrument's status is not covered
#ASSERT `s 184(2)(b) the person intercepts in accordance with an authorization or pursuant to section 184.4, or aids a person who is` NOTHING TRUE (JUST FALSE) FALSE FALSE EQUALS NOTHING
-- (c)(i) to (iii) args: engaged in providing the service, the stated condition
#ASSERT `s 184(2)(c)(i) a person providing a communication service to the public intercepts as necessary to provide the service` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184(2)(c)(i) a person providing a communication service to the public intercepts as necessary to provide the service` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 184(2)(c)(i) a person providing a communication service to the public intercepts as necessary to provide the service` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 184(2)(c)(ii) a person providing a communication service to the public intercepts in service observing or random monitoring` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184(2)(c)(ii) a person providing a communication service to the public intercepts in service observing or random monitoring` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 184(2)(c)(ii) a person providing a communication service to the public intercepts in service observing or random monitoring` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 184(2)(c)(iii) a person providing a communication service to the public intercepts to protect their rights or property` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184(2)(c)(iii) a person providing a communication service to the public intercepts to protect their rights or property` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 184(2)(c)(iii) a person providing a communication service to the public intercepts to protect their rights or property` FALSE TRUE EQUALS JUST FALSE
-- (c) any of the three
#ASSERT `s 184(2)(c) a person providing a communication service to the public intercepts in one of the three ways` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 184(2)(c) a person providing a communication service to the public intercepts in one of the three ways` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 184(2)(c) a person providing a communication service to the public intercepts in one of the three ways` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 184(2)(c) a person providing a communication service to the public intercepts in one of the three ways` (JUST FALSE) NOTHING (JUST FALSE) EQUALS NOTHING
-- (d) args: an officer or servant engaged in spectrum management, the purpose
#ASSERT `s 184(2)(d) a spectrum management officer intercepts to identify, isolate or prevent an unauthorized use of a frequency` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184(2)(d) a spectrum management officer intercepts to identify, isolate or prevent an unauthorized use of a frequency` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 184(2)(d) a spectrum management officer intercepts to identify, isolate or prevent an unauthorized use of a frequency` FALSE TRUE EQUALS JUST FALSE
-- (e) args: computer system (s 342.1(2)), possession or control, originates from / directed to / transmits through, (i) quality of service, (ii) protection
#ASSERT `s 184(2)(e) a person in control of a computer system intercepts as reasonably necessary to manage or protect it` (JUST TRUE) TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 184(2)(e) a person in control of a computer system intercepts as reasonably necessary to manage or protect it` (JUST TRUE) TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- neither (i) nor (ii)
#ASSERT `s 184(2)(e) a person in control of a computer system intercepts as reasonably necessary to manage or protect it` (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 184(2)(e) a person in control of a computer system intercepts as reasonably necessary to manage or protect it` (JUST TRUE) FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 184(2)(e) a person in control of a computer system intercepts as reasonably necessary to manage or protect it` (JUST TRUE) TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 184(2)(e) a person in control of a computer system intercepts as reasonably necessary to manage or protect it` (JUST FALSE) TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- the term "computer system, as defined in subsection 342.1(2)" is for that subsection: not covered here
#ASSERT `s 184(2)(e) a person in control of a computer system intercepts as reasonably necessary to manage or protect it` NOTHING TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 184(2)(e) a person in control of a computer system intercepts as reasonably necessary to manage or protect it` NOTHING FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- (2) as a whole: args (a) to (e)
#ASSERT `s 184(2) subsection (1) does not apply to the person` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 184(2) subsection (1) does not apply to the person` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 184(2) subsection (1) does not apply to the person` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 184(2) subsection (1) does not apply to the person` (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 184(2) subsection (1) does not apply to the person` (JUST FALSE) NOTHING (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE

§ `Tests -- section 184(3): use or retention (a list closed with "only if")`

-- args: intercepted by a person referred to in (2)(e), (a) essential to identify, isolate or prevent harm, (b) to be disclosed in circumstances referred to in 193(2)
#ASSERT `s 184(3) a private communication intercepted by a person referred to in paragraph (2)(e) can be used or retained` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 184(3) a private communication intercepted by a person referred to in paragraph (2)(e) can be used or retained` TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
-- neither (a) nor (b): "can be used or retained only if"
#ASSERT `s 184(3) a private communication intercepted by a person referred to in paragraph (2)(e) can be used or retained` TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 184(3) a private communication intercepted by a person referred to in paragraph (2)(e) can be used or retained` TRUE FALSE NOTHING EQUALS NOTHING
-- intercepted by someone else (under another saving limb): subsection (3) says nothing about it
#ASSERT `s 184(3) a private communication intercepted by a person referred to in paragraph (2)(e) can be used or retained` FALSE FALSE (JUST FALSE) EQUALS NOTHING

§ `Tests -- section 184.1`

-- (4) agent of the state: args peace officer (s 2), acting under the authority of or in cooperation with a peace officer
#ASSERT `s 184.1(4) agent of the state` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 184.1(4) agent of the state` (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 184.1(4) agent of the state` (JUST FALSE) FALSE EQUALS JUST FALSE
-- s 2 "peace officer" says "includes": a person it does not name is not covered, unless the second limb holds
#ASSERT `s 184.1(4) agent of the state` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 184.1(4) agent of the state` NOTHING TRUE EQUALS JUST TRUE
-- (1) args: agent of the state, device, private communication, consent, belief of risk, purpose
#ASSERT `s 184.1(1) an agent of the state may intercept a private communication` (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
-- a failed "if" gate is NOT COVERED, not "may not" (ruling of 2026-11-12)
#ASSERT `s 184.1(1) an agent of the state may intercept a private communication` (JUST TRUE) (JUST TRUE) (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 184.1(1) an agent of the state may intercept a private communication` (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 184.1(1) an agent of the state may intercept a private communication` (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 184.1(1) an agent of the state may intercept a private communication` (JUST FALSE) (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 184.1(1) an agent of the state may intercept a private communication` (JUST TRUE) (JUST FALSE) (JUST TRUE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 184.1(1) an agent of the state may intercept a private communication` (JUST TRUE) (JUST TRUE) (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 184.1(1) an agent of the state may intercept a private communication` NOTHING (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE EQUALS NOTHING
-- (2) args: obtained from an interception pursuant to (1), the proceedings are ones alleging actual, attempted or threatened bodily harm
#ASSERT `s 184.1(2) the contents are inadmissible as evidence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 184.1(2) the contents are inadmissible as evidence` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 184.1(2) the contents are inadmissible as evidence` FALSE FALSE EQUALS NOTHING
#ASSERT `s 184.1(2) the contents are inadmissible as evidence` FALSE TRUE EQUALS NOTHING
-- (3) args: intercepted pursuant to (1), nothing suggests bodily harm
#ASSERT `s 184.1(3) the agent of the state is bound to destroy the recording, transcript and notes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184.1(3) the agent of the state is bound to destroy the recording, transcript and notes` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 184.1(3) the agent of the state is bound to destroy the recording, transcript and notes` FALSE TRUE EQUALS NOTHING
-- the duty kept: args bound, destroyed as soon as practicable
#ASSERT `s 184.1(3) the agent of the state has kept the duty to destroy` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 184.1(3) the agent of the state has kept the duty to destroy` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 184.1(3) the agent of the state has kept the duty to destroy` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 184.1(3) the agent of the state has kept the duty to destroy` NOTHING TRUE EQUALS NOTHING
-- the duty as a rule: no period is stated, so the trace has no deadline. Read the three results in NOTES.md (a DEONTIC cannot be asserted on the stable binary).
#TRACE `s 184.1(3) the duty to destroy as a rule` AT 0 WITH
    PARTY `s 183 an agent of the state` DOES `s 184.1(3) destroys the recording, every transcript and the notes` AT 3
#TRACE `s 184.1(3) the duty to destroy as a rule` AT 0 WITH
    (WAITUNTIL 400)

§ `Tests -- section 184.4`

-- args: police officer (s 183), device, private communication, (a) urgency, (b) immediately necessary, (c) originator or recipient would commit the offence or is the victim
#ASSERT `s 184.4 a police officer may intercept a private communication` (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184.4 a police officer may intercept a private communication` (JUST TRUE) (JUST TRUE) (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 184.4 a police officer may intercept a private communication` (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 184.4 a police officer may intercept a private communication` (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 184.4 a police officer may intercept a private communication` (JUST FALSE) (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 184.4 a police officer may intercept a private communication` NOTHING (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 184.4 a police officer may intercept a private communication` (JUST TRUE) (JUST FALSE) (JUST TRUE) TRUE TRUE TRUE EQUALS NOTHING

§ `Tests -- section 184.5`

-- (1) args: device, intercepting, maliciously, for gain, radio-based telephone communication, originator or recipient in Canada, subsection 184(2) as applied by 184.5(2)
#ASSERT `s 184.5(1) the person is guilty of an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE FALSE (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST TRUE
-- "maliciously or for gain": either suffices
#ASSERT `s 184.5(1) the person is guilty of an offence under the subsection` (JUST TRUE) (JUST TRUE) FALSE TRUE (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 184.5(1) the person is guilty of an offence under the subsection` (JUST TRUE) (JUST TRUE) FALSE FALSE (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST FALSE
-- neither the originator nor the person intended to receive it is in Canada: "if the originator ... is in Canada"
#ASSERT `s 184.5(1) the person is guilty of an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE TRUE (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST FALSE
-- not a radio-based telephone communication
#ASSERT `s 184.5(1) the person is guilty of an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE TRUE (JUST FALSE) TRUE (JUST FALSE) EQUALS JUST FALSE
-- subsection 184(2) applies by 184.5(2): "Subsection (1) does not apply to" the person
#ASSERT `s 184.5(1) the person is guilty of an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE TRUE (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 184.5(1) the person is guilty of an offence under the subsection` (JUST TRUE) (JUST TRUE) TRUE TRUE NOTHING TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 184.5(1) the person is guilty of an offence under the subsection` (JUST FALSE) (JUST TRUE) TRUE TRUE (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 184.5(1)(a) the punishment on indictment`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 184.5(1)(a) the punishment on indictment`'s `mode` EQUALS `by indictment`
#ASSERT `s 184.5(1)(b) the punishment on summary conviction` `s 184 test the penalty of section 787(1)` EQUALS `s 184 test the penalty of section 787(1)`
#ASSERT `s 184.5(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`

-- (2) args: the provision, the interception is of a radio-based telephone communication referred to in (1)
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 183.1 , "") TRUE EQUALS JUST TRUE
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 184 , "(2)") TRUE EQUALS JUST TRUE
-- subsection 184(1) is not in the list: not covered, not "does not apply"
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 184 , "(1)") TRUE EQUALS NOTHING
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 184.1 , "(1)") TRUE EQUALS JUST TRUE
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 184.4 , "") TRUE EQUALS JUST TRUE
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 187 , "(1.4)") TRUE EQUALS JUST TRUE
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 190 , "") TRUE EQUALS JUST TRUE
-- 191 to 193.1 are not in the list
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 191 , "(1)") TRUE EQUALS NOTHING
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 193 , "(1)") TRUE EQUALS NOTHING
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 193.1 , "(1)") TRUE EQUALS NOTHING
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 194 , "(1)") TRUE EQUALS JUST TRUE
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 195 , "(2)") TRUE EQUALS JUST TRUE
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 196 , "(1)") TRUE EQUALS JUST TRUE
-- 196.1 is numbered after 196: outside "194 to 196" read numerically (fork F10)
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 196.1 , "(1)") TRUE EQUALS NOTHING
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 183 , "") TRUE EQUALS NOTHING
#ASSERT `s 184.5(2) the provision applies to the interception` (`Provision of the Code` OF 193 , "(1)") FALSE EQUALS NOTHING

§ `Tests -- section 184.6`

#ASSERT `s 184.6 one application for an authorization may be made for both kinds of communication` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184.6 one application for an authorization may be made for both kinds of communication` TRUE FALSE EQUALS NOTHING
#ASSERT `s 184.6 one application for an authorization may be made for both kinds of communication` FALSE TRUE EQUALS NOTHING
#ASSERT (`s 184.5(1) the punishments` `s 184 test the penalty of section 787(1)`) EQUALS (LIST `s 184.5(1)(a) the punishment on indictment` , `s 184 test the penalty of section 787(1)`)

-- assertions written: 123; assertions satisfied: 123 (l4 1.6.110 and 1.6.109, check.sh, 2026-11-13)
