IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc12-logic`

-- Tests of the helpers. Expected values come from the definitions of the three-valued connectives in `ccc12-logic.l4`'s header
-- (a definite no settles a conjunction; a definite yes settles a disjunction; otherwise NOTHING stays NOTHING), written before running.

§ `ccc12 and`
#ASSERT `ccc12 and` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `ccc12 and` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `ccc12 and` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `ccc12 and` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `ccc12 and` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `ccc12 and` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `ccc12 and` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `ccc12 and` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `ccc12 and` NOTHING NOTHING EQUALS NOTHING

§ `ccc12 or`
#ASSERT `ccc12 or` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `ccc12 or` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `ccc12 or` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `ccc12 or` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `ccc12 or` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `ccc12 or` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `ccc12 or` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `ccc12 or` NOTHING NOTHING EQUALS NOTHING

§ `ccc12 not and ccc12 holds`
#ASSERT `ccc12 not` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `ccc12 not` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `ccc12 not` NOTHING EQUALS NOTHING
#ASSERT `ccc12 holds` TRUE EQUALS JUST TRUE
#ASSERT `ccc12 holds` FALSE EQUALS JUST FALSE

§ `Punishment limbs`
-- One indictable limb: ten years.
#ASSERT `ccc12 the class of the offence from its limbs` (LIST `ccc12 an indictable limb` (`imprisonment for a term of` `ten years`)) EQUALS JUST `an indictable offence`
-- An indictable and a summary limb: both.
#ASSERT `ccc12 the class of the offence from its limbs` (LIST `ccc12 an indictable limb` (`imprisonment for a term of` `two years`), Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`
-- One summary limb: summary only.
#ASSERT `ccc12 the class of the offence from its limbs` (LIST Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS JUST `an offence punishable on summary conviction`
-- No limb: NOTHING.
#ASSERT `ccc12 the class of the offence from its limbs` (EMPTY) EQUALS NOTHING
-- A limb with a minimum keeps the minimum and the mode.
#ASSERT (`ccc12 an indictable limb with a minimum` (`imprisonment for life`) (`imprisonment for a term of` `six months`))'s `minimum imprisonment` EQUALS `imprisonment for a term of` `six months`
#ASSERT (`ccc12 an indictable limb` (`imprisonment for life`))'s `maximum imprisonment` EQUALS `imprisonment for life`
