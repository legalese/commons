IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc6-builders`
IMPORT `ccc6-children`
IMPORT `ccc6-tests-support`

-- Tests for ss 169.1, 170, 171, 171.1, 172, 172.1 and 172.2. Expected values decided from the text before each run.

`s 169.1 test s 787(1) penalty` MEANS Punishment OF `by indictment`, `imprisonment for a term of` `six months`, `no imprisonment is stated`, `a fine in the discretion of the court`, `no fine is stated`
`s 169.1 test summary penalty` MEANS Punishment OF `on summary conviction`, `imprisonment for a term of` `six months`, `no imprisonment is stated`, `a fine in the discretion of the court`, `no fine is stated`

§ `s 169.1 Recruitment — young person`
#ASSERT `s 169.1(5) young person` 17 EQUALS JUST TRUE
#ASSERT `s 169.1(5) young person` 17.99 EQUALS JUST TRUE
#ASSERT `s 169.1(5) young person` 18 EQUALS JUST FALSE   -- "a person under the age of 18 years"
#ASSERT `s 169.1(2) the person is considered to be in a position of trust, power or authority towards the young person` 18 EQUALS JUST TRUE   -- "by reason ... of being 18 years of age or more"
#ASSERT `s 169.1(2) the person is considered to be in a position of trust, power or authority towards the young person` 40 EQUALS JUST TRUE
#ASSERT `s 169.1(2) the person is considered to be in a position of trust, power or authority towards the young person` 17.99 EQUALS NOTHING   -- "among others": a person under 18 may be in such a position for another reason
-- (1): (the answer of (5), the answer of (2), another reason, knew under 18, reckless, what was done, to be a party to an offence, afterwards a party)
#ASSERT `s 169.1(1) the conduct is the offence of recruiting a young person to an offence` (JUST TRUE) (JUST TRUE) FALSE TRUE FALSE `s 169.1(1) recruits` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 169.1(1) the conduct is the offence of recruiting a young person to an offence` (JUST TRUE) (JUST TRUE) FALSE FALSE TRUE `s 169.1(1) counsels` TRUE TRUE EQUALS JUST TRUE   -- reckless as to the age
#ASSERT `s 169.1(1) the conduct is the offence of recruiting a young person to an offence` (JUST TRUE) NOTHING TRUE TRUE FALSE `s 169.1(1) encourages` TRUE TRUE EQUALS JUST TRUE   -- a position of trust for another reason
#ASSERT `s 169.1(1) the conduct is the offence of recruiting a young person to an offence` (JUST TRUE) (JUST TRUE) FALSE TRUE FALSE `s 169.1(1) invites` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 169.1(1) the conduct is the offence of recruiting a young person to an offence` (JUST TRUE) (JUST TRUE) FALSE TRUE FALSE `s 169.1(1) none of those` TRUE TRUE EQUALS NOTHING
#ASSERT `s 169.1(1) the conduct is the offence of recruiting a young person to an offence` (JUST TRUE) (JUST TRUE) FALSE FALSE FALSE `s 169.1(1) recruits` TRUE TRUE EQUALS NOTHING   -- neither knew nor was reckless
#ASSERT `s 169.1(1) the conduct is the offence of recruiting a young person to an offence` (JUST TRUE) NOTHING FALSE TRUE FALSE `s 169.1(1) recruits` TRUE TRUE EQUALS NOTHING   -- no position of trust, power or authority
#ASSERT `s 169.1(1) the conduct is the offence of recruiting a young person to an offence` (JUST FALSE) (JUST TRUE) FALSE TRUE FALSE `s 169.1(1) recruits` TRUE TRUE EQUALS NOTHING   -- not a young person
#ASSERT `s 169.1(1) the conduct is the offence of recruiting a young person to an offence` (JUST TRUE) (JUST TRUE) FALSE TRUE FALSE `s 169.1(1) recruits` FALSE TRUE EQUALS NOTHING   -- not to be a party to an offence
#ASSERT `s 169.1(1) the conduct is the offence of recruiting a young person to an offence` (JUST TRUE) (JUST TRUE) FALSE TRUE FALSE `s 169.1(1) recruits` TRUE FALSE EQUALS NOTHING   -- the young person was not afterwards a party to the offence
#ASSERT `s 169.1(3) the belief that the young person was at least 18 is not a defence: the bar applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 169.1(3) the belief that the young person was at least 18 is not a defence: the bar applies` TRUE TRUE EQUALS JUST FALSE   -- "unless the accused took reasonable steps"
#ASSERT `s 169.1(3) the belief that the young person was at least 18 is not a defence: the bar applies` FALSE FALSE EQUALS NOTHING
#ASSERT `s 169.1(4)(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 5) `no imprisonment is stated`
#ASSERT `s 169.1(4)(b) the punishment on summary conviction` `s 169.1 test s 787(1) penalty` EQUALS `s 169.1 test summary penalty`
#ASSERT `s 169.1 the class of the offence` EQUALS `ss 150 to 182 test both`

§ `s 170 and s 171`
-- 170: (parent, the answer of s 150 guardian, age of the person procured, for the purpose of prohibited sexual activity, with a person other than the parent or guardian)
#ASSERT `s 170 the conduct is the offence of a parent or guardian procuring a person under 18 for sexual activity` TRUE NOTHING 17 TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 170 the conduct is the offence of a parent or guardian procuring a person under 18 for sexual activity` FALSE (JUST TRUE) 17.99 TRUE TRUE EQUALS JUST TRUE   -- a guardian
#ASSERT `s 170 the conduct is the offence of a parent or guardian procuring a person under 18 for sexual activity` TRUE NOTHING 18 TRUE TRUE EQUALS NOTHING   -- 18 is not "under the age of 18 years"
#ASSERT `s 170 the conduct is the offence of a parent or guardian procuring a person under 18 for sexual activity` FALSE NOTHING 10 TRUE TRUE EQUALS NOTHING   -- neither a parent nor (shown to be) a guardian
#ASSERT `s 170 the conduct is the offence of a parent or guardian procuring a person under 18 for sexual activity` TRUE NOTHING 10 FALSE TRUE EQUALS NOTHING
#ASSERT `s 170 the conduct is the offence of a parent or guardian procuring a person under 18 for sexual activity` TRUE NOTHING 10 TRUE FALSE EQUALS NOTHING   -- the activity is with the parent or guardian
#ASSERT `s 170 the punishment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) (`ss 150 to 182 test a term of years` 1)
#ASSERT `s 170 the class of the offence` EQUALS `an indictable offence`
-- 171: (owner, occupier, manager or controller; knowingly permitted; age; for prohibited sexual activity)
#ASSERT `s 171 the conduct is the offence of a householder permitting prohibited sexual activity` TRUE TRUE 17 TRUE EQUALS JUST TRUE
#ASSERT `s 171 the conduct is the offence of a householder permitting prohibited sexual activity` TRUE TRUE 18 TRUE EQUALS NOTHING
#ASSERT `s 171 the conduct is the offence of a householder permitting prohibited sexual activity` FALSE TRUE 17 TRUE EQUALS NOTHING
#ASSERT `s 171 the conduct is the offence of a householder permitting prohibited sexual activity` TRUE FALSE 17 TRUE EQUALS NOTHING   -- not knowingly
#ASSERT `s 171 the conduct is the offence of a householder permitting prohibited sexual activity` TRUE TRUE 17 FALSE EQUALS NOTHING
#ASSERT `s 171 the punishment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) (`ss 150 to 182 test a term of years` 1)
#ASSERT `s 171 the class of the offence` EQUALS `an indictable offence`

