#ASSERT `s 172.2(1) the conduct is the offence of agreeing or arranging to commit a sexual offence against a child` TRUE (`Provision of the Code` OF 346, "(1)") 17 17 EQUALS NOTHING   -- section 346 is not in this section's lists
#ASSERT `s 172.2(2)(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) (`ss 150 to 182 test a term of years` 1)
#ASSERT `s 172.2(2)(b) the punishment on summary conviction` EQUALS `ss 150 to 182 test a summary punishment` `ss 150 to 182 test a term of two years less a day` (`ss 150 to 182 test a term of months` 6)
#ASSERT `s 172.2 the class of the offence` EQUALS `ss 150 to 182 test both`
#ASSERT `s 172.2(3) the evidence is proof that the accused believed that the person was under that age` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 172.2(3) the evidence is proof that the accused believed that the person was under that age` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 172.2(3) the evidence is proof that the accused believed that the person was under that age` FALSE FALSE EQUALS NOTHING
#ASSERT `s 172.2(4) the belief that the person was at least the age is not a defence: the bar applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 172.2(4) the belief that the person was at least the age is not a defence: the bar applies` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 172.2(4) the belief that the person was at least the age is not a defence: the bar applies` FALSE FALSE EQUALS NOTHING
-- (5)(a): (the charge is under (1), the answer of s 2 peace officer, acting under the direction of a peace officer)
#ASSERT `s 172.2(5)(a) it is not a defence that the person with whom the accused agreed was a peace officer or acting under the direction of one` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 172.2(5)(a) it is not a defence that the person with whom the accused agreed was a peace officer or acting under the direction of one` TRUE (JUST FALSE) TRUE EQUALS JUST TRUE   -- acting under the direction of a peace officer
#ASSERT `s 172.2(5)(a) it is not a defence that the person with whom the accused agreed was a peace officer or acting under the direction of one` TRUE (JUST FALSE) FALSE EQUALS NOTHING   -- neither
#ASSERT `s 172.2(5)(a) it is not a defence that the person with whom the accused agreed was a peace officer or acting under the direction of one` TRUE NOTHING FALSE EQUALS NOTHING   -- s 2 "peace officer" not answered
#ASSERT `s 172.2(5)(a) it is not a defence that the person with whom the accused agreed was a peace officer or acting under the direction of one` FALSE (JUST TRUE) FALSE EQUALS NOTHING   -- not a charge under (1)
