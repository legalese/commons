IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc31-forms-process`

-- ccc31-tests-process.l4 -- tests for ccc31-forms-process.l4 (Forms 28, 29, 29.1, 32, 34, 40 and 41).
-- Every expected value is written by hand from the text of the Form (line numbers are those of R.S.C.-1985-c.-C-46.txt), before the run.

§ `Form 28 (Section 528) -- Endorsement of Warrant (line 18522)`

-- In accordance with the application, signed by a justice, the arrest within the territorial division: authorized.
#ASSERT `form 28 the endorsement authorizes the arrest of the accused` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
-- Not made in accordance with an application; the signer not shown to be a justice (s 2 says NOTHING or says no): not covered.
#ASSERT `form 28 the endorsement authorizes the arrest of the accused` FALSE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `form 28 the endorsement authorizes the arrest of the accused` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `form 28 the endorsement authorizes the arrest of the accused` TRUE (JUST FALSE) TRUE EQUALS NOTHING
-- The arrest outside the territorial division the endorsement names: "within the (territorial division)" limits the grant, so not covered, not FALSE.
#ASSERT `form 28 the endorsement authorizes the arrest of the accused` TRUE (JUST TRUE) FALSE EQUALS NOTHING

§ `Form 29 (Section 507) -- Endorsement of Warrant (line 18533)`

-- Issued under section 507, 508 or 512, for an offence other than one mentioned in section 522 (s 522 answers: not mentioned): release under section 499 authorized.
#ASSERT `form 29 the endorsement authorizes the release of the accused under section 499` (`Provision of the Code` OF 507, "") (JUST FALSE) EQUALS JUST TRUE
#ASSERT `form 29 the endorsement authorizes the release of the accused under section 499` (`Provision of the Code` OF 508, "") (JUST FALSE) EQUALS JUST TRUE
#ASSERT `form 29 the endorsement authorizes the release of the accused under section 499` (`Provision of the Code` OF 512, "") (JUST FALSE) EQUALS JUST TRUE
-- Issued under another section (506, 509, 511.1): not covered.
#ASSERT `form 29 the endorsement authorizes the release of the accused under section 499` (`Provision of the Code` OF 506, "") (JUST FALSE) EQUALS NOTHING
#ASSERT `form 29 the endorsement authorizes the release of the accused under section 499` (`Provision of the Code` OF 509, "") (JUST FALSE) EQUALS NOTHING
-- The offence is one mentioned in section 522 (fork F17), or s 522's answer is not covered: not covered.
#ASSERT `form 29 the endorsement authorizes the release of the accused under section 499` (`Provision of the Code` OF 507, "") (JUST TRUE) EQUALS NOTHING
#ASSERT `form 29 the endorsement authorizes the release of the accused under section 499` (`Provision of the Code` OF 507, "") NOTHING EQUALS NOTHING

§ `Form 29.1 (Subsection 705(4)) -- Endorsement of Witness -- Warrant (lines 18541-18542)`

-- A warrant under subsection 705(1) for a witness served with a subpoena, the conditions met: release authorized.
#ASSERT `form 29.1 the endorsement authorizes the release of the witness` (`Provision of the Code` OF 705, "(1)") TRUE FALSE TRUE EQUALS JUST TRUE
-- A warrant under subsection 705(2) for a witness bound by a recognizance.
#ASSERT `form 29.1 the endorsement authorizes the release of the witness` (`Provision of the Code` OF 705, "(2)") FALSE TRUE TRUE EQUALS JUST TRUE
-- A warrant under 705(4), or another section: not covered.
#ASSERT `form 29.1 the endorsement authorizes the release of the witness` (`Provision of the Code` OF 705, "(4)") TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `form 29.1 the endorsement authorizes the release of the witness` (`Provision of the Code` OF 704, "(1)") TRUE FALSE TRUE EQUALS NOTHING
-- Neither served with a subpoena nor bound by a recognizance: not covered.
#ASSERT `form 29.1 the endorsement authorizes the release of the witness` (`Provision of the Code` OF 705, "(1)") FALSE FALSE TRUE EQUALS NOTHING
-- "This endorsement is subject to the following conditions": a condition not met: the release is not authorized (marginal reading (a) of NOTES.md).
#ASSERT `form 29.1 the endorsement authorizes the release of the witness` (`Provision of the Code` OF 705, "(1)") TRUE FALSE FALSE EQUALS JUST FALSE

§ `Form 32 -- Recognizance`

§§ `Part 2 (line 18580): "if I fail to comply with any of the conditions listed below, this amount or security may be forfeited"`

#ASSERT `form 32 part 2 the amount or security may be forfeited` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `form 32 part 2 the amount or security may be forfeited` FALSE EQUALS JUST FALSE; the function is named for a power ("may be forfeited") and its "if ... fail to comply" gate failed, so the name-test sweep answers NOTHING, not JUST FALSE (the facts are unchanged)
#ASSERT `form 32 part 2 the amount or security may be forfeited` FALSE EQUALS NOTHING

§§ `Part 3 (lines 18581-18582): list the conditions ordered and the duration of each`

#ASSERT `form 32 part 3 the recognizance lists the conditions ordered and the duration of each` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `form 32 part 3 the recognizance lists the conditions ordered and the duration of each` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `form 32 part 3 the recognizance lists the conditions ordered and the duration of each` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `form 32 part 3 the recognizance lists the conditions ordered and the duration of each` FALSE FALSE FALSE EQUALS NOTHING

§§ `Part 4 (lines 18583-18584): "I may apply to a judge or a justice of the peace to have any condition in this form cancelled or varied"`

#ASSERT `form 32 part 4 the person may apply to cancel or vary a condition` TRUE TRUE EQUALS JUST TRUE
-- A condition that is not in this form, or an application to someone other than a judge or a justice of the peace: not covered.
#ASSERT `form 32 part 4 the person may apply to cancel or vary a condition` FALSE TRUE EQUALS NOTHING
#ASSERT `form 32 part 4 the person may apply to cancel or vary a condition` TRUE FALSE EQUALS NOTHING

§§ `Part 5 (lines 18585-18586): the conditions remain in effect until cancelled or changed or until discharged, sentenced or otherwise detained`

#ASSERT `form 32 part 5 the conditions remain in effect` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `form 32 part 5 the conditions remain in effect` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `form 32 part 5 the conditions remain in effect` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `form 32 part 5 the conditions remain in effect` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `form 32 part 5 the conditions remain in effect` FALSE FALSE FALSE TRUE EQUALS JUST FALSE

§§ `Part 6 (lines 18588-18599): the person, the surety, the Surety Declaration`

#ASSERT `form 32 part 6 the person must comply with the condition` TRUE TRUE EQUALS JUST TRUE
#ASSERT `form 32 part 6 the person must comply with the condition` FALSE TRUE EQUALS NOTHING
#ASSERT `form 32 part 6 the person must comply with the condition` TRUE FALSE EQUALS NOTHING
#ASSERT `form 32 part 6 the money the surety has promised or deposited may be forfeited` TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was #ASSERT `form 32 part 6 the money the surety has promised or deposited may be forfeited` FALSE EQUALS JUST FALSE; the function is named for a power ("may be forfeited") and its "if ... fail to comply" gate failed, so the name-test sweep answers NOTHING, not JUST FALSE (the facts are unchanged)
#ASSERT `form 32 part 6 the money the surety has promised or deposited may be forfeited` FALSE EQUALS NOTHING
-- Surety Declaration attached; surety excepted; both; neither; no surety ("if applicable").
#ASSERT `form 32 part 6 the surety declaration box that applies` TRUE TRUE FALSE EQUALS JUST `form 32 surety declaration attached (section 515.1)`
#ASSERT `form 32 part 6 the surety declaration box that applies` TRUE FALSE TRUE EQUALS JUST `form 32 surety excepted from providing a surety declaration (subsection 515.1(2))`
#ASSERT `form 32 part 6 the surety declaration box that applies` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `form 32 part 6 the surety declaration box that applies` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `form 32 part 6 the surety declaration box that applies` FALSE TRUE FALSE EQUALS NOTHING

§§ `List of Conditions (lines 18608-18632): the sections each condition is listed for`

-- (a) has a surety (sections 462.34, 490.9, 550, 779, 810, 817 and 832): all seven, and a section next to each of them.
#ASSERT `form 32 the sections the condition is listed for` `form 32 condition (a) has a surety` EQUALS LIST 462.34, 490.9, 550, 779, 810, 817, 832
#ASSERT `form 32 the condition is listed for the section` `form 32 condition (a) has a surety` (`Provision of the Code` OF 462.34, "") EQUALS JUST TRUE
#ASSERT `form 32 the condition is listed for the section` `form 32 condition (a) has a surety` (`Provision of the Code` OF 490.9, "") EQUALS JUST TRUE
#ASSERT `form 32 the condition is listed for the section` `form 32 condition (a) has a surety` (`Provision of the Code` OF 550, "") EQUALS JUST TRUE
#ASSERT `form 32 the condition is listed for the section` `form 32 condition (a) has a surety` (`Provision of the Code` OF 779, "") EQUALS JUST TRUE
#ASSERT `form 32 the condition is listed for the section` `form 32 condition (a) has a surety` (`Provision of the Code` OF 810, "") EQUALS JUST TRUE
#ASSERT `form 32 the condition is listed for the section` `form 32 condition (a) has a surety` (`Provision of the Code` OF 817, "") EQUALS JUST TRUE
#ASSERT `form 32 the condition is listed for the section` `form 32 condition (a) has a surety` (`Provision of the Code` OF 832, "") EQUALS JUST TRUE
#ASSERT `form 32 the condition is listed for the section` `form 32 condition (a) has a surety` (`Provision of the Code` OF 810.01, "") EQUALS NOTHING
#ASSERT `form 32 the condition is listed for the section` `form 32 condition (a) has a surety` (`Provision of the Code` OF 551, "") EQUALS NOTHING
-- (b) and (c): sections 83.3, 810, 810.01, 810.03, 810.1 and 810.2.
#ASSERT `form 32 the sections the condition is listed for` `form 32 condition (b) agrees to keep the peace and be of good behaviour` EQUALS LIST 83.3, 810, 810.01, 810.03, 810.1, 810.2
#ASSERT `form 32 the condition is listed for the section` `form 32 condition (c) abstains from possessing a firearm and the other things listed, and surrenders them and the documents` (`Provision of the Code` OF 83.3, "") EQUALS JUST TRUE
