-- no probation order is made
#ASSERT `s 732.1(5)(a) the court must cause a copy of the order to be given to the victim` FALSE TRUE EQUALS NOTHING

§ `s 732.1(6): a failure to comply with subsection (5)`

#ASSERT `s 732.1(6) the failure leaves the validity of the probation order unaffected` TRUE EQUALS JUST TRUE
-- no failure to comply with subsection (5): the subsection says nothing
#ASSERT `s 732.1(6) the failure leaves the validity of the probation order unaffected` FALSE EQUALS NOTHING

§ `s 732.1(7): the notice for samples at regular intervals`

#ASSERT `s 732.1(7) the notice specifies what the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
-- no places
#ASSERT `s 732.1(7) the notice specifies what the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
-- no times
#ASSERT `s 732.1(7) the notice specifies what the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
-- no days
#ASSERT `s 732.1(7) the notice specifies what the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- exactly 24 hours
#ASSERT `s 732.1(7) the first sample is taken as the subsection allows` 24 EQUALS JUST TRUE
#ASSERT `s 732.1(7) the first sample is taken as the subsection allows` 48 EQUALS JUST TRUE
-- earlier than 24 hours
#ASSERT `s 732.1(7) the first sample is taken as the subsection allows` 23 EQUALS JUST FALSE
-- exactly seven days
#ASSERT `s 732.1(7) the subsequent samples are taken as the subsection requires` TRUE 7 EQUALS JUST TRUE
#ASSERT `s 732.1(7) the subsequent samples are taken as the subsection requires` TRUE 14 EQUALS JUST TRUE
-- less than seven days
#ASSERT `s 732.1(7) the subsequent samples are taken as the subsection requires` TRUE 6 EQUALS JUST FALSE
-- not at regular intervals
#ASSERT `s 732.1(7) the subsequent samples are taken as the subsection requires` FALSE 14 EQUALS JUST FALSE

§ `s 732.1(10): samples and records may be handled only in accordance with the designations and specifications`

#ASSERT `s 732.1(10) the act is done in accordance with the designations and specifications made under subsection 732.1(8)` TRUE TRUE EQUALS JUST TRUE
-- "may not be taken, analyzed, ... except in accordance with the designations and specifications"
#ASSERT `s 732.1(10) the act is done in accordance with the designations and specifications made under subsection 732.1(8)` TRUE FALSE EQUALS JUST FALSE
-- not an act the subsection restricts
#ASSERT `s 732.1(10) the act is done in accordance with the designations and specifications made under subsection 732.1(8)` FALSE FALSE EQUALS NOTHING

§ `s 732.1(11): the Attorney General must cause the samples to be destroyed within the periods prescribed by regulation, unless they are reasonably expected to be used as evidence`

#ASSERT `s 732.1(11) the Attorney General must cause the samples to be destroyed within the periods prescribed by regulation` TRUE FALSE EQUALS JUST TRUE
-- "unless the samples are reasonably expected to be used as evidence in a proceeding for an offence under section 733.1"
#ASSERT `s 732.1(11) the Attorney General must cause the samples to be destroyed within the periods prescribed by regulation` TRUE TRUE EQUALS JUST FALSE
-- no samples provided under a probation order
#ASSERT `s 732.1(11) the Attorney General must cause the samples to be destroyed within the periods prescribed by regulation` FALSE FALSE EQUALS NOTHING
-- no samples
#ASSERT `s 732.1(11) the Attorney General's duty to cause the samples to be destroyed` FALSE FALSE 30 EQUALS FULFILLED
-- samples expected to be used as evidence: the duty does not arise
#ASSERT `s 732.1(11) the Attorney General's duty to cause the samples to be destroyed` TRUE TRUE 30 EQUALS FULFILLED
-- destroyed on day 20 of 30: fulfilled
#TRACE `s 732.1(11) the Attorney General's duty to cause the samples to be destroyed` TRUE FALSE 30 AT 0 WITH
    PARTY `the Attorney General` DOES `s 732.1(11) cause all samples of bodily substances provided under a probation order to be destroyed` AT 20
-- not destroyed by day 31 of 30: breach
#TRACE `s 732.1(11) the Attorney General's duty to cause the samples to be destroyed` TRUE FALSE 30 AT 0 WITH
    (WAITUNTIL 31)
