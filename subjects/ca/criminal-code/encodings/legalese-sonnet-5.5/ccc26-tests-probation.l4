IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc26-interpretation`
IMPORT `ccc26-probation`

-- ccc26-tests-probation.l4 -- tests for ccc26-probation.l4. Every expected value is written from the text before the run.
-- (sections 731, 731.1, 732 and 732.1(2) to (7); lines 15497-15571 of the text)


§ `s 731(1)(a): the court may suspend the passing of sentence and release the offender on probation conditions if no minimum punishment is prescribed`

-- convicted; the offence has no minimum punishment
#ASSERT `s 731(1)(a) the court may suspend the passing of sentence and direct that the offender be released on the conditions prescribed in a probation order` TRUE (JUST FALSE) EQUALS JUST TRUE
-- "Where a person is convicted": no conviction
#ASSERT `s 731(1)(a) the court may suspend the passing of sentence and direct that the offender be released on the conditions prescribed in a probation order` FALSE (JUST FALSE) EQUALS JUST FALSE
-- no conviction, whatever the minimum: the "Where" gate comes first
#ASSERT `s 731(1)(a) the court may suspend the passing of sentence and direct that the offender be released on the conditions prescribed in a probation order` FALSE (JUST TRUE) EQUALS JUST FALSE
-- a minimum punishment is prescribed: the "if" gate of the grant is not met
#ASSERT `s 731(1)(a) the court may suspend the passing of sentence and direct that the offender be released on the conditions prescribed in a probation order` TRUE (JUST TRUE) EQUALS NOTHING
-- whether a minimum is prescribed is for the offence section
#ASSERT `s 731(1)(a) the court may suspend the passing of sentence and direct that the offender be released on the conditions prescribed in a probation order` TRUE NOTHING EQUALS NOTHING

§ `s 731(1)(b): a probation order in addition to a fine or to imprisonment for a term not exceeding two years`

-- a fine alone
#ASSERT `s 731(1)(b) the court may direct that the offender comply with the conditions prescribed in a probation order in addition to the fine or imprisonment` TRUE TRUE `no imprisonment is stated` EQUALS JUST TRUE
-- neither a fine nor imprisonment
#ASSERT `s 731(1)(b) the court may direct that the offender comply with the conditions prescribed in a probation order in addition to the fine or imprisonment` TRUE FALSE `no imprisonment is stated` EQUALS NOTHING
-- exactly two years: "not exceeding two years"
#ASSERT `s 731(1)(b) the court may direct that the offender comply with the conditions prescribed in a probation order in addition to the fine or imprisonment` TRUE FALSE (`imprisonment for a term of` `two years`) EQUALS JUST TRUE
#ASSERT `s 731(1)(b) the court may direct that the offender comply with the conditions prescribed in a probation order in addition to the fine or imprisonment` TRUE FALSE (`imprisonment for a term of` `two years less a day`) EQUALS JUST TRUE
-- a fine and ninety days
#ASSERT `s 731(1)(b) the court may direct that the offender comply with the conditions prescribed in a probation order in addition to the fine or imprisonment` TRUE TRUE (`imprisonment for a term of` `ninety days`) EQUALS JUST TRUE
-- two years and one day: outside the limit of the grant
#ASSERT `s 731(1)(b) the court may direct that the offender comply with the conditions prescribed in a probation order in addition to the fine or imprisonment` TRUE FALSE (`imprisonment for a term of` (`Length of time` OF 2, 0, 1, FALSE)) EQUALS NOTHING
#ASSERT `s 731(1)(b) the court may direct that the offender comply with the conditions prescribed in a probation order in addition to the fine or imprisonment` TRUE FALSE (`imprisonment for a term of` `five years`) EQUALS NOTHING
-- imprisonment for life: outside the limit of the grant
#ASSERT `s 731(1)(b) the court may direct that the offender comply with the conditions prescribed in a probation order in addition to the fine or imprisonment` TRUE FALSE `imprisonment for life` EQUALS NOTHING
-- "Where a person is convicted": no conviction
#ASSERT `s 731(1)(b) the court may direct that the offender comply with the conditions prescribed in a probation order in addition to the fine or imprisonment` FALSE TRUE (`imprisonment for a term of` `ninety days`) EQUALS JUST FALSE
#ASSERT `s 731(1)(b) the term of imprisonment is at most two years` (`imprisonment for a term of` `two years`) EQUALS JUST TRUE
#ASSERT `s 731(1)(b) the term of imprisonment is at most two years` (`imprisonment for a term of` (`Length of time` OF 2, 0, 1, FALSE)) EQUALS JUST FALSE
#ASSERT `s 731(1)(b) the term of imprisonment is at most two years` `imprisonment for life` EQUALS JUST FALSE
#ASSERT `s 731(1)(b) the term of imprisonment is at most two years` `no imprisonment is stated` EQUALS NOTHING

§ `s 731(2): a probation order where the court discharges an accused under subsection 730(1)`

#ASSERT `s 731(2) the court may make a probation order` TRUE EQUALS JUST TRUE
-- "where it discharges an accused under subsection 730(1)"
#ASSERT `s 731(2) the court may make a probation order` FALSE EQUALS JUST FALSE
#ASSERT `s 731(3.1), repealed` EQUALS "[Repealed, 1997, c. 17, s. 1]"

§ `s 731.1: firearms and similar prohibitions`

#ASSERT `s 731.1(1) the court must consider whether section 109 or 110 is applicable` TRUE EQUALS JUST TRUE
-- "Before making a probation order"
#ASSERT `s 731.1(1) the court must consider whether section 109 or 110 is applicable` FALSE EQUALS JUST FALSE
#ASSERT `s 731.1(2) the condition leaves the operation of section 109 or 110 unaffected` TRUE EQUALS JUST TRUE
-- a condition that is not the one in paragraph 732.1(3)(d): the subsection says nothing
#ASSERT `s 731.1(2) the condition leaves the operation of section 109 or 110 unaffected` FALSE EQUALS NOTHING

§ `s 732(1): intermittent sentence where the sentence is ninety days or less`

-- exactly ninety days
#ASSERT `s 732(1)(a) the court may order that the sentence be served intermittently at such times as are specified in the order` TRUE `ninety days` EQUALS JUST TRUE
#ASSERT `s 732(1)(a) the court may order that the sentence be served intermittently at such times as are specified in the order` TRUE (`Length of time` OF 0, 0, 89, FALSE) EQUALS JUST TRUE
-- ninety days less a day
#ASSERT `s 732(1)(a) the court may order that the sentence be served intermittently at such times as are specified in the order` TRUE (`Length of time` OF 0, 0, 90, TRUE) EQUALS JUST TRUE
-- ninety-one days: outside the "Where" clause
#ASSERT `s 732(1)(a) the court may order that the sentence be served intermittently at such times as are specified in the order` TRUE (`Length of time` OF 0, 0, 91, FALSE) EQUALS JUST FALSE
-- six months is over ninety days in every calendar
#ASSERT `s 732(1)(a) the court may order that the sentence be served intermittently at such times as are specified in the order` TRUE `six months` EQUALS JUST FALSE
#ASSERT `s 732(1)(a) the court may order that the sentence be served intermittently at such times as are specified in the order` TRUE `two years less a day` EQUALS JUST FALSE
-- three months is 89 to 92 days: the calendar decides
#ASSERT `s 732(1)(a) the court may order that the sentence be served intermittently at such times as are specified in the order` TRUE (`Length of time` OF 0, 3, 0, FALSE) EQUALS NOTHING
-- no sentence of imprisonment imposed on a convicted offender
#ASSERT `s 732(1)(a) the court may order that the sentence be served intermittently at such times as are specified in the order` FALSE `ninety days` EQUALS JUST FALSE
#ASSERT `s 732(1)(b) the court may order that the offender comply with the conditions prescribed in a probation order when not in confinement` TRUE `ninety days` EQUALS JUST TRUE
#ASSERT `s 732(1)(b) the court may order that the offender comply with the conditions prescribed in a probation order when not in confinement` TRUE (`Length of time` OF 0, 0, 91, FALSE) EQUALS JUST FALSE
#ASSERT `s 732(1)(b) the court may order that the offender comply with the conditions prescribed in a probation order when not in confinement` TRUE (`Length of time` OF 0, 3, 0, FALSE) EQUALS NOTHING
#ASSERT `s 732(1)(b) the court may order that the offender comply with the conditions prescribed in a probation order when not in confinement` FALSE `ninety days` EQUALS JUST FALSE

§ `s 732(2): the offender may apply to serve the sentence on consecutive days, on giving notice to the prosecutor`

#ASSERT `s 732(2) the offender may apply to the court that imposed the sentence to allow it to be served on consecutive days` TRUE TRUE EQUALS JUST TRUE
-- "on giving notice to the prosecutor"
#ASSERT `s 732(2) the offender may apply to the court that imposed the sentence to allow it to be served on consecutive days` TRUE FALSE EQUALS JUST FALSE
-- not an offender ordered to serve an intermittent sentence
#ASSERT `s 732(2) the offender may apply to the court that imposed the sentence to allow it to be served on consecutive days` FALSE TRUE EQUALS NOTHING

§ `s 732(3): a later sentence of imprisonment on a person subject to an intermittent sentence`

#ASSERT `s 732(3) the unexpired portion of the intermittent sentence is to be served on consecutive days` TRUE FALSE EQUALS JUST TRUE
-- "unless the court otherwise orders"
#ASSERT `s 732(3) the unexpired portion of the intermittent sentence is to be served on consecutive days` TRUE TRUE EQUALS JUST FALSE
-- the "Where" gate fails
#ASSERT `s 732(3) the unexpired portion of the intermittent sentence is to be served on consecutive days` FALSE FALSE EQUALS JUST FALSE

§ `s 732.1(2): the compulsory conditions`

#ASSERT `s 732.1(2) the court must prescribe the condition as a condition of the probation order` TRUE `s 732.1(2)(a) keep the peace and be of good behaviour` EQUALS JUST TRUE
#ASSERT `s 732.1(2) the court must prescribe the condition as a condition of the probation order` TRUE `s 732.1(2)(b) appear before the court when required to do so by the court` EQUALS JUST TRUE
#ASSERT `s 732.1(2) the court must prescribe the condition as a condition of the probation order` TRUE `s 732.1(2)(c) notify the court or the probation officer in advance of any change of name or address, and promptly notify them of any change of employment or occupation` EQUALS JUST TRUE
-- the subsection names three conditions and says nothing of others
#ASSERT `s 732.1(2) the court must prescribe the condition as a condition of the probation order` TRUE `s 732.1(2) another condition` EQUALS NOTHING
-- no probation order is made
#ASSERT `s 732.1(2) the court must prescribe the condition as a condition of the probation order` FALSE `s 732.1(2)(a) keep the peace and be of good behaviour` EQUALS NOTHING
#ASSERT `s 732.1(2)(a.1), repealed` EQUALS "[Repealed, 2019, c. 25, s. 297]"
#ASSERT `s 732.1(2.1), repealed` EQUALS "[Repealed, 2019, c. 25, s. 297]"
#ASSERT `s 732.1(2.2), repealed` EQUALS "[Repealed, 2019, c. 25, s. 297]"

§ `s 732.1(3): the optional conditions`

#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(a.1) abstain from communicating, directly or indirectly, with any victim, witness or other person identified in the order or from going to any place or geographic area specified in the order` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(b) remain within the jurisdiction of the court unless written permission to go outside it is obtained from the court or the probation officer` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(c) abstain from the consumption of drugs except in accordance with a medical prescription, of alcohol or of any other intoxicating substance` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(c.1) provide a sample of a bodily substance on the demand of a peace officer, a probation officer or a person designated to make a demand` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(d) abstain from owning, possessing or carrying a weapon` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(e) provide for the support or care of dependants` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(f) perform community service` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- report to a probation officer
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(a) report to a probation officer within two working days, or such longer period as the court directs, after the making of the probation order, and thereafter when required by the probation officer` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- no probation order is made
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` FALSE `s 732.1(3)(a) report to a probation officer within two working days, or such longer period as the court directs, after the making of the probation order, and thereafter when required by the probation officer` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- a condition the paragraphs do not list
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3) another kind of condition` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(g) participate actively in a treatment program approved by the province` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- "if the offender agrees": not met
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(g) participate actively in a treatment program approved by the province` FALSE TRUE FALSE FALSE EQUALS NOTHING
-- "subject to the program director's acceptance of the offender": not met
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(g) participate actively in a treatment program approved by the province` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- the province has established the program
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(g.1) attend at a treatment facility designated by the lieutenant governor in council for assessment and curative treatment` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- "where the lieutenant governor in council ... has established a program": no program
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(g.1) attend at a treatment facility designated by the lieutenant governor in council for assessment and curative treatment` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(g.2) comply with a program governing the use of an alcohol ignition interlock device` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- "if the offender agrees to participate in the program": not met
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(g.2) comply with a program governing the use of an alcohol ignition interlock device` FALSE FALSE TRUE FALSE EQUALS NOTHING
-- no program established
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(g.2) comply with a program governing the use of an alcohol ignition interlock device` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- no program: the "where" gate is read first
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(g.2) comply with a program governing the use of an alcohol ignition interlock device` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- a condition of the order requires abstention
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(c.2) provide a sample of a bodily substance at regular intervals specified by a probation officer in a notice in Form 51` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- "if a condition of the order requires the offender to abstain": not met
#ASSERT `s 732.1(3) the court may prescribe the condition as an additional condition of the probation order` TRUE `s 732.1(3)(c.2) provide a sample of a bodily substance at regular intervals specified by a probation officer in a notice in Form 51` FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `s 732.1(3)(a)(i): the offender must report within two working days, or such longer period as the court directs`

#ASSERT `s 732.1(3)(a)(i) the offender must report to a probation officer after the making of the order` TRUE EQUALS JUST TRUE
-- the court did not prescribe that condition
#ASSERT `s 732.1(3)(a)(i) the offender must report to a probation officer after the making of the order` FALSE EQUALS NOTHING
-- no such condition prescribed
#ASSERT `s 732.1(3)(a)(i) the offender's duty to report to a probation officer after the making of the order` FALSE 2 EQUALS FULFILLED
-- reported on day 1 of 2: fulfilled
#TRACE `s 732.1(3)(a)(i) the offender's duty to report to a probation officer after the making of the order` TRUE 2 AT 0 WITH
    PARTY `the offender` DOES `s 732.1(3)(a)(i) report to a probation officer after the making of the probation order` AT 1
-- nothing by day 3 of 2: breach
#TRACE `s 732.1(3)(a)(i) the offender's duty to report to a probation officer after the making of the order` TRUE 2 AT 0 WITH
    (WAITUNTIL 3)

§ `s 732.1(3)(f): up to 240 hours of community service over a period not exceeding eighteen months`

-- exactly at both limits
#ASSERT `s 732.1(3)(f) the court may prescribe the community service as an additional condition of the probation order` TRUE 240 18 EQUALS JUST TRUE
#ASSERT `s 732.1(3)(f) the court may prescribe the community service as an additional condition of the probation order` TRUE 100 6 EQUALS JUST TRUE
-- 241 hours: outside the limit of the grant
#ASSERT `s 732.1(3)(f) the court may prescribe the community service as an additional condition of the probation order` TRUE 241 18 EQUALS NOTHING
-- 19 months: outside the limit of the grant
#ASSERT `s 732.1(3)(f) the court may prescribe the community service as an additional condition of the probation order` TRUE 240 19 EQUALS NOTHING
-- no probation order is made
#ASSERT `s 732.1(3)(f) the court may prescribe the community service as an additional condition of the probation order` FALSE 100 6 EQUALS NOTHING

§ `s 732.1(3)(h): other reasonable conditions the court considers desirable, subject to regulations under subsection 738(2)`

#ASSERT `s 732.1(3)(h) the court may prescribe the other condition as an additional condition of the probation order` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- not reasonable, or not one the court considers desirable
#ASSERT `s 732.1(3)(h) the court may prescribe the other condition as an additional condition of the probation order` TRUE FALSE TRUE FALSE EQUALS NOTHING
-- not for the purposes the paragraph names
#ASSERT `s 732.1(3)(h) the court may prescribe the other condition as an additional condition of the probation order` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- a regulation under subsection 738(2) bars it: the regulation is outside this text
#ASSERT `s 732.1(3)(h) the court may prescribe the other condition as an additional condition of the probation order` TRUE TRUE TRUE TRUE EQUALS NOTHING
-- no probation order is made
#ASSERT `s 732.1(3)(h) the court may prescribe the other condition as an additional condition of the probation order` FALSE TRUE TRUE FALSE EQUALS NOTHING

§ `s 732.1(3.1): the optional conditions for an organization`

#ASSERT `s 732.1(3.1) the court may prescribe the condition as an additional condition of the probation order made in respect of an organization` TRUE `s 732.1(3.1)(a) make restitution to a person for any loss or damage that they suffered as a result of the offence` FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(3.1) the court may prescribe the condition as an additional condition of the probation order made in respect of an organization` TRUE `s 732.1(3.1)(b) establish policies, standards and procedures to reduce the likelihood of the organization committing a subsequent offence` FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(3.1) the court may prescribe the condition as an additional condition of the probation order made in respect of an organization` TRUE `s 732.1(3.1)(c) communicate those policies, standards and procedures to its representatives` FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(3.1) the court may prescribe the condition as an additional condition of the probation order made in respect of an organization` TRUE `s 732.1(3.1)(d) report to the court on the implementation of those policies, standards and procedures` FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(3.1) the court may prescribe the condition as an additional condition of the probation order made in respect of an organization` TRUE `s 732.1(3.1)(e) identify the senior officer who is responsible for compliance with those policies, standards and procedures` FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(3.1) the court may prescribe the condition as an additional condition of the probation order made in respect of an organization` TRUE `s 732.1(3.1)(f) provide to the public, in the manner specified by the court, the offence, the sentence and the measures the organization is taking` FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(3.1) the court may prescribe the condition as an additional condition of the probation order made in respect of an organization` TRUE `s 732.1(3.1)(g) comply with any other reasonable conditions that the court considers desirable to prevent the organization from committing subsequent offences or to remedy the harm caused by the offence` TRUE EQUALS JUST TRUE
-- not a condition the paragraph describes
#ASSERT `s 732.1(3.1) the court may prescribe the condition as an additional condition of the probation order made in respect of an organization` TRUE `s 732.1(3.1)(g) comply with any other reasonable conditions that the court considers desirable to prevent the organization from committing subsequent offences or to remedy the harm caused by the offence` FALSE EQUALS NOTHING
-- not a probation order made in respect of an organization
#ASSERT `s 732.1(3.1) the court may prescribe the condition as an additional condition of the probation order made in respect of an organization` FALSE `s 732.1(3.1)(a) make restitution to a person for any loss or damage that they suffered as a result of the offence` FALSE EQUALS NOTHING
#ASSERT `s 732.1(3.1) the court may prescribe the condition as an additional condition of the probation order made in respect of an organization` TRUE `s 732.1(3.1) another kind of condition` FALSE EQUALS NOTHING
#ASSERT `s 732.1(3.2) the court must consider whether another regulatory body would be more appropriate to supervise the policies, standards and procedures` TRUE EQUALS JUST TRUE
-- "Before making an order under paragraph (3.1)(b)"
#ASSERT `s 732.1(3.2) the court must consider whether another regulatory body would be more appropriate to supervise the policies, standards and procedures` FALSE EQUALS JUST FALSE

§ `s 732.1(4): form and period of the order`

#ASSERT `s 732.1(4) a probation order may be in Form 46` TRUE EQUALS JUST TRUE
-- the subsection permits Form 46 and says nothing of other forms
#ASSERT `s 732.1(4) a probation order may be in Form 46` FALSE EQUALS NOTHING
#ASSERT `s 732.1(4) the court must specify the period for which the order is to remain in force` TRUE EQUALS JUST TRUE
-- no probation order is made
#ASSERT `s 732.1(4) the court must specify the period for which the order is to remain in force` FALSE EQUALS NOTHING

§ `s 732.1(5): the court's obligations on making a probation order`

#ASSERT `s 732.1(5)(a) the court must cause a copy of the order to be given to the offender` TRUE EQUALS JUST TRUE
-- no probation order is made
#ASSERT `s 732.1(5)(a) the court must cause a copy of the order to be given to the offender` FALSE EQUALS NOTHING
#ASSERT `s 732.1(5)(b) the court must explain the conditions of the order and the substance of section 733.1 to the offender` TRUE EQUALS JUST TRUE
-- no probation order is made
#ASSERT `s 732.1(5)(b) the court must explain the conditions of the order and the substance of section 733.1 to the offender` FALSE EQUALS NOTHING
#ASSERT `s 732.1(5)(c) the court must cause an explanation to be given to the offender of the procedure for applying for a change to the optional conditions` TRUE EQUALS JUST TRUE
-- no probation order is made
#ASSERT `s 732.1(5)(c) the court must cause an explanation to be given to the offender of the procedure for applying for a change to the optional conditions` FALSE EQUALS NOTHING
#ASSERT `s 732.1(5)(d) the court must take reasonable measures to ensure that the offender understands the order and the explanations` TRUE EQUALS JUST TRUE
-- no probation order is made
#ASSERT `s 732.1(5)(d) the court must take reasonable measures to ensure that the offender understands the order and the explanations` FALSE EQUALS NOTHING
-- on request
#ASSERT `s 732.1(5)(a) the court must cause a copy of the order to be given to the victim` TRUE TRUE EQUALS JUST TRUE
-- "on request": no request
