IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc9-support`
IMPORT `ccc9-assault-officer`

-- ccc9-tests-assault-officer.l4 -- tests for ss 270 to 270.1. Every expected value is written by hand from the text (the line numbers of
-- the Criminal Code text file are cited beside the assertion), never copied from the output of the code under test.
-- A fixture for the seam input s 787(1): "Unless otherwise provided by law, every person who is convicted of an offence punishable on summary
-- conviction is liable to a fine of not more than $5,000 or to a term of imprisonment of not more than two years less a day, or to both" (text line 16717).
`s 270 test: the s 787(1) general penalty` MEANS Punishment OF `on summary conviction`, (`imprisonment for a term of` `two years less a day`), `no imprisonment is stated`, (`a fine of` 5000), `no fine is stated`

§ `s 270(1): the offence`

-- Field order of `s 270(1) facts`:
--   assault(s 265), public officer, peace officer, in execution of duty, aiding such an officer, intent to resist arrest, arrest lawful, lawful process, lawful distress, intent to rescue
-- (a) a peace officer engaged in the execution of his duty is assaulted (lines 5033-5034)
`s 270(1) test: assault on a peace officer on duty` MEANS `s 270(1) facts` OF (JUST TRUE), (JUST FALSE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
-- (a) a public officer engaged in the execution of his duty (the text names "a public officer or peace officer")
`s 270(1) test: assault on a public officer on duty` MEANS `s 270(1) facts` OF (JUST TRUE), (JUST TRUE), (JUST FALSE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
-- (a) a peace officer NOT engaged in the execution of his duty: outside the limb
`s 270(1) test: assault on a peace officer off duty` MEANS `s 270(1) facts` OF (JUST TRUE), (JUST FALSE), (JUST TRUE), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
-- (a) "or a person acting in aid of such an officer"
`s 270(1) test: assault on a person aiding an officer` MEANS `s 270(1) facts` OF (JUST TRUE), (JUST FALSE), (JUST FALSE), FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
-- no assault at all, every other fact true
`s 270(1) test: no assault` MEANS `s 270(1) facts` OF (JUST FALSE), (JUST TRUE), (JUST TRUE), TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE
-- s 265 not covered (NOTHING), officer on duty
`s 270(1) test: assault not covered, officer on duty` MEANS `s 270(1) facts` OF NOTHING, (JUST FALSE), (JUST TRUE), TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
-- s 265 not covered (NOTHING) and the officer element fails: the text's no for the limb stays a no
`s 270(1) test: assault not covered, no officer` MEANS `s 270(1) facts` OF NOTHING, (JUST FALSE), (JUST FALSE), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
-- (b) intent to resist a lawful arrest
`s 270(1) test: assault to resist a lawful arrest` MEANS `s 270(1) facts` OF (JUST TRUE), (JUST FALSE), (JUST FALSE), FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE
-- (b) the arrest is not lawful
`s 270(1) test: assault to resist an unlawful arrest` MEANS `s 270(1) facts` OF (JUST TRUE), (JUST FALSE), (JUST FALSE), FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
-- (b) no intent to resist
`s 270(1) test: assault, arrest lawful, no intent` MEANS `s 270(1) facts` OF (JUST TRUE), (JUST FALSE), (JUST FALSE), FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
-- (c)(i) person executing a lawful process against lands or goods
`s 270(1) test: assault on a person executing a process` MEANS `s 270(1) facts` OF (JUST TRUE), (JUST FALSE), (JUST FALSE), FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
-- (c)(i) person making a lawful distress or seizure
`s 270(1) test: assault on a person making a distress` MEANS `s 270(1) facts` OF (JUST TRUE), (JUST FALSE), (JUST FALSE), FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
-- (c)(ii) intent to rescue
`s 270(1) test: assault to rescue a thing taken under lawful process` MEANS `s 270(1) facts` OF (JUST TRUE), (JUST FALSE), (JUST FALSE), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
-- a simple assault on a private person: no limb
`s 270(1) test: assault on a private person` MEANS `s 270(1) facts` OF (JUST TRUE), (JUST FALSE), (JUST FALSE), FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
-- (b) holds while s 265 is not covered: NOTHING for (b); the other limbs are no
`s 270(1) test: arrest-resisting intent, assault not covered` MEANS `s 270(1) facts` OF NOTHING, (JUST FALSE), (JUST FALSE), FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE

#ASSERT `s 270(1)(a) the accused assaults an officer in the execution of his duty or a person acting in aid of one` `s 270(1) test: assault on a peace officer on duty` EQUALS JUST TRUE
#ASSERT `s 270(1)(a) the accused assaults an officer in the execution of his duty or a person acting in aid of one` `s 270(1) test: assault on a public officer on duty` EQUALS JUST TRUE
#ASSERT `s 270(1)(a) the accused assaults an officer in the execution of his duty or a person acting in aid of one` `s 270(1) test: assault on a peace officer off duty` EQUALS JUST FALSE
#ASSERT `s 270(1)(a) the accused assaults an officer in the execution of his duty or a person acting in aid of one` `s 270(1) test: assault on a person aiding an officer` EQUALS JUST TRUE
#ASSERT `s 270(1)(a) the accused assaults an officer in the execution of his duty or a person acting in aid of one` `s 270(1) test: no assault` EQUALS JUST FALSE
#ASSERT `s 270(1)(a) the accused assaults an officer in the execution of his duty or a person acting in aid of one` `s 270(1) test: assault not covered, officer on duty` EQUALS NOTHING
#ASSERT `s 270(1)(a) the accused assaults an officer in the execution of his duty or a person acting in aid of one` `s 270(1) test: assault not covered, no officer` EQUALS JUST FALSE
#ASSERT `s 270(1)(a) the accused assaults an officer in the execution of his duty or a person acting in aid of one` `s 270(1) test: assault on a private person` EQUALS JUST FALSE
#ASSERT `s 270(1)(b) the accused assaults a person with intent to resist or prevent a lawful arrest or detention` `s 270(1) test: assault to resist a lawful arrest` EQUALS JUST TRUE
#ASSERT `s 270(1)(b) the accused assaults a person with intent to resist or prevent a lawful arrest or detention` `s 270(1) test: assault to resist an unlawful arrest` EQUALS JUST FALSE
#ASSERT `s 270(1)(b) the accused assaults a person with intent to resist or prevent a lawful arrest or detention` `s 270(1) test: assault, arrest lawful, no intent` EQUALS JUST FALSE
#ASSERT `s 270(1)(b) the accused assaults a person with intent to resist or prevent a lawful arrest or detention` `s 270(1) test: arrest-resisting intent, assault not covered` EQUALS NOTHING
#ASSERT `s 270(1)(c)(i) the accused assaults a person engaged in the lawful execution of a process or in making a lawful distress or seizure` `s 270(1) test: assault on a person executing a process` EQUALS JUST TRUE
#ASSERT `s 270(1)(c)(i) the accused assaults a person engaged in the lawful execution of a process or in making a lawful distress or seizure` `s 270(1) test: assault on a person making a distress` EQUALS JUST TRUE
#ASSERT `s 270(1)(c)(i) the accused assaults a person engaged in the lawful execution of a process or in making a lawful distress or seizure` `s 270(1) test: assault on a private person` EQUALS JUST FALSE
#ASSERT `s 270(1)(c)(ii) the accused assaults a person with intent to rescue anything taken under lawful process, distress or seizure` `s 270(1) test: assault to rescue a thing taken under lawful process` EQUALS JUST TRUE
#ASSERT `s 270(1)(c)(ii) the accused assaults a person with intent to rescue anything taken under lawful process, distress or seizure` `s 270(1) test: assault on a private person` EQUALS JUST FALSE
-- the offence of subsection (1): any one limb is enough; none is the section's own "who" no; a limb that is not covered gives not covered
#ASSERT `s 270(1) the accused commits the offence of assaulting a peace officer` `s 270(1) test: assault on a peace officer on duty` EQUALS JUST TRUE
#ASSERT `s 270(1) the accused commits the offence of assaulting a peace officer` `s 270(1) test: assault on a person aiding an officer` EQUALS JUST TRUE
#ASSERT `s 270(1) the accused commits the offence of assaulting a peace officer` `s 270(1) test: assault to resist a lawful arrest` EQUALS JUST TRUE
#ASSERT `s 270(1) the accused commits the offence of assaulting a peace officer` `s 270(1) test: assault on a person executing a process` EQUALS JUST TRUE
#ASSERT `s 270(1) the accused commits the offence of assaulting a peace officer` `s 270(1) test: assault to rescue a thing taken under lawful process` EQUALS JUST TRUE
#ASSERT `s 270(1) the accused commits the offence of assaulting a peace officer` `s 270(1) test: assault on a peace officer off duty` EQUALS JUST FALSE
#ASSERT `s 270(1) the accused commits the offence of assaulting a peace officer` `s 270(1) test: assault on a private person` EQUALS JUST FALSE
#ASSERT `s 270(1) the accused commits the offence of assaulting a peace officer` `s 270(1) test: no assault` EQUALS JUST FALSE
#ASSERT `s 270(1) the accused commits the offence of assaulting a peace officer` `s 270(1) test: assault not covered, officer on duty` EQUALS NOTHING
#ASSERT `s 270(1) the accused commits the offence of assaulting a peace officer` `s 270(1) test: arrest-resisting intent, assault not covered` EQUALS NOTHING

§ `s 270(2): class and punishment`

-- text lines 5040-5042: (a) indictable, imprisonment not exceeding five years; (b) punishable on summary conviction (no penalty stated: s 787(1))
#ASSERT `s 270(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 270(2) the punishment on the mode of proceeding` `by indictment` `s 270 test: the s 787(1) general penalty` EQUALS Punishment OF `by indictment`, (`imprisonment for a term of` `five years`), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
#ASSERT `s 270(2) the punishment on the mode of proceeding` `on summary conviction` `s 270 test: the s 787(1) general penalty` EQUALS `s 270 test: the s 787(1) general penalty`

§ `s 270.01: assault of a peace officer with a weapon or causing bodily harm`

-- Field order of `s 270.01(1) facts`: assault referred to in s 270, weapon (s 2 weapon), imitation of a weapon, bodily harm (s 2 bodily harm)
`s 270.01(1) test: weapon used` MEANS `s 270.01(1) facts` OF (JUST TRUE), (JUST TRUE), FALSE, (JUST FALSE)
`s 270.01(1) test: imitation weapon used` MEANS `s 270.01(1) facts` OF (JUST TRUE), (JUST FALSE), TRUE, (JUST FALSE)
`s 270.01(1) test: bodily harm caused` MEANS `s 270.01(1) facts` OF (JUST TRUE), (JUST FALSE), FALSE, (JUST TRUE)
`s 270.01(1) test: neither weapon nor harm` MEANS `s 270.01(1) facts` OF (JUST TRUE), (JUST FALSE), FALSE, (JUST FALSE)
`s 270.01(1) test: no s 270 assault` MEANS `s 270.01(1) facts` OF (JUST FALSE), (JUST TRUE), TRUE, (JUST TRUE)
`s 270.01(1) test: weapon not covered by s 2` MEANS `s 270.01(1) facts` OF (JUST TRUE), NOTHING, FALSE, (JUST FALSE)
`s 270.01(1) test: assault not covered, weapon used` MEANS `s 270.01(1) facts` OF NOTHING, (JUST TRUE), FALSE, (JUST FALSE)
#ASSERT `s 270.01(1)(a) the accused, in committing the assault, carries, uses or threatens to use a weapon or an imitation of one` `s 270.01(1) test: weapon used` EQUALS JUST TRUE
#ASSERT `s 270.01(1)(a) the accused, in committing the assault, carries, uses or threatens to use a weapon or an imitation of one` `s 270.01(1) test: imitation weapon used` EQUALS JUST TRUE
#ASSERT `s 270.01(1)(a) the accused, in committing the assault, carries, uses or threatens to use a weapon or an imitation of one` `s 270.01(1) test: bodily harm caused` EQUALS JUST FALSE
#ASSERT `s 270.01(1)(a) the accused, in committing the assault, carries, uses or threatens to use a weapon or an imitation of one` `s 270.01(1) test: no s 270 assault` EQUALS JUST FALSE
#ASSERT `s 270.01(1)(a) the accused, in committing the assault, carries, uses or threatens to use a weapon or an imitation of one` `s 270.01(1) test: weapon not covered by s 2` EQUALS NOTHING
#ASSERT `s 270.01(1)(a) the accused, in committing the assault, carries, uses or threatens to use a weapon or an imitation of one` `s 270.01(1) test: assault not covered, weapon used` EQUALS NOTHING
#ASSERT `s 270.01(1)(b) the accused, in committing the assault, causes bodily harm to the complainant` `s 270.01(1) test: bodily harm caused` EQUALS JUST TRUE
#ASSERT `s 270.01(1)(b) the accused, in committing the assault, causes bodily harm to the complainant` `s 270.01(1) test: neither weapon nor harm` EQUALS JUST FALSE
#ASSERT `s 270.01(1)(b) the accused, in committing the assault, causes bodily harm to the complainant` `s 270.01(1) test: no s 270 assault` EQUALS JUST FALSE
#ASSERT `s 270.01(1) the accused commits the offence of assaulting a peace officer with a weapon or causing bodily harm` `s 270.01(1) test: weapon used` EQUALS JUST TRUE
#ASSERT `s 270.01(1) the accused commits the offence of assaulting a peace officer with a weapon or causing bodily harm` `s 270.01(1) test: bodily harm caused` EQUALS JUST TRUE
#ASSERT `s 270.01(1) the accused commits the offence of assaulting a peace officer with a weapon or causing bodily harm` `s 270.01(1) test: neither weapon nor harm` EQUALS JUST FALSE
#ASSERT `s 270.01(1) the accused commits the offence of assaulting a peace officer with a weapon or causing bodily harm` `s 270.01(1) test: weapon not covered by s 2` EQUALS NOTHING
-- text lines 5048-5050: (a) indictable, imprisonment of not more than 10 years; (b) summary conviction
#ASSERT `s 270.01(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 270.01(2) the punishment on the mode of proceeding` `by indictment` `s 270 test: the s 787(1) general penalty` EQUALS Punishment OF `by indictment`, (`imprisonment for a term of` `ten years`), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
#ASSERT `s 270.01(2) the punishment on the mode of proceeding` `on summary conviction` `s 270 test: the s 787(1) general penalty` EQUALS `s 270 test: the s 787(1) general penalty`

§ `s 270.02: aggravated assault of a peace officer`

-- Field order of `s 270.02 facts`: assault referred to in s 270, wounds, maims, disfigures, endangers the life
`s 270.02 test: wounds` MEANS `s 270.02 facts` OF (JUST TRUE), TRUE, FALSE, FALSE, FALSE
`s 270.02 test: maims` MEANS `s 270.02 facts` OF (JUST TRUE), FALSE, TRUE, FALSE, FALSE
`s 270.02 test: disfigures` MEANS `s 270.02 facts` OF (JUST TRUE), FALSE, FALSE, TRUE, FALSE
`s 270.02 test: endangers life` MEANS `s 270.02 facts` OF (JUST TRUE), FALSE, FALSE, FALSE, TRUE
`s 270.02 test: none of the four` MEANS `s 270.02 facts` OF (JUST TRUE), FALSE, FALSE, FALSE, FALSE
`s 270.02 test: no s 270 assault` MEANS `s 270.02 facts` OF (JUST FALSE), TRUE, TRUE, TRUE, TRUE
`s 270.02 test: assault not covered, wounds` MEANS `s 270.02 facts` OF NOTHING, TRUE, FALSE, FALSE, FALSE
#ASSERT `s 270.02 the accused, in committing the assault, wounds, maims, disfigures or endangers the life of the complainant` `s 270.02 test: wounds` EQUALS JUST TRUE
#ASSERT `s 270.02 the accused, in committing the assault, wounds, maims, disfigures or endangers the life of the complainant` `s 270.02 test: maims` EQUALS JUST TRUE
#ASSERT `s 270.02 the accused, in committing the assault, wounds, maims, disfigures or endangers the life of the complainant` `s 270.02 test: disfigures` EQUALS JUST TRUE
#ASSERT `s 270.02 the accused, in committing the assault, wounds, maims, disfigures or endangers the life of the complainant` `s 270.02 test: endangers life` EQUALS JUST TRUE
#ASSERT `s 270.02 the accused, in committing the assault, wounds, maims, disfigures or endangers the life of the complainant` `s 270.02 test: none of the four` EQUALS JUST FALSE
#ASSERT `s 270.02 the accused, in committing the assault, wounds, maims, disfigures or endangers the life of the complainant` `s 270.02 test: no s 270 assault` EQUALS JUST FALSE
#ASSERT `s 270.02 the accused, in committing the assault, wounds, maims, disfigures or endangers the life of the complainant` `s 270.02 test: assault not covered, wounds` EQUALS NOTHING
-- text line 5052: "guilty of an indictable offence and liable to imprisonment for a term of not more than 14 years"
#ASSERT `s 270.02 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 270.02 the punishment` EQUALS Punishment OF `by indictment`, (`imprisonment for a term of` `fourteen years`), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `s 270.03: sentences to be served consecutively`

-- text lines 5053-5054: an offence under subsection 270(1) or 270.01(1) or section 270.02 committed against a law enforcement officer
`s 270.03 test: s 270(1)` MEANS `Provision of the Code` OF 270, "(1)"
`s 270.03 test: s 270(2)` MEANS `Provision of the Code` OF 270, "(2)"
`s 270.03 test: s 270.01(1)` MEANS `Provision of the Code` OF 270.01, "(1)"
`s 270.03 test: s 270.01(2)` MEANS `Provision of the Code` OF 270.01, "(2)"
`s 270.03 test: s 270.02` MEANS `Provision of the Code` OF 270.02, ""
`s 270.03 test: s 270.1(1)` MEANS `Provision of the Code` OF 270.1, "(1)"
#ASSERT `s 270.03 the offence is one of subsection 270(1), subsection 270.01(1) or section 270.02` `s 270.03 test: s 270(1)`
#ASSERT `s 270.03 the offence is one of subsection 270(1), subsection 270.01(1) or section 270.02` `s 270.03 test: s 270.01(1)`
#ASSERT `s 270.03 the offence is one of subsection 270(1), subsection 270.01(1) or section 270.02` `s 270.03 test: s 270.02`
#ASSERT NOT (`s 270.03 the offence is one of subsection 270(1), subsection 270.01(1) or section 270.02` `s 270.03 test: s 270(2)`)
#ASSERT NOT (`s 270.03 the offence is one of subsection 270(1), subsection 270.01(1) or section 270.02` `s 270.03 test: s 270.01(2)`)
#ASSERT NOT (`s 270.03 the offence is one of subsection 270(1), subsection 270.01(1) or section 270.02` `s 270.03 test: s 270.1(1)`)
#ASSERT `s 270.03 the sentence shall be served consecutively to any other punishment` `s 270.03 test: s 270(1)` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 270.03 the sentence shall be served consecutively to any other punishment` `s 270.03 test: s 270.02` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 270.03 the sentence shall be served consecutively to any other punishment` `s 270.03 test: s 270.01(1)` (JUST TRUE) TRUE EQUALS JUST TRUE
-- not one of the listed offences: limited by its own wording, not covered
#ASSERT `s 270.03 the sentence shall be served consecutively to any other punishment` `s 270.03 test: s 270.1(1)` (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 270.03 the sentence shall be served consecutively to any other punishment` `s 270.03 test: s 270(2)` (JUST TRUE) TRUE EQUALS NOTHING
-- not committed against a law enforcement officer as defined in s 445.01(4)
#ASSERT `s 270.03 the sentence shall be served consecutively to any other punishment` `s 270.03 test: s 270(1)` (JUST FALSE) TRUE EQUALS NOTHING
-- s 445.01(4) itself not covered
#ASSERT `s 270.03 the sentence shall be served consecutively to any other punishment` `s 270.03 test: s 270(1)` NOTHING TRUE EQUALS NOTHING
-- no other punishment imposed for an offence arising out of the same event
#ASSERT `s 270.03 the sentence shall be served consecutively to any other punishment` `s 270.03 test: s 270(1)` (JUST TRUE) FALSE EQUALS NOTHING

§ `s 270.1: disarming a peace officer`

-- (2): "weapon means any thing that is designed to be used to cause injury or death to, or to temporarily incapacitate, a person" (line 5058)
#ASSERT `s 270.1(2) the thing is a weapon for the purpose of subsection (1)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 270.1(2) the thing is a weapon for the purpose of subsection (1)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 270.1(2) the thing is a weapon for the purpose of subsection (1)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 270.1(2) the thing is a weapon for the purpose of subsection (1)` FALSE FALSE EQUALS JUST FALSE
-- Field order of `s 270.1(1) facts`: takes or attempts to take a weapon, thing is a weapon (s 270.1(2)), in the officer's possession, person is a peace officer (s 2), officer consents, officer engaged in the execution of duty
`s 270.1(1) test: disarming` MEANS `s 270.1(1) facts` OF TRUE, (JUST TRUE), TRUE, (JUST TRUE), FALSE, TRUE
`s 270.1(1) test: officer consents` MEANS `s 270.1(1) facts` OF TRUE, (JUST TRUE), TRUE, (JUST TRUE), TRUE, TRUE
`s 270.1(1) test: officer not on duty` MEANS `s 270.1(1) facts` OF TRUE, (JUST TRUE), TRUE, (JUST TRUE), FALSE, FALSE
`s 270.1(1) test: not a weapon` MEANS `s 270.1(1) facts` OF TRUE, (JUST FALSE), TRUE, (JUST TRUE), FALSE, TRUE
`s 270.1(1) test: not in the officer's possession` MEANS `s 270.1(1) facts` OF TRUE, (JUST TRUE), FALSE, (JUST TRUE), FALSE, TRUE
`s 270.1(1) test: no taking` MEANS `s 270.1(1) facts` OF FALSE, (JUST TRUE), TRUE, (JUST TRUE), FALSE, TRUE
`s 270.1(1) test: not a peace officer` MEANS `s 270.1(1) facts` OF TRUE, (JUST TRUE), TRUE, (JUST FALSE), FALSE, TRUE
`s 270.1(1) test: peace officer status not covered` MEANS `s 270.1(1) facts` OF TRUE, (JUST TRUE), TRUE, NOTHING, FALSE, TRUE
#ASSERT `s 270.1(1) the accused commits the offence of disarming a peace officer` `s 270.1(1) test: disarming` EQUALS JUST TRUE
#ASSERT `s 270.1(1) the accused commits the offence of disarming a peace officer` `s 270.1(1) test: officer consents` EQUALS JUST FALSE
#ASSERT `s 270.1(1) the accused commits the offence of disarming a peace officer` `s 270.1(1) test: officer not on duty` EQUALS JUST FALSE
#ASSERT `s 270.1(1) the accused commits the offence of disarming a peace officer` `s 270.1(1) test: not a weapon` EQUALS JUST FALSE
#ASSERT `s 270.1(1) the accused commits the offence of disarming a peace officer` `s 270.1(1) test: not in the officer's possession` EQUALS JUST FALSE
#ASSERT `s 270.1(1) the accused commits the offence of disarming a peace officer` `s 270.1(1) test: no taking` EQUALS JUST FALSE
#ASSERT `s 270.1(1) the accused commits the offence of disarming a peace officer` `s 270.1(1) test: not a peace officer` EQUALS JUST FALSE
#ASSERT `s 270.1(1) the accused commits the offence of disarming a peace officer` `s 270.1(1) test: peace officer status not covered` EQUALS NOTHING
-- lines 5060-5062: (a) indictable, not more than five years; (b) summary conviction
