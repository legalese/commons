IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc26-interpretation`
IMPORT `ccc26-reports`

-- ccc26-tests-reports.l4 -- tests for ccc26-reports.l4 (sections 720 to 722.2). Every expected value is written from the text (lines 15310-15376) before the run.
-- The regulative rules are run with #TRACE (the stable binary prints their result and does not let a test assert it, except the trivial case); the decision function beside each carries the assertions.

§ `s 720(1): a court shall, as soon as practicable after an offender has been found guilty, conduct proceedings to determine the sentence`

#ASSERT `s 720(1) the court must conduct proceedings to determine the appropriate sentence` TRUE EQUALS JUST TRUE
#ASSERT `s 720(1) the court must conduct proceedings to determine the appropriate sentence` FALSE EQUALS JUST FALSE
-- no finding of guilt: no duty, so the rule is fulfilled
#ASSERT `s 720(1) the court's duty to conduct sentencing proceedings` FALSE 30 EQUALS FULFILLED
-- the court conducts the proceedings on day 10 of 30: fulfilled
#TRACE `s 720(1) the court's duty to conduct sentencing proceedings` TRUE 30 AT 0 WITH
    PARTY `the court` DOES `s 720(1) conduct proceedings to determine the appropriate sentence` AT 10
-- nothing happens by day 40 of 30: breach
#TRACE `s 720(1) the court's duty to conduct sentencing proceedings` TRUE 30 AT 0 WITH
    (WAITUNTIL 40)

§ `s 720(2): the court may, with the consent of the Attorney General and the offender and after considering the interests of justice and of any victim, delay sentencing`

--                                               s 2 AG, that person consented, offender consents, considered, treatment program, restorative justice process
#ASSERT `s 720(2) the court may delay sentencing` (JUST TRUE) TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 720(2) the court may delay sentencing` (JUST TRUE) TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 720(2) the court may delay sentencing` (JUST TRUE) TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- the delay is for neither purpose the paragraphs name
#ASSERT `s 720(2) the court may delay sentencing` (JUST TRUE) TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- each of the three conditions of the grant, failing alone
#ASSERT `s 720(2) the court may delay sentencing` (JUST TRUE) FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 720(2) the court may delay sentencing` (JUST TRUE) TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 720(2) the court may delay sentencing` (JUST TRUE) TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- the person who consented is not the Attorney General for this proceeding: the consent of the Attorney General is missing
#ASSERT `s 720(2) the court may delay sentencing` (JUST FALSE) TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- who the Attorney General is, is for section 2 and is not determined
#ASSERT `s 720(2) the court may delay sentencing` NOTHING TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING

§ `s 721(1): a probation officer shall, if required to do so by a court, prepare and file a report on an accused, other than an organization, who pleads guilty or is found guilty`

--                                                         organization, pleads guilty or found guilty, a court requires the report
#ASSERT `s 721(1) the probation officer must prepare and file a report` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 721(1) the probation officer must prepare and file a report` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 721(1) the probation officer must prepare and file a report` FALSE FALSE TRUE EQUALS JUST FALSE
-- an organization is "other than" the accused the subsection speaks of
#ASSERT `s 721(1) the probation officer must prepare and file a report` TRUE TRUE TRUE EQUALS NOTHING

§ `s 721(3): the matters the report must contain`

--                                                                   matter,                                                specified otherwise, possible, s 119(2) of the YCJA allows
#ASSERT `s 721(3) the report must contain information on the matter` `s 721(3)(a) the offender's age, maturity, character, behaviour, attitude and willingness to make amends` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 721(3) the report must contain information on the matter` `s 721(3)(b) the history of previous dispositions under the Young Offenders Act, of previous sentences under the Youth Criminal Justice Act, and of previous findings of guilt under this Act and any other Act of Parliament` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 721(3) the report must contain information on the matter` `s 721(3)(c) the history of any alternative measure or restorative justice process that is used to deal with the offender, and the offender's response` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 721(3) the report must contain information on the matter` `s 721(3)(d) any matter required, by a regulation made under subsection (2), to be included in the report` FALSE TRUE TRUE EQUALS JUST TRUE
-- "subject to subsection 119(2) of the Youth Criminal Justice Act": for the history in (b) only
#ASSERT `s 721(3) the report must contain information on the matter` `s 721(3)(b) the history of previous dispositions under the Young Offenders Act, of previous sentences under the Youth Criminal Justice Act, and of previous findings of guilt under this Act and any other Act of Parliament` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 721(3) the report must contain information on the matter` `s 721(3)(a) the offender's age, maturity, character, behaviour, attitude and willingness to make amends` FALSE TRUE FALSE EQUALS JUST TRUE
-- "Unless otherwise specified by the court"; "wherever possible"
#ASSERT `s 721(3) the report must contain information on the matter` `s 721(3)(a) the offender's age, maturity, character, behaviour, attitude and willingness to make amends` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 721(3) the report must contain information on the matter` `s 721(3)(a) the offender's age, maturity, character, behaviour, attitude and willingness to make amends` FALSE FALSE TRUE EQUALS JUST FALSE
-- the list is not closed by (3): another matter is left to (4)
#ASSERT `s 721(3) the report must contain information on the matter` `s 721(3) another matter` FALSE TRUE TRUE EQUALS NOTHING

§ `s 721(4): the report must also contain any other matter the court requires, after hearing argument, subject to a contrary regulation`

--                                                                  court requires, argument heard, contrary regulation
#ASSERT `s 721(4) the report must also contain information on the other matter` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 721(4) the report must also contain information on the other matter` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 721(4) the report must also contain information on the other matter` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 721(4) the report must also contain information on the other matter` TRUE TRUE TRUE EQUALS JUST FALSE

§ `s 721(5): the clerk shall provide a copy of the report as soon as practicable after filing`

#ASSERT `s 721(5) the clerk must provide a copy of the report` TRUE EQUALS JUST TRUE
#ASSERT `s 721(5) the clerk must provide a copy of the report` FALSE EQUALS JUST FALSE
#ASSERT `s 721(5) the clerk's duty to provide a copy of the report` FALSE 7 EQUALS FULFILLED
#TRACE `s 721(5) the clerk's duty to provide a copy of the report` TRUE 7 AT 0 WITH
    PARTY `the clerk of the court` DOES `s 721(5) provide a copy of the report to the offender or counsel for the offender, as the court directs, and to the prosecutor` AT 3
#TRACE `s 721(5) the clerk's duty to provide a copy of the report` TRUE 7 AT 0 WITH
    (WAITUNTIL 8)

§ `s 722(1): the court shall consider a victim's statement prepared in accordance with the section and filed`

--                                                               determining, s 2 victim for s 722, prepared and filed, describes the harm
#ASSERT `s 722(1) the court must consider the statement of the victim` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 722(1) the court must consider the statement of the victim` FALSE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 722(1) the court must consider the statement of the victim` TRUE NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 722(1) the court must consider the statement of the victim` TRUE (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 722(1) the court must consider the statement of the victim` TRUE (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 722(1) the court must consider the statement of the victim` TRUE (JUST TRUE) TRUE FALSE EQUALS NOTHING

§ `s 722(2): as soon as feasible after a finding of guilt and before imposing sentence, the court shall inquire of the prosecutor`

#ASSERT `s 722(2) the court must inquire of the prosecutor` TRUE EQUALS JUST TRUE
#ASSERT `s 722(2) the court must inquire of the prosecutor` FALSE EQUALS JUST FALSE
#ASSERT `s 722(2) the court's duty to inquire of the prosecutor` FALSE 14 EQUALS FULFILLED
#TRACE `s 722(2) the court's duty to inquire of the prosecutor` TRUE 14 AT 0 WITH
    PARTY `the court` DOES `s 722(2) inquire of the prosecutor if reasonable steps have been taken to provide the victim with an opportunity to prepare a statement` AT 5
#TRACE `s 722(2) the court's duty to inquire of the prosecutor` TRUE 14 AT 0 WITH
    (WAITUNTIL 15)

§ `s 722(3): the court may adjourn on application of the prosecutor or a victim or on its own motion, if satisfied it would not interfere with the proper administration of justice`

--                                                    prosecutor applies, victim applies, own motion, purpose, satisfied
#ASSERT `s 722(3) the court may adjourn the proceedings` TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 722(3) the court may adjourn the proceedings` FALSE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 722(3) the court may adjourn the proceedings` FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- nobody applied and the court has not acted on its own motion
#ASSERT `s 722(3) the court may adjourn the proceedings` FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- the purpose is neither of the two the subsection names
#ASSERT `s 722(3) the court may adjourn the proceedings` TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING
-- the court is not satisfied: the "if" gate of a grant
#ASSERT `s 722(3) the court may adjourn the proceedings` TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING

§ `s 722(4): the statement must be prepared in writing, using Form 34.2, in accordance with the designated program's procedures`

#ASSERT `s 722(4) the statement is in the form the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 722(4) the statement is in the form the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 722(4) the statement is in the form the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 722(4) the statement is in the form the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE

§ `s 722(5): the court shall, on the request of a victim, permit the victim to present the statement in four ways`

--                                                                         requests, manner, the court considers the other manner appropriate
#ASSERT `s 722(5) the court must permit the victim to present the statement in the manner` TRUE `s 722(5)(a) reading it` FALSE EQUALS JUST TRUE
#ASSERT `s 722(5) the court must permit the victim to present the statement in the manner` TRUE `s 722(5)(b) reading it in the presence and close proximity of any support person of the victim's choice or a support animal` FALSE EQUALS JUST TRUE
#ASSERT `s 722(5) the court must permit the victim to present the statement in the manner` TRUE `s 722(5)(c) reading it outside the court room or behind a screen or other device that would allow the victim not to see the offender` FALSE EQUALS JUST TRUE
#ASSERT `s 722(5) the court must permit the victim to present the statement in the manner` TRUE `s 722(5)(d) presenting it in any other manner` TRUE EQUALS JUST TRUE
-- (d) reaches only a manner the court considers appropriate
#ASSERT `s 722(5) the court must permit the victim to present the statement in the manner` TRUE `s 722(5)(d) presenting it in any other manner` FALSE EQUALS NOTHING
-- no request
#ASSERT `s 722(5) the court must permit the victim to present the statement in the manner` FALSE `s 722(5)(a) reading it` FALSE EQUALS JUST FALSE

§ `s 722(6): the photograph, during the presentation, if it would not in the opinion of the court disrupt the proceedings`

--                                                                         presenting, photograph of the victim before the offence, court's opinion that it would disrupt
#ASSERT `s 722(6)(a) the victim may have a photograph of themselves with them` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 722(6)(a) the victim may have a photograph of themselves with them` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 722(6)(a) the victim may have a photograph of themselves with them` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 722(6)(a) the victim may have a photograph of themselves with them` TRUE TRUE TRUE EQUALS NOTHING
--                                                                                                          s 2.2, acting on behalf, individual presenting, photograph, disrupt
#ASSERT `s 722(6)(b) the individual presenting the statement on the victim's behalf may have a photograph of the victim with them` (JUST TRUE) TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 722(6)(b) the individual presenting the statement on the victim's behalf may have a photograph of the victim with them` (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 722(6)(b) the individual presenting the statement on the victim's behalf may have a photograph of the victim with them` (JUST TRUE) FALSE TRUE TRUE FALSE EQUALS NOTHING   -- RECONCILED 2026-11-12: was JUST FALSE; the "if the statement is presented by someone acting on the victim's behalf" gate is an "if" on a grant, so its failure is NOTHING (only "During the presentation" stays JUST FALSE)
#ASSERT `s 722(6)(b) the individual presenting the statement on the victim's behalf may have a photograph of the victim with them` NOTHING TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 722(6)(b) the individual presenting the statement on the victim's behalf may have a photograph of the victim with them` (JUST FALSE) TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 722(6)(b) the individual presenting the statement on the victim's behalf may have a photograph of the victim with them` (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 722(6)(b) the individual presenting the statement on the victim's behalf may have a photograph of the victim with them` (JUST TRUE) TRUE TRUE TRUE TRUE EQUALS NOTHING

§ `s 722(7): the victim shall not present the statement outside the court room unless the closed-circuit arrangements are made and the offender may communicate with counsel`

--                                                                   outside the court room, arrangements made, offender may communicate with counsel
#ASSERT `s 722(7) the victim is barred from presenting the statement outside the court room` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 722(7) the victim is barred from presenting the statement outside the court room` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 722(7) the victim is barred from presenting the statement outside the court room` TRUE FALSE TRUE EQUALS JUST TRUE
-- the "unless" is met
#ASSERT `s 722(7) the victim is barred from presenting the statement outside the court room` TRUE TRUE TRUE EQUALS JUST FALSE
-- inside the court room: the subsection does not speak
#ASSERT `s 722(7) the victim is barred from presenting the statement outside the court room` FALSE FALSE FALSE EQUALS NOTHING

§ `s 722(8): the court shall take into account the portions of the statement it considers relevant and disregard any other portion`

#ASSERT `s 722(8) the court must take the portion of the statement into account` TRUE EQUALS JUST TRUE
#ASSERT `s 722(8) the court must take the portion of the statement into account` FALSE EQUALS JUST FALSE

