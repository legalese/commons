IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc6-builders`
IMPORT `ccc6-disorderly`
IMPORT `ccc6-tests-support`

-- Tests for ss 173, 174, 175, 176, 177, 180 and 182. Expected values decided from the text before each run.

`s 173 test s 787(1) penalty` MEANS Punishment OF `by indictment`, `imprisonment for a term of` `six months`, `no imprisonment is stated`, `a fine in the discretion of the court`, `no fine is stated`
`s 173 test summary penalty` MEANS Punishment OF `on summary conviction`, `imprisonment for a term of` `six months`, `no imprisonment is stated`, `a fine in the discretion of the court`, `no fine is stated`

§ `s 173(1) Indecent acts`
-- (wilfully did an indecent act, the answer of s 150 public place, in the presence of one or more persons, with intent to insult or offend)
#ASSERT `s 173(1) the conduct is the offence of an indecent act` TRUE (JUST TRUE) TRUE FALSE EQUALS JUST TRUE   -- in a public place in the presence of others
#ASSERT `s 173(1) the conduct is the offence of an indecent act` TRUE (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- in a public place but no one present and no intent
#ASSERT `s 173(1) the conduct is the offence of an indecent act` TRUE (JUST FALSE) FALSE TRUE EQUALS JUST TRUE   -- in any place with intent to insult or offend
#ASSERT `s 173(1) the conduct is the offence of an indecent act` TRUE (JUST FALSE) TRUE FALSE EQUALS NOTHING   -- not a public place and no intent
#ASSERT `s 173(1) the conduct is the offence of an indecent act` TRUE NOTHING TRUE FALSE EQUALS NOTHING   -- s 150 "public place" not answered
#ASSERT `s 173(1) the conduct is the offence of an indecent act` FALSE (JUST TRUE) TRUE TRUE EQUALS NOTHING   -- not a wilful indecent act
#ASSERT `s 173(1)(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 2) `no imprisonment is stated`
#ASSERT `s 173(1)(b) the punishment on summary conviction` `s 173 test s 787(1) penalty` EQUALS `s 173 test summary penalty`
#ASSERT `s 173(1) the class of the offence` EQUALS `ss 150 to 182 test both`

§ `s 173(2) Exposure`
-- (exposed, the answer of s 150 sexual organs, sexual purpose, age of the person to whom they were exposed)
#ASSERT `s 173(2) the conduct is the offence of exposure to a person under 16` TRUE (JUST TRUE) TRUE 15 EQUALS JUST TRUE
#ASSERT `s 173(2) the conduct is the offence of exposure to a person under 16` TRUE (JUST TRUE) TRUE 15.99 EQUALS JUST TRUE
#ASSERT `s 173(2) the conduct is the offence of exposure to a person under 16` TRUE (JUST TRUE) TRUE 16 EQUALS NOTHING
#ASSERT `s 173(2) the conduct is the offence of exposure to a person under 16` TRUE (JUST TRUE) FALSE 10 EQUALS NOTHING   -- not for a sexual purpose
#ASSERT `s 173(2) the conduct is the offence of exposure to a person under 16` FALSE (JUST TRUE) TRUE 10 EQUALS NOTHING
#ASSERT `s 173(2) the conduct is the offence of exposure to a person under 16` TRUE NOTHING TRUE 10 EQUALS NOTHING   -- s 150 "sexual organs" not answered
#ASSERT `s 173(2)(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 10) (`ss 150 to 182 test a term of days` 90)
#ASSERT `s 173(2)(b) the punishment on summary conviction` EQUALS `ss 150 to 182 test a summary punishment` `ss 150 to 182 test a term of two years less a day` (`ss 150 to 182 test a term of days` 30)   -- minimum 30 days
#ASSERT `s 173(2) the class of the offence` EQUALS `ss 150 to 182 test both`

§ `s 174 Nudity`
#ASSERT `s 174(2) the person is nude` TRUE EQUALS JUST TRUE
#ASSERT `s 174(2) the person is nude` FALSE EQUALS NOTHING
-- (without lawful excuse, the answer of (2), the answer of s 150 public place, on private property exposed to public view)
#ASSERT `s 174(1) the conduct is the offence of nudity` TRUE (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 174(1) the conduct is the offence of nudity` TRUE (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE   -- (b)
#ASSERT `s 174(1) the conduct is the offence of nudity` FALSE (JUST TRUE) (JUST TRUE) TRUE EQUALS NOTHING   -- with lawful excuse
#ASSERT `s 174(1) the conduct is the offence of nudity` TRUE NOTHING (JUST TRUE) TRUE EQUALS NOTHING   -- not shown to be nude
#ASSERT `s 174(1) the conduct is the offence of nudity` TRUE (JUST TRUE) (JUST FALSE) FALSE EQUALS NOTHING   -- not in a public place and not exposed to public view
#ASSERT `s 174(1) the punishment on summary conviction` `s 173 test s 787(1) penalty` EQUALS `s 173 test summary penalty`
#ASSERT `s 174(1) the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 174(3) no proceedings shall be commenced without the consent of the Attorney General: the bar applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 174(3) no proceedings shall be commenced without the consent of the Attorney General: the bar applies` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 174(3) no proceedings shall be commenced without the consent of the Attorney General: the bar applies` FALSE FALSE EQUALS NOTHING

§ `s 175 Causing disturbance, indecent exhibition, loitering, etc.`
-- (a): (the answer of s 2 dwelling-house, causes a disturbance, the answer of s 150 public place, how)
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` (JUST FALSE) TRUE (JUST TRUE) `s 175(1)(a)(i) by fighting` EQUALS JUST TRUE
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` (JUST FALSE) TRUE (JUST TRUE) `s 175(1)(a)(i) by screaming` EQUALS JUST TRUE
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` (JUST FALSE) TRUE (JUST TRUE) `s 175(1)(a)(i) by shouting` EQUALS JUST TRUE
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` (JUST FALSE) TRUE (JUST TRUE) `s 175(1)(a)(i) by swearing` EQUALS JUST TRUE
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` (JUST FALSE) TRUE (JUST TRUE) `s 175(1)(a)(i) by singing` EQUALS JUST TRUE
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` (JUST FALSE) TRUE (JUST TRUE) `s 175(1)(a)(i) by using insulting or obscene language` EQUALS JUST TRUE
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` (JUST FALSE) TRUE (JUST TRUE) `s 175(1)(a)(ii) by being drunk` EQUALS JUST TRUE
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` (JUST FALSE) TRUE (JUST TRUE) `s 175(1)(a)(iii) by impeding or molesting other persons` EQUALS JUST TRUE
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` (JUST FALSE) TRUE (JUST TRUE) `s 175(1)(a) in another way` EQUALS NOTHING
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` (JUST TRUE) TRUE (JUST TRUE) `s 175(1)(a)(i) by fighting` EQUALS NOTHING   -- the person is in a dwelling-house: "not being in a dwelling-house"
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` (JUST FALSE) FALSE (JUST TRUE) `s 175(1)(a)(i) by fighting` EQUALS NOTHING
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` (JUST FALSE) TRUE (JUST FALSE) `s 175(1)(a)(i) by fighting` EQUALS NOTHING   -- not in or near a public place
#ASSERT `s 175(1)(a) the conduct is the offence of causing a disturbance in or near a public place` NOTHING TRUE (JUST TRUE) `s 175(1)(a)(i) by fighting` EQUALS NOTHING
-- (b), (c)
#ASSERT `s 175(1)(b) the conduct is the offence of an indecent exhibition in a public place` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 175(1)(b) the conduct is the offence of an indecent exhibition in a public place` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 175(1)(b) the conduct is the offence of an indecent exhibition in a public place` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 175(1)(c) the conduct is the offence of loitering in a public place and obstructing persons` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 175(1)(c) the conduct is the offence of loitering in a public place and obstructing persons` TRUE (JUST TRUE) FALSE EQUALS NOTHING   -- loiters but does not obstruct anyone
#ASSERT `s 175(1)(c) the conduct is the offence of loitering in a public place and obstructing persons` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 175(1)(c) the conduct is the offence of loitering in a public place and obstructing persons` FALSE (JUST TRUE) TRUE EQUALS NOTHING
-- (d): (disturbs the peace and quiet of the occupants of a dwelling-house, the conduct, public place, not an occupant of a dwelling-house in the building, in a part to which two or more dwelling-houses have access)
#ASSERT `s 175(1)(d) the conduct is the offence of disturbing the peace and quiet of the occupants of a dwelling-house` TRUE `s 175(1)(d) discharging firearms` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE   -- in a public place
#ASSERT `s 175(1)(d) the conduct is the offence of disturbing the peace and quiet of the occupants of a dwelling-house` TRUE `s 175(1)(d) other disorderly conduct` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 175(1)(d) the conduct is the offence of disturbing the peace and quiet of the occupants of a dwelling-house` TRUE `s 175(1)(d) other disorderly conduct` (JUST FALSE) TRUE TRUE EQUALS JUST TRUE   -- the second limb: in a shared part of a building
#ASSERT `s 175(1)(d) the conduct is the offence of disturbing the peace and quiet of the occupants of a dwelling-house` TRUE `s 175(1)(d) discharging firearms` (JUST FALSE) FALSE TRUE EQUALS NOTHING   -- an occupant of a dwelling-house in the building
#ASSERT `s 175(1)(d) the conduct is the offence of disturbing the peace and quiet of the occupants of a dwelling-house` TRUE `s 175(1)(d) discharging firearms` (JUST FALSE) TRUE FALSE EQUALS NOTHING   -- not in a part to which two or more dwelling-houses have access
#ASSERT `s 175(1)(d) the conduct is the offence of disturbing the peace and quiet of the occupants of a dwelling-house` TRUE `s 175(1)(d) neither` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 175(1)(d) the conduct is the offence of disturbing the peace and quiet of the occupants of a dwelling-house` FALSE `s 175(1)(d) discharging firearms` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 175(1) the punishment on summary conviction` `s 173 test s 787(1) penalty` EQUALS `s 173 test summary penalty`
#ASSERT `s 175(1) the class of the offence` EQUALS `an offence punishable on summary conviction`
-- (2): (the answer of s 2 peace officer, relates to the conduct, no other evidence or corroboration, a disturbance or obstruction of (1)(a), (d) or (c))
#ASSERT `s 175(2) a summary conviction court may infer from the evidence of a peace officer that the disturbance or obstruction occurred` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 175(2) a summary conviction court may infer from the evidence of a peace officer that the disturbance or obstruction occurred` (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING   -- not a peace officer
#ASSERT `s 175(2) a summary conviction court may infer from the evidence of a peace officer that the disturbance or obstruction occurred` NOTHING TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 175(2) a summary conviction court may infer from the evidence of a peace officer that the disturbance or obstruction occurred` (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 175(2) a summary conviction court may infer from the evidence of a peace officer that the disturbance or obstruction occurred` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `... (JUST TRUE) TRUE FALSE TRUE EQUALS NOTHING`; other uncorroborated evidence exists: an "In the absence of other evidence" gate of the where kind, listed by the sweep and answered as the guide does (ruling (b) of 2026-11-05), limb by limb
#ASSERT `s 175(2) a summary conviction court may infer from the evidence of a peace officer that the disturbance or obstruction occurred` (JUST TRUE) TRUE TRUE FALSE EQUALS NOTHING   -- a matter outside (1)(a), (d) and (c)

§ `s 176 Obstructing or violence to or arrest of officiating clergyman`
-- (a): (what, by threats or force, unlawful, to stop a service or function)
#ASSERT `s 176(1)(a) the conduct is the offence of obstructing an officiant by threats or force` `s 176(1)(a) obstructs` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 176(1)(a) the conduct is the offence of obstructing an officiant by threats or force` `s 176(1)(a) prevents` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 176(1)(a) the conduct is the offence of obstructing an officiant by threats or force` `s 176(1)(a) endeavours to obstruct` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 176(1)(a) the conduct is the offence of obstructing an officiant by threats or force` `s 176(1)(a) endeavours to prevent` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 176(1)(a) the conduct is the offence of obstructing an officiant by threats or force` `s 176(1)(a) none of those` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 176(1)(a) the conduct is the offence of obstructing an officiant by threats or force` `s 176(1)(a) obstructs` FALSE TRUE TRUE EQUALS NOTHING   -- not by threats or force
#ASSERT `s 176(1)(a) the conduct is the offence of obstructing an officiant by threats or force` `s 176(1)(a) obstructs` TRUE FALSE TRUE EQUALS NOTHING   -- not unlawful
#ASSERT `s 176(1)(a) the conduct is the offence of obstructing an officiant by threats or force` `s 176(1)(a) obstructs` TRUE TRUE FALSE EQUALS NOTHING
-- (b): (knew the officiant was about to perform, on the way or returning; what)
#ASSERT `s 176(1)(b) the conduct is the offence of assaulting or arresting an officiant` TRUE `s 176(1)(b)(i) assaults or offers violence` EQUALS JUST TRUE
#ASSERT `s 176(1)(b) the conduct is the offence of assaulting or arresting an officiant` TRUE `s 176(1)(b)(ii) arrests on a civil process, or under the pretence of executing a civil process` EQUALS JUST TRUE
#ASSERT `s 176(1)(b) the conduct is the offence of assaulting or arresting an officiant` FALSE `s 176(1)(b)(i) assaults or offers violence` EQUALS NOTHING   -- did not know
#ASSERT `s 176(1)(b) the conduct is the offence of assaulting or arresting an officiant` TRUE `s 176(1)(b) neither` EQUALS NOTHING
#ASSERT `s 176(1) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 2) `no imprisonment is stated`
#ASSERT `s 176(1) the punishment on summary conviction` `s 173 test s 787(1) penalty` EQUALS `s 173 test summary penalty`
#ASSERT `s 176(1) the class of the offence` EQUALS `ss 150 to 182 test both`
-- (2), (3)
#ASSERT `s 176(2) the conduct is the offence of disturbing religious worship or certain meetings` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 176(2) the conduct is the offence of disturbing religious worship or certain meetings` TRUE FALSE EQUALS NOTHING   -- an assemblage of another kind
#ASSERT `s 176(2) the conduct is the offence of disturbing religious worship or certain meetings` FALSE TRUE EQUALS NOTHING
#ASSERT `s 176(2) the punishment on summary conviction` `s 173 test s 787(1) penalty` EQUALS `s 173 test summary penalty`
#ASSERT `s 176(2) the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 176(3) the conduct is the offence of disturbing the order or solemnity of a meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 176(3) the conduct is the offence of disturbing the order or solemnity of a meeting` FALSE TRUE EQUALS NOTHING
#ASSERT `s 176(3) the conduct is the offence of disturbing the order or solemnity of a meeting` TRUE FALSE EQUALS NOTHING
#ASSERT `s 176(3) the punishment on summary conviction` `s 173 test s 787(1) penalty` EQUALS `s 173 test summary penalty`
#ASSERT `s 176(3) the class of the offence` EQUALS `an offence punishable on summary conviction`

§ `s 177 Trespassing at night`
-- (without lawful excuse, loitered or prowled on the property of another, the answer of s 2 night, the answer of s 2 dwelling-house)
#ASSERT `s 177 the conduct is the offence of trespassing at night` TRUE TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 177 the conduct is the offence of trespassing at night` FALSE TRUE (JUST TRUE) (JUST TRUE) EQUALS NOTHING   -- with lawful excuse
#ASSERT `s 177 the conduct is the offence of trespassing at night` TRUE FALSE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 177 the conduct is the offence of trespassing at night` TRUE TRUE (JUST FALSE) (JUST TRUE) EQUALS NOTHING   -- in the day
#ASSERT `s 177 the conduct is the offence of trespassing at night` TRUE TRUE NOTHING (JUST TRUE) EQUALS NOTHING   -- s 2 "night" not answered (the end-points are a fork)
#ASSERT `s 177 the conduct is the offence of trespassing at night` TRUE TRUE (JUST TRUE) (JUST FALSE) EQUALS NOTHING   -- not near a dwelling-house
#ASSERT `s 177 the punishment on summary conviction` `s 173 test s 787(1) penalty` EQUALS `s 173 test summary penalty`
#ASSERT `s 177 the class of the offence` EQUALS `an offence punishable on summary conviction`

§ `s 180 Common nuisance`
#ASSERT `s 180(2) the person commits a common nuisance` TRUE FALSE `s 180(2)(a) endangers the lives of the public` EQUALS JUST TRUE
#ASSERT `s 180(2) the person commits a common nuisance` FALSE TRUE `s 180(2)(a) endangers the safety of the public` EQUALS JUST TRUE   -- fails to discharge a legal duty
#ASSERT `s 180(2) the person commits a common nuisance` TRUE FALSE `s 180(2)(a) endangers the health of the public` EQUALS JUST TRUE
#ASSERT `s 180(2) the person commits a common nuisance` TRUE FALSE `s 180(2)(a) endangers the property of the public` EQUALS JUST TRUE
#ASSERT `s 180(2) the person commits a common nuisance` TRUE FALSE `s 180(2)(a) endangers the comfort of the public` EQUALS JUST TRUE
#ASSERT `s 180(2) the person commits a common nuisance` TRUE FALSE `s 180(2)(b) obstructs the public in the exercise or enjoyment of any right that is common to all the subjects of Her Majesty in Canada` EQUALS JUST TRUE
#ASSERT `s 180(2) the person commits a common nuisance` TRUE TRUE `s 180(2) none of those` EQUALS NOTHING
#ASSERT `s 180(2) the person commits a common nuisance` FALSE FALSE `s 180(2)(a) endangers the lives of the public` EQUALS NOTHING   -- neither an unlawful act nor a failure to discharge a legal duty
-- (1): (the answer of (2), endangers the lives, safety or health of the public, causes physical injury)
#ASSERT `s 180(1) the conduct is the offence of committing a common nuisance` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 180(1) the conduct is the offence of committing a common nuisance` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 180(1) the conduct is the offence of committing a common nuisance` (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- a nuisance that endangers only property or comfort, or obstructs: not within (a) or (b)
#ASSERT `s 180(1) the conduct is the offence of committing a common nuisance` NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 180(1) the conduct is the offence of committing a common nuisance` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 180(1) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 2) `no imprisonment is stated`
#ASSERT `s 180(1) the punishment on summary conviction` `s 173 test s 787(1) penalty` EQUALS `s 173 test summary penalty`
#ASSERT `s 180 the class of the offence` EQUALS `ss 150 to 182 test both`

§ `s 182 Dead body`
#ASSERT `s 182 the conduct is the offence concerning a dead human body` TRUE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 182 the conduct is the offence concerning a dead human body` FALSE TRUE EQUALS JUST TRUE   -- (b)
#ASSERT `s 182 the conduct is the offence concerning a dead human body` FALSE FALSE EQUALS NOTHING
#ASSERT `s 182 the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 5) `no imprisonment is stated`
#ASSERT `s 182 the punishment on summary conviction` `s 173 test s 787(1) penalty` EQUALS `s 173 test summary penalty`
#ASSERT `s 182 the class of the offence` EQUALS `ss 150 to 182 test both`
