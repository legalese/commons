IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc1-s7-citizens-and-procedure`

-- ccc1-tests-s7-citizens-and-procedure.l4 -- tests for section 7(4) to (7) of the Criminal Code (Canada). Expected values are written by hand from the text.
-- Arguments are positional, in GIVEN order. Dates are `Date day month year`.

§ `s 7(4)  (employed abroad as a Public Service employee; committed in that place; offence under the laws of that place; class)`
#ASSERT `s 7(4) the act or omission is deemed to have been committed in Canada` TRUE TRUE TRUE `an indictable offence` EQUALS JUST TRUE   -- all conditions met
#ASSERT `s 7(4) the act or omission is deemed to have been committed in Canada` TRUE TRUE TRUE `an offence that the section makes both indictable and punishable on summary conviction` EQUALS JUST TRUE   -- an offence also punishable by indictment
#ASSERT `s 7(4) the act or omission is deemed to have been committed in Canada` TRUE TRUE TRUE `an offence punishable on summary conviction` EQUALS NOTHING   -- not "punishable by indictment"
#ASSERT `s 7(4) the act or omission is deemed to have been committed in Canada` FALSE TRUE TRUE `an indictable offence` EQUALS NOTHING   -- not so employed
#ASSERT `s 7(4) the act or omission is deemed to have been committed in Canada` TRUE FALSE TRUE `an indictable offence` EQUALS NOTHING   -- not committed in that place
#ASSERT `s 7(4) the act or omission is deemed to have been committed in Canada` TRUE TRUE FALSE `an indictable offence` EQUALS NOTHING   -- not an offence under the laws of that place

§ `s 7(4.1)  (outside Canada; age of the person against whom; offence; Canadian citizen or permanent resident)`
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 17 (`Provision of the Code` OF 151, "") TRUE EQUALS JUST TRUE   -- aged 17, section 151, a Canadian citizen or permanent resident
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 17.99 (`Provision of the Code` OF 151, "") TRUE EQUALS JUST TRUE   -- still under 18
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 0 (`Provision of the Code` OF 151, "") TRUE EQUALS JUST TRUE   -- a very young child
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 18 (`Provision of the Code` OF 151, "") TRUE EQUALS NOTHING   -- aged 18: not "under the age of 18"
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 30 (`Provision of the Code` OF 151, "") TRUE EQUALS NOTHING   -- an adult
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 151, "") TRUE EQUALS JUST TRUE   -- section 151 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 152, "") TRUE EQUALS JUST TRUE   -- section 152 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 153, "") TRUE EQUALS JUST TRUE   -- section 153 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 155, "") TRUE EQUALS JUST TRUE   -- section 155 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 163.1, "") TRUE EQUALS JUST TRUE   -- section 163.1 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 170, "") TRUE EQUALS JUST TRUE   -- section 170 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 171, "") TRUE EQUALS JUST TRUE   -- section 171 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 171.1, "") TRUE EQUALS JUST TRUE   -- section 171.1 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 172.1, "") TRUE EQUALS JUST TRUE   -- section 172.1 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 172.2, "") TRUE EQUALS JUST TRUE   -- section 172.2 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 173, "") TRUE EQUALS JUST TRUE   -- section 173 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 271, "") TRUE EQUALS JUST TRUE   -- section 271 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 272, "") TRUE EQUALS JUST TRUE   -- section 272 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 273, "") TRUE EQUALS JUST TRUE   -- section 273 is listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 160, "(2)") TRUE EQUALS JUST TRUE   -- subsection 160(2)
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 160, "(3)") TRUE EQUALS JUST TRUE   -- subsection 160(3)
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 160, "(1)") TRUE EQUALS NOTHING   -- subsection 160(1) is not listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 160, "") TRUE EQUALS NOTHING   -- section 160 as a whole is not listed, only 160(2) and (3)
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 286.1, "(2)") TRUE EQUALS JUST TRUE   -- subsection 286.1(2)
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 286.1, "(1)") TRUE EQUALS NOTHING   -- subsection 286.1(1) is not listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 286.1, "") TRUE EQUALS NOTHING   -- section 286.1 as a whole is not listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 150, "") TRUE EQUALS NOTHING   -- section 150 is not listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 154, "") TRUE EQUALS NOTHING   -- section 154 is not listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 156, "") TRUE EQUALS NOTHING   -- section 156 is not listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 162, "") TRUE EQUALS NOTHING   -- section 162 is not listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 164, "") TRUE EQUALS NOTHING   -- section 164 is not listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 169, "") TRUE EQUALS NOTHING   -- section 169 is not listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 174, "") TRUE EQUALS NOTHING   -- section 174 is not listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 270, "") TRUE EQUALS NOTHING   -- section 270 is not listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 274, "") TRUE EQUALS NOTHING   -- section 274 is not listed
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` TRUE 15 (`Provision of the Code` OF 151, "") FALSE EQUALS JUST FALSE   -- neither a Canadian citizen nor a permanent resident: "if the person ... is a Canadian citizen or a permanent resident"
#ASSERT `s 7(4.1) the act or omission is deemed to have been committed in Canada` FALSE 15 (`Provision of the Code` OF 151, "") TRUE EQUALS NOTHING   -- committed in Canada

§ `s 7(4.11)  (outside Canada; offence; Canadian citizen or permanent resident)`
#ASSERT `s 7(4.11) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 279.01, "") TRUE EQUALS JUST TRUE   -- section 279.01 is listed
#ASSERT `s 7(4.11) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 279.011, "") TRUE EQUALS JUST TRUE   -- section 279.011 is listed
#ASSERT `s 7(4.11) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 279.02, "") TRUE EQUALS JUST TRUE   -- section 279.02 is listed
#ASSERT `s 7(4.11) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 279.03, "") TRUE EQUALS JUST TRUE   -- section 279.03 is listed
#ASSERT `s 7(4.11) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 279, "") TRUE EQUALS NOTHING   -- section 279 is not listed
#ASSERT `s 7(4.11) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 279.04, "") TRUE EQUALS NOTHING   -- section 279.04 is not listed
#ASSERT `s 7(4.11) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 279.1, "") TRUE EQUALS NOTHING   -- section 279.1 is not listed
#ASSERT `s 7(4.11) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 279.2, "") TRUE EQUALS NOTHING   -- section 279.2 is not listed
#ASSERT `s 7(4.11) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 279.01, "") FALSE EQUALS JUST FALSE   -- neither a Canadian citizen nor a permanent resident
#ASSERT `s 7(4.11) the act or omission is deemed to have been committed in Canada` FALSE (`Provision of the Code` OF 279.01, "") TRUE EQUALS NOTHING   -- committed in Canada

§ `s 7(4.2)  (outside Canada; offence; Canadian citizen or permanent resident)`
#ASSERT `s 7(4.2) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 240.1, "") TRUE EQUALS JUST TRUE   -- section 240.1
#ASSERT `s 7(4.2) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 240, "") TRUE EQUALS NOTHING   -- section 240 is not section 240.1
#ASSERT `s 7(4.2) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 241, "") TRUE EQUALS NOTHING   -- section 241 is not section 240.1
#ASSERT `s 7(4.2) the act or omission is deemed to have been committed in Canada` TRUE (`Provision of the Code` OF 240.1, "") FALSE EQUALS JUST FALSE   -- not a Canadian citizen or permanent resident
#ASSERT `s 7(4.2) the act or omission is deemed to have been committed in Canada` FALSE (`Provision of the Code` OF 240.1, "") TRUE EQUALS NOTHING   -- committed in Canada

§ `s 7(4.3)  (deemed under (4.1) or (4.2); consent of the Attorney General)`
#ASSERT `s 7(4.3) the proceedings are barred for want of the consent of the Attorney General` TRUE FALSE EQUALS JUST TRUE   -- no consent: "may only be instituted with the consent"
#ASSERT `s 7(4.3) the proceedings are barred for want of the consent of the Attorney General` TRUE TRUE EQUALS JUST FALSE   -- consent obtained: the bar does not operate
#ASSERT `s 7(4.3) the proceedings are barred for want of the consent of the Attorney General` FALSE FALSE EQUALS NOTHING   -- not deemed under (4.1) or (4.2): not covered (subsection (4.11) is not named in (4.3))
#ASSERT `s 7(4.3) the proceedings are barred for want of the consent of the Attorney General` FALSE TRUE EQUALS NOTHING   -- same

§ `s 7(5)  (alleged to have committed an offence by virtue of section 7)`
#ASSERT `s 7(5) proceedings may be commenced in any territorial division in Canada, whether or not the person is in Canada` TRUE EQUALS JUST TRUE   -- the gate is met
#ASSERT `s 7(5) proceedings may be commenced in any territorial division in Canada, whether or not the person is in Canada` FALSE EQUALS JUST FALSE   -- "Where a person is alleged to have committed an act or omission that is an offence by virtue of this section" is not met
#ASSERT `s 7(5) the accused may be tried and punished as if the offence had been committed in the territorial division` TRUE EQUALS JUST TRUE   -- tried and punished as if committed in that territorial division
#ASSERT `s 7(5) the accused may be tried and punished as if the offence had been committed in the territorial division` FALSE EQUALS JUST FALSE   -- gate not met

§ `s 7(5.1)`
#ASSERT `s 7(5.1) the provisions relating to the accused's appearance and presence, and the exceptions, apply to the proceedings` TRUE EQUALS JUST TRUE   -- proceedings commenced pursuant to subsection (5)
#ASSERT `s 7(5.1) the provisions relating to the accused's appearance and presence, and the exceptions, apply to the proceedings` FALSE EQUALS NOTHING   -- other proceedings: the paragraph is silent

§ `s 7(6)  (alleged by virtue of section 7; tried and dealt with outside Canada; in a manner that would support autrefois acquit, autrefois convict, pardon or expungement)`
#ASSERT `s 7(6) the person is deemed to have been tried and dealt with in Canada` TRUE TRUE TRUE EQUALS JUST TRUE   -- all three
#ASSERT `s 7(6) the person is deemed to have been tried and dealt with in Canada` FALSE TRUE TRUE EQUALS JUST FALSE   -- not alleged by virtue of section 7
#ASSERT `s 7(6) the person is deemed to have been tried and dealt with in Canada` TRUE FALSE TRUE EQUALS JUST FALSE   -- not tried and dealt with outside Canada
#ASSERT `s 7(6) the person is deemed to have been tried and dealt with in Canada` TRUE TRUE FALSE EQUALS JUST FALSE   -- the foreign trial would not support a plea in Canada

§ `s 7(7)  (the last day; not a Canadian citizen; jurisdiction by virtue of section 7; commenced; consent day; the day asked)`
#ASSERT `s 7(7) the last day on which the consent of the Attorney General of Canada may be obtained` (Date 1 3 2025) EQUALS Date 9 3 2025   -- eight days after 1 March 2025 is 9 March 2025
#ASSERT `s 7(7) the last day on which the consent of the Attorney General of Canada may be obtained` (Date 25 2 2024) EQUALS Date 4 3 2024   -- across 29 February 2024: eight days after 25 February 2024 is 4 March 2024
#ASSERT `s 7(7) the last day on which the consent of the Attorney General of Canada may be obtained` (Date 25 2 2025) EQUALS Date 5 3 2025   -- across the end of February 2025 (no 29 February): 5 March 2025
#ASSERT `s 7(7) the continuation of the proceedings is barred for want of consent obtained in time` TRUE TRUE (Date 1 3 2025) (JUST (Date 9 3 2025)) (Date 20 3 2025) EQUALS JUST FALSE   -- consent on the eighth day: "not later than eight days after"
#ASSERT `s 7(7) the continuation of the proceedings is barred for want of consent obtained in time` TRUE TRUE (Date 1 3 2025) (JUST (Date 10 3 2025)) (Date 20 3 2025) EQUALS JUST TRUE   -- consent on the ninth day: too late
#ASSERT `s 7(7) the continuation of the proceedings is barred for want of consent obtained in time` TRUE TRUE (Date 1 3 2025) (JUST (Date 1 3 2025)) (Date 20 3 2025) EQUALS JUST FALSE   -- consent on the day the proceedings were commenced
#ASSERT `s 7(7) the continuation of the proceedings is barred for want of consent obtained in time` TRUE TRUE (Date 1 3 2025) (JUST (Date 28 2 2025)) (Date 20 3 2025) EQUALS JUST FALSE   -- consent before the proceedings were commenced is not later than eight days after
#ASSERT `s 7(7) the continuation of the proceedings is barred for want of consent obtained in time` TRUE TRUE (Date 1 3 2025) NOTHING (Date 5 3 2025) EQUALS NOTHING   -- no consent yet, the eight days still running: the subsection is silent
#ASSERT `s 7(7) the continuation of the proceedings is barred for want of consent obtained in time` TRUE TRUE (Date 1 3 2025) NOTHING (Date 9 3 2025) EQUALS NOTHING   -- no consent yet, on the last day
#ASSERT `s 7(7) the continuation of the proceedings is barred for want of consent obtained in time` TRUE TRUE (Date 1 3 2025) NOTHING (Date 10 3 2025) EQUALS JUST TRUE   -- no consent and the eight days have run out: the proceedings shall not be continued
#ASSERT `s 7(7) the continuation of the proceedings is barred for want of consent obtained in time` FALSE TRUE (Date 1 3 2025) NOTHING (Date 10 3 2025) EQUALS JUST FALSE   -- the accused is a Canadian citizen: "If the accused is not a Canadian citizen" is not met
#ASSERT `s 7(7) the continuation of the proceedings is barred for want of consent obtained in time` TRUE FALSE (Date 1 3 2025) NOTHING (Date 10 3 2025) EQUALS NOTHING   -- no jurisdiction by virtue of section 7: not covered
