§ `Tests -- sections 568 and 569 (the Attorney General may require trial by jury)`

-- "punishable with imprisonment for five years or less"
#ASSERT `s 568 an offence punishable with imprisonment for five years or less` (`imprisonment for a term of` `five years`) EQUALS JUST TRUE   -- exactly five years (boundary)
#ASSERT `s 568 an offence punishable with imprisonment for five years or less` (`imprisonment for a term of` (`Length of time` OF 5, 0, 0, TRUE)) EQUALS JUST TRUE   -- five years less a day
#ASSERT `s 568 an offence punishable with imprisonment for five years or less` (`imprisonment for a term of` (`Length of time` OF 5, 0, 1, FALSE)) EQUALS JUST FALSE   -- five years and a day (boundary)
#ASSERT `s 568 an offence punishable with imprisonment for five years or less` (`imprisonment for a term of` (`Length of time` OF 5, 1, 0, FALSE)) EQUALS JUST FALSE   -- five years and a month
#ASSERT `s 568 an offence punishable with imprisonment for five years or less` (`imprisonment for a term of` (`Length of time` OF 4, 11, 30, FALSE)) EQUALS JUST TRUE
#ASSERT `s 568 an offence punishable with imprisonment for five years or less` (`imprisonment for a term of` (`Length of time` OF 6, 0, 0, TRUE)) EQUALS JUST FALSE   -- six years less a day is still above five years
