#ASSERT `s 84(5) the earlier offence is to be considered as an earlier offence` (`Provision of the Code` OF 99, "(2)") (`Provision of the Code` OF 279, "(1)") TRUE (Date 1 1 2010) (Date 1 1 2015) 0 EQUALS JUST TRUE   -- (c) subsection 279(1) where a firearm was used
#ASSERT `s 84(5) the earlier offence is to be considered as an earlier offence` (`Provision of the Code` OF 99, "(2)") (`Provision of the Code` OF 279, "(2)") TRUE (Date 1 1 2010) (Date 1 1 2015) 0 EQUALS JUST FALSE   -- subsection 279(2) is not named, even if a firearm was used
#ASSERT `s 84(5) the earlier offence is to be considered as an earlier offence` (`Provision of the Code` OF 99, "(2)") (`Provision of the Code` OF 345, "") TRUE (Date 1 1 2010) (Date 1 1 2015) 0 EQUALS JUST FALSE   -- section 345 is not named, even if a firearm was used
#ASSERT `s 84(5) the earlier offence is to be considered as an earlier offence` (`Provision of the Code` OF 99, "(2)") (`Provision of the Code` OF 95, "") FALSE (Date 1 1 2010) (Date 1 1 2015) 0 EQUALS JUST TRUE   -- a listed offence under (a) needs no firearm
#ASSERT `s 84(5) the earlier offence is to be considered as an earlier offence` (`Provision of the Code` OF 99, "(2)") (`Provision of the Code` OF 85, "(1)") FALSE (Date 1 1 2010) (Date 31 12 2019) 0 EQUALS JUST TRUE   -- convicted 1 Jan 2010 and 31 Dec 2019: ten years have not elapsed
#ASSERT `s 84(5) the earlier offence is to be considered as an earlier offence` (`Provision of the Code` OF 99, "(2)") (`Provision of the Code` OF 85, "(1)") FALSE (Date 1 1 2010) (Date 1 1 2020) 0 EQUALS JUST FALSE   -- convicted 1 Jan 2010 and 1 Jan 2020: ten years have elapsed (on the tenth anniversary)
#ASSERT `s 84(5) the earlier offence is to be considered as an earlier offence` (`Provision of the Code` OF 99, "(2)") (`Provision of the Code` OF 85, "(1)") FALSE (Date 1 1 2010) (Date 2 1 2020) 0 EQUALS JUST FALSE   -- convicted 1 Jan 2010 and 2 Jan 2020
#ASSERT `s 84(5) the earlier offence is to be considered as an earlier offence` (`Provision of the Code` OF 99, "(2)") (`Provision of the Code` OF 85, "(1)") FALSE (Date 1 1 2010) (Date 1 1 2020) 30 EQUALS JUST TRUE   -- 30 days in custody: 1 Jan 2020 is only nine years and 335 days of time out of custody
#ASSERT `s 84(5) the earlier offence is to be considered as an earlier offence` (`Provision of the Code` OF 99, "(2)") (`Provision of the Code` OF 85, "(1)") FALSE (Date 1 1 2010) (Date 30 1 2020) 30 EQUALS JUST TRUE   -- 30 days in custody: 30 Jan 2020 is still short of ten years out of custody
#ASSERT `s 84(5) the earlier offence is to be considered as an earlier offence` (`Provision of the Code` OF 99, "(2)") (`Provision of the Code` OF 85, "(1)") FALSE (Date 1 1 2010) (Date 31 1 2020) 30 EQUALS JUST FALSE   -- 30 days in custody: 31 Jan 2020 is ten years plus the 30 days
#ASSERT `s 84(5) the earlier offence is to be considered as an earlier offence` (`Provision of the Code` OF 99, "(2)") (`Provision of the Code` OF 86, "(1)") FALSE (Date 1 1 2010) (Date 1 1 2025) 0 EQUALS JUST FALSE   -- an offence not listed, with the ten years elapsed: not listed is the first "no"

-- `s 84(6) offence one is the earlier offence for the purposes of subsection (5)`
-- inputs, in the order of the GIVEN:
--   1. offence one (`s 84(6) offence`)
--   2. offence two (`s 84(6) offence`)
#ASSERT `s 84(6) offence one is the earlier offence for the purposes of subsection (5)` (`s 84(6) offence` OF (Date 1 1 2012), (Date 1 1 2013)) (`s 84(6) offence` OF (Date 1 1 2011), (Date 1 1 2014)) EQUALS JUST TRUE   -- convicted first (2013 against 2014) although committed later (2012 against 2011): only the sequence of convictions counts
#ASSERT `s 84(6) offence one is the earlier offence for the purposes of subsection (5)` (`s 84(6) offence` OF (Date 1 1 2011), (Date 1 1 2014)) (`s 84(6) offence` OF (Date 1 1 2012), (Date 1 1 2013)) EQUALS JUST FALSE   -- committed first (2011 against 2012) but convicted second (2014 against 2013)
#ASSERT `s 84(6) offence one is the earlier offence for the purposes of subsection (5)` (`s 84(6) offence` OF (Date 1 1 2011), (Date 1 1 2013)) (`s 84(6) offence` OF (Date 1 1 2012), (Date 1 1 2014)) EQUALS JUST TRUE   -- convicted first and committed first
#ASSERT `s 84(6) offence one is the earlier offence for the purposes of subsection (5)` (`s 84(6) offence` OF (Date 1 1 2011), (Date 1 1 2013)) (`s 84(6) offence` OF (Date 1 1 2012), (Date 1 1 2013)) EQUALS NOTHING   -- both convicted on the same day: the text is silent

