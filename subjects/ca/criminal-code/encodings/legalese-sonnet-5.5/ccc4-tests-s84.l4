IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc-definitions`
IMPORT `ccc4-s84-definitions`

-- ccc4-tests-s84.l4 -- tests of ccc4-s84-definitions.l4 (section 84 of the Criminal Code, Canada).
-- Generated by work/gentests.py from work/tests/t_s84.py.  Every expected value is written by hand from the text, beside the case, before the run;
-- the input names and their order are read from the GIVEN lines of the module, so a case cannot put a value in the wrong place.
-- Abbreviations used in the case descriptions: "T" = JUST TRUE, "F" = JUST FALSE, "N" = NOTHING (not covered).

§ `Helpers: three-valued logic`

-- `s 84(1) every condition of the limb holds`
-- inputs, in the order of the GIVEN:
--   1. conditions (LIST OF MAYBE BOOLEAN)
#ASSERT `s 84(1) every condition of the limb holds` (LIST (JUST TRUE), (JUST TRUE), (JUST TRUE)) EQUALS JUST TRUE   -- all conditions hold
#ASSERT `s 84(1) every condition of the limb holds` (LIST (JUST TRUE), (JUST FALSE)) EQUALS JUST FALSE   -- one condition fails
#ASSERT `s 84(1) every condition of the limb holds` (LIST (JUST TRUE), NOTHING) EQUALS NOTHING   -- one condition is not covered, none fails
#ASSERT `s 84(1) every condition of the limb holds` (LIST NOTHING, (JUST FALSE)) EQUALS JUST FALSE   -- a failure outweighs a condition that is not covered

-- `s 84(1) some limb holds`
-- inputs, in the order of the GIVEN:
--   1. limbs (LIST OF MAYBE BOOLEAN)
#ASSERT `s 84(1) some limb holds` (LIST (JUST FALSE), (JUST FALSE)) EQUALS JUST FALSE   -- every limb fails
#ASSERT `s 84(1) some limb holds` (LIST (JUST FALSE), (JUST TRUE)) EQUALS JUST TRUE   -- one limb holds
#ASSERT `s 84(1) some limb holds` (LIST NOTHING, (JUST FALSE)) EQUALS NOTHING   -- no limb holds and one is not covered
#ASSERT `s 84(1) some limb holds` (LIST NOTHING, (JUST TRUE)) EQUALS JUST TRUE   -- a limb that holds outweighs a limb that is not covered

-- `s 84(1) the answer reversed`
-- inputs, in the order of the GIVEN:
--   1. answer (MAYBE BOOLEAN)
#ASSERT `s 84(1) the answer reversed` (JUST TRUE) EQUALS JUST FALSE   -- a yes becomes a no
#ASSERT `s 84(1) the answer reversed` (JUST FALSE) EQUALS JUST TRUE   -- a no becomes a yes
#ASSERT `s 84(1) the answer reversed` NOTHING EQUALS NOTHING   -- not covered stays not covered

§ `Section 84(1) -- Definitions`

§§ `ammunition`

-- `s 84(1) ammunition` -- "means a cartridge containing a projectile designed to be discharged from a firearm and, without restricting the generality of the foregoing, includes a caseless cartridge and a shot shell"
-- inputs, in the order of the GIVEN:
--   1. kind (`s 84(1) ammunition kind`)
#ASSERT `s 84(1) ammunition` `s 84(1) ammunition: a cartridge containing a projectile designed to be discharged from a firearm` EQUALS JUST TRUE   -- a cartridge containing a projectile designed to be discharged from a firearm
#ASSERT `s 84(1) ammunition` `s 84(1) ammunition: a caseless cartridge` EQUALS JUST TRUE   -- a caseless cartridge (the "includes" limb)
#ASSERT `s 84(1) ammunition` `s 84(1) ammunition: a shot shell` EQUALS JUST TRUE   -- a shot shell (the "includes" limb)
#ASSERT `s 84(1) ammunition` `s 84(1) ammunition: a thing that is none of those` EQUALS NOTHING   -- a thing that is none of those: the list is open ("without restricting the generality"), so not covered

§§ `antique firearm`

-- `s 84(1) antique firearm`
-- inputs, in the order of the GIVEN:
--   1. s 2 firearm: the thing is a firearm (MAYBE BOOLEAN)
--   2. the year in which it was manufactured (NUMBER)
--   3. it was designed to discharge rim-fire or centre-fire ammunition (BOOLEAN)
--   4. it has been redesigned to discharge rim-fire or centre-fire ammunition (BOOLEAN)
--   5. it is prescribed to be an antique firearm (MAYBE BOOLEAN)
#ASSERT `s 84(1) antique firearm` (JUST TRUE) 1897 FALSE FALSE (JUST FALSE) EQUALS JUST TRUE   -- (a) manufactured in 1897, not designed or redesigned for rim-fire or centre-fire ammunition
#ASSERT `s 84(1) antique firearm` (JUST TRUE) 1898 FALSE FALSE (JUST FALSE) EQUALS JUST FALSE   -- (a) manufactured in 1898 is not "before 1898"
#ASSERT `s 84(1) antique firearm` (JUST TRUE) 1897 TRUE FALSE (JUST FALSE) EQUALS JUST FALSE   -- (a) manufactured in 1897 but designed to discharge rim-fire or centre-fire ammunition
#ASSERT `s 84(1) antique firearm` (JUST TRUE) 1897 FALSE TRUE (JUST FALSE) EQUALS JUST FALSE   -- (a) manufactured in 1897 but redesigned to discharge such ammunition
#ASSERT `s 84(1) antique firearm` (JUST TRUE) 1900 FALSE FALSE (JUST TRUE) EQUALS JUST TRUE   -- (b) a firearm prescribed to be an antique firearm
#ASSERT `s 84(1) antique firearm` (JUST TRUE) 1900 FALSE FALSE NOTHING EQUALS NOTHING   -- (b) the regulations are not known and (a) fails
#ASSERT `s 84(1) antique firearm` (JUST TRUE) 1850 FALSE FALSE NOTHING EQUALS JUST TRUE   -- (a) holds although (b) is not known
#ASSERT `s 84(1) antique firearm` (JUST FALSE) 1850 FALSE FALSE (JUST FALSE) EQUALS JUST FALSE   -- not a firearm at all
#ASSERT `s 84(1) antique firearm` (JUST FALSE) 1900 FALSE FALSE (JUST TRUE) EQUALS JUST FALSE   -- prescribed but not a firearm
#ASSERT `s 84(1) antique firearm` NOTHING 1850 FALSE FALSE (JUST FALSE) EQUALS NOTHING   -- whether it is a firearm is not covered

§§ `authorization, licence, registration certificate, chief firearms officer, firearms officer, Commissioner of Firearms, Registrar: each "means ... under the Firearms Act"`

-- `s 84(1) authorization`
-- inputs, in the order of the GIVEN:
--   1. it is an authorization issued under the Firearms Act (BOOLEAN)
#ASSERT `s 84(1) authorization` TRUE EQUALS JUST TRUE   -- it is what the Firearms Act describes
#ASSERT `s 84(1) authorization` FALSE EQUALS JUST FALSE   -- it is not

-- `s 84(1) licence`
-- inputs, in the order of the GIVEN:
--   1. it is a licence issued under the Firearms Act (BOOLEAN)
#ASSERT `s 84(1) licence` TRUE EQUALS JUST TRUE   -- it is what the Firearms Act describes
#ASSERT `s 84(1) licence` FALSE EQUALS JUST FALSE   -- it is not

-- `s 84(1) registration certificate`
-- inputs, in the order of the GIVEN:
--   1. it is a registration certificate issued under the Firearms Act (BOOLEAN)
#ASSERT `s 84(1) registration certificate` TRUE EQUALS JUST TRUE   -- it is what the Firearms Act describes
#ASSERT `s 84(1) registration certificate` FALSE EQUALS JUST FALSE   -- it is not

-- `s 84(1) chief firearms officer`
-- inputs, in the order of the GIVEN:
--   1. it is a chief firearms officer as defined in subsection 2(1) of the Firearms Act (BOOLEAN)
#ASSERT `s 84(1) chief firearms officer` TRUE EQUALS JUST TRUE   -- it is what the Firearms Act describes
#ASSERT `s 84(1) chief firearms officer` FALSE EQUALS JUST FALSE   -- it is not

-- `s 84(1) firearms officer`
-- inputs, in the order of the GIVEN:
--   1. it is a firearms officer as defined in subsection 2(1) of the Firearms Act (BOOLEAN)
#ASSERT `s 84(1) firearms officer` TRUE EQUALS JUST TRUE   -- it is what the Firearms Act describes
#ASSERT `s 84(1) firearms officer` FALSE EQUALS JUST FALSE   -- it is not

-- `s 84(1) Commissioner of Firearms`
-- inputs, in the order of the GIVEN:
--   1. it is the Commissioner of Firearms appointed under section 81.1 of the Firearms Act (BOOLEAN)
#ASSERT `s 84(1) Commissioner of Firearms` TRUE EQUALS JUST TRUE   -- it is what the Firearms Act describes
#ASSERT `s 84(1) Commissioner of Firearms` FALSE EQUALS JUST FALSE   -- it is not

-- `s 84(1) Registrar`
-- inputs, in the order of the GIVEN:
--   1. it is the Registrar of Firearms appointed under section 82 of the Firearms Act (BOOLEAN)
#ASSERT `s 84(1) Registrar` TRUE EQUALS JUST TRUE   -- it is what the Firearms Act describes
#ASSERT `s 84(1) Registrar` FALSE EQUALS JUST FALSE   -- it is not

§§ `automatic firearm`

-- `s 84(1) automatic firearm`
-- inputs, in the order of the GIVEN:
--   1. s 2 firearm: the thing is a firearm (MAYBE BOOLEAN)
--   2. it is capable of discharging projectiles in rapid succession during one pressure of the trigger (BOOLEAN)
--   3. it is assembled or designed and manufactured with the capability of discharging projectiles in rapid succession during one pressure of the trigger (BOOLEAN)
#ASSERT `s 84(1) automatic firearm` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE   -- a firearm capable of discharging projectiles in rapid succession during one pressure of the trigger
#ASSERT `s 84(1) automatic firearm` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- a firearm assembled or designed and manufactured with that capability
#ASSERT `s 84(1) automatic firearm` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE   -- a firearm with neither
#ASSERT `s 84(1) automatic firearm` (JUST FALSE) TRUE FALSE EQUALS JUST FALSE   -- capable, but not a firearm
#ASSERT `s 84(1) automatic firearm` NOTHING TRUE FALSE EQUALS NOTHING   -- capable, and whether it is a firearm is not covered

§§ `cartridge magazine`

-- `s 84(1) cartridge magazine`
-- inputs, in the order of the GIVEN:
--   1. it is a device or container from which ammunition may be fed into the firing chamber of a firearm (BOOLEAN)
#ASSERT `s 84(1) cartridge magazine` TRUE EQUALS JUST TRUE   -- a device or container from which ammunition may be fed into the firing chamber of a firearm
#ASSERT `s 84(1) cartridge magazine` FALSE EQUALS JUST FALSE   -- anything else

§§ `cross-bow`

-- `s 84(1) cross-bow`
-- inputs, in the order of the GIVEN:
--   1. it is a device with a bow and a bowstring mounted on a stock (BOOLEAN)
--   2. it is designed to propel an arrow, a bolt, a quarrel or any similar projectile on a trajectory guided by a barrel or groove (BOOLEAN)
--   3. it is capable of causing serious bodily injury or death to a person (BOOLEAN)
#ASSERT `s 84(1) cross-bow` TRUE TRUE TRUE EQUALS JUST TRUE   -- a bow and bowstring on a stock, designed to propel a projectile guided by a barrel or groove, capable of causing serious bodily injury or death
#ASSERT `s 84(1) cross-bow` FALSE TRUE TRUE EQUALS JUST FALSE   -- no bow and bowstring mounted on a stock
#ASSERT `s 84(1) cross-bow` TRUE FALSE TRUE EQUALS JUST FALSE   -- not designed to propel on a trajectory guided by a barrel or groove
#ASSERT `s 84(1) cross-bow` TRUE TRUE FALSE EQUALS JUST FALSE   -- not capable of causing serious bodily injury or death

§§ `export and import`

-- `s 84(1) export`
-- inputs, in the order of the GIVEN:
--   1. it is an export from Canada (BOOLEAN)
--   2. it is the exportation of goods from Canada that are imported into Canada and shipped in transit through Canada (BOOLEAN)
#ASSERT `s 84(1) export` TRUE FALSE EQUALS JUST TRUE   -- export from Canada
#ASSERT `s 84(1) export` FALSE TRUE EQUALS JUST TRUE   -- "for greater certainty": exportation of goods imported into Canada and shipped in transit through Canada
#ASSERT `s 84(1) export` FALSE FALSE EQUALS JUST FALSE   -- neither

-- `s 84(1) import`
-- inputs, in the order of the GIVEN:
--   1. it is an import into Canada (BOOLEAN)
--   2. it is the importation of goods into Canada that are shipped in transit through Canada and exported from Canada (BOOLEAN)
#ASSERT `s 84(1) import` TRUE FALSE EQUALS JUST TRUE   -- import into Canada
#ASSERT `s 84(1) import` FALSE TRUE EQUALS JUST TRUE   -- "for greater certainty": importation of goods shipped in transit through Canada and exported from Canada
#ASSERT `s 84(1) import` FALSE FALSE EQUALS JUST FALSE   -- neither

§§ `firearm part`

-- `s 84(1) firearm part`
-- inputs, in the order of the GIVEN:
--   1. it is a barrel for a firearm (BOOLEAN)
--   2. it is a slide for a handgun (BOOLEAN)
--   3. it is another part that is prescribed to be a firearm part (MAYBE BOOLEAN)
--   4. the barrel or slide is designed exclusively for use on a firearm that is deemed under subsection 84(3) not to be a firearm (BOOLEAN)
--   5. it is otherwise prescribed that the barrel or slide is a firearm part (MAYBE BOOLEAN)
#ASSERT `s 84(1) firearm part` TRUE FALSE (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST TRUE   -- a barrel for a firearm
#ASSERT `s 84(1) firearm part` FALSE TRUE (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST TRUE   -- a slide for a handgun
#ASSERT `s 84(1) firearm part` FALSE FALSE (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST TRUE   -- any other prescribed part
#ASSERT `s 84(1) firearm part` FALSE FALSE NOTHING FALSE (JUST FALSE) EQUALS NOTHING   -- another part whose prescription is not known
#ASSERT `s 84(1) firearm part` FALSE FALSE (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST FALSE   -- none of those
#ASSERT `s 84(1) firearm part` TRUE FALSE (JUST FALSE) TRUE (JUST FALSE) EQUALS JUST FALSE   -- a barrel designed exclusively for use on a firearm deemed by subsection 84(3) not to be a firearm: "does not include"
#ASSERT `s 84(1) firearm part` FALSE TRUE (JUST FALSE) TRUE (JUST FALSE) EQUALS JUST FALSE   -- a slide so designed
#ASSERT `s 84(1) firearm part` TRUE FALSE (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST TRUE   -- the same barrel, "unless otherwise prescribed" and the regulations do prescribe it
#ASSERT `s 84(1) firearm part` TRUE FALSE (JUST FALSE) TRUE NOTHING EQUALS NOTHING   -- the same barrel and whether it is otherwise prescribed is not known
#ASSERT `s 84(1) firearm part` FALSE FALSE (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST TRUE   -- another prescribed part is not a barrel or slide, so the exclusion does not reach it

§§ `handgun`

-- `s 84(1) handgun`
-- inputs, in the order of the GIVEN:
--   1. s 2 firearm: the thing is a firearm (MAYBE BOOLEAN)
--   2. it is designed, altered or intended to be aimed and fired by the action of one hand (BOOLEAN)
#ASSERT `s 84(1) handgun` (JUST TRUE) TRUE EQUALS JUST TRUE   -- a firearm designed, altered or intended to be aimed and fired by the action of one hand
#ASSERT `s 84(1) handgun` (JUST TRUE) FALSE EQUALS JUST FALSE   -- a firearm that is not
#ASSERT `s 84(1) handgun` (JUST FALSE) TRUE EQUALS JUST FALSE   -- aimed and fired by one hand but not a firearm
#ASSERT `s 84(1) handgun` NOTHING TRUE EQUALS NOTHING   -- whether it is a firearm is not covered

§§ `imitation firearm`

-- `s 84(1) imitation firearm`
-- inputs, in the order of the GIVEN:
--   1. it is a thing that imitates a firearm (BOOLEAN)
--   2. s 84(1) replica firearm: the thing is a replica firearm (MAYBE BOOLEAN)
#ASSERT `s 84(1) imitation firearm` TRUE (JUST FALSE) EQUALS JUST TRUE   -- any thing that imitates a firearm
#ASSERT `s 84(1) imitation firearm` FALSE (JUST TRUE) EQUALS JUST TRUE   -- "and includes a replica firearm"
#ASSERT `s 84(1) imitation firearm` FALSE (JUST FALSE) EQUALS JUST FALSE   -- neither (reading A of fork F2: closed)
#ASSERT `s 84(1) imitation firearm` FALSE NOTHING EQUALS NOTHING   -- does not imitate a firearm and whether it is a replica firearm is not covered

§§ `non-restricted firearm`

-- `s 84(1) non-restricted firearm`
-- inputs, in the order of the GIVEN:
--   1. s 2 firearm: the thing is a firearm (MAYBE BOOLEAN)
--   2. s 84(1) prohibited firearm: the firearm is a prohibited firearm (MAYBE BOOLEAN)
--   3. s 84(1) restricted firearm: the firearm is a restricted firearm (MAYBE BOOLEAN)
#ASSERT `s 84(1) non-restricted firearm` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- a firearm that is neither a prohibited firearm nor a restricted firearm
#ASSERT `s 84(1) non-restricted firearm` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE   -- a prohibited firearm
#ASSERT `s 84(1) non-restricted firearm` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE   -- a restricted firearm
#ASSERT `s 84(1) non-restricted firearm` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- not a firearm
#ASSERT `s 84(1) non-restricted firearm` (JUST TRUE) NOTHING (JUST FALSE) EQUALS NOTHING   -- whether it is a prohibited firearm is not covered
#ASSERT `s 84(1) non-restricted firearm` (JUST TRUE) NOTHING (JUST TRUE) EQUALS JUST FALSE   -- a restricted firearm and whether it is a prohibited firearm is not covered: the "no" outweighs

§§ `prescribed`

-- `s 84(1) prescribed`
-- inputs, in the order of the GIVEN:
--   1. the regulations prescribe it (MAYBE BOOLEAN)
#ASSERT `s 84(1) prescribed` (JUST TRUE) EQUALS JUST TRUE   -- the regulations prescribe it
#ASSERT `s 84(1) prescribed` (JUST FALSE) EQUALS JUST FALSE   -- the regulations do not
#ASSERT `s 84(1) prescribed` NOTHING EQUALS NOTHING   -- the regulations are not among the sources and the caller does not know

§§ `prohibited ammunition`

-- `s 84(1) prohibited ammunition`
-- inputs, in the order of the GIVEN:
--   1. s 84(1) ammunition: the thing is ammunition (MAYBE BOOLEAN)
--   2. it is a projectile of any kind (BOOLEAN)
--   3. it is prescribed to be prohibited ammunition (MAYBE BOOLEAN)
#ASSERT `s 84(1) prohibited ammunition` (JUST TRUE) FALSE (JUST TRUE) EQUALS JUST TRUE   -- ammunition prescribed to be prohibited ammunition
#ASSERT `s 84(1) prohibited ammunition` (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST TRUE   -- "or a projectile of any kind" prescribed to be prohibited ammunition
#ASSERT `s 84(1) prohibited ammunition` (JUST FALSE) FALSE (JUST TRUE) EQUALS JUST FALSE   -- neither ammunition nor a projectile, though prescribed
#ASSERT `s 84(1) prohibited ammunition` (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST FALSE   -- ammunition that is not prescribed
#ASSERT `s 84(1) prohibited ammunition` (JUST TRUE) FALSE NOTHING EQUALS NOTHING   -- ammunition whose prescription is not known
#ASSERT `s 84(1) prohibited ammunition` NOTHING FALSE (JUST TRUE) EQUALS NOTHING   -- whether it is ammunition is not covered, and it is prescribed

§§ `prohibited device`

-- `s 84(1) prohibited device`
-- inputs, in the order of the GIVEN:
--   1. it is a component or part of a weapon, or an accessory for use with a weapon (BOOLEAN)
--   2. it is prescribed to be a prohibited device (MAYBE BOOLEAN)
--   3. it is a handgun barrel (BOOLEAN)
--   4. the length of the handgun barrel in millimetres (NUMBER)
--   5. the handgun barrel is one that is prescribed (a barrel the definition does not include) (MAYBE BOOLEAN)
--   6. the handgun barrel is for use in international sporting competitions governed by the rules of the International Shooting Union (BOOLEAN)
--   7. it is a device or contrivance designed or intended to muffle or stop the sound or report of a firearm (BOOLEAN)
--   8. s 84(1) cartridge magazine: the thing is a cartridge magazine (MAYBE BOOLEAN)
--   9. s 84(1) replica firearm: the thing is a replica firearm (MAYBE BOOLEAN)
#ASSERT `s 84(1) prohibited device` TRUE (JUST TRUE) FALSE 0 (JUST FALSE) FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- (a) a component or part of a weapon prescribed to be a prohibited device
#ASSERT `s 84(1) prohibited device` TRUE (JUST FALSE) FALSE 0 (JUST FALSE) FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- (a) a component of a weapon that is not prescribed
#ASSERT `s 84(1) prohibited device` TRUE NOTHING FALSE 0 (JUST FALSE) FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS NOTHING   -- (a) a component of a weapon whose prescription is not known
#ASSERT `s 84(1) prohibited device` FALSE (JUST FALSE) TRUE 105 (JUST FALSE) FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- (b) a handgun barrel of exactly 105 mm: "equal to or less than 105 mm"
#ASSERT `s 84(1) prohibited device` FALSE (JUST FALSE) TRUE 105.1 (JUST FALSE) FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- (b) a handgun barrel of 105.1 mm
#ASSERT `s 84(1) prohibited device` FALSE (JUST FALSE) TRUE 100 (JUST TRUE) TRUE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- (b) a barrel of 100 mm that is prescribed and for use in International Shooting Union competitions: "does not include"
#ASSERT `s 84(1) prohibited device` FALSE (JUST FALSE) TRUE 100 (JUST TRUE) FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- (b) prescribed but not for use in those competitions
#ASSERT `s 84(1) prohibited device` FALSE (JUST FALSE) TRUE 100 (JUST FALSE) TRUE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- (b) for use in those competitions but not prescribed
#ASSERT `s 84(1) prohibited device` FALSE (JUST FALSE) TRUE 100 NOTHING TRUE FALSE (JUST FALSE) (JUST FALSE) EQUALS NOTHING   -- (b) for use in those competitions and whether it is prescribed is not known
#ASSERT `s 84(1) prohibited device` FALSE (JUST FALSE) FALSE 0 (JUST FALSE) FALSE TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- (c) a device designed or intended to muffle or stop the sound or report of a firearm
#ASSERT `s 84(1) prohibited device` FALSE (JUST TRUE) FALSE 0 (JUST FALSE) FALSE FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- (d) a cartridge magazine prescribed to be a prohibited device
#ASSERT `s 84(1) prohibited device` FALSE (JUST FALSE) FALSE 0 (JUST FALSE) FALSE FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE   -- (d) a cartridge magazine that is not prescribed
#ASSERT `s 84(1) prohibited device` FALSE (JUST FALSE) FALSE 0 (JUST FALSE) FALSE FALSE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE   -- (e) a replica firearm
#ASSERT `s 84(1) prohibited device` FALSE (JUST FALSE) FALSE 0 (JUST FALSE) FALSE FALSE (JUST FALSE) NOTHING EQUALS NOTHING   -- (e) whether it is a replica firearm is not covered
#ASSERT `s 84(1) prohibited device` FALSE (JUST FALSE) FALSE 0 (JUST FALSE) FALSE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- none of the five

§§ `prohibited firearm`

-- `s 84(1) prohibited firearm`
-- inputs, in the order of the GIVEN:
--   1. s 2 firearm: the thing is a firearm (MAYBE BOOLEAN)
--   2. s 84(1) handgun: the firearm is a handgun (MAYBE BOOLEAN)
--   3. the length of its barrel in millimetres, measured as subsection 84(2) says (NUMBER)
--   4. it is designed or adapted to discharge a 25 or 32 calibre cartridge (BOOLEAN)
--   5. the handgun is one that is prescribed (a handgun the definition does not include) (MAYBE BOOLEAN)
--   6. the handgun is for use in international sporting competitions governed by the rules of the International Shooting Union (BOOLEAN)
--   7. it is adapted from a rifle or shotgun, by sawing, cutting or any other alteration (BOOLEAN)
--   8. its length in millimetres as so adapted (NUMBER)
--   9. s 84(1) automatic firearm: the firearm is an automatic firearm (MAYBE BOOLEAN)
--   10. it is prescribed to be a prohibited firearm (MAYBE BOOLEAN)
--   11. it is an unlawfully manufactured firearm (BOOLEAN)
--   12. it discharges centre-fire ammunition in a semi-automatic manner (BOOLEAN)
--   13. the capacity in cartridges of the detachable cartridge magazine it was originally designed with (0 if none) (NUMBER)
--   14. it was designed and manufactured on or after the day on which the second paragraph (e) comes into force (BOOLEAN)
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST TRUE) 105 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST TRUE   -- (a)(i) a handgun with a barrel of 105 mm: "equal to or less than 105 mm"
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST TRUE) 105.1 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST FALSE   -- (a)(i) a handgun with a barrel of 105.1 mm and no 25 or 32 calibre
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST TRUE) 500 TRUE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST TRUE   -- (a)(ii) a handgun designed or adapted to discharge a 25 or 32 calibre cartridge
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST TRUE) 100 FALSE (JUST TRUE) TRUE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST FALSE   -- (a) a short handgun that is prescribed and for use in International Shooting Union competitions: "does not include"
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST TRUE) 100 FALSE (JUST TRUE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST TRUE   -- (a) the same handgun, prescribed but not for use in those competitions
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST TRUE) 100 FALSE (JUST FALSE) TRUE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST TRUE   -- (a) the same handgun, for use in those competitions but not prescribed
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST TRUE) 100 FALSE NOTHING TRUE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS NOTHING   -- (a) the same handgun, for use in those competitions and whether prescribed not known
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 100 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST FALSE   -- (a) a short firearm that is not a handgun
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) NOTHING 100 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS NOTHING   -- (a) whether the short firearm is a handgun is not covered
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE TRUE 659.9 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST TRUE   -- (b)(i) adapted from a rifle or shotgun, 659.9 mm long
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 457 FALSE (JUST FALSE) FALSE TRUE 660 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST FALSE   -- (b)(ii) adapted, exactly 660 mm long with a barrel of exactly 457 mm: not "less than 457 mm"
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 456.9 FALSE (JUST FALSE) FALSE TRUE 660 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST TRUE   -- (b)(ii) adapted, 660 mm long with a barrel of 456.9 mm
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE TRUE 700 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST FALSE   -- (b) adapted, 700 mm long with a 500 mm barrel
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 500 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST FALSE   -- (b) 500 mm long but not adapted from a rifle or shotgun
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST TRUE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST TRUE   -- (c) an automatic firearm
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 1000 NOTHING (JUST FALSE) FALSE FALSE 0 FALSE EQUALS NOTHING   -- (c) whether it is an automatic firearm is not covered
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST TRUE) FALSE FALSE 0 FALSE EQUALS JUST TRUE   -- (d) a firearm prescribed to be a prohibited firearm
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) NOTHING FALSE FALSE 0 FALSE EQUALS NOTHING   -- (d) whether it is prescribed is not known
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) TRUE FALSE 0 FALSE EQUALS JUST TRUE   -- (e) (the first) an unlawfully manufactured firearm
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE TRUE 6 TRUE EQUALS JUST TRUE   -- (e) (the second) not a handgun, centre-fire semi-automatic, magazine of six cartridges, made on or after the day the paragraph comes into force
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE TRUE 5 TRUE EQUALS JUST FALSE   -- (e) (the second) a magazine of five cartridges: "six cartridges or more"
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE TRUE 6 FALSE EQUALS JUST FALSE   -- (e) (the second) made before the day the paragraph comes into force
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE FALSE 6 TRUE EQUALS JUST FALSE   -- (e) (the second) not centre-fire semi-automatic
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST TRUE) 200 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE TRUE 6 TRUE EQUALS JUST FALSE   -- (e) (the second) a handgun
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) NOTHING 500 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE TRUE 6 TRUE EQUALS NOTHING   -- (e) (the second) whether it is a handgun is not covered
#ASSERT `s 84(1) prohibited firearm` (JUST TRUE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) FALSE FALSE 0 FALSE EQUALS JUST FALSE   -- none of the paragraphs
#ASSERT `s 84(1) prohibited firearm` (JUST FALSE) (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) TRUE FALSE 0 FALSE EQUALS JUST FALSE   -- an unlawfully manufactured thing that is not a firearm
#ASSERT `s 84(1) prohibited firearm` NOTHING (JUST FALSE) 500 FALSE (JUST FALSE) FALSE FALSE 1000 (JUST FALSE) (JUST FALSE) TRUE FALSE 0 FALSE EQUALS NOTHING   -- whether it is a firearm is not covered

§§ `prohibited weapon`

-- `s 84(1) prohibited weapon`
-- inputs, in the order of the GIVEN:
--   1. it is a knife that has a blade that opens automatically by gravity or centrifugal force or by hand pressure applied to a button, spring or other device in or attached to the handle of the knife (BOOLEAN)
--   2. s 2 weapon: the thing is a weapon (MAYBE BOOLEAN)
--   3. s 2 firearm: the thing is a firearm (MAYBE BOOLEAN)
--   4. it is prescribed to be a prohibited weapon (MAYBE BOOLEAN)
#ASSERT `s 84(1) prohibited weapon` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- (a) a knife with a blade that opens automatically by gravity, centrifugal force or hand pressure on a button, spring or other device
#ASSERT `s 84(1) prohibited weapon` FALSE (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE   -- (b) a weapon, other than a firearm, prescribed to be a prohibited weapon
#ASSERT `s 84(1) prohibited weapon` FALSE (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE   -- (b) a firearm that is prescribed: "other than a firearm"
#ASSERT `s 84(1) prohibited weapon` FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- (b) a weapon that is not prescribed
#ASSERT `s 84(1) prohibited weapon` FALSE (JUST TRUE) (JUST FALSE) NOTHING EQUALS NOTHING   -- (b) a weapon whose prescription is not known
#ASSERT `s 84(1) prohibited weapon` FALSE (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE   -- (b) not a weapon
#ASSERT `s 84(1) prohibited weapon` FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- neither limb

§§ `prohibition order`

-- `s 84(1) prohibition order`
-- inputs, in the order of the GIVEN:
--   1. it is an order made under this Act or any other Act of Parliament (BOOLEAN)
--   2. it prohibits a person from possessing any firearm, cross-bow, prohibited weapon, restricted weapon, prohibited device, firearm part, ammunition, prohibited ammunition or explosive substance, or all such things (BOOLEAN)
#ASSERT `s 84(1) prohibition order` TRUE TRUE EQUALS JUST TRUE   -- an order under this Act or another Act of Parliament prohibiting possession of the things listed
#ASSERT `s 84(1) prohibition order` FALSE TRUE EQUALS JUST FALSE   -- an order that is not made under an Act of Parliament
#ASSERT `s 84(1) prohibition order` TRUE FALSE EQUALS JUST FALSE   -- an order that does not prohibit possession of any of the things

§§ `replica firearm`

-- `s 84(1) replica firearm`
-- inputs, in the order of the GIVEN:
--   1. it is a device designed or intended to exactly resemble, or to resemble with near precision, a firearm (BOOLEAN)
--   2. the muzzle velocity in metres per second at which the firearm it resembles is designed or adapted to discharge a shot, bullet or other projectile (NUMBER)
--   3. the muzzle energy in joules at which the firearm it resembles is designed or adapted to discharge a shot, bullet or other projectile (NUMBER)
--   4. s 2 firearm: the device itself is a firearm (MAYBE BOOLEAN)
--   5. s 84(1) antique firearm: the firearm it resembles is an antique firearm (MAYBE BOOLEAN)
#ASSERT `s 84(1) replica firearm` TRUE 200 10 (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- a device resembling a firearm that discharges at over 152.4 m per second and over 5.7 joules, and is not itself a firearm
#ASSERT `s 84(1) replica firearm` TRUE 152.4 10 (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- the firearm resembled discharges at exactly 152.4 m per second: not "exceeding"
#ASSERT `s 84(1) replica firearm` TRUE 152.5 10 (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- 152.5 m per second
#ASSERT `s 84(1) replica firearm` TRUE 200 5.7 (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- exactly 5.7 joules
#ASSERT `s 84(1) replica firearm` TRUE 200 5.8 (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- 5.8 joules
#ASSERT `s 84(1) replica firearm` TRUE 200 5 (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- velocity exceeds but energy does not: both are required ("and")
#ASSERT `s 84(1) replica firearm` TRUE 100 10 (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- energy exceeds but velocity does not
#ASSERT `s 84(1) replica firearm` FALSE 200 10 (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- not designed or intended to resemble a firearm
#ASSERT `s 84(1) replica firearm` TRUE 200 10 (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE   -- the device is itself a firearm
#ASSERT `s 84(1) replica firearm` TRUE 200 10 NOTHING (JUST FALSE) EQUALS NOTHING   -- whether the device is itself a firearm is not covered
#ASSERT `s 84(1) replica firearm` TRUE 200 10 (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE   -- it resembles an antique firearm: "does not include"
#ASSERT `s 84(1) replica firearm` TRUE 200 10 (JUST FALSE) NOTHING EQUALS NOTHING   -- whether the firearm it resembles is an antique firearm is not covered

§§ `restricted firearm`

-- `s 84(1) restricted firearm`
-- inputs, in the order of the GIVEN:
--   1. s 2 firearm: the thing is a firearm (MAYBE BOOLEAN)
--   2. s 84(1) handgun: the firearm is a handgun (MAYBE BOOLEAN)
--   3. s 84(1) prohibited firearm: the firearm is a prohibited firearm (MAYBE BOOLEAN)
--   4. the length of its barrel in millimetres, measured as subsection 84(2) says (NUMBER)
--   5. it is capable of discharging centre-fire ammunition in a semi-automatic manner (BOOLEAN)
--   6. the shortest length in millimetres to which it is designed or adapted to be reduced by folding, telescoping or otherwise, to be fired (its length if it cannot be reduced) (NUMBER)
--   7. it is a firearm of another kind that is prescribed to be a restricted firearm (MAYBE BOOLEAN)
#ASSERT `s 84(1) restricted firearm` (JUST TRUE) (JUST TRUE) (JUST FALSE) 500 FALSE 1000 (JUST FALSE) EQUALS JUST TRUE   -- (a) a handgun that is not a prohibited firearm
#ASSERT `s 84(1) restricted firearm` (JUST TRUE) (JUST TRUE) (JUST TRUE) 500 FALSE 1000 (JUST FALSE) EQUALS JUST FALSE   -- (a) a handgun that is a prohibited firearm
#ASSERT `s 84(1) restricted firearm` (JUST TRUE) (JUST TRUE) NOTHING 500 FALSE 1000 (JUST FALSE) EQUALS NOTHING   -- (a) a handgun when whether it is a prohibited firearm is not covered
#ASSERT `s 84(1) restricted firearm` (JUST TRUE) (JUST FALSE) (JUST FALSE) 469.9 TRUE 1000 (JUST FALSE) EQUALS JUST TRUE   -- (b) a firearm with a barrel of 469.9 mm capable of discharging centre-fire ammunition in a semi-automatic manner
#ASSERT `s 84(1) restricted firearm` (JUST TRUE) (JUST FALSE) (JUST FALSE) 470 TRUE 1000 (JUST FALSE) EQUALS JUST FALSE   -- (b) a barrel of exactly 470 mm: "less than 470 mm"
#ASSERT `s 84(1) restricted firearm` (JUST TRUE) (JUST FALSE) (JUST FALSE) 400 FALSE 1000 (JUST FALSE) EQUALS JUST FALSE   -- (b) a short barrel but not capable of semi-automatic centre-fire discharge
#ASSERT `s 84(1) restricted firearm` (JUST TRUE) (JUST FALSE) (JUST TRUE) 400 TRUE 1000 (JUST FALSE) EQUALS JUST FALSE   -- (b) a short semi-automatic firearm that is a prohibited firearm
#ASSERT `s 84(1) restricted firearm` (JUST TRUE) (JUST FALSE) (JUST FALSE) 500 FALSE 659.9 (JUST FALSE) EQUALS JUST TRUE   -- (c) designed or adapted to be fired when reduced to 659.9 mm by folding or telescoping
#ASSERT `s 84(1) restricted firearm` (JUST TRUE) (JUST FALSE) (JUST FALSE) 500 FALSE 660 (JUST FALSE) EQUALS JUST FALSE   -- (c) reduced to exactly 660 mm: "less than 660 mm"
#ASSERT `s 84(1) restricted firearm` (JUST TRUE) (JUST FALSE) (JUST FALSE) 500 FALSE 1000 (JUST TRUE) EQUALS JUST TRUE   -- (d) a firearm of another kind prescribed to be a restricted firearm
#ASSERT `s 84(1) restricted firearm` (JUST TRUE) (JUST FALSE) (JUST FALSE) 500 FALSE 1000 NOTHING EQUALS NOTHING   -- (d) whether prescribed is not known
#ASSERT `s 84(1) restricted firearm` (JUST TRUE) (JUST FALSE) (JUST FALSE) 500 FALSE 1000 (JUST FALSE) EQUALS JUST FALSE   -- none of the paragraphs

§§ `restricted weapon`

-- `s 84(1) restricted weapon`
-- inputs, in the order of the GIVEN:
--   1. s 2 weapon: the thing is a weapon (MAYBE BOOLEAN)
--   2. s 2 firearm: the thing is a firearm (MAYBE BOOLEAN)
--   3. it is prescribed to be a restricted weapon (MAYBE BOOLEAN)
#ASSERT `s 84(1) restricted weapon` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE   -- a weapon, other than a firearm, prescribed to be a restricted weapon
#ASSERT `s 84(1) restricted weapon` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE   -- a firearm: "other than a firearm"
#ASSERT `s 84(1) restricted weapon` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- a weapon that is not prescribed
#ASSERT `s 84(1) restricted weapon` (JUST TRUE) (JUST FALSE) NOTHING EQUALS NOTHING   -- a weapon whose prescription is not known
#ASSERT `s 84(1) restricted weapon` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE   -- not a weapon

§§ `semi-automatic`

-- `s 84(1) semi-automatic`
-- inputs, in the order of the GIVEN:
--   1. s 2 firearm: the thing is a firearm (MAYBE BOOLEAN)
--   2. it is equipped with a mechanism that, following the discharge of a cartridge, automatically operates to complete any part of the reloading cycle necessary to prepare for the discharge of the next cartridge (BOOLEAN)
#ASSERT `s 84(1) semi-automatic` (JUST TRUE) TRUE EQUALS JUST TRUE   -- a firearm equipped with a mechanism that, after the discharge of a cartridge, automatically completes part of the reloading cycle
#ASSERT `s 84(1) semi-automatic` (JUST TRUE) FALSE EQUALS JUST FALSE   -- a firearm without it
#ASSERT `s 84(1) semi-automatic` (JUST FALSE) TRUE EQUALS NOTHING   -- "in respect of a firearm": a thing that is not a firearm
#ASSERT `s 84(1) semi-automatic` NOTHING TRUE EQUALS NOTHING   -- whether it is a firearm is not covered

§§ `superior court`

-- `s 84(1) the superior court in the place`
-- inputs, in the order of the GIVEN:
--   1. place (`Province or territory`)
#ASSERT `s 84(1) the superior court in the place` Ontario EQUALS `s 84(1) superior court: the Superior Court of Justice, sitting in the region, district or county or group of counties where the relevant adjudication was made`  -- (a) Ontario: the Superior Court of Justice, sitting in the region, district or county or group of counties where the relevant adjudication was made
#ASSERT `s 84(1) the superior court in the place` Quebec EQUALS `s 84(1) superior court: the Superior Court`  -- (b) Quebec: the Superior Court
#ASSERT `s 84(1) the superior court in the place` `New Brunswick` EQUALS `s 84(1) superior court: the Court of Queen’s Bench`  -- (c) New Brunswick: the Court of Queen’s Bench
#ASSERT `s 84(1) the superior court in the place` Manitoba EQUALS `s 84(1) superior court: the Court of Queen’s Bench`  -- (c) Manitoba
#ASSERT `s 84(1) the superior court in the place` Saskatchewan EQUALS `s 84(1) superior court: the Court of Queen’s Bench`  -- (c) Saskatchewan
#ASSERT `s 84(1) the superior court in the place` Alberta EQUALS `s 84(1) superior court: the Court of Queen’s Bench`  -- (c) Alberta
#ASSERT `s 84(1) the superior court in the place` `Nova Scotia` EQUALS `s 84(1) superior court: the Supreme Court`  -- (d) Nova Scotia: the Supreme Court
#ASSERT `s 84(1) the superior court in the place` `British Columbia` EQUALS `s 84(1) superior court: the Supreme Court`  -- (d) British Columbia
#ASSERT `s 84(1) the superior court in the place` `Prince Edward Island` EQUALS `s 84(1) superior court: the Supreme Court`  -- (d) Prince Edward Island
#ASSERT `s 84(1) the superior court in the place` `Newfoundland and Labrador` EQUALS `s 84(1) superior court: the Supreme Court`  -- (d) Newfoundland and Labrador
#ASSERT `s 84(1) the superior court in the place` Yukon EQUALS `s 84(1) superior court: the Supreme Court`  -- (d) "a territory": Yukon
#ASSERT `s 84(1) the superior court in the place` `Northwest Territories` EQUALS `s 84(1) superior court: the Supreme Court`  -- (d) "a territory": the Northwest Territories
#ASSERT `s 84(1) the superior court in the place` Nunavut EQUALS `s 84(1) superior court: the Supreme Court`  -- (d) "a territory": Nunavut, as this text has it (section 2 names the Nunavut Court of Justice: Finding)

-- `s 84(1) superior court`
-- inputs, in the order of the GIVEN:
--   1. place (`Province or territory`)
--   2. court (`s 84(1) superior court`)
#ASSERT `s 84(1) superior court` Ontario `s 84(1) superior court: the Superior Court of Justice, sitting in the region, district or county or group of counties where the relevant adjudication was made` EQUALS JUST TRUE   -- Ontario and the Superior Court of Justice
#ASSERT `s 84(1) superior court` Ontario `s 84(1) superior court: the Supreme Court` EQUALS JUST FALSE   -- Ontario and the Supreme Court: "means" is closed
#ASSERT `s 84(1) superior court` Quebec `s 84(1) superior court: the Superior Court` EQUALS JUST TRUE   -- Quebec and the Superior Court
#ASSERT `s 84(1) superior court` Alberta `s 84(1) superior court: the Court of Queen’s Bench` EQUALS JUST TRUE   -- Alberta and the Court of Queen’s Bench
#ASSERT `s 84(1) superior court` `Nova Scotia` `s 84(1) superior court: the Court of Queen’s Bench` EQUALS JUST FALSE   -- Nova Scotia and the Court of Queen’s Bench
#ASSERT `s 84(1) superior court` Nunavut `s 84(1) superior court: the Supreme Court` EQUALS JUST TRUE   -- Nunavut and the Supreme Court (this text)

-- paragraph (e) is shown repealed
#ASSERT `s 84(1) superior court paragraph (e) as the text shows it` EQUALS "(e) [Repealed, 2026, c. 11, s. 3]"   -- the text shows "(e) [Repealed, 2026, c. 11, s. 3]"

§§ `transfer`

-- `s 84(1) transfer`
-- inputs, in the order of the GIVEN:
--   1. act (`s 84(1) transfer act`)
#ASSERT `s 84(1) transfer` `s 84(1) transfer: sell` EQUALS JUST TRUE   -- "sell" is a transfer
#ASSERT `s 84(1) transfer` `s 84(1) transfer: provide` EQUALS JUST TRUE   -- "provide" is a transfer
#ASSERT `s 84(1) transfer` `s 84(1) transfer: barter` EQUALS JUST TRUE   -- "barter" is a transfer
#ASSERT `s 84(1) transfer` `s 84(1) transfer: give` EQUALS JUST TRUE   -- "give" is a transfer
#ASSERT `s 84(1) transfer` `s 84(1) transfer: lend` EQUALS JUST TRUE   -- "lend" is a transfer
#ASSERT `s 84(1) transfer` `s 84(1) transfer: rent` EQUALS JUST TRUE   -- "rent" is a transfer
#ASSERT `s 84(1) transfer` `s 84(1) transfer: send` EQUALS JUST TRUE   -- "send" is a transfer
#ASSERT `s 84(1) transfer` `s 84(1) transfer: transport` EQUALS JUST TRUE   -- "transport" is a transfer
#ASSERT `s 84(1) transfer` `s 84(1) transfer: ship` EQUALS JUST TRUE   -- "ship" is a transfer
#ASSERT `s 84(1) transfer` `s 84(1) transfer: distribute` EQUALS JUST TRUE   -- "distribute" is a transfer
#ASSERT `s 84(1) transfer` `s 84(1) transfer: deliver` EQUALS JUST TRUE   -- "deliver" is a transfer
#ASSERT `s 84(1) transfer` `s 84(1) transfer: an act that is none of those` EQUALS JUST FALSE   -- an act that is none of those: "means" is closed

§ `Section 84(1) -- the seam the keel asks for, and the classes`

-- A record whose eighteen answers are all different, so that a function that picks the wrong field is caught.
-- (JT = JUST TRUE, JF = JUST FALSE, N = NOTHING.)
`ccc4 test fixture: answers of the definitions` MEANS `s 84(1) the answers for the thing` WITH
    `the answer of s 84(1) ammunition`               IS JUST TRUE
    `the answer of s 84(1) antique firearm`          IS JUST FALSE
    `the answer of s 84(1) automatic firearm`        IS NOTHING
    `the answer of s 84(1) cartridge magazine`       IS JUST TRUE
    `the answer of s 84(1) cross-bow`                IS JUST FALSE
    `the answer of s 84(1) firearm part`             IS NOTHING
    `the answer of s 84(1) handgun`                  IS JUST TRUE
    `the answer of s 84(1) imitation firearm`        IS JUST FALSE
    `the answer of s 84(1) prohibited ammunition`    IS NOTHING
    `the answer of s 84(1) prohibited device`        IS JUST TRUE
    `the answer of s 84(1) prohibited firearm`       IS JUST FALSE
    `the answer of s 84(1) prohibited weapon`        IS NOTHING
    `the answer of s 84(1) replica firearm`          IS JUST TRUE
    `the answer of s 84(1) restricted firearm`       IS JUST FALSE
    `the answer of s 84(1) restricted weapon`        IS NOTHING
    `the answer of s 84(1) authorization`            IS JUST TRUE
    `the answer of s 84(1) licence`                  IS JUST FALSE
    `the answer of s 84(1) registration certificate` IS NOTHING

#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `ammunition` `ccc4 test fixture: answers of the definitions` EQUALS JUST TRUE   -- picks ammunition
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `antique firearm` `ccc4 test fixture: answers of the definitions` EQUALS JUST FALSE   -- picks antique firearm
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `automatic firearm` `ccc4 test fixture: answers of the definitions` EQUALS NOTHING   -- picks automatic firearm
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `cartridge magazine` `ccc4 test fixture: answers of the definitions` EQUALS JUST TRUE   -- picks cartridge magazine
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `cross-bow` `ccc4 test fixture: answers of the definitions` EQUALS JUST FALSE   -- picks cross-bow
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `firearm part` `ccc4 test fixture: answers of the definitions` EQUALS NOTHING   -- picks firearm part
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `handgun` `ccc4 test fixture: answers of the definitions` EQUALS JUST TRUE   -- picks handgun
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `imitation firearm` `ccc4 test fixture: answers of the definitions` EQUALS JUST FALSE   -- picks imitation firearm
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `prohibited ammunition` `ccc4 test fixture: answers of the definitions` EQUALS NOTHING   -- picks prohibited ammunition
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `prohibited device` `ccc4 test fixture: answers of the definitions` EQUALS JUST TRUE   -- picks prohibited device
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `prohibited firearm` `ccc4 test fixture: answers of the definitions` EQUALS JUST FALSE   -- picks prohibited firearm
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `prohibited weapon` `ccc4 test fixture: answers of the definitions` EQUALS NOTHING   -- picks prohibited weapon
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `replica firearm` `ccc4 test fixture: answers of the definitions` EQUALS JUST TRUE   -- picks replica firearm
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `restricted firearm` `ccc4 test fixture: answers of the definitions` EQUALS JUST FALSE   -- picks restricted firearm
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `restricted weapon` `ccc4 test fixture: answers of the definitions` EQUALS NOTHING   -- picks restricted weapon
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `authorization, when used in relation to those words and expressions` `ccc4 test fixture: answers of the definitions` EQUALS JUST TRUE   -- picks authorization
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `licence, when used in relation to those words and expressions` `ccc4 test fixture: answers of the definitions` EQUALS JUST FALSE   -- picks licence
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `registration certificate, when used in relation to those words and expressions` `ccc4 test fixture: answers of the definitions` EQUALS NOTHING   -- picks registration certificate
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `authorization, licence or registration certificate, when used in relation to some other word or expression` `ccc4 test fixture: answers of the definitions` EQUALS NOTHING   -- a term section 2.1 does not tie to subsection 84(1): silent
#ASSERT `s 84(1) the thing is within the meaning the term has in subsection 84(1)` `a term that section 2.1 does not name` `ccc4 test fixture: answers of the definitions` EQUALS NOTHING   -- a term section 2.1 does not name: silent

-- `s 84(1) the class of firearm it is`
-- inputs, in the order of the GIVEN:
--   1. s 2 firearm: the thing is a firearm (MAYBE BOOLEAN)
--   2. s 84(1) prohibited firearm: the firearm is a prohibited firearm (MAYBE BOOLEAN)
--   3. s 84(1) restricted firearm: the firearm is a restricted firearm (MAYBE BOOLEAN)
#ASSERT `s 84(1) the class of firearm it is` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS `s 84(1) class: a prohibited firearm`  -- a prohibited firearm
#ASSERT `s 84(1) the class of firearm it is` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS `s 84(1) class: a restricted firearm`  -- a restricted firearm
#ASSERT `s 84(1) the class of firearm it is` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS `s 84(1) class: a non-restricted firearm`  -- a firearm that is neither: a non-restricted firearm
#ASSERT `s 84(1) the class of firearm it is` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS `s 84(1) class: not a firearm`  -- not a firearm
#ASSERT `s 84(1) the class of firearm it is` (JUST TRUE) NOTHING (JUST FALSE) EQUALS `s 84(1) class: not covered`  -- whether it is a prohibited firearm is not covered
#ASSERT `s 84(1) the class of firearm it is` (JUST TRUE) (JUST FALSE) NOTHING EQUALS `s 84(1) class: not covered`  -- not prohibited, and whether it is restricted is not covered
#ASSERT `s 84(1) the class of firearm it is` NOTHING (JUST FALSE) (JUST FALSE) EQUALS `s 84(1) class: not covered`  -- whether it is a firearm is not covered

-- `s 84(1) the kind of thing is a firearm`
-- inputs, in the order of the GIVEN:
--   1. the thing (`s 84(1) kind of thing`)
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: a prohibited firearm` EQUALS TRUE   -- a prohibited firearm
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: a restricted firearm` EQUALS TRUE   -- a restricted firearm
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: a non-restricted firearm` EQUALS TRUE   -- a non-restricted firearm
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: a prohibited weapon` EQUALS FALSE   -- a prohibited weapon
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: a restricted weapon` EQUALS FALSE   -- a restricted weapon
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: a replica firearm` EQUALS FALSE   -- a replica firearm
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: a prohibited device other than a replica firearm` EQUALS FALSE   -- a prohibited device other than a replica firearm
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: a firearm part` EQUALS FALSE   -- a firearm part
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: ammunition other than prohibited ammunition` EQUALS FALSE   -- ammunition other than prohibited ammunition
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: prohibited ammunition` EQUALS FALSE   -- prohibited ammunition
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: a cross-bow` EQUALS FALSE   -- a cross-bow
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: an explosive substance` EQUALS FALSE   -- an explosive substance
#ASSERT `s 84(1) the kind of thing is a firearm` `s 84(1) kind: a thing that is none of those` EQUALS FALSE   -- a thing that is none of those

-- `s 84(1) the kind of thing is a prohibited device`
-- inputs, in the order of the GIVEN:
--   1. the thing (`s 84(1) kind of thing`)
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: a prohibited firearm` EQUALS FALSE   -- a prohibited firearm
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: a restricted firearm` EQUALS FALSE   -- a restricted firearm
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: a non-restricted firearm` EQUALS FALSE   -- a non-restricted firearm
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: a prohibited weapon` EQUALS FALSE   -- a prohibited weapon
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: a restricted weapon` EQUALS FALSE   -- a restricted weapon
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: a replica firearm` EQUALS TRUE   -- a replica firearm
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: a prohibited device other than a replica firearm` EQUALS TRUE   -- a prohibited device other than a replica firearm
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: a firearm part` EQUALS FALSE   -- a firearm part
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: ammunition other than prohibited ammunition` EQUALS FALSE   -- ammunition other than prohibited ammunition
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: prohibited ammunition` EQUALS FALSE   -- prohibited ammunition
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: a cross-bow` EQUALS FALSE   -- a cross-bow
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: an explosive substance` EQUALS FALSE   -- an explosive substance
#ASSERT `s 84(1) the kind of thing is a prohibited device` `s 84(1) kind: a thing that is none of those` EQUALS FALSE   -- a thing that is none of those

-- `s 84(1) the kind of thing is ammunition or prohibited ammunition`
-- inputs, in the order of the GIVEN:
--   1. the thing (`s 84(1) kind of thing`)
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: a prohibited firearm` EQUALS FALSE   -- a prohibited firearm
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: a restricted firearm` EQUALS FALSE   -- a restricted firearm
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: a non-restricted firearm` EQUALS FALSE   -- a non-restricted firearm
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: a prohibited weapon` EQUALS FALSE   -- a prohibited weapon
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: a restricted weapon` EQUALS FALSE   -- a restricted weapon
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: a replica firearm` EQUALS FALSE   -- a replica firearm
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: a prohibited device other than a replica firearm` EQUALS FALSE   -- a prohibited device other than a replica firearm
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: a firearm part` EQUALS FALSE   -- a firearm part
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: ammunition other than prohibited ammunition` EQUALS TRUE   -- ammunition other than prohibited ammunition
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: prohibited ammunition` EQUALS TRUE   -- prohibited ammunition
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: a cross-bow` EQUALS FALSE   -- a cross-bow
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: an explosive substance` EQUALS FALSE   -- an explosive substance
#ASSERT `s 84(1) the kind of thing is ammunition or prohibited ammunition` `s 84(1) kind: a thing that is none of those` EQUALS FALSE   -- a thing that is none of those

§ `Section 84(2) -- Barrel length`

-- `s 84(2) the length of the barrel of a firearm in millimetres`
-- inputs, in the order of the GIVEN:
--   1. it is a revolver (BOOLEAN)
--   2. the distance in millimetres from the muzzle of the barrel to the breach end immediately in front of the cylinder (NUMBER)
--   3. the distance in millimetres from the muzzle of the barrel to and including the chamber (NUMBER)
--   4. the length in millimetres of any component, part or accessory within that distance (including one designed or intended to suppress the muzzle flash or reduce recoil) (NUMBER)
#ASSERT `s 84(2) the length of the barrel of a firearm in millimetres` TRUE 120 150 20 EQUALS 100   -- a revolver: the distance from the muzzle to the breach end in front of the cylinder (120) less a 20 mm accessory
#ASSERT `s 84(2) the length of the barrel of a firearm in millimetres` FALSE 120 150 20 EQUALS 130   -- any other firearm: the distance from the muzzle to and including the chamber (150) less a 20 mm accessory
#ASSERT `s 84(2) the length of the barrel of a firearm in millimetres` TRUE 120 150 0 EQUALS 120   -- a revolver with no accessory
#ASSERT `s 84(2) the length of the barrel of a firearm in millimetres` FALSE 120 150 0 EQUALS 150   -- any other firearm with no accessory

§ `Section 84(3) and (3.1) -- Certain weapons deemed not to be firearms`

-- `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision`
-- inputs, in the order of the GIVEN:
--   1. provision (`Provision of the Code`)
--   2. the purpose is a provision of the Firearms Act (BOOLEAN)
--   3. s 84(1) antique firearm: the weapon is an antique firearm (MAYBE BOOLEAN)
--   4. it is a device designed exclusively for signalling, for notifying of distress, for firing blank cartridges or for firing stud cartridges, explosive-driven rivets or other industrial projectiles (BOOLEAN)
--   5. the person in possession of it intends it to be used exclusively for the purpose for which it is designed (BOOLEAN)
--   6. it is a shooting device designed exclusively for the slaughtering of domestic animals, the tranquillizing of animals or the discharging of projectiles with lines attached to them (BOOLEAN)
--   7. it is any other barrelled weapon (BOOLEAN)
--   8. it is proved that the weapon is not designed or adapted to discharge such a projectile (BOOLEAN)
--   9. the muzzle velocity in metres per second at which it is designed or adapted to discharge a shot, bullet or other projectile (NUMBER)
--   10. the muzzle energy in joules at which it is designed or adapted to discharge a shot, bullet or other projectile (NUMBER)
--   11. the velocity in metres per second that a projectile it is designed or adapted to discharge is designed or adapted to attain (NUMBER)
--   12. the energy in joules that a projectile it is designed or adapted to discharge is designed or adapted to attain (NUMBER)
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS JUST TRUE   -- (a) an antique firearm, for section 91
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 85, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS NOTHING   -- (a) an antique firearm; section 85 is not listed
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 90, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS NOTHING   -- (a) an antique firearm; section 90 is not listed
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS JUST TRUE   -- (a) an antique firearm; section 91 (the first of "91 to 95")
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 95, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS JUST TRUE   -- (a) an antique firearm; section 95 (the last of "91 to 95")
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 96, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS NOTHING   -- (a) an antique firearm; section 96 is not listed
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 98, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS NOTHING   -- (a) an antique firearm; section 98 is not listed
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 99, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS JUST TRUE   -- (a) an antique firearm; section 99 (the first of "99 to 101")
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 101, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS JUST TRUE   -- (a) an antique firearm; section 101 (the last of "99 to 101")
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 102, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS NOTHING   -- (a) an antique firearm; section 102 is not listed
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 103, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS JUST TRUE   -- (a) an antique firearm; section 103 (the first of "103 to 107")
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 107, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS JUST TRUE   -- (a) an antique firearm; section 107 (the last of "103 to 107")
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 108, "(1)") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS NOTHING   -- (a) an antique firearm; section 108 is not listed
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 117.03, "") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS JUST TRUE   -- (a) an antique firearm; section 117.03 is listed
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 117.04, "") FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS NOTHING   -- (a) an antique firearm; section 117.04 is not listed
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 85, "(1)") TRUE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS JUST TRUE   -- (a) an antique firearm, for section 85, but the purpose is a provision of the Firearms Act
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE NOTHING FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS NOTHING   -- an antique firearm whose status is not covered, for section 91
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) FALSE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS NOTHING   -- not an antique firearm and nothing else
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) TRUE TRUE FALSE FALSE FALSE 0 0 0 0 EQUALS JUST TRUE   -- (b) a device designed exclusively for signalling ... and intended by the possessor to be used exclusively for that purpose
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) TRUE FALSE FALSE FALSE FALSE 0 0 0 0 EQUALS NOTHING   -- (b) the same device, not so intended: not within the list
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) FALSE TRUE FALSE FALSE FALSE 0 0 0 0 EQUALS NOTHING   -- (b) intended exclusively for the purpose but not such a device
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) FALSE TRUE TRUE FALSE FALSE 0 0 0 0 EQUALS JUST TRUE   -- (c) a shooting device designed exclusively for slaughtering domestic animals ... and intended exclusively for that purpose
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) FALSE FALSE TRUE FALSE FALSE 0 0 0 0 EQUALS NOTHING   -- (c) the same device, not so intended
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) FALSE FALSE FALSE TRUE TRUE 152.4 5.7 152.4 5.7 EQUALS JUST TRUE   -- (d) any other barrelled weapon, proved not designed or adapted to exceed 152.4 m per second or 5.7 joules at the muzzle or in a projectile
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) FALSE FALSE FALSE TRUE TRUE 152.5 5.7 152.4 5.7 EQUALS NOTHING   -- (d) with a muzzle velocity of 152.5 m per second
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) FALSE FALSE FALSE TRUE TRUE 152.4 5.8 152.4 5.7 EQUALS NOTHING   -- (d) with a muzzle energy of 5.8 joules
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) FALSE FALSE FALSE TRUE TRUE 152.4 5.7 152.5 5.7 EQUALS NOTHING   -- (d)(ii) a projectile designed or adapted to attain 152.5 m per second
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) FALSE FALSE FALSE TRUE TRUE 152.4 5.7 152.4 5.8 EQUALS NOTHING   -- (d)(ii) a projectile designed or adapted to attain 5.8 joules
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) FALSE FALSE FALSE TRUE FALSE 152.4 5.7 152.4 5.7 EQUALS NOTHING   -- (d) "where it is proved": it is not proved
#ASSERT `s 84(3) the weapon is deemed not to be a firearm for the purposes of the provision` (`Provision of the Code` OF 91, "(1)") FALSE (JUST FALSE) FALSE FALSE FALSE FALSE TRUE 0 0 0 0 EQUALS NOTHING   -- (d) not a barrelled weapon

-- `s 84(3.1) the antique firearm is a firearm for the purpose`
-- inputs, in the order of the GIVEN:
--   1. s 84(1) antique firearm: the thing is an antique firearm (MAYBE BOOLEAN)
--   2. the purpose is regulations made under paragraph 117(h) of the Firearms Act (BOOLEAN)
--   3. provision (`Provision of the Code`)
#ASSERT `s 84(3.1) the antique firearm is a firearm for the purpose` (JUST TRUE) TRUE (`Provision of the Code` OF 91, "(1)") EQUALS JUST TRUE   -- "for the purposes of regulations made under paragraph 117(h) of the Firearms Act"
#ASSERT `s 84(3.1) the antique firearm is a firearm for the purpose` (JUST TRUE) FALSE (`Provision of the Code` OF 86, "(2)") EQUALS JUST TRUE   -- "and subsection 86(2) of this Act"
#ASSERT `s 84(3.1) the antique firearm is a firearm for the purpose` (JUST TRUE) FALSE (`Provision of the Code` OF 86, "(1)") EQUALS NOTHING   -- subsection 86(1) is not named
#ASSERT `s 84(3.1) the antique firearm is a firearm for the purpose` (JUST TRUE) FALSE (`Provision of the Code` OF 91, "(1)") EQUALS NOTHING   -- section 91 is not named
#ASSERT `s 84(3.1) the antique firearm is a firearm for the purpose` (JUST FALSE) TRUE (`Provision of the Code` OF 91, "(1)") EQUALS NOTHING   -- not an antique firearm, for the named purpose
#ASSERT `s 84(3.1) the antique firearm is a firearm for the purpose` NOTHING TRUE (`Provision of the Code` OF 91, "(1)") EQUALS NOTHING   -- whether it is an antique firearm is not covered

§ `Section 84(4) -- Meaning of holder`

-- `s 84(4)(a) the person is the holder of an authorization or a licence`
-- inputs, in the order of the GIVEN:
--   1. the authorization or licence has been issued to the person (BOOLEAN)
--   2. the person continues to hold it (BOOLEAN)
#ASSERT `s 84(4)(a) the person is the holder of an authorization or a licence` TRUE TRUE EQUALS JUST TRUE   -- issued to the person and the person continues to hold it
#ASSERT `s 84(4)(a) the person is the holder of an authorization or a licence` TRUE FALSE EQUALS JUST FALSE   -- issued to the person but no longer held
#ASSERT `s 84(4)(a) the person is the holder of an authorization or a licence` FALSE TRUE EQUALS JUST FALSE   -- held but not issued to the person
#ASSERT `s 84(4)(a) the person is the holder of an authorization or a licence` FALSE FALSE EQUALS JUST FALSE   -- neither

-- `s 84(4)(b) the person is the holder of a registration certificate for a firearm`
-- inputs, in the order of the GIVEN:
--   1. the registration certificate has been issued to the person (BOOLEAN)
--   2. the person continues to hold the registration certificate (BOOLEAN)
--   3. the person possesses the registration certificate with the permission of its lawful holder (BOOLEAN)
#ASSERT `s 84(4)(b) the person is the holder of a registration certificate for a firearm` TRUE TRUE FALSE EQUALS JUST TRUE   -- (i) issued to the person and the person continues to hold it
#ASSERT `s 84(4)(b) the person is the holder of a registration certificate for a firearm` FALSE FALSE TRUE EQUALS JUST TRUE   -- (ii) the person possesses it with the permission of its lawful holder
#ASSERT `s 84(4)(b) the person is the holder of a registration certificate for a firearm` TRUE FALSE FALSE EQUALS JUST FALSE   -- issued to the person but no longer held, and no permission
#ASSERT `s 84(4)(b) the person is the holder of a registration certificate for a firearm` FALSE FALSE FALSE EQUALS JUST FALSE   -- none of those

§ `Section 84(5) and (6) -- Subsequent offences`

-- `s 84(5) the earlier offence is to be considered as an earlier offence`
-- inputs, in the order of the GIVEN:
--   1. the subsection for which the question is asked (`Provision of the Code`)
--   2. the offence of which the person was earlier convicted (`Provision of the Code`)
--   3. a firearm was used in the commission of the earlier offence (BOOLEAN)
--   4. the day on which the person was convicted of the earlier offence (DATE)
--   5. the day on which the person was convicted of the offence for which sentence is being imposed (DATE)
--   6. the number of days the person spent in custody between those two days (NUMBER)
#ASSERT `s 84(5) the earlier offence is to be considered as an earlier offence` (`Provision of the Code` OF 99, "(2)") (`Provision of the Code` OF 85, "(1)") FALSE (Date 1 1 2010) (Date 1 1 2015) 0 EQUALS JUST TRUE   -- subsection 99(2), earlier offence under section 85
