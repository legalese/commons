IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc2-explosives`

-- ccc2-tests-explosives.l4 -- tests for ccc2-explosives.l4 (ss 79 to 82.1). Expected values are written beside each assertion from the text of the provision,
-- before the run. The s 787(1) penalty is a seam input: the tests pass a placeholder that states nothing.

§ `Tests -- section 79, duty of care (lines 1190-1191)`

--                                                                                                           possession  s 2 explosive substance
#ASSERT `s 79 the person is under a legal duty to use reasonable care to prevent harm by the explosive substance` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 79 the person is under a legal duty to use reasonable care to prevent harm by the explosive substance` FALSE (JUST TRUE) EQUALS NOTHING   -- neither possession nor care or control
#ASSERT `s 79 the person is under a legal duty to use reasonable care to prevent harm by the explosive substance` TRUE NOTHING EQUALS NOTHING   -- s 2 "explosive substance includes": the thing is left open
#ASSERT `s 79 the person is under a legal duty to use reasonable care to prevent harm by the explosive substance` TRUE (JUST FALSE) EQUALS NOTHING
-- the duty as a regulative rule: using reasonable care -> FULFILLED; with no event the duty stands (the text states no time).
#TRACE `s 79 the duty of care` AT 0 WITH
    PARTY `the accused` DOES `s 79 uses reasonable care to prevent bodily harm or death to persons or damage to property by the explosive substance` AT 1
#TRACE `s 79 the duty of care` AT 0 WITH
    WAITUNTIL 100

§ `Tests -- section 80, breach of duty (lines 1192-1195)`

--                                                                                       duty answer   fails  lawful excuse
#ASSERT `s 80 the person commits the offence of breach of duty` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 80 the person commits the offence of breach of duty` (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- performs the duty
#ASSERT `s 80 the person commits the offence of breach of duty` (JUST TRUE) TRUE TRUE EQUALS NOTHING   -- with lawful excuse
#ASSERT `s 80 the person commits the offence of breach of duty` NOTHING TRUE FALSE EQUALS NOTHING   -- not shown to be under the section 79 duty
#ASSERT `s 80 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 80 the punishment` `s 80(a) an explosion occurs as a result that causes death or is likely to cause death to any person` EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 80 the punishment` `s 80(b) an explosion occurs as a result that causes bodily harm or damage to property or is likely to cause bodily harm or damage to property` EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for a term of` `fourteen years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 80 the punishment` `s 80 no explosion occurs as a result` EQUALS NOTHING   -- the section states a penalty only if an explosion occurs

§ `Tests -- section 81, using explosives (lines 1196-1210)`

--                                                                       act                                                                                                                                                                                      intent explosion likely  explosive answer  other dangerous  without lawful excuse
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(a) does anything with intent to cause an explosion of an explosive substance that is likely to cause serious bodily harm or death to persons or is likely to cause serious damage to property` TRUE TRUE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(a) does anything with intent to cause an explosion of an explosive substance that is likely to cause serious bodily harm or death to persons or is likely to cause serious damage to property` FALSE TRUE (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- no intent
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(a) does anything with intent to cause an explosion of an explosive substance that is likely to cause serious bodily harm or death to persons or is likely to cause serious damage to property` TRUE FALSE (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- the explosion is not likely to cause serious harm
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(a) does anything with intent to cause an explosion of an explosive substance that is likely to cause serious bodily harm or death to persons or is likely to cause serious damage to property` TRUE TRUE NOTHING FALSE FALSE EQUALS NOTHING   -- s 2 leaves the thing open
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(b)(i) with intent to do bodily harm to any person, causes an explosive substance to explode` TRUE FALSE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(b)(i) with intent to do bodily harm to any person, causes an explosive substance to explode` TRUE FALSE (JUST FALSE) TRUE FALSE EQUALS NOTHING   -- (i) names an explosive substance only
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(b)(ii) with intent to do bodily harm to any person, sends or delivers to a person or causes a person to take or receive an explosive substance or any other dangerous substance or thing` TRUE FALSE (JUST FALSE) TRUE FALSE EQUALS JUST TRUE   -- any other dangerous substance or thing
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(b)(ii) with intent to do bodily harm to any person, sends or delivers to a person or causes a person to take or receive an explosive substance or any other dangerous substance or thing` TRUE FALSE (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(b)(ii) with intent to do bodily harm to any person, sends or delivers to a person or causes a person to take or receive an explosive substance or any other dangerous substance or thing` FALSE FALSE (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- no intent to do bodily harm
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(b)(iii) with intent to do bodily harm to any person, places or throws anywhere or at or on a person a corrosive fluid, explosive substance or any other dangerous substance or thing` TRUE FALSE (JUST FALSE) TRUE FALSE EQUALS JUST TRUE   -- a corrosive fluid
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(b)(iii) with intent to do bodily harm to any person, places or throws anywhere or at or on a person a corrosive fluid, explosive substance or any other dangerous substance or thing` TRUE FALSE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(c) with intent to destroy or damage property without lawful excuse, places or throws an explosive substance anywhere` TRUE FALSE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(c) with intent to destroy or damage property without lawful excuse, places or throws an explosive substance anywhere` TRUE FALSE (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- with lawful excuse
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(d)(i) makes or has in his possession or has under his care or control any explosive substance with intent thereby to endanger life or to cause serious damage to property` TRUE FALSE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(d)(i) makes or has in his possession or has under his care or control any explosive substance with intent thereby to endanger life or to cause serious damage to property` FALSE FALSE (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(d)(ii) makes or has in his possession or has under his care or control any explosive substance with intent thereby to enable another person to endanger life or to cause serious damage to property` TRUE FALSE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1)(d)(ii) makes or has in his possession or has under his care or control any explosive substance with intent thereby to enable another person to endanger life or to cause serious damage to property` TRUE FALSE NOTHING FALSE FALSE EQUALS NOTHING
#ASSERT `s 81(1) the person commits an offence by using explosives` `s 81(1) an act that is none of those in paragraphs (a) to (d)` TRUE TRUE (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 81(2) the class of the offence` EQUALS `an indictable offence`
-- (2)(a): life for (1)(a) or (b); (2)(b): fourteen years for (1)(c) or (d).
#ASSERT `s 81(2) the punishment` `s 81(1)(a) does anything with intent to cause an explosion of an explosive substance that is likely to cause serious bodily harm or death to persons or is likely to cause serious damage to property` EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 81(2) the punishment` `s 81(1)(b)(i) with intent to do bodily harm to any person, causes an explosive substance to explode` EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 81(2) the punishment` `s 81(1)(b)(ii) with intent to do bodily harm to any person, sends or delivers to a person or causes a person to take or receive an explosive substance or any other dangerous substance or thing` EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 81(2) the punishment` `s 81(1)(b)(iii) with intent to do bodily harm to any person, places or throws anywhere or at or on a person a corrosive fluid, explosive substance or any other dangerous substance or thing` EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 81(2) the punishment` `s 81(1)(c) with intent to destroy or damage property without lawful excuse, places or throws an explosive substance anywhere` EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for a term of` `fourteen years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 81(2) the punishment` `s 81(1)(d)(i) makes or has in his possession or has under his care or control any explosive substance with intent thereby to endanger life or to cause serious damage to property` EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for a term of` `fourteen years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 81(2) the punishment` `s 81(1)(d)(ii) makes or has in his possession or has under his care or control any explosive substance with intent thereby to enable another person to endanger life or to cause serious damage to property` EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for a term of` `fourteen years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 81(2) the punishment` `s 81(1) an act that is none of those in paragraphs (a) to (d)` EQUALS NOTHING

§ `Tests -- sections 82 and 82.1 (lines 1211-1218)`

--                                                              acts  s 2 explosive substance  lawful excuse
#ASSERT `s 82(1) the person possesses an explosive substance without lawful excuse` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 82(1) the person possesses an explosive substance without lawful excuse` TRUE (JUST TRUE) TRUE EQUALS NOTHING   -- with lawful excuse
#ASSERT `s 82(1) the person possesses an explosive substance without lawful excuse` FALSE (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 82(1) the person possesses an explosive substance without lawful excuse` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 82(1) the person possesses an explosive substance without lawful excuse` TRUE (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 82(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 82(1) the punishment` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` `five years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
--                                                                          acts  explosive       lawful excuse  for the benefit of a group  criminal organization answer
#ASSERT `s 82(2) the person possesses an explosive substance for or with a criminal organization` TRUE (JUST TRUE) FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 82(2) the person possesses an explosive substance for or with a criminal organization` TRUE (JUST TRUE) FALSE FALSE (JUST TRUE) EQUALS NOTHING   -- not for the benefit of, at the direction of or in association with a group
#ASSERT `s 82(2) the person possesses an explosive substance for or with a criminal organization` TRUE (JUST TRUE) FALSE TRUE (JUST FALSE) EQUALS NOTHING   -- the group is not a criminal organization
#ASSERT `s 82(2) the person possesses an explosive substance for or with a criminal organization` TRUE (JUST TRUE) FALSE TRUE NOTHING EQUALS NOTHING   -- s 2 "criminal organization" leaves it open
#ASSERT `s 82(2) the person possesses an explosive substance for or with a criminal organization` TRUE (JUST TRUE) TRUE TRUE (JUST TRUE) EQUALS NOTHING   -- with lawful excuse
#ASSERT `s 82(2) the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 82(2) the punishment` EQUALS LIST Punishment OF `by indictment`, `imprisonment for a term of` `fourteen years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
--                                                                                        sentence for 82(2)  same event  already subject to a sentence
#ASSERT `s 82.1 the sentence must be served consecutively to the other punishment or sentence` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 82.1 the sentence must be served consecutively to the other punishment or sentence` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 82.1 the sentence must be served consecutively to the other punishment or sentence` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 82.1 the sentence must be served consecutively to the other punishment or sentence` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 82.1 the sentence must be served consecutively to the other punishment or sentence` FALSE TRUE TRUE EQUALS NOTHING   -- a sentence for another offence
