IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc32-nif-c19`

-- ccc32-tests-nif-c19.l4 -- tests for ccc32-nif-c19.l4 (amendments not in force from 2026 c. 19: ss 2(2), 4, 24(5), 28, 42, 45(2)).
-- Every expected value is decided by reading the provision, and written beside the assertion. A failing assertion is a finding.

`ccc32 test section 264.01` MEANS `Provision of the Code` OF 264.01, "(1)"
`ccc32 test section 264` MEANS `Provision of the Code` OF 264, "(1)"
`ccc32 test section 264.1` MEANS `Provision of the Code` OF 264.1, "(1)"
`ccc32 test section 85(1)` MEANS `Provision of the Code` OF 85, "(1)"
`ccc32 test section 85(2)` MEANS `Provision of the Code` OF 85, "(2)"
`ccc32 test section 85(3)` MEANS `Provision of the Code` OF 85, "(3)"
`ccc32 test section 95(1)` MEANS `Provision of the Code` OF 95, "(1)"
`ccc32 test section 95(2)` MEANS `Provision of the Code` OF 95, "(2)"
`ccc32 test section 99(1)` MEANS `Provision of the Code` OF 99, "(1)"
`ccc32 test section 100(1)` MEANS `Provision of the Code` OF 100, "(1)"
`ccc32 test section 102(1)` MEANS `Provision of the Code` OF 102, "(1)"
`ccc32 test section 102.1(1)` MEANS `Provision of the Code` OF 102.1, "(1)"
`ccc32 test section 102.1(2)` MEANS `Provision of the Code` OF 102.1, "(2)"
`ccc32 test section 103(1)` MEANS `Provision of the Code` OF 103, "(1)"
`ccc32 test section 104(1)` MEANS `Provision of the Code` OF 104, "(1)"
`ccc32 test section 104.1(1)` MEANS `Provision of the Code` OF 104.1, "(1)"

§ `2026 c. 19 s. 2(2), s. 24(5), s. 42 and s. 45(2) -- the inserted item`

#ASSERT `s 3.01(1)(b.1) (not in force) the offence counts as one in which violence is used, threatened or attempted` `ccc32 test section 264.01` EQUALS JUST TRUE
#ASSERT `s 3.01(1)(b.1) (not in force) the offence counts as one in which violence is used, threatened or attempted` `ccc32 test section 264` EQUALS NOTHING
#ASSERT `s 183 "offence" (a)(xxxix.4) (not in force) the offence is within paragraph (a) of the definition` `ccc32 test section 264.01` EQUALS JUST TRUE
#ASSERT `s 183 "offence" (a)(xxxix.4) (not in force) the offence is within paragraph (a) of the definition` `ccc32 test section 264` EQUALS NOTHING
#ASSERT `s 487.04 "secondary designated offence" (c)(v.1) (not in force) the offence is within paragraph (c) of the definition` `ccc32 test section 264.01` EQUALS JUST TRUE
#ASSERT `s 487.04 "secondary designated offence" (c)(v.1) (not in force) the offence is within paragraph (c) of the definition` `ccc32 test section 264.1` EQUALS NOTHING
#ASSERT `s 490.011(1) "secondary offence" (a)(ix.1) (not in force) the offence is within paragraph (a) of the definition` `ccc32 test section 264.01` EQUALS JUST TRUE
#ASSERT `s 490.011(1) "secondary offence" (a)(ix.1) (not in force) the offence is within paragraph (a) of the definition` `ccc32 test section 85(1)` EQUALS NOTHING

§ `2026 c. 19 s. 4 -- paragraph 109(1)(b) as replaced`

#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 85(1)` EQUALS JUST TRUE
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 85(2)` EQUALS JUST TRUE
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 95(1)` EQUALS JUST TRUE
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 99(1)` EQUALS JUST TRUE
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 100(1)` EQUALS JUST TRUE
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 102(1)` EQUALS JUST TRUE
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 102.1(1)` EQUALS JUST TRUE
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 102.1(2)` EQUALS JUST TRUE
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 103(1)` EQUALS JUST TRUE
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 104.1(1)` EQUALS JUST TRUE
-- "or section 264 (criminal harassment) or 264.01": the whole section, so any subsection.
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 264` EQUALS JUST TRUE
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 264.01` EQUALS JUST TRUE
-- near misses: a subsection the paragraph does not name, and neighbouring sections: not covered (never FALSE).
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 85(3)` EQUALS NOTHING
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 95(2)` EQUALS NOTHING
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 104(1)` EQUALS NOTHING
#ASSERT `s 109(1)(b) (not in force) the offence is one listed in paragraph (b)` `ccc32 test section 264.1` EQUALS NOTHING

§ `2026 c. 19 s. 28 -- section 264.01 (1)`

-- (1): a pattern, one of the three states of mind, and an intimate partner (section 2): the offence.
#ASSERT `s 264.01(1) (not in force) the accused commits an offence` (JUST TRUE) TRUE FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 264.01(1) (not in force) the accused commits an offence` (JUST TRUE) FALSE TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 264.01(1) (not in force) the accused commits an offence` (JUST TRUE) FALSE FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
-- no state of mind; no pattern; a pattern not covered; an intimate partner not established: the text neither says yes nor no (a marginal reading).
#ASSERT `s 264.01(1) (not in force) the accused commits an offence` (JUST TRUE) FALSE FALSE FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 264.01(1) (not in force) the accused commits an offence` (JUST FALSE) TRUE TRUE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 264.01(1) (not in force) the accused commits an offence` NOTHING TRUE TRUE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 264.01(1) (not in force) the accused commits an offence` (JUST TRUE) TRUE TRUE TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 264.01(1) (not in force) the accused commits an offence` (JUST TRUE) TRUE TRUE TRUE NOTHING EQUALS NOTHING

§ `2026 c. 19 s. 28 -- section 264.01 (2) and (3): the pattern`

-- "any combination, or repeated instances": two acts in all make a pattern, one does not.
#ASSERT `s 264.01(2) (not in force) the acts make up a pattern of coercive or controlling conduct` (`s 264.01(2) (not in force) acts` OF 1, 0, 0) EQUALS JUST FALSE
#ASSERT `s 264.01(2) (not in force) the acts make up a pattern of coercive or controlling conduct` (`s 264.01(2) (not in force) acts` OF 0, 0, 1) EQUALS JUST FALSE
#ASSERT `s 264.01(2) (not in force) the acts make up a pattern of coercive or controlling conduct` (`s 264.01(2) (not in force) acts` OF 0, 0, 0) EQUALS JUST FALSE
#ASSERT `s 264.01(2) (not in force) the acts make up a pattern of coercive or controlling conduct` (`s 264.01(2) (not in force) acts` OF 2, 0, 0) EQUALS JUST TRUE
#ASSERT `s 264.01(2) (not in force) the acts make up a pattern of coercive or controlling conduct` (`s 264.01(2) (not in force) acts` OF 1, 1, 0) EQUALS JUST TRUE
#ASSERT `s 264.01(2) (not in force) the acts make up a pattern of coercive or controlling conduct` (`s 264.01(2) (not in force) acts` OF 0, 1, 1) EQUALS JUST TRUE
#ASSERT `s 264.01(2) (not in force) the acts make up a pattern of coercive or controlling conduct` (`s 264.01(2) (not in force) acts` OF 0, 0, 2) EQUALS JUST TRUE
-- (2)(a): violence against (i) to (iv); another target is not named.
#ASSERT `s 264.01(2)(a) (not in force) the act is within paragraph (a)` TRUE `s 264.01(2)(a)(i) (not in force) the intimate partner` EQUALS JUST TRUE
#ASSERT `s 264.01(2)(a) (not in force) the act is within paragraph (a)` TRUE `s 264.01(2)(a)(ii) (not in force) any person under the age of 18 who is the intimate partner’s child or who is in the intimate partner’s lawful care or charge` EQUALS JUST TRUE
#ASSERT `s 264.01(2)(a) (not in force) the act is within paragraph (a)` TRUE `s 264.01(2)(a)(iii) (not in force) any other person known to the intimate partner` EQUALS JUST TRUE
#ASSERT `s 264.01(2)(a) (not in force) the act is within paragraph (a)` TRUE `s 264.01(2)(a)(iv) (not in force) any animal that is known to the intimate partner` EQUALS JUST TRUE
#ASSERT `s 264.01(2)(a) (not in force) the act is within paragraph (a)` TRUE `s 264.01(2)(a) (not in force) another target` EQUALS NOTHING
#ASSERT `s 264.01(2)(a) (not in force) the act is within paragraph (a)` FALSE `s 264.01(2)(a)(i) (not in force) the intimate partner` EQUALS NOTHING
-- (2)(b)
#ASSERT `s 264.01(2)(b) (not in force) the act is within paragraph (b)` TRUE EQUALS JUST TRUE
#ASSERT `s 264.01(2)(b) (not in force) the act is within paragraph (b)` FALSE EQUALS NOTHING
-- (2)(c): "if, in all the circumstances ..." -- met: within; not met: the text's no.
#ASSERT `s 264.01(2)(c) (not in force) the conduct is within paragraph (c)` TRUE EQUALS JUST TRUE
#ASSERT `s 264.01(2)(c) (not in force) the conduct is within paragraph (c)` FALSE EQUALS JUST FALSE
-- (2)(c)(i) to (viii) are listed; other conduct is not named, but "including" keeps the list open.
#ASSERT `s 264.01(2)(c) (not in force) the conduct is listed in one of the subparagraphs` `s 264.01(2)(c)(i) (not in force) controlling, attempting to control or monitoring the intimate partner’s location, movements, actions or social interactions, including by a means of telecommunication` EQUALS JUST TRUE
#ASSERT `s 264.01(2)(c) (not in force) the conduct is listed in one of the subparagraphs` `s 264.01(2)(c)(ii) (not in force) controlling or attempting to control the manner in which the intimate partner cares for any person under the age of 18 referred to in subparagraph (a)(ii) or any animal referred to in subparagraph (a)(iv)` EQUALS JUST TRUE
#ASSERT `s 264.01(2)(c) (not in force) the conduct is listed in one of the subparagraphs` `s 264.01(2)(c)(iii) (not in force) controlling or attempting to control any matter related to the intimate partner’s employment or education` EQUALS JUST TRUE
#ASSERT `s 264.01(2)(c) (not in force) the conduct is listed in one of the subparagraphs` `s 264.01(2)(c)(iv) (not in force) controlling or attempting to control the intimate partner’s finances or other property or monitoring their finances` EQUALS JUST TRUE
#ASSERT `s 264.01(2)(c) (not in force) the conduct is listed in one of the subparagraphs` `s 264.01(2)(c)(v) (not in force) controlling or attempting to control the intimate partner’s expression of gender, physical appearance, manner of dress, diet, taking of medication or access to health services or to medication` EQUALS JUST TRUE
#ASSERT `s 264.01(2)(c) (not in force) the conduct is listed in one of the subparagraphs` `s 264.01(2)(c)(vi) (not in force) controlling or attempting to control the intimate partner’s expression of their thoughts, their opinions, their religious, spiritual or other beliefs, or their culture, including the intimate partner’s use of their language or their access to their linguistic, religious, spiritual or cultural community` EQUALS JUST TRUE
#ASSERT `s 264.01(2)(c) (not in force) the conduct is listed in one of the subparagraphs` `s 264.01(2)(c)(vii) (not in force) threatening to die by suicide or to self-harm` EQUALS JUST TRUE
#ASSERT `s 264.01(2)(c) (not in force) the conduct is listed in one of the subparagraphs` `s 264.01(2)(c)(viii) (not in force) damaging, or threatening or attempting to damage, the intimate partner’s property or the property of anyone known to them` EQUALS JUST TRUE
#ASSERT `s 264.01(2)(c) (not in force) the conduct is listed in one of the subparagraphs` `s 264.01(2)(c) (not in force) other conduct not listed in subparagraphs (i) to (viii)` EQUALS NOTHING
-- (3): "include" -- three named circumstances; any other is not covered.
#ASSERT `s 264.01(3) (not in force) the circumstances referred to in paragraph (2)(c) include the circumstance` `s 264.01(3) (not in force) the nature of the relationship between the accused and the intimate partner` EQUALS JUST TRUE
#ASSERT `s 264.01(3) (not in force) the circumstances referred to in paragraph (2)(c) include the circumstance` `s 264.01(3) (not in force) whether the intimate partner is in a position of vulnerability in relation to the accused` EQUALS JUST TRUE
#ASSERT `s 264.01(3) (not in force) the circumstances referred to in paragraph (2)(c) include the circumstance` `s 264.01(3) (not in force) whether the accused manipulated the intimate partner by targeting their vulnerabilities` EQUALS JUST TRUE
#ASSERT `s 264.01(3) (not in force) the circumstances referred to in paragraph (2)(c) include the circumstance` `s 264.01(3) (not in force) another circumstance` EQUALS NOTHING

§ `2026 c. 19 s. 28 -- section 264.01 (4) and (5): punishment and safety`

-- A made-up general summary penalty (the real one is section 787(1), part ccc29): six months' imprisonment and a fine of 5000 dollars.
`ccc32 test s 787(1) general penalty` MEANS
    Punishment WITH
        `mode` IS `on summary conviction`
        `maximum imprisonment` IS `imprisonment for a term of` `six months`
        `minimum imprisonment` IS `no imprisonment is stated`
        `maximum fine` IS `a fine of` 5000
        `minimum fine` IS `no fine is stated`

#ASSERT `s 264.01(4) (not in force) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
-- (a) indictable: "liable to imprisonment for a term of not more than 10 years": a maximum of ten years, no minimum stated, no fine stated.
#ASSERT (`s 264.01(4) (not in force) the punishment for the offence` `by indictment` `ccc32 test s 787(1) general penalty`)'s `maximum imprisonment` EQUALS `imprisonment for a term of` `ten years`
#ASSERT (`s 264.01(4) (not in force) the punishment for the offence` `by indictment` `ccc32 test s 787(1) general penalty`)'s `minimum imprisonment` EQUALS `no imprisonment is stated`
#ASSERT (`s 264.01(4) (not in force) the punishment for the offence` `by indictment` `ccc32 test s 787(1) general penalty`)'s `maximum fine` EQUALS `no fine is stated`
#ASSERT (`s 264.01(4) (not in force) the punishment for the offence` `by indictment` `ccc32 test s 787(1) general penalty`)'s `mode` EQUALS `by indictment`
-- (b) summary: the section states no penalty, so the answer is the one the general penalty gives (the input), unchanged.
#ASSERT `s 264.01(4) (not in force) the punishment for the offence` `on summary conviction` `ccc32 test s 787(1) general penalty` EQUALS `ccc32 test s 787(1) general penalty`
-- (5): "includes".
#ASSERT `s 264.01(5) (not in force) a person’s safety includes the kind of safety` `s 264.01(5) (not in force) psychological safety` EQUALS JUST TRUE
#ASSERT `s 264.01(5) (not in force) a person’s safety includes the kind of safety` `s 264.01(5) (not in force) another kind of safety` EQUALS NOTHING
