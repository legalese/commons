IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc10-records`

-- ccc10-tests-records.l4 -- tests for ccc10-records.l4 (ss 278.32 to 278.98). Expected values are written by hand from the text, beside each assertion.
-- A trace of a regulative rule is run with #TRACE and its outcome is stated in a comment: a DEONTIC value cannot be compared in #ASSERT on the
-- stable binary ("Trying to check equality on types that do not support it" is an Error), so each duty has a decision-function twin that is asserted.

§ `s 278.32 -- Publication prohibited`

-- Argument order of s 278.32(1): matter; the answer of s 278.3 (an application has been made); an order that it may be published has been made; the determination is that evidence is admissible.
#ASSERT `s 278.32(1) publication of the matter is prohibited` `s 278.32(1)(a) the contents of an application` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE   -- (a): "the contents of an application made under subsection 278.3(1)" is barred
#ASSERT `s 278.32(1) publication of the matter is prohibited` `s 278.32(1)(a) the contents of an application` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE   -- (a) has no carve-out: an order or an admissible determination does not lift it
#ASSERT `s 278.32(1) publication of the matter is prohibited` `s 278.32(1)(b) evidence taken, information given or representations made at the consideration of an application or at a hearing` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE   -- (b): no carve-out
#ASSERT `s 278.32(1) publication of the matter is prohibited` `s 278.32(1)(c) the decision of a judge, provincial court judge or justice under subsection 278.3(5)` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE   -- (c): barred "unless ... orders"; no order
#ASSERT `s 278.32(1) publication of the matter is prohibited` `s 278.32(1)(c) the decision of a judge, provincial court judge or justice under subsection 278.3(5)` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE   -- (c): an order that it may be published lifts the bar
#ASSERT `s 278.32(1) publication of the matter is prohibited` `s 278.32(1)(c) the decision of a judge, provincial court judge or justice under subsection 278.3(5)` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- (c): "admissible" is a carve-out of (d) only
#ASSERT `s 278.32(1) publication of the matter is prohibited` `s 278.32(1)(d) the determination made and the reasons provided under subsection 278.31(4)` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE   -- (d): inadmissible, no order: barred
#ASSERT `s 278.32(1) publication of the matter is prohibited` `s 278.32(1)(d) the determination made and the reasons provided under subsection 278.31(4)` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE   -- (d): "unless that determination is that evidence is admissible"
#ASSERT `s 278.32(1) publication of the matter is prohibited` `s 278.32(1)(d) the determination made and the reasons provided under subsection 278.31(4)` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE   -- (d): "or the judge ... orders that the determination and the reasons may be published"
#ASSERT `s 278.32(1) publication of the matter is prohibited` `s 278.32(1) a matter that is none of (a) to (d)` (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- a matter outside the four paragraphs: not covered
#ASSERT `s 278.32(1) publication of the matter is prohibited` `s 278.32(1)(a) the contents of an application` (JUST FALSE) FALSE FALSE EQUALS NOTHING   -- no application under 278.3(1): outside "an application made under subsection 278.3(1)"
#ASSERT `s 278.32(1) publication of the matter is prohibited` `s 278.32(1)(a) the contents of an application` NOTHING FALSE FALSE EQUALS NOTHING   -- section 278.3's own answer is not covered: not covered here

-- s 278.32(1.1): who made the disclosure.
#ASSERT `s 278.32(1.1) the disclosure is made by the complainant or any witness` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the complainant
#ASSERT `s 278.32(1.1) the disclosure is made by the complainant or any witness` (JUST FALSE) TRUE EQUALS JUST TRUE   -- a witness
#ASSERT `s 278.32(1.1) the disclosure is made by the complainant or any witness` (JUST FALSE) FALSE EQUALS JUST FALSE   -- neither
#ASSERT `s 278.32(1.1) the disclosure is made by the complainant or any witness` NOTHING FALSE EQUALS NOTHING   -- s 2 "complainant" not determined, not a witness
#ASSERT `s 278.32(1.1) the disclosure is made by the complainant or any witness` NOTHING TRUE EQUALS JUST TRUE   -- a witness whatever s 2 says
-- Argument order of s 278.32(1.1): referred to in (1)(a) to (d); administration of justice; purpose not making it known in the community; who made it; about that person and their particulars; did not reveal another protected person; purpose not making it known to the public.
#ASSERT `s 278.32(1.1) subsection (1) does not apply to the disclosure` FALSE TRUE TRUE (JUST TRUE) TRUE TRUE TRUE EQUALS NOTHING   -- information not referred to in (1)(a) to (d): outside the exception's scope
#ASSERT `s 278.32(1.1) subsection (1) does not apply to the disclosure` TRUE TRUE TRUE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST TRUE   -- (a): administration of justice, purpose not community knowledge
#ASSERT `s 278.32(1.1) subsection (1) does not apply to the disclosure` TRUE TRUE FALSE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE   -- (a): the purpose was making it known in the community; nothing else holds
#ASSERT `s 278.32(1.1) subsection (1) does not apply to the disclosure` TRUE FALSE TRUE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE   -- (a): not made in the course of the administration of justice
#ASSERT `s 278.32(1.1) subsection (1) does not apply to the disclosure` TRUE FALSE FALSE (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE   -- (b): by the complainant, about themselves, no reckless reveal of another
#ASSERT `s 278.32(1.1) subsection (1) does not apply to the disclosure` TRUE FALSE FALSE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE   -- (b): they did reveal another protected person's identity
#ASSERT `s 278.32(1.1) subsection (1) does not apply to the disclosure` TRUE FALSE FALSE (JUST FALSE) TRUE TRUE FALSE EQUALS JUST FALSE   -- (b): not made by the complainant or a witness
#ASSERT `s 278.32(1.1) subsection (1) does not apply to the disclosure` TRUE FALSE FALSE (JUST TRUE) FALSE FALSE TRUE EQUALS JUST TRUE   -- (c): by the complainant, purpose not making it known to the public
#ASSERT `s 278.32(1.1) subsection (1) does not apply to the disclosure` TRUE FALSE FALSE (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE   -- (c): the purpose was making it known to the public
#ASSERT `s 278.32(1.1) subsection (1) does not apply to the disclosure` TRUE FALSE FALSE NOTHING TRUE TRUE FALSE EQUALS NOTHING   -- (b) would hold if the complainant question were answered: not covered
#ASSERT `s 278.32(1.1) subsection (1) does not apply to the disclosure` TRUE TRUE TRUE NOTHING FALSE FALSE FALSE EQUALS JUST TRUE   -- (a) holds whoever made it
#ASSERT `s 278.32(1.1) subsection (1) does not apply to the disclosure` TRUE FALSE FALSE NOTHING FALSE FALSE FALSE EQUALS JUST FALSE   -- no limb could hold whoever made it

-- Argument order of s 278.32(2): the person published; the answer of (1); the answer of (1.1).
#ASSERT `s 278.32(2) the person is guilty of an offence punishable on summary conviction` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- contravenes (1) and the exception does not apply
#ASSERT `s 278.32(2) the person is guilty of an offence punishable on summary conviction` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE   -- (1.1): "Subsection (1) does not apply if the disclosure" is excepted, so there is no contravention of (1): no offence under (2)
#ASSERT `s 278.32(2) the person is guilty of an offence punishable on summary conviction` TRUE (JUST TRUE) NOTHING EQUALS NOTHING   -- the exception is not determined
#ASSERT `s 278.36(2) the person is guilty of an offence punishable on summary conviction` TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- (1) answers no: no contravention
#ASSERT `s 278.36(2) the person is guilty of an offence punishable on summary conviction` TRUE NOTHING (JUST FALSE) EQUALS NOTHING   -- (1) not covered
#ASSERT `s 278.32(2) the person is guilty of an offence punishable on summary conviction` FALSE (JUST TRUE) (JUST FALSE) EQUALS NOTHING   -- did not publish: no contravention
#ASSERT `s 278.32(2) the person is guilty of an offence punishable on summary conviction` TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- (1) answers no (an order lifted the bar, "unless ... orders"): no contravention of (1)
#ASSERT `s 278.32(2) the person is guilty of an offence punishable on summary conviction` TRUE NOTHING (JUST FALSE) EQUALS NOTHING   -- (1) not determined
#ASSERT `s 278.32(2) the class of the offence` EQUALS `an offence punishable on summary conviction`   -- "guilty of an offence punishable on summary conviction"

`s 278.32(2) fixture: the general summary conviction penalty` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
#ASSERT (`s 278.32(2) the punishment` `s 278.32(2) fixture: the general summary conviction penalty`)'s `mode` EQUALS `on summary conviction`   -- the section states no penalty: the s 787(1) answer is passed through
#ASSERT (`s 278.32(2) the punishment` `s 278.32(2) fixture: the general summary conviction penalty`) EQUALS `s 278.32(2) fixture: the general summary conviction penalty`   -- unchanged

-- The prohibition as a regulative rule. #TRACE results (read, not asserted): an act of publishing at any time -> DEONTIC BREACHED (BY any person); no event -> the prohibition stands (no breach).
#TRACE `s 278.32(1) the prohibition on publishing` AT 0 WITH
    PARTY `s 278.32(1) any person` DOES `s 278.32(1) publish, broadcast or transmit the matter` AT 3
#TRACE `s 278.32(1) the prohibition on publishing` AT 0 WITH
    (WAITUNTIL 5)

§ `s 278.33 -- Instruction to jury`

#ASSERT `s 278.33 the judge shall instruct the jury as to the uses that the jury may and may not make of the evidence` TRUE EQUALS JUST TRUE   -- evidence admitted on the basis of a 278.31(4) determination
#ASSERT `s 278.33 the judge shall instruct the jury as to the uses that the jury may and may not make of the evidence` FALSE EQUALS JUST FALSE   -- the "If" fails
-- #TRACE (read): the judge instructs at time 5 -> FULFILLED; no event -> the duty stands.
#TRACE `s 278.33 the duty to instruct the jury` AT 0 WITH
    PARTY `a judge` DOES `s 278.33 instruct the jury as to the uses that the jury may and may not make of that evidence` AT 5

§ `s 278.34 -- Appeal`

-- Argument order: the determination is one made under 278.31(4); the purpose (the section whose purposes are in question).
#ASSERT `s 278.34 the determination is deemed to be a question of law` TRUE (`Provision of the Code` OF 675, "") EQUALS JUST TRUE   -- "For the purposes of sections 675 and 676": 675
#ASSERT `s 278.34 the determination is deemed to be a question of law` TRUE (`Provision of the Code` OF 676, "") EQUALS JUST TRUE   -- 676
#ASSERT `s 278.34 the determination is deemed to be a question of law` TRUE (`Provision of the Code` OF 677, "") EQUALS NOTHING   -- 677 is outside the stated purposes
#ASSERT `s 278.34 the determination is deemed to be a question of law` TRUE (`Provision of the Code` OF 674, "") EQUALS NOTHING   -- 674 is outside the stated purposes
#ASSERT `s 278.34 the determination is deemed to be a question of law` FALSE (`Provision of the Code` OF 675, "") EQUALS NOTHING   -- not a determination under 278.31(4)

§ `s 278.35 -- Joint application`

-- Argument order of (1): the applicants are the prosecutor and the accused with the complainant or a witness; made to the trial judge; for a determination without a hearing.
#ASSERT `s 278.35(1) the applicants may jointly apply for a determination without a hearing` TRUE TRUE TRUE EQUALS JUST TRUE   -- all three elements
#ASSERT `s 278.35(1) the applicants may jointly apply for a determination without a hearing` FALSE TRUE TRUE EQUALS NOTHING   -- not those applicants: a grant limited by its own wording, not covered
#ASSERT `s 278.35(1) the applicants may jointly apply for a determination without a hearing` TRUE FALSE TRUE EQUALS NOTHING   -- not to the trial judge
#ASSERT `s 278.35(1) the applicants may jointly apply for a determination without a hearing` TRUE TRUE FALSE EQUALS NOTHING   -- not for a determination without a hearing

-- Argument order of (2): in writing; signed; detailed particulars; relevance; admissibility subject to s 276; how it meets 276(2); probative value; information considered necessary.
#ASSERT `s 278.35(2) the application meets the form and content required` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- every requirement, s 276 applies
#ASSERT `s 278.35(2) the application meets the form and content required` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE   -- (b) "if the admissibility ... is subject to section 276": it is not, so (b) asks nothing
#ASSERT `s 278.35(2) the application meets the form and content required` TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- s 276 applies and (b) is not set out
#ASSERT `s 278.35(2) the application meets the form and content required` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- not in writing
#ASSERT `s 278.35(2) the application meets the form and content required` TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- not signed by the applicants
#ASSERT `s 278.35(2) the application meets the form and content required` TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- no detailed particulars
#ASSERT `s 278.35(2) the application meets the form and content required` TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- (a): no relevance
#ASSERT `s 278.35(2) the application meets the form and content required` TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- (c): no significant probative value set out
#ASSERT `s 278.35(2) the application meets the form and content required` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- (d): no information considered necessary

-- (3): 1 January 2026 to 2 March 2026 is 60 days (31 + 28 + 1); to 1 March, 59; to 3 March, 61.
#ASSERT `s 278.35(3) the copy of the application was filed with the clerk of the court at least 60 days before the trial` (Date 1 1 2026) (Date 2 3 2026) EQUALS JUST TRUE   -- exactly 60 days: "at least 60 days"
#ASSERT `s 278.35(3) the copy of the application was filed with the clerk of the court at least 60 days before the trial` (Date 1 1 2026) (Date 1 3 2026) EQUALS JUST FALSE   -- 59 days: too late
#ASSERT `s 278.35(3) the copy of the application was filed with the clerk of the court at least 60 days before the trial` (Date 1 1 2026) (Date 3 3 2026) EQUALS JUST TRUE   -- 61 days

-- (4): 1 January 2026 to 31 January 2026 is 30 days; to 1 February, 31.
#ASSERT `s 278.35(4) the determination was made no later than 30 days after the day on which the application was made` (Date 1 1 2026) (Date 31 1 2026) EQUALS JUST TRUE   -- 30 days: "no later than 30 days"
#ASSERT `s 278.35(4) the determination was made no later than 30 days after the day on which the application was made` (Date 1 1 2026) (Date 1 2 2026) EQUALS JUST FALSE   -- 31 days: too late
#ASSERT `s 278.35(4) the determination was made no later than 30 days after the day on which the application was made` (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST TRUE   -- the same day
-- Argument order of (4)(a) to (c): not all admitted; reasons state the part admitted; reasons state the factors; all or part admitted; reasons state how it is relevant.
#ASSERT `s 278.35(4) the reasons state what paragraphs (a) to (c) require` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- all three met
#ASSERT `s 278.35(4) the reasons state what paragraphs (a) to (c) require` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- (a): not all is admitted and the part is not stated
#ASSERT `s 278.35(4) the reasons state what paragraphs (a) to (c) require` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- (a) and (c) ask nothing: everything is excluded, factors stated
#ASSERT `s 278.35(4) the reasons state what paragraphs (a) to (c) require` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- (b): the factors are not stated
#ASSERT `s 278.35(4) the reasons state what paragraphs (a) to (c) require` FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE   -- (c): some evidence admitted and its relevance not stated
-- The 30-day duty as a trace: the act at day 30 is timely (FULFILLED); with no act by day 31 the duty is BREACHED.
#TRACE `s 278.35(4) the duty to determine the application within 30 days` AT 0 WITH
    PARTY `a judge` DOES `s 278.35(4) consider the application and make a determination, with reasons` AT 30
#TRACE `s 278.35(4) the duty to determine the application within 30 days` AT 0 WITH
    (WAITUNTIL 31)

#ASSERT `s 278.35(5) the judge shall grant the application` TRUE EQUALS JUST TRUE   -- satisfied: "shall grant"
#ASSERT `s 278.35(5) the judge shall grant the application` FALSE EQUALS JUST FALSE   -- not satisfied: the "If" fails
#ASSERT `s 278.35(5) the judge shall hold a hearing under section 278.31` FALSE EQUALS JUST TRUE   -- "not so satisfied, they shall hold a hearing"
#ASSERT `s 278.35(5) the judge shall hold a hearing under section 278.31` TRUE EQUALS JUST FALSE   -- satisfied: the "If ... not so satisfied" fails
-- (5) traces (read): satisfied, the judge grants -> FULFILLED; not satisfied, the judge holds a hearing -> FULFILLED.
#TRACE `s 278.35(5) the duty to grant the application or hold a hearing` TRUE AT 0 WITH
    PARTY `a judge` DOES `s 278.35(5) grant the application` AT 2
#TRACE `s 278.35(5) the duty to grant the application or hold a hearing` FALSE AT 0 WITH
    PARTY `a judge` DOES `s 278.35(5) hold a hearing under section 278.31` AT 2

#ASSERT `s 278.35(6) the judge shall direct the applicants as to the uses that they may and may not make of the record or part` TRUE EQUALS JUST TRUE   -- determined admissible
#ASSERT `s 278.35(6) the judge shall direct the applicants as to the uses that they may and may not make of the record or part` FALSE EQUALS JUST FALSE   -- the "If" fails

#ASSERT `s 278.35(7) section 278.35 does not apply to the record` TRUE EQUALS JUST TRUE   -- "does not apply to a therapeutic record"
#ASSERT `s 278.35(7) section 278.35 does not apply to the record` FALSE EQUALS NOTHING   -- any other record: the flat negative says nothing

#ASSERT `s 278.35(8) the person has the right to be represented by counsel` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the complainant
#ASSERT `s 278.35(8) the person has the right to be represented by counsel` (JUST FALSE) TRUE EQUALS JUST TRUE   -- any witness
#ASSERT `s 278.35(8) the person has the right to be represented by counsel` (JUST FALSE) FALSE EQUALS NOTHING   -- anyone else: the section is silent
#ASSERT `s 278.35(8) the person has the right to be represented by counsel` NOTHING FALSE EQUALS NOTHING   -- s 2 "complainant" not determined
#ASSERT `s 278.35(8) the person has the right to be represented by counsel` NOTHING TRUE EQUALS JUST TRUE   -- a witness

§ `s 278.36 -- Publication prohibited (joint application)`

-- Argument order of s 278.36(1): matter; an application under 278.35(1) has been made; the determination is that the record is admissible; an order that it may be published has been made.
#ASSERT `s 278.36(1) publication of the matter is prohibited` `s 278.36(1)(a) the contents of an application` TRUE FALSE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 278.36(1) publication of the matter is prohibited` `s 278.36(1)(b) evidence taken, information given or representations made at the consideration of an application` TRUE FALSE FALSE EQUALS JUST TRUE   -- (b)
#ASSERT `s 278.36(1) publication of the matter is prohibited` `s 278.36(1)(b) evidence taken, information given or representations made at the consideration of an application` TRUE TRUE TRUE EQUALS JUST TRUE   -- (b) has no carve-out
#ASSERT `s 278.36(1) publication of the matter is prohibited` `s 278.36(1)(c) the determination made and the reasons provided under section 278.35` TRUE FALSE FALSE EQUALS JUST TRUE   -- (c): inadmissible, no order
#ASSERT `s 278.36(1) publication of the matter is prohibited` `s 278.36(1)(c) the determination made and the reasons provided under section 278.35` TRUE TRUE FALSE EQUALS JUST FALSE   -- (c): "unless that determination is that the record or part of it is admissible"
#ASSERT `s 278.36(1) publication of the matter is prohibited` `s 278.36(1)(c) the determination made and the reasons provided under section 278.35` TRUE FALSE TRUE EQUALS JUST FALSE   -- (c): "or the judge ... orders"
#ASSERT `s 278.36(1) publication of the matter is prohibited` `s 278.36(1) a matter that is none of (a) to (c)` TRUE FALSE FALSE EQUALS NOTHING   -- another matter
#ASSERT `s 278.36(1) publication of the matter is prohibited` `s 278.36(1)(a) the contents of an application` FALSE FALSE FALSE EQUALS NOTHING   -- no application under 278.35(1)
#TRACE `s 278.36(1) the prohibition on publishing` AT 0 WITH
    PARTY `s 278.36(1) any person` DOES `s 278.36(1) publish, broadcast or transmit the matter` AT 3

#ASSERT `s 278.36(1.1) the disclosure is made by the complainant or any witness` (JUST TRUE) FALSE EQUALS JUST TRUE   -- the complainant
#ASSERT `s 278.36(1.1) the disclosure is made by the complainant or any witness` (JUST FALSE) TRUE EQUALS JUST TRUE   -- a witness
#ASSERT `s 278.36(1.1) the disclosure is made by the complainant or any witness` (JUST FALSE) FALSE EQUALS JUST FALSE   -- neither
#ASSERT `s 278.36(1.1) the disclosure is made by the complainant or any witness` NOTHING FALSE EQUALS NOTHING   -- not determined
#ASSERT `s 278.36(1.1) subsection (1) does not apply to the disclosure` FALSE TRUE TRUE (JUST TRUE) TRUE TRUE TRUE EQUALS NOTHING   -- not referred to in (1)(a) to (c)
#ASSERT `s 278.36(1.1) subsection (1) does not apply to the disclosure` TRUE TRUE TRUE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 278.36(1.1) subsection (1) does not apply to the disclosure` TRUE FALSE FALSE (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE   -- (b)
#ASSERT `s 278.36(1.1) subsection (1) does not apply to the disclosure` TRUE FALSE FALSE (JUST TRUE) FALSE FALSE TRUE EQUALS JUST TRUE   -- (c)
#ASSERT `s 278.36(1.1) subsection (1) does not apply to the disclosure` TRUE FALSE FALSE (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE   -- none of (a) to (c)
#ASSERT `s 278.36(1.1) subsection (1) does not apply to the disclosure` TRUE FALSE FALSE NOTHING TRUE TRUE FALSE EQUALS NOTHING   -- (b) depends on s 2 "complainant"

#ASSERT `s 278.36(2) the person is guilty of an offence punishable on summary conviction` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- contravenes (1)
#ASSERT `s 278.36(2) the person is guilty of an offence punishable on summary conviction` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE   -- (1.1): "Subsection (1) does not apply if the disclosure" is excepted
#ASSERT `s 278.36(2) the person is guilty of an offence punishable on summary conviction` FALSE (JUST TRUE) (JUST FALSE) EQUALS NOTHING   -- did not publish
#ASSERT `s 278.36(2) the class of the offence` EQUALS `an offence punishable on summary conviction`   -- "guilty of an offence punishable on summary conviction"
#ASSERT (`s 278.36(2) the punishment` `s 278.32(2) fixture: the general summary conviction penalty`)'s `mode` EQUALS `on summary conviction`   -- the s 787(1) answer passed through

#ASSERT `s 278.37 the judge shall instruct the jury as to the uses that the jury may and may not make of the evidence` TRUE EQUALS JUST TRUE   -- evidence admitted on the basis of a 278.35(4) determination
#ASSERT `s 278.37 the judge shall instruct the jury as to the uses that the jury may and may not make of the evidence` FALSE EQUALS JUST FALSE   -- the "If" fails
#TRACE `s 278.37 the duty to instruct the jury` AT 0 WITH
    PARTY `a judge` DOES `s 278.37 instruct the jury as to the uses that the jury may and may not make of that evidence` AT 5

#ASSERT `s 278.38 the determination is deemed to be a question of law` TRUE (`Provision of the Code` OF 675, "") EQUALS JUST TRUE   -- 675
#ASSERT `s 278.38 the determination is deemed to be a question of law` TRUE (`Provision of the Code` OF 676, "") EQUALS JUST TRUE   -- 676
#ASSERT `s 278.38 the determination is deemed to be a question of law` TRUE (`Provision of the Code` OF 674, "") EQUALS NOTHING   -- 674
#ASSERT `s 278.38 the determination is deemed to be a question of law` FALSE (`Provision of the Code` OF 676, "") EQUALS NOTHING   -- not a determination under 278.35(4) or (5)

