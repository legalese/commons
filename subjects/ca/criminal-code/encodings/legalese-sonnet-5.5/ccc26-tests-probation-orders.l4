IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc26-interpretation`
IMPORT `ccc26-probation-orders`

-- ccc26-tests-probation-orders.l4 -- tests for ccc26-probation-orders.l4. Every expected value is written from the text before the run.
-- (sections 732.11, 732.2, 733 and 733.1; lines 15594-15643 of the text)


§ `s 732.11(1): no one may use a bodily substance provided under a probation order except to check compliance with an abstention condition`

-- a substance provided under a probation order, used for another purpose
#ASSERT `s 732.11(1) the use of the bodily substance is barred` TRUE FALSE EQUALS JUST TRUE
-- "except for the purpose of determining whether an offender is complying with a condition ... that they abstain"
#ASSERT `s 732.11(1) the use of the bodily substance is barred` TRUE TRUE EQUALS JUST FALSE
-- not a substance provided under a probation order
#ASSERT `s 732.11(1) the use of the bodily substance is barred` FALSE FALSE EQUALS NOTHING

§ `s 732.11(3): the exception for results`

-- disclosed to the offender to whom they relate
#ASSERT `s 732.11(3) the results may be used or disclosed` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- in an investigation of, or a proceeding for, an offence under section 733.1
#ASSERT `s 732.11(3) the results may be used or disclosed` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- anonymous, for research
#ASSERT `s 732.11(3) the results may be used or disclosed` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- research use of results that are not made anonymous: "if the results are made anonymous"
#ASSERT `s 732.11(3) the results may be used or disclosed` FALSE FALSE FALSE TRUE EQUALS NOTHING
-- anonymous but not used for research
#ASSERT `s 732.11(3) the results may be used or disclosed` FALSE FALSE TRUE FALSE EQUALS NOTHING
-- no use the subsection lists
#ASSERT `s 732.11(3) the results may be used or disclosed` FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `s 732.11(2): no use or disclosure of the results, subject to subsection (3)`

-- a use that falls within none of the three exceptions
#ASSERT `s 732.11(2) the use or disclosure of the results is barred` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- "Subject to subsection (3)": disclosed to the offender
#ASSERT `s 732.11(2) the use or disclosure of the results is barred` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 732.11(2) the use or disclosure of the results is barred` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 732.11(2) the use or disclosure of the results is barred` TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- research use of results not made anonymous is not within (3)
#ASSERT `s 732.11(2) the use or disclosure of the results is barred` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- not the results of the analysis of a substance provided under a probation order
#ASSERT `s 732.11(2) the use or disclosure of the results is barred` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `s 732.11(4): the offence`

#ASSERT `s 732.11(4) the person is guilty of an offence punishable on summary conviction` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 732.11(4) the person is guilty of an offence punishable on summary conviction` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 732.11(4) the person is guilty of an offence punishable on summary conviction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 732.11(4) the person is guilty of an offence punishable on summary conviction` FALSE FALSE EQUALS NOTHING
#ASSERT `s 732.11(4) the class of offence` EQUALS `an offence punishable on summary conviction`
-- the section states no penalty of its own
#ASSERT `s 732.11(4) the punishment on summary conviction` EQUALS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `s 732.2(1): coming into force`

#ASSERT `s 732.2(1) when the probation order comes into force` FALSE FALSE EQUALS JUST `s 732.2(1)(a) on the date on which the order is made`
#ASSERT `s 732.2(1) when the probation order comes into force` TRUE FALSE EQUALS JUST `s 732.2(1)(b) as soon as the offender is released from prison or, if released from prison on conditional release, at the expiration of the sentence of imprisonment`
#ASSERT `s 732.2(1) when the probation order comes into force` FALSE TRUE EQUALS JUST `s 732.2(1)(c) at the expiration of the conditional sentence order`
-- the text does not say which of (b) and (c) governs
#ASSERT `s 732.2(1) when the probation order comes into force` TRUE TRUE EQUALS NOTHING
-- the date on which the order is made
#ASSERT `s 732.2(1) the date on which the probation order comes into force` (Date 1 3 2026) FALSE (Date 1 6 2026) FALSE (Date 1 9 2026) FALSE (Date 1 12 2026) EQUALS JUST (Date 1 3 2026)
-- as soon as released from prison
#ASSERT `s 732.2(1) the date on which the probation order comes into force` (Date 1 3 2026) TRUE (Date 1 6 2026) FALSE (Date 1 9 2026) FALSE (Date 1 12 2026) EQUALS JUST (Date 1 6 2026)
-- released on conditional release: at the expiration of the sentence
#ASSERT `s 732.2(1) the date on which the probation order comes into force` (Date 1 3 2026) TRUE (Date 1 6 2026) TRUE (Date 1 9 2026) FALSE (Date 1 12 2026) EQUALS JUST (Date 1 9 2026)
-- at the expiration of the conditional sentence order
#ASSERT `s 732.2(1) the date on which the probation order comes into force` (Date 1 3 2026) FALSE (Date 1 6 2026) FALSE (Date 1 9 2026) TRUE (Date 1 12 2026) EQUALS JUST (Date 1 12 2026)
#ASSERT `s 732.2(1) the date on which the probation order comes into force` (Date 1 3 2026) TRUE (Date 1 6 2026) FALSE (Date 1 9 2026) TRUE (Date 1 12 2026) EQUALS NOTHING

§ `s 732.2(2): duration of the order`

#ASSERT `s 732.2(2)(a) this paragraph keeps the order in force` TRUE FALSE EQUALS JUST TRUE
-- "except in so far as the sentence renders it impossible ... to comply"
#ASSERT `s 732.2(2)(a) this paragraph keeps the order in force` TRUE TRUE EQUALS JUST FALSE
-- no conviction or imprisonment in default: the "where" gate fails
#ASSERT `s 732.2(2)(a) this paragraph keeps the order in force` FALSE FALSE EQUALS JUST FALSE
-- exactly three years after
#ASSERT `s 732.2(2)(b) the date is within the three years after the order came into force` (Date 1 3 2024) (Date 1 3 2027) EQUALS JUST TRUE
-- more than three years after
#ASSERT `s 732.2(2)(b) the date is within the three years after the order came into force` (Date 1 3 2024) (Date 2 3 2027) EQUALS JUST FALSE
#ASSERT `s 732.2(2)(b) the date is within the three years after the order came into force` (Date 1 3 2024) (Date 1 3 2024) EQUALS JUST TRUE
#ASSERT `s 732.2(2)(b) the date is within the three years after the order came into force` (Date 1 3 2024) (Date 28 2 2027) EQUALS JUST TRUE

§ `s 732.2(3): changes to the order on application`

#ASSERT `s 732.2(3) the court may require the offender to appear before it` TRUE TRUE EQUALS JUST TRUE
-- "on application"
#ASSERT `s 732.2(3) the court may require the offender to appear before it` TRUE FALSE EQUALS JUST FALSE
-- not a court that makes a probation order
#ASSERT `s 732.2(3) the court may require the offender to appear before it` FALSE TRUE EQUALS NOTHING
#ASSERT `s 732.2(3)(a) the court may make the changes to the optional conditions` TRUE TRUE TRUE EQUALS JUST TRUE
-- "after hearing the offender and one or both of the probation officer and the prosecutor"
#ASSERT `s 732.2(3)(a) the court may make the changes to the optional conditions` TRUE FALSE TRUE EQUALS JUST FALSE
-- not rendered desirable by a change in the circumstances in the court's opinion
#ASSERT `s 732.2(3)(a) the court may make the changes to the optional conditions` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 732.2(3)(a) the court may make the changes to the optional conditions` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 732.2(3)(b) the court may relieve the offender of compliance with an optional condition` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 732.2(3)(b) the court may relieve the offender of compliance with an optional condition` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 732.2(3)(b) the court may relieve the offender of compliance with an optional condition` FALSE TRUE EQUALS NOTHING
#ASSERT `s 732.2(3)(c) the court may decrease the period for which the probation order is to remain in force` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 732.2(3)(c) the court may decrease the period for which the probation order is to remain in force` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 732.2(3)(c) the court may decrease the period for which the probation order is to remain in force` FALSE TRUE EQUALS NOTHING
#ASSERT `s 732.2(3) the court must endorse the probation order accordingly` TRUE EQUALS JUST TRUE
-- no change made
#ASSERT `s 732.2(3) the court must endorse the probation order accordingly` FALSE EQUALS JUST FALSE
-- a change to the optional conditions
#ASSERT `s 732.2(3) the court must inform the offender and give the offender a copy of the order so endorsed` TRUE TRUE EQUALS JUST TRUE
-- "if it changes the optional conditions": a change to the period only
#ASSERT `s 732.2(3) the court must inform the offender and give the offender a copy of the order so endorsed` TRUE FALSE EQUALS JUST FALSE
-- no change made
#ASSERT `s 732.2(3) the court must inform the offender and give the offender a copy of the order so endorsed` FALSE FALSE EQUALS NOTHING

§ `s 732.2(4): in chambers`

#ASSERT `s 732.2(4) the court may exercise the function in chambers` TRUE EQUALS JUST TRUE
#ASSERT `s 732.2(4) the court may exercise the function in chambers` FALSE EQUALS NOTHING

§ `s 732.2(5): where a bound offender is convicted of an offence and the conviction is final`

-- the appeal time has expired and no appeal was taken
#ASSERT `s 732.2(5) the court may require the offender to appear before it` TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- the appeal was dismissed
#ASSERT `s 732.2(5) the court may require the offender to appear before it` TRUE TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
-- written notice of election not to appeal, or abandonment
#ASSERT `s 732.2(5) the court may require the offender to appear before it` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- not convicted
#ASSERT `s 732.2(5) the court may require the offender to appear before it` TRUE FALSE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- the conviction is not final
#ASSERT `s 732.2(5) the court may require the offender to appear before it` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- "on application by the prosecutor"
#ASSERT `s 732.2(5) the court may require the offender to appear before it` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- not the court that made the probation order
#ASSERT `s 732.2(5) the court may require the offender to appear before it` FALSE TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 732.2(5)(d) the court may revoke the order and impose any sentence that could have been imposed if the passing of sentence had not been suspended` TRUE TRUE TRUE EQUALS JUST TRUE
-- "where the probation order was made under paragraph 731(1)(a)"
#ASSERT `s 732.2(5)(d) the court may revoke the order and impose any sentence that could have been imposed if the passing of sentence had not been suspended` TRUE FALSE TRUE EQUALS JUST FALSE
-- "after hearing the prosecutor and the offender"
#ASSERT `s 732.2(5)(d) the court may revoke the order and impose any sentence that could have been imposed if the passing of sentence had not been suspended` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 732.2(5)(d) the court may revoke the order and impose any sentence that could have been imposed if the passing of sentence had not been suspended` FALSE TRUE TRUE EQUALS NOTHING
-- changes only
#ASSERT `s 732.2(5)(e) the court may make changes to the optional conditions or extend the period for which the order is to remain in force` TRUE TRUE FALSE `six months` EQUALS JUST TRUE
-- an extension of exactly one year
#ASSERT `s 732.2(5)(e) the court may make changes to the optional conditions or extend the period for which the order is to remain in force` TRUE TRUE TRUE (`Length of time` OF 1, 0, 0, FALSE) EQUALS JUST TRUE
#ASSERT `s 732.2(5)(e) the court may make changes to the optional conditions or extend the period for which the order is to remain in force` TRUE TRUE TRUE `six months` EQUALS JUST TRUE
-- one year and one day: outside the limit of the grant
#ASSERT `s 732.2(5)(e) the court may make changes to the optional conditions or extend the period for which the order is to remain in force` TRUE TRUE TRUE (`Length of time` OF 1, 0, 1, FALSE) EQUALS NOTHING
#ASSERT `s 732.2(5)(e) the court may make changes to the optional conditions or extend the period for which the order is to remain in force` TRUE TRUE TRUE `two years` EQUALS NOTHING
-- 365 days against one year: the calendar decides
#ASSERT `s 732.2(5)(e) the court may make changes to the optional conditions or extend the period for which the order is to remain in force` TRUE TRUE TRUE (`Length of time` OF 0, 0, 365, FALSE) EQUALS NOTHING
#ASSERT `s 732.2(5)(e) the court may make changes to the optional conditions or extend the period for which the order is to remain in force` TRUE TRUE TRUE (`Length of time` OF 0, 0, 300, FALSE) EQUALS JUST TRUE
-- the prosecutor and the offender have not been heard
#ASSERT `s 732.2(5)(e) the court may make changes to the optional conditions or extend the period for which the order is to remain in force` TRUE FALSE TRUE `six months` EQUALS JUST FALSE
#ASSERT `s 732.2(5)(e) the court may make changes to the optional conditions or extend the period for which the order is to remain in force` FALSE TRUE TRUE `six months` EQUALS NOTHING
#ASSERT `s 732.2(5) the court must endorse the probation order accordingly` TRUE EQUALS JUST TRUE
#ASSERT `s 732.2(5) the court must endorse the probation order accordingly` FALSE EQUALS JUST FALSE
#ASSERT `s 732.2(5) the court must inform the offender and give the offender a copy of the order so endorsed` TRUE TRUE EQUALS JUST TRUE
-- "if it changes the optional conditions or extends the period"
#ASSERT `s 732.2(5) the court must inform the offender and give the offender a copy of the order so endorsed` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 732.2(5) the court must inform the offender and give the offender a copy of the order so endorsed` FALSE FALSE EQUALS NOTHING

§ `s 732.2(6): compelling the appearance of the person bound`

#ASSERT `s 732.2(6) the provisions of Parts XVI and XVIII for compelling the appearance of an accused apply to the proceeding` TRUE EQUALS JUST TRUE
-- not a proceeding under subsection (3) or (5)
#ASSERT `s 732.2(6) the provisions of Parts XVI and XVIII for compelling the appearance of an accused apply to the proceeding` FALSE EQUALS NOTHING

§ `s 733(1.1): the consent the transfer needs`

#ASSERT `s 733(1.1) the consent the transfer needs has been given` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- "only with the consent of the Attorney General of the province"
#ASSERT `s 733(1.1) the consent the transfer needs has been given` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 733(1.1) the consent the transfer needs has been given` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- "only with the consent of the Attorney General of Canada"
#ASSERT `s 733(1.1) the consent the transfer needs has been given` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 733(1.1) the consent the transfer needs has been given` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 733(1.1) the consent the transfer needs has been given` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- neither paragraph describes the transfer
#ASSERT `s 733(1.1) the consent the transfer needs has been given` FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `s 733(1): transfer of the order`

#ASSERT `s 733(1) the court that made the order may transfer the order` TRUE TRUE TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
-- "Where an offender ... becomes a resident of ... a territorial division other than ..."
#ASSERT `s 733(1) the court that made the order may transfer the order` TRUE FALSE TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
-- "on the application of a probation officer"
#ASSERT `s 733(1) the court that made the order may transfer the order` TRUE TRUE FALSE (JUST TRUE) TRUE EQUALS JUST FALSE
-- "The transfer may be granted only with" a consent that is missing
#ASSERT `s 733(1) the court that made the order may transfer the order` TRUE TRUE TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
-- subsection (1.1) leaves open whether a consent is needed
#ASSERT `s 733(1) the court that made the order may transfer the order` TRUE TRUE TRUE NOTHING TRUE EQUALS NOTHING
-- not the court that made the order
#ASSERT `s 733(1) the court that made the order may transfer the order` FALSE TRUE TRUE (JUST TRUE) TRUE EQUALS NOTHING
-- the receiving court would not have had jurisdiction
#ASSERT `s 733(1) the court that made the order may transfer the order` TRUE TRUE TRUE (JUST TRUE) FALSE EQUALS NOTHING

§ `s 733(2): where the court is unable to act`

#ASSERT `s 733(2) another court may exercise the powers of the court in relation to the probation order` TRUE TRUE EQUALS JUST TRUE
-- "Where a court ... is for any reason unable to act"
#ASSERT `s 733(2) another court may exercise the powers of the court in relation to the probation order` FALSE TRUE EQUALS JUST FALSE
-- not a court that has equivalent jurisdiction in the same province
#ASSERT `s 733(2) another court may exercise the powers of the court in relation to the probation order` TRUE FALSE EQUALS NOTHING

§ `s 733.1(1): failure to comply with a probation order`

#ASSERT `s 733.1(1) the offender is guilty of failing to comply with the probation order` TRUE TRUE FALSE EQUALS JUST TRUE
-- "without reasonable excuse": a reasonable excuse
#ASSERT `s 733.1(1) the offender is guilty of failing to comply with the probation order` TRUE TRUE TRUE EQUALS JUST FALSE
-- no failure or refusal to comply
#ASSERT `s 733.1(1) the offender is guilty of failing to comply with the probation order` TRUE FALSE FALSE EQUALS NOTHING
-- not bound by a probation order
#ASSERT `s 733.1(1) the offender is guilty of failing to comply with the probation order` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 733.1(1)(a) four years` EQUALS `Length of time` OF 4, 0, 0, FALSE
-- imprisonment for a term of not more than four years
#ASSERT `s 733.1(1)(a) the punishment on indictment` EQUALS Punishment OF `by indictment`, (`imprisonment for a term of` (`Length of time` OF 4, 0, 0, FALSE)), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
-- the paragraph states no penalty of its own
#ASSERT `s 733.1(1)(b) the punishment on summary conviction` EQUALS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
#ASSERT `s 733.1(1) the class of offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`

§ `s 733.1(2): place of trial; consent of the Attorney General outside the province`

#ASSERT `s 733.1(2) the accused may be tried and punished by the court` TRUE TRUE EQUALS JUST TRUE
-- not an accused charged with an offence under subsection (1)
#ASSERT `s 733.1(2) the accused may be tried and punished by the court` FALSE TRUE EQUALS NOTHING
-- not a court with the described jurisdiction
#ASSERT `s 733.1(2) the accused may be tried and punished by the court` TRUE FALSE EQUALS NOTHING
-- outside the province, and the Attorney General of that province has not consented
#ASSERT `s 733.1(2) the bar on instituting proceedings in that place applies` TRUE FALSE EQUALS JUST TRUE
-- "without the consent of the Attorney General of that province"
#ASSERT `s 733.1(2) the bar on instituting proceedings in that place applies` TRUE TRUE EQUALS JUST FALSE
-- within the province: the "where" gate of the bar fails
#ASSERT `s 733.1(2) the bar on instituting proceedings in that place applies` FALSE FALSE EQUALS JUST FALSE
