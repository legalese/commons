        IF NOT (`the court that made the order, or to which it was transferred, is for any reason unable to act`)
        THEN JUST FALSE   -- FALSE-kind (the text says no in its own words): "Where a court ... is for any reason unable to act" (a "where" gate on a "may", ruling (b); listed, group (i))
        IF court EQUALS `s 742.5(2) a court with equivalent jurisdiction in the same province` THEN JUST TRUE
        OTHERWISE NOTHING   -- NOTHING-kind (limited by its own wording): "any other court that has equivalent jurisdiction in the same province" (a grant named "may": fork F-2, the other reading is JUST FALSE)

