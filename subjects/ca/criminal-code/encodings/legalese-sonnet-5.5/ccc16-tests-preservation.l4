IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc16-preservation`

-- ccc16-tests-preservation.l4 -- tests for ccc16-preservation.l4 (sections 487.011 to 487.0131).
-- Expected values were decided from the text (lines 9058-9118) before the run and are written beside each assertion.

§ `s 487.011 -- the definitions`
-- "in this section and in sections 487.012 to 487.0199"
#ASSERT `s 487.011 the definitions apply in the section` 487.011 EQUALS JUST TRUE
#ASSERT `s 487.011 the definitions apply in the section` 487.012 EQUALS JUST TRUE
#ASSERT `s 487.011 the definitions apply in the section` 487.0131 EQUALS JUST TRUE
#ASSERT `s 487.011 the definitions apply in the section` 487.0194 EQUALS JUST TRUE
#ASSERT `s 487.011 the definitions apply in the section` 487.0199 EQUALS JUST TRUE
#ASSERT `s 487.011 the definitions apply in the section` 487.02 EQUALS NOTHING   -- past 487.0199
#ASSERT `s 487.011 the definitions apply in the section` 487.01 EQUALS NOTHING
#ASSERT `s 487.011 the definitions apply in the section` 487 EQUALS NOTHING
-- computer data: the meaning is that of subsection 342.1(2), another part's answer
#ASSERT `s 487.011 computer data` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 487.011 computer data` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 487.011 computer data` NOTHING EQUALS NOTHING
-- data: representations capable of being understood by an individual or processed by a computer system or other device
#ASSERT `s 487.011 data` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.011 data` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.011 data` FALSE TRUE EQUALS JUST FALSE
-- document: a medium on which data is registered or marked
#ASSERT `s 487.011 document` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.011 document` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.011 document` FALSE TRUE EQUALS JUST FALSE
-- judge: a judge of a superior court of criminal jurisdiction or a judge of the Court of Quebec
#ASSERT `s 487.011 judge` `s 487.011 a judge of a superior court of criminal jurisdiction` EQUALS JUST TRUE
#ASSERT `s 487.011 judge` `s 487.011 a judge of the Court of Quebec` EQUALS JUST TRUE
#ASSERT `s 487.011 judge` `s 487.011 a judge of another court` EQUALS JUST FALSE
-- public officer: a public officer (section 2) who is appointed or designated and whose duties include the enforcement of this Act or any other Act of Parliament
#ASSERT `s 487.011 public officer` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.011 public officer` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 487.011 public officer` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.011 public officer` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 487.011 public officer` NOTHING TRUE TRUE EQUALS NOTHING   -- s 2 "public officer" not answered
-- tracking data: data that relates to the location of a transaction, individual or thing
#ASSERT `s 487.011 tracking data` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 487.011 tracking data` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 487.011 tracking data` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 487.011 tracking data` NOTHING TRUE EQUALS NOTHING
-- transmission data: (a) dialling, routing, addressing or signalling; (b) one of two limbs; (c) does not reveal the substance, meaning or purpose
#ASSERT `s 487.011 transmission data` (JUST TRUE) TRUE TRUE FALSE TRUE EQUALS JUST TRUE   -- (b) first limb
#ASSERT `s 487.011 transmission data` (JUST TRUE) TRUE FALSE TRUE TRUE EQUALS JUST TRUE   -- (b) second limb
#ASSERT `s 487.011 transmission data` (JUST TRUE) FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- (a) fails
#ASSERT `s 487.011 transmission data` (JUST TRUE) TRUE FALSE FALSE TRUE EQUALS JUST FALSE   -- (b) neither limb
#ASSERT `s 487.011 transmission data` (JUST TRUE) TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- (c) fails: it reveals the substance
#ASSERT `s 487.011 transmission data` (JUST FALSE) TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 487.011 transmission data` NOTHING TRUE TRUE TRUE TRUE EQUALS NOTHING

§ `s 487.012 -- preservation demand`
#ASSERT `s 487.012(1) the peace officer or public officer may make a demand to preserve computer data` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.012(1) the peace officer or public officer may make a demand to preserve computer data` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 487.012(1) the peace officer or public officer may make a demand to preserve computer data` TRUE FALSE TRUE EQUALS NOTHING   -- not in Form 5.001
#ASSERT `s 487.012(1) the peace officer or public officer may make a demand to preserve computer data` TRUE TRUE FALSE EQUALS NOTHING   -- not in their possession or control
-- (2) only if: (a) domestic or foreign offence; (b) in the foreign case an investigation by the foreign authority; (c) the data is in the person's possession or control and will assist
#ASSERT `s 487.012(2) the peace officer or public officer may make the demand` TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- an offence under this or any other Act of Parliament
#ASSERT `s 487.012(2) the peace officer or public officer may make the demand` FALSE TRUE TRUE TRUE EQUALS JUST TRUE   -- an offence under a law of a foreign state, being investigated there
#ASSERT `s 487.012(2) the peace officer or public officer may make the demand` FALSE TRUE FALSE TRUE EQUALS JUST FALSE   -- foreign offence, no investigation by the foreign authority
#ASSERT `s 487.012(2) the peace officer or public officer may make the demand` FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- no offence suspected
#ASSERT `s 487.012(2) the peace officer or public officer may make the demand` TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- (c) fails
#ASSERT `s 487.012(3) the demand is barred against the person under investigation for the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 487.012(3) the demand is barred against the person under investigation for the offence` FALSE EQUALS NOTHING
#ASSERT `s 487.012(4) the peace officer or public officer may revoke the demand` TRUE EQUALS JUST TRUE
#ASSERT `s 487.012(4) the peace officer or public officer may revoke the demand` FALSE EQUALS NOTHING
-- (4)(a) 21 days after the day on which it is made; (4)(b) 90 days. Made on 1 January 2026.
#ASSERT `s 487.012(4) the demand expires on the day` (Date 1 1 2026) `s 487.012(4)(a) an offence that has been or will be committed under this or any other Act of Parliament` EQUALS (Date 22 1 2026)
#ASSERT `s 487.012(4) the demand expires on the day` (Date 1 1 2026) `s 487.012(4)(b) an offence committed under a law of a foreign state` EQUALS (Date 1 4 2026)   -- 90 days after 1 January is 1 April
#ASSERT `s 487.012(4) the demand is in effect on the day` (Date 1 1 2026) `s 487.012(4)(a) an offence that has been or will be committed under this or any other Act of Parliament` (Date 21 1 2026) NOTHING EQUALS JUST TRUE   -- the last day before it expires
#ASSERT `s 487.012(4) the demand is in effect on the day` (Date 1 1 2026) `s 487.012(4)(a) an offence that has been or will be committed under this or any other Act of Parliament` (Date 22 1 2026) NOTHING EQUALS JUST FALSE   -- the day it expires
#ASSERT `s 487.012(4) the demand is in effect on the day` (Date 1 1 2026) `s 487.012(4)(b) an offence committed under a law of a foreign state` (Date 22 1 2026) NOTHING EQUALS JUST TRUE   -- a foreign offence: still 90 days
#ASSERT `s 487.012(4) the demand is in effect on the day` (Date 1 1 2026) `s 487.012(4)(b) an offence committed under a law of a foreign state` (Date 31 3 2026) NOTHING EQUALS JUST TRUE
#ASSERT `s 487.012(4) the demand is in effect on the day` (Date 1 1 2026) `s 487.012(4)(b) an offence committed under a law of a foreign state` (Date 1 4 2026) NOTHING EQUALS JUST FALSE
#ASSERT `s 487.012(4) the demand is in effect on the day` (Date 1 1 2026) `s 487.012(4)(a) an offence that has been or will be committed under this or any other Act of Parliament` (Date 10 1 2026) (JUST (Date 5 1 2026)) EQUALS NOTHING   -- revoked earlier: the expiry clause is silent
#ASSERT `s 487.012(4) the demand is in effect on the day` (Date 1 1 2026) `s 487.012(4)(a) an offence that has been or will be committed under this or any other Act of Parliament` (Date 3 1 2026) (JUST (Date 5 1 2026)) EQUALS JUST TRUE   -- before the revocation
#ASSERT `s 487.012(5) the officer who makes the demand may impose the condition in the demand` TRUE EQUALS JUST TRUE
#ASSERT `s 487.012(5) the officer who makes the demand may impose the condition in the demand` FALSE EQUALS NOTHING
#ASSERT `s 487.012(5) the officer may revoke the condition at any time` TRUE EQUALS JUST TRUE
#ASSERT `s 487.012(5) the officer may revoke the condition at any time` FALSE EQUALS NOTHING
#ASSERT `s 487.012(6) another demand to preserve the same computer data in connection with the investigation is barred` TRUE EQUALS JUST TRUE
#ASSERT `s 487.012(6) another demand to preserve the same computer data in connection with the investigation is barred` FALSE EQUALS NOTHING

§ `s 487.013 -- preservation order`
#ASSERT `s 487.013(1) the justice or judge may order the person to preserve computer data` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.013(1) the justice or judge may order the person to preserve computer data` FALSE TRUE EQUALS NOTHING   -- not an ex parte application by a peace officer or public officer
#ASSERT `s 487.013(1) the justice or judge may order the person to preserve computer data` TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.013(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.013(2) the justice or judge has the satisfaction required before making the order` FALSE TRUE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 1)
#ASSERT `s 487.013(2) the justice or judge has the satisfaction required before making the order` TRUE FALSE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 2)
#ASSERT `s 487.013(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE FALSE EQUALS JUST FALSE   -- one ground or the oath missing (position 3)
#ASSERT `s 487.013(3) the justice or judge has the further satisfaction required for an offence against a law of a foreign state` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.013(3) the justice or judge has the further satisfaction required for an offence against a law of a foreign state` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.013(3) the justice or judge has the further satisfaction required for an offence against a law of a foreign state` FALSE TRUE EQUALS NOTHING   -- not an offence under a law of a foreign state
#ASSERT `s 487.013(4) the order is in Form 5.003` TRUE EQUALS JUST TRUE
#ASSERT `s 487.013(4) the order is in Form 5.003` FALSE EQUALS JUST FALSE   -- "The order is to be in Form 5.003"
#ASSERT `s 487.013(5) the order is barred against the person under investigation for the offence` TRUE EQUALS JUST TRUE   -- a person who is under investigation for the offence may not be made subject to an order
#ASSERT `s 487.013(5) the order is barred against the person under investigation for the offence` FALSE EQUALS NOTHING   -- a person not under investigation for it: the subsection is silent
#ASSERT `s 487.013(6) the order expires on the day` (Date 1 1 2026) EQUALS (Date 1 4 2026)   -- 90 days after the day on which it is made
#ASSERT `s 487.013(6) the order is in effect on the day` (Date 1 1 2026) (Date 1 1 2026) NOTHING EQUALS JUST TRUE   -- the day it is made
#ASSERT `s 487.013(6) the order is in effect on the day` (Date 1 1 2026) (Date 31 3 2026) NOTHING EQUALS JUST TRUE   -- the last day before it expires
#ASSERT `s 487.013(6) the order is in effect on the day` (Date 1 1 2026) (Date 1 4 2026) NOTHING EQUALS JUST FALSE   -- the day it expires
#ASSERT `s 487.013(6) the order is in effect on the day` (Date 1 1 2026) (Date 11 4 2026) NOTHING EQUALS JUST FALSE
#ASSERT `s 487.013(6) the order is in effect on the day` (Date 1 1 2026) (Date 6 1 2026) (JUST (Date 6 1 2026)) EQUALS NOTHING   -- revoked earlier: the expiry clause is silent

§ `s 487.0131 -- keep account open or active order`
#ASSERT `s 487.0131(1) the justice or judge may order the person to keep the account open or active` TRUE EQUALS JUST TRUE
#ASSERT `s 487.0131(1) the justice or judge may order the person to keep the account open or active` FALSE EQUALS NOTHING
#ASSERT `s 487.0131(1) the person must keep the account open or active` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.0131(1) the person must keep the account open or active` TRUE TRUE EQUALS JUST FALSE   -- "unless the holder of the account requests that the person close or deactivate the account"
#ASSERT `s 487.0131(1) the person must keep the account open or active` FALSE FALSE EQUALS NOTHING   -- no order
#ASSERT `s 487.0131(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.0131(2) the justice or judge has the satisfaction required before making the order` FALSE TRUE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 1)
#ASSERT `s 487.0131(2) the justice or judge has the satisfaction required before making the order` TRUE FALSE TRUE EQUALS JUST FALSE   -- one ground or the oath missing (position 2)
#ASSERT `s 487.0131(2) the justice or judge has the satisfaction required before making the order` TRUE TRUE FALSE EQUALS JUST FALSE   -- one ground or the oath missing (position 3)
#ASSERT `s 487.0131(3) the order is in Form 5.0032` TRUE EQUALS JUST TRUE
#ASSERT `s 487.0131(3) the order is in Form 5.0032` FALSE EQUALS JUST FALSE   -- "The order is to be in Form 5.0032"
#ASSERT `s 487.0131(4) the order contains the notification requirement` TRUE EQUALS JUST TRUE
#ASSERT `s 487.0131(4) the order contains the notification requirement` FALSE EQUALS JUST FALSE
#ASSERT `s 487.0131(5) the order is barred against the person under investigation for the offence` TRUE EQUALS JUST TRUE   -- a person who is under investigation for the offence may not be made subject to an order
#ASSERT `s 487.0131(5) the order is barred against the person under investigation for the offence` FALSE EQUALS NOTHING   -- a person not under investigation for it: the subsection is silent
#ASSERT `s 487.0131(6) the order expires on the day` (Date 1 1 2026) EQUALS (Date 2 3 2026)   -- 60 days after the day on which it is made
#ASSERT `s 487.0131(6) the order is in effect on the day` (Date 1 1 2026) (Date 1 1 2026) NOTHING EQUALS JUST TRUE   -- the day it is made
#ASSERT `s 487.0131(6) the order is in effect on the day` (Date 1 1 2026) (Date 1 3 2026) NOTHING EQUALS JUST TRUE   -- the last day before it expires
#ASSERT `s 487.0131(6) the order is in effect on the day` (Date 1 1 2026) (Date 2 3 2026) NOTHING EQUALS JUST FALSE   -- the day it expires
#ASSERT `s 487.0131(6) the order is in effect on the day` (Date 1 1 2026) (Date 12 3 2026) NOTHING EQUALS JUST FALSE
#ASSERT `s 487.0131(6) the order is in effect on the day` (Date 1 1 2026) (Date 6 1 2026) (JUST (Date 6 1 2026)) EQUALS NOTHING   -- revoked earlier: the expiry clause is silent
#ASSERT `s 487.0131(7) the justice or judge may renew the order for the period` TRUE 60 EQUALS JUST TRUE   -- not more than 60 days: the boundary
#ASSERT `s 487.0131(7) the justice or judge may renew the order for the period` TRUE 61 EQUALS JUST FALSE   -- more than 60 days
#ASSERT `s 487.0131(7) the justice or judge may renew the order for the period` TRUE 1 EQUALS JUST TRUE
#ASSERT `s 487.0131(7) the justice or judge may renew the order for the period` FALSE 30 EQUALS NOTHING   -- no ex parte application indicating the reason and period
#ASSERT `s 487.0131(8) the justice or judge has the satisfaction required before renewing the order` TRUE EQUALS JUST TRUE
#ASSERT `s 487.0131(8) the justice or judge has the satisfaction required before renewing the order` FALSE EQUALS JUST FALSE
