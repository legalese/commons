IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc20-part16-process`

-- ccc20-tests-process.l4 -- tests for ccc20-part16-process.l4 (ss 504 to 514). Expected values are hand-written from the text of lines 11231-11363.

§ `Tests -- sections 504 to 506`
-- 504 args: (a) alleged an indictable offence that may be tried in the justice's province; (a) the person is or resides within the justice's jurisdiction; (b); (c); (d)
#ASSERT `s 504 any one may lay an information in writing and under oath before a justice` TRUE EQUALS JUST TRUE
#ASSERT `s 504 any one may lay an information in writing and under oath before a justice` FALSE EQUALS NOTHING
#ASSERT `s 504 the justice must receive the information` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 504 the justice must receive the information` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 504 the justice must receive the information` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 504 the justice must receive the information` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 504 the justice must receive the information` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 504 the justice must receive the information` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 504 the justice must receive the information` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 505 an information must be laid before a justice` TRUE EQUALS JUST TRUE
#ASSERT `s 505 an information must be laid before a justice` FALSE EQUALS JUST FALSE
-- 505 args: as soon as practicable; before the time stated for attendance
#ASSERT `s 505 the information was laid in time` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 505 the information was laid in time` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 505 the information was laid in time` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 506 the information may be in Form 2` TRUE EQUALS JUST TRUE
#ASSERT `s 506 the information may be in Form 2` FALSE EQUALS NOTHING

