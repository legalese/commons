IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc17-warrants`

-- ccc17-tests-warrants.l4 -- tests for ccc17-warrants.l4 (ss 487.092 to 488). Expected values are written from the text, beside each assertion.

§ `Tests: s 487.092 impression warrant`

#ASSERT `s 487.092(1) the justice may issue a warrant in writing authorizing a peace officer to obtain a print or impression of the body of the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.092(1) the justice may issue a warrant in writing authorizing a peace officer to obtain a print or impression of the body of the person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.092(1) the justice may issue a warrant in writing authorizing a peace officer to obtain a print or impression of the body of the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.092(2) the warrant shall contain the term or condition` TRUE EQUALS JUST TRUE
#ASSERT `s 487.092(2) the warrant shall contain the term or condition` FALSE EQUALS NOTHING
#ASSERT `s 487.092(3) the warrant may be executed by the peace officer at the place` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.092(3) the warrant may be executed by the peace officer at the place` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.092(3) the warrant may be executed by the peace officer at the place` FALSE TRUE EQUALS NOTHING

§ `Tests: s 487.093 duty of the person executing certain warrants`

-- the six warrants named in the lead-in
#ASSERT count `s 487.093(1) the warrants` EQUALS 6
#ASSERT `s 487.093(1) what the person executing the warrant shall do during the execution` (`Provision of the Code` OF 110.1, "(5)") TRUE FALSE FALSE EQUALS JUST `s 487.093(1)(a) give a copy of the warrant and a notice in Form 5.1 to the person present and ostensibly in control of the building, receptacle or place to be searched`
#ASSERT `s 487.093(1) what the person executing the warrant shall do during the execution` (`Provision of the Code` OF 117.0101, "(6)") TRUE FALSE FALSE EQUALS JUST `s 487.093(1)(a) give a copy of the warrant and a notice in Form 5.1 to the person present and ostensibly in control of the building, receptacle or place to be searched`
#ASSERT `s 487.093(1) what the person executing the warrant shall do during the execution` (`Provision of the Code` OF 117.04, "(1)") FALSE FALSE FALSE EQUALS JUST `s 487.093(1)(b) affix the copy and the notice in a prominent location within the building or place or on or next to the receptacle`
#ASSERT `s 487.093(1) what the person executing the warrant shall do during the execution` (`Provision of the Code` OF 199, "(1)") FALSE FALSE FALSE EQUALS JUST `s 487.093(1)(b) affix the copy and the notice in a prominent location within the building or place or on or next to the receptacle`
#ASSERT `s 487.093(1) what the person executing the warrant shall do during the execution` (`Provision of the Code` OF 395, "(1)") FALSE TRUE FALSE EQUALS JUST `s 487.093(1)(c) give the copy and the notice to the person to be searched`
#ASSERT `s 487.093(1) what the person executing the warrant shall do during the execution` (`Provision of the Code` OF 395, "(1)") TRUE FALSE FALSE EQUALS JUST `s 487.093(1)(a) give a copy of the warrant and a notice in Form 5.1 to the person present and ostensibly in control of the building, receptacle or place to be searched`
#ASSERT `s 487.093(1) what the person executing the warrant shall do during the execution` (`Provision of the Code` OF 487, "(1)") TRUE FALSE FALSE EQUALS JUST `s 487.093(1)(a) give a copy of the warrant and a notice in Form 5.1 to the person present and ostensibly in control of the building, receptacle or place to be searched`
#ASSERT `s 487.093(1) what the person executing the warrant shall do during the execution` (`Provision of the Code` OF 487, "(1)") TRUE FALSE TRUE EQUALS JUST `s 487.093(2) subsection (1) does not apply because the warrant authorizes the search of a thing detained after it was lawfully seized`
#ASSERT `s 487.093(1) what the person executing the warrant shall do during the execution` (`Provision of the Code` OF 492.1, "(1)") TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 487.093(2) subsection (1) does not apply` TRUE EQUALS JUST TRUE
#ASSERT `s 487.093(2) subsection (1) does not apply` FALSE EQUALS JUST FALSE

