-- the table has 28 rows: 29 paragraphs (a) to (z) with (b.1), (b.2) and (j.1), less paragraph (o), which is a range of sections
#ASSERT count `s 487.1(1) the provisions` EQUALS 28
-- paragraph (o): an order under any of sections 487.013 to 487.018, both ends in, the neighbours out
#ASSERT `s 487.1(1) the application may be submitted by a means of telecommunication` `s 487.1(1) a peace officer` TRUE (`Provision of the Code` OF 487.013, "(1)") FALSE EQUALS JUST TRUE
#ASSERT `s 487.1(1) the application may be submitted by a means of telecommunication` `s 487.1(1) a peace officer` TRUE (`Provision of the Code` OF 487.015, "(1)") FALSE EQUALS JUST TRUE
#ASSERT `s 487.1(1) the application may be submitted by a means of telecommunication` `s 487.1(1) a peace officer` TRUE (`Provision of the Code` OF 487.018, "(1)") FALSE EQUALS JUST TRUE
#ASSERT `s 487.1(1)(o) the order is under one of sections 487.013 to 487.018` 487.013 EQUALS TRUE
#ASSERT `s 487.1(1)(o) the order is under one of sections 487.013 to 487.018` 487.018 EQUALS TRUE
#ASSERT `s 487.1(1)(o) the order is under one of sections 487.013 to 487.018` 487.012 EQUALS FALSE
#ASSERT `s 487.1(1)(o) the order is under one of sections 487.013 to 487.018` 487.019 EQUALS FALSE
-- paragraph (m): the warrant under 487.01(1) that authorizes observation by television camera is out
#ASSERT `s 487.1(1) the application may be submitted by a means of telecommunication` `s 487.1(1) a peace officer` TRUE (`Provision of the Code` OF 487.01, "(1)") TRUE EQUALS NOTHING
-- the applicants: the Attorney General, a peace officer, a public officer; anyone else is not covered; and the applicant must be permitted to apply
#ASSERT `s 487.1(1) the application may be submitted by a means of telecommunication` `s 487.1(1) the Attorney General` TRUE (`Provision of the Code` OF 487, "(1)") FALSE EQUALS JUST TRUE
#ASSERT `s 487.1(1) the application may be submitted by a means of telecommunication` `s 487.1(1) a public officer` TRUE (`Provision of the Code` OF 487, "(1)") FALSE EQUALS JUST TRUE
#ASSERT `s 487.1(1) the application may be submitted by a means of telecommunication` `s 487.1(1) someone else` TRUE (`Provision of the Code` OF 487, "(1)") FALSE EQUALS NOTHING
#ASSERT `s 487.1(1) the application may be submitted by a means of telecommunication` `s 487.1(1) a peace officer` FALSE (`Provision of the Code` OF 487, "(1)") FALSE EQUALS NOTHING
-- a provision the list does not name
#ASSERT `s 487.1(1) the application may be submitted by a means of telecommunication` `s 487.1(1) a peace officer` TRUE (`Provision of the Code` OF 487.02, "(1)") FALSE EQUALS NOTHING
#ASSERT `s 487.1(1) the application may be submitted by a means of telecommunication` `s 487.1(1) a peace officer` TRUE (`Provision of the Code` OF 83.222, "(2)") FALSE EQUALS NOTHING
-- (2) to (11)
#ASSERT `s 487.1(2) the statement is deemed to be a statement made under oath` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.1(2) the statement is deemed to be a statement made under oath` TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.1(2) the statement is deemed to be a statement made under oath` FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.1(3) the judicial officer shall certify the application as to time and date of receipt` TRUE EQUALS JUST TRUE
#ASSERT `s 487.1(3) the judicial officer shall certify the application as to time and date of receipt` FALSE EQUALS NOTHING
#ASSERT `s 487.1(4) the application shall not be submitted by a means of telecommunication that does not produce a writing` TRUE EQUALS JUST TRUE
#ASSERT `s 487.1(4) the application shall not be submitted by a means of telecommunication that does not produce a writing` FALSE EQUALS NOTHING
#ASSERT `s 487.1(5) the applicant may submit the application by a means of telecommunication that does not produce a writing` TRUE EQUALS JUST TRUE
#ASSERT `s 487.1(5) the applicant may submit the application by a means of telecommunication that does not produce a writing` FALSE EQUALS JUST FALSE
#ASSERT `s 487.1(6) the application includes the statement of circumstances the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.1(6) the application includes the statement of circumstances the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.1(6) the application includes the statement of circumstances the subsection requires` FALSE FALSE EQUALS NOTHING
#ASSERT `s 487.1(7) the oath may be administered by a means of telecommunication` TRUE EQUALS JUST TRUE
#ASSERT `s 487.1(7) the oath may be administered by a means of telecommunication` FALSE EQUALS NOTHING
#ASSERT `s 487.1(8) the judicial officer shall record the application verbatim and certify the record or a transcription of it as to time, date and contents` TRUE EQUALS JUST TRUE
#ASSERT `s 487.1(8) the judicial officer shall record the application verbatim and certify the record or a transcription of it as to time, date and contents` FALSE EQUALS NOTHING
#ASSERT `s 487.1(9) the judicial officer is barred from issuing the warrant, order, extension or authorization` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.1(9) the judicial officer is barred from issuing the warrant, order, extension or authorization` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 487.1(9) the judicial officer is barred from issuing the warrant, order, extension or authorization` FALSE FALSE EQUALS NOTHING
-- (10): when the means produces a writing: (a) and (b); when it does not: (a) and (c)
#ASSERT `s 487.1(10) the steps that follow when the judicial officer issues the document by a means of telecommunication` TRUE TRUE EQUALS JUST (LIST `s 487.1(10)(a) the judicial officer completes and signs the document, noting on its face the time and date`, `s 487.1(10)(b) the judicial officer transmits a copy of the document to the applicant by that means`)
#ASSERT `s 487.1(10) the steps that follow when the judicial officer issues the document by a means of telecommunication` TRUE FALSE EQUALS JUST (LIST `s 487.1(10)(a) the judicial officer completes and signs the document, noting on its face the time and date`, `s 487.1(10)(c) the applicant transcribes the document, as directed by the judicial officer, noting on its face the name of the judicial officer as well as the time and date`)
#ASSERT `s 487.1(10) the steps that follow when the judicial officer issues the document by a means of telecommunication` FALSE TRUE EQUALS NOTHING
-- (11): the two defined terms
#ASSERT `s 487.1(11) judicial officer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.1(11) judicial officer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.1(11) judicial officer` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 487.1(11) public officer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.1(11) public officer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.1(11) public officer` FALSE TRUE EQUALS JUST FALSE

§ `Tests: s 487.11 without a warrant, s 487.2 publication, s 487.3 sealing, s 488 execution by day`

#ASSERT `s 487.11 the officer may exercise the powers described in subsection 487(1) or 492.1(1) without a warrant` (JUST TRUE) FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.11 the officer may exercise the powers described in subsection 487(1) or 492.1(1) without a warrant` (JUST FALSE) TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.11 the officer may exercise the powers described in subsection 487(1) or 492.1(1) without a warrant` NOTHING FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 487.11 the officer may exercise the powers described in subsection 487(1) or 492.1(1) without a warrant` (JUST TRUE) FALSE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 487.11 the officer may exercise the powers described in subsection 487(1) or 492.1(1) without a warrant` (JUST TRUE) FALSE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.11 the officer may exercise the powers described in subsection 487(1) or 492.1(1) without a warrant` (JUST TRUE) FALSE TRUE TRUE FALSE EQUALS NOTHING
-- 487.2: all elements -> guilty; consent, or a charge laid -> not; one kind of information is enough
#ASSERT `s 487.2 the person is guilty of an offence punishable on summary conviction` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 487.2 the person is guilty of an offence punishable on summary conviction` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 487.2 the person is guilty of an offence punishable on summary conviction` TRUE TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.2 the person is guilty of an offence punishable on summary conviction` TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 487.2 the person is guilty of an offence punishable on summary conviction` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 487.2 the person is guilty of an offence punishable on summary conviction` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 487.2 the person is guilty of an offence punishable on summary conviction` FALSE TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT count `s 487.2 the punishments` EQUALS 1
-- 487.3
#ASSERT `s 487.3(1) the justice or judge may make an order prohibiting access to, and the disclosure of, any information relating to the warrant, order or authorization` `s 487.3(1) a justice` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.3(1) the justice or judge may make an order prohibiting access to, and the disclosure of, any information relating to the warrant, order or authorization` `s 487.3(1) a judge of a superior court of criminal jurisdiction` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.3(1) the justice or judge may make an order prohibiting access to, and the disclosure of, any information relating to the warrant, order or authorization` `s 487.3(1) a judge of the Court of Quebec` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.3(1) the justice or judge may make an order prohibiting access to, and the disclosure of, any information relating to the warrant, order or authorization` `s 487.3(1) someone else` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 487.3(1) the justice or judge may make an order prohibiting access to, and the disclosure of, any information relating to the warrant, order or authorization` `s 487.3(1) a justice` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 487.3(1) the justice or judge may make an order prohibiting access to, and the disclosure of, any information relating to the warrant, order or authorization` `s 487.3(1) a justice` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.3(1) the justice or judge may make an order prohibiting access to, and the disclosure of, any information relating to the warrant, order or authorization` `s 487.3(1) a justice` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 487.3(2) the ground is one on which an order under subsection (1) may be made` `s 487.3(2)(a)(i) disclosure of the information would compromise the identity of a confidential informant` FALSE EQUALS JUST TRUE
#ASSERT `s 487.3(2) the ground is one on which an order under subsection (1) may be made` `s 487.3(2)(a)(ii) disclosure of the information would compromise the nature and extent of an ongoing investigation` FALSE EQUALS JUST TRUE
#ASSERT `s 487.3(2) the ground is one on which an order under subsection (1) may be made` `s 487.3(2)(a)(iii) disclosure of the information would endanger a person engaged in particular intelligence-gathering techniques and thereby prejudice future investigations in which similar techniques would be used` FALSE EQUALS JUST TRUE
#ASSERT `s 487.3(2) the ground is one on which an order under subsection (1) may be made` `s 487.3(2)(a)(iii.1) disclosure of the information would be injurious to international relations, national defence or national security` FALSE EQUALS JUST TRUE
#ASSERT `s 487.3(2) the ground is one on which an order under subsection (1) may be made` `s 487.3(2)(a)(iv) disclosure of the information would prejudice the interests of an innocent person` FALSE EQUALS JUST TRUE
#ASSERT `s 487.3(2) the ground is one on which an order under subsection (1) may be made` `s 487.3(2)(b) any other sufficient reason` TRUE EQUALS JUST TRUE
#ASSERT `s 487.3(2) the ground is one on which an order under subsection (1) may be made` `s 487.3(2)(b) any other sufficient reason` FALSE EQUALS NOTHING
#ASSERT `s 487.3(3) all documents relating to the application shall be placed in a packet, sealed and kept in the custody of the court` TRUE EQUALS JUST TRUE
#ASSERT `s 487.3(3) all documents relating to the application shall be placed in a packet, sealed and kept in the custody of the court` FALSE EQUALS JUST FALSE
#ASSERT `s 487.3(4) the application to terminate the order or vary its terms and conditions may be made to the judge` `s 487.3(4) the justice or judge who made the order` EQUALS JUST TRUE
#ASSERT `s 487.3(4) the application to terminate the order or vary its terms and conditions may be made to the judge` `s 487.3(4) a judge of the court before which any proceedings arising out of the investigation in relation to which the warrant or production order was obtained may be held` EQUALS JUST TRUE
#ASSERT `s 487.3(4) the application to terminate the order or vary its terms and conditions may be made to the judge` `s 487.3(4) someone else` EQUALS NOTHING
-- 488: by day unless all three limbs
#ASSERT `s 488 the warrant shall be executed by day` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 488 the warrant shall be executed by day` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 488 the warrant shall be executed by day` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 488 the warrant shall be executed by day` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 488 the warrant shall be executed by day` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 488 the warrant shall be executed by day` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- 488 at a time of day (minutes after midnight): noon is day; 5:00 and 22:00 are night; 6:00 and 21:00 are the end-points that section 2 leaves open
#ASSERT `s 488 the warrant may be executed at the time of day` 720 FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 488 the warrant may be executed at the time of day` 300 TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 488 the warrant may be executed at the time of day` 300 TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 488 the warrant may be executed at the time of day` 1320 FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 488 the warrant may be executed at the time of day` 1320 TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 488 the warrant may be executed at the time of day` 360 TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 488 the warrant may be executed at the time of day` 1260 TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 488 the warrant may be executed at the time of day` 1440 TRUE TRUE TRUE EQUALS NOTHING
