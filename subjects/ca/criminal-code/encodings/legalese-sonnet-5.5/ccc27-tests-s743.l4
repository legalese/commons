IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc27-length`
IMPORT `ccc27-s743-imprisonment`

-- ccc27-tests-s743.l4 -- tests for sections 743 to 744. Every expected value is written from the text, beside the assertion.

§ `Tests -- section 743`

#ASSERT `s 743 the maximum imprisonment for the offence` TRUE FALSE EQUALS JUST (`imprisonment for a term of` `five years`)   -- an indictable offence with no punishment specially provided
#ASSERT `s 743 the maximum imprisonment for the offence` TRUE TRUE EQUALS NOTHING   -- a punishment is specially provided
#ASSERT `s 743 the maximum imprisonment for the offence` FALSE FALSE EQUALS NOTHING   -- not an indictable offence
#ASSERT `s 743 the offender is liable to imprisonment for a term not exceeding five years` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 743 the offender is liable to imprisonment for a term not exceeding five years` TRUE TRUE EQUALS NOTHING
#ASSERT `s 743 the offender is liable to imprisonment for a term not exceeding five years` FALSE FALSE EQUALS NOTHING

§ `Tests -- section 743.1`

`s 743 test 1 year` MEANS `imprisonment for a term of` (`Length of time` OF 1, 0, 0, FALSE)
`s 743 test 2 years` MEANS `imprisonment for a term of` `two years`
`s 743 test 2 years less a day` MEANS `imprisonment for a term of` `two years less a day`
`s 743 test 3 years` MEANS `imprisonment for a term of` (`Length of time` OF 3, 0, 0, FALSE)

-- (1): life; two years or more; two or more terms under two years each, served consecutively, that in the aggregate are two years or more
#ASSERT `s 743.1(1) the person shall be sentenced to imprisonment in a penitentiary` FALSE `imprisonment for life` NOTHING EQUALS JUST TRUE   -- (a)
#ASSERT `s 743.1(1) the person shall be sentenced to imprisonment in a penitentiary` FALSE `s 743 test 3 years` NOTHING EQUALS JUST TRUE   -- (b)
#ASSERT `s 743.1(1) the person shall be sentenced to imprisonment in a penitentiary` FALSE `s 743 test 2 years` NOTHING EQUALS JUST TRUE   -- (b): exactly two years
#ASSERT `s 743.1(1) the person shall be sentenced to imprisonment in a penitentiary` FALSE `s 743 test 2 years less a day` NOTHING EQUALS JUST FALSE   -- two years less a day is under two years
#ASSERT `s 743.1(1) the person shall be sentenced to imprisonment in a penitentiary` FALSE `s 743 test 1 year` (JUST (`Length of time` OF 2, 6, 0, FALSE)) EQUALS JUST TRUE   -- (c): consecutive terms that add to two and a half years
#ASSERT `s 743.1(1) the person shall be sentenced to imprisonment in a penitentiary` FALSE `s 743 test 1 year` (JUST (`Length of time` OF 1, 6, 0, FALSE)) EQUALS JUST FALSE   -- (c): consecutive terms that add to eighteen months
#ASSERT `s 743.1(1) the person shall be sentenced to imprisonment in a penitentiary` FALSE `s 743 test 1 year` (JUST `two years`) EQUALS JUST TRUE   -- (c): exactly two years in the aggregate
#ASSERT `s 743.1(1) the person shall be sentenced to imprisonment in a penitentiary` FALSE `s 743 test 1 year` NOTHING EQUALS JUST FALSE   -- a single term under two years
#ASSERT `s 743.1(1) the person shall be sentenced to imprisonment in a penitentiary` TRUE `imprisonment for life` NOTHING EQUALS JUST FALSE   -- "Except where otherwise provided"
#ASSERT `s 743.1(1) the person shall be sentenced to imprisonment in a penitentiary` FALSE `no imprisonment is stated` NOTHING EQUALS NOTHING   -- no term is stated
#ASSERT `s 743.1(1) the person shall be sentenced to imprisonment in a penitentiary` FALSE `s 743 test 1 year` (JUST (`Length of time` OF 1, 11, 29, FALSE)) EQUALS NOTHING   -- the days of the aggregate might carry into a month
-- (2)
#ASSERT `s 743.1(2) the person shall serve that term in a penitentiary` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 743.1(2) the person shall serve that term in a penitentiary` TRUE TRUE TRUE EQUALS JUST FALSE   -- the previous sentence is set aside: "in accordance with subsection (3)"
#ASSERT `s 743.1(2) the person shall serve that term in a penitentiary` FALSE TRUE FALSE EQUALS JUST FALSE   -- not sentenced to a penitentiary
#ASSERT `s 743.1(2) the person shall serve that term in a penitentiary` TRUE FALSE FALSE EQUALS JUST FALSE   -- the later term is not a term of less than two years
-- (3)
#ASSERT `s 743.1(3) the person shall be sentenced to imprisonment in a prison or other place of confinement, other than a penitentiary` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 743.1(3) the person shall be sentenced to imprisonment in a prison or other place of confinement, other than a penitentiary` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE   -- required by subsection (1)
#ASSERT `s 743.1(3) the person shall be sentenced to imprisonment in a prison or other place of confinement, other than a penitentiary` TRUE (JUST FALSE) (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE   -- required by subsection (2)
#ASSERT `s 743.1(3) the person shall be sentenced to imprisonment in a prison or other place of confinement, other than a penitentiary` TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST FALSE   -- "Despite subsection (3)": subsection (3.1) requires a penitentiary
#ASSERT `s 743.1(3) the person shall be sentenced to imprisonment in a prison or other place of confinement, other than a penitentiary` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST FALSE   -- "unless a special prison is prescribed by law"
#ASSERT `s 743.1(3) the person shall be sentenced to imprisonment in a prison or other place of confinement, other than a penitentiary` FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE   -- not sentenced to imprisonment
#ASSERT `s 743.1(3) the person shall be sentenced to imprisonment in a prison or other place of confinement, other than a penitentiary` TRUE NOTHING (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING   -- subsection (1) is not decided
#ASSERT `s 743.1(3) the place of confinement is within the province in which the person is convicted, and the sentence may be lawfully executed there` `Ontario` `Ontario` TRUE EQUALS JUST TRUE
#ASSERT `s 743.1(3) the place of confinement is within the province in which the person is convicted, and the sentence may be lawfully executed there` `Ontario` `Quebec` TRUE EQUALS JUST FALSE   -- a place in another province
#ASSERT `s 743.1(3) the place of confinement is within the province in which the person is convicted, and the sentence may be lawfully executed there` `Ontario` `Ontario` FALSE EQUALS JUST FALSE   -- the sentence may not be lawfully executed there
-- (3.1)
#ASSERT `s 743.1(3.1) the offender shall be sentenced to imprisonment in a penitentiary` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 743.1(3.1) the offender shall be sentenced to imprisonment in a penitentiary` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 743.1(3.1) the offender shall be sentenced to imprisonment in a penitentiary` FALSE TRUE EQUALS JUST FALSE
-- (4)
#ASSERT `s 743.1(4) the person shall be sent immediately to the penitentiary and serve there the unexpired portion of the term being served as well as the new term` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 743.1(4) the person shall be sent immediately to the penitentiary and serve there the unexpired portion of the term being served as well as the new term` TRUE TRUE TRUE EQUALS JUST FALSE   -- "except where otherwise provided"
#ASSERT `s 743.1(4) the person shall be sent immediately to the penitentiary and serve there the unexpired portion of the term being served as well as the new term` TRUE FALSE FALSE EQUALS JUST FALSE   -- not lawfully imprisoned elsewhere
#ASSERT `s 743.1(4) the person shall be sent immediately to the penitentiary and serve there the unexpired portion of the term being served as well as the new term` FALSE TRUE FALSE EQUALS JUST FALSE   -- not sentenced to a penitentiary
-- (5)
#ASSERT `s 743.1(5) the person shall be transferred to a penitentiary to serve those terms` TRUE TRUE `two years` EQUALS JUST TRUE
#ASSERT `s 743.1(5) the person shall be transferred to a penitentiary to serve those terms` TRUE TRUE `two years less a day` EQUALS JUST FALSE
#ASSERT `s 743.1(5) the person shall be transferred to a penitentiary to serve those terms` TRUE TRUE (`Length of time` OF 1, 11, 29, FALSE) EQUALS NOTHING   -- days that might carry into a month
#ASSERT `s 743.1(5) the person shall be transferred to a penitentiary to serve those terms` FALSE TRUE `two years` EQUALS JUST FALSE   -- already in a penitentiary
#ASSERT `s 743.1(5) the person shall be transferred to a penitentiary to serve those terms` TRUE FALSE `two years` EQUALS JUST FALSE   -- not two or more terms to be served one after the other
#ASSERT `s 743.1(5) the person shall serve the remaining terms in accordance with subsection (3)` TRUE `two years less a day` EQUALS JUST TRUE   -- a term set aside, and the rest are under two years
#ASSERT `s 743.1(5) the person shall serve the remaining terms in accordance with subsection (3)` TRUE `two years` EQUALS JUST FALSE
#ASSERT `s 743.1(5) the person shall serve the remaining terms in accordance with subsection (3)` FALSE `two years less a day` EQUALS JUST FALSE   -- no term set aside or reduced
#ASSERT `s 743.1(5) the person shall serve the remaining terms in accordance with subsection (3)` TRUE (`Length of time` OF 1, 11, 29, FALSE) EQUALS NOTHING
-- (6): the "until" bar
#ASSERT `s 743.1(6) the facility is left out of "penitentiary" for the purposes of subsection (3)` TRUE `s 743.1(6) before the day fixed by order of the Governor in Council` EQUALS JUST TRUE
#ASSERT `s 743.1(6) the facility is left out of "penitentiary" for the purposes of subsection (3)` TRUE `s 743.1(6) on or after the day fixed by order of the Governor in Council` EQUALS JUST FALSE
#ASSERT `s 743.1(6) the facility is left out of "penitentiary" for the purposes of subsection (3)` FALSE `s 743.1(6) before the day fixed by order of the Governor in Council` EQUALS NOTHING   -- some other facility

§ `Tests -- sections 743.2 to 743.5`

#ASSERT `s 743.2 the court has forwarded to the Correctional Service of Canada what the section requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 743.2 the court has forwarded to the Correctional Service of Canada what the section requires` TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- no reasons and recommendation
#ASSERT `s 743.2 the court has forwarded to the Correctional Service of Canada what the section requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- no reports
#ASSERT `s 743.2 the court has forwarded to the Correctional Service of Canada what the section requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- no other information
#ASSERT `s 743.2 the court has forwarded to the Correctional Service of Canada what the section requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- the court did not sentence or commit a person to penitentiary
#TRACE `s 743.2 the court shall forward the reasons, recommendation, reports and information` AT 0 WITH
    PARTY `the court` DOES `s 743.2 forward the reasons, recommendation, reports and information` AT 5
-- 743.21
#ASSERT `s 743.21(1) the sentencing judge may issue an order prohibiting the offender from communicating with any victim, witness or other person identified in the order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 743.21(1) the sentencing judge may issue an order prohibiting the offender from communicating with any victim, witness or other person identified in the order` FALSE TRUE EQUALS NOTHING   -- not the sentencing judge
#ASSERT `s 743.21(1) the sentencing judge may issue an order prohibiting the offender from communicating with any victim, witness or other person identified in the order` TRUE FALSE EQUALS NOTHING   -- not limited to the custodial period
#ASSERT `s 743.21(1) the offender is barred from communicating with the person` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 743.21(1) the offender is barred from communicating with the person` FALSE TRUE TRUE FALSE EQUALS JUST FALSE   -- no order
#ASSERT `s 743.21(1) the offender is barred from communicating with the person` TRUE FALSE TRUE FALSE EQUALS NOTHING   -- not a person the order identifies
#ASSERT `s 743.21(1) the offender is barred from communicating with the person` TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- after the custodial period
#ASSERT `s 743.21(1) the offender is barred from communicating with the person` TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- "except in accordance with any conditions specified in the order"
#ASSERT `s 743.21(2) the person is guilty of an offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 743.21(2) the person is guilty of an offence` TRUE TRUE EQUALS JUST FALSE   -- a lawful excuse
#ASSERT `s 743.21(2) the person is guilty of an offence` FALSE FALSE EQUALS JUST FALSE   -- no failure to comply
#ASSERT `s 743.21(2) the punishment` `by indictment` EQUALS Punishment OF `by indictment`, (`imprisonment for a term of` `two years`), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
#ASSERT (`s 743.21(2) the punishment` `on summary conviction`)'s `maximum imprisonment` EQUALS `no imprisonment is stated`   -- no maximum stated in this range; section 787 is outside it
-- 743.3
#ASSERT `s 743.3 the sentence is served as the section requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 743.3 the sentence is served as the section requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 743.3 the sentence is served as the section requires` FALSE TRUE EQUALS NOTHING   -- not a sentence of imprisonment
-- 743.5
#ASSERT `s 743.5(1) the remaining portion of the disposition or youth sentence is dealt with as if it had been a sentence imposed under this Act` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 743.5(1) the remaining portion of the disposition or youth sentence is dealt with as if it had been a sentence imposed under this Act` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 743.5(1) the remaining portion of the disposition or youth sentence is dealt with as if it had been a sentence imposed under this Act` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 743.5(2) the disposition or youth sentence is dealt with as if it had been a sentence imposed under this Act` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 743.5(2) the disposition or youth sentence is dealt with as if it had been a sentence imposed under this Act` TRUE FALSE EQUALS JUST FALSE   -- not under a sentence of imprisonment imposed under an Act other than the YCJA
#ASSERT `s 743.5(3) the combination is deemed to constitute one sentence of imprisonment` `s 743.5(3)(a) the remainder of the youth sentence or disposition and the subsequent term of imprisonment, for the purposes of subsection (1)` TRUE EQUALS JUST TRUE
#ASSERT `s 743.5(3) the combination is deemed to constitute one sentence of imprisonment` `s 743.5(3)(b) the term of imprisonment and the subsequent youth sentence or disposition, for the purposes of subsection (2)` TRUE EQUALS JUST TRUE
#ASSERT `s 743.5(3) the combination is deemed to constitute one sentence of imprisonment` `s 743.5(3) any other combination` TRUE EQUALS NOTHING
#ASSERT `s 743.5(3) the combination is deemed to constitute one sentence of imprisonment` `s 743.5(3)(a) the remainder of the youth sentence or disposition and the subsequent term of imprisonment, for the purposes of subsection (1)` FALSE EQUALS NOTHING   -- for another purpose

§ `Tests -- section 743.6`

`s 743 test 743.6 offence 467.11` MEANS `Provision of the Code` OF 467.11, ""
`s 743 test 743.6 offence 467.111` MEANS `Provision of the Code` OF 467.111, ""
`s 743 test 743.6 offence 467.12` MEANS `Provision of the Code` OF 467.12, ""
`s 743 test 743.6 offence 467.13` MEANS `Provision of the Code` OF 467.13, ""
`s 743 test 743.6 offence other` MEANS `Provision of the Code` OF 334, ""

-- the sentence test: two years or more, life imposed otherwise than as a minimum punishment
#ASSERT `s 743.6 the sentence is of two years or more, including life imposed otherwise than as a minimum punishment` `s 743 test 3 years` FALSE EQUALS JUST TRUE
#ASSERT `s 743.6 the sentence is of two years or more, including life imposed otherwise than as a minimum punishment` `s 743 test 2 years` FALSE EQUALS JUST TRUE
#ASSERT `s 743.6 the sentence is of two years or more, including life imposed otherwise than as a minimum punishment` `s 743 test 2 years less a day` FALSE EQUALS JUST FALSE
#ASSERT `s 743.6 the sentence is of two years or more, including life imposed otherwise than as a minimum punishment` `imprisonment for life` FALSE EQUALS JUST TRUE
#ASSERT `s 743.6 the sentence is of two years or more, including life imposed otherwise than as a minimum punishment` `imprisonment for life` TRUE EQUALS JUST FALSE   -- life imposed as a minimum punishment
#ASSERT `s 743.6 the sentence is of two years or more, including life imposed otherwise than as a minimum punishment` `no imprisonment is stated` FALSE EQUALS NOTHING
-- (1)
#ASSERT `s 743.6(1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` (Date 1 11 1992) `s 743 test 3 years` FALSE TRUE `by indictment` TRUE EQUALS JUST TRUE   -- sentenced on 1 November 1992
#ASSERT `s 743.6(1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` (Date 31 10 1992) `s 743 test 3 years` FALSE TRUE `by indictment` TRUE EQUALS JUST FALSE   -- sentenced a day before: "on or after November 1, 1992"
#ASSERT `s 743.6(1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` (Date 1 1 2020) `imprisonment for life` FALSE TRUE `by indictment` TRUE EQUALS JUST TRUE
#ASSERT `s 743.6(1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` (Date 1 1 2020) `imprisonment for life` TRUE TRUE `by indictment` TRUE EQUALS JUST FALSE   -- life imposed as a minimum punishment
#ASSERT `s 743.6(1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` (Date 1 1 2020) `s 743 test 1 year` FALSE TRUE `by indictment` TRUE EQUALS JUST FALSE   -- a sentence under two years
#ASSERT `s 743.6(1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` (Date 1 1 2020) `s 743 test 3 years` FALSE FALSE `by indictment` TRUE EQUALS JUST FALSE   -- not an offence in Schedule I or II
#ASSERT `s 743.6(1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` (Date 1 1 2020) `s 743 test 3 years` FALSE TRUE `on summary conviction` TRUE EQUALS JUST FALSE   -- not prosecuted by way of indictment
#ASSERT `s 743.6(1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` (Date 1 1 2020) `s 743 test 3 years` FALSE TRUE `by indictment` FALSE EQUALS NOTHING   -- the court is not satisfied that denunciation or deterrence requires it (F-2)
#ASSERT `s 743.6(1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` (Date 1 1 2020) `no imprisonment is stated` FALSE TRUE `by indictment` TRUE EQUALS NOTHING   -- no term stated
-- (1.1)
#ASSERT `s 743.6(1.1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` FALSE (JUST TRUE) `s 743 test 743.6 offence other` EQUALS JUST TRUE
#ASSERT `s 743.6(1.1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` FALSE (JUST TRUE) `s 743 test 743.6 offence 467.11` EQUALS JUST FALSE   -- "other than an offence under section 467.11"
#ASSERT `s 743.6(1.1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` FALSE (JUST TRUE) `s 743 test 743.6 offence 467.111` EQUALS JUST FALSE
#ASSERT `s 743.6(1.1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` FALSE (JUST TRUE) `s 743 test 743.6 offence 467.12` EQUALS JUST FALSE
#ASSERT `s 743.6(1.1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` FALSE (JUST TRUE) `s 743 test 743.6 offence 467.13` EQUALS JUST FALSE
#ASSERT `s 743.6(1.1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` FALSE (JUST FALSE) `s 743 test 743.6 offence other` EQUALS JUST FALSE   -- not a criminal organization offence
#ASSERT `s 743.6(1.1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` FALSE NOTHING `s 743 test 743.6 offence other` EQUALS NOTHING   -- section 2 does not decide
#ASSERT `s 743.6(1.1) the court may order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 1 year` FALSE (JUST TRUE) `s 743 test 743.6 offence other` EQUALS JUST FALSE   -- under two years
-- (1.2)
#ASSERT `s 743.6(1.2) the court shall order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` (JUST TRUE) `s 743 test 743.6 offence other` FALSE EQUALS JUST TRUE   -- a terrorism offence
#ASSERT `s 743.6(1.2) the court shall order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` (JUST FALSE) `s 743 test 743.6 offence 467.11` FALSE EQUALS JUST TRUE   -- an offence under section 467.11
#ASSERT `s 743.6(1.2) the court shall order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` (JUST FALSE) `s 743 test 743.6 offence 467.13` FALSE EQUALS JUST TRUE
#ASSERT `s 743.6(1.2) the court shall order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` (JUST FALSE) `s 743 test 743.6 offence other` FALSE EQUALS JUST FALSE   -- neither a terrorism offence nor an offence under section 467.11 and the three after it
#ASSERT `s 743.6(1.2) the court shall order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` (JUST TRUE) `s 743 test 743.6 offence other` TRUE EQUALS JUST FALSE   -- "unless the court is satisfied ... adequately served"
#ASSERT `s 743.6(1.2) the court shall order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `imprisonment for life` (JUST TRUE) `s 743 test 743.6 offence other` FALSE EQUALS JUST TRUE   -- life, whether or not a minimum punishment
#ASSERT `s 743.6(1.2) the court shall order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 1 year` (JUST TRUE) `s 743 test 743.6 offence other` FALSE EQUALS JUST FALSE   -- under two years
#ASSERT `s 743.6(1.2) the court shall order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` NOTHING `s 743 test 743.6 offence other` FALSE EQUALS NOTHING   -- section 2 does not decide whether it is a terrorism offence
#ASSERT `s 743.6(1.2) the court shall order that the portion of the sentence that must be served before the offender may be released on full parole is one half of the sentence or ten years, whichever is less` `s 743 test 3 years` NOTHING `s 743 test 743.6 offence 467.12` FALSE EQUALS JUST TRUE   -- in the list, so the terrorism question does not arise
-- (2)
#ASSERT `s 743.6(2) the principle is one of the paramount principles that guide the court under section 743.6` `s 743.6(2) denunciation` EQUALS JUST TRUE
#ASSERT `s 743.6(2) the principle is one of the paramount principles that guide the court under section 743.6` `s 743.6(2) specific deterrence` EQUALS JUST TRUE
#ASSERT `s 743.6(2) the principle is one of the paramount principles that guide the court under section 743.6` `s 743.6(2) general deterrence` EQUALS JUST TRUE
#ASSERT `s 743.6(2) the principle is one of the paramount principles that guide the court under section 743.6` `s 743.6(2) rehabilitation of the offender` EQUALS JUST FALSE   -- "being subordinate to these paramount principles"
#ASSERT `s 743.6(2) the principle is one of the paramount principles that guide the court under section 743.6` `s 743.6(2) another principle` EQUALS NOTHING
-- the months
#ASSERT `s 743.6 the months of the sentence that must be served before the offender may be released on full parole under the order` `s 743 test 3 years` EQUALS JUST 18   -- one half of 36 months
#ASSERT `s 743.6 the months of the sentence that must be served before the offender may be released on full parole under the order` `s 743 test 2 years` EQUALS JUST 12
#ASSERT `s 743.6 the months of the sentence that must be served before the offender may be released on full parole under the order` (`imprisonment for a term of` `ten years`) EQUALS JUST 60
#ASSERT `s 743.6 the months of the sentence that must be served before the offender may be released on full parole under the order` (`imprisonment for a term of` (`Length of time` OF 20, 0, 0, FALSE)) EQUALS JUST 120   -- half of 20 years is 10 years: the limit "ten years"
#ASSERT `s 743.6 the months of the sentence that must be served before the offender may be released on full parole under the order` (`imprisonment for a term of` (`Length of time` OF 25, 0, 0, FALSE)) EQUALS JUST 120   -- half would be 150 months: ten years is less
#ASSERT `s 743.6 the months of the sentence that must be served before the offender may be released on full parole under the order` `imprisonment for life` EQUALS JUST 120
#ASSERT `s 743.6 the months of the sentence that must be served before the offender may be released on full parole under the order` (`imprisonment for a term of` (`Length of time` OF 3, 0, 10, FALSE)) EQUALS NOTHING   -- days are not converted
#ASSERT `s 743.6 the months of the sentence that must be served before the offender may be released on full parole under the order` `no imprisonment is stated` EQUALS NOTHING
-- the seam for sections 675 and 676
#ASSERT `s 743.6 the court ordered a delay in eligibility for parole` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 743.6 the court ordered a delay in eligibility for parole` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 743.6 the court ordered a delay in eligibility for parole` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 743.6 the court ordered a delay in eligibility for parole` (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE   -- one order is enough
#ASSERT `s 743.6 the court ordered a delay in eligibility for parole` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- none of the three orders was made
#ASSERT `s 743.6 the court ordered a delay in eligibility for parole` (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING   -- one of the three is not known

§ `Tests -- section 744`

#ASSERT `s 744 the peace officer or other person shall arrest the person named or described in the warrant` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 744 the peace officer or other person shall arrest the person named or described in the warrant` TRUE FALSE EQUALS JUST FALSE   -- "if it is necessary to do so": the person is already in custody
#ASSERT `s 744 the peace officer or other person shall arrest the person named or described in the warrant` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 744 the peace officer or other person shall convey the person to the prison mentioned in the warrant and deliver the person, together with the warrant, to the keeper of the prison` TRUE EQUALS JUST TRUE
#ASSERT `s 744 the peace officer or other person shall convey the person to the prison mentioned in the warrant and deliver the person, together with the warrant, to the keeper of the prison` FALSE EQUALS JUST FALSE
#ASSERT `s 744 the keeper of the prison shall give a receipt in Form 43` TRUE EQUALS JUST TRUE
#ASSERT `s 744 the keeper of the prison shall give a receipt in Form 43` FALSE EQUALS JUST FALSE
#TRACE `s 744 the peace officer or other person shall deliver the person to the keeper of the prison, and the keeper shall give a receipt` AT 0 WITH
    PARTY `a peace officer` DOES `s 744 convey the person to the prison mentioned in the warrant and deliver the person, with the warrant, to the keeper of the prison` AT 1
    PARTY `the keeper of a prison` DOES `s 744 give a receipt in Form 43` AT 1
