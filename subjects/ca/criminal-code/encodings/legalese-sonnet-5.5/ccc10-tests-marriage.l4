IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc10-marriage`

-- ccc10-tests-marriage.l4 -- tests for ccc10-marriage.l4 (ss 287 to 296). Expected values are written by hand from the text, beside each assertion.

`s 291 fixture: the general summary conviction penalty` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
GIVEN maximum IS A `Length of time`
GIVETH A Punishment
`s 291 fixture: on indictment at most` MEANS Punishment OF `by indictment`, (`imprisonment for a term of` maximum), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `ss 287 to 289 and 296 -- repealed in this text`

#ASSERT `s 287 as the text shows it` EQUALS "[Repealed, 2019, c. 25, s. 111]"   -- line 5847
#ASSERT `s 288 as the text shows it` EQUALS "[Repealed, 2018, c. 29, s. 28]"   -- line 5848
#ASSERT `s 289 as the text shows it` EQUALS "[Repealed, R.S., 1985, c. 27 (1st Supp.), s. 41]"   -- line 5851
#ASSERT `s 296 as the text shows it` EQUALS "[Repealed, 2018, c. 29, s. 30]"   -- line 5909

§ `s 290 -- Bigamy`

-- Argument order of (1): acts in Canada; (a)(i) being married, a form of marriage; (a)(ii) knowing another is married; (a)(iii) the same day or simultaneously; (b) Canadian citizen resident in Canada; leaves with intent; pursuant, does outside Canada.
#ASSERT `s 290(1) the person commits bigamy` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a)(i)
#ASSERT `s 290(1) the person commits bigamy` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a)(ii)
#ASSERT `s 290(1) the person commits bigamy` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a)(iii)
#ASSERT `s 290(1) the person commits bigamy` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- in Canada, but none of (i) to (iii)
#ASSERT `s 290(1) the person commits bigamy` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- not in Canada and not (b)
#ASSERT `s 290(1) the person commits bigamy` FALSE FALSE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE   -- (b): a citizen resident in Canada leaves with intent and does it outside
#ASSERT `s 290(1) the person commits bigamy` FALSE FALSE FALSE FALSE TRUE TRUE FALSE EQUALS NOTHING   -- (b): has not done it outside Canada
#ASSERT `s 290(1) the person commits bigamy` FALSE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS NOTHING   -- (b): no intent on leaving
#ASSERT `s 290(1) the person commits bigamy` FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS NOTHING   -- (b): not a Canadian citizen resident in Canada
-- Argument order of (2): believes the spouse is dead (good faith, reasonable grounds); the day the spouse's continuous absence began; the day of the form of marriage; knew the spouse was alive in those seven years; divorced; the former marriage declared void.
#ASSERT `s 290(2) the person does not commit bigamy by going through the form of marriage` TRUE (Date 1 1 2020) (Date 1 1 2021) FALSE FALSE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 290(2) the person does not commit bigamy by going through the form of marriage` FALSE (Date 1 3 2010) (Date 1 3 2017) FALSE FALSE FALSE EQUALS JUST TRUE   -- (b): absent exactly seven years
#ASSERT `s 290(2) the person does not commit bigamy by going through the form of marriage` FALSE (Date 1 3 2010) (Date 28 2 2017) FALSE FALSE FALSE EQUALS JUST FALSE   -- (b): a day short of seven years
#ASSERT `s 290(2) the person does not commit bigamy by going through the form of marriage` FALSE (Date 1 3 2010) (Date 1 3 2017) TRUE FALSE FALSE EQUALS JUST FALSE   -- (b): "unless he knew that his spouse was alive"
#ASSERT `s 290(2) the person does not commit bigamy by going through the form of marriage` FALSE (Date 1 3 2010) (Date 1 3 2020) FALSE FALSE FALSE EQUALS JUST TRUE   -- (b): ten years absent
#ASSERT `s 290(2) the person does not commit bigamy by going through the form of marriage` FALSE (Date 1 1 2020) (Date 1 1 2021) FALSE TRUE FALSE EQUALS JUST TRUE   -- (c): divorced from the bond of the first marriage
#ASSERT `s 290(2) the person does not commit bigamy by going through the form of marriage` FALSE (Date 1 1 2020) (Date 1 1 2021) FALSE FALSE TRUE EQUALS JUST TRUE   -- (d): the former marriage declared void
#ASSERT `s 290(2) the person does not commit bigamy by going through the form of marriage` FALSE (Date 1 1 2020) (Date 1 1 2021) FALSE FALSE FALSE EQUALS JUST FALSE   -- none of (a) to (d): this section gives no defence on these facts
#ASSERT `s 290(2) the person does not commit bigamy by going through the form of marriage` TRUE (Date 1 3 2010) (Date 1 3 2017) TRUE FALSE FALSE EQUALS JUST TRUE   -- (a) holds although (b) is lost by knowledge
#ASSERT `s 290 the person commits bigamy after the matters of defence` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- no matter of defence
#ASSERT `s 290 the person commits bigamy after the matters of defence` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE   -- "No person commits bigamy by going through a form of marriage if"
#ASSERT `s 290 the person commits bigamy after the matters of defence` (JUST TRUE) NOTHING EQUALS NOTHING   -- defence not determined
#ASSERT `s 290 the person commits bigamy after the matters of defence` NOTHING (JUST FALSE) EQUALS NOTHING   -- offence not determined
#ASSERT `s 290 the person commits bigamy after the matters of defence` NOTHING (JUST TRUE) EQUALS JUST FALSE   -- a matter of defence applies whatever (1) says
#ASSERT `s 290(3) the incompetence of the parties to contract marriage is a defence` TRUE TRUE EQUALS JUST FALSE   -- "it is not a defence"
#ASSERT `s 290(3) the incompetence of the parties to contract marriage is a defence` TRUE FALSE EQUALS NOTHING   -- no such incompetence
#ASSERT `s 290(3) the incompetence of the parties to contract marriage is a defence` FALSE TRUE EQUALS NOTHING   -- no allegation of bigamy
#ASSERT `s 290(4) the marriage or form of marriage is deemed to be valid` FALSE EQUALS JUST TRUE   -- not shown invalid: deemed valid
#ASSERT `s 290(4) the marriage or form of marriage is deemed to be valid` TRUE EQUALS JUST FALSE   -- "unless the accused establishes that it was invalid"
#ASSERT `s 290(5) an act or omission of the accused invalidates the marriage or form of marriage` TRUE TRUE TRUE EQUALS JUST FALSE   -- "No act or omission ... invalidates"
#ASSERT `s 290(5) an act or omission of the accused invalidates the marriage or form of marriage` FALSE TRUE TRUE EQUALS NOTHING   -- not charged with bigamy
#ASSERT `s 290(5) an act or omission of the accused invalidates the marriage or form of marriage` TRUE FALSE TRUE EQUALS NOTHING   -- not otherwise valid
#ASSERT `s 290(5) an act or omission of the accused invalidates the marriage or form of marriage` TRUE TRUE FALSE EQUALS NOTHING   -- not an act or omission of the accused

§ `s 291 -- Punishment of bigamy`

#ASSERT `s 291(1) the person who commits bigamy is guilty of the offence` (JUST TRUE) EQUALS JUST TRUE   -- "Every person who commits bigamy is guilty of"
#ASSERT `s 291(1) the person who commits bigamy is guilty of the offence` (JUST FALSE) EQUALS NOTHING   -- not bigamy under s 290
#ASSERT `s 291(1) the person who commits bigamy is guilty of the offence` NOTHING EQUALS NOTHING   -- s 290 not determined
#ASSERT `s 291(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 291(1) the punishment` `by indictment` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: on indictment at most` `five years`   -- (a): "not more than five years"
#ASSERT `s 291(1) the punishment` `on summary conviction` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: the general summary conviction penalty`   -- (b): s 787(1)
#ASSERT `s 291(2) the certificate of marriage is evidence of the marriage or form of marriage without proof of the signature or official character of the signer` TRUE EQUALS JUST TRUE   -- a certificate issued under the authority of law
#ASSERT `s 291(2) the certificate of marriage is evidence of the marriage or form of marriage without proof of the signature or official character of the signer` FALSE EQUALS NOTHING   -- another document

§ `s 292 -- Procuring feigned marriage`

#ASSERT `s 292(1) the person is guilty of the offence of procuring a feigned marriage` TRUE FALSE EQUALS JUST TRUE   -- procures
#ASSERT `s 292(1) the person is guilty of the offence of procuring a feigned marriage` FALSE TRUE EQUALS JUST TRUE   -- knowingly aids in procuring
#ASSERT `s 292(1) the person is guilty of the offence of procuring a feigned marriage` FALSE FALSE EQUALS NOTHING   -- neither
#ASSERT `s 292(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 292(1) the punishment` `by indictment` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: on indictment at most` `five years`   -- (a)
#ASSERT `s 292(1) the punishment` `on summary conviction` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: the general summary conviction penalty`   -- (b)
#ASSERT `s 292(2) the person may not be convicted of an offence under section 292 on the evidence` TRUE FALSE EQUALS JUST TRUE   -- one witness, uncorroborated
#ASSERT `s 292(2) the person may not be convicted of an offence under section 292 on the evidence` TRUE TRUE EQUALS JUST FALSE   -- "unless the evidence of that witness is corroborated in a material particular"
#ASSERT `s 292(2) the person may not be convicted of an offence under section 292 on the evidence` FALSE FALSE EQUALS NOTHING   -- more than one witness: outside "only one witness"
#ASSERT `s 292(2) the person may not be convicted of an offence under section 292 on the evidence` FALSE TRUE EQUALS NOTHING   -- more than one witness

§ `ss 293 to 293.2 -- Polygamy, forced marriage and marriage under age 16`

#ASSERT `s 293(1) the person is guilty of the offence of polygamy` TRUE FALSE EQUALS JUST TRUE   -- (a): practises or enters into polygamy
#ASSERT `s 293(1) the person is guilty of the offence of polygamy` FALSE TRUE EQUALS JUST TRUE   -- (b): celebrates, assists or is a party to a rite
#ASSERT `s 293(1) the person is guilty of the offence of polygamy` FALSE FALSE EQUALS NOTHING   -- neither
#ASSERT `s 293(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- "indictable ... or ... summary conviction"
#ASSERT `s 293(1) the punishment` `by indictment` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: on indictment at most` `five years`   -- "not more than five years"
#ASSERT `s 293(1) the punishment` `on summary conviction` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: the general summary conviction penalty`   -- summary
#ASSERT `s 293(2) averment or proof of the method by which the relationship was entered into is necessary` TRUE EQUALS JUST FALSE   -- "no averment or proof ... is necessary"
#ASSERT `s 293(2) averment or proof of the method by which the relationship was entered into is necessary` FALSE EQUALS NOTHING   -- another charge
#ASSERT `s 293(2) proof that the persons had or intended to have sexual intercourse is necessary` TRUE EQUALS JUST FALSE   -- "nor is it necessary on the trial to prove"
#ASSERT `s 293(2) proof that the persons had or intended to have sexual intercourse is necessary` FALSE EQUALS NOTHING   -- another charge
#ASSERT `s 293.1 the person is guilty of the offence of forced marriage` TRUE TRUE EQUALS JUST TRUE   -- celebrates, knowing
#ASSERT `s 293.1 the person is guilty of the offence of forced marriage` TRUE FALSE EQUALS NOTHING   -- no knowledge
#ASSERT `s 293.1 the person is guilty of the offence of forced marriage` FALSE TRUE EQUALS NOTHING   -- no participation
#ASSERT `s 293.1 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 293.1 the punishment` `by indictment` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: on indictment at most` `five years`   -- (a)
#ASSERT `s 293.1 the punishment` `on summary conviction` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: the general summary conviction penalty`   -- (b)
#ASSERT `s 293.2 the person is guilty of the offence of marriage under the age of 16 years` TRUE TRUE EQUALS JUST TRUE   -- celebrates, knowing one is under 16
#ASSERT `s 293.2 the person is guilty of the offence of marriage under the age of 16 years` TRUE FALSE EQUALS NOTHING   -- no knowledge
#ASSERT `s 293.2 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 293.2 the punishment` `by indictment` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: on indictment at most` `five years`   -- (a)
#ASSERT `s 293.2 the punishment` `on summary conviction` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: the general summary conviction penalty`   -- (b)

§ `ss 294 to 296 -- Unlawful solemnization of marriage`

#ASSERT `s 294 the person is guilty of the offence of pretending to solemnize marriage` TRUE FALSE EQUALS JUST TRUE   -- (a): solemnizes or pretends without lawful authority
#ASSERT `s 294 the person is guilty of the offence of pretending to solemnize marriage` FALSE TRUE EQUALS JUST TRUE   -- (b): procures a person to solemnize
#ASSERT `s 294 the person is guilty of the offence of pretending to solemnize marriage` FALSE FALSE EQUALS NOTHING   -- neither
#ASSERT `s 294 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- "indictable ... or ... summary conviction"
#ASSERT `s 294 the punishment` `by indictment` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: on indictment at most` `two years`   -- "not more than two years"
#ASSERT `s 294 the punishment` `on summary conviction` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: the general summary conviction penalty`   -- summary
#ASSERT `s 295 the person is guilty of the offence of solemnizing a marriage contrary to law` TRUE TRUE EQUALS JUST TRUE   -- authorized, knowingly solemnizes contrary to law
#ASSERT `s 295 the person is guilty of the offence of solemnizing a marriage contrary to law` FALSE TRUE EQUALS NOTHING   -- not lawfully authorized: section 294 instead
#ASSERT `s 295 the person is guilty of the offence of solemnizing a marriage contrary to law` TRUE FALSE EQUALS NOTHING   -- not knowingly contrary to law
#ASSERT `s 295 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 295 the punishment` `by indictment` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: on indictment at most` `two years`   -- (a): "not more than two years"
#ASSERT `s 295 the punishment` `on summary conviction` `s 291 fixture: the general summary conviction penalty` EQUALS `s 291 fixture: the general summary conviction penalty`   -- (b)
