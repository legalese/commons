§ `s 320.22: the scope (sections 320.13 to 320.18, tested by section number) and the seven paragraphs`
#ASSERT `s 320.22 the sentence is for an offence under any of sections 320.13 to 320.18` (`Provision of the Code` OF 320.13, "(1)") EQUALS (JUST TRUE)   -- the first section of the range
#ASSERT `s 320.22 the sentence is for an offence under any of sections 320.13 to 320.18` (`Provision of the Code` OF 320.18, "(1)") EQUALS (JUST TRUE)   -- the last section of the range
#ASSERT `s 320.22 the sentence is for an offence under any of sections 320.13 to 320.18` (`Provision of the Code` OF 320.15, "(2)") EQUALS (JUST TRUE)   -- inside the range
#ASSERT `s 320.22 the sentence is for an offence under any of sections 320.13 to 320.18` (`Provision of the Code` OF 320.17, "") EQUALS (JUST TRUE)   -- inside the range
#ASSERT `s 320.22 the sentence is for an offence under any of sections 320.13 to 320.18` (`Provision of the Code` OF 320.12, "") EQUALS NOTHING   -- just before the range: a scope limit with no "only": not covered
#ASSERT `s 320.22 the sentence is for an offence under any of sections 320.13 to 320.18` (`Provision of the Code` OF 320.19, "(1)") EQUALS NOTHING   -- just after 320.18 in the Code's order
#ASSERT `s 320.22 the sentence is for an offence under any of sections 320.13 to 320.18` (`Provision of the Code` OF 320.2, "") EQUALS NOTHING   -- 320.2 sorts after 320.19
#ASSERT `s 320.22(a) the court shall consider that the offence resulted in bodily harm to, or the death of, more than one person` (JUST TRUE) TRUE EQUALS (JUST TRUE)   -- more than one person harmed or killed
#ASSERT `s 320.22(a) the court shall consider that the offence resulted in bodily harm to, or the death of, more than one person` (JUST TRUE) FALSE EQUALS (JUST FALSE)   -- not present
#ASSERT `s 320.22(a) the court shall consider that the offence resulted in bodily harm to, or the death of, more than one person` NOTHING TRUE EQUALS NOTHING   -- the offence is outside the scope: not covered
#ASSERT `s 320.22(b) the court shall consider that the offender was operating a motor vehicle in a race or contest of speed in a public place` (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS (JUST TRUE)   -- a race or contest of speed in a public place in a motor vehicle
#ASSERT `s 320.22(b) the court shall consider that the offender was operating a motor vehicle in a race or contest of speed in a public place` (JUST TRUE) (JUST TRUE) FALSE TRUE EQUALS (JUST FALSE)   -- no race or contest of speed
#ASSERT `s 320.22(b) the court shall consider that the offender was operating a motor vehicle in a race or contest of speed in a public place` (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS (JUST FALSE)   -- not on a street, road, highway or other public place
#ASSERT `s 320.22(b) the court shall consider that the offender was operating a motor vehicle in a race or contest of speed in a public place` (JUST TRUE) NOTHING TRUE TRUE EQUALS NOTHING   -- whether it was a motor vehicle is not covered
#ASSERT `s 320.22(b) the court shall consider that the offender was operating a motor vehicle in a race or contest of speed in a public place` (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS (JUST FALSE)   -- not a motor vehicle
#ASSERT `s 320.22(c) the court shall consider that a person under the age of 16 years was a passenger in the conveyance` (JUST TRUE) TRUE EQUALS (JUST TRUE)   -- a passenger under 16
#ASSERT `s 320.22(c) the court shall consider that a person under the age of 16 years was a passenger in the conveyance` (JUST TRUE) FALSE EQUALS (JUST FALSE)   -- no such passenger
#ASSERT `s 320.22(d) the court shall consider that the offender was being remunerated for operating the conveyance` (JUST TRUE) TRUE EQUALS (JUST TRUE)   -- remunerated
#ASSERT `s 320.22(d) the court shall consider that the offender was being remunerated for operating the conveyance` (JUST TRUE) FALSE EQUALS (JUST FALSE)   -- not remunerated
#ASSERT `s 320.22(e) the court shall consider that the offender’s blood alcohol concentration at the time of committing the offence was 120 mg or more` (JUST TRUE) 120 EQUALS (JUST TRUE)   -- exactly 120: "equal to or exceeded 120"
#ASSERT `s 320.22(e) the court shall consider that the offender’s blood alcohol concentration at the time of committing the offence was 120 mg or more` (JUST TRUE) 119.9 EQUALS (JUST FALSE)   -- below 120
#ASSERT `s 320.22(e) the court shall consider that the offender’s blood alcohol concentration at the time of committing the offence was 120 mg or more` (JUST TRUE) 200 EQUALS (JUST TRUE)   -- above
#ASSERT `s 320.22(e) the court shall consider that the offender’s blood alcohol concentration at the time of committing the offence was 120 mg or more` NOTHING 200 EQUALS NOTHING   -- outside the scope
#ASSERT `s 320.22(f) the court shall consider that the offender was operating a large motor vehicle` (JUST TRUE) TRUE EQUALS (JUST TRUE)   -- a large motor vehicle
#ASSERT `s 320.22(f) the court shall consider that the offender was operating a large motor vehicle` (JUST TRUE) FALSE EQUALS (JUST FALSE)   -- not
#ASSERT `s 320.22(g) the court shall consider that the offender was not permitted under a federal or provincial Act to operate the conveyance` (JUST TRUE) TRUE EQUALS (JUST TRUE)   -- not permitted to operate the conveyance
#ASSERT `s 320.22(g) the court shall consider that the offender was not permitted under a federal or provincial Act to operate the conveyance` (JUST TRUE) FALSE EQUALS (JUST FALSE)   -- permitted
#ASSERT `s 320.22 the paragraphs of section 320.22 that apply` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS LIST "(a)", "(c)", "(e)", "(g)"   -- the paragraphs that hold, in order
#ASSERT `s 320.22 the paragraphs of section 320.22 that apply` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS EMPTY   -- none
#ASSERT `s 320.22 the paragraphs of section 320.22 that apply` NOTHING (JUST TRUE) (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS LIST "(b)"   -- a not-covered paragraph is not listed
#ASSERT `s 320.22 the court shall consider the aggravating circumstances` FALSE EQUALS FULFILLED   -- no sentence for an offence of 320.13 to 320.18: no duty arises, so FULFILLED
-- The duty as a regulative rule (320.22: "shall consider"): a trace is printed, not asserted (the stable binary cannot compare an open obligation; NOTES.md).
#TRACE `s 320.22 the court shall consider the aggravating circumstances` TRUE AT 0 WITH
    PARTY `the court` DOES `s 320.22 consider, in addition to any other aggravating circumstances, the circumstances of paragraphs (a) to (g)` AT 1

§ `s 320.26: earlier offences (the offence must have been convicted; the list is 320.14(1) to (3), 320.15 and former 253 to 255)`
-- arguments: the earlier offence ; the offender was previously convicted of it ; it was under a section as it read before 320.26 comes into force
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 320.14, "(1)") TRUE FALSE EQUALS (JUST TRUE)   -- 320.14(1)
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 320.14, "(1)(c)") TRUE FALSE EQUALS (JUST TRUE)   -- a paragraph of 320.14(1)
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 320.14, "(2)") TRUE FALSE EQUALS (JUST TRUE)   -- 320.14(2)
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 320.14, "(3)") TRUE FALSE EQUALS (JUST TRUE)   -- 320.14(3)
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 320.14, "(4)") TRUE FALSE EQUALS NOTHING   -- 320.14(4) is not in the list; the list is not closed with "only": not covered
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 320.15, "(1)") TRUE FALSE EQUALS (JUST TRUE)   -- 320.15
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 320.15, "(3)") TRUE FALSE EQUALS (JUST TRUE)   -- 320.15
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 253, "") TRUE TRUE EQUALS (JUST TRUE)   -- former section 253
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 254, "(1)") TRUE TRUE EQUALS (JUST TRUE)   -- former section 254
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 255, "(2)") TRUE TRUE EQUALS (JUST TRUE)   -- former section 255
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 253, "") TRUE FALSE EQUALS NOTHING   -- a present-form section 253 is not within "as those sections read ... before"
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 320.13, "(1)") TRUE FALSE EQUALS NOTHING   -- dangerous operation is not in the list: not covered
#ASSERT `s 320.26 the offence is considered to be an earlier offence` (`Provision of the Code` OF 320.14, "(1)") FALSE FALSE EQUALS (JUST FALSE)   -- not previously convicted: "for which the offender was previously convicted"
#ASSERT `s 320.26 the number of earlier offences` 1 1 1 EQUALS 3   -- the three counts added
#ASSERT `s 320.26 the number of earlier offences` 0 0 0 EQUALS 0   -- none
#ASSERT `s 320.26 the occasion of the offence before the court` 0 EQUALS `s 320.19 a first offence`   -- no earlier offence
#ASSERT `s 320.26 the occasion of the offence before the court` 1 EQUALS `s 320.19 a second offence`   -- one earlier offence
#ASSERT `s 320.26 the occasion of the offence before the court` 2 EQUALS `s 320.19 a subsequent offence`   -- two earlier offences: a third offence is a subsequent one
#ASSERT `s 320.26 the occasion of the offence before the court` 5 EQUALS `s 320.19 a subsequent offence`   -- five earlier offences

