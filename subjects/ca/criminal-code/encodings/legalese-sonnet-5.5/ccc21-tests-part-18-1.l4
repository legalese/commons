IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc21-nouns`
IMPORT `ccc21-part-18-1`

-- ccc21-tests-part-18-1.l4 -- tests for PART XVIII.1 (ss 551.1 to 551.7). Expected values written by hand from the text, beside each assertion.
-- Argument order is the GIVEN order of the function under test.

§ `Tests -- section 551.1`

-- (1): a trial, the opinion that it is necessary, the mode of trial, jury selection has begun, the evidence stage has been reached
#ASSERT `s 551.1(1) the Chief Justice or Chief Judge may appoint a judge as the case management judge for the trial` TRUE TRUE `s 536(2) trial by a court composed of a judge and jury` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.1(1) the Chief Justice or Chief Judge may appoint a judge as the case management judge for the trial` TRUE TRUE `s 536(2) trial by a court composed of a judge and jury` TRUE FALSE EQUALS JUST FALSE   -- "before the jury selection"
#ASSERT `s 551.1(1) the Chief Justice or Chief Judge may appoint a judge as the case management judge for the trial` TRUE TRUE `s 536(2) trial by a judge without a jury` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.1(1) the Chief Justice or Chief Judge may appoint a judge as the case management judge for the trial` TRUE TRUE `s 536(2) trial by a judge without a jury` FALSE TRUE EQUALS JUST FALSE   -- "before the stage at which the evidence on the merits is presented"
#ASSERT `s 551.1(1) the Chief Justice or Chief Judge may appoint a judge as the case management judge for the trial` TRUE TRUE `s 536(2) trial by a provincial court judge` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.1(1) the Chief Justice or Chief Judge may appoint a judge as the case management judge for the trial` TRUE TRUE `s 536(2) trial by a provincial court judge` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 551.1(1) the Chief Justice or Chief Judge may appoint a judge as the case management judge for the trial` TRUE TRUE `s 536(2) trial by a judge without a jury` TRUE FALSE EQUALS JUST TRUE   -- jury selection is no limit on a trial without a jury
#ASSERT `s 551.1(1) the Chief Justice or Chief Judge may appoint a judge as the case management judge for the trial` TRUE FALSE `s 536(2) trial by a judge without a jury` FALSE FALSE EQUALS NOTHING   -- no opinion that it is necessary
#ASSERT `s 551.1(1) the Chief Justice or Chief Judge may appoint a judge as the case management judge for the trial` FALSE TRUE `s 536(2) trial by a judge without a jury` FALSE FALSE EQUALS NOTHING   -- no trial to be or being held
#ASSERT `s 551.1(2) the Chief Justice or Chief Judge may order that a conference or a hearing be held` TRUE EQUALS JUST TRUE
#ASSERT `s 551.1(2) the Chief Justice or Chief Judge may order that a conference or a hearing be held` FALSE EQUALS NOTHING
#ASSERT `s 551.1(3) repealed` EQUALS "(3) [Repealed, 2019, c. 25, s. 250]"
#ASSERT `s 551.1(4) the appointment does not prevent the case management judge from becoming the judge who hears the evidence on the merits` TRUE EQUALS JUST TRUE
#ASSERT `s 551.1(4) the appointment does not prevent the case management judge from becoming the judge who hears the evidence on the merits` FALSE EQUALS NOTHING

§ `Tests -- sections 551.2 and 551.3`

#ASSERT `s 551.2 the case management judge shall assist in promoting a fair and efficient trial` TRUE EQUALS JUST TRUE
#ASSERT `s 551.2 the case management judge shall assist in promoting a fair and efficient trial` FALSE EQUALS NOTHING
-- 551.3(1): the case management judge, before the evidence stage, the power, joint hearing under 551.7, a case set out in 599(1)
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(a) assisting the parties to identify the witnesses to be heard, taking into account the witnesses’ needs and circumstances` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(b) encouraging the parties to make admissions and reach agreements` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(c) encouraging the parties to consider any other matters that would promote a fair and efficient trial` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(d) establishing schedules and imposing deadlines on the parties` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(e) hearing guilty pleas and imposing sentences` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(f) assisting the parties to identify the issues that are to be dealt with at the stage at which the evidence on the merits is presented` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(g)(i) adjudicating an issue related to the disclosure of evidence` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(g)(ii) adjudicating an issue related to the admissibility of evidence` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(g)(iii) adjudicating an issue related to the Canadian Charter of Rights and Freedoms` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(g)(iv) adjudicating an issue related to expert witnesses` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(g)(v) adjudicating an issue related to the severance of counts` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(g)(vi) adjudicating an issue related to the separation of trials on one or more counts when there is more than one accused` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(g)(i) adjudicating an issue related to the disclosure of evidence` TRUE FALSE EQUALS NOTHING   -- subject to section 551.7
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(e) hearing guilty pleas and imposing sentences` TRUE FALSE EQUALS JUST TRUE   -- a joint hearing is a limit only on paragraph (g)
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(h) ordering, in a case set out in subsection 599(1), that the trial be held in a territorial division in the same province other than that in which the offence would otherwise be tried` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1)(h) ordering, in a case set out in subsection 599(1), that the trial be held in a territorial division in the same province other than that in which the offence would otherwise be tried` FALSE FALSE EQUALS NOTHING   -- not a case set out in subsection 599(1)
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE TRUE `s 551.3(1) any other power a trial judge has before that stage` FALSE FALSE EQUALS NOTHING   -- "including by": the list is not closed
#ASSERT `s 551.3(1) the case management judge may exercise the power` FALSE TRUE `s 551.3(1)(a) assisting the parties to identify the witnesses to be heard, taking into account the witnesses’ needs and circumstances` FALSE FALSE EQUALS NOTHING
#ASSERT `s 551.3(1) the case management judge may exercise the power` TRUE FALSE `s 551.3(1)(a) assisting the parties to identify the witnesses to be heard, taking into account the witnesses’ needs and circumstances` FALSE FALSE EQUALS NOTHING   -- at the evidence stage: section 551.6 applies
#ASSERT `s 551.3(1)(g) the power is one of paragraph (g)` `s 551.3(1)(g)(v) adjudicating an issue related to the severance of counts` EQUALS TRUE
#ASSERT `s 551.3(1)(g) the power is one of paragraph (g)` `s 551.3(1)(e) hearing guilty pleas and imposing sentences` EQUALS FALSE
#ASSERT `s 551.3(2) the case management judge shall order that a hearing be held` TRUE EQUALS JUST TRUE
#ASSERT `s 551.3(2) the case management judge shall order that a hearing be held` FALSE EQUALS NOTHING
#ASSERT `s 551.3(3) the case management judge is doing so at trial` TRUE EQUALS JUST TRUE
#ASSERT `s 551.3(3) the case management judge is doing so at trial` FALSE EQUALS NOTHING
-- 551.3(4): a decision under (1)(g), the court is satisfied it would not be in the interests of justice that it be binding
#ASSERT `s 551.3(4) the decision is binding on the parties for the remainder of the trial` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 551.3(4) the decision is binding on the parties for the remainder of the trial` TRUE TRUE EQUALS JUST FALSE   -- fresh evidence, for example
#ASSERT `s 551.3(4) the decision is binding on the parties for the remainder of the trial` FALSE FALSE EQUALS NOTHING

§ `Tests -- sections 551.4 to 551.6`

-- 551.4(1): in the judge's opinion the measures have been taken, the judge also hears the evidence on the merits, the information
#ASSERT `s 551.4(1) the case management judge shall ensure that the court record includes the information` TRUE FALSE `s 551.4(1)(a) the names of the witnesses to be heard that have been identified by the parties` EQUALS JUST TRUE
#ASSERT `s 551.4(1) the case management judge shall ensure that the court record includes the information` TRUE FALSE `s 551.4(1)(b) any admissions made and agreements reached by the parties` EQUALS JUST TRUE
#ASSERT `s 551.4(1) the case management judge shall ensure that the court record includes the information` TRUE FALSE `s 551.4(1)(c) the estimated time required to conclude the trial` EQUALS JUST TRUE
#ASSERT `s 551.4(1) the case management judge shall ensure that the court record includes the information` TRUE FALSE `s 551.4(1)(d) any orders and decisions` EQUALS JUST TRUE
#ASSERT `s 551.4(1) the case management judge shall ensure that the court record includes the information` TRUE FALSE `s 551.4(1)(e) any issues identified by the parties that are to be dealt with at the stage of the presentation of the evidence on the merits` EQUALS JUST TRUE
#ASSERT `s 551.4(1) the case management judge shall ensure that the court record includes the information` TRUE FALSE `s 551.4(1) any other information that, in the opinion of the case management judge, may be relevant` EQUALS NOTHING
#ASSERT `s 551.4(1) the case management judge shall ensure that the court record includes the information` FALSE FALSE `s 551.4(1)(a) the names of the witnesses to be heard that have been identified by the parties` EQUALS JUST FALSE   -- the measures have not been taken
#ASSERT `s 551.4(1) the case management judge shall ensure that the court record includes the information` TRUE TRUE `s 551.4(1)(a) the names of the witnesses to be heard that have been identified by the parties` EQUALS JUST FALSE   -- subsection (2): the judge also hears the evidence on the merits
#ASSERT `s 551.4(2) section 551.4 does not apply to the case management judge` TRUE EQUALS JUST TRUE
#ASSERT `s 551.4(2) section 551.4 does not apply to the case management judge` FALSE EQUALS NOTHING
#ASSERT `s 551.5 the trial of the accused shall proceed continuously` FALSE EQUALS JUST TRUE
#ASSERT `s 551.5 the trial of the accused shall proceed continuously` TRUE EQUALS JUST FALSE   -- "subject to adjournment by the court"
#ASSERT `s 551.6(1) the case management judge shall adjudicate the issue` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 551.6(1) the case management judge shall adjudicate the issue` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 551.6(1) the case management judge shall adjudicate the issue` TRUE FALSE EQUALS NOTHING
#ASSERT `s 551.6(2) the case management judge may exercise the powers of a trial judge` TRUE EQUALS JUST TRUE
#ASSERT `s 551.6(2) the case management judge may exercise the powers of a trial judge` FALSE EQUALS NOTHING

§ `Tests -- section 551.7`

-- (1): the power (the issue), related trials, in the same province before a court of the same jurisdiction
#ASSERT `s 551.7(1) the Chief Justice or Chief Judge may determine if it is in the interests of justice to adjudicate the issue at a joint hearing` `s 551.3(1)(g)(i) adjudicating an issue related to the disclosure of evidence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(1) the Chief Justice or Chief Judge may determine if it is in the interests of justice to adjudicate the issue at a joint hearing` `s 551.3(1)(g)(ii) adjudicating an issue related to the admissibility of evidence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(1) the Chief Justice or Chief Judge may determine if it is in the interests of justice to adjudicate the issue at a joint hearing` `s 551.3(1)(g)(iii) adjudicating an issue related to the Canadian Charter of Rights and Freedoms` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(1) the Chief Justice or Chief Judge may determine if it is in the interests of justice to adjudicate the issue at a joint hearing` `s 551.3(1)(g)(iv) adjudicating an issue related to expert witnesses` TRUE TRUE EQUALS NOTHING   -- only subparagraphs (i) to (iii)
#ASSERT `s 551.7(1) the Chief Justice or Chief Judge may determine if it is in the interests of justice to adjudicate the issue at a joint hearing` `s 551.3(1)(g)(i) adjudicating an issue related to the disclosure of evidence` FALSE TRUE EQUALS NOTHING
#ASSERT `s 551.7(1) the Chief Justice or Chief Judge may determine if it is in the interests of justice to adjudicate the issue at a joint hearing` `s 551.3(1)(g)(i) adjudicating an issue related to the disclosure of evidence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 551.7(2)(a) the Chief Justice or Chief Judge shall take into account the degree to which the evidence relating to the issue is similar in the related trials` TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(2)(a) the Chief Justice or Chief Judge shall take into account the degree to which the evidence relating to the issue is similar in the related trials` FALSE EQUALS NOTHING
#ASSERT `s 551.7(2)(b) the Chief Justice or Chief Judge may order that a conference or a hearing be held` TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(2)(b) the Chief Justice or Chief Judge may order that a conference or a hearing be held` FALSE EQUALS NOTHING
-- (3): the determination, the trials are in different territorial divisions, the content
#ASSERT `s 551.7(3) the Chief Justice or Chief Judge shall issue an order with the content` TRUE FALSE `s 551.7(3)(a) declaring that a joint hearing be held to adjudicate the issue in the related trials that are specified` EQUALS JUST TRUE
#ASSERT `s 551.7(3) the Chief Justice or Chief Judge shall issue an order with the content` TRUE FALSE `s 551.7(3)(b) naming the parties who are to appear at the hearing` EQUALS JUST TRUE
#ASSERT `s 551.7(3) the Chief Justice or Chief Judge shall issue an order with the content` TRUE FALSE `s 551.7(3)(c) appointing a judge to adjudicate the issue` EQUALS JUST TRUE
#ASSERT `s 551.7(3) the Chief Justice or Chief Judge shall issue an order with the content` TRUE TRUE `s 551.7(3)(d) designating the territorial division in which the hearing is to be held` EQUALS JUST TRUE
#ASSERT `s 551.7(3) the Chief Justice or Chief Judge shall issue an order with the content` TRUE FALSE `s 551.7(3)(d) designating the territorial division in which the hearing is to be held` EQUALS JUST FALSE   -- "if the trials are being held in different territorial divisions"
#ASSERT `s 551.7(3) the Chief Justice or Chief Judge shall issue an order with the content` FALSE TRUE `s 551.7(3)(a) declaring that a joint hearing be held to adjudicate the issue in the related trials that are specified` EQUALS JUST FALSE
#ASSERT `s 551.7(3) the Chief Justice or Chief Judge shall issue an order with the content` TRUE TRUE `s 551.7(3) anything else` EQUALS NOTHING
-- (4): an indictable offence, before a provincial court judge, the indictment has been preferred
#ASSERT `s 551.7(4) the order may be made in respect of the trial` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(4) the order may be made in respect of the trial` TRUE FALSE FALSE EQUALS JUST FALSE   -- "may only be made ... if the indictment has been preferred"
#ASSERT `s 551.7(4) the order may be made in respect of the trial` TRUE TRUE FALSE EQUALS NOTHING   -- a trial before a provincial court judge
#ASSERT `s 551.7(4) the order may be made in respect of the trial` FALSE FALSE FALSE EQUALS NOTHING   -- not a trial for an indictable offence
#ASSERT `s 551.7(5) the Chief Justice or Chief Judge shall cause a copy of the order to be included in the court record of each trial and provided to each party named in it` TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(5) the Chief Justice or Chief Judge shall cause a copy of the order to be included in the court record of each trial and provided to each party named in it` FALSE EQUALS NOTHING
-- (6): a trial in another territorial division, the officer has received the order
#ASSERT `s 551.7(6) the officer shall transmit the indictment or information and the writings without delay to the clerk of the court before which the joint hearing is to be held` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(6) the officer shall transmit the indictment or information and the writings without delay to the clerk of the court before which the joint hearing is to be held` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 551.7(6) the officer shall transmit the indictment or information and the writings without delay to the clerk of the court before which the joint hearing is to be held` TRUE FALSE EQUALS JUST FALSE   -- "when he or she receives the order"
#ASSERT `s 551.7(7) the judge appointed under the order shall require the parties named in it to appear at the joint hearing` TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(7) the judge appointed under the order shall require the parties named in it to appear at the joint hearing` FALSE EQUALS NOTHING
#ASSERT `s 551.7(8) the order is sufficient warrant, justification and authority for the removal, disposal and reception of the accused` TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(8) the order is sufficient warrant, justification and authority for the removal, disposal and reception of the accused` FALSE EQUALS NOTHING
#ASSERT `s 551.7(8) the sheriff may appoint and authorize any peace officer to convey the accused to a prison for the territorial division in which the hearing is to be held` TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(8) the sheriff may appoint and authorize any peace officer to convey the accused to a prison for the territorial division in which the hearing is to be held` FALSE EQUALS NOTHING
#ASSERT `s 551.7(9) the judge appointed under the order may exercise the powers of a trial judge for the purpose of adjudicating the issue at the joint hearing` TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(9) the judge appointed under the order may exercise the powers of a trial judge for the purpose of adjudicating the issue at the joint hearing` FALSE EQUALS NOTHING
#ASSERT `s 551.7(10) the judge is doing so at trial` TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(10) the judge is doing so at trial` FALSE EQUALS NOTHING
#ASSERT `s 551.7(11) the judge shall cause the decision, with reasons, to be included in the court record of each of the related trials` TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(11) the judge shall cause the decision, with reasons, to be included in the court record of each of the related trials` FALSE EQUALS JUST FALSE   -- "Once the judge has adjudicated the issue"
#ASSERT `s 551.7(11) the judge shall have the documents returned to the officer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 551.7(11) the judge shall have the documents returned to the officer` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 551.7(11) the judge shall have the documents returned to the officer` TRUE FALSE EQUALS JUST FALSE   -- nothing was transmitted under subsection (6)
