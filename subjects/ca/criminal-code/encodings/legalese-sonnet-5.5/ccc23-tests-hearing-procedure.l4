IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc23-hearing-procedure`

-- ccc23-tests-hearing-procedure.l4 -- tests for section 672.5. Expected values are written from the text, never copied from the code.

§ `s 672.5(1) to (5.2)`
#ASSERT `s 672.5(1) the hearing is to be held in accordance with section 672.5` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(1) the hearing is to be held in accordance with section 672.5` FALSE EQUALS NOTHING
#ASSERT `s 672.5(2) the hearing may be conducted informally` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(2) the hearing may be conducted informally` FALSE EQUALS NOTHING
-- (3) args: an application is made; the Attorney General of the province where the disposition is to be made; the Attorney General of the province from which the accused is transferred
#ASSERT `s 672.5(3) the court or Review Board must designate the Attorney General as a party` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(3) the court or Review Board must designate the Attorney General as a party` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(3) the court or Review Board must designate the Attorney General as a party` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(3) the court or Review Board must designate the Attorney General as a party` TRUE FALSE FALSE EQUALS JUST FALSE
-- (4) args: substantial interest in protecting the interests of the accused; the court or Review Board is of the opinion that it is just
#ASSERT `s 672.5(4) the court or Review Board may designate the person as a party` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(4) the court or Review Board may designate the person as a party` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.5(4) the court or Review Board may designate the person as a party` FALSE TRUE EQUALS NOTHING
-- (5) args: a party; the Attorney General of the province where the disposition is to be made; the Attorney General of the province from which the accused is transferred
#ASSERT `s 672.5(5) notice of the hearing must be given to the person` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(5) notice of the hearing must be given to the person` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(5) notice of the hearing must be given to the person` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(5) notice of the hearing must be given to the person` FALSE FALSE FALSE EQUALS NOTHING
-- (5.1) args: victim (by s 2); the victim requests notice
#ASSERT `s 672.5(5.1) notice of the hearing and of the relevant provisions must be given to the victim` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(5.1) notice of the hearing and of the relevant provisions must be given to the victim` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(5.1) notice of the hearing and of the relevant provisions must be given to the victim` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 672.5(5.1) notice of the hearing and of the relevant provisions must be given to the victim` NOTHING TRUE EQUALS NOTHING
-- (5.2) args: discharged absolutely or conditionally; victim (by s 2); the victim requests notice
#ASSERT `s 672.5(5.2) notice of the discharge and the accused’s intended place of residence must be given to the victim` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(5.2) notice of the discharge and the accused’s intended place of residence must be given to the victim` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(5.2) notice of the discharge and the accused’s intended place of residence must be given to the victim` FALSE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 672.5(5.2) notice of the discharge and the accused’s intended place of residence must be given to the victim` TRUE NOTHING TRUE EQUALS NOTHING

§ `s 672.5(6) to (13.04)`
-- (6) args: best interests of the accused; not contrary to the public interest
#ASSERT `s 672.5(6) the court or Review Board may order the public to be excluded from the hearing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(6) the court or Review Board may order the public to be excluded from the hearing` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(6) the court or Review Board may order the public to be excluded from the hearing` FALSE TRUE EQUALS JUST FALSE
-- (7) the right to counsel
#ASSERT `s 672.5(7) the person has the right to be represented by counsel` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(7) the person has the right to be represented by counsel` FALSE EQUALS NOTHING
-- (8) args: represented by counsel; found unfit; the interests of justice so require
#ASSERT `s 672.5(8) the court or Review Board must assign counsel to act for the accused` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(8) the court or Review Board must assign counsel to act for the accused` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(8) the court or Review Board must assign counsel to act for the accused` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.5(8) the court or Review Board must assign counsel to act for the accused` FALSE FALSE FALSE EQUALS JUST FALSE
-- (8.1) args: counsel assigned under (8); legal aid granted
#ASSERT `s 672.5(8.1) the Attorney General must pay the fees and disbursements of counsel` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(8.1) the Attorney General must pay the fees and disbursements of counsel` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.5(8.1) the Attorney General must pay the fees and disbursements of counsel` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(8.1) the amount the Attorney General must pay, in dollars` 8000 2500 (JUST TRUE) EQUALS JUST 5500
#ASSERT `s 672.5(8.1) the amount the Attorney General must pay, in dollars` 8000 9000 (JUST TRUE) EQUALS JUST 0
#ASSERT `s 672.5(8.1) the amount the Attorney General must pay, in dollars` 8000 0 (JUST FALSE) EQUALS NOTHING
#ASSERT `s 672.5(8.1) the amount the Attorney General must pay, in dollars` 8000 0 NOTHING EQUALS NOTHING
#ASSERT `s 672.5(8.2) the Attorney General or counsel may apply to the registrar to tax the disputed fees and disbursements` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(8.2) the Attorney General or counsel may apply to the registrar to tax the disputed fees and disbursements` FALSE EQUALS JUST FALSE
-- (10)(a)
#ASSERT `s 672.5(10)(a) the court or chairperson may permit the accused to be absent from the hearing` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(10)(a) the court or chairperson may permit the accused to be absent from the hearing` FALSE EQUALS NOTHING
-- (10)(b) args: (i) interrupts the hearing; (ii) satisfied of danger or impairment; (iii) in order to hear evidence about (ii)
#ASSERT `s 672.5(10)(b) the court or chairperson may cause the accused to be removed and barred from re-entry` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(10)(b) the court or chairperson may cause the accused to be removed and barred from re-entry` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(10)(b) the court or chairperson may cause the accused to be removed and barred from re-entry` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(10)(b) the court or chairperson may cause the accused to be removed and barred from re-entry` FALSE FALSE FALSE EQUALS JUST FALSE
-- (9) args: answer of (10)(a); answer of (10)(b). The right to be present yields to subsection (10).
#ASSERT `s 672.5(9) the accused has the right to be present during the whole of the hearing` NOTHING (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 672.5(9) the accused has the right to be present during the whole of the hearing` (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 672.5(9) the accused has the right to be present during the whole of the hearing` NOTHING (JUST TRUE) EQUALS NOTHING
-- (11) args: a party; the act; the party applies to cross-examine the author of the assessment report
#ASSERT `s 672.5(11) the party may do the act at the hearing` TRUE `s 672.5(11) adduce evidence` FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(11) the party may do the act at the hearing` TRUE `s 672.5(11) make oral or written submissions` FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(11) the party may do the act at the hearing` TRUE `s 672.5(11) call witnesses` FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(11) the party may do the act at the hearing` TRUE `s 672.5(11) cross-examine a witness called by any other party` FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(11) the party may do the act at the hearing` TRUE `s 672.5(11) cross-examine a person who made an assessment report that was submitted in writing` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(11) the party may do the act at the hearing` TRUE `s 672.5(11) cross-examine a person who made an assessment report that was submitted in writing` FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(11) the party may do the act at the hearing` TRUE `s 672.5(11) any other act` FALSE EQUALS NOTHING
#ASSERT `s 672.5(11) the party may do the act at the hearing` FALSE `s 672.5(11) adduce evidence` FALSE EQUALS NOTHING
-- (12) a party may NOT compel the attendance of witnesses, but may request that the court do so
#ASSERT `s 672.5(12) the party may compel the attendance of witnesses` TRUE EQUALS JUST FALSE
#ASSERT `s 672.5(12) the party may compel the attendance of witnesses` FALSE EQUALS NOTHING
#ASSERT `s 672.5(12) the party may request the court or chairperson to compel the attendance of witnesses` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(12) the party may request the court or chairperson to compel the attendance of witnesses` FALSE EQUALS NOTHING
-- (13), (13.01)
#ASSERT `s 672.5(13) the court or chairperson may permit the accused to appear by videoconference` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(13) the court or chairperson may permit the accused to appear by videoconference` FALSE EQUALS NOTHING
#ASSERT `s 672.5(13.01) the court or Review Board may order the accused to appear by audioconference or videoconference` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(13.01) the court or Review Board may order the accused to appear by audioconference or videoconference` FALSE EQUALS NOTHING
-- (13.02) args: videoconferencing is not readily available; audioconference would permit effective conduct
#ASSERT `s 672.5(13.02) the court or Review Board may allow the accused to appear by audioconference only` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(13.02) the court or Review Board may allow the accused to appear by audioconference only` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(13.02) the court or Review Board may allow the accused to appear by audioconference only` FALSE TRUE EQUALS JUST FALSE
-- (13.03) args: deciding under (13.01); (a); (b); (c); (d); (e); (f)
#ASSERT `s 672.5(13.03) the court or Review Board must take the factor into account` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(13.03) the court or Review Board must take the factor into account` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(13.03) the court or Review Board must take the factor into account` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(13.03) the court or Review Board must take the factor into account` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(13.03) the court or Review Board must take the factor into account` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(13.03) the court or Review Board must take the factor into account` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(13.03) the court or Review Board must take the factor into account` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.5(13.03) the court or Review Board must take the factor into account` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(13.04) the court or Review Board must provide reasons in writing` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(13.04) the court or Review Board must provide reasons in writing` FALSE EQUALS JUST FALSE

§ `s 672.5(13.1) to (16)`
-- (13.1) args: the adjournment is necessary; days (not exceeding thirty)
#ASSERT `s 672.5(13.1) the Review Board may adjourn the hearing` TRUE 30 EQUALS JUST TRUE
#ASSERT `s 672.5(13.1) the Review Board may adjourn the hearing` TRUE 31 EQUALS JUST FALSE
#ASSERT `s 672.5(13.1) the Review Board may adjourn the hearing` FALSE 10 EQUALS NOTHING
-- (13.2) args: received an assessment report; a change in mental condition that may provide grounds for discharge
#ASSERT `s 672.5(13.2) the court or Review Board must notify every victim that they are entitled to file a statement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(13.2) the court or Review Board must notify every victim that they are entitled to file a statement` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(13.2) the court or Review Board must determine whether there has been a change in the mental condition of the accused` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(13.2) the court or Review Board must determine whether there has been a change in the mental condition of the accused` FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(13.3) the Review Board must notify every victim that they are entitled to file a statement with the court` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(13.3) the Review Board must notify every victim that they are entitled to file a statement with the court` FALSE EQUALS JUST FALSE
-- (14) args: victim (by s 2); the individual may act for the victim (by s 2.2); the statement is on Form 48.2 or an approved form
#ASSERT `s 672.5(14) the victim may prepare and file a written statement` (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(14) the victim may prepare and file a written statement` (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(14) the victim may prepare and file a written statement` (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(14) the victim may prepare and file a written statement` (JUST FALSE) (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 672.5(14) the victim may prepare and file a written statement` NOTHING NOTHING TRUE EQUALS NOTHING
-- (15), (15.1) args: a victim requests; the court is of the opinion that it would interfere with the proper administration of justice
#ASSERT `s 672.5(15) the court or Review Board must ensure that a copy of the statement is provided to the accused or counsel and the prosecutor` TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(15) the court or Review Board must ensure that a copy of the statement is provided to the accused or counsel and the prosecutor` FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(15.1) the court or Review Board must permit the victim to read or present the statement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.5(15.1) the court or Review Board must permit the victim to read or present the statement` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.5(15.1) the court or Review Board must permit the victim to read or present the statement` FALSE FALSE EQUALS JUST FALSE
-- (15.2) args: a verdict of NCR rendered; no disposition yet made
#ASSERT `s 672.5(15.2) the court or Review Board must inquire whether the victim has been advised of the opportunity to prepare a statement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(15.2) the court or Review Board must inquire whether the victim has been advised of the opportunity to prepare a statement` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.5(15.2) the court or Review Board must inquire whether the victim has been advised of the opportunity to prepare a statement` FALSE TRUE EQUALS JUST FALSE
-- (15.3) args: application or own motion; satisfied that it would not interfere
#ASSERT `s 672.5(15.3) the court or Review Board may adjourn the hearing to permit the victim to prepare a statement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.5(15.3) the court or Review Board may adjourn the hearing to permit the victim to prepare a statement` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.5(15.3) the court or Review Board may adjourn the hearing to permit the victim to prepare a statement` FALSE TRUE EQUALS NOTHING
-- (16) repealed: the text shows no operative words
#ASSERT `s 672.5(16) as the text shows it` EQUALS "(16) [Repealed, 2015, c. 13, s. 22]"
