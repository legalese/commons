IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc8-part7-pari-mutuel`

-- ccc8-tests-part7-pari-mutuel.l4 -- tests for ccc8-part7-pari-mutuel.l4 (section 204). Expected values are written by hand from the text.
-- Where the text leaves a rate or a percentage to the regulations, the test uses an arbitrary stand-in and says so.

§ `Section 204(1) and (2) -- exemption`

-- (1)(a) "any person or association by reason of his or their becoming the custodian or depository of any money, property or valuable thing staked, to be paid to (i) the winner of a lawful race, sport, game or exercise, (ii) the owner of a horse engaged in a lawful race, or (iii) the winner of any bets between not more than ten individuals"
--                                                                                  custodian (i)    (ii)   (iii)  how many individuals
#ASSERT `s 204(1)(a) sections 201 and 202 do not apply to the custodian or depository` TRUE  TRUE  FALSE FALSE 0  EQUALS JUST TRUE
#ASSERT `s 204(1)(a) sections 201 and 202 do not apply to the custodian or depository` TRUE  FALSE TRUE  FALSE 0  EQUALS JUST TRUE
#ASSERT `s 204(1)(a) sections 201 and 202 do not apply to the custodian or depository` TRUE  FALSE FALSE TRUE  10 EQUALS JUST TRUE
#ASSERT `s 204(1)(a) sections 201 and 202 do not apply to the custodian or depository` TRUE  FALSE FALSE TRUE  11 EQUALS NOTHING
#ASSERT `s 204(1)(a) sections 201 and 202 do not apply to the custodian or depository` FALSE TRUE  FALSE FALSE 0  EQUALS NOTHING
#ASSERT `s 204(1)(a) sections 201 and 202 do not apply to the custodian or depository` TRUE  FALSE FALSE FALSE 0  EQUALS NOTHING
-- (1)(b) "a private bet between individuals not engaged in any way in the business of betting"
#ASSERT `s 204(1)(b) sections 201 and 202 do not apply to the private bet` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 204(1)(b) sections 201 and 202 do not apply to the private bet` TRUE TRUE EQUALS NOTHING
#ASSERT `s 204(1)(b) sections 201 and 202 do not apply to the private bet` FALSE FALSE EQUALS NOTHING
-- (1)(c) pari-mutuel bets on running, trotting or pacing horse-races if (i) made on the race-course (or, for a race abroad, the governing body is certified and betting permitted) and (ii) this section and the regulations are complied with
--                                                                         pari-mutuel at course   deemed (2)    foreign certified permitted complied
#ASSERT `s 204(1)(c) sections 201 and 202 do not apply to the pari-mutuel bets` TRUE  TRUE  NOTHING      FALSE FALSE FALSE TRUE  EQUALS JUST TRUE
#ASSERT `s 204(1)(c) sections 201 and 202 do not apply to the pari-mutuel bets` TRUE  FALSE (JUST TRUE)  FALSE FALSE FALSE TRUE  EQUALS JUST TRUE
#ASSERT `s 204(1)(c) sections 201 and 202 do not apply to the pari-mutuel bets` TRUE  FALSE (JUST FALSE) FALSE FALSE FALSE TRUE  EQUALS NOTHING
#ASSERT `s 204(1)(c) sections 201 and 202 do not apply to the pari-mutuel bets` TRUE  TRUE  NOTHING      TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `s 204(1)(c) sections 201 and 202 do not apply to the pari-mutuel bets` TRUE  TRUE  NOTHING      TRUE  TRUE  FALSE TRUE  EQUALS NOTHING
#ASSERT `s 204(1)(c) sections 201 and 202 do not apply to the pari-mutuel bets` TRUE  TRUE  NOTHING      TRUE  FALSE TRUE  TRUE  EQUALS NOTHING
#ASSERT `s 204(1)(c) sections 201 and 202 do not apply to the pari-mutuel bets` TRUE  TRUE  NOTHING      FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 204(1)(c) sections 201 and 202 do not apply to the pari-mutuel bets` FALSE TRUE  NOTHING      FALSE FALSE FALSE TRUE  EQUALS NOTHING
-- (1) "Sections 201 and 202 do not apply to (a), (b) or (c)"
#ASSERT `s 204(1) sections 201 and 202 do not apply` (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 204(1) sections 201 and 202 do not apply` NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 204(1) sections 201 and 202 do not apply` NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 204(1) sections 201 and 202 do not apply` NOTHING NOTHING NOTHING EQUALS NOTHING
-- (1.1) "a person may, in accordance with the regulations, do anything described in section 201 or 202, if the person does it for the purposes of legal pari-mutuel betting"
#ASSERT `s 204(1.1) the person may do anything described in section 201 or 202` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 204(1.1) the person may do anything described in section 201 or 202` TRUE FALSE EQUALS NOTHING
#ASSERT `s 204(1.1) the person may do anything described in section 201 or 202` FALSE TRUE EQUALS NOTHING
-- (2) bets made in accordance with the regulations in a betting theatre, or by telecommunication to the race-course or to such a theatre, are deemed made on the race-course
#ASSERT `s 204(2) the bets are deemed to be made on the race-course of the association` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 204(2) the bets are deemed to be made on the race-course of the association` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 204(2) the bets are deemed to be made on the race-course of the association` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 204(2) the bets are deemed to be made on the race-course of the association` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 204(2) the bets are deemed to be made on the race-course of the association` FALSE TRUE TRUE TRUE EQUALS NOTHING

§ `Section 204(3) to (7) -- operating a pari-mutuel system`

-- (3) "No person or association shall use a pari-mutuel system of betting ... unless the system has been approved by and its operation is carried on under the supervision of an officer"
#ASSERT `s 204(3) the person or association is prohibited from using the pari-mutuel system` TRUE EQUALS JUST FALSE
#ASSERT `s 204(3) the person or association is prohibited from using the pari-mutuel system` FALSE EQUALS JUST TRUE
-- the duty as a regulative rule: using an unapproved system is a breach; an approved one is fulfilled at once
#TRACE `s 204(3) the duty not to use a pari-mutuel system` FALSE AT 0 WITH
    PARTY `s 204 a person or association` DOES `s 204(3) use a pari-mutuel system of betting in respect of a horse-race` AT 1
#TRACE `s 204(3) the duty not to use a pari-mutuel system` FALSE AT 0 WITH
#TRACE `s 204(3) the duty not to use a pari-mutuel system` TRUE AT 0 WITH
    PARTY `s 204 a person or association` DOES `s 204(3) use a pari-mutuel system of betting in respect of a horse-race` AT 1
-- (4) one-half of one per cent of the total bet, or such greater fraction not exceeding one per cent as the Governor in Council fixes
#ASSERT `s 204(4) the amount to be paid to the Receiver General for the pool` 100000 0 EQUALS JUST 500
#ASSERT `s 204(4) the amount to be paid to the Receiver General for the pool` 100000 0.01 EQUALS JUST 1000
#ASSERT `s 204(4) the amount to be paid to the Receiver General for the pool` 100000 0.0075 EQUALS JUST 750
#ASSERT `s 204(4) the amount to be paid to the Receiver General for the pool` 100000 0.011 EQUALS NOTHING
#ASSERT `s 204(4) the amount to be paid to the Receiver General for the pool` 100000 0.005 EQUALS NOTHING
#ASSERT `s 204(4) the amount to be paid to the Receiver General for the pool` 100000 0.004 EQUALS NOTHING
#TRACE `s 204(4) the duty to pay the Receiver General` 500 AT 0 WITH
    PARTY `s 204 an association operating a pari-mutuel system` DOES `s 204(4) pay to the Receiver General the fraction of the total amount bet` 500 AT 3
#TRACE `s 204(4) the duty to pay the Receiver General` 500 AT 0 WITH
-- (5) "shall not deduct or retain any amount from the total amount ... unless it does so pursuant to subsection (6)"
#ASSERT `s 204(5) the person or association is prohibited from deducting or retaining an amount` TRUE EQUALS JUST FALSE
#ASSERT `s 204(5) the person or association is prohibited from deducting or retaining an amount` FALSE EQUALS JUST TRUE
#TRACE `s 204(5) the duty not to deduct or retain` FALSE AT 0 WITH
    PARTY `s 204 a person or association` DOES `s 204(5) deduct or retain an amount from the total amount of money, bets or stakes` AT 1
-- (6) a percentage not exceeding the percentage prescribed by the regulations plus the odd cents: the stand-in percentage 0.1 and odd cents 5 dollars are arbitrary (the text leaves them to the regulations)
--                                                                                  total  pct  odd  deducted
#ASSERT `s 204(6) the association may deduct and retain the amount` 100000 0.1 5 10005 EQUALS JUST TRUE
#ASSERT `s 204(6) the association may deduct and retain the amount` 100000 0.1 5 9000 EQUALS JUST TRUE
#ASSERT `s 204(6) the association may deduct and retain the amount` 100000 0.1 5 10005.01 EQUALS NOTHING
-- (7) an officer not satisfied that the section and regulations are carried out in good faith may order betting stopped
#ASSERT `s 204(7) the officer may order any betting in relation to the race meeting to be stopped` TRUE EQUALS JUST TRUE
#ASSERT `s 204(7) the officer may order any betting in relation to the race meeting to be stopped` FALSE EQUALS NOTHING

§ `Section 204(8.1) to (11)`

-- (8.1) the Minister or a person designated by the Minister may, for a horse-race on a race-course outside Canada, certify the governing body and permit betting
#ASSERT `s 204(8.1) the Minister or designated person may certify the governing body as acceptable and permit pari-mutuel betting in Canada on the race` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 204(8.1) the Minister or designated person may certify the governing body as acceptable and permit pari-mutuel betting in Canada on the race` TRUE FALSE EQUALS NOTHING
#ASSERT `s 204(8.1) the Minister or designated person may certify the governing body as acceptable and permit pari-mutuel betting in Canada on the race` FALSE TRUE EQUALS NOTHING
-- (9.1) a zone adjacent to the race-course, the farthest point not more than 900 metres from the nearest point on the track, all real property owned or leased by the race-course owner
#ASSERT `s 204(9.1) the Minister may designate the zone, which is deemed to be part of the race-course` TRUE 900 TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was `s 204(9.1) the Minister may designate the zone, which is deemed to be part of the race-course` TRUE 901 TRUE EQUALS JUST FALSE; the function is named for a power ("the Minister may designate"), and a failed "if" does not say the Minister may not: NOTHING, not JUST FALSE (fork F12)
#ASSERT `s 204(9.1) the Minister may designate the zone, which is deemed to be part of the race-course` TRUE 901 TRUE EQUALS NOTHING
#ASSERT `s 204(9.1) the Minister may designate the zone, which is deemed to be part of the race-course` TRUE 0 TRUE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was `s 204(9.1) the Minister may designate the zone, which is deemed to be part of the race-course` FALSE 100 TRUE EQUALS JUST FALSE; the function is named for a power ("the Minister may designate"), and a failed "if" does not say the Minister may not: NOTHING, not JUST FALSE (fork F12)
#ASSERT `s 204(9.1) the Minister may designate the zone, which is deemed to be part of the race-course` FALSE 100 TRUE EQUALS NOTHING
-- RECONCILED 2026-11-12: was `s 204(9.1) the Minister may designate the zone, which is deemed to be part of the race-course` TRUE 100 FALSE EQUALS JUST FALSE; the function is named for a power ("the Minister may designate"), and a failed "if" does not say the Minister may not: NOTHING, not JUST FALSE (fork F12)
#ASSERT `s 204(9.1) the Minister may designate the zone, which is deemed to be part of the race-course` TRUE 100 FALSE EQUALS NOTHING
-- (10) "Every person who contravenes or fails to comply with any of the provisions of this section or of any regulations ... is guilty of (a) an indictable offence ... not exceeding two years; or (b) an offence punishable on summary conviction"
`s 204(10) test fixture: a stand-in for the section 787(1) penalty` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
#ASSERT `s 204(10) the person commits the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 204(10) the person commits the offence` FALSE EQUALS NOTHING
#ASSERT `s 204(10) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 204(10) the punishment` `s 204(10) test fixture: a stand-in for the section 787(1) penalty` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 2, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), `s 204(10) test fixture: a stand-in for the section 787(1) penalty`
-- (11) "association means an association incorporated by or pursuant to an Act of Parliament or of the legislature of a province that owns or leases a race-course and conducts horse-races in the ordinary course of its business and, to the extent that the applicable legislation requires that the purposes ... be expressly stated in its constating instrument, having as one of its purposes the conduct of horse-races"
--                                  incorporated owns  conducts requires purpose
#ASSERT `s 204(11) association` TRUE  TRUE  TRUE  FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 204(11) association` TRUE  TRUE  TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `s 204(11) association` TRUE  TRUE  TRUE  TRUE  FALSE EQUALS JUST FALSE
#ASSERT `s 204(11) association` TRUE  TRUE  TRUE  FALSE TRUE  EQUALS JUST TRUE
#ASSERT `s 204(11) association` FALSE TRUE  TRUE  FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 204(11) association` TRUE  FALSE TRUE  FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 204(11) association` TRUE  TRUE  FALSE FALSE FALSE EQUALS JUST FALSE
