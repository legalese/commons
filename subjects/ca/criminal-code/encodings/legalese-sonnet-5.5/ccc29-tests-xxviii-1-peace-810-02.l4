IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc29-xxviii-1-peace-810-02`

-- ccc29-tests-xxviii-1-peace-810-02.l4 -- tests for sections 810.02 and 810.03 of the Criminal Code (Canada).
-- Every expected value is written from the text before the run, beside its assertion. Argument order is the GIVEN order of each function.

§ `Tests -- section 810.02`

#ASSERT `s 810.02(1) the person may lay an information before a provincial court judge` TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(1) the person may lay an information before a provincial court judge` FALSE EQUALS NOTHING
#ASSERT `s 810.02(2) the judge may cause the parties to appear before a provincial court judge` TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(2) the judge may cause the parties to appear before a provincial court judge` FALSE EQUALS NOTHING
#ASSERT `s 810.02(3) the provincial court judge may order that the defendant enter into a recognizance` TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(3) the provincial court judge may order that the defendant enter into a recognizance` FALSE EQUALS NOTHING
#ASSERT `s 810.02(3) the period of the recognizance is not more than 12 months` 12 EQUALS JUST TRUE
#ASSERT `s 810.02(3) the period of the recognizance is not more than 12 months` 13 EQUALS JUST FALSE
#ASSERT `s 810.02(4) the provincial court judge may order that the defendant enter into the recognizance for a longer period` TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(4) the provincial court judge may order that the defendant enter into the recognizance for a longer period` FALSE EQUALS NOTHING
#ASSERT `s 810.02(4) the longer period of the recognizance is not more than two years` 24 EQUALS JUST TRUE
#ASSERT `s 810.02(4) the longer period of the recognizance is not more than two years` 25 EQUALS JUST FALSE
#ASSERT `s 810.02(5) the provincial court judge may commit the defendant to prison` TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(5) the provincial court judge may commit the defendant to prison` FALSE EQUALS NOTHING
#ASSERT `s 810.02(5) the term of imprisonment does not exceed 12 months` 12 EQUALS JUST TRUE
#ASSERT `s 810.02(5) the term of imprisonment does not exceed 12 months` 13 EQUALS JUST FALSE
-- 810.02(6): (the condition, reasonable, considered desirable).
#ASSERT `s 810.02(6) the provincial court judge may add the condition to the recognizance` `s 810.02(6)(a) to prohibit the defendant from making agreements or arrangements for the marriage of the person in respect of whom it is feared that the offence will be committed` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(6) the provincial court judge may add the condition to the recognizance` `s 810.02(6)(b) to prohibit the defendant from taking steps to cause that person to leave the jurisdiction of the court` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(6) the provincial court judge may add the condition to the recognizance` `s 810.02(6)(c) to require the defendant to deposit any passport or any other travel document` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(6) the provincial court judge may add the condition to the recognizance` `s 810.02(6)(d) to prohibit the defendant from communicating with any specified person, or to refrain from going to any specified place` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(6) the provincial court judge may add the condition to the recognizance` `s 810.02(6)(e) to require the defendant to participate in a treatment program, including a family violence counselling program` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(6) the provincial court judge may add the condition to the recognizance` `s 810.02(6)(f) to require the defendant to remain within a specified geographic area unless written permission to leave that area is obtained from the provincial court judge` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(6) the provincial court judge may add the condition to the recognizance` `s 810.02(6)(g) to require the defendant to return to and remain at their place of residence at specified times` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(6) the provincial court judge may add the condition to the recognizance` `s 810.02(6) another reasonable condition` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(6) the provincial court judge may add the condition to the recognizance` `s 810.02(6) another reasonable condition` FALSE TRUE EQUALS NOTHING
#ASSERT `s 810.02(6) the provincial court judge may add the condition to the recognizance` `s 810.02(6) another reasonable condition` TRUE FALSE EQUALS NOTHING
#ASSERT `s 810.02(7) the provincial court judge is required to consider whether a firearms prohibition is desirable` TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(7) the provincial court judge is required to consider whether a firearms prohibition is desirable` FALSE EQUALS NOTHING
#ASSERT `s 810.02(7) the provincial court judge is required to add the firearms condition and specify the period during which it applies` TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(7) the provincial court judge is required to add the firearms condition and specify the period during which it applies` FALSE EQUALS JUST FALSE
#ASSERT `s 810.02(8) the provincial court judge is required to specify in the recognizance how the things and authorizations are to be surrendered` TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(8) the provincial court judge is required to specify in the recognizance how the things and authorizations are to be surrendered` FALSE EQUALS JUST FALSE
#ASSERT `s 810.02(9) the provincial court judge may vary the conditions fixed in the recognizance` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.02(9) the provincial court judge may vary the conditions fixed in the recognizance` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 810.02(9) the provincial court judge may vary the conditions fixed in the recognizance` FALSE FALSE EQUALS JUST FALSE

§ `Tests -- section 810.03`

#ASSERT `s 810.03(1) the person may lay an information before a justice` TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(1) the person may lay an information before a justice` FALSE EQUALS NOTHING
#ASSERT `s 810.03(2) the justice may cause the parties to appear before a justice` TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(2) the justice may cause the parties to appear before a justice` FALSE EQUALS NOTHING
#ASSERT `s 810.03(3) the justice may order the defendant to enter into a recognizance` TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(3) the justice may order the defendant to enter into a recognizance` FALSE EQUALS NOTHING
#ASSERT `s 810.03(3) the period of the recognizance is not more than 12 months` 12 EQUALS JUST TRUE
#ASSERT `s 810.03(3) the period of the recognizance is not more than 12 months` 13 EQUALS JUST FALSE
-- 810.03(4): (the justice is satisfied of a previous conviction, violence against an intimate partner or child, and section 3.01's answer for the previous offence).
#ASSERT `s 810.03(4) the justice may order the defendant to enter into the recognizance for a longer period` TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 810.03(4) the justice may order the defendant to enter into the recognizance for a longer period` TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 810.03(4) the justice may order the defendant to enter into the recognizance for a longer period` TRUE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 810.03(4) the justice may order the defendant to enter into the recognizance for a longer period` TRUE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 810.03(4) the justice may order the defendant to enter into the recognizance for a longer period` FALSE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 810.03(4) the justice may order the defendant to enter into the recognizance for a longer period` FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 810.03(4) the longer period of the recognizance is not more than two years` 24 EQUALS JUST TRUE
#ASSERT `s 810.03(4) the longer period of the recognizance is not more than two years` 25 EQUALS JUST FALSE
#ASSERT `s 810.03(4.1) the justice is required to consider whether it would be more appropriate to recommend Indigenous support services` TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(4.1) the justice is required to consider whether it would be more appropriate to recommend Indigenous support services` FALSE EQUALS JUST FALSE
#ASSERT `s 810.03(5) the justice may commit the defendant to prison` TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(5) the justice may commit the defendant to prison` FALSE EQUALS NOTHING
#ASSERT `s 810.03(5) the term of imprisonment does not exceed 12 months` 12 EQUALS JUST TRUE
#ASSERT `s 810.03(5) the term of imprisonment does not exceed 12 months` 13 EQUALS JUST FALSE
-- 810.03(6): (the condition, reasonable, considered desirable, the Attorney General consents to monitoring).
#ASSERT `s 810.03(6) the justice may add the condition to the recognizance` `s 810.03(6)(a) to attend a treatment program, such as an addiction treatment program or a domestic violence counselling program` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.03(6) the justice may add the condition to the recognizance` `s 810.03(6)(b) to remain within a specified geographic area unless written permission to leave that area is obtained from the justice` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.03(6) the justice may add the condition to the recognizance` `s 810.03(6)(c) to refrain from going to any specified place or being within a specified distance of any specified place` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.03(6) the justice may add the condition to the recognizance` `s 810.03(6)(d) to wear an electronic monitoring device` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(6) the justice may add the condition to the recognizance` `s 810.03(6)(d) to wear an electronic monitoring device` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 810.03(6) the justice may add the condition to the recognizance` `s 810.03(6)(e) to abstain from communicating with the intimate partner, a child of the intimate partner or of the defendant or any relative or close friend of the intimate partner` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.03(6) the justice may add the condition to the recognizance` `s 810.03(6)(f) to abstain from the consumption of drugs except in accordance with a medical prescription, of alcohol or of any other intoxicating substance` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.03(6) the justice may add the condition to the recognizance` `s 810.03(6)(g) to provide a sample of a bodily substance on demand` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.03(6) the justice may add the condition to the recognizance` `s 810.03(6)(h) to provide a sample of a bodily substance at regular intervals specified in a notice in Form 51` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.03(6) the justice may add the condition to the recognizance` `s 810.03(6) another reasonable condition` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.03(6) the justice may add the condition to the recognizance` `s 810.03(6) another reasonable condition` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 810.03(7) the justice is required to consider whether a firearms prohibition is desirable` TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(7) the justice is required to consider whether a firearms prohibition is desirable` FALSE EQUALS NOTHING
#ASSERT `s 810.03(7) the justice is required to add the firearms condition and specify the period during which it applies` TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(7) the justice is required to add the firearms condition and specify the period during which it applies` FALSE EQUALS JUST FALSE
#ASSERT `s 810.03(8) the justice is required to specify in the recognizance how the things and authorizations are to be surrendered` TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(8) the justice is required to specify in the recognizance how the things and authorizations are to be surrendered` FALSE EQUALS JUST FALSE
#ASSERT `s 810.03(9) the justice is required to include in the record a statement of the reasons for not adding the condition` TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(9) the justice is required to include in the record a statement of the reasons for not adding the condition` FALSE EQUALS JUST FALSE
#ASSERT `s 810.03(10) the justice may vary the conditions fixed in the recognizance` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 810.03(10) the justice may vary the conditions fixed in the recognizance` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 810.03(10) the justice may vary the conditions fixed in the recognizance` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 810.03(10) the justice may vary the conditions fixed in the recognizance` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(10) the justice may vary the conditions fixed in the recognizance` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 810.03(11) the justice is required, before varying any conditions, to consider the safety and security needs of the person on whose behalf the information is laid` TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(11) the justice is required, before varying any conditions, to consider the safety and security needs of the person on whose behalf the information is laid` FALSE EQUALS JUST FALSE
#ASSERT `s 810.03(12) the warrant of committal may be in Form 23` TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(12) the warrant of committal may be in Form 23` FALSE EQUALS NOTHING
#ASSERT `s 810.03(13) the provisions of this Part apply to the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 810.03(13) the provisions of this Part apply to the proceedings` FALSE EQUALS NOTHING

§ `Regulative rules -- sections 810.02 and 810.03`

#TRACE `s 810.02(7) the judge is to consider the firearms condition` AT 0 WITH
    PARTY `a provincial court judge` DOES `s 810.02(7) consider the firearms condition` AT 1
    PARTY `a provincial court judge` DOES `s 810.02(7) add the firearms condition and specify the period` AT 2
#TRACE `s 810.02(8) the judge is to specify how the things and authorizations are to be surrendered` AT 0 WITH
    PARTY `a provincial court judge` DOES `s 810.02(8) specify how the things and authorizations are to be surrendered` AT 1
#TRACE `s 810.03(4.1) the justice is to consider recommending Indigenous support services` AT 0 WITH
    PARTY `a justice` DOES `s 810.03(4.1) consider recommending Indigenous support services` AT 1
#TRACE `s 810.03(7) the justice is to consider the firearms condition` AT 0 WITH
    PARTY `a justice` DOES `s 810.03(7) consider the firearms condition` AT 1
    PARTY `a justice` DOES `s 810.03(7) add the firearms condition and specify the period` AT 2
#TRACE `s 810.03(8) the justice is to specify how the things and authorizations are to be surrendered` AT 0 WITH
    PARTY `a justice` DOES `s 810.03(8) specify how the things and authorizations are to be surrendered` AT 1
#TRACE `s 810.03(9) the justice is to include a statement of reasons in the record` AT 0 WITH
    PARTY `a justice` DOES `s 810.03(9) include a statement of reasons in the record` AT 1
#TRACE `s 810.03(11) the justice is to consider the safety and security needs` AT 0 WITH
    PARTY `a justice` DOES `s 810.03(11) consider the safety and security needs before varying any conditions` AT 1
