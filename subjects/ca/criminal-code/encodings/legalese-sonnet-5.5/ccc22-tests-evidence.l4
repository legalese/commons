IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc22-evidence`

-- ccc22-tests-evidence.l4 -- tests for ccc22-evidence.l4 (sections 655 to 659). Expected values are written from the text, beside the assertion. Arguments are in the order of each function's GIVEN lines.

§ `Sections 655 to 657`

-- 655: args: on trial for an indictable offence, the person is the accused or their counsel, the fact is alleged against the accused and the admission is to dispense with proof.
#ASSERT `s 655 the accused or their counsel may admit the fact` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 655 the accused or their counsel may admit the fact` FALSE TRUE TRUE EQUALS JUST FALSE   -- a "where" gate (ruling (b)): a summary conviction trial
#ASSERT `s 655 the accused or their counsel may admit the fact` TRUE FALSE TRUE EQUALS NOTHING   -- someone other than the accused or counsel
#ASSERT `s 655 the accused or their counsel may admit the fact` TRUE TRUE FALSE EQUALS NOTHING   -- not for the purpose of dispensing with proof
#ASSERT `s 655 the accused or their counsel may admit the fact` FALSE FALSE FALSE EQUALS JUST FALSE   -- the "where" gate is read first
-- 656: args: the proceeding is in relation to theft or possession of such a mineral, it is established that the person possesses it, there is evidence raising a reasonable doubt to the contrary.
#ASSERT `s 656 the person is presumed to have stolen or unlawfully possessed the valuable mineral` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 656 the person is presumed to have stolen or unlawfully possessed the valuable mineral` FALSE TRUE FALSE EQUALS NOTHING   -- another kind of proceeding
#ASSERT `s 656 the person is presumed to have stolen or unlawfully possessed the valuable mineral` TRUE FALSE FALSE EQUALS JUST FALSE   -- "if it is established that the person possesses"
#ASSERT `s 656 the person is presumed to have stolen or unlawfully possessed the valuable mineral` TRUE TRUE TRUE EQUALS JUST FALSE   -- "in the absence of evidence raising a reasonable doubt to the contrary"
#ASSERT `s 656 the person is presumed to have stolen or unlawfully possessed the valuable mineral` FALSE FALSE FALSE EQUALS NOTHING
-- 657: args: the statement was made under subsection 541(3), it purports to be signed by the justice, it is proved that the justice did not sign it.
#ASSERT `s 657 the statement may be given in evidence against the accused without proof of the signature of the justice` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 657 the statement may be given in evidence against the accused without proof of the signature of the justice` TRUE TRUE TRUE EQUALS JUST FALSE   -- "unless it is proved that the justice ... did not sign it"
#ASSERT `s 657 the statement may be given in evidence against the accused without proof of the signature of the justice` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 657 the statement may be given in evidence against the accused without proof of the signature of the justice` TRUE FALSE FALSE EQUALS NOTHING

§ `Section 657.1`

-- 657.1(1): args: the person claims to be the owner/entitled, or has specialized knowledge; the affidavit contains the statements referred to in subsection (2).
#ASSERT `s 657.1(1) the affidavit or solemn declaration is admissible in evidence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 657.1(1) the affidavit or solemn declaration is admissible in evidence` FALSE TRUE EQUALS NOTHING
#ASSERT `s 657.1(1) the affidavit or solemn declaration is admissible in evidence` TRUE FALSE EQUALS NOTHING   -- not "containing the statements referred to in subsection (2)"
-- 657.1(1) evidence: args: the affidavit is admissible under subsection (1), there is evidence to the contrary.
#ASSERT `s 657.1(1) the affidavit or solemn declaration is evidence of the statements contained in it without proof of the signature` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 657.1(1) the affidavit or solemn declaration is evidence of the statements contained in it without proof of the signature` TRUE TRUE EQUALS JUST FALSE   -- "in the absence of evidence to the contrary"
#ASSERT `s 657.1(1) the affidavit or solemn declaration is evidence of the statements contained in it without proof of the signature` FALSE FALSE EQUALS NOTHING
-- 657.1(2): args: (a) states ownership or knowledge, (b) states the value, the person is the owner or entitled, (c) states deprivation, the proceedings are under section 342, (c.1) states the credit card facts, (d) states facts within personal knowledge.
#ASSERT `s 657.1(2) the affidavit or solemn declaration states everything subsection (2) requires` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 657.1(2) the affidavit or solemn declaration states everything subsection (2) requires` TRUE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- not an owner and not a section 342 case: (c) and (c.1) are not required
#ASSERT `s 657.1(2) the affidavit or solemn declaration states everything subsection (2) requires` TRUE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- an owner who does not state the deprivation
#ASSERT `s 657.1(2) the affidavit or solemn declaration states everything subsection (2) requires` TRUE TRUE FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE   -- a section 342 case without the credit card statement
#ASSERT `s 657.1(2) the affidavit or solemn declaration states everything subsection (2) requires` TRUE TRUE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 657.1(2) the affidavit or solemn declaration states everything subsection (2) requires` FALSE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- (a) missing
#ASSERT `s 657.1(2) the affidavit or solemn declaration states everything subsection (2) requires` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- (b) missing
#ASSERT `s 657.1(2) the affidavit or solemn declaration states everything subsection (2) requires` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- (d) missing
-- 657.1(3): args: the court orders otherwise, the prosecutor gave a copy before the trial, the prosecutor gave reasonable notice.
#ASSERT `s 657.1(3) the subsection bars receiving the affidavit or solemn declaration in evidence under subsection (1)` FALSE TRUE TRUE EQUALS JUST FALSE   -- copy and notice given: the "unless" is met
#ASSERT `s 657.1(3) the subsection bars receiving the affidavit or solemn declaration in evidence under subsection (1)` FALSE FALSE TRUE EQUALS JUST TRUE   -- no copy
#ASSERT `s 657.1(3) the subsection bars receiving the affidavit or solemn declaration in evidence under subsection (1)` FALSE TRUE FALSE EQUALS JUST TRUE   -- no notice
#ASSERT `s 657.1(3) the subsection bars receiving the affidavit or solemn declaration in evidence under subsection (1)` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 657.1(3) the subsection bars receiving the affidavit or solemn declaration in evidence under subsection (1)` TRUE FALSE FALSE EQUALS JUST FALSE   -- "Unless the court orders otherwise"
-- 657.1(4): args: the person appears to have signed an affidavit or solemn declaration referred to in subsection (1).
#ASSERT `s 657.1(4) the court may require the person to appear for examination or cross-examination in respect of the issue of proof of any of the statements` TRUE EQUALS JUST TRUE
#ASSERT `s 657.1(4) the court may require the person to appear for examination or cross-examination in respect of the issue of proof of any of the statements` FALSE EQUALS NOTHING

§ `Section 657.2`

-- 657.2(1) admissible: args: the accused is charged with possession of property obtained by the commission of an offence, the evidence is of the conviction or discharge of another person of theft of the property.
#ASSERT `s 657.2(1) the evidence of the conviction or discharge of another person of theft of the property is admissible against the accused` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 657.2(1) the evidence of the conviction or discharge of another person of theft of the property is admissible against the accused` FALSE TRUE EQUALS JUST FALSE   -- a "where" gate
#ASSERT `s 657.2(1) the evidence of the conviction or discharge of another person of theft of the property is admissible against the accused` TRUE FALSE EQUALS NOTHING
-- 657.2(1) proof: args: the evidence is admissible under subsection (1), there is evidence to the contrary.
#ASSERT `s 657.2(1) the evidence is proof that the property was stolen` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 657.2(1) the evidence is proof that the property was stolen` TRUE TRUE EQUALS JUST FALSE   -- "in the absence of evidence to the contrary"
#ASSERT `s 657.2(1) the evidence is proof that the property was stolen` FALSE FALSE EQUALS NOTHING
-- 657.2(2) admissible: args: the accused is charged with being an accessory after the fact, the evidence is of the conviction or discharge of another person of the offence.
#ASSERT `s 657.2(2) the evidence of the conviction or discharge of another person of the offence is admissible against the accused` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 657.2(2) the evidence of the conviction or discharge of another person of the offence is admissible against the accused` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 657.2(2) the evidence of the conviction or discharge of another person of the offence is admissible against the accused` TRUE FALSE EQUALS NOTHING
-- 657.2(2) proof: args: admissible under subsection (2), evidence to the contrary.
#ASSERT `s 657.2(2) the evidence is proof that the offence was committed` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 657.2(2) the evidence is proof that the offence was committed` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 657.2(2) the evidence is proof that the offence was committed` FALSE FALSE EQUALS NOTHING

§ `Section 657.3`

-- 657.3(1): args: evidence given by a report with the affidavit setting out qualifications, the court recognizes the person as an expert, copy given before the proceeding, reasonable notice given.
#ASSERT `s 657.3(1) the evidence of the person as an expert may be given by means of a report accompanied by the affidavit or solemn declaration` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 657.3(1) the evidence of the person as an expert may be given by means of a report accompanied by the affidavit or solemn declaration` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 657.3(1) the evidence of the person as an expert may be given by means of a report accompanied by the affidavit or solemn declaration` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- the "if" gate fails: the court does not recognize the person (a grant: NOTHING)
#ASSERT `s 657.3(1) the evidence of the person as an expert may be given by means of a report accompanied by the affidavit or solemn declaration` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- no copy given before the proceeding
#ASSERT `s 657.3(1) the evidence of the person as an expert may be given by means of a report accompanied by the affidavit or solemn declaration` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- no reasonable notice
-- 657.3(2): args: the person appears to have signed an affidavit or solemn declaration referred to in subsection (1).
#ASSERT `s 657.3(2) the court may require the person to appear for examination or cross-examination in respect of the issue of proof of any of the statements` TRUE EQUALS JUST TRUE
#ASSERT `s 657.3(2) the court may require the person to appear for examination or cross-examination in respect of the issue of proof of any of the statements` FALSE EQUALS NOTHING
-- 657.3(3)(a) last day: 30 days before 15 June 2025 is 16 May 2025 (15 June less 15 days is 31 May, less 15 more is 16 May); another period fixed by the justice or judge replaces it.
#ASSERT `s 657.3(3)(a) the last day for the notice of the expert witness` (Date 15 6 2025) NOTHING EQUALS Date 16 5 2025
#ASSERT `s 657.3(3)(a) the last day for the notice of the expert witness` (Date 1 3 2025) NOTHING EQUALS Date 30 1 2025   -- 1 March less 1 day is 28 February, less 28 more is 31 January, less 1 more is 30 January: 30 days
#ASSERT `s 657.3(3)(a) the last day for the notice of the expert witness` (Date 15 6 2025) (JUST (Date 1 8 2025)) EQUALS Date 1 8 2025   -- "within any other period fixed by the justice or judge"
-- 657.3(3)(a) decision: args: the party intends to call an expert witness, the day the trial commences, the last day under another period fixed, the day the notice was given, accompanied by (i) the name, (ii) the description of expertise, (iii) the qualifications, the day asked about.
#ASSERT `s 657.3(3)(a) the party has given the notice the paragraph requires` TRUE (Date 15 6 2025) NOTHING (JUST (Date 16 5 2025)) TRUE TRUE TRUE (Date 1 1 2026) EQUALS JUST TRUE   -- notice on the thirtieth day before: "at least thirty days before"
#ASSERT `s 657.3(3)(a) the party has given the notice the paragraph requires` TRUE (Date 15 6 2025) NOTHING (JUST (Date 17 5 2025)) TRUE TRUE TRUE (Date 1 1 2026) EQUALS JUST FALSE   -- 29 days before: one day late
#ASSERT `s 657.3(3)(a) the party has given the notice the paragraph requires` TRUE (Date 15 6 2025) NOTHING (JUST (Date 1 5 2025)) FALSE TRUE TRUE (Date 1 1 2026) EQUALS JUST FALSE   -- no name of the proposed witness
#ASSERT `s 657.3(3)(a) the party has given the notice the paragraph requires` TRUE (Date 15 6 2025) NOTHING (JUST (Date 1 5 2025)) TRUE FALSE TRUE (Date 1 1 2026) EQUALS JUST FALSE   -- no description of the area of expertise
#ASSERT `s 657.3(3)(a) the party has given the notice the paragraph requires` TRUE (Date 15 6 2025) NOTHING (JUST (Date 1 5 2025)) TRUE TRUE FALSE (Date 1 1 2026) EQUALS JUST FALSE   -- no statement of qualifications
#ASSERT `s 657.3(3)(a) the party has given the notice the paragraph requires` FALSE (Date 15 6 2025) NOTHING (JUST (Date 1 5 2025)) TRUE TRUE TRUE (Date 1 1 2026) EQUALS NOTHING   -- the party does not intend to call an expert witness
#ASSERT `s 657.3(3)(a) the party has given the notice the paragraph requires` TRUE (Date 15 6 2025) NOTHING NOTHING TRUE TRUE TRUE (Date 17 5 2025) EQUALS JUST FALSE   -- no notice, and the last day (16 May) has passed
#ASSERT `s 657.3(3)(a) the party has given the notice the paragraph requires` TRUE (Date 15 6 2025) NOTHING NOTHING TRUE TRUE TRUE (Date 16 5 2025) EQUALS NOTHING   -- no notice yet, and today is the last day
#ASSERT `s 657.3(3)(a) the party has given the notice the paragraph requires` TRUE (Date 15 6 2025) (JUST (Date 1 8 2025)) (JUST (Date 1 8 2025)) TRUE TRUE TRUE (Date 1 1 2026) EQUALS JUST TRUE   -- the period fixed by the judge: notice on its last day
#ASSERT `s 657.3(3)(a) the party has given the notice the paragraph requires` TRUE (Date 15 6 2025) (JUST (Date 1 8 2025)) (JUST (Date 2 8 2025)) TRUE TRUE TRUE (Date 1 1 2026) EQUALS JUST FALSE   -- the period fixed by the judge: one day late
-- 657.3(3)(b): args: the person is a prosecutor who intends to call an expert, provided within a reasonable period before trial, a report was prepared, a copy of the report was provided, a summary was provided.
#ASSERT `s 657.3(3)(b) the prosecutor has provided the material the paragraph requires` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 657.3(3)(b) the prosecutor has provided the material the paragraph requires` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- a report exists: a summary is not what (i) asks for
#ASSERT `s 657.3(3)(b) the prosecutor has provided the material the paragraph requires` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- "if no report is prepared, a summary"
#ASSERT `s 657.3(3)(b) the prosecutor has provided the material the paragraph requires` TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE   -- no report and no summary
#ASSERT `s 657.3(3)(b) the prosecutor has provided the material the paragraph requires` TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE   -- not within a reasonable period before trial
#ASSERT `s 657.3(3)(b) the prosecutor has provided the material the paragraph requires` FALSE TRUE TRUE TRUE FALSE EQUALS NOTHING   -- not a prosecutor who intends to call an expert witness
-- 657.3(3)(c): args: the accused or counsel intends to call an expert witness, the day the material was provided, the day the case for the prosecution closes, the day asked about.
#ASSERT `s 657.3(3)(c) the accused or their counsel has provided the material not later than the close of the case for the prosecution` TRUE (JUST (Date 10 6 2025)) (Date 10 6 2025) (Date 1 1 2026) EQUALS JUST TRUE   -- on the day the case for the prosecution closes: "not later than the close"
#ASSERT `s 657.3(3)(c) the accused or their counsel has provided the material not later than the close of the case for the prosecution` TRUE (JUST (Date 11 6 2025)) (Date 10 6 2025) (Date 1 1 2026) EQUALS JUST FALSE   -- one day late
#ASSERT `s 657.3(3)(c) the accused or their counsel has provided the material not later than the close of the case for the prosecution` TRUE NOTHING (Date 10 6 2025) (Date 11 6 2025) EQUALS JUST FALSE   -- nothing provided and the case for the prosecution has closed
#ASSERT `s 657.3(3)(c) the accused or their counsel has provided the material not later than the close of the case for the prosecution` TRUE NOTHING (Date 10 6 2025) (Date 10 6 2025) EQUALS NOTHING   -- nothing provided yet, and the case for the prosecution closes today
#ASSERT `s 657.3(3)(c) the accused or their counsel has provided the material not later than the close of the case for the prosecution` FALSE (JUST (Date 1 1 2025)) (Date 10 6 2025) (Date 1 1 2026) EQUALS NOTHING   -- the accused does not intend to call an expert witness
-- 657.3(3)(c) as a rule: the accused who provides the material by time 10 has fulfilled the duty; one who does nothing by 11 is in breach. expected: FULFILLED
#TRACE (`s 657.3(3)(c) the accused must provide the material before the close of the case for the prosecution` 10) AT 0 WITH
    PARTY `the accused` DOES `s 657.3(3)(c) provide the material referred to in paragraph (b) to the other party or parties` AT 5
-- expected: FULFILLED
#TRACE (`s 657.3(3)(c) the accused must provide the material before the close of the case for the prosecution` 10) AT 0 WITH
    (WAITUNTIL 11)
-- expected: BREACHED ("the accused, who intends to call a person as an expert witness, did not provide the material before the close of the case for the prosecution")
-- 657.3(4)(a): args: the party called an expert without complying with subsection (3), another party requests the adjournment.
#ASSERT `s 657.3(4)(a) the court must grant an adjournment to the party who requests it` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 657.3(4)(a) the court must grant an adjournment to the party who requests it` TRUE FALSE EQUALS JUST FALSE   -- "at the request of any other party"
#ASSERT `s 657.3(4)(a) the court must grant an adjournment to the party who requests it` FALSE TRUE EQUALS JUST FALSE   -- the duty arises only "If a party calls a person as an expert witness without complying"
-- 657.3(4)(b): args: the party called an expert without complying, another party requests the order.
#ASSERT `s 657.3(4)(b) the court must order the party who called the expert witness to provide the material referred to in paragraph (3)(b)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 657.3(4)(b) the court must order the party who called the expert witness to provide the material referred to in paragraph (3)(b)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 657.3(4)(b) the court must order the party who called the expert witness to provide the material referred to in paragraph (3)(b)` FALSE TRUE EQUALS JUST FALSE
-- 657.3(4)(c): args: the party called an expert without complying, another party requests the order, the court considers it inappropriate.
#ASSERT `s 657.3(4)(c) the court must order the calling or recalling of any witness for the purpose of giving testimony on matters related to those raised in the expert witness’s testimony` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 657.3(4)(c) the court must order the calling or recalling of any witness for the purpose of giving testimony on matters related to those raised in the expert witness’s testimony` TRUE TRUE TRUE EQUALS JUST FALSE   -- "unless the court considers it inappropriate to do so"
#ASSERT `s 657.3(4)(c) the court must order the calling or recalling of any witness for the purpose of giving testimony on matters related to those raised in the expert witness’s testimony` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 657.3(4)(c) the court must order the calling or recalling of any witness for the purpose of giving testimony on matters related to those raised in the expert witness’s testimony` FALSE TRUE FALSE EQUALS JUST FALSE
-- 657.3(5): args: a party has received the notice and material, in the opinion of the court the party has not been able to prepare, the order.
#ASSERT `s 657.3(5) the court may make the order` TRUE TRUE `s 657.3(5)(a) adjourn the proceedings` EQUALS JUST TRUE
#ASSERT `s 657.3(5) the court may make the order` TRUE TRUE `s 657.3(5)(b) order that further particulars be given of the evidence of the proposed witness` EQUALS JUST TRUE
#ASSERT `s 657.3(5) the court may make the order` TRUE TRUE `s 657.3(5)(c) order the calling or recalling of any witness for the purpose of giving testimony on matters related to those raised in the expert witness’s testimony` EQUALS JUST TRUE
#ASSERT `s 657.3(5) the court may make the order` TRUE TRUE `s 657.3(5) some other order` EQUALS NOTHING   -- the list is not closed
#ASSERT `s 657.3(5) the court may make the order` TRUE FALSE `s 657.3(5)(a) adjourn the proceedings` EQUALS NOTHING   -- the "if" gate fails: the court is not of the opinion (a grant: NOTHING)
#ASSERT `s 657.3(5) the court may make the order` FALSE TRUE `s 657.3(5)(a) adjourn the proceedings` EQUALS NOTHING   -- no notice and material received
-- 657.3(6): args: the proposed witness does not testify, the material was provided to the prosecutor under paragraph (3)(c), the accused consents.
#ASSERT `s 657.3(6) the subsection bars the prosecutor from producing the material in evidence` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 657.3(6) the subsection bars the prosecutor from producing the material in evidence` TRUE TRUE TRUE EQUALS NOTHING   -- "without the consent of the accused": the prohibition is limited by its own wording
#ASSERT `s 657.3(6) the subsection bars the prosecutor from producing the material in evidence` FALSE TRUE FALSE EQUALS NOTHING   -- the witness testifies
#ASSERT `s 657.3(6) the subsection bars the prosecutor from producing the material in evidence` TRUE FALSE FALSE EQUALS NOTHING   -- not material provided under paragraph (3)(c)
-- 657.3(7): args: the purpose is the purpose of that proceeding, a court has ordered otherwise.
#ASSERT `s 657.3(7) the subsection bars using the information disclosed under the section for a purpose other than that proceeding` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 657.3(7) the subsection bars using the information disclosed under the section for a purpose other than that proceeding` TRUE FALSE EQUALS NOTHING   -- a use for that proceeding is not what the subsection bars
#ASSERT `s 657.3(7) the subsection bars using the information disclosed under the section for a purpose other than that proceeding` FALSE TRUE EQUALS JUST FALSE   -- "Unless otherwise ordered by a court"
#ASSERT `s 657.3(7) the subsection bars using the information disclosed under the section for a purpose other than that proceeding` TRUE TRUE EQUALS JUST FALSE

§ `Section 657.4`

-- 657.4(5): the section 402.1 answer, passed through.
#ASSERT `s 657.4(5) the information is identity information` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 657.4(5) the information is identity information` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 657.4(5) the information is identity information` NOTHING EQUALS NOTHING
-- 657.4(1) admissible: args: the proceedings are under section 402.2 or 403, the information was used (or obtained or possessed) to commit an indictable offence including fraud, deceit or falsehood, the answer of section 657.4(5), the affidavit contains the statements in subsection (2).
#ASSERT `s 657.4(1) the affidavit or solemn declaration is admissible in evidence` TRUE TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 657.4(1) the affidavit or solemn declaration is admissible in evidence` TRUE TRUE (JUST FALSE) TRUE EQUALS NOTHING   -- not identity information
#ASSERT `s 657.4(1) the affidavit or solemn declaration is admissible in evidence` TRUE TRUE NOTHING TRUE EQUALS NOTHING   -- section 402.1 does not answer
#ASSERT `s 657.4(1) the affidavit or solemn declaration is admissible in evidence` FALSE TRUE (JUST TRUE) TRUE EQUALS NOTHING   -- another offence
#ASSERT `s 657.4(1) the affidavit or solemn declaration is admissible in evidence` TRUE FALSE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 657.4(1) the affidavit or solemn declaration is admissible in evidence` TRUE TRUE (JUST TRUE) FALSE EQUALS NOTHING   -- not "containing the statements referred to in subsection (2)"
-- 657.4(1) evidence: args: admissible under subsection (1), there is evidence to the contrary.
#ASSERT `s 657.4(1) the affidavit or solemn declaration is evidence of the statements contained in it without proof of the signature` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 657.4(1) the affidavit or solemn declaration is evidence of the statements contained in it without proof of the signature` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 657.4(1) the affidavit or solemn declaration is evidence of the statements contained in it without proof of the signature` FALSE FALSE EQUALS NOTHING
-- 657.4(2): args: (a) the person whose identity information was used, (b) the nature of the information, (c) did not consent, (d) facts within personal knowledge.
#ASSERT `s 657.4(2) the affidavit or solemn declaration states everything subsection (2) requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 657.4(2) the affidavit or solemn declaration states everything subsection (2) requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 657.4(2) the affidavit or solemn declaration states everything subsection (2) requires` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 657.4(2) the affidavit or solemn declaration states everything subsection (2) requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 657.4(2) the affidavit or solemn declaration states everything subsection (2) requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- 657.4(3): args: the court orders otherwise, the prosecutor gave a copy, the prosecutor gave reasonable notice.
#ASSERT `s 657.4(3) the subsection bars receiving the affidavit or solemn declaration in evidence under subsection (1)` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 657.4(3) the subsection bars receiving the affidavit or solemn declaration in evidence under subsection (1)` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 657.4(3) the subsection bars receiving the affidavit or solemn declaration in evidence under subsection (1)` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 657.4(3) the subsection bars receiving the affidavit or solemn declaration in evidence under subsection (1)` TRUE FALSE FALSE EQUALS JUST FALSE
-- 657.4(4): args: the person appears to have signed an affidavit or solemn declaration referred to in subsection (1).
#ASSERT `s 657.4(4) the court may require the person to appear for examination or cross-examination in respect of the issue of proof of any of the statements` TRUE EQUALS JUST TRUE
#ASSERT `s 657.4(4) the court may require the person to appear for examination or cross-examination in respect of the issue of proof of any of the statements` FALSE EQUALS NOTHING

§ `Sections 658 and 659`

-- 658(1): args: proceedings to which this Act applies, the testimony is of a person as to the date of their own birth.
#ASSERT `s 658(1) the testimony of a person as to the date of their birth is admissible as evidence of that date` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 658(1) the testimony of a person as to the date of their birth is admissible as evidence of that date` FALSE TRUE EQUALS NOTHING
#ASSERT `s 658(1) the testimony of a person as to the date of their birth is admissible as evidence of that date` TRUE FALSE EQUALS NOTHING
-- 658(2): args: proceedings to which this Act applies, the testimony is of a parent as to the age of a person of whom they are a parent.
#ASSERT `s 658(2) the testimony of a parent as to the age of a person of whom they are a parent is admissible as evidence of the age of that person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 658(2) the testimony of a parent as to the age of a person of whom they are a parent is admissible as evidence of the age of that person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 658(2) the testimony of a parent as to the age of a person of whom they are a parent is admissible as evidence of the age of that person` TRUE FALSE EQUALS NOTHING
-- 658(3)(a): args: proceedings to which this Act applies, a birth or baptismal certificate or a copy, purporting to be certified under the hand of its custodian.
#ASSERT `s 658(3)(a) the certificate or copy is evidence of the age of that person` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 658(3)(a) the certificate or copy is evidence of the age of that person` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 658(3)(a) the certificate or copy is evidence of the age of that person` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 658(3)(a) the certificate or copy is evidence of the age of that person` TRUE TRUE FALSE EQUALS NOTHING   -- not certified under the hand of the person in whose custody it is held
-- 658(3)(b): args: proceedings to which this Act applies, an entry or record of an incorporated society (control or care of the child), made before the time when the offence is alleged.
#ASSERT `s 658(3)(b) the entry or record is evidence of the age of the child or young person` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 658(3)(b) the entry or record is evidence of the age of the child or young person` TRUE TRUE FALSE EQUALS JUST FALSE   -- "if the entry or record was made before the time when the offence is alleged to have been committed"
#ASSERT `s 658(3)(b) the entry or record is evidence of the age of the child or young person` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 658(3)(b) the entry or record is evidence of the age of the child or young person` TRUE FALSE TRUE EQUALS NOTHING
-- 658(4): args: no certificate, copy, entry or record, or in corroboration; the trier considers the information reliable.
#ASSERT `s 658(4) the jury, judge, justice or provincial court judge may receive and act on the other information relating to age` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 658(4) the jury, judge, justice or provincial court judge may receive and act on the other information relating to age` FALSE TRUE EQUALS JUST FALSE   -- "In the absence of any certificate ... or in corroboration" fails (a "where"-kind gate, ruling (b))
#ASSERT `s 658(4) the jury, judge, justice or provincial court judge may receive and act on the other information relating to age` TRUE FALSE EQUALS NOTHING   -- "that they consider reliable"
#ASSERT `s 658(4) the jury, judge, justice or provincial court judge may receive and act on the other information relating to age` FALSE FALSE EQUALS NOTHING
-- 658(5): args: no other evidence, or by way of corroboration; the person is a child or young person.
#ASSERT `s 658(5) the jury, judge, justice or provincial court judge may infer the age of the child or young person from their appearance` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 658(5) the jury, judge, justice or provincial court judge may infer the age of the child or young person from their appearance` FALSE TRUE EQUALS JUST FALSE   -- "In the absence of other evidence, or by way of corroboration" fails
#ASSERT `s 658(5) the jury, judge, justice or provincial court judge may infer the age of the child or young person from their appearance` TRUE FALSE EQUALS NOTHING   -- not a child or young person
#ASSERT `s 658(5) the jury, judge, justice or provincial court judge may infer the age of the child or young person from their appearance` FALSE FALSE EQUALS NOTHING
-- 659: args: the requirement is one whereby it is mandatory for a court to give the jury a warning about convicting an accused on the evidence of a child.
#ASSERT `s 659 the requirement is abrogated` TRUE EQUALS JUST TRUE
#ASSERT `s 659 the requirement is abrogated` FALSE EQUALS NOTHING   -- any other requirement is not decided here
