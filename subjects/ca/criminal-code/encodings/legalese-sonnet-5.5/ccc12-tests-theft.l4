#ASSERT `s 333 the person commits theft by reason only of taking a specimen of ore or mineral for exploration or scientific investigation` TRUE TRUE TRUE FALSE EQUALS NOTHING

§ `ss 333.1 to 333.2 motor vehicle theft`
-- s 333.1(1): theft (s 322), the property is a motor vehicle (s 2)
#ASSERT `s 333.1(1) the person is guilty of the offence of motor vehicle theft` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 333.1(1) the person is guilty of the offence of motor vehicle theft` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 333.1(1) the person is guilty of the offence of motor vehicle theft` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 333.1(1) the person is guilty of the offence of motor vehicle theft` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 333.1(1) the person is guilty of the offence of motor vehicle theft` NOTHING (JUST FALSE) EQUALS JUST FALSE
-- s 333.1(2): previously convicted, in either mode
#ASSERT `s 333.1(2) the earlier conviction is considered to be an earlier offence` TRUE `by indictment` EQUALS JUST TRUE
#ASSERT `s 333.1(2) the earlier conviction is considered to be an earlier offence` TRUE `on summary conviction` EQUALS JUST TRUE
#ASSERT `s 333.1(2) the earlier conviction is considered to be an earlier offence` FALSE `by indictment` EQUALS JUST FALSE
-- s 333.1(1) punishment: the minimum of six months only for a third or subsequent offence (two or more earlier offences); summary limb two years less a day
#ASSERT `s 333.1(1) the punishment for motor vehicle theft` 0 EQUALS LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture summary, up to two years less a day`
#ASSERT `s 333.1(1) the punishment for motor vehicle theft` 1 EQUALS LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture summary, up to two years less a day`
#ASSERT `s 333.1(1) the punishment for motor vehicle theft` 2 EQUALS LIST `ccc12 fixture indictable, up to ten years, minimum six months`, `ccc12 fixture summary, up to two years less a day`
#ASSERT `s 333.1(1) the punishment for motor vehicle theft` 5 EQUALS LIST `ccc12 fixture indictable, up to ten years, minimum six months`, `ccc12 fixture summary, up to two years less a day`
-- s 333.1(3): theft, violence used, threatened or attempted against a person, motor vehicle
#ASSERT `s 333.1(3) the person is guilty of the offence of motor vehicle theft with violence` (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 333.1(3) the person is guilty of the offence of motor vehicle theft with violence` (JUST TRUE) FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 333.1(3) the person is guilty of the offence of motor vehicle theft with violence` (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 333.1(3) the person is guilty of the offence of motor vehicle theft with violence` NOTHING TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 333.1(3) the person is guilty of the offence of motor vehicle theft with violence` (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 333.1(3) the punishment for motor vehicle theft with violence` EQUALS LIST `ccc12 fixture indictable, up to fourteen years`
-- s 333.1(4): theft, for the benefit of / at the direction of / in association with a criminal organization (s 2), motor vehicle
#ASSERT `s 333.1(4) the person is guilty of the offence of motor vehicle theft for a criminal organization` (JUST TRUE) TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 333.1(4) the person is guilty of the offence of motor vehicle theft for a criminal organization` (JUST TRUE) FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 333.1(4) the person is guilty of the offence of motor vehicle theft for a criminal organization` (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 333.1(4) the person is guilty of the offence of motor vehicle theft for a criminal organization` (JUST TRUE) TRUE NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 333.1(4) the person is guilty of the offence of motor vehicle theft for a criminal organization` (JUST FALSE) TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 333.1(4) the person is guilty of the offence of motor vehicle theft for a criminal organization` (JUST TRUE) TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 333.1(4) the punishment for motor vehicle theft for a criminal organization` EQUALS LIST `ccc12 fixture indictable, up to fourteen years`
-- s 333.11: consecutive sentences
#ASSERT `s 333.11(1) the sentence shall be served consecutively to the other sentence` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 333.11(1) the sentence shall be served consecutively to the other sentence` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 333.11(1) the sentence shall be served consecutively to the other sentence` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 333.11(1) the sentence shall be served consecutively to the other sentence` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 333.11(2) the sentence shall be served consecutively to the other sentence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 333.11(2) the sentence shall be served consecutively to the other sentence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 333.11(2) the sentence shall be served consecutively to the other sentence` TRUE FALSE EQUALS JUST FALSE
-- s 333.2(1), (2)
#ASSERT `s 333.2(1) the person commits the offence of possessing an electronic device for the purpose of committing motor vehicle theft` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 333.2(1) the person commits the offence of possessing an electronic device for the purpose of committing motor vehicle theft` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 333.2(1) the person commits the offence of possessing an electronic device for the purpose of committing motor vehicle theft` FALSE TRUE EQUALS JUST FALSE
-- without lawful excuse, makes/repairs/sells/..., an electronic device suitable for committing theft of a motor vehicle, knows it has been or is intended to be used
#ASSERT `s 333.2(2) the person commits the offence of distributing a device linked to motor vehicle theft` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 333.2(2) the person commits the offence of distributing a device linked to motor vehicle theft` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 333.2(2) the person commits the offence of distributing a device linked to motor vehicle theft` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
