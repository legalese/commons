#ASSERT `s 331 the person commits theft by disposing of property held under a power of attorney` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 331 the person commits theft by disposing of property held under a power of attorney` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 331 the person commits theft by disposing of property held under a power of attorney` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 331 the person commits theft by disposing of property held under a power of attorney` FALSE TRUE TRUE EQUALS JUST FALSE
