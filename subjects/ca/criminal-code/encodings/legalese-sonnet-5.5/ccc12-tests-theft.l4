#ASSERT `s 333.2(4) the electronic device may be ordered forfeited to His Majesty` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 333.2(4) the electronic device may be ordered forfeited to His Majesty` FALSE TRUE EQUALS NOTHING
#ASSERT `s 333.2(4) the electronic device may be ordered forfeited to His Majesty` TRUE FALSE EQUALS NOTHING
