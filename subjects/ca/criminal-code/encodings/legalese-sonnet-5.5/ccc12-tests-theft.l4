#ASSERT `s 330(2) a fraudulent conversion of the thing or the proceeds is deemed to have taken place` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 330(2) a fraudulent conversion of the thing or the proceeds is deemed to have taken place` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 330(2) a fraudulent conversion of the thing or the proceeds is deemed to have taken place` TRUE TRUE TRUE FALSE EQUALS NOTHING
