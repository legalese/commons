IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc12-logic`
IMPORT `ccc12-tests-fixtures`
IMPORT `ccc12-part9-theft`

-- Tests of ss 322 to 334.1. Expected values are hand-written from the text before each run. Arguments are positional, in the GIVEN order of each function
-- (the order is given in the comment above each group). A MAYBE input is written JUST TRUE, JUST FALSE or NOTHING.

§ `s 322 theft`
-- s 322(1): took, converted, intent (a) deprive, (b) pledge, (c) part with under a condition, (d) deal so it cannot be restored
#ASSERT `s 322(1) the person commits theft` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 322(1) the person commits theft` FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 322(1) the person commits theft` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 322(1) the person commits theft` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- neither taking nor converting: no theft even with every intent
#ASSERT `s 322(1) the person commits theft` FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- taking without any of the four intents
#ASSERT `s 322(1) the person commits theft` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- s 322(2): intent to steal, moves it
#ASSERT `s 322(2) the person commits theft by moving the thing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 322(2) the person commits theft by moving the thing` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 322(2) the person commits theft by moving the thing` FALSE TRUE EQUALS JUST FALSE
-- s 322 (the seam): (1) or (2)
#ASSERT `s 322 the person commits theft` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 322 the person commits theft` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 322 the person commits theft` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 322 the person commits theft` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 322 the person commits theft` NOTHING (JUST FALSE) EQUALS NOTHING
-- s 322(3): without secrecy does not stop a taking from being fraudulent; with secrecy the subsection is silent
#ASSERT `s 322(3) the absence of secrecy prevents the taking or conversion from being fraudulent` TRUE EQUALS JUST FALSE
#ASSERT `s 322(3) the absence of secrecy prevents the taking or conversion from being fraudulent` FALSE EQUALS NOTHING
-- s 322(4): the two named questions are not material; another question is not covered
#ASSERT `s 322(4) the question is material` `s 322(4) whether anything that is converted is taken for the purpose of conversion` EQUALS JUST FALSE
#ASSERT `s 322(4) the question is material` `s 322(4) whether it is, at the time it is converted, in the lawful possession of the person who converts it` EQUALS JUST FALSE
#ASSERT `s 322(4) the question is material` `s 322(4) another question` EQUALS NOTHING
-- s 322(5): has the creature in captivity, and it is in captivity or has escaped
#ASSERT `s 322(5) the person is deemed to have a special property or interest in the creature` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 322(5) the person is deemed to have a special property or interest in the creature` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 322(5) the person is deemed to have a special property or interest in the creature` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 322(5) the person is deemed to have a special property or interest in the creature` FALSE TRUE FALSE EQUALS JUST FALSE

§ `s 323 oysters`
#ASSERT `s 323(1) the person is deemed to have a special property or interest in the oysters and oyster brood` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 323(1) the person is deemed to have a special property or interest in the oysters and oyster brood` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 323(1) the person is deemed to have a special property or interest in the oysters and oyster brood` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 323(2) the indictment is sufficient` TRUE EQUALS JUST TRUE
#ASSERT `s 323(2) the indictment is sufficient` FALSE EQUALS NOTHING

§ `s 324 bailee`
-- bailee, under lawful seizure, seizing officer a peace officer (s 2), a public officer (s 2), obliged to produce, did not produce, failure was wilful
#ASSERT `s 324 the bailee steals the thing under seizure` TRUE TRUE (JUST TRUE) (JUST FALSE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 324 the bailee steals the thing under seizure` TRUE TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
-- the seizing officer is neither a peace officer nor a public officer
#ASSERT `s 324 the bailee steals the thing under seizure` TRUE TRUE (JUST FALSE) (JUST FALSE) TRUE TRUE TRUE EQUALS JUST FALSE
-- the s 2 answers were not given
#ASSERT `s 324 the bailee steals the thing under seizure` TRUE TRUE NOTHING (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING
-- failure not the result of a wilful act or omission: "he does not steal it"
#ASSERT `s 324 the bailee steals the thing under seizure` TRUE TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 324 the bailee steals the thing under seizure` FALSE TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 324 the bailee steals the thing under seizure` TRUE FALSE (JUST TRUE) (JUST TRUE) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 324 the bailee steals the thing under seizure` TRUE TRUE (JUST TRUE) (JUST TRUE) FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 324 the bailee steals the thing under seizure` TRUE TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE

§ `s 325 agent pledging goods`
-- factor or agent, goods entrusted, pledges or gives a lien, amount of the pledge, amount due from the principal, amount of bills accepted
#ASSERT `s 325 the factor or agent commits theft by pledging or giving a lien on goods or documents of title to goods` TRUE TRUE TRUE 100 80 20 EQUALS JUST FALSE
#ASSERT `s 325 the factor or agent commits theft by pledging or giving a lien on goods or documents of title to goods` TRUE TRUE TRUE 99 80 20 EQUALS JUST FALSE
-- one dollar over the sum (a) + (b): the section says nothing
#ASSERT `s 325 the factor or agent commits theft by pledging or giving a lien on goods or documents of title to goods` TRUE TRUE TRUE 101 80 20 EQUALS NOTHING
#ASSERT `s 325 the factor or agent commits theft by pledging or giving a lien on goods or documents of title to goods` FALSE TRUE TRUE 100 80 20 EQUALS NOTHING
#ASSERT `s 325 the factor or agent commits theft by pledging or giving a lien on goods or documents of title to goods` TRUE FALSE TRUE 100 80 20 EQUALS NOTHING
#ASSERT `s 325 the factor or agent commits theft by pledging or giving a lien on goods or documents of title to goods` TRUE TRUE FALSE 100 80 20 EQUALS NOTHING

§ `s 326 theft of electricity, gas or telecommunication service`
-- fraudulently, maliciously, without colour of right, (a) abstracts, consumes or uses electricity or gas, (b) uses a telecommunication facility or service
#ASSERT `s 326(1) the person commits theft of electricity, gas or a telecommunication service` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 326(1) the person commits theft of electricity, gas or a telecommunication service` FALSE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 326(1) the person commits theft of electricity, gas or a telecommunication service` FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 326(1) the person commits theft of electricity, gas or a telecommunication service` FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 326(1) the person commits theft of electricity, gas or a telecommunication service` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 326(2) as the text shows it` EQUALS "(2) [Repealed, 2014, c. 31, s. 14]"

§ `s 327 possession of a device to use a telecommunication facility`
-- without lawful excuse, makes/possesses/sells/..., the thing is a device (s 327(4)), designed or adapted primarily to use a facility without paying, knows it has been used or is intended
#ASSERT `s 327(1) the person commits the offence of possessing a device to obtain the use of a telecommunication facility or service` TRUE TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 327(1) the person commits the offence of possessing a device to obtain the use of a telecommunication facility or service` TRUE TRUE NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 327(1) the person commits the offence of possessing a device to obtain the use of a telecommunication facility or service` TRUE TRUE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 327(1) the person commits the offence of possessing a device to obtain the use of a telecommunication facility or service` FALSE TRUE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 327(1) the person commits the offence of possessing a device to obtain the use of a telecommunication facility or service` TRUE FALSE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 327(1) the person commits the offence of possessing a device to obtain the use of a telecommunication facility or service` TRUE TRUE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 327(1) the person commits the offence of possessing a device to obtain the use of a telecommunication facility or service` TRUE TRUE (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
-- punishment: (a) indictable, not more than two years; (b) summary, the general penalty supplied
#ASSERT `s 327(1) the punishment for the offence` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to two years`, `ccc12 fixture general summary penalty`
-- forfeiture: convicted under (1) or 326(1)(b), device connected with the offence
#ASSERT `s 327(2) the device may be ordered forfeited to Her Majesty` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 327(2) the device may be ordered forfeited to Her Majesty` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 327(2) the device may be ordered forfeited to Her Majesty` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 327(2) the device may be ordered forfeited to Her Majesty` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 327(2) the device may be disposed of as the Attorney General directs` TRUE EQUALS JUST TRUE
#ASSERT `s 327(2) the device may be disposed of as the Attorney General directs` FALSE EQUALS NOTHING
-- limitation: facilities or equipment, owned by a provider, form part of a provider's service, the provider is not a party
#ASSERT `s 327(3) an order for forfeiture is barred` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 327(3) an order for forfeiture is barred` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 327(3) an order for forfeiture is barred` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 327(3) an order for forfeiture is barred` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 327(3) an order for forfeiture is barred` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- (4) device includes a component, and a computer program within 342.1(2)
#ASSERT `s 327(4) the thing is a device` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 327(4) the thing is a device` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 327(4) the thing is a device` FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 327(4) the thing is a device` FALSE NOTHING EQUALS NOTHING

§ `s 328 theft by or from a person with a special property or interest`
#ASSERT `s 328 the person may be convicted of theft notwithstanding the circumstance` `s 328 stolen by the owner of it from a person who has a special property or interest in it` EQUALS JUST TRUE
#ASSERT `s 328 the person may be convicted of theft notwithstanding the circumstance` `s 328 stolen by a person who has a special property or interest in it from the owner of it` EQUALS JUST TRUE
#ASSERT `s 328 the person may be convicted of theft notwithstanding the circumstance` `s 328 stolen by a lessee of it from his reversioner` EQUALS JUST TRUE
#ASSERT `s 328 the person may be convicted of theft notwithstanding the circumstance` `s 328 stolen by one of several joint owners, tenants in common or partners of or in it from the other persons who have an interest in it` EQUALS JUST TRUE
#ASSERT `s 328 the person may be convicted of theft notwithstanding the circumstance` `s 328 stolen by the representatives of an organization from the organization` EQUALS JUST TRUE
#ASSERT `s 328 the person may be convicted of theft notwithstanding the circumstance` `s 328 stolen in another circumstance` EQUALS NOTHING
#ASSERT `s 329 as the text shows it` EQUALS "329 [Repealed, 2000, c. 12, s. 94]"

§ `ss 330 to 333`
-- s 330(1): received on terms to account, fraudulently failed to account
#ASSERT `s 330(1) the person commits theft by failing to account` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 330(1) the person commits theft by failing to account` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 330(1) the person commits theft by failing to account` FALSE TRUE EQUALS JUST FALSE
