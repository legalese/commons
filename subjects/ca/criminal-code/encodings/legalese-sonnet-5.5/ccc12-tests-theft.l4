#ASSERT `s 332(1) the person commits theft by misappropriating money held under direction` TRUE (JUST FALSE) FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 332(1) the person commits theft by misappropriating money held under direction` FALSE (JUST TRUE) FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 332(1) the person commits theft by misappropriating money held under direction` FALSE (JUST FALSE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 332(1) the person commits theft by misappropriating money held under direction` TRUE NOTHING FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 332(1) the person commits theft by misappropriating money held under direction` FALSE NOTHING FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 332(1) the person commits theft by misappropriating money held under direction` FALSE (JUST FALSE) FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 332(1) the person commits theft by misappropriating money held under direction` TRUE (JUST FALSE) FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 332(1) the person commits theft by misappropriating money held under direction` TRUE (JUST FALSE) FALSE TRUE FALSE EQUALS JUST FALSE
-- s 332(2): debtor-and-creditor terms, direction in writing
#ASSERT `s 332(2) section 332 applies to the receipt` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 332(2) section 332 applies to the receipt` TRUE TRUE EQUALS NOTHING
#ASSERT `s 332(2) section 332 applies to the receipt` FALSE FALSE EQUALS NOTHING
#ASSERT `s 332(2) section 332 applies to the receipt` FALSE TRUE EQUALS NOTHING
-- s 333: a specimen, for exploration or scientific investigation, land not enclosed, not occupied or worked as a mine, quarry or digging
#ASSERT `s 333 the person commits theft by reason only of taking a specimen of ore or mineral for exploration or scientific investigation` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 333 the person commits theft by reason only of taking a specimen of ore or mineral for exploration or scientific investigation` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 333 the person commits theft by reason only of taking a specimen of ore or mineral for exploration or scientific investigation` TRUE FALSE TRUE TRUE EQUALS NOTHING
