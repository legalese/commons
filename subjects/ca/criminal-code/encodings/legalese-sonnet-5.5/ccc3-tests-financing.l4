IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc3-interpretation`
IMPORT `ccc3-financing`

-- ccc3-tests-financing.l4 -- tests of sections 83.02, 83.03 and 83.04. Expected values are hand-written from the text beside each assertion.

§ `Tests of sections 83.02 to 83.04`

`s 83.02 the hostage-taking offence` MEANS `s 83.01(1)(a)(iv) the taking of hostages (subsection 7(3.1); United Nations, 1979)`
`s 83.02 the first listed offence` MEANS `s 83.01(1)(a)(i) unlawful seizure of aircraft (subsection 7(2); Hague Convention, 1970)`
`s 83.02 the ninth listed offence` MEANS `s 83.01(1)(a)(ix) terrorist bombings (subsection 7(3.72); United Nations, 1997)`
`s 83.02 the financing offence` MEANS `s 83.01(1)(a)(x) financing of terrorism (subsection 7(3.73); United Nations, 1999)`
`s 83.02 no listed offence` MEANS `s 83.01(1)(a) none of the offences listed in subparagraphs (i) to (x)`
`s 83.02(b) met` MEANS `s 83.02(b) facts` OF TRUE, TRUE
`s 83.02(b) not met` MEANS `s 83.02(b) facts` OF FALSE, FALSE

-- ---- 83.02(a): subparagraphs (a)(i) to (ix) of the definition, and NOT (x) (line 1294).
#ASSERT `s 83.02(a) the use would carry out an offence referred to in subparagraphs (a)(i) to (ix)` `s 83.02 the first listed offence` EQUALS JUST TRUE
#ASSERT `s 83.02(a) the use would carry out an offence referred to in subparagraphs (a)(i) to (ix)` `s 83.02 the hostage-taking offence` EQUALS JUST TRUE
#ASSERT `s 83.02(a) the use would carry out an offence referred to in subparagraphs (a)(i) to (ix)` `s 83.02 the ninth listed offence` EQUALS JUST TRUE   -- (ix) is the last one named
#ASSERT `s 83.02(a) the use would carry out an offence referred to in subparagraphs (a)(i) to (ix)` `s 83.02 the financing offence` EQUALS JUST FALSE   -- (x) is NOT named: the range stops at (ix)
#ASSERT `s 83.02(a) the use would carry out an offence referred to in subparagraphs (a)(i) to (ix)` `s 83.02 no listed offence` EQUALS JUST FALSE

-- ---- 83.02(b): both limbs required (line 1295).
#ASSERT `s 83.02(b) the use would carry out another act or omission intended to cause death or serious bodily harm` `s 83.02(b) met` EQUALS JUST TRUE
#ASSERT `s 83.02(b) the use would carry out another act or omission intended to cause death or serious bodily harm` (`s 83.02(b) facts` OF TRUE, FALSE) EQUALS JUST FALSE   -- harm intended, but no intimidating or compelling purpose
#ASSERT `s 83.02(b) the use would carry out another act or omission intended to cause death or serious bodily harm` (`s 83.02(b) facts` OF FALSE, TRUE) EQUALS JUST FALSE   -- purpose, but no intended harm to a civilian
#ASSERT `s 83.02(b) the use would carry out another act or omission intended to cause death or serious bodily harm` `s 83.02(b) not met` EQUALS JUST FALSE

-- ---- 83.02: the fixture takes: provides or collects, wilfully, lawful justification or excuse, intends, knows, offence of (a), the (b) facts.
GIVEN p IS A BOOLEAN, w IS A BOOLEAN, l IS A BOOLEAN, i IS A BOOLEAN, k IS A BOOLEAN, o IS A `s 83.01(1)(a) listed offence`, b IS A `s 83.02(b) facts`
GIVETH A `s 83.02 facts`
`s 83.02 test facts` MEANS `s 83.02 facts` OF p, w, l, i, k, o, b

#ASSERT `s 83.02 the person is guilty of the offence` (`s 83.02 test facts` TRUE TRUE FALSE TRUE FALSE `s 83.02 the hostage-taking offence` `s 83.02(b) not met`) EQUALS JUST TRUE   -- intends; offence of (a)
#ASSERT `s 83.02 the person is guilty of the offence` (`s 83.02 test facts` TRUE TRUE FALSE FALSE TRUE `s 83.02 the hostage-taking offence` `s 83.02(b) not met`) EQUALS JUST TRUE   -- knows
#ASSERT `s 83.02 the person is guilty of the offence` (`s 83.02 test facts` TRUE TRUE FALSE TRUE TRUE `s 83.02 no listed offence` `s 83.02(b) met`) EQUALS JUST TRUE   -- limb (b)
#ASSERT `s 83.02 the person is guilty of the offence` (`s 83.02 test facts` FALSE TRUE FALSE TRUE TRUE `s 83.02 the hostage-taking offence` `s 83.02(b) met`) EQUALS JUST FALSE   -- neither provides nor collects
#ASSERT `s 83.02 the person is guilty of the offence` (`s 83.02 test facts` TRUE FALSE FALSE TRUE TRUE `s 83.02 the hostage-taking offence` `s 83.02(b) met`) EQUALS JUST FALSE   -- not wilfully
#ASSERT `s 83.02 the person is guilty of the offence` (`s 83.02 test facts` TRUE TRUE TRUE TRUE TRUE `s 83.02 the hostage-taking offence` `s 83.02(b) met`) EQUALS JUST FALSE   -- with lawful justification or excuse
#ASSERT `s 83.02 the person is guilty of the offence` (`s 83.02 test facts` TRUE TRUE FALSE FALSE FALSE `s 83.02 the hostage-taking offence` `s 83.02(b) met`) EQUALS JUST FALSE   -- neither intending nor knowing
#ASSERT `s 83.02 the person is guilty of the offence` (`s 83.02 test facts` TRUE TRUE FALSE TRUE TRUE `s 83.02 the financing offence` `s 83.02(b) not met`) EQUALS JUST FALSE   -- the use would carry out an offence of (x) only, or no act within (a) or (b)
#ASSERT `s 83.02 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 83.02 the punishment of the offence`'s `mode` EQUALS `by indictment`
#ASSERT `s 83.02 the punishment of the offence`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `ten years`   -- "not more than 10 years"
#ASSERT `s 83.02 the punishment of the offence`'s `minimum imprisonment` EQUALS `no imprisonment is stated`
#ASSERT `s 83.02 the punishment of the offence`'s `maximum fine` EQUALS `no fine is stated`

-- ---- 83.03(1): the fixture takes: act, wilfully, lawful justification or excuse, intends, knows, purpose (facilitating or carrying out), purpose (benefiting).
GIVEN a IS A `s 83.03 act`, w IS A BOOLEAN, l IS A BOOLEAN, i IS A BOOLEAN, k IS A BOOLEAN, f IS A BOOLEAN, g IS A BOOLEAN
GIVETH A `s 83.03(1) facts`
`s 83.03(1) test facts` MEANS `s 83.03(1) facts` OF a, w, l, i, k, f, g

#ASSERT `s 83.03(1) the person is guilty of the offence` (`s 83.03(1) test facts` `s 83.03 collects property` TRUE FALSE TRUE FALSE TRUE FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `s 83.03(1) the person is guilty of the offence` (`s 83.03(1) test facts` `s 83.03 provides property or financial or other related services` TRUE FALSE FALSE TRUE FALSE TRUE) NOTHING EQUALS JUST TRUE   -- knows; benefiting a person
#ASSERT `s 83.03(1) the person is guilty of the offence` (`s 83.03(1) test facts` `s 83.03 invites a person to provide property or financial or other related services` TRUE FALSE TRUE FALSE TRUE FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `s 83.03(1) the person is guilty of the offence` (`s 83.03(1) test facts` `s 83.03 makes available property or financial or other related services` TRUE FALSE TRUE FALSE TRUE FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `s 83.03(1) the person is guilty of the offence` (`s 83.03(1) test facts` `s 83.03 does none of those things` TRUE FALSE TRUE FALSE TRUE TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 83.03(1) the person is guilty of the offence` (`s 83.03(1) test facts` `s 83.03 collects property` FALSE FALSE TRUE FALSE TRUE FALSE) NOTHING EQUALS JUST FALSE   -- not wilfully
#ASSERT `s 83.03(1) the person is guilty of the offence` (`s 83.03(1) test facts` `s 83.03 collects property` TRUE TRUE TRUE FALSE TRUE FALSE) NOTHING EQUALS JUST FALSE   -- lawful justification or excuse
#ASSERT `s 83.03(1) the person is guilty of the offence` (`s 83.03(1) test facts` `s 83.03 collects property` TRUE FALSE FALSE FALSE TRUE FALSE) NOTHING EQUALS JUST FALSE   -- neither intending nor knowing
#ASSERT `s 83.03(1) the person is guilty of the offence` (`s 83.03(1) test facts` `s 83.03 collects property` TRUE FALSE TRUE FALSE FALSE FALSE) NOTHING EQUALS JUST FALSE   -- no purpose of (a) or (b)
#ASSERT `s 83.03(1) the person is guilty of the offence` (`s 83.03(1) test facts` `s 83.03 collects property` TRUE FALSE TRUE FALSE TRUE FALSE) (JUST TRUE) EQUALS JUST FALSE   -- subsection (4) applies: "do not apply"
#ASSERT `s 83.03(1) the person is guilty of the offence` (`s 83.03(1) test facts` `s 83.03 collects property` TRUE FALSE TRUE FALSE TRUE FALSE) (JUST FALSE) EQUALS JUST TRUE   -- the gate answered no: the offence stands
#ASSERT `s 83.03(1) the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 83.03(1) the punishment of the offence`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `ten years`

-- ---- 83.03(2): the fixture takes: act, wilfully, lawful justification or excuse, knows it will be used by or benefit the group.
GIVEN a IS A `s 83.03 act`, w IS A BOOLEAN, l IS A BOOLEAN, k IS A BOOLEAN
GIVETH A `s 83.03(2) facts`
`s 83.03(2) test facts` MEANS `s 83.03(2) facts` OF a, w, l, k

#ASSERT `s 83.03(2) the person is guilty of the offence` (`s 83.03(2) test facts` `s 83.03 makes available property or financial or other related services` TRUE FALSE TRUE) (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 83.03(2) the person is guilty of the offence` (`s 83.03(2) test facts` `s 83.03 makes available property or financial or other related services` TRUE FALSE TRUE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE   -- not a terrorist group
#ASSERT `s 83.03(2) the person is guilty of the offence` (`s 83.03(2) test facts` `s 83.03 makes available property or financial or other related services` TRUE FALSE TRUE) NOTHING NOTHING NOTHING EQUALS NOTHING   -- the group's status is not determined
#ASSERT `s 83.03(2) the person is guilty of the offence` (`s 83.03(2) test facts` `s 83.03 does none of those things` TRUE FALSE TRUE) (JUST TRUE) NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 83.03(2) the person is guilty of the offence` (`s 83.03(2) test facts` `s 83.03 collects property` FALSE FALSE TRUE) (JUST TRUE) NOTHING NOTHING EQUALS JUST FALSE   -- not wilfully
#ASSERT `s 83.03(2) the person is guilty of the offence` (`s 83.03(2) test facts` `s 83.03 collects property` TRUE TRUE TRUE) (JUST TRUE) NOTHING NOTHING EQUALS JUST FALSE   -- lawful justification or excuse
#ASSERT `s 83.03(2) the person is guilty of the offence` (`s 83.03(2) test facts` `s 83.03 collects property` TRUE FALSE FALSE) (JUST TRUE) NOTHING NOTHING EQUALS JUST FALSE   -- does not know: (2) has no "intending"
#ASSERT `s 83.03(2) the person is guilty of the offence` (`s 83.03(2) test facts` `s 83.03 collects property` TRUE FALSE TRUE) (JUST TRUE) (JUST TRUE) NOTHING EQUALS JUST FALSE   -- subsection (3): under an authorization
#ASSERT `s 83.03(2) the person is guilty of the offence` (`s 83.03(2) test facts` `s 83.03 collects property` TRUE FALSE TRUE) (JUST TRUE) NOTHING (JUST TRUE) EQUALS JUST FALSE   -- subsection (4): humanitarian
#ASSERT `s 83.03(2) the person is guilty of the offence` (`s 83.03(2) test facts` `s 83.03 collects property` TRUE FALSE TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 83.03(2) the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 83.03(2) the punishment of the offence`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `ten years`

-- ---- 83.03(3) and (4).
#ASSERT `s 83.03(3) subsection (2) does not apply to a person acting under and in accordance with an authorization` TRUE EQUALS JUST TRUE
#ASSERT `s 83.03(3) subsection (2) does not apply to a person acting under and in accordance with an authorization` FALSE EQUALS NOTHING   -- not under an authorization: the exception says nothing
#ASSERT `s 83.03(4) subsections (1) and (2) do not apply to a person carrying out humanitarian assistance activities` (`s 83.03(4) facts` OF TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `s 83.03(4) subsections (1) and (2) do not apply to a person carrying out humanitarian assistance activities` (`s 83.03(4) facts` OF TRUE, FALSE) EQUALS NOTHING   -- no reasonable efforts to minimize any benefit to terrorist groups
#ASSERT `s 83.03(4) subsections (1) and (2) do not apply to a person carrying out humanitarian assistance activities` (`s 83.03(4) facts` OF FALSE, TRUE) EQUALS NOTHING   -- not for the sole purpose of humanitarian assistance activities
#ASSERT `s 83.03(4) subsections (1) and (2) do not apply to a person carrying out humanitarian assistance activities` (`s 83.03(4) facts` OF FALSE, FALSE) EQUALS NOTHING

-- ---- 83.04: (a) uses; (b) possesses AND (intends OR knows). Fixture: uses, possesses, intends, knows.
GIVEN u IS A BOOLEAN, p IS A BOOLEAN, i IS A BOOLEAN, k IS A BOOLEAN
GIVETH A `s 83.04 facts`
`s 83.04 test facts` MEANS `s 83.04 facts` OF u, p, i, k

#ASSERT `s 83.04 the person is guilty of the offence` (`s 83.04 test facts` TRUE FALSE FALSE FALSE) EQUALS JUST TRUE   -- (a)
#ASSERT `s 83.04 the person is guilty of the offence` (`s 83.04 test facts` FALSE TRUE TRUE FALSE) EQUALS JUST TRUE   -- (b), intending
#ASSERT `s 83.04 the person is guilty of the offence` (`s 83.04 test facts` FALSE TRUE FALSE TRUE) EQUALS JUST TRUE   -- (b), knowing
#ASSERT `s 83.04 the person is guilty of the offence` (`s 83.04 test facts` FALSE TRUE FALSE FALSE) EQUALS JUST FALSE   -- possesses, but neither intends nor knows
#ASSERT `s 83.04 the person is guilty of the offence` (`s 83.04 test facts` FALSE FALSE TRUE TRUE) EQUALS JUST FALSE   -- intends and knows, but neither uses nor possesses
#ASSERT `s 83.04 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 83.04 the punishment of the offence`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `ten years`
