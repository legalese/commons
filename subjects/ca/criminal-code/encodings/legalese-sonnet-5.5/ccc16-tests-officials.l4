IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc16-officials`

-- ccc16-tests-officials.l4 -- tests for ccc16-officials.l4 (sections 483 to 485.2).
-- Expected values were decided from the text (lines 8719-8763) before the run and are written beside each assertion.

§ `s 483`
#ASSERT `s 483 the judge or provincial court judge may do alone what two or more justices are authorized to do` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 483 the judge or provincial court judge may do alone what two or more justices are authorized to do` FALSE TRUE TRUE EQUALS NOTHING   -- not a judge or provincial court judge
#ASSERT `s 483 the judge or provincial court judge may do alone what two or more justices are authorized to do` TRUE FALSE TRUE EQUALS NOTHING   -- not authorized by the law of the province
#ASSERT `s 483 the judge or provincial court judge may do alone what two or more justices are authorized to do` TRUE TRUE FALSE EQUALS NOTHING   -- not a thing two or more justices are authorized to do

§ `s 484`
#ASSERT `s 484 the judge or provincial court judge has the same power and authority to preserve order as the superior court of criminal jurisdiction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 484 the judge or provincial court judge has the same power and authority to preserve order as the superior court of criminal jurisdiction` TRUE FALSE EQUALS NOTHING   -- not the court over which the judge presides
#ASSERT `s 484 the judge or provincial court judge has the same power and authority to preserve order as the superior court of criminal jurisdiction` FALSE TRUE EQUALS NOTHING

§ `s 485(1) and (1.1)`
#ASSERT `s 485(1) jurisdiction over the offence is lost by reason of the failure` TRUE FALSE EQUALS JUST FALSE   -- not lost: a failure to act at a particular time
#ASSERT `s 485(1) jurisdiction over the offence is lost by reason of the failure` FALSE TRUE EQUALS JUST FALSE   -- not lost: a failure to comply with a provision on adjournments or remands
#ASSERT `s 485(1) jurisdiction over the offence is lost by reason of the failure` FALSE FALSE EQUALS NOTHING   -- any other reason: the subsection is silent
#ASSERT `s 485(1.1) jurisdiction over the accused is lost by reason of the failure to appear personally or in person` TRUE TRUE EQUALS JUST FALSE   -- failed to appear, the provisions permitting it apply: not lost
#ASSERT `s 485(1.1) jurisdiction over the accused is lost by reason of the failure to appear personally or in person` TRUE FALSE EQUALS NOTHING   -- "so long as" the permitting provisions apply: they do not
#ASSERT `s 485(1.1) jurisdiction over the accused is lost by reason of the failure to appear personally or in person` FALSE TRUE EQUALS NOTHING   -- the accused did appear: the subsection is silent

§ `s 485(2) -- the period`
-- "within three months after the loss of jurisdiction": loss on 15 January 2026; the last day is 15 April 2026; the day of the loss is inside, the day before is outside, the day after the last day is outside.
#ASSERT `s 485(2) the issue is within three months after the loss of jurisdiction` (Date 15 1 2026) (Date 15 4 2026)
#ASSERT `s 485(2) the issue is within three months after the loss of jurisdiction` (Date 15 1 2026) (Date 15 1 2026)
#ASSERT NOT (`s 485(2) the issue is within three months after the loss of jurisdiction` (Date 15 1 2026) (Date 16 4 2026))
#ASSERT NOT (`s 485(2) the issue is within three months after the loss of jurisdiction` (Date 15 1 2026) (Date 14 1 2026))
-- loss on 30 November 2025: there is no 30 February; the three months end on 28 February 2026 (assumed counting: NOTES.md, fork F-CNT)
#ASSERT `s 485(2) the issue is within three months after the loss of jurisdiction` (Date 30 11 2025) (Date 28 2 2026)
#ASSERT NOT (`s 485(2) the issue is within three months after the loss of jurisdiction` (Date 30 11 2025) (Date 1 3 2026))

§ `s 485(2) -- the summons and the warrant`
#ASSERT `s 485(2) the court, judge, provincial court judge or justice may issue a summons` TRUE (Date 15 1 2026) (Date 15 4 2026) EQUALS JUST TRUE
#ASSERT `s 485(2) the court, judge, provincial court judge or justice may issue a summons` TRUE (Date 15 1 2026) (Date 16 4 2026) EQUALS JUST FALSE   -- outside the three months
#ASSERT `s 485(2) the court, judge, provincial court judge or justice may issue a summons` FALSE (Date 15 1 2026) (Date 15 2 2026) EQUALS JUST FALSE   -- jurisdiction not lost, or regained
#ASSERT `s 485(2) the court, judge, provincial court judge or justice may issue a warrant for the arrest` TRUE (Date 15 1 2026) (Date 15 4 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 485(2) the court, judge, provincial court judge or justice may issue a warrant for the arrest` TRUE (Date 15 1 2026) (Date 15 4 2026) FALSE EQUALS NOTHING   -- "if it or he considers it necessary in the public interest"
#ASSERT `s 485(2) the court, judge, provincial court judge or justice may issue a warrant for the arrest` TRUE (Date 15 1 2026) (Date 16 4 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 485(2) the court, judge, provincial court judge or justice may issue a warrant for the arrest` FALSE (Date 15 1 2026) (Date 15 2 2026) TRUE EQUALS JUST FALSE

§ `s 485(3) -- dismissal for want of prosecution`
-- a summons issued within the period: no deemed dismissal
#ASSERT `s 485(3) the proceedings are deemed to be dismissed for want of prosecution` (Date 15 1 2026) (JUST (Date 15 4 2026)) (Date 1 8 2026) EQUALS JUST FALSE
-- one issued after the period: not issued "within the period provided therein"
#ASSERT `s 485(3) the proceedings are deemed to be dismissed for want of prosecution` (Date 15 1 2026) (JUST (Date 16 4 2026)) (Date 1 8 2026) EQUALS JUST TRUE
-- none issued: deemed dismissed from the day after the last day; before that the period is still running
#ASSERT `s 485(3) the proceedings are deemed to be dismissed for want of prosecution` (Date 15 1 2026) NOTHING (Date 16 4 2026) EQUALS JUST TRUE
#ASSERT `s 485(3) the proceedings are deemed to be dismissed for want of prosecution` (Date 15 1 2026) NOTHING (Date 15 4 2026) EQUALS JUST FALSE
#ASSERT `s 485(3) the proceedings are deemed to be dismissed for want of prosecution` (Date 15 1 2026) NOTHING (Date 1 2 2026) EQUALS JUST FALSE
-- recommencement: "shall not be recommenced except in accordance with section 485.1"
#ASSERT `s 485(3) the proceedings may be recommenced` TRUE (JUST TRUE) EQUALS JUST FALSE   -- section 485.1 bars a new information or indictment (no consent, no order)
#ASSERT `s 485(3) the proceedings may be recommenced` TRUE NOTHING EQUALS NOTHING   -- the consent or order of section 485.1 is present: the exception is met
#ASSERT `s 485(3) the proceedings may be recommenced` TRUE (JUST FALSE) EQUALS NOTHING   -- section 485.1 does not bar on these facts: the subsection grants nothing
#ASSERT `s 485(3) the proceedings may be recommenced` FALSE (JUST TRUE) EQUALS NOTHING   -- not deemed dismissed under subsection (3): silent

§ `s 485(4) and (5)`
#ASSERT `s 485(4) the court, judge, provincial court judge or justice may adjourn the proceeding and make an order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 485(4) the court, judge, provincial court judge or justice may adjourn the proceeding and make an order` FALSE TRUE EQUALS JUST FALSE   -- does not appear
#ASSERT `s 485(4) the court, judge, provincial court judge or justice may adjourn the proceeding and make an order` TRUE FALSE EQUALS JUST FALSE   -- not misled or prejudiced in the court's opinion
#ASSERT `s 485(5) the provisions of Part XVI apply with such modifications as the circumstances require` TRUE EQUALS JUST TRUE
#ASSERT `s 485(5) the provisions of Part XVI apply with such modifications as the circumstances require` FALSE EQUALS JUST FALSE

§ `s 485.1`
-- not dismissed: the section does not bar
#ASSERT `s 485.1 a new information or a new indictment in respect of the same transaction is barred` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- AG conducts or intervenes: (a) the personal consent in writing; a judge's order is the wrong authority here
#ASSERT `s 485.1 a new information or a new indictment in respect of the same transaction is barred` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- consent given: the "without" limit is met
#ASSERT `s 485.1 a new information or a new indictment in respect of the same transaction is barred` TRUE TRUE FALSE TRUE EQUALS JUST TRUE   -- only a judge's order in an AG prosecution: barred
#ASSERT `s 485.1 a new information or a new indictment in respect of the same transaction is barred` TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- neither: barred
-- AG does not conduct or intervene: (b) the written order of a judge; the AG's consent alone is not enough
#ASSERT `s 485.1 a new information or a new indictment in respect of the same transaction is barred` TRUE FALSE FALSE TRUE EQUALS NOTHING   -- written order given
#ASSERT `s 485.1 a new information or a new indictment in respect of the same transaction is barred` TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- AG consent alone where the AG is not in the prosecution: barred
#ASSERT `s 485.1 a new information or a new indictment in respect of the same transaction is barred` TRUE FALSE FALSE FALSE EQUALS JUST TRUE

§ `s 485.2(1)`
#ASSERT `s 485.2(1) a justice or judge may issue a summons requiring the accused or offender to appear for the purposes of the Identification of Criminals Act` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 485.2(1) a justice or judge may issue a summons requiring the accused or offender to appear for the purposes of the Identification of Criminals Act` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- no application in the form
#ASSERT `s 485.2(1) a justice or judge may issue a summons requiring the accused or offender to appear for the purposes of the Identification of Criminals Act` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- (a) fails
#ASSERT `s 485.2(1) a justice or judge may issue a summons requiring the accused or offender to appear for the purposes of the Identification of Criminals Act` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- (b) fails
#ASSERT `s 485.2(1) a justice or judge may issue a summons requiring the accused or offender to appear for the purposes of the Identification of Criminals Act` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- (c) fails

§ `s 485.2(2) to (8)`
#ASSERT `s 485.2(2) subsection (1) applies in respect of the offender` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 485.2(2) subsection (1) applies in respect of the offender` TRUE FALSE TRUE EQUALS JUST FALSE   -- "only if proceedings are ongoing"
#ASSERT `s 485.2(2) subsection (1) applies in respect of the offender` TRUE TRUE FALSE EQUALS JUST FALSE   -- sentencing concluded
#ASSERT `s 485.2(2) subsection (1) applies in respect of the offender` FALSE TRUE TRUE EQUALS NOTHING   -- an accused: the limitation is silent
#ASSERT `s 485.2(3) the application states the reasons required` TRUE EQUALS JUST TRUE
#ASSERT `s 485.2(3) the application states the reasons required` FALSE EQUALS JUST FALSE
#ASSERT `s 485.2(4) the justice or judge may proceed ex parte to determine the application` TRUE EQUALS JUST TRUE
#ASSERT `s 485.2(4) the justice or judge may proceed ex parte to determine the application` FALSE EQUALS NOTHING
#ASSERT `s 485.2(5) the application may be made by the means of telecommunication` TRUE EQUALS JUST TRUE
#ASSERT `s 485.2(5) the application may be made by the means of telecommunication` FALSE EQUALS NOTHING   -- a means that produces no writing
#ASSERT `s 485.2(6) the person may make a statement in writing instead of swearing an oath` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 485.2(6) the person may make a statement in writing instead of swearing an oath` FALSE TRUE EQUALS NOTHING
#ASSERT `s 485.2(6) the person may make a statement in writing instead of swearing an oath` TRUE FALSE EQUALS NOTHING
#ASSERT `s 485.2(6) the statement is deemed to be a statement made under oath` TRUE EQUALS JUST TRUE
#ASSERT `s 485.2(6) the statement is deemed to be a statement made under oath` FALSE EQUALS NOTHING
#ASSERT `s 485.2(7) the summons has the contents required` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 485.2(7) the summons has the contents required` FALSE TRUE TRUE EQUALS JUST FALSE   -- (a) not directed to the accused or offender
#ASSERT `s 485.2(7) the summons has the contents required` TRUE FALSE TRUE EQUALS JUST FALSE   -- (b) the offence not set out
#ASSERT `s 485.2(7) the summons has the contents required` TRUE TRUE FALSE EQUALS JUST FALSE   -- (c) no summary of the listed provisions
-- service: by a peace officer, either personally or, if the person cannot conveniently be found, at their latest or usual residence with a person who appears to be at least 16
#ASSERT `s 485.2(8) the summons was served as required` TRUE `s 485.2(8) delivered personally to the person to whom it is directed` FALSE 0 EQUALS JUST TRUE
#ASSERT `s 485.2(8) the summons was served as required` FALSE `s 485.2(8) delivered personally to the person to whom it is directed` FALSE 0 EQUALS JUST FALSE   -- not by a peace officer
#ASSERT `s 485.2(8) the summons was served as required` TRUE `s 485.2(8) left at the person's latest or usual place of residence with a person found there` TRUE 16 EQUALS JUST TRUE   -- the boundary: appears to be 16
#ASSERT `s 485.2(8) the summons was served as required` TRUE `s 485.2(8) left at the person's latest or usual place of residence with a person found there` TRUE 15 EQUALS JUST FALSE   -- appears to be 15
#ASSERT `s 485.2(8) the summons was served as required` TRUE `s 485.2(8) left at the person's latest or usual place of residence with a person found there` FALSE 30 EQUALS JUST FALSE   -- the person could conveniently have been found
#ASSERT `s 485.2(8) the summons was served as required` TRUE `s 485.2(8) served in another way` FALSE 0 EQUALS JUST FALSE   -- neither of the two ways the text names
