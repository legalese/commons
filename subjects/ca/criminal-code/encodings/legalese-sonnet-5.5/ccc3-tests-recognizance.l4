IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc3-recognizance`

-- ccc3-tests-recognizance.l4 -- tests of sections 83.3 to 83.33. Expected values are hand-written from the text beside each assertion.
-- The clock of the regulative rules is hours from the arrest. Each #TRACE line carries `-- EXPECT <outcome>`, decided from the text before the run and compared by `work/trace_check.py`.

§ `Tests of sections 83.3 to 83.33`

-- ---- 83.3(1), (2), (3).
#ASSERT `s 83.3(1) the peace officer is barred from laying an information` FALSE EQUALS JUST TRUE   -- no consent yet
#ASSERT `s 83.3(1) the peace officer is barred from laying an information` TRUE EQUALS NOTHING   -- consent given
#ASSERT `s 83.3(2) the peace officer may lay an information before a provincial court judge` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(2) the peace officer may lay an information before a provincial court judge` FALSE TRUE TRUE EQUALS JUST FALSE   -- "Subject to subsection (1)": no consent
#ASSERT `s 83.3(2) the peace officer may lay an information before a provincial court judge` TRUE FALSE TRUE EQUALS NOTHING   -- does not believe on reasonable grounds that a terrorist activity may be carried out
#ASSERT `s 83.3(2) the peace officer may lay an information before a provincial court judge` TRUE TRUE FALSE EQUALS NOTHING   -- does not suspect that a recognizance or arrest is necessary
#ASSERT `s 83.3(3) the judge may cause the person to appear before a provincial court judge` TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(3) the judge may cause the person to appear before a provincial court judge` FALSE EQUALS NOTHING

-- ---- 83.3(4): arguments: grounds exist, exigent circumstances, information laid and summons issued, suspects that detention is necessary.
#ASSERT `s 83.3(4) the peace officer may arrest the person without a warrant and cause the person to be detained in custody` TRUE TRUE FALSE TRUE EQUALS JUST TRUE   -- (a)(i)
#ASSERT `s 83.3(4) the peace officer may arrest the person without a warrant and cause the person to be detained in custody` FALSE FALSE TRUE TRUE EQUALS JUST TRUE   -- (a)(ii)
#ASSERT `s 83.3(4) the peace officer may arrest the person without a warrant and cause the person to be detained in custody` TRUE FALSE FALSE TRUE EQUALS NOTHING   -- grounds exist but no exigent circumstances, and no information and summons
#ASSERT `s 83.3(4) the peace officer may arrest the person without a warrant and cause the person to be detained in custody` FALSE TRUE FALSE TRUE EQUALS NOTHING   -- exigent circumstances without the grounds
#ASSERT `s 83.3(4) the peace officer may arrest the person without a warrant and cause the person to be detained in custody` TRUE TRUE FALSE FALSE EQUALS NOTHING   -- (b) not met: does not suspect that detention is necessary
#ASSERT `s 83.3(4) the peace officer may arrest the person without a warrant and cause the person to be detained in custody` FALSE FALSE TRUE FALSE EQUALS NOTHING

-- ---- 83.3(5), (6).
#ASSERT `s 83.3(5) the peace officer must lay an information or release the person` TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(5) the peace officer must lay an information or release the person` FALSE EQUALS JUST FALSE
#ASSERT `s 83.3(6) the rule for taking the person before a provincial court judge` FALSE TRUE EQUALS `s 83.3(6)(a) the person is to be taken before a provincial court judge without unreasonable delay and in any event within 24 hours`
#ASSERT `s 83.3(6) the rule for taking the person before a provincial court judge` FALSE FALSE EQUALS `s 83.3(6)(b) the person is to be taken before a provincial court judge as soon as feasible`
#ASSERT `s 83.3(6) the rule for taking the person before a provincial court judge` TRUE TRUE EQUALS `s 83.3(6) the person is not to be taken before a provincial court judge because the peace officer released the person without conditions`   -- "Unless ... and so releases the person"
#ASSERT `s 83.3(6) the rule for taking the person before a provincial court judge` TRUE FALSE EQUALS `s 83.3(6) the person is not to be taken before a provincial court judge because the peace officer released the person without conditions`
#ASSERT `s 83.3(6)(a) the person is taken before a provincial court judge in time` 24 TRUE EQUALS JUST TRUE   -- the 24th hour
#ASSERT `s 83.3(6)(a) the person is taken before a provincial court judge in time` 25 TRUE EQUALS JUST FALSE   -- past 24 hours
#ASSERT `s 83.3(6)(a) the person is taken before a provincial court judge in time` 1 FALSE EQUALS JUST FALSE   -- within 24 hours but with unreasonable delay
#ASSERT `s 83.3(6)(a) the person is taken before a provincial court judge in time` 0 TRUE EQUALS JUST TRUE
-- (5) as a regulative rule (hours): a judge is available within 24 hours: lay an information OR release within 24; otherwise no hour is stated ("as soon as feasible").
#TRACE `s 83.3(5) the duty to lay an information or release the person` TRUE AT 0 WITH
    PARTY `a peace officer` DOES `s 83.3(5)(a) lays an information in accordance with subsection (2)` AT 24   -- EXPECT FULFILLED
#TRACE `s 83.3(5) the duty to lay an information or release the person` TRUE AT 0 WITH
    PARTY `a peace officer` DOES `s 83.3(5)(b) releases the person` AT 24   -- EXPECT FULFILLED
#TRACE `s 83.3(5) the duty to lay an information or release the person` TRUE AT 0 WITH
    PARTY `a peace officer` DOES `s 83.3(5)(b) releases the person` AT 25   -- EXPECT BREACH
#TRACE `s 83.3(5) the duty to lay an information or release the person` TRUE AT 0 WITH
    (WAITUNTIL 25)   -- EXPECT BREACH
#TRACE `s 83.3(5) the duty to lay an information or release the person` FALSE AT 0 WITH
    PARTY `a peace officer` DOES `s 83.3(5)(a) lays an information in accordance with subsection (2)` AT 500   -- EXPECT FULFILLED
#TRACE `s 83.3(5) the duty to lay an information or release the person` FALSE AT 0 WITH
    (WAITUNTIL 500)   -- EXPECT lays an information in accordance with subsection (2)
#TRACE `s 83.3(6) the duty to take the person before a provincial court judge` TRUE AT 0 WITH
    PARTY `a peace officer` DOES `s 83.3(6) takes the person before a provincial court judge` AT 24   -- EXPECT FULFILLED
#TRACE `s 83.3(6) the duty to take the person before a provincial court judge` TRUE AT 0 WITH
    PARTY `a peace officer` DOES `s 83.3(6) takes the person before a provincial court judge` AT 25   -- EXPECT BREACH
#TRACE `s 83.3(6) the duty to take the person before a provincial court judge` TRUE AT 0 WITH
    (WAITUNTIL 25)   -- EXPECT BREACH
#TRACE `s 83.3(6) the duty to take the person before a provincial court judge` FALSE AT 0 WITH
    PARTY `a peace officer` DOES `s 83.3(6) takes the person before a provincial court judge` AT 300   -- EXPECT FULFILLED
#TRACE `s 83.3(6) the duty to take the person before a provincial court judge` FALSE AT 0 WITH
    (WAITUNTIL 300)   -- EXPECT takes the person before a provincial court judge

-- ---- 83.3(7), (7.1), (7.2).
#ASSERT `s 83.3(7)(a) the judge must order that the person be released` TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(7)(a) the judge must order that the person be released` FALSE EQUALS JUST FALSE
#ASSERT `s 83.3(7)(b)(i) the detention is justified on the ground` `s 83.3(7)(b)(i)(A) the detention is necessary to ensure the person’s appearance before a provincial court judge in order to be dealt with in accordance with subsection (8)` EQUALS JUST TRUE
#ASSERT `s 83.3(7)(b)(i) the detention is justified on the ground` `s 83.3(7)(b)(i)(B) the detention is necessary for the protection or safety of the public, including any witness, having regard to all the circumstances including the likelihood that a terrorist activity will be carried out and any substantial likelihood that the person will interfere with the administration of justice` EQUALS JUST TRUE
#ASSERT `s 83.3(7)(b)(i) the detention is justified on the ground` `s 83.3(7)(b)(i)(C) the detention is necessary to maintain confidence in the administration of justice, having regard to all the circumstances, including the apparent strength of the peace officer’s grounds under subsection (2), and the gravity of any terrorist activity that may be carried out` EQUALS JUST TRUE
#ASSERT `s 83.3(7)(b)(i) the detention is justified on the ground` `s 83.3(7)(b)(i) no ground of (A), (B) or (C)` EQUALS JUST FALSE   -- a closed list
#ASSERT `s 83.3(7)(b)(i) the judge must order that the person be released` TRUE FALSE EQUALS JUST TRUE   -- an information laid, no cause shown
#ASSERT `s 83.3(7)(b)(i) the judge must order that the person be released` TRUE TRUE EQUALS JUST FALSE   -- cause shown: the duty is lifted
#ASSERT `s 83.3(7)(b)(i) the judge must order that the person be released` FALSE FALSE EQUALS NOTHING   -- no information laid: (a) governs
#ASSERT `s 83.3(7)(b)(ii) the adjournment is within 48 hours` TRUE 48 EQUALS JUST TRUE   -- the 48th hour
#ASSERT `s 83.3(7)(b)(ii) the adjournment is within 48 hours` TRUE 49 EQUALS JUST FALSE
#ASSERT `s 83.3(7)(b)(ii) the adjournment is within 48 hours` FALSE 72 EQUALS NOTHING   -- the person is released: the cap is for a detained person
#ASSERT `s 83.3(7.1)(a) the judge must order that the person be released` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 83.3(7.1)(a) the judge must order that the person be released` TRUE TRUE FALSE EQUALS JUST TRUE   -- cause shown but the investigation is not shown to be diligent and expeditious
#ASSERT `s 83.3(7.1)(a) the judge must order that the person be released` TRUE FALSE TRUE EQUALS JUST TRUE   -- diligent, but no cause shown
#ASSERT `s 83.3(7.1)(a) the judge must order that the person be released` TRUE TRUE TRUE EQUALS JUST FALSE   -- both: the "unless" is met
#ASSERT `s 83.3(7.1)(a) the judge must order that the person be released` FALSE FALSE FALSE EQUALS NOTHING   -- no adjournment under (7)(b)(ii)
#ASSERT `s 83.3(7.1)(b) the adjournment is within 48 hours` TRUE 48 EQUALS JUST TRUE
#ASSERT `s 83.3(7.1)(b) the adjournment is within 48 hours` TRUE 49 EQUALS JUST FALSE
#ASSERT `s 83.3(7.1)(b) the adjournment is within 48 hours` FALSE 49 EQUALS NOTHING
#ASSERT `s 83.3(7.2)(a) the judge must order that the person be released` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 83.3(7.2)(a) the judge must order that the person be released` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 83.3(7.2)(a) the judge must order that the person be released` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 83.3(7.2)(a) the judge must order that the person be released` FALSE TRUE TRUE EQUALS NOTHING   -- no adjournment under (7.1)(b)
#ASSERT `s 83.3(7.2)(b) the adjournment is within 48 hours` TRUE 48 EQUALS JUST TRUE
#ASSERT `s 83.3(7.2)(b) the adjournment is within 48 hours` TRUE 49 EQUALS JUST FALSE

-- ---- 83.3(8.1), (8)(a), (8)(b). Periods are `Length of time`: years, months, days, less a day. The third input of (8)(a) is the gate FACT of (8.1) (a previous conviction of a terrorism offence): JUST TRUE yes, JUST FALSE no, NOTHING not settled.
#ASSERT `s 83.3(8.1) the judge may order the recognizance for a longer period` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 83.3(8.1) the judge may order the recognizance for a longer period` TRUE (JUST FALSE) EQUALS NOTHING   -- the previous offence was not a terrorism offence
#ASSERT `s 83.3(8.1) the judge may order the recognizance for a longer period` FALSE (JUST TRUE) EQUALS NOTHING   -- the judge is not also satisfied
#ASSERT `s 83.3(8.1) the judge may order the recognizance for a longer period` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 83.3(8)(a) the judge may order that the person enter into a recognizance` TRUE (`Length of time` OF 0, 12, 0, FALSE) NOTHING EQUALS JUST TRUE   -- exactly 12 months
#ASSERT `s 83.3(8)(a) the judge may order that the person enter into a recognizance` TRUE (`Length of time` OF 1, 0, 0, FALSE) NOTHING EQUALS JUST TRUE   -- one year is 12 months
#ASSERT `s 83.3(8)(a) the judge may order that the person enter into a recognizance` TRUE (`Length of time` OF 0, 3, 0, FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 83.3(8)(a) the judge may order that the person enter into a recognizance` TRUE (`Length of time` OF 1, 0, 1, FALSE) (JUST FALSE) EQUALS JUST FALSE   -- 12 months and a day, no longer period
#ASSERT `s 83.3(8)(a) the judge may order that the person enter into a recognizance` TRUE (`Length of time` OF 1, 1, 0, FALSE) (JUST FALSE) EQUALS JUST FALSE   -- 13 months
#ASSERT `s 83.3(8)(a) the judge may order that the person enter into a recognizance` TRUE (`Length of time` OF 1, 6, 0, FALSE) (JUST TRUE) EQUALS JUST TRUE   -- (8.1): up to two years
#ASSERT `s 83.3(8)(a) the judge may order that the person enter into a recognizance` TRUE `two years` (JUST TRUE) EQUALS JUST TRUE   -- exactly two years
#ASSERT `s 83.3(8)(a) the judge may order that the person enter into a recognizance` TRUE (`Length of time` OF 2, 0, 1, FALSE) (JUST TRUE) EQUALS JUST FALSE   -- two years and a day
#ASSERT `s 83.3(8)(a) the judge may order that the person enter into a recognizance` TRUE (`Length of time` OF 1, 6, 0, FALSE) NOTHING EQUALS NOTHING   -- whether (8.1) is open is not determined
#ASSERT `s 83.3(8)(a) the judge may order that the person enter into a recognizance` FALSE (`Length of time` OF 0, 6, 0, FALSE) NOTHING EQUALS NOTHING   -- the judge is not satisfied of reasonable grounds for the suspicion
#ASSERT `s 83.3(8)(b) the judge must order that the person be released, subject to the recognizance` TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(8)(b) the judge must order that the person be released, subject to the recognizance` FALSE EQUALS JUST FALSE

-- ---- 83.3(9) to (14).
#ASSERT `s 83.3(9) the judge may commit the person to prison` TRUE 12 EQUALS JUST TRUE   -- 12 months
#ASSERT `s 83.3(9) the judge may commit the person to prison` TRUE 13 EQUALS JUST FALSE   -- "not exceeding 12 months"
#ASSERT `s 83.3(9) the judge may commit the person to prison` FALSE 1 EQUALS NOTHING   -- the person did not fail or refuse
#ASSERT `s 83.3(10) the judge must consider whether the condition is desirable` TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(10) the judge must consider whether the condition is desirable` FALSE EQUALS NOTHING
#ASSERT `s 83.3(10) the judge must add the condition to the recognizance` TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(10) the judge must add the condition to the recognizance` FALSE EQUALS JUST FALSE
#ASSERT `s 83.3(10) the condition may prohibit the thing` `s 83.3(10) a firearm` EQUALS JUST TRUE
#ASSERT `s 83.3(10) the condition may prohibit the thing` `s 83.3(10) a cross-bow` EQUALS JUST TRUE
#ASSERT `s 83.3(10) the condition may prohibit the thing` `s 83.3(10) a prohibited weapon` EQUALS JUST TRUE
#ASSERT `s 83.3(10) the condition may prohibit the thing` `s 83.3(10) a restricted weapon` EQUALS JUST TRUE
#ASSERT `s 83.3(10) the condition may prohibit the thing` `s 83.3(10) a prohibited device` EQUALS JUST TRUE
#ASSERT `s 83.3(10) the condition may prohibit the thing` `s 83.3(10) a firearm part` EQUALS JUST TRUE
#ASSERT `s 83.3(10) the condition may prohibit the thing` `s 83.3(10) ammunition` EQUALS JUST TRUE
#ASSERT `s 83.3(10) the condition may prohibit the thing` `s 83.3(10) prohibited ammunition` EQUALS JUST TRUE
#ASSERT `s 83.3(10) the condition may prohibit the thing` `s 83.3(10) an explosive substance` EQUALS JUST TRUE
#ASSERT `s 83.3(10) the condition may prohibit the thing` `s 83.3(10) something that is none of those` EQUALS NOTHING
#ASSERT `s 83.3(11) the judge must specify the manner and method` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(11) the judge must specify the manner and method` TRUE FALSE TRUE EQUALS JUST FALSE   -- (a) not specified
#ASSERT `s 83.3(11) the judge must specify the manner and method` TRUE TRUE FALSE EQUALS JUST FALSE   -- (b) not specified
#ASSERT `s 83.3(11) the judge must specify the manner and method` FALSE TRUE TRUE EQUALS JUST FALSE   -- the condition of (10) was not added: no duty
#ASSERT `s 83.3(11.1) the judge must consider whether the passport condition is desirable` TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(11.1) the judge must consider whether the passport condition is desirable` FALSE EQUALS NOTHING
#ASSERT `s 83.3(11.1) the judge must add the passport condition and specify the period` TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(11.1) the judge must add the passport condition and specify the period` FALSE EQUALS JUST FALSE
#ASSERT `s 83.3(11.2) the judge must consider whether the geographic-area condition is desirable` TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(11.2) the judge must consider whether the geographic-area condition is desirable` FALSE EQUALS NOTHING
#ASSERT `s 83.3(11.2) the judge must add the geographic-area condition and specify the period` TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(11.2) the judge must add the geographic-area condition and specify the period` FALSE EQUALS JUST FALSE
#ASSERT `s 83.3(11.2) the person is barred from leaving the specified geographic area` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 83.3(11.2) the person is barred from leaving the specified geographic area` TRUE TRUE EQUALS JUST FALSE   -- "unless written permission ... is obtained"
#ASSERT `s 83.3(11.2) the person is barred from leaving the specified geographic area` FALSE FALSE EQUALS NOTHING   -- no such condition in the recognizance
#ASSERT `s 83.3(12) the judge must include a statement of reasons in the record` TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(12) the judge must include a statement of reasons in the record` FALSE EQUALS JUST FALSE
#ASSERT `s 83.3(13) the judge may vary the conditions` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.3(13) the judge may vary the conditions` TRUE FALSE EQUALS NOTHING   -- not the judge or another judge of the same court
#ASSERT `s 83.3(13) the judge may vary the conditions` FALSE TRUE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `#ASSERT `s 83.3(13) the judge may vary the conditions` FALSE TRUE EQUALS NOTHING`; "on application of the peace officer, the Attorney General or the person" is a group (i) gate of a "may" function, JUST FALSE as ruling (b) of 2026-11-05 says (fork F-ccc3-11)
#ASSERT `s 83.3(14) the provision applies to proceedings under this section` (`Provision of the Code` OF 810, "(4)") EQUALS JUST TRUE
#ASSERT `s 83.3(14) the provision applies to proceedings under this section` (`Provision of the Code` OF 810, "(5)") EQUALS JUST TRUE
#ASSERT `s 83.3(14) the provision applies to proceedings under this section` (`Provision of the Code` OF 810, "(3)") EQUALS NOTHING
#ASSERT `s 83.3(14) the provision applies to proceedings under this section` (`Provision of the Code` OF 811, "") EQUALS NOTHING

-- ---- 83.31.
#ASSERT `s 83.31(2) the report must be prepared and laid before Parliament or published` TRUE EQUALS JUST TRUE
#ASSERT `s 83.31(2) the report must be prepared and laid before Parliament or published` FALSE EQUALS NOTHING
#ASSERT `s 83.31(2) the report includes the item` `s 83.31(2)(a) the number of consents to lay an information that were sought, and the number that were obtained, by virtue of subsections 83.3(1) and (2)` EQUALS JUST TRUE
#ASSERT `s 83.31(2) the report includes the item` `s 83.31(2)(b) the number of cases in which a summons or a warrant of arrest was issued for the purposes of subsection 83.3(3)` EQUALS JUST TRUE
#ASSERT `s 83.31(2) the report includes the item` `s 83.31(2)(c) the number of cases in which a person was not released under subsection 83.3(7), (7.1) or (7.2) pending a hearing` EQUALS JUST TRUE
#ASSERT `s 83.31(2) the report includes the item` `s 83.31(2)(d) the number of cases in which an order to enter into a recognizance was made under paragraph 83.3(8)(a), and the types of conditions that were imposed` EQUALS JUST TRUE
#ASSERT `s 83.31(2) the report includes the item` `s 83.31(2)(e) the number of times that a person failed or refused to enter into a recognizance, and the term of imprisonment imposed under subsection 83.3(9) in each case` EQUALS JUST TRUE
#ASSERT `s 83.31(2) the report includes the item` `s 83.31(2)(f) the number of cases in which the conditions fixed in a recognizance were varied under subsection 83.3(13)` EQUALS JUST TRUE
#ASSERT `s 83.31(2) the report includes the item` `s 83.31(2) another item` EQUALS NOTHING
#ASSERT `s 83.31(3) the report includes the item` `s 83.31(3)(a) the number of arrests without warrant that were made under subsection 83.3(4) and the period of the arrested person’s detention in custody in each case` EQUALS JUST TRUE
#ASSERT `s 83.31(3) the report includes the item` `s 83.31(3)(b)(i) the number of cases in which a person was arrested without warrant under subsection 83.3(4) and was released by a peace officer under paragraph 83.3(5)(b)` EQUALS JUST TRUE
#ASSERT `s 83.31(3) the report includes the item` `s 83.31(3)(b)(ii) the number of cases in which a person was arrested without warrant under subsection 83.3(4) and was released by a judge under paragraph 83.3(7)(a), (7.1)(a) or (7.2)(a)` EQUALS JUST TRUE
#ASSERT `s 83.31(3) the report includes the item` `s 83.31(3) another item` EQUALS NOTHING
#ASSERT `s 83.31(3.1) the report includes the opinion` TRUE EQUALS JUST TRUE
#ASSERT `s 83.31(3.1) the report includes the opinion` FALSE EQUALS NOTHING
#ASSERT `s 83.31(4) the report is barred from containing the information` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 83.31(4) the report is barred from containing the information` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 83.31(4) the report is barred from containing the information` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 83.31(4) the report is barred from containing the information` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 83.31(4) the report is barred from containing the information` FALSE FALSE FALSE FALSE EQUALS NOTHING

-- ---- 83.32(1): royal assent on 21 June 2017 (a fixture date: the text does not say), so the fifth anniversary is 21 June 2022.
#ASSERT `s 83.32(1) section 83.3 has ceased to have effect on the day` (Date 21 6 2017) NOTHING (Date 21 6 2022) EQUALS JUST FALSE   -- in effect through the fifth anniversary
#ASSERT `s 83.32(1) section 83.3 has ceased to have effect on the day` (Date 21 6 2017) NOTHING (Date 22 6 2022) EQUALS JUST TRUE   -- the day after
#ASSERT `s 83.32(1) section 83.3 has ceased to have effect on the day` (Date 21 6 2017) NOTHING (Date 1 1 2018) EQUALS JUST FALSE
#ASSERT `s 83.32(1) section 83.3 has ceased to have effect on the day` (Date 21 6 2017) (JUST (Date 21 6 2027)) (Date 22 6 2022) EQUALS JUST FALSE   -- extended to 21 June 2027
#ASSERT `s 83.32(1) section 83.3 has ceased to have effect on the day` (Date 21 6 2017) (JUST (Date 21 6 2027)) (Date 21 6 2027) EQUALS JUST FALSE   -- the last day of the extension
#ASSERT `s 83.32(1) section 83.3 has ceased to have effect on the day` (Date 21 6 2017) (JUST (Date 21 6 2027)) (Date 22 6 2027) EQUALS JUST TRUE
#ASSERT `s 83.32(2) the extension is not more than five years` `five years` EQUALS JUST TRUE
#ASSERT `s 83.32(2) the extension is not more than five years` (`Length of time` OF 4, 11, 0, FALSE) EQUALS JUST TRUE
#ASSERT `s 83.32(2) the extension is not more than five years` (`Length of time` OF 5, 0, 1, FALSE) EQUALS JUST FALSE
#ASSERT `s 83.32(2) the extension is not more than five years` `ten years` EQUALS JUST FALSE
#ASSERT `s 83.32(4) the extension operates as the first does` TRUE EQUALS JUST TRUE
#ASSERT `s 83.32(4) the extension operates as the first does` FALSE EQUALS NOTHING

-- ---- 83.32(1.1), (1.2), (2), (3), (4)(b): the review, the report, the order and the rules of the motion. Royal assent on 21 June 2017 is a fixture date (the text does not give it).
#ASSERT `s 83.32(1.1) the committee must undertake a comprehensive review of section 83.3 and its operation` TRUE EQUALS JUST TRUE
#ASSERT `s 83.32(1.1) the committee must undertake a comprehensive review of section 83.3 and its operation` FALSE EQUALS NOTHING   -- not a committee designated or established for that purpose
#ASSERT `s 83.32(1.2) the last day for the committee's report` (Date 21 6 2017) NOTHING EQUALS Date 21 6 2021   -- one year before the fifth anniversary (21 June 2022)
#ASSERT `s 83.32(1.2) the last day for the committee's report` (Date 21 6 2017) (JUST (Date 21 6 2027)) EQUALS Date 21 6 2026   -- (4)(b): one year before the expiry of the most recent extension
#ASSERT `s 83.32(1.2) the report is submitted in time` (Date 21 6 2021) (Date 21 6 2021) EQUALS JUST TRUE   -- on the last day: "no later than"
#ASSERT `s 83.32(1.2) the report is submitted in time` (Date 21 6 2021) (Date 20 6 2021) EQUALS JUST TRUE
#ASSERT `s 83.32(1.2) the report is submitted in time` (Date 21 6 2021) (Date 22 6 2021) EQUALS JUST FALSE   -- the day after
#ASSERT `s 83.32(1.2) the report includes the committee's recommendation` TRUE EQUALS JUST TRUE
#ASSERT `s 83.32(1.2) the report includes the committee's recommendation` FALSE EQUALS JUST FALSE   -- a report without its recommendation on extending the operation
#ASSERT `s 83.32(2) the Governor in Council may establish the text of the resolution by order` TRUE EQUALS JUST TRUE
#ASSERT `s 83.32(2) the Governor in Council may establish the text of the resolution by order` FALSE EQUALS NOTHING   -- not a resolution that provides for the extension and specifies its period
#ASSERT `s 83.32(3) the motion may be debated in both Houses` TRUE EQUALS JUST TRUE
#ASSERT `s 83.32(3) the motion may be debated in both Houses` FALSE EQUALS NOTHING   -- not a motion for the adoption of the resolution: the subsection says nothing
#ASSERT `s 83.32(3) the motion is barred from being amended` TRUE EQUALS JUST TRUE   -- "may not be amended"
#ASSERT `s 83.32(3) the motion is barred from being amended` FALSE EQUALS NOTHING
#ASSERT `s 83.32(3) the Speaker must immediately put every question` TRUE EQUALS JUST TRUE   -- at the conclusion of the debate
#ASSERT `s 83.32(3) the Speaker must immediately put every question` FALSE EQUALS JUST FALSE   -- the debate has not concluded: the duty has not arisen

-- ---- 83.33(2). Arguments: 83.3 has ceased (by s 83.32), the person is detained under 83.3, the person was taken before a judge under (6) before it ceased.
#ASSERT `s 83.33(2) the person must be released when section 83.3 ceases to have effect` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 83.33(2) the person must be released when section 83.3 ceases to have effect` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE   -- "except that subsections 83.3(7) to (14) continue to apply"
#ASSERT `s 83.33(2) the person must be released when section 83.3 ceases to have effect` (JUST FALSE) TRUE FALSE EQUALS JUST FALSE   -- 83.3 has not ceased to have effect
#ASSERT `s 83.33(2) the person must be released when section 83.3 ceases to have effect` NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 83.33(2) the person must be released when section 83.3 ceases to have effect` (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- not a person detained under 83.3
#ASSERT `s 83.33(2) the provision continues to apply` (`Provision of the Code` OF 83.3, "(7)") TRUE EQUALS JUST TRUE
#ASSERT `s 83.33(2) the provision continues to apply` (`Provision of the Code` OF 83.3, "(7.2)") TRUE EQUALS JUST TRUE
#ASSERT `s 83.33(2) the provision continues to apply` (`Provision of the Code` OF 83.3, "(14)") TRUE EQUALS JUST TRUE   -- the last of (7) to (14)
#ASSERT `s 83.33(2) the provision continues to apply` (`Provision of the Code` OF 83.3, "(11.2)") TRUE EQUALS JUST TRUE
#ASSERT `s 83.33(2) the provision continues to apply` (`Provision of the Code` OF 83.3, "(6)") TRUE EQUALS NOTHING   -- (6) is before the range
#ASSERT `s 83.33(2) the provision continues to apply` (`Provision of the Code` OF 83.3, "(15)") TRUE EQUALS NOTHING
#ASSERT `s 83.33(2) the provision continues to apply` (`Provision of the Code` OF 83.31, "(2)") TRUE EQUALS NOTHING
#ASSERT `s 83.33(2) the provision continues to apply` (`Provision of the Code` OF 83.3, "(8)") FALSE EQUALS NOTHING   -- not a person taken before a judge under (6) before 83.3 ceased
