IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc6-builders`
IMPORT `ccc6-morals`
IMPORT `ccc6-tests-support`

-- Tests for ss 163, 167, 168 and 169. Expected values decided from the text before each run.

`s 169 test s 787(1) penalty` MEANS Punishment OF `by indictment`, `imprisonment for a term of` `six months`, `no imprisonment is stated`, `a fine in the discretion of the court`, `no fine is stated`
`s 169 test summary penalty` MEANS Punishment OF `on summary conviction`, `imprisonment for a term of` `six months`, `no imprisonment is stated`, `a fine in the discretion of the court`, `no fine is stated`

§ `s 163(1) Obscene materials`
#ASSERT `s 163(1) the conduct is the offence of making or publishing obscene matter` `s 163(1) makes` TRUE EQUALS JUST TRUE
#ASSERT `s 163(1) the conduct is the offence of making or publishing obscene matter` `s 163(1) prints` TRUE EQUALS JUST TRUE
#ASSERT `s 163(1) the conduct is the offence of making or publishing obscene matter` `s 163(1) publishes` TRUE EQUALS JUST TRUE
#ASSERT `s 163(1) the conduct is the offence of making or publishing obscene matter` `s 163(1) distributes` TRUE EQUALS JUST TRUE
#ASSERT `s 163(1) the conduct is the offence of making or publishing obscene matter` `s 163(1) circulates` TRUE EQUALS JUST TRUE
#ASSERT `s 163(1) the conduct is the offence of making or publishing obscene matter` `s 163(1) has in their possession for the purpose of publication, distribution or circulation` TRUE EQUALS JUST TRUE
#ASSERT `s 163(1) the conduct is the offence of making or publishing obscene matter` `s 163(1) none of those` TRUE EQUALS NOTHING
#ASSERT `s 163(1) the conduct is the offence of making or publishing obscene matter` `s 163(1) publishes` FALSE EQUALS NOTHING   -- the thing is not obscene

§ `s 163(2) selling, exposing to public view, exhibiting`
-- (knowingly, without lawful justification or excuse, what was done, obscene thing)
#ASSERT `s 163(2) the conduct is the offence of selling obscene matter or exhibiting an indecent show` TRUE TRUE `s 163(2)(a) sells` TRUE EQUALS JUST TRUE
#ASSERT `s 163(2) the conduct is the offence of selling obscene matter or exhibiting an indecent show` TRUE TRUE `s 163(2)(a) exposes to public view` TRUE EQUALS JUST TRUE
#ASSERT `s 163(2) the conduct is the offence of selling obscene matter or exhibiting an indecent show` TRUE TRUE `s 163(2)(a) has in their possession for that purpose` TRUE EQUALS JUST TRUE
#ASSERT `s 163(2) the conduct is the offence of selling obscene matter or exhibiting an indecent show` TRUE TRUE `s 163(2)(a) sells` FALSE EQUALS NOTHING   -- (a) needs an obscene thing
#ASSERT `s 163(2) the conduct is the offence of selling obscene matter or exhibiting an indecent show` TRUE TRUE `s 163(2)(b) publicly exhibits a disgusting object` FALSE EQUALS JUST TRUE   -- (b) does not ask for an obscene thing
#ASSERT `s 163(2) the conduct is the offence of selling obscene matter or exhibiting an indecent show` TRUE TRUE `s 163(2)(b) publicly exhibits an indecent show` FALSE EQUALS JUST TRUE
#ASSERT `s 163(2) the conduct is the offence of selling obscene matter or exhibiting an indecent show` FALSE TRUE `s 163(2)(a) sells` TRUE EQUALS NOTHING   -- not knowingly
#ASSERT `s 163(2) the conduct is the offence of selling obscene matter or exhibiting an indecent show` TRUE FALSE `s 163(2)(b) publicly exhibits an indecent show` FALSE EQUALS NOTHING   -- with lawful justification or excuse
#ASSERT `s 163(2) the conduct is the offence of selling obscene matter or exhibiting an indecent show` TRUE TRUE `s 163(2) none of those` TRUE EQUALS NOTHING

§ `s 163(3) to (5) public good, law and fact, motives`
#ASSERT `s 163(3) section 163 gives a defence of public good` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 163(3) section 163 gives a defence of public good` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 163(3) section 163 gives a defence of public good` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 163(4) the question is a question of law` `s 163(4) whether an act served the public good` EQUALS JUST TRUE
#ASSERT `s 163(4) the question is a question of law` `s 163(4) whether there is evidence that the act alleged went beyond what served the public good` EQUALS JUST TRUE
#ASSERT `s 163(4) the question is a question of law` `s 163(4) whether the acts did or did not extend beyond what served the public good` EQUALS JUST FALSE
#ASSERT `s 163(4) the question is a question of law` `s 163(4) another question` EQUALS NOTHING
#ASSERT `s 163(5) the motives of an accused are relevant` TRUE EQUALS JUST FALSE
#ASSERT `s 163(5) the motives of an accused are relevant` FALSE EQUALS NOTHING

§ `s 163(8) Obscene publication`
-- (a dominant characteristic is the undue exploitation of sex, of sex alone or of sex with crime, horror, cruelty or violence)
#ASSERT `s 163(8) the publication is deemed to be obscene` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 163(8) the publication is deemed to be obscene` TRUE FALSE EQUALS NOTHING   -- sex with some other subject: not named, so not covered
#ASSERT `s 163(8) the publication is deemed to be obscene` FALSE TRUE EQUALS NOTHING   -- no undue exploitation of sex
#ASSERT `s 163(8) the publication is deemed to be obscene` FALSE FALSE EQUALS NOTHING

§ `s 167 Immoral theatrical performance`
-- (1): (lessee, manager, agent or person in charge; the answer of s 150 theatre; what was done; immoral, indecent or obscene)
#ASSERT `s 167(1) the conduct is the offence of presenting an immoral theatrical performance` TRUE (JUST TRUE) `s 167(1) presents` TRUE EQUALS JUST TRUE
#ASSERT `s 167(1) the conduct is the offence of presenting an immoral theatrical performance` TRUE (JUST TRUE) `s 167(1) gives` TRUE EQUALS JUST TRUE
#ASSERT `s 167(1) the conduct is the offence of presenting an immoral theatrical performance` TRUE (JUST TRUE) `s 167(1) allows to be presented or given` TRUE EQUALS JUST TRUE
#ASSERT `s 167(1) the conduct is the offence of presenting an immoral theatrical performance` FALSE (JUST TRUE) `s 167(1) presents` TRUE EQUALS NOTHING   -- not the lessee, manager, agent or person in charge
#ASSERT `s 167(1) the conduct is the offence of presenting an immoral theatrical performance` TRUE NOTHING `s 167(1) presents` TRUE EQUALS NOTHING   -- s 150 "theatre" is an "includes" definition: not answered
#ASSERT `s 167(1) the conduct is the offence of presenting an immoral theatrical performance` TRUE (JUST TRUE) `s 167(1) none of those` TRUE EQUALS NOTHING
#ASSERT `s 167(1) the conduct is the offence of presenting an immoral theatrical performance` TRUE (JUST TRUE) `s 167(1) presents` FALSE EQUALS NOTHING
-- (2): (takes part, immoral, the answer of s 150 theatre)
#ASSERT `s 167(2) the conduct is the offence of taking part in an immoral theatrical performance` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 167(2) the conduct is the offence of taking part in an immoral theatrical performance` FALSE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 167(2) the conduct is the offence of taking part in an immoral theatrical performance` TRUE FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 167(2) the conduct is the offence of taking part in an immoral theatrical performance` TRUE TRUE NOTHING EQUALS NOTHING

§ `s 168 Mailing obscene matter`
#ASSERT `s 168(1) the conduct is the offence of mailing obscene matter` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 168(1) the conduct is the offence of mailing obscene matter` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 168(1) the conduct is the offence of mailing obscene matter` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 168(1) the conduct is the offence of mailing obscene matter` TRUE TRUE FALSE EQUALS NOTHING
-- (2): (a) judicial proceedings, (b) a notice or report under a court's direction, (c)(i) a genuine series of law reports, (c)(ii) a technical publication in good faith
#ASSERT `s 168(2) subsection (1) applies to the person` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 168(2) subsection (1) applies to the person` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 168(2) subsection (1) applies to the person` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 168(2) subsection (1) applies to the person` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 168(2) subsection (1) applies to the person` FALSE FALSE FALSE FALSE EQUALS NOTHING   -- a person in none of the four: the subsection is silent

§ `s 169 Punishment`
#ASSERT `s 169 the offence is one under section 163, 165, 167 or 168` (`Provision of the Code` OF 163, "(1)") EQUALS TRUE
#ASSERT `s 169 the offence is one under section 163, 165, 167 or 168` (`Provision of the Code` OF 165, "") EQUALS TRUE   -- section 165 is shown repealed but is still named
#ASSERT `s 169 the offence is one under section 163, 165, 167 or 168` (`Provision of the Code` OF 167, "(2)") EQUALS TRUE
#ASSERT `s 169 the offence is one under section 163, 165, 167 or 168` (`Provision of the Code` OF 168, "(1)") EQUALS TRUE
#ASSERT `s 169 the offence is one under section 163, 165, 167 or 168` (`Provision of the Code` OF 163.1, "(2)") EQUALS FALSE   -- 163.1 is not 163
#ASSERT `s 169 the offence is one under section 163, 165, 167 or 168` (`Provision of the Code` OF 164, "") EQUALS FALSE
#ASSERT `s 169 the offence is one under section 163, 165, 167 or 168` (`Provision of the Code` OF 166, "") EQUALS FALSE
#ASSERT `s 169(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 2) `no imprisonment is stated`   -- "not exceeding two years"
#ASSERT `s 169(b) the punishment on summary conviction` `s 169 test s 787(1) penalty` EQUALS `s 169 test summary penalty`
#ASSERT `s 169 the class of an offence under section 163, 165, 167 or 168` EQUALS `ss 150 to 182 test both`
