IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc17-journalists`

-- ccc17-tests-journalists.l4 -- tests for ccc17-journalists.l4 (ss 488.01, 488.02). Expected values are written from the text, beside each assertion.

§ `Tests: s 488.01(1) definitions`

#ASSERT `s 488.01(1) the definitions apply in this section and in section 488.02` EQUALS TRUE
#ASSERT `s 488.01(1) data` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 488.01(1) data` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 488.01(1) data` NOTHING EQUALS NOTHING
#ASSERT `s 488.01(1) document` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 488.01(1) document` NOTHING EQUALS NOTHING
#ASSERT `s 488.01(1) journalist` TRUE EQUALS JUST TRUE
#ASSERT `s 488.01(1) journalist` FALSE EQUALS NOTHING
#ASSERT `s 488.01(1) journalistic source` TRUE EQUALS JUST TRUE
#ASSERT `s 488.01(1) journalistic source` FALSE EQUALS NOTHING
-- "officer means a peace officer or public officer"
#ASSERT `s 488.01(1) officer` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 488.01(1) officer` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 488.01(1) officer` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 488.01(1) officer` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 488.01(1) officer` NOTHING NOTHING EQUALS NOTHING

§ `Tests: s 488.01(2) to (10) the application and the judge`

-- (2): the named instruments (single sections 487.01, 492.1, 492.2, 184.2, 186, 188; range 487.014 to 487.017; any search warrant under this Act)
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE 487.01 FALSE EQUALS JUST TRUE
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE 492.1 FALSE EQUALS JUST TRUE
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE 492.2 FALSE EQUALS JUST TRUE
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE 184.2 FALSE EQUALS JUST TRUE
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE 186 FALSE EQUALS JUST TRUE
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE 188 FALSE EQUALS JUST TRUE
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE 487.014 FALSE EQUALS JUST TRUE
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE 487.017 FALSE EQUALS JUST TRUE
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE 487.013 FALSE EQUALS NOTHING
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE 487.018 FALSE EQUALS NOTHING
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE 487 TRUE EQUALS JUST TRUE
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE 320 FALSE EQUALS NOTHING
#ASSERT `s 488.01(2) the applicant shall make the application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` FALSE 487.01 FALSE EQUALS JUST FALSE
#ASSERT count `s 488.01(2) the sections named` EQUALS 6
#ASSERT `s 488.01(2) the judge has exclusive jurisdiction to dispose of the application` TRUE EQUALS JUST TRUE
#ASSERT `s 488.01(2) the judge has exclusive jurisdiction to dispose of the application` FALSE EQUALS NOTHING
-- (3): "only if"
#ASSERT `s 488.01(3) the judge may issue the warrant, authorization or order` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 488.01(3) the judge may issue the warrant, authorization or order` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 488.01(3) the judge may issue the warrant, authorization or order` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 488.01(3) the judge may issue the warrant, authorization or order` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 488.01(4) the judge may request that a special advocate present observations in the interests of freedom of the press concerning the conditions set out in subsection (3)` TRUE EQUALS JUST TRUE
#ASSERT `s 488.01(4) the judge may request that a special advocate present observations in the interests of freedom of the press concerning the conditions set out in subsection (3)` FALSE EQUALS NOTHING
#ASSERT `s 488.01(5) subsections (3) and (4) do not apply` TRUE EQUALS JUST TRUE
#ASSERT `s 488.01(5) subsections (3) and (4) do not apply` FALSE EQUALS NOTHING
#ASSERT `s 488.01(6) the judge may order that some or all documents obtained are to be dealt with in accordance with section 488.02` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 488.01(6) the judge may order that some or all documents obtained are to be dealt with in accordance with section 488.02` TRUE FALSE EQUALS NOTHING
#ASSERT `s 488.01(6) the judge may order that some or all documents obtained are to be dealt with in accordance with section 488.02` FALSE TRUE EQUALS NOTHING
#ASSERT `s 488.01(7) the warrant, authorization or order may contain the condition` TRUE EQUALS JUST TRUE
#ASSERT `s 488.01(7) the warrant, authorization or order may contain the condition` FALSE EQUALS NOTHING
#ASSERT `s 488.01(8) the judge has the same powers, with the necessary adaptations, as the authority who may issue the warrant, authorization or order` TRUE EQUALS JUST TRUE
#ASSERT `s 488.01(8) the judge has the same powers, with the necessary adaptations, as the authority who may issue the warrant, authorization or order` FALSE EQUALS NOTHING
-- (9): the duties of an officer who discovers the relation to a journalist; the "until" bar
#ASSERT `s 488.01(9) the officer shall, as soon as possible, make an ex parte application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` TRUE EQUALS JUST TRUE
#ASSERT `s 488.01(9) the officer shall, as soon as possible, make an ex parte application to a judge of a superior court of criminal jurisdiction or a judge as defined in section 552` FALSE EQUALS JUST FALSE
#ASSERT `s 488.01(9) until the judge disposes of the application the officer shall refrain from examining or reproducing any document obtained and shall keep it in a sealed packet` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 488.01(9) until the judge disposes of the application the officer shall refrain from examining or reproducing any document obtained and shall keep it in a sealed packet` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 488.01(9) until the judge disposes of the application the officer shall refrain from examining or reproducing any document obtained and shall keep it in a sealed packet` FALSE FALSE EQUALS JUST FALSE
-- (10): the four orders on an application under (9), each needing its own opinion
#ASSERT `s 488.01(10) the judge may make the order` TRUE `s 488.01(10)(a) confirm the warrant, authorization or order` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 488.01(10) the judge may make the order` TRUE `s 488.01(10)(a) confirm the warrant, authorization or order` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 488.01(10) the judge may make the order` TRUE `s 488.01(10)(b) vary the warrant, authorization or order to impose conditions` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 488.01(10) the judge may make the order` TRUE `s 488.01(10)(b) vary the warrant, authorization or order to impose conditions` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 488.01(10) the judge may make the order` TRUE `s 488.01(10)(c) order that some or all documents are to be dealt with in accordance with section 488.02` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 488.01(10) the judge may make the order` TRUE `s 488.01(10)(c) order that some or all documents are to be dealt with in accordance with section 488.02` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 488.01(10) the judge may make the order` TRUE `s 488.01(10)(d) revoke the warrant, authorization or order` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 488.01(10) the judge may make the order` TRUE `s 488.01(10)(d) revoke the warrant, authorization or order` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 488.01(10) the judge may make the order` FALSE `s 488.01(10)(a) confirm the warrant, authorization or order` TRUE TRUE TRUE TRUE EQUALS NOTHING

§ `Tests: s 488.02 documents`

#ASSERT `s 488.02(1) the document shall be placed in a packet and sealed by the court and kept in the custody of the court` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 488.02(1) the document shall be placed in a packet and sealed by the court and kept in the custody of the court` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 488.02(1) the document shall be placed in a packet and sealed by the court and kept in the custody of the court` FALSE FALSE EQUALS NOTHING
#ASSERT `s 488.02(2) the officer is barred from examining or reproducing the document` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 488.02(2) the officer is barred from examining or reproducing the document` TRUE TRUE EQUALS NOTHING
#ASSERT `s 488.02(2) the officer is barred from examining or reproducing the document` FALSE FALSE EQUALS NOTHING
-- (3): within 10 days of receiving the notice. Notice received 1 March 2026: the 10th day is 11 March 2026.
#ASSERT `s 488.02(3) the last day on which the application may be made` (Date 1 3 2026) EQUALS Date 11 3 2026
#ASSERT `s 488.02(3) the journalist or media outlet may apply to a judge of the court that issued the warrant, authorization or order for an order that the document is not to be disclosed to an officer` `s 488.02(3) the journalist` TRUE (Date 1 3 2026) (Date 11 3 2026) EQUALS JUST TRUE
#ASSERT `s 488.02(3) the journalist or media outlet may apply to a judge of the court that issued the warrant, authorization or order for an order that the document is not to be disclosed to an officer` `s 488.02(3) the relevant media outlet` TRUE (Date 1 3 2026) (Date 5 3 2026) EQUALS JUST TRUE
#ASSERT `s 488.02(3) the journalist or media outlet may apply to a judge of the court that issued the warrant, authorization or order for an order that the document is not to be disclosed to an officer` `s 488.02(3) the journalist` TRUE (Date 1 3 2026) (Date 12 3 2026) EQUALS JUST FALSE
#ASSERT `s 488.02(3) the journalist or media outlet may apply to a judge of the court that issued the warrant, authorization or order for an order that the document is not to be disclosed to an officer` `s 488.02(3) someone else` TRUE (Date 1 3 2026) (Date 5 3 2026) EQUALS NOTHING
#ASSERT `s 488.02(3) the journalist or media outlet may apply to a judge of the court that issued the warrant, authorization or order for an order that the document is not to be disclosed to an officer` `s 488.02(3) the journalist` FALSE (Date 1 3 2026) (Date 5 3 2026) EQUALS NOTHING
-- (4): "only following a disclosure order in accordance with paragraph (7)(b)"
#ASSERT `s 488.02(4) the document is not to be disclosed to an officer` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 488.02(4) the document is not to be disclosed to an officer` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 488.02(4) the document is not to be disclosed to an officer` FALSE FALSE EQUALS NOTHING
#ASSERT `s 488.02(5) the judge may order the disclosure of the document` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 488.02(5) the judge may order the disclosure of the document` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 488.02(5) the judge may order the disclosure of the document` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 488.02(6) the judge may examine the document` TRUE EQUALS JUST TRUE
#ASSERT `s 488.02(6) the judge may examine the document` FALSE EQUALS NOTHING
#ASSERT `s 488.02(7) the order the judge must make` TRUE FALSE EQUALS JUST `s 488.02(7)(a) the document is returned to the journalist or the media outlet`
#ASSERT `s 488.02(7) the order the judge must make` FALSE TRUE EQUALS JUST `s 488.02(7)(b) the document is delivered to the officer who gave the notice, subject to such restrictions and conditions as the judge deems appropriate`
#ASSERT `s 488.02(7) the order the judge must make` FALSE FALSE EQUALS NOTHING
#ASSERT `s 488.02(7) the order the judge must make` TRUE TRUE EQUALS NOTHING
