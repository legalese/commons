IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc26-interpretation`
IMPORT `ccc26-discharge`

-- ccc26-tests-discharge.l4 -- tests for ccc26-discharge.l4. Every expected value is written from the text before the run.
-- (sections 729.2 and 730; lines 15468-15495 of the text)


§ `s 729.2(1): the court may make an order prohibiting contact when the offender is convicted or discharged on probation conditions of a sexual, harassment, trafficking or intimate-partner offence`

-- convicted of an offence of a sexual nature
#ASSERT `s 729.2(1) the court may make an order prohibiting the offender from having any contact` TRUE FALSE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
-- convicted of an offence related to criminal harassment or trafficking in persons
#ASSERT `s 729.2(1) the court may make an order prohibiting the offender from having any contact` TRUE FALSE TRUE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
-- convicted of an offence committed against the offender's intimate partner
#ASSERT `s 729.2(1) the court may make an order prohibiting the offender from having any contact` TRUE FALSE TRUE FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
-- discharged under section 730 on the conditions prescribed in a probation order
#ASSERT `s 729.2(1) the court may make an order prohibiting the offender from having any contact` FALSE TRUE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
-- neither convicted nor discharged on probation conditions: the "When" gate fails
#ASSERT `s 729.2(1) the court may make an order prohibiting the offender from having any contact` FALSE FALSE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
-- not the court that imposes the sentence or directs the discharge
#ASSERT `s 729.2(1) the court may make an order prohibiting the offender from having any contact` TRUE FALSE FALSE TRUE FALSE (JUST FALSE) EQUALS NOTHING
-- an offence of none of the three kinds
#ASSERT `s 729.2(1) the court may make an order prohibiting the offender from having any contact` TRUE FALSE TRUE FALSE FALSE (JUST FALSE) EQUALS NOTHING
-- whether the person is an intimate partner is for section 2
#ASSERT `s 729.2(1) the court may make an order prohibiting the offender from having any contact` TRUE FALSE TRUE FALSE FALSE NOTHING EQUALS NOTHING
-- a limb that is JUST TRUE decides the matter whatever section 2 leaves open
#ASSERT `s 729.2(1) the court may make an order prohibiting the offender from having any contact` TRUE FALSE TRUE TRUE FALSE NOTHING EQUALS JUST TRUE

§ `s 729.2(2): the prohibition may be for life or for any shorter duration the court considers desirable`

#ASSERT `s 729.2(2) the prohibition may be for the duration` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 729.2(2) the prohibition may be for the duration` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 729.2(2) the prohibition may be for the duration` FALSE FALSE EQUALS NOTHING

§ `s 729.2(3): variation of the order by a court of competent jurisdiction`

#ASSERT `s 729.2(3) the court may require the offender to appear before it` TRUE TRUE EQUALS JUST TRUE
-- no application by the person identified or the prosecutor
#ASSERT `s 729.2(3) the court may require the offender to appear before it` TRUE FALSE EQUALS JUST FALSE
-- not a court of competent jurisdiction
#ASSERT `s 729.2(3) the court may require the offender to appear before it` FALSE TRUE EQUALS NOTHING
#ASSERT `s 729.2(3) the court may vary the order` TRUE TRUE TRUE EQUALS JUST TRUE
-- the parties have not been heard
#ASSERT `s 729.2(3) the court may vary the order` TRUE FALSE TRUE EQUALS JUST FALSE
-- not desirable because of changed circumstances
#ASSERT `s 729.2(3) the court may vary the order` TRUE TRUE FALSE EQUALS NOTHING
-- not a court of competent jurisdiction
#ASSERT `s 729.2(3) the court may vary the order` FALSE TRUE TRUE EQUALS NOTHING

§ `s 729.2(4): the court the application is made to`

#ASSERT `s 729.2(4) the court the application must be made to` TRUE FALSE FALSE EQUALS JUST `s 729.2(4)(a) the court that made the order`
#ASSERT `s 729.2(4) the court the application must be made to` TRUE TRUE FALSE EQUALS JUST `s 729.2(4)(a) another court of equivalent jurisdiction in the same province`
#ASSERT `s 729.2(4) the court the application must be made to` FALSE FALSE TRUE EQUALS JUST `s 729.2(4)(b) a superior court of criminal jurisdiction`
-- both described: paragraph (a) is the first limb
#ASSERT `s 729.2(4) the court the application must be made to` TRUE FALSE TRUE EQUALS JUST `s 729.2(4)(a) the court that made the order`
-- neither case
#ASSERT `s 729.2(4) the court the application must be made to` FALSE FALSE FALSE EQUALS NOTHING

§ `s 729.2(5): failure to comply with an order made under subsection (1)`

#ASSERT `s 729.2(5) the person is guilty of the offence of failing to comply with the order` TRUE FALSE EQUALS JUST TRUE
-- a lawful excuse
#ASSERT `s 729.2(5) the person is guilty of the offence of failing to comply with the order` TRUE TRUE EQUALS JUST FALSE
-- no failure to comply with an order under (1)
#ASSERT `s 729.2(5) the person is guilty of the offence of failing to comply with the order` FALSE FALSE EQUALS NOTHING
-- liable to imprisonment for a term not exceeding two years
#ASSERT `s 729.2(5)(a) the punishment on indictment` EQUALS Punishment OF `by indictment`, (`imprisonment for a term of` (`Length of time` OF 2, 0, 0, FALSE)), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
-- the paragraph states no penalty of its own
#ASSERT `s 729.2(5)(b) the punishment on summary conviction` EQUALS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
#ASSERT `s 729.2(5) the class of offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`

§ `s 730(1): the punishment the offence charged is liable to: a minimum, and fourteen years or life`

-- a minimum term of imprisonment
#ASSERT `s 730(1) the offence has a minimum punishment prescribed by law` (Punishment OF `by indictment`, `no imprisonment is stated`, (`imprisonment for a term of` `six months`), `no fine is stated`, `no fine is stated`) EQUALS JUST TRUE
-- a minimum fine
#ASSERT `s 730(1) the offence has a minimum punishment prescribed by law` (Punishment OF `by indictment`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, (`a fine of` 1000)) EQUALS JUST TRUE
-- the offence section states no minimum, and another enactment may
#ASSERT `s 730(1) the offence has a minimum punishment prescribed by law` (Punishment OF `by indictment`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS NOTHING
#ASSERT `s 730(1) the offence is punishable by imprisonment for fourteen years or for life` (Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS JUST TRUE
-- exactly fourteen years
#ASSERT `s 730(1) the offence is punishable by imprisonment for fourteen years or for life` (Punishment OF `by indictment`, (`imprisonment for a term of` `fourteen years`), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS JUST TRUE
-- fourteen years less a day is under fourteen years
#ASSERT `s 730(1) the offence is punishable by imprisonment for fourteen years or for life` (Punishment OF `by indictment`, (`imprisonment for a term of` (`Length of time` OF 14, 0, 0, TRUE)), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS JUST FALSE
#ASSERT `s 730(1) the offence is punishable by imprisonment for fourteen years or for life` (Punishment OF `by indictment`, (`imprisonment for a term of` `ten years`), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS JUST FALSE
#ASSERT `s 730(1) the offence is punishable by imprisonment for fourteen years or for life` (Punishment OF `by indictment`, (`imprisonment for a term of` `five years`), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS JUST FALSE
-- the offence section states no maximum
#ASSERT `s 730(1) the offence is punishable by imprisonment for fourteen years or for life` (Punishment OF `by indictment`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS NOTHING
-- ninety days is under fourteen years in every calendar
#ASSERT `s 730(1) the offence is punishable by imprisonment for fourteen years or for life` (Punishment OF `by indictment`, (`imprisonment for a term of` `ninety days`), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS JUST FALSE

§ `s 730(1): the court may direct a discharge`

#ASSERT `s 730(1) the court may direct that the accused be discharged instead of convicting the accused` FALSE TRUE (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS JUST TRUE
-- no plea or finding of guilt: the "Where" gate
#ASSERT `s 730(1) the court may direct that the accused be discharged instead of convicting the accused` FALSE FALSE (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
-- no plea or finding of guilt, whoever the accused is: the gate is checked first
#ASSERT `s 730(1) the court may direct that the accused be discharged instead of convicting the accused` TRUE FALSE (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
-- an organization: "other than an organization"
#ASSERT `s 730(1) the court may direct that the accused be discharged instead of convicting the accused` TRUE TRUE (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS NOTHING
-- an offence for which a minimum punishment is prescribed by law
#ASSERT `s 730(1) the court may direct that the accused be discharged instead of convicting the accused` FALSE TRUE (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS NOTHING
-- an offence punishable by imprisonment for fourteen years or for life
#ASSERT `s 730(1) the court may direct that the accused be discharged instead of convicting the accused` FALSE TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS NOTHING
-- whether a minimum is prescribed is for the offence section
#ASSERT `s 730(1) the court may direct that the accused be discharged instead of convicting the accused` FALSE TRUE NOTHING (JUST FALSE) TRUE TRUE EQUALS NOTHING
-- whether the offence carries fourteen years or life is for the offence section
#ASSERT `s 730(1) the court may direct that the accused be discharged instead of convicting the accused` FALSE TRUE (JUST FALSE) NOTHING TRUE TRUE EQUALS NOTHING
-- the court does not consider it in the best interests of the accused
#ASSERT `s 730(1) the court may direct that the accused be discharged instead of convicting the accused` FALSE TRUE (JUST FALSE) (JUST FALSE) FALSE TRUE EQUALS NOTHING
-- the court considers it contrary to the public interest
#ASSERT `s 730(1) the court may direct that the accused be discharged instead of convicting the accused` FALSE TRUE (JUST FALSE) (JUST FALSE) TRUE FALSE EQUALS NOTHING

§ `s 730(2): the appearance notice, summons, undertaking or release order continues in force`

#ASSERT `s 730(2) the appearance notice, summons, undertaking or release order continues in force` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- held in custody
#ASSERT `s 730(2) the appearance notice, summons, undertaking or release order continues in force` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- convicted, or no plea or finding of guilt
#ASSERT `s 730(2) the appearance notice, summons, undertaking or release order continues in force` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- "until a disposition ... is made": the period has ended
#ASSERT `s 730(2) the appearance notice, summons, undertaking or release order continues in force` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- "unless ... the court ... orders that the accused be taken into custody"
#ASSERT `s 730(2) the appearance notice, summons, undertaking or release order continues in force` TRUE TRUE FALSE TRUE EQUALS JUST FALSE

§ `s 730(3): the effect of a discharge`

#ASSERT `s 730(3) the offender is deemed not to have been convicted of the offence` TRUE EQUALS JUST TRUE
-- no direction of discharge under subsection (1): the subsection says nothing
#ASSERT `s 730(3) the offender is deemed not to have been convicted of the offence` FALSE EQUALS NOTHING
#ASSERT `s 730(3)(a) the offender may appeal from the determination of guilt as if it were a conviction` TRUE EQUALS JUST TRUE
#ASSERT `s 730(3)(a) the offender may appeal from the determination of guilt as if it were a conviction` FALSE EQUALS JUST FALSE
-- the Attorney General
#ASSERT `s 730(3)(b) the person may appeal from the decision not to convict the offender as if it were an acquittal or a dismissal of the information` TRUE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
-- in summary conviction proceedings, the informant
#ASSERT `s 730(3)(b) the person may appeal from the decision not to convict the offender as if it were an acquittal or a dismissal of the information` TRUE NOTHING TRUE TRUE EQUALS JUST TRUE
-- not the Attorney General, but the informant in summary conviction proceedings
#ASSERT `s 730(3)(b) the person may appeal from the decision not to convict the offender as if it were an acquittal or a dismissal of the information` TRUE (JUST FALSE) TRUE TRUE EQUALS JUST TRUE
-- the informant, but the proceedings are not summary conviction proceedings
#ASSERT `s 730(3)(b) the person may appeal from the decision not to convict the offender as if it were an acquittal or a dismissal of the information` TRUE (JUST FALSE) FALSE TRUE EQUALS NOTHING
-- summary conviction proceedings, but not the informant or the informant's agent
#ASSERT `s 730(3)(b) the person may appeal from the decision not to convict the offender as if it were an acquittal or a dismissal of the information` TRUE (JUST FALSE) TRUE FALSE EQUALS NOTHING
-- who the Attorney General is, is for section 2
#ASSERT `s 730(3)(b) the person may appeal from the decision not to convict the offender as if it were an acquittal or a dismissal of the information` TRUE NOTHING FALSE FALSE EQUALS NOTHING
-- no direction of discharge
#ASSERT `s 730(3)(b) the person may appeal from the decision not to convict the offender as if it were an acquittal or a dismissal of the information` FALSE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 730(3)(c) the offender may plead autrefois convict in respect of any subsequent charge relating to the offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 730(3)(c) the offender may plead autrefois convict in respect of any subsequent charge relating to the offence` FALSE TRUE EQUALS JUST FALSE
-- a subsequent charge that does not relate to the offence
#ASSERT `s 730(3)(c) the offender may plead autrefois convict in respect of any subsequent charge relating to the offence` TRUE FALSE EQUALS NOTHING

§ `s 730(4): revocation of the discharge`

#ASSERT `s 730(4) the court may revoke the discharge, convict the offender and impose any sentence that could have been imposed at the time of discharge` TRUE TRUE TRUE EQUALS JUST TRUE
-- not bound by a probation order made on a discharge
#ASSERT `s 730(4) the court may revoke the discharge, convict the offender and impose any sentence that could have been imposed at the time of discharge` FALSE TRUE TRUE EQUALS JUST FALSE
-- not convicted of an offence
#ASSERT `s 730(4) the court may revoke the discharge, convict the offender and impose any sentence that could have been imposed at the time of discharge` TRUE FALSE TRUE EQUALS JUST FALSE
-- not the court that made the probation order, or not a time when it may act under subsection 732.2(5)
#ASSERT `s 730(4) the court may revoke the discharge, convict the offender and impose any sentence that could have been imposed at the time of discharge` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 730(4) an appeal from the conviction is barred` TRUE TRUE EQUALS JUST TRUE
-- no appeal was taken from the order directing the discharge
#ASSERT `s 730(4) an appeal from the conviction is barred` TRUE FALSE EQUALS NOTHING
-- not a conviction under subsection 730(4)
#ASSERT `s 730(4) an appeal from the conviction is barred` FALSE TRUE EQUALS NOTHING
