#ASSERT `s 487.08(1) the use of the bodily substances is barred` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 487.08(1) the use of the bodily substances is barred` FALSE FALSE EQUALS NOTHING
#ASSERT `s 487.08(1.1) the use of the bodily substances is barred` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.08(1.1) the use of the bodily substances is barred` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 487.08(1.1) the use of the bodily substances is barred` FALSE FALSE EQUALS NOTHING
