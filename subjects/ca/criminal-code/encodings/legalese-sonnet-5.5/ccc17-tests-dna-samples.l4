-- (3): the offence follows a contravention of (1) or (2)
#ASSERT `s 487.08(3) the person is guilty of an offence punishable on summary conviction` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 487.08(3) the person is guilty of an offence punishable on summary conviction` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 487.08(3) the person is guilty of an offence punishable on summary conviction` TRUE (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 487.08(3) the person is guilty of an offence punishable on summary conviction` TRUE NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 487.08(3) the person is guilty of an offence punishable on summary conviction` FALSE (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT count `s 487.08(3) the punishments` EQUALS 1
#ASSERT `s 487.08(4) the person is guilty of an offence` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 487.08(4) the person is guilty of an offence` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 487.08(4) the person is guilty of an offence` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 487.08(4) the punishments` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` `two years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)

§ `Tests: s 487.09 destruction`

#ASSERT `s 487.09(1) the bodily substances and the results of forensic DNA analysis shall be destroyed without delay` TRUE FALSE `s 487.09(1)(a) the results of the analysis establish that the bodily substance referred to in paragraph 487.05(1)(b) was not from that person` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 487.09(1) the bodily substances and the results of forensic DNA analysis shall be destroyed without delay` TRUE FALSE `s 487.09(1)(b) the person is finally acquitted of the designated offence and any other offence in respect of the same transaction` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 487.09(1) the bodily substances and the results of forensic DNA analysis shall be destroyed without delay` TRUE FALSE `s 487.09(1)(c)(i) one year after the person is discharged after a preliminary inquiry into the designated offence or any other offence in respect of the same transaction` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.09(1) the bodily substances and the results of forensic DNA analysis shall be destroyed without delay` TRUE FALSE `s 487.09(1)(c)(ii) one year after the dismissal, for any reason other than acquittal, or the withdrawal of any information charging the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 487.09(1) the bodily substances and the results of forensic DNA analysis shall be destroyed without delay` TRUE FALSE `s 487.09(1)(c)(iii) one year after any proceeding against the person for the offence or any other offence in respect of the same transaction is stayed under section 579 or under that section as applied by section 572 or 795` TRUE FALSE EQUALS JUST TRUE
-- paragraph (c): the year not yet expired, or a new information laid in that year -> the text says no
#ASSERT `s 487.09(1) the bodily substances and the results of forensic DNA analysis shall be destroyed without delay` TRUE FALSE `s 487.09(1)(c)(i) one year after the person is discharged after a preliminary inquiry into the designated offence or any other offence in respect of the same transaction` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 487.09(1) the bodily substances and the results of forensic DNA analysis shall be destroyed without delay` TRUE FALSE `s 487.09(1)(c)(ii) one year after the dismissal, for any reason other than acquittal, or the withdrawal of any information charging the person` TRUE TRUE EQUALS JUST FALSE
-- "Subject to subsection (2)": an order not to destroy; outside the warrant: not covered; a ground the text does not list: not covered
#ASSERT `s 487.09(1) the bodily substances and the results of forensic DNA analysis shall be destroyed without delay` TRUE TRUE `s 487.09(1)(a) the results of the analysis establish that the bodily substance referred to in paragraph 487.05(1)(b) was not from that person` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 487.09(1) the bodily substances and the results of forensic DNA analysis shall be destroyed without delay` FALSE FALSE `s 487.09(1)(a) the results of the analysis establish that the bodily substance referred to in paragraph 487.05(1)(b) was not from that person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 487.09(1) the bodily substances and the results of forensic DNA analysis shall be destroyed without delay` TRUE FALSE `s 487.09(1) none of those` TRUE FALSE EQUALS NOTHING
-- the year, counted from 15 June 2024: expires on 15 June 2025; the day in question must be after it
#ASSERT `s 487.09(1)(c) the day on which one year after the event expires` (Date 15 6 2024) EQUALS Date 15 6 2025
#ASSERT `s 487.09(1)(c) one year after the event has expired on the day in question` (Date 15 6 2024) (Date 16 6 2025) EQUALS TRUE
#ASSERT `s 487.09(1)(c) one year after the event has expired on the day in question` (Date 15 6 2024) (Date 15 6 2025) EQUALS FALSE
#ASSERT `s 487.09(1)(c) one year after the event has expired on the day in question` (Date 15 6 2024) (Date 14 6 2025) EQUALS FALSE
#ASSERT `s 487.09(2) the provincial court judge may order that the bodily substances and the results not be destroyed during the period considered appropriate` TRUE EQUALS JUST TRUE
#ASSERT `s 487.09(2) the provincial court judge may order that the bodily substances and the results not be destroyed during the period considered appropriate` FALSE EQUALS NOTHING
#ASSERT `s 487.09(3) the voluntarily given bodily substances and the results shall be destroyed without delay` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.09(3) the voluntarily given bodily substances and the results shall be destroyed without delay` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.09(3) the voluntarily given bodily substances and the results shall be destroyed without delay` FALSE TRUE EQUALS NOTHING

