IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc16-search-warrants`

-- ccc16-tests-search-warrants.l4 -- tests for ccc16-search-warrants.l4 (sections 487 and 487.01).
-- Expected values were decided from the text (lines 9013-9056) before the run and are written beside each assertion.

§ `s 487(1)`
-- satisfied by information on oath in Form 1 that there are reasonable grounds to believe the building, receptacle or place holds (a), (b), (c) or (c.1)
#ASSERT `s 487(1) the justice may issue a warrant to search the building, receptacle or place` TRUE TRUE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE   -- (a)
#ASSERT `s 487(1) the justice may issue a warrant to search the building, receptacle or place` TRUE FALSE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE   -- (b)
#ASSERT `s 487(1) the justice may issue a warrant to search the building, receptacle or place` TRUE FALSE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE   -- (c)
#ASSERT `s 487(1) the justice may issue a warrant to search the building, receptacle or place` TRUE FALSE FALSE FALSE (JUST TRUE) EQUALS JUST TRUE   -- (c.1) offence-related property
#ASSERT `s 487(1) the justice may issue a warrant to search the building, receptacle or place` TRUE FALSE FALSE FALSE (JUST FALSE) EQUALS NOTHING   -- no ground
#ASSERT `s 487(1) the justice may issue a warrant to search the building, receptacle or place` TRUE FALSE FALSE FALSE NOTHING EQUALS NOTHING   -- s 2 "offence-related property" not answered
#ASSERT `s 487(1) the justice may issue a warrant to search the building, receptacle or place` FALSE TRUE TRUE TRUE (JUST TRUE) EQUALS NOTHING   -- not satisfied by information on oath in Form 1
#ASSERT `s 487(1) the warrant may authorize the person` TRUE FALSE TRUE EQUALS JUST TRUE   -- a peace officer named in the warrant
#ASSERT `s 487(1) the warrant may authorize the person` FALSE TRUE TRUE EQUALS JUST TRUE   -- a public officer named in the warrant
#ASSERT `s 487(1) the warrant may authorize the person` TRUE FALSE FALSE EQUALS NOTHING   -- not named in the warrant
#ASSERT `s 487(1) the warrant may authorize the person` FALSE FALSE TRUE EQUALS NOTHING   -- neither a peace officer nor a qualifying public officer
#ASSERT `s 487(1) the warrant may authorize the act` `s 487(1)(d) to search the building, receptacle or place for any such thing and to seize it` EQUALS JUST TRUE
#ASSERT `s 487(1) the warrant may authorize the act` `s 487(1)(e) subject to any other Act of Parliament, to, as soon as practicable, bring the thing seized before, or make a report in respect of it to, a justice in accordance with section 489.1` EQUALS JUST TRUE
#ASSERT `s 487(1) the warrant may authorize the act` `s 487(1) something else` EQUALS NOTHING

§ `s 487(2), (2.1), (2.2), (3)`
#ASSERT `s 487(2) the warrant may be executed at the place` TRUE EQUALS JUST TRUE
#ASSERT `s 487(2) the warrant may be executed at the place` FALSE EQUALS NOTHING   -- outside Canada
#ASSERT `s 487(2) the officer who executes the warrant has the authority required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487(2) the officer who executes the warrant has the authority required` TRUE FALSE EQUALS JUST FALSE   -- "must have authority to act in that capacity in the place"
#ASSERT `s 487(2) the officer who executes the warrant has the authority required` FALSE TRUE EQUALS NOTHING   -- neither a named public officer nor a peace officer
#ASSERT `s 487(2.1) the person may do the act` TRUE `s 487(2.1)(a) use or cause to be used any computer system at the building or place to search any data contained in or available to the computer system` EQUALS JUST TRUE
#ASSERT `s 487(2.1) the person may do the act` TRUE `s 487(2.1)(b) reproduce or cause to be reproduced any data in the form of a print-out or other intelligible output` EQUALS JUST TRUE
#ASSERT `s 487(2.1) the person may do the act` TRUE `s 487(2.1)(c) seize the print-out or other output for examination or copying` EQUALS JUST TRUE
#ASSERT `s 487(2.1) the person may do the act` TRUE `s 487(2.1)(d) use or cause to be used any copying equipment at the place to make copies of the data` EQUALS JUST TRUE
#ASSERT `s 487(2.1) the person may do the act` TRUE `s 487(2.1) something else` EQUALS NOTHING
#ASSERT `s 487(2.1) the person may do the act` FALSE `s 487(2.1)(a) use or cause to be used any computer system at the building or place to search any data contained in or available to the computer system` EQUALS NOTHING   -- not authorized to search a computer system for data
#ASSERT `s 487(2.2) the person in possession or control must permit the person carrying out the search to do the act` TRUE TRUE `s 487(2.2)(a) to use or cause to be used any computer system at the building or place in order to search any data contained in or available to the computer system for data that the person is authorized by this section to search for` EQUALS JUST TRUE
#ASSERT `s 487(2.2) the person in possession or control must permit the person carrying out the search to do the act` TRUE TRUE `s 487(2.2)(b) to obtain a hard copy of the data and to seize it` EQUALS JUST TRUE
#ASSERT `s 487(2.2) the person in possession or control must permit the person carrying out the search to do the act` TRUE TRUE `s 487(2.2)(c) to use or cause to be used any copying equipment at the place to make copies of the data` EQUALS JUST TRUE
#ASSERT `s 487(2.2) the person in possession or control must permit the person carrying out the search to do the act` TRUE FALSE `s 487(2.2)(b) to obtain a hard copy of the data and to seize it` EQUALS JUST FALSE   -- "on presentation of the warrant": not yet presented
#ASSERT `s 487(2.2) the person in possession or control must permit the person carrying out the search to do the act` FALSE TRUE `s 487(2.2)(b) to obtain a hard copy of the data and to seize it` EQUALS NOTHING   -- not in possession or control
#ASSERT `s 487(2.2) the person in possession or control must permit the person carrying out the search to do the act` TRUE TRUE `s 487(2.2) something else` EQUALS NOTHING
#ASSERT `s 487(3) the search warrant may be in the form set out as Form 5` TRUE EQUALS JUST TRUE
#ASSERT `s 487(3) the search warrant may be in the form set out as Form 5` FALSE EQUALS NOTHING

§ `s 487.01(1) to (4) -- the general warrant`
#ASSERT `s 487.01(1) the judge may issue a warrant in writing authorizing a peace officer to use the device, technique or procedure or do the thing` TRUE FALSE (JUST FALSE) TRUE TRUE TRUE EQUALS JUST TRUE   -- a provincial court judge
#ASSERT `s 487.01(1) the judge may issue a warrant in writing authorizing a peace officer to use the device, technique or procedure or do the thing` FALSE TRUE (JUST FALSE) TRUE TRUE TRUE EQUALS JUST TRUE   -- a judge of a superior court of criminal jurisdiction
#ASSERT `s 487.01(1) the judge may issue a warrant in writing authorizing a peace officer to use the device, technique or procedure or do the thing` FALSE FALSE (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE   -- a judge as defined in section 552
#ASSERT `s 487.01(1) the judge may issue a warrant in writing authorizing a peace officer to use the device, technique or procedure or do the thing` FALSE FALSE (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING   -- not one of the three kinds of judge
#ASSERT `s 487.01(1) the judge may issue a warrant in writing authorizing a peace officer to use the device, technique or procedure or do the thing` FALSE FALSE NOTHING TRUE TRUE TRUE EQUALS NOTHING   -- s 552 "judge" not answered
#ASSERT `s 487.01(1) the judge may issue a warrant in writing authorizing a peace officer to use the device, technique or procedure or do the thing` TRUE FALSE (JUST FALSE) FALSE TRUE TRUE EQUALS NOTHING   -- (a) fails
#ASSERT `s 487.01(1) the judge may issue a warrant in writing authorizing a peace officer to use the device, technique or procedure or do the thing` TRUE FALSE (JUST FALSE) TRUE FALSE TRUE EQUALS NOTHING   -- (b) fails
#ASSERT `s 487.01(1) the judge may issue a warrant in writing authorizing a peace officer to use the device, technique or procedure or do the thing` TRUE FALSE (JUST FALSE) TRUE TRUE FALSE EQUALS NOTHING   -- (c) fails: another provision provides for a warrant
#ASSERT `s 487.01(2) subsection (1) permits the act` TRUE EQUALS JUST FALSE   -- interference with bodily integrity
#ASSERT `s 487.01(2) subsection (1) permits the act` FALSE EQUALS NOTHING
#ASSERT `s 487.01(3) the warrant contains the terms and conditions required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.01(3) the warrant contains the terms and conditions required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.01(3) the warrant contains the terms and conditions required` FALSE TRUE EQUALS NOTHING
#ASSERT `s 487.01(4) the warrant contains the privacy terms and conditions required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.01(4) the warrant contains the privacy terms and conditions required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.01(4) the warrant contains the privacy terms and conditions required` FALSE FALSE EQUALS NOTHING

§ `s 487.01(5) -- Part VI provisions applied to video surveillance`
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 183, "") TRUE EQUALS JUST TRUE
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 183.1, "") TRUE EQUALS JUST TRUE
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 184.2, "") TRUE EQUALS JUST TRUE
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 184.3, "") TRUE EQUALS JUST TRUE
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 185, "") TRUE EQUALS JUST TRUE   -- "185 to 188.2": the first
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 186.1, "") TRUE EQUALS JUST TRUE   -- inside the range
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 188.2, "") TRUE EQUALS JUST TRUE   -- the last
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 188.3, "") TRUE EQUALS NOTHING   -- just past the range
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 184, "") TRUE EQUALS NOTHING   -- before the range, not listed
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 189, "(5)") TRUE EQUALS JUST TRUE   -- subsection 189(5)
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 189, "(1)") TRUE EQUALS NOTHING   -- other subsections of 189 are not named
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 190, "") TRUE EQUALS JUST TRUE
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 191, "") TRUE EQUALS NOTHING
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 193, "") TRUE EQUALS JUST TRUE
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 194, "") TRUE EQUALS JUST TRUE   -- "194 to 196": the first
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 196, "") TRUE EQUALS JUST TRUE   -- the last
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 196.1, "") TRUE EQUALS NOTHING   -- 196.1 is past 196
#ASSERT `s 487.01(5) the provision applies, with such modifications as the circumstances require, to the warrant` (`Provision of the Code` OF 185, "") FALSE EQUALS NOTHING   -- not a warrant referred to in subsection (4)

§ `s 487.01(5.1), (5.2), (6)`
#ASSERT `s 487.01(5.1) the warrant requires notice of the covert entry and search as required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.01(5.1) the warrant requires notice of the covert entry and search as required` TRUE FALSE EQUALS JUST FALSE   -- "shall require"
#ASSERT `s 487.01(5.1) the warrant requires notice of the covert entry and search as required` FALSE FALSE EQUALS NOTHING   -- not a covert entry
-- the cap: "no extension may exceed three years"
#ASSERT `s 487.01(5.2) the extension does not exceed three years` (`Length of time` OF 3, 0, 0, FALSE)
#ASSERT `s 487.01(5.2) the extension does not exceed three years` (`Length of time` OF 2, 11, 30, FALSE)
#ASSERT `s 487.01(5.2) the extension does not exceed three years` (`Length of time` OF 3, 0, 0, TRUE)   -- three years less a day is under three years
#ASSERT NOT (`s 487.01(5.2) the extension does not exceed three years` (`Length of time` OF 3, 0, 1, FALSE))
#ASSERT NOT (`s 487.01(5.2) the extension does not exceed three years` (`Length of time` OF 3, 1, 0, FALSE))
#ASSERT NOT (`s 487.01(5.2) the extension does not exceed three years` (`Length of time` OF 4, 0, 0, FALSE))
#ASSERT `s 487.01(5.2) the judge may grant an extension of the period for giving notice` TRUE TRUE TRUE (`Length of time` OF 3, 0, 0, FALSE) EQUALS JUST TRUE
#ASSERT `s 487.01(5.2) the judge may grant an extension of the period for giving notice` TRUE TRUE TRUE (`Length of time` OF 3, 0, 1, FALSE) EQUALS JUST FALSE   -- exceeds three years
#ASSERT `s 487.01(5.2) the judge may grant an extension of the period for giving notice` TRUE TRUE FALSE (`Length of time` OF 1, 0, 0, FALSE) EQUALS JUST FALSE   -- not satisfied that the interests of justice warrant it
#ASSERT `s 487.01(5.2) the judge may grant an extension of the period for giving notice` TRUE FALSE TRUE (`Length of time` OF 1, 0, 0, FALSE) EQUALS JUST FALSE   -- no affidavit
#ASSERT `s 487.01(5.2) the judge may grant an extension of the period for giving notice` FALSE TRUE TRUE (`Length of time` OF 1, 0, 0, FALSE) EQUALS JUST FALSE   -- not the issuing judge nor another judge having jurisdiction
#ASSERT `s 487.01(6) the general warrant may be executed at the place` TRUE EQUALS JUST TRUE
#ASSERT `s 487.01(6) the general warrant may be executed at the place` FALSE EQUALS NOTHING
#ASSERT `s 487.01(6) the peace officer who executes the general warrant has the authority required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 487.01(6) the peace officer who executes the general warrant has the authority required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 487.01(6) the peace officer who executes the general warrant has the authority required` FALSE TRUE EQUALS NOTHING
