    WHEN JUST FALSE THEN JUST FALSE   -- FALSE-kind (the text says no in its own words): "Every one who commits an offence under subsection (1) and thereby causes the death of any other person"
    WHEN NOTHING THEN NOTHING   -- NOTHING-kind (points outside the text): whether the person commits an offence under subsection (1) is for that subsection
    WHEN JUST TRUE THEN
        IF `the person thereby causes the death of any other person`
        THEN JUST TRUE
        ELSE JUST FALSE   -- FALSE-kind (the text says no in its own words): "and thereby causes the death of any other person"

@ref s 83.231(4) (src:1775)
`s 83.231(4) the class of the offence` MEANS `an indictable offence`

@ref s 83.231(4) (src:1775)
`s 83.231(4) the punishment of the offence` MEANS
    Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
