IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc18-weapons-evidence`

-- ccc18-tests-weapons-evidence.l4 -- tests for ccc18-weapons-evidence.l4. Expected values are written from the text of the Criminal Code
-- (R.S.C., 1985, c. C-46, lines 10275-10956 of the plain-text rendering), beside each assertion, and not copied from the module's own output.

-- 491(1): (a) a weapon, imitation firearm, prohibited device, firearm part, ammunition, prohibited ammunition or explosive substance USED in the commission of an offence and seized and detained; (b) a person committed an offence that INVOLVES a firearm, cross-bow, prohibited weapon, restricted weapon, ... and the thing is seized and detained.
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` TRUE FALSE TRUE (`s 491(1) the thing` OF JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE   -- (a) a weapon used in the commission of an offence
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` TRUE FALSE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` TRUE FALSE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST FALSE, JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` TRUE FALSE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST FALSE, JUST FALSE, JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` TRUE FALSE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` TRUE FALSE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` TRUE FALSE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` TRUE FALSE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST FALSE   -- a firearm used in an offence is in limb (b), not in limb (a)'s list
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` FALSE TRUE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE   -- (b) an offence involving a firearm
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` FALSE TRUE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST TRUE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` FALSE TRUE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST TRUE, JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` FALSE TRUE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` FALSE TRUE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE   -- limb (b) lists it too
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` FALSE TRUE TRUE (`s 491(1) the thing` OF JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST FALSE   -- a weapon (not a listed kind) in an offence that merely involves it: limb (b) does not list "weapon"
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` TRUE FALSE FALSE (`s 491(1) the thing` OF JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST FALSE   -- not seized and detained
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` FALSE FALSE TRUE (`s 491(1) the thing` OF JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST FALSE   -- no court determination
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` TRUE FALSE TRUE (`s 491(1) the thing` OF JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST FALSE   -- none of the listed kinds
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` TRUE FALSE TRUE (`s 491(1) the thing` OF NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING) EQUALS NOTHING   -- the keel's answers are not covered
#ASSERT `s 491(1) the thing is forfeited to Her Majesty` TRUE FALSE TRUE (`s 491(1) the thing` OF JUST TRUE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, JUST FALSE, NOTHING, JUST FALSE, JUST FALSE, JUST FALSE) EQUALS JUST TRUE   -- one limb is made out whatever the unknown ones say

#ASSERT `s 491(2) the order the court shall make` TRUE TRUE `s 491(2) the thing is still held` EQUALS `s 491(2) the thing is returned to the lawful owner`
#ASSERT `s 491(2) the order the court shall make` TRUE TRUE `s 491(2) the thing was sold` EQUALS `s 491(2) the proceeds of the sale of the thing are paid to the lawful owner`
#ASSERT `s 491(2) the order the court shall make` TRUE TRUE `s 491(2) the thing was destroyed` EQUALS `s 491(2) an amount equal to the value of the thing is paid to the owner`
#ASSERT `s 491(2) the order the court shall make` FALSE TRUE `s 491(2) the thing is still held` EQUALS `s 491(2) no order for return or payment is required by this subsection`   -- the owner was a party to the offence (not "not a party")
#ASSERT `s 491(2) the order the court shall make` TRUE FALSE `s 491(2) the thing is still held` EQUALS `s 491(2) no order for return or payment is required by this subsection`   -- the owner had reasonable grounds to believe
#TRACE `s 491(2) the duty of the court to order the return or payment` AT 0 WITH
    PARTY `the court` DOES `s 491(2) order that the thing be returned to the lawful owner, that the proceeds of any sale of the thing be paid to that lawful owner or, if the thing was destroyed, that an amount equal to the value of the thing be paid to the owner` AT 1

#ASSERT `s 491(3) the person to whom the proceeds of the sale shall be paid` TRUE FALSE EQUALS JUST `s 491(3) the Attorney General`
#ASSERT `s 491(3) the person to whom the proceeds of the sale shall be paid` TRUE TRUE EQUALS JUST `s 491(3) the person who was, immediately prior to the sale, the lawful owner of the thing`
#ASSERT `s 491(3) the person to whom the proceeds of the sale shall be paid` FALSE FALSE EQUALS NOTHING

#ASSERT `s 491.1(1) the court shall make an order under subsection (2) in respect of the property` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 491.1(1) the court shall make an order under subsection (2) in respect of the property` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- without: the accused or defendant is tried for an offence
#ASSERT `s 491.1(1) the court shall make an order under subsection (2) in respect of the property` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- without: the court determines that an offence has been committed, whether or not the accused has be
#ASSERT `s 491.1(1) the court shall make an order under subsection (2) in respect of the property` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- without: the property was obtained by the commission of the offence
#ASSERT `s 491.1(1) the court shall make an order under subsection (2) in respect of the property` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- without: (a) at the time of the trial the property is before the court or has been detained so that
#ASSERT `s 491.1(1) the court shall make an order under subsection (2) in respect of the property` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- without: (b) at the time of the trial the property will not be required as evidence in any other pr
#TRACE `s 491.1(1) the duty of the court to make an order in respect of the property` AT 0 WITH
    PARTY `the court` DOES `s 491.1(1) make an order under subsection (2) in respect of the property` AT 1

#ASSERT `s 491.1(1) (section 490) section 490 does not apply in respect of the property` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 491.1(1) (section 490) section 490 does not apply in respect of the property` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING   -- without: the accused or defendant is tried for an offence
#ASSERT `s 491.1(1) (section 490) section 490 does not apply in respect of the property` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING   -- without: the court determines that an offence has been committed, whether or not the accused has be
#ASSERT `s 491.1(1) (section 490) section 490 does not apply in respect of the property` TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING   -- without: the property was obtained by the commission of the offence
#ASSERT `s 491.1(1) (section 490) section 490 does not apply in respect of the property` TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING   -- without: (a) at the time of the trial the property is before the court or has been detained so that
#ASSERT `s 491.1(1) (section 490) section 490 does not apply in respect of the property` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING   -- without: (b) at the time of the trial the property will not be required as evidence in any other pr

#ASSERT `s 491.1(2) the order the court shall make` TRUE TRUE EQUALS JUST `s 491.1(2)(a) the property is returned to the lawful owner or person lawfully entitled to possession`
#ASSERT `s 491.1(2) the order the court shall make` TRUE FALSE EQUALS JUST `s 491.1(2)(b) the property is forfeited to Her Majesty, to be disposed of as the Attorney General directs or otherwise dealt with in accordance with the law`
#ASSERT `s 491.1(2) the order the court shall make` FALSE TRUE EQUALS NOTHING

#ASSERT `s 491.1(3) an order shall not be made under subsection (2)` TRUE (`Provision of the Code` OF 330, "") FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a) an agent charged under section 330
#ASSERT `s 491.1(3) an order shall not be made under subsection (2)` TRUE (`Provision of the Code` OF 331, "(1)") FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 491.1(3) an order shall not be made under subsection (2)` TRUE (`Provision of the Code` OF 332, "") FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 491.1(3) an order shall not be made under subsection (2)` TRUE (`Provision of the Code` OF 336, "") FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 491.1(3) an order shall not be made under subsection (2)` TRUE (`Provision of the Code` OF 334, "") FALSE FALSE FALSE FALSE EQUALS NOTHING   -- an agent, but not an offence under section 330, 331, 332 or 336
#ASSERT `s 491.1(3) an order shall not be made under subsection (2)` FALSE (`Provision of the Code` OF 330, "") FALSE FALSE FALSE FALSE EQUALS NOTHING   -- not an agent entrusted with possession
#ASSERT `s 491.1(3) an order shall not be made under subsection (2)` FALSE (`Provision of the Code` OF 334, "") TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- (b)(i)
#ASSERT `s 491.1(3) an order shall not be made under subsection (2)` FALSE (`Provision of the Code` OF 334, "") FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- (b)(ii)
#ASSERT `s 491.1(3) an order shall not be made under subsection (2)` FALSE (`Provision of the Code` OF 334, "") FALSE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b)(iii)
#ASSERT `s 491.1(3) an order shall not be made under subsection (2)` FALSE (`Provision of the Code` OF 334, "") FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- (b)(iv)
#ASSERT `s 491.1(3) an order shall not be made under subsection (2)` FALSE (`Provision of the Code` OF 334, "") FALSE FALSE FALSE FALSE EQUALS NOTHING

#ASSERT `s 491.1(4) the peace officers shall execute the order` TRUE EQUALS JUST TRUE
#ASSERT `s 491.1(4) the peace officers shall execute the order` FALSE EQUALS NOTHING
-- the text gives no time for the act, so the trace has no WITHIN; the party does the act: expected FULFILLED
#TRACE `s 491.1(4) the duty of a peace officer` AT 0 WITH
    PARTY `a peace officer` DOES `s 491.1(4) execute the order made under this section` AT 1

#ASSERT `s 491.2(1) the person may take and retain a photograph of the property` (`Provision of the Code` OF 334, "") TRUE TRUE TRUE EQUALS JUST TRUE   -- an offence under section 334
#ASSERT `s 491.2(1) the person may take and retain a photograph of the property` (`Provision of the Code` OF 344, "") TRUE TRUE TRUE EQUALS JUST TRUE   -- an offence under section 344
#ASSERT `s 491.2(1) the person may take and retain a photograph of the property` (`Provision of the Code` OF 348, "") TRUE TRUE TRUE EQUALS JUST TRUE   -- an offence under section 348
#ASSERT `s 491.2(1) the person may take and retain a photograph of the property` (`Provision of the Code` OF 354, "") TRUE TRUE TRUE EQUALS JUST TRUE   -- an offence under section 354
#ASSERT `s 491.2(1) the person may take and retain a photograph of the property` (`Provision of the Code` OF 355.2, "") TRUE TRUE TRUE EQUALS JUST TRUE   -- an offence under section 355.2
#ASSERT `s 491.2(1) the person may take and retain a photograph of the property` (`Provision of the Code` OF 355.4, "") TRUE TRUE TRUE EQUALS JUST TRUE   -- an offence under section 355.4
#ASSERT `s 491.2(1) the person may take and retain a photograph of the property` (`Provision of the Code` OF 362, "") TRUE TRUE TRUE EQUALS JUST TRUE   -- an offence under section 362
#ASSERT `s 491.2(1) the person may take and retain a photograph of the property` (`Provision of the Code` OF 380, "") TRUE TRUE TRUE EQUALS JUST TRUE   -- an offence under section 380
#ASSERT `s 491.2(1) the person may take and retain a photograph of the property` (`Provision of the Code` OF 335, "") TRUE TRUE TRUE EQUALS NOTHING   -- an offence under section 335 is not listed
#ASSERT `s 491.2(1) the person may take and retain a photograph of the property` (`Provision of the Code` OF 380, "(1)") FALSE TRUE TRUE EQUALS NOTHING   -- the property is not required for the proceeding
#ASSERT `s 491.2(1) the person may take and retain a photograph of the property` (`Provision of the Code` OF 380, "(1)") TRUE FALSE TRUE EQUALS NOTHING   -- after the property has been returned
#ASSERT `s 491.2(1) the person may take and retain a photograph of the property` (`Provision of the Code` OF 380, "(1)") TRUE TRUE FALSE EQUALS NOTHING   -- not a peace officer or under their direction

#ASSERT `s 491.2(2) the photograph is admissible in evidence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 491.2(2) the photograph is admissible in evidence` FALSE TRUE EQUALS NOTHING   -- without: the photograph was taken under subsection (1)
#ASSERT `s 491.2(2) the photograph is admissible in evidence` TRUE FALSE EQUALS NOTHING   -- without: the photograph is accompanied by a certificate of a person containing the statements refer

#ASSERT `s 491.2(2) the photograph has the same probative force as the property would have had if it had been proved in the ordinary way` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 491.2(2) the photograph has the same probative force as the property would have had if it had been proved in the ordinary way` TRUE TRUE EQUALS JUST FALSE   -- evidence to the contrary
#ASSERT `s 491.2(2) the photograph has the same probative force as the property would have had if it had been proved in the ordinary way` FALSE FALSE EQUALS NOTHING

#ASSERT `s 491.2(3) the certificate is admissible in evidence` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 491.2(3) the certificate is admissible in evidence` FALSE TRUE TRUE EQUALS NOTHING   -- without: (a) the certificate of a person states that the person took the photograph under the autho
#ASSERT `s 491.2(3) the certificate is admissible in evidence` TRUE FALSE TRUE EQUALS NOTHING   -- without: (b) it states that the person is a peace officer or took the photograph under the directio
#ASSERT `s 491.2(3) the certificate is admissible in evidence` TRUE TRUE FALSE EQUALS NOTHING   -- without: (c) it states that the photograph is a true photograph

#ASSERT `s 491.2(3) the certificate is evidence of the statements contained in it without proof of the signature of the person appearing to have signed it` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 491.2(3) the certificate is evidence of the statements contained in it without proof of the signature of the person appearing to have signed it` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 491.2(3) the certificate is evidence of the statements contained in it without proof of the signature of the person appearing to have signed it` FALSE FALSE EQUALS NOTHING

#ASSERT `s 491.2(4) the affidavit or solemn declaration is admissible in evidence` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 491.2(4) the affidavit or solemn declaration is admissible in evidence` FALSE TRUE TRUE EQUALS NOTHING   -- without: it is an affidavit or solemn declaration of a peace officer or other person
#ASSERT `s 491.2(4) the affidavit or solemn declaration is admissible in evidence` TRUE FALSE TRUE EQUALS NOTHING   -- without: it states that the person has seized property and detained it or caused it to be detained 
#ASSERT `s 491.2(4) the affidavit or solemn declaration is admissible in evidence` TRUE TRUE FALSE EQUALS NOTHING   -- without: it states that the property was not altered in any manner before the photograph was taken

#ASSERT `s 491.2(4) the affidavit or solemn declaration is evidence of the statements contained in it without proof of the signature or official character` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 491.2(4) the affidavit or solemn declaration is evidence of the statements contained in it without proof of the signature or official character` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 491.2(4) the affidavit or solemn declaration is evidence of the statements contained in it without proof of the signature or official character` FALSE FALSE EQUALS NOTHING

#ASSERT `s 491.2(5) the photograph, certificate, affidavit or solemn declaration shall not be received in evidence` FALSE TRUE TRUE EQUALS JUST FALSE   -- copy and notice given: no bar
#ASSERT `s 491.2(5) the photograph, certificate, affidavit or solemn declaration shall not be received in evidence` FALSE FALSE TRUE EQUALS JUST TRUE   -- no copy
#ASSERT `s 491.2(5) the photograph, certificate, affidavit or solemn declaration shall not be received in evidence` FALSE TRUE FALSE EQUALS JUST TRUE   -- no notice
#ASSERT `s 491.2(5) the photograph, certificate, affidavit or solemn declaration shall not be received in evidence` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 491.2(5) the photograph, certificate, affidavit or solemn declaration shall not be received in evidence` TRUE FALSE FALSE EQUALS JUST FALSE   -- the court orders otherwise

#ASSERT `s 491.2(6) the court may require the person who appears to have signed to appear for examination or cross-examination` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 491.2(6) the court may require the person who appears to have signed to appear for examination or cross-examination` FALSE TRUE EQUALS NOTHING   -- without: the person appears to have signed a certificate, an affidavit or a solemn declaration refe
#ASSERT `s 491.2(6) the court may require the person who appears to have signed to appear for examination or cross-examination` TRUE FALSE EQUALS NOTHING   -- without: the examination or cross-examination is in respect of the issue of proof of any of the fac

#ASSERT `s 491.2(7) the court may order the property to be produced in court or made available for examination` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 491.2(7) the court may order the property to be produced in court or made available for examination` FALSE TRUE TRUE EQUALS JUST FALSE   -- without: the property was seized and returned pursuant to section 489.1 or 490
#ASSERT `s 491.2(7) the court may order the property to be produced in court or made available for examination` TRUE FALSE TRUE EQUALS JUST FALSE   -- without: the court is satisfied that the interests of justice so require
#ASSERT `s 491.2(7) the court may order the property to be produced in court or made available for examination` TRUE TRUE FALSE EQUALS JUST FALSE   -- without: the court is satisfied that it is possible and practicable to do so in the circumstances

#ASSERT `s 491.2(8) photograph` `s 491.2(8) a still photograph` EQUALS JUST TRUE
#ASSERT `s 491.2(8) photograph` `s 491.2(8) a photographic film or plate` EQUALS JUST TRUE
#ASSERT `s 491.2(8) photograph` `s 491.2(8) a microphotographic film` EQUALS JUST TRUE
#ASSERT `s 491.2(8) photograph` `s 491.2(8) a photostatic negative` EQUALS JUST TRUE
#ASSERT `s 491.2(8) photograph` `s 491.2(8) an X-ray film` EQUALS JUST TRUE
#ASSERT `s 491.2(8) photograph` `s 491.2(8) a motion picture` EQUALS JUST TRUE
#ASSERT `s 491.2(8) photograph` `s 491.2(8) a videotape` EQUALS JUST TRUE
#ASSERT `s 491.2(8) photograph` `s 491.2(8) any other kind of thing` EQUALS NOTHING

#ASSERT `s 492(1) the person may seize the thing` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 492(1) the person may seize the thing` FALSE (JUST TRUE) TRUE EQUALS NOTHING   -- not executing a warrant issued under section 487
#ASSERT `s 492(1) the person may seize the thing` TRUE (JUST TRUE) FALSE EQUALS NOTHING   -- no suspicion of an unlawful purpose
#ASSERT `s 492(1) the person may seize the thing` TRUE (JUST FALSE) TRUE EQUALS NOTHING   -- not an explosive substance
#ASSERT `s 492(1) the person may seize the thing` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 492(1) the thing shall be detained` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 492(1) the thing shall be detained` TRUE TRUE FALSE EQUALS JUST FALSE   -- a judge of a superior court orders delivery
#ASSERT `s 492(1) the thing shall be detained` TRUE FALSE TRUE EQUALS JUST FALSE   -- an order under subsection (2)
#ASSERT `s 492(1) the thing shall be detained` FALSE FALSE FALSE EQUALS NOTHING
#TRACE `s 492(1) the duty of the person who executes the warrant to remove and detain what they seize` AT 0 WITH
    PARTY `s 492(1) the person who executes the warrant` DOES `s 492(1) remove to a place of safety anything that they seize under this section and detain it` AT 1

#ASSERT `s 492(2) the thing is forfeited and shall be dealt with as the court directs` TRUE EQUALS JUST TRUE
#ASSERT `s 492(2) the thing is forfeited and shall be dealt with as the court directs` FALSE EQUALS JUST FALSE   -- without: the accused is convicted of an offence in respect of the thing seized by virtue of subsect

#ASSERT `s 492(3) the proceeds of the sale shall be paid to the Attorney General` TRUE EQUALS JUST TRUE
#ASSERT `s 492(3) the proceeds of the sale shall be paid to the Attorney General` FALSE EQUALS JUST FALSE   -- without: the thing to which this section applies is sold
