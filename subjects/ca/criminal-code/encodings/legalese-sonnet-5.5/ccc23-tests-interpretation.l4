IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc23-interpretation`

-- ccc23-tests-interpretation.l4 -- tests for section 672.1. Expected values are written from the text (s 672.1(1) and (2)), never copied from the code.
-- Argument order is the order of the GIVEN lines in ccc23-interpretation.l4.

§ `s 672.1(1) accused`
-- "accused includes a defendant in summary conviction proceedings and an accused in respect of whom a verdict of NCR has been rendered"
#ASSERT `s 672.1(1) accused` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(1) accused` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(1) accused` FALSE FALSE TRUE EQUALS JUST TRUE
-- not covered: "includes" does not close the list
#ASSERT `s 672.1(1) accused` FALSE FALSE FALSE EQUALS NOTHING

§ `s 672.1(1) assessment`
-- by a medical practitioner, of the accused's mental condition, under an order under 672.11 or 672.121
#ASSERT `s 672.1(1) assessment` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- by a person designated by the Attorney General
#ASSERT `s 672.1(1) assessment` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- an assessor but no assessment order: outside the "means"
#ASSERT `s 672.1(1) assessment` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- "and any incidental observation or examination of the accused"
#ASSERT `s 672.1(1) assessment` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(1) assessment` FALSE FALSE TRUE FALSE EQUALS JUST FALSE

§ `s 672.1(1) chairperson (the seam name PLAN.md gives)`
#ASSERT `s 672.1(1) the issuer is the chairperson of a Review Board` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(1) the issuer is the chairperson of a Review Board` FALSE TRUE EQUALS JUST TRUE
-- "includes": a person who is neither is not covered
#ASSERT `s 672.1(1) the issuer is the chairperson of a Review Board` FALSE FALSE EQUALS NOTHING

§ `s 672.1(1) court`
#ASSERT `s 672.1(1) court` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(1) court` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(1) court` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(1) court` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(1) court` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(1) court` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `s 672.1(1) disposition`
#ASSERT `s 672.1(1) disposition` `s 672.1(1) an order made by a court or Review Board under section 672.54` EQUALS JUST TRUE
#ASSERT `s 672.1(1) disposition` `s 672.1(1) an order made by a court under section 672.58` EQUALS JUST TRUE
#ASSERT `s 672.1(1) disposition` `s 672.1(1) a finding made by a court under subsection 672.64(1)` EQUALS JUST TRUE
-- "means": any other decision is not a disposition
#ASSERT `s 672.1(1) disposition` `s 672.1(1) a decision of any other kind` EQUALS JUST FALSE

§ `s 672.1(1) dual status offender`
#ASSERT `s 672.1(1) dual status offender` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(1) dual status offender` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.1(1) dual status offender` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.1(1) dual status offender` FALSE TRUE TRUE EQUALS JUST FALSE

§ `s 672.1(1) high-risk accused, hospital, medical practitioner`
#ASSERT `s 672.1(1) high-risk accused` TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(1) high-risk accused` FALSE EQUALS JUST FALSE
#ASSERT `s 672.1(1) hospital` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(1) hospital` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.1(1) hospital` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.1(1) medical practitioner` TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(1) medical practitioner` FALSE EQUALS JUST FALSE

§ `s 672.1(1) party`
-- Argument order: proceedings to make or review a disposition; (a) the accused; (b) person in charge of the hospital; (c) Attorney General designated under 672.5(3);
-- (d) interested person designated under 672.5(4); the prosecutor of the charge; the disposition is to be made by a court.
#ASSERT `s 672.1(1) party` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(1) party` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(1) party` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(1) party` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- (e) the prosecutor is a party only where the disposition is to be made by a court
#ASSERT `s 672.1(1) party` TRUE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(1) party` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- someone else in such proceedings is not a party ("means")
#ASSERT `s 672.1(1) party` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- not proceedings to make or review a disposition: the definition does not speak
#ASSERT `s 672.1(1) party` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `s 672.1(1) placement decision, prescribed, Review Board, verdict`
#ASSERT `s 672.1(1) placement decision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(1) placement decision` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.1(1) placement decision` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.1(1) prescribed` TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(1) prescribed` FALSE EQUALS JUST FALSE
#ASSERT `s 672.1(1) Review Board` TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(1) Review Board` FALSE EQUALS JUST FALSE
#ASSERT `s 672.1(1) verdict of not criminally responsible on account of mental disorder` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(1) verdict of not criminally responsible on account of mental disorder` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.1(1) verdict of not criminally responsible on account of mental disorder` FALSE TRUE EQUALS JUST FALSE

§ `s 672.1(2) the Attorney General of a province is read as the Attorney General of Canada`
-- for each listed provision: a territory, or federal proceedings, makes the reading apply
#ASSERT `s 672.1(2) a reference to the Attorney General of a province is read as a reference to the Attorney General of Canada` `s 672.1(2) subsection 672.5(3)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(2) a reference to the Attorney General of a province is read as a reference to the Attorney General of Canada` `s 672.1(2) subsection 672.5(5)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(2) a reference to the Attorney General of a province is read as a reference to the Attorney General of Canada` `s 672.1(2) paragraph 672.86(1)(b)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(2) a reference to the Attorney General of a province is read as a reference to the Attorney General of Canada` `s 672.1(2) subsection 672.86(2)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(2) a reference to the Attorney General of a province is read as a reference to the Attorney General of Canada` `s 672.1(2) subsection 672.86(2.1)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.1(2) a reference to the Attorney General of a province is read as a reference to the Attorney General of Canada` `s 672.1(2) subsection 672.88(2)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.1(2) a reference to the Attorney General of a province is read as a reference to the Attorney General of Canada` `s 672.1(2) subsection 672.89(2)` TRUE FALSE EQUALS JUST TRUE
-- listed provision, but neither a territory nor federal proceedings: the rule does not speak
#ASSERT `s 672.1(2) a reference to the Attorney General of a province is read as a reference to the Attorney General of Canada` `s 672.1(2) subsection 672.5(3)` FALSE FALSE EQUALS NOTHING
-- a provision the subsection does not list
#ASSERT `s 672.1(2) a reference to the Attorney General of a province is read as a reference to the Attorney General of Canada` `s 672.1(2) a provision not listed in subsection 672.1(2)` TRUE TRUE EQUALS NOTHING
