IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc30-forms-register`

-- ccc30-tests-forms-register.l4 -- tests for ccc30-forms-register.l4. Every expected value below is written by hand from the heading line
-- of the Form it names (raw text lines 17451-18463), never copied from the module's output.

§ `Tests -- the register of Forms 1 to 23`

-- A hand-written constructor, so that the tests do not call the module's own helper.
GIVEN n IS A NUMBER
      ss IS A STRING
GIVETH A `Provision of the Code`
`forms 1 to 23 test provision` MEANS `Provision of the Code` WITH `section` IS n, `subsection` IS ss

-- FORM 1 (Sections 320.29, 462.32, 462.321 and 487): four whole sections, in the heading's order.
#ASSERT `form 1 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 320.29 "", `forms 1 to 23 test provision` 462.32 "", `forms 1 to 23 test provision` 462.321 "", `forms 1 to 23 test provision` 487 ""
#ASSERT `forms 1 to 23 the sections that prescribe the form` `form 1` EQUALS `form 1 the sections that prescribe it`

-- FORM 2 (Sections 506 and 788)
#ASSERT count (`forms 1 to 23 the sections that prescribe the form` `form 2`) EQUALS 2
#ASSERT `form 2 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 506 "", `forms 1 to 23 test provision` 788 ""

-- FORM 4 (Sections 566, 566.1, 580 and 591)
#ASSERT `form 4 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 566 "", `forms 1 to 23 test provision` 566.1 "", `forms 1 to 23 test provision` 580 "", `forms 1 to 23 test provision` 591 ""

-- FORM 5.001 (Subsection 487.012(1)): one subsection
#ASSERT `form 5.001 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 487.012 "(1)"

-- FORM 5.0031 (Subsections 487.0131(2) and (8)): the same section, two subsections
#ASSERT `form 5.0031 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 487.0131 "(2)", `forms 1 to 23 test provision` 487.0131 "(8)"

-- FORM 5.004 (Subsections 487.014(2), 487.0141(2), (5) and (10), 487.015(2), 487.016(2), 487.017(2) and 487.018(3)): eight provisions
#ASSERT count (`forms 1 to 23 the sections that prescribe the form` `form 5.004`) EQUALS 8
#ASSERT `form 5.004 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 487.014 "(2)", `forms 1 to 23 test provision` 487.0141 "(2)", `forms 1 to 23 test provision` 487.0141 "(5)", `forms 1 to 23 test provision` 487.0141 "(10)", `forms 1 to 23 test provision` 487.015 "(2)", `forms 1 to 23 test provision` 487.016 "(2)", `forms 1 to 23 test provision` 487.017 "(2)", `forms 1 to 23 test provision` 487.018 "(3)"

-- FORM 5.041 (Subsections 487.051(4) and 487.055(3.11)): the decimal subsection (3.11) is kept as a string
#ASSERT `form 5.041 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 487.051 "(4)", `forms 1 to 23 test provision` 487.055 "(3.11)"

-- FORM 5.1 (Subsection 320.29(5) and subparagraphs 462.32(4)(a)(ii) and 487.093(1)(a)(ii))
#ASSERT `form 5.1 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 320.29 "(5)", `forms 1 to 23 test provision` 462.32 "(4)(a)(ii)", `forms 1 to 23 test provision` 487.093 "(1)(a)(ii)"

-- FORM 6, 9, 10 and 11 each say (Section 2): they are the Forms that section 2 defines by name
#ASSERT `form 6 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 2 ""
#ASSERT `form 9 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 2 ""
#ASSERT `form 10 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 2 ""
#ASSERT `form 11 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 2 ""

-- FORM 7 (Sections 475, 493, 597, 800 and 803) and FORM 8 (Sections 493 and 515): section 493 is named by both
#ASSERT `form 7 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 475 "", `forms 1 to 23 test provision` 493 "", `forms 1 to 23 test provision` 597 "", `forms 1 to 23 test provision` 800 "", `forms 1 to 23 test provision` 803 ""
#ASSERT `form 8 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 493 "", `forms 1 to 23 test provision` 515 ""

-- FORM 16.1 (Subsections 278.12(5) and 699(7)): a section number below 300 that sorts before 699
#ASSERT `form 16.1 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 278.12 "(5)", `forms 1 to 23 test provision` 699 "(7)"

-- FORM 23 (Sections 83.3, 810, 810.01, 810.011, 810.03, 810.1 and 810.2): seven sections, section 83.3 first and 810.2 last
#ASSERT count (`forms 1 to 23 the sections that prescribe the form` `form 23`) EQUALS 7
#ASSERT `form 23 the sections that prescribe it` EQUALS LIST `forms 1 to 23 test provision` 83.3 "", `forms 1 to 23 test provision` 810 "", `forms 1 to 23 test provision` 810.01 "", `forms 1 to 23 test provision` 810.011 "", `forms 1 to 23 test provision` 810.03 "", `forms 1 to 23 test provision` 810.1 "", `forms 1 to 23 test provision` 810.2 ""

-- The three repealed Forms: carried as the text shows them, and naming no section
#ASSERT `form 3 as the text shows it` EQUALS "FORM 3 [Repealed, R.S., 1985, c. 27 (1st Supp.), s. 184]"
#ASSERT `form 13 as the text shows it` EQUALS "FORM 13 [Repealed, 2019, c. 25, s. 337]"
#ASSERT `form 14 as the text shows it` EQUALS "FORM 14 [Repealed, 2019, c. 25, s. 337]"
#ASSERT null (`forms 1 to 23 the sections that prescribe the form` `form 3`)
#ASSERT null (`forms 1 to 23 the sections that prescribe the form` `form 13`)
#ASSERT null (`forms 1 to 23 the sections that prescribe the form` `form 14`)

-- The process document each Form prescribes, by its own title
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 1` EQUALS JUST `an information`
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 2` EQUALS JUST `an information`
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 4` EQUALS JUST `an indictment`
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 5` EQUALS JUST `a search warrant`
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 6` EQUALS JUST `a summons`
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 7` EQUALS JUST `a warrant for arrest`
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 5.062` EQUALS JUST `a warrant for arrest`
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 6.4` EQUALS JUST `a warrant for arrest`
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 9` EQUALS JUST `an appearance notice`
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 10` EQUALS JUST `an undertaking`
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 11` EQUALS JUST `a release order`
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 16` EQUALS JUST `a subpoena`
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 16.1` EQUALS JUST `a subpoena`

-- Not covered: a title that is no core process document ("Warrant for Committal", "Preservation Order", "Surety Declaration", ...)
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 8` EQUALS NOTHING
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 5.001` EQUALS NOTHING
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 5.003` EQUALS NOTHING
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 12` EQUALS NOTHING
#ASSERT `forms 1 to 23 the process document the form prescribes` `form 3` EQUALS NOTHING

