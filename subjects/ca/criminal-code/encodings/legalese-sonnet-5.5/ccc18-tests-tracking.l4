IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc18-tracking`

-- ccc18-tests-tracking.l4 -- tests for ccc18-tracking.l4. Expected values are written from the text of the Criminal Code
-- (R.S.C., 1985, c. C-46, lines 10275-10956 of the plain-text rendering), beside each assertion, and not copied from the module's own output.

#ASSERT `s 492.1(1) the justice or judge may issue a warrant for a tracking device` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 492.1(1) the justice or judge may issue a warrant for a tracking device` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- without: the issuer is a justice or a judge
#ASSERT `s 492.1(1) the justice or judge may issue a warrant for a tracking device` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- without: the justice or judge is satisfied by information on oath that there are reasonable grounds
#ASSERT `s 492.1(1) the justice or judge may issue a warrant for a tracking device` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- without: the justice or judge is satisfied that tracking the location of one or more transactions o
#ASSERT `s 492.1(1) the justice or judge may issue a warrant for a tracking device` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- without: the warrant authorizes a peace officer or a public officer to obtain that tracking data by
-- a permission: the justice issues the warrant: expected FULFILLED
#TRACE `s 492.1(1) the power of the justice or judge to issue the warrant` AT 0 WITH
    PARTY `a justice` DOES `s 492.1(1) issue a warrant authorizing a peace officer or a public officer to obtain tracking data by means of a tracking device` AT 1

#ASSERT `s 492.1(2) the justice or judge may issue a warrant for a tracking device, for an individual` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 492.1(2) the justice or judge may issue a warrant for a tracking device, for an individual` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- without: the issuer is a justice or a judge
#ASSERT `s 492.1(2) the justice or judge may issue a warrant for a tracking device, for an individual` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- without: the justice or judge is satisfied by information on oath that there are reasonable grounds
#ASSERT `s 492.1(2) the justice or judge may issue a warrant for a tracking device, for an individual` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- without: the justice or judge is satisfied that tracking an individual’s movement by identifying th
#ASSERT `s 492.1(2) the justice or judge may issue a warrant for a tracking device, for an individual` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- without: the warrant authorizes a peace officer or a public officer to obtain that tracking data by
-- a permission: the justice issues the warrant: expected FULFILLED
#TRACE `s 492.1(2) the power of the justice or judge to issue the warrant` AT 0 WITH
    PARTY `a justice` DOES `s 492.1(2) issue a warrant authorizing a peace officer or a public officer to obtain tracking data about an individual by means of a tracking device` AT 1

#ASSERT `s 492.1(3) the warrant authorizes the act` `s 492.1(3) install the tracking device` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 492.1(3) the warrant authorizes the act` `s 492.1(3) activate the tracking device` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 492.1(3) the warrant authorizes the act` `s 492.1(3) use the tracking device` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 492.1(3) the warrant authorizes the act` `s 492.1(3) maintain the tracking device` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 492.1(3) the warrant authorizes the act` `s 492.1(3) monitor the tracking device` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 492.1(3) the warrant authorizes the act` `s 492.1(3) remove the tracking device` TRUE TRUE EQUALS JUST TRUE   -- including covertly
#ASSERT `s 492.1(3) the warrant authorizes the act` `s 492.1(3) any other act` TRUE FALSE EQUALS NOTHING
#ASSERT `s 492.1(3) the warrant authorizes the act` `s 492.1(3) install the tracking device` FALSE FALSE EQUALS NOTHING   -- done by someone not acting under the officer's direction

#ASSERT `s 492.1(4) the warrant may contain the condition` TRUE EQUALS JUST TRUE
#ASSERT `s 492.1(4) the warrant may contain the condition` FALSE EQUALS NOTHING   -- without: the justice or judge considers the condition appropriate

-- 492.1(5): issued on 1 March 2020: 60 days after is 30 April 2020.
#ASSERT `s 492.1(5) the day a number of days after the day` (Date 1 3 2020) 60 EQUALS Date 30 4 2020
#ASSERT `s 492.1(5) the warrant is valid for the period specified in it` (Date 1 3 2020) (Date 30 4 2020) EQUALS JUST TRUE   -- the sixtieth day
#ASSERT `s 492.1(5) the warrant is valid for the period specified in it` (Date 1 3 2020) (Date 1 5 2020) EQUALS JUST FALSE   -- the sixty-first day
#ASSERT `s 492.1(5) the warrant is valid for the period specified in it` (Date 1 3 2020) (Date 1 3 2020) EQUALS JUST TRUE
#ASSERT `s 492.1(6) one year after the day` (Date 1 3 2020) EQUALS Date 1 3 2021

-- 492.1(6): issued on 1 March 2020; one year after is 1 March 2021.
#ASSERT `s 492.1(6) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 467.11, "") FALSE (JUST FALSE) EQUALS JUST TRUE   -- (a) section 467.11
#ASSERT `s 492.1(6) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 467.12, "(1)") FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 492.1(6) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 467.13, "") FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 492.1(6) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 2 3 2021) (`Provision of the Code` OF 467.13, "") FALSE (JUST FALSE) EQUALS JUST FALSE   -- a day over the year
#ASSERT `s 492.1(6) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 467.1, "") FALSE (JUST FALSE) EQUALS NOTHING   -- section 467.1 is outside 467.11 to 467.13
#ASSERT `s 492.1(6) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 467.14, "") FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 492.1(6) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 334, "") TRUE (JUST FALSE) EQUALS JUST TRUE   -- (b) criminal organization
#ASSERT `s 492.1(6) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 334, "") FALSE (JUST TRUE) EQUALS JUST TRUE   -- (c) terrorism offence
#ASSERT `s 492.1(6) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 334, "") FALSE (JUST FALSE) EQUALS NOTHING   -- none of (a), (b), (c)
#ASSERT `s 492.1(6) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 334, "") FALSE NOTHING EQUALS NOTHING

#ASSERT `s 492.1(6.1) (place) the warrant may be executed at the place` TRUE EQUALS JUST TRUE
#ASSERT `s 492.1(6.1) (place) the warrant may be executed at the place` FALSE EQUALS NOTHING   -- without: the place is in Canada

#ASSERT `s 492.1(6.1) (officer) the officer who executes the warrant has the authority the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 492.1(6.1) (officer) the officer who executes the warrant has the authority the subsection requires` FALSE EQUALS JUST FALSE   -- without: the public officer or peace officer who executes the warrant has authority to act in that 

#ASSERT `s 492.1(7) the justice or judge may authorize the covert removal of the tracking device after the expiry of the warrant` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 492.1(7) the justice or judge may authorize the covert removal of the tracking device after the expiry of the warrant` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- without: the application is ex parte and supported by an affidavit
#ASSERT `s 492.1(7) the justice or judge may authorize the covert removal of the tracking device after the expiry of the warrant` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- without: the justice or judge is the one who issued the warrant or another justice or judge who has
#ASSERT `s 492.1(7) the justice or judge may authorize the covert removal of the tracking device after the expiry of the warrant` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- without: the warrant has expired
#ASSERT `s 492.1(7) the justice or judge may authorize the covert removal of the tracking device after the expiry of the warrant` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- without: the conditions are ones that the justice or judge considers advisable in the public intere

#ASSERT `s 492.1(7) the authorization is valid for the period specified in it` 90 EQUALS JUST TRUE
#ASSERT `s 492.1(7) the authorization is valid for the period specified in it` 91 EQUALS JUST FALSE
#ASSERT `s 492.1(7) the authorization is valid for the period specified in it` 1 EQUALS JUST TRUE

#ASSERT `s 492.1(8) "data" data` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 492.1(8) "data" data` FALSE TRUE EQUALS JUST FALSE   -- without: it is a representation, including signs, signals or symbols
#ASSERT `s 492.1(8) "data" data` TRUE FALSE EQUALS JUST FALSE   -- without: it is capable of being understood by an individual or processed by a computer system or ot

#ASSERT `s 492.1(8) "judge"` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 492.1(8) "judge"` (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 492.1(8) "judge"` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 492.1(8) "judge"` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 492.1(8) "judge"` NOTHING TRUE EQUALS JUST TRUE

#ASSERT `s 492.1(8) "public officer"` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 492.1(8) "public officer"` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 492.1(8) "public officer"` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 492.1(8) "public officer"` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 492.1(8) "public officer"` NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 492.1(8) "public officer"` NOTHING FALSE TRUE EQUALS JUST FALSE

#ASSERT `s 492.1(8) "tracking data" tracking data` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 492.1(8) "tracking data" tracking data` FALSE TRUE EQUALS JUST FALSE   -- without: it is data, as defined in this subsection
#ASSERT `s 492.1(8) "tracking data" tracking data` TRUE FALSE EQUALS JUST FALSE   -- without: it relates to the location of a transaction, individual or thing

#ASSERT `s 492.1(8) "tracking device"` TRUE (JUST FALSE) TRUE EQUALS JUST TRUE   -- a device
#ASSERT `s 492.1(8) "tracking device"` FALSE (JUST TRUE) TRUE EQUALS JUST TRUE   -- a computer program
#ASSERT `s 492.1(8) "tracking device"` FALSE (JUST FALSE) TRUE EQUALS JUST FALSE   -- neither
#ASSERT `s 492.1(8) "tracking device"` FALSE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 492.1(8) "tracking device"` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE   -- cannot be used to obtain or record tracking data

#ASSERT `s 492.2(1) the justice or judge may issue a warrant for a transmission data recorder` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(1) the justice or judge may issue a warrant for a transmission data recorder` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- without: the issuer is a justice or a judge
#ASSERT `s 492.2(1) the justice or judge may issue a warrant for a transmission data recorder` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- without: the justice or judge is satisfied by information on oath that there are reasonable grounds
#ASSERT `s 492.2(1) the justice or judge may issue a warrant for a transmission data recorder` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- without: the justice or judge is satisfied that transmission data will assist in the investigation 
#ASSERT `s 492.2(1) the justice or judge may issue a warrant for a transmission data recorder` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- without: the warrant authorizes a peace officer or a public officer to obtain the transmission data
-- a permission: the justice issues the warrant: expected FULFILLED
#TRACE `s 492.2(1) the power of the justice or judge to issue the warrant` AT 0 WITH
    PARTY `a justice` DOES `s 492.2(1) issue a warrant authorizing a peace officer or a public officer to obtain transmission data by means of a transmission data recorder` AT 1

#ASSERT `s 492.2(2) the warrant authorizes the act` `s 492.2(2) install the transmission data recorder` TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(2) the warrant authorizes the act` `s 492.2(2) activate the transmission data recorder` TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(2) the warrant authorizes the act` `s 492.2(2) use the transmission data recorder` TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(2) the warrant authorizes the act` `s 492.2(2) maintain the transmission data recorder` TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(2) the warrant authorizes the act` `s 492.2(2) monitor the transmission data recorder` TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(2) the warrant authorizes the act` `s 492.2(2) remove the transmission data recorder` TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(2) the warrant authorizes the act` `s 492.2(2) any other act` TRUE EQUALS NOTHING
#ASSERT `s 492.2(2) the warrant authorizes the act` `s 492.2(2) install the transmission data recorder` FALSE EQUALS NOTHING

#ASSERT `s 492.2(3) no warrant shall be issued under this section` TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(3) no warrant shall be issued under this section` FALSE EQUALS NOTHING   -- without: the purpose of the warrant is to obtain tracking data

#ASSERT `s 492.2(4) the warrant is valid for the period specified in it` (Date 1 3 2020) (Date 30 4 2020) EQUALS JUST TRUE
#ASSERT `s 492.2(4) the warrant is valid for the period specified in it` (Date 1 3 2020) (Date 1 5 2020) EQUALS JUST FALSE

#ASSERT `s 492.2(5) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 467.11, "") FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 492.2(5) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 2 3 2021) (`Provision of the Code` OF 467.11, "") FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 492.2(5) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 334, "") TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 492.2(5) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 334, "") FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 492.2(5) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 334, "") FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 492.2(5) the warrant is valid for the period specified in it, for organized crime and terrorism offences` (Date 1 3 2020) (Date 1 3 2021) (`Provision of the Code` OF 334, "") FALSE NOTHING EQUALS NOTHING

#ASSERT `s 492.2(5.1) (place) the warrant may be executed at the place` TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(5.1) (place) the warrant may be executed at the place` FALSE EQUALS NOTHING   -- without: the place is in Canada

#ASSERT `s 492.2(5.1) (officer) the officer who executes the warrant has the authority the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(5.1) (officer) the officer who executes the warrant has the authority the subsection requires` FALSE EQUALS JUST FALSE   -- without: the public officer or peace officer who executes the warrant has authority to act in that 

#ASSERT `s 492.2(6) "data" data` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(6) "data" data` FALSE TRUE EQUALS JUST FALSE   -- without: it is a representation, including signs, signals or symbols
#ASSERT `s 492.2(6) "data" data` TRUE FALSE EQUALS JUST FALSE   -- without: it is capable of being understood by an individual or processed by a computer system or ot

#ASSERT `s 492.2(6) "judge"` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 492.2(6) "judge"` (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(6) "judge"` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 492.2(6) "judge"` NOTHING FALSE EQUALS NOTHING

#ASSERT `s 492.2(6) "public officer"` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(6) "public officer"` (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 492.2(6) "public officer"` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 492.2(6) "public officer"` NOTHING TRUE TRUE EQUALS NOTHING

#ASSERT `s 492.2(6) "transmission data"` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- (b) first limb
#ASSERT `s 492.2(6) "transmission data"` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b) second limb
#ASSERT `s 492.2(6) "transmission data"` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 492.2(6) "transmission data"` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- neither limb of (b)
#ASSERT `s 492.2(6) "transmission data"` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- (c): it reveals the substance, meaning or purpose
#ASSERT `s 492.2(6) "transmission data"` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- (a) missing
#ASSERT `s 492.2(6) "transmission data"` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- not data

#ASSERT `s 492.2(6) "transmission data recorder"` TRUE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(6) "transmission data recorder"` FALSE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 492.2(6) "transmission data recorder"` FALSE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 492.2(6) "transmission data recorder"` FALSE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 492.2(6) "transmission data recorder"` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
