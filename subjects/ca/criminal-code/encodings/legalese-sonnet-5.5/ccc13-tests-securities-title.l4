IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc13-securities-title`
IMPORT `ccc13-tests-support`

-- ccc13-tests-securities-title.l4 -- tests of ccc13-securities-title.l4 (ss 382 to 392). Expected values are decided from the text.

`ccc13 test the hybrid class` MEANS `an offence that the section makes both indictable and punishable on summary conviction`

§ `s 382 fraudulent manipulation of stock exchange transactions`
-- inputs: facility; intent (appearance of active trading); intent (market price); (a) no change in beneficial ownership; (b) matching purchase order; (c) matching sale order
#ASSERT `s 382 the conduct is the offence of fraudulent manipulation of stock exchange transactions` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 382 the conduct is the offence of fraudulent manipulation of stock exchange transactions` TRUE FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE      -- intent as to the market price, and (b)
#ASSERT `s 382 the conduct is the offence of fraudulent manipulation of stock exchange transactions` TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE       -- (c)
#ASSERT `s 382 the conduct is the offence of fraudulent manipulation of stock exchange transactions` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE      -- not through the facility of a market
#ASSERT `s 382 the conduct is the offence of fraudulent manipulation of stock exchange transactions` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE      -- neither intent
#ASSERT `s 382 the conduct is the offence of fraudulent manipulation of stock exchange transactions` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE     -- none of (a), (b), (c)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 382 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `ten years`
#ASSERT `ccc13 test the summary limb is the s 787(1) stand-in` (`s 382 the punishments` `ccc13 test p787`) EQUALS TRUE
#ASSERT `s 382 the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 382.1 prohibited insider trading`
#ASSERT `s 382.1(4) the information is inside information` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 382.1(4) the information is inside information` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 382.1(4) the information is inside information` TRUE FALSE TRUE EQUALS JUST FALSE      -- generally disclosed
#ASSERT `s 382.1(4) the information is inside information` TRUE TRUE FALSE EQUALS JUST FALSE      -- not expected to significantly affect the market price
#ASSERT `s 382.1(3) the act is saved from being an offence under section 382.1` TRUE EQUALS JUST TRUE
#ASSERT `s 382.1(3) the act is saved from being an offence under section 382.1` FALSE EQUALS JUST FALSE
`ccc13 test way (a)` MEANS `s 382.1(1) possessed by virtue of being a shareholder of the issuer of that security`
`ccc13 test way (e)` MEANS `s 382.1(1) obtained from a person who possesses or obtained the information in a manner referred to in paragraphs (a) to (d)`
`ccc13 test no way` MEANS `s 382.1(1) none of the ways in paragraphs (a) to (e)`
-- inputs of (1): buys or sells; knowingly uses; inside information (s 382.1(4)); how they came by it; the saving (s 382.1(3))
#ASSERT `s 382.1(1) the conduct is the offence of buying or selling a security using inside information` TRUE TRUE (JUST TRUE) `ccc13 test way (a)` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 382.1(1) the conduct is the offence of buying or selling a security using inside information` TRUE TRUE (JUST TRUE) `ccc13 test way (e)` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 382.1(1) the conduct is the offence of buying or selling a security using inside information` TRUE TRUE (JUST TRUE) `ccc13 test no way` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 382.1(1) the conduct is the offence of buying or selling a security using inside information` FALSE TRUE (JUST TRUE) `ccc13 test way (a)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 382.1(1) the conduct is the offence of buying or selling a security using inside information` TRUE FALSE (JUST TRUE) `ccc13 test way (a)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 382.1(1) the conduct is the offence of buying or selling a security using inside information` TRUE TRUE (JUST FALSE) `ccc13 test way (a)` (JUST FALSE) EQUALS JUST FALSE      -- not inside information
#ASSERT `s 382.1(1) the conduct is the offence of buying or selling a security using inside information` TRUE TRUE NOTHING `ccc13 test way (a)` (JUST FALSE) EQUALS NOTHING             -- NOTHING is carried, never turned into FALSE
#ASSERT `s 382.1(1) the conduct is the offence of buying or selling a security using inside information` TRUE TRUE (JUST TRUE) `ccc13 test way (a)` (JUST TRUE) EQUALS JUST FALSE        -- the saving applies: "an act is not an offence under this section"
#ASSERT `s 382.1(1) the conduct is the offence of buying or selling a security using inside information` TRUE TRUE (JUST TRUE) `ccc13 test way (a)` NOTHING EQUALS NOTHING
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 382.1(1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `ten years`
#ASSERT `s 382.1(1) the class of the offence` EQUALS `ccc13 test the hybrid class`
-- inputs of (2): necessary in the course of business; knowingly conveys; inside information; how; knows the risk; the saving
#ASSERT `s 382.1(2) the conduct is the offence of tipping` FALSE TRUE (JUST TRUE) `ccc13 test way (a)` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 382.1(2) the conduct is the offence of tipping` TRUE TRUE (JUST TRUE) `ccc13 test way (a)` TRUE (JUST FALSE) EQUALS JUST FALSE      -- "Except when necessary in the course of business"
#ASSERT `s 382.1(2) the conduct is the offence of tipping` FALSE FALSE (JUST TRUE) `ccc13 test way (a)` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 382.1(2) the conduct is the offence of tipping` FALSE TRUE (JUST TRUE) `ccc13 test no way` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 382.1(2) the conduct is the offence of tipping` FALSE TRUE (JUST TRUE) `ccc13 test way (a)` FALSE (JUST FALSE) EQUALS JUST FALSE     -- no knowledge of the risk
#ASSERT `s 382.1(2) the conduct is the offence of tipping` FALSE TRUE NOTHING `ccc13 test way (a)` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 382.1(2) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 382.1(2) the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 383 gaming in stocks or merchandise`
-- inputs of (1): intent to gain; goods (s 379); shares of stock, wares or merchandise; makes or signs a contract; without bona fide intention of acquiring or selling; no delivery; without bona fide intention of delivery; broker receives delivery
#ASSERT `s 383(1) the conduct is the offence of gaming in stocks or merchandise` TRUE (JUST FALSE) TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE       -- limb (a), shares of stock
#ASSERT `s 383(1) the conduct is the offence of gaming in stocks or merchandise` TRUE (JUST TRUE) FALSE TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE        -- limb (b), goods
#ASSERT `s 383(1) the conduct is the offence of gaming in stocks or merchandise` TRUE (JUST FALSE) TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE      -- limb (b) needs the missing bona fide intention to deliver
#ASSERT `s 383(1) the conduct is the offence of gaming in stocks or merchandise` TRUE (JUST FALSE) TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE     -- neither limb
#ASSERT `s 383(1) the conduct is the offence of gaming in stocks or merchandise` FALSE (JUST FALSE) TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE     -- no intent to make gain or profit
#ASSERT `s 383(1) the conduct is the offence of gaming in stocks or merchandise` TRUE (JUST FALSE) TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE       -- "This section does not apply if a broker, on behalf of a purchaser, receives delivery"
#ASSERT `s 383(1) the conduct is the offence of gaming in stocks or merchandise` TRUE (JUST FALSE) FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE     -- the thing is none of shares, goods, wares or merchandise
#ASSERT `s 383(1) the conduct is the offence of gaming in stocks or merchandise` TRUE NOTHING FALSE TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING             -- s 379 goods is NOTHING
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 383(1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 383(1) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 383(2) the burden of proof of a bona fide intention lies on the accused` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 383(2) the burden of proof of a bona fide intention lies on the accused` FALSE TRUE EQUALS JUST FALSE      -- not proceedings under this section
#ASSERT `s 383(2) the burden of proof of a bona fide intention lies on the accused` TRUE FALSE EQUALS JUST FALSE      -- not established

§ `s 384 broker reducing stock`
-- inputs: capacity; employed as a broker; later sells; account in which they have an interest; effect is to reduce below the amount they should carry
#ASSERT `s 384(1) the conduct is the offence of a broker reducing stock by selling for their own account` `s 384(1) an individual` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 384(1) the conduct is the offence of a broker reducing stock by selling for their own account` `s 384(1) a member or employee of a partnership` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 384(1) the conduct is the offence of a broker reducing stock by selling for their own account` `s 384(1) a director, officer or employee of a corporation` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 384(1) the conduct is the offence of a broker reducing stock by selling for their own account` `s 384(1) a person in none of those capacities` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 384(1) the conduct is the offence of a broker reducing stock by selling for their own account` `s 384(1) an individual` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 384(1) the conduct is the offence of a broker reducing stock by selling for their own account` `s 384(1) an individual` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 384(1) the conduct is the offence of a broker reducing stock by selling for their own account` `s 384(1) an individual` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 384(1) the conduct is the offence of a broker reducing stock by selling for their own account` `s 384(1) an individual` TRUE TRUE TRUE FALSE EQUALS JUST FALSE     -- the effect was unintentional or did not reduce below the amount
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 384(2) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 384(2) the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 385 fraudulent concealment of title documents`
-- inputs of (1): capacity; served with a written demand before completion; (a) conceals; (b) falsifies a pedigree
#ASSERT `s 385(1) the conduct is the offence of fraudulent concealment of title documents` `s 385(1) a vendor, mortgagor or hypothecary debtor of property or a chose in action or an incorporeal right` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 385(1) the conduct is the offence of fraudulent concealment of title documents` `s 385(1) a lawyer or notary for, or an agent or mandatary of, such a vendor, mortgagor or hypothecary debtor` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 385(1) the conduct is the offence of fraudulent concealment of title documents` `s 385(1) a person in neither capacity` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 385(1) the conduct is the offence of fraudulent concealment of title documents` `s 385(1) a lawyer or notary for, or an agent or mandatary of, such a vendor, mortgagor or hypothecary debtor` FALSE TRUE TRUE EQUALS JUST FALSE     -- no demand was served
#ASSERT `s 385(1) the conduct is the offence of fraudulent concealment of title documents` `s 385(1) a lawyer or notary for, or an agent or mandatary of, such a vendor, mortgagor or hypothecary debtor` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 385(1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `two years`
#ASSERT `s 385(1) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 385(2) the section bars the proceedings for want of the consent of the Attorney General` FALSE EQUALS JUST TRUE
#ASSERT `s 385(2) the section bars the proceedings for want of the consent of the Attorney General` TRUE EQUALS NOTHING       -- with the consent the subsection is silent

§ `s 386 fraudulent registration of title`
-- inputs: in a proceeding to register title or a related transaction; knowingly; with intent to deceive; (a) false statement; (b) suppresses or conceals; (c) privy
#ASSERT `s 386 the conduct is the offence of fraudulent registration of title` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 386 the conduct is the offence of fraudulent registration of title` TRUE TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386 the conduct is the offence of fraudulent registration of title` TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386 the conduct is the offence of fraudulent registration of title` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386 the conduct is the offence of fraudulent registration of title` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386 the conduct is the offence of fraudulent registration of title` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386 the conduct is the offence of fraudulent registration of title` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 386 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 386 the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 387 fraudulent sale of real property`
#ASSERT `s 387 the conduct is the offence of fraudulent sale of real property` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 387 the conduct is the offence of fraudulent sale of real property` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 387 the conduct is the offence of fraudulent sale of real property` TRUE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 387 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `two years`
#ASSERT `s 387 the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 388 misleading receipt`
#ASSERT `s 388 the conduct is the offence of giving a misleading receipt` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 388 the conduct is the offence of giving a misleading receipt` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 388 the conduct is the offence of giving a misleading receipt` FALSE TRUE TRUE EQUALS JUST FALSE      -- not knowingly
#ASSERT `s 388 the conduct is the offence of giving a misleading receipt` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 388 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `two years`
#ASSERT `s 388 the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 389 fraudulent disposal of goods on which money advanced`
#ASSERT `s 389(2) the person is saved from guilt of an offence under section 389` TRUE EQUALS JUST TRUE
#ASSERT `s 389(2) the person is saved from guilt of an offence under section 389` FALSE EQUALS JUST FALSE
-- inputs of (1): (a) shipped or delivered; (a) thereafter disposes inconsistently; (a) with intent; (b) aids or assists; the saving of (2)
#ASSERT `s 389(1) the conduct is the offence of fraudulent disposal of goods on which money advanced` TRUE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 389(1) the conduct is the offence of fraudulent disposal of goods on which money advanced` FALSE FALSE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE         -- limb (b)
#ASSERT `s 389(1) the conduct is the offence of fraudulent disposal of goods on which money advanced` TRUE TRUE FALSE FALSE (JUST FALSE) EQUALS JUST FALSE        -- no intent to deceive, defraud or injure
#ASSERT `s 389(1) the conduct is the offence of fraudulent disposal of goods on which money advanced` TRUE FALSE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 389(1) the conduct is the offence of fraudulent disposal of goods on which money advanced` TRUE TRUE TRUE FALSE (JUST TRUE) EQUALS JUST FALSE         -- the saving of (2): the full amount was paid or tendered first
#ASSERT `s 389(1) the conduct is the offence of fraudulent disposal of goods on which money advanced` TRUE TRUE TRUE FALSE NOTHING EQUALS NOTHING
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 389(1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `two years`
#ASSERT `s 389(1) the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 390 fraudulent receipts under the Bank Act`
-- inputs, in the order the function takes them: (a) knowingly makes a false statement; for a purpose mentioned in the Bank Act; (b) knowingly, after giving or endorsing; (b) without consent or production; (b) alienates or does not deliver
#ASSERT `s 390 the conduct is the offence of fraudulent receipts under the Bank Act` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 390 the conduct is the offence of fraudulent receipts under the Bank Act` FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE         -- limb (b) with its three elements
#ASSERT `s 390 the conduct is the offence of fraudulent receipts under the Bank Act` FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE      -- (b) needs the alienation or non-delivery
#ASSERT `s 390 the conduct is the offence of fraudulent receipts under the Bank Act` FALSE TRUE TRUE FALSE TRUE EQUALS JUST FALSE      -- (b) needs the want of consent or production
#ASSERT `s 390 the conduct is the offence of fraudulent receipts under the Bank Act` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE     -- not for a purpose mentioned in the Bank Act
#ASSERT `s 390 the conduct is the offence of fraudulent receipts under the Bank Act` FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 390 the conduct is the offence of fraudulent receipts under the Bank Act` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE     -- neither limb
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 390 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `two years`
#ASSERT `s 390 the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 391 trade secret`
#ASSERT `s 391(5) the information is a trade secret` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 391(5) the information is a trade secret` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 391(5) the information is a trade secret` TRUE FALSE TRUE TRUE EQUALS JUST FALSE     -- generally known
#ASSERT `s 391(5) the information is a trade secret` TRUE TRUE FALSE TRUE EQUALS JUST FALSE     -- no economic value from not being known
#ASSERT `s 391(5) the information is a trade secret` TRUE TRUE TRUE FALSE EQUALS JUST FALSE     -- no reasonable efforts to keep it secret
#ASSERT `s 391(4) the person is saved from committing an offence under subsection (1) or (2)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 391(4) the person is saved from committing an offence under subsection (1) or (2)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 391(4) the person is saved from committing an offence under subsection (1) or (2)` FALSE FALSE EQUALS JUST FALSE
-- inputs of (1): by deceit, falsehood or other fraudulent means; knowingly obtains or communicates; trade secret (s 391(5)); the saving (s 391(4))
#ASSERT `s 391(1) the conduct is the offence of obtaining a trade secret by fraudulent means` TRUE TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 391(1) the conduct is the offence of obtaining a trade secret by fraudulent means` FALSE TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 391(1) the conduct is the offence of obtaining a trade secret by fraudulent means` TRUE FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 391(1) the conduct is the offence of obtaining a trade secret by fraudulent means` TRUE TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE     -- not a trade secret
#ASSERT `s 391(1) the conduct is the offence of obtaining a trade secret by fraudulent means` TRUE TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE      -- saved: independent development or reverse engineering
#ASSERT `s 391(1) the conduct is the offence of obtaining a trade secret by fraudulent means` TRUE TRUE NOTHING (JUST FALSE) EQUALS NOTHING
-- inputs of (2): knowingly obtains or communicates; knows it was obtained by an offence under (1); trade secret; saving
#ASSERT `s 391(2) the conduct is the offence of obtaining a trade secret with prior knowledge` TRUE TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 391(2) the conduct is the offence of obtaining a trade secret with prior knowledge` TRUE FALSE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 391(2) the conduct is the offence of obtaining a trade secret with prior knowledge` TRUE TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 391(3) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `fourteen years`
#ASSERT `s 391(3) the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 392 disposal of property to defraud creditors`
-- inputs: (a) intent to defraud creditors; (a)(i) gift, conveyance and the like; (a)(ii) removes, conceals or disposes; (b) intent that any one should defraud creditors; (b) receives property
#ASSERT `s 392 the conduct is the offence of disposing of property to defraud creditors` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 392 the conduct is the offence of disposing of property to defraud creditors` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 392 the conduct is the offence of disposing of property to defraud creditors` FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE      -- paragraph (b)
#ASSERT `s 392 the conduct is the offence of disposing of property to defraud creditors` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE     -- no intent
#ASSERT `s 392 the conduct is the offence of disposing of property to defraud creditors` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE    -- intent but no act
#ASSERT `s 392 the conduct is the offence of disposing of property to defraud creditors` FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 392 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `two years`
#ASSERT `s 392 the class of the offence` EQUALS `ccc13 test the hybrid class`
