IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc23-review-boards`

-- ccc23-tests-review-boards.l4 -- tests for sections 672.38 to 672.43. Expected values are written from the text, never copied from the code.

§ `s 672.38`
-- (1) args: number of members; appointed by the lieutenant governor in council of the province. Five is the boundary.
#ASSERT `s 672.38(1) the Review Board is constituted as the subsection requires` 5 TRUE EQUALS JUST TRUE
#ASSERT `s 672.38(1) the Review Board is constituted as the subsection requires` 4 TRUE EQUALS JUST FALSE
#ASSERT `s 672.38(1) the Review Board is constituted as the subsection requires` 9 TRUE EQUALS JUST TRUE
#ASSERT `s 672.38(1) the Review Board is constituted as the subsection requires` 5 FALSE EQUALS JUST FALSE
#ASSERT `s 672.38(2) the Review Board is treated as having been established under the laws of the province` TRUE EQUALS JUST TRUE
#ASSERT `s 672.38(2) the Review Board is treated as having been established under the laws of the province` FALSE EQUALS NOTHING
-- (3) args: a member; in good faith in the exercise of powers or the performance of duties
#ASSERT `s 672.38(3) the member of a Review Board is personally liable` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.38(3) the member of a Review Board is personally liable` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.38(3) the member of a Review Board is personally liable` FALSE TRUE EQUALS NOTHING

§ `s 672.39`
-- args: members entitled to practise psychiatry; another member with mental-health training who may practise medicine or psychology
#ASSERT `s 672.39 the Review Board has the members the section requires` 2 FALSE EQUALS JUST TRUE
#ASSERT `s 672.39 the Review Board has the members the section requires` 1 TRUE EQUALS JUST TRUE
#ASSERT `s 672.39 the Review Board has the members the section requires` 1 FALSE EQUALS JUST FALSE
#ASSERT `s 672.39 the Review Board has the members the section requires` 0 TRUE EQUALS JUST FALSE

§ `s 672.4`
-- (2) args: established before (1) came into force; the chairperson is not a judge or other person in (1); term not expired; another member is a judge or other person in (1) or a member of the bar
#ASSERT `s 672.4(2) the chairperson may continue to act until the expiration of the term of office` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.4(2) the chairperson may continue to act until the expiration of the term of office` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.4(2) the chairperson may continue to act until the expiration of the term of office` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 672.4(2) the chairperson may continue to act until the expiration of the term of office` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.4(2) the chairperson may continue to act until the expiration of the term of office` TRUE FALSE TRUE TRUE EQUALS NOTHING
-- (1) args: a judge of the Federal Court or a superior, district or county court; qualified for appointment; retired; (2) answer
#ASSERT `s 672.4(1) the person may be the chairperson of a Review Board` TRUE FALSE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 672.4(1) the person may be the chairperson of a Review Board` FALSE TRUE FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 672.4(1) the person may be the chairperson of a Review Board` FALSE FALSE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 672.4(1) the person may be the chairperson of a Review Board` FALSE FALSE FALSE NOTHING EQUALS JUST FALSE
-- where subsection (2) lets the chairperson continue, subsection (1) is displaced
#ASSERT `s 672.4(1) the person may be the chairperson of a Review Board` FALSE FALSE FALSE (JUST TRUE) EQUALS NOTHING

§ `s 672.41`
-- (2) args: pre-commencement Board whose chairperson is not a judge; chairperson present; psychiatrist present; a person referred to in 672.4(1) or a member of the bar present
#ASSERT `s 672.41(2) the quorum of the Review Board is constituted` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.41(2) the quorum of the Review Board is constituted` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.41(2) the quorum of the Review Board is constituted` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- (1) args: chairperson present; psychiatrist present; any other member present; (2) applies
#ASSERT `s 672.41(1) the quorum of the Review Board is constituted` TRUE TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 672.41(1) the quorum of the Review Board is constituted` TRUE TRUE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 672.41(1) the quorum of the Review Board is constituted` TRUE FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 672.41(1) the quorum of the Review Board is constituted` FALSE TRUE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 672.41(1) the quorum of the Review Board is constituted` TRUE TRUE TRUE (JUST TRUE) EQUALS NOTHING

§ `ss 672.42 and 672.43`
-- 672.42 args: members present and voting; members voting for. A majority is more than half.
#ASSERT `s 672.42 the decision is the decision of the Review Board` 5 3 EQUALS JUST TRUE
#ASSERT `s 672.42 the decision is the decision of the Review Board` 5 2 EQUALS NOTHING
#ASSERT `s 672.42 the decision is the decision of the Review Board` 4 2 EQUALS NOTHING
#ASSERT `s 672.42 the decision is the decision of the Review Board` 4 3 EQUALS JUST TRUE
#ASSERT `s 672.43 the chairperson has the powers conferred by sections 4 and 5 of the Inquiries Act on commissioners` TRUE EQUALS JUST TRUE
#ASSERT `s 672.43 the chairperson has the powers conferred by sections 4 and 5 of the Inquiries Act on commissioners` FALSE EQUALS NOTHING
