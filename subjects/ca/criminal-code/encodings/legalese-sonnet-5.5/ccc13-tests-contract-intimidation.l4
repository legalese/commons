#ASSERT `s 426(1) the conduct is the offence of a secret commission` FALSE FALSE TRUE TRUE TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 426(1) the conduct is the offence of a secret commission` TRUE FALSE FALSE FALSE FALSE FALSE (JUST TRUE) EQUALS JUST FALSE      -- (a) needs the consideration for an act
