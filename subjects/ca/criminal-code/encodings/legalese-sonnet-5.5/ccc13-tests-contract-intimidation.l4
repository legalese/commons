#ASSERT `s 424 the conduct is the offence of a threat against an internationally protected person` TRUE (`ccc13 test the provision` 431 "") (JUST FALSE) EQUALS JUST TRUE        -- a threat under section 431 needs no internationally protected person
#ASSERT `s 424 the conduct is the offence of a threat against an internationally protected person` TRUE (`ccc13 test the provision` 235 "") (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 424 the conduct is the offence of a threat against an internationally protected person` TRUE (`ccc13 test the provision` 235 "") NOTHING EQUALS NOTHING
#ASSERT `s 424 the conduct is the offence of a threat against an internationally protected person` TRUE (`ccc13 test the provision` 269.01 "") (JUST TRUE) EQUALS JUST FALSE        -- 269.01 is not 269 or 269.1
#ASSERT `s 424 the conduct is the offence of a threat against an internationally protected person` TRUE (`ccc13 test the provision` 280 "") (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 424 the conduct is the offence of a threat against an internationally protected person` FALSE (`ccc13 test the provision` 235 "") (JUST TRUE) EQUALS JUST FALSE
