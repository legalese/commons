§ `s 426 secret commissions`
#ASSERT `s 426(4) the person is an agent` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 426(4) the person is an agent` FALSE TRUE EQUALS JUST TRUE         -- "agent includes an employee"
