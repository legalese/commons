        IF `the court is of the opinion that a separate prosecution for one or more of the other offences is necessary in the public interest` THEN JUST FALSE   -- FALSE-kind (the text says no in its own words): "unless the court is of the opinion that a separate prosecution for one or more of the other offences is necessary in the public interest"
        IF `s 2 Attorney General: the person who consented is the Attorney General` EQUALS NOTHING THEN NOTHING   -- NOTHING-kind (points outside the text): who is the Attorney General for this proceeding is for section 2
        IF (NOT ((`s 2 Attorney General: the person who consented is the Attorney General` EQUALS JUST TRUE) AND `that person has consented`)) OR (NOT `the offender consents`) THEN JUST FALSE   -- FALSE-kind (the text says no in its own words): "subject to the following conditions: (i) the Attorney General and the offender consent"
        IF NOT `the court has jurisdiction to try each charge` THEN JUST FALSE   -- FALSE-kind (the text says no in its own words): "(ii) the court has jurisdiction to try each charge"
        IF NOT `each charge has been described in open court` THEN JUST FALSE   -- FALSE-kind (the text says no in its own words): "(iii) each charge has been described in open court"
        IF NOT `the offender has agreed with the facts asserted in the description of each charge` THEN JUST FALSE   -- FALSE-kind (the text says no in its own words): "(iv) the offender has agreed with the facts asserted in the description of each charge"
        IF NOT `the offender has acknowledged having committed the offence described in each charge` THEN JUST FALSE   -- FALSE-kind (the text says no in its own words): "(v) the offender has acknowledged having committed the offence described in each charge"
        OTHERWISE JUST TRUE

