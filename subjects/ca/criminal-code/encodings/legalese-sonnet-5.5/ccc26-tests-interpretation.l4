IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc26-interpretation`

-- ccc26-tests-interpretation.l4 -- tests for ccc26-interpretation.l4. Every expected value is written from the text (lines 15171-15188, 15452-15462, 15517-15520, 15734-15737) before the run.

§ `The three-valued helpers (not a reading of the text: Kleene logic, so that NOTHING is never turned into FALSE)`

#ASSERT `s 716 all of the answers` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 716 all of the answers` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 716 all of the answers` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 716 all of the answers` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 716 all of the answers` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 716 all of the answers` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 716 all of the answers` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 716 all of the answers` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 716 any of the answers` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 716 any of the answers` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 716 any of the answers` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 716 any of the answers` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 716 any of the answers` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 716 any of the answers` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 716 any of the answers` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 716 any of the answers` NOTHING NOTHING EQUALS NOTHING

§ `s 716 "accused": accused includes a defendant`

#ASSERT `s 716 accused` `s 716 an accused` EQUALS JUST TRUE
#ASSERT `s 716 accused` `s 716 a defendant` EQUALS JUST TRUE
-- "includes": a person who is neither is not covered (NOT FALSE)
#ASSERT `s 716 accused` `s 716 another person, not named in the definition of accused` EQUALS NOTHING

§ `s 716 "alternative measures": shown repealed`

#ASSERT `s 716 alternative measures, repealed` EQUALS "alternative measures [Repealed, 2026, c. 19, s. 60]"

§ `s 716 "court": means (a) a superior court of criminal jurisdiction, (b) a court of criminal jurisdiction, (c) a justice or provincial court judge acting as a summary conviction court under Part XXVII, or (d) a court that hears an appeal`

--                                        s 2 superior, s 2 criminal jurisdiction, (c),   (d)
#ASSERT `s 716 court` (JUST TRUE)  (JUST FALSE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 716 court` (JUST FALSE) (JUST TRUE)  FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 716 court` (JUST FALSE) (JUST FALSE) TRUE  FALSE EQUALS JUST TRUE
#ASSERT `s 716 court` (JUST FALSE) (JUST FALSE) FALSE TRUE  EQUALS JUST TRUE
-- "court means": a body that is none of (a) to (d) is not a court of Part XXIII
#ASSERT `s 716 court` (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
-- s 2's answer is itself not covered, and (c) and (d) do not rescue it: not covered
#ASSERT `s 716 court` NOTHING (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 716 court` (JUST FALSE) NOTHING FALSE FALSE EQUALS NOTHING
-- but a limb that is JUST TRUE decides the matter whatever s 2 leaves open
#ASSERT `s 716 court` NOTHING NOTHING FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 716 court` NOTHING (JUST TRUE) FALSE FALSE EQUALS JUST TRUE

§ `s 716 "fine": includes a pecuniary penalty or other sum of money, but does not include restitution`

#ASSERT `s 716 fine` `s 716 a pecuniary penalty` EQUALS JUST TRUE
#ASSERT `s 716 fine` `s 716 another sum of money` EQUALS JUST TRUE
#ASSERT `s 716 fine` `s 716 restitution` EQUALS JUST FALSE
#ASSERT `s 716 fine` `s 716 a thing that is none of those` EQUALS NOTHING

§ `ss 717 to 717.4: repealed`

#ASSERT `s 717, repealed` EQUALS "[Repealed, 2026, c. 19, s. 61]"
#ASSERT `s 717.1, repealed` EQUALS "[Repealed, 2026, c. 19, s. 61]"
#ASSERT `s 717.2, repealed` EQUALS "[Repealed, 2026, c. 19, s. 61]"
#ASSERT `s 717.3, repealed` EQUALS "[Repealed, 2026, c. 19, s. 61]"
#ASSERT `s 717.4, repealed` EQUALS "[Repealed, 2026, c. 19, s. 61]"

§ `s 729(2): analyst means a person designated as an analyst under the Controlled Drugs and Substances Act or the Cannabis Act`

#ASSERT `s 729(2) analyst` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 729(2) analyst` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 729(2) analyst` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 729(2) analyst` FALSE FALSE EQUALS JUST FALSE

§ `s 729.1(2): analyst has the same meaning as in section 320.11 (the answer of s 320.11 is an input, passed through)`

#ASSERT `s 729.1(2) analyst` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 729.1(2) analyst` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 729.1(2) analyst` NOTHING EQUALS NOTHING

§ `s 732.1(1): change includes deletions and additions; optional conditions means the conditions referred to in subsection (3) or (3.1)`

#ASSERT `s 732.1(1) change, in relation to optional conditions` `s 732.1(1) a deletion of an optional condition` EQUALS JUST TRUE
#ASSERT `s 732.1(1) change, in relation to optional conditions` `s 732.1(1) an addition of an optional condition` EQUALS JUST TRUE
#ASSERT `s 732.1(1) change, in relation to optional conditions` `s 732.1(1) an alteration that is neither a deletion nor an addition` EQUALS NOTHING
#ASSERT `s 732.1(1) optional conditions` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 732.1(1) optional conditions` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 732.1(1) optional conditions` FALSE FALSE EQUALS JUST FALSE

§ `s 734.8(1): penalty means the aggregate of the fine and the costs and charges (dollars)`

#ASSERT `s 734.8(1) penalty` 100 25 EQUALS 125
#ASSERT `s 734.8(1) penalty` 100 0 EQUALS 100
#ASSERT `s 734.8(1) penalty` 0 40 EQUALS 40
#ASSERT `s 734.8 the fine and its penalty` 100 25 EQUALS `a fine of` 125
#ASSERT `s 734.8 the fine and its penalty` 2000 0 EQUALS `a fine of` 2000

§ `Helper: a date within the five years up to and including a later date`

-- later date 1 March 2027: the five years run back to 1 March 2022
#ASSERT `s 716 the earlier date falls within the five years up to and including the later date` (Date 1 3 2022) (Date 1 3 2027) EQUALS TRUE
#ASSERT `s 716 the earlier date falls within the five years up to and including the later date` (Date 2 3 2022) (Date 1 3 2027) EQUALS TRUE
#ASSERT `s 716 the earlier date falls within the five years up to and including the later date` (Date 28 2 2022) (Date 1 3 2027) EQUALS FALSE
#ASSERT `s 716 the earlier date falls within the five years up to and including the later date` (Date 1 3 2027) (Date 1 3 2027) EQUALS TRUE
#ASSERT `s 716 the earlier date falls within the five years up to and including the later date` (Date 2 3 2027) (Date 1 3 2027) EQUALS FALSE

§ `Helper: the first period is at most the second period (ordered only in months and years, or in days only)`

#ASSERT `s 716 the first period is at most the second period` `six months` `two years less a day` EQUALS JUST TRUE
#ASSERT `s 716 the first period is at most the second period` `two years less a day` `two years` EQUALS JUST TRUE
-- "two years" is not at most "two years less a day"
#ASSERT `s 716 the first period is at most the second period` `two years` `two years less a day` EQUALS JUST FALSE
#ASSERT `s 716 the first period is at most the second period` `two years` `two years` EQUALS JUST TRUE
#ASSERT `s 716 the first period is at most the second period` `two years less a day` `two years less a day` EQUALS JUST TRUE
#ASSERT `s 716 the first period is at most the second period` `five years` `two years less a day` EQUALS JUST FALSE
-- one year is twelve months
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 1, 0, 0, FALSE) (`Length of time` OF 0, 12, 0, FALSE) EQUALS JUST TRUE
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 0, 12, 0, FALSE) (`Length of time` OF 1, 0, 0, FALSE) EQUALS JUST TRUE
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 0, 13, 0, FALSE) (`Length of time` OF 1, 0, 0, FALSE) EQUALS JUST FALSE
-- days only
#ASSERT `s 716 the first period is at most the second period` `ninety days` `ninety days` EQUALS JUST TRUE
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 0, 0, 91, FALSE) `ninety days` EQUALS JUST FALSE
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 0, 0, 90, TRUE) `ninety days` EQUALS JUST TRUE
#ASSERT `s 716 the first period is at most the second period` `ninety days` (`Length of time` OF 0, 0, 90, TRUE) EQUALS JUST FALSE
-- days against months: ordered only where every calendar settles it (a month has 28 to 31 days)
-- ninety days is at most six months (six months last at least 168 days) and six months is more than ninety days
#ASSERT `s 716 the first period is at most the second period` `ninety days` `six months` EQUALS JUST TRUE
#ASSERT `s 716 the first period is at most the second period` `six months` `ninety days` EQUALS JUST FALSE
-- thirty days against one month: a month can have 28, 29, 30 or 31 days, so the calendar does not settle it
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 0, 0, 30, FALSE) (`Length of time` OF 0, 1, 0, FALSE) EQUALS NOTHING
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 0, 1, 0, FALSE) (`Length of time` OF 0, 0, 30, FALSE) EQUALS NOTHING
-- twenty-eight days is at most one month, whatever the month
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 0, 0, 28, FALSE) (`Length of time` OF 0, 1, 0, FALSE) EQUALS JUST TRUE
-- thirty-two days is more than one month, whatever the month
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 0, 0, 32, FALSE) (`Length of time` OF 0, 1, 0, FALSE) EQUALS JUST FALSE
-- ninety days against two years: settled
#ASSERT `s 716 the first period is at most the second period` `ninety days` `two years` EQUALS JUST TRUE
-- two years and one day against two years: the same months, so the extra day decides in every calendar
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 2, 0, 1, FALSE) `two years` EQUALS JUST FALSE
#ASSERT `s 716 the first period is at most the second period` `two years` (`Length of time` OF 2, 0, 1, FALSE) EQUALS JUST TRUE
-- one month less a day lasts 27 to 30 days (a month has 28 to 31): against 26 days it is longer, against 30 days it is at most, against 29 days the calendar decides
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 0, 1, 0, TRUE) (`Length of time` OF 0, 0, 26, FALSE) EQUALS JUST FALSE
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 0, 1, 0, TRUE) (`Length of time` OF 0, 0, 29, FALSE) EQUALS NOTHING
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 0, 1, 0, TRUE) (`Length of time` OF 0, 0, 30, FALSE) EQUALS JUST TRUE
-- one day more than a month against one month and two days
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 0, 1, 1, FALSE) (`Length of time` OF 0, 1, 2, FALSE) EQUALS JUST TRUE
-- two years and a day against two years and a month: a month has at least 28 days, so a day is less in every calendar
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 2, 0, 1, FALSE) (`Length of time` OF 2, 1, 0, FALSE) EQUALS JUST TRUE
#ASSERT `s 716 the first period is at most the second period` (`Length of time` OF 2, 1, 0, FALSE) (`Length of time` OF 2, 0, 1, FALSE) EQUALS JUST FALSE
