IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc3-forfeiture`

-- ccc3-tests-forfeiture.l4 -- tests of sections 83.13 to 83.17. Expected values are hand-written from the text beside each assertion.

§ `Tests of sections 83.13 to 83.17`

`s 83.13(1) the warrant` MEANS `s 83.13(1)(a) a warrant authorizing a person named in it or a peace officer to search the building, receptacle or place for the property and to seize it`
`s 83.13(1) the restraint order` MEANS `s 83.13(1)(b) a restraint order prohibiting any person from disposing of, or otherwise dealing with any interest in, the property`

-- ---- 83.13(1). Arguments: Federal Court judge, ex parte application by the AG, examined in private, satisfied, the order, property situated in Canada.
#ASSERT `s 83.13(1) the judge may issue the warrant or restraint order` TRUE TRUE TRUE TRUE `s 83.13(1) the warrant` TRUE EQUALS JUST TRUE   -- (a): property in Canada
#ASSERT `s 83.13(1) the judge may issue the warrant or restraint order` TRUE TRUE TRUE TRUE `s 83.13(1) the warrant` FALSE EQUALS NOTHING   -- (a) needs property situated in Canada
#ASSERT `s 83.13(1) the judge may issue the warrant or restraint order` TRUE TRUE TRUE TRUE `s 83.13(1) the restraint order` FALSE EQUALS JUST TRUE   -- (b): in or outside Canada
#ASSERT `s 83.13(1) the judge may issue the warrant or restraint order` TRUE TRUE TRUE TRUE `s 83.13(1) the restraint order` TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(1) the judge may issue the warrant or restraint order` FALSE TRUE TRUE TRUE `s 83.13(1) the warrant` TRUE EQUALS JUST FALSE   -- not a judge of the Federal Court: the "Where" is unmet
#ASSERT `s 83.13(1) the judge may issue the warrant or restraint order` TRUE FALSE TRUE TRUE `s 83.13(1) the restraint order` TRUE EQUALS JUST FALSE   -- not ex parte, or not the Attorney General
#ASSERT `s 83.13(1) the judge may issue the warrant or restraint order` TRUE TRUE FALSE TRUE `s 83.13(1) the restraint order` TRUE EQUALS JUST FALSE   -- not examined in private
#ASSERT `s 83.13(1) the judge may issue the warrant or restraint order` TRUE TRUE TRUE FALSE `s 83.13(1) the restraint order` TRUE EQUALS JUST FALSE   -- not satisfied of reasonable grounds
#ASSERT `s 83.13(1.1) the affidavit may be sworn on information and belief` TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(1.1) the affidavit may be sworn on information and belief` FALSE EQUALS NOTHING
#ASSERT `s 83.13(1.1) no adverse inference is to be drawn from the failure` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(1.1) no adverse inference is to be drawn from the failure` TRUE FALSE EQUALS NOTHING
#ASSERT `s 83.13(1.1) no adverse inference is to be drawn from the failure` FALSE TRUE EQUALS NOTHING
#ASSERT `s 83.13(2) the judge may appoint a person to manage the property and require possession to be given` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(2) the judge may appoint a person to manage the property and require possession to be given` TRUE TRUE FALSE EQUALS NOTHING   -- the judge is not of the opinion that the circumstances so require
#ASSERT `s 83.13(2) the judge may appoint a person to manage the property and require possession to be given` TRUE FALSE TRUE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `#ASSERT `s 83.13(2) the judge may appoint a person to manage the property and require possession to be given` TRUE FALSE TRUE EQUALS NOTHING`; "at the request of the Attorney General" is a group (i) gate of a "may" function, JUST FALSE as ruling (b) of 2026-11-05 says (fork F-ccc3-11)
#ASSERT `s 83.13(2) the judge may appoint a person to manage the property and require possession to be given` FALSE TRUE TRUE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `#ASSERT `s 83.13(2) the judge may appoint a person to manage the property and require possession to be given` FALSE TRUE TRUE EQUALS NOTHING`; "On an application under subsection (1)" is a group (i) gate of a "may" function, JUST FALSE as ruling (b) of 2026-11-05 says (fork F-ccc3-11)
#ASSERT `s 83.13(3) the judge must appoint the Minister of Public Works and Government Services` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(3) the judge must appoint the Minister of Public Works and Government Services` FALSE TRUE EQUALS JUST FALSE   -- no request of the Attorney General of Canada
#ASSERT `s 83.13(3) the judge must appoint the Minister of Public Works and Government Services` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 83.13(4) the power to manage includes the power` `s 83.13(4)(a) the power to make an interlocutory sale of perishable or rapidly depreciating property` FALSE EQUALS JUST TRUE
#ASSERT `s 83.13(4) the power to manage includes the power` `s 83.13(4)(b) the power to destroy, in accordance with subsections (5) to (8), property that has little or no value` FALSE EQUALS JUST TRUE
#ASSERT `s 83.13(4) the power to manage includes the power` `s 83.13(4)(c) the power to have property forfeited to Her Majesty in accordance with subsection (8.1)` FALSE EQUALS JUST TRUE
#ASSERT `s 83.13(4) the power to manage includes the power` `s 83.13(4)(c) the power to have property forfeited to Her Majesty in accordance with subsection (8.1)` TRUE EQUALS JUST FALSE   -- real property or a conveyance
#ASSERT `s 83.13(4) the power to manage includes the power` `s 83.13(4) another power` FALSE EQUALS NOTHING   -- "includes": the list is open
#ASSERT `s 83.13(5) the manager must apply for a destruction order before destroying the property` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(5) the manager must apply for a destruction order before destroying the property` TRUE FALSE TRUE EQUALS NOTHING   -- property of some value
#ASSERT `s 83.13(5) the manager must apply for a destruction order before destroying the property` FALSE TRUE TRUE EQUALS NOTHING   -- not the appointed manager
#ASSERT `s 83.13(5) the manager must apply for a destruction order before destroying the property` TRUE TRUE FALSE EQUALS NOTHING   -- not destroying it
#ASSERT `s 83.13(6) the judge must require notice to be given to, and may hear, the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(6) the judge must require notice to be given to, and may hear, the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 83.13(6) the judge must require notice to be given to, and may hear, the person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 83.13(7) the notice meets the requirements` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(7) the notice meets the requirements` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 83.13(7) the notice meets the requirements` TRUE FALSE EQUALS JUST FALSE   -- no effective period specified
#ASSERT `s 83.13(8) the judge must order that the property be destroyed` TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(8) the judge must order that the property be destroyed` FALSE EQUALS JUST FALSE

-- ---- 83.13(8.1). Arguments: application by the manager, real property or a conveyance, notice given, days of the period, first day, day an application asserting an interest was made (if any).
-- The period begins on 1 March 2026 and runs 60 days: its last day is 29 April 2026 (1 March + 59).
#ASSERT `s 83.13(8.1) the judge must order the property forfeited to Her Majesty` TRUE FALSE TRUE 60 (Date 1 3 2026) NOTHING EQUALS JUST TRUE
#ASSERT `s 83.13(8.1) the judge must order the property forfeited to Her Majesty` TRUE FALSE TRUE 60 (Date 1 3 2026) (JUST (Date 30 4 2026)) EQUALS JUST TRUE   -- an application made the day after the period ended (30 April): no one made one during it
#ASSERT `s 83.13(8.1) the judge must order the property forfeited to Her Majesty` TRUE FALSE TRUE 60 (Date 1 3 2026) (JUST (Date 29 4 2026)) EQUALS JUST FALSE   -- an application on the last day of the period
#ASSERT `s 83.13(8.1) the judge must order the property forfeited to Her Majesty` TRUE FALSE TRUE 60 (Date 1 3 2026) (JUST (Date 1 3 2026)) EQUALS JUST FALSE   -- on the first day
#ASSERT `s 83.13(8.1) the judge must order the property forfeited to Her Majesty` TRUE FALSE TRUE 59 (Date 1 3 2026) NOTHING EQUALS JUST FALSE   -- the notice specifies 59 days, not 60
#ASSERT `s 83.13(8.1) the judge must order the property forfeited to Her Majesty` TRUE FALSE TRUE 61 (Date 1 3 2026) NOTHING EQUALS JUST FALSE   -- 61 days (fork F-ccc3-12)
#ASSERT `s 83.13(8.1) the judge must order the property forfeited to Her Majesty` TRUE TRUE TRUE 60 (Date 1 3 2026) NOTHING EQUALS JUST FALSE   -- real property or a conveyance
#ASSERT `s 83.13(8.1) the judge must order the property forfeited to Her Majesty` TRUE FALSE FALSE 60 (Date 1 3 2026) NOTHING EQUALS JUST FALSE   -- no notice given or published
#ASSERT `s 83.13(8.1) the judge must order the property forfeited to Her Majesty` FALSE FALSE TRUE 60 (Date 1 3 2026) NOTHING EQUALS JUST FALSE   -- not on application by the manager
#ASSERT `s 83.13(9) the management order ceases to have effect` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 83.13(9) the management order ceases to have effect` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 83.13(9) the management order ceases to have effect` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(9) the management order ceases to have effect` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 83.13(9.1) the management order applies to the net proceeds of the sale` TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(9.1) the management order applies to the net proceeds of the sale` FALSE EQUALS NOTHING
#ASSERT `s 83.13(10) the Attorney General may apply to cancel or vary the order or warrant` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 83.13(10) the Attorney General may apply to cancel or vary the order or warrant` TRUE TRUE EQUALS JUST FALSE   -- an appointment made under subsection (3)
#ASSERT `s 83.13(10) the Attorney General may apply to cancel or vary the order or warrant` FALSE FALSE EQUALS NOTHING   -- not made under section 83.13
-- ---- 83.13(11), (12): the provisions applied. Sections are decimals: 462.34 to 462.35 takes in 462.341; 462.36 is outside.
#ASSERT `s 83.13(11) the provision applies to a warrant issued under paragraph (1)(a)` (`Provision of the Code` OF 462.32, "(4)") TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(11) the provision applies to a warrant issued under paragraph (1)(a)` (`Provision of the Code` OF 462.32, "(5)") TRUE EQUALS NOTHING   -- only subsection (4) of 462.32
#ASSERT `s 83.13(11) the provision applies to a warrant issued under paragraph (1)(a)` (`Provision of the Code` OF 462.34, "") TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(11) the provision applies to a warrant issued under paragraph (1)(a)` (`Provision of the Code` OF 462.341, "") TRUE EQUALS JUST TRUE   -- between 462.34 and 462.35
#ASSERT `s 83.13(11) the provision applies to a warrant issued under paragraph (1)(a)` (`Provision of the Code` OF 462.35, "") TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(11) the provision applies to a warrant issued under paragraph (1)(a)` (`Provision of the Code` OF 462.36, "") TRUE EQUALS NOTHING
#ASSERT `s 83.13(11) the provision applies to a warrant issued under paragraph (1)(a)` (`Provision of the Code` OF 462.4, "") TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(11) the provision applies to a warrant issued under paragraph (1)(a)` (`Provision of the Code` OF 487, "(3)") TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(11) the provision applies to a warrant issued under paragraph (1)(a)` (`Provision of the Code` OF 487, "(1)") TRUE EQUALS NOTHING
#ASSERT `s 83.13(11) the provision applies to a warrant issued under paragraph (1)(a)` (`Provision of the Code` OF 488, "") TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(11) the provision applies to a warrant issued under paragraph (1)(a)` (`Provision of the Code` OF 488, "") FALSE EQUALS NOTHING   -- not a warrant under (1)(a)
#ASSERT `s 83.13(11) the peace officer may execute the warrant` TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(11) the peace officer may execute the warrant` FALSE EQUALS JUST FALSE
#ASSERT `s 83.13(12) the provision applies to an order issued under paragraph (1)(b)` (`Provision of the Code` OF 462.33, "(4)") TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(12) the provision applies to an order issued under paragraph (1)(b)` (`Provision of the Code` OF 462.33, "(5)") TRUE EQUALS NOTHING   -- (5) is not in "(4) and (6) to (11)"
#ASSERT `s 83.13(12) the provision applies to an order issued under paragraph (1)(b)` (`Provision of the Code` OF 462.33, "(6)") TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(12) the provision applies to an order issued under paragraph (1)(b)` (`Provision of the Code` OF 462.33, "(11)") TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(12) the provision applies to an order issued under paragraph (1)(b)` (`Provision of the Code` OF 462.33, "(12)") TRUE EQUALS NOTHING
#ASSERT `s 83.13(12) the provision applies to an order issued under paragraph (1)(b)` (`Provision of the Code` OF 462.35, "") TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(12) the provision applies to an order issued under paragraph (1)(b)` (`Provision of the Code` OF 462.4, "") TRUE EQUALS JUST TRUE
#ASSERT `s 83.13(12) the provision applies to an order issued under paragraph (1)(b)` (`Provision of the Code` OF 462.4, "") FALSE EQUALS NOTHING

-- ---- 83.14. (1): arguments: owned or controlled by the group, group a terrorist group, used or to be used.
#ASSERT `s 83.14(1) the Attorney General may apply for an order of forfeiture` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 83.14(1) the Attorney General may apply for an order of forfeiture` FALSE (JUST TRUE) TRUE EQUALS JUST TRUE   -- (b)
#ASSERT `s 83.14(1) the Attorney General may apply for an order of forfeiture` TRUE (JUST FALSE) FALSE EQUALS NOTHING   -- the owner is not a terrorist group
#ASSERT `s 83.14(1) the Attorney General may apply for an order of forfeiture` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 83.14(1) the Attorney General may apply for an order of forfeiture` FALSE (JUST TRUE) FALSE EQUALS NOTHING   -- neither kind of property
#ASSERT `s 83.14(1) the Attorney General may apply for an order of forfeiture` TRUE (JUST FALSE) TRUE EQUALS JUST TRUE   -- (b) holds whoever owns it
#ASSERT `s 83.14(2) the affidavit may be sworn on information and belief` TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(2) the affidavit may be sworn on information and belief` FALSE EQUALS NOTHING
#ASSERT `s 83.14(2) no adverse inference is to be drawn from the failure` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(2) no adverse inference is to be drawn from the failure` TRUE FALSE EQUALS NOTHING
#ASSERT `s 83.14(3) the person is required to be named as a respondent` TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(3) the person is required to be named as a respondent` FALSE EQUALS JUST FALSE   -- "only those persons who are known"
#ASSERT `s 83.14(4) the notice meets the requirements` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(4) the notice meets the requirements` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 83.14(4) the notice meets the requirements` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 83.14(5) the judge must order that the property be forfeited to Her Majesty` TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(5) the judge must order that the property be forfeited to Her Majesty` FALSE EQUALS JUST FALSE
#ASSERT `s 83.14(5.1) the proceeds may be used for the purpose` `s 83.14(5.1) to compensate victims of terrorist activities` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(5.1) the proceeds may be used for the purpose` `s 83.14(5.1) to fund anti-terrorist initiatives` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(5.1) the proceeds may be used for the purpose` `s 83.14(5.1) another use` TRUE TRUE EQUALS NOTHING
#ASSERT `s 83.14(5.1) the proceeds may be used for the purpose` `s 83.14(5.1) to fund anti-terrorist initiatives` TRUE FALSE EQUALS NOTHING   -- not in accordance with the regulations (which are not in the sources)
#ASSERT `s 83.14(5.1) the proceeds may be used for the purpose` `s 83.14(5.1) to fund anti-terrorist initiatives` FALSE TRUE EQUALS NOTHING   -- not proceeds of a disposal under (5)
#ASSERT `s 83.14(6) the judge must make the order describing the property` TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(6) the judge must make the order describing the property` FALSE EQUALS JUST FALSE
#ASSERT `s 83.14(7) the judge may require notice to be given to the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(7) the judge may require notice to be given to the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 83.14(7) the judge may require notice to be given to the person` FALSE TRUE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `#ASSERT `s 83.14(7) the judge may require notice to be given to the person` FALSE TRUE EQUALS NOTHING`; "On an application under subsection (1)" is a group (i) gate of a "may" function, JUST FALSE as ruling (b) of 2026-11-05 says (fork F-ccc3-11)
#ASSERT `s 83.14(7) the judge may require notice to be given to the person` FALSE FALSE EQUALS JUST FALSE   -- not on an application under subsection (1), whatever else fails: the application gate comes first
#ASSERT `s 83.14(7) the person is entitled to be added as a respondent` TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(7) the person is entitled to be added as a respondent` FALSE EQUALS NOTHING
#ASSERT `s 83.14(8) the judge must order that the interest is not affected by the forfeiture` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 83.14(8) the judge must order that the interest is not affected by the forfeiture` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 83.14(8) the judge must order that the interest is not affected by the forfeiture` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 83.14(8) the judge must order that the interest is not affected by the forfeiture` TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- no reasonable care
#ASSERT `s 83.14(8) the judge must order that the interest is not affected by the forfeiture` TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- a member of a terrorist group
#ASSERT `s 83.14(8) the order must declare the nature and extent of the interest` TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(8) the order must declare the nature and extent of the interest` FALSE EQUALS NOTHING
#ASSERT `s 83.14(9) the judge must also consider the impact and the member's innocence` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(9) the judge must also consider the impact and the member's innocence` (JUST FALSE) TRUE TRUE TRUE EQUALS JUST FALSE   -- not a dwelling-house: "Where"
#ASSERT `s 83.14(9) the judge must also consider the impact and the member's innocence` NOTHING TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 83.14(9) the judge must also consider the impact and the member's innocence` (JUST TRUE) FALSE TRUE TRUE EQUALS JUST FALSE   -- not a member of the immediate family
#ASSERT `s 83.14(9) the judge must also consider the impact and the member's innocence` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE   -- not the principal residence at the time
#ASSERT `s 83.14(9) the judge must also consider the impact and the member's innocence` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE   -- no longer the principal residence
-- (10): the forfeiture order was made on 1 March 2026; the 60th day after is 30 April 2026.
#ASSERT `s 83.14(10) the person may bring a motion to vary or set aside the order` TRUE TRUE (Date 1 3 2026) (Date 30 4 2026) EQUALS JUST TRUE   -- the 60th day
#ASSERT `s 83.14(10) the person may bring a motion to vary or set aside the order` TRUE TRUE (Date 1 3 2026) (Date 1 5 2026) EQUALS JUST FALSE   -- the 61st day
#ASSERT `s 83.14(10) the person may bring a motion to vary or set aside the order` TRUE TRUE (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 83.14(10) the person may bring a motion to vary or set aside the order` FALSE TRUE (Date 1 3 2026) (Date 2 3 2026) EQUALS NOTHING   -- claims no interest
#ASSERT `s 83.14(10) the person may bring a motion to vary or set aside the order` TRUE FALSE (Date 1 3 2026) (Date 2 3 2026) EQUALS NOTHING   -- did receive notice
#ASSERT `s 83.14(11) the Court is barred from extending the period` TRUE EQUALS JUST TRUE
#ASSERT `s 83.14(11) the Court is barred from extending the period` FALSE EQUALS NOTHING

-- ---- 83.15 to 83.17.
#ASSERT `s 83.15 the provision applies to the property` (`Provision of the Code` OF 462.42, "(6)") TRUE EQUALS JUST TRUE
#ASSERT `s 83.15 the provision applies to the property` (`Provision of the Code` OF 462.42, "(5)") TRUE EQUALS NOTHING
#ASSERT `s 83.15 the provision applies to the property` (`Provision of the Code` OF 462.43, "") TRUE EQUALS JUST TRUE
#ASSERT `s 83.15 the provision applies to the property` (`Provision of the Code` OF 462.46, "") TRUE EQUALS JUST TRUE
#ASSERT `s 83.15 the provision applies to the property` (`Provision of the Code` OF 462.44, "") TRUE EQUALS NOTHING
#ASSERT `s 83.15 the provision applies to the property` (`Provision of the Code` OF 462.43, "") FALSE EQUALS NOTHING
#ASSERT `s 83.16(1) the restraint, detention or appointment continues` TRUE EQUALS JUST TRUE
#ASSERT `s 83.16(1) the restraint, detention or appointment continues` FALSE EQUALS JUST FALSE
#ASSERT `s 83.16(2) section 462.34 applies to the appeal` TRUE EQUALS JUST TRUE
#ASSERT `s 83.16(2) section 462.34 applies to the appeal` FALSE EQUALS NOTHING
#ASSERT `s 83.17(1) this Part does not affect the operation of the other provision` TRUE EQUALS JUST TRUE
#ASSERT `s 83.17(1) this Part does not affect the operation of the other provision` FALSE EQUALS NOTHING
#ASSERT `s 83.17(2) the property is subject to forfeiture under subsection 83.14(5)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 83.17(2) the property is subject to forfeiture under subsection 83.14(5)` TRUE TRUE EQUALS JUST FALSE   -- required to satisfy restitution or compensation
#ASSERT `s 83.17(2) the property is subject to forfeiture under subsection 83.14(5)` FALSE FALSE EQUALS NOTHING
#ASSERT `s 83.17(2) the property is subject to forfeiture under subsection 83.14(5)` FALSE TRUE EQUALS JUST FALSE
