IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc10-conversion`

-- ccc10-tests-conversion.l4 -- tests for ccc10-conversion.l4 (ss 320.101 to 320.104). Expected values are written by hand from the text, beside each assertion.
-- (The assertion lines were laid out by a script from a table of hand-written rows, each carrying its expected value and its basis in the text; the script reads no encoding output.)

`s 320.101 fixture: the general summary conviction penalty` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
GIVEN maximum IS A `Length of time`
GIVETH A Punishment
`s 320.101 fixture: on indictment at most` MEANS Punishment OF `by indictment`, (`imprisonment for a term of` maximum), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `s 320.101 -- Definition of conversion therapy`

#ASSERT `s 320.101 the practice, treatment or service is conversion therapy` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- designed to (a) change a person’s sexual orientation to heterosexual
#ASSERT `s 320.101 the practice, treatment or service is conversion therapy` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- designed to (b) change a person’s gender identity to cisgender
#ASSERT `s 320.101 the practice, treatment or service is conversion therapy` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- designed to (c) change a person’s gender expression so that it conforms to the sex assigned at birth
#ASSERT `s 320.101 the practice, treatment or service is conversion therapy` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- designed to (d) repress or reduce non-heterosexual attraction or sexual behaviour
#ASSERT `s 320.101 the practice, treatment or service is conversion therapy` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- designed to (e) repress a person’s non-cisgender gender identity
#ASSERT `s 320.101 the practice, treatment or service is conversion therapy` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- designed to (f) repress or reduce a person’s gender expression that does not conform to the sex assigned at birth
#ASSERT `s 320.101 the practice, treatment or service is conversion therapy` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- "means": designed for none of (a) to (f)
#ASSERT `s 320.101 the practice, treatment or service is conversion therapy` TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE   -- designed to change orientation, but the exclusion applies: relates to exploration of an integrated personal identity and not based on an assumption that one is to be preferred: "does not include"
#ASSERT `s 320.101 the practice, treatment or service is conversion therapy` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE   -- relates to exploration, but is based on an assumption that one is to be preferred: the exclusion does not apply
#ASSERT `s 320.101 the practice, treatment or service is conversion therapy` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- not related to exploration of an integrated personal identity: the exclusion does not apply
#ASSERT `s 320.101 the practice, treatment or service is conversion therapy` FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE   -- gender transition care: designed for none of (a) to (f), and excluded
#ASSERT `s 320.102 the person is guilty of the offence of causing another person to undergo conversion therapy` (JUST TRUE) TRUE EQUALS JUST TRUE   -- knowingly causes another person to undergo conversion therapy
#ASSERT `s 320.102 the person is guilty of the offence of causing another person to undergo conversion therapy` (JUST TRUE) FALSE EQUALS NOTHING   -- not knowingly
#ASSERT `s 320.102 the person is guilty of the offence of causing another person to undergo conversion therapy` (JUST FALSE) TRUE EQUALS NOTHING   -- not conversion therapy as s 320.101 has it
#ASSERT `s 320.102 the person is guilty of the offence of causing another person to undergo conversion therapy` NOTHING TRUE EQUALS NOTHING   -- s 320.101 not determined
#ASSERT `s 320.102 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 320.102 the punishment` `by indictment` `s 320.101 fixture: the general summary conviction penalty` EQUALS `s 320.101 fixture: on indictment at most` `five years`   -- (a): "not more than five years"
#ASSERT `s 320.102 the punishment` `on summary conviction` `s 320.101 fixture: the general summary conviction penalty` EQUALS `s 320.101 fixture: the general summary conviction penalty`   -- (b): s 787(1)

§ `s 320.103 -- Promoting or advertising`

#ASSERT `s 320.103 the person is guilty of the offence of promoting or advertising conversion therapy` (JUST TRUE) TRUE EQUALS JUST TRUE   -- knowingly promotes or advertises conversion therapy
#ASSERT `s 320.103 the person is guilty of the offence of promoting or advertising conversion therapy` (JUST TRUE) FALSE EQUALS NOTHING   -- not knowingly
#ASSERT `s 320.103 the person is guilty of the offence of promoting or advertising conversion therapy` (JUST FALSE) TRUE EQUALS NOTHING   -- not conversion therapy
#ASSERT `s 320.103 the person is guilty of the offence of promoting or advertising conversion therapy` NOTHING TRUE EQUALS NOTHING   -- s 320.101 not determined
#ASSERT `s 320.103 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 320.103 the punishment` `by indictment` `s 320.101 fixture: the general summary conviction penalty` EQUALS `s 320.101 fixture: on indictment at most` `two years`   -- (a): "not more than two years"
#ASSERT `s 320.103 the punishment` `on summary conviction` `s 320.101 fixture: the general summary conviction penalty` EQUALS `s 320.101 fixture: the general summary conviction penalty`   -- (b)

§ `s 320.104 -- Material benefit`

#ASSERT `s 320.104 the person is guilty of the offence of receiving a material benefit from conversion therapy` TRUE TRUE EQUALS JUST TRUE   -- receives a benefit, knowing it derives from conversion therapy
#ASSERT `s 320.104 the person is guilty of the offence of receiving a material benefit from conversion therapy` TRUE FALSE EQUALS NOTHING   -- no knowledge
#ASSERT `s 320.104 the person is guilty of the offence of receiving a material benefit from conversion therapy` FALSE TRUE EQUALS NOTHING   -- no benefit
#ASSERT `s 320.104 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 320.104 the punishment` `by indictment` `s 320.101 fixture: the general summary conviction penalty` EQUALS `s 320.101 fixture: on indictment at most` `two years`   -- (a): "not more than two years"
#ASSERT `s 320.104 the punishment` `on summary conviction` `s 320.101 fixture: the general summary conviction penalty` EQUALS `s 320.101 fixture: the general summary conviction penalty`   -- (b)
