IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc23-disposition-information`

-- ccc23-tests-disposition-information.l4 -- tests for sections 672.51 to 672.53. Expected values are written from the text, never copied from the code.

§ `s 672.51`
-- (1) args: all or part of an assessment report submitted; other written information about the accused; relevant to making or reviewing a disposition
#ASSERT `s 672.51(1) disposition information` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.51(1) disposition information` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.51(1) disposition information` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.51(1) disposition information` FALSE FALSE TRUE EQUALS JUST FALSE
-- (3) args: danger to another person; seriously impair treatment or recovery
#ASSERT `s 672.51(3) the court or Review Board must withhold disposition information from the accused` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.51(3) the court or Review Board must withhold disposition information from the accused` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.51(3) the court or Review Board must withhold disposition information from the accused` FALSE FALSE EQUALS JUST FALSE
-- (4)
#ASSERT `s 672.51(4) the court or Review Board may release disposition information to the accused` TRUE EQUALS JUST TRUE
#ASSERT `s 672.51(4) the court or Review Board may release disposition information to the accused` FALSE EQUALS JUST FALSE
-- (5) args: a party other than the accused or an Attorney General; not necessary; may be prejudicial
#ASSERT `s 672.51(5) the court or Review Board must withhold disposition information from the party` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.51(5) the court or Review Board must withhold disposition information from the party` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.51(5) the court or Review Board must withhold disposition information from the party` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.51(5) the court or Review Board must withhold disposition information from the party` TRUE TRUE FALSE EQUALS JUST FALSE
-- (2) args: disposition information (by (1)); the person is a party or counsel for the accused; withheld from the person by (3) or (5)
#ASSERT `s 672.51(2) disposition information must be made available for inspection by, and a copy provided to, the person` (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 672.51(2) disposition information must be made available for inspection by, and a copy provided to, the person` (JUST TRUE) TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 672.51(2) disposition information must be made available for inspection by, and a copy provided to, the person` (JUST TRUE) TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 672.51(2) disposition information must be made available for inspection by, and a copy provided to, the person` (JUST TRUE) FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 672.51(2) disposition information must be made available for inspection by, and a copy provided to, the person` (JUST FALSE) TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 672.51(2) disposition information must be made available for inspection by, and a copy provided to, the person` NOTHING TRUE (JUST FALSE) EQUALS NOTHING
-- (6) args: withheld from the person under (3) or (5); (a) oral presentation; (b) questioning or cross-examination
#ASSERT `s 672.51(6) the court or Review Board must exclude the person from the hearing` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.51(6) the court or Review Board must exclude the person from the hearing` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.51(6) the court or Review Board must exclude the person from the hearing` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.51(6) the court or Review Board must exclude the person from the hearing` FALSE TRUE FALSE EQUALS JUST FALSE
-- (7) args: not a party; (a) withheld under (3) or (5); (b) seriously prejudicial opinion
#ASSERT `s 672.51(7) the section bars disposition information from being made available to or disclosed to the person` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.51(7) the section bars disposition information from being made available to or disclosed to the person` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.51(7) the section bars disposition information from being made available to or disclosed to the person` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.51(7) the section bars disposition information from being made available to or disclosed to the person` FALSE TRUE TRUE EQUALS NOTHING
-- (8) args: a part of the record where the accused was excluded under 672.5(10)(b)(ii) or (iii); the person is the accused or not a party
#ASSERT `s 672.51(8) the section bars that part of the record from being made available for inspection to the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.51(8) the section bars that part of the record from being made available for inspection to the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.51(8) the section bars that part of the record from being made available for inspection to the person` FALSE TRUE EQUALS NOTHING
-- (9) args: on request; (a) valid interest for research; satisfied of public interest; (b) valid interest for administration of justice; (c) the accused requests or authorizes; satisfied about non-disclosure
#ASSERT `s 672.51(9) the court or Review Board may make disposition information available to the person on request` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.51(9) the court or Review Board may make disposition information available to the person on request` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.51(9) the court or Review Board may make disposition information available to the person on request` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.51(9) the court or Review Board may make disposition information available to the person on request` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.51(9) the court or Review Board may make disposition information available to the person on request` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.51(9) the court or Review Board may make disposition information available to the person on request` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- (10) args: made available under (9)(a); for research or statistical purposes; in a form that could reasonably be expected to identify a person
#ASSERT `s 672.51(10) the person may disclose the information for research or statistical purposes` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.51(10) the person may disclose the information for research or statistical purposes` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.51(10) the person may disclose the information for research or statistical purposes` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.51(10) the person may disclose the information for research or statistical purposes` TRUE FALSE FALSE EQUALS NOTHING
-- (11), (12)
#ASSERT `s 672.51(11) the section bars the person from publishing, broadcasting or transmitting it` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.51(11) the section bars the person from publishing, broadcasting or transmitting it` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.51(11) the section bars the person from publishing, broadcasting or transmitting it` FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.51(12) section 672.51 limits a power that a court may exercise apart from this section` FALSE EQUALS JUST FALSE
#ASSERT `s 672.51(12) section 672.51 limits a power that a court may exercise apart from this section` TRUE EQUALS NOTHING

§ `ss 672.52 and 672.53`
#ASSERT `s 672.52(1) the court or Review Board must cause a record of the proceedings to be kept` TRUE EQUALS JUST TRUE
#ASSERT `s 672.52(1) the court or Review Board must cause a record of the proceedings to be kept` FALSE EQUALS JUST FALSE
#ASSERT `s 672.52(2) the court must send the transcript, documents and exhibits to the Review Board without delay` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.52(2) the court must send the transcript, documents and exhibits to the Review Board without delay` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.52(2) the court must send the transcript, documents and exhibits to the Review Board without delay` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.52(3) the court or Review Board must state its reasons and provide every party with a copy of the disposition and the reasons` TRUE EQUALS JUST TRUE
#ASSERT `s 672.52(3) the court or Review Board must state its reasons and provide every party with a copy of the disposition and the reasons` FALSE EQUALS JUST FALSE
-- 672.53 args: an irregularity; it causes the accused substantial prejudice
#ASSERT `s 672.53 the procedural irregularity affects the validity of the hearing` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.53 the procedural irregularity affects the validity of the hearing` TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.53 the procedural irregularity affects the validity of the hearing` FALSE FALSE EQUALS NOTHING
