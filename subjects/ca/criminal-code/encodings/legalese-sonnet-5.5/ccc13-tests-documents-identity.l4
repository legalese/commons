IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc-definitions`
IMPORT `ccc13-documents-identity`
IMPORT `ccc13-tests-support`

-- ccc13-tests-documents-identity.l4 -- tests of ccc13-documents-identity.l4 (ss 397 to 405). Expected values are decided from the text.

`ccc13 test the hybrid class` MEANS `an offence that the section makes both indictable and punishable on summary conviction`
GIVETH A `s 2 valuable security kind`
`ccc13 test a security` MEANS `a debenture, deed, bond, bill, note, warrant, order or other security for money or for payment of money`
GIVETH A `s 2 valuable security kind`
`ccc13 test not a security` MEANS `an instrument that is none of those`

§ `s 397 falsification of books and documents`
-- inputs of (1): intent to defraud; a book, paper, writing or document; the thing as a valuable security (s 2); (a) destroys, alters, falsifies, false entry; (b) omits or alters a material particular
#ASSERT `s 397(1) the conduct is the offence of falsifying a book or document` TRUE TRUE `ccc13 test not a security` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 397(1) the conduct is the offence of falsifying a book or document` TRUE FALSE `ccc13 test a security` TRUE FALSE EQUALS JUST TRUE       -- a valuable security
#ASSERT `s 397(1) the conduct is the offence of falsifying a book or document` TRUE TRUE `ccc13 test not a security` FALSE TRUE EQUALS JUST TRUE      -- (b)
#ASSERT `s 397(1) the conduct is the offence of falsifying a book or document` FALSE TRUE `ccc13 test not a security` TRUE FALSE EQUALS JUST FALSE     -- no intent to defraud
#ASSERT `s 397(1) the conduct is the offence of falsifying a book or document` TRUE TRUE `ccc13 test not a security` FALSE FALSE EQUALS JUST FALSE     -- neither (a) nor (b)
#ASSERT `s 397(1) the conduct is the offence of falsifying a book or document` TRUE FALSE `ccc13 test not a security` TRUE FALSE EQUALS NOTHING        -- the thing is not named and s 2 valuable security is an open list
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 397(1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 397(1) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 397(2) the conduct is the offence of being privy to the falsifying of a book or document` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 397(2) the conduct is the offence of being privy to the falsifying of a book or document` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 397(2) the conduct is the offence of being privy to the falsifying of a book or document` TRUE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 397(2) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 397(2) the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 398 falsifying employment record`
#ASSERT `s 398 the conduct is the offence of falsifying an employment record` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 398 the conduct is the offence of falsifying an employment record` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 398 the conduct is the offence of falsifying an employment record` TRUE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the number of limbs` (`s 398 the punishments` `ccc13 test p787`) EQUALS 1
#ASSERT `ccc13 test the summary limb is the s 787(1) stand-in` (`s 398 the punishments` `ccc13 test p787`) EQUALS TRUE
#ASSERT `s 398 the class of the offence` EQUALS `an offence punishable on summary conviction`

§ `s 399 false return by public officer`
-- inputs: entrusted with public revenues; (a) false statement of a sum collected; (b) false statement of a balance
#ASSERT `s 399 the conduct is the offence of a false return by a public officer` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 399 the conduct is the offence of a false return by a public officer` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 399 the conduct is the offence of a false return by a public officer` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 399 the conduct is the offence of a false return by a public officer` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 399 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 399 the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 400 false prospectus`
#ASSERT `s 400(2) the body is a company` TRUE EQUALS JUST TRUE
#ASSERT `s 400(2) the body is a company` FALSE EQUALS JUST FALSE
-- inputs of (1): makes, circulates or publishes; knows it is false; the body is a company (s 400(2)); intents (a), (b), (c)(i), (c)(ii)
#ASSERT `s 400(1) the conduct is the offence of making a false prospectus` TRUE TRUE (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 400(1) the conduct is the offence of making a false prospectus` TRUE TRUE (JUST TRUE) FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 400(1) the conduct is the offence of making a false prospectus` TRUE TRUE (JUST TRUE) FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 400(1) the conduct is the offence of making a false prospectus` TRUE TRUE (JUST TRUE) FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 400(1) the conduct is the offence of making a false prospectus` FALSE TRUE (JUST TRUE) TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 400(1) the conduct is the offence of making a false prospectus` TRUE FALSE (JUST TRUE) TRUE TRUE TRUE TRUE EQUALS JUST FALSE      -- not known to be false
#ASSERT `s 400(1) the conduct is the offence of making a false prospectus` TRUE TRUE (JUST TRUE) FALSE FALSE FALSE FALSE EQUALS JUST FALSE    -- none of the four intents
#ASSERT `s 400(1) the conduct is the offence of making a false prospectus` TRUE TRUE (JUST FALSE) TRUE FALSE FALSE FALSE EQUALS JUST FALSE     -- not a company
#ASSERT `s 400(1) the conduct is the offence of making a false prospectus` TRUE TRUE NOTHING TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 400(1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `ten years`
#ASSERT `s 400(1) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 400(1)(d) as the text shows it` EQUALS "(d) [Repealed, 1994, c. 44, s. 26]"

§ `s 401 obtaining carriage by false billing`
#ASSERT `s 401(1) the conduct is the offence of obtaining carriage by false billing` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 401(1) the conduct is the offence of obtaining carriage by false billing` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 401(1) the conduct is the offence of obtaining carriage by false billing` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 401(1) the conduct is the offence of obtaining carriage by false billing` TRUE TRUE FALSE EQUALS JUST FALSE      -- the importation is not unlawful there
#ASSERT `ccc13 test the number of limbs` (`s 401(1) the punishments` `ccc13 test p787`) EQUALS 1
#ASSERT `s 401(1) the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 401(2) the thing is forfeited to Her Majesty` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 401(2) the thing is forfeited to Her Majesty` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 401(2) the thing is forfeited to Her Majesty` TRUE FALSE EQUALS JUST FALSE
#TRACE `s 401(2) the power of the court to direct the disposal` (JUST TRUE) AT 0 WITH
    PARTY `the court` DOES `s 401(2) direct how the forfeited thing is disposed of` AT 1
#TRACE `s 401(2) the power of the court to direct the disposal` (JUST FALSE) AT 0 WITH
#ASSERT `s 402 as the text shows it` EQUALS "402 [Repealed, 2018, c. 29, s. 44]"

§ `s 402.1 identity information`
-- inputs: the section for whose purposes the question is asked; the kind of information; of a type commonly used to identify an individual
#ASSERT `s 402.1 the information is identity information` 402.2 `s 402.1 a fingerprint` FALSE EQUALS JUST TRUE         -- a kind the text names
#ASSERT `s 402.1 the information is identity information` 403 `s 402.1 a password` FALSE EQUALS JUST TRUE
#ASSERT `s 402.1 the information is identity information` 402.2 `s 402.1 a driver’s licence number` FALSE EQUALS JUST TRUE
#ASSERT `s 402.1 the information is identity information` 402.2 `s 402.1 information of a kind not named in section 402.1` TRUE EQUALS JUST TRUE
#ASSERT `s 402.1 the information is identity information` 403 `s 402.1 information of a kind not named in section 402.1` FALSE EQUALS JUST FALSE     -- "means": not of such a type
#ASSERT `s 402.1 the information is identity information` 380 `s 402.1 a fingerprint` TRUE EQUALS NOTHING        -- "For the purposes of sections 402.2 and 403" only
#ASSERT `s 402.1 the information is identity information` 402.21 `s 402.1 a fingerprint` TRUE EQUALS NOTHING     -- 402.21 is not 402.2

§ `s 402.2 identity theft`
`ccc13 test the provision for s 402.2(3)` MEANS `ccc13 test the provision` 380 "(1)"
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 57 "") EQUALS JUST TRUE
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 58 "") EQUALS JUST TRUE
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 130 "") EQUALS JUST TRUE
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 131 "") EQUALS JUST TRUE
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 342 "") EQUALS JUST TRUE
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 362 "") EQUALS JUST TRUE
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 366 "") EQUALS JUST TRUE
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 368 "") EQUALS JUST TRUE
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 380 "(1)") EQUALS JUST TRUE
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 403 "(1)") EQUALS JUST TRUE
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 381 "") EQUALS NOTHING         -- not listed: "includes", the list is not closed
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 342.1 "") EQUALS NOTHING     -- 342.1 is not 342
#ASSERT `s 402.2(3) the offence is one the subsection includes` (`ccc13 test the provision` 56 "") EQUALS NOTHING
-- inputs of (1): obtains or possesses; identity information (s 402.1); intent to use it to commit an indictable offence; the offence includes fraud, deceit or falsehood; the offence is one of (3)
#ASSERT `s 402.2(1) the conduct is the offence of identity theft` TRUE (JUST TRUE) TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 402.2(1) the conduct is the offence of identity theft` TRUE (JUST TRUE) TRUE FALSE (JUST TRUE) EQUALS JUST TRUE         -- an offence listed in (3)
#ASSERT `s 402.2(1) the conduct is the offence of identity theft` TRUE (JUST TRUE) TRUE FALSE NOTHING EQUALS NOTHING             -- not shown to include fraud or to be listed
#ASSERT `s 402.2(1) the conduct is the offence of identity theft` FALSE (JUST TRUE) TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 402.2(1) the conduct is the offence of identity theft` TRUE (JUST TRUE) FALSE TRUE (JUST TRUE) EQUALS JUST FALSE      -- no intent
#ASSERT `s 402.2(1) the conduct is the offence of identity theft` TRUE (JUST FALSE) TRUE TRUE (JUST TRUE) EQUALS JUST FALSE     -- not identity information
#ASSERT `s 402.2(1) the conduct is the offence of identity theft` TRUE NOTHING TRUE TRUE (JUST TRUE) EQUALS NOTHING
-- inputs of (2): transmits, sells, or possesses for those purposes; identity information; knows or is reckless; includes fraud; listed in (3)
#ASSERT `s 402.2(2) the conduct is the offence of trafficking in identity information` TRUE (JUST TRUE) TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 402.2(2) the conduct is the offence of trafficking in identity information` FALSE (JUST TRUE) TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 402.2(2) the conduct is the offence of trafficking in identity information` TRUE (JUST TRUE) FALSE TRUE (JUST FALSE) EQUALS JUST FALSE   -- neither knowing nor reckless
#ASSERT `s 402.2(2) the conduct is the offence of trafficking in identity information` TRUE (JUST FALSE) TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 402.2(4) the accused may be tried and punished by the court` TRUE `s 402.2(4) the place where the offence is alleged to have been committed` EQUALS JUST TRUE
#ASSERT `s 402.2(4) the accused may be tried and punished by the court` TRUE `s 402.2(4) the place where the accused is found` EQUALS JUST TRUE
#ASSERT `s 402.2(4) the accused may be tried and punished by the court` TRUE `s 402.2(4) the place where the accused is arrested` EQUALS JUST TRUE
#ASSERT `s 402.2(4) the accused may be tried and punished by the court` TRUE `s 402.2(4) the place where the accused is in custody` EQUALS JUST TRUE
#ASSERT `s 402.2(4) the accused may be tried and punished by the court` TRUE `s 402.2(4) a place that is none of those` EQUALS NOTHING
#ASSERT `s 402.2(4) the accused may be tried and punished by the court` FALSE `s 402.2(4) the place where the accused is found` EQUALS NOTHING
#ASSERT `s 402.2(4) the subsection bars the proceeding for want of the consent of the Attorney General of the province` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 402.2(4) the subsection bars the proceeding for want of the consent of the Attorney General of the province` TRUE TRUE EQUALS NOTHING
#ASSERT `s 402.2(4) the subsection bars the proceeding for want of the consent of the Attorney General of the province` FALSE FALSE EQUALS JUST FALSE     -- committed in the province: "if the offence is alleged to have been committed outside that province"
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 402.2(5) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 402.2(5) the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 403 identity fraud`
#ASSERT `s 403(2) the conduct is personating a person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 403(2) the conduct is personating a person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 403(2) the conduct is personating a person` FALSE FALSE EQUALS NOTHING      -- "includes": other ways of personating are not excluded
-- inputs of (1): personates (s 403(2)); fraudulent; intent (a) advantage; (b) property; (c) disadvantage; (d) avoid arrest or prosecution
#ASSERT `s 403(1) the conduct is the offence of identity fraud` (JUST TRUE) TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 403(1) the conduct is the offence of identity fraud` (JUST TRUE) TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 403(1) the conduct is the offence of identity fraud` (JUST TRUE) TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 403(1) the conduct is the offence of identity fraud` (JUST TRUE) TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 403(1) the conduct is the offence of identity fraud` (JUST TRUE) FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE      -- not fraudulent
#ASSERT `s 403(1) the conduct is the offence of identity fraud` (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE    -- none of the four intents
#ASSERT `s 403(1) the conduct is the offence of identity fraud` NOTHING TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 403(3) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `ten years`
#ASSERT `s 403(3) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 404 as the text shows it` EQUALS "404 [Repealed, 2018, c. 29, s. 46]"

§ `s 405 acknowledging instrument in false name`
#ASSERT `s 405 the conduct is the offence of acknowledging an instrument in a false name` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 405 the conduct is the offence of acknowledging an instrument in a false name` FALSE TRUE EQUALS JUST FALSE      -- with lawful authority or excuse
#ASSERT `s 405 the conduct is the offence of acknowledging an instrument in a false name` TRUE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 405 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 405 the class of the offence` EQUALS `ccc13 test the hybrid class`
