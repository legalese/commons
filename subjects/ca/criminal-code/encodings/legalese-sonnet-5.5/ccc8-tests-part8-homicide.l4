IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc8-part8-homicide`

-- ccc8-tests-part8-homicide.l4 -- tests for ccc8-part8-homicide.l4 (sections 219 to 228). Expected values are written by hand from the text.
-- The stand-in below is NOT the penalty of section 787(1) (outside this part): it states nothing, so only the limb of this part is tested.
`s 221 test fixture: a stand-in for the section 787(1) penalty` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `Sections 219 to 221 -- criminal negligence`

-- 219(2) "duty means a duty imposed by law"
#ASSERT `s 219(2) duty` TRUE EQUALS JUST TRUE
#ASSERT `s 219(2) duty` FALSE EQUALS JUST FALSE
-- 219(1) "Every one is criminally negligent who (a) in doing anything, or (b) in omitting to do anything that it is his duty to do, shows wanton or reckless disregard for the lives or safety of other persons"
--                                              doing  omitting (b)  shows
#ASSERT `s 219(1) the person is criminally negligent` TRUE  NOTHING      TRUE  EQUALS JUST TRUE
#ASSERT `s 219(1) the person is criminally negligent` FALSE (JUST TRUE)  TRUE  EQUALS JUST TRUE
#ASSERT `s 219(1) the person is criminally negligent` FALSE (JUST FALSE) TRUE  EQUALS NOTHING
#ASSERT `s 219(1) the person is criminally negligent` FALSE NOTHING      TRUE  EQUALS NOTHING
#ASSERT `s 219(1) the person is criminally negligent` TRUE  NOTHING      FALSE EQUALS NOTHING
-- 220 "Every person who by criminal negligence causes death to another person is guilty of an indictable offence and liable (a) where a firearm is used ..., to imprisonment for life and to a minimum punishment of imprisonment for a term of four years; and (b) in any other case, to imprisonment for life"
#ASSERT `s 220 the person commits the offence of causing death by criminal negligence` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 220 the person commits the offence of causing death by criminal negligence` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 220 the person commits the offence of causing death by criminal negligence` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 220 the person commits the offence of causing death by criminal negligence` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 220 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 220 the punishment` TRUE EQUALS LIST (Punishment OF `by indictment`, `imprisonment for life`, `imprisonment for a term of` (`Length of time` OF 4, 0, 0, FALSE), `no fine is stated`, `no fine is stated`)
#ASSERT `s 220 the punishment` FALSE EQUALS LIST (Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
-- 221 "Every person who by criminal negligence causes bodily harm to another person is guilty of (a) an indictable offence ... not more than 10 years; or (b) an offence punishable on summary conviction"
#ASSERT `s 221 the person commits the offence of causing bodily harm by criminal negligence` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 221 the person commits the offence of causing bodily harm by criminal negligence` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 221 the person commits the offence of causing bodily harm by criminal negligence` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 221 the person commits the offence of causing bodily harm by criminal negligence` (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 221 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 221 the punishment` `s 221 test fixture: a stand-in for the section 787(1) penalty` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 10, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), `s 221 test fixture: a stand-in for the section 787(1) penalty`

§ `Section 222 -- homicide`

-- (1) "A person commits homicide when, directly or indirectly, by any means, he causes the death of a human being"
#ASSERT `s 222(1) the person commits homicide` TRUE EQUALS JUST TRUE
#ASSERT `s 222(1) the person commits homicide` FALSE EQUALS JUST FALSE
-- (5) "A person commits culpable homicide when he causes the death of a human being, (a) by means of an unlawful act; (b) by criminal negligence; (c) by causing that human being, by threats or fear of violence or by deception, to do anything that causes his death; or (d) by wilfully frightening that human being, in the case of a child or sick person"
--                                                   death (a)   (b)           (c)   (d)
#ASSERT `s 222(5) the person commits culpable homicide` TRUE TRUE  NOTHING      FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 222(5) the person commits culpable homicide` TRUE FALSE (JUST TRUE)  FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 222(5) the person commits culpable homicide` TRUE FALSE NOTHING      TRUE  FALSE EQUALS JUST TRUE
#ASSERT `s 222(5) the person commits culpable homicide` TRUE FALSE NOTHING      FALSE TRUE  EQUALS JUST TRUE
#ASSERT `s 222(5) the person commits culpable homicide` TRUE FALSE NOTHING      FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 222(5) the person commits culpable homicide` TRUE FALSE (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 222(5) the person commits culpable homicide` FALSE TRUE (JUST TRUE)  TRUE  TRUE  EQUALS JUST FALSE
-- (2) "Homicide is culpable or not culpable"
#ASSERT `s 222(2) the kind of homicide` (JUST TRUE) EQUALS JUST `s 222(2) culpable homicide`
#ASSERT `s 222(2) the kind of homicide` (JUST FALSE) EQUALS JUST `s 222(2) homicide that is not culpable`
#ASSERT `s 222(2) the kind of homicide` NOTHING EQUALS NOTHING
-- (3) "Homicide that is not culpable is not an offence"
#ASSERT `s 222(3) the homicide is an offence` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 222(3) the homicide is an offence` (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 222(3) the homicide is an offence` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 222(3) the homicide is an offence` (JUST TRUE) NOTHING EQUALS NOTHING
-- (4) "Culpable homicide is murder or manslaughter or infanticide"
#ASSERT `s 222(4) culpable homicide is murder or manslaughter or infanticide` (JUST TRUE) (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 222(4) culpable homicide is murder or manslaughter or infanticide` (JUST TRUE) NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 222(4) culpable homicide is murder or manslaughter or infanticide` (JUST TRUE) NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 222(4) culpable homicide is murder or manslaughter or infanticide` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 222(4) culpable homicide is murder or manslaughter or infanticide` (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
-- (6) "a person does not commit homicide within the meaning of this Act by reason only that he causes the death of a human being by procuring, by false evidence, the conviction and death of that human being by sentence of the law"
#ASSERT `s 222(6) the person commits homicide within the meaning of this Act` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 222(6) the person commits homicide within the meaning of this Act` TRUE FALSE EQUALS NOTHING
#ASSERT `s 222(6) the person commits homicide within the meaning of this Act` FALSE TRUE EQUALS NOTHING

§ `Sections 223 to 226 -- human being; causing death`

-- 223(1) "A child becomes a human being ... when it has completely proceeded, in a living state, from the body of its mother, whether or not (a) it has breathed; (b) ...; (c) ..."
#ASSERT `s 223(1) the child has become a human being` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 223(1) the child has become a human being` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 223(1) the child has become a human being` FALSE TRUE EQUALS JUST FALSE
-- 223(2) "A person commits homicide when he causes injury to a child before or during its birth as a result of which the child dies after becoming a human being"
#ASSERT `s 223(2) the person commits homicide by injuring a child before or during its birth` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 223(2) the person commits homicide by injuring a child before or during its birth` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 223(2) the person commits homicide by injuring a child before or during its birth` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 223(2) the person commits homicide by injuring a child before or during its birth` TRUE NOTHING EQUALS NOTHING
-- 224, 225, 226 (causing death)
#ASSERT `s 224 the person causes the death of the human being by virtue of this section` TRUE EQUALS JUST TRUE
#ASSERT `s 224 the person causes the death of the human being by virtue of this section` FALSE EQUALS JUST FALSE
#ASSERT `s 225 the person causes the death of the human being by virtue of this section` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 225 the person causes the death of the human being by virtue of this section` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 225 the person causes the death of the human being by virtue of this section` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 226 the person causes the death of the human being by virtue of this section` TRUE EQUALS JUST TRUE
#ASSERT `s 226 the person causes the death of the human being by virtue of this section` FALSE EQUALS JUST FALSE

§ `Sections 227 and 228`

-- 227(5) "medical assistance in dying, medical practitioner and nurse practitioner have the same meanings as in section 241.1"
#ASSERT `s 227(5) the term has the meaning it has in section 241.1` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 227(5) the term has the meaning it has in section 241.1` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 227(5) the term has the meaning it has in section 241.1` NOTHING EQUALS NOTHING
-- 227(3) "the exemption set out in subsection (1) or (2) applies even if the person invoking it has a reasonable but mistaken belief about any fact that is an element of the exemption"
#ASSERT `s 227(3) the exemption applies despite a reasonable but mistaken belief` TRUE EQUALS JUST TRUE
#ASSERT `s 227(3) the exemption applies despite a reasonable but mistaken belief` FALSE EQUALS NOTHING
-- 227(1) "No medical practitioner or nurse practitioner commits culpable homicide if they provide a person with medical assistance in dying in accordance with section 241.2"
--                                                                  practitioner  provides MAID  in accordance (3)
#ASSERT `s 227(1) the practitioner commits culpable homicide` (JUST TRUE) (JUST TRUE) TRUE  NOTHING EQUALS JUST FALSE
#ASSERT `s 227(1) the practitioner commits culpable homicide` (JUST TRUE) (JUST TRUE) FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 227(1) the practitioner commits culpable homicide` (JUST TRUE) (JUST TRUE) FALSE NOTHING EQUALS NOTHING
#ASSERT `s 227(1) the practitioner commits culpable homicide` (JUST FALSE) (JUST TRUE) TRUE NOTHING EQUALS NOTHING
#ASSERT `s 227(1) the practitioner commits culpable homicide` (JUST TRUE) (JUST FALSE) TRUE NOTHING EQUALS NOTHING
#ASSERT `s 227(1) the practitioner commits culpable homicide` NOTHING (JUST TRUE) TRUE NOTHING EQUALS NOTHING
-- 227(2) "No person is a party to culpable homicide if they do anything for the purpose of aiding a medical practitioner or nurse practitioner to provide a person with medical assistance in dying in accordance with section 241.2"
#ASSERT `s 227(2) the person is a party to culpable homicide` TRUE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 227(2) the person is a party to culpable homicide` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 227(2) the person is a party to culpable homicide` TRUE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 227(2) the person is a party to culpable homicide` FALSE TRUE NOTHING EQUALS NOTHING
-- 227(4) "Section 14 does not apply with respect to a person who consents to have death inflicted on them by means of medical assistance in dying provided in accordance with section 241.2"
#ASSERT `s 227(4) section 14 applies to the person` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 227(4) section 14 applies to the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 227(4) section 14 applies to the person` FALSE TRUE EQUALS NOTHING
-- 228 "No person commits culpable homicide where he causes the death of a human being (a) by any influence on the mind alone, or (b) by any disorder or disease resulting from influence on the mind alone, but this section does not apply where a person causes the death of a child or sick person by wilfully frightening him"
--                                                death (a)   (b)   frightening
#ASSERT `s 228 the person commits culpable homicide` TRUE TRUE  FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 228 the person commits culpable homicide` TRUE FALSE TRUE  FALSE EQUALS JUST FALSE
#ASSERT `s 228 the person commits culpable homicide` TRUE TRUE  FALSE TRUE  EQUALS NOTHING
#ASSERT `s 228 the person commits culpable homicide` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 228 the person commits culpable homicide` FALSE TRUE FALSE FALSE EQUALS NOTHING
