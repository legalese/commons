IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc7-s183-base`
IMPORT `ccc7-s183-definitions`

-- ccc7-tests-s183-definitions.l4 -- tests for ccc7-s183-definitions.l4 (section 183 definitions and section 183.1) and for the three-valued helpers of ccc7-s183-base.l4.
-- Expected values are written by hand from the text, beside each assertion, before running.

§ `Tests -- the helpers`

#ASSERT `s 183 as a three-valued answer` TRUE EQUALS JUST TRUE
#ASSERT `s 183 as a three-valued answer` FALSE EQUALS JUST FALSE
#ASSERT `s 183 three-valued all of` (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 183 three-valued all of` (LIST JUST TRUE, NOTHING) EQUALS NOTHING
#ASSERT `s 183 three-valued all of` (LIST NOTHING, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 183 three-valued any of` (LIST JUST FALSE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 183 three-valued any of` (LIST JUST FALSE, NOTHING) EQUALS NOTHING
#ASSERT `s 183 three-valued any of` (LIST JUST FALSE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 183 three-valued not` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 183 three-valued not` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 183 three-valued not` NOTHING EQUALS NOTHING

§ `Tests -- authorization (the text: "authorization means an authorization to intercept a private communication given under subsection 184.2(3), section 186 or subsection 188(2)")`

#ASSERT `s 183 authorization` `s 183 an instrument given under subsection 184.2(3)` TRUE EQUALS JUST TRUE
#ASSERT `s 183 authorization` `s 183 an instrument given under section 186` TRUE EQUALS JUST TRUE
#ASSERT `s 183 authorization` `s 183 an instrument given under subsection 188(2)` TRUE EQUALS JUST TRUE
-- given under none of the three: "means" closes the list
#ASSERT `s 183 authorization` `s 183 an instrument given under no other provision named` TRUE EQUALS JUST FALSE
-- an instrument under one of the three that does not authorize an interception of a private communication is not an authorization
#ASSERT `s 183 authorization` `s 183 an instrument given under section 186` FALSE EQUALS JUST FALSE

§ `Tests -- electro-magnetic, acoustic, mechanical or other device`

#ASSERT `s 183 electro-magnetic, acoustic, mechanical or other device` TRUE FALSE EQUALS JUST TRUE
-- "but does not include a hearing aid used to correct subnormal hearing of the user to not better than normal hearing": a flat negative
#ASSERT `s 183 electro-magnetic, acoustic, mechanical or other device` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 183 electro-magnetic, acoustic, mechanical or other device` FALSE TRUE EQUALS JUST FALSE
-- a thing that is not used and is not capable of being used to intercept
#ASSERT `s 183 electro-magnetic, acoustic, mechanical or other device` FALSE FALSE EQUALS JUST FALSE

§ `Tests -- intercept (an "includes" definition: the list is open)`

#ASSERT `s 183 intercept` `s 183 listening to a communication` EQUALS JUST TRUE
#ASSERT `s 183 intercept` `s 183 recording a communication` EQUALS JUST TRUE
#ASSERT `s 183 intercept` `s 183 acquiring a communication` EQUALS JUST TRUE
#ASSERT `s 183 intercept` `s 183 acquiring the substance, meaning or purport of a communication` EQUALS JUST TRUE
-- an act the list does not name is not covered, and is not "not intercepting"
#ASSERT `s 183 intercept` `s 183 an act that is none of those` EQUALS NOTHING

§ `Tests -- police officer`

#ASSERT `s 183 police officer` TRUE EQUALS JUST TRUE
#ASSERT `s 183 police officer` FALSE EQUALS JUST FALSE

§ `Tests -- private communication`

-- the "means" part: oral or telecommunication, originator in Canada, reasonable expectation of privacy
#ASSERT `s 183 private communication` TRUE TRUE FALSE TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
-- "or is intended by the originator to be received by a person who is in Canada": the originator abroad, the recipient in Canada
#ASSERT `s 183 private communication` TRUE FALSE TRUE TRUE (JUST FALSE) FALSE EQUALS JUST TRUE
-- neither the originator nor the intended recipient in Canada
#ASSERT `s 183 private communication` TRUE FALSE FALSE TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
-- no reasonable expectation that it will not be intercepted
#ASSERT `s 183 private communication` TRUE TRUE FALSE FALSE (JUST FALSE) FALSE EQUALS JUST FALSE
-- neither oral nor a telecommunication
#ASSERT `s 183 private communication` FALSE TRUE FALSE TRUE (JUST FALSE) FALSE EQUALS JUST FALSE
-- "and includes any radio-based telephone communication that is treated electronically or otherwise for the purpose of preventing intelligible reception": included even if the means part fails
#ASSERT `s 183 private communication` FALSE FALSE FALSE FALSE (JUST TRUE) TRUE EQUALS JUST TRUE
-- a radio-based telephone communication that is not so treated is not within the extension, and the means part fails: closed
#ASSERT `s 183 private communication` FALSE FALSE FALSE FALSE (JUST TRUE) FALSE EQUALS JUST FALSE
-- whether it is a radio-based telephone communication is itself not covered: the answer is not covered, not "no"
#ASSERT `s 183 private communication` FALSE FALSE FALSE FALSE NOTHING TRUE EQUALS NOTHING
-- but where the means part already holds, an uncovered extension changes nothing
#ASSERT `s 183 private communication` TRUE TRUE FALSE TRUE NOTHING TRUE EQUALS JUST TRUE

§ `Tests -- public switched telephone network`

#ASSERT `s 183 public switched telephone network` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 183 public switched telephone network` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- primary purpose not a land line-based telephone service (a mobile network)
#ASSERT `s 183 public switched telephone network` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- not offered to the public (a private branch exchange)
#ASSERT `s 183 public switched telephone network` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- not for compensation (a free service)
#ASSERT `s 183 public switched telephone network` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

§ `Tests -- radio-based telephone communication`

#ASSERT `s 183 radio-based telephone communication` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
-- the apparatus is connected to a network that is not a public switched telephone network
#ASSERT `s 183 radio-based telephone communication` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
-- the network's status is not covered
#ASSERT `s 183 radio-based telephone communication` TRUE TRUE NOTHING EQUALS NOTHING
-- not a radiocommunication within the meaning of the Radiocommunication Act
#ASSERT `s 183 radio-based telephone communication` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 183 radio-based telephone communication` FALSE TRUE NOTHING EQUALS JUST FALSE
-- not made over apparatus used primarily for connection to the network
#ASSERT `s 183 radio-based telephone communication` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE

§ `Tests -- sell (an "includes" definition)`

#ASSERT `s 183 sell` `s 183 offering for sale` EQUALS JUST TRUE
#ASSERT `s 183 sell` `s 183 exposing for sale` EQUALS JUST TRUE
#ASSERT `s 183 sell` `s 183 having in possession for sale` EQUALS JUST TRUE
#ASSERT `s 183 sell` `s 183 distributing` EQUALS JUST TRUE
#ASSERT `s 183 sell` `s 183 advertising for sale` EQUALS JUST TRUE
#ASSERT `s 183 sell` `s 183 an act that is none of those named` EQUALS NOTHING

§ `Tests -- solicitor`

-- "in the Province of Quebec, an advocate or a notary"
#ASSERT `s 183 solicitor` Quebec `s 183 an advocate` EQUALS JUST TRUE
#ASSERT `s 183 solicitor` Quebec `s 183 a notary` EQUALS JUST TRUE
#ASSERT `s 183 solicitor` Quebec `s 183 a barrister` EQUALS JUST FALSE
#ASSERT `s 183 solicitor` Quebec `s 183 a solicitor` EQUALS JUST FALSE
#ASSERT `s 183 solicitor` Quebec `s 183 a practitioner of none of those kinds` EQUALS JUST FALSE
-- "in any other province, a barrister or solicitor": each of the other nine provinces
#ASSERT `s 183 solicitor` Ontario `s 183 a barrister` EQUALS JUST TRUE
#ASSERT `s 183 solicitor` Ontario `s 183 a solicitor` EQUALS JUST TRUE
#ASSERT `s 183 solicitor` Ontario `s 183 an advocate` EQUALS JUST FALSE
#ASSERT `s 183 solicitor` Ontario `s 183 a notary` EQUALS JUST FALSE
#ASSERT `s 183 solicitor` Ontario `s 183 a practitioner of none of those kinds` EQUALS JUST FALSE
#ASSERT `s 183 solicitor` `Nova Scotia` `s 183 a barrister` EQUALS JUST TRUE
#ASSERT `s 183 solicitor` `British Columbia` `s 183 a barrister` EQUALS JUST TRUE
#ASSERT `s 183 solicitor` `Prince Edward Island` `s 183 a solicitor` EQUALS JUST TRUE
#ASSERT `s 183 solicitor` `Newfoundland and Labrador` `s 183 a solicitor` EQUALS JUST TRUE
#ASSERT `s 183 solicitor` `New Brunswick` `s 183 a barrister` EQUALS JUST TRUE
#ASSERT `s 183 solicitor` Manitoba `s 183 a barrister` EQUALS JUST TRUE
#ASSERT `s 183 solicitor` Saskatchewan `s 183 a solicitor` EQUALS JUST TRUE
#ASSERT `s 183 solicitor` Alberta `s 183 a barrister` EQUALS JUST TRUE
#ASSERT `s 183 solicitor` Alberta `s 183 a notary` EQUALS JUST FALSE
-- the three territories are neither "the Province of Quebec" nor "any other province": silent (fork F5)
#ASSERT `s 183 solicitor` Yukon `s 183 a barrister` EQUALS NOTHING
#ASSERT `s 183 solicitor` `Northwest Territories` `s 183 a solicitor` EQUALS NOTHING
#ASSERT `s 183 solicitor` Nunavut `s 183 an advocate` EQUALS NOTHING

§ `Tests -- section 183.1 (consent of one of several persons)`

-- where the communication is originated by, or intended for, more than one person, one person's consent is sufficient consent
#ASSERT `s 183.1 the section makes one person's consent sufficient consent` TRUE TRUE EQUALS JUST TRUE
-- the "Where" condition fails: one originator and one recipient (the section does not make a consent sufficient)
#ASSERT `s 183.1 the section makes one person's consent sufficient consent` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 183.1 the section makes one person's consent sufficient consent` FALSE FALSE EQUALS JUST FALSE
-- the consent came from someone who is not one of those persons: outside the limit of the grant
#ASSERT `s 183.1 the section makes one person's consent sufficient consent` TRUE FALSE EQUALS NOTHING

-- assertions written: 79; assertions satisfied: 79 (l4 1.6.110 and 1.6.109, check.sh, 2026-11-13)
