IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc10-kidnapping`

-- ccc10-tests-kidnapping.l4 -- tests for ccc10-kidnapping.l4 (ss 279 to 286). Expected values are written by hand from the text, beside each assertion.
-- A regulative rule is run with #TRACE and its outcome stated in a comment (a DEONTIC value cannot be asserted on the stable binary).

`s 279 fixture: the general summary conviction penalty` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
-- Expected punishments, written from the text: life with a minimum of N years, and life with no minimum.
GIVEN years IS A NUMBER
GIVETH A MAYBE Punishment
`s 279 fixture: life with a minimum of` MEANS JUST (Punishment OF `by indictment`, `imprisonment for life`, (`imprisonment for a term of` (`Length of time` OF years, 0, 0, FALSE)), `no fine is stated`, `no fine is stated`)
`s 279 fixture: life with no minimum` MEANS JUST (Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
GIVEN maximum IS A NUMBER
      minimum IS A NUMBER
GIVETH A Punishment
`s 279 fixture: at most and at least` MEANS Punishment OF `by indictment`, (`imprisonment for a term of` (`Length of time` OF maximum, 0, 0, FALSE)), (`imprisonment for a term of` (`Length of time` OF minimum, 0, 0, FALSE)), `no fine is stated`, `no fine is stated`
GIVEN maximum IS A NUMBER
GIVETH A Punishment
`s 279 fixture: at most` MEANS Punishment OF `by indictment`, (`imprisonment for a term of` (`Length of time` OF maximum, 0, 0, FALSE)), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
`s 279 fixture: a conviction` MEANS `s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 279, "(1)"), FALSE, (Date 1 3 2010), 0

§ `s 279 -- Kidnapping`

-- Argument order of (1): kidnaps a person; intent (a) confined or imprisoned; (b) sent out of Canada; (c) ransom or service.
#ASSERT `s 279(1) the person commits the offence of kidnapping` TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- intent (a)
#ASSERT `s 279(1) the person commits the offence of kidnapping` TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- intent (b)
#ASSERT `s 279(1) the person commits the offence of kidnapping` TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- intent (c)
#ASSERT `s 279(1) the person commits the offence of kidnapping` TRUE FALSE FALSE FALSE EQUALS NOTHING   -- no intent named in (a) to (c)
#ASSERT `s 279(1) the person commits the offence of kidnapping` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- no kidnapping

-- Argument order of (1.1): restricted firearm; prohibited firearm; any firearm; criminal organization; second or subsequent (JUST TRUE) or first (JUST FALSE); victim under 16; the offender is a parent, guardian or carer.
#ASSERT `s 279(1.1) the punishment` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS `s 279 fixture: life with a minimum of` 5   -- (a)(i): restricted firearm, first offence: five years
#ASSERT `s 279(1.1) the punishment` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST TRUE) FALSE FALSE EQUALS `s 279 fixture: life with a minimum of` 7   -- (a)(ii): second or subsequent: seven years
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS `s 279 fixture: life with a minimum of` 5   -- (a)(i): prohibited firearm
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST FALSE) FALSE FALSE EQUALS `s 279 fixture: life with a minimum of` 5   -- (a): any firearm and a criminal organization, first
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) FALSE FALSE EQUALS `s 279 fixture: life with a minimum of` 7   -- (a): any firearm and a criminal organization, subsequent
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS `s 279 fixture: life with a minimum of` 4   -- (a.1): "any other case where a firearm is used": four years
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST TRUE) FALSE FALSE EQUALS `s 279 fixture: life with a minimum of` 4   -- (a.1): the second-offence ladder is only in (a)
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) TRUE FALSE EQUALS `s 279 fixture: life with a minimum of` 5   -- (a.2): victim under 16, not a parent: five years
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS `s 279 fixture: life with no minimum`   -- (a.2): "unless the person ... is a parent, guardian or person having the lawful care or charge": no minimum
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS `s 279 fixture: life with no minimum`   -- (b): any other case, imprisonment for life
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) TRUE FALSE EQUALS `s 279 fixture: life with a minimum of` 5   -- (a.1) four and (a.2) five both apply: the greater minimum (fork F20)
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS `s 279 fixture: life with a minimum of` 4   -- (a.1) four applies; (a.2) does not for a parent
#ASSERT `s 279(1.1) the punishment` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST TRUE) TRUE FALSE EQUALS `s 279 fixture: life with a minimum of` 7   -- (a)(ii) seven and (a.2) five: seven
#ASSERT `s 279(1.1) the punishment` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS NOTHING   -- s 2.1 "restricted firearm" not determined
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS NOTHING   -- s 2.1 "prohibited firearm" not determined
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS NOTHING   -- s 2 "firearm" not determined
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST FALSE) (JUST TRUE) NOTHING (JUST FALSE) FALSE FALSE EQUALS NOTHING   -- s 2 "criminal organization" not determined
#ASSERT `s 279(1.1) the punishment` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE) NOTHING FALSE FALSE EQUALS NOTHING   -- limb (a) applies and first-or-subsequent is not determined
#ASSERT `s 279(1.1) the punishment` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING FALSE FALSE EQUALS `s 279 fixture: life with no minimum`   -- limb (a) does not apply: the ladder is not needed
#ASSERT `s 279(1.1) the class of the offence` EQUALS `an indictable offence`   -- "is guilty of an indictable offence"

-- (1.2). Argument order of the conviction record: the offence (section, subsection); a firearm was used; the day of the conviction; days in custody between the two convictions. Then the day of the conviction now being sentenced.
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 279, "(1)"), FALSE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (a): an offence under subsection (1)
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 279, "(2)"), FALSE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS NOTHING   -- subsection (2) is not listed
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 85, "(1)"), FALSE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (b): subsection 85(1)
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 85, "(2)"), FALSE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (b): subsection 85(2)
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 85, "(3)"), FALSE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS NOTHING   -- subsection 85(3) is not listed
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 244, ""), FALSE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (b): section 244
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 244.2, ""), FALSE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (b): section 244.2
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 244.1, ""), FALSE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS NOTHING   -- 244.1 is not listed
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 220, ""), TRUE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (c): section 220 if a firearm was used
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 220, ""), FALSE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS NOTHING   -- (c): no firearm
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 236, ""), TRUE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (c): 236
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 239, ""), TRUE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (c): 239
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 272, ""), TRUE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (c): 272
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 273, ""), TRUE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (c): 273
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 279.1, ""), TRUE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (c): 279.1
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 279.1, ""), FALSE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS NOTHING   -- (c): 279.1 needs a firearm here
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 344, ""), TRUE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (c): 344
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 346, ""), TRUE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS JUST TRUE   -- (c): 346
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 345, ""), TRUE, (Date 1 3 2010), 0) (Date 1 3 2015) EQUALS NOTHING   -- 345 is not listed
-- The ten-year rule: convicted 1 March 2010; ten years have elapsed on 1 March 2020 (no custody); 29 February 2020 is one day short.
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` `s 279 fixture: a conviction` (Date 29 2 2020) EQUALS JUST TRUE   -- 9 years and 364 days: not yet "10 years have elapsed"
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` `s 279 fixture: a conviction` (Date 1 3 2020) EQUALS JUST FALSE   -- exactly 10 years: "shall not be taken into account"
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` `s 279 fixture: a conviction` (Date 1 3 2025) EQUALS JUST FALSE   -- 15 years
-- With 100 days in custody the tenth anniversary moves out by 100 days: 1 March 2020 + 100 days is 9 June 2020.
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 279, "(1)"), FALSE, (Date 1 3 2010), 100) (Date 8 6 2020) EQUALS JUST TRUE   -- 99 days after the anniversary, less 100 days in custody: not yet
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 279, "(1)"), FALSE, (Date 1 3 2010), 100) (Date 9 6 2020) EQUALS JUST FALSE   -- 100 days after: "not taking into account any time in custody"
-- A conviction on 29 February 2012: the tenth anniversary rolls to 1 March 2022 (fork F24).
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 279, "(1)"), FALSE, (Date 29 2 2012), 0) (Date 28 2 2022) EQUALS JUST TRUE   -- before the rolled anniversary
#ASSERT `s 279(1.2) the conviction is to be considered as an earlier offence` (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 279, "(1)"), FALSE, (Date 29 2 2012), 0) (Date 1 3 2022) EQUALS JUST FALSE   -- on it

-- (1.3): the sequence of convictions.
#ASSERT `s 279(1.3) the conviction is earlier in the sequence of convictions` (Date 1 1 2010) (Date 1 1 2015) EQUALS JUST TRUE   -- convicted first
#ASSERT `s 279(1.3) the conviction is earlier in the sequence of convictions` (Date 1 1 2016) (Date 1 1 2015) EQUALS JUST FALSE   -- convicted after: not an earlier offence, whenever it was committed
#ASSERT `s 279(1.3) the conviction is earlier in the sequence of convictions` (Date 1 1 2015) (Date 1 1 2015) EQUALS NOTHING   -- the same day: the text does not sequence them
-- Second or subsequent, from the list.
#ASSERT `s 279(1.2) the person has committed a second or subsequent offence` (EMPTY) (Date 1 3 2015) EQUALS JUST FALSE   -- no earlier conviction: "in the case of a first offence"
#ASSERT `s 279(1.2) the person has committed a second or subsequent offence` (LIST `s 279 fixture: a conviction`) (Date 1 3 2015) EQUALS JUST TRUE   -- one listed earlier conviction within ten years
#ASSERT `s 279(1.2) the person has committed a second or subsequent offence` (LIST `s 279 fixture: a conviction`) (Date 1 3 2025) EQUALS JUST FALSE   -- barred by ten years: a first offence
#ASSERT `s 279(1.2) the person has committed a second or subsequent offence` (LIST (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 85, "(3)"), FALSE, (Date 1 3 2010), 0)) (Date 1 3 2015) EQUALS NOTHING   -- an unlisted earlier conviction: not said to count or not to count
#ASSERT `s 279(1.2) the person has committed a second or subsequent offence` (LIST (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 85, "(3)"), FALSE, (Date 1 3 2010), 0), `s 279 fixture: a conviction`) (Date 1 3 2015) EQUALS JUST TRUE   -- one counted conviction decides it
#ASSERT `s 279(1.2) the person has committed a second or subsequent offence` (LIST (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 279, "(1)"), FALSE, (Date 1 1 2016), 0)) (Date 1 3 2015) EQUALS JUST FALSE   -- convicted after the present one: not earlier (the sequence of convictions)
#ASSERT `s 279(1.2) the person has committed a second or subsequent offence` (LIST (`s 279(1.2) earlier conviction` OF (`Provision of the Code` OF 279, "(1)"), FALSE, (Date 1 3 2015), 0)) (Date 1 3 2015) EQUALS NOTHING   -- convicted on the same day

#ASSERT `s 279(1.21) the court shall take into account the age and vulnerability of the victim` TRUE EQUALS JUST TRUE   -- a sentence under paragraph (1.1)(a.2)
#ASSERT `s 279(1.21) the court shall take into account the age and vulnerability of the victim` FALSE EQUALS NOTHING   -- another sentence: the duty is stated only for (a.2)
-- #TRACE (read): the court takes them into account at time 1 -> FULFILLED.
#TRACE `s 279(1.21) the duty of the court` AT 0 WITH
    PARTY `the court` DOES `s 279(1.21) take into account the age and vulnerability of the victim` AT 1

#ASSERT `s 279(2) the person is guilty of the offence of forcible confinement` TRUE TRUE EQUALS JUST TRUE   -- without lawful authority, confines
#ASSERT `s 279(2) the person is guilty of the offence of forcible confinement` TRUE FALSE EQUALS NOTHING   -- with lawful authority
#ASSERT `s 279(2) the person is guilty of the offence of forcible confinement` FALSE TRUE EQUALS NOTHING   -- no confinement
#ASSERT `s 279(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- "(a) an indictable offence ... or (b) an offence punishable on summary conviction"
#ASSERT `s 279(2) the punishment` `by indictment` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: at most` 10   -- (a): "a term not exceeding ten years"
#ASSERT `s 279(2) the punishment` `on summary conviction` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: the general summary conviction penalty`   -- (b): no penalty stated: s 787(1)
#ASSERT `s 279(3) as the text shows it` EQUALS "[Repealed, 2018, c. 29, s. 26]"   -- line 5684

§ `s 279.01 -- Trafficking in persons`

#ASSERT `s 279.01(1) the person is guilty of the offence of trafficking in persons` TRUE TRUE EQUALS JUST TRUE   -- the act for the purpose of exploiting
#ASSERT `s 279.01(1) the person is guilty of the offence of trafficking in persons` TRUE FALSE EQUALS NOTHING   -- no purpose of exploiting
#ASSERT `s 279.01(1) the person is guilty of the offence of trafficking in persons` FALSE TRUE EQUALS NOTHING   -- none of the acts
#ASSERT `s 279.01(1) the class of the offence` EQUALS `an indictable offence`   -- "is guilty of an indictable offence"
#ASSERT (`s 279.01(1) the punishment` TRUE)'s `maximum imprisonment` EQUALS `imprisonment for life`   -- (a): kidnap, aggravated assault or death: "imprisonment for life"
#ASSERT (`s 279.01(1) the punishment` TRUE)'s `minimum imprisonment` EQUALS `imprisonment for a term of` (`Length of time` OF 5, 0, 0, FALSE)   -- (a): "a minimum punishment of imprisonment for a term of five years"
#ASSERT `s 279.01(1) the punishment` FALSE EQUALS `s 279 fixture: at most and at least` 14 4   -- (b): "not more than 14 years" and a minimum of four years
#ASSERT `s 279.01(2) the consent to the activity is valid` TRUE EQUALS JUST FALSE   -- "No consent ... is valid"
#ASSERT `s 279.01(2) the consent to the activity is valid` FALSE EQUALS NOTHING   -- not a charge under subsection (1)
-- Argument order of (3): the person is not exploited; lives with or is habitually in the company of an exploited person; there is evidence to the contrary.
#ASSERT `s 279.01(3) the evidence is proof that the person exercises control, direction or influence over the movements of that person for the purpose of exploiting them` TRUE TRUE FALSE EQUALS JUST TRUE   -- the presumption operates
#ASSERT `s 279.01(3) the evidence is proof that the person exercises control, direction or influence over the movements of that person for the purpose of exploiting them` TRUE TRUE TRUE EQUALS NOTHING   -- "in the absence of evidence to the contrary": evidence to the contrary is present
#ASSERT `s 279.01(3) the evidence is proof that the person exercises control, direction or influence over the movements of that person for the purpose of exploiting them` FALSE TRUE FALSE EQUALS NOTHING   -- the person is exploited: not the presumption's case
#ASSERT `s 279.01(3) the evidence is proof that the person exercises control, direction or influence over the movements of that person for the purpose of exploiting them` TRUE FALSE FALSE EQUALS NOTHING   -- no cohabitation or company

§ `s 279.011 -- Trafficking of a person under the age of eighteen years`

#ASSERT `s 279.011(1) the person is guilty of the offence of trafficking of a person under the age of eighteen years` TRUE TRUE EQUALS JUST TRUE   -- under 18, for exploitation
#ASSERT `s 279.011(1) the person is guilty of the offence of trafficking of a person under the age of eighteen years` TRUE FALSE EQUALS NOTHING   -- no purpose of exploiting
#ASSERT `s 279.011(1) the person is guilty of the offence of trafficking of a person under the age of eighteen years` FALSE TRUE EQUALS NOTHING   -- no act as to a person under 18
#ASSERT `s 279.011(1) the class of the offence` EQUALS `an indictable offence`   -- "guilty of an indictable offence"
#ASSERT (`s 279.011(1) the punishment` TRUE)'s `maximum imprisonment` EQUALS `imprisonment for life`   -- (a): life
#ASSERT (`s 279.011(1) the punishment` TRUE)'s `minimum imprisonment` EQUALS `imprisonment for a term of` (`Length of time` OF 6, 0, 0, FALSE)   -- (a): "six years"
#ASSERT `s 279.011(1) the punishment` FALSE EQUALS `s 279 fixture: at most and at least` 14 5   -- (b): "fourteen years" and "five years"
#ASSERT `s 279.011(2) the consent to the activity is valid` TRUE EQUALS JUST FALSE   -- "No consent ... is valid"
#ASSERT `s 279.011(2) the consent to the activity is valid` FALSE EQUALS NOTHING   -- not a charge under subsection (1)

§ `s 279.02 -- Material benefit -- trafficking`

#ASSERT `s 279.02(1) the person is guilty of the offence of receiving a material benefit from trafficking` TRUE TRUE EQUALS JUST TRUE   -- receives, knowing
#ASSERT `s 279.02(1) the person is guilty of the offence of receiving a material benefit from trafficking` TRUE FALSE EQUALS NOTHING   -- no knowledge
#ASSERT `s 279.02(1) the person is guilty of the offence of receiving a material benefit from trafficking` FALSE TRUE EQUALS NOTHING   -- no benefit
#ASSERT `s 279.02(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 279.02(1) the punishment` `by indictment` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: at most` 10   -- (a): "not more than 10 years"
#ASSERT `s 279.02(1) the punishment` `on summary conviction` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: the general summary conviction penalty`   -- (b): s 787(1)
#ASSERT `s 279.02(2) the person is guilty of the offence of receiving a material benefit from trafficking of a person under 18 years` TRUE TRUE EQUALS JUST TRUE   -- receives, knowing
#ASSERT `s 279.02(2) the person is guilty of the offence of receiving a material benefit from trafficking of a person under 18 years` TRUE FALSE EQUALS NOTHING   -- no knowledge
#ASSERT `s 279.02(2) the class of the offence` EQUALS `an indictable offence`   -- "guilty of an indictable offence"
#ASSERT `s 279.02(2) the punishment` EQUALS `s 279 fixture: at most and at least` 14 2   -- "not more than 14 years and to a minimum punishment of imprisonment for a term of two years"

§ `s 279.03 -- Withholding or destroying documents -- trafficking`

#ASSERT `s 279.03(1) the person is guilty of the offence of withholding or destroying documents` TRUE TRUE EQUALS JUST TRUE   -- the act for the purpose
#ASSERT `s 279.03(1) the person is guilty of the offence of withholding or destroying documents` TRUE FALSE EQUALS NOTHING   -- no such purpose
#ASSERT `s 279.03(1) the person is guilty of the offence of withholding or destroying documents` FALSE TRUE EQUALS NOTHING   -- no such act
#ASSERT `s 279.03(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 279.03(1) the punishment` `by indictment` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: at most` 5   -- (a): "not more than five years"
#ASSERT `s 279.03(1) the punishment` `on summary conviction` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: the general summary conviction penalty`   -- (b): s 787(1)
#ASSERT `s 279.03(2) the person is guilty of the offence of withholding or destroying documents -- trafficking of a person under 18 years` TRUE TRUE EQUALS JUST TRUE   -- the act for the purpose
#ASSERT `s 279.03(2) the person is guilty of the offence of withholding or destroying documents -- trafficking of a person under 18 years` FALSE TRUE EQUALS NOTHING   -- no such act
#ASSERT `s 279.03(2) the class of the offence` EQUALS `an indictable offence`   -- "guilty of an indictable offence"
#ASSERT `s 279.03(2) the punishment` EQUALS `s 279 fixture: at most and at least` 10 1   -- "not more than 10 years and to a minimum punishment of imprisonment for a term of one year"

§ `s 279.04 -- Exploitation`

#ASSERT `s 279.04(1) the person exploits another person` TRUE TRUE EQUALS JUST TRUE   -- causes labour or a service by conduct that could reasonably be expected to cause the belief
#ASSERT `s 279.04(1) the person exploits another person` TRUE FALSE EQUALS JUST FALSE   -- the conduct limb fails: a failed "if"
#ASSERT `s 279.04(1) the person exploits another person` FALSE TRUE EQUALS JUST FALSE   -- no causing of labour or service
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2) the nature of the relationship between the accused and the complainant` FALSE EQUALS JUST TRUE   -- "all the circumstances, including the nature of the relationship": always
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2) another circumstance` FALSE EQUALS JUST TRUE   -- "all the circumstances"
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(a) the accused used, or threatened or attempted to use, force or another form of coercion` TRUE EQUALS JUST TRUE   -- (a) with evidence
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(a) the accused used, or threatened or attempted to use, force or another form of coercion` FALSE EQUALS NOTHING   -- (a) with no evidence: "with respect to which there is evidence"
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(b) the accused used deception` TRUE EQUALS JUST TRUE   -- (b)
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(c) the accused abused a position of trust, power or authority` TRUE EQUALS JUST TRUE   -- (c)
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(d) the accused engaged in controlling or directive behaviour` TRUE EQUALS JUST TRUE   -- (d)
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(e) the accused subjected the complainant to degrading or humiliating behaviour` TRUE EQUALS JUST TRUE   -- (e)
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(e.1) the accused used, or threatened or attempted to use, violence against any animal known to the complainant` TRUE EQUALS JUST TRUE   -- (e.1)
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(e.2) the accused damaged, or threatened or attempted to damage, the complainant’s property or the property of anyone known to the complainant` TRUE EQUALS JUST TRUE   -- (e.2)
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(f) the accused exposed the complainant to behaviour referred to in paragraphs (a) to (e.2) directed at another person` TRUE EQUALS JUST TRUE   -- (f)
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(g) the accused received an undue benefit in relation to the labour or service` TRUE EQUALS JUST TRUE   -- (g)
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(h) the complainant is vulnerable` TRUE EQUALS JUST TRUE   -- (h)
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(h) the complainant is vulnerable` FALSE EQUALS NOTHING   -- (h) with no evidence
#ASSERT `s 279.04(2) the Court must consider the circumstance` `s 279.04(2)(i) the accused manipulated the complainant by targeting their vulnerabilities` TRUE EQUALS JUST TRUE   -- (i)
#ASSERT `s 279.04(3) the person exploits another person` TRUE TRUE EQUALS JUST TRUE   -- causes an organ or tissue to be removed by deception or force
#ASSERT `s 279.04(3) the person exploits another person` TRUE FALSE EQUALS JUST FALSE   -- not by deception, force or coercion
#ASSERT `s 279.04(3) the person exploits another person` FALSE TRUE EQUALS JUST FALSE   -- no removal
#ASSERT `s 279.04 the person exploits another person for the purposes of sections 279.01 to 279.03` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- by (1)
#ASSERT `s 279.04 the person exploits another person for the purposes of sections 279.01 to 279.03` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE   -- by (3)
#ASSERT `s 279.04 the person exploits another person for the purposes of sections 279.01 to 279.03` (JUST FALSE) (JUST FALSE) EQUALS NOTHING   -- neither route: each says "if", not "only if"
#ASSERT `s 279.04 the person exploits another person for the purposes of sections 279.01 to 279.03` NOTHING (JUST FALSE) EQUALS NOTHING   -- not determined
#ASSERT `s 279.04(4) a person’s safety includes this kind of safety` `s 279.04(4) psychological safety` EQUALS JUST TRUE   -- "a person’s safety includes their psychological safety"
#ASSERT `s 279.04(4) a person’s safety includes this kind of safety` `s 279.04(4) safety of another kind` EQUALS NOTHING   -- "includes": the list is not closed

§ `s 279.1 -- Hostage taking`

#ASSERT `s 279.1(1) the person takes a person hostage` TRUE TRUE TRUE EQUALS JUST TRUE   -- intent, confines, threat
#ASSERT `s 279.1(1) the person takes a person hostage` FALSE TRUE TRUE EQUALS NOTHING   -- no intent to induce
