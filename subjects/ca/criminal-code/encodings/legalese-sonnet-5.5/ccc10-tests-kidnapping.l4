§ `ss 280 to 283 -- Abduction`

#ASSERT `s 280(1) the person is guilty of the offence of abduction of a person under age 16` TRUE TRUE TRUE EQUALS JUST TRUE   -- every element
#ASSERT `s 280(1) the person is guilty of the offence of abduction of a person under age 16` FALSE TRUE TRUE EQUALS NOTHING   -- with lawful authority
#ASSERT `s 280(1) the person is guilty of the offence of abduction of a person under age 16` TRUE FALSE TRUE EQUALS NOTHING   -- not a person under 16
#ASSERT `s 280(1) the person is guilty of the offence of abduction of a person under age 16` TRUE TRUE FALSE EQUALS NOTHING   -- not against the will of the parent or guardian
#ASSERT `s 280(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 280(1) the punishment` `by indictment` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: at most` 5   -- (a): "not more than five years"
#ASSERT `s 280(1) the punishment` `on summary conviction` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: the general summary conviction penalty`   -- (b): s 787(1)
#ASSERT `s 280(2) the person is a guardian` TRUE EQUALS JUST TRUE   -- "guardian includes any person who has in law or in fact the custody or control"
#ASSERT `s 280(2) the person is a guardian` FALSE EQUALS NOTHING   -- "includes": the definition does not exclude others
#ASSERT `s 281 the person is guilty of the offence of abduction of a person under age 14` TRUE TRUE TRUE EQUALS JUST TRUE   -- every element
#ASSERT `s 281 the person is guilty of the offence of abduction of a person under age 14` FALSE TRUE TRUE EQUALS NOTHING   -- the person is the parent, guardian or carer: section 282 or 283 instead
#ASSERT `s 281 the person is guilty of the offence of abduction of a person under age 14` TRUE FALSE TRUE EQUALS NOTHING   -- no taking, enticing, concealing, detaining, receiving or harbouring
#ASSERT `s 281 the person is guilty of the offence of abduction of a person under age 14` TRUE TRUE FALSE EQUALS NOTHING   -- no intent to deprive
#ASSERT `s 281 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 281 the punishment` `by indictment` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: at most` 10   -- (a): "not more than 10 years"
#ASSERT `s 281 the punishment` `on summary conviction` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: the general summary conviction penalty`   -- (b)
#ASSERT `s 282(1) the person is guilty of the offence of abduction in contravention of a custody or parenting order` TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- every element
#ASSERT `s 282(1) the person is guilty of the offence of abduction in contravention of a custody or parenting order` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- not the parent, guardian or carer
#ASSERT `s 282(1) the person is guilty of the offence of abduction in contravention of a custody or parenting order` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- no taking
#ASSERT `s 282(1) the person is guilty of the offence of abduction in contravention of a custody or parenting order` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- no custody order or parenting order contravened (section 283 may apply)
#ASSERT `s 282(1) the person is guilty of the offence of abduction in contravention of a custody or parenting order` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- no intent to deprive
#ASSERT `s 282(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 282(1) the punishment` `by indictment` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: at most` 10   -- (a): "not exceeding ten years"
#ASSERT `s 282(1) the punishment` `on summary conviction` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: the general summary conviction penalty`   -- (b)
#ASSERT `s 282(2) the accused may be convicted of an offence under section 283` TRUE TRUE TRUE EQUALS JUST TRUE   -- all three conditions
#ASSERT `s 282(2) the accused may be convicted of an offence under section 283` FALSE TRUE TRUE EQUALS NOTHING   -- the count does not charge (1)
#ASSERT `s 282(2) the accused may be convicted of an offence under section 283` TRUE FALSE TRUE EQUALS NOTHING   -- not unproven only because of the belief
#ASSERT `s 282(2) the accused may be convicted of an offence under section 283` TRUE TRUE FALSE EQUALS NOTHING   -- the evidence does not prove section 283
#ASSERT `s 283(1) the person is guilty of the offence of abduction` TRUE TRUE TRUE EQUALS JUST TRUE   -- every element, whether or not there is an order
#ASSERT `s 283(1) the person is guilty of the offence of abduction` FALSE TRUE TRUE EQUALS NOTHING   -- not the parent, guardian or carer
#ASSERT `s 283(1) the person is guilty of the offence of abduction` TRUE FALSE TRUE EQUALS NOTHING   -- no taking
#ASSERT `s 283(1) the person is guilty of the offence of abduction` TRUE TRUE FALSE EQUALS NOTHING   -- no intent to deprive
#ASSERT `s 283(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 283(1) the punishment` `by indictment` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: at most` 10   -- (a): "not exceeding ten years"
#ASSERT `s 283(1) the punishment` `on summary conviction` `s 279 fixture: the general summary conviction penalty` EQUALS `s 279 fixture: the general summary conviction penalty`   -- (b)
#ASSERT `s 283(2) proceedings under subsection (1) may not be commenced` FALSE EQUALS JUST TRUE   -- no consent: the bar
#ASSERT `s 283(2) proceedings under subsection (1) may not be commenced` TRUE EQUALS NOTHING   -- consent given: the bar is lifted, the text says nothing further

§ `ss 284 to 286 -- Defences and no defence`

-- Argument order of s 284: the offence charged; the person charged establishes the consent of the parent, guardian or other person.
#ASSERT `s 284 the consent of the parent, guardian or other person having lawful possession bars a finding of guilt` (`Provision of the Code` OF 281, "") TRUE EQUALS JUST TRUE   -- section 281, consent established
#ASSERT `s 284 the consent of the parent, guardian or other person having lawful possession bars a finding of guilt` (`Provision of the Code` OF 282, "(1)") TRUE EQUALS JUST TRUE   -- section 282
#ASSERT `s 284 the consent of the parent, guardian or other person having lawful possession bars a finding of guilt` (`Provision of the Code` OF 283, "(1)") TRUE EQUALS JUST TRUE   -- section 283
#ASSERT `s 284 the consent of the parent, guardian or other person having lawful possession bars a finding of guilt` (`Provision of the Code` OF 281, "") FALSE EQUALS JUST FALSE   -- not established: this section gives no defence on these facts
#ASSERT `s 284 the consent of the parent, guardian or other person having lawful possession bars a finding of guilt` (`Provision of the Code` OF 280, "(1)") TRUE EQUALS NOTHING   -- section 280 is not within "sections 281 to 283"
#ASSERT `s 284 the consent of the parent, guardian or other person having lawful possession bars a finding of guilt` (`Provision of the Code` OF 283.1, "") TRUE EQUALS NOTHING   -- 283.1 follows section 283
#ASSERT `s 284 the consent of the parent, guardian or other person having lawful possession bars a finding of guilt` (`Provision of the Code` OF 284, "") TRUE EQUALS NOTHING   -- section 284 itself
-- Argument order of s 285: the offence charged; the court is satisfied the taking was necessary to protect the young person; the person charged was escaping from danger.
#ASSERT `s 285 the danger of imminent harm bars a finding of guilt` (`Provision of the Code` OF 280, "(1)") TRUE FALSE EQUALS JUST TRUE   -- section 280, necessary to protect the young person
#ASSERT `s 285 the danger of imminent harm bars a finding of guilt` (`Provision of the Code` OF 283, "(1)") FALSE TRUE EQUALS JUST TRUE   -- section 283, escaping from danger
#ASSERT `s 285 the danger of imminent harm bars a finding of guilt` (`Provision of the Code` OF 281, "") FALSE FALSE EQUALS JUST FALSE   -- neither limb: this section gives no defence on these facts
#ASSERT `s 285 the danger of imminent harm bars a finding of guilt` (`Provision of the Code` OF 279, "(1)") TRUE TRUE EQUALS NOTHING   -- section 279 is outside "sections 280 to 283"
#ASSERT `s 285 the danger of imminent harm bars a finding of guilt` (`Provision of the Code` OF 284, "") TRUE TRUE EQUALS NOTHING   -- section 284 follows
#ASSERT `s 286 the young person’s consent or suggestion is a defence` (`Provision of the Code` OF 280, "(1)") TRUE EQUALS JUST FALSE   -- "it is not a defence ... that a young person consented to or suggested any conduct"
#ASSERT `s 286 the young person’s consent or suggestion is a defence` (`Provision of the Code` OF 283, "(1)") TRUE EQUALS JUST FALSE   -- section 283
#ASSERT `s 286 the young person’s consent or suggestion is a defence` (`Provision of the Code` OF 279, "(1)") TRUE EQUALS NOTHING   -- section 279 is outside "sections 280 to 283"
#ASSERT `s 286 the young person’s consent or suggestion is a defence` (`Provision of the Code` OF 281, "") FALSE EQUALS NOTHING   -- no consent or suggestion alleged
-- The compositions.
#ASSERT `s 280 and s 285 the person is guilty of the offence of abduction of a person under age 16 after the defence` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- offence made out, no defence
#ASSERT `s 280 and s 285 the person is guilty of the offence of abduction of a person under age 16 after the defence` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE   -- "No one shall be found guilty ... if the court is satisfied"
#ASSERT `s 280 and s 285 the person is guilty of the offence of abduction of a person under age 16 after the defence` (JUST TRUE) NOTHING EQUALS NOTHING   -- the defence is not determined
#ASSERT `s 280 and s 285 the person is guilty of the offence of abduction of a person under age 16 after the defence` NOTHING (JUST FALSE) EQUALS NOTHING   -- the offence is not determined
#ASSERT `s 280 and s 285 the person is guilty of the offence of abduction of a person under age 16 after the defence` NOTHING (JUST TRUE) EQUALS JUST FALSE   -- a defence that applies bars guilt whatever the offence answer
#ASSERT `s 281 to 283 and ss 284 and 285 the person is guilty of the offence after the defences` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- no defence
#ASSERT `s 281 to 283 and ss 284 and 285 the person is guilty of the offence after the defences` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE   -- section 284 applies
#ASSERT `s 281 to 283 and ss 284 and 285 the person is guilty of the offence after the defences` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE   -- section 285 applies
#ASSERT `s 281 to 283 and ss 284 and 285 the person is guilty of the offence after the defences` (JUST TRUE) NOTHING (JUST FALSE) EQUALS NOTHING   -- section 284 is not determined
#ASSERT `s 281 to 283 and ss 284 and 285 the person is guilty of the offence after the defences` NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING   -- the offence is not determined
#ASSERT `s 281 to 283 and ss 284 and 285 the person is guilty of the offence after the defences` NOTHING (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE   -- a defence that applies
