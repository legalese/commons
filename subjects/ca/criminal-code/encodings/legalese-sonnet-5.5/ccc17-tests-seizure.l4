IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc17-seizure`

-- ccc17-tests-seizure.l4 -- tests for ccc17-seizure.l4 (ss 489 to 490.01). Expected values are written from the text, beside each assertion.

§ `Tests: s 489 seizure of things not specified, seizure without warrant`

#ASSERT `s 489(1) the person who executes a warrant may seize the thing in addition to the things mentioned in the warrant` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 489(1) the person who executes a warrant may seize the thing in addition to the things mentioned in the warrant` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 489(1) the person who executes a warrant may seize the thing in addition to the things mentioned in the warrant` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 489(1) the person who executes a warrant may seize the thing in addition to the things mentioned in the warrant` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 489(1) the person who executes a warrant may seize the thing in addition to the things mentioned in the warrant` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 489(2) the officer may, without a warrant, seize the thing` (JUST TRUE) FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 489(2) the officer may, without a warrant, seize the thing` (JUST FALSE) TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 489(2) the officer may, without a warrant, seize the thing` (JUST TRUE) FALSE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 489(2) the officer may, without a warrant, seize the thing` NOTHING FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 489(2) the officer may, without a warrant, seize the thing` (JUST TRUE) FALSE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 489(2) the officer may, without a warrant, seize the thing` (JUST TRUE) FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING

§ `Tests: s 489.1 restitution or report`

#ASSERT `s 489.1(1) what the peace officer shall do as soon as is practicable` TRUE TRUE TRUE EQUALS JUST `s 489.1(1)(a) return the thing seized, on being issued a receipt for it, to the person lawfully entitled to its possession and report to a justice having jurisdiction in respect of the matter`
#ASSERT `s 489.1(1) what the peace officer shall do as soon as is practicable` TRUE FALSE TRUE EQUALS JUST `s 489.1(1)(b) bring the thing seized before a justice, or report to the justice that the thing has been seized and is being detained, to be dealt with in accordance with subsection 490(1)`
#ASSERT `s 489.1(1) what the peace officer shall do as soon as is practicable` TRUE TRUE FALSE EQUALS JUST `s 489.1(1)(b) bring the thing seized before a justice, or report to the justice that the thing has been seized and is being detained, to be dealt with in accordance with subsection 490(1)`
#ASSERT `s 489.1(1) what the peace officer shall do as soon as is practicable` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 489.1(2) the person shall, as soon as is practicable, bring the thing before a justice or report to the justice that it has been seized and is being detained` TRUE EQUALS JUST TRUE
#ASSERT `s 489.1(2) the person shall, as soon as is practicable, bring the thing before a justice or report to the justice that it has been seized and is being detained` FALSE EQUALS NOTHING
#ASSERT `s 489.1(3) the report to a justice shall be in Form 5.2, varied to suit the case` TRUE EQUALS JUST TRUE
#ASSERT `s 489.1(3) the report to a justice shall be in Form 5.2, varied to suit the case` FALSE EQUALS NOTHING
#ASSERT `s 489.1(4) section 489.1 does not apply to the thing` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 489.1(4) section 489.1 does not apply to the thing` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 489.1(4) section 489.1 does not apply to the thing` FALSE FALSE EQUALS NOTHING

§ `Tests: s 490(1) to (4) detention, the 180 days, the one year`

#ASSERT `s 490(1) the order the justice shall make` TRUE TRUE FALSE EQUALS JUST `s 490(1)(a) order the thing seized to be returned to the lawful owner or the person lawfully entitled to possession`
#ASSERT `s 490(1) the order the justice shall make` TRUE TRUE TRUE EQUALS JUST `s 490(1)(b) detain the thing seized or order that it be detained, taking reasonable care to ensure that it is preserved`
#ASSERT `s 490(1) the order the justice shall make` TRUE FALSE TRUE EQUALS JUST `s 490(1)(b) detain the thing seized or order that it be detained, taking reasonable care to ensure that it is preserved`
#ASSERT `s 490(1) the order the justice shall make` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 490(1) the order the justice shall make` FALSE TRUE FALSE EQUALS NOTHING
-- (2): seized 1 January 2026: day 180 after the day of the seizure is 30 June 2026
#ASSERT `s 490(2) the last day on which the thing may be detained without a further order` (Date 1 1 2026) EQUALS Date 30 6 2026
#ASSERT `s 490(2) the section bars detaining the thing for more than 180 days after the day of the seizure` (Date 1 1 2026) (Date 30 6 2026) FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 490(2) the section bars detaining the thing for more than 180 days after the day of the seizure` (Date 1 1 2026) (Date 1 7 2026) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 490(2) the section bars detaining the thing for more than 180 days after the day of the seizure` (Date 1 1 2026) (Date 1 7 2026) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 490(2) the section bars detaining the thing for more than 180 days after the day of the seizure` (Date 1 1 2026) (Date 1 7 2026) FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 490(2) the section bars detaining the thing for more than 180 days after the day of the seizure` (Date 1 1 2026) (Date 1 7 2026) FALSE FALSE TRUE EQUALS JUST FALSE
-- (3): the cumulative one year from 1 January 2026 ends on 1 January 2027
#ASSERT `s 490(3) the last day on which the thing may be detained without a judge’s order` (Date 1 1 2026) EQUALS Date 1 1 2027
#ASSERT `s 490(3) the section bars detaining the thing for more than one year from the day of the seizure` (Date 1 1 2026) (Date 1 1 2027) FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 490(3) the section bars detaining the thing for more than one year from the day of the seizure` (Date 1 1 2026) (Date 2 1 2027) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 490(3) the section bars detaining the thing for more than one year from the day of the seizure` (Date 1 1 2026) (Date 2 1 2027) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 490(3) the section bars detaining the thing for more than one year from the day of the seizure` (Date 1 1 2026) (Date 2 1 2027) FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 490(3) the section bars detaining the thing for more than one year from the day of the seizure` (Date 1 1 2026) (Date 2 1 2027) FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 490(3.1) the thing may be detained for the period` TRUE EQUALS JUST TRUE
#ASSERT `s 490(3.1) the thing may be detained for the period` FALSE EQUALS NOTHING
#ASSERT `s 490(4) the justice shall forward anything detained to the clerk of the court to which the accused has been ordered to stand trial` TRUE EQUALS JUST TRUE
#ASSERT `s 490(4) the justice shall forward anything detained to the clerk of the court to which the accused has been ordered to stand trial` FALSE EQUALS JUST FALSE

§ `Tests: s 490(5) to (11) applications, return and disposal`

#ASSERT `s 490(5) the court to which the application is made` TRUE EQUALS `s 490 a judge of a superior court of criminal jurisdiction or a judge as defined in section 552`
#ASSERT `s 490(5) the court to which the application is made` FALSE EQUALS `s 490 a justice`
#ASSERT `s 490(5) the prosecutor, peace officer or other person shall apply for an order in respect of the property under subsection (9)` TRUE EQUALS JUST TRUE
#ASSERT `s 490(5) the prosecutor, peace officer or other person shall apply for an order in respect of the property under subsection (9)` FALSE EQUALS JUST FALSE
#ASSERT `s 490(6) the prosecutor, peace officer or other person shall apply for an order in respect of the property under subsection (9) or (9.1)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490(6) the prosecutor, peace officer or other person shall apply for an order in respect of the property under subsection (9) or (9.1)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 490(6) the prosecutor, peace officer or other person shall apply for an order in respect of the property under subsection (9) or (9.1)` TRUE FALSE EQUALS JUST FALSE
-- (7): after the expiration (or early by (8)), on three clear days notice (or waived by (18))
#ASSERT `s 490(7) the person from whom anything has been seized may apply summarily for an order under paragraph (9)(c) that the thing be returned` TRUE FALSE 3 FALSE EQUALS JUST TRUE
#ASSERT `s 490(7) the person from whom anything has been seized may apply summarily for an order under paragraph (9)(c) that the thing be returned` TRUE FALSE 10 FALSE EQUALS JUST TRUE
#ASSERT `s 490(7) the person from whom anything has been seized may apply summarily for an order under paragraph (9)(c) that the thing be returned` TRUE FALSE 2 FALSE EQUALS JUST FALSE
#ASSERT `s 490(7) the person from whom anything has been seized may apply summarily for an order under paragraph (9)(c) that the thing be returned` TRUE FALSE 2 TRUE EQUALS JUST TRUE
#ASSERT `s 490(7) the person from whom anything has been seized may apply summarily for an order under paragraph (9)(c) that the thing be returned` FALSE FALSE 3 FALSE EQUALS JUST FALSE
#ASSERT `s 490(7) the person from whom anything has been seized may apply summarily for an order under paragraph (9)(c) that the thing be returned` FALSE TRUE 3 FALSE EQUALS JUST TRUE
#ASSERT `s 490(8) the judge or justice may allow an application under subsection (7) to be made before the expiration of the periods` TRUE EQUALS JUST TRUE
#ASSERT `s 490(8) the judge or justice may allow an application under subsection (7) to be made before the expiration of the periods` FALSE EQUALS JUST FALSE
-- (9): (c) lawful possession; (d) unlawful possession and known owner; neither (a thing in no one's possession with a known owner is not reached)
#ASSERT `s 490(9) the order the judge or justice shall make` TRUE TRUE FALSE FALSE FALSE EQUALS JUST `s 490(9)(c) order the thing returned to the person from whom it was seized`
#ASSERT `s 490(9) the order the judge or justice shall make` TRUE FALSE TRUE FALSE TRUE EQUALS JUST `s 490(9)(d) order the thing returned to the lawful owner or the person lawfully entitled to its possession`
#ASSERT `s 490(9) the order the judge or justice shall make` TRUE FALSE TRUE FALSE FALSE EQUALS JUST `s 490(9) paragraphs (c) and (d) require no order`
#ASSERT `s 490(9) the order the judge or justice shall make` FALSE TRUE FALSE FALSE FALSE EQUALS JUST `s 490(9) paragraphs (c) and (d) require no order`
#ASSERT `s 490(9) the order the judge or justice shall make` TRUE FALSE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 490(9) the order the judge or justice shall make` TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 490(9) the judge or justice may order the thing forfeited to Her Majesty, to be disposed of as the Attorney General directs or otherwise dealt with in accordance with the law` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490(9) the judge or justice may order the thing forfeited to Her Majesty, to be disposed of as the Attorney General directs or otherwise dealt with in accordance with the law` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 490(9) the judge or justice may order the thing forfeited to Her Majesty, to be disposed of as the Attorney General directs or otherwise dealt with in accordance with the law` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 490(9) the judge or justice may order the thing forfeited to Her Majesty, to be disposed of as the Attorney General directs or otherwise dealt with in accordance with the law` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 490(9.1) the judge or justice may order that the thing continue to be detained for such period as the judge or justice considers necessary` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490(9.1) the judge or justice may order that the thing continue to be detained for such period as the judge or justice considers necessary` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 490(9.1) the judge or justice may order that the thing continue to be detained for such period as the judge or justice considers necessary` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 490(9.1) the judge or justice may order that the thing continue to be detained for such period as the judge or justice considers necessary` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 490(10) the claimant may at any time apply summarily for an order that the thing detained be returned to the applicant` TRUE FALSE 3 FALSE EQUALS JUST TRUE
#ASSERT `s 490(10) the claimant may at any time apply summarily for an order that the thing detained be returned to the applicant` TRUE FALSE 1 FALSE EQUALS JUST FALSE
#ASSERT `s 490(10) the claimant may at any time apply summarily for an order that the thing detained be returned to the applicant` TRUE FALSE 1 TRUE EQUALS JUST TRUE
#ASSERT `s 490(10) the claimant may at any time apply summarily for an order that the thing detained be returned to the applicant` TRUE TRUE 3 FALSE EQUALS NOTHING
#ASSERT `s 490(10) the claimant may at any time apply summarily for an order that the thing detained be returned to the applicant` FALSE FALSE 3 FALSE EQUALS NOTHING
#ASSERT `s 490(11) the order the judge or justice shall make on the application under subsection (10)` TRUE TRUE FALSE FALSE EQUALS JUST `s 490(11)(c) order that the thing seized be returned to the applicant`
#ASSERT `s 490(11) the order the judge or justice shall make on the application under subsection (10)` TRUE TRUE TRUE FALSE EQUALS JUST `s 490(11)(d) order that the applicant be paid the proceeds of sale or the value of the thing seized`
#ASSERT `s 490(11) the order the judge or justice shall make on the application under subsection (10)` TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 490(11) the order the judge or justice shall make on the application under subsection (10)` FALSE TRUE FALSE FALSE EQUALS JUST `s 490(11) paragraphs (c) and (d) require no order`
#ASSERT `s 490(11) the order the judge or justice shall make on the application under subsection (10)` TRUE FALSE FALSE FALSE EQUALS JUST `s 490(11) paragraphs (c) and (d) require no order`

§ `Tests: s 490(12) to (18), s 490.01`

-- (12): an order made on 1 March 2026: nothing returned, forfeited or disposed of within thirty days after it (to 31 March 2026), nor pending an application or appeal
#ASSERT `s 490(12) the last day of the thirty days after the order` (Date 1 3 2026) EQUALS Date 31 3 2026
#ASSERT `s 490(12) nothing shall be returned, forfeited or disposed of` FALSE (Date 1 3 2026) (Date 15 3 2026) EQUALS JUST TRUE
#ASSERT `s 490(12) nothing shall be returned, forfeited or disposed of` FALSE (Date 1 3 2026) (Date 31 3 2026) EQUALS JUST TRUE
#ASSERT `s 490(12) nothing shall be returned, forfeited or disposed of` FALSE (Date 1 3 2026) (Date 1 4 2026) EQUALS NOTHING
#ASSERT `s 490(12) nothing shall be returned, forfeited or disposed of` FALSE (Date 1 3 2026) (Date 28 2 2026) EQUALS NOTHING
#ASSERT `s 490(12) nothing shall be returned, forfeited or disposed of` TRUE (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `s 490(13) the person may make, and retain, a copy of the document before bringing it before a justice or complying with an order` `s 490(13) the Attorney General` TRUE EQUALS JUST TRUE
#ASSERT `s 490(13) the person may make, and retain, a copy of the document before bringing it before a justice or complying with an order` `s 490(13) the prosecutor` TRUE EQUALS JUST TRUE
#ASSERT `s 490(13) the person may make, and retain, a copy of the document before bringing it before a justice or complying with an order` `s 490(13) the peace officer or other person having custody of a document seized` TRUE EQUALS JUST TRUE
#ASSERT `s 490(13) the person may make, and retain, a copy of the document before bringing it before a justice or complying with an order` `s 490(13) someone else` TRUE EQUALS NOTHING
#ASSERT `s 490(13) the person may make, and retain, a copy of the document before bringing it before a justice or complying with an order` `s 490(13) the prosecutor` FALSE EQUALS NOTHING
#ASSERT `s 490(14) the copy is admissible in evidence` TRUE `s 490(14) the Attorney General` EQUALS JUST TRUE
#ASSERT `s 490(14) the copy is admissible in evidence` TRUE `s 490(14) the person who made the copy` EQUALS JUST TRUE
#ASSERT `s 490(14) the copy is admissible in evidence` TRUE `s 490(14) the person in whose presence the copy was made` EQUALS JUST TRUE
#ASSERT `s 490(14) the copy is admissible in evidence` TRUE `s 490(14) someone else, or no one` EQUALS NOTHING
#ASSERT `s 490(14) the copy is admissible in evidence` FALSE `s 490(14) the Attorney General` EQUALS NOTHING
#ASSERT `s 490(14) the copy has the same probative force as the original document would have if it had been proved in the ordinary way` TRUE `s 490(14) the Attorney General` FALSE EQUALS JUST TRUE
#ASSERT `s 490(14) the copy has the same probative force as the original document would have if it had been proved in the ordinary way` TRUE `s 490(14) the Attorney General` TRUE EQUALS JUST FALSE
#ASSERT `s 490(14) the copy has the same probative force as the original document would have if it had been proved in the ordinary way` TRUE `s 490(14) someone else, or no one` FALSE EQUALS NOTHING
#ASSERT `s 490(15) the judge may order that the person be permitted to examine anything so detained` `s 490(15) a judge of a superior court of criminal jurisdiction` TRUE TRUE 3 FALSE EQUALS JUST TRUE
#ASSERT `s 490(15) the judge may order that the person be permitted to examine anything so detained` `s 490(15) a judge as defined in section 552` TRUE TRUE 3 FALSE EQUALS JUST TRUE
#ASSERT `s 490(15) the judge may order that the person be permitted to examine anything so detained` `s 490(15) a provincial court judge` TRUE TRUE 3 FALSE EQUALS JUST TRUE
#ASSERT `s 490(15) the judge may order that the person be permitted to examine anything so detained` `s 490(15) someone else` TRUE TRUE 3 FALSE EQUALS NOTHING
#ASSERT `s 490(15) the judge may order that the person be permitted to examine anything so detained` `s 490(15) a provincial court judge` FALSE TRUE 3 FALSE EQUALS JUST FALSE
#ASSERT `s 490(15) the judge may order that the person be permitted to examine anything so detained` `s 490(15) a provincial court judge` TRUE FALSE 3 FALSE EQUALS JUST FALSE
#ASSERT `s 490(15) the judge may order that the person be permitted to examine anything so detained` `s 490(15) a provincial court judge` TRUE TRUE 2 FALSE EQUALS JUST FALSE
#ASSERT `s 490(15) the judge may order that the person be permitted to examine anything so detained` `s 490(15) a provincial court judge` TRUE TRUE 2 TRUE EQUALS JUST TRUE
#ASSERT `s 490(16) the order shall be made on terms necessary or desirable to ensure that anything is safeguarded and preserved for any purpose for which it may subsequently be required` TRUE EQUALS JUST TRUE
#ASSERT `s 490(16) the order shall be made on terms necessary or desirable to ensure that anything is safeguarded and preserved for any purpose for which it may subsequently be required` FALSE EQUALS NOTHING
-- (17): the appeal lies to the court of appeal if the order was made by a superior court judge, otherwise to the appeal court of section 812
#ASSERT `s 490(17) the court to which the person aggrieved may appeal` TRUE `s 490(17) an order made under subsection (8)` TRUE EQUALS JUST `s 490(17)(a) the court of appeal as defined in section 673, sections 678 to 689 applying with any modifications that the circumstances require`
#ASSERT `s 490(17) the court to which the person aggrieved may appeal` TRUE `s 490(17) an order made under subsection (9)` TRUE EQUALS JUST `s 490(17)(a) the court of appeal as defined in section 673, sections 678 to 689 applying with any modifications that the circumstances require`
#ASSERT `s 490(17) the court to which the person aggrieved may appeal` TRUE `s 490(17) an order made under subsection (9.1)` FALSE EQUALS JUST `s 490(17)(b) the appeal court as defined in section 812, sections 813 to 828 applying with any modifications that the circumstances require`
#ASSERT `s 490(17) the court to which the person aggrieved may appeal` TRUE `s 490(17) an order made under subsection (11)` FALSE EQUALS JUST `s 490(17)(b) the appeal court as defined in section 812, sections 813 to 828 applying with any modifications that the circumstances require`
#ASSERT `s 490(17) the court to which the person aggrieved may appeal` TRUE `s 490(17) another order` TRUE EQUALS NOTHING
#ASSERT `s 490(17) the court to which the person aggrieved may appeal` FALSE `s 490(17) an order made under subsection (9)` TRUE EQUALS NOTHING
#ASSERT `s 490(18) the person may agree that the application be made before the expiration of the three days` TRUE EQUALS JUST TRUE
#ASSERT `s 490(18) the person may agree that the application be made before the expiration of the three days` FALSE EQUALS NOTHING
-- 490.01
#ASSERT `s 490.01(a) the person may return the thing to its lawful owner or the person lawfully entitled to possession of it` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.01(a) the person may return the thing to its lawful owner or the person lawfully entitled to possession of it` FALSE TRUE EQUALS NOTHING
#ASSERT `s 490.01(a) the person may return the thing to its lawful owner or the person lawfully entitled to possession of it` TRUE FALSE EQUALS NOTHING
#ASSERT `s 490.01(b) the person may dispose of the thing, or destroy it` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.01(b) the person may dispose of the thing, or destroy it` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 490.01(b) the person may dispose of the thing, or destroy it` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 490.01(b)(i) the proceeds of disposition` TRUE FALSE EQUALS JUST `s 490.01(b)(i) the proceeds are given to the lawful owner of the thing seized`
#ASSERT `s 490.01(b)(i) the proceeds of disposition` FALSE TRUE EQUALS JUST `s 490.01(b)(i) the proceeds are forfeited to Her Majesty`
#ASSERT `s 490.01(b)(i) the proceeds of disposition` TRUE TRUE EQUALS JUST `s 490.01(b)(i) the proceeds are forfeited to Her Majesty`
#ASSERT `s 490.01(b)(i) the proceeds of disposition` FALSE FALSE EQUALS NOTHING
