IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc24-evidence`

-- ccc24-tests-evidence.l4 -- tests for ccc24-evidence.l4 (Criminal Code ss 709 to 715.2).
-- Every expected value is written from the text of the section, row by row, before the run.  T = JUST TRUE, F = JUST FALSE, N = NOTHING.

§ `Sections 709 to 714`

-- 709(1): arguments are (a party to the proceedings, the witness is unlikely to attend, the witness is out of Canada).
#ASSERT `s 709(1) the party may apply for an order appointing a commissioner to take the evidence of the witness` TRUE TRUE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 709(1) the party may apply for an order appointing a commissioner to take the evidence of the witness` TRUE FALSE TRUE EQUALS JUST TRUE   -- (b)
#ASSERT `s 709(1) the party may apply for an order appointing a commissioner to take the evidence of the witness` TRUE FALSE FALSE EQUALS NOTHING   -- neither limb
#ASSERT `s 709(1) the party may apply for an order appointing a commissioner to take the evidence of the witness` FALSE TRUE FALSE EQUALS NOTHING   -- not a party
#ASSERT `s 709(2) the decision is deemed to have been made at the trial held in relation to the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 709(2) the decision is deemed to have been made at the trial held in relation to the proceedings` FALSE EQUALS NOTHING

`ccc24 fixture 710a` MEANS `s 710(1)(a) a judge of a superior court of the province in which the proceedings are taken`
`ccc24 fixture 710b` MEANS `s 710(1)(b) a judge of a county or district court in the territorial division in which the proceedings are taken`
`ccc24 fixture 710c` MEANS `s 710(1)(c) a provincial court judge`
`ccc24 fixture 710x` MEANS `s 710(1) another forum`

-- 710(1): arguments are (the forum, the application is under 709(1)(a), the accused is before a provincial court judge at a preliminary inquiry, the accused is to be tried by a provincial court judge).
#ASSERT `s 710(1) the application shall be made to the forum` `ccc24 fixture 710a` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 710(1) the application shall be made to the forum` `ccc24 fixture 710b` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 710(1) the application shall be made to the forum` `ccc24 fixture 710c` TRUE TRUE FALSE EQUALS JUST TRUE   -- (c)(i)
#ASSERT `s 710(1) the application shall be made to the forum` `ccc24 fixture 710c` TRUE FALSE TRUE EQUALS JUST TRUE   -- (c)(ii)
#ASSERT `s 710(1) the application shall be made to the forum` `ccc24 fixture 710c` TRUE FALSE FALSE EQUALS JUST FALSE   -- "where" neither (i) nor (ii)
#ASSERT `s 710(1) the application shall be made to the forum` `ccc24 fixture 710x` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 710(1) the application shall be made to the forum` `ccc24 fixture 710a` FALSE FALSE FALSE EQUALS NOTHING   -- not an application under 709(1)(a)
#ASSERT `s 710(2) the application may be granted on the evidence of a registered medical practitioner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 710(2) the application may be granted on the evidence of a registered medical practitioner` TRUE FALSE EQUALS NOTHING
#ASSERT `s 710(2) the application may be granted on the evidence of a registered medical practitioner` FALSE TRUE EQUALS NOTHING
-- 711: arguments are (taken by a commissioner appointed under section 710, (a) proved, (b) transcript signed, (c) notice and opportunity).
#ASSERT `s 711 the evidence may be admitted in evidence in the proceedings` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 711 the evidence may be admitted in evidence in the proceedings` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- (a) not proved
#ASSERT `s 711 the evidence may be admitted in evidence in the proceedings` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- (b) not signed
#ASSERT `s 711 the evidence may be admitted in evidence in the proceedings` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- (c) no notice or opportunity
#ASSERT `s 711 the evidence may be admitted in evidence in the proceedings` FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- "Where the evidence ... is taken by a commissioner appointed under section 710"

`ccc24 fixture 712a` MEANS `s 712(1)(a) a judge of a superior court of criminal jurisdiction or of a court of criminal jurisdiction before which the accused is to be tried`
`ccc24 fixture 712b` MEANS `s 712(1)(b) a provincial court judge`
`ccc24 fixture 712x` MEANS `s 712(1) another forum`

#ASSERT `s 712(1) the application shall be made to the forum` `ccc24 fixture 712a` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 712(1) the application shall be made to the forum` `ccc24 fixture 712b` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 712(1) the application shall be made to the forum` `ccc24 fixture 712b` TRUE FALSE EQUALS JUST FALSE   -- "where the accused or defendant is to be tried by a provincial court judge"
#ASSERT `s 712(1) the application shall be made to the forum` `ccc24 fixture 712x` TRUE TRUE EQUALS NOTHING
#ASSERT `s 712(1) the application shall be made to the forum` `ccc24 fixture 712a` FALSE FALSE EQUALS NOTHING
#ASSERT `s 712(2) the evidence may be admitted in evidence in the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 712(2) the evidence may be admitted in evidence in the proceedings` FALSE EQUALS JUST FALSE
#ASSERT `s 713(1) the judge or provincial court judge who appoints a commissioner may make provision in the order to enable the accused to be present or represented by counsel when the evidence is taken` TRUE EQUALS JUST TRUE
#ASSERT `s 713(1) the judge or provincial court judge who appoints a commissioner may make provision in the order to enable the accused to be present or represented by counsel when the evidence is taken` FALSE EQUALS NOTHING
#ASSERT `s 713(1) the failure of the accused to be present or represented prevents the admission of the evidence in the proceedings` TRUE TRUE EQUALS JUST FALSE   -- "does not prevent"
#ASSERT `s 713(1) the failure of the accused to be present or represented prevents the admission of the evidence in the proceedings` TRUE FALSE EQUALS NOTHING   -- the evidence was not otherwise taken in accordance with the order and the Part
#ASSERT `s 713(1) the failure of the accused to be present or represented prevents the admission of the evidence in the proceedings` FALSE TRUE EQUALS NOTHING
#ASSERT `s 713(2) the order for the taking of evidence by commission indicates the officer of the court to whom the evidence that is taken shall be returned` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 713(2) the order for the taking of evidence by commission indicates the officer of the court to whom the evidence that is taken shall be returned` TRUE FALSE EQUALS NOTHING
#ASSERT `s 713(2) the order for the taking of evidence by commission indicates the officer of the court to whom the evidence that is taken shall be returned` FALSE TRUE EQUALS NOTHING
#ASSERT `s 713.1 the evidence is excluded by reason only that it would have been taken differently in Canada` TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- "shall not be excluded ... provided that"
#ASSERT `s 713.1 the evidence is excluded by reason only that it would have been taken differently in Canada` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- the proviso is not met
#ASSERT `s 713.1 the evidence is excluded by reason only that it would have been taken differently in Canada` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 713.1 the evidence is excluded by reason only that it would have been taken differently in Canada` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 714 the practice and procedure are as far as possible the same as in like matters in civil proceedings in the superior court of the province` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 714 the practice and procedure are as far as possible the same as in like matters in civil proceedings in the superior court of the province` TRUE TRUE EQUALS JUST FALSE   -- "Except where otherwise provided"
#ASSERT `s 714 the practice and procedure are as far as possible the same as in like matters in civil proceedings in the superior court of the province` FALSE FALSE EQUALS NOTHING

`ccc24 fixture 714a` MEANS `s 714.1(a) the location and personal circumstances of the witness`
`ccc24 fixture 714g` MEANS `s 714.1(g) any potential prejudice to the parties caused by the fact that the witness would not be seen by them, if the court were to order the evidence to be given by audioconference`
`ccc24 fixture 714x` MEANS `s 714.1 another circumstance`

#ASSERT `s 714.1 the court is to have regard to the circumstance in forming its opinion` `ccc24 fixture 714a` EQUALS JUST TRUE
#ASSERT `s 714.1 the court is to have regard to the circumstance in forming its opinion` `ccc24 fixture 714g` EQUALS JUST TRUE
#ASSERT `s 714.1 the court is to have regard to the circumstance in forming its opinion` `ccc24 fixture 714x` EQUALS JUST TRUE   -- "all the circumstances, including"
#ASSERT `s 714.1 the court may order that the witness give evidence by audioconference or videoconference` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 714.1 the court may order that the witness give evidence by audioconference or videoconference` TRUE FALSE EQUALS NOTHING
#ASSERT `s 714.1 the court may order that the witness give evidence by audioconference or videoconference` FALSE TRUE EQUALS NOTHING
#ASSERT `s 714.2(1) the court shall receive the evidence given by the witness by videoconference` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 714.2(1) the court shall receive the evidence given by the witness by videoconference` TRUE TRUE EQUALS JUST FALSE   -- "unless one of the parties satisfies the court"
#ASSERT `s 714.2(1) the court shall receive the evidence given by the witness by videoconference` FALSE FALSE EQUALS NOTHING
-- 714.2(2): arguments are (the party wishes to call the witness, notice has been given, the days before the testimony at which it was or would be given).
#ASSERT `s 714.2(2) the party gave the notice in time` TRUE TRUE 10 EQUALS JUST TRUE   -- exactly ten days is "not less than 10"
#ASSERT `s 714.2(2) the party gave the notice in time` TRUE TRUE 30 EQUALS JUST TRUE
#ASSERT `s 714.2(2) the party gave the notice in time` TRUE TRUE 9 EQUALS JUST FALSE
#ASSERT `s 714.2(2) the party gave the notice in time` TRUE FALSE 9 EQUALS JUST FALSE   -- a period the text fixes
#ASSERT `s 714.2(2) the party gave the notice in time` TRUE FALSE 20 EQUALS NOTHING   -- not yet given, and still time
#ASSERT `s 714.2(2) the party gave the notice in time` FALSE TRUE 5 EQUALS NOTHING
#ASSERT `s 714.3 the court may receive evidence given by the witness outside Canada by audioconference` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 714.3 the court may receive evidence given by the witness outside Canada by audioconference` TRUE FALSE EQUALS NOTHING
#ASSERT `s 714.3 the court may receive evidence given by the witness outside Canada by audioconference` FALSE TRUE EQUALS NOTHING
#ASSERT `s 714.4 the court shall include in the record a statement of the reasons for not doing so` TRUE EQUALS JUST TRUE
#ASSERT `s 714.4 the court shall include in the record a statement of the reasons for not doing so` FALSE EQUALS JUST FALSE
#ASSERT `s 714.41 the court may, at any time, cease the use of the technological means and take any measure that the court considers appropriate in the circumstances to have the witness give evidence` TRUE EQUALS JUST TRUE
#ASSERT `s 714.41 the court may, at any time, cease the use of the technological means and take any measure that the court considers appropriate in the circumstances to have the witness give evidence` FALSE EQUALS NOTHING

`ccc24 fixture 7145a` MEANS `s 714.5(a) under oath or affirmation in accordance with Canadian law`
`ccc24 fixture 7145b` MEANS `s 714.5(b) under oath or affirmation in accordance with the law in the place where the witness is physically present`
`ccc24 fixture 7145c` MEANS `s 714.5(c) in any other manner that demonstrates that the witness understands that they must tell the truth`
`ccc24 fixture 7145x` MEANS `s 714.5 another manner`

#ASSERT `s 714.5 the evidence shall be given in the manner` `ccc24 fixture 7145a` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 714.5 the evidence shall be given in the manner` `ccc24 fixture 7145b` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 714.5 the evidence shall be given in the manner` `ccc24 fixture 7145c` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 714.5 the evidence shall be given in the manner` `ccc24 fixture 7145c` TRUE FALSE EQUALS NOTHING   -- a manner that does not demonstrate the understanding
#ASSERT `s 714.5 the evidence shall be given in the manner` `ccc24 fixture 7145x` TRUE TRUE EQUALS NOTHING
#ASSERT `s 714.5 the evidence shall be given in the manner` `ccc24 fixture 7145a` FALSE FALSE EQUALS NOTHING
#ASSERT `s 714.6 the evidence is deemed to be given in Canada, and given under oath or affirmation in accordance with Canadian law, for the purposes of the laws relating to evidence, procedure, perjury and contempt of court` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 714.6 the evidence is deemed to be given in Canada, and given under oath or affirmation in accordance with Canadian law, for the purposes of the laws relating to evidence, procedure, perjury and contempt of court` TRUE FALSE EQUALS NOTHING
#ASSERT `s 714.6 the evidence is deemed to be given in Canada, and given under oath or affirmation in accordance with Canadian law, for the purposes of the laws relating to evidence, procedure, perjury and contempt of court` FALSE TRUE EQUALS NOTHING
#ASSERT `s 714.7 the party shall pay the costs associated with the use of the technology` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 714.7 the party shall pay the costs associated with the use of the technology` TRUE TRUE EQUALS JUST FALSE   -- "Unless the court orders otherwise"
#ASSERT `s 714.7 the party shall pay the costs associated with the use of the technology` FALSE FALSE EQUALS NOTHING
#ASSERT `s 714.8 sections 714.1 to 714.7 prevent the court from receiving evidence by audioconference or videoconference` TRUE EQUALS JUST FALSE   -- "if the parties so consent"
#ASSERT `s 714.8 sections 714.1 to 714.7 prevent the court from receiving evidence by audioconference or videoconference` FALSE EQUALS NOTHING

§ `Sections 715 and 715.01`

-- 715(1): arguments are (the earlier evidence, the person refuses to be sworn or to give evidence, facts proved on oath of death, insanity, illness or absence, taken in the presence of the accused, the accused proves no full opportunity).
#ASSERT `s 715(1) the evidence may be admitted as evidence in the proceedings without further proof` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- the person refuses to give evidence
#ASSERT `s 715(1) the evidence may be admitted as evidence in the proceedings without further proof` TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE   -- the person is dead or otherwise unavailable
#ASSERT `s 715(1) the evidence may be admitted as evidence in the proceedings without further proof` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 715(1) the evidence may be admitted as evidence in the proceedings without further proof` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE   -- no trigger: "Where, at the trial of an accused, a person ... refuses"
#ASSERT `s 715(1) the evidence may be admitted as evidence in the proceedings without further proof` FALSE TRUE FALSE TRUE FALSE EQUALS JUST FALSE   -- no earlier evidence
#ASSERT `s 715(1) the evidence may be admitted as evidence in the proceedings without further proof` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- not taken in the presence of the accused
#ASSERT `s 715(1) the evidence may be admitted as evidence in the proceedings without further proof` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- "unless the accused proves ... did not have full opportunity to cross-examine"
#ASSERT `s 715(2) the evidence may be admitted as evidence in the prosecution of the accused for any other offence` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715(2) the evidence may be admitted as evidence in the prosecution of the accused for any other offence` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 715(2) the evidence may be admitted as evidence in the prosecution of the accused for any other offence` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 715(2) the evidence may be admitted as evidence in the prosecution of the accused for any other offence` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 715(2.1) the evidence taken at a preliminary inquiry in the absence of the accused may be admitted as evidence for the purposes referred to in subsections (1) and (2)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715(2.1) the evidence taken at a preliminary inquiry in the absence of the accused may be admitted as evidence for the purposes referred to in subsections (1) and (2)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 715(2.1) the evidence taken at a preliminary inquiry in the absence of the accused may be admitted as evidence for the purposes referred to in subsections (1) and (2)` FALSE TRUE EQUALS NOTHING
#ASSERT `s 715(3) the accused is deemed to have been present during the taking of the evidence and to have had full opportunity to cross-examine the witness` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715(3) the accused is deemed to have been present during the taking of the evidence and to have had full opportunity to cross-examine the witness` TRUE FALSE EQUALS NOTHING
#ASSERT `s 715(3) the accused is deemed to have been present during the taking of the evidence and to have had full opportunity to cross-examine the witness` FALSE TRUE EQUALS NOTHING
#ASSERT `s 715(4) subsections 715(1) to (3) apply to the evidence` TRUE EQUALS JUST FALSE   -- "do not apply"
#ASSERT `s 715(4) subsections 715(1) to (3) apply to the evidence` FALSE EQUALS NOTHING
#ASSERT `s 715.01(1) the transcript of testimony given by a police officer in the presence of the accused during a voir dire or preliminary inquiry may be received in evidence at the trial` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.01(1) the transcript of testimony given by a police officer in the presence of the accused during a voir dire or preliminary inquiry may be received in evidence at the trial` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 715.01(1) the transcript of testimony given by a police officer in the presence of the accused during a voir dire or preliminary inquiry may be received in evidence at the trial` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 715.01(1) the transcript of testimony given by a police officer in the presence of the accused during a voir dire or preliminary inquiry may be received in evidence at the trial` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 715.01(2) the bar on receiving the transcript in evidence applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 715.01(2) the bar on receiving the transcript in evidence applies` TRUE TRUE EQUALS JUST FALSE   -- "unless the party ... has given ... reasonable notice"
#ASSERT `s 715.01(2) the bar on receiving the transcript in evidence applies` FALSE FALSE EQUALS NOTHING
#ASSERT `s 715.01(3) the court may require the attendance of the police officer for the purposes of examination or cross-examination` TRUE EQUALS JUST TRUE
#ASSERT `s 715.01(3) the court may require the attendance of the police officer for the purposes of examination or cross-examination` FALSE EQUALS NOTHING
#ASSERT `s 715.01(4) the evidence taken at a preliminary inquiry in the absence of the accused may be received in evidence for the purposes referred to in subsection (1)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.01(4) the evidence taken at a preliminary inquiry in the absence of the accused may be received in evidence for the purposes referred to in subsection (1)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 715.01(4) the evidence taken at a preliminary inquiry in the absence of the accused may be received in evidence for the purposes referred to in subsection (1)` FALSE TRUE EQUALS NOTHING
#ASSERT `s 715.01(5) the accused is deemed to have been present during the taking of the evidence and to have had full opportunity to cross-examine the witness` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.01(5) the accused is deemed to have been present during the taking of the evidence and to have had full opportunity to cross-examine the witness` TRUE FALSE EQUALS NOTHING
#ASSERT `s 715.01(5) the accused is deemed to have been present during the taking of the evidence and to have had full opportunity to cross-examine the witness` FALSE TRUE EQUALS NOTHING
#ASSERT `s 715.01(6) section 715.01 applies to the evidence` TRUE EQUALS JUST FALSE   -- "does not apply"
#ASSERT `s 715.01(6) section 715.01 applies to the evidence` FALSE EQUALS NOTHING

§ `Sections 715.1 and 715.2`

-- 715.1(1): arguments are (a proceeding against an accused with a victim or witness under eighteen, a recording made in a reasonable time that describes the acts, the victim or witness adopts it, the judge's opinion that admission would interfere).
#ASSERT `s 715.1(1) the video recording is admissible in evidence` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 715.1(1) the video recording is admissible in evidence` TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- "if the victim or witness, while testifying, adopts the contents"
#ASSERT `s 715.1(1) the video recording is admissible in evidence` TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- "unless the presiding judge or justice is of the opinion"
#ASSERT `s 715.1(1) the video recording is admissible in evidence` FALSE TRUE TRUE FALSE EQUALS NOTHING   -- the witness was not under eighteen
#ASSERT `s 715.1(1) the video recording is admissible in evidence` TRUE FALSE TRUE FALSE EQUALS NOTHING   -- a recording not made in a reasonable time
#ASSERT `s 715.1(2) the presiding judge or justice may prohibit any other use of the video recording` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.1(2) the presiding judge or justice may prohibit any other use of the video recording` TRUE FALSE EQUALS NOTHING
#ASSERT `s 715.1(2) the presiding judge or justice may prohibit any other use of the video recording` FALSE TRUE EQUALS NOTHING
#ASSERT `s 715.2(1) the video recording is admissible in evidence` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 715.2(1) the video recording is admissible in evidence` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 715.2(1) the video recording is admissible in evidence` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 715.2(1) the video recording is admissible in evidence` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 715.2(1) the video recording is admissible in evidence` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 715.2(2) the presiding judge or justice may prohibit any other use of the video recording` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.2(2) the presiding judge or justice may prohibit any other use of the video recording` TRUE FALSE EQUALS NOTHING
#ASSERT `s 715.2(2) the presiding judge or justice may prohibit any other use of the video recording` FALSE TRUE EQUALS NOTHING
