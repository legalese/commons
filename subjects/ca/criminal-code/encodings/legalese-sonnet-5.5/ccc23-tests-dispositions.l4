IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc23-dispositions`

-- ccc23-tests-dispositions.l4 -- tests for sections 672.54 to 672.63. Expected values are written from the text, never copied from the code.

§ `s 672.5401 and s 672.54`
-- 672.5401 args: a risk of serious physical or psychological harm to members of the public; the harm results from conduct that is criminal in nature (not necessarily violent)
#ASSERT `s 672.5401 significant threat to the safety of the public` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.5401 significant threat to the safety of the public` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.5401 significant threat to the safety of the public` FALSE TRUE EQUALS JUST FALSE
-- 672.54 args: the court or Review Board is making a disposition under one of the listed provisions
#ASSERT `s 672.54 the court or Review Board must make one of the dispositions` TRUE EQUALS JUST TRUE
#ASSERT `s 672.54 the court or Review Board must make one of the dispositions` FALSE EQUALS JUST FALSE
-- (a) args: NCR verdict; significant threat in the court's opinion (by s 672.5401)
#ASSERT `s 672.54(a) the court or Review Board may direct that the accused be discharged absolutely` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 672.54(a) the court or Review Board may direct that the accused be discharged absolutely` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 672.54(a) the court or Review Board may direct that the accused be discharged absolutely` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 672.54(a) the court or Review Board may direct that the accused be discharged absolutely` TRUE NOTHING EQUALS NOTHING
-- (b), (c)
#ASSERT `s 672.54(b) the court or Review Board may direct that the accused be discharged subject to conditions` TRUE EQUALS JUST TRUE
#ASSERT `s 672.54(b) the court or Review Board may direct that the accused be discharged subject to conditions` FALSE EQUALS NOTHING
#ASSERT `s 672.54(c) the court or Review Board may direct that the accused be detained in custody in a hospital` TRUE EQUALS JUST TRUE
#ASSERT `s 672.54(c) the court or Review Board may direct that the accused be detained in custody in a hospital` FALSE EQUALS NOTHING
-- the dispositions that are open. args: disposition under a listed provision; NCR verdict; significant threat (by s 672.5401)
#ASSERT `s 672.54 the dispositions that are open` TRUE TRUE (JUST FALSE) EQUALS LIST `s 672.54(a) a discharge absolutely`, `s 672.54(b) a discharge subject to conditions`, `s 672.54(c) detention in custody in a hospital, subject to conditions`
#ASSERT `s 672.54 the dispositions that are open` TRUE TRUE (JUST TRUE) EQUALS LIST `s 672.54(b) a discharge subject to conditions`, `s 672.54(c) detention in custody in a hospital, subject to conditions`
#ASSERT `s 672.54 the dispositions that are open` TRUE FALSE (JUST FALSE) EQUALS LIST `s 672.54(b) a discharge subject to conditions`, `s 672.54(c) detention in custody in a hospital, subject to conditions`
#ASSERT `s 672.54 the dispositions that are open` TRUE TRUE NOTHING EQUALS LIST `s 672.54(b) a discharge subject to conditions`, `s 672.54(c) detention in custody in a hospital, subject to conditions`
#ASSERT `s 672.54 the dispositions that are open` FALSE TRUE (JUST FALSE) EQUALS EMPTY
-- 672.541 args: NCR verdict; a victim statement filed; (a) hearing for the disposition; (b) hearing for the high-risk finding; (c) hearing to refer a high-risk finding; relevant to the criteria
#ASSERT `s 672.541 the court or Review Board must take the victim’s statement into consideration` TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.541 the court or Review Board must take the victim’s statement into consideration` TRUE TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.541 the court or Review Board must take the victim’s statement into consideration` TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.541 the court or Review Board must take the victim’s statement into consideration` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.541 the court or Review Board must take the victim’s statement into consideration` TRUE FALSE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.541 the court or Review Board must take the victim’s statement into consideration` FALSE TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.541 the court or Review Board must take the victim’s statement into consideration` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- 672.542
#ASSERT `s 672.542 the court or Review Board must consider whether to include a safety and security condition in the disposition` TRUE EQUALS JUST TRUE
#ASSERT `s 672.542 the court or Review Board must consider whether to include a safety and security condition in the disposition` FALSE EQUALS JUST FALSE
#ASSERT `s 672.542 the condition is one the court or Review Board must consider` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.542 the condition is one the court or Review Board must consider` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.542 the condition is one the court or Review Board must consider` FALSE FALSE EQUALS NOTHING

§ `ss 672.55 to 672.57`
-- 672.55(1) args: the disposition directs treatment or submission to it; the accused has consented to the condition; the court or Review Board considers it reasonable and necessary
#ASSERT `s 672.55(1) the section bars the disposition from directing treatment` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.55(1) the section bars the disposition from directing treatment` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.55(1) the section bars the disposition from directing treatment` TRUE FALSE TRUE EQUALS JUST TRUE
-- the text's own exception: consent and reasonable and necessary
#ASSERT `s 672.55(1) the section bars the disposition from directing treatment` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.55(1) the section bars the disposition from directing treatment` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.55(2) as the text shows it` EQUALS "(2) [Repealed, 2005, c. 22, s. 22]"
-- 672.56(1)
#ASSERT `s 672.56(1) the Review Board may delegate to the person in charge of the hospital authority to direct that the restrictions on liberty be increased or decreased` TRUE EQUALS JUST TRUE
#ASSERT `s 672.56(1) the Review Board may delegate to the person in charge of the hospital authority to direct that the restrictions on liberty be increased or decreased` FALSE EQUALS NOTHING
#ASSERT `s 672.56(1) the direction is deemed to be a disposition made by the Review Board` TRUE EQUALS JUST TRUE
#ASSERT `s 672.56(1) the direction is deemed to be a disposition made by the Review Board` FALSE EQUALS NOTHING
#ASSERT `s 672.56(1.1) any direction is subject to the restrictions set out in subsection 672.64(3)` TRUE EQUALS JUST TRUE
#ASSERT `s 672.56(1.1) any direction is subject to the restrictions set out in subsection 672.64(3)` FALSE EQUALS NOTHING
-- 672.56(2) args: the person significantly increases the restrictions; (b) days for which they remain in force (over seven days: notice to the Review Board too)
#ASSERT `s 672.56(2) the person must make a record and give notice of the increase to the accused as soon as is practicable` TRUE EQUALS JUST TRUE
#ASSERT `s 672.56(2) the person must make a record and give notice of the increase to the accused as soon as is practicable` FALSE EQUALS JUST FALSE
#ASSERT `s 672.56(2)(b) the person must also give notice of the increase to the Review Board` TRUE 8 EQUALS JUST TRUE
#ASSERT `s 672.56(2)(b) the person must also give notice of the increase to the Review Board` TRUE 7 EQUALS JUST FALSE
#ASSERT `s 672.56(2)(b) the person must also give notice of the increase to the Review Board` FALSE 30 EQUALS JUST FALSE
-- 672.57
#ASSERT `s 672.57 the court or Review Board must issue a warrant of committal of the accused` TRUE EQUALS JUST TRUE
#ASSERT `s 672.57 the court or Review Board must issue a warrant of committal of the accused` FALSE EQUALS JUST FALSE

§ `ss 672.58 to 672.62`
-- 672.58 args: verdict of unfit rendered; no 672.54 disposition; the prosecutor applies; days of the specified period (not exceeding sixty)
#ASSERT `s 672.58 the court may direct that treatment of the accused be carried out` TRUE TRUE TRUE 60 EQUALS JUST TRUE
#ASSERT `s 672.58 the court may direct that treatment of the accused be carried out` TRUE TRUE TRUE 61 EQUALS JUST FALSE
#ASSERT `s 672.58 the court may direct that treatment of the accused be carried out` FALSE TRUE TRUE 30 EQUALS JUST FALSE
#ASSERT `s 672.58 the court may direct that treatment of the accused be carried out` TRUE FALSE TRUE 30 EQUALS JUST FALSE
#ASSERT `s 672.58 the court may direct that treatment of the accused be carried out` TRUE TRUE FALSE 30 EQUALS JUST FALSE
-- 672.59(1): the bar lifts when the court is satisfied on a medical practitioner's testimony
#ASSERT `s 672.59(1) the court is barred from making a disposition under section 672.58` FALSE EQUALS JUST TRUE
#ASSERT `s 672.59(1) the court is barred from making a disposition under section 672.58` TRUE EQUALS JUST FALSE
-- 672.59(2) args: assessment made; (a); (b); (c); (d)
#ASSERT `s 672.59(2) the testimony includes the statement the subsection requires` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.59(2) the testimony includes the statement the subsection requires` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.59(2) the testimony includes the statement the subsection requires` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.59(2) the testimony includes the statement the subsection requires` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.59(2) the testimony includes the statement the subsection requires` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.59(2) the testimony includes the statement the subsection requires` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- 672.6
#ASSERT `s 672.6(1) the court is barred from making a disposition under section 672.58` FALSE EQUALS JUST TRUE
#ASSERT `s 672.6(1) the court is barred from making a disposition under section 672.58` TRUE EQUALS JUST FALSE
#ASSERT `s 672.6(2) the accused may challenge the application and adduce evidence for that purpose` TRUE EQUALS JUST TRUE
#ASSERT `s 672.6(2) the accused may challenge the application and adduce evidence for that purpose` FALSE EQUALS JUST FALSE
-- 672.61(2) definitions
#ASSERT `s 672.61(2) electro-convulsive therapy` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.61(2) electro-convulsive therapy` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.61(2) electro-convulsive therapy` FALSE TRUE EQUALS JUST FALSE
-- psychosurgery args: removes, destroys or interrupts brain tissue or inserts electrodes for altering behaviour or treating psychiatric illness; is a neurological procedure for pain, organic brain conditions or epilepsy clearly demonstrable
#ASSERT `s 672.61(2) psychosurgery` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.61(2) psychosurgery` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.61(2) psychosurgery` FALSE FALSE EQUALS JUST FALSE
-- 672.61(1) args: psychosurgery (by (2)); electro-convulsive therapy (by (2)); another prohibited treatment that is prescribed (by s 672.1(1) prescribed)
#ASSERT `s 672.61(1) the section bars psychosurgery, electro-convulsive therapy or another prescribed prohibited treatment` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 672.61(1) the section bars psychosurgery, electro-convulsive therapy or another prescribed prohibited treatment` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 672.61(1) the section bars psychosurgery, electro-convulsive therapy or another prescribed prohibited treatment` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 672.61(1) the section bars psychosurgery, electro-convulsive therapy or another prescribed prohibited treatment` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 672.61(1) the section bars psychosurgery, electro-convulsive therapy or another prescribed prohibited treatment` NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING
-- 672.62(1) args: the hospital's person in charge consents; the person to whom responsibility is assigned consents. "without the consent" limits the bar.
#ASSERT `s 672.62(1) the court is barred from making a disposition under section 672.58 without consent` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.62(1) the court is barred from making a disposition under section 672.58 without consent` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.62(1) the court is barred from making a disposition under section 672.58 without consent` FALSE TRUE EQUALS NOTHING
#ASSERT `s 672.62(2) the court may direct that treatment be carried out without the consent of the accused` TRUE EQUALS JUST TRUE
#ASSERT `s 672.62(2) the court may direct that treatment be carried out without the consent of the accused` FALSE EQUALS NOTHING

§ `s 672.63 -- effective date`
-- args: day made; later day specified; day of the Review Board's later disposition; the day asked about
#ASSERT `s 672.63 the disposition is in force on the day` (Date 1 3 2026) NOTHING NOTHING (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 672.63 the disposition is in force on the day` (Date 1 3 2026) NOTHING NOTHING (Date 28 2 2026) EQUALS JUST FALSE
#ASSERT `s 672.63 the disposition is in force on the day` (Date 1 3 2026) (JUST (Date 10 3 2026)) NOTHING (Date 9 3 2026) EQUALS JUST FALSE
#ASSERT `s 672.63 the disposition is in force on the day` (Date 1 3 2026) (JUST (Date 10 3 2026)) NOTHING (Date 10 3 2026) EQUALS JUST TRUE
-- it remains in force until the Review Board makes another disposition on 1 March 2027
#ASSERT `s 672.63 the disposition is in force on the day` (Date 1 3 2026) NOTHING (JUST (Date 1 3 2027)) (Date 28 2 2027) EQUALS JUST TRUE
#ASSERT `s 672.63 the disposition is in force on the day` (Date 1 3 2026) NOTHING (JUST (Date 1 3 2027)) (Date 1 3 2027) EQUALS JUST FALSE
