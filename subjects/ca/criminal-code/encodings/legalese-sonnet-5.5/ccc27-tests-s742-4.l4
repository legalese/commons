IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc27-s742-4-breach-and-transfer`

-- ccc27-tests-s742-4.l4 -- tests for sections 742.4 to 742.7. Every expected value is written from the text, beside the assertion.

§ `Tests -- section 742.4`

-- (1): the supervisor shall notify the offender, the prosecutor and the court, where of the opinion
#ASSERT `s 742.4(1) the supervisor shall give written notification of the proposed change, and the reasons for it, to the recipient` `s 742.4(1) the offender` TRUE EQUALS JUST TRUE
#ASSERT `s 742.4(1) the supervisor shall give written notification of the proposed change, and the reasons for it, to the recipient` `s 742.4(1) the prosecutor` TRUE EQUALS JUST TRUE
#ASSERT `s 742.4(1) the supervisor shall give written notification of the proposed change, and the reasons for it, to the recipient` `s 742.4(1) the court` TRUE EQUALS JUST TRUE
#ASSERT `s 742.4(1) the supervisor shall give written notification of the proposed change, and the reasons for it, to the recipient` `s 742.4(1) someone else` TRUE EQUALS NOTHING   -- the list is not closed
#ASSERT `s 742.4(1) the supervisor shall give written notification of the proposed change, and the reasons for it, to the recipient` `s 742.4(1) the offender` FALSE EQUALS JUST FALSE   -- the supervisor is not of the opinion

-- (2): within seven days
#ASSERT `s 742.4(2)(a) the requester may request the court to hold a hearing to consider the proposed change` `s 742.4(2)(a) the offender` 7 EQUALS JUST TRUE   -- the seventh day
#ASSERT `s 742.4(2)(a) the requester may request the court to hold a hearing to consider the proposed change` `s 742.4(2)(a) the prosecutor` 3 EQUALS JUST TRUE
#ASSERT `s 742.4(2)(a) the requester may request the court to hold a hearing to consider the proposed change` `s 742.4(2)(a) the offender` 8 EQUALS JUST FALSE   -- the eighth day: outside "within seven days"
#ASSERT `s 742.4(2)(a) the requester may request the court to hold a hearing to consider the proposed change` `s 742.4(2)(a) someone else` 3 EQUALS NOTHING   -- "the offender or the prosecutor"
#ASSERT `s 742.4(2)(b) the court may, of its own initiative, order that a hearing be held to consider the proposed change` 7 EQUALS JUST TRUE
#ASSERT `s 742.4(2)(b) the court may, of its own initiative, order that a hearing be held to consider the proposed change` 8 EQUALS JUST FALSE
#ASSERT `s 742.4(2) a hearing so requested or ordered is held in time` 30 EQUALS JUST TRUE   -- the thirtieth day
#ASSERT `s 742.4(2) a hearing so requested or ordered is held in time` 31 EQUALS JUST FALSE
#TRACE `s 742.4(2) the court shall hold the hearing so requested or ordered` AT 0 WITH
    PARTY `the court` DOES `s 742.4(2) hold the hearing` AT 30
#TRACE `s 742.4(2) the court shall hold the hearing so requested or ordered` AT 0 WITH
    PARTY `the court` DOES `s 742.4(2) hold the hearing` AT 31

-- (3)
#ASSERT `s 742.4(3)(a) the court shall approve or refuse to approve the proposed change` TRUE EQUALS JUST TRUE
#ASSERT `s 742.4(3)(a) the court shall approve or refuse to approve the proposed change` FALSE EQUALS JUST FALSE   -- no hearing
#ASSERT `s 742.4(3)(b) the court may make any other change to the optional conditions that the court deems appropriate` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 742.4(3)(b) the court may make any other change to the optional conditions that the court deems appropriate` TRUE TRUE FALSE EQUALS NOTHING   -- the court does not deem it appropriate
#ASSERT `s 742.4(3)(b) the court may make any other change to the optional conditions that the court deems appropriate` TRUE FALSE TRUE EQUALS NOTHING   -- not a change to the optional conditions
#ASSERT `s 742.4(3)(b) the court may make any other change to the optional conditions that the court deems appropriate` FALSE TRUE TRUE EQUALS JUST FALSE   -- no hearing under subsection (2)

-- (4): fourteen days after the receipt by the court
#ASSERT `s 742.4(4) the day the proposed change takes effect` (Date 1 3 2025) FALSE EQUALS JUST (Date 15 3 2025)
#ASSERT `s 742.4(4) the day the proposed change takes effect` (Date 25 2 2025) FALSE EQUALS JUST (Date 11 3 2025)   -- across the end of February (2025 is not a leap year)
#ASSERT `s 742.4(4) the day the proposed change takes effect` (Date 25 2 2024) FALSE EQUALS JUST (Date 10 3 2024)   -- 2024 is a leap year
#ASSERT `s 742.4(4) the day the proposed change takes effect` (Date 1 3 2025) TRUE EQUALS NOTHING   -- a hearing was requested or ordered: subsection (3) decides
#ASSERT `s 742.4(4) the supervisor shall notify the offender and file proof of that notification with the court` FALSE EQUALS JUST TRUE
#ASSERT `s 742.4(4) the supervisor shall notify the offender and file proof of that notification with the court` TRUE EQUALS JUST FALSE   -- "Where no request or order for a hearing is made"

-- (5)
#ASSERT `s 742.4(5) a hearing must be held, within thirty days after the receipt by the court of the notification` `s 742.4(5) the offender` EQUALS JUST TRUE
#ASSERT `s 742.4(5) a hearing must be held, within thirty days after the receipt by the court of the notification` `s 742.4(5) the prosecutor` EQUALS JUST TRUE
#ASSERT `s 742.4(5) a hearing must be held, within thirty days after the receipt by the court of the notification` `s 742.4(5) the supervisor` EQUALS NOTHING   -- the supervisor's proposal is under subsection (2)

-- (6)
#ASSERT `s 742.4(6) the function may be exercised in chambers` TRUE EQUALS JUST TRUE
#ASSERT `s 742.4(6) the function may be exercised in chambers` FALSE EQUALS NOTHING

§ `Tests -- section 742.5`

-- (1.1): the consents. A = province consent when the divisions are in different provinces; B = Attorney General of Canada consent when he instituted the proceedings.
#ASSERT `s 742.5(1.1) the transfer may be granted with the consents given` FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- different provinces, province consents
#ASSERT `s 742.5(1.1) the transfer may be granted with the consents given` FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- different provinces, no consent: "only with"
#ASSERT `s 742.5(1.1) the transfer may be granted with the consents given` TRUE FALSE TRUE TRUE EQUALS JUST TRUE   -- same province; instituted by the Attorney General of Canada, who consents
#ASSERT `s 742.5(1.1) the transfer may be granted with the consents given` TRUE FALSE TRUE FALSE EQUALS JUST FALSE   -- same province; instituted by the Attorney General of Canada, no consent
#ASSERT `s 742.5(1.1) the transfer may be granted with the consents given` TRUE FALSE FALSE FALSE EQUALS NOTHING   -- same province, not instituted by him: neither paragraph's case
#ASSERT `s 742.5(1.1) the transfer may be granted with the consents given` FALSE TRUE TRUE FALSE EQUALS JUST TRUE   -- both cases present; the text reads "or": the province's consent alone is enough (F-5)
#ASSERT `s 742.5(1.1) the transfer may be granted with the consents given` FALSE FALSE TRUE TRUE EQUALS JUST TRUE   -- both cases present; the Attorney General of Canada's consent alone is enough (F-5)
-- (1): args: bound by a conditional sentence order; section 2 "territorial division" answer; a supervisor has applied; the receiving court would have had jurisdiction;
-- same province; the province's Attorney General consented; instituted by the Attorney General of Canada; the Attorney General of Canada consented
#ASSERT `s 742.5(1) the court that made the order may transfer the order to a court in that other territorial division` TRUE (JUST TRUE) TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- different provinces, the province consents
#ASSERT `s 742.5(1) the court that made the order may transfer the order to a court in that other territorial division` FALSE (JUST TRUE) TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- not bound by a conditional sentence order ("Where")
#ASSERT `s 742.5(1) the court that made the order may transfer the order to a court in that other territorial division` TRUE (JUST FALSE) TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- not a resident of another territorial division
#ASSERT `s 742.5(1) the court that made the order may transfer the order to a court in that other territorial division` TRUE NOTHING TRUE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING   -- section 2 does not decide
#ASSERT `s 742.5(1) the court that made the order may transfer the order to a court in that other territorial division` TRUE (JUST TRUE) FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- no application of a supervisor ("on the application")
#ASSERT `s 742.5(1) the court that made the order may transfer the order to a court in that other territorial division` TRUE (JUST TRUE) TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- (1.1): different provinces and the province's consent is missing
#ASSERT `s 742.5(1) the court that made the order may transfer the order to a court in that other territorial division` TRUE (JUST TRUE) TRUE FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING   -- the receiving court would not have had jurisdiction (F-2)
#ASSERT `s 742.5(1) the court that made the order may transfer the order to a court in that other territorial division` TRUE (JUST TRUE) TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- same province, not instituted by the Attorney General of Canada: (1.1) names no consent for it and restricts nothing (F-12)
#ASSERT `s 742.5(1) the court that made the order may transfer the order to a court in that other territorial division` TRUE (JUST TRUE) TRUE TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE   -- same province, instituted by the Attorney General of Canada, who has not consented
#ASSERT `s 742.5(1) the court that made the order may transfer the order to a court in that other territorial division` TRUE (JUST TRUE) TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE   -- the Attorney General of Canada consented
-- (2)
#ASSERT `s 742.5(2) the powers of that court in relation to the conditional sentence order may be exercised by the other court` TRUE `s 742.5(2) a court with equivalent jurisdiction in the same province` EQUALS JUST TRUE
#ASSERT `s 742.5(2) the powers of that court in relation to the conditional sentence order may be exercised by the other court` TRUE `s 742.5(2) a court of another kind` EQUALS NOTHING
#ASSERT `s 742.5(2) the powers of that court in relation to the conditional sentence order may be exercised by the other court` FALSE `s 742.5(2) a court with equivalent jurisdiction in the same province` EQUALS JUST FALSE   -- the first court is able to act ("Where ... is for any reason unable to act")

§ `Tests -- section 742.6`

-- (1)(a) to (f)
#ASSERT `s 742.6(1)(a) the provision applies to proceedings under section 742.6, with any modifications that the circumstances require` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(1)(a) the provision applies to proceedings under section 742.6, with any modifications that the circumstances require` FALSE EQUALS NOTHING
#ASSERT `s 742.6(1)(a) the reference is read as a reference to breaching a condition of a conditional sentence order` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(1)(a) the reference is read as a reference to breaching a condition of a conditional sentence order` FALSE EQUALS NOTHING
#ASSERT `s 742.6(1)(b) subsection 495(2) applies to the arrest` TRUE EQUALS JUST FALSE   -- "does not apply"
#ASSERT `s 742.6(1)(b) subsection 495(2) applies to the arrest` FALSE EQUALS NOTHING
#ASSERT `s 742.6(1)(b) the powers of arrest are those that apply to an indictable offence` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(1)(c) the proceeding is commenced by the way` `s 742.6(1)(c)(i) the issuance of a warrant for the arrest of the offender for the alleged breach` EQUALS JUST TRUE
#ASSERT `s 742.6(1)(c) the proceeding is commenced by the way` `s 742.6(1)(c)(ii) the arrest without warrant of the offender for the alleged breach` EQUALS JUST TRUE
#ASSERT `s 742.6(1)(c) the proceeding is commenced by the way` `s 742.6(1)(c)(iii) the compelling of the offender's appearance in accordance with paragraph (d)` EQUALS JUST TRUE
#ASSERT `s 742.6(1)(c) the proceeding is commenced by the way` `s 742.6(1)(c) some other way` EQUALS NOTHING
#ASSERT `s 742.6(1)(d) the offender's appearance may be compelled under the provisions referred to in paragraph (a)` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(1)(d) the offender's appearance may be compelled under the provisions referred to in paragraph (a)` FALSE EQUALS NOTHING   -- F-2: the other reading is JUST FALSE
#ASSERT `s 742.6(1)(e) the releaser may release the offender` `s 742.6(1)(e) the peace officer who makes the arrest` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(1)(e) the releaser may release the offender` `s 742.6(1)(e) a judge` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(1)(e) the releaser may release the offender` `s 742.6(1)(e) a justice` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(1)(e) the releaser may release the offender` `s 742.6(1)(e) someone else` TRUE EQUALS NOTHING
#ASSERT `s 742.6(1)(e) the releaser may release the offender` `s 742.6(1)(e) a judge` FALSE EQUALS NOTHING   -- no arrest for the alleged breach
#ASSERT `s 742.6(1)(f) the issuer may issue a warrant to arrest, no matter which court, judge or justice sentenced the offender` `s 742.6(1)(f) a judge of a superior court of criminal jurisdiction` EQUALS JUST TRUE
#ASSERT `s 742.6(1)(f) the issuer may issue a warrant to arrest, no matter which court, judge or justice sentenced the offender` `s 742.6(1)(f) a judge of a court of criminal jurisdiction` EQUALS JUST TRUE
#ASSERT `s 742.6(1)(f) the issuer may issue a warrant to arrest, no matter which court, judge or justice sentenced the offender` `s 742.6(1)(f) a justice of the peace` EQUALS JUST TRUE
#ASSERT `s 742.6(1)(f) the issuer may issue a warrant to arrest, no matter which court, judge or justice sentenced the offender` `s 742.6(1)(f) someone else` EQUALS NOTHING
#ASSERT `s 742.6(1.1) the warrant may be issued by a means of telecommunication` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(1.1) the warrant may be issued by a means of telecommunication` FALSE EQUALS NOTHING
#ASSERT `s 742.6(2) the release from custody is governed by subsection 515(6)` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(2) the release from custody is governed by subsection 515(6)` FALSE EQUALS NOTHING

-- (3): thirty days, or as soon thereafter as is practicable
#ASSERT `s 742.6(3) the hearing of the allegation was commenced in time` 30 FALSE EQUALS JUST TRUE
#ASSERT `s 742.6(3) the hearing of the allegation was commenced in time` 31 TRUE EQUALS JUST TRUE   -- late but as soon as practicable
#ASSERT `s 742.6(3) the hearing of the allegation was commenced in time` 31 FALSE EQUALS JUST FALSE
#ASSERT `s 742.6(3.1) the allegation may be heard by the court in the place` TRUE `s 742.6(3.1) the place where the breach is alleged to have been committed` EQUALS JUST TRUE
#ASSERT `s 742.6(3.1) the allegation may be heard by the court in the place` TRUE `s 742.6(3.1) the place where the offender is found, arrested or in custody` EQUALS JUST TRUE
#ASSERT `s 742.6(3.1) the allegation may be heard by the court in the place` TRUE `s 742.6(3.1) another place` EQUALS NOTHING
#ASSERT `s 742.6(3.1) the allegation may be heard by the court in the place` FALSE `s 742.6(3.1) the place where the breach is alleged to have been committed` EQUALS NOTHING   -- a court without jurisdiction
-- (3.2): the consent bar, titled as a bar
#ASSERT `s 742.6(3.2) proceedings in that place are barred for want of consent` TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- outside the province, no consent
#ASSERT `s 742.6(3.2) proceedings in that place are barred for want of consent` TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- the province's Attorney General consented
#ASSERT `s 742.6(3.2) proceedings in that place are barred for want of consent` TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- the Attorney General of Canada instituted the proceedings and consented
#ASSERT `s 742.6(3.2) proceedings in that place are barred for want of consent` TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- the Attorney General of Canada instituted them and did not consent
#ASSERT `s 742.6(3.2) proceedings in that place are barred for want of consent` TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- the Attorney General of Canada did not institute them: his consent does not count
#ASSERT `s 742.6(3.2) proceedings in that place are barred for want of consent` FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- the place is inside the province: no bar under (3.2)
-- (3.3)
#ASSERT `s 742.6(3.3) the judge may adjourn the hearing for the period` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(3.3) the judge may adjourn the hearing for the period` TRUE FALSE EQUALS NOTHING   -- not a reasonable period
#ASSERT `s 742.6(3.3) the judge may adjourn the hearing for the period` FALSE TRUE EQUALS JUST FALSE   -- not during a hearing ("at any time during a hearing")
-- (4) and (5)
#ASSERT `s 742.6(4) the allegation of breach is supported by the written report the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(4) the allegation of breach is supported by the written report the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 742.6(4) the allegation of breach is supported by the written report the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE   -- not the supervisor's report
#ASSERT `s 742.6(4) the allegation of breach is supported by the written report the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE   -- signed statements of witnesses left out where appropriate
#ASSERT `s 742.6(5) the report is admissible in evidence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(5) the report is admissible in evidence` TRUE FALSE EQUALS JUST FALSE   -- no copy
#ASSERT `s 742.6(5) the report is admissible in evidence` FALSE TRUE EQUALS JUST FALSE   -- no reasonable notice
-- (8)
#ASSERT `s 742.6(8) the offender may require the attendance of the person for cross-examination` `s 742.6(8) the supervisor` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(8) the offender may require the attendance of the person for cross-examination` `s 742.6(8) a witness whose signed statement is included in the report` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(8) the offender may require the attendance of the person for cross-examination` `s 742.6(8) the supervisor` FALSE EQUALS NOTHING   -- no leave of the court
#ASSERT `s 742.6(8) the offender may require the attendance of the person for cross-examination` `s 742.6(8) someone else` TRUE EQUALS NOTHING
-- (9)
#ASSERT `s 742.6(9) the court may take the action` `s 742.6(9)(a) take no action` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 742.6(9) the court may take the action` `s 742.6(9)(b) change the optional conditions` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 742.6(9) the court may take the action` `s 742.6(9)(c) suspend the conditional sentence order and direct that the offender serve in custody a portion of the unexpired sentence, and that the order resume on the offender's release from custody` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 742.6(9) the court may take the action` `s 742.6(9)(d) terminate the conditional sentence order and direct that the offender be committed to custody until the expiration of the sentence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 742.6(9) the court may take the action` `s 742.6(9) another action` TRUE FALSE EQUALS NOTHING
#ASSERT `s 742.6(9) the court may take the action` `s 742.6(9)(d) terminate the conditional sentence order and direct that the offender be committed to custody until the expiration of the sentence` FALSE FALSE EQUALS JUST FALSE   -- the court is not satisfied of a breach
#ASSERT `s 742.6(9) the court may take the action` `s 742.6(9)(d) terminate the conditional sentence order and direct that the offender be committed to custody until the expiration of the sentence` TRUE TRUE EQUALS JUST FALSE   -- the offender proved a reasonable excuse
-- (10)
#ASSERT `s 742.6(10) the earlier of two dates` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 742.6(10) the earlier of two dates` (JUST (Date 5 3 2025)) NOTHING EQUALS JUST (Date 5 3 2025)
#ASSERT `s 742.6(10) the earlier of two dates` NOTHING (JUST (Date 6 3 2025)) EQUALS JUST (Date 6 3 2025)
#ASSERT `s 742.6(10) the earlier of two dates` (JUST (Date 5 3 2025)) (JUST (Date 6 3 2025)) EQUALS JUST (Date 5 3 2025)
#ASSERT `s 742.6(10) the earlier of two dates` (JUST (Date 7 3 2025)) (JUST (Date 6 3 2025)) EQUALS JUST (Date 6 3 2025)
#ASSERT `s 742.6(10) the day the suspension of the running of the conditional sentence order begins` (JUST (Date 9 3 2025)) (JUST (Date 8 3 2025)) (JUST (Date 10 3 2025)) EQUALS JUST (Date 8 3 2025)   -- the earliest of the three
#ASSERT `s 742.6(10) the day the suspension of the running of the conditional sentence order begins` NOTHING NOTHING (JUST (Date 10 3 2025)) EQUALS JUST (Date 10 3 2025)   -- only the third occurred
#ASSERT `s 742.6(10) the day the suspension of the running of the conditional sentence order begins` NOTHING NOTHING NOTHING EQUALS NOTHING   -- none occurred
#ASSERT `s 742.6(10) the running of the conditional sentence order is suspended on the day` (Date 10 3 2025) (JUST (Date 8 3 2025)) (JUST (Date 20 3 2025)) EQUALS JUST TRUE   -- inside the period
#ASSERT `s 742.6(10) the running of the conditional sentence order is suspended on the day` (Date 8 3 2025) (JUST (Date 8 3 2025)) (JUST (Date 20 3 2025)) EQUALS JUST TRUE   -- the first day
#ASSERT `s 742.6(10) the running of the conditional sentence order is suspended on the day` (Date 20 3 2025) (JUST (Date 8 3 2025)) (JUST (Date 20 3 2025)) EQUALS JUST TRUE   -- the day of the determination (F-6)
#ASSERT `s 742.6(10) the running of the conditional sentence order is suspended on the day` (Date 21 3 2025) (JUST (Date 8 3 2025)) (JUST (Date 20 3 2025)) EQUALS JUST FALSE   -- after the determination
#ASSERT `s 742.6(10) the running of the conditional sentence order is suspended on the day` (Date 7 3 2025) (JUST (Date 8 3 2025)) (JUST (Date 20 3 2025)) EQUALS JUST FALSE   -- before the period begins
#ASSERT `s 742.6(10) the running of the conditional sentence order is suspended on the day` (Date 1 6 2025) (JUST (Date 8 3 2025)) NOTHING EQUALS JUST TRUE   -- not yet determined: still suspended
#ASSERT `s 742.6(10) the running of the conditional sentence order is suspended on the day` (Date 1 6 2025) NOTHING NOTHING EQUALS NOTHING   -- nothing has begun the period
-- (11) to (13)
#ASSERT `s 742.6(11) the conditions of the order continue to apply, with any changes made to them under section 742.4` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(11) the conditions of the order continue to apply, with any changes made to them under section 742.4` FALSE EQUALS NOTHING
#ASSERT `s 742.6(11) a subsequent breach of those conditions may be dealt with in accordance with section 742.6` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(11) a subsequent breach of those conditions may be dealt with in accordance with section 742.6` FALSE EQUALS NOTHING
#ASSERT `s 742.6(12) the conditional sentence order runs on the day` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 742.6(12) the conditional sentence order runs on the day` TRUE TRUE TRUE EQUALS JUST FALSE   -- "unless section 742.7 applies"
#ASSERT `s 742.6(12) the conditional sentence order runs on the day` FALSE TRUE FALSE EQUALS NOTHING   -- no detention order yet: the suspension of subsection (10) governs
#ASSERT `s 742.6(12) the conditional sentence order runs on the day` TRUE FALSE FALSE EQUALS NOTHING   -- no longer detained under the order
#ASSERT `s 742.6(13) section 6 of the Prisons and Reformatories Act applies to the period` TRUE EQUALS JUST FALSE   -- "does not apply"
#ASSERT `s 742.6(13) section 6 of the Prisons and Reformatories Act applies to the period` FALSE EQUALS NOTHING
-- (14)
#ASSERT `s 742.6(14) the court may order that the period between the issuance and execution of the warrant is deemed to be time served` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 742.6(14) the court may order that the period between the issuance and execution of the warrant is deemed to be time served` TRUE TRUE TRUE EQUALS JUST FALSE   -- "unless the period has been so deemed under subsection (15)"
#ASSERT `s 742.6(14) the court may order that the period between the issuance and execution of the warrant is deemed to be time served` FALSE TRUE FALSE EQUALS NOTHING   -- no unreasonable delay
#ASSERT `s 742.6(14) the court may order that the period between the issuance and execution of the warrant is deemed to be time served` TRUE FALSE FALSE EQUALS NOTHING   -- the court does not consider it appropriate
-- (15): the sum of the suspended days and half of the days the order ran while detained
#ASSERT `s 742.6(15) the days deemed to be time served under the conditional sentence order` TRUE 20 FALSE 0 EQUALS JUST 20
#ASSERT `s 742.6(15) the days deemed to be time served under the conditional sentence order` TRUE 20 TRUE 10 EQUALS JUST 25   -- 20 + one half of 10
#ASSERT `s 742.6(15) the days deemed to be time served under the conditional sentence order` TRUE 0 TRUE 7 EQUALS JUST 3.5   -- one half of 7 days
#ASSERT `s 742.6(15) the days deemed to be time served under the conditional sentence order` FALSE 20 TRUE 10 EQUALS NOTHING   -- the allegation was upheld
-- (16)
#ASSERT `s 742.6(16) the court may order that some or all of the period of suspension is deemed to be time served` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(16) the court may order that some or all of the period of suspension is deemed to be time served` FALSE TRUE TRUE EQUALS NOTHING   -- the court is not satisfied of a breach without reasonable excuse (F-2)
#ASSERT `s 742.6(16) the court may order that some or all of the period of suspension is deemed to be time served` TRUE FALSE TRUE EQUALS NOTHING   -- not an exceptional case
#ASSERT `s 742.6(16) the court may order that some or all of the period of suspension is deemed to be time served` TRUE TRUE FALSE EQUALS NOTHING   -- not in the interests of justice
-- (17)
#ASSERT `s 742.6(17) the court shall consider the matter` `s 742.6(17)(a) the circumstances and seriousness of the breach` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(17) the court shall consider the matter` `s 742.6(17)(b) whether not making the order would cause the offender undue hardship based on the offender's individual circumstances` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(17) the court shall consider the matter` `s 742.6(17)(c) the period for which the offender was subject to conditions while the running of the order was suspended and whether the offender complied with those conditions during that period` TRUE EQUALS JUST TRUE
#ASSERT `s 742.6(17) the court shall consider the matter` `s 742.6(17) another matter` TRUE EQUALS NOTHING
#ASSERT `s 742.6(17) the court shall consider the matter` `s 742.6(17)(a) the circumstances and seriousness of the breach` FALSE EQUALS JUST FALSE   -- not exercising its discretion under (16)

§ `Tests -- section 742.7`

#ASSERT `s 742.7(1) the running of the conditional sentence order is suspended on the day` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 742.7(1) the running of the conditional sentence order is suspended on the day` TRUE FALSE EQUALS JUST FALSE   -- outside the period of imprisonment for the other offence
#ASSERT `s 742.7(1) the running of the conditional sentence order is suspended on the day` FALSE TRUE EQUALS JUST FALSE   -- not imprisoned for another offence
#ASSERT `s 742.7(2) the custodial period ordered shall be served consecutively to any other period of imprisonment that the offender is serving` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 742.7(2) the custodial period ordered shall be served consecutively to any other period of imprisonment that the offender is serving` TRUE TRUE EQUALS JUST FALSE   -- "unless the court considers that it would not be in the interests of justice"
#ASSERT `s 742.7(2) the custodial period ordered shall be served consecutively to any other period of imprisonment that the offender is serving` FALSE FALSE EQUALS JUST FALSE   -- no order under paragraph 742.6(9)(c) or (d)
#ASSERT `s 742.7(3) the periods are deemed to constitute one sentence of imprisonment` TRUE `s 742.7(3) the purpose of section 743.1` EQUALS JUST TRUE
#ASSERT `s 742.7(3) the periods are deemed to constitute one sentence of imprisonment` TRUE `s 742.7(3) the purpose of section 139 of the Corrections and Conditional Release Act` EQUALS JUST TRUE
#ASSERT `s 742.7(3) the periods are deemed to constitute one sentence of imprisonment` TRUE `s 742.7(3) another purpose` EQUALS NOTHING   -- "for the purpose of section 743.1 and section 139"
#ASSERT `s 742.7(3) the periods are deemed to constitute one sentence of imprisonment` FALSE `s 742.7(3) the purpose of section 743.1` EQUALS NOTHING
#ASSERT `s 742.7(4) the running of the period of the conditional sentence order that is to be served in the community resumes` `s 742.7(4) release on parole` EQUALS JUST TRUE
#ASSERT `s 742.7(4) the running of the period of the conditional sentence order that is to be served in the community resumes` `s 742.7(4) release on statutory release` EQUALS JUST TRUE
#ASSERT `s 742.7(4) the running of the period of the conditional sentence order that is to be served in the community resumes` `s 742.7(4) release on earned remission` EQUALS JUST TRUE
#ASSERT `s 742.7(4) the running of the period of the conditional sentence order that is to be served in the community resumes` `s 742.7(4) the expiration of the sentence` EQUALS JUST TRUE
#ASSERT `s 742.7(4) the running of the period of the conditional sentence order that is to be served in the community resumes` `s 742.7(4) another release` EQUALS NOTHING
