    IF NOT `it is an order in Form 11`
    THEN JUST FALSE   -- FALSE-kind (the text says no in its own words): "release order means an order in Form 11"
    ELSE IF `it was made by a judge as defined in section 493, by s 493`
         THEN JUST TRUE
         ELSE `it was made by a justice, by s 2 justice`   -- JUST TRUE; JUST FALSE ("made by a judge as defined in section 493 or a justice"); NOTHING when s 2 justice is itself not covered

