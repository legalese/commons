#ASSERT `s 241.2(5.1) the person is permitted to act as an independent witness despite paragraphs (5)(c) and (d)` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 241.2(5.1) the person is permitted to act as an independent witness despite paragraphs (5)(c) and (d)` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
