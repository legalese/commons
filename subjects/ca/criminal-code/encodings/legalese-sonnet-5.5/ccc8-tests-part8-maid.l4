IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc8-part8-maid`

-- ccc8-tests-part8-maid.l4 -- tests for ccc8-part8-maid.l4 (sections 241.1 to 241.4). Expected values are written by hand from the text.
-- The stand-in below is NOT the penalty of section 787(1) (outside this part): it states nothing, so only the limb of this part is tested.
`s 241.3 test fixture: a stand-in for the section 787(1) penalty` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `Section 241.1 -- definitions`

-- "medical assistance in dying means (a) the administering by a medical practitioner or nurse practitioner of a substance to a person, at their request, that causes their death; or (b) the prescribing or providing ... of a substance ..., at their request, so that they may self-administer"
--                                               admin  at request causes death  provides at request self-administer
#ASSERT `s 241.1 medical assistance in dying` TRUE  TRUE  TRUE  FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 241.1 medical assistance in dying` TRUE  TRUE  FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 241.1 medical assistance in dying` TRUE  FALSE TRUE  FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 241.1 medical assistance in dying` FALSE FALSE FALSE TRUE  TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `s 241.1 medical assistance in dying` FALSE FALSE FALSE TRUE  FALSE TRUE  EQUALS JUST FALSE
#ASSERT `s 241.1 medical assistance in dying` FALSE FALSE FALSE TRUE  TRUE  FALSE EQUALS JUST FALSE
#ASSERT `s 241.1 medical assistance in dying` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- "medical practitioner means a person who is entitled to practise medicine under the laws of a province"
#ASSERT `s 241.1 medical practitioner` TRUE EQUALS JUST TRUE
#ASSERT `s 241.1 medical practitioner` FALSE EQUALS JUST FALSE
-- "nurse practitioner means a registered nurse who, under the laws of a province, is entitled to practise as a nurse practitioner ... and to autonomously make diagnoses, order and interpret diagnostic tests, prescribe substances and treat patients"
#ASSERT `s 241.1 nurse practitioner` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 241.1 nurse practitioner` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 241.1 nurse practitioner` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 241.1 nurse practitioner` FALSE TRUE TRUE EQUALS JUST FALSE
-- "pharmacist means a person who is entitled to practise pharmacy under the laws of a province"
#ASSERT `s 241.1 pharmacist` TRUE EQUALS JUST TRUE
#ASSERT `s 241.1 pharmacist` FALSE EQUALS JUST FALSE

§ `Section 241.2(1) and (2) -- eligibility`

-- (2.1) "a mental illness is not considered to be an illness, disease or disability"
#ASSERT `s 241.2(2.1) a mental illness is not considered to be an illness, disease or disability` TRUE EQUALS JUST FALSE
#ASSERT `s 241.2(2.1) a mental illness is not considered to be an illness, disease or disability` FALSE EQUALS NOTHING
-- (2) "A person has a grievous and irremediable medical condition only if they meet all of the following criteria: (a) a serious and incurable illness, disease or disability; (b) an advanced state of irreversible decline in capability; and (c) ... enduring physical or psychological suffering that is intolerable to them and that cannot be relieved under conditions that they consider acceptable"
--                                                                                      (a)  (2.1)           (b)  (c)
#ASSERT `s 241.2(2) the person has a grievous and irremediable medical condition` TRUE  NOTHING      TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 241.2(2) the person has a grievous and irremediable medical condition` TRUE  (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 241.2(2) the person has a grievous and irremediable medical condition` FALSE NOTHING      TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 241.2(2) the person has a grievous and irremediable medical condition` TRUE  NOTHING      FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 241.2(2) the person has a grievous and irremediable medical condition` TRUE  NOTHING      TRUE FALSE EQUALS JUST FALSE
-- (1) "A person may receive medical assistance in dying only if they meet all of the following criteria: (a) eligible ... for health services funded by a government in Canada; (b) at least 18 years of age and capable of making decisions with respect to their health; (c) a grievous and irremediable medical condition; (d) a voluntary request ...; (e) informed consent"
--                                                   (a)  age capable (c)             (d)  (e)
#ASSERT `s 241.2(1) the person meets all of the criteria` TRUE 18 TRUE (JUST TRUE)  TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 241.2(1) the person meets all of the criteria` TRUE 17 TRUE (JUST TRUE)  TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 241.2(1) the person meets all of the criteria` FALSE 40 TRUE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 241.2(1) the person meets all of the criteria` TRUE 40 FALSE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 241.2(1) the person meets all of the criteria` TRUE 40 TRUE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 241.2(1) the person meets all of the criteria` TRUE 40 TRUE (JUST TRUE)  FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 241.2(1) the person meets all of the criteria` TRUE 40 TRUE (JUST TRUE)  TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 241.2(1) the person meets all of the criteria` TRUE 40 TRUE NOTHING      TRUE TRUE EQUALS NOTHING
#ASSERT `s 241.2(1) the person meets all of the criteria` FALSE 40 TRUE NOTHING     TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 241.2(1) the person may receive medical assistance in dying` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 241.2(1) the person may receive medical assistance in dying` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 241.2(1) the person may receive medical assistance in dying` NOTHING EQUALS NOTHING

§ `Section 241.2(3) to (3.5) -- safeguards`

-- (3)(a) "be of the opinion that the person meets all of the criteria set out in subsection (1)"
#ASSERT `s 241.2(3)(a) the practitioner is of the opinion that the person meets all of the criteria` TRUE EQUALS JUST TRUE
#ASSERT `s 241.2(3)(a) the practitioner is of the opinion that the person meets all of the criteria` FALSE EQUALS JUST FALSE
-- (3)(b) to (h): written and signed request (b)(i), signed after being informed (b)(ii), independent witness (c), informed of withdrawal (d), second written opinion (e), independence (f), communication (g), opportunity to withdraw and express consent (h), waived by (3.2)
--                                                  b(i)  b(ii) (c)   (d)   (e)   (f)   (g)difficulty (g)measures (h)  (h) waived
#ASSERT `s 241.2(3)(b) to (h) the requirements have been met` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 241.2(3)(b) to (h) the requirements have been met` TRUE TRUE TRUE TRUE TRUE TRUE TRUE  TRUE  TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 241.2(3)(b) to (h) the requirements have been met` TRUE TRUE TRUE TRUE TRUE TRUE TRUE  FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 241.2(3)(b) to (h) the requirements have been met` FALSE TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 241.2(3)(b) to (h) the requirements have been met` TRUE FALSE TRUE TRUE TRUE TRUE FALSE FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 241.2(3)(b) to (h) the requirements have been met` TRUE TRUE FALSE TRUE TRUE TRUE FALSE FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 241.2(3)(b) to (h) the requirements have been met` TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 241.2(3)(b) to (h) the requirements have been met` TRUE TRUE TRUE TRUE FALSE TRUE FALSE FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 241.2(3)(b) to (h) the requirements have been met` TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 241.2(3)(b) to (h) the requirements have been met` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE NOTHING EQUALS JUST FALSE
-- (h) waived under (3.2): the practitioner need not meet (h)
#ASSERT `s 241.2(3)(b) to (h) the requirements have been met` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 241.2(3)(b) to (h) the requirements have been met` TRUE TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
-- (3) the practitioner "must (a) ... (h)": both parts needed; a part that is itself not covered is not covered
#ASSERT `s 241.2(3) the practitioner has met the safeguards before providing medical assistance in dying to a person whose natural death is reasonably foreseeable` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 241.2(3) the practitioner has met the safeguards before providing medical assistance in dying to a person whose natural death is reasonably foreseeable` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 241.2(3) the practitioner has met the safeguards before providing medical assistance in dying to a person whose natural death is reasonably foreseeable` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 241.2(3) the practitioner has met the safeguards before providing medical assistance in dying to a person whose natural death is reasonably foreseeable` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 241.2(3) the practitioner has met the safeguards before providing medical assistance in dying to a person whose natural death is reasonably foreseeable` NOTHING (JUST FALSE) EQUALS JUST FALSE
#TRACE `s 241.2(3) the duty to meet the safeguards where natural death is reasonably foreseeable` AT 0 WITH
    PARTY `s 241.2 a medical practitioner or nurse practitioner` DOES `s 241.2(3) meet the safeguards of paragraphs (a) to (h) before providing medical assistance in dying` AT 1
-- (3.1)(i) "at least 90 clear days between the day on which the first assessment ... begins and the day on which medical assistance in dying is provided": from 1 January 2025, day 2 April has 90 clear days between, 1 April has 89
#ASSERT `s 241.2(3.1)(i) there are at least 90 clear days between the first assessment and the day medical assistance in dying is provided` (Date 1 1 2025) (Date 2 4 2025) FALSE 0 EQUALS JUST TRUE
#ASSERT `s 241.2(3.1)(i) there are at least 90 clear days between the first assessment and the day medical assistance in dying is provided` (Date 1 1 2025) (Date 1 4 2025) FALSE 0 EQUALS JUST FALSE
-- "or -- if the assessments have been completed and both ... are of the opinion that the loss of the person's capacity to provide consent is imminent -- any shorter period the first ... practitioner considers appropriate": a shorter period of 10 clear days
#ASSERT `s 241.2(3.1)(i) there are at least 90 clear days between the first assessment and the day medical assistance in dying is provided` (Date 1 1 2025) (Date 12 1 2025) TRUE 10 EQUALS JUST TRUE
#ASSERT `s 241.2(3.1)(i) there are at least 90 clear days between the first assessment and the day medical assistance in dying is provided` (Date 1 1 2025) (Date 11 1 2025) TRUE 10 EQUALS JUST FALSE
#ASSERT `s 241.2(3.1)(i) there are at least 90 clear days between the first assessment and the day medical assistance in dying is provided` (Date 1 1 2025) (Date 12 1 2025) FALSE 10 EQUALS JUST FALSE
