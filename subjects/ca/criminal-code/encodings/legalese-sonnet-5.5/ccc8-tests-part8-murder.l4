#ASSERT `s 236(2) the court shall consider imposing a sentence of imprisonment for life` FALSE (JUST FALSE) FALSE TRUE  FALSE EQUALS JUST TRUE
#ASSERT `s 236(2) the court shall consider imposing a sentence of imprisonment for life` FALSE (JUST FALSE) FALSE FALSE TRUE  EQUALS JUST TRUE
#ASSERT `s 236(2) the court shall consider imposing a sentence of imprisonment for life` FALSE (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
#TRACE `s 236(2) the duty of the court to consider imposing a sentence of imprisonment for life` AT 0 WITH
    PARTY `the court` DOES `s 236(2) consider imposing a sentence of imprisonment for life` AT 1
-- 237 "Every female person who commits infanticide is guilty of (a) an indictable offence ... not more than five years; or (b) an offence punishable on summary conviction"
#ASSERT `s 237 the female person commits the offence of infanticide` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 237 the female person commits the offence of infanticide` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 237 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
