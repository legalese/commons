#ASSERT `s 236(2) the court shall consider imposing a sentence of imprisonment for life` TRUE  (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 236(2) the court shall consider imposing a sentence of imprisonment for life` TRUE  NOTHING      FALSE FALSE FALSE EQUALS NOTHING
