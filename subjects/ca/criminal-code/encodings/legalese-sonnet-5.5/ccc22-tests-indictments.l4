IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc22-indictments`

-- ccc22-tests-indictments.l4 -- tests for ccc22-indictments.l4 (sections 574 to 580). Every expected value is written from the text, beside the assertion.
-- The arguments of each call are in the order of the function's GIVEN lines.

§ `Section 574 -- Prosecutor may prefer indictment`

-- (1): args: decision at the preliminary inquiry, charge ordered to stand trial on, charge founded on the preliminary-inquiry evidence.
#ASSERT `s 574(1) the prosecutor may prefer an indictment against a person ordered to stand trial` `an order to stand trial` TRUE FALSE EQUALS JUST TRUE   -- (a): a charge on which the person was ordered to stand trial
#ASSERT `s 574(1) the prosecutor may prefer an indictment against a person ordered to stand trial` `an order to stand trial` FALSE TRUE EQUALS JUST TRUE   -- (b): a charge founded on the preliminary-inquiry evidence
#ASSERT `s 574(1) the prosecutor may prefer an indictment against a person ordered to stand trial` `an order to stand trial` FALSE FALSE EQUALS NOTHING   -- neither limb: the text lists (a) and (b) and does not say "only"
#ASSERT `s 574(1) the prosecutor may prefer an indictment against a person ordered to stand trial` `a discharge at the preliminary inquiry` TRUE TRUE EQUALS NOTHING   -- not a person "who has been ordered to stand trial"

-- (1.1): args: requested an inquiry, entitled to request, charge in the information (or included), made an election.
#ASSERT `s 574(1.1) the prosecutor may prefer an indictment where no preliminary inquiry was requested` FALSE TRUE TRUE TRUE EQUALS JUST TRUE   -- "has not requested"
#ASSERT `s 574(1.1) the prosecutor may prefer an indictment where no preliminary inquiry was requested` TRUE FALSE TRUE TRUE EQUALS JUST TRUE   -- "or was not entitled to make such a request"
#ASSERT `s 574(1.1) the prosecutor may prefer an indictment where no preliminary inquiry was requested` TRUE TRUE TRUE TRUE EQUALS NOTHING   -- requested and entitled: the "If" fails
#ASSERT `s 574(1.1) the prosecutor may prefer an indictment where no preliminary inquiry was requested` FALSE TRUE FALSE TRUE EQUALS NOTHING   -- a charge not in the information and not an included charge
#ASSERT `s 574(1.1) the prosecutor may prefer an indictment where no preliminary inquiry was requested` FALSE TRUE TRUE FALSE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `#ASSERT `s 574(1.1) the prosecutor may prefer an indictment where no preliminary inquiry was requested` FALSE TRUE TRUE FALSE EQUALS NOTHING`; a period the text fixes in its own words (ruling (a) of 2026-11-05), so outside it the answer is JUST FALSE, listed in the fork register as [F:may-where] with the other reading NOTHING; the election period "at any time after the person has made an election, re-election or deemed election" has not begun

-- (1.2): args: answer of (1), answer of (1.1).
#ASSERT `s 574(1.2) the prosecutor may prefer a single indictment under both subsections` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 574(1.2) the prosecutor may prefer a single indictment under both subsections` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 574(1.2) the prosecutor may prefer a single indictment under both subsections` (JUST FALSE) (JUST TRUE) EQUALS NOTHING

-- (2): args: indictment preferred under one of (1) to (1.2), accused consents.
#ASSERT `s 574(2) the indictment may include a charge not referred to in subsections (1) to (1.2)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 574(2) the indictment may include a charge not referred to in subsections (1) to (1.2)` TRUE FALSE EQUALS NOTHING   -- no consent
#ASSERT `s 574(2) the indictment may include a charge not referred to in subsections (1) to (1.2)` FALSE TRUE EQUALS NOTHING   -- not an indictment preferred under (1) to (1.2)
-- (2), last sentence: arg: the offence was committed wholly in a province other than that in which the accused is before the court.
#ASSERT `s 574(2) subsection 478(3) applies to the included charge` TRUE EQUALS JUST TRUE
#ASSERT `s 574(2) subsection 478(3) applies to the included charge` FALSE EQUALS JUST FALSE

-- (3): args: private prosecutor, the Attorney General intervenes, a judge's written order.
#ASSERT `s 574(3) the section bars preferring the indictment without the written order of a judge` TRUE FALSE FALSE EQUALS JUST TRUE   -- private prosecution, no intervention, no order: the bar applies
#ASSERT `s 574(3) the section bars preferring the indictment without the written order of a judge` TRUE FALSE TRUE EQUALS NOTHING   -- the written order is there: outside the prohibition
#ASSERT `s 574(3) the section bars preferring the indictment without the written order of a judge` FALSE FALSE FALSE EQUALS NOTHING   -- the Attorney General conducts the prosecution: outside the subsection
#ASSERT `s 574(3) the section bars preferring the indictment without the written order of a judge` TRUE TRUE FALSE EQUALS NOTHING   -- the Attorney General intervenes: outside the subsection

-- The composition: args: answers of (1), (1.1), (1.2), (2), (3).
#ASSERT `s 574 the prosecutor may prefer the indictment, subject to subsection (3)` (JUST TRUE) NOTHING NOTHING NOTHING (JUST TRUE) EQUALS JUST FALSE   -- the bar of (3) overrides the grant
#ASSERT `s 574 the prosecutor may prefer the indictment, subject to subsection (3)` (JUST TRUE) NOTHING NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 574 the prosecutor may prefer the indictment, subject to subsection (3)` NOTHING (JUST TRUE) NOTHING NOTHING (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 574 the prosecutor may prefer the indictment, subject to subsection (3)` NOTHING NOTHING NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 574 the prosecutor may prefer the indictment, subject to subsection (3)` NOTHING NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING

§ `Section 575 -- [Repealed]`

#ASSERT `s 575 what the text shows` EQUALS "[Repealed, R.S., 1985, c. 27 (1st Supp.), s. 113]"

§ `Section 576 -- Indictment`

#ASSERT `s 576(1) the section bars preferring the indictment` FALSE EQUALS JUST TRUE   -- args: this Act provides for preferring it. Not provided: "no indictment shall be preferred"
#ASSERT `s 576(1) the section bars preferring the indictment` TRUE EQUALS JUST FALSE   -- "Except as provided in this Act"
#ASSERT `s 576(2) the section bars a criminal information or a bill of indictment before a grand jury` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 576(2) the section bars a criminal information or a bill of indictment before a grand jury` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 576(2) the section bars a criminal information or a bill of indictment before a grand jury` FALSE FALSE EQUALS NOTHING
#ASSERT `s 576(3) the section bars trying a person on a coroner’s inquisition` TRUE EQUALS JUST TRUE
#ASSERT `s 576(3) the section bars trying a person on a coroner’s inquisition` FALSE EQUALS NOTHING

§ `Section 577 -- Direct indictments`

-- args: indictment preferred, situation, the Attorney General conducts or intervenes, the Attorney General's personal consent filed, a judge so orders.
#ASSERT `s 577 a direct indictment has been preferred` TRUE `s 577 the accused has not been given the opportunity to request a preliminary inquiry` TRUE TRUE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 577 a direct indictment has been preferred` TRUE `s 577 a preliminary inquiry has been commenced but not concluded` TRUE FALSE TRUE EQUALS JUST FALSE   -- (a) is the case, and the personal consent is not filed; the judge's order is for "any other case"
#ASSERT `s 577 a direct indictment has been preferred` TRUE `s 577 a preliminary inquiry has been held and the accused has been discharged` FALSE FALSE TRUE EQUALS JUST TRUE   -- (b)
#ASSERT `s 577 a direct indictment has been preferred` TRUE `s 577 a preliminary inquiry has been held and the accused has been discharged` FALSE TRUE FALSE EQUALS JUST FALSE   -- (b) is the case and no judge has ordered it
#ASSERT `s 577 a direct indictment has been preferred` TRUE `s 577 none of those situations` FALSE FALSE TRUE EQUALS NOTHING   -- an ordinary indictment
#ASSERT `s 577 a direct indictment has been preferred` FALSE `s 577 the accused has not been given the opportunity to request a preliminary inquiry` TRUE TRUE FALSE EQUALS NOTHING   -- no indictment preferred

§ `Section 578 -- Summons or warrant`

-- args: notice of recommencement given under 579(2), indictment filed, the court considers it necessary, the process.
#ASSERT `s 578(1) the court may issue a summons or a warrant for the arrest of the accused` TRUE FALSE TRUE `a summons` EQUALS JUST TRUE
#ASSERT `s 578(1) the court may issue a summons or a warrant for the arrest of the accused` FALSE TRUE TRUE `a warrant for arrest` EQUALS JUST TRUE
#ASSERT `s 578(1) the court may issue a summons or a warrant for the arrest of the accused` FALSE FALSE TRUE `a summons` EQUALS JUST FALSE   -- neither notice nor filed indictment: "Where" fails
#ASSERT `s 578(1) the court may issue a summons or a warrant for the arrest of the accused` TRUE FALSE FALSE `a summons` EQUALS NOTHING   -- the court does not consider it necessary
#ASSERT `s 578(1) the court may issue a summons or a warrant for the arrest of the accused` TRUE FALSE TRUE `an appearance notice` EQUALS NOTHING   -- a document the subsection does not name
#ASSERT `s 578(2) Part XVI applies` TRUE EQUALS JUST TRUE
#ASSERT `s 578(2) Part XVI applies` FALSE EQUALS JUST FALSE

§ `Section 579 -- Attorney General may direct stay`

-- (1): args: the person directing is the Attorney General or counsel instructed, proceedings commenced, judgment given.
#ASSERT `s 579(1) the Attorney General may direct the clerk to enter a stay` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 579(1) the Attorney General may direct the clerk to enter a stay` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 579(1) the Attorney General may direct the clerk to enter a stay` TRUE FALSE FALSE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `#ASSERT `s 579(1) the Attorney General may direct the clerk to enter a stay` TRUE FALSE FALSE EQUALS NOTHING`; a period the text fixes in its own words (ruling (a) of 2026-11-05), so outside it the answer is JUST FALSE, listed in the fork register as [F:may-where] with the other reading NOTHING; before the proceedings are commenced
#ASSERT `s 579(1) the Attorney General may direct the clerk to enter a stay` TRUE TRUE TRUE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `#ASSERT `s 579(1) the Attorney General may direct the clerk to enter a stay` TRUE TRUE TRUE EQUALS NOTHING`; a period the text fixes in its own words (ruling (a) of 2026-11-05), so outside it the answer is JUST FALSE, listed in the fork register as [F:may-where] with the other reading NOTHING; after judgment
-- (1), the effect: args: answer of the function above, the entry has been made.
#ASSERT `s 579(1) the proceedings are stayed and any undertaking or release order relating to them is vacated` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 579(1) the proceedings are stayed and any undertaking or release order relating to them is vacated` (JUST TRUE) FALSE EQUALS JUST FALSE   -- "the entry shall then be made, at which time the proceedings shall be stayed"
#ASSERT `s 579(1) the proceedings are stayed and any undertaking or release order relating to them is vacated` NOTHING TRUE EQUALS NOTHING
-- (2): args: stayed in accordance with (1), notice given to the clerk by the Attorney General or counsel.
#ASSERT `s 579(2) the stayed proceedings may be recommenced without laying a new information or preferring a new indictment` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 579(2) the stayed proceedings may be recommenced without laying a new information or preferring a new indictment` FALSE TRUE EQUALS NOTHING
#ASSERT `s 579(2) the stayed proceedings may be recommenced without laying a new information or preferring a new indictment` TRUE FALSE EQUALS NOTHING
-- (2), the last day: args: the day the stay was entered, the day the time for commencing the proceedings expires.
#ASSERT `s 579(2) the last day for the notice of recommencement` (Date 10 3 2025) (Date 10 3 2030) EQUALS Date 10 3 2026   -- the anniversary is the earlier
#ASSERT `s 579(2) the last day for the notice of recommencement` (Date 10 3 2025) (Date 1 9 2025) EQUALS Date 1 9 2025   -- the expiry of the time to commence is the earlier
#ASSERT `s 579(2) the last day for the notice of recommencement` (Date 10 3 2025) (Date 10 3 2026) EQUALS Date 10 3 2026   -- both fall on the same day
#ASSERT `s 579(2) the last day for the notice of recommencement` (Date 29 2 2024) (Date 1 1 2030) EQUALS Date 28 2 2025   -- FORK: the text does not say what the anniversary of 29 February is; the daydate library clamps to 28 February
-- (2), deemed never commenced: args: stay day, expiry day, notice day (a MAYBE), the day asked about.
#ASSERT `s 579(2) the proceedings are deemed never to have been commenced` (Date 10 3 2025) (Date 10 3 2030) (JUST (Date 10 3 2026)) (Date 1 1 2027) EQUALS JUST FALSE   -- notice on the anniversary itself is "within one year after"
#ASSERT `s 579(2) the proceedings are deemed never to have been commenced` (Date 10 3 2025) (Date 10 3 2030) (JUST (Date 11 3 2026)) (Date 1 1 2027) EQUALS JUST TRUE   -- one day late
#ASSERT `s 579(2) the proceedings are deemed never to have been commenced` (Date 10 3 2025) (Date 10 3 2030) NOTHING (Date 11 3 2026) EQUALS JUST TRUE   -- no notice, the last day has passed
#ASSERT `s 579(2) the proceedings are deemed never to have been commenced` (Date 10 3 2025) (Date 10 3 2030) NOTHING (Date 10 3 2026) EQUALS NOTHING   -- no notice yet, the last day is today
#ASSERT `s 579(2) the proceedings are deemed never to have been commenced` (Date 10 3 2025) (Date 1 9 2025) (JUST (Date 1 9 2025)) (Date 1 1 2027) EQUALS JUST FALSE   -- the earlier limit is the expiry: notice on that day is in time
#ASSERT `s 579(2) the proceedings are deemed never to have been commenced` (Date 10 3 2025) (Date 1 9 2025) (JUST (Date 2 9 2025)) (Date 1 1 2027) EQUALS JUST TRUE   -- after the expiry, though inside the year

-- The regulative twin of (2): the Attorney General gives notice AT 100 inside 365 days: FULFILLED. (A deontic value cannot be compared with #ASSERT on 1.6.110: eval/unsupported-equality; the outcomes are written here and read from the run.)
#TRACE (`s 579(2) the Attorney General may recommence the stayed proceedings by notice` 365) AT 0 WITH
    PARTY `the Attorney General` DOES `s 579(2) give notice of the recommencement to the clerk of the court` AT 100
-- expected: FULFILLED
#TRACE (`s 579(2) the Attorney General may recommence the stayed proceedings by notice` 365) AT 0 WITH
    (WAITUNTIL 400)
-- expected: FULFILLED (a MAY that lapses has no consequence for the party)

§ `Section 579.001 -- Instruction to stay (preclearance officers)`

-- (1): args: proceedings about a preclearance officer's act or omission, commenced and no judgment, notice from the United States of primary criminal jurisdiction.
#ASSERT `s 579.001(1) the Attorney General must direct the clerk to enter a stay` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 579.001(1) the Attorney General must direct the clerk to enter a stay` FALSE TRUE TRUE EQUALS NOTHING   -- not proceedings of that kind
#ASSERT `s 579.001(1) the Attorney General must direct the clerk to enter a stay` TRUE FALSE TRUE EQUALS JUST FALSE   -- not "commenced and before judgment"
#ASSERT `s 579.001(1) the Attorney General must direct the clerk to enter a stay` TRUE TRUE FALSE EQUALS JUST FALSE   -- "if the Government of the United States has provided notice": no notice
-- (2): arg: the entry has been made.
#ASSERT `s 579.001(2) the proceedings are stayed and any recognizance relating to them is vacated` TRUE EQUALS JUST TRUE
#ASSERT `s 579.001(2) the proceedings are stayed and any recognizance relating to them is vacated` FALSE EQUALS JUST FALSE
#TRACE `s 579.001(2) the clerk must make the entry immediately` AT 0 WITH
    PARTY `the clerk of the court` DOES `s 579.001(2) make the entry that the proceedings are stayed` AT 0
-- expected: FULFILLED
#TRACE `s 579.001(2) the clerk must make the entry immediately` AT 0 WITH
    (WAITUNTIL 1)
-- expected: BREACHED ("the entry was not made immediately after the clerk was directed")
-- (3): args: notice given to the clerk, notice says waiver, notice says declined or unable, notice says the accused has returned to Canada.
#ASSERT `s 579.001(3) the proceedings may be recommenced without laying a new information or preferring a new indictment` TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 579.001(3) the proceedings may be recommenced without laying a new information or preferring a new indictment` TRUE FALSE TRUE TRUE EQUALS JUST TRUE   -- (b)
#ASSERT `s 579.001(3) the proceedings may be recommenced without laying a new information or preferring a new indictment` TRUE FALSE TRUE FALSE EQUALS NOTHING   -- (b) needs both: declined and returned to Canada
#ASSERT `s 579.001(3) the proceedings may be recommenced without laying a new information or preferring a new indictment` FALSE TRUE FALSE FALSE EQUALS NOTHING   -- no notice given
-- (4): args: the day the stay was entered, the day notice under (3) was given (a MAYBE), the day asked about.
#ASSERT `s 579.001(4) the proceedings are deemed never to have been commenced` (Date 10 3 2025) (JUST (Date 10 3 2026)) (Date 1 1 2027) EQUALS JUST FALSE   -- "on or before the first anniversary"
#ASSERT `s 579.001(4) the proceedings are deemed never to have been commenced` (Date 10 3 2025) (JUST (Date 11 3 2026)) (Date 1 1 2027) EQUALS JUST TRUE
#ASSERT `s 579.001(4) the proceedings are deemed never to have been commenced` (Date 10 3 2025) NOTHING (Date 11 3 2026) EQUALS JUST TRUE
#ASSERT `s 579.001(4) the proceedings are deemed never to have been commenced` (Date 10 3 2025) NOTHING (Date 10 3 2026) EQUALS NOTHING
-- (5): args: title, parties, place, day.
#ASSERT `s 579.001(5) the instrument is the Agreement` "Agreement on Land, Rail, Marine, and Air Transport Preclearance" "the Government of Canada and the Government of the United States of America" "Washington" (Date 16 3 2015) EQUALS TRUE
#ASSERT `s 579.001(5) the instrument is the Agreement` "Agreement on Land, Rail, Marine, and Air Transport Preclearance" "the Government of Canada and the Government of the United States of America" "Washington" (Date 17 3 2015) EQUALS FALSE
#ASSERT `s 579.001(5) the instrument is the Agreement` "Agreement on Land, Rail, Marine, and Air Transport Preclearance" "the Government of Canada and the Government of the United States of America" "Ottawa" (Date 16 3 2015) EQUALS FALSE

§ `Section 579.01 -- When Attorney General does not stay proceedings`

-- args: the Attorney General intervenes, has stayed under section 579, the step.
#ASSERT `s 579.01 the Attorney General may take the step without conducting the proceedings` TRUE FALSE `s 579.01 call witnesses` EQUALS JUST TRUE
#ASSERT `s 579.01 the Attorney General may take the step without conducting the proceedings` TRUE FALSE `s 579.01 make submissions` EQUALS JUST TRUE
#ASSERT `s 579.01 the Attorney General may take the step without conducting the proceedings` TRUE FALSE `s 579.01 some other step` EQUALS NOTHING
#ASSERT `s 579.01 the Attorney General may take the step without conducting the proceedings` FALSE FALSE `s 579.01 present evidence` EQUALS NOTHING
#ASSERT `s 579.01 the Attorney General may take the step without conducting the proceedings` TRUE TRUE `s 579.01 present evidence` EQUALS NOTHING

§ `Section 579.1 -- Intervention by Attorney General of Canada or Director of Public Prosecutions`

-- args: the person, (a) offence within the power, (b) not instituted by an Attorney General, (c) judgment not rendered, (d) the provincial Attorney General has not intervened.
#ASSERT `s 579.1(1) the Attorney General of Canada or the Director of Public Prosecutions may intervene` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 579.1(1) the Attorney General of Canada or the Director of Public Prosecutions may intervene` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 579.1(1) the Attorney General of Canada or the Director of Public Prosecutions may intervene` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING   -- (a)
#ASSERT `s 579.1(1) the Attorney General of Canada or the Director of Public Prosecutions may intervene` TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING   -- (b)
#ASSERT `s 579.1(1) the Attorney General of Canada or the Director of Public Prosecutions may intervene` TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING   -- (c)
#ASSERT `s 579.1(1) the Attorney General of Canada or the Director of Public Prosecutions may intervene` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING   -- (d)
#ASSERT `s 579.1(2) sections 579 and 579.01 apply to the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 579.1(2) sections 579 and 579.01 apply to the proceedings` FALSE EQUALS NOTHING

§ `Section 580 -- Form of indictment`

-- args: on paper, in Form 4.
#ASSERT `s 580 the indictment is sufficient` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 580 the indictment is sufficient` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 580 the indictment is sufficient` FALSE TRUE EQUALS JUST FALSE
