#ASSERT `s 244(2)(a)(i) five years` EQUALS `Length of time` OF 5, 0, 0, FALSE
#ASSERT `s 244(2)(a)(ii) seven years` EQUALS `Length of time` OF 7, 0, 0, FALSE
