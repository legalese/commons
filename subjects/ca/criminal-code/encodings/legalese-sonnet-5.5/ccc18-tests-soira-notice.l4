IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc18-soira-notice`

-- ccc18-tests-soira-notice.l4 -- tests for ccc18-soira-notice.l4. Expected values are written from the text of the Criminal Code
-- (R.S.C., 1985, c. C-46, lines 10275-10956 of the plain-text rendering), beside each assertion, and not copied from the module's own output.

-- 490.02(1): the person must have been convicted (or found NCR) of a listed offence AND be within para (a), or within para (b)(i) and (ii). "only if" closes the gate.
#ASSERT `s 490.02(1) the Attorney General or minister of justice may serve the person with a notice` (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- para (a) alone
#ASSERT `s 490.02(1) the Attorney General or minister of justice may serve the person with a notice` (JUST TRUE) FALSE TRUE TRUE FALSE EQUALS JUST TRUE   -- para (b): registry (i) and resident (ii)
#ASSERT `s 490.02(1) the Attorney General or minister of justice may serve the person with a notice` (JUST TRUE) FALSE TRUE FALSE TRUE EQUALS JUST TRUE   -- para (b): registry (i) and committed in Ontario (ii)
#ASSERT `s 490.02(1) the Attorney General or minister of justice may serve the person with a notice` (JUST TRUE) FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- (b)(i) without (b)(ii): neither paragraph
#ASSERT `s 490.02(1) the Attorney General or minister of justice may serve the person with a notice` (JUST TRUE) FALSE FALSE TRUE TRUE EQUALS JUST FALSE   -- (b)(ii) without (b)(i)
#ASSERT `s 490.02(1) the Attorney General or minister of justice may serve the person with a notice` (JUST FALSE) TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- not an offence of the listed kind
#ASSERT `s 490.02(1) the Attorney General or minister of justice may serve the person with a notice` NOTHING TRUE FALSE FALSE FALSE EQUALS NOTHING   -- the offence seam is not covered: carried through
#ASSERT `s 490.02(1) the Attorney General or minister of justice may serve the person with a notice` NOTHING FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- neither paragraph: no whatever the seam says

-- 490.02(2): "A notice shall not be served on a person (a) if ... (b) if ... or (c) who is referred to in paragraph (1)(b) if ..." -- any one of the three bars service.
#ASSERT `s 490.02(2) a notice shall not be served on the person` TRUE FALSE FALSE EQUALS JUST TRUE   -- (a) acquitted or pardoned of every offence
#ASSERT `s 490.02(2) a notice shall not be served on the person` FALSE TRUE FALSE EQUALS JUST TRUE   -- (b) application made for an order under 490.012(3)
#ASSERT `s 490.02(2) a notice shall not be served on the person` FALSE FALSE TRUE EQUALS JUST TRUE   -- (c) Ontario registrant who proved a pardon
#ASSERT `s 490.02(2) a notice shall not be served on the person` FALSE FALSE FALSE EQUALS NOTHING   -- none of (a) to (c): the subsection is silent

-- 490.02(1) and (2) together: the bar of (2) overrides a JUST TRUE of (1); when the bar does not apply (NOTHING), (1) governs.
#ASSERT `s 490.02 the notice may be served, subject to subsection (2)` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 490.02 the notice may be served, subject to subsection (2)` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 490.02 the notice may be served, subject to subsection (2)` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 490.02 the notice may be served, subject to subsection (2)` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 490.02 the notice may be served, subject to subsection (2)` NOTHING (JUST TRUE) EQUALS JUST FALSE

#ASSERT `s 490.02(3) the reference is to the provision as it read from time to time before the day on which the subsection comes into force` `s 490.02(3) the reference in subsection (1) to the definition designated offence` EQUALS JUST TRUE
#ASSERT `s 490.02(3) the reference is to the provision as it read from time to time before the day on which the subsection comes into force` `s 490.02(3) the reference in paragraph (2)(b) to subsection 490.012(3)` EQUALS JUST TRUE
#ASSERT `s 490.02(3) the reference is to the provision as it read from time to time before the day on which the subsection comes into force` `s 490.02(3) any other reference` EQUALS NOTHING

-- 490.021(1): the period is the year after the day the Sex Offender Information Registration Act comes into force (take 15 December 2004 as the day, an assumed date: the text leaves it to that Act).
#ASSERT `s 490.021(1) one year after the day` (Date 15 12 2004) EQUALS Date 15 12 2005
#ASSERT `s 490.021(1) the notice is served within one year after the day on which the Sex Offender Information Registration Act comes into force` (Date 15 12 2004) (Date 16 12 2004) EQUALS JUST TRUE   -- the first day after
#ASSERT `s 490.021(1) the notice is served within one year after the day on which the Sex Offender Information Registration Act comes into force` (Date 15 12 2004) (Date 15 12 2005) EQUALS JUST TRUE   -- the last day: the anniversary
#ASSERT `s 490.021(1) the notice is served within one year after the day on which the Sex Offender Information Registration Act comes into force` (Date 15 12 2004) (Date 16 12 2005) EQUALS JUST FALSE   -- one day late
#ASSERT `s 490.021(1) the notice is served within one year after the day on which the Sex Offender Information Registration Act comes into force` (Date 15 12 2004) (Date 15 12 2004) EQUALS JUST FALSE   -- the day itself is not "after" it (fork F3)
#ASSERT `s 490.021(1) the notice is served within one year after the day on which the Sex Offender Information Registration Act comes into force` (Date 15 12 2004) (Date 14 12 2004) EQUALS JUST FALSE   -- before the day

#ASSERT `s 490.021(2) the notice may be served by registered mail at the person's last known address` TRUE TRUE FALSE EQUALS JUST TRUE   -- unlawfully at large
#ASSERT `s 490.021(2) the notice may be served by registered mail at the person's last known address` TRUE FALSE TRUE EQUALS JUST TRUE   -- in breach of a residence term
#ASSERT `s 490.021(2) the notice may be served by registered mail at the person's last known address` TRUE FALSE FALSE EQUALS NOTHING   -- a para (a) person neither at large nor in breach
#ASSERT `s 490.021(2) the notice may be served by registered mail at the person's last known address` FALSE TRUE TRUE EQUALS NOTHING   -- not a para (a) person

#ASSERT `s 490.021(3) the notice may be served by registered mail at the person's last known address, the person not being in compliance with the Ontario Act` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.021(3) the notice may be served by registered mail at the person's last known address, the person not being in compliance with the Ontario Act` TRUE FALSE EQUALS NOTHING
#ASSERT `s 490.021(3) the notice may be served by registered mail at the person's last known address, the person not being in compliance with the Ontario Act` FALSE TRUE EQUALS NOTHING

#ASSERT `s 490.021(4) the notice may be served by registered mail at the person's last known address, the person having failed to comply` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.021(4) the notice may be served by registered mail at the person's last known address, the person having failed to comply` TRUE TRUE FALSE EQUALS NOTHING   -- complied throughout
#ASSERT `s 490.021(4) the notice may be served by registered mail at the person's last known address, the person having failed to comply` TRUE FALSE TRUE EQUALS NOTHING   -- not in compliance on the day (subsection (3) is the one for them)
#ASSERT `s 490.021(4) the notice may be served by registered mail at the person's last known address, the person having failed to comply` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 490.021(4) the notice is served within one year after the day on which the person failed to comply` (Date 1 3 2006) (Date 1 3 2007) EQUALS JUST TRUE   -- last day
#ASSERT `s 490.021(4) the notice is served within one year after the day on which the person failed to comply` (Date 1 3 2006) (Date 2 3 2007) EQUALS JUST FALSE   -- a day late
#ASSERT `s 490.021(4) the notice is served within one year after the day on which the person failed to comply` (Date 1 3 2006) (Date 2 3 2006) EQUALS JUST TRUE   -- the day after

-- 490.021(1) to (4) together: personal service always; registered mail only where (2), (3) or (4) gives it; any other manner not at all.
#ASSERT `s 490.021 the manner of service is one the section allows` `s 490.021(1) personal service` NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 490.021 the manner of service is one the section allows` `s 490.021(2) registered mail at the last known address` (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 490.021 the manner of service is one the section allows` `s 490.021(2) registered mail at the last known address` NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 490.021 the manner of service is one the section allows` `s 490.021(2) registered mail at the last known address` NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 490.021 the manner of service is one the section allows` `s 490.021(2) registered mail at the last known address` NOTHING NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 490.021 the manner of service is one the section allows` `s 490.021(1) another manner of service` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE

#ASSERT `s 490.021(5) the affidavit is evidence of the service and the notice` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.021(5) the affidavit is evidence of the service and the notice` FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- not sworn before a person authorized
#ASSERT `s 490.021(5) the affidavit is evidence of the service and the notice` TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- (a) missing
#ASSERT `s 490.021(5) the affidavit is evidence of the service and the notice` TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- (b) missing
#ASSERT `s 490.021(5) the affidavit is evidence of the service and the notice` TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- (c) missing

#ASSERT `s 490.021(6) the person who served the notice must send a copy of the affidavit and the notice` TRUE EQUALS JUST TRUE
#ASSERT `s 490.021(6) the person who served the notice must send a copy of the affidavit and the notice` FALSE EQUALS NOTHING
-- the text gives no number of days ("without delay"), so the trace has no WITHIN; the person does the act: expected FULFILLED
#TRACE `s 490.021(6) the duty of the person who served the notice, without delay` AT 0 WITH
    PARTY `s 490.021(6) the person who served the notice` DOES `s 490.021(6) send a copy of the affidavit and the notice to the Attorney General of the province, or the minister of justice of the territory, in which the person was served` AT 3

-- 490.022(1): served on 1 June 2006, so one year after is 1 June 2007.
#ASSERT `s 490.022(1) the day on which the obligation under section 490.019 begins` (Date 1 6 2006) NOTHING NOTHING EQUALS Date 1 6 2007   -- (a), no refusal: one year after service
#ASSERT `s 490.022(1) the day on which the obligation under section 490.019 begins` (Date 1 6 2006) (JUST (Date 1 9 2007)) NOTHING EQUALS Date 1 9 2007   -- (a), refusal after the year: the later
#ASSERT `s 490.022(1) the day on which the obligation under section 490.019 begins` (Date 1 6 2006) (JUST (Date 1 1 2007)) NOTHING EQUALS Date 1 6 2007   -- (a), refusal inside the year: the year is the later
#ASSERT `s 490.022(1) the day on which the obligation under section 490.019 begins` (Date 1 6 2006) (JUST (Date 1 6 2007)) NOTHING EQUALS Date 1 6 2007   -- (a), refusal on the anniversary
#ASSERT `s 490.022(1) the day on which the obligation under section 490.019 begins` (Date 1 6 2006) NOTHING (JUST (Date 5 3 2008)) EQUALS Date 5 3 2008   -- (b) an exemption order is quashed

-- 490.022(2): "the earliest of" the days of paragraphs (a), (b) and (c); (b) and (c) concern a person referred to in paragraph 490.02(1)(b) (the Ontario registry).
#ASSERT `s 490.022(2) the earliest day on which the obligation ends` (JUST (Date 1 3 2010)) (JUST (Date 1 2 2010)) (JUST (Date 1 4 2010)) EQUALS JUST (Date 1 2 2010)
#ASSERT `s 490.022(2) the earliest day on which the obligation ends` (JUST (Date 1 3 2010)) NOTHING NOTHING EQUALS JUST (Date 1 3 2010)
#ASSERT `s 490.022(2) the earliest day on which the obligation ends` NOTHING NOTHING (JUST (Date 1 4 2010)) EQUALS JUST (Date 1 4 2010)
#ASSERT `s 490.022(2) the earliest day on which the obligation ends` (JUST (Date 1 3 2010)) NOTHING (JUST (Date 1 3 2010)) EQUALS JUST (Date 1 3 2010)   -- the same day
#ASSERT `s 490.022(2) the earliest day on which the obligation ends` NOTHING NOTHING NOTHING EQUALS NOTHING   -- none occurs: subsection (3) governs

-- 490.022(3): the band of the maximum term: "two or five years", "10 or 14 years", "life"; any other term is not named.
#ASSERT `s 490.022(3) the band of the maximum term of imprisonment` (`imprisonment for a term of` `two years`) EQUALS `s 490.022(3) a maximum term of two or five years`
#ASSERT `s 490.022(3) the band of the maximum term of imprisonment` (`imprisonment for a term of` `five years`) EQUALS `s 490.022(3) a maximum term of two or five years`
#ASSERT `s 490.022(3) the band of the maximum term of imprisonment` (`imprisonment for a term of` `ten years`) EQUALS `s 490.022(3) a maximum term of 10 or 14 years`
#ASSERT `s 490.022(3) the band of the maximum term of imprisonment` (`imprisonment for a term of` `fourteen years`) EQUALS `s 490.022(3) a maximum term of 10 or 14 years`
#ASSERT `s 490.022(3) the band of the maximum term of imprisonment` `imprisonment for life` EQUALS `s 490.022(3) a maximum term of life`
#ASSERT `s 490.022(3) the band of the maximum term of imprisonment` (`imprisonment for a term of` `two years less a day`) EQUALS `s 490.022(3) any other maximum term, or none stated`   -- two years less a day is not "two years"
#ASSERT `s 490.022(3) the band of the maximum term of imprisonment` (`imprisonment for a term of` (`Length of time` OF 7, 0, 0, FALSE)) EQUALS `s 490.022(3) any other maximum term, or none stated`
#ASSERT `s 490.022(3) the band of the maximum term of imprisonment` `no imprisonment is stated` EQUALS `s 490.022(3) any other maximum term, or none stated`
#ASSERT `s 490.022(3) the day a number of years after the day` (Date 1 6 2005) 10 EQUALS Date 1 6 2015
-- 490.022(3) with the sentence on 1 June 2005: (a) 10 years if prosecuted summarily or the maximum is two or five years; (b) 20 years if 10 or 14; (c) life if life; (d) life for several offences.
#ASSERT `s 490.022(3) the obligation, if none of paragraphs (2)(a) to (c) applies earlier, ends or applies for life` FALSE (`imprisonment for a term of` `two years`) (Date 1 6 2005) FALSE FALSE EQUALS JUST (`s 490.022(3) ends on` (Date 1 6 2015))
#ASSERT `s 490.022(3) the obligation, if none of paragraphs (2)(a) to (c) applies earlier, ends or applies for life` FALSE (`imprisonment for a term of` `five years`) (Date 1 6 2005) FALSE FALSE EQUALS JUST (`s 490.022(3) ends on` (Date 1 6 2015))
#ASSERT `s 490.022(3) the obligation, if none of paragraphs (2)(a) to (c) applies earlier, ends or applies for life` TRUE (`imprisonment for a term of` `ten years`) (Date 1 6 2005) FALSE FALSE EQUALS JUST (`s 490.022(3) ends on` (Date 1 6 2015))   -- prosecuted summarily: paragraph (a) whatever the maximum
#ASSERT `s 490.022(3) the obligation, if none of paragraphs (2)(a) to (c) applies earlier, ends or applies for life` FALSE (`imprisonment for a term of` `ten years`) (Date 1 6 2005) FALSE FALSE EQUALS JUST (`s 490.022(3) ends on` (Date 1 6 2025))
#ASSERT `s 490.022(3) the obligation, if none of paragraphs (2)(a) to (c) applies earlier, ends or applies for life` FALSE (`imprisonment for a term of` `fourteen years`) (Date 1 6 2005) FALSE FALSE EQUALS JUST (`s 490.022(3) ends on` (Date 1 6 2025))
#ASSERT `s 490.022(3) the obligation, if none of paragraphs (2)(a) to (c) applies earlier, ends or applies for life` FALSE `imprisonment for life` (Date 1 6 2005) FALSE FALSE EQUALS JUST `s 490.022(3) applies for life`
#ASSERT `s 490.022(3) the obligation, if none of paragraphs (2)(a) to (c) applies earlier, ends or applies for life` FALSE (`imprisonment for a term of` `five years`) (Date 1 6 2005) TRUE TRUE EQUALS JUST `s 490.022(3) applies for life`   -- (d) several offences, more than one in the notice
#ASSERT `s 490.022(3) the obligation, if none of paragraphs (2)(a) to (c) applies earlier, ends or applies for life` FALSE (`imprisonment for a term of` `five years`) (Date 1 6 2005) TRUE FALSE EQUALS JUST (`s 490.022(3) ends on` (Date 1 6 2015))   -- (d) needs both: only one offence listed in the notice
#ASSERT `s 490.022(3) the obligation, if none of paragraphs (2)(a) to (c) applies earlier, ends or applies for life` FALSE (`imprisonment for a term of` `five years`) (Date 1 6 2005) FALSE TRUE EQUALS JUST (`s 490.022(3) ends on` (Date 1 6 2015))   -- (d) needs both: only one offence of record
#ASSERT `s 490.022(3) the obligation, if none of paragraphs (2)(a) to (c) applies earlier, ends or applies for life` FALSE (`imprisonment for a term of` (`Length of time` OF 3, 0, 0, FALSE)) (Date 1 6 2005) FALSE FALSE EQUALS NOTHING   -- a three-year maximum is not named
#ASSERT `s 490.022(3) the obligation, if none of paragraphs (2)(a) to (c) applies earlier, ends or applies for life` TRUE `imprisonment for life` (Date 1 6 2005) FALSE FALSE EQUALS JUST (`s 490.022(3) ends on` (Date 1 6 2015))   -- summarily AND a life maximum: (a) is read first (fork F7)

#ASSERT `s 490.022(4) the reference is to the definition as it read from time to time before the day on which the subsection comes into force` `s 490.022(4) the reference in paragraph (3)(d) to the definition designated offence` EQUALS JUST TRUE
#ASSERT `s 490.022(4) the reference is to the definition as it read from time to time before the day on which the subsection comes into force` `s 490.022(4) any other reference` EQUALS NOTHING

-- 490.023(1): served on 1 March 2006: the year runs to 1 March 2007 (the day of service itself is in time: a person may apply as soon as served).
#ASSERT `s 490.023(1) the person may apply for an exemption order` (JUST FALSE) (Date 1 3 2006) (Date 1 3 2006) EQUALS JUST TRUE   -- on the day of service
#ASSERT `s 490.023(1) the person may apply for an exemption order` (JUST FALSE) (Date 1 3 2006) (Date 1 3 2007) EQUALS JUST TRUE   -- last day
#ASSERT `s 490.023(1) the person may apply for an exemption order` (JUST FALSE) (Date 1 3 2006) (Date 2 3 2007) EQUALS JUST FALSE   -- a day late
#ASSERT `s 490.023(1) the person may apply for an exemption order` (JUST FALSE) (Date 1 3 2006) (Date 28 2 2006) EQUALS JUST FALSE   -- before service
#ASSERT `s 490.023(1) the person may apply for an exemption order` (JUST TRUE) (Date 1 3 2006) (Date 1 6 2006) EQUALS NOTHING   -- subject to an order under 490.012: the grant is for a person who is not
#ASSERT `s 490.023(1) the person may apply for an exemption order` NOTHING (Date 1 3 2006) (Date 1 6 2006) EQUALS NOTHING   -- the seam is not covered
#ASSERT `s 490.023(1) the person may apply for an exemption order` (JUST TRUE) (Date 1 3 2006) (Date 2 3 2007) EQUALS JUST FALSE   -- out of time whatever the order

#ASSERT `s 490.023(1.1) the application shall be made to a court of criminal jurisdiction` TRUE FALSE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 490.023(1.1) the application shall be made to a court of criminal jurisdiction` FALSE TRUE TRUE EQUALS JUST TRUE   -- (b): both limbs
#ASSERT `s 490.023(1.1) the application shall be made to a court of criminal jurisdiction` FALSE TRUE FALSE EQUALS JUST FALSE   -- (b) needs the Chief Military Judge to lack jurisdiction
#ASSERT `s 490.023(1.1) the application shall be made to a court of criminal jurisdiction` FALSE FALSE FALSE EQUALS JUST FALSE

#ASSERT `s 490.023(2) the court shall make an exemption order` TRUE EQUALS JUST TRUE
#ASSERT `s 490.023(2) the court shall make an exemption order` FALSE EQUALS JUST FALSE
-- the text gives no time for the act, so the trace has no WITHIN; the party does the act: expected FULFILLED
#TRACE `s 490.023(2) the duty of the court` AT 0 WITH
    PARTY `the court` DOES `s 490.023(2) make an exemption order` AT 1

#ASSERT `s 490.023(3) the court shall give reasons for its decision` TRUE EQUALS JUST TRUE
#ASSERT `s 490.023(3) the court shall give reasons for its decision` FALSE EQUALS NOTHING
-- the text gives no time for the act, so the trace has no WITHIN; the party does the act: expected FULFILLED
#TRACE `s 490.023(3) the duty of the court` AT 0 WITH
    PARTY `the court` DOES `s 490.023(3) give reasons for its decision` AT 1

#ASSERT `s 490.023(4) the court shall also make an order for removal of the information from the database` TRUE EQUALS JUST TRUE
#ASSERT `s 490.023(4) the court shall also make an order for removal of the information from the database` FALSE EQUALS JUST FALSE
-- the text gives no time for the act, so the trace has no WITHIN; the party does the act: expected FULFILLED
#TRACE `s 490.023(4) the duty of the court` AT 0 WITH
    PARTY `the court` DOES `s 490.023(4) make an order requiring the Royal Canadian Mounted Police to permanently remove from the database all information that relates to the person that was registered in the database on receipt of the copy of the notice` AT 1

#ASSERT `s 490.024(1) the appeal may be brought` `s 490.024(1) the Attorney General` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.024(1) the appeal may be brought` `s 490.024(1) the person who applied for an exemption order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.024(1) the appeal may be brought` `s 490.024(1) another person` TRUE TRUE EQUALS NOTHING   -- another person
#ASSERT `s 490.024(1) the appeal may be brought` `s 490.024(1) the Attorney General` FALSE TRUE EQUALS NOTHING   -- a different decision
#ASSERT `s 490.024(1) the appeal may be brought` `s 490.024(1) the person who applied for an exemption order` TRUE FALSE EQUALS NOTHING   -- a ground raising no question of law or mixed law and fact

#ASSERT `s 490.024(1) the appeal court may do it` `s 490.024(1) dismiss the appeal` EQUALS JUST TRUE
#ASSERT `s 490.024(1) the appeal court may do it` `s 490.024(1) allow the appeal and order a new hearing` EQUALS JUST TRUE
#ASSERT `s 490.024(1) the appeal court may do it` `s 490.024(1) quash the exemption order` EQUALS JUST TRUE
#ASSERT `s 490.024(1) the appeal court may do it` `s 490.024(1) make an order that may be made under subsection 490.023(2)` EQUALS JUST TRUE
#ASSERT `s 490.024(1) the appeal court may do it` `s 490.024(1) another thing` EQUALS NOTHING

#ASSERT `s 490.024(2) the appeal court shall also make an order for removal of the information from the database` TRUE EQUALS JUST TRUE
#ASSERT `s 490.024(2) the appeal court shall also make an order for removal of the information from the database` FALSE EQUALS JUST FALSE
-- the text gives no time for the act, so the trace has no WITHIN; the party does the act: expected FULFILLED
#TRACE `s 490.024(2) the duty of a court of appeal` AT 0 WITH
    PARTY `a court of appeal` DOES `s 490.024(2) make an order requiring the Royal Canadian Mounted Police to permanently remove from the database all information that relates to the person that was registered in the database on receipt of the copy of the notice` AT 1

#ASSERT `s 490.025 the court shall cause the notification and the information to be given` TRUE FALSE FALSE EQUALS JUST TRUE   -- a court refuses
#ASSERT `s 490.025 the court shall cause the notification and the information to be given` FALSE TRUE FALSE EQUALS JUST TRUE   -- an appeal court dismisses the appeal
#ASSERT `s 490.025 the court shall cause the notification and the information to be given` FALSE FALSE TRUE EQUALS JUST TRUE   -- an appeal court quashes an exemption order
#ASSERT `s 490.025 the court shall cause the notification and the information to be given` FALSE FALSE FALSE EQUALS JUST FALSE
-- no time is stated: no WITHIN; the court does each act: expected FULFILLED
#TRACE `s 490.025 the duty of the court to cause the Commissioner and the Attorney General to be notified` AT 0 WITH
    PARTY `the court` DOES `s 490.025 cause the Commissioner of the Royal Canadian Mounted Police and the Attorney General of the province, or the minister of justice of the territory, in which the application for the order was made to be notified of the decision` AT 1
#TRACE `s 490.025 the duty of the court to cause the person to be informed of the sections` AT 0 WITH
    PARTY `the court` DOES `s 490.025 cause the person who applied for the order to be informed of sections 4 to 7.1 of the Sex Offender Information Registration Act, sections 490.031 and 490.0311 of this Act and section 119.1 of the National Defence Act` AT 1

#ASSERT `s 490.026(1) the person may apply for a termination order` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 490.026(1) the person may apply for a termination order` (JUST TRUE) TRUE EQUALS JUST FALSE   -- "unless": another obligation or order that began later
#ASSERT `s 490.026(1) the person may apply for a termination order` (JUST FALSE) FALSE EQUALS NOTHING   -- not subject to an obligation under 490.019: the grant is not theirs
#ASSERT `s 490.026(1) the person may apply for a termination order` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 490.026(1) the person may apply for a termination order` NOTHING TRUE EQUALS JUST FALSE   -- "unless" closes the gate whatever the seam says

-- 490.026(2): sentenced 1 June 2005. Summary or a 2-or-5-year maximum: 5 years (1 June 2010); 10-or-14: 10 years; life: 20 years. Elapsed on the anniversary day (fork F4).
#ASSERT `s 490.026(2) the person may apply for a termination order, the period since sentence having elapsed` TRUE (`imprisonment for a term of` `ten years`) (Date 1 6 2005) (Date 1 6 2010) EQUALS JUST TRUE   -- prosecuted summarily: five years
#ASSERT `s 490.026(2) the person may apply for a termination order, the period since sentence having elapsed` TRUE (`imprisonment for a term of` `ten years`) (Date 1 6 2005) (Date 31 5 2010) EQUALS NOTHING   -- a day short
#ASSERT `s 490.026(2) the person may apply for a termination order, the period since sentence having elapsed` FALSE (`imprisonment for a term of` `five years`) (Date 1 6 2005) (Date 1 6 2010) EQUALS JUST TRUE
#ASSERT `s 490.026(2) the person may apply for a termination order, the period since sentence having elapsed` FALSE (`imprisonment for a term of` `two years`) (Date 1 6 2005) (Date 31 5 2010) EQUALS NOTHING
#ASSERT `s 490.026(2) the person may apply for a termination order, the period since sentence having elapsed` FALSE (`imprisonment for a term of` `ten years`) (Date 1 6 2005) (Date 1 6 2015) EQUALS JUST TRUE   -- (b) 10 years
#ASSERT `s 490.026(2) the person may apply for a termination order, the period since sentence having elapsed` FALSE (`imprisonment for a term of` `fourteen years`) (Date 1 6 2005) (Date 31 5 2015) EQUALS NOTHING
#ASSERT `s 490.026(2) the person may apply for a termination order, the period since sentence having elapsed` FALSE `imprisonment for life` (Date 1 6 2005) (Date 1 6 2025) EQUALS JUST TRUE   -- (c) 20 years
#ASSERT `s 490.026(2) the person may apply for a termination order, the period since sentence having elapsed` FALSE `imprisonment for life` (Date 1 6 2005) (Date 1 6 2015) EQUALS NOTHING
#ASSERT `s 490.026(2) the person may apply for a termination order, the period since sentence having elapsed` FALSE (`imprisonment for a term of` (`Length of time` OF 3, 0, 0, FALSE)) (Date 1 6 2005) (Date 1 6 2030) EQUALS NOTHING   -- a three-year maximum is not named

#ASSERT `s 490.026(3) the person may apply for a termination order, 20 years having elapsed since the most recent offence` TRUE (Date 1 6 2005) (Date 1 6 2025) EQUALS JUST TRUE
#ASSERT `s 490.026(3) the person may apply for a termination order, 20 years having elapsed since the most recent offence` TRUE (Date 1 6 2005) (Date 31 5 2025) EQUALS NOTHING
#ASSERT `s 490.026(3) the person may apply for a termination order, 20 years having elapsed since the most recent offence` FALSE (Date 1 6 2005) (Date 1 6 2030) EQUALS NOTHING   -- only one offence is listed: subsection (2) governs

#ASSERT `s 490.026(4) the person may apply for a termination order, despite subsections (2) and (3)` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 490.026(4) the person may apply for a termination order, despite subsections (2) and (3)` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 490.026(4) the person may apply for a termination order, despite subsections (2) and (3)` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 490.026(4) the person may apply for a termination order, despite subsections (2) and (3)` FALSE FALSE FALSE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was #ASSERT `s 490.026(4) the person may apply for a termination order, despite subsections (2) and (3)` FALSE FALSE FALSE EQUALS NOTHING; the gate is "once" (read as "when"), which the name-test sweep lists with the guide's own answer, JUST FALSE (ruling (b)), and does not flip

-- 490.026(5): previous application on 1 March 2010.
#ASSERT `s 490.026(5) the person may apply again for a termination order` TRUE (Date 1 3 2010) (Date 1 3 2015) FALSE FALSE FALSE EQUALS JUST TRUE   -- five years since the previous application
#ASSERT `s 490.026(5) the person may apply again for a termination order` TRUE (Date 1 3 2010) (Date 28 2 2015) FALSE FALSE FALSE EQUALS NOTHING   -- a day short
#ASSERT `s 490.026(5) the person may apply again for a termination order` TRUE (Date 1 3 2010) (Date 1 1 2012) TRUE FALSE FALSE EQUALS JUST TRUE   -- a pardon
#ASSERT `s 490.026(5) the person may apply again for a termination order` TRUE (Date 1 3 2010) (Date 1 1 2012) FALSE TRUE FALSE EQUALS JUST TRUE   -- a record suspension
#ASSERT `s 490.026(5) the person may apply again for a termination order` TRUE (Date 1 3 2010) (Date 1 3 2016) FALSE FALSE TRUE EQUALS JUST FALSE   -- "may not apply again": became subject to another obligation or order
#ASSERT `s 490.026(5) the person may apply again for a termination order` TRUE (Date 1 3 2010) (Date 1 3 2016) TRUE FALSE TRUE EQUALS JUST FALSE   -- the bar governs even with a pardon
#ASSERT `s 490.026(5) the person may apply again for a termination order` FALSE (Date 1 3 2010) (Date 1 3 2016) FALSE FALSE FALSE EQUALS NOTHING   -- the application was not refused

#ASSERT `s 490.026(6) the application shall be made to a court of criminal jurisdiction` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 490.026(6) the application shall be made to a court of criminal jurisdiction` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.026(6) the application shall be made to a court of criminal jurisdiction` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 490.026(6) the application shall be made to a court of criminal jurisdiction` FALSE FALSE FALSE EQUALS JUST FALSE

#ASSERT `s 490.027(1) the court shall make an order terminating the obligation` TRUE FALSE EQUALS JUST TRUE   -- ground 1 of 2 alone
#ASSERT `s 490.027(1) the court shall make an order terminating the obligation` FALSE TRUE EQUALS JUST TRUE   -- ground 2 of 2 alone
#ASSERT `s 490.027(1) the court shall make an order terminating the obligation` FALSE FALSE EQUALS JUST FALSE   -- the court is not satisfied of any ground
#ASSERT `s 490.027(1) the court shall make an order terminating the obligation` TRUE TRUE EQUALS JUST TRUE   -- every ground
-- the text gives no time for the order, so the trace has no WITHIN; the court makes the order: expected FULFILLED
#TRACE `s 490.027(1) the duty of the court` AT 0 WITH
    PARTY `the court` DOES `s 490.027(1) make an order terminating the obligation` AT 1

-- s 490.027(1.1): each factor in the list is one the court shall consider, when it is determining the order; (g) adds any matter the court considers relevant.

#ASSERT `s 490.027(1.1) the court shall consider the factor` TRUE `s 490.027(1.1)(a) the nature and seriousness of the offence that is the basis of the obligation` FALSE EQUALS JUST TRUE

#ASSERT `s 490.027(1.1) the court shall consider the factor` TRUE `s 490.027(1.1)(b) the victim’s age and other personal characteristics` FALSE EQUALS JUST TRUE

#ASSERT `s 490.027(1.1) the court shall consider the factor` TRUE `s 490.027(1.1)(c) the nature and circumstances of the relationship between the person and the victim` FALSE EQUALS JUST TRUE

#ASSERT `s 490.027(1.1) the court shall consider the factor` TRUE `s 490.027(1.1)(d) the personal characteristics and circumstances of the person` FALSE EQUALS JUST TRUE

#ASSERT `s 490.027(1.1) the court shall consider the factor` TRUE `s 490.027(1.1)(e) the person’s criminal history, including the age at which they previously committed any offence and the length of time for which they have been at liberty without committing an offence` FALSE EQUALS JUST TRUE

#ASSERT `s 490.027(1.1) the court shall consider the factor` TRUE `s 490.027(1.1)(f) the opinions of experts who have examined the person` FALSE EQUALS JUST TRUE

#ASSERT `s 490.027(1.1) the court shall consider the factor` TRUE `s 490.027(1.1)(g) any other factors that the court considers relevant` FALSE EQUALS JUST TRUE

#ASSERT `s 490.027(1.1) the court shall consider the factor` TRUE `s 490.027(1.1) a matter outside paragraphs (a) to (f)` TRUE EQUALS JUST TRUE   -- the court considers it relevant: paragraph (g)

#ASSERT `s 490.027(1.1) the court shall consider the factor` TRUE `s 490.027(1.1) a matter outside paragraphs (a) to (f)` FALSE EQUALS NOTHING   -- not named, and the court does not consider it relevant

#ASSERT `s 490.027(1.1) the court shall consider the factor` FALSE `s 490.027(1.1)(a) the nature and seriousness of the offence that is the basis of the obligation` FALSE EQUALS JUST FALSE   -- the court is not determining the order

#ASSERT `s 490.027(2) the court shall give reasons for its decision` TRUE EQUALS JUST TRUE
#ASSERT `s 490.027(2) the court shall give reasons for its decision` FALSE EQUALS NOTHING
-- the text gives no time for the act, so the trace has no WITHIN; the party does the act: expected FULFILLED
#TRACE `s 490.027(2) the duty of the court` AT 0 WITH
    PARTY `the court` DOES `s 490.027(2) give reasons for its decision` AT 1

#ASSERT `s 490.027(3) the court shall cause the notification to be given` TRUE EQUALS JUST TRUE
#ASSERT `s 490.027(3) the court shall cause the notification to be given` FALSE EQUALS JUST FALSE
-- the text gives no time for the act, so the trace has no WITHIN; the party does the act: expected FULFILLED
#TRACE `s 490.027(3) the duty of the court` AT 0 WITH
    PARTY `the court` DOES `s 490.027(3) cause the Commissioner of the Royal Canadian Mounted Police and the Attorney General of the province, or the minister of justice of the territory, to be notified of the decision` AT 1

#ASSERT `s 490.028 an application for one order is deemed to be an application for both` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.028 an application for one order is deemed to be an application for both` TRUE FALSE EQUALS JUST FALSE   -- no application within the period
#ASSERT `s 490.028 an application for one order is deemed to be an application for both` FALSE TRUE EQUALS JUST FALSE   -- eligible for one order only

#ASSERT `s 490.029(1) the appeal may be brought` `s 490.029(1) the Attorney General` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.029(1) the appeal may be brought` `s 490.029(1) the person who applied for a termination order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.029(1) the appeal may be brought` `s 490.029(1) another person` TRUE TRUE EQUALS NOTHING   -- another person
#ASSERT `s 490.029(1) the appeal may be brought` `s 490.029(1) the Attorney General` FALSE TRUE EQUALS NOTHING   -- a different decision
#ASSERT `s 490.029(1) the appeal may be brought` `s 490.029(1) the person who applied for a termination order` TRUE FALSE EQUALS NOTHING   -- a ground raising no question of law or mixed law and fact

#ASSERT `s 490.029(1) the appeal court may do it` `s 490.029(1) dismiss the appeal` EQUALS JUST TRUE
#ASSERT `s 490.029(1) the appeal court may do it` `s 490.029(1) allow the appeal and order a new hearing` EQUALS JUST TRUE
#ASSERT `s 490.029(1) the appeal court may do it` `s 490.029(1) quash the termination order` EQUALS JUST TRUE
#ASSERT `s 490.029(1) the appeal court may do it` `s 490.029(1) make an order that may be made under subsection 490.027(1)` EQUALS JUST TRUE
#ASSERT `s 490.029(1) the appeal court may do it` `s 490.029(1) another thing` EQUALS NOTHING

#ASSERT `s 490.029(2) the appeal court shall cause the notification to be given` TRUE EQUALS JUST TRUE
#ASSERT `s 490.029(2) the appeal court shall cause the notification to be given` FALSE EQUALS JUST FALSE
-- the text gives no time for the act, so the trace has no WITHIN; the party does the act: expected FULFILLED
#TRACE `s 490.029(2) the duty of a court of appeal` AT 0 WITH
    PARTY `a court of appeal` DOES `s 490.029(2) cause the Commissioner of the Royal Canadian Mounted Police and the Attorney General of the province, or the minister of justice of the territory, in which the application for the order was made to be notified of the decision` AT 1

-- 490.022(2) and (3): "the earliest of" the days of (2); (3) applies "if none of paragraphs (2)(a) to (c) applies earlier".
#ASSERT `s 490.022 the obligation ends, or applies for life` (JUST (Date 1 3 2010)) (JUST (`s 490.022(3) ends on` (Date 1 6 2015))) EQUALS JUST (`s 490.022(3) ends on` (Date 1 3 2010))   -- (2) is earlier
#ASSERT `s 490.022 the obligation ends, or applies for life` (JUST (Date 1 3 2020)) (JUST (`s 490.022(3) ends on` (Date 1 6 2015))) EQUALS JUST (`s 490.022(3) ends on` (Date 1 6 2015))   -- (3) is earlier
#ASSERT `s 490.022 the obligation ends, or applies for life` (JUST (Date 1 3 2010)) (JUST `s 490.022(3) applies for life`) EQUALS JUST (`s 490.022(3) ends on` (Date 1 3 2010))
#ASSERT `s 490.022 the obligation ends, or applies for life` (JUST (Date 1 3 2010)) NOTHING EQUALS JUST (`s 490.022(3) ends on` (Date 1 3 2010))
#ASSERT `s 490.022 the obligation ends, or applies for life` NOTHING (JUST (`s 490.022(3) ends on` (Date 1 6 2015))) EQUALS JUST (`s 490.022(3) ends on` (Date 1 6 2015))
#ASSERT `s 490.022 the obligation ends, or applies for life` NOTHING (JUST `s 490.022(3) applies for life`) EQUALS JUST `s 490.022(3) applies for life`
#ASSERT `s 490.022 the obligation ends, or applies for life` NOTHING NOTHING EQUALS NOTHING
