IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc1-s25-law-enforcement`

-- ccc1-tests-s25-law-enforcement.l4 -- tests for sections 25 and 25.1 of the Criminal Code (Canada). Expected values are written by hand from the text of each subsection.
-- Arguments are positional, in GIVEN order.

§ `s 25(1)  (required or authorized by law; capacity; s 2 peace officer or public officer; acts on reasonable grounds)`
#ASSERT `s 25(1) the person is justified in doing what they are required or authorized to do` TRUE `s 25(1)(a) as a private person` (JUST FALSE) TRUE EQUALS JUST TRUE   -- (a) a private person, on reasonable grounds
#ASSERT `s 25(1) the person is justified in doing what they are required or authorized to do` TRUE `s 25(1)(b) as a peace officer or public officer` (JUST TRUE) TRUE EQUALS JUST TRUE   -- (b) a peace officer or public officer
#ASSERT `s 25(1) the person is justified in doing what they are required or authorized to do` TRUE `s 25(1)(c) in aid of a peace officer or public officer` (JUST FALSE) TRUE EQUALS JUST TRUE   -- (c) in aid of one
#ASSERT `s 25(1) the person is justified in doing what they are required or authorized to do` TRUE `s 25(1)(d) by virtue of his office` (JUST FALSE) TRUE EQUALS JUST TRUE   -- (d) by virtue of his office
#ASSERT `s 25(1) the person is justified in doing what they are required or authorized to do` TRUE `s 25(1)(b) as a peace officer or public officer` NOTHING TRUE EQUALS NOTHING   -- section 2 did not say whether the person is a peace officer or public officer
#ASSERT `s 25(1) the person is justified in doing what they are required or authorized to do` TRUE `s 25(1)(b) as a peace officer or public officer` (JUST FALSE) TRUE EQUALS NOTHING   -- not a peace officer or public officer, though acting as one
#ASSERT `s 25(1) the person is justified in doing what they are required or authorized to do` TRUE `s 25(1)(a) as a private person` (JUST FALSE) FALSE EQUALS JUST FALSE   -- not on reasonable grounds: "if he acts on reasonable grounds"
#ASSERT `s 25(1) the person is justified in doing what they are required or authorized to do` TRUE `s 25(1)(b) as a peace officer or public officer` (JUST TRUE) FALSE EQUALS JUST FALSE   -- same, a peace officer
#ASSERT `s 25(1) the person is justified in doing what they are required or authorized to do` FALSE `s 25(1)(a) as a private person` (JUST FALSE) TRUE EQUALS NOTHING   -- not required or authorized by law
#ASSERT `s 25(1) the person is justified in doing what they are required or authorized to do` TRUE `s 25(1) in none of those capacities` (JUST FALSE) TRUE EQUALS NOTHING   -- none of the four capacities: the list is not closed
#ASSERT `s 25(1) the person is justified in using as much force as is necessary for that purpose` (JUST TRUE) TRUE EQUALS JUST TRUE   -- justified, and no more force than necessary
#ASSERT `s 25(1) the person is justified in using as much force as is necessary for that purpose` (JUST TRUE) FALSE EQUALS NOTHING   -- more force than necessary: the subsection says only "as much force as is necessary"
#ASSERT `s 25(1) the person is justified in using as much force as is necessary for that purpose` (JUST FALSE) TRUE EQUALS JUST FALSE   -- not justified under (1): carried through
#ASSERT `s 25(1) the person is justified in using as much force as is necessary for that purpose` NOTHING TRUE EQUALS NOTHING   -- not covered under (1): carried through

§ `s 25(2)  (required or authorized to execute a process or carry out a sentence, or assisting; good faith; defective or without jurisdiction)`
#ASSERT `s 25(2) the person is justified in executing the process or in carrying out the sentence` TRUE TRUE FALSE EQUALS JUST TRUE   -- in good faith
#ASSERT `s 25(2) the person is justified in executing the process or in carrying out the sentence` TRUE TRUE TRUE EQUALS JUST TRUE   -- the process is defective or without jurisdiction: "notwithstanding"
#ASSERT `s 25(2) the person is justified in executing the process or in carrying out the sentence` TRUE FALSE FALSE EQUALS JUST FALSE   -- not in good faith
#ASSERT `s 25(2) the person is justified in executing the process or in carrying out the sentence` TRUE FALSE TRUE EQUALS JUST FALSE   -- not in good faith
#ASSERT `s 25(2) the person is justified in executing the process or in carrying out the sentence` FALSE TRUE FALSE EQUALS JUST FALSE   -- "Where a person is required or authorized by law to execute a process or to carry out a sentence" is not met
#ASSERT `s 25(2) the person is justified in executing the process or in carrying out the sentence` FALSE FALSE FALSE EQUALS JUST FALSE   -- same

§ `s 25(3)  (deadly force; believes it necessary for self-preservation; subsection (4) or (5) applies)`
#ASSERT `s 25(3) subsection (3) bars justification under subsection (1) for the force` TRUE FALSE FALSE EQUALS JUST TRUE   -- deadly force without that belief: barred
#ASSERT `s 25(3) subsection (3) bars justification under subsection (1) for the force` TRUE TRUE FALSE EQUALS JUST FALSE   -- "unless the person believes on reasonable grounds" it is necessary for self-preservation: not barred
#ASSERT `s 25(3) subsection (3) bars justification under subsection (1) for the force` TRUE FALSE TRUE EQUALS JUST FALSE   -- "Subject to subsections (4) and (5)"
#ASSERT `s 25(3) subsection (3) bars justification under subsection (1) for the force` TRUE TRUE TRUE EQUALS JUST FALSE   -- both
#ASSERT `s 25(3) subsection (3) bars justification under subsection (1) for the force` FALSE FALSE FALSE EQUALS NOTHING   -- force not intended or likely to cause death or grievous bodily harm: the subsection is silent
#ASSERT `s 25(3) subsection (3) bars justification under subsection (1) for the force` FALSE TRUE FALSE EQUALS NOTHING   -- same

§ `s 25(4)  (peace officer by s 2; assisting; (a) lawfully arresting; (b) arrestable without warrant; (c) takes flight; (d) believes necessary; (e) not preventable otherwise)`
#ASSERT `s 25(4) the person is justified in using force intended or likely to cause death or grievous bodily harm to the person to be arrested` (JUST TRUE) FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- a peace officer, all five conditions
#ASSERT `s 25(4) the person is justified in using force intended or likely to cause death or grievous bodily harm to the person to be arrested` (JUST FALSE) TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- a person lawfully assisting the peace officer
#ASSERT `s 25(4) the person is justified in using force intended or likely to cause death or grievous bodily harm to the person to be arrested` NOTHING TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- assisting: whether the person is a peace officer does not matter
#ASSERT `s 25(4) the person is justified in using force intended or likely to cause death or grievous bodily harm to the person to be arrested` (JUST TRUE) FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- (a) not proceeding lawfully to arrest: "if" the five conditions
#ASSERT `s 25(4) the person is justified in using force intended or likely to cause death or grievous bodily harm to the person to be arrested` (JUST TRUE) FALSE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- (b) not an offence for which arrest is without warrant: "if" the five conditions
#ASSERT `s 25(4) the person is justified in using force intended or likely to cause death or grievous bodily harm to the person to be arrested` (JUST TRUE) FALSE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- (c) the person does not take flight: "if" the five conditions
#ASSERT `s 25(4) the person is justified in using force intended or likely to cause death or grievous bodily harm to the person to be arrested` (JUST TRUE) FALSE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- (d) no belief on reasonable grounds that the force is necessary: "if" the five conditions
#ASSERT `s 25(4) the person is justified in using force intended or likely to cause death or grievous bodily harm to the person to be arrested` (JUST TRUE) FALSE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- (e) the flight can be prevented by reasonable means in a less violent manner: "if" the five conditions
#ASSERT `s 25(4) the person is justified in using force intended or likely to cause death or grievous bodily harm to the person to be arrested` (JUST FALSE) FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING   -- not a peace officer and not assisting one
#ASSERT `s 25(4) the person is justified in using force intended or likely to cause death or grievous bodily harm to the person to be arrested` NOTHING FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING   -- section 2 did not answer whether the person is a peace officer

§ `s 25(5)  (peace officer by s 2; escaping from a penitentiary; (a) believes a threat; (b) escape not preventable otherwise)`
#ASSERT `s 25(5) the peace officer is justified in using force intended or likely to cause death or grievous bodily harm against the inmate` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE   -- all conditions
#ASSERT `s 25(5) the peace officer is justified in using force intended or likely to cause death or grievous bodily harm against the inmate` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE   -- (b) not met
#ASSERT `s 25(5) the peace officer is justified in using force intended or likely to cause death or grievous bodily harm against the inmate` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE   -- (a) not met
#ASSERT `s 25(5) the peace officer is justified in using force intended or likely to cause death or grievous bodily harm against the inmate` (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING   -- not an inmate escaping from a penitentiary
#ASSERT `s 25(5) the peace officer is justified in using force intended or likely to cause death or grievous bodily harm against the inmate` (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING   -- not a peace officer
#ASSERT `s 25(5) the peace officer is justified in using force intended or likely to cause death or grievous bodily harm against the inmate` NOTHING TRUE TRUE TRUE EQUALS NOTHING   -- section 2 did not answer

§ `s 25.1(1)  (definitions)`
#ASSERT `s 25.1(1) the competent authority with respect to the public officer or senior official` `s 25.1(1)(a) a member of the Royal Canadian Mounted Police` EQUALS JUST `s 25.1(1)(a) the Minister of Public Safety and Emergency Preparedness, personally`   -- (a)
#ASSERT `s 25.1(1) the competent authority with respect to the public officer or senior official` `s 25.1(1)(b) a member of a police service constituted under the laws of a province` EQUALS JUST `s 25.1(1)(b) the Minister responsible for policing in the province, personally`   -- (b)
#ASSERT `s 25.1(1) the competent authority with respect to the public officer or senior official` `s 25.1(1)(c) any other public officer or senior official` EQUALS JUST `s 25.1(1)(c) the Minister who has responsibility for the Act of Parliament that the officer or official has the power to enforce, personally`   -- (c)
#ASSERT `s 25.1(1) the competent authority with respect to the public officer or senior official` `s 25.1(1) neither a public officer nor a senior official` EQUALS NOTHING   -- not with respect to a public officer or a senior official
#ASSERT `s 25.1(1) the person is a public officer` (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST TRUE   -- a peace officer
#ASSERT `s 25.1(1) the person is a public officer` (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST TRUE   -- a public officer who has the powers of a peace officer under an Act of Parliament
#ASSERT `s 25.1(1) the person is a public officer` (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST FALSE   -- a public officer without those powers: "public officer means"
#ASSERT `s 25.1(1) the person is a public officer` (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST FALSE   -- neither
#ASSERT `s 25.1(1) the person is a public officer` NOTHING (JUST FALSE) FALSE EQUALS NOTHING   -- section 2 did not answer whether the person is a peace officer: carried through
#ASSERT `s 25.1(1) the person is a public officer` NOTHING (JUST TRUE) TRUE EQUALS JUST TRUE   -- a public officer with the powers is enough
#ASSERT `s 25.1(1) the person is a public officer` (JUST FALSE) NOTHING TRUE EQUALS NOTHING   -- section 2 did not answer whether the person is a public officer
#ASSERT `s 25.1(1) the person is a public officer, or acts at the direction of one` (JUST TRUE) FALSE EQUALS JUST TRUE   -- a public officer
#ASSERT `s 25.1(1) the person is a public officer, or acts at the direction of one` (JUST FALSE) TRUE EQUALS JUST TRUE   -- acts at the direction of one
#ASSERT `s 25.1(1) the person is a public officer, or acts at the direction of one` (JUST FALSE) FALSE EQUALS JUST FALSE   -- neither
#ASSERT `s 25.1(1) the person is a public officer, or acts at the direction of one` NOTHING FALSE EQUALS NOTHING   -- not answered
#ASSERT `s 25.1(1) the person is a public officer, or acts at the direction of one` NOTHING TRUE EQUALS JUST TRUE   -- acts at the direction of one
#ASSERT `s 25.1(1) the person is a senior official` TRUE TRUE EQUALS JUST TRUE   -- responsible for law enforcement and designated under (5)
#ASSERT `s 25.1(1) the person is a senior official` TRUE FALSE EQUALS JUST FALSE   -- not designated: "senior official means"
#ASSERT `s 25.1(1) the person is a senior official` FALSE TRUE EQUALS JUST FALSE   -- not responsible for law enforcement
#ASSERT `s 25.1(1) the person is a senior official` FALSE FALSE EQUALS JUST FALSE   -- neither

§ `s 25.1(3) to (7)`
#ASSERT `s 25.1(3) the competent authority may designate the person as a public officer for the purposes of sections 25.1 to 25.4` TRUE (JUST TRUE) EQUALS JUST TRUE   -- the competent authority designates a public officer
#ASSERT `s 25.1(3) the competent authority may designate the person as a public officer for the purposes of sections 25.1 to 25.4` TRUE (JUST FALSE) EQUALS NOTHING   -- not a public officer
#ASSERT `s 25.1(3) the competent authority may designate the person as a public officer for the purposes of sections 25.1 to 25.4` TRUE NOTHING EQUALS NOTHING   -- not answered
#ASSERT `s 25.1(3) the competent authority may designate the person as a public officer for the purposes of sections 25.1 to 25.4` FALSE (JUST TRUE) EQUALS NOTHING   -- not the competent authority
#ASSERT `s 25.1(3.1) the competent authority is barred from designating the public officer` TRUE FALSE EQUALS JUST TRUE   -- an authority of (a) or (b) with no public authority to review: barred
#ASSERT `s 25.1(3.1) the competent authority is barred from designating the public officer` TRUE TRUE EQUALS JUST FALSE   -- "unless there is a public authority composed of persons who are not peace officers"
#ASSERT `s 25.1(3.1) the competent authority is barred from designating the public officer` FALSE FALSE EQUALS NOTHING   -- an authority of (c): the subsection is silent
#ASSERT `s 25.1(3.1) the competent authority is barred from designating the public officer` FALSE TRUE EQUALS NOTHING   -- same
#ASSERT `s 25.1(3.2) the designation is conclusive evidence that the person or body is a public authority described in subsection (3.1)` TRUE EQUALS JUST TRUE   -- designated by the Governor in Council or the lieutenant governor in council
#ASSERT `s 25.1(3.2) the designation is conclusive evidence that the person or body is a public authority described in subsection (3.1)` FALSE EQUALS NOTHING   -- designated by someone else
#ASSERT `s 25.1(3.2) the Governor in Council or the lieutenant governor in council may designate the person or body as a public authority` TRUE EQUALS JUST TRUE   -- the Governor in Council or lieutenant governor in council
#ASSERT `s 25.1(3.2) the Governor in Council or the lieutenant governor in council may designate the person or body as a public authority` FALSE EQUALS NOTHING   -- someone else
#ASSERT `s 25.1(4) the designation was made as subsection (4) requires` TRUE TRUE EQUALS JUST TRUE   -- on the advice of a senior official, considering the duties generally
#ASSERT `s 25.1(4) the designation was made as subsection (4) requires` TRUE FALSE EQUALS NOTHING   -- the subsection does not say what follows
#ASSERT `s 25.1(4) the designation was made as subsection (4) requires` FALSE TRUE EQUALS NOTHING   -- same
#ASSERT `s 25.1(4) the designation was made as subsection (4) requires` FALSE FALSE EQUALS NOTHING   -- same
#ASSERT `s 25.1(5) the competent authority may designate the person as a senior official for the purposes of sections 25.1 to 25.4` TRUE EQUALS JUST TRUE   -- the competent authority
#ASSERT `s 25.1(5) the competent authority may designate the person as a senior official for the purposes of sections 25.1 to 25.4` FALSE EQUALS NOTHING   -- someone else
#ASSERT `s 25.1(6) the senior official may designate the public officer` (JUST TRUE) 48 TRUE TRUE EQUALS JUST TRUE   -- 48 hours: "not more than 48 hours"
#ASSERT `s 25.1(6) the senior official may designate the public officer` (JUST TRUE) 47 TRUE TRUE EQUALS JUST TRUE   -- 47 hours
#ASSERT `s 25.1(6) the senior official may designate the public officer` (JUST TRUE) 48.01 TRUE TRUE EQUALS JUST FALSE   -- more than 48 hours
#ASSERT `s 25.1(6) the senior official may designate the public officer` (JUST TRUE) 49 FALSE FALSE EQUALS JUST FALSE   -- more than 48 hours, whatever the opinions
#ASSERT `s 25.1(6) the senior official may designate the public officer` (JUST TRUE) 1 FALSE TRUE EQUALS NOTHING   -- not of the opinion that it is not feasible for the competent authority to designate
#ASSERT `s 25.1(6) the senior official may designate the public officer` (JUST TRUE) 1 TRUE FALSE EQUALS NOTHING   -- not of the opinion that the officer would be justified
#ASSERT `s 25.1(6) the senior official may designate the public officer` (JUST FALSE) 1 TRUE TRUE EQUALS NOTHING   -- not a senior official
#ASSERT `s 25.1(6) the senior official may designate the public officer` NOTHING 1 TRUE TRUE EQUALS NOTHING   -- not answered
#ASSERT `s 25.1(6) the senior official has notified the competent authority of the designation without delay` TRUE TRUE EQUALS JUST TRUE   -- notified without delay
#ASSERT `s 25.1(6) the senior official has notified the competent authority of the designation without delay` TRUE FALSE EQUALS JUST FALSE   -- notified, but not without delay
#ASSERT `s 25.1(6) the senior official has notified the competent authority of the designation without delay` FALSE TRUE EQUALS JUST FALSE   -- not notified
#ASSERT `s 25.1(6) the senior official has notified the competent authority of the designation without delay` FALSE FALSE EQUALS JUST FALSE   -- neither
#ASSERT `s 25.1(7) the designation may be made subject to the condition` TRUE `s 25.1(7)(a) the duration of the designation` EQUALS JUST TRUE   -- (a)
#ASSERT `s 25.1(7) the designation may be made subject to the condition` TRUE `s 25.1(7)(b) the nature of the conduct in the investigation of which a public officer may be justified in committing, or directing another person to commit, acts or omissions that would otherwise constitute an offence` EQUALS JUST TRUE   -- (b)
#ASSERT `s 25.1(7) the designation may be made subject to the condition` TRUE `s 25.1(7)(c) the acts or omissions that would otherwise constitute an offence and that a public officer may be justified in committing or directing another person to commit` EQUALS JUST TRUE   -- (c)
#ASSERT `s 25.1(7) the designation may be made subject to the condition` TRUE `s 25.1(7) something else` EQUALS NOTHING   -- "including": not closed
#ASSERT `s 25.1(7) the designation may be made subject to the condition` FALSE `s 25.1(7)(a) the duration of the designation` EQUALS NOTHING   -- not a designation under (3) or (6)

§ `s 25.1(8) to (14)`
#ASSERT `s 25.1(8) the public officer is justified in committing the act or omission` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE   -- (a), (b) and (c)
#ASSERT `s 25.1(8) the public officer is justified in committing the act or omission` (JUST TRUE) FALSE TRUE TRUE EQUALS JUST FALSE   -- (a) not met
#ASSERT `s 25.1(8) the public officer is justified in committing the act or omission` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE   -- (b) not designated
#ASSERT `s 25.1(8) the public officer is justified in committing the act or omission` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE   -- (c) no belief on reasonable grounds
#ASSERT `s 25.1(8) the public officer is justified in committing the act or omission` (JUST FALSE) TRUE TRUE TRUE EQUALS NOTHING   -- not a public officer
#ASSERT `s 25.1(8) the public officer is justified in committing the act or omission` NOTHING TRUE TRUE TRUE EQUALS NOTHING   -- not answered
#ASSERT `s 25.1(9) subsection (9) bars the public officer's justification` TRUE TRUE TRUE FALSE `s 25.1(9)(b) none of those things` EQUALS JUST FALSE   -- (a): personally authorized in writing: not barred
#ASSERT `s 25.1(9) subsection (9) bars the public officer's justification` TRUE TRUE FALSE TRUE `s 25.1(9)(b)(i) preserve the life or safety of any person` EQUALS JUST FALSE   -- (b)(i): no authorization feasible, and necessary: not barred
#ASSERT `s 25.1(9) subsection (9) bars the public officer's justification` TRUE TRUE FALSE TRUE `s 25.1(9)(b)(ii) prevent the compromise of the identity of a public officer acting in an undercover capacity, of a confidential informant or of a person acting covertly under the direction and control of a public officer` EQUALS JUST FALSE   -- (b)(ii): no authorization feasible, and necessary: not barred
#ASSERT `s 25.1(9) subsection (9) bars the public officer's justification` TRUE TRUE FALSE TRUE `s 25.1(9)(b)(iii) prevent the imminent loss or destruction of evidence of an indictable offence` EQUALS JUST FALSE   -- (b)(iii): no authorization feasible, and necessary: not barred
#ASSERT `s 25.1(9) subsection (9) bars the public officer's justification` TRUE TRUE FALSE TRUE `s 25.1(9)(b) none of those things` EQUALS JUST TRUE   -- (b) belief, but the act is not necessary to any of (i) to (iii): barred
#ASSERT `s 25.1(9) subsection (9) bars the public officer's justification` TRUE TRUE FALSE FALSE `s 25.1(9)(b)(i) preserve the life or safety of any person` EQUALS JUST TRUE   -- no belief that obtaining authorization was not feasible: barred
#ASSERT `s 25.1(9) subsection (9) bars the public officer's justification` TRUE TRUE FALSE FALSE `s 25.1(9)(b) none of those things` EQUALS JUST TRUE   -- neither (a) nor (b): barred
#ASSERT `s 25.1(9) subsection (9) bars the public officer's justification` TRUE FALSE TRUE FALSE `s 25.1(9)(b) none of those things` EQUALS JUST TRUE   -- authorized, but "in addition to meeting the conditions set out in paragraphs (8)(a) to (c)", which are not met: barred
#ASSERT `s 25.1(9) subsection (9) bars the public officer's justification` TRUE FALSE FALSE TRUE `s 25.1(9)(b)(i) preserve the life or safety of any person` EQUALS JUST TRUE   -- same for (b)
#ASSERT `s 25.1(9) subsection (9) bars the public officer's justification` FALSE TRUE TRUE FALSE `s 25.1(9)(b) none of those things` EQUALS NOTHING   -- no likely loss of or serious damage to property, and no directing under (10): the subsection is silent
#ASSERT `s 25.1(10) the person is justified in committing the act or omission at the direction of a public officer` TRUE TRUE TRUE EQUALS JUST TRUE   -- directed, believing the authority and the purpose
#ASSERT `s 25.1(10) the person is justified in committing the act or omission at the direction of a public officer` FALSE TRUE TRUE EQUALS JUST FALSE   -- not directed by a public officer
#ASSERT `s 25.1(10) the person is justified in committing the act or omission at the direction of a public officer` TRUE FALSE TRUE EQUALS JUST FALSE   -- no belief in the authority
#ASSERT `s 25.1(10) the person is justified in committing the act or omission at the direction of a public officer` TRUE TRUE FALSE EQUALS JUST FALSE   -- no belief in the purpose
#ASSERT `s 25.1(11) the section justifies the conduct` `s 25.1(11)(a) the intentional or criminally negligent causing of death or bodily harm to another person` EQUALS JUST FALSE   -- (a)
#ASSERT `s 25.1(11) the section justifies the conduct` `s 25.1(11)(b) the wilful attempt in any manner to obstruct, pervert or defeat the course of justice` EQUALS JUST FALSE   -- (b)
#ASSERT `s 25.1(11) the section justifies the conduct` `s 25.1(11)(c) conduct that would violate the sexual integrity of an individual` EQUALS JUST FALSE   -- (c)
#ASSERT `s 25.1(11) the section justifies the conduct` `s 25.1(11) other conduct` EQUALS NOTHING   -- other conduct: silent
#ASSERT `s 25.1(12) the section affects the protection, defences and immunities recognized under the law of Canada` TRUE EQUALS JUST FALSE   -- "Nothing in this section affects"
#ASSERT `s 25.1(12) the section affects the protection, defences and immunities recognized under the law of Canada` FALSE EQUALS NOTHING   -- not recognized under the law of Canada
#ASSERT `s 25.1(13) the section relieves the public officer of criminal liability for failing to comply with the requirement` TRUE EQUALS JUST FALSE   -- "Nothing in this section relieves"
#ASSERT `s 25.1(13) the section relieves the public officer of criminal liability for failing to comply with the requirement` FALSE EQUALS NOTHING   -- not a requirement governing the collection of evidence
#ASSERT `s 25.1(14) the section justifies the act or omission` TRUE EQUALS JUST FALSE   -- an offence under Part I of the Controlled Drugs and Substances Act, its regulations, or Division 1 of Part 1 of the Cannabis Act
#ASSERT `s 25.1(14) the section justifies the act or omission` FALSE EQUALS NOTHING   -- another offence
#ASSERT `s 25.1 the public officer is justified, subject to subsections (9), (11) and (14)` (JUST TRUE) (JUST FALSE) NOTHING NOTHING EQUALS JUST TRUE   -- (8) holds, no limit applies
#ASSERT `s 25.1 the public officer is justified, subject to subsections (9), (11) and (14)` (JUST TRUE) (JUST TRUE) NOTHING NOTHING EQUALS JUST FALSE   -- barred by (9)
#ASSERT `s 25.1 the public officer is justified, subject to subsections (9), (11) and (14)` (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING EQUALS JUST FALSE   -- (11) names the conduct
#ASSERT `s 25.1 the public officer is justified, subject to subsections (9), (11) and (14)` (JUST TRUE) (JUST FALSE) NOTHING (JUST FALSE) EQUALS JUST FALSE   -- (14)
#ASSERT `s 25.1 the public officer is justified, subject to subsections (9), (11) and (14)` (JUST FALSE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE   -- (8) not met
#ASSERT `s 25.1 the public officer is justified, subject to subsections (9), (11) and (14)` NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING   -- nothing answered
#ASSERT `s 25.1 the public officer is justified, subject to subsections (9), (11) and (14)` (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST TRUE   -- (9) not engaged
