-- args: arrested with a warrant and in custody, s 469 listing, endorsed under 507(6), issues an appearance notice, the person gives an undertaking
#ASSERT `s 499 a peace officer may release the person arrested with a warrant` TRUE (JUST FALSE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 499 a peace officer may release the person arrested with a warrant` TRUE (JUST FALSE) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 499 a peace officer may release the person arrested with a warrant` TRUE (JUST FALSE) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 499 a peace officer may release the person arrested with a warrant` TRUE (JUST FALSE) FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 499 a peace officer may release the person arrested with a warrant` TRUE (JUST TRUE) TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 499 a peace officer may release the person arrested with a warrant` TRUE NOTHING TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 499 a peace officer may release the person arrested with a warrant` FALSE (JUST FALSE) TRUE TRUE FALSE EQUALS NOTHING
