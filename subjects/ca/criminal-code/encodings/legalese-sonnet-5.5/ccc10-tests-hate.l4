IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc10-hate`

-- ccc10-tests-hate.l4 -- tests for ccc10-hate.l4 (ss 318 to 320.1). Expected values are written by hand from the text, beside each assertion.
-- (The assertion lines were laid out by a script from a table of hand-written rows, each carrying its expected value and its basis in the text; the script reads no encoding output.)
-- A regulative rule is run with #TRACE and its outcome stated in a comment (a DEONTIC value cannot be asserted on the stable binary).

`s 318 fixture: the general summary conviction penalty` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
GIVEN maximum IS A `Length of time`
GIVETH A Punishment
`s 318 fixture: on indictment at most` MEANS Punishment OF `by indictment`, (`imprisonment for a term of` maximum), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `s 318 -- Advocating genocide`

#ASSERT `s 318(1) the person is guilty of the offence of advocating genocide` TRUE EQUALS JUST TRUE   -- advocates or promotes genocide
#ASSERT `s 318(1) the person is guilty of the offence of advocating genocide` FALSE EQUALS NOTHING   -- no advocating or promoting
#ASSERT `s 318(1) the class of the offence` EQUALS `an indictable offence`   -- "guilty of an indictable offence"
#ASSERT `s 318(1) the punishment` EQUALS `s 318 fixture: on indictment at most` `five years`   -- "not more than five years"
#ASSERT `s 318(2) the act is genocide` TRUE FALSE TRUE EQUALS JUST TRUE   -- (a): killing members of the group, with intent to destroy
#ASSERT `s 318(2) the act is genocide` FALSE TRUE TRUE EQUALS JUST TRUE   -- (b): deliberately inflicting conditions of life calculated to bring about physical destruction
#ASSERT `s 318(2) the act is genocide` TRUE FALSE FALSE EQUALS JUST FALSE   -- no intent to destroy in whole or in part any identifiable group: "means"
#ASSERT `s 318(2) the act is genocide` FALSE FALSE TRUE EQUALS JUST FALSE   -- neither (a) nor (b)
#ASSERT `s 318(3) a proceeding may not be instituted under section 318` FALSE EQUALS JUST TRUE   -- no consent of the Attorney General: the bar
#ASSERT `s 318(3) a proceeding may not be instituted under section 318` TRUE EQUALS NOTHING   -- consent given: the bar does not apply and the section says nothing more
#ASSERT `s 318(4) the section of the public is an identifiable group` TRUE `s 318(4) colour` EQUALS JUST TRUE   -- distinguished by colour
#ASSERT `s 318(4) the section of the public is an identifiable group` TRUE `s 318(4) race` EQUALS JUST TRUE   -- distinguished by race
#ASSERT `s 318(4) the section of the public is an identifiable group` TRUE `s 318(4) religion` EQUALS JUST TRUE   -- distinguished by religion
#ASSERT `s 318(4) the section of the public is an identifiable group` TRUE `s 318(4) national or ethnic origin` EQUALS JUST TRUE   -- distinguished by national or ethnic origin
#ASSERT `s 318(4) the section of the public is an identifiable group` TRUE `s 318(4) age` EQUALS JUST TRUE   -- distinguished by age
#ASSERT `s 318(4) the section of the public is an identifiable group` TRUE `s 318(4) sex` EQUALS JUST TRUE   -- distinguished by sex
#ASSERT `s 318(4) the section of the public is an identifiable group` TRUE `s 318(4) sexual orientation` EQUALS JUST TRUE   -- distinguished by sexual orientation
#ASSERT `s 318(4) the section of the public is an identifiable group` TRUE `s 318(4) gender identity or expression` EQUALS JUST TRUE   -- distinguished by gender identity or expression
#ASSERT `s 318(4) the section of the public is an identifiable group` TRUE `s 318(4) mental or physical disability` EQUALS JUST TRUE   -- distinguished by mental or physical disability
#ASSERT `s 318(4) the section of the public is an identifiable group` TRUE `s 318(4) another ground` EQUALS JUST FALSE   -- a ground the definition does not name: "means"
#ASSERT `s 318(4) the section of the public is an identifiable group` FALSE `s 318(4) race` EQUALS JUST FALSE   -- not a section of the public
§ `s 319 -- Public incitement of hatred and wilful promotion of hatred`

#ASSERT `s 319(1) the person is guilty of the offence of public incitement of hatred` TRUE TRUE TRUE EQUALS JUST TRUE   -- communicates statements in a public place, incites hatred, likely to lead to a breach of the peace
#ASSERT `s 319(1) the person is guilty of the offence of public incitement of hatred` FALSE TRUE TRUE EQUALS NOTHING   -- not in a public place
#ASSERT `s 319(1) the person is guilty of the offence of public incitement of hatred` TRUE FALSE TRUE EQUALS NOTHING   -- does not incite hatred
#ASSERT `s 319(1) the person is guilty of the offence of public incitement of hatred` TRUE TRUE FALSE EQUALS NOTHING   -- not likely to lead to a breach of the peace
#ASSERT `s 319(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 319(1) the punishment` `by indictment` `s 318 fixture: the general summary conviction penalty` EQUALS `s 318 fixture: on indictment at most` `two years`   -- (a): "not exceeding two years"
#ASSERT `s 319(1) the punishment` `on summary conviction` `s 318 fixture: the general summary conviction penalty` EQUALS `s 318 fixture: the general summary conviction penalty`   -- (b): s 787(1)
#ASSERT `s 319(2) the person is guilty of the offence of wilful promotion of hatred` TRUE TRUE EQUALS JUST TRUE   -- communicates statements other than in private conversation; wilfully promotes hatred
#ASSERT `s 319(2) the person is guilty of the offence of wilful promotion of hatred` FALSE TRUE EQUALS NOTHING   -- private conversation
#ASSERT `s 319(2) the person is guilty of the offence of wilful promotion of hatred` TRUE FALSE EQUALS NOTHING   -- not wilfully promoting hatred
#ASSERT `s 319(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 319(2) the punishment` `by indictment` `s 318 fixture: the general summary conviction penalty` EQUALS `s 318 fixture: on indictment at most` `two years`   -- (a)
#ASSERT `s 319(2) the punishment` `on summary conviction` `s 318 fixture: the general summary conviction penalty` EQUALS `s 318 fixture: the general summary conviction penalty`   -- (b)
#ASSERT `s 319(2.1) the person is guilty of the offence of wilful promotion of antisemitism` TRUE TRUE EQUALS JUST TRUE   -- wilfully promotes antisemitism by condoning, denying or downplaying the Holocaust
#ASSERT `s 319(2.1) the person is guilty of the offence of wilful promotion of antisemitism` TRUE FALSE EQUALS NOTHING   -- no such promotion
#ASSERT `s 319(2.1) the person is guilty of the offence of wilful promotion of antisemitism` FALSE TRUE EQUALS NOTHING   -- private conversation
#ASSERT `s 319(2.1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 319(2.1) the punishment` `by indictment` `s 318 fixture: the general summary conviction penalty` EQUALS `s 318 fixture: on indictment at most` `two years`   -- (a)
#ASSERT `s 319(2.1) the punishment` `on summary conviction` `s 318 fixture: the general summary conviction penalty` EQUALS `s 318 fixture: the general summary conviction penalty`   -- (b)
#ASSERT `s 319(2.2) the person commits the offence of wilful promotion of hatred by displaying a symbol` TRUE TRUE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE   -- (a): a symbol of a listed entity
#ASSERT `s 319(2.2) the person commits the offence of wilful promotion of hatred by displaying a symbol` TRUE TRUE (JUST FALSE) TRUE FALSE EQUALS JUST TRUE   -- (b): the Nazi Hakenkreuz, the double Sig-Rune or a noose
#ASSERT `s 319(2.2) the person commits the offence of wilful promotion of hatred by displaying a symbol` TRUE TRUE (JUST FALSE) FALSE TRUE EQUALS JUST TRUE   -- (c): so nearly resembles a symbol of (a) or (b)
#ASSERT `s 319(2.2) the person commits the offence of wilful promotion of hatred by displaying a symbol` TRUE TRUE (JUST FALSE) FALSE FALSE EQUALS NOTHING   -- none of (a) to (c)
#ASSERT `s 319(2.2) the person commits the offence of wilful promotion of hatred by displaying a symbol` TRUE TRUE NOTHING FALSE FALSE EQUALS NOTHING   -- whether the entity is a listed entity (s 83.01(1)) is not determined
#ASSERT `s 319(2.2) the person commits the offence of wilful promotion of hatred by displaying a symbol` TRUE TRUE NOTHING TRUE FALSE EQUALS JUST TRUE   -- (b) holds whatever s 83.01(1) says
#ASSERT `s 319(2.2) the person commits the offence of wilful promotion of hatred by displaying a symbol` FALSE TRUE (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- no wilful promotion of hatred
#ASSERT `s 319(2.2) the person commits the offence of wilful promotion of hatred by displaying a symbol` TRUE FALSE (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- not by displaying in a public place
#ASSERT `s 319(2.3) the person who commits an offence under subsection (2.2) is guilty of the offence` (JUST TRUE) EQUALS JUST TRUE   -- an offence under (2.2)
#ASSERT `s 319(2.3) the person who commits an offence under subsection (2.2) is guilty of the offence` (JUST FALSE) EQUALS NOTHING   -- no offence under (2.2)
#ASSERT `s 319(2.3) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 319(2.3) the punishment` `by indictment` `s 318 fixture: the general summary conviction penalty` EQUALS `s 318 fixture: on indictment at most` `two years`   -- (a)
#ASSERT `s 319(2.3) the punishment` `on summary conviction` `s 318 fixture: the general summary conviction penalty` EQUALS `s 318 fixture: the general summary conviction penalty`   -- (b)
#ASSERT `s 319(3) the person is not to be convicted of an offence under subsection (2)` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a): establishes that the statements were true
#ASSERT `s 319(3) the person is not to be convicted of an offence under subsection (2)` TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE   -- (c): relevant to a subject of public interest, and on reasonable grounds believed true
#ASSERT `s 319(3) the person is not to be convicted of an offence under subsection (2)` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- (c): relevant, but no belief on reasonable grounds
#ASSERT `s 319(3) the person is not to be convicted of an offence under subsection (2)` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE   -- (c): believed true, but not relevant to a subject of public interest
#ASSERT `s 319(3) the person is not to be convicted of an offence under subsection (2)` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- (d): in good faith intended to point out matters for the purpose of removal
#ASSERT `s 319(3) the person is not to be convicted of an offence under subsection (2)` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- none of (a), (c), (d): this section gives no defence on these facts
#ASSERT `s 319(3) the person is not to be convicted of an offence under subsection (2)` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING   -- not a charge under subsection (2)
#ASSERT `s 319(3.1) the person is not to be convicted of an offence under subsection (2.1)` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a): they establish that the statements were true
#ASSERT `s 319(3.1) the person is not to be convicted of an offence under subsection (2.1)` TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE   -- (c): relevant, and on reasonable grounds believed true
#ASSERT `s 319(3.1) the person is not to be convicted of an offence under subsection (2.1)` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- (c): no belief on reasonable grounds
#ASSERT `s 319(3.1) the person is not to be convicted of an offence under subsection (2.1)` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- (d): in good faith intended to point out matters producing feelings of antisemitism toward Jews
#ASSERT `s 319(3.1) the person is not to be convicted of an offence under subsection (2.1)` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- none holds: no defence on these facts
#ASSERT `s 319(3.1) the person is not to be convicted of an offence under subsection (2.1)` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING   -- not a charge under subsection (2.1)
#ASSERT `s 319(3.2) the person is not to be convicted of an offence under subsection (2.2)` TRUE TRUE FALSE EQUALS JUST TRUE   -- (a): the display was for a legitimate purpose not contrary to the public interest
#ASSERT `s 319(3.2) the person is not to be convicted of an offence under subsection (2.2)` TRUE FALSE TRUE EQUALS JUST TRUE   -- (b): in good faith, to point out matters for the purpose of removal
#ASSERT `s 319(3.2) the person is not to be convicted of an offence under subsection (2.2)` TRUE FALSE FALSE EQUALS JUST FALSE   -- neither: no defence on these facts
#ASSERT `s 319(3.2) the person is not to be convicted of an offence under subsection (2.2)` FALSE TRUE FALSE EQUALS NOTHING   -- not a charge under subsection (2.2)
#ASSERT `s 319(3) to (3.2) the person is guilty of the offence after the defence` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- no defence
#ASSERT `s 319(3) to (3.2) the person is guilty of the offence after the defence` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE   -- "No person shall be convicted of an offence under subsection (2)"
#ASSERT `s 319(3) to (3.2) the person is guilty of the offence after the defence` (JUST TRUE) NOTHING EQUALS NOTHING   -- the defence is not determined
#ASSERT `s 319(3) to (3.2) the person is guilty of the offence after the defence` NOTHING (JUST FALSE) EQUALS NOTHING   -- the offence is not determined
#ASSERT `s 319(3) to (3.2) the person is guilty of the offence after the defence` NOTHING (JUST TRUE) EQUALS JUST FALSE   -- a defence that applies
#ASSERT `s 319(3)(b) as the text shows it` EQUALS "[Repealed, 2026, c. 15, s. 4]"   -- line 6052
#ASSERT `s 319(3.1)(b) as the text shows it` EQUALS "[Repealed, 2026, c. 15, s. 4]"   -- line 6058
#ASSERT `s 319(4) the presiding judge may order the thing to be forfeited to His Majesty in right of the province` (`Provision of the Code` OF 319, "(1)") TRUE TRUE EQUALS JUST TRUE   -- convicted of subsection (1)
#ASSERT `s 319(4) the presiding judge may order the thing to be forfeited to His Majesty in right of the province` (`Provision of the Code` OF 319, "(2)") TRUE TRUE EQUALS JUST TRUE   -- convicted of (2)
#ASSERT `s 319(4) the presiding judge may order the thing to be forfeited to His Majesty in right of the province` (`Provision of the Code` OF 319, "(2.1)") TRUE TRUE EQUALS JUST TRUE   -- convicted of (2.1)
#ASSERT `s 319(4) the presiding judge may order the thing to be forfeited to His Majesty in right of the province` (`Provision of the Code` OF 319, "(2.2)") TRUE TRUE EQUALS JUST TRUE   -- convicted of (2.2)
#ASSERT `s 319(4) the presiding judge may order the thing to be forfeited to His Majesty in right of the province` (`Provision of the Code` OF 318, "(1)") TRUE TRUE EQUALS JUST TRUE   -- convicted of section 318
#ASSERT `s 319(4) the presiding judge may order the thing to be forfeited to His Majesty in right of the province` (`Provision of the Code` OF 319, "(3)") TRUE TRUE EQUALS NOTHING   -- convicted of subsection (3) is not listed
#ASSERT `s 319(4) the presiding judge may order the thing to be forfeited to His Majesty in right of the province` (`Provision of the Code` OF 319, "(2.3)") TRUE TRUE EQUALS NOTHING   -- convicted of (2.3) is not listed
#ASSERT `s 319(4) the presiding judge may order the thing to be forfeited to His Majesty in right of the province` (`Provision of the Code` OF 320, "(1)") TRUE TRUE EQUALS NOTHING   -- convicted of section 320 is not listed
#ASSERT `s 319(4) the presiding judge may order the thing to be forfeited to His Majesty in right of the province` (`Provision of the Code` OF 319, "(1)") FALSE TRUE EQUALS NOTHING   -- not convicted
#ASSERT `s 319(4) the presiding judge may order the thing to be forfeited to His Majesty in right of the province` (`Provision of the Code` OF 319, "(1)") TRUE FALSE EQUALS NOTHING   -- not anything by means of or in relation to which the offence was committed
#ASSERT `s 319(5) subsections 199(6) and (7) apply to the offence` (`Provision of the Code` OF 319, "(1)") EQUALS JUST TRUE   -- subsection (1)
#ASSERT `s 319(5) subsections 199(6) and (7) apply to the offence` (`Provision of the Code` OF 319, "(2.2)") EQUALS JUST TRUE   -- (2.2)
#ASSERT `s 319(5) subsections 199(6) and (7) apply to the offence` (`Provision of the Code` OF 318, "(1)") EQUALS JUST TRUE   -- section 318
#ASSERT `s 319(5) subsections 199(6) and (7) apply to the offence` (`Provision of the Code` OF 319, "(3)") EQUALS NOTHING   -- subsection (3) is not named
#ASSERT `s 319(6) the communication incites or promotes hatred` TRUE EQUALS JUST FALSE   -- "does not incite or promote hatred ... solely because it discredits, humiliates, hurts or offends"
#ASSERT `s 319(6) the communication incites or promotes hatred` FALSE EQUALS NOTHING   -- another reason: the section says nothing
#ASSERT `s 319(6.1) a proceeding for the offence may not be instituted` (`Provision of the Code` OF 319, "(2)") FALSE EQUALS JUST TRUE   -- subsection (2), no consent of the Attorney General: the bar
#ASSERT `s 319(6.1) a proceeding for the offence may not be instituted` (`Provision of the Code` OF 319, "(2.1)") FALSE EQUALS JUST TRUE   -- subsection (2.1), no consent of the Attorney General: the bar
#ASSERT `s 319(6.1) a proceeding for the offence may not be instituted` (`Provision of the Code` OF 319, "(2.2)") FALSE EQUALS JUST TRUE   -- subsection (2.2), no consent of the Attorney General: the bar
#ASSERT `s 319(6.1) a proceeding for the offence may not be instituted` (`Provision of the Code` OF 319, "(1)") FALSE EQUALS NOTHING   -- subsection (1) is outside the bar
#ASSERT `s 319(6.1) a proceeding for the offence may not be instituted` (`Provision of the Code` OF 319, "(2)") TRUE EQUALS NOTHING   -- consent given
-- 319(7): the six defined terms.

#ASSERT `s 319(7) the act is communicating` TRUE EQUALS JUST TRUE   -- "communicating includes communicating by telephone, broadcasting or other audible or visible means"
#ASSERT `s 319(7) the act is communicating` FALSE EQUALS NOTHING   -- "includes": the list is not closed
#ASSERT `s 319(7) the emotion is hatred` TRUE TRUE EQUALS JUST TRUE   -- of an intense and extreme nature, clearly associated with vilification and detestation
#ASSERT `s 319(7) the emotion is hatred` TRUE FALSE EQUALS JUST FALSE   -- "means": not associated with vilification and detestation
#ASSERT `s 319(7) the emotion is hatred` FALSE TRUE EQUALS JUST FALSE   -- not intense and extreme
#ASSERT `s 319(7) the events are the Holocaust` TRUE TRUE TRUE EQUALS JUST TRUE   -- planned and deliberate state-sponsored persecution and annihilation of European Jewry by the Nazis and their collaborators, 1933 to 1945
#ASSERT `s 319(7) the events are the Holocaust` FALSE TRUE TRUE EQUALS JUST FALSE   -- not those events
#ASSERT `s 319(7) the events are the Holocaust` TRUE FALSE TRUE EQUALS JUST FALSE   -- not by the Nazis and their collaborators
#ASSERT `s 319(7) the events are the Holocaust` TRUE TRUE FALSE EQUALS JUST FALSE   -- not from 1933 to 1945
#ASSERT `s 319(7) the section of the public is an identifiable group` (JUST TRUE) EQUALS JUST TRUE   -- "has the same meaning as in section 318": passed through
#ASSERT `s 319(7) the section of the public is an identifiable group` (JUST FALSE) EQUALS JUST FALSE   -- passed through
#ASSERT `s 319(7) the section of the public is an identifiable group` NOTHING EQUALS NOTHING   -- passed through: not determined
#ASSERT `s 319(7) the place is a public place` TRUE FALSE EQUALS JUST TRUE   -- access as of right
#ASSERT `s 319(7) the place is a public place` FALSE TRUE EQUALS JUST TRUE   -- access by invitation, express or implied
#ASSERT `s 319(7) the place is a public place` FALSE FALSE EQUALS NOTHING   -- "includes": another kind of place is not excluded
#ASSERT `s 319(7) the form is a statement` `s 319(7) words spoken` EQUALS JUST TRUE   -- "statements includes ... words spoken"
#ASSERT `s 319(7) the form is a statement` `s 319(7) words written` EQUALS JUST TRUE   -- "statements includes ... words written"
#ASSERT `s 319(7) the form is a statement` `s 319(7) words recorded electronically or electro-magnetically or otherwise` EQUALS JUST TRUE   -- "statements includes ... words recorded electronically or electro-magnetically or otherwise"
#ASSERT `s 319(7) the form is a statement` `s 319(7) gestures` EQUALS JUST TRUE   -- "statements includes ... gestures"
#ASSERT `s 319(7) the form is a statement` `s 319(7) signs or other visible representations` EQUALS JUST TRUE   -- "statements includes ... signs or other visible representations"
#ASSERT `s 319(7) the form is a statement` `s 319(7) a form that is none of those` EQUALS NOTHING   -- "includes": another form is not excluded
§ `s 320 -- Warrant of seizure`

#ASSERT `s 320(1) the judge shall issue a warrant under his hand authorizing seizure of the copies` TRUE TRUE EQUALS JUST TRUE   -- satisfied by information on oath; copies kept for sale or distribution in premises within the jurisdiction
#ASSERT `s 320(1) the judge shall issue a warrant under his hand authorizing seizure of the copies` TRUE FALSE EQUALS JUST FALSE   -- copies not kept for sale or distribution in premises within the jurisdiction
#ASSERT `s 320(1) the judge shall issue a warrant under his hand authorizing seizure of the copies` FALSE TRUE EQUALS JUST FALSE   -- not satisfied by information on oath
-- #TRACE (read): the judge issues the warrant at time 1 -> FULFILLED.
#TRACE `s 320(1) the duty of the judge to issue the warrant` AT 0 WITH
    PARTY `a judge` DOES `s 320(1) issue a warrant under his hand authorizing seizure of the copies` AT 1
#ASSERT `s 320(2) the judge issued the summons to the occupier within seven days of the issue of the warrant` (Date 1 1 2026) (Date 8 1 2026) EQUALS JUST TRUE   -- 7 days: within seven days
#ASSERT `s 320(2) the judge issued the summons to the occupier within seven days of the issue of the warrant` (Date 1 1 2026) (Date 9 1 2026) EQUALS JUST FALSE   -- 8 days: too late
#ASSERT `s 320(2) the judge issued the summons to the occupier within seven days of the issue of the warrant` (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST TRUE   -- the same day
-- #TRACE (read): a summons at day 7 -> FULFILLED; no summons by day 8 -> DEONTIC BREACHED.
#TRACE `s 320(2) the duty of the judge to issue the summons within seven days` AT 0 WITH
    PARTY `a judge` DOES `s 320(2) issue a summons to the occupier of the premises requiring him to appear before the court and show cause why the matter seized should not be forfeited to Her Majesty` AT 7
#TRACE `s 320(2) the duty of the judge to issue the summons within seven days` AT 0 WITH
    (WAITUNTIL 8)
#ASSERT `s 320(3) the person may appear and be represented in the proceedings` TRUE TRUE EQUALS JUST TRUE   -- the owner or author appears to oppose forfeiture
#ASSERT `s 320(3) the person may appear and be represented in the proceedings` TRUE FALSE EQUALS NOTHING   -- appears for another purpose
#ASSERT `s 320(3) the person may appear and be represented in the proceedings` FALSE TRUE EQUALS NOTHING   -- neither the owner nor the author
#ASSERT `s 320(4) the court shall make an order declaring the matter forfeited to Her Majesty in right of the province` TRUE EQUALS JUST TRUE   -- satisfied that the publication is hate propaganda
#ASSERT `s 320(4) the court shall make an order declaring the matter forfeited to Her Majesty in right of the province` FALSE EQUALS JUST FALSE   -- not satisfied: the "If" fails
-- #TRACE (read): the court makes the order at time 1 -> FULFILLED.
#TRACE `s 320(4) the duty of the court to order forfeiture` AT 0 WITH
    PARTY `the court` DOES `s 320(4) make an order declaring the matter forfeited to Her Majesty in right of the province in which the proceedings take place` AT 1
#ASSERT `s 320(5) the court shall order that the matter be restored to the person from whom it was seized` TRUE EQUALS JUST TRUE   -- not satisfied that the publication is hate propaganda
#ASSERT `s 320(5) the court shall order that the matter be restored to the person from whom it was seized` FALSE EQUALS JUST FALSE   -- satisfied: the "If" fails
#ASSERT `s 320(5) the matter cannot yet be restored until the time for final appeal has expired` TRUE FALSE EQUALS JUST TRUE   -- not satisfied; the time for final appeal has not expired: cannot yet
#ASSERT `s 320(5) the matter cannot yet be restored until the time for final appeal has expired` TRUE TRUE EQUALS JUST FALSE   -- the time for final appeal has expired: the bar is over
#ASSERT `s 320(5) the matter cannot yet be restored until the time for final appeal has expired` FALSE FALSE EQUALS NOTHING   -- the court is satisfied: no restoration to bar
-- #TRACE (read): the court orders restoration at time 1 -> FULFILLED.
#TRACE `s 320(5) the duty of the court to order restoration` AT 0 WITH
    PARTY `the court` DOES `s 320(5) order that the matter be restored to the person from whom it was seized` AT 1
#ASSERT `s 320(6) an appeal lies from the order` TRUE TRUE `s 320(6)(a) a question of law alone` EQUALS JUST TRUE   -- (a): a question of law alone
#ASSERT `s 320(6) an appeal lies from the order` TRUE TRUE `s 320(6)(b) a question of fact alone` EQUALS JUST TRUE   -- (b): a question of fact alone
#ASSERT `s 320(6) an appeal lies from the order` TRUE TRUE `s 320(6)(c) a question of mixed law and fact` EQUALS JUST TRUE   -- (c): mixed law and fact
#ASSERT `s 320(6) an appeal lies from the order` TRUE TRUE `s 320(6) a ground of another kind` EQUALS NOTHING   -- another ground: not covered
#ASSERT `s 320(6) an appeal lies from the order` FALSE TRUE `s 320(6)(a) a question of law alone` EQUALS NOTHING   -- not an order under (4) or (5)
#ASSERT `s 320(6) an appeal lies from the order` TRUE FALSE `s 320(6)(a) a question of law alone` EQUALS NOTHING   -- did not appear in the proceedings
#ASSERT `s 320(6) sections 673 to 696 apply with such modifications as the circumstances require` TRUE EQUALS JUST TRUE   -- an appeal from an order under (4) or (5)
#ASSERT `s 320(6) sections 673 to 696 apply with such modifications as the circumstances require` FALSE EQUALS NOTHING   -- another order
#ASSERT `s 320(7) a proceeding may not be instituted under section 320` FALSE EQUALS JUST TRUE   -- no consent of the Attorney General: the bar
#ASSERT `s 320(7) a proceeding may not be instituted under section 320` TRUE EQUALS NOTHING   -- consent given
