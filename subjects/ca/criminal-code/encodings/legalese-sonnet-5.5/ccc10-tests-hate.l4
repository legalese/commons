#ASSERT `s 320(8)(c.1) as the text shows it` EQUALS "[Repealed, 1992, c. 51, s. 36]"   -- line 6106
#ASSERT `s 320(8) the act is genocide` (JUST TRUE) EQUALS JUST TRUE   -- "genocide has the same meaning as in section 318"
#ASSERT `s 320(8) the act is genocide` NOTHING EQUALS NOTHING   -- passed through
#ASSERT `s 320(8) the matter is hate propaganda` TRUE TRUE FALSE EQUALS JUST TRUE   -- a writing, sign or visible representation that advocates or promotes genocide
#ASSERT `s 320(8) the matter is hate propaganda` TRUE FALSE TRUE EQUALS JUST TRUE   -- the communication of which would constitute an offence under section 319
#ASSERT `s 320(8) the matter is hate propaganda` TRUE FALSE FALSE EQUALS JUST FALSE   -- "means": neither limb
#ASSERT `s 320(8) the matter is hate propaganda` FALSE TRUE FALSE EQUALS JUST FALSE   -- not a writing, sign or visible representation
#ASSERT `s 320(8) the person is a judge` TRUE EQUALS JUST TRUE   -- "judge means a judge of a court"
#ASSERT `s 320(8) the person is a judge` FALSE EQUALS JUST FALSE   -- "means"
§ `s 320.1 -- Warrant of seizure (computer system)`

#ASSERT `s 320.1(1) the judge may order the custodian of the computer system to give an electronic copy, ensure the material is no longer available, and identify the person who posted it` TRUE TRUE EQUALS JUST TRUE   -- satisfied by information on oath; the computer system is within the jurisdiction
#ASSERT `s 320.1(1) the judge may order the custodian of the computer system to give an electronic copy, ensure the material is no longer available, and identify the person who posted it` TRUE FALSE EQUALS NOTHING   -- a grant with an "If" gate: outside the jurisdiction, not covered (ruling of 2026-11-12)
#ASSERT `s 320.1(1) the judge may order the custodian of the computer system to give an electronic copy, ensure the material is no longer available, and identify the person who posted it` FALSE TRUE EQUALS NOTHING   -- not satisfied: not covered
-- #TRACE (read): the judge orders at time 1 -> FULFILLED (a permission).
#TRACE `s 320.1(1) the permission of the judge` AT 0 WITH
    PARTY `a judge` DOES `s 320.1(1) order the custodian of the computer system to give an electronic copy of the material to the court, ensure that the material is no longer stored on and made available through the computer system, and provide the information necessary to identify and locate the person who posted the material` AT 1
#ASSERT `s 320.1(2) the judge shall cause notice to be given to the person who posted the material` TRUE TRUE EQUALS JUST TRUE   -- the information received; notice within a reasonable time
#ASSERT `s 320.1(2) the judge shall cause notice to be given to the person who posted the material` TRUE FALSE EQUALS JUST FALSE   -- not within a reasonable time
#ASSERT `s 320.1(2) the judge shall cause notice to be given to the person who posted the material` FALSE TRUE EQUALS NOTHING   -- no information received under (1)(c)
#ASSERT `s 320.1(2) the judge may order the custodian to post the text of the notice` TRUE EQUALS JUST TRUE   -- the person cannot be identified or located or does not reside in Canada
#ASSERT `s 320.1(2) the judge may order the custodian to post the text of the notice` FALSE EQUALS NOTHING   -- a grant with an "If" gate
#ASSERT `s 320.1(3) the person who posted the material may appear and be represented in the proceedings` TRUE TRUE EQUALS JUST TRUE   -- the person who posted the material, to oppose an order under (5)
#ASSERT `s 320.1(3) the person who posted the material may appear and be represented in the proceedings` TRUE FALSE EQUALS NOTHING   -- appears for another purpose
#ASSERT `s 320.1(3) the person who posted the material may appear and be represented in the proceedings` FALSE TRUE EQUALS NOTHING   -- not the person who posted the material
#ASSERT `s 320.1(4) the court may proceed ex parte to hear and determine the proceedings in the absence of the person` TRUE EQUALS JUST TRUE   -- the person does not appear
#ASSERT `s 320.1(4) the court may proceed ex parte to hear and determine the proceedings in the absence of the person` FALSE EQUALS NOTHING   -- a grant with an "If" gate: not covered
#ASSERT `s 320.1(5) the court may order the custodian of the computer system to delete the material` TRUE EQUALS JUST TRUE   -- satisfied on a balance of probabilities
#ASSERT `s 320.1(5) the court may order the custodian of the computer system to delete the material` FALSE EQUALS NOTHING   -- a grant with an "If" gate: not covered
#ASSERT `s 320.1(6) the court may order the destruction of the electronic copy in the court’s possession` TRUE EQUALS JUST TRUE   -- when the court makes the order for deletion
#ASSERT `s 320.1(6) the court may order the destruction of the electronic copy in the court’s possession` FALSE EQUALS JUST FALSE   -- a "When" gate that fails: ruling (b) of 2026-11-05 (F46)
#ASSERT `s 320.1(7) the court shall order that the electronic copy be returned to the custodian and terminate the order under paragraph (1)(b)` TRUE EQUALS JUST TRUE   -- not satisfied
#ASSERT `s 320.1(7) the court shall order that the electronic copy be returned to the custodian and terminate the order under paragraph (1)(b)` FALSE EQUALS JUST FALSE   -- satisfied: the "If" fails
#ASSERT `s 320.1(8) subsections 320(6) to (8) apply to the proceeding` TRUE EQUALS JUST TRUE   -- a proceeding under section 320.1
#ASSERT `s 320.1(8) subsections 320(6) to (8) apply to the proceeding` FALSE EQUALS NOTHING   -- another proceeding
#ASSERT `s 320.1(9) the order cannot yet take effect until the time for final appeal has expired` TRUE FALSE EQUALS JUST TRUE   -- an order under (5) to (7); the time has not expired: cannot yet take effect
#ASSERT `s 320.1(9) the order cannot yet take effect until the time for final appeal has expired` TRUE TRUE EQUALS JUST FALSE   -- the time has expired: the bar is over
#ASSERT `s 320.1(9) the order cannot yet take effect until the time for final appeal has expired` FALSE FALSE EQUALS NOTHING   -- not an order under (5) to (7)
