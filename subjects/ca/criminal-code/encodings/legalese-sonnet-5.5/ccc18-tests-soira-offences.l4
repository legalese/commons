IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc18-soira-offences`

-- ccc18-tests-soira-offences.l4 -- tests for ccc18-soira-offences.l4. Expected values are written from the text of the Criminal Code
-- (R.S.C., 1985, c. C-46, lines 10275-10956 of the plain-text rendering), beside each assertion, and not copied from the module's own output.

-- 490.03(1): to the prosecutor for a proceeding under section 490.012; to the Attorney General for a proceeding under the listed sections, or an appeal from a decision in them or in a proceeding under 490.012 or 490.013.
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the prosecutor` TRUE TRUE (`Provision of the Code` OF 490.012, "(3)") FALSE EQUALS JUST TRUE
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the prosecutor` TRUE TRUE (`Provision of the Code` OF 490.023, "(2)") FALSE EQUALS JUST FALSE   -- the prosecutor's limb is 490.012 only
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the prosecutor` TRUE FALSE (`Provision of the Code` OF 490.012, "(3)") FALSE EQUALS JUST FALSE   -- not necessary
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the prosecutor` FALSE TRUE (`Provision of the Code` OF 490.012, "(3)") FALSE EQUALS JUST FALSE   -- no request
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.016, "") FALSE EQUALS JUST TRUE
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.023, "(2)") FALSE EQUALS JUST TRUE
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.027, "(1)") FALSE EQUALS JUST TRUE
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.02905, "(2)") FALSE EQUALS JUST TRUE
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.029051, "(2)") FALSE EQUALS JUST TRUE
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.02909, "(1)") FALSE EQUALS JUST TRUE
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.029111, "(2)") FALSE EQUALS JUST TRUE
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.029112, "(2)") FALSE EQUALS JUST TRUE
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.02913, "(1)") FALSE EQUALS JUST TRUE
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.04, "(5)") FALSE EQUALS JUST TRUE
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.05, "(4)") FALSE EQUALS JUST TRUE
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.012, "(3)") FALSE EQUALS JUST FALSE   -- a 490.012 proceeding itself is the prosecutor's, not the Attorney General's
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.012, "(3)") TRUE EQUALS JUST TRUE   -- an appeal from a decision in a proceeding under 490.012
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.013, "(2)") TRUE EQUALS JUST TRUE   -- an appeal from a decision in a proceeding under 490.013
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE TRUE (`Provision of the Code` OF 490.014, "") TRUE EQUALS JUST FALSE   -- not one of the listed proceedings
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) the Attorney General` TRUE FALSE (`Provision of the Code` OF 490.023, "(2)") FALSE EQUALS JUST FALSE   -- not necessary
#ASSERT `s 490.03(1) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the registered information` `s 490.03(1) another person` TRUE TRUE (`Provision of the Code` OF 490.023, "(2)") FALSE EQUALS NOTHING
-- no time is stated ("on request"); the Commissioner discloses: expected FULFILLED
#TRACE `s 490.03(1)(a) the duty of the Commissioner to disclose to the prosecutor` AT 0 WITH
    PARTY `s 490.03(1) the Commissioner of the Royal Canadian Mounted Police or a person authorized by the Commissioner` DOES `s 490.03(1) disclose, on request, information that is registered in the database, or the fact that such information is registered, to the prosecutor` AT 1
#TRACE `s 490.03(1)(b) the duty of the Commissioner to disclose to the Attorney General` AT 0 WITH
    PARTY `s 490.03(1) the Commissioner of the Royal Canadian Mounted Police or a person authorized by the Commissioner` DOES `s 490.03(1) disclose, on request, information that is registered in the database, or the fact that such information is registered, to the Attorney General` AT 1

#ASSERT `s 490.03(2) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the information to the prosecutor or Attorney General` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.03(2) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the information to the prosecutor or Attorney General` TRUE FALSE EQUALS JUST FALSE   -- the person did not disclose the fact
#ASSERT `s 490.03(2) the Commissioner or a person authorized by the Commissioner shall, on request, disclose the information to the prosecutor or Attorney General` FALSE TRUE EQUALS JUST FALSE   -- no request
#TRACE `s 490.03(2) the duty of the Commissioner to disclose to the prosecutor or Attorney General` AT 0 WITH
    PARTY `s 490.03(1) the Commissioner of the Royal Canadian Mounted Police or a person authorized by the Commissioner` DOES `s 490.03(2) disclose, on request, to the prosecutor or Attorney General the information that is registered in the database relating to the person` AT 1

#ASSERT `s 490.03(3) the prosecutor or the Attorney General may disclose the information to the presiding court` TRUE EQUALS JUST TRUE
#ASSERT `s 490.03(3) the prosecutor or the Attorney General may disclose the information to the presiding court` FALSE EQUALS NOTHING

#ASSERT `s 490.031(1) the person is guilty of an offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 490.031(1) the person is guilty of an offence` TRUE TRUE EQUALS NOTHING   -- a reasonable excuse
#ASSERT `s 490.031(1) the person is guilty of an offence` FALSE FALSE EQUALS NOTHING   -- no failure to comply
#ASSERT `s 490.031(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 490.031(1)(a) the punishment on conviction on indictment` EQUALS Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS `imprisonment for a term of` `two years`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 10000, `minimum fine` IS `no fine is stated`
#ASSERT `s 490.031(1)(b) the punishment on summary conviction` EQUALS Punishment WITH `mode` IS `on summary conviction`, `maximum imprisonment` IS `imprisonment for a term of` `two years less a day`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 10000, `minimum fine` IS `no fine is stated`

#ASSERT `s 490.031(2) a lawful command is a reasonable excuse` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.031(2) a lawful command is a reasonable excuse` TRUE FALSE EQUALS NOTHING   -- not subject to the Code of Service Discipline
#ASSERT `s 490.031(2) a lawful command is a reasonable excuse` FALSE TRUE EQUALS NOTHING   -- no lawful command prevented compliance

#ASSERT `s 490.031(3) the certificate is evidence of the statements contained in it without proof of the signature or official character` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.031(3) the certificate is evidence of the statements contained in it without proof of the signature or official character` FALSE TRUE TRUE EQUALS NOTHING   -- other proceedings
#ASSERT `s 490.031(3) the certificate is evidence of the statements contained in it without proof of the signature or official character` TRUE FALSE TRUE EQUALS NOTHING   -- not a certificate of that person
#ASSERT `s 490.031(3) the certificate is evidence of the statements contained in it without proof of the signature or official character` TRUE TRUE FALSE EQUALS NOTHING   -- it does not state a failure

#ASSERT `s 490.031(4) the sex offender may require the attendance of the person who signed the certificate for cross-examination` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.031(4) the sex offender may require the attendance of the person who signed the certificate for cross-examination` TRUE FALSE EQUALS NOTHING   -- without leave
#ASSERT `s 490.031(4) the sex offender may require the attendance of the person who signed the certificate for cross-examination` FALSE TRUE EQUALS NOTHING   -- not the sex offender named

#ASSERT `s 490.031(5) the certificate is not to be received in evidence` TRUE TRUE EQUALS JUST FALSE   -- copy and notice given before trial: the bar does not apply
#ASSERT `s 490.031(5) the certificate is not to be received in evidence` TRUE FALSE EQUALS JUST TRUE   -- no notice
#ASSERT `s 490.031(5) the certificate is not to be received in evidence` FALSE TRUE EQUALS JUST TRUE   -- no copy
#ASSERT `s 490.031(5) the certificate is not to be received in evidence` FALSE FALSE EQUALS JUST TRUE

#ASSERT `s 490.0311 the person is guilty of an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 490.0311 the person is guilty of an offence` FALSE EQUALS NOTHING
#ASSERT `s 490.0311 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 490.0311(a) the punishment on conviction on indictment` EQUALS Punishment WITH `mode` IS `by indictment`, `maximum imprisonment` IS `imprisonment for a term of` `two years`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 10000, `minimum fine` IS `no fine is stated`
#ASSERT `s 490.0311(b) the punishment on summary conviction` EQUALS Punishment WITH `mode` IS `on summary conviction`, `maximum imprisonment` IS `imprisonment for a term of` `two years less a day`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 10000, `minimum fine` IS `no fine is stated`

#ASSERT `s 490.0312 the person is guilty of an offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 490.0312 the person is guilty of an offence` TRUE TRUE EQUALS NOTHING
#ASSERT `s 490.0312 the person is guilty of an offence` FALSE FALSE EQUALS NOTHING
#ASSERT `s 490.0312 the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 490.0312 the punishment on summary conviction` EQUALS Punishment WITH `mode` IS `on summary conviction`, `maximum imprisonment` IS `no imprisonment is stated`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `no fine is stated`, `minimum fine` IS `no fine is stated`

#ASSERT `s 490.03121(1) the justice may issue a warrant in Form 6.4 to arrest the person` TRUE EQUALS JUST TRUE
#ASSERT `s 490.03121(1) the justice may issue a warrant in Form 6.4 to arrest the person` FALSE EQUALS NOTHING
-- a permission: the justice issues the warrant: expected FULFILLED
#TRACE `s 490.03121(1) the power of the justice to issue the warrant` AT 0 WITH
    PARTY `a justice` DOES `s 490.03121(1) issue a warrant in Form 6.4 authorizing a peace officer to arrest the person and bring them to any registration centre to remedy the contravention` AT 1

#ASSERT `s 490.03121(2) the warrant shall contain the condition` TRUE EQUALS JUST TRUE
#ASSERT `s 490.03121(2) the warrant shall contain the condition` FALSE EQUALS NOTHING
#TRACE `s 490.03121(2) the duty of the justice to put the conditions in the warrant` AT 0 WITH
    PARTY `a justice` DOES `s 490.03121(2) put in the warrant any conditions that the justice considers advisable to ensure that an arrest authorized by the warrant is reasonable in the circumstances` AT 1

#ASSERT `s 490.03121(3) the warrant may be executed there` TRUE EQUALS JUST TRUE
#ASSERT `s 490.03121(3) the warrant may be executed there` FALSE EQUALS NOTHING   -- outside Canada: the subsection says nothing

#ASSERT `s 490.03121(4) the warrant remains in force` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 490.03121(4) the warrant remains in force` TRUE FALSE FALSE EQUALS JUST FALSE   -- executed
#ASSERT `s 490.03121(4) the warrant remains in force` FALSE TRUE FALSE EQUALS JUST FALSE   -- a charge under section 490.031 laid
#ASSERT `s 490.03121(4) the warrant remains in force` FALSE FALSE TRUE EQUALS JUST FALSE   -- the contravention remedied

#ASSERT `s 490.03121(5) no charge shall be laid against the person in respect of the contravention` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 490.03121(5) no charge shall be laid against the person in respect of the contravention` TRUE FALSE EQUALS NOTHING   -- not remedied
#ASSERT `s 490.03121(5) no charge shall be laid against the person in respect of the contravention` FALSE TRUE EQUALS NOTHING   -- another contravention
