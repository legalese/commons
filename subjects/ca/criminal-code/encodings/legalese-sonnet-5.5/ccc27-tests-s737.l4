IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc27-s737-surcharge`

-- ccc27-tests-s737.l4 -- tests for section 737. Every expected value is written from the text of the section, beside the assertion.

§ `Tests -- section 737`

-- 737(1): "An offender who is convicted, or discharged under section 730, of an offence under this Act, the Controlled Drugs and Substances Act or the Cannabis Act shall pay a victim surcharge"
#ASSERT `s 737(1) the offender shall pay a victim surcharge` TRUE FALSE `s 737(1) this Act` EQUALS JUST TRUE   -- convicted, this Act
#ASSERT `s 737(1) the offender shall pay a victim surcharge` FALSE TRUE `s 737(1) the Controlled Drugs and Substances Act` EQUALS JUST TRUE   -- discharged under section 730, CDSA
#ASSERT `s 737(1) the offender shall pay a victim surcharge` TRUE FALSE `s 737(1) the Cannabis Act` EQUALS JUST TRUE   -- convicted, Cannabis Act
#ASSERT `s 737(1) the offender shall pay a victim surcharge` TRUE FALSE `s 737(1) some other Act` EQUALS NOTHING   -- outside the three Acts: not covered
#ASSERT `s 737(1) the offender shall pay a victim surcharge` FALSE FALSE `s 737(1) this Act` EQUALS NOTHING   -- neither convicted nor discharged: not covered

-- 737(2): (a) 30% of any fine; (b) if no fine, $100 summary conviction, $200 indictment
#ASSERT `s 737(2) the amount of the victim surcharge` (`a fine of` 1000) `by indictment` EQUALS JUST 300   -- 30% of $1000
#ASSERT `s 737(2) the amount of the victim surcharge` (`a fine of` 1000) `on summary conviction` EQUALS JUST 300   -- the fine decides: the mode is not read when there is a fine
#ASSERT `s 737(2) the amount of the victim surcharge` (`a fine of` 100) `by indictment` EQUALS JUST 30   -- 30% of $100
#ASSERT `s 737(2) the amount of the victim surcharge` `no fine is stated` `on summary conviction` EQUALS JUST 100   -- (b)(i)
#ASSERT `s 737(2) the amount of the victim surcharge` `no fine is stated` `by indictment` EQUALS JUST 200   -- (b)(ii)
#ASSERT `s 737(2) the amount of the victim surcharge` (`a fine in the discretion of the court`) `by indictment` EQUALS NOTHING   -- no amount of fine: 30% cannot be computed

-- 737(2.2) and (2.3)
#ASSERT `s 737(2.3) the imprisonment of the offender alone constitutes undue hardship` TRUE EQUALS JUST FALSE   -- "alone does not constitute undue hardship"
#ASSERT `s 737(2.3) the imprisonment of the offender alone constitutes undue hardship` FALSE EQUALS NOTHING   -- imprisonment is not the only circumstance: (2.3) is silent
#ASSERT `s 737(2.2) undue hardship` TRUE FALSE EQUALS JUST TRUE   -- unable to pay on account of precarious financial circumstances
#ASSERT `s 737(2.2) undue hardship` FALSE FALSE EQUALS JUST FALSE   -- "means the offender is unable to pay": not unable
#ASSERT `s 737(2.2) undue hardship` TRUE TRUE EQUALS JUST FALSE   -- (2.3): imprisonment alone is not undue hardship, even if the offender cannot pay

-- 737(2.1): the court may order no surcharge, or a reduced amount
#ASSERT `s 737(2.1) the court may order the offender to pay no victim surcharge, or a reduced amount` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE   -- (a) undue hardship
#ASSERT `s 737(2.1) the court may order the offender to pay no victim surcharge, or a reduced amount` TRUE (JUST FALSE) TRUE EQUALS JUST TRUE   -- (b) no undue hardship but disproportionate
#ASSERT `s 737(2.1) the court may order the offender to pay no victim surcharge, or a reduced amount` TRUE (JUST FALSE) FALSE EQUALS NOTHING   -- neither limb: not covered (F-2: the other reading is JUST FALSE)
#ASSERT `s 737(2.1) the court may order the offender to pay no victim surcharge, or a reduced amount` TRUE NOTHING TRUE EQUALS NOTHING   -- the answer on undue hardship is itself not covered
#ASSERT `s 737(2.1) the court may order the offender to pay no victim surcharge, or a reduced amount` FALSE (JUST TRUE) FALSE EQUALS NOTHING   -- offence before the day the subsections came into force: subsection (8) does not reach it

-- 737(2.4)
#ASSERT `s 737(2.4) the court must state its reasons in the record of the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 737(2.4) the court must state its reasons in the record of the proceedings` FALSE EQUALS JUST FALSE   -- no order under (2.1): "When the court makes an order" is unmet

-- 737(3)
#ASSERT `s 737(3) the court may order a victim surcharge exceeding the amount in subsection (2)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 737(3) the court may order a victim surcharge exceeding the amount in subsection (2)` TRUE FALSE EQUALS NOTHING   -- not satisfied the offender can pay
#ASSERT `s 737(3) the court may order a victim surcharge exceeding the amount in subsection (2)` FALSE TRUE EQUALS NOTHING   -- not considered appropriate

-- 737(4): within the time the lieutenant governor in council establishes, else a reasonable time
#ASSERT `s 737(4) the time for payment` (JUST 30) EQUALS `s 737(4) within the time established by the lieutenant governor in council` 30
#ASSERT `s 737(4) the time for payment` NOTHING EQUALS `s 737(4) within a reasonable time after its imposition`
#ASSERT `s 737(4) the last day for payment` (Date 1 1 2025) (JUST 30) EQUALS JUST (Date 31 1 2025)   -- 30 days after 1 January 2025
#ASSERT `s 737(4) the last day for payment` (Date 15 2 2024) (JUST 20) EQUALS JUST (Date 6 3 2024)   -- 2024 is a leap year: 15 Feb + 20 days = 6 March
#ASSERT `s 737(4) the last day for payment` (Date 1 1 2025) NOTHING EQUALS NOTHING   -- "a reasonable time" is not a date

-- 737(5)
#ASSERT `s 737(5) the sum is applied to the assistance to victims of offences that the lieutenant governor in council directs` TRUE EQUALS JUST TRUE
#ASSERT `s 737(5) the sum is applied to the assistance to victims of offences that the lieutenant governor in council directs` FALSE EQUALS NOTHING

-- 737(6): all four items, in writing
#ASSERT `s 737(6) the notice is the written notice the court shall cause to be given` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 737(6) the notice is the written notice the court shall cause to be given` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- the amount is missing
#ASSERT `s 737(6) the notice is the written notice the court shall cause to be given` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- the manner of payment is missing
#ASSERT `s 737(6) the notice is the written notice the court shall cause to be given` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- the time is missing
#ASSERT `s 737(6) the notice is the written notice the court shall cause to be given` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- the procedure for a change is missing
#ASSERT `s 737(6) the notice is the written notice the court shall cause to be given` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- not in writing

-- The regulative rule: the court gives the notice at time 1, no deadline is stated, and the trace ends FULFILLED (a #TRACE prints its outcome, not an assertion line; read by eye, and compared across the two builds).
#TRACE `s 737(6) the court shall cause the notice to be given` AT 0 WITH
    PARTY `the court` DOES `s 737(6) give the offender the written notice` AT 1

-- 737(7): 734(3) to (7), 734.3, 734.5, 734.7, 734.8 and 736 apply
#ASSERT `s 737(7) the provision applies, with any modifications that the circumstances require, to a victim surcharge` (`Provision of the Code` OF 734, "(3)") EQUALS JUST TRUE
#ASSERT `s 737(7) the provision applies, with any modifications that the circumstances require, to a victim surcharge` (`Provision of the Code` OF 734, "(7)") EQUALS JUST TRUE
#ASSERT `s 737(7) the provision applies, with any modifications that the circumstances require, to a victim surcharge` (`Provision of the Code` OF 734, "(2)") EQUALS NOTHING   -- 734(2) is not named
#ASSERT `s 737(7) the provision applies, with any modifications that the circumstances require, to a victim surcharge` (`Provision of the Code` OF 734.3, "") EQUALS JUST TRUE
#ASSERT `s 737(7) the provision applies, with any modifications that the circumstances require, to a victim surcharge` (`Provision of the Code` OF 734.5, "") EQUALS JUST TRUE
#ASSERT `s 737(7) the provision applies, with any modifications that the circumstances require, to a victim surcharge` (`Provision of the Code` OF 734.7, "") EQUALS JUST TRUE
#ASSERT `s 737(7) the provision applies, with any modifications that the circumstances require, to a victim surcharge` (`Provision of the Code` OF 734.8, "") EQUALS JUST TRUE
#ASSERT `s 737(7) the provision applies, with any modifications that the circumstances require, to a victim surcharge` (`Provision of the Code` OF 736, "") EQUALS JUST TRUE
#ASSERT `s 737(7) the provision applies, with any modifications that the circumstances require, to a victim surcharge` (`Provision of the Code` OF 734.1, "") EQUALS NOTHING   -- 734.1 is not in the list (the notice is deemed an order made under it, paragraph (b))
#ASSERT `s 737(7)(a) the reference to fine in the provision is read as a reference to victim surcharge` (`Provision of the Code` OF 734, "(4)") EQUALS JUST TRUE
#ASSERT `s 737(7)(a) the reference to fine in the provision is read as a reference to victim surcharge` (`Provision of the Code` OF 734.8, "(5)") EQUALS JUST FALSE   -- "other than in subsection 734.8(5)"
#ASSERT `s 737(7)(a) the reference to fine in the provision is read as a reference to victim surcharge` (`Provision of the Code` OF 734.8, "(1)") EQUALS JUST TRUE
#ASSERT `s 737(7)(a) the reference to fine in the provision is read as a reference to victim surcharge` (`Provision of the Code` OF 100, "") EQUALS NOTHING
#ASSERT `s 737(7)(b) the notice is deemed to be an order made under section 734.1` TRUE EQUALS JUST TRUE
#ASSERT `s 737(7)(b) the notice is deemed to be an order made under section 734.1` FALSE EQUALS NOTHING

-- 737(8)
#ASSERT `s 737(8) subsections (2.1) to (2.4) apply to the offender` TRUE `s 737(1) this Act` TRUE EQUALS JUST TRUE
#ASSERT `s 737(8) subsections (2.1) to (2.4) apply to the offender` TRUE `s 737(1) the Cannabis Act` TRUE EQUALS JUST TRUE
#ASSERT `s 737(8) subsections (2.1) to (2.4) apply to the offender` TRUE `s 737(1) this Act` FALSE EQUALS NOTHING   -- the offence was committed before the day
#ASSERT `s 737(8) subsections (2.1) to (2.4) apply to the offender` TRUE `s 737(1) some other Act` TRUE EQUALS NOTHING   -- not one of the three Acts
#ASSERT `s 737(8) subsections (2.1) to (2.4) apply to the offender` FALSE `s 737(1) this Act` TRUE EQUALS NOTHING   -- not sentenced
