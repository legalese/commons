IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc20-part16-notices`

-- ccc20-tests-notices.l4 -- tests for ccc20-part16-notices.l4 (ss 500 to 502.1). Expected values are hand-written from the text of lines 11144-11200.

§ `Tests -- section 500: the appearance notice`
-- (1) args: (a) name, date of birth, contact; (b) substance of the offence; (c) attend court; the accused is required to appear at a judicial referral hearing for a s 496 failure; the notice indicates it
#ASSERT `s 500(1) the appearance notice meets the requirements of paragraphs (a) to (d)` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 500(1) the appearance notice meets the requirements of paragraphs (a) to (d)` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 500(1) the appearance notice meets the requirements of paragraphs (a) to (d)` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 500(1) the appearance notice meets the requirements of paragraphs (a) to (d)` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 500(1) the appearance notice meets the requirements of paragraphs (a) to (d)` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 500(1) the appearance notice meets the requirements of paragraphs (a) to (d)` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 500(1) the appearance notice meets the requirements of paragraphs (a) to (d)` TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- (2) a summary of subsections 145(3) and (6), section 512.2, subsections 524(4) and (6.2) and the consequences of failing to appear at a judicial referral hearing
#ASSERT `s 500(2) the appearance notice sets out the required summary` TRUE EQUALS JUST TRUE
#ASSERT `s 500(2) the appearance notice sets out the required summary` FALSE EQUALS JUST FALSE
-- (3) may require attendance for the Identification of Criminals Act only if the accused is alleged to have committed an offence referred to in paragraph 2(1)(c) of that Act
#ASSERT `s 500(3) the appearance notice may require the accused to appear for the purposes of the Identification of Criminals Act` TRUE EQUALS JUST TRUE
#ASSERT `s 500(3) the appearance notice may require the accused to appear for the purposes of the Identification of Criminals Act` FALSE EQUALS NOTHING
-- (4) request to sign in duplicate and a duplicate given; lack of signature does not invalidate
#ASSERT `s 500(4) the officer has done what subsection (4) requires about the signature` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 500(4) the officer has done what subsection (4) requires about the signature` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 500(4) the officer has done what subsection (4) requires about the signature` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 500(4) the lack of the accused's signature invalidates the appearance notice` TRUE EQUALS JUST FALSE
#ASSERT `s 500(4) the lack of the accused's signature invalidates the appearance notice` FALSE EQUALS NOTHING

§ `Tests -- section 501: the undertaking`
-- (1) args: the undertaking is one given under 498(1)(c), 499(b) or 503(1.1)(b); (a); (b); (c)
#ASSERT `s 501(1) the undertaking sets out the required contents` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 501(1) the undertaking sets out the required contents` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 501(1) the undertaking sets out the required contents` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 501(1) the undertaking sets out the required contents` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 501(1) the undertaking sets out the required contents` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- (2) the mandatory condition
#ASSERT `s 501(2) the undertaking contains the mandatory condition` TRUE EQUALS JUST TRUE
#ASSERT `s 501(2) the undertaking contains the mandatory condition` FALSE EQUALS JUST FALSE
-- (3) args: the condition, reasonable, necessary for attendance, necessary for the safety and security of a victim or witness, necessary to prevent repetition, amount in dollars, accused not ordinarily resident in the province or not within 200 km
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(a) report at specified times to the peace officer or other specified person` TRUE TRUE FALSE FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(b) remain within a specified territorial jurisdiction` TRUE TRUE FALSE FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(c) notify the peace officer or other specified person of any change in address, employment or occupation` TRUE TRUE FALSE FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(d) abstain from communicating with any victim, witness or other person identified in the undertaking` TRUE TRUE FALSE FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(e) abstain from going to any specified place or entering any geographic area related to any person referred to in paragraph (d)` TRUE TRUE FALSE FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(f) deposit all passports with the peace officer or other specified person` TRUE TRUE FALSE FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(g) reside at a specified address, be at that address at specified hours and present themselves to a peace officer or other specified person` TRUE TRUE FALSE FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(h) abstain from possessing a firearm, cross-bow, prohibited weapon, restricted weapon, prohibited device, firearm part, ammunition, prohibited ammunition or explosive substance, and surrender them and any authorization, licence or registration certificate` TRUE TRUE FALSE FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(k) comply with any other specified condition for ensuring the safety and security of any victim of or witness to the offence` TRUE TRUE FALSE FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(a) report at specified times to the peace officer or other specified person` TRUE FALSE TRUE FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(a) report at specified times to the peace officer or other specified person` TRUE FALSE FALSE TRUE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(a) report at specified times to the peace officer or other specified person` TRUE FALSE FALSE FALSE 0 FALSE EQUALS NOTHING
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(a) report at specified times to the peace officer or other specified person` FALSE TRUE TRUE TRUE 0 FALSE EQUALS NOTHING
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(i) promise to pay an amount specified in the undertaking` TRUE TRUE FALSE FALSE 500 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(i) promise to pay an amount specified in the undertaking` TRUE TRUE FALSE FALSE 500.01 FALSE EQUALS JUST FALSE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(i) promise to pay an amount specified in the undertaking` TRUE TRUE FALSE FALSE 501 FALSE EQUALS JUST FALSE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(i) promise to pay an amount specified in the undertaking` TRUE TRUE FALSE FALSE 0 FALSE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(j) deposit money or other valuable security` TRUE TRUE FALSE FALSE 500 TRUE EQUALS JUST TRUE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(j) deposit money or other valuable security` TRUE TRUE FALSE FALSE 501 TRUE EQUALS JUST FALSE
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3)(j) deposit money or other valuable security` TRUE TRUE FALSE FALSE 500 FALSE EQUALS NOTHING
#ASSERT `s 501(3) the undertaking may contain the condition` `s 501(3) a condition the list does not name` TRUE TRUE TRUE TRUE 0 FALSE EQUALS NOTHING
-- (4), (5), (6)
#ASSERT `s 501(4) the undertaking may require the accused to appear for the purposes of the Identification of Criminals Act` TRUE EQUALS JUST TRUE
#ASSERT `s 501(4) the undertaking may require the accused to appear for the purposes of the Identification of Criminals Act` FALSE EQUALS NOTHING
#ASSERT `s 501(5) the officer has delivered the deposit to a justice as required` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 501(5) the officer has delivered the deposit to a justice as required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 501(5) the officer has delivered the deposit to a justice as required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 501(6) the officer has done what subsection (6) requires about the signature` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 501(6) the officer has done what subsection (6) requires about the signature` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 501(6) the officer has done what subsection (6) requires about the signature` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 501(6) the lack of the accused's signature invalidates the undertaking` TRUE EQUALS JUST FALSE
#ASSERT `s 501(6) the lack of the accused's signature invalidates the undertaking` FALSE EQUALS NOTHING

§ `Tests -- section 502: variation of an undertaking`
-- (1) args: released on an undertaking under 498, 499 or 503; the accused consents in writing; the prosecutor consents in writing
#ASSERT `s 502(1) the undertaking may be varied` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 502(1) the undertaking may be varied` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 502(1) the undertaking may be varied` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 502(1) the undertaking may be varied` TRUE TRUE FALSE EQUALS NOTHING
-- (2) args: no consent between them; (a) replace the undertaking with a release order; (b) vary the undertaking
#ASSERT `s 502(2) the accused or the prosecutor may apply to a justice` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 502(2) the accused or the prosecutor may apply to a justice` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 502(2) the accused or the prosecutor may apply to a justice` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 502(2) the accused or the prosecutor may apply to a justice` TRUE FALSE FALSE EQUALS NOTHING
-- (2) the prosecutor must provide three days' notice (args: the prosecutor makes the application, days of notice given)
#ASSERT `s 502(2) the prosecutor's notice to the accused of three days is given` TRUE 3 EQUALS JUST TRUE
#ASSERT `s 502(2) the prosecutor's notice to the accused of three days is given` TRUE 2 EQUALS JUST FALSE
#ASSERT `s 502(2) the prosecutor's notice to the accused of three days is given` TRUE 5 EQUALS JUST TRUE
#ASSERT `s 502(2) the prosecutor's notice to the accused of three days is given` TRUE 0 EQUALS JUST FALSE
#ASSERT `s 502(2) the prosecutor's notice to the accused of three days is given` FALSE 0 EQUALS NOTHING
#ASSERT `s 502 the varied undertaking is deemed to be an undertaking given under section 498, 499 or 503` TRUE EQUALS JUST TRUE
#ASSERT `s 502 the varied undertaking is deemed to be an undertaking given under section 498, 499 or 503` FALSE EQUALS NOTHING

§ `Tests -- section 502.1: appearance`
#ASSERT `s 502.1(1) the accused must appear in person` TRUE EQUALS JUST FALSE
#ASSERT `s 502.1(1) the accused must appear in person` FALSE EQUALS JUST TRUE
#ASSERT `s 502.1(1) the accused may appear by audioconference or videoconference` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 502.1(2) the witness in Canada may give evidence by audioconference or videoconference` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 502.1(1) the accused may appear by audioconference or videoconference` TRUE FALSE EQUALS NOTHING
#ASSERT `s 502.1(2) the witness in Canada may give evidence by audioconference or videoconference` TRUE FALSE EQUALS NOTHING
#ASSERT `s 502.1(1) the accused may appear by audioconference or videoconference` FALSE TRUE EQUALS NOTHING
#ASSERT `s 502.1(2) the witness in Canada may give evidence by audioconference or videoconference` FALSE TRUE EQUALS NOTHING
#ASSERT `s 502.1(3) sections 714.2 to 714.8 apply` TRUE EQUALS JUST TRUE
#ASSERT `s 502.1(3) sections 714.2 to 714.8 apply` FALSE EQUALS NOTHING
#ASSERT `s 502.1(4) the participant may participate by audioconference or videoconference` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 502.1(4) the participant may participate by audioconference or videoconference` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 502.1(4) the participant may participate by audioconference or videoconference` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 502.1(4) the participant may participate by audioconference or videoconference` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 502.1(5) the justice may preside by audioconference or videoconference` TRUE EQUALS JUST TRUE
#ASSERT `s 502.1(5) the justice may preside by audioconference or videoconference` FALSE EQUALS NOTHING
