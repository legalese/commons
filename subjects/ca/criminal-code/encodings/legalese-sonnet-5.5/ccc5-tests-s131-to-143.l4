IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc5-s131-to-143`

-- Tests for ccc5-s131-to-143.l4. Every expected value was decided from the text before the run; a failing assertion is a finding.

-- s 131(3) subsections (1) and (1.1) do not apply to a statement made by a person not specially permitted, authorized or required by law to make it: expected values follow the text (s 131(3))
#ASSERT `s 131(3) subsections (1) and (1.1) do not apply to a statement made by a person not specially permitted, authorized or required by law to make it` TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 131(3) subsections (1) and (1.1) do not apply to a statement made by a person not specially permitted, authorized or required by law to make it` FALSE EQUALS NOTHING   -- element missing: the statement is made by a person who is not specially permitted, authorized or required by law to make that statement

-- s 131(1) the person commits perjury by a false statement under oath or solemn affirmation: expected values follow the text (s 131(1))
#ASSERT `s 131(1) the person commits perjury by a false statement under oath or solemn affirmation` TRUE TRUE TRUE TRUE NOTHING EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 131(1) the person commits perjury by a false statement under oath or solemn affirmation` FALSE TRUE TRUE TRUE NOTHING EQUALS NOTHING   -- element missing: the person makes the statement before a person who is authorized by law to permit it to be made before them
#ASSERT `s 131(1) the person commits perjury by a false statement under oath or solemn affirmation` TRUE FALSE TRUE TRUE NOTHING EQUALS NOTHING   -- element missing: it is a false statement under oath or solemn affirmation, by affidavit, solemn declaration or deposition or orally
#ASSERT `s 131(1) the person commits perjury by a false statement under oath or solemn affirmation` TRUE TRUE FALSE TRUE NOTHING EQUALS NOTHING   -- element missing: the person acts with intent to mislead
#ASSERT `s 131(1) the person commits perjury by a false statement under oath or solemn affirmation` TRUE TRUE TRUE FALSE NOTHING EQUALS NOTHING   -- element missing: the person knows that the statement is false
#ASSERT `s 131(1) the person commits perjury by a false statement under oath or solemn affirmation` TRUE TRUE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE   -- exception: the answer of s 131(3)

-- s 131(1.1) the person commits perjury by a false statement given by video link or under a mutual legal assistance order: expected values follow the text (s 131(1.1))
#ASSERT `s 131(1.1) the person commits perjury by a false statement given by video link or under a mutual legal assistance order` TRUE FALSE TRUE TRUE TRUE FALSE NOTHING FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 131(1.1) the person commits perjury by a false statement given by video link or under a mutual legal assistance order` FALSE FALSE TRUE TRUE TRUE FALSE NOTHING FALSE EQUALS NOTHING   -- element missing: the person gives evidence under subsection 46(2) of the Canada Evidence Act / the person gives evidence or a statement pursuant to an order made under section 22.2 of the Mutual Legal Assistance in Criminal Matters Act
#ASSERT `s 131(1.1) the person commits perjury by a false statement given by video link or under a mutual legal assistance order` TRUE FALSE TRUE TRUE TRUE FALSE NOTHING FALSE EQUALS JUST TRUE   -- alternative present: the person gives evidence under subsection 46(2) of the Canada Evidence Act
#ASSERT `s 131(1.1) the person commits perjury by a false statement given by video link or under a mutual legal assistance order` FALSE TRUE TRUE TRUE TRUE FALSE NOTHING FALSE EQUALS JUST TRUE   -- alternative present: the person gives evidence or a statement pursuant to an order made under section 22.2 of the Mutual Legal Assistance in Criminal Matters Act
#ASSERT `s 131(1.1) the person commits perjury by a false statement given by video link or under a mutual legal assistance order` TRUE FALSE FALSE TRUE TRUE FALSE NOTHING FALSE EQUALS NOTHING   -- element missing: the person makes a false statement
#ASSERT `s 131(1.1) the person commits perjury by a false statement given by video link or under a mutual legal assistance order` TRUE FALSE TRUE FALSE TRUE FALSE NOTHING FALSE EQUALS NOTHING   -- element missing: the person acts with intent to mislead
#ASSERT `s 131(1.1) the person commits perjury by a false statement given by video link or under a mutual legal assistance order` TRUE FALSE TRUE TRUE FALSE FALSE NOTHING FALSE EQUALS NOTHING   -- element missing: the person knows that the statement is false
#ASSERT `s 131(1.1) the person commits perjury by a false statement given by video link or under a mutual legal assistance order` TRUE FALSE TRUE TRUE TRUE TRUE NOTHING FALSE EQUALS JUST FALSE   -- exception: the false statement was made otherwise than in accordance with the formalities required by the law of the place outside Canada in which the person is virtually present or heard
#ASSERT `s 131(1.1) the person commits perjury by a false statement given by video link or under a mutual legal assistance order` TRUE FALSE TRUE TRUE TRUE FALSE (JUST TRUE) FALSE EQUALS JUST FALSE   -- exception: the answer of s 131(3)
#ASSERT `s 131(1.1) the person commits perjury by a false statement given by video link or under a mutual legal assistance order` TRUE FALSE TRUE TRUE TRUE FALSE NOTHING TRUE EQUALS JUST TRUE   -- "whether or not": the false statement was made under oath or solemn affirmation in accordance with subsection (1) present does not change the answer
#ASSERT `s 131(1.1) the person commits perjury by a false statement given by video link or under a mutual legal assistance order` TRUE FALSE TRUE TRUE TRUE FALSE NOTHING FALSE EQUALS JUST TRUE   -- "whether or not": the false statement was made under oath or solemn affirmation in accordance with subsection (1) absent does not change the answer

-- s 131(2) subsection (1) applies whether or not the statement is made in a judicial proceeding: expected values follow the text (s 131(2))
#ASSERT `s 131(2) subsection (1) applies whether or not the statement is made in a judicial proceeding` TRUE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 131(2) subsection (1) applies whether or not the statement is made in a judicial proceeding` FALSE FALSE EQUALS NOTHING   -- element missing: the statement is one referred to in subsection (1)
#ASSERT `s 131(2) subsection (1) applies whether or not the statement is made in a judicial proceeding` TRUE TRUE EQUALS JUST TRUE   -- "whether or not": the statement is made in a judicial proceeding present does not change the answer
#ASSERT `s 131(2) subsection (1) applies whether or not the statement is made in a judicial proceeding` TRUE FALSE EQUALS JUST TRUE   -- "whether or not": the statement is made in a judicial proceeding absent does not change the answer

#ASSERT `s 131 the person commits perjury` NOTHING NOTHING EQUALS NOTHING   -- no limb is made out
#ASSERT `s 131 the person commits perjury` (JUST FALSE) (JUST FALSE) EQUALS NOTHING   -- a limb answered JUST FALSE is not a made-out limb
#ASSERT `s 131 the person commits perjury` (JUST TRUE) NOTHING EQUALS JUST TRUE   -- limb s 131(1) made out
#ASSERT `s 131 the person commits perjury` NOTHING (JUST TRUE) EQUALS JUST TRUE   -- limb s 131(1.1) made out

-- s 132 the person who commits perjury is guilty of an indictable offence: expected values follow the text (s 132)
#ASSERT `s 132 the person who commits perjury is guilty of an indictable offence` (JUST TRUE) EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 132 the person who commits perjury is guilty of an indictable offence` NOTHING EQUALS NOTHING   -- element missing: s 131 the person commits perjury: the answer
#ASSERT `s 132 the person who commits perjury is guilty of an indictable offence` (JUST FALSE) EQUALS NOTHING   -- s 131 the person commits perjury: the answer: the other way it can fail ((JUST FALSE))

#ASSERT `s 132 the class of the offence` EQUALS `an indictable offence`

#ASSERT `s 132 the punishment on indictment`'s `mode` EQUALS `by indictment`
#ASSERT `s 132 the punishment on indictment`'s `maximum imprisonment` EQUALS `imprisonment for a term of` `fourteen years`
#ASSERT `s 132 the punishment on indictment`'s `minimum imprisonment` EQUALS `no imprisonment is stated`
#ASSERT `s 132 the punishment on indictment`'s `maximum fine` EQUALS `no fine is stated`

-- s 133 the accused is barred from being convicted of perjury on the evidence of only one witness unless it is corroborated in a material particular: expected values follow the text (s 133)
#ASSERT `s 133 the accused is barred from being convicted of perjury on the evidence of only one witness unless it is corroborated in a material particular` TRUE TRUE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 133 the accused is barred from being convicted of perjury on the evidence of only one witness unless it is corroborated in a material particular` FALSE TRUE FALSE EQUALS NOTHING   -- element missing: the accused is charged with an offence under section 132
#ASSERT `s 133 the accused is barred from being convicted of perjury on the evidence of only one witness unless it is corroborated in a material particular` TRUE FALSE FALSE EQUALS NOTHING   -- element missing: the evidence is that of only one witness
#ASSERT `s 133 the accused is barred from being convicted of perjury on the evidence of only one witness unless it is corroborated in a material particular` TRUE TRUE TRUE EQUALS JUST FALSE   -- exception: the evidence of that witness is corroborated in a material particular by evidence that implicates the accused

-- s 134(2) subsection (1) does not apply to a statement made in the course of a criminal investigation: expected values follow the text (s 134(2))
#ASSERT `s 134(2) subsection (1) does not apply to a statement made in the course of a criminal investigation` TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 134(2) subsection (1) does not apply to a statement made in the course of a criminal investigation` FALSE EQUALS NOTHING   -- element missing: the statement is made in the course of a criminal investigation

-- s 134(1) the person makes a false statement under oath or solemn affirmation without being permitted, authorized or required by law: expected values follow the text (s 134(1))
#ASSERT `s 134(1) the person makes a false statement under oath or solemn affirmation without being permitted, authorized or required by law` FALSE TRUE TRUE NOTHING EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 134(1) the person makes a false statement under oath or solemn affirmation without being permitted, authorized or required by law` TRUE TRUE TRUE NOTHING EQUALS NOTHING   -- element missing: the person is specially permitted, authorized or required by law to make a statement under oath or solemn affirmation
#ASSERT `s 134(1) the person makes a false statement under oath or solemn affirmation without being permitted, authorized or required by law` FALSE FALSE TRUE NOTHING EQUALS NOTHING   -- element missing: the person makes such a statement, by affidavit, solemn declaration or deposition or orally before a person who is authorized by law to permit it to be made before them
#ASSERT `s 134(1) the person makes a false statement under oath or solemn affirmation without being permitted, authorized or required by law` FALSE TRUE FALSE NOTHING EQUALS NOTHING   -- element missing: the person knows that the statement is false
#ASSERT `s 134(1) the person makes a false statement under oath or solemn affirmation without being permitted, authorized or required by law` FALSE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE   -- exception: the answer of s 134(2)

#ASSERT `s 134(1) the class of the offence` EQUALS `an offence punishable on summary conviction`

#ASSERT (`s 134(1) the punishment on summary conviction` (Punishment WITH `mode` IS `on summary conviction`, `maximum imprisonment` IS `imprisonment for a term of` `six months`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 5000, `minimum fine` IS `no fine is stated`))'s `mode` EQUALS `on summary conviction`
#ASSERT (`s 134(1) the punishment on summary conviction` (Punishment WITH `mode` IS `on summary conviction`, `maximum imprisonment` IS `imprisonment for a term of` `six months`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 5000, `minimum fine` IS `no fine is stated`))'s `maximum imprisonment` EQUALS `imprisonment for a term of` `six months`   -- the limb returns exactly what section 787(1) is given as
#ASSERT (`s 134(1) the punishment on summary conviction` (Punishment WITH `mode` IS `on summary conviction`, `maximum imprisonment` IS `imprisonment for a term of` `six months`, `minimum imprisonment` IS `no imprisonment is stated`, `maximum fine` IS `a fine of` 5000, `minimum fine` IS `no fine is stated`))'s `maximum fine` EQUALS `a fine of` 5000

-- s 136(2) the evidence is evidence for the purposes of section 136: expected values follow the text (s 136(2))
#ASSERT `s 136(2) the evidence is evidence for the purposes of section 136` (JUST TRUE) TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 136(2) the evidence is evidence for the purposes of section 136` NOTHING TRUE EQUALS NOTHING   -- element missing: s 118 evidence or statement: it is one
#ASSERT `s 136(2) the evidence is evidence for the purposes of section 136` (JUST FALSE) TRUE EQUALS NOTHING   -- s 118 evidence or statement: it is one: the other way it can fail ((JUST FALSE))
#ASSERT `s 136(2) the evidence is evidence for the purposes of section 136` (JUST TRUE) FALSE EQUALS JUST FALSE   -- exception: the evidence is material

-- s 136(1.1) the evidence is deemed to be evidence given by a witness in a judicial proceeding: expected values follow the text (s 136(1.1))
#ASSERT `s 136(1.1) the evidence is deemed to be evidence given by a witness in a judicial proceeding` TRUE FALSE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 136(1.1) the evidence is deemed to be evidence given by a witness in a judicial proceeding` FALSE FALSE FALSE EQUALS NOTHING   -- element missing: the evidence was given under section 714.1, 714.2 or 714.3 / the evidence was given under subsection 46(2) of the Canada Evidence Act / the evidence or statement was given under an order made under section 22.2 of the Mutual Legal Assistance in Criminal Matters Act
#ASSERT `s 136(1.1) the evidence is deemed to be evidence given by a witness in a judicial proceeding` TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the evidence was given under section 714.1, 714.2 or 714.3
#ASSERT `s 136(1.1) the evidence is deemed to be evidence given by a witness in a judicial proceeding` FALSE TRUE FALSE EQUALS JUST TRUE   -- alternative present: the evidence was given under subsection 46(2) of the Canada Evidence Act
#ASSERT `s 136(1.1) the evidence is deemed to be evidence given by a witness in a judicial proceeding` FALSE FALSE TRUE EQUALS JUST TRUE   -- alternative present: the evidence or statement was given under an order made under section 22.2 of the Mutual Legal Assistance in Criminal Matters Act

-- s 136(1) the witness is guilty of giving contradictory evidence: expected values follow the text (s 136(1))
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST TRUE) (JUST TRUE) TRUE TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` NOTHING (JUST TRUE) TRUE TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- element missing: s 118 judicial proceeding: the proceeding is one
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST TRUE) NOTHING TRUE TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- element missing: s 118 witness: the person was one
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST TRUE) (JUST TRUE) FALSE TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- element missing: the person, being a witness in a judicial proceeding, gives evidence with respect to a matter of fact or knowledge
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST TRUE) (JUST TRUE) TRUE FALSE (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- element missing: the person subsequently, in a judicial proceeding, gives evidence that is contrary to their previous evidence
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST TRUE) (JUST TRUE) TRUE TRUE NOTHING (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- element missing: s 136(2) the earlier evidence is evidence for this section
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST TRUE) (JUST TRUE) TRUE TRUE (JUST TRUE) NOTHING TRUE FALSE EQUALS NOTHING   -- element missing: s 136(2) the later evidence is evidence for this section
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST FALSE) (JUST TRUE) TRUE TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- s 118 judicial proceeding: the proceeding is one: the other way it can fail ((JUST FALSE))
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST TRUE) (JUST FALSE) TRUE TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- s 118 witness: the person was one: the other way it can fail ((JUST FALSE))
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST TRUE) (JUST TRUE) TRUE TRUE (JUST FALSE) (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- s 136(2) the earlier evidence is evidence for this section: the other way it can fail ((JUST FALSE))
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST TRUE) (JUST TRUE) TRUE TRUE (JUST TRUE) (JUST FALSE) TRUE FALSE EQUALS NOTHING   -- s 136(2) the later evidence is evidence for this section: the other way it can fail ((JUST FALSE))
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST TRUE) (JUST TRUE) TRUE TRUE (JUST TRUE) (JUST TRUE) FALSE FALSE EQUALS JUST FALSE   -- exception: the court is satisfied beyond a reasonable doubt that the accused, in giving evidence in either of the judicial proceedings, intended to mislead
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST TRUE) (JUST TRUE) TRUE TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE   -- "whether or not": the prior or the later evidence, or either, is true present does not change the answer
#ASSERT `s 136(1) the witness is guilty of giving contradictory evidence` (JUST TRUE) (JUST TRUE) TRUE TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS JUST TRUE   -- "whether or not": the prior or the later evidence, or either, is true absent does not change the answer

-- s 136(2.1) a certificate is evidence that the evidence was given in a judicial proceeding: expected values follow the text (s 136(2.1))
#ASSERT `s 136(2.1) a certificate is evidence that the evidence was given in a judicial proceeding` TRUE TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 136(2.1) a certificate is evidence that the evidence was given in a judicial proceeding` FALSE TRUE TRUE EQUALS NOTHING   -- element missing: the person is charged with an offence under section 136
#ASSERT `s 136(2.1) a certificate is evidence that the evidence was given in a judicial proceeding` TRUE FALSE TRUE EQUALS NOTHING   -- element missing: the certificate specifies with reasonable particularity the proceeding in which the person is alleged to have given the evidence
