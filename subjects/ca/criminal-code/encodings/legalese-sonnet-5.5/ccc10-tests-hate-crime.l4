IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc10-hate-crime`

-- ccc10-tests-hate-crime.l4 -- tests for ccc10-hate-crime.l4 (s 320.1001). Expected values are written by hand from the text, beside each assertion.
-- (The assertion lines were laid out by a script from a table of hand-written rows, each carrying its expected value and its basis in the text; the script reads no encoding output.)

`s 320.1001 fixture: the general summary conviction penalty` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
GIVEN maximum IS AN Imprisonment
GIVETH A MAYBE Punishment
`s 320.1001 fixture: on indictment at most` MEANS JUST (Punishment OF `by indictment`, maximum, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)

§ `s 320.1001 -- Offence motivated by hatred`

#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE (JUST TRUE) `s 320.1001(1) race` EQUALS JUST TRUE   -- an included offence motivated by hatred based on race
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE (JUST TRUE) `s 320.1001(1) national or ethnic origin` EQUALS JUST TRUE   -- an included offence motivated by hatred based on national or ethnic origin
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE (JUST TRUE) `s 320.1001(1) language` EQUALS JUST TRUE   -- an included offence motivated by hatred based on language
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE (JUST TRUE) `s 320.1001(1) colour` EQUALS JUST TRUE   -- an included offence motivated by hatred based on colour
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE (JUST TRUE) `s 320.1001(1) religion` EQUALS JUST TRUE   -- an included offence motivated by hatred based on religion
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE (JUST TRUE) `s 320.1001(1) sex` EQUALS JUST TRUE   -- an included offence motivated by hatred based on sex
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE (JUST TRUE) `s 320.1001(1) age` EQUALS JUST TRUE   -- an included offence motivated by hatred based on age
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE (JUST TRUE) `s 320.1001(1) mental or physical disability` EQUALS JUST TRUE   -- an included offence motivated by hatred based on mental or physical disability
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE (JUST TRUE) `s 320.1001(1) sexual orientation` EQUALS JUST TRUE   -- an included offence motivated by hatred based on sexual orientation
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE (JUST TRUE) `s 320.1001(1) gender identity or expression` EQUALS JUST TRUE   -- an included offence motivated by hatred based on gender identity or expression
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE (JUST TRUE) `s 320.1001(1) another ground` EQUALS NOTHING   -- hatred based on a ground not in the list: the list is not closed by "only"
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE FALSE (JUST TRUE) `s 320.1001(1) race` EQUALS JUST FALSE   -- not motivated by hatred: the "if" fails
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE (JUST FALSE) `s 320.1001(1) race` EQUALS JUST FALSE   -- the emotion is not hatred as s 319(7) has it: the "if" fails
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` TRUE TRUE NOTHING `s 320.1001(1) race` EQUALS NOTHING   -- whether the emotion is hatred is not determined
#ASSERT `s 320.1001(1) the person is guilty of the offence of committing an offence motivated by hatred` FALSE TRUE (JUST TRUE) `s 320.1001(1) race` EQUALS NOTHING   -- no included offence
#ASSERT `s 320.1001(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`   -- (a) or (b)
#ASSERT `s 320.1001(2) the emotion is hatred` (JUST TRUE) EQUALS JUST TRUE   -- "hatred has the same meaning as in subsection 319(7)": passed through
#ASSERT `s 320.1001(2) the emotion is hatred` (JUST FALSE) EQUALS JUST FALSE   -- passed through
#ASSERT `s 320.1001(2) the emotion is hatred` NOTHING EQUALS NOTHING   -- passed through: not determined
#ASSERT `s 320.1001(3) the commission of the offence is motivated by hatred` TRUE EQUALS JUST FALSE   -- "is not ... motivated by hatred ... solely because it discredits, humiliates, hurts or offends"
#ASSERT `s 320.1001(3) the commission of the offence is motivated by hatred` FALSE EQUALS NOTHING   -- another reason: the section says nothing
#ASSERT `s 320.1001(4) proceedings under subsection (1) may not be commenced by way of indictment` TRUE EQUALS JUST TRUE   -- the included offence may be prosecuted only by way of summary conviction proceedings
#ASSERT `s 320.1001(4) proceedings under subsection (1) may not be commenced by way of indictment` FALSE EQUALS NOTHING   -- the bar is limited by its own wording
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` (`imprisonment for a term of` (`Length of time` OF 2, 0, 0, TRUE)) EQUALS NOTHING   -- two years less a day: below two years, within none of (a) to (d)
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` (`imprisonment for a term of` (`Length of time` OF 2, 0, 0, FALSE)) EQUALS JUST (`imprisonment for a term of` `five years`)   -- (a): two years or more but less than five years: five years
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` (`imprisonment for a term of` (`Length of time` OF 4, 11, 30, FALSE)) EQUALS JUST (`imprisonment for a term of` `five years`)   -- (a): four years, eleven months and thirty days is less than five years
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` (`imprisonment for a term of` (`Length of time` OF 5, 0, 0, TRUE)) EQUALS JUST (`imprisonment for a term of` `five years`)   -- (a): five years less a day is less than five years
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` (`imprisonment for a term of` (`Length of time` OF 5, 0, 0, FALSE)) EQUALS JUST (`imprisonment for a term of` `ten years`)   -- (b): five years or more but less than 10 years: 10 years
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` (`imprisonment for a term of` (`Length of time` OF 9, 11, 30, FALSE)) EQUALS JUST (`imprisonment for a term of` `ten years`)   -- (b): less than 10 years
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` (`imprisonment for a term of` (`Length of time` OF 10, 0, 0, FALSE)) EQUALS JUST (`imprisonment for a term of` `fourteen years`)   -- (c): 10 years or more but less than 14 years: 14 years
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` (`imprisonment for a term of` (`Length of time` OF 13, 11, 30, FALSE)) EQUALS JUST (`imprisonment for a term of` `fourteen years`)   -- (c): less than 14 years
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` (`imprisonment for a term of` (`Length of time` OF 14, 0, 0, FALSE)) EQUALS JUST `imprisonment for life`   -- (d): 14 years or more: life
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` `imprisonment for life` EQUALS JUST `imprisonment for life`   -- (d): "up to imprisonment for life"
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` `no imprisonment is stated` EQUALS NOTHING   -- the included offence states no maximum term: no paragraph covers it
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` (`imprisonment for a term of` (`Length of time` OF 1, 0, 0, FALSE)) EQUALS NOTHING   -- one year: below two years
#ASSERT `s 320.1001(5) the term of imprisonment the person is liable to is not more than` (`imprisonment for a term of` (`Length of time` OF 0, 6, 0, FALSE)) EQUALS NOTHING   -- six months: below two years
#ASSERT `s 320.1001(1) the punishment` `by indictment` (JUST (`imprisonment for a term of` `five years`)) `s 320.1001 fixture: the general summary conviction penalty` EQUALS `s 320.1001 fixture: on indictment at most` (`imprisonment for a term of` `five years`)   -- (a): the liability of subsection (5), here five years
#ASSERT `s 320.1001(1) the punishment` `by indictment` (JUST `imprisonment for life`) `s 320.1001 fixture: the general summary conviction penalty` EQUALS `s 320.1001 fixture: on indictment at most` `imprisonment for life`   -- (d): life
#ASSERT `s 320.1001(1) the punishment` `by indictment` NOTHING `s 320.1001 fixture: the general summary conviction penalty` EQUALS NOTHING   -- subsection (5) gives no maximum for this included offence
#ASSERT `s 320.1001(1) the punishment` `on summary conviction` NOTHING `s 320.1001 fixture: the general summary conviction penalty` EQUALS JUST `s 320.1001 fixture: the general summary conviction penalty`   -- (b): the s 787(1) answer, whatever (5) says
#ASSERT `s 320.1001(6) the provision applies in relation to the offence under subsection (1)` TRUE FALSE EQUALS JUST TRUE   -- would have been applicable to the included offence, and not displaced
#ASSERT `s 320.1001(6) the provision applies in relation to the offence under subsection (1)` TRUE TRUE EQUALS JUST FALSE   -- "Subject to paragraphs (1)(a) and (b) and subsections (4) and (5)": displaced
#ASSERT `s 320.1001(6) the provision applies in relation to the offence under subsection (1)` FALSE FALSE EQUALS NOTHING   -- would not have been applicable to the included offence
