        (`Provision of the Code` OF 151, "")           -- section 151 (sexual interference)
      , (`Provision of the Code` OF 152, "")           -- section 152 (invitation to sexual touching or exposure)
      , (`Provision of the Code` OF 153, "")           -- section 153 (sexual exploitation)
      , (`Provision of the Code` OF 153.1, "")         -- section 153.1 (sexual exploitation of person with disability)
      , (`Provision of the Code` OF 171.1, "")         -- section 171.1 (making sexually explicit material available to child)
      , (`Provision of the Code` OF 172.1, "")         -- section 172.1 (luring a child)
      , (`Provision of the Code` OF 172.2, "")         -- section 172.2 (agreement or arrangement -- sexual offence against child)
      , (`Provision of the Code` OF 271, "")           -- section 271 (sexual assault)
      , (`Provision of the Code` OF 272, "")           -- section 272 (sexual assault with a weapon, threats to a third party or causing bodily harm)
      , (`Provision of the Code` OF 273, "")           -- section 273 (aggravated sexual assault)

