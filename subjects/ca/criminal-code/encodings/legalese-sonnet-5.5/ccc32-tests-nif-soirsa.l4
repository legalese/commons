#ASSERT `s 490.05(1) (not in force) the order or obligation is one listed in the replaced paragraphs` `s 490.05(1)(c) (not in force) an obligation under section 490.02901` TRUE FALSE (Date 26 10 2023) TRUE EQUALS JUST FALSE
#ASSERT `s 490.05(1) (not in force) the order or obligation is one listed in the replaced paragraphs` `s 490.05(1)(c) (not in force) an obligation under section 490.02901` TRUE FALSE (Date 25 10 2023) FALSE EQUALS JUST FALSE
#ASSERT `s 490.05(1) (not in force) the order or obligation is one listed in the replaced paragraphs` `s 490.05(1)(c) (not in force) an obligation under section 490.02901` FALSE FALSE (Date 25 10 2023) TRUE EQUALS JUST FALSE
#ASSERT `s 490.05(1) (not in force) the order or obligation is one listed in the replaced paragraphs` `s 490.05(1)(d) (not in force) an obligation under section 36.1 of the International Transfer of Offenders Act` TRUE FALSE (Date 25 10 2023) TRUE EQUALS JUST TRUE
#ASSERT `s 490.05(1) (not in force) the order or obligation is one listed in the replaced paragraphs` `s 490.05(1)(d) (not in force) an obligation under section 36.1 of the International Transfer of Offenders Act` TRUE FALSE (Date 26 10 2023) TRUE EQUALS JUST FALSE
#ASSERT `s 490.05(1) (not in force) the order or obligation is one listed in the replaced paragraphs` `s 490.05(1)(d) (not in force) an obligation under section 36.1 of the International Transfer of Offenders Act` TRUE FALSE (Date 25 10 2023) FALSE EQUALS JUST FALSE
#ASSERT `s 490.05(1) (not in force) the order or obligation is one listed in the replaced paragraphs` `s 490.05(1)(d) (not in force) an obligation under section 36.1 of the International Transfer of Offenders Act` FALSE FALSE (Date 25 10 2023) TRUE EQUALS JUST FALSE
#ASSERT `s 490.05(1) (not in force) the order or obligation is one listed in the replaced paragraphs` `s 490.05(1) (not in force) something else` TRUE TRUE (Date 25 10 2023) TRUE EQUALS NOTHING
#ASSERT `s 490.05(3)(a) (not in force) a superior court of criminal jurisdiction is a court that may receive the application` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 490.05(3)(a) (not in force) a superior court of criminal jurisdiction is a court that may receive the application` FALSE TRUE TRUE EQUALS JUST TRUE
