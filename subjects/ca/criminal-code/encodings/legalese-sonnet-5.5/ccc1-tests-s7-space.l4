IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc1-s7-space`

-- ccc1-tests-s7-space.l4 -- tests for section 7(2.3) to (2.38) of the Criminal Code (Canada). Expected values are written by hand from the text.
-- Arguments are positional, in GIVEN order. Moments are hours on one clock.

`ccc1 test 2.3(a)` MEANS `s 7(2.3)(a) the act or omission is committed on, or in relation to, a flight element of the Space Station`
`ccc1 test 2.3(b)` MEANS `s 7(2.3)(b) the act or omission is committed on any means of transportation to or from the Space Station`
`ccc1 test 2.31(a)` MEANS `s 7(2.31)(a) the act or omission threatens the life or security of a Canadian crew member`
`ccc1 test 2.31(b)` MEANS `s 7(2.31)(b) the act or omission is committed on or in relation to, or damages, a flight element provided by Canada`
`ccc1 test 2.35(a)` MEANS `s 7(2.35)(a) the act or omission is committed on, or in relation to, a flight element of the Lunar Gateway`
`ccc1 test 2.35(b)` MEANS `s 7(2.35)(b) the act or omission is committed on any means of transportation to or from the Lunar Gateway`
`ccc1 test 2.35(c)` MEANS `s 7(2.35)(c) the act or omission is committed on the surface of the Moon`
`ccc1 test 2.36(a)` MEANS `s 7(2.36)(a) the act or omission threatens the life or security of a Canadian crew member`
`ccc1 test 2.36(b)` MEANS `s 7(2.36)(b) the act or omission is committed on or in relation to, or damages, a flight element provided by Canada`

§ `s 7(2.34) Agreement  (the answer of the Civil International Space Station Agreement Implementation Act)`
#ASSERT `s 7(2.34) Agreement` (JUST TRUE) EQUALS JUST TRUE   -- that Act's answer, carried through
#ASSERT `s 7(2.34) Agreement` (JUST FALSE) EQUALS JUST FALSE   -- carried through
#ASSERT `s 7(2.34) Agreement` NOTHING EQUALS NOTHING   -- not answered there: not answered here

§ `s 7(2.34) Partner State  (a State other than Canada; contracted to enter into the Agreement; in force under article 25)`
#ASSERT `s 7(2.34) Partner State` TRUE TRUE TRUE EQUALS JUST TRUE   -- all three
#ASSERT `s 7(2.34) Partner State` FALSE TRUE TRUE EQUALS JUST FALSE   -- Canada itself
#ASSERT `s 7(2.34) Partner State` TRUE FALSE TRUE EQUALS JUST FALSE   -- did not contract to enter into the Agreement
#ASSERT `s 7(2.34) Partner State` TRUE TRUE FALSE EQUALS JUST FALSE   -- the Agreement not in force for it under article 25

§ `s 7(2.34) crew member of a Partner State  (crew member; citizen of a Partner State; citizen of another state; authorized by a Partner State)`
#ASSERT `s 7(2.34) crew member of a Partner State` TRUE (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST TRUE   -- (a): a citizen of a Partner State
#ASSERT `s 7(2.34) crew member of a Partner State` TRUE (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST TRUE   -- (b): another state, authorized by a Partner State
#ASSERT `s 7(2.34) crew member of a Partner State` TRUE (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST FALSE   -- (b) without the authorization
#ASSERT `s 7(2.34) crew member of a Partner State` TRUE (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST FALSE   -- a citizen of neither
#ASSERT `s 7(2.34) crew member of a Partner State` FALSE (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE   -- not a crew member of the Space Station: "means a crew member of the Space Station who is"
#ASSERT `s 7(2.34) crew member of a Partner State` TRUE NOTHING (JUST FALSE) TRUE EQUALS NOTHING   -- whether the state is a Partner State was not answered
#ASSERT `s 7(2.34) crew member of a Partner State` TRUE (JUST FALSE) NOTHING TRUE EQUALS NOTHING   -- same, for limb (b)
#ASSERT `s 7(2.34) crew member of a Partner State` TRUE (JUST FALSE) NOTHING FALSE EQUALS JUST FALSE   -- (b) fails for want of the authorization whatever the answer

§ `s 7(2.34) Canadian crew member  (crew member; Canadian citizen; citizen of a foreign state other than a Partner State; authorized by Canada)`
#ASSERT `s 7(2.34) Canadian crew member` TRUE TRUE (JUST FALSE) FALSE EQUALS JUST TRUE   -- (a): a Canadian citizen
#ASSERT `s 7(2.34) Canadian crew member` TRUE FALSE (JUST TRUE) TRUE EQUALS JUST TRUE   -- (b): a foreign state other than a Partner State, authorized by Canada
#ASSERT `s 7(2.34) Canadian crew member` TRUE FALSE (JUST TRUE) FALSE EQUALS JUST FALSE   -- (b) without the authorization
#ASSERT `s 7(2.34) Canadian crew member` TRUE FALSE (JUST FALSE) TRUE EQUALS JUST FALSE   -- a citizen of a Partner State
#ASSERT `s 7(2.34) Canadian crew member` TRUE FALSE NOTHING TRUE EQUALS NOTHING   -- whether the state is a Partner State was not answered
#ASSERT `s 7(2.34) Canadian crew member` FALSE TRUE (JUST TRUE) TRUE EQUALS JUST FALSE   -- not a crew member of the Space Station

§ `s 7(2.34) flight element, Space Station, space flight`
#ASSERT `s 7(2.34) flight element` TRUE TRUE TRUE EQUALS JUST TRUE   -- a Space Station element provided by Canada or a Partner State under the Agreement and an arrangement
#ASSERT `s 7(2.34) flight element` FALSE TRUE TRUE EQUALS JUST FALSE   -- not a Space Station element
#ASSERT `s 7(2.34) flight element` TRUE FALSE TRUE EQUALS JUST FALSE   -- provided by neither
#ASSERT `s 7(2.34) flight element` TRUE TRUE FALSE EQUALS JUST FALSE   -- not under the Agreement and an arrangement
#ASSERT `s 7(2.34) Space Station` TRUE TRUE EQUALS JUST TRUE   -- the civil international Space Station with its elements
#ASSERT `s 7(2.34) Space Station` TRUE FALSE EQUALS JUST FALSE   -- elements not provided by Canada or the Partner States
#ASSERT `s 7(2.34) Space Station` FALSE TRUE EQUALS JUST FALSE   -- not the civil international Space Station
#ASSERT `s 7(2.34) the moment is within the space flight` 10 10 100 EQUALS JUST TRUE   -- the launching itself: "begins with the launching"
#ASSERT `s 7(2.34) the moment is within the space flight` 55 10 100 EQUALS JUST TRUE   -- in orbit
#ASSERT `s 7(2.34) the moment is within the space flight` 100 10 100 EQUALS JUST TRUE   -- the landing itself: "ends with their landing"
#ASSERT `s 7(2.34) the moment is within the space flight` 9.99 10 100 EQUALS JUST FALSE   -- before the launching
#ASSERT `s 7(2.34) the moment is within the space flight` 100.01 10 100 EQUALS JUST FALSE   -- after the landing

§ `s 7(2.3)  (Canadian crew member by (2.34); space flight by (2.34); outside Canada; class of offence; grounds)`
#ASSERT `s 7(2.3) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.3(a)`) EQUALS JUST TRUE   -- (a): on, or in relation to, a flight element
#ASSERT `s 7(2.3) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.3(b)`) EQUALS JUST TRUE   -- (b): on a means of transportation to or from the Space Station
#ASSERT `s 7(2.3) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` EMPTY EQUALS JUST FALSE   -- neither (a) nor (b): "if that act or omission is committed"
#ASSERT `s 7(2.3) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an offence that the section makes both indictable and punishable on summary conviction` (LIST `ccc1 test 2.3(a)`) EQUALS JUST TRUE   -- an offence also punishable by indictment
#ASSERT `s 7(2.3) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an offence punishable on summary conviction` (LIST `ccc1 test 2.3(a)`) EQUALS NOTHING   -- not an indictable offence
#ASSERT `s 7(2.3) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) FALSE `an indictable offence` (LIST `ccc1 test 2.3(a)`) EQUALS NOTHING   -- committed in Canada
#ASSERT `s 7(2.3) the act or omission is deemed to have been committed in Canada` (JUST FALSE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.3(a)`) EQUALS NOTHING   -- not a Canadian crew member
#ASSERT `s 7(2.3) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST FALSE) TRUE `an indictable offence` (LIST `ccc1 test 2.3(a)`) EQUALS NOTHING   -- not during a space flight
#ASSERT `s 7(2.3) the act or omission is deemed to have been committed in Canada` NOTHING (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.3(a)`) EQUALS NOTHING   -- the definition did not answer
#ASSERT `s 7(2.3) the act or omission is deemed to have been committed in Canada` (JUST TRUE) NOTHING TRUE `an indictable offence` (LIST `ccc1 test 2.3(a)`) EQUALS NOTHING   -- the definition did not answer

§ `s 7(2.31)  (crew member of a Partner State; outside Canada during a space flight; on or in relation to a flight element or a means of transportation; class; grounds)`
#ASSERT `s 7(2.31) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.31(a)`) EQUALS JUST TRUE   -- (a): threatens the life or security of a Canadian crew member
#ASSERT `s 7(2.31) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.31(b)`) EQUALS JUST TRUE   -- (b): on or in relation to, or damages, a flight element provided by Canada
#ASSERT `s 7(2.31) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` EMPTY EQUALS JUST FALSE   -- neither (a) nor (b)
#ASSERT `s 7(2.31) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) FALSE `an indictable offence` (LIST `ccc1 test 2.31(a)`) EQUALS NOTHING   -- not on a flight element or a means of transportation
#ASSERT `s 7(2.31) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an offence punishable on summary conviction` (LIST `ccc1 test 2.31(a)`) EQUALS NOTHING   -- not an indictable offence
#ASSERT `s 7(2.31) the act or omission is deemed to have been committed in Canada` (JUST FALSE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.31(a)`) EQUALS NOTHING   -- not a crew member of a Partner State
#ASSERT `s 7(2.31) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST FALSE) TRUE `an indictable offence` (LIST `ccc1 test 2.31(a)`) EQUALS NOTHING   -- not during a space flight
#ASSERT `s 7(2.31) the act or omission is deemed to have been committed in Canada` NOTHING (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.31(a)`) EQUALS NOTHING   -- the definition did not answer
#ASSERT `s 7(2.31) the act or omission is deemed to have been committed in Canada` (JUST TRUE) NOTHING TRUE `an indictable offence` (LIST `ccc1 test 2.31(a)`) EQUALS NOTHING   -- the definition did not answer

§ `s 7(2.32), (2.33)`
#ASSERT `s 7(2.32) as the text shows it` EQUALS "[Repealed, 2019, c. 25, s. 4]"   -- the text shows (2.32) repealed
#ASSERT `s 7(2.33) the proceedings are barred for want of the consent of the Attorney General of Canada` TRUE FALSE EQUALS JUST TRUE   -- an offence of (2.3) or (2.31), no consent: barred
#ASSERT `s 7(2.33) the proceedings are barred for want of the consent of the Attorney General of Canada` TRUE TRUE EQUALS NOTHING   -- consent obtained: the bar is limited by "without the consent"
#ASSERT `s 7(2.33) the proceedings are barred for want of the consent of the Attorney General of Canada` FALSE FALSE EQUALS NOTHING   -- another offence: not covered

§ `s 7(2.38) definitions`
#ASSERT `s 7(2.38) Agreement` (JUST TRUE) EQUALS JUST TRUE   -- the Civil Lunar Gateway Agreement Implementation Act's answer, carried through
#ASSERT `s 7(2.38) Agreement` NOTHING EQUALS NOTHING   -- not answered there
#ASSERT `s 7(2.38) Partner State` TRUE TRUE EQUALS JUST TRUE   -- a State other than Canada that is a Gateway Partner
#ASSERT `s 7(2.38) Partner State` FALSE TRUE EQUALS JUST FALSE   -- Canada
#ASSERT `s 7(2.38) Partner State` TRUE FALSE EQUALS JUST FALSE   -- not a Gateway Partner
#ASSERT `s 7(2.38) Canadian crew member` TRUE TRUE (JUST FALSE) FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 7(2.38) Canadian crew member` TRUE FALSE (JUST TRUE) TRUE EQUALS JUST TRUE   -- (b)
#ASSERT `s 7(2.38) Canadian crew member` TRUE FALSE (JUST TRUE) FALSE EQUALS JUST FALSE   -- (b) without the authorization
#ASSERT `s 7(2.38) Canadian crew member` TRUE FALSE NOTHING TRUE EQUALS NOTHING   -- not answered
#ASSERT `s 7(2.38) Canadian crew member` FALSE TRUE (JUST TRUE) TRUE EQUALS JUST FALSE   -- not a crew member of the Lunar Gateway
#ASSERT `s 7(2.38) crew member of a Partner State` TRUE (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 7(2.38) crew member of a Partner State` TRUE (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST TRUE   -- (b)
#ASSERT `s 7(2.38) crew member of a Partner State` TRUE (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST FALSE   -- (b) without the authorization
#ASSERT `s 7(2.38) crew member of a Partner State` TRUE NOTHING (JUST FALSE) TRUE EQUALS NOTHING   -- not answered
#ASSERT `s 7(2.38) crew member of a Partner State` FALSE (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE   -- not a crew member of the Lunar Gateway
#ASSERT `s 7(2.38) flight element` TRUE TRUE TRUE EQUALS JUST TRUE   -- a Lunar Gateway element provided by Canada or a Partner State under the Agreement and an arrangement
#ASSERT `s 7(2.38) flight element` TRUE TRUE FALSE EQUALS JUST FALSE   -- not under the Agreement and an arrangement
#ASSERT `s 7(2.38) Lunar Gateway` TRUE TRUE EQUALS JUST TRUE   -- the civil Lunar Gateway
#ASSERT `s 7(2.38) Lunar Gateway` FALSE TRUE EQUALS JUST FALSE   -- not the civil Lunar Gateway
#ASSERT `s 7(2.38) the moment is within the space flight` 10 10 100 EQUALS JUST TRUE   -- the launching itself
#ASSERT `s 7(2.38) the moment is within the space flight` 100 10 100 EQUALS JUST TRUE   -- the landing itself
#ASSERT `s 7(2.38) the moment is within the space flight` 100.01 10 100 EQUALS JUST FALSE   -- after the landing

§ `s 7(2.35)  (Canadian crew member by (2.38); space flight by (2.38); outside Canada; class; grounds)`
#ASSERT `s 7(2.35) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.35(a)`) EQUALS JUST TRUE   -- (a)
#ASSERT `s 7(2.35) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.35(b)`) EQUALS JUST TRUE   -- (b)
#ASSERT `s 7(2.35) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.35(c)`) EQUALS JUST TRUE   -- (c): on the surface of the Moon
#ASSERT `s 7(2.35) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` EMPTY EQUALS JUST FALSE   -- none of (a) to (c)
#ASSERT `s 7(2.35) the act or omission is deemed to have been committed in Canada` (JUST FALSE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.35(a)`) EQUALS NOTHING   -- not a Canadian crew member
#ASSERT `s 7(2.35) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) FALSE `an indictable offence` (LIST `ccc1 test 2.35(a)`) EQUALS NOTHING   -- committed in Canada
#ASSERT `s 7(2.35) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an offence punishable on summary conviction` (LIST `ccc1 test 2.35(a)`) EQUALS NOTHING   -- not an indictable offence
#ASSERT `s 7(2.35) the act or omission is deemed to have been committed in Canada` NOTHING (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.35(a)`) EQUALS NOTHING   -- the definition did not answer

§ `s 7(2.36)  (crew member of a Partner State by (2.38); outside Canada during a space flight; place; class; grounds)`
#ASSERT `s 7(2.36) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.36(a)`) EQUALS JUST TRUE   -- (a)
#ASSERT `s 7(2.36) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.36(b)`) EQUALS JUST TRUE   -- (b)
#ASSERT `s 7(2.36) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an indictable offence` EMPTY EQUALS JUST FALSE   -- neither
#ASSERT `s 7(2.36) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) FALSE `an indictable offence` (LIST `ccc1 test 2.36(a)`) EQUALS NOTHING   -- not on the Gateway, a means of transportation or the surface of the Moon
#ASSERT `s 7(2.36) the act or omission is deemed to have been committed in Canada` (JUST FALSE) (JUST TRUE) TRUE `an indictable offence` (LIST `ccc1 test 2.36(a)`) EQUALS NOTHING   -- not a crew member of a Partner State
#ASSERT `s 7(2.36) the act or omission is deemed to have been committed in Canada` (JUST TRUE) (JUST TRUE) TRUE `an offence punishable on summary conviction` (LIST `ccc1 test 2.36(a)`) EQUALS NOTHING   -- not an indictable offence
#ASSERT `s 7(2.37) the proceedings are barred for want of the consent of the Attorney General of Canada` TRUE FALSE EQUALS JUST TRUE   -- no consent
#ASSERT `s 7(2.37) the proceedings are barred for want of the consent of the Attorney General of Canada` TRUE TRUE EQUALS NOTHING   -- consent obtained
#ASSERT `s 7(2.37) the proceedings are barred for want of the consent of the Attorney General of Canada` FALSE FALSE EQUALS NOTHING   -- another offence
