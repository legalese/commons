IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc5-s117-07-to-117-15`

-- Tests for ccc5-s117-07-to-117-15.l4. Every expected value was decided from the text before the run; a failing assertion is a finding.

-- s 117.07(2) public officer: expected values follow the text (s 117.07(2))
#ASSERT `s 117.07(2) public officer` (JUST TRUE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.07(2) public officer` NOTHING FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- element missing: s 2 peace officer: the person is one / the person is a member of the Canadian Forces or of the armed forces of a state other than Canada who is attached or seconded to any of the Canadian Forces / the person is an operator of a museum established by the Chief of the Defence Staff or a person employed in any such museum / the person is a member of a cadet organization under the control and supervision of the Canadian Forces / the person is training to become a police officer or a peace officer under the control and supervision of a police force, or of a police academy or similar institution designated by the Attorney General of Canada or the lieutenant governor in council of a province / the person is a member of a visiting force, within the meaning of section 2 of the Visiting Forces Act, who is authorized under paragraph 14(a) of that Act to possess and carry explosives, ammunition and firearms / the person, or a member of a class of persons, is employed in the federal public administration or by the government of a province or municipality and is prescribed to be a public officer / the person is the Commissioner of Firearms, the Registrar, a chief firearms officer, any firearms officer or a person designated under section 100 of the Firearms Act / the person is employed by the Bank of Canada or the Royal Canadian Mint and is responsible for the security of its facilities / the person is employed by a federal agency or body, other than in the federal public administration, is responsible for the security of its facilities and is prescribed to be a public officer
#ASSERT `s 117.07(2) public officer` (JUST TRUE) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- alternative present: s 2 peace officer: the person is one
#ASSERT `s 117.07(2) public officer` NOTHING TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the person is a member of the Canadian Forces or of the armed forces of a state other than Canada who is attached or seconded to any of the Canadian Forces
#ASSERT `s 117.07(2) public officer` NOTHING FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the person is an operator of a museum established by the Chief of the Defence Staff or a person employed in any such museum
#ASSERT `s 117.07(2) public officer` NOTHING FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the person is a member of a cadet organization under the control and supervision of the Canadian Forces
#ASSERT `s 117.07(2) public officer` NOTHING FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the person is training to become a police officer or a peace officer under the control and supervision of a police force, or of a police academy or similar institution designated by the Attorney General of Canada or the lieutenant governor in council of a province
#ASSERT `s 117.07(2) public officer` NOTHING FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the person is a member of a visiting force, within the meaning of section 2 of the Visiting Forces Act, who is authorized under paragraph 14(a) of that Act to possess and carry explosives, ammunition and firearms
#ASSERT `s 117.07(2) public officer` NOTHING FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the person, or a member of a class of persons, is employed in the federal public administration or by the government of a province or municipality and is prescribed to be a public officer
#ASSERT `s 117.07(2) public officer` NOTHING FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the person is the Commissioner of Firearms, the Registrar, a chief firearms officer, any firearms officer or a person designated under section 100 of the Firearms Act
#ASSERT `s 117.07(2) public officer` NOTHING FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE   -- alternative present: the person is employed by the Bank of Canada or the Royal Canadian Mint and is responsible for the security of its facilities
#ASSERT `s 117.07(2) public officer` NOTHING FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- alternative present: the person is employed by a federal agency or body, other than in the federal public administration, is responsible for the security of its facilities and is prescribed to be a public officer

-- s 117.07 the person is exempt from the prohibition (a public officer, and the other persons s 117.07 names): expected values follow the text (s 117.07)
#ASSERT `s 117.07 the person is exempt from the prohibition (a public officer, and the other persons s 117.07 names)` (JUST TRUE) TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE NOTHING EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.07 the person is exempt from the prohibition (a public officer, and the other persons s 117.07 names)` NOTHING TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE NOTHING EQUALS NOTHING   -- element missing: s 117.07(2) public officer: the person is one
