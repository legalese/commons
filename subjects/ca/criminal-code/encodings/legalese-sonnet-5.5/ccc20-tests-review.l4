IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc20-part16-review`

-- ccc20-tests-review.l4 -- tests for ccc20-part16-review.l4 (ss 520 to 523). Expected values are hand-written from the text of lines 11573-11665.

§ `Tests -- section 520`
-- (1) args: the order is one under 515(2), (5), (6), (7), (12) or 523(2)(b); the application is made before the trial
#ASSERT `s 520(1) the accused may apply to a judge for a review of the order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 520(1) the accused may apply to a judge for a review of the order` FALSE TRUE EQUALS NOTHING
#ASSERT `s 520(1) the accused may apply to a judge for a review of the order` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 520(1) the accused may apply to a judge for a review of the order` FALSE FALSE EQUALS NOTHING
-- (2) args: clear days of notice in writing; the prosecutor otherwise consents
#ASSERT `s 520(2) the application may be heard by a judge` 2 FALSE EQUALS JUST TRUE
#ASSERT `s 520(2) the application may be heard by a judge` 1 FALSE EQUALS JUST FALSE
#ASSERT `s 520(2) the application may be heard by a judge` 0 TRUE EQUALS JUST TRUE
#ASSERT `s 520(2) the application may be heard by a judge` 1.9 FALSE EQUALS JUST FALSE
#ASSERT `s 520(2) the application may be heard by a judge` 3 FALSE EQUALS JUST TRUE
#ASSERT `s 520(3) the accused must be present at the hearing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 520(3) the accused must be present at the hearing` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 520(3) the judge may order in writing the person having custody of the accused to bring the accused before the court` TRUE EQUALS JUST TRUE
#ASSERT `s 520(3) the judge may order in writing the person having custody of the accused to bring the accused before the court` FALSE EQUALS JUST FALSE
#ASSERT `s 520(4) the judge may adjourn the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 520(4) the judge may adjourn the proceedings` FALSE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was `s 520(4) the judge may adjourn the proceedings` FALSE EQUALS NOTHING; the "on" gate on a "may" counts as "where" (delegated ruling (c)): the function now answers the guide's JUST FALSE (the other reading is NOTHING, listed in the name-test sweep)
-- (4) args: the accused is in custody; the clear days of the adjournment; the accused consents to a longer one
#ASSERT `s 520(4) the adjournment of an accused in custody is within the limit of three clear days, or the accused consents` TRUE 3 FALSE EQUALS JUST TRUE
#ASSERT `s 520(4) the adjournment of an accused in custody is within the limit of three clear days, or the accused consents` TRUE 4 FALSE EQUALS JUST FALSE
#ASSERT `s 520(4) the adjournment of an accused in custody is within the limit of three clear days, or the accused consents` TRUE 4 TRUE EQUALS JUST TRUE
#ASSERT `s 520(4) the adjournment of an accused in custody is within the limit of three clear days, or the accused consents` FALSE 10 FALSE EQUALS NOTHING
#ASSERT `s 520(5) the judge may issue a warrant for the arrest of the accused` TRUE EQUALS JUST TRUE
#ASSERT `s 520(5) the judge may issue a warrant for the arrest of the accused` FALSE EQUALS JUST FALSE
#ASSERT `s 520(6) the warrant may be executed anywhere in Canada` TRUE EQUALS JUST TRUE
#ASSERT `s 520(6) the warrant may be executed anywhere in Canada` FALSE EQUALS NOTHING
#ASSERT `s 520(7) the judge may consider the material` `s 520(7)(a) the transcript, if any, of the proceedings heard by the justice and by any judge who previously reviewed the order` EQUALS JUST TRUE
#ASSERT `s 520(7) the judge may consider the material` `s 520(7)(b) the exhibits, if any, filed in the proceedings before the justice` EQUALS JUST TRUE
#ASSERT `s 520(7) the judge may consider the material` `s 520(7)(c) such additional evidence or exhibits as may be tendered by the accused or the prosecutor` EQUALS JUST TRUE
#ASSERT `s 520(7) the judge may consider the material` `s 520(7) something the list does not name` EQUALS NOTHING
-- (7)(d), (e) args: the hearing is held; the accused shows cause
#ASSERT `s 520(7) the judge must dismiss the application` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 520(7) the judge must dismiss the application` TRUE TRUE EQUALS NOTHING
#ASSERT `s 520(7) the judge must dismiss the application` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 520(7)(e) the judge may allow the application, vacate or vary the order and make any other order provided for in section 515` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 520(7)(e) the judge may allow the application, vacate or vary the order and make any other order provided for in section 515` TRUE FALSE EQUALS NOTHING
#ASSERT `s 520(7)(e) the judge may allow the application, vacate or vary the order and make any other order provided for in section 515` FALSE TRUE EQUALS NOTHING
-- (8) args: a previous application under s 520, 521 or 525 has been heard; the date of the decision; the date of the further application; the judge has given leave (1 March 2026 plus 30 days is 31 March)
#ASSERT `s 520(8) the further application is barred` TRUE (Date 1 3 2026) (Date 31 3 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 520(8) the further application is barred` TRUE (Date 1 3 2026) (Date 1 4 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 520(8) the further application is barred` TRUE (Date 1 3 2026) (Date 2 3 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 520(8) the further application is barred` TRUE (Date 1 3 2026) (Date 15 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 520(8) the further application is barred` FALSE (Date 1 3 2026) (Date 15 3 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 520(9) sections 517, 518 and 519 apply with such modifications as the circumstances require` TRUE EQUALS JUST TRUE
#ASSERT `s 520(9) sections 517, 518 and 519 apply with such modifications as the circumstances require` FALSE EQUALS NOTHING

