§ `Tests -- section 522`
-- (1) args: s 469 listing; the person is a judge of, or presiding in, a superior court of criminal jurisdiction for the province
#ASSERT `s 522(1) the court, judge or justice is barred from releasing the accused` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 522(1) the court, judge or justice is barred from releasing the accused` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 522(1) the court, judge or justice is barred from releasing the accused` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 522(1) the court, judge or justice is barred from releasing the accused` NOTHING FALSE EQUALS NOTHING
-- (2) args: s 469 listing; the person is such a judge; the accused shows cause by clearly demonstrating that their release plan addresses the risks
#ASSERT `s 522(2) the judge must order that the accused be detained in custody` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 522(2) the judge must order that the accused be detained in custody` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 522(2) the judge must order that the accused be detained in custody` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 522(2) the judge must order that the accused be detained in custody` (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 522(2) the judge must order that the accused be detained in custody` NOTHING TRUE FALSE EQUALS NOTHING
