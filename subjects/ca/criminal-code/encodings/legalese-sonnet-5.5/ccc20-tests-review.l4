#ASSERT `s 522(2.1) the judge may include in the order a direction that the accused abstain from communicating with any victim, witness or other person` FALSE EQUALS NOTHING
#ASSERT `s 522(3) the judge may make a release order referred to in section 515` TRUE EQUALS JUST TRUE
#ASSERT `s 522(3) the judge may make a release order referred to in section 515` FALSE EQUALS NOTHING
#ASSERT `s 522(3.1) subsection 515(2.01) applies to the accused` TRUE EQUALS JUST FALSE
#ASSERT `s 522(3.1) subsection 515(2.01) applies to the accused` FALSE EQUALS NOTHING
#ASSERT `s 522(4) the order is subject to review other than under section 680` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 522(4) the order is subject to review other than under section 680` FALSE FALSE EQUALS NOTHING
#ASSERT `s 522(5) subsection 518(2) applies to the application` TRUE EQUALS JUST FALSE
#ASSERT `s 522(5) subsection 518(2) applies to the application` FALSE EQUALS NOTHING
#ASSERT `s 522(5) sections 517 and 519, and section 518 except subsection (2), apply with such modifications as the circumstances require` TRUE EQUALS JUST TRUE
#ASSERT `s 522(5) sections 517 and 519, and section 518 except subsection (2), apply with such modifications as the circumstances require` FALSE EQUALS NOTHING
