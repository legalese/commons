-- 349(1): without lawful excuse, the place is a dwelling-house (s 2), enters or is in it, with intent to commit an indictable offence in it
#ASSERT `s 349(1) the person commits the offence of being unlawfully in a dwelling-house` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 349(1) the person commits the offence of being unlawfully in a dwelling-house` TRUE NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 349(1) the person commits the offence of being unlawfully in a dwelling-house` TRUE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 349(1) the person commits the offence of being unlawfully in a dwelling-house` FALSE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 349(1) the person commits the offence of being unlawfully in a dwelling-house` TRUE (JUST TRUE) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 349(1) the person commits the offence of being unlawfully in a dwelling-house` TRUE (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 349(1) the punishment for the offence` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`
#ASSERT `s 349(2) the evidence is proof that the accused entered or was in the dwelling-house with intent to commit an indictable offence therein` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 349(2) the evidence is proof that the accused entered or was in the dwelling-house with intent to commit an indictable offence therein` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 349(2) the evidence is proof that the accused entered or was in the dwelling-house with intent to commit an indictable offence therein` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 349(2) the evidence is proof that the accused entered or was in the dwelling-house with intent to commit an indictable offence therein` TRUE FALSE FALSE EQUALS NOTHING
-- 350(a): any part of the body, any part of an instrument; (b): a threat, an artifice or collusion; a permanent or temporary opening
#ASSERT `s 350(a) the person enters` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 350(a) the person enters` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 350(a) the person enters` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 350(b) the person is deemed to have broken and entered` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 350(b) the person is deemed to have broken and entered` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 350(b) the person is deemed to have broken and entered` FALSE FALSE EQUALS JUST FALSE

§ `ss 351 to 353.1`
