IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc12-logic`
IMPORT `ccc12-tests-fixtures`
IMPORT `ccc12-part9-break-enter`

-- Tests of ss 348 to 353.1. Expected values are hand-written from the text before each run. Arguments are positional, in the GIVEN order of each function.

§ `s 348 breaking and entering`
-- breaks (s 321), enters (s 350(a)), deemed to have broken and entered (s 350(b)), a place (s 348(3)), intent to commit an indictable offence, commits an indictable offence, breaks out, broke out after committing, broke out after entering with intent
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- deemed to have broken and entered (s 350(b)) is enough without a break
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- breaking without entering, and not deemed
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- not a place
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- answers not given
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` (JUST TRUE) (JUST TRUE) (JUST FALSE) NOTHING TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` NOTHING (JUST TRUE) (JUST FALSE) (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (c) breaks out of a place after committing an indictable offence there, or after entering with intent
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 348(1) the person commits the offence of breaking and entering, or of breaking out` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- (d) a dwelling-house: an indictable offence and life; (e) another place: indictable not exceeding ten years, or summary
#ASSERT `s 348(1) the punishment for the offence` (JUST TRUE) `ccc12 fixture general summary penalty` EQUALS JUST (LIST `ccc12 fixture indictable, life`)
#ASSERT `s 348(1) the punishment for the offence` (JUST FALSE) `ccc12 fixture general summary penalty` EQUALS JUST (LIST `ccc12 fixture indictable, up to ten years`, `ccc12 fixture general summary penalty`)
#ASSERT `s 348(1) the punishment for the offence` NOTHING `ccc12 fixture general summary penalty` EQUALS NOTHING
-- (2)(a), (b): proceedings under section 348, the evidence, evidence to the contrary
#ASSERT `s 348(2)(a) the evidence is proof that the accused broke and entered the place or attempted to do so with intent to commit an indictable offence therein` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 348(2)(a) the evidence is proof that the accused broke and entered the place or attempted to do so with intent to commit an indictable offence therein` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 348(2)(a) the evidence is proof that the accused broke and entered the place or attempted to do so with intent to commit an indictable offence therein` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 348(2)(a) the evidence is proof that the accused broke and entered the place or attempted to do so with intent to commit an indictable offence therein` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 348(2)(b) the evidence is proof that the accused broke out after committing an indictable offence therein or after entering with intent to commit one` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 348(2)(b) the evidence is proof that the accused broke out after committing an indictable offence therein or after entering with intent to commit one` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 348(2)(b) the evidence is proof that the accused broke out after committing an indictable offence therein or after entering with intent to commit one` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 348(2)(b) the evidence is proof that the accused broke out after committing an indictable offence therein or after entering with intent to commit one` TRUE FALSE FALSE EQUALS NOTHING
-- (3) place
#ASSERT `s 348(3) the thing is a place` `s 348(3)(a) a dwelling-house` EQUALS JUST TRUE
#ASSERT `s 348(3) the thing is a place` `s 348(3)(b) a building or structure or any part of one, other than a dwelling-house` EQUALS JUST TRUE
#ASSERT `s 348(3) the thing is a place` `s 348(3)(c) a railway vehicle` EQUALS JUST TRUE
#ASSERT `s 348(3) the thing is a place` `s 348(3)(c) a vessel` EQUALS JUST TRUE
#ASSERT `s 348(3) the thing is a place` `s 348(3)(c) an aircraft` EQUALS JUST TRUE
#ASSERT `s 348(3) the thing is a place` `s 348(3)(c) a trailer` EQUALS JUST TRUE
#ASSERT `s 348(3) the thing is a place` `s 348(3)(d) a pen or an enclosure in which fur-bearing animals are kept in captivity for breeding or commercial purposes` EQUALS JUST TRUE
#ASSERT `s 348(3) the thing is a place` `s 348(3) none of those` EQUALS JUST FALSE

