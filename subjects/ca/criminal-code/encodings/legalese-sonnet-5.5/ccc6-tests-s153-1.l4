IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc6-builders`
IMPORT `ccc6-s153-1`
IMPORT `ccc6-tests-support`

-- Tests for s 153.1. Expected values decided from the text before each run.

§ `s 153.1(3) no consent is obtained`
-- (words of another, unconscious, otherwise incapable, abuse of trust, expresses lack of agreement, withdraws agreement to continue)
#ASSERT `s 153.1(3) no consent is obtained` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 153.1(3) no consent is obtained` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- (a.1)
#ASSERT `s 153.1(3) no consent is obtained` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- (b)
#ASSERT `s 153.1(3) no consent is obtained` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- (c)
#ASSERT `s 153.1(3) no consent is obtained` FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE   -- (d)
#ASSERT `s 153.1(3) no consent is obtained` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- (e)
#ASSERT `s 153.1(3) no consent is obtained` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 153.1(3) no consent is obtained` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- none listed: subsection (4) keeps the list open
#ASSERT `s 153.1(4) subsection (3) limits the circumstances in which no consent is obtained` EQUALS JUST FALSE   -- "Nothing in subsection (3) shall be construed as limiting"

§ `s 153.1(2.2) a question of law`
#ASSERT `s 153.1(2.2) the question is a question of law` TRUE EQUALS JUST TRUE
#ASSERT `s 153.1(2.2) the question is a question of law` FALSE EQUALS NOTHING   -- any other question: the subsection is silent

§ `s 153.1(2) and (2.1) consent`
-- (voluntarily agreed, the agreement was present at the time, s 153.1(3) answer, another circumstance of no consent)
#ASSERT `s 153.1(2) consent` TRUE TRUE NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 153.1(2) consent` FALSE TRUE NOTHING FALSE EQUALS JUST FALSE   -- not "the voluntary agreement of the complainant"
#ASSERT `s 153.1(2) consent` TRUE FALSE NOTHING FALSE EQUALS JUST FALSE   -- (2.1): "Consent must be present at the time"
#ASSERT `s 153.1(2) consent` TRUE TRUE (JUST TRUE) FALSE EQUALS JUST FALSE   -- "Subject to subsection (3)": a ground in (3) holds
#ASSERT `s 153.1(2) consent` TRUE TRUE NOTHING TRUE EQUALS JUST FALSE   -- another circumstance (subsection (4), s 265(3)) in which no consent is obtained
#ASSERT `s 153.1(2) consent` TRUE TRUE (JUST FALSE) FALSE EQUALS JUST TRUE

§ `s 153.1(1) Sexual exploitation of a person with a disability`
-- (trust or authority, dependency, counselled or incited for a sexual purpose, what to do, the answer of s 153.1(2) consent)
#ASSERT `s 153.1(1) the conduct is the offence of sexual exploitation of a person with a disability` TRUE FALSE TRUE `s 153.1(1)(a) touch their own body, the body of the person who so counsels or incites or the body of any other person, directly or indirectly, with a part of the body or with an object` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 153.1(1) the conduct is the offence of sexual exploitation of a person with a disability` FALSE TRUE TRUE `s 153.1(1)(b) expose their own sexual organs` (JUST FALSE) EQUALS JUST TRUE   -- dependency instead of trust
#ASSERT `s 153.1(1) the conduct is the offence of sexual exploitation of a person with a disability` TRUE FALSE TRUE `s 153.1(1)(b) expose their own sexual organs` (JUST TRUE) EQUALS NOTHING   -- the person consented: not "without that person's consent"
#ASSERT `s 153.1(1) the conduct is the offence of sexual exploitation of a person with a disability` TRUE FALSE TRUE `s 153.1(1)(b) expose their own sexual organs` NOTHING EQUALS NOTHING   -- consent undetermined
#ASSERT `s 153.1(1) the conduct is the offence of sexual exploitation of a person with a disability` FALSE FALSE TRUE `s 153.1(1)(b) expose their own sexual organs` (JUST FALSE) EQUALS NOTHING   -- neither relationship
#ASSERT `s 153.1(1) the conduct is the offence of sexual exploitation of a person with a disability` TRUE FALSE FALSE `s 153.1(1)(b) expose their own sexual organs` (JUST FALSE) EQUALS NOTHING   -- not for a sexual purpose
#ASSERT `s 153.1(1) the conduct is the offence of sexual exploitation of a person with a disability` TRUE FALSE TRUE `s 153.1(1) something else` (JUST FALSE) EQUALS NOTHING   -- neither (a) nor (b)
#ASSERT `s 153.1(1.1)(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 10) `no imprisonment is stated`   -- "not exceeding 10 years"; no minimum
-- (b): the penalty is s 787(1)'s, passed through with the mode set to summary conviction
#ASSERT `s 153.1(1.1)(b) the punishment on summary conviction` (`ss 150 to 182 test a summary punishment` (`ss 150 to 182 test a term of months` 6) `no imprisonment is stated`) EQUALS `ss 150 to 182 test a summary punishment` (`ss 150 to 182 test a term of months` 6) `no imprisonment is stated`
#ASSERT (`s 153.1(1.1)(b) the punishment on summary conviction` (`ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 5) `no imprisonment is stated`))'s `mode` EQUALS `on summary conviction`   -- a record passed with the wrong mode comes back as summary
#ASSERT `s 153.1 the class of the offence` EQUALS `ss 150 to 182 test both`

§ `s 153.1(5) the belief that the complainant consented`
-- (charged under this section and alleges the belief, (a)(i) self-induced intoxication, (a)(ii) recklessness or wilful blindness, (a)(iii) a circumstance of no consent, (b) no reasonable steps, (c) no evidence of affirmative expression)
#ASSERT `s 153.1(5) the belief that the complainant consented is not a defence: the bar applies` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 153.1(5) the belief that the complainant consented is not a defence: the bar applies` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 153.1(5) the belief that the complainant consented is not a defence: the bar applies` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 153.1(5) the belief that the complainant consented is not a defence: the bar applies` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 153.1(5) the belief that the complainant consented is not a defence: the bar applies` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 153.1(5) the belief that the complainant consented is not a defence: the bar applies` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- none of (a), (b), (c): the subsection does not bar the belief
#ASSERT `s 153.1(5) the belief that the complainant consented is not a defence: the bar applies` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING   -- no belief alleged, or not under this section

§ `s 153.1(6) the judge's instruction to the jury`
-- (the accused alleges the belief, the judge is satisfied)
#ASSERT `s 153.1(6) the judge must instruct the jury to consider the presence or absence of reasonable grounds for the belief` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 153.1(6) the judge must instruct the jury to consider the presence or absence of reasonable grounds for the belief` TRUE FALSE EQUALS JUST FALSE   -- the judge is not satisfied: the "if" fails
#ASSERT `s 153.1(6) the judge must instruct the jury to consider the presence or absence of reasonable grounds for the belief` FALSE TRUE EQUALS JUST FALSE   -- no allegation of belief
-- The duty as a regulative rule: a DEONTIC value cannot be asserted on the stable binary, so the traces are read, not asserted.
#TRACE `s 153.1(6) the judge's duty to instruct the jury` AT 0 WITH
    PARTY `a judge` DOES `s 153.1(6) instruct the jury, when reviewing the evidence on the honesty of the belief, to consider the presence or absence of reasonable grounds for it` AT 1
-- (expected: FULFILLED)
#TRACE `s 153.1(6) the judge's duty to instruct the jury` AT 0 WITH
    (WAITUNTIL 5)
-- (expected: the duty still stands: no deadline is stated, so nothing is a breach)
