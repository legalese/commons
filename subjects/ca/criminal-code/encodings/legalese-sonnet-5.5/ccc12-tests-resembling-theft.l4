IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc12-logic`
IMPORT `ccc12-tests-fixtures`
IMPORT `ccc12-part9-resembling-theft`

-- Tests of ss 335 to 342.2. Expected values are hand-written from the text before each run. Arguments are positional, in the GIVEN order of each function
-- (given in the comment above each group). A MAYBE input is written JUST TRUE, JUST FALSE or NOTHING.

§ `s 335 taking a motor vehicle or vessel without consent`
-- motor vehicle (s 2), vessel (s 335(2)), without the owner's consent, takes it with intent, occupant knowing, attempted to leave, actually left
#ASSERT `s 335(1) the person is guilty of the offence of taking a motor vehicle or vessel without consent, or of being an occupant of one taken without consent` (JUST TRUE) (JUST FALSE) TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 335(1) the person is guilty of the offence of taking a motor vehicle or vessel without consent, or of being an occupant of one taken without consent` (JUST FALSE) (JUST TRUE) TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 335(1) the person is guilty of the offence of taking a motor vehicle or vessel without consent, or of being an occupant of one taken without consent` (JUST FALSE) (JUST FALSE) TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 335(1) the person is guilty of the offence of taking a motor vehicle or vessel without consent, or of being an occupant of one taken without consent` NOTHING (JUST FALSE) TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 335(1) the person is guilty of the offence of taking a motor vehicle or vessel without consent, or of being an occupant of one taken without consent` (JUST TRUE) (JUST FALSE) FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 335(1) the person is guilty of the offence of taking a motor vehicle or vessel without consent, or of being an occupant of one taken without consent` (JUST TRUE) (JUST FALSE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- an occupant knowing it was taken without consent
#ASSERT `s 335(1) the person is guilty of the offence of taking a motor vehicle or vessel without consent, or of being an occupant of one taken without consent` (JUST TRUE) (JUST FALSE) FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- subject to (1.1): an occupant who attempted to leave, or left, is outside the offence
#ASSERT `s 335(1) the person is guilty of the offence of taking a motor vehicle or vessel without consent, or of being an occupant of one taken without consent` (JUST TRUE) (JUST FALSE) FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 335(1) the person is guilty of the offence of taking a motor vehicle or vessel without consent, or of being an occupant of one taken without consent` (JUST TRUE) (JUST FALSE) FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
-- the exception does not undo the taking limb
#ASSERT `s 335(1) the person is guilty of the offence of taking a motor vehicle or vessel without consent, or of being an occupant of one taken without consent` (JUST TRUE) (JUST FALSE) TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 335(1) the punishment for the offence` `ccc12 fixture general summary penalty` EQUALS LIST `ccc12 fixture general summary penalty`
-- (1.1): occupant, attempted to leave, actually left
#ASSERT `s 335(1.1) subsection (1) applies to an occupant` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 335(1.1) subsection (1) applies to an occupant` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 335(1.1) subsection (1) applies to an occupant` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 335(1.1) subsection (1) applies to an occupant` FALSE TRUE FALSE EQUALS NOTHING
-- (2): vessel as in s 320.11, taken as given
#ASSERT `s 335(2) the thing is a vessel for the purposes of subsection (1)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 335(2) the thing is a vessel for the purposes of subsection (1)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 335(2) the thing is a vessel for the purposes of subsection (1)` NOTHING EQUALS NOTHING

