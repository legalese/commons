IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc-definitions`
IMPORT `ccc13-fraud`
IMPORT `ccc13-tests-support`

-- ccc13-tests-fraud.l4 -- tests of ccc13-fraud.l4 (ss 379 to 381). Each expected value is decided from the text and written beside the assertion before the run.

§ `s 379 goods`
#ASSERT `s 379 goods` TRUE EQUALS JUST TRUE                          -- "anything that is the subject of trade or commerce"
#ASSERT `s 379 goods` FALSE EQUALS JUST FALSE                        -- "means": a thing that is not the subject of trade or commerce is outside

§ `s 380(1) fraud`
-- order of inputs: by deceit; defrauds; property kind; money; valuable security kind; service
GIVETH A `s 2 property kind`
`ccc13 test the property` MEANS `personal property of every description`
GIVETH A `s 2 property kind`
`ccc13 test no property` MEANS `a thing that is none of those`
GIVETH A `s 2 valuable security kind`
`ccc13 test the security` MEANS `a debenture, deed, bond, bill, note, warrant, order or other security for money or for payment of money`
GIVETH A `s 2 valuable security kind`
`ccc13 test no security` MEANS `an instrument that is none of those`

#ASSERT `s 380(1) the conduct is the offence of fraud` TRUE TRUE `ccc13 test the property` FALSE `ccc13 test no security` FALSE EQUALS JUST TRUE      -- defrauds of property by deceit
#ASSERT `s 380(1) the conduct is the offence of fraud` TRUE TRUE `ccc13 test no property` TRUE `ccc13 test no security` FALSE EQUALS JUST TRUE       -- of money
#ASSERT `s 380(1) the conduct is the offence of fraud` TRUE TRUE `ccc13 test no property` FALSE `ccc13 test no security` TRUE EQUALS JUST TRUE       -- of a service
#ASSERT `s 380(1) the conduct is the offence of fraud` TRUE TRUE `ccc13 test no property` FALSE `ccc13 test the security` FALSE EQUALS JUST TRUE      -- of a valuable security
#ASSERT `s 380(1) the conduct is the offence of fraud` FALSE TRUE `ccc13 test the property` FALSE `ccc13 test no security` FALSE EQUALS JUST FALSE     -- no deceit, falsehood or other fraudulent means
#ASSERT `s 380(1) the conduct is the offence of fraud` TRUE FALSE `ccc13 test the property` FALSE `ccc13 test no security` FALSE EQUALS JUST FALSE     -- defrauds no one
#ASSERT `s 380(1) the conduct is the offence of fraud` TRUE TRUE `ccc13 test no property` FALSE `ccc13 test no security` FALSE EQUALS NOTHING         -- none of property, money, valuable security, service: s 2 property and s 2 valuable security are open lists, so NOTHING passes through

§ `s 380(1)(a) and (b) the limbs`
#ASSERT `s 380(1)(a) the subject-matter is a testamentary instrument or its value exceeds five thousand dollars` (JUST TRUE) 100 EQUALS JUST TRUE            -- a testamentary instrument of any value
#ASSERT `s 380(1)(a) the subject-matter is a testamentary instrument or its value exceeds five thousand dollars` (JUST FALSE) 5000 EQUALS JUST FALSE         -- exactly five thousand does not exceed
#ASSERT `s 380(1)(a) the subject-matter is a testamentary instrument or its value exceeds five thousand dollars` (JUST FALSE) 5000.01 EQUALS JUST TRUE       -- one cent over
#ASSERT `s 380(1)(a) the subject-matter is a testamentary instrument or its value exceeds five thousand dollars` NOTHING 5000 EQUALS NOTHING               -- the s 2 answer is open and the value does not decide
#ASSERT `s 380(1)(a) the subject-matter is a testamentary instrument or its value exceeds five thousand dollars` NOTHING 6000 EQUALS JUST TRUE              -- the value decides
#ASSERT `s 380(1)(b) the value of the subject-matter does not exceed five thousand dollars` 5000 EQUALS JUST TRUE
#ASSERT `s 380(1)(b) the value of the subject-matter does not exceed five thousand dollars` 5000.01 EQUALS JUST FALSE
#ASSERT `s 380(1)(b) the value of the subject-matter does not exceed five thousand dollars` 0 EQUALS JUST TRUE

§ `s 380(1) punishments and class`
-- limb (a) only: indictable, fourteen years
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test the limbs of the answer` (`s 380(1) the punishments` (JUST TRUE) (JUST FALSE) `ccc13 test p787`)) EQUALS `imprisonment for a term of` `fourteen years`
#ASSERT `ccc13 test the number of limbs` (`ccc13 test the limbs of the answer` (`s 380(1) the punishments` (JUST TRUE) (JUST FALSE) `ccc13 test p787`)) EQUALS 1
#ASSERT `s 380(1) the class of the offence` (JUST TRUE) (JUST FALSE) EQUALS JUST `an indictable offence`
-- limb (b) only: (i) indictable two years, (ii) summary conviction with no penalty stated: the s 787(1) input
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test the limbs of the answer` (`s 380(1) the punishments` (JUST FALSE) (JUST TRUE) `ccc13 test p787`)) EQUALS `imprisonment for a term of` `two years`
#ASSERT `ccc13 test the number of limbs` (`ccc13 test the limbs of the answer` (`s 380(1) the punishments` (JUST FALSE) (JUST TRUE) `ccc13 test p787`)) EQUALS 2
#ASSERT `ccc13 test the summary limb is the s 787(1) stand-in` (`ccc13 test the limbs of the answer` (`s 380(1) the punishments` (JUST FALSE) (JUST TRUE) `ccc13 test p787`)) EQUALS TRUE
#ASSERT `s 380(1) the class of the offence` (JUST FALSE) (JUST TRUE) EQUALS JUST `an offence that the section makes both indictable and punishable on summary conviction`
-- a testamentary instrument of five thousand dollars or less is within both limbs (fork F3): NOTHING
#ASSERT `s 380(1) the punishments` (JUST TRUE) (JUST TRUE) `ccc13 test p787` EQUALS NOTHING
#ASSERT `s 380(1) the class of the offence` (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 380(1) the punishments` NOTHING (JUST TRUE) `ccc13 test p787` EQUALS NOTHING
#ASSERT `s 380(1) the class of the offence` NOTHING (JUST TRUE) EQUALS NOTHING

§ `s 380(1.1) minimum punishment`
#ASSERT `s 380(1.1) the court shall impose a minimum punishment of imprisonment for a term of two years` TRUE TRUE 1000001 EQUALS JUST TRUE
#ASSERT `s 380(1.1) the court shall impose a minimum punishment of imprisonment for a term of two years` TRUE TRUE 1000000 EQUALS JUST FALSE     -- "exceeds one million dollars": exactly one million does not
#ASSERT `s 380(1.1) the court shall impose a minimum punishment of imprisonment for a term of two years` TRUE TRUE 1000000.01 EQUALS JUST TRUE
#ASSERT `s 380(1.1) the court shall impose a minimum punishment of imprisonment for a term of two years` FALSE TRUE 5000000 EQUALS JUST FALSE     -- not prosecuted on indictment
#ASSERT `s 380(1.1) the court shall impose a minimum punishment of imprisonment for a term of two years` TRUE FALSE 5000000 EQUALS JUST FALSE     -- not convicted
#ASSERT `ccc13 test the minimum imprisonment by indictment` (LIST `s 380(1.1) the minimum punishment`) EQUALS `imprisonment for a term of` `two years`
-- the regulative rule: the duty is run; there is no assertion on a DEONTIC value on the stable binary (see NOTES.md, what the binary does not accept)
#TRACE `s 380(1.1) the duty of the court` (JUST TRUE) AT 0 WITH
    PARTY `the court` DOES `s 380(1.1) impose a minimum punishment of imprisonment for a term of two years` AT 1
#TRACE `s 380(1.1) the duty of the court` (JUST TRUE) AT 0 WITH
#TRACE `s 380(1.1) the duty of the court` (JUST FALSE) AT 0 WITH
#TRACE `s 380(1.1) the duty of the court` NOTHING AT 0 WITH

§ `s 380(2) affecting the public market`
#ASSERT `s 380(2) the conduct is the offence of affecting the public market` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 380(2) the conduct is the offence of affecting the public market` TRUE FALSE TRUE EQUALS JUST FALSE     -- no intent to defraud
#ASSERT `s 380(2) the conduct is the offence of affecting the public market` FALSE TRUE TRUE EQUALS JUST FALSE     -- no deceit, falsehood or other fraudulent means
#ASSERT `s 380(2) the conduct is the offence of affecting the public market` TRUE TRUE FALSE EQUALS JUST FALSE     -- does not affect the public market price
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 380(2) the punishments`) EQUALS `imprisonment for a term of` `fourteen years`
#ASSERT `ccc13 test the number of limbs` (`s 380(2) the punishments`) EQUALS 1
#ASSERT `s 380(2) the class of the offence` EQUALS `an indictable offence`

§ `s 380.1(1) aggravating circumstances`
`ccc13 test circumstance (a)` MEANS `s 380.1(1) the magnitude, complexity, duration or degree of planning of the fraud committed was significant`
`ccc13 test circumstance (c.1)` MEANS `s 380.1(1) the offence had a significant impact on the victims given their personal circumstances including their age, health and financial situation`
`ccc13 test no circumstance` MEANS `s 380.1(1) the circumstance is none of those in paragraphs (a) to (f)`
#ASSERT `s 380.1(1) the court shall consider the circumstance as aggravating` (`ccc13 test the provision` 380 "") `ccc13 test circumstance (a)` EQUALS JUST TRUE
#ASSERT `s 380.1(1) the court shall consider the circumstance as aggravating` (`ccc13 test the provision` 382 "") `ccc13 test circumstance (c.1)` EQUALS JUST TRUE
#ASSERT `s 380.1(1) the court shall consider the circumstance as aggravating` (`ccc13 test the provision` 382.1 "(1)") `ccc13 test circumstance (a)` EQUALS JUST TRUE
#ASSERT `s 380.1(1) the court shall consider the circumstance as aggravating` (`ccc13 test the provision` 400 "(1)") `ccc13 test circumstance (a)` EQUALS JUST TRUE
#ASSERT `s 380.1(1) the court shall consider the circumstance as aggravating` (`ccc13 test the provision` 381 "") `ccc13 test circumstance (a)` EQUALS JUST FALSE        -- section 381 is not in the list
#ASSERT `s 380.1(1) the court shall consider the circumstance as aggravating` (`ccc13 test the provision` 380.1 "(1)") `ccc13 test circumstance (a)` EQUALS JUST FALSE    -- section 380.1 is not section 380
#ASSERT `s 380.1(1) the court shall consider the circumstance as aggravating` (`ccc13 test the provision` 380 "(1)") `ccc13 test no circumstance` EQUALS NOTHING
#TRACE `s 380.1(1) the duty of the court` (JUST TRUE) AT 0 WITH
    PARTY `the court` DOES `s 380.1(1) consider the circumstance as an aggravating circumstance` AT 1
#TRACE `s 380.1(1) the duty of the court` (JUST FALSE) AT 0 WITH

§ `s 380.1(1.1) value of the fraud`
#ASSERT `s 380.1(1.1) the court shall consider the value of the fraud as aggravating` (`ccc13 test the provision` 382 "") 1000001 EQUALS JUST TRUE
#ASSERT `s 380.1(1.1) the court shall consider the value of the fraud as aggravating` (`ccc13 test the provision` 382.1 "(1)") 1000001 EQUALS JUST TRUE
#ASSERT `s 380.1(1.1) the court shall consider the value of the fraud as aggravating` (`ccc13 test the provision` 400 "(1)") 1000001 EQUALS JUST TRUE
#ASSERT `s 380.1(1.1) the court shall consider the value of the fraud as aggravating` (`ccc13 test the provision` 382 "") 1000000 EQUALS NOTHING      -- exactly one million did not exceed it
#ASSERT `s 380.1(1.1) the court shall consider the value of the fraud as aggravating` (`ccc13 test the provision` 380 "(1)") 5000000 EQUALS JUST FALSE   -- section 380 is not in the list of (1.1)
#TRACE `s 380.1(1.1) the duty of the court` (JUST TRUE) AT 0 WITH
    PARTY `the court` DOES `s 380.1(1.1) consider as an aggravating circumstance the fact that the value of the fraud committed exceeded one million dollars` AT 1

§ `s 380.1(2) non-mitigating factors`
#ASSERT `s 380.1(2) the court shall not consider the circumstance as mitigating` (`ccc13 test the provision` 380 "(1)") `s 380.1(2) the offender’s employment` TRUE EQUALS JUST TRUE
#ASSERT `s 380.1(2) the court shall not consider the circumstance as mitigating` (`ccc13 test the provision` 400 "(1)") `s 380.1(2) the offender’s status or reputation in the community` TRUE EQUALS JUST TRUE
#ASSERT `s 380.1(2) the court shall not consider the circumstance as mitigating` (`ccc13 test the provision` 380 "(1)") `s 380.1(2) the offender’s employment skills` FALSE EQUALS JUST FALSE     -- "if those circumstances were relevant to, contributed to, or were used in the commission": they were not
#ASSERT `s 380.1(2) the court shall not consider the circumstance as mitigating` (`ccc13 test the provision` 381 "") `s 380.1(2) the offender’s employment` TRUE EQUALS JUST FALSE                -- section 381 is outside the list
#ASSERT `s 380.1(2) the court shall not consider the circumstance as mitigating` (`ccc13 test the provision` 380 "(1)") `s 380.1(2) a circumstance that is none of those` TRUE EQUALS NOTHING     -- only three circumstances are named
#TRACE `s 380.1(2) the prohibition on the court` (JUST TRUE) AT 0 WITH
    PARTY `the court` DOES `s 380.1(2) consider the circumstance as a mitigating circumstance` AT 1
#TRACE `s 380.1(2) the prohibition on the court` (JUST TRUE) AT 0 WITH

§ `s 380.1(3) the record`
#ASSERT `s 380.1(3) the court shall cause the circumstances it took into account to be stated in the record` (`ccc13 test the provision` 380 "(1)") EQUALS JUST TRUE
#ASSERT `s 380.1(3) the court shall cause the circumstances it took into account to be stated in the record` (`ccc13 test the provision` 400 "(1)") EQUALS JUST TRUE
#ASSERT `s 380.1(3) the court shall cause the circumstances it took into account to be stated in the record` (`ccc13 test the provision` 381 "") EQUALS NOTHING      -- fork F4: the subsection names no offence
#TRACE `s 380.1(3) the duty of the court` (JUST TRUE) AT 0 WITH
    PARTY `the court` DOES `s 380.1(3) cause the aggravating and mitigating circumstances it took into account to be stated in the record` AT 1

§ `s 380.2 prohibition order`
#ASSERT `s 380.2(1) the court may make an order prohibiting the offender from employment or volunteering` TRUE FALSE EQUALS JUST TRUE            -- convicted
#ASSERT `s 380.2(1) the court may make an order prohibiting the offender from employment or volunteering` FALSE TRUE EQUALS JUST TRUE            -- discharged on the conditions of a probation order under section 730
#ASSERT `s 380.2(1) the court may make an order prohibiting the offender from employment or volunteering` FALSE FALSE EQUALS JUST FALSE          -- neither: "When an offender is convicted, or is discharged"
#ASSERT `s 380.2(1) the activity is one the order may prohibit` `s 380.2(1) seeking, obtaining or continuing employment` TRUE EQUALS JUST TRUE
#ASSERT `s 380.2(1) the activity is one the order may prohibit` `s 380.2(1) becoming or being a volunteer in any capacity` TRUE EQUALS JUST TRUE
#ASSERT `s 380.2(1) the activity is one the order may prohibit` `s 380.2(1) seeking, obtaining or continuing employment` FALSE EQUALS NOTHING           -- no authority over another person's property, money or valuable security
#ASSERT `s 380.2(1) the activity is one the order may prohibit` `s 380.2(1) an activity that is neither` TRUE EQUALS NOTHING
#TRACE `s 380.2(1) the power of the court` (JUST TRUE) AT 0 WITH
    PARTY `the court` DOES `s 380.2(1) make an order prohibiting the offender from employment or volunteering` AT 1
#TRACE `s 380.2(1) the power of the court` (JUST TRUE) AT 0 WITH
#TRACE `s 380.2(1) the power of the court` (JUST FALSE) AT 0 WITH
#ASSERT `s 380.2(2) the prohibition may be for the period` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 380.2(2) the prohibition may be for the period` FALSE TRUE EQUALS JUST TRUE         -- "including any period to which the offender is sentenced to imprisonment"
#ASSERT `s 380.2(2) the prohibition may be for the period` FALSE FALSE EQUALS NOTHING
#ASSERT `s 380.2(3) the court may vary the conditions prescribed in the order` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 380.2(3) the court may vary the conditions prescribed in the order` FALSE TRUE TRUE TRUE EQUALS NOTHING    -- not that court, nor an equivalent court in the same province
#ASSERT `s 380.2(3) the court may vary the conditions prescribed in the order` TRUE FALSE TRUE TRUE EQUALS NOTHING    -- no application by the offender or the prosecutor
#ASSERT `s 380.2(3) the court may vary the conditions prescribed in the order` TRUE TRUE FALSE TRUE EQUALS NOTHING    -- the parties not heard
#ASSERT `s 380.2(3) the court may vary the conditions prescribed in the order` TRUE TRUE TRUE FALSE EQUALS NOTHING    -- no opinion that the variation is desirable
#TRACE `s 380.2(3) the power of the court` (JUST TRUE) AT 0 WITH
    PARTY `the court` DOES `s 380.2(3) vary the conditions prescribed in the order` AT 1
#ASSERT `s 380.2(4) the conduct is the offence of not complying with an order of prohibition` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 380.2(4) the conduct is the offence of not complying with an order of prohibition` TRUE FALSE EQUALS JUST FALSE      -- bound by the order and complies
#ASSERT `s 380.2(4) the conduct is the offence of not complying with an order of prohibition` FALSE TRUE EQUALS JUST FALSE      -- not bound by an order
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 380.2(4) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `two years`
#ASSERT `ccc13 test the summary limb is the s 787(1) stand-in` (`s 380.2(4) the punishments` `ccc13 test p787`) EQUALS TRUE
#ASSERT `ccc13 test the number of limbs` (`s 380.2(4) the punishments` `ccc13 test p787`) EQUALS 2
#ASSERT `s 380.2(4) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 380.3 as the text shows it` EQUALS "380.3 [Repealed, 2015, c. 13, s. 11]"
#ASSERT `s 380.4 as the text shows it` EQUALS "380.4 [Repealed, 2015, c. 13, s. 11]"

§ `s 381 using the mails to defraud`
#ASSERT `s 381 the conduct is the offence of using the mails to defraud` TRUE TRUE FALSE EQUALS JUST TRUE      -- the mails, to deceive or defraud the public
#ASSERT `s 381 the conduct is the offence of using the mails to defraud` TRUE FALSE TRUE EQUALS JUST TRUE      -- the mails, to obtain money under false pretences
#ASSERT `s 381 the conduct is the offence of using the mails to defraud` TRUE FALSE FALSE EQUALS JUST FALSE    -- the mails, for neither purpose
#ASSERT `s 381 the conduct is the offence of using the mails to defraud` FALSE TRUE TRUE EQUALS JUST FALSE     -- not the mails
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 381 the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `two years`
#ASSERT `ccc13 test the number of limbs` (`s 381 the punishments` `ccc13 test p787`) EQUALS 2
#ASSERT `ccc13 test the summary limb is the s 787(1) stand-in` (`s 381 the punishments` `ccc13 test p787`) EQUALS TRUE
#ASSERT `s 381 the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
