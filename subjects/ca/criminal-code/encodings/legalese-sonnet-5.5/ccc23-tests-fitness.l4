IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc23-fitness`

-- ccc23-tests-fitness.l4 -- tests for sections 672.22 to 672.33. Expected values are written from the text, never copied from the code.
-- Argument order is the order of the GIVEN lines in ccc23-fitness.l4.

§ `s 672.22 -- presumption of fitness`
-- args: unfit by s 2; court satisfied on the balance of probabilities
#ASSERT `s 672.22 the accused is presumed fit to stand trial` (JUST TRUE) FALSE EQUALS JUST TRUE
-- the court is satisfied that the accused is unfit: the presumption goes ("unless")
#ASSERT `s 672.22 the accused is presumed fit to stand trial` (JUST TRUE) TRUE EQUALS JUST FALSE
-- the court is not satisfied (even if unfitness is arguable): presumed fit
#ASSERT `s 672.22 the accused is presumed fit to stand trial` (JUST FALSE) TRUE EQUALS JUST TRUE
-- the s 2 answer is itself not covered
#ASSERT `s 672.22 the accused is presumed fit to stand trial` NOTHING TRUE EQUALS NOTHING

§ `ss 672.23 and 672.24`
-- 672.23(1) args: reasonable grounds; before a verdict; own motion or application
#ASSERT `s 672.23(1) the court may direct that the issue of fitness be tried` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.23(1) the court may direct that the issue of fitness be tried` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.23(1) the court may direct that the issue of fitness be tried` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.23(1) the court may direct that the issue of fitness be tried` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.23(2) the applicant has the burden of proof that the accused is unfit to stand trial` TRUE EQUALS JUST TRUE
-- the court acts of its own motion: the text names no one who bears the burden
#ASSERT `s 672.23(2) the applicant has the burden of proof that the accused is unfit to stand trial` FALSE EQUALS NOTHING
-- 672.24(1) args: reasonable grounds; represented by counsel
#ASSERT `s 672.24(1) the court must order that the accused be represented by counsel` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.24(1) the court must order that the accused be represented by counsel` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.24(1) the court must order that the accused be represented by counsel` FALSE FALSE EQUALS JUST FALSE
-- 672.24(2) args: counsel assigned under (1); legal aid granted
#ASSERT `s 672.24(2) the Attorney General must pay the fees and disbursements of counsel` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.24(2) the Attorney General must pay the fees and disbursements of counsel` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.24(2) the Attorney General must pay the fees and disbursements of counsel` FALSE FALSE EQUALS JUST FALSE
-- the amount: fees 5000, accused can pay 1200 -> 3800; accused can pay all -> 0; accused can pay nothing -> all
#ASSERT `s 672.24(2) the amount the Attorney General must pay, in dollars` 5000 1200 (JUST TRUE) EQUALS JUST 3800
#ASSERT `s 672.24(2) the amount the Attorney General must pay, in dollars` 5000 5000 (JUST TRUE) EQUALS JUST 0
#ASSERT `s 672.24(2) the amount the Attorney General must pay, in dollars` 5000 7000 (JUST TRUE) EQUALS JUST 0
#ASSERT `s 672.24(2) the amount the Attorney General must pay, in dollars` 5000 0 (JUST TRUE) EQUALS JUST 5000
#ASSERT `s 672.24(2) the amount the Attorney General must pay, in dollars` 5000 0 (JUST FALSE) EQUALS NOTHING
#ASSERT `s 672.24(2) the amount the Attorney General must pay, in dollars` 5000 0 NOTHING EQUALS NOTHING
#ASSERT `s 672.24(3) the Attorney General or counsel may apply to the registrar to tax the disputed fees and disbursements` TRUE EQUALS JUST TRUE
#ASSERT `s 672.24(3) the Attorney General or counsel may apply to the registrar to tax the disputed fees and disbursements` FALSE EQUALS JUST FALSE

§ `ss 672.25 to 672.27`
-- 672.25(1) args: hybrid offence; the prosecutor has elected
#ASSERT `s 672.25(1) the court must postpone directing the trial of the issue of fitness` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.25(1) the court must postpone directing the trial of the issue of fitness` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.25(1) the court must postpone directing the trial of the issue of fitness` FALSE FALSE EQUALS NOTHING
-- 672.25(2) args: (a) arises before the close of the prosecution case at a preliminary inquiry; (b) at trial
#ASSERT `s 672.25(2) the court may postpone directing the trial of the issue of fitness` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.25(2) the court may postpone directing the trial of the issue of fitness` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.25(2) the court may postpone directing the trial of the issue of fitness` FALSE FALSE EQUALS JUST FALSE
-- the time allowed. args: arose at a preliminary inquiry; until not later than the call to answer; arose at trial; until not later than the opening of the defence; later time on the accused's motion
#ASSERT `s 672.25(2) the postponement is within the time the paragraph allows` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.25(2) the postponement is within the time the paragraph allows` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.25(2) the postponement is within the time the paragraph allows` FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.25(2) the postponement is within the time the paragraph allows` FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.25(2) the postponement is within the time the paragraph allows` FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.25(2) the postponement is within the time the paragraph allows` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- 672.26 args: judge and jury; directs before given in charge; directs after given in charge; the accused consents
#ASSERT `s 672.26 how the jury is sworn` TRUE TRUE FALSE FALSE EQUALS `s 672.26 a jury of the number required for the indictment is sworn to try the issue of fitness`
#ASSERT `s 672.26 how the jury is sworn` TRUE TRUE FALSE TRUE EQUALS `s 672.26 a jury of the number required for the indictment is sworn to try the issue of fitness and, with the consent of the accused, the issues to be tried on the indictment`
#ASSERT `s 672.26 how the jury is sworn` TRUE FALSE TRUE FALSE EQUALS `s 672.26 the jury is sworn to try the issue of fitness in addition to the issues in respect of which it is already sworn`
#ASSERT `s 672.26 how the jury is sworn` FALSE TRUE FALSE FALSE EQUALS `s 672.26 not covered`
#ASSERT `s 672.26 how the jury is sworn` TRUE FALSE FALSE FALSE EQUALS `s 672.26 not covered`
-- 672.27 args: (a) tried before a court other than judge and jury; (b) arises before a court at a preliminary inquiry or any other stage
#ASSERT `s 672.27 the court must try the issue of fitness and render a verdict` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.27 the court must try the issue of fitness and render a verdict` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.27 the court must try the issue of fitness and render a verdict` FALSE FALSE EQUALS JUST FALSE

§ `ss 672.28 to 672.32`
#ASSERT `s 672.28 the proceeding continues as if the issue of fitness had never arisen` TRUE EQUALS JUST TRUE
#ASSERT `s 672.28 the proceeding continues as if the issue of fitness had never arisen` FALSE EQUALS JUST FALSE
-- 672.29 args: detained on delivery of a verdict of fit; reasonable grounds that the accused would become unfit if released
#ASSERT `s 672.29 the court may order the accused to be detained in a hospital until the completion of the trial` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.29 the court may order the accused to be detained in a hospital until the completion of the trial` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.29 the court may order the accused to be detained in a hospital until the completion of the trial` FALSE TRUE EQUALS JUST FALSE
-- 672.3 args: postponed under 672.25(2); discharged or acquitted before the issue is tried
#ASSERT `s 672.3 the section bars the trial of the issue of fitness` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.3 the section bars the trial of the issue of fitness` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.3 the section bars the trial of the issue of fitness` FALSE TRUE EQUALS NOTHING
#ASSERT `s 672.31 any plea that has been made is set aside and any jury is discharged` TRUE EQUALS JUST TRUE
#ASSERT `s 672.31 any plea that has been made is set aside and any jury is discharged` FALSE EQUALS JUST FALSE
#ASSERT `s 672.32(1) the verdict of unfit to stand trial does not prevent the accused from being tried subsequently` TRUE EQUALS JUST TRUE
#ASSERT `s 672.32(1) the verdict of unfit to stand trial does not prevent the accused from being tried subsequently` FALSE EQUALS NOTHING
#ASSERT `s 672.32(2) the party who asserts that the accused has become fit has discharged the burden of proof` TRUE EQUALS JUST TRUE
#ASSERT `s 672.32(2) the party who asserts that the accused has become fit has discharged the burden of proof` FALSE EQUALS NOTHING

§ `s 672.33 -- inquiry every two years`
-- (1) args: the day of the verdict or the last inquiry; the day the inquiry is held; the extended day. Verdict on 15 March 2026: the inquiry is due by 15 March 2028.
#ASSERT `s 672.33(1) the inquiry is held not later than two years after the verdict or the last inquiry` (Date 15 3 2026) (Date 15 3 2028) NOTHING EQUALS JUST TRUE
#ASSERT `s 672.33(1) the inquiry is held not later than two years after the verdict or the last inquiry` (Date 15 3 2026) (Date 16 3 2028) NOTHING EQUALS JUST FALSE
#ASSERT `s 672.33(1) the inquiry is held not later than two years after the verdict or the last inquiry` (Date 15 3 2026) (Date 1 6 2028) (JUST (Date 30 6 2028)) EQUALS JUST TRUE
#ASSERT `s 672.33(1) the inquiry is held not later than two years after the verdict or the last inquiry` (Date 15 3 2026) (Date 1 7 2028) (JUST (Date 30 6 2028)) EQUALS JUST FALSE
-- "every two years thereafter": the next period runs from the last inquiry
#ASSERT `s 672.33(1) the inquiry is held not later than two years after the verdict or the last inquiry` (Date 15 3 2028) (Date 15 3 2030) NOTHING EQUALS JUST TRUE
-- the regulative rule, from a verdict on 15 March 2026: 731 days to 15 March 2028 (2028 is a leap year). Held on day 700 -> FULFILLED; the clock passes day 731 (WAITUNTIL 732) -> BREACH
#TRACE `s 672.33(1) the court must hold an inquiry` (Date 15 3 2026) AT 0 WITH
    PARTY `the court` DOES `s 672.33(1) hold an inquiry to decide whether sufficient evidence can be adduced to put the accused on trial` AT 700
#TRACE `s 672.33(1) the court must hold an inquiry` (Date 15 3 2026) AT 0 WITH
    (WAITUNTIL 732)
-- (1.1) args: prosecutor or accused applies; satisfied
#ASSERT `s 672.33(1.1) the court may extend the period for holding an inquiry` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.33(1.1) the court may extend the period for holding an inquiry` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.33(1.1) the court may extend the period for holding an inquiry` FALSE TRUE EQUALS JUST FALSE
-- (2) args: the accused applies; satisfied that there is reason to doubt a prima facie case
#ASSERT `s 672.33(2) the court may order an inquiry to be held at any time` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.33(2) the court may order an inquiry to be held at any time` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.33(2) the court may order an inquiry to be held at any time` FALSE TRUE EQUALS NOTHING
#ASSERT `s 672.33(3) the prosecutor has the burden of proof that sufficient evidence can be adduced to put the accused on trial` TRUE EQUALS JUST TRUE
#ASSERT `s 672.33(3) the prosecutor has the burden of proof that sufficient evidence can be adduced to put the accused on trial` FALSE EQUALS NOTHING
#ASSERT `s 672.33(4) the court must admit it as evidence at the inquiry` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.33(4) the court must admit it as evidence at the inquiry` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.33(4) the court must admit it as evidence at the inquiry` FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.33(5) the court may follow the practices and procedures of a preliminary inquiry under Part XVIII` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.33(5) the court may follow the practices and procedures of a preliminary inquiry under Part XVIII` TRUE FALSE EQUALS JUST FALSE
-- (6) args: the inquiry is complete; satisfied that sufficient evidence cannot be adduced
#ASSERT `s 672.33(6) the court must acquit the accused` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.33(6) the court must acquit the accused` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.33(6) the court must acquit the accused` FALSE TRUE EQUALS JUST FALSE
