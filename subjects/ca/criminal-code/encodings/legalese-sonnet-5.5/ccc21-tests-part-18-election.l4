§ `Three-valued helpers of ccc21-nouns (not law: each case written from the table in the comment above the helpers)`

-- and: FALSE if either is FALSE; TRUE if both are TRUE; otherwise NOTHING.
#ASSERT `s 535 three-valued and` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 535 three-valued and` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 535 three-valued and` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 535 three-valued and` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 535 three-valued and` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 535 three-valued and` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 535 three-valued and` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 535 three-valued and` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 535 three-valued and` NOTHING NOTHING EQUALS NOTHING

-- or: TRUE if either is TRUE; FALSE if both are FALSE; otherwise NOTHING.
#ASSERT `s 535 three-valued or` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 535 three-valued or` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 535 three-valued or` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 535 three-valued or` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 535 three-valued or` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 535 three-valued or` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 535 three-valued or` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 535 three-valued or` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 535 three-valued or` NOTHING NOTHING EQUALS NOTHING

-- not: TRUE and FALSE swap; NOTHING stays NOTHING.
#ASSERT `s 535 three-valued not` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 535 three-valued not` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 535 three-valued not` NOTHING EQUALS NOTHING
