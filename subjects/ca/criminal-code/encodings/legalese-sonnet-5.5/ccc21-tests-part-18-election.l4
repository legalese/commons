#ASSERT `s 536.1(4.2)(b)(i) the judge shall proceed with the trial or fix a time for the trial` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 536.1(4.2)(b)(i) the judge shall proceed with the trial or fix a time for the trial` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 536.1(4.2)(b)(ii) the judge shall fix a time for the trial` FALSE `s 536.1(1) a judge` (`s 536(2) elects` `s 536(2) trial by a court composed of a judge and jury`) FALSE EQUALS JUST TRUE
#ASSERT `s 536.1(4.2)(b)(ii) the judge shall fix a time for the trial` FALSE `s 536.1(1) a judge` `s 536(2) does not elect` TRUE EQUALS JUST TRUE   -- deemed to have elected
#ASSERT `s 536.1(4.2)(b)(ii) the judge shall fix a time for the trial` FALSE `s 536.1(1) a judge` (`s 536(2) elects` `s 536(2) trial by a judge without a jury`) FALSE EQUALS JUST FALSE
#ASSERT `s 536.1(4.2)(b)(ii) the judge shall fix a time for the trial` TRUE `s 536.1(1) a judge` (`s 536(2) elects` `s 536(2) trial by a court composed of a judge and jury`) FALSE EQUALS JUST FALSE
#ASSERT `s 536.1(4.2)(b)(ii) the judge shall fix a time for the trial` FALSE `s 536.1(1) a justice of the peace` (`s 536(2) elects` `s 536(2) trial by a court composed of a judge and jury`) FALSE EQUALS JUST FALSE
