#ASSERT `s 536.1(4.2)(a) the justice of the peace shall remand the accused to appear and plead before a judge` FALSE `s 536.1(1) a judge` EQUALS JUST FALSE
#ASSERT `s 536.1(4.2)(b)(i) the judge shall call on the accused to plead to the charge` FALSE `s 536.1(1) a judge` (`s 536(2) elects` `s 536(2) trial by a judge without a jury`) EQUALS JUST TRUE
#ASSERT `s 536.1(4.2)(b)(i) the judge shall call on the accused to plead to the charge` TRUE `s 536.1(1) a judge` (`s 536(2) elects` `s 536(2) trial by a judge without a jury`) EQUALS JUST FALSE
#ASSERT `s 536.1(4.2)(b)(i) the judge shall call on the accused to plead to the charge` FALSE `s 536.1(1) a justice of the peace` (`s 536(2) elects` `s 536(2) trial by a judge without a jury`) EQUALS JUST FALSE
#ASSERT `s 536.1(4.2)(b)(i) the judge shall call on the accused to plead to the charge` FALSE `s 536.1(1) a judge` (`s 536(2) elects` `s 536(2) trial by a court composed of a judge and jury`) EQUALS JUST FALSE
