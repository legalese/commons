IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc14-part13-attempts`

-- ccc14-tests-part13-attempts.l4 -- tests for ccc14-part13-attempts.l4 (Criminal Code, ss 463 to 467).
-- Every expected value is written from the text of the section named beside it, before the run; none is copied from the module's output.
-- Y = JUST TRUE; N = JUST FALSE; NA = NOTHING (not covered).

`ccc14 Y` MEANS JUST TRUE
`ccc14 N` MEANS JUST FALSE

-- independent constructions (not the module's helpers)
GIVEN y IS A NUMBER, m IS A NUMBER, d IS A NUMBER, lad IS A BOOLEAN
GIVETH AN Imprisonment
`ccc14 test term` MEANS `imprisonment for a term of` (`Length of time` OF y, m, d, lad)

GIVEN imp IS AN Imprisonment
GIVETH A Punishment
`ccc14 test indictable limb with` MEANS Punishment OF `by indictment`, imp, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

GIVEN y IS A NUMBER, m IS A NUMBER, d IS A NUMBER
GIVETH A Punishment
`ccc14 test ind` MEANS `ccc14 test indictable limb with` (`ccc14 test term` y m d FALSE)

`ccc14 test sum` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

`ccc14 test life` MEANS `ccc14 test indictable limb with` `imprisonment for life`

`ccc14 test hybrid` MEANS `an offence that the section makes both indictable and punishable on summary conviction`

§ `s 463 -- Attempts, accessories`

-- guilty: args (attempts or is an accessory after the fact; the law expressly provides otherwise)
#ASSERT `s 463 the person is guilty of an offence by attempting, or by being an accessory after the fact` TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 463 the person is guilty of an offence by attempting, or by being an accessory after the fact` FALSE FALSE EQUALS NOTHING
#ASSERT `s 463 the person is guilty of an offence by attempting, or by being an accessory after the fact` TRUE TRUE EQUALS NOTHING

-- punishment: args (class of the offence attempted; its indictable (or only) limb; the law expressly provides otherwise)
-- (a) indictable offence liable to imprisonment for life: an indictable offence, not exceeding fourteen years
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` `ccc14 test life` FALSE EQUALS JUST (LIST `ccc14 test ind` 14 0 0)
-- (b) fourteen years or less: one-half of the longest term
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test ind` 14 0 0) FALSE EQUALS JUST (LIST `ccc14 test ind` 7 0 0)
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test ind` 10 0 0) FALSE EQUALS JUST (LIST `ccc14 test ind` 5 0 0)
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test ind` 5 0 0) FALSE EQUALS JUST (LIST `ccc14 test ind` 2 6 0)
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test ind` 2 0 0) FALSE EQUALS JUST (LIST `ccc14 test ind` 1 0 0)
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test ind` 0 6 0) FALSE EQUALS JUST (LIST `ccc14 test ind` 0 3 0)
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test ind` 0 0 90) FALSE EQUALS JUST (LIST `ccc14 test ind` 0 0 45)
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test ind` 13 10 0) FALSE EQUALS JUST (LIST `ccc14 test ind` 6 11 0)
-- the text does not say how to halve an odd month, an odd day, or a term stated "less a day"
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test ind` 13 11 0) FALSE EQUALS NOTHING
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test ind` 0 0 91) FALSE EQUALS NOTHING
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test indictable limb with` (`ccc14 test term` 2 0 0 TRUE)) FALSE EQUALS NOTHING
-- above fourteen years, but not life: within neither (a) nor (b)
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test ind` 14 0 1) FALSE EQUALS NOTHING
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test ind` 18 0 0) FALSE EQUALS NOTHING
-- the offence section states no longest term
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test indictable limb with` `no imprisonment is stated`) FALSE EQUALS NOTHING
-- (c) an offence punishable on summary conviction: an offence punishable on summary conviction
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an offence punishable on summary conviction` `ccc14 test sum` FALSE EQUALS JUST (LIST `ccc14 test sum`)
-- (d) both: an indictable offence with one-half of the longest term, or an offence punishable on summary conviction
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `ccc14 test hybrid` (`ccc14 test ind` 10 0 0) FALSE EQUALS JUST (LIST `ccc14 test ind` 5 0 0, `ccc14 test sum`)
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `ccc14 test hybrid` (`ccc14 test ind` 5 0 0) FALSE EQUALS JUST (LIST `ccc14 test ind` 2 6 0, `ccc14 test sum`)
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `ccc14 test hybrid` `ccc14 test life` FALSE EQUALS NOTHING
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `ccc14 test hybrid` (`ccc14 test ind` 5 1 0) FALSE EQUALS NOTHING
-- "Except where otherwise expressly provided by law"
#ASSERT `s 463 the punishment for attempting to commit, or being an accessory after the fact to, an offence` `an indictable offence` (`ccc14 test ind` 10 0 0) TRUE EQUALS NOTHING

#ASSERT `s 463 the class of the offence of attempting, or of being an accessory after the fact` `an indictable offence` EQUALS `an indictable offence`
#ASSERT `s 463 the class of the offence of attempting, or of being an accessory after the fact` `an offence punishable on summary conviction` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 463 the class of the offence of attempting, or of being an accessory after the fact` `ccc14 test hybrid` EQUALS `ccc14 test hybrid`

-- helper rules on both sides of their thresholds
#ASSERT `s 463 the term is fourteen years or less` (`Length of time` OF 14, 0, 0, FALSE)
#ASSERT NOT (`s 463 the term is fourteen years or less` (`Length of time` OF 14, 0, 1, FALSE))
#ASSERT `s 463 the term is fourteen years or less` (`Length of time` OF 14, 0, 0, TRUE)
#ASSERT `s 463 the term is fourteen years or less` (`Length of time` OF 13, 11, 29, FALSE)
#ASSERT NOT (`s 463 the term is less than fourteen years` (`Length of time` OF 14, 0, 0, FALSE))
#ASSERT `s 463 the term is less than fourteen years` (`Length of time` OF 14, 0, 0, TRUE)
#ASSERT `s 463 the term is less than fourteen years` (`Length of time` OF 13, 11, 0, FALSE)
#ASSERT `s 463 one-half of the longest term` (`Length of time` OF 14, 0, 0, FALSE) EQUALS JUST (`Length of time` OF 7, 0, 0, FALSE)

§ `s 464 -- Counselling offence that is not committed`

-- guilty: args (counsels another person to commit an offence; the offence counselled is committed; the law expressly provides otherwise)
#ASSERT `s 464 the person is guilty of an offence by counselling an offence that is not committed` TRUE FALSE FALSE EQUALS `ccc14 Y`
#ASSERT `s 464 the person is guilty of an offence by counselling an offence that is not committed` TRUE TRUE FALSE EQUALS `ccc14 N`
#ASSERT `s 464 the person is guilty of an offence by counselling an offence that is not committed` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 464 the person is guilty of an offence by counselling an offence that is not committed` TRUE FALSE TRUE EQUALS NOTHING

-- punishment (a): the same punishment as an attempt to commit the offence; (b): an offence punishable on summary conviction
#ASSERT `s 464 the punishment for counselling an offence that is not committed` `an indictable offence` (`ccc14 test ind` 10 0 0) FALSE EQUALS JUST (LIST `ccc14 test ind` 5 0 0)
#ASSERT `s 464 the punishment for counselling an offence that is not committed` `an indictable offence` `ccc14 test life` FALSE EQUALS JUST (LIST `ccc14 test ind` 14 0 0)
#ASSERT `s 464 the punishment for counselling an offence that is not committed` `an offence punishable on summary conviction` `ccc14 test sum` FALSE EQUALS JUST (LIST `ccc14 test sum`)
#ASSERT `s 464 the punishment for counselling an offence that is not committed` `ccc14 test hybrid` (`ccc14 test ind` 10 0 0) FALSE EQUALS NOTHING
#ASSERT `s 464 the punishment for counselling an offence that is not committed` `an indictable offence` (`ccc14 test ind` 10 0 0) TRUE EQUALS NOTHING
#ASSERT `s 464 the class of the offence of counselling an offence that is not committed` TRUE EQUALS `an indictable offence`
#ASSERT `s 464 the class of the offence of counselling an offence that is not committed` FALSE EQUALS `an offence punishable on summary conviction`

§ `s 465(1) -- Conspiracy`

-- (a) murder: args (conspires to commit murder; the law expressly provides otherwise)
#ASSERT `s 465(1)(a) the person is guilty of the offence of conspiring to commit murder` TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 465(1)(a) the person is guilty of the offence of conspiring to commit murder` FALSE FALSE EQUALS NOTHING
#ASSERT `s 465(1)(a) the person is guilty of the offence of conspiring to commit murder` TRUE TRUE EQUALS NOTHING
#ASSERT `s 465(1)(a) the punishment for conspiring to commit murder` FALSE EQUALS JUST (LIST `ccc14 test life`)
#ASSERT `s 465(1)(a) the punishment for conspiring to commit murder` TRUE EQUALS NOTHING

-- (b) prosecute a person for an offence they did not commit: (i) life or not more than 14 years: not more than 10 years or summary; (ii) less than 14 years: not more than five years or summary
#ASSERT `s 465(1)(b) the person is guilty of the offence of conspiring to prosecute a person for an offence they did not commit` TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 465(1)(b) the person is guilty of the offence of conspiring to prosecute a person for an offence they did not commit` FALSE FALSE EQUALS NOTHING
#ASSERT `s 465(1)(b) the person is guilty of the offence of conspiring to prosecute a person for an offence they did not commit` TRUE TRUE EQUALS NOTHING
#ASSERT `s 465(1)(b) the punishment for conspiring to prosecute a person for an offence they did not commit` `imprisonment for life` FALSE EQUALS JUST (LIST `ccc14 test ind` 10 0 0, `ccc14 test sum`)
#ASSERT `s 465(1)(b) the punishment for conspiring to prosecute a person for an offence they did not commit` (`ccc14 test term` 14 0 0 FALSE) FALSE EQUALS JUST (LIST `ccc14 test ind` 10 0 0, `ccc14 test sum`)
#ASSERT `s 465(1)(b) the punishment for conspiring to prosecute a person for an offence they did not commit` (`ccc14 test term` 13 11 0 FALSE) FALSE EQUALS JUST (LIST `ccc14 test ind` 5 0 0, `ccc14 test sum`)
#ASSERT `s 465(1)(b) the punishment for conspiring to prosecute a person for an offence they did not commit` (`ccc14 test term` 14 0 0 TRUE) FALSE EQUALS JUST (LIST `ccc14 test ind` 5 0 0, `ccc14 test sum`)
#ASSERT `s 465(1)(b) the punishment for conspiring to prosecute a person for an offence they did not commit` (`ccc14 test term` 10 0 0 FALSE) FALSE EQUALS JUST (LIST `ccc14 test ind` 5 0 0, `ccc14 test sum`)
#ASSERT `s 465(1)(b) the punishment for conspiring to prosecute a person for an offence they did not commit` (`ccc14 test term` 14 0 1 FALSE) FALSE EQUALS NOTHING
#ASSERT `s 465(1)(b) the punishment for conspiring to prosecute a person for an offence they did not commit` `no imprisonment is stated` FALSE EQUALS NOTHING
#ASSERT `s 465(1)(b) the punishment for conspiring to prosecute a person for an offence they did not commit` `imprisonment for life` TRUE EQUALS NOTHING

-- (c) an indictable offence not provided for in (a) or (b): the same punishment as the offence
#ASSERT `s 465(1)(c) the person is guilty of the offence of conspiring to commit an indictable offence` TRUE FALSE FALSE EQUALS `ccc14 Y`
#ASSERT `s 465(1)(c) the person is guilty of the offence of conspiring to commit an indictable offence` TRUE TRUE FALSE EQUALS `ccc14 N`
#ASSERT `s 465(1)(c) the person is guilty of the offence of conspiring to commit an indictable offence` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 465(1)(c) the person is guilty of the offence of conspiring to commit an indictable offence` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 465(1)(c) the punishment for conspiring to commit an indictable offence` `an indictable offence` (LIST `ccc14 test ind` 10 0 0) FALSE EQUALS JUST (LIST `ccc14 test ind` 10 0 0)
#ASSERT `s 465(1)(c) the punishment for conspiring to commit an indictable offence` `an offence punishable on summary conviction` (LIST `ccc14 test sum`) FALSE EQUALS NOTHING
#ASSERT `s 465(1)(c) the punishment for conspiring to commit an indictable offence` `ccc14 test hybrid` (LIST `ccc14 test ind` 5 0 0, `ccc14 test sum`) FALSE EQUALS NOTHING
#ASSERT `s 465(1)(c) the punishment for conspiring to commit an indictable offence` `an indictable offence` (LIST `ccc14 test ind` 10 0 0) TRUE EQUALS NOTHING

-- (d) an offence punishable on summary conviction
#ASSERT `s 465(1)(d) the person is guilty of the offence of conspiring to commit an offence punishable on summary conviction` TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 465(1)(d) the person is guilty of the offence of conspiring to commit an offence punishable on summary conviction` FALSE FALSE EQUALS NOTHING
#ASSERT `s 465(1)(d) the person is guilty of the offence of conspiring to commit an offence punishable on summary conviction` TRUE TRUE EQUALS NOTHING
#ASSERT `s 465(1)(d) the punishment for conspiring to commit an offence punishable on summary conviction` FALSE EQUALS JUST (LIST `ccc14 test sum`)
#ASSERT `s 465(1)(d) the punishment for conspiring to commit an offence punishable on summary conviction` TRUE EQUALS NOTHING

#ASSERT `s 465(1) the class of the offence of conspiracy` `s 465(1)(a) murder` EQUALS `an indictable offence`
#ASSERT `s 465(1) the class of the offence of conspiracy` `s 465(1)(b) conspiring to prosecute a person for an offence they did not commit` EQUALS `ccc14 test hybrid`
#ASSERT `s 465(1) the class of the offence of conspiracy` `s 465(1)(c) an indictable offence not provided for in (a) or (b)` EQUALS `an indictable offence`
#ASSERT `s 465(1) the class of the offence of conspiracy` `s 465(1)(d) an offence punishable on summary conviction` EQUALS `an offence punishable on summary conviction`

§ `s 465(3) to (7) -- Conspiracy to commit offences, idem, jurisdiction, appearance, if previously tried outside Canada`

#ASSERT `s 465(2) as the text shows it` EQUALS "(2) [Repealed, 1985, c. 27 (1st Supp.), s. 61]"
-- (3) args: while in Canada conspires with any one; to do anything referred to in (1); in a place outside Canada; that is an offence under the laws of that place
#ASSERT `s 465(3) the person is deemed to have conspired in Canada` TRUE TRUE TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 465(3) the person is deemed to have conspired in Canada` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 465(3) the person is deemed to have conspired in Canada` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 465(3) the person is deemed to have conspired in Canada` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 465(3) the person is deemed to have conspired in Canada` TRUE TRUE TRUE FALSE EQUALS NOTHING
-- (4) args: while in a place outside Canada conspires; to do anything referred to in (1); in Canada
#ASSERT `s 465(4) the person is deemed to have conspired in Canada` TRUE TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 465(4) the person is deemed to have conspired in Canada` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 465(4) the person is deemed to have conspired in Canada` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 465(4) the person is deemed to have conspired in Canada` TRUE TRUE FALSE EQUALS NOTHING
-- (5) "Where a person is alleged to have conspired to do anything that is an offence by virtue of subsection (3) or (4)"
#ASSERT `s 465(5) proceedings may be commenced in any territorial division in Canada` TRUE EQUALS `ccc14 Y`
#ASSERT `s 465(5) proceedings may be commenced in any territorial division in Canada` FALSE EQUALS `ccc14 N`
-- (6)
#ASSERT `s 465(6) the provisions on the accused's appearance at and presence during proceedings, and their exceptions, apply` TRUE EQUALS `ccc14 Y`
#ASSERT `s 465(6) the provisions on the accused's appearance at and presence during proceedings, and their exceptions, apply` FALSE EQUALS NOTHING
-- (7) args: alleged to have conspired (3) or (4); tried and dealt with outside Canada; in such a manner that autrefois acquit etc. would be available
#ASSERT `s 465(7) the person is deemed to have been tried and dealt with in Canada` TRUE TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 465(7) the person is deemed to have been tried and dealt with in Canada` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 465(7) the person is deemed to have been tried and dealt with in Canada` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 465(7) the person is deemed to have been tried and dealt with in Canada` TRUE TRUE FALSE EQUALS NOTHING

§ `ss 466 and 467 -- Conspiracy in restraint of trade; Saving`

-- 466(1) "an agreement between two or more persons": two is enough, one is not
#ASSERT `s 466(1) the agreement is a conspiracy in restraint of trade` 2 TRUE EQUALS `ccc14 Y`
#ASSERT `s 466(1) the agreement is a conspiracy in restraint of trade` 3 TRUE EQUALS `ccc14 Y`
#ASSERT `s 466(1) the agreement is a conspiracy in restraint of trade` 1 TRUE EQUALS `ccc14 N`
#ASSERT `s 466(1) the agreement is a conspiracy in restraint of trade` 2 FALSE EQUALS `ccc14 N`
-- 466(2) args: the purposes are those of a trade union; unlawful only because in restraint of trade
#ASSERT `s 466(2) the purposes of a trade union are unlawful within the meaning of subsection (1)` TRUE TRUE EQUALS `ccc14 N`
#ASSERT `s 466(2) the purposes of a trade union are unlawful within the meaning of subsection (1)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 466(2) the purposes of a trade union are unlawful within the meaning of subsection (1)` FALSE TRUE EQUALS NOTHING
-- 467(1) args: by reason only of that conduct; refuses to work; does an act for a trade combination; that act is an offence expressly punishable by law
#ASSERT `s 467(1) the person is barred from being convicted of the offence of conspiracy` TRUE TRUE FALSE FALSE EQUALS `ccc14 Y`
#ASSERT `s 467(1) the person is barred from being convicted of the offence of conspiracy` TRUE FALSE TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 467(1) the person is barred from being convicted of the offence of conspiracy` TRUE FALSE TRUE TRUE EQUALS `ccc14 N`
#ASSERT `s 467(1) the person is barred from being convicted of the offence of conspiracy` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 467(1) the person is barred from being convicted of the offence of conspiracy` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 467(1) the person is barred from being convicted of the offence of conspiracy` TRUE TRUE TRUE TRUE EQUALS `ccc14 Y`
-- 467(2) args: a combination between masters or workmen or other persons; purpose of regulating the relations; purpose of regulating the conduct
#ASSERT `s 467(2) the combination is a trade combination` TRUE TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 467(2) the combination is a trade combination` TRUE FALSE TRUE EQUALS `ccc14 Y`
#ASSERT `s 467(2) the combination is a trade combination` TRUE FALSE FALSE EQUALS `ccc14 N`
#ASSERT `s 467(2) the combination is a trade combination` FALSE TRUE TRUE EQUALS `ccc14 N`
