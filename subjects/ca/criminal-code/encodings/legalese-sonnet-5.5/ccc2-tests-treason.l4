IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc2-treason`

-- ccc2-tests-treason.l4 -- tests for ccc2-treason.l4 (ss 46 to 48). Every expected value is written beside its assertion from the text of the
-- provision, before the run: a failing assertion is a finding, never an edit of the expected value.

§ `Tests -- section 46(1), high treason (lines 854-857)`

-- (a) kills or attempts to kill Her Majesty ... in Canada: committed.
#ASSERT `s 46(1) high treason is committed` `s 46(1)(a) kills or attempts to kill Her Majesty` TRUE EQUALS JUST TRUE
#ASSERT `s 46(1) high treason is committed` `s 46(1)(a) does Her Majesty any bodily harm tending to death or destruction` TRUE EQUALS JUST TRUE
#ASSERT `s 46(1) high treason is committed` `s 46(1)(a) maims or wounds Her Majesty` TRUE EQUALS JUST TRUE
#ASSERT `s 46(1) high treason is committed` `s 46(1)(a) imprisons or restrains Her Majesty` TRUE EQUALS JUST TRUE
-- (b) levies war against Canada or does any act preparatory thereto.
#ASSERT `s 46(1) high treason is committed` `s 46(1)(b) levies war against Canada` TRUE EQUALS JUST TRUE
#ASSERT `s 46(1) high treason is committed` `s 46(1)(b) does an act preparatory to levying war against Canada` TRUE EQUALS JUST TRUE
-- (c) assists an enemy at war with Canada, or any armed forces against whom Canadian Forces are engaged in hostilities.
#ASSERT `s 46(1) high treason is committed` `s 46(1)(c) assists an enemy at war with Canada` TRUE EQUALS JUST TRUE
#ASSERT `s 46(1) high treason is committed` `s 46(1)(c) assists armed forces against whom Canadian Forces are engaged in hostilities` TRUE EQUALS JUST TRUE
-- "in Canada": outside Canada subsection (1) alone does not reach the act (not the text's no: NOTHING).
#ASSERT `s 46(1) high treason is committed` `s 46(1)(b) levies war against Canada` FALSE EQUALS NOTHING
#ASSERT `s 46(1) high treason is committed` `s 46(1)(a) kills or attempts to kill Her Majesty` FALSE EQUALS NOTHING
-- an act none of (a) to (c): not covered, in or out of Canada.
#ASSERT `s 46(1) high treason is committed` `s 46(1) an act that is none of those in paragraphs (a) to (c)` TRUE EQUALS NOTHING
#ASSERT `s 46(1) high treason is committed` `s 46(1) an act that is none of those in paragraphs (a) to (c)` FALSE EQUALS NOTHING

§ `Tests -- section 46(3)(a), a Canadian citizen (lines 865-867)`

-- (a) commits high treason if, while in or out of Canada, he does anything mentioned in subsection (1).
#ASSERT `s 46(3)(a) the citizen or person owing allegiance commits high treason in or out of Canada` `s 46(1)(b) levies war against Canada` TRUE EQUALS JUST TRUE
#ASSERT `s 46(3)(a) the citizen or person owing allegiance commits high treason in or out of Canada` `s 46(1)(c) assists an enemy at war with Canada` TRUE EQUALS JUST TRUE
-- not a citizen and owing no allegiance: this subsection does not reach the person (NOTHING).
#ASSERT `s 46(3)(a) the citizen or person owing allegiance commits high treason in or out of Canada` `s 46(1)(b) levies war against Canada` FALSE EQUALS NOTHING
-- an act that is none of those in subsection (1): not covered even for a citizen.
#ASSERT `s 46(3)(a) the citizen or person owing allegiance commits high treason in or out of Canada` `s 46(1) an act that is none of those in paragraphs (a) to (c)` TRUE EQUALS NOTHING

#ASSERT `s 46(1) or (3)(a) high treason is committed` `s 46(1)(b) levies war against Canada` TRUE FALSE EQUALS JUST TRUE   -- in Canada, not a citizen: subsection (1)
#ASSERT `s 46(1) or (3)(a) high treason is committed` `s 46(1)(b) levies war against Canada` FALSE TRUE EQUALS JUST TRUE   -- out of Canada, a citizen: subsection (3)(a)
#ASSERT `s 46(1) or (3)(a) high treason is committed` `s 46(1)(b) levies war against Canada` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 46(1) or (3)(a) high treason is committed` `s 46(1)(b) levies war against Canada` FALSE FALSE EQUALS NOTHING   -- out of Canada, not a citizen: not covered

§ `Tests -- section 46(2), treason (lines 858-864)`

-- (a) uses force or violence for the purpose of overthrowing the government: in Canada, committed; the other elements are not read by (a).
#ASSERT `s 46(2) treason is committed` `s 46(2)(a) uses force or violence for the purpose of overthrowing the government of Canada or a province` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 46(2) treason is committed` `s 46(2)(a) uses force or violence for the purpose of overthrowing the government of Canada or a province` FALSE FALSE FALSE FALSE EQUALS NOTHING   -- not in Canada
-- (b) without lawful authority, communicates ... that he knows or ought to know may be used ...: both elements needed.
#ASSERT `s 46(2) treason is committed` `s 46(2)(b) communicates or makes available military or scientific information to an agent of a state other than Canada` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 46(2) treason is committed` `s 46(2)(b) communicates or makes available military or scientific information to an agent of a state other than Canada` TRUE FALSE TRUE FALSE EQUALS NOTHING   -- with lawful authority
#ASSERT `s 46(2) treason is committed` `s 46(2)(b) communicates or makes available military or scientific information to an agent of a state other than Canada` TRUE TRUE FALSE FALSE EQUALS NOTHING   -- no knowledge, and none that he ought to have
-- (c) conspires with any person to commit high treason or to do anything mentioned in paragraph (a).
#ASSERT `s 46(2) treason is committed` `s 46(2)(c) conspires with any person to commit high treason or to do anything mentioned in paragraph (a)` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (d) forms an intention ... and manifests that intention by an overt act.
#ASSERT `s 46(2) treason is committed` `s 46(2)(d) forms an intention to do high treason or anything mentioned in paragraph (a) and manifests that intention by an overt act` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 46(2) treason is committed` `s 46(2)(d) forms an intention to do high treason or anything mentioned in paragraph (a) and manifests that intention by an overt act` TRUE FALSE FALSE FALSE EQUALS NOTHING   -- no overt act
-- (e) conspires ... to do anything mentioned in paragraph (b), or forms an intention ... and manifests that intention by an overt act.
#ASSERT `s 46(2) treason is committed` `s 46(2)(e) conspires with any person to do anything mentioned in paragraph (b)` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 46(2) treason is committed` `s 46(2)(e) conspires with any person to do anything mentioned in paragraph (b)` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 46(2) treason is committed` `s 46(2)(e) forms an intention to do anything mentioned in paragraph (b) and manifests that intention by an overt act` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 46(2) treason is committed` `s 46(2)(e) forms an intention to do anything mentioned in paragraph (b) and manifests that intention by an overt act` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- no overt act
-- an act none of (a) to (e): not covered.
#ASSERT `s 46(2) treason is committed` `s 46(2) an act that is none of those in paragraphs (a) to (e)` TRUE TRUE TRUE TRUE EQUALS NOTHING

-- subsection (3)(b): a Canadian citizen commits treason if, while in or out of Canada, he does anything mentioned in subsection (2).
#ASSERT `s 46(3)(b) the citizen or person owing allegiance commits treason in or out of Canada` `s 46(2)(a) uses force or violence for the purpose of overthrowing the government of Canada or a province` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 46(3)(b) the citizen or person owing allegiance commits treason in or out of Canada` `s 46(2)(a) uses force or violence for the purpose of overthrowing the government of Canada or a province` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 46(3)(b) the citizen or person owing allegiance commits treason in or out of Canada` `s 46(2)(b) communicates or makes available military or scientific information to an agent of a state other than Canada` TRUE FALSE TRUE FALSE EQUALS NOTHING   -- citizen, but lawful authority
#ASSERT `s 46(3)(b) the citizen or person owing allegiance commits treason in or out of Canada` `s 46(2) an act that is none of those in paragraphs (a) to (e)` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 46(2) or (3)(b) treason is committed` `s 46(2)(a) uses force or violence for the purpose of overthrowing the government of Canada or a province` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- out of Canada, a citizen
#ASSERT `s 46(2) or (3)(b) treason is committed` `s 46(2)(a) uses force or violence for the purpose of overthrowing the government of Canada or a province` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- in Canada, not a citizen
#ASSERT `s 46(2) or (3)(b) treason is committed` `s 46(2)(a) uses force or violence for the purpose of overthrowing the government of Canada or a province` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- out of Canada, not a citizen

-- the helper: the elements of one paragraph.
#ASSERT `s 46(2) the act and its elements are those of one of paragraphs (a) to (e)` `s 46(2)(a) uses force or violence for the purpose of overthrowing the government of Canada or a province` FALSE FALSE FALSE
#ASSERT NOT (`s 46(2) the act and its elements are those of one of paragraphs (a) to (e)` `s 46(2) an act that is none of those in paragraphs (a) to (e)` TRUE TRUE TRUE)

§ `Tests -- section 46(4), overt act (lines 869-870)`

#ASSERT `s 46(4) the act of conspiring is an overt act of treason` TRUE EQUALS JUST TRUE
#ASSERT `s 46(4) the act of conspiring is an overt act of treason` FALSE EQUALS JUST FALSE   -- "Where it is treason to conspire": the condition fails

§ `Tests -- section 47, punishment, corroboration, minimum punishment (lines 871-881)`

#ASSERT `s 47(1) the class of the offence of high treason` EQUALS `an indictable offence`
-- 47(1): "shall be sentenced to imprisonment for life"; 47(4) makes it a minimum for Part XXIII.
#ASSERT `s 47(1) the punishment for high treason` EQUALS LIST Punishment OF `by indictment`, `imprisonment for life`, `imprisonment for life`, `no fine is stated`, `no fine is stated`
#ASSERT `s 47(2) the class of the offence of treason` EQUALS `an indictable offence`
-- 47(2)(a): life for 46(2)(a), (c) or (d).
#ASSERT `s 47(2) the punishment for treason` `s 46(2)(a) uses force or violence for the purpose of overthrowing the government of Canada or a province` FALSE EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 47(2) the punishment for treason` `s 46(2)(c) conspires with any person to commit high treason or to do anything mentioned in paragraph (a)` FALSE EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 47(2) the punishment for treason` `s 46(2)(d) forms an intention to do high treason or anything mentioned in paragraph (a) and manifests that intention by an overt act` TRUE EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
-- 47(2)(b): life for 46(2)(b) or (e) committed while a state of war exists.
#ASSERT `s 47(2) the punishment for treason` `s 46(2)(b) communicates or makes available military or scientific information to an agent of a state other than Canada` TRUE EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 47(2) the punishment for treason` `s 46(2)(e) conspires with any person to do anything mentioned in paragraph (b)` TRUE EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
-- 47(2)(c): a term not exceeding fourteen years when no state of war exists.
#ASSERT `s 47(2) the punishment for treason` `s 46(2)(b) communicates or makes available military or scientific information to an agent of a state other than Canada` FALSE EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for a term of` `fourteen years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 47(2) the punishment for treason` `s 46(2)(e) forms an intention to do anything mentioned in paragraph (b) and manifests that intention by an overt act` FALSE EQUALS JUST (LIST Punishment OF `by indictment`, `imprisonment for a term of` `fourteen years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
-- an act none of (a) to (e): the section states no punishment for it.
#ASSERT `s 47(2) the punishment for treason` `s 46(2) an act that is none of those in paragraphs (a) to (e)` TRUE EQUALS NOTHING

-- 47(3): no conviction on the evidence of only one witness, unless corroborated in a material particular by evidence that implicates the accused.
#ASSERT `s 47(3) a conviction of high treason or treason on that evidence is barred` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 47(3) a conviction of high treason or treason on that evidence is barred` TRUE TRUE TRUE EQUALS JUST FALSE   -- corroborated: the "unless" is met
#ASSERT `s 47(3) a conviction of high treason or treason on that evidence is barred` TRUE FALSE FALSE EQUALS NOTHING   -- more than one witness: outside the rule's own scope
#ASSERT `s 47(3) a conviction of high treason or treason on that evidence is barred` FALSE TRUE FALSE EQUALS NOTHING   -- another offence
-- 47(4): "For the purposes of Part XXIII".
#ASSERT `s 47(4) the sentence of imprisonment for life prescribed by subsection 47(1) is a minimum punishment` TRUE EQUALS JUST TRUE
#ASSERT `s 47(4) the sentence of imprisonment for life prescribed by subsection 47(1) is a minimum punishment` FALSE EQUALS NOTHING

§ `Tests -- section 48(1), three years (lines 882-883)`

-- Alleged offence 1 January 2020: the third anniversary is 1 January 2023; "more than three years after" means after that day.
#ASSERT `s 48(1) the proceedings are barred by the three-year limit` TRUE (Date 1 1 2020) (Date 2 1 2023) EQUALS JUST TRUE    -- one day past the third anniversary
#ASSERT `s 48(1) the proceedings are barred by the three-year limit` TRUE (Date 1 1 2020) (Date 1 1 2023) EQUALS JUST FALSE   -- exactly three years: not "more than three years"
#ASSERT `s 48(1) the proceedings are barred by the three-year limit` TRUE (Date 1 1 2020) (Date 31 12 2022) EQUALS JUST FALSE  -- one day inside
#ASSERT `s 48(1) the proceedings are barred by the three-year limit` TRUE (Date 1 1 2020) (Date 1 1 2020) EQUALS JUST FALSE   -- same day

-- Alleged offence 29 February 2020 (fork F3): 2023 has no 29 February; the reading taken is that the third anniversary is 1 March 2023 (the Date constructor rolls the impossible date forward).
#ASSERT `s 48(1) the proceedings are barred by the three-year limit` TRUE (Date 29 2 2020) (Date 28 2 2023) EQUALS JUST FALSE   -- before the rolled anniversary
#ASSERT `s 48(1) the proceedings are barred by the three-year limit` TRUE (Date 29 2 2020) (Date 1 3 2023) EQUALS JUST FALSE   -- on the rolled anniversary: not "more than three years"
#ASSERT `s 48(1) the proceedings are barred by the three-year limit` TRUE (Date 29 2 2020) (Date 2 3 2023) EQUALS JUST TRUE    -- the day after it
#ASSERT `s 48(1) the proceedings are barred by the three-year limit` FALSE (Date 1 1 2020) (Date 1 1 2030) EQUALS NOTHING    -- not treason under 46(2)(a): the limit is not the text's own say-so

§ `Tests -- section 48(2), information for treasonable words (lines 884-887)`

-- words spoken 10 March 2024: information by 16 March (six days); warrant by ten days after the information.
#ASSERT `s 48(2) the proceedings are barred unless the information and warrant came in time` TRUE TRUE (Date 10 3 2024) (Date 16 3 2024) TRUE (Date 26 3 2024) EQUALS JUST FALSE   -- day six and day ten of the information: both periods met
#ASSERT `s 48(2) the proceedings are barred unless the information and warrant came in time` TRUE TRUE (Date 10 3 2024) (Date 17 3 2024) TRUE (Date 20 3 2024) EQUALS JUST TRUE    -- information on day seven: too late
#ASSERT `s 48(2) the proceedings are barred unless the information and warrant came in time` TRUE TRUE (Date 10 3 2024) (Date 12 3 2024) TRUE (Date 23 3 2024) EQUALS JUST TRUE    -- warrant on day eleven after the information: too late
#ASSERT `s 48(2) the proceedings are barred unless the information and warrant came in time` TRUE TRUE (Date 10 3 2024) (Date 12 3 2024) TRUE (Date 22 3 2024) EQUALS JUST FALSE   -- warrant on day ten: in time
#ASSERT `s 48(2) the proceedings are barred unless the information and warrant came in time` TRUE FALSE (Date 10 3 2024) (Date 12 3 2024) TRUE (Date 15 3 2024) EQUALS JUST TRUE   -- no information laid under oath
#ASSERT `s 48(2) the proceedings are barred unless the information and warrant came in time` TRUE TRUE (Date 10 3 2024) (Date 12 3 2024) FALSE (Date 15 3 2024) EQUALS JUST TRUE   -- no warrant issued
#ASSERT `s 48(2) the proceedings are barred unless the information and warrant came in time` FALSE TRUE (Date 10 3 2024) (Date 12 3 2024) TRUE (Date 15 3 2024) EQUALS NOTHING   -- not treasonable words
