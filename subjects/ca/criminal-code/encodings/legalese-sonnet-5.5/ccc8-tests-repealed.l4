IMPORT prelude
IMPORT `ccc8-repealed`

-- ccc8-tests-repealed.l4 -- one assertion per repealed unit: the constant is what the text shows in its place. The expected strings are taken from the coverage table, which a script reads out of the text, so these assertions check the module against that table and not against a second reading of the text; the srcrefs gate checks the quote lines against the text.

#ASSERT `s 197(1) common bawdy-house as the text shows it` EQUALS "[Repealed, 2019, c. 25, s. 69.1]"
#ASSERT `s 197(1) prostitute as the text shows it` EQUALS "[Repealed, 2014, c. 25, s. 12]"
#ASSERT `s 198 as the text shows it` EQUALS "[Repealed, 2018, c. 29, s. 16]"
#ASSERT `s 200 as the text shows it` EQUALS "[Repealed, R.S., 1985, c. 27 (1st Supp.), s. 30]"
#ASSERT `s 205 as the text shows it` EQUALS "[Repealed, R.S., 1985, c. 52 (1st Supp.), s. 1]"
#ASSERT `s 206(8)(b) as the text shows it` EQUALS "[Repealed, 1999, c. 28, s. 156]"
#ASSERT `s 208 as the text shows it` EQUALS "[Repealed, R.S., 1985, c. 27 (1st Supp.), s. 32]"
