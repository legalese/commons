#ASSERT `s 450 the person commits the offence of possessing, etc., counterfeit money` `ccc14 Y` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 450 the person commits the offence of possessing, etc., counterfeit money` `ccc14 Y` FALSE TRUE FALSE FALSE EQUALS NOTHING
