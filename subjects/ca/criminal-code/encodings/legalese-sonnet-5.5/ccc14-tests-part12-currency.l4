#ASSERT `s 453 the person commits the offence of uttering coin` TRUE TRUE TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 453 the person commits the offence of uttering coin` TRUE TRUE FALSE `ccc14 Y` TRUE EQUALS `ccc14 Y`
#ASSERT `s 453 the person commits the offence of uttering coin` FALSE TRUE TRUE `ccc14 N` FALSE EQUALS NOTHING
#ASSERT `s 453 the person commits the offence of uttering coin` TRUE FALSE TRUE `ccc14 N` FALSE EQUALS NOTHING
#ASSERT `s 453 the person commits the offence of uttering coin` TRUE TRUE FALSE `ccc14 Y` FALSE EQUALS NOTHING
