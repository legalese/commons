§ `s 457 -- Likeness of bank-notes`

-- (1) args: makes etc.; the likeness is of a current bank-note (s 448); the likeness is of an obligation or a security of a government or bank
#ASSERT `s 457(1) the conduct is prohibited` TRUE `ccc14 Y` FALSE EQUALS `ccc14 Y`
#ASSERT `s 457(1) the conduct is prohibited` TRUE `ccc14 N` TRUE EQUALS `ccc14 Y`
#ASSERT `s 457(1) the conduct is prohibited` TRUE NOTHING TRUE EQUALS `ccc14 Y`
#ASSERT `s 457(1) the conduct is prohibited` TRUE `ccc14 N` FALSE EQUALS NOTHING
#ASSERT `s 457(1) the conduct is prohibited` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 457(1) the conduct is prohibited` FALSE `ccc14 Y` FALSE EQUALS NOTHING

-- (2) Subsection (1) does not apply to (a) the Bank of Canada ..., (b) the RCMP ..., (c) a person under contract or licence.
#ASSERT `s 457(2) subsection (1) does not apply` TRUE FALSE FALSE EQUALS `ccc14 Y`
#ASSERT `s 457(2) subsection (1) does not apply` FALSE TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 457(2) subsection (1) does not apply` FALSE FALSE TRUE EQUALS `ccc14 Y`
#ASSERT `s 457(2) subsection (1) does not apply` FALSE FALSE FALSE EQUALS NOTHING

-- (3) A person who contravenes subsection (1) is guilty of an offence punishable on summary conviction; (2) takes the person out.
#ASSERT `s 457(3) the person commits the offence of contravening subsection (1)` `ccc14 Y` NOTHING EQUALS `ccc14 Y`
#ASSERT `s 457(3) the person commits the offence of contravening subsection (1)` `ccc14 Y` `ccc14 N` EQUALS `ccc14 Y`
#ASSERT `s 457(3) the person commits the offence of contravening subsection (1)` `ccc14 Y` `ccc14 Y` EQUALS `ccc14 N`
#ASSERT `s 457(3) the person commits the offence of contravening subsection (1)` NOTHING `ccc14 Y` EQUALS `ccc14 N`
#ASSERT `s 457(3) the person commits the offence of contravening subsection (1)` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 457(3) the person commits the offence of contravening subsection (1)` `ccc14 N` NOTHING EQUALS NOTHING
#ASSERT `s 457(3) the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 457(3) the punishment` EQUALS LIST `ccc14 test summary limb with nothing stated`

-- (4) args: the offence is under (3) for the printed likeness of a Canadian bank-note; length multiple; width multiple; black-and-white only; one side only
-- "less than three-fourths or greater than one-and-one-half times": exactly 0.75 and exactly 1.5 are not "less than" and not "greater than".
#ASSERT `s 457(4) the defence of a likeness of a different size applies` TRUE 0.5 1 TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 457(4) the defence of a likeness of a different size applies` TRUE 0.74 1 TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 457(4) the defence of a likeness of a different size applies` TRUE 0.75 1 TRUE FALSE EQUALS `ccc14 N`
#ASSERT `s 457(4) the defence of a likeness of a different size applies` TRUE 1.5 1 TRUE FALSE EQUALS `ccc14 N`
#ASSERT `s 457(4) the defence of a likeness of a different size applies` TRUE 1.51 1 FALSE TRUE EQUALS `ccc14 Y`
#ASSERT `s 457(4) the defence of a likeness of a different size applies` TRUE 1 0.5 FALSE TRUE EQUALS `ccc14 Y`
#ASSERT `s 457(4) the defence of a likeness of a different size applies` TRUE 1 0.75 FALSE TRUE EQUALS `ccc14 N`
#ASSERT `s 457(4) the defence of a likeness of a different size applies` TRUE 1 2 TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 457(4) the defence of a likeness of a different size applies` TRUE 0.5 1 FALSE FALSE EQUALS `ccc14 N`
#ASSERT `s 457(4) the defence of a likeness of a different size applies` TRUE 1 1 TRUE TRUE EQUALS `ccc14 N`
#ASSERT `s 457(4) the defence of a likeness of a different size applies` FALSE 0.5 1 TRUE FALSE EQUALS NOTHING

