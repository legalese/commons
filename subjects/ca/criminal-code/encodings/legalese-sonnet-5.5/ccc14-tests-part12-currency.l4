#ASSERT `s 451 the person commits the offence of having clippings, etc.` TRUE TRUE TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 451 the person commits the offence of having clippings, etc.` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 451 the person commits the offence of having clippings, etc.` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 451 the person commits the offence of having clippings, etc.` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 451 the person commits the offence of having clippings, etc.` TRUE TRUE TRUE FALSE EQUALS NOTHING
