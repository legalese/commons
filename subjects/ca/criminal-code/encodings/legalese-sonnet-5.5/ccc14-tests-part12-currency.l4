IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc14-part12-currency`

-- ccc14-tests-part12-currency.l4 -- tests for ccc14-part12-currency.l4 (Criminal Code, Part XII, ss 448 to 462).
-- Every expected value below is written from the text of the section named beside it, before the run; none is copied from the module's output.
-- Y = the text says yes (JUST TRUE); N = the text says no (JUST FALSE); NA = not covered (NOTHING).

`ccc14 Y` MEANS JUST TRUE
`ccc14 N` MEANS JUST FALSE

-- An independent construction of an indictable limb "liable to imprisonment for a term of not more than n years" (not the module's helper).
GIVEN n IS A NUMBER
GIVETH A Punishment
`ccc14 test indictable limb of years` MEANS
    Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF n, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

-- A summary-conviction limb that states no term and no fine.
`ccc14 test summary limb with nothing stated` MEANS
    Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

§ `s 448 -- Definitions`

-- counterfeit money includes (a) to (f): each limb alone is a yes; none of them is not covered ("includes").
#ASSERT `s 448 counterfeit money` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS `ccc14 Y`
#ASSERT `s 448 counterfeit money` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS `ccc14 Y`
#ASSERT `s 448 counterfeit money` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS `ccc14 Y`
#ASSERT `s 448 counterfeit money` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS `ccc14 Y`
#ASSERT `s 448 counterfeit money` FALSE FALSE FALSE FALSE TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 448 counterfeit money` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS `ccc14 Y`
#ASSERT `s 448 counterfeit money` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 448 counterfeit money` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS `ccc14 Y`

-- counterfeit token of value means a counterfeit excise stamp ... and includes genuine coin or paper money that has no value as money.
#ASSERT `s 448 counterfeit token of value` TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 448 counterfeit token of value` FALSE TRUE EQUALS `ccc14 Y`
#ASSERT `s 448 counterfeit token of value` FALSE FALSE EQUALS `ccc14 N`

-- current means lawfully current in Canada or elsewhere ...
#ASSERT `s 448 current` TRUE EQUALS `ccc14 Y`
#ASSERT `s 448 current` FALSE EQUALS `ccc14 N`

-- utter includes sell, pay, tender and put off.
#ASSERT `s 448 utter` `s 448 sell` EQUALS `ccc14 Y`
#ASSERT `s 448 utter` `s 448 pay` EQUALS `ccc14 Y`
#ASSERT `s 448 utter` `s 448 tender` EQUALS `ccc14 Y`
#ASSERT `s 448 utter` `s 448 put off` EQUALS `ccc14 Y`
#ASSERT `s 448 utter` `s 448 an act that is none of those named` EQUALS NOTHING

§ `s 449 -- Making`

#ASSERT `s 449 the person commits the offence of making counterfeit money` `ccc14 Y` TRUE EQUALS `ccc14 Y`
#ASSERT `s 449 the person commits the offence of making counterfeit money` `ccc14 Y` FALSE EQUALS NOTHING
#ASSERT `s 449 the person commits the offence of making counterfeit money` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 449 the person commits the offence of making counterfeit money` `ccc14 N` TRUE EQUALS NOTHING
#ASSERT `s 449 the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 449 the punishment` EQUALS LIST `ccc14 test indictable limb of years` 14

