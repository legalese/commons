IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc21-nouns`
IMPORT `ccc21-part-19-absolute`

-- ccc21-tests-part-19-absolute.l4 -- tests for section 552 (judge) and section 553 (absolute jurisdiction). Expected values written by hand from the text.

-- A test fixture: a charge from its facts, in the order of the record's fields:
-- charged in an information, section, subsection, paragraph (a) offence, theft of cattle, testamentary instrument, alleged value, how charged, CDSA 4(4)(a).
GIVEN info IS A BOOLEAN
      sec IS A NUMBER
      sub IS A STRING
      kind IS A `s 553(a) the offence charged, as paragraph (a) names it`
      cattle IS A BOOLEAN
      will IS A BOOLEAN
      value IS A NUMBER
      how IS A `s 553(b) how the accused is charged`
      cdsa IS A BOOLEAN
GIVETH A `s 553 the charge`
`s 553 test charge` MEANS
    `s 553 the charge` WITH
        `s 553 the accused is charged in an information` IS info
        `s 553 the offence charged` IS `Provision of the Code` WITH `section` IS sec, `subsection` IS sub
        `s 553 the offence charged, as paragraph (a) names it` IS kind
        `s 553 the theft is theft of cattle` IS cattle
        `s 553 the subject-matter of the offence is a testamentary instrument` IS will
        `s 553 the alleged value of the subject-matter of the offence, in dollars` IS value
        `s 553 how the accused is charged` IS how
        `s 553 the offence is under paragraph 4(4)(a) of the Controlled Drugs and Substances Act` IS cdsa

§ `Tests -- section 552, "judge" (one per province or territory, and the closed list)`

#ASSERT `s 552 judge` Ontario `s 552 a judge of the superior court of criminal jurisdiction of the Province` EQUALS JUST TRUE   -- (a)
#ASSERT `s 552 judge` Ontario `s 552 a judge of the Court of Quebec` EQUALS JUST FALSE   -- "judge means": a Court of Quebec judge is not a judge in Ontario
#ASSERT `s 552 judge` Quebec `s 552 a judge of the Court of Quebec` EQUALS JUST TRUE   -- (b)
#ASSERT `s 552 judge` `Nova Scotia` `s 552 a judge of the superior court of criminal jurisdiction of the Province` EQUALS JUST TRUE   -- (c)
#ASSERT `s 552 judge` `New Brunswick` `s 552 a judge of the Court of Queen’s Bench` EQUALS JUST TRUE   -- (d)
#ASSERT `s 552 judge` `British Columbia` `s 552 the Chief Justice or a puisne judge of the Supreme Court` EQUALS JUST TRUE   -- (e)
#ASSERT `s 552 judge` `British Columbia` `s 552 a judge of the Supreme Court` EQUALS JUST FALSE   -- (e) names the Chief Justice or a puisne judge, in those words
#ASSERT `s 552 judge` `Prince Edward Island` `s 552 a judge of the Supreme Court` EQUALS JUST TRUE   -- (f)
#ASSERT `s 552 judge` Manitoba `s 552 the Chief Justice or a puisne judge of the Court of Queen’s Bench` EQUALS JUST TRUE   -- (g)
#ASSERT `s 552 judge` Saskatchewan `s 552 a judge of the superior court of criminal jurisdiction of the Province` EQUALS JUST TRUE   -- (h)
#ASSERT `s 552 judge` Alberta `s 552 a judge of the superior court of criminal jurisdiction of the Province` EQUALS JUST TRUE   -- (h)
#ASSERT `s 552 judge` `Newfoundland and Labrador` `s 552 a judge of the Supreme Court` EQUALS JUST TRUE   -- (h.1)
#ASSERT `s 552 judge` Yukon `s 552 a judge of the Supreme Court` EQUALS JUST TRUE   -- (i)
#ASSERT `s 552 judge` `Northwest Territories` `s 552 a judge of the Supreme Court` EQUALS JUST TRUE   -- (i)
#ASSERT `s 552 judge` Nunavut `s 552 a judge of the Nunavut Court of Justice` EQUALS JUST TRUE   -- (j)
#ASSERT `s 552 judge` Nunavut `s 552 a judge of the Supreme Court` EQUALS JUST FALSE   -- Nunavut is (j), not (i)
#ASSERT `s 552 judge` Alberta `s 552 a judicial officer who is none of those` EQUALS JUST FALSE
#ASSERT `s 552 magistrate repealed` EQUALS "magistrate [Repealed, R.S., 1985, c. 27 (1st Supp.), s. 103]"

§ `Tests -- section 553(a): the five offences, the value limit and the testamentary-instrument limit`

-- theft of $4,999 / $5,000 / $5,000.01
#ASSERT `s 553(a) the offence charged is one paragraph (a) names, of a kind and value it covers` (`s 553 test charge` TRUE 334 "" `s 553(a)(i) theft` FALSE FALSE 4999 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE
#ASSERT `s 553(a) the offence charged is one paragraph (a) names, of a kind and value it covers` (`s 553 test charge` TRUE 334 "" `s 553(a)(i) theft` FALSE FALSE 5000 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE   -- "does not exceed five thousand dollars": $5,000 is within
#ASSERT `s 553(a) the offence charged is one paragraph (a) names, of a kind and value it covers` (`s 553 test charge` TRUE 334 "" `s 553(a)(i) theft` FALSE FALSE 5000.01 `s 553(b) with the offence itself` FALSE) EQUALS JUST FALSE   -- one cent over
#ASSERT `s 553(a) the offence charged is one paragraph (a) names, of a kind and value it covers` (`s 553 test charge` TRUE 334 "" `s 553(a)(i) theft` TRUE FALSE 100 `s 553(b) with the offence itself` FALSE) EQUALS JUST FALSE   -- theft of cattle
#ASSERT `s 553(a) the offence charged is one paragraph (a) names, of a kind and value it covers` (`s 553 test charge` TRUE 334 "" `s 553(a)(i) theft` FALSE TRUE 100 `s 553(b) with the offence itself` FALSE) EQUALS JUST FALSE   -- subject-matter is a testamentary instrument
#ASSERT `s 553(a) the offence charged is one paragraph (a) names, of a kind and value it covers` (`s 553 test charge` TRUE 362 "" `s 553(a)(ii) obtaining money or property by false pretences` FALSE FALSE 100 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE
#ASSERT `s 553(a) the offence charged is one paragraph (a) names, of a kind and value it covers` (`s 553 test charge` TRUE 354 "" `s 553(a)(iii) unlawfully having in possession property or a thing, or the proceeds of it, obtained by or derived from an offence punishable by indictment` FALSE FALSE 100 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE
#ASSERT `s 553(a) the offence charged is one paragraph (a) names, of a kind and value it covers` (`s 553 test charge` TRUE 380 "" `s 553(a)(iv) defrauding the public or any person of any property, money or valuable security by deceit, falsehood or other fraudulent means` FALSE FALSE 100 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE
#ASSERT `s 553(a) the offence charged is one paragraph (a) names, of a kind and value it covers` (`s 553 test charge` TRUE 430 "(4)" `s 553(a)(v) mischief under subsection 430(4)` FALSE FALSE 100 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE
#ASSERT `s 553(a) the offence charged is one paragraph (a) names, of a kind and value it covers` (`s 553 test charge` TRUE 267 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 100 `s 553(b) with the offence itself` FALSE) EQUALS NOTHING   -- not one of the five

§ `Tests -- section 553(c): the sections it lists`

#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 201 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE   -- (i)
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 202 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE   -- (ii)
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 203 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE   -- (iii)
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 206 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE   -- (iv)
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 209 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE   -- (v)
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 393 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE   -- (viii)
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 490.031 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE   -- (viii.01)
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 490.0311 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE   -- (viii.02)
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 490.03 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS NOTHING   -- neighbouring section number 490.03 is not listed
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 811 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE   -- (viii.1)
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 733.1 "(1)" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE   -- (ix): subsection 733.1(1)
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 733.1 "(2)" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS NOTHING   -- another subsection of 733.1 is not listed
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 4 "(4)" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` TRUE) EQUALS JUST TRUE   -- (x): paragraph 4(4)(a) of the Controlled Drugs and Substances Act
#ASSERT `s 553(c) the accused is charged with an offence under a section paragraph (c) lists` (`s 553 test charge` TRUE 267 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS NOTHING
#ASSERT `s 553(c)(vi) repealed` EQUALS "(vi) [Repealed, 2019, c. 25, s. 251.1]"
#ASSERT `s 553(c)(vii) repealed` EQUALS "(vii) [Repealed, 2000, c. 25, s. 4]"
#ASSERT `s 553(c)(xi) repealed` EQUALS "(xi) [Repealed, 2018, c. 16, s. 219]"

§ `Tests -- section 553(b): counselling, conspiracy, attempt, accessory after the fact`

-- order: charge, the answer of (a), the answer of (c)
#ASSERT `s 553(b) the accused is charged with counselling, conspiracy, attempt or being an accessory after the fact to an offence in paragraph (a) or (c)` (`s 553 test charge` TRUE 334 "" `s 553(a)(i) theft` FALSE FALSE 100 `s 553(b) with counselling the offence` FALSE) (JUST TRUE) NOTHING EQUALS JUST TRUE   -- counselling theft of $100: (b)(i)
#ASSERT `s 553(b) the accused is charged with counselling, conspiracy, attempt or being an accessory after the fact to an offence in paragraph (a) or (c)` (`s 553 test charge` TRUE 334 "" `s 553(a)(i) theft` FALSE FALSE 6000 `s 553(b) with an attempt to commit the offence` FALSE) (JUST FALSE) NOTHING EQUALS JUST FALSE   -- attempted theft of $6,000: value limit in (b)(i)
#ASSERT `s 553(b) the accused is charged with counselling, conspiracy, attempt or being an accessory after the fact to an offence in paragraph (a) or (c)` (`s 553 test charge` TRUE 201 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with a conspiracy to commit the offence` FALSE) NOTHING (JUST TRUE) EQUALS JUST TRUE   -- conspiracy to commit a section 201 offence: (b)(ii)
#ASSERT `s 553(b) the accused is charged with counselling, conspiracy, attempt or being an accessory after the fact to an offence in paragraph (a) or (c)` (`s 553 test charge` TRUE 334 "" `s 553(a)(i) theft` FALSE FALSE 100 `s 553(b) with the offence itself` FALSE) (JUST TRUE) NOTHING EQUALS NOTHING   -- charged with the offence itself: paragraph (b) does not speak to it
#ASSERT `s 553(b) the accused is charged with counselling, conspiracy, attempt or being an accessory after the fact to an offence in paragraph (a) or (c)` (`s 553 test charge` TRUE 267 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with being an accessory after the fact to the commission of the offence` FALSE) NOTHING NOTHING EQUALS NOTHING   -- accessory after the fact to an offence neither (a) nor (c) names
#ASSERT `s 553(b) the accused is charged with counselling, conspiracy, attempt or being an accessory after the fact to an offence in paragraph (a) or (c)` (`s 553 test charge` TRUE 267 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with being an accessory after the fact to the commission of the offence` FALSE) NOTHING (JUST FALSE) EQUALS NOTHING   -- (a) does not speak and (c) says no: not covered by (b)

§ `Tests -- section 553, taken whole`

#ASSERT `s 553 the offence is within the absolute jurisdiction of a provincial court judge` (`s 553 test charge` TRUE 334 "" `s 553(a)(i) theft` FALSE FALSE 4999 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE
#ASSERT `s 553 the offence is within the absolute jurisdiction of a provincial court judge` (`s 553 test charge` TRUE 334 "" `s 553(a)(i) theft` FALSE FALSE 5000.01 `s 553(b) with the offence itself` FALSE) EQUALS JUST FALSE   -- over $5,000: no limb
#ASSERT `s 553 the offence is within the absolute jurisdiction of a provincial court judge` (`s 553 test charge` TRUE 201 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS JUST TRUE   -- (c)(i)
#ASSERT `s 553 the offence is within the absolute jurisdiction of a provincial court judge` (`s 553 test charge` TRUE 334 "" `s 553(a)(i) theft` FALSE FALSE 100 `s 553(b) with counselling the offence` FALSE) EQUALS JUST TRUE   -- counselling theft of $100: (b)(i)
#ASSERT `s 553 the offence is within the absolute jurisdiction of a provincial court judge` (`s 553 test charge` TRUE 334 "" `s 553(a)(i) theft` FALSE FALSE 6000 `s 553(b) with counselling the offence` FALSE) EQUALS JUST FALSE   -- counselling theft of $6,000
#ASSERT `s 553 the offence is within the absolute jurisdiction of a provincial court judge` (`s 553 test charge` TRUE 201 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with an attempt to commit the offence` FALSE) EQUALS JUST TRUE   -- attempt to commit a section 201 offence: (b)(ii)
#ASSERT `s 553 the offence is within the absolute jurisdiction of a provincial court judge` (`s 553 test charge` TRUE 267 "" `s 553(a) an offence that paragraph (a) does not name` FALSE FALSE 0 `s 553(b) with the offence itself` FALSE) EQUALS JUST FALSE   -- an offence named in no paragraph: "where" fails
#ASSERT `s 553 the offence is within the absolute jurisdiction of a provincial court judge` (`s 553 test charge` FALSE 334 "" `s 553(a)(i) theft` FALSE FALSE 100 `s 553(b) with the offence itself` FALSE) EQUALS JUST FALSE   -- not charged in an information (charged by indictment)
