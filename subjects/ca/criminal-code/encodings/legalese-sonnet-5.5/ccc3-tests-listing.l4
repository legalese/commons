IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc3-listing`

-- ccc3-tests-listing.l4 -- tests of sections 83.05 to 83.07. Expected values are hand-written from the text beside each assertion.
-- Each #TRACE line ends with `-- EXPECT <outcome>`, decided from the text before the run; `work/trace_check.py` compares it (an #ASSERT cannot compare a DEONTIC value on the stable binary).

§ `Tests of sections 83.05 to 83.07`

-- ---- 83.05(1) GATE-A: recommendation AND (a) OR (b).
#ASSERT `s 83.05(1) the Governor in Council may place the entity on the list` TRUE TRUE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 83.05(1) the Governor in Council may place the entity on the list` TRUE FALSE TRUE EQUALS JUST TRUE   -- (b)
#ASSERT `s 83.05(1) the Governor in Council may place the entity on the list` FALSE TRUE TRUE EQUALS NOTHING   -- no recommendation of the Minister
#ASSERT `s 83.05(1) the Governor in Council may place the entity on the list` TRUE FALSE FALSE EQUALS NOTHING   -- no reasonable grounds
#ASSERT `s 83.05(1.1) the Minister may make the recommendation` TRUE EQUALS JUST TRUE
#ASSERT `s 83.05(1.1) the Minister may make the recommendation` FALSE EQUALS JUST FALSE   -- "only if"
#ASSERT `s 83.05(1.2)(a) the Minister may change or add a name` TRUE EQUALS JUST TRUE
#ASSERT `s 83.05(1.2)(a) the Minister may change or add a name` FALSE EQUALS NOTHING
#ASSERT `s 83.05(1.2)(b) the Minister may delete a name` TRUE EQUALS JUST TRUE
#ASSERT `s 83.05(1.2)(b) the Minister may delete a name` FALSE EQUALS NOTHING

-- ---- 83.05(2), (4).
#ASSERT `s 83.05(2) the Minister must decide the application` TRUE EQUALS JUST TRUE
#ASSERT `s 83.05(2) the Minister must decide the application` FALSE EQUALS JUST FALSE
#ASSERT `s 83.05(4) the Minister must give notice to the applicant without delay` TRUE EQUALS JUST TRUE
#ASSERT `s 83.05(4) the Minister must give notice to the applicant without delay` FALSE EQUALS JUST FALSE

-- ---- 83.05(3): received on 1 March 2026, so 90 days later is 30 May 2026 (31 + 30 + 29 more days: 1 Mar + 90 = 30 May). A longer agreed period moves the deadline.
#ASSERT `s 83.05(3) the Minister is deemed to have decided that the applicant should remain a listed entity` (Date 1 3 2026) NOTHING (JUST (Date 30 5 2026)) (Date 1 9 2026) EQUALS JUST FALSE   -- decided on the 90th day: in time
#ASSERT `s 83.05(3) the Minister is deemed to have decided that the applicant should remain a listed entity` (Date 1 3 2026) NOTHING (JUST (Date 31 5 2026)) (Date 1 9 2026) EQUALS JUST TRUE   -- decided on the 91st day: too late
#ASSERT `s 83.05(3) the Minister is deemed to have decided that the applicant should remain a listed entity` (Date 1 3 2026) NOTHING NOTHING (Date 31 5 2026) EQUALS JUST TRUE   -- no decision, asked on the 91st day
#ASSERT `s 83.05(3) the Minister is deemed to have decided that the applicant should remain a listed entity` (Date 1 3 2026) NOTHING NOTHING (Date 30 5 2026) EQUALS NOTHING   -- no decision, asked on the 90th day: still running
#ASSERT `s 83.05(3) the Minister is deemed to have decided that the applicant should remain a listed entity` (Date 1 3 2026) (JUST (Date 30 6 2026)) NOTHING (Date 1 6 2026) EQUALS NOTHING   -- a longer period was agreed: the deadline is 30 June, so 1 June is within it
#ASSERT `s 83.05(3) the Minister is deemed to have decided that the applicant should remain a listed entity` (Date 1 3 2026) (JUST (Date 30 6 2026)) NOTHING (Date 1 7 2026) EQUALS JUST TRUE
#ASSERT `s 83.05(3) the Minister is deemed to have decided that the applicant should remain a listed entity` (Date 1 3 2026) (JUST (Date 30 6 2026)) (JUST (Date 30 6 2026)) (Date 1 9 2026) EQUALS JUST FALSE   -- decided on the last agreed day
#ASSERT `s 83.05(3) the Minister is deemed to have decided that the applicant should remain a listed entity` (Date 1 3 2026) (JUST (Date 1 4 2026)) NOTHING (Date 31 5 2026) EQUALS JUST TRUE   -- an "agreed" period shorter than 90 days does not shorten it, but 31 May is past the 90th day anyway

-- ---- 83.05(5): notice received on 10 June 2026; the 60th day after is 9 August 2026 (20 days of June after the 10th + 31 July + 9 August = 60).
#ASSERT `s 83.05(5) the applicant may apply to a judge for judicial review` (Date 10 6 2026) (Date 10 6 2026) EQUALS JUST TRUE
#ASSERT `s 83.05(5) the applicant may apply to a judge for judicial review` (Date 10 6 2026) (Date 9 8 2026) EQUALS JUST TRUE   -- the 60th day
#ASSERT `s 83.05(5) the applicant may apply to a judge for judicial review` (Date 10 6 2026) (Date 10 8 2026) EQUALS JUST FALSE   -- the 61st day
#ASSERT `s 83.05(5) the applicant may apply to a judge for judicial review` (Date 10 6 2026) (Date 9 6 2026) EQUALS JUST FALSE   -- before the notice was received

-- ---- 83.05(6)(c), (d), (6.1), (7).
#ASSERT `s 83.05(6)(c) the judge must provide the applicant with a reasonable opportunity to be heard` TRUE EQUALS JUST TRUE
#ASSERT `s 83.05(6)(c) the judge must provide the applicant with a reasonable opportunity to be heard` FALSE EQUALS JUST FALSE
#ASSERT `s 83.05(6)(d) the judge must order that the applicant no longer be a listed entity` FALSE EQUALS JUST TRUE   -- the decision is found not to be reasonable
#ASSERT `s 83.05(6)(d) the judge must order that the applicant no longer be a listed entity` TRUE EQUALS JUST FALSE   -- found reasonable: no order
#ASSERT `s 83.05(6.1) the judge may receive the thing into evidence` TRUE EQUALS JUST TRUE
#ASSERT `s 83.05(6.1) the judge may receive the thing into evidence` FALSE EQUALS NOTHING
#ASSERT `s 83.05(7) the Minister must cause notice to be published in the Canada Gazette` TRUE EQUALS JUST TRUE
#ASSERT `s 83.05(7) the Minister must cause notice to be published in the Canada Gazette` FALSE EQUALS JUST FALSE

-- ---- 83.05(8): barred, except if a material change or a completed review.
#ASSERT `s 83.05(8) the listed entity is barred from making another application` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 83.05(8) the listed entity is barred from making another application` TRUE TRUE FALSE EQUALS JUST FALSE   -- (a)
#ASSERT `s 83.05(8) the listed entity is barred from making another application` TRUE FALSE TRUE EQUALS JUST FALSE   -- (b)
#ASSERT `s 83.05(8) the listed entity is barred from making another application` FALSE FALSE FALSE EQUALS NOTHING   -- no previous application: "another application" does not arise

-- ---- 83.05(8.1): the last day for the Minister's review. In force 1 July 2025.
#ASSERT `s 83.05(8.1) the last day for the Minister's review` (Date 1 7 2025) (Date 1 1 2020) NOTHING EQUALS Date 1 7 2030   -- (a)(i): a listed entity on the commencement day
#ASSERT `s 83.05(8.1) the last day for the Minister's review` (Date 1 7 2025) (Date 1 7 2025) NOTHING EQUALS Date 1 7 2030   -- added on that very day: listed on that day
#ASSERT `s 83.05(8.1) the last day for the Minister's review` (Date 1 7 2025) (Date 2 7 2025) NOTHING EQUALS Date 2 7 2030   -- (a)(ii): added the day after
#ASSERT `s 83.05(8.1) the last day for the Minister's review` (Date 1 7 2025) (Date 1 1 2020) (JUST (Date 15 3 2028)) EQUALS Date 15 3 2033   -- (b): five years after the most recent recommendation

-- ---- 83.05(9), (10), (11).
#ASSERT `s 83.05(9) reviews under subsection (8.1) do not affect the validity of the list` TRUE EQUALS JUST TRUE
#ASSERT `s 83.05(9) reviews under subsection (8.1) do not affect the validity of the list` FALSE EQUALS NOTHING
#ASSERT `s 83.05(10) the notice of the results of the review is published in time` (Date 15 3 2028) (Date 15 3 2033) EQUALS JUST TRUE   -- the last day
#ASSERT `s 83.05(10) the notice of the results of the review is published in time` (Date 15 3 2028) (Date 16 3 2033) EQUALS JUST FALSE   -- the day after
#ASSERT `s 83.05(10) the notice of the results of the review is published in time` (Date 29 2 2028) (Date 28 2 2033) EQUALS JUST TRUE   -- a review completed on a leap day: five years later is 28 February 2033 (daydate clamps the day)
#ASSERT `s 83.05(11) judge` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 83.05(11) judge` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.05(11) judge` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 83.05(11) judge` FALSE FALSE TRUE EQUALS JUST FALSE

-- ---- 83.06.
#ASSERT `s 83.06(1) the information must be returned and not considered` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 83.06(1) the information must be returned and not considered` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b)
#ASSERT `s 83.06(1) the information must be returned and not considered` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- (c)
#ASSERT `s 83.06(1) the information must be returned and not considered` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- none of (a), (b), (c)
#ASSERT `s 83.06(1) the information must be returned and not considered` FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING   -- not information obtained in confidence from abroad
#ASSERT `s 83.06(1) the information must be returned and not considered` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING   -- not provided to the judge by the Minister
#ASSERT `s 83.06(2) sections 38.2 to 38.45 of the Canada Evidence Act apply to the application` TRUE EQUALS JUST TRUE
#ASSERT `s 83.06(2) sections 38.2 to 38.45 of the Canada Evidence Act apply to the application` FALSE EQUALS NOTHING

-- ---- 83.07(1), (2). The certificate is due within 30 days of receipt: received 1 March 2026, last day 31 March 2026.
#ASSERT `s 83.07(1) the entity may apply in writing to the Minister for a certificate` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 83.07(1) the entity may apply in writing to the Minister for a certificate` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 83.07(1) the entity may apply in writing to the Minister for a certificate` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 83.07(1) the entity may apply in writing to the Minister for a certificate` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 83.07(2) the Minister must issue the certificate` TRUE EQUALS JUST TRUE
#ASSERT `s 83.07(2) the Minister must issue the certificate` FALSE EQUALS JUST FALSE   -- not satisfied: no duty
#ASSERT `s 83.07(2) the last day for issuing the certificate` (Date 1 3 2026) EQUALS Date 31 3 2026
#ASSERT `s 83.07(2) the last day for issuing the certificate` (Date 15 1 2028) EQUALS Date 14 2 2028   -- 15 January + 30 days: 16 more days of January, then 14 of February
#TRACE `s 83.07(2) the duty to issue the certificate` AT 0 WITH
    PARTY `s 83.07(2) the Minister of Public Safety and Emergency Preparedness` DOES `s 83.07(2) issues a certificate stating that the applicant is not that listed entity` AT 30   -- EXPECT FULFILLED
#TRACE `s 83.07(2) the duty to issue the certificate` AT 0 WITH
    PARTY `s 83.07(2) the Minister of Public Safety and Emergency Preparedness` DOES `s 83.07(2) issues a certificate stating that the applicant is not that listed entity` AT 31   -- EXPECT BREACH
#TRACE `s 83.07(2) the duty to issue the certificate` AT 0 WITH
    (WAITUNTIL 31)   -- EXPECT BREACH
