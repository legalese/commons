        IF `the trial is before a provincial court judge` THEN NOTHING   -- NOTHING-kind (limited by its own wording): "other than a trial before a provincial court judge"
        IF NOT `the indictment has been preferred` THEN JUST FALSE   -- GRANT-GATE: closed by the text -- FALSE-kind (the text says no in its own words): "the order may only be made in respect of a trial for an indictable offence, other than a trial before a provincial court judge, if the indictment has been preferred"
        OTHERWISE JUST TRUE

