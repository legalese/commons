IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc24-remote`

-- ccc24-tests-remote.l4 -- tests for ccc24-remote.l4 (Criminal Code ss 715.21 to 715.27).
-- Every expected value is written from the text of the section, row by row, before the run.  T = JUST TRUE, F = JUST FALSE, N = NOTHING.

§ `Sections 715.21 to 715.243`

-- 715.21: arguments are (the person appears, participates or presides, this Act otherwise provides).
#ASSERT `s 715.21 the person shall appear at, participate in or preside at the proceeding in person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 715.21 the person shall appear at, participate in or preside at the proceeding in person` TRUE TRUE EQUALS JUST FALSE   -- "Except as otherwise provided in this Act"
#ASSERT `s 715.21 the person shall appear at, participate in or preside at the proceeding in person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 715.221 the court shall include in the record a statement of the reasons for the denial` TRUE EQUALS JUST TRUE
#ASSERT `s 715.221 the court shall include in the record a statement of the reasons for the denial` FALSE EQUALS JUST FALSE
#ASSERT `s 715.222 the court may, at any time, cease the use of the technological means and take any measure that it considers appropriate in the circumstances to have the person appear at or participate in the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 715.222 the court may, at any time, cease the use of the technological means and take any measure that it considers appropriate in the circumstances to have the person appear at or participate in the proceedings` FALSE EQUALS NOTHING

`ccc24 fixture 71523a` MEANS `s 715.23(a) the location and personal circumstances of the accused or offender`
`ccc24 fixture 71523e` MEANS `s 715.23(e) the nature and seriousness of the offence`
`ccc24 fixture 71523x` MEANS `s 715.23 another circumstance`

#ASSERT `s 715.23 the court is to have regard to the circumstance in forming its opinion` `ccc24 fixture 71523a` EQUALS JUST TRUE
#ASSERT `s 715.23 the court is to have regard to the circumstance in forming its opinion` `ccc24 fixture 71523e` EQUALS JUST TRUE
#ASSERT `s 715.23 the court is to have regard to the circumstance in forming its opinion` `ccc24 fixture 71523x` EQUALS JUST TRUE
#ASSERT `s 715.23 the court must be of the opinion that the appearance by those means would be appropriate having regard to all the circumstances` TRUE EQUALS JUST TRUE
#ASSERT `s 715.23 the court must be of the opinion that the appearance by those means would be appropriate having regard to all the circumstances` FALSE EQUALS JUST FALSE   -- "Before making a determination"
#ASSERT `s 715.231 the court may allow an accused to appear by videoconference at the preliminary inquiry` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.231 the court may allow an accused to appear by videoconference at the preliminary inquiry` TRUE FALSE TRUE EQUALS NOTHING   -- the prosecutor does not consent
#ASSERT `s 715.231 the court may allow an accused to appear by videoconference at the preliminary inquiry` TRUE TRUE FALSE EQUALS NOTHING   -- the accused does not consent
#ASSERT `s 715.231 the court may allow an accused to appear by videoconference at the preliminary inquiry` FALSE TRUE TRUE EQUALS NOTHING
-- 715.232: arguments are (a summary conviction trial by videoconference, the accused is in custody, the accused consents, the prosecutor consents).
#ASSERT `s 715.232 the court may allow an accused to appear by videoconference at a trial for a summary conviction offence` TRUE FALSE TRUE TRUE EQUALS JUST TRUE   -- (a) not in custody: both consent
#ASSERT `s 715.232 the court may allow an accused to appear by videoconference at a trial for a summary conviction offence` TRUE FALSE TRUE FALSE EQUALS NOTHING   -- (a) the prosecutor does not consent
#ASSERT `s 715.232 the court may allow an accused to appear by videoconference at a trial for a summary conviction offence` TRUE TRUE TRUE FALSE EQUALS JUST TRUE   -- (b) in custody: the accused's consent is enough
#ASSERT `s 715.232 the court may allow an accused to appear by videoconference at a trial for a summary conviction offence` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- (b) the accused does not consent
#ASSERT `s 715.232 the court may allow an accused to appear by videoconference at a trial for a summary conviction offence` FALSE FALSE TRUE TRUE EQUALS NOTHING
-- 715.233: arguments are (an indictable trial by videoconference, the prosecutor consents, the accused consents, a jury trial with evidence being presented to the jury).
#ASSERT `s 715.233 the court may allow an accused to appear by videoconference at a trial for an indictable offence` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 715.233 the court may allow an accused to appear by videoconference at a trial for an indictable offence` TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- "an accused must not appear by videoconference during a jury trial when evidence is being presented"
#ASSERT `s 715.233 the court may allow an accused to appear by videoconference at a trial for an indictable offence` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 715.233 the court may allow an accused to appear by videoconference at a trial for an indictable offence` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 715.233 the court may allow an accused to appear by videoconference at a trial for an indictable offence` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 715.234(1) the court may allow an accused to appear by audioconference or videoconference for the purpose of making a plea` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.234(1) the court may allow an accused to appear by audioconference or videoconference for the purpose of making a plea` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 715.234(1) the court may allow an accused to appear by audioconference or videoconference for the purpose of making a plea` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 715.234(1) the court may allow an accused to appear by audioconference or videoconference for the purpose of making a plea` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 715.234(2) the limitation on appearing by audioconference for the purpose of making a plea is met` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.234(2) the limitation on appearing by audioconference for the purpose of making a plea is met` FALSE TRUE EQUALS JUST FALSE   -- "only if" videoconferencing is not readily available
#ASSERT `s 715.234(2) the limitation on appearing by audioconference for the purpose of making a plea is met` TRUE FALSE EQUALS JUST FALSE   -- "only if" the court can inquire under 606(1.1)
#ASSERT `s 715.235(1) the court may allow an offender to appear by audioconference or videoconference for sentencing purposes` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.235(1) the court may allow an offender to appear by audioconference or videoconference for sentencing purposes` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 715.235(1) the court may allow an offender to appear by audioconference or videoconference for sentencing purposes` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 715.235(1) the court may allow an offender to appear by audioconference or videoconference for sentencing purposes` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 715.235(2) the limitation on appearing by audioconference for sentencing purposes is met` TRUE EQUALS JUST TRUE
#ASSERT `s 715.235(2) the limitation on appearing by audioconference for sentencing purposes is met` FALSE EQUALS JUST FALSE
#ASSERT `s 715.24 the court may allow the accused or offender to appear by audioconference or videoconference` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 715.24 the court may allow the accused or offender to appear by audioconference or videoconference` TRUE FALSE EQUALS JUST FALSE   -- the Act expressly authorizes it elsewhere: that section governs
#ASSERT `s 715.24 the court may allow the accused or offender to appear by audioconference or videoconference` FALSE TRUE EQUALS JUST FALSE   -- the Act limits or prohibits it
#ASSERT `s 715.24 the court may allow the accused or offender to appear by audioconference or videoconference` TRUE TRUE EQUALS JUST FALSE
-- 715.241: arguments are (in custody, has access to legal advice, a proceeding referred to in 715.231 to 715.233, a part in which a witness's evidence is taken).
#ASSERT `s 715.241 the court may allow or require an accused to appear by videoconference` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 715.241 the court may allow or require an accused to appear by videoconference` TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- "other than a part in which the evidence of a witness is taken"
#ASSERT `s 715.241 the court may allow or require an accused to appear by videoconference` TRUE FALSE TRUE FALSE EQUALS NOTHING   -- no access to legal advice
#ASSERT `s 715.241 the court may allow or require an accused to appear by videoconference` FALSE TRUE TRUE FALSE EQUALS NOTHING   -- not in custody
#ASSERT `s 715.241 the court may allow or require an accused to appear by videoconference` TRUE TRUE FALSE FALSE EQUALS NOTHING   -- not a proceeding the sections refer to
#ASSERT `s 715.242 the court must be satisfied that the accused or offender will be able to understand the proceedings and that any decisions made by them during the proceedings will be voluntary` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.242 the court must be satisfied that the accused or offender will be able to understand the proceedings and that any decisions made by them during the proceedings will be voluntary` TRUE FALSE EQUALS NOTHING   -- the person has access to legal advice
#ASSERT `s 715.242 the court must be satisfied that the accused or offender will be able to understand the proceedings and that any decisions made by them during the proceedings will be voluntary` FALSE TRUE EQUALS NOTHING
#ASSERT `s 715.243 the accused or offender must be given the opportunity to communicate privately with counsel` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.243 the accused or offender must be given the opportunity to communicate privately with counsel` TRUE FALSE EQUALS JUST FALSE   -- "if they are represented by counsel"
#ASSERT `s 715.243 the accused or offender must be given the opportunity to communicate privately with counsel` FALSE TRUE EQUALS JUST FALSE

§ `Sections 715.25 to 715.27`

#ASSERT `s 715.25(1) participant` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 715.25(1) participant` TRUE TRUE EQUALS JUST FALSE   -- an accused, offender, witness, juror, judge or justice is excluded
#ASSERT `s 715.25(1) participant` FALSE FALSE EQUALS JUST FALSE   -- a "means" definition

`ccc24 fixture 71525a` MEANS `s 715.25(2)(a) the location and personal circumstances of the participant`
`ccc24 fixture 71525f` MEANS `s 715.25(2)(f) the nature and seriousness of the offence`
`ccc24 fixture 71525x` MEANS `s 715.25(2) another circumstance`

#ASSERT `s 715.25(2) the court is to have regard to the circumstance in forming its opinion` `ccc24 fixture 71525a` EQUALS JUST TRUE
#ASSERT `s 715.25(2) the court is to have regard to the circumstance in forming its opinion` `ccc24 fixture 71525f` EQUALS JUST TRUE
#ASSERT `s 715.25(2) the court is to have regard to the circumstance in forming its opinion` `ccc24 fixture 71525x` EQUALS JUST TRUE
-- 715.25(2) grant: arguments are (this Act otherwise provides, the person is a participant, the court's opinion).
#ASSERT `s 715.25(2) the court may allow the participant to participate in a proceeding by audioconference or videoconference` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.25(2) the court may allow the participant to participate in a proceeding by audioconference or videoconference` TRUE TRUE TRUE EQUALS JUST FALSE   -- "Except as otherwise provided in this Act"
#ASSERT `s 715.25(2) the court may allow the participant to participate in a proceeding by audioconference or videoconference` FALSE FALSE TRUE EQUALS NOTHING   -- not a participant
#ASSERT `s 715.25(2) the court may allow the participant to participate in a proceeding by audioconference or videoconference` FALSE TRUE FALSE EQUALS NOTHING   -- not of the opinion that it would be appropriate
#ASSERT `s 715.25(5) the party shall pay the costs associated with the use of the technology` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 715.25(5) the party shall pay the costs associated with the use of the technology` TRUE TRUE EQUALS JUST FALSE   -- "Unless the court orders otherwise"
#ASSERT `s 715.25(5) the party shall pay the costs associated with the use of the technology` FALSE FALSE EQUALS NOTHING

`ccc24 fixture 71526a` MEANS `s 715.26(1)(a) the accused's right to a fair and public hearing`
`ccc24 fixture 71526d` MEANS `s 715.26(1)(d) the suitability of the location from where the judge or justice will preside`
`ccc24 fixture 71526x` MEANS `s 715.26(1) another circumstance`

#ASSERT `s 715.26(1) the judge or justice is to have regard to the circumstance in deciding whether it is necessary` `ccc24 fixture 71526a` EQUALS JUST TRUE
#ASSERT `s 715.26(1) the judge or justice is to have regard to the circumstance in deciding whether it is necessary` `ccc24 fixture 71526d` EQUALS JUST TRUE
#ASSERT `s 715.26(1) the judge or justice is to have regard to the circumstance in deciding whether it is necessary` `ccc24 fixture 71526x` EQUALS JUST TRUE
#ASSERT `s 715.26(1) the judge or justice may preside at the proceeding by audioconference or videoconference` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 715.26(1) the judge or justice may preside at the proceeding by audioconference or videoconference` TRUE TRUE EQUALS JUST FALSE   -- "Except as otherwise provided in this Act"
#ASSERT `s 715.26(1) the judge or justice may preside at the proceeding by audioconference or videoconference` FALSE FALSE EQUALS NOTHING   -- the judge does not consider it necessary
#ASSERT `s 715.26(2) the judge or justice shall include in the record a statement of the reasons for the decision to preside at the proceeding by audioconference or videoconference` TRUE EQUALS JUST TRUE
#ASSERT `s 715.26(2) the judge or justice shall include in the record a statement of the reasons for the decision to preside at the proceeding by audioconference or videoconference` FALSE EQUALS JUST FALSE
#ASSERT `s 715.26(3) the judge or justice may, at any time, cease the use of the technological means and take any measure that the judge or justice considers appropriate in the circumstances to preside at the proceeding` TRUE EQUALS JUST TRUE
#ASSERT `s 715.26(3) the judge or justice may, at any time, cease the use of the technological means and take any measure that the judge or justice considers appropriate in the circumstances to preside at the proceeding` FALSE EQUALS NOTHING
#ASSERT `s 715.27(1) prospective juror` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 715.27(1) prospective juror` TRUE TRUE EQUALS JUST FALSE   -- already sworn
#ASSERT `s 715.27(1) prospective juror` FALSE FALSE EQUALS JUST FALSE

`ccc24 fixture 71527a` MEANS `s 715.27(2)(a) the challenges related to the in-person participation of prospective jurors`
`ccc24 fixture 71527d` MEANS `s 715.27(2)(d) the privacy and security of the prospective jurors`
`ccc24 fixture 71527x` MEANS `s 715.27(2) another circumstance`

#ASSERT `s 715.27(2) the court is to have regard to the circumstance in forming its opinion` `ccc24 fixture 71527a` EQUALS JUST TRUE
#ASSERT `s 715.27(2) the court is to have regard to the circumstance in forming its opinion` `ccc24 fixture 71527d` EQUALS JUST TRUE
#ASSERT `s 715.27(2) the court is to have regard to the circumstance in forming its opinion` `ccc24 fixture 71527x` EQUALS JUST TRUE
#ASSERT `s 715.27(2) the court may allow or require prospective jurors to participate in the jury selection process by videoconference` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.27(2) the court may allow or require prospective jurors to participate in the jury selection process by videoconference` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 715.27(2) the court may allow or require prospective jurors to participate in the jury selection process by videoconference` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 715.27(2) the court may allow or require prospective jurors to participate in the jury selection process by videoconference` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 715.27(3) the limitation on requiring prospective jurors to participate by videoconference is met` TRUE EQUALS JUST TRUE
#ASSERT `s 715.27(3) the limitation on requiring prospective jurors to participate by videoconference is met` FALSE EQUALS JUST FALSE   -- "only if the court has approved a location"
#ASSERT `s 715.27(4) the court shall give prospective jurors the option to participate in person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 715.27(4) the court shall give prospective jurors the option to participate in person` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 715.27(4) the court shall give prospective jurors the option to participate in person` FALSE TRUE EQUALS JUST FALSE
