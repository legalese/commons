IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc2-official-documents`

-- ccc2-tests-official-documents.l4 -- tests for ccc2-official-documents.l4 (ss 56.1 to 58). Expected values are written beside each assertion from the text
-- of the provision, before the run. The s 787(1) penalty is a seam input: the tests pass a placeholder that states nothing.

§ `Tests -- section 57(5), passport (lines 1006-1007)`

#ASSERT `s 57(5) the document is a passport` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 57(5) the document is a passport` (JUST FALSE) EQUALS JUST FALSE   -- the Order says no
#ASSERT `s 57(5) the document is a passport` NOTHING EQUALS NOTHING   -- the Canadian Passport Order is not among the sources

§ `Tests -- section 56.1(3), identity document (lines 981-982)`

--                                                                                   kind                                                   issued by a department or agency   passport answer
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a Social Insurance Number card` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a driver's licence` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a health insurance card` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a birth certificate` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a death certificate` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a document that simplifies the process of entry into Canada` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a certificate of citizenship` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a document indicating immigration status in Canada` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a certificate of Indian status` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) an employee identity card that bears the employee's photograph and signature` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a document similar to one of those` TRUE NOTHING EQUALS JUST TRUE   -- "or any similar document" (judgment taken as an input)
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a document of none of those kinds` TRUE NOTHING EQUALS JUST FALSE   -- "means"
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a driver's licence` FALSE NOTHING EQUALS JUST FALSE   -- not issued or purported to be issued by a department or agency
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a passport as defined in subsection 57(5)` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a passport as defined in subsection 57(5)` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 56.1(3) the document is an identity document` `s 56.1(3) a passport as defined in subsection 57(5)` TRUE NOTHING EQUALS NOTHING   -- the Passport Order is outside the sources

§ `Tests -- section 56.1(2) and (1), identity documents (lines 973-980)`

#ASSERT `s 56.1(2) subsection 56.1(1) prohibits the act` TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- (a) good faith, ordinary course of business
#ASSERT `s 56.1(2) subsection 56.1(1) prohibits the act` FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- (b) genealogical purposes
#ASSERT `s 56.1(2) subsection 56.1(1) prohibits the act` FALSE FALSE TRUE FALSE EQUALS JUST FALSE   -- (c) consent
#ASSERT `s 56.1(2) subsection 56.1(1) prohibits the act` FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- (d) the administration of justice
#ASSERT `s 56.1(2) subsection 56.1(1) prohibits the act` FALSE FALSE FALSE FALSE EQUALS NOTHING   -- none of (a) to (d): the subsection is silent
--                                                                          act                                                lawful excuse  id answer  relates  (a)   (b)   (c)   (d)
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) possesses an identity document` FALSE (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) procures to be made an identity document` FALSE (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) transfers an identity document` FALSE (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) sells an identity document` FALSE (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) offers for sale an identity document` FALSE (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) an act that is none of those` FALSE (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) possesses an identity document` TRUE (JUST TRUE) TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- with lawful excuse
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) possesses an identity document` FALSE (JUST FALSE) TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- not an identity document: "means"
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) possesses an identity document` FALSE NOTHING TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) possesses an identity document` FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- relates to the person themselves
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) possesses an identity document` FALSE (JUST TRUE) TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- (2)(a)
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) possesses an identity document` FALSE (JUST TRUE) TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- (2)(b)
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) possesses an identity document` FALSE (JUST TRUE) TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE   -- (2)(c)
#ASSERT `s 56.1(1) the person commits the identity document offence` `s 56.1(1) possesses an identity document` FALSE (JUST TRUE) TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- (2)(d)
#ASSERT `s 56.1(4) the class of the offence under subsection 56.1(1)` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 56.1(4) the punishment for an offence under subsection 56.1(1)` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` `five years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)

§ `Tests -- section 57, forged passport (lines 987-1014)`

--                                                                                         act                                                                                                                    passport answer  knows forged
#ASSERT `s 57(1) the person commits forgery of or uttering a forged passport` `s 57(1)(a) forges a passport` (JUST TRUE) FALSE EQUALS JUST TRUE   -- (a) needs no knowledge
#ASSERT `s 57(1) the person commits forgery of or uttering a forged passport` `s 57(1)(b)(i) knowing that a passport is forged, uses, deals with or acts on it as if it were genuine` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 57(1) the person commits forgery of or uttering a forged passport` `s 57(1)(b)(i) knowing that a passport is forged, uses, deals with or acts on it as if it were genuine` (JUST TRUE) FALSE EQUALS NOTHING   -- does not know it is forged
#ASSERT `s 57(1) the person commits forgery of or uttering a forged passport` `s 57(1)(b)(ii) knowing that a passport is forged, causes or attempts to cause a person to use, deal with or act on it as if it were genuine` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 57(1) the person commits forgery of or uttering a forged passport` `s 57(1)(b)(ii) knowing that a passport is forged, causes or attempts to cause a person to use, deal with or act on it as if it were genuine` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 57(1) the person commits forgery of or uttering a forged passport` `s 57(1)(a) forges a passport` (JUST FALSE) TRUE EQUALS JUST FALSE   -- not a passport under the Order
#ASSERT `s 57(1) the person commits forgery of or uttering a forged passport` `s 57(1)(a) forges a passport` NOTHING TRUE EQUALS NOTHING   -- the Order is outside the sources
#ASSERT `s 57(1) the person commits forgery of or uttering a forged passport` `s 57(1) an act that is none of those in paragraphs (a) and (b)` (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 57(1) the class of the offence under subsection 57(1)` EQUALS `an indictable offence`
#ASSERT `s 57(1) the punishment for an offence under subsection 57(1)` EQUALS LIST Punishment OF `by indictment`, `imprisonment for a term of` `fourteen years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
--                                                                                  purpose                                                                                                    statement knows false
#ASSERT `s 57(2) the person makes a false statement in relation to a passport` `s 57(2) the purpose of procuring a passport for himself or any other person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 57(2) the person makes a false statement in relation to a passport` `s 57(2) the purpose of procuring any material alteration or addition to any such passport` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 57(2) the person makes a false statement in relation to a passport` `s 57(2) the purpose of procuring a passport for himself or any other person` TRUE FALSE EQUALS NOTHING   -- does not know it is false
#ASSERT `s 57(2) the person makes a false statement in relation to a passport` `s 57(2) the purpose of procuring a passport for himself or any other person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 57(2) the person makes a false statement in relation to a passport` `s 57(2) another purpose` TRUE TRUE EQUALS NOTHING
#ASSERT `s 57(2) the class of the offence under subsection 57(2)` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 57(2) the punishment for an offence under subsection 57(2)` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` `two years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
--                                                           possession  lawful excuse  passport answer  forged  offence under (2)
#ASSERT `s 57(3) the person possesses a forged passport` TRUE FALSE (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 57(3) the person possesses a forged passport` TRUE FALSE (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- a passport in respect of which an offence under subsection (2) has been committed
#ASSERT `s 57(3) the person possesses a forged passport` TRUE FALSE (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 57(3) the person possesses a forged passport` FALSE FALSE (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- not in possession
#ASSERT `s 57(3) the person possesses a forged passport` TRUE TRUE (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- with lawful excuse
#ASSERT `s 57(3) the person possesses a forged passport` TRUE FALSE (JUST FALSE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 57(3) the person possesses a forged passport` TRUE FALSE NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 57(3) the class of the offence under subsection 57(3)` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 57(3) the punishment for an offence under subsection 57(3)` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` `five years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
-- (4)
#ASSERT `s 57(4)(a) the place where a passport was forged is material` TRUE EQUALS JUST FALSE   -- "is not material"
#ASSERT `s 57(4)(a) the place where a passport was forged is material` FALSE EQUALS NOTHING   -- proceedings under another section
#ASSERT `s 57(4)(b) the definition of false document in section 321 and section 366 apply` TRUE EQUALS JUST TRUE
#ASSERT `s 57(4)(b) the definition of false document in section 321 and section 366 apply` FALSE EQUALS NOTHING
-- (6) "Where a person is alleged to have committed, while out of Canada, an offence under this section"
#ASSERT `s 57(6) proceedings may be commenced, and the accused tried and punished, in a territorial division in Canada` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 57(6) proceedings may be commenced, and the accused tried and punished, in a territorial division in Canada` TRUE TRUE NOTHING EQUALS NOTHING   -- s 2 "territorial division" leaves the place open
#ASSERT `s 57(6) proceedings may be commenced, and the accused tried and punished, in a territorial division in Canada` TRUE TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 57(6) proceedings may be commenced, and the accused tried and punished, in a territorial division in Canada` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE   -- committed in Canada: the "Where" gate fails (fork F8)
#ASSERT `s 57(6) proceedings may be commenced, and the accused tried and punished, in a territorial division in Canada` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE   -- an offence under another section
-- (7)
#ASSERT `s 57(7) the provisions on the accused's appearance and presence, and the exceptions, apply` TRUE EQUALS JUST TRUE
#ASSERT `s 57(7) the provisions on the accused's appearance and presence, and the exceptions, apply` FALSE EQUALS NOTHING

§ `Tests -- section 58, certificate of citizenship (lines 1015-1020)`

#ASSERT `s 58(2) the document is a certificate of citizenship or of naturalization` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 58(2) the document is a certificate of citizenship or of naturalization` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 58(2) the document is a certificate of citizenship or of naturalization` NOTHING EQUALS NOTHING   -- the Citizenship Act is outside the sources
--                                                                                                         act                                                                                                                                                     certificate answer  granted to the person
#ASSERT `s 58(1) the person fraudulently uses, or parts with, a certificate of citizenship or of naturalization` `s 58(1)(a) uses a certificate of citizenship or a certificate of naturalization for a fraudulent purpose` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 58(1) the person fraudulently uses, or parts with, a certificate of citizenship or of naturalization` `s 58(1)(b) being a person to whom the certificate has been granted, knowingly parts with its possession with intent that it should be used for a fraudulent purpose` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 58(1) the person fraudulently uses, or parts with, a certificate of citizenship or of naturalization` `s 58(1)(b) being a person to whom the certificate has been granted, knowingly parts with its possession with intent that it should be used for a fraudulent purpose` (JUST TRUE) FALSE EQUALS NOTHING   -- not the person to whom it was granted
#ASSERT `s 58(1) the person fraudulently uses, or parts with, a certificate of citizenship or of naturalization` `s 58(1)(a) uses a certificate of citizenship or a certificate of naturalization for a fraudulent purpose` (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 58(1) the person fraudulently uses, or parts with, a certificate of citizenship or of naturalization` `s 58(1)(a) uses a certificate of citizenship or a certificate of naturalization for a fraudulent purpose` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 58(1) the person fraudulently uses, or parts with, a certificate of citizenship or of naturalization` `s 58(1) an act that is neither of those in paragraphs (a) and (b)` (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 58(1) the class of the offence under subsection 58(1)` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 58(1) the punishment for an offence under subsection 58(1)` (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`) EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` `two years`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
