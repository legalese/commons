IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc6-builders`
IMPORT `ccc6-voyeurism`
IMPORT `ccc6-tests-support`

-- Tests for ss 162 and 162.1. Expected values decided from the text before each run.

`s 162 test s 787(1) penalty` MEANS Punishment OF `by indictment`, `imprisonment for a term of` `six months`, `no imprisonment is stated`, `a fine in the discretion of the court`, `no fine is stated`
`s 162 test summary penalty` MEANS Punishment OF `on summary conviction`, `imprisonment for a term of` `six months`, `no imprisonment is stated`, `a fine in the discretion of the court`, `no fine is stated`

§ `s 162(1) Voyeurism`
-- (what the person did, surreptitiously, reasonable expectation of privacy, (a) a place of nudity, (b) a nude person, (b) done for the purpose of observing or recording such a state, (c) a sexual purpose)
#ASSERT `s 162(1) the conduct is the offence of voyeurism` `s 162(1) observed, including by mechanical or electronic means` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- paragraph (a)
#ASSERT `s 162(1) the conduct is the offence of voyeurism` `s 162(1) made a visual recording of` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- a recording
#ASSERT `s 162(1) the conduct is the offence of voyeurism` `s 162(1) observed, including by mechanical or electronic means` TRUE TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE   -- paragraph (b): nude and done for that purpose
#ASSERT `s 162(1) the conduct is the offence of voyeurism` `s 162(1) observed, including by mechanical or electronic means` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING   -- paragraph (b) needs both: the person is nude but it was not done for that purpose
#ASSERT `s 162(1) the conduct is the offence of voyeurism` `s 162(1) observed, including by mechanical or electronic means` TRUE TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING   -- done for that purpose but the person is not nude
#ASSERT `s 162(1) the conduct is the offence of voyeurism` `s 162(1) made a visual recording of` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- paragraph (c): a sexual purpose
#ASSERT `s 162(1) the conduct is the offence of voyeurism` `s 162(1) neither` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING   -- neither observed nor recorded
#ASSERT `s 162(1) the conduct is the offence of voyeurism` `s 162(1) observed, including by mechanical or electronic means` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING   -- not surreptitiously
#ASSERT `s 162(1) the conduct is the offence of voyeurism` `s 162(1) observed, including by mechanical or electronic means` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING   -- no reasonable expectation of privacy
#ASSERT `s 162(1) the conduct is the offence of voyeurism` `s 162(1) observed, including by mechanical or electronic means` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- none of (a), (b), (c)
-- (2): includes
#ASSERT `s 162(2) visual recording` `s 162(2) a photographic recording` EQUALS JUST TRUE
#ASSERT `s 162(2) visual recording` `s 162(2) a film recording` EQUALS JUST TRUE
#ASSERT `s 162(2) visual recording` `s 162(2) a video recording` EQUALS JUST TRUE
#ASSERT `s 162(2) visual recording` `s 162(2) another recording made by any means` EQUALS NOTHING   -- "includes": the list is open
#ASSERT `s 162(2) visual recording` `s 162(2) something that is not a recording` EQUALS NOTHING
-- (3): (the answer of s 2 peace officer, under a warrant issued under 487.01, carrying out an activity referred to)
#ASSERT `s 162(3) paragraphs (1)(a) and (1)(b) apply to the person` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE   -- "do not apply"
#ASSERT `s 162(3) paragraphs (1)(a) and (1)(b) apply to the person` (JUST TRUE) FALSE TRUE EQUALS NOTHING   -- no warrant
#ASSERT `s 162(3) paragraphs (1)(a) and (1)(b) apply to the person` (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- not carrying out such an activity
#ASSERT `s 162(3) paragraphs (1)(a) and (1)(b) apply to the person` (JUST FALSE) TRUE TRUE EQUALS NOTHING   -- not a peace officer
#ASSERT `s 162(3) paragraphs (1)(a) and (1)(b) apply to the person` NOTHING TRUE TRUE EQUALS NOTHING   -- s 2 "peace officer" is an "includes" definition: not answered
-- (4): (knew the recording was obtained by an offence under (1), what the person did)
#ASSERT `s 162(4) the conduct is the offence of printing, publishing, etc. a voyeuristic recording` TRUE `s 162(4) prints` EQUALS JUST TRUE
#ASSERT `s 162(4) the conduct is the offence of printing, publishing, etc. a voyeuristic recording` TRUE `s 162(4) copies` EQUALS JUST TRUE
#ASSERT `s 162(4) the conduct is the offence of printing, publishing, etc. a voyeuristic recording` TRUE `s 162(4) publishes` EQUALS JUST TRUE
#ASSERT `s 162(4) the conduct is the offence of printing, publishing, etc. a voyeuristic recording` TRUE `s 162(4) distributes` EQUALS JUST TRUE
#ASSERT `s 162(4) the conduct is the offence of printing, publishing, etc. a voyeuristic recording` TRUE `s 162(4) circulates` EQUALS JUST TRUE
#ASSERT `s 162(4) the conduct is the offence of printing, publishing, etc. a voyeuristic recording` TRUE `s 162(4) sells` EQUALS JUST TRUE
#ASSERT `s 162(4) the conduct is the offence of printing, publishing, etc. a voyeuristic recording` TRUE `s 162(4) advertises` EQUALS JUST TRUE
#ASSERT `s 162(4) the conduct is the offence of printing, publishing, etc. a voyeuristic recording` TRUE `s 162(4) makes available` EQUALS JUST TRUE
#ASSERT `s 162(4) the conduct is the offence of printing, publishing, etc. a voyeuristic recording` TRUE `s 162(4) has the recording in possession for the purpose of printing, copying, publishing, distributing, circulating, selling or advertising it or making it available` EQUALS JUST TRUE
#ASSERT `s 162(4) the conduct is the offence of printing, publishing, etc. a voyeuristic recording` FALSE `s 162(4) publishes` EQUALS NOTHING   -- did not know
#ASSERT `s 162(4) the conduct is the offence of printing, publishing, etc. a voyeuristic recording` TRUE `s 162(4) none of those` EQUALS NOTHING
-- (5), (6), (7)
#ASSERT `s 162(5)(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 10) `no imprisonment is stated`
#ASSERT `s 162(5)(b) the punishment on summary conviction` `s 162 test s 787(1) penalty` EQUALS `s 162 test summary penalty`
#ASSERT `s 162 the class of the offence` EQUALS `ss 150 to 182 test both`
#ASSERT `s 162(6) section 162 gives a defence of public good` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 162(6) section 162 gives a defence of public good` TRUE FALSE EQUALS JUST FALSE   -- extends beyond what serves the public good
#ASSERT `s 162(6) section 162 gives a defence of public good` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 162(7)(a) the question is a question of law` `s 162(7) whether an act serves the public good` EQUALS JUST TRUE
#ASSERT `s 162(7)(a) the question is a question of law` `s 162(7) whether there is evidence that the act alleged goes beyond what serves the public good` EQUALS JUST TRUE
#ASSERT `s 162(7)(a) the question is a question of law` `s 162(7) whether the act does or does not extend beyond what serves the public good` EQUALS JUST FALSE   -- a question of fact
#ASSERT `s 162(7)(a) the question is a question of law` `s 162(7) another question` EQUALS NOTHING
#ASSERT `s 162(7)(b) the motives of an accused are relevant` TRUE EQUALS JUST FALSE
#ASSERT `s 162(7)(b) the motives of an accused are relevant` FALSE EQUALS NOTHING

§ `s 162.1(2) intimate image`
-- (what the thing is, nude etc., privacy at the time of the recording, privacy retained at the time of the offence, likely to be mistaken for a visual recording)
#ASSERT `s 162.1(2) intimate image` `s 162.1(2)(a) a visual recording of a person made by any means including a photographic, film or video recording` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 162.1(2) intimate image` `s 162.1(2)(a) a visual recording of a person made by any means including a photographic, film or video recording` FALSE TRUE TRUE FALSE EQUALS JUST FALSE   -- (i) fails
#ASSERT `s 162.1(2) intimate image` `s 162.1(2)(a) a visual recording of a person made by any means including a photographic, film or video recording` TRUE FALSE TRUE FALSE EQUALS JUST FALSE   -- (ii) fails
#ASSERT `s 162.1(2) intimate image` `s 162.1(2)(a) a visual recording of a person made by any means including a photographic, film or video recording` TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- (iii) fails
#ASSERT `s 162.1(2) intimate image` `s 162.1(2)(b) a visual representation made by any electronic or mechanical means, including by means of artificial intelligence software, that shows an identifiable person` TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- (b): no privacy conditions
#ASSERT `s 162.1(2) intimate image` `s 162.1(2)(b) a visual representation made by any electronic or mechanical means, including by means of artificial intelligence software, that shows an identifiable person` TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- not likely to be mistaken for a recording
#ASSERT `s 162.1(2) intimate image` `s 162.1(2)(b) a visual representation made by any electronic or mechanical means, including by means of artificial intelligence software, that shows an identifiable person` FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- not depicted nude etc.
#ASSERT `s 162.1(2) intimate image` `s 162.1(2) neither` TRUE TRUE TRUE TRUE EQUALS JUST FALSE

§ `s 162.1(1) the offence`
-- (knowingly, what was done, the answer of s 162.1(2), knew no consent, reckless as to consent)
#ASSERT `s 162.1(1) the conduct is the offence of publishing an intimate image without consent` TRUE `s 162.1(1) publishes` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 162.1(1) the conduct is the offence of publishing an intimate image without consent` TRUE `s 162.1(1) distributes` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- reckless
#ASSERT `s 162.1(1) the conduct is the offence of publishing an intimate image without consent` TRUE `s 162.1(1) transmits` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 162.1(1) the conduct is the offence of publishing an intimate image without consent` TRUE `s 162.1(1) sells` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 162.1(1) the conduct is the offence of publishing an intimate image without consent` TRUE `s 162.1(1) makes available` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 162.1(1) the conduct is the offence of publishing an intimate image without consent` TRUE `s 162.1(1) advertises` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 162.1(1) the conduct is the offence of publishing an intimate image without consent` TRUE `s 162.1(1) publishes` (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- neither knew nor was reckless
#ASSERT `s 162.1(1) the conduct is the offence of publishing an intimate image without consent` FALSE `s 162.1(1) publishes` (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- not knowingly
#ASSERT `s 162.1(1) the conduct is the offence of publishing an intimate image without consent` TRUE `s 162.1(1) none of those` (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 162.1(1) the conduct is the offence of publishing an intimate image without consent` TRUE `s 162.1(1) publishes` (JUST FALSE) TRUE FALSE EQUALS NOTHING   -- not an intimate image
#ASSERT `s 162.1(1) the conduct is the offence of publishing an intimate image without consent` TRUE `s 162.1(1) publishes` NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 162.1(1)(a) the punishment on indictment` FALSE EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 10) `no imprisonment is stated`   -- (a)(i)
#ASSERT `s 162.1(1)(a) the punishment on indictment` TRUE EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) `no imprisonment is stated`   -- (a)(ii): aggravated sexual assault known or ought to have been known
#ASSERT `s 162.1(1)(b) the punishment on summary conviction` `s 162 test s 787(1) penalty` EQUALS `s 162 test summary penalty`
#ASSERT `s 162.1(1) the class of the offence` EQUALS `ss 150 to 182 test both`

§ `s 162.1(1.1) Threat to publish, etc.`
-- (intent to intimidate or to be taken seriously, knowingly threatens, what, the answer of s 162.1(2), knew the person would not consent, reckless)
#ASSERT `s 162.1(1.1) the conduct is the offence of threatening to publish an intimate image` TRUE TRUE `s 162.1(1.1) publish` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 162.1(1.1) the conduct is the offence of threatening to publish an intimate image` TRUE TRUE `s 162.1(1.1) advertise` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 162.1(1.1) the conduct is the offence of threatening to publish an intimate image` FALSE TRUE `s 162.1(1.1) publish` (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- no intent to intimidate or to be taken seriously
#ASSERT `s 162.1(1.1) the conduct is the offence of threatening to publish an intimate image` TRUE FALSE `s 162.1(1.1) publish` (JUST TRUE) TRUE FALSE EQUALS NOTHING   -- not knowingly
#ASSERT `s 162.1(1.1) the conduct is the offence of threatening to publish an intimate image` TRUE TRUE `s 162.1(1.1) nothing of that kind` (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 162.1(1.1) the conduct is the offence of threatening to publish an intimate image` TRUE TRUE `s 162.1(1.1) sell` (JUST FALSE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 162.1(1.1) the conduct is the offence of threatening to publish an intimate image` TRUE TRUE `s 162.1(1.1) sell` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 162.1(1.1)(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 10) `no imprisonment is stated`
#ASSERT `s 162.1(1.1)(b) the punishment on summary conviction` `s 162 test s 787(1) penalty` EQUALS `s 162 test summary penalty`
#ASSERT `s 162.1(1.1) the class of the offence` EQUALS `ss 150 to 182 test both`
#ASSERT `s 162.1(3) section 162.1 gives a defence of public good` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 162.1(3) section 162.1 gives a defence of public good` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 162.1(3) section 162.1 gives a defence of public good` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 162.1(4)(a) the question is a question of law` `s 162.1(4) whether the conduct serves the public good` EQUALS JUST TRUE
#ASSERT `s 162.1(4)(a) the question is a question of law` `s 162.1(4) whether there is evidence that the conduct alleged goes beyond what serves the public good` EQUALS JUST TRUE
#ASSERT `s 162.1(4)(a) the question is a question of law` `s 162.1(4) whether the conduct does or does not extend beyond what serves the public good` EQUALS JUST FALSE
#ASSERT `s 162.1(4)(a) the question is a question of law` `s 162.1(4) another question` EQUALS NOTHING
#ASSERT `s 162.1(4)(b) the motives of an accused are relevant` TRUE EQUALS JUST FALSE
#ASSERT `s 162.1(4)(b) the motives of an accused are relevant` FALSE EQUALS NOTHING
