IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc13-mischief`
IMPORT `ccc13-tests-support`

-- ccc13-tests-mischief.l4 -- tests of ccc13-mischief.l4 (ss 428 to 432). Expected values are decided from the text.

`ccc13 test the hybrid class` MEANS `an offence that the section makes both indictable and punishable on summary conviction`
`ccc13 test destroys` MEANS `s 430(1) destroys or damages property`
`ccc13 test renders` MEANS `s 430(1) renders property dangerous, useless, inoperative or ineffective`
`ccc13 test obstructs the use` MEANS `s 430(1) obstructs, interrupts or interferes with the lawful use, enjoyment or operation of property`
`ccc13 test obstructs the person` MEANS `s 430(1) obstructs, interrupts or interferes with any person in the lawful use, enjoyment or operation of property`
`ccc13 test no act` MEANS `s 430(1) an act that is none of those, in relation to property`
`ccc13 test alters data` MEANS `s 430(1.1) destroys or alters computer data`
`ccc13 test no data act` MEANS `s 430(1.1) an act that is none of those, in relation to computer data`

§ `s 428 and s 429`
#ASSERT `s 428 property` TRUE EQUALS JUST TRUE
#ASSERT `s 428 property` FALSE EQUALS JUST FALSE
#ASSERT `s 429(1) the person is deemed wilfully to have caused the occurrence of the event` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 429(1) the person is deemed wilfully to have caused the occurrence of the event` FALSE TRUE TRUE EQUALS NOTHING      -- a deeming rule adds a case: it says nothing of a person outside it
#ASSERT `s 429(1) the person is deemed wilfully to have caused the occurrence of the event` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 429(1) the person is deemed wilfully to have caused the occurrence of the event` TRUE TRUE FALSE EQUALS NOTHING
-- inputs of 429(2): the offence (by section number); acts with legal justification or excuse or colour of right
#ASSERT `s 429(2) the person shall not be convicted of the offence` (`ccc13 test the provision` 430 "(1)") TRUE EQUALS JUST TRUE
#ASSERT `s 429(2) the person shall not be convicted of the offence` (`ccc13 test the provision` 446 "(1)") TRUE EQUALS JUST TRUE          -- "sections 430 to 446": 446 is in
#ASSERT `s 429(2) the person shall not be convicted of the offence` (`ccc13 test the provision` 445.2 "(2)") TRUE EQUALS JUST TRUE       -- 445.2 lies between 430 and 446
#ASSERT `s 429(2) the person shall not be convicted of the offence` (`ccc13 test the provision` 431.2 "(2)") TRUE EQUALS JUST TRUE
#ASSERT `s 429(2) the person shall not be convicted of the offence` (`ccc13 test the provision` 447 "(1)") TRUE EQUALS NOTHING          -- section 447 is outside the range
#ASSERT `s 429(2) the person shall not be convicted of the offence` (`ccc13 test the provision` 446.1 "") TRUE EQUALS NOTHING            -- 446.1 comes after 446
#ASSERT `s 429(2) the person shall not be convicted of the offence` (`ccc13 test the provision` 429 "(1)") TRUE EQUALS NOTHING
#ASSERT `s 429(2) the person shall not be convicted of the offence` (`ccc13 test the provision` 430 "(1)") FALSE EQUALS JUST FALSE        -- "if they act with legal justification or excuse or colour of right"
-- inputs of 429(3): it is an offence to destroy or damage; has a partial (total) interest; caused the destruction or damage (with intent to defraud)
#ASSERT `s 429(3)(a) the person’s partial interest does not prevent guilt of the offence` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 429(3)(a) the person’s partial interest does not prevent guilt of the offence` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 429(3)(a) the person’s partial interest does not prevent guilt of the offence` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 429(3)(a) the person’s partial interest does not prevent guilt of the offence` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 429(3)(b) the person’s total interest does not prevent guilt of the offence` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 429(3)(b) the person’s total interest does not prevent guilt of the offence` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 429(3)(b) the person’s total interest does not prevent guilt of the offence` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 429(3)(b) the person’s total interest does not prevent guilt of the offence` TRUE TRUE FALSE EQUALS JUST FALSE      -- a total interest needs intent to defraud

§ `s 430(1) and (1.1) mischief`
#ASSERT `s 430(8) the thing is computer data` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 430(8) the thing is computer data` NOTHING EQUALS NOTHING
#ASSERT `s 430(8) the thing is computer data` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 430(6) the person is saved from committing mischief` `s 430(6) the person stops work as a result of the failure of their employer and themselves to agree on any matter relating to their employment` TRUE EQUALS JUST TRUE
#ASSERT `s 430(6) the person is saved from committing mischief` `s 430(6) the person stops work as a result of the failure of their employer and a bargaining agent acting on their behalf to agree on any matter relating to their employment` TRUE EQUALS JUST TRUE
#ASSERT `s 430(6) the person is saved from committing mischief` `s 430(6) the person stops work as a result of their taking part in a combination of workmen or employees for their own reasonable protection as workmen or employees` TRUE EQUALS JUST TRUE
#ASSERT `s 430(6) the person is saved from committing mischief` `s 430(6) the person stops work as a result of their taking part in a combination of workmen or employees for their own reasonable protection as workmen or employees` FALSE EQUALS JUST FALSE     -- not "by reason only"
#ASSERT `s 430(6) the person is saved from committing mischief` `s 430(6) a stoppage of work for a reason that is none of those` TRUE EQUALS NOTHING
#ASSERT `s 430(7) the person is saved from committing mischief` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 430(7) the person is saved from committing mischief` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 430(7) the person is saved from committing mischief` FALSE TRUE EQUALS JUST FALSE
-- inputs of (1): wilfully; deemed wilful (s 429(1)); the act; property (s 428); the saving of (6); the saving of (7)
#ASSERT `s 430(1) the conduct is mischief in relation to property` TRUE NOTHING `ccc13 test destroys` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 430(1) the conduct is mischief in relation to property` TRUE NOTHING `ccc13 test renders` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 430(1) the conduct is mischief in relation to property` TRUE NOTHING `ccc13 test obstructs the use` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 430(1) the conduct is mischief in relation to property` TRUE NOTHING `ccc13 test obstructs the person` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 430(1) the conduct is mischief in relation to property` FALSE (JUST TRUE) `ccc13 test destroys` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE          -- deemed wilful by section 429(1)
#ASSERT `s 430(1) the conduct is mischief in relation to property` FALSE NOTHING `ccc13 test destroys` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING                  -- neither wilful nor deemed so
#ASSERT `s 430(1) the conduct is mischief in relation to property` TRUE NOTHING `ccc13 test destroys` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE            -- not property in the sense of section 428
#ASSERT `s 430(1) the conduct is mischief in relation to property` TRUE NOTHING `ccc13 test destroys` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE             -- the saving of (6)
#ASSERT `s 430(1) the conduct is mischief in relation to property` TRUE NOTHING `ccc13 test destroys` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE             -- the saving of (7)
#ASSERT `s 430(1) the conduct is mischief in relation to property` TRUE NOTHING `ccc13 test no act` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 430(1.1) the conduct is mischief in relation to computer data` TRUE NOTHING `ccc13 test alters data` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 430(1.1) the conduct is mischief in relation to computer data` TRUE NOTHING `s 430(1.1) renders computer data meaningless, useless or ineffective` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 430(1.1) the conduct is mischief in relation to computer data` TRUE NOTHING `s 430(1.1) obstructs, interrupts or interferes with the lawful use of computer data` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 430(1.1) the conduct is mischief in relation to computer data` TRUE NOTHING `s 430(1.1) obstructs, interrupts or interferes with a person in the lawful use of computer data or denies access to computer data to a person who is entitled to access to it` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 430(1.1) the conduct is mischief in relation to computer data` TRUE NOTHING `ccc13 test alters data` NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING      -- s 342.1(2) leaves it open
#ASSERT `s 430(1.1) the conduct is mischief in relation to computer data` TRUE NOTHING `ccc13 test alters data` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 430(1.1) the conduct is mischief in relation to computer data` TRUE NOTHING `ccc13 test no data act` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 430(1.1) the conduct is mischief in relation to computer data` TRUE NOTHING `ccc13 test alters data` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
-- (2): mischief that causes actual danger to life
#ASSERT `s 430(2) the conduct is the offence of mischief that causes actual danger to life` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 430(2) the conduct is the offence of mischief that causes actual danger to life` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 430(2) the conduct is the offence of mischief that causes actual danger to life` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 430(2) the conduct is the offence of mischief that causes actual danger to life` NOTHING TRUE EQUALS NOTHING
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 430(2) the punishments`) EQUALS `imprisonment for life`
#ASSERT `ccc13 test the number of limbs` (`s 430(2) the punishments`) EQUALS 1
#ASSERT `s 430(2) the class of the offence` EQUALS `an indictable offence`

§ `s 430(3) and (4) mischief by value and kind of property`
#ASSERT `s 430(3) the property is a testamentary instrument or its value exceeds five thousand dollars` (JUST TRUE) 100 EQUALS JUST TRUE
#ASSERT `s 430(3) the property is a testamentary instrument or its value exceeds five thousand dollars` (JUST FALSE) 5000 EQUALS JUST FALSE          -- exactly five thousand does not exceed
#ASSERT `s 430(3) the property is a testamentary instrument or its value exceeds five thousand dollars` (JUST FALSE) 5000.01 EQUALS JUST TRUE
#ASSERT `s 430(3) the property is a testamentary instrument or its value exceeds five thousand dollars` NOTHING 5000 EQUALS NOTHING
#ASSERT `s 430(3) the property is a testamentary instrument or its value exceeds five thousand dollars` NOTHING 6000 EQUALS JUST TRUE
#ASSERT `s 430(3) the conduct is the offence of mischief in relation to property of great value` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 430(3) the conduct is the offence of mischief in relation to property of great value` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 430(3) the conduct is the offence of mischief in relation to property of great value` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 430(3) the conduct is the offence of mischief in relation to property of great value` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 430(3) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `ten years`
#ASSERT `s 430(3) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 430(4) the conduct is the offence of mischief in relation to other property` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 430(4) the conduct is the offence of mischief in relation to other property` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE         -- property described in (3) is outside (4)
#ASSERT `s 430(4) the conduct is the offence of mischief in relation to other property` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 430(4) the conduct is the offence of mischief in relation to other property` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 430(4) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `two years`
#ASSERT `s 430(4) the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 430(4.1) to (5.1) bias, war memorials, cultural property, computer data, acts likely to constitute mischief`
`ccc13 test religious property` MEANS `s 430(4.101) a building or structure, or part of a building or structure, that is primarily used for religious worship, an object associated with religious worship located in or on the grounds of such a building or structure, or a cemetery`
`ccc13 test the group's school` MEANS `s 430(4.101) a building or structure, or part of a building or structure, that is primarily used by an identifiable group as an educational institution, or an object associated with that institution located in or on the grounds of such a building or structure`
`ccc13 test the group's activities` MEANS `s 430(4.101) a building or structure, or part of a building or structure, that is primarily used by an identifiable group for administrative, social, cultural or sports activities or events, or an object associated with such an activity or event located in or on the grounds of such a building or structure`
`ccc13 test the group's residence for seniors` MEANS `s 430(4.101) a building or structure, or part of a building or structure, that is primarily used by an identifiable group as a residence for seniors or an object associated with that residence located in or on the grounds of such a building or structure`
#ASSERT `s 430(4.101) the property is property for the purposes of subsection (4.1)` `ccc13 test religious property` (JUST FALSE) EQUALS JUST TRUE        -- (a) needs no identifiable group
#ASSERT `s 430(4.101) the property is property for the purposes of subsection (4.1)` `ccc13 test the group's school` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 430(4.101) the property is property for the purposes of subsection (4.1)` `ccc13 test the group's activities` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 430(4.101) the property is property for the purposes of subsection (4.1)` `ccc13 test the group's residence for seniors` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 430(4.101) the property is property for the purposes of subsection (4.1)` `ccc13 test the group's school` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 430(4.101) the property is property for the purposes of subsection (4.1)` `ccc13 test the group's school` NOTHING EQUALS NOTHING
#ASSERT `s 430(4.101) the property is property for the purposes of subsection (4.1)` `s 430(4.101) property that is none of those` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 430(4.1) the conduct is the offence of mischief motivated by bias in relation to religious property, educational institutions, etc.` (JUST TRUE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 430(4.1) the conduct is the offence of mischief motivated by bias in relation to religious property, educational institutions, etc.` (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST FALSE     -- not motivated by bias, prejudice or hate
#ASSERT `s 430(4.1) the conduct is the offence of mischief motivated by bias in relation to religious property, educational institutions, etc.` (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 430(4.1) the conduct is the offence of mischief motivated by bias in relation to religious property, educational institutions, etc.` (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 430(4.1) the conduct is the offence of mischief motivated by bias in relation to religious property, educational institutions, etc.` (JUST TRUE) NOTHING TRUE EQUALS NOTHING
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 430(4.1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `ten years`
#ASSERT `s 430(4.1) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 430(4.11) the conduct is the offence of mischief in relation to war memorials` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 430(4.11) the conduct is the offence of mischief in relation to war memorials` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 430(4.11) the conduct is the offence of mischief in relation to war memorials` (JUST FALSE) TRUE EQUALS JUST FALSE
-- the penalty by the number of the offence: the minimum is a fine of $1,000 for a first offence, 14 days for a second, 30 days for each subsequent one
`ccc13 test first offence by indictment` MEANS Punishment OF `by indictment`, `imprisonment for a term of` `ten years`, `no imprisonment is stated`, `no fine is stated`, `a fine of` 1000
`ccc13 test first offence on summary conviction` MEANS Punishment OF `on summary conviction`, `imprisonment for a term of` `two years less a day`, `no imprisonment is stated`, `no fine is stated`, `a fine of` 1000
`ccc13 test second offence by indictment` MEANS Punishment OF `by indictment`, `imprisonment for a term of` `ten years`, `imprisonment for a term of` (`Length of time` OF 0, 0, 14, FALSE), `no fine is stated`, `no fine is stated`
`ccc13 test second offence on summary conviction` MEANS Punishment OF `on summary conviction`, `imprisonment for a term of` `two years less a day`, `imprisonment for a term of` (`Length of time` OF 0, 0, 14, FALSE), `no fine is stated`, `no fine is stated`
`ccc13 test subsequent offence by indictment` MEANS Punishment OF `by indictment`, `imprisonment for a term of` `ten years`, `imprisonment for a term of` (`Length of time` OF 0, 0, 30, FALSE), `no fine is stated`, `no fine is stated`
`ccc13 test subsequent offence on summary conviction` MEANS Punishment OF `on summary conviction`, `imprisonment for a term of` `two years less a day`, `imprisonment for a term of` (`Length of time` OF 0, 0, 30, FALSE), `no fine is stated`, `no fine is stated`
#ASSERT `s 430(4.11) the punishments` 1 EQUALS JUST (LIST `ccc13 test first offence by indictment`, `ccc13 test first offence on summary conviction`)
#ASSERT `s 430(4.11) the punishments` 2 EQUALS JUST (LIST `ccc13 test second offence by indictment`, `ccc13 test second offence on summary conviction`)
#ASSERT `s 430(4.11) the punishments` 3 EQUALS JUST (LIST `ccc13 test subsequent offence by indictment`, `ccc13 test subsequent offence on summary conviction`)
#ASSERT `s 430(4.11) the punishments` 7 EQUALS JUST (LIST `ccc13 test subsequent offence by indictment`, `ccc13 test subsequent offence on summary conviction`)
#ASSERT `s 430(4.11) the punishments` 0 EQUALS NOTHING
#ASSERT `s 430(4.11) the class of the offence` EQUALS `ccc13 test the hybrid class`
