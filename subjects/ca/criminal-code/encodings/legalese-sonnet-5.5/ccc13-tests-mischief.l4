§ `s 432 unauthorized recording of a movie`
#ASSERT `s 432(1) the conduct is the offence of unauthorized recording of a movie` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 432(1) the conduct is the offence of unauthorized recording of a movie` FALSE TRUE EQUALS JUST FALSE       -- with the theatre manager's consent
#ASSERT `s 432(1) the conduct is the offence of unauthorized recording of a movie` TRUE FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 432(1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `two years`
#ASSERT `s 432(1) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 432(2) the conduct is the offence of unauthorized recording of a movie for the purpose of sale` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 432(2) the conduct is the offence of unauthorized recording of a movie for the purpose of sale` TRUE TRUE FALSE EQUALS JUST FALSE     -- no purpose of sale, rental or commercial distribution
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 432(2) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 432(2) the class of the offence` EQUALS `ccc13 test the hybrid class`
