#ASSERT `s 430(4.2) the conduct is the offence of mischief in relation to cultural property` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 430(4.2) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `ten years`
#ASSERT `s 430(4.2) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 430(5) the conduct is the offence of mischief in relation to computer data` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 430(5) the conduct is the offence of mischief in relation to computer data` NOTHING EQUALS NOTHING
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 430(5) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `ten years`
#ASSERT `s 430(5) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 430(5.1) the conduct is the offence of doing or omitting an act likely to constitute mischief` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 430(5.1) the conduct is the offence of doing or omitting an act likely to constitute mischief` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 430(5.1) the conduct is the offence of doing or omitting an act likely to constitute mischief` FALSE TRUE EQUALS JUST FALSE
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 430(5.1) the punishments` `ccc13 test p787`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `s 430(5.1) the class of the offence` EQUALS `ccc13 test the hybrid class`

