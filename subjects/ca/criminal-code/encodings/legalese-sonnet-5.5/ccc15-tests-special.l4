IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc15-special`

-- ccc15-tests-special.l4 -- tests for ccc15-special.l4 (sections 476 to 477.4). Every expected value is written here from the text before the run,
-- beside its assertion, and not copied from the encoding's output. A failing assertion is a finding.

§ `Tests for section 476`

-- Circumstances, in order: (a) water or bridge; (b) metres from a boundary; (b) commenced and completed; (c) vehicle or vessel; (c) road or water is the boundary; (d) aircraft; (e) mail.
`s 476 test: no circumstances` MEANS `s 476 circumstances of the offence` OF FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE
`s 476 test: water or bridge` MEANS `s 476 circumstances of the offence` OF TRUE, NOTHING, FALSE, FALSE, FALSE, FALSE, FALSE
`s 476 test: on the boundary` MEANS `s 476 circumstances of the offence` OF FALSE, JUST 0, FALSE, FALSE, FALSE, FALSE, FALSE
`s 476 test: 500 metres from the boundary` MEANS `s 476 circumstances of the offence` OF FALSE, JUST 500, FALSE, FALSE, FALSE, FALSE, FALSE
`s 476 test: 501 metres from the boundary` MEANS `s 476 circumstances of the offence` OF FALSE, JUST 501, FALSE, FALSE, FALSE, FALSE, FALSE
`s 476 test: commenced and completed` MEANS `s 476 circumstances of the offence` OF FALSE, NOTHING, TRUE, FALSE, FALSE, FALSE, FALSE
`s 476 test: vehicle or vessel` MEANS `s 476 circumstances of the offence` OF FALSE, NOTHING, FALSE, TRUE, FALSE, FALSE, FALSE
`s 476 test: vehicle or vessel on a boundary road` MEANS `s 476 circumstances of the offence` OF FALSE, NOTHING, FALSE, TRUE, TRUE, FALSE, FALSE
`s 476 test: road is the boundary but no vehicle` MEANS `s 476 circumstances of the offence` OF FALSE, NOTHING, FALSE, FALSE, TRUE, FALSE, FALSE
`s 476 test: aircraft` MEANS `s 476 circumstances of the offence` OF FALSE, NOTHING, FALSE, FALSE, FALSE, TRUE, FALSE
`s 476 test: mail` MEANS `s 476 circumstances of the offence` OF FALSE, NOTHING, FALSE, FALSE, FALSE, FALSE, TRUE
`s 476 test: water and vehicle` MEANS `s 476 circumstances of the offence` OF TRUE, NOTHING, FALSE, TRUE, FALSE, FALSE, FALSE

-- Links, in order: (a); (b) boundary; (b) commenced or completed; (c) passed through; (c) boundary road or water; (d)(i) flight commenced; (d)(ii) passed over; (d)(iii) flight ended; (e) mail carried through.
`s 476 test: no link` MEANS `s 476 how the territorial division is connected to the offence` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 476 test: between which the water lies` MEANS `s 476 how the territorial division is connected to the offence` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 476 test: of the boundary` MEANS `s 476 how the territorial division is connected to the offence` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 476 test: commenced or completed there` MEANS `s 476 how the territorial division is connected to the offence` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 476 test: the vehicle passed through` MEANS `s 476 how the territorial division is connected to the offence` OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 476 test: the road is its boundary` MEANS `s 476 how the territorial division is connected to the offence` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`s 476 test: the flight commenced there` MEANS `s 476 how the territorial division is connected to the offence` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`s 476 test: the aircraft passed over` MEANS `s 476 how the territorial division is connected to the offence` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
`s 476 test: the flight ended there` MEANS `s 476 how the territorial division is connected to the offence` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
`s 476 test: the mail was carried through` MEANS `s 476 how the territorial division is connected to the offence` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE

-- (a): water or a bridge between divisions: deemed committed in any of those divisions.
#ASSERT `s 476(a) the offence is deemed to have been committed in the territorial division` `s 476 test: water or bridge` `s 476 test: between which the water lies` EQUALS JUST TRUE
-- a division that is not one between which the water lies: the deeming is silent
#ASSERT `s 476(a) the offence is deemed to have been committed in the territorial division` `s 476 test: water or bridge` `s 476 test: no link` EQUALS NOTHING
-- the offence was not on water or a bridge: "where" unmet
#ASSERT `s 476(a) the offence is deemed to have been committed in the territorial division` `s 476 test: no circumstances` `s 476 test: between which the water lies` EQUALS JUST FALSE
-- (b): on the boundary or within 500 metres of it.
#ASSERT `s 476(b) the offence is deemed to have been committed in the territorial division, the offence being committed on or within five hundred metres of the boundary` `s 476 test: on the boundary` `s 476 test: of the boundary` EQUALS JUST TRUE
#ASSERT `s 476(b) the offence is deemed to have been committed in the territorial division, the offence being committed on or within five hundred metres of the boundary` `s 476 test: 500 metres from the boundary` `s 476 test: of the boundary` EQUALS JUST TRUE
#ASSERT `s 476(b) the offence is deemed to have been committed in the territorial division, the offence being committed on or within five hundred metres of the boundary` `s 476 test: 501 metres from the boundary` `s 476 test: of the boundary` EQUALS JUST FALSE
-- no boundary nearby at all
#ASSERT `s 476(b) the offence is deemed to have been committed in the territorial division, the offence being committed on or within five hundred metres of the boundary` `s 476 test: no circumstances` `s 476 test: of the boundary` EQUALS JUST FALSE
-- within 500 metres but a division that is not one of that boundary's
#ASSERT `s 476(b) the offence is deemed to have been committed in the territorial division, the offence being committed on or within five hundred metres of the boundary` `s 476 test: on the boundary` `s 476 test: no link` EQUALS NOTHING
-- (b): commenced in one division and completed in another: deemed in either.
#ASSERT `s 476(b) the offence is deemed to have been committed in the territorial division, the offence being commenced within one territorial division and completed within another` `s 476 test: commenced and completed` `s 476 test: commenced or completed there` EQUALS JUST TRUE
#ASSERT `s 476(b) the offence is deemed to have been committed in the territorial division, the offence being commenced within one territorial division and completed within another` `s 476 test: commenced and completed` `s 476 test: no link` EQUALS NOTHING
#ASSERT `s 476(b) the offence is deemed to have been committed in the territorial division, the offence being commenced within one territorial division and completed within another` `s 476 test: no circumstances` `s 476 test: commenced or completed there` EQUALS JUST FALSE
-- (c): vehicle on a journey or vessel on a navigable river, canal or inland water: deemed in any division through which it passed.
#ASSERT `s 476(c) the offence is deemed to have been committed in the territorial division, the offence being committed in or on a vehicle or on board a vessel` `s 476 test: vehicle or vessel` `s 476 test: the vehicle passed through` EQUALS JUST TRUE
#ASSERT `s 476(c) the offence is deemed to have been committed in the territorial division, the offence being committed in or on a vehicle or on board a vessel` `s 476 test: vehicle or vessel` `s 476 test: no link` EQUALS NOTHING
#ASSERT `s 476(c) the offence is deemed to have been committed in the territorial division, the offence being committed in or on a vehicle or on board a vessel` `s 476 test: no circumstances` `s 476 test: the vehicle passed through` EQUALS JUST FALSE
-- (c): where the center of the road or water is the boundary of two or more divisions: deemed in any of them.
#ASSERT `s 476(c) the offence is deemed to have been committed in the territorial division, the road or water on which the vehicle or vessel passed being the boundary of two or more territorial divisions` `s 476 test: vehicle or vessel on a boundary road` `s 476 test: the road is its boundary` EQUALS JUST TRUE
#ASSERT `s 476(c) the offence is deemed to have been committed in the territorial division, the road or water on which the vehicle or vessel passed being the boundary of two or more territorial divisions` `s 476 test: vehicle or vessel on a boundary road` `s 476 test: no link` EQUALS NOTHING
-- the road is a boundary but the offence was not in or on a vehicle or vessel (fork: road-boundary limb read as continuing the vehicle sentence)
#ASSERT `s 476(c) the offence is deemed to have been committed in the territorial division, the road or water on which the vehicle or vessel passed being the boundary of two or more territorial divisions` `s 476 test: road is the boundary but no vehicle` `s 476 test: the road is its boundary` EQUALS JUST FALSE
-- a vehicle on a road that is not a boundary: the second limb's "where" is unmet
#ASSERT `s 476(c) the offence is deemed to have been committed in the territorial division, the road or water on which the vehicle or vessel passed being the boundary of two or more territorial divisions` `s 476 test: vehicle or vessel` `s 476 test: the road is its boundary` EQUALS JUST FALSE
-- (d): aircraft in flight: deemed in the division where the flight commenced, any it passed over, or where it ended.
#ASSERT `s 476(d) the offence is deemed to have been committed in the territorial division, the offence being committed in an aircraft in the course of a flight` `s 476 test: aircraft` `s 476 test: the flight commenced there` EQUALS JUST TRUE
#ASSERT `s 476(d) the offence is deemed to have been committed in the territorial division, the offence being committed in an aircraft in the course of a flight` `s 476 test: aircraft` `s 476 test: the aircraft passed over` EQUALS JUST TRUE
#ASSERT `s 476(d) the offence is deemed to have been committed in the territorial division, the offence being committed in an aircraft in the course of a flight` `s 476 test: aircraft` `s 476 test: the flight ended there` EQUALS JUST TRUE
#ASSERT `s 476(d) the offence is deemed to have been committed in the territorial division, the offence being committed in an aircraft in the course of a flight` `s 476 test: aircraft` `s 476 test: no link` EQUALS NOTHING
#ASSERT `s 476(d) the offence is deemed to have been committed in the territorial division, the offence being committed in an aircraft in the course of a flight` `s 476 test: no circumstances` `s 476 test: the flight ended there` EQUALS JUST FALSE
-- (e): the mail in the course of its door-to-door delivery: deemed in any division through which the mail was carried.
#ASSERT `s 476(e) the offence is deemed to have been committed in the territorial division, the offence being committed in respect of the mail` `s 476 test: mail` `s 476 test: the mail was carried through` EQUALS JUST TRUE
#ASSERT `s 476(e) the offence is deemed to have been committed in the territorial division, the offence being committed in respect of the mail` `s 476 test: mail` `s 476 test: no link` EQUALS NOTHING
#ASSERT `s 476(e) the offence is deemed to have been committed in the territorial division, the offence being committed in respect of the mail` `s 476 test: no circumstances` `s 476 test: the mail was carried through` EQUALS JUST FALSE
-- The section's own answer: any paragraph that deems it; otherwise NOTHING if a paragraph's circumstances are the case's but it names other divisions; otherwise JUST FALSE.
#ASSERT `s 476 the offence is deemed to have been committed in the territorial division` `s 476 test: water or bridge` `s 476 test: between which the water lies` EQUALS JUST TRUE
#ASSERT `s 476 the offence is deemed to have been committed in the territorial division` `s 476 test: on the boundary` `s 476 test: of the boundary` EQUALS JUST TRUE
#ASSERT `s 476 the offence is deemed to have been committed in the territorial division` `s 476 test: commenced and completed` `s 476 test: commenced or completed there` EQUALS JUST TRUE
#ASSERT `s 476 the offence is deemed to have been committed in the territorial division` `s 476 test: vehicle or vessel on a boundary road` `s 476 test: the road is its boundary` EQUALS JUST TRUE
#ASSERT `s 476 the offence is deemed to have been committed in the territorial division` `s 476 test: aircraft` `s 476 test: the aircraft passed over` EQUALS JUST TRUE
#ASSERT `s 476 the offence is deemed to have been committed in the territorial division` `s 476 test: mail` `s 476 test: the mail was carried through` EQUALS JUST TRUE
-- water AND vehicle: the water paragraph does not name this division (NOTHING) but the vehicle paragraph does: any TRUE wins
#ASSERT `s 476 the offence is deemed to have been committed in the territorial division` `s 476 test: water and vehicle` `s 476 test: the vehicle passed through` EQUALS JUST TRUE
-- a paragraph applies but names other divisions
#ASSERT `s 476 the offence is deemed to have been committed in the territorial division` `s 476 test: water or bridge` `s 476 test: no link` EQUALS NOTHING
#ASSERT `s 476 the offence is deemed to have been committed in the territorial division` `s 476 test: aircraft` `s 476 test: no link` EQUALS NOTHING
-- no paragraph applies
#ASSERT `s 476 the offence is deemed to have been committed in the territorial division` `s 476 test: no circumstances` `s 476 test: no link` EQUALS JUST FALSE
#ASSERT `s 476 the offence is deemed to have been committed in the territorial division` `s 476 test: no circumstances` `s 476 test: of the boundary` EQUALS JUST FALSE

§ `Tests for section 477`

-- 477(1): in sections 477.1 to 477.4, ship includes any vessel, boat or craft designed, used or capable of being used solely or partly for marine navigation.
-- Arguments: the provision in which the word is used, a vessel, boat or craft, designed/used/capable of marine navigation.
#ASSERT `s 477(1) ship` (`Provision of the Code` OF 477.1, "") TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 477(1) ship` (`Provision of the Code` OF 477.2, "(1)") TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 477(1) ship` (`Provision of the Code` OF 477.3, "") TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 477(1) ship` (`Provision of the Code` OF 477.4, "(3)") TRUE TRUE EQUALS JUST TRUE
-- outside sections 477.1 to 477.4: the definition does not reach the provision
#ASSERT `s 477(1) ship` (`Provision of the Code` OF 477, "(1)") TRUE TRUE EQUALS NOTHING
#ASSERT `s 477(1) ship` (`Provision of the Code` OF 478, "") TRUE TRUE EQUALS NOTHING
-- "includes" does not close the list: a craft that is not designed or used for marine navigation, or a thing that is not a vessel, boat or craft
#ASSERT `s 477(1) ship` (`Provision of the Code` OF 477.1, "") TRUE FALSE EQUALS NOTHING
#ASSERT `s 477(1) ship` (`Provision of the Code` OF 477.1, "") FALSE TRUE EQUALS NOTHING
-- 477(2): nothing in sections 477.1 to 477.4 limits the operation of any other Act or the jurisdiction a court may exercise apart from those sections.
#ASSERT `s 477(2) the section limits the operation of any other Act of Parliament or the jurisdiction that a court may exercise apart from sections 477.1 to 477.4` (`Provision of the Code` OF 477.1, "") `s 477(2) the operation of another Act of Parliament` EQUALS JUST FALSE
#ASSERT `s 477(2) the section limits the operation of any other Act of Parliament or the jurisdiction that a court may exercise apart from sections 477.1 to 477.4` (`Provision of the Code` OF 477.4, "(3)") `s 477(2) the jurisdiction that a court may exercise apart from sections 477.1 to 477.4` EQUALS JUST FALSE
-- a section outside 477.1 to 477.4; something else
#ASSERT `s 477(2) the section limits the operation of any other Act of Parliament or the jurisdiction that a court may exercise apart from sections 477.1 to 477.4` (`Provision of the Code` OF 478, "") `s 477(2) the operation of another Act of Parliament` EQUALS NOTHING
#ASSERT `s 477(2) the section limits the operation of any other Act of Parliament or the jurisdiction that a court may exercise apart from sections 477.1 to 477.4` (`Provision of the Code` OF 477.2, "") `s 477(2) something else` EQUALS NOTHING

§ `Tests for section 477.1`

-- Facts, in order: federal-law offence if in Canada; (a) in the EEZ; (a)(i) in connection with the resources; (a)(ii) by or in relation to a citizen or permanent resident; (b) continental shelf;
-- (c) outside Canada on board or by means of a ship; (c) the ship is registered or licensed or numbered; (d) hot pursuit; (e) outside any state by a citizen.
`s 477.1 test: nothing but a federal offence` MEANS `s 477.1 facts of the act or omission` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 477.1 test: all of (a)` MEANS `s 477.1 facts of the act or omission` OF TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 477.1 test: (a) without the zone` MEANS `s 477.1 facts of the act or omission` OF TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 477.1 test: (a) without (i)` MEANS `s 477.1 facts of the act or omission` OF TRUE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 477.1 test: (a) without (ii)` MEANS `s 477.1 facts of the act or omission` OF TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`s 477.1 test: (b)` MEANS `s 477.1 facts of the act or omission` OF TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`s 477.1 test: (c)` MEANS `s 477.1 facts of the act or omission` OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE
`s 477.1 test: (c) ship not registered` MEANS `s 477.1 facts of the act or omission` OF TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`s 477.1 test: (d)` MEANS `s 477.1 facts of the act or omission` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
`s 477.1 test: (e)` MEANS `s 477.1 facts of the act or omission` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
`s 477.1 test: (d) but not a federal offence` MEANS `s 477.1 facts of the act or omission` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE

#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: all of (a)` (JUST FALSE) EQUALS JUST TRUE
-- each limb of (a) is needed: the zone, (i) and (ii)
#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: (a) without the zone` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: (a) without (i)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: (a) without (ii)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: (b)` (JUST FALSE) EQUALS JUST TRUE
-- (c): the ship, as section 477(1) answers
#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: (c)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: (c)` NOTHING EQUALS NOTHING
#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: (c)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: (c) ship not registered` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: (d)` NOTHING EQUALS JUST TRUE
#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: (e)` NOTHING EQUALS JUST TRUE
-- none of (a) to (e): the "if" is unmet
#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: nothing but a federal offence` (JUST TRUE) EQUALS JUST FALSE
-- not an offence under a federal law if it occurred in Canada: the section does not speak
#ASSERT `s 477.1 the person is deemed to have committed the act or omission in Canada` `s 477.1 test: (d) but not a federal offence` (JUST TRUE) EQUALS NOTHING

§ `Tests for section 477.2`

-- The eight days: proceedings commenced on 1 January 2026; the eighth day after is 9 January 2026.
#ASSERT `s 477.2 the consent was not obtained not later than eight days after the proceedings were commenced` (Date 1 1 2026) (JUST (Date 9 1 2026)) (Date 20 1 2026) EQUALS FALSE
#ASSERT `s 477.2 the consent was not obtained not later than eight days after the proceedings were commenced` (Date 1 1 2026) (JUST (Date 10 1 2026)) (Date 20 1 2026) EQUALS TRUE
#ASSERT `s 477.2 the consent was not obtained not later than eight days after the proceedings were commenced` (Date 1 1 2026) (JUST (Date 1 1 2026)) (Date 20 1 2026) EQUALS FALSE
-- a consent obtained before the proceedings were commenced is not later than eight days after
#ASSERT `s 477.2 the consent was not obtained not later than eight days after the proceedings were commenced` (Date 1 1 2026) (JUST (Date 30 12 2025)) (Date 20 1 2026) EQUALS FALSE
-- no consent yet: out of time only once the as-at date is more than eight days after
#ASSERT `s 477.2 the consent was not obtained not later than eight days after the proceedings were commenced` (Date 1 1 2026) NOTHING (Date 9 1 2026) EQUALS FALSE
#ASSERT `s 477.2 the consent was not obtained not later than eight days after the proceedings were commenced` (Date 1 1 2026) NOTHING (Date 10 1 2026) EQUALS TRUE
-- across a month end and a leap day: 28 February 2024 + 8 days = 7 March 2024 (2024 has 29 February)
#ASSERT `s 477.2 the consent was not obtained not later than eight days after the proceedings were commenced` (Date 28 2 2024) (JUST (Date 7 3 2024)) (Date 20 3 2024) EQUALS FALSE
#ASSERT `s 477.2 the consent was not obtained not later than eight days after the proceedings were commenced` (Date 28 2 2024) (JUST (Date 8 3 2024)) (Date 20 3 2024) EQUALS TRUE
-- the last day on which the consent may be obtained
#ASSERT `s 477.2 the last day on which the consent of the Attorney General of Canada may be obtained` (Date 1 1 2026) EQUALS Date 9 1 2026
#ASSERT `s 477.2 the last day on which the consent of the Attorney General of Canada may be obtained` (Date 25 2 2024) EQUALS Date 4 3 2024
#ASSERT `s 477.2 the last day on which the consent of the Attorney General of Canada may be obtained` (Date 25 2 2025) EQUALS Date 5 3 2025
#ASSERT `s 477.2 the last day on which the consent of the Attorney General of Canada may be obtained` (Date 28 12 2025) EQUALS Date 5 1 2026

-- (1.1): subsection (1) does not apply to proceedings by way of summary conviction.
#ASSERT `s 477.2(1.1) subsection (1) does not apply to the proceedings` `on summary conviction` EQUALS JUST TRUE
#ASSERT `s 477.2(1.1) subsection (1) does not apply to the proceedings` `by indictment` EQUALS NOTHING

-- (1): arguments: in or on the territorial sea; the accused is a Canadian citizen; alleged on board a ship registered outside Canada; the mode; commenced; consent date; as-at date.
-- consent obtained on the eighth day: the bar does not apply
#ASSERT `s 477.2(1) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE FALSE TRUE `by indictment` (Date 1 1 2026) (JUST (Date 9 1 2026)) (Date 20 1 2026) EQUALS JUST FALSE
-- consent obtained on the ninth day: barred
#ASSERT `s 477.2(1) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE FALSE TRUE `by indictment` (Date 1 1 2026) (JUST (Date 10 1 2026)) (Date 20 1 2026) EQUALS JUST TRUE
-- no consent, still inside the eight days: not yet barred
#ASSERT `s 477.2(1) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE FALSE TRUE `by indictment` (Date 1 1 2026) NOTHING (Date 9 1 2026) EQUALS JUST FALSE
-- no consent, the eighth day has passed: barred
#ASSERT `s 477.2(1) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE FALSE TRUE `by indictment` (Date 1 1 2026) NOTHING (Date 10 1 2026) EQUALS JUST TRUE
-- summary conviction: (1.1) says subsection (1) does not apply
#ASSERT `s 477.2(1) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE FALSE TRUE `on summary conviction` (Date 1 1 2026) NOTHING (Date 20 1 2026) EQUALS JUST FALSE
-- a Canadian citizen: the "if" is unmet
#ASSERT `s 477.2(1) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE TRUE TRUE `by indictment` (Date 1 1 2026) NOTHING (Date 20 1 2026) EQUALS JUST FALSE
-- not on board a ship registered outside Canada: the "if" is unmet
#ASSERT `s 477.2(1) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE FALSE FALSE `by indictment` (Date 1 1 2026) NOTHING (Date 20 1 2026) EQUALS JUST FALSE
-- not in or on the territorial sea: the subsection does not speak
#ASSERT `s 477.2(1) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` FALSE FALSE TRUE `by indictment` (Date 1 1 2026) NOTHING (Date 20 1 2026) EQUALS NOTHING

-- (2): arguments: the courts have jurisdiction by virtue only of 477.1(a) or (b); citizen; foreign ship; commenced; consent; as-at.
#ASSERT `s 477.2(2) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE FALSE TRUE (Date 1 1 2026) (JUST (Date 9 1 2026)) (Date 20 1 2026) EQUALS JUST FALSE
#ASSERT `s 477.2(2) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE FALSE TRUE (Date 1 1 2026) (JUST (Date 10 1 2026)) (Date 20 1 2026) EQUALS JUST TRUE
#ASSERT `s 477.2(2) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE FALSE TRUE (Date 1 1 2026) NOTHING (Date 10 1 2026) EQUALS JUST TRUE
#ASSERT `s 477.2(2) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE FALSE TRUE (Date 1 1 2026) NOTHING (Date 9 1 2026) EQUALS JUST FALSE
#ASSERT `s 477.2(2) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE TRUE TRUE (Date 1 1 2026) NOTHING (Date 20 1 2026) EQUALS JUST FALSE
#ASSERT `s 477.2(2) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE FALSE FALSE (Date 1 1 2026) NOTHING (Date 20 1 2026) EQUALS JUST FALSE
#ASSERT `s 477.2(2) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` FALSE FALSE TRUE (Date 1 1 2026) NOTHING (Date 20 1 2026) EQUALS NOTHING

-- (3): arguments: the courts have jurisdiction by virtue only of 477.1(d) or (e); commenced; consent; as-at. No condition on the accused or the ship.
#ASSERT `s 477.2(3) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE (Date 1 1 2026) (JUST (Date 9 1 2026)) (Date 20 1 2026) EQUALS JUST FALSE
#ASSERT `s 477.2(3) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE (Date 1 1 2026) (JUST (Date 10 1 2026)) (Date 20 1 2026) EQUALS JUST TRUE
#ASSERT `s 477.2(3) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE (Date 1 1 2026) NOTHING (Date 10 1 2026) EQUALS JUST TRUE
#ASSERT `s 477.2(3) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` TRUE (Date 1 1 2026) NOTHING (Date 9 1 2026) EQUALS JUST FALSE
#ASSERT `s 477.2(3) the proceedings are barred from being continued for want of the consent of the Attorney General of Canada` FALSE (Date 1 1 2026) NOTHING (Date 20 1 2026) EQUALS NOTHING

-- (4): the consent required by (1), (2) or (3) is filed with the clerk of the court in which the proceedings were instituted.
#ASSERT `s 477.2(4) the consent has been filed as the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 477.2(4) the consent has been filed as the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 477.2(4) the consent has been filed as the subsection requires` FALSE FALSE EQUALS NOTHING
#ASSERT `s 477.2(4) the consent has been filed as the subsection requires` FALSE TRUE EQUALS NOTHING

§ `Tests for section 477.3`

-- 477.3(1): arguments: the power is of the kind; the act or omission is one referred to in 477.1; hot pursuit has been commenced; the place.
#ASSERT `s 477.3(1) the power may be exercised at the place` TRUE (JUST TRUE) FALSE `s 477.3(1)(a) the place where the act or omission occurred` EQUALS JUST TRUE
#ASSERT `s 477.3(1) the power may be exercised at the place` TRUE (JUST TRUE) FALSE `s 477.3(1)(a) on board the ship or marine installation or structure where the act or omission occurred` EQUALS JUST TRUE
-- (b): where hot pursuit has been commenced, at any place on the seas other than another state's territorial sea
#ASSERT `s 477.3(1) the power may be exercised at the place` TRUE (JUST TRUE) TRUE `s 477.3(1)(b) a place on the seas that is not part of the territorial sea of any other state` EQUALS JUST TRUE
#ASSERT `s 477.3(1) the power may be exercised at the place` TRUE (JUST TRUE) FALSE `s 477.3(1)(b) a place on the seas that is not part of the territorial sea of any other state` EQUALS NOTHING
#ASSERT `s 477.3(1) the power may be exercised at the place` TRUE (JUST TRUE) TRUE `s 477.3(1)(b) a place on the seas that is part of the territorial sea of any other state` EQUALS JUST FALSE
#ASSERT `s 477.3(1) the power may be exercised at the place` TRUE (JUST TRUE) FALSE `s 477.3(1)(b) a place on the seas that is part of the territorial sea of any other state` EQUALS NOTHING
-- another place
#ASSERT `s 477.3(1) the power may be exercised at the place` TRUE (JUST TRUE) TRUE `s 477.3(1) another place` EQUALS NOTHING
-- not a power of the kind, or not in the circumstances of section 477.1
#ASSERT `s 477.3(1) the power may be exercised at the place` FALSE (JUST TRUE) FALSE `s 477.3(1)(a) the place where the act or omission occurred` EQUALS NOTHING
#ASSERT `s 477.3(1) the power may be exercised at the place` TRUE (JUST FALSE) FALSE `s 477.3(1)(a) the place where the act or omission occurred` EQUALS NOTHING
#ASSERT `s 477.3(1) the power may be exercised at the place` TRUE NOTHING FALSE `s 477.3(1)(a) the place where the act or omission occurred` EQUALS NOTHING

-- 477.3(2): arguments: the person is a justice or judge (s 2); the matter is an arrest, entry, search, seizure, investigation or ancillary matter; the offence is in or on the territorial sea or internal waters; it is one referred to in 477.1.
#ASSERT `s 477.3(2) a justice or judge in any territorial division in Canada has jurisdiction to authorize the matter` (JUST TRUE) TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 477.3(2) a justice or judge in any territorial division in Canada has jurisdiction to authorize the matter` (JUST TRUE) TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 477.3(2) a justice or judge in any territorial division in Canada has jurisdiction to authorize the matter` (JUST TRUE) TRUE FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 477.3(2) a justice or judge in any territorial division in Canada has jurisdiction to authorize the matter` (JUST TRUE) TRUE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 477.3(2) a justice or judge in any territorial division in Canada has jurisdiction to authorize the matter` (JUST TRUE) FALSE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 477.3(2) a justice or judge in any territorial division in Canada has jurisdiction to authorize the matter` (JUST FALSE) TRUE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 477.3(2) a justice or judge in any territorial division in Canada has jurisdiction to authorize the matter` NOTHING TRUE TRUE (JUST TRUE) EQUALS NOTHING

-- 477.3(3): arguments: an offence by virtue only of 477.1; alleged on board a ship registered outside Canada; the powers are to be exercised outside Canada; the Attorney General of Canada has consented.
#ASSERT `s 477.3(3) the powers are barred from being exercised outside Canada without the consent of the Attorney General of Canada` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- with the consent: outside the limit "without the consent": not covered
#ASSERT `s 477.3(3) the powers are barred from being exercised outside Canada without the consent of the Attorney General of Canada` TRUE TRUE TRUE TRUE EQUALS NOTHING
-- powers exercised in Canada
#ASSERT `s 477.3(3) the powers are barred from being exercised outside Canada without the consent of the Attorney General of Canada` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- "where" unmet: not only by virtue of 477.1, or not on a ship registered outside Canada
#ASSERT `s 477.3(3) the powers are barred from being exercised outside Canada without the consent of the Attorney General of Canada` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 477.3(3) the powers are barred from being exercised outside Canada without the consent of the Attorney General of Canada` TRUE FALSE TRUE FALSE EQUALS JUST FALSE

§ `Tests for section 477.4`

#ASSERT `s 477.4(1) and (2) as the text shows them` EQUALS "477.4 (1) and (2) [Repealed, 1996, c. 31, s. 71]"
-- Certificates: arguments are the kind, a statement that the location was in an area of a fishing zone of Canada not within internal waters or the territorial sea, a statement that it was outside the territory of any state.
`s 477.4 test: Oceans Act certificate` MEANS `s 477.4(3) facts of the certificate` OF `s 477.4(3)(a) a certificate referred to in subsection 23(1) of the Oceans Act`, FALSE, FALSE
`s 477.4 test: Minister certificate with a fishing-zone statement` MEANS `s 477.4(3) facts of the certificate` OF `s 477.4(3)(b) a certificate issued by or under the authority of the Minister of Foreign Affairs`, TRUE, FALSE
`s 477.4 test: Minister certificate with an outside-any-state statement` MEANS `s 477.4(3) facts of the certificate` OF `s 477.4(3)(b) a certificate issued by or under the authority of the Minister of Foreign Affairs`, FALSE, TRUE
`s 477.4 test: Minister certificate with neither statement` MEANS `s 477.4(3) facts of the certificate` OF `s 477.4(3)(b) a certificate issued by or under the authority of the Minister of Foreign Affairs`, FALSE, FALSE
`s 477.4 test: another certificate` MEANS `s 477.4(3) facts of the certificate` OF `s 477.4(3) a certificate of another kind`, TRUE, TRUE

#ASSERT `s 477.4(3) the certificate is one referred to in subsection (3)` `s 477.4 test: Oceans Act certificate` EQUALS JUST TRUE
#ASSERT `s 477.4(3) the certificate is one referred to in subsection (3)` `s 477.4 test: Minister certificate with a fishing-zone statement` EQUALS JUST TRUE
#ASSERT `s 477.4(3) the certificate is one referred to in subsection (3)` `s 477.4 test: Minister certificate with an outside-any-state statement` EQUALS JUST TRUE
-- a Minister's certificate that does not contain the statement the paragraph describes
#ASSERT `s 477.4(3) the certificate is one referred to in subsection (3)` `s 477.4 test: Minister certificate with neither statement` EQUALS NOTHING
-- a certificate of another kind, whatever it says
#ASSERT `s 477.4(3) the certificate is one referred to in subsection (3)` `s 477.4 test: another certificate` EQUALS NOTHING
-- conclusive proof: arguments are the answer of the function above, and whether the proceedings are in respect of an offence
#ASSERT `s 477.4(3) the certificate is conclusive proof of the truth of the statement without proof of the signature or official character of the person appearing to have issued it` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 477.4(3) the certificate is conclusive proof of the truth of the statement without proof of the signature or official character of the person appearing to have issued it` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 477.4(3) the certificate is conclusive proof of the truth of the statement without proof of the signature or official character of the person appearing to have issued it` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 477.4(3) the certificate is conclusive proof of the truth of the statement without proof of the signature or official character of the person appearing to have issued it` (JUST FALSE) TRUE EQUALS NOTHING
-- (4): admissible, but its production cannot be compelled
#ASSERT `s 477.4(4) the certificate is admissible in evidence in the proceedings` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 477.4(4) the certificate is admissible in evidence in the proceedings` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 477.4(4) the certificate is admissible in evidence in the proceedings` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 477.4(4) the production of the certificate cannot be compelled` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 477.4(4) the production of the certificate cannot be compelled` NOTHING EQUALS NOTHING
#ASSERT `s 477.4(4) the production of the certificate cannot be compelled` (JUST FALSE) EQUALS NOTHING
