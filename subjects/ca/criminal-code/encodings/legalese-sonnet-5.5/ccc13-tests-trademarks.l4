IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc13-trademarks`
IMPORT `ccc13-tests-support`

-- ccc13-tests-trademarks.l4 -- tests of ccc13-trademarks.l4 (ss 406 to 414). Expected values are decided from the text.

`ccc13 test the hybrid class` MEANS `an offence that the section makes both indictable and punishable on summary conviction`

§ `s 406 forging trademark`
-- inputs: without the consent of the proprietor; makes or reproduces the trademark or a mark so nearly resembling it; falsifies a genuine trademark
#ASSERT `s 406 the person forges a trademark` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 406 the person forges a trademark` FALSE FALSE TRUE EQUALS JUST TRUE       -- (b) falsifies a genuine trademark: no consent element
#ASSERT `s 406 the person forges a trademark` FALSE TRUE FALSE EQUALS JUST FALSE      -- the proprietor consented
#ASSERT `s 406 the person forges a trademark` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 406 the person forges a trademark` FALSE FALSE FALSE EQUALS JUST FALSE

§ `s 407 the offence of forging a trademark`
#ASSERT `s 407 the conduct is the offence of forging a trademark` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 407 the conduct is the offence of forging a trademark` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 407 the conduct is the offence of forging a trademark` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 407 the conduct is the offence of forging a trademark` FALSE (JUST TRUE) EQUALS JUST FALSE      -- no intent to deceive or defraud

§ `s 408 passing off`
-- inputs: intent to deceive or defraud; (a) passes off; (b) uses a false description; the description concerns kind, origin or manner of production
#ASSERT `s 408 the conduct is the offence of passing off` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 408 the conduct is the offence of passing off` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 408 the conduct is the offence of passing off` TRUE FALSE TRUE FALSE EQUALS JUST FALSE      -- a false description of something other than (i), (ii) or (iii)
#ASSERT `s 408 the conduct is the offence of passing off` FALSE TRUE TRUE TRUE EQUALS JUST FALSE        -- no intent
#ASSERT `s 408 the conduct is the offence of passing off` TRUE FALSE FALSE FALSE EQUALS JUST FALSE

§ `s 409 instruments for forging trademark`
#ASSERT `s 409(2) the person is saved from conviction of an offence under section 409` TRUE EQUALS JUST TRUE
#ASSERT `s 409(2) the person is saved from conviction of an offence under section 409` FALSE EQUALS JUST FALSE      -- this section gives no defence on these facts
-- inputs of (1): makes, has or disposes of an instrument; designed or intended for forging a trademark; the defence of (2)
#ASSERT `s 409(1) the conduct is the offence of having an instrument for forging a trademark` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 409(1) the conduct is the offence of having an instrument for forging a trademark` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE      -- saved: good faith in the ordinary course of business or employment
#ASSERT `s 409(1) the conduct is the offence of having an instrument for forging a trademark` TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 409(1) the conduct is the offence of having an instrument for forging a trademark` FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 409(1) the conduct is the offence of having an instrument for forging a trademark` TRUE FALSE (JUST FALSE) EQUALS JUST FALSE

§ `s 410 other offences in relation to trademarks`
-- inputs: intent to deceive or defraud; (a) defaces, conceals or removes; (b) manufacturer, dealer, trader or bottler fills a bottle; without the consent of that other person
#ASSERT `s 410 the conduct is the offence of other offences in relation to trademarks` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 410 the conduct is the offence of other offences in relation to trademarks` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 410 the conduct is the offence of other offences in relation to trademarks` FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 410 the conduct is the offence of other offences in relation to trademarks` TRUE TRUE FALSE FALSE EQUALS JUST FALSE      -- the other person consented
#ASSERT `s 410 the conduct is the offence of other offences in relation to trademarks` TRUE FALSE FALSE TRUE EQUALS JUST FALSE

§ `s 411 used goods sold without disclosure`
-- inputs: sells, exposes, possesses for sale or advertises; the things are goods (s 379); used, reconditioned or remade; bear another's trademark or trade-name; full disclosure made
#ASSERT `s 411 the conduct is the offence of selling used goods without disclosure` TRUE (JUST TRUE) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 411 the conduct is the offence of selling used goods without disclosure` TRUE (JUST TRUE) TRUE TRUE TRUE EQUALS JUST FALSE      -- full disclosure was made
#ASSERT `s 411 the conduct is the offence of selling used goods without disclosure` TRUE (JUST FALSE) TRUE TRUE FALSE EQUALS JUST FALSE    -- not goods: "means" in section 379
#ASSERT `s 411 the conduct is the offence of selling used goods without disclosure` TRUE NOTHING TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 411 the conduct is the offence of selling used goods without disclosure` FALSE (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 411 the conduct is the offence of selling used goods without disclosure` TRUE (JUST TRUE) FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 411 the conduct is the offence of selling used goods without disclosure` TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE

§ `s 412 punishment and forfeiture`
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test the limbs of the answer` (`s 412(1) the punishments` (`ccc13 test the provision` 407 "") `ccc13 test p787`)) EQUALS `imprisonment for a term of` `two years`
#ASSERT `ccc13 test the number of limbs` (`ccc13 test the limbs of the answer` (`s 412(1) the punishments` (`ccc13 test the provision` 408 "") `ccc13 test p787`)) EQUALS 2
#ASSERT `ccc13 test the number of limbs` (`ccc13 test the limbs of the answer` (`s 412(1) the punishments` (`ccc13 test the provision` 409 "(1)") `ccc13 test p787`)) EQUALS 2
#ASSERT `ccc13 test the number of limbs` (`ccc13 test the limbs of the answer` (`s 412(1) the punishments` (`ccc13 test the provision` 410 "") `ccc13 test p787`)) EQUALS 2
#ASSERT `ccc13 test the summary limb is the s 787(1) stand-in` (`ccc13 test the limbs of the answer` (`s 412(1) the punishments` (`ccc13 test the provision` 411 "") `ccc13 test p787`)) EQUALS TRUE
#ASSERT `s 412(1) the punishments` (`ccc13 test the provision` 406 "") `ccc13 test p787` EQUALS NOTHING        -- section 406 only says who forges a trademark
#ASSERT `s 412(1) the punishments` (`ccc13 test the provision` 412 "(1)") `ccc13 test p787` EQUALS NOTHING
#ASSERT `s 412(1) the punishments` (`ccc13 test the provision` 411.1 "") `ccc13 test p787` EQUALS NOTHING
#ASSERT `s 412(1) the class of the offence` (`ccc13 test the provision` 409 "(1)") EQUALS JUST `ccc13 test the hybrid class`
#ASSERT `s 412(1) the class of the offence` (`ccc13 test the provision` 406 "") EQUALS NOTHING
-- inputs of (2): the offence; the thing is something by means of or in relation to which the offence is committed; convicted of that offence; the court otherwise orders
#ASSERT `s 412(2) the thing is forfeited` (`ccc13 test the provision` 409 "(1)") TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 412(2) the thing is forfeited` (`ccc13 test the provision` 411 "") TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 412(2) the thing is forfeited` (`ccc13 test the provision` 409 "(1)") TRUE TRUE TRUE EQUALS JUST FALSE        -- "unless the court otherwise orders"
#ASSERT `s 412(2) the thing is forfeited` (`ccc13 test the provision` 409 "(1)") TRUE FALSE FALSE EQUALS JUST FALSE      -- not convicted
#ASSERT `s 412(2) the thing is forfeited` (`ccc13 test the provision` 409 "(1)") FALSE TRUE FALSE EQUALS JUST FALSE      -- not a thing by means of or in relation to which the offence is committed
#ASSERT `s 412(2) the thing is forfeited` (`ccc13 test the provision` 406 "") TRUE TRUE FALSE EQUALS NOTHING             -- section 406 is not among the five

§ `s 413 and s 414`
#ASSERT `s 413 as the text shows it` EQUALS "413 [Repealed, 2018, c. 29, s. 47]"
#ASSERT `s 414 the evidence is proof that the goods were made or produced in the country from which they were shipped` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 414 the evidence is proof that the goods were made or produced in the country from which they were shipped` FALSE TRUE FALSE EQUALS JUST FALSE      -- not proceedings under this Part about imported goods
#ASSERT `s 414 the evidence is proof that the goods were made or produced in the country from which they were shipped` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 414 the evidence is proof that the goods were made or produced in the country from which they were shipped` TRUE TRUE TRUE EQUALS JUST FALSE        -- evidence to the contrary
