IMPORT `ccc4-s109-110-3-prohibition-orders`

-- ccc4-tests-s109-110-3.l4 -- tests of ccc4-s109-110-3-prohibition-orders.l4 (sections 109 to 110.3 of the Criminal Code, Canada).
-- Generated by work/gentests.py from work/tests/t_s109_110_3.py.  Every expected value is written by hand from the text, beside the case, before the run.
-- Abbreviations in the case descriptions: "T" = JUST TRUE, "F" = JUST FALSE, "N" = NOTHING (not covered).
-- A DEONTIC value cannot be asserted on the stable binary (it is not EQUALS-comparable); the regulative rules are run with #TRACE at the end of this file and their outcomes recorded in NOTES.md.

§ `Section 109 -- Mandatory prohibition order`

§§ `Section 109(1)`

-- `s 109(1) the offence is an indictable offence`
-- inputs, in the order of the GIVEN:
--   1. the class of the offence, by the section that creates it (`Class of offence`)
--   2. the mode of proceeding (`Mode of proceeding`)
#ASSERT `s 109(1) the offence is an indictable offence` `an indictable offence` `by indictment` EQUALS JUST TRUE   -- an offence the section makes indictable
#ASSERT `s 109(1) the offence is an indictable offence` `an indictable offence` `on summary conviction` EQUALS JUST TRUE   -- an indictable offence (the mode of proceeding is not consulted)
#ASSERT `s 109(1) the offence is an indictable offence` `an offence punishable on summary conviction` `on summary conviction` EQUALS JUST FALSE   -- an offence punishable on summary conviction only
#ASSERT `s 109(1) the offence is an indictable offence` `an offence that the section makes both indictable and punishable on summary conviction` `by indictment` EQUALS JUST TRUE   -- an offence both indictable and punishable on summary conviction, prosecuted by indictment (reading A of fork F-hybrid)
#ASSERT `s 109(1) the offence is an indictable offence` `an offence that the section makes both indictable and punishable on summary conviction` `on summary conviction` EQUALS NOTHING   -- an offence both indictable and punishable on summary conviction, prosecuted on summary conviction: the text does not say

-- `s 109(1)(a) the maximum imprisonment is ten years or more`
-- inputs, in the order of the GIVEN:
--   1. the maximum imprisonment the person may be sentenced to for the offence (Imprisonment)
#ASSERT `s 109(1)(a) the maximum imprisonment is ten years or more` `imprisonment for life` EQUALS JUST TRUE   -- imprisonment for life
#ASSERT `s 109(1)(a) the maximum imprisonment is ten years or more` (`imprisonment for a term of` (`Length of time` OF 14, 0, 0, FALSE)) EQUALS JUST TRUE   -- fourteen years
#ASSERT `s 109(1)(a) the maximum imprisonment is ten years or more` (`imprisonment for a term of` (`Length of time` OF 10, 0, 0, FALSE)) EQUALS JUST TRUE   -- ten years exactly: "ten years or more"
#ASSERT `s 109(1)(a) the maximum imprisonment is ten years or more` (`imprisonment for a term of` (`Length of time` OF 10, 0, 0, TRUE)) EQUALS JUST FALSE   -- ten years less a day
#ASSERT `s 109(1)(a) the maximum imprisonment is ten years or more` (`imprisonment for a term of` (`Length of time` OF 9, 11, 0, FALSE)) EQUALS JUST FALSE   -- nine years and eleven months
#ASSERT `s 109(1)(a) the maximum imprisonment is ten years or more` (`imprisonment for a term of` (`Length of time` OF 10, 0, 1, FALSE)) EQUALS JUST TRUE   -- ten years and one day
#ASSERT `s 109(1)(a) the maximum imprisonment is ten years or more` (`imprisonment for a term of` (`Length of time` OF 10, 1, 0, FALSE)) EQUALS JUST TRUE   -- ten years and one month
#ASSERT `s 109(1)(a) the maximum imprisonment is ten years or more` (`imprisonment for a term of` (`Length of time` OF 11, 0, 0, FALSE)) EQUALS JUST TRUE   -- eleven years
#ASSERT `s 109(1)(a) the maximum imprisonment is ten years or more` (`imprisonment for a term of` (`Length of time` OF 5, 0, 0, FALSE)) EQUALS JUST FALSE   -- five years
#ASSERT `s 109(1)(a) the maximum imprisonment is ten years or more` (`imprisonment for a term of` (`Length of time` OF 2, 0, 0, TRUE)) EQUALS JUST FALSE   -- two years less a day
#ASSERT `s 109(1)(a) the maximum imprisonment is ten years or more` `no imprisonment is stated` EQUALS NOTHING   -- no imprisonment is stated

-- `s 109(1)(a) the offence is one in which violence was used and for which the person may be sentenced to imprisonment for ten years or more`
-- inputs, in the order of the GIVEN:
--   1. s 109(1) the offence is an indictable offence (MAYBE BOOLEAN)
--   2. violence against a person was used, threatened or attempted in the commission of the offence (BOOLEAN)
--   3. s 3.01(1) the offence counts as an offence in the commission of which violence is used, threatened or attempted against any person or class of persons (MAYBE BOOLEAN)
--   4. s 109(1)(a) the maximum imprisonment is ten years or more (MAYBE BOOLEAN)
#ASSERT `s 109(1)(a) the offence is one in which violence was used and for which the person may be sentenced to imprisonment for ten years or more` (JUST TRUE) TRUE NOTHING (JUST TRUE) EQUALS JUST TRUE   -- an indictable offence with violence, maximum ten years or more
#ASSERT `s 109(1)(a) the offence is one in which violence was used and for which the person may be sentenced to imprisonment for ten years or more` (JUST FALSE) TRUE NOTHING (JUST TRUE) EQUALS JUST FALSE   -- not an indictable offence
#ASSERT `s 109(1)(a) the offence is one in which violence was used and for which the person may be sentenced to imprisonment for ten years or more` (JUST TRUE) FALSE NOTHING (JUST TRUE) EQUALS NOTHING   -- no violence, and section 3.01 does not say either way
#ASSERT `s 109(1)(a) the offence is one in which violence was used and for which the person may be sentenced to imprisonment for ten years or more` (JUST TRUE) FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE   -- no violence, but section 3.01(1) counts the offence as one in which violence is used (a sexual offence)
#ASSERT `s 109(1)(a) the offence is one in which violence was used and for which the person may be sentenced to imprisonment for ten years or more` (JUST TRUE) FALSE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE   -- no violence and section 3.01(1) does not count it
#ASSERT `s 109(1)(a) the offence is one in which violence was used and for which the person may be sentenced to imprisonment for ten years or more` (JUST TRUE) TRUE NOTHING (JUST FALSE) EQUALS JUST FALSE   -- maximum below ten years
#ASSERT `s 109(1)(a) the offence is one in which violence was used and for which the person may be sentenced to imprisonment for ten years or more` (JUST TRUE) TRUE NOTHING NOTHING EQUALS NOTHING   -- whether the maximum is ten years or more is not covered
#ASSERT `s 109(1)(a) the offence is one in which violence was used and for which the person may be sentenced to imprisonment for ten years or more` NOTHING TRUE NOTHING (JUST TRUE) EQUALS NOTHING   -- whether it is an indictable offence is not covered
#ASSERT `s 109(1)(a) the offence is one in which violence was used and for which the person may be sentenced to imprisonment for ten years or more` (JUST FALSE) TRUE NOTHING NOTHING EQUALS JUST FALSE   -- not indictable and maximum not known: the "no" outweighs

-- `s 109(1)(a.1) the offence is one in which violence was used against an intimate partner, a child or parent, or a person who resides with them`
-- inputs, in the order of the GIVEN:
--   1. s 109(1) the offence is an indictable offence (MAYBE BOOLEAN)
--   2. violence against a person was used, threatened or attempted in the commission of the offence (BOOLEAN)
--   3. s 3.01(1) the offence counts as an offence in the commission of which violence is used, threatened or attempted against any person or class of persons (MAYBE BOOLEAN)
--   4. s 2 intimate partner: the person against whom the violence was used, threatened or attempted is the person’s intimate partner (MAYBE BOOLEAN)
--   5. the person against whom the violence was used, threatened or attempted is a child or parent of the person or of the person’s intimate partner (BOOLEAN)
--   6. the person against whom the violence was used, threatened or attempted resides with the person or with the person’s intimate partner, child or parent (BOOLEAN)
#ASSERT `s 109(1)(a.1) the offence is one in which violence was used against an intimate partner, a child or parent, or a person who resides with them` (JUST TRUE) TRUE NOTHING (JUST TRUE) FALSE FALSE EQUALS JUST TRUE   -- (i) violence against the intimate partner
#ASSERT `s 109(1)(a.1) the offence is one in which violence was used against an intimate partner, a child or parent, or a person who resides with them` (JUST TRUE) TRUE NOTHING (JUST FALSE) TRUE FALSE EQUALS JUST TRUE   -- (ii) violence against a child or parent
#ASSERT `s 109(1)(a.1) the offence is one in which violence was used against an intimate partner, a child or parent, or a person who resides with them` (JUST TRUE) TRUE NOTHING (JUST FALSE) FALSE TRUE EQUALS JUST TRUE   -- (iii) violence against a person who resides with them
#ASSERT `s 109(1)(a.1) the offence is one in which violence was used against an intimate partner, a child or parent, or a person who resides with them` (JUST TRUE) TRUE NOTHING (JUST FALSE) FALSE FALSE EQUALS JUST FALSE   -- violence against none of those
#ASSERT `s 109(1)(a.1) the offence is one in which violence was used against an intimate partner, a child or parent, or a person who resides with them` (JUST TRUE) TRUE NOTHING NOTHING FALSE FALSE EQUALS NOTHING   -- whether the victim is the intimate partner is not covered, and no other relation
#ASSERT `s 109(1)(a.1) the offence is one in which violence was used against an intimate partner, a child or parent, or a person who resides with them` (JUST FALSE) TRUE NOTHING (JUST TRUE) FALSE FALSE EQUALS JUST FALSE   -- not an indictable offence
#ASSERT `s 109(1)(a.1) the offence is one in which violence was used against an intimate partner, a child or parent, or a person who resides with them` (JUST TRUE) FALSE NOTHING (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- no violence and section 3.01(1) not covered: whether violence counts is not covered
#ASSERT `s 109(1)(a.1) the offence is one in which violence was used against an intimate partner, a child or parent, or a person who resides with them` (JUST TRUE) FALSE (JUST TRUE) (JUST TRUE) FALSE FALSE EQUALS JUST TRUE   -- no violence but section 3.01(1) counts the offence, against an intimate partner
#ASSERT `s 109(1)(a.1) the offence is one in which violence was used against an intimate partner, a child or parent, or a person who resides with them` (JUST TRUE) FALSE (JUST FALSE) (JUST TRUE) FALSE FALSE EQUALS JUST FALSE   -- no violence and section 3.01(1) does not count it

