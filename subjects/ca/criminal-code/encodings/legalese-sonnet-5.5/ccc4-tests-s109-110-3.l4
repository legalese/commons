-- `s 109(1)(d) the offence involves a thing the person was prohibited from possessing`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing (`s 84(1) kind of thing`)
--   2. the offence involves, or its subject-matter is, that thing (BOOLEAN)
--   3. at the time of the offence the person was prohibited by an order made under this Act or any other Act of Parliament from possessing any such thing (BOOLEAN)
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: a prohibited firearm` TRUE TRUE EQUALS JUST TRUE   -- the offence involves a prohibited firearm and the person was prohibited
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: a restricted firearm` TRUE TRUE EQUALS JUST TRUE   -- the offence involves a restricted firearm and the person was prohibited
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: a non-restricted firearm` TRUE TRUE EQUALS JUST TRUE   -- the offence involves a non-restricted firearm and the person was prohibited
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: a prohibited weapon` TRUE TRUE EQUALS JUST TRUE   -- the offence involves a prohibited weapon and the person was prohibited
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: a restricted weapon` TRUE TRUE EQUALS JUST TRUE   -- the offence involves a restricted weapon and the person was prohibited
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: a replica firearm` TRUE TRUE EQUALS JUST TRUE   -- the offence involves a replica firearm and the person was prohibited
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: a prohibited device other than a replica firearm` TRUE TRUE EQUALS JUST TRUE   -- the offence involves a prohibited device other than a replica firearm and the person was prohibited
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: a firearm part` TRUE TRUE EQUALS JUST TRUE   -- the offence involves a firearm part and the person was prohibited
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: ammunition other than prohibited ammunition` TRUE TRUE EQUALS JUST TRUE   -- the offence involves a ammunition other than prohibited ammunition and the person was prohibited
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: prohibited ammunition` TRUE TRUE EQUALS JUST TRUE   -- the offence involves a prohibited ammunition and the person was prohibited
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: a cross-bow` TRUE TRUE EQUALS JUST TRUE   -- the offence involves a cross-bow and the person was prohibited
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: an explosive substance` TRUE TRUE EQUALS JUST TRUE   -- the offence involves a explosive substance and the person was prohibited
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: a thing that is none of those` TRUE TRUE EQUALS JUST FALSE   -- a thing that is none of the classes
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: a prohibited firearm` FALSE TRUE EQUALS JUST FALSE   -- the offence does not involve the thing and is not about it
#ASSERT `s 109(1)(d) the offence involves a thing the person was prohibited from possessing` `s 84(1) kind: a prohibited firearm` TRUE FALSE EQUALS JUST FALSE   -- the person was not prohibited at the time of the offence

-- `s 109(1) the offence is referred to in any of paragraphs (a) to (c.1)`
-- inputs, in the order of the GIVEN:
--   1. s 109(1)(a) the offence is one in which violence was used and for which the person may be sentenced to imprisonment for ten years or more (MAYBE BOOLEAN)
--   2. s 109(1)(a.1) the offence is one in which violence was used against an intimate partner, a child or parent, or a person who resides with them (MAYBE BOOLEAN)
--   3. s 109(1)(b) the offence is one of those the paragraph names (MAYBE BOOLEAN)
--   4. s 109(1)(c) the offence relates to the contravention of a subsection of the Controlled Drugs and Substances Act that the paragraph names (MAYBE BOOLEAN)
--   5. s 109(1)(c.1) the offence relates to the contravention of a subsection of the Cannabis Act that the paragraph names (MAYBE BOOLEAN)
#ASSERT `s 109(1) the offence is referred to in any of paragraphs (a) to (c.1)` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- none of them
#ASSERT `s 109(1) the offence is referred to in any of paragraphs (a) to (c.1)` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- paragraph (a) holds
#ASSERT `s 109(1) the offence is referred to in any of paragraphs (a) to (c.1)` (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- paragraph (a.1) holds
#ASSERT `s 109(1) the offence is referred to in any of paragraphs (a) to (c.1)` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- paragraph (b) holds
#ASSERT `s 109(1) the offence is referred to in any of paragraphs (a) to (c.1)` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- paragraph (c) holds
#ASSERT `s 109(1) the offence is referred to in any of paragraphs (a) to (c.1)` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE   -- paragraph (c.1) holds
#ASSERT `s 109(1) the offence is referred to in any of paragraphs (a) to (c.1)` (JUST FALSE) (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING   -- one is not covered and none holds
#ASSERT `s 109(1) the offence is referred to in any of paragraphs (a) to (c.1)` (JUST TRUE) (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE   -- one holds and one is not covered

-- `s 109(1) the court must make a prohibition order`
-- inputs, in the order of the GIVEN:
--   1. how the person comes before the court for sentence (`s 109(1) how the person comes before the court for sentence`)
--   2. s 109(1) the offence is referred to in any of paragraphs (a) to (c.1) (MAYBE BOOLEAN)
--   3. s 109(1)(d) the offence involves a thing the person was prohibited from possessing (MAYBE BOOLEAN)
#ASSERT `s 109(1) the court must make a prohibition order` `s 109(1) the person is convicted` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- convicted of an offence referred to in (a) to (c.1)
#ASSERT `s 109(1) the court must make a prohibition order` `s 109(1) the person is discharged under section 730` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE   -- discharged under section 730 of an offence referred to in (a) to (c.1)
#ASSERT `s 109(1) the court must make a prohibition order` `s 109(1) the person is convicted` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE   -- convicted of an offence within paragraph (d)
#ASSERT `s 109(1) the court must make a prohibition order` `s 109(1) the person is neither convicted nor discharged under section 730` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE   -- neither convicted nor discharged: "Where a person is convicted, or discharged under section 730"
#ASSERT `s 109(1) the court must make a prohibition order` `s 109(1) the person is convicted` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE   -- convicted of an offence within none of the paragraphs
#ASSERT `s 109(1) the court must make a prohibition order` `s 109(1) the person is convicted` NOTHING (JUST FALSE) EQUALS NOTHING   -- whether paragraphs (a) to (c.1) apply is not covered, and (d) does not apply
#ASSERT `s 109(1) the court must make a prohibition order` `s 109(1) the person is convicted` NOTHING (JUST TRUE) EQUALS JUST TRUE   -- whether (a) to (c.1) apply is not covered, and (d) applies

-- A different date in each case would not matter here; the rule has no period.
#TRACE `s 109(1) the duty of the court to make a prohibition order` TRUE AT 0 WITH
    PARTY `the court` DOES `s 109 make an order prohibiting the person from possessing any firearm, cross-bow, prohibited weapon, restricted weapon, prohibited device, firearm part, ammunition, prohibited ammunition and explosive substance` AT 4

#TRACE `s 109(1) the duty of the court to make a prohibition order` TRUE AT 0 WITH
    (WAITUNTIL 100)

#TRACE `s 109(1) the duty of the court to make a prohibition order` FALSE AT 0 WITH
    (WAITUNTIL 100)

§§ `Section 109(2) to (5)`

-- `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing (`s 84(1) kind of thing`)
--   2. it is the first conviction for or discharge from the offence to which the order relates (BOOLEAN)
--   3. the person is imprisoned or subject to imprisonment for the offence (BOOLEAN)
--   4. the day of the person’s release from imprisonment after conviction for the offence (DATE)
--   5. the day of the person’s conviction for or discharge from the offence (DATE)
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a non-restricted firearm` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 3 2030))   -- (a) a non-restricted firearm, not imprisoned: ends not earlier than ten years after the conviction or discharge
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a non-restricted firearm` TRUE TRUE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 1 2035))   -- (a) a non-restricted firearm, imprisoned: ends not earlier than ten years after release
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a cross-bow` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 3 2030))   -- (a) a cross-bow, not imprisoned: ends not earlier than ten years after the conviction or discharge
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a cross-bow` TRUE TRUE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 1 2035))   -- (a) a cross-bow, imprisoned: ends not earlier than ten years after release
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a restricted weapon` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 3 2030))   -- (a) a restricted weapon, not imprisoned: ends not earlier than ten years after the conviction or discharge
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a restricted weapon` TRUE TRUE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 1 2035))   -- (a) a restricted weapon, imprisoned: ends not earlier than ten years after release
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a firearm part` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 3 2030))   -- (a) a firearm part, not imprisoned: ends not earlier than ten years after the conviction or discharge
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a firearm part` TRUE TRUE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 1 2035))   -- (a) a firearm part, imprisoned: ends not earlier than ten years after release
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: ammunition other than prohibited ammunition` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 3 2030))   -- (a) a ammunition other than prohibited ammunition, not imprisoned: ends not earlier than ten years after the conviction or discharge
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: ammunition other than prohibited ammunition` TRUE TRUE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 1 2035))   -- (a) a ammunition other than prohibited ammunition, imprisoned: ends not earlier than ten years after release
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: an explosive substance` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 3 2030))   -- (a) a explosive substance, not imprisoned: ends not earlier than ten years after the conviction or discharge
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: an explosive substance` TRUE TRUE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 1 2035))   -- (a) a explosive substance, imprisoned: ends not earlier than ten years after release
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a prohibited firearm` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST `s 109 period: for life`  -- (b) a prohibited firearm: for life
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a restricted firearm` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST `s 109 period: for life`  -- (b) a restricted firearm: for life
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a prohibited weapon` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST `s 109 period: for life`  -- (b) a prohibited weapon: for life
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a replica firearm` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST `s 109 period: for life`  -- (b) a replica firearm: for life
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a prohibited device other than a replica firearm` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST `s 109 period: for life`  -- (b) a prohibited device other than a replica firearm: for life
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: prohibited ammunition` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST `s 109 period: for life`  -- (b) a prohibited ammunition: for life
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: prohibited ammunition` TRUE TRUE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST `s 109 period: for life`  -- (b) prohibited ammunition is also "ammunition" under (a): life satisfies the floor of (a) and (b) says for life
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a thing that is none of those` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS NOTHING   -- a thing that is none of the classes: silent
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a non-restricted firearm` FALSE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS NOTHING   -- not a first conviction or discharge: subsection (3) governs
#ASSERT `s 109(2) the period for which the order prohibits the thing, in the case of a first conviction or discharge` `s 84(1) kind: a firearm part` TRUE FALSE (Date 5 5 2040) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 3 2030))   -- a first conviction for a firearm part; the release day is not consulted if the person is not imprisoned

-- `s 109(3) the period for which the order prohibits the thing, in any other case`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing (`s 84(1) kind of thing`)
--   2. it is the first conviction for or discharge from the offence to which the order relates (BOOLEAN)
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: a prohibited firearm` FALSE EQUALS JUST `s 109 period: for life`  -- a prohibited firearm: for life
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: a restricted firearm` FALSE EQUALS JUST `s 109 period: for life`  -- a restricted firearm: for life
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: a non-restricted firearm` FALSE EQUALS JUST `s 109 period: for life`  -- a non-restricted firearm: for life
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: a cross-bow` FALSE EQUALS JUST `s 109 period: for life`  -- a cross-bow: for life
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: a restricted weapon` FALSE EQUALS JUST `s 109 period: for life`  -- a restricted weapon: for life
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: a firearm part` FALSE EQUALS JUST `s 109 period: for life`  -- a firearm part: for life
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: ammunition other than prohibited ammunition` FALSE EQUALS JUST `s 109 period: for life`  -- a ammunition other than prohibited ammunition: for life
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: an explosive substance` FALSE EQUALS JUST `s 109 period: for life`  -- a explosive substance: for life
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: prohibited ammunition` FALSE EQUALS JUST `s 109 period: for life`  -- prohibited ammunition is ammunition (section 84(1)): for life (reading A of fork F-109-ammo)
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: a prohibited weapon` FALSE EQUALS NOTHING   -- a prohibited weapon: not named in subsection (3) (Finding): the text gives no period
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: a replica firearm` FALSE EQUALS NOTHING   -- a replica firearm: not named in subsection (3) (Finding): the text gives no period
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: a prohibited device other than a replica firearm` FALSE EQUALS NOTHING   -- a prohibited device other than a replica firearm: not named in subsection (3) (Finding): the text gives no period
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: a thing that is none of those` FALSE EQUALS NOTHING   -- a thing that is none of the classes: not named in subsection (3) (Finding): the text gives no period
#ASSERT `s 109(3) the period for which the order prohibits the thing, in any other case` `s 84(1) kind: a non-restricted firearm` TRUE EQUALS NOTHING   -- a first conviction or discharge: subsection (2) governs

-- `s 109(2) and (3) the period for which the order prohibits the thing`
-- inputs, in the order of the GIVEN:
--   1. the kind of thing (`s 84(1) kind of thing`)
--   2. it is the first conviction for or discharge from the offence to which the order relates (BOOLEAN)
--   3. the person is imprisoned or subject to imprisonment for the offence (BOOLEAN)
--   4. the day of the person’s release from imprisonment after conviction for the offence (DATE)
--   5. the day of the person’s conviction for or discharge from the offence (DATE)
#ASSERT `s 109(2) and (3) the period for which the order prohibits the thing` `s 84(1) kind: a non-restricted firearm` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST (`s 109 period: ending not earlier than` (Date 1 3 2030))   -- first conviction, non-restricted firearm: subsection (2)(a)
#ASSERT `s 109(2) and (3) the period for which the order prohibits the thing` `s 84(1) kind: a prohibited firearm` TRUE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST `s 109 period: for life`  -- first conviction, prohibited firearm: subsection (2)(b), for life
#ASSERT `s 109(2) and (3) the period for which the order prohibits the thing` `s 84(1) kind: a non-restricted firearm` FALSE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS JUST `s 109 period: for life`  -- another case, non-restricted firearm: subsection (3), for life
#ASSERT `s 109(2) and (3) the period for which the order prohibits the thing` `s 84(1) kind: a prohibited weapon` FALSE FALSE (Date 1 1 2025) (Date 1 3 2020) EQUALS NOTHING   -- another case, prohibited weapon: subsection (3) names none

-- `s 109(4) release from imprisonment`
-- inputs, in the order of the GIVEN:
--   1. the release (`s 109(4) release from confinement`)
#ASSERT `s 109(4) release from imprisonment` `s 109(4) release: by reason of expiration of sentence` EQUALS JUST TRUE   -- release by reason of expiration of sentence
#ASSERT `s 109(4) release from imprisonment` `s 109(4) release: by reason of commencement of statutory release` EQUALS JUST TRUE   -- release by reason of commencement of statutory release
#ASSERT `s 109(4) release from imprisonment` `s 109(4) release: by reason of grant of parole` EQUALS JUST TRUE   -- release by reason of grant of parole
#ASSERT `s 109(4) release from imprisonment` `s 109(4) release: by reason of something else` EQUALS JUST FALSE   -- release for another reason: "means" is closed

-- `s 109(5) the section applies in respect of every order made under subsection (1)`
-- inputs, in the order of the GIVEN:
--   1. the section (`Provision of the Code`)
#ASSERT `s 109(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 113, "") EQUALS JUST TRUE   -- section 113
#ASSERT `s 109(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 114, "") EQUALS JUST TRUE   -- section 114
#ASSERT `s 109(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 115, "") EQUALS JUST TRUE   -- section 115
#ASSERT `s 109(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 116, "") EQUALS JUST TRUE   -- section 116
#ASSERT `s 109(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 117, "") EQUALS JUST TRUE   -- section 117
#ASSERT `s 109(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 112, "") EQUALS NOTHING   -- section 112 is outside "Sections 113 to 117"
#ASSERT `s 109(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 117.01, "") EQUALS NOTHING   -- section 117.01 (it is after 117) is outside "Sections 113 to 117"
#ASSERT `s 109(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 118, "") EQUALS NOTHING   -- section 118 is outside "Sections 113 to 117"
#ASSERT `s 109(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 110, "") EQUALS NOTHING   -- section 110 is outside "Sections 113 to 117"
#ASSERT `s 109(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 109, "") EQUALS NOTHING   -- section 109 is outside "Sections 113 to 117"

§ `Section 110 -- Discretionary prohibition order`

-- `s 110(1) the court must consider whether it is desirable to make a prohibition order`
-- inputs, in the order of the GIVEN:
--   1. how the person comes before the court for sentence (`s 109(1) how the person comes before the court for sentence`)
--   2. violence against a person was used, threatened or attempted in the commission of the offence (BOOLEAN)
--   3. s 3.01(1) the offence counts as an offence in the commission of which violence is used, threatened or attempted against any person or class of persons (MAYBE BOOLEAN)
--   4. s 109(1) the offence is referred to in any of paragraphs (a) to (c.1) (MAYBE BOOLEAN)
--   5. the kind of thing (`s 84(1) kind of thing`)
--   6. the offence involves, or its subject-matter is, that thing (BOOLEAN)
--   7. at the time of the offence the person was prohibited by an order made under this Act or any other Act of Parliament from possessing any such thing (BOOLEAN)
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` TRUE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a thing that is none of those` FALSE FALSE EQUALS JUST TRUE   -- (a) violence was used, and the offence is not referred to in paragraphs 109(1)(a) to (c.1)
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` TRUE (JUST FALSE) (JUST TRUE) `s 84(1) kind: a thing that is none of those` FALSE FALSE EQUALS JUST FALSE   -- (a) violence was used but the offence is referred to in 109(1)(a) to (c.1): subsection 109(1) governs
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is discharged under section 730` TRUE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a thing that is none of those` FALSE FALSE EQUALS JUST TRUE   -- (a) discharged under section 730
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST TRUE) (JUST FALSE) `s 84(1) kind: a thing that is none of those` FALSE FALSE EQUALS JUST TRUE   -- (a) no violence in fact, but section 3.01(1) counts the offence as one in which violence is used
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a thing that is none of those` FALSE FALSE EQUALS JUST FALSE   -- (a) no violence and section 3.01(1) does not count it
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` TRUE (JUST FALSE) NOTHING `s 84(1) kind: a thing that is none of those` FALSE FALSE EQUALS NOTHING   -- (a) violence was used and whether 109(1)(a) to (c.1) apply is not covered
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a prohibited firearm` TRUE FALSE EQUALS JUST TRUE   -- (b) an offence involving a firearm, the person not prohibited at the time
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a prohibited firearm` TRUE FALSE EQUALS JUST TRUE   -- (b) a prohibited firearm
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a restricted firearm` TRUE FALSE EQUALS JUST TRUE   -- (b) a restricted firearm
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a non-restricted firearm` TRUE FALSE EQUALS JUST TRUE   -- (b) a non-restricted firearm
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a prohibited weapon` TRUE FALSE EQUALS JUST TRUE   -- (b) a prohibited weapon
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a restricted weapon` TRUE FALSE EQUALS JUST TRUE   -- (b) a restricted weapon
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a replica firearm` TRUE FALSE EQUALS JUST TRUE   -- (b) a replica firearm
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a prohibited device other than a replica firearm` TRUE FALSE EQUALS JUST TRUE   -- (b) a prohibited device other than a replica firearm
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a firearm part` TRUE FALSE EQUALS JUST TRUE   -- (b) a firearm part
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: ammunition other than prohibited ammunition` TRUE FALSE EQUALS JUST TRUE   -- (b) a ammunition other than prohibited ammunition
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: prohibited ammunition` TRUE FALSE EQUALS JUST TRUE   -- (b) a prohibited ammunition
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a cross-bow` TRUE FALSE EQUALS JUST TRUE   -- (b) a cross-bow
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: an explosive substance` TRUE FALSE EQUALS JUST TRUE   -- (b) a explosive substance
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a prohibited firearm` TRUE TRUE EQUALS JUST FALSE   -- (b) the person was prohibited at the time: paragraph 109(1)(d) governs
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a prohibited firearm` FALSE FALSE EQUALS JUST FALSE   -- (b) the offence does not involve the thing
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is neither convicted nor discharged under section 730` TRUE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a thing that is none of those` FALSE FALSE EQUALS JUST FALSE   -- neither convicted nor discharged: "Where a person is convicted, or discharged under section 730"
#ASSERT `s 110(1) the court must consider whether it is desirable to make a prohibition order` `s 109(1) the person is convicted` FALSE (JUST FALSE) (JUST FALSE) `s 84(1) kind: a thing that is none of those` FALSE FALSE EQUALS JUST FALSE   -- neither paragraph (a) nor paragraph (b)

-- `s 110(1) the court must make a prohibition order`
-- inputs, in the order of the GIVEN:
--   1. s 110(1) the court must consider whether it is desirable to make a prohibition order (MAYBE BOOLEAN)
--   2. the court decides that it is so desirable, in the interests of the safety of the person or of any other person (BOOLEAN)
#ASSERT `s 110(1) the court must make a prohibition order` (JUST TRUE) TRUE EQUALS JUST TRUE   -- the court must consider and decides that it is desirable
#ASSERT `s 110(1) the court must make a prohibition order` (JUST TRUE) FALSE EQUALS JUST FALSE   -- the court decides that it is not desirable
#ASSERT `s 110(1) the court must make a prohibition order` (JUST FALSE) TRUE EQUALS JUST FALSE   -- no duty to consider arises
#ASSERT `s 110(1) the court must make a prohibition order` NOTHING TRUE EQUALS NOTHING   -- whether the duty to consider arises is not covered, and the court decides it is desirable
#ASSERT `s 110(1) the court must make a prohibition order` NOTHING FALSE EQUALS JUST FALSE   -- whether the duty to consider arises is not covered, and the court does not decide so

-- (the rule has no WITHIN: the text fixes no time)
-- the court considers, decides that it is desirable and makes the order: FULFILLED
#TRACE `s 110(1) the duty of the court to consider, and to make the order it decides is desirable` TRUE AT 0 WITH
    PARTY `the court` DOES `s 110 consider whether it is desirable to make an order prohibiting the person from possessing any firearm, cross-bow, prohibited weapon, restricted weapon, prohibited device, firearm part, ammunition, prohibited ammunition or explosive substance` AT 3
    PARTY `the court` DOES `s 110 make the order that the court decides is desirable` AT 4

-- the court considers and decides that it is desirable but does not make the order: the duty to make it stands
#TRACE `s 110(1) the duty of the court to consider, and to make the order it decides is desirable` TRUE AT 0 WITH
    PARTY `the court` DOES `s 110 consider whether it is desirable to make an order prohibiting the person from possessing any firearm, cross-bow, prohibited weapon, restricted weapon, prohibited device, firearm part, ammunition, prohibited ammunition or explosive substance` AT 3

-- the court considers and decides that it is not desirable: FULFILLED
#TRACE `s 110(1) the duty of the court to consider, and to make the order it decides is desirable` FALSE AT 0 WITH
    PARTY `the court` DOES `s 110 consider whether it is desirable to make an order prohibiting the person from possessing any firearm, cross-bow, prohibited weapon, restricted weapon, prohibited device, firearm part, ammunition, prohibited ammunition or explosive substance` AT 3

-- nothing done: the duty to consider stands
#TRACE `s 110(1) the duty of the court to consider, and to make the order it decides is desirable` FALSE AT 0 WITH
    (WAITUNTIL 100)

-- `s 110(2) the latest day on which the order may end`
-- inputs, in the order of the GIVEN:
--   1. the person is imprisoned or subject to imprisonment for the offence (BOOLEAN)
--   2. the day of the person’s release from imprisonment after conviction for the offence (DATE)
--   3. the day of the person’s conviction for or discharge from the offence (DATE)
#ASSERT `s 110(2) the latest day on which the order may end` FALSE (Date 1 1 2025) (Date 15 6 2020) EQUALS (Date 15 6 2030)   -- not imprisoned: ten years after the conviction or discharge (15 June 2020)
#ASSERT `s 110(2) the latest day on which the order may end` TRUE (Date 1 1 2025) (Date 15 6 2020) EQUALS (Date 1 1 2035)   -- imprisoned: ten years after the release (1 January 2025)
#ASSERT `s 110(2) the latest day on which the order may end` FALSE (Date 1 1 2050) (Date 15 6 2020) EQUALS (Date 15 6 2030)   -- the release day is not consulted when the person is not imprisoned
#ASSERT `s 110(2) the latest day on which the order may end` TRUE (Date 1 1 2025) (Date 1 1 2000) EQUALS (Date 1 1 2035)   -- the conviction day is not consulted when the person is imprisoned
#ASSERT `s 110(2) the latest day on which the order may end` FALSE (Date 1 1 2025) (Date 29 2 2020) EQUALS (Date 28 2 2030)   -- a conviction on 29 February 2020: daydate clamps the day to 28 February 2030 (fork F-leap)

-- `s 110(2.1) the order may be imposed for life or for any shorter duration`
-- inputs, in the order of the GIVEN:
--   1. violence against a person was used, threatened or attempted in the commission of the offence (BOOLEAN)
--   2. s 3.01(1) the offence counts as an offence in the commission of which violence is used, threatened or attempted against any person or class of persons (MAYBE BOOLEAN)
--   3. s 2 intimate partner: the person against whom the violence was used, threatened or attempted is the person’s intimate partner (MAYBE BOOLEAN)
--   4. the person against whom the violence was used, threatened or attempted is a child or parent of the person or of the person’s intimate partner (BOOLEAN)
--   5. the person against whom the violence was used, threatened or attempted resides with the person or with the person’s intimate partner, child or parent (BOOLEAN)
#ASSERT `s 110(2.1) the order may be imposed for life or for any shorter duration` TRUE NOTHING (JUST TRUE) FALSE FALSE EQUALS JUST TRUE   -- violence against the intimate partner
#ASSERT `s 110(2.1) the order may be imposed for life or for any shorter duration` TRUE NOTHING (JUST FALSE) TRUE FALSE EQUALS JUST TRUE   -- violence against a child or parent
#ASSERT `s 110(2.1) the order may be imposed for life or for any shorter duration` TRUE NOTHING (JUST FALSE) FALSE TRUE EQUALS JUST TRUE   -- violence against a person who resides with them
#ASSERT `s 110(2.1) the order may be imposed for life or for any shorter duration` TRUE NOTHING (JUST FALSE) FALSE FALSE EQUALS NOTHING   -- violence against none of those: subsection (2) governs
#ASSERT `s 110(2.1) the order may be imposed for life or for any shorter duration` FALSE (JUST TRUE) (JUST TRUE) FALSE FALSE EQUALS JUST TRUE   -- violence not in fact used, but section 3.01(1) counts the offence, against an intimate partner
#ASSERT `s 110(2.1) the order may be imposed for life or for any shorter duration` FALSE (JUST FALSE) (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- no violence and section 3.01(1) does not count it
#ASSERT `s 110(2.1) the order may be imposed for life or for any shorter duration` TRUE NOTHING NOTHING FALSE FALSE EQUALS NOTHING   -- whether the victim is the intimate partner is not covered, and no other relation

-- `s 110(2) and (2.1) the longest duration of the order`
-- inputs, in the order of the GIVEN:
--   1. s 110(2.1) the order may be imposed for life or for any shorter duration (MAYBE BOOLEAN)
--   2. the person is imprisoned or subject to imprisonment for the offence (BOOLEAN)
--   3. the day of the person’s release from imprisonment after conviction for the offence (DATE)
--   4. the day of the person’s conviction for or discharge from the offence (DATE)
#ASSERT `s 110(2) and (2.1) the longest duration of the order` (JUST TRUE) FALSE (Date 1 1 2025) (Date 15 6 2020) EQUALS `s 110 duration: life or any shorter duration`  -- subsection (2.1) applies: life or any shorter duration
#ASSERT `s 110(2) and (2.1) the longest duration of the order` NOTHING FALSE (Date 1 1 2025) (Date 15 6 2020) EQUALS (`s 110 duration: ending not later than` (Date 15 6 2030))   -- subsection (2.1) does not apply: ends not later than ten years after the conviction or discharge
#ASSERT `s 110(2) and (2.1) the longest duration of the order` NOTHING TRUE (Date 1 1 2025) (Date 15 6 2020) EQUALS (`s 110 duration: ending not later than` (Date 1 1 2035))   -- subsection (2.1) does not apply, imprisoned: ten years after the release

-- `s 110(3) the court must include in the record a statement of its reasons`
-- inputs, in the order of the GIVEN:
--   1. the court does not make an order under subsection (1) (BOOLEAN)
--   2. the court makes an order under subsection (1) but does not prohibit the possession of everything referred to in that subsection (BOOLEAN)
#ASSERT `s 110(3) the court must include in the record a statement of its reasons` TRUE FALSE EQUALS JUST TRUE   -- the court does not make an order under subsection (1)
#ASSERT `s 110(3) the court must include in the record a statement of its reasons` FALSE TRUE EQUALS JUST TRUE   -- the court makes an order but does not prohibit the possession of everything
#ASSERT `s 110(3) the court must include in the record a statement of its reasons` FALSE FALSE EQUALS JUST FALSE   -- the court makes an order prohibiting everything
#ASSERT `s 110(3) the court must include in the record a statement of its reasons` TRUE TRUE EQUALS JUST TRUE   -- both

#TRACE `s 110(3) the duty of the court to include its reasons in the record` TRUE AT 0 WITH
    PARTY `the court` DOES `s 110 include in the record a statement of the court’s reasons for not making the order or not prohibiting everything` AT 3

#TRACE `s 110(3) the duty of the court to include its reasons in the record` TRUE AT 0 WITH
    (WAITUNTIL 100)

#TRACE `s 110(3) the duty of the court to include its reasons in the record` FALSE AT 0 WITH
    (WAITUNTIL 100)

-- `s 110(4) release from imprisonment`
-- inputs, in the order of the GIVEN:
--   1. the release (`s 110(4) release from confinement`)
#ASSERT `s 110(4) release from imprisonment` `s 110(4) release: by reason of expiration of sentence` EQUALS JUST TRUE   -- release by reason of expiration of sentence
#ASSERT `s 110(4) release from imprisonment` `s 110(4) release: by reason of commencement of statutory release` EQUALS JUST TRUE   -- release by reason of commencement of statutory release
#ASSERT `s 110(4) release from imprisonment` `s 110(4) release: by reason of grant of parole` EQUALS JUST TRUE   -- release by reason of grant of parole
#ASSERT `s 110(4) release from imprisonment` `s 110(4) release: by reason of something else` EQUALS JUST FALSE   -- release for another reason: "means" is closed

-- `s 110(5) the section applies in respect of every order made under subsection (1)`
-- inputs, in the order of the GIVEN:
--   1. the section (`Provision of the Code`)
#ASSERT `s 110(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 113, "") EQUALS JUST TRUE   -- section 113
#ASSERT `s 110(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 114, "") EQUALS JUST TRUE   -- section 114
#ASSERT `s 110(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 115, "") EQUALS JUST TRUE   -- section 115
#ASSERT `s 110(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 116, "") EQUALS JUST TRUE   -- section 116
#ASSERT `s 110(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 117, "") EQUALS JUST TRUE   -- section 117
#ASSERT `s 110(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 112, "") EQUALS NOTHING   -- section 112 is outside "Sections 113 to 117"
#ASSERT `s 110(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 118, "") EQUALS NOTHING   -- section 118 is outside "Sections 113 to 117"
#ASSERT `s 110(5) the section applies in respect of every order made under subsection (1)` (`Provision of the Code` OF 117.01, "") EQUALS NOTHING   -- section 117.01 is outside "Sections 113 to 117"

§ `Section 110.1 -- Application for emergency prohibition order`

-- `s 110.1(1) any person may make an ex parte application to a provincial court judge for an order`
-- inputs, in the order of the GIVEN:
--   1. the applicant believes on reasonable grounds that it is not desirable in the interests of the safety of the person against whom the order is sought or of any other person that that person should possess any such thing (BOOLEAN)
#ASSERT `s 110.1(1) any person may make an ex parte application to a provincial court judge for an order` TRUE EQUALS JUST TRUE   -- the applicant believes on reasonable grounds that it is not desirable in the interests of safety that the person possess any such thing
#ASSERT `s 110.1(1) any person may make an ex parte application to a provincial court judge for an order` FALSE EQUALS NOTHING   -- the applicant does not: the grant is limited by its "if" (ruling of 2026-11-12)

-- `s 110.1(2) the provincial court judge may hold the hearing in private`
-- inputs, in the order of the GIVEN:
--   1. the judge considers that it is necessary to protect the security of the applicant or of anyone known to the applicant (BOOLEAN)
#ASSERT `s 110.1(2) the provincial court judge may hold the hearing in private` TRUE EQUALS JUST TRUE   -- the judge considers it necessary to protect the security of the applicant or of anyone known to the applicant
#ASSERT `s 110.1(2) the provincial court judge may hold the hearing in private` FALSE EQUALS NOTHING   -- the judge does not

-- `s 110.1(3) the provincial court judge must make an emergency prohibition order`
-- inputs, in the order of the GIVEN:
--   1. the judge is satisfied that the circumstances referred to in subsection (1) exist (BOOLEAN)
--   2. the judge is satisfied that an order should be made without delay to ensure the immediate protection of any person (BOOLEAN)
#ASSERT `s 110.1(3) the provincial court judge must make an emergency prohibition order` TRUE TRUE EQUALS JUST TRUE   -- satisfied that the circumstances exist and that an order should be made without delay
#ASSERT `s 110.1(3) the provincial court judge must make an emergency prohibition order` FALSE TRUE EQUALS JUST FALSE   -- not satisfied that the circumstances exist
#ASSERT `s 110.1(3) the provincial court judge must make an emergency prohibition order` TRUE FALSE EQUALS JUST FALSE   -- not satisfied that an order should be made without delay
#ASSERT `s 110.1(3) the provincial court judge must make an emergency prohibition order` FALSE FALSE EQUALS JUST FALSE   -- satisfied of neither

-- `s 110.1(3) the period specified in the order is within the limit of thirty days`
-- inputs, in the order of the GIVEN:
--   1. the period specified in the order (`Length of time`)
#ASSERT `s 110.1(3) the period specified in the order is within the limit of thirty days` (`Length of time` OF 0, 0, 30, FALSE) EQUALS JUST TRUE   -- 30 days: "not exceeding 30 days"
#ASSERT `s 110.1(3) the period specified in the order is within the limit of thirty days` (`Length of time` OF 0, 0, 29, FALSE) EQUALS JUST TRUE   -- 29 days
#ASSERT `s 110.1(3) the period specified in the order is within the limit of thirty days` (`Length of time` OF 0, 0, 1, FALSE) EQUALS JUST TRUE   -- 1 day
#ASSERT `s 110.1(3) the period specified in the order is within the limit of thirty days` (`Length of time` OF 0, 0, 31, FALSE) EQUALS JUST FALSE   -- 31 days
#ASSERT `s 110.1(3) the period specified in the order is within the limit of thirty days` (`Length of time` OF 0, 1, 0, FALSE) EQUALS JUST FALSE   -- one month
#ASSERT `s 110.1(3) the period specified in the order is within the limit of thirty days` (`Length of time` OF 1, 0, 0, FALSE) EQUALS JUST FALSE   -- one year

#TRACE `s 110.1(3) the duty of the provincial court judge to make an emergency prohibition order` TRUE AT 0 WITH
    PARTY `a provincial court judge` DOES `s 110.1 make an emergency prohibition order` AT 2

#TRACE `s 110.1(3) the duty of the provincial court judge to make an emergency prohibition order` TRUE AT 0 WITH
    (WAITUNTIL 100)

#TRACE `s 110.1(3) the duty of the provincial court judge to make an emergency prohibition order` FALSE AT 0 WITH
    (WAITUNTIL 100)

-- `s 110.1(4) a copy of the order must be served on the person to whom it is addressed`
-- inputs, in the order of the GIVEN:
--   1. an order has been made under subsection (3) (BOOLEAN)
#ASSERT `s 110.1(4) a copy of the order must be served on the person to whom it is addressed` TRUE EQUALS JUST TRUE   -- an order has been made under subsection (3)
#ASSERT `s 110.1(4) a copy of the order must be served on the person to whom it is addressed` FALSE EQUALS NOTHING   -- no order has been made: the text is silent

-- `s 110.1(5) the provincial court judge may issue a warrant to search and seize`
-- inputs, in the order of the GIVEN:
--   1. the person is subject to an order made under subsection (3) (BOOLEAN)
--   2. the judge is satisfied by information on oath that there are reasonable grounds to believe that the person possesses, in a building, receptacle or place, a thing the possession of which is prohibited by the order (BOOLEAN)
--   3. the judge is satisfied by information on oath that there are reasonable grounds to believe that it is not desirable in the interests of the safety of the person, or of any other person, for the person to possess the thing (BOOLEAN)
#ASSERT `s 110.1(5) the provincial court judge may issue a warrant to search and seize` TRUE TRUE TRUE EQUALS JUST TRUE   -- the person is subject to an order under (3) and the judge is satisfied on oath of both matters
#ASSERT `s 110.1(5) the provincial court judge may issue a warrant to search and seize` FALSE TRUE TRUE EQUALS NOTHING   -- the person is not subject to an order under subsection (3)
#ASSERT `s 110.1(5) the provincial court judge may issue a warrant to search and seize` TRUE FALSE TRUE EQUALS NOTHING   -- the judge is not satisfied that the person possesses a prohibited thing
#ASSERT `s 110.1(5) the provincial court judge may issue a warrant to search and seize` TRUE TRUE FALSE EQUALS NOTHING   -- the judge is not satisfied that it is not desirable for the person to possess it

-- `s 110.1(6) the peace officer may search for and seize without a warrant`
-- inputs, in the order of the GIVEN:
--   1. the person is subject to an order made under subsection (3) (BOOLEAN)
--   2. the peace officer is satisfied that there are reasonable grounds to believe that it is not desirable in the interests of the safety of the person, or of any other person, for the person to possess a thing the possession of which is prohibited by the order (BOOLEAN)
--   3. the grounds for obtaining a warrant under subsection (5) exist (BOOLEAN)
--   4. by reason of a possible danger to the safety of the person or any other person, it would not be practicable to obtain a warrant (BOOLEAN)
#ASSERT `s 110.1(6) the peace officer may search for and seize without a warrant` TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- all four conditions hold
#ASSERT `s 110.1(6) the peace officer may search for and seize without a warrant` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- the person is not subject to an order under subsection (3)
#ASSERT `s 110.1(6) the peace officer may search for and seize without a warrant` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- the peace officer is not satisfied
#ASSERT `s 110.1(6) the peace officer may search for and seize without a warrant` TRUE TRUE FALSE TRUE EQUALS NOTHING   -- the grounds for a warrant under subsection (5) do not exist
#ASSERT `s 110.1(6) the peace officer may search for and seize without a warrant` TRUE TRUE TRUE FALSE EQUALS NOTHING   -- it would have been practicable to obtain a warrant

-- `s 110.1(7) the peace officer must make a report to a justice`
-- inputs, in the order of the GIVEN:
--   1. the peace officer executes a warrant referred to in subsection (5) (BOOLEAN)
--   2. the peace officer conducts a search without a warrant under subsection (6) (BOOLEAN)
#ASSERT `s 110.1(7) the peace officer must make a report to a justice` TRUE FALSE EQUALS JUST TRUE   -- executes a warrant referred to in subsection (5)
#ASSERT `s 110.1(7) the peace officer must make a report to a justice` FALSE TRUE EQUALS JUST TRUE   -- conducts a search without a warrant under subsection (6)
#ASSERT `s 110.1(7) the peace officer must make a report to a justice` TRUE TRUE EQUALS JUST TRUE   -- both
#ASSERT `s 110.1(7) the peace officer must make a report to a justice` FALSE FALSE EQUALS JUST FALSE   -- neither: the duty is of that peace officer only

-- `s 110.1(7) what the report must show`
-- inputs, in the order of the GIVEN:
--   1. the report is of an execution of a warrant (BOOLEAN)
--   2. the report is of a search conducted without a warrant (BOOLEAN)
#ASSERT `s 110.1(7) what the report must show` TRUE FALSE EQUALS LIST `s 110.1(7) the things or documents, if any, seized`, `s 110.1(7) the date of execution of the warrant`  -- (a) an execution of a warrant: the things or documents, if any, seized and the date of execution
#ASSERT `s 110.1(7) what the report must show` FALSE TRUE EQUALS LIST `s 110.1(7) the grounds on which it was concluded that the peace officer was entitled to conduct the search`, `s 110.1(7) the things or documents, if any, seized`  -- (b) a search without a warrant: the grounds, and the things or documents, if any, seized
#ASSERT `s 110.1(7) what the report must show` FALSE FALSE EQUALS EMPTY   -- neither: nothing is stated

-- the text says "immediately" and no number: no WITHIN
#TRACE `s 110.1(7) the duty of the peace officer to make a report to a justice` TRUE AT 0 WITH
    PARTY `a peace officer` DOES `s 110.1 make a report to a justice` AT 1

#TRACE `s 110.1(7) the duty of the peace officer to make a report to a justice` TRUE AT 0 WITH
    (WAITUNTIL 100)

#TRACE `s 110.1(7) the duty of the peace officer to make a report to a justice` FALSE AT 0 WITH
    (WAITUNTIL 100)

-- `s 110.1(8) the occasion on which the things and documents must be returned to the person`
-- inputs, in the order of the GIVEN:
--   1. a date is fixed under subsection 110.4(1) for the hearing of an application made under subsection 111(1) in respect of the person (BOOLEAN)
--   2. an order is made against the person under subsection 111(5) (BOOLEAN)
--   3. the order made against the person under subsection (3) is revoked (BOOLEAN)
#ASSERT `s 110.1(8) the occasion on which the things and documents must be returned to the person` FALSE FALSE FALSE EQUALS JUST `s 110.1(8) as soon as feasible after the end of the period specified in the order`  -- (a) no date is fixed: after the end of the period specified in the order
#ASSERT `s 110.1(8) the occasion on which the things and documents must be returned to the person` TRUE FALSE FALSE EQUALS JUST `s 110.1(8) as soon as feasible after the final disposition of the application`  -- (b) a date is fixed but no order is made under subsection 111(5): after the final disposition of the application
#ASSERT `s 110.1(8) the occasion on which the things and documents must be returned to the person` TRUE TRUE FALSE EQUALS NOTHING   -- a date is fixed and an order is made under subsection 111(5): the text gives no occasion
#ASSERT `s 110.1(8) the occasion on which the things and documents must be returned to the person` FALSE FALSE TRUE EQUALS JUST `s 110.1(8) as soon as feasible after the day on which the order is revoked`  -- (c) the order made under subsection (3) is revoked: after the day on which it is revoked
#ASSERT `s 110.1(8) the occasion on which the things and documents must be returned to the person` TRUE FALSE TRUE EQUALS JUST `s 110.1(8) as soon as feasible after the day on which the order is revoked`  -- (c) "despite paragraphs (a) and (b)": a date is fixed, no order under 111(5), and the order is revoked
#ASSERT `s 110.1(8) the occasion on which the things and documents must be returned to the person` TRUE TRUE TRUE EQUALS JUST `s 110.1(8) as soon as feasible after the day on which the order is revoked`  -- (c) despite (a) and (b): a date is fixed, an order is made under 111(5), and the order is revoked

-- `s 110.1(9) the section applies in respect of every order made under subsection (3)`
-- inputs, in the order of the GIVEN:
--   1. the section (`Provision of the Code`)
#ASSERT `s 110.1(9) the section applies in respect of every order made under subsection (3)` (`Provision of the Code` OF 113, "") EQUALS JUST TRUE   -- section 113
#ASSERT `s 110.1(9) the section applies in respect of every order made under subsection (3)` (`Provision of the Code` OF 114, "") EQUALS JUST TRUE   -- section 114
#ASSERT `s 110.1(9) the section applies in respect of every order made under subsection (3)` (`Provision of the Code` OF 116, "") EQUALS JUST TRUE   -- section 116
#ASSERT `s 110.1(9) the section applies in respect of every order made under subsection (3)` (`Provision of the Code` OF 112, "") EQUALS NOTHING   -- section 112 is not named
#ASSERT `s 110.1(9) the section applies in respect of every order made under subsection (3)` (`Provision of the Code` OF 115, "") EQUALS NOTHING   -- section 115 is not named
#ASSERT `s 110.1(9) the section applies in respect of every order made under subsection (3)` (`Provision of the Code` OF 117, "") EQUALS NOTHING   -- section 117 is not named

-- `s 110.1(10) provincial court judge`
-- inputs, in the order of the GIVEN:
--   1. the section (`Provision of the Code`)
--   2. the provincial court judge has jurisdiction in the territorial division where the person against whom the application for an order was brought resides (BOOLEAN)
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 110.1, "") TRUE EQUALS JUST TRUE   -- section 110.1: a provincial court judge having jurisdiction where the person resides
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 110.4, "") TRUE EQUALS JUST TRUE   -- section 110.4: a provincial court judge having jurisdiction where the person resides
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 111, "") TRUE EQUALS JUST TRUE   -- section 111: a provincial court judge having jurisdiction where the person resides
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 112, "") TRUE EQUALS JUST TRUE   -- section 112: a provincial court judge having jurisdiction where the person resides
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 117.0101, "") TRUE EQUALS JUST TRUE   -- section 117.0101: a provincial court judge having jurisdiction where the person resides
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 117.0104, "") TRUE EQUALS JUST TRUE   -- section 117.0104: a provincial court judge having jurisdiction where the person resides
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 117.011, "") TRUE EQUALS JUST TRUE   -- section 117.011: a provincial court judge having jurisdiction where the person resides
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 117.012, "") TRUE EQUALS JUST TRUE   -- section 117.012: a provincial court judge having jurisdiction where the person resides
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 111, "") FALSE EQUALS JUST FALSE   -- section 111: a judge without jurisdiction where the person resides: "means" is closed
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 110.1, "") FALSE EQUALS JUST FALSE   -- section 110.1: a judge without that jurisdiction
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 113, "") TRUE EQUALS NOTHING   -- section 113 is not named
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 110.2, "") TRUE EQUALS NOTHING   -- section 110.2 is not named
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 117.0102, "") TRUE EQUALS NOTHING   -- section 117.0102 is not named
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 117.013, "") TRUE EQUALS NOTHING   -- section 117.013 is not named
#ASSERT `s 110.1(10) provincial court judge` (`Provision of the Code` OF 110, "") TRUE EQUALS NOTHING   -- section 110 is not named

§ `Section 110.2 -- Order denying access to information`

-- `s 110.2(1) a provincial court judge may make an order prohibiting access to, and the disclosure of, information`
-- inputs, in the order of the GIVEN:
--   1. an order is made under subsection 110.1(3) (BOOLEAN)
--   2. the judge acts on application by the person who applied for the order or on the judge’s own motion (BOOLEAN)
--   3. the judge considers that it is necessary to protect the security of the person or of anyone known to the person (BOOLEAN)
#ASSERT `s 110.2(1) a provincial court judge may make an order prohibiting access to, and the disclosure of, information` TRUE TRUE TRUE EQUALS JUST TRUE   -- an order is made under 110.1(3), on application or own motion, and the judge considers it necessary
#ASSERT `s 110.2(1) a provincial court judge may make an order prohibiting access to, and the disclosure of, information` FALSE TRUE TRUE EQUALS NOTHING   -- no order is made under subsection 110.1(3)
#ASSERT `s 110.2(1) a provincial court judge may make an order prohibiting access to, and the disclosure of, information` TRUE FALSE TRUE EQUALS JUST FALSE   -- the judge does not act on application or on the judge’s own motion   -- RECONCILED 2026-11-12: was #ASSERT `s 110.2(1) a provincial court judge may make an order prohibiting access to, and the disclosure of, information` TRUE FALSE TRUE EQUALS NOTHING; the "on application or on the judge’s own motion" gate is of the kind of "when" and "upon", which count as "where" (rulings (b) and (c) of 2026-11-05), so the name-test sweep lists this function and leaves the guide’s answer, JUST FALSE; the first pass answered NOTHING (fork F-110.2(1))
#ASSERT `s 110.2(1) a provincial court judge may make an order prohibiting access to, and the disclosure of, information` TRUE FALSE FALSE EQUALS JUST FALSE   -- the judge does not act on application or on the judge’s own motion, and the judge does not consider it necessary: the gates are read in the text’s order, the first that fails decides
#ASSERT `s 110.2(1) a provincial court judge may make an order prohibiting access to, and the disclosure of, information` FALSE FALSE TRUE EQUALS NOTHING   -- no order is made under subsection 110.1(3) and the judge does not act on application or on the judge’s own motion: the "if" that opens the sentence fails first
#ASSERT `s 110.2(1) a provincial court judge may make an order prohibiting access to, and the disclosure of, information` TRUE TRUE FALSE EQUALS NOTHING   -- the judge does not consider it necessary

-- `s 110.2(1) the information is within the order that may be made`
-- inputs, in the order of the GIVEN:
--   1. the information (`s 110.2(1) information`)
#ASSERT `s 110.2(1) the information is within the order that may be made` `s 110.2(1) information: relating to the order made under subsection 110.1(3)` EQUALS JUST TRUE   -- (a) information relating to the order made under subsection 110.1(3)
#ASSERT `s 110.2(1) the information is within the order that may be made` `s 110.2(1) information: relating to a warrant issued under subsection 110.1(5)` EQUALS JUST TRUE   -- (b) information relating to a warrant issued under subsection 110.1(5)
#ASSERT `s 110.2(1) the information is within the order that may be made` `s 110.2(1) information: relating to a search and seizure conducted without a warrant under subsection 110.1(6)` EQUALS JUST TRUE   -- (c) information relating to a search and seizure without a warrant under subsection 110.1(6)
#ASSERT `s 110.2(1) the information is within the order that may be made` `s 110.2(1) information: relating to the order made under subsection 110.2(1)` EQUALS JUST TRUE   -- (d) information relating to the order made under subsection 110.2(1)
#ASSERT `s 110.2(1) the information is within the order that may be made` `s 110.2(1) information: of another kind` EQUALS NOTHING   -- information of another kind: "any or all of the following" does not say "only"

-- `s 110.2(2) the day on which the order made under subsection (1) expires`
-- inputs, in the order of the GIVEN:
--   1. the order made under subsection (1) is revoked earlier (BOOLEAN)
--   2. the day on which the order made under subsection 110.1(3) expires or is revoked (DATE)
#ASSERT `s 110.2(2) the day on which the order made under subsection (1) expires` FALSE (Date 1 6 2021) EQUALS JUST (Date 1 6 2021)   -- not revoked earlier: it expires on the day the 110.1(3) order expires or is revoked
#ASSERT `s 110.2(2) the day on which the order made under subsection (1) expires` TRUE (Date 1 6 2021) EQUALS NOTHING   -- revoked earlier: "Unless an order made under subsection (1) is revoked earlier"

-- `s 110.2(3) the day on which an order made under subsection (1) ceases to have effect`
-- inputs, in the order of the GIVEN:
--   1. before the order made under subsection 110.1(3) expires or is revoked, a date is fixed under subsection 110.4(1) for the hearing of an application made under subsection 111(1) (BOOLEAN)
--   2. the date fixed under subsection 110.4(1) (DATE)
--   3. the order made under subsection 110.1(3) is revoked before that date (BOOLEAN)
--   4. the day on which the order made under subsection 110.1(3) is revoked (DATE)
#ASSERT `s 110.2(3) the day on which an order made under subsection (1) ceases to have effect` TRUE (Date 1 9 2021) FALSE (Date 1 8 2021) EQUALS JUST (Date 1 9 2021)   -- (a) a date is fixed under 110.4(1): the order ceases to have effect on the date fixed
#ASSERT `s 110.2(3) the day on which an order made under subsection (1) ceases to have effect` TRUE (Date 1 9 2021) TRUE (Date 1 8 2021) EQUALS JUST (Date 1 8 2021)   -- (b) the order under 110.1(3) is revoked before that date: the day on which it is revoked
#ASSERT `s 110.2(3) the day on which an order made under subsection (1) ceases to have effect` FALSE (Date 1 9 2021) FALSE (Date 1 8 2021) EQUALS NOTHING   -- no date is fixed: subsection (2) governs

-- `s 110.2(2) and (3) the day on which an order made under subsection (1) ends`
-- inputs, in the order of the GIVEN:
--   1. before the order made under subsection 110.1(3) expires or is revoked, a date is fixed under subsection 110.4(1) for the hearing of an application made under subsection 111(1) (BOOLEAN)
--   2. the date fixed under subsection 110.4(1) (DATE)
--   3. the order made under subsection 110.1(3) is revoked before that date (BOOLEAN)
--   4. the day on which the order made under subsection 110.1(3) is revoked (DATE)
--   5. the order made under subsection (1) is revoked earlier (BOOLEAN)
--   6. the day on which the order made under subsection 110.1(3) expires or is revoked (DATE)
#ASSERT `s 110.2(2) and (3) the day on which an order made under subsection (1) ends` TRUE (Date 1 9 2021) FALSE (Date 1 8 2021) FALSE (Date 1 6 2021) EQUALS JUST (Date 1 9 2021)   -- a date is fixed, the 110.1(3) order not revoked before it: the date fixed
#ASSERT `s 110.2(2) and (3) the day on which an order made under subsection (1) ends` TRUE (Date 1 9 2021) TRUE (Date 1 8 2021) FALSE (Date 1 6 2021) EQUALS JUST (Date 1 8 2021)   -- a date is fixed, the 110.1(3) order revoked before it: the day it is revoked
#ASSERT `s 110.2(2) and (3) the day on which an order made under subsection (1) ends` FALSE (Date 1 9 2021) FALSE (Date 1 8 2021) FALSE (Date 1 6 2021) EQUALS JUST (Date 1 6 2021)   -- no date is fixed, not revoked earlier: the day the 110.1(3) order expires or is revoked
#ASSERT `s 110.2(2) and (3) the day on which an order made under subsection (1) ends` FALSE (Date 1 9 2021) FALSE (Date 1 8 2021) TRUE (Date 1 6 2021) EQUALS NOTHING   -- no date is fixed, revoked earlier: the text gives no day

-- `s 110.2(4) the documents must be placed in a packet and sealed by the judge`
-- inputs, in the order of the GIVEN:
--   1. an order is made under subsection (1) (BOOLEAN)
#ASSERT `s 110.2(4) the documents must be placed in a packet and sealed by the judge` TRUE EQUALS JUST TRUE   -- an order is made under subsection (1)
#ASSERT `s 110.2(4) the documents must be placed in a packet and sealed by the judge` FALSE EQUALS JUST FALSE   -- no order is made: an "if" that fails

#TRACE `s 110.2(4) the duty of the provincial court judge to place the documents in a packet and seal it` TRUE AT 0 WITH
    PARTY `a provincial court judge` DOES `s 110.2 place the documents in a packet and seal it` AT 1

#TRACE `s 110.2(4) the duty of the provincial court judge to place the documents in a packet and seal it` TRUE AT 0 WITH
    (WAITUNTIL 100)

#TRACE `s 110.2(4) the duty of the provincial court judge to place the documents in a packet and seal it` FALSE AT 0 WITH
    (WAITUNTIL 100)

-- `s 110.2(5) an application to revoke the order or vary its terms and conditions may be made to the provincial court judge`
-- inputs, in the order of the GIVEN:
--   1. an order was made under subsection (1) (BOOLEAN)
--   2. the application is made to the provincial court judge who made the order or to another provincial court judge (BOOLEAN)
#ASSERT `s 110.2(5) an application to revoke the order or vary its terms and conditions may be made to the provincial court judge` TRUE TRUE EQUALS JUST TRUE   -- an order was made, and the application goes to the judge who made it or to another provincial court judge
#ASSERT `s 110.2(5) an application to revoke the order or vary its terms and conditions may be made to the provincial court judge` TRUE FALSE EQUALS NOTHING   -- an order was made but the application goes elsewhere: the text says nothing
#ASSERT `s 110.2(5) an application to revoke the order or vary its terms and conditions may be made to the provincial court judge` FALSE TRUE EQUALS NOTHING   -- no order was made

§ `Section 110.3 -- Order to delete identifying information`

-- `s 110.3(1) a provincial court judge may make an order to delete identifying information`
-- inputs, in the order of the GIVEN:
--   1. an order is made under subsection 110.1(3) or 110.2(1) (BOOLEAN)
--   2. the judge acts on application by the person who applied for the order referred to in subsection 110.1(3) or on the judge’s own motion (BOOLEAN)
--   3. the judge considers that it is necessary to protect the security of the person or of anyone known to the person (BOOLEAN)
#ASSERT `s 110.3(1) a provincial court judge may make an order to delete identifying information` TRUE TRUE TRUE EQUALS JUST TRUE   -- an order is made under 110.1(3) or 110.2(1), on application or own motion, and the judge considers it necessary
#ASSERT `s 110.3(1) a provincial court judge may make an order to delete identifying information` FALSE TRUE TRUE EQUALS NOTHING   -- no such order is made
#ASSERT `s 110.3(1) a provincial court judge may make an order to delete identifying information` TRUE FALSE TRUE EQUALS JUST FALSE   -- the judge does not act on application or on the judge’s own motion   -- RECONCILED 2026-11-12: was #ASSERT `s 110.3(1) a provincial court judge may make an order to delete identifying information` TRUE FALSE TRUE EQUALS NOTHING; the "on application or on the judge’s own motion" gate is of the kind of "when" and "upon", which count as "where" (rulings (b) and (c) of 2026-11-05), so the name-test sweep lists this function and leaves the guide’s answer, JUST FALSE; the first pass answered NOTHING (fork F-110.3(1))
#ASSERT `s 110.3(1) a provincial court judge may make an order to delete identifying information` TRUE FALSE FALSE EQUALS JUST FALSE   -- the judge does not act on application or on the judge’s own motion, and the judge does not consider it necessary: the gates are read in the text’s order, the first that fails decides
#ASSERT `s 110.3(1) a provincial court judge may make an order to delete identifying information` FALSE FALSE TRUE EQUALS NOTHING   -- no such order is made and the judge does not act on application or on the judge’s own motion: the "if" that opens the sentence fails first
#ASSERT `s 110.3(1) a provincial court judge may make an order to delete identifying information` TRUE TRUE FALSE EQUALS NOTHING   -- the judge does not consider it necessary

-- `s 110.3(1) what the order directs`
#ASSERT `s 110.3(1) what the order directs` EQUALS LIST `s 110.3(1) that copies be made of any documents relating to the order made under subsection 110.1(3) or 110.2(1), including the order itself`, `s 110.3(1) that any information that could identify the person who applied for the order, or anyone known to the person, be deleted from those copies`, `s 110.3(1) that the documents to which the public has access or that are made available to or required to be served on any person are to be the edited copies`  -- (a) copies be made, (b) identifying information be deleted from them, (c) the edited copies are what the public may see and what is served on any person

-- `s 110.3(2) the order may be for the period, whether definite or indefinite`
-- inputs, in the order of the GIVEN:
--   1. the judge considers the period necessary to protect the security of the person who applied for the order referred to in subsection 110.1(3) or of anyone known to the person (BOOLEAN)
#ASSERT `s 110.3(2) the order may be for the period, whether definite or indefinite` TRUE EQUALS JUST TRUE   -- the judge considers the period necessary to protect the security of the applicant or of anyone known to the applicant
#ASSERT `s 110.3(2) the order may be for the period, whether definite or indefinite` FALSE EQUALS NOTHING   -- the judge does not

-- `s 110.3(3) the originals must be placed in a packet and sealed by the judge`
-- inputs, in the order of the GIVEN:
--   1. an order is made under subsection (1) (BOOLEAN)
#ASSERT `s 110.3(3) the originals must be placed in a packet and sealed by the judge` TRUE EQUALS JUST TRUE   -- an order is made under subsection (1)
#ASSERT `s 110.3(3) the originals must be placed in a packet and sealed by the judge` FALSE EQUALS JUST FALSE   -- no order is made: an "if" that fails

#TRACE `s 110.3(3) the duty of the provincial court judge to place the originals in a packet and seal it` TRUE AT 0 WITH
    PARTY `a provincial court judge` DOES `s 110.3 place the originals in a packet and seal it` AT 1

#TRACE `s 110.3(3) the duty of the provincial court judge to place the originals in a packet and seal it` TRUE AT 0 WITH
    (WAITUNTIL 100)

#TRACE `s 110.3(3) the duty of the provincial court judge to place the originals in a packet and seal it` FALSE AT 0 WITH
    (WAITUNTIL 100)

-- `s 110.3(4) an application to revoke the order or vary its terms and conditions may be made to the provincial court judge`
-- inputs, in the order of the GIVEN:
--   1. an order was made under subsection (1) (BOOLEAN)
--   2. the application is made to the provincial court judge who made the order or to another provincial court judge (BOOLEAN)
#ASSERT `s 110.3(4) an application to revoke the order or vary its terms and conditions may be made to the provincial court judge` TRUE TRUE EQUALS JUST TRUE   -- an order was made, and the application goes to the judge who made it or to another provincial court judge
#ASSERT `s 110.3(4) an application to revoke the order or vary its terms and conditions may be made to the provincial court judge` TRUE FALSE EQUALS NOTHING   -- an order was made but the application goes elsewhere
#ASSERT `s 110.3(4) an application to revoke the order or vary its terms and conditions may be made to the provincial court judge` FALSE TRUE EQUALS NOTHING   -- no order was made

-- `s 110.3(5) the order made under this section applies in respect of that hearing`
-- inputs, in the order of the GIVEN:
--   1. a date is fixed under subsection 110.4(1) for the hearing of an application made under subsection 111(1) (BOOLEAN)
--   2. the order made under this section is still in force (BOOLEAN)
#ASSERT `s 110.3(5) the order made under this section applies in respect of that hearing` TRUE TRUE EQUALS JUST TRUE   -- a date is fixed under 110.4(1) and the order is still in force
#ASSERT `s 110.3(5) the order made under this section applies in respect of that hearing` TRUE FALSE EQUALS NOTHING   -- a date is fixed but the order is no longer in force
#ASSERT `s 110.3(5) the order made under this section applies in respect of that hearing` FALSE TRUE EQUALS NOTHING   -- no date is fixed

