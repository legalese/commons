IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc6-sexual-offences`
IMPORT `ccc6-tests-support`

-- Tests for ss 151, 152, 153, 155 and 156. Expected values decided from the text before each run; written beside the assertion.

§ `s 151 Sexual interference`
-- (touched, sexual purpose, age of the person touched)
#ASSERT `s 151 the conduct is sexual interference` TRUE TRUE 15 EQUALS JUST TRUE
#ASSERT `s 151 the conduct is sexual interference` TRUE TRUE 15.99 EQUALS JUST TRUE   -- just under 16
#ASSERT `s 151 the conduct is sexual interference` TRUE TRUE 16 EQUALS NOTHING   -- 16 is not "under the age of 16 years"
#ASSERT `s 151 the conduct is sexual interference` TRUE FALSE 10 EQUALS NOTHING   -- not for a sexual purpose
#ASSERT `s 151 the conduct is sexual interference` FALSE TRUE 10 EQUALS NOTHING   -- no touching
#ASSERT `s 151 the conduct is sexual interference` TRUE TRUE 0 EQUALS JUST TRUE
#ASSERT `s 151(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) (`ss 150 to 182 test a term of years` 1)   -- (a): not more than 14 years, minimum one year
#ASSERT `s 151(b) the punishment on summary conviction` EQUALS `ss 150 to 182 test a summary punishment` `ss 150 to 182 test a term of two years less a day` (`ss 150 to 182 test a term of days` 90)   -- (b): two years less a day, minimum 90 days
#ASSERT `s 151 the class of the offence` EQUALS `ss 150 to 182 test both`

§ `s 152 Invitation to sexual touching or exposure`
-- (invited, counselled or incited; sexual purpose; age; what to do)
#ASSERT `s 152(1) the conduct is the offence of invitation to sexual touching or exposure` TRUE TRUE 15 `s 152(1)(a) touch, directly or indirectly, with a part of the body or with an object, their own body, the body of the person who so invites, counsels or incites or the body of any other person` EQUALS JUST TRUE
#ASSERT `s 152(1) the conduct is the offence of invitation to sexual touching or exposure` TRUE TRUE 15 `s 152(1)(b) expose their own sexual organs` EQUALS JUST TRUE
#ASSERT `s 152(1) the conduct is the offence of invitation to sexual touching or exposure` TRUE TRUE 16 `s 152(1)(b) expose their own sexual organs` EQUALS NOTHING   -- 16: not "under the age of 16 years"
#ASSERT `s 152(1) the conduct is the offence of invitation to sexual touching or exposure` TRUE TRUE 15.5 `s 152(1) something else` EQUALS NOTHING   -- invited to do something neither (a) nor (b)
#ASSERT `s 152(1) the conduct is the offence of invitation to sexual touching or exposure` TRUE FALSE 10 `s 152(1)(b) expose their own sexual organs` EQUALS NOTHING   -- not for a sexual purpose
#ASSERT `s 152(1) the conduct is the offence of invitation to sexual touching or exposure` FALSE TRUE 10 `s 152(1)(a) touch, directly or indirectly, with a part of the body or with an object, their own body, the body of the person who so invites, counsels or incites or the body of any other person` EQUALS NOTHING   -- no invitation, counsel or incitement
#ASSERT `s 152(2)(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) (`ss 150 to 182 test a term of years` 1)
#ASSERT `s 152(2)(b) the punishment on summary conviction` EQUALS `ss 150 to 182 test a summary punishment` `ss 150 to 182 test a term of two years less a day` (`ss 150 to 182 test a term of days` 90)
#ASSERT `s 152 the class of the offence` EQUALS `ss 150 to 182 test both`

§ `s 153 Sexual exploitation`
#ASSERT `s 153(2) young person` 16 EQUALS JUST TRUE   -- "16 years of age or more"
#ASSERT `s 153(2) young person` 17.99 EQUALS JUST TRUE
#ASSERT `s 153(2) young person` 15.99 EQUALS JUST FALSE   -- the text's "means": under 16 is not a young person
#ASSERT `s 153(2) young person` 18 EQUALS JUST FALSE   -- "under the age of eighteen years"
-- (trust or authority, dependency, exploitative, age of the young person, what was done)
#ASSERT `s 153(1) the conduct is the offence of sexual exploitation` TRUE FALSE FALSE 16 `s 153(1)(a) for a sexual purpose, touched, directly or indirectly, with a part of the body or with an object, any part of the body of the young person` EQUALS JUST TRUE
#ASSERT `s 153(1) the conduct is the offence of sexual exploitation` FALSE TRUE FALSE 17 `s 153(1)(b) for a sexual purpose, invited, counselled or incited a young person to touch, directly or indirectly, with a part of the body or with an object, their own body, the body of the person who so invites, counsels or incites or the body of any other person` EQUALS JUST TRUE
#ASSERT `s 153(1) the conduct is the offence of sexual exploitation` FALSE FALSE TRUE 17 `s 153(1)(c) for a sexual purpose, invited, counselled or incited the young person to expose their own sexual organs` EQUALS JUST TRUE
#ASSERT `s 153(1) the conduct is the offence of sexual exploitation` FALSE FALSE FALSE 17 `s 153(1)(a) for a sexual purpose, touched, directly or indirectly, with a part of the body or with an object, any part of the body of the young person` EQUALS NOTHING   -- none of the three relationships
#ASSERT `s 153(1) the conduct is the offence of sexual exploitation` TRUE TRUE TRUE 18 `s 153(1)(a) for a sexual purpose, touched, directly or indirectly, with a part of the body or with an object, any part of the body of the young person` EQUALS NOTHING   -- 18 is not a young person
#ASSERT `s 153(1) the conduct is the offence of sexual exploitation` TRUE TRUE TRUE 15.99 `s 153(1)(a) for a sexual purpose, touched, directly or indirectly, with a part of the body or with an object, any part of the body of the young person` EQUALS NOTHING   -- under 16 is not a young person: s 151 is the section for that age
#ASSERT `s 153(1) the conduct is the offence of sexual exploitation` TRUE FALSE FALSE 17 `s 153(1) something else` EQUALS NOTHING   -- none of (a), (b), (c)
#ASSERT `s 153(1.1)(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) (`ss 150 to 182 test a term of years` 1)
#ASSERT `s 153(1.1)(b) the punishment on summary conviction` EQUALS `ss 150 to 182 test a summary punishment` `ss 150 to 182 test a term of two years less a day` (`ss 150 to 182 test a term of days` 90)
#ASSERT `s 153 the class of the offence` EQUALS `ss 150 to 182 test both`
#ASSERT `s 153(1.2) a judge may infer from it that the relationship is exploitative of the young person` `s 153(1.2)(a) the age of the young person` EQUALS JUST TRUE
#ASSERT `s 153(1.2) a judge may infer from it that the relationship is exploitative of the young person` `s 153(1.2)(b) the age difference between the person and the young person` EQUALS JUST TRUE
#ASSERT `s 153(1.2) a judge may infer from it that the relationship is exploitative of the young person` `s 153(1.2)(c) the evolution of the relationship` EQUALS JUST TRUE
#ASSERT `s 153(1.2) a judge may infer from it that the relationship is exploitative of the young person` `s 153(1.2)(d) the degree of control or influence by the person over the young person` EQUALS JUST TRUE
#ASSERT `s 153(1.2) a judge may infer from it that the relationship is exploitative of the young person` `s 153(1.2) another circumstance of the relationship` EQUALS JUST TRUE   -- "including": the list is open
#ASSERT `s 153(1.2) a judge may infer from it that the relationship is exploitative of the young person` `s 153(1.2) a matter that is not part of the nature and circumstances of the relationship` EQUALS NOTHING

§ `s 155 Incest`
-- (4): brother and sister include half-brother and half-sister
#ASSERT `s 155(4) brother and sister include half-brother and half-sister` `s 155 brother` EQUALS JUST TRUE
#ASSERT `s 155(4) brother and sister include half-brother and half-sister` `s 155 sister` EQUALS JUST TRUE
#ASSERT `s 155(4) brother and sister include half-brother and half-sister` `s 155 half-brother` EQUALS JUST TRUE
#ASSERT `s 155(4) brother and sister include half-brother and half-sister` `s 155 half-sister` EQUALS JUST TRUE
#ASSERT `s 155(4) brother and sister include half-brother and half-sister` `s 155 parent` EQUALS NOTHING
#ASSERT `s 155(4) brother and sister include half-brother and half-sister` `s 155 another relative, or no blood relationship` EQUALS NOTHING
-- (1): (knew of the blood relationship, relationship, had sexual intercourse)
#ASSERT `s 155(1) the conduct is incest` TRUE `s 155 parent` TRUE EQUALS JUST TRUE
#ASSERT `s 155(1) the conduct is incest` TRUE `s 155 child` TRUE EQUALS JUST TRUE
#ASSERT `s 155(1) the conduct is incest` TRUE `s 155 grandparent` TRUE EQUALS JUST TRUE
#ASSERT `s 155(1) the conduct is incest` TRUE `s 155 grandchild` TRUE EQUALS JUST TRUE
#ASSERT `s 155(1) the conduct is incest` TRUE `s 155 brother` TRUE EQUALS JUST TRUE
#ASSERT `s 155(1) the conduct is incest` TRUE `s 155 sister` TRUE EQUALS JUST TRUE
#ASSERT `s 155(1) the conduct is incest` TRUE `s 155 half-brother` TRUE EQUALS JUST TRUE   -- by (4)
#ASSERT `s 155(1) the conduct is incest` TRUE `s 155 half-sister` TRUE EQUALS JUST TRUE   -- by (4)
#ASSERT `s 155(1) the conduct is incest` TRUE `s 155 another relative, or no blood relationship` TRUE EQUALS NOTHING   -- a cousin: not in the list
#ASSERT `s 155(1) the conduct is incest` FALSE `s 155 parent` TRUE EQUALS NOTHING   -- did not know ("knowing that")
#ASSERT `s 155(1) the conduct is incest` TRUE `s 155 parent` FALSE EQUALS NOTHING   -- no sexual intercourse
-- (2): the minimum of five years only "if the other person is under the age of 16 years"
#ASSERT `s 155(2) the punishment` 15 EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) (`ss 150 to 182 test a term of years` 5)
#ASSERT `s 155(2) the punishment` 15.99 EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) (`ss 150 to 182 test a term of years` 5)
#ASSERT `s 155(2) the punishment` 16 EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) `no imprisonment is stated`   -- 16: no minimum is stated
#ASSERT `s 155(2) the punishment` 40 EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 14) `no imprisonment is stated`
#ASSERT `s 155 the class of the offence` EQUALS `an indictable offence`   -- "guilty of an indictable offence": no summary limb
-- (3): under restraint, duress or fear
#ASSERT `s 155(3) section 155 gives the accused a defence` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 155(3) section 155 gives the accused a defence` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 155(3) section 155 gives the accused a defence` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 155(3) section 155 gives the accused a defence` FALSE FALSE FALSE EQUALS JUST FALSE   -- "gives no defence on these facts"

§ `s 156 Historical offences`
-- (a sexual offence under the Act as it read before January 4, 1983; the conduct would be an offence on the day the charge was laid)
#ASSERT `s 156 no person shall be convicted: the bar applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 156 no person shall be convicted: the bar applies` TRUE TRUE EQUALS JUST FALSE   -- "unless the conduct alleged would be an offence"
#ASSERT `s 156 no person shall be convicted: the bar applies` FALSE FALSE EQUALS NOTHING   -- not an old sexual offence
#ASSERT `s 156 no person shall be convicted: the bar applies` FALSE TRUE EQUALS NOTHING
