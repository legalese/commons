IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc23-assessment`

-- ccc23-tests-assessment.l4 -- tests for sections 672.11 to 672.191 and 672.2. Expected values are written from the text, never copied from the code.
-- Argument order is the order of the GIVEN lines in ccc23-assessment.l4.

§ `s 672.11 -- the court may order an assessment`
-- args: jurisdiction; (a) fitness; (b) s 16(1); (c) balance of mind; newly-born child; (d) disposition; NCR-or-unfit verdict rendered; (d.1) revoke high-risk; (e) stay; unfit verdict rendered
#ASSERT `s 672.11 the court may order an assessment of the mental condition of the accused` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.11 the court may order an assessment of the mental condition of the accused` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (c) needs the newly-born child condition
#ASSERT `s 672.11 the court may order an assessment of the mental condition of the accused` TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.11 the court may order an assessment of the mental condition of the accused` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (d) needs a verdict of NCR or unfit
#ASSERT `s 672.11 the court may order an assessment of the mental condition of the accused` TRUE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.11 the court may order an assessment of the mental condition of the accused` TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (d.1)
#ASSERT `s 672.11 the court may order an assessment of the mental condition of the accused` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- (e) needs a verdict of unfit
#ASSERT `s 672.11 the court may order an assessment of the mental condition of the accused` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.11 the court may order an assessment of the mental condition of the accused` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING
-- no jurisdiction, or no reasonable grounds: the grant is not made out (NOTHING, fork F-GRANT-IF)
#ASSERT `s 672.11 the court may order an assessment of the mental condition of the accused` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.11 the court may order an assessment of the mental condition of the accused` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `s 672.12 -- who may move for an assessment`
-- (2): args = summary-conviction fitness application by the prosecutor; accused raised fitness; prosecutor satisfies the court of reasonable grounds to doubt fitness
#ASSERT `s 672.12(2) the court may order the assessment on the prosecutor’s application about fitness` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.12(2) the court may order the assessment on the prosecutor’s application about fitness` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.12(2) the court may order the assessment on the prosecutor’s application about fitness` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.12(2) the court may order the assessment on the prosecutor’s application about fitness` FALSE FALSE FALSE EQUALS NOTHING
-- (3): args = prosecutor's application about criminal responsibility; accused puts capacity into issue; prosecutor satisfies the court of reasonable grounds to doubt
#ASSERT `s 672.12(3) the court may order the assessment on the prosecutor’s application about criminal responsibility` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.12(3) the court may order the assessment on the prosecutor’s application about criminal responsibility` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.12(3) the court may order the assessment on the prosecutor’s application about criminal responsibility` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.12(3) the court may order the assessment on the prosecutor’s application about criminal responsibility` FALSE TRUE TRUE EQUALS NOTHING
-- (1): args = stage of proceedings; own motion; accused applies; prosecutor applies; answer of (2); answer of (3)
#ASSERT `s 672.12(1) the court may make an assessment order` TRUE TRUE FALSE FALSE NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 672.12(1) the court may make an assessment order` TRUE FALSE TRUE FALSE NOTHING NOTHING EQUALS JUST TRUE
-- the accused's application is not subject to (2) and (3), even when the prosecutor's would fail
#ASSERT `s 672.12(1) the court may make an assessment order` TRUE FALSE TRUE FALSE (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- the prosecutor's application: a limitation met (JUST TRUE), or no limitation applies (NOTHING)
#ASSERT `s 672.12(1) the court may make an assessment order` TRUE FALSE FALSE TRUE (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 672.12(1) the court may make an assessment order` TRUE FALSE FALSE TRUE NOTHING NOTHING EQUALS JUST TRUE
-- the prosecutor's application barred by (2) or by (3)
#ASSERT `s 672.12(1) the court may make an assessment order` TRUE FALSE FALSE TRUE (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 672.12(1) the court may make an assessment order` TRUE FALSE FALSE TRUE NOTHING (JUST FALSE) EQUALS JUST FALSE
-- nobody moved: not covered
#ASSERT `s 672.12(1) the court may make an assessment order` TRUE FALSE FALSE FALSE NOTHING NOTHING EQUALS NOTHING
-- not a stage of proceedings against the accused: not covered
#ASSERT `s 672.12(1) the court may make an assessment order` FALSE TRUE FALSE FALSE NOTHING NOTHING EQUALS NOTHING

§ `s 672.121 -- the Review Board may order an assessment`
-- args: jurisdiction; moved (own motion or application); (a) 672.851(1) recommendation; (b) disposition; (b)(i) no report; (b)(ii) none in twelve months; (b)(iii) transferred; (c) refer high-risk
#ASSERT `s 672.121 the Review Board may order an assessment of the mental condition of the accused` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.121 the Review Board may order an assessment of the mental condition of the accused` TRUE TRUE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.121 the Review Board may order an assessment of the mental condition of the accused` TRUE TRUE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.121 the Review Board may order an assessment of the mental condition of the accused` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- (b) needs one of (i) to (iii)
#ASSERT `s 672.121 the Review Board may order an assessment of the mental condition of the accused` TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.121 the Review Board may order an assessment of the mental condition of the accused` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.121 the Review Board may order an assessment of the mental condition of the accused` FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.121 the Review Board may order an assessment of the mental condition of the accused` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `s 672.13 -- contents and form`
#ASSERT `s 672.13(1) the assessment order has the contents the section requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.13(1) the assessment order has the contents the section requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.13(1) the assessment order has the contents the section requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.13(1) the assessment order has the contents the section requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.13(2) the assessment order is in a form the subsection allows` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.13(2) the assessment order is in a form the subsection allows` FALSE TRUE EQUALS JUST TRUE
-- "may be in Form 48 or 48.1" does not say another form is not allowed
#ASSERT `s 672.13(2) the assessment order is in a form the subsection allows` FALSE FALSE EQUALS NOTHING

§ `s 672.14 -- period of an assessment order`
-- (1) boundary at thirty days
#ASSERT `s 672.14(1) the assessment order is within the general limit of thirty days` 30 EQUALS JUST TRUE
#ASSERT `s 672.14(1) the assessment order is within the general limit of thirty days` 31 EQUALS JUST FALSE
#ASSERT `s 672.14(1) the assessment order is within the general limit of thirty days` 1 EQUALS JUST TRUE
-- (2) args: fitness order; days (excluding holidays and travel); agreement
#ASSERT `s 672.14(2) the fitness assessment order is within the limit of five days` TRUE 5 FALSE EQUALS JUST TRUE
#ASSERT `s 672.14(2) the fitness assessment order is within the limit of five days` TRUE 6 FALSE EQUALS JUST FALSE
#ASSERT `s 672.14(2) the fitness assessment order is within the limit of five days` TRUE 6 TRUE EQUALS JUST TRUE
#ASSERT `s 672.14(2) the fitness assessment order is within the limit of five days` TRUE 30 TRUE EQUALS JUST TRUE
#ASSERT `s 672.14(2) the fitness assessment order is within the limit of five days` TRUE 31 TRUE EQUALS JUST FALSE
-- an order that is not about fitness: the subsection does not speak
#ASSERT `s 672.14(2) the fitness assessment order is within the limit of five days` FALSE 20 FALSE EQUALS NOTHING
-- (3) args: satisfied that compelling circumstances warrant it; days
#ASSERT `s 672.14(3) the court or Review Board may make an assessment order that remains in force for sixty days` TRUE 60 EQUALS JUST TRUE
#ASSERT `s 672.14(3) the court or Review Board may make an assessment order that remains in force for sixty days` TRUE 61 EQUALS NOTHING
#ASSERT `s 672.14(3) the court or Review Board may make an assessment order that remains in force for sixty days` FALSE 60 EQUALS NOTHING
-- the longest period, in days. args: compelling circumstances; fitness order; agreement
#ASSERT `s 672.14 the longest period the assessment order may be in force, in days` TRUE FALSE FALSE EQUALS 60
#ASSERT `s 672.14 the longest period the assessment order may be in force, in days` TRUE TRUE FALSE EQUALS 60
#ASSERT `s 672.14 the longest period the assessment order may be in force, in days` FALSE TRUE TRUE EQUALS 30
#ASSERT `s 672.14 the longest period the assessment order may be in force, in days` FALSE TRUE FALSE EQUALS 5
#ASSERT `s 672.14 the longest period the assessment order may be in force, in days` FALSE FALSE FALSE EQUALS 30
#ASSERT `s 672.14 the longest period the assessment order may be in force, in days` FALSE FALSE TRUE EQUALS 30

§ `s 672.15 -- extension`
-- (2) args: days of the extension; days of the initial order together with all extensions
#ASSERT `s 672.15(2) the extension is within the maximum` 30 60 EQUALS JUST TRUE
#ASSERT `s 672.15(2) the extension is within the maximum` 31 60 EQUALS JUST FALSE
#ASSERT `s 672.15(2) the extension is within the maximum` 30 61 EQUALS JUST FALSE
#ASSERT `s 672.15(2) the extension is within the maximum` 10 40 EQUALS JUST TRUE
-- (1) args: own motion; accused or prosecutor applies; application in time; further period required; (2) answer
#ASSERT `s 672.15(1) the court or Review Board may extend the assessment order` TRUE FALSE FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 672.15(1) the court or Review Board may extend the assessment order` FALSE TRUE TRUE TRUE (JUST TRUE) EQUALS JUST TRUE
-- an application made outside the period the order is in force: the text says no
#ASSERT `s 672.15(1) the court or Review Board may extend the assessment order` FALSE TRUE FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
-- the extension is not required to complete the assessment, or exceeds (2): not covered
#ASSERT `s 672.15(1) the court or Review Board may extend the assessment order` TRUE FALSE FALSE FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 672.15(1) the court or Review Board may extend the assessment order` TRUE FALSE FALSE TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 672.15(1) the court or Review Board may extend the assessment order` FALSE FALSE FALSE TRUE (JUST TRUE) EQUALS NOTHING

§ `s 672.16 -- presumption against custody`
-- (1) args: (a) necessary on the evidence; (a) desirable on a medical practitioner's evidence; accused consents; (b) required elsewhere; (c) prosecutor shows 515(10) grounds
#ASSERT `s 672.16(1) the court is barred from detaining the accused in custody under the assessment order` FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.16(1) the court is barred from detaining the accused in custody under the assessment order` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- desirable on medical evidence is not enough without the accused's consent
#ASSERT `s 672.16(1) the court is barred from detaining the accused in custody under the assessment order` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.16(1) the court is barred from detaining the accused in custody under the assessment order` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.16(1) the court is barred from detaining the accused in custody under the assessment order` FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.16(1) the court is barred from detaining the accused in custody under the assessment order` FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- (1.1) args: Review Board orders under 672.121; currently subject to a 672.54(c) disposition; (b) necessary; (b) desirable; consents; (c) required elsewhere
#ASSERT `s 672.16(1.1) the Review Board is barred from detaining the accused in custody under its assessment order` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.16(1.1) the Review Board is barred from detaining the accused in custody under its assessment order` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.16(1.1) the Review Board is barred from detaining the accused in custody under its assessment order` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.16(1.1) the Review Board is barred from detaining the accused in custody under its assessment order` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.16(1.1) the Review Board is barred from detaining the accused in custody under its assessment order` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.16(1.1) the Review Board is barred from detaining the accused in custody under its assessment order` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.16(1.1) the Review Board is barred from detaining the accused in custody under its assessment order` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (1.2) args: subject to a 672.54(b) residence disposition; Review Board orders under 672.121; (1.1)(b) or (c) applies
#ASSERT `s 672.16(1.2) the assessment order must require the accused to reside at the same place` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.16(1.2) the assessment order must require the accused to reside at the same place` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.16(1.2) the assessment order must require the accused to reside at the same place` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.16(1.2) the assessment order must require the accused to reside at the same place` TRUE FALSE FALSE EQUALS JUST FALSE
-- (2)
#ASSERT `s 672.16(2) the evidence of a medical practitioner may be received as a written report` TRUE EQUALS JUST TRUE
#ASSERT `s 672.16(2) the evidence of a medical practitioner may be received as a written report` FALSE EQUALS NOTHING
-- (3) args: detained under 515(6) or 522(2); the accused shows that custody is not justified
#ASSERT `s 672.16(3) the assessment order must order that the accused be detained in custody` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.16(3) the assessment order must order that the accused be detained in custody` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.16(3) the assessment order must order that the accused be detained in custody` FALSE FALSE EQUALS NOTHING

§ `ss 672.17 to 672.19`
-- 672.17 args: assessment order in force; the order sought is interim release or detention for that offence; made by virtue of Part XVI or s 679
#ASSERT `s 672.17 the section bars an order for the interim release or detention of the accused` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.17 the section bars an order for the interim release or detention of the accused` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.17 the section bars an order for the interim release or detention of the accused` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 672.17 the section bars an order for the interim release or detention of the accused` TRUE TRUE FALSE EQUALS NOTHING
-- 672.18 args: assessment order made by a court in force; prosecutor or accused shows cause
#ASSERT `s 672.18 the court may vary the terms of the assessment order respecting interim release or detention` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.18 the court may vary the terms of the assessment order respecting interim release or detention` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.18 the court may vary the terms of the assessment order respecting interim release or detention` FALSE TRUE EQUALS JUST FALSE
-- 672.19
#ASSERT `s 672.19 the section bars an assessment order from directing treatment` TRUE EQUALS JUST TRUE
#ASSERT `s 672.19 the section bars an assessment order from directing treatment` FALSE EQUALS NOTHING

§ `s 672.191 -- the accused appears at the end of the assessment`
-- args: day the order begins; days in force; day the accused appears; as soon as practicable
#ASSERT `s 672.191 the accused has appeared as the section requires` (Date 1 3 2026) 30 (Date 31 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 672.191 the accused has appeared as the section requires` (Date 1 3 2026) 30 (Date 1 4 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 672.191 the accused has appeared as the section requires` (Date 1 3 2026) 30 (Date 10 3 2026) FALSE EQUALS JUST FALSE
-- the regulative rule: appears on the last day (30) -> FULFILLED; the clock passes 31 -> BREACH (traces are printed, not asserted)
#TRACE `s 672.191 the accused must appear after the assessment is completed` 30 AT 0 WITH
    PARTY `the accused` DOES `s 672.191 appear before the court or Review Board that made the order` AT 30
#TRACE `s 672.191 the accused must appear after the assessment is completed` 30 AT 0 WITH
    (WAITUNTIL 31)

§ `s 672.2 -- assessment reports`
#ASSERT `s 672.2(1) the assessment order may require a written assessment report` TRUE EQUALS JUST TRUE
#ASSERT `s 672.2(1) the assessment order may require a written assessment report` FALSE EQUALS NOTHING
#ASSERT `s 672.2(2) the assessment report has been filed as the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.2(2) the assessment report has been filed as the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.2(2) the assessment report has been filed as the subsection requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.2(3) the court must send a copy of the report to the Review Board without delay` TRUE EQUALS JUST TRUE
#ASSERT `s 672.2(3) the court must send a copy of the report to the Review Board without delay` FALSE EQUALS JUST FALSE
-- (4) args: a report has been filed; 672.51(3) requires the information to be withheld from the accused
#ASSERT `s 672.2(4) the report must be provided to the accused and counsel without delay` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.2(4) the report must be provided to the accused and counsel without delay` TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.2(4) the report must be provided to the accused and counsel without delay` FALSE FALSE EQUALS JUST FALSE

§ `s 672.21 -- protected statements`
-- (1) args: a statement made by the accused; during the course and for the purposes of an assessment or treatment directed by a disposition; to the person specified or someone acting under their direction
#ASSERT `s 672.21(1) protected statement` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.21(1) protected statement` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.21(1) protected statement` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.21(1) protected statement` FALSE TRUE TRUE EQUALS JUST FALSE
-- (3) args: (a) fitness; (b) disposition or placement decision; (c) 672.84 review; (d) balance of mind and newly-born child; (e) automatism or mental disorder; (e) capacity put into issue or prosecutor raises it after verdict; (f) credibility; (g) perjury
#ASSERT `s 672.21(3) evidence of a protected statement is admissible for the purpose` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.21(3) evidence of a protected statement is admissible for the purpose` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.21(3) evidence of a protected statement is admissible for the purpose` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.21(3) evidence of a protected statement is admissible for the purpose` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (e) needs the capacity condition
#ASSERT `s 672.21(3) evidence of a protected statement is admissible for the purpose` FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.21(3) evidence of a protected statement is admissible for the purpose` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.21(3) evidence of a protected statement is admissible for the purpose` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.21(3) evidence of a protected statement is admissible for the purpose` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- a purpose not listed: not covered (the list is not closed by "only")
#ASSERT `s 672.21(3) evidence of a protected statement is admissible for the purpose` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (2) args: protected statement (by (1)); the accused consents; proceeding before a body that can compel evidence; admissible for the purpose (by (3))
#ASSERT `s 672.21(2) the section bars the protected statement from being admitted in evidence` (JUST TRUE) FALSE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 672.21(2) the section bars the protected statement from being admitted in evidence` (JUST TRUE) FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
-- the text's own "Notwithstanding subsection (2)": an excepted purpose lifts the bar
#ASSERT `s 672.21(2) the section bars the protected statement from being admitted in evidence` (JUST TRUE) FALSE TRUE (JUST TRUE) EQUALS JUST FALSE
-- with the accused's consent the bar does not speak; before a body that cannot compel evidence it does not speak
#ASSERT `s 672.21(2) the section bars the protected statement from being admitted in evidence` (JUST TRUE) TRUE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 672.21(2) the section bars the protected statement from being admitted in evidence` (JUST TRUE) FALSE FALSE NOTHING EQUALS NOTHING
-- not a protected statement: the section does not speak; the answer of (1) is itself not covered: carried through
#ASSERT `s 672.21(2) the section bars the protected statement from being admitted in evidence` (JUST FALSE) FALSE TRUE NOTHING EQUALS NOTHING
#ASSERT `s 672.21(2) the section bars the protected statement from being admitted in evidence` NOTHING FALSE TRUE NOTHING EQUALS NOTHING
