IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc-definitions`
IMPORT `ccc14-part122-offence`

-- ccc14-tests-part122-offence.l4 -- tests for ccc14-part122-offence.l4 (Criminal Code, ss 462.3 and 462.31).
-- Every expected value is written from the text of the section named beside it, before the run; none is copied from the module's output.
-- Y = JUST TRUE; N = JUST FALSE; NA = NOTHING (not covered).

`ccc14 Y` MEANS JUST TRUE
`ccc14 N` MEANS JUST FALSE

§ `s 462.3 -- Definitions`

#ASSERT `s 462.3(1) designated drug offence as the text shows it` EQUALS "designated drug offence [Repealed, 1996, c. 19, s. 68]"
#ASSERT `s 462.3(1) designated substance offence and enterprise crime offence as the text shows them` EQUALS "designated substance offence [Repealed, 2001, c. 32, s. 12]; enterprise crime offence [Repealed, 2001, c. 32, s. 12]"

-- designated offence: args (form of the charge; the offence may be prosecuted as an indictable offence; it is an indictable offence prescribed by regulation)
#ASSERT `s 462.3(1) designated offence` `the offence itself` TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.3(1) designated offence` `a conspiracy to commit the offence` TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.3(1) designated offence` `an attempt to commit the offence` TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.3(1) designated offence` `being an accessory after the fact in relation to the offence` TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.3(1) designated offence` `counselling in relation to the offence` TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.3(1) designated offence` `the offence itself` TRUE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.3(1) designated offence` `the offence itself` FALSE FALSE EQUALS `ccc14 N`
#ASSERT `s 462.3(1) designated offence` `a conspiracy to commit the offence` FALSE FALSE EQUALS `ccc14 N`
#ASSERT `s 462.3(1) designated offence` `a form of participation that is none of those` TRUE FALSE EQUALS `ccc14 N`

-- judge: args (a judge as defined in section 552 (s 552); a judge of a superior court of criminal jurisdiction)
#ASSERT `s 462.3(1) judge` NOTHING TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.3(1) judge` `ccc14 Y` FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.3(1) judge` `ccc14 N` FALSE EQUALS `ccc14 N`
#ASSERT `s 462.3(1) judge` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 462.3(1) judge` `ccc14 N` TRUE EQUALS `ccc14 Y`

-- proceeds of crime: args (property, benefit or advantage; obtained as a result of (a) a designated offence committed in Canada (s 462.3(1)); obtained as a result of (b) an act anywhere that would have been one)
#ASSERT `s 462.3(1) proceeds of crime` TRUE `ccc14 Y` `ccc14 N` EQUALS `ccc14 Y`
#ASSERT `s 462.3(1) proceeds of crime` TRUE `ccc14 N` `ccc14 Y` EQUALS `ccc14 Y`
#ASSERT `s 462.3(1) proceeds of crime` TRUE `ccc14 N` `ccc14 N` EQUALS `ccc14 N`
#ASSERT `s 462.3(1) proceeds of crime` TRUE NOTHING `ccc14 Y` EQUALS `ccc14 Y`
#ASSERT `s 462.3(1) proceeds of crime` TRUE `ccc14 Y` NOTHING EQUALS `ccc14 Y`
#ASSERT `s 462.3(1) proceeds of crime` TRUE NOTHING `ccc14 N` EQUALS NOTHING
#ASSERT `s 462.3(1) proceeds of crime` TRUE `ccc14 N` NOTHING EQUALS NOTHING
#ASSERT `s 462.3(1) proceeds of crime` TRUE NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 462.3(1) proceeds of crime` FALSE `ccc14 Y` `ccc14 Y` EQUALS `ccc14 N`

#ASSERT `s 462.3(2) to (4) as the text shows them` EQUALS "The Governor in Council may make regulations prescribing indictable offences that are excluded from the definition designated offence in subsection (1). (3) [Repealed, 2019, c. 25, s. 179] (4) [Repealed, 2019, c. 25, s. 179]"

§ `s 462.31 -- Laundering proceeds of crime`

-- (1) args: deals with property; with intent to conceal or convert; knowing, believing or reckless; (a) designated offence in Canada (s 462.3(1)); (b) act anywhere that would have been one (s 462.3(1))
#ASSERT `s 462.31(1) the person commits the offence of laundering proceeds of crime` TRUE TRUE TRUE `ccc14 Y` `ccc14 N` EQUALS `ccc14 Y`
#ASSERT `s 462.31(1) the person commits the offence of laundering proceeds of crime` TRUE TRUE TRUE `ccc14 N` `ccc14 Y` EQUALS `ccc14 Y`
#ASSERT `s 462.31(1) the person commits the offence of laundering proceeds of crime` TRUE TRUE TRUE `ccc14 N` `ccc14 N` EQUALS NOTHING
#ASSERT `s 462.31(1) the person commits the offence of laundering proceeds of crime` TRUE TRUE TRUE NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 462.31(1) the person commits the offence of laundering proceeds of crime` FALSE TRUE TRUE `ccc14 Y` `ccc14 N` EQUALS NOTHING
#ASSERT `s 462.31(1) the person commits the offence of laundering proceeds of crime` TRUE FALSE TRUE `ccc14 Y` `ccc14 N` EQUALS NOTHING
#ASSERT `s 462.31(1) the person commits the offence of laundering proceeds of crime` TRUE TRUE FALSE `ccc14 Y` `ccc14 N` EQUALS NOTHING
#ASSERT `s 462.31(1.1) to (1.3) as the text shows them` EQUALS "(1.1) [Repealed, 2024, c. 17, s. 378] (1.2) [Repealed, 2024, c. 17, s. 378] (1.3) [Repealed, 2024, c. 17, s. 378]"

-- (2) guilty of an indictable offence and liable to imprisonment for a term not exceeding ten years, or guilty of an offence punishable on summary conviction
#ASSERT `s 462.31(2) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 462.31(2) the punishment` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 10, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), (Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)

-- (2.1) args: the person commits an offence under (1); for the benefit of, at the direction of or in association with a criminal organization; the group is a criminal organization (s 467.1(1))
#ASSERT `s 462.31(2.1) the person commits the offence of laundering proceeds of crime for a criminal organization` `ccc14 Y` TRUE `ccc14 Y` EQUALS `ccc14 Y`
#ASSERT `s 462.31(2.1) the person commits the offence of laundering proceeds of crime for a criminal organization` `ccc14 Y` FALSE `ccc14 Y` EQUALS NOTHING
#ASSERT `s 462.31(2.1) the person commits the offence of laundering proceeds of crime for a criminal organization` `ccc14 Y` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 462.31(2.1) the person commits the offence of laundering proceeds of crime for a criminal organization` NOTHING TRUE `ccc14 Y` EQUALS NOTHING
#ASSERT `s 462.31(2.1) the class of the offence` EQUALS `an indictable offence`
#ASSERT `s 462.31(2.1) the punishment` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 14, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)

-- (2.2) args: the prosecution is for an offence under (1) or (2.1); the accused is also charged with the designated offence
#ASSERT `s 462.31(2.2) it is necessary for the prosecutor to prove that the accused knew, believed they knew or was reckless as to the specific nature of the designated offence` TRUE FALSE EQUALS `ccc14 N`
#ASSERT `s 462.31(2.2) it is necessary for the prosecutor to prove that the accused knew, believed they knew or was reckless as to the specific nature of the designated offence` TRUE TRUE EQUALS NOTHING
#ASSERT `s 462.31(2.2) it is necessary for the prosecutor to prove that the accused knew, believed they knew or was reckless as to the specific nature of the designated offence` FALSE FALSE EQUALS NOTHING

-- (2.3) args: markedly unusual; inconsistent with lawful activities typical of the sector; the accused is also charged with the designated offence
#ASSERT `s 462.31(2.3) the court may infer that the accused had the knowledge or belief or demonstrated the recklessness referred to in subsection (1)` TRUE FALSE FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.31(2.3) the court may infer that the accused had the knowledge or belief or demonstrated the recklessness referred to in subsection (1)` FALSE TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.31(2.3) the court may infer that the accused had the knowledge or belief or demonstrated the recklessness referred to in subsection (1)` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 462.31(2.3) the court may infer that the accused had the knowledge or belief or demonstrated the recklessness referred to in subsection (1)` TRUE TRUE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.31(2.3) the court may infer that the accused had the knowledge or belief or demonstrated the recklessness referred to in subsection (1)` FALSE FALSE TRUE EQUALS `ccc14 N`

-- (2.4)
#ASSERT `s 462.31(2.4) subsections (2.2) and (2.3) do not apply` TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.31(2.4) subsections (2.2) and (2.3) do not apply` FALSE EQUALS NOTHING

-- (3) args: a peace officer or a person acting under the direction of one; for the purposes of an investigation or in the execution of their duties
#ASSERT `s 462.31(3) the person is not guilty of an offence under subsection (1) or (2.1)` TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.31(3) the person is not guilty of an offence under subsection (1) or (2.1)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 462.31(3) the person is not guilty of an offence under subsection (1) or (2.1)` FALSE TRUE EQUALS NOTHING
