IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc32-related-3`

-- ccc32-tests-related-3.l4 -- tests for ccc32-related-3.l4 (2024 c. 22 s. 8 to 2026 c. 19 s. 118).
-- Every expected value is decided by reading the provision, and written beside the assertion. A failing assertion is a finding.
-- The days are made-up days (the commencement days and the days of royal assent are not in the sources); the arithmetic on them is calendar arithmetic done by hand.

§ `2024 c. 22 s. 8`

-- Commencement 1 January 2025 (made up). Laid before it, fear of personal injury, no final determination: the person at risk decides.
#ASSERT `2024 c 22 s 8 the information is deemed to have been laid under subsection 810.03(1)` (Date 1 1 2025) (Date 31 12 2024) TRUE (JUST TRUE) FALSE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `2024 c 22 s 8 the information is deemed to have been laid under subsection 810.03(1)` (Date 1 1 2025) (Date 31 12 2024) TRUE (JUST FALSE) TRUE (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `2024 c 22 s 8 the information is deemed to have been laid under subsection 810.03(1)` (Date 1 1 2025) (Date 31 12 2024) TRUE (JUST FALSE) FALSE (JUST TRUE) TRUE EQUALS JUST TRUE
-- a person at risk outside the three classes: the text's no (the class is named in the "if").
#ASSERT `2024 c 22 s 8 the information is deemed to have been laid under subsection 810.03(1)` (Date 1 1 2025) (Date 31 12 2024) TRUE (JUST FALSE) FALSE (JUST FALSE) TRUE EQUALS JUST FALSE
-- section 2 "intimate partner" not covered, and no other class holds: not covered. A child of the other person settles it whatever the partner answer is.
#ASSERT `2024 c 22 s 8 the information is deemed to have been laid under subsection 810.03(1)` (Date 1 1 2025) (Date 31 12 2024) TRUE NOTHING FALSE (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `2024 c 22 s 8 the information is deemed to have been laid under subsection 810.03(1)` (Date 1 1 2025) (Date 31 12 2024) TRUE (JUST FALSE) FALSE NOTHING TRUE EQUALS NOTHING
#ASSERT `2024 c 22 s 8 the information is deemed to have been laid under subsection 810.03(1)` (Date 1 1 2025) (Date 31 12 2024) TRUE NOTHING TRUE (JUST FALSE) TRUE EQUALS JUST TRUE
-- each limb of the "if" failing is the text's no: laid ON the day (not before it), no fear on reasonable grounds, a final determination already made.
#ASSERT `2024 c 22 s 8 the information is deemed to have been laid under subsection 810.03(1)` (Date 1 1 2025) (Date 1 1 2025) TRUE (JUST TRUE) FALSE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `2024 c 22 s 8 the information is deemed to have been laid under subsection 810.03(1)` (Date 1 1 2025) (Date 31 12 2024) FALSE (JUST TRUE) FALSE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `2024 c 22 s 8 the information is deemed to have been laid under subsection 810.03(1)` (Date 1 1 2025) (Date 31 12 2024) TRUE (JUST TRUE) FALSE (JUST FALSE) FALSE EQUALS JUST FALSE

§ `2024 c. 23 s. 13`

#ASSERT `2024 c 23 s 13 the amendments made by 2024, c. 23 affect the validity of the proceedings` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `2024 c 23 s 13 the amendments made by 2024, c. 23 affect the validity of the proceedings` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `2024 c 23 s 13 the amendments made by 2024, c. 23 affect the validity of the proceedings` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `2024 c 23 s 13 the amendments made by 2024, c. 23 affect the validity of the proceedings` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `2024 c 23 s 13 the amendments made by 2024, c. 23 affect the validity of the document` TRUE EQUALS JUST FALSE
#ASSERT `2024 c 23 s 13 the amendments made by 2024, c. 23 affect the validity of the document` FALSE EQUALS NOTHING
#ASSERT `2024 c 23 s 13 the reference to child pornography in the document is read as a reference to` TRUE TRUE EQUALS JUST "child sexual abuse and exploitation material"
#ASSERT `2024 c 23 s 13 the reference to child pornography in the document is read as a reference to` TRUE FALSE EQUALS NOTHING
#ASSERT `2024 c 23 s 13 the reference to child pornography in the document is read as a reference to` FALSE TRUE EQUALS NOTHING

§ `2026 c. 11 ss. 56 to 58`

#ASSERT `2026 c 11 s 56 the word or expression has the same meaning as in the Criminal Code` TRUE FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `2026 c 11 s 56 the word or expression has the same meaning as in the Criminal Code` TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `2026 c 11 s 56 the word or expression has the same meaning as in the Criminal Code` TRUE FALSE NOTHING EQUALS NOTHING
-- "Unless the context requires otherwise": met -> the text's no.
#ASSERT `2026 c 11 s 56 the word or expression has the same meaning as in the Criminal Code` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `2026 c 11 s 56 the word or expression has the same meaning as in the Criminal Code` FALSE FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `2026 c 11 s 57 the provisions of the Criminal Code enacted by sections 41 and 42 apply to the proceeds of the fine` TRUE EQUALS JUST TRUE
#ASSERT `2026 c 11 s 57 the provisions of the Criminal Code enacted by sections 41 and 42 apply to the proceeds of the fine` FALSE EQUALS NOTHING

-- 2026 c 11 s 58(1): the day is 2020-03-15; "on or after the day": the day itself is within.
#ASSERT `2026 c 11 s 58(1) the offence is within the limit on the provisions enacted by sections 8, 9, 11, 37, 40 and 43` (Date 15 3 2020) (Date 14 3 2020) EQUALS JUST FALSE
#ASSERT `2026 c 11 s 58(1) the offence is within the limit on the provisions enacted by sections 8, 9, 11, 37, 40 and 43` (Date 15 3 2020) (Date 15 3 2020) EQUALS JUST TRUE
#ASSERT `2026 c 11 s 58(1) the offence is within the limit on the provisions enacted by sections 8, 9, 11, 37, 40 and 43` (Date 15 3 2020) (Date 16 3 2020) EQUALS JUST TRUE


-- 2026 c 11 s 58(2): ongoing on the day -> applies; not ongoing -> NOT COVERED (never FALSE).
#ASSERT `2026 c 11 s 58(2) the amendments to Parts XVI and XXVIII made by 2026, c. 11 apply to the matter or proceeding` TRUE EQUALS JUST TRUE
#ASSERT `2026 c 11 s 58(2) the amendments to Parts XVI and XXVIII made by 2026, c. 11 apply to the matter or proceeding` FALSE EQUALS NOTHING


-- 2026 c 11 s 58(3): ongoing on the day -> applies; not ongoing -> NOT COVERED (never FALSE).
#ASSERT `2026 c 11 s 58(3) the provisions enacted by sections 10, 34 to 36, 38 and 39 of 2026, c. 11 apply to the matter or proceeding` TRUE EQUALS JUST TRUE
#ASSERT `2026 c 11 s 58(3) the provisions enacted by sections 10, 34 to 36, 38 and 39 of 2026, c. 11 apply to the matter or proceeding` FALSE EQUALS NOTHING


§ `2026 c. 12 ss. 15 and 16`

-- 2026 c 12 s 15: royal assent 2027-01-10, so the 30th day after it is 2027-02-09; "before" that day is 2027-02-08 and earlier.
#ASSERT `2026 c 12 s 15 subsection 236(2) applies to the offence` (Date 10 1 2027) (Date 8 2 2027) EQUALS JUST FALSE
#ASSERT `2026 c 12 s 15 subsection 236(2) applies to the offence` (Date 10 1 2027) (Date 9 2 2027) EQUALS NOTHING
#ASSERT `2026 c 12 s 15 subsection 236(2) applies to the offence` (Date 10 1 2027) (Date 10 2 2027) EQUALS NOTHING


