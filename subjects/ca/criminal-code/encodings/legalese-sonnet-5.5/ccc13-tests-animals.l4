IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc13-animals`
IMPORT `ccc13-tests-support`

-- ccc13-tests-animals.l4 -- tests of ccc13-animals.l4 (ss 444 to 447.1). Expected values are decided from the text.
-- The date of the coming into force of section 445.2(2.1) is not in the text: the dates below are made up to test the period, and claim nothing about the real day.

`ccc13 test the hybrid class` MEANS `an offence that the section makes both indictable and punishable on summary conviction`
`ccc13 test two years less a day` MEANS `imprisonment for a term of` `two years less a day`

§ `s 444 and s 445`
#ASSERT `s 444 as the text shows it` EQUALS "444 [Repealed, 2018, c. 29, s. 52]"
-- inputs of 445(1): wilfully; without lawful excuse; kills, maims, wounds, poisons or injures; places poison; the animals are kept for a lawful purpose
#ASSERT `s 445(1) the conduct is the offence of injuring or endangering other animals` TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 445(1) the conduct is the offence of injuring or endangering other animals` TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE       -- (b) places poison
#ASSERT `s 445(1) the conduct is the offence of injuring or endangering other animals` FALSE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 445(1) the conduct is the offence of injuring or endangering other animals` TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE      -- with lawful excuse
#ASSERT `s 445(1) the conduct is the offence of injuring or endangering other animals` TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 445(1) the conduct is the offence of injuring or endangering other animals` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE      -- animals not kept for a lawful purpose
#ASSERT `ccc13 test the number of limbs` (`s 445(2) the punishments`) EQUALS 2
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 445(2) the punishments`) EQUALS `imprisonment for a term of` `five years`
#ASSERT `ccc13 test the maximum imprisonment on summary conviction` (`s 445(2) the punishments`) EQUALS `ccc13 test two years less a day`
#ASSERT `ccc13 test the maximum fine on summary conviction` (`s 445(2) the punishments`) EQUALS `a fine of` 10000
#ASSERT `s 445(2) the class of the offence` EQUALS `ccc13 test the hybrid class`

§ `s 445.01 killing or injuring certain animals`
#ASSERT `s 445.01(4) the animal is a law enforcement animal` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 445.01(4) the animal is a law enforcement animal` FALSE TRUE EQUALS JUST FALSE       -- neither a dog nor a horse
#ASSERT `s 445.01(4) the animal is a law enforcement animal` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 445.01(4) the person is a law enforcement officer` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 445.01(4) the person is a law enforcement officer` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 445.01(4) the person is a law enforcement officer` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 445.01(4) the animal is a military animal` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 445.01(4) the animal is a military animal` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 445.01(4) the animal is a service animal` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 445.01(4) the animal is a service animal` TRUE FALSE EQUALS JUST FALSE      -- not certified in writing
#ASSERT `s 445.01(4) the animal is a service animal` FALSE TRUE EQUALS JUST FALSE
-- inputs of (1): wilfully; without lawful excuse; kills or injures; law enforcement animal (s 445.01(4)); aiding a law enforcement officer; military animal; aiding a member of the Canadian Forces; service animal
#ASSERT `s 445.01(1) the conduct is the offence of killing or injuring certain animals` TRUE TRUE TRUE (JUST TRUE) TRUE (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 445.01(1) the conduct is the offence of killing or injuring certain animals` TRUE TRUE TRUE (JUST FALSE) FALSE (JUST TRUE) TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 445.01(1) the conduct is the offence of killing or injuring certain animals` TRUE TRUE TRUE (JUST FALSE) FALSE (JUST FALSE) FALSE (JUST TRUE) EQUALS JUST TRUE      -- a service animal: no aiding element
#ASSERT `s 445.01(1) the conduct is the offence of killing or injuring certain animals` TRUE TRUE TRUE (JUST TRUE) FALSE (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST FALSE     -- a law enforcement animal not then aiding an officer
#ASSERT `s 445.01(1) the conduct is the offence of killing or injuring certain animals` TRUE TRUE TRUE (JUST FALSE) FALSE (JUST TRUE) FALSE (JUST FALSE) EQUALS JUST FALSE     -- a military animal not then aiding a member
#ASSERT `s 445.01(1) the conduct is the offence of killing or injuring certain animals` TRUE TRUE TRUE (JUST FALSE) FALSE (JUST FALSE) FALSE NOTHING EQUALS NOTHING
#ASSERT `s 445.01(1) the conduct is the offence of killing or injuring certain animals` FALSE TRUE TRUE (JUST TRUE) TRUE (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 445.01(1) the conduct is the offence of killing or injuring certain animals` TRUE FALSE TRUE (JUST TRUE) TRUE (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 445.01(1) the conduct is the offence of killing or injuring certain animals` TRUE TRUE FALSE (JUST TRUE) TRUE (JUST FALSE) FALSE (JUST FALSE) EQUALS JUST FALSE
-- (2): the minimum of six months applies to the indictable limb only, and only if a law enforcement animal is killed
#ASSERT `ccc13 test the minimum imprisonment by indictment` (`s 445.01(2) the punishments` TRUE) EQUALS `imprisonment for a term of` `six months`
#ASSERT `ccc13 test the minimum imprisonment by indictment` (`s 445.01(2) the punishments` FALSE) EQUALS `no imprisonment is stated`
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`s 445.01(2) the punishments` TRUE) EQUALS `imprisonment for a term of` `five years`
#ASSERT `ccc13 test the minimum imprisonment on summary conviction` (`s 445.01(2) the punishments` TRUE) EQUALS `no imprisonment is stated`
#ASSERT `ccc13 test the maximum imprisonment on summary conviction` (`s 445.01(2) the punishments` TRUE) EQUALS `ccc13 test two years less a day`
#ASSERT `ccc13 test the maximum fine on summary conviction` (`s 445.01(2) the punishments` TRUE) EQUALS `a fine of` 10000
#ASSERT `s 445.01(2) the class of the offence` EQUALS `ccc13 test the hybrid class`
#ASSERT `s 445.01(3) the sentence shall be served consecutively to the other punishment` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 445.01(3) the sentence shall be served consecutively to the other punishment` FALSE TRUE EQUALS JUST FALSE      -- an offence against another kind of animal
#ASSERT `s 445.01(3) the sentence shall be served consecutively to the other punishment` TRUE FALSE EQUALS NOTHING         -- a punishment for an unrelated offence

