        IF NOT `s 7 the offence is in section` offence 431.2 THEN NOTHING   -- NOTHING-kind (limited by its own wording): "section 431.2"
        IF relation EQUALS `s 7 the act or omission has none of those relations to the offence` THEN NOTHING   -- NOTHING-kind (limited by its own wording): "would constitute an offence against, a conspiracy or an attempt to commit an offence against, or being an accessory after the fact or counselling in relation to an offence against"
