IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc1-s21-24-parties`

-- ccc1-tests-s21-24-parties.l4 -- tests for sections 21 to 24 of the Criminal Code (Canada). Expected values are written by hand from the text of each section.
-- Arguments are positional, in GIVEN order.

§ `s 21(1)  (actually commits it; does or omits to do anything for the purpose of aiding; abets)`
#ASSERT `s 21(1) the subsection makes the person a party to the offence` TRUE FALSE FALSE EQUALS JUST TRUE   -- (a) actually commits it
#ASSERT `s 21(1) the subsection makes the person a party to the offence` FALSE TRUE FALSE EQUALS JUST TRUE   -- (b) aids
#ASSERT `s 21(1) the subsection makes the person a party to the offence` FALSE FALSE TRUE EQUALS JUST TRUE   -- (c) abets
#ASSERT `s 21(1) the subsection makes the person a party to the offence` TRUE TRUE TRUE EQUALS JUST TRUE   -- all three
#ASSERT `s 21(1) the subsection makes the person a party to the offence` FALSE FALSE FALSE EQUALS NOTHING   -- none of the three: another provision may still make the person a party

§ `s 21(2)  (common intention; one of them commits an offence; knew; ought to have known)`
#ASSERT `s 21(2) the subsection makes the person a party to the offence committed in carrying out the common purpose` TRUE TRUE TRUE FALSE EQUALS JUST TRUE   -- knew
#ASSERT `s 21(2) the subsection makes the person a party to the offence committed in carrying out the common purpose` TRUE TRUE FALSE TRUE EQUALS JUST TRUE   -- ought to have known
#ASSERT `s 21(2) the subsection makes the person a party to the offence committed in carrying out the common purpose` TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- both
#ASSERT `s 21(2) the subsection makes the person a party to the offence committed in carrying out the common purpose` TRUE TRUE FALSE FALSE EQUALS NOTHING   -- neither knew nor ought to have known: the "who" clause is not met
#ASSERT `s 21(2) the subsection makes the person a party to the offence committed in carrying out the common purpose` FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- no intention in common: "Where two or more persons form an intention in common"
#ASSERT `s 21(2) the subsection makes the person a party to the offence committed in carrying out the common purpose` TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- none of them commits an offence
#ASSERT `s 21(2) the subsection makes the person a party to the offence committed in carrying out the common purpose` FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- neither

§ `s 22(1)  (counsels; the other is afterwards a party; committed in a different way)`
#ASSERT `s 22(1) the subsection makes the person who counselled a party to the offence` TRUE TRUE FALSE EQUALS JUST TRUE   -- the offence as counselled
#ASSERT `s 22(1) the subsection makes the person who counselled a party to the offence` TRUE TRUE TRUE EQUALS JUST TRUE   -- committed in a different way: "notwithstanding"
#ASSERT `s 22(1) the subsection makes the person who counselled a party to the offence` TRUE FALSE FALSE EQUALS JUST FALSE   -- the other person is not afterwards a party
#ASSERT `s 22(1) the subsection makes the person who counselled a party to the offence` FALSE TRUE FALSE EQUALS JUST FALSE   -- no counselling
#ASSERT `s 22(1) the subsection makes the person who counselled a party to the offence` FALSE FALSE TRUE EQUALS JUST FALSE   -- neither

§ `s 22(2)  (counsels; the other commits the offence in consequence; knew likely; ought to have known likely)`
#ASSERT `s 22(2) the subsection makes the person who counselled a party to the offence the other commits` TRUE TRUE TRUE FALSE EQUALS JUST TRUE   -- knew
#ASSERT `s 22(2) the subsection makes the person who counselled a party to the offence the other commits` TRUE TRUE FALSE TRUE EQUALS JUST TRUE   -- ought to have known
#ASSERT `s 22(2) the subsection makes the person who counselled a party to the offence the other commits` TRUE TRUE FALSE FALSE EQUALS NOTHING   -- neither knew nor ought to have known it was likely
#ASSERT `s 22(2) the subsection makes the person who counselled a party to the offence the other commits` FALSE TRUE TRUE TRUE EQUALS NOTHING   -- no counselling
#ASSERT `s 22(2) the subsection makes the person who counselled a party to the offence the other commits` TRUE FALSE TRUE TRUE EQUALS NOTHING   -- not committed in consequence of the counselling

§ `s 22(3)  (what counsel includes)`
#ASSERT `s 22(3) the conduct is counselling for the purposes of this Act` `s 22(3) counselling in its ordinary sense` EQUALS JUST TRUE   -- counsel
#ASSERT `s 22(3) the conduct is counselling for the purposes of this Act` `s 22(3) procuring` EQUALS JUST TRUE   -- procure
#ASSERT `s 22(3) the conduct is counselling for the purposes of this Act` `s 22(3) soliciting` EQUALS JUST TRUE   -- solicit
#ASSERT `s 22(3) the conduct is counselling for the purposes of this Act` `s 22(3) inciting` EQUALS JUST TRUE   -- incite
#ASSERT `s 22(3) the conduct is counselling for the purposes of this Act` `s 22(3) conduct that is none of those` EQUALS NOTHING   -- "includes": not closed

§ `s 22.1  (negligence offence; organization by s 2; representative by s 2; senior officer by s 2; (a)(i); (a)(ii); (b) one officer; (b) officers collectively)`
#ASSERT `s 22.1 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (a)(i) and (b) the responsible senior officer departs markedly
#ASSERT `s 22.1 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) FALSE TRUE FALSE TRUE EQUALS JUST TRUE   -- (a)(ii) and (b) the senior officers collectively depart
#ASSERT `s 22.1 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) FALSE FALSE TRUE FALSE EQUALS JUST FALSE   -- paragraph (a) is not met
#ASSERT `s 22.1 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- paragraph (b) is not met
#ASSERT `s 22.1 the section makes the organization a party to the offence` FALSE (JUST TRUE) (JUST TRUE) (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS NOTHING   -- not an offence requiring proof of negligence
#ASSERT `s 22.1 the section makes the organization a party to the offence` TRUE (JUST FALSE) (JUST TRUE) (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS NOTHING   -- the accused is not an organization
#ASSERT `s 22.1 the section makes the organization a party to the offence` TRUE NOTHING (JUST TRUE) (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS NOTHING   -- section 2 did not answer
#ASSERT `s 22.1 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST FALSE) (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS JUST FALSE   -- the person acting is not a representative
#ASSERT `s 22.1 the section makes the organization a party to the offence` TRUE (JUST TRUE) NOTHING (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS NOTHING   -- section 2 did not answer for representative
#ASSERT `s 22.1 the section makes the organization a party to the offence` TRUE (JUST TRUE) NOTHING (JUST TRUE) FALSE FALSE TRUE FALSE EQUALS JUST FALSE   -- (a) fails on the facts whatever representative means
#ASSERT `s 22.1 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST TRUE) (JUST FALSE) TRUE FALSE TRUE FALSE EQUALS JUST FALSE   -- the officer is not a senior officer
#ASSERT `s 22.1 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST TRUE) NOTHING TRUE FALSE TRUE FALSE EQUALS NOTHING   -- section 2 did not answer for senior officer

§ `s 22.2  (fault other than negligence; organization by s 2; senior officer by s 2; intent to benefit; (a); (b); (c))`
#ASSERT `s 22.2 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- (a) the senior officer is a party
#ASSERT `s 22.2 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- (b) directs the work of others
#ASSERT `s 22.2 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- (c) does not take all reasonable measures to stop them
#ASSERT `s 22.2 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST TRUE) FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- no intent at least in part to benefit the organization
#ASSERT `s 22.2 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- none of (a), (b) and (c)
#ASSERT `s 22.2 the section makes the organization a party to the offence` FALSE (JUST TRUE) (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS NOTHING   -- not an offence requiring proof of fault other than negligence
#ASSERT `s 22.2 the section makes the organization a party to the offence` TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS NOTHING   -- not an organization
#ASSERT `s 22.2 the section makes the organization a party to the offence` TRUE NOTHING (JUST TRUE) TRUE TRUE FALSE FALSE EQUALS NOTHING   -- section 2 did not answer
#ASSERT `s 22.2 the section makes the organization a party to the offence` TRUE (JUST TRUE) (JUST FALSE) TRUE TRUE FALSE FALSE EQUALS JUST FALSE   -- the person acting is not a senior officer
#ASSERT `s 22.2 the section makes the organization a party to the offence` TRUE (JUST TRUE) NOTHING TRUE TRUE FALSE FALSE EQUALS NOTHING   -- section 2 did not answer for senior officer
#ASSERT `s 22.2 the section makes the organization a party to the offence` TRUE (JUST TRUE) NOTHING FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- no intent: fails whatever senior officer means

§ `s 23, s 23.1`
#ASSERT `s 23(1) the person is an accessory after the fact to the offence` TRUE TRUE TRUE EQUALS JUST TRUE   -- knowing, receives, comforts or assists, to enable escape
#ASSERT `s 23(1) the person is an accessory after the fact to the offence` FALSE TRUE TRUE EQUALS NOTHING   -- does not know that the other person was a party
#ASSERT `s 23(1) the person is an accessory after the fact to the offence` TRUE FALSE TRUE EQUALS NOTHING   -- does not receive, comfort or assist
#ASSERT `s 23(1) the person is an accessory after the fact to the offence` TRUE TRUE FALSE EQUALS NOTHING   -- not for the purpose of enabling escape
#ASSERT `s 23(2) as the text shows it` EQUALS "[Repealed, 2000, c. 12, s. 92]"   -- repealed
#ASSERT `s 23.1 sections 21 to 23 apply in respect of the accused although the other person cannot be convicted` TRUE EQUALS JUST TRUE   -- the other cannot be convicted
#ASSERT `s 23.1 sections 21 to 23 apply in respect of the accused although the other person cannot be convicted` FALSE EQUALS NOTHING   -- the other can be convicted: the section is silent

§ `s 24  (intent; does or omits to do anything for the purpose; possible in the circumstances)`
#ASSERT `s 24(1) the person is guilty of an attempt to commit the offence` TRUE TRUE TRUE EQUALS JUST TRUE   -- intent and an act for the purpose, possible
#ASSERT `s 24(1) the person is guilty of an attempt to commit the offence` TRUE TRUE FALSE EQUALS JUST TRUE   -- "whether or not it was possible under the circumstances"
#ASSERT `s 24(1) the person is guilty of an attempt to commit the offence` TRUE FALSE TRUE EQUALS NOTHING   -- no act for the purpose of carrying out the intention
#ASSERT `s 24(1) the person is guilty of an attempt to commit the offence` FALSE TRUE TRUE EQUALS NOTHING   -- no intent to commit an offence
#ASSERT `s 24(2) the question is a question of law` TRUE EQUALS JUST TRUE   -- mere preparation and too remote: a question of law
#ASSERT `s 24(2) the question is a question of law` FALSE EQUALS NOTHING   -- another question
