IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc23-reviews`

-- ccc23-tests-reviews.l4 -- tests for sections 672.81 to 672.852. Expected values are written from the text, never copied from the code.

§ `s 672.81`
-- (1.3) args: the offence (a section of the Code); an indictable offence; an attempt to commit the offence; (a)(i) violence or attempted violence against another person; (a)(ii) conduct endangering life or safety or inflicting severe psychological damage
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 999, "") TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 999, "") TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- an offence that is not indictable is outside limb (a), whatever it involves
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 999, "") FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- indictable but involving neither violence nor endangering conduct, and not a listed section
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 999, "") TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- limb (b): each of the twelve sections named, as an indictable offence with none of the (a) facts
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 151, "") TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 152, "") TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 153, "") TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 153.1, "") TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 155, "") TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 160, "") TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 170, "") TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 171, "") TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 172, "") TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 271, "(1)") TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 272, "") TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 273, "") TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- limb (b), an attempt to commit the listed offence, which need not be indictable on its own
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 271, "") FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- a listed section that is neither indictable nor an attempt
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 271, "") FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- sections next to the list are not in it
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 154, "") TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 274, "") TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- an attempt of an offence outside the list and outside (a)
#ASSERT `s 672.81(1.3) serious personal injury offence` (`Provision of the Code` OF 999, "") FALSE TRUE FALSE FALSE EQUALS JUST FALSE

-- (1) the duty as a decision function. args: reviewing a disposition other than an absolute discharge under 672.54(a); the day the disposition was made or last reviewed; the day the hearing is held; the months allowed
#ASSERT `s 672.81(1) the Review Board has held the hearing in time` TRUE (Date 1 1 2026) (Date 1 1 2027) 12 EQUALS JUST TRUE
#ASSERT `s 672.81(1) the Review Board has held the hearing in time` TRUE (Date 1 1 2026) (Date 2 1 2027) 12 EQUALS JUST FALSE
#ASSERT `s 672.81(1) the Review Board has held the hearing in time` TRUE (Date 1 1 2026) (Date 2 1 2027) 24 EQUALS JUST TRUE
#ASSERT `s 672.81(1) the Review Board has held the hearing in time` TRUE (Date 1 1 2026) (Date 1 1 2028) 24 EQUALS JUST TRUE
#ASSERT `s 672.81(1) the Review Board has held the hearing in time` TRUE (Date 1 1 2026) (Date 2 1 2028) 24 EQUALS JUST FALSE
#ASSERT `s 672.81(1) the Review Board has held the hearing in time` TRUE (Date 1 1 2026) (Date 1 1 2029) 36 EQUALS JUST TRUE
#ASSERT `s 672.81(1) the Review Board has held the hearing in time` TRUE (Date 1 1 2026) (Date 2 1 2029) 36 EQUALS JUST FALSE
-- a hearing before the day is in time too
#ASSERT `s 672.81(1) the Review Board has held the hearing in time` TRUE (Date 1 1 2026) (Date 1 6 2026) 12 EQUALS JUST TRUE
-- an absolute discharge under paragraph 672.54(a) is outside the duty
#ASSERT `s 672.81(1) the Review Board has held the hearing in time` FALSE (Date 1 1 2026) (Date 1 1 2028) 12 EQUALS NOTHING
-- (1) the regulative rule: from 1 January 2026 the twelve months end on 1 January 2027, which is day 365; a leap day in between makes it 366 (from 1 March 2027 to 1 March 2028)
#TRACE `s 672.81(1) the Review Board must hold a hearing within twelve months` (Date 1 1 2026) AT 0 WITH
    PARTY `a Review Board` DOES `s 672.81(1) hold a hearing to review the disposition` AT 365
#TRACE `s 672.81(1) the Review Board must hold a hearing within twelve months` (Date 1 1 2026) AT 0 WITH
    (WAITUNTIL 366)
#TRACE `s 672.81(1) the Review Board must hold a hearing within twelve months` (Date 1 3 2027) AT 0 WITH
    PARTY `a Review Board` DOES `s 672.81(1) hold a hearing to review the disposition` AT 366
#TRACE `s 672.81(1) the Review Board must hold a hearing within twelve months` (Date 1 3 2027) AT 0 WITH
    (WAITUNTIL 367)

-- (1.1) args: represented by counsel; the accused consents; the Attorney General consents; the months to which the time is extended (maximum 24)
#ASSERT `s 672.81(1.1) the Review Board may extend the time for holding the hearing to a maximum of twenty-four months` TRUE TRUE TRUE 24 EQUALS JUST TRUE
#ASSERT `s 672.81(1.1) the Review Board may extend the time for holding the hearing to a maximum of twenty-four months` TRUE TRUE TRUE 18 EQUALS JUST TRUE
#ASSERT `s 672.81(1.1) the Review Board may extend the time for holding the hearing to a maximum of twenty-four months` TRUE TRUE TRUE 25 EQUALS JUST FALSE
#ASSERT `s 672.81(1.1) the Review Board may extend the time for holding the hearing to a maximum of twenty-four months` FALSE TRUE TRUE 24 EQUALS NOTHING
#ASSERT `s 672.81(1.1) the Review Board may extend the time for holding the hearing to a maximum of twenty-four months` TRUE FALSE TRUE 24 EQUALS NOTHING
#ASSERT `s 672.81(1.1) the Review Board may extend the time for holding the hearing to a maximum of twenty-four months` TRUE TRUE FALSE 24 EQUALS NOTHING
-- the cap is checked first
#ASSERT `s 672.81(1.1) the Review Board may extend the time for holding the hearing to a maximum of twenty-four months` FALSE FALSE FALSE 30 EQUALS JUST FALSE

-- (1.2) args: at the conclusion of a hearing, after making a disposition; (a) NCR for a serious personal injury offence (the answer of (1.3)); (b) subject to a 672.54(c) disposition; (c) the Board is satisfied; the months to which the time is extended (maximum 24)
#ASSERT `s 672.81(1.2) the Review Board may extend the time for holding a subsequent hearing to a maximum of twenty-four months` TRUE (JUST TRUE) TRUE TRUE 24 EQUALS JUST TRUE
#ASSERT `s 672.81(1.2) the Review Board may extend the time for holding a subsequent hearing to a maximum of twenty-four months` TRUE (JUST TRUE) TRUE TRUE 25 EQUALS JUST FALSE
#ASSERT `s 672.81(1.2) the Review Board may extend the time for holding a subsequent hearing to a maximum of twenty-four months` FALSE (JUST TRUE) TRUE TRUE 24 EQUALS NOTHING
#ASSERT `s 672.81(1.2) the Review Board may extend the time for holding a subsequent hearing to a maximum of twenty-four months` TRUE (JUST FALSE) TRUE TRUE 24 EQUALS NOTHING
#ASSERT `s 672.81(1.2) the Review Board may extend the time for holding a subsequent hearing to a maximum of twenty-four months` TRUE NOTHING TRUE TRUE 24 EQUALS NOTHING
#ASSERT `s 672.81(1.2) the Review Board may extend the time for holding a subsequent hearing to a maximum of twenty-four months` TRUE (JUST TRUE) FALSE TRUE 24 EQUALS NOTHING
#ASSERT `s 672.81(1.2) the Review Board may extend the time for holding a subsequent hearing to a maximum of twenty-four months` TRUE (JUST TRUE) TRUE FALSE 24 EQUALS NOTHING

-- (1.31) args: a high-risk accused; represented by counsel; the accused consents; the Attorney General consents; the months to which the time is extended (maximum 36)
#ASSERT `s 672.81(1.31) the Review Board may extend the time for holding a hearing in respect of a high-risk accused to a maximum of 36 months` TRUE TRUE TRUE TRUE 36 EQUALS JUST TRUE
#ASSERT `s 672.81(1.31) the Review Board may extend the time for holding a hearing in respect of a high-risk accused to a maximum of 36 months` TRUE TRUE TRUE TRUE 37 EQUALS JUST FALSE
#ASSERT `s 672.81(1.31) the Review Board may extend the time for holding a hearing in respect of a high-risk accused to a maximum of 36 months` FALSE TRUE TRUE TRUE 36 EQUALS NOTHING
#ASSERT `s 672.81(1.31) the Review Board may extend the time for holding a hearing in respect of a high-risk accused to a maximum of 36 months` TRUE FALSE TRUE TRUE 36 EQUALS NOTHING
#ASSERT `s 672.81(1.31) the Review Board may extend the time for holding a hearing in respect of a high-risk accused to a maximum of 36 months` TRUE TRUE FALSE TRUE 36 EQUALS NOTHING
#ASSERT `s 672.81(1.31) the Review Board may extend the time for holding a hearing in respect of a high-risk accused to a maximum of 36 months` TRUE TRUE TRUE FALSE 36 EQUALS NOTHING
-- not a high-risk accused: the provision does not speak, whatever the months
#ASSERT `s 672.81(1.31) the Review Board may extend the time for holding a hearing in respect of a high-risk accused to a maximum of 36 months` FALSE TRUE TRUE TRUE 37 EQUALS NOTHING

-- (1.32) args: a high-risk accused; at the conclusion of a hearing under 672.47(4) or 672.81, after making a disposition; the Board is satisfied; the months to which the time is extended (maximum 36)
#ASSERT `s 672.81(1.32) the Review Board may extend the time for holding a subsequent hearing in respect of a high-risk accused to a maximum of 36 months` TRUE TRUE TRUE 36 EQUALS JUST TRUE
#ASSERT `s 672.81(1.32) the Review Board may extend the time for holding a subsequent hearing in respect of a high-risk accused to a maximum of 36 months` TRUE TRUE TRUE 37 EQUALS JUST FALSE
#ASSERT `s 672.81(1.32) the Review Board may extend the time for holding a subsequent hearing in respect of a high-risk accused to a maximum of 36 months` FALSE TRUE TRUE 36 EQUALS NOTHING
#ASSERT `s 672.81(1.32) the Review Board may extend the time for holding a subsequent hearing in respect of a high-risk accused to a maximum of 36 months` TRUE FALSE TRUE 36 EQUALS NOTHING
#ASSERT `s 672.81(1.32) the Review Board may extend the time for holding a subsequent hearing in respect of a high-risk accused to a maximum of 36 months` TRUE TRUE FALSE 36 EQUALS NOTHING

-- the longest time before the next hearing. args: (1.1) open; (1.2) open; (1.31) open; (1.32) open
#ASSERT `s 672.81 the longest time before the next hearing, in months` NOTHING NOTHING NOTHING NOTHING EQUALS 12
#ASSERT `s 672.81 the longest time before the next hearing, in months` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS 12
#ASSERT `s 672.81 the longest time before the next hearing, in months` (JUST TRUE) NOTHING NOTHING NOTHING EQUALS 24
#ASSERT `s 672.81 the longest time before the next hearing, in months` NOTHING (JUST TRUE) NOTHING NOTHING EQUALS 24
#ASSERT `s 672.81 the longest time before the next hearing, in months` NOTHING NOTHING (JUST TRUE) NOTHING EQUALS 36
#ASSERT `s 672.81 the longest time before the next hearing, in months` NOTHING NOTHING NOTHING (JUST TRUE) EQUALS 36
#ASSERT `s 672.81 the longest time before the next hearing, in months` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS 36

-- (1.4) args: the Review Board extends the time under (1.2) or (1.32)
#ASSERT `s 672.81(1.4) the Review Board must provide notice of the extension to the accused, the prosecutor and the person in charge of the hospital` TRUE EQUALS JUST TRUE
#ASSERT `s 672.81(1.4) the Review Board must provide notice of the extension to the accused, the prosecutor and the person in charge of the hospital` FALSE EQUALS JUST FALSE
-- (1.5)
#ASSERT `s 672.81(1.5) the decision is deemed to be a disposition for the purpose of sections 672.72 to 672.78` TRUE EQUALS JUST TRUE
#ASSERT `s 672.81(1.5) the decision is deemed to be a disposition for the purpose of sections 672.72 to 672.78` FALSE EQUALS NOTHING
-- (2) args: the disposition was made under 672.54(b) or (c); the Board receives notice that the person in charge requests the review
#ASSERT `s 672.81(2) the Review Board must hold a hearing to review the disposition as soon as practicable` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.81(2) the Review Board must hold a hearing to review the disposition as soon as practicable` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.81(2) the Review Board must hold a hearing to review the disposition as soon as practicable` TRUE FALSE EQUALS JUST FALSE
-- (2.1) args: the Board receives the notice of 672.56(2)
#ASSERT `s 672.81(2.1) the Review Board must hold a hearing to review the decision to significantly increase the restrictions on liberty` TRUE EQUALS JUST TRUE
#ASSERT `s 672.81(2.1) the Review Board must hold a hearing to review the decision to significantly increase the restrictions on liberty` FALSE EQUALS JUST FALSE
-- (3) args: detained under a 672.54(c) disposition; a sentence of imprisonment is later imposed for another offence; the Board receives notice of the sentence
#ASSERT `s 672.81(3) the Review Board must hold a hearing to review the disposition as soon as is practicable` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.81(3) the Review Board must hold a hearing to review the disposition as soon as is practicable` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.81(3) the Review Board must hold a hearing to review the disposition as soon as is practicable` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 672.81(3) the Review Board must hold a hearing to review the disposition as soon as is practicable` TRUE TRUE FALSE EQUALS JUST FALSE

§ `ss 672.82 and 672.83`
-- 672.82(1) args: it is a disposition of the Review Board
#ASSERT `s 672.82(1) the Review Board may hold a hearing to review any of its dispositions at any time` TRUE EQUALS JUST TRUE
#ASSERT `s 672.82(1) the Review Board may hold a hearing to review any of its dispositions at any time` FALSE EQUALS NOTHING
-- (1.1) args: the Board holds a hearing under (1) of its own motion
#ASSERT `s 672.82(1.1) the Review Board must provide notice to the prosecutor, the accused and any other party` TRUE EQUALS JUST TRUE
#ASSERT `s 672.82(1.1) the Review Board must provide notice to the prosecutor, the accused and any other party` FALSE EQUALS JUST FALSE
-- (2) args: a party requests a review under 672.82; the party has appealed under 672.72
#ASSERT `s 672.82(2) the party is deemed to abandon the appeal against the disposition` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.82(2) the party is deemed to abandon the appeal against the disposition` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.82(2) the party is deemed to abandon the appeal against the disposition` FALSE TRUE EQUALS JUST FALSE
-- 672.83(1) args: a hearing held under 672.81 or 672.82; a determination under 672.48(1) that the accused is fit to stand trial
#ASSERT `s 672.83(1) the Review Board must review the disposition and make any other disposition that it considers appropriate` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.83(1) the Review Board must review the disposition and make any other disposition that it considers appropriate` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.83(1) the Review Board must review the disposition and make any other disposition that it considers appropriate` FALSE FALSE EQUALS JUST FALSE
-- 672.83(2) is repealed: the text shows only the repeal note
#ASSERT `s 672.83(2) as the text shows it` EQUALS "(2) [Repealed, 2005, c. 22, s. 29]"

§ `s 672.84`
-- (1) args: the Board holds a hearing under 672.81 or 672.82 in respect of a high-risk accused; the Board is satisfied that there is not a substantial likelihood of violence
#ASSERT `s 672.84(1) the Review Board must refer the finding for review to the superior court of criminal jurisdiction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.84(1) the Review Board must refer the finding for review to the superior court of criminal jurisdiction` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.84(1) the Review Board must refer the finding for review to the superior court of criminal jurisdiction` FALSE TRUE EQUALS JUST FALSE
-- (2) same args: not so satisfied
#ASSERT `s 672.84(2) the Review Board must review the conditions of detention imposed under paragraph 672.54(c)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.84(2) the Review Board must review the conditions of detention imposed under paragraph 672.54(c)` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 672.84(2) the Review Board must review the conditions of detention imposed under paragraph 672.54(c)` FALSE FALSE EQUALS JUST FALSE
-- (3) args: the Board refers the finding to the court; the court is satisfied that there is not a substantial likelihood of violence
#ASSERT `s 672.84(3) the court must revoke the finding that the accused is a high-risk accused` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.84(3) the court must revoke the finding that the accused is a high-risk accused` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.84(3) the court must revoke the finding that the accused is a high-risk accused` FALSE TRUE EQUALS JUST FALSE
-- (4) args: a disposition referred to in (3)
#ASSERT `s 672.84(4) the disposition is subject to sections 672.45 to 672.47 as if the revocation is a verdict` TRUE EQUALS JUST TRUE
#ASSERT `s 672.84(4) the disposition is subject to sections 672.45 to 672.47 as if the revocation is a verdict` FALSE EQUALS NOTHING
-- (5) the court's duty to send the transcript. args: the court does not revoke the finding
#ASSERT `s 672.84(5) the court must immediately send the transcript, documents and exhibits to the Review Board` TRUE EQUALS JUST TRUE
#ASSERT `s 672.84(5) the court must immediately send the transcript, documents and exhibits to the Review Board` FALSE EQUALS JUST FALSE
-- (5) the 45 days. args: the day the court decides not to revoke; the day the Board holds the hearing (45 days after 1 March 2026 is 15 April 2026)
#ASSERT `s 672.84(5) the Review Board has held the hearing within 45 days after the court’s decision not to revoke` (Date 1 3 2026) (Date 15 4 2026) EQUALS JUST TRUE
#ASSERT `s 672.84(5) the Review Board has held the hearing within 45 days after the court’s decision not to revoke` (Date 1 3 2026) (Date 16 4 2026) EQUALS JUST FALSE
#ASSERT `s 672.84(5) the Review Board has held the hearing within 45 days after the court’s decision not to revoke` (Date 1 3 2026) (Date 2 3 2026) EQUALS JUST TRUE
#TRACE `s 672.84(5) the Review Board must hold a hearing and review the conditions of detention within 45 days` AT 0 WITH
    PARTY `a Review Board` DOES `s 672.84(5) hold a hearing and review the conditions of detention` AT 45
#TRACE `s 672.84(5) the Review Board must hold a hearing and review the conditions of detention within 45 days` AT 0 WITH
    (WAITUNTIL 46)
-- (6) args: a decision under (1) about referring, or under (3) about revoking
#ASSERT `s 672.84(6) the decision is deemed to be a disposition for the purpose of sections 672.72 to 672.78` TRUE EQUALS JUST TRUE
#ASSERT `s 672.84(6) the decision is deemed to be a disposition for the purpose of sections 672.72 to 672.78` FALSE EQUALS NOTHING

§ `ss 672.85 to 672.852`
-- 672.85(a) args: a hearing is to be held before the Review Board; the accused is in custody
#ASSERT `s 672.85(a) the chairperson must order the person having custody of the accused to bring the accused to the hearing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.85(a) the chairperson must order the person having custody of the accused to bring the accused to the hearing` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 672.85(a) the chairperson must order the person having custody of the accused to bring the accused to the hearing` FALSE TRUE EQUALS JUST FALSE
-- 672.85(b) args: a hearing is to be held; the accused is not in custody
#ASSERT `s 672.85(b) the chairperson may issue a summons or warrant to compel the accused to appear at the hearing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.85(b) the chairperson may issue a summons or warrant to compel the accused to appear at the hearing` TRUE FALSE EQUALS NOTHING
#ASSERT `s 672.85(b) the chairperson may issue a summons or warrant to compel the accused to appear at the hearing` FALSE TRUE EQUALS NOTHING
-- 672.851(1) args: found unfit; (a) the Board has held a hearing under 672.81 or 672.82; (b)(i) opinion that the accused remains unfit and is not likely to ever become fit; (b)(ii) opinion that the accused does not pose a significant threat to public safety
#ASSERT `s 672.851(1) the Review Board may recommend to the court that it hold an inquiry to determine whether a stay of proceedings should be ordered` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.851(1) the Review Board may recommend to the court that it hold an inquiry to determine whether a stay of proceedings should be ordered` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.851(1) the Review Board may recommend to the court that it hold an inquiry to determine whether a stay of proceedings should be ordered` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.851(1) the Review Board may recommend to the court that it hold an inquiry to determine whether a stay of proceedings should be ordered` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 672.851(1) the Review Board may recommend to the court that it hold an inquiry to determine whether a stay of proceedings should be ordered` TRUE TRUE TRUE FALSE EQUALS NOTHING
-- (2) args: the Board makes a recommendation to the court
#ASSERT `s 672.851(2) the Review Board must provide notice to the accused, the prosecutor and any party with a substantial interest in protecting the interests of the accused` TRUE EQUALS JUST TRUE
#ASSERT `s 672.851(2) the Review Board must provide notice to the accused, the prosecutor and any party with a substantial interest in protecting the interests of the accused` FALSE EQUALS JUST FALSE
-- (3) args: the court has received the recommendation
#ASSERT `s 672.851(3) the court may hold an inquiry to determine whether a stay of proceedings should be ordered` TRUE EQUALS JUST TRUE
#ASSERT `s 672.851(3) the court may hold an inquiry to determine whether a stay of proceedings should be ordered` FALSE EQUALS NOTHING
-- (4) args: (a) the court's opinion that the accused remains unfit and is not likely to ever become fit; (b) its opinion that the accused poses no significant threat to public safety
#ASSERT `s 672.851(4) the court may of its own motion conduct an inquiry to determine whether a stay of proceedings should be ordered` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.851(4) the court may of its own motion conduct an inquiry to determine whether a stay of proceedings should be ordered` FALSE TRUE EQUALS NOTHING
#ASSERT `s 672.851(4) the court may of its own motion conduct an inquiry to determine whether a stay of proceedings should be ordered` TRUE FALSE EQUALS NOTHING
-- (5) args: the court holds an inquiry under (3) or (4)
#ASSERT `s 672.851(5) the court must order an assessment of the accused` TRUE EQUALS JUST TRUE
#ASSERT `s 672.851(5) the court must order an assessment of the accused` FALSE EQUALS JUST FALSE
-- (6) args: an inquiry of the court under 672.851
#ASSERT `s 672.851(6) section 672.51 applies to the inquiry` TRUE EQUALS JUST TRUE
#ASSERT `s 672.851(6) section 672.51 applies to the inquiry` FALSE EQUALS NOTHING
-- (7) args: the inquiry is complete; (a) satisfied on clear information that the accused remains unfit and is not likely to ever become fit; (b) satisfied of no significant threat to public safety; (c) satisfied that a stay is in the interests of the proper administration of justice
#ASSERT `s 672.851(7) the court may order a stay of proceedings` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 672.851(7) the court may order a stay of proceedings` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.851(7) the court may order a stay of proceedings` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 672.851(7) the court may order a stay of proceedings` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 672.851(7) the court may order a stay of proceedings` TRUE TRUE TRUE FALSE EQUALS NOTHING
-- (8) args: determining whether a stay is in the interests of the proper administration of justice; a submission of the prosecutor, the accused or another party; (a) nature and seriousness; (b) salutary and deleterious effects; (c) time elapsed; (d) any other factor the court considers relevant
#ASSERT `s 672.851(8) the court must consider the submission or factor` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.851(8) the court must consider the submission or factor` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.851(8) the court must consider the submission or factor` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 672.851(8) the court must consider the submission or factor` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 672.851(8) the court must consider the submission or factor` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 672.851(8) the court must consider the submission or factor` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 672.851(8) the court must consider the submission or factor` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- (9) args: the inquiry is complete; a stay is ordered; the Board has held a disposition hearing and made a disposition under 672.83
#ASSERT `s 672.851(9) the effect of the court’s decision on a stay of proceedings` TRUE TRUE FALSE EQUALS `s 672.851(9) any disposition made in respect of the accused ceases to have effect`
#ASSERT `s 672.851(9) the effect of the court’s decision on a stay of proceedings` TRUE FALSE FALSE EQUALS `s 672.851(9) the finding of unfit to stand trial and any disposition made in respect of the accused remain in force`
#ASSERT `s 672.851(9) the effect of the court’s decision on a stay of proceedings` TRUE FALSE TRUE EQUALS `s 672.851(9) not covered`
#ASSERT `s 672.851(9) the effect of the court’s decision on a stay of proceedings` FALSE FALSE FALSE EQUALS `s 672.851(9) not covered`
-- 672.852(1) args: the Court of Appeal is of the opinion that the order is unreasonable or cannot be supported by the evidence
#ASSERT `s 672.852(1) the Court of Appeal may allow an appeal against the order for a stay of proceedings` TRUE EQUALS JUST TRUE
#ASSERT `s 672.852(1) the Court of Appeal may allow an appeal against the order for a stay of proceedings` FALSE EQUALS NOTHING
-- (2) args: the Court of Appeal allows the appeal
#ASSERT `s 672.852(2) the Court of Appeal may set aside the order for a stay and restore the finding and the disposition` TRUE EQUALS JUST TRUE
#ASSERT `s 672.852(2) the Court of Appeal may set aside the order for a stay and restore the finding and the disposition` FALSE EQUALS NOTHING
