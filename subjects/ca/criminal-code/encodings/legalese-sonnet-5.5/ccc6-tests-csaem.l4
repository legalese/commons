#ASSERT `s 163.1(4.1) the conduct is the offence of accessing child sexual abuse and exploitation material` (JUST TRUE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 163.1(4.1)(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 10) (`ss 150 to 182 test a term of years` 1)
#ASSERT `s 163.1(4.1)(b) the punishment on summary conviction` EQUALS `ss 150 to 182 test a summary punishment` `ss 150 to 182 test a term of two years less a day` (`ss 150 to 182 test a term of months` 6)
#ASSERT `s 163.1(4.1) the class of the offence` EQUALS `ss 150 to 182 test both`

§ `s 163.1(4.21) Threat to publish, etc.`
-- (intent to intimidate or to be taken seriously, knowingly threatens, what, the answer of s 163.1(1))
#ASSERT `s 163.1(4.21) the conduct is the offence of threatening to publish child sexual abuse and exploitation material` TRUE TRUE `s 163.1(4.21) publish` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 163.1(4.21) the conduct is the offence of threatening to publish child sexual abuse and exploitation material` TRUE TRUE `s 163.1(4.21) advertise` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 163.1(4.21) the conduct is the offence of threatening to publish child sexual abuse and exploitation material` FALSE TRUE `s 163.1(4.21) publish` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 163.1(4.21) the conduct is the offence of threatening to publish child sexual abuse and exploitation material` TRUE FALSE `s 163.1(4.21) publish` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 163.1(4.21) the conduct is the offence of threatening to publish child sexual abuse and exploitation material` TRUE TRUE `s 163.1(4.21) nothing of that kind` (JUST TRUE) EQUALS NOTHING
#ASSERT `s 163.1(4.21) the conduct is the offence of threatening to publish child sexual abuse and exploitation material` TRUE TRUE `s 163.1(4.21) sell` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 163.1(4.21)(a) the punishment on indictment` EQUALS `ss 150 to 182 test an indictable punishment` (`ss 150 to 182 test a term of years` 10) (`ss 150 to 182 test a term of years` 1)
#ASSERT `s 163.1(4.21)(b) the punishment on summary conviction` EQUALS `ss 150 to 182 test a summary punishment` `ss 150 to 182 test a term of two years less a day` (`ss 150 to 182 test a term of months` 6)
#ASSERT `s 163.1(4.21) the class of the offence` EQUALS `ss 150 to 182 test both`

§ `s 163.1(4.3) Aggravating factor`
#ASSERT `s 163.1(4.3) the court must consider the intent to make a profit as an aggravating factor` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 163.1(4.3) the court must consider the intent to make a profit as an aggravating factor` TRUE FALSE EQUALS JUST FALSE   -- no intent to make a profit
#ASSERT `s 163.1(4.3) the court must consider the intent to make a profit as an aggravating factor` FALSE TRUE EQUALS JUST FALSE   -- not convicted: "If a person is convicted"
-- the duty as a regulative rule (traces are read, not asserted: a DEONTIC value cannot be compared on the stable binary)
#TRACE `s 163.1(4.3) the sentencing court's duty to consider the intent to make a profit` AT 0 WITH
    PARTY `the court` DOES `s 163.1(4.3) consider the intent to make a profit as an aggravating factor` AT 1
-- (expected: FULFILLED)

§ `s 163.1(5) and (6) the defences`
-- (5): (charged under (2) in respect of a visual representation, believed 18 or more, took all reasonable steps to ascertain the age, took all reasonable steps that the representation did not depict a person as under 18)
#ASSERT `s 163.1(5) the belief that the person shown was eighteen or more is not a defence: the bar applies` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 163.1(5) the belief that the person shown was eighteen or more is not a defence: the bar applies` TRUE TRUE TRUE FALSE EQUALS JUST TRUE   -- only the first of the two kinds of reasonable steps
#ASSERT `s 163.1(5) the belief that the person shown was eighteen or more is not a defence: the bar applies` TRUE TRUE FALSE TRUE EQUALS JUST TRUE   -- only the second
#ASSERT `s 163.1(5) the belief that the person shown was eighteen or more is not a defence: the bar applies` TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- "unless ... and": both kinds of step taken
#ASSERT `s 163.1(5) the belief that the person shown was eighteen or more is not a defence: the bar applies` FALSE TRUE FALSE FALSE EQUALS NOTHING   -- not a charge under (2) about a visual representation
#ASSERT `s 163.1(5) the belief that the person shown was eighteen or more is not a defence: the bar applies` TRUE FALSE FALSE FALSE EQUALS NOTHING   -- no such belief
-- (6): (a legitimate purpose, no undue risk of harm)
#ASSERT `s 163.1(6) section 163.1 gives a defence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 163.1(6) section 163.1 gives a defence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 163.1(6) section 163.1 gives a defence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 163.1(7) the question is a question of law` TRUE EQUALS JUST TRUE
#ASSERT `s 163.1(7) the question is a question of law` FALSE EQUALS NOTHING
