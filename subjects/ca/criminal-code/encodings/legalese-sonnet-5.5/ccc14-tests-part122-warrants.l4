#ASSERT `s 462.321(4)(d) the person executing the warrant must cause a copy of the report to be provided on request` FALSE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.321(4)(d) the person executing the warrant must cause a copy of the report to be provided on request` FALSE FALSE EQUALS NOTHING
