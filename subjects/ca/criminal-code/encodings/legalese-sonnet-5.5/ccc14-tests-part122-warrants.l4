IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc14-part122-warrants`

-- ccc14-tests-part122-warrants.l4 -- tests for ccc14-part122-warrants.l4 (Criminal Code, ss 462.32 to 462.36).
-- Every expected value is written from the text of the section named beside it, before the run; none is copied from the module's output.
-- The conjunction cases (every condition TRUE gives the answer; each condition FALSE in turn gives the other answer) are typed by work/gen_tests_warrants.py from a table of expectations.
-- Y = JUST TRUE; N = JUST FALSE; NA = NOTHING (not covered).

`ccc14 Y` MEANS JUST TRUE
`ccc14 N` MEANS JUST FALSE

§ `s 462.32 -- Special search warrant`
-- (1) args: application of the Attorney General; satisfied by information on oath in Form 1; reasonable grounds to believe
#ASSERT `s 462.32(1) the judge may issue a warrant to search for and seize property that is proceeds of crime` TRUE TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(1) the judge may issue a warrant to search for and seize property that is proceeds of crime` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 462.32(1) the judge may issue a warrant to search for and seize property that is proceeds of crime` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 462.32(1) the judge may issue a warrant to search for and seize property that is proceeds of crime` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 462.32(1) the warrant may authorize the act` `s 462.32(1)(a) search the building, receptacle or place for that property` EQUALS `ccc14 Y`
#ASSERT `s 462.32(1) the warrant may authorize the act` `s 462.32(1)(b) seize that property and any other property that that person or peace officer believes, on reasonable grounds, is proceeds of crime` EQUALS `ccc14 Y`
#ASSERT `s 462.32(1) the warrant may authorize the act` `s 462.32(1) an act that is none of those named` EQUALS NOTHING
-- (2) "shall be made in writing and shall include a statement"
#ASSERT `s 462.32(2) the application complies with subsection (2)` TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(2) the application complies with subsection (2)` FALSE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.32(2) the application complies with subsection (2)` TRUE FALSE EQUALS `ccc14 N`
#ASSERT `s 462.32(2) the application may be made ex parte` TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(2) the application may be made ex parte` FALSE EQUALS NOTHING
-- (2.01) a reasonable condition the judge thinks fit
#ASSERT `s 462.32(2.01) the warrant may be subject to the condition` TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(2.01) the warrant may be subject to the condition` FALSE TRUE EQUALS NOTHING
#ASSERT `s 462.32(2.01) the warrant may be subject to the condition` TRUE FALSE EQUALS NOTHING
#ASSERT `s 462.32(2.1) the warrant may be executed at the place` TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(2.1) the warrant may be executed at the place` FALSE EQUALS NOTHING
#ASSERT `s 462.32(2.1) the peace officer is barred from executing the warrant at the place` TRUE EQUALS `ccc14 N`
#ASSERT `s 462.32(2.1) the peace officer is barred from executing the warrant at the place` FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.32(2.2) as the text shows it` EQUALS "(2.2) [Repealed, 2019, c. 25, s. 180]"
#ASSERT `s 462.32(3) subsections 487(2.1) to (3) and section 488 apply to the warrant` TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(3) subsections 487(2.1) to (3) and section 488 apply to the warrant` FALSE EQUALS NOTHING
-- (4)(a) args: someone present is ostensibly in control; gave a copy of the warrant; gave a notice in Form 5.1; (absent) affixed both
#ASSERT `s 462.32(4)(a) the person executing the warrant has given or affixed the copy and the notice` TRUE TRUE TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.32(4)(a) the person executing the warrant has given or affixed the copy and the notice` TRUE TRUE FALSE FALSE EQUALS `ccc14 N`
#ASSERT `s 462.32(4)(a) the person executing the warrant has given or affixed the copy and the notice` TRUE FALSE TRUE FALSE EQUALS `ccc14 N`
#ASSERT `s 462.32(4)(a) the person executing the warrant has given or affixed the copy and the notice` TRUE FALSE FALSE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.32(4)(a) the person executing the warrant has given or affixed the copy and the notice` FALSE FALSE FALSE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(4)(a) the person executing the warrant has given or affixed the copy and the notice` FALSE TRUE TRUE FALSE EQUALS `ccc14 N`
#ASSERT `s 462.32(4)(a.1) the person executing the warrant has detained the property seized` TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(4)(a.1) the person executing the warrant has detained the property seized` FALSE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.32(4)(a.1) the person executing the warrant has detained the property seized` TRUE FALSE EQUALS `ccc14 N`
-- (4)(b) args: date executed; date the report was filed; the report identifies the property and where it is detained; prepared as soon as practicable: "within a period not exceeding seven days"
#ASSERT `s 462.32(4)(b) the report was prepared and filed in time` (Date 10 3 2026) (Date 10 3 2026) TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(4)(b) the report was prepared and filed in time` (Date 10 3 2026) (Date 16 3 2026) TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(4)(b) the report was prepared and filed in time` (Date 10 3 2026) (Date 17 3 2026) TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(4)(b) the report was prepared and filed in time` (Date 10 3 2026) (Date 18 3 2026) TRUE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.32(4)(b) the report was prepared and filed in time` (Date 28 2 2026) (Date 7 3 2026) TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(4)(b) the report was prepared and filed in time` (Date 28 2 2026) (Date 8 3 2026) TRUE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.32(4)(b) the report was prepared and filed in time` (Date 10 3 2026) (Date 12 3 2026) FALSE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.32(4)(b) the report was prepared and filed in time` (Date 10 3 2026) (Date 12 3 2026) TRUE FALSE EQUALS `ccc14 N`
-- (4)(c) args: asked by the person from whom the property was seized; asked by another person with a valid interest
#ASSERT `s 462.32(4)(c) the person executing the warrant must cause a copy of the report to be provided on request` TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.32(4)(c) the person executing the warrant must cause a copy of the report to be provided on request` FALSE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(4)(c) the person executing the warrant must cause a copy of the report to be provided on request` FALSE FALSE EQUALS NOTHING
-- the duty of (4)(b) as a regulative rule is run with #TRACE below (a DEONTIC value cannot be compared in #ASSERT on the stable binary)
-- (4.1) args: written consent of the Attorney General; a receipt; (a) no dispute; (b) detention not required for forfeiture; (c) returned before the report is filed
#ASSERT `s 462.32(4.1) the peace officer may return the thing seized to the person lawfully entitled to its possession` TRUE TRUE TRUE TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.32(4.1) the peace officer may return the thing seized to the person lawfully entitled to its possession` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 462.32(4.1) the peace officer may return the thing seized to the person lawfully entitled to its possession` TRUE FALSE TRUE TRUE TRUE EQUALS `ccc14 N`   -- RECONCILED 2026-11-12: was #ASSERT `s 462.32(4.1) the peace officer may return the thing seized to the person lawfully entitled to its possession` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING; the gate "on being issued a receipt for it" is of the kind "on payment", a gate on a power, so JUST FALSE (F35)
#ASSERT `s 462.32(4.1) the peace officer may return the thing seized to the person lawfully entitled to its possession` TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 462.32(4.1) the peace officer may return the thing seized to the person lawfully entitled to its possession` TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 462.32(4.1) the peace officer may return the thing seized to the person lawfully entitled to its possession` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 462.32(4.1) the peace officer may return the thing seized to the person lawfully entitled to its possession` FALSE FALSE TRUE TRUE TRUE EQUALS `ccc14 N`   -- NEW 2026-11-16: a failed where-kind limb dominates a failed description limb
-- (5) args: the person appears to have a valid interest; the judge is of the opinion that notice would result in disappearance, dissipation or reduction in value
#ASSERT `s 462.32(5) the judge may require notice to be given to and may hear the person before issuing the warrant` TRUE FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.32(5) the judge may require notice to be given to and may hear the person before issuing the warrant` TRUE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.32(5) the judge may require notice to be given to and may hear the person before issuing the warrant` FALSE FALSE EQUALS NOTHING
#ASSERT `s 462.32(5) the judge may require notice to be given to and may hear the person before issuing the warrant` FALSE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.32(6) as the text shows it` EQUALS "(6) [Repealed, 2024, c. 15, s. 309]"

§ `s 462.321 -- Special warrant -- digital assets`
#ASSERT `s 462.321(1) the judge may issue a warrant to search for and seize digital assets that are proceeds of crime` TRUE TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.321(1) the judge may issue a warrant to search for and seize digital assets that are proceeds of crime` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 462.321(1) the judge may issue a warrant to search for and seize digital assets that are proceeds of crime` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 462.321(1) the judge may issue a warrant to search for and seize digital assets that are proceeds of crime` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 462.321(1) the warrant may authorize the act` `s 462.321(1)(a) search for the digital assets by using a computer program, as defined in subsection 342.1(2)` EQUALS `ccc14 Y`
#ASSERT `s 462.321(1) the warrant may authorize the act` `s 462.321(1)(b) seize, including by taking control of the right to access, the digital assets, as well as any other digital assets found during that search that the person or peace officer believes, on reasonable grounds, are proceeds of crime` EQUALS `ccc14 Y`
#ASSERT `s 462.321(1) the warrant may authorize the act` `s 462.321(1) an act that is none of those named` EQUALS NOTHING
#ASSERT `s 462.321(2) the warrant may be subject to the condition` TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.321(2) the warrant may be subject to the condition` FALSE TRUE EQUALS NOTHING
#ASSERT `s 462.321(2) the warrant may be subject to the condition` TRUE FALSE EQUALS NOTHING
#ASSERT `s 462.321(3) the application complies with subsection (3)` TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.321(3) the application complies with subsection (3)` FALSE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.321(3) the application complies with subsection (3)` TRUE FALSE EQUALS `ccc14 N`
#ASSERT `s 462.321(3) the application may be made ex parte` TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.321(3) the application may be made ex parte` FALSE EQUALS NOTHING
#ASSERT `s 462.321(3.1) the warrant may be executed at the place` TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.321(3.1) the warrant may be executed at the place` FALSE EQUALS NOTHING
#ASSERT `s 462.321(3.1) the peace officer is barred from executing the warrant at the place` TRUE EQUALS `ccc14 N`
#ASSERT `s 462.321(3.1) the peace officer is barred from executing the warrant at the place` FALSE EQUALS `ccc14 Y`
#ASSERT `s 462.321(4)(a) the person executing the warrant has detained the seized property` TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.321(4)(a) the person executing the warrant has detained the seized property` FALSE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.321(4)(a) the person executing the warrant has detained the seized property` TRUE FALSE EQUALS `ccc14 N`
-- (4)(b) args: the usual place of residence is in Canada and known; a copy of the warrant was sent; a notice in Form 5.1 was sent
#ASSERT `s 462.321(4)(b) the person executing the warrant has sent the copy of the warrant and the notice` TRUE TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.321(4)(b) the person executing the warrant has sent the copy of the warrant and the notice` TRUE FALSE TRUE EQUALS `ccc14 N`
#ASSERT `s 462.321(4)(b) the person executing the warrant has sent the copy of the warrant and the notice` TRUE TRUE FALSE EQUALS `ccc14 N`
#ASSERT `s 462.321(4)(b) the person executing the warrant has sent the copy of the warrant and the notice` FALSE TRUE TRUE EQUALS NOTHING
-- (4)(c) args: date executed; date the report was filed; identifies the seized property and the manner of detention; prepared as soon as practicable: "not more than seven days"
#ASSERT `s 462.321(4)(c) the report was prepared and filed in time` (Date 20 6 2026) (Date 20 6 2026) TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.321(4)(c) the report was prepared and filed in time` (Date 20 6 2026) (Date 27 6 2026) TRUE TRUE EQUALS `ccc14 Y`
#ASSERT `s 462.321(4)(c) the report was prepared and filed in time` (Date 20 6 2026) (Date 28 6 2026) TRUE TRUE EQUALS `ccc14 N`
