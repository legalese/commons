IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc1-s8-20-general`

-- ccc1-tests-s8-20-general.l4 -- tests for sections 8 to 20 of the Criminal Code (Canada). Expected values are written by hand from the text of each section.
-- Arguments are positional, in GIVEN order.

§ `s 8(1)  (place; inconsistent with the territory's own Act)`
#ASSERT `s 8(1) the provisions of this Act apply in the place` Yukon TRUE EQUALS JUST FALSE   -- Yukon: "except" in so far as inconsistent with its own Act
#ASSERT `s 8(1) the provisions of this Act apply in the place` Yukon FALSE EQUALS JUST TRUE   -- Yukon: consistent, so "throughout Canada"
#ASSERT `s 8(1) the provisions of this Act apply in the place` `Northwest Territories` TRUE EQUALS JUST FALSE   -- `Northwest Territories`: "except" in so far as inconsistent with its own Act
#ASSERT `s 8(1) the provisions of this Act apply in the place` `Northwest Territories` FALSE EQUALS JUST TRUE   -- `Northwest Territories`: consistent, so "throughout Canada"
#ASSERT `s 8(1) the provisions of this Act apply in the place` Nunavut TRUE EQUALS JUST FALSE   -- Nunavut: "except" in so far as inconsistent with its own Act
#ASSERT `s 8(1) the provisions of this Act apply in the place` Nunavut FALSE EQUALS JUST TRUE   -- Nunavut: consistent, so "throughout Canada"
#ASSERT `s 8(1) the provisions of this Act apply in the place` Ontario TRUE EQUALS JUST TRUE   -- Ontario: a province, the exceptions name only the three territories
#ASSERT `s 8(1) the provisions of this Act apply in the place` Quebec TRUE EQUALS JUST TRUE   -- Quebec: a province, the exceptions name only the three territories
#ASSERT `s 8(1) the provisions of this Act apply in the place` `Nova Scotia` TRUE EQUALS JUST TRUE   -- `Nova Scotia`: a province, the exceptions name only the three territories
#ASSERT `s 8(1) the provisions of this Act apply in the place` `British Columbia` TRUE EQUALS JUST TRUE   -- `British Columbia`: a province, the exceptions name only the three territories
#ASSERT `s 8(1) the provisions of this Act apply in the place` `Prince Edward Island` TRUE EQUALS JUST TRUE   -- `Prince Edward Island`: a province, the exceptions name only the three territories
#ASSERT `s 8(1) the provisions of this Act apply in the place` `Newfoundland and Labrador` TRUE EQUALS JUST TRUE   -- `Newfoundland and Labrador`: a province, the exceptions name only the three territories
#ASSERT `s 8(1) the provisions of this Act apply in the place` `New Brunswick` TRUE EQUALS JUST TRUE   -- `New Brunswick`: a province, the exceptions name only the three territories
#ASSERT `s 8(1) the provisions of this Act apply in the place` Manitoba TRUE EQUALS JUST TRUE   -- Manitoba: a province, the exceptions name only the three territories
#ASSERT `s 8(1) the provisions of this Act apply in the place` Saskatchewan TRUE EQUALS JUST TRUE   -- Saskatchewan: a province, the exceptions name only the three territories
#ASSERT `s 8(1) the provisions of this Act apply in the place` Alberta TRUE EQUALS JUST TRUE   -- Alberta: a province, the exceptions name only the three territories

§ `s 8(2), s 8(3)`
#ASSERT `s 8(2) the criminal law of England continues in force in the province` TRUE FALSE EQUALS JUST TRUE   -- in force immediately before April 1, 1955 and not altered
#ASSERT `s 8(2) the criminal law of England continues in force in the province` TRUE TRUE EQUALS JUST FALSE   -- "except as altered, varied, modified or affected"
#ASSERT `s 8(2) the criminal law of England continues in force in the province` FALSE FALSE EQUALS NOTHING   -- not law in force then: not covered
#ASSERT `s 8(2) the criminal law of England continues in force in the province` FALSE TRUE EQUALS NOTHING   -- same
#ASSERT `s 8(3) the common law rule or principle continues in force and applies` TRUE TRUE FALSE EQUALS JUST TRUE   -- a common law justification, excuse or defence, in proceedings for an offence, not altered
#ASSERT `s 8(3) the common law rule or principle continues in force and applies` TRUE TRUE TRUE EQUALS JUST FALSE   -- "except in so far as they are altered by or are inconsistent with"
#ASSERT `s 8(3) the common law rule or principle continues in force and applies` FALSE TRUE FALSE EQUALS NOTHING   -- not a rule that renders a circumstance a justification, excuse or defence
#ASSERT `s 8(3) the common law rule or principle continues in force and applies` TRUE FALSE FALSE EQUALS NOTHING   -- not proceedings for an offence under an Act of Parliament
#ASSERT `s 8(3) the common law rule or principle continues in force and applies` FALSE FALSE TRUE EQUALS NOTHING   -- neither

§ `s 9  (the kind of offence; the contempt power)`
#ASSERT `s 9 conviction or discharge under section 730 is barred` `s 9(a) an offence at common law` FALSE EQUALS JUST TRUE   -- (a)
#ASSERT `s 9 conviction or discharge under section 730 is barred` `s 9(b) an offence under an Act of the Parliament of England, or of Great Britain, or of the United Kingdom of Great Britain and Ireland` FALSE EQUALS JUST TRUE   -- (b)
#ASSERT `s 9 conviction or discharge under section 730 is barred` `s 9(c) an offence under an Act or ordinance in force in any province, territory or place before that province, territory or place became a province of Canada` FALSE EQUALS JUST TRUE   -- (c)
#ASSERT `s 9 conviction or discharge under section 730 is barred` `s 9 an offence of none of those kinds` FALSE EQUALS NOTHING   -- another kind: not covered
#ASSERT `s 9 conviction or discharge under section 730 is barred` `s 9(a) an offence at common law` TRUE EQUALS JUST FALSE   -- contempt of court, the power the court had before April 1, 1955: "nothing in this section affects" it
#ASSERT `s 9 conviction or discharge under section 730 is barred` `s 9 an offence of none of those kinds` TRUE EQUALS JUST FALSE   -- the proviso comes first

§ `s 10(1) and (2)  (the gate; what is appealed)`
#ASSERT `s 10(1) the person may appeal` TRUE `s 10(a) the conviction` EQUALS JUST TRUE   -- s 10(1)(a): from the conviction (in the face of the court)
#ASSERT `s 10(1) the person may appeal` TRUE `s 10(b) the punishment imposed` EQUALS JUST TRUE   -- s 10(1)(b): against the punishment imposed
#ASSERT `s 10(1) the person may appeal` TRUE `s 10 something else` EQUALS NOTHING   -- another appeal: not covered
#ASSERT `s 10(1) the person may appeal` FALSE `s 10(a) the conviction` EQUALS JUST FALSE   -- the "Where" gate is not met
#ASSERT `s 10(1) the person may appeal` FALSE `s 10(b) the punishment imposed` EQUALS JUST FALSE   -- gate not met
#ASSERT `s 10(1) the person may appeal` FALSE `s 10 something else` EQUALS JUST FALSE   -- gate not met
#ASSERT `s 10(2) the person may appeal` TRUE `s 10(a) the conviction` EQUALS JUST TRUE   -- s 10(2)(a): from the conviction (not in the face of the court)
#ASSERT `s 10(2) the person may appeal` TRUE `s 10(b) the punishment imposed` EQUALS JUST TRUE   -- s 10(2)(b): against the punishment imposed
#ASSERT `s 10(2) the person may appeal` TRUE `s 10 something else` EQUALS NOTHING   -- another appeal: not covered
#ASSERT `s 10(2) the person may appeal` FALSE `s 10(a) the conviction` EQUALS JUST FALSE   -- the "Where" gate is not met
#ASSERT `s 10(2) the person may appeal` FALSE `s 10(b) the punishment imposed` EQUALS JUST FALSE   -- gate not met
#ASSERT `s 10(2) the person may appeal` FALSE `s 10 something else` EQUALS JUST FALSE   -- gate not met

§ `s 10(3)`
#ASSERT `s 10(3) the appeal lies to the court of appeal of the province in which the proceedings take place` TRUE Ontario EQUALS JUST Ontario   -- the court of appeal of Ontario
#ASSERT `s 10(3) the appeal lies to the court of appeal of the province in which the proceedings take place` TRUE Quebec EQUALS JUST Quebec   -- the court of appeal of Quebec
#ASSERT `s 10(3) the appeal lies to the court of appeal of the province in which the proceedings take place` TRUE `New Brunswick` EQUALS JUST `New Brunswick`   -- the court of appeal of `New Brunswick`
#ASSERT `s 10(3) the appeal lies to the court of appeal of the province in which the proceedings take place` TRUE `British Columbia` EQUALS JUST `British Columbia`   -- the court of appeal of `British Columbia`
#ASSERT `s 10(3) the appeal lies to the court of appeal of the province in which the proceedings take place` TRUE Yukon EQUALS NOTHING   -- a territory: the text says "province"
#ASSERT `s 10(3) the appeal lies to the court of appeal of the province in which the proceedings take place` TRUE `Northwest Territories` EQUALS NOTHING   -- a territory: the text says "province"
#ASSERT `s 10(3) the appeal lies to the court of appeal of the province in which the proceedings take place` TRUE Nunavut EQUALS NOTHING   -- a territory: the text says "province"
#ASSERT `s 10(3) the appeal lies to the court of appeal of the province in which the proceedings take place` FALSE Ontario EQUALS NOTHING   -- not an appeal under section 10
#ASSERT `s 10(3) the provisions of Part XXI apply, with such modifications as the circumstances require` TRUE EQUALS JUST TRUE   -- an appeal under this section
#ASSERT `s 10(3) the provisions of Part XXI apply, with such modifications as the circumstances require` FALSE EQUALS NOTHING   -- any other appeal

§ `s 11, s 11.1`
#ASSERT `s 11 a civil remedy is suspended or affected by reason that the act or omission is a criminal offence` TRUE EQUALS JUST FALSE   -- "No civil remedy ... is suspended or affected by reason that the act or omission is a criminal offence"
#ASSERT `s 11 a civil remedy is suspended or affected by reason that the act or omission is a criminal offence` FALSE EQUALS NOTHING   -- not an offence: the section is silent
#ASSERT `s 11.1 an agreement may prevent or restrict the person from disclosing the information` TRUE TRUE EQUALS JUST FALSE   -- information about an offence, to a police officer: no agreement may prevent it
#ASSERT `s 11.1 an agreement may prevent or restrict the person from disclosing the information` TRUE FALSE EQUALS NOTHING   -- to someone other than a police officer
#ASSERT `s 11.1 an agreement may prevent or restrict the person from disclosing the information` FALSE TRUE EQUALS NOTHING   -- not information relating to the commission of an offence
#ASSERT `s 11.1 an agreement may prevent or restrict the person from disclosing the information` FALSE FALSE EQUALS NOTHING   -- neither

§ `s 12`
#ASSERT `s 12 the person is subject to proceedings under any of those Acts` TRUE FALSE EQUALS JUST TRUE   -- an offence under more than one Act, no contrary intention
#ASSERT `s 12 the person is subject to proceedings under any of those Acts` TRUE TRUE EQUALS NOTHING   -- "unless a contrary intention appears" is met: the section then says nothing
#ASSERT `s 12 the person is subject to proceedings under any of those Acts` FALSE FALSE EQUALS JUST FALSE   -- an offence under one Act only: "Where an act or omission is an offence under more than one Act of Parliament"
#ASSERT `s 12 the person is subject to proceedings under any of those Acts` FALSE TRUE EQUALS JUST FALSE   -- same
#ASSERT `s 12 the person is liable to be punished again for the same offence` TRUE TRUE EQUALS JUST FALSE   -- "not liable to be punished more than once for the same offence"
#ASSERT `s 12 the person is liable to be punished again for the same offence` TRUE FALSE EQUALS NOTHING   -- not yet punished: the section is silent
#ASSERT `s 12 the person is liable to be punished again for the same offence` FALSE TRUE EQUALS JUST FALSE   -- an offence under one Act only: the "Where" gate is not met
#ASSERT `s 12 the person is liable to be punished again for the same offence` FALSE FALSE EQUALS JUST FALSE   -- same

§ `s 13  (age in years at the time of the act or omission)`
#ASSERT `s 13 conviction is barred because the person was under the age of twelve years at the time of the act or omission` 0 EQUALS JUST TRUE   -- aged 0: under twelve
#ASSERT `s 13 conviction is barred because the person was under the age of twelve years at the time of the act or omission` 8 EQUALS JUST TRUE   -- aged 8: under twelve
#ASSERT `s 13 conviction is barred because the person was under the age of twelve years at the time of the act or omission` 11 EQUALS JUST TRUE   -- aged 11: under twelve
#ASSERT `s 13 conviction is barred because the person was under the age of twelve years at the time of the act or omission` 11.99 EQUALS JUST TRUE   -- aged 11.99: under twelve
#ASSERT `s 13 conviction is barred because the person was under the age of twelve years at the time of the act or omission` 12 EQUALS NOTHING   -- aged 12: not under twelve, so the section is silent
#ASSERT `s 13 conviction is barred because the person was under the age of twelve years at the time of the act or omission` 12.5 EQUALS NOTHING   -- aged 12.5: not under twelve, so the section is silent
#ASSERT `s 13 conviction is barred because the person was under the age of twelve years at the time of the act or omission` 13 EQUALS NOTHING   -- aged 13: not under twelve, so the section is silent
#ASSERT `s 13 conviction is barred because the person was under the age of twelve years at the time of the act or omission` 40 EQUALS NOTHING   -- aged 40: not under twelve, so the section is silent

§ `s 14, s 15`
#ASSERT `s 14 a person is entitled to consent to have death inflicted on them` TRUE EQUALS JUST FALSE   -- "No person is entitled to consent to have death inflicted on them"
#ASSERT `s 14 a person is entitled to consent to have death inflicted on them` FALSE EQUALS NOTHING   -- another consent
#ASSERT `s 14 the consent affects the criminal responsibility of the person who inflicts death` TRUE EQUALS JUST FALSE   -- "such consent does not affect the criminal responsibility"
#ASSERT `s 14 the consent affects the criminal responsibility of the person who inflicts death` FALSE EQUALS NOTHING   -- death not inflicted on the person who consented
#ASSERT `s 15 conviction is barred because the act or omission was in obedience to the laws made and enforced by persons in de facto possession of the sovereign power` TRUE EQUALS JUST TRUE   -- in obedience to de facto law
#ASSERT `s 15 conviction is barred because the act or omission was in obedience to the laws made and enforced by persons in de facto possession of the sovereign power` FALSE EQUALS NOTHING   -- not

§ `s 16  (mental disorder by s 2; incapable of appreciating; incapable of knowing it was wrong)`
#ASSERT `s 16(1) the person is exempt from criminal responsibility` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE   -- incapable of appreciating the nature and quality
#ASSERT `s 16(1) the person is exempt from criminal responsibility` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE   -- incapable of knowing that it was wrong
#ASSERT `s 16(1) the person is exempt from criminal responsibility` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE   -- both
#ASSERT `s 16(1) the person is exempt from criminal responsibility` (JUST TRUE) FALSE FALSE EQUALS NOTHING   -- a mental disorder that rendered the person capable of both: the subsection gives no exemption
#ASSERT `s 16(1) the person is exempt from criminal responsibility` (JUST FALSE) TRUE TRUE EQUALS NOTHING   -- not a mental disorder as section 2 defines it
#ASSERT `s 16(1) the person is exempt from criminal responsibility` NOTHING TRUE TRUE EQUALS NOTHING   -- section 2 did not answer
#ASSERT `s 16(2) the person is presumed not to suffer from a mental disorder so as to be exempt from criminal responsibility` FALSE EQUALS JUST TRUE   -- nothing proved to the contrary
#ASSERT `s 16(2) the person is presumed not to suffer from a mental disorder so as to be exempt from criminal responsibility` TRUE EQUALS JUST FALSE   -- "until the contrary is proved on the balance of probabilities": it has been
#ASSERT `s 16(3) the burden of proof is on the party that raises the issue` TRUE `the accused` EQUALS JUST `the accused`   -- the accused raises it: the burden is on the accused
#ASSERT `s 16(3) the burden of proof is on the party that raises the issue` TRUE `the prosecutor` EQUALS JUST `the prosecutor`   -- the prosecutor raises it: the burden is on the prosecutor
#ASSERT `s 16(3) the burden of proof is on the party that raises the issue` FALSE `the accused` EQUALS NOTHING   -- not raised

§ `s 17  (compulsion by threats from a person present; threat of death; threat of bodily harm by s 2; believes; party to a conspiracy; the offence)`
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 an offence not in that list` EQUALS JUST TRUE   -- threat of immediate death, believed, no conspiracy, an offence not in the list
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE FALSE (JUST TRUE) TRUE FALSE `s 17 an offence not in that list` EQUALS JUST TRUE   -- threat of immediate bodily harm
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE NOTHING TRUE FALSE `s 17 an offence not in that list` EQUALS JUST TRUE   -- death suffices although bodily harm was not answered
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE FALSE (JUST FALSE) TRUE FALSE `s 17 an offence not in that list` EQUALS NOTHING   -- a threat of neither death nor bodily harm
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE FALSE NOTHING TRUE FALSE `s 17 an offence not in that list` EQUALS NOTHING   -- bodily harm not answered by section 2
#ASSERT `s 17 the section excuses the person for committing the offence` FALSE TRUE (JUST TRUE) TRUE FALSE `s 17 an offence not in that list` EQUALS NOTHING   -- not under compulsion by threats from a person present
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) FALSE FALSE `s 17 an offence not in that list` EQUALS JUST FALSE   -- "if the person believes that the threats will be carried out": does not believe
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE TRUE `s 17 an offence not in that list` EQUALS JUST FALSE   -- a party to a conspiracy or association whereby subject to compulsion
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 high treason` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" high treason
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 treason` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" treason
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 murder` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" murder
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 piracy` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" piracy
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 attempted murder` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" attempted murder
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 sexual assault` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" sexual assault
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 sexual assault with a weapon, threats to a third party or causing bodily harm` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" sexual assault with a weapon, threats to a third party or causing bodily harm
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 aggravated sexual assault` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" aggravated sexual assault
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 forcible abduction` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" forcible abduction
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 hostage taking` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" hostage taking
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 robbery` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" robbery
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 assault with a weapon or causing bodily harm` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" assault with a weapon or causing bodily harm
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 aggravated assault` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" aggravated assault
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 unlawfully causing bodily harm` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" unlawfully causing bodily harm
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 arson` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" arson
#ASSERT `s 17 the section excuses the person for committing the offence` TRUE TRUE (JUST FALSE) TRUE FALSE `s 17 an offence under sections 280 to 283 (abduction and detention of young persons)` EQUALS JUST FALSE   -- "this section does not apply where the offence ... is" an offence under sections 280 to 283 (abduction and detention of young persons)

§ `s 18, s 19`
#ASSERT `s 18 a presumption arises that the married person acted under compulsion` TRUE TRUE TRUE EQUALS JUST FALSE   -- "No presumption arises ... by reason only" of the spouse's presence
#ASSERT `s 18 a presumption arises that the married person acted under compulsion` FALSE TRUE TRUE EQUALS NOTHING   -- not a married person
#ASSERT `s 18 a presumption arises that the married person acted under compulsion` TRUE FALSE TRUE EQUALS NOTHING   -- not in the presence of the spouse
#ASSERT `s 18 a presumption arises that the married person acted under compulsion` TRUE TRUE FALSE EQUALS NOTHING   -- there is another reason: the section is silent
#ASSERT `s 19 ignorance of the law is an excuse for committing the offence` TRUE TRUE EQUALS JUST FALSE   -- "is not an excuse"
#ASSERT `s 19 ignorance of the law is an excuse for committing the offence` FALSE TRUE EQUALS NOTHING   -- no offence committed
#ASSERT `s 19 ignorance of the law is an excuse for committing the offence` TRUE FALSE EQUALS NOTHING   -- ignorance of something other than the law

§ `s 20  (the document; authorized by this Act; the day is a holiday)`
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `a warrant for arrest` TRUE TRUE EQUALS JUST TRUE   -- a warrant for arrest is named
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `a search warrant` TRUE TRUE EQUALS JUST TRUE   -- a search warrant is named
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `a summons` TRUE TRUE EQUALS JUST TRUE   -- a summons is named
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `an appearance notice` TRUE TRUE EQUALS JUST TRUE   -- an appearance notice is named
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `an undertaking` TRUE TRUE EQUALS JUST TRUE   -- an undertaking is named
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `a release order` TRUE TRUE EQUALS JUST TRUE   -- a release order is named
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `a recognizance` TRUE TRUE EQUALS JUST TRUE   -- a recognizance is named
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `an information` TRUE TRUE EQUALS NOTHING   -- an information is not named
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `an indictment` TRUE TRUE EQUALS NOTHING   -- an indictment is not named
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `a count` TRUE TRUE EQUALS NOTHING   -- a count is not named
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `a subpoena` TRUE TRUE EQUALS NOTHING   -- a subpoena is not named
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `a summons` FALSE TRUE EQUALS NOTHING   -- not authorized by this Act
#ASSERT `s 20 the document may be executed, issued, given or entered into on a holiday` `a summons` TRUE FALSE EQUALS NOTHING   -- not a holiday
