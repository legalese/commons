IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc8-part7-houses`

-- ccc8-tests-part7-houses.l4 -- tests for ccc8-part7-houses.l4 (sections 197, 199, 201, 202, 203).
-- Every expected value is written by hand from the text of the section named beside it, before the run.
-- Argument order in a call is the order of the GIVEN lines of the function.

§ `Section 197(1) -- definitions`

-- "bet means a bet that is placed on any contingency or event that is to take place in or out of Canada ... includes a bet ... relating to a horse-race, fight, match or sporting event"
#ASSERT `s 197(1) bet` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 197(1) bet` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 197(1) bet` FALSE FALSE EQUALS JUST FALSE

-- "common betting house means a place that is opened, kept or used for the purpose of (a) enabling ... persons ... to bet ... or (b) enabling any person to receive, record, register, transmit or pay bets"
#ASSERT `s 197(1) common betting house` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 197(1) common betting house` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 197(1) common betting house` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 197(1) common betting house` FALSE TRUE TRUE EQUALS JUST FALSE

-- "common gaming house means a place that is (a) kept for gain ..., or (b) kept or used for the purpose of playing games (i) bank ... (ii) ... paid to the keeper ... (iii) fee ... (iv) chances ... not equally favourable"
--                                       place  (a)    (b)    (b)(i) (b)(ii) (b)(iii) (b)(iv) exception of 197(2)
#ASSERT `s 197(1) common gaming house` TRUE  TRUE  FALSE FALSE FALSE FALSE  FALSE  (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 197(1) common gaming house` TRUE  TRUE  FALSE FALSE FALSE FALSE  FALSE  (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 197(1) common gaming house` TRUE  TRUE  FALSE FALSE FALSE FALSE  FALSE  NOTHING EQUALS NOTHING
#ASSERT `s 197(1) common gaming house` TRUE  FALSE TRUE  TRUE  FALSE FALSE  FALSE  (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 197(1) common gaming house` TRUE  FALSE TRUE  FALSE FALSE FALSE  TRUE   (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 197(1) common gaming house` TRUE  FALSE TRUE  FALSE TRUE  FALSE  FALSE  (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 197(1) common gaming house` TRUE  FALSE TRUE  FALSE TRUE  FALSE  FALSE  (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 197(1) common gaming house` TRUE  FALSE TRUE  FALSE FALSE TRUE   FALSE  (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 197(1) common gaming house` TRUE  FALSE TRUE  FALSE FALSE TRUE   TRUE   (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 197(1) common gaming house` TRUE  FALSE TRUE  FALSE FALSE FALSE  FALSE  (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 197(1) common gaming house` FALSE TRUE  TRUE  TRUE  TRUE  TRUE   TRUE   (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 197(1) common gaming house` TRUE  FALSE FALSE FALSE FALSE FALSE  FALSE  (JUST FALSE) EQUALS JUST FALSE
-- a case outside the encoding: only the answer of subsection 197(2) is not covered, and the place would be a gaming house under (b)(iii) alone
#ASSERT `s 197(1) common gaming house` TRUE  FALSE TRUE  FALSE FALSE TRUE   FALSE  NOTHING EQUALS NOTHING

-- "disorderly house means a common betting house or a common gaming house"
#ASSERT `s 197(1) disorderly house` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 197(1) disorderly house` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 197(1) disorderly house` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 197(1) disorderly house` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 197(1) disorderly house` NOTHING (JUST TRUE) EQUALS JUST TRUE

-- "game means a game of chance or mixed chance and skill"
#ASSERT `s 197(1) game` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 197(1) game` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 197(1) game` FALSE FALSE EQUALS JUST FALSE

-- "gaming equipment means anything that is or may be used for the purpose of playing games or for betting"
#ASSERT `s 197(1) gaming equipment` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 197(1) gaming equipment` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 197(1) gaming equipment` FALSE FALSE EQUALS JUST FALSE

-- "keeper includes a person who (a) is an owner or occupier of a place, (b) assists or acts on behalf of an owner or occupier, (c) appears to be ..., (d) has the care or management, or (e) uses a place permanently or temporarily"
#ASSERT `s 197(1) keeper` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 197(1) keeper` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 197(1) keeper` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 197(1) keeper` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 197(1) keeper` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- "includes": a person who is none of the five is not said to be a non-keeper
#ASSERT `s 197(1) keeper` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- "place includes any place, whether or not (a) it is covered or enclosed, (b) ... permanently or temporarily, or (c) ... exclusive right of user": the three facts make no difference
#ASSERT `s 197(1) place` TRUE EQUALS JUST TRUE
#ASSERT `s 197(1) place` FALSE EQUALS NOTHING

-- "public place includes any place to which the public have access as of right or by invitation, express or implied"
#ASSERT `s 197(1) the place is a public place` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 197(1) the place is a public place` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 197(1) the place is a public place` FALSE FALSE EQUALS NOTHING
-- the same answer under the seam name PLAN.md gives ccc10
#ASSERT `s 197(1) the place is a place; the place is a public place` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 197(1) the place is a place; the place is a public place` FALSE FALSE EQUALS NOTHING

§ `Section 197(2) to (4)`

-- (2) a place is not a common gaming house ... while occupied and used by an incorporated genuine social club or branch, if (a) no part of the bets or proceeds is paid to the keeper and (b) no fee is charged other than under a licence
--                                                          club   paid  fee    licensed
#ASSERT `s 197(2) the place is not a common gaming house within paragraph (a) or subparagraph (b)(ii) or (iii) of the definition` TRUE  FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 197(2) the place is not a common gaming house within paragraph (a) or subparagraph (b)(ii) or (iii) of the definition` TRUE  FALSE TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `s 197(2) the place is not a common gaming house within paragraph (a) or subparagraph (b)(ii) or (iii) of the definition` TRUE  FALSE TRUE  FALSE EQUALS JUST FALSE
#ASSERT `s 197(2) the place is not a common gaming house within paragraph (a) or subparagraph (b)(ii) or (iii) of the definition` TRUE  TRUE  FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 197(2) the place is not a common gaming house within paragraph (a) or subparagraph (b)(ii) or (iii) of the definition` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- (3) "The onus of proving that, by virtue of subsection (2), a place is not a common gaming house is on the accused."
#ASSERT `s 197(3) the party who bears the onus of proving the exception in subsection 197(2)` EQUALS `the accused`

-- (4) "A place may be a common gaming house notwithstanding that (a) ... part of a game ... elsewhere; (b) the stake ... in some other place; or (c) used on only one occasion ... if the keeper ... has used another place on another occasion"
#ASSERT `s 197(4) the circumstance does not prevent the place from being a common gaming house` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 197(4) the circumstance does not prevent the place from being a common gaming house` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 197(4) the circumstance does not prevent the place from being a common gaming house` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 197(4) the circumstance does not prevent the place from being a common gaming house` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 197(4) the circumstance does not prevent the place from being a common gaming house` FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 197(4) the circumstance does not prevent the place from being a common gaming house` FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Section 199 -- Search`

-- (1) a justice satisfied by information on oath that there are reasonable grounds to believe that an offence under section 201, 202, 203, 206 or 207 is being committed at a place within his jurisdiction may issue a warrant
#ASSERT `s 199(1) a justice may issue a warrant authorizing a peace officer to enter and search the place` (`Provision of the Code` OF 201, "") TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 199(1) a justice may issue a warrant authorizing a peace officer to enter and search the place` (`Provision of the Code` OF 202, "(1)") TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 199(1) a justice may issue a warrant authorizing a peace officer to enter and search the place` (`Provision of the Code` OF 203, "") TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 199(1) a justice may issue a warrant authorizing a peace officer to enter and search the place` (`Provision of the Code` OF 206, "(1)") TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 199(1) a justice may issue a warrant authorizing a peace officer to enter and search the place` (`Provision of the Code` OF 207, "") TRUE TRUE EQUALS JUST TRUE
-- section 204 is not in the list: not covered
#ASSERT `s 199(1) a justice may issue a warrant authorizing a peace officer to enter and search the place` (`Provision of the Code` OF 204, "") TRUE TRUE EQUALS NOTHING
#ASSERT `s 199(1) a justice may issue a warrant authorizing a peace officer to enter and search the place` (`Provision of the Code` OF 201, "") FALSE TRUE EQUALS NOTHING
#ASSERT `s 199(1) a justice may issue a warrant authorizing a peace officer to enter and search the place` (`Provision of the Code` OF 201, "") TRUE FALSE EQUALS NOTHING

-- (1) the warrant authorizes the taking into custody of "all persons who are found in or at that place"
#ASSERT `s 199(1) the warrant authorizes the taking of the person into custody` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 199(1) the warrant authorizes the taking of the person into custody` TRUE FALSE EQUALS NOTHING
#ASSERT `s 199(1) the warrant authorizes the taking of the person into custody` FALSE TRUE EQUALS NOTHING

-- (2) a peace officer may, whether or not acting under a warrant, take into custody any person whom he finds keeping a common gaming house and any person whom he finds therein
--                                                                  peace officer   gaming house    keeping in
#ASSERT `s 199(2) the peace officer may take the person into custody without a warrant` (JUST TRUE) (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 199(2) the peace officer may take the person into custody without a warrant` (JUST TRUE) (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 199(2) the peace officer may take the person into custody without a warrant` (JUST TRUE) (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 199(2) the peace officer may take the person into custody without a warrant` (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 199(2) the peace officer may take the person into custody without a warrant` NOTHING (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 199(2) the peace officer may seize the thing` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 199(2) the peace officer may seize the thing` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 199(2) the peace officer may seize the thing` (JUST FALSE) TRUE EQUALS NOTHING
-- the duty ("shall bring those persons and things before a justice having jurisdiction"), as a decision function
#ASSERT `s 199(2) the peace officer shall bring the persons and things before a justice having jurisdiction` TRUE EQUALS JUST TRUE
#ASSERT `s 199(2) the peace officer shall bring the persons and things before a justice having jurisdiction` FALSE EQUALS NOTHING
-- the duty as a regulative rule: no time is stated, so a trace with the act is fulfilled, and one without it prints the standing duty back
#TRACE `s 199(2) the peace officer's duty` AT 0 WITH
    PARTY `a peace officer` DOES `s 199(2) bring the persons and things before a justice having jurisdiction` AT 1
#TRACE `s 199(2) the peace officer's duty` AT 0 WITH

-- (3) forfeiture: "Except where otherwise expressly provided by law, a court ... before whom anything that is seized under this section is brought may declare that the thing is forfeited"
#ASSERT `s 199(3) the court, judge, justice or provincial court judge may declare the thing forfeited` TRUE TRUE FALSE EQUALS JUST TRUE
-- RECONCILED 2026-11-12: was `s 199(3) the court, judge, justice or provincial court judge may declare the thing forfeited` TRUE TRUE TRUE EQUALS NOTHING; the gate is where/when, so the site is listed and not flipped (fork F11)
#ASSERT `s 199(3) the court, judge, justice or provincial court judge may declare the thing forfeited` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 199(3) the court, judge, justice or provincial court judge may declare the thing forfeited` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 199(3) the court, judge, justice or provincial court judge may declare the thing forfeited` TRUE FALSE FALSE EQUALS NOTHING
-- (3) "... in which case it shall be disposed of or dealt with as the Attorney General may direct if no person shows sufficient cause why it should not be forfeited"
#ASSERT `s 199(3) the forfeited thing shall be disposed of or dealt with as the Attorney General may direct` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 199(3) the forfeited thing shall be disposed of or dealt with as the Attorney General may direct` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 199(3) the forfeited thing shall be disposed of or dealt with as the Attorney General may direct` FALSE FALSE EQUALS NOTHING

-- (4)(b) "the expiration of thirty days from the time of seizure": seized on 1 March 2025, day 30 is 31 March (the first day excluded, the last included), so the period has expired from 1 April
#ASSERT `s 199(4)(b) thirty days from the time of seizure have expired` (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST FALSE
#ASSERT `s 199(4)(b) thirty days from the time of seizure have expired` (Date 1 3 2025) (Date 1 4 2025) EQUALS JUST TRUE
#ASSERT `s 199(4)(b) thirty days from the time of seizure have expired` (Date 1 3 2025) (Date 1 3 2025) EQUALS JUST FALSE
-- (4) "No declaration or direction shall be made ... until (a) it is no longer required as evidence in any proceedings ... or (b) the expiration of thirty days ... where it is not required as evidence in any proceedings"
--                                                                                    (a)   (b) expired        not required
#ASSERT `s 199(4) a declaration or direction may be made under subsection 199(3)` TRUE  (JUST FALSE) FALSE EQUALS JUST TRUE
#ASSERT `s 199(4) a declaration or direction may be made under subsection 199(3)` FALSE (JUST TRUE)  TRUE  EQUALS JUST TRUE
#ASSERT `s 199(4) a declaration or direction may be made under subsection 199(3)` FALSE (JUST TRUE)  FALSE EQUALS JUST FALSE
#ASSERT `s 199(4) a declaration or direction may be made under subsection 199(3)` FALSE (JUST FALSE) TRUE  EQUALS JUST FALSE
#ASSERT `s 199(4) a declaration or direction may be made under subsection 199(3)` FALSE NOTHING      TRUE  EQUALS NOTHING

-- (5) "The Attorney General may, for the purpose of converting anything forfeited under this section into money, deal with it in all respects as if he were the owner thereof."
#ASSERT `s 199(5) the Attorney General may deal with the forfeited thing as if he were the owner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 199(5) the Attorney General may deal with the forfeited thing as if he were the owner` TRUE FALSE EQUALS NOTHING

-- (7) "Subsection (6) does not apply to prohibit the seizure, for use as evidence, of any facility or equipment described in that subsection that is designed or adapted to record a communication."
#ASSERT `s 199(7) subsection 199(6) does not apply to prohibit the seizure` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 199(7) subsection 199(6) does not apply to prohibit the seizure` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 199(7) subsection 199(6) does not apply to prohibit the seizure` TRUE FALSE TRUE EQUALS NOTHING
-- (6) "Nothing in this section or in section 489 authorizes the seizure, forfeiture or destruction of telephone, telegraph or other communication facilities or equipment ... owned by a person engaged in providing telephone ... service to the public"
--                                                                                                                       offence equipment owned  (7)
#ASSERT `s 199(6) this section or section 489 authorizes the seizure, forfeiture or destruction of the equipment` TRUE TRUE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 199(6) this section or section 489 authorizes the seizure, forfeiture or destruction of the equipment` TRUE TRUE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 199(6) this section or section 489 authorizes the seizure, forfeiture or destruction of the equipment` TRUE TRUE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 199(6) this section or section 489 authorizes the seizure, forfeiture or destruction of the equipment` FALSE TRUE TRUE NOTHING EQUALS NOTHING

§ `Sections 201 to 203 -- Offences`

-- A stand-in for the penalty section 787(1) gives a summary-conviction limb (that section is outside this part): it states nothing, so that only the limb of this part is tested.
`s 201(1) test fixture: a stand-in for the section 787(1) penalty` MEANS Punishment OF `on summary conviction`, `no imprisonment is stated`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`

-- 201(1) "Every person who keeps a common gaming house or common betting house is guilty of (a) an indictable offence and liable to imprisonment for a term of not more than two years; or (b) an offence punishable on summary conviction."
#ASSERT `s 201(1) the person commits the offence of keeping a common gaming house or common betting house` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 201(1) the person commits the offence of keeping a common gaming house or common betting house` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 201(1) the person commits the offence of keeping a common gaming house or common betting house` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 201(1) the person commits the offence of keeping a common gaming house or common betting house` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 201(1) the class of the offence` EQUALS `an offence that the section makes both indictable and punishable on summary conviction`
#ASSERT `s 201(1) the punishment` `s 201(1) test fixture: a stand-in for the section 787(1) penalty` EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 2, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`), `s 201(1) test fixture: a stand-in for the section 787(1) penalty`

-- 201(2) "Every one who (a) is found, without lawful excuse, in a common gaming house or common betting house, or (b) as owner, landlord, lessor, tenant, occupier or agent, knowingly permits a place to be let or used for the purposes of a common gaming house or common betting house, is guilty of an offence punishable on summary conviction."
--                                                                                                                               house       found excuse owner permits
#ASSERT `s 201(2) the person commits the offence of being found in, or permitting the use of, a gaming or betting house` (JUST TRUE) TRUE  FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 201(2) the person commits the offence of being found in, or permitting the use of, a gaming or betting house` (JUST TRUE) TRUE  TRUE  FALSE FALSE EQUALS NOTHING
#ASSERT `s 201(2) the person commits the offence of being found in, or permitting the use of, a gaming or betting house` (JUST TRUE) FALSE FALSE TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `s 201(2) the person commits the offence of being found in, or permitting the use of, a gaming or betting house` (JUST TRUE) FALSE FALSE TRUE  FALSE EQUALS NOTHING
#ASSERT `s 201(2) the person commits the offence of being found in, or permitting the use of, a gaming or betting house` (JUST TRUE) FALSE FALSE FALSE TRUE  EQUALS NOTHING
#ASSERT `s 201(2) the person commits the offence of being found in, or permitting the use of, a gaming or betting house` (JUST FALSE) TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 201(2) the class of the offence` EQUALS `an offence punishable on summary conviction`
#ASSERT `s 201(2) the punishment` `s 201(1) test fixture: a stand-in for the section 787(1) penalty` EQUALS LIST `s 201(1) test fixture: a stand-in for the section 787(1) penalty`

-- 202(1) "Every one commits an offence who (a) ... (j)": every one of the ten paragraphs creates the offence; paragraph (g) "does not apply to a newspaper, magazine or other periodical published in good faith primarily for a purpose other than the publication of such information"
#ASSERT `s 202(1) the person commits an offence` `s 202(1)(a) uses or knowingly allows a place under his control to be used for the purpose of recording or registering bets or selling a pool` FALSE EQUALS JUST TRUE
#ASSERT `s 202(1) the person commits an offence` `s 202(1)(b) imports, makes, buys, sells, rents, leases, hires or keeps, exhibits, employs or knowingly allows to be kept, exhibited or employed in any place under his control any device or apparatus for the purpose of recording or registering bets or selling a pool, or any machine or device for gambling or betting` FALSE EQUALS JUST TRUE
#ASSERT `s 202(1) the person commits an offence` `s 202(1)(c) has under his control any money or other property relating to a transaction that is an offence under this section` FALSE EQUALS JUST TRUE
#ASSERT `s 202(1) the person commits an offence` `s 202(1)(d) records or registers bets or sells a pool` FALSE EQUALS JUST TRUE
#ASSERT `s 202(1) the person commits an offence` `s 202(1)(e) engages in book-making or pool-selling, or in the business or occupation of betting, or makes any agreement for the purchase or sale of betting or gaming privileges, or for the purchase or sale of information that is intended to assist in book-making, pool-selling or betting` FALSE EQUALS JUST TRUE
#ASSERT `s 202(1) the person commits an offence` `s 202(1)(f) prints, provides or offers to print or provide information intended for use in connection with book-making, pool-selling or betting on any horse-race, fight, game or sport` FALSE EQUALS JUST TRUE
#ASSERT `s 202(1) the person commits an offence` `s 202(1)(g) imports or brings into Canada any information or writing that is intended or is likely to promote or be of use in gambling, book-making, pool-selling or betting on a horse-race, fight, game or sport` FALSE EQUALS JUST TRUE
#ASSERT `s 202(1) the person commits an offence` `s 202(1)(g) imports or brings into Canada any information or writing that is intended or is likely to promote or be of use in gambling, book-making, pool-selling or betting on a horse-race, fight, game or sport` TRUE EQUALS JUST FALSE
#ASSERT `s 202(1) the person commits an offence` `s 202(1)(h) advertises, prints, publishes, exhibits, posts up, or otherwise gives notice of any offer, invitation or inducement to bet on, to guess or to foretell the result of a contest, or a result of or contingency relating to any contest` TRUE EQUALS JUST TRUE
#ASSERT `s 202(1) the person commits an offence` `s 202(1)(i) wilfully and knowingly sends, transmits, delivers or receives any message that conveys any information relating to book-making, pool-selling, betting or wagering, or that is intended to assist in book-making, pool-selling, betting or wagering` FALSE EQUALS JUST TRUE
#ASSERT `s 202(1) the person commits an offence` `s 202(1)(j) aids or assists in any manner in anything that is an offence under this section` FALSE EQUALS JUST TRUE
#ASSERT `s 202(1) the class of the offence` EQUALS `an indictable offence`
-- 202(2) "guilty of an indictable offence and liable (a) for a first offence, to imprisonment for not more than two years; (b) for a second offence, ... not more than two years and not less than fourteen days; and (c) for each subsequent offence, ... not less than three months"
#ASSERT `s 202(2) the punishment` 0 EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 2, 0, 0, FALSE), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 202(2) the punishment` 1 EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 2, 0, 0, FALSE), `imprisonment for a term of` (`Length of time` OF 0, 0, 14, FALSE), `no fine is stated`, `no fine is stated`)
#ASSERT `s 202(2) the punishment` 2 EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 2, 0, 0, FALSE), `imprisonment for a term of` (`Length of time` OF 0, 3, 0, FALSE), `no fine is stated`, `no fine is stated`)
#ASSERT `s 202(2) the punishment` 7 EQUALS LIST (Punishment OF `by indictment`, `imprisonment for a term of` (`Length of time` OF 2, 0, 0, FALSE), `imprisonment for a term of` (`Length of time` OF 0, 3, 0, FALSE), `no fine is stated`, `no fine is stated`)

