IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc26-interpretation`
IMPORT `ccc26-punishment`

-- ccc26-tests-punishment.l4 -- tests for ccc26-punishment.l4 (sections 718.3 to 719). Every expected value is written from the text (lines 15252-15308) before the run.

-- An offence punishable with five years' imprisonment and a fine in the court's discretion, on indictment.
`test punishment, five years and a fine` MEANS Punishment OF `by indictment`, (`imprisonment for a term of` `five years`), `no imprisonment is stated`, `a fine in the discretion of the court`, `no fine is stated`

§ `s 718.3(1) and (2): the punishment is in the discretion of the court, subject to the limitations in the enactment`

#ASSERT `s 718.3(1) the punishment is in the discretion of the court` TRUE TRUE EQUALS JUST TRUE
-- outside the limitations the enactment prescribes: the discretion does not reach
#ASSERT `s 718.3(1) the punishment is in the discretion of the court` TRUE FALSE EQUALS JUST FALSE
-- "Where an enactment prescribes different degrees or kinds of punishment": the gate fails
#ASSERT `s 718.3(1) the punishment is in the discretion of the court` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 718.3(2) the punishment is in the discretion of the court` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 718.3(2) the punishment is in the discretion of the court` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 718.3(2) the punishment is in the discretion of the court` FALSE TRUE EQUALS JUST FALSE
-- "no punishment is a minimum punishment unless it is declared to be a minimum punishment"
#ASSERT `s 718.3(2) the punishment is a minimum punishment` TRUE EQUALS JUST TRUE
#ASSERT `s 718.3(2) the punishment is a minimum punishment` FALSE EQUALS JUST FALSE

§ `s 718.3(3): imprisonment in default of payment of a fine, where the enactment names no term`

-- both fine and imprisonment, no term in default named: the cap is the term prescribed for the offence
#ASSERT `s 718.3(3) the longest imprisonment in default of payment of the fine` `test punishment, five years and a fine` TRUE FALSE EQUALS JUST (`imprisonment for a term of` `five years`)
-- the enactment names a term: this section sets no cap
#ASSERT `s 718.3(3) the longest imprisonment in default of payment of the fine` `test punishment, five years and a fine` TRUE TRUE EQUALS NOTHING
-- not punishable with both: this section sets no cap
#ASSERT `s 718.3(3) the longest imprisonment in default of payment of the fine` `test punishment, five years and a fine` FALSE FALSE EQUALS NOTHING
-- imprisonment for life is a cap too
#ASSERT `s 718.3(3) the longest imprisonment in default of payment of the fine` (Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `a fine in the discretion of the court`, `no fine is stated`) TRUE FALSE EQUALS JUST `imprisonment for life`

§ `s 718.3(4): the court shall consider directing consecutive service`

--                                                                                         subject to a sentence at sentencing, court imposes a term
#ASSERT `s 718.3(4)(a) the court must consider directing that the term be served consecutively to the sentence the accused is already subject to` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 718.3(4)(a) the court must consider directing that the term be served consecutively to the sentence the accused is already subject to` FALSE TRUE EQUALS NOTHING
#ASSERT `s 718.3(4)(a) the court must consider directing that the term be served consecutively to the sentence the accused is already subject to` TRUE FALSE EQUALS NOTHING
#ASSERT `s 718.3(4)(b) the court must consider directing that the terms be served consecutively` TRUE EQUALS JUST TRUE
#ASSERT `s 718.3(4)(b) the court must consider directing that the terms be served consecutively` FALSE EQUALS NOTHING

§ `s 718.3(4)(b)(i) to (iv): the cases the paragraph names ("including when")`

--                                                      (i) not same event, (ii) on release, (iii) fleeing, (iv) violence, convicted, date of conviction, sentence date
#ASSERT `s 718.3(4)(b) the case is one the paragraph names` TRUE FALSE FALSE FALSE FALSE (Date 1 1 2020) (Date 1 3 2027) EQUALS JUST TRUE
#ASSERT `s 718.3(4)(b) the case is one the paragraph names` FALSE TRUE FALSE FALSE FALSE (Date 1 1 2020) (Date 1 3 2027) EQUALS JUST TRUE
#ASSERT `s 718.3(4)(b) the case is one the paragraph names` FALSE FALSE TRUE FALSE FALSE (Date 1 1 2020) (Date 1 3 2027) EQUALS JUST TRUE
-- (iv) needs violence AND a conviction within the previous five years
#ASSERT `s 718.3(4)(b) the case is one the paragraph names` FALSE FALSE FALSE TRUE TRUE (Date 1 3 2022) (Date 1 3 2027) EQUALS JUST TRUE
#ASSERT `s 718.3(4)(b) the case is one the paragraph names` FALSE FALSE FALSE TRUE TRUE (Date 28 2 2022) (Date 1 3 2027) EQUALS NOTHING
#ASSERT `s 718.3(4)(b) the case is one the paragraph names` FALSE FALSE FALSE TRUE FALSE (Date 1 3 2026) (Date 1 3 2027) EQUALS NOTHING
#ASSERT `s 718.3(4)(b) the case is one the paragraph names` FALSE FALSE FALSE FALSE TRUE (Date 1 3 2026) (Date 1 3 2027) EQUALS NOTHING
-- "including when": a case none of the four describes is not covered
#ASSERT `s 718.3(4)(b) the case is one the paragraph names` FALSE FALSE FALSE FALSE FALSE (Date 1 3 2026) (Date 1 3 2027) EQUALS NOTHING

§ `s 718.3(5) and (6): what counts as a term or sentence of imprisonment for subsection (4)`

#ASSERT `s 718.3(5) the imprisonment counts as a term of imprisonment for subsection (4)` TRUE EQUALS JUST TRUE
#ASSERT `s 718.3(5) the imprisonment counts as a term of imprisonment for subsection (4)` FALSE EQUALS NOTHING
#ASSERT `s 718.3(6) the sentence counts as a sentence of imprisonment for subsection (4)` `s 718.3(6)(a) a disposition made under paragraph 20(1)(k) or (k.1) of the Young Offenders Act` EQUALS JUST TRUE
#ASSERT `s 718.3(6) the sentence counts as a sentence of imprisonment for subsection (4)` `s 718.3(6)(b) a youth sentence imposed under paragraph 42(2)(n), (o), (q) or (r) of the Youth Criminal Justice Act` EQUALS JUST TRUE
#ASSERT `s 718.3(6) the sentence counts as a sentence of imprisonment for subsection (4)` `s 718.3(6)(c) a sentence that results from the operation of subsection 743.5(1) or (2)` EQUALS JUST TRUE
#ASSERT `s 718.3(6) the sentence counts as a sentence of imprisonment for subsection (4)` `s 718.3(6) a sentence of another kind` EQUALS NOTHING

§ `s 718.3(7): sexual offences against a child: the court shall direct consecutive service`

--                                                                                  more than one sexual offence against a child, 163.1 sentence, other sentence
#ASSERT `s 718.3(7)(a) the court must direct that the section 163.1 sentence be served consecutively to the other sentence` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 718.3(7)(a) the court must direct that the section 163.1 sentence be served consecutively to the other sentence` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 718.3(7)(a) the court must direct that the section 163.1 sentence be served consecutively to the other sentence` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 718.3(7)(a) the court must direct that the section 163.1 sentence be served consecutively to the other sentence` TRUE TRUE FALSE EQUALS JUST FALSE
--                                                                                                        more than one, sentence for a child, sentence for another child
#ASSERT `s 718.3(7)(b) the court must direct that the sentences for offences against different children be served consecutively` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 718.3(7)(b) the court must direct that the sentences for offences against different children be served consecutively` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 718.3(7)(b) the court must direct that the sentences for offences against different children be served consecutively` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 718.3(7)(b) the court must direct that the sentences for offences against different children be served consecutively` TRUE TRUE FALSE EQUALS JUST FALSE

§ `s 718.3(8): repealed`

#ASSERT `s 718.3(8), repealed` EQUALS "[Repealed, 2026, c. 12, s. 9]"

§ `s 718.4: shorter term of imprisonment than a minimum punishment`

-- a minimum of a specified term and a sentence that would be cruel and unusual: shall impose a shorter term
#ASSERT `s 718.4(1) the court must impose a shorter term of imprisonment than the minimum` (`imprisonment for a term of` `two years`) TRUE EQUALS JUST TRUE
-- the "if" fails
#ASSERT `s 718.4(1) the court must impose a shorter term of imprisonment than the minimum` (`imprisonment for a term of` `two years`) FALSE EQUALS JUST FALSE
-- subsection (2): a minimum of imprisonment for life
#ASSERT `s 718.4(1) the court must impose a shorter term of imprisonment than the minimum` `imprisonment for life` TRUE EQUALS JUST FALSE
-- no minimum term of imprisonment
#ASSERT `s 718.4(1) the court must impose a shorter term of imprisonment than the minimum` `no imprisonment is stated` TRUE EQUALS JUST FALSE
#ASSERT `s 718.4(3) subsection (1) leaves the operation of the provision unaffected` (`Provision of the Code` OF 320.23, "") EQUALS JUST TRUE
#ASSERT `s 718.4(3) subsection (1) leaves the operation of the provision unaffected` (`Provision of the Code` OF 320.22, "") EQUALS NOTHING
#ASSERT `s 718.4(4) the court must include in the record a statement of its reasons` TRUE EQUALS JUST TRUE
#ASSERT `s 718.4(4) the court must include in the record a statement of its reasons` FALSE EQUALS NOTHING
#ASSERT `s 718.4(5) the shorter term counts as a minimum term of imprisonment for this Part` TRUE EQUALS JUST TRUE
#ASSERT `s 718.4(5) the shorter term counts as a minimum term of imprisonment for this Part` FALSE EQUALS NOTHING

§ `s 719(1): a sentence commences when it is imposed, except where a relevant enactment otherwise provides`

#ASSERT `s 719(1) the sentence commences when it is imposed` FALSE EQUALS JUST TRUE
#ASSERT `s 719(1) the sentence commences when it is imposed` TRUE EQUALS JUST FALSE
#ASSERT `s 719(1) the day the sentence commences` (Date 1 3 2027) FALSE EQUALS JUST (Date 1 3 2027)
-- a relevant enactment gives the day: it is not in this text
#ASSERT `s 719(1) the day the sentence commences` (Date 1 3 2027) TRUE EQUALS NOTHING

§ `s 719(2): time at large does not count as part of a term of imprisonment`

#ASSERT `s 719(2) the time is excluded from the term of imprisonment` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 719(2) the time is excluded from the term of imprisonment` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 719(2) the time is excluded from the term of imprisonment` TRUE TRUE EQUALS JUST TRUE
-- time neither unlawfully at large nor on interim release under this Act: the subsection says nothing
#ASSERT `s 719(2) the time is excluded from the term of imprisonment` FALSE FALSE EQUALS NOTHING

§ `s 719(3): credit for time in custody, one day for each day; (3.1): one and one-half days if the circumstances justify it`

#ASSERT `s 719(3) the court may take the time into account` TRUE EQUALS JUST TRUE
#ASSERT `s 719(3) the court may take the time into account` FALSE EQUALS NOTHING
#ASSERT `s 719(3) the greatest credit, in days, for the time spent in custody` 100 EQUALS 100
#ASSERT `s 719(3) the greatest credit, in days, for the time spent in custody` 0 EQUALS 0
#ASSERT `s 719(3.1) the greatest credit, in days, for the time spent in custody, when the circumstances justify it` 100 TRUE EQUALS 150
#ASSERT `s 719(3.1) the greatest credit, in days, for the time spent in custody, when the circumstances justify it` 101 TRUE EQUALS 151.5
-- the circumstances do not justify the exception: one day for each day
#ASSERT `s 719(3.1) the greatest credit, in days, for the time spent in custody, when the circumstances justify it` 100 FALSE EQUALS 100
--                                                                                    credit, days in custody, exception justified
#ASSERT `s 719(3) the credit is barred as above the greatest the section allows` 100 100 FALSE EQUALS JUST FALSE
#ASSERT `s 719(3) the credit is barred as above the greatest the section allows` 101 100 FALSE EQUALS JUST TRUE
#ASSERT `s 719(3) the credit is barred as above the greatest the section allows` 150 100 TRUE EQUALS JUST FALSE
#ASSERT `s 719(3) the credit is barred as above the greatest the section allows` 151 100 TRUE EQUALS JUST TRUE
#ASSERT `s 719(3) the credit is barred as above the greatest the section allows` 150 100 FALSE EQUALS JUST TRUE
#ASSERT `s 719(3) the credit is barred as above the greatest the section allows` 0 0 FALSE EQUALS JUST FALSE

§ `s 719(3.2) to (3.4): reasons, the record, and the validity of the sentence`

#ASSERT `s 719(3.2) the court must give reasons for the credit granted and have them stated in the record` TRUE EQUALS JUST TRUE
#ASSERT `s 719(3.2) the court must give reasons for the credit granted and have them stated in the record` FALSE EQUALS NOTHING
#ASSERT `s 719(3.3) the record and the warrant of committal state what the subsection requires` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 719(3.3) the record and the warrant of committal state what the subsection requires` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 719(3.3) the record and the warrant of committal state what the subsection requires` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 719(3.3) the record and the warrant of committal state what the subsection requires` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 719(3.3) the record and the warrant of committal state what the subsection requires` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 719(3.3) the record and the warrant of committal state what the subsection requires` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 719(3.4) the failure leaves the validity of the sentence unaffected` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 719(3.4) the failure leaves the validity of the sentence unaffected` FALSE TRUE EQUALS JUST TRUE
-- no failure to comply with (3.2) or (3.3): the subsection says nothing about validity
#ASSERT `s 719(3.4) the failure leaves the validity of the sentence unaffected` FALSE FALSE EQUALS NOTHING

§ `s 719(4) to (6): when the term runs, a fine in default, an application for leave to appeal`

#ASSERT `s 719(4) the day the term of imprisonment commences or is resumed` TRUE (Date 15 6 2027) EQUALS JUST (Date 15 6 2027)
#ASSERT `s 719(4) the day the term of imprisonment commences or is resumed` FALSE (Date 15 6 2027) EQUALS NOTHING
#ASSERT `s 719(5) the time is excluded from the term of imprisonment in default of payment` TRUE TRUE EQUALS JUST TRUE
-- on or after the day the warrant of committal is executed
#ASSERT `s 719(5) the time is excluded from the term of imprisonment in default of payment` TRUE FALSE EQUALS JUST FALSE
-- not a fine with imprisonment in default
#ASSERT `s 719(5) the time is excluded from the term of imprisonment in default of payment` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 719(6) the application counts as an appeal for section 719` TRUE EQUALS JUST TRUE
#ASSERT `s 719(6) the application counts as an appeal for section 719` FALSE EQUALS NOTHING
