IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc5-s117-02-to-117-06`

-- Tests for ccc5-s117-02-to-117-06.l4. Every expected value was decided from the text before the run; a failing assertion is a finding.

-- s 117.02(1) the peace officer may search without a warrant and seize: expected values follow the text (s 117.02(1))
#ASSERT `s 117.02(1) the peace officer may search without a warrant and seize` (JUST TRUE) TRUE FALSE TRUE (JUST FALSE) TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.02(1) the peace officer may search without a warrant and seize` NOTHING TRUE FALSE TRUE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE   -- element missing: s 2 peace officer: the officer is one
#ASSERT `s 117.02(1) the peace officer may search without a warrant and seize` (JUST TRUE) FALSE FALSE TRUE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE   -- element missing: the peace officer believes on reasonable grounds that a weapon, an imitation firearm, a prohibited device, a firearm part, any ammunition, any prohibited ammunition or an explosive substance was used in the commission of an offence / the peace officer believes on reasonable grounds that an offence is being committed, or has been committed, under a provision of this Act that involves, or the subject-matter of which is, a firearm, an imitation firearm, a cross-bow, a prohibited weapon, a restricted weapon, a prohibited device, a firearm part, ammunition, prohibited ammunition or an explosive substance
#ASSERT `s 117.02(1) the peace officer may search without a warrant and seize` (JUST TRUE) TRUE FALSE TRUE (JUST FALSE) TRUE TRUE EQUALS JUST TRUE   -- alternative present: the peace officer believes on reasonable grounds that a weapon, an imitation firearm, a prohibited device, a firearm part, any ammunition, any prohibited ammunition or an explosive substance was used in the commission of an offence
#ASSERT `s 117.02(1) the peace officer may search without a warrant and seize` (JUST TRUE) FALSE TRUE TRUE (JUST FALSE) TRUE TRUE EQUALS JUST TRUE   -- alternative present: the peace officer believes on reasonable grounds that an offence is being committed, or has been committed, under a provision of this Act that involves, or the subject-matter of which is, a firearm, an imitation firearm, a cross-bow, a prohibited weapon, a restricted weapon, a prohibited device, a firearm part, ammunition, prohibited ammunition or an explosive substance
#ASSERT `s 117.02(1) the peace officer may search without a warrant and seize` (JUST TRUE) TRUE FALSE FALSE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE   -- element missing: the peace officer believes on reasonable grounds that evidence of the offence is likely to be found on a person, in a vehicle or in a place or premises
#ASSERT `s 117.02(1) the peace officer may search without a warrant and seize` (JUST TRUE) TRUE FALSE TRUE (JUST TRUE) TRUE TRUE EQUALS JUST FALSE   -- element missing: s 2 dwelling-house: the place or premises is one
#ASSERT `s 117.02(1) the peace officer may search without a warrant and seize` (JUST TRUE) TRUE FALSE TRUE (JUST FALSE) FALSE TRUE EQUALS JUST FALSE   -- element missing: the conditions for obtaining a warrant exist
#ASSERT `s 117.02(1) the peace officer may search without a warrant and seize` (JUST TRUE) TRUE FALSE TRUE (JUST FALSE) TRUE FALSE EQUALS JUST FALSE   -- element missing: by reason of exigent circumstances, it would not be practicable to obtain a warrant
#ASSERT `s 117.02(1) the peace officer may search without a warrant and seize` (JUST FALSE) TRUE FALSE TRUE (JUST FALSE) TRUE TRUE EQUALS JUST FALSE   -- s 2 peace officer: the officer is one: the other way it can fail ((JUST FALSE))
#ASSERT `s 117.02(1) the peace officer may search without a warrant and seize` (JUST TRUE) TRUE FALSE TRUE NOTHING TRUE TRUE EQUALS JUST FALSE   -- s 2 dwelling-house: the place or premises is one: the other way it can fail (NOTHING)

-- s 117.02(2) the thing seized is to be dealt with in accordance with sections 490 and 491: expected values follow the text (s 117.02(2))
#ASSERT `s 117.02(2) the thing seized is to be dealt with in accordance with sections 490 and 491` TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.02(2) the thing seized is to be dealt with in accordance with sections 490 and 491` FALSE EQUALS NOTHING   -- element missing: the thing is seized pursuant to subsection (1)

-- s 117.03(1) the peace officer may seize the firearm, weapon, device or ammunition: expected values follow the text (s 117.03(1))
#ASSERT `s 117.03(1) the peace officer may seize the firearm, weapon, device or ammunition` (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.03(1) the peace officer may seize the firearm, weapon, device or ammunition` NOTHING TRUE FALSE FALSE FALSE EQUALS NOTHING   -- element missing: s 2 peace officer: the officer is one
#ASSERT `s 117.03(1) the peace officer may seize the firearm, weapon, device or ammunition` (JUST TRUE) FALSE FALSE FALSE FALSE EQUALS NOTHING   -- element missing: the peace officer finds a person in possession of a prohibited firearm, a restricted firearm or a non-restricted firearm who fails, on demand, to produce, for inspection by the peace officer, an authorization or a licence under which the person may lawfully possess the firearm and, in the case of a prohibited firearm or a restricted firearm, a registration certificate for it / the peace officer finds a person in possession of a prohibited weapon, a restricted weapon, a prohibited device or any prohibited ammunition who fails, on demand, to produce, for inspection by the peace officer, an authorization or a licence under which the person may lawfully possess it
#ASSERT `s 117.03(1) the peace officer may seize the firearm, weapon, device or ammunition` (JUST TRUE) TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the peace officer finds a person in possession of a prohibited firearm, a restricted firearm or a non-restricted firearm who fails, on demand, to produce, for inspection by the peace officer, an authorization or a licence under which the person may lawfully possess the firearm and, in the case of a prohibited firearm or a restricted firearm, a registration certificate for it
#ASSERT `s 117.03(1) the peace officer may seize the firearm, weapon, device or ammunition` (JUST TRUE) FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the peace officer finds a person in possession of a prohibited weapon, a restricted weapon, a prohibited device or any prohibited ammunition who fails, on demand, to produce, for inspection by the peace officer, an authorization or a licence under which the person may lawfully possess it
#ASSERT `s 117.03(1) the peace officer may seize the firearm, weapon, device or ammunition` (JUST FALSE) TRUE FALSE FALSE FALSE EQUALS NOTHING   -- s 2 peace officer: the officer is one: the other way it can fail ((JUST FALSE))
#ASSERT `s 117.03(1) the peace officer may seize the firearm, weapon, device or ammunition` (JUST TRUE) TRUE FALSE TRUE FALSE EQUALS JUST FALSE   -- exception: its possession by the person in the circumstances in which it is found is authorized by any provision of this Part
#ASSERT `s 117.03(1) the peace officer may seize the firearm, weapon, device or ammunition` (JUST TRUE) TRUE FALSE FALSE TRUE EQUALS JUST FALSE   -- exception: the person is under the direct and immediate supervision of another person who may lawfully possess it


-- s 117.03(2) the claim is made within 14 days after the seizure: the 14th day after the seizure is still "within 14 days"; the 15th is not
#ASSERT `s 117.03(2) the claim is made within 14 days after the seizure` (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST TRUE   -- the day of the seizure
#ASSERT `s 117.03(2) the claim is made within 14 days after the seizure` (Date 1 3 2026) (Date 14 3 2026) EQUALS JUST TRUE
#ASSERT `s 117.03(2) the claim is made within 14 days after the seizure` (Date 1 3 2026) (Date 15 3 2026) EQUALS JUST TRUE   -- exactly 14 days after
#ASSERT `s 117.03(2) the claim is made within 14 days after the seizure` (Date 1 3 2026) (Date 16 3 2026) EQUALS JUST FALSE   -- 15 days after
#ASSERT `s 117.03(2) the claim is made within 14 days after the seizure` (Date 1 3 2026) (Date 28 2 2026) EQUALS JUST FALSE   -- a claim before the seizure is no claim within the period

-- s 117.03(2) the thing is to be returned without delay: expected values follow the text (s 117.03(2))
#ASSERT `s 117.03(2) the thing is to be returned without delay` TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.03(2) the thing is to be returned without delay` FALSE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE   -- element missing: the thing was seized from the person under subsection (1)
#ASSERT `s 117.03(2) the thing is to be returned without delay` TRUE NOTHING TRUE FALSE FALSE EQUALS JUST FALSE   -- element missing: the answer of s 117.03(2) the claim is made within 14 days after the seizure
#ASSERT `s 117.03(2) the thing is to be returned without delay` TRUE (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE   -- element missing: the person produces for inspection by the peace officer who seized it, or any other peace officer having custody of it, a licence under which the person is lawfully entitled to possess it
#ASSERT `s 117.03(2) the thing is to be returned without delay` TRUE (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE   -- element missing: the thing is a prohibited firearm or a restricted firearm / the person produces an authorization and registration certificate for it
#ASSERT `s 117.03(2) the thing is to be returned without delay` TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE   -- alternative present: the thing is a prohibited firearm or a restricted firearm
#ASSERT `s 117.03(2) the thing is to be returned without delay` TRUE (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE   -- alternative present: the person produces an authorization and registration certificate for it
#ASSERT `s 117.03(2) the thing is to be returned without delay` TRUE (JUST FALSE) TRUE FALSE FALSE EQUALS JUST FALSE   -- the answer of s 117.03(2) the claim is made within 14 days after the seizure: the other way it can fail ((JUST FALSE))


-- the regulative rule, run (a trace prints its outcome and cannot be asserted on the stable binary). Expected, decided from the text: claim on day 14 and return -> FULFILLED;
-- claim on day 14, not yet returned -> the officer's duty stands; claim on day 15 (too late) -> FULFILLED, the permission lapsed with no consequence; no claim -> FULFILLED.
-- The permission is written with DO ... LEST FULFILLED, not MAY: a lapsed MAY with a HENCE chain enters the HENCE duty on 1.6.109 and 1.6.110 (NOTES.md, finding on the binary).
-- "without delay" states no number, so the officer's duty carries no WITHIN (NOTES.md, fork register).
#TRACE `s 117.03(2) the person may claim the thing within 14 days and the officer must then return it` AT 0 WITH
    PARTY `the accused` DOES `s 117.03(2) claim the thing and produce the licence` AT 14
    PARTY `a peace officer` DOES `s 117.03(2) return the thing to the person` AT 15
#TRACE `s 117.03(2) the person may claim the thing within 14 days and the officer must then return it` AT 0 WITH
    PARTY `the accused` DOES `s 117.03(2) claim the thing and produce the licence` AT 14
#TRACE `s 117.03(2) the person may claim the thing within 14 days and the officer must then return it` AT 0 WITH
    PARTY `the accused` DOES `s 117.03(2) claim the thing and produce the licence` AT 15
#TRACE `s 117.03(2) the person may claim the thing within 14 days and the officer must then return it` AT 0 WITH
    WAITUNTIL 20

-- s 117.03(3) the peace officer is bound to take the thing forthwith before a provincial court judge: expected values follow the text (s 117.03(3))
#ASSERT `s 117.03(3) the peace officer is bound to take the thing forthwith before a provincial court judge` TRUE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.03(3) the peace officer is bound to take the thing forthwith before a provincial court judge` FALSE FALSE EQUALS JUST FALSE   -- element missing: the thing was seized pursuant to subsection (1)
#ASSERT `s 117.03(3) the peace officer is bound to take the thing forthwith before a provincial court judge` TRUE TRUE EQUALS JUST FALSE   -- element missing: the thing was claimed and returned as and when provided by subsection (2)

-- s 117.03(3) the provincial court judge may declare the thing forfeited to Her Majesty: expected values follow the text (s 117.03(3))
#ASSERT `s 117.03(3) the provincial court judge may declare the thing forfeited to Her Majesty` TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.03(3) the provincial court judge may declare the thing forfeited to Her Majesty` FALSE TRUE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was #ASSERT `s 117.03(3) the provincial court judge may declare the thing forfeited to Her Majesty` FALSE TRUE EQUALS NOTHING; the gate is of the where, when or upon kind, so the name-test sweep of 2026-11-12 (test 3(i)) lists the function and leaves the answer as the guide's ruling (b) of 2026-11-05 gives it: JUST FALSE, not NOTHING ("Where any thing ... is not claimed and returned", "after affording ... an opportunity") (element missing: the thing was taken before the judge under this subsection)
#ASSERT `s 117.03(3) the provincial court judge may declare the thing forfeited to Her Majesty` TRUE FALSE EQUALS JUST FALSE   -- RECONCILED 2026-11-12: was #ASSERT `s 117.03(3) the provincial court judge may declare the thing forfeited to Her Majesty` TRUE FALSE EQUALS NOTHING; the gate is of the where, when or upon kind, so the name-test sweep of 2026-11-12 (test 3(i)) lists the function and leaves the answer as the guide's ruling (b) of 2026-11-05 gives it: JUST FALSE, not NOTHING ("Where any thing ... is not claimed and returned", "after affording ... an opportunity") (element missing: the judge has afforded the person from whom it was seized, or its owner if known, an opportunity to establish that the person is lawfully entitled to possess it)

-- s 117.04(1) the justice may issue a warrant authorizing a peace officer to search the building, receptacle or place and seize: expected values follow the text (s 117.04(1))
#ASSERT `s 117.04(1) the justice may issue a warrant authorizing a peace officer to search the building, receptacle or place and seize` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.04(1) the justice may issue a warrant authorizing a peace officer to search the building, receptacle or place and seize` NOTHING TRUE TRUE TRUE EQUALS JUST FALSE   -- element missing: s 2 justice: the person is one
#ASSERT `s 117.04(1) the justice may issue a warrant authorizing a peace officer to search the building, receptacle or place and seize` (JUST TRUE) FALSE TRUE TRUE EQUALS JUST FALSE   -- element missing: a peace officer has applied with respect to the person
#ASSERT `s 117.04(1) the justice may issue a warrant authorizing a peace officer to search the building, receptacle or place and seize` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE   -- element missing: the justice is satisfied by information on oath that there are reasonable grounds to believe that the person possesses a weapon, a prohibited device, a firearm part, ammunition, prohibited ammunition or an explosive substance in a building, receptacle or place
#ASSERT `s 117.04(1) the justice may issue a warrant authorizing a peace officer to search the building, receptacle or place and seize` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE   -- element missing: the justice is satisfied that it is not desirable in the interests of the safety of the person, or of any other person, for the person to possess it
#ASSERT `s 117.04(1) the justice may issue a warrant authorizing a peace officer to search the building, receptacle or place and seize` (JUST FALSE) TRUE TRUE TRUE EQUALS JUST FALSE   -- s 2 justice: the person is one: the other way it can fail ((JUST FALSE))

-- s 117.04(2) the peace officer may search for and seize without a warrant: expected values follow the text (s 117.04(2))
#ASSERT `s 117.04(2) the peace officer may search for and seize without a warrant` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.04(2) the peace officer may search for and seize without a warrant` NOTHING TRUE TRUE TRUE EQUALS JUST FALSE   -- element missing: s 2 peace officer: the officer is one
#ASSERT `s 117.04(2) the peace officer may search for and seize without a warrant` (JUST TRUE) FALSE TRUE TRUE EQUALS JUST FALSE   -- element missing: the peace officer is satisfied that there are reasonable grounds to believe that it is not desirable, in the interests of the safety of the person or any other person, for the person to possess any weapon, prohibited device, firearm part, ammunition, prohibited ammunition or explosive substance
#ASSERT `s 117.04(2) the peace officer may search for and seize without a warrant` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE   -- element missing: the grounds for obtaining a warrant under subsection (1) exist
#ASSERT `s 117.04(2) the peace officer may search for and seize without a warrant` (JUST TRUE) TRUE TRUE FALSE EQUALS JUST FALSE   -- element missing: by reason of a possible danger to the safety of that person or any other person, it would not be practicable to obtain a warrant
#ASSERT `s 117.04(2) the peace officer may search for and seize without a warrant` (JUST FALSE) TRUE TRUE TRUE EQUALS JUST FALSE   -- s 2 peace officer: the officer is one: the other way it can fail ((JUST FALSE))

-- s 117.04(3) the peace officer is bound to make a report immediately to a justice having jurisdiction: expected values follow the text (s 117.04(3))
#ASSERT `s 117.04(3) the peace officer is bound to make a report immediately to a justice having jurisdiction` TRUE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.04(3) the peace officer is bound to make a report immediately to a justice having jurisdiction` FALSE FALSE EQUALS NOTHING   -- element missing: the peace officer executes a warrant referred to in subsection (1) / the peace officer conducts a search without a warrant under subsection (2)
#ASSERT `s 117.04(3) the peace officer is bound to make a report immediately to a justice having jurisdiction` TRUE FALSE EQUALS JUST TRUE   -- alternative present: the peace officer executes a warrant referred to in subsection (1)
#ASSERT `s 117.04(3) the peace officer is bound to make a report immediately to a justice having jurisdiction` FALSE TRUE EQUALS JUST TRUE   -- alternative present: the peace officer conducts a search without a warrant under subsection (2)

-- s 117.04(3) the report shows what the subsection requires: expected values follow the text (s 117.04(3))
#ASSERT `s 117.04(3) the report shows what the subsection requires` TRUE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.04(3) the report shows what the subsection requires` FALSE FALSE EQUALS NOTHING   -- element missing: the report is of an execution of a warrant and shows the things or documents, if any, seized and the date of execution of the warrant / the report is of a search without a warrant and shows the grounds on which it was concluded that the peace officer was entitled to conduct the search, and the things or documents, if any, seized
#ASSERT `s 117.04(3) the report shows what the subsection requires` TRUE FALSE EQUALS JUST TRUE   -- alternative present: the report is of an execution of a warrant and shows the things or documents, if any, seized and the date of execution of the warrant
#ASSERT `s 117.04(3) the report shows what the subsection requires` FALSE TRUE EQUALS JUST TRUE   -- alternative present: the report is of a search without a warrant and shows the grounds on which it was concluded that the peace officer was entitled to conduct the search, and the things or documents, if any, seized

-- s 117.04(4) every authorization, licence and registration certificate held by the person is revoked as at the time of the seizure: expected values follow the text (s 117.04(4))
#ASSERT `s 117.04(4) every authorization, licence and registration certificate held by the person is revoked as at the time of the seizure` TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.04(4) every authorization, licence and registration certificate held by the person is revoked as at the time of the seizure` FALSE TRUE EQUALS JUST FALSE   -- element missing: a peace officer seizes any thing under subsection (1) or (2)
#ASSERT `s 117.04(4) every authorization, licence and registration certificate held by the person is revoked as at the time of the seizure` TRUE FALSE EQUALS JUST FALSE   -- element missing: the peace officer is unable at the time of the seizure to seize an authorization or a licence under which the person may possess the thing and, in the case of a seized firearm, a registration certificate for the firearm


-- s 117.05(1) the application is made within 30 days after the execution or the seizure: day 30 after the execution or seizure is still "within 30 days"; day 31 is not
#ASSERT `s 117.05(1) the application is made within 30 days after the execution or the seizure` (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 117.05(1) the application is made within 30 days after the execution or the seizure` (Date 1 3 2026) (Date 31 3 2026) EQUALS JUST TRUE   -- exactly 30 days after
#ASSERT `s 117.05(1) the application is made within 30 days after the execution or the seizure` (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST FALSE   -- 31 days after
#ASSERT `s 117.05(1) the application is made within 30 days after the execution or the seizure` (Date 1 3 2026) (Date 28 2 2026) EQUALS JUST FALSE   -- before the execution or the seizure

-- s 117.05(1) the justice is bound to fix a date for the hearing and direct that notice of it be given: expected values follow the text (s 117.05(1))
#ASSERT `s 117.05(1) the justice is bound to fix a date for the hearing and direct that notice of it be given` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.05(1) the justice is bound to fix a date for the hearing and direct that notice of it be given` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE   -- element missing: a thing or document has been seized under subsection 117.04(1) or (2)
#ASSERT `s 117.05(1) the justice is bound to fix a date for the hearing and direct that notice of it be given` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE   -- element missing: the application for an order for the disposition is made by a peace officer
#ASSERT `s 117.05(1) the justice is bound to fix a date for the hearing and direct that notice of it be given` TRUE TRUE NOTHING EQUALS JUST FALSE   -- element missing: the answer of s 117.05(1) the application is made within 30 days after the execution or the seizure
#ASSERT `s 117.05(1) the justice is bound to fix a date for the hearing and direct that notice of it be given` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE   -- the answer of s 117.05(1) the application is made within 30 days after the execution or the seizure: the other way it can fail ((JUST FALSE))


-- the regulative rule, run. Expected, decided from the text: application on day 30 and the justice acts -> FULFILLED; application on day 30 and no act yet -> the justice's duty stands;
-- application on day 31 (too late) -> FULFILLED; no application -> FULFILLED. (DO ... LEST FULFILLED, not MAY: see the note beside s 117.03(2).)
#TRACE `s 117.05(1) the peace officer may apply within 30 days and the justice must then fix a date for the hearing` AT 0 WITH
    PARTY `a peace officer` DOES `s 117.05(1) apply for an order for the disposition of the thing or document` AT 30
    PARTY `a justice` DOES `s 117.05(1) fix a date for the hearing and direct that notice be given` AT 31
#TRACE `s 117.05(1) the peace officer may apply within 30 days and the justice must then fix a date for the hearing` AT 0 WITH
    PARTY `a peace officer` DOES `s 117.05(1) apply for an order for the disposition of the thing or document` AT 30
#TRACE `s 117.05(1) the peace officer may apply within 30 days and the justice must then fix a date for the hearing` AT 0 WITH
    PARTY `a peace officer` DOES `s 117.05(1) apply for an order for the disposition of the thing or document` AT 31
#TRACE `s 117.05(1) the peace officer may apply within 30 days and the justice must then fix a date for the hearing` AT 0 WITH
    WAITUNTIL 40

-- s 117.05(2) the justice may proceed ex parte to hear and determine the application: expected values follow the text (s 117.05(2))
#ASSERT `s 117.05(2) the justice may proceed ex parte to hear and determine the application` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.05(2) the justice may proceed ex parte to hear and determine the application` FALSE TRUE (JUST TRUE) EQUALS NOTHING   -- element missing: the application is made under subsection (1)
#ASSERT `s 117.05(2) the justice may proceed ex parte to hear and determine the application` TRUE FALSE (JUST TRUE) EQUALS NOTHING   -- element missing: the person from whom the thing or document was seized is absent
#ASSERT `s 117.05(2) the justice may proceed ex parte to hear and determine the application` TRUE TRUE NOTHING EQUALS NOTHING   -- element missing: Part XXVII the circumstances are those in which a summary conviction court may proceed with a trial in the absence of the defendant
#ASSERT `s 117.05(2) the justice may proceed ex parte to hear and determine the application` TRUE TRUE (JUST FALSE) EQUALS NOTHING   -- Part XXVII the circumstances are those in which a summary conviction court may proceed with a trial in the absence of the defendant: the other way it can fail ((JUST FALSE))

-- s 117.05(3) the justice is bound to hear all relevant evidence, including evidence respecting the value of the thing: expected values follow the text (s 117.05(3))
#ASSERT `s 117.05(3) the justice is bound to hear all relevant evidence, including evidence respecting the value of the thing` TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.05(3) the justice is bound to hear all relevant evidence, including evidence respecting the value of the thing` FALSE EQUALS NOTHING   -- element missing: the hearing of an application made under subsection (1) is held

-- s 117.05(4)(a) the justice is bound to order that any thing seized be forfeited to Her Majesty or otherwise disposed of: expected values follow the text (s 117.05(4)(a))
#ASSERT `s 117.05(4)(a) the justice is bound to order that any thing seized be forfeited to Her Majesty or otherwise disposed of` TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.05(4)(a) the justice is bound to order that any thing seized be forfeited to Her Majesty or otherwise disposed of` FALSE EQUALS JUST FALSE   -- element missing: following the hearing of an application made under subsection (1), the justice finds that it is not desirable in the interests of the safety of the person from whom the thing was seized or of any other person that the person should possess any weapon, prohibited device, firearm part, ammunition, prohibited ammunition and explosive substance, or any such thing

-- s 117.05(4)(b) the justice is bound to order that the person's possession be prohibited: expected values follow the text (s 117.05(4)(b))
#ASSERT `s 117.05(4)(b) the justice is bound to order that the person's possession be prohibited` TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.05(4)(b) the justice is bound to order that the person's possession be prohibited` FALSE TRUE EQUALS JUST FALSE   -- element missing: following the hearing of an application made under subsection (1), the justice finds that it is not desirable in the interests of the safety of the person from whom the thing was seized or of any other person that the person should possess any weapon, prohibited device, firearm part, ammunition, prohibited ammunition and explosive substance, or any such thing
#ASSERT `s 117.05(4)(b) the justice is bound to order that the person's possession be prohibited` TRUE FALSE EQUALS JUST FALSE   -- element missing: the justice is satisfied that the circumstances warrant such an action


-- s 117.05(4)(b) the period of the order is not more than five years: a period is compared in calendar months first; days count only when the months already equal sixty (NOTES.md, fork register)
#ASSERT `s 117.05(4)(b) the period of the order is not more than five years` (`Length of time` OF 3, 0, 0, FALSE) EQUALS JUST TRUE
#ASSERT `s 117.05(4)(b) the period of the order is not more than five years` (`Length of time` OF 4, 11, 0, FALSE) EQUALS JUST TRUE   -- one month short of five years
#ASSERT `s 117.05(4)(b) the period of the order is not more than five years` (`Length of time` OF 5, 0, 0, FALSE) EQUALS JUST TRUE   -- exactly five years: "not exceeding"
#ASSERT `s 117.05(4)(b) the period of the order is not more than five years` (`Length of time` OF 5, 0, 0, TRUE) EQUALS JUST TRUE   -- five years less a day
#ASSERT `s 117.05(4)(b) the period of the order is not more than five years` (`Length of time` OF 0, 18, 0, FALSE) EQUALS JUST TRUE   -- eighteen months
#ASSERT `s 117.05(4)(b) the period of the order is not more than five years` (`Length of time` OF 5, 0, 1, FALSE) EQUALS JUST FALSE   -- five years and a day exceeds five years
#ASSERT `s 117.05(4)(b) the period of the order is not more than five years` (`Length of time` OF 5, 1, 0, FALSE) EQUALS JUST FALSE
#ASSERT `s 117.05(4)(b) the period of the order is not more than five years` (`Length of time` OF 6, 0, 0, FALSE) EQUALS JUST FALSE
#ASSERT `s 117.05(4)(b) the order begins on the day on which it is made` (Date 10 3 2026) (Date 10 3 2026) EQUALS JUST TRUE
#ASSERT `s 117.05(4)(b) the order begins on the day on which it is made` (Date 10 3 2026) (Date 11 3 2026) EQUALS JUST FALSE   -- a period that begins another day is not what the text says

-- s 117.05(5) the justice is bound to include a statement of reasons in the record: expected values follow the text (s 117.05(5))
#ASSERT `s 117.05(5) the justice is bound to include a statement of reasons in the record` TRUE FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.05(5) the justice is bound to include a statement of reasons in the record` FALSE FALSE EQUALS JUST FALSE   -- element missing: the justice does not make an order under subsection (4) / the justice makes an order but does not prohibit the possession of all of the things referred to in that subsection
#ASSERT `s 117.05(5) the justice is bound to include a statement of reasons in the record` TRUE FALSE EQUALS JUST TRUE   -- alternative present: the justice does not make an order under subsection (4)
#ASSERT `s 117.05(5) the justice is bound to include a statement of reasons in the record` FALSE TRUE EQUALS JUST TRUE   -- alternative present: the justice makes an order but does not prohibit the possession of all of the things referred to in that subsection


-- s 117.05(6) sections 113 to 117 apply to the order, tested by section number: R1 of PLAN.md, a range of section numbers tested against the core record
#ASSERT `s 117.05(6) sections 113 to 117 apply to the order, tested by section number` TRUE (`Provision of the Code` OF 113, "(1)") EQUALS JUST TRUE
#ASSERT `s 117.05(6) sections 113 to 117 apply to the order, tested by section number` TRUE (`Provision of the Code` OF 117, "") EQUALS JUST TRUE   -- the last section named
#ASSERT `s 117.05(6) sections 113 to 117 apply to the order, tested by section number` TRUE (`Provision of the Code` OF 112, "") EQUALS NOTHING   -- before the range
#ASSERT `s 117.05(6) sections 113 to 117 apply to the order, tested by section number` TRUE (`Provision of the Code` OF 117.01, "(1)") EQUALS NOTHING   -- after the range
#ASSERT `s 117.05(6) sections 113 to 117 apply to the order, tested by section number` FALSE (`Provision of the Code` OF 114, "") EQUALS NOTHING   -- not an order under subsection (4)

-- s 117.05(7) the person may appeal to the superior court against the order: expected values follow the text (s 117.05(7))
#ASSERT `s 117.05(7) the person may appeal to the superior court against the order` TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.05(7) the person may appeal to the superior court against the order` FALSE TRUE EQUALS NOTHING   -- element missing: the appellant is the person in respect of whom the order is made, or from whom the thing was seized
#ASSERT `s 117.05(7) the person may appeal to the superior court against the order` TRUE FALSE EQUALS JUST FALSE   -- exception: the justice makes an order under subsection (4) in respect of a person, or in respect of any thing that was seized from a person

-- s 117.05(8) the Attorney General may appeal to the superior court against the failure to make the finding or the order: expected values follow the text (s 117.05(8))
#ASSERT `s 117.05(8) the Attorney General may appeal to the superior court against the failure to make the finding or the order` TRUE FALSE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.05(8) the Attorney General may appeal to the superior court against the failure to make the finding or the order` FALSE FALSE TRUE EQUALS JUST FALSE   -- element missing: the justice does not make a finding as described in subsection (4) following the hearing of an application under subsection (1) / the justice makes the finding but does not make an order to the effect described in paragraph (4)(b)
#ASSERT `s 117.05(8) the Attorney General may appeal to the superior court against the failure to make the finding or the order` TRUE FALSE TRUE EQUALS JUST TRUE   -- alternative present: the justice does not make a finding as described in subsection (4) following the hearing of an application under subsection (1)
#ASSERT `s 117.05(8) the Attorney General may appeal to the superior court against the failure to make the finding or the order` FALSE TRUE TRUE EQUALS JUST TRUE   -- alternative present: the justice makes the finding but does not make an order to the effect described in paragraph (4)(b)
#ASSERT `s 117.05(8) the Attorney General may appeal to the superior court against the failure to make the finding or the order` TRUE FALSE FALSE EQUALS JUST FALSE   -- element missing: the appellant is the Attorney General


-- s 117.05(9) the provision of Part XXVII applies to the appeal: sections 785-812, 816-819 and 829-838 are excepted; every other provision of Part XXVII applies "with such modifications as the circumstances require"
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 813 TRUE TRUE EQUALS JUST TRUE   -- 813 is not in an excepted range
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 815 TRUE TRUE EQUALS JUST TRUE   -- the last section before the 816-819 range
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 820 TRUE TRUE EQUALS JUST TRUE   -- the first section after the 816-819 range
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 828 TRUE TRUE EQUALS JUST TRUE   -- the last section before the 829-838 range
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 839 TRUE TRUE EQUALS JUST TRUE   -- the first section after the 829-838 range
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 785 TRUE TRUE EQUALS JUST FALSE   -- first section of the first excepted range
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 812 TRUE TRUE EQUALS JUST FALSE   -- last section of the first excepted range
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 816 TRUE TRUE EQUALS JUST FALSE   -- first section of the second excepted range
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 819 TRUE TRUE EQUALS JUST FALSE   -- last section of the second excepted range
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 829 TRUE TRUE EQUALS JUST FALSE   -- first section of the third excepted range
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 838 TRUE TRUE EQUALS JUST FALSE   -- last section of the third excepted range
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 813 FALSE TRUE EQUALS NOTHING   -- not a provision of Part XXVII
#ASSERT `s 117.05(9) the provision of Part XXVII applies to the appeal` 813 TRUE FALSE EQUALS NOTHING   -- not an appeal under the subsections named


-- s 117.06(1)(a) no application was made within thirty days
#ASSERT `s 117.06(1)(a) no application was made within thirty days` (Date 1 3 2026) (Date 1 4 2026) FALSE EQUALS JUST TRUE   -- checked on day 31 with no application
#ASSERT `s 117.06(1)(a) no application was made within thirty days` (Date 1 3 2026) (Date 31 3 2026) FALSE EQUALS NOTHING   -- day 30: the period has not yet run
#ASSERT `s 117.06(1)(a) no application was made within thirty days` (Date 1 3 2026) (Date 1 4 2026) TRUE EQUALS JUST FALSE   -- an application was made in time
#ASSERT `s 117.06(1)(a) no application was made within thirty days` (Date 1 3 2026) (Date 1 5 2026) TRUE EQUALS JUST FALSE

-- s 117.06(1) the thing or document is to be returned to the person from whom it was seized: expected values follow the text (s 117.06(1))
#ASSERT `s 117.06(1) the thing or document is to be returned to the person from whom it was seized` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.06(1) the thing or document is to be returned to the person from whom it was seized` FALSE (JUST TRUE) FALSE EQUALS JUST FALSE   -- element missing: the thing or document was seized pursuant to subsection 117.04(1) or (2)
#ASSERT `s 117.06(1) the thing or document is to be returned to the person from whom it was seized` TRUE NOTHING FALSE EQUALS JUST FALSE   -- element missing: the answer of s 117.06(1)(a) no application was made within thirty days / an application is made under subsection 117.05(1) within the period referred to in paragraph (a), and the justice does not make a finding as described in subsection 117.05(4)
#ASSERT `s 117.06(1) the thing or document is to be returned to the person from whom it was seized` TRUE (JUST TRUE) FALSE EQUALS JUST TRUE   -- alternative present: the answer of s 117.06(1)(a) no application was made within thirty days
#ASSERT `s 117.06(1) the thing or document is to be returned to the person from whom it was seized` TRUE NOTHING TRUE EQUALS JUST TRUE   -- alternative present: an application is made under subsection 117.05(1) within the period referred to in paragraph (a), and the justice does not make a finding as described in subsection 117.05(4)

-- s 117.06(2) the justice may order that the revocation be reversed and the authorization, licence or registration certificate restored: expected values follow the text (s 117.06(2))
#ASSERT `s 117.06(2) the justice may order that the revocation be reversed and the authorization, licence or registration certificate restored` TRUE TRUE TRUE EQUALS JUST TRUE   -- every element of the provision present
#ASSERT `s 117.06(2) the justice may order that the revocation be reversed and the authorization, licence or registration certificate restored` FALSE TRUE TRUE EQUALS JUST FALSE   -- element missing: the thing is returned to the person from whom it was seized pursuant to subsection (1)
#ASSERT `s 117.06(2) the justice may order that the revocation be reversed and the authorization, licence or registration certificate restored` TRUE FALSE TRUE EQUALS JUST FALSE   -- element missing: an authorization, a licence or a registration certificate is revoked pursuant to subsection 117.04(4)
#ASSERT `s 117.06(2) the justice may order that the revocation be reversed and the authorization, licence or registration certificate restored` TRUE TRUE FALSE EQUALS JUST FALSE   -- element missing: the person is the justice referred to in paragraph (1)(b)
