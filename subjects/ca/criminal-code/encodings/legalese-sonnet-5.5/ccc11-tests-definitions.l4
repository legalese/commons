IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc11-definitions`

-- definitions: tests of ccc11-definitions.l4 (Part VIII.1, section 320.11, and the three Kleene helpers)
-- Expected values are written by hand from the text of the provision, beside each assertion, before the run; none is copied from the code's output.
-- JUST TRUE / JUST FALSE / NOTHING: the text says yes / the text says no in its own words / not covered.


§ `the Kleene helpers (not provisions): a "no" or a "not covered" of an operand is carried, never turned into the other`
#ASSERT `s 320.11 helper: both hold` (JUST TRUE) (JUST TRUE) EQUALS (JUST TRUE)   -- both yes
#ASSERT `s 320.11 helper: both hold` (JUST TRUE) (JUST FALSE) EQUALS (JUST FALSE)   -- one no
#ASSERT `s 320.11 helper: both hold` (JUST FALSE) NOTHING EQUALS (JUST FALSE)   -- a no beats a not-covered
#ASSERT `s 320.11 helper: both hold` NOTHING (JUST FALSE) EQUALS (JUST FALSE)   -- a no beats a not-covered (other order)
#ASSERT `s 320.11 helper: both hold` NOTHING (JUST TRUE) EQUALS NOTHING   -- not covered stays not covered
#ASSERT `s 320.11 helper: both hold` (JUST TRUE) NOTHING EQUALS NOTHING   -- not covered stays not covered
#ASSERT `s 320.11 helper: both hold` NOTHING NOTHING EQUALS NOTHING   -- both not covered
#ASSERT `s 320.11 helper: either holds` (JUST FALSE) (JUST FALSE) EQUALS (JUST FALSE)   -- both no
#ASSERT `s 320.11 helper: either holds` (JUST TRUE) NOTHING EQUALS (JUST TRUE)   -- a yes beats a not-covered
#ASSERT `s 320.11 helper: either holds` NOTHING (JUST TRUE) EQUALS (JUST TRUE)   -- a yes beats a not-covered (other order)
#ASSERT `s 320.11 helper: either holds` (JUST FALSE) NOTHING EQUALS NOTHING   -- a no with a not-covered stays not covered
#ASSERT `s 320.11 helper: either holds` NOTHING NOTHING EQUALS NOTHING   -- both not covered
#ASSERT `s 320.11 helper: the opposite of` (JUST TRUE) EQUALS (JUST FALSE)   -- opposite of yes
#ASSERT `s 320.11 helper: the opposite of` (JUST FALSE) EQUALS (JUST TRUE)   -- opposite of no
#ASSERT `s 320.11 helper: the opposite of` NOTHING EQUALS NOTHING   -- not covered stays not covered

§ `analyst: designated by the Attorney General under subparagraph 320.4(b)(ii) or paragraph 320.4(c), by name or as a member of a designated class`
#ASSERT `s 320.11 the person is an analyst` TRUE FALSE FALSE FALSE EQUALS (JUST TRUE)   -- named under (b)(ii)
#ASSERT `s 320.11 the person is an analyst` FALSE TRUE FALSE FALSE EQUALS (JUST TRUE)   -- member of a class designated under (b)(ii)
#ASSERT `s 320.11 the person is an analyst` FALSE FALSE TRUE FALSE EQUALS (JUST TRUE)   -- named under (c)
#ASSERT `s 320.11 the person is an analyst` FALSE FALSE FALSE TRUE EQUALS (JUST TRUE)   -- member of a class designated under (c)
#ASSERT `s 320.11 the person is an analyst` FALSE FALSE FALSE FALSE EQUALS (JUST FALSE)   -- "analyst means": none of the four

§ `the four "approved" definitions: designed for the purpose AND approved by the Attorney General of Canada under the named paragraph of 320.39`
#ASSERT `s 320.11 the container is an approved container` TRUE TRUE EQUALS (JUST TRUE)   -- designed for a blood sample and approved under 320.39(d)
#ASSERT `s 320.11 the container is an approved container` TRUE FALSE EQUALS (JUST FALSE)   -- designed but not approved
#ASSERT `s 320.11 the container is an approved container` FALSE TRUE EQUALS (JUST FALSE)   -- approved but not designed for a blood sample
#ASSERT `s 320.11 the equipment is approved drug screening equipment` TRUE TRUE EQUALS (JUST TRUE)   -- designed to ascertain a drug in the body and approved under 320.39(b)
#ASSERT `s 320.11 the equipment is approved drug screening equipment` TRUE FALSE EQUALS (JUST FALSE)   -- not approved
#ASSERT `s 320.11 the equipment is approved drug screening equipment` FALSE TRUE EQUALS (JUST FALSE)   -- not designed for the purpose
#ASSERT `s 320.11 the instrument is an approved instrument` TRUE TRUE EQUALS (JUST TRUE)   -- designed to analyse breath and approved under 320.39(c)
#ASSERT `s 320.11 the instrument is an approved instrument` TRUE FALSE EQUALS (JUST FALSE)   -- not approved
#ASSERT `s 320.11 the instrument is an approved instrument` FALSE TRUE EQUALS (JUST FALSE)   -- not designed for the purpose
#ASSERT `s 320.11 the device is an approved screening device` TRUE TRUE EQUALS (JUST TRUE)   -- designed to ascertain alcohol in the blood and approved under 320.39(a)
#ASSERT `s 320.11 the device is an approved screening device` TRUE FALSE EQUALS (JUST FALSE)   -- not approved
#ASSERT `s 320.11 the device is an approved screening device` FALSE TRUE EQUALS (JUST FALSE)   -- not designed for the purpose

§ `vessel includes a hovercraft: "includes" leaves the term open, so anything else is not covered, never "not a vessel"`
#ASSERT `s 320.11 the thing is a vessel` TRUE FALSE EQUALS (JUST TRUE)   -- a hovercraft
#ASSERT `s 320.11 the thing is a vessel` FALSE TRUE EQUALS (JUST TRUE)   -- a vessel in the ordinary sense
#ASSERT `s 320.11 the thing is a vessel` TRUE TRUE EQUALS (JUST TRUE)   -- both
#ASSERT `s 320.11 the thing is a vessel` FALSE FALSE EQUALS NOTHING   -- neither: the definition only includes; not covered

§ `conveyance means a motor vehicle, a vessel, an aircraft or railway equipment`
#ASSERT `s 320.11 the thing is a conveyance` (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE) EQUALS (JUST TRUE)   -- a motor vehicle
#ASSERT `s 320.11 the thing is a conveyance` (JUST FALSE) (JUST TRUE) FALSE (JUST FALSE) EQUALS (JUST TRUE)   -- a vessel
#ASSERT `s 320.11 the thing is a conveyance` (JUST FALSE) (JUST FALSE) TRUE (JUST FALSE) EQUALS (JUST TRUE)   -- an aircraft
#ASSERT `s 320.11 the thing is a conveyance` (JUST FALSE) (JUST FALSE) FALSE (JUST TRUE) EQUALS (JUST TRUE)   -- railway equipment
#ASSERT `s 320.11 the thing is a conveyance` (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE) EQUALS (JUST FALSE)   -- "conveyance means": none of the four limbs
#ASSERT `s 320.11 the thing is a conveyance` NOTHING (JUST FALSE) FALSE (JUST FALSE) EQUALS NOTHING   -- whether it is a motor vehicle is not covered and no other limb holds
#ASSERT `s 320.11 the thing is a conveyance` NOTHING (JUST TRUE) FALSE (JUST FALSE) EQUALS (JUST TRUE)   -- a vessel, whatever the motor vehicle answer
#ASSERT `s 320.11 the thing is a conveyance` (JUST FALSE) NOTHING FALSE (JUST FALSE) EQUALS NOTHING   -- whether it is a vessel is not covered (vessel only "includes")

§ `evaluating officer: a peace officer who has the qualifications prescribed by regulation`
#ASSERT `s 320.11 the person is an evaluating officer` (JUST TRUE) TRUE EQUALS (JUST TRUE)   -- a peace officer with the qualifications
#ASSERT `s 320.11 the person is an evaluating officer` (JUST TRUE) FALSE EQUALS (JUST FALSE)   -- a peace officer without the qualifications
#ASSERT `s 320.11 the person is an evaluating officer` (JUST FALSE) TRUE EQUALS (JUST FALSE)   -- qualified but not a peace officer
#ASSERT `s 320.11 the person is an evaluating officer` NOTHING TRUE EQUALS NOTHING   -- the peace officer answer is not covered ("peace officer includes")
#ASSERT `s 320.11 the person is an evaluating officer` NOTHING FALSE EQUALS (JUST FALSE)   -- no qualifications: a no whatever the peace officer answer

§ `operate: (a) motor vehicle: drive it or have care or control; (b) vessel or aircraft: navigate it, assist in its navigation or have care or control; (c) railway equipment: participate in the direct control of its motion or have care or control`
-- arguments: motor vehicle ; vessel ; aircraft ; railway equipment ; drove ; navigated ; assisted in navigation ; participated in direct control ; had care or control
#ASSERT `s 320.11 the person operates the conveyance` (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE) TRUE FALSE FALSE FALSE FALSE EQUALS (JUST TRUE)   -- (a) drove a motor vehicle
#ASSERT `s 320.11 the person operates the conveyance` (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE) FALSE FALSE FALSE FALSE TRUE EQUALS (JUST TRUE)   -- (a) care or control of a motor vehicle
#ASSERT `s 320.11 the person operates the conveyance` (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE) FALSE TRUE FALSE FALSE FALSE EQUALS (JUST FALSE)   -- (a) navigating is not driving a motor vehicle
#ASSERT `s 320.11 the person operates the conveyance` (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE) FALSE FALSE FALSE FALSE FALSE EQUALS (JUST FALSE)   -- (a) did none of the acts
#ASSERT `s 320.11 the person operates the conveyance` (JUST FALSE) (JUST TRUE) FALSE (JUST FALSE) FALSE TRUE FALSE FALSE FALSE EQUALS (JUST TRUE)   -- (b) navigated a vessel
#ASSERT `s 320.11 the person operates the conveyance` (JUST FALSE) (JUST TRUE) FALSE (JUST FALSE) FALSE FALSE TRUE FALSE FALSE EQUALS (JUST TRUE)   -- (b) assisted in the navigation of a vessel
#ASSERT `s 320.11 the person operates the conveyance` (JUST FALSE) (JUST TRUE) FALSE (JUST FALSE) FALSE FALSE FALSE FALSE TRUE EQUALS (JUST TRUE)   -- (b) care or control of a vessel
#ASSERT `s 320.11 the person operates the conveyance` (JUST FALSE) (JUST TRUE) FALSE (JUST FALSE) TRUE FALSE FALSE FALSE FALSE EQUALS (JUST FALSE)   -- (b) drove: not an act of limb (b)
#ASSERT `s 320.11 the person operates the conveyance` (JUST FALSE) (JUST FALSE) TRUE (JUST FALSE) FALSE TRUE FALSE FALSE FALSE EQUALS (JUST TRUE)   -- (b) navigated an aircraft
#ASSERT `s 320.11 the person operates the conveyance` (JUST FALSE) (JUST FALSE) TRUE (JUST FALSE) FALSE FALSE FALSE FALSE FALSE EQUALS (JUST FALSE)   -- (b) aircraft, no act
#ASSERT `s 320.11 the person operates the conveyance` (JUST FALSE) (JUST FALSE) FALSE (JUST TRUE) FALSE FALSE FALSE TRUE FALSE EQUALS (JUST TRUE)   -- (c) participated in the direct control of the motion of railway equipment
#ASSERT `s 320.11 the person operates the conveyance` (JUST FALSE) (JUST FALSE) FALSE (JUST TRUE) FALSE FALSE FALSE FALSE TRUE EQUALS (JUST TRUE)   -- (c) care or control of railway equipment
#ASSERT `s 320.11 the person operates the conveyance` (JUST FALSE) (JUST FALSE) FALSE (JUST TRUE) TRUE TRUE TRUE FALSE FALSE EQUALS (JUST FALSE)   -- (c) driving, navigating, assisting: not acts of limb (c)
#ASSERT `s 320.11 the person operates the conveyance` (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE) TRUE TRUE TRUE TRUE TRUE EQUALS (JUST FALSE)   -- not a conveyance of any kind: "operate means" gives no limb
#ASSERT `s 320.11 the person operates the conveyance` (JUST TRUE) (JUST TRUE) FALSE (JUST FALSE) TRUE FALSE FALSE FALSE FALSE EQUALS (JUST TRUE)   -- an amphibious thing that is both a motor vehicle and a vessel: limb (a) is met
#ASSERT `s 320.11 the person operates the conveyance` NOTHING (JUST FALSE) FALSE (JUST FALSE) TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- whether it is a motor vehicle is not covered
#ASSERT `s 320.11 the person operates the conveyance` NOTHING (JUST TRUE) FALSE (JUST FALSE) FALSE TRUE FALSE FALSE FALSE EQUALS (JUST TRUE)   -- a vessel navigated: limb (b) holds whatever the motor vehicle answer

§ `qualified medical practitioner and qualified technician`
#ASSERT `s 320.11 the person is a qualified medical practitioner` TRUE EQUALS (JUST TRUE)   -- qualified under provincial law to practise medicine
#ASSERT `s 320.11 the person is a qualified medical practitioner` FALSE EQUALS (JUST FALSE)   -- "qualified medical practitioner means"
#ASSERT `s 320.11 the person is a qualified technician in respect of breath samples` TRUE EQUALS (JUST TRUE)   -- (a) designated by the Attorney General under 320.4(a)
#ASSERT `s 320.11 the person is a qualified technician in respect of breath samples` FALSE EQUALS (JUST FALSE)   -- (a) not designated
#ASSERT `s 320.11 the person is a qualified technician in respect of blood samples` TRUE FALSE EQUALS (JUST TRUE)   -- (b) designated by name under 320.4(b)(i)
#ASSERT `s 320.11 the person is a qualified technician in respect of blood samples` FALSE TRUE EQUALS (JUST TRUE)   -- (b) a member of a class designated under 320.4(b)(i)
#ASSERT `s 320.11 the person is a qualified technician in respect of blood samples` FALSE FALSE EQUALS (JUST FALSE)   -- (b) neither

