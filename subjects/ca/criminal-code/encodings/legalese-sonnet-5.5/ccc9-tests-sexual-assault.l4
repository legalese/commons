#ASSERT `s 272(2)(a.1) any other case where a firearm is used` `s 272(2) test: other firearm, no organization, adult` EQUALS JUST TRUE
#ASSERT `s 272(2)(a.1) any other case where a firearm is used` `s 272(2) test: restricted firearm, first offence, adult` EQUALS JUST FALSE
#ASSERT `s 272(2)(a.1) any other case where a firearm is used` `s 272(2) test: no firearm, complainant 15` EQUALS JUST FALSE
#ASSERT `s 272(2)(a.1) any other case where a firearm is used` `s 272(2) test: firearm status not covered` EQUALS NOTHING
