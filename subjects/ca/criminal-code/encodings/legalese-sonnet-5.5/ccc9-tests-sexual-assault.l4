#ASSERT NOT (`s 272(2)(a.2) the complainant is under the age of 16 years` `s 272(2) test: no firearm, complainant 16`)
#ASSERT `s 272(2)(b) any other case` `s 272(2) test: no firearm, complainant 16` EQUALS JUST TRUE
#ASSERT `s 272(2)(b) any other case` `s 272(2) test: no firearm, complainant 15` EQUALS JUST FALSE
#ASSERT `s 272(2)(b) any other case` `s 272(2) test: other firearm, no organization, adult` EQUALS JUST FALSE
#ASSERT `s 272(2)(b) any other case` `s 272(2) test: restricted firearm, first offence, adult` EQUALS JUST FALSE
#ASSERT `s 272(2)(b) any other case` `s 272(2) test: firearm status not covered` EQUALS NOTHING
-- the limbs that apply
#ASSERT `s 272(2) the limbs that apply` `s 272(2) test: restricted firearm, first offence, adult` EQUALS JUST (LIST `s 272(2)(a) a restricted or prohibited firearm, or a firearm for a criminal organization: first offence`)
#ASSERT `s 272(2) the limbs that apply` `s 272(2) test: prohibited firearm, subsequent offence, adult` EQUALS JUST (LIST `s 272(2)(a) a restricted or prohibited firearm, or a firearm for a criminal organization: second or subsequent offence`)
#ASSERT `s 272(2) the limbs that apply` `s 272(2) test: other firearm for a criminal organization, first offence` EQUALS JUST (LIST `s 272(2)(a) a restricted or prohibited firearm, or a firearm for a criminal organization: first offence`)
#ASSERT `s 272(2) the limbs that apply` `s 272(2) test: other firearm, no organization, adult` EQUALS JUST (LIST `s 272(2)(a.1) any other case where a firearm is used`)
#ASSERT `s 272(2) the limbs that apply` `s 272(2) test: no firearm, complainant 15` EQUALS JUST (LIST `s 272(2)(a.2) the complainant is under the age of 16 years`)
#ASSERT `s 272(2) the limbs that apply` `s 272(2) test: no firearm, complainant 16` EQUALS JUST (LIST `s 272(2)(b) any other case`)
#ASSERT `s 272(2) the limbs that apply` `s 272(2) test: restricted firearm, complainant 15` EQUALS JUST (LIST `s 272(2)(a) a restricted or prohibited firearm, or a firearm for a criminal organization: first offence`, `s 272(2)(a.2) the complainant is under the age of 16 years`)
#ASSERT `s 272(2) the limbs that apply` `s 272(2) test: other firearm, complainant 10` EQUALS JUST (LIST `s 272(2)(a.1) any other case where a firearm is used`, `s 272(2)(a.2) the complainant is under the age of 16 years`)
#ASSERT `s 272(2) the limbs that apply` `s 272(2) test: firearm status not covered` EQUALS NOTHING
#ASSERT `s 272(2) the limbs that apply` `s 272(2) test: restricted status not covered` EQUALS NOTHING
#ASSERT `s 272(2) the limbs that apply` `s 272(2) test: restricted firearm, subsequent not covered` EQUALS NOTHING
-- subsequent-offence answer not needed where limb (a) does not apply
#ASSERT `s 272(2) the limbs that apply` `s 272(2) test: other firearm, subsequent not covered` EQUALS JUST (LIST `s 272(2)(a.1) any other case where a firearm is used`)
-- the punishment under each limb, as the text writes it (lines 5076-5081)
#ASSERT `s 272(2) the punishment under the limb` `s 272(2)(a) a restricted or prohibited firearm, or a firearm for a criminal organization: first offence` EQUALS Punishment OF `by indictment`, (`imprisonment for a term of` `fourteen years`), (`imprisonment for a term of` `five years`), `no fine is stated`, `no fine is stated`
#ASSERT `s 272(2) the punishment under the limb` `s 272(2)(a) a restricted or prohibited firearm, or a firearm for a criminal organization: second or subsequent offence` EQUALS Punishment OF `by indictment`, (`imprisonment for a term of` `fourteen years`), (`imprisonment for a term of` (`Length of time` OF 7, 0, 0, FALSE)), `no fine is stated`, `no fine is stated`
#ASSERT `s 272(2) the punishment under the limb` `s 272(2)(a.1) any other case where a firearm is used` EQUALS Punishment OF `by indictment`, (`imprisonment for a term of` `fourteen years`), (`imprisonment for a term of` (`Length of time` OF 4, 0, 0, FALSE)), `no fine is stated`, `no fine is stated`
#ASSERT `s 272(2) the punishment under the limb` `s 272(2)(a.2) the complainant is under the age of 16 years` EQUALS Punishment OF `by indictment`, `imprisonment for life`, (`imprisonment for a term of` `five years`), `no fine is stated`, `no fine is stated`
#ASSERT `s 272(2) the punishment under the limb` `s 272(2)(b) any other case` EQUALS Punishment OF `by indictment`, (`imprisonment for a term of` `fourteen years`), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
-- the one punishment where exactly one limb applies; NOTHING where two overlap (fork F1) or an answer is not covered
#ASSERT `s 272(2) the punishment` `s 272(2) test: restricted firearm, first offence, adult` EQUALS JUST (Punishment OF `by indictment`, (`imprisonment for a term of` `fourteen years`), (`imprisonment for a term of` `five years`), `no fine is stated`, `no fine is stated`)
#ASSERT `s 272(2) the punishment` `s 272(2) test: prohibited firearm, subsequent offence, adult` EQUALS JUST (Punishment OF `by indictment`, (`imprisonment for a term of` `fourteen years`), (`imprisonment for a term of` (`Length of time` OF 7, 0, 0, FALSE)), `no fine is stated`, `no fine is stated`)
#ASSERT `s 272(2) the punishment` `s 272(2) test: other firearm, no organization, adult` EQUALS JUST (Punishment OF `by indictment`, (`imprisonment for a term of` `fourteen years`), (`imprisonment for a term of` (`Length of time` OF 4, 0, 0, FALSE)), `no fine is stated`, `no fine is stated`)
#ASSERT `s 272(2) the punishment` `s 272(2) test: no firearm, complainant 15` EQUALS JUST (Punishment OF `by indictment`, `imprisonment for life`, (`imprisonment for a term of` `five years`), `no fine is stated`, `no fine is stated`)
#ASSERT `s 272(2) the punishment` `s 272(2) test: no firearm, complainant 16` EQUALS JUST (Punishment OF `by indictment`, (`imprisonment for a term of` `fourteen years`), `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 272(2) the punishment` `s 272(2) test: restricted firearm, complainant 15` EQUALS NOTHING
#ASSERT `s 272(2) the punishment` `s 272(2) test: other firearm, complainant 10` EQUALS NOTHING
#ASSERT `s 272(2) the punishment` `s 272(2) test: firearm status not covered` EQUALS NOTHING
#ASSERT `s 272(2) the class of the offence` EQUALS `an indictable offence`

§ `s 273: aggravated sexual assault (lines 5090-5107)`

-- Field order of `s 273(1) facts`: sexual assault, wounds, maims, disfigures, endangers the life
`s 273(1) test: wounds` MEANS `s 273(1) facts` OF (JUST TRUE), TRUE, FALSE, FALSE, FALSE
`s 273(1) test: endangers the life` MEANS `s 273(1) facts` OF (JUST TRUE), FALSE, FALSE, FALSE, TRUE
`s 273(1) test: none of the four` MEANS `s 273(1) facts` OF (JUST TRUE), FALSE, FALSE, FALSE, FALSE
`s 273(1) test: no sexual assault` MEANS `s 273(1) facts` OF (JUST FALSE), TRUE, TRUE, TRUE, TRUE
`s 273(1) test: sexual assault not defined` MEANS `s 273(1) facts` OF NOTHING, TRUE, FALSE, FALSE, FALSE
#ASSERT `s 273(1) the accused, in committing a sexual assault, wounds, maims, disfigures or endangers the life of the complainant` `s 273(1) test: wounds` EQUALS JUST TRUE
#ASSERT `s 273(1) the accused, in committing a sexual assault, wounds, maims, disfigures or endangers the life of the complainant` `s 273(1) test: endangers the life` EQUALS JUST TRUE
#ASSERT `s 273(1) the accused, in committing a sexual assault, wounds, maims, disfigures or endangers the life of the complainant` `s 273(1) test: none of the four` EQUALS JUST FALSE
#ASSERT `s 273(1) the accused, in committing a sexual assault, wounds, maims, disfigures or endangers the life of the complainant` `s 273(1) test: no sexual assault` EQUALS JUST FALSE
#ASSERT `s 273(1) the accused, in committing a sexual assault, wounds, maims, disfigures or endangers the life of the complainant` `s 273(1) test: sexual assault not defined` EQUALS NOTHING
#ASSERT `s 273(2) the class of the offence` EQUALS `an indictable offence`
-- punishments under the limbs: life in every limb, with the minimums of (a)(i) five, (a)(ii) seven, (a.1) four, (a.2) five, and none in (b) (lines 5094-5099)
#ASSERT `s 273(2) the punishment under the limb` `s 272(2)(a) a restricted or prohibited firearm, or a firearm for a criminal organization: first offence` EQUALS Punishment OF `by indictment`, `imprisonment for life`, (`imprisonment for a term of` `five years`), `no fine is stated`, `no fine is stated`
#ASSERT `s 273(2) the punishment under the limb` `s 272(2)(a) a restricted or prohibited firearm, or a firearm for a criminal organization: second or subsequent offence` EQUALS Punishment OF `by indictment`, `imprisonment for life`, (`imprisonment for a term of` (`Length of time` OF 7, 0, 0, FALSE)), `no fine is stated`, `no fine is stated`
#ASSERT `s 273(2) the punishment under the limb` `s 272(2)(a.1) any other case where a firearm is used` EQUALS Punishment OF `by indictment`, `imprisonment for life`, (`imprisonment for a term of` (`Length of time` OF 4, 0, 0, FALSE)), `no fine is stated`, `no fine is stated`
#ASSERT `s 273(2) the punishment under the limb` `s 272(2)(a.2) the complainant is under the age of 16 years` EQUALS Punishment OF `by indictment`, `imprisonment for life`, (`imprisonment for a term of` `five years`), `no fine is stated`, `no fine is stated`
#ASSERT `s 273(2) the punishment under the limb` `s 272(2)(b) any other case` EQUALS Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`
#ASSERT `s 273(2) the punishment` `s 272(2) test: restricted firearm, first offence, adult` EQUALS JUST (Punishment OF `by indictment`, `imprisonment for life`, (`imprisonment for a term of` `five years`), `no fine is stated`, `no fine is stated`)
#ASSERT `s 273(2) the punishment` `s 272(2) test: no firearm, complainant 16` EQUALS JUST (Punishment OF `by indictment`, `imprisonment for life`, `no imprisonment is stated`, `no fine is stated`, `no fine is stated`)
#ASSERT `s 273(2) the punishment` `s 272(2) test: other firearm, complainant 10` EQUALS NOTHING
#ASSERT `s 273(2) the punishment` `s 272(2) test: firearm status not covered` EQUALS NOTHING

