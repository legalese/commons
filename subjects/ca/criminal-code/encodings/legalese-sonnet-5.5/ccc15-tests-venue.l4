#ASSERT `s 479 the accused shall be returned to custody` (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 479 the accused shall be returned to custody` (JUST TRUE) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 479 the accused shall be returned to custody` (JUST TRUE) FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 479 the accused shall be returned to custody` NOTHING FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 479 the accused shall be returned to custody` (JUST FALSE) FALSE FALSE TRUE EQUALS NOTHING
