#ASSERT `s 479 the accused shall be dealt with according to law` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 479 the accused shall be dealt with according to law` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
