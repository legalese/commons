IMPORT prelude
IMPORT `ccc-core`
IMPORT `ccc13-index`
IMPORT `ccc13-tests-support`

-- ccc13-tests-index.l4 -- tests of ccc13-index.l4. Expected values are decided from the text (penalty lines 7154-7874 of the plain text), not from the code.

`ccc13 test the hybrid class` MEANS `an offence that the section makes both indictable and punishable on summary conviction`

GIVEN section IS A NUMBER
      subsection IS A STRING
GIVETH A LIST OF Punishment
`ccc13 test punishments at` MEANS
    `ccc13 test the limbs of the answer` (`s 380 to 447.1 the punishments the offence at the provision is liable to` (`ccc13 test the provision` section subsection) `ccc13 test p787`)

§ `the maximum term by indictment, by provision`
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 381 "") EQUALS `imprisonment for a term of` `two years`      -- s 381(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 382 "") EQUALS `imprisonment for a term of` `ten years`      -- s 382
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 382.1 "(2)") EQUALS `imprisonment for a term of` `five years`      -- s 382.1(2)(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 383 "(1)") EQUALS `imprisonment for a term of` `five years`      -- s 383(1)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 387 "") EQUALS `imprisonment for a term of` `two years`      -- s 387(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 391 "(3)") EQUALS `imprisonment for a term of` `fourteen years`      -- s 391(3)(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 394 "(5)") EQUALS `imprisonment for a term of` `five years`      -- s 394(5)(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 396 "(1)") EQUALS `imprisonment for a term of` `ten years`      -- s 396(1)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 397 "(1)") EQUALS `imprisonment for a term of` `five years`      -- s 397(1)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 403 "(3)") EQUALS `imprisonment for a term of` `ten years`      -- s 403(3)(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 405 "") EQUALS `imprisonment for a term of` `five years`      -- s 405(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 407 "") EQUALS `imprisonment for a term of` `two years`      -- s 412(1)(a), which s 412(1) makes the penalty for s 407
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 411 "") EQUALS `imprisonment for a term of` `two years`      -- s 412(1)(a), which s 412(1) makes the penalty for s 411
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 417 "(2)") EQUALS `imprisonment for a term of` `two years`      -- s 417(2)(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 418 "(2)") EQUALS `imprisonment for a term of` `fourteen years`      -- s 418(2)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 420 "(1)") EQUALS `imprisonment for a term of` `five years`      -- s 420(1)(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 423 "(1)") EQUALS `imprisonment for a term of` `five years`      -- s 423(1)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 423.1 "(3)") EQUALS `imprisonment for a term of` `fourteen years`      -- s 423.1(3)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 424 "") EQUALS `imprisonment for a term of` `five years`      -- s 424(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 424.1 "") EQUALS `imprisonment for a term of` `ten years`      -- s 424.1(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 426 "(3)") EQUALS `imprisonment for a term of` `five years`      -- s 426(3)(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 430 "(3)") EQUALS `imprisonment for a term of` `ten years`      -- s 430(3)(a)
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 433 "") EQUALS `imprisonment for life`      -- s 433
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 434 "") EQUALS `imprisonment for a term of` `fourteen years`      -- s 434
#ASSERT `ccc13 test the maximum imprisonment by indictment` (`ccc13 test punishments at` 445 "(2)") EQUALS `imprisonment for a term of` `five years`      -- s 445(2)(a)

§ `the provision with no penalty of its own in this range, and the provision whose penalty turns on a fact`
#ASSERT `s 380 to 447.1 the punishments the offence at the provision is liable to` (`ccc13 test the provision` 380 "(1)") `ccc13 test p787` EQUALS NOTHING         -- s 380(1) turns on the value of the subject-matter
#ASSERT `s 380 to 447.1 the punishments the offence at the provision is liable to` (`ccc13 test the provision` 430 "(4.11)") `ccc13 test p787` EQUALS NOTHING     -- s 430(4.11) turns on the number of the offence
#ASSERT `s 380 to 447.1 the punishments the offence at the provision is liable to` (`ccc13 test the provision` 445.01 "(2)") `ccc13 test p787` EQUALS NOTHING     -- s 445.01(2) turns on whether a law enforcement animal was killed
#ASSERT `s 380 to 447.1 the punishments the offence at the provision is liable to` (`ccc13 test the provision` 380 "(1.1)") `ccc13 test p787` EQUALS NOTHING     -- a subsection that creates no offence
#ASSERT `s 380 to 447.1 the punishments the offence at the provision is liable to` (`ccc13 test the provision` 334 "") `ccc13 test p787` EQUALS NOTHING            -- another part's provision
#ASSERT `s 380 to 447.1 the punishments the offence at the provision is liable to` (`ccc13 test the provision` 448 "") `ccc13 test p787` EQUALS NOTHING

§ `the summary limb is the section 787(1) input where the text states no penalty`
#ASSERT `ccc13 test the number of limbs` (`ccc13 test punishments at` 381 "") EQUALS 2
#ASSERT `ccc13 test the summary limb is the s 787(1) stand-in` (`ccc13 test punishments at` 381 "") EQUALS TRUE
#ASSERT `ccc13 test the number of limbs` (`ccc13 test punishments at` 393 "(3)") EQUALS 1      -- s 393(3): summary conviction only
#ASSERT `ccc13 test the summary limb is the s 787(1) stand-in` (`ccc13 test punishments at` 393 "(3)") EQUALS TRUE
#ASSERT `ccc13 test the number of limbs` (`ccc13 test punishments at` 398 "") EQUALS 1        -- s 398: summary conviction only
#ASSERT `ccc13 test the number of limbs` (`ccc13 test punishments at` 419 "") EQUALS 1        -- s 419: summary conviction only
#ASSERT `ccc13 test the number of limbs` (`ccc13 test punishments at` 418 "(2)") EQUALS 1     -- s 418(2): indictable only
#ASSERT `ccc13 test the number of limbs` (`ccc13 test punishments at` 430 "(2)") EQUALS 1     -- s 430(2): indictable only

§ `the class of the offence`
#ASSERT `s 380 to 447.1 the class of the offence at the provision` (`ccc13 test the provision` 381 "") EQUALS JUST `ccc13 test the hybrid class`
#ASSERT `s 380 to 447.1 the class of the offence at the provision` (`ccc13 test the provision` 407 "") EQUALS JUST `ccc13 test the hybrid class`         -- by s 412(1)
#ASSERT `s 380 to 447.1 the class of the offence at the provision` (`ccc13 test the provision` 418 "(2)") EQUALS JUST `an indictable offence`
#ASSERT `s 380 to 447.1 the class of the offence at the provision` (`ccc13 test the provision` 423.1 "(3)") EQUALS JUST `an indictable offence`
#ASSERT `s 380 to 447.1 the class of the offence at the provision` (`ccc13 test the provision` 430 "(2)") EQUALS JUST `an indictable offence`
#ASSERT `s 380 to 447.1 the class of the offence at the provision` (`ccc13 test the provision` 393 "(3)") EQUALS JUST `an offence punishable on summary conviction`
#ASSERT `s 380 to 447.1 the class of the offence at the provision` (`ccc13 test the provision` 398 "") EQUALS JUST `an offence punishable on summary conviction`
#ASSERT `s 380 to 447.1 the class of the offence at the provision` (`ccc13 test the provision` 419 "") EQUALS JUST `an offence punishable on summary conviction`
#ASSERT `s 380 to 447.1 the class of the offence at the provision` (`ccc13 test the provision` 445.2 "(5)") EQUALS JUST `an offence punishable on summary conviction`
#ASSERT `s 380 to 447.1 the class of the offence at the provision` (`ccc13 test the provision` 380 "(1)") EQUALS NOTHING
#ASSERT `s 380 to 447.1 the class of the offence at the provision` (`ccc13 test the provision` 334 "") EQUALS NOTHING
