IMPORT prelude
IMPORT daydate
IMPORT `ccc-core`
IMPORT `ccc31-forms-statements`

-- ccc31-tests-statements.l4 -- tests for ccc31-forms-statements.l4 (Forms 34.1, 34.2, 34.3 and 48.2).
-- Every expected value is written by hand from the text of the Form (line numbers are those of R.S.C.-1985-c.-C-46.txt), before the run.

§ `Form 34.1 (Subsection 737.1(4)) -- Statement on Restitution`

-- Addressed to the court that is sentencing an offender who was convicted, or was discharged under section 730 (line 18656).
#ASSERT `form 34.1 the statement is addressed to a court sentencing an offender convicted or discharged under section 730` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `form 34.1 the statement is addressed to a court sentencing an offender convicted or discharged under section 730` TRUE FALSE TRUE EQUALS JUST TRUE
-- Not sentencing, or the offender neither convicted nor discharged under section 730: not covered.
#ASSERT `form 34.1 the statement is addressed to a court sentencing an offender convicted or discharged under section 730` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `form 34.1 the statement is addressed to a court sentencing an offender convicted or discharged under section 730` TRUE FALSE FALSE EQUALS NOTHING
-- Line 18667: the losses and damages "must be readily ascertainable by the court".
#ASSERT `form 34.1 the loss may be claimed as restitution` TRUE EQUALS JUST TRUE
#ASSERT `form 34.1 the loss may be claimed as restitution` FALSE EQUALS JUST FALSE
-- Line 18667: "I am responsible for providing the court with all necessary documents ... in support of my claim for restitution".
#ASSERT `form 34.1 the declarant is responsible for providing the documents` TRUE TRUE EQUALS JUST TRUE
#ASSERT `form 34.1 the declarant is responsible for providing the documents` TRUE FALSE EQUALS NOTHING
#ASSERT `form 34.1 the declarant is responsible for providing the documents` FALSE TRUE EQUALS NOTHING

§ `Form 34.2 (Subsection 722(4)) -- Victim Impact Statement (lines 18673-18705)`

-- The five examples the Form gives (emotional, physical, economic, fears for security, a drawing, poem or letter): may be included, approval or no.
#ASSERT `form 34.2 the statement may include the item` `form 34.2 emotional impact` FALSE EQUALS JUST TRUE
#ASSERT `form 34.2 the statement may include the item` `form 34.2 physical impact` FALSE EQUALS JUST TRUE
#ASSERT `form 34.2 the statement may include the item` `form 34.2 economic impact` TRUE EQUALS JUST TRUE
#ASSERT `form 34.2 the statement may include the item` `form 34.2 fears for security` FALSE EQUALS JUST TRUE
#ASSERT `form 34.2 the statement may include the item` `form 34.2 a drawing, poem or letter` FALSE EQUALS JUST TRUE
-- "Your statement must not include": the first four prohibitions, with or without the court's approval (the approval reaches only the fifth).
#ASSERT `form 34.2 the statement may include the item` `form 34.2 a statement about the offence or the offender that is not relevant to the harm or loss` FALSE EQUALS JUST FALSE
#ASSERT `form 34.2 the statement may include the item` `form 34.2 a statement about the offence or the offender that is not relevant to the harm or loss` TRUE EQUALS JUST FALSE
#ASSERT `form 34.2 the statement may include the item` `form 34.2 an unproven allegation` FALSE EQUALS JUST FALSE
#ASSERT `form 34.2 the statement may include the item` `form 34.2 an unproven allegation` TRUE EQUALS JUST FALSE
#ASSERT `form 34.2 the statement may include the item` `form 34.2 a comment about an offence for which the offender was not convicted` FALSE EQUALS JUST FALSE
#ASSERT `form 34.2 the statement may include the item` `form 34.2 a complaint about an individual, other than the offender, involved in the investigation or prosecution` FALSE EQUALS JUST FALSE
-- The fifth: "except with the court's approval, an opinion or recommendation about the sentence". Without approval: no. With approval (fork F8): not covered.
#ASSERT `form 34.2 the statement may include the item` `form 34.2 an opinion or recommendation about the sentence` FALSE EQUALS JUST FALSE
#ASSERT `form 34.2 the statement may include the item` `form 34.2 an opinion or recommendation about the sentence` TRUE EQUALS NOTHING
-- Content the Form does not name: the examples are not a closed list.
#ASSERT `form 34.2 the statement may include the item` `form 34.2 any other content` FALSE EQUALS NOTHING
-- "Please note that this is not an application for compensation or restitution." and "You are not required to include all of this information."
#ASSERT `form 34.2 this is an application for compensation or restitution` EQUALS JUST FALSE
#ASSERT `form 34.2 the declarant is required to include all the examples` EQUALS JUST FALSE

§ `Form 34.3 (Subsection 722.2(2)) -- Community Impact Statement (lines 18717-18746)`

#ASSERT `form 34.3 the statement may include the item` `form 34.3 emotional impact on community members` FALSE EQUALS JUST TRUE
#ASSERT `form 34.3 the statement may include the item` `form 34.3 physical impact on community members` FALSE EQUALS JUST TRUE
#ASSERT `form 34.3 the statement may include the item` `form 34.3 economic impact on the community` FALSE EQUALS JUST TRUE
#ASSERT `form 34.3 the statement may include the item` `form 34.3 fears of community members for their security` FALSE EQUALS JUST TRUE
#ASSERT `form 34.3 the statement may include the item` `form 34.3 a drawing, poem or letter` TRUE EQUALS JUST TRUE
#ASSERT `form 34.3 the statement may include the item` `form 34.3 a statement about the offence or the offender that is not relevant to the harm or loss suffered by the community` FALSE EQUALS JUST FALSE
#ASSERT `form 34.3 the statement may include the item` `form 34.3 an unproven allegation` TRUE EQUALS JUST FALSE
#ASSERT `form 34.3 the statement may include the item` `form 34.3 a comment about an offence for which the offender was not convicted` FALSE EQUALS JUST FALSE
#ASSERT `form 34.3 the statement may include the item` `form 34.3 a complaint about an individual, other than the offender, involved in the investigation or prosecution` FALSE EQUALS JUST FALSE
#ASSERT `form 34.3 the statement may include the item` `form 34.3 an opinion or recommendation about the sentence` FALSE EQUALS JUST FALSE
#ASSERT `form 34.3 the statement may include the item` `form 34.3 an opinion or recommendation about the sentence` TRUE EQUALS NOTHING
#ASSERT `form 34.3 the statement may include the item` `form 34.3 any other content` FALSE EQUALS NOTHING
#ASSERT `form 34.3 this is an application for compensation or restitution` EQUALS JUST FALSE
#ASSERT `form 34.3 the declarant is required to include all the examples` EQUALS JUST FALSE

§ `Form 48.2 (Subsection 672.5(14)) -- Victim Impact Statement -- Not Criminally Responsible (lines 18909-18941)`

#ASSERT `form 48.2 the statement may include the item` `form 48.2 emotional impact` FALSE EQUALS JUST TRUE
#ASSERT `form 48.2 the statement may include the item` `form 48.2 physical impact` FALSE EQUALS JUST TRUE
#ASSERT `form 48.2 the statement may include the item` `form 48.2 economic impact` FALSE EQUALS JUST TRUE
#ASSERT `form 48.2 the statement may include the item` `form 48.2 fears for security` FALSE EQUALS JUST TRUE
#ASSERT `form 48.2 the statement may include the item` `form 48.2 a drawing, poem or letter` FALSE EQUALS JUST TRUE
#ASSERT `form 48.2 the statement may include the item` `form 48.2 a statement about the conduct of the accused that is not relevant to the harm or loss` FALSE EQUALS JUST FALSE
#ASSERT `form 48.2 the statement may include the item` `form 48.2 an unproven allegation` TRUE EQUALS JUST FALSE
#ASSERT `form 48.2 the statement may include the item` `form 48.2 a comment about conduct for which the accused was not found not criminally responsible` FALSE EQUALS JUST FALSE
#ASSERT `form 48.2 the statement may include the item` `form 48.2 a complaint about an individual, other than the accused, involved in the investigation or prosecution` FALSE EQUALS JUST FALSE
-- Line 18914: "except with the court's or Review Board's approval, an opinion or recommendation about the disposition".
#ASSERT `form 48.2 the statement may include the item` `form 48.2 an opinion or recommendation about the disposition` FALSE EQUALS JUST FALSE
#ASSERT `form 48.2 the statement may include the item` `form 48.2 an opinion or recommendation about the disposition` TRUE EQUALS NOTHING
#ASSERT `form 48.2 the statement may include the item` `form 48.2 any other content` FALSE EQUALS NOTHING
#ASSERT `form 48.2 this is an application for compensation or restitution` EQUALS JUST FALSE
#ASSERT `form 48.2 the declarant is required to include all the examples` EQUALS JUST FALSE
