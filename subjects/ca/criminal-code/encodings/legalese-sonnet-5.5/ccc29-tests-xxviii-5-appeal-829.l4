#ASSERT `s 839(1.1) an appeal to the Court of Appeal of Nunavut may be taken against the decision` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 839(1.1) an appeal to the Court of Appeal of Nunavut may be taken against the decision` TRUE TRUE FALSE EQUALS NOTHING
