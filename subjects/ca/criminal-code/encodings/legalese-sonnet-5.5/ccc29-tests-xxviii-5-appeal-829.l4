#ASSERT `s 839(3) the court of appeal may make the order with respect to costs` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 839(3) the court of appeal may make the order with respect to costs` TRUE FALSE EQUALS NOTHING
#ASSERT `s 839(4) the decision may be enforced in the same manner as if it had been made by the summary conviction court` TRUE EQUALS JUST TRUE
#ASSERT `s 839(4) the decision may be enforced in the same manner as if it had been made by the summary conviction court` FALSE EQUALS NOTHING
