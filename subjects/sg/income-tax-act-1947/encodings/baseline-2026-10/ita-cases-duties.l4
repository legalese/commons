IMPORT prelude
IMPORT `ita-duties`

-- Income Tax Act 1947, ss 62(4), (5), 76, 79, 85, 86, 87, 94A, 95, 96, 96A -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_income-tax-act-1947_baseline.py). Expected results were written by
-- hand from the text.

§ `s 62(4), (5) -- telling the Comptroller I am chargeable`

#ASSERT `By when must I tell the Comptroller I am chargeable` TRUE TRUE FALSE EQUALS `no notice is needed`
#ASSERT `By when must I tell the Comptroller I am chargeable` TRUE FALSE FALSE EQUALS `by 14 April of the year of assessment`
#ASSERT `By when must I tell the Comptroller I am chargeable` TRUE FALSE TRUE EQUALS `within one month of my arrival in Singapore`

§ `s 76 -- objecting`

#ASSERT `Is my objection in time and in form` 30 NOTHING TRUE FALSE
#ASSERT NOT `Is my objection in time and in form` 31 NOTHING TRUE FALSE
#ASSERT `Is my objection in time and in form` 31 NOTHING TRUE TRUE

§ `s 79 -- appealing`

#ASSERT `Can my appeal to the Board go ahead` 30 (JUST 30) FALSE
#ASSERT NOT `Can my appeal to the Board go ahead` 31 (JUST 10) FALSE
#ASSERT NOT `Can my appeal to the Board go ahead` 10 NOTHING FALSE

§ `ss 85, 86 -- paying, and leaving Singapore`

#ASSERT NOT `Does my objection or appeal put off when I must pay` TRUE

#ASSERT `Can I be prevented from leaving Singapore` TRUE TRUE FALSE
#ASSERT NOT `Can I be prevented from leaving Singapore` TRUE TRUE TRUE

§ `s 87 -- paying late`

#ASSERT `What is the most that can be added to my tax for paying late` 10000 TRUE FALSE 10000 0 EQUALS 0
#ASSERT `What is the most that can be added to my tax for paying late` 10000 FALSE TRUE 10500 0 EQUALS 500
#ASSERT `What is the most that can be added to my tax for paying late` 10000 FALSE FALSE 10000 20 EQUALS 1700

§ `ss 94A, 95, 96, 96A -- penalties`

#ASSERT `What penalty must I pay on conviction for` `an incorrect return` 10000 EQUALS 10000
#ASSERT `What penalty must I pay on conviction for` `an incorrect return without reasonable excuse or through negligence` 10000 EQUALS 20000
#ASSERT `What penalty must I pay on conviction for` `wilfully omitting income or making a false statement with intent to evade tax` 10000 EQUALS 30000
#ASSERT `What penalty must I pay on conviction for` `wilfully keeping false books or using fraud with intent to evade tax` 10000 EQUALS 40000

#ASSERT `What is the most I can be fined for` `wilfully keeping false books or using fraud with intent to evade tax` EQUALS 50000

#ASSERT `What is the longest I can be imprisoned for, in months` `wilfully keeping false books or using fraud with intent to evade tax` EQUALS 60

#ASSERT NOT `Must any imprisonment I am liable to be at least 6 months` 2 0
#ASSERT `Must any imprisonment I am liable to be at least 6 months` 1 1

#ASSERT `Am I presumed to have intended to evade tax` TRUE FALSE

