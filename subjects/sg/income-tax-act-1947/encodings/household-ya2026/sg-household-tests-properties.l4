-- the tax at the start of each band, as the Act's rates give it (worked by hand: 10,000 x 2% = 200; + 10,000 x 3.5% = 350; + 40,000 x 7% = 2,800; ...)
#ASSERT (`the Table 3 tax on` 20000) EQUALS 0
#ASSERT (`the Table 3 tax on` 30000) EQUALS 200
#ASSERT (`the Table 3 tax on` 40000) EQUALS 550
#ASSERT (`the Table 3 tax on` 80000) EQUALS 3350
#ASSERT (`the Table 3 tax on` 120000) EQUALS 7950
#ASSERT (`the Table 3 tax on` 160000) EQUALS 13950
#ASSERT (`the Table 3 tax on` 200000) EQUALS 21150
