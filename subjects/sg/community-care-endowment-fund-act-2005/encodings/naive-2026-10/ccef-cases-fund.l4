IMPORT prelude
IMPORT `ccef-fund`

-- Community Care Endowment Fund Act 2005, ss 3(3), 5, 6, 9, 11, 12, 13, 15, 16, 17 and Schedule para 1(3) -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_community-care-endowment-fund-act-2005.py). Expected results were written by
-- hand from the text.

§ `s 6(1)`

#ASSERT `the person is within the objects of the Fund` `a citizen` TRUE TRUE `income to meet basic needs`
#ASSERT `the person is within the objects of the Fund` `a permanent resident` TRUE TRUE `help to integrate into society`
#ASSERT `the person is within the objects of the Fund` `a family member of a citizen or permanent resident` TRUE TRUE `income to meet basic needs`
#ASSERT NOT `the person is within the objects of the Fund` `a family member of a citizen or permanent resident` FALSE TRUE `income to meet basic needs`
#ASSERT `the person is within the objects of the Fund` `a citizen` FALSE TRUE `income to meet basic needs`
#ASSERT NOT `the person is within the objects of the Fund` `a foreigner with no such family tie` TRUE TRUE `income to meet basic needs`
#ASSERT NOT `the person is within the objects of the Fund` `a citizen` TRUE FALSE `income to meet basic needs`
#ASSERT NOT `the person is within the objects of the Fund` `a citizen` TRUE TRUE `none of the listed needs`
#ASSERT `the person is within the objects of the Fund` `a citizen` TRUE TRUE `a child's developmental issues`
#ASSERT NOT `the person is within the objects of the Fund` `a citizen` FALSE TRUE `a child's developmental issues`

