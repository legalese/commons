IMPORT prelude
IMPORT `mda-offences`

-- Misuse of Drugs Act 1973, offences, presumptions and urine specimens (ss 2, 5 to 8A, 17, 18, 21, 22, 31) -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_misuse-of-drugs-act-1973_baseline.py). Expected results were written by
-- hand from the text.

§ `ss 2, 5 to 8 -- which offence my act is`

#ASSERT `What offence would my act be` `I sold it` FALSE EQUALS `trafficking, section 5`
#ASSERT `What offence would my act be` `I had it for the purpose of trafficking` FALSE EQUALS `trafficking, section 5`
#ASSERT `What offence would my act be` `I had it for my own use` FALSE EQUALS `possession, section 8(a)`
#ASSERT `What offence would my act be` `I consumed it myself` FALSE EQUALS `consumption, section 8(b)`
#ASSERT `What offence would my act be` `I brought it into or took it out of Singapore` FALSE EQUALS `import or export, section 7`
#ASSERT `What offence would my act be` `I sold it` TRUE EQUALS `no offence, because the act was authorised under this Act`

§ `ss 22, 8A -- urine tests`

#ASSERT `Am I presumed to have consumed the drug` `positive on both sealed parts` FALSE
#ASSERT NOT `Am I presumed to have consumed the drug` `positive on the preliminary test only` FALSE
#ASSERT NOT `Am I presumed to have consumed the drug` `positive on both sealed parts` TRUE

#ASSERT `Can I be charged in Singapore for consuming a drug abroad` TRUE `positive on both sealed parts`
#ASSERT NOT `Can I be charged in Singapore for consuming a drug abroad` FALSE `positive on both sealed parts`

§ `s 17 -- presumed to be trafficking`

#ASSERT NOT `Am I presumed to have had the drug for trafficking` diamorphine 2 TRUE FALSE
#ASSERT `Am I presumed to have had the drug for trafficking` diamorphine 2.01 TRUE FALSE
#ASSERT NOT `Am I presumed to have had the drug for trafficking` ketamine 113 TRUE FALSE
#ASSERT NOT `Am I presumed to have had the drug for trafficking` methamphetamine 30 FALSE FALSE
#ASSERT NOT `Am I presumed to have had the drug for trafficking` methamphetamine 30 TRUE TRUE
#ASSERT NOT `Am I presumed to have had the drug for trafficking` `another controlled drug` 1000 TRUE FALSE

§ `ss 18, 21 -- presumed to possess, presumed to know`

#ASSERT `Am I taken to possess the drug` `the keys of a place where the drug was found` FALSE FALSE FALSE
#ASSERT NOT `Am I taken to possess the drug` `none of those things` FALSE FALSE FALSE
#ASSERT `Am I taken to possess the drug` `something containing the drug` FALSE TRUE TRUE
#ASSERT NOT `Am I taken to possess the drug` `something containing the drug` FALSE TRUE FALSE
#ASSERT `Am I taken to possess the drug` `none of those things` TRUE TRUE FALSE

#ASSERT `Am I presumed to have known what the drug was` TRUE FALSE

#ASSERT `Am I presumed to possess a drug found in a vehicle` FALSE TRUE FALSE
#ASSERT NOT `Am I presumed to possess a drug found in a vehicle` FALSE FALSE FALSE

§ `s 31 -- urine specimens`

#ASSERT `Must I give a urine specimen when asked` `an officer of the Central Narcotics Bureau` TRUE
#ASSERT NOT `Must I give a urine specimen when asked` `a police officer below the rank of sergeant` TRUE

#ASSERT `Do I commit an offence by not giving a urine specimen` `an immigration officer` TRUE FALSE FALSE
#ASSERT NOT `Do I commit an offence by not giving a urine specimen` `an immigration officer` TRUE FALSE TRUE
#ASSERT NOT `Do I commit an offence by not giving a urine specimen` `an immigration officer` TRUE TRUE FALSE

#TRACE `my duty to provide a urine specimen` 2 AT 0 WITH
    PARTY `I` DOES `provide a urine specimen` AT 1
#TRACE `my duty to provide a urine specimen` 2 AT 0 WITH
    PARTY `the officer` DOES `provide a urine specimen` AT 3
