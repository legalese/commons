§ `ss 33(3A), (4), (4AA) and 33A`

`a clean record` MEANS `My drug record` WITH
    `previous admissions to an approved institution` IS 0
    `previous convictions for consuming a specified drug` IS 0
    `previous convictions for consuming another controlled drug` IS 0
    `previous convictions for failing to give a urine specimen` IS 0
    `previous convictions for failing to give a hair specimen` IS 0
    `previous convictions for consuming a psychoactive substance` IS 0
    `previous military convictions for consuming a specified drug` IS 0
    `previous military convictions for consuming another drug or psychoactive substance` IS 0
    `I have been sentenced under section 33A before` IS FALSE

`one conviction for consuming a specified drug` MEANS `My drug record` WITH
    `previous admissions to an approved institution` IS 0
    `previous convictions for consuming a specified drug` IS 1
    `previous convictions for consuming another controlled drug` IS 0
    `previous convictions for failing to give a urine specimen` IS 0
    `previous convictions for failing to give a hair specimen` IS 0
    `previous convictions for consuming a psychoactive substance` IS 0
    `previous military convictions for consuming a specified drug` IS 0
    `previous military convictions for consuming another drug or psychoactive substance` IS 0
    `I have been sentenced under section 33A before` IS FALSE

`one admission` MEANS `My drug record` WITH
    `previous admissions to an approved institution` IS 1
    `previous convictions for consuming a specified drug` IS 0
    `previous convictions for consuming another controlled drug` IS 0
    `previous convictions for failing to give a urine specimen` IS 0
    `previous convictions for failing to give a hair specimen` IS 0
    `previous convictions for consuming a psychoactive substance` IS 0
    `previous military convictions for consuming a specified drug` IS 0
    `previous military convictions for consuming another drug or psychoactive substance` IS 0
    `I have been sentenced under section 33A before` IS FALSE

`one admission and one urine refusal` MEANS `My drug record` WITH
    `previous admissions to an approved institution` IS 1
    `previous convictions for consuming a specified drug` IS 0
    `previous convictions for consuming another controlled drug` IS 0
    `previous convictions for failing to give a urine specimen` IS 1
    `previous convictions for failing to give a hair specimen` IS 0
    `previous convictions for consuming a psychoactive substance` IS 0
    `previous military convictions for consuming a specified drug` IS 0
    `previous military convictions for consuming another drug or psychoactive substance` IS 0
    `I have been sentenced under section 33A before` IS FALSE

`sentenced under 33A before, with two admissions` MEANS `My drug record` WITH
    `previous admissions to an approved institution` IS 2
    `previous convictions for consuming a specified drug` IS 0
    `previous convictions for consuming another controlled drug` IS 0
    `previous convictions for failing to give a urine specimen` IS 0
    `previous convictions for failing to give a hair specimen` IS 0
    `previous convictions for consuming a psychoactive substance` IS 0
    `previous military convictions for consuming a specified drug` IS 0
    `previous military convictions for consuming another drug or psychoactive substance` IS 0
    `I have been sentenced under section 33A before` IS TRUE

