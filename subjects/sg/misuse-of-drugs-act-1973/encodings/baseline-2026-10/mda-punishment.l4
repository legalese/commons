IMPORT prelude
IMPORT `mda-offences`

-- Misuse of Drugs Act 1973 (Singapore) -- what I can be sentenced to if convicted of trafficking, import or export, possession,
-- consumption, or failing to give a urine specimen, and whether I can be spared the death penalty.
--
-- SEAT: the person charged with a drug offence (the accused person). The answer is the range the Act prints, not a sentence: the
-- court sentences within it.
--
-- Provisions covered: s 33(1) to (3B), (3A), (4), (4AA), (4A), (4B), (4D); s 33A(1), (1B), (2); s 33B(1) to (3); Second Schedule
-- rows 5(1) to 5(7), 5(9) (trafficking: class columns and the sixth column for morphine, diamorphine, cocaine, cannabis, cannabis
-- mixture, cannabis resin, methamphetamine), the same rows under s 7, and 8(a)(1) to (9) (possession).
--
-- Edition: 2020 Revised Edition, informal consolidation, version in force from 1/6/2026, as deposited at
-- ../../registers/source-bundle/MDA1973.txt (SSO, retrieved 2026-10-01).
--
-- NOT ENCODED: the opium rows of the sixth column above 800 grammes (they turn on the morphine content and leave gaps -- returned as
-- `not covered by this encoding`); manufacture (s 6) and every other Schedule row; consumption offences committed before 1 April 2019
-- (the earlier Schedule rows are deleted from this text -- returned as `not covered by this encoding`); s 31A(2) as the offence
-- charged (s 33(4AB), s 33A(1A)); s 33(3C), (3D), (4C) and the psychoactive-substance offences; the relevant-date rules of
-- s 33A(5) (whether a past conviction or admission counts as one for a specified drug is asked as a fact); the certificates of
-- s 33(4AC) to (4AE) and s 33A(3), (4); and caning limits under the Criminal Procedure Code 2010 ss 325(1), 330(1) (s 33(3)).
--
-- BASELINE ENCODING. Written straight from the deposited text with the writing-l4-rules skill, from the seat of the individual to
-- whom the law is applied, with the design defaults ruled on 2026-10-18. No pipeline, no coverage table, no independent test pass,
-- no human gate. Not for public use as advice. See NOTES.md.

§ `Misuse of Drugs Act 1973 -- punishment`

-- s 33(3): "a reference to a period gives the maximum or minimum term of imprisonment ..., a reference to a sum of money gives the
-- maximum or minimum fine ..., and a reference to a number of strokes gives the number of strokes of caning".
DECLARE Punishment HAS
    `death`                                IS A BOOLEAN        -- the Schedule prints "Death" alone
    `imprisonment for life possible`       IS A BOOLEAN        -- "30 years or imprisonment for life"
    `maximum years`                        IS A MAYBE NUMBER   -- NOTHING: no maximum is printed
    `minimum years`                        IS A NUMBER         -- 0: no minimum printed
    `maximum fine`                         IS A NUMBER         -- dollars; 0: no fine
    `fine instead of or with imprisonment` IS A BOOLEAN        -- "or $20,000 or both"; FALSE where the fine is "also" imposed
    `minimum strokes`                      IS A NUMBER
    `maximum strokes`                      IS A NUMBER

DECLARE `What I face` IS ONE OF
    `not covered by this encoding`
    `liable to` HAS `the punishment` IS A Punishment

DECLARE `Drug class` IS ONE OF `Class A`, `Class B`, `Class C`      -- s 2 and the First Schedule; asked as a fact

-- Cells of the Second Schedule and s 33 that recur, as printed. Ruler:
--                                       death, life,  max,      min, fine,   or-both, strokes min, max
`Death`                       MEANS Punishment OF TRUE,  FALSE, NOTHING,  0,   0,      FALSE,   0,  0
`30 years or life, min 20`    MEANS Punishment OF FALSE, TRUE,  JUST 30,  20,  0,      FALSE,   15, 15

§§ `33(2), (4A), (4B), (4D) and Second Schedule rows 5 and 7 -- trafficking, import, export`

-- s 33(2)(b)(ii): the sixth column applies "in the case of unauthorised traffic, import or export or possession, in relation to a
-- specified quantity of such controlled drug or to a controlled drug (except opium) containing such quantity of morphine or
-- diamorphine as is mentioned in the second column". The rows for ss 5 and 7 print the same bands: "not less than" the lower figure
-- "and not more than" the upper: "Maximum 30 years or imprisonment for life and 15 strokes / Minimum 20 years and 15 strokes";
-- "more than" the upper: "Death". The figures, as data (grammes of the drug, or of its content of morphine, diamorphine, cocaine or
-- methamphetamine):
DECLARE `Band` HAS `lower` IS A NUMBER
                   `upper` IS A NUMBER

GIVEN `the drug` IS A Drug
GIVETH A MAYBE `Band`
DECIDE `the sixth-column band for trafficking` IS
    CONSIDER `the drug`
    --                                      lower,  upper
    WHEN morphine           THEN JUST (Band OF 20,     30)       -- row (3), "(except opium)"
    WHEN diamorphine        THEN JUST (Band OF 10,     15)       -- row (4)
    WHEN cocaine            THEN JUST (Band OF 20,     30)       -- row (5)
    WHEN cannabis           THEN JUST (Band OF 330,    500)      -- row (6)
    WHEN `cannabis mixture` THEN JUST (Band OF 660,    1000)     -- row (7)
    WHEN `cannabis resin`   THEN JUST (Band OF 130,    200)      -- row (8)
    WHEN methamphetamine    THEN JUST (Band OF 167,    250)      -- row (9)
    OTHERWISE NOTHING

DECLARE `Trafficking offence` IS ONE OF `trafficking under section 5(1)`, `import or export under section 7`

DECLARE `Trafficking case` HAS
    `the offence`                                                          IS A `Trafficking offence`
    `the drug`                                                             IS A Drug
    `its class`                                                            IS A `Drug class`
    `grammes`                                                              IS A NUMBER
    `I have a previous conviction under section 5(1), 7, 11F(1) or 11H(1)` IS A BOOLEAN
    `I am 21 or older`                                                     IS A BOOLEAN
    `the intended recipient is a young person or a vulnerable person`      IS A BOOLEAN

-- Order, from the text: s 33(4D) "The punishment provided under subsection (4A) or (4B) ... applies only if the punishment as shown
-- in the sixth column of the Second Schedule is not applicable"; then (4A) (convicted again) and (4B) (21 or older, recipient
-- "a young person or a vulnerable person"), which print the same ranges; then the class columns, which apply "except as otherwise
-- provided in this Schedule".
-- Class columns, row 5(1): A "Maximum 20 years and 15 strokes / Minimum 5 years and 5 strokes"; B "Maximum 20 years and 10 strokes /
-- Minimum 3 years and 3 strokes"; C "Maximum 10 years and 5 strokes / Minimum 2 years and 2 strokes". Row 7(1): A and B "Maximum
-- 30 years or imprisonment for life and 15 strokes / Minimum 5 years and 5 strokes"; C "Maximum 20 years and 15 strokes / Minimum
-- 3 years and 5 strokes". s 33(4A), (4B): A 10 to 30 years and 10 to 15 strokes; B 6 to 30 and 6 to 15; C 4 to 20 and 4 to 15.
-- Opium in a quantity of 800 grammes or more is not covered: its rows turn on the morphine content as well as the weight.
GIVEN `the case` IS A `Trafficking case`
GIVETH A `What I face`
DECIDE `What can I be sentenced to for trafficking, importing or exporting` IS
    IF  `the case`'s `the drug` EQUALS opium AND `the case`'s `grammes` AT LEAST 800
    THEN `not covered by this encoding`
    ELSE `liable to` (CONSIDER `the sixth-column band for trafficking` (`the case`'s `the drug`)
                      WHEN JUST band THEN
                          IF      `the case`'s `grammes` GREATER THAN band's `upper` THEN `Death`
                          ELSE IF `the case`'s `grammes` AT LEAST band's `lower`     THEN `30 years or life, min 20`
                          ELSE    `below the sixth column`
                      WHEN NOTHING THEN `below the sixth column`)
    WHERE
        `below the sixth column` MEANS
            IF     `the case`'s `I have a previous conviction under section 5(1), 7, 11F(1) or 11H(1)`
                OR (`the case`'s `I am 21 or older` AND `the case`'s `the intended recipient is a young person or a vulnerable person`)
            THEN `section 33(4A) or (4B)`
            ELSE `the class column`
        `section 33(4A) or (4B)` MEANS
            CONSIDER `the case`'s `its class`
            --                                    death, life,  max,      min, fine, or-both, strokes min, max
            WHEN `Class A` THEN Punishment OF FALSE, FALSE, JUST 30,  10,  0,    FALSE,   10, 15
            WHEN `Class B` THEN Punishment OF FALSE, FALSE, JUST 30,  6,   0,    FALSE,   6,  15
            WHEN `Class C` THEN Punishment OF FALSE, FALSE, JUST 20,  4,   0,    FALSE,   4,  15
        `the class column` MEANS
            CONSIDER `the case`'s `the offence`
            WHEN `trafficking under section 5(1)` THEN
                CONSIDER `the case`'s `its class`
                --                                    death, life,  max,      min, fine, or-both, strokes min, max
                WHEN `Class A` THEN Punishment OF FALSE, FALSE, JUST 20,  5,   0,    FALSE,   5,  15
                WHEN `Class B` THEN Punishment OF FALSE, FALSE, JUST 20,  3,   0,    FALSE,   3,  10
                WHEN `Class C` THEN Punishment OF FALSE, FALSE, JUST 10,  2,   0,    FALSE,   2,  5
            WHEN `import or export under section 7` THEN
                CONSIDER `the case`'s `its class`
                WHEN `Class A` THEN Punishment OF FALSE, TRUE,  JUST 30,  5,   0,    FALSE,   5,  15
                WHEN `Class B` THEN Punishment OF FALSE, TRUE,  JUST 30,  5,   0,    FALSE,   5,  15
                WHEN `Class C` THEN Punishment OF FALSE, FALSE, JUST 20,  3,   0,    FALSE,   5,  15

§§ `33B -- can I be spared the death penalty`

-- s 33B(1): where the offence under s 5(1) or 7 is "punishable with death under the sixth column", the court "(a) may, if the person
-- satisfies the requirements of subsection (2), instead of imposing the death penalty, sentence the person to imprisonment for life
-- and ... caning of not less than 15 strokes; or (b) shall, if the person satisfies the requirements of subsection (3) ... sentence
-- the person to imprisonment for life".
-- (2): (a) the person "proves, on a balance of probabilities, that his or her involvement ... was restricted" to transporting,
-- sending or delivering, offering to, or acts preparatory to those; and (b) "the Public Prosecutor certifies ... that ... the person
-- has substantively assisted the Central Narcotics Bureau". (4): that determination is "at the sole discretion of the Public
-- Prosecutor" -- a judgment handed to someone else, so it is an input: "if the Public Prosecutor certifies".
-- (3): the same restricted involvement and "such abnormality of mind ... as substantially impaired his or her mental
-- responsibility".
-- Inference, labelled: where both (2) and (3) are satisfied, the court "shall" impose life imprisonment, so (1)(b) is taken first.
DECLARE `Death penalty outcome` IS ONE OF
    `section 33B does not apply, because the offence is not punishable with death`
    `the court must sentence me to life imprisonment instead of death`
    `the court may sentence me to life imprisonment and at least 15 strokes instead of death`
    `the sentence is death`

GIVEN `my offence is punishable with death under the sixth column` IS A BOOLEAN
      `I prove I was only a courier` IS A BOOLEAN
      `the Public Prosecutor certifies that I substantively assisted the Central Narcotics Bureau` IS A BOOLEAN
      `I prove an abnormality of mind substantially impaired my mental responsibility` IS A BOOLEAN
GIVETH A `Death penalty outcome`
DECIDE `Can I be spared the death penalty` IS
    BRANCH
        IF NOT `my offence is punishable with death under the sixth column`
        THEN `section 33B does not apply, because the offence is not punishable with death`
        IF `I prove I was only a courier` AND `I prove an abnormality of mind substantially impaired my mental responsibility`
        THEN `the court must sentence me to life imprisonment instead of death`
        IF `I prove I was only a courier` AND `the Public Prosecutor certifies that I substantively assisted the Central Narcotics Bureau`
        THEN `the court may sentence me to life imprisonment and at least 15 strokes instead of death`
        OTHERWISE `the sentence is death`

§§ `33(3B) and Second Schedule row 8(a) -- possession`

-- Row 8(a), sixth column, for each named drug: "(a) less than" the lower figure: "Maximum 10 years or $20,000 or both (subject to
-- section 33(3B))"; "(b) not less than" the lower "and not more than" the upper: "Maximum 20 years and 10 strokes / Minimum
-- 10 years and 5 strokes"; "(c) more than" the upper: "Maximum 30 years and 15 strokes / Minimum 20 years and 10 strokes". The
-- figures are the same as for trafficking. Opium, row (8): "(a) less than 800 grammes", the (b) and (c) bands turning also on the
-- morphine content. Row (9), any other controlled drug: "Maximum 10 years or $20,000 or both (subject to section 33(3B))".
-- s 33(3B): a person who "(a) has a previous conviction under section 8(a) or 11I(1)(a); and (b) is convicted of an offence under
-- section 8(a) that the sixth column ... specifies is subject to this subsection" is punished "with imprisonment for a term of not
-- less than 2 years and not more than 10 years and shall also be liable to a fine not exceeding $20,000".
GIVEN `the drug` IS A Drug
      `grammes` IS A NUMBER
      `I have a previous conviction under section 8(a) or 11I(1)(a)` IS A BOOLEAN
GIVETH A `What I face`
DECIDE `What can I be sentenced to for possession` IS
    IF `the drug` EQUALS opium
    THEN IF `grammes` LESS THAN 800 THEN `liable to` `band (a)` ELSE `not covered by this encoding`
    ELSE `liable to` (CONSIDER `the sixth-column band for trafficking` `the drug`
                      WHEN JUST band THEN
                          IF      `grammes` GREATER THAN band's `upper` THEN `band (c)`
                          ELSE IF `grammes` AT LEAST band's `lower`     THEN `band (b)`
                          ELSE    `band (a)`
                      WHEN NOTHING THEN `band (a)`)
    WHERE
        `band (a)` MEANS
            IF `I have a previous conviction under section 8(a) or 11I(1)(a)`
            --                         death, life,  max,      min, fine,   or-both, strokes min, max
            THEN Punishment OF FALSE, FALSE, JUST 10,  2,   20000,  FALSE,   0,  0      -- s 33(3B)
            ELSE Punishment OF FALSE, FALSE, JUST 10,  0,   20000,  TRUE,    0,  0
        `band (b)` MEANS Punishment OF FALSE, FALSE, JUST 20,  10,  0,      FALSE,   5,  10
        `band (c)` MEANS Punishment OF FALSE, FALSE, JUST 30,  20,  0,      FALSE,   10, 15

§§ `33(3A), (4), (4AA) and 33A -- consumption and failing to give a urine specimen`

-- s 33(3A): an offence under s 8(b), 31(2) or 31A(2) "committed on or after 1 April 2019" is punished "with imprisonment for a term
-- of not less than one year but not more than 10 years and shall also be liable to a fine not exceeding $20,000, unless the person
-- is punished under subsection (4), (4AA) or (4AB) or section 33A".
-- s 33(4): a person "who has a previous conviction under section 8(b) or 31(2)" and "is again convicted" of either: "not less than
-- 3 years" -- no maximum is printed.
-- s 33(4AA): a previous conviction under s 11I(1)(b) or 31A(2), a previous admission to an approved institution under s 34(2), or a
-- previous Singapore Armed Forces Act 1972 s 34 conviction for consumption: "not less than 3 years", no maximum printed.
-- s 33A(1), (1B): "not less than" 2 of the listed antecedents -- (1)(a) to (f) and (1B)(a) to (i) between them list every pair drawn
-- from: admissions, convictions for consuming a specified drug under s 8(b), under s 31(2), under s 31A(2), and military
-- convictions for consuming a specified drug -- and convicted of consuming a specified drug or of s 31(2): "(g) imprisonment for a
-- term of not less than 5 years and not more than 7 years; and (h) not less than 3 strokes and not more than 6 strokes".
-- s 33A(2): "convicted under subsection (1), (1A) or (1B)" and "again convicted": "not less than 7 years and not more than 13 years"
-- and "not less than 6 strokes and not more than 12 strokes".
DECLARE `Consumption offence` IS ONE OF
    `consuming a specified drug, section 8(b)(ii)`
    `consuming another controlled drug, section 8(b)(i)`
    `failing to give a urine specimen, section 31(2)`

DECLARE `My drug record` HAS
    `previous admissions to an approved institution`                                    IS A NUMBER
    `previous convictions for consuming a specified drug`                               IS A NUMBER
    `previous convictions for consuming another controlled drug`                        IS A NUMBER
    `previous convictions for failing to give a urine specimen`                         IS A NUMBER
    `previous convictions for failing to give a hair specimen`                          IS A NUMBER
    `previous convictions for consuming a psychoactive substance`                       IS A NUMBER
    `previous military convictions for consuming a specified drug`                      IS A NUMBER
    `previous military convictions for consuming another drug or psychoactive substance` IS A NUMBER
    `I have been sentenced under section 33A before`                                    IS A BOOLEAN

GIVEN `the offence` IS A `Consumption offence`
      `it was committed on or after 1 April 2019` IS A BOOLEAN
      `my record` IS A `My drug record`
GIVETH A `What I face`
DECIDE `What can I be sentenced to for consumption or for not giving a urine specimen` IS
    IF NOT `it was committed on or after 1 April 2019`
    THEN `not covered by this encoding`
    ELSE `liable to`
             (BRANCH
                 IF `section 33A can apply` AND `my record`'s `I have been sentenced under section 33A before`
                 --                         death, life,  max,      min, fine,   or-both, strokes min, max
                 THEN Punishment OF FALSE, FALSE, JUST 13,  7,   0,      FALSE,   6,  12            -- s 33A(2)
                 IF `section 33A can apply` AND `specified-drug antecedents` AT LEAST 2
                 THEN Punishment OF FALSE, FALSE, JUST 7,   5,   0,      FALSE,   3,  6             -- s 33A(1), (1B)
                 IF `section 33(4) antecedent` OR `section 33(4AA) antecedent`
                 THEN Punishment OF FALSE, FALSE, NOTHING,  3,   0,      FALSE,   0,  0             -- s 33(4), (4AA)
                 OTHERWISE
                      Punishment OF FALSE, FALSE, JUST 10,  1,   20000,  FALSE,   0,  0)            -- s 33(3A)
    WHERE
        `section 33A can apply` MEANS
            CONSIDER `the offence`
            WHEN `consuming another controlled drug, section 8(b)(i)` THEN FALSE
            OTHERWISE TRUE
        `specified-drug antecedents` MEANS
                `my record`'s `previous admissions to an approved institution`
            PLUS `my record`'s `previous convictions for consuming a specified drug`
            PLUS `my record`'s `previous convictions for failing to give a urine specimen`
            PLUS `my record`'s `previous convictions for failing to give a hair specimen`
            PLUS `my record`'s `previous military convictions for consuming a specified drug`
        `section 33(4) antecedent` MEANS
               `my record`'s `previous convictions for consuming a specified drug` AT LEAST 1
            OR `my record`'s `previous convictions for consuming another controlled drug` AT LEAST 1
            OR `my record`'s `previous convictions for failing to give a urine specimen` AT LEAST 1
        `section 33(4AA) antecedent` MEANS
               `my record`'s `previous convictions for consuming a psychoactive substance` AT LEAST 1
            OR `my record`'s `previous convictions for failing to give a hair specimen` AT LEAST 1
            OR `my record`'s `previous admissions to an approved institution` AT LEAST 1
            OR `my record`'s `previous military convictions for consuming a specified drug` AT LEAST 1
            OR `my record`'s `previous military convictions for consuming another drug or psychoactive substance` AT LEAST 1
