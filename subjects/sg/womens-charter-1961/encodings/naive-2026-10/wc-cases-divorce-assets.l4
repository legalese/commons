IMPORT prelude
IMPORT `wc-family`
IMPORT `wc-divorce-assets`

-- Women's Charter 1961, ss 93, 94, 95, 95A(1)(d)-(f), 112 -- worked cases for REQ-0270.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked against a
-- decided case or the Family Justice Rules (none was retrieved). Expected results were written by hand from the text.
-- ASSUMED for the scenario (the requirement does not say): both are domiciled in Singapore, they have been married 6 years,
-- and they lived apart for 36 months with no time back together.

`the rented flat` MEANS Asset WITH
    `what it is` IS "the HDB flat they rented from a landlord throughout the marriage"
    `value` IS 0
    `owned by one or both spouses` IS FALSE
    `held jointly` IS FALSE
    `acquired during the marriage` IS FALSE
    `ordinarily used by the family while residing together` IS TRUE
    `substantially improved during the marriage by the other party or both` IS FALSE
    `acquired by one party by gift or inheritance` IS FALSE
    `is a matrimonial home` IS FALSE

`his savings` MEANS Asset WITH
    `what it is` IS "a bank account in the husband's sole name, saved from salary during the marriage"
    `value` IS 20000
    `owned by one or both spouses` IS TRUE
    `held jointly` IS FALSE
    `acquired during the marriage` IS TRUE
    `ordinarily used by the family while residing together` IS FALSE
    `substantially improved during the marriage by the other party or both` IS FALSE
    `acquired by one party by gift or inheritance` IS FALSE
    `is a matrimonial home` IS FALSE

`her car from before the marriage` MEANS Asset WITH
    `what it is` IS "a car the wife bought before the marriage and the family used for transport"
    `value` IS 30000
    `owned by one or both spouses` IS TRUE
    `held jointly` IS FALSE
    `acquired during the marriage` IS FALSE
    `ordinarily used by the family while residing together` IS TRUE
    `substantially improved during the marriage by the other party or both` IS FALSE
    `acquired by one party by gift or inheritance` IS FALSE
    `is a matrimonial home` IS FALSE

`his shares from before the marriage` MEANS Asset WITH
    `what it is` IS "shares the husband bought before the marriage and never touched"
    `value` IS 15000
    `owned by one or both spouses` IS TRUE
    `held jointly` IS FALSE
    `acquired during the marriage` IS FALSE
    `ordinarily used by the family while residing together` IS FALSE
    `substantially improved during the marriage by the other party or both` IS FALSE
    `acquired by one party by gift or inheritance` IS FALSE
    `is a matrimonial home` IS FALSE

`her inheritance kept apart` MEANS Asset WITH
    `what it is` IS "cash the wife inherited during the marriage and kept in her own account"
    `value` IS 50000
    `owned by one or both spouses` IS TRUE
    `held jointly` IS FALSE
    `acquired during the marriage` IS TRUE
    `ordinarily used by the family while residing together` IS FALSE
    `substantially improved during the marriage by the other party or both` IS FALSE
    `acquired by one party by gift or inheritance` IS TRUE
    `is a matrimonial home` IS FALSE

`an inherited flat they lived in` MEANS Asset WITH
    `what it is` IS "a flat the husband inherited, which became the matrimonial home"
    `value` IS 400000
    `owned by one or both spouses` IS TRUE
    `held jointly` IS FALSE
    `acquired during the marriage` IS FALSE
    `ordinarily used by the family while residing together` IS TRUE
    `substantially improved during the marriage by the other party or both` IS FALSE
    `acquired by one party by gift or inheritance` IS TRUE
    `is a matrimonial home` IS TRUE

`a gifted shophouse she renovated` MEANS Asset WITH
    `what it is` IS "a shophouse given to the husband, substantially renovated during the marriage by the wife"
    `value` IS 200000
    `owned by one or both spouses` IS TRUE
    `held jointly` IS FALSE
    `acquired during the marriage` IS TRUE
    `ordinarily used by the family while residing together` IS FALSE
    `substantially improved during the marriage by the other party or both` IS TRUE
    `acquired by one party by gift or inheritance` IS TRUE
    `is a matrimonial home` IS FALSE

`a joint account` MEANS Asset WITH
    `what it is` IS "a joint bank account opened during the marriage"
    `value` IS 10000
    `owned by one or both spouses` IS TRUE
    `held jointly` IS TRUE
    `acquired during the marriage` IS TRUE
    `ordinarily used by the family while residing together` IS FALSE
    `substantially improved during the marriage by the other party or both` IS FALSE
    `acquired by one party by gift or inheritance` IS FALSE
    `is a matrimonial home` IS FALSE

`a separation with consent` MEANS Breakdown WITH
    `the respondent committed adultery` IS FALSE
    `the applicant finds it intolerable` IS FALSE
    `months lived together after learning of it` IS 0
    `the respondent behaved so the applicant cannot reasonably live with them` IS FALSE
    `months of desertion` IS 0
    `months together during the desertion` IS 0
    `months living apart` IS 36
    `months together during the separation` IS 0
    `both consent to a divorce` IS TRUE
    `a written agreement that it has broken down` IS FALSE
    `reconciliation remains reasonably possible` IS FALSE

`nothing at all but a tenancy` MEANS LIST `the rented flat`
`nothing joint, but his savings` MEANS LIST `the rented flat`, `his savings`

-- REQ-0270 FIRST: the requirement's own question on its facts.
-- Three years apart with consent is s 95A(1)(d); the divorce may be granted (on the assumptions above) ...
#ASSERT `the consensual or separation fact made out` 36 0 TRUE FALSE FALSE EQUALS `three years apart with consent, s 95A(1)(d)`
#ASSERT `a divorce on consent or separation may be granted` TRUE 0 6 36 0 TRUE FALSE FALSE TRUE
#ASSERT `the marriage has irretrievably broken down` `a separation with consent`
-- ... and if they truly own nothing (only a tenancy), there is no matrimonial asset and no division order (s 112(1), (10)).
#ASSERT `the section 112 outcome` TRUE `nothing at all but a tenancy` EQUALS `no matrimonial asset: no division order`
#ASSERT `the number of matrimonial assets` `nothing at all but a tenancy` EQUALS 0
-- BUT "own nothing jointly" does not settle it: savings in one name, made during the marriage, are a matrimonial asset.
#ASSERT `the number of jointly held assets` `nothing joint, but his savings` EQUALS 0
#ASSERT `the number of matrimonial assets` `nothing joint, but his savings` EQUALS 1
#ASSERT `the section 112 outcome` TRUE `nothing joint, but his savings` EQUALS `division in just and equitable proportions`
#ASSERT `the value of the matrimonial pool` `nothing joint, but his savings` EQUALS 20000

-- s 95A(1)(d)-(f), (5): the separation and agreement facts.
#ASSERT `the consensual or separation fact made out` 35 0 TRUE FALSE FALSE EQUALS `no consensual or separation fact`
#ASSERT `the consensual or separation fact made out` 36 0 FALSE FALSE FALSE EQUALS `no consensual or separation fact`
#ASSERT `the consensual or separation fact made out` 48 0 FALSE FALSE FALSE EQUALS `four years apart, s 95A(1)(e)`
-- 40 months apart with 4 back together: 36 count, so (d) with consent.
#ASSERT `the consensual or separation fact made out` 40 4 TRUE FALSE FALSE EQUALS `three years apart with consent, s 95A(1)(d)`
#ASSERT `the consensual or separation fact made out` 40 7 TRUE FALSE FALSE EQUALS `no consensual or separation fact`
#ASSERT `the consensual or separation fact made out` 0 0 FALSE TRUE FALSE EQUALS `agreement that the marriage has broken down, s 95A(1)(f)`
#ASSERT `the consensual or separation fact made out` 0 0 FALSE TRUE TRUE EQUALS `no consensual or separation fact`

-- ss 93, 94, 95(2)(c): the rest of the path.
#ASSERT NOT `a divorce on consent or separation may be granted` TRUE 0 2 36 0 TRUE FALSE FALSE TRUE
#ASSERT NOT `a divorce on consent or separation may be granted` FALSE 2 6 36 0 TRUE FALSE FALSE TRUE
#ASSERT NOT `a divorce on consent or separation may be granted` TRUE 0 6 36 0 TRUE FALSE FALSE FALSE

-- s 112(10): what is and is not a matrimonial asset.
#ASSERT NOT `is a matrimonial asset` `the rented flat`
#ASSERT `is a matrimonial asset` `her car from before the marriage`
#ASSERT NOT `is a matrimonial asset` `his shares from before the marriage`
#ASSERT NOT `is a matrimonial asset` `her inheritance kept apart`
#ASSERT `is a matrimonial asset` `an inherited flat they lived in`
#ASSERT `is a matrimonial asset` `a gifted shophouse she renovated`
#ASSERT `is a matrimonial asset` `a joint account`

-- s 112(1): the pool and a share. Of all eight items, the pool is 20,000 + 30,000 + 400,000 + 200,000 + 10,000 = 660,000.
#ASSERT `the number of matrimonial assets` (LIST `the rented flat`, `his savings`, `her car from before the marriage`, `his shares from before the marriage`, `her inheritance kept apart`, `an inherited flat they lived in`, `a gifted shophouse she renovated`, `a joint account`) EQUALS 5
#ASSERT `the value of the matrimonial pool` (LIST `the rented flat`, `his savings`, `her car from before the marriage`, `his shares from before the marriage`, `her inheritance kept apart`, `an inherited flat they lived in`, `a gifted shophouse she renovated`, `a joint account`) EQUALS 660000
-- A 40% share of the savings and car (50,000) is 20,000.
#ASSERT `the applicant's share of the pool` 0.4 (LIST `his savings`, `her car from before the marriage`) EQUALS 20000
-- Without a judgment of divorce, judicial separation or nullity there is no s 112 power at all.
#ASSERT `the section 112 outcome` FALSE `nothing joint, but his savings` EQUALS `no power yet: no judgment of divorce, judicial separation or nullity`
