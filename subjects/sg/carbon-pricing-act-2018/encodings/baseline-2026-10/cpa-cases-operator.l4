IMPORT prelude
IMPORT `cpa-operator`

-- Carbon Pricing Act 2018, the operator of a business facility: ss 2-4, 7-9, 11, 12, 16, 17, 20C, 34, 54-59, 62 and the Second and Third Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_carbon-pricing-act-2018_baseline.py). Expected results were written by
-- hand from the text.

§ `s 2 -- reckonable emissions`

#ASSERT `my reckonable emissions as reported` 30000 2000 4000 EQUALS 24000

§ `ss 3, 4 -- site and control`

#ASSERT `Are my parcels one site` TRUE FALSE TRUE
#ASSERT NOT `Are my parcels one site` FALSE TRUE TRUE

#ASSERT `Do I have operational control` FALSE FALSE TRUE FALSE
#ASSERT NOT `Do I have operational control` TRUE TRUE TRUE TRUE

§ `ss 7(1)-(4), 8(1)(a)(i) -- registering`

#ASSERT `Must I apply to be registered as a registered person` 2000 TRUE FALSE FALSE
#ASSERT NOT `Must I apply to be registered as a registered person` 1999.5 TRUE FALSE FALSE
#ASSERT NOT `Must I apply to be registered as a registered person` 5000 TRUE FALSE TRUE

#ASSERT NOT `Must I apply to register the facility as a reportable facility` 2000 TRUE TRUE

#ASSERT `Must I apply to register the facility as a taxable facility` 25000 TRUE FALSE
#ASSERT NOT `Must I apply to register the facility as a taxable facility` 30000 FALSE FALSE

#ASSERT `By when must I apply to register` 2025 EQUALS (Date 30 6 2026)

§ `ss 7(5), 8(1)(a)(ii) -- taking over a facility`

#ASSERT NOT `Must I apply to be registered as a registered person after taking over` TRUE TRUE

#ASSERT `By when must I apply after taking over operational control` (Date 15 3 2025) TRUE 30000 EQUALS (JUST (Date 14 4 2025))
#ASSERT `By when must I apply after taking over operational control` (Date 15 3 2025) TRUE 10000 EQUALS NOTHING
#ASSERT `By when must I apply after taking over operational control` (Date 15 3 2025) FALSE 10000 EQUALS (JUST (Date 30 6 2026))
#ASSERT `By when must I apply after taking over operational control` (Date 20 6 2025) FALSE 30000 EQUALS (JUST (Date 20 7 2025))

§ `s 9 -- deregistering`

#ASSERT `May I apply to deregister the facility as` `a taxable facility` FALSE FALSE 3 FALSE 0 FALSE
#ASSERT NOT `May I apply to deregister the facility as` `a taxable facility` FALSE FALSE 2 FALSE 0 FALSE
#ASSERT `May I apply to deregister the facility as` `a taxable facility` FALSE FALSE 0 TRUE 20000 TRUE
#ASSERT NOT `May I apply to deregister the facility as` `a reportable facility` FALSE FALSE 0 TRUE 20000 TRUE
#ASSERT `May I apply to deregister the facility as` `a taxable facility` FALSE TRUE 0 FALSE 0 FALSE

#ASSERT `By when must I give the Agency notice that my control will cease` (Date 30 6 2026) EQUALS (Date 16 5 2026)

§ `ss 11, 12 -- reports`

#ASSERT `Must I submit an emissions report for the year` TRUE TRUE
#ASSERT NOT `Must I submit an emissions report for the year` FALSE TRUE

#ASSERT `Must this part of my report be verified by an accredited external auditor` TRUE TRUE FALSE FALSE
#ASSERT NOT `Must this part of my report be verified by an accredited external auditor` TRUE FALSE FALSE FALSE

§ `Third Schedule`

#ASSERT `the carbon tax rate for` 2023 EQUALS 5
#ASSERT `the carbon tax rate for` 2025 EQUALS 25
#ASSERT `the carbon tax rate for` 2026 EQUALS 45

#ASSERT `the carbon price of a credit bought in` 2024 EQUALS 5
#ASSERT `the carbon price of a credit bought in` 2026 EQUALS 25
#ASSERT `the carbon price of a credit bought in` 2027 EQUALS 45

§ `ss 16, 20C -- the carbon tax`

`a 2025 year just over 30,000 tonnes` MEANS `Facility year` WITH
    `emissions year` IS 2025
    `it was my taxable facility in the year` IS TRUE
    `GHG emissions` IS 30000.4
    `non-reckonable emissions` IS 0
    `excluded emissions` IS 0
    `allowance awarded to me for the year` IS 0
    `Division 1A applies to the year` IS TRUE

`a 2026 year with non-reckonable and excluded emissions` MEANS `Facility year` WITH
    `emissions year` IS 2026
    `it was my taxable facility in the year` IS TRUE
    `GHG emissions` IS 50000
    `non-reckonable emissions` IS 2000
    `excluded emissions` IS 3000
    `allowance awarded to me for the year` IS 0
    `Division 1A applies to the year` IS TRUE

`a 2026 year under the threshold once excluded emissions are left out` MEANS `Facility year` WITH
    `emissions year` IS 2026
    `it was my taxable facility in the year` IS TRUE
    `GHG emissions` IS 26000
    `non-reckonable emissions` IS 0
    `excluded emissions` IS 2000
    `allowance awarded to me for the year` IS 0
    `Division 1A applies to the year` IS TRUE

`a 2026 year with an allowance` MEANS `Facility year` WITH
    `emissions year` IS 2026
    `it was my taxable facility in the year` IS TRUE
    `GHG emissions` IS 100000
    `non-reckonable emissions` IS 0
    `excluded emissions` IS 0
    `allowance awarded to me for the year` IS 40000.5
    `Division 1A applies to the year` IS TRUE

`a 2026 year with an allowance after Division 1A has ended` MEANS `Facility year` WITH
    `emissions year` IS 2026
    `it was my taxable facility in the year` IS TRUE
    `GHG emissions` IS 100000
    `non-reckonable emissions` IS 0
    `excluded emissions` IS 0
    `allowance awarded to me for the year` IS 40000.5
    `Division 1A applies to the year` IS FALSE

`a 2026 year where the allowance takes the emissions under the threshold` MEANS `Facility year` WITH
    `emissions year` IS 2026
    `it was my taxable facility in the year` IS TRUE
    `GHG emissions` IS 30000
    `non-reckonable emissions` IS 0
    `excluded emissions` IS 0
    `allowance awarded to me for the year` IS 10000
    `Division 1A applies to the year` IS TRUE

`a 2023 year` MEANS `Facility year` WITH
    `emissions year` IS 2023
    `it was my taxable facility in the year` IS TRUE
    `GHG emissions` IS 30000
    `non-reckonable emissions` IS 0
    `excluded emissions` IS 0
    `allowance awarded to me for the year` IS 0
    `Division 1A applies to the year` IS TRUE

#ASSERT NOT `Am I charged carbon tax for the year` `a 2026 year under the threshold once excluded emissions are left out`
#ASSERT `Am I charged carbon tax for the year` `a 2023 year`

#ASSERT `What carbon tax am I charged for the year` `a 2025 year just over 30,000 tonnes` EQUALS (JUST 750025)
#ASSERT `What carbon tax am I charged for the year` `a 2026 year with non-reckonable and excluded emissions` EQUALS (JUST 2025000)
#ASSERT `What carbon tax am I charged for the year` `a 2026 year with an allowance` EQUALS (JUST 2700000)
#ASSERT `What carbon tax am I charged for the year` `a 2026 year with an allowance after Division 1A has ended` EQUALS (JUST 4500000)
#ASSERT `What carbon tax am I charged for the year` `a 2026 year where the allowance takes the emissions under the threshold` EQUALS (JUST 900000)
#ASSERT `What carbon tax am I charged for the year` `a 2023 year` EQUALS NOTHING

§ `s 17 -- paying`

#ASSERT `By when must I pay the tax` TRUE 2025 (Date 1 8 2026) EQUALS (Date 30 9 2026)
#ASSERT `By when must I pay the tax` TRUE 2025 (Date 15 9 2026) EQUALS (Date 15 10 2026)
#ASSERT `By when must I pay the tax` FALSE 2025 (Date 1 8 2026) EQUALS (Date 31 8 2026)

#ASSERT `How many fixed-price carbon credits must I surrender` 750025 2025 EQUALS (JUST 30001)
#ASSERT `How many fixed-price carbon credits must I surrender` 2025000 2027 EQUALS (JUST 45000)
#ASSERT `How many fixed-price carbon credits must I surrender` 1000 2027 EQUALS NOTHING

#ASSERT `What late-payment penalty can I be made to pay` 100000 FALSE 0 EQUALS 5000
#ASSERT `What late-payment penalty can I be made to pay` 100000 TRUE 4 EQUALS 9000
#ASSERT `What late-payment penalty can I be made to pay` 100000 TRUE 400 EQUALS 305000

§ `s 34 -- appeal`

#ASSERT `Can I appeal to the Minister` `refusing to deregister my taxable facility` 30
#ASSERT NOT `Can I appeal to the Minister` `refusing to deregister my taxable facility` 31
#ASSERT NOT `Can I appeal to the Minister` `refusing to deregister my reportable facility` 10

§ `ss 54-59, 62 -- offences`

#ASSERT `What is the most I can be made to pay or serve for` `not applying to register a taxable facility, s 54(3)` 200000 EQUALS (`Exposure` OF 30000, 50, 0)
#ASSERT `What is the most I can be made to pay or serve for` `a false statement in a registration application, s 54(4)` 0 EQUALS (`Exposure` OF 5000, 0, 0.5)
#ASSERT `What is the most I can be made to pay or serve for` `an inaccurate verified emissions report, s 56(2)` 80000 EQUALS (`Exposure` OF 80000, 0, 0)
#ASSERT `What is the most I can be made to pay or serve for` `an inaccurate verified emissions report through negligence, s 56(3)` 80000 EQUALS (`Exposure` OF 165000, 0, 3)
#ASSERT `What is the most I can be made to pay or serve for` `an inaccurate verified emissions report by fraud and wilfully to evade tax, s 56(5)` 80000 EQUALS (`Exposure` OF 370000, 0, 5)
#ASSERT `What is the most I can be made to pay or serve for` `not paying the tax in a demand note, s 59` 100000 EQUALS (`Exposure` OF 300000, 0, 0)

#ASSERT NOT `Can I be convicted for the inaccuracy` TRUE TRUE

