IMPORT prelude
IMPORT `htc-cadets`

-- Home Team Corps Act 2017, ss 2, 6(3), 9 to 15 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_home-team-corps-act-2017.py). Expected results were written by
-- hand from the text.

`a citizen student` MEANS Applicant WITH
    `is a citizen` IS TRUE
    `is a permanent resident` IS FALSE
    `has the Minister's special approval` IS FALSE
    `is already in the other Corps` IS FALSE

`a permanent resident student` MEANS Applicant WITH
    `is a citizen` IS FALSE
    `is a permanent resident` IS TRUE
    `has the Minister's special approval` IS FALSE
    `is already in the other Corps` IS FALSE

`a foreign student without approval` MEANS Applicant WITH
    `is a citizen` IS FALSE
    `is a permanent resident` IS FALSE
    `has the Minister's special approval` IS FALSE
    `is already in the other Corps` IS FALSE

`a foreign student with the Minister's approval` MEANS Applicant WITH
    `is a citizen` IS FALSE
    `is a permanent resident` IS FALSE
    `has the Minister's special approval` IS TRUE
    `is already in the other Corps` IS FALSE

`a citizen already in the NCDCC` MEANS Applicant WITH
    `is a citizen` IS TRUE
    `is a permanent resident` IS FALSE
    `has the Minister's special approval` IS FALSE
    `is already in the other Corps` IS TRUE

`an approved foreigner already in the NPCC` MEANS Applicant WITH
    `is a citizen` IS FALSE
    `is a permanent resident` IS FALSE
    `has the Minister's special approval` IS TRUE
    `is already in the other Corps` IS TRUE

`defiant refusal of a lawful command` MEANS Conduct WITH
    `disobeyed a lawful command` IS TRUE
    `showed wilful defiance of authority` IS TRUE
    `contravened an order or regulation` IS FALSE
    `knew of it` IS FALSE
    `might reasonably be expected to know of it` IS FALSE

`forgetting a command without defiance` MEANS Conduct WITH
    `disobeyed a lawful command` IS TRUE
    `showed wilful defiance of authority` IS FALSE
    `contravened an order or regulation` IS FALSE
    `knew of it` IS FALSE
    `might reasonably be expected to know of it` IS FALSE

`breaking a known routine order` MEANS Conduct WITH
    `disobeyed a lawful command` IS FALSE
    `showed wilful defiance of authority` IS FALSE
    `contravened an order or regulation` IS TRUE
    `knew of it` IS TRUE
    `might reasonably be expected to know of it` IS FALSE

`breaking an order the cadet should have known` MEANS Conduct WITH
    `disobeyed a lawful command` IS FALSE
    `showed wilful defiance of authority` IS FALSE
    `contravened an order or regulation` IS TRUE
    `knew of it` IS FALSE
    `might reasonably be expected to know of it` IS TRUE

`breaking an order the cadet could not have known` MEANS Conduct WITH
    `disobeyed a lawful command` IS FALSE
    `showed wilful defiance of authority` IS FALSE
    `contravened an order or regulation` IS TRUE
    `knew of it` IS FALSE
    `might reasonably be expected to know of it` IS FALSE

