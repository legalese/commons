§ `ss 13, 14`

`accepted $20,000 with $5,000 more taken into consideration` MEANS `My acceptance` WITH
    `I am convicted of an offence committed by accepting a gratification` IS TRUE
    `it is money, or its value can be assessed` IS TRUE
    `its amount, or its value in the court's opinion` IS 20000
    `the total in the charges taken into consideration` IS 5000

`accepted a favour that cannot be valued` MEANS `My acceptance` WITH
    `I am convicted of an offence committed by accepting a gratification` IS TRUE
    `it is money, or its value can be assessed` IS FALSE
    `its amount, or its value in the court's opinion` IS 0
    `the total in the charges taken into consideration` IS 0

`convicted of giving, not accepting` MEANS `My acceptance` WITH
    `I am convicted of an offence committed by accepting a gratification` IS FALSE
    `it is money, or its value can be assessed` IS TRUE
    `its amount, or its value in the court's opinion` IS 20000
    `the total in the charges taken into consideration` IS 0

#ASSERT `What penalty must I pay on top of my sentence` `accepted $20,000 with $5,000 more taken into consideration` EQUALS (`a penalty on top of my sentence` 20000 25000)
#ASSERT `What penalty must I pay on top of my sentence` `accepted a favour that cannot be valued` EQUALS `no section 13 penalty`
#ASSERT `What penalty must I pay on top of my sentence` `convicted of giving, not accepting` EQUALS `no section 13 penalty`

#ASSERT `How much can the principal recover from me as a civil debt` TRUE TRUE 8000 TRUE EQUALS 8000
#ASSERT `How much can the principal recover from me as a civil debt` TRUE FALSE 8000 FALSE EQUALS 0

