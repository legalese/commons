    `cargo` IS `general cargo`
    `shipped from a port in Singapore` IS FALSE
    `between ports in 2 different States` IS TRUE
    `bill issued in a contracting State` IS FALSE
    `shipped from a port in a contracting State` IS FALSE
    `the contract expressly provides that the Rules govern` IS FALSE

