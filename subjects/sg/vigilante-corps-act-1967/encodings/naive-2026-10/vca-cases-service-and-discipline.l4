IMPORT prelude
IMPORT `vca-service-and-discipline`

-- Vigilante Corps Act 1967, ss 10 to 18, 22 to 27, 29, 30 and Schedule item 27 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_vigilante-corps-act-1967.py). Expected results were written by
-- hand from the text.

`a volunteer vigilante` MEANS Member WITH
    `is a national serviceman` IS FALSE
    `is below the rank of assistant unit leader` IS TRUE
    `is a full-time member` IS FALSE

`a national service vigilante` MEANS Member WITH
    `is a national serviceman` IS TRUE
    `is below the rank of assistant unit leader` IS TRUE
    `is a full-time member` IS FALSE

`a volunteer unit leader` MEANS Member WITH
    `is a national serviceman` IS FALSE
    `is below the rank of assistant unit leader` IS FALSE
    `is a full-time member` IS FALSE

`a full-time volunteer` MEANS Member WITH
    `is a national serviceman` IS FALSE
    `is below the rank of assistant unit leader` IS TRUE
    `is a full-time member` IS TRUE

