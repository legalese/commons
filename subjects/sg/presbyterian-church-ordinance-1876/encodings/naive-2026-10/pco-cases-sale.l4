IMPORT prelude
IMPORT `pco-sale`

-- Presbyterian Church Ordinance 1876, ss 2-3 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_presbyterian-church-ordinance-1876.py). Expected results were written by
-- hand from the text.

`all seven named trustees acting together` MEANS SellingGroup WITH
    `every member is one of the seven named trustees` IS TRUE
    `every member is alive` IS TRUE
    `includes every surviving named trustee` IS TRUE
    `number of members` IS 7
    `every member is resident in the Colony` IS TRUE

`all four survivors acting together, two living in Scotland` MEANS SellingGroup WITH
    `every member is one of the seven named trustees` IS TRUE
    `every member is alive` IS TRUE
    `includes every surviving named trustee` IS TRUE
    `number of members` IS 4
    `every member is resident in the Colony` IS FALSE

`two resident survivors out of four` MEANS SellingGroup WITH
    `every member is one of the seven named trustees` IS TRUE
    `every member is alive` IS TRUE
    `includes every surviving named trustee` IS FALSE
    `number of members` IS 2
    `every member is resident in the Colony` IS TRUE

`three of four survivors, one living in London` MEANS SellingGroup WITH
    `every member is one of the seven named trustees` IS TRUE
    `every member is alive` IS TRUE
    `includes every surviving named trustee` IS FALSE
    `number of members` IS 3
    `every member is resident in the Colony` IS FALSE

`a sole survivor acting alone` MEANS SellingGroup WITH
    `every member is one of the seven named trustees` IS TRUE
    `every member is alive` IS TRUE
    `includes every surviving named trustee` IS TRUE
    `number of members` IS 1
    `every member is resident in the Colony` IS FALSE

`one resident survivor of three acting alone` MEANS SellingGroup WITH
    `every member is one of the seven named trustees` IS TRUE
    `every member is alive` IS TRUE
    `includes every surviving named trustee` IS FALSE
    `number of members` IS 1
    `every member is resident in the Colony` IS TRUE

`two resident survivors joined by a later-appointed trustee` MEANS SellingGroup WITH
    `every member is one of the seven named trustees` IS FALSE
    `every member is alive` IS TRUE
    `includes every surviving named trustee` IS FALSE
    `number of members` IS 3
    `every member is resident in the Colony` IS TRUE

`two resident trustees appointed after 1876` MEANS SellingGroup WITH
    `every member is one of the seven named trustees` IS FALSE
    `every member is alive` IS TRUE
    `includes every surviving named trustee` IS FALSE
    `number of members` IS 2
    `every member is resident in the Colony` IS TRUE

§ `s 2 -- who may sell`

#ASSERT `may exercise the power of sale` `all seven named trustees acting together`
#ASSERT `may exercise the power of sale` `all four survivors acting together, two living in Scotland`
#ASSERT `may exercise the power of sale` `two resident survivors out of four`
#ASSERT NOT `may exercise the power of sale` `three of four survivors, one living in London`
#ASSERT `may exercise the power of sale` `a sole survivor acting alone`
#ASSERT NOT `may exercise the power of sale` `one resident survivor of three acting alone`
#ASSERT NOT `may exercise the power of sale` `two resident survivors joined by a later-appointed trustee`
#ASSERT NOT `may exercise the power of sale` `two resident trustees appointed after 1876`

§ `s 2 -- what may be done`

#ASSERT `is within the section 2 power` `sell the Indenture 215 land`
#ASSERT `is within the section 2 power` `sell buildings standing on it in 1876`
#ASSERT NOT `is within the section 2 power` `sell a building put up on it after the Ordinance`
#ASSERT `is within the section 2 power` `execute assurances for the sale`
#ASSERT `is within the section 2 power` `give effectual receipts for the purchase money`
#ASSERT `is within the section 2 power` `do other acts for completing the sale`
#ASSERT NOT `is within the section 2 power` `sell other land of the congregation`
#ASSERT NOT `is within the section 2 power` `mortgage the Indenture 215 land`

#ASSERT `the group may do the act` `two resident survivors out of four` `sell the Indenture 215 land`
#ASSERT NOT `the group may do the act` `two resident survivors out of four` `sell other land of the congregation`
#ASSERT NOT `the group may do the act` `three of four survivors, one living in London` `sell the Indenture 215 land`
#ASSERT `the group may do the act` `a sole survivor acting alone` `give effectual receipts for the purchase money`

§ `s 3(1)`

#ASSERT `the net proceeds` 12000 1500 EQUALS 10500
#ASSERT `the net proceeds` 8000 0 EQUALS 8000
#ASSERT `the net proceeds` 5000 5000 EQUALS 0

#ASSERT `is the payee section 3 names` `the trustees of the land granted by the Crown`
#ASSERT NOT `is the payee section 3 names` `the selling trustees`
#ASSERT NOT `is the payee section 3 names` `the London Missionary Society`
#ASSERT NOT `is the payee section 3 names` `the members of the congregation`

#ASSERT `the proceeds may be applied to` `building a new church on the granted land`
#ASSERT `the proceeds may be applied to` `building a new chapel on part of the granted land`
#ASSERT NOT `the proceeds may be applied to` `building another kind of place of worship on the granted land`
#ASSERT NOT `the proceeds may be applied to` `building a church on other land`
#ASSERT NOT `the proceeds may be applied to` `repairing the old chapel`
#ASSERT NOT `the proceeds may be applied to` `the general expenses of the congregation`
#ASSERT NOT `the proceeds may be applied to` `buying more land`

§ `s 3(2)`

-- a Presbyterian congregation holding the Westminster Standard
#ASSERT `is within the recited purpose of the 1875 grant` TRUE TRUE
-- a Christian denomination with another confession
#ASSERT NOT `is within the recited purpose of the 1875 grant` FALSE TRUE
-- a non-Christian body
#ASSERT NOT `is within the recited purpose of the 1875 grant` FALSE FALSE

§ `s 3(3)`

#ASSERT `the receipt is a sufficient discharge to the purchaser` `all seven named trustees acting together` TRUE
#ASSERT `the receipt is a sufficient discharge to the purchaser` `two resident survivors out of four` TRUE
#ASSERT NOT `the receipt is a sufficient discharge to the purchaser` `two resident survivors out of four` FALSE
#ASSERT NOT `the receipt is a sufficient discharge to the purchaser` `three of four survivors, one living in London` TRUE
#ASSERT NOT `the receipt is a sufficient discharge to the purchaser` `two resident trustees appointed after 1876` TRUE

-- the purchaser is not bound to see to the application, whether or not the money is later misapplied
#ASSERT NOT `the purchaser is bound to see to the application of the money` TRUE
#ASSERT NOT `the purchaser is bound to see to the application of the money` FALSE

