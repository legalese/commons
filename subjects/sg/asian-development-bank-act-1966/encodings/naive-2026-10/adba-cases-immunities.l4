#ASSERT `an action may be brought against the Bank` `a claim for personal injury on Bank premises` FALSE FALSE TRUE
#ASSERT NOT `an action may be brought against the Bank` `a claim on the Bank's borrowing` TRUE TRUE FALSE
#ASSERT NOT `an action may be brought against the Bank` `a claim on the Bank's borrowing` TRUE TRUE TRUE

