IMPORT prelude
IMPORT `ria-licensing`

-- Rubber Industry Act 1992, ss 2-4, 6, 7, 10-12, 20, 22-24 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_rubber-industry-act-1992.py). Expected results were written by
-- hand from the text.

`an unlicensed rubber dealer` MEANS Trader WITH
    `activity` IS `dealing in rubber`
    `holds a licence authorising the activity` IS FALSE
    `is employed by such a licensee` IS FALSE
    `holds a Malaysian rubber shipping licence` IS FALSE
    `reciprocal arrangements with Malaysia exist` IS FALSE
    `is exempted under s 28` IS FALSE

`a licensed rubber dealer` MEANS Trader WITH
    `activity` IS `dealing in rubber`
    `holds a licence authorising the activity` IS TRUE
    `is employed by such a licensee` IS FALSE
    `holds a Malaysian rubber shipping licence` IS FALSE
    `reciprocal arrangements with Malaysia exist` IS FALSE
    `is exempted under s 28` IS FALSE

`a packer's employee` MEANS Trader WITH
    `activity` IS `packing rubber for export`
    `holds a licence authorising the activity` IS FALSE
    `is employed by such a licensee` IS TRUE
    `holds a Malaysian rubber shipping licence` IS FALSE
    `reciprocal arrangements with Malaysia exist` IS FALSE
    `is exempted under s 28` IS FALSE

`a Malaysian-licensed shipper under reciprocity` MEANS Trader WITH
    `activity` IS `shipping rubber for export`
    `holds a licence authorising the activity` IS FALSE
    `is employed by such a licensee` IS FALSE
    `holds a Malaysian rubber shipping licence` IS TRUE
    `reciprocal arrangements with Malaysia exist` IS TRUE
    `is exempted under s 28` IS FALSE

`a Malaysian-licensed shipper without reciprocity` MEANS Trader WITH
    `activity` IS `shipping rubber for export`
    `holds a licence authorising the activity` IS FALSE
    `is employed by such a licensee` IS FALSE
    `holds a Malaysian rubber shipping licence` IS TRUE
    `reciprocal arrangements with Malaysia exist` IS FALSE
    `is exempted under s 28` IS FALSE

`a Malaysian licensee storing rubber` MEANS Trader WITH
    `activity` IS `storing rubber`
    `holds a licence authorising the activity` IS FALSE
    `is employed by such a licensee` IS FALSE
    `holds a Malaysian rubber shipping licence` IS TRUE
    `reciprocal arrangements with Malaysia exist` IS TRUE
    `is exempted under s 28` IS FALSE

`an exempted unlicensed treater` MEANS Trader WITH
    `activity` IS `treating rubber`
    `holds a licence authorising the activity` IS FALSE
    `is employed by such a licensee` IS FALSE
    `holds a Malaysian rubber shipping licence` IS FALSE
    `reciprocal arrangements with Malaysia exist` IS FALSE
    `is exempted under s 28` IS TRUE

`a clean company` MEANS Applicant WITH
    `produced satisfactory evidence of being fit and proper` IS TRUE
    `applicant or a managerial officer has a dishonesty conviction` IS FALSE
    `the Board considers refusal in the public interest` IS FALSE
    `is incorporated` IS TRUE
    `is registered under a business name` IS FALSE

`a company without evidence of fitness` MEANS Applicant WITH
    `produced satisfactory evidence of being fit and proper` IS FALSE
    `applicant or a managerial officer has a dishonesty conviction` IS FALSE
    `the Board considers refusal in the public interest` IS FALSE
    `is incorporated` IS TRUE
    `is registered under a business name` IS FALSE

`a company whose manager was convicted of fraud` MEANS Applicant WITH
    `produced satisfactory evidence of being fit and proper` IS TRUE
    `applicant or a managerial officer has a dishonesty conviction` IS TRUE
    `the Board considers refusal in the public interest` IS FALSE
    `is incorporated` IS TRUE
    `is registered under a business name` IS FALSE

`an unregistered sole trader` MEANS Applicant WITH
    `produced satisfactory evidence of being fit and proper` IS TRUE
    `applicant or a managerial officer has a dishonesty conviction` IS FALSE
    `the Board considers refusal in the public interest` IS FALSE
    `is incorporated` IS FALSE
    `is registered under a business name` IS FALSE

`a registered sole trader` MEANS Applicant WITH
    `produced satisfactory evidence of being fit and proper` IS TRUE
    `applicant or a managerial officer has a dishonesty conviction` IS FALSE
    `the Board considers refusal in the public interest` IS FALSE
    `is incorporated` IS FALSE
    `is registered under a business name` IS TRUE

§ `ss 2, 3 -- who needs a licence`

#ASSERT `the activity needs a licence` `packing rubber for export`
#ASSERT `the activity needs a licence` `shipping rubber for export`
#ASSERT `the activity needs a licence` `manufacturing technically specified rubber`
#ASSERT NOT `the activity needs a licence` `trading rubber futures contracts`
#ASSERT NOT `the activity needs a licence` `selling rubber gloves`

#ASSERT `the trader commits the s 3 offence` `an unlicensed rubber dealer`
#ASSERT NOT `the trader commits the s 3 offence` `a licensed rubber dealer`
#ASSERT NOT `the trader commits the s 3 offence` `a packer's employee`
#ASSERT NOT `the trader commits the s 3 offence` `a Malaysian-licensed shipper under reciprocity`
#ASSERT `the trader commits the s 3 offence` `a Malaysian-licensed shipper without reciprocity`
#ASSERT `the trader commits the s 3 offence` `a Malaysian licensee storing rubber`
#ASSERT NOT `the trader commits the s 3 offence` `an exempted unlicensed treater`

§ `s 4 -- mandatory refusal`

#ASSERT NOT `the licence cannot be granted` `a clean company`
#ASSERT `the licence cannot be granted` `a company without evidence of fitness`
#ASSERT `the licence cannot be granted` `a company whose manager was convicted of fraud`
#ASSERT `the licence cannot be granted` `an unregistered sole trader`
#ASSERT NOT `the licence cannot be granted` `a registered sole trader`

§ `s 6 -- renewal`

#ASSERT `the renewal application is in time` 1
#ASSERT NOT `the renewal application is in time` 0.5

#ASSERT NOT `the Board may refuse renewal` TRUE FALSE

§ `s 10 -- inspection`

#ASSERT `the premises are open to s 10 inspection` `packing rubber for export`
#ASSERT NOT `the premises are open to s 10 inspection` `shipping rubber for export`

§ `s 11 -- Board sanctions and stay`

#ASSERT `the Board may act under s 11` TRUE FALSE FALSE TRUE
#ASSERT NOT `the Board may act under s 11` FALSE TRUE FALSE TRUE
#ASSERT NOT `the Board may act under s 11` TRUE FALSE FALSE FALSE

#ASSERT `the amount is within s 11` `a Board fine` 25000
#ASSERT NOT `the amount is within s 11` `a Board fine` 25001
#ASSERT `the amount is within s 11` `a costs order` 5000
#ASSERT NOT `the amount is within s 11` `a costs order` 6000

#ASSERT NOT `the s 11 decision may be executed` 10 FALSE FALSE
#ASSERT `the s 11 decision may be executed` 15 FALSE FALSE
#ASSERT NOT `the s 11 decision may be executed` 30 TRUE FALSE

§ `ss 7, 12 -- appeals`

#ASSERT `the appeal lies to` `refusal of a licence` EQUALS `the Minister`
#ASSERT `the appeal lies to` `refusal to renew` EQUALS `the Minister`
#ASSERT `the appeal lies to` `revocation` EQUALS `the Appeal Tribunal`

#ASSERT `the appeal is in time` `refusal to renew` 20 TRUE FALSE
#ASSERT `the appeal is in time` `revocation` 14 TRUE FALSE
#ASSERT NOT `the appeal is in time` `revocation` 20 TRUE FALSE
#ASSERT `the appeal is in time` `revocation` 20 TRUE TRUE

§ `ss 3(3), 8, 10(3), 20, 23 -- penalties`

#ASSERT `the maximum fine` `operating without a licence` EQUALS 25000
#ASSERT `the maximum fine` `a false statement in an application` EQUALS 2000
#ASSERT `the maximum fine` `failing to produce books or rubber` EQUALS 5000
#ASSERT `the maximum fine` `an offence with no express penalty` EQUALS 5000

#ASSERT `the maximum imprisonment in months` `operating without a licence` EQUALS 24
#ASSERT `the maximum imprisonment in months` `a false statement in an application` EQUALS 6
#ASSERT `the maximum imprisonment in months` `an offence with no express penalty` EQUALS 3

#ASSERT `the offence may be compounded for the sum` TRUE 2000
#ASSERT NOT `the offence may be compounded for the sum` FALSE 1000

