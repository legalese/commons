IMPORT prelude
IMPORT `gsn-corporation`

-- Good Shepherd Nuns Ordinance 1958, ss 2-5 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_good-shepherd-nuns-ordinance-1958.py). Expected results were written by
-- hand from the text.

`the Reverend Mother Superior, appointed and gazetted` MEANS Claimant WITH
    `is for the time being in office` IS TRUE
    `is duly authorised and appointed` IS TRUE
    `appointment is notified in the Gazette` IS TRUE

`a newly appointed Mother Superior not yet gazetted` MEANS Claimant WITH
    `is for the time being in office` IS TRUE
    `is duly authorised and appointed` IS TRUE
    `appointment is notified in the Gazette` IS FALSE

`a Mother Superior gazetted though her appointment was irregular` MEANS Claimant WITH
    `is for the time being in office` IS TRUE
    `is duly authorised and appointed` IS FALSE
    `appointment is notified in the Gazette` IS TRUE

`a former Mother Superior whose appointment was gazetted` MEANS Claimant WITH
    `is for the time being in office` IS FALSE
    `is duly authorised and appointed` IS TRUE
    `appointment is notified in the Gazette` IS TRUE

`a nun exercising the office without appointment or notification` MEANS Claimant WITH
    `is for the time being in office` IS TRUE
    `is duly authorised and appointed` IS FALSE
    `appointment is notified in the Gazette` IS FALSE

`a lease sealed before and signed by the Mother Superior` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Reverend Mother Superior for the time being`
    `signed by` IS `the Reverend Mother Superior for the time being`

`a transfer sealed before and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney under a deposited power of attorney`
    `signed by` IS `an attorney under a deposited power of attorney`

`a mortgage sealed before the Mother Superior and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Reverend Mother Superior for the time being`
    `signed by` IS `an attorney under a deposited power of attorney`

`a conveyance sealed before and signed by an undeposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney whose power of attorney is not deposited`
    `signed by` IS `an attorney whose power of attorney is not deposited`

`a deed sealed before another nun and signed by the Mother Superior` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `another nun of the Congregation`
    `signed by` IS `the Reverend Mother Superior for the time being`

`a deed sealed before and signed by a former Mother Superior` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a former Reverend Mother Superior`
    `signed by` IS `a former Reverend Mother Superior`

`a document signed by the Mother Superior but never sealed` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS FALSE
    `sealed in the presence of` IS `the Reverend Mother Superior for the time being`
    `signed by` IS `the Reverend Mother Superior for the time being`

`a deed sealed before the Mother Superior but signed by nobody` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Reverend Mother Superior for the time being`
    `signed by` IS `nobody`

§ `ss 2(1) and 4`

#ASSERT `holds the office that is the Corporation` `the Reverend Mother Superior, appointed and gazetted`
#ASSERT `holds the office that is the Corporation` `a newly appointed Mother Superior not yet gazetted`
#ASSERT NOT `holds the office that is the Corporation` `a Mother Superior gazetted though her appointment was irregular`
#ASSERT NOT `holds the office that is the Corporation` `a former Mother Superior whose appointment was gazetted`
#ASSERT NOT `holds the office that is the Corporation` `a nun exercising the office without appointment or notification`

#ASSERT `authorisation is conclusively proved` `the Reverend Mother Superior, appointed and gazetted`
#ASSERT NOT `authorisation is conclusively proved` `a newly appointed Mother Superior not yet gazetted`
#ASSERT `authorisation is conclusively proved` `a Mother Superior gazetted though her appointment was irregular`
#ASSERT `authorisation is conclusively proved` `a former Mother Superior whose appointment was gazetted`
#ASSERT NOT `authorisation is conclusively proved` `a nun exercising the office without appointment or notification`

#ASSERT `is the office-holder on the evidence` `the Reverend Mother Superior, appointed and gazetted`
#ASSERT `is the office-holder on the evidence` `a newly appointed Mother Superior not yet gazetted`
#ASSERT `is the office-holder on the evidence` `a Mother Superior gazetted though her appointment was irregular`
#ASSERT NOT `is the office-holder on the evidence` `a former Mother Superior whose appointment was gazetted`
#ASSERT NOT `is the office-holder on the evidence` `a nun exercising the office without appointment or notification`

§ `s 2(2), (3)`

#ASSERT `the Ordinance empowers the Corporation to` `break, change or remake its corporate seal` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `acquire, purchase or take property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `hold and enjoy property` TRUE
#ASSERT `the Ordinance empowers the Corporation to` `sell property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `convey or assign property` TRUE
#ASSERT `the Ordinance empowers the Corporation to` `surrender and yield up property` TRUE
#ASSERT `the Ordinance empowers the Corporation to` `mortgage property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `mortgage property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `demise property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `transfer or otherwise dispose of property` FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sue in respect of its property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `be sued in respect of its property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `borrow money without security` TRUE

