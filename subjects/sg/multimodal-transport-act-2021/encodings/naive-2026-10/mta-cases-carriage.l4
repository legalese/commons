IMPORT prelude
IMPORT `mta-carriage`

-- Multimodal Transport Act 2021, ss 2 to 6, 11, 15, 17, 18, 20, 21, 23 to 26 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_multimodal-transport-act-2021.py). Expected results were written by
-- hand from the text.

`a Singapore freight forwarder` MEANS Applicant WITH
    `carries on or intends to carry on the business` IS TRUE
    `is a registered company` IS TRUE
    `has a registered business name` IS FALSE
    `has its principal place of business in Singapore` IS TRUE
    `has acceptable insurance or financial cover` IS TRUE
    `has the minimum assets or an equivalent guarantee` IS TRUE
    `meets the other prescribed requirements` IS TRUE

`a sole proprietor with a registered business name` MEANS Applicant WITH
    `carries on or intends to carry on the business` IS TRUE
    `is a registered company` IS FALSE
    `has a registered business name` IS TRUE
    `has its principal place of business in Singapore` IS TRUE
    `has acceptable insurance or financial cover` IS TRUE
    `has the minimum assets or an equivalent guarantee` IS TRUE
    `meets the other prescribed requirements` IS TRUE

`a Malaysian forwarder with no Singapore base` MEANS Applicant WITH
    `carries on or intends to carry on the business` IS TRUE
    `is a registered company` IS TRUE
    `has a registered business name` IS TRUE
    `has its principal place of business in Singapore` IS FALSE
    `has acceptable insurance or financial cover` IS TRUE
    `has the minimum assets or an equivalent guarantee` IS TRUE
    `meets the other prescribed requirements` IS TRUE

`a container dropped by a subcontracted trucker` MEANS Claim WITH
    `occurred during the period of responsibility` IS TRUE
    `is for delay` IS FALSE
    `delay interest declared and accepted` IS FALSE
    `operator proved all reasonable measures` IS FALSE
    `proven cause` IS `careless handling by a subcontracted trucker`
    `at sea or on an inland waterway` IS FALSE
    `caused by unseaworthiness` IS FALSE
    `operator proved due diligence on seaworthiness` IS FALSE

`cargo wetted by a navigation error at sea` MEANS Claim WITH
    `occurred during the period of responsibility` IS TRUE
    `is for delay` IS FALSE
    `delay interest declared and accepted` IS FALSE
    `operator proved all reasonable measures` IS FALSE
    `proven cause` IS `a navigation error by the master`
    `at sea or on an inland waterway` IS TRUE
    `caused by unseaworthiness` IS FALSE
    `operator proved due diligence on seaworthiness` IS FALSE

`a late delivery with no declaration` MEANS Claim WITH
    `occurred during the period of responsibility` IS TRUE
    `is for delay` IS TRUE
    `delay interest declared and accepted` IS FALSE
    `operator proved all reasonable measures` IS FALSE
    `proven cause` IS `no proven cause`
    `at sea or on an inland waterway` IS FALSE
    `caused by unseaworthiness` IS FALSE
    `operator proved due diligence on seaworthiness` IS FALSE

`a late delivery with an accepted declaration` MEANS Claim WITH
    `occurred during the period of responsibility` IS TRUE
    `is for delay` IS TRUE
    `delay interest declared and accepted` IS TRUE
    `operator proved all reasonable measures` IS FALSE
    `proven cause` IS `no proven cause`
    `at sea or on an inland waterway` IS FALSE
    `caused by unseaworthiness` IS FALSE
    `operator proved due diligence on seaworthiness` IS FALSE

`a loss from an unseaworthy ship despite due diligence` MEANS Claim WITH
    `occurred during the period of responsibility` IS TRUE
    `is for delay` IS FALSE
    `delay interest declared and accepted` IS FALSE
    `operator proved all reasonable measures` IS FALSE
    `proven cause` IS `no proven cause`
    `at sea or on an inland waterway` IS TRUE
    `caused by unseaworthiness` IS TRUE
    `operator proved due diligence on seaworthiness` IS TRUE

§ `ss 2 and 3`

#ASSERT `the carriage is international multimodal transport` 2 TRUE
#ASSERT NOT `the carriage is international multimodal transport` 1 TRUE

#ASSERT `Parts 3 to 6 apply to the claim` TRUE TRUE FALSE
#ASSERT `Parts 3 to 6 apply to the claim` TRUE FALSE TRUE
#ASSERT NOT `Parts 3 to 6 apply to the claim` TRUE FALSE FALSE

§ `ss 4 to 6`

#ASSERT `the body may issue a registration certificate` `a Singapore freight forwarder`
#ASSERT `the body may issue a registration certificate` `a sole proprietor with a registered business name`
#ASSERT NOT `the body may issue a registration certificate` `a Malaysian forwarder with no Singapore base`

#ASSERT NOT `the renewal is treated as a fresh application` 3
#ASSERT `the renewal is treated as a fresh application` 2

#ASSERT NOT `the cancellation notice allows enough time` 21

#ASSERT `the last day to appeal the cancellation` 10 FALSE 0 EQUALS 24
#ASSERT `the last day to appeal the cancellation` 10 TRUE 30 EQUALS 44

§ `s 11`

#ASSERT `the description of the goods is conclusive against the operator` FALSE TRUE TRUE TRUE
#ASSERT NOT `the description of the goods is conclusive against the operator` TRUE TRUE TRUE TRUE

§ `s 15`

#ASSERT `the cause is an excepted cause` `a navigation error by the master` TRUE
#ASSERT NOT `the cause is an excepted cause` `a navigation error by the master` FALSE
#ASSERT NOT `the cause is an excepted cause` `a fire not caused by the carrier's fault` FALSE
#ASSERT NOT `the cause is an excepted cause` `careless handling by a subcontracted trucker` FALSE

#ASSERT `the operator is liable` `a container dropped by a subcontracted trucker`
#ASSERT NOT `the operator is liable` `cargo wetted by a navigation error at sea`
#ASSERT NOT `the operator is liable` `a late delivery with no declaration`
#ASSERT `the operator is liable` `a late delivery with an accepted declaration`
#ASSERT NOT `the operator is liable` `a loss from an unseaworthy ship despite due diligence`

#ASSERT `the goods may be treated as lost` FALSE 91
#ASSERT NOT `the goods may be treated as lost` FALSE 90

§ `ss 2(3), 17, 18, 20, 21, 23`

#ASSERT `the packages counted` 0 EQUALS 1
#ASSERT `the packages counted` 20 EQUALS 20

#ASSERT `the limit for goods lost or damaged` 3 1000 TRUE EQUALS 2000.01
#ASSERT `the limit for goods lost or damaged` 1 5000 TRUE EQUALS 10000
#ASSERT `the limit for goods lost or damaged` 1 1000 FALSE EQUALS 8330

#ASSERT `the compensation for loss or damage` 50000 1 1000 TRUE FALSE FALSE EQUALS 2000
#ASSERT `the compensation for loss or damage` 50000 1 1000 TRUE TRUE FALSE EQUALS 50000
#ASSERT `the compensation for loss or damage` 50000 1 1000 FALSE TRUE FALSE EQUALS 8330
#ASSERT `the compensation for loss or damage` 50000 1 1000 FALSE FALSE TRUE EQUALS 50000

#ASSERT `the compensation for delay` 5000 1200 FALSE FALSE EQUALS 0
#ASSERT `the compensation for delay` 5000 1200 TRUE FALSE EQUALS 1200

#ASSERT `the aggregate compensation` 2000 1200 2500 FALSE EQUALS 2500
#ASSERT `the aggregate compensation` 2000 1200 2500 TRUE EQUALS 3200

#ASSERT `the operator loses its limit` `the operator itself` TRUE
#ASSERT NOT `the operator loses its limit` `a servant or agent of the operator` TRUE

§ `s 24`

#ASSERT `the consignor is liable for dangerous-goods losses` FALSE FALSE
#ASSERT NOT `the consignor is liable for dangerous-goods losses` TRUE FALSE

#ASSERT `the goods may be destroyed without compensation` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT `the goods may be destroyed without compensation` TRUE FALSE FALSE FALSE FALSE
#ASSERT `the goods may be destroyed without compensation` TRUE FALSE TRUE FALSE FALSE

