§ `s 2`

#ASSERT `is a boy scout` `a scout selling spare badges to another scout`
#ASSERT `is a boy scout` `a scout wearing his own badges in public`
#ASSERT `is a boy scout` `an officer of the Association wearing the badge`
#ASSERT NOT `is a boy scout` `a former scout wearing his old badge to look like a scout`
#ASSERT NOT `is a boy scout` `an adult posing as a scout in uniform with badges`
#ASSERT NOT `is a boy scout` `the Association selling badges at its scout shop`

§ `s 3`

#ASSERT NOT `contravenes s 3` `the Association selling badges at its scout shop`
#ASSERT `contravenes s 3` `a trader selling scout badges at a market stall`
#ASSERT `contravenes s 3` `a scout selling spare badges to another scout`
#ASSERT `contravenes s 3` `a collector selling an old scout badge online`
#ASSERT NOT `contravenes s 3` `a trader selling a lookalike badge`

§ `s 4`

#ASSERT `contravenes s 4` `an adult posing as a scout in uniform with badges`
#ASSERT NOT `contravenes s 4` `a scout wearing his own badges in public`
#ASSERT NOT `contravenes s 4` `an officer of the Association wearing the badge`
#ASSERT `contravenes s 4` `a former scout wearing his old badge to look like a scout`
#ASSERT NOT `contravenes s 4` `a non-scout wearing a badge at home`
#ASSERT NOT `contravenes s 4` `a collector displaying badges at a public exhibition`
#ASSERT NOT `contravenes s 4` `a non-scout wearing a lookalike badge to pass as a scout`
#ASSERT `contravenes s 4` `a non-scout using a badge to claim authority`

§ `s 5`

#ASSERT `contravenes s 5` `a scout using his badge to order people off a road`
#ASSERT NOT `contravenes s 5` `a scout marshal acting as the rules authorise`
#ASSERT `contravenes s 5` `an officer using a lookalike badge to demand entry`
#ASSERT NOT `contravenes s 5` `a non-scout using a badge to claim authority`
#ASSERT NOT `contravenes s 5` `a scout wearing his own badges in public`

§ `s 6`

#ASSERT `contravenes s 6` `an organiser of an unauthorised boy scouts troop`
#ASSERT `contravenes s 6` `a volunteer helping run the unauthorised troop`
#ASSERT NOT `contravenes s 6` `a leader of an authorised scout group`
#ASSERT NOT `contravenes s 6` `an organiser of an outdoor club not calling itself scouts`

§ `s 7`

#ASSERT NOT `commits an offence under s 7` `the Association selling badges at its scout shop`
#ASSERT `commits an offence under s 7` `a trader selling scout badges at a market stall`
#ASSERT `commits an offence under s 7` `an adult posing as a scout in uniform with badges`
#ASSERT NOT `commits an offence under s 7` `a scout wearing his own badges in public`
#ASSERT NOT `commits an offence under s 7` `a non-scout wearing a lookalike badge to pass as a scout`
#ASSERT `commits an offence under s 7` `a scout using his badge to order people off a road`
#ASSERT `commits an offence under s 7` `a non-scout using a badge to claim authority`
#ASSERT `commits an offence under s 7` `an organiser of an unauthorised boy scouts troop`
#ASSERT NOT `commits an offence under s 7` `a leader of an authorised scout group`

#ASSERT `the maximum fine` `a trader selling scout badges at a market stall` EQUALS 200
#ASSERT `the maximum fine` `a scout wearing his own badges in public` EQUALS 0
