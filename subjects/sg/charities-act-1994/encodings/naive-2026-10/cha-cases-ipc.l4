IMPORT prelude
IMPORT `cha-ipc`

-- Charities Act 1994, ss 40, 41, 42, 49 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved; the IPC approval criteria live in regulations).
--
-- Expected results were written by hand from the text.

§ `REQ-0292 (Haziq scenario h072)`

-- A newly registered charity that has not applied for, or been given, IPC approval is not an IPC, so donations to it cannot
-- come within Income Tax Act s 37(3)(c)(ii).
#ASSERT NOT `the institution is an IPC` `a registered charity` FALSE `no one` FALSE
#ASSERT NOT `donations to it can be within Income Tax Act s 37(3)(c)(ii)` `a registered charity` FALSE `no one` FALSE

-- It becomes one when, on its own application, the Minister, the Commissioner or a Sector Administrator approves it.
#ASSERT `the institution is an IPC` `a registered charity` TRUE `the Commissioner` FALSE
#ASSERT `the institution is an IPC` `a registered charity` TRUE `a Sector Administrator` FALSE
#ASSERT `the institution is an IPC` `a registered charity` TRUE `the Minister` FALSE
#ASSERT `donations to it can be within Income Tax Act s 37(3)(c)(ii)` `a registered charity` TRUE `the Commissioner` FALSE

-- The conditions of approval are not in the Act.
#ASSERT `where the conditions for IPC approval are set` EQUALS "in regulations made by the Minister under s 42(1)(a); the Act itself sets none"

§ `s 40 -- who may approve, and who may be approved`

#ASSERT `is an approving authority under section 40` `the Minister`
#ASSERT `is an approving authority under section 40` `the Commissioner`
#ASSERT `is an approving authority under section 40` `a Sector Administrator`
#ASSERT NOT `is an approving authority under section 40` `the Comptroller of Income Tax`
#ASSERT NOT `is an approving authority under section 40` `no one`

-- Approval by someone s 40 does not name does not make an IPC.
#ASSERT NOT `the institution is an IPC` `a registered charity` TRUE `the Comptroller of Income Tax` FALSE

-- "on the application of the charity": an approval without an application does not satisfy (a).
#ASSERT NOT `the institution is an IPC` `a registered charity` FALSE `the Commissioner` FALSE

-- An exempt charity may be an IPC; an unregistered charity or a non-charity may not, even if approved.
#ASSERT `the institution is an IPC` `an exempt charity` TRUE `the Commissioner` FALSE
#ASSERT NOT `the institution is an IPC` `an unregistered charity` TRUE `the Commissioner` FALSE
#ASSERT NOT `the institution is an IPC` `not a charity` TRUE `the Minister` FALSE

-- (b) deemed under any written law, without an application.
#ASSERT `the institution is an IPC` `a registered charity` FALSE `no one` TRUE
#ASSERT NOT `the institution is an IPC` `an unregistered charity` FALSE `no one` TRUE

§ `s 41 -- a Sector Administrator approves only within its appointment`

#ASSERT `the Sector Administrator may approve this charity as an IPC` TRUE TRUE
#ASSERT NOT `the Sector Administrator may approve this charity as an IPC` TRUE FALSE
#ASSERT NOT `the Sector Administrator may approve this charity as an IPC` FALSE TRUE

§ `s 42(1)(e) -- delegation to Sector Administrators`

#ASSERT NOT `the Commissioner's powers under the section may be delegated to a Sector Administrator` 22
#ASSERT NOT `the Commissioner's powers under the section may be delegated to a Sector Administrator` 27
#ASSERT NOT `the Commissioner's powers under the section may be delegated to a Sector Administrator` 31
#ASSERT `the Commissioner's powers under the section may be delegated to a Sector Administrator` 25
#ASSERT `the Commissioner's powers under the section may be delegated to a Sector Administrator` 13

§ `s 42(2) -- consequences of contravening the IPC regulations`

#ASSERT `the IPC approval may be revoked under section 42(2)(a)` `a registered charity` TRUE
#ASSERT NOT `the IPC approval may be revoked under section 42(2)(a)` `a registered charity` FALSE

#ASSERT `the maximum fine for an IPC offence` 0 EQUALS 10000
#ASSERT `the maximum fine for an IPC offence` 30 EQUALS 13000
#ASSERT `the maximum imprisonment in years for an IPC offence` EQUALS 3

-- (c): the higher of $100 and 0.4 x the donations wrongly receipted.
#ASSERT `the tax deduction receipt penalty` 0 EQUALS 100
#ASSERT `the tax deduction receipt penalty` 200 EQUALS 100
#ASSERT `the tax deduction receipt penalty` 250 EQUALS 100
#ASSERT `the tax deduction receipt penalty` 10000 EQUALS 4000

-- (4), (5): net of remission, into the Consolidated Fund.
#ASSERT `the amount paid into the Consolidated Fund` 10000 1000 EQUALS 3000
#ASSERT `the amount paid into the Consolidated Fund` 10000 5000 EQUALS 0
#ASSERT `the amount paid into the Consolidated Fund` 0 0 EQUALS 100

-- (7)
#ASSERT `the Minister may revoke the Sector Administrator's appointment` TRUE

§ `s 49 -- holding out as an IPC`

#ASSERT `the institution commits the s 49 offence` TRUE FALSE
#ASSERT NOT `the institution commits the s 49 offence` TRUE TRUE
#ASSERT `the person commits the s 49 offence` TRUE FALSE TRUE FALSE
#ASSERT NOT `the person commits the s 49 offence` TRUE FALSE TRUE TRUE
#ASSERT NOT `the person commits the s 49 offence` TRUE TRUE TRUE FALSE
