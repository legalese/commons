IMPORT prelude
IMPORT `kws-transfer`

-- The Kwong-Wai-Shiu Free Hospital (Transfer of Undertaking and Dissolution) Act 2017, ss 2, 3, 4, 5 and 6 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_the-kwong-wai-shiu-free-hospital-transfer-of-undertaking-and-dissolution-act-2017.py). Expected results were written by
-- hand from the text.

§ `ss 2, 3(1) and 5 -- what passes`

#ASSERT `the property passes to the successor company` `land or an interest in land` TRUE TRUE
#ASSERT NOT `the property passes to the successor company` `land or an interest in land` TRUE FALSE
#ASSERT `the property passes to the successor company` `money or securities` TRUE TRUE
#ASSERT NOT `the property passes to the successor company` `money or securities` TRUE FALSE
#ASSERT `the property passes to the successor company` `a chose in action` TRUE TRUE
#ASSERT NOT `the property passes to the successor company` `plant or equipment` TRUE FALSE
#ASSERT `the property passes to the successor company` `intellectual property` TRUE TRUE
#ASSERT `the property passes to the successor company` `a licence or permit` TRUE TRUE
#ASSERT `the property passes to the successor company` `records` TRUE FALSE
#ASSERT `the property passes to the successor company` `records` TRUE TRUE
#ASSERT NOT `the property passes to the successor company` `records` FALSE TRUE
#ASSERT NOT `the property passes to the successor company` `money or securities` FALSE TRUE

#ASSERT `the liability passes to the successor company` TRUE
#ASSERT NOT `the liability passes to the successor company` FALSE

#ASSERT NOT `a further conveyance or assignment is needed` TRUE
#ASSERT `a further conveyance or assignment is needed` FALSE

§ `s 3(2) -- who answers`

#ASSERT `the party to sue or enforce against` TRUE FALSE EQUALS `the transferor`
#ASSERT `the party to sue or enforce against` FALSE FALSE EQUALS `the transferor`
#ASSERT `the party to sue or enforce against` TRUE TRUE EQUALS `the successor company`
#ASSERT `the party to sue or enforce against` FALSE TRUE EQUALS `not decided by this Act`

§ `s 3(3), (4) -- what the transfer does not do`

#ASSERT NOT `the counterparty may rely on the response` `terminate the agreement` TRUE
#ASSERT NOT `the counterparty may rely on the response` `treat the transfer as a breach of an anti-assignment clause` TRUE
#ASSERT NOT `the counterparty may rely on the response` `treat the transfer as a breach of confidence` TRUE
#ASSERT NOT `the counterparty may rely on the response` `call an event of default` TRUE
#ASSERT NOT `the counterparty may rely on the response` `treat the contract as void or unenforceable` TRUE
#ASSERT NOT `the counterparty may rely on the response` `treat the contract as frustrated` TRUE
#ASSERT NOT `the counterparty may rely on the response` `claim the guarantor is released` TRUE
#ASSERT NOT `the counterparty may rely on the response` `insist the lessee attorn to the successor company` TRUE
#ASSERT `the counterparty may rely on the response` `terminate the agreement` FALSE
#ASSERT `the counterparty may rely on the response` `call an event of default` FALSE

§ `s 3(5) -- registration`

#ASSERT `the Registrar must register the transfer` TRUE TRUE TRUE
#ASSERT NOT `the Registrar must register the transfer` TRUE FALSE TRUE
#ASSERT NOT `the Registrar must register the transfer` FALSE TRUE TRUE
#ASSERT NOT `the Registrar must register the transfer` TRUE TRUE FALSE

§ `s 4 -- trustees and committee members`

#ASSERT `still holds office as trustee or committee member` TRUE FALSE
#ASSERT NOT `still holds office as trustee or committee member` TRUE TRUE

#ASSERT NOT `the former trustee is entitled to a payment` FALSE
#ASSERT `the former trustee is entitled to a payment` TRUE

§ `s 6 -- disputes`

#ASSERT `the Minister may determine the dispute` `whether an asset, liability or record was transferred`
#ASSERT `the Minister may determine the dispute` `whether a contract or document relates to a transferred item`
#ASSERT NOT `the Minister may determine the dispute` `whether a debt is owed at all`

#ASSERT `the Act makes the determination binding on` `the successor company itself`
#ASSERT NOT `the Act makes the determination binding on` `a creditor, debtor or counterparty`

