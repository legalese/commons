#ASSERT NOT `Is the carrier liable to me` `the Warsaw Convention` `bag damaged by negligent pilotage`
#ASSERT `Is the carrier liable to me` `the Warsaw (Hague) Convention` `bag damaged by negligent pilotage`
#ASSERT `Is the carrier liable to me` `the Warsaw (Hague) (Montreal) Convention` `flight delayed`

#ASSERT `If I die, does the accident count as a wrongful act for a fatal accidents claim` `the Warsaw (Hague) Convention` `hurt in turbulence`
#ASSERT NOT `If I die, does the accident count as a wrongful act for a fatal accidents claim` `the Warsaw (Hague) Convention` `hurt in the terminal shop`

§ `Article 21 and s 9`

#ASSERT `Can my own negligence reduce what I recover` TRUE EQUALS `the court may relieve the carrier wholly or partly`
#ASSERT `Can my own negligence reduce what I recover` FALSE EQUALS `no reduction on this ground`

§ `Articles 3, 4, 22 and 25`

#ASSERT `What is the most I can recover` `injury, 1929 text` EQUALS `limited to francs` 125000
#ASSERT `What is the most I can recover` `injury, Hague text` EQUALS `limited to francs` 250000
#ASSERT `What is the most I can recover` `injury, Hague, higher limit by contract` EQUALS `limited to francs` 400000
#ASSERT `What is the most I can recover` `injury, Hague, boarded without ticket` EQUALS `no Convention limit applies`
#ASSERT `What is the most I can recover` `injury, Hague, ticket lacks notice` EQUALS `no Convention limit applies`
#ASSERT `What is the most I can recover` `injury, 1929, ticket lacks statement only` EQUALS `limited to francs` 125000
#ASSERT `What is the most I can recover` `injury, Hague, wilful misconduct only` EQUALS `limited to francs` 250000
#ASSERT `What is the most I can recover` `injury, Montreal, recklessness` EQUALS `no Convention limit applies`
#ASSERT `What is the most I can recover` `bags 20kg plus 10kg affected, Hague` EQUALS `limited to francs` 7500
#ASSERT `What is the most I can recover` `bags 20kg plus 10kg affected, 1929` EQUALS `not covered by this encoding`
#ASSERT `What is the most I can recover` `bags 20kg, 1929, no ticket number on check` EQUALS `no Convention limit applies`
#ASSERT `What is the most I can recover` `bags 20kg, Hague, no ticket number on check` EQUALS `limited to francs` 5000
#ASSERT `What is the most I can recover` `bags, Montreal, ticket lacks notice` EQUALS `no Convention limit applies`
#ASSERT `What is the most I can recover` `bags declared at 9000, actual 6000 proved` EQUALS `limited to francs` 6000
#ASSERT `What is the most I can recover` `cabin bag, 1929` EQUALS `limited to francs` 5000

§ `s 6(1)`

#ASSERT `What is the most I can still recover in these proceedings` `injury, Hague text` 100000 EQUALS `limited to francs` 150000
#ASSERT `What is the most I can still recover in these proceedings` `injury, 1929 text` 200000 EQUALS `limited to francs` 0
#ASSERT `What is the most I can still recover in these proceedings` `bags 20kg plus 10kg affected, Hague` 1000 EQUALS `not covered by this encoding`

§ `Article 22(4)`

#ASSERT `Can I recover my costs on top of the limit` `the Warsaw (Hague) Convention` 50000 TRUE 60000 EQUALS `Article 22(4) gives no costs on top of the limit`
#ASSERT `Can I recover my costs on top of the limit` `the Warsaw (Hague) (Montreal) Convention` 70000 TRUE 60000 EQUALS `the court may award my costs on top of the limit`
#ASSERT `Can I recover my costs on top of the limit` `the Warsaw Convention` 50000 TRUE 60000 EQUALS `this text has no costs rule`

§ `Article 23`

#ASSERT `Is the clause in my contract void` FALSE TRUE
#ASSERT NOT `Is the clause in my contract void` FALSE FALSE

§ `Article 25A`

#ASSERT `Can the employee I sue rely on the carrier's limits` `the Warsaw (Hague) Convention` TRUE FALSE
#ASSERT NOT `Can the employee I sue rely on the carrier's limits` `the Warsaw Convention` TRUE FALSE

§ `Article 26 and s 7`

#ASSERT `What is the last day I may complain` `the Warsaw Convention` `my bags were damaged` EQUALS JUST 3
#ASSERT `What is the last day I may complain` `the Warsaw (Hague) (Montreal) Convention` `my bags arrived late` EQUALS JUST 21
#ASSERT `What is the last day I may complain` `the Warsaw (Hague) Convention` `my bags never arrived` EQUALS NOTHING

#ASSERT `Is my baggage claim barred for want of complaint` `the Warsaw (Hague) Convention` `my bags were damaged` TRUE 7 TRUE FALSE EQUALS `my complaint was in time`
#ASSERT `Is my baggage claim barred for want of complaint` `the Warsaw (Hague) Convention` `my bags were damaged` TRUE 8 TRUE FALSE EQUALS `no action lies for want of complaint`
#ASSERT `Is my baggage claim barred for want of complaint` `the Warsaw Convention` `my bags were damaged` TRUE 5 TRUE FALSE EQUALS `no action lies for want of complaint`
#ASSERT `Is my baggage claim barred for want of complaint` `the Warsaw (Hague) Convention` `my bags were damaged` FALSE 30 FALSE TRUE EQUALS `my complaint was in time`
#ASSERT `Is my baggage claim barred for want of complaint` `the Warsaw (Hague) Convention` `my bags never arrived` FALSE 0 FALSE FALSE EQUALS `Article 26 sets no complaint period`

§ `Article 29 and s 8`

#ASSERT `Is my action out of time` `the carrier` (Date 10 3 2024) (Date 10 3 2026) EQUALS `my action is in time`
#ASSERT `Is my action out of time` `the carrier` (Date 10 3 2024) (Date 11 3 2026) EQUALS `my right to damages is extinguished`
#ASSERT `Is my action out of time` `the carrier's employee or agent acting in the scope of employment` (Date 10 3 2024) (Date 1 4 2026) EQUALS `my right to damages is extinguished`

§ `Article 28`

#ASSERT `Can I sue the carrier in this court` `Singapore, my destination`
#ASSERT NOT `Can I sue the carrier in this court` `where I happen to live`
#ASSERT NOT `Can I sue the carrier in this court` `carrier's home court outside the system`

§ `Article 30`

#ASSERT `Can I sue this carrier` `I was killed or injured` `the carrier who flew the leg where it happened` FALSE
#ASSERT NOT `Can I sue this carrier` `I was killed or injured` `the first carrier` FALSE
#ASSERT `Can I sue this carrier` `I was delayed` `the first carrier` TRUE
#ASSERT `Can I sue this carrier` `my checked baggage was destroyed, lost or damaged` `the last carrier` FALSE

