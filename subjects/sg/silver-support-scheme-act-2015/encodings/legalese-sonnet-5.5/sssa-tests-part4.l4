#ASSERT `s 16(4) the officer or member is guilty of the offence as well as the unincorporated association` `an unincorporated association other than a partnership` TRUE NOTHING FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 16(4) the officer or member is guilty of the offence as well as the unincorporated association` `an unincorporated association other than a partnership` TRUE (JUST TRUE) FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 16(4) the officer or member is guilty of the offence as well as the unincorporated association` `an unincorporated association other than a partnership` FALSE (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 16(4) the officer or member is guilty of the offence as well as the unincorporated association` `a partnership` TRUE (JUST TRUE) FALSE TRUE TRUE EQUALS NOTHING

§§ `s 17 composition of offences`
-- inputs: who compounds, the offence is prescribed as compoundable (MAYBE), the person is reasonably suspected
#ASSERT `s 17(1) the Board or its authorised officer or employee may compound the offence` `the Board` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 17(1) the Board or its authorised officer or employee may compound the offence` `an officer or employee of the Board who is authorised by the Board in writing` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 17(1) the Board or its authorised officer or employee may compound the offence` `an officer or employee of the Board who is not authorised by the Board in writing` (JUST TRUE) TRUE EQUALS NOTHING
