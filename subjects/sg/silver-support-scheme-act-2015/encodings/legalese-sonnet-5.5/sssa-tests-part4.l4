#ASSERT `s 16(3) the partner is guilty of the offence as well as the partnership` `a partnership` TRUE NOTHING TRUE FALSE EQUALS NOTHING
#ASSERT `s 16(3) the partner is guilty of the offence as well as the partnership` `a partnership` TRUE (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 16(3) the partner is guilty of the offence as well as the partnership` `a partnership` FALSE (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 16(3) the partner is guilty of the offence as well as the partnership` `an ordinary body corporate` TRUE (JUST TRUE) TRUE TRUE EQUALS NOTHING

