§§ `s 14(2) documents kept in electronic form`
#ASSERT `s 14(2)(a) the power to require production includes the power to require it in legible form` `the Commissioner` `to produce a document or record for inspection` TRUE EQUALS JUST TRUE
#ASSERT `s 14(2)(a) the power to require production includes the power to require it in legible form` `an investigator as requirer` `to produce a document or record for inspection` TRUE EQUALS JUST TRUE
#ASSERT `s 14(2)(a) the power to require production includes the power to require it in legible form` `someone else as requirer` `to produce a document or record for inspection` TRUE EQUALS NOTHING
#ASSERT `s 14(2)(a) the power to require production includes the power to require it in legible form` `the Commissioner` `to produce a document or record for inspection` FALSE EQUALS NOTHING
#ASSERT `s 14(2)(a) the power to require production includes the power to require it in legible form` `the Commissioner` `to provide information within the person's knowledge` TRUE EQUALS NOTHING
#ASSERT `s 14(2)(a) the power to require production includes the power to require it in legible form` `the Commissioner` `to attend, answer a question or give a signed statement` TRUE EQUALS NOTHING
#ASSERT `s 14(2)(a) the power to require production includes the power to require it in legible form` `the Commissioner` `to allow the original of a document or record to be retained, or copies made` TRUE EQUALS NOTHING
#ASSERT `s 14(2)(b) section 14(1)(c) applies to the copy` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 14(2)(b) section 14(1)(c) applies to the copy` TRUE FALSE EQUALS NOTHING
#ASSERT `s 14(2)(b) section 14(1)(c) applies to the copy` FALSE TRUE EQUALS NOTHING
#ASSERT `s 14(2)(b) section 14(1)(c) applies to the copy` FALSE FALSE EQUALS NOTHING

§§ `s 14(3) copies are admissible`
-- inputs: made under s 14(1)(c), certifier, proceedings under this Act
#ASSERT `s 14(3) the copy or extract is admissible as evidence` TRUE `the Commissioner` TRUE EQUALS JUST TRUE
#ASSERT `s 14(3) the copy or extract is admissible as evidence` TRUE `an investigator as requirer` TRUE EQUALS JUST TRUE
#ASSERT `s 14(3) the copy or extract is admissible as evidence` TRUE `someone else as requirer` TRUE EQUALS NOTHING
#ASSERT `s 14(3) the copy or extract is admissible as evidence` FALSE `the Commissioner` TRUE EQUALS NOTHING
#ASSERT `s 14(3) the copy or extract is admissible as evidence` TRUE `the Commissioner` FALSE EQUALS NOTHING

§§ `s 14(4) failing to provide information or produce a document in time`
-- the time allowed (7 days is a stand-in): the day before, the last day, the day after
#ASSERT `s 14(4) the person is within the time allowed` 7 0 EQUALS JUST TRUE
#ASSERT `s 14(4) the person is within the time allowed` 7 6 EQUALS JUST TRUE
#ASSERT `s 14(4) the person is within the time allowed` 7 7 EQUALS JUST TRUE
#ASSERT `s 14(4) the person is within the time allowed` 7 8 EQUALS JUST FALSE
#ASSERT `s 14(4) the person is within the time allowed` 7 30 EQUALS JUST FALSE
-- inputs: requirer, requirement made under s 14(1)(b), the person refused, days allowed, days counted, reasonable excuse
-- the day before the time runs out: in time
#ASSERT `s 14(4) the person is guilty of an offence` `the Commissioner` TRUE FALSE 7 6 FALSE EQUALS NOTHING
-- the last day allowed: in time (FORK F-4)
#ASSERT `s 14(4) the person is guilty of an offence` `the Commissioner` TRUE FALSE 7 7 FALSE EQUALS NOTHING
-- the day after: out of time
#ASSERT `s 14(4) the person is guilty of an offence` `the Commissioner` TRUE FALSE 7 8 FALSE EQUALS JUST TRUE
-- an investigator, out of time
#ASSERT `s 14(4) the person is guilty of an offence` `an investigator as requirer` TRUE FALSE 7 8 FALSE EQUALS JUST TRUE
-- refused, though within the time
#ASSERT `s 14(4) the person is guilty of an offence` `the Commissioner` TRUE TRUE 7 1 FALSE EQUALS JUST TRUE
-- out of time, with reasonable excuse
#ASSERT `s 14(4) the person is guilty of an offence` `the Commissioner` TRUE FALSE 7 8 TRUE EQUALS NOTHING
-- refused, with reasonable excuse
#ASSERT `s 14(4) the person is guilty of an offence` `the Commissioner` TRUE TRUE 7 8 TRUE EQUALS NOTHING
-- the requirement was not made under s 14(1)(b)
#ASSERT `s 14(4) the person is guilty of an offence` `the Commissioner` FALSE FALSE 7 8 FALSE EQUALS NOTHING
-- someone else required it
#ASSERT `s 14(4) the person is guilty of an offence` `someone else as requirer` TRUE FALSE 7 8 FALSE EQUALS NOTHING
-- fields:                                greatest fine in dollars, greatest imprisonment in months
#ASSERT `s 14(4) the greatest penalty` EQUALS Penalty OF 10000, 6
#ASSERT `s 14(4) the sentence is within the greatest penalty` 10000 6 EQUALS JUST TRUE
#ASSERT `s 14(4) the sentence is within the greatest penalty` 10001 6 EQUALS JUST FALSE
#ASSERT `s 14(4) the sentence is within the greatest penalty` 10000 7 EQUALS JUST FALSE
#ASSERT `s 14(4) the sentence is within the greatest penalty` 0 0 EQUALS JUST TRUE

§§ `s 15 obstructing the Commissioner or an investigator`
-- inputs: who was obstructed, obstructs, hinders or impedes in the performance of a duty under the Act, reasonable excuse
#ASSERT `s 15 the person is guilty of an offence` `the Commissioner` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 15 the person is guilty of an offence` `an investigator as requirer` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 15 the person is guilty of an offence` `someone else as requirer` TRUE FALSE EQUALS NOTHING
#ASSERT `s 15 the person is guilty of an offence` `the Commissioner` FALSE FALSE EQUALS NOTHING
#ASSERT `s 15 the person is guilty of an offence` `the Commissioner` TRUE TRUE EQUALS NOTHING
#ASSERT `s 15 the person is guilty of an offence` `an investigator as requirer` TRUE TRUE EQUALS NOTHING
#ASSERT `s 15 the greatest penalty` EQUALS Penalty OF 20000, 12
#ASSERT `s 15 the sentence is within the greatest penalty` 20000 12 EQUALS JUST TRUE
#ASSERT `s 15 the sentence is within the greatest penalty` 20001 12 EQUALS JUST FALSE
#ASSERT `s 15 the sentence is within the greatest penalty` 20000 13 EQUALS JUST FALSE

§§ `The offences of the Act together`
-- fields:                                                                                        greatest fine in dollars, greatest imprisonment in months
#ASSERT `ss 8(6), 9(7), 11(1), 14(4) and 15 the greatest penalty for the offence` `the offence in section 8(6)` EQUALS Penalty OF 5000, 12
#ASSERT `ss 8(6), 9(7), 11(1), 14(4) and 15 the greatest penalty for the offence` `the offence in section 9(7)` EQUALS Penalty OF 5000, 12
#ASSERT `ss 8(6), 9(7), 11(1), 14(4) and 15 the greatest penalty for the offence` `the offence in section 11(1)` EQUALS Penalty OF 5000, 12
#ASSERT `ss 8(6), 9(7), 11(1), 14(4) and 15 the greatest penalty for the offence` `the offence in section 14(4)` EQUALS Penalty OF 10000, 6
#ASSERT `ss 8(6), 9(7), 11(1), 14(4) and 15 the greatest penalty for the offence` `the offence in section 15` EQUALS Penalty OF 20000, 12

§§ `s 16(5) definitions`
#ASSERT `s 16(5) the entity is a body corporate` `an ordinary body corporate` EQUALS JUST TRUE
#ASSERT `s 16(5) the entity is a body corporate` `a limited liability partnership as defined in section 2(1) of the Limited Liability Partnerships Act 2005` EQUALS JUST TRUE
#ASSERT `s 16(5) the entity is a body corporate` `a partnership` EQUALS NOTHING
#ASSERT `s 16(5) the entity is a body corporate` `an unincorporated association other than a partnership` EQUALS NOTHING
#ASSERT `s 16(5) the entity is a body corporate` `some other entity` EQUALS NOTHING
#ASSERT `s 16(5)(a) the person is an officer of a body corporate` `a director` EQUALS JUST TRUE
#ASSERT `s 16(5)(a) the person is an officer of a body corporate` `a partner` EQUALS JUST TRUE
#ASSERT `s 16(5)(a) the person is an officer of a body corporate` `a member of the board of management` EQUALS JUST TRUE
#ASSERT `s 16(5)(a) the person is an officer of a body corporate` `a chief executive` EQUALS JUST TRUE
#ASSERT `s 16(5)(a) the person is an officer of a body corporate` `a manager` EQUALS JUST TRUE
#ASSERT `s 16(5)(a) the person is an officer of a body corporate` `a secretary` EQUALS JUST TRUE
#ASSERT `s 16(5)(a) the person is an officer of a body corporate` `another similar officer of the body corporate` EQUALS JUST TRUE
#ASSERT `s 16(5)(a) the person is an officer of a body corporate` `a person purporting to act in one of those capacities` EQUALS JUST TRUE
#ASSERT `s 16(5)(a) the person is an officer of a body corporate` `no such position` EQUALS NOTHING
#ASSERT `s 16(5)(b) the person is an officer of an unincorporated association` `the president` EQUALS JUST TRUE
#ASSERT `s 16(5)(b) the person is an officer of an unincorporated association` `the secretary of the association` EQUALS JUST TRUE
#ASSERT `s 16(5)(b) the person is an officer of an unincorporated association` `a member of the committee` EQUALS JUST TRUE
#ASSERT `s 16(5)(b) the person is an officer of an unincorporated association` `a person holding a position analogous to president, secretary or member of a committee` EQUALS JUST TRUE
#ASSERT `s 16(5)(b) the person is an officer of an unincorporated association` `a person purporting to act in one of those capacities in the association` EQUALS JUST TRUE
#ASSERT `s 16(5)(b) the person is an officer of an unincorporated association` `no such position in the association` EQUALS NOTHING
#ASSERT `s 16(5) the person is a partner` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 16(5) the person is a partner` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 16(5) the person is a partner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 16(5) the person is a partner` FALSE FALSE EQUALS NOTHING

§§ `s 16(1) the officer of a body corporate`
-- inputs: kind of entity, offence by the body corporate proved, the officer's position, consent or connivance, neglect
-- consent or connivance
#ASSERT `s 16(1) the officer is guilty of the offence as well as the body corporate` `an ordinary body corporate` TRUE `a director` TRUE FALSE EQUALS JUST TRUE
-- neglect
#ASSERT `s 16(1) the officer is guilty of the offence as well as the body corporate` `an ordinary body corporate` TRUE `a director` FALSE TRUE EQUALS JUST TRUE
-- a limited liability partnership is a body corporate
#ASSERT `s 16(1) the officer is guilty of the offence as well as the body corporate` `a limited liability partnership as defined in section 2(1) of the Limited Liability Partnerships Act 2005` TRUE `a manager` TRUE FALSE EQUALS JUST TRUE
-- a person purporting to act is an officer
#ASSERT `s 16(1) the officer is guilty of the offence as well as the body corporate` `an ordinary body corporate` TRUE `a person purporting to act in one of those capacities` TRUE FALSE EQUALS JUST TRUE
-- the offence is not proved
#ASSERT `s 16(1) the officer is guilty of the offence as well as the body corporate` `an ordinary body corporate` FALSE `a director` TRUE TRUE EQUALS NOTHING
-- neither consent nor neglect
#ASSERT `s 16(1) the officer is guilty of the offence as well as the body corporate` `an ordinary body corporate` TRUE `a director` FALSE FALSE EQUALS NOTHING
-- not an officer
#ASSERT `s 16(1) the officer is guilty of the offence as well as the body corporate` `an ordinary body corporate` TRUE `no such position` TRUE TRUE EQUALS NOTHING
-- a partnership is s 16(3)'s business, not s 16(1)'s
#ASSERT `s 16(1) the officer is guilty of the offence as well as the body corporate` `a partnership` TRUE `a director` TRUE TRUE EQUALS NOTHING

§§ `s 16(2) a body corporate managed by its members`
#ASSERT `s 16(2) section 16(1) applies to the member as if the member were a director` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 16(2) section 16(1) applies to the member as if the member were a director` TRUE FALSE EQUALS NOTHING
#ASSERT `s 16(2) section 16(1) applies to the member as if the member were a director` FALSE TRUE EQUALS NOTHING
#ASSERT `s 16(2) section 16(1) applies to the member as if the member were a director` FALSE FALSE EQUALS NOTHING

