IMPORT prelude
IMPORT `sssa-nouns`
IMPORT `sssa-part1-preliminary`

-- Tests for sssa-part1-preliminary.l4 (s 2).  Every expected value is written
-- from the text of the definition, beside the assertion, before the run.
-- A record is built positionally with OF; the ruler above each block names the
-- fields in their declared order.

§ `Tests -- Part 1`

-- s 2 chapeau: "unless the context otherwise requires".
#ASSERT `s 2 the definitions apply to the term as used` FALSE EQUALS JUST TRUE
#ASSERT `s 2 the definitions apply to the term as used` TRUE EQUALS JUST FALSE

-- s 2 "administrator" means the Board, or a public officer or public authority appointed under s 5(4).
-- fields:                                                                  Board,  public officer, public authority, appointed under 5(4)
#ASSERT `s 2 the body is an administrator` (`Body asked about as an administrator` OF TRUE,  FALSE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 2 the body is an administrator` (`Body asked about as an administrator` OF FALSE, TRUE,  FALSE, TRUE)  EQUALS JUST TRUE
#ASSERT `s 2 the body is an administrator` (`Body asked about as an administrator` OF FALSE, FALSE, TRUE,  TRUE)  EQUALS JUST TRUE
#ASSERT `s 2 the body is an administrator` (`Body asked about as an administrator` OF FALSE, TRUE,  FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 2 the body is an administrator` (`Body asked about as an administrator` OF FALSE, FALSE, TRUE,  FALSE) EQUALS JUST FALSE
#ASSERT `s 2 the body is an administrator` (`Body asked about as an administrator` OF FALSE, FALSE, FALSE, TRUE)  EQUALS JUST FALSE
#ASSERT `s 2 the body is an administrator` (`Body asked about as an administrator` OF FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE

-- s 2 "Board" means the CPF Board constituted under s 3 of the CPF Act 1953 (that Act is outside the sources).
#ASSERT `s 2 the body is the Board` (JUST TRUE)  EQUALS JUST TRUE
#ASSERT `s 2 the body is the Board` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2 the body is the Board` NOTHING      EQUALS NOTHING

-- s 2 "cash grant" means any cash grant made by the Government under the Scheme.
#ASSERT `s 2 the payment is a cash grant` TRUE  TRUE  EQUALS JUST TRUE
#ASSERT `s 2 the payment is a cash grant` TRUE  FALSE EQUALS JUST FALSE
#ASSERT `s 2 the payment is a cash grant` FALSE TRUE  EQUALS JUST FALSE
#ASSERT `s 2 the payment is a cash grant` FALSE FALSE EQUALS JUST FALSE

-- s 2 "Commissioner" means the Commissioner appointed under s 4(1), and includes a Deputy or Assistant Commissioner appointed under s 4(2).
#ASSERT `s 2 the person is the Commissioner` `appointed under section 4(1) as the Commissioner for Silver Support` EQUALS JUST TRUE
#ASSERT `s 2 the person is the Commissioner` `appointed under section 4(2)(a) as a Deputy Commissioner for Silver Support` EQUALS JUST TRUE
#ASSERT `s 2 the person is the Commissioner` `appointed under section 4(2)(b) as an Assistant Commissioner for Silver Support` EQUALS JUST TRUE
#ASSERT `s 2 the person is the Commissioner` `not appointed under section 4` EQUALS JUST FALSE

-- s 2 "eligible individual" means an individual who is eligible to receive any benefit under the Scheme (FORK F-1).
#ASSERT `s 2 the person is an eligible individual` TRUE (JUST TRUE)  EQUALS JUST TRUE
#ASSERT `s 2 the person is an eligible individual` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2 the person is an eligible individual` TRUE NOTHING      EQUALS NOTHING
#ASSERT `s 2 the person is an eligible individual` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 2 the person is an eligible individual` FALSE NOTHING     EQUALS JUST FALSE

-- s 2 "investigator" means a Board officer or employee authorised under s 5(7), and includes a person appointed under s 5(8).
-- fields:                                                                    authorised under 5(7), appointed under 5(8)
#ASSERT `s 2 the person is an investigator` (`Person asked about as an investigator` OF TRUE,  FALSE) EQUALS JUST TRUE
#ASSERT `s 2 the person is an investigator` (`Person asked about as an investigator` OF FALSE, TRUE)  EQUALS JUST TRUE
#ASSERT `s 2 the person is an investigator` (`Person asked about as an investigator` OF TRUE,  TRUE)  EQUALS JUST TRUE
#ASSERT `s 2 the person is an investigator` (`Person asked about as an investigator` OF FALSE, FALSE) EQUALS JUST FALSE

-- s 2 "means information": income or assets of an individual or of a household, in the possession of a department or authority.
-- fields:                                                                                 individual, household, in possession
#ASSERT `s 2 the information is means information` (`Information asked about as means information` OF TRUE,  FALSE, TRUE)  EQUALS JUST TRUE
#ASSERT `s 2 the information is means information` (`Information asked about as means information` OF FALSE, TRUE,  TRUE)  EQUALS JUST TRUE
#ASSERT `s 2 the information is means information` (`Information asked about as means information` OF TRUE,  TRUE,  TRUE)  EQUALS JUST TRUE
#ASSERT `s 2 the information is means information` (`Information asked about as means information` OF TRUE,  FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 2 the information is means information` (`Information asked about as means information` OF FALSE, FALSE, TRUE)  EQUALS JUST FALSE

-- s 2 "permanent resident of Singapore" has the meaning given by s 2 of the Immigration Act 1959 (outside the sources): the stated fact answers.
#ASSERT `s 2 the person is a permanent resident of Singapore` (JUST TRUE)  EQUALS JUST TRUE
#ASSERT `s 2 the person is a permanent resident of Singapore` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2 the person is a permanent resident of Singapore` NOTHING      EQUALS NOTHING

-- s 2 "public authority": established by or under a public Act, to perform a public function.
-- fields:                                                                  public Act, public function
#ASSERT `s 2 the body is a public authority` (`Body asked about as a public authority` OF TRUE,  TRUE)  EQUALS JUST TRUE
#ASSERT `s 2 the body is a public authority` (`Body asked about as a public authority` OF TRUE,  FALSE) EQUALS JUST FALSE
#ASSERT `s 2 the body is a public authority` (`Body asked about as a public authority` OF FALSE, TRUE)  EQUALS JUST FALSE
#ASSERT `s 2 the body is a public authority` (`Body asked about as a public authority` OF FALSE, FALSE) EQUALS JUST FALSE

-- s 2 "public scheme": (a) under written law and administered by a public authority or by the Government in another manner; and (b) for citizens or permanent residents or any part of them.
-- fields:                                                             written law, by authority, by Government, citizens, PRs, part of them
#ASSERT `s 2 the scheme is a public scheme` (`Scheme asked about as a public scheme` OF TRUE,  TRUE,  FALSE, TRUE,  FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `s 2 the scheme is a public scheme` (`Scheme asked about as a public scheme` OF TRUE,  FALSE, TRUE,  FALSE, TRUE,  FALSE) EQUALS JUST TRUE
#ASSERT `s 2 the scheme is a public scheme` (`Scheme asked about as a public scheme` OF TRUE,  TRUE,  FALSE, FALSE, FALSE, TRUE)  EQUALS JUST TRUE
#ASSERT `s 2 the scheme is a public scheme` (`Scheme asked about as a public scheme` OF FALSE, TRUE,  FALSE, TRUE,  FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 2 the scheme is a public scheme` (`Scheme asked about as a public scheme` OF TRUE,  FALSE, FALSE, TRUE,  FALSE, FALSE) EQUALS JUST FALSE
#ASSERT `s 2 the scheme is a public scheme` (`Scheme asked about as a public scheme` OF TRUE,  TRUE,  FALSE, FALSE, FALSE, FALSE) EQUALS JUST FALSE

-- s 2 "Scheme" means the Silver Support Scheme established under s 5(1).
#ASSERT `s 2 the scheme is the Scheme` TRUE  EQUALS JUST TRUE
#ASSERT `s 2 the scheme is the Scheme` FALSE EQUALS JUST FALSE
