    -- NOTHING-kind (limited by its own wording): the power is over "A direction under subsection (1)(a) or (2)(a)"
    ELSE NOTHING

-- s 8(6): the offence of contravening s 8(3).
-- fields:                                 greatest fine in dollars, greatest imprisonment in months
