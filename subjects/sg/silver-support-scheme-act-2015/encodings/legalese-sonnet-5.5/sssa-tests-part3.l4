#ASSERT `s 9(3) the Commissioner, the Board or an administrator may provide the information` `the Commissioner for Silver Support` TRUE (JUST FALSE) TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 9(3) the Commissioner, the Board or an administrator may provide the information` `the Commissioner for Silver Support` TRUE NOTHING TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
-- each 'only' limb failing answers no
#ASSERT `s 9(3) the Commissioner, the Board or an administrator may provide the information` `the Commissioner for Silver Support` TRUE (JUST TRUE) FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 9(3) the Commissioner, the Board or an administrator may provide the information` `the Commissioner for Silver Support` TRUE (JUST TRUE) TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 9(3) the Commissioner, the Board or an administrator may provide the information` `the Commissioner for Silver Support` TRUE (JUST TRUE) TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 9(3) the Commissioner, the Board or an administrator may provide the information` `the Commissioner for Silver Support` TRUE (JUST TRUE) TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9(3) the Commissioner, the Board or an administrator may provide the information` `the Commissioner for Silver Support` TRUE (JUST TRUE) TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- a failed 'only' limb answers no even where the scheme is not known
#ASSERT `s 9(3) the Commissioner, the Board or an administrator may provide the information` `the Commissioner for Silver Support` TRUE NOTHING FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 9(3) the Commissioner, the Board or an administrator may provide the information` `the Commissioner for Silver Support` TRUE NOTHING TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE

