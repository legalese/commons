IMPORT prelude
IMPORT `sigla-loans`

-- Significant Infrastructure Government Loan Act 2021, ss 2, 5, 9-16, 18, 20-22 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_significant-infrastructure-government-loan-act-2021.py). Expected results were written by
-- hand from the text.

§ `s 2`

#ASSERT `it is nationally significant infrastructure` TRUE TRUE `transport` TRUE
#ASSERT `it is nationally significant infrastructure` TRUE TRUE `coastal management` TRUE
#ASSERT NOT `it is nationally significant infrastructure` TRUE FALSE `energy` TRUE
#ASSERT NOT `it is nationally significant infrastructure` TRUE TRUE `none of the listed purposes` TRUE

#ASSERT `it is a related facility` `a fixed structure or system` TRUE
#ASSERT NOT `it is a related facility` `a train, vehicle or vessel` TRUE

§ `ss 5 and 9`

#ASSERT `the Minister may raise the loan` 10000000000 80000000000 0 FALSE 0 4000000000
#ASSERT NOT `the Minister may raise the loan` 11000000000 80000000000 0 FALSE 0 4000000000
#ASSERT `the Minister may raise the loan` 11000000000 80000000000 2000000000 FALSE 0 4000000000
#ASSERT `the Minister may raise the loan` 11000000000 80000000000 0 TRUE 12000000000 4000000000
#ASSERT NOT `the Minister may raise the loan` 12000000000 80000000000 0 TRUE 12000000000 4000000000
#ASSERT NOT `the Minister may raise the loan` 10000000000 50000000000 0 FALSE 0 5000000001
#ASSERT NOT `the Minister may raise the loan` 11000000000 80000000000 0 TRUE 12000000000 6000000000

#ASSERT NOT `the power was validly exercised` FALSE

§ `s 10`

#ASSERT `the amount paid into the Development Fund` 1000000000 200000000 EQUALS 800000000

§ `s 11`

#ASSERT `it is an infrastructure project` `construction or acquisition` 50
#ASSERT NOT `it is an infrastructure project` `a significant upgrade` 49
#ASSERT NOT `it is an infrastructure project` `a minor upgrade` 60
#ASSERT NOT `it is an infrastructure project` `repair or maintenance only` 60

#ASSERT `the project is approved` TRUE 4000000000 TRUE TRUE
#ASSERT NOT `the project is approved` TRUE 3999999999 TRUE TRUE
#ASSERT NOT `the project is approved` TRUE 5000000000 FALSE TRUE
#ASSERT NOT `the project is approved` TRUE 5000000000 TRUE FALSE

#ASSERT `the estimate for the threshold` 3000000000 2000000000 TRUE TRUE EQUALS 3000000000
#ASSERT `the estimate for the threshold` 3000000000 2000000000 TRUE FALSE EQUALS 5000000000
#ASSERT `the estimate for the threshold` 3000000000 2000000000 FALSE TRUE EQUALS 5000000000

#ASSERT `it is qualifying capital expenditure` `construction works` `the responsible ministry`
#ASSERT `it is qualifying capital expenditure` `a licence to use an invention` `a public authority on the ministry's behalf`
#ASSERT NOT `it is qualifying capital expenditure` `buying the land` `the responsible ministry`
#ASSERT NOT `it is qualifying capital expenditure` `repair or maintenance` `the responsible ministry`
#ASSERT NOT `it is qualifying capital expenditure` `construction works` `a private company`

#ASSERT `the loan may pay for it` TRUE TRUE 20210803
#ASSERT NOT `the loan may pay for it` TRUE TRUE 20210802

