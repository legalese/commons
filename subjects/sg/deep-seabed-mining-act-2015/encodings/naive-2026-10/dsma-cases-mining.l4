IMPORT prelude
IMPORT `dsma-mining`

-- Deep Seabed Mining Act 2015, ss 2, 4, 5, 6(3), 7, 10(4), 11(3), 12, 13, 14, 15, 16, 21, 24(2)(g), 25 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_deep-seabed-mining-act-2015.py). Expected results were written by
-- hand from the text.

`a fully licensed and contracted Singapore company` MEANS Activity WITH
    `who` IS `a Singapore company`
    `holds a licence for that resource in that part` IS TRUE
    `the licence is in force` IS TRUE
    `has a corresponding ISA contract` IS TRUE
    `the ISA contract is in force` IS TRUE
    `works for a Singapore company meeting section 5(1)` IS FALSE
    `within that company's licence` IS FALSE
    `works for a contractor sponsored by another State` IS FALSE
    `that contractor's ISA contract is in force` IS FALSE
    `within that contractor's ISA contract` IS FALSE

`a licensed Singapore company with no ISA contract yet` MEANS Activity WITH
    `who` IS `a Singapore company`
    `holds a licence for that resource in that part` IS TRUE
    `the licence is in force` IS TRUE
    `has a corresponding ISA contract` IS FALSE
    `the ISA contract is in force` IS FALSE
    `works for a Singapore company meeting section 5(1)` IS FALSE
    `within that company's licence` IS FALSE
    `works for a contractor sponsored by another State` IS FALSE
    `that contractor's ISA contract is in force` IS FALSE
    `within that contractor's ISA contract` IS FALSE

`a Singapore company with an ISA contract sponsored by another State` MEANS Activity WITH
    `who` IS `a Singapore company`
    `holds a licence for that resource in that part` IS FALSE
    `the licence is in force` IS FALSE
    `has a corresponding ISA contract` IS TRUE
    `the ISA contract is in force` IS TRUE
    `works for a Singapore company meeting section 5(1)` IS FALSE
    `within that company's licence` IS FALSE
    `works for a contractor sponsored by another State` IS FALSE
    `that contractor's ISA contract is in force` IS FALSE
    `within that contractor's ISA contract` IS FALSE

`a citizen working within a qualifying company's licence` MEANS Activity WITH
    `who` IS `a Singapore citizen`
    `holds a licence for that resource in that part` IS FALSE
    `the licence is in force` IS FALSE
    `has a corresponding ISA contract` IS FALSE
    `the ISA contract is in force` IS FALSE
    `works for a Singapore company meeting section 5(1)` IS TRUE
    `within that company's licence` IS TRUE
    `works for a contractor sponsored by another State` IS FALSE
    `that contractor's ISA contract is in force` IS FALSE
    `within that contractor's ISA contract` IS FALSE

`a citizen working beyond a qualifying company's licence` MEANS Activity WITH
    `who` IS `a Singapore citizen`
    `holds a licence for that resource in that part` IS FALSE
    `the licence is in force` IS FALSE
    `has a corresponding ISA contract` IS FALSE
    `the ISA contract is in force` IS FALSE
    `works for a Singapore company meeting section 5(1)` IS TRUE
    `within that company's licence` IS FALSE
    `works for a contractor sponsored by another State` IS FALSE
    `that contractor's ISA contract is in force` IS FALSE
    `within that contractor's ISA contract` IS FALSE

`a citizen working for a foreign-sponsored contractor` MEANS Activity WITH
    `who` IS `a Singapore citizen`
    `holds a licence for that resource in that part` IS FALSE
    `the licence is in force` IS FALSE
    `has a corresponding ISA contract` IS FALSE
    `the ISA contract is in force` IS FALSE
    `works for a Singapore company meeting section 5(1)` IS FALSE
    `within that company's licence` IS FALSE
    `works for a contractor sponsored by another State` IS TRUE
    `that contractor's ISA contract is in force` IS TRUE
    `within that contractor's ISA contract` IS TRUE

`a citizen working for a foreign-sponsored contractor whose contract has ended` MEANS Activity WITH
    `who` IS `a Singapore citizen`
    `holds a licence for that resource in that part` IS FALSE
    `the licence is in force` IS FALSE
    `has a corresponding ISA contract` IS FALSE
    `the ISA contract is in force` IS FALSE
    `works for a Singapore company meeting section 5(1)` IS FALSE
    `within that company's licence` IS FALSE
    `works for a contractor sponsored by another State` IS TRUE
    `that contractor's ISA contract is in force` IS FALSE
    `within that contractor's ISA contract` IS TRUE

`a permanent resident mining on his own account` MEANS Activity WITH
    `who` IS `a Singapore permanent resident who is not a citizen`
    `holds a licence for that resource in that part` IS FALSE
    `the licence is in force` IS FALSE
    `has a corresponding ISA contract` IS FALSE
    `the ISA contract is in force` IS FALSE
    `works for a Singapore company meeting section 5(1)` IS FALSE
    `within that company's licence` IS FALSE
    `works for a contractor sponsored by another State` IS FALSE
    `that contractor's ISA contract is in force` IS FALSE
    `within that contractor's ISA contract` IS FALSE

`a Singapore LLP with a licence and an ISA contract` MEANS Activity WITH
    `who` IS `a Singapore limited liability partnership`
    `holds a licence for that resource in that part` IS TRUE
    `the licence is in force` IS TRUE
    `has a corresponding ISA contract` IS TRUE
    `the ISA contract is in force` IS TRUE
    `works for a Singapore company meeting section 5(1)` IS FALSE
    `within that company's licence` IS FALSE
    `works for a contractor sponsored by another State` IS FALSE
    `that contractor's ISA contract is in force` IS FALSE
    `within that contractor's ISA contract` IS FALSE

`a qualified Singapore applicant` MEANS Applicant WITH
    `applicant` IS `a Singapore company`
    `meets or is likely to meet the Annex III, Article 4 standards` IS TRUE
    `will apply to the ISA for a corresponding contract` IS TRUE
    `was sponsored by the Government before 1 April 2015` IS FALSE
    `the grant is in Singapore's interest` IS TRUE
    `meets any prescribed criteria` IS TRUE

`a qualified foreign applicant` MEANS Applicant WITH
    `applicant` IS `a foreign company`
    `meets or is likely to meet the Annex III, Article 4 standards` IS TRUE
    `will apply to the ISA for a corresponding contract` IS TRUE
    `was sponsored by the Government before 1 April 2015` IS FALSE
    `the grant is in Singapore's interest` IS TRUE
    `meets any prescribed criteria` IS TRUE

`a Singapore company sponsored before 2015` MEANS Applicant WITH
    `applicant` IS `a Singapore company`
    `meets or is likely to meet the Annex III, Article 4 standards` IS TRUE
    `will apply to the ISA for a corresponding contract` IS FALSE
    `was sponsored by the Government before 1 April 2015` IS TRUE
    `the grant is in Singapore's interest` IS TRUE
    `meets any prescribed criteria` IS TRUE

`a Singapore company not seeking an ISA contract` MEANS Applicant WITH
    `applicant` IS `a Singapore company`
    `meets or is likely to meet the Annex III, Article 4 standards` IS TRUE
    `will apply to the ISA for a corresponding contract` IS FALSE
    `was sponsored by the Government before 1 April 2015` IS FALSE
    `the grant is in Singapore's interest` IS TRUE
    `meets any prescribed criteria` IS TRUE

