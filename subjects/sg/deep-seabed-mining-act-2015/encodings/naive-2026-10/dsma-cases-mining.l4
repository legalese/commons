§ `s 2 -- Singapore nationals`

#ASSERT `the actor is a Singapore national` `a Singapore citizen`
#ASSERT NOT `the actor is a Singapore national` `a Singapore permanent resident who is not a citizen`
#ASSERT `the actor is a Singapore national` `a Singapore limited liability partnership`
#ASSERT NOT `the actor is a Singapore national` `a foreign company`

§ `ss 4, 5 -- the prohibition and its exceptions`

#ASSERT NOT `exploring or exploiting is an offence` `a fully licensed and contracted Singapore company`
#ASSERT `exploring or exploiting is an offence` `a licensed Singapore company with no ISA contract yet`
#ASSERT `exploring or exploiting is an offence` `a Singapore company with an ISA contract sponsored by another State`
#ASSERT NOT `exploring or exploiting is an offence` `a citizen working within a qualifying company's licence`
#ASSERT `exploring or exploiting is an offence` `a citizen working beyond a qualifying company's licence`
#ASSERT NOT `exploring or exploiting is an offence` `a citizen working for a foreign-sponsored contractor`
#ASSERT `exploring or exploiting is an offence` `a citizen working for a foreign-sponsored contractor whose contract has ended`
#ASSERT NOT `exploring or exploiting is an offence` `a permanent resident mining on his own account`
#ASSERT `exploring or exploiting is an offence` `a Singapore LLP with a licence and an ISA contract`

§ `s 4(2) -- punishment`

#ASSERT `the maximum imprisonment in months` `a Singapore citizen` EQUALS 3
#ASSERT `the maximum imprisonment in months` `a Singapore company` EQUALS 0

#ASSERT `the maximum further fine` 4 EQUALS 200000
#ASSERT `the maximum further fine` 11 EQUALS 500000

#ASSERT `the maximum total fine` 20 EQUALS 800000

§ `ss 6(3), 7, 12(2), 25 -- licences`

#ASSERT NOT `a licence may cover that many resource types` 2

#ASSERT `the Minister may grant the licence` `a qualified Singapore applicant`
#ASSERT NOT `the Minister may grant the licence` `a qualified foreign applicant`
#ASSERT `the Minister may grant the licence` `a Singapore company sponsored before 2015`
#ASSERT NOT `the Minister may grant the licence` `a Singapore company not seeking an ISA contract`

#ASSERT `the transfer may be approved` `a qualified Singapore applicant` TRUE TRUE
#ASSERT NOT `the transfer may be approved` `a qualified Singapore applicant` FALSE TRUE

§ `ss 13, 14 -- lapse, suspension and revocation`

#ASSERT NOT `the licence lapses` `a licence 6 months old without a contract`
#ASSERT `the licence lapses` `a licence 13 months old without a contract`
#ASSERT NOT `the licence lapses` `a licence 13 months old with an 18-month extension`
#ASSERT NOT `the licence lapses` `a licence 10 months old with a 6-month allowance`
#ASSERT `the licence lapses` `a licence whose ISA contract was terminated`
#ASSERT NOT `the licence lapses` `a licence whose ISA contract was suspended`

#ASSERT `the Minister may suspend or revoke` `a licence whose ISA contract was suspended`
#ASSERT NOT `the Minister may suspend or revoke` `a licence in good standing`

#ASSERT `the period to obtain an ISA contract` 6 EQUALS 12

§ `s 15 -- representations`

#ASSERT NOT `the representations are in time` 1.5 0
#ASSERT `the representations are in time` 1.5 2

#ASSERT `days after being informed until the decision takes effect` 0 EQUALS 14

§ `s 16 -- wind-down directions`

#ASSERT `section 16 applies` `lapse`
#ASSERT NOT `section 16 applies` `suspension`

#ASSERT `the person may be directed` `the licensee itself` 0 TRUE
#ASSERT `the person may be directed` `a former director` 3 FALSE
#ASSERT NOT `the person may be directed` `a former director` 3 TRUE
#ASSERT NOT `the person may be directed` `a former director` 9 FALSE
#ASSERT NOT `the person may be directed` `a former senior manager` 1 FALSE

#ASSERT NOT `the compliance immunity applies` TRUE FALSE

§ `ss 10(4), 11(3), 16(5), 24(2)(g) -- financial penalties`

#ASSERT `a financial penalty may be imposed` `breach of a licence condition` TRUE
#ASSERT NOT `a financial penalty may be imposed` `failure to comply with a direction to a licensee` TRUE

#ASSERT NOT `a regulation's sanction is within section 24(2)(g)` TRUE TRUE 40000

§ `s 21 -- officers`

#ASSERT `the officer is also guilty` TRUE FALSE TRUE
#ASSERT NOT `the officer is also guilty` TRUE FALSE FALSE

