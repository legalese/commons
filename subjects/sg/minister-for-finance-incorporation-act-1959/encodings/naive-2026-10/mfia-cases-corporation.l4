IMPORT prelude
IMPORT `mfia-corporation`

-- Minister for Finance (Incorporation) Act 1959, ss 2-8 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_minister-for-finance-incorporation-act-1959.py). Expected results were written by
-- hand from the text.

§ `s 2 -- suing and the seal`

#ASSERT `the party to sue under s 2(2)` TRUE EQUALS `the Corporation in the name Minister for Finance`
#ASSERT `the party to sue under s 2(2)` FALSE EQUALS `the individual who is Minister personally`

#ASSERT `the mark serves as the corporate seal` TRUE TRUE FALSE
#ASSERT NOT `the mark serves as the corporate seal` TRUE FALSE TRUE
#ASSERT `the mark serves as the corporate seal` FALSE FALSE TRUE
#ASSERT NOT `the mark serves as the corporate seal` FALSE FALSE FALSE

§ `s 3 -- powers`

#ASSERT `s 3 confers the power` `buying land`
#ASSERT `s 3 confers the power` `holding shares`
#ASSERT `s 3 confers the power` `selling a building`
#ASSERT `s 3 confers the power` `leasing out land`
#ASSERT `s 3 confers the power` `mortgaging land`
#ASSERT `s 3 confers the power` `surrendering a lease`
#ASSERT `s 3 confers the power` `assigning a debt owed to it`
#ASSERT NOT `s 3 confers the power` `giving a guarantee for a third party`
#ASSERT NOT `s 3 confers the power` `borrowing money unsecured`

§ `s 4 -- execution`

#ASSERT `the instrument is executed as s 4(1) requires` TRUE TRUE TRUE
#ASSERT NOT `the instrument is executed as s 4(1) requires` TRUE FALSE TRUE
#ASSERT NOT `the instrument is executed as s 4(1) requires` TRUE TRUE FALSE
#ASSERT NOT `the instrument is executed as s 4(1) requires` FALSE TRUE TRUE

#ASSERT `the signature is sufficient evidence the seal was duly affixed and lawful` TRUE TRUE
#ASSERT NOT `the signature is sufficient evidence the seal was duly affixed and lawful` TRUE FALSE

#ASSERT `s 11 of the Registration of Deeds Act 1988 is disapplied` TRUE
#ASSERT NOT `s 11 of the Registration of Deeds Act 1988 is disapplied` FALSE

§ `s 7 -- Gazette proof`

#ASSERT `how the Minister's appointment is proved` TRUE EQUALS `conclusively proved by the Gazette`
#ASSERT `how the Minister's appointment is proved` FALSE EQUALS `to be proved by ordinary evidence`

§ `s 5 -- vesting`

#ASSERT `the property vested in the Corporation on 3 June 1959` TRUE TRUE
#ASSERT NOT `the property vested in the Corporation on 3 June 1959` TRUE FALSE
#ASSERT NOT `the property vested in the Corporation on 3 June 1959` FALSE TRUE

#ASSERT `who holds the property after s 5(2) and (3)` `a public officer or authority` `an order vesting in the Corporation` TRUE EQUALS `the Corporation`
#ASSERT `who holds the property after s 5(2) and (3)` `a public officer or authority` `an order vesting in the Corporation` FALSE EQUALS `a public officer or authority`
#ASSERT `who holds the property after s 5(2) and (3)` `the Corporation` `an order vesting in a public officer or authority` TRUE EQUALS `a public officer or authority`
#ASSERT `who holds the property after s 5(2) and (3)` `the Corporation` `an order vesting in a public officer or authority` FALSE EQUALS `the Corporation`
#ASSERT `who holds the property after s 5(2) and (3)` `a private person` `an order vesting in the Corporation` TRUE EQUALS `a private person`
#ASSERT `who holds the property after s 5(2) and (3)` `the Corporation` `an order vesting in the Corporation` TRUE EQUALS `the Corporation`
#ASSERT `who holds the property after s 5(2) and (3)` `a public officer or authority` `an order vesting in a public officer or authority` TRUE EQUALS `a public officer or authority`
#ASSERT `who holds the property after s 5(2) and (3)` `a public officer or authority` `no order` TRUE EQUALS `a public officer or authority`

#ASSERT `years left on the lease after statutory vesting` 37 EQUALS 37

#ASSERT NOT `a conveyance, assignment or transfer document is needed under the Act` TRUE
#ASSERT `a conveyance, assignment or transfer document is needed under the Act` FALSE

§ `s 6 -- rights and liabilities`

#ASSERT `the Corporation bears the liability under s 6` TRUE TRUE
#ASSERT `the Corporation bears the liability under s 6` TRUE FALSE
#ASSERT NOT `the Corporation bears the liability under s 6` FALSE TRUE

§ `s 8 -- saving`

#ASSERT `the Act may affect the party's rights` `the Chief Secretary`
#ASSERT `the Act may affect the party's rights` `a public officer or authority named in a vesting order`
