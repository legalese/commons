IMPORT prelude
IMPORT `sbtsa-tax`

-- Statutory Boards (Taxable Services) Act 1968, ss 2, 3, 4, 4A, 5 and 6 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_statutory-boards-taxable-services-act-1968.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a specified service of a statutory board` MEANS Service WITH
    `the supplier` IS `a statutory board set up by statute`
    `rendered by the supplier itself` IS TRUE
    `fees collected by the supplier on behalf of the Government` IS FALSE
    `specified as taxable by a Gazette order` IS TRUE

`an unspecified service of a statutory board` MEANS Service WITH
    `the supplier` IS `a statutory board set up by statute`
    `rendered by the supplier itself` IS TRUE
    `fees collected by the supplier on behalf of the Government` IS FALSE
    `specified as taxable by a Gazette order` IS FALSE

`a specified service of a telecom licensee` MEANS Service WITH
    `the supplier` IS `a public telecommunication licensee`
    `rendered by the supplier itself` IS TRUE
    `fees collected by the supplier on behalf of the Government` IS FALSE
    `specified as taxable by a Gazette order` IS TRUE

`a specified service of a gas licensee` MEANS Service WITH
    `the supplier` IS `a gas licensee`
    `rendered by the supplier itself` IS TRUE
    `fees collected by the supplier on behalf of the Government` IS FALSE
    `specified as taxable by a Gazette order` IS TRUE

`a specified service of a market support licensee` MEANS Service WITH
    `the supplier` IS `a market support services licensee`
    `rendered by the supplier itself` IS TRUE
    `fees collected by the supplier on behalf of the Government` IS FALSE
    `specified as taxable by a Gazette order` IS TRUE

`a specified service of an unlicensed company` MEANS Service WITH
    `the supplier` IS `a company holding none of those licences`
    `rendered by the supplier itself` IS TRUE
    `fees collected by the supplier on behalf of the Government` IS FALSE
    `specified as taxable by a Gazette order` IS TRUE

`a specified Government fee collected by a board` MEANS Service WITH
    `the supplier` IS `a statutory board set up by statute`
    `rendered by the supplier itself` IS FALSE
    `fees collected by the supplier on behalf of the Government` IS TRUE
    `specified as taxable by a Gazette order` IS TRUE

`a specified meter letting by a board` MEANS Service WITH
    `the supplier` IS `a statutory board set up by statute`
    `rendered by the supplier itself` IS TRUE
    `fees collected by the supplier on behalf of the Government` IS FALSE
    `specified as taxable by a Gazette order` IS TRUE

§ `s 2`

#ASSERT `the supplier counts as a statutory board` `a statutory board set up by statute`
#ASSERT `the supplier counts as a statutory board` `a public telecommunication licensee`
#ASSERT `the supplier counts as a statutory board` `a gas licensee`
#ASSERT `the supplier counts as a statutory board` `a market support services licensee`
#ASSERT NOT `the supplier counts as a statutory board` `a company holding none of those licences`

§ `ss 3(1), 3(4)`

#ASSERT `the service is a taxable service` `a specified service of a statutory board`
#ASSERT NOT `the service is a taxable service` `an unspecified service of a statutory board`
#ASSERT `the service is a taxable service` `a specified service of a telecom licensee`
#ASSERT `the service is a taxable service` `a specified service of a gas licensee`
#ASSERT `the service is a taxable service` `a specified service of a market support licensee`
#ASSERT NOT `the service is a taxable service` `a specified service of an unlicensed company`
#ASSERT `the service is a taxable service` `a specified Government fee collected by a board`
#ASSERT `the service is a taxable service` `a specified meter letting by a board`

§ `ss 4(1), 6`

#ASSERT `the person must pay the tax` `a specified service of a statutory board` TRUE FALSE
#ASSERT NOT `the person must pay the tax` `a specified service of a statutory board` TRUE TRUE
#ASSERT NOT `the person must pay the tax` `a specified service of a statutory board` FALSE FALSE
#ASSERT NOT `the person must pay the tax` `an unspecified service of a statutory board` TRUE FALSE
#ASSERT NOT `the person must pay the tax` `a specified service of an unlicensed company` TRUE FALSE

#ASSERT `the tax on the service` `a specified service of a gas licensee` 200 10 EQUALS 20
#ASSERT `the tax on the service` `a specified Government fee collected by a board` 50 4 EQUALS 2
#ASSERT `the tax on the service` `an unspecified service of a statutory board` 200 10 EQUALS 0

§ `ss 3(2), 3(3)`

#ASSERT `the additional tax` 1000 TRUE TRUE FALSE EQUALS 500
#ASSERT `the additional tax` 1000 TRUE TRUE TRUE EQUALS 500
#ASSERT `the additional tax` 1000 TRUE FALSE FALSE EQUALS 0
#ASSERT `the additional tax` 1000 FALSE TRUE FALSE EQUALS 0
#ASSERT `the additional tax` 2480 TRUE TRUE FALSE EQUALS 1240

#ASSERT `the party must pay the additional tax` `the owner of the building`
#ASSERT NOT `the party must pay the additional tax` `a tenant occupying the building`
#ASSERT NOT `the party must pay the additional tax` `a resident of a flat in the building`
#ASSERT NOT `the party must pay the additional tax` `the statutory board supplying the electricity`

§ `ss 3(2A), 4A`

#ASSERT `section 3(2A) authorises a late-payment charge` 2024 4 1 TRUE
#ASSERT NOT `section 3(2A) authorises a late-payment charge` 2024 3 31 TRUE
#ASSERT NOT `section 3(2A) authorises a late-payment charge` 2025 6 15 FALSE

#ASSERT `section 4A validates the collection` 2015 7 1 TRUE TRUE
#ASSERT `section 4A validates the collection` 2024 3 31 TRUE TRUE
#ASSERT NOT `section 4A validates the collection` 2024 4 1 TRUE TRUE
#ASSERT NOT `section 4A validates the collection` 2015 7 1 FALSE TRUE
#ASSERT NOT `section 4A validates the collection` 2015 7 1 TRUE FALSE

#ASSERT `section 4A bars a claim to get the charge back` 2010 1 1 TRUE TRUE
#ASSERT NOT `section 4A bars a claim to get the charge back` 2025 1 1 TRUE TRUE

§ `ss 4, 5`

#ASSERT `where collected tax goes`  EQUALS `the Consolidated Fund`

#ASSERT `the board's manner of collection is authorised` TRUE
#ASSERT NOT `the board's manner of collection is authorised` FALSE

#ASSERT `the board may use its own fee-recovery powers for the tax` FALSE
#ASSERT NOT `the board may use its own fee-recovery powers for the tax` TRUE

