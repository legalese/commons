IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc7-order-duties`

-- Rules of Court 2021 (Singapore): TESTS for roc7-order-duties.
-- Expected values are written from the text of the rule named after each assertion (the comment on its line),
-- never copied from what the code printed.  The gate-shaped rules (a MAYBE BOOLEAN over BOOLEAN conditions) are tested
-- by the kind of the rule: every condition met; then each condition missing in turn.


-- The twins of the regulative rules, asserted on the same boundary the traces use.

-- O 33 r 2(4): twin of `o 33 r 2(4) duty`, anchor 1 January 2026, 14 days
#ASSERT `o 33 r 2(4) the defendant served in Singapore files and serves the notice in time` (JUST (Date 15 1 2026)) (Date 15 1 2026) (Date 20 1 2026) EQUALS JUST TRUE -- done on day 14: the regulative rule is FULFILLED
#ASSERT `o 33 r 2(4) the defendant served in Singapore files and serves the notice in time` (JUST (Date 16 1 2026)) (Date 15 1 2026) (Date 20 1 2026) EQUALS JUST FALSE -- done on day 15: the regulative rule is BREACHED
#ASSERT `o 33 r 2(4) the defendant served in Singapore files and serves the notice in time` NOTHING (Date 15 1 2026) (Date 14 1 2026) EQUALS NOTHING -- not done, the period still running
#ASSERT `o 33 r 2(4) the defendant served in Singapore files and serves the notice in time` NOTHING (Date 15 1 2026) (Date 16 1 2026) EQUALS JUST FALSE -- not done, the period out: BREACHED
-- O 33 r 2(5): twin of `o 33 r 2(5) duty`, anchor 1 January 2026, 21 days
#ASSERT `o 33 r 2(5) the defendant served out of Singapore files and serves the notice in time` (JUST (Date 22 1 2026)) (Date 22 1 2026) (Date 27 1 2026) EQUALS JUST TRUE -- done on day 21: the regulative rule is FULFILLED
#ASSERT `o 33 r 2(5) the defendant served out of Singapore files and serves the notice in time` (JUST (Date 23 1 2026)) (Date 22 1 2026) (Date 27 1 2026) EQUALS JUST FALSE -- done on day 22: the regulative rule is BREACHED
#ASSERT `o 33 r 2(5) the defendant served out of Singapore files and serves the notice in time` NOTHING (Date 22 1 2026) (Date 21 1 2026) EQUALS NOTHING -- not done, the period still running
#ASSERT `o 33 r 2(5) the defendant served out of Singapore files and serves the notice in time` NOTHING (Date 22 1 2026) (Date 23 1 2026) EQUALS JUST FALSE -- not done, the period out: BREACHED
-- O 33 r 5(1)(b): twin of `o 33 r 5(1)(b) duty`, anchor 1 January 2026, 3 days
#ASSERT `o 33 r 5(1)(b) bail is given or the amount is paid into Court in time` (JUST (Date 4 1 2026)) (Date 4 1 2026) (Date 9 1 2026) EQUALS JUST TRUE -- done on day 3: the regulative rule is FULFILLED
#ASSERT `o 33 r 5(1)(b) bail is given or the amount is paid into Court in time` (JUST (Date 5 1 2026)) (Date 4 1 2026) (Date 9 1 2026) EQUALS JUST FALSE -- done on day 4: the regulative rule is BREACHED
#ASSERT `o 33 r 5(1)(b) bail is given or the amount is paid into Court in time` NOTHING (Date 4 1 2026) (Date 3 1 2026) EQUALS NOTHING -- not done, the period still running
#ASSERT `o 33 r 5(1)(b) bail is given or the amount is paid into Court in time` NOTHING (Date 4 1 2026) (Date 5 1 2026) EQUALS JUST FALSE -- not done, the period out: BREACHED
-- O 33 r 18(9): twin of `o 33 r 18(9) duty`, anchor 1 January 2026, 14 days
#ASSERT `o 33 r 18(9) the party serves the copy in time` (JUST (Date 15 1 2026)) (Date 15 1 2026) (Date 20 1 2026) EQUALS JUST TRUE -- done on day 14: the regulative rule is FULFILLED
#ASSERT `o 33 r 18(9) the party serves the copy in time` (JUST (Date 16 1 2026)) (Date 15 1 2026) (Date 20 1 2026) EQUALS JUST FALSE -- done on day 15: the regulative rule is BREACHED
#ASSERT `o 33 r 18(9) the party serves the copy in time` NOTHING (Date 15 1 2026) (Date 14 1 2026) EQUALS NOTHING -- not done, the period still running
#ASSERT `o 33 r 18(9) the party serves the copy in time` NOTHING (Date 15 1 2026) (Date 16 1 2026) EQUALS JUST FALSE -- not done, the period out: BREACHED
-- O 33 r 20(3): twin of `o 33 r 20(3) duty`, anchor 1 January 2026, 14 days
#ASSERT `o 33 r 20(3) the party allows the inspection in time` (JUST (Date 15 1 2026)) (Date 15 1 2026) (Date 20 1 2026) EQUALS JUST TRUE -- done on day 14: the regulative rule is FULFILLED
#ASSERT `o 33 r 20(3) the party allows the inspection in time` (JUST (Date 16 1 2026)) (Date 15 1 2026) (Date 20 1 2026) EQUALS JUST FALSE -- done on day 15: the regulative rule is BREACHED
#ASSERT `o 33 r 20(3) the party allows the inspection in time` NOTHING (Date 15 1 2026) (Date 14 1 2026) EQUALS NOTHING -- not done, the period still running
#ASSERT `o 33 r 20(3) the party allows the inspection in time` NOTHING (Date 15 1 2026) (Date 16 1 2026) EQUALS JUST FALSE -- not done, the period out: BREACHED
-- O 30 r 5(2): twin of `o 30 r 5(2) duty`, anchor 1 January 2026, 7 days
#ASSERT `o 30 r 5(2) the person informs the Tribunal in time` (JUST (Date 8 1 2026)) (Date 8 1 2026) (Date 13 1 2026) EQUALS JUST TRUE -- done on day 7: the regulative rule is FULFILLED
#ASSERT `o 30 r 5(2) the person informs the Tribunal in time` (JUST (Date 9 1 2026)) (Date 8 1 2026) (Date 13 1 2026) EQUALS JUST FALSE -- done on day 8: the regulative rule is BREACHED
#ASSERT `o 30 r 5(2) the person informs the Tribunal in time` NOTHING (Date 8 1 2026) (Date 7 1 2026) EQUALS NOTHING -- not done, the period still running
#ASSERT `o 30 r 5(2) the person informs the Tribunal in time` NOTHING (Date 8 1 2026) (Date 9 1 2026) EQUALS JUST FALSE -- not done, the period out: BREACHED
-- O 33 r 41(5): twin of `o 33 r 41(5) duty`, anchor 1 January 2026, 14 days
#ASSERT `o 33 r 41(5) the Request is lodged in time` (JUST (Date 15 1 2026)) (Date 15 1 2026) (Date 20 1 2026) EQUALS JUST TRUE -- done on day 14: the regulative rule is FULFILLED
#ASSERT `o 33 r 41(5) the Request is lodged in time` (JUST (Date 16 1 2026)) (Date 15 1 2026) (Date 20 1 2026) EQUALS JUST FALSE -- done on day 15: the regulative rule is BREACHED
#ASSERT `o 33 r 41(5) the Request is lodged in time` NOTHING (Date 15 1 2026) (Date 14 1 2026) EQUALS NOTHING -- not done, the period still running
#ASSERT `o 33 r 41(5) the Request is lodged in time` NOTHING (Date 15 1 2026) (Date 16 1 2026) EQUALS JUST FALSE -- not done, the period out: BREACHED
-- O 33 r 22(2)(c): twin of `o 33 r 22(2)(c) duty`, anchor 1 January 2026, 14 days
#ASSERT `o 33 r 22(2)(c) the Sheriff sends the notice for publication in time` (JUST (Date 15 1 2026)) (Date 15 1 2026) (Date 20 1 2026) EQUALS JUST TRUE -- done on day 14: the regulative rule is FULFILLED
#ASSERT `o 33 r 22(2)(c) the Sheriff sends the notice for publication in time` (JUST (Date 16 1 2026)) (Date 15 1 2026) (Date 20 1 2026) EQUALS JUST FALSE -- done on day 15: the regulative rule is BREACHED
#ASSERT `o 33 r 22(2)(c) the Sheriff sends the notice for publication in time` NOTHING (Date 15 1 2026) (Date 14 1 2026) EQUALS NOTHING -- not done, the period still running
#ASSERT `o 33 r 22(2)(c) the Sheriff sends the notice for publication in time` NOTHING (Date 15 1 2026) (Date 16 1 2026) EQUALS JUST FALSE -- not done, the period out: BREACHED


