#ASSERT `o 49 r 4(3) the affidavit is supported by the relevant exhibits as it must be` TRUE TRUE TRUE EQUALS JUST TRUE -- both named exhibits
#ASSERT `o 49 r 4(3) the affidavit is supported by the relevant exhibits as it must be` TRUE FALSE TRUE EQUALS NOTHING -- the stop order not exhibited
#ASSERT `o 49 r 4(3) the affidavit is supported by the relevant exhibits as it must be` TRUE TRUE FALSE EQUALS NOTHING -- the Board application not exhibited
#ASSERT `o 49 r 4(3) the affidavit is supported by the relevant exhibits as it must be` FALSE TRUE TRUE EQUALS NOTHING -- not an affidavit under paragraph (1)
#ASSERT `o 49 r 4(4) a further affidavit is barred from being received in evidence` FALSE EQUALS JUST TRUE -- no permission
#ASSERT `o 49 r 4(4) a further affidavit is barred from being received in evidence` TRUE EQUALS JUST FALSE -- permission lifts the bar
#ASSERT `o 49 r 4(4) a further affidavit may be received in evidence` FALSE EQUALS JUST FALSE -- "No further affidavit is to be received in evidence without the permission"
#ASSERT `o 49 r 4(4) a further affidavit may be received in evidence` TRUE EQUALS NOTHING -- permission lifts the bar and grants nothing (QA)

-- ---------------------------------------------------------------------------
-- Rule 5 (lines 6395 to 6395): objections.
-- Claimants' affidavits served on the defendant on 15 June 2026: 21 days begin on 16 June and end on 6 July 2026 (Monday).
-- ---------------------------------------------------------------------------
#ASSERT `o 49 r 5(1) the period after the defendant is served with the claimants' affidavits`'s `period length` EQUALS 21 -- "not later than 21 days"
#ASSERT `o 49 r 5(1) the duty to adduce the objecting evidence by affidavit arises` TRUE TRUE EQUALS JUST TRUE -- intends to object and wishes to adduce evidence
#ASSERT `o 49 r 5(1) the duty to adduce the objecting evidence by affidavit arises` TRUE FALSE EQUALS JUST FALSE -- no wish to adduce evidence: the "where" fails
#ASSERT `o 49 r 5(1) the duty to adduce the objecting evidence by affidavit arises` FALSE TRUE EQUALS JUST FALSE -- no intention to object: the "where" fails
#ASSERT `o 49 r 5(1) the objecting evidence has been adduced by affidavit filed and served in time` TRUE TRUE TRUE (Date 6 7 2026) (Date 6 7 2026) EQUALS JUST TRUE -- by affidavit, on the last day
#ASSERT `o 49 r 5(1) the objecting evidence has been adduced by affidavit filed and served in time` TRUE TRUE TRUE (Date 7 7 2026) (Date 6 7 2026) EQUALS JUST FALSE -- by affidavit, a day late
#ASSERT `o 49 r 5(1) the objecting evidence has been adduced by affidavit filed and served in time` TRUE TRUE FALSE (Date 1 7 2026) (Date 6 7 2026) EQUALS NOTHING -- not by affidavit: a bare "must"
#ASSERT `o 49 r 5(1) the objecting evidence has been adduced by affidavit filed and served in time` FALSE TRUE TRUE (Date 1 7 2026) (Date 6 7 2026) EQUALS NOTHING -- the duty does not arise
#ASSERT `o 49 r 5(2) a further affidavit is barred from being received in evidence` FALSE EQUALS JUST TRUE -- no permission
#ASSERT `o 49 r 5(2) a further affidavit is barred from being received in evidence` TRUE EQUALS JUST FALSE -- permission lifts the bar
#ASSERT `o 49 r 5(2) a further affidavit may be received in evidence` FALSE EQUALS JUST FALSE -- "No further affidavit is to be received in evidence without the permission"
#ASSERT `o 49 r 5(2) a further affidavit may be received in evidence` TRUE EQUALS NOTHING -- permission lifts the bar and grants nothing (QA)

-- ---------------------------------------------------------------------------
-- Rule 6 (lines 6397 to 6421): dispute as to jurisdiction.
-- Originating application and affidavits served on the defendant on 15 June 2026: 21 days end on 6 July 2026.
-- ---------------------------------------------------------------------------
#ASSERT `o 49 r 6(1) the period after service of the originating application and affidavits`'s `period length` EQUALS 21 -- "within 21 days"
#ASSERT `o 49 r 6(1) the duty to apply for a relief in paragraph (2) arises` TRUE EQUALS JUST TRUE -- the defendant wishes to dispute the jurisdiction
#ASSERT `o 49 r 6(1) the duty to apply for a relief in paragraph (2) arises` FALSE EQUALS JUST FALSE -- no wish to dispute
#ASSERT `o 49 r 6(1) the defendant has applied for a relief in paragraph (2) in time` TRUE (Date 6 7 2026) (Date 6 7 2026) EQUALS JUST TRUE -- on the last day
#ASSERT `o 49 r 6(1) the defendant has applied for a relief in paragraph (2) in time` TRUE (Date 7 7 2026) (Date 6 7 2026) EQUALS JUST FALSE -- a day late
#ASSERT `o 49 r 6(1) the defendant has applied for a relief in paragraph (2) in time` FALSE (Date 7 7 2026) (Date 6 7 2026) EQUALS NOTHING -- the duty does not arise
#ASSERT `o 49 r 6(2) the relief is one mentioned in paragraph (1)` `o 49 r 6(2)(a) an order setting aside the originating application or service of it on the defendant` FALSE EQUALS JUST TRUE -- relief (a)
#ASSERT `o 49 r 6(2) the relief is one mentioned in paragraph (1)` `o 49 r 6(2)(b) an order declaring that the originating application has not been duly served on the defendant` FALSE EQUALS JUST TRUE -- relief (b)
#ASSERT `o 49 r 6(2) the relief is one mentioned in paragraph (1)` `o 49 r 6(2)(c) the discharge of any order giving permission to serve the originating application on the defendant out of Singapore` FALSE EQUALS JUST TRUE -- relief (c)
#ASSERT `o 49 r 6(2) the relief is one mentioned in paragraph (1)` `o 49 r 6(2)(d) the discharge of any order extending the validity of the originating application for the purpose of service` FALSE EQUALS JUST TRUE -- relief (d)
#ASSERT `o 49 r 6(2) the relief is one mentioned in paragraph (1)` `o 49 r 6(2)(e) the protection or release of any property of the defendant seized or threatened with seizure in the proceedings` FALSE EQUALS JUST TRUE -- relief (e)
#ASSERT `o 49 r 6(2) the relief is one mentioned in paragraph (1)` `o 49 r 6(2)(f) the discharge of any order made to prevent any dealing with any property of the defendant` FALSE EQUALS JUST TRUE -- relief (f)
#ASSERT `o 49 r 6(2) the relief is one mentioned in paragraph (1)` `o 49 r 6(2)(g) a declaration that the Court has no jurisdiction over the defendant in respect of the subject matter of the claim or the relief or remedy sought` FALSE EQUALS JUST TRUE -- relief (g)
#ASSERT `o 49 r 6(2) the relief is one mentioned in paragraph (1)` `o 49 r 6(2)(h) such other relief as may be appropriate` TRUE EQUALS JUST TRUE -- (h): other relief that is appropriate
#ASSERT `o 49 r 6(2) the relief is one mentioned in paragraph (1)` `o 49 r 6(2)(h) such other relief as may be appropriate` FALSE EQUALS NOTHING -- (h): other relief that is not shown appropriate
#ASSERT `o 49 r 6(3) the application is made by summons supported by an affidavit as it must be` TRUE `Summons` TRUE TRUE EQUALS JUST TRUE -- summons, verifying affidavit, copy served with it
#ASSERT `o 49 r 6(3) the application is made by summons supported by an affidavit as it must be` TRUE `Originating application` TRUE TRUE EQUALS NOTHING -- not by summons: a bare "must"
#ASSERT `o 49 r 6(3) the application is made by summons supported by an affidavit as it must be` TRUE `Summons` FALSE TRUE EQUALS NOTHING -- no verifying affidavit
#ASSERT `o 49 r 6(3) the application is made by summons supported by an affidavit as it must be` TRUE `Summons` TRUE FALSE EQUALS NOTHING -- the affidavit not served with the summons
#ASSERT `o 49 r 6(3) the application is made by summons supported by an affidavit as it must be` FALSE `Summons` TRUE TRUE EQUALS NOTHING -- not an application under paragraph (1)
#ASSERT `o 49 r 6(4) the Court may make such order and give such directions as it thinks fit` TRUE EQUALS JUST TRUE -- upon the hearing
#ASSERT `o 49 r 6(4) the Court may make such order and give such directions as it thinks fit` FALSE EQUALS JUST FALSE -- not upon the hearing: the "upon" fails

-- ---------------------------------------------------------------------------
-- Rule 7 (line 6423).
-- ---------------------------------------------------------------------------
#ASSERT `o 49 r 7 the Court may by order give such directions as to the proceedings to be taken as it thinks fit` TRUE EQUALS JUST TRUE -- at the first case conference
#ASSERT `o 49 r 7 the Court may by order give such directions as to the proceedings to be taken as it thinks fit` FALSE EQUALS JUST FALSE -- not at the first case conference: the "at" fails
