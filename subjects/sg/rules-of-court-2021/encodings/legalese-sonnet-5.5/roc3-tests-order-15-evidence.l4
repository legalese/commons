IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc3-order-15-evidence`

-- Tests for Order 15, rules 9 to 16 (src lines 1508-1584).  Expected values are written from the text,
-- decided before running.  Dates are chosen so that the last day, counted by hand from O 3 r 3, is
-- the day shown in each assertion.

#ASSERT `o 15 r 9 the person must take an oath or make an affirmation according to the practice of the Court` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 9 the person must take an oath or make an affirmation according to the practice of the Court` FALSE EQUALS NOTHING

-- Rule 10
#ASSERT `o 15 r 10(1) the Court may ask a witness any questions that the Court considers necessary at any time` EQUALS JUST TRUE
#ASSERT `o 15 r 10(1) the Court must allow the parties to ask the witness further questions arising out of the Court's questions` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 10(1) the Court must allow the parties to ask the witness further questions arising out of the Court's questions` FALSE EQUALS NOTHING
#ASSERT `o 15 r 10(2) the Court may inspect any object in the courtroom or elsewhere` EQUALS JUST TRUE
#ASSERT `o 15 r 10(2) the Court may visit the place` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 10(2) the Court may visit the place` FALSE EQUALS NOTHING

-- Rule 11
#ASSERT `o 15 r 11(4) the notice to take back exhibits`'s `period length` EQUALS 14
#ASSERT `o 15 r 11(11) the time the official record must be kept`'s `period length` EQUALS 60 -- 5 years, in months
#ASSERT `o 15 r 11(11) the time the official record must be kept`'s `period unit` EQUALS Months
#ASSERT `o 15 r 11(1) the Court must maintain a record of the exhibit` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 11(1) the Court must maintain a record of the exhibit` FALSE EQUALS NOTHING
#ASSERT `o 15 r 11(2) the Court may direct that the exhibit be kept in the custody of the party who tendered it or the party's solicitor` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 11(2) the Court may direct that the exhibit be kept in the custody of the party who tendered it or the party's solicitor` FALSE EQUALS NOTHING
#ASSERT `o 15 r 11(3) the exhibits kept with the Court may be returned to the relevant parties` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 11(3) the exhibits kept with the Court may be returned to the relevant parties` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 11(3) the exhibits kept with the Court may be returned to the relevant parties` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 11(4) the Court may dispose of the exhibits` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 11(4) the Court may dispose of the exhibits` TRUE FALSE EQUALS JUST FALSE -- they took back their exhibits
#ASSERT `o 15 r 11(4) the Court may dispose of the exhibits` FALSE TRUE EQUALS JUST FALSE -- less than 14 days' notice
#ASSERT `o 15 r 11(4) the costs incurred in the disposal must be paid by the relevant parties` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 11(4) the costs incurred in the disposal must be paid by the relevant parties` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 11(5) the Court must maintain an official record of every hearing` EQUALS JUST TRUE
#ASSERT `o 15 r 11(6) the audio recording is the official record of the hearing` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 11(6) the audio recording is the official record of the hearing` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 11(7) the Court's notes of proceedings are the official record of the hearing` FALSE EQUALS JUST TRUE -- no audio recording system used
#ASSERT `o 15 r 11(7) the Court's notes of proceedings are the official record of the hearing` TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 11(8) the party may apply for a certified transcript of the official record of the hearing` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 11(8) the party may apply for a certified transcript of the official record of the hearing` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 11(9) the costs of producing a certified transcript may be claimed as an item of disbursement` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 11(9) the costs of producing a certified transcript may be claimed as an item of disbursement` TRUE EQUALS JUST FALSE -- "unless otherwise ordered by the Court"
#ASSERT `o 15 r 11(10) the transcript is certified in the manner the Registrar determined` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 11(10) the transcript is certified in the manner the Registrar determined` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 11(11) the official record of the hearing must still be kept` (Date 30 11 2030) (Date 30 11 2030) EQUALS JUST TRUE -- the last day of the 5 years
#ASSERT `o 15 r 11(11) the official record of the hearing must still be kept` (Date 1 12 2030) (Date 30 11 2030) EQUALS JUST FALSE

-- Rule 12
#ASSERT `o 15 r 12(1)(a) the Court may give its decision orally` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 12(1)(a) the Court may give its decision orally` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 12(1)(a) the Court may give its decision orally` FALSE FALSE EQUALS NOTHING -- a later date without the parties present
#ASSERT `o 15 r 12(1)(b) the Court may give its decision in writing at the conclusion of the hearing or on a subsequent date with or without the parties present` TRUE EQUALS JUST TRUE -- in writing, with or without the parties present
#ASSERT `o 15 r 12(1)(b) the Court may give its decision in writing at the conclusion of the hearing or on a subsequent date with or without the parties present` FALSE EQUALS NOTHING -- not a decision in writing: (a) speaks of an oral decision
#ASSERT `o 15 r 12(2) the parties are entitled to a copy of the decision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 12(2) the parties are entitled to a copy of the decision` TRUE FALSE EQUALS JUST FALSE -- charges not paid
#ASSERT `o 15 r 12(2) the parties are entitled to a copy of the decision` FALSE TRUE EQUALS NOTHING -- an oral decision
#ASSERT `o 15 r 12(3) the Court may dispense with the attendance of the parties and record the judgment or order in the agreed terms` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 12(3) the Court may dispense with the attendance of the parties and record the judgment or order in the agreed terms` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 12(3) the Registrar is to inform the parties that the judgment or order is recorded` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 12(3) the Registrar is to inform the parties that the judgment or order is recorded` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 12(4) the Court may give such further orders or directions incidental or consequential to any judgment or order as it considers appropriate` EQUALS JUST TRUE

-- Rules 13 and 14
#ASSERT `o 15 r 13(1) the Court may give its decision in the matter` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 13(1) the Court may give its decision in the matter` FALSE TRUE EQUALS NOTHING
#ASSERT `o 15 r 13(1) the Court may give its decision in the matter` TRUE FALSE EQUALS NOTHING -- no party has passed away: paragraph (1) is silent
#ASSERT `o 15 r 13(2) the Court may substitute the person as a party and order that the person be bound by the decision` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 13(2) the Court may substitute the person as a party and order that the person be bound by the decision` FALSE EQUALS NOTHING
#ASSERT `o 15 r 14(1) another Judge or Registrar may take over and give a decision based on the earlier hearing or continue the hearing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 14(1) another Judge or Registrar may take over and give a decision based on the earlier hearing or continue the hearing` TRUE FALSE EQUALS JUST FALSE -- the parties do not all consent
#ASSERT `o 15 r 14(1) another Judge or Registrar may take over and give a decision based on the earlier hearing or continue the hearing` FALSE TRUE EQUALS JUST FALSE -- the Judge is neither incapable nor dead
#ASSERT `o 15 r 14(2) the Judge or Registrar who takes over may recall any witness and order the parties to make further submissions` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 14(2) the Judge or Registrar who takes over may recall any witness and order the parties to make further submissions` FALSE EQUALS NOTHING
#ASSERT `o 15 r 14(3) the matter must be heard anew by another Judge or Registrar` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 14(3) the matter must be heard anew by another Judge or Registrar` FALSE EQUALS JUST FALSE

-- Rule 15
#ASSERT `o 15 r 15(1) this Rule applies to the proceeding` `o 15 r 15(1) an assessment of damages` EQUALS JUST TRUE
#ASSERT `o 15 r 15(1) this Rule applies to the proceeding` `o 15 r 15(1) a taking of accounts` EQUALS JUST TRUE
#ASSERT `o 15 r 15(1) this Rule applies to the proceeding` `o 15 r 15(1) any other proceeding` EQUALS NOTHING
#ASSERT `o 15 r 15(1) the sum is within “damages” in this Rule` `o 15 r 15(1) damages for personal injuries` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 15(1) the sum is within “damages” in this Rule` `o 15 r 15(1) the value of movable property` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 15(1) the sum is within “damages” in this Rule` `o 15 r 15(1) the value of immovable property` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 15(1) the sum is within “damages” in this Rule` `o 15 r 15(1) amounts due on taking of accounts` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 15(1) the sum is within “damages” in this Rule` `o 15 r 15(1) any other sum` FALSE EQUALS NOTHING -- "includes": the list is not closed
#ASSERT `o 15 r 15(1) the sum is within “damages” in this Rule` `o 15 r 15(1) damages for personal injuries` TRUE EQUALS NOTHING -- "unless the context otherwise requires"
#ASSERT `o 15 r 15(2) the Court must give judgment on liability and on the amount of damages` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 15(2) the Court must give judgment on liability and on the amount of damages` TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 15(3) the Court may give directions on the assessment of damages and proceed to assess damages or order the Registrar to assess damages` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(3) the Court may give directions on the assessment of damages and proceed to assess damages or order the Registrar to assess damages` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 15(4) the period after the judgment for applying for directions`'s `period length` EQUALS 1
#ASSERT `o 15 r 15(4) the period after the judgment for applying for directions`'s `period unit` EQUALS Months
#ASSERT `o 15 r 15(5) the period after the date of filing for serving the notice of appointment`'s `period length` EQUALS 14
#ASSERT `o 15 r 15(4) the damages must be assessed by the Registrar or Judge` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 15(4) the damages must be assessed by the Registrar or Judge` TRUE TRUE TRUE EQUALS JUST FALSE -- the judgment makes provision
#ASSERT `o 15 r 15(4) the damages must be assessed by the Registrar or Judge` FALSE TRUE FALSE EQUALS JUST FALSE -- not bifurcated
#ASSERT `o 15 r 15(4) the application for directions is made in time` (Date 5 12 2025) (Date 5 12 2025) EQUALS JUST TRUE -- judgment on 5 November 2025: one month ends 5 December 2025
#ASSERT `o 15 r 15(4) the application for directions is made in time` (Date 6 12 2025) (Date 5 12 2025) EQUALS JUST FALSE
#ASSERT `o 15 r 15(4) the party must apply to the Court for directions` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- the party entitled to the benefit of the judgment
#ASSERT `o 15 r 15(4) the party must apply to the Court for directions` TRUE TRUE FALSE FALSE EQUALS NOTHING -- a person who is not the party entitled to the benefit of the judgment
#ASSERT `o 15 r 15(4) the party must apply to the Court for directions` FALSE TRUE FALSE TRUE EQUALS JUST FALSE -- not bifurcated
#ASSERT `o 15 r 15(4) the party must apply to the Court for directions` TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- the judgment makes provision
#ASSERT `o 15 r 15(4) the provisions of Order 9, Rule 25(12) apply to the application for directions` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(4) the provisions of Order 9, Rule 25(12) apply to the application for directions` FALSE EQUALS NOTHING
#ASSERT `o 15 r 15(5) the Court may give directions as to the time by which a notice of appointment for assessment of damages must be filed` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(5) the Court may give directions as to the time by which a notice of appointment for assessment of damages must be filed` FALSE EQUALS NOTHING
#ASSERT `o 15 r 15(5) the notice of appointment is served in time` (Date 19 12 2025) (Date 19 12 2025) EQUALS JUST TRUE -- filed on 5 December 2025: 14 days end on 19 December
#ASSERT `o 15 r 15(5) the notice of appointment is served in time` (Date 20 12 2025) (Date 19 12 2025) EQUALS JUST FALSE
#ASSERT `o 15 r 15(6) the damages must be assessed until the date of decision in the assessment` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(6) the damages must be assessed until the date of decision in the assessment` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 15(7) the Court may make an award for provisional damages` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(7) the Court may make an award for provisional damages` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 15(8) the claim must be pleaded` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(8) the claim must be pleaded` FALSE EQUALS NOTHING
#ASSERT `o 15 r 15(9) the award must specify the contingency and the period for applying for future damages` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(9) the award must specify the contingency and the period for applying for future damages` FALSE EQUALS NOTHING
#ASSERT `o 15 r 15(10) the Court may specify a different period for each contingency` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(10) the Court may specify a different period for each contingency` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 15(11) the Court may extend the period in paragraph (9) or (10)` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(11) the Court may extend the period in paragraph (9) or (10)` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 15(12) the claimant may make another application for further damages in respect of the contingency` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 15(12) the claimant may make another application for further damages in respect of the contingency` TRUE EQUALS JUST FALSE -- "only one application"
#ASSERT `o 15 r 15(13) the application for further damages must be served on the defendant's insurers` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(13) the application for further damages must be served on the defendant's insurers` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 15(13) the application for further damages must be served on the defendant` EQUALS JUST TRUE
#ASSERT `o 15 r 15(14) the Court hearing the application for further damages must give the appropriate directions for the assessment of the further damages` EQUALS JUST TRUE
#ASSERT `o 15 r 15(15) the Court may order the damages to be paid in periodic instalments instead of one amount` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(15) the Court may order the damages to be paid in periodic instalments instead of one amount` FALSE EQUALS NOTHING
#ASSERT `o 15 r 15(16) the Court may be guided by actuarial tables and other guidelines issued in practice directions` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(16) the Court may be guided by actuarial tables and other guidelines issued in practice directions` FALSE EQUALS NOTHING
#ASSERT `o 15 r 15(17) the Court must give the appropriate directions for the taking of accounts` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 15(17) the Court must give the appropriate directions for the taking of accounts` FALSE EQUALS JUST FALSE

-- Rule 16
#ASSERT `o 15 r 16(6) the period before the first date of the hearing for the notice of objection`'s `period length` EQUALS 28
#ASSERT `o 15 r 16(6) the period before the first date of the hearing for the notice of objection`'s `period direction` EQUALS `Before the anchor`
#ASSERT `o 15 r 16(1) the trial must be decided on the basis of the affidavits of evidence-in-chief, cross-examination, re-examination and submissions` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 16(1) the trial must be decided on the basis of the affidavits of evidence-in-chief, cross-examination, re-examination and submissions` FALSE EQUALS NOTHING
#ASSERT `o 15 r 16(2) the Court may allow a witness' evidence-in-chief to be given orally instead of by affidavit` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 16(2) the Court may allow a witness' evidence-in-chief to be given orally instead of by affidavit` FALSE EQUALS NOTHING
#ASSERT `o 15 r 16(3) the affidavit of evidence-in-chief may be used` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 16(3) the affidavit of evidence-in-chief may be used` FALSE TRUE EQUALS NOTHING -- parties otherwise agree
#ASSERT `o 15 r 16(3) the affidavit of evidence-in-chief may be used` TRUE FALSE EQUALS NOTHING -- the maker attends: the paragraph is silent
#ASSERT `o 15 r 16(4) the new fact may be given in oral evidence` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 16(4) the new fact may be given in oral evidence` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 16(5) the affidavit of evidence-in-chief may contain the evidence` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 16(5) the affidavit of evidence-in-chief may contain the evidence` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 16(6) the party must give notice of objection to the party relying on the affidavits` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 16(6) the party must give notice of objection to the party relying on the affidavits` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 16(6) the notice of objection is given in time` TRUE (Date 3 11 2025) (Date 3 11 2025) EQUALS JUST TRUE -- first hearing date 1 December 2025: the 28 days end on 3 November
#ASSERT `o 15 r 16(6) the notice of objection is given in time` TRUE (Date 4 11 2025) (Date 3 11 2025) EQUALS JUST FALSE
#ASSERT `o 15 r 16(6) the notice of objection is given in time` FALSE (Date 3 11 2025) (Date 3 11 2025) EQUALS JUST FALSE -- not by the form specified in the practice directions
#ASSERT `o 15 r 16(7) the party must give notice by letter to all other parties` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 16(7) the party must give notice by letter to all other parties` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 16(7) the notice is given at the time the affidavits are served` (Date 3 11 2025) (Date 3 11 2025) EQUALS JUST TRUE
#ASSERT `o 15 r 16(7) the notice is given at the time the affidavits are served` (Date 4 11 2025) (Date 3 11 2025) EQUALS JUST FALSE
#ASSERT `o 15 r 16(8) the notice must state the grounds in section 32 of the Evidence Act that the party relies on` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 16(8) the notice must state the grounds in section 32 of the Evidence Act that the party relies on` FALSE EQUALS NOTHING
-- Rule 16(9): a notice for statements in a document.  Inputs: time and place; maker's name; maker passed away; date of death;
-- document maker differs; document maker's name; document maker passed away; their date of death; copy attached.
#ASSERT `o 15 r 16(9) the notice for statements contained in a document contains what the Rule requires` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE -- the simplest notice
#ASSERT `o 15 r 16(9) the notice for statements contained in a document contains what the Rule requires` TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE -- maker dead, date of death stated
#ASSERT `o 15 r 16(9) the notice for statements contained in a document contains what the Rule requires` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- maker dead, no date of death
#ASSERT `o 15 r 16(9) the notice for statements contained in a document contains what the Rule requires` TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- document maker differs, not named
#ASSERT `o 15 r 16(9) the notice for statements contained in a document contains what the Rule requires` TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- document maker differs and is dead
#ASSERT `o 15 r 16(9) the notice for statements contained in a document contains what the Rule requires` TRUE TRUE FALSE FALSE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- document maker dead, no date of death
#ASSERT `o 15 r 16(9) the notice for statements contained in a document contains what the Rule requires` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- no copy of the document
#ASSERT `o 15 r 16(9) the notice for statements contained in a document contains what the Rule requires` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- no time and place
-- Rule 16(10): time and place; maker's name; maker passed away; date of death; orally or otherwise; the person who heard; substance.
#ASSERT `o 15 r 16(10) the notice for statements not contained in a document contains what the Rule requires` TRUE TRUE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 16(10) the notice for statements not contained in a document contains what the Rule requires` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 16(10) the notice for statements not contained in a document contains what the Rule requires` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- maker dead, no date of death
#ASSERT `o 15 r 16(10) the notice for statements not contained in a document contains what the Rule requires` TRUE TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE -- not said whether oral
#ASSERT `o 15 r 16(10) the notice for statements not contained in a document contains what the Rule requires` TRUE TRUE FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE -- the person who heard it not named
#ASSERT `o 15 r 16(10) the notice for statements not contained in a document contains what the Rule requires` TRUE TRUE FALSE FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- substance not stated
#ASSERT `o 15 r 16(11) the Court may accept the matter as fact` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 16(11) the Court may accept the matter as fact` FALSE EQUALS NOTHING
