IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc9-order-40`

-- Tests for roc9-order-40.l4.  Expected values are written from the text of Order 40 (lines 5584-5810) before the run.
-- Records are built with positional OF in DECLARE order.  The generated blocks (service, contents, filing) test every person
-- or item in turn; the hand-written tests follow the text rule by rule.

-- ---- Rule 1 (lines 5586-5591) ----
#ASSERT `o 40 r 1(1) a statute is the Act` TRUE EQUALS JUST TRUE
#ASSERT `o 40 r 1(1) a statute is the Act` FALSE EQUALS JUST FALSE
#ASSERT `o 40 r 1(1) a reference to a section is a reference to a section in the Act` TRUE FALSE EQUALS JUST TRUE
-- "unless it is otherwise expressly provided"
#ASSERT `o 40 r 1(1) a reference to a section is a reference to a section in the Act` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 40 r 1(1) a reference to a section is a reference to a section in the Act` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 40 r 1(2) the expression has the same meaning in this Order as in the Act` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 40 r 1(2) the expression has the same meaning in this Order as in the Act` TRUE FALSE EQUALS NOTHING
#ASSERT `o 40 r 1(2) the expression has the same meaning in this Order as in the Act` FALSE TRUE EQUALS NOTHING
#ASSERT `o 40 r 1(3) the application is made in the way the Rule requires` TRUE `o 40 r 1(3) by summons in the action` EQUALS JUST TRUE
#ASSERT `o 40 r 1(3) the application is made in the way the Rule requires` FALSE `o 40 r 1(3) by originating application` EQUALS JUST TRUE
#ASSERT `o 40 r 1(3) the application is made in the way the Rule requires` TRUE `o 40 r 1(3) by originating application` EQUALS NOTHING
#ASSERT `o 40 r 1(3) the application is made in the way the Rule requires` FALSE `o 40 r 1(3) by summons in the action` EQUALS NOTHING
#ASSERT `o 40 r 1(3) the application is made in the way the Rule requires` TRUE `o 40 r 1(3) in some other way` EQUALS NOTHING

