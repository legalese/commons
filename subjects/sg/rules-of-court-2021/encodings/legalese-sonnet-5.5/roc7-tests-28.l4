IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc7-order-28`

-- Rules of Court 2021 (Singapore): TESTS for roc7-order-28.
-- Expected values are written from the text of the rule named after each assertion (the comment on its line),
-- never copied from what the code printed.  The gate-shaped rules (a MAYBE BOOLEAN over BOOLEAN conditions) are tested
-- by the kind of the rule: every condition met; then each condition missing in turn.


-- Hand-written tests for the rules of Order 28 that are not plain gates.  Dates: 1 January 2026 is a Thursday, so
-- 3 and 4 January 2026 are a Saturday and a Sunday and 5 January is a Monday.

`o 28 r 11 test calendar with no public holidays` MEANS `Court calendar` WITH `public holidays` IS EMPTY
`o 28 r 11 test calendar with 5 January 2026 a public holiday` MEANS `Court calendar` WITH `public holidays` IS LIST Date 5 1 2026

`o 28 r 10 test moment 5 January 2026 at 9 a.m.` MEANS Moment WITH `day of the moment` IS Date 5 1 2026, `minutes after midnight` IS 540
`o 28 r 10 test moment 5 January 2026 at 10 a.m.` MEANS Moment WITH `day of the moment` IS Date 5 1 2026, `minutes after midnight` IS 600
`o 28 r 10 test moment 6 January 2026 at 11 a.m.` MEANS Moment WITH `day of the moment` IS Date 6 1 2026, `minutes after midnight` IS 660
`o 28 r 10 test moment 4 January 2026 at 4.40 p.m.` MEANS Moment WITH `day of the moment` IS Date 4 1 2026, `minutes after midnight` IS 1000
`o 28 r 11 test moment Saturday 3 January 2026 at 10 a.m.` MEANS Moment WITH `day of the moment` IS Date 3 1 2026, `minutes after midnight` IS 600
`o 28 r 11 test moment Wednesday 7 January 2026 at 10 a.m.` MEANS Moment WITH `day of the moment` IS Date 7 1 2026, `minutes after midnight` IS 600

-- r 1: "unless the context otherwise requires"
#ASSERT `o 28 r 1 a defined term has its defined meaning` FALSE EQUALS JUST TRUE -- the context does not require otherwise
#ASSERT `o 28 r 1 a defined term has its defined meaning` TRUE EQUALS NOTHING -- the context requires otherwise: the definition does not answer
-- r 1 "deemed": until the contrary is proved
#ASSERT `o 28 r 1 a deeming under this Order stands` FALSE EQUALS JUST TRUE -- the contrary is not proved
#ASSERT `o 28 r 1 a deeming under this Order stands` TRUE EQUALS JUST FALSE -- the contrary is proved: the deeming ends
-- r 1 "entity": the listed bodies are entities, any other is not ("means")
#ASSERT `o 28 r 1 a body is an entity` `o 28 r 1 sole proprietorship` EQUALS JUST TRUE -- a sole proprietorship
#ASSERT `o 28 r 1 a body is an entity` `o 28 r 1 law corporation` EQUALS JUST TRUE -- a law corporation
#ASSERT `o 28 r 1 a body is an entity` `o 28 r 1 company or other body corporate` EQUALS JUST TRUE -- a company
#ASSERT `o 28 r 1 a body is an entity` `o 28 r 1 the Attorney-General's Chambers` EQUALS JUST TRUE -- the Attorney-General's Chambers
#ASSERT `o 28 r 1 a body is an entity` `o 28 r 1 department of the Government` EQUALS JUST TRUE -- a department of the Government
#ASSERT `o 28 r 1 a body is an entity` `o 28 r 1 public authority` EQUALS JUST TRUE -- a public authority
#ASSERT `o 28 r 1 a body is an entity` `o 28 r 1 incorporated or unincorporated partnership (including a limited liability partnership and a limited partnership)` EQUALS JUST TRUE -- a partnership
#ASSERT `o 28 r 1 a body is an entity` `o 28 r 1 any other kind of body` EQUALS JUST FALSE -- not in the closed list

-- r 5(2): an appointed agent is not treated as such for accepting payment
#ASSERT `o 28 r 5(2) an appointed agent is treated as an agent for accepting payment of fees or service charges` TRUE EQUALS JUST FALSE -- "is not treated as such"
#ASSERT `o 28 r 5(2) an appointed agent is treated as an agent for accepting payment of fees or service charges` FALSE EQUALS NOTHING -- not an agent appointed under paragraph (1)

-- r 7(1): the fee is payable by each registered user "other than a service bureau"
#ASSERT `o 28 r 7(1) the fee is payable by the registered user` FALSE EQUALS JUST TRUE -- not a service bureau
#ASSERT `o 28 r 7(1) the fee is payable by the registered user` TRUE EQUALS NOTHING -- a service bureau: taken out of the class (QE default)

-- r 7(1)(a) to (h): every band, both edges
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 0 EQUALS NOTHING -- no band describes 0
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 1 EQUALS JUST 25 -- (a) a single advocate and solicitor: $25
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 2 EQUALS JUST 35 -- (b) 2 to 5: $35
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 5 EQUALS JUST 35 -- (b) upper edge
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 6 EQUALS JUST 70 -- (c) 6 to 9: $70
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 9 EQUALS JUST 70 -- (c) upper edge
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 10 EQUALS JUST 140 -- (d) 10 to 19: $140
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 19 EQUALS JUST 140 -- (d) upper edge
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 20 EQUALS JUST 250 -- (e) 20 to 49: $250
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 49 EQUALS JUST 250 -- (e) upper edge
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 50 EQUALS JUST 500 -- (f) 50 to 99: $500
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 99 EQUALS JUST 500 -- (f) upper edge
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 100 EQUALS JUST 1000 -- (g) 100 to 199: $1,000
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 199 EQUALS JUST 1000 -- (g) upper edge
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 200 EQUALS JUST 2000 -- (h) 200 or more: $2,000
#ASSERT `o 28 r 7(1) the monthly fee for a registered user` 5000 EQUALS JUST 2000 -- (h) far above
#ASSERT `o 28 r 7(1) the fee for a number of months or parts of a month` 1 3 EQUALS JUST 75 -- $25 a month for 3 months or parts of a month
#ASSERT `o 28 r 7(1) the fee for a number of months or parts of a month` 7 2 EQUALS JUST 140 -- $70 a month for 2 months
#ASSERT `o 28 r 7(1) the fee for a number of months or parts of a month` 0 3 EQUALS NOTHING -- no band

-- r 7(2): who is counted
`o 28 r 7(2) test headcounts` MEANS `o 28 r 7(2) headcounts` WITH
    `o 28 r 7(2) advocates and solicitors` IS 3
    `o 28 r 7(2)(a) the Attorney-General, a Deputy Attorney-General, the Solicitor-General or a State Counsel or Deputy Public Prosecutor` IS 4
    `o 28 r 7(2)(b) persons employed or engaged by the registered user who have a right to appear before the court by virtue of a written law` IS 5
    `o 28 r 7(2)(c) authorised users designated by the registered user` IS 6
    `o 28 r 7(2)(d) registered foreign lawyers` IS 7
#ASSERT `o 28 r 7(2) paragraph (1) applies with a modification` `o 28 r 7(2)(a) the Attorney-General's Chambers` EQUALS JUST TRUE -- context (a)
#ASSERT `o 28 r 7(2) paragraph (1) applies with a modification` `o 28 r 7(2)(e) an entity comprising advocates and solicitors and registered foreign lawyers` EQUALS JUST TRUE -- context (e)
#ASSERT `o 28 r 7(2) paragraph (1) applies with a modification` `o 28 r 7(2) any other registered user` EQUALS JUST FALSE -- no listed context
#ASSERT `o 28 r 7(2) the number counted in place of advocates and solicitors` `o 28 r 7(2)(a) the Attorney-General's Chambers` `o 28 r 7(2) test headcounts` EQUALS 4 -- (a)
#ASSERT `o 28 r 7(2) the number counted in place of advocates and solicitors` `o 28 r 7(2)(b) a department of the Government or a public authority` `o 28 r 7(2) test headcounts` EQUALS 5 -- (b)
#ASSERT `o 28 r 7(2) the number counted in place of advocates and solicitors` `o 28 r 7(2)(c) an entity registered solely to search or inspect under Order 26, Rule 3` `o 28 r 7(2) test headcounts` EQUALS 6 -- (c)
#ASSERT `o 28 r 7(2) the number counted in place of advocates and solicitors` `o 28 r 7(2)(d) an entity comprising registered foreign lawyers and no advocate and solicitor` `o 28 r 7(2) test headcounts` EQUALS 7 -- (d)
#ASSERT `o 28 r 7(2) the number counted in place of advocates and solicitors` `o 28 r 7(2)(e) an entity comprising advocates and solicitors and registered foreign lawyers` `o 28 r 7(2) test headcounts` EQUALS 10 -- (e) an advocate and solicitor or a registered foreign lawyer: 3 + 7
#ASSERT `o 28 r 7(2) the number counted in place of advocates and solicitors` `o 28 r 7(2) any other registered user` `o 28 r 7(2) test headcounts` EQUALS 3 -- paragraph (1) unmodified

-- r 7(4): the relevant time
#ASSERT `o 28 r 7(4) the relevant time` `o 28 r 7(4)(a) 1 May in any year` 2026 (Date 20 3 2026) (Date 1 1 2026) EQUALS JUST (Date 1 5 2026) -- (a) 1 May of the year
#ASSERT `o 28 r 7(4) the relevant time` `o 28 r 7(4)(b) the entity registers for the first time under Rule 6` 2026 (Date 20 3 2026) (Date 1 1 2026) EQUALS JUST (Date 20 3 2026) -- (b) the date of first registration
#ASSERT `o 28 r 7(4) the relevant time` `o 28 r 7(4)(c) the entity is deemed registered before 1 April 2022` 2026 (Date 20 3 2026) (Date 1 1 2026) EQUALS JUST (Date 1 4 2022) -- (c) 1 April 2022
#ASSERT `o 28 r 7(4) the relevant time` `o 28 r 7(4)(d) the registered user informs the Registrar after 1 May of a change in the number of advocates and solicitors` 2026 (Date 20 3 2026) (Date 15 6 2026) EQUALS JUST (Date 15 6 2026) -- (d) the day the Registrar is informed
#ASSERT `o 28 r 7(4) the relevant time` `o 28 r 7(4)(d) the registered user informs the Registrar after 1 May of a change in the number of advocates and solicitors` 2026 (Date 20 3 2026) (Date 2 5 2026) EQUALS JUST (Date 2 5 2026) -- (d) the day after 1 May
#ASSERT `o 28 r 7(4) the relevant time` `o 28 r 7(4)(d) the registered user informs the Registrar after 1 May of a change in the number of advocates and solicitors` 2026 (Date 20 3 2026) (Date 1 5 2026) EQUALS NOTHING -- (d) on 1 May is not "after 1 May"
#ASSERT `o 28 r 7(4) a relevant time arises in this way` `o 28 r 7(4)(a) 1 May in any year` FALSE FALSE 2026 (Date 1 1 2026) EQUALS JUST TRUE -- (a) with neither (b) nor (c)
#ASSERT `o 28 r 7(4) a relevant time arises in this way` `o 28 r 7(4)(a) 1 May in any year` TRUE FALSE 2026 (Date 1 1 2026) EQUALS JUST FALSE -- (a) unless (b) applies
#ASSERT `o 28 r 7(4) a relevant time arises in this way` `o 28 r 7(4)(a) 1 May in any year` FALSE TRUE 2026 (Date 1 1 2026) EQUALS JUST FALSE -- (a) unless (c) applies
#ASSERT `o 28 r 7(4) a relevant time arises in this way` `o 28 r 7(4)(b) the entity registers for the first time under Rule 6` FALSE FALSE 2026 (Date 1 1 2026) EQUALS JUST TRUE -- (b)
#ASSERT `o 28 r 7(4) a relevant time arises in this way` `o 28 r 7(4)(c) the entity is deemed registered before 1 April 2022` FALSE FALSE 2026 (Date 1 1 2026) EQUALS JUST TRUE -- (c)
#ASSERT `o 28 r 7(4) a relevant time arises in this way` `o 28 r 7(4)(d) the registered user informs the Registrar after 1 May of a change in the number of advocates and solicitors` FALSE FALSE 2026 (Date 2 5 2026) EQUALS JUST TRUE -- (d) after 1 May
#ASSERT `o 28 r 7(4) a relevant time arises in this way` `o 28 r 7(4)(d) the registered user informs the Registrar after 1 May of a change in the number of advocates and solicitors` FALSE FALSE 2026 (Date 1 5 2026) EQUALS JUST FALSE -- (d) on 1 May is not after it

-- r 7(5), (6): from which month, and the day each month's fee falls due
#ASSERT `o 28 r 7(5) the fee is payable for the month` (Date 15 6 2026) (Date 1 6 2026) EQUALS JUST TRUE -- the first month in which the relevant time falls
#ASSERT `o 28 r 7(5) the fee is payable for the month` (Date 15 6 2026) (Date 30 6 2026) EQUALS JUST TRUE -- the same month, another day
#ASSERT `o 28 r 7(5) the fee is payable for the month` (Date 15 6 2026) (Date 31 5 2026) EQUALS JUST FALSE -- the month before the first
#ASSERT `o 28 r 7(5) the fee is payable for the month` (Date 15 6 2026) (Date 1 7 2026) EQUALS JUST TRUE -- "continues to be payable monthly"
#ASSERT `o 28 r 7(5) the fee is payable for the month` (Date 15 6 2026) (Date 1 1 2027) EQUALS JUST TRUE -- a later year
#ASSERT `o 28 r 7(5) the fee is payable for the month` (Date 15 6 2026) (Date 1 12 2025) EQUALS JUST FALSE -- an earlier year
#ASSERT `o 28 r 7(6) the day the fee for a month is due and payable` 2026 3 EQUALS Date 1 3 2026 -- the first day of the month
#ASSERT `o 28 r 7(6) the fee for the month is due and payable on the day` (Date 1 3 2026) 2026 3 EQUALS JUST TRUE -- the first day
#ASSERT `o 28 r 7(6) the fee for the month is due and payable on the day` (Date 2 3 2026) 2026 3 EQUALS JUST FALSE -- not the first day

-- r 7(8)(a): refund where the claim was made in writing within 3 months (QD: the companion says whether the duty arises)
#ASSERT `o 28 r 7(8)(a) the Registrar must refund the amount paid in excess or error (the duty arises)` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE -- claim in writing within the 3 months
#ASSERT `o 28 r 7(8)(a) the Registrar must refund the amount paid in excess or error (the duty arises)` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE -- the 3 months ran out: the period is fixed in the text's own words
#ASSERT `o 28 r 7(8)(a) the Registrar must refund the amount paid in excess or error (the duty arises)` TRUE TRUE NOTHING EQUALS NOTHING -- the 3 months still running or undecided
#ASSERT `o 28 r 7(8)(a) the Registrar must refund the amount paid in excess or error (the duty arises)` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE -- no claim in writing: an "if" the text sets, unmet
#ASSERT `o 28 r 7(8)(a) the Registrar must refund the amount paid in excess or error (the duty arises)` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE -- nothing paid in excess or error
#ASSERT `o 28 r 7(8)(a) the Registrar must refund the amount paid in excess or error` TRUE TRUE (JUST TRUE) TRUE EQUALS JUST TRUE -- the duty arose and the Registrar refunded
#ASSERT `o 28 r 7(8)(a) the Registrar must refund the amount paid in excess or error` TRUE TRUE (JUST TRUE) FALSE EQUALS NOTHING -- the duty arose and no refund yet: a bare must
#ASSERT `o 28 r 7(8)(a) the Registrar must refund the amount paid in excess or error` TRUE TRUE (JUST FALSE) TRUE EQUALS NOTHING -- the duty did not arise
#ASSERT `o 28 r 7(8)(a) the Registrar must refund the amount paid in excess or error` FALSE TRUE (JUST TRUE) FALSE EQUALS NOTHING -- nothing paid in excess or error
-- the helper (shared by every period function): done by the last day
#ASSERT `o 28 r 7(8)(a) the act is done by the last day` (JUST (Date 14 6 2026)) (Date 14 6 2026) (Date 20 6 2026) EQUALS JUST TRUE -- on the last day
#ASSERT `o 28 r 7(8)(a) the act is done by the last day` (JUST (Date 15 6 2026)) (Date 14 6 2026) (Date 20 6 2026) EQUALS JUST FALSE -- the day after

-- r 8(3): "one of 2 ways"
#ASSERT `o 28 r 8(3) the way of using the electronic filing service is one of the 2 ways` TRUE FALSE EQUALS JUST TRUE -- by electronic transmission
#ASSERT `o 28 r 8(3) the way of using the electronic filing service is one of the 2 ways` FALSE TRUE EQUALS JUST TRUE -- via a service bureau
#ASSERT `o 28 r 8(3) the way of using the electronic filing service is one of the 2 ways` FALSE FALSE EQUALS JUST FALSE -- neither
-- r 8(5): the form
#ASSERT `o 28 r 8(5) the form of the document is as required` TRUE FALSE FALSE EQUALS JUST TRUE -- (a) practice directions
#ASSERT `o 28 r 8(5) the form of the document is as required` FALSE TRUE FALSE EQUALS JUST TRUE -- (b) remotely composed
#ASSERT `o 28 r 8(5) the form of the document is as required` FALSE FALSE TRUE EQUALS JUST TRUE -- Order 3, Rule 6 in the absence of prescription
#ASSERT `o 28 r 8(5) the form of the document is as required` FALSE FALSE FALSE EQUALS NOTHING -- none: a bare "must" not met

-- r 10(1): the deeming, and the caveat exception
#ASSERT `o 28 r 10(1) the document is deemed filed, served, delivered or conveyed` TRUE TRUE FALSE EQUALS JUST TRUE -- used the service, accepted, contrary not proved
#ASSERT `o 28 r 10(1) the document is deemed filed, served, delivered or conveyed` TRUE TRUE TRUE EQUALS JUST FALSE -- contrary proved
#ASSERT `o 28 r 10(1) the document is deemed filed, served, delivered or conveyed` TRUE FALSE FALSE EQUALS JUST FALSE -- not accepted: "is subsequently accepted"
#ASSERT `o 28 r 10(1) the document is deemed filed, served, delivered or conveyed` FALSE TRUE FALSE EQUALS JUST FALSE -- not through the service
#ASSERT `o 28 r 10(2) paragraph (1) applies to the document` TRUE FALSE EQUALS JUST FALSE -- a caveat under Order 33, Rule 5
#ASSERT `o 28 r 10(2) paragraph (1) applies to the document` FALSE TRUE EQUALS JUST FALSE -- a caveat under Order 33, Rule 14
#ASSERT `o 28 r 10(2) paragraph (1) applies to the document` FALSE FALSE EQUALS NOTHING -- any other document: paragraph (2) is silent
-- r 10 (S-F1): the moment
#ASSERT `o 28 r 10 the moment the document is deemed filed` `o 28 r 10(1)(a) by electronic transmission from the computer system of the authorised user or registered user` FALSE `o 28 r 10 test moment 5 January 2026 at 9 a.m.` `o 28 r 10 test moment 5 January 2026 at 10 a.m.` `o 28 r 10 test moment 6 January 2026 at 11 a.m.` NOTHING EQUALS `o 28 r 10 test moment 5 January 2026 at 9 a.m.` -- (1)(a): retrievable in the provider's system
#ASSERT `o 28 r 10 the moment the document is deemed filed` `o 28 r 10(1)(b) remotely composed on the computer system of the electronic filing service provider` FALSE `o 28 r 10 test moment 5 January 2026 at 9 a.m.` `o 28 r 10 test moment 5 January 2026 at 10 a.m.` `o 28 r 10 test moment 6 January 2026 at 11 a.m.` NOTHING EQUALS `o 28 r 10 test moment 5 January 2026 at 9 a.m.` -- (1)(b): retrievable in the provider's system
#ASSERT `o 28 r 10 the moment the document is deemed filed` `o 28 r 10(1)(c) via a service bureau` FALSE `o 28 r 10 test moment 5 January 2026 at 9 a.m.` `o 28 r 10 test moment 5 January 2026 at 10 a.m.` `o 28 r 10 test moment 6 January 2026 at 11 a.m.` NOTHING EQUALS `o 28 r 10 test moment 5 January 2026 at 10 a.m.` -- (1)(c): retrievable in the Registrar's system
#ASSERT `o 28 r 10 the moment the document is deemed filed` `o 28 r 10(1)(a) by electronic transmission from the computer system of the authorised user or registered user` TRUE `o 28 r 10 test moment 5 January 2026 at 9 a.m.` `o 28 r 10 test moment 5 January 2026 at 10 a.m.` `o 28 r 10 test moment 6 January 2026 at 11 a.m.` NOTHING EQUALS `o 28 r 10 test moment 6 January 2026 at 11 a.m.` -- (3)(a): a caveat is filed when the Registrar accepts it
#ASSERT `o 28 r 10 the moment the document is deemed filed` `o 28 r 10(1)(c) via a service bureau` TRUE `o 28 r 10 test moment 5 January 2026 at 9 a.m.` `o 28 r 10 test moment 5 January 2026 at 10 a.m.` `o 28 r 10 test moment 6 January 2026 at 11 a.m.` NOTHING EQUALS `o 28 r 10 test moment 6 January 2026 at 11 a.m.` -- (3)(b): the same via a service bureau
#ASSERT `o 28 r 10 the moment the document is deemed filed` `o 28 r 10(1)(a) by electronic transmission from the computer system of the authorised user or registered user` FALSE `o 28 r 10 test moment 5 January 2026 at 9 a.m.` `o 28 r 10 test moment 5 January 2026 at 10 a.m.` `o 28 r 10 test moment 6 January 2026 at 11 a.m.` (JUST (`o 28 r 10 test moment 4 January 2026 at 4.40 p.m.`)) EQUALS `o 28 r 10 test moment 4 January 2026 at 4.40 p.m.` -- (6): the earlier moment the Registrar caused the service to reflect
#ASSERT `o 28 r 10(4) the moment the originating process is deemed issued` FALSE `o 28 r 10 test moment 5 January 2026 at 9 a.m.` `o 28 r 10 test moment 5 January 2026 at 10 a.m.` EQUALS `o 28 r 10 test moment 5 January 2026 at 9 a.m.` -- (4)(a): the provider's system
#ASSERT `o 28 r 10(4) the moment the originating process is deemed issued` TRUE `o 28 r 10 test moment 5 January 2026 at 9 a.m.` `o 28 r 10 test moment 5 January 2026 at 10 a.m.` EQUALS `o 28 r 10 test moment 5 January 2026 at 10 a.m.` -- (4)(b): the Registrar's system

-- r 11: when time for service begins
#ASSERT `o 28 r 11(1) time for service cannot yet begin to run` FALSE EQUALS JUST TRUE -- notification not yet received
#ASSERT `o 28 r 11(1) time for service cannot yet begin to run` TRUE EQUALS JUST FALSE -- notification received
#ASSERT `o 28 r 11(1) time for service has begun to run` TRUE EQUALS JUST TRUE -- notification received
#ASSERT `o 28 r 11(1) time for service has begun to run` FALSE EQUALS JUST FALSE -- "only begins to run from" the receipt
#ASSERT `o 28 r 11(3) the first working day on or after` (Date 3 1 2026) `o 28 r 11 test calendar with no public holidays` 14 EQUALS Date 5 1 2026 -- Saturday to Monday
#ASSERT `o 28 r 11(3) the first working day on or after` (Date 3 1 2026) `o 28 r 11 test calendar with 5 January 2026 a public holiday` 14 EQUALS Date 6 1 2026 -- Monday a public holiday: Tuesday
#ASSERT `o 28 r 11(3) the first working day on or after` (Date 2 1 2026) `o 28 r 11 test calendar with no public holidays` 14 EQUALS Date 2 1 2026 -- Friday is a working day
#ASSERT (`o 28 r 11 the moment time for service begins to run` `o 28 r 10(1)(a) by electronic transmission from the computer system of the authorised user or registered user` `o 28 r 11 test moment Saturday 3 January 2026 at 10 a.m.` `o 28 r 11 test moment Wednesday 7 January 2026 at 10 a.m.` `o 28 r 11 test calendar with no public holidays`)'s `day of the moment` EQUALS Date 5 1 2026 -- (1) received on a Saturday: deemed received on the next working day, Monday
#ASSERT (`o 28 r 11 the moment time for service begins to run` `o 28 r 10(1)(a) by electronic transmission from the computer system of the authorised user or registered user` `o 28 r 11 test moment Saturday 3 January 2026 at 10 a.m.` `o 28 r 11 test moment Wednesday 7 January 2026 at 10 a.m.` `o 28 r 11 test calendar with no public holidays`)'s `minutes after midnight` EQUALS 0 -- the text gives the day only (fork F-28-2)
#ASSERT (`o 28 r 11 the moment time for service begins to run` `o 28 r 10(1)(c) via a service bureau` `o 28 r 11 test moment Saturday 3 January 2026 at 10 a.m.` `o 28 r 11 test moment Wednesday 7 January 2026 at 10 a.m.` `o 28 r 11 test calendar with no public holidays`)'s `day of the moment` EQUALS Date 7 1 2026 -- (2) via a service bureau: the bureau's receipt, a Wednesday, unchanged
#ASSERT (`o 28 r 11 the moment time for service begins to run` `o 28 r 10(1)(c) via a service bureau` `o 28 r 11 test moment Saturday 3 January 2026 at 10 a.m.` `o 28 r 11 test moment Wednesday 7 January 2026 at 10 a.m.` `o 28 r 11 test calendar with no public holidays`)'s `minutes after midnight` EQUALS 600 -- unchanged time of day

-- r 12: service
#ASSERT `o 28 r 12(1) service may be effected using the electronic filing service` FALSE FALSE TRUE EQUALS JUST TRUE -- not required to be served personally, and a user
#ASSERT `o 28 r 12(1) service may be effected using the electronic filing service` TRUE TRUE TRUE EQUALS JUST TRUE -- personal service, but the party agreed
#ASSERT `o 28 r 12(1) service may be effected using the electronic filing service` TRUE FALSE TRUE EQUALS JUST FALSE -- personal service and no agreement: the "If" is not met
#ASSERT `o 28 r 12(1) service may be effected using the electronic filing service` FALSE FALSE FALSE EQUALS JUST FALSE -- the person served is not a user: the "If" is not met
#ASSERT `o 28 r 12 the moment service is deemed effected` `o 28 r 10 test moment 5 January 2026 at 9 a.m.` EQUALS `o 28 r 10 test moment 5 January 2026 at 9 a.m.` -- (3): the moment it becomes capable of being retrieved by the provider
#ASSERT `o 28 r 12(11) Order 7, Rule 8 applies to the service` TRUE EQUALS JUST TRUE -- service under this Rule
#ASSERT `o 28 r 12(11) Order 7, Rule 8 applies to the service` FALSE EQUALS NOTHING -- not under this Rule
#ASSERT `o 28 r 12(11) the day service through the electronic filing service is deemed effected` TRUE (Date 6 1 2026) EQUALS JUST (Date 6 1 2026) -- the day Order 7, Rule 8 gives (an input)
#ASSERT `o 28 r 12(11) the day service through the electronic filing service is deemed effected` FALSE (Date 6 1 2026) EQUALS NOTHING -- not under this Rule

-- r 15(2)(c): retention of the original for 7 years (the last day of the 7 years is 31 December 2029)
#ASSERT `o 28 r 15(2)(c) the original paper affidavit is retained for 7 years` (JUST (Date 1 1 2030)) (Date 31 12 2029) (Date 1 6 2030) EQUALS JUST TRUE -- kept through the last day
#ASSERT `o 28 r 15(2)(c) the original paper affidavit is retained for 7 years` (JUST (Date 31 12 2029)) (Date 31 12 2029) (Date 1 6 2030) EQUALS JUST FALSE -- given up on the last day (boundary)
#ASSERT `o 28 r 15(2)(c) the original paper affidavit is retained for 7 years` (JUST (Date 1 1 2028)) (Date 31 12 2029) (Date 1 6 2030) EQUALS JUST FALSE -- given up within the 7 years
#ASSERT `o 28 r 15(2)(c) the original paper affidavit is retained for 7 years` NOTHING (Date 31 12 2029) (Date 1 6 2028) EQUALS NOTHING -- still held, the 7 years still running
#ASSERT `o 28 r 15(2)(c) the original paper affidavit is retained for 7 years` NOTHING (Date 31 12 2029) (Date 1 1 2030) EQUALS JUST TRUE -- still held after the last day

-- r 16: which information prevails
#ASSERT `o 28 r 16 the information contained in the document prevails` TRUE TRUE TRUE EQUALS JUST TRUE -- remotely composed: the document prevails
#ASSERT `o 28 r 16 the information entered into the electronic template prevails` TRUE TRUE TRUE EQUALS JUST FALSE -- remotely composed: the template does not
#ASSERT `o 28 r 16 the information contained in the document prevails` TRUE TRUE FALSE EQUALS JUST FALSE -- in all other cases the template prevails
#ASSERT `o 28 r 16 the information entered into the electronic template prevails` TRUE TRUE FALSE EQUALS JUST TRUE -- in all other cases the template prevails
#ASSERT `o 28 r 16 the information contained in the document prevails` TRUE FALSE TRUE EQUALS JUST FALSE -- no inconsistency
#ASSERT `o 28 r 16 the information entered into the electronic template prevails` FALSE TRUE FALSE EQUALS JUST FALSE -- not filed using the service


-- Gate and period assertions follow, written from the kind of each rule (every condition met; then each condition missing in turn).
#ASSERT `o 28 r 1 a person is an authorised user` TRUE EQUALS JUST TRUE -- O 28 r 1 “authorised user”: every condition met
#ASSERT `o 28 r 1 a person is an authorised user` FALSE EQUALS JUST FALSE -- O 28 r 1 “authorised user”: condition 1 missing
#ASSERT `o 28 r 1 a service is the electronic filing service` TRUE EQUALS JUST TRUE -- O 28 r 1 “electronic filing service”: every condition met
#ASSERT `o 28 r 1 a service is the electronic filing service` FALSE EQUALS JUST FALSE -- O 28 r 1 “electronic filing service”: condition 1 missing
