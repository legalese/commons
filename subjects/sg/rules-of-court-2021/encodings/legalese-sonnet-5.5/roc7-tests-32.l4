IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc7-order-32`

-- Rules of Court 2021 (Singapore): TESTS for roc7-order-32.
-- Expected values are written from the text of the rule named after each assertion (the comment on its line),
-- never copied from what the code printed.  The gate-shaped rules (a MAYBE BOOLEAN over BOOLEAN conditions) are tested
-- by the kind of the rule: every condition met; then each condition missing in turn.


-- Hand-written tests for Order 32.

#ASSERT `o 32 r 1 an action is an administration action` TRUE FALSE EQUALS JUST TRUE -- an action for the administration of an estate
#ASSERT `o 32 r 1 an action is an administration action` FALSE TRUE EQUALS JUST TRUE -- an action for the execution of a trust
#ASSERT `o 32 r 1 an action is an administration action` FALSE FALSE EQUALS JUST FALSE -- "means": neither
#ASSERT `o 32 r 1 a person is a personal representative` `o 32 r 1 an executor` EQUALS JUST TRUE -- "includes executors"
#ASSERT `o 32 r 1 a person is a personal representative` `o 32 r 1 an administrator` EQUALS JUST TRUE -- "includes administrators"
#ASSERT `o 32 r 1 a person is a personal representative` `o 32 r 1 a trustee` EQUALS JUST TRUE -- "includes ... trustees"
#ASSERT `o 32 r 1 a person is a personal representative` `o 32 r 1 any other kind of person` EQUALS NOTHING -- "includes": the list is not closed
#ASSERT `o 32 r 2(1) a claim for administration or execution must be made in the action` TRUE EQUALS JUST FALSE -- "need not be made"
#ASSERT `o 32 r 2(1) a claim for administration or execution must be made in the action` FALSE EQUALS NOTHING -- an action not under paragraph (1)
#ASSERT `o 32 r 2(2) an action may be brought for the determination of the question` `o 32 r 2(2)(a) a question arising in the administration of the estate of a deceased person or in the execution of a trust` EQUALS JUST TRUE -- (a)
#ASSERT `o 32 r 2(2) an action may be brought for the determination of the question` `o 32 r 2(2)(b) a question as to the composition of a class of persons having a claim against the estate or a beneficial interest in the estate or in property subject to a trust` EQUALS JUST TRUE -- (b)
#ASSERT `o 32 r 2(2) an action may be brought for the determination of the question` `o 32 r 2(2)(c) a question as to the rights or interests of a person claiming to be a creditor of the estate or to be entitled under a will or on the intestacy or to be beneficially entitled under a trust` EQUALS JUST TRUE -- (c)
#ASSERT `o 32 r 2(2) an action may be brought for the determination of the question` `o 32 r 2(2) any other question` EQUALS NOTHING -- "Without limiting paragraph (1)"
#ASSERT `o 32 r 2(3) an action may be brought for the relief` `o 32 r 2(3)(a) an order requiring a personal representative to provide and, if necessary, verify accounts` EQUALS JUST TRUE -- (a)
#ASSERT `o 32 r 2(3) an action may be brought for the relief` `o 32 r 2(3)(b) an order requiring the payment into Court of money held by a person as personal representative` EQUALS JUST TRUE -- (b)
#ASSERT `o 32 r 2(3) an action may be brought for the relief` `o 32 r 2(3)(c) an order directing a person to do or abstain from doing a particular act as personal representative` EQUALS JUST TRUE -- (c)
#ASSERT `o 32 r 2(3) an action may be brought for the relief` `o 32 r 2(3)(d) an order approving any sale, purchase, compromise or other transaction by a person as personal representative` EQUALS JUST TRUE -- (d)
#ASSERT `o 32 r 2(3) an action may be brought for the relief` `o 32 r 2(3)(e) an order directing any act to be done in the administration of the estate or the execution of a trust which the Court could order if it were being administered or executed under the direction of the Court` EQUALS JUST TRUE -- (e)
#ASSERT `o 32 r 2(3) an action may be brought for the relief` `o 32 r 2(3) any other relief` EQUALS NOTHING -- "Without limiting paragraph (1)"
#ASSERT `o 32 r 3(2) a person having a beneficial interest or claim must be a party` TRUE EQUALS JUST FALSE -- "need not be parties to the action"
#ASSERT `o 32 r 3(2) a person having a beneficial interest or claim must be a party` FALSE EQUALS NOTHING -- an action outside paragraph (1)
#ASSERT `o 32 r 3(3) a party other than the executors or administrators is entitled to appear` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- no permission: "no party other than the executors or administrators ... is entitled to appear"
#ASSERT `o 32 r 3(3) a party other than the executors or administrators is entitled to appear` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- permission given: with the permission the party is entitled to appear (QA)
#ASSERT `o 32 r 3(3) a party other than the executors or administrators is entitled to appear` TRUE TRUE FALSE FALSE EQUALS NOTHING -- the executors themselves: the paragraph is silent
#ASSERT `o 32 r 3(3) a party other than the executors or administrators is entitled to appear` TRUE FALSE TRUE FALSE EQUALS NOTHING -- a claim by a party: the paragraph is silent
#ASSERT `o 32 r 3(3) a party other than the executors or administrators is entitled to appear` FALSE TRUE TRUE FALSE EQUALS NOTHING -- outside proceedings under a judgment or order: silent
#ASSERT `o 32 r 5(1) a judgment or order for administration or execution need be given or made` FALSE EQUALS JUST FALSE -- "need not be given or made unless ..." the opinion not formed
#ASSERT `o 32 r 5(1) a judgment or order for administration or execution need be given or made` TRUE EQUALS NOTHING -- the opinion formed: the "unless" lifts the bar and grants nothing (QA)
#ASSERT `o 32 r 6 the personal representatives have the conduct of the sale` TRUE FALSE EQUALS JUST TRUE -- an order for sale and no contrary direction
#ASSERT `o 32 r 6 the personal representatives have the conduct of the sale` TRUE TRUE EQUALS JUST FALSE -- "unless the Court otherwise directs"
#ASSERT `o 32 r 6 the personal representatives have the conduct of the sale` FALSE FALSE EQUALS JUST FALSE -- "Where in an administration action an order is made for the sale": no such order


-- Gate and period assertions follow, written from the kind of each rule (every condition met; then each condition missing in turn).
#ASSERT `o 32 r 2(1) an action may be brought for a question or relief which could be had in an administration action` TRUE EQUALS JUST TRUE -- O 32 r 2(1): every condition met
#ASSERT `o 32 r 2(1) an action may be brought for a question or relief which could be had in an administration action` FALSE EQUALS NOTHING -- O 32 r 2(1): condition 1 missing
#ASSERT `o 32 r 3(1) all the personal representatives are parties to the action` TRUE TRUE EQUALS JUST TRUE -- O 32 r 3(1) all: every condition met
#ASSERT `o 32 r 3(1) all the personal representatives are parties to the action` FALSE TRUE EQUALS NOTHING -- O 32 r 3(1) all: condition 1 missing
#ASSERT `o 32 r 3(1) all the personal representatives are parties to the action` TRUE FALSE EQUALS NOTHING -- O 32 r 3(1) all: condition 2 missing
#ASSERT `o 32 r 3(1) all the personal representatives are parties to the action (the duty arises)` TRUE EQUALS JUST TRUE -- O 32 r 3(1) all: the duty arises
#ASSERT `o 32 r 3(1) all the personal representatives are parties to the action (the duty arises)` FALSE EQUALS JUST FALSE -- O 32 r 3(1) all: trigger or exception 1: the duty does not arise
#ASSERT `o 32 r 3(1) a personal representative who does not consent is made a defendant` TRUE TRUE TRUE EQUALS JUST TRUE -- O 32 r 3(1) defendant: every condition met
#ASSERT `o 32 r 3(1) a personal representative who does not consent is made a defendant` FALSE TRUE TRUE EQUALS NOTHING -- O 32 r 3(1) defendant: condition 1 missing
#ASSERT `o 32 r 3(1) a personal representative who does not consent is made a defendant` TRUE FALSE TRUE EQUALS NOTHING -- O 32 r 3(1) defendant: condition 2 missing
#ASSERT `o 32 r 3(1) a personal representative who does not consent is made a defendant` TRUE TRUE FALSE EQUALS NOTHING -- O 32 r 3(1) defendant: condition 3 missing
#ASSERT `o 32 r 3(1) a personal representative who does not consent is made a defendant (the duty arises)` TRUE TRUE EQUALS JUST TRUE -- O 32 r 3(1) defendant: the duty arises
#ASSERT `o 32 r 3(1) a personal representative who does not consent is made a defendant (the duty arises)` FALSE TRUE EQUALS JUST FALSE -- O 32 r 3(1) defendant: trigger or exception 1: the duty does not arise
#ASSERT `o 32 r 3(1) a personal representative who does not consent is made a defendant (the duty arises)` TRUE FALSE EQUALS JUST FALSE -- O 32 r 3(1) defendant: trigger or exception 2: the duty does not arise
#ASSERT `o 32 r 3(2) the claimant may make a person with a beneficial interest or claim a party` TRUE TRUE EQUALS JUST TRUE -- O 32 r 3(2) may: every condition met
#ASSERT `o 32 r 3(2) the claimant may make a person with a beneficial interest or claim a party` FALSE TRUE EQUALS NOTHING -- O 32 r 3(2) may: condition 1 missing
#ASSERT `o 32 r 3(2) the claimant may make a person with a beneficial interest or claim a party` TRUE FALSE EQUALS NOTHING -- O 32 r 3(2) may: condition 2 missing
#ASSERT `o 32 r 3(3) the Court may direct or allow another party to appear` TRUE TRUE TRUE EQUALS JUST TRUE -- O 32 r 3(3) Court may: every condition met
#ASSERT `o 32 r 3(3) the Court may direct or allow another party to appear` FALSE TRUE TRUE EQUALS JUST FALSE -- O 32 r 3(3) Court may: condition 1 missing
#ASSERT `o 32 r 3(3) the Court may direct or allow another party to appear` TRUE FALSE TRUE EQUALS JUST FALSE -- O 32 r 3(3) Court may: condition 2 missing
#ASSERT `o 32 r 3(3) the Court may direct or allow another party to appear` TRUE TRUE FALSE EQUALS NOTHING -- O 32 r 3(3) Court may: condition 3 missing
#ASSERT `o 32 r 4 the Court may grant relief for breach of trust even though the action began by originating application` TRUE TRUE EQUALS JUST TRUE -- O 32 r 4: every condition met
#ASSERT `o 32 r 4 the Court may grant relief for breach of trust even though the action began by originating application` FALSE TRUE EQUALS JUST FALSE -- O 32 r 4: condition 1 missing
#ASSERT `o 32 r 4 the Court may grant relief for breach of trust even though the action began by originating application` TRUE FALSE EQUALS NOTHING -- O 32 r 4: condition 2 missing
#ASSERT `o 32 r 4 the Court may order that the originating application be converted into an originating claim` TRUE TRUE EQUALS JUST TRUE -- O 32 r 4 conversion: every condition met
#ASSERT `o 32 r 4 the Court may order that the originating application be converted into an originating claim` FALSE TRUE EQUALS NOTHING -- O 32 r 4 conversion: condition 1 missing
#ASSERT `o 32 r 4 the Court may order that the originating application be converted into an originating claim` TRUE FALSE EQUALS NOTHING -- O 32 r 4 conversion: condition 2 missing
#ASSERT `o 32 r 5(2)(a) the Court may stay the action and order the personal representatives to provide accounts` TRUE TRUE TRUE EQUALS JUST TRUE -- O 32 r 5(2)(a): every condition met
#ASSERT `o 32 r 5(2)(a) the Court may stay the action and order the personal representatives to provide accounts` FALSE TRUE TRUE EQUALS JUST FALSE -- O 32 r 5(2)(a): condition 1 missing
#ASSERT `o 32 r 5(2)(a) the Court may stay the action and order the personal representatives to provide accounts` TRUE FALSE TRUE EQUALS JUST FALSE -- O 32 r 5(2)(a): condition 2 missing
#ASSERT `o 32 r 5(2)(a) the Court may stay the action and order the personal representatives to provide accounts` TRUE TRUE FALSE EQUALS NOTHING -- O 32 r 5(2)(a): condition 3 missing
#ASSERT `o 32 r 5(2)(b) the Court may give judgment or make an order for administration` TRUE TRUE TRUE EQUALS JUST TRUE -- O 32 r 5(2)(b): every condition met
#ASSERT `o 32 r 5(2)(b) the Court may give judgment or make an order for administration` FALSE TRUE TRUE EQUALS JUST FALSE -- O 32 r 5(2)(b): condition 1 missing
#ASSERT `o 32 r 5(2)(b) the Court may give judgment or make an order for administration` TRUE FALSE TRUE EQUALS JUST FALSE -- O 32 r 5(2)(b): condition 2 missing
#ASSERT `o 32 r 5(2)(b) the Court may give judgment or make an order for administration` TRUE TRUE FALSE EQUALS JUST FALSE -- O 32 r 5(2)(b): condition 3 missing
