IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc7-order-33a`

-- Rules of Court 2021 (Singapore): TESTS for roc7-order-33a.
-- Expected values are written from the text of the rule named after each assertion (the comment on its line),
-- never copied from what the code printed.  The gate-shaped rules (a MAYBE BOOLEAN over BOOLEAN conditions) are tested
-- by the kind of the rule: every condition met; then each condition missing in turn.


-- Hand-written tests for Order 33 rules 1 to 17.  Generated assertions (gates and periods) follow.

-- r 2(8): the claimant may apply for judgment in Form 50
#ASSERT `o 33 r 2(8) the claimant may apply for judgment in Form 50` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- late notice, application made
#ASSERT `o 33 r 2(8) the claimant may apply for judgment in Form 50` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- notice states no intent to contest
#ASSERT `o 33 r 2(8) the claimant may apply for judgment in Form 50` TRUE TRUE TRUE FALSE EQUALS NOTHING -- "may": not used
#ASSERT `o 33 r 2(8) the claimant may apply for judgment in Form 50` TRUE FALSE FALSE TRUE EQUALS JUST FALSE -- the defendant did neither: the "if" unmet
#ASSERT `o 33 r 2(8) the claimant may apply for judgment in Form 50` FALSE TRUE FALSE TRUE EQUALS JUST FALSE -- an action mentioned in Rule 3(1) or in rem: not this paragraph

-- r 3(1): scope
#ASSERT `o 33 r 3(1) this Rule applies to the action` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- a limitation action
#ASSERT `o 33 r 3(1) this Rule applies to the action` FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- collision claim
#ASSERT `o 33 r 3(1) this Rule applies to the action` FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- manoeuvre claim
#ASSERT `o 33 r 3(1) this Rule applies to the action` FALSE TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- collision regulations claim
#ASSERT `o 33 r 3(1) this Rule applies to the action` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING -- a claim of another kind: the Rule does not say it applies only to these
#ASSERT `o 33 r 3(1) this Rule applies to the action` FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING -- not commenced by originating claim containing the claim

-- r 3(2): service out of Singapore
#ASSERT `o 33 r 3(2) service out of Singapore is permissible` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE -- ground (a), permission given
#ASSERT `o 33 r 3(2) service out of Singapore is permissible` TRUE FALSE TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- ground (b)
#ASSERT `o 33 r 3(2) service out of Singapore is permissible` TRUE FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE -- ground (c)
#ASSERT `o 33 r 3(2) service out of Singapore is permissible` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE -- ground (d)
#ASSERT `o 33 r 3(2) service out of Singapore is permissible` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING -- ground (a) but no permission yet
#ASSERT `o 33 r 3(2) service out of Singapore is permissible` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- no ground
#ASSERT `o 33 r 3(2) service out of Singapore is permissible` FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- not a limitation action or a Rule 3(1) claim

-- r 4(3): the affidavit bar
#ASSERT `o 33 r 4(3) the warrant of arrest cannot yet be issued for want of the affidavit` FALSE EQUALS JUST TRUE -- no affidavit yet
#ASSERT `o 33 r 4(3) the warrant of arrest cannot yet be issued for want of the affidavit` TRUE EQUALS JUST FALSE -- affidavit filed
#ASSERT `o 33 r 4(3) a warrant of arrest may be issued` FALSE FALSE EQUALS JUST FALSE -- "must not be issued until": no affidavit, no allowance
#ASSERT `o 33 r 4(3) a warrant of arrest may be issued` TRUE FALSE EQUALS NOTHING -- affidavit filed: the until-bar has ended and nothing grants the act (QA)
#ASSERT `o 33 r 4(3) a warrant of arrest may be issued` FALSE TRUE EQUALS JUST TRUE -- the Court allowed: the allowance is the permission the sentence gives (QA)
#ASSERT `o 33 r 4(3) a warrant of arrest may be issued` TRUE TRUE EQUALS NOTHING -- affidavit filed and the Court allowed: the until-bar has ended, so the sentence grants nothing (QA)

-- r 4(4): the consul
#ASSERT `o 33 r 4(4) the warrant of arrest cannot yet be issued for want of notice to the consul` TRUE TRUE FALSE EQUALS JUST TRUE -- no notice sent
#ASSERT `o 33 r 4(4) the warrant of arrest cannot yet be issued for want of notice to the consul` TRUE TRUE TRUE EQUALS JUST FALSE -- notice sent
#ASSERT `o 33 r 4(4) the warrant of arrest cannot yet be issued for want of notice to the consul` FALSE TRUE FALSE EQUALS NOTHING -- not a foreign ship of that kind
#ASSERT `o 33 r 4(4) the warrant of arrest cannot yet be issued for want of notice to the consul` TRUE FALSE FALSE EQUALS NOTHING -- not an action for possession or wages
#ASSERT `o 33 r 4(4) a warrant of arrest may be issued against the foreign ship` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- neither notice nor permission
#ASSERT `o 33 r 4(4) a warrant of arrest may be issued against the foreign ship` TRUE TRUE TRUE FALSE EQUALS NOTHING -- notice sent: the until-bar has ended and nothing grants the act (QA)
#ASSERT `o 33 r 4(4) a warrant of arrest may be issued against the foreign ship` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- permission: the permission is the exception the sentence gives (QA)
#ASSERT `o 33 r 4(4) a warrant of arrest may be issued against the foreign ship` TRUE TRUE TRUE TRUE EQUALS NOTHING -- notice sent and permission given: the until-bar has ended, so the sentence grants nothing (QA)
#ASSERT `o 33 r 4(4) a warrant of arrest may be issued against the foreign ship` FALSE TRUE FALSE FALSE EQUALS NOTHING -- outside the paragraph

-- r 4(5) and the anchor
#ASSERT `o 33 r 4 a warrant of arrest is issued under this Rule` TRUE TRUE EQUALS JUST TRUE -- sealed
#ASSERT `o 33 r 4 a warrant of arrest is issued under this Rule` TRUE FALSE EQUALS JUST FALSE -- "takes place upon its being sealed"

-- r 4(7): the affidavit particulars; (d) bites only in a possession or wages claim
#ASSERT `o 33 r 4(7) the affidavit states what paragraph (7) requires` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- (a) to (c) stated, not a possession or wages claim
#ASSERT `o 33 r 4(7) the affidavit states what paragraph (7) requires` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- a wages claim and (d) not stated
#ASSERT `o 33 r 4(7) the affidavit states what paragraph (7) requires` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- a wages claim and (d) stated
#ASSERT `o 33 r 4(7) the affidavit states what paragraph (7) requires` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING -- (b) not stated
#ASSERT `o 33 r 4(7) the affidavit states what paragraph (7) requires` FALSE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING -- not an affidavit under section 4(4): the duty does not arise
#ASSERT `o 33 r 4(7) the affidavit states what paragraph (7) requires (the duty arises)` TRUE EQUALS JUST TRUE -- an affidavit under section 4(4)
#ASSERT `o 33 r 4(7) the affidavit states what paragraph (7) requires (the duty arises)` FALSE EQUALS JUST FALSE -- another affidavit

-- r 5 anchor
#ASSERT `o 33 r 5 a caveat against arrest is issued under this Rule` TRUE TRUE EQUALS JUST TRUE -- filed and entered
#ASSERT `o 33 r 5 a caveat against arrest is issued under this Rule` TRUE FALSE EQUALS NOTHING -- not entered: the Rule is silent about other caveats

-- r 7(3): the day of deemed service
#ASSERT `o 33 r 7(3) the day the originating claim is deemed duly served` (JUST (Date 5 3 2026)) NOTHING EQUALS JUST (Date 5 3 2026) -- (a) only
#ASSERT `o 33 r 7(3) the day the originating claim is deemed duly served` NOTHING (JUST (Date 6 3 2026)) EQUALS JUST (Date 6 3 2026) -- (b) only
#ASSERT `o 33 r 7(3) the day the originating claim is deemed duly served` (JUST (Date 5 3 2026)) (JUST (Date 6 3 2026)) EQUALS JUST (Date 5 3 2026) -- both: the earlier day
#ASSERT `o 33 r 7(3) the day the originating claim is deemed duly served` NOTHING NOTHING EQUALS NOTHING -- neither

-- r 7(11): the amended claim
#ASSERT `o 33 r 7(11) the amended originating claim is served as required` TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE -- a defendant has filed; served on the intervener and that defendant
#ASSERT `o 33 r 7(11) the amended originating claim is served as required` TRUE FALSE TRUE FALSE TRUE EQUALS NOTHING -- a defendant has filed; not served on them
#ASSERT `o 33 r 7(11) the amended originating claim is served as required` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE -- no defendant has filed; served or filed under paragraph (1)
#ASSERT `o 33 r 7(11) the amended originating claim is served as required` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING -- no defendant has filed; not yet served or filed
#ASSERT `o 33 r 7(11) the amended originating claim is served as required` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- "unless the Court otherwise directs": the duty does not apply
#ASSERT `o 33 r 7(11) the amended originating claim is served as required` FALSE FALSE TRUE TRUE TRUE EQUALS NOTHING -- not an amendment under this paragraph: the duty does not arise
#ASSERT `o 33 r 7(11) the amended originating claim is served as required (the duty arises)` TRUE FALSE EQUALS JUST TRUE -- the claim was amended under this paragraph and the Court has not otherwise directed: the duty arises
#ASSERT `o 33 r 7(11) the amended originating claim is served as required (the duty arises)` TRUE TRUE EQUALS JUST FALSE -- "unless the Court otherwise directs": the duty does not arise
#ASSERT `o 33 r 7(11) the amended originating claim is served as required (the duty arises)` FALSE FALSE EQUALS JUST FALSE -- not an amendment under this paragraph: the duty does not arise

-- r 7(12): permission for amendments
#ASSERT `o 33 r 7(12) permission of the Court is required for the amendment` TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- (a) party change after service
#ASSERT `o 33 r 7(12) permission of the Court is required for the amendment` FALSE TRUE FALSE FALSE EQUALS JUST TRUE -- (b) new cause of action
#ASSERT `o 33 r 7(12) permission of the Court is required for the amendment` FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- (c) statement of claim
#ASSERT `o 33 r 7(12) permission of the Court is required for the amendment` TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- before service on any party: the exception
#ASSERT `o 33 r 7(12) permission of the Court is required for the amendment` FALSE FALSE FALSE FALSE EQUALS NOTHING -- another kind of amendment

-- r 9(4)
#ASSERT `o 33 r 9(4) the warrant of arrest cannot yet be executed by the Sheriff for want of the undertaking` TRUE FALSE EQUALS JUST TRUE -- Sheriff, no undertaking
#ASSERT `o 33 r 9(4) the warrant of arrest cannot yet be executed by the Sheriff for want of the undertaking` TRUE TRUE EQUALS JUST FALSE -- undertaking lodged
#ASSERT `o 33 r 9(4) the warrant of arrest cannot yet be executed by the Sheriff for want of the undertaking` FALSE FALSE EQUALS NOTHING -- executed by a solicitor: the paragraph speaks of the Sheriff

-- r 9(8)
#ASSERT `o 33 r 9(8) the report of the arrest is made by the person required` TRUE TRUE TRUE FALSE EQUALS JUST TRUE -- executed by a solicitor, who reports
#ASSERT `o 33 r 9(8) the report of the arrest is made by the person required` TRUE TRUE FALSE TRUE EQUALS NOTHING -- executed by a solicitor, but the Sheriff reports
#ASSERT `o 33 r 9(8) the report of the arrest is made by the person required` TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- otherwise, the Sheriff reports
#ASSERT `o 33 r 9(8) the report of the arrest is made by the person required` TRUE FALSE TRUE FALSE EQUALS NOTHING -- otherwise, but the solicitor reports
#ASSERT `o 33 r 9(8) the report of the arrest is made by the person required` FALSE TRUE TRUE FALSE EQUALS NOTHING -- not served: the duty has not arisen
#ASSERT `o 33 r 9(8) the report of the arrest is made by the person required (the duty arises)` TRUE EQUALS JUST TRUE -- served
#ASSERT `o 33 r 9(8) the report of the arrest is made by the person required (the duty arises)` FALSE EQUALS JUST FALSE -- not served

-- r 10(2)
#ASSERT `o 33 r 10(2) service on landed or transhipped cargo is effected as required` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- (a)
#ASSERT `o 33 r 10(2) service on landed or transhipped cargo is effected as required` TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- (b), the custodian refuses access
#ASSERT `o 33 r 10(2) service on landed or transhipped cargo is effected as required` TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING -- (b) without the custody condition
#ASSERT `o 33 r 10(2) service on landed or transhipped cargo is effected as required` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING -- not yet effected
#ASSERT `o 33 r 10(2) service on landed or transhipped cargo is effected as required` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING -- cargo not landed or transhipped: the duty does not arise
#ASSERT `o 33 r 10(2) service on landed or transhipped cargo is effected as required (the duty arises)` TRUE TRUE EQUALS JUST TRUE -- freight or cargo, landed
#ASSERT `o 33 r 10(2) service on landed or transhipped cargo is effected as required (the duty arises)` TRUE FALSE EQUALS JUST FALSE -- not landed

-- r 11(5): relevant period
#ASSERT `o 33 r 11(5) it is the relevant period by (a) or (b)` TRUE FALSE EQUALS JUST TRUE -- (a) in force
#ASSERT `o 33 r 11(5) it is the relevant period by (a) or (b)` FALSE TRUE EQUALS JUST TRUE -- (b) in force
#ASSERT `o 33 r 11(5) it is the relevant period by (a) or (b)` TRUE TRUE EQUALS JUST TRUE -- both
#ASSERT `o 33 r 11(5) it is the relevant period by (a) or (b)` FALSE FALSE EQUALS JUST FALSE -- neither: "means"

-- r 11(2)(b): the later of two moments
#ASSERT `o 33 r 11(2)(b) the time of service` (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 600) (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 700) EQUALS (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 700) -- same day, receipt later
#ASSERT `o 33 r 11(2)(b) the time of service` (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 800) (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 700) EQUALS (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 800) -- same day, leaving later
#ASSERT `o 33 r 11(2)(b) the time of service` (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 800) (Moment WITH `day of the moment` IS Date 4 3 2026, `minutes after midnight` IS 100) EQUALS (Moment WITH `day of the moment` IS Date 4 3 2026, `minutes after midnight` IS 100) -- receipt next day
#ASSERT `o 33 r 11(2)(b) the time of service` (Moment WITH `day of the moment` IS Date 5 3 2026, `minutes after midnight` IS 100) (Moment WITH `day of the moment` IS Date 4 3 2026, `minutes after midnight` IS 900) EQUALS (Moment WITH `day of the moment` IS Date 5 3 2026, `minutes after midnight` IS 100) -- left next day

-- r 11(4) entitlement
#ASSERT `o 33 r 11(4) the claimant is entitled to enter final or interlocutory judgment in default` TRUE FALSE FALSE EQUALS JUST FALSE -- "not entitled ... unless": neither (a) nor (b)
#ASSERT `o 33 r 11(4) the claimant is entitled to enter final or interlocutory judgment in default` TRUE TRUE FALSE EQUALS NOTHING -- (a) met: the bar has ended and nothing grants the entitlement (QA)
#ASSERT `o 33 r 11(4) the claimant is entitled to enter final or interlocutory judgment in default` TRUE FALSE TRUE EQUALS JUST TRUE -- (b) the Court otherwise orders: the order is the exception the sentence gives (QA)
#ASSERT `o 33 r 11(4) the claimant is entitled to enter final or interlocutory judgment in default` TRUE TRUE TRUE EQUALS NOTHING -- (a) met and the Court otherwise orders: the bar has ended, so the sentence grants nothing (QA)
#ASSERT `o 33 r 11(4) the claimant is entitled to enter final or interlocutory judgment in default` FALSE FALSE FALSE EQUALS NOTHING -- not served under paragraph (1): silent

-- r 12(2)
#ASSERT `o 33 r 12(2) the Sheriff must send the person a copy of the order` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- (a)
#ASSERT `o 33 r 12(2) the Sheriff must send the person a copy of the order` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE -- (b)
#ASSERT `o 33 r 12(2) the Sheriff must send the person a copy of the order` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- (c)
#ASSERT `o 33 r 12(2) the Sheriff must send the person a copy of the order` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE -- (d)
#ASSERT `o 33 r 12(2) the Sheriff must send the person a copy of the order` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING -- none of the four: not answered
#ASSERT `o 33 r 12(2) the Sheriff must send the person a copy of the order` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING -- no order made: the duty does not arise
#ASSERT `o 33 r 12(2) the Sheriff must send the person a copy of the order (the duty arises)` TRUE EQUALS JUST TRUE -- an order made
#ASSERT `o 33 r 12(2) the Sheriff must send the person a copy of the order (the duty arises)` FALSE EQUALS JUST FALSE -- no order

-- r 13(2)
#ASSERT `o 33 r 13(2) a release may be issued` TRUE FALSE FALSE EQUALS JUST FALSE -- caveat against release, no exception
#ASSERT `o 33 r 13(2) a release may be issued` TRUE TRUE FALSE EQUALS NOTHING -- (a): the bar does not apply and nothing grants the release (QA)
#ASSERT `o 33 r 13(2) a release may be issued` TRUE FALSE TRUE EQUALS JUST TRUE -- (b): the Court so orders: the order is the exception the sentence gives (QA)
#ASSERT `o 33 r 13(2) a release may be issued` TRUE TRUE TRUE EQUALS NOTHING -- (a) and (b) both: the bar does not apply, so the sentence grants nothing (QA)
#ASSERT `o 33 r 13(2) a release may be issued` FALSE FALSE FALSE EQUALS NOTHING -- no caveat against release: silent

-- r 13(3)
#ASSERT `o 33 r 13(3) a release may be issued on the application` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- the Court so orders
#ASSERT `o 33 r 13(3) a release may be issued on the application` TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- all consent, paragraph (2) no bar
#ASSERT `o 33 r 13(3) a release may be issued on the application` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- all consent but paragraph (2) bars
#ASSERT `o 33 r 13(3) a release may be issued on the application` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- the Court so orders, whatever paragraph (2) says about the consent route
#ASSERT `o 33 r 13(3) a release may be issued on the application` TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- neither
#ASSERT `o 33 r 13(3) a release may be issued on the application` FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- not a party to the action

-- r 13(4)
#ASSERT `o 33 r 13(4) the applicant has done what paragraph (4) requires before the release is issued` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- notice given, form filed
#ASSERT `o 33 r 13(4) the applicant has done what paragraph (4) requires before the release is issued` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- paragraph (2)(a) applies: no notice needed
#ASSERT `o 33 r 13(4) the applicant has done what paragraph (4) requires before the release is issued` TRUE FALSE FALSE TRUE EQUALS NOTHING -- notice not given
#ASSERT `o 33 r 13(4) the applicant has done what paragraph (4) requires before the release is issued` TRUE FALSE TRUE FALSE EQUALS NOTHING -- form not filed
#ASSERT `o 33 r 13(4) the applicant has done what paragraph (4) requires before the release is issued` FALSE FALSE TRUE TRUE EQUALS NOTHING -- no release to be issued: the duty does not arise
#ASSERT `o 33 r 13(4) the applicant has done what paragraph (4) requires before the release is issued (the duty arises)` TRUE EQUALS JUST TRUE -- a release is to be issued
#ASSERT `o 33 r 13(4) the applicant has done what paragraph (4) requires before the release is issued (the duty arises)` FALSE EQUALS JUST FALSE -- none

-- r 13(5)
#ASSERT `o 33 r 13(5) the party has done what paragraph (5) requires before the property is released` TRUE TRUE FALSE EQUALS JUST TRUE -- (a)
#ASSERT `o 33 r 13(5) the party has done what paragraph (5) requires before the property is released` TRUE FALSE TRUE EQUALS JUST TRUE -- (b)
#ASSERT `o 33 r 13(5) the party has done what paragraph (5) requires before the property is released` TRUE FALSE FALSE EQUALS NOTHING -- neither yet
#ASSERT `o 33 r 13(5) the party has done what paragraph (5) requires before the property is released` FALSE TRUE TRUE EQUALS NOTHING -- no release about to be given effect: the duty does not arise
#ASSERT `o 33 r 13(5) the party has done what paragraph (5) requires before the property is released (the duty arises)` TRUE EQUALS JUST TRUE -- about to be released
#ASSERT `o 33 r 13(5) the party has done what paragraph (5) requires before the property is released (the duty arises)` FALSE EQUALS JUST FALSE -- none

-- r 13 anchor
#ASSERT `o 33 r 13 an instrument of release is issued under this Rule` TRUE EQUALS JUST TRUE -- Form 54 issued out of the Registry
#ASSERT `o 33 r 13 an instrument of release is issued under this Rule` FALSE EQUALS NOTHING -- silent

-- r 16(3)
#ASSERT `o 33 r 16(3) an affidavit is to be made on behalf of the corporation` TRUE FALSE EQUALS JUST FALSE -- "no affidavit is to be made ... unless the opposite party requires it"
#ASSERT `o 33 r 16(3) an affidavit is to be made on behalf of the corporation` TRUE TRUE EQUALS JUST TRUE -- required: the same paragraph says the affidavit is then made (QA)
#ASSERT `o 33 r 16(3) an affidavit is to be made on behalf of the corporation` FALSE FALSE EQUALS NOTHING -- not a corporation surety: silent

-- r 16(4): 24 hours
#ASSERT `o 33 r 16(4) the bond may be filed at the moment` (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 600) (Moment WITH `day of the moment` IS Date 4 3 2026, `minutes after midnight` IS 600) FALSE EQUALS JUST TRUE -- exactly 24 hours later (boundary)
#ASSERT `o 33 r 16(4) the bond may be filed at the moment` (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 600) (Moment WITH `day of the moment` IS Date 4 3 2026, `minutes after midnight` IS 599) FALSE EQUALS JUST FALSE -- one minute short (boundary)
#ASSERT `o 33 r 16(4) the bond may be filed at the moment` (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 600) (Moment WITH `day of the moment` IS Date 5 3 2026, `minutes after midnight` IS 0) FALSE EQUALS JUST TRUE -- two days later
#ASSERT `o 33 r 16(4) the bond may be filed at the moment` (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 600) (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 700) FALSE EQUALS JUST FALSE -- the same day
#ASSERT `o 33 r 16(4) the bond may be filed at the moment` (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 600) (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 700) TRUE EQUALS JUST TRUE -- the opposite party consented to filing sooner
#ASSERT `o 33 r 16(4) the earliest moment the bond may be filed without consent` (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 600) EQUALS (Moment WITH `day of the moment` IS Date 4 3 2026, `minutes after midnight` IS 600) -- served at 10:00 on 3 March: 10:00 on 4 March
#ASSERT `o 33 r 16(4) the earliest moment the bond may be filed without consent` (Moment WITH `day of the moment` IS Date 28 2 2026, `minutes after midnight` IS 1439) EQUALS (Moment WITH `day of the moment` IS Date 1 3 2026, `minutes after midnight` IS 1439) -- served at 23:59 on the last day of February: 23:59 on 1 March
#ASSERT `o 33 r 16(4) the bond may be filed at the moment` (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 600) (`o 33 r 16(4) the earliest moment the bond may be filed without consent` (Moment WITH `day of the moment` IS Date 3 3 2026, `minutes after midnight` IS 600)) FALSE EQUALS JUST TRUE -- the earliest moment is itself a moment at which the bond may be filed without consent


-- Gate and period assertions follow, written from the kind of each rule (every condition met; then each condition missing in turn).
#ASSERT `o 33 r 1(1) this Order applies to the cause or matter` TRUE EQUALS JUST TRUE -- O 33 r 1(1): every condition met
#ASSERT `o 33 r 1(1) this Order applies to the cause or matter` FALSE EQUALS NOTHING -- O 33 r 1(1): condition 1 missing
#ASSERT `o 33 r 1(2) an action is an action in rem` TRUE EQUALS JUST TRUE -- O 33 r 1(2) “action in rem”: every condition met
#ASSERT `o 33 r 1(2) an action is an action in rem` FALSE EQUALS JUST FALSE -- O 33 r 1(2) “action in rem”: condition 1 missing
#ASSERT `o 33 r 1(2) a caveat is a caveat against arrest` TRUE TRUE EQUALS JUST TRUE -- O 33 r 1(2) “caveat against arrest”: every condition met
#ASSERT `o 33 r 1(2) a caveat is a caveat against arrest` FALSE TRUE EQUALS JUST FALSE -- O 33 r 1(2) “caveat against arrest”: condition 1 missing
#ASSERT `o 33 r 1(2) a caveat is a caveat against arrest` TRUE FALSE EQUALS JUST FALSE -- O 33 r 1(2) “caveat against arrest”: condition 2 missing
#ASSERT `o 33 r 1(2) a caveat is a caveat against release and payment` TRUE TRUE EQUALS JUST TRUE -- O 33 r 1(2) “caveat against release and payment”: every condition met
#ASSERT `o 33 r 1(2) a caveat is a caveat against release and payment` FALSE TRUE EQUALS JUST FALSE -- O 33 r 1(2) “caveat against release and payment”: condition 1 missing
#ASSERT `o 33 r 1(2) a caveat is a caveat against release and payment` TRUE FALSE EQUALS JUST FALSE -- O 33 r 1(2) “caveat against release and payment”: condition 2 missing
#ASSERT `o 33 r 1(2) a recording is electronic track data` TRUE TRUE EQUALS JUST TRUE -- O 33 r 1(2) “electronic track data”: every condition met
#ASSERT `o 33 r 1(2) a recording is electronic track data` FALSE TRUE EQUALS JUST FALSE -- O 33 r 1(2) “electronic track data”: condition 1 missing
#ASSERT `o 33 r 1(2) a recording is electronic track data` TRUE FALSE EQUALS JUST FALSE -- O 33 r 1(2) “electronic track data”: condition 2 missing
#ASSERT `o 33 r 1(2) an action is a limitation action` TRUE TRUE EQUALS JUST TRUE -- O 33 r 1(2) “limitation action”: every condition met
#ASSERT `o 33 r 1(2) an action is a limitation action` FALSE TRUE EQUALS JUST FALSE -- O 33 r 1(2) “limitation action”: condition 1 missing
#ASSERT `o 33 r 1(2) an action is a limitation action` TRUE FALSE EQUALS JUST FALSE -- O 33 r 1(2) “limitation action”: condition 2 missing
#ASSERT `o 33 r 1(2) information is the record of caveats` TRUE EQUALS JUST TRUE -- O 33 r 1(2) “record of caveats”: every condition met
#ASSERT `o 33 r 1(2) information is the record of caveats` FALSE EQUALS JUST FALSE -- O 33 r 1(2) “record of caveats”: condition 1 missing
#ASSERT `o 33 r 1(2) an account is the Sheriff's account` TRUE EQUALS JUST TRUE -- O 33 r 1(2) “Sheriff’s account”: every condition met
#ASSERT `o 33 r 1(2) an account is the Sheriff's account` FALSE EQUALS JUST FALSE -- O 33 r 1(2) “Sheriff’s account”: condition 1 missing
#ASSERT `o 33 r 1(2) a craft is a ship` TRUE EQUALS JUST TRUE -- O 33 r 1(2) “ship”: every condition met
#ASSERT `o 33 r 1(2) a craft is a ship` FALSE EQUALS NOTHING -- O 33 r 1(2) “ship”: condition 1 missing
#ASSERT `o 33 r 1(3) a reference to payment into Court of proceeds of sale means payment into the Sheriff's account` TRUE TRUE EQUALS JUST TRUE -- O 33 r 1(3): every condition met
#ASSERT `o 33 r 1(3) a reference to payment into Court of proceeds of sale means payment into the Sheriff's account` FALSE TRUE EQUALS JUST FALSE -- O 33 r 1(3): condition 1 missing
#ASSERT `o 33 r 1(3) a reference to payment into Court of proceeds of sale means payment into the Sheriff's account` TRUE FALSE EQUALS JUST FALSE -- O 33 r 1(3): condition 2 missing
#ASSERT `o 33 r 2(1) an action in rem is begun by originating claim in Form 48` TRUE TRUE TRUE EQUALS JUST TRUE -- O 33 r 2(1): every condition met
#ASSERT `o 33 r 2(1) an action in rem is begun by originating claim in Form 48` FALSE TRUE TRUE EQUALS NOTHING -- O 33 r 2(1): condition 1 missing
#ASSERT `o 33 r 2(1) an action in rem is begun by originating claim in Form 48` TRUE FALSE TRUE EQUALS NOTHING -- O 33 r 2(1): condition 2 missing
#ASSERT `o 33 r 2(1) an action in rem is begun by originating claim in Form 48` TRUE TRUE FALSE EQUALS NOTHING -- O 33 r 2(1): condition 3 missing
