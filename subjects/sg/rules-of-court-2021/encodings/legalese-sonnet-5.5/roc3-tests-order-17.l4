IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc3-order-17`

-- Tests for Order 17.  Expected values are written from the text of the Rules (src lines 1668-1693),
-- decided before running.  Dates: an order made on Monday 3 November 2025; the 14 days for the draft
-- begin immediately after (O 3 r 3(3)) and end on Monday 17 November 2025; the 2 days for the
-- response, from a draft sent on Monday 17 November, end on Wednesday 19 November 2025.

-- Rule 1: "order".
#ASSERT `o 17 r 1 the thing is an order for the purposes of this Order` TRUE FALSE EQUALS JUST TRUE -- an order of the Court
#ASSERT `o 17 r 1 the thing is an order for the purposes of this Order` FALSE TRUE EQUALS JUST TRUE -- a judgment at any stage
#ASSERT `o 17 r 1 the thing is an order for the purposes of this Order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 17 r 1 the thing is an order for the purposes of this Order` FALSE FALSE EQUALS JUST FALSE -- "means"

-- Rule 2.
#ASSERT `o 17 r 2(1) the order takes effect from the day that it is given` FALSE EQUALS JUST TRUE
#ASSERT `o 17 r 2(1) the order takes effect from the day that it is given` TRUE EQUALS JUST FALSE -- "unless the Court otherwise orders"
#ASSERT `o 17 r 2(2) the Court must give that person a reasonable time within which to comply` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 17 r 2(2) the Court must give that person a reasonable time within which to comply` TRUE TRUE EQUALS JUST FALSE -- the Court intends compliance on the day the order is given
#ASSERT `o 17 r 2(2) the Court must give that person a reasonable time within which to comply` FALSE FALSE EQUALS JUST FALSE -- the order requires none of these
#ASSERT `o 17 r 2(3) the order is deemed to require immediate compliance` FALSE EQUALS JUST TRUE -- no time specified
#ASSERT `o 17 r 2(3) the order is deemed to require immediate compliance` TRUE EQUALS JUST FALSE

-- Rule 3(1) to (4).
#ASSERT `o 17 r 3(1) the order must be drawn up and filed in Court` FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 17 r 3(1) the order must be drawn up and filed in Court` TRUE FALSE EQUALS JUST FALSE -- "Unless the Court otherwise orders"
#ASSERT `o 17 r 3(1) the order must be drawn up and filed in Court` FALSE TRUE EQUALS JUST FALSE -- an extension of time or permission to amend
#ASSERT `o 17 r 3(2) the order is in the form that the Rule requires` TRUE EQUALS JUST TRUE
#ASSERT `o 17 r 3(2) the order is in the form that the Rule requires` FALSE EQUALS JUST FALSE
#ASSERT `o 17 r 3(3) the party must draw up the order` TRUE EQUALS JUST TRUE -- whether or not the outcome is in the party's favour
#ASSERT `o 17 r 3(3) the party must draw up the order` FALSE EQUALS NOTHING
#ASSERT `o 17 r 3(4) the party must draw up only one order for all the applications` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 17 r 3(4) the party must draw up only one order for all the applications` TRUE FALSE EQUALS JUST FALSE -- not heard together
#ASSERT `o 17 r 3(4) the party must draw up only one order for all the applications` FALSE TRUE EQUALS JUST FALSE -- only one application

-- Rule 3(5).
#ASSERT `o 17 r 3(5) the period after the order is made for sending the draft`'s `period length` EQUALS 14
#ASSERT `o 17 r 3(5) the period after the order is made for sending the draft`'s `period unit` EQUALS Days
#ASSERT `o 17 r 3(5) the draft is sent in time` (Date 17 11 2025) (Date 17 11 2025) EQUALS JUST TRUE -- on the 14th day
#ASSERT `o 17 r 3(5) the draft is sent in time` (Date 18 11 2025) (Date 17 11 2025) EQUALS JUST FALSE -- the 15th day
#ASSERT `o 17 r 3(5) another party affected by the order may draw it up` FALSE TRUE EQUALS JUST TRUE -- "if that party fails to do so"
#ASSERT `o 17 r 3(5) another party affected by the order may draw it up` TRUE TRUE EQUALS JUST FALSE -- the draft was sent in time
#ASSERT `o 17 r 3(5) another party affected by the order may draw it up` FALSE FALSE EQUALS NOTHING -- not affected by the order

-- Rule 3(6).
#ASSERT `o 17 r 3(6) the period for the solicitors to respond to the draft`'s `period length` EQUALS 2
#ASSERT `o 17 r 3(6) the solicitors respond in time` (Date 19 11 2025) (Date 19 11 2025) EQUALS JUST TRUE
#ASSERT `o 17 r 3(6) the solicitors respond in time` (Date 20 11 2025) (Date 19 11 2025) EQUALS JUST FALSE
#ASSERT `o 17 r 3(6) the solicitors are deemed to consent to the draft` (JUST (Date 19 11 2025)) (Date 25 11 2025) (Date 19 11 2025) EQUALS JUST FALSE -- responded on the last day
#ASSERT `o 17 r 3(6) the solicitors are deemed to consent to the draft` (JUST (Date 20 11 2025)) (Date 25 11 2025) (Date 19 11 2025) EQUALS JUST TRUE -- responded after the 2 days
#ASSERT `o 17 r 3(6) the solicitors are deemed to consent to the draft` NOTHING (Date 20 11 2025) (Date 19 11 2025) EQUALS JUST TRUE -- no response, 2 days run out
#ASSERT `o 17 r 3(6) the solicitors are deemed to consent to the draft` NOTHING (Date 19 11 2025) (Date 19 11 2025) EQUALS JUST FALSE -- no response yet, the last day itself

-- Rule 3(7) to (9).
#ASSERT `o 17 r 3(7) the party who drew up the order may write to the Court to resolve the dispute` TRUE EQUALS JUST TRUE
#ASSERT `o 17 r 3(7) the party who drew up the order may write to the Court to resolve the dispute` FALSE EQUALS JUST FALSE -- no dispute
#ASSERT `o 17 r 3(7) the letter to the Court is as the Rule requires` TRUE EQUALS JUST TRUE
#ASSERT `o 17 r 3(7) the letter to the Court is as the Rule requires` FALSE EQUALS JUST FALSE
#ASSERT `o 17 r 3(8) the Court may decide the dispute without the attendance of the parties or fix an appointment to hear them` TRUE EQUALS JUST TRUE
#ASSERT `o 17 r 3(8) the Court may decide the dispute without the attendance of the parties or fix an appointment to hear them` FALSE EQUALS NOTHING
#ASSERT `o 17 r 3(9) the draft of the order is to be submitted to the Registrar` TRUE EQUALS JUST TRUE
#ASSERT `o 17 r 3(9) the draft of the order is to be submitted to the Registrar` FALSE EQUALS JUST FALSE

-- Rule 4.
#ASSERT `o 17 r 4(1) the Court may redact the order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 17 r 4(1) the Court may redact the order` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 17 r 4(1) the Court may redact the order` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 17 r 4(2) the Court may prohibit the person from inspecting or taking copies of the order` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 17 r 4(2) the Court may prohibit the person from inspecting or taking copies of the order` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 17 r 4(2) the Court may prohibit the person from inspecting or taking copies of the order` TRUE TRUE TRUE EQUALS NOTHING -- "other than the parties"
#ASSERT `o 17 r 4(2) the Court may prohibit the person from inspecting or taking copies of the order` FALSE FALSE FALSE EQUALS JUST FALSE

-- Rule 5.
#ASSERT `o 17 r 5(1)(b) the rate of simple interest per year` EQUALS 0.0533 -- "5.33% per year"
#ASSERT `o 17 r 5(1)(a) the money carries interest as agreed between the parties` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 17 r 5(1)(a) the money carries interest as agreed between the parties` TRUE FALSE EQUALS NOTHING
#ASSERT `o 17 r 5(1)(a) the money carries interest as agreed between the parties` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 17 r 5(1)(b) the money carries simple interest at 5.33% per year` TRUE FALSE EQUALS JUST TRUE -- no agreement on interest
#ASSERT `o 17 r 5(1)(b) the money carries simple interest at 5.33% per year` TRUE TRUE EQUALS JUST FALSE -- there is an agreement
#ASSERT `o 17 r 5(1)(b) the money carries simple interest at 5.33% per year` FALSE FALSE EQUALS JUST FALSE -- no money payable under an order
#ASSERT `o 17 r 5(2) the simple interest at 5.33% per year from the date the order is made until the date of payment` 10000 1 EQUALS 533 -- $10,000 for a year at 5.33%
#ASSERT `o 17 r 5(2) the simple interest at 5.33% per year from the date the order is made until the date of payment` 10000 0.5 EQUALS 266.5
#ASSERT `o 17 r 5(3) interest is to be calculated from the date that each instalment is due` TRUE EQUALS JUST TRUE
#ASSERT `o 17 r 5(3) interest is to be calculated from the date that each instalment is due` FALSE EQUALS JUST FALSE
#ASSERT `o 17 r 5(3) the simple interest on an instalment from the date it is due until the date of payment` TRUE 2000 1 EQUALS JUST 106.6 -- $2,000 for a year at 5.33%
#ASSERT `o 17 r 5(3) the simple interest on an instalment from the date it is due until the date of payment` FALSE 2000 1 EQUALS NOTHING
#ASSERT `o 17 r 5(4) a part payment must be used to reduce the principal amount due before interest` TRUE EQUALS JUST TRUE
#ASSERT `o 17 r 5(4) a part payment must be used to reduce the principal amount due before interest` FALSE EQUALS JUST FALSE
#ASSERT `o 17 r 5(4) the principal amount due after the part payment` 10000 3000 EQUALS JUST 7000
#ASSERT `o 17 r 5(4) the principal amount due after the part payment` 10000 10000 EQUALS JUST 0
#ASSERT `o 17 r 5(4) the principal amount due after the part payment` 10000 10001 EQUALS NOTHING
