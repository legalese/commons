IMPORT prelude
IMPORT `roc-core`
IMPORT `roc12-order-64`

-- Rules of Court 2021 (Singapore) -- tests for Order 64 (roc12-order-64.l4).
-- Every expected value is written from the text of the Rule (lines 7400 to 7481 of the source file) before the run,
-- never copied from the output.  Arguments are positional, in the order of each function's GIVEN block.
-- JUST TRUE = holds; JUST FALSE = the text says no in its own words; NOTHING = the text does not answer.

-- ---------------------------------------------------------------------------
§ `O 64 r 1 -- "process" includes a citation`
-- ---------------------------------------------------------------------------
-- Argument: the document is a citation.
#ASSERT `o 64 r 1 a document is process` TRUE EQUALS JUST TRUE -- a citation is process: "“process” includes a citation"
#ASSERT `o 64 r 1 a document is process` FALSE EQUALS NOTHING -- "includes" does not close the list, so a non-citation is not answered

-- ---------------------------------------------------------------------------
§ `O 64 r 2 -- service on a letter of request received by the Minister`
-- ---------------------------------------------------------------------------
-- r 2(1).  Arguments: foreign civil proceedings; letter requests service on a person in Singapore; received by the Minister; sent to the Supreme Court with an intimation.
#ASSERT `o 64 r 2(1) this Rule applies to the service` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- all four conditions of "where a letter of request ... is received by the Minister and is sent by the Minister to the Supreme Court with an intimation"
#ASSERT `o 64 r 2(1) this Rule applies to the service` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- the Minister has not sent it on: the "where" condition fails
#ASSERT `o 64 r 2(1) this Rule applies to the service` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- not received by the Minister: the "where" condition fails
#ASSERT `o 64 r 2(1) this Rule applies to the service` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- the letter does not request service on a person in Singapore: the "where" condition fails
#ASSERT `o 64 r 2(1) this Rule applies to the service` FALSE TRUE TRUE TRUE EQUALS NOTHING -- the process is not for foreign civil proceedings: outside the scope, which has no "only"

-- r 2(2).  Arguments: translation of the letter in English; number of copies of the process; number of copies of the translation of the process.
#ASSERT `o 64 r 2(2) the letter of request is accompanied as the Rule requires` TRUE 2 2 EQUALS JUST TRUE -- the translation and 2 copies of each
#ASSERT `o 64 r 2(2) the letter of request is accompanied as the Rule requires` TRUE 3 2 EQUALS JUST TRUE -- more than 2 copies of the process: at least 2 (assumed, F reading)
#ASSERT `o 64 r 2(2) the letter of request is accompanied as the Rule requires` FALSE 2 2 EQUALS NOTHING -- no translation of the letter: a bare "must be accompanied by"
#ASSERT `o 64 r 2(2) the letter of request is accompanied as the Rule requires` TRUE 1 2 EQUALS NOTHING -- only 1 copy of the process
#ASSERT `o 64 r 2(2) the letter of request is accompanied as the Rule requires` TRUE 2 1 EQUALS NOTHING -- only 1 copy of the translation of the process

-- r 2(3).  Arguments: the Minister considers the letter does not comply; informed of the non-compliance; informed of the provisions to be complied with.
#ASSERT `o 64 r 2(3) the duty to inform the requesting court or tribunal arises` TRUE EQUALS JUST TRUE -- "Where the Minister considers that the letter of request does not comply"
#ASSERT `o 64 r 2(3) the duty to inform the requesting court or tribunal arises` FALSE EQUALS JUST FALSE -- the "Where" condition is not met
#ASSERT `o 64 r 2(3) the requesting court or tribunal has been informed as the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE -- both (a) and (b) done
#ASSERT `o 64 r 2(3) the requesting court or tribunal has been informed as the Rule requires` TRUE TRUE FALSE EQUALS NOTHING -- (b) not done: a bare "must inform"
#ASSERT `o 64 r 2(3) the requesting court or tribunal has been informed as the Rule requires` TRUE FALSE TRUE EQUALS NOTHING -- (a) not done
#ASSERT `o 64 r 2(3) the requesting court or tribunal has been informed as the Rule requires` FALSE FALSE FALSE EQUALS NOTHING -- the duty does not arise

-- r 2(4).  Arguments: substituted-service order under (6); a written law on bodies corporate applies; [a copy was left].
#ASSERT `o 64 r 2(4) the requirement to leave a copy with the person to be served applies` FALSE FALSE EQUALS JUST TRUE -- no exception is engaged
#ASSERT `o 64 r 2(4) the requirement to leave a copy with the person to be served applies` TRUE FALSE EQUALS JUST FALSE -- "Subject to paragraph (6)": an order for substituted service displaces it
#ASSERT `o 64 r 2(4) the requirement to leave a copy with the person to be served applies` FALSE TRUE EQUALS JUST FALSE -- "Subject to ... any written law which provides for the manner in which documents may be served on a body corporate"
#ASSERT `o 64 r 2(4) service has been effected by leaving a copy with the person to be served` FALSE FALSE TRUE EQUALS JUST TRUE -- the requirement applies and a copy was left
#ASSERT `o 64 r 2(4) service has been effected by leaving a copy with the person to be served` FALSE FALSE FALSE EQUALS NOTHING -- the requirement applies and no copy was left: a bare "must"
#ASSERT `o 64 r 2(4) service has been effected by leaving a copy with the person to be served` TRUE FALSE TRUE EQUALS NOTHING -- the requirement is displaced by an order under (6)

-- r 2(5).
#ASSERT `o 64 r 2(5) service is effected by the process server` TRUE EQUALS JUST TRUE -- "Service must be effected by the process server"
#ASSERT `o 64 r 2(5) service is effected by the process server` FALSE EQUALS NOTHING -- a bare "must"

-- r 2(6).  Arguments for the first: the Attorney-General applied.  For the second: an order was made; service by the steps directed.
#ASSERT `o 64 r 2(6) the Court may make an order for substituted service` TRUE EQUALS JUST TRUE -- "Where an application in that behalf is made by the Attorney-General, the Court may make an order"
#ASSERT `o 64 r 2(6) the Court may make an order for substituted service` FALSE EQUALS JUST FALSE -- the "Where" condition is not met: no application by the Attorney-General
#ASSERT `o 64 r 2(6) service under the order is effected by the steps the Court directs` TRUE TRUE EQUALS JUST TRUE -- an order was made and its steps taken
#ASSERT `o 64 r 2(6) service under the order is effected by the steps the Court directs` TRUE FALSE EQUALS NOTHING -- an order was made and its steps were not taken: a bare "must"
#ASSERT `o 64 r 2(6) service under the order is effected by the steps the Court directs` FALSE FALSE EQUALS NOTHING -- no order was made: "where such an order is made" is not met
#ASSERT `o 64 r 2(6) service under the order is effected by the steps the Court directs` FALSE TRUE EQUALS NOTHING -- no order was made

-- r 2(7).  Arguments for the first: service effected; attempts failed.  For the second: those two, then copy of process; affidavit; copy of the affidavit; statement of costs.
#ASSERT `o 64 r 2(7) the duty of the process server to file arises` TRUE FALSE EQUALS JUST TRUE -- "After service of the process has been effected"
#ASSERT `o 64 r 2(7) the duty of the process server to file arises` FALSE TRUE EQUALS JUST TRUE -- "(if such be the case) attempts to effect service of it have failed"
#ASSERT `o 64 r 2(7) the duty of the process server to file arises` FALSE FALSE EQUALS JUST FALSE -- neither has happened
#ASSERT `o 64 r 2(7) the process server has filed what the Rule requires` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- all four filed after service
#ASSERT `o 64 r 2(7) the process server has filed what the Rule requires` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- all four filed after a failed attempt
#ASSERT `o 64 r 2(7) the process server has filed what the Rule requires` TRUE FALSE TRUE TRUE TRUE FALSE EQUALS NOTHING -- no statement of costs: a bare "must file"
#ASSERT `o 64 r 2(7) the process server has filed what the Rule requires` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS NOTHING -- no copy of the process
#ASSERT `o 64 r 2(7) the process server has filed what the Rule requires` TRUE FALSE TRUE FALSE TRUE TRUE EQUALS NOTHING -- no affidavit
#ASSERT `o 64 r 2(7) the process server has filed what the Rule requires` TRUE FALSE TRUE TRUE FALSE TRUE EQUALS NOTHING -- no copy of the affidavit
#ASSERT `o 64 r 2(7) the process server has filed what the Rule requires` FALSE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- the duty has not arisen

-- r 2(8).  Arguments: the form used; (a) identifies the documents; (b) certifies method and proof or why not; (c) certifies the cost.
#ASSERT `o 64 r 2(8) the form of the certificate` EQUALS "94" -- "The Registrar must give a certificate in Form 94"
#ASSERT `o 64 r 2(8) the Registrar's certificate is in the form and says what the Rule requires` "94" TRUE TRUE TRUE EQUALS JUST TRUE -- Form 94 with (a), (b), (c)
#ASSERT `o 64 r 2(8) the Registrar's certificate is in the form and says what the Rule requires` "95" TRUE TRUE TRUE EQUALS NOTHING -- another form
#ASSERT `o 64 r 2(8) the Registrar's certificate is in the form and says what the Rule requires` "94" FALSE TRUE TRUE EQUALS NOTHING -- (a) missing
#ASSERT `o 64 r 2(8) the Registrar's certificate is in the form and says what the Rule requires` "94" TRUE FALSE TRUE EQUALS NOTHING -- (b) missing
#ASSERT `o 64 r 2(8) the Registrar's certificate is in the form and says what the Rule requires` "94" TRUE TRUE FALSE EQUALS NOTHING -- (c) missing

-- r 2(9).  Arguments: sealed; sent.
#ASSERT `o 64 r 2(9) the certificate is sealed and sent as the Rule requires` TRUE TRUE EQUALS JUST TRUE -- sealed and sent
#ASSERT `o 64 r 2(9) the certificate is sealed and sent as the Rule requires` TRUE FALSE EQUALS NOTHING -- not sent
#ASSERT `o 64 r 2(9) the certificate is sealed and sent as the Rule requires` FALSE TRUE EQUALS NOTHING -- not sealed

-- ---------------------------------------------------------------------------
§ `O 64 r 3 -- alternative mode of service`
-- ---------------------------------------------------------------------------
-- r 3(1).  Arguments: foreign civil proceedings; Rule 2 applies; Rule 2 is invoked; Rule 4 applies.
#ASSERT `o 64 r 3(1) this Rule applies to the service` TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- "where Rule 2 does not apply or is not invoked": neither
#ASSERT `o 64 r 3(1) this Rule applies to the service` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- Rule 2 applies but is not invoked
#ASSERT `o 64 r 3(1) this Rule applies to the service` TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- Rule 2 does not apply although invoked
#ASSERT `o 64 r 3(1) this Rule applies to the service` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- Rule 2 applies and is invoked: the "where" condition fails
#ASSERT `o 64 r 3(1) this Rule applies to the service` TRUE FALSE FALSE TRUE EQUALS NOTHING -- "Subject to Rule 4": Rule 4 applies and takes precedence
#ASSERT `o 64 r 3(1) this Rule applies to the service` FALSE FALSE FALSE FALSE EQUALS NOTHING -- not foreign civil proceedings: outside the scope

-- r 3(2).  Arguments: the answer of r 3(1); the method is authorised for analogous process.
#ASSERT `o 64 r 3(2) service within Singapore may be effected by the method` (JUST TRUE) TRUE EQUALS JUST TRUE -- an authorised method under a Rule that applies
#ASSERT `o 64 r 3(2) service within Singapore may be effected by the method` (JUST TRUE) FALSE EQUALS NOTHING -- a method not authorised: the grant does not forbid others
#ASSERT `o 64 r 3(2) service within Singapore may be effected by the method` (JUST FALSE) TRUE EQUALS NOTHING -- Rule 3 does not apply
#ASSERT `o 64 r 3(2) service within Singapore may be effected by the method` NOTHING TRUE EQUALS NOTHING -- whether Rule 3 applies is not answered

-- r 3(3).  Argument: the process is expressed to be or includes a command of the foreign sovereign.
#ASSERT `o 64 r 3(3) the foreign sovereign's command stops this Rule applying` TRUE EQUALS JUST FALSE -- "This Rule applies even though the foreign process is expressed to be or includes a command of the foreign sovereign"
#ASSERT `o 64 r 3(3) the foreign sovereign's command stops this Rule applying` FALSE EQUALS NOTHING -- the paragraph speaks only of a process that is or includes a command

-- r 3(4).  Arguments: Rule 4A applies; Rule 4A is invoked.
#ASSERT `o 64 r 3(4) this Rule applies where Rule 4A applies or is invoked` TRUE FALSE EQUALS JUST FALSE -- "This Rule does not apply where Rule 4A applies"
#ASSERT `o 64 r 3(4) this Rule applies where Rule 4A applies or is invoked` FALSE TRUE EQUALS JUST FALSE -- "... or is invoked"
#ASSERT `o 64 r 3(4) this Rule applies where Rule 4A applies or is invoked` FALSE FALSE EQUALS NOTHING -- the paragraph is silent when Rule 4A neither applies nor is invoked

-- The gathered answer.  Arguments: foreign; Rule 2 applies; Rule 2 invoked; Rule 4 applies; Rule 4A applies; Rule 4A invoked.
#ASSERT `o 64 r 3 this Rule applies to the service` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- r 3(1) satisfied, r 3(4) not engaged
#ASSERT `o 64 r 3 this Rule applies to the service` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE -- r 3(4): Rule 4A applies
#ASSERT `o 64 r 3 this Rule applies to the service` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- r 3(4): Rule 4A invoked
#ASSERT `o 64 r 3 this Rule applies to the service` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- r 3(1): Rule 2 applies and is invoked
#ASSERT `o 64 r 3 this Rule applies to the service` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING -- r 3(1): Rule 4 applies
#ASSERT `o 64 r 3 this Rule applies to the service` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING -- not foreign civil proceedings

-- ---------------------------------------------------------------------------
§ `O 64 r 4 -- service under a Civil Procedure Convention`
-- ---------------------------------------------------------------------------
-- r 4(1).  Arguments: foreign proceedings; the instrument is a Civil Procedure Convention; it is the Hague Service Convention; it provides for service in Singapore; letter of request received by the Registrar.
#ASSERT `o 64 r 4(1) this Rule applies to the service` TRUE (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS JUST TRUE -- a Convention other than the Hague Convention, letter received by the Registrar
#ASSERT `o 64 r 4(1) this Rule applies to the service` TRUE (JUST TRUE) (JUST FALSE) TRUE FALSE EQUALS JUST FALSE -- no letter of request received by the Registrar: the "where" condition fails
#ASSERT `o 64 r 4(1) this Rule applies to the service` TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS NOTHING -- the Hague Service Convention: "(other than the Hague Service Convention ...)" takes it out of what this Rule covers
#ASSERT `o 64 r 4(1) this Rule applies to the service` TRUE (JUST TRUE) NOTHING TRUE TRUE EQUALS JUST TRUE -- it is not known whether the instrument is the Hague Service Convention: the exclusion fires only on JUST TRUE for it, so the Rule's own conditions decide (F-O64-7)
#ASSERT `o 64 r 4(1) this Rule applies to the service` TRUE (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS NOTHING -- not a Civil Procedure Convention: outside the scope
#ASSERT `o 64 r 4(1) this Rule applies to the service` TRUE NOTHING NOTHING TRUE TRUE EQUALS NOTHING -- whether it is a Convention is not answered
#ASSERT `o 64 r 4(1) this Rule applies to the service` TRUE (JUST TRUE) (JUST FALSE) FALSE TRUE EQUALS NOTHING -- the Convention does not provide for service in Singapore: outside the scope
#ASSERT `o 64 r 4(1) this Rule applies to the service` FALSE (JUST TRUE) (JUST FALSE) TRUE TRUE EQUALS NOTHING -- not foreign proceedings: outside the scope

-- r 4(2), r 4(4), r 4(7) in turn.
#ASSERT `o 64 r 4(2) the letter of request is accompanied as the Rule requires` TRUE EQUALS JUST TRUE -- accompanied by a translation in English
#ASSERT `o 64 r 4(2) the letter of request is accompanied as the Rule requires` FALSE EQUALS NOTHING -- a bare "must be accompanied by"
#ASSERT `o 64 r 4(4) service is effected by the process server` TRUE EQUALS JUST TRUE -- "Service must be effected by the process server"
#ASSERT `o 64 r 4(4) service is effected by the process server` FALSE EQUALS NOTHING -- a bare "must"
#ASSERT `o 64 r 4(7) the certificate is sealed and sent as the Rule requires` TRUE TRUE EQUALS JUST TRUE -- sealed and sent to the consular or other authority
#ASSERT `o 64 r 4(7) the certificate is sealed and sent as the Rule requires` FALSE TRUE EQUALS NOTHING -- not sealed
#ASSERT `o 64 r 4(7) the certificate is sealed and sent as the Rule requires` TRUE FALSE EQUALS NOTHING -- not sent

-- r 4(3).  Arguments: a written law on bodies corporate applies; the Convention's special provisions apply; [the document and translation were left].
#ASSERT `o 64 r 4(3) the requirement to leave the original or a copy and a copy of the translation with the person to be served applies` FALSE FALSE EQUALS JUST TRUE -- no exception engaged
#ASSERT `o 64 r 4(3) the requirement to leave the original or a copy and a copy of the translation with the person to be served applies` TRUE FALSE EQUALS JUST FALSE -- "Subject to any written law which provides for the manner in which documents may be served on bodies corporate"
#ASSERT `o 64 r 4(3) the requirement to leave the original or a copy and a copy of the translation with the person to be served applies` FALSE TRUE EQUALS JUST FALSE -- "and to any special provisions of the relevant Civil Procedure Convention"
#ASSERT `o 64 r 4(3) service has been effected by leaving the document and the translation with the person to be served` FALSE FALSE TRUE EQUALS JUST TRUE -- left as required
#ASSERT `o 64 r 4(3) service has been effected by leaving the document and the translation with the person to be served` FALSE FALSE FALSE EQUALS NOTHING -- not left: a bare "must"
#ASSERT `o 64 r 4(3) service has been effected by leaving the document and the translation with the person to be served` TRUE FALSE TRUE EQUALS NOTHING -- the requirement is displaced

-- r 4(5).  Arguments for the first: service effected; attempts failed.  For the second: those, then affidavit filed; statement of costs filed.
#ASSERT `o 64 r 4(5) the duty of the process server to file an affidavit arises` TRUE FALSE EQUALS JUST TRUE -- after service
#ASSERT `o 64 r 4(5) the duty of the process server to file an affidavit arises` FALSE TRUE EQUALS JUST TRUE -- after failed attempts
#ASSERT `o 64 r 4(5) the duty of the process server to file an affidavit arises` FALSE FALSE EQUALS JUST FALSE -- neither
#ASSERT `o 64 r 4(5) the process server has filed what the Rule requires` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- both filed
#ASSERT `o 64 r 4(5) the process server has filed what the Rule requires` TRUE FALSE TRUE FALSE EQUALS NOTHING -- no statement of costs
#ASSERT `o 64 r 4(5) the process server has filed what the Rule requires` TRUE FALSE FALSE TRUE EQUALS NOTHING -- no affidavit
#ASSERT `o 64 r 4(5) the process server has filed what the Rule requires` FALSE FALSE TRUE TRUE EQUALS NOTHING -- the duty has not arisen

-- r 4(6).  Arguments: certifies service (or why not); certifies the cost.
#ASSERT `o 64 r 4(6) the Registrar's certificate says what the Rule requires` TRUE TRUE EQUALS JUST TRUE -- (a) and (b)
#ASSERT `o 64 r 4(6) the Registrar's certificate says what the Rule requires` TRUE FALSE EQUALS NOTHING -- (b) missing
#ASSERT `o 64 r 4(6) the Registrar's certificate says what the Rule requires` FALSE TRUE EQUALS NOTHING -- (a) missing

-- ---------------------------------------------------------------------------
§ `O 64 r 4A -- service under Article 5 of the Hague Service Convention`
-- ---------------------------------------------------------------------------
-- r 4A(13) “applicant”.  Arguments: an authority or judicial officer; competent to forward a request for service.
#ASSERT `o 64 r 4A(13) a person is the applicant` TRUE TRUE EQUALS JUST TRUE -- "means the authority or judicial officer competent ... to forward a request for service"
#ASSERT `o 64 r 4A(13) a person is the applicant` TRUE FALSE EQUALS JUST FALSE -- "means": not competent
#ASSERT `o 64 r 4A(13) a person is the applicant` FALSE TRUE EQUALS JUST FALSE -- "means": not an authority or judicial officer
-- r 4A(13) “Contracting State”.  Arguments: the State is Singapore; the State is a party to the Hague Service Convention.
#ASSERT `o 64 r 4A(13) a State is a Contracting State` FALSE TRUE EQUALS JUST TRUE -- a State other than Singapore that is a party
#ASSERT `o 64 r 4A(13) a State is a Contracting State` FALSE FALSE EQUALS JUST FALSE -- "means": not a party
#ASSERT `o 64 r 4A(13) a State is a Contracting State` TRUE TRUE EQUALS JUST FALSE -- "(other than Singapore)": Singapore is a party but is not a Contracting State
-- r 4A(13) the terms that point to Order 8, Rule 4A(7) (passed through) and “Minister”.
#ASSERT `o 64 r 4A(13) an instrument is the Hague Service Convention` (JUST TRUE) EQUALS JUST TRUE -- the meaning given by Order 8, Rule 4A(7) is answered by that Rule
#ASSERT `o 64 r 4A(13) an instrument is the Hague Service Convention` (JUST FALSE) EQUALS JUST FALSE -- likewise
#ASSERT `o 64 r 4A(13) an instrument is the Hague Service Convention` NOTHING EQUALS NOTHING -- the other Rule is not among the sources
#ASSERT `o 64 r 4A(13) a document is the Model Form` (JUST TRUE) EQUALS JUST TRUE -- the meaning given by Order 8, Rule 4A(7)
#ASSERT `o 64 r 4A(13) a document is the Model Form` NOTHING EQUALS NOTHING -- not among the sources
#ASSERT `o 64 r 4A(13) a person is the Minister` TRUE EQUALS JUST TRUE -- "means the Minister charged with the responsibility for law"
#ASSERT `o 64 r 4A(13) a person is the Minister` FALSE EQUALS JUST FALSE -- "means"

-- r 4A(1).  Arguments: civil or commercial matter; instituted in a court of a Contracting State; under Article 5; on a person in Singapore.
#ASSERT `o 64 r 4A(1) this Rule applies to the service` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- all four limbs
#ASSERT `o 64 r 4A(1) this Rule applies to the service` TRUE TRUE TRUE FALSE EQUALS NOTHING -- not on a person in Singapore: outside the scope
#ASSERT `o 64 r 4A(1) this Rule applies to the service` TRUE TRUE FALSE TRUE EQUALS NOTHING -- not under Article 5
#ASSERT `o 64 r 4A(1) this Rule applies to the service` TRUE FALSE TRUE TRUE EQUALS NOTHING -- not instituted in a Contracting State
#ASSERT `o 64 r 4A(1) this Rule applies to the service` FALSE TRUE TRUE TRUE EQUALS NOTHING -- not a civil or commercial matter
-- r 4A(2).
#ASSERT `o 64 r 4A(2) the provision in this Rule prevails over the other provision of this Order` TRUE EQUALS JUST TRUE -- "the provision in this Rule prevails to the extent of any inconsistency"
#ASSERT `o 64 r 4A(2) the provision in this Rule prevails over the other provision of this Order` FALSE EQUALS JUST FALSE -- the "If" is not met (marginal reading (a))
-- r 4A(3).
#ASSERT `o 64 r 4A(3) the person to be served has a known address in Singapore` TRUE EQUALS JUST TRUE -- "must have a known address in Singapore"
#ASSERT `o 64 r 4A(3) the person to be served has a known address in Singapore` FALSE EQUALS NOTHING -- a bare "must"; paragraph (6) says what follows

-- r 4A(4).  Arguments: made by an applicant to the Minister; in Part 1 of the Model Form; with the document; with a Part 3 summary; the documents are in English; with an English translation; with a copy each; number of addresses; sum accompanying.
#ASSERT `o 64 r 4A(4)(e) the sum payable for each address for service` EQUALS 100 -- "a sum of $100 in respect of each address for service"
#ASSERT `o 64 r 4A(4)(e) the sum payable with the request` 1 EQUALS 100 -- one address
#ASSERT `o 64 r 4A(4)(e) the sum payable with the request` 3 EQUALS 300 -- three addresses
#ASSERT `o 64 r 4A(4) the request for service is made and accompanied as the Rule requires` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 1 100 EQUALS JUST TRUE -- the documents are in English so no translation is needed; $100 for the one address
#ASSERT `o 64 r 4A(4) the request for service is made and accompanied as the Rule requires` TRUE TRUE TRUE TRUE FALSE TRUE TRUE 2 200 EQUALS JUST TRUE -- not in English, with a translation; $200 for two addresses
#ASSERT `o 64 r 4A(4) the request for service is made and accompanied as the Rule requires` TRUE TRUE TRUE TRUE FALSE FALSE TRUE 1 100 EQUALS NOTHING -- not in English and no translation: (c) unmet
#ASSERT `o 64 r 4A(4) the request for service is made and accompanied as the Rule requires` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 2 100 EQUALS NOTHING -- $100 for two addresses is short: (e) unmet
#ASSERT `o 64 r 4A(4) the request for service is made and accompanied as the Rule requires` TRUE TRUE TRUE TRUE TRUE FALSE TRUE 1 150 EQUALS JUST TRUE -- more than $100 for one address (at least; assumed reading)
#ASSERT `o 64 r 4A(4) the request for service is made and accompanied as the Rule requires` TRUE TRUE TRUE TRUE TRUE FALSE FALSE 1 100 EQUALS NOTHING -- no copy each: (d) unmet
#ASSERT `o 64 r 4A(4) the request for service is made and accompanied as the Rule requires` TRUE TRUE TRUE FALSE TRUE FALSE TRUE 1 100 EQUALS NOTHING -- no Part 3 summary: (b) unmet
#ASSERT `o 64 r 4A(4) the request for service is made and accompanied as the Rule requires` TRUE TRUE FALSE TRUE TRUE FALSE TRUE 1 100 EQUALS NOTHING -- no document: (a) unmet
#ASSERT `o 64 r 4A(4) the request for service is made and accompanied as the Rule requires` TRUE FALSE TRUE TRUE TRUE FALSE TRUE 1 100 EQUALS NOTHING -- not in Part 1 of the Model Form
#ASSERT `o 64 r 4A(4) the request for service is made and accompanied as the Rule requires` FALSE TRUE TRUE TRUE TRUE FALSE TRUE 1 100 EQUALS NOTHING -- not made by an applicant to the Minister
-- r 4A(5).
#ASSERT `o 64 r 4A(5) the copies may be in electronic form` TRUE EQUALS JUST TRUE -- "may be in electronic form"
#ASSERT `o 64 r 4A(5) the copies may be in electronic form` FALSE EQUALS NOTHING -- a permission does not forbid paper
-- r 4A(6).  Arguments: the Minister considers non-compliance; informed of the non-compliance; informed of the provisions.
#ASSERT `o 64 r 4A(6) the duty to inform the applicant arises` TRUE EQUALS JUST TRUE -- "Where the Minister considers that the request does not comply"
#ASSERT `o 64 r 4A(6) the duty to inform the applicant arises` FALSE EQUALS JUST FALSE -- "Where" not met
#ASSERT `o 64 r 4A(6) the applicant has been informed as the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE -- (a) and (b)
#ASSERT `o 64 r 4A(6) the applicant has been informed as the Rule requires` TRUE TRUE FALSE EQUALS NOTHING -- (b) missing
#ASSERT `o 64 r 4A(6) the applicant has been informed as the Rule requires` FALSE TRUE TRUE EQUALS NOTHING -- the duty does not arise
-- r 4A(7).  Arguments: the Minister considers compliance may infringe sovereignty or security.  Then: refused; informed; reasons stated.
#ASSERT `o 64 r 4A(7) the Minister may refuse to comply with the request` TRUE EQUALS JUST TRUE -- "Where the Minister considers that compliance with the request may infringe the sovereignty or security of Singapore"
#ASSERT `o 64 r 4A(7) the Minister may refuse to comply with the request` FALSE EQUALS JUST FALSE -- "Where" not met
#ASSERT `o 64 r 4A(7) the applicant has been informed of the refusal and given the reasons` TRUE TRUE TRUE EQUALS JUST TRUE -- (a) and (b)
#ASSERT `o 64 r 4A(7) the applicant has been informed of the refusal and given the reasons` TRUE TRUE FALSE EQUALS NOTHING -- reasons not stated
#ASSERT `o 64 r 4A(7) the applicant has been informed of the refusal and given the reasons` TRUE FALSE TRUE EQUALS NOTHING -- applicant not informed
#ASSERT `o 64 r 4A(7) the applicant has been informed of the refusal and given the reasons` FALSE TRUE TRUE EQUALS NOTHING -- there was no refusal
-- r 4A(8).  Arguments: refused under (7); the Minister is satisfied; [forwarded].
#ASSERT `o 64 r 4A(8) the duty to forward the request to the Supreme Court arises` FALSE TRUE EQUALS JUST TRUE -- no refusal and the Minister is satisfied
#ASSERT `o 64 r 4A(8) the duty to forward the request to the Supreme Court arises` FALSE FALSE EQUALS JUST FALSE -- "where the Minister is satisfied": not met
#ASSERT `o 64 r 4A(8) the duty to forward the request to the Supreme Court arises` TRUE TRUE EQUALS JUST FALSE -- "Subject to paragraph (7)": a refusal displaces the duty
#ASSERT `o 64 r 4A(8) the request has been forwarded to the Supreme Court as the Rule requires` FALSE TRUE TRUE EQUALS JUST TRUE -- the duty arises and was done
#ASSERT `o 64 r 4A(8) the request has been forwarded to the Supreme Court as the Rule requires` FALSE TRUE FALSE EQUALS NOTHING -- the duty arises and was not done: a bare "must"
#ASSERT `o 64 r 4A(8) the request has been forwarded to the Supreme Court as the Rule requires` TRUE TRUE FALSE EQUALS NOTHING -- the duty does not arise after a refusal
#ASSERT `o 64 r 4A(8) the request has been forwarded to the Supreme Court as the Rule requires` FALSE FALSE FALSE EQUALS NOTHING -- the duty does not arise: the Minister is not satisfied
-- r 4A(9).  Arguments for "applies": a written law on bodies corporate applies.  For (c): requested by the applicant; inconsistent with law.  For the whole: written law; left; authorised method; requested method used; requested method inconsistent.
#ASSERT `o 64 r 4A(9) the requirement as to the manner of service applies` FALSE EQUALS JUST TRUE -- no written law engaged
#ASSERT `o 64 r 4A(9) the requirement as to the manner of service applies` TRUE EQUALS JUST FALSE -- "Subject to any written law which provides for the manner in which documents may be served on a body corporate"
#ASSERT `o 64 r 4A(9)(c) a particular method requested by the applicant is a way service may be effected` TRUE FALSE EQUALS JUST TRUE -- a method the applicant requested that is consistent with Singapore law
#ASSERT `o 64 r 4A(9)(c) a particular method requested by the applicant is a way service may be effected` TRUE TRUE EQUALS JUST FALSE -- "unless the method is inconsistent with any law for the time being in force in Singapore"
#ASSERT `o 64 r 4A(9)(c) a particular method requested by the applicant is a way service may be effected` FALSE FALSE EQUALS NOTHING -- not a method the applicant requested: outside limb (c)
#ASSERT `o 64 r 4A(9) service has been effected in a way the Rule allows` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- limb (a)
#ASSERT `o 64 r 4A(9) service has been effected in a way the Rule allows` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE -- limb (b)
#ASSERT `o 64 r 4A(9) service has been effected in a way the Rule allows` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- limb (c), consistent with law
#ASSERT `o 64 r 4A(9) service has been effected in a way the Rule allows` FALSE FALSE FALSE TRUE TRUE EQUALS NOTHING -- limb (c) lifted by "unless"; nothing else used
#ASSERT `o 64 r 4A(9) service has been effected in a way the Rule allows` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING -- none of the ways used: a bare "must"
#ASSERT `o 64 r 4A(9) service has been effected in a way the Rule allows` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING -- the requirement is displaced by a written law
-- r 4A(10).
#ASSERT `o 64 r 4A(10) service is effected by the process server` TRUE EQUALS JUST TRUE -- "Service must be effected by the process server"
#ASSERT `o 64 r 4A(10) service is effected by the process server` FALSE EQUALS NOTHING -- a bare "must"
-- r 4A(11).  Arguments: service effected; attempts failed; [affidavit filed / certificate given].
#ASSERT `o 64 r 4A(11) the duties after service or failed attempts arise` TRUE FALSE EQUALS JUST TRUE -- "After service of the document has been effected"
#ASSERT `o 64 r 4A(11) the duties after service or failed attempts arise` FALSE TRUE EQUALS JUST TRUE -- "attempts to effect service of it have failed"
#ASSERT `o 64 r 4A(11) the duties after service or failed attempts arise` FALSE FALSE EQUALS JUST FALSE -- neither
#ASSERT `o 64 r 4A(11)(a) the process server has filed the affidavit` TRUE FALSE TRUE EQUALS JUST TRUE -- filed after service
#ASSERT `o 64 r 4A(11)(a) the process server has filed the affidavit` TRUE FALSE FALSE EQUALS NOTHING -- not filed: a bare "must file"
#ASSERT `o 64 r 4A(11)(a) the process server has filed the affidavit` FALSE FALSE TRUE EQUALS NOTHING -- the duty has not arisen
#ASSERT `o 64 r 4A(11)(b) the Registrar has given the applicant the certificate` FALSE TRUE TRUE EQUALS JUST TRUE -- given after a failed attempt
#ASSERT `o 64 r 4A(11)(b) the Registrar has given the applicant the certificate` FALSE TRUE FALSE EQUALS NOTHING -- not given
#ASSERT `o 64 r 4A(11)(b) the Registrar has given the applicant the certificate` FALSE FALSE TRUE EQUALS NOTHING -- the duty has not arisen
-- r 4A(12).  Arguments: [in electronic form] / sealed; sent.
#ASSERT `o 64 r 4A(12) the certificate may be in electronic form` TRUE EQUALS JUST TRUE -- "may be in electronic form"
#ASSERT `o 64 r 4A(12) the certificate may be in electronic form` FALSE EQUALS NOTHING -- a permission does not forbid paper
#ASSERT `o 64 r 4A(12) the certificate is sealed and sent as the Rule requires` TRUE TRUE EQUALS JUST TRUE -- (a) and (b)
#ASSERT `o 64 r 4A(12) the certificate is sealed and sent as the Rule requires` TRUE FALSE EQUALS NOTHING -- not sent
#ASSERT `o 64 r 4A(12) the certificate is sealed and sent as the Rule requires` FALSE TRUE EQUALS NOTHING -- not sealed
-- r 4A(14).
#ASSERT `o 64 r 4A(14) the value of the action in which the request is treated as made` EQUALS 1000000 -- "a value of up to $1 million" (the band answered as 1_000_000; F-O64-6)
#ASSERT `o 64 r 4A(14) the court system of the action in which the request is treated as made` EQUALS `Supreme Court` -- "an action filed in the Supreme Court"
#ASSERT `o 64 r 4A(14) the request is treated as made in a Supreme Court action of value up to $1 million` TRUE EQUALS JUST TRUE -- the fees for service under Rule 4A
#ASSERT `o 64 r 4A(14) the request is treated as made in a Supreme Court action of value up to $1 million` FALSE EQUALS NOTHING -- other fees: outside "For the purposes of calculating the fees that are required to be paid in respect of effecting service under this Rule"

-- ---------------------------------------------------------------------------
§ `O 64 r 5 -- costs certified by the Registrar`
-- ---------------------------------------------------------------------------
-- Arguments: the costs were incurred under Rule 2 or 4; a statement was submitted / the Registrar certified.
#ASSERT `o 64 r 5 the statement of costs has been submitted to the Registrar` TRUE TRUE EQUALS JUST TRUE -- "must be submitted to the Registrar"
#ASSERT `o 64 r 5 the statement of costs has been submitted to the Registrar` TRUE FALSE EQUALS NOTHING -- a bare "must"
#ASSERT `o 64 r 5 the statement of costs has been submitted to the Registrar` FALSE TRUE EQUALS NOTHING -- costs under Rule 4A are outside "under Rule 2 or 4"
#ASSERT `o 64 r 5 the Registrar has certified the amount properly payable` TRUE TRUE EQUALS JUST TRUE -- "who must certify the amount properly payable"
#ASSERT `o 64 r 5 the Registrar has certified the amount properly payable` TRUE FALSE EQUALS NOTHING -- a bare "must"
#ASSERT `o 64 r 5 the Registrar has certified the amount properly payable` FALSE TRUE EQUALS NOTHING -- costs under Rule 4A are outside "under Rule 2 or 4"

-- ---------------------------------------------------------------------------
§ `O 64 -- the duties as regulative rules (each run once with the named party doing the act)`
-- ---------------------------------------------------------------------------
-- The text states no deadline for any of these duties, so each rule can only be FULFILLED by the act or left standing.
-- #TRACE prints an outcome and no assertion line; the expected outcome is written beside each run and recorded in NOTES.md.
-- expected: FULFILLED
#TRACE `o 64 r 2(3) the Minister's duty to inform the requesting tribunal` AT 0 WITH
    PARTY `o 64 the Minister` DOES `o 64 inform the requesting tribunal or the applicant` AT 3
-- expected: FULFILLED
#TRACE `o 64 r 2(7) the process server's duty to file` AT 0 WITH
    PARTY `o 64 the process server` DOES `o 64 file the affidavit and the statement of costs` AT 5
-- expected: FULFILLED
#TRACE `o 64 r 2(8) the Registrar's duty to give the certificate` AT 0 WITH
    PARTY `o 64 the Registrar` DOES `o 64 give the certificate` AT 5
-- expected: FULFILLED
#TRACE `o 64 r 2(9) the Registrar's duty to seal and send the certificate` AT 0 WITH
    PARTY `o 64 the Registrar` DOES `o 64 seal the certificate and send it` AT 5
-- expected: FULFILLED
#TRACE `o 64 r 4A(6) the Minister's duty to inform the applicant` AT 0 WITH
    PARTY `o 64 the Minister` DOES `o 64 inform the requesting tribunal or the applicant` AT 2
-- expected: FULFILLED
#TRACE `o 64 r 4A(7) the Minister's duty on refusing the request` AT 0 WITH
    PARTY `o 64 the Minister` DOES `o 64 refuse the request and give the reasons` AT 2
-- expected: FULFILLED
#TRACE `o 64 r 4A(8) the Minister's duty to forward the request` AT 0 WITH
    PARTY `o 64 the Minister` DOES `o 64 forward the request to the Supreme Court` AT 2
-- expected: FULFILLED
#TRACE `o 64 r 4A(11)(a) the process server's duty to file the affidavit` AT 0 WITH
    PARTY `o 64 the process server` DOES `o 64 file the affidavit and the statement of costs` AT 4
-- expected: FULFILLED
#TRACE `o 64 r 4A(11)(b) the Registrar's duty to give the applicant a certificate` AT 0 WITH
    PARTY `o 64 the Registrar` DOES `o 64 give the certificate` AT 4
-- expected: FULFILLED
#TRACE `o 64 r 5 the Registrar's duty to certify the amount properly payable` AT 0 WITH
    PARTY `o 64 the Registrar` DOES `o 64 certify the amount properly payable` AT 4
-- Nothing done: the duty is left standing (a residual obligation, not a breach, because the text gives no deadline).
-- expected: the obligation printed back (no breach)
#TRACE `o 64 r 2(7) the process server's duty to file` AT 0 WITH
    (WAITUNTIL 100)
