IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc2-order-9c`

-- Tests for Order 9, Rules 20 to 25 (roc2-order-9c.l4).  Expected values are written from the text, beside the assertion.
-- One #ASSERT per line.  A made-up "last day" stands in for the answer of O 3 r 3 (roc1).

-- Rule 20
#ASSERT `o 9 r 20 the Court may order the production of documents` TRUE EQUALS JUST TRUE -- "in accordance with Order 11"
#ASSERT `o 9 r 20 the Court may order the production of documents` FALSE EQUALS NOTHING -- not in accordance with Order 11: limited by its own wording

-- Rule 21
#ASSERT `o 9 r 21(1) the parties are to inform the Court during the case conference` TRUE EQUALS JUST TRUE -- "if they intend to rely on expert evidence"
#ASSERT `o 9 r 21(1) the parties are to inform the Court during the case conference` FALSE EQUALS JUST FALSE -- "if" fails
#ASSERT `o 9 r 21(1) the parties have informed the Court as required` TRUE EQUALS JUST TRUE -- informed during the case conference
#ASSERT `o 9 r 21(1) the parties have informed the Court as required` FALSE EQUALS JUST FALSE -- not informed during the case conference
#ASSERT `o 9 r 21(2) the Court must consider the matters set out in Order 12` TRUE EQUALS JUST TRUE -- "If one or more parties intend to rely on expert evidence"
#ASSERT `o 9 r 21(2) the Court must consider the matters set out in Order 12` FALSE EQUALS JUST FALSE -- "If" fails
#ASSERT `o 9 r 21(3) the Court may do this` `o 9 r 21(3) appoint one or more assessors` TRUE FALSE EQUALS JUST TRUE -- "upon application by any party"
#ASSERT `o 9 r 21(3) the Court may do this` `o 9 r 21(3) give directions on the role of the assessors` FALSE TRUE EQUALS JUST TRUE -- "on its own accord"
#ASSERT `o 9 r 21(3) the Court may do this` `o 9 r 21(3) give directions on the remuneration of the assessors` TRUE TRUE EQUALS JUST TRUE -- "directions on the role and the remuneration"
#ASSERT `o 9 r 21(3) the Court may do this` `o 9 r 21(3) appoint one or more assessors` FALSE FALSE EQUALS JUST FALSE -- neither application nor own accord: "upon" is read as "where", so JUST FALSE

-- Rule 22
#ASSERT `o 9 r 22(1) the Court may order the person to give evidence orally or by affidavit as an independent witness` TRUE TRUE EQUALS JUST TRUE -- on its own accord, a person not named as a witness
#ASSERT `o 9 r 22(1) the Court may order the person to give evidence orally or by affidavit as an independent witness` FALSE TRUE EQUALS NOTHING -- not on its own accord
#ASSERT `o 9 r 22(1) the Court may order the person to give evidence orally or by affidavit as an independent witness` TRUE FALSE EQUALS NOTHING -- the person is named as a witness for a party
#ASSERT `o 9 r 22(2) the Court may give directions for the cross-examination of the person` TRUE EQUALS JUST TRUE -- an independent witness
#ASSERT `o 9 r 22(2) the Court may give directions for the cross-examination of the person` FALSE EQUALS NOTHING -- not an independent witness
#ASSERT `o 9 r 22(3) the Court may invite the person to give views in writing on specific issues` TRUE EQUALS JUST TRUE -- has an interest or is able to assist
#ASSERT `o 9 r 22(3) the Court may invite the person to give views in writing on specific issues` FALSE EQUALS NOTHING -- neither
#ASSERT `o 9 r 22(4) the interested person or entity is required to do this` TRUE `o 9 r 22(4) be cross-examined` EQUALS JUST FALSE -- "is not subject to cross-examination"
#ASSERT `o 9 r 22(4) the interested person or entity is required to do this` TRUE `o 9 r 22(4) attend the hearing` EQUALS JUST FALSE -- "need not attend the hearing"
#ASSERT `o 9 r 22(4) the interested person or entity is required to do this` FALSE `o 9 r 22(4) attend the hearing` EQUALS NOTHING -- not an interested person or entity
#ASSERT `o 9 r 22(5) the Court may order one or more of the parties to pay the expenses` TRUE TRUE EQUALS JUST TRUE -- reasonable expenses of an independent witness
#ASSERT `o 9 r 22(5) the Court may order one or more of the parties to pay the expenses` TRUE FALSE EQUALS NOTHING -- not reasonable
#ASSERT `o 9 r 22(5) the Court may order one or more of the parties to pay the expenses` FALSE TRUE EQUALS NOTHING -- not incurred by such a person

-- Rule 23
#ASSERT `o 9 r 23(1) the Court may appoint one or more independent counsel` TRUE TRUE EQUALS JUST TRUE -- on its own accord, to assist on specific issues of law
#ASSERT `o 9 r 23(1) the Court may appoint one or more independent counsel` FALSE TRUE EQUALS NOTHING -- not on its own accord
#ASSERT `o 9 r 23(1) the Court may appoint one or more independent counsel` TRUE FALSE EQUALS NOTHING -- not to assist on specific issues of law
#ASSERT `o 9 r 23(2) the person may be an independent counsel` `o 9 r 23(2)(a) a solicitor` EQUALS JUST TRUE -- (a)
#ASSERT `o 9 r 23(2) the person may be an independent counsel` `o 9 r 23(2)(b) an academic involved in the teaching of law at present or in the past` EQUALS JUST TRUE -- (b)
#ASSERT `o 9 r 23(2) the person may be an independent counsel` `o 9 r 23(2)(c) a person who has special knowledge or experience in any area of law` EQUALS JUST TRUE -- (c)
#ASSERT `o 9 r 23(2) the person may be an independent counsel` `o 9 r 23(2) any other person` EQUALS NOTHING -- not one of (a) to (c): the list is not said to be closed
#ASSERT `o 9 r 23(3) the Court must give directions to the independent counsel on this matter` TRUE `o 9 r 23(3)(a) the specific issues of law to be addressed by the independent counsel` EQUALS JUST TRUE -- (a)
#ASSERT `o 9 r 23(3) the Court must give directions to the independent counsel on this matter` TRUE `o 9 r 23(3)(b) the filing and service of written submissions by the independent counsel and the parties` EQUALS JUST TRUE -- (b)
#ASSERT `o 9 r 23(3) the Court must give directions to the independent counsel on this matter` TRUE `o 9 r 23(3)(c) the independent counsel's attendance in Court to make oral submissions` EQUALS JUST TRUE -- (c)
#ASSERT `o 9 r 23(3) the Court must give directions to the independent counsel on this matter` FALSE `o 9 r 23(3)(c) the independent counsel's attendance in Court to make oral submissions` EQUALS NOTHING -- no independent counsel appointed

-- Rule 24
#ASSERT `o 9 r 24(1) a party may apply to the Court for an order for pre-trial examination` TRUE EQUALS JUST TRUE -- necessary in the interests of justice
#ASSERT `o 9 r 24(1) a party may apply to the Court for an order for pre-trial examination` FALSE EQUALS JUST FALSE -- "Where it is necessary" fails
#ASSERT `o 9 r 24(2) the affidavit shows what paragraph (2) requires` TRUE TRUE TRUE FALSE EQUALS JUST TRUE -- (a), (b) and the first alternative of (c)
#ASSERT `o 9 r 24(2) the affidavit shows what paragraph (2) requires` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- (a), (b) and the second alternative of (c)
#ASSERT `o 9 r 24(2) the affidavit shows what paragraph (2) requires` FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- (a) not shown
#ASSERT `o 9 r 24(2) the affidavit shows what paragraph (2) requires` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- (b) not shown
#ASSERT `o 9 r 24(2) the affidavit shows what paragraph (2) requires` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- neither alternative of (c)
#ASSERT `o 9 r 24(3) the affidavit must also state the matters in paragraph (3)` TRUE EQUALS JUST TRUE -- the examination is to be outside Singapore
#ASSERT `o 9 r 24(3) the affidavit must also state the matters in paragraph (3)` FALSE EQUALS JUST FALSE -- "If" fails: in Singapore
#ASSERT `o 9 r 24(3) the affidavit states the matters in paragraph (3)` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- (a) to (d) all stated
#ASSERT `o 9 r 24(3) the affidavit states the matters in paragraph (3)` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- (a) place not stated
#ASSERT `o 9 r 24(3) the affidavit states the matters in paragraph (3)` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- (b) law of that place not stated
#ASSERT `o 9 r 24(3) the affidavit states the matters in paragraph (3)` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- (c) examiner not stated
#ASSERT `o 9 r 24(3) the affidavit states the matters in paragraph (3)` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- (d) rules not stated
#ASSERT `o 9 r 24(4) the party may include a request for the issue of a letter of request` TRUE EQUALS JUST TRUE -- the law of that place requires a letter of request
#ASSERT `o 9 r 24(4) the party may include a request for the issue of a letter of request` FALSE EQUALS JUST FALSE -- "If" fails
#ASSERT `o 9 r 24(4) the application for a letter of request may be made in this court` TRUE `General Division` EQUALS JUST TRUE -- "only be made in the General Division"
#ASSERT `o 9 r 24(4) the application for a letter of request may be made in this court` TRUE `District Court` EQUALS JUST FALSE -- the State Courts are not the General Division
#ASSERT `o 9 r 24(4) the application for a letter of request may be made in this court` TRUE `Magistrate's Court` EQUALS JUST FALSE -- same
#ASSERT `o 9 r 24(4) the application for a letter of request may be made in this court` FALSE `District Court` EQUALS NOTHING -- an application that does not include a request for a letter of request
#ASSERT `o 9 r 24(5)(a) the letter of request is in the form required` TRUE TRUE FALSE EQUALS JUST TRUE -- Hague Evidence Convention applies: Recommended Model Form
#ASSERT `o 9 r 24(5)(a) the letter of request is in the form required` TRUE FALSE TRUE EQUALS JUST FALSE -- Convention applies but the letter is in Form 17
#ASSERT `o 9 r 24(5)(a) the letter of request is in the form required` FALSE FALSE TRUE EQUALS JUST TRUE -- "in any other case — in Form 17"
#ASSERT `o 9 r 24(5)(a) the letter of request is in the form required` FALSE TRUE FALSE EQUALS JUST FALSE -- not the Convention: the Model Form is not Form 17
#ASSERT `o 9 r 24(5)(b) the undertaking is as required` TRUE TRUE EQUALS JUST TRUE -- Form 18 filed, signed by the party or solicitor
#ASSERT `o 9 r 24(5)(b) the undertaking is as required` TRUE FALSE EQUALS JUST FALSE -- unsigned
#ASSERT `o 9 r 24(5)(b) the undertaking is as required` FALSE TRUE EQUALS JUST FALSE -- not filed
#ASSERT `o 9 r 24(6) the pre-trial examination in Singapore is conducted as required` TRUE TRUE TRUE EQUALS JUST TRUE -- in Singapore before a Judge or the Registrar under the rules governing trials
#ASSERT `o 9 r 24(6) the pre-trial examination in Singapore is conducted as required` TRUE FALSE TRUE EQUALS JUST FALSE -- not before a Judge or the Registrar
#ASSERT `o 9 r 24(6) the pre-trial examination in Singapore is conducted as required` TRUE TRUE FALSE EQUALS JUST FALSE -- not under the rules governing trials
#ASSERT `o 9 r 24(6) the pre-trial examination in Singapore is conducted as required` FALSE TRUE TRUE EQUALS NOTHING -- not in Singapore
#ASSERT `o 9 r 24(7) the attendance of the witness and the production of documents may be enforced by an order to attend court and an order to produce documents` TRUE EQUALS JUST TRUE -- an order for pre-trial examination in Singapore has been made
#ASSERT `o 9 r 24(7) the attendance of the witness and the production of documents may be enforced by an order to attend court and an order to produce documents` FALSE EQUALS JUST FALSE -- "Where" fails
#ASSERT `o 9 r 24(8) the pre-trial examination outside Singapore is conducted as required` TRUE TRUE TRUE EQUALS JUST TRUE -- outside Singapore, examiner appointed by the Court, in the manner directed
#ASSERT `o 9 r 24(8) the pre-trial examination outside Singapore is conducted as required` TRUE FALSE TRUE EQUALS JUST FALSE -- not by the examiner appointed by the Court
#ASSERT `o 9 r 24(8) the pre-trial examination outside Singapore is conducted as required` TRUE TRUE FALSE EQUALS JUST FALSE -- not in the manner directed
#ASSERT `o 9 r 24(8) the pre-trial examination outside Singapore is conducted as required` FALSE TRUE TRUE EQUALS NOTHING -- in Singapore
#ASSERT `o 9 r 24(8) the examiner may do the thing` TRUE EQUALS JUST FALSE -- "must not do anything that is contrary to the law of that place"
#ASSERT `o 9 r 24(8) the examiner may do the thing` FALSE EQUALS NOTHING -- not contrary to the law of that place: the prohibition does not reach it
#ASSERT `o 9 r 24(9) an instrument is the Hague Evidence Convention` TRUE EQUALS JUST TRUE -- the Convention on the Taking of Evidence Abroad ... done at the Hague on 18 March 1970
#ASSERT `o 9 r 24(9) an instrument is the Hague Evidence Convention` FALSE EQUALS JUST FALSE -- any other instrument: "means"
#ASSERT `o 9 r 24(9) an authority is an issuing authority` TRUE EQUALS JUST TRUE -- responsible for issuing a letter of request under this Rule
#ASSERT `o 9 r 24(9) an authority is an issuing authority` FALSE EQUALS JUST FALSE -- "means"
#ASSERT `o 9 r 24(9) a form is a Recommended Model Form` TRUE TRUE EQUALS JUST TRUE -- a Model Form for a Letter of Request under the Convention, as set out on its website
#ASSERT `o 9 r 24(9) a form is a Recommended Model Form` TRUE FALSE EQUALS JUST FALSE -- not as set out on that website
#ASSERT `o 9 r 24(9) a form is a Recommended Model Form` FALSE TRUE EQUALS JUST FALSE -- not a Model Form under the Convention
#ASSERT `o 9 r 24(9) an authority is a transmitting authority` TRUE EQUALS JUST TRUE -- responsible for transmitting a letter of request issued under this Rule
#ASSERT `o 9 r 24(9) an authority is a transmitting authority` FALSE EQUALS JUST FALSE -- "means"

-- Rule 25
#ASSERT `o 9 r 25(1) the Court must give directions for the case to proceed to trial or hearing` FALSE TRUE EQUALS JUST TRUE -- at the appropriate stage
#ASSERT `o 9 r 25(1) the Court must give directions for the case to proceed to trial or hearing` FALSE FALSE EQUALS NOTHING -- not yet the appropriate stage
#ASSERT `o 9 r 25(1) the Court must give directions for the case to proceed to trial or hearing` TRUE TRUE EQUALS NOTHING -- "Subject to these Rules": another Rule otherwise provides
#ASSERT `o 9 r 25(2) the Court may order a bifurcated hearing` `A Judge` `A Judge` EQUALS JUST TRUE -- liability by a Judge, amount by a Judge
#ASSERT `o 9 r 25(2) the Court may order a bifurcated hearing` `A Judge` `The Registrar` EQUALS JUST TRUE -- liability by a Judge, amount by the Registrar
#ASSERT `o 9 r 25(2) the Court may order a bifurcated hearing` `The Registrar` `A Judge` EQUALS NOTHING -- liability by the Registrar: not what the paragraph names
#ASSERT `o 9 r 25(2) the Court may order a bifurcated hearing` `A Judge` `A District Judge` EQUALS NOTHING -- amount by a District Judge: not what the paragraph names
#ASSERT `o 9 r 25(3) the Court may order the issue to be heard and decided separately` TRUE EQUALS JUST TRUE -- an issue of fact
#ASSERT `o 9 r 25(3) the Court may order the issue to be heard and decided separately` FALSE EQUALS NOTHING -- not an issue of fact
#ASSERT `o 9 r 25(4) the Court must fix a period within which the claimant is to set down the action for trial` TRUE EQUALS JUST TRUE -- commenced by an originating claim
#ASSERT `o 9 r 25(4) the Court must fix a period within which the claimant is to set down the action for trial` FALSE EQUALS NOTHING -- commenced by an originating application
#ASSERT `o 9 r 25(5) this may be done` TRUE `o 9 r 25(5) the defendant sets the action down for trial` FALSE EQUALS JUST TRUE -- "the defendant may set the action down for trial"
#ASSERT `o 9 r 25(5) this may be done` TRUE `o 9 r 25(5) the defendant applies to the Court to dismiss the action` FALSE EQUALS JUST TRUE -- "or may apply to the Court to dismiss the action"
#ASSERT `o 9 r 25(5) this may be done` TRUE `o 9 r 25(5) the Court orders the action to be dismissed` TRUE EQUALS JUST TRUE -- "on the hearing of any such application, the Court may order the action to be dismissed"
#ASSERT `o 9 r 25(5) this may be done` TRUE `o 9 r 25(5) the Court makes such order as the Court thinks just` TRUE EQUALS JUST TRUE -- "or make such order as the Court thinks just"
#ASSERT `o 9 r 25(5) this may be done` TRUE `o 9 r 25(5) the Court orders the action to be dismissed` FALSE EQUALS NOTHING -- no application has been heard
#ASSERT `o 9 r 25(5) this may be done` TRUE `o 9 r 25(5) the Court makes such order as the Court thinks just` FALSE EQUALS NOTHING -- no application has been heard
#ASSERT `o 9 r 25(5) this may be done` FALSE `o 9 r 25(5) the defendant sets the action down for trial` FALSE EQUALS JUST FALSE -- the claimant did set down in time: "Where" fails
#ASSERT `o 9 r 25(6) the notice for setting down an action for trial is in the form required` TRUE EQUALS JUST TRUE -- Form 19
#ASSERT `o 9 r 25(6) the notice for setting down an action for trial is in the form required` FALSE EQUALS JUST FALSE -- not Form 19
#ASSERT `o 9 r 25(7) the notice for setting down an action for trial states what paragraph (7) requires` TRUE TRUE TRUE EQUALS JUST TRUE -- length, dates, witnesses
#ASSERT `o 9 r 25(7) the notice for setting down an action for trial states what paragraph (7) requires` FALSE TRUE TRUE EQUALS JUST FALSE -- length missing
#ASSERT `o 9 r 25(7) the notice for setting down an action for trial states what paragraph (7) requires` TRUE FALSE TRUE EQUALS JUST FALSE -- dates missing
#ASSERT `o 9 r 25(7) the notice for setting down an action for trial states what paragraph (7) requires` TRUE TRUE FALSE EQUALS JUST FALSE -- witnesses missing
#ASSERT `o 9 r 25(8) twenty-four hours after the date on which the notice is filed`'s `period unit` EQUALS Hours -- "within 24 hours"
#ASSERT `o 9 r 25(8) twenty-four hours after the date on which the notice is filed`'s `period length` EQUALS 24 -- "24 hours"
#ASSERT `o 9 r 25(8) the notice for setting down an action for trial is served in time` (Date 15 9 2027) (Date 15 9 2027) EQUALS JUST TRUE -- served within the period
#ASSERT `o 9 r 25(8) the notice for setting down an action for trial is served in time` (Date 16 9 2027) (Date 15 9 2027) EQUALS JUST FALSE -- served after the period
#TRACE `o 9 r 25(8) the party setting down the action must serve the notice` AT 0 WITH
    PARTY `o 9 r 25(8) the party setting down the action for trial` DOES `o 9 r 25(8) serve the notice on all other parties to the action` AT 1
#TRACE `o 9 r 25(8) the party setting down the action must serve the notice` AT 0 WITH
    (WAITUNTIL 2)
#ASSERT `o 9 r 25(9) the Court must give this direction to the parties` TRUE `o 9 r 25(9)(a) to file and serve their affidavits of evidence-in-chief or other affidavits` FALSE EQUALS JUST TRUE -- (a), not given earlier
#ASSERT `o 9 r 25(9) the Court must give this direction to the parties` TRUE `o 9 r 25(9)(a) to file and serve their affidavits of evidence-in-chief or other affidavits` TRUE EQUALS JUST FALSE -- (a) "(if such directions have not been given earlier)" fails
#ASSERT `o 9 r 25(9) the Court must give this direction to the parties` TRUE `o 9 r 25(9)(b) to file and serve the bundles of documents` FALSE EQUALS JUST TRUE -- (b)
#ASSERT `o 9 r 25(9) the Court must give this direction to the parties` TRUE `o 9 r 25(9)(c) to file and serve their opening statements, without the need for bundles of authorities` FALSE EQUALS JUST TRUE -- (c)
#ASSERT `o 9 r 25(9) the Court must give this direction to the parties` FALSE `o 9 r 25(9)(b) to file and serve the bundles of documents` FALSE EQUALS NOTHING -- not an action commenced by an originating claim
#ASSERT `o 9 r 25(9)(c) the page limit of an opening statement` EQUALS 25 -- "a page limit of 25 pages"
#ASSERT `o 9 r 25(9)(c) the opening statement is within the page limit` 25 EQUALS JUST TRUE -- exactly 25 pages
#ASSERT `o 9 r 25(9)(c) the opening statement is within the page limit` 26 EQUALS JUST FALSE -- 26 pages
#ASSERT `o 9 r 25(9)(c) the opening statement is within the page limit` 1 EQUALS JUST TRUE -- one page
#ASSERT `o 9 r 25(10) the bundle of documents contains what paragraph (10) requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- (a), (b), (c) and the sections
#ASSERT `o 9 r 25(10) the bundle of documents contains what paragraph (10) requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- no last pleading
#ASSERT `o 9 r 25(10) the bundle of documents contains what paragraph (10) requires` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- no relevant orders
#ASSERT `o 9 r 25(10) the bundle of documents contains what paragraph (10) requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- no documents relied on
#ASSERT `o 9 r 25(10) the bundle of documents contains what paragraph (10) requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- not separated into sections
#ASSERT `o 9 r 25(11) the bundle of documents is arranged and composed as required` TRUE FALSE FALSE EQUALS JUST TRUE -- arranged, no repeats, nothing unexchanged
#ASSERT `o 9 r 25(11) the bundle of documents is arranged and composed as required` FALSE FALSE FALSE EQUALS JUST FALSE -- not arranged in a meaningful order
#ASSERT `o 9 r 25(11) the bundle of documents is arranged and composed as required` TRUE TRUE FALSE EQUALS JUST FALSE -- contains repeat documents
#ASSERT `o 9 r 25(11) the bundle of documents is arranged and composed as required` TRUE FALSE TRUE EQUALS JUST FALSE -- contains documents not exchanged or produced under Order 11
#ASSERT `o 9 r 25(12) the Court must give the appropriate directions for the assessment of damages or the taking of accounts` TRUE EQUALS JUST TRUE -- liability agreed or determined
#ASSERT `o 9 r 25(12) the Court must give the appropriate directions for the assessment of damages or the taking of accounts` FALSE EQUALS JUST FALSE -- "Where" fails
#ASSERT `o 9 r 25(13) the Court must consider this` TRUE TRUE `o 9 r 25(13)(a) whether to order the claim and the counterclaim to be heard together or separately` EQUALS JUST TRUE -- (a)
#ASSERT `o 9 r 25(13) the Court must consider this` TRUE TRUE `o 9 r 25(13)(b) whether to order the defendant to file a separate action for the defendant's counterclaim` EQUALS JUST TRUE -- (b)
#ASSERT `o 9 r 25(13) the Court must consider this` FALSE TRUE `o 9 r 25(13)(a) whether to order the claim and the counterclaim to be heard together or separately` EQUALS JUST FALSE -- not an originating application
#ASSERT `o 9 r 25(13) the Court must consider this` TRUE FALSE `o 9 r 25(13)(a) whether to order the claim and the counterclaim to be heard together or separately` EQUALS JUST FALSE -- no counterclaim in the defendant's affidavit
#ASSERT `o 9 r 25(14) the page limit of written submissions` EQUALS 35 -- "a page limit of 35 pages"
#ASSERT `o 9 r 25(14) the Court may order the parties to file and serve written submissions together with the bundle of authorities` TRUE EQUALS JUST TRUE -- originating application
#ASSERT `o 9 r 25(14) the Court may order the parties to file and serve written submissions together with the bundle of authorities` FALSE EQUALS NOTHING -- not an originating application
#ASSERT `o 9 r 25(14) the written submissions are within the page limit` 35 FALSE EQUALS JUST TRUE -- exactly 35
#ASSERT `o 9 r 25(14) the written submissions are within the page limit` 36 FALSE EQUALS JUST FALSE -- 36 pages, not a special case
#ASSERT `o 9 r 25(14) the written submissions are within the page limit` 60 TRUE EQUALS JUST TRUE -- "except in a special case"
#ASSERT `o 9 r 25(15) the Court may allow the page limit to be exceeded` TRUE TRUE FALSE EQUALS JUST TRUE -- special circumstances, fees paid
#ASSERT `o 9 r 25(15) the Court may allow the page limit to be exceeded` TRUE FALSE TRUE EQUALS JUST TRUE -- special circumstances, the Court otherwise orders under paragraph (16)
#ASSERT `o 9 r 25(15) the Court may allow the page limit to be exceeded` TRUE FALSE FALSE EQUALS JUST FALSE -- special circumstances but fees unpaid and no order: "upon the payment" is read as "where", so JUST FALSE
#ASSERT `o 9 r 25(15) the Court may allow the page limit to be exceeded` FALSE TRUE FALSE EQUALS NOTHING -- no special circumstances
#ASSERT `o 9 r 25(15) the Court may allow the page limit to be exceeded` FALSE FALSE FALSE EQUALS JUST FALSE -- no special circumstances and fees unpaid with no order: the unpaid fees are a no whatever the circumstances
#ASSERT `o 9 r 25(15)(b) the fees for the pages in excess of the page limit have been paid` 100 100 EQUALS TRUE -- the fee is the Fourth Schedule's; paid in full
#ASSERT `o 9 r 25(15)(b) the fees for the pages in excess of the page limit have been paid` 100 99 EQUALS FALSE -- short by 1
#ASSERT `o 9 r 25(16) the Court may deal with the payment of the fees in this way` `o 9 r 25(16) waive the payment` TRUE EQUALS JUST TRUE -- "waive"
#ASSERT `o 9 r 25(16) the Court may deal with the payment of the fees in this way` `o 9 r 25(16) refund the payment` TRUE EQUALS JUST TRUE -- "refund"
#ASSERT `o 9 r 25(16) the Court may deal with the payment of the fees in this way` `o 9 r 25(16) defer the payment` TRUE EQUALS JUST TRUE -- "defer"
#ASSERT `o 9 r 25(16) the Court may deal with the payment of the fees in this way` `o 9 r 25(16) apportion the payment` TRUE EQUALS JUST TRUE -- "apportion"
#ASSERT `o 9 r 25(16) the Court may deal with the payment of the fees in this way` `o 9 r 25(16) waive the payment` FALSE EQUALS JUST FALSE -- no application: "upon application" is read as "where", so JUST FALSE
#ASSERT `o 9 r 25(17) the Court must do this` `o 9 r 25(17) estimate the length of time needed for the trial or hearing, including oral or written submissions` EQUALS JUST TRUE -- "estimate the length of time"
#ASSERT `o 9 r 25(17) the Court must do this` `o 9 r 25(17) assign the trial or hearing dates accordingly` EQUALS JUST TRUE -- "assign the trial or hearing dates accordingly"
