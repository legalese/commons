IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc10-order-55`

-- Rules of Court 2021 (Singapore), Order 55 (Obtaining evidence for foreign courts, etc.): TESTS.
-- Every expected value is written beside its assertion from the text of the rule it cites (lines 6702 to 6721 of the text),
-- never copied from the output of the code.

-- Rule 1
#ASSERT `o 55 r 1(1) the Registrar may exercise the power to make the order` TRUE FALSE `o 55 r 1(1) an order for the examination of witnesses` EQUALS JUST TRUE -- examination of witnesses
#ASSERT `o 55 r 1(1) the Registrar may exercise the power to make the order` TRUE FALSE `o 55 r 1(1) an order for attendance` EQUALS JUST TRUE -- attendance
#ASSERT `o 55 r 1(1) the Registrar may exercise the power to make the order` TRUE FALSE `o 55 r 1(1) an order for production of documents` EQUALS JUST TRUE -- production of documents
#ASSERT `o 55 r 1(1) the Registrar may exercise the power to make the order` TRUE FALSE `o 55 r 1(1) a direction` EQUALS JUST TRUE -- "and to give directions"
#ASSERT `o 55 r 1(1) the Registrar may exercise the power to make the order` TRUE FALSE `o 55 r 1(1) another kind of order` EQUALS NOTHING -- not one of the kinds the power is for
#ASSERT `o 55 r 1(1) the Registrar may exercise the power to make the order` TRUE TRUE `o 55 r 1(1) an order for the examination of witnesses` EQUALS JUST FALSE -- "Subject to paragraph (2)": a criminal matter
#ASSERT `o 55 r 1(1) the Registrar may exercise the power to make the order` FALSE FALSE `o 55 r 1(1) an order for the examination of witnesses` EQUALS NOTHING -- not a matter pending before a foreign court or tribunal
#ASSERT `o 55 r 1(1) the Registrar may exercise the power to make the order` FALSE TRUE `o 55 r 1(1) an order for the examination of witnesses` EQUALS NOTHING -- not a matter pending abroad
#ASSERT `o 55 r 1(2) the Registrar is barred from making the order` TRUE TRUE EQUALS JUST TRUE -- "may not make such an order if the matter in question is a criminal matter"
#ASSERT `o 55 r 1(2) the Registrar is barred from making the order` TRUE FALSE EQUALS JUST FALSE -- not a criminal matter: the "if" fails
#ASSERT `o 55 r 1(2) the Registrar is barred from making the order` FALSE TRUE EQUALS NOTHING -- not an order of the kind in paragraph (1)
#ASSERT `o 55 r 1(2) the Registrar may make the order` TRUE TRUE EQUALS JUST FALSE -- barred
#ASSERT `o 55 r 1(2) the Registrar may make the order` TRUE FALSE EQUALS NOTHING -- the bar is not engaged and grants nothing
#ASSERT `o 55 r 1(2) the Registrar may make the order` FALSE TRUE EQUALS NOTHING -- not an order of the kind in paragraph (1)

-- Rule 2
#ASSERT `o 55 r 2(1) the application must be made without notice by an authorised person and supported by affidavit` TRUE FALSE FALSE EQUALS JUST TRUE -- an application under Rule 1
#ASSERT `o 55 r 2(1) the application must be made without notice by an authorised person and supported by affidavit` TRUE TRUE FALSE EQUALS JUST FALSE -- "Subject to paragraph (3)": a further application
#ASSERT `o 55 r 2(1) the application must be made without notice by an authorised person and supported by affidavit` TRUE FALSE TRUE EQUALS JUST FALSE -- "Subject to ... Rule 3"
#ASSERT `o 55 r 2(1) the application must be made without notice by an authorised person and supported by affidavit` FALSE FALSE FALSE EQUALS NOTHING -- not an application under Rule 1
#ASSERT `o 55 r 2(1) the application is made as it must be` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE -- without notice, by an authorised person, supported by affidavit
#ASSERT `o 55 r 2(1) the application is made as it must be` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS NOTHING -- made on notice: a bare "must"
#ASSERT `o 55 r 2(1) the application is made as it must be` TRUE FALSE FALSE TRUE FALSE TRUE EQUALS NOTHING -- by a person not duly authorised
#ASSERT `o 55 r 2(1) the application is made as it must be` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS NOTHING -- not supported by affidavit
#ASSERT `o 55 r 2(1) the application is made as it must be` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING -- a further application: the duty does not arise
#ASSERT `o 55 r 2(1) the application is made as it must be` FALSE FALSE FALSE TRUE TRUE TRUE EQUALS NOTHING -- not an application under Rule 1
#ASSERT `o 55 r 2(2) the document and any translation are exhibited as they must be` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- the document in English
#ASSERT `o 55 r 2(2) the document and any translation are exhibited as they must be` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- not in English, translation exhibited
#ASSERT `o 55 r 2(2) the document and any translation are exhibited as they must be` TRUE TRUE TRUE FALSE EQUALS NOTHING -- not in English, no translation: a bare "must"
#ASSERT `o 55 r 2(2) the document and any translation are exhibited as they must be` TRUE FALSE FALSE FALSE EQUALS NOTHING -- the document not exhibited
#ASSERT `o 55 r 2(2) the document and any translation are exhibited as they must be` FALSE TRUE FALSE FALSE EQUALS NOTHING -- not the affidavit in support
#ASSERT `o 55 r 2(3) the further application must be made by summons` TRUE TRUE EQUALS JUST TRUE -- after an application, a further application
#ASSERT `o 55 r 2(3) the further application must be made by summons` TRUE FALSE EQUALS JUST FALSE -- not a further application
#ASSERT `o 55 r 2(3) the further application must be made by summons` FALSE TRUE EQUALS JUST FALSE -- "After an application ... has been made": none made yet
#ASSERT `o 55 r 2(3) the further application is made by summons as it must be` TRUE TRUE `Summons` EQUALS JUST TRUE -- by summons
#ASSERT `o 55 r 2(3) the further application is made by summons as it must be` TRUE TRUE `Summons without notice` EQUALS NOTHING -- not by summons: a bare "must"
#ASSERT `o 55 r 2(3) the further application is made by summons as it must be` TRUE TRUE `Originating application` EQUALS NOTHING -- not by summons
#ASSERT `o 55 r 2(3) the further application is made by summons as it must be` FALSE TRUE `Summons` EQUALS NOTHING -- the duty does not arise

-- Rule 3
#ASSERT `o 55 r 3 the duty of the Registrar to send the document to the Attorney-General arises` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- (a) received by the Minister and sent to the Registrar with the intimation
#ASSERT `o 55 r 3 the duty of the Registrar to send the document to the Attorney-General arises` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- (b) received by the Registrar under a Convention, no person named
#ASSERT `o 55 r 3 the duty of the Registrar to send the document to the Attorney-General arises` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- (b) but a person is named
#ASSERT `o 55 r 3 the duty of the Registrar to send the document to the Attorney-General arises` TRUE FALSE FALSE TRUE EQUALS JUST FALSE -- (b) not received under a Convention
#ASSERT `o 55 r 3 the duty of the Registrar to send the document to the Attorney-General arises` FALSE TRUE FALSE FALSE EQUALS JUST FALSE -- not a letter of request about a witness within the jurisdiction
#ASSERT `o 55 r 3 the Registrar has sent the document to the Attorney-General as the Registrar must` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- sent
#ASSERT `o 55 r 3 the Registrar has sent the document to the Attorney-General as the Registrar must` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING -- not sent: a bare "must"
#ASSERT `o 55 r 3 the Registrar has sent the document to the Attorney-General as the Registrar must` TRUE FALSE TRUE FALSE TRUE EQUALS NOTHING -- the duty does not arise
#ASSERT `o 55 r 3 the Attorney-General may take the step` TRUE TRUE FALSE FALSE `o 55 r 3 an application for an order` EQUALS JUST TRUE -- may make an application for an order
#ASSERT `o 55 r 3 the Attorney-General may take the step` TRUE TRUE FALSE FALSE `o 55 r 3 another step necessary to give effect to the request` EQUALS JUST TRUE -- "such other steps as may be necessary"
#ASSERT `o 55 r 3 the Attorney-General may take the step` TRUE TRUE FALSE FALSE `o 55 r 3 a step not necessary to give effect to the request` EQUALS NOTHING -- outside the steps the power is for
#ASSERT `o 55 r 3 the Attorney-General may take the step` TRUE FALSE FALSE FALSE `o 55 r 3 an application for an order` EQUALS JUST FALSE -- the "Where" fails

-- Rule 4
#ASSERT `o 55 r 4(1) the order may order the examination to be taken before the person` TRUE `o 55 r 4(1) a fit and proper person nominated by the person applying for the order` TRUE EQUALS JUST TRUE -- a fit and proper nominee
#ASSERT `o 55 r 4(1) the order may order the examination to be taken before the person` TRUE `o 55 r 4(1) a fit and proper person nominated by the person applying for the order` FALSE EQUALS NOTHING -- a nominee who is not fit and proper
#ASSERT `o 55 r 4(1) the order may order the examination to be taken before the person` TRUE `o 55 r 4(1) the Registrar` FALSE EQUALS JUST TRUE -- the Registrar
#ASSERT `o 55 r 4(1) the order may order the examination to be taken before the person` TRUE `o 55 r 4(1) such other qualified person as to the Court seems fit` TRUE EQUALS JUST TRUE -- another qualified person the Court sees fit
#ASSERT `o 55 r 4(1) the order may order the examination to be taken before the person` TRUE `o 55 r 4(1) such other qualified person as to the Court seems fit` FALSE EQUALS NOTHING -- one the Court does not see fit
#ASSERT `o 55 r 4(1) the order may order the examination to be taken before the person` TRUE `o 55 r 4(1) someone else` TRUE EQUALS NOTHING -- three kinds named without "only"
#ASSERT `o 55 r 4(1) the order may order the examination to be taken before the person` FALSE `o 55 r 4(1) the Registrar` TRUE EQUALS NOTHING -- not an order for examination under this Order
#ASSERT `o 55 r 4(2) the examination must be taken in the manner provided by Order 9, Rule 24` TRUE FALSE EQUALS JUST TRUE -- no special directions
#ASSERT `o 55 r 4(2) the examination must be taken in the manner provided by Order 9, Rule 24` TRUE TRUE EQUALS JUST FALSE -- "Subject to any special directions"
#ASSERT `o 55 r 4(2) the examination must be taken in the manner provided by Order 9, Rule 24` FALSE FALSE EQUALS NOTHING -- not an order under this Order
#ASSERT `o 55 r 4(2) the examination has been taken in the manner provided by Order 9, Rule 24` TRUE FALSE TRUE EQUALS JUST TRUE -- taken in that manner
#ASSERT `o 55 r 4(2) the examination has been taken in the manner provided by Order 9, Rule 24` TRUE FALSE FALSE EQUALS NOTHING -- not taken in that manner: a bare "must"
#ASSERT `o 55 r 4(2) the examination has been taken in the manner provided by Order 9, Rule 24` TRUE TRUE TRUE EQUALS NOTHING -- special directions: the duty does not arise
#ASSERT `o 55 r 4(2) the examination has been taken in the manner provided by Order 9, Rule 24` FALSE FALSE TRUE EQUALS NOTHING -- not an order under this Order
#ASSERT `o 55 r 4(2) an order may be made under Order 9, Rule 24 for payment of the fees and expenses` TRUE TRUE EQUALS JUST TRUE -- fees and expenses due to the examiner
#ASSERT `o 55 r 4(2) an order may be made under Order 9, Rule 24 for payment of the fees and expenses` TRUE FALSE EQUALS NOTHING -- not fees and expenses due to the examiner
#ASSERT `o 55 r 4(2) an order may be made under Order 9, Rule 24 for payment of the fees and expenses` FALSE TRUE EQUALS NOTHING -- not an examination under this Order
#ASSERT `o 55 r 4(2) Order 9, Rule 24 applies with the necessary modifications` TRUE EQUALS JUST TRUE -- "that Rule applies accordingly"
#ASSERT `o 55 r 4(2) Order 9, Rule 24 applies with the necessary modifications` FALSE EQUALS NOTHING -- not an examination under this Order

-- Rule 5
#ASSERT `o 55 r 5 the duties as to the deposition arise` TRUE FALSE EQUALS JUST TRUE -- an order, which does not otherwise direct
#ASSERT `o 55 r 5 the duties as to the deposition arise` TRUE TRUE EQUALS JUST FALSE -- "Unless any order ... otherwise directs"
#ASSERT `o 55 r 5 the duties as to the deposition arise` FALSE FALSE EQUALS NOTHING -- not an order under this Order
#ASSERT `o 55 r 5 the examiner has sent the deposition to the Registrar as the examiner must` TRUE FALSE TRUE EQUALS JUST TRUE -- sent
#ASSERT `o 55 r 5 the examiner has sent the deposition to the Registrar as the examiner must` TRUE FALSE FALSE EQUALS NOTHING -- not sent: a bare "must"
#ASSERT `o 55 r 5 the examiner has sent the deposition to the Registrar as the examiner must` TRUE TRUE TRUE EQUALS NOTHING -- the order otherwise directs: the duty does not arise
#ASSERT `o 55 r 5 the examiner has sent the deposition to the Registrar as the examiner must` FALSE FALSE TRUE EQUALS NOTHING -- not an order under this Order
#ASSERT `o 55 r 5(a) the Registrar has given the certificate as the Registrar must` TRUE FALSE TRUE (`o 55 r 5(a) what the certificate is` OF TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE -- given, sealed, for use out of the jurisdiction, identifying the three documents
#ASSERT `o 55 r 5(a) the Registrar has given the certificate as the Registrar must` TRUE FALSE FALSE (`o 55 r 5(a) what the certificate is` OF TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- no certificate given: a bare "must"
#ASSERT `o 55 r 5(a) the Registrar has given the certificate as the Registrar must` TRUE FALSE TRUE (`o 55 r 5(a) what the certificate is` OF FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- not sealed
#ASSERT `o 55 r 5(a) the Registrar has given the certificate as the Registrar must` TRUE FALSE TRUE (`o 55 r 5(a) what the certificate is` OF TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS NOTHING -- not for use out of the jurisdiction
#ASSERT `o 55 r 5(a) the Registrar has given the certificate as the Registrar must` TRUE FALSE TRUE (`o 55 r 5(a) what the certificate is` OF TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS NOTHING -- does not identify the letter of request
#ASSERT `o 55 r 5(a) the Registrar has given the certificate as the Registrar must` TRUE FALSE TRUE (`o 55 r 5(a) what the certificate is` OF TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS NOTHING -- does not identify the order for examination
#ASSERT `o 55 r 5(a) the Registrar has given the certificate as the Registrar must` TRUE FALSE TRUE (`o 55 r 5(a) what the certificate is` OF TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING -- does not identify the deposition
#ASSERT `o 55 r 5(a) the Registrar has given the certificate as the Registrar must` TRUE TRUE TRUE (`o 55 r 5(a) what the certificate is` OF TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- the order otherwise directs: the duty does not arise
#ASSERT `o 55 r 5(a) the Registrar has given the certificate as the Registrar must` FALSE FALSE TRUE (`o 55 r 5(a) what the certificate is` OF TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- not an order under this Order
#ASSERT `o 55 r 5(b) the Registrar has sent the certificate with the documents annexed as the Registrar must` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- sent to the Permanent Secretary
#ASSERT `o 55 r 5(b) the Registrar has sent the certificate with the documents annexed as the Registrar must` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING -- sent to nobody: a bare "must"
#ASSERT `o 55 r 5(b) the Registrar has sent the certificate with the documents annexed as the Registrar must` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE -- the document came from another person under a Convention: sent to that person
#ASSERT `o 55 r 5(b) the Registrar has sent the certificate with the documents annexed as the Registrar must` TRUE FALSE TRUE TRUE FALSE EQUALS NOTHING -- under a Convention, sent to the Permanent Secretary and not to that other person
#ASSERT `o 55 r 5(b) the Registrar has sent the certificate with the documents annexed as the Registrar must` TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING -- the order otherwise directs: the duty does not arise
#ASSERT `o 55 r 5(b) the Registrar has sent the certificate with the documents annexed as the Registrar must` FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING -- not an order under this Order
