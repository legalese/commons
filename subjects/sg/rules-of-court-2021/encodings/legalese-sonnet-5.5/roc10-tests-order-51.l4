IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc10-order-51`

-- Rules of Court 2021 (Singapore), Order 51 (Moneylenders' actions): TESTS.
-- Every expected value is written beside its assertion from the text of the rule it cites (lines 6441 to 6479 of the text),
-- never copied from the output of the code.  Last days are worked out by hand under O 3 r 3.

#ASSERT `o 51 r 1(1) these Rules apply to the action subject to the following Rules` TRUE EQUALS JUST TRUE -- a moneylender's action
#ASSERT `o 51 r 1(1) these Rules apply to the action subject to the following Rules` FALSE EQUALS NOTHING -- some other action
#ASSERT `o 51 r 1(2) a person is a moneylender` (JUST TRUE) EQUALS JUST TRUE -- the Act's meaning is supplied: yes
#ASSERT `o 51 r 1(2) a person is a moneylender` (JUST FALSE) EQUALS JUST FALSE -- the Act's meaning is supplied: no
#ASSERT `o 51 r 1(2) a person is a moneylender` NOTHING EQUALS NOTHING -- section 2 of the Moneylenders Act is not among the sources
#ASSERT `o 51 r 1(2) an action is a moneylender's action` TRUE TRUE EQUALS JUST TRUE -- recovery of money lent, brought by the lender or an assignee
#ASSERT `o 51 r 1(2) an action is a moneylender's action` TRUE FALSE EQUALS JUST FALSE -- brought by someone else
#ASSERT `o 51 r 1(2) an action is a moneylender's action` FALSE TRUE EQUALS JUST FALSE -- not an action for recovery or enforcement of money lent by a moneylender
#ASSERT `o 51 r 2 the duty to endorse the originating claim arises` TRUE EQUALS JUST TRUE -- an originating claim beginning a moneylender's action
#ASSERT `o 51 r 2 the duty to endorse the originating claim arises` FALSE EQUALS NOTHING -- some other originating claim
#ASSERT `o 51 r 2 the originating claim has been endorsed as it must be` TRUE TRUE EQUALS JUST TRUE -- endorsed before issue
#ASSERT `o 51 r 2 the originating claim has been endorsed as it must be` TRUE FALSE EQUALS NOTHING -- not endorsed: a bare "must"
#ASSERT `o 51 r 2 the originating claim has been endorsed as it must be` FALSE FALSE EQUALS NOTHING -- the duty does not arise
#ASSERT `o 51 r 3 the statement of claim states what it must` TRUE (`o 51 r 3 what the statement of claim states` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE -- all eleven matters stated
#ASSERT `o 51 r 3 the statement of claim states what it must` TRUE (`o 51 r 3 what the statement of claim states` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- matter (a) not stated
#ASSERT `o 51 r 3 the statement of claim states what it must` TRUE (`o 51 r 3 what the statement of claim states` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- matter (b) not stated
#ASSERT `o 51 r 3 the statement of claim states what it must` TRUE (`o 51 r 3 what the statement of claim states` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- matter (c) not stated
#ASSERT `o 51 r 3 the statement of claim states what it must` TRUE (`o 51 r 3 what the statement of claim states` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- matter (d) not stated
#ASSERT `o 51 r 3 the statement of claim states what it must` TRUE (`o 51 r 3 what the statement of claim states` OF TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- matter (e) not stated
#ASSERT `o 51 r 3 the statement of claim states what it must` TRUE (`o 51 r 3 what the statement of claim states` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- matter (f) not stated
#ASSERT `o 51 r 3 the statement of claim states what it must` TRUE (`o 51 r 3 what the statement of claim states` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- matter (g) not stated
#ASSERT `o 51 r 3 the statement of claim states what it must` TRUE (`o 51 r 3 what the statement of claim states` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS NOTHING -- matter (h) not stated
#ASSERT `o 51 r 3 the statement of claim states what it must` TRUE (`o 51 r 3 what the statement of claim states` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS NOTHING -- matter (i) not stated
#ASSERT `o 51 r 3 the statement of claim states what it must` TRUE (`o 51 r 3 what the statement of claim states` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS NOTHING -- matter (j) not stated
#ASSERT `o 51 r 3 the statement of claim states what it must` TRUE (`o 51 r 3 what the statement of claim states` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING -- matter (k) not stated
#ASSERT `o 51 r 3 the statement of claim states what it must` FALSE (`o 51 r 3 what the statement of claim states` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- not a statement of claim in a moneylender's action
#ASSERT `o 51 r 4(1) entry of the judgment in default is barred` TRUE TRUE FALSE EQUALS JUST TRUE -- judgment in default, no permission
#ASSERT `o 51 r 4(1) entry of the judgment in default is barred` TRUE TRUE TRUE EQUALS JUST FALSE -- "except with the permission of the Court"
#ASSERT `o 51 r 4(1) entry of the judgment in default is barred` FALSE TRUE FALSE EQUALS NOTHING -- not a moneylender's action
#ASSERT `o 51 r 4(1) entry of the judgment in default is barred` TRUE FALSE FALSE EQUALS NOTHING -- not a judgment in default of notice or defence
#ASSERT `o 51 r 4(1) the judgment in default may be entered` TRUE TRUE FALSE EQUALS JUST FALSE -- "must not be entered except with the permission"
#ASSERT `o 51 r 4(1) the judgment in default may be entered` TRUE TRUE TRUE EQUALS NOTHING -- permission lifts the bar and grants nothing (QA)
#ASSERT `o 51 r 4(1) the judgment in default may be entered` FALSE TRUE FALSE EQUALS NOTHING -- the bar does not reach this judgment
#ASSERT `o 51 r 4(2) the application for permission is made by summons as it must be` TRUE `Summons` EQUALS JUST TRUE -- made by summons
#ASSERT `o 51 r 4(2) the application for permission is made by summons as it must be` TRUE `Originating application` EQUALS NOTHING -- not by summons: a bare "must"
#ASSERT `o 51 r 4(2) the application for permission is made by summons as it must be` FALSE `Summons` EQUALS NOTHING -- not an application for permission under this Rule
#ASSERT `o 51 r 4(2) the duty to serve the summons on the defendant arises` TRUE FALSE EQUALS JUST TRUE -- no contrary order
#ASSERT `o 51 r 4(2) the duty to serve the summons on the defendant arises` TRUE TRUE EQUALS JUST FALSE -- "unless the Court otherwise orders"
#ASSERT `o 51 r 4(2) the duty to serve the summons on the defendant arises` FALSE FALSE EQUALS NOTHING -- not a summons on such an application
#ASSERT `o 51 r 4(2) the summons has been served on the defendant as it must be` TRUE FALSE TRUE EQUALS JUST TRUE -- served
#ASSERT `o 51 r 4(2) the summons has been served on the defendant as it must be` TRUE FALSE FALSE EQUALS NOTHING -- not served: a bare "must"
#ASSERT `o 51 r 4(2) the summons has been served on the defendant as it must be` TRUE TRUE FALSE EQUALS NOTHING -- the Court ordered otherwise: nothing to comply with
-- (3): the time for the notice of intention to contest or not contest ends on 15 June 2026 (Monday); the last day is the seam input
#ASSERT `o 51 r 4(3) issue of the summons is barred` TRUE (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- issued on the last day: the time has not passed
#ASSERT `o 51 r 4(3) issue of the summons is barred` TRUE (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- issued after the time: "until after" lifts the bar
#ASSERT `o 51 r 4(3) issue of the summons is barred` FALSE (Date 10 6 2026) (Date 15 6 2026) EQUALS NOTHING -- not an application in default of notice of intention
#ASSERT `o 51 r 4(3) the summons may be issued` TRUE (Date 10 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- "must not be issued until after the time limited"
#ASSERT `o 51 r 4(3) the summons may be issued` TRUE (Date 16 6 2026) (Date 15 6 2026) EQUALS NOTHING -- the time has passed: the bar is lifted and grants nothing (QA)
#ASSERT `o 51 r 4(4) the defendant's appearance at the hearing affects the Court's powers` EQUALS JUST FALSE -- "whether the defendant appears or not"
#ASSERT `o 51 r 4(4)(a) the Court may exercise the powers of the Court under section 23 of the Moneylenders Act` TRUE EQUALS JUST TRUE -- on the hearing
#ASSERT `o 51 r 4(4)(a) the Court may exercise the powers of the Court under section 23 of the Moneylenders Act` FALSE EQUALS JUST FALSE -- not on the hearing: the "on" fails
#ASSERT `o 51 r 4(4)(b) the Court may make or give any order or directions it might have made on an application under Order 9, Rule 17(1)` TRUE TRUE EQUALS JUST TRUE -- on the hearing, permission refused
#ASSERT `o 51 r 4(4)(b) the Court may make or give any order or directions it might have made on an application under Order 9, Rule 17(1)` TRUE FALSE EQUALS JUST FALSE -- permission not refused: the "where" fails
#ASSERT `o 51 r 4(4)(b) the Court may make or give any order or directions it might have made on an application under Order 9, Rule 17(1)` FALSE TRUE EQUALS JUST FALSE -- not on the hearing
#ASSERT `o 51 r 5 the duty to put the matters in Rules 2 and 3 in the supporting affidavit arises` TRUE EQUALS JUST TRUE -- begun by originating application
#ASSERT `o 51 r 5 the duty to put the matters in Rules 2 and 3 in the supporting affidavit arises` FALSE EQUALS JUST FALSE -- not begun by originating application: the "where" fails
#ASSERT `o 51 r 5 the supporting affidavit contains the statement as it must` TRUE TRUE EQUALS JUST TRUE -- contains the statement
#ASSERT `o 51 r 5 the supporting affidavit contains the statement as it must` TRUE FALSE EQUALS NOTHING -- does not: a bare "must"
#ASSERT `o 51 r 5 the supporting affidavit contains the statement as it must` FALSE FALSE EQUALS NOTHING -- the duty does not arise
