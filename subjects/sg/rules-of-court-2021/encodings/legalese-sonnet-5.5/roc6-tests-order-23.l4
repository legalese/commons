IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc6-order-23`

-- Tests for roc6-order-23.l4 (Order 23, Contempt of court).
-- Every expected value is written from the text of Order 23 (lines 3556 to 3741 of the source), beside the
-- assertion, before the code was run.  The last days are made up: Order 3, Rule 3 (roc1's range) counts them.

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 1 definitions`
-- ---------------------------------------------------------------------------

#ASSERT `o 23 r 1 "Act" is the Administration of Justice (Protection) Act 2016` TRUE EQUALS JUST TRUE -- "Act" means that Act
#ASSERT `o 23 r 1 "Act" is the Administration of Justice (Protection) Act 2016` FALSE EQUALS JUST FALSE -- "means": any other enactment is not the Act

#ASSERT `o 23 r 1 "committal applicant" is the person applying for or having obtained a committal order` TRUE FALSE EQUALS JUST TRUE -- is applying for
#ASSERT `o 23 r 1 "committal applicant" is the person applying for or having obtained a committal order` FALSE TRUE EQUALS JUST TRUE -- has obtained
#ASSERT `o 23 r 1 "committal applicant" is the person applying for or having obtained a committal order` FALSE FALSE EQUALS JUST FALSE -- "means": neither

#ASSERT `o 23 r 1 "committal respondent" is the person against whom a committal order is sought or made` TRUE FALSE EQUALS JUST TRUE -- sought
#ASSERT `o 23 r 1 "committal respondent" is the person against whom a committal order is sought or made` FALSE TRUE EQUALS JUST TRUE -- made
#ASSERT `o 23 r 1 "committal respondent" is the person against whom a committal order is sought or made` FALSE FALSE EQUALS JUST FALSE -- "means": neither

#ASSERT `o 23 r 1 "contempt of court" is contempt under the Act, and includes contempt under the common law` `o 23 r 1 "contempt of court" contempt under the Act` NOTHING EQUALS JUST TRUE -- the first limb needs no help from section 8
#ASSERT `o 23 r 1 "contempt of court" is contempt under the Act, and includes contempt under the common law` `o 23 r 1 "contempt of court" contempt under the common law` (JUST TRUE) EQUALS JUST TRUE -- "includes, subject to section 8": section 8 allows it
#ASSERT `o 23 r 1 "contempt of court" is contempt under the Act, and includes contempt under the common law` `o 23 r 1 "contempt of court" contempt under the common law` (JUST FALSE) EQUALS NOTHING -- "subject to section 8": section 8 cuts it back, and the Rule does not say it then is not contempt
#ASSERT `o 23 r 1 "contempt of court" is contempt under the Act, and includes contempt under the common law` `o 23 r 1 "contempt of court" contempt under the common law` NOTHING EQUALS NOTHING -- section 8 is outside the sources
#ASSERT `o 23 r 1 "contempt of court" is contempt under the Act, and includes contempt under the common law` `o 23 r 1 "contempt of court" any other contempt` (JUST TRUE) EQUALS NOTHING -- "includes": the list is not closed

#ASSERT `o 23 r 1 "non-publication direction" is a direction under section 13` TRUE EQUALS JUST TRUE -- means a direction under section 13
#ASSERT `o 23 r 1 "non-publication direction" is a direction under section 13` FALSE EQUALS JUST FALSE -- "means"
#ASSERT `o 23 r 1 "section" is a section of the Act` TRUE EQUALS JUST TRUE -- means a section of the Act
#ASSERT `o 23 r 1 "section" is a section of the Act` FALSE EQUALS JUST FALSE -- "means"

-- ---------------------------------------------------------------------------
§ `Tests -- Rules 2 and 3`
-- ---------------------------------------------------------------------------

#ASSERT `o 23 r 2 the power to punish for contempt of court may be exercised by a committal order` TRUE EQUALS JUST TRUE -- may be exercised by a committal order
#ASSERT `o 23 r 2 the power to punish for contempt of court may be exercised by a committal order` FALSE EQUALS NOTHING -- the Rule does not say it is the only way

#ASSERT `o 23 r 3(1) the committal applicant has first applied to the Court for permission` TRUE TRUE EQUALS JUST TRUE -- applied first
#ASSERT `o 23 r 3(1) the committal applicant has first applied to the Court for permission` TRUE FALSE EQUALS NOTHING -- "must first apply": silent on what follows
#ASSERT `o 23 r 3(1) the committal applicant has first applied to the Court for permission` FALSE TRUE EQUALS NOTHING -- the duty is a committal applicant's

#ASSERT `o 23 r 3(2) the application for permission is made in the way required` `o 23 r 3(2) by originating application without notice` FALSE TRUE EQUALS JUST TRUE -- no action: originating application without notice, to a Judge
#ASSERT `o 23 r 3(2) the application for permission is made in the way required` `o 23 r 3(2) by originating application without notice` TRUE TRUE EQUALS NOTHING -- an action is begun: the Rule asks for a summons
#ASSERT `o 23 r 3(2) the application for permission is made in the way required` `o 23 r 3(2) by summons without notice in an action` TRUE TRUE EQUALS JUST TRUE -- in an action: summons without notice, to a Judge
#ASSERT `o 23 r 3(2) the application for permission is made in the way required` `o 23 r 3(2) by summons without notice in an action` FALSE TRUE EQUALS NOTHING -- no action: a summons has nothing to be in
#ASSERT `o 23 r 3(2) the application for permission is made in the way required` `o 23 r 3(2) in some other way` FALSE TRUE EQUALS NOTHING -- another way
#ASSERT `o 23 r 3(2) the application for permission is made in the way required` `o 23 r 3(2) by originating application without notice` FALSE FALSE EQUALS NOTHING -- not to a Judge

#ASSERT `o 23 r 3(3) the affidavit supporting the application sets out what is required` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- all of (a), (b) and (c)
#ASSERT `o 23 r 3(3) the affidavit supporting the application sets out what is required` FALSE TRUE TRUE TRUE EQUALS NOTHING -- no affidavit
#ASSERT `o 23 r 3(3) the affidavit supporting the application sets out what is required` TRUE FALSE TRUE TRUE EQUALS NOTHING -- (a) missing
#ASSERT `o 23 r 3(3) the affidavit supporting the application sets out what is required` TRUE TRUE FALSE TRUE EQUALS NOTHING -- (b) missing
#ASSERT `o 23 r 3(3) the affidavit supporting the application sets out what is required` TRUE TRUE TRUE FALSE EQUALS NOTHING -- (c) missing

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 4`
-- ---------------------------------------------------------------------------

#ASSERT `o 23 r 4(1) the period for applying for the committal order`'s `period length` EQUALS 14 -- "within 14 days"
#ASSERT `o 23 r 4(1) the period for applying for the committal order`'s `period unit` EQUALS Days -- days
#ASSERT `o 23 r 4(1) the period for applying for the committal order`'s `period direction` EQUALS `After the anchor` -- after permission is granted
#ASSERT `o 23 r 4(1) the application for the committal order is made within 14 days after permission` TRUE (Date 10 1 2026) (Date 14 1 2026) EQUALS JUST TRUE -- inside the period
#ASSERT `o 23 r 4(1) the application for the committal order is made within 14 days after permission` TRUE (Date 14 1 2026) (Date 14 1 2026) EQUALS JUST TRUE -- the last day counts
#ASSERT `o 23 r 4(1) the application for the committal order is made within 14 days after permission` TRUE (Date 15 1 2026) (Date 14 1 2026) EQUALS JUST FALSE -- one day late (ruling (a))
#ASSERT `o 23 r 4(1) the application for the committal order is made within 14 days after permission` FALSE (Date 10 1 2026) (Date 14 1 2026) EQUALS JUST FALSE -- no permission yet: "After permission is granted" has not happened (assumed, F-ASSUMED)

#ASSERT `o 23 r 4(1) the application for the committal order is made in the way required` `o 23 r 4(1) by summons in the originating application without notice` FALSE EQUALS JUST TRUE -- no action
#ASSERT `o 23 r 4(1) the application for the committal order is made in the way required` `o 23 r 4(1) by summons in the originating application without notice` TRUE EQUALS NOTHING -- an action is begun
#ASSERT `o 23 r 4(1) the application for the committal order is made in the way required` `o 23 r 4(1) by summons in the action` TRUE EQUALS JUST TRUE -- in the action
#ASSERT `o 23 r 4(1) the application for the committal order is made in the way required` `o 23 r 4(1) by summons in the action` FALSE EQUALS NOTHING -- no action
#ASSERT `o 23 r 4(1) the application for the committal order is made in the way required` `o 23 r 4(1) in some other way` TRUE EQUALS NOTHING -- another way

#ASSERT `o 23 r 4(1) the four documents have been served on the committal respondent by personal service` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- personal service of (a) to (d)
#ASSERT `o 23 r 4(1) the four documents have been served on the committal respondent by personal service` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- not personal service
#ASSERT `o 23 r 4(1) the four documents have been served on the committal respondent by personal service` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING -- (a) not served
#ASSERT `o 23 r 4(1) the four documents have been served on the committal respondent by personal service` TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING -- (b) not served
#ASSERT `o 23 r 4(1) the four documents have been served on the committal respondent by personal service` TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING -- (c) not served
#ASSERT `o 23 r 4(1) the four documents have been served on the committal respondent by personal service` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- (d) not served

#ASSERT `o 23 r 4(2) the minimum gap between service and the hearing`'s `period length` EQUALS 21 -- "at least 21 days"
#ASSERT `o 23 r 4(2) the minimum gap between service and the hearing`'s `period direction` EQUALS `Before the anchor` -- before the hearing date
#ASSERT `o 23 r 4(2) there are at least 21 days between the service and the hearing date` (Date 1 2 2026) (Date 5 2 2026) EQUALS JUST TRUE -- served before the last day for service
#ASSERT `o 23 r 4(2) there are at least 21 days between the service and the hearing date` (Date 5 2 2026) (Date 5 2 2026) EQUALS JUST TRUE -- served on the last day
#ASSERT `o 23 r 4(2) there are at least 21 days between the service and the hearing date` (Date 6 2 2026) (Date 5 2 2026) EQUALS JUST FALSE -- served too close to the hearing (ruling (a))

-- ---------------------------------------------------------------------------
§ `Tests -- Rules 5 and 6`
-- ---------------------------------------------------------------------------

#ASSERT `o 23 r 5(1) a committal order may be made by the General Division` TRUE TRUE EQUALS JUST TRUE -- both parts of the "Where"
#ASSERT `o 23 r 5(1) a committal order may be made by the General Division` TRUE FALSE EQUALS JUST FALSE -- the thing would not have been a contempt of the General Division
#ASSERT `o 23 r 5(1) a committal order may be made by the General Division` FALSE TRUE EQUALS JUST FALSE -- no power by written law
#ASSERT `o 23 r 5(1) a committal order may be made by the General Division` FALSE FALSE EQUALS JUST FALSE -- neither

#ASSERT `o 23 r 5(2) Rules 2, 3 and 4 affect the power to make a committal order on its own accord` `General Division` EQUALS JUST FALSE -- "Nothing in Rules 2, 3 and 4 is taken as affecting"
#ASSERT `o 23 r 5(2) Rules 2, 3 and 4 affect the power to make a committal order on its own accord` `Appellate Division` EQUALS JUST FALSE -- named
#ASSERT `o 23 r 5(2) Rules 2, 3 and 4 affect the power to make a committal order on its own accord` `Court of Appeal` EQUALS JUST FALSE -- named
#ASSERT `o 23 r 5(2) Rules 2, 3 and 4 affect the power to make a committal order on its own accord` `District Court` EQUALS NOTHING -- not named
#ASSERT `o 23 r 5(2) Rules 2, 3 and 4 affect the power to make a committal order on its own accord` `Magistrate's Court` EQUALS NOTHING -- not named
#ASSERT `o 23 r 5(2) Rules 2, 3 and 4 affect the power to make a committal order on its own accord` `Singapore International Commercial Court` EQUALS NOTHING -- not named
#ASSERT `o 23 r 5(2) Rules 2, 3 and 4 affect the power to make a committal order on its own accord` `Family Division` EQUALS NOTHING -- not named

#ASSERT `o 23 r 6(1) the application to transfer a case is made in the way required` TRUE TRUE TRUE EQUALS JUST TRUE -- to a Judge in the General Division, by originating application
#ASSERT `o 23 r 6(1) the application to transfer a case is made in the way required` FALSE TRUE TRUE EQUALS NOTHING -- not an application under section 10(4)
#ASSERT `o 23 r 6(1) the application to transfer a case is made in the way required` TRUE FALSE TRUE EQUALS NOTHING -- not to a Judge sitting in the General Division
#ASSERT `o 23 r 6(1) the application to transfer a case is made in the way required` TRUE TRUE FALSE EQUALS NOTHING -- not by originating application

#ASSERT `o 23 r 6(2) the General Division may order the case and related proceedings stayed` TRUE TRUE EQUALS JUST TRUE -- hearing the application and the stay is the one named
#ASSERT `o 23 r 6(2) the General Division may order the case and related proceedings stayed` TRUE FALSE EQUALS NOTHING -- another order
#ASSERT `o 23 r 6(2) the General Division may order the case and related proceedings stayed` FALSE TRUE EQUALS NOTHING -- not hearing an application under paragraph (1)

#ASSERT `o 23 r 6(3)(a) the General Division may do this on ordering the transfer` TRUE `o 23 r 6(3)(a)(i) set aside or affirm an order made by the State Court` EQUALS JUST TRUE -- (i)
#ASSERT `o 23 r 6(3)(a) the General Division may do this on ordering the transfer` TRUE `o 23 r 6(3)(a)(ii) modify Rules 3 and 4 in their application to the case` EQUALS JUST TRUE -- (ii)
#ASSERT `o 23 r 6(3)(a) the General Division may do this on ordering the transfer` TRUE `o 23 r 6(3)(a)(iii) make any other order relating to the transfer` EQUALS JUST TRUE -- (iii)
#ASSERT `o 23 r 6(3)(a) the General Division may do this on ordering the transfer` TRUE `o 23 r 6(3)(a) something else` EQUALS NOTHING -- not one of the three
#ASSERT `o 23 r 6(3)(a) the General Division may do this on ordering the transfer` FALSE `o 23 r 6(3)(a)(i) set aside or affirm an order made by the State Court` EQUALS JUST FALSE -- "Where the General Division orders ... to be transferred": no transfer ordered

#ASSERT `o 23 r 6(3)(b) the Registrar of the State Courts has sent what must be sent to the Registrar of the Supreme Court` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- file, documents, exhibits and the certified copy of the notes
#ASSERT `o 23 r 6(3)(b) the Registrar of the State Courts has sent what must be sent to the Registrar of the Supreme Court` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- no notes of evidence exist ("if any")
#ASSERT `o 23 r 6(3)(b) the Registrar of the State Courts has sent what must be sent to the Registrar of the Supreme Court` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- notes exist and the certified copy was not sent
#ASSERT `o 23 r 6(3)(b) the Registrar of the State Courts has sent what must be sent to the Registrar of the Supreme Court` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING -- the file was not sent
#ASSERT `o 23 r 6(3)(b) the Registrar of the State Courts has sent what must be sent to the Registrar of the Supreme Court` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING -- documents and exhibits not sent
#ASSERT `o 23 r 6(3)(b) the Registrar of the State Courts has sent what must be sent to the Registrar of the Supreme Court` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- no transfer ordered ("Where")

#ASSERT `o 23 r 6(3)(c) every party to the case has been given notice of the transfer` TRUE TRUE EQUALS JUST TRUE -- notice given
#ASSERT `o 23 r 6(3)(c) every party to the case has been given notice of the transfer` TRUE FALSE EQUALS NOTHING -- silent on what follows
#ASSERT `o 23 r 6(3)(c) every party to the case has been given notice of the transfer` FALSE TRUE EQUALS JUST FALSE -- no transfer ordered ("Where")

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 7`
-- ---------------------------------------------------------------------------

-- arguments of the private-hearing function: kind of application; (a) infant; (b) lacks capacity; (c) General Division and tribunal; (d) secret process; (e) it appears to the Court
#ASSERT `o 23 r 7(1) the Court may hear the application in private` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- case (a)
#ASSERT `o 23 r 7(1) the Court may hear the application in private` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- case (b)
#ASSERT `o 23 r 7(1) the Court may hear the application in private` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE -- case (c)
#ASSERT `o 23 r 7(1) the Court may hear the application in private` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- case (d)
#ASSERT `o 23 r 7(1) the Court may hear the application in private` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE -- case (e)
#ASSERT `o 23 r 7(1) the Court may hear the application in private` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- none of the five cases: each begins "where" (ruling (b)); fork F-O23-2
#ASSERT `o 23 r 7(1) the Court may hear the application in private` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING -- not one of the two applications
#ASSERT `o 23 r 7(1) the Court must hear the application in open court` TRUE FALSE EQUALS JUST TRUE -- none of cases (a) to (e): "must hear in open court"
#ASSERT `o 23 r 7(1) the Court must hear the application in open court` TRUE TRUE EQUALS JUST FALSE -- a case applies: the Court "may" hear it in private, so it is not bound to sit in open court
#ASSERT `o 23 r 7(1) the Court must hear the application in open court` FALSE FALSE EQUALS NOTHING -- not one of the two applications
#ASSERT `o 23 r 7(1) the Court must hear the application in open court` FALSE TRUE EQUALS NOTHING -- not one of the two applications, whatever the cases
-- The two functions agree row for row (F-O23-2): outside cases (a) to (e) private is JUST FALSE and open court JUST TRUE; inside, private is JUST TRUE and open court JUST FALSE.
-- The two functions of Rule 7(1) agree on every row (F-O23-2): outside cases (a) to (e) private is JUST FALSE and open court JUST TRUE; inside, private is JUST TRUE and open court JUST FALSE.

#ASSERT `o 23 r 7(2) the Court must state in open court what the paragraph lists` TRUE TRUE EQUALS JUST TRUE -- heard in private and deciding to commit
#ASSERT `o 23 r 7(2) the Court must state in open court what the paragraph lists` TRUE FALSE EQUALS JUST FALSE -- "If ... and decides to make a committal order": not deciding to commit
#ASSERT `o 23 r 7(2) the Court must state in open court what the paragraph lists` FALSE TRUE EQUALS JUST FALSE -- heard in open court
#ASSERT `o 23 r 7(2) the Court has stated in open court what the paragraph lists` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- name and nature, no fixed period
#ASSERT `o 23 r 7(2) the Court has stated in open court what the paragraph lists` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- fixed period and its length stated
#ASSERT `o 23 r 7(2) the Court has stated in open court what the paragraph lists` TRUE TRUE TRUE FALSE EQUALS NOTHING -- fixed period and its length not stated
#ASSERT `o 23 r 7(2) the Court has stated in open court what the paragraph lists` FALSE TRUE FALSE FALSE EQUALS NOTHING -- name not stated
#ASSERT `o 23 r 7(2) the Court has stated in open court what the paragraph lists` TRUE FALSE FALSE FALSE EQUALS NOTHING -- nature not stated

#ASSERT `o 23 r 7(3) the committal applicant may rely on the ground` TRUE EQUALS JUST TRUE -- a ground in the affidavit
#ASSERT `o 23 r 7(3) the committal applicant may rely on the ground` FALSE EQUALS JUST FALSE -- "only the grounds set out in the affidavit"
#ASSERT `o 23 r 7(4)(a) the committal respondent must rely on the matters stated in the affidavit` TRUE EQUALS JUST TRUE -- an affidavit
#ASSERT `o 23 r 7(4)(a) the committal respondent must rely on the matters stated in the affidavit` FALSE EQUALS JUST FALSE -- "if any": no affidavit, nothing to rely on under (a)
#ASSERT `o 23 r 7(4)(b) the committal respondent may give oral evidence` TRUE TRUE EQUALS JUST TRUE -- with permission, on own behalf
#ASSERT `o 23 r 7(4)(b) the committal respondent may give oral evidence` FALSE TRUE EQUALS NOTHING -- without permission
#ASSERT `o 23 r 7(4)(b) the committal respondent may give oral evidence` TRUE FALSE EQUALS NOTHING -- not on own behalf

#ASSERT `o 23 r 7(5) the Court is to have regard to the matter` TRUE `o 23 r 7(5)(a)(i) the ability of the committal respondent to effectively conduct the defence` EQUALS JUST TRUE -- (a)(i)
#ASSERT `o 23 r 7(5) the Court is to have regard to the matter` TRUE `o 23 r 7(5)(a)(ii) the ability of an advocate representing the committal respondent to effectively conduct the defence` EQUALS JUST TRUE -- (a)(ii)
#ASSERT `o 23 r 7(5) the Court is to have regard to the matter` TRUE `o 23 r 7(5)(b) the ability of the committal applicant to effectively conduct the proceedings` EQUALS JUST TRUE -- (b)
#ASSERT `o 23 r 7(5) the Court is to have regard to the matter` TRUE `o 23 r 7(5)(c) the ability of the committal respondent to consult and instruct an advocate in private` EQUALS JUST TRUE -- (c)
#ASSERT `o 23 r 7(5) the Court is to have regard to the matter` TRUE `o 23 r 7(5)(d)(i) technical measures to verify the identities of persons giving evidence or appearing` EQUALS JUST TRUE -- (d)(i)
#ASSERT `o 23 r 7(5) the Court is to have regard to the matter` TRUE `o 23 r 7(5)(d)(ii) technical measures to prevent the committal respondent being coached or coerced` EQUALS JUST TRUE -- (d)(ii)
#ASSERT `o 23 r 7(5) the Court is to have regard to the matter` TRUE `o 23 r 7(5)(d)(iii) technical measures to prevent the proceedings being recorded` EQUALS JUST TRUE -- (d)(iii)
#ASSERT `o 23 r 7(5) the Court is to have regard to the matter` TRUE `o 23 r 7(5)(d)(iv) technical measures to control and restrict who can access or observe the proceedings` EQUALS JUST TRUE -- (d)(iv)
#ASSERT `o 23 r 7(5) the Court is to have regard to the matter` TRUE `o 23 r 7(5)(e) the likelihood that the Court may require the committal respondent to handle physical evidence` EQUALS JUST TRUE -- (e)
#ASSERT `o 23 r 7(5) the Court is to have regard to the matter` TRUE `o 23 r 7(5)(f) whether a judgment or order requiring the committal respondent to be taken into custody may be delivered or made during the proceedings` EQUALS JUST TRUE -- (f)
#ASSERT `o 23 r 7(5) the Court is to have regard to the matter` TRUE `o 23 r 7(5) some other matter` EQUALS NOTHING -- the list does not say "only"
#ASSERT `o 23 r 7(5) the Court is to have regard to the matter` FALSE `o 23 r 7(5)(b) the ability of the committal applicant to effectively conduct the proceedings` EQUALS NOTHING -- not an order under section 26A(1)

#ASSERT `o 23 r 7(6) the Court is to have regard to the matter` TRUE FALSE `o 23 r 7(6)(a)(i) the ability of the committal respondent to effectively conduct the defence` EQUALS JUST TRUE -- (a)(i)
#ASSERT `o 23 r 7(6) the Court is to have regard to the matter` TRUE FALSE `o 23 r 7(6)(a)(ii) the ability of an advocate representing the committal respondent to effectively conduct the defence` EQUALS JUST TRUE -- (a)(ii)
#ASSERT `o 23 r 7(6) the Court is to have regard to the matter` TRUE FALSE `o 23 r 7(6)(b) the ability of the committal applicant to effectively conduct the proceedings` EQUALS JUST TRUE -- (b)
#ASSERT `o 23 r 7(6) the Court is to have regard to the matter` TRUE FALSE `o 23 r 7(6)(c)(i) technical measures to verify the identities of persons giving evidence` EQUALS JUST TRUE -- (c)(i)
#ASSERT `o 23 r 7(6) the Court is to have regard to the matter` TRUE FALSE `o 23 r 7(6)(c)(ii) technical measures to prevent the witness being coached or coerced` EQUALS JUST TRUE -- (c)(ii)
#ASSERT `o 23 r 7(6) the Court is to have regard to the matter` TRUE FALSE `o 23 r 7(6)(c)(iii) technical measures to prevent the proceedings being recorded` EQUALS JUST TRUE -- (c)(iii)
#ASSERT `o 23 r 7(6) the Court is to have regard to the matter` TRUE FALSE `o 23 r 7(6)(c)(iv) technical measures to control and restrict who can access or observe the proceedings` EQUALS JUST TRUE -- (c)(iv)
#ASSERT `o 23 r 7(6) the Court is to have regard to the matter` TRUE FALSE `o 23 r 7(6)(d) the likelihood that the Court may require the witness to handle physical evidence` EQUALS JUST TRUE -- (d)
#ASSERT `o 23 r 7(6) the Court is to have regard to the matter` TRUE TRUE `o 23 r 7(6)(e) the reason why an expert witness is not giving evidence from Singapore` EQUALS JUST TRUE -- (e): an expert witness from outside Singapore under section 26A(3)
#ASSERT `o 23 r 7(6) the Court is to have regard to the matter` TRUE FALSE `o 23 r 7(6)(e) the reason why an expert witness is not giving evidence from Singapore` EQUALS NOTHING -- (e) is for that case only
#ASSERT `o 23 r 7(6) the Court is to have regard to the matter` TRUE FALSE `o 23 r 7(6) some other matter` EQUALS NOTHING -- the list does not say "only"
#ASSERT `o 23 r 7(6) the Court is to have regard to the matter` FALSE FALSE `o 23 r 7(6)(b) the ability of the committal applicant to effectively conduct the proceedings` EQUALS NOTHING -- not an order under section 26A(2) or (3)

-- ---------------------------------------------------------------------------
§ `Tests -- Rules 8, 9 and 10`
-- ---------------------------------------------------------------------------

#ASSERT `o 23 r 8(1) the Court may order the execution of the committal order to be suspended` TRUE EQUALS JUST TRUE -- a committal order has been made
#ASSERT `o 23 r 8(1) the Court may order the execution of the committal order to be suspended` FALSE EQUALS NOTHING -- nothing to suspend
#ASSERT `o 23 r 8(2) the committal applicant must serve a notice of the terms of the order` TRUE EQUALS JUST TRUE -- "Where the Court makes an order under paragraph (1)"
#ASSERT `o 23 r 8(2) the committal applicant must serve a notice of the terms of the order` FALSE EQUALS JUST FALSE -- no order under paragraph (1)
#ASSERT `o 23 r 8(2) the committal applicant has served the notice required` TRUE TRUE EQUALS JUST TRUE -- served, informing of the terms
#ASSERT `o 23 r 8(2) the committal applicant has served the notice required` TRUE FALSE EQUALS NOTHING -- the notice does not inform of the terms
#ASSERT `o 23 r 8(2) the committal applicant has served the notice required` FALSE TRUE EQUALS NOTHING -- not served
#ASSERT `o 23 r 8(3) the committal applicant may apply for the suspension to be lifted` TRUE EQUALS JUST TRUE -- a term breached
#ASSERT `o 23 r 8(3) the committal applicant may apply for the suspension to be lifted` FALSE EQUALS NOTHING -- "on the ground that"
#ASSERT `o 23 r 8(4) the application to lift the suspension is made and served as required` TRUE TRUE TRUE EQUALS JUST TRUE -- summons, affidavit, served
#ASSERT `o 23 r 8(4) the application to lift the suspension is made and served as required` FALSE TRUE TRUE EQUALS NOTHING -- not by summons
#ASSERT `o 23 r 8(4) the application to lift the suspension is made and served as required` TRUE FALSE TRUE EQUALS NOTHING -- no affidavit
#ASSERT `o 23 r 8(4) the application to lift the suspension is made and served as required` TRUE TRUE FALSE EQUALS NOTHING -- not served

#ASSERT `o 23 r 9(1) the Court may discharge the committal respondent` TRUE TRUE EQUALS JUST TRUE -- committed, and applies
#ASSERT `o 23 r 9(1) the Court may discharge the committal respondent` TRUE FALSE EQUALS JUST FALSE -- "upon his or her application": none made (ruling (b), "upon")
#ASSERT `o 23 r 9(1) the Court may discharge the committal respondent` FALSE TRUE EQUALS JUST FALSE -- "Where ... committed": not committed
#ASSERT `o 23 r 9(2) the Sheriff may take possession of the thing` TRUE TRUE EQUALS JUST TRUE -- committed under section 4, thing in possession or control
#ASSERT `o 23 r 9(2) the Sheriff may take possession of the thing` TRUE FALSE EQUALS JUST FALSE -- "if the thing is in the possession or control": it is not
#ASSERT `o 23 r 9(2) the Sheriff may take possession of the thing` FALSE TRUE EQUALS JUST FALSE -- not committed under section 4
#ASSERT `o 23 r 9(2) the Court may discharge the committal respondent and give directions for dealing with the thing` TRUE TRUE EQUALS JUST TRUE -- same conditions
#ASSERT `o 23 r 9(2) the Court may discharge the committal respondent and give directions for dealing with the thing` TRUE FALSE EQUALS JUST FALSE -- thing not in possession or control
#ASSERT `o 23 r 9(2) the Court may discharge the committal respondent and give directions for dealing with the thing` FALSE FALSE EQUALS JUST FALSE -- neither

#ASSERT `o 23 r 10 Rules 1 to 9 affect the Court's power to make the order` `o 23 r 10 an order requiring a person punishable by virtue of a written law as if guilty of contempt of court to pay a fine` EQUALS JUST FALSE -- "Nothing in Rules 1 to 9 is to be taken as affecting": a fine
#ASSERT `o 23 r 10 Rules 1 to 9 affect the Court's power to make the order` `o 23 r 10 an order requiring such a person to give security for good behaviour` EQUALS JUST FALSE -- security for good behaviour
#ASSERT `o 23 r 10 Rules 1 to 9 affect the Court's power to make the order` `o 23 r 10 any other order` EQUALS NOTHING -- the saving names two orders
#ASSERT `o 23 r 10 Rules 1 to 9 apply to the application as they apply to an application for a committal order` TRUE TRUE EQUALS JUST TRUE -- applicable, with the necessary modifications
#ASSERT `o 23 r 10 Rules 1 to 9 apply to the application as they apply to an application for a committal order` TRUE FALSE EQUALS NOTHING -- "so far as applicable"
#ASSERT `o 23 r 10 Rules 1 to 9 apply to the application as they apply to an application for a committal order` FALSE TRUE EQUALS NOTHING -- not an application for such an order

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 11`
-- ---------------------------------------------------------------------------

#ASSERT `o 23 r 11(1) the form of the committal order` EQUALS "Form 42" -- "A committal order must be in Form 42"
#ASSERT `o 23 r 11(1) the committal order is in the form required` "Form 42" EQUALS JUST TRUE -- Form 42
#ASSERT `o 23 r 11(1) the committal order is in the form required` "Form 41" EQUALS NOTHING -- another form: silent on what follows

-- arguments: represented by a solicitor; copy filed; undertaking filed; by the solicitor; by the committal applicant; (b)(i) pay; (b)(ii) indemnify
#ASSERT `o 23 r 11(2) the committal applicant has served on the Sheriff's office what is required` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- represented: the solicitor's undertaking
#ASSERT `o 23 r 11(2) the committal applicant has served on the Sheriff's office what is required` FALSE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE -- not represented: the committal applicant's own undertaking
#ASSERT `o 23 r 11(2) the committal applicant has served on the Sheriff's office what is required` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING -- represented, but the undertaking is the applicant's own
#ASSERT `o 23 r 11(2) the committal applicant has served on the Sheriff's office what is required` FALSE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING -- not represented, but the undertaking is a solicitor's
#ASSERT `o 23 r 11(2) the committal applicant has served on the Sheriff's office what is required` TRUE FALSE TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING -- no copy of the order
#ASSERT `o 23 r 11(2) the committal applicant has served on the Sheriff's office what is required` TRUE TRUE FALSE TRUE FALSE TRUE TRUE EQUALS NOTHING -- no undertaking
#ASSERT `o 23 r 11(2) the committal applicant has served on the Sheriff's office what is required` TRUE TRUE TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING -- no undertaking to pay
#ASSERT `o 23 r 11(2) the committal applicant has served on the Sheriff's office what is required` TRUE TRUE TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING -- no undertaking to indemnify
#ASSERT `o 23 r 11(3) the committal applicant has deposited the money requested by the Sheriff` TRUE TRUE EQUALS JUST TRUE -- before, and from time to time
#ASSERT `o 23 r 11(3) the committal applicant has deposited the money requested by the Sheriff` FALSE TRUE EQUALS NOTHING -- not before the Sheriff complied
#ASSERT `o 23 r 11(3) the committal applicant has deposited the money requested by the Sheriff` TRUE FALSE EQUALS NOTHING -- not from time to time

-- ---------------------------------------------------------------------------
§ `Tests -- Rules 12 to 14`
-- ---------------------------------------------------------------------------

#ASSERT `o 23 r 12(1) Rules 1 to 11 apply to committal proceedings before a tribunal` 1 0 EQUALS JUST TRUE -- Rule 1
#ASSERT `o 23 r 12(1) Rules 1 to 11 apply to committal proceedings before a tribunal` 11 0 EQUALS JUST TRUE -- Rule 11, the last
#ASSERT `o 23 r 12(1) Rules 1 to 11 apply to committal proceedings before a tribunal` 6 1 EQUALS JUST TRUE -- Rule 6(1)
#ASSERT `o 23 r 12(1) Rules 1 to 11 apply to committal proceedings before a tribunal` 7 3 EQUALS JUST TRUE -- Rule 7(3) is not excepted
#ASSERT `o 23 r 12(1) Rules 1 to 11 apply to committal proceedings before a tribunal` 7 1 EQUALS JUST FALSE -- "(except Rule 7(1) and (2))"
#ASSERT `o 23 r 12(1) Rules 1 to 11 apply to committal proceedings before a tribunal` 7 2 EQUALS JUST FALSE -- "(except Rule 7(1) and (2))"
#ASSERT `o 23 r 12(1) Rules 1 to 11 apply to committal proceedings before a tribunal` 12 0 EQUALS NOTHING -- outside "Rules 1 to 11"
#ASSERT `o 23 r 12(1) Rules 1 to 11 apply to committal proceedings before a tribunal` 0 0 EQUALS NOTHING -- outside "Rules 1 to 11"
#ASSERT `o 23 r 12(2) how a reference in Order 23 is read for a committal proceeding before an Employment Claims Tribunal` `o 23 r 12(2) a reference to a Court` EQUALS `o 23 r 12(2) a tribunal or a tribunal magistrate` -- (a)
#ASSERT `o 23 r 12(2) how a reference in Order 23 is read for a committal proceeding before an Employment Claims Tribunal` `o 23 r 12(2) a reference to a Judge` EQUALS `o 23 r 12(2) a tribunal magistrate` -- (b)
#ASSERT `o 23 r 12(2) how a reference in Order 23 is read for a committal proceeding before an Employment Claims Tribunal` `o 23 r 12(2) a reference to something else` EQUALS `o 23 r 12(2) not changed by this paragraph` -- neither (a) nor (b)
#ASSERT `o 23 r 12(3) the court fees that apply to proceedings under this Order in a tribunal are those in` TRUE EQUALS JUST `District Court` -- "in a District Court apply to proceedings under this Order in a tribunal"
#ASSERT `o 23 r 12(3) the court fees that apply to proceedings under this Order in a tribunal are those in` FALSE EQUALS NOTHING -- not a tribunal
#ASSERT `o 23 r 12(4) the instrument that prescribes the hearing fees in a tribunal` EQUALS "Employment Claims Rules 2017 (G.N. No. S 104/2017)" -- paragraph (4)
#ASSERT `o 23 r 12(5) "tribunal" is a State Court called an Employment Claims Tribunal constituted under section 4 of the State Courts Act` TRUE TRUE EQUALS JUST TRUE -- means
#ASSERT `o 23 r 12(5) "tribunal" is a State Court called an Employment Claims Tribunal constituted under section 4 of the State Courts Act` TRUE FALSE EQUALS JUST FALSE -- "means": not constituted under section 4
#ASSERT `o 23 r 12(5) "tribunal" is a State Court called an Employment Claims Tribunal constituted under section 4 of the State Courts Act` FALSE TRUE EQUALS JUST FALSE -- "means": not called an Employment Claims Tribunal
#ASSERT `o 23 r 12(5) "tribunal magistrate" has the meaning given by section 2(1) of the Employment Claims Act 2016` (JUST TRUE) EQUALS JUST TRUE -- the section 2(1) answer is passed through
#ASSERT `o 23 r 12(5) "tribunal magistrate" has the meaning given by section 2(1) of the Employment Claims Act 2016` (JUST FALSE) EQUALS JUST FALSE -- passed through
#ASSERT `o 23 r 12(5) "tribunal magistrate" has the meaning given by section 2(1) of the Employment Claims Act 2016` NOTHING EQUALS NOTHING -- the Act is outside the sources

#ASSERT `o 23 r 13(1) Rules 1 to 11 apply to committal proceedings before a Small Claims Tribunal` 3 0 EQUALS JUST TRUE -- Rule 3
#ASSERT `o 23 r 13(1) Rules 1 to 11 apply to committal proceedings before a Small Claims Tribunal` 7 1 EQUALS JUST FALSE -- except Rule 7(1)
#ASSERT `o 23 r 13(1) Rules 1 to 11 apply to committal proceedings before a Small Claims Tribunal` 15 0 EQUALS NOTHING -- outside
#ASSERT `o 23 r 13(2) how a reference in Order 23 is read for a committal proceeding before a Small Claims Tribunal` `o 23 r 12(2) a reference to a Court` EQUALS `o 23 r 12(2) a tribunal or a tribunal magistrate` -- (a)
#ASSERT `o 23 r 13(2) how a reference in Order 23 is read for a committal proceeding before a Small Claims Tribunal` `o 23 r 12(2) a reference to a Judge` EQUALS `o 23 r 12(2) a tribunal magistrate` -- (b)
#ASSERT `o 23 r 13(3) the court fees and hearing fees that apply to proceedings under this Order in a tribunal are those in` TRUE EQUALS JUST `Magistrate's Court` -- paragraphs (3) and (4)
#ASSERT `o 23 r 13(3) the court fees and hearing fees that apply to proceedings under this Order in a tribunal are those in` FALSE EQUALS NOTHING -- not a tribunal
#ASSERT `o 23 r 13(5) "tribunal" is a Small Claims Tribunal constituted under section 4 of the State Courts Act` TRUE TRUE EQUALS JUST TRUE -- means
#ASSERT `o 23 r 13(5) "tribunal" is a Small Claims Tribunal constituted under section 4 of the State Courts Act` FALSE TRUE EQUALS JUST FALSE -- "means"
#ASSERT `o 23 r 13(5) "tribunal" is a Small Claims Tribunal constituted under section 4 of the State Courts Act` TRUE FALSE EQUALS JUST FALSE -- "means"
#ASSERT `o 23 r 13(5) "tribunal magistrate" has the meaning given by section 2(1) of the Small Claims Tribunals Act` NOTHING EQUALS NOTHING -- the Act is outside the sources
#ASSERT `o 23 r 13(5) "tribunal magistrate" has the meaning given by section 2(1) of the Small Claims Tribunals Act` (JUST TRUE) EQUALS JUST TRUE -- passed through

#ASSERT `o 23 r 14(1) Rules 1 to 11 apply to a Community Disputes Resolution Tribunal` 9 2 EQUALS JUST TRUE -- Rule 9(2)
#ASSERT `o 23 r 14(1) Rules 1 to 11 apply to a Community Disputes Resolution Tribunal` 7 2 EQUALS JUST FALSE -- except Rule 7(2)
#ASSERT `o 23 r 14(1) Rules 1 to 11 apply to a Community Disputes Resolution Tribunal` 13 0 EQUALS NOTHING -- outside
#ASSERT `o 23 r 14(2) how a reference in Order 23 is read for a Community Disputes Resolution Tribunal` `o 23 r 14(2) a reference to a Court` EQUALS `o 23 r 14(2) a tribunal or a tribunal judge` -- (a)
#ASSERT `o 23 r 14(2) how a reference in Order 23 is read for a Community Disputes Resolution Tribunal` `o 23 r 14(2) a reference to a Judge` EQUALS `o 23 r 14(2) a tribunal judge` -- (b)
#ASSERT `o 23 r 14(2) how a reference in Order 23 is read for a Community Disputes Resolution Tribunal` `o 23 r 14(2) a reference to something else` EQUALS `o 23 r 14(2) not changed by this paragraph` -- neither
#ASSERT `o 23 r 14(3) "tribunal" is a State Court designated as a Community Disputes Resolution Tribunal` TRUE EQUALS JUST TRUE -- means
#ASSERT `o 23 r 14(3) "tribunal" is a State Court designated as a Community Disputes Resolution Tribunal` FALSE EQUALS JUST FALSE -- "means"
#ASSERT `o 23 r 14(3) "tribunal judge" is a District Judge designated as a tribunal judge` TRUE EQUALS JUST TRUE -- means
#ASSERT `o 23 r 14(3) "tribunal judge" is a District Judge designated as a tribunal judge` FALSE EQUALS JUST FALSE -- "means"

-- ---------------------------------------------------------------------------
§ `Tests -- Rules 15 and 16`
-- ---------------------------------------------------------------------------

#ASSERT `o 23 r 15(1) the Attorney-General's application is made in the way required` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- originating application without notice, with an affidavit by an authorised person
#ASSERT `o 23 r 15(1) the Attorney-General's application is made in the way required` FALSE TRUE TRUE TRUE EQUALS NOTHING -- not an application by the Attorney-General
#ASSERT `o 23 r 15(1) the Attorney-General's application is made in the way required` TRUE FALSE TRUE TRUE EQUALS NOTHING -- not an originating application without notice
#ASSERT `o 23 r 15(1) the Attorney-General's application is made in the way required` TRUE TRUE FALSE TRUE EQUALS NOTHING -- no affidavit
#ASSERT `o 23 r 15(1) the Attorney-General's application is made in the way required` TRUE TRUE TRUE FALSE EQUALS NOTHING -- the affidavit is by someone not authorised

#ASSERT `o 23 r 15(3) the supporting affidavit states what it must` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- (a), (b)(i), (b)(ii), (c), (d)
#ASSERT `o 23 r 15(3) the supporting affidavit states what it must` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- (a) missing
#ASSERT `o 23 r 15(3) the supporting affidavit states what it must` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING -- (b)(i) missing
#ASSERT `o 23 r 15(3) the supporting affidavit states what it must` TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING -- (b)(ii) missing
#ASSERT `o 23 r 15(3) the supporting affidavit states what it must` TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING -- (c) missing
#ASSERT `o 23 r 15(3) the supporting affidavit states what it must` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- (d) missing

#ASSERT `o 23 r 15(4) the period for serving the non-publication direction`'s `period length` EQUALS 14 -- "within 14 days"
#ASSERT `o 23 r 15(4) the Court's permission to give the non-publication direction lapses` (JUST (Date 10 3 2026)) (Date 14 3 2026) (Date 20 3 2026) EQUALS JUST FALSE -- served inside the 14 days: it does not lapse
#ASSERT `o 23 r 15(4) the Court's permission to give the non-publication direction lapses` (JUST (Date 14 3 2026)) (Date 14 3 2026) (Date 20 3 2026) EQUALS JUST FALSE -- served on the last day
#ASSERT `o 23 r 15(4) the Court's permission to give the non-publication direction lapses` (JUST (Date 15 3 2026)) (Date 14 3 2026) (Date 20 3 2026) EQUALS JUST TRUE -- served one day late: it lapses
#ASSERT `o 23 r 15(4) the Court's permission to give the non-publication direction lapses` NOTHING (Date 14 3 2026) (Date 15 3 2026) EQUALS JUST TRUE -- not served and the 14 days have run
#ASSERT `o 23 r 15(4) the Court's permission to give the non-publication direction lapses` NOTHING (Date 14 3 2026) (Date 14 3 2026) EQUALS JUST FALSE -- not served yet and the last day has not passed

#ASSERT `o 23 r 15(5) the affidavit of service of the non-publication direction has been filed` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- served; affidavit filed with the statement and the particulars
#ASSERT `o 23 r 15(5) the affidavit of service of the non-publication direction has been filed` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- "After a non‑publication direction is served": not yet served
#ASSERT `o 23 r 15(5) the affidavit of service of the non-publication direction has been filed` TRUE FALSE TRUE TRUE EQUALS NOTHING -- no affidavit filed
#ASSERT `o 23 r 15(5) the affidavit of service of the non-publication direction has been filed` TRUE TRUE FALSE TRUE EQUALS NOTHING -- the affidavit does not state service in accordance with the Act
#ASSERT `o 23 r 15(5) the affidavit of service of the non-publication direction has been filed` TRUE TRUE TRUE FALSE EQUALS NOTHING -- no particulars

#ASSERT `o 23 r 16(2) the period for applying to vary or set aside the direction`'s `period length` EQUALS 14 -- "within 14 days"
#ASSERT `o 23 r 16(2) the application is made within 14 days after the direction is served` TRUE (Date 1 4 2026) (Date 14 4 2026) EQUALS JUST TRUE -- inside
#ASSERT `o 23 r 16(2) the application is made within 14 days after the direction is served` TRUE (Date 14 4 2026) (Date 14 4 2026) EQUALS JUST TRUE -- the last day
#ASSERT `o 23 r 16(2) the application is made within 14 days after the direction is served` TRUE (Date 15 4 2026) (Date 14 4 2026) EQUALS JUST FALSE -- late (ruling (a))
#ASSERT `o 23 r 16(2) the application is made within 14 days after the direction is served` FALSE (Date 1 4 2026) (Date 14 4 2026) EQUALS NOTHING -- not an application under section 13(9)
#ASSERT `o 23 r 16(3) paragraph (2) applies to the application` TRUE EQUALS JUST TRUE -- "applies even if the application is made by the author"
#ASSERT `o 23 r 16(3) paragraph (2) applies to the application` FALSE EQUALS JUST TRUE -- paragraph (2) applies to every application under section 13(9)
#ASSERT `o 23 r 16(4) the application to vary or set aside is made as required` TRUE TRUE EQUALS JUST TRUE -- summons in the originating application, with an affidavit
#ASSERT `o 23 r 16(4) the application to vary or set aside is made as required` FALSE TRUE EQUALS NOTHING -- not in that originating application
#ASSERT `o 23 r 16(4) the application to vary or set aside is made as required` TRUE FALSE EQUALS NOTHING -- no affidavit
#ASSERT `o 23 r 16(5) the applicant has served the summons and the supporting affidavit on those required` TRUE TRUE TRUE EQUALS JUST TRUE -- Attorney-General, other persons, those the Court orders
#ASSERT `o 23 r 16(5) the applicant has served the summons and the supporting affidavit on those required` FALSE TRUE TRUE EQUALS NOTHING -- not on the Attorney-General
#ASSERT `o 23 r 16(5) the applicant has served the summons and the supporting affidavit on those required` TRUE FALSE TRUE EQUALS NOTHING -- not on a person to whom the direction applies
#ASSERT `o 23 r 16(5) the applicant has served the summons and the supporting affidavit on those required` TRUE TRUE FALSE EQUALS NOTHING -- not on a person the Court ordered
#ASSERT `o 23 r 16(6) the supporting affidavit states that the applicant is the author` TRUE TRUE EQUALS JUST TRUE -- author, and the affidavit says so
#ASSERT `o 23 r 16(6) the supporting affidavit states that the applicant is the author` TRUE FALSE EQUALS NOTHING -- author, and it does not
#ASSERT `o 23 r 16(6) the supporting affidavit states that the applicant is the author` FALSE FALSE EQUALS JUST FALSE -- "If the applicant is the author": not the author

#ASSERT `o 23 r 16(7) the period for serving the order setting aside or varying the direction`'s `period length` EQUALS 14 -- "within 14 days after the date of the order"
#ASSERT `o 23 r 16(7) the order is served within 14 days after the date of the order` TRUE (Date 20 4 2026) (Date 24 4 2026) EQUALS JUST TRUE -- inside
#ASSERT `o 23 r 16(7) the order is served within 14 days after the date of the order` TRUE (Date 24 4 2026) (Date 24 4 2026) EQUALS JUST TRUE -- the last day
#ASSERT `o 23 r 16(7) the order is served within 14 days after the date of the order` TRUE (Date 25 4 2026) (Date 24 4 2026) EQUALS JUST FALSE -- late (ruling (a))
#ASSERT `o 23 r 16(7) the order is served within 14 days after the date of the order` FALSE (Date 20 4 2026) (Date 24 4 2026) EQUALS JUST FALSE -- "If the Court sets aside or varies": it did not
#ASSERT `o 23 r 16(7) the order has been served on those required` TRUE FALSE TRUE EQUALS JUST TRUE -- (a) served on the person, and (b)
#ASSERT `o 23 r 16(7) the order has been served on those required` FALSE FALSE TRUE EQUALS NOTHING -- (a) not served, and the person is not the applicant
#ASSERT `o 23 r 16(7) the order has been served on those required` FALSE TRUE TRUE EQUALS JUST TRUE -- (a) "(unless the person is the applicant)": the person is the applicant, so nothing is owed under (a)
#ASSERT `o 23 r 16(7) the order has been served on those required` TRUE FALSE FALSE EQUALS NOTHING -- (b) not served
#ASSERT `o 23 r 16(7) the order has been served on those required` FALSE TRUE FALSE EQUALS NOTHING -- the person is the applicant, but (b) is not served
-- Who bears the duties the Rules name (the bearer, returned as a string).
#ASSERT `o 23 r 6(3)(b) the person who must send the file, documents, exhibits and certified copy of the notes of evidence to the Registrar of the Supreme Court` EQUALS "the Registrar of the State Courts" -- Rule 6(3)(b): "the Registrar of the State Courts must send"
#ASSERT `o 23 r 6(3)(c) the person who must give notice of the transfer to every party to the case` EQUALS "the Registrar of the Supreme Court" -- Rule 6(3)(c): "the Registrar of the Supreme Court must give notice"
#ASSERT `o 23 r 15(5) the person who must file the affidavit of service of the non-publication direction` EQUALS "a person authorised by the Attorney-General" -- Rule 15(5)
#ASSERT `o 23 r 16(8) the applicant has filed the affidavit of service of the order` TRUE TRUE TRUE EQUALS JUST TRUE -- required, served, affidavit filed
#ASSERT `o 23 r 16(8) the applicant has filed the affidavit of service of the order` FALSE TRUE TRUE EQUALS JUST FALSE -- "If an order of Court is required to be served": none is
#ASSERT `o 23 r 16(8) the applicant has filed the affidavit of service of the order` TRUE FALSE TRUE EQUALS NOTHING -- the order has not been served yet
#ASSERT `o 23 r 16(8) the applicant has filed the affidavit of service of the order` TRUE TRUE FALSE EQUALS NOTHING -- no affidavit filed
#ASSERT `o 23 r 16(9) the date from which the order setting aside the direction takes effect` (Date 1 5 2026) (JUST (Date 10 5 2026)) EQUALS Date 10 5 2026 -- "or such other date as the Court may specify"
#ASSERT `o 23 r 16(9) the date from which the order setting aside the direction takes effect` (Date 1 5 2026) NOTHING EQUALS Date 1 5 2026 -- "from the date of the order"
#ASSERT `o 23 r 16(10)(a) the date from which the order varying the direction takes effect as to the applicant` (Date 1 5 2026) (JUST (Date 3 5 2026)) EQUALS Date 3 5 2026 -- specified date
#ASSERT `o 23 r 16(10)(a) the date from which the order varying the direction takes effect as to the applicant` (Date 1 5 2026) NOTHING EQUALS Date 1 5 2026 -- the date of the order
#ASSERT `o 23 r 16(10)(b) the date from which the order varying the direction takes effect as to a person other than the applicant` (Date 4 5 2026) (JUST (Date 9 5 2026)) EQUALS JUST (Date 9 5 2026) -- a later date specified
#ASSERT `o 23 r 16(10)(b) the date from which the order varying the direction takes effect as to a person other than the applicant` (Date 4 5 2026) (JUST (Date 2 5 2026)) EQUALS NOTHING -- an earlier date is not "such later date"
#ASSERT `o 23 r 16(10)(b) the date from which the order varying the direction takes effect as to a person other than the applicant` (Date 4 5 2026) (JUST (Date 4 5 2026)) EQUALS NOTHING -- the same day is not "later"
#ASSERT `o 23 r 16(10)(b) the date from which the order varying the direction takes effect as to a person other than the applicant` (Date 4 5 2026) NOTHING EQUALS JUST (Date 4 5 2026) -- "from the date on which the order is served on the person"
#ASSERT `o 23 r 16(10)(b) the date the Court specified is a later date than the date of service` (Date 4 5 2026) (Date 9 5 2026) EQUALS JUST TRUE -- a later date: "such later date as the Court may specify"
#ASSERT `o 23 r 16(10)(b) the date the Court specified is a later date than the date of service` (Date 4 5 2026) (Date 4 5 2026) EQUALS JUST FALSE -- the same day is not "later" (ruling (a))
#ASSERT `o 23 r 16(10)(b) the date the Court specified is a later date than the date of service` (Date 4 5 2026) (Date 2 5 2026) EQUALS JUST FALSE -- an earlier date is not "such later date" (ruling (a))

-- ---------------------------------------------------------------------------
§ `Tests -- Rules 17 and 18`
-- ---------------------------------------------------------------------------

#ASSERT `o 23 r 17(1) the Court may order the Sheriff or a police officer to arrest and bring the committal respondent before the Court` TRUE FALSE EQUALS JUST TRUE -- fails to attend
#ASSERT `o 23 r 17(1) the Court may order the Sheriff or a police officer to arrest and bring the committal respondent before the Court` FALSE TRUE EQUALS JUST TRUE -- disobeys an order
#ASSERT `o 23 r 17(1) the Court may order the Sheriff or a police officer to arrest and bring the committal respondent before the Court` FALSE FALSE EQUALS NOTHING -- neither
#ASSERT `o 23 r 17(2) the Court may include conditions about security or any other matter in the order to arrest` TRUE EQUALS JUST TRUE -- an order under paragraph (1)
#ASSERT `o 23 r 17(2) the Court may include conditions about security or any other matter in the order to arrest` FALSE EQUALS NOTHING -- no such order
#ASSERT `o 23 r 17(3) the letter is sufficient authority for the Sheriff or a police officer to effect the arrest` TRUE TRUE EQUALS JUST TRUE -- a Registrar's letter stating the order
#ASSERT `o 23 r 17(3) the letter is sufficient authority for the Sheriff or a police officer to effect the arrest` FALSE TRUE EQUALS NOTHING -- not from the Registrar
#ASSERT `o 23 r 17(3) the letter is sufficient authority for the Sheriff or a police officer to effect the arrest` TRUE FALSE EQUALS NOTHING -- does not state the order
#ASSERT `o 23 r 18(1) the Sheriff may engage, or direct the applicant to engage, the person` TRUE TRUE EQUALS JUST TRUE -- an auxiliary police officer or security agency, to assist
#ASSERT `o 23 r 18(1) the Sheriff may engage, or direct the applicant to engage, the person` FALSE TRUE EQUALS NOTHING -- another kind of person
#ASSERT `o 23 r 18(1) the Sheriff may engage, or direct the applicant to engage, the person` TRUE FALSE EQUALS NOTHING -- not to assist with duties under this Order
#ASSERT `o 23 r 18(2) the amount is part of the charges, expenses and fees incurred in complying with a committal order` TRUE EQUALS JUST TRUE -- incurred under paragraph (1)
#ASSERT `o 23 r 18(2) the amount is part of the charges, expenses and fees incurred in complying with a committal order` FALSE EQUALS NOTHING -- not incurred under paragraph (1)

-- ---------------------------------------------------------------------------
§ `Tests -- the duties as regulative rules (traces, not assertions)`
-- ---------------------------------------------------------------------------

-- A #TRACE prints its result and no assertion line, and a DEONTIC value cannot be compared in an #ASSERT on this
-- binary, so these are run, not counted: the result each should print is written beside it, from the text, and
-- the decision function that says the same thing is asserted above.
-- expected: FULFILLED -- the committal applicant applies on day 10, inside the 14 days (O 23 r 4(1))
#TRACE `o 23 r 4(1) the committal applicant must apply for the committal order within 14 days` AT 0 WITH
    PARTY `o 23 the committal applicant` DOES `o 23 r 4(1) apply for the committal order` AT 10
-- expected: BREACH -- nothing is done by day 15
#TRACE `o 23 r 4(1) the committal applicant must apply for the committal order within 14 days` AT 0 WITH
    (WAITUNTIL 15)
-- expected: BREACH -- the committal applicant relies on a ground outside the affidavit (O 23 r 7(3))
#TRACE `o 23 r 7(3) the committal applicant shall not rely on a ground not set out in the affidavit` AT 0 WITH
    PARTY `o 23 the committal applicant` DOES `o 23 r 7(3) rely on a ground not set out in the affidavit` AT 3
-- expected: FULFILLED -- the committal applicant serves the notice (O 23 r 8(2))
#TRACE `o 23 r 8(2) the committal applicant must serve a notice of the terms of the suspension` AT 0 WITH
    PARTY `o 23 the committal applicant` DOES `o 23 r 8(2) serve a notice of the terms of the suspension` AT 2
-- expected: FULFILLED -- the committal applicant deposits what the Sheriff requested (O 23 r 11(3))
#TRACE `o 23 r 11(3) the committal applicant must deposit the money the Sheriff requested` AT 0 WITH
    PARTY `o 23 the committal applicant` DOES `o 23 r 11(3) deposit the money the Sheriff requested` AT 1
-- expected: FULFILLED -- the order is served on day 14, the last day (O 23 r 16(7))
#TRACE `o 23 r 16(7) the applicant must serve the order within 14 days after the date of the order` AT 0 WITH
    PARTY `o 23 the applicant to vary or set aside a non-publication direction` DOES `o 23 r 16(7) serve the order setting aside or varying the direction` AT 14
-- expected: BREACH -- the order is served on day 15 (O 23 r 16(7))
#TRACE `o 23 r 16(7) the applicant must serve the order within 14 days after the date of the order` AT 0 WITH
    PARTY `o 23 the applicant to vary or set aside a non-publication direction` DOES `o 23 r 16(7) serve the order setting aside or varying the direction` AT 15
