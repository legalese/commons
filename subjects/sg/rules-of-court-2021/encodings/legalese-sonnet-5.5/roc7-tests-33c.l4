IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc7-order-33c`

-- Rules of Court 2021 (Singapore): TESTS for roc7-order-33c.
-- Expected values are written from the text of the rule named after each assertion (the comment on its line),
-- never copied from what the code printed.  The gate-shaped rules (a MAYBE BOOLEAN over BOOLEAN conditions) are tested
-- by the kind of the rule: every condition met; then each condition missing in turn.


-- Hand-written tests for Order 33 rules 29 to 46.  Generated assertions (gates and periods) follow.

-- r 30(4): the preliminary acts
#ASSERT `o 33 r 30(4) an order authorising an examination of a witness cannot yet be made for want of the preliminary acts` TRUE FALSE EQUALS JUST TRUE -- preliminary acts to be filed, not yet filed
#ASSERT `o 33 r 30(4) an order authorising an examination of a witness cannot yet be made for want of the preliminary acts` TRUE TRUE EQUALS JUST FALSE -- filed
#ASSERT `o 33 r 30(4) an order authorising an examination of a witness cannot yet be made for want of the preliminary acts` FALSE FALSE EQUALS NOTHING -- no preliminary acts to be filed: silent
#ASSERT `o 33 r 30(4) an order may be made under Order 9 Rule 24 authorising an examination of a witness` TRUE FALSE FALSE EQUALS JUST FALSE -- not filed, no special reasons
#ASSERT `o 33 r 30(4) an order may be made under Order 9 Rule 24 authorising an examination of a witness` TRUE TRUE FALSE EQUALS NOTHING -- filed: the before-bar has ended and nothing grants the order (QA)
#ASSERT `o 33 r 30(4) an order may be made under Order 9 Rule 24 authorising an examination of a witness` TRUE FALSE TRUE EQUALS JUST TRUE -- special reasons: the Court's direction is the exception the sentence gives (QA)
#ASSERT `o 33 r 30(4) an order may be made under Order 9 Rule 24 authorising an examination of a witness` TRUE TRUE TRUE EQUALS NOTHING -- filed and a direction: the before-bar has ended, so the sentence grants nothing (QA)
#ASSERT `o 33 r 30(4) an order may be made under Order 9 Rule 24 authorising an examination of a witness` FALSE FALSE FALSE EQUALS NOTHING -- no preliminary acts to be filed: silent

-- r 32(1)
#ASSERT `o 33 r 32(1) the proceedings for the apportionment of salvage are begun in the way required` TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- originating application
#ASSERT `o 33 r 32(1) the proceedings for the apportionment of salvage are begun in the way required` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- summons in a pending action
#ASSERT `o 33 r 32(1) the proceedings for the apportionment of salvage are begun in the way required` TRUE FALSE FALSE TRUE EQUALS NOTHING -- summons but no pending action
#ASSERT `o 33 r 32(1) the proceedings for the apportionment of salvage are begun in the way required` FALSE FALSE TRUE FALSE EQUALS NOTHING -- not salvage proceedings: the duty does not arise
#ASSERT `o 33 r 32(1) the proceedings for the apportionment of salvage are begun in the way required (the duty arises)` TRUE EQUALS JUST TRUE -- salvage proceedings
#ASSERT `o 33 r 32(1) the proceedings for the apportionment of salvage are begun in the way required (the duty arises)` FALSE EQUALS JUST FALSE -- not

-- r 35(2): QE
#ASSERT `o 33 r 35(2) a provision of Rule 27 applies to the Admiralty cause or matter` TRUE FALSE EQUALS JUST TRUE -- Rule 27 other than paragraph (3)
#ASSERT `o 33 r 35(2) a provision of Rule 27 applies to the Admiralty cause or matter` TRUE TRUE EQUALS JUST FALSE -- "(except paragraph (3) of that Rule)": excepted, so it does not apply
#ASSERT `o 33 r 35(2) a provision of Rule 27 applies to the Admiralty cause or matter` FALSE FALSE EQUALS NOTHING -- not begun by originating application

-- r 37(1)
#ASSERT `o 33 r 37(1) the Court may allow the person to constitute a limitation fund in the way` TRUE TRUE `o 33 r 37(1)(a) by making payment into Court under an order of the Court` EQUALS JUST TRUE -- (a), allowed
#ASSERT `o 33 r 37(1) the Court may allow the person to constitute a limitation fund in the way` TRUE TRUE `o 33 r 37(1)(b) by producing a letter of undertaking from a Protection and Indemnity Club acceptable to the Court` EQUALS JUST TRUE -- (b), allowed
#ASSERT `o 33 r 37(1) the Court may allow the person to constitute a limitation fund in the way` TRUE FALSE `o 33 r 37(1)(a) by making payment into Court under an order of the Court` EQUALS NOTHING -- (a), not allowed: the power is not used
#ASSERT `o 33 r 37(1) the Court may allow the person to constitute a limitation fund in the way` TRUE TRUE `o 33 r 37(1) any other way` EQUALS NOTHING -- a list not closed
#ASSERT `o 33 r 37(1) the Court may allow the person to constitute a limitation fund in the way` FALSE TRUE `o 33 r 37(1)(a) by making payment into Court under an order of the Court` EQUALS JUST FALSE -- not a person seeking relief in a limitation action

-- r 37(4): QA
#ASSERT `o 33 r 37(4) the money paid into Court under paragraph (1) may be paid out` TRUE FALSE EQUALS JUST FALSE -- no order
#ASSERT `o 33 r 37(4) the money paid into Court under paragraph (1) may be paid out` TRUE TRUE EQUALS JUST TRUE -- by order: under an order the money may be paid out (QA)
#ASSERT `o 33 r 37(4) the money paid into Court under paragraph (1) may be paid out` FALSE FALSE EQUALS NOTHING -- not that money: silent

-- r 38(2)
#ASSERT `o 33 r 38(2) the summons is supported by the affidavits required` TRUE TRUE TRUE FALSE EQUALS JUST TRUE -- the claimant's case proved; a named defendant filed a notice
#ASSERT `o 33 r 38(2) the summons is supported by the affidavits required` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- no named defendant filed; service proved
#ASSERT `o 33 r 38(2) the summons is supported by the affidavits required` TRUE TRUE FALSE FALSE EQUALS NOTHING -- no named defendant filed; service not proved
#ASSERT `o 33 r 38(2) the summons is supported by the affidavits required` TRUE FALSE TRUE TRUE EQUALS NOTHING -- the claimant's case not proved
#ASSERT `o 33 r 38(2) the summons is supported by the affidavits required` FALSE TRUE TRUE TRUE EQUALS NOTHING -- not that summons: the duty does not arise
#ASSERT `o 33 r 38(2) the summons is supported by the affidavits required (the duty arises)` TRUE EQUALS JUST TRUE -- that summons
#ASSERT `o 33 r 38(2) the summons is supported by the affidavits required (the duty arises)` FALSE EQUALS JUST FALSE -- not

-- r 39(1)
#ASSERT `o 33 r 39(1)(b) the decree protects the claimant against the claim` TRUE TRUE EQUALS JUST TRUE -- a claim by a person so named
#ASSERT `o 33 r 39(1)(b) the decree protects the claimant against the claim` TRUE FALSE EQUALS JUST FALSE -- "only operates to protect" in respect of those claims
#ASSERT `o 33 r 39(1)(b) the decree protects the claimant against the claim` FALSE TRUE EQUALS NOTHING -- outside paragraph (1)

-- r 39(4)
#ASSERT `o 33 r 39(4) the claimant files the copies of the newspapers in time` (JUST (Date 14 6 2026)) (Date 14 6 2026) (Date 20 6 2026) EQUALS JUST TRUE -- on the last day of the time fixed
#ASSERT `o 33 r 39(4) the claimant files the copies of the newspapers in time` (JUST (Date 15 6 2026)) (Date 14 6 2026) (Date 20 6 2026) EQUALS JUST FALSE -- the day after
#ASSERT `o 33 r 39(4) the claimant files the copies of the newspapers in time` NOTHING (Date 14 6 2026) (Date 10 6 2026) EQUALS NOTHING -- not yet filed, time running
#ASSERT `o 33 r 39(4) the claimant files the copies of the newspapers in time` NOTHING (Date 14 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- not filed, time out

-- r 39(5)
#ASSERT `o 33 r 39(5) the step may be taken after the time allowed has expired` TRUE TRUE FALSE EQUALS JUST FALSE -- after the time, no permission
#ASSERT `o 33 r 39(5) the step may be taken after the time allowed has expired` TRUE TRUE TRUE EQUALS JUST TRUE -- permission: the permission is the exception the sentence gives (QA)
#ASSERT `o 33 r 39(5) the step may be taken after the time allowed has expired` FALSE TRUE FALSE EQUALS NOTHING -- time still running: silent
#ASSERT `o 33 r 39(5) the step may be taken after the time allowed has expired` TRUE FALSE FALSE EQUALS NOTHING -- another step: silent

-- r 40(1)
#ASSERT `o 33 r 40(1) the person takes out the summons within the time fixed by the decree` (JUST (Date 14 6 2026)) (Date 14 6 2026) (Date 20 6 2026) EQUALS JUST TRUE -- on the last day
#ASSERT `o 33 r 40(1) the person takes out the summons within the time fixed by the decree` (JUST (Date 15 6 2026)) (Date 14 6 2026) (Date 20 6 2026) EQUALS JUST FALSE -- the day after
#ASSERT `o 33 r 40(1) the person takes out the summons within the time fixed by the decree` NOTHING (Date 14 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- not taken out, time out

-- r 41(3)
#ASSERT `o 33 r 41(3) the appointment of the day for the hearing is made in the way required` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- a limitation action
#ASSERT `o 33 r 41(3) the appointment of the day for the hearing is made in the way required` TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- the parties consent to a day
#ASSERT `o 33 r 41(3) the appointment of the day for the hearing is made in the way required` TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- by order on a summons
#ASSERT `o 33 r 41(3) the appointment of the day for the hearing is made in the way required` TRUE FALSE FALSE FALSE EQUALS NOTHING -- none of the three
#ASSERT `o 33 r 41(3) the appointment of the day for the hearing is made in the way required` FALSE FALSE FALSE FALSE EQUALS NOTHING -- no reference to be heard: the duty does not arise
#ASSERT `o 33 r 41(3) the appointment of the day for the hearing is made in the way required (the duty arises)` TRUE EQUALS JUST TRUE -- a reference to be heard
#ASSERT `o 33 r 41(3) the appointment of the day for the hearing is made in the way required (the duty arises)` FALSE EQUALS JUST FALSE -- none

-- r 41(4): the until bar
#ASSERT `o 33 r 41(4) an appointment for the hearing of the reference cannot yet be made` FALSE FALSE FALSE EQUALS JUST TRUE -- claim not filed
#ASSERT `o 33 r 41(4) an appointment for the hearing of the reference cannot yet be made` TRUE FALSE FALSE EQUALS JUST FALSE -- claim filed
#ASSERT `o 33 r 41(4) an appointment for the hearing of the reference cannot yet be made` FALSE TRUE FALSE EQUALS JUST TRUE -- limitation action, time for claims not expired
#ASSERT `o 33 r 41(4) an appointment for the hearing of the reference cannot yet be made` FALSE TRUE TRUE EQUALS JUST FALSE -- limitation action, time for claims expired
#ASSERT `o 33 r 41(4) an appointment for the hearing of the reference cannot yet be made` TRUE TRUE FALSE EQUALS JUST TRUE -- limitation action: the claim's filing does not lift the bar, the expiry does

-- r 42(3)
#ASSERT `o 33 r 42(3) evidence may be given in the manner` TRUE TRUE `o 33 r 42(3) orally` EQUALS JUST TRUE -- orally
#ASSERT `o 33 r 42(3) evidence may be given in the manner` TRUE TRUE `o 33 r 42(3) by affidavit` EQUALS JUST TRUE -- by affidavit
#ASSERT `o 33 r 42(3) evidence may be given in the manner` TRUE TRUE `o 33 r 42(3) in such other manner as may be agreed upon` EQUALS JUST TRUE -- in a manner agreed
#ASSERT `o 33 r 42(3) evidence may be given in the manner` TRUE TRUE `o 33 r 42(3) in any other manner` EQUALS NOTHING -- a list not closed
#ASSERT `o 33 r 42(3) evidence may be given in the manner` TRUE FALSE `o 33 r 42(3) orally` EQUALS JUST FALSE -- "Subject to paragraph (2)": a direction limits the evidence
#ASSERT `o 33 r 42(3) evidence may be given in the manner` FALSE TRUE `o 33 r 42(3) orally` EQUALS JUST FALSE -- not the hearing of a reference

-- r 42 anchor
#ASSERT `o 33 r 42 a reference is heard under this Rule` TRUE TRUE EQUALS JUST TRUE -- referred and heard
#ASSERT `o 33 r 42 a reference is heard under this Rule` TRUE FALSE EQUALS NOTHING -- not heard: silent

-- r 43(2): QA and the until bar
#ASSERT `o 33 r 43(2) the decision cannot yet be acted upon` FALSE EQUALS JUST TRUE -- time for the summons not elapsed
#ASSERT `o 33 r 43(2) the decision cannot yet be acted upon` TRUE EQUALS JUST FALSE -- elapsed
#ASSERT `o 33 r 43(2) the decision may be acted upon` FALSE FALSE EQUALS JUST FALSE -- not elapsed, no direction
#ASSERT `o 33 r 43(2) the decision may be acted upon` TRUE FALSE EQUALS NOTHING -- elapsed: the until-bar has ended and nothing grants the act (QA)
#ASSERT `o 33 r 43(2) the decision may be acted upon` FALSE TRUE EQUALS JUST TRUE -- direction: the direction is the exception the sentence gives (QA)
#ASSERT `o 33 r 43(2) the decision may be acted upon` TRUE TRUE EQUALS NOTHING -- elapsed and a direction: the until-bar has ended, so the sentence grants nothing (QA)


