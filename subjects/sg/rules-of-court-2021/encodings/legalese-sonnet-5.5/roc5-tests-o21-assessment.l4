IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc5-o21-assessment`

-- TESTS for roc5-o21-assessment.l4 (Order 21, rules 17 to 29).  Every expected value is written from the text
-- of the Rules (lines 3036 to 3132 of the raw file), beside the assertion, before the module was run.
-- A "last day" below is a made-up answer of O 3 r 3 (seam S-T1).

§ `Tests -- Order 21, Divisions 2 to 6`

-- ---------------------------------------------------------------------------
§§ `Rule 17 -- the bill of costs is filed within 12 months`
-- ---------------------------------------------------------------------------

#ASSERT `o 21 r 17 the period for filing the bill of costs`'s `period length` EQUALS 12
#ASSERT `o 21 r 17 the period for filing the bill of costs`'s `period unit` EQUALS Months
-- case finally disposed of on 10 January 2027: the 12 months end on 10 January 2028 (made-up O 3 r 3 answer).
#ASSERT `o 21 r 17 the bill of costs is filed in time` (Date 10 1 2028) (Date 10 1 2028) FALSE EQUALS JUST TRUE
#ASSERT `o 21 r 17 the bill of costs is filed in time` (Date 11 1 2028) (Date 10 1 2028) FALSE EQUALS JUST FALSE
-- "unless the Court otherwise orders": the Court's order governs: not covered.
#ASSERT `o 21 r 17 the bill of costs is filed in time` (Date 11 1 2028) (Date 10 1 2028) TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§§ `Rules 18 and 19 -- notice and delivery`
-- ---------------------------------------------------------------------------

#ASSERT `o 21 r 18 the notice period before the assessment`'s `period length` EQUALS 14
#ASSERT `o 21 r 18 the notice period before the assessment`'s `period direction` EQUALS `Before the anchor`
-- assessment on 30 June 2027: notice at least 14 days before, so by 16 June 2027.
#ASSERT `o 21 r 18 the Registrar's notice of the assessment is given in time` TRUE (Date 16 6 2027) (Date 16 6 2027) EQUALS JUST TRUE
#ASSERT `o 21 r 18 the Registrar's notice of the assessment is given in time` TRUE (Date 17 6 2027) (Date 16 6 2027) EQUALS JUST FALSE
-- "Where the bill of costs has been filed in accordance with Rule 17": it has not: no.
#ASSERT `o 21 r 18 the Registrar's notice of the assessment is given in time` FALSE (Date 1 6 2027) (Date 16 6 2027) EQUALS JUST FALSE

#ASSERT `o 21 r 19(1) the period for sending a copy of the bill of costs`'s `period length` EQUALS 2
-- notice received on 1 July 2027: 2 days after is 3 July 2027.
#ASSERT `o 21 r 19(1) the copy of the bill of costs is sent in time` (Date 3 7 2027) (Date 3 7 2027) EQUALS JUST TRUE
#ASSERT `o 21 r 19(1) the copy of the bill of costs is sent in time` (Date 4 7 2027) (Date 3 7 2027) EQUALS JUST FALSE
-- (2): no notice of intention to contest or not contest and no part taken: notice need not be given.
#ASSERT `o 21 r 19(2) notice need not be given to the party` FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 21 r 19(2) notice need not be given to the party` TRUE FALSE EQUALS NOTHING
#ASSERT `o 21 r 19(2) notice need not be given to the party` FALSE TRUE EQUALS NOTHING
-- (3): paragraph (2) does not apply where the assessment arose from a solicitor's own application under the Legal Profession Act.
#ASSERT `o 21 r 19(3) paragraph (2) applies` TRUE EQUALS JUST FALSE
#ASSERT `o 21 r 19(3) paragraph (2) applies` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§§ `Rule 20 -- form of bill of costs`
-- ---------------------------------------------------------------------------

#ASSERT `o 21 r 20(1) the bill of costs has the three separate sections` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 20(1) the bill of costs has the three separate sections` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 21 r 20(1) the bill of costs has the three separate sections` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 21 r 20(1) the bill of costs has the three separate sections` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 21 r 20(1) the bill of costs has the three separate sections` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 20(2) the costs are indicated as the rule requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 20(2) the costs are indicated as the rule requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 20(2) the costs are indicated as the rule requires` FALSE TRUE TRUE EQUALS JUST FALSE
-- (3) "if any": goods and services tax payable and set out: yes; payable and not set out: no; none payable: not covered.
#ASSERT `o 21 r 20(3) the bill of costs sets out the goods and services tax` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 20(3) the bill of costs sets out the goods and services tax` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 20(3) the bill of costs sets out the goods and services tax` FALSE FALSE EQUALS NOTHING
#ASSERT `o 21 r 20(4) the bill of costs is headed as the rule requires` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 20(4) the bill of costs is headed as the rule requires` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 20(4) the bill of costs is headed as the rule requires` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 21 r 20(5) the bill of costs is endorsed as the rule requires` TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 20(5) the bill of costs is endorsed as the rule requires` FALSE EQUALS JUST FALSE
-- (6): contentious business; (a) to (d) musts.
#ASSERT `o 21 r 20(6) the bill of costs for contentious business has the content the rule requires` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 20(6) the bill of costs for contentious business has the content the rule requires` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 20(6) the bill of costs for contentious business has the content the rule requires` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 21 r 20(6) the bill of costs for contentious business has the content the rule requires` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- (6)(e): the bill may also contain the lists of authorities cited.
#ASSERT `o 21 r 20(6)(e) the bill of costs may contain the lists of authorities cited` TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 20(6)(e) the bill of costs may contain the lists of authorities cited` FALSE EQUALS JUST FALSE
-- (6)(f): work done in connection with the negotiation of a settlement is work done in the cause or matter.
#ASSERT `o 21 r 20(6)(f) the work is work done in the cause or matter` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 20(6)(f) the work is work done in the cause or matter` TRUE FALSE EQUALS NOTHING
#ASSERT `o 21 r 20(6)(f) the work is work done in the cause or matter` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 21 r 20(6)(f) the work is work done in the cause or matter` FALSE FALSE EQUALS JUST FALSE

