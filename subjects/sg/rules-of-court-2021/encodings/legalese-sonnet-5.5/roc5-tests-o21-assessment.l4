-- ---------------------------------------------------------------------------

#ASSERT `o 21 r 21(1) the Registrar may disallow the costs of the party's attendance` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 21(1) the Registrar may disallow the costs of the party's attendance` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 21(1) the Registrar may disallow the costs of the party's attendance` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 21 r 21(1) the Registrar may disallow the costs of the party's attendance` FALSE TRUE TRUE EQUALS JUST FALSE
