#ASSERT `o 21 r 23(2)(a) the costs are presumed to have been reasonably incurred` FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 23(2)(b) the costs are presumed to have been reasonable in amount` TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 23(2)(b) the costs are presumed to have been reasonable in amount` FALSE EQUALS JUST FALSE
-- (c): unusual nature, unless the solicitor satisfies the Registrar that the client was informed.
#ASSERT `o 21 r 23(2)(c) the costs are presumed to have been unreasonably incurred` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 21 r 23(2)(c) the costs are presumed to have been unreasonably incurred` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 21 r 23(2)(c) the costs are presumed to have been unreasonably incurred` FALSE FALSE EQUALS JUST FALSE
-- (3): the client who lacked capacity or was a minor and had a litigation representative.
#ASSERT `o 21 r 23(3) references to the client are references to the litigation representative` `o 21 r 23(3)(a) a client who lacked capacity within the meaning of the Mental Capacity Act and was represented by a person acting as litigation representative` EQUALS JUST TRUE
#ASSERT `o 21 r 23(3) references to the client are references to the litigation representative` `o 21 r 23(3)(b) a client who was a minor and was represented by a person acting as litigation representative` EQUALS JUST TRUE
#ASSERT `o 21 r 23(3) references to the client are references to the litigation representative` `o 21 r 23(3) any other client` EQUALS NOTHING
#ASSERT `o 21 r 23(3)(a) the representative acts, where necessary, with the authority of the Court` `o 21 r 23(3)(a) a client who lacked capacity within the meaning of the Mental Capacity Act and was represented by a person acting as litigation representative` EQUALS JUST TRUE
#ASSERT `o 21 r 23(3)(a) the representative acts, where necessary, with the authority of the Court` `o 21 r 23(3)(b) a client who was a minor and was represented by a person acting as litigation representative` EQUALS NOTHING
-- (4), (5).
#ASSERT `o 21 r 23(4) delivery of a bill to the client precludes presenting a bill for a larger amount for assessment` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 23(4) delivery of a bill to the client precludes presenting a bill for a larger amount for assessment` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 21 r 23(4) delivery of a bill to the client precludes presenting a bill for a larger amount for assessment` FALSE FALSE EQUALS NOTHING
#ASSERT `o 21 r 23(5) the solicitor is entitled to the amount the Registrar allows` TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 23(5) the solicitor is entitled to the amount the Registrar allows` FALSE EQUALS NOTHING
-- Rule 24.
#ASSERT `o 21 r 24(1) this Rule applies to the assessment` TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 24(1) this Rule applies to the assessment` FALSE EQUALS NOTHING
-- (2), the first half: the same, for an assessment to which Rule 24 applies.
#ASSERT `o 21 r 24(2) the costs are assessed on the indemnity basis` TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 24(2) the costs are assessed on the indemnity basis` FALSE EQUALS NOTHING
#ASSERT `o 21 r 24(2) the costs are presumed to have been unreasonably incurred` TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 24(2) the costs are presumed to have been unreasonably incurred` FALSE EQUALS JUST FALSE

