#ASSERT `o 21 r 21(2) the Registrar may adjourn the assessment and direct the solicitor to send a copy of the bill` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 21(2) the Registrar may adjourn the assessment and direct the solicitor to send a copy of the bill` FALSE TRUE EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§§ `Rule 22 -- basis of assessment`
-- ---------------------------------------------------------------------------

-- (1)(a), (b) or (c) and nothing suggesting the indemnity basis: the standard basis.
#ASSERT `o 21 r 22(1) the basis on which the amount of costs is allowed` TRUE FALSE FALSE FALSE EQUALS JUST `o 21 r 22(2) the standard basis`
#ASSERT `o 21 r 22(1) the basis on which the amount of costs is allowed` FALSE TRUE FALSE FALSE EQUALS JUST `o 21 r 22(2) the standard basis`
#ASSERT `o 21 r 22(1) the basis on which the amount of costs is allowed` FALSE FALSE TRUE FALSE EQUALS JUST `o 21 r 22(2) the standard basis`
-- it appears appropriate to order the indemnity basis: not the standard basis; what the Court orders is not in the text.
#ASSERT `o 21 r 22(1) the basis on which the amount of costs is allowed` TRUE FALSE FALSE TRUE EQUALS NOTHING
-- none of (a), (b), (c): outside the paragraph.
#ASSERT `o 21 r 22(1) the basis on which the amount of costs is allowed` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `o 21 r 22(1) the amount of costs is the amount allowed after assessment on the standard basis` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 21 r 22(1) the amount of costs is the amount allowed after assessment on the standard basis` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 21 r 22(1) the amount of costs is the amount allowed after assessment on the standard basis` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 21 r 22(1) the amount of costs is the amount allowed after assessment on the standard basis` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (1), the indemnity basis (inputs: (a), (b), (c), it appears appropriate, the Court has ordered it).
-- The Court has ordered the indemnity basis: yes, whether or not (a), (b) or (c) is also met.
#ASSERT `o 21 r 22(1) the costs are assessed on the indemnity basis` TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 22(1) the costs are assessed on the indemnity basis` FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 22(1) the costs are assessed on the indemnity basis` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- It appears appropriate but the Court has not ordered it: the Rules do not say what the Court then does.
#ASSERT `o 21 r 22(1) the costs are assessed on the indemnity basis` TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `o 21 r 22(1) the costs are assessed on the indemnity basis` FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING
-- Nothing suggests the indemnity basis and (a), (b) or (c) is met: the text puts the costs on the standard basis.
#ASSERT `o 21 r 22(1) the costs are assessed on the indemnity basis` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 22(1) the costs are assessed on the indemnity basis` FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 22(1) the costs are assessed on the indemnity basis` FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- None of (a), (b), (c), no order, nothing suggesting it: outside the paragraph.
#ASSERT `o 21 r 22(1) the costs are assessed on the indemnity basis` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (2): standard basis.
#ASSERT `o 21 r 22(2) the amount is allowed on the standard basis` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 22(2) the amount is allowed on the standard basis` TRUE FALSE EQUALS NOTHING
#ASSERT `o 21 r 22(2) the amount is allowed on the standard basis` FALSE TRUE EQUALS NOTHING
#ASSERT `o 21 r 22 in whose favour the doubts of the Registrar are resolved` `o 21 r 22(2) the standard basis` EQUALS JUST `o 21 r 22 the paying party`
#ASSERT `o 21 r 22 in whose favour the doubts of the Registrar are resolved` `o 21 r 22(3) the indemnity basis` EQUALS JUST `o 21 r 22 the receiving party`
#ASSERT `o 21 r 22 in whose favour the doubts of the Registrar are resolved` `o 21 r 22 another basis` EQUALS NOTHING
#ASSERT `o 21 r 22(2) the basis is the standard basis` `o 21 r 22(2) the standard basis` EQUALS JUST TRUE
#ASSERT `o 21 r 22(2) the basis is the standard basis` `o 21 r 22(3) the indemnity basis` EQUALS JUST FALSE
-- (3): indemnity basis, all costs allowed except the unreasonable.
#ASSERT `o 21 r 22(3) the cost is allowed on the indemnity basis` FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 21 r 22(3) the cost is allowed on the indemnity basis` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 22(3) the cost is allowed on the indemnity basis` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 21 r 22(3) the basis is the indemnity basis` `o 21 r 22(3) the indemnity basis` EQUALS JUST TRUE
#ASSERT `o 21 r 22(3) the basis is the indemnity basis` `o 21 r 22(2) the standard basis` EQUALS JUST FALSE
-- (4): no basis, or another basis: standard.
#ASSERT `o 21 r 22(4) the basis on which the costs are to be assessed` `o 21 r 22(4) it indicates no basis` EQUALS JUST `o 21 r 22(2) the standard basis`
#ASSERT `o 21 r 22(4) the basis on which the costs are to be assessed` `o 21 r 22(4) it indicates a basis other than the standard basis or the indemnity basis` EQUALS JUST `o 21 r 22(2) the standard basis`
#ASSERT `o 21 r 22(4) the basis on which the costs are to be assessed` `o 21 r 22(4) it indicates the indemnity basis` EQUALS NOTHING
#ASSERT `o 21 r 22(4) the costs are assessed on the standard basis` `o 21 r 22(4) it indicates no basis` EQUALS JUST TRUE
#ASSERT `o 21 r 22(4) the costs are assessed on the standard basis` `o 21 r 22(4) it indicates a basis other than the standard basis or the indemnity basis` EQUALS JUST TRUE
#ASSERT `o 21 r 22(4) the costs are assessed on the standard basis` `o 21 r 22(4) it indicates the standard basis` EQUALS NOTHING
-- (4), the indemnity basis: an order that indicates it puts the costs on it; the other orders do not.
#ASSERT `o 21 r 22(4) the costs are assessed on the indemnity basis` `o 21 r 22(4) it indicates the indemnity basis` EQUALS JUST TRUE
#ASSERT `o 21 r 22(4) the costs are assessed on the indemnity basis` `o 21 r 22(4) it indicates no basis` EQUALS JUST FALSE
#ASSERT `o 21 r 22(4) the costs are assessed on the indemnity basis` `o 21 r 22(4) it indicates a basis other than the standard basis or the indemnity basis` EQUALS JUST FALSE
#ASSERT `o 21 r 22(4) the costs are assessed on the indemnity basis` `o 21 r 22(4) it indicates the standard basis` EQUALS JUST FALSE
-- (5): General Division action within State Court jurisdiction: not entitled to more, unless otherwise ordered.
#ASSERT `o 21 r 22(5) the claimant is entitled to more costs than in a State Court` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 22(5) the claimant is entitled to more costs than in a State Court` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `o 21 r 22(5) the claimant is entitled to more costs than in a State Court` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `o 21 r 22(5) the claimant is entitled to more costs than in a State Court` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `o 21 r 22(5) the most costs the claimant may recover` 10000 6000 TRUE TRUE FALSE EQUALS JUST 6000
#ASSERT `o 21 r 22(5) the most costs the claimant may recover` 5000 6000 TRUE TRUE FALSE EQUALS JUST 5000
#ASSERT `o 21 r 22(5) the most costs the claimant may recover` 6000 6000 TRUE TRUE FALSE EQUALS JUST 6000
#ASSERT `o 21 r 22(5) the most costs the claimant may recover` 10000 6000 TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `o 21 r 22(5) the most costs the claimant may recover` 10000 6000 FALSE TRUE FALSE EQUALS NOTHING

