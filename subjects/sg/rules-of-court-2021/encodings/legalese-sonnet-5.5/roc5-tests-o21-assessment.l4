-- ---------------------------------------------------------------------------

#ASSERT `o 21 r 23(1) this Rule applies to the assessment` TRUE EQUALS JUST TRUE
#ASSERT `o 21 r 23(1) this Rule applies to the assessment` FALSE EQUALS NOTHING
