IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc11-order-60`

-- TESTS for Order 60 (reciprocal enforcement of judgments).  Every expected value is written from the text of
-- the rule, beside the assertion, before the code was run.  The "last day" inputs are made-up dates: the
-- merged file replaces them with calls to roc1's O 3 r 3.

-- ---------------------------------------------------------------------------
§ `Order 60 rule 1 -- definition`
-- ---------------------------------------------------------------------------
#ASSERT `o 60 r 1 the Act` EQUALS "the Reciprocal Enforcement of Foreign Judgments Act 1959"
#ASSERT `o 60 r 1 a reference to a section is a reference to a section in the Act` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 60 r 1 a reference to a section is a reference to a section in the Act` FALSE FALSE EQUALS NOTHING
#ASSERT `o 60 r 1 a reference to a section is a reference to a section in the Act` TRUE TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 60 rule 1A -- who may exercise the powers`
-- ---------------------------------------------------------------------------
-- "may be exercised by a Judge in chambers and the Registrar".
#ASSERT `o 60 r 1A the power conferred on the General Division by the Act may be exercised by the person` `A Judge` TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 1A the power conferred on the General Division by the Act may be exercised by the person` `The Registrar` FALSE EQUALS JUST TRUE
-- A Judge not in chambers, a District Judge and a Magistrate are not named.
#ASSERT `o 60 r 1A the power conferred on the General Division by the Act may be exercised by the person` `A Judge` FALSE EQUALS NOTHING
#ASSERT `o 60 r 1A the power conferred on the General Division by the Act may be exercised by the person` `A District Judge` TRUE EQUALS NOTHING
#ASSERT `o 60 r 1A the power conferred on the General Division by the Act may be exercised by the person` `A Magistrate` TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 60 rule 2 -- application for registration`
-- ---------------------------------------------------------------------------
#ASSERT `o 60 r 2 the application for registration is made in the way the Rule requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- Notice was given: a bare "without notice" not done.
#ASSERT `o 60 r 2 the application for registration is made in the way the Rule requires` TRUE TRUE TRUE FALSE EQUALS NOTHING
-- Not by originating application.
#ASSERT `o 60 r 2 the application for registration is made in the way the Rule requires` TRUE TRUE FALSE TRUE EQUALS NOTHING
-- Not an application under section 4, or a judgment outside Part 1: the Rule does not reach it.
#ASSERT `o 60 r 2 the application for registration is made in the way the Rule requires` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `o 60 r 2 the application for registration is made in the way the Rule requires` TRUE FALSE TRUE TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 60 rule 3 -- evidence in support`
-- ---------------------------------------------------------------------------
-- Fields: (a) exhibits; (a) not in English; (a) translation; (b); (c)(i); (c)(ii) not satisfied; (c)(ii) amount; (c)(iii); (d) interest due; (d) amount.
-- An English judgment, wholly unsatisfied, with interest due and its amount given: every item stated.
`o 60 r 3(1) fixture full affidavit` MEANS `o 60 r 3(1) affidavit` OF TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE
-- A judgment not in English with its translation, partly satisfied (amount given), no interest due.
`o 60 r 3(1) fixture translated partly satisfied no interest` MEANS `o 60 r 3(1) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, FALSE, FALSE
-- Not in English and no translation; neither form of (c)(ii); interest due but no amount.
`o 60 r 3(1) fixture three gaps` MEANS `o 60 r 3(1) affidavit` OF TRUE, TRUE, FALSE, TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, FALSE
-- Nothing stated at all, English, no interest due.
`o 60 r 3(1) fixture empty` MEANS `o 60 r 3(1) affidavit` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
#ASSERT count (`o 60 r 3(1) the matters the affidavit has not yet stated` `o 60 r 3(1) fixture full affidavit`) EQUALS 0
#ASSERT count (`o 60 r 3(1) the matters the affidavit has not yet stated` `o 60 r 3(1) fixture translated partly satisfied no interest`) EQUALS 0
#ASSERT count (`o 60 r 3(1) the matters the affidavit has not yet stated` `o 60 r 3(1) fixture three gaps`) EQUALS 3
#ASSERT elem "(a) a translation of the judgment certified by a notary public or authenticated by affidavit" (`o 60 r 3(1) the matters the affidavit has not yet stated` `o 60 r 3(1) fixture three gaps`)
#ASSERT elem "(c)(ii) either that at the date of the application the judgment has not been satisfied, or the amount in respect of which it remains unsatisfied" (`o 60 r 3(1) the matters the affidavit has not yet stated` `o 60 r 3(1) fixture three gaps`)
#ASSERT elem "(d) the amount of the interest which by the law of the country of the original court has become due under the judgment up to the time of registration" (`o 60 r 3(1) the matters the affidavit has not yet stated` `o 60 r 3(1) fixture three gaps`)
-- Empty: (a) exhibit, (b), (c)(i), (c)(ii), (c)(iii): five; no translation needed (English), no interest due.
#ASSERT count (`o 60 r 3(1) the matters the affidavit has not yet stated` `o 60 r 3(1) fixture empty`) EQUALS 5
#ASSERT `o 60 r 3(1) the affidavit supporting the application states what the Rule requires` `o 60 r 3(1) fixture full affidavit` EQUALS JUST TRUE
#ASSERT `o 60 r 3(1) the affidavit supporting the application states what the Rule requires` `o 60 r 3(1) fixture translated partly satisfied no interest` EQUALS JUST TRUE
#ASSERT `o 60 r 3(1) the affidavit supporting the application states what the Rule requires` `o 60 r 3(1) fixture three gaps` EQUALS NOTHING
#ASSERT `o 60 r 3(1) the affidavit supporting the application states what the Rule requires` `o 60 r 3(1) fixture empty` EQUALS NOTHING
-- (2): the duty arises where the judgment is in respect of different matters and some, but not all, could be registered.
#ASSERT `o 60 r 3(2) the duty to state the provisions arises` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 3(2) the duty to state the provisions arises` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 60 r 3(2) the duty to state the provisions arises` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 60 r 3(2) the affidavit states the provisions in respect of which registration is sought` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 3(2) the affidavit states the provisions in respect of which registration is sought` TRUE TRUE FALSE EQUALS NOTHING
-- The duty does not arise, so compliance is not asked.
#ASSERT `o 60 r 3(2) the affidavit states the provisions in respect of which registration is sought` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `o 60 r 3(2) the affidavit states the provisions in respect of which registration is sought` TRUE FALSE TRUE EQUALS NOTHING
-- (3): the other evidence depends on the extending Order, which is outside the text.
#ASSERT `o 60 r 3(3) the affidavit is accompanied by the other evidence the Rule requires` TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 3(3) the affidavit is accompanied by the other evidence the Rule requires` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 60 rule 4 -- security for costs`
-- ---------------------------------------------------------------------------
#ASSERT `o 60 r 4 the Court may order the judgment creditor to give security for costs` FALSE EQUALS JUST TRUE
-- "Except as otherwise provided by any relevant Order under the Act": the grant is displaced and the Order is outside the text.
#ASSERT `o 60 r 4 the Court may order the judgment creditor to give security for costs` TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 60 rule 5 -- order for registration`
-- ---------------------------------------------------------------------------
#ASSERT `o 60 r 5(1) the form of the order giving permission to register` EQUALS "88"
#ASSERT `o 60 r 5(1) the order giving permission to register is drawn up and served as the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 5(1) the order giving permission to register is drawn up and served as the Rule requires` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `o 60 r 5(1) the order giving permission to register is drawn up and served as the Rule requires` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `o 60 r 5(1) the order giving permission to register is drawn up and served as the Rule requires` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 60 r 5(2) the order states the period and contains the notification` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 5(2) the order states the period and contains the notification` TRUE FALSE EQUALS NOTHING
#ASSERT `o 60 r 5(2) the order states the period and contains the notification` FALSE TRUE EQUALS NOTHING
-- (3): the extension is applied for while it remains competent for any party to apply to set aside.
#ASSERT `o 60 r 5(3) the Court may extend the period for applying to set aside the registration` TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 5(3) the Court may extend the period for applying to set aside the registration` FALSE EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§ `Order 60 rule 6 -- register of judgments`
-- ---------------------------------------------------------------------------
#ASSERT `o 60 r 6(1) the register kept in the Registry contains the judgment` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 6(1) the register kept in the Registry contains the judgment` TRUE FALSE EQUALS NOTHING
#ASSERT `o 60 r 6(1) the register kept in the Registry contains the judgment` FALSE FALSE EQUALS NOTHING
#ASSERT `o 60 r 6(2) the register includes particulars of the enforcement order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 6(2) the register includes particulars of the enforcement order` TRUE FALSE EQUALS NOTHING
#ASSERT `o 60 r 6(2) the register includes particulars of the enforcement order` FALSE FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 60 rule 7 -- notice of registration`
-- ---------------------------------------------------------------------------
-- Served on the judgment debtor personally.
#ASSERT `o 60 r 7(1) the notice of registration is served as the Rule requires` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- The Court ordered service otherwise and it was served that way.
#ASSERT `o 60 r 7(1) the notice of registration is served as the Rule requires` TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- Not personal, no order.
#ASSERT `o 60 r 7(1) the notice of registration is served as the Rule requires` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- An order for another way, but not served that way.
#ASSERT `o 60 r 7(1) the notice of registration is served as the Rule requires` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
-- Not served on the judgment debtor.
#ASSERT `o 60 r 7(1) the notice of registration is served as the Rule requires` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
-- Served out of Singapore: governed by paragraph (2) and Order 8, in another part.
#ASSERT `o 60 r 7(1) the notice of registration is served as the Rule requires` TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `o 60 r 7(2) permission is needed to serve the notice out of Singapore` TRUE EQUALS JUST FALSE
#ASSERT `o 60 r 7(2) permission is needed to serve the notice out of Singapore` FALSE EQUALS NOTHING
#ASSERT `o 60 r 7(2) a rule of Order 8 applies to the notice` TRUE "2" EQUALS JUST TRUE
#ASSERT `o 60 r 7(2) a rule of Order 8 applies to the notice` TRUE "3" EQUALS JUST TRUE
#ASSERT `o 60 r 7(2) a rule of Order 8 applies to the notice` TRUE "7" EQUALS JUST TRUE
#ASSERT `o 60 r 7(2) a rule of Order 8 applies to the notice` TRUE "8" EQUALS JUST TRUE
#ASSERT `o 60 r 7(2) a rule of Order 8 applies to the notice` TRUE "5" EQUALS NOTHING
#ASSERT `o 60 r 7(2) a rule of Order 8 applies to the notice` FALSE "2" EQUALS NOTHING
#ASSERT count (`o 60 r 7(3) the matters the notice has not yet stated` (`o 60 r 7(3) notice of registration` OF TRUE, TRUE, TRUE, TRUE)) EQUALS 0
#ASSERT count (`o 60 r 7(3) the matters the notice has not yet stated` (`o 60 r 7(3) notice of registration` OF TRUE, FALSE, FALSE, TRUE)) EQUALS 2
#ASSERT elem "(c) the right of the judgment debtor to apply to have the registration set aside" (`o 60 r 7(3) the matters the notice has not yet stated` (`o 60 r 7(3) notice of registration` OF TRUE, FALSE, FALSE, TRUE))
#ASSERT count (`o 60 r 7(3) the matters the notice has not yet stated` (`o 60 r 7(3) notice of registration` OF FALSE, FALSE, FALSE, FALSE)) EQUALS 4
#ASSERT `o 60 r 7(3) the notice of registration states what the Rule requires` (`o 60 r 7(3) notice of registration` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 60 r 7(3) the notice of registration states what the Rule requires` (`o 60 r 7(3) notice of registration` OF TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 60 rule 8 -- endorsement of service`
-- ---------------------------------------------------------------------------
#ASSERT `o 60 r 8(1) the period for endorsing the notice`'s `period length` EQUALS 3
#ASSERT `o 60 r 8(1) the period for endorsing the notice`'s `period unit` EQUALS Days
-- The 3-day last day is 16 November 2026 (made up); a longer period the Court allowed ends 20 November 2026.
#ASSERT `o 60 r 8(1) the last day for endorsing the notice` (Date 16 11 2026) NOTHING EQUALS Date 16 11 2026
#ASSERT `o 60 r 8(1) the last day for endorsing the notice` (Date 16 11 2026) (JUST (Date 20 11 2026)) EQUALS Date 20 11 2026
#ASSERT `o 60 r 8(1) the last day for endorsing the notice` (Date 16 11 2026) (JUST (Date 14 11 2026)) EQUALS Date 16 11 2026
-- Endorsed on the last day and the day before: in time.
#ASSERT `o 60 r 8(1) the notice is endorsed in time` (JUST (Date 16 11 2026)) (Date 17 11 2026) (Date 16 11 2026) NOTHING EQUALS JUST TRUE
#ASSERT `o 60 r 8(1) the notice is endorsed in time` (JUST (Date 13 11 2026)) (Date 17 11 2026) (Date 16 11 2026) NOTHING EQUALS JUST TRUE
-- The day after the last day: out of time.
#ASSERT `o 60 r 8(1) the notice is endorsed in time` (JUST (Date 17 11 2026)) (Date 17 11 2026) (Date 16 11 2026) NOTHING EQUALS JUST FALSE
-- After the 3 days but within the longer period the Court allowed; and after both.
#ASSERT `o 60 r 8(1) the notice is endorsed in time` (JUST (Date 19 11 2026)) (Date 20 11 2026) (Date 16 11 2026) (JUST (Date 20 11 2026)) EQUALS JUST TRUE
#ASSERT `o 60 r 8(1) the notice is endorsed in time` (JUST (Date 21 11 2026)) (Date 22 11 2026) (Date 16 11 2026) (JUST (Date 20 11 2026)) EQUALS JUST FALSE
-- Not endorsed yet: while the time runs the answer is not yet; afterwards the Rule says no.
#ASSERT `o 60 r 8(1) the notice is endorsed in time` NOTHING (Date 16 11 2026) (Date 16 11 2026) NOTHING EQUALS NOTHING
#ASSERT `o 60 r 8(1) the notice is endorsed in time` NOTHING (Date 17 11 2026) (Date 16 11 2026) NOTHING EQUALS JUST FALSE
#ASSERT `o 60 r 8(1) the notice is endorsed in time` NOTHING (Date 18 11 2026) (Date 16 11 2026) (JUST (Date 20 11 2026)) EQUALS NOTHING
#ASSERT `o 60 r 8(1) the Court may allow a longer period for endorsing the notice` TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 8(1) the Court may allow a longer period for endorsing the notice` FALSE EQUALS NOTHING
#ASSERT `o 60 r 8(1) the endorsement is what the Rule requires` (`o 60 r 8(1) endorsement` OF TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 60 r 8(1) the endorsement is what the Rule requires` (`o 60 r 8(1) endorsement` OF FALSE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 60 r 8(1) the endorsement is what the Rule requires` (`o 60 r 8(1) endorsement` OF TRUE, FALSE, TRUE) EQUALS NOTHING
#ASSERT `o 60 r 8(1) the endorsement is what the Rule requires` (`o 60 r 8(1) endorsement` OF TRUE, TRUE, FALSE) EQUALS NOTHING
-- The consequence limb: not endorsed in time, the judgment creditor may not apply without permission.
#ASSERT `o 60 r 8(1) the judgment creditor may apply for an enforcement order without the permission of the Court` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `o 60 r 8(1) the judgment creditor may apply for an enforcement order without the permission of the Court` (JUST TRUE) EQUALS NOTHING
#ASSERT `o 60 r 8(1) the judgment creditor may apply for an enforcement order without the permission of the Court` NOTHING EQUALS NOTHING
#ASSERT `o 60 r 8(2) the affidavit of service states the date of endorsement` TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 8(2) the affidavit of service states the date of endorsement` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 60 rule 9 -- application to set aside registration`
-- ---------------------------------------------------------------------------
#ASSERT `o 60 r 9(1) the application to set aside the registration is made as the Rule requires` Summons TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 9(1) the application to set aside the registration is made as the Rule requires` Summons FALSE EQUALS NOTHING
#ASSERT `o 60 r 9(1) the application to set aside the registration is made as the Rule requires` `Originating application` TRUE EQUALS NOTHING
#ASSERT `o 60 r 9(2) the Court may order the issue to be tried as an issue in an action is tried` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 9(2) the Court may order the issue to be tried as an issue in an action is tried` TRUE FALSE EQUALS NOTHING
#ASSERT `o 60 r 9(2) the Court may order the issue to be tried as an issue in an action is tried` FALSE TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 60 rule 10 -- issuance of enforcement order`
-- ---------------------------------------------------------------------------
-- (1): the specified period expires on 20 November 2026.
#ASSERT `o 60 r 10(1) an enforcement order cannot yet be issued because the specified period has not expired` TRUE (Date 20 11 2026) (Date 19 11 2026) EQUALS JUST TRUE
#ASSERT `o 60 r 10(1) an enforcement order cannot yet be issued because the specified period has not expired` TRUE (Date 20 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `o 60 r 10(1) an enforcement order cannot yet be issued because the specified period has not expired` TRUE (Date 20 11 2026) (Date 21 11 2026) EQUALS JUST FALSE
-- A judgment not registered under the Act: the bar speaks of "a judgment registered under the Act".
#ASSERT `o 60 r 10(1) an enforcement order cannot yet be issued because the specified period has not expired` FALSE (Date 20 11 2026) (Date 19 11 2026) EQUALS JUST FALSE
-- (2): an application to set aside is made and not yet finally determined.
#ASSERT `o 60 r 10(2) an enforcement order cannot yet be issued because the application to set aside is not finally determined` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 60 r 10(2) an enforcement order cannot yet be issued because the application to set aside is not finally determined` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 60 r 10(2) an enforcement order cannot yet be issued because the application to set aside is not finally determined` FALSE FALSE EQUALS JUST FALSE
-- (3).
#ASSERT `o 60 r 10(3) the party applying for an enforcement order has produced what the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 10(3) the party applying for an enforcement order has produced what the Rule requires` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 60 r 10(3) the party applying for an enforcement order has produced what the Rule requires` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 60 r 10(3) the party applying for an enforcement order has produced what the Rule requires` FALSE FALSE FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 60 rule 11 -- determination of certain questions`
-- ---------------------------------------------------------------------------
#ASSERT `o 60 r 11 the question is determined in accordance with the extending Order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 60 r 11 the question is determined in accordance with the extending Order` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 11 the question is determined in accordance with the extending Order` FALSE FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 60 rule 12 -- rules subject to orders of the President`
-- ---------------------------------------------------------------------------
#ASSERT `o 60 r 12 the rule has effect subject to the provision of the extending Order` "1" TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 12 the rule has effect subject to the provision of the extending Order` "1A" TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 12 the rule has effect subject to the provision of the extending Order` "11" TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 12 the rule has effect subject to the provision of the extending Order` "11" FALSE EQUALS JUST FALSE
#ASSERT `o 60 r 12 the rule has effect subject to the provision of the extending Order` "5" FALSE EQUALS JUST FALSE
-- Rules 12 and 13 are outside "Rules 1 to 11".
#ASSERT `o 60 r 12 the rule has effect subject to the provision of the extending Order` "12" TRUE EQUALS NOTHING
#ASSERT `o 60 r 12 the rule has effect subject to the provision of the extending Order` "13" TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 60 rule 13 -- certified copy of a General Division judgment`
-- ---------------------------------------------------------------------------
#ASSERT `o 60 r 13(1) the application for certified copies is made in the way the Rule requires` TRUE Summons TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 60 r 13(1) the application for certified copies is made in the way the Rule requires` TRUE Summons FALSE TRUE EQUALS NOTHING
#ASSERT `o 60 r 13(1) the application for certified copies is made in the way the Rule requires` TRUE Summons TRUE FALSE EQUALS NOTHING
#ASSERT `o 60 r 13(1) the application for certified copies is made in the way the Rule requires` TRUE `Originating application` TRUE TRUE EQUALS NOTHING
#ASSERT `o 60 r 13(1) the application for certified copies is made in the way the Rule requires` FALSE Summons TRUE TRUE EQUALS NOTHING
-- (2): fields (a); (b) claim; (b) service or notice; (b) there are pleadings; (b) pleadings; (b) grounds; (c) whether objected; (c) defendant objected; (c) grounds; (d); (e) time; (e) appeal; (f).
`o 60 r 13(2) fixture all covered with pleadings and an objection` MEANS `o 60 r 13(2) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE
`o 60 r 13(2) fixture all covered with no pleadings and no objection` MEANS `o 60 r 13(2) affidavit` OF TRUE, TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE
`o 60 r 13(2) fixture pleadings not annexed and objection grounds missing` MEANS `o 60 r 13(2) affidavit` OF TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE
`o 60 r 13(2) fixture nothing` MEANS `o 60 r 13(2) affidavit` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
#ASSERT count (`o 60 r 13(2) the matters the affidavit has not yet covered` `o 60 r 13(2) fixture all covered with pleadings and an objection`) EQUALS 0
#ASSERT count (`o 60 r 13(2) the matters the affidavit has not yet covered` `o 60 r 13(2) fixture all covered with no pleadings and no objection`) EQUALS 0
#ASSERT count (`o 60 r 13(2) the matters the affidavit has not yet covered` `o 60 r 13(2) fixture pleadings not annexed and objection grounds missing`) EQUALS 2
#ASSERT elem "(b) annexed: copies of the pleadings" (`o 60 r 13(2) the matters the affidavit has not yet covered` `o 60 r 13(2) fixture pleadings not annexed and objection grounds missing`)
#ASSERT elem "(c) on what grounds the defendant objected" (`o 60 r 13(2) the matters the affidavit has not yet covered` `o 60 r 13(2) fixture pleadings not annexed and objection grounds missing`)
-- Nothing stated: (a), (b) four... the pleadings are absent so not required, and no objection so no grounds: (a); (b) claim, service, grounds; (c) whether; (d); (e) two; (f) = 9.
#ASSERT count (`o 60 r 13(2) the matters the affidavit has not yet covered` `o 60 r 13(2) fixture nothing`) EQUALS 9
#ASSERT `o 60 r 13(2) the affidavit supporting the application covers what the Rule requires` `o 60 r 13(2) fixture all covered with pleadings and an objection` EQUALS JUST TRUE
#ASSERT `o 60 r 13(2) the affidavit supporting the application covers what the Rule requires` `o 60 r 13(2) fixture all covered with no pleadings and no objection` EQUALS JUST TRUE
#ASSERT `o 60 r 13(2) the affidavit supporting the application covers what the Rule requires` `o 60 r 13(2) fixture nothing` EQUALS NOTHING
-- (3): fields sealed; claim annexed; Form 90 certificate; (a); (b) objections made; (b) states them; (c) pleadings served; (c) states them; (d); (e); (f); (g); (h).
`o 60 r 13(3) fixture complete with objections and pleadings` MEANS `o 60 r 13(3) certified copies and certificate` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE
`o 60 r 13(3) fixture complete with no objections and no pleadings` MEANS `o 60 r 13(3) certified copies and certificate` OF TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE
`o 60 r 13(3) fixture unsealed and objections not stated` MEANS `o 60 r 13(3) certified copies and certificate` OF FALSE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE
`o 60 r 13(3) fixture nothing` MEANS `o 60 r 13(3) certified copies and certificate` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
#ASSERT count (`o 60 r 13(3) the matters the copies and certificate have not yet satisfied` `o 60 r 13(3) fixture complete with objections and pleadings`) EQUALS 0
#ASSERT count (`o 60 r 13(3) the matters the copies and certificate have not yet satisfied` `o 60 r 13(3) fixture complete with no objections and no pleadings`) EQUALS 0
#ASSERT count (`o 60 r 13(3) the matters the copies and certificate have not yet satisfied` `o 60 r 13(3) fixture unsealed and objections not stated`) EQUALS 2
#ASSERT elem "the certified copies sealed with the seal of the Supreme Court" (`o 60 r 13(3) the matters the copies and certificate have not yet satisfied` `o 60 r 13(3) fixture unsealed and objections not stated`)
#ASSERT elem "(b) what objections were made to the jurisdiction of the court in Singapore" (`o 60 r 13(3) the matters the copies and certificate have not yet satisfied` `o 60 r 13(3) fixture unsealed and objections not stated`)
-- Nothing: sealed, annexed, certificate, (a), (d), (e), (f), (g), (h) = 9; (b) and (c) not required (no objections or pleadings).
#ASSERT count (`o 60 r 13(3) the matters the copies and certificate have not yet satisfied` `o 60 r 13(3) fixture nothing`) EQUALS 9
#ASSERT `o 60 r 13(3) the certified copies and certificate are what the Rule requires` `o 60 r 13(3) fixture complete with objections and pleadings` EQUALS JUST TRUE
#ASSERT `o 60 r 13(3) the certified copies and certificate are what the Rule requires` `o 60 r 13(3) fixture complete with no objections and no pleadings` EQUALS JUST TRUE
#ASSERT `o 60 r 13(3) the certified copies and certificate are what the Rule requires` `o 60 r 13(3) fixture unsealed and objections not stated` EQUALS NOTHING
