#ASSERT `o 43 r 4(1) the action is stayed as against the defendant` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 43 r 4(1) the action is stayed as against the defendant` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 43 r 4(1)(a) the cap on the sum recoverable from another defendant applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 43 r 4(1)(a) the cap on the sum recoverable from another defendant applies` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 43 r 4(1)(a) the cap on the sum recoverable from another defendant applies` TRUE FALSE EQUALS JUST FALSE
-- damages 10,000; 3,000 paid in by the defendant whose stay arose: at most 7,000 from another
#ASSERT `o 43 r 4(1)(a) the most that is recoverable from another defendant by way of damages` TRUE 10000 3000 EQUALS JUST 7000
#ASSERT `o 43 r 4(1)(a) the most that is recoverable from another defendant by way of damages` TRUE 3000 3000 EQUALS JUST 0
#ASSERT `o 43 r 4(1)(a) the most that is recoverable from another defendant by way of damages` TRUE 2000 3000 EQUALS JUST 0
#ASSERT `o 43 r 4(1)(a) the most that is recoverable from another defendant by way of damages` FALSE 10000 3000 EQUALS NOTHING
-- (b): damages not greater than the amount paid in and no reasonable ground -> the bar holds
#ASSERT `o 43 r 4(1)(b) the claimant is entitled to the claimant's costs against the other defendant after the payment into Court` TRUE TRUE 3000 3000 FALSE EQUALS JUST FALSE
#ASSERT `o 43 r 4(1)(b) the claimant is entitled to the claimant's costs against the other defendant after the payment into Court` TRUE TRUE 2000 3000 FALSE EQUALS JUST FALSE
-- damages greater than the amount paid in: the bar is lifted and grants nothing
#ASSERT `o 43 r 4(1)(b) the claimant is entitled to the claimant's costs against the other defendant after the payment into Court` TRUE TRUE 3001 3000 FALSE EQUALS NOTHING
-- the Judge's opinion lifts the bar
#ASSERT `o 43 r 4(1)(b) the claimant is entitled to the claimant's costs against the other defendant after the payment into Court` TRUE TRUE 2000 3000 TRUE EQUALS NOTHING
-- costs before the payment into Court, or no stay: outside the bar
#ASSERT `o 43 r 4(1)(b) the claimant is entitled to the claimant's costs against the other defendant after the payment into Court` TRUE FALSE 2000 3000 FALSE EQUALS NOTHING
#ASSERT `o 43 r 4(1)(b) the claimant is entitled to the claimant's costs against the other defendant after the payment into Court` FALSE TRUE 2000 3000 FALSE EQUALS NOTHING
