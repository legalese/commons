#ASSERT `Under Order 15, rule 11(8), may I apply for a certified transcript of the official record of the hearing` TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 11(8), may I apply for a certified transcript of the official record of the hearing` FALSE EQUALS JUST FALSE

-- Under Order 15, rule 11(9), may I claim the cost of a certified transcript as an item of disbursement?
#ASSERT `Under Order 15, rule 11(9), may I claim the cost of a certified transcript as an item of disbursement` FALSE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 11(9), may I claim the cost of a certified transcript as an item of disbursement` TRUE EQUALS JUST FALSE -- "unless otherwise ordered by the Court"

-- Order 15, rule 12
-- Under Order 15, rule 12(2), am I entitled to a copy of the Court's decision?
#ASSERT `Under Order 15, rule 12(2), am I entitled to a copy of the Court's decision` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 12(2), am I entitled to a copy of the Court's decision` TRUE FALSE EQUALS JUST FALSE -- charges not paid
#ASSERT `Under Order 15, rule 12(2), am I entitled to a copy of the Court's decision` FALSE TRUE EQUALS NOTHING -- an oral decision

-- Order 15, rule 15
-- Under Order 15, rule 15(4), did I apply for directions on the assessment of damages in time?
#ASSERT `Under Order 15, rule 15(4), did I apply for directions on the assessment of damages in time` (Date 5 12 2025) (Date 5 12 2025) EQUALS JUST TRUE -- judgment on 5 November 2025: one month ends 5 December 2025
#ASSERT `Under Order 15, rule 15(4), did I apply for directions on the assessment of damages in time` (Date 6 12 2025) (Date 5 12 2025) EQUALS JUST FALSE

-- Under Order 15, rule 15(5), did I serve my notice of appointment for the assessment of damages in time?
#ASSERT `Under Order 15, rule 15(5), did I serve my notice of appointment for the assessment of damages in time` (Date 19 12 2025) (Date 19 12 2025) EQUALS JUST TRUE -- filed on 5 December 2025: 14 days end on 19 December
#ASSERT `Under Order 15, rule 15(5), did I serve my notice of appointment for the assessment of damages in time` (Date 20 12 2025) (Date 19 12 2025) EQUALS JUST FALSE

-- Order 15, rule 16
-- Under Order 15, rule 16(3), may my affidavit of evidence-in-chief be used?
#ASSERT `Under Order 15, rule 16(3), may my affidavit of evidence-in-chief be used` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under Order 15, rule 16(3), may my affidavit of evidence-in-chief be used` FALSE TRUE EQUALS NOTHING -- parties otherwise agree

-- Under Order 15, rule 16(6), did I give my notice of objection to the other side's affidavits in time?
#ASSERT `Under Order 15, rule 16(6), did I give my notice of objection to the other side's affidavits in time` TRUE (Date 3 11 2025) (Date 3 11 2025) EQUALS JUST TRUE -- first hearing date 1 December 2025: the 28 days end on 3 November
#ASSERT `Under Order 15, rule 16(6), did I give my notice of objection to the other side's affidavits in time` TRUE (Date 4 11 2025) (Date 3 11 2025) EQUALS JUST FALSE

-- Order 15, rule 19
-- Under Order 15, rule 19(1), is my affidavit in the form the Rule requires?
#ASSERT `Under Order 15, rule 19(1), is my affidavit in the form the Rule requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 19(1), is my affidavit in the form the Rule requires` TRUE FALSE EQUALS JUST FALSE

-- Order 15, rule 20
-- Under Order 15, rule 20, may I make an affidavit?
#ASSERT `Under Order 15, rule 20, may I make an affidavit` TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 20, may I make an affidavit` FALSE EQUALS JUST FALSE

-- Order 15, rule 25
-- Under Order 15, rule 25(2), may my affidavit contain this matter?
#ASSERT `Under Order 15, rule 25(2), may my affidavit contain this matter` TRUE FALSE FALSE EQUALS JUST FALSE -- vulgar or insulting words not in issue
#ASSERT `Under Order 15, rule 25(2), may my affidavit contain this matter` TRUE TRUE FALSE EQUALS NOTHING -- vulgar words that are in issue in the action: paragraph (2) does not forbid them, nor does it say they are allowed

-- Order 15, rule 26
-- Under Order 15, rule 26(1), may I alter my affidavit?
#ASSERT `Under Order 15, rule 26(1), may I alter my affidavit` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 26(1), may I alter my affidavit` TRUE FALSE FALSE EQUALS JUST FALSE -- not re-affirmed
#ASSERT `Under Order 15, rule 26(1), may I alter my affidavit` TRUE TRUE TRUE EQUALS NOTHING -- already filed: outside "affirmed but not filed"

-- Order 15, rule 27
-- Under Order 15, rule 27(1), must I annex a copy of the document my affidavit refers to?
#ASSERT `Under Order 15, rule 27(1), must I annex a copy of the document my affidavit refers to` TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 27(1), must I annex a copy of the document my affidavit refers to` FALSE EQUALS JUST FALSE

-- Order 15, rule 29
-- Under Order 15, rule 29, must I give notice of my intention to use an affidavit filed in previous proceedings and serve it on every other party?
#ASSERT `Under Order 15, rule 29, must I give notice of my intention to use an affidavit filed in previous proceedings and serve it on every other party` TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 29, must I give notice of my intention to use an affidavit filed in previous proceedings and serve it on every other party` FALSE EQUALS NOTHING

-- ===== Order 16 -- Withdrawal and discontinuance =====

-- Order 16, rule 1
-- Under Order 16, rule 1, may I withdraw my notice of intention to contest or not contest?
#ASSERT `Under Order 16, rule 1, may I withdraw my notice of intention to contest or not contest` TRUE TRUE EQUALS JUST TRUE -- filed, with permission: "may withdraw ... with the permission of the Court"
#ASSERT `Under Order 16, rule 1, may I withdraw my notice of intention to contest or not contest` TRUE FALSE EQUALS NOTHING -- filed, no permission: the rule is silent

-- Order 16, rule 2
-- Under Order 16, rule 2(1), may I, as the claimant, discontinue the action or withdraw a claim without the permission of the Court?
#ASSERT `Under Order 16, rule 2(1), may I, as the claimant, discontinue the action or withdraw a claim without the permission of the Court` TRUE TRUE (Date 17 11 2025) (Date 17 11 2025) EQUALS JUST TRUE -- notice served on the last day
#ASSERT `Under Order 16, rule 2(1), may I, as the claimant, discontinue the action or withdraw a claim without the permission of the Court` TRUE TRUE (Date 18 11 2025) (Date 17 11 2025) EQUALS JUST FALSE -- one day late
#ASSERT `Under Order 16, rule 2(1), may I, as the claimant, discontinue the action or withdraw a claim without the permission of the Court` TRUE FALSE (Date 1 1 2000) (Date 17 11 2025) EQUALS NOTHING -- no notice in Form 32 served: "by serving a notice in Form 32"

-- Under Order 16, rule 2(2)(a), may I, as the defendant, withdraw my defence without the permission of the Court?
#ASSERT `Under Order 16, rule 2(2)(a), may I, as the defendant, withdraw my defence without the permission of the Court` TRUE TRUE EQUALS JUST TRUE -- "at any time", by notice in Form 32
#ASSERT `Under Order 16, rule 2(2)(a), may I, as the defendant, withdraw my defence without the permission of the Court` TRUE FALSE EQUALS NOTHING -- no notice in Form 32 served

-- Under Order 16, rule 2(5), may the action be withdrawn without the permission of the Court because we all consent?
#ASSERT `Under Order 16, rule 2(5), may the action be withdrawn without the permission of the Court because we all consent` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under Order 16, rule 2(5), may the action be withdrawn without the permission of the Court because we all consent` FALSE FALSE TRUE EQUALS JUST FALSE -- "If all the parties to an action consent": one does not
#ASSERT `Under Order 16, rule 2(5), may the action be withdrawn without the permission of the Court because we all consent` TRUE FALSE FALSE EQUALS NOTHING -- consent not produced to the Registrar

-- Order 16, rule 3
-- Under Order 16, rule 3(1), may I discontinue the action or counterclaim without the permission of the Court?
#ASSERT `Under Order 16, rule 3(1), may I discontinue the action or counterclaim without the permission of the Court` FALSE EQUALS JUST FALSE -- "may not ... without the permission of the Court"
#ASSERT `Under Order 16, rule 3(1), may I discontinue the action or counterclaim without the permission of the Court` TRUE EQUALS NOTHING -- "Except as provided by Rule 2"

-- Order 16, rule 2
-- Under Order 16, rule 2(7), is my action, cause or matter deemed to have been discontinued because nothing has been done in it for more than a year?
#ASSERT `Under Order 16, rule 2(7), is my action, cause or matter deemed to have been discontinued because nothing has been done in it for more than a year` FALSE FALSE (Date 1 4 2026) (Date 31 3 2026) EQUALS JUST TRUE -- no step for more than one year
#ASSERT `Under Order 16, rule 2(7), is my action, cause or matter deemed to have been discontinued because nothing has been done in it for more than a year` FALSE FALSE (Date 31 3 2026) (Date 31 3 2026) EQUALS JUST FALSE -- the last day of the year: not "more than one year"

-- Order 16, rule 4
-- Under Order 16, rule 4, is the earlier discontinuance a defence to the new action brought against me for the same cause of action?
#ASSERT `Under Order 16, rule 4, is the earlier discontinuance a defence to the new action brought against me for the same cause of action` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under Order 16, rule 4, is the earlier discontinuance a defence to the new action brought against me for the same cause of action` TRUE TRUE TRUE EQUALS NOTHING -- "Subject to any terms imposed by the Court"

-- Order 16, rule 5
-- Under Order 16, rule 5, may the Court stay the new action I have brought until I have paid the costs of the discontinued one?
#ASSERT `Under Order 16, rule 5, may the Court stay the new action I have brought until I have paid the costs of the discontinued one` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Order 16, rule 5, may the Court stay the new action I have brought until I have paid the costs of the discontinued one` TRUE TRUE FALSE EQUALS JUST FALSE -- costs paid first, or no subsequent action for the same cause

