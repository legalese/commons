#ASSERT `Under Order 14, rule 3(5), are all further proceedings on the counterclaim against the claimant stayed` TRUE TRUE TRUE EQUALS JUST TRUE -- counterclaim payment, notice stated, claimant accepts
#ASSERT `Under Order 14, rule 3(5), are all further proceedings on the counterclaim against the claimant stayed` FALSE TRUE TRUE EQUALS JUST FALSE -- not paid by a defendant who counterclaimed
#ASSERT `Under Order 14, rule 3(6), is the claimant entitled to receive payment of the sum accepted, apart from Order 14, rule 10 and Order 44, rule 11` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- accepted; nothing in Rule 4 bars payment
#ASSERT `Under Order 14, rule 3(6), is the claimant entitled to receive payment of the sum accepted, apart from Order 14, rule 10 and Order 44, rule 11` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- Rule 4(1)(a): paid in by some but not all of the defendants, and no paragraph (2) and no order
#ASSERT `Under Order 14, rule 3(6), is the claimant entitled to receive payment of the sum accepted, apart from Order 14, rule 10 and Order 44, rule 11` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE -- paid out in pursuance of an order: Rule 4(1) does not bar
#ASSERT `Under Order 14, rule 3(6), is the claimant entitled to receive payment of the sum accepted, apart from Order 14, rule 10 and Order 44, rule 11` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING -- the claimant has not accepted
-- Order 14, Rule 4
#ASSERT `Under Order 14, rule 4(1), may the money in Court be paid out` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- (a), no paragraph (2), no order
#ASSERT `Under Order 14, rule 4(1), may the money in Court be paid out` TRUE TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING -- under paragraph (2)
#ASSERT `Under Order 14, rule 4(2), may the money be paid out without an order of the Court` TRUE TRUE TRUE EQUALS JUST TRUE -- by reason only of (1)(a), discontinues, consent in writing
#ASSERT `Under Order 14, rule 4(2), may the money be paid out without an order of the Court` TRUE FALSE TRUE EQUALS JUST FALSE -- no discontinuance
#ASSERT `Under Order 14, rule 4(3), may the money be paid out` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- after the trial has begun, stayed by Rule 3(4), no order: "despite anything in paragraph (2)"
#ASSERT `Under Order 14, rule 4(3), may the money be paid out` TRUE TRUE TRUE TRUE EQUALS NOTHING -- in pursuance of an order
-- Order 14, Rule 5
#ASSERT `Under Order 14, rule 5, may the money remaining in Court be paid out` TRUE FALSE EQUALS JUST FALSE -- not accepted, no order
#ASSERT `Under Order 14, rule 5, may the money remaining in Court be paid out` TRUE TRUE EQUALS NOTHING -- in pursuance of an order
-- Order 14, Rule 6
#ASSERT `Under Order 14, rule 6, may the person pay money into Court in accordance with Rule 1` TRUE EQUALS JUST TRUE -- a claimant against whom a counterclaim is made or another defendant to it
#ASSERT `Under Order 14, rule 6, may the person pay money into Court in accordance with Rule 1` FALSE EQUALS NOTHING -- some other person
-- Order 14, Rule 7
#ASSERT `Under Order 14, rule 7, may the fact that money has been paid into Court be pleaded or communicated to the Court at the trial or hearing` FALSE FALSE FALSE EQUALS JUST FALSE -- no exception, questions not yet decided
#ASSERT `Under Order 14, rule 7, may the fact that money has been paid into Court be pleaded or communicated to the Court at the trial or hearing` TRUE FALSE FALSE EQUALS NOTHING -- a defence of tender before action is pleaded
-- Order 14, Rule 8
#ASSERT `Under Order 14, rule 8(1), may the money be paid out` TRUE FALSE FALSE EQUALS JUST FALSE -- paid in under an order, not appropriated, no order for payment out
#ASSERT `Under Order 14, rule 8(1), may the money be paid out` TRUE TRUE FALSE EQUALS NOTHING -- "Subject to paragraph (2)": appropriated
#ASSERT `Under Order 14, rule 8(2), may the party appropriate the money in this way` FALSE TRUE `o 14 r 8(2)(a) by notice to the other party to a particular claim made in the originating claim or counterclaim and specified in the notice` FALSE EQUALS JUST TRUE -- (a), by notice
#ASSERT `Under Order 14, rule 8(2), may the party appropriate the money in this way` FALSE TRUE `o 14 r 8(2)(b) by the party's pleading, as payment into Court of the money alleged to have been tendered` FALSE EQUALS JUST FALSE -- (b), no tender pleaded
#ASSERT `Under Order 14, rule 8(2), may the party appropriate the money in this way` TRUE TRUE `o 14 r 8(2)(a) by notice to the other party to a particular claim made in the originating claim or counterclaim and specified in the notice` FALSE EQUALS NOTHING -- "Unless the Court otherwise orders"
-- Order 14, Rule 9
#ASSERT `Under Order 14, rule 9(1), may any party to the cause or matter apply for payment out of Court of that money` TRUE EQUALS JUST TRUE -- money paid in pursuant to the Exchange Control Act
#ASSERT `Under Order 14, rule 9(1), may any party to the cause or matter apply for payment out of Court of that money` FALSE EQUALS JUST FALSE -- "Where" fails
-- Order 14, Rule 10
#ASSERT `Under Order 14, rule 10(1), may payment be made to this payee` TRUE TRUE FALSE `o 14 r 10 the party's solicitor` EQUALS JUST TRUE -- legal aid, represented: to the solicitor
#ASSERT `Under Order 14, rule 10(1), may payment be made to this payee` TRUE FALSE FALSE `o 14 r 10 the Director of Legal Aid` EQUALS JUST FALSE -- the Court does not so order
#ASSERT `Under Order 14, rule 10(1), may payment be made to this payee` FALSE TRUE FALSE `o 14 r 10 the party entitled` EQUALS NOTHING -- no legal aid certificate: paragraph (2)
#ASSERT `Under Order 14, rule 10(2), may payment be made to this payee` FALSE FALSE FALSE `o 14 r 10 the party entitled` EQUALS JUST TRUE -- to the party entitled
#ASSERT `Under Order 14, rule 10(2), may payment be made to this payee` FALSE FALSE FALSE `o 14 r 10 the party's solicitor` EQUALS JUST FALSE -- no authority and no order
#ASSERT `Under Order 14, rule 10(2), may payment be made to this payee` TRUE TRUE TRUE `o 14 r 10 the party entitled` EQUALS NOTHING -- "Subject to paragraph (1)": paragraph (1) decides
-- Order 14, Rule 11
#ASSERT `Under Order 14, rule 11, what is the most, in dollars, that the assets of an intestate estate may be worth for the Court to order payment of a small estate` EQUALS 50000 -- "do not exceed $50,000"
#ASSERT `Under Order 14, rule 11, may the Court order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 50000 `o 14 r 11 a widow` TRUE EQUALS JUST TRUE -- exactly $50,000 does not exceed $50,000; a widow with the prior right
#ASSERT `Under Order 14, rule 11, may the Court order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 50001 `o 14 r 11 a widow` TRUE EQUALS JUST FALSE -- $50,001 exceeds $50,000
#ASSERT `Under Order 14, rule 11, may the Court order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 10000 `o 14 r 11 a sister` FALSE EQUALS NOTHING -- a sister without the prior right
-- Order 14, Rule 12
#ASSERT `Under Order 14, rule 12(2), how many days after payment is made must the party give notice of the payment to all the other parties` EQUALS 14 -- "within 14 days after payment is made"
#ASSERT `Under Order 14, rule 12(2), does the party give notice of the payment in time` (Date 14 6 2027) (Date 14 6 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `Under Order 14, rule 12(2), does the party give notice of the payment in time` (Date 15 6 2027) (Date 14 6 2027) EQUALS JUST FALSE -- a day late

-- ============================================================
-- roc3: this part's cases seat text, unchanged (merged by concatenation)
-- ============================================================
-- Cases for roc3-seat.l4.  Every expected value is written from the text (the layer-1 tests that decide each rule were written
-- from the text before any run); a case here puts the same facts in the mouth of a party in the seat.
-- Where a question's answer is NOTHING the case says so: that is the Rules not answering, not a no.

-- ===== Order 15 -- Court hearings and evidence =====

-- Order 15, rule 1
-- Under Order 15, rule 1(1), must my matter be heard in chambers?
#ASSERT `Under Order 15, rule 1(1), must my matter be heard in chambers` `o 15 r 1(1) an originating application` FALSE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 1(1), must my matter be heard in chambers` `o 15 r 1(1) an appeal to a court other than the Appellate Division or the Court of Appeal` TRUE EQUALS NOTHING -- a written law or practice directions provide otherwise

-- Under Order 15, rule 1(3), must my application or appeal to the Appellate Division or the Court of Appeal be heard in open court?
#ASSERT `Under Order 15, rule 1(3), must my application or appeal to the Appellate Division or the Court of Appeal be heard in open court` `o 15 r 1(3) an application or appeal to the Appellate Division or the Court of Appeal` FALSE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 1(3), must my application or appeal to the Appellate Division or the Court of Appeal be heard in open court` `o 15 r 1(3) an application or appeal to the Appellate Division or the Court of Appeal` TRUE EQUALS JUST FALSE -- "unless ... otherwise orders"
#ASSERT `Under Order 15, rule 1(3), must my application or appeal to the Appellate Division or the Court of Appeal be heard in open court` `o 15 r 1(1) a summons` FALSE EQUALS NOTHING

-- Order 15, rule 3
-- Under Order 15, rule 3(1), am I attending my hearing as the Rule requires?
#ASSERT `Under Order 15, rule 3(1), am I attending my hearing as the Rule requires` TRUE FALSE TRUE EQUALS JUST TRUE -- represented, by solicitor
#ASSERT `Under Order 15, rule 3(1), am I attending my hearing as the Rule requires` TRUE TRUE FALSE EQUALS JUST FALSE -- represented but attends in person

-- Under Order 15, rule 3(2), may the Court dismiss my application, action or appeal, or make another order against me, if I do not attend?
#ASSERT `Under Order 15, rule 3(2), may the Court dismiss my application, action or appeal, or make another order against me, if I do not attend` TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 3(2), may the Court dismiss my application, action or appeal, or make another order against me, if I do not attend` FALSE EQUALS JUST FALSE

-- Order 15, rule 4
-- Under Order 15, rule 4(1), may I ask the Registrar for an order to attend court or to produce documents in Form 29?
#ASSERT `Under Order 15, rule 4(1), may I ask the Registrar for an order to attend court or to produce documents in Form 29` TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 4(1), may I ask the Registrar for an order to attend court or to produce documents in Form 29` FALSE EQUALS NOTHING

-- Under Order 15, rule 4(3), have I served my order to attend court or to produce documents on the witness in the way and in time the Rule requires?
#ASSERT `Under Order 15, rule 4(3), have I served my order to attend court or to produce documents on the witness in the way and in time the Rule requires` TRUE TRUE (Date 3 11 2025) (Date 3 11 2025) EQUALS JUST TRUE -- on the last day
#ASSERT `Under Order 15, rule 4(3), have I served my order to attend court or to produce documents on the witness in the way and in time the Rule requires` TRUE TRUE (Date 4 11 2025) (Date 3 11 2025) EQUALS JUST FALSE -- a day late

-- Under Order 15, rule 4(9), is a witness who complies with my order entitled to claim reasonable compensation from me?
#ASSERT `Under Order 15, rule 4(9), is a witness who complies with my order entitled to claim reasonable compensation from me` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 4(9), is a witness who complies with my order entitled to claim reasonable compensation from me` TRUE FALSE EQUALS JUST FALSE -- no request yet
#ASSERT `Under Order 15, rule 4(9), is a witness who complies with my order entitled to claim reasonable compensation from me` FALSE TRUE EQUALS NOTHING -- did not comply

-- Order 15, rule 5
-- Under Order 15, rule 5(3), have I applied for a letter of request as the Rule requires?
#ASSERT `Under Order 15, rule 5(3), have I applied for a letter of request as the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 5(3), have I applied for a letter of request as the Rule requires` TRUE TRUE FALSE EQUALS JUST FALSE

-- Order 15, rule 6
-- Under Order 15, rule 6(1), may I attend the hearing?
#ASSERT `Under Order 15, rule 6(1), may I attend the hearing` TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 6(1), may I attend the hearing` FALSE EQUALS NOTHING -- a hearing in chambers: paragraph (1) is silent

-- Order 15, rule 8
-- Under Order 15, rule 8(8), may I cross-examine the claimant and the claimant's witnesses?
#ASSERT `Under Order 15, rule 8(8), may I cross-examine the claimant and the claimant's witnesses` TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 8(8), may I cross-examine the claimant and the claimant's witnesses` FALSE EQUALS NOTHING

-- Under Order 15, rule 8(11), may I, as the defendant, make a submission of No case to answer?
#ASSERT `Under Order 15, rule 8(11), may I, as the defendant, make a submission of No case to answer` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under Order 15, rule 8(11), may I, as the defendant, make a submission of No case to answer` FALSE TRUE TRUE EQUALS NOTHING -- not the conclusion of the claimant's case
#ASSERT `Under Order 15, rule 8(11), may I, as the defendant, make a submission of No case to answer` TRUE FALSE TRUE EQUALS JUST FALSE -- the defendant will give evidence: condition (a) of the submission fails

-- Order 15, rule 11
