#ASSERT `Under Order 18, rule 15, did I file and serve my notice of appeal against the Registrar's decision in time` TRUE TRUE (Date 10 4 2026) (Date 10 4 2026) EQUALS JUST TRUE
#ASSERT `Under Order 18, rule 15, did I file and serve my notice of appeal against the Registrar's decision in time` TRUE TRUE (Date 11 4 2026) (Date 10 4 2026) EQUALS JUST FALSE
#ASSERT `Under Order 18, rule 15, did I file and serve my notice of appeal against the Registrar's decision in time` FALSE TRUE (Date 10 4 2026) (Date 10 4 2026) EQUALS NOTHING

