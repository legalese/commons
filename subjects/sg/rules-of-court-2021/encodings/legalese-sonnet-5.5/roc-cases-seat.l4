-- ============================================================
-- roc2: this part's cases seat text, unchanged (merged by concatenation)
-- ============================================================
-- Cases for the seat layer (roc2-seat.l4): every question has at least one case, with the facts a party to a civil action would state.
-- Expected values are written by hand from the text.  For a question that is a plain call of one layer-1 rule, the cases are the layer-1 test lines for
-- that rule (hand-written from the text earlier, in roc2-tests-order-*.l4), re-asked under the question's name; for the constants, the weeks
-- question and the gathering questions, the cases are written here by hand.  Made-up dates stand in for the answers of Order 3, rule 3.

-- Order 9, Rule 1
#ASSERT `Under Order 9, rule 1(1), how many weeks after the originating claim or originating application is issued is the case conference to be held` `Served in Singapore` EQUALS 8 -- (a): the defendant is to be served in Singapore: 8 weeks after the originating claim or originating application is issued
#ASSERT `Under Order 9, rule 1(1), how many weeks after the originating claim or originating application is issued is the case conference to be held` `Served out of Singapore` EQUALS 12 -- (b): to be served out of Singapore: 12 weeks
#ASSERT `Under Order 9, rule 1(1), on what date is the case conference to be held` `Served in Singapore` (Date 1 3 2027) EQUALS Date 26 4 2027 -- 1 March 2027 + 56 days: 30 days to 31 March, 26 more
#ASSERT `Under Order 9, rule 1(1), on what date is the case conference to be held` `Served out of Singapore` (Date 1 3 2027) EQUALS Date 24 5 2027 -- 1 March 2027 + 84 days: 30 to 31 March, 30 to 30 April, 24 more
#ASSERT `Under Order 9, rule 1(2), may the Court hold a case conference earlier or later than the time stated in paragraph (1)` TRUE FALSE EQUALS JUST TRUE -- at the request of a party
#ASSERT `Under Order 9, rule 1(2), may the Court hold a case conference earlier or later than the time stated in paragraph (1)` FALSE FALSE EQUALS NOTHING -- neither request nor own accord: limited by its own wording
#ASSERT `Under Order 9, rule 1(4), who conducts the case conference` FALSE EQUALS `The Registrar` -- "the Registrar is to conduct the case conference"
#ASSERT `Under Order 9, rule 1(4), who conducts the case conference` TRUE EQUALS `A Judge` -- the matter was referred to a Judge
-- Order 9, Rule 4
#ASSERT `Under Order 9, rule 4(1), may the Court dismiss the action` TRUE FALSE EQUALS JUST TRUE -- no party attends
#ASSERT `Under Order 9, rule 4(1), may the Court dismiss the action` FALSE FALSE EQUALS JUST FALSE -- the claimant attends: the "If" fails
#ASSERT `Under Order 9, rule 4(2), may the Court give judgment for the claimant` TRUE TRUE TRUE EQUALS JUST TRUE -- claimant attends, defendant absent, proof of service
#ASSERT `Under Order 9, rule 4(2), may the Court give judgment for the claimant` TRUE TRUE FALSE EQUALS JUST FALSE -- no proof of service: "upon proof of service" is read as "where", so JUST FALSE (ruling of 2026-11-05)
#ASSERT `Under Order 9, rule 4(3), may the Court set aside or vary the dismissal or default judgment` TRUE TRUE EQUALS JUST TRUE -- proof of valid reasons
#ASSERT `Under Order 9, rule 4(3), may the Court set aside or vary the dismissal or default judgment` TRUE FALSE EQUALS JUST FALSE -- no proof: "on proof that" is read as the same condition as "upon proof of service" (fork F-O9-6), so JUST FALSE
#ASSERT `Under Order 9, rule 4(3), may the Court set aside or vary the dismissal or default judgment` FALSE TRUE EQUALS NOTHING -- a different dismissal or judgment: scope limit without "only"
-- Order 9, Rule 5
#ASSERT `Under Order 9, rule 5(1)(a), may the Court dismiss the action` TRUE TRUE TRUE EQUALS JUST TRUE -- (a): claimant attends, has not served, the Court is not satisfied
#ASSERT `Under Order 9, rule 5(1)(a), may the Court dismiss the action` TRUE TRUE FALSE EQUALS JUST FALSE -- the Court is satisfied that reasonable steps were taken: "if it is not satisfied" fails
#ASSERT `Under Order 9, rule 5(1)(b), may the Court make this order` TRUE TRUE `o 9 r 5(1)(b) fix a second case conference` FALSE EQUALS JUST TRUE -- (b): "may fix a second case conference"
#ASSERT `Under Order 9, rule 5(1)(b), may the Court make this order` TRUE TRUE `o 9 r 5(1)(b) extend the validity of the originating process` FALSE EQUALS JUST FALSE -- not necessary: "if necessary" fails
#ASSERT `Under Order 9, rule 5(1)(b)(i), how many days after the date of the first case conference does the Court allow the claimant to serve the originating process or apply for substituted service` EQUALS 14 -- "serve the originating process within 14 days after the date of the first case conference"
#ASSERT `Under Order 9, rule 5(1)(b)(i), is the originating process served within 14 days after the first case conference` (Date 14 5 2027) (Date 14 5 2027) EQUALS JUST TRUE -- served on the last day
#ASSERT `Under Order 9, rule 5(1)(b)(i), is the originating process served within 14 days after the first case conference` (Date 15 5 2027) (Date 14 5 2027) EQUALS JUST FALSE -- served a day late
#ASSERT `Under Order 9, rule 5(1)(b)(ii), is the application for substituted service made within that time` (Date 14 5 2027) (Date 14 5 2027) EQUALS JUST TRUE -- applied on the last day
#ASSERT `Under Order 9, rule 5(1)(b)(ii), is the application for substituted service made within that time` (Date 17 5 2027) (Date 14 5 2027) EQUALS JUST FALSE -- applied after the time
#ASSERT `Under Order 9, rule 5(2), may the Court dismiss the action` TRUE EQUALS JUST TRUE -- the claimant fails to serve by the second case conference
#ASSERT `Under Order 9, rule 5(2), may the Court dismiss the action` FALSE EQUALS JUST FALSE -- the claimant served in time: the "If" fails
-- Order 9, Rule 6
#ASSERT `Under Order 9, rule 6(1), may the Court enter judgment against the defendant in default of a defence` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- all four conditions
#ASSERT `Under Order 9, rule 6(1), may the Court enter judgment against the defendant in default of a defence` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- not an originating claim
#ASSERT `Under Order 9, rule 6(2), may the Court set aside or vary the default judgment` TRUE EQUALS JUST TRUE -- "such a default judgment"
#ASSERT `Under Order 9, rule 6(2), may the Court set aside or vary the default judgment` FALSE EQUALS NOTHING -- another judgment: scope limit without "only"
#ASSERT `Under Order 9, rule 6(3), may the Court extend time for the defendant to serve the defence after the first case conference` TRUE EQUALS JUST TRUE -- "in a special case"
#ASSERT `Under Order 9, rule 6(3), may the Court extend time for the defendant to serve the defence after the first case conference` FALSE EQUALS NOTHING -- not a special case
-- Order 9, Rule 7
#ASSERT `Under Order 9, rule 7(2)(a), how many days after the date of the case conference must the defendant challenging the jurisdiction file and serve the application and affidavit` EQUALS 14 -- "file and serve the necessary application with supporting affidavit within 14 days after the date of the case conference"
#ASSERT `Under Order 9, rule 7(2)(a), does the defendant file and serve the application and affidavit in time` (Date 14 5 2027) (Date 14 5 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `Under Order 9, rule 7(2)(a), does the defendant file and serve the application and affidavit in time` (Date 15 5 2027) (Date 14 5 2027) EQUALS JUST FALSE -- a day late
#ASSERT `Under Order 9, rule 7(2)(b), how many days after that must the claimant file and serve any affidavit in reply` EQUALS 14 -- "file and serve any affidavit in reply within 14 days thereafter"
#ASSERT `Under Order 9, rule 7(2)(b), does the claimant file and serve the affidavit in reply in time` (Date 28 5 2027) (Date 28 5 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `Under Order 9, rule 7(2)(b), does the claimant file and serve the affidavit in reply in time` (Date 31 5 2027) (Date 28 5 2027) EQUALS JUST FALSE -- late
#ASSERT `Under Order 9, rule 7(2)(c), is the hearing fixed within 14 days after all affidavits have been filed and served` (Date 11 6 2027) (Date 11 6 2027) EQUALS JUST TRUE -- fixed for the last day
#ASSERT `Under Order 9, rule 7(2)(c), is the hearing fixed within 14 days after all affidavits have been filed and served` (Date 12 6 2027) (Date 11 6 2027) EQUALS JUST FALSE -- fixed for a later day
-- Order 9, Rule 9
#ASSERT `Under Order 9, rule 9(5), how many days after the date of the case conference must the applying party file and serve the application and supporting affidavit` EQUALS 21 -- "within 21 days after the date of the case conference"
#ASSERT `Under Order 9, rule 9(5), does the party file and serve in time` `o 9 r 9(5) the applying party` (Date 17 5 2027) (Date 17 5 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `Under Order 9, rule 9(5), does the party file and serve in time` `o 9 r 9(5) the other party` (Date 8 6 2027) (Date 7 6 2027) EQUALS JUST FALSE -- a day after the last day
#ASSERT `Under Order 9, rule 9(10), may an application be taken out` (Date 14 6 2027) (Date 10 6 2027) FALSE TRUE TRUE EQUALS JUST TRUE -- in the period, a special case with the trial Judge's approval
#ASSERT `Under Order 9, rule 9(10), may an application be taken out` (Date 14 6 2027) (Date 10 6 2027) FALSE TRUE FALSE EQUALS JUST FALSE -- in the period, a special case but no approval
#ASSERT `Under Order 9, rule 9(10), may an application be taken out` (Date 9 6 2027) (Date 10 6 2027) FALSE FALSE FALSE EQUALS NOTHING -- the day before the period starts
-- Order 9, Rule 10
#ASSERT `Under Order 9, rule 10(2), may the person proceed in this way` TRUE `o 9 r 10(2) attend a case conference` TRUE FALSE FALSE EQUALS JUST TRUE -- may attend if aware of it
#ASSERT `Under Order 9, rule 10(2), may the person proceed in this way` TRUE `o 9 r 10(2) attend a case conference` FALSE FALSE FALSE EQUALS JUST FALSE -- not aware of it: "if the person is aware of it" fails
#ASSERT `Under Order 9, rule 10(2), may the person proceed in this way` TRUE `o 9 r 10(2) seek a case conference by letter` FALSE TRUE FALSE EQUALS NOTHING -- not copied to all the parties: limited by "copied to all the parties"
#ASSERT `Under Order 9, rule 10(3), from what date is the action deemed to be commenced against the added defendant` TRUE (Date 5 7 2027) EQUALS JUST (Date 5 7 2027) -- "on the date on which the amendment to the action is made"
#ASSERT `Under Order 9, rule 10(3), from what date is the action deemed to be commenced against the added defendant` FALSE (Date 5 7 2027) EQUALS NOTHING -- no person added as a defendant
-- Order 9, Rule 11
#ASSERT `Under Order 9, rule 11, may the Court make this order about 2 or more actions` `o 9 r 11 order 2 or more actions to be consolidated` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- (a) a common question of law
#ASSERT `Under Order 9, rule 11, may the Court make this order about 2 or more actions` `o 9 r 11 order 2 or more actions to be consolidated` TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- none of (a), (b), (c)
-- Order 9, Rule 12
#ASSERT `Under Order 9, rule 12(1), may the defendant apply for security for the defendant's costs` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- limb (a) alone: the claimant is ordinarily resident out of the jurisdiction
#ASSERT `Under Order 9, rule 12(1), may the defendant apply for security for the defendant's costs` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- none of (a), (b), (c)
#ASSERT `Under Order 9, rule 12(1), may the defendant apply for security for the defendant's costs` FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- limb (b): a nominal claimant, and reason to believe the claimant will be unable to pay
#ASSERT `Under Order 9, rule 12(1), may the defendant apply for security for the defendant's costs` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- a nominal claimant but no reason to believe the claimant cannot pay
#ASSERT `Under Order 9, rule 12(1), may the defendant apply for security for the defendant's costs` FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE -- limb (c): the claimant changed the address to evade the consequences of the litigation
#ASSERT `Under Order 9, rule 12(3), may the defendant apply for security for the defendant's costs to be provided by a non-party` FALSE TRUE FALSE FALSE EQUALS JUST TRUE -- limb (b): contributed in return for a share
#ASSERT `Under Order 9, rule 12(3), may the defendant apply for security for the defendant's costs to be provided by a non-party` FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- none of (a), (b), (c)
#ASSERT `Under Order 9, rule 12(3), may the defendant apply for security for the defendant's costs to be provided by a non-party` FALSE FALSE TRUE TRUE EQUALS JUST TRUE -- limb (c): contributed and actively instigates or encourages the action
#ASSERT `Under Order 9, rule 12(3), may the defendant apply for security for the defendant's costs to be provided by a non-party` FALSE FALSE TRUE FALSE EQUALS JUST FALSE -- contributed but does not instigate or encourage
#ASSERT `Under Order 9, rule 12(4), is the application for an order under paragraph (3) made as required` TRUE TRUE TRUE EQUALS JUST TRUE -- by summons, served on the non-party personally and every party
#ASSERT `Under Order 9, rule 12(4), is the application for an order under paragraph (3) made as required` FALSE TRUE TRUE EQUALS JUST FALSE -- not by summons
-- Order 9, Rule 14
#ASSERT `Under Order 9, rule 14(3), may the Court allow the pleading to be amended` (Date 15 6 2027) (Date 10 6 2027) FALSE EQUALS JUST FALSE -- 5 June later than the 14th day before trial: "less than 14 days before"; not a special case
#ASSERT `Under Order 9, rule 14(3), may the Court allow the pleading to be amended` (Date 15 6 2027) (Date 10 6 2027) TRUE EQUALS NOTHING -- a special case: the prohibition does not reach
#ASSERT `Under Order 9, rule 14(4), may the Court allow the amendment` TRUE `o 9 r 14(4)(a) an amendment to correct the name of a party` TRUE FALSE FALSE EQUALS JUST TRUE -- (a) genuine mistake, not misleading
#ASSERT `Under Order 9, rule 14(4), may the Court allow the amendment` TRUE `o 9 r 14(4)(a) an amendment to correct the name of a party` FALSE FALSE FALSE EQUALS JUST FALSE -- (a) not a genuine mistake
#ASSERT `Under Order 9, rule 14(4), may the Court allow the amendment` TRUE `o 9 r 14(4) any other amendment` TRUE TRUE TRUE EQUALS NOTHING -- an amendment of another kind: the circumstances are not said to be exhaustive
-- Order 9, Rule 16
#ASSERT `Under Order 9, rule 16(1), may the Court order the pleading or part of it to be struck out or amended` TRUE FALSE FALSE EQUALS JUST TRUE -- (a) discloses no reasonable cause of action or defence
#ASSERT `Under Order 9, rule 16(1), may the Court order the pleading or part of it to be struck out or amended` FALSE FALSE FALSE EQUALS JUST FALSE -- no ground
-- Order 9, Rule 17
#ASSERT `Under Order 9, rule 17(1), may the claimant apply for summary judgment against the defendant` TRUE TRUE `o 9 r 17(1)(a) the defendant has no defence to a claim` TRUE EQUALS JUST TRUE -- (a): after the defence has been filed and served in an originating claim
#ASSERT `Under Order 9, rule 17(1), may the claimant apply for summary judgment against the defendant` TRUE FALSE `o 9 r 17(1)(a) the defendant has no defence to a claim` TRUE EQUALS JUST FALSE -- the defence has not yet been filed and served
#ASSERT `Under Order 9, rule 17(3), how many days after service of the claimant's application and affidavit must the defendant who disputes it file and serve the defendant's affidavit` EQUALS 14 -- "within 14 days after service of the claimant's application and affidavit"
#ASSERT `Under Order 9, rule 17(3), does the defendant file and serve the defendant's affidavit in time` (Date 20 7 2027) (Date 20 7 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `Under Order 9, rule 17(3), does the defendant file and serve the defendant's affidavit in time` (Date 21 7 2027) (Date 20 7 2027) EQUALS JUST FALSE -- a day late
#ASSERT `Under Order 9, rule 17(5), how many days after service of the defendant's affidavit must the claimant who disputes it file and serve the claimant's affidavit` EQUALS 14 -- "within 14 days after service of the defendant's affidavit"
#ASSERT `Under Order 9, rule 17(5), does the claimant file and serve the claimant's affidavit in time` (Date 3 8 2027) (Date 3 8 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `Under Order 9, rule 17(5), does the claimant file and serve the claimant's affidavit in time` (Date 4 8 2027) (Date 3 8 2027) EQUALS JUST FALSE -- late
#ASSERT `Under Order 9, rule 17(7), may the Court make this order on the application` `o 9 r 17(7)(a) dismiss the application` FALSE EQUALS JUST TRUE -- (a)
#ASSERT `Under Order 9, rule 17(7), may the Court make this order on the application` `o 9 r 17(7)(d) grant permission to defend to the defendant with conditions` FALSE EQUALS JUST FALSE -- (d) "if" fails
#ASSERT `Under Order 9, rule 17(10), may the Court set aside or vary the summary judgment` TRUE TRUE EQUALS JUST TRUE -- granted against a defendant who was absent
#ASSERT `Under Order 9, rule 17(10), may the Court set aside or vary the summary judgment` TRUE FALSE EQUALS NOTHING -- the defendant was present: scope limit
#ASSERT `Under Order 9, rule 17(11), may the defendant apply for summary judgment against the claimant on the counterclaim` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- all four conditions
#ASSERT `Under Order 9, rule 17(11), may the defendant apply for summary judgment against the claimant on the counterclaim` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- not an originating claim
#ASSERT `Under Order 9, rule 17(13), how many days after the date of service of the defence may the claimant apply for summary judgment on the defence` EQUALS 28 -- "28 days after the date of service of the defence"
#ASSERT `Under Order 9, rule 17(13), is the application made in time` (Date 10 8 2027) (Date 10 8 2027) FALSE EQUALS JUST TRUE -- made on the last day
#ASSERT `Under Order 9, rule 17(13), is the application made in time` (Date 11 8 2027) (Date 10 8 2027) FALSE EQUALS JUST FALSE -- made after the expiry of 28 days, no permission
-- Order 9, Rule 22
#ASSERT `Under Order 9, rule 22(5), may the Court order one or more of the parties to pay the expenses` TRUE TRUE EQUALS JUST TRUE -- reasonable expenses of an independent witness
#ASSERT `Under Order 9, rule 22(5), may the Court order one or more of the parties to pay the expenses` TRUE FALSE EQUALS NOTHING -- not reasonable
-- Order 9, Rule 24
#ASSERT `Under Order 9, rule 24(1), may a party apply to the Court for an order for pre-trial examination` TRUE EQUALS JUST TRUE -- necessary in the interests of justice
#ASSERT `Under Order 9, rule 24(1), may a party apply to the Court for an order for pre-trial examination` FALSE EQUALS JUST FALSE -- "Where it is necessary" fails
#ASSERT `Under Order 9, rule 24(4), may the application for a letter of request be made in this court` TRUE `General Division` EQUALS JUST TRUE -- "only be made in the General Division"
#ASSERT `Under Order 9, rule 24(4), may the application for a letter of request be made in this court` TRUE `District Court` EQUALS JUST FALSE -- the State Courts are not the General Division
#ASSERT `Under Order 9, rule 24(4), may the application for a letter of request be made in this court` FALSE `District Court` EQUALS NOTHING -- an application that does not include a request for a letter of request
-- Order 9, Rule 25
#ASSERT `Under Order 9, rule 25(5), when the claimant does not set down the action for trial within the period fixed under paragraph (4), may this step be taken` TRUE `o 9 r 25(5) the defendant sets the action down for trial` FALSE EQUALS JUST TRUE -- "the defendant may set the action down for trial"
#ASSERT `Under Order 9, rule 25(5), when the claimant does not set down the action for trial within the period fixed under paragraph (4), may this step be taken` FALSE `o 9 r 25(5) the defendant sets the action down for trial` FALSE EQUALS JUST FALSE -- the claimant did set down in time: "Where" fails
#ASSERT `Under Order 9, rule 25(5), when the claimant does not set down the action for trial within the period fixed under paragraph (4), may this step be taken` TRUE `o 9 r 25(5) the Court orders the action to be dismissed` FALSE EQUALS NOTHING -- no application has been heard
