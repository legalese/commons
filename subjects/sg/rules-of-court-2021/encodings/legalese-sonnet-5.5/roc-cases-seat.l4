#ASSERT `Under Order 19, rule 8(2), may the appeal go ahead without a respondent` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- A respondent attended too.
#ASSERT `Under Order 19, rule 8(2), may the appeal go ahead without a respondent` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
