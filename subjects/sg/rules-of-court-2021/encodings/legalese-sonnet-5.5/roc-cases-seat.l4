-- Order 54.  A person taking an oath or making an affirmation (lines 6688 to 6701 of the text).
-- ---------------------------------------------------------------------------
#ASSERT `Under Order 54, rule 1(1), does this Order apply` TRUE EQUALS JUST TRUE -- r 1(1): "every instance when an oath or affirmation is taken or made"
#ASSERT `Under Order 54, rule 1(1), does this Order apply` FALSE EQUALS NOTHING -- r 1(1): some other occasion
#ASSERT `Under Order 54, rule 1(1), does Order 1, Rule 2 prevent this Order from applying` TRUE EQUALS JUST FALSE -- r 1(1): "despite anything in Order 1, Rule 2"
#ASSERT `Under Order 54, rule 1(2), is the person an officer` `o 54 r 1(2) Rule 2, which is about oaths` TRUE FALSE TRUE EQUALS JUST TRUE -- r 1(2): in Rule 2, authorised for oaths
#ASSERT `Under Order 54, rule 1(2), is the person an officer` `o 54 r 1(2) Rule 3, which is about affirmations` TRUE FALSE FALSE EQUALS JUST FALSE -- r 1(2): in Rule 3, authorised only for oaths
#ASSERT `Under Order 54, rule 1(2), is the person an officer` `o 54 r 1(2) somewhere else` TRUE TRUE TRUE EQUALS NOTHING -- r 1(2): "In Rules 2, 3 and 4" only
#ASSERT `Under Order 54, rule 2(1), must the oath be taken and administered in the form and manner prescribed in Rule 2` TRUE FALSE EQUALS JUST TRUE -- r 2(1): an oath under the Act
#ASSERT `Under Order 54, rule 2(1), must the oath be taken and administered in the form and manner prescribed in Rule 2` TRUE TRUE EQUALS JUST FALSE -- r 2(1): "Subject to Rule 4"
#ASSERT `Under Order 54, rule 2(1), was the oath taken and administered in the form and manner prescribed` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- r 2(1): taken and administered as prescribed
#ASSERT `Under Order 54, rule 2(1), was the oath taken and administered in the form and manner prescribed` TRUE FALSE TRUE FALSE EQUALS NOTHING -- r 2(1): not administered as prescribed: a bare "must"
#ASSERT `Under Order 54, rule 2(2), may the person taking the oath place the left hand on the Bible or hold it in the manner the person desires` FALSE FALSE FALSE EQUALS JUST TRUE -- r 2(2): no objection, not repugnant, no third person
#ASSERT `Under Order 54, rule 2(2), may the person taking the oath place the left hand on the Bible or hold it in the manner the person desires` TRUE FALSE FALSE EQUALS JUST FALSE -- r 2(2): "unless before taking the oath he or she objects"
#ASSERT `Under Order 54, rule 2(2), may the person taking the oath place the left hand on the Bible or hold it in the manner the person desires` FALSE TRUE FALSE EQUALS NOTHING -- r 2(2): repugnant to justice or decency: outside the permission
#ASSERT `Under Order 54, rule 2(2), has the person taking the oath raised the right hand and said the words as the person must` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- r 2(2): raised the right hand and said the words
#ASSERT `Under Order 54, rule 2(2), has the person taking the oath raised the right hand and said the words as the person must` TRUE FALSE FALSE TRUE EQUALS NOTHING -- r 2(2): did not raise the right hand: a bare "must"
#ASSERT `Under Order 54, rule 2(3), must the officer administer the oath in the form and manner set out in paragraph (2)` TRUE FALSE FALSE EQUALS JUST TRUE -- r 2(3): no exception
#ASSERT `Under Order 54, rule 2(3), must the officer administer the oath in the form and manner set out in paragraph (2)` TRUE FALSE TRUE EQUALS JUST FALSE -- r 2(3): "physically incapable"
#ASSERT `Under Order 54, rule 2(3), has the officer administered the oath as the officer must` TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- r 2(3): administered as set out
#ASSERT `Under Order 54, rule 2(3), has the officer administered the oath as the officer must` TRUE FALSE FALSE FALSE EQUALS NOTHING -- r 2(3): not administered: a bare "must"
#ASSERT `Under Order 54, rule 3(1), must the affirmation be made and administered in the form and manner prescribed in Rule 3` TRUE FALSE EQUALS JUST TRUE -- r 3(1): an affirmation under the Act
#ASSERT `Under Order 54, rule 3(1), was the affirmation made and administered in the form and manner prescribed` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- r 3(1): made and administered as prescribed
#ASSERT `Under Order 54, rule 3(2), has the person making the affirmation raised the right hand and said the words as the person must` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- r 3(2): raised the right hand and said the words
#ASSERT `Under Order 54, rule 3(3), must the officer administer the affirmation in the form and manner set out in paragraph (2)` TRUE TRUE FALSE EQUALS JUST FALSE -- r 3(3): "permitted under the Act to do otherwise"
#ASSERT `Under Order 54, rule 3(3), has the officer administered the affirmation as the officer must` TRUE FALSE FALSE FALSE EQUALS NOTHING -- r 3(3): not administered: a bare "must"
#ASSERT `Under Order 54, rule 4, may the officer administer the oath or affirmation in such form and manner` TRUE TRUE EQUALS JUST TRUE -- r 4: physically incapable, form appropriate or expedient
#ASSERT `Under Order 54, rule 4, may the officer administer the oath or affirmation in such form and manner` FALSE TRUE EQUALS JUST FALSE -- r 4: "in the case of a person who is physically incapable"
