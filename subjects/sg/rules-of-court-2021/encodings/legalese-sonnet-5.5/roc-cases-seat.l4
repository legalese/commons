#ASSERT `Under Order 56, rule 10(2), may the Registrar exercise the power` TRUE EQUALS JUST TRUE -- r 10(2): the powers conferred on a Judge by section 23
#ASSERT `Under Order 56, rule 10(3), is the summons or order served as it must be` TRUE TRUE TRUE EQUALS JUST TRUE -- r 10(3): the judgment debtor and the partners within Singapore
#ASSERT `Under Order 56, rule 10(3), is the summons or order served as it must be` TRUE TRUE FALSE EQUALS NOTHING -- r 10(3): the partners within Singapore not served
#ASSERT `Under Order 56, rule 10(4), is the summons or order served as it must be` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- r 10(4): (a), (b) and (c)
#ASSERT `Under Order 56, rule 10(4), is the summons or order served as it must be` TRUE FALSE TRUE TRUE EQUALS NOTHING -- r 10(4)(a): the judgment creditor not served
#ASSERT `Under Order 56, rule 10(5), is the summons or order deemed to have been served on all the partners` TRUE EQUALS JUST TRUE -- r 10(5): served on some only of the partners

-- ============================================================
-- roc11: this part's cases seat text, unchanged (merged by concatenation)
-- ============================================================
-- CASES for the roc11 seat: each case is a person's facts; every expected value is written from the text.

-- ===========================================================================
-- ORDER 57 -- cases
-- ===========================================================================

-- Rule 1.  Whether a panel is an Appeal Committee: "means a Data Protection Appeal Committee nominated under section 48P(4)".
#ASSERT `Under Order 57, rule 1, is the panel an Appeal Committee` TRUE TRUE EQUALS JUST TRUE
-- Case: a panel not nominated under section 48P(4).
#ASSERT `Under Order 57, rule 1, is the panel an Appeal Committee` TRUE FALSE EQUALS JUST FALSE
-- Case: a body that is not a Data Protection Appeal Committee at all.
#ASSERT `Under Order 57, rule 1, is the panel an Appeal Committee` FALSE FALSE EQUALS JUST FALSE
-- Rule 1.  Whether a body is the Commission: "means the Personal Data Protection Commission established by section 5".
#ASSERT `Under Order 57, rule 1, is the body the Commission` TRUE TRUE EQUALS JUST TRUE
-- Case: another regulator.
#ASSERT `Under Order 57, rule 1, is the body the Commission` FALSE FALSE EQUALS JUST FALSE

-- Rule 2.  Someone asks whether the Registrar may exercise the power they are being subjected to.
-- Case: the order asked for is one that section 48M(4) provides: "may only be exercised by a District Judge", so no.
#ASSERT `Under Order 57, rule 2, can the Registrar exercise the District Court's power under section 48M that is being asked for` TRUE EQUALS JUST FALSE
-- Case: it is another order under section 48M: paragraph (1) names the Registrar.
#ASSERT `Under Order 57, rule 2, can the Registrar exercise the District Court's power under section 48M that is being asked for` FALSE EQUALS JUST TRUE

-- Rule 3.  The Commission made a direction under section 48I against the person.
#ASSERT `Under Order 57, rule 3(a), is the instrument made against me a Direction` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE EQUALS JUST TRUE
-- Case: the Commission made it under a provision the Rule does not list.
#ASSERT `Under Order 57, rule 3(a), is the instrument made against me a Direction` `roc11 the Personal Data Protection Commission` `roc11 another provision` TRUE EQUALS NOTHING
-- Case: an Appeal Committee made it: not a Direction in the sense of paragraph (a).
#ASSERT `Under Order 57, rule 3(a), is the instrument made against me a Direction` `roc11 a Data Protection Appeal Committee` `roc11 section 48Q(5)` TRUE EQUALS NOTHING
-- Case: a written notice for a penalty with interest.
#ASSERT `Under Order 57, rule 3(b), is the instrument made against me a Notice` `roc11 the Personal Data Protection Commission` TRUE TRUE TRUE EQUALS JUST TRUE
-- Case: a notice for the penalty alone.
#ASSERT `Under Order 57, rule 3(b), is the instrument made against me a Notice` `roc11 the Personal Data Protection Commission` TRUE TRUE FALSE EQUALS NOTHING
-- Case: a decision of an Appeal Committee under section 48Q(5).
#ASSERT `Under Order 57, rule 3(c), is the instrument made against me a Decision` `roc11 a Data Protection Appeal Committee` `roc11 section 48Q(5)` TRUE EQUALS JUST TRUE
-- Case: the Commission, not an Appeal Committee, made it.
#ASSERT `Under Order 57, rule 3(c), is the instrument made against me a Decision` `roc11 the Personal Data Protection Commission` `roc11 section 48Q(5)` TRUE EQUALS NOTHING
-- Case: the Commission applied by originating application without notice.
#ASSERT `Under Order 57, rule 3, was the Commission's application to register the instrument made against me made by originating application without notice` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- Case: the Commission gave notice of the application: the Rule says "without notice".
#ASSERT `Under Order 57, rule 3, was the Commission's application to register the instrument made against me made by originating application without notice` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS NOTHING
-- Case: the instrument was made by someone else: Rule 3 does not reach it.
#ASSERT `Under Order 57, rule 3, was the Commission's application to register the instrument made against me made by originating application without notice` `roc11 someone else` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE TRUE TRUE EQUALS NOTHING
-- Case: the Commission applied to register in a court other than the District Court: the sentence opens "An application to register in the District Court".
#ASSERT `Under Order 57, rule 3, was the Commission's application to register the instrument made against me made by originating application without notice` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE TRUE FALSE EQUALS NOTHING

-- Rule 4(1).  The affidavit states everything, by route A, with a penalty and its unsatisfied amount.
#ASSERT count (`Under Order 57, rule 4(1), what has the affidavit supporting the Commission's application to register left out that the Rule requires` TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE) EQUALS 0
-- Case: no penalty was imposed, so the amount need not be stated; route B is stated instead of route A.
#ASSERT count (`Under Order 57, rule 4(1), what has the affidavit supporting the Commission's application to register left out that the Rule requires` TRUE TRUE TRUE TRUE FALSE TRUE TRUE FALSE FALSE) EQUALS 0
-- Case: the affidavit does not say the order has not been complied with and does not state the unsatisfied amount of a penalty.
#ASSERT count (`Under Order 57, rule 4(1), what has the affidavit supporting the Commission's application to register left out that the Rule requires` TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE FALSE) EQUALS 2
#ASSERT elem "(d)(iii) as at the date of the application, the Direction, Notice or Decision has not been complied with" (`Under Order 57, rule 4(1), what has the affidavit supporting the Commission's application to register left out that the Rule requires` TRUE TRUE TRUE TRUE TRUE FALSE FALSE TRUE FALSE)
-- Rule 4(2).  A direction made by the Commission, no reconsideration was applied for and the time has run.
#ASSERT `Under Order 57, rule 4(2), does the affidavit supporting the Commission's application make the additional statement the Rule requires about reconsideration` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- Case: none of the three statements is made.
#ASSERT `Under Order 57, rule 4(2), does the affidavit supporting the Commission's application make the additional statement the Rule requires about reconsideration` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- Case: an Appeal Committee's decision: paragraph (2) is about a Direction or Notice.
#ASSERT `Under Order 57, rule 4(2), does the affidavit supporting the Commission's application make the additional statement the Rule requires about reconsideration` `roc11 a Data Protection Appeal Committee` `roc11 section 48Q(5)` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- Rule 4(1)(d)(ii)(A).  The instrument has not been appealed against and the time to appeal has expired.
#ASSERT `Under Order 57, rule 4(1)(d)(ii)(A), can the Commission's affidavit state that the instrument made against me has not been appealed against and the time allowed for appealing has expired` FALSE TRUE EQUALS JUST TRUE
-- Case: an appeal is pending.
#ASSERT `Under Order 57, rule 4(1)(d)(ii)(A), can the Commission's affidavit state that the instrument made against me has not been appealed against and the time allowed for appealing has expired` TRUE FALSE EQUALS JUST FALSE
-- Case: not appealed against, but the time allowed for appealing has not expired.
#ASSERT `Under Order 57, rule 4(1)(d)(ii)(A), can the Commission's affidavit state that the instrument made against me has not been appealed against and the time allowed for appealing has expired` FALSE FALSE EQUALS JUST FALSE
-- Rule 4(1)(d)(ii)(B).  All appeals have been finally disposed of and no further appeal is feasible.
#ASSERT `Under Order 57, rule 4(1)(d)(ii)(B), can the Commission's affidavit state that all appeals against the instrument made against me have been finally disposed of and no further appeal is feasible` TRUE FALSE EQUALS JUST TRUE
-- Case: an appeal is still pending.
#ASSERT `Under Order 57, rule 4(1)(d)(ii)(B), can the Commission's affidavit state that all appeals against the instrument made against me have been finally disposed of and no further appeal is feasible` FALSE FALSE EQUALS JUST FALSE
-- Case: appeals disposed of, but a further appeal is feasible.
#ASSERT `Under Order 57, rule 4(1)(d)(ii)(B), can the Commission's affidavit state that all appeals against the instrument made against me have been finally disposed of and no further appeal is feasible` TRUE TRUE EQUALS JUST FALSE
-- Rule 4(1)(d)(ii) as a whole: route (A) or route (B).
#ASSERT `Under Order 57, rule 4(1)(d)(ii), can the Commission's affidavit state, on these facts, either that the instrument made against me has not been appealed against and the time to appeal has expired, or that all appeals have been finally disposed of and no further appeal is feasible` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
-- Case: an appeal was brought and is finished, with no further appeal feasible.
#ASSERT `Under Order 57, rule 4(1)(d)(ii), can the Commission's affidavit state, on these facts, either that the instrument made against me has not been appealed against and the time to appeal has expired, or that all appeals have been finally disposed of and no further appeal is feasible` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- Case: an appeal is pending.
#ASSERT `Under Order 57, rule 4(1)(d)(ii), can the Commission's affidavit state, on these facts, either that the instrument made against me has not been appealed against and the time to appeal has expired, or that all appeals have been finally disposed of and no further appeal is feasible` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- Rule 4(1)(d)(iii).  The instrument has not been complied with.
#ASSERT `Under Order 57, rule 4(1)(d)(iii), can the Commission's affidavit state that the instrument made against me has not been complied with` FALSE EQUALS JUST TRUE
-- Case: it has been complied with.
#ASSERT `Under Order 57, rule 4(1)(d)(iii), can the Commission's affidavit state that the instrument made against me has not been complied with` TRUE EQUALS JUST FALSE
-- Rule 4(2)(a).  A direction made by the Commission under section 48I; no application to reconsider was made and the time to apply has expired.
#ASSERT `Under Order 57, rule 4(2)(a), can the Commission's affidavit state that no application to reconsider was made and the time allowed to apply has expired` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- Case: an application to reconsider was made.
#ASSERT `Under Order 57, rule 4(2)(a), can the Commission's affidavit state that no application to reconsider was made and the time allowed to apply has expired` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- Case: none was made, but the time to apply has not expired.
#ASSERT `Under Order 57, rule 4(2)(a), can the Commission's affidavit state that no application to reconsider was made and the time allowed to apply has expired` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- Case: an Appeal Committee's decision: paragraph (2) is about a Direction or Notice.
#ASSERT `Under Order 57, rule 4(2)(a), can the Commission's affidavit state that no application to reconsider was made and the time allowed to apply has expired` `roc11 a Data Protection Appeal Committee` `roc11 section 48Q(5)` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING
-- Rule 4(2)(b)(i).  Every reconsideration application disposed of; the decision not appealed against; the time to appeal expired.
#ASSERT `Under Order 57, rule 4(2)(b)(i), can the Commission's affidavit state that the decision on reconsideration has not been appealed against and the time allowed for appealing has expired` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
-- Case: a reconsideration application is still pending.
#ASSERT `Under Order 57, rule 4(2)(b)(i), can the Commission's affidavit state that the decision on reconsideration has not been appealed against and the time allowed for appealing has expired` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- Case: the decision on reconsideration was appealed against.
#ASSERT `Under Order 57, rule 4(2)(b)(i), can the Commission's affidavit state that the decision on reconsideration has not been appealed against and the time allowed for appealing has expired` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- Case: the time to appeal the decision has not expired.
#ASSERT `Under Order 57, rule 4(2)(b)(i), can the Commission's affidavit state that the decision on reconsideration has not been appealed against and the time allowed for appealing has expired` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- Rule 4(2)(b)(ii).  Every reconsideration application and every appeal disposed of; a further appeal lies and the time for it has expired.
#ASSERT `Under Order 57, rule 4(2)(b)(ii), can the Commission's affidavit state that all appeals against the decision on reconsideration have been finally disposed of and the time allowed for a further appeal has expired` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- Case: no further appeal lies, so "(where applicable)" asks nothing about the time.
#ASSERT `Under Order 57, rule 4(2)(b)(ii), can the Commission's affidavit state that all appeals against the decision on reconsideration have been finally disposed of and the time allowed for a further appeal has expired` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- Case: a further appeal lies and the time for it has not expired.
#ASSERT `Under Order 57, rule 4(2)(b)(ii), can the Commission's affidavit state that all appeals against the decision on reconsideration have been finally disposed of and the time allowed for a further appeal has expired` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- Case: an appeal against the decision is still pending.
#ASSERT `Under Order 57, rule 4(2)(b)(ii), can the Commission's affidavit state that all appeals against the decision on reconsideration have been finally disposed of and the time allowed for a further appeal has expired` `roc11 the Personal Data Protection Commission` `roc11 section 48I` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE

-- Rule 5(2).  The order registering the instrument against the person.
#ASSERT `Under Order 57, rule 5(2), does the order registering the instrument against me state the period to apply to set aside and contain the notification` FALSE TRUE TRUE EQUALS JUST TRUE
-- Case: the order does not contain the notification.
#ASSERT `Under Order 57, rule 5(2), does the order registering the instrument against me state the period to apply to set aside and contain the notification` FALSE TRUE FALSE EQUALS NOTHING
-- Case: the Court directed otherwise: the requirement does not arise.
#ASSERT `Under Order 57, rule 5(2), does the order registering the instrument against me state the period to apply to set aside and contain the notification` TRUE FALSE FALSE EQUALS NOTHING
-- Rule 5(3).  The period expires on 20 November 2026.
#ASSERT `Under Order 57, rule 5(3), is my application to extend the period for applying to set aside made before that period expires` (Date 20 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `Under Order 57, rule 5(3), is my application to extend the period for applying to set aside made before that period expires` (Date 21 11 2026) (Date 20 11 2026) EQUALS JUST FALSE
-- Rule 5(4).
#ASSERT `Under Order 57, rule 5(4), may the Court extend the period for applying to set aside` TRUE EQUALS JUST TRUE
#ASSERT `Under Order 57, rule 5(4), may the Court extend the period for applying to set aside` FALSE EQUALS NOTHING

-- Rule 7.  The notice was served on the person personally.
#ASSERT `Under Order 57, rule 7(1), was the notice of registration served on me as the Rule requires` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- Case: the Court ordered another way and it was served that way.
#ASSERT `Under Order 57, rule 7(1), was the notice of registration served on me as the Rule requires` TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- Case: left at the person's address, with no order of the Court.
#ASSERT `Under Order 57, rule 7(1), was the notice of registration served on me as the Rule requires` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- Case: served abroad: Order 8 governs and is another part's.
#ASSERT `Under Order 57, rule 7(1), was the notice of registration served on me as the Rule requires` TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `Under Order 57, rule 7(2), does the Commission need permission to serve the notice of registration on me outside Singapore` TRUE EQUALS JUST FALSE
#ASSERT `Under Order 57, rule 7(2), does the Commission need permission to serve the notice of registration on me outside Singapore` FALSE EQUALS NOTHING
-- Case: the notice leaves out the right to apply to set aside and the period.
#ASSERT count (`Under Order 57, rule 7(3), what has the notice of registration served on me left out that the Rule requires it to state` TRUE TRUE FALSE FALSE) EQUALS 2
#ASSERT count (`Under Order 57, rule 7(3), what has the notice of registration served on me left out that the Rule requires it to state` TRUE TRUE TRUE TRUE) EQUALS 0

-- Rule 8(1).  Served on Monday 9 November 2026; the last day of the 3 days is Thursday 12 November 2026.
-- Case: endorsed on the last day.
#ASSERT `Under Order 57, rule 8(1), was the notice of registration endorsed in time` TRUE (Date 12 11 2026) (Date 13 11 2026) (Date 12 11 2026) FALSE (Date 1 1 2000) EQUALS JUST TRUE
-- Case: endorsed the day after the last day.
#ASSERT `Under Order 57, rule 8(1), was the notice of registration endorsed in time` TRUE (Date 13 11 2026) (Date 13 11 2026) (Date 12 11 2026) FALSE (Date 1 1 2000) EQUALS JUST FALSE
-- Case: endorsed the day after the last day, but the Court had allowed until 20 November 2026.
#ASSERT `Under Order 57, rule 8(1), was the notice of registration endorsed in time` TRUE (Date 13 11 2026) (Date 13 11 2026) (Date 12 11 2026) TRUE (Date 20 11 2026) EQUALS JUST TRUE
-- Case: not endorsed yet, asked on the last day.
#ASSERT `Under Order 57, rule 8(1), was the notice of registration endorsed in time` FALSE (Date 1 1 2000) (Date 12 11 2026) (Date 12 11 2026) FALSE (Date 1 1 2000) EQUALS NOTHING
-- Case: not endorsed, asked after the last day.
#ASSERT `Under Order 57, rule 8(1), was the notice of registration endorsed in time` FALSE (Date 1 1 2000) (Date 13 11 2026) (Date 12 11 2026) FALSE (Date 1 1 2000) EQUALS JUST FALSE
-- Rule 8(2).  Not endorsed in time: the person seeking to enforce may not apply without the Court's permission.
#ASSERT `Under Order 57, rule 8(2), may the Commission apply for an enforcement order against me without the Court's permission` FALSE (Date 1 1 2000) (Date 13 11 2026) (Date 12 11 2026) FALSE (Date 1 1 2000) EQUALS JUST FALSE
-- Case: endorsed in time: the bar does not arise, and the Rule grants nothing.
#ASSERT `Under Order 57, rule 8(2), may the Commission apply for an enforcement order against me without the Court's permission` TRUE (Date 12 11 2026) (Date 13 11 2026) (Date 12 11 2026) FALSE (Date 1 1 2000) EQUALS NOTHING

-- Rule 9.  The person applies to set the registration aside.
#ASSERT `Under Order 57, rule 9(1), is my application to set aside the registration made by summons supported by an affidavit` TRUE TRUE EQUALS JUST TRUE
-- Case: by summons but with no affidavit.
#ASSERT `Under Order 57, rule 9(1), is my application to set aside the registration made by summons supported by an affidavit` TRUE FALSE EQUALS NOTHING
-- Case: the issue is between the person and the complainant.
#ASSERT `Under Order 57, rule 9(2), may the Court order the issue between the parties to be tried as an issue in an action is tried` FALSE TRUE EQUALS JUST TRUE
-- Case: the issue is between neither pair.
#ASSERT `Under Order 57, rule 9(2), may the Court order the issue between the parties to be tried as an issue in an action is tried` FALSE FALSE EQUALS NOTHING
#ASSERT `Under Order 57, rule 9(3), may the Court set the registration aside on such terms as it thinks fit` TRUE EQUALS JUST TRUE

-- Rule 10.  The specified period expires on 20 November 2026.
#ASSERT `Under Order 57, rule 10(1), is an enforcement order barred against me because the period to apply to set aside has not yet expired` TRUE (Date 20 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `Under Order 57, rule 10(1), is an enforcement order barred against me because the period to apply to set aside has not yet expired` TRUE (Date 20 11 2026) (Date 21 11 2026) EQUALS JUST FALSE
-- Case: the order specifies no period: the bar's "Where" does not arise.
#ASSERT `Under Order 57, rule 10(1), is an enforcement order barred against me because the period to apply to set aside has not yet expired` FALSE (Date 20 11 2026) (Date 19 11 2026) EQUALS JUST FALSE
-- Case: the person's application to set aside is pending.
#ASSERT `Under Order 57, rule 10(2), is an enforcement order barred against me because my application to set aside has not yet been disposed of` TRUE FALSE EQUALS JUST TRUE
-- Case: it has been disposed of.
#ASSERT `Under Order 57, rule 10(2), is an enforcement order barred against me because my application to set aside has not yet been disposed of` TRUE TRUE EQUALS JUST FALSE

-- Rule 11(1)(a).  The Commission has not applied to register yet and is not applying together: "together with, or at any time after".
#ASSERT `Under Order 57, rule 11(1)(a), may the Commission apply against me for an order under section 48M(4) at this stage of its application to register` FALSE FALSE EQUALS JUST FALSE
-- Case: it applies together with its application to register.
#ASSERT `Under Order 57, rule 11(1)(a), may the Commission apply against me for an order under section 48M(4) at this stage of its application to register` FALSE TRUE EQUALS JUST TRUE
-- Case: it has already applied to register.
#ASSERT `Under Order 57, rule 11(1)(a), may the Commission apply against me for an order under section 48M(4) at this stage of its application to register` TRUE FALSE EQUALS JUST TRUE

-- Rule 11(2).  An application for an order under section 48M(4).
#ASSERT `Under Order 57, rule 11(2), may the Commission make its application against me for an order under section 48M(4) without notice` TRUE TRUE EQUALS JUST TRUE
-- Case: not urgent: "where the case is one of urgency, may be made without notice".
#ASSERT `Under Order 57, rule 11(2), may the Commission make its application against me for an order under section 48M(4) without notice` TRUE FALSE EQUALS JUST FALSE
-- Case: with notice is always permitted.
#ASSERT `Under Order 57, rule 11(2), may the Commission make its application against me for an order under section 48M(4) without notice` FALSE FALSE EQUALS JUST TRUE

-- Rule 12.  A claimant sues for relief under section 48O(1); the last day of the 14 days is 15 December 2026.
#ASSERT `Under Order 57, rule 12, must I serve the Commission with a copy of my originating claim or originating application` TRUE EQUALS JUST TRUE
#ASSERT `Under Order 57, rule 12, must I serve the Commission with a copy of my originating claim or originating application` FALSE EQUALS JUST FALSE
#ASSERT `Under Order 57, rule 12, did I serve a copy of my originating claim or originating application on the Commission in time` TRUE (Date 15 12 2026) (Date 15 12 2026) EQUALS JUST TRUE
#ASSERT `Under Order 57, rule 12, did I serve a copy of my originating claim or originating application on the Commission in time` TRUE (Date 16 12 2026) (Date 15 12 2026) EQUALS JUST FALSE
-- Case: the claim is not under section 48O(1).
#ASSERT `Under Order 57, rule 12, did I serve a copy of my originating claim or originating application on the Commission in time` FALSE (Date 16 12 2026) (Date 15 12 2026) EQUALS NOTHING

-- Rule 13.  A person granted a judgment under section 48O; the last day of the 3 days is 10 December 2026.
#ASSERT `Under Order 57, rule 13, must I transmit a copy of the judgment or order to the Commission` TRUE EQUALS JUST TRUE
#ASSERT `Under Order 57, rule 13, must I transmit a copy of the judgment or order to the Commission` FALSE EQUALS JUST FALSE
#ASSERT `Under Order 57, rule 13, did I transmit a copy of the judgment or order to the Commission in time` TRUE (Date 10 12 2026) (Date 10 12 2026) EQUALS JUST TRUE
#ASSERT `Under Order 57, rule 13, did I transmit a copy of the judgment or order to the Commission in time` TRUE (Date 11 12 2026) (Date 10 12 2026) EQUALS JUST FALSE
#ASSERT `Under Order 57, rule 13, did I transmit a copy of the judgment or order to the Commission in time` FALSE (Date 11 12 2026) (Date 10 12 2026) EQUALS NOTHING

