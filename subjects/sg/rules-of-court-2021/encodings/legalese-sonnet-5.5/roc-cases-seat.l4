-- ============================================================
-- roc10: this part's cases seat text, unchanged (merged by concatenation)
-- ============================================================
-- Rules of Court 2021 (Singapore), Orders 46, 46A, 47 to 56 -- CASES for the seat layer.
-- Each case is a question a party to a civil action would ask, with facts they can state and the answer the
-- text gives.  Every expected value is written beside its assertion, from the text of the Rule it cites
-- (lines 6102 to 6795 of the text), never copied from the output of the code.
-- Inputs are positional, in the order of the question's GIVEN lines.

-- ---------------------------------------------------------------------------
-- Order 46.  A claimant holds an order of the Commissioner for Labour made under the Employment Act and wants a
-- District Court to enforce it (lines 6102 to 6127 of the text).  Each expected value is written from the text.
-- ---------------------------------------------------------------------------
#ASSERT `Under Order 46, rule 1, do the Rules of Court apply to my proceedings under the Employment Act` TRUE EQUALS JUST TRUE -- r 1: proceedings under the Employment Act
#ASSERT `Under Order 46, rule 1, do the Rules of Court apply to my proceedings under the Employment Act` FALSE EQUALS NOTHING -- r 1: other proceedings are outside the scope, not covered
#ASSERT `Under Order 46, rule 2(1), must the Commissioner issue a certificate of the order` TRUE TRUE EQUALS JUST TRUE -- r 2(1): order made by the Commissioner, to be enforced in a District Court
#ASSERT `Under Order 46, rule 2(1), must the Commissioner issue a certificate of the order` TRUE FALSE EQUALS JUST FALSE -- r 2(1): not to be enforced in a District Court, so the "where" fails
#ASSERT `Under Order 46, rule 2(2), can the Court enforce the order as if it were a judgment of the Court` TRUE EQUALS JUST TRUE -- r 2(2): certificate and copy filed
#ASSERT `Under Order 46, rule 2(2), can the Court enforce the order as if it were a judgment of the Court` FALSE EQUALS JUST FALSE -- r 2(2): not filed, so the "where" fails
#ASSERT `Under Order 46, rule 3(1), does the certificate state what it must` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- r 3(1)(a) to (g) all stated
#ASSERT `Under Order 46, rule 3(1), does the certificate state what it must` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- r 3(1)(g) missing: a bare "must", not done
#ASSERT `Under Order 46, rule 3(4), has the certificate been sealed, dated and signed as it must be` TRUE TRUE TRUE EQUALS JUST TRUE -- r 3(4): sealed, dated and signed
#ASSERT `Under Order 46, rule 3(4), has the certificate been sealed, dated and signed as it must be` TRUE FALSE TRUE EQUALS NOTHING -- r 3(4): not dated
#ASSERT `Under Order 46, rule 4, must the sums recovered be paid to the Commissioner` TRUE FALSE EQUALS JUST TRUE -- r 4: a sum recovered, no other order
#ASSERT `Under Order 46, rule 4, must the sums recovered be paid to the Commissioner` TRUE TRUE EQUALS JUST FALSE -- r 4: "Unless the Commissioner otherwise orders"
#ASSERT `Under Order 46, rule 4, how much must be paid to the Commissioner` 2000 350 EQUALS 1650 -- r 4: $2,000 recovered, $350 costs, $1,650 to the Commissioner
#ASSERT `Under Order 46, rule 4, how much must be paid to the Commissioner` 300 350 EQUALS 0 -- r 4: costs above the sum recovered leave nothing to pay over

-- ---------------------------------------------------------------------------
-- Order 46A.  A claimant in a General Division action, started by originating claim, asks about the Express Track
-- (lines 6128 to 6174 of the text).  Each expected value is written from the text.
-- ---------------------------------------------------------------------------
-- r 1(1): the Order applies to a General Division action placed on the Express Track.
#ASSERT `Under Order 46A, rule 1(1), does Order 46A apply to my action` `General Division` TRUE EQUALS JUST TRUE -- r 1(1): General Division action, placed on the Express Track
#ASSERT `Under Order 46A, rule 1(1), does Order 46A apply to my action` `District Court` TRUE EQUALS NOTHING -- r 1(1): a District Court action is outside the scope
-- r 1(2): all parties request by consent no later than 2 months after the last pleading.  Last pleading filed on
-- 10 March 2026: the 2 months run from 11 March (O 3 r 3(3)) and end on Sunday 10 May, so the last day is Monday 11 May 2026.
#ASSERT `Under Order 46A, rule 1(2), may the Court place my action on the Express Track` `General Division` `Originating claim` TRUE (Date 4 5 2026) (Date 11 5 2026) EQUALS JUST TRUE -- r 1(2): joint request on 4 May, in time
#ASSERT `Under Order 46A, rule 1(2), may the Court place my action on the Express Track` `General Division` `Originating claim` TRUE (Date 12 5 2026) (Date 11 5 2026) EQUALS JUST FALSE -- r 1(2): joint request on 12 May, a day late
#ASSERT `Under Order 46A, rule 1(2), may the Court place my action on the Express Track` `General Division` `Originating claim` FALSE (Date 4 5 2026) (Date 11 5 2026) EQUALS NOTHING -- r 1(2): not all parties consent, so the grant is not engaged
#ASSERT `Under Order 46A, rule 1(2), may the Court place my action on the Express Track` `General Division` `Originating application` TRUE (Date 4 5 2026) (Date 11 5 2026) EQUALS JUST FALSE -- r 1(2): commenced by originating application, so the "where" fails
#ASSERT `Under Order 46A, rule 1(2), how many months after the last pleading is filed may we request the Express Track` EQUALS 2 -- r 1(2): "no later than 2 months"
-- r 1(3): removal no later than 14 days before the trial, if the Court determines the action is no longer suitable.
#ASSERT `Under Order 46A, rule 1(3), may the Court order the removal of my action from the Express Track` TRUE (Date 6 7 2026) (Date 6 7 2026) TRUE EQUALS JUST TRUE -- r 1(3): on the last day, unsuitable
#ASSERT `Under Order 46A, rule 1(3), may the Court order the removal of my action from the Express Track` TRUE (Date 7 7 2026) (Date 6 7 2026) TRUE EQUALS JUST FALSE -- r 1(3): a day after the last day
#ASSERT `Under Order 46A, rule 1(3), may the Court order the removal of my action from the Express Track` TRUE (Date 6 7 2026) (Date 6 7 2026) FALSE EQUALS JUST FALSE -- r 1(3): the Court has not determined that the action is no longer suitable
-- r 1(4): the decision of a Judge in the General Division is final.
#ASSERT `Under Order 46A, rule 1(4), is the decision of the Judge final` `General Division` `A Judge` TRUE FALSE EQUALS JUST TRUE -- r 1(4): a Judge in the General Division removed the action from the Express Track
#ASSERT `Under Order 46A, rule 1(4), is the decision of the Judge final` `General Division` `A Judge` FALSE TRUE EQUALS JUST TRUE -- r 1(4): the Judge declined despite a request
#ASSERT `Under Order 46A, rule 1(4), is the decision of the Judge final` `General Division` `A Judge` FALSE FALSE EQUALS JUST FALSE -- r 1(4): some other decision
#ASSERT `Under Order 46A, rule 1(4), is the decision of the Judge final` `District Court` `A District Judge` TRUE FALSE EQUALS JUST FALSE -- r 1(4): not a Judge sitting in the General Division
-- r 1(5): no appeal against a Judge's decision in an Express Track action except in the circumstances in the Supreme Court of Judicature Act.
#ASSERT `Under Order 46A, rule 1(5), can an appeal be brought against the decision` TRUE TRUE `roc10 no` EQUALS JUST FALSE -- r 1(5): the bar applies and the circumstances are absent
#ASSERT `Under Order 46A, rule 1(5), can an appeal be brought against the decision` TRUE TRUE `roc10 yes` EQUALS NOTHING -- r 1(5): the circumstances exist; the bar is lifted, nothing is granted
#ASSERT `Under Order 46A, rule 1(5), can an appeal be brought against the decision` TRUE TRUE `roc10 I am not sure` EQUALS NOTHING -- r 1(5): the circumstances are in another Act and not supplied
#ASSERT `Under Order 46A, rule 1(5), is an appeal barred` TRUE TRUE `roc10 no` EQUALS JUST TRUE -- r 1(5): barred
#ASSERT `Under Order 46A, rule 1(5), is an appeal barred` TRUE TRUE `roc10 yes` EQUALS JUST FALSE -- r 1(5): "except in the circumstances set out in that sub-paragraph"
-- r 1(7): on the Express Track from the placing order until the removal order.
#ASSERT `Under Order 46A, rule 1(7), is my action on the Express Track on the date I ask about` TRUE (Date 1 6 2026) FALSE (Date 1 1 2020) (Date 15 6 2026) EQUALS JUST TRUE -- r 1(7): placed on 1 June, not removed, asked about 15 June
#ASSERT `Under Order 46A, rule 1(7), is my action on the Express Track on the date I ask about` TRUE (Date 1 6 2026) TRUE (Date 1 8 2026) (Date 1 8 2026) EQUALS JUST FALSE -- r 1(7): on the day of the removal order the Order ceases to apply
#ASSERT `Under Order 46A, rule 1(7), is my action on the Express Track on the date I ask about` FALSE (Date 1 1 2020) FALSE (Date 1 1 2020) (Date 15 6 2026) EQUALS JUST FALSE -- r 1(7): no order placing the action has been made: a "when" condition unmet (fork 46A.5)
-- r 2: documents with pleadings.  Action placed on 1 June 2026.
#ASSERT `Under Order 46A, rule 2(a), must my pleading be accompanied by a list and a copy of every document I rely on` FALSE TRUE (Date 5 6 2026) (Date 1 6 2026) EQUALS JUST TRUE -- r 2(a): pleading served after placement
#ASSERT `Under Order 46A, rule 2(a), must my pleading be accompanied by a list and a copy of every document I rely on` FALSE TRUE (Date 20 5 2026) (Date 1 6 2026) EQUALS JUST FALSE -- r 2(a): served before placement, so paragraph (b) applies instead
#ASSERT `Under Order 46A, rule 2(a), must my pleading be accompanied by a list and a copy of every document I rely on` TRUE TRUE (Date 5 6 2026) (Date 1 6 2026) EQUALS JUST FALSE -- r 2(a): the Court ordered otherwise
#ASSERT `Under Order 46A, rule 2(a), has my pleading been accompanied as it must be` FALSE TRUE (Date 5 6 2026) (Date 1 6 2026) TRUE TRUE EQUALS JUST TRUE -- r 2(a): list and copy supplied
#ASSERT `Under Order 46A, rule 2(a), has my pleading been accompanied as it must be` FALSE TRUE (Date 5 6 2026) (Date 1 6 2026) TRUE FALSE EQUALS NOTHING -- r 2(a): a copy is missing: a bare "must", not done
#ASSERT `Under Order 46A, rule 2(b), must I serve a list of and copies of the documents I rely on` FALSE TRUE TRUE EQUALS JUST TRUE -- r 2(b): a pleading was already served before placement
#ASSERT `Under Order 46A, rule 2(b), must I serve a list of and copies of the documents I rely on` FALSE TRUE FALSE EQUALS JUST FALSE -- r 2(b): no earlier pleading, so the "where" fails
#ASSERT `Under Order 46A, rule 2(b), within how many days must I serve the list and copies` EQUALS 14 -- r 2(b): "within 14 days"
#ASSERT `Under Order 46A, rule 2(b), did I serve the list and copies as required` FALSE TRUE TRUE (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- r 2(b): served on the 14th day
#ASSERT `Under Order 46A, rule 2(b), did I serve the list and copies as required` FALSE TRUE TRUE (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- r 2(b): a day late
-- r 3: affidavits of evidence-in-chief.
#ASSERT `Under Order 46A, rule 3(2), must the Court order me to file and serve my list of witnesses and affidavits` FALSE TRUE FALSE EQUALS JUST TRUE -- r 3(2): pleadings filed and served, no exchange of documents yet
#ASSERT `Under Order 46A, rule 3(2), must the Court order me to file and serve my list of witnesses and affidavits` FALSE TRUE TRUE EQUALS JUST FALSE -- r 3(2): documents have already been exchanged
#ASSERT `Under Order 46A, rule 3(2)(b), must I file and serve the affidavit of evidence-in-chief of the witness` FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- r 3(2)(b): not dispensed with
#ASSERT `Under Order 46A, rule 3(2)(b), must I file and serve the affidavit of evidence-in-chief of the witness` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- r 3(2)(b): the Court dispensed with the affidavit
#ASSERT `Under Order 46A, rule 3(3), how many pages may the affidavit of each witness run to` EQUALS 30 -- r 3(3): "30 pages"
#ASSERT `Under Order 46A, rule 3(3), is the affidavit within the page limit` FALSE 70 40 EQUALS JUST TRUE -- r 3(3): 70 pages with 40 of exhibits is 30 pages "excluding exhibits"
#ASSERT `Under Order 46A, rule 3(3), is the affidavit within the page limit` FALSE 71 40 EQUALS JUST FALSE -- r 3(3): 31 pages excluding exhibits
#ASSERT `Under Order 46A, rule 3(4), may the Court allow the page limit to be exceeded` TRUE TRUE FALSE EQUALS JUST TRUE -- r 3(4): special circumstances and the fees paid
#ASSERT `Under Order 46A, rule 3(4), may the Court allow the page limit to be exceeded` FALSE TRUE FALSE EQUALS NOTHING -- r 3(4): no special circumstances
#ASSERT `Under Order 46A, rule 3(4), may the Court allow the page limit to be exceeded` TRUE FALSE FALSE EQUALS JUST FALSE -- r 3(4): special circumstances but the fees neither paid nor waived: "upon the payment of the fees"
#ASSERT `Under Order 46A, rule 3(5), may the Court waive, refund, defer or apportion the fees` TRUE EQUALS JUST TRUE -- r 3(5): on my application
#ASSERT `Under Order 46A, rule 3(5), may the Court waive, refund, defer or apportion the fees` FALSE EQUALS JUST FALSE -- r 3(5): no application: "upon application"
-- r 4: interlocutory applications.  Case conference on 1 June 2026.
#ASSERT `Under Order 46A, rule 4(1), does Order 9, Rule 9 continue to apply to my action` TRUE FALSE EQUALS JUST TRUE -- r 4(1): Express Track action, nothing otherwise provided
#ASSERT `Under Order 46A, rule 4(2), must the Court give directions on when my application and the replies are to be filed` TRUE TRUE FALSE EQUALS JUST TRUE -- r 4(2): notified at a case conference
#ASSERT `Under Order 46A, rule 4(2), must the Court give directions on when my application and the replies are to be filed` FALSE TRUE FALSE EQUALS JUST FALSE -- r 4(2): not notified at a case conference
#ASSERT `Under Order 46A, rule 4(2)(a), within how many days after the case conference must I file and serve my application` EQUALS 14 -- r 4(2)(a): "within 14 days"
#ASSERT `Under Order 46A, rule 4(2)(a), did I file and serve my application and affidavit within the period directed` (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- r 4(2)(a): on the 14th day
#ASSERT `Under Order 46A, rule 4(2)(a), did I file and serve my application and affidavit within the period directed` (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- r 4(2)(a): late
#ASSERT `Under Order 46A, rule 4(2)(b), within how many days after the case conference must an affidavit in reply be filed` EQUALS 28 -- r 4(2)(b): "within 28 days"
#ASSERT `Under Order 46A, rule 4(2)(b), did I file and serve my affidavit in reply within the period directed` (Date 29 6 2026) (Date 29 6 2026) EQUALS JUST TRUE -- r 4(2)(b): on the 28th day
#ASSERT `Under Order 46A, rule 4(2)(b), did I file and serve my affidavit in reply within the period directed` (Date 30 6 2026) (Date 29 6 2026) EQUALS JUST FALSE -- r 4(2)(b): late
#ASSERT `Under Order 46A, rule 4(2)(c), is a further affidavit barred without the Court's approval` FALSE EQUALS JUST TRUE -- r 4(2)(c): no approval, so barred
#ASSERT `Under Order 46A, rule 4(2)(c), is a further affidavit barred without the Court's approval` TRUE EQUALS JUST FALSE -- r 4(2)(c): approved, so not barred by this paragraph
