IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc11-order-61`

-- TESTS for Order 61 (Securities and Futures Act, civil liability actions).  Every expected value is written from
-- the text of the rule, beside the assertion, before the code was run.  The "last day" inputs are made-up dates:
-- the merged file replaces them with calls to roc1's O 3 r 3.

-- ---------------------------------------------------------------------------
§ `Order 61 rule 1 -- definitions and application`
-- ---------------------------------------------------------------------------
#ASSERT `o 61 r 1(1) the Act` EQUALS "the Securities and Futures Act"
#ASSERT `o 61 r 1(1) a reference to a section is a reference to a section in the Act` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 1(1) a reference to a section is a reference to a section in the Act` FALSE FALSE EQUALS NOTHING
#ASSERT `o 61 r 1(1) a reference to a section is a reference to a section in the Act` TRUE TRUE EQUALS NOTHING
-- "claimant": limbs (a) to (e).
#ASSERT `o 61 r 1(1) "claimant" the section that gives its meaning` `o 61 r 1 a proceeding under section 234` EQUALS JUST "section 234(1)"
#ASSERT `o 61 r 1(1) "claimant" the section that gives its meaning` `o 61 r 1 a proceeding under section 235` EQUALS JUST "section 234(1)"
#ASSERT `o 61 r 1(1) "claimant" the section that gives its meaning` `o 61 r 1 a proceeding under section 236` EQUALS JUST "section 234(1)"
#ASSERT `o 61 r 1(1) "claimant" the section that gives its meaning` `o 61 r 1 a proceeding under section 236D` EQUALS JUST "section 236D(1)"
#ASSERT `o 61 r 1(1) "claimant" the section that gives its meaning` `o 61 r 1 a proceeding under section 236G` EQUALS JUST "section 236G(1)"
#ASSERT `o 61 r 1(1) "claimant" the section that gives its meaning` `o 61 r 1 a proceeding under section 236I` EQUALS JUST "section 236I(1)"
#ASSERT `o 61 r 1(1) "claimant" the section that gives its meaning` `o 61 r 1 a proceeding under section 236K` EQUALS JUST "section 236K(3)"
-- No limb speaks of a proceeding under section 236J, or of any other section.
#ASSERT `o 61 r 1(1) "claimant" the section that gives its meaning` `o 61 r 1 a proceeding under section 236J` EQUALS NOTHING
#ASSERT `o 61 r 1(1) "claimant" the section that gives its meaning` `o 61 r 1 a proceeding under another section` EQUALS NOTHING
-- "contravening person": limbs (a) to (f).
#ASSERT `o 61 r 1(1) "contravening person" the section that gives its meaning` `o 61 r 1 a proceeding under section 236` EQUALS JUST "section 234(1)"
#ASSERT `o 61 r 1(1) "contravening person" the section that gives its meaning` `o 61 r 1 a proceeding under section 236D` EQUALS JUST "section 236B(1) or 236C(1), as the case may be"
#ASSERT `o 61 r 1(1) "contravening person" the section that gives its meaning` `o 61 r 1 a proceeding under section 236G` EQUALS JUST "section 236E(1) or 236F(1), as the case may be"
#ASSERT `o 61 r 1(1) "contravening person" the section that gives its meaning` `o 61 r 1 a proceeding under section 236I` EQUALS JUST "section 236H(1)"
#ASSERT `o 61 r 1(1) "contravening person" the section that gives its meaning` `o 61 r 1 a proceeding under section 236J` EQUALS JUST "section 236B(1), 236C(1), 236E(1), 236F(1) or 236H(1), as the case may be"
#ASSERT `o 61 r 1(1) "contravening person" the section that gives its meaning` `o 61 r 1 a proceeding under section 236K` EQUALS JUST "section 236B(1), 236C(1), 236E(1), 236F(1) or 236H(1), as the case may be"
#ASSERT `o 61 r 1(1) "contravening person" the section that gives its meaning` `o 61 r 1 a proceeding under another section` EQUALS NOTHING
#ASSERT `o 61 r 1(1) "defendant corporation" the section that gives its meaning` EQUALS "section 236A"
#ASSERT `o 61 r 1(1) "defendant partnership" the section that gives its meaning` EQUALS "section 236A"
-- "defendant individual" means an individual liable to a civil penalty order under section 236H for a Part XII contravention committed by an organisation.
#ASSERT `o 61 r 1(1) "defendant individual" the person is a defendant individual` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 1(1) "defendant individual" the person is a defendant individual` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 61 r 1(1) "defendant individual" the person is a defendant individual` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 61 r 1(1) "defendant individual" the person is a defendant individual` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 61 r 1(1) "defendant individual" the person is a defendant individual` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- (2): the Rules apply to proceedings under the eight sections.
#ASSERT `o 61 r 1(2) these Rules apply to the proceeding` `o 61 r 1 a proceeding under section 234` EQUALS JUST TRUE
#ASSERT `o 61 r 1(2) these Rules apply to the proceeding` `o 61 r 1 a proceeding under section 236J` EQUALS JUST TRUE
#ASSERT `o 61 r 1(2) these Rules apply to the proceeding` `o 61 r 1 a proceeding under section 236K` EQUALS JUST TRUE
#ASSERT `o 61 r 1(2) these Rules apply to the proceeding` `o 61 r 1 a proceeding under another section` EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 61 rule 2 -- commencement`
-- ---------------------------------------------------------------------------
-- (1): an action under section 234, 236D, 236G or 236I.
#ASSERT `o 61 r 2(1) the action is one that the Rule names` `o 61 r 1 a proceeding under section 234` EQUALS TRUE
#ASSERT `o 61 r 2(1) the action is one that the Rule names` `o 61 r 1 a proceeding under section 236D` EQUALS TRUE
#ASSERT `o 61 r 2(1) the action is one that the Rule names` `o 61 r 1 a proceeding under section 236G` EQUALS TRUE
#ASSERT `o 61 r 2(1) the action is one that the Rule names` `o 61 r 1 a proceeding under section 236I` EQUALS TRUE
#ASSERT `o 61 r 2(1) the action is one that the Rule names` `o 61 r 1 a proceeding under section 235` EQUALS FALSE
#ASSERT `o 61 r 2(1) the action is one that the Rule names` `o 61 r 1 a proceeding under section 236K` EQUALS FALSE
#ASSERT `o 61 r 2(1) the action is commenced as the Rule requires` `o 61 r 1 a proceeding under section 234` `Originating claim` EQUALS JUST TRUE
#ASSERT `o 61 r 2(1) the action is commenced as the Rule requires` `o 61 r 1 a proceeding under section 236I` `Originating claim` EQUALS JUST TRUE
#ASSERT `o 61 r 2(1) the action is commenced as the Rule requires` `o 61 r 1 a proceeding under section 234` `Originating application` EQUALS NOTHING
-- Not an action under one of the four sections.
#ASSERT `o 61 r 2(1) the action is commenced as the Rule requires` `o 61 r 1 a proceeding under section 236K` `Originating claim` EQUALS NOTHING
-- (2): the application for permission.
#ASSERT `o 61 r 2(2) the application for permission is made as the Rule requires` TRUE `Originating application` TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 2(2) the application for permission is made as the Rule requires` TRUE `Originating claim` TRUE EQUALS NOTHING
#ASSERT `o 61 r 2(2) the application for permission is made as the Rule requires` TRUE `Originating application` FALSE EQUALS NOTHING
#ASSERT `o 61 r 2(2) the application for permission is made as the Rule requires` FALSE `Originating application` TRUE EQUALS NOTHING
-- (3): other Orders apply unless this Rule expressly modifies them.
#ASSERT `o 61 r 2(3) the provision applies to the originating application` TRUE "Order 6 rule 11" FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 2(3) the provision applies to the originating application` TRUE "Order 6 rule 14" FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 2(3) the provision applies to the originating application` TRUE "Order 9" FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 2(3) the provision applies to the originating application` TRUE "Order 15 rule 7" FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 2(3) the provision applies to the originating application` TRUE "Order 9" TRUE EQUALS JUST FALSE
#ASSERT `o 61 r 2(3) the provision applies to the originating application` TRUE "Order 6 rule 10" FALSE EQUALS NOTHING
#ASSERT `o 61 r 2(3) the provision applies to the originating application` FALSE "Order 9" FALSE EQUALS NOTHING
-- (4): the affidavit.
#ASSERT count (`o 61 r 2(4) the matters the affidavit has not yet set out` (`o 61 r 2(4) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE)) EQUALS 0
#ASSERT count (`o 61 r 2(4) the matters the affidavit has not yet set out` (`o 61 r 2(4) affidavit` OF TRUE, FALSE, TRUE, FALSE, TRUE)) EQUALS 2
#ASSERT elem "(d) particulars of the loss suffered" (`o 61 r 2(4) the matters the affidavit has not yet set out` (`o 61 r 2(4) affidavit` OF TRUE, FALSE, TRUE, FALSE, TRUE))
#ASSERT count (`o 61 r 2(4) the matters the affidavit has not yet set out` (`o 61 r 2(4) affidavit` OF FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 5
#ASSERT `o 61 r 2(4) the affidavit supporting the application sets out what the Rule requires` (`o 61 r 2(4) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 61 r 2(4) the affidavit supporting the application sets out what the Rule requires` (`o 61 r 2(4) affidavit` OF TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING
-- (5): served "only" on the named person unless the Court directs.
#ASSERT `o 61 r 2(5) the application is served as the Rule requires in the first instance` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 2(5) the application is served as the Rule requires in the first instance` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 2(5) the application is served as the Rule requires in the first instance` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 61 r 2(5) the application is served as the Rule requires in the first instance` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 61 r 2(5) the application is served as the Rule requires in the first instance` FALSE FALSE FALSE EQUALS NOTHING
-- (6): the application to continue a stayed action.
#ASSERT `o 61 r 2(6) the application to continue the stayed action is made as the Rule requires` TRUE Summons TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 2(6) the application to continue the stayed action is made as the Rule requires` TRUE `Originating application` TRUE TRUE EQUALS NOTHING
#ASSERT `o 61 r 2(6) the application to continue the stayed action is made as the Rule requires` TRUE Summons FALSE TRUE EQUALS NOTHING
#ASSERT `o 61 r 2(6) the application to continue the stayed action is made as the Rule requires` TRUE Summons TRUE FALSE EQUALS NOTHING
#ASSERT `o 61 r 2(6) the application to continue the stayed action is made as the Rule requires` FALSE Summons TRUE TRUE EQUALS NOTHING
-- (7): served only on the defendant unless the Court directs.
#ASSERT `o 61 r 2(7) the application to continue is served as the Rule requires in the first instance` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 2(7) the application to continue is served as the Rule requires in the first instance` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 61 r 2(7) the application to continue is served as the Rule requires in the first instance` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 2(7) the application to continue is served as the Rule requires in the first instance` FALSE FALSE FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 61 rule 3 -- application for directions`
-- ---------------------------------------------------------------------------
-- (1): who may apply.  Arguments: seeks compensation; convicted; civil penalty order; made by default or consent.
#ASSERT `o 61 r 3(1) the claimant may apply for directions on claims for compensation` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 3(1) the claimant may apply for directions on claims for compensation` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- The civil penalty order was made by way of default judgment or consent order: "(other than ...)" takes it out of the grant.
#ASSERT `o 61 r 3(1) the claimant may apply for directions on claims for compensation` TRUE FALSE TRUE TRUE EQUALS NOTHING
-- Convicted: the conviction limb (a) holds whatever the order.
#ASSERT `o 61 r 3(1) the claimant may apply for directions on claims for compensation` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- Neither a conviction nor an order.
#ASSERT `o 61 r 3(1) the claimant may apply for directions on claims for compensation` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- Not a claimant seeking compensation.
#ASSERT `o 61 r 3(1) the claimant may apply for directions on claims for compensation` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `o 61 r 3(1) the Court may fix a return date for hearing the application` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 3(1) the Court may fix a return date for hearing the application` TRUE FALSE EQUALS NOTHING
#ASSERT `o 61 r 3(1) the Court may fix a return date for hearing the application` FALSE TRUE EQUALS NOTHING
-- (2): the bar until the conviction or order is final.
#ASSERT `o 61 r 3(2) an application cannot yet be made because the conviction or order is not yet final` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 3(2) an application cannot yet be made because the conviction or order is not yet final` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 61 r 3(2) an application cannot yet be made because the conviction or order is not yet final` FALSE FALSE EQUALS JUST FALSE
-- (3) and (4).
#ASSERT `o 61 r 3(3) the application for directions is made as the Rule requires` TRUE `Originating application` EQUALS JUST TRUE
#ASSERT `o 61 r 3(3) the application for directions is made as the Rule requires` TRUE Summons EQUALS NOTHING
#ASSERT `o 61 r 3(3) the application for directions is made as the Rule requires` FALSE `Originating application` EQUALS NOTHING
#ASSERT `o 61 r 3(4) the provision applies to the originating application` TRUE "Order 6 rule 12" FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 3(4) the provision applies to the originating application` TRUE "Order 15 rule 7" TRUE EQUALS JUST FALSE
#ASSERT `o 61 r 3(4) the provision applies to the originating application` TRUE "Order 8" FALSE EQUALS NOTHING
#ASSERT `o 61 r 3(4) the provision applies to the originating application` FALSE "Order 9" FALSE EQUALS NOTHING
-- (5): personal service at least 28 clear days before the return date; the last day for serving is 20 November 2026.
#ASSERT `o 61 r 3(5) the period for serving the application before the return date`'s `period length` EQUALS 28
#ASSERT `o 61 r 3(5) the period for serving the application before the return date`'s `period unit` EQUALS `Clear days`
#ASSERT `o 61 r 3(5) the duty to serve the application personally in time arises` FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 3(5) the duty to serve the application personally in time arises` TRUE EQUALS JUST FALSE
#ASSERT `o 61 r 3(5) the application is served as the Rule requires` FALSE TRUE (Date 19 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `o 61 r 3(5) the application is served as the Rule requires` FALSE TRUE (Date 20 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `o 61 r 3(5) the application is served as the Rule requires` FALSE TRUE (Date 21 11 2026) (Date 20 11 2026) EQUALS JUST FALSE
-- Served in time but not personally.
#ASSERT `o 61 r 3(5) the application is served as the Rule requires` FALSE FALSE (Date 19 11 2026) (Date 20 11 2026) EQUALS NOTHING
-- The Court otherwise orders: the duty does not arise.
#ASSERT `o 61 r 3(5) the application is served as the Rule requires` TRUE FALSE (Date 21 11 2026) (Date 20 11 2026) EQUALS NOTHING
#ASSERT `o 61 r 3(5) the claimant complied with paragraph (5)` FALSE TRUE (Date 20 11 2026) (Date 20 11 2026) EQUALS TRUE
#ASSERT `o 61 r 3(5) the claimant complied with paragraph (5)` FALSE TRUE (Date 21 11 2026) (Date 20 11 2026) EQUALS FALSE
#ASSERT `o 61 r 3(5) the claimant complied with paragraph (5)` FALSE FALSE (Date 19 11 2026) (Date 20 11 2026) EQUALS FALSE
#ASSERT `o 61 r 3(5) the claimant complied with paragraph (5)` TRUE FALSE (Date 25 11 2026) (Date 20 11 2026) EQUALS TRUE
-- (6): advertised in Form 91 at least 21 clear days before the return date; the last day is 27 November 2026.
#ASSERT `o 61 r 3(6) the form of the advertisement` EQUALS "91"
#ASSERT `o 61 r 3(6) the period for advertising the application before the return date`'s `period length` EQUALS 21
#ASSERT `o 61 r 3(6) the application is advertised as the Rule requires` TRUE TRUE FALSE (Date 27 11 2026) (Date 27 11 2026) EQUALS JUST TRUE
#ASSERT `o 61 r 3(6) the application is advertised as the Rule requires` TRUE FALSE TRUE (Date 26 11 2026) (Date 27 11 2026) EQUALS JUST TRUE
#ASSERT `o 61 r 3(6) the application is advertised as the Rule requires` TRUE TRUE FALSE (Date 28 11 2026) (Date 27 11 2026) EQUALS JUST FALSE
-- In time, but not in Form 91, or in neither kind of newspaper.
#ASSERT `o 61 r 3(6) the application is advertised as the Rule requires` FALSE TRUE FALSE (Date 26 11 2026) (Date 27 11 2026) EQUALS NOTHING
#ASSERT `o 61 r 3(6) the application is advertised as the Rule requires` TRUE FALSE FALSE (Date 26 11 2026) (Date 27 11 2026) EQUALS NOTHING
#ASSERT `o 61 r 3(6) the claimant complied with paragraph (6)` TRUE TRUE FALSE (Date 27 11 2026) (Date 27 11 2026) EQUALS TRUE
#ASSERT `o 61 r 3(6) the claimant complied with paragraph (6)` TRUE TRUE FALSE (Date 28 11 2026) (Date 27 11 2026) EQUALS FALSE
-- (7): what the advertisement states.
#ASSERT count (`o 61 r 3(7) the matters the advertisement has not yet stated` (`o 61 r 3(7) advertisement` OF TRUE, TRUE, TRUE, TRUE)) EQUALS 0
#ASSERT count (`o 61 r 3(7) the matters the advertisement has not yet stated` (`o 61 r 3(7) advertisement` OF TRUE, TRUE, FALSE, FALSE)) EQUALS 0
#ASSERT count (`o 61 r 3(7) the matters the advertisement has not yet stated` (`o 61 r 3(7) advertisement` OF FALSE, TRUE, TRUE, FALSE)) EQUALS 2
#ASSERT elem "the name and address of the applicant's solicitor" (`o 61 r 3(7) the matters the advertisement has not yet stated` (`o 61 r 3(7) advertisement` OF FALSE, TRUE, TRUE, FALSE))
#ASSERT count (`o 61 r 3(7) the matters the advertisement has not yet stated` (`o 61 r 3(7) advertisement` OF FALSE, FALSE, FALSE, FALSE)) EQUALS 2
#ASSERT `o 61 r 3(7) the advertisement states what the Rule requires` (`o 61 r 3(7) advertisement` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 61 r 3(7) the advertisement states what the Rule requires` (`o 61 r 3(7) advertisement` OF TRUE, FALSE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `o 61 r 3(7) the claimant complied with paragraph (7)` (`o 61 r 3(7) advertisement` OF TRUE, TRUE, FALSE, FALSE) EQUALS TRUE
#ASSERT `o 61 r 3(7) the claimant complied with paragraph (7)` (`o 61 r 3(7) advertisement` OF TRUE, FALSE, FALSE, FALSE) EQUALS FALSE
-- (8): deemed dismissed unless the Court otherwise directs.
#ASSERT `o 61 r 3(8) the application is deemed dismissed` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 61 r 3(8) the application is deemed dismissed` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 3(8) the application is deemed dismissed` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 3(8) the application is deemed dismissed` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 3(8) the application is deemed dismissed` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- The Court otherwise directs: the deeming does not apply.
#ASSERT `o 61 r 3(8) the application is deemed dismissed` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 61 r 3(8) the Court must cancel the appointment of the time and place for the hearing` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 3(8) the Court must cancel the appointment of the time and place for the hearing` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- The Court otherwise directs: read as lifting the cancellation too (the trailing "unless" qualifies both limbs).
#ASSERT `o 61 r 3(8) the Court must cancel the appointment of the time and place for the hearing` FALSE TRUE TRUE TRUE EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§ `Order 61 rule 4 -- proof of claim`
-- ---------------------------------------------------------------------------
#ASSERT `o 61 r 4(1) the period for filing the affidavit of claim before the return date`'s `period length` EQUALS 7
#ASSERT `o 61 r 4(1) the period for filing the affidavit of claim before the return date`'s `period unit` EQUALS `Clear days`
#ASSERT `o 61 r 4(1) the duty to file an affidavit of claim arises` TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 4(1) the duty to file an affidavit of claim arises` FALSE EQUALS JUST FALSE
-- The last day for filing is 4 December 2026 (made up).
#ASSERT `o 61 r 4(1) the claimant files the affidavit of claim in time` TRUE (JUST (Date 4 12 2026)) (Date 5 12 2026) (Date 4 12 2026) EQUALS JUST TRUE
#ASSERT `o 61 r 4(1) the claimant files the affidavit of claim in time` TRUE (JUST (Date 3 12 2026)) (Date 5 12 2026) (Date 4 12 2026) EQUALS JUST TRUE
#ASSERT `o 61 r 4(1) the claimant files the affidavit of claim in time` TRUE (JUST (Date 5 12 2026)) (Date 5 12 2026) (Date 4 12 2026) EQUALS JUST FALSE
-- Not filed yet: still time, then too late.
#ASSERT `o 61 r 4(1) the claimant files the affidavit of claim in time` TRUE NOTHING (Date 4 12 2026) (Date 4 12 2026) EQUALS NOTHING
#ASSERT `o 61 r 4(1) the claimant files the affidavit of claim in time` TRUE NOTHING (Date 5 12 2026) (Date 4 12 2026) EQUALS JUST FALSE
-- The claimant does not desire to claim: the duty does not arise.
#ASSERT `o 61 r 4(1) the claimant files the affidavit of claim in time` FALSE NOTHING (Date 5 12 2026) (Date 4 12 2026) EQUALS NOTHING
-- (2): the affidavit's contents.
#ASSERT count (`o 61 r 4(2) the matters the affidavit has not yet covered` (`o 61 r 4(2) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)) EQUALS 0
#ASSERT count (`o 61 r 4(2) the matters the affidavit has not yet covered` (`o 61 r 4(2) affidavit` OF FALSE, TRUE, TRUE, TRUE, FALSE, TRUE)) EQUALS 2
#ASSERT elem "supported by the relevant exhibits" (`o 61 r 4(2) the matters the affidavit has not yet covered` (`o 61 r 4(2) affidavit` OF FALSE, TRUE, TRUE, TRUE, FALSE, TRUE))
#ASSERT elem "(c) circumstances leading to the loss suffered" (`o 61 r 4(2) the matters the affidavit has not yet covered` (`o 61 r 4(2) affidavit` OF FALSE, TRUE, TRUE, TRUE, FALSE, TRUE))
#ASSERT count (`o 61 r 4(2) the matters the affidavit has not yet covered` (`o 61 r 4(2) affidavit` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 6
#ASSERT `o 61 r 4(2) the affidavit of claim covers what the Rule requires` (`o 61 r 4(2) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 61 r 4(2) the affidavit of claim covers what the Rule requires` (`o 61 r 4(2) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING
-- (3): the exhibits.
#ASSERT `o 61 r 4(3) the exhibits may include` `o 61 r 4(3)(a) trade notes or slips` EQUALS JUST TRUE
#ASSERT `o 61 r 4(3) the exhibits may include` `o 61 r 4(3)(b) statements of accounts for the relevant period` EQUALS JUST TRUE
#ASSERT `o 61 r 4(3) the exhibits may include` `o 61 r 4(3)(c) copies of instructions given to a broker or remisier` EQUALS JUST TRUE
#ASSERT `o 61 r 4(3) the exhibits may include` `o 61 r 4(3) another exhibit` EQUALS NOTHING
-- (4): serve a copy within 3 days of filing; the last day is 8 December 2026 (made up).
#ASSERT `o 61 r 4(4) the period for serving a copy of the affidavit on the subject`'s `period length` EQUALS 3
#ASSERT `o 61 r 4(4) the claimant serves a copy of the affidavit on the subject in time` (JUST (Date 8 12 2026)) (Date 9 12 2026) (Date 8 12 2026) EQUALS JUST TRUE
#ASSERT `o 61 r 4(4) the claimant serves a copy of the affidavit on the subject in time` (JUST (Date 9 12 2026)) (Date 9 12 2026) (Date 8 12 2026) EQUALS JUST FALSE
#ASSERT `o 61 r 4(4) the claimant serves a copy of the affidavit on the subject in time` NOTHING (Date 8 12 2026) (Date 8 12 2026) EQUALS NOTHING
#ASSERT `o 61 r 4(4) the claimant serves a copy of the affidavit on the subject in time` NOTHING (Date 9 12 2026) (Date 8 12 2026) EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§ `Order 61 rule 5 -- powers of the Court hearing the application`
-- ---------------------------------------------------------------------------
-- (1): the "where" condition.
#ASSERT `o 61 r 5(1) the Court may give directions or make orders on the hearing` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 5(1) the Court may give directions or make orders on the hearing` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 61 r 5(1) the Court may give directions or make orders on the hearing` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 61 r 5(1) the Court may give directions or make orders on the hearing` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 61 r 5(1) the Court may give this kind of direction or make this kind of order` `o 61 r 5(1)(a) for the filing of such further affidavit as the Court considers necessary` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 5(1) the Court may give this kind of direction or make this kind of order` `o 61 r 5(1)(c) that an issue between the claimants and the defendant be stated and tried` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 5(1) the Court may give this kind of direction or make this kind of order` `o 61 r 5(1)(g) that the application be dismissed` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- The condition is not met: no kind of direction.
#ASSERT `o 61 r 5(1) the Court may give this kind of direction or make this kind of order` `o 61 r 5(1)(d) that the matter be adjourned` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- A kind the list does not name: within the power only if the Court thinks it best adapted.
#ASSERT `o 61 r 5(1) the Court may give this kind of direction or make this kind of order` `o 61 r 5(1) another kind of direction or order` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 5(1) the Court may give this kind of direction or make this kind of order` `o 61 r 5(1) another kind of direction or order` TRUE TRUE TRUE FALSE EQUALS NOTHING
-- (2): against the contravening person.  Arguments: duly served; does not appear; appears but fails or refuses.
#ASSERT `o 61 r 5(2) the Court may make such order as it deems appropriate against the contravening person` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 5(2) the Court may make such order as it deems appropriate against the contravening person` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 5(2) the Court may make such order as it deems appropriate against the contravening person` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 61 r 5(2) the Court may make such order as it deems appropriate against the contravening person` FALSE TRUE FALSE EQUALS JUST FALSE
-- (3): against a claimant.  Arguments: filed an affidavit of claim; does not appear; appears but fails or refuses.
#ASSERT `o 61 r 5(3) the Court may declare the claimant forever barred` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 5(3) the Court may declare the claimant forever barred` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 5(3) the Court may declare the claimant forever barred` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 61 r 5(3) the Court may declare the claimant forever barred` FALSE TRUE FALSE EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§ `Order 61 rules 6 and 7`
-- ---------------------------------------------------------------------------
#ASSERT `o 61 r 6 the Court may make such order as to costs or any other matter as it thinks just` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 61 r 6 the Court may make such order as to costs or any other matter as it thinks just` TRUE TRUE EQUALS NOTHING
#ASSERT `o 61 r 6 the Court may make such order as to costs or any other matter as it thinks just` FALSE FALSE EQUALS NOTHING
#ASSERT `o 61 r 7(1) Order 15 applies to the trial of the issue` TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 7(1) Order 15 applies to the trial of the issue` FALSE EQUALS NOTHING
#ASSERT `o 61 r 7(2) the Court may give such judgment or make such order as finally to dispose of all questions` TRUE EQUALS JUST TRUE
#ASSERT `o 61 r 7(2) the Court may give such judgment or make such order as finally to dispose of all questions` FALSE EQUALS NOTHING
