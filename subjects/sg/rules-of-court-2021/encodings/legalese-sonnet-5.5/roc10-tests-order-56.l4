IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc10-order-56`

-- Rules of Court 2021 (Singapore), Order 56 (Partners): TESTS.
-- Every expected value is written beside its assertion from the text of the rule it cites (lines 6722 to 6795 of the text),
-- never copied from the output of the code.

-- Rule 1
#ASSERT `o 56 r 1 the least number of persons who may sue or be sued in the name of the firm` EQUALS 2 -- "any 2 or more persons"
#ASSERT `o 56 r 1 there are enough persons` 2 EQUALS TRUE -- 2 persons
#ASSERT `o 56 r 1 there are enough persons` 3 EQUALS TRUE -- 3 persons ("2 or more")
#ASSERT `o 56 r 1 there are enough persons` 1 EQUALS FALSE -- 1 person
#ASSERT `o 56 r 1 the persons may sue or be sued in the name of the firm` FALSE 2 TRUE TRUE TRUE EQUALS JUST TRUE -- 2 partners carrying on business here, in the firm name
#ASSERT `o 56 r 1 the persons may sue or be sued in the name of the firm` FALSE 3 TRUE TRUE TRUE EQUALS JUST TRUE -- 3 partners
#ASSERT `o 56 r 1 the persons may sue or be sued in the name of the firm` TRUE 2 TRUE TRUE TRUE EQUALS JUST FALSE -- "Subject to the provisions of any written law"
#ASSERT `o 56 r 1 the persons may sue or be sued in the name of the firm` FALSE 1 TRUE TRUE TRUE EQUALS NOTHING -- one person: outside "2 or more"
#ASSERT `o 56 r 1 the persons may sue or be sued in the name of the firm` FALSE 2 FALSE TRUE TRUE EQUALS NOTHING -- not claiming or alleged to be partners
#ASSERT `o 56 r 1 the persons may sue or be sued in the name of the firm` FALSE 2 TRUE FALSE TRUE EQUALS NOTHING -- not carrying on business within the jurisdiction
#ASSERT `o 56 r 1 the persons may sue or be sued in the name of the firm` FALSE 2 TRUE TRUE FALSE EQUALS NOTHING -- not the name of the firm at the time the cause of action accrued

-- Rule 2
#ASSERT `o 56 r 2(1) the defendant may serve on the claimants or their solicitor a notice requiring a written statement of the partners` TRUE TRUE EQUALS JUST TRUE -- a defendant to an action brought by partners
#ASSERT `o 56 r 2(1) the defendant may serve on the claimants or their solicitor a notice requiring a written statement of the partners` TRUE FALSE EQUALS NOTHING -- not a defendant
#ASSERT `o 56 r 2(1) the defendant may serve on the claimants or their solicitor a notice requiring a written statement of the partners` FALSE TRUE EQUALS NOTHING -- not an action brought by partners in the name of a firm
#ASSERT `o 56 r 2(1) the Court may make the order` TRUE TRUE FALSE `o 56 r 2(1)(a) an order in Form 84 to provide a statement of the names and places of residence of the partners and to verify it` EQUALS JUST TRUE -- notice not complied with: (a)
#ASSERT `o 56 r 2(1) the Court may make the order` TRUE TRUE FALSE `o 56 r 2(1)(b) an order that further proceedings in the action be stayed on such terms as the Court may direct` EQUALS JUST TRUE -- notice not complied with: (b)
#ASSERT `o 56 r 2(1) the Court may make the order` TRUE TRUE FALSE `o 56 r 2(1) another order` EQUALS NOTHING -- two orders named without "only"
#ASSERT `o 56 r 2(1) the Court may make the order` TRUE TRUE TRUE `o 56 r 2(1)(a) an order in Form 84 to provide a statement of the names and places of residence of the partners and to verify it` EQUALS JUST FALSE -- notice complied with: the "if" fails
#ASSERT `o 56 r 2(1) the Court may make the order` TRUE FALSE FALSE `o 56 r 2(1)(a) an order in Form 84 to provide a statement of the names and places of residence of the partners and to verify it` EQUALS JUST FALSE -- no notice served
#ASSERT `o 56 r 2(1) the Court may make the order` FALSE TRUE FALSE `o 56 r 2(1)(a) an order in Form 84 to provide a statement of the names and places of residence of the partners and to verify it` EQUALS NOTHING -- not an action brought by partners
#ASSERT `o 56 r 2(2) the proceedings must continue in the name of the firm` TRUE EQUALS JUST TRUE -- names declared
#ASSERT `o 56 r 2(2) the proceedings must continue in the name of the firm` FALSE EQUALS JUST FALSE -- "When the names of the partners have been declared" not met
#ASSERT `o 56 r 2(2) the consequences are the same as if the declared persons had been named as claimants in the originating claim` TRUE EQUALS JUST TRUE -- names declared
#ASSERT `o 56 r 2(2) the consequences are the same as if the declared persons had been named as claimants in the originating claim` FALSE EQUALS JUST FALSE -- names not declared
#ASSERT `o 56 r 2(3) paragraph (1) has effect in the action as it has in an action brought by partners` TRUE EQUALS JUST TRUE -- an action brought against partners
#ASSERT `o 56 r 2(3) paragraph (1) has effect in the action as it has in an action brought by partners` FALSE EQUALS NOTHING -- not such an action
#ASSERT `o 56 r 2(3)(a) the references to the defendant and the claimants are read as references to the claimant and the defendants` TRUE EQUALS JUST TRUE -- (a)
#ASSERT `o 56 r 2(3)(a) the references to the defendant and the claimants are read as references to the claimant and the defendants` FALSE EQUALS NOTHING -- not such an action
#ASSERT `o 56 r 2(3)(b) sub-paragraph (b) of paragraph (1) is omitted` TRUE EQUALS JUST TRUE -- (b)
#ASSERT `o 56 r 2(3)(b) sub-paragraph (b) of paragraph (1) is omitted` FALSE EQUALS NOTHING -- not such an action
#ASSERT `o 56 r 2(3) the Court may make the order in an action against partners` TRUE TRUE FALSE `o 56 r 2(1)(a) an order in Form 84 to provide a statement of the names and places of residence of the partners and to verify it` EQUALS JUST TRUE -- the Form 84 order
#ASSERT `o 56 r 2(3) the Court may make the order in an action against partners` TRUE TRUE FALSE `o 56 r 2(1)(b) an order that further proceedings in the action be stayed on such terms as the Court may direct` EQUALS JUST FALSE -- "sub-paragraph (b) of that paragraph is omitted"
#ASSERT `o 56 r 2(3) the Court may make the order in an action against partners` TRUE TRUE FALSE `o 56 r 2(1) another order` EQUALS NOTHING -- one order named without "only"
#ASSERT `o 56 r 2(3) the Court may make the order in an action against partners` TRUE TRUE TRUE `o 56 r 2(1)(a) an order in Form 84 to provide a statement of the names and places of residence of the partners and to verify it` EQUALS JUST FALSE -- notice complied with
#ASSERT `o 56 r 2(3) the Court may make the order in an action against partners` TRUE FALSE FALSE `o 56 r 2(1)(a) an order in Form 84 to provide a statement of the names and places of residence of the partners and to verify it` EQUALS JUST FALSE -- no notice served
#ASSERT `o 56 r 2(3) the Court may make the order in an action against partners` FALSE TRUE FALSE `o 56 r 2(1)(a) an order in Form 84 to provide a statement of the names and places of residence of the partners and to verify it` EQUALS NOTHING -- not an action against partners

-- Rule 3
#ASSERT `o 56 r 3(1) the originating claim may be served that way` TRUE FALSE `o 56 r 3(1)(a) on any one or more of the partners` EQUALS JUST TRUE -- (a)
#ASSERT `o 56 r 3(1) the originating claim may be served that way` TRUE FALSE `o 56 r 3(1)(b) at the principal place of business of the partnership within Singapore, on a person having at the time of service the control or management of the partnership business there` EQUALS JUST TRUE -- (b)
#ASSERT `o 56 r 3(1) the originating claim may be served that way` TRUE FALSE `o 56 r 3(1) another way` EQUALS NOTHING -- two ways named without "only"
#ASSERT `o 56 r 3(1) the originating claim may be served that way` TRUE TRUE `o 56 r 3(1)(a) on any one or more of the partners` EQUALS JUST FALSE -- "except in the case mentioned in paragraph (2)": dissolved to the claimant's knowledge
#ASSERT `o 56 r 3(1) the originating claim may be served that way` FALSE FALSE `o 56 r 3(1)(a) on any one or more of the partners` EQUALS JUST FALSE -- partners not sued in the name of a firm: the "where" fails
#ASSERT `o 56 r 3(1) the originating claim is deemed to have been duly served on the firm` TRUE TRUE EQUALS JUST TRUE -- "deemed to have been duly served on the firm"
#ASSERT `o 56 r 3(1) the originating claim is deemed to have been duly served on the firm` TRUE FALSE EQUALS JUST FALSE -- service not in accordance with the paragraph: the "where" fails
#ASSERT `o 56 r 3(1) the originating claim is deemed to have been duly served on the firm` FALSE TRUE EQUALS JUST FALSE -- not sued in the name of a firm
#ASSERT `o 56 r 3(2) the duty to serve the originating claim on every person within Singapore sought to be made liable arises` TRUE TRUE EQUALS JUST TRUE -- dissolved to the knowledge of the claimant
#ASSERT `o 56 r 3(2) the duty to serve the originating claim on every person within Singapore sought to be made liable arises` TRUE FALSE EQUALS JUST FALSE -- not to the claimant's knowledge
#ASSERT `o 56 r 3(2) the duty to serve the originating claim on every person within Singapore sought to be made liable arises` FALSE TRUE EQUALS JUST FALSE -- not dissolved
#ASSERT `o 56 r 3(2) the originating claim has been served on every person within Singapore sought to be made liable` TRUE TRUE TRUE EQUALS JUST TRUE -- served on every such person
#ASSERT `o 56 r 3(2) the originating claim has been served on every person within Singapore sought to be made liable` TRUE TRUE FALSE EQUALS NOTHING -- not served on every such person: a bare "must"
#ASSERT `o 56 r 3(2) the originating claim has been served on every person within Singapore sought to be made liable` TRUE FALSE TRUE EQUALS NOTHING -- the duty does not arise
#ASSERT `o 56 r 3(3) the duty to give the person a written notice in Form 85 arises` TRUE EQUALS JUST TRUE -- served under paragraph (1)
#ASSERT `o 56 r 3(3) the duty to give the person a written notice in Form 85 arises` FALSE EQUALS NOTHING -- not served under paragraph (1)
#ASSERT `o 56 r 3(3) the person was given the written notice in Form 85 as the person must be` TRUE TRUE TRUE EQUALS JUST TRUE -- notice given at the time of service, stating the capacity
#ASSERT `o 56 r 3(3) the person was given the written notice in Form 85 as the person must be` TRUE FALSE TRUE EQUALS NOTHING -- no notice given: a bare "must"
#ASSERT `o 56 r 3(3) the person was given the written notice in Form 85 as the person must be` TRUE TRUE FALSE EQUALS NOTHING -- the notice does not state the capacity
#ASSERT `o 56 r 3(3) the person was given the written notice in Form 85 as the person must be` FALSE TRUE TRUE EQUALS NOTHING -- not served under paragraph (1)
#ASSERT `o 56 r 3(3) the person is deemed to be served as a partner` TRUE FALSE EQUALS JUST TRUE -- no notice given
#ASSERT `o 56 r 3(3) the person is deemed to be served as a partner` TRUE TRUE EQUALS JUST FALSE -- a notice was given
#ASSERT `o 56 r 3(3) the person is deemed to be served as a partner` FALSE FALSE EQUALS NOTHING -- not served under paragraph (1)

-- Rule 4
#ASSERT `o 56 r 4(1) the notice of intention to contest or not contest may be filed and served that way` TRUE TRUE EQUALS JUST TRUE -- "only by the partners of the firm in their own names"
#ASSERT `o 56 r 4(1) the notice of intention to contest or not contest may be filed and served that way` TRUE FALSE EQUALS JUST FALSE -- "may not be filed and served in the name of the firm"
#ASSERT `o 56 r 4(1) the notice of intention to contest or not contest may be filed and served that way` FALSE TRUE EQUALS NOTHING -- persons not sued as partners in the name of their firm
#ASSERT `o 56 r 4(1) the action must continue in the name of the firm` TRUE EQUALS JUST TRUE -- "the action must nevertheless continue in the name of the firm"
#ASSERT `o 56 r 4(1) the action must continue in the name of the firm` FALSE EQUALS JUST FALSE -- the "Where" fails
#ASSERT `o 56 r 4(2) the person may file and serve a notice stating that the person does so as a person served as a partner who denies being one` TRUE TRUE TRUE EQUALS JUST TRUE -- served as a partner, denies it
#ASSERT `o 56 r 4(2) the person may file and serve a notice stating that the person does so as a person served as a partner who denies being one` FALSE TRUE TRUE EQUALS JUST FALSE -- not an action against a firm
#ASSERT `o 56 r 4(2) the person may file and serve a notice stating that the person does so as a person served as a partner who denies being one` TRUE FALSE TRUE EQUALS JUST FALSE -- not served as a partner
#ASSERT `o 56 r 4(2) the person may file and serve a notice stating that the person does so as a person served as a partner who denies being one` TRUE TRUE FALSE EQUALS JUST FALSE -- does not deny
#ASSERT `o 56 r 4(3) the notice is treated as a notice of intention to contest or not contest for the defendant firm` TRUE FALSE EQUALS JUST TRUE -- until it is set aside
#ASSERT `o 56 r 4(3) the notice is treated as a notice of intention to contest or not contest for the defendant firm` TRUE TRUE EQUALS JUST FALSE -- set aside
#ASSERT `o 56 r 4(3) the notice is treated as a notice of intention to contest or not contest for the defendant firm` FALSE FALSE EQUALS NOTHING -- not filed and served in accordance with paragraph (2)
#ASSERT `o 56 r 4(4) paragraph (4) applies` TRUE EQUALS JUST TRUE -- notice filed and served under paragraph (2)
#ASSERT `o 56 r 4(4) paragraph (4) applies` FALSE EQUALS JUST FALSE -- the "Where" fails
#ASSERT `o 56 r 4(4)(a) the claimant may apply to the Court to set the notice aside` TRUE TRUE EQUALS JUST TRUE -- on the ground that the defendant was a partner or liable as such
#ASSERT `o 56 r 4(4)(a) the claimant may apply to the Court to set the notice aside` TRUE FALSE EQUALS NOTHING -- on another ground
#ASSERT `o 56 r 4(4)(a) the claimant may apply to the Court to set the notice aside` FALSE TRUE EQUALS JUST FALSE -- no notice filed: the "Where" fails
#ASSERT `o 56 r 4(4)(a) the claimant may leave the question to be determined at a later stage of the proceedings` TRUE EQUALS JUST TRUE -- "may leave that question to be determined at a later stage"
#ASSERT `o 56 r 4(4)(a) the claimant may leave the question to be determined at a later stage of the proceedings` FALSE EQUALS JUST FALSE -- the "Where" fails
#ASSERT `o 56 r 4(4)(b) the defendant may apply to the Court to set aside the service of the originating claim` TRUE TRUE EQUALS JUST TRUE -- on the ground that the defendant was not a partner or liable as such
#ASSERT `o 56 r 4(4)(b) the defendant may apply to the Court to set aside the service of the originating claim` TRUE FALSE EQUALS NOTHING -- on another ground
#ASSERT `o 56 r 4(4)(b) the defendant may apply to the Court to set aside the service of the originating claim` FALSE TRUE EQUALS JUST FALSE -- the "Where" fails
#ASSERT `o 56 r 4(4)(b) the defendant may at the proper time serve a defence on the claimant denying that` TRUE `o 56 r 4(4)(b) the defendant's liability as a partner` EQUALS JUST TRUE -- liability as a partner
#ASSERT `o 56 r 4(4)(b) the defendant may at the proper time serve a defence on the claimant denying that` TRUE `o 56 r 4(4)(b) the liability of the defendant firm` EQUALS JUST TRUE -- liability of the firm
#ASSERT `o 56 r 4(4)(b) the defendant may at the proper time serve a defence on the claimant denying that` TRUE `o 56 r 4(4)(b) both` EQUALS JUST TRUE -- "or both"
#ASSERT `o 56 r 4(4)(b) the defendant may at the proper time serve a defence on the claimant denying that` TRUE `o 56 r 4(4)(b) something else` EQUALS NOTHING -- some other denial
#ASSERT `o 56 r 4(4)(b) the defendant may at the proper time serve a defence on the claimant denying that` FALSE `o 56 r 4(4)(b) both` EQUALS JUST FALSE -- the "Where" fails
#ASSERT `o 56 r 4(5) the Court may order that a question as to the liability be tried in such manner and at such time as the Court directs` TRUE TRUE EQUALS JUST TRUE -- on the application of the claimant or that defendant
#ASSERT `o 56 r 4(5) the Court may order that a question as to the liability be tried in such manner and at such time as the Court directs` TRUE FALSE EQUALS JUST FALSE -- on the application of someone else
#ASSERT `o 56 r 4(5) the Court may order that a question as to the liability be tried in such manner and at such time as the Court directs` FALSE TRUE EQUALS JUST FALSE -- no such notice filed
#ASSERT `o 56 r 4(6) the person is barred from filing and serving a notice of intention to contest or not contest` TRUE TRUE FALSE EQUALS JUST TRUE -- served as a person in control, not a member
#ASSERT `o 56 r 4(6) the person is barred from filing and serving a notice of intention to contest or not contest` TRUE TRUE TRUE EQUALS JUST FALSE -- "unless that person is a member of the firm sued"
#ASSERT `o 56 r 4(6) the person is barred from filing and serving a notice of intention to contest or not contest` FALSE TRUE FALSE EQUALS JUST FALSE -- not an action against a firm: the "Where" fails
#ASSERT `o 56 r 4(6) the person is barred from filing and serving a notice of intention to contest or not contest` TRUE FALSE FALSE EQUALS JUST FALSE -- not served as a person in control
#ASSERT `o 56 r 4(6) the person may file and serve a notice of intention to contest or not contest` TRUE TRUE FALSE EQUALS JUST FALSE -- barred
#ASSERT `o 56 r 4(6) the person may file and serve a notice of intention to contest or not contest` TRUE TRUE TRUE EQUALS NOTHING -- the exception lifts the bar and grants nothing
#ASSERT `o 56 r 4(6) the person may file and serve a notice of intention to contest or not contest` FALSE TRUE FALSE EQUALS NOTHING -- the bar is not engaged

-- Rule 5
#ASSERT `o 56 r 5(1) an enforcement order may be issued against the property` TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- judgment against a firm, property of the firm in the jurisdiction
#ASSERT `o 56 r 5(1) an enforcement order may be issued against the property` FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- no judgment against a firm: the "Where" fails
#ASSERT `o 56 r 5(1) an enforcement order may be issued against the property` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- "subject to Rule 6": permission needed and not given
#ASSERT `o 56 r 5(1) an enforcement order may be issued against the property` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- Rule 6 permission given
#ASSERT `o 56 r 5(1) an enforcement order may be issued against the property` TRUE FALSE FALSE FALSE EQUALS NOTHING -- not property of the firm within the jurisdiction
#ASSERT `o 56 r 5(2) an enforcement order may be issued against the person` TRUE FALSE FALSE `o 56 r 5(2)(a) a person who filed and served a notice of intention to contest or not contest in the action as a partner` FALSE EQUALS JUST TRUE -- (a)
#ASSERT `o 56 r 5(2) an enforcement order may be issued against the person` TRUE FALSE FALSE `o 56 r 5(2)(b) a person who, having been served as a partner with the originating claim, failed to file and serve a notice of intention to contest or not contest` FALSE EQUALS JUST TRUE -- (b)
#ASSERT `o 56 r 5(2) an enforcement order may be issued against the person` TRUE FALSE FALSE `o 56 r 5(2)(c) a person who admitted in that person's pleading that that person is a partner` FALSE EQUALS JUST TRUE -- (c)
#ASSERT `o 56 r 5(2) an enforcement order may be issued against the person` TRUE FALSE FALSE `o 56 r 5(2)(d) a person who was adjudged to be a partner` FALSE EQUALS JUST TRUE -- (d)
#ASSERT `o 56 r 5(2) an enforcement order may be issued against the person` TRUE FALSE FALSE `o 56 r 5(2) someone else` FALSE EQUALS NOTHING -- four kinds named without "only"
#ASSERT `o 56 r 5(2) an enforcement order may be issued against the person` TRUE FALSE FALSE `o 56 r 5(2)(a) a person who filed and served a notice of intention to contest or not contest in the action as a partner` TRUE EQUALS JUST FALSE -- "subject to ... paragraph (3)": barred
#ASSERT `o 56 r 5(2) an enforcement order may be issued against the person` FALSE FALSE FALSE `o 56 r 5(2)(a) a person who filed and served a notice of intention to contest or not contest in the action as a partner` FALSE EQUALS JUST FALSE -- no judgment against a firm
#ASSERT `o 56 r 5(2) an enforcement order may be issued against the person` TRUE TRUE FALSE `o 56 r 5(2)(a) a person who filed and served a notice of intention to contest or not contest in the action as a partner` FALSE EQUALS JUST FALSE -- "subject to Rule 6": permission not given
#ASSERT `o 56 r 5(2) an enforcement order may be issued against the person` TRUE TRUE TRUE `o 56 r 5(2)(a) a person who filed and served a notice of intention to contest or not contest in the action as a partner` FALSE EQUALS JUST TRUE -- permission given
#ASSERT `o 56 r 5(3) an enforcement order against the member is barred` TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- out of Singapore, none of the three
#ASSERT `o 56 r 5(3) an enforcement order against the member is barred` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- (a) filed and served a notice as a partner
#ASSERT `o 56 r 5(3) an enforcement order against the member is barred` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- (b) served within Singapore as a partner
#ASSERT `o 56 r 5(3) an enforcement order against the member is barred` TRUE FALSE FALSE TRUE EQUALS JUST FALSE -- (c) served out of Singapore with permission under Order 8
#ASSERT `o 56 r 5(3) an enforcement order against the member is barred` FALSE FALSE FALSE FALSE EQUALS NOTHING -- not a member out of Singapore when the claim was issued
#ASSERT `o 56 r 5(3) an enforcement order may be issued against the member` TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- barred
#ASSERT `o 56 r 5(3) an enforcement order may be issued against the member` TRUE TRUE FALSE FALSE EQUALS NOTHING -- an exception lifts the bar and grants nothing
#ASSERT `o 56 r 5(3) an enforcement order may be issued against the member` FALSE FALSE FALSE FALSE EQUALS NOTHING -- the bar is not engaged
#ASSERT `o 56 r 5(3) the judgment or order renders the member liable, releases or otherwise affects the member` TRUE FALSE EQUALS JUST FALSE -- "does not render liable, release or otherwise affect"
#ASSERT `o 56 r 5(3) the judgment or order renders the member liable, releases or otherwise affects the member` TRUE TRUE EQUALS NOTHING -- "except as provided by this paragraph and paragraph (1)": handed to those provisions
#ASSERT `o 56 r 5(3) the judgment or order renders the member liable, releases or otherwise affects the member` FALSE FALSE EQUALS NOTHING -- not a member out of Singapore
#ASSERT `o 56 r 5(4) the party may apply to the Court for permission to apply for an enforcement order against the person` TRUE TRUE TRUE EQUALS JUST TRUE -- judgment obtained, member claimed, paragraphs (1) to (3) do not apply
#ASSERT `o 56 r 5(4) the party may apply to the Court for permission to apply for an enforcement order against the person` FALSE TRUE TRUE EQUALS JUST FALSE -- no judgment against a firm
#ASSERT `o 56 r 5(4) the party may apply to the Court for permission to apply for an enforcement order against the person` TRUE FALSE TRUE EQUALS JUST FALSE -- no claim that the person is a member
#ASSERT `o 56 r 5(4) the party may apply to the Court for permission to apply for an enforcement order against the person` TRUE TRUE FALSE EQUALS JUST FALSE -- paragraphs (1) to (3) apply
#ASSERT `o 56 r 5(4) the application is made by summons served personally as it must be` TRUE `Summons` TRUE EQUALS JUST TRUE -- by summons, served personally
#ASSERT `o 56 r 5(4) the application is made by summons served personally as it must be` TRUE `Summons` FALSE EQUALS NOTHING -- not served personally: a bare "must"
#ASSERT `o 56 r 5(4) the application is made by summons served personally as it must be` TRUE `Summons without notice` TRUE EQUALS NOTHING -- not by summons
#ASSERT `o 56 r 5(4) the application is made by summons served personally as it must be` FALSE `Summons` TRUE EQUALS NOTHING -- not an application under paragraph (4)
#ASSERT `o 56 r 5(5) the Court may give permission to apply for an enforcement order against the person` TRUE FALSE EQUALS JUST TRUE -- does not dispute liability
#ASSERT `o 56 r 5(5) the Court may give permission to apply for an enforcement order against the person` TRUE TRUE EQUALS JUST FALSE -- "subject to paragraph (3)"
#ASSERT `o 56 r 5(5) the Court may give permission to apply for an enforcement order against the person` FALSE FALSE EQUALS JUST FALSE -- disputes liability: the "Where" fails
#ASSERT `o 56 r 5(6) the Court may order that the liability be tried and determined as an issue or question in an action may be` TRUE EQUALS JUST TRUE -- disputes liability
#ASSERT `o 56 r 5(6) the Court may order that the liability be tried and determined as an issue or question in an action may be` FALSE EQUALS JUST FALSE -- does not dispute: the "Where" fails

-- Rule 6
#ASSERT `o 56 r 6(1)(b) the least number of members the firms have in common` EQUALS 1 -- "one or more members in common"
#ASSERT `o 56 r 6(1)(b) the firms have enough members in common` 0 EQUALS FALSE -- none in common
#ASSERT `o 56 r 6(1)(b) the firms have enough members in common` 1 EQUALS TRUE -- one in common
#ASSERT `o 56 r 6(1)(b) the firms have enough members in common` 2 EQUALS TRUE -- two in common
#ASSERT `o 56 r 6(1) issue of the enforcement order is barred` TRUE TRUE FALSE 0 FALSE EQUALS JUST TRUE -- (a) an action by or against a firm, against or by a member, no permission
#ASSERT `o 56 r 6(1) issue of the enforcement order is barred` FALSE FALSE TRUE 1 FALSE EQUALS JUST TRUE -- (b) firm against firm with a member in common, no permission
#ASSERT `o 56 r 6(1) issue of the enforcement order is barred` FALSE FALSE TRUE 2 TRUE EQUALS JUST FALSE -- (b) with permission
#ASSERT `o 56 r 6(1) issue of the enforcement order is barred` TRUE TRUE FALSE 0 TRUE EQUALS JUST FALSE -- (a) "except with the permission of the Court"
#ASSERT `o 56 r 6(1) issue of the enforcement order is barred` FALSE FALSE TRUE 0 FALSE EQUALS JUST FALSE -- (b) firm against firm but no member in common: "where those firms have one or more members in common" is a "where" condition
#ASSERT `o 56 r 6(1) issue of the enforcement order is barred` FALSE FALSE TRUE 0 TRUE EQUALS JUST FALSE -- (b) no member in common: the permission makes no difference to a bar that does not apply
#ASSERT `o 56 r 6(1) issue of the enforcement order is barred` TRUE TRUE TRUE 0 FALSE EQUALS JUST TRUE -- firm against firm with no member in common, but the enforcement is against or by a member: (a) still bars
#ASSERT `o 56 r 6(1) issue of the enforcement order is barred` TRUE FALSE FALSE 0 FALSE EQUALS NOTHING -- (a) but the enforcement is not against or by a member
#ASSERT `o 56 r 6(1) issue of the enforcement order is barred` FALSE FALSE FALSE 0 FALSE EQUALS NOTHING -- neither kind of action
#ASSERT `o 56 r 6(1) the enforcement order may be issued` TRUE TRUE FALSE 0 FALSE EQUALS JUST FALSE -- barred
#ASSERT `o 56 r 6(1) the enforcement order may be issued` TRUE TRUE FALSE 0 TRUE EQUALS NOTHING -- the permission lifts the bar and grants nothing
#ASSERT `o 56 r 6(1) the enforcement order may be issued` FALSE FALSE FALSE 0 FALSE EQUALS NOTHING -- the bar is not engaged
#ASSERT `o 56 r 6(1) the enforcement order may be issued` FALSE FALSE TRUE 0 FALSE EQUALS NOTHING -- firm against firm with no member in common: the bar does not apply and the paragraph grants nothing
#ASSERT `o 56 r 6(2) the Court may give the direction` TRUE `o 56 r 6(2) a direction as to the taking of accounts` TRUE EQUALS JUST TRUE -- accounts
#ASSERT `o 56 r 6(2) the Court may give the direction` TRUE `o 56 r 6(2) a direction as to the making of inquiries` FALSE EQUALS JUST TRUE -- inquiries
#ASSERT `o 56 r 6(2) the Court may give the direction` TRUE `o 56 r 6(2) another direction as may be just` TRUE EQUALS JUST TRUE -- another direction that is just
#ASSERT `o 56 r 6(2) the Court may give the direction` TRUE `o 56 r 6(2) another direction as may be just` FALSE EQUALS NOTHING -- another direction that is not just: "including" does not close the list
#ASSERT `o 56 r 6(2) the Court may give the direction` FALSE `o 56 r 6(2) a direction as to the taking of accounts` TRUE EQUALS JUST FALSE -- not hearing an application under this Rule

-- Rule 7
#ASSERT `o 56 r 7(1) an order may be made under Order 22, Rule 2 in relation to the debts` TRUE FALSE EQUALS JUST TRUE -- debts due from a firm carrying on business here
#ASSERT `o 56 r 7(1) an order may be made under Order 22, Rule 2 in relation to the debts` TRUE TRUE EQUALS JUST TRUE -- "even though one or more members of the firm is resident out of the jurisdiction"
#ASSERT `o 56 r 7(1) an order may be made under Order 22, Rule 2 in relation to the debts` FALSE FALSE EQUALS NOTHING -- not debts due from such a firm
#ASSERT `o 56 r 7(2) the duty to serve the notice of attachment on a member of the firm or other person in control arises` TRUE EQUALS JUST TRUE -- a notice of attachment relating to such debts
#ASSERT `o 56 r 7(2) the duty to serve the notice of attachment on a member of the firm or other person in control arises` FALSE EQUALS NOTHING -- some other notice
#ASSERT `o 56 r 7(2) the notice of attachment is served as it must be` TRUE TRUE FALSE EQUALS JUST TRUE -- served on a member within the jurisdiction
#ASSERT `o 56 r 7(2) the notice of attachment is served as it must be` TRUE FALSE TRUE EQUALS JUST TRUE -- served on some other person in control
#ASSERT `o 56 r 7(2) the notice of attachment is served as it must be` TRUE FALSE FALSE EQUALS NOTHING -- served on neither: a bare "must"
#ASSERT `o 56 r 7(2) the notice of attachment is served as it must be` FALSE TRUE TRUE EQUALS NOTHING -- not such a notice
#ASSERT `o 56 r 7(3) the appearance constitutes a sufficient compliance with the order` TRUE TRUE EQUALS JUST TRUE -- an appearance by a member
#ASSERT `o 56 r 7(3) the appearance constitutes a sufficient compliance with the order` TRUE FALSE EQUALS NOTHING -- an appearance by another
#ASSERT `o 56 r 7(3) the appearance constitutes a sufficient compliance with the order` FALSE TRUE EQUALS JUST FALSE -- the order does not require the firm to appear: the "Where" fails

-- Rules 8 and 9
#ASSERT `o 56 r 8 Rules 2 to 7 apply with the necessary modifications` TRUE `Originating application` EQUALS JUST TRUE -- begun by originating application
#ASSERT `o 56 r 8 Rules 2 to 7 apply with the necessary modifications` TRUE `Originating claim` EQUALS NOTHING -- begun by originating claim: they apply of themselves
#ASSERT `o 56 r 8 Rules 2 to 7 apply with the necessary modifications` FALSE `Originating application` EQUALS NOTHING -- not an action by or against partners in the name of their firm
#ASSERT `o 56 r 9 the individual may be sued in that name or style as if it were the name of a firm` TRUE EQUALS JUST TRUE -- an individual carrying on business in another name
#ASSERT `o 56 r 9 the individual may be sued in that name or style as if it were the name of a firm` FALSE EQUALS NOTHING -- not such an individual
#ASSERT `o 56 r 9 Rules 2 to 8 apply as if the individual were a partner` TRUE TRUE EQUALS JUST TRUE -- so far as applicable
#ASSERT `o 56 r 9 Rules 2 to 8 apply as if the individual were a partner` TRUE FALSE EQUALS NOTHING -- not applicable to the case
#ASSERT `o 56 r 9 Rules 2 to 8 apply as if the individual were a partner` FALSE TRUE EQUALS NOTHING -- not such an individual

-- Rule 10
#ASSERT `o 56 r 10(1) the application must be made by summons` TRUE FALSE EQUALS JUST TRUE -- by a judgment creditor for an order under section 23
#ASSERT `o 56 r 10(1) the application must be made by summons` FALSE TRUE EQUALS JUST TRUE -- by a partner of the judgment debtor in consequence
#ASSERT `o 56 r 10(1) the application must be made by summons` FALSE FALSE EQUALS NOTHING -- some other application
#ASSERT `o 56 r 10(1) the application is made by summons as it must be` TRUE FALSE `Summons` EQUALS JUST TRUE -- by summons
#ASSERT `o 56 r 10(1) the application is made by summons as it must be` FALSE TRUE `Summons` EQUALS JUST TRUE -- by summons
#ASSERT `o 56 r 10(1) the application is made by summons as it must be` TRUE FALSE `Originating application` EQUALS NOTHING -- not by summons: a bare "must"
#ASSERT `o 56 r 10(1) the application is made by summons as it must be` FALSE FALSE `Summons` EQUALS NOTHING -- some other application
#ASSERT `o 56 r 10(2) the Registrar may exercise the power` TRUE EQUALS JUST TRUE -- the powers conferred on a Judge by section 23
#ASSERT `o 56 r 10(2) the Registrar may exercise the power` FALSE EQUALS NOTHING -- some other power
#ASSERT `o 56 r 10(3) the duty to serve the judgment debtor and the partners within Singapore arises` TRUE EQUALS JUST TRUE -- a summons by a judgment creditor
#ASSERT `o 56 r 10(3) the duty to serve the judgment debtor and the partners within Singapore arises` FALSE EQUALS NOTHING -- some other summons
#ASSERT `o 56 r 10(3) the summons or order is served as it must be` TRUE TRUE TRUE EQUALS JUST TRUE -- the judgment debtor and the partners within Singapore
#ASSERT `o 56 r 10(3) the summons or order is served as it must be` TRUE FALSE TRUE EQUALS NOTHING -- the judgment debtor not served: a bare "must"
#ASSERT `o 56 r 10(3) the summons or order is served as it must be` TRUE TRUE FALSE EQUALS NOTHING -- the partners within Singapore not served
#ASSERT `o 56 r 10(3) the summons or order is served as it must be` FALSE TRUE TRUE EQUALS NOTHING -- some other summons
#ASSERT `o 56 r 10(4) the duty to serve the judgment creditor, the judgment debtor and the other partners arises` TRUE EQUALS JUST TRUE -- a summons by a partner of a judgment debtor
#ASSERT `o 56 r 10(4) the duty to serve the judgment creditor, the judgment debtor and the other partners arises` FALSE EQUALS NOTHING -- some other summons
#ASSERT `o 56 r 10(4) the summons or order is served as it must be` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- (a), (b) and (c)
#ASSERT `o 56 r 10(4) the summons or order is served as it must be` TRUE FALSE TRUE TRUE EQUALS NOTHING -- (a) the judgment creditor not served
#ASSERT `o 56 r 10(4) the summons or order is served as it must be` TRUE TRUE FALSE TRUE EQUALS NOTHING -- (b) the judgment debtor not served
#ASSERT `o 56 r 10(4) the summons or order is served as it must be` TRUE TRUE TRUE FALSE EQUALS NOTHING -- (c) the other partners not served
#ASSERT `o 56 r 10(4) the summons or order is served as it must be` FALSE TRUE TRUE TRUE EQUALS NOTHING -- some other summons
#ASSERT `o 56 r 10(5) the summons or order is deemed to have been served on all the partners` TRUE EQUALS JUST TRUE -- served on some only of the partners
#ASSERT `o 56 r 10(5) the summons or order is deemed to have been served on all the partners` FALSE EQUALS NOTHING -- not served in accordance with this Rule on some only of the partners
