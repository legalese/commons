IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc1-order-5`

-- TESTS for roc1-order-5.l4 (Order 5, amicable resolution).  Every expected value is written from the text beside the assertion.

-- Rule 1(1)
#ASSERT `o 5 r 1(1) the party has the duty to consider amicable resolution of the dispute` TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 1(1) the party has the duty to consider amicable resolution of the dispute` FALSE EQUALS NOTHING
#ASSERT `o 5 r 1(1) the party has considered amicable resolution as the duty requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 1(1) the party has considered amicable resolution as the duty requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 5 r 1(1) the party has considered amicable resolution as the duty requires` FALSE TRUE EQUALS NOTHING
-- Rule 1(2): an offer before commencing, unless reasonable grounds not to
#ASSERT `o 5 r 1(2) the party is to make an offer of amicable resolution before commencing the action` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 5 r 1(2) the party is to make an offer of amicable resolution before commencing the action` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 5 r 1(2) the party is to make an offer of amicable resolution before commencing the action` FALSE FALSE EQUALS NOTHING
#ASSERT `o 5 r 1(2) the party has complied before commencing the action` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 1(2) the party has complied before commencing the action` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 5 r 1(2) the party has complied before commencing the action` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 5 r 1(2) the party has complied before commencing the action` FALSE FALSE TRUE EQUALS NOTHING
-- Rule 1(3): the definition, a list of two heads
#ASSERT `o 5 r 1(3) an act is an offer of amicable resolution` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 5 r 1(3) an act is an offer of amicable resolution` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 1(3) an act is an offer of amicable resolution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 1(3) an act is an offer of amicable resolution` FALSE FALSE EQUALS JUST FALSE
-- Rule 1(4): a flat negative that the reasonable-grounds exception lifts without granting
#ASSERT `o 5 r 1(4) the party may reject an offer of amicable resolution` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 5 r 1(4) the party may reject an offer of amicable resolution` TRUE TRUE EQUALS NOTHING
#ASSERT `o 5 r 1(4) the party may reject an offer of amicable resolution` FALSE FALSE EQUALS NOTHING
-- Rule 2
#ASSERT `o 5 r 2(1) the offer or rejection is in writing as required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 2(1) the offer or rejection is in writing as required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 5 r 2(1) the offer or rejection is in writing as required` FALSE TRUE EQUALS NOTHING
#ASSERT `o 5 r 2(2) the least number of days an offer must be open for acceptance` EQUALS 14
#ASSERT `o 5 r 2(2) the offer is open for acceptance as required` FALSE 14 TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 2(2) the offer is open for acceptance as required` FALSE 30 TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 2(2) the offer is open for acceptance as required` FALSE 13 TRUE EQUALS JUST FALSE
#ASSERT `o 5 r 2(2) the offer is open for acceptance as required` FALSE 14 FALSE EQUALS JUST FALSE
#ASSERT `o 5 r 2(2) the offer is open for acceptance as required` TRUE 3 TRUE EQUALS NOTHING
#ASSERT `o 5 r 2(3) the terms cannot yet be relied upon or made known to the Court` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 5 r 2(3) the terms cannot yet be relied upon or made known to the Court` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 5 r 2(3) the terms cannot yet be relied upon or made known to the Court` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 2(3) the terms cannot yet be relied upon or made known to the Court` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 5 r 2(3) the terms cannot yet be relied upon or made known to the Court` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `o 5 r 2(4) the offer has expired under this paragraph` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 5 r 2(4) the offer has expired under this paragraph` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 5 r 2(4) the offer has expired under this paragraph` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 5 r 2(4) the offer has expired under this paragraph` FALSE TRUE TRUE EQUALS NOTHING
-- Rule 3
#ASSERT `o 5 r 3(1) the Court may order the parties to attempt to resolve the dispute by amicable resolution` TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 3(1) the Court may order the parties to attempt to resolve the dispute by amicable resolution` FALSE EQUALS NOTHING
#ASSERT `o 5 r 3(2) the Court must have regard to the Ideals and all other relevant circumstances` TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 3(2) the Court must have regard to the Ideals and all other relevant circumstances` FALSE EQUALS NOTHING
#ASSERT `o 5 r 3(2) the Court has had regard as required` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 3(2) the Court has had regard as required` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 5 r 3(2) the Court has had regard as required` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 5 r 3(2) the Court has had regard as required` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `o 5 r 3(3) the Court may order the party to submit a sealed document setting out the reasons for the refusal` TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 3(3) the Court may order the party to submit a sealed document setting out the reasons for the refusal` FALSE EQUALS JUST FALSE
#ASSERT `o 5 r 3(4) the sealed document may be opened by the Court` FALSE EQUALS JUST FALSE
#ASSERT `o 5 r 3(4) the sealed document may be opened by the Court` TRUE EQUALS NOTHING
#ASSERT `o 5 r 3(4) the contents of the sealed document may be referred to` TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 3(4) the contents of the sealed document may be referred to` FALSE EQUALS NOTHING
#ASSERT `o 5 r 3(5) the Court may suggest solutions for the amicable resolution of the dispute` TRUE EQUALS JUST TRUE
#ASSERT `o 5 r 3(5) the Court may suggest solutions for the amicable resolution of the dispute` FALSE EQUALS NOTHING
