IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc10-order-48`

-- Rules of Court 2021 (Singapore), Order 48 (International Arbitration Act): TESTS.
-- Every expected value is written beside its assertion from the text of the rule it cites (lines 6216 to 6296 of the text),
-- never copied from the output of the code.  Last days are worked out by hand under O 3 r 3.

-- ---------------------------------------------------------------------------
-- Rule 1 (lines 6219 to 6223): definitions.
-- ---------------------------------------------------------------------------
#ASSERT `o 48 r 1 the definitions in this Rule apply` FALSE EQUALS JUST TRUE -- no contrary context
#ASSERT `o 48 r 1 the definitions in this Rule apply` TRUE EQUALS JUST FALSE -- "unless the context or subject matter otherwise indicates or requires"
#ASSERT `o 48 r 1 an instrument is the Act` TRUE EQUALS JUST TRUE -- "“Act” means the International Arbitration Act"
#ASSERT `o 48 r 1 an instrument is the Act` FALSE EQUALS JUST FALSE -- another instrument
#ASSERT `o 48 r 1 a reference to a section is a reference to a section in the International Arbitration Act` TRUE EQUALS JUST TRUE -- "any reference to a section is a reference to a section in the Act"
#ASSERT `o 48 r 1 a reference to a section is a reference to a section in the International Arbitration Act` FALSE EQUALS NOTHING -- another kind of reference
#ASSERT `o 48 r 1 a body is an arbitral tribunal` (JUST TRUE) EQUALS JUST TRUE -- the Act's meaning is supplied: yes
#ASSERT `o 48 r 1 a body is an arbitral tribunal` (JUST FALSE) EQUALS JUST FALSE -- the Act's meaning is supplied: no
#ASSERT `o 48 r 1 a body is an arbitral tribunal` NOTHING EQUALS NOTHING -- Part II of the Act is not among the sources
#ASSERT `o 48 r 1 a decision is an award` (JUST TRUE) EQUALS JUST TRUE -- supplied: yes
#ASSERT `o 48 r 1 a decision is an award` NOTHING EQUALS NOTHING -- Part II of the Act is not among the sources
#ASSERT `o 48 r 1 a decision is a foreign award` (JUST TRUE) EQUALS JUST TRUE -- supplied: yes
#ASSERT `o 48 r 1 a decision is a foreign award` NOTHING EQUALS NOTHING -- Part III of the Act is not among the sources
#ASSERT `o 48 r 1 an instrument is the Model Law` TRUE EQUALS JUST TRUE -- "“Model Law” means the UNCITRAL Model Law ..."
#ASSERT `o 48 r 1 an instrument is the Model Law` FALSE EQUALS JUST FALSE -- another instrument

-- ---------------------------------------------------------------------------
-- Rule 2 (lines 6225 to 6249): matters for a Judge in person.
-- ---------------------------------------------------------------------------
#ASSERT `o 48 r 2(1) the application must be made by originating application` TRUE `o 48 r 2(1)(a) an application to decide on the challenge of an arbitrator under Article 13(3) of the Model Law` EQUALS JUST TRUE -- (a)
#ASSERT `o 48 r 2(1) the application must be made by originating application` TRUE `o 48 r 2(1)(b) an application to decide on the termination of the mandate of an arbitrator under Article 14(1) of the Model Law` EQUALS JUST TRUE -- (b)
#ASSERT `o 48 r 2(1) the application must be made by originating application` TRUE `o 48 r 2(1)(c) an application to appeal against the ruling of the arbitral tribunal under section 10 or Article 16(3) of the Model Law` EQUALS JUST TRUE -- (c)
#ASSERT `o 48 r 2(1) the application must be made by originating application` TRUE `o 48 r 2(1)(d) an application to set aside an award under section 24 or Article 34(2) of the Model Law` EQUALS JUST TRUE -- (d)
#ASSERT `o 48 r 2(1) the application must be made by originating application` TRUE `o 48 r 2(1) another kind of application` EQUALS NOTHING -- the list names four kinds without "only"
#ASSERT `o 48 r 2(1) the application must be made by originating application` FALSE `o 48 r 2(1)(d) an application to set aside an award under section 24 or Article 34(2) of the Model Law` EQUALS NOTHING -- not an application to a Judge
#ASSERT `o 48 r 2(1) the application is made by originating application as it must be` TRUE `o 48 r 2(1)(d) an application to set aside an award under section 24 or Article 34(2) of the Model Law` `Originating application` EQUALS JUST TRUE -- made by originating application
#ASSERT `o 48 r 2(1) the application is made by originating application as it must be` TRUE `o 48 r 2(1)(d) an application to set aside an award under section 24 or Article 34(2) of the Model Law` `Summons` EQUALS NOTHING -- made by summons: a bare "must", not done
#ASSERT `o 48 r 2(1) the application is made by originating application as it must be` TRUE `o 48 r 2(1) another kind of application` `Summons` EQUALS NOTHING -- not one of the four kinds
-- (2): received 1 June 2026: 30 days begin 2 June and end 1 July 2026 (Wednesday)
#ASSERT `o 48 r 2(2) the period after receipt of the decision or ruling`'s `period length` EQUALS 30 -- "within 30 days"
#ASSERT `o 48 r 2(2) the application is made within 30 days after receipt of the decision or ruling` `o 48 r 2(1)(a) an application to decide on the challenge of an arbitrator under Article 13(3) of the Model Law` (Date 1 7 2026) (Date 1 7 2026) EQUALS JUST TRUE -- on the last day
#ASSERT `o 48 r 2(2) the application is made within 30 days after receipt of the decision or ruling` `o 48 r 2(1)(c) an application to appeal against the ruling of the arbitral tribunal under section 10 or Article 16(3) of the Model Law` (Date 2 7 2026) (Date 1 7 2026) EQUALS JUST FALSE -- a day late
#ASSERT `o 48 r 2(2) the application is made within 30 days after receipt of the decision or ruling` `o 48 r 2(1)(d) an application to set aside an award under section 24 or Article 34(2) of the Model Law` (Date 2 7 2026) (Date 1 7 2026) EQUALS NOTHING -- (d) is governed by paragraph (3)
-- (3): award received 10 Jan 2026; request under Article 33 disposed of 20 Jan 2026: the later is 20 Jan; 3 months run to 20 April 2026 (Monday)
#ASSERT `o 48 r 2(3) the period after the later date`'s `period length` EQUALS 3 -- "3 months"
#ASSERT `o 48 r 2(3) the period after the later date`'s `period unit` EQUALS Months -- "3 months"
#ASSERT `o 48 r 2(3) the later date from which the 3 months run` (Date 10 1 2026) (JUST (Date 20 1 2026)) EQUALS Date 20 1 2026 -- the Article 33 request was disposed of later
#ASSERT `o 48 r 2(3) the later date from which the 3 months run` (Date 10 1 2026) NOTHING EQUALS Date 10 1 2026 -- no Article 33 request: the date of receipt
#ASSERT `o 48 r 2(3) the later date from which the 3 months run` (Date 10 1 2026) (JUST (Date 5 1 2026)) EQUALS Date 10 1 2026 -- an earlier disposal: the later date is still receipt
#ASSERT `o 48 r 2(3) the application to set aside an award is made in time` `o 48 r 2(1)(d) an application to set aside an award under section 24 or Article 34(2) of the Model Law` (Date 20 4 2026) (Date 20 4 2026) EQUALS JUST TRUE -- on the last day
#ASSERT `o 48 r 2(3) the application to set aside an award is made in time` `o 48 r 2(1)(d) an application to set aside an award under section 24 or Article 34(2) of the Model Law` (Date 21 4 2026) (Date 20 4 2026) EQUALS JUST FALSE -- "may not be made more than 3 months after"
#ASSERT `o 48 r 2(3) the application to set aside an award is made in time` `o 48 r 2(1)(a) an application to decide on the challenge of an arbitrator under Article 13(3) of the Model Law` (Date 21 4 2026) (Date 20 4 2026) EQUALS NOTHING -- not an application under paragraph (1)(d)
-- (4)
-- fields: in support of a paragraph (1) application, grounds, copy of agreement, award, other documents, evidence, served with the originating application
#ASSERT `o 48 r 2(4) the affidavit in support is as it must be` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- every feature
#ASSERT `o 48 r 2(4) the affidavit in support is as it must be` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING -- grounds not stated
#ASSERT `o 48 r 2(4) the affidavit in support is as it must be` TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- no copy of the arbitration agreement exhibited
#ASSERT `o 48 r 2(4) the affidavit in support is as it must be` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING -- the award not exhibited
#ASSERT `o 48 r 2(4) the affidavit in support is as it must be` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING -- no other document relied on exhibited
#ASSERT `o 48 r 2(4) the affidavit in support is as it must be` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING -- evidence not set out
#ASSERT `o 48 r 2(4) the affidavit in support is as it must be` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- not served with the originating application
#ASSERT `o 48 r 2(4) the affidavit in support is as it must be` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING -- not an affidavit in support of an application under paragraph (1)
-- (5): served 1 June 2026: 14 days to 15 June 2026 (Monday)
#ASSERT `o 48 r 2(5) the period after service of the originating application`'s `period length` EQUALS 14 -- "Within 14 days"
#ASSERT `o 48 r 2(5) the duty to file an affidavit stating the grounds of opposition arises` TRUE TRUE EQUALS JUST TRUE -- served and wishes to oppose
#ASSERT `o 48 r 2(5) the duty to file an affidavit stating the grounds of opposition arises` TRUE FALSE EQUALS JUST FALSE -- "if the defendant wishes to oppose"
#ASSERT `o 48 r 2(5) the duty to file an affidavit stating the grounds of opposition arises` FALSE TRUE EQUALS NOTHING -- not yet served
#ASSERT `o 48 r 2(5) the affidavit of opposition has been filed in time` TRUE TRUE (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- on the last day
#ASSERT `o 48 r 2(5) the affidavit of opposition has been filed in time` TRUE TRUE (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- a day late
#ASSERT `o 48 r 2(5) the affidavit of opposition has been filed in time` TRUE FALSE (Date 16 6 2026) (Date 15 6 2026) EQUALS NOTHING -- the defendant does not wish to oppose: nothing to comply with
-- (6)
#ASSERT `o 48 r 2(6) the period after the decision of the Court`'s `period length` EQUALS 14 -- "within 14 days"
#ASSERT `o 48 r 2(6) the application for permission to appeal is made in time` TRUE (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- on the last day
#ASSERT `o 48 r 2(6) the application for permission to appeal is made in time` TRUE (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- a day late
#ASSERT `o 48 r 2(6) the application for permission to appeal is made in time` FALSE (Date 16 6 2026) (Date 15 6 2026) EQUALS NOTHING -- not an application for permission to appeal against a section 10 decision
-- (7)
#ASSERT `o 48 r 2(7) the date of receipt of a decision, ruling, award or corrected award` (JUST (Date 1 6 2026)) EQUALS JUST (Date 1 6 2026) -- Article 3 date supplied
#ASSERT `o 48 r 2(7) the date of receipt of a decision, ruling, award or corrected award` NOTHING EQUALS NOTHING -- Article 3 of the Model Law is not among the sources

-- ---------------------------------------------------------------------------
-- Rule 3 (lines 6251 to 6265): matters for Judge or Registrar.
-- ---------------------------------------------------------------------------
#ASSERT `o 48 r 3(1) the application must be made to a Judge or the Registrar` `o 48 r 3(1)(a) an application to hear an application in open court under section 22` EQUALS JUST TRUE -- (a)
#ASSERT `o 48 r 3(1) the application must be made to a Judge or the Registrar` `o 48 r 3(1)(b) an application for permission to enforce interim orders or directions of an arbitral tribunal under section 12(6)` EQUALS JUST TRUE -- (b)
#ASSERT `o 48 r 3(1) the application must be made to a Judge or the Registrar` `o 48 r 3(1)(c) an application for interim orders or directions under section 12A` EQUALS JUST TRUE -- (c)
#ASSERT `o 48 r 3(1) the application must be made to a Judge or the Registrar` `o 48 r 3(1)(d) an application to reinstate discontinued proceedings under section 6(4)` EQUALS JUST TRUE -- (d)
#ASSERT `o 48 r 3(1) the application must be made to a Judge or the Registrar` `o 48 r 3(1)(e) an application for permission to enforce an award under section 18 or 19` EQUALS JUST TRUE -- (e)
#ASSERT `o 48 r 3(1) the application must be made to a Judge or the Registrar` `o 48 r 3(1)(f) an application for permission to enforce a foreign award under section 29` EQUALS JUST TRUE -- (f)
#ASSERT `o 48 r 3(1) the application must be made to a Judge or the Registrar` `o 48 r 3(1) another kind of application` EQUALS NOTHING -- list not closed
#ASSERT `o 48 r 3(1) the application is made to a Judge or the Registrar as it must be` `o 48 r 3(1)(e) an application for permission to enforce an award under section 18 or 19` `A Judge` EQUALS JUST TRUE -- made to a Judge
#ASSERT `o 48 r 3(1) the application is made to a Judge or the Registrar as it must be` `o 48 r 3(1)(e) an application for permission to enforce an award under section 18 or 19` `The Registrar` EQUALS JUST TRUE -- made to the Registrar
#ASSERT `o 48 r 3(1) the application is made to a Judge or the Registrar as it must be` `o 48 r 3(1)(e) an application for permission to enforce an award under section 18 or 19` `A District Judge` EQUALS NOTHING -- made to a District Judge: a bare "must", not done
#ASSERT `o 48 r 3(1) the application is made to a Judge or the Registrar as it must be` `o 48 r 3(1) another kind of application` `A Judge` EQUALS NOTHING -- not one of the six kinds
#ASSERT `o 48 r 3(2) the application is made by the document this paragraph requires` `o 48 r 3(1)(c) an application for interim orders or directions under section 12A` TRUE `Summons` EQUALS JUST TRUE -- an action is pending: summons in the action
#ASSERT `o 48 r 3(2) the application is made by the document this paragraph requires` `o 48 r 3(1)(c) an application for interim orders or directions under section 12A` TRUE `Originating application` EQUALS NOTHING -- pending, but made by originating application: a bare "must", not done
#ASSERT `o 48 r 3(2) the application is made by the document this paragraph requires` `o 48 r 3(1)(c) an application for interim orders or directions under section 12A` FALSE `Originating application` EQUALS JUST TRUE -- no action pending: originating application
#ASSERT `o 48 r 3(2) the application is made by the document this paragraph requires` `o 48 r 3(1)(c) an application for interim orders or directions under section 12A` FALSE `Summons` EQUALS NOTHING -- no action pending, made by summons: a bare "must", not done
#ASSERT `o 48 r 3(2) the application is made by the document this paragraph requires` `o 48 r 3(1) another kind of application` TRUE `Summons` EQUALS NOTHING -- not an application to which this Rule applies
#ASSERT `o 48 r 3(3) the application may be made without notice` TRUE `o 48 r 3(1)(c) an application for interim orders or directions under section 12A` EQUALS JUST TRUE -- a case of urgency
#ASSERT `o 48 r 3(3) the application may be made without notice` FALSE `o 48 r 3(1)(e) an application for permission to enforce an award under section 18 or 19` EQUALS JUST TRUE -- section 18 or 19
#ASSERT `o 48 r 3(3) the application may be made without notice` FALSE `o 48 r 3(1)(f) an application for permission to enforce a foreign award under section 29` EQUALS JUST TRUE -- section 29
#ASSERT `o 48 r 3(3) the application may be made without notice` FALSE `o 48 r 3(1)(c) an application for interim orders or directions under section 12A` EQUALS JUST FALSE -- neither urgency nor a section 18, 19 or 29 application: the "where" fails

-- ---------------------------------------------------------------------------
-- Rule 4 (lines 6267 to 6268): service out of Singapore.
-- ---------------------------------------------------------------------------
#ASSERT `o 48 r 4(1) service out of Singapore is permissible` TRUE TRUE EQUALS JUST TRUE -- the originating application, with permission
#ASSERT `o 48 r 4(1) service out of Singapore is permissible` TRUE FALSE EQUALS JUST FALSE -- without permission: permission is the default (rule 6(4) says "without permission" where it dispenses with it), fork 48.2
#ASSERT `o 48 r 4(1) service out of Singapore is permissible` FALSE TRUE EQUALS NOTHING -- some other document
#ASSERT `o 48 r 4(1) the place of the arbitration or of the award limits service out of Singapore` EQUALS JUST FALSE -- "whether or not the arbitration was held or the award was made within Singapore"
#ASSERT `o 48 r 4(2) the application is supported by an affidavit as it must be` TRUE TRUE TRUE EQUALS JUST TRUE -- ground and place shown
#ASSERT `o 48 r 4(2) the application is supported by an affidavit as it must be` TRUE TRUE FALSE EQUALS NOTHING -- place not shown: a bare "must"
#ASSERT `o 48 r 4(2) the application is supported by an affidavit as it must be` TRUE FALSE TRUE EQUALS NOTHING -- ground not stated
#ASSERT `o 48 r 4(2) the application is supported by an affidavit as it must be` FALSE TRUE TRUE EQUALS NOTHING -- not an application for permission under this Rule
#ASSERT `o 48 r 4(2) the Court is barred from granting permission` FALSE EQUALS JUST TRUE -- not sufficiently made to appear
#ASSERT `o 48 r 4(2) the Court is barred from granting permission` TRUE EQUALS JUST FALSE -- sufficiently made to appear: "unless" lifts the bar
#ASSERT `o 48 r 4(2) the Court may grant permission` FALSE EQUALS JUST FALSE -- "no such permission is to be granted unless"
#ASSERT `o 48 r 4(2) the Court may grant permission` TRUE EQUALS NOTHING -- the showing lifts the bar and grants nothing (QA)
#ASSERT `o 48 r 4(3) Order 8, Rules 2, 3, 7 and 8 apply in relation to the document` TRUE EQUALS JUST TRUE -- an originating application or order referred to in paragraph (1)
#ASSERT `o 48 r 4(3) Order 8, Rules 2, 3, 7 and 8 apply in relation to the document` FALSE EQUALS NOTHING -- another document

-- ---------------------------------------------------------------------------
-- Rule 5 (lines 6270 to 6274): interim orders or directions.
-- ---------------------------------------------------------------------------
#ASSERT `o 48 r 5(1) the application is supported by an affidavit as it must be` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- every feature
#ASSERT `o 48 r 5(1) the application is supported by an affidavit as it must be` TRUE FALSE TRUE TRUE EQUALS NOTHING -- no copy of the arbitration agreement
#ASSERT `o 48 r 5(1) the application is supported by an affidavit as it must be` TRUE TRUE FALSE TRUE EQUALS NOTHING -- original order or direction not exhibited
#ASSERT `o 48 r 5(1) the application is supported by an affidavit as it must be` TRUE TRUE TRUE FALSE EQUALS NOTHING -- provisions relied on not stated
#ASSERT `o 48 r 5(1) the application is supported by an affidavit as it must be` FALSE TRUE TRUE TRUE EQUALS NOTHING -- not such an application
#ASSERT `o 48 r 5(2) the condition on permission applies` TRUE EQUALS JUST TRUE -- an interim injunction under section 12(1)(e) or (f)
#ASSERT `o 48 r 5(2) the condition on permission applies` FALSE EQUALS JUST FALSE -- "Where the order ... is in the nature of an interim injunction"
#ASSERT `o 48 r 5(2) permission may be granted` TRUE FALSE EQUALS JUST FALSE -- an interim injunction without the undertaking: "only if"
#ASSERT `o 48 r 5(2) permission may be granted` TRUE TRUE EQUALS NOTHING -- an undertaking lifts the bar and grants nothing (QA)
#ASSERT `o 48 r 5(2) permission may be granted` FALSE FALSE EQUALS NOTHING -- not such an injunction: the paragraph does not speak

-- ---------------------------------------------------------------------------
-- Rule 6 (lines 6276 to 6292): enforcement of awards and foreign awards.
-- ---------------------------------------------------------------------------
#ASSERT `o 48 r 6(1) a person is the creditor` TRUE EQUALS JUST TRUE -- "the applicant (called in this Rule the creditor)"
#ASSERT `o 48 r 6(1) a person is the creditor` FALSE EQUALS JUST FALSE -- someone other than the applicant
#ASSERT `o 48 r 6(1) a person is the debtor` TRUE EQUALS JUST TRUE -- "the person against whom it is sought to enforce the award (called in this Rule the debtor)"
#ASSERT `o 48 r 6(1) a person is the debtor` FALSE EQUALS JUST FALSE -- someone else
#ASSERT `o 48 r 6(1) the application for permission to enforce an award may be made without notice` TRUE EQUALS JUST TRUE -- an application to enforce an award
#ASSERT `o 48 r 6(1) the application for permission to enforce an award may be made without notice` FALSE EQUALS NOTHING -- some other application
-- (1): fields = exhibits, language other than English, translation exhibited, certifier, names, compliance statement
#ASSERT `o 48 r 6(1) the application is supported by an affidavit as it must be` TRUE TRUE FALSE FALSE `o 48 r 6(1)(a) someone else` TRUE TRUE EQUALS JUST TRUE -- English: no translation needed
#ASSERT `o 48 r 6(1) the application is supported by an affidavit as it must be` TRUE TRUE TRUE TRUE `o 48 r 6(1)(a) a sworn translator` TRUE TRUE EQUALS JUST TRUE -- translation certified by a sworn translator
#ASSERT `o 48 r 6(1) the application is supported by an affidavit as it must be` TRUE TRUE TRUE TRUE `o 48 r 6(1)(a) an official` TRUE TRUE EQUALS JUST TRUE -- certified by an official
#ASSERT `o 48 r 6(1) the application is supported by an affidavit as it must be` TRUE TRUE TRUE TRUE `o 48 r 6(1)(a) a diplomatic or consular agent of the country in which the award was made` TRUE TRUE EQUALS JUST TRUE -- certified by a diplomatic or consular agent
#ASSERT `o 48 r 6(1) the application is supported by an affidavit as it must be` TRUE TRUE TRUE TRUE `o 48 r 6(1)(a) someone else` TRUE TRUE EQUALS NOTHING -- certified by someone else: a bare "must", not done
#ASSERT `o 48 r 6(1) the application is supported by an affidavit as it must be` TRUE TRUE TRUE FALSE `o 48 r 6(1)(a) a sworn translator` TRUE TRUE EQUALS NOTHING -- a translation is needed and not exhibited
#ASSERT `o 48 r 6(1) the application is supported by an affidavit as it must be` TRUE FALSE FALSE FALSE `o 48 r 6(1)(a) someone else` TRUE TRUE EQUALS NOTHING -- the arbitration agreement and award are not exhibited
#ASSERT `o 48 r 6(1) the application is supported by an affidavit as it must be` TRUE TRUE FALSE FALSE `o 48 r 6(1)(a) someone else` FALSE TRUE EQUALS NOTHING -- names and places not stated
#ASSERT `o 48 r 6(1) the application is supported by an affidavit as it must be` TRUE TRUE FALSE FALSE `o 48 r 6(1)(a) someone else` TRUE FALSE EQUALS NOTHING -- non-compliance not stated
#ASSERT `o 48 r 6(1) the application is supported by an affidavit as it must be` FALSE TRUE FALSE FALSE `o 48 r 6(1)(a) someone else` TRUE TRUE EQUALS NOTHING -- not an application to enforce an award
#ASSERT `o 48 r 6(2) the application for permission to enforce a foreign award may be made without notice` TRUE EQUALS JUST TRUE -- an application to enforce a foreign award
#ASSERT `o 48 r 6(2) the application for permission to enforce a foreign award may be made without notice` FALSE EQUALS NOTHING -- some other application
#ASSERT `o 48 r 6(2) the application for a foreign award is supported by an affidavit as it must be` TRUE TRUE FALSE FALSE `o 48 r 6(1)(a) someone else` TRUE TRUE EQUALS JUST TRUE -- English: no translation needed
#ASSERT `o 48 r 6(2) the application for a foreign award is supported by an affidavit as it must be` TRUE TRUE TRUE TRUE `o 48 r 6(1)(a) an official` TRUE TRUE EQUALS JUST TRUE -- certified translation
#ASSERT `o 48 r 6(2) the application for a foreign award is supported by an affidavit as it must be` TRUE TRUE TRUE TRUE `o 48 r 6(1)(a) someone else` TRUE TRUE EQUALS NOTHING -- certified by someone else
#ASSERT `o 48 r 6(2) the application for a foreign award is supported by an affidavit as it must be` TRUE FALSE FALSE FALSE `o 48 r 6(1)(a) someone else` TRUE TRUE EQUALS NOTHING -- the agreement and award are not exhibited
#ASSERT `o 48 r 6(2) the application for a foreign award is supported by an affidavit as it must be` FALSE TRUE FALSE FALSE `o 48 r 6(1)(a) someone else` TRUE TRUE EQUALS NOTHING -- not an application for a foreign award
-- (3)
#ASSERT `o 48 r 6(3) the order is drawn up and served as it must be` TRUE `o 48 r 6(3) delivering a copy to the debtor personally` EQUALS JUST TRUE -- drawn up by the creditor, delivered personally
#ASSERT `o 48 r 6(3) the order is drawn up and served as it must be` TRUE `o 48 r 6(3) sending a copy to the debtor at the debtor's usual or last known place of residence or business` EQUALS JUST TRUE -- sent to the usual or last known place
#ASSERT `o 48 r 6(3) the order is drawn up and served as it must be` TRUE `o 48 r 6(3) another manner the Court has directed` EQUALS JUST TRUE -- "in such other manner as the Court may direct"
#ASSERT `o 48 r 6(3) the order is drawn up and served as it must be` TRUE `o 48 r 6(3) another manner the Court has not directed` EQUALS NOTHING -- a manner the Court has not directed: a bare "must", not done
#ASSERT `o 48 r 6(3) the order is drawn up and served as it must be` FALSE `o 48 r 6(3) delivering a copy to the debtor personally` EQUALS NOTHING -- not drawn up by or for the creditor
-- (4)
#ASSERT `o 48 r 6(4) service of the order out of Singapore is permissible without permission` TRUE TRUE EQUALS JUST TRUE -- the order, served out of Singapore
#ASSERT `o 48 r 6(4) service of the order out of Singapore is permissible without permission` TRUE FALSE EQUALS NOTHING -- served in Singapore: the paragraph does not speak
#ASSERT `o 48 r 6(4) Order 8, Rules 2, 3, 7 and 8 apply in relation to the order` TRUE TRUE EQUALS JUST TRUE -- served out of Singapore
#ASSERT `o 48 r 6(4) Order 8, Rules 2, 3, 7 and 8 apply in relation to the order` FALSE TRUE EQUALS NOTHING -- not the order giving permission
-- (5): order served 1 June 2026: 14 days begin 2 June and end 15 June 2026 (Monday)
#ASSERT `o 48 r 6(5) the period after service of the order`'s `period length` EQUALS 14 -- "Within 14 days after service of the order"
#ASSERT `o 48 r 6(5) the debtor may apply to set aside the order` (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- on the last day
#ASSERT `o 48 r 6(5) the debtor may apply to set aside the order` (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- a day late
-- barred: date asked, last day, debtor applied within period, application finally disposed of
#ASSERT `o 48 r 6(5) enforcement of the award is barred` (Date 10 6 2026) (Date 15 6 2026) FALSE FALSE EQUALS JUST TRUE -- inside the period, no application
#ASSERT `o 48 r 6(5) enforcement of the award is barred` (Date 15 6 2026) (Date 15 6 2026) FALSE FALSE EQUALS JUST TRUE -- on the last day: the period has not expired
#ASSERT `o 48 r 6(5) enforcement of the award is barred` (Date 16 6 2026) (Date 15 6 2026) FALSE FALSE EQUALS JUST FALSE -- after the period expired with no application
#ASSERT `o 48 r 6(5) enforcement of the award is barred` (Date 16 6 2026) (Date 15 6 2026) TRUE FALSE EQUALS JUST TRUE -- the debtor applied within the period and it is not finally disposed of
#ASSERT `o 48 r 6(5) enforcement of the award is barred` (Date 20 6 2026) (Date 15 6 2026) TRUE TRUE EQUALS JUST FALSE -- the application is finally disposed of
#ASSERT `o 48 r 6(5) the award may be enforced` (Date 10 6 2026) (Date 15 6 2026) FALSE FALSE EQUALS JUST FALSE -- inside the period: "must not be enforced until after"
#ASSERT `o 48 r 6(5) the award may be enforced` (Date 16 6 2026) (Date 15 6 2026) FALSE FALSE EQUALS NOTHING -- the period has expired: the bar is lifted and grants nothing (QA)
#ASSERT `o 48 r 6(5) the award may be enforced` (Date 20 6 2026) (Date 15 6 2026) TRUE TRUE EQUALS NOTHING -- the application is finally disposed of: the bar is lifted and grants nothing (QA)
#ASSERT `o 48 r 6(5) the award may be enforced` (Date 20 6 2026) (Date 15 6 2026) TRUE FALSE EQUALS JUST FALSE -- the application is pending
-- (6)
#ASSERT `o 48 r 6(6) the copy served states the effect of paragraph (5) as it must` TRUE TRUE EQUALS JUST TRUE -- states the effect
#ASSERT `o 48 r 6(6) the copy served states the effect of paragraph (5) as it must` TRUE FALSE EQUALS NOTHING -- does not state it: a bare "must"
#ASSERT `o 48 r 6(6) the copy served states the effect of paragraph (5) as it must` FALSE TRUE EQUALS NOTHING -- not the copy served on the debtor
-- (7)
#ASSERT `o 48 r 6(7) the address this Rule refers to for the creditor or the debtor` TRUE "1 Raffles Place" "2 Orchard Road" EQUALS "2 Orchard Road" -- a body corporate: the registered or principal address
#ASSERT `o 48 r 6(7) the address this Rule refers to for the creditor or the debtor` FALSE "1 Raffles Place" "2 Orchard Road" EQUALS "1 Raffles Place" -- not a body corporate: the usual or last known place of residence or business
#ASSERT `o 48 r 6(7) this Rule affects an enactment on the manner in which a document may be served on a body corporate` EQUALS JUST FALSE -- "nothing in this Rule affects any enactment"

-- ---------------------------------------------------------------------------
-- Rules 7 and 8 (lines 6294, 6296).
-- ---------------------------------------------------------------------------
#ASSERT `o 48 r 7 Order 15, Rule 4 applies to the issue of the order to attend court and order to produce documents` TRUE EQUALS JUST TRUE -- an order under section 13
#ASSERT `o 48 r 7 Order 15, Rule 4 applies to the issue of the order to attend court and order to produce documents` FALSE EQUALS NOTHING -- not under section 13
#ASSERT `o 48 r 8 Order 9, Rule 24 applies to the taking of the evidence` TRUE EQUALS JUST TRUE -- evidence for arbitral proceedings under Article 27
#ASSERT `o 48 r 8 Order 9, Rule 24 applies to the taking of the evidence` FALSE EQUALS NOTHING -- not under Article 27
