IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc3-order-15-affidavits`

-- Tests for Order 15, Division 2, rules 17 to 29 (src lines 1585-1638).  Expected values are written
-- from the text, decided before running.

-- Rule 17
#ASSERT `o 15 r 17 the act is within “affirm”` TRUE EQUALS JUST TRUE -- “affirm” includes “swear”
#ASSERT `o 15 r 17 the act is within “affirm”` FALSE EQUALS NOTHING -- "includes": the list is not closed
#ASSERT `o 15 r 17 the person is within “commissioner for oaths”` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 17 the person is within “commissioner for oaths”` FALSE EQUALS NOTHING

-- Rule 18
#ASSERT `o 15 r 18 the document is an affidavit` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 18 the document is an affidavit` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- not a statement of evidence
#ASSERT `o 15 r 18 the document is an affidavit` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- not in English
#ASSERT `o 15 r 18 the document is an affidavit` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- not signed
#ASSERT `o 15 r 18 the document is an affidavit` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- not affirmed before a commissioner for oaths

-- Rule 19
#ASSERT `o 15 r 19(1) the affidavit is in the form the Rule requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 19(1) the affidavit is in the form the Rule requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 19(1) the affidavit is in the form the Rule requires` FALSE TRUE EQUALS JUST FALSE
-- Rule 19(2): evidence-in-chief in an originating claim; colour; top left; width mm; height mm; last 12 months; full face; no headwear.
#ASSERT `o 15 r 19(2) the photograph is as the Rule requires` TRUE TRUE TRUE 35 45 TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 19(2) the photograph is as the Rule requires` TRUE TRUE TRUE 34 45 TRUE TRUE TRUE EQUALS JUST FALSE -- 34 mm wide
#ASSERT `o 15 r 19(2) the photograph is as the Rule requires` TRUE TRUE TRUE 35 46 TRUE TRUE TRUE EQUALS JUST FALSE -- 46 mm high
#ASSERT `o 15 r 19(2) the photograph is as the Rule requires` TRUE FALSE TRUE 35 45 TRUE TRUE TRUE EQUALS JUST FALSE -- not in colour
#ASSERT `o 15 r 19(2) the photograph is as the Rule requires` TRUE TRUE TRUE 35 45 FALSE TRUE TRUE EQUALS JUST FALSE -- not taken in the last 12 months
#ASSERT `o 15 r 19(2) the photograph is as the Rule requires` TRUE TRUE TRUE 35 45 TRUE FALSE TRUE EQUALS JUST FALSE -- not the full face facing forward
#ASSERT `o 15 r 19(2) the photograph is as the Rule requires` TRUE TRUE TRUE 35 45 TRUE TRUE FALSE EQUALS JUST FALSE -- headwear not worn in accordance with religious or racial customs
#ASSERT `o 15 r 19(2) the photograph is as the Rule requires` TRUE TRUE FALSE 35 45 TRUE TRUE TRUE EQUALS JUST FALSE -- not at the top left hand portion
#ASSERT `o 15 r 19(2) the photograph is as the Rule requires` FALSE TRUE TRUE 35 45 TRUE TRUE TRUE EQUALS NOTHING -- not evidence-in-chief in an originating claim

-- Rules 20 and 21
#ASSERT `o 15 r 20 the person may make an affidavit` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 20 the person may make an affidavit` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 21 two or more persons may make a joint affidavit` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 21 two or more persons may make a joint affidavit` FALSE EQUALS JUST FALSE

-- Rule 22(1): in Singapore with the deponent on the link; compliant technology; the commissioner able to do (3).
#ASSERT `o 15 r 22(1) the affidavit may be affirmed and signed, and the attestation completed and signed, through a live video link or live television link` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 22(1) the affidavit may be affirmed and signed, and the attestation completed and signed, through a live video link or live television link` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING -- not done in Singapore through the link: a scope of the permission
#ASSERT `o 15 r 22(1) the affidavit may be affirmed and signed, and the attestation completed and signed, through a live video link or live television link` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- technology does not comply: a manner of the permission
#ASSERT `o 15 r 22(1) the affidavit may be affirmed and signed, and the attestation completed and signed, through a live video link or live television link` FALSE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- both: the first arm answers
#ASSERT `o 15 r 22(1) the affidavit may be affirmed and signed, and the attestation completed and signed, through a live video link or live television link` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- "Subject to paragraphs (2) and (3)": the commissioner cannot maintain visual contact, so paragraph (3) says no and paragraph (1) follows it
#ASSERT `o 15 r 22(1) the affidavit may be affirmed and signed, and the attestation completed and signed, through a live video link or live television link` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- the commissioner cannot confirm the identity of the deponent
#ASSERT `o 15 r 22(1) the affidavit may be affirmed and signed, and the attestation completed and signed, through a live video link or live television link` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- the commissioner cannot verify, read, interpret and explain the document
#ASSERT `o 15 r 22(1) the affidavit may be affirmed and signed, and the attestation completed and signed, through a live video link or live television link` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- the commissioner cannot confirm that the document signed later is the document affirmed
#ASSERT `o 15 r 22(2) the deponent and the commissioner for oaths may sign the affidavit electronically` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 22(2) the deponent and the commissioner for oaths may sign the affidavit electronically` FALSE EQUALS NOTHING
-- Rule 22(3): taken in Singapore through the link; (a) contact; (b) identity; (c) verify and explain; (d) same document.
#ASSERT `o 15 r 22(3) the commissioner for oaths is able to do what the Rule requires` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 22(3) the commissioner for oaths is able to do what the Rule requires` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 22(3) the commissioner for oaths is able to do what the Rule requires` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 22(3) the commissioner for oaths is able to do what the Rule requires` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 22(3) the commissioner for oaths is able to do what the Rule requires` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 22(3) the commissioner for oaths is able to do what the Rule requires` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- not an affidavit taken in Singapore through a link: "Where"
#ASSERT `o 15 r 23 an affidavit may be affirmed outside Singapore` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 23 an affidavit may be affirmed outside Singapore` FALSE EQUALS NOTHING -- an affidavit affirmed in Singapore: rule 22 and the other rules speak to it

-- Rule 24
#ASSERT `o 15 r 24 the commissioner for oaths must certify on the affidavit the matters in the Rule` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 24 the commissioner for oaths must certify on the affidavit the matters in the Rule` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 24 the commissioner for oaths must certify on the affidavit the matters in the Rule` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 24 the commissioner for oaths must certify on the affidavit the matters in the Rule` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 24 the certificate is as the Rule requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 24 the certificate is as the Rule requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 24 the certificate is as the Rule requires` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 24 the certificate is as the Rule requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 24 the certificate is as the Rule requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

-- Rule 25
#ASSERT `o 15 r 25(1) the matter may be put in the affidavit` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 25(1) the matter may be put in the affidavit` FALSE EQUALS JUST FALSE -- "only relevant facts"
#ASSERT `o 15 r 25(2) the affidavit may contain the matter` TRUE FALSE FALSE EQUALS JUST FALSE -- vulgar or insulting words not in issue
#ASSERT `o 15 r 25(2) the affidavit may contain the matter` TRUE TRUE FALSE EQUALS NOTHING -- vulgar words that are in issue in the action: paragraph (2) does not forbid them, nor does it say they are allowed
#ASSERT `o 15 r 25(2) the affidavit may contain the matter` FALSE FALSE TRUE EQUALS JUST FALSE -- intended to offend or belittle
#ASSERT `o 15 r 25(2) the affidavit may contain the matter` FALSE FALSE FALSE EQUALS NOTHING

-- Rule 26
#ASSERT `o 15 r 26(1) the affidavit may be altered` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 26(1) the affidavit may be altered` TRUE FALSE FALSE EQUALS JUST FALSE -- not re-affirmed
#ASSERT `o 15 r 26(1) the affidavit may be altered` TRUE TRUE TRUE EQUALS NOTHING -- already filed: outside "affirmed but not filed"
#ASSERT `o 15 r 26(1) the affidavit may be altered` FALSE FALSE TRUE EQUALS NOTHING -- not yet affirmed
#ASSERT `o 15 r 26(2) the maker may correct any mistakes in the affidavit by making another affidavit` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 26(2) the maker may correct any mistakes in the affidavit by making another affidavit` FALSE EQUALS NOTHING

-- Rule 27
#ASSERT `o 15 r 27(1) a copy of the document must be annexed to the affidavit` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 27(1) a copy of the document must be annexed to the affidavit` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 27(2) a copy of the whole document must be annexed` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 27(2) a copy of the whole document must be annexed` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 27(3) a copy of only those portions of the document need to be annexed` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 27(3) a copy of only those portions of the document need to be annexed` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 27(4) the identification may be done by annexing a picture of the person or object` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 27(4) the identification may be done by annexing a picture of the person or object` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 27(4) the identification may be done by annexing a picture of the person or object` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 27(5) the annexure must be identified by a certificate of the commissioner for oaths` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 27(5) the annexure must be identified by a certificate of the commissioner for oaths` FALSE EQUALS NOTHING

-- Rules 28 and 29
#ASSERT `o 15 r 28 the seal or signature of the commissioner for oaths must be accepted as valid` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 28 the seal or signature of the commissioner for oaths must be accepted as valid` TRUE TRUE EQUALS JUST FALSE -- "unless the contrary is shown"
#ASSERT `o 15 r 28 the seal or signature of the commissioner for oaths must be accepted as valid` FALSE FALSE EQUALS NOTHING
#ASSERT `o 15 r 29 the party must give notice of the intention to use the affidavit and serve it on every other party` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 29 the party must give notice of the intention to use the affidavit and serve it on every other party` FALSE EQUALS NOTHING
