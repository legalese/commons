IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc2-order-10`

-- Tests for Order 10 (roc2-order-10.l4).  Expected values are written from the text, beside the assertion.
-- One #ASSERT per line.  Made-up dates stand in for the answers of O 3 r 3 (roc1).

-- Rule 1(1): the three limbs
#ASSERT `o 10 r 1(1)(a) the defendant claims against a person not already a party any contribution or indemnity` TRUE EQUALS JUST TRUE -- (a)
#ASSERT `o 10 r 1(1)(a) the defendant claims against a person not already a party any contribution or indemnity` FALSE EQUALS JUST FALSE -- no such claim
#ASSERT `o 10 r 1(1)(b) the defendant claims against a person not already a party a relief or remedy connected with the action` TRUE TRUE EQUALS JUST TRUE -- connected and substantially the same
#ASSERT `o 10 r 1(1)(b) the defendant claims against a person not already a party a relief or remedy connected with the action` TRUE FALSE EQUALS JUST FALSE -- connected but not substantially the same
#ASSERT `o 10 r 1(1)(b) the defendant claims against a person not already a party a relief or remedy connected with the action` FALSE TRUE EQUALS JUST FALSE -- same relief but not connected
#ASSERT `o 10 r 1(1)(c) the defendant requires a question or issue to be determined also as against a person not already a party` TRUE TRUE TRUE EQUALS JUST TRUE -- all three conditions
#ASSERT `o 10 r 1(1)(c) the defendant requires a question or issue to be determined also as against a person not already a party` FALSE TRUE TRUE EQUALS JUST FALSE -- the defendant does not require it
#ASSERT `o 10 r 1(1)(c) the defendant requires a question or issue to be determined also as against a person not already a party` TRUE FALSE TRUE EQUALS JUST FALSE -- not connected with the original subject matter
#ASSERT `o 10 r 1(1)(c) the defendant requires a question or issue to be determined also as against a person not already a party` TRUE TRUE FALSE EQUALS JUST FALSE -- not also as against a person not already a party
-- Rule 1(2)
#ASSERT `o 10 r 1(2) the defendant may issue a third party notice` FALSE `Originating claim` TRUE EQUALS NOTHING -- no permission but within the exception: originating claim, before serving the defence
#ASSERT `o 10 r 1(2) the defendant may issue a third party notice` FALSE `Originating claim` FALSE EQUALS JUST FALSE -- no permission, defence already served
#ASSERT `o 10 r 1(2) the defendant may issue a third party notice` FALSE `Originating application` TRUE EQUALS JUST FALSE -- no permission, action begun by originating application
#ASSERT `o 10 r 1(2) the defendant may issue a third party notice` TRUE `Originating application` FALSE EQUALS NOTHING -- with permission the prohibition does not reach
#ASSERT `o 10 r 1(2) the defendant may issue a third party notice` TRUE `Originating claim` FALSE EQUALS NOTHING -- with permission
-- Rule 1(1) gathered
#ASSERT `o 10 r 1(1) the defendant may issue a third party notice` (JUST TRUE) (JUST FALSE) (JUST FALSE) TRUE NOTHING EQUALS JUST TRUE -- limb (a), notice filed, paragraph (2) does not bar
#ASSERT `o 10 r 1(1) the defendant may issue a third party notice` (JUST FALSE) (JUST FALSE) (JUST TRUE) TRUE NOTHING EQUALS JUST TRUE -- limb (c)
#ASSERT `o 10 r 1(1) the defendant may issue a third party notice` (JUST TRUE) (JUST FALSE) (JUST FALSE) TRUE (JUST FALSE) EQUALS JUST FALSE -- paragraph (2) says no
#ASSERT `o 10 r 1(1) the defendant may issue a third party notice` (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE NOTHING EQUALS JUST FALSE -- "after having filed a notice of intention ... if required": not yet filed, read like "at any time after" (ruling (a), fork F-O10-3), so JUST FALSE
#ASSERT `o 10 r 1(1) the defendant may issue a third party notice` (JUST FALSE) (JUST FALSE) (JUST FALSE) TRUE NOTHING EQUALS JUST FALSE -- none of (a), (b), (c)
#ASSERT `o 10 r 1(1) the defendant may issue a third party notice` (JUST FALSE) NOTHING (JUST FALSE) TRUE NOTHING EQUALS NOTHING -- a limb is not covered
-- The third party notice and the third party
#ASSERT `o 10 r 1(1) the notice is a third party notice` TRUE TRUE TRUE EQUALS JUST TRUE -- Form 20 or 21, with both statements
#ASSERT `o 10 r 1(1) the notice is a third party notice` FALSE TRUE TRUE EQUALS JUST FALSE -- not in the form
#ASSERT `o 10 r 1(1) the notice is a third party notice` TRUE FALSE TRUE EQUALS JUST FALSE -- no statement of the claim made against the defendant
#ASSERT `o 10 r 1(1) the notice is a third party notice` TRUE TRUE FALSE EQUALS JUST FALSE -- no statement of the nature and grounds
#ASSERT `o 10 r 1(3) the person is a third party` TRUE EQUALS JUST TRUE -- served
#ASSERT `o 10 r 1(3) the person is a third party` FALSE EQUALS JUST FALSE -- not served
#ASSERT `o 10 r 1(3) the moment from which the person is a party to the action` TRUE (Moment (Date 3 5 2027) 600) EQUALS JUST (Moment (Date 3 5 2027) 600) -- "as from the time of service"
#ASSERT `o 10 r 1(3) the moment from which the person is a party to the action` FALSE (Moment (Date 3 5 2027) 600) EQUALS NOTHING -- not served
#ASSERT `o 10 r 1(3) the third party has the same rights as a defendant sued in the ordinary way by the defendant who issued the notice` TRUE EQUALS JUST TRUE -- served
#ASSERT `o 10 r 1(3) the third party has the same rights as a defendant sued in the ordinary way by the defendant who issued the notice` FALSE EQUALS JUST FALSE -- not served

-- Rule 2
#ASSERT `o 10 r 2(1) the application may be made by summons without notice in Form 22` TRUE TRUE TRUE EQUALS JUST TRUE -- summons without notice in Form 22
#ASSERT `o 10 r 2(1) the application may be made by summons without notice in Form 22` TRUE TRUE FALSE EQUALS NOTHING -- not in Form 22: limited by its own wording
#ASSERT `o 10 r 2(1) the application may be made by summons without notice in Form 22` TRUE FALSE TRUE EQUALS NOTHING -- a summons with notice
#ASSERT `o 10 r 2(1) the application may be made by summons without notice in Form 22` FALSE TRUE TRUE EQUALS NOTHING -- not an application for permission to issue a third party notice
#ASSERT `o 10 r 2(1) the Court may direct the summons to be served` TRUE EQUALS JUST TRUE -- "but the Court may direct the summons to be served"
#ASSERT `o 10 r 2(1) the Court may direct the summons to be served` FALSE EQUALS NOTHING -- another application
#ASSERT `o 10 r 2(2) the affidavit supports the application as required` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- (a) to (d)
#ASSERT `o 10 r 2(2) the affidavit supports the application as required` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- (a) missing
#ASSERT `o 10 r 2(2) the affidavit supports the application as required` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- (b) missing
#ASSERT `o 10 r 2(2) the affidavit supports the application as required` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- (c) missing
#ASSERT `o 10 r 2(2) the affidavit supports the application as required` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- (d) missing

-- Rule 3
#ASSERT `o 10 r 3(1) the order may contain directions as to the period within which the third party notice is to be issued` TRUE EQUALS JUST TRUE -- the order granting permission
#ASSERT `o 10 r 3(1) the order may contain directions as to the period within which the third party notice is to be issued` FALSE EQUALS NOTHING -- some other order
#ASSERT `o 10 r 3(2) the third party notice is served with what paragraph (2) requires` TRUE TRUE EQUALS JUST TRUE -- the process and the pleadings
#ASSERT `o 10 r 3(2) the third party notice is served with what paragraph (2) requires` FALSE TRUE EQUALS JUST FALSE -- no copy of the originating process
#ASSERT `o 10 r 3(2) the third party notice is served with what paragraph (2) requires` TRUE FALSE EQUALS JUST FALSE -- no copy of the pleadings
#ASSERT `o 10 r 3(3) the provision applies in relation to the third party notice` `Originating claim` `o 10 r 3(3) Order 6, Rule 4` EQUALS JUST TRUE -- Order 6, Rule 4
#ASSERT `o 10 r 3(3) the provision applies in relation to the third party notice` `Originating claim` `o 10 r 3(3) Order 6, Rule 5(6)` EQUALS JUST TRUE -- Order 6, Rule 5(6)
#ASSERT `o 10 r 3(3) the provision applies in relation to the third party notice` `Originating claim` `o 10 r 3(3) Order 6, Rule 5(7)` EQUALS JUST TRUE -- Order 6, Rule 5(7)
#ASSERT `o 10 r 3(3) the provision applies in relation to the third party notice` `Originating claim` `o 10 r 3(3) Order 6, Rule 6` EQUALS JUST TRUE -- Order 6, Rule 6
#ASSERT `o 10 r 3(3) the provision applies in relation to the third party notice` `Originating claim` `o 10 r 3(3) Order 6, Rule 7(4)` EQUALS JUST TRUE -- Order 6, Rule 7(4)
#ASSERT `o 10 r 3(3) the provision applies in relation to the third party notice` `Originating claim` `o 10 r 3(3) Order 6, Rule 7(5)` EQUALS JUST TRUE -- Order 6, Rule 7(5)
#ASSERT `o 10 r 3(3) the provision applies in relation to the third party notice` `Originating claim` `o 10 r 3(3) Order 6, Rule 7(6)` EQUALS JUST TRUE -- Order 6, Rule 7(6)
#ASSERT `o 10 r 3(3) the provision applies in relation to the third party notice` `Originating claim` `o 10 r 3(3) Order 7, Rule 4` EQUALS JUST TRUE -- Order 7, Rule 4
#ASSERT `o 10 r 3(3) the provision applies in relation to the third party notice` `Originating claim` `o 10 r 3(3) Order 7, Rule 5` EQUALS JUST TRUE -- Order 7, Rule 5
#ASSERT `o 10 r 3(3) the provision applies in relation to the third party notice` `Originating claim` `o 10 r 3(3) Order 8` EQUALS JUST TRUE -- Order 8
#ASSERT `o 10 r 3(3) the provision applies in relation to the third party notice` `Originating claim` `o 10 r 3(3) any other provision` EQUALS NOTHING -- a provision not named
#ASSERT `o 10 r 3(3) the provision applies in relation to the third party notice` `Originating application` `o 10 r 3(3) Order 6, Rule 4` EQUALS NOTHING -- an originating application: paragraph (4) speaks
#ASSERT `o 10 r 3(3)(a) the document that the third party notice is treated as` `Originating claim` EQUALS JUST `Originating claim` -- "as if the third party notice were an originating claim"
#ASSERT `o 10 r 3(3)(a) the document that the third party notice is treated as` `Originating application` EQUALS NOTHING -- paragraph (3) is for an originating claim
#ASSERT `o 10 r 3(3)(b) the role taken in the applied provisions` `Originating claim` `o 10 r 3 the defendant issuing the third party notice` EQUALS JUST Claimant -- "the defendant issuing the third party notice were a claimant"
#ASSERT `o 10 r 3(3)(b) the role taken in the applied provisions` `Originating claim` `o 10 r 3 the person against whom the third party notice is issued` EQUALS JUST Defendant -- "the person against whom it is issued a defendant"
#ASSERT `o 10 r 3(3)(b) the role taken in the applied provisions` `Originating application` `o 10 r 3 the defendant issuing the third party notice` EQUALS NOTHING -- paragraph (3) is for an originating claim
#ASSERT `o 10 r 3(4) the provision applies in relation to the third party notice` `Originating application` `o 10 r 3(4) Order 6, Rule 4` EQUALS JUST TRUE -- Order 6, Rule 4
#ASSERT `o 10 r 3(4) the provision applies in relation to the third party notice` `Originating application` `o 10 r 3(4) Order 6, Rule 11(4)` EQUALS JUST TRUE -- Order 6, Rule 11(4)
#ASSERT `o 10 r 3(4) the provision applies in relation to the third party notice` `Originating application` `o 10 r 3(4) Order 6, Rule 11(5)` EQUALS JUST TRUE -- Order 6, Rule 11(5)
#ASSERT `o 10 r 3(4) the provision applies in relation to the third party notice` `Originating application` `o 10 r 3(4) Order 6, Rule 12(3)` EQUALS JUST TRUE -- Order 6, Rule 12(3)
#ASSERT `o 10 r 3(4) the provision applies in relation to the third party notice` `Originating application` `o 10 r 3(4) Order 6, Rule 12(4)` EQUALS JUST TRUE -- Order 6, Rule 12(4)
#ASSERT `o 10 r 3(4) the provision applies in relation to the third party notice` `Originating application` `o 10 r 3(4) Order 6, Rule 12(5)` EQUALS JUST TRUE -- Order 6, Rule 12(5)
#ASSERT `o 10 r 3(4) the provision applies in relation to the third party notice` `Originating application` `o 10 r 3(4) Order 7, Rule 4` EQUALS JUST TRUE -- Order 7, Rule 4
#ASSERT `o 10 r 3(4) the provision applies in relation to the third party notice` `Originating application` `o 10 r 3(4) Order 7, Rule 5` EQUALS JUST TRUE -- Order 7, Rule 5
#ASSERT `o 10 r 3(4) the provision applies in relation to the third party notice` `Originating application` `o 10 r 3(4) Order 8` EQUALS JUST TRUE -- Order 8
#ASSERT `o 10 r 3(4) the provision applies in relation to the third party notice` `Originating application` `o 10 r 3(4) any other provision` EQUALS NOTHING -- a provision not named
#ASSERT `o 10 r 3(4) the provision applies in relation to the third party notice` `Originating claim` `o 10 r 3(4) Order 8` EQUALS NOTHING -- an originating claim: paragraph (3) speaks
#ASSERT `o 10 r 3(4)(a) the document that the third party notice is treated as` `Originating application` EQUALS JUST `Originating application` -- "as if the third party notice were an originating application"
#ASSERT `o 10 r 3(4)(a) the document that the third party notice is treated as` `Originating claim` EQUALS NOTHING -- paragraph (4) is for an originating application
#ASSERT `o 10 r 3(4)(b) the role taken in the applied provisions` `Originating application` `o 10 r 3 the defendant issuing the third party notice` EQUALS JUST Claimant -- a claimant
#ASSERT `o 10 r 3(4)(b) the role taken in the applied provisions` `Originating application` `o 10 r 3 the person against whom the third party notice is issued` EQUALS JUST Defendant -- a defendant
#ASSERT `o 10 r 3(4)(b) the role taken in the applied provisions` `Originating claim` `o 10 r 3 the person against whom the third party notice is issued` EQUALS NOTHING -- paragraph (4) is for an originating application

-- Rule 4
#ASSERT `o 10 r 4(1) the defendant must apply to the Court for directions` TRUE EQUALS JUST TRUE -- the defendant who issued a third party notice
#ASSERT `o 10 r 4(1) the defendant must apply to the Court for directions` FALSE EQUALS NOTHING -- no notice issued: the paragraph speaks of the defendant who issued one
#ASSERT `o 10 r 4(1) the application is made as required` TRUE TRUE EQUALS JUST TRUE -- Form 23 served on all the other parties
#ASSERT `o 10 r 4(1) the application is made as required` FALSE TRUE EQUALS JUST FALSE -- not in Form 23
#ASSERT `o 10 r 4(1) the application is made as required` TRUE FALSE EQUALS JUST FALSE -- not served on all the other parties
#ASSERT `o 10 r 4(1) the defendant's application for directions may be made` `Originating claim` FALSE EQUALS JUST FALSE -- "must not be made before the third party files and serves a notice ... in Form 10"
#ASSERT `o 10 r 4(1) the defendant's application for directions may be made` `Originating claim` TRUE EQUALS NOTHING -- the notice has been filed and served: the prohibition does not reach
#ASSERT `o 10 r 4(1) the defendant's application for directions may be made` `Originating application` FALSE EQUALS NOTHING -- the exception is for an action begun by originating claim
#ASSERT `o 10 r 4(2)(a) fourteen days after the third party files and serves the notice of intention to contest or not contest`'s `period length` EQUALS 14 -- "not earlier than 14 days after filing and serving"
#ASSERT `o 10 r 4(2)(b) fourteen days after service of the notice on the third party`'s `period length` EQUALS 14 -- "not earlier than 14 days after service"
#ASSERT `o 10 r 4(2) the third party may apply` TRUE `Originating claim` (Date 20 6 2027) (Date 20 6 2027) TRUE `o 10 r 4(2) directions` EQUALS JUST TRUE -- on the first day, directions
#ASSERT `o 10 r 4(2) the third party may apply` TRUE `Originating claim` (Date 21 6 2027) (Date 20 6 2027) TRUE `o 10 r 4(2) an order to set aside the third party notice` EQUALS JUST TRUE -- later, an order to set aside
#ASSERT `o 10 r 4(2) the third party may apply` TRUE `Originating application` (Date 20 6 2027) (Date 20 6 2027) TRUE `o 10 r 4(2) directions` EQUALS JUST TRUE -- originating application, 14 days after service
#ASSERT `o 10 r 4(2) the third party may apply` TRUE `Originating claim` (Date 19 6 2027) (Date 20 6 2027) TRUE `o 10 r 4(2) directions` EQUALS JUST FALSE -- a day too early
#ASSERT `o 10 r 4(2) the third party may apply` FALSE `Originating claim` (Date 25 6 2027) (Date 20 6 2027) TRUE `o 10 r 4(2) directions` EQUALS JUST FALSE -- a summons was served under paragraph (1)
#ASSERT `o 10 r 4(2) the third party may apply` TRUE `Originating claim` (Date 25 6 2027) (Date 20 6 2027) FALSE `o 10 r 4(2) directions` EQUALS NOTHING -- not by summons in Form 23 served on all the other parties
#ASSERT `o 10 r 4(2) the third party may apply` TRUE `Originating claim` (Date 25 6 2027) (Date 20 6 2027) TRUE `o 10 r 4(2) any other order` EQUALS NOTHING -- an application for another order
#ASSERT `o 10 r 4(2) the third party may apply` TRUE `Statement of claim` (Date 25 6 2027) (Date 20 6 2027) TRUE `o 10 r 4(2) directions` EQUALS NOTHING -- the paragraph names originating claim and originating application
#ASSERT `o 10 r 4(3) the Court may make this order` TRUE `o 10 r 4(3)(a) such judgment as the nature of the case may require to be entered against the third party in favour of the defendant` TRUE FALSE EQUALS JUST TRUE -- (a): liability established, before any judgment signed
#ASSERT `o 10 r 4(3) the Court may make this order` TRUE `o 10 r 4(3)(a) such judgment as the nature of the case may require to be entered against the third party in favour of the defendant` TRUE TRUE EQUALS JUST TRUE -- (a): after judgment signed by the claimant against the defendant
#ASSERT `o 10 r 4(3) the Court may make this order` TRUE `o 10 r 4(3)(a) such judgment as the nature of the case may require to be entered against the third party in favour of the defendant` FALSE FALSE EQUALS JUST FALSE -- (a): liability not established
#ASSERT `o 10 r 4(3) the Court may make this order` TRUE `o 10 r 4(3)(b) any claim, question or issue stated in the third party notice to be tried in such manner as the Court may direct` FALSE FALSE EQUALS JUST TRUE -- (b)
#ASSERT `o 10 r 4(3) the Court may make this order` TRUE `o 10 r 4(3)(c) the application dismissed and the proceedings on the third party notice terminated` FALSE TRUE EQUALS JUST TRUE -- (c), after judgment signed
#ASSERT `o 10 r 4(3) the Court may make this order` FALSE `o 10 r 4(3)(b) any claim, question or issue stated in the third party notice to be tried in such manner as the Court may direct` FALSE FALSE EQUALS NOTHING -- no application for directions
#ASSERT `o 10 r 4(4) the Court may make this order` TRUE `o 10 r 4(4)(a) give the third party permission to defend the action` EQUALS JUST TRUE -- (a), to defend
#ASSERT `o 10 r 4(4) the Court may make this order` TRUE `o 10 r 4(4)(a) give the third party permission to appear at the trial or hearing and to take such part as may be just` EQUALS JUST TRUE -- (a), to appear
#ASSERT `o 10 r 4(4) the Court may make this order` TRUE `o 10 r 4(4)(b) generally make such orders and give such directions as appear to the Court proper` EQUALS JUST TRUE -- (b)
#ASSERT `o 10 r 4(4) the Court may make this order` FALSE `o 10 r 4(4)(b) generally make such orders and give such directions as appear to the Court proper` EQUALS NOTHING -- no application for directions
#ASSERT `o 10 r 4(5) the Court may vary or rescind the order or direction` TRUE EQUALS JUST TRUE -- made or given under this Rule
#ASSERT `o 10 r 4(5) the Court may vary or rescind the order or direction` FALSE EQUALS NOTHING -- not under this Rule

-- Rule 5
#ASSERT `o 10 r 5(1) the third party is in default` TRUE FALSE FALSE FALSE EQUALS JUST TRUE -- required to file and serve the notice but did not
#ASSERT `o 10 r 5(1) the third party is in default` TRUE TRUE TRUE FALSE EQUALS JUST TRUE -- filed, ordered to serve a defence, did not
#ASSERT `o 10 r 5(1) the third party is in default` TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- filed, ordered to serve a defence, did
#ASSERT `o 10 r 5(1) the third party is in default` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- filed, not ordered to serve a defence
#ASSERT `o 10 r 5(1) the third party is in default` FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- not required to file and serve the notice
#ASSERT `o 10 r 5(1)(a) the third party is deemed to admit any claim stated in the third party notice` TRUE EQUALS JUST TRUE -- in default
#ASSERT `o 10 r 5(1)(a) the third party is deemed to admit any claim stated in the third party notice` FALSE EQUALS JUST FALSE -- not in default
#ASSERT `o 10 r 5(1)(a) the third party is bound by the judgment or decision in the action` TRUE TRUE EQUALS JUST TRUE -- in default, relevant to a claim stated in the notice
#ASSERT `o 10 r 5(1)(a) the third party is bound by the judgment or decision in the action` TRUE FALSE EQUALS NOTHING -- "insofar as it is relevant": the Rule does not say it is not bound otherwise
#ASSERT `o 10 r 5(1)(a) the third party is bound by the judgment or decision in the action` FALSE TRUE EQUALS JUST FALSE -- not in default
#ASSERT `o 10 r 5(1)(b) the defendant may enter judgment against the third party` TRUE TRUE TRUE FALSE `o 10 r 5(1)(b)(i) a contribution or indemnity` FALSE EQUALS JUST TRUE -- (i): judgment satisfied, no permission needed
#ASSERT `o 10 r 5(1)(b) the defendant may enter judgment against the third party` TRUE TRUE FALSE TRUE `o 10 r 5(1)(b)(i) a contribution or indemnity` FALSE EQUALS JUST TRUE -- (i): before satisfaction with the Court's permission
#ASSERT `o 10 r 5(1)(b) the defendant may enter judgment against the third party` TRUE TRUE FALSE FALSE `o 10 r 5(1)(b)(i) a contribution or indemnity` FALSE EQUALS JUST FALSE -- (i): before satisfaction, no permission: outside "at any time after satisfaction ... or, with the permission of the Court, before", so JUST FALSE
#ASSERT `o 10 r 5(1)(b) the defendant may enter judgment against the third party` TRUE TRUE TRUE FALSE `o 10 r 5(1)(b)(ii) any other relief or remedy` TRUE EQUALS JUST TRUE -- (ii): satisfied, with the permission of the Court for the other relief
#ASSERT `o 10 r 5(1)(b) the defendant may enter judgment against the third party` TRUE TRUE TRUE FALSE `o 10 r 5(1)(b)(ii) any other relief or remedy` FALSE EQUALS NOTHING -- (ii): no permission for the other relief
#ASSERT `o 10 r 5(1)(b) the defendant may enter judgment against the third party` TRUE FALSE TRUE FALSE `o 10 r 5(1)(b)(i) a contribution or indemnity` FALSE EQUALS JUST FALSE -- no judgment in default against the defendant
#ASSERT `o 10 r 5(1)(b) the defendant may enter judgment against the third party` FALSE TRUE TRUE FALSE `o 10 r 5(1)(b)(i) a contribution or indemnity` FALSE EQUALS JUST FALSE -- the third party is not in default
#ASSERT `o 10 r 5(2) the Court may make this order` TRUE TRUE `o 10 r 5(2) such judgment to be entered for the applicant as the applicant is entitled to on the pleadings` EQUALS JUST TRUE -- judgment on the pleadings
#ASSERT `o 10 r 5(2) the Court may make this order` TRUE TRUE `o 10 r 5(2) such other order as may appear to the Court necessary to do justice between the parties` EQUALS JUST TRUE -- other order
#ASSERT `o 10 r 5(2) the Court may make this order` TRUE FALSE `o 10 r 5(2) such other order as may appear to the Court necessary to do justice between the parties` EQUALS NOTHING -- no application by summons
#ASSERT `o 10 r 5(2) the Court may make this order` FALSE TRUE `o 10 r 5(2) such judgment to be entered for the applicant as the applicant is entitled to on the pleadings` EQUALS JUST FALSE -- no default in serving the pleading
#ASSERT `o 10 r 5(3) the Court may set aside or vary the judgment` TRUE EQUALS JUST TRUE -- entered under paragraph (1)(b) or (2)
#ASSERT `o 10 r 5(3) the Court may set aside or vary the judgment` FALSE EQUALS NOTHING -- some other judgment

-- Rules 6 and 7
#ASSERT `o 10 r 6 the Court may set aside the proceedings` TRUE EQUALS JUST TRUE -- proceedings on a third party notice
#ASSERT `o 10 r 6 the Court may set aside the proceedings` FALSE EQUALS NOTHING -- other proceedings
#ASSERT `o 10 r 7(1) the Court may order this judgment` TRUE `o 10 r 7(1) at or after the trial of the action` FALSE `o 10 r 7(1) judgment for the defendant against the third party` EQUALS JUST TRUE -- at or after the trial, for the defendant
#ASSERT `o 10 r 7(1) the Court may order this judgment` TRUE `o 10 r 7(1) at or after the trial of the action` FALSE `o 10 r 7(1) judgment for the third party against the defendant` EQUALS JUST TRUE -- at or after the trial, for the third party
#ASSERT `o 10 r 7(1) the Court may order this judgment` TRUE `o 10 r 7(1) otherwise than by trial` TRUE `o 10 r 7(1) judgment for the defendant against the third party` EQUALS JUST TRUE -- decided otherwise than by trial, on an application by summons
#ASSERT `o 10 r 7(1) the Court may order this judgment` TRUE `o 10 r 7(1) otherwise than by trial` TRUE `o 10 r 7(1) judgment for the third party against the defendant` EQUALS JUST TRUE -- same, for the third party
#ASSERT `o 10 r 7(1) the Court may order this judgment` TRUE `o 10 r 7(1) otherwise than by trial` FALSE `o 10 r 7(1) judgment for the defendant against the third party` EQUALS NOTHING -- decided otherwise than by trial, no application
#ASSERT `o 10 r 7(1) the Court may order this judgment` FALSE `o 10 r 7(1) at or after the trial of the action` FALSE `o 10 r 7(1) judgment for the defendant against the third party` EQUALS JUST FALSE -- the defendant has not served a third party notice
#ASSERT `o 10 r 7(2) an enforcement order may be issued against the third party` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- both judgments, the judgment against the defendant not satisfied, no permission
#ASSERT `o 10 r 7(2) an enforcement order may be issued against the third party` TRUE TRUE TRUE FALSE EQUALS NOTHING -- the judgment against the defendant has been satisfied
#ASSERT `o 10 r 7(2) an enforcement order may be issued against the third party` TRUE TRUE FALSE TRUE EQUALS NOTHING -- with the permission of the Court
#ASSERT `o 10 r 7(2) an enforcement order may be issued against the third party` TRUE FALSE FALSE FALSE EQUALS NOTHING -- no judgment for the defendant against the third party
#ASSERT `o 10 r 7(2) an enforcement order may be issued against the third party` FALSE TRUE FALSE FALSE EQUALS NOTHING -- no judgment against the defendant

-- Rule 8
#ASSERT `o 10 r 8(1)(a) the defendant claims against a person already a party any contribution or indemnity` TRUE EQUALS JUST TRUE -- (a)
#ASSERT `o 10 r 8(1)(a) the defendant claims against a person already a party any contribution or indemnity` FALSE EQUALS JUST FALSE -- no such claim
#ASSERT `o 10 r 8(1)(b) the defendant claims against a person already a party a relief or remedy connected with the action` TRUE TRUE EQUALS JUST TRUE -- (b)
#ASSERT `o 10 r 8(1)(b) the defendant claims against a person already a party a relief or remedy connected with the action` TRUE FALSE EQUALS JUST FALSE -- not substantially the same
#ASSERT `o 10 r 8(1)(c) the defendant requires a question or issue to be determined also as against another party` TRUE TRUE TRUE EQUALS JUST TRUE -- (c)
#ASSERT `o 10 r 8(1)(c) the defendant requires a question or issue to be determined also as against another party` TRUE TRUE FALSE EQUALS JUST FALSE -- not also as against another party
#ASSERT `o 10 r 8(2) paragraph (1) applies in relation to the claim` TRUE EQUALS JUST FALSE -- the claim could be made by counterclaim: "paragraph (1) does not apply"
#ASSERT `o 10 r 8(2) paragraph (1) applies in relation to the claim` FALSE EQUALS NOTHING -- not a claim that could be made by counterclaim
#ASSERT `o 10 r 8(1) the defendant may issue and serve a notice on the person without permission` (JUST TRUE) (JUST FALSE) (JUST FALSE) TRUE NOTHING EQUALS JUST TRUE -- limb (a), no permission input
#ASSERT `o 10 r 8(1) the defendant may issue and serve a notice on the person without permission` (JUST FALSE) (JUST TRUE) (JUST FALSE) TRUE NOTHING EQUALS JUST TRUE -- limb (b)
#ASSERT `o 10 r 8(1) the defendant may issue and serve a notice on the person without permission` (JUST TRUE) (JUST FALSE) (JUST FALSE) TRUE (JUST FALSE) EQUALS JUST FALSE -- paragraph (2): the claim could be made by counterclaim
#ASSERT `o 10 r 8(1) the defendant may issue and serve a notice on the person without permission` (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE NOTHING EQUALS JUST FALSE -- notice of intention not yet filed and served: "after having filed and served" read like "at any time after" (fork F-O10-3), so JUST FALSE
#ASSERT `o 10 r 8(1) the defendant may issue and serve a notice on the person without permission` (JUST FALSE) (JUST FALSE) (JUST FALSE) TRUE NOTHING EQUALS JUST FALSE -- none of (a), (b), (c)
#ASSERT `o 10 r 8(1) the defendant may issue and serve a notice on the person without permission` NOTHING (JUST FALSE) (JUST FALSE) TRUE NOTHING EQUALS NOTHING -- a limb is not covered
#ASSERT `o 10 r 8(1) the notice contains what paragraph (1) requires` TRUE EQUALS JUST TRUE -- the statement is there
#ASSERT `o 10 r 8(1) the notice contains what paragraph (1) requires` FALSE EQUALS NOTHING -- the Rule does not say what follows
#ASSERT `o 10 r 8(3) filing and serving a notice of intention to contest or not contest in relation to the notice is necessary` TRUE FALSE `Originating claim` EQUALS JUST FALSE -- (a): the person has filed and served a notice in the action
#ASSERT `o 10 r 8(3) filing and serving a notice of intention to contest or not contest in relation to the notice is necessary` FALSE TRUE `Originating claim` EQUALS JUST FALSE -- (b): the person is a claimant
#ASSERT `o 10 r 8(3) filing and serving a notice of intention to contest or not contest in relation to the notice is necessary` FALSE FALSE `Originating application` EQUALS JUST FALSE -- (c): the action was begun by originating application
#ASSERT `o 10 r 8(3) filing and serving a notice of intention to contest or not contest in relation to the notice is necessary` FALSE FALSE `Originating claim` EQUALS NOTHING -- none of (a), (b), (c): the paragraph does not say it is necessary
#ASSERT `o 10 r 8(3)(d) the person served is treated as a third party` TRUE EQUALS JUST TRUE -- the notice has been served
#ASSERT `o 10 r 8(3)(d) the person served is treated as a third party` FALSE EQUALS NOTHING -- not served
#ASSERT `o 10 r 8(3)(e) the person served is treated as having filed a notice of intention to contest or not contest in relation to the notice` `Originating claim` TRUE FALSE EQUALS JUST TRUE -- originating claim, filed and served in the action
#ASSERT `o 10 r 8(3)(e) the person served is treated as having filed a notice of intention to contest or not contest in relation to the notice` `Originating claim` FALSE TRUE EQUALS JUST TRUE -- originating claim, a claimant
#ASSERT `o 10 r 8(3)(e) the person served is treated as having filed a notice of intention to contest or not contest in relation to the notice` `Originating claim` FALSE FALSE EQUALS JUST FALSE -- originating claim, neither filed nor a claimant
#ASSERT `o 10 r 8(3)(e) the person served is treated as having filed a notice of intention to contest or not contest in relation to the notice` `Originating application` TRUE TRUE EQUALS JUST FALSE -- originating application: the "where" speaks of an action begun by originating claim
#ASSERT `o 10 r 8(4) fourteen days after service of the notice on the person`'s `period length` EQUALS 14 -- "not earlier than 14 days after service of the notice on that person"
#ASSERT `o 10 r 8(4) the person may apply` TRUE (Date 20 6 2027) (Date 20 6 2027) TRUE `o 10 r 4(2) directions` EQUALS JUST TRUE -- on the first day, directions
#ASSERT `o 10 r 8(4) the person may apply` TRUE (Date 20 6 2027) (Date 20 6 2027) TRUE `o 10 r 4(2) an order to set aside the third party notice` EQUALS JUST TRUE -- an order to set aside the notice
#ASSERT `o 10 r 8(4) the person may apply` TRUE (Date 19 6 2027) (Date 20 6 2027) TRUE `o 10 r 4(2) directions` EQUALS JUST FALSE -- a day too early
#ASSERT `o 10 r 8(4) the person may apply` FALSE (Date 25 6 2027) (Date 20 6 2027) TRUE `o 10 r 4(2) directions` EQUALS JUST FALSE -- a summons under Rule 4(1) was served
#ASSERT `o 10 r 8(4) the person may apply` TRUE (Date 25 6 2027) (Date 20 6 2027) FALSE `o 10 r 4(2) directions` EQUALS NOTHING -- not by summons in Form 23 served on all the other parties
#ASSERT `o 10 r 8(4) the person may apply` TRUE (Date 25 6 2027) (Date 20 6 2027) TRUE `o 10 r 4(2) any other order` EQUALS NOTHING -- an application for another order

-- Rules 9 and 10
#ASSERT `o 10 r 9(1) this Order applies as if the party were a defendant` `Third party` TRUE TRUE FALSE EQUALS JUST TRUE -- a third party who makes such a claim
#ASSERT `o 10 r 9(1) this Order applies as if the party were a defendant` `Third party` FALSE TRUE FALSE EQUALS JUST FALSE -- no defendant has served a third party notice
#ASSERT `o 10 r 9(1) this Order applies as if the party were a defendant` `Third party` TRUE FALSE FALSE EQUALS JUST FALSE -- the third party makes no such claim
#ASSERT `o 10 r 9(1) this Order applies as if the party were a defendant` `Fourth party` FALSE TRUE TRUE EQUALS JUST TRUE -- "similarly" a further person to whom this Order applies as if a third party
#ASSERT `o 10 r 9(1) this Order applies as if the party were a defendant` `Fourth party` FALSE TRUE FALSE EQUALS JUST FALSE -- this Order does not apply to the further person
#ASSERT `o 10 r 9(1) this Order applies as if the party were a defendant` `Fourth party` FALSE FALSE TRUE EQUALS JUST FALSE -- the further person makes no such claim
#ASSERT `o 10 r 9(1) this Order applies as if the party were a defendant` Claimant TRUE TRUE TRUE EQUALS NOTHING -- not a third party or a further person
#ASSERT `o 10 r 9(1) this Order applies as if the party were a defendant` Defendant TRUE TRUE TRUE EQUALS NOTHING -- same
#ASSERT `o 10 r 9(1) this Order applies as if the party were a defendant` Appellant TRUE TRUE TRUE EQUALS NOTHING -- same
#ASSERT `o 10 r 9(1) this Order applies as if the party were a defendant` Respondent TRUE TRUE TRUE EQUALS NOTHING -- same
#ASSERT `o 10 r 9(1) this Order applies as if the party were a defendant` `Non-party` TRUE TRUE TRUE EQUALS NOTHING -- same
#ASSERT `o 10 r 9(2) the paragraph that restricts the issue of the notice is` TRUE EQUALS `o 10 r 9(3)` -- by a third party: paragraph (3) "in substitution for Rule 1(2)"
#ASSERT `o 10 r 9(2) the paragraph that restricts the issue of the notice is` FALSE EQUALS `o 10 r 1(2)` -- by a defendant: Rule 1(2)
#ASSERT `o 10 r 9(3) fourteen days after the time limited for filing and serving a notice to contest or not contest`'s `period length` EQUALS 14 -- "14 days after the time limited"
#ASSERT `o 10 r 9(3) the third party may issue a notice under Rule 1` FALSE `Originating claim` (Date 20 6 2027) (Date 20 6 2027) EQUALS NOTHING -- no permission but on the last day, an originating claim
#ASSERT `o 10 r 9(3) the third party may issue a notice under Rule 1` FALSE `Originating claim` (Date 21 6 2027) (Date 20 6 2027) EQUALS JUST FALSE -- no permission, a day after the expiration
#ASSERT `o 10 r 9(3) the third party may issue a notice under Rule 1` FALSE `Originating application` (Date 1 6 2027) (Date 20 6 2027) EQUALS JUST FALSE -- no permission, action begun by originating application
#ASSERT `o 10 r 9(3) the third party may issue a notice under Rule 1` TRUE `Originating application` (Date 21 6 2027) (Date 20 6 2027) EQUALS NOTHING -- with permission the prohibition does not reach
#ASSERT `o 10 r 10 the role taken in applying Rules 1 to 9 to the counterclaim` TRUE `o 10 r 10 the person making the counterclaim` EQUALS JUST Claimant -- "the person making the counterclaim were the claimant"
#ASSERT `o 10 r 10 the role taken in applying Rules 1 to 9 to the counterclaim` TRUE `o 10 r 10 the person against whom the counterclaim is made` EQUALS JUST Defendant -- "the person against whom it is made a defendant"
#ASSERT `o 10 r 10 the role taken in applying Rules 1 to 9 to the counterclaim` FALSE `o 10 r 10 the person making the counterclaim` EQUALS NOTHING -- no counterclaim
#ASSERT `o 10 r 10 Rules 1 to 9 apply to the counterclaim as if its subject matter were the original subject matter of the action` TRUE EQUALS JUST TRUE -- a counterclaim is made by a defendant
#ASSERT `o 10 r 10 Rules 1 to 9 apply to the counterclaim as if its subject matter were the original subject matter of the action` FALSE EQUALS JUST FALSE -- no counterclaim
