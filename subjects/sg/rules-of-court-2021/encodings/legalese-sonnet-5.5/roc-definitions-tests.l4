IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`

-- Rules of Court 2021 (Singapore): tests for roc-definitions.l4 (Order 1, Rules 1 to 3).
-- EVERY EXPECTED VALUE IS WRITTEN FROM THE TEXT, beside its assertion, before it was run.
-- A result is JUST TRUE, JUST FALSE or NOTHING; NOTHING is not FALSE.
-- The source is a plain-text rendering, not the official text.

-- ---------------------------------------------------------------------------
-- Fixtures
-- ---------------------------------------------------------------------------

GIVEN level IS A `Court level`
      maker IS A `Decision maker`
GIVETH A Sitting
`test sitting` MEANS Sitting WITH
    `sitting court level` IS level
    `sitting decision maker` IS maker

GIVEN level IS A `Court level`
      day IS A DATE
GIVETH AN Action
`test action` MEANS Action WITH
    `action commenced by` IS `Originating claim`
    `action commenced on` IS day
    `action court level` IS level

-- A calendar whose only public holiday is Thursday 12 November 2026.
`test calendar` MEANS `Court calendar` WITH `public holidays` IS LIST (Date 12 11 2026)

-- ---------------------------------------------------------------------------
§ `Rule 3(1), opening words`
-- ---------------------------------------------------------------------------

-- "unless the context otherwise requires": where it does, the defined meaning does not hold.
#ASSERT `o 1 r 3(1) a defined term has its defined meaning` TRUE EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a defined term has its defined meaning` FALSE EQUALS JUST TRUE

-- ---------------------------------------------------------------------------
§ `Rule 3(1) -- "action" to "defendant"`
-- ---------------------------------------------------------------------------

-- "action" means proceedings commenced by an originating claim or an originating application.
#ASSERT `o 1 r 3(1) proceedings commenced by a document are an action` `Originating claim` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) proceedings commenced by a document are an action` `Originating application` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) proceedings commenced by a document are an action` Summons EQUALS JUST FALSE

-- "appellate Court" means the Court to which an appeal is brought or is being brought.
#ASSERT `o 1 r 3(1) a court is the appellate Court` TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a court is the appellate Court` FALSE EQUALS JUST FALSE

-- "Appellate Division" means the Appellate Division of the High Court.
#ASSERT `o 1 r 3(1) a court is the Appellate Division` `Appellate Division` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a court is the Appellate Division` `Court of Appeal` EQUALS JUST FALSE

-- "attend" includes appearance by electronic, mechanical or other means permitted by the Court.
#ASSERT `o 1 r 3(1) a person attends` TRUE TRUE TRUE EQUALS JUST TRUE
-- Appearing by electronic means the Court did not permit: the text does not say that is not attending.
#ASSERT `o 1 r 3(1) a person attends` TRUE TRUE FALSE EQUALS NOTHING
-- Appearing in person is not mentioned: the list is not closed.
#ASSERT `o 1 r 3(1) a person attends` TRUE FALSE FALSE EQUALS NOTHING

-- "bailiff" includes the Registrar, any clerk or other officer charged with the duties of a bailiff.
#ASSERT `o 1 r 3(1) a person is a bailiff` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is a bailiff` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is a bailiff` FALSE FALSE EQUALS NOTHING

-- "case conference" means a case conference as described in Order 9, Rule 1 (another part's range).
#ASSERT `o 1 r 3(1) a meeting is a case conference` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a meeting is a case conference` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a meeting is a case conference` NOTHING EQUALS NOTHING

-- "Civil Procedure Convention" means any convention in the Third Schedule and includes any
-- convention, treaty or agreement between different States relating to civil procedure in the Court.
#ASSERT `o 1 r 3(1) an instrument is a Civil Procedure Convention` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) an instrument is a Civil Procedure Convention` NOTHING TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) an instrument is a Civil Procedure Convention` (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) an instrument is a Civil Procedure Convention` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `o 1 r 3(1) an instrument is a Civil Procedure Convention` NOTHING FALSE EQUALS NOTHING

-- "claimant" includes a party in the position of a claimant in a counterclaim.
#ASSERT `o 1 r 3(1) a person is a claimant` Claimant FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is a claimant` Defendant TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is a claimant` Defendant FALSE EQUALS NOTHING

-- "counterclaim" has the same meaning as "statement of claim".
#ASSERT `o 1 r 3(1) a statement is a counterclaim` TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a statement is a counterclaim` FALSE EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§ `Rule 3(1) -- "Court"`
-- ---------------------------------------------------------------------------

-- Limb (a): the General Division or a judge sitting in it.
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `General Division` `The court itself`) FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `General Division` `A Judge`) FALSE FALSE EQUALS JUST TRUE
-- Limb (b): a District Court or a District Judge.
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `District Court` `The court itself`) FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `District Court` `A District Judge`) FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `Magistrate's Court` `A District Judge`) FALSE FALSE EQUALS JUST TRUE
-- Limb (c): the Appellate Division or the Court of Appeal, or a judge sitting in either where appropriate.
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `Appellate Division` `The court itself`) FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `Court of Appeal` `The court itself`) FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `Appellate Division` `A Judge`) TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `Court of Appeal` `A Judge`) FALSE FALSE EQUALS NOTHING
-- Limb (d): in cases where empowered to act, a Magistrate or the Registrar.
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `Magistrate's Court` `A Magistrate`) FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `Magistrate's Court` `A Magistrate`) FALSE FALSE EQUALS NOTHING
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `General Division` `The Registrar`) FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `General Division` `The Registrar`) FALSE FALSE EQUALS NOTHING
-- Outside every limb: "means" closes the list.
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `Family Division` `The court itself`) TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `Singapore International Commercial Court` `A Judge`) TRUE TRUE EQUALS JUST FALSE
-- The Magistrate's Court as a body is not named; only "a Magistrate" is.
#ASSERT `o 1 r 3(1) a decision-maker sitting in a court is the Court` (`test sitting` `Magistrate's Court` `The court itself`) TRUE TRUE EQUALS NOTHING

-- The limbs one by one.
#ASSERT `o 1 r 3(1) limb (a) the General Division or a judge sitting in it` (`test sitting` `General Division` `A Judge`)
#ASSERT NOT (`o 1 r 3(1) limb (a) the General Division or a judge sitting in it` (`test sitting` `District Court` `A Judge`))
#ASSERT `o 1 r 3(1) limb (b) a District Court or a District Judge` (`test sitting` `District Court` `The court itself`)
#ASSERT NOT (`o 1 r 3(1) limb (b) a District Court or a District Judge` (`test sitting` `General Division` `The court itself`))
#ASSERT `o 1 r 3(1) limb (c) the Appellate Division or the Court of Appeal, or a judge sitting in either` (`test sitting` `Court of Appeal` `The court itself`) FALSE
#ASSERT NOT (`o 1 r 3(1) limb (c) the Appellate Division or the Court of Appeal, or a judge sitting in either` (`test sitting` `Court of Appeal` `A Judge`) FALSE)
#ASSERT `o 1 r 3(1) limb (d) in cases where empowered, a Magistrate or the Registrar` (`test sitting` `District Court` `The Registrar`) TRUE
#ASSERT NOT (`o 1 r 3(1) limb (d) in cases where empowered, a Magistrate or the Registrar` (`test sitting` `District Court` `The Registrar`) FALSE)

-- "court fees" has the meaning given by Order 25, Rule 1 (another part's range).
#ASSERT `o 1 r 3(1) a payment is within court fees` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a payment is within court fees` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a payment is within court fees` NOTHING EQUALS NOTHING

-- "defence" includes a defence to a counterclaim.
#ASSERT `o 1 r 3(1) a document is a defence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a document is a defence` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a document is a defence` FALSE FALSE EQUALS NOTHING

-- "defendant" includes a party in the position of a defendant in a counterclaim.
#ASSERT `o 1 r 3(1) a person is a defendant` Defendant FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is a defendant` Claimant TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is a defendant` Claimant FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Rule 3(1) -- "entity" to "working day"`
-- ---------------------------------------------------------------------------

-- "entity" means any body of persons, whether incorporated or unincorporated.
#ASSERT `o 1 r 3(1) a person is an entity` (Entity TRUE) EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is an entity` (Entity FALSE) EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is an entity` (`Natural person` 30) EQUALS JUST FALSE

-- "General Division" means the General Division of the High Court.
#ASSERT `o 1 r 3(1) a court is the General Division` `General Division` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a court is the General Division` `District Court` EQUALS JUST FALSE

-- "Ideals" means the Ideals set out in Order 3, Rule 1(2) (another part's range).
#ASSERT `o 1 r 3(1) an objective is one of the Ideals` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) an objective is one of the Ideals` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) an objective is one of the Ideals` NOTHING EQUALS NOTHING

-- "Judge": a judge sitting in the General Division or a District Judge, and (includes) a judge of
-- the Appellate Division or Court of Appeal where appropriate, and where empowered a Magistrate or the Registrar.
#ASSERT `o 1 r 3(1) a person sitting in a court is a Judge` (`test sitting` `General Division` `A Judge`) FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person sitting in a court is a Judge` (`test sitting` `District Court` `A District Judge`) FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person sitting in a court is a Judge` (`test sitting` `Court of Appeal` `A Judge`) TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person sitting in a court is a Judge` (`test sitting` `Court of Appeal` `A Judge`) FALSE FALSE EQUALS NOTHING
#ASSERT `o 1 r 3(1) a person sitting in a court is a Judge` (`test sitting` `Magistrate's Court` `A Magistrate`) FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person sitting in a court is a Judge` (`test sitting` `Magistrate's Court` `A Magistrate`) FALSE FALSE EQUALS NOTHING
-- The court as a body is not a judge, but the text says "includes": the list is not closed.
#ASSERT `o 1 r 3(1) a person sitting in a court is a Judge` (`test sitting` `General Division` `The court itself`) TRUE TRUE EQUALS NOTHING
#ASSERT `o 1 r 3(1) a person sitting in a court is a Judge` (`test sitting` `Family Division` `A Judge`) TRUE TRUE EQUALS NOTHING

-- "lower Court" means the Court against which judgment or order an appeal is brought or being brought.
#ASSERT `o 1 r 3(1) a court is the lower Court` TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a court is the lower Court` FALSE EQUALS JUST FALSE

-- "medical report" means a report substantiating all the personal injuries alleged in the statement
-- of claim which the claimant proposes to adduce in evidence.
#ASSERT `o 1 r 3(1) a report is a medical report` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a report is a medical report` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a report is a medical report` FALSE TRUE EQUALS JUST FALSE

-- "non-court day" means a Saturday, Sunday or public holiday.  Saturday 7 and Sunday 8 November 2026;
-- Monday 9 November 2026 is an ordinary weekday; Thursday 12 November 2026 is the fixture's holiday.
#ASSERT `o 1 r 3(1) a day is a non-court day` (Date 7 11 2026) `test calendar` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a day is a non-court day` (Date 8 11 2026) `test calendar` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a day is a non-court day` (Date 9 11 2026) `test calendar` EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a day is a non-court day` (Date 12 11 2026) `test calendar` EQUALS JUST TRUE

-- "non-party" means any person who is not a party in the action and includes a person who
-- participates because of a statutory duty or because he or she may be affected by the Court's decision.
#ASSERT `o 1 r 3(1) a person is a non-party` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is a non-party` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is a non-party` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is a non-party` TRUE FALSE FALSE EQUALS JUST FALSE

-- "officer" means an officer of the Supreme Court or the State Courts.
#ASSERT `o 1 r 3(1) a person is an officer` (JUST `Supreme Court`) EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is an officer` (JUST `State Courts`) EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is an officer` NOTHING EQUALS JUST FALSE

-- "originating application" and "originating claim": an originating process commenced as described
-- in Order 6, Rule 11 and Rule 5 (another part's range).
#ASSERT `o 1 r 3(1) a document is an originating application` `Originating application` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a document is an originating application` `Originating application` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a document is an originating application` `Originating application` NOTHING EQUALS NOTHING
#ASSERT `o 1 r 3(1) a document is an originating application` `Originating claim` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a document is an originating claim` `Originating claim` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a document is an originating claim` `Originating claim` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a document is an originating claim` `Originating claim` NOTHING EQUALS NOTHING
#ASSERT `o 1 r 3(1) a document is an originating claim` Summons (JUST TRUE) EQUALS JUST FALSE

-- "originating process" means an originating claim or an originating application.
#ASSERT `o 1 r 3(1) a document is an originating process` `Originating claim` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a document is an originating process` `Originating application` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a document is an originating process` Summons EQUALS JUST FALSE

-- "pleading" includes a statement of claim, defence, defence and counterclaim, reply and reply to a
-- defence and counterclaim.
#ASSERT `o 1 r 3(1) a document is a pleading` `Statement of claim` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a document is a pleading` Defence EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a document is a pleading` `Defence and counterclaim` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a document is a pleading` Reply EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a document is a pleading` `Reply to a defence and counterclaim` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a document is a pleading` Summons EQUALS NOTHING
#ASSERT `o 1 r 3(1) a document is a pleading` Affidavit EQUALS NOTHING

-- "practice directions": issued under Order 26, Rule 2 (another part's range) by (a) the Registrar of
-- the Supreme Court with the approval of the Chief Justice or (b) the Registrar of the State Courts
-- with the approval of the Presiding Judge of the State Courts.
#ASSERT `o 1 r 3(1) directions are practice directions` (JUST TRUE) `Supreme Court` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) directions are practice directions` (JUST TRUE) `State Courts` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) directions are practice directions` (JUST TRUE) `Supreme Court` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) directions are practice directions` (JUST TRUE) `State Courts` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) directions are practice directions` (JUST FALSE) `Supreme Court` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) directions are practice directions` NOTHING `Supreme Court` TRUE FALSE EQUALS NOTHING

-- "Registrar": the Registrar of the Supreme Court or of the State Courts (as the case may be).
#ASSERT `o 1 r 3(1) a person is the Registrar` `Supreme Court` (JUST `Supreme Court`) EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is the Registrar` `Supreme Court` (JUST `State Courts`) EQUALS NOTHING
#ASSERT `o 1 r 3(1) a person is the Registrar` `Supreme Court` NOTHING EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a reference to the Registry is to the Registry of the Registrar of the case` `State Courts` `State Courts` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a reference to the Registry is to the Registry of the Registrar of the case` `State Courts` `Supreme Court` EQUALS NOTHING

-- "Rules" means these Rules of Court.
#ASSERT `o 1 r 3(1) an instrument is the Rules` TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) an instrument is the Rules` FALSE EQUALS JUST FALSE

-- "Sheriff" includes a bailiff of the Supreme Court or a bailiff of the State Courts.
#ASSERT `o 1 r 3(1) a person is the Sheriff` TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is the Sheriff` FALSE EQUALS NOTHING

-- "sign" and "seal" by a Judge, the Registrar or other officer include signing and sealing by
-- electronic or other means.
#ASSERT `o 1 r 3(1) signing or sealing is signing or sealing` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) signing or sealing is signing or sealing` TRUE FALSE EQUALS NOTHING
#ASSERT `o 1 r 3(1) signing or sealing is signing or sealing` FALSE TRUE EQUALS NOTHING

-- "solicitor" has the meaning given by section 2 of the Legal Profession Act (not among the sources) and
-- includes the firm the solicitor is in, and the Attorney-General, a Deputy or Solicitor-General who is a party or appears.
#ASSERT `o 1 r 3(1) a person is a solicitor` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is a solicitor` NOTHING TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is a solicitor` NOTHING FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a person is a solicitor` (JUST FALSE) FALSE FALSE EQUALS NOTHING
#ASSERT `o 1 r 3(1) a person is a solicitor` NOTHING FALSE FALSE EQUALS NOTHING

-- "statement of claim" means a statement setting out the material facts which constitute the cause of action.
#ASSERT `o 1 r 3(1) a statement is a statement of claim` TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a statement is a statement of claim` FALSE EQUALS JUST FALSE

-- "statement of the special damages claimed": full particulars of the special damages for expenses and
-- losses already incurred AND an estimate of any future expenses and losses.
#ASSERT `o 1 r 3(1) a statement is a statement of the special damages claimed` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a statement is a statement of the special damages claimed` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a statement is a statement of the special damages claimed` FALSE TRUE EQUALS JUST FALSE

-- "summons": an application to Court in an action or appeal which has to be served.
-- "summons without notice": the same, which does not need to be served on anyone.
#ASSERT `o 1 r 3(1) an application is a summons` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) an application is a summons` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) an application is a summons` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) an application is a summons without notice` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) an application is a summons without notice` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) an application is a summons without notice` FALSE FALSE EQUALS JUST FALSE

-- "third party": brought into the action by the defendant because an indemnity or contribution is
-- sought.  "fourth party": brought in by the third party.  Further parties: corresponding meanings.
#ASSERT `o 1 r 3(1) a party is a third party` Defendant TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a party is a third party` Defendant FALSE EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a party is a third party` Claimant TRUE EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a party is a fourth party` `Third party` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a party is a fourth party` Defendant EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a party is a further party` `Fourth party` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a party is a further party` Defendant EQUALS NOTHING

-- "working day" means any day other than a non-court day.
#ASSERT `o 1 r 3(1) a day is a working day` (Date 9 11 2026) `test calendar` EQUALS JUST TRUE
#ASSERT `o 1 r 3(1) a day is a working day` (Date 7 11 2026) `test calendar` EQUALS JUST FALSE
#ASSERT `o 1 r 3(1) a day is a working day` (Date 12 11 2026) `test calendar` EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§ `Rule 3(2) -- the Forms`
-- ---------------------------------------------------------------------------

-- A reference to a numbered form is to the current version bearing the corresponding number in the practice directions.
#ASSERT `o 1 r 3(2) a reference to a numbered Form is to this form` "8" "8" TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 3(2) a reference to a numbered Form is to this form` "8" "9" TRUE EQUALS JUST FALSE
#ASSERT `o 1 r 3(2) a reference to a numbered Form is to this form` "8" "8" FALSE EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§ `Rule 1 -- the day the Rules come into operation`
-- ---------------------------------------------------------------------------

#ASSERT `o 1 r 1 the day these Rules come into operation` EQUALS Date 1 4 2022

-- ---------------------------------------------------------------------------
§ `Rule 2(2) and (6) -- the First Schedule`
-- ---------------------------------------------------------------------------

#ASSERT `o 1 r 2(2) a saving or transitional provision has effect` TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 2(2) a saving or transitional provision has effect` FALSE EQUALS NOTHING

-- (6): an appeal under these Rules from a decision made under the revoked Rules: the lower Court
-- proceedings that follow are not governed by these Rules.
#ASSERT `o 1 r 2(6) these Rules apply to the proceedings in the lower Court following the appeal` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 1 r 2(6) these Rules apply to the proceedings in the lower Court following the appeal` TRUE FALSE EQUALS NOTHING
#ASSERT `o 1 r 2(6) these Rules apply to the proceedings in the lower Court following the appeal` FALSE TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Rule 2(3) -- proceedings commenced on or after 1 April 2022`
-- ---------------------------------------------------------------------------

-- (3)(a): civil proceedings commenced on or after 1 April 2022.  The day itself is on or after.
#ASSERT `o 1 r 2(3)(a) these Rules apply to civil proceedings commenced on or after 1 April 2022` (`test action` `General Division` (Date 1 4 2022)) `o 1 r 2(3)(a) civil proceedings in the Supreme Court or the State Courts` EQUALS JUST TRUE
#ASSERT `o 1 r 2(3)(a) these Rules apply to civil proceedings commenced on or after 1 April 2022` (`test action` `District Court` (Date 15 6 2023)) `o 1 r 2(3)(a) civil proceedings in the Supreme Court or the State Courts` EQUALS JUST TRUE
-- The day before: the grant is limited by its own wording.
#ASSERT `o 1 r 2(3)(a) these Rules apply to civil proceedings commenced on or after 1 April 2022` (`test action` `General Division` (Date 31 3 2022)) `o 1 r 2(3)(a) civil proceedings in the Supreme Court or the State Courts` EQUALS NOTHING
-- Not civil proceedings: paragraph (3)(a) does not speak to them.
#ASSERT `o 1 r 2(3)(a) these Rules apply to civil proceedings commenced on or after 1 April 2022` (`test action` `General Division` (Date 15 6 2023)) `o 1 r 2(8) proceedings under the Criminal Procedure Code 2010` EQUALS NOTHING

-- (3)(b): an appeal or originating application to the Court of Appeal or Appellate Division filed on or
-- after 1 April 2022, relating to a decision of a lower Court made in proceedings to which the revoked Rules apply.
#ASSERT `o 1 r 2(3)(b) these Rules apply with modifications to an appeal or originating application to an appellate court` (`test action` `Appellate Division` (Date 1 4 2022)) TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 2(3)(b) these Rules apply with modifications to an appeal or originating application to an appellate court` (`test action` `Court of Appeal` (Date 2 5 2023)) TRUE EQUALS JUST TRUE
#ASSERT `o 1 r 2(3)(b) these Rules apply with modifications to an appeal or originating application to an appellate court` (`test action` `Appellate Division` (Date 31 3 2022)) TRUE EQUALS NOTHING
#ASSERT `o 1 r 2(3)(b) these Rules apply with modifications to an appeal or originating application to an appellate court` (`test action` `General Division` (Date 2 5 2023)) TRUE EQUALS NOTHING
#ASSERT `o 1 r 2(3)(b) these Rules apply with modifications to an appeal or originating application to an appellate court` (`test action` `Court of Appeal` (Date 2 5 2023)) FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Rule 2(4) -- decisions made before 1 April 2022`
-- ---------------------------------------------------------------------------

-- (4)(a): where the one month starts.
-- (i) order made in chambers: "the date when the order was pronounced or when the appellant first had notice".
--     The text does not say which of two different dates counts: NOTHING.  The same date: that date.
#ASSERT `o 1 r 2(4)(a) the date after which the one month for the notice of appeal runs` `o 1 r 2(4)(a)(i) an order made in chambers` (Date 10 3 2022) (Date 10 3 2022) (Date 1 1 2022) NOTHING (Date 1 1 2022) EQUALS JUST (Date 10 3 2022)
#ASSERT `o 1 r 2(4)(a) the date after which the one month for the notice of appeal runs` `o 1 r 2(4)(a)(i) an order made in chambers` (Date 10 3 2022) (Date 14 3 2022) (Date 1 1 2022) NOTHING (Date 1 1 2022) EQUALS NOTHING
-- (ii) refusal of an application: the date of the refusal.
#ASSERT `o 1 r 2(4)(a) the date after which the one month for the notice of appeal runs` `o 1 r 2(4)(a)(ii) the refusal of an application` (Date 10 3 2022) (Date 14 3 2022) (Date 5 3 2022) NOTHING (Date 1 1 2022) EQUALS JUST (Date 5 3 2022)
-- (iii) request for further arguments under section 29B(2): the date mentioned in section 29B(4)(b), outside the sources.
#ASSERT `o 1 r 2(4)(a) the date after which the one month for the notice of appeal runs` `o 1 r 2(4)(a)(iii) a case in which a request for further arguments was made under section 29B(2) of the Supreme Court of Judicature Act` (Date 10 3 2022) (Date 14 3 2022) (Date 5 3 2022) (JUST (Date 20 3 2022)) (Date 1 1 2022) EQUALS JUST (Date 20 3 2022)
#ASSERT `o 1 r 2(4)(a) the date after which the one month for the notice of appeal runs` `o 1 r 2(4)(a)(iii) a case in which a request for further arguments was made under section 29B(2) of the Supreme Court of Judicature Act` (Date 10 3 2022) (Date 14 3 2022) (Date 5 3 2022) NOTHING (Date 1 1 2022) EQUALS NOTHING
-- (iv) any other case: the date the judgment or order was pronounced.
#ASSERT `o 1 r 2(4)(a) the date after which the one month for the notice of appeal runs` `o 1 r 2(4)(a)(iv) any other case` (Date 10 3 2022) (Date 14 3 2022) (Date 5 3 2022) NOTHING (Date 25 2 2022) EQUALS JUST (Date 25 2 2022)

-- The period is one month, counted after the anchor.
#ASSERT `o 1 r 2(4)(a) one month`'s `period length` EQUALS 1
#ASSERT `o 1 r 2(4)(a) one month`'s `period unit` EQUALS Months
#ASSERT `o 1 r 2(4)(a) one month`'s `period direction` EQUALS `After the anchor`

-- Filed and served within the month: both dates on or before the last day (given as an input, 21 April 2022).
-- The text fixes the period in its own words ("within one month after"), so outside it the answer is JUST FALSE.
-- The day before the last day, the last day, the day after; then each date late on its own.
#ASSERT `o 1 r 2(4)(a) the notice of appeal is filed and served within one month` (Date 20 4 2022) (Date 20 4 2022) (Date 21 4 2022) EQUALS JUST TRUE
#ASSERT `o 1 r 2(4)(a) the notice of appeal is filed and served within one month` (Date 21 4 2022) (Date 21 4 2022) (Date 21 4 2022) EQUALS JUST TRUE
#ASSERT `o 1 r 2(4)(a) the notice of appeal is filed and served within one month` (Date 22 4 2022) (Date 22 4 2022) (Date 21 4 2022) EQUALS JUST FALSE
#ASSERT `o 1 r 2(4)(a) the notice of appeal is filed and served within one month` (Date 20 4 2022) (Date 21 4 2022) (Date 21 4 2022) EQUALS JUST TRUE
#ASSERT `o 1 r 2(4)(a) the notice of appeal is filed and served within one month` (Date 20 4 2022) (Date 22 4 2022) (Date 21 4 2022) EQUALS JUST FALSE
#ASSERT `o 1 r 2(4)(a) the notice of appeal is filed and served within one month` (Date 22 4 2022) (Date 20 4 2022) (Date 21 4 2022) EQUALS JUST FALSE

-- (4)(b): permission required.  Application for permission filed before 1 April 2022: one month after
-- permission is granted; filed on or after that date: 14 days after.
#ASSERT (`o 1 r 2(4)(b) the period after permission is granted` (Date 31 3 2022))'s `period length` EQUALS 1
#ASSERT (`o 1 r 2(4)(b) the period after permission is granted` (Date 31 3 2022))'s `period unit` EQUALS Months
#ASSERT (`o 1 r 2(4)(b) the period after permission is granted` (Date 1 4 2022))'s `period length` EQUALS 14
#ASSERT (`o 1 r 2(4)(b) the period after permission is granted` (Date 1 4 2022))'s `period unit` EQUALS Days
#ASSERT (`o 1 r 2(4)(b) the period after permission is granted` (Date 2 5 2022))'s `period length` EQUALS 14
#ASSERT (`o 1 r 2(4)(b) the period after permission is granted` (Date 2 5 2022))'s `period direction` EQUALS `After the anchor`
-- Last day 10 May 2022 (given as an input).  The text fixes the period in its own words ("within one month after ..."
-- or "within 14 days after ..."), so outside it the answer is JUST FALSE.
#ASSERT `o 1 r 2(4)(b) the notice of appeal is filed and served within the period after permission` (Date 9 5 2022) (Date 9 5 2022) (Date 10 5 2022) EQUALS JUST TRUE
#ASSERT `o 1 r 2(4)(b) the notice of appeal is filed and served within the period after permission` (Date 10 5 2022) (Date 10 5 2022) (Date 10 5 2022) EQUALS JUST TRUE
#ASSERT `o 1 r 2(4)(b) the notice of appeal is filed and served within the period after permission` (Date 11 5 2022) (Date 11 5 2022) (Date 10 5 2022) EQUALS JUST FALSE
#ASSERT `o 1 r 2(4)(b) the notice of appeal is filed and served within the period after permission` (Date 10 5 2022) (Date 11 5 2022) (Date 10 5 2022) EQUALS JUST FALSE
#ASSERT `o 1 r 2(4)(b) the notice of appeal is filed and served within the period after permission` (Date 11 5 2022) (Date 10 5 2022) (Date 10 5 2022) EQUALS JUST FALSE

-- (4)(c): permission to appeal, 7 working days.  Where the time starts:
-- (i) s 29B does not apply: the date of the decision of the lower Court.
#ASSERT `o 1 r 2(4)(c) the date after which the 7 working days for the permission application run` `o 1 r 2(4)(c)(i) section 29B does not apply` (Date 1 3 2022) (Date 8 3 2022) (Date 9 3 2022) NOTHING EQUALS Date 1 3 2022
-- (ii)(A) further arguments heard, decision affirmed, varied or set aside: that date.
#ASSERT `o 1 r 2(4)(c) the date after which the 7 working days for the permission application run` `o 1 r 2(4)(c)(ii)(A) the Judge heard further arguments and affirmed, varied or set aside the decision` (Date 1 3 2022) (Date 8 3 2022) (Date 9 3 2022) NOTHING EQUALS Date 8 3 2022
-- (ii)(B) certified, or deemed to have certified, that no further arguments are required: that date.
#ASSERT `o 1 r 2(4)(c) the date after which the 7 working days for the permission application run` `o 1 r 2(4)(c)(ii)(B) a request for further arguments was made and the Judge certified, or is deemed to have certified, that none are required` (Date 1 3 2022) (Date 8 3 2022) (Date 9 3 2022) NOTHING EQUALS Date 9 3 2022
-- (ii)(C) any other case: the earlier of the extraction time and the 15th day after the decision.
-- Decision on 1 March 2022: the 15th day after is 16 March 2022.
#ASSERT `o 1 r 2(4)(c) the date after which the 7 working days for the permission application run` `o 1 r 2(4)(c)(ii)(C) section 29B applies in any other case` (Date 1 3 2022) (Date 8 3 2022) (Date 9 3 2022) (JUST (Date 10 3 2022)) EQUALS Date 10 3 2022
#ASSERT `o 1 r 2(4)(c) the date after which the 7 working days for the permission application run` `o 1 r 2(4)(c)(ii)(C) section 29B applies in any other case` (Date 1 3 2022) (Date 8 3 2022) (Date 9 3 2022) (JUST (Date 20 3 2022)) EQUALS Date 16 3 2022
#ASSERT `o 1 r 2(4)(c) the date after which the 7 working days for the permission application run` `o 1 r 2(4)(c)(ii)(C) section 29B applies in any other case` (Date 1 3 2022) (Date 8 3 2022) (Date 9 3 2022) NOTHING EQUALS Date 16 3 2022
-- The period is 7 working days after the anchor.
#ASSERT `o 1 r 2(4)(c) seven working days`'s `period length` EQUALS 7
#ASSERT `o 1 r 2(4)(c) seven working days`'s `period unit` EQUALS `Working days`
-- Filed and served in time with the documents of Order 18, Rule 29(7) / Order 19, Rule 26(7) (another part's range).
-- Last day 15 March 2022 (given as an input).  The period is fixed in the text's own words ("within 7 working days
-- after"), so outside it the answer is JUST FALSE, whatever the documents answer says.  Inside the period, the
-- documents limb ("together with the documents mentioned in ...") decides, and a missing documents answer is NOTHING.
#ASSERT `o 1 r 2(4)(c) the application for permission to appeal is filed and served in time with its documents` (Date 14 3 2022) (Date 14 3 2022) (Date 15 3 2022) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `o 1 r 2(4)(c) the application for permission to appeal is filed and served in time with its documents` (Date 15 3 2022) (Date 15 3 2022) (Date 15 3 2022) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `o 1 r 2(4)(c) the application for permission to appeal is filed and served in time with its documents` (Date 16 3 2022) (Date 16 3 2022) (Date 15 3 2022) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `o 1 r 2(4)(c) the application for permission to appeal is filed and served in time with its documents` (Date 15 3 2022) (Date 16 3 2022) (Date 15 3 2022) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `o 1 r 2(4)(c) the application for permission to appeal is filed and served in time with its documents` (Date 16 3 2022) (Date 15 3 2022) (Date 15 3 2022) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `o 1 r 2(4)(c) the application for permission to appeal is filed and served in time with its documents` (Date 16 3 2022) (Date 16 3 2022) (Date 15 3 2022) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `o 1 r 2(4)(c) the application for permission to appeal is filed and served in time with its documents` (Date 16 3 2022) (Date 16 3 2022) (Date 15 3 2022) NOTHING EQUALS JUST FALSE
-- In time but the documents are not filed and served with it: the text does not say no in so many words (NOTHING).
#ASSERT `o 1 r 2(4)(c) the application for permission to appeal is filed and served in time with its documents` (Date 15 3 2022) (Date 15 3 2022) (Date 15 3 2022) (JUST FALSE) EQUALS NOTHING
#ASSERT `o 1 r 2(4)(c) the application for permission to appeal is filed and served in time with its documents` (Date 15 3 2022) (Date 15 3 2022) (Date 15 3 2022) NOTHING EQUALS NOTHING

