IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc10-order-54`

-- Rules of Court 2021 (Singapore), Order 54 (Oaths and Declarations Act): TESTS.
-- Every expected value is written beside its assertion from the text of the rule it cites (lines 6688 to 6701 of the text),
-- never copied from the output of the code.

-- Rule 1
#ASSERT `o 54 r 1(1) an instrument is the Act` TRUE EQUALS JUST TRUE -- "(called in this Order the Act)"
#ASSERT `o 54 r 1(1) an instrument is the Act` FALSE EQUALS JUST FALSE -- another instrument
#ASSERT `o 54 r 1(1) this Order applies` TRUE EQUALS JUST TRUE -- "applies in every instance when an oath or affirmation is taken or made, and administered"
#ASSERT `o 54 r 1(1) this Order applies` FALSE EQUALS NOTHING -- some other occasion: the text does not say
#ASSERT `o 54 r 1(1) Order 1, Rule 2 prevents this Order from applying` TRUE EQUALS JUST FALSE -- "despite anything in Order 1, Rule 2"
#ASSERT `o 54 r 1(1) Order 1, Rule 2 prevents this Order from applying` FALSE EQUALS NOTHING -- some other occasion
#ASSERT `o 54 r 1(2) the person is an officer` `o 54 r 1(2) Rule 2, which is about oaths` TRUE FALSE TRUE EQUALS JUST TRUE -- in Rule 2: authorised to administer oaths
#ASSERT `o 54 r 1(2) the person is an officer` `o 54 r 1(2) Rule 2, which is about oaths` FALSE TRUE TRUE EQUALS JUST FALSE -- in Rule 2: authorised only for affirmations
#ASSERT `o 54 r 1(2) the person is an officer` `o 54 r 1(2) Rule 3, which is about affirmations` FALSE TRUE FALSE EQUALS JUST TRUE -- in Rule 3: authorised to administer affirmations
#ASSERT `o 54 r 1(2) the person is an officer` `o 54 r 1(2) Rule 3, which is about affirmations` TRUE FALSE FALSE EQUALS JUST FALSE -- in Rule 3: authorised only for oaths
#ASSERT `o 54 r 1(2) the person is an officer` `o 54 r 1(2) Rule 4, which is about both` TRUE FALSE TRUE EQUALS JUST TRUE -- in Rule 4, an oath: authorised for oaths
#ASSERT `o 54 r 1(2) the person is an officer` `o 54 r 1(2) Rule 4, which is about both` FALSE TRUE TRUE EQUALS JUST FALSE -- in Rule 4, an oath: authorised only for affirmations
#ASSERT `o 54 r 1(2) the person is an officer` `o 54 r 1(2) Rule 4, which is about both` FALSE TRUE FALSE EQUALS JUST TRUE -- in Rule 4, an affirmation: authorised for affirmations
#ASSERT `o 54 r 1(2) the person is an officer` `o 54 r 1(2) Rule 4, which is about both` TRUE FALSE FALSE EQUALS JUST FALSE -- in Rule 4, an affirmation: authorised only for oaths
#ASSERT `o 54 r 1(2) the person is an officer` `o 54 r 1(2) somewhere else` TRUE TRUE TRUE EQUALS NOTHING -- "In Rules 2, 3 and 4" only

-- Rule 2
#ASSERT `o 54 r 2(1) the oath must be taken and administered in the form and manner prescribed in Rule 2` TRUE FALSE EQUALS JUST TRUE -- an oath under the Act
#ASSERT `o 54 r 2(1) the oath must be taken and administered in the form and manner prescribed in Rule 2` TRUE TRUE EQUALS JUST FALSE -- "Subject to Rule 4"
#ASSERT `o 54 r 2(1) the oath must be taken and administered in the form and manner prescribed in Rule 2` FALSE FALSE EQUALS NOTHING -- not an oath under the Act
#ASSERT `o 54 r 2(1) the oath was taken and administered in the form and manner prescribed` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- taken and administered as prescribed
#ASSERT `o 54 r 2(1) the oath was taken and administered in the form and manner prescribed` TRUE FALSE TRUE FALSE EQUALS NOTHING -- not administered as prescribed: a bare "must"
#ASSERT `o 54 r 2(1) the oath was taken and administered in the form and manner prescribed` TRUE FALSE FALSE TRUE EQUALS NOTHING -- not taken as prescribed
#ASSERT `o 54 r 2(1) the oath was taken and administered in the form and manner prescribed` TRUE TRUE TRUE TRUE EQUALS NOTHING -- Rule 4 applies: the duty does not arise
#ASSERT `o 54 r 2(1) the oath was taken and administered in the form and manner prescribed` FALSE FALSE TRUE TRUE EQUALS NOTHING -- not an oath under the Act
#ASSERT `o 54 r 2(2) the person taking the oath may place the left hand on the Bible or hold it in the manner the person desires` FALSE FALSE FALSE EQUALS JUST TRUE -- no objection, not repugnant, no third person
#ASSERT `o 54 r 2(2) the person taking the oath may place the left hand on the Bible or hold it in the manner the person desires` TRUE FALSE FALSE EQUALS JUST FALSE -- "unless before taking the oath he or she objects"
#ASSERT `o 54 r 2(2) the person taking the oath may place the left hand on the Bible or hold it in the manner the person desires` FALSE TRUE FALSE EQUALS NOTHING -- repugnant to justice or decency: outside the permission
#ASSERT `o 54 r 2(2) the person taking the oath may place the left hand on the Bible or hold it in the manner the person desires` FALSE FALSE TRUE EQUALS NOTHING -- purporting to affect a third person: outside the permission
#ASSERT `o 54 r 2(2) the person taking the oath may place the left hand on the Bible or hold it in the manner the person desires` TRUE TRUE FALSE EQUALS JUST FALSE -- an objection ends the permission whatever the manner
#ASSERT `o 54 r 2(2) the person taking the oath has raised the right hand and said the words as the person must` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- raised the right hand and said the words
#ASSERT `o 54 r 2(2) the person taking the oath has raised the right hand and said the words as the person must` TRUE FALSE FALSE TRUE EQUALS NOTHING -- did not raise the right hand: a bare "must"
#ASSERT `o 54 r 2(2) the person taking the oath has raised the right hand and said the words as the person must` TRUE FALSE TRUE FALSE EQUALS NOTHING -- did not say the words
#ASSERT `o 54 r 2(2) the person taking the oath has raised the right hand and said the words as the person must` TRUE TRUE TRUE TRUE EQUALS NOTHING -- Rule 4 applies: the duty does not arise
#ASSERT `o 54 r 2(2) the person taking the oath has raised the right hand and said the words as the person must` FALSE FALSE TRUE TRUE EQUALS NOTHING -- not an oath under the Act
#ASSERT `o 54 r 2(3) the officer must administer the oath in the form and manner set out in paragraph (2)` TRUE FALSE FALSE EQUALS JUST TRUE -- no exception
#ASSERT `o 54 r 2(3) the officer must administer the oath in the form and manner set out in paragraph (2)` TRUE TRUE FALSE EQUALS JUST FALSE -- "permitted under the Act to do otherwise"
#ASSERT `o 54 r 2(3) the officer must administer the oath in the form and manner set out in paragraph (2)` TRUE FALSE TRUE EQUALS JUST FALSE -- "physically incapable"
#ASSERT `o 54 r 2(3) the officer must administer the oath in the form and manner set out in paragraph (2)` FALSE FALSE FALSE EQUALS NOTHING -- not an oath under the Act
#ASSERT `o 54 r 2(3) the officer has administered the oath as the officer must` TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- administered as set out
#ASSERT `o 54 r 2(3) the officer has administered the oath as the officer must` TRUE FALSE FALSE FALSE EQUALS NOTHING -- not administered as set out: a bare "must"
#ASSERT `o 54 r 2(3) the officer has administered the oath as the officer must` TRUE TRUE FALSE TRUE EQUALS NOTHING -- the person is permitted to do otherwise: the duty does not arise
#ASSERT `o 54 r 2(3) the officer has administered the oath as the officer must` TRUE FALSE TRUE FALSE EQUALS NOTHING -- the person is physically incapable: the duty does not arise
#ASSERT `o 54 r 2(3) the officer has administered the oath as the officer must` FALSE FALSE FALSE TRUE EQUALS NOTHING -- not an oath under the Act

-- Rule 3
#ASSERT `o 54 r 3(1) the affirmation must be made and administered in the form and manner prescribed in Rule 3` TRUE FALSE EQUALS JUST TRUE -- an affirmation under the Act
#ASSERT `o 54 r 3(1) the affirmation must be made and administered in the form and manner prescribed in Rule 3` TRUE TRUE EQUALS JUST FALSE -- "Subject to Rule 4"
#ASSERT `o 54 r 3(1) the affirmation must be made and administered in the form and manner prescribed in Rule 3` FALSE FALSE EQUALS NOTHING -- not an affirmation under the Act
#ASSERT `o 54 r 3(1) the affirmation was made and administered in the form and manner prescribed` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- made and administered as prescribed
#ASSERT `o 54 r 3(1) the affirmation was made and administered in the form and manner prescribed` TRUE FALSE TRUE FALSE EQUALS NOTHING -- not administered as prescribed: a bare "must"
#ASSERT `o 54 r 3(1) the affirmation was made and administered in the form and manner prescribed` TRUE FALSE FALSE TRUE EQUALS NOTHING -- not made as prescribed
#ASSERT `o 54 r 3(1) the affirmation was made and administered in the form and manner prescribed` TRUE TRUE TRUE TRUE EQUALS NOTHING -- Rule 4 applies: the duty does not arise
#ASSERT `o 54 r 3(1) the affirmation was made and administered in the form and manner prescribed` FALSE FALSE TRUE TRUE EQUALS NOTHING -- not an affirmation under the Act
#ASSERT `o 54 r 3(2) the person making the affirmation has raised the right hand and said the words as the person must` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- raised the right hand and said the words
#ASSERT `o 54 r 3(2) the person making the affirmation has raised the right hand and said the words as the person must` TRUE FALSE FALSE TRUE EQUALS NOTHING -- did not raise the right hand: a bare "must"
#ASSERT `o 54 r 3(2) the person making the affirmation has raised the right hand and said the words as the person must` TRUE FALSE TRUE FALSE EQUALS NOTHING -- did not say the words
#ASSERT `o 54 r 3(2) the person making the affirmation has raised the right hand and said the words as the person must` TRUE TRUE TRUE TRUE EQUALS NOTHING -- Rule 4 applies: the duty does not arise
#ASSERT `o 54 r 3(2) the person making the affirmation has raised the right hand and said the words as the person must` FALSE FALSE TRUE TRUE EQUALS NOTHING -- not an affirmation under the Act
#ASSERT `o 54 r 3(3) the officer must administer the affirmation in the form and manner set out in paragraph (2)` TRUE FALSE FALSE EQUALS JUST TRUE -- no exception
#ASSERT `o 54 r 3(3) the officer must administer the affirmation in the form and manner set out in paragraph (2)` TRUE TRUE FALSE EQUALS JUST FALSE -- "permitted under the Act to do otherwise"
#ASSERT `o 54 r 3(3) the officer must administer the affirmation in the form and manner set out in paragraph (2)` TRUE FALSE TRUE EQUALS JUST FALSE -- "physically incapable"
#ASSERT `o 54 r 3(3) the officer must administer the affirmation in the form and manner set out in paragraph (2)` FALSE FALSE FALSE EQUALS NOTHING -- not an affirmation under the Act
#ASSERT `o 54 r 3(3) the officer has administered the affirmation as the officer must` TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- administered as set out
#ASSERT `o 54 r 3(3) the officer has administered the affirmation as the officer must` TRUE FALSE FALSE FALSE EQUALS NOTHING -- not administered as set out: a bare "must"
#ASSERT `o 54 r 3(3) the officer has administered the affirmation as the officer must` TRUE TRUE FALSE TRUE EQUALS NOTHING -- the person is permitted to do otherwise: the duty does not arise
#ASSERT `o 54 r 3(3) the officer has administered the affirmation as the officer must` TRUE FALSE TRUE FALSE EQUALS NOTHING -- the person is physically incapable: the duty does not arise
#ASSERT `o 54 r 3(3) the officer has administered the affirmation as the officer must` FALSE FALSE FALSE TRUE EQUALS NOTHING -- not an affirmation under the Act

-- Rules 4 and 5
#ASSERT `o 54 r 4 the officer may administer the oath or affirmation in such form and manner` TRUE TRUE EQUALS JUST TRUE -- physically incapable, form appropriate or expedient
#ASSERT `o 54 r 4 the officer may administer the oath or affirmation in such form and manner` TRUE FALSE EQUALS NOTHING -- physically incapable, form neither appropriate nor expedient: outside the permission
#ASSERT `o 54 r 4 the officer may administer the oath or affirmation in such form and manner` FALSE TRUE EQUALS JUST FALSE -- not physically incapable: the "in the case of" fails
#ASSERT `o 54 r 4 the officer may administer the oath or affirmation in such form and manner` FALSE FALSE EQUALS JUST FALSE -- not physically incapable
#ASSERT `o 54 r 5 the attestation or the marking states what it must` TRUE TRUE EQUALS JUST TRUE -- states whether an oath or an affirmation
#ASSERT `o 54 r 5 the attestation or the marking states what it must` TRUE FALSE EQUALS NOTHING -- does not state it: a bare "must"
#ASSERT `o 54 r 5 the attestation or the marking states what it must` FALSE TRUE EQUALS NOTHING -- not the form of attestation or the marking of an exhibit
