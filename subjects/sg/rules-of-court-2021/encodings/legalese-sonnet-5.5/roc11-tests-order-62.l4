IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc11-order-62`

-- TESTS for Order 62 (Securities and Futures Act, civil penalty actions).  Every expected value is written from the
-- text of the rule, beside the assertion, before the code was run.  The "last day" inputs are made-up dates: the
-- merged file replaces them with calls to roc1's O 3 r 3 and O 6.

-- ---------------------------------------------------------------------------
§ `Order 62 rule 1 -- definitions and application`
-- ---------------------------------------------------------------------------
#ASSERT `o 62 r 1(1) the Act` EQUALS "the Securities and Futures Act"
#ASSERT `o 62 r 1(1) a reference to a section is a reference to a section in the Act` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 62 r 1(1) a reference to a section is a reference to a section in the Act` TRUE TRUE EQUALS NOTHING
#ASSERT `o 62 r 1(1) a reference to a section is a reference to a section in the Act` FALSE FALSE EQUALS NOTHING
#ASSERT `o 62 r 1(1) "Authority" who it is` EQUALS "the Monetary Authority of Singapore established by section 3 of the Monetary Authority of Singapore Act"
-- "civil penalty action" means any proceeding commenced by the Authority under one of seven sections.
#ASSERT `o 62 r 1(1) "civil penalty action" the proceeding is a civil penalty action` TRUE `o 62 r 1 a proceeding under section 137ZD` EQUALS JUST TRUE
#ASSERT `o 62 r 1(1) "civil penalty action" the proceeding is a civil penalty action` TRUE `o 62 r 1 a proceeding under section 232` EQUALS JUST TRUE
#ASSERT `o 62 r 1(1) "civil penalty action" the proceeding is a civil penalty action` TRUE `o 62 r 1 a proceeding under section 236B(3)` EQUALS JUST TRUE
#ASSERT `o 62 r 1(1) "civil penalty action" the proceeding is a civil penalty action` TRUE `o 62 r 1 a proceeding under section 236C` EQUALS JUST TRUE
#ASSERT `o 62 r 1(1) "civil penalty action" the proceeding is a civil penalty action` TRUE `o 62 r 1 a proceeding under section 236E(3)` EQUALS JUST TRUE
#ASSERT `o 62 r 1(1) "civil penalty action" the proceeding is a civil penalty action` TRUE `o 62 r 1 a proceeding under section 236F` EQUALS JUST TRUE
#ASSERT `o 62 r 1(1) "civil penalty action" the proceeding is a civil penalty action` TRUE `o 62 r 1 a proceeding under section 236H` EQUALS JUST TRUE
-- Not commenced by the Authority, or under another section: a "means" definition says no.
#ASSERT `o 62 r 1(1) "civil penalty action" the proceeding is a civil penalty action` FALSE `o 62 r 1 a proceeding under section 236C` EQUALS JUST FALSE
#ASSERT `o 62 r 1(1) "civil penalty action" the proceeding is a civil penalty action` TRUE `o 62 r 1 a proceeding under another section` EQUALS JUST FALSE
#ASSERT `o 62 r 1(1) "Code" which Code` EQUALS "the Criminal Procedure Code"
#ASSERT `o 62 r 1(1) "Commercial Affairs Officer" the person is a Commercial Affairs Officer` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 1(1) "Commercial Affairs Officer" the person is a Commercial Affairs Officer` FALSE EQUALS JUST FALSE
-- "contravening person": limbs (a) to (e); sections 137ZD and 232 are in no limb.
#ASSERT `o 62 r 1(1) "contravening person" the section that gives its meaning` `o 62 r 1 a proceeding under section 236B(3)` EQUALS JUST "section 236B(1)"
#ASSERT `o 62 r 1(1) "contravening person" the section that gives its meaning` `o 62 r 1 a proceeding under section 236C` EQUALS JUST "section 236C(1)"
#ASSERT `o 62 r 1(1) "contravening person" the section that gives its meaning` `o 62 r 1 a proceeding under section 236E(3)` EQUALS JUST "section 236E(1)"
#ASSERT `o 62 r 1(1) "contravening person" the section that gives its meaning` `o 62 r 1 a proceeding under section 236F` EQUALS JUST "section 236F(1)"
#ASSERT `o 62 r 1(1) "contravening person" the section that gives its meaning` `o 62 r 1 a proceeding under section 236H` EQUALS JUST "section 236H(1)"
#ASSERT `o 62 r 1(1) "contravening person" the section that gives its meaning` `o 62 r 1 a proceeding under section 137ZD` EQUALS NOTHING
#ASSERT `o 62 r 1(1) "contravening person" the section that gives its meaning` `o 62 r 1 a proceeding under section 232` EQUALS NOTHING
#ASSERT `o 62 r 1(1) "contravening person" the section that gives its meaning` `o 62 r 1 a proceeding under another section` EQUALS NOTHING
#ASSERT `o 62 r 1(1) "police officer" the person is a police officer` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 1(1) "police officer" the person is a police officer` FALSE EQUALS JUST FALSE
#ASSERT `o 62 r 1(2) these Rules apply to the proceeding` `o 62 r 1 a proceeding under section 236H` EQUALS JUST TRUE
#ASSERT `o 62 r 1(2) these Rules apply to the proceeding` `o 62 r 1 a proceeding under section 137ZD` EQUALS JUST TRUE
#ASSERT `o 62 r 1(2) these Rules apply to the proceeding` `o 62 r 1 a proceeding under another section` EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 62 rule 2 -- commencement`
-- ---------------------------------------------------------------------------
#ASSERT `o 62 r 2(1) the civil penalty action is commenced as the Rule requires` TRUE `Originating claim` EQUALS JUST TRUE
#ASSERT `o 62 r 2(1) the civil penalty action is commenced as the Rule requires` TRUE `Originating application` EQUALS NOTHING
#ASSERT `o 62 r 2(1) the civil penalty action is commenced as the Rule requires` FALSE `Originating claim` EQUALS NOTHING
-- (2): provision, then "unless modified by this Rule".  Arguments: civil penalty action; provision; this Rule modifies it.
#ASSERT `o 62 r 2(2) the provision applies to the civil penalty action` TRUE "Order 6 rule 2" FALSE EQUALS JUST TRUE
#ASSERT `o 62 r 2(2) the provision applies to the civil penalty action` TRUE "Order 6 rule 3" FALSE EQUALS JUST TRUE
#ASSERT `o 62 r 2(2) the provision applies to the civil penalty action` TRUE "Order 6 rule 5" FALSE EQUALS JUST TRUE
-- Case: modified by rule 2(3).
#ASSERT `o 62 r 2(2) the provision applies to the civil penalty action` TRUE "Order 6 rule 5" TRUE EQUALS JUST FALSE
-- Case: "other than Rule 5(3) and (4)": the Rule is silent (QE).
#ASSERT `o 62 r 2(2) the provision applies to the civil penalty action` TRUE "Order 6 rule 5(3)" FALSE EQUALS NOTHING
#ASSERT `o 62 r 2(2) the provision applies to the civil penalty action` TRUE "Order 6 rule 5(4)" FALSE EQUALS NOTHING
#ASSERT `o 62 r 2(2) the provision applies to the civil penalty action` TRUE "Order 6 rule 4" FALSE EQUALS NOTHING
#ASSERT `o 62 r 2(2) the provision applies to the civil penalty action` FALSE "Order 6 rule 2" FALSE EQUALS NOTHING
-- (3): fields a; b address; b sues by solicitor; b solicitor details; c representative; c capacity; d days; e statement of claim; e concise statement.
#ASSERT count (`o 62 r 2(3) the matters the endorsement has not yet stated` (`o 62 r 2(3) endorsement` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE)) EQUALS 0
-- The Authority sues in person and no one is sued in a representative capacity: the solicitor and capacity items are not asked.
#ASSERT count (`o 62 r 2(3) the matters the endorsement has not yet stated` (`o 62 r 2(3) endorsement` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE)) EQUALS 0
-- The statement of claim is not endorsed, so a concise statement is needed; it is missing.
#ASSERT count (`o 62 r 2(3) the matters the endorsement has not yet stated` (`o 62 r 2(3) endorsement` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE)) EQUALS 1
-- Sues by a solicitor but gives no solicitor details; sued in a representative capacity but no capacity stated.
#ASSERT count (`o 62 r 2(3) the matters the endorsement has not yet stated` (`o 62 r 2(3) endorsement` OF TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, TRUE, TRUE, FALSE)) EQUALS 2
#ASSERT elem "(c) the capacity in which the defendant is sued" (`o 62 r 2(3) the matters the endorsement has not yet stated` (`o 62 r 2(3) endorsement` OF TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, TRUE, TRUE, FALSE))
#ASSERT count (`o 62 r 2(3) the matters the endorsement has not yet stated` (`o 62 r 2(3) endorsement` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 4
#ASSERT `o 62 r 2(3) the endorsement states what the Rule requires` TRUE (`o 62 r 2(3) endorsement` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `o 62 r 2(3) the endorsement states what the Rule requires` TRUE (`o 62 r 2(3) endorsement` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE) EQUALS NOTHING
#ASSERT `o 62 r 2(3) the endorsement states what the Rule requires` FALSE (`o 62 r 2(3) endorsement` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING
#ASSERT `o 62 r 2(4) the address for service of the Authority` `o 62 r 2(4)(a) the Authority sues by a solicitor` EQUALS JUST "the business address of the solicitor endorsed on the originating claim"
#ASSERT `o 62 r 2(4) the address for service of the Authority` `o 62 r 2(4)(b) the Authority sues in person` EQUALS JUST "the address within the jurisdiction endorsed on the originating claim"
#ASSERT `o 62 r 2(4) the address for service of the Authority` `o 62 r 2(4) the Authority sues in another way` EQUALS NOTHING
-- (5): the provision that refers to the Public Prosecutor's consent, by proceeding.
#ASSERT `o 62 r 2(5) the provision that refers to the consent of the Public Prosecutor` `o 62 r 1 a proceeding under section 137ZD` EQUALS JUST "section 137ZD(1)"
#ASSERT `o 62 r 2(5) the provision that refers to the consent of the Public Prosecutor` `o 62 r 1 a proceeding under section 232` EQUALS JUST "section 232(1)"
#ASSERT `o 62 r 2(5) the provision that refers to the consent of the Public Prosecutor` `o 62 r 1 a proceeding under section 236B(3)` EQUALS JUST "section 236B(3)"
#ASSERT `o 62 r 2(5) the provision that refers to the consent of the Public Prosecutor` `o 62 r 1 a proceeding under section 236C` EQUALS JUST "section 236C(2)"
#ASSERT `o 62 r 2(5) the provision that refers to the consent of the Public Prosecutor` `o 62 r 1 a proceeding under section 236E(3)` EQUALS JUST "section 236E(3)"
#ASSERT `o 62 r 2(5) the provision that refers to the consent of the Public Prosecutor` `o 62 r 1 a proceeding under section 236F` EQUALS JUST "section 236F(2)"
#ASSERT `o 62 r 2(5) the provision that refers to the consent of the Public Prosecutor` `o 62 r 1 a proceeding under section 236H` EQUALS JUST "section 236H(1)"
#ASSERT `o 62 r 2(5) the provision that refers to the consent of the Public Prosecutor` `o 62 r 1 a proceeding under another section` EQUALS NOTHING
#ASSERT `o 62 r 2(5) the duty to file the consent of the Public Prosecutor arises` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 2(5) the duty to file the consent of the Public Prosecutor arises` FALSE EQUALS JUST FALSE
#ASSERT `o 62 r 2(5) the Authority files the consent as the Rule requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 2(5) the Authority files the consent as the Rule requires` TRUE FALSE EQUALS NOTHING
-- The duty did not arise (the claim was not presented for sealing).
#ASSERT `o 62 r 2(5) the Authority files the consent as the Rule requires` FALSE FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 62 rule 3 -- provisions applicable to pleadings`
-- ---------------------------------------------------------------------------
#ASSERT `o 62 r 3(1) the provision applies to the pleadings in the civil penalty action` TRUE "Order 6 rule 5(5)" EQUALS JUST TRUE
#ASSERT `o 62 r 3(1) the provision applies to the pleadings in the civil penalty action` TRUE "Order 6 rule 7(6)" EQUALS JUST TRUE
#ASSERT `o 62 r 3(1) the provision applies to the pleadings in the civil penalty action` TRUE "Order 6 rule 10" EQUALS JUST TRUE
#ASSERT `o 62 r 3(1) the provision applies to the pleadings in the civil penalty action` TRUE "Order 9 rule 9" EQUALS JUST TRUE
#ASSERT `o 62 r 3(1) the provision applies to the pleadings in the civil penalty action` TRUE "Order 9 rule 16" EQUALS JUST TRUE
-- Order 9 rules 10 to 12 are not in the list.
#ASSERT `o 62 r 3(1) the provision applies to the pleadings in the civil penalty action` TRUE "Order 9 rule 10" EQUALS NOTHING
#ASSERT `o 62 r 3(1) the provision applies to the pleadings in the civil penalty action` TRUE "Order 6 rule 7(7)" EQUALS NOTHING
#ASSERT `o 62 r 3(1) the provision applies to the pleadings in the civil penalty action` FALSE "Order 6 rule 10" EQUALS NOTHING
#ASSERT `o 62 r 3(2) the defence applies to the civil penalty action` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 62 r 3(2) the defence applies to the civil penalty action` TRUE FALSE EQUALS NOTHING
#ASSERT `o 62 r 3(2) the defence applies to the civil penalty action` FALSE TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 62 rule 4 -- default of notice of intention to contest or not contest`
-- ---------------------------------------------------------------------------
-- The last day for filing and serving the notice is 20 November 2026 (made up).
-- (1).  Arguments: only a penalty order applied for; the defendant fails; date the Authority applies; last day; affidavit of service filed; statement of claim endorsed or served with the claim; statement of claim served after.
#ASSERT `o 62 r 4(1) the Authority may apply to the Court for judgment` TRUE TRUE (Date 21 11 2026) (Date 20 11 2026) TRUE TRUE FALSE EQUALS JUST TRUE
-- The day of the last day itself is not "after the time limited".
#ASSERT `o 62 r 4(1) the Authority may apply to the Court for judgment` TRUE TRUE (Date 20 11 2026) (Date 20 11 2026) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 62 r 4(1) the Authority may apply to the Court for judgment` TRUE TRUE (Date 19 11 2026) (Date 20 11 2026) TRUE TRUE FALSE EQUALS JUST FALSE
-- No affidavit proving due service.
#ASSERT `o 62 r 4(1) the Authority may apply to the Court for judgment` TRUE TRUE (Date 21 11 2026) (Date 20 11 2026) FALSE TRUE FALSE EQUALS JUST FALSE
-- Statement of claim not endorsed or served with the claim, and not served after.
#ASSERT `o 62 r 4(1) the Authority may apply to the Court for judgment` TRUE TRUE (Date 21 11 2026) (Date 20 11 2026) TRUE FALSE FALSE EQUALS JUST FALSE
-- Statement of claim not endorsed, but served after.
#ASSERT `o 62 r 4(1) the Authority may apply to the Court for judgment` TRUE TRUE (Date 21 11 2026) (Date 20 11 2026) TRUE FALSE TRUE EQUALS JUST TRUE
-- The Authority applied for another order too: paragraph (1) does not reach it.
#ASSERT `o 62 r 4(1) the Authority may apply to the Court for judgment` FALSE TRUE (Date 21 11 2026) (Date 20 11 2026) TRUE TRUE FALSE EQUALS JUST FALSE
-- The defendant filed a notice.
#ASSERT `o 62 r 4(1) the Authority may apply to the Court for judgment` TRUE FALSE (Date 21 11 2026) (Date 20 11 2026) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 62 r 4(1) the Court must give such judgment as the Authority appears entitled to` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 4(1) the Court must give such judgment as the Authority appears entitled to` FALSE EQUALS JUST FALSE
#ASSERT `o 62 r 4(2) the application is made as the Rule requires` TRUE Summons EQUALS JUST TRUE
#ASSERT `o 62 r 4(2) the application is made as the Rule requires` TRUE `Originating application` EQUALS NOTHING
#ASSERT `o 62 r 4(2) the application is made as the Rule requires` FALSE Summons EQUALS NOTHING
-- (3).  Arguments: applied for another order; the defendant fails; date; last day; affidavit; endorsed or served with the claim; served after.
#ASSERT `o 62 r 4(3) the Authority may proceed as if the defendant had filed and served a notice of intention to contest or not contest` TRUE TRUE (Date 21 11 2026) (Date 20 11 2026) TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 62 r 4(3) the Authority may proceed as if the defendant had filed and served a notice of intention to contest or not contest` TRUE TRUE (Date 20 11 2026) (Date 20 11 2026) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 62 r 4(3) the Authority may proceed as if the defendant had filed and served a notice of intention to contest or not contest` TRUE TRUE (Date 21 11 2026) (Date 20 11 2026) FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 62 r 4(3) the Authority may proceed as if the defendant had filed and served a notice of intention to contest or not contest` TRUE TRUE (Date 21 11 2026) (Date 20 11 2026) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 62 r 4(3) the Authority may proceed as if the defendant had filed and served a notice of intention to contest or not contest` TRUE TRUE (Date 21 11 2026) (Date 20 11 2026) TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 4(3) the Authority may proceed as if the defendant had filed and served a notice of intention to contest or not contest` FALSE TRUE (Date 21 11 2026) (Date 20 11 2026) TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 62 r 4(3) the Authority may proceed as if the defendant had filed and served a notice of intention to contest or not contest` TRUE FALSE (Date 21 11 2026) (Date 20 11 2026) TRUE TRUE FALSE EQUALS JUST FALSE
-- (4).  Arguments: unnecessary to proceed; the defendant fails; date; last day; the Court has given permission.
#ASSERT `o 62 r 4(4) the Authority may enter judgment against the defendant for costs` TRUE TRUE (Date 21 11 2026) (Date 20 11 2026) TRUE EQUALS JUST TRUE
-- No permission yet: the grant is conditional on it (a fork); the text does not answer.
#ASSERT `o 62 r 4(4) the Authority may enter judgment against the defendant for costs` TRUE TRUE (Date 21 11 2026) (Date 20 11 2026) FALSE EQUALS NOTHING
#ASSERT `o 62 r 4(4) the Authority may enter judgment against the defendant for costs` TRUE TRUE (Date 20 11 2026) (Date 20 11 2026) TRUE EQUALS JUST FALSE
#ASSERT `o 62 r 4(4) the Authority may enter judgment against the defendant for costs` FALSE TRUE (Date 21 11 2026) (Date 20 11 2026) TRUE EQUALS JUST FALSE
#ASSERT `o 62 r 4(4) the Authority may enter judgment against the defendant for costs` TRUE FALSE (Date 21 11 2026) (Date 20 11 2026) TRUE EQUALS JUST FALSE
-- (5).
#ASSERT `o 62 r 4(5) the application for permission is made as the Rule requires` TRUE Summons EQUALS JUST TRUE
#ASSERT `o 62 r 4(5) the application for permission is made as the Rule requires` TRUE `Originating application` EQUALS NOTHING
#ASSERT `o 62 r 4(5) the application for permission is made as the Rule requires` FALSE Summons EQUALS NOTHING
#ASSERT `o 62 r 4(5) the duty to serve the summons on the defendant arises` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 62 r 4(5) the duty to serve the summons on the defendant arises` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 62 r 4(5) the duty to serve the summons on the defendant arises` FALSE FALSE EQUALS NOTHING
#ASSERT `o 62 r 4(5) the summons is served on the defendant as the Rule requires` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 4(5) the summons is served on the defendant as the Rule requires` TRUE FALSE FALSE EQUALS NOTHING
-- The Court otherwise orders: the duty is lifted, so a missing service is not a breach.
#ASSERT `o 62 r 4(5) the summons is served on the defendant as the Rule requires` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 62 r 4(5) the summons is served on the defendant as the Rule requires` FALSE FALSE TRUE EQUALS NOTHING
-- (6).
#ASSERT `o 62 r 4(6) the provision applies to the civil penalty action` TRUE "Order 3 rule 2(8)(a)" EQUALS JUST TRUE
#ASSERT `o 62 r 4(6) the provision applies to the civil penalty action` TRUE "Order 3 rule 2(10)" EQUALS JUST TRUE
#ASSERT `o 62 r 4(6) the provision applies to the civil penalty action` TRUE "Order 6 rule 6(6)" EQUALS JUST TRUE
#ASSERT `o 62 r 4(6) the provision applies to the civil penalty action` TRUE "Order 3 rule 2(8)(b)" EQUALS NOTHING
#ASSERT `o 62 r 4(6) the provision applies to the civil penalty action` FALSE "Order 6 rule 6(5)" EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 62 rule 5 -- default of defence`
-- ---------------------------------------------------------------------------
-- The last day of the period fixed for service of the defence is 4 December 2026 (made up).
#ASSERT `o 62 r 5(1) the Authority may apply to the Court for judgment` TRUE (Date 5 12 2026) (Date 4 12 2026) EQUALS JUST TRUE
#ASSERT `o 62 r 5(1) the Authority may apply to the Court for judgment` TRUE (Date 4 12 2026) (Date 4 12 2026) EQUALS JUST FALSE
#ASSERT `o 62 r 5(1) the Authority may apply to the Court for judgment` FALSE (Date 5 12 2026) (Date 4 12 2026) EQUALS JUST FALSE
#ASSERT `o 62 r 5(1) the Court must give such judgment as the Authority appears entitled to` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 5(1) the Court must give such judgment as the Authority appears entitled to` FALSE EQUALS JUST FALSE
-- (2).  Arguments: course; more than one defendant; one makes default; claim severable.
#ASSERT `o 62 r 5(2) the Authority may take the course` `o 62 r 5(2)(a) apply for judgment against the defendant in default and proceed against the others` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 5(2) the Authority may take the course` `o 62 r 5(2)(a) apply for judgment against the defendant in default and proceed against the others` TRUE TRUE FALSE EQUALS JUST FALSE
-- (b) has no severability condition.
#ASSERT `o 62 r 5(2) the Authority may take the course` `o 62 r 5(2)(b) set down the action for judgment against the defendant in default with the others` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 62 r 5(2) the Authority may take the course` `o 62 r 5(2)(b) set down the action for judgment against the defendant in default with the others` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 62 r 5(2) the Authority may take the course` `o 62 r 5(2)(a) apply for judgment against the defendant in default and proceed against the others` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 62 r 5(3) the application is made as the Rule requires` TRUE Summons EQUALS JUST TRUE
#ASSERT `o 62 r 5(3) the application is made as the Rule requires` TRUE `Originating application` EQUALS NOTHING
#ASSERT `o 62 r 5(3) the application is made as the Rule requires` FALSE Summons EQUALS NOTHING
#ASSERT `o 62 r 5(4) the provision applies to the civil penalty action` TRUE "Order 6 rule 7(7)" EQUALS JUST TRUE
#ASSERT `o 62 r 5(4) the provision applies to the civil penalty action` TRUE "Order 6 rule 9(3)" EQUALS JUST TRUE
#ASSERT `o 62 r 5(4) the provision applies to the civil penalty action` TRUE "Order 3 rule 2(9)" EQUALS JUST TRUE
#ASSERT `o 62 r 5(4) the provision applies to the civil penalty action` TRUE "Order 6 rule 9(4)" EQUALS NOTHING
#ASSERT `o 62 r 5(4) the provision applies to the civil penalty action` FALSE "Order 6 rule 9(3)" EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 62 rules 6 and 7`
-- ---------------------------------------------------------------------------
#ASSERT `o 62 r 6 the Authority is required to make or add a person as a defendant` TRUE EQUALS JUST FALSE
#ASSERT `o 62 r 6 the Authority is required to make or add a person as a defendant` FALSE EQUALS NOTHING
#ASSERT `o 62 r 7(1) the third party notice may be issued` TRUE FALSE EQUALS JUST FALSE
-- Permission given: a lifted bar grants nothing (QA).
#ASSERT `o 62 r 7(1) the third party notice may be issued` TRUE TRUE EQUALS NOTHING
#ASSERT `o 62 r 7(1) the third party notice may be issued` FALSE FALSE EQUALS NOTHING
#ASSERT `o 62 r 7(2) the form of the summons` EQUALS "22"
#ASSERT `o 62 r 7(2) the application for permission is made and served as the Rule requires` TRUE Summons TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 7(2) the application for permission is made and served as the Rule requires` TRUE Summons FALSE TRUE EQUALS NOTHING
#ASSERT `o 62 r 7(2) the application for permission is made and served as the Rule requires` TRUE Summons TRUE FALSE EQUALS NOTHING
#ASSERT `o 62 r 7(2) the application for permission is made and served as the Rule requires` TRUE `Originating application` TRUE TRUE EQUALS NOTHING
#ASSERT `o 62 r 7(2) the application for permission is made and served as the Rule requires` FALSE Summons TRUE TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 62 rule 8 -- production and inspection of documents`
-- ---------------------------------------------------------------------------
#ASSERT `o 62 r 8(1) Order 11 applies to the civil penalty action` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 8(1) Order 11 applies to the civil penalty action` FALSE EQUALS NOTHING
#ASSERT `o 62 r 8(2) the Authority may be required to give production of documents or produce them for inspection` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 8(2) the Authority may be required to give production of documents or produce them for inspection` FALSE EQUALS NOTHING
#ASSERT `o 62 r 8(3) the order requires disclosure of the document` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 62 r 8(3) the order requires disclosure of the document` TRUE FALSE EQUALS NOTHING
#ASSERT `o 62 r 8(3) the order requires disclosure of the document` FALSE TRUE EQUALS NOTHING
-- (4).  Arguments: kind of document; in the Authority's possession as a result of its functions under the Act.
#ASSERT `o 62 r 8(4) the Authority may be ordered to give production of the document or produce it for inspection` `o 62 r 8(4)(a) a book voluntarily produced by the defendant or contravening person to the Authority` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 8(4) the Authority may be ordered to give production of the document or produce it for inspection` `o 62 r 8(4)(d) correspondence between the Authority or its solicitors and the defendant or contravening person, or their agents or solicitors` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 8(4) the Authority may be ordered to give production of the document or produce it for inspection` `o 62 r 8(4)(j) trading information relating to the trading activities which the Authority relies on or will rely on in the action` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 8(4) the Authority may be ordered to give production of the document or produce it for inspection` `o 62 r 8(4)(k) any other document which the Authority relies on or will rely on in the action` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 8(4) the Authority may be ordered to give production of the document or produce it for inspection` `o 62 r 8(4)(h) a warrant issued in respect of the premises pursuant to section 164` FALSE EQUALS NOTHING
#ASSERT `o 62 r 8(4) the Authority may be ordered to give production of the document or produce it for inspection` `o 62 r 8(4) a document of another kind` TRUE EQUALS NOTHING
-- (5).  Arguments: kind of document; provided to the Authority under section 168C.
#ASSERT `o 62 r 8(5) the Authority may be ordered to give production of the document or produce it for inspection` `o 62 r 8(5)(a) a book voluntarily produced by the defendant or contravening person to a Commercial Affairs Officer or a police officer` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 8(5) the Authority may be ordered to give production of the document or produce it for inspection` `o 62 r 8(5)(e)(iv) an acknowledgment of receipt for any other article placed in safe custody under section 78 of the Code` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 8(5) the Authority may be ordered to give production of the document or produce it for inspection` `o 62 r 8(5)(j) a search warrant issued in respect of the premises under section 24 of the Code` TRUE EQUALS JUST TRUE
#ASSERT `o 62 r 8(5) the Authority may be ordered to give production of the document or produce it for inspection` `o 62 r 8(5)(j) a search warrant issued in respect of the premises under section 24 of the Code` FALSE EQUALS NOTHING
#ASSERT `o 62 r 8(5) the Authority may be ordered to give production of the document or produce it for inspection` `o 62 r 8(5) a document of another kind` TRUE EQUALS NOTHING
-- (6).  Arguments: the document is listed in (4) or (5); the Court is of the opinion that there are strong and exceptional grounds; the description.
#ASSERT `o 62 r 8(6) an order may be made for the Authority to give production of the document or produce it for inspection` TRUE FALSE `o 62 r 8(6) none of these descriptions` EQUALS JUST TRUE
-- Not listed and no strong and exceptional grounds.
#ASSERT `o 62 r 8(6) an order may be made for the Authority to give production of the document or produce it for inspection` FALSE FALSE `o 62 r 8(6) none of these descriptions` EQUALS JUST FALSE
-- Not listed, but the Court is of the opinion that there are strong and exceptional grounds: the bar is lifted and nothing is granted (QA).
#ASSERT `o 62 r 8(6) an order may be made for the Authority to give production of the document or produce it for inspection` FALSE TRUE `o 62 r 8(6) none of these descriptions` EQUALS NOTHING
-- Excluded descriptions: no order may be made, whatever the grounds.
#ASSERT `o 62 r 8(6) an order may be made for the Authority to give production of the document or produce it for inspection` FALSE TRUE `o 62 r 8(6)(c) the Authority's internal books` EQUALS JUST FALSE
#ASSERT `o 62 r 8(6) an order may be made for the Authority to give production of the document or produce it for inspection` FALSE TRUE `o 62 r 8(6)(a) a document in the Authority's possession, custody or power as a result of its supervisory functions, duties or powers under a written law other than the Act` EQUALS JUST FALSE
#ASSERT `o 62 r 8(6) an order may be made for the Authority to give production of the document or produce it for inspection` FALSE TRUE `o 62 r 8(6)(g)(iii) correspondence between the Authority and the complainant` EQUALS JUST FALSE
-- A listed document that also falls within an excluded description (a fork): the exclusion is read as flat.
#ASSERT `o 62 r 8(6) an order may be made for the Authority to give production of the document or produce it for inspection` TRUE FALSE `o 62 r 8(6)(d) correspondence between the Authority and the Government or a statutory body` EQUALS JUST FALSE
#ASSERT `o 62 r 8(7) paragraph (6) affects the operation of the Evidence Act` TRUE EQUALS JUST FALSE
#ASSERT `o 62 r 8(7) paragraph (6) affects the operation of the Evidence Act` FALSE EQUALS NOTHING
#ASSERT `o 62 r 8(8) "book" the provision that gives its meaning` EQUALS "section 2(1)"

