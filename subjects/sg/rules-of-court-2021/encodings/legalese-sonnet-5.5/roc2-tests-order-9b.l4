IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc2-order-9b`

-- Tests for Order 9, Rules 10 to 19 (roc2-order-9b.l4).  Expected values are written from the text, beside the assertion.
-- One #ASSERT per line.  A made-up "last day" stands in for the answer of O 3 r 3 (roc1).

-- Rule 10
#ASSERT `o 9 r 10(1) the Court may do this` `o 9 r 10(1) add or remove one or more claimants or defendants` FALSE EQUALS JUST TRUE -- "add or remove one or more claimants or defendants"
#ASSERT `o 9 r 10(1) the Court may do this` `o 9 r 10(1) give permission for a defendant to issue a third party notice in accordance with Order 10` FALSE EQUALS JUST TRUE -- "give permission for a defendant to issue a third party notice"
#ASSERT `o 9 r 10(1) the Court may do this` `o 9 r 10(1) give directions for the originating process to be served on a person who may have an interest in the action` TRUE EQUALS JUST TRUE -- "any person who may have an interest in the action"
#ASSERT `o 9 r 10(1) the Court may do this` `o 9 r 10(1) give directions for the originating process to be served on a person who may have an interest in the action` FALSE EQUALS NOTHING -- a person with no interest: scope limit
#ASSERT `o 9 r 10(2) the person may proceed in this way` TRUE `o 9 r 10(2) attend a case conference` TRUE FALSE FALSE EQUALS JUST TRUE -- may attend if aware of it
#ASSERT `o 9 r 10(2) the person may proceed in this way` TRUE `o 9 r 10(2) attend a case conference` FALSE FALSE FALSE EQUALS JUST FALSE -- not aware of it: "if the person is aware of it" fails
#ASSERT `o 9 r 10(2) the person may proceed in this way` TRUE `o 9 r 10(2) seek a case conference by letter` FALSE TRUE TRUE EQUALS JUST TRUE -- letter to the Court copied to all the parties
#ASSERT `o 9 r 10(2) the person may proceed in this way` TRUE `o 9 r 10(2) seek a case conference by letter` FALSE TRUE FALSE EQUALS NOTHING -- not copied to all the parties: limited by "copied to all the parties"
#ASSERT `o 9 r 10(2) the person may proceed in this way` TRUE `o 9 r 10(2) seek a case conference by letter` FALSE FALSE TRUE EQUALS NOTHING -- not addressed to the Court
#ASSERT `o 9 r 10(2) the person may proceed in this way` FALSE `o 9 r 10(2) attend a case conference` TRUE TRUE TRUE EQUALS NOTHING -- not a person seeking to be added: scope limit
#ASSERT `o 9 r 10(3) the day on which the action is deemed to be commenced against the added defendant` TRUE (Date 5 7 2027) EQUALS JUST (Date 5 7 2027) -- "on the date on which the amendment to the action is made"
#ASSERT `o 9 r 10(3) the day on which the action is deemed to be commenced against the added defendant` FALSE (Date 5 7 2027) EQUALS NOTHING -- no person added as a defendant
#ASSERT `o 9 r 10(3) the action is deemed to be commenced against the person on this day` TRUE (Date 5 7 2027) (Date 5 7 2027) EQUALS JUST TRUE -- the amendment day
#ASSERT `o 9 r 10(3) the action is deemed to be commenced against the person on this day` TRUE (Date 5 7 2027) (Date 1 7 2027) EQUALS JUST FALSE -- an earlier day: the deeming rule names the amendment day
#ASSERT `o 9 r 10(3) the action is deemed to be commenced against the person on this day` FALSE (Date 5 7 2027) (Date 5 7 2027) EQUALS JUST FALSE -- no person added as a defendant: a "where" that fails

-- Rule 11
#ASSERT `o 9 r 11 the Court may make this order` `o 9 r 11 order 2 or more actions to be consolidated` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- (a) a common question of law
#ASSERT `o 9 r 11 the Court may make this order` `o 9 r 11 order them to be tried together` TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- (b) the same factual situation
#ASSERT `o 9 r 11 the Court may make this order` `o 9 r 11 order them to be tried one immediately after another` TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- (c) appropriate
#ASSERT `o 9 r 11 the Court may make this order` `o 9 r 11 order any of them to be stayed pending the determination of the other action or actions` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- stay
#ASSERT `o 9 r 11 the Court may make this order` `o 9 r 11 order 2 or more actions to be consolidated` TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- none of (a), (b), (c)
#ASSERT `o 9 r 11 the Court may make this order` `o 9 r 11 order 2 or more actions to be consolidated` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- only one action: "2 or more actions"

-- Rule 12(1): each limb, then the gathered answer
#ASSERT `o 9 r 12(1)(a) the defendant may apply for security for costs because the claimant is ordinarily resident out of the jurisdiction` TRUE EQUALS JUST TRUE -- (a)
#ASSERT `o 9 r 12(1)(a) the defendant may apply for security for costs because the claimant is ordinarily resident out of the jurisdiction` FALSE EQUALS JUST FALSE -- resident in the jurisdiction: "if" fails
#ASSERT `o 9 r 12(1)(b) the defendant may apply for security for costs because the claimant is a nominal claimant or is funded by a non-party` TRUE FALSE TRUE EQUALS JUST TRUE -- nominal claimant, reason to believe he cannot pay
#ASSERT `o 9 r 12(1)(b) the defendant may apply for security for costs because the claimant is a nominal claimant or is funded by a non-party` FALSE TRUE TRUE EQUALS JUST TRUE -- funded by a non-party, reason to believe
#ASSERT `o 9 r 12(1)(b) the defendant may apply for security for costs because the claimant is a nominal claimant or is funded by a non-party` TRUE TRUE FALSE EQUALS JUST FALSE -- no reason to believe the claimant will be unable to pay
#ASSERT `o 9 r 12(1)(b) the defendant may apply for security for costs because the claimant is a nominal claimant or is funded by a non-party` FALSE FALSE TRUE EQUALS JUST FALSE -- neither nominal nor funded
#ASSERT `o 9 r 12(1)(c) the defendant may apply for security for costs because of the claimant's address` TRUE FALSE TRUE EQUALS JUST TRUE -- address not stated or wrongly stated, to evade
#ASSERT `o 9 r 12(1)(c) the defendant may apply for security for costs because of the claimant's address` FALSE TRUE TRUE EQUALS JUST TRUE -- address changed, to evade
#ASSERT `o 9 r 12(1)(c) the defendant may apply for security for costs because of the claimant's address` TRUE TRUE FALSE EQUALS JUST FALSE -- no purpose to evade
#ASSERT `o 9 r 12(1)(c) the defendant may apply for security for costs because of the claimant's address` FALSE FALSE TRUE EQUALS JUST FALSE -- nothing wrong with the address
#ASSERT `o 9 r 12(1) the defendant may apply for security for the defendant's costs` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE -- limb (a) alone suffices
#ASSERT `o 9 r 12(1) the defendant may apply for security for the defendant's costs` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE -- limb (c) alone suffices
#ASSERT `o 9 r 12(1) the defendant may apply for security for the defendant's costs` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE -- none of (a), (b), (c)
#ASSERT `o 9 r 12(1) the defendant may apply for security for the defendant's costs` (JUST FALSE) NOTHING (JUST FALSE) EQUALS NOTHING -- a limb is not covered
-- Rule 12(2) to (6)
#ASSERT `o 9 r 12(2) section 388 of the Companies Act also applies` TRUE EQUALS JUST TRUE -- the claimant is a company
#ASSERT `o 9 r 12(2) section 388 of the Companies Act also applies` FALSE EQUALS JUST FALSE -- "If the claimant is a company" fails
#ASSERT `o 9 r 12(3)(a) the defendant may apply for security for costs from the non-party who assigned a right in the action` TRUE EQUALS JUST TRUE -- (a)
#ASSERT `o 9 r 12(3)(a) the defendant may apply for security for costs from the non-party who assigned a right in the action` FALSE EQUALS JUST FALSE -- (a) fails
#ASSERT `o 9 r 12(3)(b) the defendant may apply for security for costs from the non-party who contributed in return for a share` TRUE EQUALS JUST TRUE -- (b)
#ASSERT `o 9 r 12(3)(b) the defendant may apply for security for costs from the non-party who contributed in return for a share` FALSE EQUALS JUST FALSE -- (b) fails
#ASSERT `o 9 r 12(3)(c) the defendant may apply for security for costs from the non-party who contributed and instigates the action` TRUE TRUE EQUALS JUST TRUE -- (c)
#ASSERT `o 9 r 12(3)(c) the defendant may apply for security for costs from the non-party who contributed and instigates the action` TRUE FALSE EQUALS JUST FALSE -- contributed but does not instigate or encourage
#ASSERT `o 9 r 12(3)(c) the defendant may apply for security for costs from the non-party who contributed and instigates the action` FALSE TRUE EQUALS JUST FALSE -- instigates but has not contributed
#ASSERT `o 9 r 12(3) the defendant may apply for security for the defendant's costs to be provided by a non-party` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE -- limb (b) suffices
#ASSERT `o 9 r 12(3) the defendant may apply for security for the defendant's costs to be provided by a non-party` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE -- none of (a), (b), (c)
#ASSERT `o 9 r 12(3) the defendant may apply for security for the defendant's costs to be provided by a non-party` (JUST FALSE) (JUST FALSE) NOTHING EQUALS NOTHING -- a limb is not covered
#ASSERT `o 9 r 12(4) the application for an order under paragraph (3) is made as required` TRUE TRUE TRUE EQUALS JUST TRUE -- by summons, served on the non-party personally and every party
#ASSERT `o 9 r 12(4) the application for an order under paragraph (3) is made as required` FALSE TRUE TRUE EQUALS JUST FALSE -- not by summons
#ASSERT `o 9 r 12(4) the application for an order under paragraph (3) is made as required` TRUE FALSE TRUE EQUALS JUST FALSE -- not served on the non-party personally
#ASSERT `o 9 r 12(4) the application for an order under paragraph (3) is made as required` TRUE TRUE FALSE EQUALS JUST FALSE -- not served on every party
#ASSERT `o 9 r 12(5) this Rule limits or affects the Court's power to require security under a written law` TRUE EQUALS JUST FALSE -- "Nothing in this Rule is deemed to limit or affect"
#ASSERT `o 9 r 12(5) this Rule limits or affects the Court's power to require security under a written law` FALSE EQUALS NOTHING -- a power not under a written law
#ASSERT `o 9 r 12(6) a reference in paragraphs (1), (2) and (3) is to this person` Claimant TRUE EQUALS JUST TRUE -- the person in the position of claimant, including on a counterclaim
#ASSERT `o 9 r 12(6) a reference in paragraphs (1), (2) and (3) is to this person` Defendant TRUE EQUALS JUST TRUE -- the person in the position of defendant
#ASSERT `o 9 r 12(6) a reference in paragraphs (1), (2) and (3) is to this person` Claimant FALSE EQUALS NOTHING -- not in the position of claimant: scope limit
#ASSERT `o 9 r 12(6) a reference in paragraphs (1), (2) and (3) is to this person` Defendant FALSE EQUALS NOTHING -- not in the position of defendant
#ASSERT `o 9 r 12(6) a reference in paragraphs (1), (2) and (3) is to this person` `Third party` TRUE EQUALS NOTHING -- the paragraph speaks only of claimant and defendant
#ASSERT `o 9 r 12(6) a reference in paragraphs (1), (2) and (3) is to this person` `Fourth party` TRUE EQUALS NOTHING -- same
#ASSERT `o 9 r 12(6) a reference in paragraphs (1), (2) and (3) is to this person` Appellant TRUE EQUALS NOTHING -- same
#ASSERT `o 9 r 12(6) a reference in paragraphs (1), (2) and (3) is to this person` Respondent TRUE EQUALS NOTHING -- same
#ASSERT `o 9 r 12(6) a reference in paragraphs (1), (2) and (3) is to this person` `Non-party` TRUE EQUALS NOTHING -- same

-- Rule 13
#ASSERT `o 9 r 13 the Court may order a party to serve particulars of a matter stated in the party's pleading` TRUE EQUALS JUST TRUE -- the Court is of the opinion the particulars are necessary
#ASSERT `o 9 r 13 the Court may order a party to serve particulars of a matter stated in the party's pleading` FALSE EQUALS JUST FALSE -- "if the Court is of the opinion" fails

-- Rule 14
#ASSERT `o 9 r 14(1) the Court may allow the parties to amend the document` Defence EQUALS JUST TRUE -- a defence is a pleading (O 1 r 3(1) "pleading" includes a defence)
#ASSERT `o 9 r 14(1) the Court may allow the parties to amend the document` Summons EQUALS NOTHING -- O 1 r 3(1) does not say that a summons is a pleading
#ASSERT `o 9 r 14(2) the Court may consider the event to be pleaded although it does not relate back to the date of filing` TRUE TRUE EQUALS JUST TRUE -- a special case, event after filing
#ASSERT `o 9 r 14(2) the Court may consider the event to be pleaded although it does not relate back to the date of filing` FALSE TRUE EQUALS NOTHING -- not a special case
#ASSERT `o 9 r 14(2) the Court may consider the event to be pleaded although it does not relate back to the date of filing` TRUE FALSE EQUALS NOTHING -- not an event after filing
#ASSERT `o 9 r 14(3) the Court may allow the pleading to be amended` (Date 15 6 2027) (Date 10 6 2027) FALSE EQUALS JUST FALSE -- 5 June later than the 14th day before trial: "less than 14 days before"; not a special case
#ASSERT `o 9 r 14(3) the Court may allow the pleading to be amended` (Date 15 6 2027) (Date 10 6 2027) TRUE EQUALS NOTHING -- a special case: the prohibition does not reach
#ASSERT `o 9 r 14(3) the Court may allow the pleading to be amended` (Date 10 6 2027) (Date 10 6 2027) FALSE EQUALS NOTHING -- exactly 14 days before is not "less than 14 days before"
#ASSERT `o 9 r 14(3) the Court may allow the pleading to be amended` (Date 1 6 2027) (Date 10 6 2027) FALSE EQUALS NOTHING -- 9 days earlier than the cut-off: the prohibition does not reach
#ASSERT `o 9 r 14(4) the Court may allow the amendment` TRUE `o 9 r 14(4)(a) an amendment to correct the name of a party` TRUE FALSE FALSE EQUALS JUST TRUE -- (a) genuine mistake, not misleading
#ASSERT `o 9 r 14(4) the Court may allow the amendment` TRUE `o 9 r 14(4)(a) an amendment to correct the name of a party` FALSE FALSE FALSE EQUALS JUST FALSE -- (a) not a genuine mistake
#ASSERT `o 9 r 14(4) the Court may allow the amendment` TRUE `o 9 r 14(4)(b) an amendment to alter the capacity in which a party sues` FALSE TRUE FALSE EQUALS JUST TRUE -- (b) might have sued in that capacity
#ASSERT `o 9 r 14(4) the Court may allow the amendment` TRUE `o 9 r 14(4)(b) an amendment to alter the capacity in which a party sues` FALSE FALSE FALSE EQUALS JUST FALSE -- (b) could not have sued in that capacity
#ASSERT `o 9 r 14(4) the Court may allow the amendment` TRUE `o 9 r 14(4)(c) an amendment to add or substitute a new cause of action` FALSE FALSE TRUE EQUALS JUST TRUE -- (c) same or substantially the same facts
#ASSERT `o 9 r 14(4) the Court may allow the amendment` TRUE `o 9 r 14(4)(c) an amendment to add or substitute a new cause of action` FALSE FALSE FALSE EQUALS JUST FALSE -- (c) different facts
#ASSERT `o 9 r 14(4) the Court may allow the amendment` TRUE `o 9 r 14(4) any other amendment` TRUE TRUE TRUE EQUALS NOTHING -- an amendment of another kind: the circumstances are not said to be exhaustive
#ASSERT `o 9 r 14(4) the Court may allow the amendment` FALSE `o 9 r 14(4)(a) an amendment to correct the name of a party` TRUE TRUE TRUE EQUALS JUST FALSE -- limitation period has not expired: "Where" fails
#ASSERT `o 9 r 14(5) the pleading may be amended despite paragraphs (1) to (4)` TRUE (Date 10 6 2027) (Date 10 6 2027) EQUALS JUST TRUE -- by written agreement, exactly 14 days before the trial
#ASSERT `o 9 r 14(5) the pleading may be amended despite paragraphs (1) to (4)` TRUE (Date 11 6 2027) (Date 10 6 2027) EQUALS JUST FALSE -- by written agreement but less than 14 days before the trial
#ASSERT `o 9 r 14(5) the pleading may be amended despite paragraphs (1) to (4)` FALSE (Date 1 6 2027) (Date 10 6 2027) EQUALS NOTHING -- no written agreement: limited by "by written agreement"
#ASSERT `o 9 r 14(6) the Court may draw the appropriate inferences` TRUE EQUALS JUST TRUE -- material facts amended
#ASSERT `o 9 r 14(6) the Court may draw the appropriate inferences` FALSE EQUALS JUST FALSE -- "If" fails
#ASSERT `o 9 r 14(7) this Rule applies to the document with the necessary modifications` `Originating application` EQUALS JUST TRUE -- "an originating application"
#ASSERT `o 9 r 14(7) this Rule applies to the document with the necessary modifications` `Originating claim` EQUALS NOTHING -- only an originating application is named
#ASSERT `o 9 r 14(7) this Rule applies to the document with the necessary modifications` `Statement of claim` EQUALS NOTHING -- same
#ASSERT `o 9 r 14(7) this Rule applies to the document with the necessary modifications` Defence EQUALS NOTHING -- same
#ASSERT `o 9 r 14(7) this Rule applies to the document with the necessary modifications` `Defence and counterclaim` EQUALS NOTHING -- same
#ASSERT `o 9 r 14(7) this Rule applies to the document with the necessary modifications` Reply EQUALS NOTHING -- same
#ASSERT `o 9 r 14(7) this Rule applies to the document with the necessary modifications` `Reply to a defence and counterclaim` EQUALS NOTHING -- same
#ASSERT `o 9 r 14(7) this Rule applies to the document with the necessary modifications` Summons EQUALS NOTHING -- same
#ASSERT `o 9 r 14(7) this Rule applies to the document with the necessary modifications` `Summons without notice` EQUALS NOTHING -- same
#ASSERT `o 9 r 14(7) this Rule applies to the document with the necessary modifications` Affidavit EQUALS NOTHING -- same
#ASSERT `o 9 r 14(7) this Rule applies to the document with the necessary modifications` `Notice of intention to contest or not contest` EQUALS NOTHING -- same
#ASSERT `o 9 r 14(7) this Rule applies to the document with the necessary modifications` `Notice of appeal` EQUALS NOTHING -- same

-- Rule 15
#ASSERT `o 9 r 15(1) the Court must decide whether it is necessary to file the pleading` TRUE EQUALS JUST TRUE -- a pleading beyond the defence or defence to counterclaim
#ASSERT `o 9 r 15(1) the Court must decide whether it is necessary to file the pleading` FALSE EQUALS NOTHING -- the defence itself: scope limit
#ASSERT `o 9 r 15(2) the Court may order the further pleadings to be filed` TRUE EQUALS JUST FALSE -- "must not order further pleadings ... if they merely deny or repeat"
#ASSERT `o 9 r 15(2) the Court may order the further pleadings to be filed` FALSE EQUALS NOTHING -- pleadings that add something material: the prohibition does not reach them

-- Rule 16
#ASSERT `o 9 r 16(1) the Court may order the pleading or part of it to be struck out or amended` TRUE FALSE FALSE EQUALS JUST TRUE -- (a) discloses no reasonable cause of action or defence
#ASSERT `o 9 r 16(1) the Court may order the pleading or part of it to be struck out or amended` FALSE TRUE FALSE EQUALS JUST TRUE -- (b) abuse of process
#ASSERT `o 9 r 16(1) the Court may order the pleading or part of it to be struck out or amended` FALSE FALSE TRUE EQUALS JUST TRUE -- (c) the interests of justice
#ASSERT `o 9 r 16(1) the Court may order the pleading or part of it to be struck out or amended` FALSE FALSE FALSE EQUALS JUST FALSE -- no ground
#ASSERT `o 9 r 16(1) the Court may also order the action to be stayed or dismissed or judgment to be entered accordingly` FALSE TRUE FALSE EQUALS JUST TRUE -- on the same grounds
#ASSERT `o 9 r 16(1) the Court may also order the action to be stayed or dismissed or judgment to be entered accordingly` FALSE FALSE FALSE EQUALS JUST FALSE -- no ground
#ASSERT `o 9 r 16(2) evidence is admissible on the application` TRUE EQUALS JUST FALSE -- "No evidence is admissible on an application under paragraph (1)(a)"
#ASSERT `o 9 r 16(2) evidence is admissible on the application` FALSE EQUALS NOTHING -- an application on another ground
#ASSERT `o 9 r 16(3) this Rule applies to the document as if it were a pleading` `Originating application` EQUALS JUST TRUE -- "an originating application"
#ASSERT `o 9 r 16(3) this Rule applies to the document as if it were a pleading` `Originating claim` EQUALS NOTHING -- only an originating application is named
#ASSERT `o 9 r 16(3) this Rule applies to the document as if it were a pleading` `Statement of claim` EQUALS NOTHING -- same
#ASSERT `o 9 r 16(3) this Rule applies to the document as if it were a pleading` Defence EQUALS NOTHING -- same
#ASSERT `o 9 r 16(3) this Rule applies to the document as if it were a pleading` `Defence and counterclaim` EQUALS NOTHING -- same
#ASSERT `o 9 r 16(3) this Rule applies to the document as if it were a pleading` Reply EQUALS NOTHING -- same
#ASSERT `o 9 r 16(3) this Rule applies to the document as if it were a pleading` `Reply to a defence and counterclaim` EQUALS NOTHING -- same
#ASSERT `o 9 r 16(3) this Rule applies to the document as if it were a pleading` Summons EQUALS NOTHING -- same
#ASSERT `o 9 r 16(3) this Rule applies to the document as if it were a pleading` `Summons without notice` EQUALS NOTHING -- same
#ASSERT `o 9 r 16(3) this Rule applies to the document as if it were a pleading` Affidavit EQUALS NOTHING -- same
#ASSERT `o 9 r 16(3) this Rule applies to the document as if it were a pleading` `Notice of intention to contest or not contest` EQUALS NOTHING -- same
#ASSERT `o 9 r 16(3) this Rule applies to the document as if it were a pleading` `Notice of appeal` EQUALS NOTHING -- same
#ASSERT `o 9 r 16(4) the Court may order the affidavit or other document to be struck out or redacted` TRUE FALSE FALSE EQUALS JUST TRUE -- (a) no right to file
#ASSERT `o 9 r 16(4) the Court may order the affidavit or other document to be struck out or redacted` FALSE TRUE FALSE EQUALS JUST TRUE -- (b) abuse of process
#ASSERT `o 9 r 16(4) the Court may order the affidavit or other document to be struck out or redacted` FALSE FALSE TRUE EQUALS JUST TRUE -- (c) the interests of justice
#ASSERT `o 9 r 16(4) the Court may order the affidavit or other document to be struck out or redacted` FALSE FALSE FALSE EQUALS JUST FALSE -- no ground

-- Rule 17
#ASSERT `o 9 r 17(1) the claimant may apply for summary judgment against the defendant` TRUE TRUE `o 9 r 17(1)(a) the defendant has no defence to a claim` TRUE EQUALS JUST TRUE -- (a): after the defence has been filed and served in an originating claim
#ASSERT `o 9 r 17(1) the claimant may apply for summary judgment against the defendant` TRUE TRUE `o 9 r 17(1)(b) the defendant has no defence to a particular part of a claim` TRUE EQUALS JUST TRUE -- (b)
#ASSERT `o 9 r 17(1) the claimant may apply for summary judgment against the defendant` TRUE TRUE `o 9 r 17(1)(c) the defendant has no defence to a claim or part of a claim, except as to the amount of any damages claimed` TRUE EQUALS JUST TRUE -- (c)
#ASSERT `o 9 r 17(1) the claimant may apply for summary judgment against the defendant` TRUE FALSE `o 9 r 17(1)(a) the defendant has no defence to a claim` TRUE EQUALS JUST FALSE -- the defence has not yet been filed and served
#ASSERT `o 9 r 17(1) the claimant may apply for summary judgment against the defendant` FALSE TRUE `o 9 r 17(1)(a) the defendant has no defence to a claim` TRUE EQUALS JUST FALSE -- not an originating claim
#ASSERT `o 9 r 17(1) the claimant may apply for summary judgment against the defendant` TRUE TRUE `o 9 r 17(1)(a) the defendant has no defence to a claim` FALSE EQUALS JUST FALSE -- the defendant has a defence
#ASSERT `o 9 r 17(2) the claimant's affidavit is as required` TRUE EQUALS JUST TRUE -- all the evidence necessary or material
#ASSERT `o 9 r 17(2) the claimant's affidavit is as required` FALSE EQUALS JUST FALSE -- not all the evidence
#ASSERT `o 9 r 17(3) fourteen days after service of the claimant's application and affidavit`'s `period length` EQUALS 14 -- "within 14 days after service"
#ASSERT `o 9 r 17(3) the defendant must file and serve the defendant's affidavit` TRUE EQUALS JUST TRUE -- "If the defendant disputes the application in any way"
#ASSERT `o 9 r 17(3) the defendant must file and serve the defendant's affidavit` FALSE EQUALS JUST FALSE -- does not dispute: the "If" fails
#ASSERT `o 9 r 17(3) the defendant files and serves the defendant's affidavit in time` (Date 20 7 2027) (Date 20 7 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `o 9 r 17(3) the defendant files and serves the defendant's affidavit in time` (Date 21 7 2027) (Date 20 7 2027) EQUALS JUST FALSE -- a day late
#ASSERT `o 9 r 17(4) the defendant's affidavit is as required` TRUE EQUALS JUST TRUE -- all the evidence necessary or material to the defence
#ASSERT `o 9 r 17(4) the defendant's affidavit is as required` FALSE EQUALS JUST FALSE -- not all the evidence
#ASSERT `o 9 r 17(5) fourteen days after service of the defendant's affidavit`'s `period length` EQUALS 14 -- "within 14 days after service"
#ASSERT `o 9 r 17(5) the claimant must file and serve the claimant's affidavit` TRUE EQUALS JUST TRUE -- "If the claimant disputes anything in the defendant's affidavit"
#ASSERT `o 9 r 17(5) the claimant must file and serve the claimant's affidavit` FALSE EQUALS JUST FALSE -- disputes nothing
#ASSERT `o 9 r 17(5) the claimant files and serves the claimant's affidavit in time` (Date 3 8 2027) (Date 3 8 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `o 9 r 17(5) the claimant files and serves the claimant's affidavit in time` (Date 4 8 2027) (Date 3 8 2027) EQUALS JUST FALSE -- late
#ASSERT `o 9 r 17(6) a further affidavit may be filed` TRUE TRUE EQUALS JUST TRUE -- with the Court's approval
#ASSERT `o 9 r 17(6) a further affidavit may be filed` TRUE FALSE EQUALS JUST FALSE -- "No further affidavits may be filed without the Court's approval"
#ASSERT `o 9 r 17(6) a further affidavit may be filed` FALSE FALSE EQUALS NOTHING -- none filed
#ASSERT `o 9 r 17(7) the Court may make this order on the application` `o 9 r 17(7)(a) dismiss the application` FALSE EQUALS JUST TRUE -- (a)
#ASSERT `o 9 r 17(7) the Court may make this order on the application` `o 9 r 17(7)(b) grant permission to defend to the defendant without any conditions` FALSE EQUALS JUST TRUE -- (b)
#ASSERT `o 9 r 17(7) the Court may make this order on the application` `o 9 r 17(7)(c) grant judgment to the claimant` FALSE EQUALS JUST TRUE -- (c)
#ASSERT `o 9 r 17(7) the Court may make this order on the application` `o 9 r 17(7)(d) grant permission to defend to the defendant with conditions` TRUE EQUALS JUST TRUE -- (d) the defence is of a dubious nature
#ASSERT `o 9 r 17(7) the Court may make this order on the application` `o 9 r 17(7)(d) grant permission to defend to the defendant with conditions` FALSE EQUALS JUST FALSE -- (d) "if" fails
#ASSERT `o 9 r 17(8) the claimant may proceed with any other claim or the remainder of the claim or against any other defendant` TRUE EQUALS JUST TRUE -- summary judgment obtained
#ASSERT `o 9 r 17(8) the claimant may proceed with any other claim or the remainder of the claim or against any other defendant` FALSE EQUALS JUST FALSE -- "Where" fails
#ASSERT `o 9 r 17(9) the Court may order a stay of enforcement of the summary judgment until after the trial of the defendant's counterclaim` TRUE EQUALS JUST TRUE -- summary judgment granted against a defendant
#ASSERT `o 9 r 17(9) the Court may order a stay of enforcement of the summary judgment until after the trial of the defendant's counterclaim` FALSE EQUALS NOTHING -- no summary judgment: scope limit
#ASSERT `o 9 r 17(10) the Court may set aside or vary the summary judgment` TRUE TRUE EQUALS JUST TRUE -- granted against a defendant who was absent
#ASSERT `o 9 r 17(10) the Court may set aside or vary the summary judgment` TRUE FALSE EQUALS NOTHING -- the defendant was present: scope limit
#ASSERT `o 9 r 17(10) the Court may set aside or vary the summary judgment` FALSE TRUE EQUALS NOTHING -- no summary judgment against a defendant
#ASSERT `o 9 r 17(11) the defendant may apply for summary judgment against the claimant on the counterclaim` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- all four conditions
#ASSERT `o 9 r 17(11) the defendant may apply for summary judgment against the claimant on the counterclaim` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- not an originating claim
#ASSERT `o 9 r 17(11) the defendant may apply for summary judgment against the claimant on the counterclaim` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- no counterclaim served
#ASSERT `o 9 r 17(11) the defendant may apply for summary judgment against the claimant on the counterclaim` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- the claimant has not served a defence to the counterclaim
#ASSERT `o 9 r 17(11) the defendant may apply for summary judgment against the claimant on the counterclaim` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- the claimant has a defence
#ASSERT `o 9 r 17(12) a paragraph applies to the application under paragraph (11) with the necessary modifications` TRUE 2 EQUALS JUST TRUE -- paragraph (2) is the first named
#ASSERT `o 9 r 17(12) a paragraph applies to the application under paragraph (11) with the necessary modifications` TRUE 10 EQUALS JUST TRUE -- paragraph (10) is the last named
#ASSERT `o 9 r 17(12) a paragraph applies to the application under paragraph (11) with the necessary modifications` TRUE 1 EQUALS NOTHING -- paragraph (1) is not within "paragraphs (2) to (10)"
#ASSERT `o 9 r 17(12) a paragraph applies to the application under paragraph (11) with the necessary modifications` TRUE 13 EQUALS NOTHING -- paragraph (13) is not within "paragraphs (2) to (10)"
#ASSERT `o 9 r 17(12) a paragraph applies to the application under paragraph (11) with the necessary modifications` FALSE 5 EQUALS NOTHING -- not an application under paragraph (11)
#ASSERT `o 9 r 17(13) twenty-eight days after the date of service of the defence`'s `period length` EQUALS 28 -- "28 days after the date of service"
#ASSERT `o 9 r 17(13) the application is made in time` (Date 10 8 2027) (Date 10 8 2027) FALSE EQUALS JUST TRUE -- made on the last day
#ASSERT `o 9 r 17(13) the application is made in time` (Date 11 8 2027) (Date 10 8 2027) FALSE EQUALS JUST FALSE -- made after the expiry of 28 days, no permission
#ASSERT `o 9 r 17(13) the application is made in time` (Date 11 8 2027) (Date 10 8 2027) TRUE EQUALS JUST TRUE -- "Except where the Court otherwise permits"
#TRACE `o 9 r 17(3) the defendant who disputes the application must file and serve the affidavit` AT 0 WITH
    PARTY `o 9 r 17(3) the defendant` DOES `o 9 r 17(3) file and serve the affidavit on the claimant` AT 14
#TRACE `o 9 r 17(3) the defendant who disputes the application must file and serve the affidavit` AT 0 WITH
    (WAITUNTIL 15)
#TRACE `o 9 r 17(5) the claimant who disputes the defendant's affidavit must file and serve the affidavit` AT 0 WITH
    PARTY `o 9 r 17(5) the claimant` DOES `o 9 r 17(5) file and serve the affidavit on the defendant` AT 10
#TRACE `o 9 r 17(5) the claimant who disputes the defendant's affidavit must file and serve the affidavit` AT 0 WITH
    (WAITUNTIL 15)

-- Rule 18
#ASSERT `o 9 r 18(1) the Court must give this direction` `o 9 r 18(1) direct the parties to agree on as many material facts as possible` EQUALS JUST TRUE -- "direct the parties to agree on as many material facts as possible"
#ASSERT `o 9 r 18(1) the Court must give this direction` `o 9 r 18(1) direct the parties to set them out in an agreed statement of facts at as early a stage as possible` EQUALS JUST TRUE -- "to set them out in an agreed statement of facts at as early a stage as possible"
#ASSERT `o 9 r 18(2) the Court may give judgment on the admissions` TRUE TRUE EQUALS JUST TRUE -- admissions made, application made orally or in writing
#ASSERT `o 9 r 18(2) the Court may give judgment on the admissions` TRUE FALSE EQUALS NOTHING -- no application: limited by "on application"
#ASSERT `o 9 r 18(2) the Court may give judgment on the admissions` FALSE TRUE EQUALS JUST FALSE -- no admissions: "Where" fails
#ASSERT `o 9 r 18(3) the parties may do this` `o 9 r 18(3) agree on material questions of law` EQUALS JUST TRUE -- "agree on material questions of law"
#ASSERT `o 9 r 18(3) the parties may do this` `o 9 r 18(3) waive their right of appeal` EQUALS JUST TRUE -- "waive ... their right of appeal"
#ASSERT `o 9 r 18(3) the parties may do this` `o 9 r 18(3) limit their right of appeal` EQUALS JUST TRUE -- "limit their right of appeal"

-- Rule 19
#ASSERT `o 9 r 19(1) the Court may decide the question of law or the construction of the document without a trial or hearing on the facts` TRUE TRUE EQUALS JUST TRUE -- a question arises, party applies
#ASSERT `o 9 r 19(1) the Court may decide the question of law or the construction of the document without a trial or hearing on the facts` TRUE FALSE EQUALS JUST FALSE -- neither application nor own accord: "Upon" is read as "where", so JUST FALSE (ruling of 2026-11-05)
#ASSERT `o 9 r 19(1) the Court may decide the question of law or the construction of the document without a trial or hearing on the facts` FALSE TRUE EQUALS NOTHING -- not a question of law or construction: scope limit
#ASSERT `o 9 r 19(2) the Court may give judgment or dismiss the action or make any order that is appropriate` TRUE EQUALS JUST TRUE -- the decision fully determines the matter, claim or issue
#ASSERT `o 9 r 19(2) the Court may give judgment or dismiss the action or make any order that is appropriate` FALSE EQUALS JUST FALSE -- "Where" fails
