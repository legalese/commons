IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc4-order-19-div-1`
IMPORT `roc4-order-19-div-4`

-- Rules of Court 2021 (Singapore), Order 19, Division 4 (rule 41): TESTS.
-- Every expected value is written from the text beside the assertion, before the run, and is not copied from the encoding's output.
-- Time: made-up inputs stand for O 3 r 3's answer.  A last day of 10 February 2026 is used throughout.

-- ===== Rule 41(1) =====
#ASSERT `o 19 r 41(1) the appeal is brought by filing and serving an originating application` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 19 r 41(1) the appeal is brought by filing and serving an originating application` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 19 r 41(1) the appeal is brought by filing and serving an originating application` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 41(1) the appeal is brought by filing and serving an originating application` FALSE TRUE TRUE EQUALS NOTHING

-- ===== Rule 41(2) and (3) =====
#ASSERT `o 19 r 41(2) the period for the appellant's documents`'s `period length` EQUALS 8
#ASSERT `o 19 r 41(2) the period for the appellant's documents`'s `period unit` EQUALS Weeks
#ASSERT `o 19 r 41(3) the period for the respondent's documents`'s `period length` EQUALS 28
#ASSERT `o 19 r 41(3) the period for the respondent's documents`'s `period unit` EQUALS Days
#ASSERT `o 19 r 41(2) the appellant's document is filed and served in time` `o 19 r 41(2)(a) the record of proceedings` (Date 10 2 2026) (Date 10 2 2026) (Date 10 2 2026) NOTHING EQUALS JUST TRUE
#ASSERT `o 19 r 41(2) the appellant's document is filed and served in time` `o 19 r 41(2)(b) the appellant's written submissions` (Date 10 2 2026) (Date 11 2 2026) (Date 10 2 2026) NOTHING EQUALS JUST FALSE
#ASSERT `o 19 r 41(2) the appellant's document is filed and served in time` `o 19 r 41(2)(c) the appellant's bundle of authorities` (Date 11 2 2026) (Date 10 2 2026) (Date 10 2 2026) NOTHING EQUALS JUST FALSE
#ASSERT `o 19 r 41(2) the appellant's document is filed and served in time` `o 19 r 41(2)(c) the appellant's bundle of authorities` (Date 15 2 2026) (Date 15 2 2026) (Date 10 2 2026) (JUST (Date 17 2 2026)) EQUALS JUST TRUE
#ASSERT `o 19 r 41(3) the respondent's document is filed and served in time` `o 19 r 41(3)(a) the respondent's written submissions` (Date 10 2 2026) (Date 10 2 2026) (Date 10 2 2026) NOTHING EQUALS JUST TRUE
#ASSERT `o 19 r 41(3) the respondent's document is filed and served in time` `o 19 r 41(3)(b) the respondent's bundle of authorities` (Date 10 2 2026) (Date 11 2 2026) (Date 10 2 2026) NOTHING EQUALS JUST FALSE
#ASSERT `o 19 r 41(3) the respondent's document is filed and served in time` `o 19 r 41(3)(b) the respondent's bundle of authorities` (Date 8 2 2026) (Date 8 2 2026) (Date 10 2 2026) (JUST (Date 5 2 2026)) EQUALS JUST FALSE

-- ===== Rule 41(4) to (9) =====
#ASSERT `o 19 r 41(4) an affidavit may be filed in an appeal brought under paragraph (1)` FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 41(4) an affidavit may be filed in an appeal brought under paragraph (1)` TRUE EQUALS NOTHING
#ASSERT `o 19 r 41(5) the written submissions are within the page limit` 55 FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(5) the written submissions are within the page limit` 56 FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 41(5) the written submissions are within the page limit` 70 TRUE EQUALS NOTHING
#ASSERT `o 19 r 41(6)(a) the General Division may allow the page limit to be exceeded` TRUE EQUALS JUST TRUE
#ASSERT `o 19 r 41(6)(a) the General Division may allow the page limit to be exceeded` FALSE EQUALS NOTHING
#ASSERT `o 19 r 41(6)(b) the fees and additional fees for the pages in excess are payable` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(6)(b) the fees and additional fees for the pages in excess are payable` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 19 r 41(6)(b) the fees and additional fees for the pages in excess are payable` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 41(6)(b) the amount payable for the pages in excess` TRUE FALSE 100 EQUALS JUST 100
#ASSERT `o 19 r 41(6)(b) the amount payable for the pages in excess` TRUE TRUE 100 EQUALS NOTHING
#ASSERT `o 19 r 41(7) the General Division may waive, refund, defer or apportion the payment of the fees` TRUE EQUALS JUST TRUE
#ASSERT `o 19 r 41(7) the General Division may waive, refund, defer or apportion the payment of the fees` FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 41(8) more than one set of submissions may be filed for a party or a set of parties represented by the same firm of solicitors` FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 41(8) more than one set of submissions may be filed for a party or a set of parties represented by the same firm of solicitors` TRUE EQUALS NOTHING
#ASSERT `o 19 r 41(9) the concluding paragraphs of the written submissions include what they must include` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 19 r 41(9) the concluding paragraphs of the written submissions include what they must include` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 41(9) the concluding paragraphs of the written submissions include what they must include` FALSE TRUE EQUALS JUST FALSE

-- ===== Rule 41(10): the listed provisions apply, unless this Rule or another written law says otherwise =====
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(a) Rule 7 (Powers of appellate Court)` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(b) Rule 8 (Absence of parties)` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(c) Rule 10 (Withdrawal of appeal or application)` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(d) Rule 11 (Consent judgment or order)` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(e) Rule 12 (Judgment)` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(f) Rule 34 (Further arguments)` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(g) Rule 35(1) (Applications to appellate Court)` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(g) Rule 35(3) (Applications to appellate Court)` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(g) Rule 35(4) (Applications to appellate Court)` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(g) Rule 35(16) (Applications to appellate Court)` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(h) Rule 37 (Written submissions for applications to appellate Court)` FALSE EQUALS JUST TRUE
-- "Subject to this Rule and any other written law": the displacing provision is not in these sources.
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(f) Rule 34 (Further arguments)` TRUE EQUALS NOTHING
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(a) Rule 7 (Powers of appellate Court)` TRUE EQUALS NOTHING
-- Not listed in (10): silent here (paragraph (12) answers for Division 1 and Order 20).
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(12)(a) Rule 1(f), which paragraph (12)(a) excepts` FALSE EQUALS NOTHING
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(12)(a) any other provision of Division 1 of this Order` FALSE EQUALS NOTHING
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(12)(b) Order 20` FALSE EQUALS NOTHING
#ASSERT `o 19 r 41(10) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41 any other provision of this Order or of these Rules` FALSE EQUALS NOTHING
-- (10)(c): the references to security for costs in Rule 10(2) and (4)(b)(ii) are disregarded.
#ASSERT `o 19 r 41(10)(c) the reference in Rule 10 is to be disregarded` `o 19 r 41(10)(c) the reference to security for costs in Rule 10(2)` EQUALS JUST TRUE
#ASSERT `o 19 r 41(10)(c) the reference in Rule 10 is to be disregarded` `o 19 r 41(10)(c) the reference to security for costs in Rule 10(4)(b)(ii)` EQUALS JUST TRUE
#ASSERT `o 19 r 41(10)(c) the reference in Rule 10 is to be disregarded` `o 19 r 41(10)(c) any other reference in Rule 10` EQUALS NOTHING

-- ===== Rule 41(11): the substitution =====
#ASSERT `o 19 r 41(11) the provision is one to which the replacement of courts applies` `o 19 r 41(10)(a) Rule 7 (Powers of appellate Court)` EQUALS JUST TRUE
#ASSERT `o 19 r 41(11) the provision is one to which the replacement of courts applies` `o 19 r 41(10)(h) Rule 37 (Written submissions for applications to appellate Court)` EQUALS JUST TRUE
#ASSERT `o 19 r 41(11) the provision is one to which the replacement of courts applies` `o 19 r 41(12)(a) any other provision of Division 1 of this Order` EQUALS JUST FALSE
#ASSERT `o 19 r 41(11) the provision is one to which the replacement of courts applies` `o 19 r 41(12)(b) Order 20` EQUALS JUST FALSE
#ASSERT `o 19 r 41(11) the provision is one to which the replacement of courts applies` `o 19 r 41 any other provision of this Order or of these Rules` EQUALS JUST FALSE
#ASSERT `o 19 r 41(11) the provision is one to which the replacement of courts applies` `o 19 r 41(12)(a) Rule 1(f), which paragraph (12)(a) excepts` EQUALS NOTHING
#ASSERT `o 19 r 41(11) the court or body that the reference is read as` `o 19 r 41(11)(a) a reference to the appellate Court` TRUE EQUALS JUST `o 19 r 41(11)(a) the General Division`
#ASSERT `o 19 r 41(11) the court or body that the reference is read as` `o 19 r 41(11)(b) a reference to the lower Court` TRUE EQUALS JUST `o 19 r 41(11)(b) the Disciplinary Tribunal`
#ASSERT `o 19 r 41(11) the court or body that the reference is read as` `o 19 r 41(11) a reference to any other court or body` TRUE EQUALS NOTHING
#ASSERT `o 19 r 41(11) the court or body that the reference is read as` `o 19 r 41(11)(a) a reference to the appellate Court` FALSE EQUALS NOTHING

-- ===== Rule 41(12): Division 1 (with its exceptions) and Order 20 do not apply =====
#ASSERT `o 19 r 41(12) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(12)(a) any other provision of Division 1 of this Order` EQUALS JUST FALSE
#ASSERT `o 19 r 41(12) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(12)(b) Order 20` EQUALS JUST FALSE
-- The exceptions in (12)(a) are not declared inapplicable by (12).
#ASSERT `o 19 r 41(12) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(12)(a) Rule 1(f), which paragraph (12)(a) excepts` EQUALS NOTHING
#ASSERT `o 19 r 41(12) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(b) Rule 8 (Absence of parties)` EQUALS NOTHING
#ASSERT `o 19 r 41(12) the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(f) Rule 34 (Further arguments)` EQUALS NOTHING
-- Gathered: (12) says no, (10) says yes, otherwise silent.
#ASSERT `o 19 r 41 the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(b) Rule 8 (Absence of parties)` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41 the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(g) Rule 35(16) (Applications to appellate Court)` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41 the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(12)(a) any other provision of Division 1 of this Order` FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 41 the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(12)(b) Order 20` FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 41 the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(12)(b) Order 20` TRUE EQUALS JUST FALSE
#ASSERT `o 19 r 41 the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(12)(a) Rule 1(f), which paragraph (12)(a) excepts` FALSE EQUALS NOTHING
#ASSERT `o 19 r 41 the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41 any other provision of this Order or of these Rules` FALSE EQUALS NOTHING
#ASSERT `o 19 r 41 the provision applies to proceedings under section 59G of the Medical Registration Act` `o 19 r 41(10)(f) Rule 34 (Further arguments)` TRUE EQUALS NOTHING

-- ===== Rule 41(13): the defined terms =====
#ASSERT `o 19 r 41(13) a person is the appellant` TRUE EQUALS JUST TRUE
#ASSERT `o 19 r 41(13) a person is the appellant` FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 41(13) a document is a bundle of authorities` `o 19 r 41(13) a compilation of authorities for the appeal` EQUALS JUST TRUE
#ASSERT `o 19 r 41(13) a document is a bundle of authorities` `o 19 r 41(13) written grounds of decision` EQUALS JUST FALSE
#ASSERT `o 19 r 41(13) an item may be in a bundle of authorities` `o 19 r 41(13) a case authority` EQUALS JUST TRUE
#ASSERT `o 19 r 41(13) an item may be in a bundle of authorities` `o 19 r 41(13) a statute` EQUALS JUST TRUE
#ASSERT `o 19 r 41(13) an item may be in a bundle of authorities` `o 19 r 41(13) a law journal article` EQUALS JUST TRUE
#ASSERT `o 19 r 41(13) an item may be in a bundle of authorities` `o 19 r 41(13) any other item` EQUALS NOTHING
#ASSERT `o 19 r 41(13) a body is a Disciplinary Tribunal` TRUE EQUALS JUST TRUE
#ASSERT `o 19 r 41(13) a body is a Disciplinary Tribunal` FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 41(13) a document is part of the record of proceedings` `o 19 r 41(13) written grounds of decision` EQUALS JUST TRUE
#ASSERT `o 19 r 41(13) a document is part of the record of proceedings` `o 19 r 41(13) the record of evidence or notes of arguments taken` EQUALS JUST TRUE
#ASSERT `o 19 r 41(13) a document is part of the record of proceedings` `o 19 r 41(13) an affidavit or statutory declaration filed` EQUALS JUST TRUE
#ASSERT `o 19 r 41(13) a document is part of the record of proceedings` `o 19 r 41(13) a submission` EQUALS JUST TRUE
#ASSERT `o 19 r 41(13) a document is part of the record of proceedings` `o 19 r 41(13) another document tendered in respect of the proceedings before the Disciplinary Tribunal` EQUALS JUST TRUE
#ASSERT `o 19 r 41(13) a document is part of the record of proceedings` `o 19 r 41(13) a compilation of authorities for the appeal` EQUALS JUST FALSE
#ASSERT `o 19 r 41(13) a document is part of the record of proceedings` `o 19 r 41(13) any other document` EQUALS JUST FALSE
#ASSERT `o 19 r 41(13) a person is the respondent` TRUE EQUALS JUST TRUE
#ASSERT `o 19 r 41(13) a person is the respondent` FALSE EQUALS JUST FALSE

-- ===== Rule 41(10): a listed provision applies unless this Rule or another written law says otherwise (added after a check that each layer-1 function has an assertion) =====
#ASSERT `o 19 r 41(10) listed provision applies` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 41(10) listed provision applies` TRUE EQUALS NOTHING
