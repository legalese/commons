IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc1-order-3-time`
IMPORT `roc1-order-3`

-- TESTS for roc1-order-3.l4 (Order 3, Rules 1, 2, 5, 6, 7, 8, 9).  Every expected value is written from the text beside the assertion.
-- Calendar: November 2026, 5 Nov is a Thursday; fixture holidays 11 Nov and 23 Nov 2026 (not statements that they are holidays).

`o 3 r 2 test calendar` MEANS `Court calendar` WITH
    `public holidays` IS LIST Date 11 11 2026, Date 23 11 2026

-- Rule 1(1): a purposive interpretation for these Rules; nothing said of other text.
#ASSERT `o 3 r 1(1) the provision is to be given a purposive interpretation` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 1(1) the provision is to be given a purposive interpretation` FALSE EQUALS NOTHING
-- Rule 1(2): the five Ideals; anything else is not one (O 1 r 3(1) hands "Ideals" to this list).
#ASSERT `o 3 r 1(2) the objective is one of the Ideals` `o 3 r 1(2)(a) fair access to justice` EQUALS JUST TRUE
#ASSERT `o 3 r 1(2) the objective is one of the Ideals` `o 3 r 1(2)(b) expeditious proceedings` EQUALS JUST TRUE
#ASSERT `o 3 r 1(2) the objective is one of the Ideals` `o 3 r 1(2)(c) cost-effective work proportionate to the nature and importance of the action, the complexity of the claim and the difficulty or novelty of its issues, and the amount or value of the claim` EQUALS JUST TRUE
#ASSERT `o 3 r 1(2) the objective is one of the Ideals` `o 3 r 1(2)(d) efficient use of court resources` EQUALS JUST TRUE
#ASSERT `o 3 r 1(2) the objective is one of the Ideals` `o 3 r 1(2)(e) fair and practical results suited to the needs of the parties` EQUALS JUST TRUE
#ASSERT `o 3 r 1(2) the objective is one of the Ideals` `o 3 r 1(2) any other objective` EQUALS JUST FALSE
-- the five Ideals (a) to (e), counted from the list and not typed in
#ASSERT `o 3 r 1(2) the number of Ideals` EQUALS 5
-- Rule 1(3): the Court's duty reaches its orders and directions.
#ASSERT `o 3 r 1(3) the Court must seek to achieve the Ideals in the decision` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 1(3) the Court must seek to achieve the Ideals in the decision` FALSE EQUALS NOTHING
-- Rule 1(4): the parties' duty.
#ASSERT `o 3 r 1(4) the person has the duty to assist the Court and conduct the case to help achieve the Ideals` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 1(4) the person has the duty to assist the Court and conduct the case to help achieve the Ideals` FALSE EQUALS NOTHING
#ASSERT `o 3 r 1(4) the party has done what the duty requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 1(4) the party has done what the duty requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 1(4) the party has done what the duty requires` FALSE TRUE EQUALS NOTHING

-- Rule 2(1): "Unless the context otherwise requires and subject to any other written law"
#ASSERT `o 3 r 2(1) the requirement is subject to the Court's discretion to order otherwise` FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 3 r 2(1) the requirement is subject to the Court's discretion to order otherwise` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 2(1) the requirement is subject to the Court's discretion to order otherwise` FALSE TRUE EQUALS NOTHING
-- Rule 2(2): where there is no express provision; so long as not prohibited and consistent with the Ideals.
#ASSERT `o 3 r 2(2) the Court may do what it considers necessary` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(2) the Court may do what it considers necessary` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 3 r 2(2) the Court may do what it considers necessary` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 3 r 2(2) the Court may do what it considers necessary` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 2(2) the Court may do what it considers necessary` FALSE FALSE FALSE TRUE EQUALS NOTHING
-- Rule 2(3)
#ASSERT `o 3 r 2(3) the Court may impose a condition or give a direction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(3) the Court may impose a condition or give a direction` TRUE FALSE EQUALS NOTHING
#ASSERT `o 3 r 2(3) the Court may impose a condition or give a direction` FALSE TRUE EQUALS NOTHING
-- Rule 2(4) and (a) to (f)
#ASSERT `o 3 r 2(4) the Court may exercise the powers in paragraph (4)` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(4) the Court may exercise the powers in paragraph (4)` FALSE EQUALS JUST FALSE
-- (a) waiver: a failure of these Rules may be waived; of another written law only if it allows
#ASSERT `o 3 r 2(4)(a) the Court may waive the non-compliance` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 3 r 2(4)(a) the Court may waive the non-compliance` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(4)(a) the Court may waive the non-compliance` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 2(4)(a) the Court may waive the non-compliance` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 2(4)(b) the Court may disallow or reject the filing or use of a document` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(4)(b) the Court may disallow or reject the filing or use of a document` FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 2(4)(c) the Court may refuse to hear a matter or dismiss it without a hearing` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(4)(c) the Court may refuse to hear a matter or dismiss it without a hearing` FALSE EQUALS JUST FALSE
-- (d) only where inconsistent with the Ideals in a material way
#ASSERT `o 3 r 2(4)(d) the Court may dismiss, stay or set aside the proceedings` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(4)(d) the Court may dismiss, stay or set aside the proceedings` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 2(4)(d) the Court may dismiss, stay or set aside the proceedings` FALSE TRUE EQUALS JUST FALSE
-- (e) late filing fee: the power
#ASSERT `o 3 r 2(4)(e) the Court may impose a late filing fee` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(4)(e) the Court may impose a late filing fee` TRUE FALSE EQUALS NOTHING
#ASSERT `o 3 r 2(4)(e) the Court may impose a late filing fee` FALSE TRUE EQUALS NOTHING
-- (e) the amount: $50 for each court day of delay.  Last day Fri 6 Nov; filed Mon 9 Nov: Sat 7, Sun 8 left out, Mon 9 counts: 1 day, $50.
#ASSERT `o 3 r 2(4)(e) the late filing fee the Court may impose` (Date 6 11 2026) (Date 9 11 2026) `o 3 r 2 test calendar` EQUALS 50
-- filed Tue 10 Nov: Mon 9, Tue 10 = 2 days, $100
#ASSERT `o 3 r 2(4)(e) the late filing fee the Court may impose` (Date 6 11 2026) (Date 10 11 2026) `o 3 r 2 test calendar` EQUALS 100
-- filed Thu 12 Nov: Mon 9, Tue 10, [Wed 11 holiday left out], Thu 12 = 3 days, $150
#ASSERT `o 3 r 2(4)(e) the late filing fee the Court may impose` (Date 6 11 2026) (Date 12 11 2026) `o 3 r 2 test calendar` EQUALS 150
-- filed on the last day, or before it: no fee
#ASSERT `o 3 r 2(4)(e) the late filing fee the Court may impose` (Date 6 11 2026) (Date 6 11 2026) `o 3 r 2 test calendar` EQUALS 0
#ASSERT `o 3 r 2(4)(e) the late filing fee the Court may impose` (Date 6 11 2026) (Date 2 11 2026) `o 3 r 2 test calendar` EQUALS 0
-- filed only over the weekend (a non-court day): no court day of delay
#ASSERT `o 3 r 2(4)(e) the late filing fee the Court may impose` (Date 6 11 2026) (Date 8 11 2026) `o 3 r 2 test calendar` EQUALS 0
-- (f)
#ASSERT `o 3 r 2(4)(f) the Court may make a costs order or any other order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(4)(f) the Court may make a costs order or any other order` TRUE FALSE EQUALS NOTHING
#ASSERT `o 3 r 2(4)(f) the Court may make a costs order or any other order` FALSE TRUE EQUALS JUST FALSE
-- Rule 2(5): "only if the written law allows such waiver"
#ASSERT `o 3 r 2(5) the Court may waive the non-compliance with a written law other than these Rules` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(5) the Court may waive the non-compliance with a written law other than these Rules` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 2(5) the Court may waive the non-compliance with a written law other than these Rules` FALSE TRUE EQUALS JUST FALSE
-- Rule 2(6): "do not affect any other powers": a flat negative
#ASSERT `o 3 r 2(6) the powers under this Rule affect another power of the Court under a written law` TRUE EQUALS JUST FALSE
#ASSERT `o 3 r 2(6) the powers under this Rule affect another power of the Court under a written law` FALSE EQUALS NOTHING
-- Rule 2(7)
#ASSERT `o 3 r 2(7) the Court may give directions by those means` `o 3 r 2(7) by letter` EQUALS JUST TRUE
#ASSERT `o 3 r 2(7) the Court may give directions by those means` `o 3 r 2(7) by electronic means` EQUALS JUST TRUE
#ASSERT `o 3 r 2(7) the Court may give directions by those means` `o 3 r 2(7) by other means` EQUALS JUST TRUE
-- Rule 2(8): four grounds, in the interests of justice
#ASSERT `o 3 r 2(8) the Court may revoke a judgment or order obtained or set aside what was done` `o 3 r 2(8)(a) done without notice to, or in the absence of, the party affected` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(8) the Court may revoke a judgment or order obtained or set aside what was done` `o 3 r 2(8)(b) done without complying with these Rules or any order of Court` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(8) the Court may revoke a judgment or order obtained or set aside what was done` `o 3 r 2(8)(c) done contrary to any written law` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(8) the Court may revoke a judgment or order obtained or set aside what was done` `o 3 r 2(8)(d) done by fraud or misrepresentation` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(8) the Court may revoke a judgment or order obtained or set aside what was done` `o 3 r 2(8)(d) done by fraud or misrepresentation` FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 2(8) the Court may revoke a judgment or order obtained or set aside what was done` `o 3 r 2(8) any other ground` TRUE EQUALS NOTHING
#ASSERT `o 3 r 2(8) the Court may revoke a judgment or order obtained or set aside what was done` `o 3 r 2(8) any other ground` FALSE EQUALS JUST FALSE
-- Rule 2(9)
#ASSERT `o 3 r 2(9) the application under paragraph (8) may be made by the applicant` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 3 r 2(9) the application under paragraph (8) may be made by the applicant` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 2(9) the application under paragraph (8) may be made by the applicant` FALSE FALSE EQUALS NOTHING
-- Rule 2(10): 14 days after the day the applicant knew (Thu 5 Nov): last day Thu 19 Nov
#ASSERT `o 3 r 2(10) the application under paragraph (8) is taken out in time` (Date 5 11 2026) (Date 19 11 2026) `o 3 r 2 test calendar` NOTHING EQUALS JUST TRUE
#ASSERT `o 3 r 2(10) the application under paragraph (8) is taken out in time` (Date 5 11 2026) (Date 20 11 2026) `o 3 r 2 test calendar` NOTHING EQUALS JUST FALSE
-- a Court extension to 26 Nov makes 26 Nov in time
#ASSERT `o 3 r 2(10) the application under paragraph (8) is taken out in time` (Date 5 11 2026) (Date 26 11 2026) `o 3 r 2 test calendar` (JUST (Date 26 11 2026)) EQUALS JUST TRUE

-- Rule 5(1)
#ASSERT `o 3 r 5(1) the application to the Court in an action is made as the Rule requires` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 5(1) the application to the Court in an action is made as the Rule requires` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 3 r 5(1) the application to the Court in an action is made as the Rule requires` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 5(1) the application to the Court in an action is made as the Rule requires` TRUE TRUE TRUE EQUALS NOTHING
-- Rule 5(2) and (3)
#ASSERT `o 3 r 5(2) Form 1 is to be used` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 5(2) Form 1 is to be used` FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 5(3) Form 2 is to be used` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 5(3) Form 2 is to be used` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 5(3) Form 2 is to be used` FALSE TRUE EQUALS JUST FALSE
-- Rule 5(4): at least 14 days before the hearing on Mon 30 Nov 2026: Mon 16 Nov is the latest day
#ASSERT `o 3 r 5(4) the summons and the affidavit are served at least 14 days before the hearing` (Date 30 11 2026) (Date 16 11 2026) `o 3 r 2 test calendar` NOTHING EQUALS JUST TRUE
#ASSERT `o 3 r 5(4) the summons and the affidavit are served at least 14 days before the hearing` (Date 30 11 2026) (Date 17 11 2026) `o 3 r 2 test calendar` NOTHING EQUALS JUST FALSE
#ASSERT `o 3 r 5(4) the summons and the affidavit are served at least 14 days before the hearing` (Date 30 11 2026) (Date 2 11 2026) `o 3 r 2 test calendar` NOTHING EQUALS JUST TRUE
-- Rule 5(5): the duty, then the period (14 days after Thu 5 Nov is Thu 19 Nov)
#ASSERT `o 3 r 5(5) the party must file and serve an affidavit` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 5(5) the party must file and serve an affidavit` FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 5(5) the affidavit is filed and served within 14 days after service of the application` TRUE (Date 5 11 2026) (Date 19 11 2026) (Date 19 11 2026) `o 3 r 2 test calendar` NOTHING EQUALS JUST TRUE
#ASSERT `o 3 r 5(5) the affidavit is filed and served within 14 days after service of the application` TRUE (Date 5 11 2026) (Date 19 11 2026) (Date 20 11 2026) `o 3 r 2 test calendar` NOTHING EQUALS JUST FALSE
#ASSERT `o 3 r 5(5) the affidavit is filed and served within 14 days after service of the application` TRUE (Date 5 11 2026) (Date 20 11 2026) (Date 19 11 2026) `o 3 r 2 test calendar` NOTHING EQUALS JUST FALSE
#ASSERT `o 3 r 5(5) the affidavit is filed and served within 14 days after service of the application` FALSE (Date 5 11 2026) (Date 19 11 2026) (Date 19 11 2026) `o 3 r 2 test calendar` NOTHING EQUALS JUST FALSE
-- Rule 5(6): "Except in a special case, the Court will not allow further affidavits ... after the other party files"
#ASSERT `o 3 r 5(6) the Court allows a further affidavit` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 5(6) the Court allows a further affidavit` TRUE TRUE EQUALS NOTHING
#ASSERT `o 3 r 5(6) the Court allows a further affidavit` FALSE FALSE EQUALS NOTHING
-- Rule 5(7)
#ASSERT `o 3 r 5(7) the affidavit has the content the Rule requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 5(7) the affidavit has the content the Rule requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 5(7) the affidavit has the content the Rule requires` FALSE TRUE EQUALS JUST FALSE
-- Rule 5(8)
#ASSERT `o 3 r 5(8) the application must be served on the other party` FALSE EQUALS JUST TRUE
#ASSERT `o 3 r 5(8) the application must be served on the other party` TRUE EQUALS JUST FALSE

-- Rule 6(1)
#ASSERT `o 3 r 6(1) the Form must be used with the variations the circumstances require` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 6(1) the Form must be used with the variations the circumstances require` TRUE FALSE EQUALS NOTHING
#ASSERT `o 3 r 6(1) the Form must be used with the variations the circumstances require` FALSE TRUE EQUALS NOTHING
-- Rule 6(2): the Chief Justice for the Supreme Court, the Presiding Judge for the State Courts
#ASSERT `o 3 r 6(2) the Forms are varied by practice directions` `Supreme Court` `o 3 r 6(2) the Chief Justice approves` EQUALS JUST TRUE
#ASSERT `o 3 r 6(2) the Forms are varied by practice directions` `State Courts` `o 3 r 6(2) the Presiding Judge of the State Courts approves` EQUALS JUST TRUE
#ASSERT `o 3 r 6(2) the Forms are varied by practice directions` `State Courts` `o 3 r 6(2) the Chief Justice approves` EQUALS NOTHING
#ASSERT `o 3 r 6(2) the Forms are varied by practice directions` `Supreme Court` `o 3 r 6(2) the Presiding Judge of the State Courts approves` EQUALS NOTHING
#ASSERT `o 3 r 6(2) the Forms are varied by practice directions` `Supreme Court` `o 3 r 6(2) nobody has approved` EQUALS NOTHING
-- Rule 6(3)
#ASSERT `o 3 r 6(3) the document must bear the seal of the Court` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 6(3) the document must bear the seal of the Court` FALSE EQUALS JUST FALSE

-- Rule 7
#ASSERT `o 3 r 7(1) the document filed or used in Court is in the English language as required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 7(1) the document filed or used in Court is in the English language as required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 7(1) the document filed or used in Court is in the English language as required` FALSE TRUE EQUALS NOTHING
#ASSERT `o 3 r 7(2) the document not in English is accompanied by a certified or verified translation` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 3 r 7(2) the document not in English is accompanied by a certified or verified translation` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 7(2) the document not in English is accompanied by a certified or verified translation` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 7(2) the document not in English is accompanied by a certified or verified translation` FALSE FALSE FALSE EQUALS NOTHING

-- Rule 8
#ASSERT `o 3 r 8(1)(a) the document may be received, filed or used in the Court as a foreign public document with an apostille` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 8(1)(a) the document may be received, filed or used in the Court as a foreign public document with an apostille` TRUE FALSE EQUALS NOTHING
#ASSERT `o 3 r 8(1)(b) the document may be received, filed or used in the Court under a Civil Procedure Convention` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 8(1)(b) the document may be received, filed or used in the Court under a Civil Procedure Convention` TRUE FALSE EQUALS NOTHING
#ASSERT `o 3 r 8(1)(b) the document may be received, filed or used in the Court under a Civil Procedure Convention` FALSE TRUE EQUALS NOTHING
#ASSERT `o 3 r 8(2) the certificate is an apostille` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `o 3 r 8(2) the certificate is an apostille` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `o 3 r 8(2) the certificate is an apostille` NOTHING EQUALS NOTHING
#ASSERT `o 3 r 8(2) the document is a foreign public document` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `o 3 r 8(2) the document is a foreign public document` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `o 3 r 8(2) the document is a foreign public document` NOTHING EQUALS NOTHING

-- Rule 9
#ASSERT `o 3 r 9 the Court may conduct a hearing by electronic, mechanical or other means` FALSE EQUALS JUST TRUE
#ASSERT `o 3 r 9 the Court may conduct a hearing by electronic, mechanical or other means` TRUE EQUALS NOTHING
