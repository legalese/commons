IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc5-o22-objection`

-- TESTS for roc5-o22-objection.l4 (Order 22, rules 10 to 13).  Every expected value is written from the text of the
-- Rules (lines 3529 to 3555 of the raw file), beside the assertion, before the module was run.
-- A "last day" below is a made-up answer of O 3 r 3 (seam S-T1).  The regulative rules are run by #TRACE in the module
-- (FULFILLED at day 14, 14 and 7; BREACH or the paragraph (4) permission one day later); a trace prints its result and
-- is not assertable on this build.

§ `Tests -- Order 22, rules 10 to 13`

-- ---------------------------------------------------------------------------
§§ `Rule 10 (1) and (2)`
-- ---------------------------------------------------------------------------

#ASSERT `o 22 r 10(1) the period for filing and serving the notice of objection`'s `period length` EQUALS 14
#ASSERT `o 22 r 10(1)(a) the objector gives notice of the objection to the Sheriff in time` TRUE (Date 15 7 2027) (Date 15 7 2027) EQUALS JUST TRUE
#ASSERT `o 22 r 10(1)(a) the objector gives notice of the objection to the Sheriff in time` TRUE (Date 16 7 2027) (Date 15 7 2027) EQUALS JUST FALSE
-- "Where ... objects"
#ASSERT `o 22 r 10(1)(a) the objector gives notice of the objection to the Sheriff in time` FALSE (Date 2 7 2027) (Date 15 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(1)(b) the objector serves a copy of the notice of objection in time and on the persons the rule names` TRUE TRUE TRUE TRUE (Date 15 7 2027) (Date 15 7 2027) EQUALS JUST TRUE
#ASSERT `o 22 r 10(1)(b) the objector serves a copy of the notice of objection in time and on the persons the rule names` TRUE TRUE TRUE TRUE (Date 16 7 2027) (Date 15 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(1)(b) the objector serves a copy of the notice of objection in time and on the persons the rule names` TRUE FALSE TRUE TRUE (Date 2 7 2027) (Date 15 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(1)(b) the objector serves a copy of the notice of objection in time and on the persons the rule names` TRUE TRUE FALSE TRUE (Date 2 7 2027) (Date 15 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(1)(b) the objector serves a copy of the notice of objection in time and on the persons the rule names` TRUE TRUE TRUE FALSE (Date 2 7 2027) (Date 15 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(1)(b) the objector serves a copy of the notice of objection in time and on the persons the rule names` FALSE TRUE TRUE TRUE (Date 2 7 2027) (Date 15 7 2027) EQUALS JUST FALSE
-- no evidence to include
#ASSERT `o 22 r 10(2) the notice of objection has the contents the rule requires` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 10(2) the notice of objection has the contents the rule requires` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- evidence exists and is not included
#ASSERT `o 22 r 10(2) the notice of objection has the contents the rule requires` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 10(2) the notice of objection has the contents the rule requires` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 10(2) the notice of objection has the contents the rule requires` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 10(2) the notice of objection has the contents the rule requires` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§§ `Rule 10 (3) and (4)`
-- ---------------------------------------------------------------------------

#ASSERT `o 22 r 10(3) the period for the enforcement applicant's notice of consent`'s `period length` EQUALS 14
#ASSERT `o 22 r 10(3) the enforcement applicant must give notice that it consents to the release` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 10(3) the enforcement applicant must give notice that it consents to the release` FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 10(3) the enforcement applicant gives notice of consent in time` (Date 15 7 2027) (Date 15 7 2027) EQUALS JUST TRUE
#ASSERT `o 22 r 10(3) the enforcement applicant gives notice of consent in time` (Date 16 7 2027) (Date 15 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(3) the Sheriff must release the specified property or debt` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 10(3) the Sheriff must release the specified property or debt` FALSE EQUALS NOTHING
-- the applicant gave notice of dispute
#ASSERT `o 22 r 10(4) the Sheriff may direct the objector to apply to the Court` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 10(4) the Sheriff may direct the objector to apply to the Court` FALSE TRUE TRUE EQUALS JUST TRUE
-- the 14 days passed without consent
#ASSERT `o 22 r 10(4) the Sheriff may direct the objector to apply to the Court` FALSE FALSE TRUE EQUALS JUST TRUE
-- consented within the 14 days
#ASSERT `o 22 r 10(4) the Sheriff may direct the objector to apply to the Court` TRUE FALSE TRUE EQUALS JUST FALSE
-- the 14 days have not passed and no dispute
#ASSERT `o 22 r 10(4) the Sheriff may direct the objector to apply to the Court` FALSE FALSE FALSE EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§§ `Rule 10 (5)`
-- ---------------------------------------------------------------------------

#ASSERT `o 22 r 10(5)(a) the period for applying to the Court`'s `period length` EQUALS 7
#ASSERT `o 22 r 10(5)(a) the objector applies to the Court in time` TRUE TRUE (Date 8 7 2027) (Date 8 7 2027) EQUALS JUST TRUE
#ASSERT `o 22 r 10(5)(a) the objector applies to the Court in time` TRUE TRUE (Date 9 7 2027) (Date 8 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(5)(a) the objector applies to the Court in time` TRUE FALSE (Date 2 7 2027) (Date 8 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(5)(a) the objector applies to the Court in time` FALSE TRUE (Date 2 7 2027) (Date 8 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(5)(a) the objection is deemed to have been withdrawn` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 10(5)(a) the objection is deemed to have been withdrawn` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 10(5)(a) the objection is deemed to have been withdrawn` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 10(5)(b) the period for serving the summons and for giving notice to the Sheriff`'s `period length` EQUALS 7
#ASSERT `o 22 r 10(5)(b) the objector serves the summons and supporting affidavit in time and on the persons the rule names` TRUE TRUE TRUE TRUE (Date 10 7 2027) (Date 10 7 2027) EQUALS JUST TRUE
#ASSERT `o 22 r 10(5)(b) the objector serves the summons and supporting affidavit in time and on the persons the rule names` TRUE TRUE TRUE TRUE (Date 11 7 2027) (Date 10 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(5)(b) the objector serves the summons and supporting affidavit in time and on the persons the rule names` TRUE FALSE TRUE TRUE (Date 4 7 2027) (Date 10 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(5)(b) the objector serves the summons and supporting affidavit in time and on the persons the rule names` TRUE TRUE FALSE TRUE (Date 4 7 2027) (Date 10 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(5)(b) the objector serves the summons and supporting affidavit in time and on the persons the rule names` TRUE TRUE TRUE FALSE (Date 4 7 2027) (Date 10 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(5)(b) the objector serves the summons and supporting affidavit in time and on the persons the rule names` FALSE TRUE TRUE TRUE (Date 4 7 2027) (Date 10 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(5)(c) the objector gives notice to the Sheriff in time` TRUE TRUE (Date 10 7 2027) (Date 10 7 2027) EQUALS JUST TRUE
#ASSERT `o 22 r 10(5)(c) the objector gives notice to the Sheriff in time` TRUE TRUE (Date 11 7 2027) (Date 10 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(5)(c) the objector gives notice to the Sheriff in time` TRUE FALSE (Date 4 7 2027) (Date 10 7 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 10(5)(c) the objector gives notice to the Sheriff in time` FALSE TRUE (Date 4 7 2027) (Date 10 7 2027) EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§§ `Rule 10 (6) to (8)`
-- ---------------------------------------------------------------------------

#ASSERT `o 22 r 10(6) the Sheriff may provide the information` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 10(6) the Sheriff may provide the information` TRUE FALSE EQUALS NOTHING
#ASSERT `o 22 r 10(6) the Sheriff may provide the information` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 10(7) the Sheriff may sell the property` TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 10(7) the Sheriff may sell the property` FALSE EQUALS NOTHING
#ASSERT `o 22 r 10(8) the Sheriff may seek the Court's directions by letter at any time` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 10(8) the Sheriff may seek the Court's directions by letter at any time` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§§ `Rule 11 -- examination`
-- ---------------------------------------------------------------------------

#ASSERT `o 22 r 11(1) the enforcement applicant may apply for the enforcement respondent to be examined orally in court or to make an affidavit or both on the properties` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 11(1) the enforcement applicant may apply for the enforcement respondent to be examined orally in court or to make an affidavit or both on the properties` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 11(1) the enforcement applicant may apply for the enforcement respondent to be examined orally in court or to make an affidavit or both on the properties` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `o 22 r 11(1) the enforcement applicant may apply for the enforcement respondent to be examined orally in court or to make an affidavit or both on the properties` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `o 22 r 11(2) the Court may order the enforcement respondent to produce the documents` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 11(2) the Court may order the enforcement respondent to produce the documents` FALSE EQUALS NOTHING
#ASSERT `o 22 r 11(3) the order must state the appointment of the officers of the entity who are to be examined` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 11(3) the order must state the appointment of the officers of the entity who are to be examined` FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 11(3) the order states the appointment of the officers as the rule requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 11(3) the order states the appointment of the officers as the rule requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 11(3) the order states the appointment of the officers as the rule requires` FALSE TRUE EQUALS NOTHING
#ASSERT `o 22 r 11(3) the order states the appointment of the officers as the rule requires` FALSE FALSE EQUALS NOTHING
#ASSERT `o 22 r 11(4) the application is deemed to be enforcement of a Court order` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 11(4) the application is deemed to be enforcement of a Court order` FALSE EQUALS NOTHING
#ASSERT `o 22 r 11(4) the application is within the terms of any written law or any order staying enforcement of the Court order` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 11(4) the application is within the terms of any written law or any order staying enforcement of the Court order` FALSE EQUALS NOTHING
-- not an entity: Form 41 and personal service on the respondent
#ASSERT `o 22 r 11(5) the order is made and served as the rule requires` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- an entity: and on the officer ordered to attend
#ASSERT `o 22 r 11(5) the order is made and served as the rule requires` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 11(5) the order is made and served as the rule requires` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 11(5) the order is made and served as the rule requires` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 11(5) the order is made and served as the rule requires` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 11(5) the order is made and served as the rule requires` FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§§ `Rules 12 and 13`
-- ---------------------------------------------------------------------------

#ASSERT `o 22 r 12 the enforcement applicant may apply for an enforcement order in respect of the instalments due and unpaid` TRUE TRUE EQUALS JUST TRUE
-- an instalment order exists and no instalment is due yet
#ASSERT `o 22 r 12 the enforcement applicant may apply for an enforcement order in respect of the instalments due and unpaid` TRUE FALSE EQUALS NOTHING
#ASSERT `o 22 r 12 the enforcement applicant may apply for an enforcement order in respect of the instalments due and unpaid` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 12 the enforcement applicant may apply for an enforcement order in respect of the instalments due and unpaid` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 13(1) the party may apply for stay of enforcement or stay of the enforcement order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 13(1) the party may apply for stay of enforcement or stay of the enforcement order` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 13(1) the party may apply for stay of enforcement or stay of the enforcement order` FALSE TRUE EQUALS NOTHING
#ASSERT `o 22 r 13(2) the Court may order a stay of enforcement or of an enforcement order for the duration` `o 22 r 13(2) for a specified period` EQUALS JUST TRUE
#ASSERT `o 22 r 13(2) the Court may order a stay of enforcement or of an enforcement order for the duration` `o 22 r 13(2) until the occurrence of a specified event` EQUALS JUST TRUE
#ASSERT `o 22 r 13(2) the Court may order a stay of enforcement or of an enforcement order for the duration` `o 22 r 13(2) in some other way` EQUALS NOTHING
#ASSERT `o 22 r 13(3) the order may give the direction to the Sheriff` `o 22 r 13(3) to withdraw the seizure or attachment` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 13(3) the order may give the direction to the Sheriff` `o 22 r 13(3) to maintain the seizure or attachment without taking further action on the enforcement order` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 13(3) the order may give the direction to the Sheriff` `o 22 r 13(3) some other direction` TRUE EQUALS NOTHING
#ASSERT `o 22 r 13(3) the order may give the direction to the Sheriff` `o 22 r 13(3) to withdraw the seizure or attachment` FALSE EQUALS JUST FALSE
