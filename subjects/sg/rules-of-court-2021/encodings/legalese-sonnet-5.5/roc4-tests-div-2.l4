#ASSERT `o 19 r 19(4) the General Division may waive, refund, defer or apportion the payment of the fees` FALSE EQUALS JUST FALSE

-- ===== Rule 20 =====
#ASSERT `o 19 r 20(1) an order from the Court is needed for this Rule to apply` FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 20(1) an order from the Court is needed for this Rule to apply` TRUE EQUALS JUST FALSE
-- Security of $5,000.  Costs of $2,000 payable: $2,000 to the respondent, $3,000 back to the appellant.
#ASSERT `o 19 r 20(2) the security for costs must be paid to the respondent towards the costs ordered` (JUST 2000) EQUALS JUST TRUE
#ASSERT `o 19 r 20(2) the security for costs must be paid to the respondent towards the costs ordered` NOTHING EQUALS JUST FALSE
#ASSERT `o 19 r 20(2) the amount of the security paid to the respondent` 5000 (JUST 2000) EQUALS JUST 2000
#ASSERT `o 19 r 20(2) the balance of the security paid to the appellant` 5000 (JUST 2000) EQUALS JUST 3000
-- Costs of $8,000 exceed the security: all $5,000 to the respondent, nothing back.
#ASSERT `o 19 r 20(2) the amount of the security paid to the respondent` 5000 (JUST 8000) EQUALS JUST 5000
#ASSERT `o 19 r 20(2) the balance of the security paid to the appellant` 5000 (JUST 8000) EQUALS JUST 0
-- No costs payable: paragraph (3), not (2).
#ASSERT `o 19 r 20(2) the amount of the security paid to the respondent` 5000 NOTHING EQUALS NOTHING
#ASSERT `o 19 r 20(2) the balance of the security paid to the appellant` 5000 NOTHING EQUALS NOTHING
#ASSERT `o 19 r 20(3) the security for costs must be paid to the appellant and the appellant's solicitor is released from any undertaking` NOTHING EQUALS JUST TRUE
#ASSERT `o 19 r 20(3) the security for costs must be paid to the appellant and the appellant's solicitor is released from any undertaking` (JUST 2000) EQUALS JUST FALSE

