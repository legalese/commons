-- (2): core bundles 55, 35, 25 pages.
#ASSERT `o 19 r 19(2) the page limit` `o 19 r 19(2)(a) the appellant's core bundle of documents (excluding the written judgment or grounds of decision of the lower Court and the extracted order of the lower Court)` EQUALS 55
#ASSERT `o 19 r 19(2) the page limit` `o 19 r 19(2)(b) the respondent's core bundle of documents` EQUALS 35
#ASSERT `o 19 r 19(2) the page limit` `o 19 r 19(2)(c) the second core bundle` EQUALS 25
#ASSERT `o 19 r 19(2) the document is within the page limit` `o 19 r 19(2)(a) the appellant's core bundle of documents (excluding the written judgment or grounds of decision of the lower Court and the extracted order of the lower Court)` 55 FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 19(2) the document is within the page limit` `o 19 r 19(2)(a) the appellant's core bundle of documents (excluding the written judgment or grounds of decision of the lower Court and the extracted order of the lower Court)` 56 FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 19(2) the document is within the page limit` `o 19 r 19(2)(b) the respondent's core bundle of documents` 35 FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 19(2) the document is within the page limit` `o 19 r 19(2)(b) the respondent's core bundle of documents` 36 FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 19(2) the document is within the page limit` `o 19 r 19(2)(c) the second core bundle` 25 FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 19(2) the document is within the page limit` `o 19 r 19(2)(c) the second core bundle` 26 FALSE EQUALS JUST FALSE
#ASSERT `o 19 r 19(2) the document is within the page limit` `o 19 r 19(2)(c) the second core bundle` 40 TRUE EQUALS NOTHING
