-- "prior to handing or paying over the sums mentioned in paragraph (10)"
#ASSERT `o 22 r 6(8) the non-party may deduct the costs from the debt` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 6(8) the non-party may deduct the costs from the debt` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `o 22 r 6(8) the non-party may deduct the costs from the debt` NOTHING FALSE EQUALS NOTHING

