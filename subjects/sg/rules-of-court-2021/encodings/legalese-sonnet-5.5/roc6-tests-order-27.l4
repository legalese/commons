IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc6-order-27`

-- Tests for roc6-order-27.l4 (Order 27, Lodgment in Court, money in Registry and payment to Sheriff).
-- Every expected value is written from the text (lines 4099 to 4193 of the source), beside the assertion, before the code was run.
-- The last days are made up: Order 3, Rule 3 (roc1's range) counts them.


-- ---------------------------------------------------------------------------
§ `Tests -- Rule 1`
-- ---------------------------------------------------------------------------

#ASSERT `o 27 r 1 "bank" is a bank approved by the Accountant-General` TRUE EQUALS JUST TRUE -- approved by the Accountant-General
#ASSERT `o 27 r 1 "bank" is a bank approved by the Accountant-General` FALSE EQUALS JUST FALSE -- "means"
#ASSERT `o 27 r 1 "carry over" is to transfer the fund or any part of it from one account to another in the books of the Accountant-General` TRUE TRUE EQUALS JUST TRUE -- in relation to a fund in Court, and a transfer between accounts
#ASSERT `o 27 r 1 "carry over" is to transfer the fund or any part of it from one account to another in the books of the Accountant-General` TRUE FALSE EQUALS JUST FALSE -- "means": not a transfer from one account to another
#ASSERT `o 27 r 1 "carry over" is to transfer the fund or any part of it from one account to another in the books of the Accountant-General` FALSE TRUE EQUALS JUST FALSE -- "means": not in relation to a fund in Court
#ASSERT `o 27 r 1 "carry over" is to transfer the fund or any part of it from one account to another in the books of the Accountant-General` FALSE FALSE EQUALS JUST FALSE -- "means": neither
-- arguments: money, securities or other investments; standing or to be placed to the account of the Accountant-General; money placed on deposit
#ASSERT `o 27 r 1 "funds" is money, securities or other investments standing or to be placed to the account of the Accountant-General, and includes money placed on deposit` TRUE TRUE FALSE EQUALS JUST TRUE -- money, securities or other investments standing to the account
#ASSERT `o 27 r 1 "funds" is money, securities or other investments standing or to be placed to the account of the Accountant-General, and includes money placed on deposit` FALSE FALSE TRUE EQUALS JUST TRUE -- "includes money placed on deposit"
#ASSERT `o 27 r 1 "funds" is money, securities or other investments standing or to be placed to the account of the Accountant-General, and includes money placed on deposit` TRUE TRUE TRUE EQUALS JUST TRUE -- money on deposit standing to the account
#ASSERT `o 27 r 1 "funds" is money, securities or other investments standing or to be placed to the account of the Accountant-General, and includes money placed on deposit` TRUE FALSE FALSE EQUALS NOTHING -- not standing to the account: neither limb is met, and "includes" leaves the definition open
#ASSERT `o 27 r 1 "funds" is money, securities or other investments standing or to be placed to the account of the Accountant-General, and includes money placed on deposit` FALSE TRUE FALSE EQUALS NOTHING -- not money, securities or investments
#ASSERT `o 27 r 1 "funds" is money, securities or other investments standing or to be placed to the account of the Accountant-General, and includes money placed on deposit` FALSE FALSE FALSE EQUALS NOTHING -- neither
#ASSERT `o 27 r 1 "interest" is the dividends and interest on funds` TRUE TRUE EQUALS JUST TRUE -- dividends or interest on funds
#ASSERT `o 27 r 1 "interest" is the dividends and interest on funds` TRUE FALSE EQUALS JUST FALSE -- "means": not dividends or interest
#ASSERT `o 27 r 1 "interest" is the dividends and interest on funds` FALSE TRUE EQUALS JUST FALSE -- "means": not on funds
#ASSERT `o 27 r 1 "interest" is the dividends and interest on funds` FALSE FALSE EQUALS JUST FALSE -- "means": neither
#ASSERT `o 27 r 1 "ledger credit" is the title of the cause or matter and the separate account opened under an order or otherwise` TRUE TRUE EQUALS JUST TRUE -- the title and the separate account
#ASSERT `o 27 r 1 "ledger credit" is the title of the cause or matter and the separate account opened under an order or otherwise` TRUE FALSE EQUALS JUST FALSE -- "means": not the separate account
#ASSERT `o 27 r 1 "ledger credit" is the title of the cause or matter and the separate account opened under an order or otherwise` FALSE TRUE EQUALS JUST FALSE -- "means": not the title of the cause or matter
#ASSERT `o 27 r 1 "ledger credit" is the title of the cause or matter and the separate account opened under an order or otherwise` FALSE FALSE EQUALS JUST FALSE -- "means": neither
#ASSERT `o 27 r 1 "lodge in Court" is to pay or transfer into Court, or deposit in Court` `o 27 r 1 pay into Court` EQUALS JUST TRUE -- pay into Court
#ASSERT `o 27 r 1 "lodge in Court" is to pay or transfer into Court, or deposit in Court` `o 27 r 1 transfer into Court` EQUALS JUST TRUE -- transfer into Court
#ASSERT `o 27 r 1 "lodge in Court" is to pay or transfer into Court, or deposit in Court` `o 27 r 1 deposit in Court` EQUALS JUST TRUE -- deposit in Court
#ASSERT `o 27 r 1 "lodge in Court" is to pay or transfer into Court, or deposit in Court` `o 27 r 1 some other act` EQUALS JUST FALSE -- "means"
#ASSERT `o 27 r 1 "order" is an order or judgment of a Court, whether made in Court or in chambers` TRUE TRUE EQUALS JUST TRUE -- an order or judgment made in Court or in chambers
#ASSERT `o 27 r 1 "order" is an order or judgment of a Court, whether made in Court or in chambers` TRUE FALSE EQUALS JUST FALSE -- "means": not an order or judgment of a Court
#ASSERT `o 27 r 1 "order" is an order or judgment of a Court, whether made in Court or in chambers` FALSE TRUE EQUALS JUST FALSE -- "means": not made in Court or in chambers
#ASSERT `o 27 r 1 "order" is an order or judgment of a Court, whether made in Court or in chambers` FALSE FALSE EQUALS JUST FALSE -- "means": neither

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 2`
-- ---------------------------------------------------------------------------

-- arguments: wishes to pay under section 62; applied by summons; paragraph (2) applies; supported by an affidavit; (a) trust described; (b) persons named; (c) submission; (d) address
#ASSERT `o 27 r 2(1) the trustee has applied by summons supported by an affidavit as required` TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- a summons supported by an affidavit that sets out (a) to (d)
#ASSERT `o 27 r 2(1) the trustee has applied by summons supported by an affidavit as required` FALSE TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING -- not a trustee wishing to pay under section 62: limited by its own wording
#ASSERT `o 27 r 2(1) the trustee has applied by summons supported by an affidavit as required` TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING -- "must apply by summons": silent on what follows
#ASSERT `o 27 r 2(1) the trustee has applied by summons supported by an affidavit as required` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- paragraph (2) applies: no affidavit is needed
#ASSERT `o 27 r 2(1) the trustee has applied by summons supported by an affidavit as required` TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- no affidavit
#ASSERT `o 27 r 2(1) the trustee has applied by summons supported by an affidavit as required` TRUE TRUE FALSE TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING -- (a) missing
#ASSERT `o 27 r 2(1) the trustee has applied by summons supported by an affidavit as required` TRUE TRUE FALSE TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING -- (b) missing
#ASSERT `o 27 r 2(1) the trustee has applied by summons supported by an affidavit as required` TRUE TRUE FALSE TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING -- (c) missing
#ASSERT `o 27 r 2(1) the trustee has applied by summons supported by an affidavit as required` TRUE TRUE FALSE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- (d) missing
-- arguments: the money or securities represent a legacy, or residue or any share of a legacy; a minor or a person resident outside Singapore is absolutely entitled to it
#ASSERT `o 27 r 2(2) paragraph (2) says no affidavit need be filed under paragraph (1)` TRUE TRUE EQUALS JUST TRUE -- a legacy to which a minor or a person resident outside Singapore is absolutely entitled: "no affidavit need be filed"
#ASSERT `o 27 r 2(2) paragraph (2) says no affidavit need be filed under paragraph (1)` TRUE FALSE EQUALS JUST FALSE -- a legacy, but nobody of that kind is absolutely entitled: outside the "Where" (ruling (b))
#ASSERT `o 27 r 2(2) paragraph (2) says no affidavit need be filed under paragraph (1)` FALSE TRUE EQUALS JUST FALSE -- not a legacy: outside the "Where"
#ASSERT `o 27 r 2(2) paragraph (2) says no affidavit need be filed under paragraph (1)` FALSE FALSE EQUALS JUST FALSE -- neither
-- arguments: the trustee wishes to pay into Court under section 62; the money or securities represent a legacy...; a minor or a person resident outside Singapore is absolutely entitled
#ASSERT `o 27 r 2(1) the summons must be supported by an affidavit` TRUE FALSE FALSE EQUALS JUST TRUE -- "any trustee wishing to make a payment into Court under section 62 ... must apply by summons supported by an affidavit"
#ASSERT `o 27 r 2(1) the summons must be supported by an affidavit` TRUE TRUE FALSE EQUALS JUST TRUE -- a legacy, but no minor or person abroad is absolutely entitled: paragraph (2) does not apply
#ASSERT `o 27 r 2(1) the summons must be supported by an affidavit` TRUE TRUE TRUE EQUALS JUST FALSE -- "Subject to paragraph (2)": a legacy to which a minor is absolutely entitled, so "no affidavit need be filed"
#ASSERT `o 27 r 2(1) the summons must be supported by an affidavit` FALSE FALSE FALSE EQUALS NOTHING -- not a trustee wishing to pay under section 62: a scope limit with no "only" (ruling (c))

-- ---------------------------------------------------------------------------
§ `Tests -- Rules 3 and 4`
-- ---------------------------------------------------------------------------

#ASSERT `o 27 r 3 the person who must give notice of the lodgment` EQUALS "the person who has lodged money or securities in Court" -- who gives notice
#ASSERT `o 27 r 3 the persons to whom the notice must be given` EQUALS "every person appearing to be entitled to, or have an interest in, the money or securities lodged" -- to whom
#ASSERT `o 27 r 3 when the notice must be given` EQUALS "forthwith" -- when: the text says "forthwith", a word with no figure to count
#ASSERT `o 27 r 3 the person has given notice of the lodgment` TRUE TRUE EQUALS JUST TRUE -- lodged, and gave notice forthwith
#ASSERT `o 27 r 3 the person has given notice of the lodgment` TRUE FALSE EQUALS NOTHING -- "must forthwith give notice": silent on what follows
#ASSERT `o 27 r 3 the person has given notice of the lodgment` FALSE TRUE EQUALS JUST FALSE -- "Any person who has lodged": did not lodge (ruling (b))
#ASSERT `o 27 r 4(1) the form of the direction to the Accountant-General` EQUALS "Form 44(a)" -- "in Form 44(a)"
#ASSERT `o 27 r 4(1) the money is lodged in Court by means of a direction in the form required` "Form 44(a)" EQUALS JUST TRUE -- Form 44(a)
#ASSERT `o 27 r 4(1) the money is lodged in Court by means of a direction in the form required` "Form 44(b)" EQUALS NOTHING -- another form: silent on what follows
#ASSERT `o 27 r 4(2) the securities may be transferred to the Accountant-General in his or her official name` TRUE TRUE TRUE EQUALS JUST TRUE -- issued by a company, fully paid up and free from liability
#ASSERT `o 27 r 4(2) the securities may be transferred to the Accountant-General in his or her official name` FALSE TRUE TRUE EQUALS NOTHING -- not issued by a company or body corporate under a written law
#ASSERT `o 27 r 4(2) the securities may be transferred to the Accountant-General in his or her official name` TRUE FALSE TRUE EQUALS NOTHING -- not fully paid up
#ASSERT `o 27 r 4(2) the securities may be transferred to the Accountant-General in his or her official name` TRUE TRUE FALSE EQUALS NOTHING -- not free from liability
#ASSERT `o 27 r 4(3) the form of the authority` EQUALS "Form 45" -- "the authority in Form 45"
#ASSERT `o 27 r 4(3) the person lodging has executed and sent the transfer with the authority` TRUE TRUE "Form 45" EQUALS JUST TRUE -- executed, sent to the registered office, with the authority in Form 45
#ASSERT `o 27 r 4(3) the person lodging has executed and sent the transfer with the authority` FALSE TRUE "Form 45" EQUALS NOTHING -- no transfer executed
#ASSERT `o 27 r 4(3) the person lodging has executed and sent the transfer with the authority` TRUE FALSE "Form 45" EQUALS NOTHING -- not sent to the registered office
#ASSERT `o 27 r 4(3) the person lodging has executed and sent the transfer with the authority` TRUE TRUE "Form 44(a)" EQUALS NOTHING -- the authority is not in Form 45
#ASSERT `o 27 r 4(4) the company or body corporate has forwarded the authority with the certificate` TRUE TRUE EQUALS JUST TRUE -- after registering, forwarded with the certificate
#ASSERT `o 27 r 4(4) the company or body corporate has forwarded the authority with the certificate` TRUE FALSE EQUALS NOTHING -- registered but did not forward: "must" is silent on what follows
#ASSERT `o 27 r 4(4) the company or body corporate has forwarded the authority with the certificate` FALSE TRUE EQUALS JUST FALSE -- "after registering such transfer": it did not register
#ASSERT `o 27 r 4(5) the securities may be placed in a box or packet and lodged with the Accountant-General` TRUE TRUE TRUE EQUALS JUST TRUE -- other than those in paragraph (2), in a box or packet, with a direction in the form
#ASSERT `o 27 r 4(5) the securities may be placed in a box or packet and lodged with the Accountant-General` FALSE TRUE TRUE EQUALS NOTHING -- the securities are those described in paragraph (2)
#ASSERT `o 27 r 4(5) the securities may be placed in a box or packet and lodged with the Accountant-General` TRUE FALSE TRUE EQUALS NOTHING -- not in a box or packet
#ASSERT `o 27 r 4(5) the securities may be placed in a box or packet and lodged with the Accountant-General` TRUE TRUE FALSE EQUALS NOTHING -- no direction in the form required
#ASSERT `o 27 r 4(6) the Accountant-General has received the box or packet and given a receipt` TRUE TRUE TRUE EQUALS JUST TRUE -- inspected in the presence of the lodger, marked and secured, received with a receipt
#ASSERT `o 27 r 4(6) the Accountant-General has received the box or packet and given a receipt` FALSE TRUE TRUE EQUALS JUST FALSE -- "After inspecting the contents ... in the presence of the person lodging": not done
#ASSERT `o 27 r 4(6) the Accountant-General has received the box or packet and given a receipt` TRUE FALSE TRUE EQUALS JUST FALSE -- "seeing that such box or packet is properly marked and secured": it is not
#ASSERT `o 27 r 4(6) the Accountant-General has received the box or packet and given a receipt` TRUE TRUE FALSE EQUALS NOTHING -- inspected and secure, but no receipt: silent on what follows
#ASSERT `o 27 r 4(7) the Accountant-General has sent the Registrar a copy of the receipt` TRUE TRUE EQUALS JUST TRUE -- after receiving, sent a copy
#ASSERT `o 27 r 4(7) the Accountant-General has sent the Registrar a copy of the receipt` TRUE FALSE EQUALS NOTHING -- received but did not send: silent on what follows
#ASSERT `o 27 r 4(7) the Accountant-General has sent the Registrar a copy of the receipt` FALSE TRUE EQUALS JUST FALSE -- "after receiving the money or securities": nothing received

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 5`
-- ---------------------------------------------------------------------------

-- arguments: what was received; the credit at the time of receipt of the principal money; the credit at the closing of the transfer books
#ASSERT `o 27 r 5 the credit to which the Accountant-General places the amount in his or her books` `o 27 r 5(a) principal money` "Account A" "Account B" EQUALS JUST "Account A" -- (a): the credit the securities were standing to at the time of the receipt
#ASSERT `o 27 r 5 the credit to which the Accountant-General places the amount in his or her books` `o 27 r 5(b) dividends` "Account A" "Account B" EQUALS JUST "Account B" -- (b): the credit the securities were standing to at the closing of the transfer books
#ASSERT `o 27 r 5 the credit to which the Accountant-General places the amount in his or her books` `o 27 r 5 something else` "Account A" "Account B" EQUALS NOTHING -- limited by its own wording: principal money or dividends

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 6`
-- ---------------------------------------------------------------------------

#ASSERT `o 27 r 6 the deposit threshold` EQUALS 30000 -- "$30,000"
-- arguments: the answers of Order 9 Rule 17, Order 14 and Order 33 (other parts); as security for costs
#ASSERT `o 27 r 6(1)(a) the money is paid into Court under Order 9, Rule 17, Order 14 or Order 33, or as security for costs` (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE -- none of the four
#ASSERT `o 27 r 6(1)(a) the money is paid into Court under Order 9, Rule 17, Order 14 or Order 33, or as security for costs` (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE -- Order 9, Rule 17
#ASSERT `o 27 r 6(1)(a) the money is paid into Court under Order 9, Rule 17, Order 14 or Order 33, or as security for costs` (JUST FALSE) (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST TRUE -- Order 14
#ASSERT `o 27 r 6(1)(a) the money is paid into Court under Order 9, Rule 17, Order 14 or Order 33, or as security for costs` (JUST FALSE) (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST TRUE -- Order 33
#ASSERT `o 27 r 6(1)(a) the money is paid into Court under Order 9, Rule 17, Order 14 or Order 33, or as security for costs` (JUST FALSE) (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST TRUE -- as security for costs
#ASSERT `o 27 r 6(1)(a) the money is paid into Court under Order 9, Rule 17, Order 14 or Order 33, or as security for costs` NOTHING (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING -- Order 9, Rule 17 is in another part's range
#ASSERT `o 27 r 6(1)(a) the money is paid into Court under Order 9, Rule 17, Order 14 or Order 33, or as security for costs` (JUST FALSE) NOTHING (JUST FALSE) FALSE EQUALS NOTHING -- Order 14 is in another part's range
#ASSERT `o 27 r 6(1)(a) the money is paid into Court under Order 9, Rule 17, Order 14 or Order 33, or as security for costs` (JUST FALSE) (JUST FALSE) NOTHING FALSE EQUALS NOTHING -- Order 33 is in another part's range
#ASSERT `o 27 r 6(1)(a) the money is paid into Court under Order 9, Rule 17, Order 14 or Order 33, or as security for costs` NOTHING NOTHING NOTHING TRUE EQUALS JUST TRUE -- security for costs settles it whatever the other parts say
#ASSERT `o 27 r 6(1)(a) the money is paid into Court under Order 9, Rule 17, Order 14 or Order 33, or as security for costs` NOTHING (JUST TRUE) NOTHING FALSE EQUALS JUST TRUE -- Order 14 settles it whatever the other parts say
-- arguments: the amount; the answers of Order 9 Rule 17, Order 14 and Order 33; as security for costs
#ASSERT `o 27 r 6(1) the money lodged in Court is deemed to be placed on deposit and is credited with interest` 30000 (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST TRUE -- $30,000 exactly is not "less than $30,000"
#ASSERT `o 27 r 6(1) the money lodged in Court is deemed to be placed on deposit and is credited with interest` 29999 (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE -- less than $30,000: "except ... (b)"
#ASSERT `o 27 r 6(1) the money lodged in Court is deemed to be placed on deposit and is credited with interest` 100000 (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE -- Order 9, Rule 17: "except (a)"
#ASSERT `o 27 r 6(1) the money lodged in Court is deemed to be placed on deposit and is credited with interest` 100000 (JUST FALSE) (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE -- Order 14
#ASSERT `o 27 r 6(1) the money lodged in Court is deemed to be placed on deposit and is credited with interest` 100000 (JUST FALSE) (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST FALSE -- Order 33
#ASSERT `o 27 r 6(1) the money lodged in Court is deemed to be placed on deposit and is credited with interest` 100000 (JUST FALSE) (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST FALSE -- as security for costs
#ASSERT `o 27 r 6(1) the money lodged in Court is deemed to be placed on deposit and is credited with interest` 100000 NOTHING (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING -- whether Order 9 Rule 17 applies is not known
#ASSERT `o 27 r 6(1) the money lodged in Court is deemed to be placed on deposit and is credited with interest` 29999 NOTHING NOTHING NOTHING FALSE EQUALS JUST FALSE -- under $30,000 whatever the other parts say
-- arguments: fixed by the Minister for Finance; the rate; the highest rate obtainable by the Government on current account from any bank
#ASSERT `o 27 r 6(1) the rate of interest credited is one the Rule allows` TRUE 2.5 3 EQUALS JUST TRUE -- fixed by the Minister, below the highest rate
#ASSERT `o 27 r 6(1) the rate of interest credited is one the Rule allows` TRUE 3 3 EQUALS JUST TRUE -- equal to the highest rate: "not being greater than"
#ASSERT `o 27 r 6(1) the rate of interest credited is one the Rule allows` TRUE 3.5 3 EQUALS JUST FALSE -- greater than the highest rate
#ASSERT `o 27 r 6(1) the rate of interest credited is one the Rule allows` FALSE 2.5 3 EQUALS NOTHING -- not fixed by the Minister: silent
#ASSERT `o 27 r 6(1) the rate of interest credited is one the Rule allows` FALSE 3.5 3 EQUALS JUST FALSE -- greater than the highest rate, whoever fixed it
#ASSERT `o 27 r 6(2) the money is deemed not to be placed on deposit` 29999 EQUALS JUST TRUE -- reduced below $30,000
#ASSERT `o 27 r 6(2) the money is deemed not to be placed on deposit` 30000 EQUALS JUST FALSE -- $30,000 is not below $30,000 (ruling (b))
#ASSERT `o 27 r 6(2) the money is deemed not to be placed on deposit` 50000 EQUALS JUST FALSE -- above

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 7`
-- ---------------------------------------------------------------------------

#ASSERT `o 27 r 7(1) interest on money on deposit may be computed on the amount` 100 EQUALS NOTHING -- a whole number of dollars: the paragraph is a prohibition and says nothing positive
#ASSERT `o 27 r 7(1) interest on money on deposit may be computed on the amount` 100.5 EQUALS JUST FALSE -- "must not be computed on a fraction of $1"
#ASSERT `o 27 r 7(1) interest on money on deposit may be computed on the amount` 0.25 EQUALS JUST FALSE -- a fraction of $1
#ASSERT `o 27 r 7(2) interest on money on deposit is computed by the period` `o 27 r 7(2) a calendar month` EQUALS JUST TRUE -- "accrues by calendar months"
#ASSERT `o 27 r 7(2) interest on money on deposit is computed by the period` `o 27 r 7(2) a period less than a calendar month` EQUALS JUST FALSE -- "must not be computed by any less period"
#ASSERT `o 27 r 7(2) interest on money on deposit is computed by the period` `o 27 r 7(2) a period longer than a calendar month` EQUALS NOTHING -- silent on a longer period
#ASSERT `o 27 r 7(3) the first day on which interest begins` (Date 15 3 2026) EQUALS Date 1 4 2026 -- placed in March: the first day of the next month, April
#ASSERT `o 27 r 7(3) the first day on which interest begins` (Date 1 1 2026) EQUALS Date 1 2 2026 -- placed on the first day of January: still the month "next succeeding that in which the money is placed", February
#ASSERT `o 27 r 7(3) the first day on which interest begins` (Date 31 12 2026) EQUALS Date 1 1 2027 -- placed in December: January of the next year
#ASSERT `o 27 r 7(3) the first day on which interest begins` (Date 31 1 2026) EQUALS Date 1 2 2026 -- placed on the last day of January
#ASSERT `o 27 r 7(3) the day from which interest ceases` (Date 15 3 2026) EQUALS Date 28 2 2026 -- withdrawn in March: the last day of February
#ASSERT `o 27 r 7(3) the day from which interest ceases` (Date 2 1 2026) EQUALS Date 31 12 2025 -- withdrawn in January: the last day of December
#ASSERT `o 27 r 7(3) the day from which interest ceases` (Date 10 3 2024) EQUALS Date 29 2 2024 -- withdrawn in March of a leap year
#ASSERT `o 27 r 7(3) the day from which interest ceases` (Date 1 3 2026) EQUALS Date 28 2 2026 -- withdrawn on the first day of March
#ASSERT `o 27 r 7(4) fifteen days after the end of the year`'s `period length` EQUALS 15 -- "on or before 15 days thereafter following"
#ASSERT `o 27 r 7(4) the day the 15 days run from` 2025 EQUALS Date 31 12 2025 -- "the year ending on 31 December"
#ASSERT `o 27 r 7(4) the interest for the year is placed to the credit on or before 15 days after the year ends` (Date 10 1 2026) (Date 15 1 2026) EQUALS JUST TRUE -- inside the 15 days
#ASSERT `o 27 r 7(4) the interest for the year is placed to the credit on or before 15 days after the year ends` (Date 15 1 2026) (Date 15 1 2026) EQUALS JUST TRUE -- the last day
#ASSERT `o 27 r 7(4) the interest for the year is placed to the credit on or before 15 days after the year ends` (Date 16 1 2026) (Date 15 1 2026) EQUALS JUST FALSE -- one day late (ruling (a))
#ASSERT `o 27 r 7(5) the interest accrued and not credited is placed to the credit to which the money is then standing` TRUE TRUE EQUALS JUST TRUE -- withdrawn, and the interest placed to the credit
#ASSERT `o 27 r 7(5) the interest accrued and not credited is placed to the credit to which the money is then standing` TRUE FALSE EQUALS NOTHING -- withdrawn but not placed: silent on what follows
#ASSERT `o 27 r 7(5) the interest accrued and not credited is placed to the credit to which the money is then standing` FALSE TRUE EQUALS JUST FALSE -- "When money on deposit is withdrawn": it was not (ruling (b))
-- arguments: sums placed at different times; an order dealing with the money and part has to be withdrawn; the part is the part last placed and remaining; the order otherwise directs
#ASSERT `o 27 r 7(6) the part is treated as withdrawn for the purpose of computing interest` TRUE TRUE TRUE FALSE EQUALS JUST TRUE -- the part last placed and remaining, and the order is silent
#ASSERT `o 27 r 7(6) the part is treated as withdrawn for the purpose of computing interest` TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- "unless the order otherwise directs"
#ASSERT `o 27 r 7(6) the part is treated as withdrawn for the purpose of computing interest` TRUE TRUE FALSE FALSE EQUALS NOTHING -- a part that was not the last placed: the treatment is limited by its own wording
#ASSERT `o 27 r 7(6) the part is treated as withdrawn for the purpose of computing interest` FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- "When money on deposit consists of sums ... placed on deposit at different times": it does not (ruling (b))
#ASSERT `o 27 r 7(6) the part is treated as withdrawn for the purpose of computing interest` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- no order dealing with the money (ruling (b))
#ASSERT `o 27 r 7(7) the interest credited is placed on deposit` 30000 FALSE EQUALS JUST TRUE -- $30,000 exactly: "amounts to or exceeds $30,000"
#ASSERT `o 27 r 7(7) the interest credited is placed on deposit` 45000 FALSE EQUALS JUST TRUE -- exceeds
#ASSERT `o 27 r 7(7) the interest credited is placed on deposit` 29999 FALSE EQUALS JUST FALSE -- below $30,000 (ruling (b))
#ASSERT `o 27 r 7(7) the interest credited is placed on deposit` 45000 TRUE EQUALS JUST FALSE -- "Unless otherwise directed by an order"
#ASSERT `o 27 r 7(7) the day the interest is treated as placed on deposit` (Date 31 12 2025) EQUALS Date 31 12 2025 -- "the last yearly day on which any such interest became due"

-- ---------------------------------------------------------------------------
§ `Tests -- Rules 8 and 9`
-- ---------------------------------------------------------------------------

#ASSERT `o 27 r 8 the form of the direction to the Accountant-General` EQUALS "Form 44(b)" -- "in Form 44(b)"
#ASSERT `o 27 r 8 the money is paid out on a direction in the form required` "Form 44(b)" EQUALS JUST TRUE -- Form 44(b)
#ASSERT `o 27 r 8 the money is paid out on a direction in the form required` "Form 44(a)" EQUALS NOTHING -- another form: silent on what follows
-- arguments: the order directs funds out; it states in full the name of every payee; the name is to be stated in a certificate of the Registrar
#ASSERT `o 27 r 9(1) the order states the name of every payee` TRUE TRUE FALSE EQUALS JUST TRUE -- the names stated in full
#ASSERT `o 27 r 9(1) the order states the name of every payee` TRUE FALSE TRUE EQUALS JUST TRUE -- "unless the name is to be stated in a certificate of the Registrar"
#ASSERT `o 27 r 9(1) the order states the name of every payee` TRUE FALSE FALSE EQUALS NOTHING -- "must state": silent on what follows
#ASSERT `o 27 r 9(1) the order states the name of every payee` FALSE TRUE FALSE EQUALS NOTHING -- an order that does not direct funds out: limited by its own wording
#ASSERT `o 27 r 9(2) it is sufficient for the order to state the business name of the firm` TRUE TRUE EQUALS JUST TRUE -- a firm, and its business name is stated
#ASSERT `o 27 r 9(2) it is sufficient for the order to state the business name of the firm` TRUE FALSE EQUALS NOTHING -- a firm, the business name not stated
#ASSERT `o 27 r 9(2) it is sufficient for the order to state the business name of the firm` FALSE TRUE EQUALS JUST FALSE -- not a firm: "In the case of payment to a firm" read as "where" (ruling (b); assumed)
#ASSERT `o 27 r 9(3) the money may be paid to the payee` TRUE `o 27 r 9(3) any one or more of the co-partners` EQUALS JUST TRUE -- any one or more of the co-partners
#ASSERT `o 27 r 9(3) the money may be paid to the payee` TRUE `o 27 r 9(3) the survivor of them` EQUALS JUST TRUE -- the survivor
#ASSERT `o 27 r 9(3) the money may be paid to the payee` TRUE `o 27 r 9(3) someone else` EQUALS NOTHING -- limited by its own wording
#ASSERT `o 27 r 9(3) the money may be paid to the payee` FALSE `o 27 r 9(3) any one or more of the co-partners` EQUALS NOTHING -- not described as co-partners

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 10`
-- ---------------------------------------------------------------------------

-- arguments: an order directs the funds to a named or described person; proof of the death; the death on or after the date of the order; a creditor and the death before the order; the order otherwise directs
#ASSERT `o 27 r 10(1) the funds may be paid, transferred or delivered to the legal personal representatives of the deceased person or to the survivor or survivors of them` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- (a): the death on or after the date of the order
#ASSERT `o 27 r 10(1) the funds may be paid, transferred or delivered to the legal personal representatives of the deceased person or to the survivor or survivors of them` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- (b): a creditor, the death before the order
#ASSERT `o 27 r 10(1) the funds may be paid, transferred or delivered to the legal personal representatives of the deceased person or to the survivor or survivors of them` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING -- death before the order and not a creditor: limited by its own wording
#ASSERT `o 27 r 10(1) the funds may be paid, transferred or delivered to the legal personal representatives of the deceased person or to the survivor or survivors of them` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE -- no proof of the death: "on proof of the death of that person", read as "upon" (ruling (b))
#ASSERT `o 27 r 10(1) the funds may be paid, transferred or delivered to the legal personal representatives of the deceased person or to the survivor or survivors of them` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- "unless the order otherwise directs"
#ASSERT `o 27 r 10(1) the funds may be paid, transferred or delivered to the legal personal representatives of the deceased person or to the survivor or survivors of them` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- "When funds in Court are by an order directed to be paid ... to any person named or described": they are not (ruling (b))
#ASSERT `o 27 r 10(2) paragraph (1) applies to the order` TRUE FALSE EQUALS JUST FALSE -- (a): a trustee, executor or administrator
#ASSERT `o 27 r 10(2) paragraph (1) applies to the order` FALSE TRUE EQUALS JUST FALSE -- (b): otherwise than in his or her own right
#ASSERT `o 27 r 10(2) paragraph (1) applies to the order` TRUE TRUE EQUALS JUST FALSE -- both
#ASSERT `o 27 r 10(2) paragraph (1) applies to the order` FALSE FALSE EQUALS NOTHING -- neither: the paragraph takes out two kinds of order and says nothing of when paragraph (1) applies
#ASSERT `o 27 r 10(3) the asset ceiling` EQUALS 10000 -- "$10,000"
#ASSERT `o 27 r 10(3) the form of the declaration` EQUALS "Form 46" -- "Form 46"
-- arguments: no administration taken out; died intestate; the assets including the funds; the relation; entitled to take administration; the form of the declaration
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` TRUE TRUE 10000 `o 27 r 10(3) widow` TRUE "Form 46" EQUALS JUST TRUE -- assets of exactly $10,000: "do not exceed"
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` TRUE TRUE 9000 `o 27 r 10(3) widower` TRUE "Form 46" EQUALS JUST TRUE -- a widower
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` TRUE TRUE 9000 `o 27 r 10(3) child` TRUE "Form 46" EQUALS JUST TRUE -- a child
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` TRUE TRUE 9000 `o 27 r 10(3) father` TRUE "Form 46" EQUALS JUST TRUE -- a father
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` TRUE TRUE 9000 `o 27 r 10(3) mother` TRUE "Form 46" EQUALS JUST TRUE -- a mother
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` TRUE TRUE 9000 `o 27 r 10(3) brother` TRUE "Form 46" EQUALS JUST TRUE -- a brother
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` TRUE TRUE 9000 `o 27 r 10(3) sister` TRUE "Form 46" EQUALS JUST TRUE -- a sister
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` TRUE TRUE 10001 `o 27 r 10(3) widow` TRUE "Form 46" EQUALS JUST FALSE -- assets of $10,001 exceed the ceiling
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` FALSE TRUE 9000 `o 27 r 10(3) widow` TRUE "Form 46" EQUALS JUST FALSE -- "If no administration has been taken out": it has
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` TRUE FALSE 9000 `o 27 r 10(3) widow` TRUE "Form 46" EQUALS JUST FALSE -- "who has died intestate": he or she did not
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` TRUE TRUE 9000 `o 27 r 10(3) some other relation` TRUE "Form 46" EQUALS NOTHING -- a relation not listed: limited by its own wording
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` TRUE TRUE 9000 `o 27 r 10(3) widow` FALSE "Form 46" EQUALS NOTHING -- not entitled to take administration
#ASSERT `o 27 r 10(3) the funds may be paid, transferred or delivered to the person upon a declaration` TRUE TRUE 9000 `o 27 r 10(3) widow` TRUE "Form 45" EQUALS JUST FALSE -- "upon a declaration by such person in accordance with Form 46": it is not (ruling (b), "upon")
#ASSERT `o 27 r 10(4) the funds may be paid, transferred or delivered to the survivor or survivors` TRUE TRUE EQUALS JUST TRUE -- legal personal representatives, one of whom died
#ASSERT `o 27 r 10(4) the funds may be paid, transferred or delivered to the survivor or survivors` TRUE FALSE EQUALS JUST FALSE -- no proof of death: "upon proof of the death of any such representatives" (ruling (b), "upon")
#ASSERT `o 27 r 10(4) the funds may be paid, transferred or delivered to the survivor or survivors` FALSE TRUE EQUALS JUST FALSE -- "When funds in Court are ... directed to be paid ... to any persons as legal personal representatives": not so (ruling (b))
#ASSERT `o 27 r 10(5) notice of the application has been given to the Commissioner of Estate Duty` TRUE TRUE EQUALS JUST TRUE -- an application under paragraph (1) or (4), notice given
#ASSERT `o 27 r 10(5) notice of the application has been given to the Commissioner of Estate Duty` TRUE FALSE EQUALS NOTHING -- "must be given": silent on what follows
#ASSERT `o 27 r 10(5) notice of the application has been given to the Commissioner of Estate Duty` FALSE TRUE EQUALS JUST FALSE -- "When any application for an order mentioned in paragraphs (1) and (4) is made": none (ruling (b))

-- ---------------------------------------------------------------------------
§ `Tests -- Rules 11 to 14`
-- ---------------------------------------------------------------------------

#ASSERT `o 27 r 11(1) the party who must lodge a copy of the order with the Accountant-General` EQUALS "the party having the carriage of the order" -- who lodges the copy
#ASSERT `o 27 r 11(1) the party having the carriage of the order has lodged a copy with the Accountant-General` TRUE TRUE EQUALS JUST TRUE -- transfer or carry over directed, copy lodged
#ASSERT `o 27 r 11(1) the party having the carriage of the order has lodged a copy with the Accountant-General` TRUE FALSE EQUALS NOTHING -- not lodged: silent on what follows
#ASSERT `o 27 r 11(1) the party having the carriage of the order has lodged a copy with the Accountant-General` FALSE TRUE EQUALS JUST FALSE -- "When funds in Court are by an order directed to be transferred or carried over": not so (ruling (b))
#ASSERT `o 27 r 11(2) the party having the carriage of the order has lodged a copy with the Accountant-General` TRUE TRUE EQUALS JUST TRUE -- investment directed, copy lodged
#ASSERT `o 27 r 11(2) the party having the carriage of the order has lodged a copy with the Accountant-General` TRUE FALSE EQUALS NOTHING -- not lodged: silent on what follows
#ASSERT `o 27 r 11(2) the party having the carriage of the order has lodged a copy with the Accountant-General` FALSE TRUE EQUALS JUST FALSE -- "When funds in Court are by an order directed to be invested": not so (ruling (b))
-- arguments: the answers of Order 9 Rule 17, Order 14, Order 33; as security for costs; the investment is in trustee securities
#ASSERT `o 27 r 11(3) the Court may direct that the money in Court be invested in trustee securities` (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE TRUE EQUALS JUST TRUE -- money not excepted, invested in trustee securities
#ASSERT `o 27 r 11(3) the Court may direct that the money in Court be invested in trustee securities` (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE FALSE EQUALS NOTHING -- not in trustee securities: limited by its own wording
#ASSERT `o 27 r 11(3) the Court may direct that the money in Court be invested in trustee securities` (JUST TRUE) (JUST FALSE) (JUST FALSE) FALSE TRUE EQUALS NOTHING -- Order 9, Rule 17 money is excepted: the power is limited by its own wording
#ASSERT `o 27 r 11(3) the Court may direct that the money in Court be invested in trustee securities` (JUST FALSE) (JUST TRUE) (JUST FALSE) FALSE TRUE EQUALS NOTHING -- Order 14 money is excepted
#ASSERT `o 27 r 11(3) the Court may direct that the money in Court be invested in trustee securities` (JUST FALSE) (JUST FALSE) (JUST TRUE) FALSE TRUE EQUALS NOTHING -- Order 33 money is excepted (paragraph (4) deals with it)
#ASSERT `o 27 r 11(3) the Court may direct that the money in Court be invested in trustee securities` (JUST FALSE) (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS NOTHING -- security for costs is excepted
#ASSERT `o 27 r 11(3) the Court may direct that the money in Court be invested in trustee securities` NOTHING (JUST FALSE) (JUST FALSE) FALSE TRUE EQUALS NOTHING -- whether Order 9 Rule 17 applies is not known
#ASSERT `o 27 r 11(4) the amount the money must exceed` EQUALS 250000 -- "$250,000"
-- arguments: the answer of Order 33; the amount at the time of the order; with a bank or finance company in Singapore to earn interest
#ASSERT `o 27 r 11(4) the Court may direct that the money in Court be placed on deposit` (JUST TRUE) 250001 TRUE EQUALS JUST TRUE -- Order 33 money exceeding $250,000, on deposit to earn interest
#ASSERT `o 27 r 11(4) the Court may direct that the money in Court be placed on deposit` (JUST TRUE) 250000 TRUE EQUALS JUST FALSE -- exactly $250,000 does not exceed it: "but only if ... it exceeds the sum of $250,000"
#ASSERT `o 27 r 11(4) the Court may direct that the money in Court be placed on deposit` (JUST TRUE) 249999 TRUE EQUALS JUST FALSE -- below
#ASSERT `o 27 r 11(4) the Court may direct that the money in Court be placed on deposit` (JUST TRUE) 250001 FALSE EQUALS NOTHING -- not on deposit with a bank or finance company in Singapore to earn interest
#ASSERT `o 27 r 11(4) the Court may direct that the money in Court be placed on deposit` (JUST FALSE) 250001 TRUE EQUALS NOTHING -- not Order 33 money: the paragraph is about money in Court under Order 33
#ASSERT `o 27 r 11(4) the Court may direct that the money in Court be placed on deposit` NOTHING 250001 TRUE EQUALS NOTHING -- whether it is Order 33 money is not known
#ASSERT `o 27 r 11(5) the application was served on the Sheriff` TRUE TRUE EQUALS JUST TRUE -- an application under paragraph (4), served
#ASSERT `o 27 r 11(5) the application was served on the Sheriff` TRUE FALSE EQUALS NOTHING -- "must be served": silent on what follows
#ASSERT `o 27 r 11(5) the application was served on the Sheriff` FALSE TRUE EQUALS NOTHING -- not an application under paragraph (4)
#ASSERT `o 27 r 12 the Accountant-General must issue a certificate of the amount and description of the funds` TRUE FALSE EQUALS JUST TRUE -- a request by a person claiming to be interested, and no good reason for refusing
#ASSERT `o 27 r 12 the Accountant-General must issue a certificate of the amount and description of the funds` TRUE TRUE EQUALS JUST FALSE -- "unless there is good reason for refusing"
#ASSERT `o 27 r 12 the Accountant-General must issue a certificate of the amount and description of the funds` FALSE FALSE EQUALS JUST FALSE -- "upon a request": there was none (ruling (b))
#ASSERT `o 27 r 13 the list is published in the Gazette in the month of January` (Date 1 1 2027) EQUALS JUST TRUE -- 1 January
#ASSERT `o 27 r 13 the list is published in the Gazette in the month of January` (Date 15 1 2027) EQUALS JUST TRUE -- 15 January
#ASSERT `o 27 r 13 the list is published in the Gazette in the month of January` (Date 31 1 2027) EQUALS JUST TRUE -- 31 January
#ASSERT `o 27 r 13 the list is published in the Gazette in the month of January` (Date 31 12 2026) EQUALS JUST FALSE -- 31 December is not in January (ruling (a))
#ASSERT `o 27 r 13 the list is published in the Gazette in the month of January` (Date 1 2 2027) EQUALS JUST FALSE -- 1 February is not in January
#ASSERT `o 27 r 13 the number of years` EQUALS 4 -- "4 years or more"
#ASSERT `o 27 r 13 the account is one the list must include` 4 EQUALS JUST TRUE -- exactly 4 years: "4 years or more"
#ASSERT `o 27 r 13 the account is one the list must include` 10 EQUALS JUST TRUE -- more than 4 years
#ASSERT `o 27 r 13 the account is one the list must include` 3 EQUALS NOTHING -- less than 4 years: a scope limit with no "only" (ruling (c))
#ASSERT `o 27 r 13 the list gives what the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE -- the title and number of the cause or matter, the ledger credit title and the balance
#ASSERT `o 27 r 13 the list gives what the Rule requires` FALSE TRUE TRUE EQUALS NOTHING -- no title and number: "must give" is silent on what follows
#ASSERT `o 27 r 13 the list gives what the Rule requires` TRUE FALSE TRUE EQUALS NOTHING -- no ledger credit title
#ASSERT `o 27 r 13 the list gives what the Rule requires` TRUE TRUE FALSE EQUALS NOTHING -- no balance
#ASSERT `o 27 r 14(1) the number of years` EQUALS 6 -- "6 years and upwards"
#ASSERT `o 27 r 14(1) the funds must be transferred and paid to the Government for the general purposes of the State` 6 FALSE EQUALS JUST TRUE -- exactly 6 years, no claim allowed
#ASSERT `o 27 r 14(1) the funds must be transferred and paid to the Government for the general purposes of the State` 10 FALSE EQUALS JUST TRUE -- more than 6 years, no claim allowed
#ASSERT `o 27 r 14(1) the funds must be transferred and paid to the Government for the general purposes of the State` 5 FALSE EQUALS JUST FALSE -- less than 6 years (ruling (a))
#ASSERT `o 27 r 14(1) the funds must be transferred and paid to the Government for the general purposes of the State` 6 TRUE EQUALS JUST FALSE -- "without any claim having been made and allowed"
-- arguments: a claim is made; established to the satisfaction of the Court; the principal transferred and paid; the part that appears due to the claimant
#ASSERT `o 27 r 14(2) the amount the Government must pay the claimant` TRUE TRUE 1000 800 EQUALS 800 -- "so much of the amount of the principal as appears to be due to the claimant"
#ASSERT `o 27 r 14(2) the amount the Government must pay the claimant` TRUE TRUE 1000 1000 EQUALS 1000 -- all of the principal
#ASSERT `o 27 r 14(2) the amount the Government must pay the claimant` TRUE TRUE 1000 1200 EQUALS 1000 -- no more than the principal transferred
#ASSERT `o 27 r 14(2) the amount the Government must pay the claimant` TRUE FALSE 1000 800 EQUALS 0 -- "if such claim is established": it is not
#ASSERT `o 27 r 14(2) the amount the Government must pay the claimant` FALSE TRUE 1000 800 EQUALS 0 -- no claim
#ASSERT `o 27 r 14(2) the Government must pay the claimant` TRUE TRUE EQUALS JUST TRUE -- a claim is made and established to the satisfaction of the Court
#ASSERT `o 27 r 14(2) the Government must pay the claimant` TRUE FALSE EQUALS JUST FALSE -- "if such claim is established": it is not
#ASSERT `o 27 r 14(2) the Government must pay the claimant` FALSE TRUE EQUALS JUST FALSE -- "If any claim is made": none
-- The Rule gives the principal and no interest: no function for interest on the principal repaid (see NOTES.md).
-- arguments: a minor's funds; the minor has come of age or died (ruling (d) of 2026-11-05: the bar as its own yes/no question)
#ASSERT `o 27 r 14(3) the transfer of the minor's funds under this Rule is barred` TRUE FALSE EQUALS JUST TRUE -- before the minor comes of age or dies: the bar is in force
#ASSERT `o 27 r 14(3) the transfer of the minor's funds under this Rule is barred` TRUE TRUE EQUALS JUST FALSE -- after: "until such minor comes of age or dies", the bar has ended
#ASSERT `o 27 r 14(3) the transfer of the minor's funds under this Rule is barred` FALSE FALSE EQUALS NOTHING -- not a minor's funds: the bar is on those funds
#ASSERT `o 27 r 14(3) the transfer of the minor's funds under this Rule is barred` FALSE TRUE EQUALS NOTHING -- not a minor's funds
#ASSERT `o 27 r 14(3) this Rule authorises the transfer of the funds` TRUE FALSE EQUALS JUST FALSE -- a minor's funds before the minor comes of age or dies: "Nothing in this Rule authorises"
#ASSERT `o 27 r 14(3) this Rule authorises the transfer of the funds` TRUE TRUE EQUALS NOTHING -- after that: the paragraph is silent
#ASSERT `o 27 r 14(3) this Rule authorises the transfer of the funds` FALSE FALSE EQUALS NOTHING -- not a minor's funds: limited by its own wording

-- ---------------------------------------------------------------------------
§ `Tests -- Rules 15 to 21`
-- ---------------------------------------------------------------------------

#ASSERT `o 27 r 15(1) the Sheriff keeps an account of all sums of money paid to, deposited with and paid out by him or her` TRUE TRUE EQUALS JUST TRUE -- the account of sums received and sums paid out
#ASSERT `o 27 r 15(1) the Sheriff keeps an account of all sums of money paid to, deposited with and paid out by him or her` TRUE FALSE EQUALS NOTHING -- no record of payments out: "must keep" is silent on what follows
#ASSERT `o 27 r 15(1) the Sheriff keeps an account of all sums of money paid to, deposited with and paid out by him or her` FALSE TRUE EQUALS NOTHING -- no record of sums received
#ASSERT `o 27 r 15(2) the money paid to or deposited with the Sheriff is kept in the place` `o 27 r 15(2) in a bank` EQUALS JUST TRUE -- in a bank
#ASSERT `o 27 r 15(2) the money paid to or deposited with the Sheriff is kept in the place` `o 27 r 15(2) with the Accountant-General` EQUALS JUST TRUE -- with the Accountant-General
#ASSERT `o 27 r 15(2) the money paid to or deposited with the Sheriff is kept in the place` `o 27 r 15(2) somewhere else` EQUALS NOTHING -- "must be kept in a bank or with the Accountant‑General": silent on what follows
#ASSERT `o 27 r 15(3) interest is payable in respect of the money` TRUE EQUALS JUST FALSE -- "No interest is payable"
#ASSERT `o 27 r 15(3) interest is payable in respect of the money` FALSE EQUALS NOTHING -- limited by its own wording
#ASSERT `o 27 r 16 the Registry officer has acknowledged the money with a receipt` TRUE TRUE EQUALS JUST TRUE -- acknowledged with a receipt on payment
#ASSERT `o 27 r 16 the Registry officer has acknowledged the money with a receipt` TRUE FALSE EQUALS NOTHING -- "must be acknowledged": silent on what follows
#ASSERT `o 27 r 16 the Registry officer has acknowledged the money with a receipt` FALSE TRUE EQUALS NOTHING -- money not paid to the Sheriff under these Rules or an order: limited by its own wording
#ASSERT `o 27 r 17 the person making the payment has produced a copy and given notice` TRUE TRUE TRUE EQUALS JUST TRUE -- (a) and (b)
#ASSERT `o 27 r 17 the person making the payment has produced a copy and given notice` TRUE FALSE TRUE EQUALS NOTHING -- (a) missing: silent on what follows
#ASSERT `o 27 r 17 the person making the payment has produced a copy and given notice` TRUE TRUE FALSE EQUALS NOTHING -- (b) missing
#ASSERT `o 27 r 17 the person making the payment has produced a copy and given notice` FALSE TRUE TRUE EQUALS JUST FALSE -- "When any payment is made under a judgment or order": none (ruling (b))
#ASSERT `o 27 r 18 the Sheriff has required proof that the person applying is entitled or authorised to receive the money` TRUE TRUE EQUALS JUST TRUE -- proof required before payment
#ASSERT `o 27 r 18 the Sheriff has required proof that the person applying is entitled or authorised to receive the money` TRUE FALSE EQUALS NOTHING -- "must require proof": silent on what follows
#ASSERT `o 27 r 18 the Sheriff has required proof that the person applying is entitled or authorised to receive the money` FALSE TRUE EQUALS JUST FALSE -- no payment out: "Before any money is paid out" read as "when" (ruling (b); assumed)
#ASSERT `o 27 r 19 the Sheriff has satisfied himself or herself that the money due to the Government has been paid or deducted` TRUE TRUE EQUALS JUST TRUE -- satisfied before paying out
#ASSERT `o 27 r 19 the Sheriff has satisfied himself or herself that the money due to the Government has been paid or deducted` TRUE FALSE EQUALS NOTHING -- "must satisfy himself or herself": silent on what follows
#ASSERT `o 27 r 19 the Sheriff has satisfied himself or herself that the money due to the Government has been paid or deducted` FALSE TRUE EQUALS JUST FALSE -- no payment out under an order: "Before any money is paid out" read as "when" (ruling (b); assumed)
#ASSERT `o 27 r 20 the office that approves the method of payment by the Sheriff` EQUALS "the Registrar" -- who approves the method
#ASSERT `o 27 r 20 the payment by the Sheriff is made by a method approved by the Registrar` TRUE TRUE EQUALS JUST TRUE -- an approved method
#ASSERT `o 27 r 20 the payment by the Sheriff is made by a method approved by the Registrar` TRUE FALSE EQUALS NOTHING -- not an approved method: silent on what follows
#ASSERT `o 27 r 20 the payment by the Sheriff is made by a method approved by the Registrar` FALSE TRUE EQUALS NOTHING -- not a payment by the Sheriff: limited by its own wording
-- arguments: a judgment or order in the State Courts for payment by instalments; the Court orders the instalments paid otherwise than in Court; the account was opened
#ASSERT `o 27 r 21 the Registrar has caused the instalments ledger to be opened` TRUE FALSE TRUE EQUALS JUST TRUE -- an instalments order in the State Courts, the account opened
#ASSERT `o 27 r 21 the Registrar has caused the instalments ledger to be opened` TRUE FALSE FALSE EQUALS NOTHING -- the account not opened: silent on what follows
#ASSERT `o 27 r 21 the Registrar has caused the instalments ledger to be opened` TRUE TRUE FALSE EQUALS JUST FALSE -- "unless the Court orders that the instalments must be paid otherwise than in Court"
#ASSERT `o 27 r 21 the Registrar has caused the instalments ledger to be opened` FALSE FALSE TRUE EQUALS JUST FALSE -- "Whenever a judgment or order has been made in the State Courts for payment of money by instalments": none (ruling (b))

-- ---------------------------------------------------------------------------
§ `Tests -- the duties as regulative rules (traces, not assertions)`
-- ---------------------------------------------------------------------------

-- A #TRACE prints its result and counts as no assertion on this binary; the decision functions that say the same thing are asserted above.
-- The result each should print is written beside it, from the text.
-- expected: FULFILLED -- the lodger gives notice (O 27 r 3)
#TRACE `o 27 r 3 the person who lodged must give notice of the lodgment` AT 0 WITH
    PARTY `o 27 the person who lodged money or securities in Court` DOES `o 27 r 3 give notice of the lodgment` AT 1
-- expected: FULFILLED -- the interest is placed to the credit on day 15, the last day (O 27 r 7(4))
#TRACE `o 27 r 7(4) the Accountant-General must place the interest for the year to the credit within 15 days` AT 0 WITH
    PARTY `o 27 the Accountant-General` DOES `o 27 r 7(4) place the interest for the year to the credit` AT 15
-- expected: BREACH -- nothing is done by day 16
#TRACE `o 27 r 7(4) the Accountant-General must place the interest for the year to the credit within 15 days` AT 0 WITH
    (WAITUNTIL 16)
-- expected: FULFILLED -- the payer produces the copy and gives notice (O 27 r 17)
#TRACE `o 27 r 17 the person making the payment must produce a copy and give notice` AT 0 WITH
    PARTY `o 27 the person making a payment under a judgment or order` DOES `o 27 r 17 produce a copy of the judgment or order and give notice to the person entitled` AT 2
