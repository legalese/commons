#ASSERT `o 21 r 6(4) the Court may direct or authorise the Attorney-General to attend and take part` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 21 r 6(4) the Court may direct or authorise the Attorney-General to attend and take part` FALSE TRUE EQUALS JUST FALSE
