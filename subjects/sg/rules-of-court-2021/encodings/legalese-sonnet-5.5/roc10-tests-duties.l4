IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc10-order-46a`
IMPORT `roc10-order-52`
IMPORT `roc10-order-53`
IMPORT `roc10-order-54`
IMPORT `roc10-order-55`

-- Rules of Court 2021 (Singapore): TESTS pairing the regulative rules in roc10-duties.l4 with their decision functions.
-- `#ASSERT` on a DEONTIC value is not supported by the main binary, so roc10-duties.l4 records each #TRACE outcome beside the trace
-- and this file asserts the decision-function twin of the same facts.
-- The pairing: a stated period that ran out is BREACH in the trace and JUST FALSE in the twin; a duty that is done is FULFILLED in the
-- trace and JUST TRUE in the twin; a duty with no stated time that is not yet done is a residual obligation in the trace and NOTHING in the twin.
-- Every expected value is worked out by hand from the text and the dates are counted under O 3 r 3 (lines 323 to 329).

-- O 46A r 2(b) (line 6145): "within 14 days after the date on which the action is placed on the Express Track".
-- Placed on 1 June 2026: the 14 days begin on 2 June and end on 15 June 2026 (O 3 r 3(3)); 15 June is a Monday.
-- Trace day 14 is 15 June; trace day 15 is 16 June.
#ASSERT `o 46A r 2(b) the list and copies are served as required` FALSE TRUE TRUE (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- trace: served AT 14: FULFILLED
#ASSERT `o 46A r 2(b) the list and copies are served as required` FALSE TRUE TRUE (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- trace: not served by day 15: BREACH

-- O 52 r 2(3) (line 6502): "at least 2 clear days before the day fixed for the hearing".
-- Hearing fixed for 10 July 2026: the clear days are 8 and 9 July if service is on 7 July, so 7 July is the last day.
-- Trace day 7 is 7 July; trace day 8 is 8 July (only 9 July intervenes).
#ASSERT `o 52 r 2(3) the written notice has been served in time` TRUE TRUE TRUE FALSE (Date 7 7 2026) (Date 7 7 2026) EQUALS JUST TRUE -- trace: served AT 7: FULFILLED
#ASSERT `o 52 r 2(3) the written notice has been served in time` TRUE TRUE TRUE FALSE (Date 8 7 2026) (Date 7 7 2026) EQUALS JUST FALSE -- trace: served AT 8: BREACH

-- O 53 r 21(3) and (4) (lines 6681 to 6685): no time is stated for either, so the traces have no WITHIN.
#ASSERT `o 53 r 21(3) the affidavit of service has been made as it must be` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- trace 1: the affidavit made AT 3
#ASSERT `o 53 r 21(4) the Registrar has issued the certificate or the statement to the Attorney-General as the Registrar must` TRUE TRUE EQUALS JUST TRUE -- trace 1: issued AT 6: FULFILLED
#ASSERT `o 53 r 21(4) the Registrar has issued the certificate or the statement to the Attorney-General as the Registrar must` TRUE FALSE EQUALS NOTHING -- trace 2: tendered and not issued: the obligation is residual, the text states no consequence

-- O 55 r 5 (lines 6718 to 6721): the examiner must send the deposition; no time is stated.
-- The Registrar's two steps, (a) and (b), are asserted in roc10-tests-order-55.l4.
#ASSERT `o 55 r 5 the examiner has sent the deposition to the Registrar as the examiner must` TRUE FALSE TRUE EQUALS JUST TRUE -- trace: sent AT 1
#ASSERT `o 55 r 5 the examiner has sent the deposition to the Registrar as the examiner must` TRUE FALSE FALSE EQUALS NOTHING -- not yet sent: residual obligation, no consequence stated

-- O 54 r 2(3) (line 6694): the officer must administer the oath; no time is stated.
#ASSERT `o 54 r 2(3) the officer has administered the oath as the officer must` TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- trace: administered AT 0
#ASSERT `o 54 r 2(3) the officer has administered the oath as the officer must` TRUE FALSE FALSE FALSE EQUALS NOTHING -- not administered: a bare "must"
