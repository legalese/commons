IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc2-order-9a`

-- Tests for Order 9, Rules 1 to 9 (roc2-order-9a.l4).  Every expected value is written from the text of the
-- Rule, beside the assertion, before the run; none is copied from the encoding's own output.
-- One #ASSERT per line.  A made-up "last day" stands in for the answer of O 3 r 3 (roc1).

-- ---------------------------------------------------------------------------
-- Rule 1(1): 8 weeks (served in Singapore) or 12 weeks (served out of Singapore) after issue
-- ---------------------------------------------------------------------------
#ASSERT (`o 9 r 1(1) the period before the case conference` `Served in Singapore`)'s `period length` EQUALS 8 -- (a): 8 weeks
#ASSERT (`o 9 r 1(1) the period before the case conference` `Served out of Singapore`)'s `period length` EQUALS 12 -- (b): 12 weeks
#ASSERT (`o 9 r 1(1) the period before the case conference` `Served in Singapore`)'s `period unit` EQUALS Weeks -- weeks
#ASSERT `o 9 r 1(1)(a) eight weeks`'s `period direction` EQUALS `After the anchor` -- "8 weeks after"
#ASSERT `o 9 r 1(1)(b) twelve weeks`'s `period direction` EQUALS `After the anchor` -- "12 weeks after"
#ASSERT `o 9 r 1(1) the day on which the case conference is to be held` `Served in Singapore` (Date 1 3 2027) EQUALS Date 26 4 2027 -- 1 March 2027 + 56 days: 30 days to 31 March, 26 more
#ASSERT `o 9 r 1(1) the day on which the case conference is to be held` `Served out of Singapore` (Date 1 3 2027) EQUALS Date 24 5 2027 -- 1 March 2027 + 84 days: 30 to 31 March, 30 to 30 April, 24 more
#ASSERT `o 9 r 1(1) the case conference is held at the time stated in paragraph (1)` `Served in Singapore` (Date 1 3 2027) (Date 26 4 2027) EQUALS JUST TRUE -- held on the 56th day after issue
#ASSERT `o 9 r 1(1) the case conference is held at the time stated in paragraph (1)` `Served in Singapore` (Date 1 3 2027) (Date 27 4 2027) EQUALS JUST FALSE -- held a day later than 8 weeks
#ASSERT `o 9 r 1(1) the case conference is held at the time stated in paragraph (1)` `Served out of Singapore` (Date 1 3 2027) (Date 26 4 2027) EQUALS JUST FALSE -- 8 weeks is the Singapore time; out of Singapore it is 12 weeks
#ASSERT `o 9 r 1(1) the case conference is held at the time stated in paragraph (1)` `Served out of Singapore` (Date 1 3 2027) (Date 24 5 2027) EQUALS JUST TRUE -- held on the 84th day

-- Rule 1(2): earlier or later, at a party's request or on the Court's own accord
#ASSERT `o 9 r 1(2) the Court may hold a case conference earlier or later than the time stated in paragraph (1)` TRUE FALSE EQUALS JUST TRUE -- at the request of a party
#ASSERT `o 9 r 1(2) the Court may hold a case conference earlier or later than the time stated in paragraph (1)` FALSE TRUE EQUALS JUST TRUE -- on its own accord
#ASSERT `o 9 r 1(2) the Court may hold a case conference earlier or later than the time stated in paragraph (1)` FALSE FALSE EQUALS NOTHING -- neither request nor own accord: limited by its own wording

-- Rule 1(3): any stage, including appeals, as many as the Court thinks appropriate
#ASSERT `o 9 r 1(3) the Court may hold a case conference at this stage of the proceedings` `o 9 r 1(3) before trial` TRUE EQUALS JUST TRUE -- "at any stage"
#ASSERT `o 9 r 1(3) the Court may hold a case conference at this stage of the proceedings` `o 9 r 1(3) at trial` TRUE EQUALS JUST TRUE -- "at any stage"
#ASSERT `o 9 r 1(3) the Court may hold a case conference at this stage of the proceedings` `o 9 r 1(3) after judgment` TRUE EQUALS JUST TRUE -- "at any stage"
#ASSERT `o 9 r 1(3) the Court may hold a case conference at this stage of the proceedings` `o 9 r 1(3) on appeal` TRUE EQUALS JUST TRUE -- "including appeals"
#ASSERT `o 9 r 1(3) the Court may hold a case conference at this stage of the proceedings` `o 9 r 1(3) on appeal` FALSE EQUALS NOTHING -- the Court does not think another conference appropriate

-- Rule 1(4): the Registrar, as a general rule; referral to the assigned Judge or, if none, any Judge
#ASSERT `o 9 r 1(4) who conducts the case conference` FALSE EQUALS `The Registrar` -- "the Registrar is to conduct the case conference"
#ASSERT `o 9 r 1(4) who conducts the case conference` TRUE EQUALS `A Judge` -- the matter was referred to a Judge
#ASSERT `o 9 r 1(4) the Registrar may refer a matter at any time to` TRUE EQUALS `o 9 r 1(4) the assigned Judge in that action` -- "to the assigned Judge in that action"
#ASSERT `o 9 r 1(4) the Registrar may refer a matter at any time to` FALSE EQUALS `o 9 r 1(4) any Judge` -- "or, if there is none, to any Judge"

-- Rule 1(5): the powers in the Order at any stage, including appeals
#ASSERT `o 9 r 1(5) the Court may exercise the powers in Order 9 at this stage of the proceedings` `o 9 r 1(3) before trial` EQUALS JUST TRUE -- "at any stage"
#ASSERT `o 9 r 1(5) the Court may exercise the powers in Order 9 at this stage of the proceedings` `o 9 r 1(3) at trial` EQUALS JUST TRUE -- "at any stage"
#ASSERT `o 9 r 1(5) the Court may exercise the powers in Order 9 at this stage of the proceedings` `o 9 r 1(3) after judgment` EQUALS JUST TRUE -- "at any stage"
#ASSERT `o 9 r 1(5) the Court may exercise the powers in Order 9 at this stage of the proceedings` `o 9 r 1(3) on appeal` EQUALS JUST TRUE -- "including appeals"

-- The seam answered for O 1 r 3(1) "case conference"
#ASSERT `o 9 r 1 the meeting is a case conference as described` TRUE FALSE FALSE EQUALS JUST TRUE -- held at the time in paragraph (1)
#ASSERT `o 9 r 1 the meeting is a case conference as described` FALSE TRUE FALSE EQUALS JUST TRUE -- held earlier or later under paragraph (2)
#ASSERT `o 9 r 1 the meeting is a case conference as described` FALSE FALSE TRUE EQUALS JUST TRUE -- held under paragraph (3)
#ASSERT `o 9 r 1 the meeting is a case conference as described` FALSE FALSE FALSE EQUALS NOTHING -- a meeting Rule 1 does not describe: undefined term
-- the keel's function takes this answer as its input (text line 93: "means a case conference as described in Order 9, Rule 1")
#ASSERT `o 1 r 3(1) a meeting is a case conference` (`o 9 r 1 the meeting is a case conference as described` TRUE FALSE FALSE) EQUALS JUST TRUE -- the wiring the lead makes at the merge

-- ---------------------------------------------------------------------------
-- Rule 2: the Court takes control, sets the timelines and gives directions at a case conference
-- ---------------------------------------------------------------------------
#ASSERT `o 9 r 2 the Court is to do this` `o 9 r 2 take control of the proceedings` TRUE EQUALS JUST TRUE -- "take control of"
#ASSERT `o 9 r 2 the Court is to do this` `o 9 r 2 set the timelines` TRUE EQUALS JUST TRUE -- "set the timelines"
#ASSERT `o 9 r 2 the Court is to do this` `o 9 r 2 give directions for the proceedings` TRUE EQUALS JUST TRUE -- "give directions for the proceedings"
#ASSERT `o 9 r 2 the Court is to do this` `o 9 r 2 set the timelines` FALSE EQUALS NOTHING -- not at a case conference: "At a case conference" limits the duty

-- ---------------------------------------------------------------------------
-- Rule 3: non-disclosure
-- ---------------------------------------------------------------------------
#ASSERT `o 9 r 3 the communication may be disclosed to the Court conducting the trial` FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- (a): a party stated it "confidential"
#ASSERT `o 9 r 3 the communication may be disclosed to the Court conducting the trial` FALSE TRUE FALSE TRUE EQUALS JUST FALSE -- (b): marked by the Registrar or Judge
#ASSERT `o 9 r 3 the communication may be disclosed to the Court conducting the trial` FALSE TRUE FALSE FALSE EQUALS NOTHING -- neither stated nor marked: the prohibition does not reach it
#ASSERT `o 9 r 3 the communication may be disclosed to the Court conducting the trial` FALSE FALSE TRUE TRUE EQUALS NOTHING -- not made in the course of a case conference
#ASSERT `o 9 r 3 the communication may be disclosed to the Court conducting the trial` TRUE TRUE TRUE FALSE EQUALS NOTHING -- "Subject to the law governing the admissibility of evidence at trial"

-- ---------------------------------------------------------------------------
-- Rule 4: absence of parties
-- ---------------------------------------------------------------------------
#ASSERT `o 9 r 4(1) the Court may dismiss the action` TRUE FALSE EQUALS JUST TRUE -- no party attends
#ASSERT `o 9 r 4(1) the Court may dismiss the action` FALSE TRUE EQUALS JUST TRUE -- the claimant is absent
#ASSERT `o 9 r 4(1) the Court may dismiss the action` FALSE FALSE EQUALS JUST FALSE -- the claimant attends: the "If" fails
#ASSERT `o 9 r 4(2) the Court may give judgment for the claimant` TRUE TRUE TRUE EQUALS JUST TRUE -- claimant attends, defendant absent, proof of service
#ASSERT `o 9 r 4(2) the Court may give judgment for the claimant` TRUE TRUE FALSE EQUALS JUST FALSE -- no proof of service: "upon proof of service" is read as "where", so JUST FALSE (ruling of 2026-11-05)
#ASSERT `o 9 r 4(2) the Court may give judgment for the claimant` FALSE TRUE TRUE EQUALS JUST FALSE -- the claimant is not there: the "If" fails
#ASSERT `o 9 r 4(2) the Court may give judgment for the claimant` TRUE FALSE TRUE EQUALS JUST FALSE -- the defendant attends: the "If" fails
#ASSERT `o 9 r 4(3) the Court may set aside or vary the dismissal or default judgment` TRUE TRUE EQUALS JUST TRUE -- proof of valid reasons
#ASSERT `o 9 r 4(3) the Court may set aside or vary the dismissal or default judgment` TRUE FALSE EQUALS JUST FALSE -- no proof: "on proof that" is read as the same condition as "upon proof of service" (fork F-O9-6), so JUST FALSE
#ASSERT `o 9 r 4(3) the Court may set aside or vary the dismissal or default judgment` FALSE TRUE EQUALS NOTHING -- a different dismissal or judgment: scope limit without "only"

-- ---------------------------------------------------------------------------
-- Rule 5: failure to serve originating process
-- ---------------------------------------------------------------------------
#ASSERT `o 9 r 5(1)(a) the Court may dismiss the action` TRUE TRUE TRUE EQUALS JUST TRUE -- (a): claimant attends, has not served, the Court is not satisfied
#ASSERT `o 9 r 5(1)(a) the Court may dismiss the action` TRUE TRUE FALSE EQUALS JUST FALSE -- the Court is satisfied that reasonable steps were taken: "if it is not satisfied" fails
#ASSERT `o 9 r 5(1)(a) the Court may dismiss the action` TRUE FALSE TRUE EQUALS JUST FALSE -- the claimant has served
#ASSERT `o 9 r 5(1)(a) the Court may dismiss the action` FALSE TRUE TRUE EQUALS JUST FALSE -- the claimant does not attend
#ASSERT `o 9 r 5(1)(b) the Court may make this order` TRUE TRUE `o 9 r 5(1)(b) fix a second case conference` FALSE EQUALS JUST TRUE -- (b): "may fix a second case conference"
#ASSERT `o 9 r 5(1)(b) the Court may make this order` TRUE TRUE `o 9 r 5(1)(b)(i) order the claimant to serve the originating process within 14 days after the first case conference` FALSE EQUALS JUST TRUE -- (b)(i)
#ASSERT `o 9 r 5(1)(b) the Court may make this order` TRUE TRUE `o 9 r 5(1)(b)(ii) order the claimant to apply for substituted service within that time` FALSE EQUALS JUST TRUE -- (b)(ii)
#ASSERT `o 9 r 5(1)(b) the Court may make this order` TRUE TRUE `o 9 r 5(1)(b) extend the validity of the originating process` TRUE EQUALS JUST TRUE -- "extend the validity ... if necessary": necessary
#ASSERT `o 9 r 5(1)(b) the Court may make this order` TRUE TRUE `o 9 r 5(1)(b) extend the validity of the originating process` FALSE EQUALS JUST FALSE -- not necessary: "if necessary" fails
#ASSERT `o 9 r 5(1)(b) the Court may make this order` FALSE TRUE `o 9 r 5(1)(b) fix a second case conference` FALSE EQUALS JUST FALSE -- the claimant does not attend
#ASSERT `o 9 r 5(1)(b) the Court may make this order` TRUE FALSE `o 9 r 5(1)(b) fix a second case conference` FALSE EQUALS JUST FALSE -- the claimant has served
#ASSERT `o 9 r 5(1)(b)(i) the originating process is served within 14 days after the first case conference` (Date 14 5 2027) (Date 14 5 2027) EQUALS JUST TRUE -- served on the last day
#ASSERT `o 9 r 5(1)(b)(i) the originating process is served within 14 days after the first case conference` (Date 15 5 2027) (Date 14 5 2027) EQUALS JUST FALSE -- served a day late
#ASSERT `o 9 r 5(1)(b)(i) the originating process is served within 14 days after the first case conference` (Date 3 5 2027) (Date 14 5 2027) EQUALS JUST TRUE -- served early
#ASSERT `o 9 r 5(1)(b)(i) fourteen days`'s `period length` EQUALS 14 -- "within 14 days"
#ASSERT `o 9 r 5(1)(b)(ii) the application for substituted service is made within that time` (Date 14 5 2027) (Date 14 5 2027) EQUALS JUST TRUE -- applied on the last day
#ASSERT `o 9 r 5(1)(b)(ii) the application for substituted service is made within that time` (Date 17 5 2027) (Date 14 5 2027) EQUALS JUST FALSE -- applied after the time
#ASSERT `o 9 r 5(2) the Court may dismiss the action` TRUE EQUALS JUST TRUE -- the claimant fails to serve by the second case conference
#ASSERT `o 9 r 5(2) the Court may dismiss the action` FALSE EQUALS JUST FALSE -- the claimant served in time: the "If" fails

-- the duty of (b)(i) as a regulative rule: traced here (main cannot #ASSERT a DEONTIC value; the function above is what is asserted)
#TRACE `o 9 r 5(1)(b)(i) the claimant must serve the originating process` AT 0 WITH
    PARTY `o 9 r 5(1)(b) the claimant` DOES `o 9 r 5(1)(b)(i) serve the originating process` AT 10
#TRACE `o 9 r 5(1)(b)(i) the claimant must serve the originating process` AT 0 WITH
    (WAITUNTIL 15)

-- ---------------------------------------------------------------------------
-- Rule 6: failure to file and serve defence in originating claim
-- ---------------------------------------------------------------------------
#ASSERT `o 9 r 6(1) the Court may enter judgment against the defendant in default of a defence` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- all four conditions
#ASSERT `o 9 r 6(1) the Court may enter judgment against the defendant in default of a defence` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- not an originating claim
#ASSERT `o 9 r 6(1) the Court may enter judgment against the defendant in default of a defence` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- a party does not attend
#ASSERT `o 9 r 6(1) the Court may enter judgment against the defendant in default of a defence` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- a defence was served by the first case conference
#ASSERT `o 9 r 6(1) the Court may enter judgment against the defendant in default of a defence` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- the time for the defence has not expired
#ASSERT `o 9 r 6(2) the Court may set aside or vary the default judgment` TRUE EQUALS JUST TRUE -- "such a default judgment"
#ASSERT `o 9 r 6(2) the Court may set aside or vary the default judgment` FALSE EQUALS NOTHING -- another judgment: scope limit without "only"
#ASSERT `o 9 r 6(3) the Court may extend time for the defendant to serve the defence after the first case conference` TRUE EQUALS JUST TRUE -- "in a special case"
#ASSERT `o 9 r 6(3) the Court may extend time for the defendant to serve the defence after the first case conference` FALSE EQUALS NOTHING -- not a special case
#ASSERT `o 9 r 6(3) the defendant is deemed not to have served a defence` TRUE TRUE EQUALS JUST TRUE -- time extended, not served in it: "failing which"
#ASSERT `o 9 r 6(3) the defendant is deemed not to have served a defence` TRUE FALSE EQUALS JUST FALSE -- served in the extended time
#ASSERT `o 9 r 6(3) the defendant is deemed not to have served a defence` FALSE TRUE EQUALS JUST FALSE -- time was not extended
#ASSERT `o 9 r 6(3) the claimant is entitled to judgment under paragraph (1)` TRUE TRUE EQUALS JUST TRUE -- "the claimant is entitled to judgment under paragraph (1)"
#ASSERT `o 9 r 6(3) the claimant is entitled to judgment under paragraph (1)` TRUE FALSE EQUALS JUST FALSE -- served in time
#ASSERT `o 9 r 6(4) this Rule applies with the necessary modifications` TRUE EQUALS JUST TRUE -- "a claimant's default to serve a defence to the defendant's counterclaim"
#ASSERT `o 9 r 6(4) this Rule applies with the necessary modifications` FALSE EQUALS NOTHING -- another default: scope limit without "only"

-- ---------------------------------------------------------------------------
-- Rule 7: challenges to jurisdiction
-- ---------------------------------------------------------------------------
#ASSERT `o 9 r 7(1) the Court must first deal with any objection to its jurisdiction` TRUE TRUE FALSE EQUALS JUST TRUE -- (a): both attend, a defence filed and served in an originating claim
#ASSERT `o 9 r 7(1) the Court must first deal with any objection to its jurisdiction` TRUE FALSE TRUE EQUALS JUST TRUE -- (b): both attend, the defendant's affidavit filed and served in an originating application
#ASSERT `o 9 r 7(1) the Court must first deal with any objection to its jurisdiction` TRUE FALSE FALSE EQUALS JUST FALSE -- neither a defence nor an affidavit has been filed and served
#ASSERT `o 9 r 7(1) the Court must first deal with any objection to its jurisdiction` FALSE TRUE FALSE EQUALS JUST FALSE -- a party does not attend
#ASSERT `o 9 r 7(2) the Court must give this direction` TRUE `o 9 r 7(2)(a) direct the defendant to file and serve the application and affidavit within 14 days after the date of the case conference` FALSE EQUALS JUST TRUE -- (a)
#ASSERT `o 9 r 7(2) the Court must give this direction` TRUE `o 9 r 7(2)(b) direct the claimant to file and serve any affidavit in reply within 14 days thereafter` FALSE EQUALS JUST TRUE -- (b)
#ASSERT `o 9 r 7(2) the Court must give this direction` TRUE `o 9 r 7(2)(c) fix the hearing of the application no later than 14 days after all affidavits have been filed and served` FALSE EQUALS JUST TRUE -- (c) when the Court does not order otherwise
#ASSERT `o 9 r 7(2) the Court must give this direction` TRUE `o 9 r 7(2)(c) fix the hearing of the application no later than 14 days after all affidavits have been filed and served` TRUE EQUALS JUST FALSE -- (c) "unless the Court otherwise orders"
#ASSERT `o 9 r 7(2) the Court must give this direction` FALSE `o 9 r 7(2)(a) direct the defendant to file and serve the application and affidavit within 14 days after the date of the case conference` FALSE EQUALS JUST FALSE -- the defendant is not challenging the jurisdiction
#ASSERT `o 9 r 7(2)(a) the defendant files and serves the application and affidavit in time` (Date 14 5 2027) (Date 14 5 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `o 9 r 7(2)(a) the defendant files and serves the application and affidavit in time` (Date 15 5 2027) (Date 14 5 2027) EQUALS JUST FALSE -- a day late
#ASSERT `o 9 r 7(2)(b) the claimant files and serves the affidavit in reply in time` (Date 28 5 2027) (Date 28 5 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `o 9 r 7(2)(b) the claimant files and serves the affidavit in reply in time` (Date 31 5 2027) (Date 28 5 2027) EQUALS JUST FALSE -- late
#ASSERT `o 9 r 7(2)(b) a further affidavit may be filed` TRUE TRUE EQUALS JUST TRUE -- with the Court's approval
#ASSERT `o 9 r 7(2)(b) a further affidavit may be filed` TRUE FALSE EQUALS JUST FALSE -- "no further affidavits ... without the Court's approval"
#ASSERT `o 9 r 7(2)(b) a further affidavit may be filed` FALSE FALSE EQUALS NOTHING -- no further affidavit is in question
#ASSERT `o 9 r 7(2)(c) the hearing is fixed within 14 days after all affidavits have been filed and served` (Date 11 6 2027) (Date 11 6 2027) EQUALS JUST TRUE -- fixed for the last day
#ASSERT `o 9 r 7(2)(c) the hearing is fixed within 14 days after all affidavits have been filed and served` (Date 12 6 2027) (Date 11 6 2027) EQUALS JUST FALSE -- fixed for a later day
#ASSERT `o 9 r 7(2)(a) fourteen days`'s `period length` EQUALS 14 -- "within 14 days"
#ASSERT `o 9 r 7(2)(b) fourteen days thereafter`'s `period length` EQUALS 14 -- "within 14 days thereafter"
#ASSERT `o 9 r 7(2)(c) fourteen days after all affidavits have been filed and served`'s `period length` EQUALS 14 -- "no later than 14 days after"
#TRACE `o 9 r 7(2)(a) the defendant must file and serve the application` AT 0 WITH
    PARTY `o 9 r 7(2)(a) the defendant` DOES `o 9 r 7(2)(a) file and serve the application with supporting affidavit` AT 14
#TRACE `o 9 r 7(2)(a) the defendant must file and serve the application` AT 0 WITH
    (WAITUNTIL 15)

-- ---------------------------------------------------------------------------
-- Rule 8: affidavits of evidence-in-chief
-- ---------------------------------------------------------------------------
#ASSERT `o 9 r 8(1) the Court may order the parties to file and serve lists of witnesses and affidavits of evidence-in-chief` TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- jurisdiction application dealt with, pleadings filed, no exchange yet
#ASSERT `o 9 r 8(1) the Court may order the parties to file and serve lists of witnesses and affidavits of evidence-in-chief` FALSE TRUE TRUE FALSE EQUALS JUST TRUE -- "where there is no challenge to the jurisdiction"
#ASSERT `o 9 r 8(1) the Court may order the parties to file and serve lists of witnesses and affidavits of evidence-in-chief` FALSE FALSE TRUE FALSE EQUALS JUST FALSE -- a challenge pending and not dealt with
#ASSERT `o 9 r 8(1) the Court may order the parties to file and serve lists of witnesses and affidavits of evidence-in-chief` TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- pleadings not yet filed and served
#ASSERT `o 9 r 8(1) the Court may order the parties to file and serve lists of witnesses and affidavits of evidence-in-chief` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- documents already exchanged: "before any exchange of documents"
#ASSERT `o 9 r 8(2) the Court proceeds to consider the matters in Rule 9` FALSE EQUALS JUST TRUE -- "Where the Court does not exercise its power under paragraph (1)"
#ASSERT `o 9 r 8(2) the Court proceeds to consider the matters in Rule 9` TRUE EQUALS JUST FALSE -- the Court exercised the power: the "Where" fails

-- ---------------------------------------------------------------------------
-- Rule 9: single application pending trial
-- ---------------------------------------------------------------------------
#ASSERT `o 9 r 9(1) the Court must consider all matters necessary to bring the proceedings to a conclusion` TRUE FALSE EQUALS JUST TRUE -- after the parties notify compliance
#ASSERT `o 9 r 9(1) the Court must consider all matters necessary to bring the proceedings to a conclusion` FALSE TRUE EQUALS JUST TRUE -- the Court does not exercise its power under Rule 8(1)
#ASSERT `o 9 r 9(1) the Court must consider all matters necessary to bring the proceedings to a conclusion` FALSE FALSE EQUALS JUST FALSE -- neither
#ASSERT `o 9 r 9(2) the Court must order a single application pending trial to be made by each of the parties` TRUE EQUALS JUST TRUE -- possible
#ASSERT `o 9 r 9(2) the Court must order a single application pending trial to be made by each of the parties` FALSE EQUALS NOTHING -- "As far as possible"
#ASSERT `o 9 r 9(3) the single application must deal with the matter` TRUE EQUALS JUST TRUE -- necessary for the case to proceed expeditiously
#ASSERT `o 9 r 9(3) the single application must deal with the matter` FALSE EQUALS NOTHING -- not necessary: the text speaks only of "all matters that are necessary"
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(a) addition or removal of parties` EQUALS JUST TRUE -- (a)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(b) consolidation of actions` EQUALS JUST TRUE -- (b)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(c) division of issues at trial to be heard separately` EQUALS JUST TRUE -- (c)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(d) security for costs` EQUALS JUST TRUE -- (d)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(e) further and better particulars of pleadings` EQUALS JUST TRUE -- (e)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(f) amendment of pleadings` EQUALS JUST TRUE -- (f)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(g) filing of further pleadings` EQUALS JUST TRUE -- (g)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(h) striking out of part of an action or of the defence` EQUALS JUST TRUE -- (h)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(i) judgment on admission of facts` EQUALS JUST TRUE -- (i)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(j) determination of questions of law or construction of documents` EQUALS JUST TRUE -- (j)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(k) production of documents` EQUALS JUST TRUE -- (k)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(l) interim relief` EQUALS JUST TRUE -- (l)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(m) expert evidence and assessors` EQUALS JUST TRUE -- (m)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(n) independent witness and interested non-parties` EQUALS JUST TRUE -- (n)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4)(o) independent counsel` EQUALS JUST TRUE -- (o)
#ASSERT `o 9 r 9(4) the matter is one the single application deals with` `o 9 r 9(4) any other matter` EQUALS NOTHING -- "include": a list that is not closed
#ASSERT `o 9 r 9(5) twenty-one days`'s `period length` EQUALS 21 -- "within 21 days"
#ASSERT `o 9 r 9(5) the Court must order this party to file and serve within 21 days` `o 9 r 9(5) the applying party` EQUALS JUST TRUE -- "the applying party"
#ASSERT `o 9 r 9(5) the Court must order this party to file and serve within 21 days` `o 9 r 9(5) the other party` EQUALS JUST TRUE -- "the other party to file and serve an affidavit in reply within 21 days thereafter"
#ASSERT `o 9 r 9(5) the party files and serves in time` `o 9 r 9(5) the applying party` (Date 17 5 2027) (Date 17 5 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `o 9 r 9(5) the party files and serves in time` `o 9 r 9(5) the other party` (Date 8 6 2027) (Date 7 6 2027) EQUALS JUST FALSE -- a day after the last day
#ASSERT `o 9 r 9(6) the Court may order written submissions to be filed with a bundle of authorities` TRUE EQUALS JUST TRUE -- "if appropriate"
#ASSERT `o 9 r 9(6) the Court may order written submissions to be filed with a bundle of authorities` FALSE EQUALS JUST FALSE -- "if appropriate" fails
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(a) an injunction or a search order, with any incidental matter` FALSE FALSE EQUALS JUST TRUE -- (a) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(b) substituted service` FALSE FALSE EQUALS JUST TRUE -- (b) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(c) service out of Singapore` FALSE FALSE EQUALS JUST TRUE -- (c) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(d) setting aside service of an originating process` FALSE FALSE EQUALS JUST TRUE -- (d) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(e) judgment in default of a notice of intention to contest or not contest an originating claim` FALSE FALSE EQUALS JUST TRUE -- (e) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(f) judgment in default of defence` FALSE FALSE EQUALS JUST TRUE -- (f) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(g) summary judgment` FALSE FALSE EQUALS JUST TRUE -- (g) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(h) striking out of the whole of an action or defence` FALSE FALSE EQUALS JUST TRUE -- (h) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(i) stay of the whole action` FALSE FALSE EQUALS JUST TRUE -- (i) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(j) stay of enforcement of a judgment or order` FALSE FALSE EQUALS JUST TRUE -- (j) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(k) an enforcement order` FALSE FALSE EQUALS JUST TRUE -- (k) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(l) permission to appeal` FALSE FALSE EQUALS JUST TRUE -- (l) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(m) transfer of proceedings under the State Courts Act` FALSE FALSE EQUALS JUST TRUE -- (m) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(n) setting aside third party proceedings` FALSE FALSE EQUALS JUST TRUE -- (n) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7)(o) permission to make an application for a committal order` FALSE FALSE EQUALS JUST TRUE -- (o) excepted
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7) any other kind of application` TRUE FALSE EQUALS JUST TRUE -- directed at the case conference
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7) any other kind of application` FALSE TRUE EQUALS JUST TRUE -- with the Court's approval
#ASSERT `o 9 r 9(7) an application may be taken out` `o 9 r 9(7) any other kind of application` FALSE FALSE EQUALS JUST FALSE -- "No application may be taken out ... other than as directed ... or with the Court's approval"
#ASSERT `o 9 r 9(8) the approval is sought as required` TRUE TRUE TRUE EQUALS JUST TRUE -- by letter, essence, reasons
#ASSERT `o 9 r 9(8) the approval is sought as required` FALSE TRUE TRUE EQUALS JUST FALSE -- not by letter
#ASSERT `o 9 r 9(8) the approval is sought as required` TRUE FALSE TRUE EQUALS JUST FALSE -- the essence is not set out
#ASSERT `o 9 r 9(8) the approval is sought as required` TRUE TRUE FALSE EQUALS JUST FALSE -- the reasons are not set out
#ASSERT `o 9 r 9(9) the Court may deal with the request in this way` TRUE `o 9 r 9(9) deal with the request summarily` EQUALS JUST TRUE -- "deal with the request by letter summarily"
#ASSERT `o 9 r 9(9) the Court may deal with the request in this way` TRUE `o 9 r 9(9) fix a case conference to deal with the matter` EQUALS JUST TRUE -- "or fix a case conference"
#ASSERT `o 9 r 9(9) the Court may deal with the request in this way` FALSE `o 9 r 9(9) deal with the request summarily` EQUALS NOTHING -- a request not made by letter
#ASSERT `o 9 r 9(10) fourteen days before the commencement of the trial`'s `period direction` EQUALS `Before the anchor` -- "14 days before the commencement of the trial"
#ASSERT `o 9 r 9(10) an application may be taken out` (Date 14 6 2027) (Date 10 6 2027) FALSE TRUE TRUE EQUALS JUST TRUE -- in the period, a special case with the trial Judge's approval
#ASSERT `o 9 r 9(10) an application may be taken out` (Date 14 6 2027) (Date 10 6 2027) FALSE TRUE FALSE EQUALS JUST FALSE -- in the period, a special case but no approval
#ASSERT `o 9 r 9(10) an application may be taken out` (Date 14 6 2027) (Date 10 6 2027) FALSE FALSE TRUE EQUALS JUST FALSE -- in the period, not a special case
#ASSERT `o 9 r 9(10) an application may be taken out` (Date 10 6 2027) (Date 10 6 2027) FALSE FALSE FALSE EQUALS JUST FALSE -- the first day of the period
#ASSERT `o 9 r 9(10) an application may be taken out` (Date 9 6 2027) (Date 10 6 2027) FALSE FALSE FALSE EQUALS NOTHING -- the day before the period starts
#ASSERT `o 9 r 9(10) an application may be taken out` (Date 20 6 2027) (Date 10 6 2027) TRUE FALSE FALSE EQUALS NOTHING -- after the Court has determined the merits the period has ended
#ASSERT `o 9 r 9(11) the trial Judge's approval is sought as required` TRUE TRUE TRUE EQUALS JUST TRUE -- by letter, essence, explaining the special case
#ASSERT `o 9 r 9(11) the trial Judge's approval is sought as required` FALSE TRUE TRUE EQUALS JUST FALSE -- not by letter
#ASSERT `o 9 r 9(11) the trial Judge's approval is sought as required` TRUE FALSE TRUE EQUALS JUST FALSE -- the essence is not set out
#ASSERT `o 9 r 9(11) the trial Judge's approval is sought as required` TRUE TRUE FALSE EQUALS JUST FALSE -- no explanation of the special case
