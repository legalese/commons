IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc1-order-3-time`
IMPORT `roc1-order-7`

-- TESTS for roc1-order-7.l4 (Order 7, service in Singapore).  Expected values are written from the text beside each assertion.
-- Calendar: 5 Nov 2026 is a Thursday; the fixture holidays 11 and 23 Nov 2026 are not statements that they are holidays.

`o 7 r 1 test calendar` MEANS `Court calendar` WITH
    `public holidays` IS LIST Date 11 11 2026, Date 23 11 2026

`o 7 r 2 test natural person` MEANS `Natural person` OF 40

`o 7 r 2 test entity` MEANS Entity OF TRUE

-- 5 p.m. is 1020 minutes after midnight.
GIVEN day IS A DATE
      minutes IS A NUMBER
GIVETH A `Service event`
`o 7 r 8 test service at` MEANS `Service event` WITH
    `service of` IS Summons
    `service method` IS `Ordinary service`
    `service place` IS `Served in Singapore`
    `service moment` IS Moment WITH
        `day of the moment` IS day
        `minutes after midnight` IS minutes

-- Rule 1(1)(a): any one of the three suffices; none is JUST FALSE ("where")
#ASSERT `o 7 r 1(1)(a) a document may be served by personal service` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 7 r 1(1)(a) a document may be served by personal service` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 7 r 1(1)(a) a document may be served by personal service` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 1(1)(a) a document may be served by personal service` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 7 r 1(1)(b) a document may be served by ordinary service` TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 1(1)(b) a document may be served by ordinary service` FALSE EQUALS NOTHING
#ASSERT `o 7 r 1(2) the Court may dispense with personal service, ordinary service or service altogether` TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 1(2) the Court may dispense with personal service, ordinary service or service altogether` FALSE EQUALS NOTHING

-- Rule 2(1): limb (a) is for a natural person, limb (b) for an entity, (c) and (d) for any
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test natural person` `o 7 r 2(1)(a) a copy left with the natural person` EQUALS JUST TRUE
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test entity` `o 7 r 2(1)(a) a copy left with the natural person` EQUALS NOTHING
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test natural person` `o 7 r 2(1)(a) a copy left with the agent of an overseas principal under Rule 4` EQUALS JUST TRUE
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test entity` `o 7 r 2(1)(a) a copy left with the agent of an overseas principal under Rule 4` EQUALS NOTHING
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test entity` `o 7 r 2(1)(b) a copy left with the chairperson or president of the entity` EQUALS JUST TRUE
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test natural person` `o 7 r 2(1)(b) a copy left with the chairperson or president of the entity` EQUALS NOTHING
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test entity` `o 7 r 2(1)(b) a copy left with the secretary, treasurer or other officer of the entity` EQUALS JUST TRUE
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test natural person` `o 7 r 2(1)(b) a copy left with the secretary, treasurer or other officer of the entity` EQUALS NOTHING
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test natural person` `o 7 r 2(1)(c) according to the requirements of a written law` EQUALS JUST TRUE
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test entity` `o 7 r 2(1)(c) according to the requirements of a written law` EQUALS JUST TRUE
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test entity` `o 7 r 2(1)(d) in a manner agreed with the person or entity to be served` EQUALS JUST TRUE
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test natural person` `o 7 r 2(1)(d) in a manner agreed with the person or entity to be served` EQUALS JUST TRUE
#ASSERT `o 7 r 2(1) personal service is effected` `o 7 r 2 test natural person` `o 7 r 2(1) some other manner` EQUALS NOTHING

-- Rule 2(2): six kinds may effect personal service; anyone else is not answered
#ASSERT `o 7 r 2(2) the person may effect personal service` `o 7 r 2(2)(a) a process server of the Court` EQUALS JUST TRUE
#ASSERT `o 7 r 2(2) the person may effect personal service` `o 7 r 2(2)(b) a solicitor` EQUALS JUST TRUE
#ASSERT `o 7 r 2(2) the person may effect personal service` `o 7 r 2(2)(c) a solicitor's employee` EQUALS JUST TRUE
#ASSERT `o 7 r 2(2) the person may effect personal service` `o 7 r 2(2)(d) a litigant who is not legally represented` EQUALS JUST TRUE
#ASSERT `o 7 r 2(2) the person may effect personal service` `o 7 r 2(2)(d) an employee of a litigant who is not legally represented` EQUALS JUST TRUE
#ASSERT `o 7 r 2(2) the person may effect personal service` `o 7 r 2(2)(e) another person whom the Registrar has allowed in the particular case or generally` EQUALS JUST TRUE
#ASSERT `o 7 r 2(2) the person may effect personal service` `o 7 r 2(2) any other person` EQUALS NOTHING
-- Rule 2(3)
#ASSERT `o 7 r 2(3) the Registrar must notify the requesting person of the fact and manner of service` TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 2(3) the Registrar must notify the requesting person of the fact and manner of service` FALSE EQUALS JUST FALSE

-- Rule 3: ordinary service.  Args: person, manner, entity has registered office, both act by solicitor, fax number indicated and transmitted
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3(a)(i) leaving it at or posting it to the natural person's usual or last known address` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test entity` `o 7 r 3(a)(i) leaving it at or posting it to the natural person's usual or last known address` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3(a)(i) leaving it at or posting it to the business address of the natural person's solicitor` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test entity` `o 7 r 3(a)(ii) leaving it at or posting it to the entity's registered or principal office` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3(a)(ii) leaving it at or posting it to the entity's registered or principal office` TRUE FALSE FALSE EQUALS NOTHING
-- the entity's last known place of business: only if no registered or principal office exists
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test entity` `o 7 r 3(a)(ii) leaving it at or posting it to the entity's last known place of business` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test entity` `o 7 r 3(a)(ii) leaving it at or posting it to the entity's last known place of business` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3(a)(ii) leaving it at or posting it to the entity's last known place of business` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test entity` `o 7 r 3(a)(ii) leaving it at or posting it to the entity's solicitor's address` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3(a)(ii) leaving it at or posting it to the entity's solicitor's address` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3(b) electronic mail at the address provided by the party to be served` FALSE FALSE FALSE EQUALS JUST TRUE
-- fax: only if both act by solicitor and the fax number was indicated and used
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3(c) fax` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3(c) fax` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3(c) fax` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3(d) a manner agreed between the parties` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3(e) a manner the Court may direct` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3(f) a manner provided under a written law` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 7 r 3 ordinary service may be effected in that manner` `o 7 r 2 test natural person` `o 7 r 3 some other manner` FALSE FALSE FALSE EQUALS NOTHING

-- Rule 4(1): (a) and (b) and (c1 or c2)
#ASSERT `o 7 r 4(1) the Court may direct service on an agent or manager of a principal` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 7 r 4(1) the Court may direct service on an agent or manager of a principal` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 4(1) the Court may direct service on an agent or manager of a principal` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 4(1) the Court may direct service on an agent or manager of a principal` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 7 r 4(1) the Court may direct service on an agent or manager of a principal` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 7 r 4(1) the Court may direct service on an agent or manager of a principal` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 7 r 4(2) the person is deemed the agent of the owner or of the charterer of the ship` TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 4(2) the person is deemed the agent of the owner or of the charterer of the ship` FALSE EQUALS NOTHING
-- Rule 4(3), the duty itself: it exists if the claimant knows the principal's overseas address
#ASSERT `o 7 r 4(3) the claimant must send a copy of the order and of the document to the principal's overseas address` TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 4(3) the claimant must send a copy of the order and of the document to the principal's overseas address` FALSE EQUALS JUST FALSE
-- Rule 4(3): 14 days after service on the agent (Thu 5 Nov): Thu 19 Nov is the last day
#ASSERT `o 7 r 4(3) the claimant has sent the copy to the principal as required` TRUE TRUE (Date 5 11 2026) (Date 19 11 2026) `o 7 r 1 test calendar` NOTHING EQUALS JUST TRUE
#ASSERT `o 7 r 4(3) the claimant has sent the copy to the principal as required` TRUE TRUE (Date 5 11 2026) (Date 20 11 2026) `o 7 r 1 test calendar` NOTHING EQUALS JUST FALSE
#ASSERT `o 7 r 4(3) the claimant has sent the copy to the principal as required` TRUE FALSE (Date 5 11 2026) (Date 10 11 2026) `o 7 r 1 test calendar` NOTHING EQUALS JUST FALSE
#ASSERT `o 7 r 4(3) the claimant has sent the copy to the principal as required` FALSE FALSE (Date 5 11 2026) (Date 10 11 2026) `o 7 r 1 test calendar` NOTHING EQUALS JUST FALSE
#ASSERT `o 7 r 4(3) the claimant has sent the copy to the principal as required` FALSE TRUE (Date 5 11 2026) (Date 10 11 2026) `o 7 r 1 test calendar` NOTHING EQUALS JUST FALSE

-- Rule 5
#ASSERT `o 7 r 5 the Court may authorise service by placing the document on a conspicuous part of the property` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 5 the Court may authorise service by placing the document on a conspicuous part of the property` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 7 r 5 the Court may authorise service by placing the document on a conspicuous part of the property` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 7 r 5 the Court may authorise service by placing the document on a conspicuous part of the property` TRUE TRUE FALSE EQUALS JUST FALSE
-- Rule 6
#ASSERT `o 7 r 6 section 20 of the Government Proceedings Act and Order 59, Rule 3 apply to the service` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 6 section 20 of the Government Proceedings Act and Order 59, Rule 3 apply to the service` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 7 r 6 section 20 of the Government Proceedings Act and Order 59, Rule 3 apply to the service` FALSE FALSE EQUALS JUST FALSE
-- Rule 7
#ASSERT `o 7 r 7(1) a party may apply to serve the document by substituted service` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 7(1) a party may apply to serve the document by substituted service` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 7 r 7(1) a party may apply to serve the document by substituted service` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 7 r 7(2) the Court may order that method of substituted service` TRUE EQUALS JUST TRUE
#ASSERT `o 7 r 7(2) the Court may order that method of substituted service` FALSE EQUALS NOTHING
-- order on Thu 5 Nov; within 14 days: Thu 19 Nov in time, Fri 20 Nov not
#ASSERT `o 7 r 7(3) substituted service is effected within 14 days after the order` (Date 5 11 2026) (Date 19 11 2026) `o 7 r 1 test calendar` NOTHING EQUALS JUST TRUE
#ASSERT `o 7 r 7(3) substituted service is effected within 14 days after the order` (Date 5 11 2026) (Date 20 11 2026) `o 7 r 1 test calendar` NOTHING EQUALS JUST FALSE

-- Rule 8: before 5 p.m. (1020) is that day, after 5 p.m. the following day, exactly 5 p.m. is not answered
#ASSERT `o 7 r 8 the day service is deemed effected` (`o 7 r 8 test service at` (Date 5 11 2026) 1019) FALSE EQUALS JUST (Date 5 11 2026)
#ASSERT `o 7 r 8 the day service is deemed effected` (`o 7 r 8 test service at` (Date 5 11 2026) 0) FALSE EQUALS JUST (Date 5 11 2026)
#ASSERT `o 7 r 8 the day service is deemed effected` (`o 7 r 8 test service at` (Date 5 11 2026) 1021) FALSE EQUALS JUST (Date 6 11 2026)
#ASSERT `o 7 r 8 the day service is deemed effected` (`o 7 r 8 test service at` (Date 5 11 2026) 1439) FALSE EQUALS JUST (Date 6 11 2026)
#ASSERT `o 7 r 8 the day service is deemed effected` (`o 7 r 8 test service at` (Date 5 11 2026) 1020) FALSE EQUALS NOTHING
-- "the following day": Friday after 5 p.m. is Saturday, not Monday
#ASSERT `o 7 r 8 the day service is deemed effected` (`o 7 r 8 test service at` (Date 6 11 2026) 1100) FALSE EQUALS JUST (Date 7 11 2026)
-- subject to any written law and Order 28: NOTHING here
#ASSERT `o 7 r 8 the day service is deemed effected` (`o 7 r 8 test service at` (Date 5 11 2026) 600) TRUE EQUALS NOTHING
#ASSERT `o 7 r 8 this Rule deems the day of service` (`o 7 r 8 test service at` (Date 5 11 2026) 600) FALSE EQUALS JUST TRUE
-- at exactly 5 p.m. neither "when" holds, so the yes/no question is JUST FALSE ("when" counts as "where"); the date question above stays NOTHING.
#ASSERT `o 7 r 8 this Rule deems the day of service` (`o 7 r 8 test service at` (Date 5 11 2026) 1020) FALSE EQUALS JUST FALSE
-- exactly 5 p.m. but another provision governs: the 'subject to' lift is reached first, so NOTHING.
#ASSERT `o 7 r 8 this Rule deems the day of service` (`o 7 r 8 test service at` (Date 5 11 2026) 1020) TRUE EQUALS NOTHING
#ASSERT `o 7 r 8 this Rule deems the day of service` (`o 7 r 8 test service at` (Date 5 11 2026) 1021) FALSE EQUALS JUST TRUE
