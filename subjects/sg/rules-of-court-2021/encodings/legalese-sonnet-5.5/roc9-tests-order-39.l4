#ASSERT `o 39 r 11(2) the application may be made without notice` FALSE EQUALS JUST FALSE
#ASSERT `o 39 r 11(3) the affidavit states what the Rule requires` (`o 39 r 11(3) what the affidavit states` OF TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 39 r 11(3) the affidavit states what the Rule requires` (`o 39 r 11(3) what the affidavit states` OF FALSE, TRUE) EQUALS NOTHING
#ASSERT `o 39 r 11(3) the affidavit states what the Rule requires` (`o 39 r 11(3) what the affidavit states` OF TRUE, FALSE) EQUALS NOTHING

-- ---- Further tests (Order 39) ----
