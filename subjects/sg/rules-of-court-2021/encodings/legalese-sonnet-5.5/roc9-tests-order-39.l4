#ASSERT `o 39 r 8(2) the bar on applying for an enforcement order applies` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 39 r 8(2) the bar on applying for an enforcement order applies` TRUE FALSE EQUALS JUST FALSE
