#ASSERT `o 39 r 10(2) the bar on issuing an enforcement order until the application is disposed of applies` FALSE EQUALS JUST FALSE
#ASSERT `o 39 r 10(2) the enforcement order cannot yet be issued` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 39 r 10(2) the enforcement order cannot yet be issued` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 39 r 10(2) the enforcement order cannot yet be issued` FALSE FALSE EQUALS NOTHING
