#ASSERT `o 39 r 9(2) the Court may order the issue to be tried as an issue in an action may be tried` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 9(2) the Court may order the issue to be tried as an issue in an action may be tried` FALSE FALSE EQUALS NOTHING
