IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc9-order-39`

-- Tests for roc9-order-39.l4.  Expected values are written from the text of Order 39 (lines 5511-5583) before the run.
-- Positional OF follows the DECLARE order of each record.

-- ---- Rule 1(1) (line 5514): a District Judge sitting in chambers or the Registrar; not for section 85(3) ----
#ASSERT `o 39 r 1(1) the person may exercise the powers conferred on the District Court by section 85` `A District Judge` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 39 r 1(1) the person may exercise the powers conferred on the District Court by section 85` `The Registrar` FALSE FALSE EQUALS JUST TRUE
-- a District Judge not sitting in chambers: outside the grant's wording
#ASSERT `o 39 r 1(1) the person may exercise the powers conferred on the District Court by section 85` `A District Judge` FALSE FALSE EQUALS NOTHING
#ASSERT `o 39 r 1(1) the person may exercise the powers conferred on the District Court by section 85` `A Magistrate` TRUE FALSE EQUALS NOTHING
-- "Subject to paragraph (2)": for section 85(3) paragraph (1) defers
#ASSERT `o 39 r 1(1) the person may exercise the powers conferred on the District Court by section 85` `The Registrar` FALSE TRUE EQUALS NOTHING
-- ---- Rule 1(2): "may only be exercised by a District Judge" ----
#ASSERT `o 39 r 1(2) the person may exercise the powers conferred on the District Court by section 85(3)` `A District Judge` EQUALS JUST TRUE
#ASSERT `o 39 r 1(2) the person may exercise the powers conferred on the District Court by section 85(3)` `The Registrar` EQUALS JUST FALSE
#ASSERT `o 39 r 1(2) the person may exercise the powers conferred on the District Court by section 85(3)` `A Judge` EQUALS JUST FALSE
-- the two paragraphs gathered by hand (fork F39.1)
#ASSERT `o 39 r 1 the person may exercise the power conferred on the District Court by section 85` `The Registrar` FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 39 r 1 the person may exercise the power conferred on the District Court by section 85` `The Registrar` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 39 r 1 the person may exercise the power conferred on the District Court by section 85` `A District Judge` FALSE TRUE EQUALS JUST TRUE
-- ---- Rule 1(3) (line 5515): "Act" means the Competition Act ----
#ASSERT `o 39 r 1(3) a statute is the Act` TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 1(3) a statute is the Act` FALSE EQUALS JUST FALSE
#ASSERT `o 39 r 1(3) a reference to a section is a reference to a section in the Act` TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 1(3) a reference to a section is a reference to a section in the Act` FALSE EQUALS JUST FALSE

-- ---- Rule 2 (lines 5516-5523): commitment (60A), direction (58A, 67, 69), decision (Competition Appeal Board) ----
#ASSERT `o 39 r 2 the kind of instrument` TRUE FALSE FALSE "60A" EQUALS `o 39 r 2(a) a Commitment`
#ASSERT `o 39 r 2 the kind of instrument` TRUE FALSE FALSE "67" EQUALS `o 39 r 2 not one of the three kinds`
#ASSERT `o 39 r 2 the kind of instrument` FALSE TRUE FALSE "58A" EQUALS `o 39 r 2(b) a Direction`
#ASSERT `o 39 r 2 the kind of instrument` FALSE TRUE FALSE "67" EQUALS `o 39 r 2(b) a Direction`
#ASSERT `o 39 r 2 the kind of instrument` FALSE TRUE FALSE "69" EQUALS `o 39 r 2(b) a Direction`
#ASSERT `o 39 r 2 the kind of instrument` FALSE TRUE FALSE "60A" EQUALS `o 39 r 2 not one of the three kinds`
#ASSERT `o 39 r 2 the kind of instrument` FALSE FALSE TRUE "" EQUALS `o 39 r 2(c) a Decision`
#ASSERT `o 39 r 2 the kind of instrument` FALSE FALSE FALSE "" EQUALS `o 39 r 2 not one of the three kinds`
-- "must be made by originating application without notice"
#ASSERT `o 39 r 2 the application for registration is made as the Rule requires` `o 39 r 2(a) a Commitment` TRUE `o 39 r 2 by originating application without notice` EQUALS JUST TRUE
#ASSERT `o 39 r 2 the application for registration is made as the Rule requires` `o 39 r 2(c) a Decision` TRUE `o 39 r 2 by originating application without notice` EQUALS JUST TRUE
#ASSERT `o 39 r 2 the application for registration is made as the Rule requires` `o 39 r 2(b) a Direction` TRUE `o 39 r 2 by originating application with notice` EQUALS NOTHING
#ASSERT `o 39 r 2 the application for registration is made as the Rule requires` `o 39 r 2(b) a Direction` TRUE `o 39 r 2 by summons` EQUALS NOTHING
#ASSERT `o 39 r 2 the application for registration is made as the Rule requires` `o 39 r 2(b) a Direction` FALSE `o 39 r 2 by originating application without notice` EQUALS NOTHING
#ASSERT `o 39 r 2 the application for registration is made as the Rule requires` `o 39 r 2 not one of the three kinds` TRUE `o 39 r 2 by originating application without notice` EQUALS NOTHING

-- ---- Rule 3 (lines 5524-5538): the affidavit.  Fields: (a), (b)(i), (b)(ii), (c)(i), (c)(ii), (c)(iii) ----
#ASSERT `o 39 r 3(c)(iii) a statement of the unsatisfied financial penalty is required` TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 3(c)(iii) a statement of the unsatisfied financial penalty is required` FALSE EQUALS JUST FALSE
#ASSERT `o 39 r 3 the application is supported by an affidavit as the Rule requires` TRUE TRUE (`o 39 r 3 what the affidavit does` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
-- no penalty unsatisfied: (c)(iii) is "if applicable", so its absence does not matter
#ASSERT `o 39 r 3 the application is supported by an affidavit as the Rule requires` TRUE FALSE (`o 39 r 3 what the affidavit does` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS JUST TRUE
-- a penalty remains unsatisfied and the affidavit does not state it
#ASSERT `o 39 r 3 the application is supported by an affidavit as the Rule requires` TRUE TRUE (`o 39 r 3 what the affidavit does` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING
#ASSERT `o 39 r 3 the application is supported by an affidavit as the Rule requires` TRUE TRUE (`o 39 r 3 what the affidavit does` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 39 r 3 the application is supported by an affidavit as the Rule requires` TRUE TRUE (`o 39 r 3 what the affidavit does` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 39 r 3 the application is supported by an affidavit as the Rule requires` TRUE TRUE (`o 39 r 3 what the affidavit does` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 39 r 3 the application is supported by an affidavit as the Rule requires` TRUE TRUE (`o 39 r 3 what the affidavit does` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 39 r 3 the application is supported by an affidavit as the Rule requires` TRUE TRUE (`o 39 r 3 what the affidavit does` OF TRUE, TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS NOTHING
-- no affidavit at all
#ASSERT `o 39 r 3 the application is supported by an affidavit as the Rule requires` FALSE TRUE (`o 39 r 3 what the affidavit does` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING

-- ---- Rule 4 (line 5540) ----
#ASSERT `o 39 r 4 the Court may order the person to give security for costs` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 4 the Court may order the person to give security for costs` FALSE TRUE EQUALS NOTHING
#ASSERT `o 39 r 4 the Court may order the person to give security for costs` TRUE FALSE EQUALS NOTHING

-- ---- Rule 5 (lines 5541-5548) ----
-- (1)(a): a Commitment is served on the party who provided it
#ASSERT `o 39 r 5(1) the order for registration is drawn up and served as the Rule requires` `o 39 r 2(a) a Commitment` "60" TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 39 r 5(1) the order for registration is drawn up and served as the Rule requires` `o 39 r 2(a) a Commitment` "60" TRUE FALSE TRUE EQUALS NOTHING
-- (1)(b): a Direction or a Decision is served on the party against whom it was made
#ASSERT `o 39 r 5(1) the order for registration is drawn up and served as the Rule requires` `o 39 r 2(b) a Direction` "60" TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 5(1) the order for registration is drawn up and served as the Rule requires` `o 39 r 2(c) a Decision` "60" TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 5(1) the order for registration is drawn up and served as the Rule requires` `o 39 r 2(c) a Decision` "60" TRUE TRUE FALSE EQUALS NOTHING
-- Form 60 and drawn up by the applying party
#ASSERT `o 39 r 5(1) the order for registration is drawn up and served as the Rule requires` `o 39 r 2(b) a Direction` "61" TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `o 39 r 5(1) the order for registration is drawn up and served as the Rule requires` `o 39 r 2(b) a Direction` "60" FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `o 39 r 5(1) the order for registration is drawn up and served as the Rule requires` `o 39 r 2 not one of the three kinds` "60" TRUE TRUE TRUE EQUALS NOTHING
-- (2): "Unless the Court otherwise directs"
#ASSERT `o 39 r 5(2) the order must state the period and contain the notification` FALSE EQUALS JUST TRUE
#ASSERT `o 39 r 5(2) the order must state the period and contain the notification` TRUE EQUALS JUST FALSE
#ASSERT `o 39 r 5(2) the order states the period and contains the notification` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 5(2) the order states the period and contains the notification` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `o 39 r 5(2) the order states the period and contains the notification` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `o 39 r 5(2) the order states the period and contains the notification` TRUE TRUE TRUE EQUALS NOTHING
-- (3): "before the expiry of that period": on the last day is in time, the day after is not
#ASSERT `o 39 r 5(3) the application to extend the period is made in time` (Date 14 3 2023) (Date 15 3 2023) EQUALS JUST TRUE
#ASSERT `o 39 r 5(3) the application to extend the period is made in time` (Date 15 3 2023) (Date 15 3 2023) EQUALS JUST TRUE
#ASSERT `o 39 r 5(3) the application to extend the period is made in time` (Date 16 3 2023) (Date 15 3 2023) EQUALS JUST FALSE
-- (4)
#ASSERT `o 39 r 5(4) the Court may extend the period` TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 5(4) the Court may extend the period` FALSE EQUALS NOTHING

-- ---- Rule 6 (line 5550) ----
#ASSERT `o 39 r 6 the instrument is to be entered in the register kept in the Registry` TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 6 the instrument is to be entered in the register kept in the Registry` FALSE EQUALS NOTHING

-- ---- Rule 7 (lines 5551-5560) ----
-- (1): personal service unless the Court otherwise orders; "subject to paragraph (2)" for service out of Singapore
#ASSERT `o 39 r 7(1) the requirement of personal service of the notice applies` FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 39 r 7(1) the requirement of personal service of the notice applies` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 39 r 7(1) the requirement of personal service of the notice applies` FALSE TRUE EQUALS NOTHING
#ASSERT `o 39 r 7(1) the notice of registration is served as the Rule requires` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 39 r 7(1) the notice of registration is served as the Rule requires` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `o 39 r 7(1) the notice of registration is served as the Rule requires` FALSE TRUE FALSE FALSE EQUALS NOTHING
-- the Court ordered otherwise: the requirement does not apply, so the compliance question is not answered (QD)
#ASSERT `o 39 r 7(1) the notice of registration is served as the Rule requires` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `o 39 r 7(1) the notice of registration is served as the Rule requires` TRUE TRUE FALSE TRUE EQUALS NOTHING
-- (2)
#ASSERT `o 39 r 7(2) the notice may be served out of Singapore without permission` TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 7(2) the notice may be served out of Singapore without permission` FALSE EQUALS NOTHING
#ASSERT `o 39 r 7(2) Order 8, Rules 2, 3, 7 and 8 apply to the notice` TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 7(2) Order 8, Rules 2, 3, 7 and 8 apply to the notice` FALSE EQUALS NOTHING
-- (3): four statements
#ASSERT `o 39 r 7(3) the notice of registration states what the Rule requires` (`o 39 r 7(3) what the notice states` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 39 r 7(3) the notice of registration states what the Rule requires` (`o 39 r 7(3) what the notice states` OF FALSE, TRUE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 39 r 7(3) the notice of registration states what the Rule requires` (`o 39 r 7(3) what the notice states` OF TRUE, FALSE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 39 r 7(3) the notice of registration states what the Rule requires` (`o 39 r 7(3) what the notice states` OF TRUE, TRUE, FALSE, TRUE) EQUALS NOTHING
#ASSERT `o 39 r 7(3) the notice of registration states what the Rule requires` (`o 39 r 7(3) what the notice states` OF TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING

-- ---- Rule 8 (lines 5561-5563) ----
#ASSERT (`o 39 r 8(1) the period for endorsing the notice`'s `period length`) EQUALS 3
#ASSERT (`o 39 r 8(1) the period for endorsing the notice`'s `period unit`) EQUALS Days
#ASSERT (`o 39 r 8(1) the period for endorsing the notice`'s `period direction`) EQUALS `After the anchor`
-- served on 10 March 2023, the 3 days end on 13 March 2023 (supplied by Order 3 Rule 3): on the last day is in time, after is not
#ASSERT `o 39 r 8(1) the notice is endorsed in time` (Date 13 3 2023) (Date 13 3 2023) NOTHING EQUALS JUST TRUE
#ASSERT `o 39 r 8(1) the notice is endorsed in time` (Date 14 3 2023) (Date 13 3 2023) NOTHING EQUALS JUST FALSE
-- a longer period allowed by the Court in special circumstances, to 20 March
#ASSERT `o 39 r 8(1) the notice is endorsed in time` (Date 17 3 2023) (Date 13 3 2023) (JUST (Date 20 3 2023)) EQUALS JUST TRUE
#ASSERT `o 39 r 8(1) the notice is endorsed in time` (Date 20 3 2023) (Date 13 3 2023) (JUST (Date 20 3 2023)) EQUALS JUST TRUE
#ASSERT `o 39 r 8(1) the notice is endorsed in time` (Date 21 3 2023) (Date 13 3 2023) (JUST (Date 20 3 2023)) EQUALS JUST FALSE
#ASSERT `o 39 r 8(1) the endorsement is as the Rule requires` TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 8(1) the endorsement is as the Rule requires` FALSE EQUALS NOTHING
-- (2): not endorsed in time and no permission; with the permission; endorsed in time
#ASSERT `o 39 r 8(2) the person seeking to enforce may apply for an enforcement order` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 39 r 8(2) the person seeking to enforce may apply for an enforcement order` FALSE TRUE EQUALS NOTHING
#ASSERT `o 39 r 8(2) the person seeking to enforce may apply for an enforcement order` TRUE FALSE EQUALS NOTHING
#ASSERT `o 39 r 8(2) the person seeking to enforce may apply for an enforcement order` TRUE TRUE EQUALS NOTHING
-- (3)
#ASSERT `o 39 r 8(3) the affidavit of service is as the Rule requires` TRUE EQUALS JUST TRUE
#ASSERT `o 39 r 8(3) the affidavit of service is as the Rule requires` FALSE EQUALS NOTHING
-- the regulative rule: endorsed on day 2 -> fulfilled; nothing by day 4 -> breached by default
#TRACE `o 39 r 8(1) the duty to endorse the notice` AT 0 WITH
    PARTY `o 39 r 8(1) the person who served the notice` DOES `o 39 r 8(1) endorse the notice with the day of the week and date of service` AT 2
-- expect: FULFILLED
#TRACE `o 39 r 8(1) the duty to endorse the notice` AT 0 WITH
    PARTY `o 39 r 8(1) the person who served the notice` DOES `o 39 r 8(1) endorse the notice with the day of the week and date of service` AT 3
-- expect: FULFILLED
#TRACE `o 39 r 8(1) the duty to endorse the notice` AT 0 WITH
    (WAITUNTIL 4)
-- expect: DEONTIC BREACHED

