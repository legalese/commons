#ASSERT `o 19 r 24(e) this Division applies to the tribunal appeal without modification` FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 24 this Division applies` `o 19 test div 3 route GD to AD` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 24 this Division applies` `o 19 test div 3 route AD to CA` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 24 this Division applies` `o 19 test div 3 route DC to GD` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 19 r 24 this Division applies` `o 19 test div 3 route tribunal to AD` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 19 r 24 this Division applies` `o 19 test div 3 route tribunal to AD` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `o 19 r 24 this Division applies` `o 19 test div 3 route DC to GD` FALSE FALSE FALSE EQUALS NOTHING

-- ===== Rule 25 =====
