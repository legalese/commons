-- r 18(5): inspection (QA)
#ASSERT `o 33 r 18(5) a preliminary act may be inspected` TRUE FALSE FALSE EQUALS JUST FALSE -- "must not be inspected except as provided in paragraph (8) or by order of the Court"
#ASSERT `o 33 r 18(5) a preliminary act may be inspected` TRUE TRUE FALSE EQUALS JUST TRUE -- under paragraph (8): an exception the sentence gives (QA)
#ASSERT `o 33 r 18(5) a preliminary act may be inspected` TRUE FALSE TRUE EQUALS JUST TRUE -- by order of the Court: the order is the exception the sentence gives (QA)
#ASSERT `o 33 r 18(5) a preliminary act may be inspected` FALSE FALSE FALSE EQUALS NOTHING -- not a preliminary act: silent

-- r 20(1): the claimant's reply (QA)
#ASSERT `o 33 r 20(1) the claimant may serve a reply or a defence to counterclaim on the defendant` TRUE TRUE FALSE EQUALS JUST FALSE -- no permission
#ASSERT `o 33 r 20(1) the claimant may serve a reply or a defence to counterclaim on the defendant` TRUE TRUE TRUE EQUALS JUST TRUE -- permission given: with the permission the claimant may serve (QA)
#ASSERT `o 33 r 20(1) the claimant may serve a reply or a defence to counterclaim on the defendant` TRUE FALSE FALSE EQUALS NOTHING -- a defendant: silent
#ASSERT `o 33 r 20(1) the claimant may serve a reply or a defence to counterclaim on the defendant` FALSE TRUE FALSE EQUALS NOTHING -- an action outside Rule 3(1): silent

-- r 21(3)
#ASSERT `o 33 r 21(3) the claimant may apply to the Court for judgment by default` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- statement of claim endorsed
#ASSERT `o 33 r 21(3) the claimant may apply to the Court for judgment by default` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- copy of the statement of claim filed
#ASSERT `o 33 r 21(3) the claimant may apply to the Court for judgment by default` TRUE TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE -- neither the endorsement nor the copy
#ASSERT `o 33 r 21(3) the claimant may apply to the Court for judgment by default` TRUE FALSE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- 14 days not yet expired
#ASSERT `o 33 r 21(3) the claimant may apply to the Court for judgment by default` TRUE TRUE FALSE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- no affidavit of service
#ASSERT `o 33 r 21(3) the claimant may apply to the Court for judgment by default` TRUE TRUE TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE -- no affidavit verifying the facts
#ASSERT `o 33 r 21(3) the claimant may apply to the Court for judgment by default` FALSE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- the defendant did file the notice
#ASSERT `o 33 r 21(3) the claimant may apply to the Court for judgment by default` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING -- the power is not used

-- r 21(4): the exhibit
#ASSERT `o 33 r 21(4) the required exhibit is exhibited in the affidavit verifying the facts` TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- deemed served by 7(3)(a), the endorsed claim exhibited
#ASSERT `o 33 r 21(4) the required exhibit is exhibited in the affidavit verifying the facts` FALSE TRUE FALSE TRUE EQUALS JUST TRUE -- deemed served by 7(3)(b), the notice copy exhibited
#ASSERT `o 33 r 21(4) the required exhibit is exhibited in the affidavit verifying the facts` TRUE FALSE FALSE TRUE EQUALS NOTHING -- deemed by 7(3)(a), but only the other exhibit
#ASSERT `o 33 r 21(4) the required exhibit is exhibited in the affidavit verifying the facts` TRUE FALSE FALSE FALSE EQUALS NOTHING -- nothing exhibited
#ASSERT `o 33 r 21(4) the required exhibit is exhibited in the affidavit verifying the facts` FALSE FALSE TRUE TRUE EQUALS NOTHING -- not deemed served: the duty does not arise
#ASSERT `o 33 r 21(4) the required exhibit is exhibited in the affidavit verifying the facts (the duty arises)` TRUE FALSE EQUALS JUST TRUE -- deemed served by 7(3)(a)
#ASSERT `o 33 r 21(4) the required exhibit is exhibited in the affidavit verifying the facts (the duty arises)` FALSE TRUE EQUALS JUST TRUE -- deemed served by 7(3)(b)
#ASSERT `o 33 r 21(4) the required exhibit is exhibited in the affidavit verifying the facts (the duty arises)` FALSE FALSE EQUALS JUST FALSE -- not deemed served

-- r 21(5)
#ASSERT `o 33 r 21(5) the claimant may apply to the Court for judgment by default against a defendant who served no defence` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- all filed
#ASSERT `o 33 r 21(5) the claimant may apply to the Court for judgment by default against a defendant who served no defence` TRUE FALSE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- the period for the defence has not expired
#ASSERT `o 33 r 21(5) the claimant may apply to the Court for judgment by default against a defendant who served no defence` TRUE TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE -- no statement of claim endorsed or copied
#ASSERT `o 33 r 21(5) the claimant may apply to the Court for judgment by default against a defendant who served no defence` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- the power is not used

-- r 21(6) and (7)
#ASSERT `o 33 r 21(6) the defendant making the counterclaim may apply to the Court for judgment by default` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- all filed, not the claimant in a Rule 3(1) action
#ASSERT `o 33 r 21(6) the defendant making the counterclaim may apply to the Court for judgment by default` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- paragraph (7): against the claimant in a Rule 3(1) action
#ASSERT `o 33 r 21(6) the defendant making the counterclaim may apply to the Court for judgment by default` TRUE FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- the period has not expired
#ASSERT `o 33 r 21(6) the defendant making the counterclaim may apply to the Court for judgment by default` TRUE FALSE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- the power is not used

-- r 21(10): the rate and the amount
#ASSERT `o 33 r 21(10) the rate of interest per year, in percent` EQUALS 5.33 -- "5.33% per year"
#ASSERT `o 33 r 21(10) the interest on the sum` TRUE 36500 365 EQUALS JUST 1945.45 -- one year on 36500 at 5.33 percent
#ASSERT `o 33 r 21(10) the interest on the sum` TRUE 100000 0 EQUALS JUST 0 -- judgment on the day of the originating claim
#ASSERT `o 33 r 21(10) the interest on the sum` FALSE 36500 365 EQUALS NOTHING -- a judgment not given under this Rule: the text states no figure

-- r 22(1)
#ASSERT `o 33 r 22(1) the party may apply for an order determining the order of priority` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- sold, judgment, no further order: after obtaining judgment
#ASSERT `o 33 r 22(1) the party may apply for an order determining the order of priority` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- further order made and its period expired
#ASSERT `o 33 r 22(1) the party may apply for an order determining the order of priority` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- further order made, period running
#ASSERT `o 33 r 22(1) the party may apply for an order determining the order of priority` TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- no judgment yet
#ASSERT `o 33 r 22(1) the party may apply for an order determining the order of priority` FALSE TRUE FALSE FALSE TRUE EQUALS JUST FALSE -- the ship has not been ordered sold
#ASSERT `o 33 r 22(1) the party may apply for an order determining the order of priority` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING -- the power is not used

-- r 22(2)
#ASSERT `o 33 r 22(2) the Court may further order` TRUE `o 33 r 22(2)(a) that the order of priority of the claims must not be determined until after the expiration of 90 days or of such other period as the Court may specify` EQUALS JUST TRUE -- (a)
#ASSERT `o 33 r 22(2) the Court may further order` TRUE `o 33 r 22(2)(b) that any party may apply to the Court to extend the period specified in the order` EQUALS JUST TRUE -- (b)
#ASSERT `o 33 r 22(2) the Court may further order` TRUE `o 33 r 22(2)(c) that within 14 days after payment into Court of the proceeds of sale the Sheriff must send for publication a notice complying with paragraph (3)` EQUALS JUST TRUE -- (c)
#ASSERT `o 33 r 22(2) the Court may further order` TRUE `o 33 r 22(2) any other order` EQUALS NOTHING -- a list not closed
#ASSERT `o 33 r 22(2) the Court may further order` FALSE `o 33 r 22(2)(a) that the order of priority of the claims must not be determined until after the expiration of 90 days or of such other period as the Court may specify` EQUALS JUST FALSE -- no order for sale
#ASSERT `o 33 r 22(2)(a) the period before the order of priority is determined` EQUALS (Period WITH `period length` IS 90, `period unit` IS Days, `period direction` IS `After the anchor`) -- 90 days

-- r 23(3)
#ASSERT `o 33 r 23(3) the commission for appraisement and sale cannot yet be executed for want of the undertaking` FALSE EQUALS JUST TRUE -- no undertaking lodged
#ASSERT `o 33 r 23(3) the commission for appraisement and sale cannot yet be executed for want of the undertaking` TRUE EQUALS JUST FALSE -- lodged

-- r 25(1): QE
#ASSERT `o 33 r 25(1) a Rule of Order 14 applies to the Admiralty action` TRUE `o 33 r 25(1) any other Rule of Order 14` EQUALS JUST TRUE -- Order 14 other than the four excepted Rules
#ASSERT `o 33 r 25(1) a Rule of Order 14 applies to the Admiralty action` TRUE `o 33 r 25(1) Rule 3 of Order 14` EQUALS JUST FALSE -- an excepted Rule: "except" says it does not apply
#ASSERT `o 33 r 25(1) a Rule of Order 14 applies to the Admiralty action` TRUE `o 33 r 25(1) Rule 4 of Order 14` EQUALS JUST FALSE -- an excepted Rule: "except" says it does not apply
#ASSERT `o 33 r 25(1) a Rule of Order 14 applies to the Admiralty action` TRUE `o 33 r 25(1) Rule 5 of Order 14` EQUALS JUST FALSE -- an excepted Rule: "except" says it does not apply
#ASSERT `o 33 r 25(1) a Rule of Order 14 applies to the Admiralty action` TRUE `o 33 r 25(1) Rule 12 of Order 14` EQUALS JUST FALSE -- an excepted Rule: "except" says it does not apply
#ASSERT `o 33 r 25(1) a Rule of Order 14 applies to the Admiralty action` FALSE `o 33 r 25(1) any other Rule of Order 14` EQUALS NOTHING -- not an Admiralty action

-- r 25(2): QA
#ASSERT `o 33 r 25(2) the money paid into Court may be paid out` TRUE FALSE FALSE EQUALS JUST FALSE -- no order of the Judge in person
#ASSERT `o 33 r 25(2) the money paid into Court may be paid out` TRUE TRUE FALSE EQUALS JUST TRUE -- by order of the Judge in person: the order permits payment out (QA)
#ASSERT `o 33 r 25(2) the money paid into Court may be paid out` TRUE FALSE TRUE EQUALS JUST TRUE -- a case in paragraph (3): paragraph (3) permits payment out (QA)
#ASSERT `o 33 r 25(2) the money paid into Court may be paid out` FALSE FALSE FALSE EQUALS NOTHING -- no money paid into Court: silent

-- r 26(1): QE
#ASSERT `o 33 r 26(1) Order 9 Rules 8 and 9 apply to the Admiralty action` TRUE FALSE EQUALS JUST TRUE -- an Admiralty action that is not a limitation action
#ASSERT `o 33 r 26(1) Order 9 Rules 8 and 9 apply to the Admiralty action` TRUE TRUE EQUALS NOTHING -- "(other than limitation actions)"
#ASSERT `o 33 r 26(1) Order 9 Rules 8 and 9 apply to the Admiralty action` FALSE FALSE EQUALS NOTHING -- not an Admiralty action


