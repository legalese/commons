IMPORT prelude
IMPORT `roc-core`
IMPORT `roc11-order-58`

-- TESTS for Order 58 (hire-purchase proceedings).  Every expected value is written from the text of
-- the rule, beside the assertion, before the code was run.

-- ---------------------------------------------------------------------------
§ `Order 58 rule 1 -- application`
-- ---------------------------------------------------------------------------
-- Proceedings under the Hire-Purchase Act: "These Rules apply to proceedings under the Hire-Purchase Act".
#ASSERT `o 58 r 1 these Rules apply to the proceedings` TRUE EQUALS JUST TRUE
-- Proceedings under some other Act: the rule is silent (a scope limit with no "only").
#ASSERT `o 58 r 1 these Rules apply to the proceedings` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 58 rule 2 -- mode of application`
-- ---------------------------------------------------------------------------
-- The five named sections.
#ASSERT `o 58 r 2 the section is one that the Rule names` `o 58 r 2 section 5(3)` EQUALS TRUE
#ASSERT `o 58 r 2 the section is one that the Rule names` `o 58 r 2 section 10` EQUALS TRUE
#ASSERT `o 58 r 2 the section is one that the Rule names` `o 58 r 2 section 32` EQUALS TRUE
#ASSERT `o 58 r 2 the section is one that the Rule names` `o 58 r 2 section 43` EQUALS TRUE
#ASSERT `o 58 r 2 the section is one that the Rule names` `o 58 r 2 section 44` EQUALS TRUE
-- Any other section is not named.
#ASSERT `o 58 r 2 the section is one that the Rule names` `o 58 r 2 another section` EQUALS FALSE
-- Originating application supported by an affidavit stating the grounds: as required.
#ASSERT `o 58 r 2 the application is made as the Rule requires` `o 58 r 2 section 43` `Originating application` TRUE EQUALS JUST TRUE
-- Originating application with no affidavit: a bare "must" not done.
#ASSERT `o 58 r 2 the application is made as the Rule requires` `o 58 r 2 section 43` `Originating application` FALSE EQUALS NOTHING
-- A summons instead of an originating application: a bare "must" not done.
#ASSERT `o 58 r 2 the application is made as the Rule requires` `o 58 r 2 section 10` Summons TRUE EQUALS NOTHING
-- A section the Rule does not name (outside the scope of the Rule).
#ASSERT `o 58 r 2 the application is made as the Rule requires` `o 58 r 2 another section` `Originating application` TRUE EQUALS NOTHING
#ASSERT `o 58 r 2 the application is made as the Rule requires` `o 58 r 2 another section` Summons TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 58 rule 3 -- particulars in the statement of claim`
-- ---------------------------------------------------------------------------
`o 58 r 3 fixture every particular given` MEANS `o 58 r 3 particulars given` WITH
    `o 58 r 3(a) gives the date of the agreement and the parties to the agreement` IS TRUE
    `o 58 r 3(b) gives the goods let under the agreement` IS TRUE
    `o 58 r 3(c) gives the amount of the hire-purchase price` IS TRUE
    `o 58 r 3(d) gives the amount paid by or on behalf of the hirer` IS TRUE
    `o 58 r 3(e) an amount is claimed as due and unpaid` IS TRUE
    `o 58 r 3(e) gives that amount` IS TRUE
    `o 58 r 3(f) there is another claim` IS TRUE
    `o 58 r 3(f) gives the amount of that claim and the circumstances in which it arises` IS TRUE

-- Nothing is claimed as due and unpaid and there is no other claim: items (e) and (f) are "if any", so not required.
`o 58 r 3 fixture no (e) and no (f)` MEANS `o 58 r 3 particulars given` WITH
    `o 58 r 3(a) gives the date of the agreement and the parties to the agreement` IS TRUE
    `o 58 r 3(b) gives the goods let under the agreement` IS TRUE
    `o 58 r 3(c) gives the amount of the hire-purchase price` IS TRUE
    `o 58 r 3(d) gives the amount paid by or on behalf of the hirer` IS TRUE
    `o 58 r 3(e) an amount is claimed as due and unpaid` IS FALSE
    `o 58 r 3(e) gives that amount` IS FALSE
    `o 58 r 3(f) there is another claim` IS FALSE
    `o 58 r 3(f) gives the amount of that claim and the circumstances in which it arises` IS FALSE

-- An amount is claimed as due and unpaid but the statement of claim does not state it; the goods are not given either.
`o 58 r 3 fixture missing (b) and (e)` MEANS `o 58 r 3 particulars given` WITH
    `o 58 r 3(a) gives the date of the agreement and the parties to the agreement` IS TRUE
    `o 58 r 3(b) gives the goods let under the agreement` IS FALSE
    `o 58 r 3(c) gives the amount of the hire-purchase price` IS TRUE
    `o 58 r 3(d) gives the amount paid by or on behalf of the hirer` IS TRUE
    `o 58 r 3(e) an amount is claimed as due and unpaid` IS TRUE
    `o 58 r 3(e) gives that amount` IS FALSE
    `o 58 r 3(f) there is another claim` IS FALSE
    `o 58 r 3(f) gives the amount of that claim and the circumstances in which it arises` IS FALSE

-- Another claim exists and its amount and circumstances are not given; (a), (c) and (d) are also missing.
`o 58 r 3 fixture missing (a) (c) (d) (f)` MEANS `o 58 r 3 particulars given` WITH
    `o 58 r 3(a) gives the date of the agreement and the parties to the agreement` IS FALSE
    `o 58 r 3(b) gives the goods let under the agreement` IS TRUE
    `o 58 r 3(c) gives the amount of the hire-purchase price` IS FALSE
    `o 58 r 3(d) gives the amount paid by or on behalf of the hirer` IS FALSE
    `o 58 r 3(e) an amount is claimed as due and unpaid` IS FALSE
    `o 58 r 3(e) gives that amount` IS FALSE
    `o 58 r 3(f) there is another claim` IS TRUE
    `o 58 r 3(f) gives the amount of that claim and the circumstances in which it arises` IS FALSE

-- The duty arises "Where the claimant's claim is for the recovery of money arising out of a hire-purchase agreement".
#ASSERT `o 58 r 3 the duty to give the particulars arises` TRUE EQUALS JUST TRUE
#ASSERT `o 58 r 3 the duty to give the particulars arises` FALSE EQUALS JUST FALSE

-- Nothing missing: the list is empty.
#ASSERT count (`o 58 r 3 the particulars still to be given` `o 58 r 3 fixture every particular given`) EQUALS 0
#ASSERT count (`o 58 r 3 the particulars still to be given` `o 58 r 3 fixture no (e) and no (f)`) EQUALS 0
-- Items (b) and (e) missing: two entries, each in the words of the rule.
#ASSERT count (`o 58 r 3 the particulars still to be given` `o 58 r 3 fixture missing (b) and (e)`) EQUALS 2
#ASSERT elem "the goods let under the agreement" (`o 58 r 3 the particulars still to be given` `o 58 r 3 fixture missing (b) and (e)`)
#ASSERT elem "the amount (if any) claimed as being due and unpaid in respect of any instalment or instalments of the hire-purchase price" (`o 58 r 3 the particulars still to be given` `o 58 r 3 fixture missing (b) and (e)`)
-- Items (a), (c), (d) and (f) missing: four entries.
#ASSERT count (`o 58 r 3 the particulars still to be given` `o 58 r 3 fixture missing (a) (c) (d) (f)`) EQUALS 4
#ASSERT elem "the amount of any other claim and the circumstances in which it arises" (`o 58 r 3 the particulars still to be given` `o 58 r 3 fixture missing (a) (c) (d) (f)`)
#ASSERT elem "the date of the agreement and the parties to the agreement" (`o 58 r 3 the particulars still to be given` `o 58 r 3 fixture missing (a) (c) (d) (f)`)

-- The claim is for money under a hire-purchase agreement and every particular is given: met.
#ASSERT `o 58 r 3 the statement of claim gives the particulars` TRUE `o 58 r 3 fixture every particular given` EQUALS JUST TRUE
#ASSERT `o 58 r 3 the statement of claim gives the particulars` TRUE `o 58 r 3 fixture no (e) and no (f)` EQUALS JUST TRUE
-- Some particular missing: a bare "must" not done.
#ASSERT `o 58 r 3 the statement of claim gives the particulars` TRUE `o 58 r 3 fixture missing (b) and (e)` EQUALS NOTHING
#ASSERT `o 58 r 3 the statement of claim gives the particulars` TRUE `o 58 r 3 fixture missing (a) (c) (d) (f)` EQUALS NOTHING
-- The claim is not for money under a hire-purchase agreement: the duty does not arise, so compliance is not asked.
#ASSERT `o 58 r 3 the statement of claim gives the particulars` FALSE `o 58 r 3 fixture missing (b) and (e)` EQUALS NOTHING
#ASSERT `o 58 r 3 the statement of claim gives the particulars` FALSE `o 58 r 3 fixture every particular given` EQUALS NOTHING
