IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc6-order-26`

-- Tests for roc6-order-26.l4 (Order 26, Registry and administration).
-- Every expected value is written from the text (lines 4050 to 4098 of the source), beside the assertion, before the code was run.
-- The last days are made up: Order 3, Rule 3 (roc1's range) counts them.

IMPORT `roc-definitions`

-- A court calendar with one made-up public holiday, Monday 10 August 2026.
`roc6 test 26 a calendar with one public holiday` MEANS `Court calendar` WITH
    `public holidays` IS LIST (Date 10 8 2026)


-- ---------------------------------------------------------------------------
§ `Tests -- Rule 1`
-- ---------------------------------------------------------------------------

-- The text names the office; the functions return it.  "the Chief Justice or the Presiding Judge of the State Courts (as the case may be)": the Chief Justice for the Supreme Court, the Presiding Judge for the State Courts.
#ASSERT `o 26 r 1(1) the office that directs the departments and functions of the Registry` `Supreme Court` EQUALS `o 26 r 1 the Chief Justice` -- (1): the office that directs, for the Supreme Court
#ASSERT `o 26 r 1(1) the office that directs the departments and functions of the Registry` `State Courts` EQUALS `o 26 r 1 the Presiding Judge of the State Courts` -- (1): the office that directs, for the State Courts
#ASSERT `o 26 r 1(2) the office to whom the Registrar must report and be responsible for the proper administration and functions of the Registry` `Supreme Court` EQUALS `o 26 r 1 the Chief Justice` -- (2): the office the Registrar reports to, for the Supreme Court
#ASSERT `o 26 r 1(2) the office to whom the Registrar must report and be responsible for the proper administration and functions of the Registry` `State Courts` EQUALS `o 26 r 1 the Presiding Judge of the State Courts` -- (2): the office the Registrar reports to, for the State Courts
#ASSERT `o 26 r 1(3) the office to whom the Chief Executive and the Assistant Chief Executives must report and be responsible for the proper discharge of the functions they manage` `Supreme Court` EQUALS `o 26 r 1 the Chief Justice` -- (3): the office the Chief Executive reports to, for the Supreme Court
#ASSERT `o 26 r 1(3) the office to whom the Chief Executive and the Assistant Chief Executives must report and be responsible for the proper discharge of the functions they manage` `State Courts` EQUALS `o 26 r 1 the Presiding Judge of the State Courts` -- (3): the office the Chief Executive reports to, for the State Courts
#ASSERT `o 26 r 1(3) the office may appoint a Chief Executive and one or more Assistant Chief Executives` `Supreme Court` `o 26 r 1 the Chief Justice` EQUALS JUST TRUE -- the Chief Justice, for the Registry of the Supreme Court
#ASSERT `o 26 r 1(3) the office may appoint a Chief Executive and one or more Assistant Chief Executives` `State Courts` `o 26 r 1 the Presiding Judge of the State Courts` EQUALS JUST TRUE -- the Presiding Judge of the State Courts, for the Registry of the State Courts: he or she may appoint a Chief Executive
#ASSERT `o 26 r 1(3) the office may appoint a Chief Executive and one or more Assistant Chief Executives` `State Courts` `o 26 r 1 the Chief Justice` EQUALS NOTHING -- "as the case may be": the Rule does not say whether the Chief Justice may appoint for the State Courts
#ASSERT `o 26 r 1(3) the office may appoint a Chief Executive and one or more Assistant Chief Executives` `Supreme Court` `o 26 r 1 the Presiding Judge of the State Courts` EQUALS NOTHING -- "as the case may be": the Rule does not say whether the Presiding Judge may appoint for the Supreme Court
#ASSERT `o 26 r 1(3) the office may appoint a Chief Executive and one or more Assistant Chief Executives` `Supreme Court` `o 26 r 1 someone else` EQUALS NOTHING -- the power is given to those two offices

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 2`
-- ---------------------------------------------------------------------------

-- arguments: the court system of the issuer; the Registrar issued the directions; the Chief Justice approved; the Presiding Judge of the State Courts approved
#ASSERT `o 26 r 2 the directions are issued under Order 26, Rule 2` `Supreme Court` TRUE TRUE FALSE EQUALS JUST TRUE -- the Supreme Court: the Registrar issued them with the Chief Justice's approval
#ASSERT `o 26 r 2 the directions are issued under Order 26, Rule 2` `Supreme Court` TRUE FALSE TRUE EQUALS NOTHING -- the Supreme Court: only the Presiding Judge of the State Courts approved, which is the wrong approver
#ASSERT `o 26 r 2 the directions are issued under Order 26, Rule 2` `Supreme Court` TRUE FALSE FALSE EQUALS NOTHING -- the Supreme Court: no approval
#ASSERT `o 26 r 2 the directions are issued under Order 26, Rule 2` `State Courts` TRUE FALSE TRUE EQUALS JUST TRUE -- the State Courts: the Registrar issued them with the Presiding Judge's approval
#ASSERT `o 26 r 2 the directions are issued under Order 26, Rule 2` `State Courts` TRUE TRUE FALSE EQUALS NOTHING -- the State Courts: only the Chief Justice approved
#ASSERT `o 26 r 2 the directions are issued under Order 26, Rule 2` `State Courts` TRUE FALSE FALSE EQUALS NOTHING -- the State Courts: no approval
#ASSERT `o 26 r 2 the directions are issued under Order 26, Rule 2` `Supreme Court` FALSE TRUE TRUE EQUALS NOTHING -- not issued by the Registrar: "The Registrar may issue practice directions" (the grant is limited by its own wording)
#ASSERT `o 26 r 2 the directions are issued under Order 26, Rule 2` `State Courts` FALSE TRUE TRUE EQUALS NOTHING -- not issued by the Registrar

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 3`
-- ---------------------------------------------------------------------------

#ASSERT `o 26 r 3(1) the Registry maintains the Court records and other documents` TRUE TRUE EQUALS JUST TRUE -- required or considered appropriate, and maintained
#ASSERT `o 26 r 3(1) the Registry maintains the Court records and other documents` TRUE FALSE EQUALS NOTHING -- "must maintain": silent on what follows
#ASSERT `o 26 r 3(1) the Registry maintains the Court records and other documents` FALSE TRUE EQUALS NOTHING -- not required or considered appropriate: the duty is limited by its own wording
#ASSERT `o 26 r 3(2) the Registry may collect, use or disclose the data` TRUE EQUALS JUST TRUE -- which the Registrar considers appropriate
#ASSERT `o 26 r 3(2) the Registry may collect, use or disclose the data` FALSE EQUALS NOTHING -- the grant is limited by its own wording
#ASSERT `o 26 r 3(3) the matter is in the discretion of the Registrar` `o 26 r 3(3) the method of collection` EQUALS JUST TRUE -- the method of collection
#ASSERT `o 26 r 3(3) the matter is in the discretion of the Registrar` `o 26 r 3(3) the storage` EQUALS JUST TRUE -- the storage
#ASSERT `o 26 r 3(3) the matter is in the discretion of the Registrar` `o 26 r 3(3) the period of storage` EQUALS JUST TRUE -- the period of storage
#ASSERT `o 26 r 3(3) the matter is in the discretion of the Registrar` `o 26 r 3(3) some other matter` EQUALS NOTHING -- the paragraph names three matters
#ASSERT `o 26 r 3(4) the Registrar may allow the person to search for, inspect and take a copy of the document` TRUE TRUE EQUALS JUST TRUE -- valid interest and the prescribed fee paid
#ASSERT `o 26 r 3(4) the Registrar may allow the person to search for, inspect and take a copy of the document` TRUE FALSE EQUALS JUST FALSE -- "if that person — (a) shows a valid interest ...; and (b) pays the prescribed fee": no fee
#ASSERT `o 26 r 3(4) the Registrar may allow the person to search for, inspect and take a copy of the document` FALSE TRUE EQUALS JUST FALSE -- no valid interest
#ASSERT `o 26 r 3(4) the Registrar may allow the person to search for, inspect and take a copy of the document` FALSE FALSE EQUALS JUST FALSE -- neither
#ASSERT `o 26 r 3(5) the Registrar may redact the document before a person searches for, inspects or takes a copy of it` TRUE EQUALS JUST TRUE -- in the interests of justice
#ASSERT `o 26 r 3(5) the Registrar may redact the document before a person searches for, inspects or takes a copy of it` FALSE EQUALS NOTHING -- the grant is limited by its own wording
#ASSERT `o 26 r 3(6) the document or record may be taken out of the Registry` TRUE EQUALS NOTHING -- with approval: the paragraph does not say that it may be taken out
#ASSERT `o 26 r 3(6) the document or record may be taken out of the Registry` FALSE EQUALS JUST FALSE -- "must not be taken out of the Registry without the Registrar's approval"
#ASSERT `o 26 r 3(7) the document filed in Court is typewritten, printed and complies with the practice directions` TRUE TRUE EQUALS JUST TRUE -- typewritten and printed, and complies
#ASSERT `o 26 r 3(7) the document filed in Court is typewritten, printed and complies with the practice directions` FALSE TRUE EQUALS NOTHING -- "must be typewritten and printed": silent on what follows
#ASSERT `o 26 r 3(7) the document filed in Court is typewritten, printed and complies with the practice directions` TRUE FALSE EQUALS NOTHING -- does not comply with the practice directions: silent on what follows
#ASSERT `o 26 r 3(8) the Registrar may authorise a person to provide the service` TRUE FALSE EQUALS NOTHING -- a service of the (a) kind only: the Rule describes a service that enables a subscriber to do (a) "; and" (b), so the grant is limited by its own wording
#ASSERT `o 26 r 3(8) the Registrar may authorise a person to provide the service` FALSE TRUE EQUALS NOTHING -- a service of the (b) kind only: the same
#ASSERT `o 26 r 3(8) the Registrar may authorise a person to provide the service` TRUE TRUE EQUALS JUST TRUE -- both (a) and (b)
#ASSERT `o 26 r 3(8) the Registrar may authorise a person to provide the service` FALSE FALSE EQUALS NOTHING -- neither: the grant is limited by its own wording
#ASSERT `o 26 r 3(9) the person authorised has paid the fees for access to the information and documents` TRUE EQUALS JUST TRUE -- the fees agreed have been paid
#ASSERT `o 26 r 3(9) the person authorised has paid the fees for access to the information and documents` FALSE EQUALS NOTHING -- "must pay": silent on what follows
#ASSERT `o 26 r 3(10) the subscriber may do this without paying the prescribed fee and without the Registrar's permission` TRUE `o 26 r 3(10)(a) search the information mentioned in paragraph (8)(a)` EQUALS JUST TRUE -- (a), while the service is in operation
#ASSERT `o 26 r 3(10) the subscriber may do this without paying the prescribed fee and without the Registrar's permission` TRUE `o 26 r 3(10)(b) search for, inspect or take a copy of a document mentioned in paragraph (8)(b)` EQUALS JUST TRUE -- (b), while the service is in operation
#ASSERT `o 26 r 3(10) the subscriber may do this without paying the prescribed fee and without the Registrar's permission` FALSE `o 26 r 3(10)(a) search the information mentioned in paragraph (8)(a)` EQUALS JUST FALSE -- (a), but the service is not in operation: "at any time when that service is in operation" (ruling (a))
#ASSERT `o 26 r 3(10) the subscriber may do this without paying the prescribed fee and without the Registrar's permission` FALSE `o 26 r 3(10)(b) search for, inspect or take a copy of a document mentioned in paragraph (8)(b)` EQUALS JUST FALSE -- (b), but the service is not in operation
#ASSERT `o 26 r 3(10) the subscriber may do this without paying the prescribed fee and without the Registrar's permission` TRUE `o 26 r 3(10) something else` EQUALS NOTHING -- the entitlement is to the two things named

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 4`
-- ---------------------------------------------------------------------------

#ASSERT `o 26 r 4(1) the Registry in which the document creating a power of attorney may be deposited` EQUALS "the Registry of the Supreme Court" -- where the document is deposited
-- arguments: how the execution is verified; accompanied by the evidence; a certified copy; the signature of the person who verified the copy is sufficiently verified
#ASSERT `o 26 r 4(1) the document creating a power of attorney may be deposited in the Registry of the Supreme Court` `o 26 r 4(1)(a)(i) an affidavit or a statutory declaration made by a witness to the execution or by an impartial person who knows the signature of the donor` TRUE FALSE FALSE EQUALS JUST TRUE -- (a)(i), accompanied, the original document
#ASSERT `o 26 r 4(1) the document creating a power of attorney may be deposited in the Registry of the Supreme Court` `o 26 r 4(1)(a)(ii) the signature of a commissioner for oaths as a witness to the execution` TRUE FALSE FALSE EQUALS JUST TRUE -- (a)(ii), accompanied, the original document
#ASSERT `o 26 r 4(1) the document creating a power of attorney may be deposited in the Registry of the Supreme Court` `o 26 r 4(1)(a)(iii) such other evidence which is satisfactory to the Registrar` TRUE FALSE FALSE EQUALS JUST TRUE -- (a)(iii), accompanied, the original document
#ASSERT `o 26 r 4(1) the document creating a power of attorney may be deposited in the Registry of the Supreme Court` `o 26 r 4(1)(a)(i) an affidavit or a statutory declaration made by a witness to the execution or by an impartial person who knows the signature of the donor` TRUE TRUE TRUE EQUALS JUST TRUE -- (c): a certified copy whose verifier's signature is sufficiently verified
#ASSERT `o 26 r 4(1) the document creating a power of attorney may be deposited in the Registry of the Supreme Court` `o 26 r 4(1)(a)(i) an affidavit or a statutory declaration made by a witness to the execution or by an impartial person who knows the signature of the donor` TRUE TRUE FALSE EQUALS JUST FALSE -- (c): a certified copy whose verifier's signature is not sufficiently verified
#ASSERT `o 26 r 4(1) the document creating a power of attorney may be deposited in the Registry of the Supreme Court` `o 26 r 4(1)(a) in none of these ways` TRUE FALSE FALSE EQUALS JUST FALSE -- (a): the execution is not verified in any of the three ways
#ASSERT `o 26 r 4(1) the document creating a power of attorney may be deposited in the Registry of the Supreme Court` `o 26 r 4(1)(a)(i) an affidavit or a statutory declaration made by a witness to the execution or by an impartial person who knows the signature of the donor` FALSE FALSE FALSE EQUALS JUST FALSE -- (b): the evidence does not accompany the document
#ASSERT `o 26 r 4(2) the Registry of the Supreme Court maintains the index` TRUE TRUE EQUALS JUST TRUE -- an index of the documents and of the names of the donors
#ASSERT `o 26 r 4(2) the Registry of the Supreme Court maintains the index` FALSE TRUE EQUALS NOTHING -- "must maintain": silent on what follows
#ASSERT `o 26 r 4(2) the Registry of the Supreme Court maintains the index` TRUE FALSE EQUALS NOTHING -- the index lacks the names of the donors
#ASSERT `o 26 r 4(3) the person is entitled to do this` TRUE `o 26 r 4(3)(a) search the index mentioned in paragraph (2)` EQUALS JUST TRUE -- (a), on payment of the prescribed fee
#ASSERT `o 26 r 4(3) the person is entitled to do this` FALSE `o 26 r 4(3)(a) search the index mentioned in paragraph (2)` EQUALS JUST FALSE -- (a), no payment: "on payment of the prescribed fee"
#ASSERT `o 26 r 4(3) the person is entitled to do this` TRUE `o 26 r 4(3)(b) inspect a document filed or deposited in the Registry in accordance with paragraph (1)` EQUALS JUST TRUE -- (b), on payment of the prescribed fee
#ASSERT `o 26 r 4(3) the person is entitled to do this` FALSE `o 26 r 4(3)(b) inspect a document filed or deposited in the Registry in accordance with paragraph (1)` EQUALS JUST FALSE -- (b), no payment: "on payment of the prescribed fee"
#ASSERT `o 26 r 4(3) the person is entitled to do this` TRUE `o 26 r 4(3)(c) be supplied with a copy or a certified copy of such a document` EQUALS JUST TRUE -- (c), on payment of the prescribed fee
#ASSERT `o 26 r 4(3) the person is entitled to do this` FALSE `o 26 r 4(3)(c) be supplied with a copy or a certified copy of such a document` EQUALS JUST FALSE -- (c), no payment: "on payment of the prescribed fee"
#ASSERT `o 26 r 4(3) the person is entitled to do this` TRUE `o 26 r 4(3) something else` EQUALS NOTHING -- the entitlement is to the three things named

-- ---------------------------------------------------------------------------
§ `Tests -- Rules 5 and 6`
-- ---------------------------------------------------------------------------

-- arguments: the day; the calendar.  Friday 7 August 2026 is an ordinary day, 8 and 9 August are a Saturday and a Sunday, Monday 10 August is the holiday in the calendar above, Tuesday 11 August is an ordinary day.
#ASSERT `o 26 r 5(1) the Registry must be open on the day` (Date 7 8 2026) `roc6 test 26 a calendar with one public holiday` EQUALS JUST TRUE -- a Friday that is not a public holiday
#ASSERT `o 26 r 5(1) the Registry must be open on the day` (Date 8 8 2026) `roc6 test 26 a calendar with one public holiday` EQUALS JUST FALSE -- a Saturday: "except non‑court days"
#ASSERT `o 26 r 5(1) the Registry must be open on the day` (Date 9 8 2026) `roc6 test 26 a calendar with one public holiday` EQUALS JUST FALSE -- a Sunday
#ASSERT `o 26 r 5(1) the Registry must be open on the day` (Date 10 8 2026) `roc6 test 26 a calendar with one public holiday` EQUALS JUST FALSE -- a public holiday
#ASSERT `o 26 r 5(1) the Registry must be open on the day` (Date 11 8 2026) `roc6 test 26 a calendar with one public holiday` EQUALS JUST TRUE -- the Tuesday after
-- arguments: during the Court vacations; the Registrar considers the matter urgent; a Judge is available
#ASSERT `o 26 r 6 a Judge is available during the Court vacations to hear the matter` TRUE TRUE TRUE EQUALS JUST TRUE -- vacation, urgent, a Judge available
#ASSERT `o 26 r 6 a Judge is available during the Court vacations to hear the matter` TRUE TRUE FALSE EQUALS NOTHING -- vacation, urgent, no Judge: "must be" is silent on what follows
#ASSERT `o 26 r 6 a Judge is available during the Court vacations to hear the matter` TRUE FALSE FALSE EQUALS NOTHING -- vacation, not urgent: "to hear such matters as the Registrar considers urgent" is a scope limit with no "only" (ruling (c))
#ASSERT `o 26 r 6 a Judge is available during the Court vacations to hear the matter` FALSE TRUE TRUE EQUALS JUST FALSE -- not in the vacations: the Rule is for "during the Court vacations", a period the text names (ruling (a); "during" read as a period fixed in the text's own words, assumed)
#ASSERT `o 26 r 6 a Judge is available during the Court vacations to hear the matter` FALSE FALSE FALSE EQUALS JUST FALSE -- not in the vacations, not urgent
