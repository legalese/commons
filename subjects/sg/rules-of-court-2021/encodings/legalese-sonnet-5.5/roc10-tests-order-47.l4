IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc10-order-47`

-- Rules of Court 2021 (Singapore), Order 47 (Income Tax Act): TESTS.
-- Every expected value is written beside its assertion from the text of the rule it cites (lines 6175 to 6215 of the text),
-- never copied from the output of the code.

-- ---------------------------------------------------------------------------
-- Rule 1 (lines 6178 to 6181): definitions.
-- ---------------------------------------------------------------------------
#ASSERT `o 47 r 1(1) an instrument is the Act` TRUE EQUALS JUST TRUE -- "“Act” means the Income Tax Act"
#ASSERT `o 47 r 1(1) an instrument is the Act` FALSE EQUALS JUST FALSE -- another instrument is not the Act
#ASSERT `o 47 r 1(1) a reference to a section is a reference to a section in the Income Tax Act` TRUE EQUALS JUST TRUE -- "any reference to a section is a reference to a section in the Act"
#ASSERT `o 47 r 1(1) a reference to a section is a reference to a section in the Income Tax Act` FALSE EQUALS NOTHING -- some other kind of reference: the rule of reading does not speak
-- proceedings to which this Order applies: (review of a power under s 65, 65A or 65B for a s 105D(1) request) or (an application relating to such proceedings)
#ASSERT `o 47 r 1(1) proceedings are proceedings to which this Order applies` TRUE `o 47 r 1(1) a power under section 65` TRUE FALSE EQUALS JUST TRUE -- review of a section 65 power for a section 105D(1) request
#ASSERT `o 47 r 1(1) proceedings are proceedings to which this Order applies` TRUE `o 47 r 1(1) a power under section 65A` TRUE FALSE EQUALS JUST TRUE -- section 65A
#ASSERT `o 47 r 1(1) proceedings are proceedings to which this Order applies` TRUE `o 47 r 1(1) a power under section 65B` TRUE FALSE EQUALS JUST TRUE -- section 65B
#ASSERT `o 47 r 1(1) proceedings are proceedings to which this Order applies` TRUE `o 47 r 1(1) any other power` TRUE FALSE EQUALS JUST FALSE -- a power under another section
#ASSERT `o 47 r 1(1) proceedings are proceedings to which this Order applies` TRUE `o 47 r 1(1) a power under section 65` FALSE FALSE EQUALS JUST FALSE -- the information was not to be obtained for a section 105D(1) request
#ASSERT `o 47 r 1(1) proceedings are proceedings to which this Order applies` FALSE `o 47 r 1(1) any other power` FALSE TRUE EQUALS JUST TRUE -- "any application relating to such proceedings"
#ASSERT `o 47 r 1(1) proceedings are proceedings to which this Order applies` FALSE `o 47 r 1(1) any other power` FALSE FALSE EQUALS JUST FALSE -- neither limb
#ASSERT `o 47 r 1(1) a request is the subject request` TRUE TRUE TRUE EQUALS JUST TRUE -- all three conditions
#ASSERT `o 47 r 1(1) a request is the subject request` TRUE TRUE FALSE EQUALS JUST FALSE -- the exercise of the power is not the subject of the proceedings
#ASSERT `o 47 r 1(1) a request is the subject request` FALSE TRUE TRUE EQUALS JUST FALSE -- not a request under section 105D(1)
#ASSERT `o 47 r 1(1) a request is the subject request` TRUE FALSE TRUE EQUALS JUST FALSE -- no power under section 65, 65A or 65B was exercised for it
#ASSERT `o 47 r 1(2) the expression has the same meaning in this Order as in Part XXA of the Act` TRUE TRUE EQUALS JUST TRUE -- an expression used in both
#ASSERT `o 47 r 1(2) the expression has the same meaning in this Order as in Part XXA of the Act` TRUE FALSE EQUALS NOTHING -- not used in Part XXA: the rule does not speak
#ASSERT `o 47 r 1(2) the expression has the same meaning in this Order as in Part XXA of the Act` FALSE TRUE EQUALS NOTHING -- not used in this Order
#ASSERT `o 47 r 1(2) the meaning of an expression in this Order is its meaning in Part XXA of the Act` TRUE TRUE (JUST "a meaning given in the Act") EQUALS JUST "a meaning given in the Act" -- the meaning is taken from the Act
#ASSERT `o 47 r 1(2) the meaning of an expression in this Order is its meaning in Part XXA of the Act` TRUE FALSE (JUST "a meaning given in the Act") EQUALS NOTHING -- an expression not used in Part XXA

-- ---------------------------------------------------------------------------
-- Rule 2 (lines 6183 to 6194): documents not to be inspected or produced.
-- ---------------------------------------------------------------------------
#ASSERT `o 47 r 2(1) a person is barred from inspecting or taking a copy of the document` TRUE TRUE FALSE EQUALS JUST TRUE -- a document relating to such proceedings, no permission
#ASSERT `o 47 r 2(1) a person is barred from inspecting or taking a copy of the document` TRUE TRUE TRUE EQUALS JUST FALSE -- "without the permission of the Court": permission lifts the bar
#ASSERT `o 47 r 2(1) a person is barred from inspecting or taking a copy of the document` FALSE TRUE FALSE EQUALS NOTHING -- not proceedings to which this Order applies
#ASSERT `o 47 r 2(1) a person is barred from inspecting or taking a copy of the document` TRUE FALSE FALSE EQUALS NOTHING -- a document not relating to those proceedings
#ASSERT `o 47 r 2(1) a person may inspect or take a copy of the document` TRUE TRUE FALSE EQUALS JUST FALSE -- "no person may inspect or take a copy ... without the permission of the Court"
#ASSERT `o 47 r 2(1) a person may inspect or take a copy of the document` TRUE TRUE TRUE EQUALS NOTHING -- permission given: the exception lifts the bar and grants nothing (QA)
#ASSERT `o 47 r 2(1) a person may inspect or take a copy of the document` FALSE TRUE FALSE EQUALS NOTHING -- the bar does not reach this document
#ASSERT `o 47 r 2(2) the Court must not grant permission under paragraph (1)` TRUE TRUE EQUALS JUST TRUE -- a paragraph (4) document and the authority asked for non-disclosure
#ASSERT `o 47 r 2(2) the Court must not grant permission under paragraph (1)` TRUE FALSE EQUALS JUST FALSE -- the authority made no such request: the "if" fails
#ASSERT `o 47 r 2(2) the Court must not grant permission under paragraph (1)` FALSE TRUE EQUALS JUST FALSE -- not a paragraph (4) document: the "if" fails
#ASSERT `o 47 r 2(2) the Court may grant permission under paragraph (1)` TRUE TRUE EQUALS JUST FALSE -- "The Court must not grant permission"
#ASSERT `o 47 r 2(2) the Court may grant permission under paragraph (1)` TRUE FALSE EQUALS NOTHING -- the paragraph forbids in the stated case and grants no power otherwise
#ASSERT `o 47 r 2(3) the Comptroller may be ordered to give production of or produce for inspection the document` TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- "The Comptroller may not ... be ordered ... if"
#ASSERT `o 47 r 2(3) the Comptroller may be ordered to give production of or produce for inspection the document` TRUE TRUE TRUE FALSE EQUALS NOTHING -- the authority made no request: the paragraph forbids only in the stated case
#ASSERT `o 47 r 2(3) the Comptroller may be ordered to give production of or produce for inspection the document` TRUE FALSE TRUE TRUE EQUALS NOTHING -- not proceedings under Order 11
#ASSERT `o 47 r 2(3) the Comptroller may be ordered to give production of or produce for inspection the document` FALSE TRUE TRUE TRUE EQUALS NOTHING -- not proceedings to which this Order applies
#ASSERT `o 47 r 2(3) production of the document by the Comptroller is barred` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- the bar bites: a paragraph (4) document and the competent authority has asked for non-disclosure
#ASSERT `o 47 r 2(3) production of the document by the Comptroller is barred` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- the competent authority made no request: the "if" is not met
#ASSERT `o 47 r 2(3) production of the document by the Comptroller is barred` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- not a document referred to in paragraph (4)
#ASSERT `o 47 r 2(3) production of the document by the Comptroller is barred` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- neither limb of the "if" is met
#ASSERT `o 47 r 2(3) production of the document by the Comptroller is barred` TRUE FALSE TRUE TRUE EQUALS NOTHING -- not proceedings under Order 11: the paragraph does not speak
#ASSERT `o 47 r 2(3) production of the document by the Comptroller is barred` FALSE TRUE TRUE TRUE EQUALS NOTHING -- not proceedings to which this Order applies
#ASSERT `o 47 r 2(4) paragraphs (2) and (3) apply to the document` TRUE FALSE EQUALS JUST TRUE -- the subject request itself
#ASSERT `o 47 r 2(4) paragraphs (2) and (3) apply to the document` FALSE TRUE EQUALS JUST TRUE -- a document relating to the subject request given by or to the Comptroller, to or by the competent authority
#ASSERT `o 47 r 2(4) paragraphs (2) and (3) apply to the document` FALSE FALSE EQUALS NOTHING -- the list is not closed: no "only"

-- ---------------------------------------------------------------------------
-- Rule 3 (lines 6196 to 6202): publication.
-- ---------------------------------------------------------------------------
#ASSERT `o 47 r 3(1) publication of the information is barred` TRUE TRUE FALSE EQUALS JUST TRUE -- information relating to such proceedings, no permission
#ASSERT `o 47 r 3(1) publication of the information is barred` TRUE TRUE TRUE EQUALS JUST FALSE -- permission lifts the bar
#ASSERT `o 47 r 3(1) publication of the information is barred` FALSE TRUE FALSE EQUALS NOTHING -- not proceedings to which this Order applies
#ASSERT `o 47 r 3(1) the information may be published` TRUE TRUE FALSE EQUALS JUST FALSE -- "no information ... may be published without the permission of the Court"
#ASSERT `o 47 r 3(1) the information may be published` TRUE TRUE TRUE EQUALS NOTHING -- permission given: paragraph (2) governs the permission; this grants nothing (QA)
#ASSERT `o 47 r 3(2) the Court is barred from granting permission under paragraph (1)` FALSE EQUALS JUST TRUE -- the Court is not satisfied: "must not grant permission ... unless"
#ASSERT `o 47 r 3(2) the Court is barred from granting permission under paragraph (1)` TRUE EQUALS JUST FALSE -- the Court is satisfied: the bar is lifted
#ASSERT `o 47 r 3(2) the Court may grant permission under paragraph (1)` FALSE EQUALS JUST FALSE -- "The Court must not grant permission ... unless the Court is satisfied"
#ASSERT `o 47 r 3(2) the Court may grant permission under paragraph (1)` TRUE EQUALS NOTHING -- satisfied: the bar is lifted and the paragraph grants nothing (QA)

-- ---------------------------------------------------------------------------
-- Rule 4 (line 6204): confidentiality.
-- ---------------------------------------------------------------------------
#ASSERT `o 47 r 4(1) the Court may make a further order to ensure the confidentiality of anything relating to the proceedings` TRUE TRUE EQUALS JUST TRUE -- on the Comptroller's application in proceedings to which this Order applies
#ASSERT `o 47 r 4(1) the Court may make a further order to ensure the confidentiality of anything relating to the proceedings` TRUE FALSE EQUALS NOTHING -- not on the Comptroller's application
#ASSERT `o 47 r 4(1) the Court may make a further order to ensure the confidentiality of anything relating to the proceedings` FALSE TRUE EQUALS NOTHING -- not proceedings to which this Order applies
#ASSERT `o 47 r 4(2) the duty to seal the document arises` TRUE TRUE EQUALS JUST TRUE -- filed for such proceedings, sealing requested
#ASSERT `o 47 r 4(2) the duty to seal the document arises` TRUE FALSE EQUALS JUST FALSE -- no request by the applicant or the Comptroller (a request by anyone else is not one): "upon the request" counts as "where" (fork 47.2)
#ASSERT `o 47 r 4(2) the duty to seal the document arises` FALSE TRUE EQUALS NOTHING -- not a document filed for such proceedings
#ASSERT `o 47 r 4(2) the document has been sealed as required` TRUE TRUE TRUE EQUALS JUST TRUE -- duty arose and the document is sealed
#ASSERT `o 47 r 4(2) the document has been sealed as required` TRUE TRUE FALSE EQUALS NOTHING -- duty arose and the document has not been sealed: a bare "must"
#ASSERT `o 47 r 4(2) the document has been sealed as required` TRUE FALSE FALSE EQUALS NOTHING -- no request, so no duty to comply with
#ASSERT `o 47 r 4(2) the document has been sealed as required` FALSE TRUE TRUE EQUALS NOTHING -- the duty is not engaged

-- ---------------------------------------------------------------------------
-- Rule 5 (lines 6206 to 6213): application for permission.
-- ---------------------------------------------------------------------------
#ASSERT `o 47 r 5(1) the application for permission is supported by an affidavit as it must be` TRUE TRUE EQUALS JUST TRUE -- supported by an affidavit
#ASSERT `o 47 r 5(1) the application for permission is supported by an affidavit as it must be` TRUE FALSE EQUALS NOTHING -- not supported: a bare "must"
#ASSERT `o 47 r 5(1) the application for permission is supported by an affidavit as it must be` FALSE TRUE EQUALS NOTHING -- not an application under this Order
-- (2): 28 days before the hearing; hearing on 30 June 2026 (Tuesday): the period ends immediately before that date (O 3 r 3(4)), and 28 days back is 2 June 2026 (Tuesday)
#ASSERT `o 47 r 5(2) the period before the hearing`'s `period length` EQUALS 28 -- "at least 28 days"
#ASSERT `o 47 r 5(2) the period before the hearing`'s `period direction` EQUALS `Before the anchor` -- "before the date fixed for the hearing"
#ASSERT `o 47 r 5(2) the duty to file and serve the application and affidavit on the person arises` `o 47 r 5(2)(a) the Comptroller` FALSE EQUALS JUST TRUE -- the Comptroller is not the applicant
#ASSERT `o 47 r 5(2) the duty to file and serve the application and affidavit on the person arises` `o 47 r 5(2)(c) the person in relation to whom information is sought` TRUE EQUALS JUST FALSE -- "unless that person is the applicant himself or herself"
#ASSERT `o 47 r 5(2) the application and affidavit have been filed and served on the person as required` `o 47 r 5(2)(a) the Comptroller` FALSE (Date 2 6 2026) (Date 2 6 2026) EQUALS JUST TRUE -- served on the last day
#ASSERT `o 47 r 5(2) the application and affidavit have been filed and served on the person as required` `o 47 r 5(2)(b) the person from whom the Comptroller obtains the information` FALSE (Date 1 6 2026) (Date 2 6 2026) EQUALS JUST TRUE -- served a day before the last day
#ASSERT `o 47 r 5(2) the application and affidavit have been filed and served on the person as required` `o 47 r 5(2)(a) the Comptroller` FALSE (Date 3 6 2026) (Date 2 6 2026) EQUALS JUST FALSE -- served a day too late
#ASSERT `o 47 r 5(2) the application and affidavit have been filed and served on the person as required` `o 47 r 5(2)(c) the person in relation to whom information is sought` TRUE (Date 29 6 2026) (Date 2 6 2026) EQUALS NOTHING -- the person is the applicant: nothing to serve
-- (3): 14 days after service of the applicant's affidavit; served 2 June 2026, so the 14 days begin on 3 June and end on 16 June 2026 (Tuesday)
#ASSERT `o 47 r 5(3) the period for the reply`'s `period length` EQUALS 14 -- "within 14 days"
#ASSERT `o 47 r 5(3) the duty to file and serve an affidavit in reply arises` TRUE TRUE EQUALS JUST TRUE -- served and wishes to reply
#ASSERT `o 47 r 5(3) the duty to file and serve an affidavit in reply arises` TRUE FALSE EQUALS JUST FALSE -- "if the person wishes to reply"
#ASSERT `o 47 r 5(3) the duty to file and serve an affidavit in reply arises` FALSE TRUE EQUALS NOTHING -- not a person served under paragraph (2)
#ASSERT `o 47 r 5(3) the affidavit in reply has been filed and served in time` TRUE TRUE (Date 16 6 2026) (Date 16 6 2026) EQUALS JUST TRUE -- on the last day
#ASSERT `o 47 r 5(3) the affidavit in reply has been filed and served in time` TRUE TRUE (Date 17 6 2026) (Date 16 6 2026) EQUALS JUST FALSE -- a day too late
#ASSERT `o 47 r 5(3) the affidavit in reply has been filed and served in time` TRUE FALSE (Date 17 6 2026) (Date 16 6 2026) EQUALS NOTHING -- the person does not wish to reply: nothing to comply with
#ASSERT `o 47 r 5(3) the affidavit in reply has been filed and served in time` FALSE TRUE (Date 17 6 2026) (Date 16 6 2026) EQUALS NOTHING -- the person was not served
#ASSERT `o 47 r 5(4) the application must be heard by a Judge in Chambers` TRUE EQUALS JUST TRUE -- an application for permission under this Order
#ASSERT `o 47 r 5(4) the application must be heard by a Judge in Chambers` FALSE EQUALS NOTHING -- not such an application
#ASSERT `o 47 r 5(4) the application is heard by a Judge in Chambers as it must be` TRUE (Sitting OF `General Division`, `A Judge`) TRUE EQUALS JUST TRUE -- heard in Chambers by a Judge
#ASSERT `o 47 r 5(4) the application is heard by a Judge in Chambers as it must be` TRUE (Sitting OF `General Division`, `A Judge`) FALSE EQUALS NOTHING -- heard in open court: a bare "must", not done
#ASSERT `o 47 r 5(4) the application is heard by a Judge in Chambers as it must be` TRUE (Sitting OF `General Division`, `The Registrar`) TRUE EQUALS NOTHING -- heard by the Registrar, not a Judge: a bare "must", not done
#ASSERT `o 47 r 5(4) the application is heard by a Judge in Chambers as it must be` FALSE (Sitting OF `General Division`, `A Judge`) TRUE EQUALS NOTHING -- not an application for permission under this Order

-- ---------------------------------------------------------------------------
-- Rule 6 (line 6215): Order 26, Rule 3 does not apply.
-- ---------------------------------------------------------------------------
#ASSERT `o 47 r 6 Order 26, Rule 3 applies in relation to the proceedings` TRUE EQUALS JUST FALSE -- "Order 26, Rule 3 does not apply in relation to any proceedings to which this Order applies"
#ASSERT `o 47 r 6 Order 26, Rule 3 applies in relation to the proceedings` FALSE EQUALS NOTHING -- the rule speaks only of proceedings to which this Order applies
