    WHEN `o 21 r 22(4) it indicates a basis other than the standard basis or the indemnity basis` THEN JUST `o 21 r 22(2) the standard basis`
    WHEN `o 21 r 22(4) it indicates the standard basis` THEN NOTHING -- NOTHING-kind (silent): paragraph (4) speaks only of an order that gives no basis or another basis
    WHEN `o 21 r 22(4) it indicates the indemnity basis` THEN NOTHING -- NOTHING-kind (silent): paragraph (4) speaks only of an order that gives no basis or another basis

