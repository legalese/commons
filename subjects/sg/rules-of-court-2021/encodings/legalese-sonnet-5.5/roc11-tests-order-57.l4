IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc11-order-57`

-- TESTS for Order 57 (Personal Data Protection Act 2012).  Every expected value is written from the text of
-- the rule, beside the assertion, before the code was run.  The "last day" inputs are made-up dates: the
-- merged file replaces them with calls to roc1's O 3 r 3.

-- ---------------------------------------------------------------------------
§ `Order 57 rule 1 -- definitions`
-- ---------------------------------------------------------------------------
-- "Act" means the Personal Data Protection Act 2012.
#ASSERT (`o 57 r 1 the meaning of the defined term` `o 57 r 1 Act`)'s `o 57 r 1 means` EQUALS "the Personal Data Protection Act 2012"
-- "Appeal Committee" means a Data Protection Appeal Committee nominated under section 48P(4).
#ASSERT (`o 57 r 1 the meaning of the defined term` `o 57 r 1 Appeal Committee`)'s `o 57 r 1 means` EQUALS "a Data Protection Appeal Committee nominated under section 48P(4)"
#ASSERT (`o 57 r 1 the meaning of the defined term` `o 57 r 1 Appeal Committee`)'s `o 57 r 1 points at` EQUALS "section 48P(4) of the Act"
-- "Commission" means the Personal Data Protection Commission established by section 5.
#ASSERT (`o 57 r 1 the meaning of the defined term` `o 57 r 1 Commission`)'s `o 57 r 1 means` EQUALS "the Personal Data Protection Commission established by section 5"
#ASSERT (`o 57 r 1 the meaning of the defined term` `o 57 r 1 Commission`)'s `o 57 r 1 the term` EQUALS "Commission"
-- "any reference to a section is a reference to a section in the Act".
#ASSERT `o 57 r 1 a reference to a section is a reference to a section in the Act` TRUE FALSE EQUALS JUST TRUE
-- A reference that is not to a section is not within the sentence.
#ASSERT `o 57 r 1 a reference to a section is a reference to a section in the Act` FALSE FALSE EQUALS NOTHING
-- A reference to a section that names another Act expressly: the Rule is silent.
#ASSERT `o 57 r 1 a reference to a section is a reference to a section in the Act` TRUE TRUE EQUALS NOTHING
-- Membership: "Appeal Committee" means a Data Protection Appeal Committee nominated under section 48P(4); a body that is not one is outside the term (JUST FALSE).
#ASSERT `o 57 r 1 the panel is an Appeal Committee` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 1 the panel is an Appeal Committee` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 57 r 1 the panel is an Appeal Committee` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 57 r 1 the panel is an Appeal Committee` FALSE FALSE EQUALS JUST FALSE
-- "Commission" means the Personal Data Protection Commission established by section 5; any other body is outside the term (JUST FALSE).
#ASSERT `o 57 r 1 the body is the Commission` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 1 the body is the Commission` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 57 r 1 the body is the Commission` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 57 r 1 the body is the Commission` FALSE FALSE EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§ `Order 57 rule 2 -- who may exercise the powers under section 48M`
-- ---------------------------------------------------------------------------
-- (1): a District Judge in chambers or the Registrar, for the powers other than section 48M(4).
#ASSERT `o 57 r 2(1) the power under section 48M may be exercised by the person` FALSE `A District Judge` TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 2(1) the power under section 48M may be exercised by the person` FALSE `The Registrar` FALSE EQUALS JUST TRUE
#ASSERT `o 57 r 2(1) the power under section 48M may be exercised by the person` FALSE `A District Judge` FALSE EQUALS NOTHING
#ASSERT `o 57 r 2(1) the power under section 48M may be exercised by the person` FALSE `A Magistrate` TRUE EQUALS NOTHING
-- (1) is "Subject to paragraph (2)": it does not grant the section 48M(4) powers.
#ASSERT `o 57 r 2(1) the power under section 48M may be exercised by the person` TRUE `The Registrar` TRUE EQUALS NOTHING
-- (2): the section 48M(4) powers "may only be exercised by a District Judge".
#ASSERT `o 57 r 2(2) the power under section 48M(4) may be exercised by the person` TRUE `A District Judge` EQUALS JUST TRUE
#ASSERT `o 57 r 2(2) the power under section 48M(4) may be exercised by the person` TRUE `The Registrar` EQUALS JUST FALSE
#ASSERT `o 57 r 2(2) the power under section 48M(4) may be exercised by the person` TRUE `A Judge` EQUALS JUST FALSE
#ASSERT `o 57 r 2(2) the power under section 48M(4) may be exercised by the person` FALSE `The Registrar` EQUALS NOTHING
-- Paragraphs (1) and (2) gathered by hand.
#ASSERT `o 57 r 2 the power under section 48M may be exercised by the person` TRUE `The Registrar` TRUE EQUALS JUST FALSE
#ASSERT `o 57 r 2 the power under section 48M may be exercised by the person` TRUE `A District Judge` FALSE EQUALS JUST TRUE
#ASSERT `o 57 r 2 the power under section 48M may be exercised by the person` FALSE `The Registrar` FALSE EQUALS JUST TRUE
#ASSERT `o 57 r 2 the power under section 48M may be exercised by the person` FALSE `A District Judge` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 57 rule 3 -- application to register`
-- ---------------------------------------------------------------------------
`o 57 r 3 fixture direction under 48H(2)` MEANS `o 57 r 3 instrument` OF `o 57 r 3 the Commission`, `o 57 r 3 section 48H(2)`, TRUE, FALSE, FALSE, FALSE
`o 57 r 3 fixture direction under 48I` MEANS `o 57 r 3 instrument` OF `o 57 r 3 the Commission`, `o 57 r 3 section 48I`, TRUE, FALSE, FALSE, FALSE
`o 57 r 3 fixture direction under 48L(4)` MEANS `o 57 r 3 instrument` OF `o 57 r 3 the Commission`, `o 57 r 3 section 48L(4)`, TRUE, FALSE, FALSE, FALSE
`o 57 r 3 fixture direction varied under 48N(6)(b)(i)` MEANS `o 57 r 3 instrument` OF `o 57 r 3 the Commission`, `o 57 r 3 section 48N(6)(b)(i)`, TRUE, FALSE, FALSE, FALSE
`o 57 r 3 fixture direction under another provision` MEANS `o 57 r 3 instrument` OF `o 57 r 3 the Commission`, `o 57 r 3 another provision`, TRUE, FALSE, FALSE, FALSE
`o 57 r 3 fixture notice for penalty and interest` MEANS `o 57 r 3 instrument` OF `o 57 r 3 the Commission`, `o 57 r 3 another provision`, FALSE, TRUE, TRUE, TRUE
`o 57 r 3 fixture notice for penalty alone` MEANS `o 57 r 3 instrument` OF `o 57 r 3 the Commission`, `o 57 r 3 another provision`, FALSE, TRUE, TRUE, FALSE
`o 57 r 3 fixture notice by someone else` MEANS `o 57 r 3 instrument` OF `o 57 r 3 someone else`, `o 57 r 3 another provision`, FALSE, TRUE, TRUE, TRUE
`o 57 r 3 fixture decision under 48Q(5)` MEANS `o 57 r 3 instrument` OF `o 57 r 3 an Appeal Committee`, `o 57 r 3 section 48Q(5)`, TRUE, FALSE, FALSE, FALSE
`o 57 r 3 fixture appeal committee under another provision` MEANS `o 57 r 3 instrument` OF `o 57 r 3 an Appeal Committee`, `o 57 r 3 another provision`, TRUE, FALSE, FALSE, FALSE
`o 57 r 3 fixture decision made by the Commission under 48Q(5)` MEANS `o 57 r 3 instrument` OF `o 57 r 3 the Commission`, `o 57 r 3 section 48Q(5)`, TRUE, FALSE, FALSE, FALSE

-- (a): directions by the Commission under section 48H(2), 48I or 48L(4), including one varied under section 48N(6)(b)(i).
#ASSERT `o 57 r 3(a) the instrument is a Direction` `o 57 r 3 fixture direction under 48H(2)` EQUALS JUST TRUE
#ASSERT `o 57 r 3(a) the instrument is a Direction` `o 57 r 3 fixture direction under 48I` EQUALS JUST TRUE
#ASSERT `o 57 r 3(a) the instrument is a Direction` `o 57 r 3 fixture direction under 48L(4)` EQUALS JUST TRUE
#ASSERT `o 57 r 3(a) the instrument is a Direction` `o 57 r 3 fixture direction varied under 48N(6)(b)(i)` EQUALS JUST TRUE
-- A direction under another provision: "called ... a Direction" names the listed ones and says nothing of others.
#ASSERT `o 57 r 3(a) the instrument is a Direction` `o 57 r 3 fixture direction under another provision` EQUALS NOTHING
#ASSERT `o 57 r 3(a) the instrument is a Direction` `o 57 r 3 fixture decision under 48Q(5)` EQUALS NOTHING
-- (b): a written notice by the Commission for a sum comprising a penalty and the interest on it.
#ASSERT `o 57 r 3(b) the instrument is a Notice` `o 57 r 3 fixture notice for penalty and interest` EQUALS JUST TRUE
#ASSERT `o 57 r 3(b) the instrument is a Notice` `o 57 r 3 fixture notice for penalty alone` EQUALS NOTHING
#ASSERT `o 57 r 3(b) the instrument is a Notice` `o 57 r 3 fixture notice by someone else` EQUALS NOTHING
-- (c): a direction or decision of an Appeal Committee under section 48Q(5).
#ASSERT `o 57 r 3(c) the instrument is a Decision` `o 57 r 3 fixture decision under 48Q(5)` EQUALS JUST TRUE
#ASSERT `o 57 r 3(c) the instrument is a Decision` `o 57 r 3 fixture appeal committee under another provision` EQUALS NOTHING
#ASSERT `o 57 r 3(c) the instrument is a Decision` `o 57 r 3 fixture decision made by the Commission under 48Q(5)` EQUALS NOTHING
-- The scope of the Rule.
#ASSERT `o 57 r 3 the instrument is a Direction, a Notice or a Decision` `o 57 r 3 fixture direction under 48I` EQUALS TRUE
#ASSERT `o 57 r 3 the instrument is a Direction, a Notice or a Decision` `o 57 r 3 fixture notice for penalty and interest` EQUALS TRUE
#ASSERT `o 57 r 3 the instrument is a Direction, a Notice or a Decision` `o 57 r 3 fixture decision under 48Q(5)` EQUALS TRUE
#ASSERT `o 57 r 3 the instrument is a Direction, a Notice or a Decision` `o 57 r 3 fixture notice by someone else` EQUALS FALSE
-- The mode: "must be made by originating application without notice".
#ASSERT `o 57 r 3 the application to register is made in the way the Rule requires` `o 57 r 3 fixture direction under 48I` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 3 the application to register is made in the way the Rule requires` `o 57 r 3 fixture notice for penalty and interest` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 3 the application to register is made in the way the Rule requires` `o 57 r 3 fixture decision under 48Q(5)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 3 the application to register is made in the way the Rule requires` `o 57 r 3 fixture direction under 48I` TRUE FALSE EQUALS NOTHING
#ASSERT `o 57 r 3 the application to register is made in the way the Rule requires` `o 57 r 3 fixture direction under 48I` FALSE TRUE EQUALS NOTHING
-- An instrument outside the three: the Rule does not reach it.
#ASSERT `o 57 r 3 the application to register is made in the way the Rule requires` `o 57 r 3 fixture notice by someone else` TRUE TRUE EQUALS NOTHING
-- The court: the Rule opens "An application to register in the District Court".  In the District Court the answer is the one above;
-- in another court the sentence says nothing (a scope limit with no "only").
#ASSERT `o 57 r 3 the application to register in the District Court is made in the way the Rule requires` TRUE `o 57 r 3 fixture direction under 48I` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 3 the application to register in the District Court is made in the way the Rule requires` TRUE `o 57 r 3 fixture direction under 48I` TRUE FALSE EQUALS NOTHING
#ASSERT `o 57 r 3 the application to register in the District Court is made in the way the Rule requires` TRUE `o 57 r 3 fixture notice by someone else` TRUE TRUE EQUALS NOTHING
#ASSERT `o 57 r 3 the application to register in the District Court is made in the way the Rule requires` FALSE `o 57 r 3 fixture direction under 48I` TRUE TRUE EQUALS NOTHING
#ASSERT `o 57 r 3 the application to register in the District Court is made in the way the Rule requires` FALSE `o 57 r 3 fixture decision under 48Q(5)` TRUE TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 57 rule 4 -- evidence in support`
-- ---------------------------------------------------------------------------
`o 57 r 4(1) fixture full affidavit by route A with a penalty` MEANS `o 57 r 4(1) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE
`o 57 r 4(1) fixture full affidavit by route B with no penalty` MEANS `o 57 r 4(1) affidavit` OF TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, FALSE, FALSE
`o 57 r 4(1) fixture affidavit silent on both routes and the amount` MEANS `o 57 r 4(1) affidavit` OF TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, FALSE
`o 57 r 4(1) fixture empty affidavit` MEANS `o 57 r 4(1) affidavit` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE

#ASSERT count (`o 57 r 4(1) the matters the affidavit has not yet stated` `o 57 r 4(1) fixture full affidavit by route A with a penalty`) EQUALS 0
-- (d)(ii) is met by (B) alone; (d)(iv) is not required where no penalty was imposed ("if applicable").
#ASSERT count (`o 57 r 4(1) the matters the affidavit has not yet stated` `o 57 r 4(1) fixture full affidavit by route B with no penalty`) EQUALS 0
-- Neither (A) nor (B), and a penalty with no amount: two matters.
#ASSERT count (`o 57 r 4(1) the matters the affidavit has not yet stated` `o 57 r 4(1) fixture affidavit silent on both routes and the amount`) EQUALS 2
#ASSERT elem "(d)(iv) the amount of financial penalty imposed thereunder which remains unsatisfied" (`o 57 r 4(1) the matters the affidavit has not yet stated` `o 57 r 4(1) fixture affidavit silent on both routes and the amount`)
-- Nothing stated: items (a), (b), (c), (d)(i), (d)(ii), (d)(iii) and (d)(iv) are all missing, seven in all.
#ASSERT count (`o 57 r 4(1) the matters the affidavit has not yet stated` `o 57 r 4(1) fixture empty affidavit`) EQUALS 7
#ASSERT `o 57 r 4(1) the affidavit supporting the application states what the Rule requires` `o 57 r 4(1) fixture full affidavit by route A with a penalty` EQUALS JUST TRUE
#ASSERT `o 57 r 4(1) the affidavit supporting the application states what the Rule requires` `o 57 r 4(1) fixture full affidavit by route B with no penalty` EQUALS JUST TRUE
#ASSERT `o 57 r 4(1) the affidavit supporting the application states what the Rule requires` `o 57 r 4(1) fixture empty affidavit` EQUALS NOTHING

-- (2): the additional statement for a Direction or Notice.
`o 57 r 4(2) fixture route (a)` MEANS `o 57 r 4(2) additional statements` OF TRUE, FALSE, FALSE
`o 57 r 4(2) fixture route (b)(i)` MEANS `o 57 r 4(2) additional statements` OF FALSE, TRUE, FALSE
`o 57 r 4(2) fixture route (b)(ii)` MEANS `o 57 r 4(2) additional statements` OF FALSE, FALSE, TRUE
`o 57 r 4(2) fixture no route` MEANS `o 57 r 4(2) additional statements` OF FALSE, FALSE, FALSE
#ASSERT `o 57 r 4(2) the additional statement is required` `o 57 r 3 fixture direction under 48I` EQUALS JUST TRUE
#ASSERT `o 57 r 4(2) the additional statement is required` `o 57 r 3 fixture notice for penalty and interest` EQUALS JUST TRUE
-- A Decision: paragraph (2) speaks of a Direction or Notice.
#ASSERT `o 57 r 4(2) the additional statement is required` `o 57 r 3 fixture decision under 48Q(5)` EQUALS NOTHING
#ASSERT `o 57 r 4(2) the affidavit makes the additional statement the Rule requires` `o 57 r 3 fixture direction under 48I` `o 57 r 4(2) fixture route (a)` EQUALS JUST TRUE
#ASSERT `o 57 r 4(2) the affidavit makes the additional statement the Rule requires` `o 57 r 3 fixture direction under 48I` `o 57 r 4(2) fixture route (b)(i)` EQUALS JUST TRUE
#ASSERT `o 57 r 4(2) the affidavit makes the additional statement the Rule requires` `o 57 r 3 fixture notice for penalty and interest` `o 57 r 4(2) fixture route (b)(ii)` EQUALS JUST TRUE
#ASSERT `o 57 r 4(2) the affidavit makes the additional statement the Rule requires` `o 57 r 3 fixture direction under 48I` `o 57 r 4(2) fixture no route` EQUALS NOTHING
-- The duty does not arise for a Decision, so compliance is not asked.
#ASSERT `o 57 r 4(2) the affidavit makes the additional statement the Rule requires` `o 57 r 3 fixture decision under 48Q(5)` `o 57 r 4(2) fixture no route` EQUALS NOTHING

-- Whether each statement may be made on the facts.  Arguments are in the order of the GIVEN lines.
-- (d)(ii)(A): not appealed against AND the time allowed for appealing has expired.
#ASSERT `o 57 r 4(1)(d)(ii)(A) the affidavit may state that it has not been appealed against and the time allowed for appealing has expired` FALSE TRUE EQUALS JUST TRUE
-- An appeal has been brought (and is pending): the statement cannot be made.
#ASSERT `o 57 r 4(1)(d)(ii)(A) the affidavit may state that it has not been appealed against and the time allowed for appealing has expired` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 57 r 4(1)(d)(ii)(A) the affidavit may state that it has not been appealed against and the time allowed for appealing has expired` TRUE TRUE EQUALS JUST FALSE
-- Not appealed, but the time to appeal has not expired.
#ASSERT `o 57 r 4(1)(d)(ii)(A) the affidavit may state that it has not been appealed against and the time allowed for appealing has expired` FALSE FALSE EQUALS JUST FALSE
-- (d)(ii)(B): every appeal finally disposed of AND no further appeal is feasible.
#ASSERT `o 57 r 4(1)(d)(ii)(B) the affidavit may state that all appeals have been finally disposed of and no further appeal is feasible` TRUE FALSE EQUALS JUST TRUE
-- An appeal is still pending.
#ASSERT `o 57 r 4(1)(d)(ii)(B) the affidavit may state that all appeals have been finally disposed of and no further appeal is feasible` FALSE FALSE EQUALS JUST FALSE
-- Appeals disposed of but a further appeal is feasible (the time for it has not run out).
#ASSERT `o 57 r 4(1)(d)(ii)(B) the affidavit may state that all appeals have been finally disposed of and no further appeal is feasible` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 57 r 4(1)(d)(ii)(B) the affidavit may state that all appeals have been finally disposed of and no further appeal is feasible` FALSE TRUE EQUALS JUST FALSE
-- (d)(ii) as a whole, arguments: appealed, time to appeal expired, every appeal disposed of, further appeal feasible.
#ASSERT `o 57 r 4(1)(d)(ii) the affidavit may state the matter the Rule requires about appeals` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 4(1)(d)(ii) the affidavit may state the matter the Rule requires about appeals` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 57 r 4(1)(d)(ii) the affidavit may state the matter the Rule requires about appeals` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 57 r 4(1)(d)(ii) the affidavit may state the matter the Rule requires about appeals` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- (d)(iii): the instrument has not been complied with.
#ASSERT `o 57 r 4(1)(d)(iii) the affidavit may state that it has not been complied with` FALSE EQUALS JUST TRUE
#ASSERT `o 57 r 4(1)(d)(iii) the affidavit may state that it has not been complied with` TRUE EQUALS JUST FALSE
-- (2)(a), for a Direction: no application to reconsider was made AND the time allowed to apply has expired.  Arguments: instrument, application made, time expired.
#ASSERT `o 57 r 4(2)(a) the affidavit may state that no application to reconsider was made and the time allowed to apply has expired` `o 57 r 3 fixture direction under 48I` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 4(2)(a) the affidavit may state that no application to reconsider was made and the time allowed to apply has expired` `o 57 r 3 fixture notice for penalty and interest` FALSE TRUE EQUALS JUST TRUE
-- No application made but the time to apply has not expired.
#ASSERT `o 57 r 4(2)(a) the affidavit may state that no application to reconsider was made and the time allowed to apply has expired` `o 57 r 3 fixture direction under 48I` FALSE FALSE EQUALS JUST FALSE
-- An application was made.
#ASSERT `o 57 r 4(2)(a) the affidavit may state that no application to reconsider was made and the time allowed to apply has expired` `o 57 r 3 fixture direction under 48I` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 57 r 4(2)(a) the affidavit may state that no application to reconsider was made and the time allowed to apply has expired` `o 57 r 3 fixture direction under 48I` TRUE FALSE EQUALS JUST FALSE
-- A Decision: paragraph (2) speaks of a Direction or Notice.
#ASSERT `o 57 r 4(2)(a) the affidavit may state that no application to reconsider was made and the time allowed to apply has expired` `o 57 r 3 fixture decision under 48Q(5)` FALSE TRUE EQUALS NOTHING
-- (2)(b)(i): every application disposed of AND the decision on reconsideration not appealed against AND the time to appeal expired.  Arguments: instrument, applications disposed of, decision appealed, time expired.
#ASSERT `o 57 r 4(2)(b)(i) the affidavit may state that the decision on reconsideration has not been appealed against and the time allowed for appealing has expired` `o 57 r 3 fixture direction under 48I` TRUE FALSE TRUE EQUALS JUST TRUE
-- A reconsideration application is still pending.
#ASSERT `o 57 r 4(2)(b)(i) the affidavit may state that the decision on reconsideration has not been appealed against and the time allowed for appealing has expired` `o 57 r 3 fixture direction under 48I` FALSE FALSE TRUE EQUALS JUST FALSE
-- The decision on reconsideration was appealed against.
#ASSERT `o 57 r 4(2)(b)(i) the affidavit may state that the decision on reconsideration has not been appealed against and the time allowed for appealing has expired` `o 57 r 3 fixture direction under 48I` TRUE TRUE TRUE EQUALS JUST FALSE
-- The time to appeal the decision has not expired.
#ASSERT `o 57 r 4(2)(b)(i) the affidavit may state that the decision on reconsideration has not been appealed against and the time allowed for appealing has expired` `o 57 r 3 fixture direction under 48I` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 57 r 4(2)(b)(i) the affidavit may state that the decision on reconsideration has not been appealed against and the time allowed for appealing has expired` `o 57 r 3 fixture decision under 48Q(5)` TRUE FALSE TRUE EQUALS NOTHING
-- (2)(b)(ii): every application disposed of AND every appeal disposed of AND, where a further appeal lies, the time for it has expired.  Arguments: instrument, applications disposed of, appeals disposed of, a further appeal lies, time expired.
#ASSERT `o 57 r 4(2)(b)(ii) the affidavit may state that all appeals against the decision on reconsideration have been finally disposed of and the time allowed for a further appeal has expired` `o 57 r 3 fixture direction under 48I` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- "(where applicable)": no further appeal lies, so the time need not have expired.
#ASSERT `o 57 r 4(2)(b)(ii) the affidavit may state that all appeals against the decision on reconsideration have been finally disposed of and the time allowed for a further appeal has expired` `o 57 r 3 fixture direction under 48I` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- A further appeal lies and its time has not expired.
#ASSERT `o 57 r 4(2)(b)(ii) the affidavit may state that all appeals against the decision on reconsideration have been finally disposed of and the time allowed for a further appeal has expired` `o 57 r 3 fixture direction under 48I` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- An appeal is still pending, or a reconsideration application is.
#ASSERT `o 57 r 4(2)(b)(ii) the affidavit may state that all appeals against the decision on reconsideration have been finally disposed of and the time allowed for a further appeal has expired` `o 57 r 3 fixture direction under 48I` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 57 r 4(2)(b)(ii) the affidavit may state that all appeals against the decision on reconsideration have been finally disposed of and the time allowed for a further appeal has expired` `o 57 r 3 fixture direction under 48I` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 57 r 4(2)(b)(ii) the affidavit may state that all appeals against the decision on reconsideration have been finally disposed of and the time allowed for a further appeal has expired` `o 57 r 3 fixture decision under 48Q(5)` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- (2) as a whole.  Arguments: instrument, application made, time to apply expired, applications disposed of, decision appealed, time to appeal expired, appeals disposed of, further appeal lies, time for it expired.
-- Route (a).
#ASSERT `o 57 r 4(2) the affidavit may state the additional matter the Rule requires about reconsideration` `o 57 r 3 fixture direction under 48I` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- Route (b)(i).
#ASSERT `o 57 r 4(2) the affidavit may state the additional matter the Rule requires about reconsideration` `o 57 r 3 fixture direction under 48I` TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- Route (b)(ii).
#ASSERT `o 57 r 4(2) the affidavit may state the additional matter the Rule requires about reconsideration` `o 57 r 3 fixture notice for penalty and interest` TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- A reconsideration application is pending: none of the three routes.
#ASSERT `o 57 r 4(2) the affidavit may state the additional matter the Rule requires about reconsideration` `o 57 r 3 fixture direction under 48I` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- A Decision.
#ASSERT `o 57 r 4(2) the affidavit may state the additional matter the Rule requires about reconsideration` `o 57 r 3 fixture decision under 48Q(5)` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 57 rule 5 -- order for registration`
-- ---------------------------------------------------------------------------
#ASSERT `o 57 r 5(1) the form of the order for registration` EQUALS "86"
#ASSERT `o 57 r 5(1) the order for registration is drawn up and served as the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 5(1) the order for registration is drawn up and served as the Rule requires` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `o 57 r 5(1) the order for registration is drawn up and served as the Rule requires` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `o 57 r 5(1) the order for registration is drawn up and served as the Rule requires` TRUE TRUE FALSE EQUALS NOTHING
-- (2) "Unless the Court otherwise directs": the requirement applies; a direction lifts it.
#ASSERT `o 57 r 5(2) the order must state the period and contain the notification` FALSE EQUALS JUST TRUE
#ASSERT `o 57 r 5(2) the order must state the period and contain the notification` TRUE EQUALS JUST FALSE
#ASSERT `o 57 r 5(2) the order for registration states and notifies what the Rule requires` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 5(2) the order for registration states and notifies what the Rule requires` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `o 57 r 5(2) the order for registration states and notifies what the Rule requires` FALSE FALSE TRUE EQUALS NOTHING
-- The Court has directed otherwise: the requirement does not arise, so compliance is not asked.
#ASSERT `o 57 r 5(2) the order for registration states and notifies what the Rule requires` TRUE FALSE FALSE EQUALS NOTHING
-- (3): the application to extend is made before the period expires; the last day is 20 November 2026.
#ASSERT `o 57 r 5(3) the application to extend the period is made before the period expires` (Date 19 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `o 57 r 5(3) the application to extend the period is made before the period expires` (Date 20 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `o 57 r 5(3) the application to extend the period is made before the period expires` (Date 21 11 2026) (Date 20 11 2026) EQUALS JUST FALSE
-- (4): the Court may extend "the period referred to in paragraph (3)".
#ASSERT `o 57 r 5(4) the Court may extend the period on such terms as it thinks fit` TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 5(4) the Court may extend the period on such terms as it thinks fit` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 57 rule 6 -- register`
-- ---------------------------------------------------------------------------
#ASSERT `o 57 r 6 the register kept in the Registry contains the registered item` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 6 the register kept in the Registry contains the registered item` TRUE FALSE EQUALS NOTHING
#ASSERT `o 57 r 6 the register kept in the Registry contains the registered item` FALSE FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 57 rule 7 -- notice of registration`
-- ---------------------------------------------------------------------------
-- (1): served on the party, personally unless the Court otherwise orders.
#ASSERT `o 57 r 7(1) the notice of registration is served as the Rule requires` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 57 r 7(1) the notice of registration is served as the Rule requires` TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 57 r 7(1) the notice of registration is served as the Rule requires` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `o 57 r 7(1) the notice of registration is served as the Rule requires` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `o 57 r 7(1) the notice of registration is served as the Rule requires` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
-- Served out of Singapore: personal service is "subject to paragraph (2)" and Order 8 is another part's.
#ASSERT `o 57 r 7(1) the notice of registration is served as the Rule requires` TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING
-- (2): service out of Singapore is permissible without permission.
#ASSERT `o 57 r 7(2) permission is needed to serve the notice out of Singapore` TRUE EQUALS JUST FALSE
#ASSERT `o 57 r 7(2) permission is needed to serve the notice out of Singapore` FALSE EQUALS NOTHING
#ASSERT `o 57 r 7(2) a rule of Order 8 applies to the notice` TRUE "2" EQUALS JUST TRUE
#ASSERT `o 57 r 7(2) a rule of Order 8 applies to the notice` TRUE "3" EQUALS JUST TRUE
#ASSERT `o 57 r 7(2) a rule of Order 8 applies to the notice` TRUE "7" EQUALS JUST TRUE
#ASSERT `o 57 r 7(2) a rule of Order 8 applies to the notice` TRUE "8" EQUALS JUST TRUE
-- Rule 4A or any other rule of Order 8 is not named.
#ASSERT `o 57 r 7(2) a rule of Order 8 applies to the notice` TRUE "4A" EQUALS NOTHING
#ASSERT `o 57 r 7(2) a rule of Order 8 applies to the notice` FALSE "2" EQUALS NOTHING
-- (3): what the notice states.
#ASSERT count (`o 57 r 7(3) the matters the notice has not yet stated` (`o 57 r 7(3) notice of registration` OF TRUE, TRUE, TRUE, TRUE)) EQUALS 0
#ASSERT count (`o 57 r 7(3) the matters the notice has not yet stated` (`o 57 r 7(3) notice of registration` OF TRUE, FALSE, TRUE, FALSE)) EQUALS 2
#ASSERT elem "(d) the period within which an application to set aside the registration may be made" (`o 57 r 7(3) the matters the notice has not yet stated` (`o 57 r 7(3) notice of registration` OF TRUE, FALSE, TRUE, FALSE))
#ASSERT `o 57 r 7(3) the notice of registration states what the Rule requires` (`o 57 r 7(3) notice of registration` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 57 r 7(3) the notice of registration states what the Rule requires` (`o 57 r 7(3) notice of registration` OF TRUE, TRUE, FALSE, TRUE) EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 57 rule 8 -- endorsement of service`
-- ---------------------------------------------------------------------------
#ASSERT `o 57 r 8(1) the period for endorsing the notice`'s `period length` EQUALS 3
#ASSERT `o 57 r 8(1) the period for endorsing the notice`'s `period unit` EQUALS Days
-- The 3-day last day is 16 November 2026 (made up); a longer period the Court allowed ends 20 November 2026.
#ASSERT `o 57 r 8(1) the last day for endorsing the notice` (Date 16 11 2026) NOTHING EQUALS Date 16 11 2026
#ASSERT `o 57 r 8(1) the last day for endorsing the notice` (Date 16 11 2026) (JUST (Date 20 11 2026)) EQUALS Date 20 11 2026
-- A "longer" period that ends earlier than the 3 days does not shorten them.
#ASSERT `o 57 r 8(1) the last day for endorsing the notice` (Date 16 11 2026) (JUST (Date 14 11 2026)) EQUALS Date 16 11 2026
-- Endorsed on the last day and the day before: in time.
#ASSERT `o 57 r 8(1) the notice is endorsed in time` (JUST (Date 16 11 2026)) (Date 17 11 2026) (Date 16 11 2026) NOTHING EQUALS JUST TRUE
#ASSERT `o 57 r 8(1) the notice is endorsed in time` (JUST (Date 13 11 2026)) (Date 17 11 2026) (Date 16 11 2026) NOTHING EQUALS JUST TRUE
-- Endorsed the day after the last day: out of time.
#ASSERT `o 57 r 8(1) the notice is endorsed in time` (JUST (Date 17 11 2026)) (Date 17 11 2026) (Date 16 11 2026) NOTHING EQUALS JUST FALSE
-- Endorsed after the 3 days but within the longer period the Court allowed.
#ASSERT `o 57 r 8(1) the notice is endorsed in time` (JUST (Date 19 11 2026)) (Date 20 11 2026) (Date 16 11 2026) (JUST (Date 20 11 2026)) EQUALS JUST TRUE
#ASSERT `o 57 r 8(1) the notice is endorsed in time` (JUST (Date 21 11 2026)) (Date 22 11 2026) (Date 16 11 2026) (JUST (Date 20 11 2026)) EQUALS JUST FALSE
-- Not endorsed yet: while the time runs the answer is not yet; afterwards the Rule says no.
#ASSERT `o 57 r 8(1) the notice is endorsed in time` NOTHING (Date 16 11 2026) (Date 16 11 2026) NOTHING EQUALS NOTHING
#ASSERT `o 57 r 8(1) the notice is endorsed in time` NOTHING (Date 17 11 2026) (Date 16 11 2026) NOTHING EQUALS JUST FALSE
#ASSERT `o 57 r 8(1) the notice is endorsed in time` NOTHING (Date 18 11 2026) (Date 16 11 2026) (JUST (Date 20 11 2026)) EQUALS NOTHING
-- The Court may allow a longer period "in special circumstances".
#ASSERT `o 57 r 8(1) the Court may allow a longer period for endorsing the notice` TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 8(1) the Court may allow a longer period for endorsing the notice` FALSE EQUALS NOTHING
-- The endorsement: by the person who served the notice, with the day of the week and the date.
#ASSERT `o 57 r 8(1) the endorsement is what the Rule requires` (`o 57 r 8(1) endorsement` OF TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 57 r 8(1) the endorsement is what the Rule requires` (`o 57 r 8(1) endorsement` OF FALSE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 57 r 8(1) the endorsement is what the Rule requires` (`o 57 r 8(1) endorsement` OF TRUE, FALSE, TRUE) EQUALS NOTHING
#ASSERT `o 57 r 8(1) the endorsement is what the Rule requires` (`o 57 r 8(1) endorsement` OF TRUE, TRUE, FALSE) EQUALS NOTHING
-- (2): not endorsed in time: the person seeking to enforce may not apply without permission.
#ASSERT `o 57 r 8(2) the person seeking to enforce may apply for an enforcement order without the permission of the Court` (JUST FALSE) EQUALS JUST FALSE
-- Endorsed in time: the bar does not arise and grants nothing.
#ASSERT `o 57 r 8(2) the person seeking to enforce may apply for an enforcement order without the permission of the Court` (JUST TRUE) EQUALS NOTHING
#ASSERT `o 57 r 8(2) the person seeking to enforce may apply for an enforcement order without the permission of the Court` NOTHING EQUALS NOTHING
-- (3): the affidavit of service states the date of endorsement.
#ASSERT `o 57 r 8(3) the affidavit of service states the date of endorsement` TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 8(3) the affidavit of service states the date of endorsement` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 57 rule 9 -- application to set aside registration`
-- ---------------------------------------------------------------------------
#ASSERT `o 57 r 9(1) the application to set aside the registration is made as the Rule requires` Summons TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 9(1) the application to set aside the registration is made as the Rule requires` Summons FALSE EQUALS NOTHING
#ASSERT `o 57 r 9(1) the application to set aside the registration is made as the Rule requires` `Originating application` TRUE EQUALS NOTHING
#ASSERT `o 57 r 9(2) the Court may order the issue to be tried as an issue in an action is tried` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 57 r 9(2) the Court may order the issue to be tried as an issue in an action is tried` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 9(2) the Court may order the issue to be tried as an issue in an action is tried` FALSE FALSE EQUALS NOTHING
#ASSERT `o 57 r 9(3) the Court may order the registration to be set aside on such terms as it thinks fit` TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 9(3) the Court may order the registration to be set aside on such terms as it thinks fit` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 57 rule 10 -- issue of enforcement order`
-- ---------------------------------------------------------------------------
-- (1): the specified period expires on 20 November 2026.
#ASSERT `o 57 r 10(1) an enforcement order cannot yet be issued because the specified period has not expired` TRUE (Date 20 11 2026) (Date 19 11 2026) EQUALS JUST TRUE
#ASSERT `o 57 r 10(1) an enforcement order cannot yet be issued because the specified period has not expired` TRUE (Date 20 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `o 57 r 10(1) an enforcement order cannot yet be issued because the specified period has not expired` TRUE (Date 20 11 2026) (Date 21 11 2026) EQUALS JUST FALSE
-- No specified period under Rule 5(2): the "Where" condition fails, so the bar does not arise.
#ASSERT `o 57 r 10(1) an enforcement order cannot yet be issued because the specified period has not expired` FALSE (Date 20 11 2026) (Date 19 11 2026) EQUALS JUST FALSE
-- (2): an application to set aside is made and not yet disposed of.
#ASSERT `o 57 r 10(2) an enforcement order cannot yet be issued because the application to set aside is not disposed of` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 57 r 10(2) an enforcement order cannot yet be issued because the application to set aside is not disposed of` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 57 r 10(2) an enforcement order cannot yet be issued because the application to set aside is not disposed of` FALSE FALSE EQUALS JUST FALSE
-- (3): the affidavit of service and any order of the Court.
#ASSERT `o 57 r 10(3) the party applying for an enforcement order has produced what the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 10(3) the party applying for an enforcement order has produced what the Rule requires` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 57 r 10(3) the party applying for an enforcement order has produced what the Rule requires` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 57 r 10(3) the party applying for an enforcement order has produced what the Rule requires` FALSE FALSE FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 57 rule 11 -- application for an order under section 48M(4)`
-- ---------------------------------------------------------------------------
#ASSERT `o 57 r 11(1)(a) the application for an order specified in section 48M(4) may be made at this time` `o 57 r 11(1)(a) together with the application for registration` EQUALS JUST TRUE
#ASSERT `o 57 r 11(1)(a) the application for an order specified in section 48M(4) may be made at this time` `o 57 r 11(1)(a) at a time after the application for registration` EQUALS JUST TRUE
-- "together with, or at any time after": a time before the application for registration is outside the window the text fixes.
#ASSERT `o 57 r 11(1)(a) the application for an order specified in section 48M(4) may be made at this time` `o 57 r 11(1)(a) before the application for registration` EQUALS JUST FALSE
#ASSERT `o 57 r 11(1)(b) the application is an application for an enforcement order under Rule 10` TRUE EQUALS JUST FALSE
#ASSERT `o 57 r 11(1)(b) the application is an application for an enforcement order under Rule 10` FALSE EQUALS NOTHING
#ASSERT `o 57 r 11(2) the application may be made in this way` `o 57 r 11(2) by summons supported by an affidavit, with notice` FALSE EQUALS JUST TRUE
#ASSERT `o 57 r 11(2) the application may be made in this way` `o 57 r 11(2) by summons supported by an affidavit, without notice` TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 11(2) the application may be made in this way` `o 57 r 11(2) by summons supported by an affidavit, without notice` FALSE EQUALS JUST FALSE
#ASSERT count (`o 57 r 11(3) the matters the affidavit has not yet stated` (`o 57 r 11(3) affidavit` OF TRUE, TRUE)) EQUALS 0
#ASSERT count (`o 57 r 11(3) the matters the affidavit has not yet stated` (`o 57 r 11(3) affidavit` OF FALSE, TRUE)) EQUALS 1
#ASSERT `o 57 r 11(3) the affidavit states what the Rule requires` (`o 57 r 11(3) affidavit` OF TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 57 r 11(3) the affidavit states what the Rule requires` (`o 57 r 11(3) affidavit` OF TRUE, FALSE) EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 57 rule 12 -- notice to the Commission of a claim under section 48O(1)`
-- ---------------------------------------------------------------------------
#ASSERT `o 57 r 12 the period for serving a copy on the Commission`'s `period length` EQUALS 14
#ASSERT `o 57 r 12 the duty to serve a copy on the Commission arises` TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 12 the duty to serve a copy on the Commission arises` FALSE EQUALS JUST FALSE
-- The last day is 15 December 2026 (made up): served on it, in time; the day after, out of time.
#ASSERT `o 57 r 12 the claimant serves a copy on the Commission in time` TRUE (Date 14 12 2026) (Date 15 12 2026) EQUALS JUST TRUE
#ASSERT `o 57 r 12 the claimant serves a copy on the Commission in time` TRUE (Date 15 12 2026) (Date 15 12 2026) EQUALS JUST TRUE
#ASSERT `o 57 r 12 the claimant serves a copy on the Commission in time` TRUE (Date 16 12 2026) (Date 15 12 2026) EQUALS JUST FALSE
-- No claim under section 48O(1): the duty does not arise.
#ASSERT `o 57 r 12 the claimant serves a copy on the Commission in time` FALSE (Date 16 12 2026) (Date 15 12 2026) EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 57 rule 13 -- transmission to the Commission of a judgment or order`
-- ---------------------------------------------------------------------------
#ASSERT `o 57 r 13 the period for transmitting a copy to the Commission`'s `period length` EQUALS 3
#ASSERT `o 57 r 13 the duty to transmit a copy to the Commission arises` TRUE EQUALS JUST TRUE
#ASSERT `o 57 r 13 the duty to transmit a copy to the Commission arises` FALSE EQUALS JUST FALSE
#ASSERT `o 57 r 13 the person transmits a copy to the Commission in time` TRUE (Date 9 12 2026) (Date 10 12 2026) EQUALS JUST TRUE
#ASSERT `o 57 r 13 the person transmits a copy to the Commission in time` TRUE (Date 10 12 2026) (Date 10 12 2026) EQUALS JUST TRUE
#ASSERT `o 57 r 13 the person transmits a copy to the Commission in time` TRUE (Date 11 12 2026) (Date 10 12 2026) EQUALS JUST FALSE
#ASSERT `o 57 r 13 the person transmits a copy to the Commission in time` FALSE (Date 11 12 2026) (Date 10 12 2026) EQUALS NOTHING
