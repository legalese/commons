-- ---------------------------------------------------------------------------
§§ `Rule 3 -- matters for a Judge or the Registrar`
-- ---------------------------------------------------------------------------

-- Paragraph (1) lists (a) to (h).
GIVEN kind IS A `o 34 r 2 kind of application`
GIVETH A BOOLEAN
`o 34 r 3(1) the kind is one of paragraphs (a) to (h)` MEANS
    CONSIDER kind
    WHEN `o 34 r 3(1)(a) application to reinstate discontinued proceedings under section 6(4)` THEN TRUE
    WHEN `o 34 r 3(1)(b) application for permission to enforce interim orders or directions of an arbitral tribunal under section 28(4)` THEN TRUE
    WHEN `o 34 r 3(1)(c) application for an order in support of arbitral proceedings under section 31` THEN TRUE
    WHEN `o 34 r 3(1)(d) application for an extension of time under section 10 or 36` THEN TRUE
    WHEN `o 34 r 3(1)(e) application for an order under section 41(2) where the arbitral tribunal withholds its award for non-payment of fees and expenses` THEN TRUE
    WHEN `o 34 r 3(1)(f) application for permission to enforce an award under section 37 or 46` THEN TRUE
    WHEN `o 34 r 3(1)(g) application to hear an application in open court under section 56` THEN TRUE
    WHEN `o 34 r 3(1)(h) application for directions on publishing information relating to an application heard in private under section 57` THEN TRUE
    OTHERWISE FALSE

