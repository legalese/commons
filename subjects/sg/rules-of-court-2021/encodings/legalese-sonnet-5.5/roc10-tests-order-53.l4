IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc10-order-53`

-- Rules of Court 2021 (Singapore), Order 53 (Mutual Assistance in Criminal Matters Act): TESTS.
-- Every expected value is written beside its assertion from the text of the rule it cites (lines 6521 to 6687 of the text),
-- never copied from the output of the code.  The last day is the seam input of O 3 r 3; a date on or before it is in time.

-- Rule 1
#ASSERT `o 53 r 1(1) an instrument is the Act` TRUE EQUALS JUST TRUE -- "“Act” means the Mutual Assistance in Criminal Matters Act"
#ASSERT `o 53 r 1(1) an instrument is the Act` FALSE EQUALS JUST FALSE -- another instrument
#ASSERT `o 53 r 1(1)(a) a reference to a section is a reference to a section in the Mutual Assistance in Criminal Matters Act` TRUE EQUALS JUST TRUE -- "any reference to a section"
#ASSERT `o 53 r 1(1)(a) a reference to a section is a reference to a section in the Mutual Assistance in Criminal Matters Act` FALSE EQUALS NOTHING -- some other reference
#ASSERT `o 53 r 1(1)(b) a reference to the Third Schedule is a reference to the Third Schedule to the Act` TRUE EQUALS JUST TRUE -- "any reference to the Third Schedule"
#ASSERT `o 53 r 1(1)(b) a reference to the Third Schedule is a reference to the Third Schedule to the Act` FALSE EQUALS NOTHING -- some other reference
#ASSERT `o 53 r 1(2) the expression has the same meaning in this Order as in the Act` TRUE TRUE EQUALS JUST TRUE -- used in both
#ASSERT `o 53 r 1(2) the expression has the same meaning in this Order as in the Act` TRUE FALSE EQUALS NOTHING -- not used in the Act
#ASSERT `o 53 r 1(2) the expression has the same meaning in this Order as in the Act` FALSE TRUE EQUALS NOTHING -- not used in this Order
#ASSERT `o 53 r 1(3) the application is made by the document this paragraph requires` TRUE TRUE `Summons` EQUALS JUST TRUE -- action pending: "by summons in the action"
#ASSERT `o 53 r 1(3) the application is made by the document this paragraph requires` TRUE TRUE `Originating application` EQUALS NOTHING -- action pending, wrong document: a bare "must"
#ASSERT `o 53 r 1(3) the application is made by the document this paragraph requires` TRUE FALSE `Originating application` EQUALS JUST TRUE -- no action pending: "by originating application"
#ASSERT `o 53 r 1(3) the application is made by the document this paragraph requires` TRUE FALSE `Summons` EQUALS NOTHING -- no action pending, wrong document
#ASSERT `o 53 r 1(3) the application is made by the document this paragraph requires` FALSE TRUE `Summons` EQUALS NOTHING -- not an application to which this Order applies

-- Rule 2
#ASSERT `o 53 r 2(1) the application is supported by an affidavit as it must be` TRUE TRUE EQUALS JUST TRUE -- "must be supported by affidavit"
#ASSERT `o 53 r 2(1) the application is supported by an affidavit as it must be` TRUE FALSE EQUALS NOTHING -- no affidavit: a bare "must"
#ASSERT `o 53 r 2(1) the application is supported by an affidavit as it must be` FALSE TRUE EQUALS NOTHING -- not an application for an order under section 22
#ASSERT `o 53 r 2(1) the application may be made without notice` TRUE EQUALS JUST TRUE -- "may be made without notice"
#ASSERT `o 53 r 2(1) the application may be made without notice` FALSE EQUALS NOTHING -- not an application under section 22
#ASSERT `o 53 r 2(2) the Court may discharge the order or vary it as it thinks fit` TRUE TRUE EQUALS JUST TRUE -- order made, application by the person required to comply
#ASSERT `o 53 r 2(2) the Court may discharge the order or vary it as it thinks fit` TRUE FALSE EQUALS JUST FALSE -- application by someone else: the "upon" fails
#ASSERT `o 53 r 2(2) the Court may discharge the order or vary it as it thinks fit` FALSE TRUE EQUALS JUST FALSE -- no order made: the "where" fails
#ASSERT `o 53 r 2(3) the period before the filing of the application`'s `period length` EQUALS 2 -- "not later than 2 clear days"
#ASSERT `o 53 r 2(3) the period before the filing of the application`'s `period unit` EQUALS `Clear days` -- "2 clear days"
#ASSERT `o 53 r 2(3) the duty to serve a copy of the application arises` TRUE FALSE EQUALS JUST TRUE -- proposes to file, no direction
#ASSERT `o 53 r 2(3) the duty to serve a copy of the application arises` FALSE FALSE EQUALS JUST FALSE -- does not propose to file: the "where" fails
#ASSERT `o 53 r 2(3) the duty to serve a copy of the application arises` TRUE TRUE EQUALS JUST FALSE -- "Subject to paragraph (4)": the Court has directed
#ASSERT `o 53 r 2(3) the copy has been served in time` TRUE FALSE (Date 12 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- served before the last day
#ASSERT `o 53 r 2(3) the copy has been served in time` TRUE FALSE (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- served on the last day
#ASSERT `o 53 r 2(3) the copy has been served in time` TRUE FALSE (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- served after the last day: a stated period missed
#ASSERT `o 53 r 2(3) the copy has been served in time` FALSE FALSE (Date 12 6 2026) (Date 15 6 2026) EQUALS NOTHING -- the duty does not arise
#ASSERT `o 53 r 2(3) the copy has been served in time` TRUE TRUE (Date 12 6 2026) (Date 15 6 2026) EQUALS NOTHING -- the Court has directed: the duty does not arise
#ASSERT `o 53 r 2(4) the Court may direct that paragraph (3) need not be complied with` TRUE TRUE EQUALS JUST TRUE -- satisfied, and not practicable
#ASSERT `o 53 r 2(4) the Court may direct that paragraph (3) need not be complied with` TRUE FALSE EQUALS JUST FALSE -- practicable: the "and" limb fails
#ASSERT `o 53 r 2(4) the Court may direct that paragraph (3) need not be complied with` FALSE TRUE EQUALS JUST FALSE -- not satisfied: the "if" fails

-- Rule 3
#ASSERT `o 53 r 3 Order 26, Rule 3 allows inspection of the document` TRUE EQUALS JUST FALSE -- "Despite Order 26, Rule 3, no person may inspect"
#ASSERT `o 53 r 3 Order 26, Rule 3 allows inspection of the document` FALSE EQUALS NOTHING -- a document not relating to those applications
#ASSERT `o 53 r 3 a person is barred from inspecting or taking a copy of the document` TRUE FALSE EQUALS JUST TRUE -- no permission
#ASSERT `o 53 r 3 a person is barred from inspecting or taking a copy of the document` TRUE TRUE EQUALS JUST FALSE -- "without the permission of the Court" lifts the bar
#ASSERT `o 53 r 3 a person is barred from inspecting or taking a copy of the document` FALSE FALSE EQUALS NOTHING -- the bar does not reach this document
#ASSERT `o 53 r 3 a person may inspect or take a copy of the document` TRUE FALSE EQUALS JUST FALSE -- barred
#ASSERT `o 53 r 3 a person may inspect or take a copy of the document` TRUE TRUE EQUALS NOTHING -- the permission lifts the bar and grants nothing
#ASSERT `o 53 r 3 a person may inspect or take a copy of the document` FALSE TRUE EQUALS NOTHING -- the bar does not reach this document

-- Rules 4 and 5
#ASSERT `o 53 r 4 the application for registration may be made without notice` TRUE EQUALS JUST TRUE -- "may be made without notice"
#ASSERT `o 53 r 4 the application for registration may be made without notice` FALSE EQUALS NOTHING -- not an application under section 30(1)
#ASSERT `o 53 r 5 the supporting affidavit is as it must be` TRUE FALSE FALSE TRUE (`o 53 r 5 what the affidavit says` OF TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE) EQUALS JUST TRUE -- money order, English, the person appeared: (a), (b)(i), (b)(iii) sum, (b)(iv)
#ASSERT `o 53 r 5 the supporting affidavit is as it must be` TRUE FALSE FALSE FALSE (`o 53 r 5 what the affidavit says` OF TRUE, FALSE, TRUE, FALSE, FALSE, TRUE, TRUE) EQUALS JUST TRUE -- not money: the property not recovered
#ASSERT `o 53 r 5 the supporting affidavit is as it must be` TRUE TRUE FALSE TRUE (`o 53 r 5 what the affidavit says` OF TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, TRUE) EQUALS JUST TRUE -- not in English: the translation exhibited
#ASSERT `o 53 r 5 the supporting affidavit is as it must be` TRUE TRUE FALSE TRUE (`o 53 r 5 what the affidavit says` OF TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE) EQUALS NOTHING -- not in English: no translation, a bare "must"
#ASSERT `o 53 r 5 the supporting affidavit is as it must be` TRUE FALSE TRUE TRUE (`o 53 r 5 what the affidavit says` OF TRUE, FALSE, TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS JUST TRUE -- a person affected did not appear: notice stated
#ASSERT `o 53 r 5 the supporting affidavit is as it must be` TRUE FALSE TRUE TRUE (`o 53 r 5 what the affidavit says` OF TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE) EQUALS NOTHING -- a person affected did not appear: notice not stated
#ASSERT `o 53 r 5 the supporting affidavit is as it must be` TRUE FALSE FALSE TRUE (`o 53 r 5 what the affidavit says` OF FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE) EQUALS NOTHING -- the order is not exhibited
#ASSERT `o 53 r 5 the supporting affidavit is as it must be` TRUE FALSE FALSE TRUE (`o 53 r 5 what the affidavit says` OF TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE) EQUALS NOTHING -- (b)(i) not stated
#ASSERT `o 53 r 5 the supporting affidavit is as it must be` TRUE FALSE FALSE TRUE (`o 53 r 5 what the affidavit says` OF TRUE, FALSE, TRUE, FALSE, FALSE, TRUE, TRUE) EQUALS NOTHING -- money order: the sum not stated
#ASSERT `o 53 r 5 the supporting affidavit is as it must be` TRUE FALSE FALSE FALSE (`o 53 r 5 what the affidavit says` OF TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE) EQUALS NOTHING -- not money: the property not stated
#ASSERT `o 53 r 5 the supporting affidavit is as it must be` TRUE FALSE FALSE TRUE (`o 53 r 5 what the affidavit says` OF TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE) EQUALS NOTHING -- (b)(iv) particulars not given
#ASSERT `o 53 r 5 the supporting affidavit is as it must be` FALSE FALSE FALSE TRUE (`o 53 r 5 what the affidavit says` OF TRUE, FALSE, TRUE, FALSE, TRUE, FALSE, TRUE) EQUALS NOTHING -- not an application under section 30(1)

-- Rules 6 to 10
#ASSERT `o 53 r 6(1) the Registrar has kept the register as the Registrar must` TRUE EQUALS JUST TRUE -- "must keep a register"
#ASSERT `o 53 r 6(1) the Registrar has kept the register as the Registrar must` FALSE EQUALS NOTHING -- not kept: a bare "must"
#ASSERT `o 53 r 6(2) the register includes the particulars it must` TRUE TRUE TRUE EQUALS JUST TRUE -- all three kinds of particulars
#ASSERT `o 53 r 6(2) the register includes the particulars it must` FALSE TRUE TRUE EQUALS NOTHING -- no particulars of cancellations
#ASSERT `o 53 r 6(2) the register includes the particulars it must` TRUE FALSE TRUE EQUALS NOTHING -- no particulars of variation, satisfaction or discharge
#ASSERT `o 53 r 6(2) the register includes the particulars it must` TRUE TRUE FALSE EQUALS NOTHING -- no particulars of enforcement orders
#ASSERT `o 53 r 7(1) notice of the registration has been served as it must be` TRUE TRUE EQUALS JUST TRUE -- registered, notice served
#ASSERT `o 53 r 7(1) notice of the registration has been served as it must be` TRUE FALSE EQUALS NOTHING -- registered, notice not served: a bare "must"
#ASSERT `o 53 r 7(1) notice of the registration has been served as it must be` FALSE TRUE EQUALS NOTHING -- no order registered
#ASSERT `o 53 r 7(2) service of the notice out of Singapore is permissible without permission` TRUE EQUALS JUST TRUE -- "may be effected out of Singapore without permission"
#ASSERT `o 53 r 7(2) service of the notice out of Singapore is permissible without permission` FALSE EQUALS NOTHING -- not service out of Singapore
#ASSERT `o 53 r 7(2) Order 8, Rules 2, 3, 7 and 8 apply in relation to the notice as they apply to an originating claim` TRUE EQUALS JUST TRUE -- "apply in relation to such a notice"
#ASSERT `o 53 r 7(2) Order 8, Rules 2, 3, 7 and 8 apply in relation to the notice as they apply to an originating claim` FALSE EQUALS NOTHING -- not service out of Singapore
#ASSERT `o 53 r 7(3) the notice states what it must` TRUE TRUE TRUE EQUALS JUST TRUE -- states the period and that the order will not be enforced until after it
#ASSERT `o 53 r 7(3) the notice states what it must` TRUE FALSE TRUE EQUALS NOTHING -- the period not stated
#ASSERT `o 53 r 7(3) the notice states what it must` TRUE TRUE FALSE EQUALS NOTHING -- the bar on enforcement not stated
#ASSERT `o 53 r 7(3) the notice states what it must` FALSE TRUE TRUE EQUALS NOTHING -- not a notice of registration
#ASSERT `o 53 r 8 the application to cancel is supported by an affidavit as it must be` TRUE TRUE EQUALS JUST TRUE -- "must be supported by affidavit"
#ASSERT `o 53 r 8 the application to cancel is supported by an affidavit as it must be` TRUE FALSE EQUALS NOTHING -- no affidavit: a bare "must"
#ASSERT `o 53 r 8 the application to cancel is supported by an affidavit as it must be` FALSE TRUE EQUALS NOTHING -- not an application to cancel
#ASSERT `o 53 r 9(1) enforcement of the order is barred` TRUE (Date 12 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- the period has not expired
#ASSERT `o 53 r 9(1) enforcement of the order is barred` TRUE (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- the last day of the period: not yet "after the expiration"
#ASSERT `o 53 r 9(1) enforcement of the order is barred` TRUE (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- "until after the expiration of the period": expired
#ASSERT `o 53 r 9(1) enforcement of the order is barred` FALSE (Date 12 6 2026) (Date 15 6 2026) EQUALS NOTHING -- not an order registered under section 30(2)
#ASSERT `o 53 r 9(1) the order may be enforced` TRUE (Date 12 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- barred
#ASSERT `o 53 r 9(1) the order may be enforced` TRUE (Date 16 6 2026) (Date 15 6 2026) EQUALS NOTHING -- the end of the period lifts the bar and grants nothing
#ASSERT `o 53 r 9(1) the order may be enforced` FALSE (Date 16 6 2026) (Date 15 6 2026) EQUALS NOTHING -- not an order registered under section 30(2)
#ASSERT `o 53 r 9(2) enforcement of the order is barred` TRUE FALSE EQUALS JUST TRUE -- application made, not determined
#ASSERT `o 53 r 9(2) enforcement of the order is barred` TRUE TRUE EQUALS JUST FALSE -- "until after such application is determined": determined
#ASSERT `o 53 r 9(2) enforcement of the order is barred` FALSE FALSE EQUALS JUST FALSE -- no application: the "if" fails
#ASSERT `o 53 r 9(2) the order may be enforced` TRUE FALSE EQUALS JUST FALSE -- barred
#ASSERT `o 53 r 9(2) the order may be enforced` TRUE TRUE EQUALS NOTHING -- determination lifts the bar and grants nothing
#ASSERT `o 53 r 9(2) the order may be enforced` FALSE FALSE EQUALS NOTHING -- the bar is not engaged
#ASSERT `o 53 r 10 Rules 4 to 9 yield to the provisions of the order made under section 17` TRUE EQUALS JUST TRUE -- "subject to the provisions of any order made under section 17"
#ASSERT `o 53 r 10 Rules 4 to 9 yield to the provisions of the order made under section 17` FALSE EQUALS NOTHING -- no such order

-- Rule 11
#ASSERT `o 53 r 11(1) the application is filed and served with a supporting affidavit as it must be` TRUE TRUE FALSE FALSE (`o 53 r 11(1) what the supporting affidavit says` OF FALSE, TRUE, FALSE) EQUALS JUST TRUE -- no proceedings instituted, paragraph 6(2) does not apply: (b) only
#ASSERT `o 53 r 11(1) the application is filed and served with a supporting affidavit as it must be` TRUE TRUE TRUE FALSE (`o 53 r 11(1) what the supporting affidavit says` OF TRUE, TRUE, FALSE) EQUALS JUST TRUE -- proceedings instituted: (a) stated
#ASSERT `o 53 r 11(1) the application is filed and served with a supporting affidavit as it must be` TRUE TRUE TRUE FALSE (`o 53 r 11(1) what the supporting affidavit says` OF FALSE, TRUE, FALSE) EQUALS NOTHING -- proceedings instituted: (a) not stated
#ASSERT `o 53 r 11(1) the application is filed and served with a supporting affidavit as it must be` TRUE TRUE FALSE TRUE (`o 53 r 11(1) what the supporting affidavit says` OF FALSE, TRUE, TRUE) EQUALS JUST TRUE -- paragraph 6(2) applies: (c) indicated
#ASSERT `o 53 r 11(1) the application is filed and served with a supporting affidavit as it must be` TRUE TRUE FALSE TRUE (`o 53 r 11(1) what the supporting affidavit says` OF FALSE, TRUE, FALSE) EQUALS NOTHING -- paragraph 6(2) applies: (c) not indicated
#ASSERT `o 53 r 11(1) the application is filed and served with a supporting affidavit as it must be` TRUE TRUE FALSE FALSE (`o 53 r 11(1) what the supporting affidavit says` OF FALSE, FALSE, FALSE) EQUALS NOTHING -- (b) full particulars not given
#ASSERT `o 53 r 11(1) the application is filed and served with a supporting affidavit as it must be` TRUE FALSE FALSE FALSE (`o 53 r 11(1) what the supporting affidavit says` OF FALSE, TRUE, FALSE) EQUALS NOTHING -- not filed and served with an affidavit
#ASSERT `o 53 r 11(1) the application is filed and served with a supporting affidavit as it must be` FALSE TRUE FALSE FALSE (`o 53 r 11(1) what the supporting affidavit says` OF FALSE, TRUE, FALSE) EQUALS NOTHING -- not an application under paragraph 7(1) or 8(1)
#ASSERT `o 53 r 11(2) the document is entitled as it must be` TRUE TRUE TRUE EQUALS JUST TRUE -- in the matter of the defendant and of the Act
#ASSERT `o 53 r 11(2) the document is entitled as it must be` TRUE FALSE TRUE EQUALS NOTHING -- not in the matter of the defendant
#ASSERT `o 53 r 11(2) the document is entitled as it must be` TRUE TRUE FALSE EQUALS NOTHING -- not in the matter of the Act
#ASSERT `o 53 r 11(2) the document is entitled as it must be` FALSE TRUE TRUE EQUALS NOTHING -- not the originating application or a later document
#ASSERT `o 53 r 11(3) the supporting affidavit may contain statements of information or belief` FALSE TRUE EQUALS JUST TRUE -- sources and grounds given
#ASSERT `o 53 r 11(3) the supporting affidavit may contain statements of information or belief` TRUE TRUE EQUALS JUST FALSE -- "Unless the Court otherwise directs"
#ASSERT `o 53 r 11(3) the supporting affidavit may contain statements of information or belief` FALSE FALSE EQUALS NOTHING -- no sources and grounds: not addressed

-- Rule 12
#ASSERT `o 53 r 12(1) the restraint order may be made subject to the condition or exception` `o 53 r 12(1)(a) a condition relating to the indemnifying of third parties against expenses incurred in complying with the order` EQUALS JUST TRUE -- (a)
#ASSERT `o 53 r 12(1) the restraint order may be made subject to the condition or exception` `o 53 r 12(1)(b) an exception relating to the living expenses and legal expenses of the defendant` EQUALS JUST TRUE -- (b)
#ASSERT `o 53 r 12(1) the restraint order may be made subject to the condition or exception` `o 53 r 12(1) another condition or exception` EQUALS NOTHING -- "including" does not close the list
#ASSERT `o 53 r 12(1) the Attorney-General or the receiver is required to give an undertaking to abide by any order as to damages` EQUALS JUST FALSE -- "is not required to give an undertaking"
-- The hearing with notice is fixed for 1 April 2025.  "until a day which is fixed": the day fixed is taken as included (fork 53.4).
#ASSERT `o 53 r 12(2) the restraint order has effect until the day fixed for the hearing with notice` TRUE FALSE (Date 20 3 2025) (Date 1 4 2025) EQUALS JUST TRUE -- made without notice, a day before the day fixed
#ASSERT `o 53 r 12(2) the restraint order has effect until the day fixed for the hearing with notice` TRUE FALSE (Date 1 4 2025) (Date 1 4 2025) EQUALS JUST TRUE -- made without notice, the day fixed itself: included
#ASSERT `o 53 r 12(2) the restraint order has effect until the day fixed for the hearing with notice` TRUE FALSE (Date 2 4 2025) (Date 1 4 2025) EQUALS JUST FALSE -- made without notice, the day after the day fixed: the effect has ended
#ASSERT `o 53 r 12(2) the restraint order has effect until the day fixed for the hearing with notice` TRUE TRUE (Date 20 3 2025) (Date 1 4 2025) EQUALS JUST FALSE -- "Unless the Court otherwise directs"
#ASSERT `o 53 r 12(2) the restraint order has effect until the day fixed for the hearing with notice` FALSE FALSE (Date 20 3 2025) (Date 1 4 2025) EQUALS NOTHING -- an order made with notice: the paragraph does not speak
#ASSERT `o 53 r 12(2) the restraint order has effect until the day fixed for the hearing with notice` FALSE FALSE (Date 2 4 2025) (Date 1 4 2025) EQUALS NOTHING -- an order made with notice: the paragraph does not speak, whatever the day
#ASSERT `o 53 r 12(2) the restraint order has effect until the day fixed for the hearing with notice` FALSE TRUE (Date 20 3 2025) (Date 1 4 2025) EQUALS JUST FALSE -- the Court has directed otherwise
#ASSERT `o 53 r 12(3) the duty to serve and notify arises` TRUE EQUALS JUST TRUE -- "Where a restraint order is made"
#ASSERT `o 53 r 12(3) the duty to serve and notify arises` FALSE EQUALS JUST FALSE -- no restraint order made
#ASSERT `o 53 r 12(3) the copies have been served and the persons notified as required` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- served on the defendant and others, others notified
#ASSERT `o 53 r 12(3) the copies have been served and the persons notified as required` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- "Unless the Court otherwise provides": service not needed
#ASSERT `o 53 r 12(3) the copies have been served and the persons notified as required` TRUE FALSE FALSE TRUE EQUALS NOTHING -- not served: a bare "must"
#ASSERT `o 53 r 12(3) the copies have been served and the persons notified as required` TRUE FALSE TRUE FALSE EQUALS NOTHING -- others not notified
#ASSERT `o 53 r 12(3) the copies have been served and the persons notified as required` FALSE FALSE TRUE TRUE EQUALS NOTHING -- the duty does not arise
#ASSERT `o 53 r 12(4) the duty to serve arises` TRUE EQUALS JUST TRUE -- "Where a charging order is made"
#ASSERT `o 53 r 12(4) the duty to serve arises` FALSE EQUALS JUST FALSE -- no charging order made
#ASSERT `o 53 r 12(4) the copies of the charging order have been served as required` TRUE FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE -- defendant served, no other holder, Accountant-General copy served
#ASSERT `o 53 r 12(4) the copies of the charging order have been served as required` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- defendant and other holder served
#ASSERT `o 53 r 12(4) the copies of the charging order have been served as required` TRUE FALSE TRUE TRUE FALSE TRUE EQUALS NOTHING -- other holder not served
#ASSERT `o 53 r 12(4) the copies of the charging order have been served as required` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING -- copy not served on the Accountant-General or company
#ASSERT `o 53 r 12(4) the copies of the charging order have been served as required` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE -- the Court has otherwise directed as to service
#ASSERT `o 53 r 12(4) the copies of the charging order have been served as required` FALSE FALSE FALSE TRUE FALSE TRUE EQUALS NOTHING -- the duty does not arise

-- Rule 13
#ASSERT `o 53 r 13(1) the person or body may apply to discharge or vary the order` TRUE EQUALS JUST TRUE -- served or notified
#ASSERT `o 53 r 13(1) the person or body may apply to discharge or vary the order` FALSE EQUALS NOTHING -- neither served nor notified
#ASSERT `o 53 r 13(2) the period before the hearing of the application`'s `period length` EQUALS 7 -- "at least 7 clear days"
#ASSERT `o 53 r 13(2) the period before the hearing of the application`'s `period unit` EQUALS `Clear days` -- "7 clear days"
#ASSERT `o 53 r 13(2) the application and supporting affidavit are filed and served as they must be` TRUE TRUE FALSE TRUE (Date 12 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- the Attorney-General and the defendant, in time
#ASSERT `o 53 r 13(2) the application and supporting affidavit are filed and served as they must be` TRUE TRUE TRUE FALSE (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- the defendant is the applicant: not served on the defendant, on the last day
#ASSERT `o 53 r 13(2) the application and supporting affidavit are filed and served as they must be` TRUE TRUE FALSE TRUE (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- late: a stated period missed
#ASSERT `o 53 r 13(2) the application and supporting affidavit are filed and served as they must be` TRUE TRUE FALSE FALSE (Date 12 6 2026) (Date 15 6 2026) EQUALS NOTHING -- not served on the defendant who is not the applicant
#ASSERT `o 53 r 13(2) the application and supporting affidavit are filed and served as they must be` TRUE FALSE FALSE TRUE (Date 12 6 2026) (Date 15 6 2026) EQUALS NOTHING -- not served on the Attorney-General or receiver
#ASSERT `o 53 r 13(2) the application and supporting affidavit are filed and served as they must be` FALSE TRUE FALSE TRUE (Date 12 6 2026) (Date 15 6 2026) EQUALS NOTHING -- not the application under paragraph (1)

-- Rule 14
#ASSERT `o 53 r 14(1) the application may be made` TRUE TRUE `o 53 r 14(1)(a) to discharge or vary the order` EQUALS JUST TRUE -- (a)
#ASSERT `o 53 r 14(1) the application may be made` TRUE TRUE `o 53 r 14(1)(b) for a restraint order or a charging order in respect of other subject property` EQUALS JUST TRUE -- (b)
#ASSERT `o 53 r 14(1) the application may be made` TRUE TRUE `o 53 r 14(1)(c) for the appointment of a receiver` EQUALS JUST TRUE -- (c)
#ASSERT `o 53 r 14(1) the application may be made` TRUE TRUE `o 53 r 14(1) another application` EQUALS NOTHING -- three applications named without "only"
#ASSERT `o 53 r 14(1) the application may be made` TRUE FALSE `o 53 r 14(1)(a) to discharge or vary the order` EQUALS JUST FALSE -- the applicant is not the Attorney-General or the receiver
#ASSERT `o 53 r 14(1) the application may be made` FALSE TRUE `o 53 r 14(1)(a) to discharge or vary the order` EQUALS JUST FALSE -- no order made: the "where" fails
#ASSERT `o 53 r 14(1) the application may be made without notice` TRUE TRUE EQUALS JUST TRUE -- a case of urgency
#ASSERT `o 53 r 14(1) the application may be made without notice` TRUE FALSE EQUALS JUST FALSE -- not urgent: the "where" fails
#ASSERT `o 53 r 14(1) the application may be made without notice` FALSE TRUE EQUALS JUST FALSE -- no order made
#ASSERT `o 53 r 14(2) the application is supported by an affidavit as it must be` TRUE TRUE EQUALS JUST TRUE -- "must be supported by affidavit"
#ASSERT `o 53 r 14(2) the application is supported by an affidavit as it must be` TRUE FALSE EQUALS NOTHING -- no affidavit: a bare "must"
#ASSERT `o 53 r 14(2) the application is supported by an affidavit as it must be` FALSE TRUE EQUALS NOTHING -- not an application under paragraph (1)
#ASSERT `o 53 r 14(3) the affidavit contains the particulars it must` TRUE TRUE EQUALS JUST TRUE -- full particulars
#ASSERT `o 53 r 14(3) the affidavit contains the particulars it must` TRUE FALSE EQUALS NOTHING -- particulars not given
#ASSERT `o 53 r 14(3) the affidavit contains the particulars it must` FALSE TRUE EQUALS NOTHING -- not an application for a restraint order or a charging order
#ASSERT `o 53 r 14(4) the period before the hearing of the application`'s `period length` EQUALS 7 -- "at least 7 clear days"
#ASSERT `o 53 r 14(4) the period before the hearing of the application`'s `period unit` EQUALS `Clear days` -- "7 clear days"
#ASSERT `o 53 r 14(4) the application and affidavit are filed and served as they must be` TRUE TRUE FALSE FALSE (Date 12 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- the defendant, no receiver, in time
#ASSERT `o 53 r 14(4) the application and affidavit are filed and served as they must be` TRUE TRUE TRUE TRUE (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- the defendant and the receiver, on the last day
#ASSERT `o 53 r 14(4) the application and affidavit are filed and served as they must be` TRUE TRUE TRUE FALSE (Date 12 6 2026) (Date 15 6 2026) EQUALS NOTHING -- a receiver appointed but not served
#ASSERT `o 53 r 14(4) the application and affidavit are filed and served as they must be` TRUE FALSE FALSE FALSE (Date 12 6 2026) (Date 15 6 2026) EQUALS NOTHING -- not served on the defendant
#ASSERT `o 53 r 14(4) the application and affidavit are filed and served as they must be` TRUE TRUE FALSE FALSE (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- late
#ASSERT `o 53 r 14(4) the application and affidavit are filed and served as they must be` FALSE TRUE FALSE FALSE (Date 12 6 2026) (Date 15 6 2026) EQUALS NOTHING -- not an application under this Rule
#ASSERT `o 53 r 14(5) Rule 12(3) and (4) apply to the service of the order` TRUE EQUALS JUST TRUE -- service on a person other than the defendant
#ASSERT `o 53 r 14(5) Rule 12(3) and (4) apply to the service of the order` FALSE EQUALS NOTHING -- service on the defendant

-- Rule 15
#ASSERT `o 53 r 15(1) the period before the hearing of the application`'s `period length` EQUALS 7 -- "at least 7 clear days"
#ASSERT `o 53 r 15(1) the period before the hearing of the application`'s `period unit` EQUALS `Clear days` -- "7 clear days"
#ASSERT `o 53 r 15(1) the application is filed and served with a supporting affidavit as it must be` TRUE TRUE TRUE FALSE FALSE (Date 12 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- defendant and holders served, no receiver
#ASSERT `o 53 r 15(1) the application is filed and served with a supporting affidavit as it must be` TRUE TRUE TRUE TRUE TRUE (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- receiver served too, on the last day
