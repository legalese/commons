IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc12-order-66`

-- Rules of Court 2021 (Singapore) -- tests for Order 66 (roc12-order-66.l4).
-- Every expected value is written from the text of the Rule (lines 7531 to 7568 of the source file) before the run.
-- The dates are made up; the last day of a period and the first day of a wait are inputs from Order 3, Rule 3.

§ `O 66 r 1`
-- Arguments: claims possession; alleges sole occupation without licence or consent; an occupier is a tenant holding over.
#ASSERT `o 66 r 1 the proceedings may be brought by originating application under this Order` TRUE TRUE FALSE EQUALS JUST TRUE -- all the "Where" conditions met
#ASSERT `o 66 r 1 the proceedings may be brought by originating application under this Order` TRUE TRUE TRUE EQUALS JUST FALSE -- "(not being a tenant ... holding over ...)": QE, the Where condition fails
#ASSERT `o 66 r 1 the proceedings may be brought by originating application under this Order` TRUE FALSE FALSE EQUALS JUST FALSE -- no allegation of sole occupation without licence or consent
#ASSERT `o 66 r 1 the proceedings may be brought by originating application under this Order` FALSE TRUE FALSE EQUALS JUST FALSE -- no claim to possession of land

§ `O 66 r 2`
#ASSERT `o 66 r 2 a Registrar may hear and determine the proceedings` TRUE EQUALS JUST TRUE -- "Proceedings under this Order may be heard and determined by a Registrar"
#ASSERT `o 66 r 2 a Registrar may hear and determine the proceedings` FALSE EQUALS NOTHING -- other proceedings are outside the Rule
-- Arguments: proceedings under this Order; the Registrar thinks they should properly be decided by the Judge.
#ASSERT `o 66 r 2 the Registrar may refer the proceedings to a Judge` TRUE TRUE EQUALS JUST TRUE -- "may refer them to a Judge if the Registrar thinks ..."
#ASSERT `o 66 r 2 the Registrar may refer the proceedings to a Judge` TRUE FALSE EQUALS JUST FALSE -- the "if" is not met
#ASSERT `o 66 r 2 the Registrar may refer the proceedings to a Judge` FALSE TRUE EQUALS NOTHING -- other proceedings are outside the Rule

§ `O 66 r 3`
#ASSERT `o 66 r 3 the originating application includes the note as the Rule requires` TRUE TRUE EQUALS JUST TRUE -- the note is included at the end
#ASSERT `o 66 r 3 the originating application includes the note as the Rule requires` TRUE FALSE EQUALS NOTHING -- QB: a bare "must include", not done
#ASSERT `o 66 r 3 the originating application includes the note as the Rule requires` FALSE TRUE EQUALS NOTHING -- not an application filed under this Order
#ASSERT `o 66 r 3 the note` EQUALS "Note: Any person occupying the premises who is not named as a defendant by this originating application may apply to the Court personally or by solicitor to be joined as a defendant. If a person occupying the premises does not attend personally or by solicitor at the time and place abovementioned, such order will be made as the Court may think just and expedient."

§ `O 66 r 4`
-- r 4(1).  Arguments: filed under this Order; affidavit filed at the time of filing; states (a) interest; states (b) circumstances; states (c) no knowledge of other names.
#ASSERT `o 66 r 4(1) the claimant has filed the supporting affidavit as the Rule requires` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- affidavit filed at the time and stating (a), (b), (c)
#ASSERT `o 66 r 4(1) the claimant has filed the supporting affidavit as the Rule requires` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING -- QB: no affidavit filed at the time
#ASSERT `o 66 r 4(1) the claimant has filed the supporting affidavit as the Rule requires` TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING -- (a) not stated
#ASSERT `o 66 r 4(1) the claimant has filed the supporting affidavit as the Rule requires` TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING -- (b) not stated
#ASSERT `o 66 r 4(1) the claimant has filed the supporting affidavit as the Rule requires` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- (c) not stated
#ASSERT `o 66 r 4(1) the claimant has filed the supporting affidavit as the Rule requires` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- not an originating application under this Order
-- r 4(2).  Arguments for the companion: unable to identify every occupier.  For the compliance function: unable; states the steps.
#ASSERT `o 66 r 4(2) the claimant should state the reasonable steps taken in the affidavit` TRUE EQUALS JUST TRUE -- "Where the claimant is unable, after taking reasonable steps, to identify every person occupying the land"
#ASSERT `o 66 r 4(2) the claimant should state the reasonable steps taken in the affidavit` FALSE EQUALS JUST FALSE -- the "Where" is not met (QD companion)
#ASSERT `o 66 r 4(2) the affidavit states the reasonable steps as the Rule says it should` TRUE TRUE EQUALS JUST TRUE -- unable, and the affidavit states and describes the steps
#ASSERT `o 66 r 4(2) the affidavit states the reasonable steps as the Rule says it should` TRUE FALSE EQUALS NOTHING -- unable, steps not stated: "should" is advice
#ASSERT `o 66 r 4(2) the affidavit states the reasonable steps as the Rule says it should` FALSE FALSE EQUALS NOTHING -- QD: the trigger is unmet, so nothing is answered here

§ `O 66 r 5`
-- r 5(1).
#ASSERT `o 66 r 5(1) the duty to serve the named occupier arises` TRUE EQUALS JUST TRUE -- "Where any person in occupation of the land is named in the originating application"
#ASSERT `o 66 r 5(1) the duty to serve the named occupier arises` FALSE EQUALS JUST FALSE -- the "Where" is not met
-- Arguments: occupier named; manner; the Court directed the manner.
#ASSERT `o 66 r 5(1) the named occupier has been served in a manner the Rule allows` TRUE `o 66 r 5(1)(a) personally` FALSE EQUALS JUST TRUE -- (a)
#ASSERT `o 66 r 5(1) the named occupier has been served in a manner the Rule allows` TRUE `o 66 r 5(1)(b) by leaving a copy of the originating application and of the affidavit or sending them to the person at the premises` FALSE EQUALS JUST TRUE -- (b)
#ASSERT `o 66 r 5(1) the named occupier has been served in a manner the Rule allows` TRUE `o 66 r 5(1)(c) in such other manner as the Court may direct` TRUE EQUALS JUST TRUE -- (c), the manner the Court directed
#ASSERT `o 66 r 5(1) the named occupier has been served in a manner the Rule allows` TRUE `o 66 r 5(1)(c) in such other manner as the Court may direct` FALSE EQUALS NOTHING -- (c) reaches only a manner the Court directs
#ASSERT `o 66 r 5(1) the named occupier has been served in a manner the Rule allows` TRUE `o 66 r 5(1) another manner` FALSE EQUALS NOTHING -- QB: a bare "must be served" in the listed ways
#ASSERT `o 66 r 5(1) the named occupier has been served in a manner the Rule allows` FALSE `o 66 r 5(1)(a) personally` FALSE EQUALS NOTHING -- QD: the duty does not arise
-- r 5(2).  Arguments: an unnamed occupier; the Court otherwise directs.
#ASSERT `o 66 r 5(2) the requirement to serve the unnamed occupiers in one of these ways applies` TRUE FALSE EQUALS JUST TRUE -- an unnamed occupier and no direction
#ASSERT `o 66 r 5(2) the requirement to serve the unnamed occupiers in one of these ways applies` TRUE TRUE EQUALS JUST FALSE -- "unless the Court otherwise directs"
#ASSERT `o 66 r 5(2) the requirement to serve the unnamed occupiers in one of these ways applies` FALSE FALSE EQUALS JUST FALSE -- no unnamed occupier: the "Where" is not met
#ASSERT `o 66 r 5(2) the unnamed occupiers have been served in a manner the Rule requires` (JUST TRUE) `o 66 r 5(2)(a) affixing a copy to the main door or other conspicuous part of the premises and, if practicable, inserting a copy through the letterbox in a sealed transparent envelope addressed to "the occupiers"` EQUALS JUST TRUE -- (a)
#ASSERT `o 66 r 5(2) the unnamed occupiers have been served in a manner the Rule requires` (JUST TRUE) `o 66 r 5(2)(b) placing stakes in the ground at conspicuous parts of the occupied land with a sealed transparent envelope addressed to "the occupiers" affixed to each` EQUALS JUST TRUE -- (b)
#ASSERT `o 66 r 5(2) the unnamed occupiers have been served in a manner the Rule requires` (JUST TRUE) `o 66 r 5(2) another manner` EQUALS NOTHING -- QB: a bare "must be served ... by (a) or (b)"
#ASSERT `o 66 r 5(2) the unnamed occupiers have been served in a manner the Rule requires` (JUST FALSE) `o 66 r 5(2)(a) affixing a copy to the main door or other conspicuous part of the premises and, if practicable, inserting a copy through the letterbox in a sealed transparent envelope addressed to "the occupiers"` EQUALS NOTHING -- QD: the requirement does not apply
#ASSERT `o 66 r 5(2) the unnamed occupiers have been served in a manner the Rule requires` NOTHING `o 66 r 5(2)(a) affixing a copy to the main door or other conspicuous part of the premises and, if practicable, inserting a copy through the letterbox in a sealed transparent envelope addressed to "the occupiers"` EQUALS NOTHING -- whether the requirement applies is not answered
-- r 5(3).  Arguments: proceedings under this Order; the provision of Order 6.
#ASSERT `o 66 r 5(3) the provision of Order 6 applies to the proceedings` TRUE `o 66 r 5(3) Order 6, Rule 11(1)` EQUALS JUST FALSE -- named in the paragraph
#ASSERT `o 66 r 5(3) the provision of Order 6 applies to the proceedings` TRUE `o 66 r 5(3) Order 6, Rule 11(4)` EQUALS JUST FALSE -- named
#ASSERT `o 66 r 5(3) the provision of Order 6 applies to the proceedings` TRUE `o 66 r 5(3) Order 6, Rule 11(5)` EQUALS JUST FALSE -- named
#ASSERT `o 66 r 5(3) the provision of Order 6 applies to the proceedings` TRUE `o 66 r 5(3) Order 6, Rule 12(1)` EQUALS JUST FALSE -- named
#ASSERT `o 66 r 5(3) the provision of Order 6 applies to the proceedings` TRUE `o 66 r 5(3) Order 6, Rule 12(2)` EQUALS JUST FALSE -- named
#ASSERT `o 66 r 5(3) the provision of Order 6 applies to the proceedings` TRUE `o 66 r 5(3) Order 6, Rule 12(6)` EQUALS JUST FALSE -- named
#ASSERT `o 66 r 5(3) the provision of Order 6 applies to the proceedings` TRUE `o 66 r 5(3) another provision of Order 6` EQUALS NOTHING -- the paragraph disapplies only six provisions
#ASSERT `o 66 r 5(3) the provision of Order 6 applies to the proceedings` FALSE `o 66 r 5(3) Order 6, Rule 11(1)` EQUALS NOTHING -- proceedings not under this Order

§ `O 66 r 6`
-- Arguments: not named as a defendant; in occupation; wishes to be heard.
#ASSERT `o 66 r 6 the person may apply at any stage of the proceedings to be joined as a defendant` TRUE TRUE TRUE EQUALS JUST TRUE -- all three descriptions fit
#ASSERT `o 66 r 6 the person may apply at any stage of the proceedings to be joined as a defendant` FALSE TRUE TRUE EQUALS NOTHING -- already named: outside the Rule
#ASSERT `o 66 r 6 the person may apply at any stage of the proceedings to be joined as a defendant` TRUE FALSE TRUE EQUALS NOTHING -- not in occupation
#ASSERT `o 66 r 6 the person may apply at any stage of the proceedings to be joined as a defendant` TRUE TRUE FALSE EQUALS NOTHING -- does not wish to be heard

§ `O 66 r 7`
-- r 7(1).  Arguments: under this Order; date of order; first day on which the order may be made; emergency; permission.
#ASSERT `o 66 r 7(1) the final order for possession may be made` TRUE (Date 10 3 2025) (Date 15 3 2025) FALSE FALSE EQUALS JUST FALSE -- an order 5 days before the first permitted day, no emergency
#ASSERT `o 66 r 7(1) the final order for possession may be made` TRUE (Date 10 3 2025) (Date 15 3 2025) TRUE FALSE EQUALS JUST FALSE -- emergency without the Court's permission
#ASSERT `o 66 r 7(1) the final order for possession may be made` TRUE (Date 10 3 2025) (Date 15 3 2025) FALSE TRUE EQUALS JUST FALSE -- permission without emergency
#ASSERT `o 66 r 7(1) the final order for possession may be made` TRUE (Date 10 3 2025) (Date 15 3 2025) TRUE TRUE EQUALS NOTHING -- QA: emergency and permission lift the bar and grant nothing
#ASSERT `o 66 r 7(1) the final order for possession may be made` TRUE (Date 15 3 2025) (Date 15 3 2025) FALSE FALSE EQUALS NOTHING -- made on the first permitted day: the bar does not speak to it
#ASSERT `o 66 r 7(1) the final order for possession may be made` TRUE (Date 20 3 2025) (Date 15 3 2025) FALSE FALSE EQUALS NOTHING -- made after the first permitted day
#ASSERT `o 66 r 7(1) the final order for possession may be made` FALSE (Date 10 3 2025) (Date 15 3 2025) FALSE FALSE EQUALS NOTHING -- not proceedings under this Order
#ASSERT `o 66 r 7(1) a final order made on that date is barred` TRUE (Date 10 3 2025) (Date 15 3 2025) FALSE FALSE EQUALS JUST TRUE -- an early order with neither emergency nor permission
#ASSERT `o 66 r 7(1) a final order made on that date is barred` TRUE (Date 10 3 2025) (Date 15 3 2025) TRUE TRUE EQUALS JUST FALSE -- the exception is met: the bar is lifted
#ASSERT `o 66 r 7(1) a final order made on that date is barred` TRUE (Date 10 3 2025) (Date 15 3 2025) TRUE FALSE EQUALS JUST TRUE -- emergency alone does not lift it
#ASSERT `o 66 r 7(1) a final order made on that date is barred` TRUE (Date 15 3 2025) (Date 15 3 2025) FALSE FALSE EQUALS JUST FALSE -- not early
#ASSERT `o 66 r 7(1) a final order made on that date is barred` FALSE (Date 10 3 2025) (Date 15 3 2025) FALSE FALSE EQUALS NOTHING -- not proceedings under this Order
-- r 7(2).  Arguments: under this Order; the form used.
#ASSERT `o 66 r 7(2) the form of the order for possession` EQUALS "95" -- "must be in Form 95"
#ASSERT `o 66 r 7(2) the order for possession is in the form the Rule requires` TRUE "95" EQUALS JUST TRUE -- Form 95
#ASSERT `o 66 r 7(2) the order for possession is in the form the Rule requires` TRUE "96" EQUALS NOTHING -- QB: another form
#ASSERT `o 66 r 7(2) the order for possession is in the form the Rule requires` FALSE "95" EQUALS NOTHING -- not proceedings under this Order
-- r 7(3).
#ASSERT `o 66 r 7(3) this Order prevents the Court from ordering possession to be given on a specified date` TRUE EQUALS JUST FALSE -- "Nothing in this Order prevents the Court from ordering possession to be given on a specified date"
#ASSERT `o 66 r 7(3) this Order prevents the Court from ordering possession to be given on a specified date` FALSE EQUALS NOTHING -- the paragraph saves only a power of that kind

§ `O 66 r 8`
-- r 8(1).  Arguments: to enforce an order for possession under this Order; date the application is filed; last day of the 3 months; permission.
#ASSERT `o 66 r 8(1) the party may file the application for an enforcement order` TRUE (Date 20 6 2025) (Date 15 6 2025) FALSE EQUALS JUST FALSE -- filed 5 days after the 3 months, without permission
#ASSERT `o 66 r 8(1) the party may file the application for an enforcement order` TRUE (Date 20 6 2025) (Date 15 6 2025) TRUE EQUALS NOTHING -- QA: late with permission: the bar is lifted and grants nothing
#ASSERT `o 66 r 8(1) the party may file the application for an enforcement order` TRUE (Date 15 6 2025) (Date 15 6 2025) FALSE EQUALS NOTHING -- filed on the last day: within the 3 months, the bar does not speak to it
#ASSERT `o 66 r 8(1) the party may file the application for an enforcement order` TRUE (Date 1 6 2025) (Date 15 6 2025) FALSE EQUALS NOTHING -- filed within the 3 months
#ASSERT `o 66 r 8(1) the party may file the application for an enforcement order` FALSE (Date 20 6 2025) (Date 15 6 2025) FALSE EQUALS NOTHING -- not to enforce an order for possession under this Order
#ASSERT `o 66 r 8(1) a filing on that date without permission is barred` TRUE (Date 20 6 2025) (Date 15 6 2025) FALSE EQUALS JUST TRUE -- late and without permission
#ASSERT `o 66 r 8(1) a filing on that date without permission is barred` TRUE (Date 20 6 2025) (Date 15 6 2025) TRUE EQUALS JUST FALSE -- late but permitted
#ASSERT `o 66 r 8(1) a filing on that date without permission is barred` TRUE (Date 15 6 2025) (Date 15 6 2025) FALSE EQUALS JUST FALSE -- not late
#ASSERT `o 66 r 8(1) a filing on that date without permission is barred` FALSE (Date 20 6 2025) (Date 15 6 2025) FALSE EQUALS NOTHING -- other applications are outside the Rule
#ASSERT `o 66 r 8(1) the period after which permission is needed`'s `period length` EQUALS 3 -- "3 months after the date of the order for possession": the number
#ASSERT `o 66 r 8(1) the period after which permission is needed`'s `period unit` EQUALS Months -- the unit
#ASSERT `o 66 r 8(1) the period after which permission is needed`'s `period direction` EQUALS `After the anchor` -- counted after the date of the order
-- r 8(2).
#ASSERT `o 66 r 8(2) the application for permission may be made without notice` FALSE EQUALS JUST TRUE -- "may be made without notice"
#ASSERT `o 66 r 8(2) the application for permission may be made without notice` TRUE EQUALS JUST FALSE -- "unless the Court otherwise directs"
-- r 8(3).
#ASSERT `o 66 r 8(3) the form of the enforcement order for possession` EQUALS "96" -- "must be in Form 96"
#ASSERT `o 66 r 8(3) the enforcement order for possession is in the form the Rule requires` "96" EQUALS JUST TRUE -- Form 96
#ASSERT `o 66 r 8(3) the enforcement order for possession is in the form the Rule requires` "95" EQUALS NOTHING -- QB: another form

§ `O 66 r 9`
#ASSERT `o 66 r 9 the Court may set aside or vary the order on such terms as it thinks just` TRUE EQUALS JUST TRUE -- "any order made in proceedings under this Order"
#ASSERT `o 66 r 9 the Court may set aside or vary the order on such terms as it thinks just` FALSE EQUALS NOTHING -- orders in other proceedings are outside the Rule

§ `O 66 -- the duties as regulative rules`
-- No deadline is stated for these duties; each is run once.  The prohibitions are run with the act done, which is a breach.
-- expected: FULFILLED
#TRACE `o 66 r 3 the claimant's duty to include the note` AT 0 WITH
    PARTY `o 66 the claimant` DOES `o 66 include the note at the end of the originating application` AT 1
-- expected: FULFILLED
#TRACE `o 66 r 4(1) the claimant's duty to file the supporting affidavit` AT 0 WITH
    PARTY `o 66 the claimant` DOES `o 66 file the supporting affidavit with the originating application` AT 0
-- expected: FULFILLED
#TRACE `o 66 r 5(1) the claimant's duty to serve the named occupier` AT 0 WITH
    PARTY `o 66 the claimant` DOES `o 66 serve the originating application and the affidavit` AT 3
-- expected: BREACH (the Court made an early final order)
#TRACE `o 66 r 7(1) the prohibition on an early final order for possession` AT 0 WITH
    PARTY `o 66 the Court` DOES `o 66 make a final order for possession less than 14 days after service without emergency and permission` AT 5
-- expected: BREACH (a late application without permission)
#TRACE `o 66 r 8(1) the prohibition on a late application for an enforcement order` AT 0 WITH
    PARTY `o 66 a party` DOES `o 66 file an application for an enforcement order after 3 months without permission` AT 5

§ `Fix round -- the earliest date for a final order, and the envelopes addressed to "the occupiers"`
#ASSERT `o 66 r 7(1) the earliest date for a final order for possession` (Date 1 3 2025) EQUALS Date 15 3 2025 -- 14 days after the date of service
#ASSERT `o 66 r 7(1) the earliest date for a final order for possession` (Date 20 12 2025) EQUALS Date 3 1 2026 -- across the end of the year
-- Rule 5(2)(a): it is practicable to insert a copy through the letterbox; a copy was inserted in a sealed transparent envelope; the envelope is addressed to "the occupiers".
#ASSERT `o 66 r 5(2)(a) the letterbox copy is as the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE -- inserted in an envelope addressed to "the occupiers"
#ASSERT `o 66 r 5(2)(a) the letterbox copy is as the Rule requires` TRUE TRUE FALSE EQUALS NOTHING -- QB: the envelope is not addressed to "the occupiers"
#ASSERT `o 66 r 5(2)(a) the letterbox copy is as the Rule requires` TRUE FALSE FALSE EQUALS NOTHING -- QB: practicable but nothing was inserted
#ASSERT `o 66 r 5(2)(a) the letterbox copy is as the Rule requires` FALSE FALSE FALSE EQUALS JUST TRUE -- "if practicable": it was not practicable, so no letterbox copy is required
-- Rule 5(2)(b): stakes at conspicuous parts; an envelope addressed to "the occupiers" on each; each envelope holds the copies.
#ASSERT `o 66 r 5(2)(b) the stakes are as the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE -- all three
#ASSERT `o 66 r 5(2)(b) the stakes are as the Rule requires` TRUE FALSE TRUE EQUALS NOTHING -- QB: an envelope is not addressed to "the occupiers"
#ASSERT `o 66 r 5(2)(b) the stakes are as the Rule requires` FALSE TRUE TRUE EQUALS NOTHING -- QB: no stakes were placed

