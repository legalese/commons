IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc6-order-25`

-- Tests for roc6-order-25.l4 (Order 25, Court fees).
-- Every expected value is written from the text (lines 3924 to 4049 of the source), beside the assertion, before the code was run.
-- The last days are made up: Order 3, Rule 3 (roc1's range) counts them.


-- ---------------------------------------------------------------------------
§ `Tests -- Rule 1`
-- ---------------------------------------------------------------------------

#ASSERT `o 25 r 1 "Court ADR service" is a service provided by the State Courts for resolving a dispute by an alternative dispute resolution process` TRUE TRUE EQUALS JUST TRUE -- "means": a State Courts service for an ADR process
#ASSERT `o 25 r 1 "Court ADR service" is a service provided by the State Courts for resolving a dispute by an alternative dispute resolution process` TRUE FALSE EQUALS JUST FALSE -- "means": not for ADR
#ASSERT `o 25 r 1 "Court ADR service" is a service provided by the State Courts for resolving a dispute by an alternative dispute resolution process` FALSE TRUE EQUALS JUST FALSE -- "means": not provided by the State Courts
#ASSERT `o 25 r 1 "Court ADR service" is a service provided by the State Courts for resolving a dispute by an alternative dispute resolution process` FALSE FALSE EQUALS JUST FALSE -- "means": neither
#ASSERT `o 25 r 1 the payment is within court fees` `o 25 r 1 a charge, commission or fee payable under these Rules` EQUALS JUST TRUE -- "includes all charges, commissions and fees payable under these Rules"
#ASSERT `o 25 r 1 the payment is within court fees` `o 25 r 1(a) a document fee payable on the filing or sealing of a specified document` EQUALS JUST TRUE -- (a)
#ASSERT `o 25 r 1 the payment is within court fees` `o 25 r 1(b) a hearing fee payable for a specified hearing` EQUALS JUST TRUE -- (b)
#ASSERT `o 25 r 1 the payment is within court fees` `o 25 r 1(c) a fee for provision of a Court ADR service by the State Courts` EQUALS JUST TRUE -- (c)
#ASSERT `o 25 r 1 the payment is within court fees` `o 25 r 1(d) a service provision fee payable for a service to be provided or rendered by, or which requires the attendance of, a court officer` EQUALS JUST TRUE -- (d)
#ASSERT `o 25 r 1 the payment is within court fees` `o 25 r 1(e) a search fee payable for a search to be made of court records` EQUALS JUST TRUE -- (e)
#ASSERT `o 25 r 1 the payment is within court fees` `o 25 r 1(f) a fee relating to an admiralty matter` EQUALS JUST TRUE -- (f)
#ASSERT `o 25 r 1 the payment is within court fees` `o 25 r 1 some other payment` EQUALS NOTHING -- "includes": the list is not closed
#ASSERT `o 25 r 1 the person is a court officer` `o 25 r 1 the Sheriff` EQUALS JUST TRUE -- "includes" the Sheriff
#ASSERT `o 25 r 1 the person is a court officer` `o 25 r 1 a commissioner for oaths` EQUALS JUST TRUE -- "includes" a commissioner for oaths
#ASSERT `o 25 r 1 the person is a court officer` `o 25 r 1 an interpreter` EQUALS JUST TRUE -- "includes" an interpreter
#ASSERT `o 25 r 1 the person is a court officer` `o 25 r 1 a clerk` EQUALS JUST TRUE -- "includes" a clerk
#ASSERT `o 25 r 1 the person is a court officer` `o 25 r 1 a process server` EQUALS JUST TRUE -- "includes" a process server
#ASSERT `o 25 r 1 the person is a court officer` `o 25 r 1 a bailiff` EQUALS JUST TRUE -- "includes" a bailiff
#ASSERT `o 25 r 1 the person is a court officer` `o 25 r 1 another officer attached to the court for the administration of justice and due execution of powers and duties vested in the court` EQUALS JUST TRUE -- "includes" or other officer attached to the court
#ASSERT `o 25 r 1 the person is a court officer` `o 25 r 1 someone else` EQUALS NOTHING -- "includes": the list is not closed

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 2`
-- ---------------------------------------------------------------------------

#ASSERT `o 25 r 2(1) court fees are paid in the circumstances and the manner set out` TRUE EQUALS JUST TRUE -- paid as the Order and the Fourth Schedule set out
#ASSERT `o 25 r 2(1) court fees are paid in the circumstances and the manner set out` FALSE EQUALS NOTHING -- "must be paid": silent on what follows
#ASSERT `o 25 r 2(2) paragraph (2) applies to the court fees` `Supreme Court` EQUALS JUST TRUE -- "payable in the Supreme Court"
#ASSERT `o 25 r 2(2) paragraph (2) applies to the court fees` `State Courts` EQUALS NOTHING -- scope limit with no "only" (ruling (c))
#ASSERT `o 25 r 2(4) the amount of the claim in Singapore dollars` TRUE 1000 1.5 EQUALS 1500 -- foreign currency: converted at the rate 1.5 applicable at the date of filing
#ASSERT `o 25 r 2(4) the amount of the claim in Singapore dollars` FALSE 1000 1.5 EQUALS 1000 -- Singapore dollars: not converted
#ASSERT `o 25 r 2(6) the amount counted towards the value of the claim` 1500 200 EQUALS 1300 -- the value "excludes non-contractual interest"
#ASSERT `o 25 r 2(6) the amount counted towards the value of the claim` 1500 0 EQUALS 1500 -- no such interest
-- arguments: liquidated demand; its value; unliquidated damages; the estimate; Probate and Administration Act; value of the estate; bill of costs; its total
#ASSERT `o 25 r 2 the value of the claim` TRUE 50000 FALSE 0 FALSE 0 FALSE 0 EQUALS 50000 -- (a): the value specified in the originating process
#ASSERT `o 25 r 2 the value of the claim` FALSE 0 TRUE 30000 FALSE 0 FALSE 0 EQUALS 30000 -- (b): the value estimated by the party filing
#ASSERT `o 25 r 2 the value of the claim` TRUE 50000 TRUE 30000 FALSE 0 FALSE 0 EQUALS 80000 -- (3): both liquidated and unliquidated, the aggregate
#ASSERT `o 25 r 2 the value of the claim` FALSE 0 FALSE 0 TRUE 250000 FALSE 0 EQUALS 250000 -- (c): the value of the estate
#ASSERT `o 25 r 2 the value of the claim` FALSE 0 FALSE 0 FALSE 0 TRUE 7000 EQUALS 7000 -- (e): the total amount claimed in the bill of costs
#ASSERT `o 25 r 2 the value of the claim` FALSE 0 FALSE 0 FALSE 0 FALSE 0 EQUALS 1000000 -- (d): none of the above, "deemed to have a value of up to $1 million" (the band's top, F-O25-1)
#ASSERT `o 25 r 2 the value of the claim` TRUE 0 FALSE 0 FALSE 0 FALSE 0 EQUALS 0 -- (a): a liquidated demand specified at nothing is worth nothing; (d) applies only when no head applies
-- arguments: the Registrar has determined the value as awarded; fees payable on that value; fees paid
#ASSERT `o 25 r 2(5) the Registrar may require the parties to pay the difference in the court fees` TRUE 500 300 EQUALS JUST TRUE -- more is payable on the value awarded than was paid: "pay the difference"
#ASSERT `o 25 r 2(5) the Registrar may require the parties to pay the difference in the court fees` TRUE 300 300 EQUALS NOTHING -- no difference: nothing to require
#ASSERT `o 25 r 2(5) the Registrar may require the parties to pay the difference in the court fees` TRUE 200 300 EQUALS NOTHING -- an excess, not a shortfall
#ASSERT `o 25 r 2(5) the Registrar may require the parties to pay the difference in the court fees` FALSE 500 300 EQUALS JUST FALSE -- "after determining the value of the claim as awarded": not yet determined (ruling (b); "after" read as "where", assumed)
#ASSERT `o 25 r 2(5) the Registrar may refund to the parties the excess court fees paid` TRUE 200 300 EQUALS JUST TRUE -- an excess was paid: "refund ... the excess court fees paid"
#ASSERT `o 25 r 2(5) the Registrar may refund to the parties the excess court fees paid` TRUE 300 300 EQUALS NOTHING -- no excess
#ASSERT `o 25 r 2(5) the Registrar may refund to the parties the excess court fees paid` TRUE 500 300 EQUALS NOTHING -- a shortfall, not an excess
#ASSERT `o 25 r 2(5) the Registrar may refund to the parties the excess court fees paid` FALSE 200 300 EQUALS JUST FALSE -- "after determining the value of the claim as awarded": not yet determined (ruling (b); "after" read as "where", assumed)

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 3`
-- ---------------------------------------------------------------------------

#ASSERT `o 25 r 3(1) the Court may make this order about court fees` `o 25 r 3(1)(a) waive or defer the payment of the whole or any part of court fees` EQUALS JUST TRUE -- (a)
#ASSERT `o 25 r 3(1) the Court may make this order about court fees` `o 25 r 3(1)(b) refund the whole or any part of court fees paid` EQUALS JUST TRUE -- (b)
#ASSERT `o 25 r 3(1) the Court may make this order about court fees` `o 25 r 3(1)(c) order that the whole or any part of court fees be paid by any party or be apportioned among all or any of the parties` EQUALS JUST TRUE -- (c)
#ASSERT `o 25 r 3(1) the Court may make this order about court fees` `o 25 r 3(1) some other order` EQUALS NOTHING -- "the Court may —" names three things
#ASSERT `o 25 r 3(2) the Court may exercise the powers in paragraph (1) in accordance with a Civil Procedure Convention` TRUE EQUALS JUST TRUE -- in accordance with the provisions in a Civil Procedure Convention
#ASSERT `o 25 r 3(2) the Court may exercise the powers in paragraph (1) in accordance with a Civil Procedure Convention` FALSE EQUALS NOTHING -- the grant is limited by its own wording
#ASSERT `o 25 r 3(3) one month`'s `period length` EQUALS 1 -- "one month"
#ASSERT `o 25 r 3(3) one month`'s `period unit` EQUALS Months -- months
#ASSERT `o 25 r 3(3) one month`'s `period direction` EQUALS `After the anchor` -- after the date
#ASSERT `o 25 r 3(3)(a) the date the month runs from` (JUST (Date 10 3 2026)) (Date 15 3 2026) EQUALS Date 15 3 2026 -- the last hearing date is later: "whichever is later"
#ASSERT `o 25 r 3(3)(a) the date the month runs from` (JUST (Date 20 3 2026)) (Date 15 3 2026) EQUALS Date 20 3 2026 -- the settlement date is later
#ASSERT `o 25 r 3(3)(a) the date the month runs from` (JUST (Date 15 3 2026)) (Date 15 3 2026) EQUALS Date 15 3 2026 -- the same day
#ASSERT `o 25 r 3(3)(a) the date the month runs from` NOTHING (Date 15 3 2026) EQUALS Date 15 3 2026 -- no settlement, discontinuance or withdrawal: the last hearing date
-- (a): arguments: in writing; the date the request was made; the last day (O 3 r 3)
#ASSERT `o 25 r 3(3)(a) the request for refund of hearing fees is made in writing within one month` TRUE (Date 10 4 2026) (Date 14 4 2026) EQUALS JUST TRUE -- (a) inside the time, in writing
#ASSERT `o 25 r 3(3)(a) the request for refund of hearing fees is made in writing within one month` TRUE (Date 14 4 2026) (Date 14 4 2026) EQUALS JUST TRUE -- (a) the last day
#ASSERT `o 25 r 3(3)(a) the request for refund of hearing fees is made in writing within one month` TRUE (Date 15 4 2026) (Date 14 4 2026) EQUALS JUST FALSE -- (a) one day late (ruling (a)): "within one month after the date of settlement, discontinuance or withdrawal or the last hearing date, whichever is later"
#ASSERT `o 25 r 3(3)(a) the request for refund of hearing fees is made in writing within one month` FALSE (Date 10 4 2026) (Date 14 4 2026) EQUALS NOTHING -- (a) in time but not in writing: "must be made in writing" is silent on what follows
#ASSERT `o 25 r 3(3)(a) the request for refund of hearing fees is made in writing within one month` FALSE (Date 15 4 2026) (Date 14 4 2026) EQUALS JUST FALSE -- (a) late and not in writing: the time is fixed in the text's own words
-- (b): arguments: in writing; the date the request was made; the last day (O 3 r 3)
#ASSERT `o 25 r 3(3)(b) the request for refund of fees for unused documents is made in writing within the time in Rule 4(2)` TRUE (Date 10 4 2026) (Date 14 4 2026) EQUALS JUST TRUE -- (b) inside the time, in writing
#ASSERT `o 25 r 3(3)(b) the request for refund of fees for unused documents is made in writing within the time in Rule 4(2)` TRUE (Date 14 4 2026) (Date 14 4 2026) EQUALS JUST TRUE -- (b) the last day
#ASSERT `o 25 r 3(3)(b) the request for refund of fees for unused documents is made in writing within the time in Rule 4(2)` TRUE (Date 15 4 2026) (Date 14 4 2026) EQUALS JUST FALSE -- (b) one day late (ruling (a)): "within the time in Rule 4(2)"
#ASSERT `o 25 r 3(3)(b) the request for refund of fees for unused documents is made in writing within the time in Rule 4(2)` FALSE (Date 10 4 2026) (Date 14 4 2026) EQUALS NOTHING -- (b) in time but not in writing: "must be made in writing" is silent on what follows
#ASSERT `o 25 r 3(3)(b) the request for refund of fees for unused documents is made in writing within the time in Rule 4(2)` FALSE (Date 15 4 2026) (Date 14 4 2026) EQUALS JUST FALSE -- (b) late and not in writing: the time is fixed in the text's own words
-- (c): arguments: in writing; the date the request was made; the last day (O 3 r 3)
#ASSERT `o 25 r 3(3)(c) the request for refund of fees for Court ADR services is made in writing within the time in Rule 8(4)` TRUE (Date 10 4 2026) (Date 14 4 2026) EQUALS JUST TRUE -- (c) inside the time, in writing
#ASSERT `o 25 r 3(3)(c) the request for refund of fees for Court ADR services is made in writing within the time in Rule 8(4)` TRUE (Date 14 4 2026) (Date 14 4 2026) EQUALS JUST TRUE -- (c) the last day
#ASSERT `o 25 r 3(3)(c) the request for refund of fees for Court ADR services is made in writing within the time in Rule 8(4)` TRUE (Date 15 4 2026) (Date 14 4 2026) EQUALS JUST FALSE -- (c) one day late (ruling (a)): "within the time in Rule 8(4)"
#ASSERT `o 25 r 3(3)(c) the request for refund of fees for Court ADR services is made in writing within the time in Rule 8(4)` FALSE (Date 10 4 2026) (Date 14 4 2026) EQUALS NOTHING -- (c) in time but not in writing: "must be made in writing" is silent on what follows
#ASSERT `o 25 r 3(3)(c) the request for refund of fees for Court ADR services is made in writing within the time in Rule 8(4)` FALSE (Date 15 4 2026) (Date 14 4 2026) EQUALS JUST FALSE -- (c) late and not in writing: the time is fixed in the text's own words
-- (d): arguments: in writing; the date the request was made; the last day (O 3 r 3)
#ASSERT `o 25 r 3(3)(d) the request for refund in any other case is made in writing within one month after the reason for the refund arose` TRUE (Date 10 4 2026) (Date 14 4 2026) EQUALS JUST TRUE -- (d) inside the time, in writing
#ASSERT `o 25 r 3(3)(d) the request for refund in any other case is made in writing within one month after the reason for the refund arose` TRUE (Date 14 4 2026) (Date 14 4 2026) EQUALS JUST TRUE -- (d) the last day
#ASSERT `o 25 r 3(3)(d) the request for refund in any other case is made in writing within one month after the reason for the refund arose` TRUE (Date 15 4 2026) (Date 14 4 2026) EQUALS JUST FALSE -- (d) one day late (ruling (a)): "within one month after the date on which the reason for the refund arose"
#ASSERT `o 25 r 3(3)(d) the request for refund in any other case is made in writing within one month after the reason for the refund arose` FALSE (Date 10 4 2026) (Date 14 4 2026) EQUALS NOTHING -- (d) in time but not in writing: "must be made in writing" is silent on what follows
#ASSERT `o 25 r 3(3)(d) the request for refund in any other case is made in writing within one month after the reason for the refund arose` FALSE (Date 15 4 2026) (Date 14 4 2026) EQUALS JUST FALSE -- (d) late and not in writing: the time is fixed in the text's own words
#ASSERT `o 25 r 3(4) fourteen days before the first date fixed for hearing`'s `period length` EQUALS 14 -- "not later than 14 days before"
#ASSERT `o 25 r 3(4) fourteen days before the first date fixed for hearing`'s `period direction` EQUALS `Before the anchor` -- before the first date fixed for hearing
-- arguments: notified in writing; the notice says settled, discontinued or transferred; the date notified; the last day (O 3 r 3)
#ASSERT `o 25 r 3(4) the Court must refund the whole of the hearing fees paid` TRUE TRUE (Date 1 5 2026) (Date 10 5 2026) EQUALS JUST TRUE -- notified in writing well before the last day
#ASSERT `o 25 r 3(4) the Court must refund the whole of the hearing fees paid` TRUE TRUE (Date 10 5 2026) (Date 10 5 2026) EQUALS JUST TRUE -- notified on the last day: "not later than 14 days before"
#ASSERT `o 25 r 3(4) the Court must refund the whole of the hearing fees paid` TRUE TRUE (Date 11 5 2026) (Date 10 5 2026) EQUALS JUST FALSE -- notified one day too late: "if ... not later than 14 days before"
#ASSERT `o 25 r 3(4) the Court must refund the whole of the hearing fees paid` FALSE TRUE (Date 1 5 2026) (Date 10 5 2026) EQUALS JUST FALSE -- "if the Court is notified in writing": it was not
#ASSERT `o 25 r 3(4) the Court must refund the whole of the hearing fees paid` TRUE FALSE (Date 1 5 2026) (Date 10 5 2026) EQUALS JUST FALSE -- "that the cause or matter has been settled or discontinued, or transferred": the notice says none of these
#ASSERT `o 25 r 3(5) fourteen days`'s `period length` EQUALS 14 -- "within 14 days after the decision"
-- arguments: dissatisfied with a decision under Rule 3; by letter to a Judge; the date applied; the last day (O 3 r 3)
#ASSERT `o 25 r 3(5) the party may apply by letter to a Judge to review the decision within 14 days` TRUE TRUE (Date 10 6 2026) (Date 14 6 2026) EQUALS JUST TRUE -- inside the 14 days
#ASSERT `o 25 r 3(5) the party may apply by letter to a Judge to review the decision within 14 days` TRUE TRUE (Date 14 6 2026) (Date 14 6 2026) EQUALS JUST TRUE -- the last day
#ASSERT `o 25 r 3(5) the party may apply by letter to a Judge to review the decision within 14 days` TRUE TRUE (Date 15 6 2026) (Date 14 6 2026) EQUALS JUST FALSE -- one day late (ruling (a))
#ASSERT `o 25 r 3(5) the party may apply by letter to a Judge to review the decision within 14 days` FALSE TRUE (Date 10 6 2026) (Date 14 6 2026) EQUALS NOTHING -- not dissatisfied with a decision under this Rule: the grant is limited by its own wording
#ASSERT `o 25 r 3(5) the party may apply by letter to a Judge to review the decision within 14 days` TRUE FALSE (Date 10 6 2026) (Date 14 6 2026) EQUALS NOTHING -- not by letter to a Judge
#ASSERT `o 25 r 3(5) the party may apply by letter to a Judge to review the decision within 14 days` FALSE FALSE (Date 15 6 2026) (Date 14 6 2026) EQUALS JUST FALSE -- late: the time is fixed in the text's own words
#ASSERT `o 25 r 3(6) the Court may make the order it deems fit` TRUE EQUALS JUST TRUE -- to secure compliance with a requirement to pay court fees
#ASSERT `o 25 r 3(6) the Court may make the order it deems fit` FALSE EQUALS NOTHING -- the grant is limited by its own wording

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 4`
-- ---------------------------------------------------------------------------

#ASSERT `o 25 r 4(1) the Registrar may refund the fee or part of the fee` TRUE EQUALS JUST TRUE -- paid for an unused document
#ASSERT `o 25 r 4(1) the Registrar may refund the fee or part of the fee` FALSE EQUALS NOTHING -- the grant is limited by its own wording
#ASSERT `o 25 r 4(2)(a) the application for refund is made by request signed by the applicant or the applicant's solicitor` TRUE FALSE EQUALS JUST TRUE -- signed by the applicant
#ASSERT `o 25 r 4(2)(a) the application for refund is made by request signed by the applicant or the applicant's solicitor` FALSE TRUE EQUALS JUST TRUE -- signed by the applicant's solicitor
#ASSERT `o 25 r 4(2)(a) the application for refund is made by request signed by the applicant or the applicant's solicitor` TRUE TRUE EQUALS JUST TRUE -- signed by both
#ASSERT `o 25 r 4(2)(a) the application for refund is made by request signed by the applicant or the applicant's solicitor` FALSE FALSE EQUALS NOTHING -- "must be made" by a signed request: silent on what follows
#ASSERT `o 25 r 4(2)(b) three months`'s `period length` EQUALS 3 -- "within 3 months"
#ASSERT `o 25 r 4(2)(b) three months`'s `period unit` EQUALS Months -- months
#ASSERT `o 25 r 4(2)(b) the application for refund is made within 3 months after the date of payment` (Date 10 8 2026) (Date 12 8 2026) EQUALS JUST TRUE -- inside the 3 months
#ASSERT `o 25 r 4(2)(b) the application for refund is made within 3 months after the date of payment` (Date 12 8 2026) (Date 12 8 2026) EQUALS JUST TRUE -- the last day
#ASSERT `o 25 r 4(2)(b) the application for refund is made within 3 months after the date of payment` (Date 13 8 2026) (Date 12 8 2026) EQUALS JUST FALSE -- one day late (ruling (a))
-- arguments: a refund is sought for more than one unused document; a separate application is made for each
#ASSERT `o 25 r 4(3) a separate application is made for the refund of the fee paid for each unused document` TRUE TRUE EQUALS JUST TRUE -- separate applications
#ASSERT `o 25 r 4(3) a separate application is made for the refund of the fee paid for each unused document` TRUE FALSE EQUALS NOTHING -- "a separate application must be made": silent on what follows
#ASSERT `o 25 r 4(3) a separate application is made for the refund of the fee paid for each unused document` FALSE TRUE EQUALS JUST FALSE -- "Where a refund of the fees paid for more than one unused document is being sought": it is not (ruling (b))
#ASSERT `o 25 r 4(3) a separate application is made for the refund of the fee paid for each unused document` FALSE FALSE EQUALS JUST FALSE -- the same
#ASSERT `o 25 r 4(4) the fee paid for the request is not refundable` TRUE EQUALS JUST TRUE -- "Where an application ... is not approved"
#ASSERT `o 25 r 4(4) the fee paid for the request is not refundable` FALSE EQUALS JUST FALSE -- the application was approved: ruling (b) (marginal reading)

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 5`
-- ---------------------------------------------------------------------------

#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(a) an action for damages for death or personal injuries` EQUALS JUST TRUE -- (a)
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(b)(i) a cause or matter under the Adoption of Children Act, or an appeal arising from it` EQUALS JUST TRUE -- (b)(i) the Adoption of Children Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(b)(ii) a cause or matter under the Guardianship of Infants Act, or an appeal arising from it` EQUALS JUST TRUE -- (b)(ii) the Guardianship of Infants Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(b)(iii) a cause or matter under the Inheritance (Family Provision) Act, or an appeal arising from it` EQUALS JUST TRUE -- (b)(iii) the Inheritance (Family Provision) Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(b)(iv) a cause or matter under the Maintenance of Parents Act, or an appeal arising from it` EQUALS JUST TRUE -- (b)(iv) the Maintenance of Parents Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(b)(v) a cause or matter under the Mental Capacity Act, or an appeal arising from it` EQUALS JUST TRUE -- (b)(v) the Mental Capacity Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(b)(vi) a cause or matter under the Mental Health (Care and Treatment) Act, or an appeal arising from it` EQUALS JUST TRUE -- (b)(vi) the Mental Health (Care and Treatment) Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(b)(vii) a cause or matter under the Women's Charter, or an appeal arising from it` EQUALS JUST TRUE -- (b)(vii) the Women's Charter
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(c) an application for an Order for Review of Detention, or an appeal relating to it` EQUALS JUST TRUE -- (c)
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(d)(i) an appeal or application by the regulatory body of a profession constituted under the Accountants Act in disciplinary proceedings` EQUALS JUST TRUE -- (d)(i) the Accountants Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(d)(ii) an appeal or application by the regulatory body of a profession constituted under the Architects Act in disciplinary proceedings` EQUALS JUST TRUE -- (d)(ii) the Architects Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(d)(iii) an appeal or application by the regulatory body of a profession constituted under the Dental Registration Act in disciplinary proceedings` EQUALS JUST TRUE -- (d)(iii) the Dental Registration Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(d)(iv) an appeal or application by the regulatory body of a profession constituted under the Land Surveyors Act in disciplinary proceedings` EQUALS JUST TRUE -- (d)(iv) the Land Surveyors Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(d)(v) an appeal or application by the regulatory body of a profession constituted under the Legal Profession Act in disciplinary proceedings` EQUALS JUST TRUE -- (d)(v) the Legal Profession Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(d)(vi) an appeal or application by the regulatory body of a profession constituted under the Medical Registration Act in disciplinary proceedings` EQUALS JUST TRUE -- (d)(vi) the Medical Registration Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(d)(vii) an appeal or application by the regulatory body of a profession constituted under the Nurses and Midwives Act in disciplinary proceedings` EQUALS JUST TRUE -- (d)(vii) the Nurses and Midwives Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(d)(viii) an appeal or application by the regulatory body of a profession constituted under the Pharmacists Registration Act in disciplinary proceedings` EQUALS JUST TRUE -- (d)(viii) the Pharmacists Registration Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5(d)(ix) an appeal or application by the regulatory body of a profession constituted under the Professional Engineers Act in disciplinary proceedings` EQUALS JUST TRUE -- (d)(ix) the Professional Engineers Act
#ASSERT `o 25 r 5 no hearing fee is payable` `o 25 r 5 some other proceeding` EQUALS NOTHING -- the Rule lists the hearings with no fee and does not say a fee is payable for any other

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 6`
-- ---------------------------------------------------------------------------

-- arguments: the entity wound up; fixed for hearing in open court on special hearing dates; the hearing is of an appeal relating to such proceedings
#ASSERT `o 25 r 6 hearing fees are payable` `o 25 r 6 a company` TRUE FALSE EQUALS JUST TRUE -- a company: on special hearing dates
#ASSERT `o 25 r 6 hearing fees are payable` `o 25 r 6 a company` FALSE TRUE EQUALS JUST TRUE -- a company: an appeal relating to such proceedings
#ASSERT `o 25 r 6 hearing fees are payable` `o 25 r 6 a company` FALSE FALSE EQUALS JUST FALSE -- a company: neither: "where such proceedings are fixed for hearing in open court on special hearing dates, and to appeals" (ruling (b))
#ASSERT `o 25 r 6 hearing fees are payable` `o 25 r 6 a limited liability partnership` TRUE FALSE EQUALS JUST TRUE -- a limited liability partnership: on special hearing dates
#ASSERT `o 25 r 6 hearing fees are payable` `o 25 r 6 a limited liability partnership` FALSE TRUE EQUALS JUST TRUE -- a limited liability partnership: an appeal relating to such proceedings
#ASSERT `o 25 r 6 hearing fees are payable` `o 25 r 6 a limited liability partnership` FALSE FALSE EQUALS JUST FALSE -- a limited liability partnership: neither: "where such proceedings are fixed for hearing in open court on special hearing dates, and to appeals" (ruling (b))
#ASSERT `o 25 r 6 hearing fees are payable` `o 25 r 6 a variable capital company or one of its sub-funds` TRUE FALSE EQUALS JUST TRUE -- a variable capital company or a sub-fund: on special hearing dates
#ASSERT `o 25 r 6 hearing fees are payable` `o 25 r 6 a variable capital company or one of its sub-funds` FALSE TRUE EQUALS JUST TRUE -- a variable capital company or a sub-fund: an appeal relating to such proceedings
#ASSERT `o 25 r 6 hearing fees are payable` `o 25 r 6 a variable capital company or one of its sub-funds` FALSE FALSE EQUALS JUST FALSE -- a variable capital company or a sub-fund: neither: "where such proceedings are fixed for hearing in open court on special hearing dates, and to appeals" (ruling (b))
#ASSERT `o 25 r 6 hearing fees are payable` `o 25 r 6 a company` TRUE TRUE EQUALS JUST TRUE -- both
#ASSERT `o 25 r 6 hearing fees are payable` `o 25 r 6 some other entity` TRUE FALSE EQUALS NOTHING -- scope limit with no "only" (ruling (c))

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 7`
-- ---------------------------------------------------------------------------

#ASSERT `o 25 r 7(1) the Registrar may issue a certificate of exemption` TRUE TRUE EQUALS JUST TRUE -- satisfied, on the application of that party
#ASSERT `o 25 r 7(1) the Registrar may issue a certificate of exemption` TRUE FALSE EQUALS JUST FALSE -- satisfied but not on that party's application: "on the application of that party" read as "upon" (ruling (b); assumed)
#ASSERT `o 25 r 7(1) the Registrar may issue a certificate of exemption` FALSE TRUE EQUALS JUST FALSE -- "Where the Registrar is satisfied": not satisfied (ruling (b))
#ASSERT `o 25 r 7(1) the Registrar may issue a certificate of exemption` FALSE FALSE EQUALS JUST FALSE -- not satisfied
#ASSERT `o 25 r 7(2) the application for a certificate is made as required` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- by letter to the Registrar, stating the grounds, with all necessary supporting documents
#ASSERT `o 25 r 7(2) the application for a certificate is made as required` FALSE TRUE TRUE TRUE EQUALS NOTHING -- not by letter
#ASSERT `o 25 r 7(2) the application for a certificate is made as required` TRUE FALSE TRUE TRUE EQUALS NOTHING -- not addressed to the Registrar
#ASSERT `o 25 r 7(2) the application for a certificate is made as required` TRUE TRUE FALSE TRUE EQUALS NOTHING -- the grounds are not stated
#ASSERT `o 25 r 7(2) the application for a certificate is made as required` TRUE TRUE TRUE FALSE EQUALS NOTHING -- no supporting documents
-- (a) no fee: arguments: the date asked about; the date the certificate was issued, if any
#ASSERT `o 25 r 7(3)(a) no fee is payable by any party in the cause or matter` (Date 10 9 2026) (JUST (Date 10 9 2026)) EQUALS JUST TRUE -- (a) no fee: the day of issue, "from the time that a certificate is issued"
#ASSERT `o 25 r 7(3)(a) no fee is payable by any party in the cause or matter` (Date 11 9 2026) (JUST (Date 10 9 2026)) EQUALS JUST TRUE -- (a) no fee: after issue
#ASSERT `o 25 r 7(3)(a) no fee is payable by any party in the cause or matter` (Date 9 9 2026) (JUST (Date 10 9 2026)) EQUALS JUST FALSE -- (a) no fee: before issue (ruling (a))
#ASSERT `o 25 r 7(3)(a) no fee is payable by any party in the cause or matter` (Date 11 9 2026) NOTHING EQUALS JUST FALSE -- (a) no fee: no certificate was issued
-- (b) no security for costs: arguments: the date asked about; the date the certificate was issued, if any
#ASSERT `o 25 r 7(3)(b) no security for costs is required to be provided by any party in the cause or matter` (Date 10 9 2026) (JUST (Date 10 9 2026)) EQUALS JUST TRUE -- (b) no security for costs: the day of issue, "from the time that a certificate is issued"
#ASSERT `o 25 r 7(3)(b) no security for costs is required to be provided by any party in the cause or matter` (Date 11 9 2026) (JUST (Date 10 9 2026)) EQUALS JUST TRUE -- (b) no security for costs: after issue
#ASSERT `o 25 r 7(3)(b) no security for costs is required to be provided by any party in the cause or matter` (Date 9 9 2026) (JUST (Date 10 9 2026)) EQUALS JUST FALSE -- (b) no security for costs: before issue (ruling (a))
#ASSERT `o 25 r 7(3)(b) no security for costs is required to be provided by any party in the cause or matter` (Date 11 9 2026) NOTHING EQUALS JUST FALSE -- (b) no security for costs: no certificate was issued
#ASSERT `o 25 r 7(4) the Registrar may refund the fee or part of the fee` TRUE TRUE EQUALS JUST TRUE -- a certificate was issued and the fee was paid before it
#ASSERT `o 25 r 7(4) the Registrar may refund the fee or part of the fee` TRUE FALSE EQUALS JUST FALSE -- the fee was paid after the certificate: "where such fee was paid before the certificate was issued" (ruling (b))
#ASSERT `o 25 r 7(4) the Registrar may refund the fee or part of the fee` FALSE TRUE EQUALS NOTHING -- no certificate was issued
#ASSERT `o 25 r 7(4) the Registrar may refund the fee or part of the fee` FALSE FALSE EQUALS NOTHING -- neither
#ASSERT `o 25 r 7(5) this Rule prevents the Court from making the order for costs` TRUE EQUALS JUST FALSE -- "Nothing in this Rule prevents an order for costs"
#ASSERT `o 25 r 7(5) this Rule prevents the Court from making the order for costs` FALSE EQUALS NOTHING -- the saving covers an order for costs in the cause or matter

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 8`
-- ---------------------------------------------------------------------------

#ASSERT `o 25 r 8(1) the Court ADR fee payable by each party for all Court ADR services in the case` EQUALS 250 -- "a fee of $250"
-- arguments: the court level; a party in the case; Court ADR services are provided; whether paragraph (3) says no fee is payable (the answer of `o 25 r 8(3) no Court ADR fee is payable in the action`)
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `District Court` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE -- a party in a District Court case, services provided, paragraph (3) does not take the action out
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `District Court` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE -- paragraph (3): "No Court ADR fee is payable in any of the following actions"
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `District Court` TRUE TRUE NOTHING EQUALS NOTHING -- whether paragraph (3) applies is not known
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `District Court` FALSE TRUE (JUST FALSE) EQUALS NOTHING -- not a party: "payable by each party"
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `District Court` TRUE FALSE (JUST FALSE) EQUALS NOTHING -- no Court ADR services are provided
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `General Division` TRUE TRUE (JUST FALSE) EQUALS NOTHING -- "in a case in a District Court": a scope limit with no "only" (ruling (c)): General Division
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `Appellate Division` TRUE TRUE (JUST FALSE) EQUALS NOTHING -- "in a case in a District Court": a scope limit with no "only" (ruling (c)): Appellate Division
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `Court of Appeal` TRUE TRUE (JUST FALSE) EQUALS NOTHING -- "in a case in a District Court": a scope limit with no "only" (ruling (c)): Court of Appeal
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `Magistrate's Court` TRUE TRUE (JUST FALSE) EQUALS NOTHING -- "in a case in a District Court": a scope limit with no "only" (ruling (c)): Magistrate's Court
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `Singapore International Commercial Court` TRUE TRUE (JUST FALSE) EQUALS NOTHING -- "in a case in a District Court": a scope limit with no "only" (ruling (c)): Singapore International Commercial Court
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `Family Division` TRUE TRUE (JUST FALSE) EQUALS NOTHING -- "in a case in a District Court": a scope limit with no "only" (ruling (c)): Family Division
-- The two paragraphs together, as the Rule is read (fork F-O25-2, reading (1)): paragraph (1) answered from the kind of action, through paragraph (3)
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `District Court` TRUE TRUE (`o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3) some other action` NOTHING) EQUALS JUST TRUE -- an ordinary action (a contract claim) in a District Court: the fee of $250 is payable under paragraph (1)
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `District Court` TRUE TRUE (`o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3)(b) an action for damages for death or personal injuries` NOTHING) EQUALS JUST FALSE -- a death or personal injuries action: paragraph (3)(b)
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `District Court` TRUE TRUE (`o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3)(a) a non-injury motor accident action as defined in Order 21, Part 6 of Appendix 1` (JUST TRUE)) EQUALS JUST FALSE -- a non-injury motor accident action (Order 21 says so): paragraph (3)(a)
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `District Court` TRUE TRUE (`o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3)(a) a non-injury motor accident action as defined in Order 21, Part 6 of Appendix 1` (JUST FALSE)) EQUALS JUST TRUE -- an action that Order 21 says is not a non-injury motor accident action: the fee is payable
#ASSERT `o 25 r 8(1) the Court ADR fee is payable by the party` `District Court` TRUE TRUE (`o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3)(a) a non-injury motor accident action as defined in Order 21, Part 6 of Appendix 1` NOTHING) EQUALS NOTHING -- whether it is a non-injury motor accident action is for Order 21, which is in another part's range
#ASSERT `o 25 r 8(1) the total Court ADR fee payable by the parties in a District Court case` 3 EQUALS 750 -- "payable by each party": three parties, $250 each
#ASSERT `o 25 r 8(1) the total Court ADR fee payable by the parties in a District Court case` 1 EQUALS 250 -- one party
#ASSERT `o 25 r 8(1) the total Court ADR fee payable by the parties in a District Court case` 0 EQUALS 0 -- no party, no fee
-- arguments: how the first service came to be provided; the date it is fixed; the date asked about
#ASSERT `o 25 r 8(2) the Court ADR fee is payable at the date asked about` `o 25 r 8(2)(a) a request made for the Court ADR service by a party in the case` (Date 10 10 2026) (Date 10 10 2026) EQUALS JUST TRUE -- (a) a request: the day it is fixed
#ASSERT `o 25 r 8(2) the Court ADR fee is payable at the date asked about` `o 25 r 8(2)(a) a request made for the Court ADR service by a party in the case` (Date 10 10 2026) (Date 12 10 2026) EQUALS JUST TRUE -- (a) a request: after it is fixed
#ASSERT `o 25 r 8(2) the Court ADR fee is payable at the date asked about` `o 25 r 8(2)(a) a request made for the Court ADR service by a party in the case` (Date 10 10 2026) (Date 9 10 2026) EQUALS JUST FALSE -- (a) a request: before it is fixed (ruling (a))
#ASSERT `o 25 r 8(2) the Court ADR fee is payable at the date asked about` `o 25 r 8(2)(b) a referral by the Court or the Registrar` (Date 10 10 2026) (Date 10 10 2026) EQUALS JUST TRUE -- (b) a referral: the day it is fixed
#ASSERT `o 25 r 8(2) the Court ADR fee is payable at the date asked about` `o 25 r 8(2)(b) a referral by the Court or the Registrar` (Date 10 10 2026) (Date 12 10 2026) EQUALS JUST TRUE -- (b) a referral: after it is fixed
#ASSERT `o 25 r 8(2) the Court ADR fee is payable at the date asked about` `o 25 r 8(2)(b) a referral by the Court or the Registrar` (Date 10 10 2026) (Date 9 10 2026) EQUALS JUST FALSE -- (b) a referral: before it is fixed (ruling (a))
#ASSERT `o 25 r 8(2) the Court ADR fee is payable at the date asked about` `o 25 r 8(2) in some other way` (Date 10 10 2026) (Date 12 10 2026) EQUALS NOTHING -- "pursuant to either of the following"
-- arguments: the kind of action; the answer of Order 21, Part 6 of Appendix 1 on non-injury motor accident actions
#ASSERT `o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3)(a) a non-injury motor accident action as defined in Order 21, Part 6 of Appendix 1` (JUST TRUE) EQUALS JUST TRUE -- (a): Order 21 says it is a non-injury motor accident action
#ASSERT `o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3)(a) a non-injury motor accident action as defined in Order 21, Part 6 of Appendix 1` (JUST FALSE) EQUALS JUST FALSE -- (a): Order 21 says it is not
#ASSERT `o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3)(a) a non-injury motor accident action as defined in Order 21, Part 6 of Appendix 1` NOTHING EQUALS NOTHING -- (a): Order 21 is in another part's range
#ASSERT `o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3)(b) an action for damages for death or personal injuries` NOTHING EQUALS JUST TRUE -- (b)
#ASSERT `o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3)(c) an action under the Protection from Harassment Act` NOTHING EQUALS JUST TRUE -- (c)
#ASSERT `o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3)(d) an action under the Community Disputes Resolution Act 2015` NOTHING EQUALS JUST TRUE -- (d)
#ASSERT `o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3) some other action` (JUST TRUE) EQUALS JUST FALSE -- fork F-O25-2, reading (1): the four actions are the exceptions to paragraph (1), so an action that is none of them is not one in which no fee is payable (whatever Order 21 says)
#ASSERT `o 25 r 8(3) no Court ADR fee is payable in the action` `o 25 r 8(3) some other action` NOTHING EQUALS JUST FALSE -- the same, with Order 21 not consulted
#ASSERT `o 25 r 8(4) one month`'s `period length` EQUALS 1 -- "within one month"
#ASSERT `o 25 r 8(4) the earlier of the two dates` (JUST (Date 1 11 2026)) (JUST (Date 5 11 2026)) EQUALS JUST (Date 1 11 2026) -- the withdrawal of consent is earlier
#ASSERT `o 25 r 8(4) the earlier of the two dates` (JUST (Date 9 11 2026)) (JUST (Date 5 11 2026)) EQUALS JUST (Date 5 11 2026) -- the settlement is earlier
#ASSERT `o 25 r 8(4) the earlier of the two dates` (JUST (Date 5 11 2026)) (JUST (Date 5 11 2026)) EQUALS JUST (Date 5 11 2026) -- the same day
#ASSERT `o 25 r 8(4) the earlier of the two dates` (JUST (Date 1 11 2026)) NOTHING EQUALS JUST (Date 1 11 2026) -- no settlement
#ASSERT `o 25 r 8(4) the earlier of the two dates` NOTHING (JUST (Date 5 11 2026)) EQUALS JUST (Date 5 11 2026) -- no withdrawal of consent
#ASSERT `o 25 r 8(4) the earlier of the two dates` NOTHING NOTHING EQUALS NOTHING -- neither date exists
#ASSERT `o 25 r 8(4) the request for refund of the Court ADR fee is made in writing to the Registrar within one month` TRUE (Date 10 12 2026) (Date 14 12 2026) EQUALS JUST TRUE -- inside the month, in writing
#ASSERT `o 25 r 8(4) the request for refund of the Court ADR fee is made in writing to the Registrar within one month` TRUE (Date 14 12 2026) (Date 14 12 2026) EQUALS JUST TRUE -- the last day
#ASSERT `o 25 r 8(4) the request for refund of the Court ADR fee is made in writing to the Registrar within one month` TRUE (Date 15 12 2026) (Date 14 12 2026) EQUALS JUST FALSE -- one day late (ruling (a))
#ASSERT `o 25 r 8(4) the request for refund of the Court ADR fee is made in writing to the Registrar within one month` FALSE (Date 10 12 2026) (Date 14 12 2026) EQUALS NOTHING -- in time but not in writing to the Registrar: silent
#ASSERT `o 25 r 8(5) "Court ADR fee" is the fee payable under paragraph (1) for Court ADR services` TRUE EQUALS JUST TRUE -- means the fee payable under paragraph (1)
#ASSERT `o 25 r 8(5) "Court ADR fee" is the fee payable under paragraph (1) for Court ADR services` FALSE EQUALS JUST FALSE -- "means"

-- ---------------------------------------------------------------------------
§ `Tests -- the duties as regulative rules (traces, not assertions)`
-- ---------------------------------------------------------------------------

-- A #TRACE prints its result and counts as no assertion on this binary; the decision functions that say the same thing are asserted above.
-- The result each should print is written beside it, from the text.
-- expected: FULFILLED -- the party pays the $250 fee on day 1 (O 25 r 8(1))
#TRACE `o 25 r 8(1) each party in a District Court case must pay the Court ADR fee` AT 0 WITH
    PARTY `o 25 the party to the case` DOES `o 25 r 8(1) pay the Court ADR fee of $250` AT 1
-- expected: the duty is still outstanding after 5 days, with no BREACH: the Rule fixes no day by which the fee must be paid, so the trace prints the rule itself
#TRACE `o 25 r 8(1) each party in a District Court case must pay the Court ADR fee` AT 0 WITH
    (WAITUNTIL 5)
-- expected: FULFILLED -- the dissatisfied party applies by letter on day 14, the last day (O 25 r 3(5))
#TRACE `o 25 r 3(5) a dissatisfied party may apply by letter to a Judge within 14 days after the decision` AT 0 WITH
    PARTY `o 25 the dissatisfied party` DOES `o 25 r 3(5) apply by letter to a Judge to review the Registrar's decision` AT 14
