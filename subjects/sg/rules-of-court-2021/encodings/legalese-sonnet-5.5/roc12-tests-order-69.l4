IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc12-order-69`

-- Rules of Court 2021 (Singapore) -- tests for Order 69 (roc12-order-69.l4).
-- Every expected value is written from the text of the Rule (lines 7676 to 7718 of the source file) before the run.
-- The last day of the 14 days is an input from Order 3, Rule 3 (here 24 March 2025).

§ `O 69 r 1`
#ASSERT `o 69 r 1 the enactment is the Act` TRUE EQUALS JUST TRUE -- ""Act" means the Supreme Court of Judicature Act 1969"
#ASSERT `o 69 r 1 the enactment is the Act` FALSE EQUALS JUST FALSE -- "means"
-- Arguments: limited; extended; general.
#ASSERT `o 69 r 1 the order is a civil restraint order` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE -- (a)
#ASSERT `o 69 r 1 the order is a civil restraint order` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE -- (b)
#ASSERT `o 69 r 1 the order is a civil restraint order` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE -- (c)
#ASSERT `o 69 r 1 the order is a civil restraint order` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE -- "means" (a), (b) or (c): none holds
#ASSERT `o 69 r 1 the order is a civil restraint order` (JUST FALSE) NOTHING (JUST FALSE) EQUALS NOTHING -- one kind is not answered
#ASSERT `o 69 r 1 the order is a civil restraint order` NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE -- one kind holds
-- "Court".
#ASSERT `o 69 r 1 a court is the Court` `General Division` EQUALS JUST TRUE -- named
#ASSERT `o 69 r 1 a court is the Court` `Appellate Division` EQUALS JUST TRUE -- named
#ASSERT `o 69 r 1 a court is the Court` `Court of Appeal` EQUALS JUST TRUE -- named
#ASSERT `o 69 r 1 a court is the Court` `District Court` EQUALS JUST FALSE -- "means" the three
#ASSERT `o 69 r 1 a court is the Court` `Magistrate's Court` EQUALS JUST FALSE -- "means" the three
#ASSERT `o 69 r 1 a court is the Court` `Singapore International Commercial Court` EQUALS JUST FALSE -- "means" the three
#ASSERT `o 69 r 1 a court is the Court` `Family Division` EQUALS JUST FALSE -- "means" the three
-- The three orders.  Arguments: described as that kind; made in accordance with the section.
#ASSERT `o 69 r 1 the order is an extended civil restraint order` TRUE (JUST TRUE) EQUALS JUST TRUE -- described and made in accordance with section 73C
#ASSERT `o 69 r 1 the order is an extended civil restraint order` TRUE (JUST FALSE) EQUALS JUST FALSE -- not made in accordance with section 73C
#ASSERT `o 69 r 1 the order is an extended civil restraint order` TRUE NOTHING EQUALS NOTHING -- the Act is not among the sources
#ASSERT `o 69 r 1 the order is an extended civil restraint order` FALSE (JUST TRUE) EQUALS JUST FALSE -- "means" an extended civil restraint order
#ASSERT `o 69 r 1 the order is a general civil restraint order` TRUE (JUST TRUE) EQUALS JUST TRUE -- section 73D
#ASSERT `o 69 r 1 the order is a general civil restraint order` TRUE NOTHING EQUALS NOTHING -- the Act is not among the sources
#ASSERT `o 69 r 1 the order is a general civil restraint order` FALSE (JUST TRUE) EQUALS JUST FALSE -- "means" a general civil restraint order
#ASSERT `o 69 r 1 the order is a limited civil restraint order` TRUE (JUST TRUE) EQUALS JUST TRUE -- section 73B
#ASSERT `o 69 r 1 the order is a limited civil restraint order` TRUE (JUST FALSE) EQUALS JUST FALSE -- not made in accordance with section 73B
#ASSERT `o 69 r 1 the order is a limited civil restraint order` FALSE (JUST TRUE) EQUALS JUST FALSE -- "means" a limited civil restraint order

§ `O 69 r 2`
#ASSERT `o 69 r 2 the application is heard in open court as the Rule requires` TRUE TRUE EQUALS JUST TRUE -- heard in open court
#ASSERT `o 69 r 2 the application is heard in open court as the Rule requires` TRUE FALSE EQUALS NOTHING -- QB: not heard in open court
#ASSERT `o 69 r 2 the application is heard in open court as the Rule requires` FALSE TRUE EQUALS NOTHING -- an application outside the Rule

§ `O 69 r 3`
#ASSERT `o 69 r 3(1) the form of the civil restraint order` `o 69 r 1(a) a limited civil restraint order` EQUALS "99" -- "Forms 99, 100 and 101, respectively"
#ASSERT `o 69 r 3(1) the form of the civil restraint order` `o 69 r 1(b) an extended civil restraint order` EQUALS "100" -- respectively
#ASSERT `o 69 r 3(1) the form of the civil restraint order` `o 69 r 1(c) a general civil restraint order` EQUALS "101" -- respectively
#ASSERT `o 69 r 3(1) the civil restraint order is in the form the Rule requires` `o 69 r 1(a) a limited civil restraint order` "99" EQUALS JUST TRUE -- Form 99
#ASSERT `o 69 r 3(1) the civil restraint order is in the form the Rule requires` `o 69 r 1(a) a limited civil restraint order` "100" EQUALS NOTHING -- QB: a limited order in Form 100
#ASSERT `o 69 r 3(1) the civil restraint order is in the form the Rule requires` `o 69 r 1(b) an extended civil restraint order` "100" EQUALS JUST TRUE -- Form 100
#ASSERT `o 69 r 3(1) the civil restraint order is in the form the Rule requires` `o 69 r 1(c) a general civil restraint order` "101" EQUALS JUST TRUE -- Form 101
#ASSERT `o 69 r 3(1) the civil restraint order is in the form the Rule requires` `o 69 r 1(c) a general civil restraint order` "99" EQUALS NOTHING -- QB: a general order in Form 99
-- r 3(2).  Arguments: a civil restraint order; extracted by the applicant; served on all other parties.
#ASSERT `o 69 r 3(2) the order is extracted and served as the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE -- extracted and served
#ASSERT `o 69 r 3(2) the order is extracted and served as the Rule requires` TRUE FALSE TRUE EQUALS NOTHING -- QB: not extracted
#ASSERT `o 69 r 3(2) the order is extracted and served as the Rule requires` TRUE TRUE FALSE EQUALS NOTHING -- QB: not served
#ASSERT `o 69 r 3(2) the order is extracted and served as the Rule requires` FALSE TRUE TRUE EQUALS NOTHING -- not a civil restraint order

§ `O 69 r 4`
-- r 4(1).  Arguments: an order in force against the party; the kind; the application is for permission to commence an action.
#ASSERT `o 69 r 4(1) the duty to serve the application and affidavit arises` TRUE `o 69 r 1(b) an extended civil restraint order` TRUE EQUALS JUST TRUE -- an extended order in force
#ASSERT `o 69 r 4(1) the duty to serve the application and affidavit arises` TRUE `o 69 r 1(c) a general civil restraint order` TRUE EQUALS JUST TRUE -- a general order in force
#ASSERT `o 69 r 4(1) the duty to serve the application and affidavit arises` TRUE `o 69 r 1(a) a limited civil restraint order` TRUE EQUALS JUST FALSE -- a limited order: the "Where" names only extended and general orders
#ASSERT `o 69 r 4(1) the duty to serve the application and affidavit arises` FALSE `o 69 r 1(b) an extended civil restraint order` TRUE EQUALS JUST FALSE -- no order in force
#ASSERT `o 69 r 4(1) the duty to serve the application and affidavit arises` TRUE `o 69 r 1(b) an extended civil restraint order` FALSE EQUALS JUST FALSE -- not an application for permission to commence an action
-- Arguments: the answer above; made on the Attorney-General's application; served on every intended defendant; served on the Attorney-General.
#ASSERT `o 69 r 4(1) the application and affidavit are served as the Rule requires` (JUST TRUE) FALSE TRUE FALSE EQUALS JUST TRUE -- served on every intended defendant, and the order was not on the Attorney-General's application
#ASSERT `o 69 r 4(1) the application and affidavit are served as the Rule requires` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE -- (a) and (b)
#ASSERT `o 69 r 4(1) the application and affidavit are served as the Rule requires` (JUST TRUE) TRUE TRUE FALSE EQUALS NOTHING -- QB: the Attorney-General was not served
#ASSERT `o 69 r 4(1) the application and affidavit are served as the Rule requires` (JUST TRUE) FALSE FALSE TRUE EQUALS NOTHING -- QB: a defendant was not served
#ASSERT `o 69 r 4(1) the application and affidavit are served as the Rule requires` (JUST FALSE) FALSE TRUE FALSE EQUALS NOTHING -- QD: the duty does not arise
-- r 4(2).
#ASSERT `o 69 r 4(2) the duty to serve the application and affidavit arises` TRUE TRUE EQUALS JUST TRUE -- any order in force, an application for permission to make an application
#ASSERT `o 69 r 4(2) the duty to serve the application and affidavit arises` FALSE TRUE EQUALS JUST FALSE -- no order in force
#ASSERT `o 69 r 4(2) the duty to serve the application and affidavit arises` TRUE FALSE EQUALS JUST FALSE -- another kind of application
#ASSERT `o 69 r 4(2) the application and affidavit are served as the Rule requires` (JUST TRUE) FALSE TRUE FALSE EQUALS JUST TRUE -- served on every intended respondent
#ASSERT `o 69 r 4(2) the application and affidavit are served as the Rule requires` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE -- and on the Attorney-General
#ASSERT `o 69 r 4(2) the application and affidavit are served as the Rule requires` (JUST TRUE) TRUE TRUE FALSE EQUALS NOTHING -- QB: the Attorney-General was not served
#ASSERT `o 69 r 4(2) the application and affidavit are served as the Rule requires` (JUST FALSE) FALSE TRUE FALSE EQUALS NOTHING -- QD: the duty does not arise
-- r 4(3).  Arguments for "must be served": the application; a party to the earlier application; the applicant.
#ASSERT `o 69 r 4(3) the person must be served` TRUE TRUE FALSE EQUALS JUST TRUE -- a party other than the applicant
#ASSERT `o 69 r 4(3) the person must be served` TRUE TRUE TRUE EQUALS NOTHING -- QE: "except the person that applies" is taken out of what the duty covers
#ASSERT `o 69 r 4(3) the person must be served` TRUE FALSE FALSE EQUALS NOTHING -- not a party to that application
#ASSERT `o 69 r 4(3) the person must be served` FALSE TRUE FALSE EQUALS NOTHING -- not an application to amend, vary or discharge
#ASSERT `o 69 r 4(3) the application and affidavit are served as the Rule requires` TRUE TRUE EQUALS JUST TRUE -- served on every such party
#ASSERT `o 69 r 4(3) the application and affidavit are served as the Rule requires` TRUE FALSE EQUALS NOTHING -- QB: not served on every such party
#ASSERT `o 69 r 4(3) the application and affidavit are served as the Rule requires` FALSE TRUE EQUALS NOTHING -- not that kind of application
-- r 4(4).  Arguments: served with such an application; the date to file and serve; the last day.
#ASSERT `o 69 r 4(4) the person may file and serve the affidavit in reply` TRUE (Date 24 3 2025) (Date 24 3 2025) EQUALS JUST TRUE -- on the last day
#ASSERT `o 69 r 4(4) the person may file and serve the affidavit in reply` TRUE (Date 25 3 2025) (Date 24 3 2025) EQUALS JUST FALSE -- after the last day: "within 14 days"
#ASSERT `o 69 r 4(4) the person may file and serve the affidavit in reply` FALSE (Date 20 3 2025) (Date 24 3 2025) EQUALS NOTHING -- a person not served
#ASSERT `o 69 r 4(4) the period for the affidavit in reply`'s `period length` EQUALS 14 -- "within 14 days after the date on which the application is served"
#ASSERT `o 69 r 4(4) the period for the affidavit in reply`'s `period unit` EQUALS Days -- days
#ASSERT `o 69 r 4(4) the period for the affidavit in reply`'s `period direction` EQUALS `After the anchor` -- after
-- r 4(5).
#ASSERT `o 69 r 4(5) the Court may give other directions for service and affidavits` TRUE EQUALS JUST TRUE -- an application mentioned in (1), (2) or (3)
#ASSERT `o 69 r 4(5) the Court may give other directions for service and affidavits` FALSE EQUALS NOTHING -- other applications are outside

§ `O 69 r 5`
-- r 5(1).  Arguments: ECRO or GCRO in force; commences an action; without permission.
#ASSERT `o 69 r 5(1) this paragraph applies` TRUE TRUE TRUE EQUALS JUST TRUE -- all three
#ASSERT `o 69 r 5(1) this paragraph applies` TRUE TRUE FALSE EQUALS JUST FALSE -- with permission: the "Where" is not met
#ASSERT `o 69 r 5(1) this paragraph applies` TRUE FALSE TRUE EQUALS JUST FALSE -- no action commenced
#ASSERT `o 69 r 5(1) this paragraph applies` FALSE TRUE TRUE EQUALS JUST FALSE -- no such order in force
#ASSERT `o 69 r 5(1)(a) the person may inform the Registrar in writing` (JUST TRUE) TRUE EQUALS JUST TRUE -- any other party
#ASSERT `o 69 r 5(1)(a) the person may inform the Registrar in writing` (JUST TRUE) FALSE EQUALS NOTHING -- a stranger: not within "any other party to the action, or to the application"
#ASSERT `o 69 r 5(1)(a) the person may inform the Registrar in writing` (JUST FALSE) TRUE EQUALS JUST FALSE -- the paragraph does not apply
#ASSERT `o 69 r 5(1)(a) the person may inform the Registrar in writing` NOTHING TRUE EQUALS NOTHING -- whether it applies is not answered
#ASSERT `o 69 r 5(1)(b) the Registrar may record that the action is treated as struck out` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE -- on being informed
#ASSERT `o 69 r 5(1)(b) the Registrar may record that the action is treated as struck out` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE -- on the Registrar's own motion
#ASSERT `o 69 r 5(1)(b) the Registrar may record that the action is treated as struck out` (JUST TRUE) FALSE FALSE EQUALS NOTHING -- neither trigger
#ASSERT `o 69 r 5(1)(b) the Registrar may record that the action is treated as struck out` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE -- the paragraph does not apply
-- r 5(2).
#ASSERT `o 69 r 5(2) this paragraph applies` TRUE TRUE TRUE EQUALS JUST TRUE -- all three
#ASSERT `o 69 r 5(2) this paragraph applies` TRUE TRUE FALSE EQUALS JUST FALSE -- with permission
#ASSERT `o 69 r 5(2) this paragraph applies` FALSE TRUE TRUE EQUALS JUST FALSE -- no order in force
#ASSERT `o 69 r 5(2)(a) the person may inform the Registrar in writing` (JUST TRUE) TRUE EQUALS JUST TRUE -- any other party
#ASSERT `o 69 r 5(2)(a) the person may inform the Registrar in writing` (JUST TRUE) FALSE EQUALS NOTHING -- a stranger
#ASSERT `o 69 r 5(2)(a) the person may inform the Registrar in writing` (JUST FALSE) TRUE EQUALS JUST FALSE -- the paragraph does not apply
#ASSERT `o 69 r 5(2)(b) the Registrar may record that the application is treated as dismissed` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE -- on being informed
#ASSERT `o 69 r 5(2)(b) the Registrar may record that the application is treated as dismissed` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE -- on the Registrar's own motion
#ASSERT `o 69 r 5(2)(b) the Registrar may record that the application is treated as dismissed` (JUST TRUE) FALSE FALSE EQUALS NOTHING -- neither trigger
#ASSERT `o 69 r 5(2)(b) the Registrar may record that the application is treated as dismissed` NOTHING TRUE TRUE EQUALS NOTHING -- whether the paragraph applies is not answered
-- r 5(3).
#ASSERT `o 69 r 5(3) this paragraph applies` TRUE TRUE EQUALS JUST TRUE -- an order in force and a document filed
#ASSERT `o 69 r 5(3) this paragraph applies` TRUE FALSE EQUALS JUST FALSE -- no document filed
#ASSERT `o 69 r 5(3) this paragraph applies` FALSE TRUE EQUALS JUST FALSE -- no order in force
#ASSERT `o 69 r 5(3)(a) the person may apply for the document to be struck out` (JUST TRUE) TRUE EQUALS JUST TRUE -- any other party
#ASSERT `o 69 r 5(3)(a) the person may apply for the document to be struck out` (JUST TRUE) FALSE EQUALS NOTHING -- a stranger
#ASSERT `o 69 r 5(3)(a) the person may apply for the document to be struck out` (JUST FALSE) TRUE EQUALS JUST FALSE -- the paragraph does not apply
#ASSERT `o 69 r 5(3)(b) the Court may strike out the document` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE -- on an application under (a)
#ASSERT `o 69 r 5(3)(b) the Court may strike out the document` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE -- on the Court's own motion
#ASSERT `o 69 r 5(3)(b) the Court may strike out the document` (JUST TRUE) FALSE FALSE EQUALS NOTHING -- neither
#ASSERT `o 69 r 5(3)(b) the Court may strike out the document` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE -- the paragraph does not apply

§ `O 69 -- the duties as regulative rules`
-- expected: FULFILLED
#TRACE `o 69 r 3(2) the duty to extract and serve the order` AT 0 WITH
    PARTY `o 69 the person that applies for the order` DOES `o 69 extract the order and serve it on all other parties` AT 2
-- expected: FULFILLED
#TRACE `o 69 r 4(1) the duty to serve the application for permission` AT 0 WITH
    PARTY `o 69 the party applying for permission` DOES `o 69 serve the application and affidavit on the persons named` AT 1
