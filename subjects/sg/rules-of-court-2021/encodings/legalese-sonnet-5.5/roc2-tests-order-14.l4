IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc2-order-14`

-- Tests for Order 14 (roc2-order-14.l4).  Expected values are written from the text, beside the assertion.
-- One #ASSERT per line.  Made-up dates stand in for the answers of O 3 r 3 (roc1).

-- Rule 1(1)
#ASSERT `o 14 r 1(1) the defendant may pay a sum of money into Court` TRUE TRUE FALSE `o 14 r 1(1) the cause of action in respect of which the claimant claims` EQUALS JUST TRUE -- a debt or damages action, notice filed, one cause of action
#ASSERT `o 14 r 1(1) the defendant may pay a sum of money into Court` TRUE TRUE TRUE `o 14 r 1(1) all of the causes of action joined in the action` EQUALS JUST TRUE -- 2 or more joined, in satisfaction of all of them
#ASSERT `o 14 r 1(1) the defendant may pay a sum of money into Court` TRUE TRUE TRUE `o 14 r 1(1) any of the causes of action joined in the action` EQUALS JUST TRUE -- in satisfaction of any of them
#ASSERT `o 14 r 1(1) the defendant may pay a sum of money into Court` TRUE TRUE FALSE `o 14 r 1(1) all of the causes of action joined in the action` EQUALS JUST FALSE -- not 2 or more joined: "where" fails
#ASSERT `o 14 r 1(1) the defendant may pay a sum of money into Court` TRUE TRUE FALSE `o 14 r 1(1) any of the causes of action joined in the action` EQUALS JUST FALSE -- same
#ASSERT `o 14 r 1(1) the defendant may pay a sum of money into Court` TRUE FALSE FALSE `o 14 r 1(1) the cause of action in respect of which the claimant claims` EQUALS JUST FALSE -- notice of intention not yet filed: "at any time after the defendant has filed" is a period fixed in the text's own words, so JUST FALSE (as O 9 r 17(1))
#ASSERT `o 14 r 1(1) the defendant may pay a sum of money into Court` FALSE TRUE FALSE `o 14 r 1(1) the cause of action in respect of which the claimant claims` EQUALS NOTHING -- not an action for a debt or damages
-- Rule 1(2)
#ASSERT `o 14 r 1(2) the defendant must give notice of the payment or further payment` TRUE EQUALS JUST TRUE -- on making or increasing a payment
#ASSERT `o 14 r 1(2) the defendant must give notice of the payment or further payment` FALSE EQUALS NOTHING -- no payment made
#ASSERT `o 14 r 1(2) the notice of payment is as required` TRUE TRUE TRUE EQUALS JUST TRUE -- Form 27, to the claimant and every other defendant
#ASSERT `o 14 r 1(2) the notice of payment is as required` FALSE TRUE TRUE EQUALS JUST FALSE -- not Form 27
#ASSERT `o 14 r 1(2) the notice of payment is as required` TRUE FALSE TRUE EQUALS JUST FALSE -- not given to the claimant
#ASSERT `o 14 r 1(2) the notice of payment is as required` TRUE TRUE FALSE EQUALS JUST FALSE -- not given to every other defendant
#ASSERT `o 14 r 1(2) three days after receiving the notice`'s `period length` EQUALS 3 -- "within 3 days after receiving the notice"
#ASSERT `o 14 r 1(2) the claimant must send the defendant a written acknowledgment of the receipt` TRUE EQUALS JUST TRUE -- the claimant has received the notice
#ASSERT `o 14 r 1(2) the claimant must send the defendant a written acknowledgment of the receipt` FALSE EQUALS NOTHING -- not received
#ASSERT `o 14 r 1(2) the claimant sends the acknowledgment in time` TRUE (Date 4 6 2027) (Date 4 6 2027) EQUALS JUST TRUE -- in writing, on the last day
#ASSERT `o 14 r 1(2) the claimant sends the acknowledgment in time` TRUE (Date 5 6 2027) (Date 4 6 2027) EQUALS JUST FALSE -- a day late
#ASSERT `o 14 r 1(2) the claimant sends the acknowledgment in time` FALSE (Date 4 6 2027) (Date 4 6 2027) EQUALS JUST FALSE -- in time but not in writing
#TRACE `o 14 r 1(2) the claimant must acknowledge the notice` AT 0 WITH
    PARTY `o 14 r 1(2) the claimant` DOES `o 14 r 1(2) send the defendant a written acknowledgment of the receipt` AT 3
#TRACE `o 14 r 1(2) the claimant must acknowledge the notice` AT 0 WITH
    (WAITUNTIL 4)
-- Rule 1(3)
#ASSERT `o 14 r 1(3) the defendant may give notice of an increase without permission` TRUE EQUALS JUST TRUE -- an increase
#ASSERT `o 14 r 1(3) the defendant may give notice of an increase without permission` FALSE EQUALS NOTHING -- not an increase
#ASSERT `o 14 r 1(3) a notice of payment may be withdrawn or amended` FALSE FALSE FALSE EQUALS JUST FALSE -- not an increase, no permission, no paragraph (5) order
#ASSERT `o 14 r 1(3) a notice of payment may be withdrawn or amended` TRUE FALSE FALSE EQUALS NOTHING -- "subject to that": an increase
#ASSERT `o 14 r 1(3) a notice of payment may be withdrawn or amended` FALSE TRUE FALSE EQUALS NOTHING -- with the permission of the Court
#ASSERT `o 14 r 1(3) a notice of payment may be withdrawn or amended` FALSE FALSE TRUE EQUALS NOTHING -- "without affecting paragraph (5)"
#ASSERT `o 14 r 1(3) the Court may grant permission on such terms as may be just` TRUE EQUALS JUST TRUE -- an application for permission
#ASSERT `o 14 r 1(3) the Court may grant permission on such terms as may be just` FALSE EQUALS NOTHING -- no application
-- Rule 1(4)
#ASSERT `o 14 r 1(4)(a) the notice of payment states or specifies the causes of action` TRUE TRUE TRUE FALSE EQUALS JUST TRUE -- paid in respect of all, the notice says so
#ASSERT `o 14 r 1(4)(a) the notice of payment states or specifies the causes of action` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- paid in respect of all, the notice does not say so (specifying is not enough)
#ASSERT `o 14 r 1(4)(a) the notice of payment states or specifies the causes of action` TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- some only, the notice specifies which
#ASSERT `o 14 r 1(4)(a) the notice of payment states or specifies the causes of action` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- some only, the notice does not specify
#ASSERT `o 14 r 1(4)(a) the notice of payment states or specifies the causes of action` FALSE TRUE FALSE FALSE EQUALS JUST TRUE -- the paragraph does not reach: nothing is required
#ASSERT `o 14 r 1(4)(b) the notice of payment specifies the sum paid in respect of each cause of action` TRUE TRUE TRUE EQUALS JUST TRUE -- separate payments, sums specified
#ASSERT `o 14 r 1(4)(b) the notice of payment specifies the sum paid in respect of each cause of action` TRUE TRUE FALSE EQUALS JUST FALSE -- separate payments, sums not specified
#ASSERT `o 14 r 1(4)(b) the notice of payment specifies the sum paid in respect of each cause of action` TRUE FALSE FALSE EQUALS JUST TRUE -- no separate payments: nothing is required
#ASSERT `o 14 r 1(4)(b) the notice of payment specifies the sum paid in respect of each cause of action` FALSE TRUE FALSE EQUALS JUST TRUE -- the paragraph does not reach
-- Rules 1(5), 1(6), 1(7)
#ASSERT `o 14 r 1(6) the number of causes of action for the purpose of paragraph (5)` 3 TRUE EQUALS 2 -- sections 10 and 20 treated as one
#ASSERT `o 14 r 1(6) the number of causes of action for the purpose of paragraph (5)` 3 FALSE EQUALS 3 -- no sections 10 and 20
#ASSERT `o 14 r 1(6) the causes of action are treated as one cause of action for the purpose of paragraph (5)` TRUE EQUALS JUST TRUE -- sections 10 and 20 joined
#ASSERT `o 14 r 1(6) the causes of action are treated as one cause of action for the purpose of paragraph (5)` FALSE EQUALS JUST FALSE -- not joined: "Where a cause of action under section 10 ... and ... section 20 ... are joined" is a "where" that fails, so JUST FALSE
#ASSERT `o 14 r 1(5) the Court may order the defendant to amend the notice of payment to specify the sum paid in respect of each cause of action` TRUE 2 TRUE NOTHING EQUALS JUST TRUE -- a single sum for 2 causes, claimant embarrassed
#ASSERT `o 14 r 1(5) the Court may order the defendant to amend the notice of payment to specify the sum paid in respect of each cause of action` TRUE 1 TRUE NOTHING EQUALS JUST FALSE -- only one cause after paragraph (6)
#ASSERT `o 14 r 1(5) the Court may order the defendant to amend the notice of payment to specify the sum paid in respect of each cause of action` TRUE 2 FALSE NOTHING EQUALS JUST FALSE -- claimant not embarrassed
#ASSERT `o 14 r 1(5) the Court may order the defendant to amend the notice of payment to specify the sum paid in respect of each cause of action` FALSE 2 TRUE NOTHING EQUALS JUST FALSE -- not a single sum
#ASSERT `o 14 r 1(5) the Court may order the defendant to amend the notice of payment to specify the sum paid in respect of each cause of action` TRUE 2 TRUE (JUST FALSE) EQUALS JUST FALSE -- Rule 3(3): after the trial has begun
#ASSERT `o 14 r 1(7) the cause of action is construed as a cause of action in respect also of the interest that might be included in the judgment` TRUE EQUALS JUST TRUE -- a cause of action in respect of a debt or damages
#ASSERT `o 14 r 1(7) the cause of action is construed as a cause of action in respect also of the interest that might be included in the judgment` FALSE EQUALS NOTHING -- some other cause of action

-- Rule 2
#ASSERT `o 14 r 2 the notice of payment states what Rule 2 requires` TRUE TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- one counterclaim cause of action, the notice states it
#ASSERT `o 14 r 2 the notice of payment states what Rule 2 requires` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- the notice does not state it
#ASSERT `o 14 r 2 the notice of payment states what Rule 2 requires` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE -- 2 or more, all taken into account, the notice states so
#ASSERT `o 14 r 2 the notice of payment states what Rule 2 requires` TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- all taken into account, the notice does not state so
#ASSERT `o 14 r 2 the notice of payment states what Rule 2 requires` TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- not all, the notice specifies which
#ASSERT `o 14 r 2 the notice of payment states what Rule 2 requires` TRUE TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- not all, the notice does not specify which
#ASSERT `o 14 r 2 the notice of payment states what Rule 2 requires` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- "if it be the case": it is not the case, nothing is required
#ASSERT `o 14 r 2 the notice of payment states what Rule 2 requires` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING -- no counterclaim payment: Rule 2 does not reach

-- Rule 3
#ASSERT `o 14 r 3(1) fourteen days after receipt of the notice of payment`'s `period length` EQUALS 14 -- "within 14 days after receipt"
#ASSERT `o 14 r 3(1) the claimant may accept the money` TRUE TRUE `o 14 r 3(1)(a) the money paid in respect of the cause of action or all the causes of action in respect of which the claimant claims` (Date 14 6 2027) (Date 14 6 2027) TRUE TRUE EQUALS JUST TRUE -- (a), on the last day, before the trial, Form 28
#ASSERT `o 14 r 3(1) the claimant may accept the money` TRUE TRUE `o 14 r 3(1)(a) the money paid in respect of the cause of action or all the causes of action in respect of which the claimant claims` (Date 15 6 2027) (Date 14 6 2027) TRUE TRUE EQUALS JUST FALSE -- a day late
#ASSERT `o 14 r 3(1) the claimant may accept the money` TRUE TRUE `o 14 r 3(1)(a) the money paid in respect of the cause of action or all the causes of action in respect of which the claimant claims` (Date 14 6 2027) (Date 14 6 2027) FALSE TRUE EQUALS JUST FALSE -- after the trial or hearing has begun
#ASSERT `o 14 r 3(1) the claimant may accept the money` TRUE TRUE `o 14 r 3(1)(a) the money paid in respect of the cause of action or all the causes of action in respect of which the claimant claims` (Date 14 6 2027) (Date 14 6 2027) TRUE FALSE EQUALS JUST FALSE -- notice not in Form 28 to every defendant
#ASSERT `o 14 r 3(1) the claimant may accept the money` TRUE FALSE `o 14 r 3(1)(b) the sum specified in the notice of payment in respect of some only of the causes of action` (Date 14 6 2027) (Date 14 6 2027) TRUE TRUE EQUALS JUST TRUE -- (b), some only
#ASSERT `o 14 r 3(1) the claimant may accept the money` TRUE TRUE `o 14 r 3(1)(b) the sum specified in the notice of payment in respect of some only of the causes of action` (Date 14 6 2027) (Date 14 6 2027) TRUE TRUE EQUALS JUST FALSE -- (b) where the money was paid in respect of all: "where" fails
#ASSERT `o 14 r 3(1) the claimant may accept the money` TRUE FALSE `o 14 r 3(1)(a) the money paid in respect of the cause of action or all the causes of action in respect of which the claimant claims` (Date 14 6 2027) (Date 14 6 2027) TRUE TRUE EQUALS JUST FALSE -- (a) where the money was paid for some only: "where" fails
#ASSERT `o 14 r 3(1) the claimant may accept the money` FALSE TRUE `o 14 r 3(1)(a) the money paid in respect of the cause of action or all the causes of action in respect of which the claimant claims` (Date 14 6 2027) (Date 14 6 2027) TRUE TRUE EQUALS JUST FALSE -- no payment into Court
#ASSERT `o 14 r 3(2) two days after receipt of the notice of payment or of the further payment`'s `period length` EQUALS 2 -- "within 2 days after receipt"
#ASSERT `o 14 r 3(2) the claimant may accept the money after the trial or hearing has begun` TRUE (Date 6 6 2027) (Date 6 6 2027) TRUE EQUALS JUST TRUE -- on the last day, before the Judge begins to deliver judgment
#ASSERT `o 14 r 3(2) the claimant may accept the money after the trial or hearing has begun` TRUE (Date 7 6 2027) (Date 6 6 2027) TRUE EQUALS JUST FALSE -- a day late
#ASSERT `o 14 r 3(2) the claimant may accept the money after the trial or hearing has begun` TRUE (Date 6 6 2027) (Date 6 6 2027) FALSE EQUALS JUST FALSE -- after the Judge has begun to deliver judgment
#ASSERT `o 14 r 3(2) the claimant may accept the money after the trial or hearing has begun` FALSE (Date 6 6 2027) (Date 6 6 2027) TRUE EQUALS JUST FALSE -- the payment was before the trial began: paragraph (1) governs
#ASSERT `o 14 r 3(3) Rule 1(5) applies in relation to the money` TRUE EQUALS JUST FALSE -- "does not apply" after the trial has begun
#ASSERT `o 14 r 3(3) Rule 1(5) applies in relation to the money` FALSE EQUALS NOTHING -- before the trial has begun
#ASSERT `o 14 r 3(4) all further proceedings against the defendant are stayed` TRUE TRUE `o 14 r 3(4) the defendant making the payment` EQUALS JUST TRUE -- the defendant making the payment
#ASSERT `o 14 r 3(4) all further proceedings against the defendant are stayed` TRUE TRUE `o 14 r 3(4) another defendant sued jointly with or in the alternative to the defendant making the payment` EQUALS JUST TRUE -- another defendant sued jointly or in the alternative
#ASSERT `o 14 r 3(4) all further proceedings against the defendant are stayed` TRUE TRUE `o 14 r 3(4) any other defendant` EQUALS NOTHING -- a defendant not so sued
#ASSERT `o 14 r 3(4) all further proceedings against the defendant are stayed` FALSE TRUE `o 14 r 3(4) the defendant making the payment` EQUALS JUST FALSE -- no acceptance
#ASSERT `o 14 r 3(4) all further proceedings against the defendant are stayed` TRUE FALSE `o 14 r 3(4) the defendant making the payment` EQUALS JUST FALSE -- proceedings to which the acceptance does not relate
#ASSERT `o 14 r 3(5) all further proceedings on the counterclaim against the claimant are stayed` TRUE TRUE TRUE EQUALS JUST TRUE -- counterclaim payment, notice stated, claimant accepts
#ASSERT `o 14 r 3(5) all further proceedings on the counterclaim against the claimant are stayed` FALSE TRUE TRUE EQUALS JUST FALSE -- not paid by a defendant who counterclaimed
#ASSERT `o 14 r 3(5) all further proceedings on the counterclaim against the claimant are stayed` TRUE FALSE TRUE EQUALS JUST FALSE -- the notice did not state it
#ASSERT `o 14 r 3(5) all further proceedings on the counterclaim against the claimant are stayed` TRUE TRUE FALSE EQUALS JUST FALSE -- the claimant does not accept
#ASSERT `o 14 r 3(6) the claimant is entitled to receive payment of the sum` TRUE NOTHING NOTHING NOTHING EQUALS JUST TRUE -- accepted, nothing bars
#ASSERT `o 14 r 3(6) the claimant is entitled to receive payment of the sum` TRUE (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE -- Rule 4 says no
#ASSERT `o 14 r 3(6) the claimant is entitled to receive payment of the sum` TRUE NOTHING (JUST FALSE) NOTHING EQUALS JUST FALSE -- Rule 10 says no
#ASSERT `o 14 r 3(6) the claimant is entitled to receive payment of the sum` TRUE NOTHING NOTHING (JUST FALSE) EQUALS JUST FALSE -- Order 44, Rule 11 says no
#ASSERT `o 14 r 3(6) the claimant is entitled to receive payment of the sum` FALSE NOTHING NOTHING NOTHING EQUALS NOTHING -- no acceptance

-- Rules 4 and 5
#ASSERT `o 14 r 4(1) the money in Court may be paid out` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- (a), no paragraph (2), no order
#ASSERT `o 14 r 4(1) the money in Court may be paid out` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- (b), tender before action
#ASSERT `o 14 r 4(1) the money in Court may be paid out` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE -- (c), more than one person entitled
#ASSERT `o 14 r 4(1) the money in Court may be paid out` TRUE TRUE FALSE FALSE TRUE FALSE EQUALS NOTHING -- under paragraph (2)
#ASSERT `o 14 r 4(1) the money in Court may be paid out` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING -- in pursuance of an order
#ASSERT `o 14 r 4(1) the money in Court may be paid out` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING -- none of (a), (b), (c)
#ASSERT `o 14 r 4(1) the money in Court may be paid out` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING -- not accepted
#ASSERT `o 14 r 4(1) the order deals with the whole costs` TRUE TRUE EQUALS JUST TRUE -- deals with the whole costs
#ASSERT `o 14 r 4(1) the order deals with the whole costs` TRUE FALSE EQUALS JUST FALSE -- does not
#ASSERT `o 14 r 4(1) the order deals with the whole costs` FALSE TRUE EQUALS NOTHING -- no order under paragraph (1)
#ASSERT `o 14 r 4(2) the money may be paid out without an order of the Court` TRUE TRUE TRUE EQUALS JUST TRUE -- by reason only of (1)(a), discontinues, consent in writing
#ASSERT `o 14 r 4(2) the money may be paid out without an order of the Court` TRUE FALSE TRUE EQUALS JUST FALSE -- no discontinuance
#ASSERT `o 14 r 4(2) the money may be paid out without an order of the Court` TRUE TRUE FALSE EQUALS JUST FALSE -- no written consent
#ASSERT `o 14 r 4(2) the money may be paid out without an order of the Court` FALSE TRUE TRUE EQUALS JUST FALSE -- an order is required for another reason
#ASSERT `o 14 r 4(3) the money may be paid out` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- after the trial has begun, stayed by Rule 3(4), no order: "despite anything in paragraph (2)"
#ASSERT `o 14 r 4(3) the money may be paid out` TRUE TRUE TRUE TRUE EQUALS NOTHING -- in pursuance of an order
#ASSERT `o 14 r 4(3) the money may be paid out` FALSE TRUE TRUE FALSE EQUALS NOTHING -- the trial had not begun
#ASSERT `o 14 r 4(3) the money may be paid out` TRUE TRUE FALSE FALSE EQUALS NOTHING -- not stayed by Rule 3(4)
#ASSERT `o 14 r 4(3) the order deals with the whole costs of the action` TRUE TRUE EQUALS JUST TRUE -- deals with the whole costs of the action
#ASSERT `o 14 r 4(3) the order deals with the whole costs of the action` TRUE FALSE EQUALS JUST FALSE -- does not
#ASSERT `o 14 r 4(3) the order deals with the whole costs of the action` FALSE TRUE EQUALS NOTHING -- no order under paragraph (3)
#ASSERT `o 14 r 5 the money remaining in Court may be paid out` TRUE FALSE EQUALS JUST FALSE -- not accepted, no order
#ASSERT `o 14 r 5 the money remaining in Court may be paid out` TRUE TRUE EQUALS NOTHING -- in pursuance of an order
#ASSERT `o 14 r 5 the money remaining in Court may be paid out` FALSE FALSE EQUALS NOTHING -- accepted in accordance with Rule 3
#ASSERT `o 14 r 5 the Court may make an order for payment out at this stage` TRUE `o 14 r 5 before the trial or hearing of the action` EQUALS JUST TRUE -- before
#ASSERT `o 14 r 5 the Court may make an order for payment out at this stage` TRUE `o 14 r 5 at the trial or hearing of the action` EQUALS JUST TRUE -- at
#ASSERT `o 14 r 5 the Court may make an order for payment out at this stage` TRUE `o 14 r 5 after the trial or hearing of the action` EQUALS JUST TRUE -- after
#ASSERT `o 14 r 5 the Court may make an order for payment out at this stage` FALSE `o 14 r 5 after the trial or hearing of the action` EQUALS JUST FALSE -- accepted in accordance with Rule 3: "If" fails
#ASSERT `o 14 r 5 the money may be paid out under an order made before the trial or hearing` TRUE TRUE FALSE EQUALS JUST FALSE -- not accepted, order before the trial, not in satisfaction of the causes of action paid in respect of
#ASSERT `o 14 r 5 the money may be paid out under an order made before the trial or hearing` TRUE TRUE TRUE EQUALS NOTHING -- in satisfaction of those causes of action
#ASSERT `o 14 r 5 the money may be paid out under an order made before the trial or hearing` TRUE FALSE FALSE EQUALS NOTHING -- order not made before the trial
#ASSERT `o 14 r 5 the money may be paid out under an order made before the trial or hearing` FALSE TRUE FALSE EQUALS NOTHING -- accepted in accordance with Rule 3

-- Rules 6 to 8
#ASSERT `o 14 r 6 the person may pay money into Court in accordance with Rule 1` TRUE EQUALS JUST TRUE -- a claimant against whom a counterclaim is made or another defendant to it
#ASSERT `o 14 r 6 the person may pay money into Court in accordance with Rule 1` FALSE EQUALS NOTHING -- some other person
#ASSERT `o 14 r 6 the provision applies accordingly with the necessary modifications` TRUE `o 14 r 6 Rule 1` EQUALS JUST TRUE -- Rule 1
#ASSERT `o 14 r 6 the provision applies accordingly with the necessary modifications` TRUE `o 14 r 6 Rule 3, except paragraph (5)` EQUALS JUST TRUE -- Rule 3 except paragraph (5)
#ASSERT `o 14 r 6 the provision applies accordingly with the necessary modifications` TRUE `o 14 r 6 Rule 3(5)` EQUALS JUST FALSE -- "except paragraph (5)"
#ASSERT `o 14 r 6 the provision applies accordingly with the necessary modifications` TRUE `o 14 r 6 Rule 4` EQUALS JUST TRUE -- Rule 4
#ASSERT `o 14 r 6 the provision applies accordingly with the necessary modifications` TRUE `o 14 r 6 Rule 5` EQUALS JUST TRUE -- Rule 5
#ASSERT `o 14 r 6 the provision applies accordingly with the necessary modifications` TRUE `o 14 r 6 any other provision` EQUALS NOTHING -- not named
#ASSERT `o 14 r 6 the provision applies accordingly with the necessary modifications` FALSE `o 14 r 6 Rule 1` EQUALS NOTHING -- not a counterclaim payer
#ASSERT `o 14 r 7 the fact that money has been paid into Court may be pleaded or communicated to the Court at the trial or hearing` FALSE FALSE FALSE EQUALS JUST FALSE -- no exception, questions not yet decided
#ASSERT `o 14 r 7 the fact that money has been paid into Court may be pleaded or communicated to the Court at the trial or hearing` TRUE FALSE FALSE EQUALS NOTHING -- a defence of tender before action is pleaded
#ASSERT `o 14 r 7 the fact that money has been paid into Court may be pleaded or communicated to the Court at the trial or hearing` FALSE TRUE FALSE EQUALS NOTHING -- stayed by Rule 3(4) after the trial has begun
#ASSERT `o 14 r 7 the fact that money has been paid into Court may be pleaded or communicated to the Court at the trial or hearing` FALSE FALSE TRUE EQUALS NOTHING -- all questions decided
#ASSERT `o 14 r 8(1) the money may be paid out` TRUE FALSE FALSE EQUALS JUST FALSE -- paid in under an order, not appropriated, no order for payment out
#ASSERT `o 14 r 8(1) the money may be paid out` TRUE TRUE FALSE EQUALS NOTHING -- "Subject to paragraph (2)": appropriated
#ASSERT `o 14 r 8(1) the money may be paid out` TRUE FALSE TRUE EQUALS NOTHING -- in pursuance of an order
#ASSERT `o 14 r 8(1) the money may be paid out` FALSE FALSE FALSE EQUALS NOTHING -- not paid in under an order or certificate
#ASSERT `o 14 r 8(2) the party may appropriate the money in this way` FALSE TRUE `o 14 r 8(2)(a) by notice to the other party to a particular claim made in the originating claim or counterclaim and specified in the notice` FALSE EQUALS JUST TRUE -- (a), by notice
#ASSERT `o 14 r 8(2) the party may appropriate the money in this way` FALSE TRUE `o 14 r 8(2)(b) by the party's pleading, as payment into Court of the money alleged to have been tendered` TRUE EQUALS JUST TRUE -- (b), the party pleads a tender
#ASSERT `o 14 r 8(2) the party may appropriate the money in this way` FALSE TRUE `o 14 r 8(2)(b) by the party's pleading, as payment into Court of the money alleged to have been tendered` FALSE EQUALS JUST FALSE -- (b), no tender pleaded
#ASSERT `o 14 r 8(2) the party may appropriate the money in this way` TRUE TRUE `o 14 r 8(2)(a) by notice to the other party to a particular claim made in the originating claim or counterclaim and specified in the notice` FALSE EQUALS NOTHING -- "Unless the Court otherwise orders"
#ASSERT `o 14 r 8(2) the party may appropriate the money in this way` FALSE FALSE `o 14 r 8(2)(a) by notice to the other party to a particular claim made in the originating claim or counterclaim and specified in the notice` FALSE EQUALS NOTHING -- not paid pursuant to an order under Order 9, Rule 17
#ASSERT `o 14 r 8(2) the appropriated money is deemed to be` TRUE `o 14 r 8(2)(a) by notice to the other party to a particular claim made in the originating claim or counterclaim and specified in the notice` EQUALS JUST `o 14 r 8(2) money paid into Court in accordance with Rule 1` -- by notice: money paid in under Rule 1
#ASSERT `o 14 r 8(2) the appropriated money is deemed to be` TRUE `o 14 r 8(2)(b) by the party's pleading, as payment into Court of the money alleged to have been tendered` EQUALS JUST `o 14 r 8(2) money paid into Court with a plea of tender` -- by pleading: money paid in with a plea of tender
#ASSERT `o 14 r 8(2) the appropriated money is deemed to be` FALSE `o 14 r 8(2)(a) by notice to the other party to a particular claim made in the originating claim or counterclaim and specified in the notice` EQUALS NOTHING -- not appropriated

-- Rules 9 to 12
#ASSERT `o 14 r 9(1) any party to the cause or matter may apply for payment out of Court of that money` TRUE EQUALS JUST TRUE -- money paid in pursuant to the Exchange Control Act
#ASSERT `o 14 r 9(1) any party to the cause or matter may apply for payment out of Court of that money` FALSE EQUALS JUST FALSE -- "Where" fails
#ASSERT `o 14 r 9(2) the application is made as required` TRUE TRUE EQUALS JUST TRUE -- by summons served on all parties interested
#ASSERT `o 14 r 9(2) the application is made as required` FALSE TRUE EQUALS JUST FALSE -- not by summons
#ASSERT `o 14 r 9(2) the application is made as required` TRUE FALSE EQUALS JUST FALSE -- not served on all parties interested
#ASSERT `o 14 r 9(3) the summons states what paragraph (3) requires` TRUE TRUE EQUALS JUST TRUE -- resident outside the scheduled territories, the summons states it
#ASSERT `o 14 r 9(3) the summons states what paragraph (3) requires` TRUE FALSE EQUALS JUST FALSE -- the summons does not state it
#ASSERT `o 14 r 9(3) the summons states what paragraph (3) requires` FALSE FALSE EQUALS JUST TRUE -- not so resident: nothing is required
#ASSERT `o 14 r 9(4) the summons states and attaches what paragraph (4) requires` TRUE TRUE TRUE EQUALS JUST TRUE -- permission given, stated and attached
#ASSERT `o 14 r 9(4) the summons states and attaches what paragraph (4) requires` TRUE FALSE TRUE EQUALS JUST FALSE -- not stated
#ASSERT `o 14 r 9(4) the summons states and attaches what paragraph (4) requires` TRUE TRUE FALSE EQUALS JUST FALSE -- not attached
#ASSERT `o 14 r 9(4) the summons states and attaches what paragraph (4) requires` FALSE FALSE FALSE EQUALS JUST TRUE -- no permission: nothing is required
#ASSERT `o 14 r 10(1) payment may be made to this payee` TRUE TRUE FALSE `o 14 r 10 the party's solicitor` EQUALS JUST TRUE -- legal aid, represented: to the solicitor
#ASSERT `o 14 r 10(1) payment may be made to this payee` TRUE FALSE TRUE `o 14 r 10 the Director of Legal Aid` EQUALS JUST TRUE -- legal aid, not represented, the Court so orders: to the Director
#ASSERT `o 14 r 10(1) payment may be made to this payee` TRUE FALSE FALSE `o 14 r 10 the Director of Legal Aid` EQUALS JUST FALSE -- the Court does not so order
#ASSERT `o 14 r 10(1) payment may be made to this payee` TRUE TRUE TRUE `o 14 r 10 the Director of Legal Aid` EQUALS JUST FALSE -- represented by a solicitor
#ASSERT `o 14 r 10(1) payment may be made to this payee` TRUE FALSE FALSE `o 14 r 10 the party's solicitor` EQUALS JUST FALSE -- no solicitor
#ASSERT `o 14 r 10(1) payment may be made to this payee` TRUE TRUE FALSE `o 14 r 10 the party entitled` EQUALS JUST FALSE -- "only"
#ASSERT `o 14 r 10(1) payment may be made to this payee` TRUE TRUE FALSE `o 14 r 10 any other person` EQUALS JUST FALSE -- "only"
#ASSERT `o 14 r 10(1) payment may be made to this payee` FALSE TRUE FALSE `o 14 r 10 the party entitled` EQUALS NOTHING -- no legal aid certificate: paragraph (2)
#ASSERT `o 14 r 10(2) payment may be made to this payee` FALSE FALSE FALSE `o 14 r 10 the party entitled` EQUALS JUST TRUE -- to the party entitled
#ASSERT `o 14 r 10(2) payment may be made to this payee` FALSE TRUE FALSE `o 14 r 10 the party's solicitor` EQUALS JUST TRUE -- on written authority
#ASSERT `o 14 r 10(2) payment may be made to this payee` FALSE FALSE TRUE `o 14 r 10 the party's solicitor` EQUALS JUST TRUE -- the Court so orders, without such authority
#ASSERT `o 14 r 10(2) payment may be made to this payee` FALSE FALSE FALSE `o 14 r 10 the party's solicitor` EQUALS JUST FALSE -- no authority and no order
#ASSERT `o 14 r 10(2) payment may be made to this payee` FALSE TRUE TRUE `o 14 r 10 the Director of Legal Aid` EQUALS JUST FALSE -- only paragraph (1) names the Director
#ASSERT `o 14 r 10(2) payment may be made to this payee` FALSE TRUE TRUE `o 14 r 10 any other person` EQUALS JUST FALSE -- not named
#ASSERT `o 14 r 10(2) payment may be made to this payee` TRUE TRUE TRUE `o 14 r 10 the party entitled` EQUALS NOTHING -- "Subject to paragraph (1)": paragraph (1) decides
#ASSERT `o 14 r 10(3) this Rule applies to the money` TRUE EQUALS JUST TRUE -- paid in under Rule 1 or an order or certificate
#ASSERT `o 14 r 10(3) this Rule applies to the money` FALSE EQUALS NOTHING -- some other money
#ASSERT `o 14 r 11 fifty thousand dollars` EQUALS 50000 -- "do not exceed $50,000"
#ASSERT `o 14 r 11 the Court may order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 50000 `o 14 r 11 a widow` TRUE EQUALS JUST TRUE -- exactly $50,000 does not exceed $50,000; a widow with the prior right
#ASSERT `o 14 r 11 the Court may order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 50001 `o 14 r 11 a widow` TRUE EQUALS JUST FALSE -- $50,001 exceeds $50,000
#ASSERT `o 14 r 11 the Court may order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 10000 `o 14 r 11 a widower` TRUE EQUALS JUST TRUE -- a widower
#ASSERT `o 14 r 11 the Court may order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 10000 `o 14 r 11 a child` TRUE EQUALS JUST TRUE -- a child
#ASSERT `o 14 r 11 the Court may order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 10000 `o 14 r 11 a father` TRUE EQUALS JUST TRUE -- a father
#ASSERT `o 14 r 11 the Court may order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 10000 `o 14 r 11 a mother` TRUE EQUALS JUST TRUE -- a mother
#ASSERT `o 14 r 11 the Court may order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 10000 `o 14 r 11 a brother` TRUE EQUALS JUST TRUE -- a brother
#ASSERT `o 14 r 11 the Court may order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 10000 `o 14 r 11 a sister` TRUE EQUALS JUST TRUE -- a sister
#ASSERT `o 14 r 11 the Court may order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 10000 `o 14 r 11 a sister` FALSE EQUALS NOTHING -- a sister without the prior right
#ASSERT `o 14 r 11 the Court may order that the fund or share be paid, transferred or delivered to the person` TRUE TRUE 10000 `o 14 r 11 any other person` TRUE EQUALS NOTHING -- not a listed relative
#ASSERT `o 14 r 11 the Court may order that the fund or share be paid, transferred or delivered to the person` FALSE TRUE 10000 `o 14 r 11 a widow` TRUE EQUALS JUST FALSE -- did not die intestate
#ASSERT `o 14 r 11 the Court may order that the fund or share be paid, transferred or delivered to the person` TRUE FALSE 10000 `o 14 r 11 a widow` TRUE EQUALS JUST FALSE -- the Court is not satisfied that no grant has been made
#ASSERT `o 14 r 12(1) this Rule applies in relation to the action or counterclaim` TRUE TRUE EQUALS JUST TRUE -- a motor vehicle bodily injury claim including hospital expenses
#ASSERT `o 14 r 12(1) this Rule applies in relation to the action or counterclaim` FALSE TRUE EQUALS NOTHING -- not such an action
#ASSERT `o 14 r 12(1) this Rule applies in relation to the action or counterclaim` TRUE FALSE EQUALS NOTHING -- no sum for hospital expenses
#ASSERT `o 14 r 12(2) fourteen days after payment is made`'s `period length` EQUALS 14 -- "within 14 days after payment is made"
#ASSERT `o 14 r 12(2) the party against whom the claim is made must give notice of the payment to all the other parties` TRUE TRUE EQUALS JUST TRUE -- the Rule applies, the payment is made
#ASSERT `o 14 r 12(2) the party against whom the claim is made must give notice of the payment to all the other parties` FALSE TRUE EQUALS JUST FALSE -- the Rule does not apply
#ASSERT `o 14 r 12(2) the party against whom the claim is made must give notice of the payment to all the other parties` TRUE FALSE EQUALS JUST FALSE -- no such payment: "Where" fails
#ASSERT `o 14 r 12(2) the party gives notice of the payment in time` (Date 14 6 2027) (Date 14 6 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `o 14 r 12(2) the party gives notice of the payment in time` (Date 15 6 2027) (Date 14 6 2027) EQUALS JUST FALSE -- a day late
#TRACE `o 14 r 12(2) the party against whom the claim is made must give notice of the hospital payment` AT 0 WITH
    PARTY `o 14 r 12(2) the party against whom the claim is made` DOES `o 14 r 12(2) give notice of the payment to all the other parties to the action` AT 14
