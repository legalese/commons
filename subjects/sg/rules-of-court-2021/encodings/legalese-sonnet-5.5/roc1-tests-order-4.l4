#ASSERT `o 4 r 1 the person may be a party to proceedings in their own name` `o 4 test aged 19` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 4 r 1 the person may be a party to proceedings in their own name` `o 4 test aged 19` FALSE FALSE EQUALS NOTHING
