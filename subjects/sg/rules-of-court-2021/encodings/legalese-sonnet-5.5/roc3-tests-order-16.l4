IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc3-order-16`

-- Tests for Order 16.  Expected values are written from the text of the Rules (src lines 1639-1667),
-- decided before running.  Dates: the defence last served on Monday 3 November 2025; the 14 days
-- begin immediately after that date (O 3 r 3(3)), so the 14th day, the last day for the notice,
-- is Monday 17 November 2025 (O 3 r 3 is roc1's: the last day below is worked out by hand).

-- Rule 1: withdrawal of the notice of intention to contest or not contest.
#ASSERT `o 16 r 1 the party may withdraw the notice of intention to contest or not contest` TRUE TRUE EQUALS JUST TRUE -- filed, with permission: "may withdraw ... with the permission of the Court"
#ASSERT `o 16 r 1 the party may withdraw the notice of intention to contest or not contest` TRUE FALSE EQUALS NOTHING -- filed, no permission: the rule is silent
#ASSERT `o 16 r 1 the party may withdraw the notice of intention to contest or not contest` FALSE TRUE EQUALS NOTHING -- no notice filed: outside the scope "A party who has filed"
#ASSERT `o 16 r 1 the party may withdraw the notice of intention to contest or not contest` FALSE FALSE EQUALS NOTHING

-- Rule 2(1)/(2)(b): the 14 days.
#ASSERT `o 16 r 2(1) the period after service of the defence`'s `period length` EQUALS 14 -- "not later than 14 days after service of the defence"
#ASSERT `o 16 r 2(1) the period after service of the defence`'s `period unit` EQUALS Days
#ASSERT `o 16 r 2(1) the period after service of the defence`'s `period direction` EQUALS `After the anchor`
#ASSERT `o 16 r 2(2)(b) the period after service of the defence to counterclaim`'s `period length` EQUALS 14 -- "not later than 14 days after service on the defendant of a defence to counterclaim"

-- Rule 2(1): the claimant, without permission.
#ASSERT `o 16 r 2(1) the claimant may discontinue the action or withdraw a claim without the permission of the Court` TRUE (JUST (Date 17 11 2025)) (Date 17 11 2025) EQUALS JUST TRUE -- notice served on the last day
#ASSERT `o 16 r 2(1) the claimant may discontinue the action or withdraw a claim without the permission of the Court` TRUE (JUST (Date 10 11 2025)) (Date 17 11 2025) EQUALS JUST TRUE -- served earlier: "at any time not later than"
#ASSERT `o 16 r 2(1) the claimant may discontinue the action or withdraw a claim without the permission of the Court` TRUE (JUST (Date 18 11 2025)) (Date 17 11 2025) EQUALS JUST FALSE -- one day late
#ASSERT `o 16 r 2(1) the claimant may discontinue the action or withdraw a claim without the permission of the Court` TRUE NOTHING (Date 17 11 2025) EQUALS NOTHING -- no notice in Form 32 served: "by serving a notice in Form 32"
#ASSERT `o 16 r 2(1) the claimant may discontinue the action or withdraw a claim without the permission of the Court` FALSE (JUST (Date 10 11 2025)) (Date 17 11 2025) EQUALS NOTHING -- an action not begun by originating claim

-- Rule 2(3): the date from which the 14 days run.
#ASSERT `o 16 r 2(3) the date from which the 14 days run for the action` (Date 3 11 2025) FALSE FALSE NOTHING EQUALS Date 3 11 2025 -- one defendant: the defence served
#ASSERT `o 16 r 2(3) the date from which the 14 days run for the action` (Date 3 11 2025) TRUE FALSE NOTHING EQUALS Date 3 11 2025 -- 2 or more defendants, all serve a defence: the last served
#ASSERT `o 16 r 2(3) the date from which the 14 days run for the action` (Date 3 11 2025) TRUE TRUE (JUST (Date 10 11 2025)) EQUALS Date 10 11 2025 -- a period expires after the latest service: the expiry of that period
#ASSERT `o 16 r 2(3) the date from which the 14 days run for the action` (Date 3 11 2025) TRUE TRUE (JUST (Date 3 11 2025)) EQUALS Date 3 11 2025 -- a period expires on the latest service date, not after it
#ASSERT `o 16 r 2(3) the date from which the 14 days run for the action` (Date 3 11 2025) TRUE TRUE (JUST (Date 28 10 2025)) EQUALS Date 3 11 2025 -- a period expired before the latest service
#ASSERT `o 16 r 2(3) the date from which the 14 days run for the action` (Date 3 11 2025) TRUE TRUE NOTHING EQUALS Date 3 11 2025 -- no such period stated
#ASSERT `o 16 r 2(3) the date from which the 14 days run for the action` (Date 3 11 2025) FALSE TRUE (JUST (Date 10 11 2025)) EQUALS Date 3 11 2025 -- only one defendant, so paragraph (3) does not move the date

-- Rule 2(4): the same for a counterclaim (the substitutions of references).
#ASSERT `o 16 r 2(4) the date from which the 14 days run for the counterclaim` (Date 3 11 2025) TRUE TRUE (JUST (Date 10 11 2025)) EQUALS Date 10 11 2025
#ASSERT `o 16 r 2(4) the date from which the 14 days run for the counterclaim` (Date 3 11 2025) FALSE FALSE NOTHING EQUALS Date 3 11 2025

-- Rule 2(2)(a): the defendant withdraws the defence.
#ASSERT `o 16 r 2(2)(a) the defendant may withdraw the defence or any part of it without the permission of the Court` TRUE TRUE EQUALS JUST TRUE -- "at any time", by notice in Form 32
#ASSERT `o 16 r 2(2)(a) the defendant may withdraw the defence or any part of it without the permission of the Court` TRUE FALSE EQUALS NOTHING -- no notice in Form 32 served
#ASSERT `o 16 r 2(2)(a) the defendant may withdraw the defence or any part of it without the permission of the Court` FALSE TRUE EQUALS NOTHING -- no defence filed

-- Rule 2(2)(b): the defendant discontinues the counterclaim.
#ASSERT `o 16 r 2(2)(b) the defendant may discontinue the counterclaim or withdraw a claim in it without the permission of the Court` TRUE (JUST (Date 17 11 2025)) (Date 17 11 2025) EQUALS JUST TRUE
#ASSERT `o 16 r 2(2)(b) the defendant may discontinue the counterclaim or withdraw a claim in it without the permission of the Court` TRUE (JUST (Date 18 11 2025)) (Date 17 11 2025) EQUALS JUST FALSE -- one day late
#ASSERT `o 16 r 2(2)(b) the defendant may discontinue the counterclaim or withdraw a claim in it without the permission of the Court` TRUE NOTHING (Date 17 11 2025) EQUALS NOTHING
#ASSERT `o 16 r 2(2)(b) the defendant may discontinue the counterclaim or withdraw a claim in it without the permission of the Court` FALSE (JUST (Date 10 11 2025)) (Date 17 11 2025) EQUALS NOTHING -- no counterclaim

-- Rule 2(5): withdrawal by consent of all the parties.
#ASSERT `o 16 r 2(5) the action may be withdrawn without the permission of the Court on the consent of all the parties` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 16 r 2(5) the action may be withdrawn without the permission of the Court on the consent of all the parties` FALSE FALSE TRUE EQUALS JUST FALSE -- "If all the parties to an action consent": one does not
#ASSERT `o 16 r 2(5) the action may be withdrawn without the permission of the Court on the consent of all the parties` TRUE TRUE TRUE EQUALS JUST FALSE -- trial has begun: "at any time before trial"
#ASSERT `o 16 r 2(5) the action may be withdrawn without the permission of the Court on the consent of all the parties` TRUE FALSE FALSE EQUALS NOTHING -- consent not produced to the Registrar

-- Rule 2(6): deemed discontinuance for want of a memorandum of service.  The last day of the 12 months
-- is Wednesday 6 May 2026 (validity of the originating claim expired on 6 May 2025).
#ASSERT `o 16 r 2(6) the action is deemed to have been discontinued against the defendant` TRUE FALSE FALSE FALSE (Date 7 5 2026) (Date 6 5 2026) EQUALS JUST TRUE -- 12 months run out, none of the three things done
#ASSERT `o 16 r 2(6) the action is deemed to have been discontinued against the defendant` TRUE FALSE FALSE FALSE (Date 6 5 2026) (Date 6 5 2026) EQUALS JUST FALSE -- the last day itself: the 12 months have not run out
#ASSERT `o 16 r 2(6) the action is deemed to have been discontinued against the defendant` TRUE TRUE FALSE FALSE (Date 7 5 2026) (Date 6 5 2026) EQUALS JUST FALSE -- memorandum of service filed in time
#ASSERT `o 16 r 2(6) the action is deemed to have been discontinued against the defendant` TRUE FALSE TRUE FALSE (Date 7 5 2026) (Date 6 5 2026) EQUALS JUST FALSE -- that defendant filed a notice of intention to contest or not contest
#ASSERT `o 16 r 2(6) the action is deemed to have been discontinued against the defendant` TRUE FALSE FALSE TRUE (Date 7 5 2026) (Date 6 5 2026) EQUALS JUST FALSE -- judgment obtained against that defendant
#ASSERT `o 16 r 2(6) the action is deemed to have been discontinued against the defendant` FALSE FALSE FALSE FALSE (Date 7 5 2026) (Date 6 5 2026) EQUALS NOTHING -- not an action begun by originating claim

-- Rule 2(8) and (7): no step for more than one year.  The one year ends on 31 March 2026.
#ASSERT `o 16 r 2(8) paragraph (7) applies to the action, cause or matter` TRUE EQUALS JUST FALSE -- "does not apply where ... stayed"
#ASSERT `o 16 r 2(8) paragraph (7) applies to the action, cause or matter` FALSE EQUALS NOTHING -- silent
#ASSERT `o 16 r 2(7) the action, cause or matter is deemed to have been discontinued` FALSE FALSE (Date 1 4 2026) (Date 31 3 2026) EQUALS JUST TRUE -- no step for more than one year
#ASSERT `o 16 r 2(7) the action, cause or matter is deemed to have been discontinued` FALSE FALSE (Date 31 3 2026) (Date 31 3 2026) EQUALS JUST FALSE -- the last day of the year: not "more than one year"
#ASSERT `o 16 r 2(7) the action, cause or matter is deemed to have been discontinued` TRUE FALSE (Date 1 4 2026) (Date 31 3 2026) EQUALS JUST FALSE -- a step was taken
#ASSERT `o 16 r 2(7) the action, cause or matter is deemed to have been discontinued` FALSE TRUE (Date 1 4 2026) (Date 31 3 2026) EQUALS JUST FALSE -- stayed: paragraph (8)

-- Rule 2(9): extension, on an application made before the year has elapsed.
#ASSERT `o 16 r 2(9) the Court may extend the time` TRUE EQUALS JUST TRUE
#ASSERT `o 16 r 2(9) the Court may extend the time` FALSE EQUALS JUST FALSE -- application made after the year has elapsed

-- Rule 2(10): reinstatement.
#ASSERT `o 16 r 2(10) the Court may reinstate the action, cause or matter and allow it to proceed` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 16 r 2(10) the Court may reinstate the action, cause or matter and allow it to proceed` TRUE FALSE EQUALS NOTHING -- no application
#ASSERT `o 16 r 2(10) the Court may reinstate the action, cause or matter and allow it to proceed` FALSE TRUE EQUALS JUST FALSE -- not discontinued under (6) or (7): a "where" that is not met

-- Rule 3.
#ASSERT `o 16 r 3(1) a party may discontinue the action or counterclaim or withdraw a claim without the permission of the Court` FALSE EQUALS JUST FALSE -- "may not ... without the permission of the Court"
#ASSERT `o 16 r 3(1) a party may discontinue the action or counterclaim or withdraw a claim without the permission of the Court` TRUE EQUALS NOTHING -- "Except as provided by Rule 2"
#ASSERT `o 16 r 3(1) the Court hearing the application may order the discontinuance or striking out on such terms as it thinks just` TRUE EQUALS JUST TRUE
#ASSERT `o 16 r 3(1) the Court hearing the application may order the discontinuance or striking out on such terms as it thinks just` FALSE EQUALS NOTHING
#ASSERT `o 16 r 3(2) the application for permission may be made by summons` TRUE EQUALS JUST TRUE
#ASSERT `o 16 r 3(2) the application for permission may be made by summons` FALSE EQUALS NOTHING -- not "only" by summons

-- Rule 4: the discontinuance is not a defence.
#ASSERT `o 16 r 4 the discontinuance is a defence to a subsequent action for the same cause of action` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 16 r 4 the discontinuance is a defence to a subsequent action for the same cause of action` TRUE TRUE TRUE EQUALS NOTHING -- "Subject to any terms imposed by the Court"
#ASSERT `o 16 r 4 the discontinuance is a defence to a subsequent action for the same cause of action` TRUE FALSE FALSE EQUALS NOTHING -- a different cause of action
#ASSERT `o 16 r 4 the discontinuance is a defence to a subsequent action for the same cause of action` FALSE TRUE FALSE EQUALS NOTHING -- nothing was discontinued

-- Rule 5: stay of a subsequent action.
#ASSERT `o 16 r 5 the Court may order the proceedings in the subsequent action to be stayed until the costs are paid` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 16 r 5 the Court may order the proceedings in the subsequent action to be stayed until the costs are paid` TRUE TRUE FALSE EQUALS JUST FALSE -- costs paid first, or no subsequent action for the same cause
#ASSERT `o 16 r 5 the Court may order the proceedings in the subsequent action to be stayed until the costs are paid` TRUE FALSE TRUE EQUALS JUST FALSE -- not liable for costs
#ASSERT `o 16 r 5 the Court may order the proceedings in the subsequent action to be stayed until the costs are paid` FALSE TRUE TRUE EQUALS JUST FALSE -- nothing was discontinued

-- Rule 6: withdrawal of a summons.
#ASSERT `o 16 r 6 the party may withdraw the summons` TRUE FALSE EQUALS JUST FALSE -- "may not withdraw it without the permission of the Court"
#ASSERT `o 16 r 6 the party may withdraw the summons` TRUE TRUE EQUALS NOTHING
#ASSERT `o 16 r 6 the party may withdraw the summons` FALSE FALSE EQUALS NOTHING -- no summons taken out by the party
#ASSERT `o 16 r 2 the form of the notice of discontinuance or withdrawal` EQUALS "Form 32"
