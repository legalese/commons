-- ---------------------------------------------------------------------------
§§ `Order 38 as regulative rules: traces`
-- ---------------------------------------------------------------------------

-- A DEONTIC cannot be compared in an #ASSERT on main, so each trace carries the expected outcome on the line above
-- and work/trace-check.py (run by hand, on both builds) compares.  Day 0 is the day the period starts.

-- r 5(1): the duty to file the affidavit within 14 days after the order, where the Court orders the proceedings.
-- expect: FULFILLED
#TRACE `o 38 r 5(1) the duty to file the affidavit` TRUE AT 0 WITH
    PARTY `o 38 r 5(1) the company` DOES `o 38 r 5(1) file the affidavit in the Registry` AT 14

-- expect: BREACH
#TRACE `o 38 r 5(1) the duty to file the affidavit` TRUE AT 0 WITH
    PARTY `o 38 r 5(1) the company` DOES `o 38 r 5(1) file the affidavit in the Registry` AT 15

-- expect: BREACH
#TRACE `o 38 r 5(1) the duty to file the affidavit` TRUE AT 0 WITH
    WAITUNTIL 15

-- the Court has not ordered the proceedings: nothing is owed.
-- expect: FULFILLED
#TRACE `o 38 r 5(1) the duty to file the affidavit` FALSE AT 0 WITH
    WAITUNTIL 15

-- r 5(3): the list is left at the Registry within one day after the affidavit is filed.
-- expect: FULFILLED
#TRACE `o 38 r 5(3) the duty to leave the list at the Registry` AT 0 WITH
    PARTY `o 38 r 5(1) the company` DOES `o 38 r 5(3) leave the list at the Registry` AT 1

-- expect: BREACH
#TRACE `o 38 r 5(3) the duty to leave the list at the Registry` AT 0 WITH
    PARTY `o 38 r 5(1) the company` DOES `o 38 r 5(3) leave the list at the Registry` AT 2

-- expect: BREACH
#TRACE `o 38 r 5(3) the duty to leave the list at the Registry` AT 0 WITH
    WAITUNTIL 2

-- r 7: the notices are sent within 14 days after the affidavit is filed.
-- expect: FULFILLED
#TRACE `o 38 r 7 the duty to send the notice` AT 0 WITH
    PARTY `o 38 r 5(1) the company` DOES `o 38 r 7 send the notice by post` AT 14

-- expect: BREACH
#TRACE `o 38 r 7 the duty to send the notice` AT 0 WITH
    PARTY `o 38 r 5(1) the company` DOES `o 38 r 7 send the notice by post` AT 15

-- expect: BREACH
#TRACE `o 38 r 7 the duty to send the notice` AT 0 WITH
    WAITUNTIL 15
