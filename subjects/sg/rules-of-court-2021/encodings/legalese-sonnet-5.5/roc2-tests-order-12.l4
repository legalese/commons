IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc2-order-12`

-- Tests for Order 12 (roc2-order-12.l4).  Expected values are written from the text, beside the assertion.
-- One #ASSERT per line.  Made-up dates stand in for the answers of O 3 r 3 (roc1).

-- Rule 1
#ASSERT `o 12 r 1(1) a person is an expert` TRUE TRUE EQUALS JUST TRUE -- scientific, technical or other specialised knowledge based on training, study or experience
#ASSERT `o 12 r 1(1) a person is an expert` FALSE TRUE EQUALS JUST FALSE -- no such knowledge
#ASSERT `o 12 r 1(1) a person is an expert` TRUE FALSE EQUALS JUST FALSE -- knowledge not based on training, study or experience
#ASSERT `o 12 r 1(2) the expert has the duty to assist the Court on the matter` TRUE TRUE EQUALS JUST TRUE -- an expert, a matter within expertise and on the issues referred
#ASSERT `o 12 r 1(2) the expert has the duty to assist the Court on the matter` TRUE FALSE EQUALS NOTHING -- a matter outside the expertise: the Rule does not say
#ASSERT `o 12 r 1(2) the expert has the duty to assist the Court on the matter` FALSE TRUE EQUALS NOTHING -- not an expert
#ASSERT `o 12 r 1(3) the expert's duty to the Court overrides the obligation` TRUE EQUALS JUST TRUE -- an obligation to the person who instructs or pays
#ASSERT `o 12 r 1(3) the expert's duty to the Court overrides the obligation` FALSE EQUALS NOTHING -- an obligation to anyone else

-- Rule 2
#ASSERT `o 12 r 2(1) expert evidence may be used in Court` FALSE EQUALS JUST FALSE -- "No expert evidence may be used in Court unless the Court approves"
#ASSERT `o 12 r 2(1) expert evidence may be used in Court` TRUE EQUALS NOTHING -- the Court approves: paragraphs (3) and (4) decide
#ASSERT `o 12 r 2(2) the parties have considered what paragraph (2) requires` TRUE TRUE EQUALS JUST TRUE -- both considered
#ASSERT `o 12 r 2(2) the parties have considered what paragraph (2) requires` FALSE TRUE EQUALS JUST FALSE -- contribution not considered
#ASSERT `o 12 r 2(2) the parties have considered what paragraph (2) requires` TRUE FALSE EQUALS JUST FALSE -- agreed statement or submissions not considered
#ASSERT `o 12 r 2(3) the Court may approve the use of expert evidence` TRUE FALSE EQUALS NOTHING -- will contribute materially and cannot be resolved otherwise: the prohibition does not reach
#ASSERT `o 12 r 2(3) the Court may approve the use of expert evidence` FALSE FALSE EQUALS JUST FALSE -- will not contribute materially
#ASSERT `o 12 r 2(3) the Court may approve the use of expert evidence` TRUE TRUE EQUALS JUST FALSE -- the issue can be resolved by an agreed statement of facts or agreed submissions
#ASSERT `o 12 r 2(3) the Court may approve the use of expert evidence` FALSE TRUE EQUALS JUST FALSE -- neither
#ASSERT `o 12 r 2(4) the Court may disallow the use of or reject the expert evidence` TRUE FALSE EQUALS JUST TRUE -- lacks the requisite specialised knowledge
#ASSERT `o 12 r 2(4) the Court may disallow the use of or reject the expert evidence` FALSE TRUE EQUALS JUST TRUE -- lacks impartiality
#ASSERT `o 12 r 2(4) the Court may disallow the use of or reject the expert evidence` FALSE FALSE EQUALS JUST FALSE -- neither opinion

-- Rule 3
#ASSERT `o 12 r 3(5) paragraph (5) applies to the proceedings` `Magistrate's Court` TRUE EQUALS TRUE -- a Magistrate's Court, simplified trial
#ASSERT `o 12 r 3(5) paragraph (5) applies to the proceedings` `District Court` TRUE EQUALS TRUE -- a District Court, simplified trial
#ASSERT `o 12 r 3(5) paragraph (5) applies to the proceedings` `District Court` FALSE EQUALS FALSE -- not directed to be set down for a simplified trial
#ASSERT `o 12 r 3(5) paragraph (5) applies to the proceedings` `General Division` TRUE EQUALS FALSE -- the General Division is not a Magistrate's Court or District Court
#ASSERT `o 12 r 3(5) paragraph (5) applies to the proceedings` `Appellate Division` TRUE EQUALS FALSE -- same
#ASSERT `o 12 r 3(5) paragraph (5) applies to the proceedings` `Court of Appeal` TRUE EQUALS FALSE -- same
#ASSERT `o 12 r 3(5) paragraph (5) applies to the proceedings` `Singapore International Commercial Court` TRUE EQUALS FALSE -- same
#ASSERT `o 12 r 3(5) paragraph (5) applies to the proceedings` `Family Division` TRUE EQUALS FALSE -- same
#ASSERT `o 12 r 3(5) paragraphs (1) to (4) apply to the proceedings` TRUE EQUALS JUST FALSE -- "Paragraphs (1) to (4) do not apply"
#ASSERT `o 12 r 3(5) paragraphs (1) to (4) apply to the proceedings` FALSE EQUALS NOTHING -- other proceedings: they apply of their own force
#ASSERT `o 12 r 3(1) the parties must agree on one common expert` FALSE TRUE EQUALS JUST TRUE -- paragraph (5) does not apply, possible
#ASSERT `o 12 r 3(1) the parties must agree on one common expert` FALSE FALSE EQUALS NOTHING -- "as far as possible": not possible
#ASSERT `o 12 r 3(1) the parties must agree on one common expert` TRUE TRUE EQUALS JUST FALSE -- "Subject to paragraph (5)"
#ASSERT `o 12 r 3(2) the party may rely on expert evidence from more than one expert for the issue` FALSE FALSE FALSE EQUALS JUST FALSE -- neither a special case nor approval
#ASSERT `o 12 r 3(2) the party may rely on expert evidence from more than one expert for the issue` FALSE TRUE FALSE EQUALS JUST FALSE -- a special case but no approval
#ASSERT `o 12 r 3(2) the party may rely on expert evidence from more than one expert for the issue` FALSE FALSE TRUE EQUALS JUST FALSE -- approval but not a special case
#ASSERT `o 12 r 3(2) the party may rely on expert evidence from more than one expert for the issue` FALSE TRUE TRUE EQUALS NOTHING -- both: the prohibition does not reach
#ASSERT `o 12 r 3(2) the party may rely on expert evidence from more than one expert for the issue` TRUE TRUE TRUE EQUALS JUST FALSE -- paragraph (5) takes paragraph (2) away
#ASSERT `o 12 r 3(3) the Court may appoint a court expert` FALSE TRUE `o 12 r 3(3) in addition to the parties' common expert` EQUALS JUST TRUE -- special case, in addition to
#ASSERT `o 12 r 3(3) the Court may appoint a court expert` FALSE TRUE `o 12 r 3(3) in place of the parties' common expert` EQUALS JUST TRUE -- in place of the common expert
#ASSERT `o 12 r 3(3) the Court may appoint a court expert` FALSE TRUE `o 12 r 3(3) in place of all the experts` EQUALS JUST TRUE -- in place of all the experts
#ASSERT `o 12 r 3(3) the Court may appoint a court expert` FALSE FALSE `o 12 r 3(3) in addition to the parties' common expert` EQUALS NOTHING -- not a special case
#ASSERT `o 12 r 3(3) the Court may appoint a court expert` TRUE TRUE `o 12 r 3(3) in addition to the parties' common expert` EQUALS JUST FALSE -- paragraph (5) takes paragraph (3) away
#ASSERT `o 12 r 3(4) the Court must give all appropriate directions on this matter` FALSE `o 12 r 3(4) the appointment of experts` EQUALS JUST TRUE -- the appointment
#ASSERT `o 12 r 3(4) the Court must give all appropriate directions on this matter` FALSE `o 12 r 3(4) the method of questioning in Court` EQUALS JUST TRUE -- the method of questioning
#ASSERT `o 12 r 3(4) the Court must give all appropriate directions on this matter` FALSE `o 12 r 3(4) the remuneration to be paid to the experts` EQUALS JUST TRUE -- the remuneration
#ASSERT `o 12 r 3(4) the Court must give all appropriate directions on this matter` TRUE `o 12 r 3(4) the appointment of experts` EQUALS JUST FALSE -- paragraph (5) takes paragraph (4) away
#ASSERT `o 12 r 3(5)(a) the parties must jointly appoint one independent expert to give the expert evidence in a written report` TRUE EQUALS JUST TRUE -- (a)
#ASSERT `o 12 r 3(5)(a) the parties must jointly appoint one independent expert to give the expert evidence in a written report` FALSE EQUALS NOTHING -- not within paragraph (5)
#ASSERT `o 12 r 3(5)(b)(i)(A) the Court must make such orders or give such directions in relation to the appointment of the expert as it deems fit` TRUE TRUE EQUALS JUST TRUE -- (b)(i)(A): the parties are unable to agree
#ASSERT `o 12 r 3(5)(b)(i)(A) the Court must make such orders or give such directions in relation to the appointment of the expert as it deems fit` TRUE FALSE EQUALS JUST FALSE -- the parties agree
#ASSERT `o 12 r 3(5)(b)(i)(A) the Court must make such orders or give such directions in relation to the appointment of the expert as it deems fit` FALSE TRUE EQUALS NOTHING -- not within paragraph (5)
#ASSERT `o 12 r 3(5)(b)(i)(B) the Court must fix the amount of remuneration payable to the expert` TRUE TRUE EQUALS JUST TRUE -- (b)(i)(B)
#ASSERT `o 12 r 3(5)(b)(i)(B) the Court must fix the amount of remuneration payable to the expert` TRUE FALSE EQUALS JUST FALSE -- the parties agree
#ASSERT `o 12 r 3(5)(b)(i)(B) the Court must fix the amount of remuneration payable to the expert` FALSE TRUE EQUALS NOTHING -- not within paragraph (5)
#ASSERT `o 12 r 3(5)(b)(ii) the parties are jointly and severally liable to pay the expert the amount of remuneration fixed by the Court` TRUE TRUE EQUALS JUST TRUE -- (b)(ii)
#ASSERT `o 12 r 3(5)(b)(ii) the parties are jointly and severally liable to pay the expert the amount of remuneration fixed by the Court` TRUE FALSE EQUALS JUST FALSE -- the parties agree
#ASSERT `o 12 r 3(5)(b)(ii) the parties are jointly and severally liable to pay the expert the amount of remuneration fixed by the Court` FALSE TRUE EQUALS NOTHING -- not within paragraph (5)
#ASSERT `o 12 r 3(6) paragraph (5)(b)(ii) affects the discretion of the Court to make that order` TRUE EQUALS JUST FALSE -- "does not affect the discretion"
#ASSERT `o 12 r 3(6) paragraph (5)(b)(ii) affects the discretion of the Court to make that order` FALSE EQUALS NOTHING -- some other order

-- Rule 4
#ASSERT `o 12 r 4(1) the parties have agreed on what paragraph (1) requires` TRUE TRUE EQUALS JUST TRUE -- the list of issues and the common set of facts
#ASSERT `o 12 r 4(1) the parties have agreed on what paragraph (1) requires` FALSE TRUE EQUALS JUST FALSE -- no agreed list of issues
#ASSERT `o 12 r 4(1) the parties have agreed on what paragraph (1) requires` TRUE FALSE EQUALS JUST FALSE -- no agreed common set of facts
#ASSERT `o 12 r 4(2) the list of issues and the common set of agreed or assumed facts are approved` TRUE EQUALS JUST TRUE -- approved by the Court
#ASSERT `o 12 r 4(2) the list of issues and the common set of agreed or assumed facts are approved` FALSE EQUALS JUST FALSE -- not approved
#ASSERT `o 12 r 4(2) the expert evidence is confined as required` FALSE TRUE TRUE EQUALS JUST TRUE -- confined to the approved issues, relies on the common set only
#ASSERT `o 12 r 4(2) the expert evidence is confined as required` FALSE FALSE TRUE EQUALS JUST FALSE -- not confined to the approved issues
#ASSERT `o 12 r 4(2) the expert evidence is confined as required` FALSE TRUE FALSE EQUALS JUST FALSE -- relies on other facts
#ASSERT `o 12 r 4(2) the expert evidence is confined as required` TRUE FALSE FALSE EQUALS NOTHING -- "unless the Court otherwise orders"
#ASSERT `o 12 r 4(3) the Court must decide the list of issues and the common set of agreed or assumed facts` TRUE EQUALS JUST TRUE -- no agreement
#ASSERT `o 12 r 4(3) the Court must decide the list of issues and the common set of agreed or assumed facts` FALSE EQUALS JUST FALSE -- there is an agreement
#ASSERT `o 12 r 4(4) the issue is expressed as required` TRUE TRUE EQUALS JUST TRUE -- possible and expressed as a yes or no question
#ASSERT `o 12 r 4(4) the issue is expressed as required` TRUE FALSE EQUALS JUST FALSE -- possible but not so expressed
#ASSERT `o 12 r 4(4) the issue is expressed as required` FALSE FALSE EQUALS NOTHING -- "As far as possible": not possible

-- Rule 5
#ASSERT `o 12 r 5(1) the expert evidence is given as required` TRUE TRUE EQUALS JUST TRUE -- signed and exhibited in the expert's affidavit
#ASSERT `o 12 r 5(1) the expert evidence is given as required` FALSE TRUE EQUALS JUST FALSE -- not signed
#ASSERT `o 12 r 5(1) the expert evidence is given as required` TRUE FALSE EQUALS JUST FALSE -- not exhibited in an affidavit made by the expert
#ASSERT `o 12 r 5(2)(a) the report includes the expert's qualifications` TRUE EQUALS JUST TRUE -- (a)
#ASSERT `o 12 r 5(2)(a) the report includes the expert's qualifications` FALSE EQUALS JUST FALSE -- (a) missing
#ASSERT `o 12 r 5(2)(b) the report includes the expert's statement of the expert's duty` TRUE EQUALS JUST TRUE -- (b)
#ASSERT `o 12 r 5(2)(b) the report includes the expert's statement of the expert's duty` FALSE EQUALS JUST FALSE -- (b) missing
#ASSERT `o 12 r 5(2)(c) the report includes the issues and the common set of facts` TRUE EQUALS JUST TRUE -- (c)
#ASSERT `o 12 r 5(2)(c) the report includes the issues and the common set of facts` FALSE EQUALS JUST FALSE -- (c) missing
#ASSERT `o 12 r 5(2)(d) the report includes a list of the materials relied on` TRUE TRUE EQUALS JUST TRUE -- (d)
#ASSERT `o 12 r 5(2)(d) the report includes a list of the materials relied on` FALSE TRUE EQUALS JUST FALSE -- no list
#ASSERT `o 12 r 5(2)(d) the report includes a list of the materials relied on` TRUE FALSE EQUALS JUST FALSE -- more than the necessary extracts
#ASSERT `o 12 r 5(2)(e) the report includes the names and qualifications of those who did the tests` TRUE TRUE TRUE EQUALS JUST TRUE -- (e) applies and is met
#ASSERT `o 12 r 5(2)(e) the report includes the names and qualifications of those who did the tests` TRUE FALSE TRUE EQUALS JUST FALSE -- (e) applies, names and qualifications missing
#ASSERT `o 12 r 5(2)(e) the report includes the names and qualifications of those who did the tests` TRUE TRUE FALSE EQUALS JUST FALSE -- (e) applies, supervision not stated
#ASSERT `o 12 r 5(2)(e) the report includes the names and qualifications of those who did the tests` FALSE FALSE FALSE EQUALS JUST TRUE -- the materials include no tests: (e) asks for nothing
#ASSERT `o 12 r 5(2)(f) the report includes a summary of the range of opinion and the reasons` TRUE TRUE TRUE EQUALS JUST TRUE -- (f)(i) and (ii)
#ASSERT `o 12 r 5(2)(f) the report includes a summary of the range of opinion and the reasons` TRUE FALSE TRUE EQUALS JUST FALSE -- (f)(i) missing
#ASSERT `o 12 r 5(2)(f) the report includes a summary of the range of opinion and the reasons` TRUE TRUE FALSE EQUALS JUST FALSE -- (f)(ii) missing
#ASSERT `o 12 r 5(2)(f) the report includes a summary of the range of opinion and the reasons` FALSE FALSE FALSE EQUALS JUST TRUE -- no range of opinion: (f) asks for nothing
#ASSERT `o 12 r 5(2)(g) the report includes a statement of belief of correctness` TRUE EQUALS JUST TRUE -- (g)
#ASSERT `o 12 r 5(2)(g) the report includes a statement of belief of correctness` FALSE EQUALS JUST FALSE -- (g) missing
#ASSERT `o 12 r 5(2)(h) the report includes the conclusions and the reasons` TRUE EQUALS JUST TRUE -- (h)
#ASSERT `o 12 r 5(2)(h) the report includes the conclusions and the reasons` FALSE EQUALS JUST FALSE -- (h) missing
#ASSERT `o 12 r 5(2) the expert's report includes what paragraph (2) requires` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE -- all eight limbs
#ASSERT `o 12 r 5(2) the expert's report includes what paragraph (2) requires` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE -- limb (h) missing
#ASSERT `o 12 r 5(2) the expert's report includes what paragraph (2) requires` (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE -- limb (a) missing
#ASSERT `o 12 r 5(2) the expert's report includes what paragraph (2) requires` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING -- a limb is not covered
#ASSERT `o 12 r 5(2) the expert's report includes what paragraph (2) requires` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE -- a limb is missing, another not covered: missing wins

-- Rule 6
#ASSERT `o 12 r 6(1) the Court may order the parties, their solicitors and the experts to meet` `o 12 r 6(1) before the making of the expert reports` TRUE EQUALS JUST TRUE -- before
#ASSERT `o 12 r 6(1) the Court may order the parties, their solicitors and the experts to meet` `o 12 r 6(1) during the making of the expert reports` TRUE EQUALS JUST TRUE -- during
#ASSERT `o 12 r 6(1) the Court may order the parties, their solicitors and the experts to meet` `o 12 r 6(1) after the making of the expert reports` TRUE EQUALS JUST TRUE -- after
#ASSERT `o 12 r 6(1) the Court may order the parties, their solicitors and the experts to meet` `o 12 r 6(1) after the making of the expert reports` FALSE EQUALS NOTHING -- for another purpose
#ASSERT `o 12 r 6(2) the content may be used in Court` FALSE TRUE FALSE EQUALS JUST FALSE -- discussions, no written agreement, the parties do not agree
#ASSERT `o 12 r 6(2) the content may be used in Court` TRUE TRUE FALSE EQUALS NOTHING -- "Other than the contents of any agreement in writing"
#ASSERT `o 12 r 6(2) the content may be used in Court` FALSE TRUE TRUE EQUALS NOTHING -- "unless the parties otherwise agree"
#ASSERT `o 12 r 6(2) the content may be used in Court` FALSE FALSE FALSE EQUALS NOTHING -- not the contents of discussions at such a meeting
#ASSERT `o 12 r 6(3) the parties may request the expert to clarify the report in any aspect` TRUE TRUE EQUALS JUST TRUE -- with the Court's approval, in writing
#ASSERT `o 12 r 6(3) the parties may request the expert to clarify the report in any aspect` FALSE TRUE EQUALS NOTHING -- no approval
#ASSERT `o 12 r 6(3) the parties may request the expert to clarify the report in any aspect` TRUE FALSE EQUALS NOTHING -- not in writing
#ASSERT `o 12 r 6(4) the expert must give the clarification in writing` TRUE EQUALS JUST TRUE -- upon receipt of a request
#ASSERT `o 12 r 6(4) the expert must give the clarification in writing` FALSE EQUALS JUST FALSE -- no request
#ASSERT `o 12 r 6(4) the expert gives the clarification in writing in time` TRUE (Date 14 6 2027) (Date 14 6 2027) EQUALS JUST TRUE -- in writing, on the last day
#ASSERT `o 12 r 6(4) the expert gives the clarification in writing in time` TRUE (Date 15 6 2027) (Date 14 6 2027) EQUALS JUST FALSE -- a day late
#ASSERT `o 12 r 6(4) the expert gives the clarification in writing in time` FALSE (Date 14 6 2027) (Date 14 6 2027) EQUALS JUST FALSE -- in time but not in writing
#ASSERT `o 12 r 6(4) the clarification is part of the expert's report` TRUE EQUALS JUST TRUE -- "deemed to be part of his or her report"
#ASSERT `o 12 r 6(4) the clarification is part of the expert's report` FALSE EQUALS NOTHING -- not a clarification given under paragraph (4)
#ASSERT `o 12 r 6(5) the parties have considered whether the experts need to be cross-examined` TRUE EQUALS JUST TRUE -- considered
#ASSERT `o 12 r 6(5) the parties have considered whether the experts need to be cross-examined` FALSE EQUALS JUST FALSE -- not considered

-- Rule 7
#ASSERT `o 12 r 7(1) the Court may order that all or some of the experts testify as a panel` TRUE EQUALS JUST TRUE -- more than one expert
#ASSERT `o 12 r 7(1) the Court may order that all or some of the experts testify as a panel` FALSE EQUALS JUST FALSE -- one expert: "where" fails
#ASSERT `o 12 r 7(2) the panel of experts may testify at this time` TRUE `o 12 r 7(2) before all or some of the non-expert witnesses have testified` EQUALS JUST TRUE -- before
#ASSERT `o 12 r 7(2) the panel of experts may testify at this time` TRUE `o 12 r 7(2) after all or some of the non-expert witnesses have testified` EQUALS JUST TRUE -- after
#ASSERT `o 12 r 7(2) the panel of experts may testify at this time` FALSE `o 12 r 7(2) after all or some of the non-expert witnesses have testified` EQUALS NOTHING -- no panel
#ASSERT `o 12 r 7(3) the defendant is deemed to have waived the right to submit that there is no case to answer at that stage` TRUE EQUALS JUST FALSE -- "not deemed to have waived"
#ASSERT `o 12 r 7(3) the defendant is deemed to have waived the right to submit that there is no case to answer at that stage` FALSE EQUALS NOTHING -- the paragraph does not reach this case
#ASSERT `o 12 r 7(4) the Court may order the experts to do this` TRUE `o 12 r 7(4) give their views on the issues referred to them` EQUALS JUST TRUE -- give views
#ASSERT `o 12 r 7(4) the Court may order the experts to do this` TRUE `o 12 r 7(4) comment on one another's views` EQUALS JUST TRUE -- comment
#ASSERT `o 12 r 7(4) the Court may order the experts to do this` FALSE `o 12 r 7(4) comment on one another's views` EQUALS JUST FALSE -- not a panel: "Where" fails
#ASSERT `o 12 r 7(5) the Court may order cross-examination and re-examination of all or some of the experts in the panel in any sequence` TRUE EQUALS JUST TRUE -- the experts in the panel
#ASSERT `o 12 r 7(5) the Court may order cross-examination and re-examination of all or some of the experts in the panel in any sequence` FALSE EQUALS NOTHING -- not in the panel
#ASSERT `o 12 r 7(6) the Court may give any other directions` TRUE EQUALS JUST TRUE -- appropriate for the particular case
#ASSERT `o 12 r 7(6) the Court may give any other directions` FALSE EQUALS NOTHING -- not appropriate
