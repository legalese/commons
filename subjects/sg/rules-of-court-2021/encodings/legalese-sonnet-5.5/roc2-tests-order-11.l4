IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc2-order-11`

-- Tests for Order 11 (roc2-order-11.l4).  Expected values are written from the text, beside the assertion.
-- One #ASSERT per line.  Made-up dates stand in for the answers of O 3 r 3 (roc1).

-- Rule 1
#ASSERT `o 11 r 1(1) this Order affects this` `o 11 r 1(1)(a) an agreement that the parties or any set of parties may make to broaden the scope of such obligations` EQUALS JUST FALSE -- "does not affect (a) any agreement"
#ASSERT `o 11 r 1(1) this Order affects this` `o 11 r 1(1)(b) the Court's power to allow a broader scope of discovery where it is in the interests of justice to do so` EQUALS JUST FALSE -- "does not affect ... (b) the Court's power"
#ASSERT `o 11 r 1(1) this Order affects this` `o 11 r 1(1) any other thing` EQUALS NOTHING -- the paragraph names (a) and (b) only by way of what it does not affect
#ASSERT `o 11 r 1(2) the Court must bear this principle in mind` TRUE FALSE `o 11 r 1(2) the Ideals` EQUALS JUST TRUE -- "in addition to the Ideals"
#ASSERT `o 11 r 1(2) the Court must bear this principle in mind` TRUE FALSE `o 11 r 1(2)(a) that a claimant is to sue and proceed on the strength of the claimant's case and not on the weakness of the defendant's case` EQUALS JUST TRUE -- (a)
#ASSERT `o 11 r 1(2) the Court must bear this principle in mind` TRUE FALSE `o 11 r 1(2)(b) that a party who sues or is sued in court does not thereby give up the party's right to privacy and confidentiality in the party's documents and communications` EQUALS JUST TRUE -- (b)
#ASSERT `o 11 r 1(2) the Court must bear this principle in mind` TRUE TRUE `o 11 r 1(2)(a) that a claimant is to sue and proceed on the strength of the claimant's case and not on the weakness of the defendant's case` EQUALS JUST FALSE -- paragraph (5): on an application for a broader scope, "paragraph (2) does not apply"
#ASSERT `o 11 r 1(2) the Court must bear this principle in mind` TRUE TRUE `o 11 r 1(2)(b) that a party who sues or is sued in court does not thereby give up the party's right to privacy and confidentiality in the party's documents and communications` EQUALS JUST FALSE -- same
#ASSERT `o 11 r 1(2) the Court must bear this principle in mind` TRUE TRUE `o 11 r 1(2) the Ideals` EQUALS JUST TRUE -- the Ideals remain
#ASSERT `o 11 r 1(2) the Court must bear this principle in mind` FALSE FALSE `o 11 r 1(2) the Ideals` EQUALS NOTHING -- not exercising its power in this Order
#ASSERT `o 11 r 1(3) the Court may allow a broader scope of discovery` TRUE EQUALS JUST TRUE -- the Court determines it is in the interests of justice
#ASSERT `o 11 r 1(3) the Court may allow a broader scope of discovery` FALSE EQUALS JUST FALSE -- "where" fails
#ASSERT `o 11 r 1(4) it will be in the interests of justice to allow a broader scope of discovery` TRUE EQUALS JUST TRUE -- it could aid in disposing fairly of the proceedings
#ASSERT `o 11 r 1(4) it will be in the interests of justice to allow a broader scope of discovery` FALSE EQUALS JUST FALSE -- "where" fails
#ASSERT `o 11 r 1(5) the Court must have regard to this on an application for a broader scope of discovery` TRUE `o 11 r 1(5) the Ideals` EQUALS JUST TRUE -- "only to the Ideals"
#ASSERT `o 11 r 1(5) the Court must have regard to this on an application for a broader scope of discovery` TRUE `o 11 r 1(5) paragraph (4)` EQUALS JUST TRUE -- "and to paragraph (4)"
#ASSERT `o 11 r 1(5) the Court must have regard to this on an application for a broader scope of discovery` TRUE `o 11 r 1(5) paragraph (2)` EQUALS JUST FALSE -- "paragraph (2) does not apply"
#ASSERT `o 11 r 1(5) the Court must have regard to this on an application for a broader scope of discovery` TRUE `o 11 r 1(5) any other consideration` EQUALS JUST FALSE -- "only"
#ASSERT `o 11 r 1(5) the Court must have regard to this on an application for a broader scope of discovery` FALSE `o 11 r 1(5) the Ideals` EQUALS JUST FALSE -- no application for a broader scope: "Where" fails

-- Rule 2
#ASSERT `o 11 r 2(1) the Court may order the parties to exchange a list of and a copy of the documents` TRUE EQUALS JUST TRUE -- at a case conference
#ASSERT `o 11 r 2(1) the Court may order the parties to exchange a list of and a copy of the documents` FALSE EQUALS NOTHING -- not at a case conference
#ASSERT `o 11 r 2(1) fourteen days after the date of the case conference`'s `period length` EQUALS 14 -- "within 14 days after the date of the case conference"
#ASSERT `o 11 r 2(1) the document falls within a category the order may cover` TRUE `o 11 r 2(1)(a) all documents that the party in question will be relying on` FALSE EQUALS JUST TRUE -- (a)
#ASSERT `o 11 r 2(1) the document falls within a category the order may cover` TRUE `o 11 r 2(1)(b) all known adverse documents` FALSE EQUALS JUST TRUE -- (b)
#ASSERT `o 11 r 2(1) the document falls within a category the order may cover` TRUE `o 11 r 2(1)(c)(i) documents within a broader scope of discovery as may be agreed between the parties or any set of parties` TRUE EQUALS JUST TRUE -- (c)(i), a broader scope applies
#ASSERT `o 11 r 2(1) the document falls within a category the order may cover` TRUE `o 11 r 2(1)(c)(ii) documents within a broader scope of discovery as ordered by the Court` TRUE EQUALS JUST TRUE -- (c)(ii), a broader scope applies
#ASSERT `o 11 r 2(1) the document falls within a category the order may cover` TRUE `o 11 r 2(1)(c)(i) documents within a broader scope of discovery as may be agreed between the parties or any set of parties` FALSE EQUALS JUST FALSE -- (c) "where applicable": it is not
#ASSERT `o 11 r 2(1) the document falls within a category the order may cover` TRUE `o 11 r 2(1)(c)(ii) documents within a broader scope of discovery as ordered by the Court` FALSE EQUALS JUST FALSE -- same
#ASSERT `o 11 r 2(1) the document falls within a category the order may cover` TRUE `o 11 r 2(1) any other document` TRUE EQUALS NOTHING -- not in a category
#ASSERT `o 11 r 2(1) the document falls within a category the order may cover` FALSE `o 11 r 2(1)(a) all documents that the party in question will be relying on` FALSE EQUALS JUST FALSE -- not in the party's possession or control
#ASSERT `o 11 r 2(1) the parties must exchange a list of and a copy of the documents` TRUE EQUALS JUST TRUE -- ordered at a case conference
#ASSERT `o 11 r 2(1) the parties must exchange a list of and a copy of the documents` FALSE EQUALS NOTHING -- no such order
#ASSERT `o 11 r 2(1) the parties exchange the list and the copies in time` (Date 14 6 2027) (Date 14 6 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `o 11 r 2(1) the parties exchange the list and the copies in time` (Date 15 6 2027) (Date 14 6 2027) EQUALS JUST FALSE -- a day late
#TRACE `o 11 r 2(1) each party must exchange a list of and a copy of the documents` AT 0 WITH
    PARTY `o 11 r 2(1) each party to the action` DOES `o 11 r 2(1) exchange a list of and a copy of the documents` AT 14
#TRACE `o 11 r 2(1) each party must exchange a list of and a copy of the documents` AT 0 WITH
    (WAITUNTIL 15)
#ASSERT `o 11 r 2(2) a document is a known adverse document` TRUE FALSE EQUALS JUST TRUE -- the party knows the document is adverse
#ASSERT `o 11 r 2(2) a document is a known adverse document` FALSE TRUE EQUALS JUST TRUE -- "ought reasonably to know"
#ASSERT `o 11 r 2(2) a document is a known adverse document` FALSE FALSE EQUALS NOTHING -- "includes": an open definition
#ASSERT `o 11 r 2(3) the copy is in a form allowed` TRUE FALSE FALSE EQUALS JUST TRUE -- paper form
#ASSERT `o 11 r 2(3) the copy is in a form allowed` FALSE TRUE TRUE EQUALS JUST TRUE -- electronic, in a common electronic format the other party can use
#ASSERT `o 11 r 2(3) the copy is in a form allowed` FALSE TRUE FALSE EQUALS JUST FALSE -- electronic, not in a common format
#ASSERT `o 11 r 2(4) it is necessary to exchange the document to comply with the order` TRUE EQUALS JUST FALSE -- "it is not necessary" for common documents
#ASSERT `o 11 r 2(4) it is necessary to exchange the document to comply with the order` FALSE EQUALS NOTHING -- not a common document: paragraph (1) decides
#ASSERT `o 11 r 2(5) the party may rely on the document` FALSE EQUALS JUST FALSE -- not exchanged or produced under this Order
#ASSERT `o 11 r 2(5) the party may rely on the document` TRUE EQUALS NOTHING -- exchanged or produced: the prohibition does not reach it

-- Rule 3
#ASSERT `o 11 r 3(1) the Court may order any party to produce the requested documents` TRUE TRUE TRUE EQUALS JUST TRUE -- possession or control, identified, material
#ASSERT `o 11 r 3(1) the Court may order any party to produce the requested documents` FALSE TRUE TRUE EQUALS JUST FALSE -- not in the party's possession or control
#ASSERT `o 11 r 3(1) the Court may order any party to produce the requested documents` TRUE FALSE TRUE EQUALS JUST FALSE -- not properly identified
#ASSERT `o 11 r 3(1) the Court may order any party to produce the requested documents` TRUE TRUE FALSE EQUALS JUST FALSE -- not shown to be material
#ASSERT `o 11 r 3(1) a document or class of documents is the requested documents` TRUE TRUE EQUALS JUST TRUE -- "(called the requested documents)"
#ASSERT `o 11 r 3(1) a document or class of documents is the requested documents` FALSE TRUE EQUALS JUST FALSE -- not specific
#ASSERT `o 11 r 3(1) a document or class of documents is the requested documents` TRUE FALSE EQUALS JUST FALSE -- no order
#ASSERT `o 11 r 3(2) the Court may order the party to file an affidavit stating this` TRUE `o 11 r 3(2) that the requested documents are not in the party's possession or control` FALSE EQUALS JUST TRUE -- "stating this"
#ASSERT `o 11 r 3(2) the Court may order the party to file an affidavit stating this` TRUE `o 11 r 3(2) whether that party had such possession or control previously` FALSE EQUALS JUST TRUE -- "whether that party had such possession or control previously"
#ASSERT `o 11 r 3(2) the Court may order the party to file an affidavit stating this` TRUE `o 11 r 3(2) when that party parted with possession or control` TRUE EQUALS JUST TRUE -- "if so, when"
#ASSERT `o 11 r 3(2) the Court may order the party to file an affidavit stating this` TRUE `o 11 r 3(2) what has become of the requested documents` TRUE EQUALS JUST TRUE -- "if so, what has become"
#ASSERT `o 11 r 3(2) the Court may order the party to file an affidavit stating this` TRUE `o 11 r 3(2) when that party parted with possession or control` FALSE EQUALS JUST FALSE -- never had possession: "and if so" is an "if" that fails, so JUST FALSE
#ASSERT `o 11 r 3(2) the Court may order the party to file an affidavit stating this` TRUE `o 11 r 3(2) what has become of the requested documents` FALSE EQUALS JUST FALSE -- same: an "if" that fails
#ASSERT `o 11 r 3(2) the Court may order the party to file an affidavit stating this` FALSE `o 11 r 3(2) that the requested documents are not in the party's possession or control` TRUE EQUALS JUST FALSE -- the documents are in the party's possession or control
#ASSERT `o 11 r 3 the Court may exercise its power under this Rule` FALSE TRUE FALSE EQUALS JUST FALSE -- affidavits ordered, parties have not complied, not a special case
#ASSERT `o 11 r 3 the Court may exercise its power under this Rule` FALSE TRUE TRUE EQUALS NOTHING -- the parties have complied
#ASSERT `o 11 r 3 the Court may exercise its power under this Rule` TRUE TRUE FALSE EQUALS NOTHING -- "Except in a special case"
#ASSERT `o 11 r 3 the Court may exercise its power under this Rule` FALSE FALSE FALSE EQUALS NOTHING -- no such order

-- Rules 4 and 5
#ASSERT `o 11 r 5(1) the Court may order production of the document` FALSE TRUE EQUALS JUST FALSE -- merely leads on a train of inquiry, not a special case
#ASSERT `o 11 r 5(1) the Court may order production of the document` TRUE TRUE EQUALS NOTHING -- a special case
#ASSERT `o 11 r 5(1) the Court may order production of the document` FALSE FALSE EQUALS NOTHING -- not such a document
#ASSERT `o 11 r 5(2) the Court may order the production of the document` TRUE FALSE FALSE EQUALS JUST FALSE -- private or internal correspondence, neither exception
#ASSERT `o 11 r 5(2) the Court may order the production of the document` TRUE TRUE FALSE EQUALS NOTHING -- (a) a special case
#ASSERT `o 11 r 5(2) the Court may order the production of the document` TRUE FALSE TRUE EQUALS NOTHING -- (b) known adverse documents
#ASSERT `o 11 r 5(2) the Court may order the production of the document` FALSE FALSE FALSE EQUALS NOTHING -- not correspondence
#ASSERT `o 11 r 5(3) the Court may order the production of the document` FALSE TRUE FALSE EQUALS JUST FALSE -- privileged
#ASSERT `o 11 r 5(3) the Court may order the production of the document` FALSE FALSE TRUE EQUALS JUST FALSE -- contrary to the public interest
#ASSERT `o 11 r 5(3) the Court may order the production of the document` TRUE TRUE FALSE EQUALS NOTHING -- "Subject to any written law"
#ASSERT `o 11 r 5(3) the Court may order the production of the document` FALSE FALSE FALSE EQUALS NOTHING -- neither
#ASSERT `o 11 r 5 the Court may order the production of the document` (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE -- paragraph (1) says no
#ASSERT `o 11 r 5 the Court may order the production of the document` NOTHING NOTHING (JUST FALSE) EQUALS JUST FALSE -- paragraph (3) says no
#ASSERT `o 11 r 5 the Court may order the production of the document` NOTHING NOTHING NOTHING EQUALS NOTHING -- none reaches the document
#ASSERT `o 11 r 4 the Court may order any party or non-party to produce a copy of the document` TRUE NOTHING NOTHING NOTHING EQUALS JUST TRUE -- in the person's possession or control, no bar
#ASSERT `o 11 r 4 the Court may order any party or non-party to produce a copy of the document` TRUE (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE -- Rule 5 says no
#ASSERT `o 11 r 4 the Court may order any party or non-party to produce a copy of the document` TRUE NOTHING (JUST FALSE) NOTHING EQUALS JUST FALSE -- Rule 8 says no
#ASSERT `o 11 r 4 the Court may order any party or non-party to produce a copy of the document` TRUE NOTHING NOTHING (JUST FALSE) EQUALS JUST FALSE -- Rule 9 says no
#ASSERT `o 11 r 4 the Court may order any party or non-party to produce a copy of the document` FALSE NOTHING NOTHING NOTHING EQUALS NOTHING -- not in the person's possession or control

-- Rules 6 and 7
#ASSERT `o 11 r 6 the party required to produce the documents remains under a duty to produce further documents` TRUE EQUALS JUST TRUE -- an order under Rule 2, 3 or 4
#ASSERT `o 11 r 6 the party required to produce the documents remains under a duty to produce further documents` FALSE EQUALS JUST FALSE -- "Where" fails
#ASSERT `o 11 r 6 fourteen days after the document comes into the party's possession or control`'s `period length` EQUALS 14 -- "within 14 days after"
#ASSERT `o 11 r 6 the party produces the document in time` (Date 14 6 2027) (Date 14 6 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `o 11 r 6 the party produces the document in time` (Date 15 6 2027) (Date 14 6 2027) EQUALS JUST FALSE -- a day late
#TRACE `o 11 r 6 the party required to produce must produce a document that comes into the party's possession or control` AT 0 WITH
    PARTY `o 11 r 6 the party required to produce the documents` DOES `o 11 r 6 produce the document` AT 14
#TRACE `o 11 r 6 the party required to produce must produce a document that comes into the party's possession or control` AT 0 WITH
    (WAITUNTIL 15)
#ASSERT `o 11 r 7 the Court may do this` TRUE `o 11 r 7(a) order that the action be dismissed or that the defence be struck out and judgment be entered accordingly` FALSE FALSE EQUALS JUST TRUE -- (a)
#ASSERT `o 11 r 7 the Court may do this` TRUE `o 11 r 7(b) draw an adverse inference or make any such order as the Court deems fit` FALSE FALSE EQUALS JUST TRUE -- (b)
#ASSERT `o 11 r 7 the Court may do this` TRUE `o 11 r 7(d) order that that party may not rely on any document that is within the scope of the order unless the Court approves` FALSE FALSE EQUALS JUST TRUE -- (d)
#ASSERT `o 11 r 7 the Court may do this` TRUE `o 11 r 7(c) punish that party for contempt of court` TRUE FALSE EQUALS JUST TRUE -- (c): served on the solicitor, the party does not show lack of notice
#ASSERT `o 11 r 7 the Court may do this` TRUE `o 11 r 7(c) punish that party for contempt of court` TRUE TRUE EQUALS JUST FALSE -- (c): the party shows it was not notified or did not know
#ASSERT `o 11 r 7 the Court may do this` TRUE `o 11 r 7(c) punish that party for contempt of court` FALSE FALSE EQUALS JUST FALSE -- (c): not served on the solicitor: "if the order has been served" is an "if" that fails, so JUST FALSE
#ASSERT `o 11 r 7 the Court may do this` FALSE `o 11 r 7(a) order that the action be dismissed or that the defence be struck out and judgment be entered accordingly` FALSE FALSE EQUALS JUST FALSE -- no failure to comply

-- Rules 8 to 10
#ASSERT `o 11 r 8(1) the document may be relied on` TRUE FALSE FALSE EQUALS JUST FALSE -- privileged, no consent, no approval
#ASSERT `o 11 r 8(1) the document may be relied on` TRUE TRUE FALSE EQUALS NOTHING -- the party entitled consents
#ASSERT `o 11 r 8(1) the document may be relied on` TRUE FALSE TRUE EQUALS NOTHING -- the Court approves
#ASSERT `o 11 r 8(1) the document may be relied on` FALSE FALSE FALSE EQUALS NOTHING -- never privileged
#ASSERT `o 11 r 8(2) the document loses its privilege or confidentiality` TRUE TRUE EQUALS JUST FALSE -- "does not lose its privilege or confidentiality even if"
#ASSERT `o 11 r 8(2) the document loses its privilege or confidentiality` TRUE FALSE EQUALS NOTHING -- not disclosed or taken inadvertently or unlawfully
#ASSERT `o 11 r 8(2) the document loses its privilege or confidentiality` FALSE TRUE EQUALS NOTHING -- not within paragraph (1)
#ASSERT `o 11 r 9(1) the party may withhold or object to the production of the document on this ground` TRUE TRUE EQUALS JUST FALSE -- required by an order, on the ground of confidentiality
#ASSERT `o 11 r 9(1) the party may withhold or object to the production of the document on this ground` TRUE FALSE EQUALS NOTHING -- some other ground
#ASSERT `o 11 r 9(1) the party may withhold or object to the production of the document on this ground` FALSE TRUE EQUALS NOTHING -- not required by an order under this Order
#ASSERT `o 11 r 9(2) the document loses its confidentiality` TRUE TRUE EQUALS JUST FALSE -- "does not lose its confidentiality even if"
#ASSERT `o 11 r 9(2) the document loses its confidentiality` TRUE FALSE EQUALS NOTHING -- not disclosed or taken inadvertently or unlawfully
#ASSERT `o 11 r 9(2) the document loses its confidentiality` FALSE TRUE EQUALS NOTHING -- not a confidential document
#ASSERT `o 11 r 10(1) the document may be relied on in other proceedings` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- produced, other proceedings, no consent, no approval
#ASSERT `o 11 r 10(1) the document may be relied on in other proceedings` TRUE TRUE TRUE FALSE EQUALS NOTHING -- the producing party consents
#ASSERT `o 11 r 10(1) the document may be relied on in other proceedings` TRUE TRUE FALSE TRUE EQUALS NOTHING -- the Court otherwise approves
#ASSERT `o 11 r 10(1) the document may be relied on in other proceedings` TRUE FALSE FALSE FALSE EQUALS NOTHING -- not to be relied on in other proceedings
#ASSERT `o 11 r 10(1) the document may be relied on in other proceedings` FALSE TRUE FALSE FALSE EQUALS NOTHING -- not produced under this Order or by compulsion of law
#ASSERT `o 11 r 10(2) the party may apply to the Court to prohibit the use of the documents for any other purpose` TRUE EQUALS JUST TRUE -- the party who used or produced the document
#ASSERT `o 11 r 10(2) the party may apply to the Court to prohibit the use of the documents for any other purpose` FALSE EQUALS NOTHING -- some other party

-- Rule 11
#ASSERT `o 11 r 11(1) the Court may order the production of documents and information` TRUE `o 11 r 11(1) to identify possible parties to any proceedings` FALSE TRUE EQUALS JUST TRUE -- before commencement or against a non-party, to identify possible parties
#ASSERT `o 11 r 11(1) the Court may order the production of documents and information` TRUE `o 11 r 11(1) to enable a party to trace the party's property` FALSE TRUE EQUALS JUST TRUE -- to trace property
#ASSERT `o 11 r 11(1) the Court may order the production of documents and information` TRUE `o 11 r 11(1) any other purpose` TRUE TRUE EQUALS JUST TRUE -- any other lawful purpose
#ASSERT `o 11 r 11(1) the Court may order the production of documents and information` TRUE `o 11 r 11(1) any other purpose` FALSE TRUE EQUALS NOTHING -- not a lawful purpose
#ASSERT `o 11 r 11(1) the Court may order the production of documents and information` TRUE `o 11 r 11(1) to identify possible parties to any proceedings` FALSE FALSE EQUALS JUST FALSE -- not in the interests of justice
#ASSERT `o 11 r 11(1) the Court may order the production of documents and information` FALSE `o 11 r 11(1) to identify possible parties to any proceedings` FALSE TRUE EQUALS NOTHING -- neither before commencement nor against a non-party
#ASSERT `o 11 r 11(2) the Court may order the document to be produced` TRUE EQUALS JUST FALSE -- production cannot be compelled in law
#ASSERT `o 11 r 11(2) the Court may order the document to be produced` FALSE EQUALS NOTHING -- it can
#ASSERT `o 11 r 11(3) the non-party is entitled to the costs` TRUE TRUE TRUE EQUALS JUST TRUE -- a non-party, costs arising out of such an application, reasonable
#ASSERT `o 11 r 11(3) the non-party is entitled to the costs` TRUE TRUE FALSE EQUALS NOTHING -- not reasonable
#ASSERT `o 11 r 11(3) the non-party is entitled to the costs` TRUE FALSE TRUE EQUALS NOTHING -- not arising out of such an application
#ASSERT `o 11 r 11(3) the non-party is entitled to the costs` FALSE TRUE TRUE EQUALS NOTHING -- a party

-- Rule 12
#ASSERT `o 11 r 12(1) the party who produced the document must arrange a time and place for the inspection` TRUE EQUALS JUST TRUE -- a party requests to inspect the original
#ASSERT `o 11 r 12(1) the party who produced the document must arrange a time and place for the inspection` FALSE EQUALS JUST FALSE -- no request
#ASSERT `o 11 r 12(1) the arrangement is as required` TRUE EQUALS JUST TRUE -- mutually convenient
#ASSERT `o 11 r 12(1) the arrangement is as required` FALSE EQUALS JUST FALSE -- not mutually convenient
#ASSERT `o 11 r 12(2) fourteen days after the request`'s `period length` EQUALS 14 -- "within 14 days after the request"
#ASSERT `o 11 r 12(2) the inspection takes place in time` FALSE (Date 14 6 2027) (Date 14 6 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `o 11 r 12(2) the inspection takes place in time` FALSE (Date 15 6 2027) (Date 14 6 2027) EQUALS JUST FALSE -- a day late, no other agreement
#ASSERT `o 11 r 12(2) the inspection takes place in time` TRUE (Date 15 6 2027) (Date 14 6 2027) EQUALS NOTHING -- the parties otherwise agree
#ASSERT `o 11 r 12(3) the requesting party may apply to the Court to compel the party to comply` TRUE EQUALS JUST TRUE -- the producing party fails to comply with paragraph (1) or (2)
#ASSERT `o 11 r 12(3) the requesting party may apply to the Court to compel the party to comply` FALSE EQUALS JUST FALSE -- no failure
