IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc11-order-59`

-- TESTS for Order 59 (proceedings by and against Government).  Every expected value is written from the text of the
-- rule, beside the assertion, before the code was run.  The "last day" inputs are made-up dates: the merged file
-- replaces them with calls to roc1's O 3 r 3 and O 6 r 6.

-- ---------------------------------------------------------------------------
§ `Order 59 rule 1 -- application and definitions`
-- ---------------------------------------------------------------------------
#ASSERT `o 59 r 1(1) these Rules apply to the proceedings` TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 1(1) these Rules apply to the proceedings` FALSE EQUALS NOTHING
#ASSERT `o 59 r 1(2) the Act` EQUALS "the Government Proceedings Act"
#ASSERT `o 59 r 1(2) a reference to a section is a reference to a section in the Act` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 59 r 1(2) a reference to a section is a reference to a section in the Act` FALSE FALSE EQUALS NOTHING
#ASSERT `o 59 r 1(2) a reference to a section is a reference to a section in the Act` TRUE TRUE EQUALS NOTHING
#ASSERT `o 59 r 1(2) "civil proceedings by the Government" the part of the Act that gives its meaning` EQUALS "Part III of the Act"
#ASSERT `o 59 r 1(2) "civil proceedings against the Government" the part of the Act that gives its meaning` EQUALS "Part III of the Act"
#ASSERT `o 59 r 1(2) "civil proceedings by or against the Government" the part of the Act that gives its meaning` EQUALS "Part III of the Act"
#ASSERT `o 59 r 1(2) "civil proceedings to which the Government is a party" the provision that gives its meaning` EQUALS "Part V of the Act, by virtue of section 2(3)"
-- "order" includes a judgment, decree, rule, award or declaration.
#ASSERT `o 59 r 1(2) "order" the thing is within the term` `o 59 r 1(2) a judgment` EQUALS JUST TRUE
#ASSERT `o 59 r 1(2) "order" the thing is within the term` `o 59 r 1(2) a decree` EQUALS JUST TRUE
#ASSERT `o 59 r 1(2) "order" the thing is within the term` `o 59 r 1(2) a rule` EQUALS JUST TRUE
#ASSERT `o 59 r 1(2) "order" the thing is within the term` `o 59 r 1(2) an award` EQUALS JUST TRUE
#ASSERT `o 59 r 1(2) "order" the thing is within the term` `o 59 r 1(2) a declaration` EQUALS JUST TRUE
#ASSERT `o 59 r 1(2) "order" the thing is within the term` `o 59 r 1(2) another kind of thing` EQUALS NOTHING
-- "order against the Government" means ...
#ASSERT `o 59 r 1(2) "order against the Government" the order is an order against the Government` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 1(2) "order against the Government" the order is an order against the Government` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 1(2) "order against the Government" the order is an order against the Government` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 1(2) "order against the Government" the order is an order against the Government` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 59 r 1(2) "order against the Government" the order is an order against the Government` TRUE FALSE FALSE EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§ `Order 59 rule 2 -- endorsement of claim`
-- ---------------------------------------------------------------------------
#ASSERT count (`o 59 r 2(1) the matters the endorsement has not yet stated` (`o 59 r 2(1) endorsement of claim` OF TRUE, TRUE, TRUE)) EQUALS 0
#ASSERT count (`o 59 r 2(1) the matters the endorsement has not yet stated` (`o 59 r 2(1) endorsement of claim` OF TRUE, FALSE, TRUE)) EQUALS 1
#ASSERT elem "the Government department concerned" (`o 59 r 2(1) the matters the endorsement has not yet stated` (`o 59 r 2(1) endorsement of claim` OF TRUE, FALSE, TRUE))
#ASSERT count (`o 59 r 2(1) the matters the endorsement has not yet stated` (`o 59 r 2(1) endorsement of claim` OF FALSE, FALSE, FALSE)) EQUALS 3
#ASSERT `o 59 r 2(1) the endorsement of claim states what the Rule requires` TRUE (`o 59 r 2(1) endorsement of claim` OF TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 59 r 2(1) the endorsement of claim states what the Rule requires` TRUE (`o 59 r 2(1) endorsement of claim` OF TRUE, TRUE, FALSE) EQUALS NOTHING
-- An originating claim that does not begin proceedings against the Government.
#ASSERT `o 59 r 2(1) the endorsement of claim states what the Rule requires` FALSE (`o 59 r 2(1) endorsement of claim` OF FALSE, FALSE, FALSE) EQUALS NOTHING
-- (2): the last day for filing a notice of intention to contest or not contest is 20 November 2026 (made up).
#ASSERT `o 59 r 2(2) the defendant may apply to the claimant by notice for a further and better statement` TRUE TRUE (Date 19 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `o 59 r 2(2) the defendant may apply to the claimant by notice for a further and better statement` TRUE TRUE (Date 20 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `o 59 r 2(2) the defendant may apply to the claimant by notice for a further and better statement` TRUE TRUE (Date 21 11 2026) (Date 20 11 2026) EQUALS JUST FALSE
-- The "If" is not met: not proceedings against the Government, or the defendant does not consider the statement insufficient.
#ASSERT `o 59 r 2(2) the defendant may apply to the claimant by notice for a further and better statement` FALSE TRUE (Date 19 11 2026) (Date 20 11 2026) EQUALS JUST FALSE
#ASSERT `o 59 r 2(2) the defendant may apply to the claimant by notice for a further and better statement` TRUE FALSE (Date 19 11 2026) (Date 20 11 2026) EQUALS JUST FALSE
-- (3): the time cannot yet expire.  Arguments: gave a notice; last day of 4 days after the written notification; last day of 4 days after the Court's decision; date asked about.
#ASSERT `o 59 r 2(3)(a) the period after the defendant's written notification`'s `period length` EQUALS 4
#ASSERT `o 59 r 2(3)(b) the period after the Court's decision`'s `period length` EQUALS 4
-- No notice given under the Rule: the "Where" is not met.
#ASSERT `o 59 r 2(3) the time for filing a notice of intention to contest or not contest cannot yet expire` FALSE NOTHING NOTHING (Date 21 11 2026) EQUALS JUST FALSE
-- Notice given, and neither event yet: the time does not expire.
#ASSERT `o 59 r 2(3) the time for filing a notice of intention to contest or not contest cannot yet expire` TRUE NOTHING NOTHING (Date 30 11 2026) EQUALS JUST TRUE
-- The defendant notified satisfaction; the 4 days end on 25 November 2026.
#ASSERT `o 59 r 2(3) the time for filing a notice of intention to contest or not contest cannot yet expire` TRUE (JUST (Date 25 11 2026)) NOTHING (Date 25 11 2026) EQUALS JUST TRUE
#ASSERT `o 59 r 2(3) the time for filing a notice of intention to contest or not contest cannot yet expire` TRUE (JUST (Date 25 11 2026)) NOTHING (Date 26 11 2026) EQUALS JUST FALSE
-- The Court decided; the 4 days end on 27 November 2026.
#ASSERT `o 59 r 2(3) the time for filing a notice of intention to contest or not contest cannot yet expire` TRUE NOTHING (JUST (Date 27 11 2026)) (Date 27 11 2026) EQUALS JUST TRUE
#ASSERT `o 59 r 2(3) the time for filing a notice of intention to contest or not contest cannot yet expire` TRUE NOTHING (JUST (Date 27 11 2026)) (Date 28 11 2026) EQUALS JUST FALSE
-- Both events: whichever comes first ends the bar (25 November 2026 against 27 November 2026).
#ASSERT `o 59 r 2(3) the time for filing a notice of intention to contest or not contest cannot yet expire` TRUE (JUST (Date 25 11 2026)) (JUST (Date 27 11 2026)) (Date 26 11 2026) EQUALS JUST FALSE
#ASSERT `o 59 r 2(3) the time for filing a notice of intention to contest or not contest cannot yet expire` TRUE (JUST (Date 27 11 2026)) (JUST (Date 25 11 2026)) (Date 26 11 2026) EQUALS JUST FALSE
#ASSERT `o 59 r 2(3) the time for filing a notice of intention to contest or not contest cannot yet expire` TRUE (JUST (Date 25 11 2026)) (JUST (Date 27 11 2026)) (Date 25 11 2026) EQUALS JUST TRUE
-- (3)(b): the claimant's summons is served at least 14 days before the return day; the last day is 4 December 2026 (made up).
#ASSERT `o 59 r 2(3)(b) the period for serving the summons before the return day`'s `period length` EQUALS 14
#ASSERT `o 59 r 2(3)(b) the claimant's application is made and served as the Rule requires` Summons TRUE (Date 4 12 2026) (Date 4 12 2026) EQUALS JUST TRUE
#ASSERT `o 59 r 2(3)(b) the claimant's application is made and served as the Rule requires` Summons TRUE (Date 5 12 2026) (Date 4 12 2026) EQUALS JUST FALSE
#ASSERT `o 59 r 2(3)(b) the claimant's application is made and served as the Rule requires` `Originating application` TRUE (Date 3 12 2026) (Date 4 12 2026) EQUALS NOTHING
#ASSERT `o 59 r 2(3)(b) the claimant's application is made and served as the Rule requires` Summons FALSE (Date 3 12 2026) (Date 4 12 2026) EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 59 rule 3 -- service on Government`
-- ---------------------------------------------------------------------------
#ASSERT `o 59 r 3(1) the provision applies to the service of the process` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 59 r 3(1) the provision applies to the service of the process` TRUE FALSE EQUALS NOTHING
#ASSERT `o 59 r 3(1) the provision applies to the service of the process` FALSE TRUE EQUALS NOTHING
#ASSERT `o 59 r 3(2) personal service on the Government is requisite` TRUE EQUALS JUST FALSE
#ASSERT `o 59 r 3(2) personal service on the Government is requisite` FALSE EQUALS NOTHING
#ASSERT `o 59 r 3(2) service on the Government is effected as the Rule requires` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 59 r 3(2) service on the Government is effected as the Rule requires` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 3(2) service on the Government is effected as the Rule requires` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `o 59 r 3(2) service on the Government is effected as the Rule requires` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `o 59 r 3(3) the provision applies to the service` TRUE "Order 7 rule 3" TRUE EQUALS JUST FALSE
#ASSERT `o 59 r 3(3) the provision applies to the service` TRUE "Order 7 rule 3" FALSE EQUALS JUST FALSE
#ASSERT `o 59 r 3(3) the provision applies to the service` TRUE "Order 7 rule 8" TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 3(3) the provision applies to the service` TRUE "Order 7 rule 8" FALSE EQUALS NOTHING
#ASSERT `o 59 r 3(3) the provision applies to the service` TRUE "Order 7 rule 4" TRUE EQUALS NOTHING
#ASSERT `o 59 r 3(3) the provision applies to the service` FALSE "Order 7 rule 3" TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 59 rule 4 -- counterclaim and set-off`
-- ---------------------------------------------------------------------------
#ASSERT `o 59 r 4(1) a person may make a counterclaim or plead a set-off` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 59 r 4(1) a person may make a counterclaim or plead a set-off` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 59 r 4(1) a person may make a counterclaim or plead a set-off` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `o 59 r 4(1) a person may make a counterclaim or plead a set-off` FALSE TRUE TRUE EQUALS NOTHING
-- (2): the requirement of permission.  Arguments: who; in whose name; subject matter relates to that department.
#ASSERT `o 59 r 4(2) the permission of the Court is required for the counterclaim or set-off` `o 59 r 4(2) the Government in proceedings against the Government` `o 59 r 4(2) a Government department` FALSE EQUALS JUST TRUE
#ASSERT `o 59 r 4(2) the permission of the Court is required for the counterclaim or set-off` `o 59 r 4(2) a person in proceedings by the Government` `o 59 r 4(2) a Government department` FALSE EQUALS JUST TRUE
#ASSERT `o 59 r 4(2) the permission of the Court is required for the counterclaim or set-off` `o 59 r 4(2) a person in proceedings by the Government` `o 59 r 4(2) a Government department` TRUE EQUALS JUST FALSE
#ASSERT `o 59 r 4(2) the permission of the Court is required for the counterclaim or set-off` `o 59 r 4(2) the Government in proceedings against the Government` `o 59 r 4(2) the Attorney-General` TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 4(2) the permission of the Court is required for the counterclaim or set-off` `o 59 r 4(2) a person in proceedings by the Government` `o 59 r 4(2) the Attorney-General` FALSE EQUALS JUST TRUE
#ASSERT `o 59 r 4(2) the permission of the Court is required for the counterclaim or set-off` `o 59 r 4(2) a person in proceedings by the Government` `o 59 r 4(2) another name` FALSE EQUALS JUST FALSE
-- Neither the Government in proceedings against it nor a person in proceedings by it.
#ASSERT `o 59 r 4(2) the permission of the Court is required for the counterclaim or set-off` `o 59 r 4(2) someone else` `o 59 r 4(2) the Attorney-General` FALSE EQUALS NOTHING
-- The permission question (QA): permission is required and not given: barred; given: a lifted bar grants nothing.
#ASSERT `o 59 r 4(2) the counterclaim may be made or the set-off pleaded` `o 59 r 4(2) a person in proceedings by the Government` `o 59 r 4(2) the Attorney-General` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 59 r 4(2) the counterclaim may be made or the set-off pleaded` `o 59 r 4(2) a person in proceedings by the Government` `o 59 r 4(2) the Attorney-General` FALSE TRUE EQUALS NOTHING
-- The bar does not arise (the subject matter relates to the department): nothing is said either way.
#ASSERT `o 59 r 4(2) the counterclaim may be made or the set-off pleaded` `o 59 r 4(2) a person in proceedings by the Government` `o 59 r 4(2) a Government department` TRUE FALSE EQUALS NOTHING
#ASSERT `o 59 r 4(3) the application for permission is made as the Rule requires` TRUE Summons EQUALS JUST TRUE
#ASSERT `o 59 r 4(3) the application for permission is made as the Rule requires` TRUE `Originating application` EQUALS NOTHING
#ASSERT `o 59 r 4(3) the application for permission is made as the Rule requires` FALSE Summons EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 59 rule 5 -- summary judgment`
-- ---------------------------------------------------------------------------
#ASSERT `o 59 r 5(1) an application against the Government may be made under the provision` `o 59 r 5(1) proceedings against the Government` "Order 9 rule 17" EQUALS JUST FALSE
#ASSERT `o 59 r 5(1) an application against the Government may be made under the provision` `o 59 r 5(1) proceedings against the Government` "Order 9 rule 19" EQUALS JUST FALSE
#ASSERT `o 59 r 5(1) an application against the Government may be made under the provision` `o 59 r 5(1) proceedings against the Government` "Order 9 rule 17(11)" EQUALS NOTHING
#ASSERT `o 59 r 5(1) an application against the Government may be made under the provision` `o 59 r 5(1) proceedings by the Government` "Order 9 rule 17(11)" EQUALS JUST FALSE
#ASSERT `o 59 r 5(1) an application against the Government may be made under the provision` `o 59 r 5(1) proceedings by the Government` "Order 9 rule 19" EQUALS JUST FALSE
#ASSERT `o 59 r 5(1) an application against the Government may be made under the provision` `o 59 r 5(1) proceedings by the Government` "Order 9 rule 17" EQUALS NOTHING
#ASSERT `o 59 r 5(2) the affidavit in support is made by a person the Rule allows` TRUE `o 59 r 5(2)(a) the solicitor acting for the Government` EQUALS JUST TRUE
#ASSERT `o 59 r 5(2) the affidavit in support is made by a person the Rule allows` TRUE `o 59 r 5(2)(b) an officer duly authorised by the solicitor so acting` EQUALS JUST TRUE
#ASSERT `o 59 r 5(2) the affidavit in support is made by a person the Rule allows` TRUE `o 59 r 5(2)(b) an officer duly authorised by the department concerned` EQUALS JUST TRUE
#ASSERT `o 59 r 5(2) the affidavit in support is made by a person the Rule allows` TRUE `o 59 r 5(2) someone else` EQUALS NOTHING
#ASSERT `o 59 r 5(2) the affidavit in support is made by a person the Rule allows` FALSE `o 59 r 5(2)(a) the solicitor acting for the Government` EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 59 rule 6 -- revenue matters`
-- ---------------------------------------------------------------------------
#ASSERT `o 59 r 6(1) this Rule applies to the application` TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 6(1) this Rule applies to the application` FALSE EQUALS NOTHING
#ASSERT `o 59 r 6(2) the application is made as the Rule requires` TRUE `Originating application` EQUALS JUST TRUE
#ASSERT `o 59 r 6(2) the application is made as the Rule requires` TRUE Summons EQUALS NOTHING
#ASSERT `o 59 r 6(2) the application is made as the Rule requires` FALSE `Originating application` EQUALS NOTHING
#ASSERT `o 59 r 6(3) the person is made defendant as the Rule requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 6(3) the person is made defendant as the Rule requires` TRUE FALSE EQUALS NOTHING
#ASSERT `o 59 r 6(3) the person is made defendant as the Rule requires` FALSE FALSE EQUALS NOTHING
-- (4): fields (a) matter; (a) the Act; (b) written law; (b) information claimed; (b) shows what information.
#ASSERT count (`o 59 r 6(4) the matters the originating application has not yet satisfied` (`o 59 r 6(4) originating application` OF TRUE, TRUE, TRUE, TRUE, TRUE)) EQUALS 0
#ASSERT count (`o 59 r 6(4) the matters the originating application has not yet satisfied` (`o 59 r 6(4) originating application` OF TRUE, TRUE, TRUE, FALSE, FALSE)) EQUALS 0
#ASSERT count (`o 59 r 6(4) the matters the originating application has not yet satisfied` (`o 59 r 6(4) originating application` OF TRUE, FALSE, TRUE, TRUE, FALSE)) EQUALS 2
#ASSERT elem "(b) where information is claimed, show (by appropriate questions or otherwise) what information is required" (`o 59 r 6(4) the matters the originating application has not yet satisfied` (`o 59 r 6(4) originating application` OF TRUE, FALSE, TRUE, TRUE, FALSE))
#ASSERT count (`o 59 r 6(4) the matters the originating application has not yet satisfied` (`o 59 r 6(4) originating application` OF FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 3
#ASSERT `o 59 r 6(4) the originating application is what the Rule requires` TRUE (`o 59 r 6(4) originating application` OF TRUE, TRUE, TRUE, FALSE, FALSE) EQUALS JUST TRUE
#ASSERT `o 59 r 6(4) the originating application is what the Rule requires` TRUE (`o 59 r 6(4) originating application` OF TRUE, TRUE, FALSE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `o 59 r 6(4) the originating application is what the Rule requires` FALSE (`o 59 r 6(4) originating application` OF TRUE, TRUE, TRUE, FALSE, FALSE) EQUALS NOTHING
-- (5): the officer's affidavit.
#ASSERT `o 59 r 6(5) the affidavit is evidence of those facts` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 6(5) the affidavit is evidence of those facts` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `o 59 r 6(5) the affidavit is evidence of those facts` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `o 59 r 6(5) the affidavit is evidence of those facts` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 59 r 6(5) the affidavit is evidence of those facts` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `o 59 r 6(5) the course is open` `o 59 r 6(5) further evidence is filed` TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 6(5) the course is open` `o 59 r 6(5) the Court decides the matter upon the affidavits` TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 6(5) the course is open` `o 59 r 6(5) the Court directs that the matter be decided by oral evidence in Court` TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 6(5) the course is open` `o 59 r 6(5) further evidence is filed` FALSE EQUALS JUST FALSE
-- (6): the order names a time unless the Court otherwise determines.
#ASSERT `o 59 r 6(6) the duty to name a time for compliance with each term arises` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 59 r 6(6) the duty to name a time for compliance with each term arises` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 59 r 6(6) the duty to name a time for compliance with each term arises` FALSE FALSE EQUALS NOTHING
#ASSERT `o 59 r 6(6) the order names a time as the Rule requires` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 59 r 6(6) the order names a time as the Rule requires` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `o 59 r 6(6) the order names a time as the Rule requires` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 59 r 6(7) this Rule requires the Government to proceed by way of an application under it` TRUE EQUALS JUST FALSE
#ASSERT `o 59 r 6(7) this Rule requires the Government to proceed by way of an application under it` FALSE EQUALS NOTHING
#ASSERT `o 59 r 6(7) this Rule prevents the Government from availing itself of another procedure open under these Rules` TRUE EQUALS JUST FALSE
#ASSERT `o 59 r 6(7) this Rule prevents the Government from availing itself of another procedure open under these Rules` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 59 rule 7 -- judgment in default`
-- ---------------------------------------------------------------------------
-- Arguments: kind of default; the proceedings; the Court has given permission.
#ASSERT `o 59 r 7(1) judgment in default is barred without permission` `o 59 r 7(1) default of notice of intention to contest or not contest` `o 59 r 7(1) civil proceedings against the Government` FALSE EQUALS JUST TRUE
#ASSERT `o 59 r 7(1) judgment in default is barred without permission` `o 59 r 7(1) default of pleading` `o 59 r 7(1) third party proceedings against the Government` FALSE EQUALS JUST TRUE
#ASSERT `o 59 r 7(1) judgment in default is barred without permission` `o 59 r 7(1) default of pleading` `o 59 r 7(1) civil proceedings against the Government` TRUE EQUALS JUST FALSE
#ASSERT `o 59 r 7(1) judgment in default is barred without permission` `o 59 r 7(1) another kind of default` `o 59 r 7(1) civil proceedings against the Government` FALSE EQUALS NOTHING
#ASSERT `o 59 r 7(1) judgment in default is barred without permission` `o 59 r 7(1) default of pleading` `o 59 r 7(1) other proceedings` FALSE EQUALS NOTHING
#ASSERT `o 59 r 7(1) judgment in default may be entered against the Government` `o 59 r 7(1) default of pleading` `o 59 r 7(1) civil proceedings against the Government` FALSE EQUALS JUST FALSE
-- Permission given: a lifted bar grants nothing (QA).
#ASSERT `o 59 r 7(1) judgment in default may be entered against the Government` `o 59 r 7(1) default of pleading` `o 59 r 7(1) civil proceedings against the Government` TRUE EQUALS NOTHING
#ASSERT `o 59 r 7(1) judgment in default may be entered against the Government` `o 59 r 7(1) default of pleading` `o 59 r 7(1) other proceedings` FALSE EQUALS NOTHING
-- (2).
#ASSERT `o 59 r 7(2) Order 10 rule 5(1)(a) applies` `o 59 r 7(1) third party proceedings against the Government` FALSE EQUALS JUST FALSE
#ASSERT `o 59 r 7(2) Order 10 rule 5(1)(a) applies` `o 59 r 7(1) third party proceedings against the Government` TRUE EQUALS NOTHING
#ASSERT `o 59 r 7(2) Order 10 rule 5(1)(a) applies` `o 59 r 7(1) civil proceedings against the Government` FALSE EQUALS NOTHING
-- (3): the last day for serving the summons is 4 December 2026 (made up).
#ASSERT `o 59 r 7(3) the period for serving the summons before the return day`'s `period length` EQUALS 14
#ASSERT `o 59 r 7(3) the application for permission is made and served as the Rule requires` TRUE Summons (Date 4 12 2026) (Date 4 12 2026) EQUALS JUST TRUE
#ASSERT `o 59 r 7(3) the application for permission is made and served as the Rule requires` TRUE Summons (Date 5 12 2026) (Date 4 12 2026) EQUALS JUST FALSE
#ASSERT `o 59 r 7(3) the application for permission is made and served as the Rule requires` TRUE `Originating application` (Date 3 12 2026) (Date 4 12 2026) EQUALS NOTHING
#ASSERT `o 59 r 7(3) the application for permission is made and served as the Rule requires` FALSE Summons (Date 3 12 2026) (Date 4 12 2026) EQUALS NOTHING

