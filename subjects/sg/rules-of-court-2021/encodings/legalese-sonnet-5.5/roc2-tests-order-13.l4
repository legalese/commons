IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc2-order-13`

-- Tests for Order 13 (roc2-order-13.l4).  Expected values are written from the text, beside the assertion.
-- One #ASSERT per line.  Made-up dates stand in for the answers of O 3 r 3 (roc1).

-- Rule 1
#ASSERT `o 13 r 1(1) a party may apply for an injunction or a search order` TRUE TRUE EQUALS JUST TRUE -- the claim was included in the originating process
#ASSERT `o 13 r 1(1) a party may apply for an injunction or a search order` TRUE FALSE EQUALS JUST TRUE -- "whether or not": not included
#ASSERT `o 13 r 1(1) a party may apply for an injunction or a search order` FALSE TRUE EQUALS NOTHING -- not an application for an injunction or a search order
#ASSERT `o 13 r 1(2) the claimant may apply for an injunction or a search order before the originating process is issued` TRUE EQUALS JUST TRUE -- an urgent case
#ASSERT `o 13 r 1(2) the claimant may apply for an injunction or a search order before the originating process is issued` FALSE EQUALS NOTHING -- not an urgent case: the Rule does not say
#ASSERT `o 13 r 1(3) the application may be made in this way` `o 13 r 1(3) an originating application without notice` EQUALS JUST TRUE -- originating application without notice
#ASSERT `o 13 r 1(3) the application may be made in this way` `o 13 r 1(3) a summons without notice` EQUALS JUST TRUE -- summons without notice
#ASSERT `o 13 r 1(3) the application may be made in this way` `o 13 r 1(3) any other way` EQUALS NOTHING -- not closed
#ASSERT `o 13 r 1(3) the affidavit supports the application as paragraph (3) describes` TRUE TRUE TRUE EQUALS JUST TRUE -- urgency, why the defendant should not be informed, the merits
#ASSERT `o 13 r 1(3) the affidavit supports the application as paragraph (3) describes` FALSE TRUE TRUE EQUALS NOTHING -- no urgency stated
#ASSERT `o 13 r 1(3) the affidavit supports the application as paragraph (3) describes` TRUE FALSE TRUE EQUALS NOTHING -- no explanation why the defendant should not be informed
#ASSERT `o 13 r 1(3) the affidavit supports the application as paragraph (3) describes` TRUE TRUE FALSE EQUALS NOTHING -- no merits
#ASSERT `o 13 r 1(4) the Court may order the claimant not to serve the injunction or the search order on anyone until after the originating process is issued` TRUE EQUALS JUST TRUE -- the claimant's injunction or search order
#ASSERT `o 13 r 1(4) the Court may order the claimant not to serve the injunction or the search order on anyone until after the originating process is issued` FALSE EQUALS NOTHING -- some other order
#ASSERT `o 13 r 1(5) the party has the duty to disclose the fact to the Court` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- material, known
#ASSERT `o 13 r 1(5) the party has the duty to disclose the fact to the Court` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- material, reasonably ought to know
#ASSERT `o 13 r 1(5) the party has the duty to disclose the fact to the Court` TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE -- adverse to the merits, known
#ASSERT `o 13 r 1(5) the party has the duty to disclose the fact to the Court` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING -- material but neither known nor ought to be known
#ASSERT `o 13 r 1(5) the party has the duty to disclose the fact to the Court` TRUE FALSE FALSE TRUE TRUE EQUALS NOTHING -- neither material nor adverse
#ASSERT `o 13 r 1(5) the party has the duty to disclose the fact to the Court` FALSE TRUE FALSE TRUE TRUE EQUALS NOTHING -- not applying for an injunction or a search order
#ASSERT `o 13 r 1(6) the local injunction is in the form required` TRUE `o 13 r 1 Form 24` EQUALS JUST TRUE -- Form 24
#ASSERT `o 13 r 1(6) the local injunction is in the form required` TRUE `o 13 r 1 Form 25` EQUALS JUST FALSE -- Form 25 is the worldwide form
#ASSERT `o 13 r 1(6) the local injunction is in the form required` TRUE `o 13 r 1 another form` EQUALS JUST FALSE -- another form
#ASSERT `o 13 r 1(6) the local injunction is in the form required` FALSE `o 13 r 1 Form 25` EQUALS NOTHING -- not a local injunction
#ASSERT `o 13 r 1(7) the worldwide injunction is in the form required` TRUE `o 13 r 1 Form 25` EQUALS JUST TRUE -- Form 25
#ASSERT `o 13 r 1(7) the worldwide injunction is in the form required` TRUE `o 13 r 1 Form 24` EQUALS JUST FALSE -- Form 24 is the local form
#ASSERT `o 13 r 1(7) the worldwide injunction is in the form required` FALSE `o 13 r 1 Form 24` EQUALS NOTHING -- not a worldwide injunction
#ASSERT `o 13 r 1(8) the search order is in the form required` TRUE `o 13 r 1 Form 26` EQUALS JUST TRUE -- Form 26
#ASSERT `o 13 r 1(8) the search order is in the form required` TRUE `o 13 r 1 Form 24` EQUALS JUST FALSE -- Form 24
#ASSERT `o 13 r 1(8) the search order is in the form required` FALSE `o 13 r 1 Form 26` EQUALS NOTHING -- not a search order

-- Rules 2 to 4
#ASSERT `o 13 r 2(1) the Court may order this` TRUE `o 13 r 2(1) the detention of the property` EQUALS JUST TRUE -- detention
#ASSERT `o 13 r 2(1) the Court may order this` TRUE `o 13 r 2(1) the custody of the property` EQUALS JUST TRUE -- custody
#ASSERT `o 13 r 2(1) the Court may order this` TRUE `o 13 r 2(1) the preservation of the property` EQUALS JUST TRUE -- preservation
#ASSERT `o 13 r 2(1) the Court may order this` FALSE `o 13 r 2(1) the preservation of the property` EQUALS NOTHING -- not property that is the subject matter
#ASSERT `o 13 r 2(2) the Court may order the inspection of the property` TRUE TRUE EQUALS JUST TRUE -- in the possession or control of a party
#ASSERT `o 13 r 2(2) the Court may order the inspection of the property` TRUE FALSE EQUALS NOTHING -- not in a party's possession or control
#ASSERT `o 13 r 2(2) the Court may order the inspection of the property` FALSE TRUE EQUALS NOTHING -- not such property
#ASSERT `o 13 r 2(3) the Court may authorise a person to enter upon the property` TRUE TRUE EQUALS JUST TRUE -- immovable property of a party, to effect an order under paragraph (1) or (2)
#ASSERT `o 13 r 2(3) the Court may authorise a person to enter upon the property` TRUE FALSE EQUALS NOTHING -- not to effect such an order
#ASSERT `o 13 r 2(3) the Court may authorise a person to enter upon the property` FALSE TRUE EQUALS NOTHING -- not immovable property of a party
#ASSERT `o 13 r 2(4) the Court may order the fund to be dealt with in this way` TRUE `o 13 r 2(4) paid into Court` EQUALS JUST TRUE -- paid into Court
#ASSERT `o 13 r 2(4) the Court may order the fund to be dealt with in this way` TRUE `o 13 r 2(4) otherwise secured` EQUALS JUST TRUE -- otherwise secured
#ASSERT `o 13 r 2(4) the Court may order the fund to be dealt with in this way` FALSE `o 13 r 2(4) paid into Court` EQUALS JUST FALSE -- no dispute: "Where" fails
#ASSERT `o 13 r 3(1) the Court may order this` TRUE `o 13 r 3(1)(a) any sample of the property to be taken` EQUALS JUST TRUE -- (a)
#ASSERT `o 13 r 3(1) the Court may order this` TRUE `o 13 r 3(1)(b) any experiment or examination to be conducted on the sample` EQUALS JUST TRUE -- (b)
#ASSERT `o 13 r 3(1) the Court may order this` FALSE `o 13 r 3(1)(a) any sample of the property to be taken` EQUALS JUST FALSE -- "If any property is the subject matter" fails
#ASSERT `o 13 r 3(2) the Court may authorise a person to enter upon the property` TRUE TRUE EQUALS JUST TRUE -- immovable property of a party, to effect an order in paragraph (1)
#ASSERT `o 13 r 3(2) the Court may authorise a person to enter upon the property` TRUE FALSE EQUALS NOTHING -- not to effect such an order
#ASSERT `o 13 r 4(1) the Court may order the sale of the property` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- (a) perishable
#ASSERT `o 13 r 4(1) the Court may order the sale of the property` TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- (b) likely to diminish in value
#ASSERT `o 13 r 4(1) the Court may order the sale of the property` TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- (c) desirable for any other reason
#ASSERT `o 13 r 4(1) the Court may order the sale of the property` TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- none of (a), (b), (c)
#ASSERT `o 13 r 4(1) the Court may order the sale of the property` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- not movable property which is the subject matter
#ASSERT `o 13 r 4(2) Order 22 applies to the sale with the necessary modifications` TRUE EQUALS JUST TRUE -- a sale of movable property under this Rule
#ASSERT `o 13 r 4(2) Order 22 applies to the sale with the necessary modifications` FALSE EQUALS NOTHING -- some other sale

-- Rules 5 to 7
#ASSERT `o 13 r 5(b) the amount the claimant must pay into Court or secure` 100 150 EQUALS 100 -- the property is worth less: "whichever is the lower"
#ASSERT `o 13 r 5(b) the amount the claimant must pay into Court or secure` 150 100 EQUALS 100 -- the claim is worth less
#ASSERT `o 13 r 5(b) the amount the claimant must pay into Court or secure` 100 100 EQUALS 100 -- equal
#ASSERT `o 13 r 5 the Court may order the property to be handed over or transferred to the claimant before trial` TRUE TRUE 100 100 EQUALS JUST TRUE -- title not in dispute, pays the lower amount
#ASSERT `o 13 r 5 the Court may order the property to be handed over or transferred to the claimant before trial` TRUE TRUE 150 100 EQUALS JUST TRUE -- pays more than required
#ASSERT `o 13 r 5 the Court may order the property to be handed over or transferred to the claimant before trial` TRUE TRUE 99 100 EQUALS JUST FALSE -- short by 1
#ASSERT `o 13 r 5 the Court may order the property to be handed over or transferred to the claimant before trial` TRUE FALSE 100 100 EQUALS JUST FALSE -- title is in dispute
#ASSERT `o 13 r 5 the Court may order the property to be handed over or transferred to the claimant before trial` FALSE TRUE 100 100 EQUALS JUST FALSE -- not a claim for the recovery of property held as security
#ASSERT `o 13 r 6 the Court may order this` TRUE `o 13 r 6(a) the property be used for that purpose before the trial or hearing and the income be kept in an account or be distributed or used for any appropriate purpose` FALSE EQUALS JUST TRUE -- (a)
#ASSERT `o 13 r 6 the Court may order this` TRUE `o 13 r 6(b) any part of any movable property be transferred or delivered to all or any of the parties who have an interest in the property` TRUE EQUALS JUST TRUE -- (b), movable property
#ASSERT `o 13 r 6 the Court may order this` TRUE `o 13 r 6(b) any part of any movable property be transferred or delivered to all or any of the parties who have an interest in the property` FALSE EQUALS NOTHING -- (b), not movable property
#ASSERT `o 13 r 6 the Court may order this` FALSE `o 13 r 6(a) the property be used for that purpose before the trial or hearing and the income be kept in an account or be distributed or used for any appropriate purpose` TRUE EQUALS JUST FALSE -- property not capable of generating income: "Where" fails
#ASSERT `o 13 r 7(1) the Court may order the immovable property to be sold or dealt with in any manner that is appropriate before the trial or hearing` TRUE EQUALS JUST TRUE -- immovable property in issue
#ASSERT `o 13 r 7(1) the Court may order the immovable property to be sold or dealt with in any manner that is appropriate before the trial or hearing` FALSE EQUALS JUST FALSE -- "Where" fails
#ASSERT `o 13 r 7(2) the Court may give directions on this matter` TRUE `o 13 r 7(2)(a) the valuation of the immovable property` EQUALS JUST TRUE -- (a)
#ASSERT `o 13 r 7(2) the Court may give directions on this matter` TRUE `o 13 r 7(2)(b) the minimum price and terms of sale` EQUALS JUST TRUE -- (b)
#ASSERT `o 13 r 7(2) the Court may give directions on this matter` TRUE `o 13 r 7(2)(c) the method of sale` EQUALS JUST TRUE -- (c)
#ASSERT `o 13 r 7(2) the Court may give directions on this matter` TRUE `o 13 r 7(2)(d) the appointment and remuneration of a sales agent` EQUALS JUST TRUE -- (d)
#ASSERT `o 13 r 7(2) the Court may give directions on this matter` TRUE `o 13 r 7(2)(e) the appointment and remuneration of an advocate and solicitor to effect the sale and transfer of title or to deal with the property in any other manner` EQUALS JUST TRUE -- (e)
#ASSERT `o 13 r 7(2) the Court may give directions on this matter` FALSE `o 13 r 7(2)(c) the method of sale` EQUALS NOTHING -- no immovable property in issue
#ASSERT `o 13 r 7(3) Order 22 applies to the sale with the necessary modifications` TRUE EQUALS JUST TRUE -- a sale of immovable property under this Rule
#ASSERT `o 13 r 7(3) Order 22 applies to the sale with the necessary modifications` FALSE EQUALS NOTHING -- some other sale

-- Rule 8
#ASSERT `o 13 r 8(1) a payment is an interim payment` TRUE TRUE FALSE EQUALS JUST TRUE -- before trial, on account of an amount the defendant may be held liable to pay, not costs
#ASSERT `o 13 r 8(1) a payment is an interim payment` TRUE TRUE TRUE EQUALS JUST FALSE -- excluding costs of the action
#ASSERT `o 13 r 8(1) a payment is an interim payment` FALSE TRUE FALSE EQUALS JUST FALSE -- not before trial or hearing
#ASSERT `o 13 r 8(1) a payment is an interim payment` TRUE FALSE FALSE EQUALS JUST FALSE -- not on account of an amount the defendant may be held liable to pay
#ASSERT `o 13 r 8(2) a defendant may make an interim payment to the claimant` TRUE EQUALS JUST TRUE -- on the defendant's own accord
#ASSERT `o 13 r 8(2) a defendant may make an interim payment to the claimant` FALSE EQUALS NOTHING -- not on own accord: paragraph (4) is the Court's power
#ASSERT `o 13 r 8(3) the claimant may apply for interim payment to be made by one or more of the defendants` TRUE EQUALS JUST TRUE -- a claimant
#ASSERT `o 13 r 8(3) the claimant may apply for interim payment to be made by one or more of the defendants` FALSE EQUALS NOTHING -- not a claimant
#ASSERT `o 13 r 8(3) the claimant's affidavit states what paragraph (3) requires` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- (a), (b) admitted or found liable, (c)
#ASSERT `o 13 r 8(3) the claimant's affidavit states what paragraph (3) requires` TRUE FALSE TRUE TRUE EQUALS JUST TRUE -- (a), (b) not admitted so reasons for a strong case, (c)
#ASSERT `o 13 r 8(3) the claimant's affidavit states what paragraph (3) requires` TRUE FALSE FALSE TRUE EQUALS JUST FALSE -- not admitted and no reasons for a strong case
#ASSERT `o 13 r 8(3) the claimant's affidavit states what paragraph (3) requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- (a) missing
#ASSERT `o 13 r 8(3) the claimant's affidavit states what paragraph (3) requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- (c) missing
#ASSERT `o 13 r 8(4) the Court may order interim payment of any amount to be made` TRUE TRUE TRUE EQUALS JUST TRUE -- all the factors considered
#ASSERT `o 13 r 8(4) the Court may order interim payment of any amount to be made` FALSE TRUE TRUE EQUALS NOTHING -- the paragraph (3) factors not considered
#ASSERT `o 13 r 8(4) the Court may order interim payment of any amount to be made` TRUE FALSE TRUE EQUALS NOTHING -- contributory negligence, set-off or counterclaim not considered
#ASSERT `o 13 r 8(4) the Court may order interim payment of any amount to be made` TRUE TRUE FALSE EQUALS NOTHING -- the defendant's ability not considered
#ASSERT `o 13 r 8(5) the Court may order interim payment to be made in this way` `o 13 r 8(5) in instalments` EQUALS JUST TRUE -- instalments
#ASSERT `o 13 r 8(5) the Court may order interim payment to be made in this way` `o 13 r 8(5) at periodic intervals` EQUALS JUST TRUE -- periodic intervals
#ASSERT `o 13 r 8(6) the Court may allow a second or subsequent application for interim payment to be made` TRUE EQUALS JUST TRUE -- a material change in circumstances
#ASSERT `o 13 r 8(6) the Court may allow a second or subsequent application for interim payment to be made` FALSE EQUALS JUST FALSE -- "if" fails
#ASSERT `o 13 r 8(7) the fact of the interim payment may be disclosed to the trial Judge` TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- paid, issues not decided, no consent, no direction
#ASSERT `o 13 r 8(7) the fact of the interim payment may be disclosed to the trial Judge` TRUE TRUE FALSE FALSE EQUALS NOTHING -- after all issues have been decided
#ASSERT `o 13 r 8(7) the fact of the interim payment may be disclosed to the trial Judge` TRUE FALSE TRUE FALSE EQUALS NOTHING -- the defendant consents
#ASSERT `o 13 r 8(7) the fact of the interim payment may be disclosed to the trial Judge` TRUE FALSE FALSE TRUE EQUALS NOTHING -- the Court so directs
#ASSERT `o 13 r 8(7) the fact of the interim payment may be disclosed to the trial Judge` FALSE FALSE FALSE FALSE EQUALS NOTHING -- no interim payment made
#ASSERT `o 13 r 8(8) the Court must order the claimant to repay the defendant the amount paid in interim payment` TRUE EQUALS JUST TRUE -- the Court dismisses the claim
#ASSERT `o 13 r 8(8) the Court must order the claimant to repay the defendant the amount paid in interim payment` FALSE EQUALS JUST FALSE -- "If" fails
#ASSERT `o 13 r 8(8) the amount the claimant must repay` TRUE 500 EQUALS JUST 500 -- the whole amount paid
#ASSERT `o 13 r 8(8) the amount the claimant must repay` FALSE 500 EQUALS NOTHING -- claim not dismissed
#ASSERT `o 13 r 8(9) the Court must order the claimant to repay the defendant the excess paid` 300 500 EQUALS JUST TRUE -- judgment less than the amount paid
#ASSERT `o 13 r 8(9) the Court must order the claimant to repay the defendant the excess paid` 500 500 EQUALS JUST FALSE -- equal: not "less than"
#ASSERT `o 13 r 8(9) the Court must order the claimant to repay the defendant the excess paid` 700 500 EQUALS JUST FALSE -- judgment more than the amount paid
#ASSERT `o 13 r 8(9) the excess the claimant must repay` 300 500 EQUALS JUST 200 -- 500 paid, judgment 300: excess 200
#ASSERT `o 13 r 8(9) the excess the claimant must repay` 500 500 EQUALS NOTHING -- equal
#ASSERT `o 13 r 8(10) the Court must take into account the interim payment paid` 700 500 EQUALS JUST TRUE -- judgment more than the amount paid
#ASSERT `o 13 r 8(10) the Court must take into account the interim payment paid` 500 500 EQUALS JUST FALSE -- equal: not "more than"
#ASSERT `o 13 r 8(10) the Court must take into account the interim payment paid` 300 500 EQUALS JUST FALSE -- judgment less than the amount paid
#ASSERT `o 13 r 8(10) the balance of the judgment after taking the interim payment into account` 700 500 EQUALS JUST 200 -- 700 less 500 paid
#ASSERT `o 13 r 8(10) the balance of the judgment after taking the interim payment into account` 500 500 EQUALS NOTHING -- equal
#ASSERT `o 13 r 8(11) the claim is deemed to have been reduced by the amount paid for the purpose of considering whether any other Court has the jurisdiction to hear the case` TRUE TRUE EQUALS JUST FALSE -- "not deemed to have been reduced"
#ASSERT `o 13 r 8(11) the claim is deemed to have been reduced by the amount paid for the purpose of considering whether any other Court has the jurisdiction to hear the case` TRUE FALSE EQUALS NOTHING -- the defendant admits that the amount paid is due
#ASSERT `o 13 r 8(11) the claim is deemed to have been reduced by the amount paid for the purpose of considering whether any other Court has the jurisdiction to hear the case` FALSE TRUE EQUALS NOTHING -- no interim payment made

-- Rule 9
#ASSERT `o 13 r 9(1) the Court may appoint a receiver` TRUE EQUALS JUST TRUE -- where appropriate
#ASSERT `o 13 r 9(1) the Court may appoint a receiver` FALSE EQUALS JUST FALSE -- not appropriate: "where appropriate" is a "where" that fails, so JUST FALSE (fork F-O13-2)
#ASSERT `o 13 r 9(2) the Court may give directions on this matter` TRUE `o 13 r 9(2)(a) the duties and the powers of the receiver` EQUALS JUST TRUE -- (a)
#ASSERT `o 13 r 9(2) the Court may give directions on this matter` TRUE `o 13 r 9(2)(b) the form and the amount of any security to be given by the receiver for the proper discharge of the duties` EQUALS JUST TRUE -- (b)
#ASSERT `o 13 r 9(2) the Court may give directions on this matter` TRUE `o 13 r 9(2)(c) when and how often the accounts should be submitted to the Court and to the relevant parties` EQUALS JUST TRUE -- (c)
#ASSERT `o 13 r 9(2) the Court may give directions on this matter` TRUE `o 13 r 9(2)(d) the remuneration of the receiver` EQUALS JUST TRUE -- (d)
#ASSERT `o 13 r 9(2) the Court may give directions on this matter` FALSE `o 13 r 9(2)(d) the remuneration of the receiver` EQUALS NOTHING -- no receiver appointed
#ASSERT `o 13 r 9(3) the Court may do this` TRUE `o 13 r 9(3)(a) terminate the appointment of the receiver` EQUALS JUST TRUE -- (a)
#ASSERT `o 13 r 9(3) the Court may do this` TRUE `o 13 r 9(3)(b) disallow any part of the remuneration` EQUALS JUST TRUE -- (b)
#ASSERT `o 13 r 9(3) the Court may do this` TRUE `o 13 r 9(3)(c) order that all or part of any security given be forfeited` EQUALS JUST TRUE -- (c)
#ASSERT `o 13 r 9(3) the Court may do this` TRUE `o 13 r 9(3)(d) appoint a new receiver` EQUALS JUST TRUE -- (d)
#ASSERT `o 13 r 9(3) the Court may do this` TRUE `o 13 r 9(3)(e) make orders relating to any property in the possession or control of the former receiver` EQUALS JUST TRUE -- (e)
#ASSERT `o 13 r 9(3) the Court may do this` FALSE `o 13 r 9(3)(a) terminate the appointment of the receiver` EQUALS JUST FALSE -- the receiver discharges the duties properly

-- Rule 10
#ASSERT `o 13 r 10(1) the person may apply to the Court to be released from any liability relating to the property` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- possession or control, affidavit with (a) to (d)
#ASSERT `o 13 r 10(1) the person may apply to the Court to be released from any liability relating to the property` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- not in possession or control
#ASSERT `o 13 r 10(1) the person may apply to the Court to be released from any liability relating to the property` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- (a) missing
#ASSERT `o 13 r 10(1) the person may apply to the Court to be released from any liability relating to the property` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- (b) missing
#ASSERT `o 13 r 10(1) the person may apply to the Court to be released from any liability relating to the property` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- (c) missing
#ASSERT `o 13 r 10(1) the person may apply to the Court to be released from any liability relating to the property` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- (d) missing
#ASSERT `o 13 r 10(2) the application and the affidavit are served as required` TRUE TRUE EQUALS JUST TRUE -- all claimants and known potential claimants
#ASSERT `o 13 r 10(2) the application and the affidavit are served as required` FALSE TRUE EQUALS JUST FALSE -- not all claimants
#ASSERT `o 13 r 10(2) the application and the affidavit are served as required` TRUE FALSE EQUALS JUST FALSE -- not all known potential claimants
#ASSERT `o 13 r 10(3) fourteen days after service of the application and the affidavit`'s `period length` EQUALS 14 -- "within 14 days after such service"
#ASSERT `o 13 r 10(3) the person must file the person's affidavit` TRUE TRUE EQUALS JUST TRUE -- served, wants to make a claim
#ASSERT `o 13 r 10(3) the person must file the person's affidavit` TRUE FALSE EQUALS NOTHING -- does not want to make a claim
#ASSERT `o 13 r 10(3) the person must file the person's affidavit` FALSE TRUE EQUALS NOTHING -- not served
#ASSERT `o 13 r 10(3) the person files the person's affidavit in time` (Date 14 6 2027) (Date 14 6 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `o 13 r 10(3) the person files the person's affidavit in time` (Date 15 6 2027) (Date 14 6 2027) EQUALS JUST FALSE -- a day late
#TRACE `o 13 r 10(3) the person served who wants to make a claim must file the person's affidavit` AT 0 WITH
    PARTY `o 13 r 10(3) the person served who wants to make a claim on the property` DOES `o 13 r 10(3) file the person's affidavit` AT 14
#TRACE `o 13 r 10(3) the person served who wants to make a claim must file the person's affidavit` AT 0 WITH
    (WAITUNTIL 15)
#ASSERT `o 13 r 10(4) the Court must fix a case conference for the application` TRUE EQUALS JUST TRUE -- an application under this Rule
#ASSERT `o 13 r 10(4) the Court must fix a case conference for the application` FALSE EQUALS NOTHING -- some other application
#ASSERT `o 13 r 10(5) the Court may do this` TRUE `o 13 r 10(5) decide on the conflicting claims to the property summarily` EQUALS JUST TRUE -- decide summarily
#ASSERT `o 13 r 10(5) the Court may do this` TRUE `o 13 r 10(5) give directions regarding the hearing of the conflicting claims` EQUALS JUST TRUE -- give directions
#ASSERT `o 13 r 10(5) the Court may do this` FALSE `o 13 r 10(5) give directions regarding the hearing of the conflicting claims` EQUALS NOTHING -- not at the case conference
#ASSERT `o 13 r 10(6) the person must give written notice of the claim to the Sheriff` TRUE EQUALS JUST TRUE -- a claim on property in the Sheriff's possession or control
#ASSERT `o 13 r 10(6) the person must give written notice of the claim to the Sheriff` FALSE EQUALS NOTHING -- some other claim
#ASSERT `o 13 r 10(6) the notice to the Sheriff is as required` TRUE TRUE TRUE EQUALS JUST TRUE -- in writing, as soon as possible, with the evidence
#ASSERT `o 13 r 10(6) the notice to the Sheriff is as required` FALSE TRUE TRUE EQUALS JUST FALSE -- not in writing
#ASSERT `o 13 r 10(6) the notice to the Sheriff is as required` TRUE FALSE TRUE EQUALS JUST FALSE -- not as soon as possible
#ASSERT `o 13 r 10(6) the notice to the Sheriff is as required` TRUE TRUE FALSE EQUALS JUST FALSE -- without the evidence supporting the claim
#ASSERT `o 13 r 10(7) the Sheriff may apply under this Rule` TRUE EQUALS JUST TRUE -- the Sheriff
#ASSERT `o 13 r 10(7) the Sheriff may apply under this Rule` FALSE EQUALS NOTHING -- not the Sheriff
#ASSERT `o 13 r 10(8) the Court may by order stay all further proceedings in the action` TRUE EQUALS JUST TRUE -- a defendant applies for relief under this Rule
#ASSERT `o 13 r 10(8) the Court may by order stay all further proceedings in the action` FALSE EQUALS JUST FALSE -- "Where" fails
#ASSERT `o 13 r 10(9) Order 11 applies to the issue with the necessary modifications` TRUE EQUALS JUST TRUE -- an issue of conflicting claims under this Rule
#ASSERT `o 13 r 10(9) Order 11 applies to the issue with the necessary modifications` FALSE EQUALS NOTHING -- some other issue

-- Rule 11
#ASSERT `o 13 r 11 the Court may order an early trial or hearing of the action instead` TRUE EQUALS JUST TRUE -- instead of an order on an application under Rules 1 to 10
#ASSERT `o 13 r 11 the Court may order an early trial or hearing of the action instead` FALSE EQUALS NOTHING -- not instead of such an order
