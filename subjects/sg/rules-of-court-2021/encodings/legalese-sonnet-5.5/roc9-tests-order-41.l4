IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc9-order-41`

-- Tests for roc9-order-41.l4.  Every expected value is written from the text of Order 41 (lines 5811-5843)
-- before the run, beside the assertion.  Positional OF follows the DECLARE order of each record.

-- ---- Rule 1 (line 5814) ----
-- "must, if so directed by the Court": appointed and directed -> duty; appointed, not directed -> the "if" is unmet.
#ASSERT `o 41 r 1 the duty to keep a receiver's register arises` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 41 r 1 the duty to keep a receiver's register arises` TRUE FALSE EQUALS JUST FALSE
-- a receiver not appointed in such an action is outside the Rule's scope (NOTHING)
#ASSERT `o 41 r 1 the duty to keep a receiver's register arises` FALSE TRUE EQUALS NOTHING
#ASSERT `o 41 r 1 the duty to keep a receiver's register arises` FALSE FALSE EQUALS NOTHING
-- "(called in this Order the receiver's register)"
#ASSERT `o 41 r 1 a register is the receiver's register` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 41 r 1 a register is the receiver's register` TRUE FALSE EQUALS NOTHING
#ASSERT `o 41 r 1 a register is the receiver's register` FALSE TRUE EQUALS NOTHING
-- the regulative rule: the receiver keeps the register -> fulfilled (printed, not asserted: see NOTES.md)
#TRACE `o 41 r 1 the receiver's duty to keep the register` AT 0 WITH
    PARTY `o 41 r 1 the receiver` DOES `o 41 r 1 keep the receiver's register` AT 1
-- expect: FULFILLED

-- ---- Rule 2(1) (line 5816): appointed, directed, applied, produced evidence ----
#ASSERT `o 41 r 2(1) the receiver's duty to register the transfer or other transmission of title arises` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 41 r 2(1) the receiver's duty to register the transfer or other transmission of title arises` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 41 r 2(1) the receiver's duty to register the transfer or other transmission of title arises` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- Rule 1 is not met (not directed): "Where a receiver is required by Rule 1" is unmet
#ASSERT `o 41 r 2(1) the receiver's duty to register the transfer or other transmission of title arises` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- Rule 1 does not answer (not a receiver of that kind): NOTHING
#ASSERT `o 41 r 2(1) the receiver's duty to register the transfer or other transmission of title arises` FALSE TRUE TRUE TRUE EQUALS NOTHING

-- ---- Rule 2(2) (lines 5816-5819) ----
-- a transfer whose due execution is not proved by affidavit: the duty to send the notice arises
#ASSERT `o 41 r 2(2) the receiver's duty to send a notice before registering a transfer arises` TRUE FALSE EQUALS JUST TRUE
-- "unless the due execution of the transfer is proved by affidavit"
#ASSERT `o 41 r 2(2) the receiver's duty to send a notice before registering a transfer arises` TRUE TRUE EQUALS JUST FALSE
-- not a transfer (another transmission of title): paragraph (2) speaks of "a transfer"
#ASSERT `o 41 r 2(2) the receiver's duty to send a notice before registering a transfer arises` FALSE FALSE EQUALS NOTHING
-- the notice: by post to the registered holder; paragraph (a); paragraph (b)
#ASSERT `o 41 r 2(2) the notice is as the Rule requires` (`o 41 r 2(2) the notice` OF TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 41 r 2(2) the notice is as the Rule requires` (`o 41 r 2(2) the notice` OF FALSE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 41 r 2(2) the notice is as the Rule requires` (`o 41 r 2(2) the notice` OF TRUE, FALSE, TRUE) EQUALS NOTHING
#ASSERT `o 41 r 2(2) the notice is as the Rule requires` (`o 41 r 2(2) the notice` OF TRUE, TRUE, FALSE) EQUALS NOTHING
-- "no transfer may be registered until the period so specified has elapsed": before the end of the period the bar holds
#ASSERT `o 41 r 2(2) the transfer cannot yet be registered` TRUE (Date 10 2 2023) (Date 20 2 2023) EQUALS JUST TRUE
-- on the last day of the period the period has not yet elapsed (fork F3)
#ASSERT `o 41 r 2(2) the transfer cannot yet be registered` TRUE (Date 20 2 2023) (Date 20 2 2023) EQUALS JUST TRUE
-- the day after, it has elapsed: the bar is over
#ASSERT `o 41 r 2(2) the transfer cannot yet be registered` TRUE (Date 21 2 2023) (Date 20 2 2023) EQUALS JUST FALSE
-- no notice with a period was sent: the bar has nothing to run from
#ASSERT `o 41 r 2(2) the transfer cannot yet be registered` FALSE (Date 21 2 2023) (Date 20 2 2023) EQUALS NOTHING

-- ---- Rule 2(3) (line 5820): "at least 14 days after" ----
#ASSERT (`o 41 r 2(3) the minimum period after a reply would reach the receiver`'s `period length`) EQUALS 14
#ASSERT (`o 41 r 2(3) the minimum period after a reply would reach the receiver`'s `period unit`) EQUALS Days
#ASSERT (`o 41 r 2(3) the minimum period after a reply would reach the receiver`'s `period direction`) EQUALS `After the anchor`
-- notice delivered 10 January 2023, the holder replies on 11 January, the reply takes 3 days: it reaches the receiver on 14 January
#ASSERT `o 41 r 2(3) the day a reply would in the ordinary course of post reach the receiver` (Date 10 1 2023) 3 EQUALS Date 14 1 2023
-- 14 days after 14 January is 28 January (the first day, supplied by Order 3 Rule 3): the last day of the period must not be earlier
#ASSERT `o 41 r 2(3) the period specified in the notice is long enough` (Date 28 1 2023) (Date 28 1 2023) EQUALS JUST TRUE
#ASSERT `o 41 r 2(3) the period specified in the notice is long enough` (Date 31 1 2023) (Date 28 1 2023) EQUALS JUST TRUE
#ASSERT `o 41 r 2(3) the period specified in the notice is long enough` (Date 27 1 2023) (Date 28 1 2023) EQUALS JUST FALSE

-- ---- Rule 2(4) (line 5821) ----
#ASSERT `o 41 r 2(4) the receiver's duty to endorse a memorandum arises` TRUE EQUALS JUST TRUE
#ASSERT `o 41 r 2(4) the receiver's duty to endorse a memorandum arises` FALSE EQUALS JUST FALSE
#ASSERT `o 41 r 2(4) the memorandum is as the Rule requires` TRUE (`o 41 r 2(4) the memorandum` OF TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 41 r 2(4) the memorandum is as the Rule requires` TRUE (`o 41 r 2(4) the memorandum` OF FALSE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 41 r 2(4) the memorandum is as the Rule requires` TRUE (`o 41 r 2(4) the memorandum` OF TRUE, FALSE, TRUE) EQUALS NOTHING
#ASSERT `o 41 r 2(4) the memorandum is as the Rule requires` TRUE (`o 41 r 2(4) the memorandum` OF TRUE, TRUE, FALSE) EQUALS NOTHING
-- nothing was registered: the duty does not arise (QD)
#ASSERT `o 41 r 2(4) the memorandum is as the Rule requires` FALSE (`o 41 r 2(4) the memorandum` OF TRUE, TRUE, TRUE) EQUALS NOTHING

-- ---- Rule 3 (lines 5823-5824) ----
#ASSERT `o 41 r 3(1) the person may apply to the Court for rectification of the receiver's register` TRUE EQUALS JUST TRUE
#ASSERT `o 41 r 3(1) the person may apply to the Court for rectification of the receiver's register` FALSE EQUALS NOTHING
#ASSERT `o 41 r 3(1) the application is made in the way the Rule requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 41 r 3(1) the application is made in the way the Rule requires` FALSE TRUE EQUALS NOTHING
#ASSERT `o 41 r 3(1) the application is made in the way the Rule requires` TRUE FALSE EQUALS NOTHING
-- "served only on the claimant or other party having the conduct of the action"
#ASSERT `o 41 r 3(2) the summons is served as the Rule requires in the first instance` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 41 r 3(2) the summons is served as the Rule requires in the first instance` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 41 r 3(2) the summons is served as the Rule requires in the first instance` FALSE TRUE FALSE EQUALS JUST FALSE
-- the Court has directed service on the other person: "only" is lifted (QA: NOTHING)
#ASSERT `o 41 r 3(2) the summons is served as the Rule requires in the first instance` TRUE TRUE TRUE EQUALS NOTHING
-- not served on the party having the conduct of the action, nobody else served
#ASSERT `o 41 r 3(2) the summons is served as the Rule requires in the first instance` FALSE FALSE FALSE EQUALS NOTHING
-- the Court's power to decide
#ASSERT `o 41 r 3(3) the Court hearing the application may decide the question` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 41 r 3(3) the Court hearing the application may decide the question` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 41 r 3(3) the Court hearing the application may decide the question` FALSE FALSE EQUALS NOTHING

-- ---- Rule 4 (line 5826): entry in register, in the action, verified by the receiver, verified by a directed person ----
#ASSERT `o 41 r 4 the entry is evidence of the transfer or transmission of title` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 41 r 4 the entry is evidence of the transfer or transmission of title` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- "if verified": not verified -> the "if" is unmet (marginal reading a)
#ASSERT `o 41 r 4 the entry is evidence of the transfer or transmission of title` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- not an entry in the receiver's register, or not in the action in which the receiver was appointed
#ASSERT `o 41 r 4 the entry is evidence of the transfer or transmission of title` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `o 41 r 4 the entry is evidence of the transfer or transmission of title` TRUE FALSE TRUE TRUE EQUALS NOTHING

-- ---- Rule 5 (lines 5828-5838) ----
#ASSERT `o 41 r 5(1) this Rule applies to the action` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 41 r 5(1) this Rule applies to the action` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 41 r 5(1) this Rule applies to the action` FALSE FALSE EQUALS NOTHING
-- produced, certificate of identification, identifies, certifies name and address, notice of a defect
#ASSERT `o 41 r 5(2) the title of the person claiming to be the holder is sufficiently proved` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 41 r 5(2) the title of the person claiming to be the holder is sufficiently proved` TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 41 r 5(2) the title of the person claiming to be the holder is sufficiently proved` FALSE TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 41 r 5(2) the title of the person claiming to be the holder is sufficiently proved` TRUE FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 41 r 5(2) the title of the person claiming to be the holder is sufficiently proved` TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `o 41 r 5(2) the title of the person claiming to be the holder is sufficiently proved` TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `o 41 r 5(3) the claimant's solicitor's duty to cause a notice to be endorsed arises` TRUE EQUALS JUST TRUE
#ASSERT `o 41 r 5(3) the claimant's solicitor's duty to cause a notice to be endorsed arises` FALSE EQUALS JUST FALSE
#ASSERT `o 41 r 5(3) the notice endorsed is as the Rule requires` TRUE (`o 41 r 5(3) the notice endorsed` OF TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 41 r 5(3) the notice endorsed is as the Rule requires` TRUE (`o 41 r 5(3) the notice endorsed` OF FALSE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 41 r 5(3) the notice endorsed is as the Rule requires` TRUE (`o 41 r 5(3) the notice endorsed` OF TRUE, FALSE, TRUE) EQUALS NOTHING
#ASSERT `o 41 r 5(3) the notice endorsed is as the Rule requires` TRUE (`o 41 r 5(3) the notice endorsed` OF TRUE, TRUE, FALSE) EQUALS NOTHING
#ASSERT `o 41 r 5(3) the notice endorsed is as the Rule requires` FALSE (`o 41 r 5(3) the notice endorsed` OF TRUE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 41 r 5(4) the solicitor has preserved the certificates and kept the record` (`o 41 r 5(4) what the solicitor has done` OF TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 41 r 5(4) the solicitor has preserved the certificates and kept the record` (`o 41 r 5(4) what the solicitor has done` OF FALSE, TRUE) EQUALS NOTHING
#ASSERT `o 41 r 5(4) the solicitor has preserved the certificates and kept the record` (`o 41 r 5(4) what the solicitor has done` OF TRUE, FALSE) EQUALS NOTHING
#ASSERT `o 41 r 5(4) the solicitor's duty to verify the record by affidavit arises` TRUE EQUALS JUST TRUE
#ASSERT `o 41 r 5(4) the solicitor's duty to verify the record by affidavit arises` FALSE EQUALS JUST FALSE

-- ---- Rule 6 (lines 5840-5843) ----
#ASSERT `o 41 r 6(1) the bar on payment by the Accountant-General applies` TRUE EQUALS JUST TRUE
#ASSERT `o 41 r 6(1) the bar on payment by the Accountant-General applies` FALSE EQUALS JUST FALSE
-- order for payment made; neither the certificate nor a dispensation: "must not make a payment"
#ASSERT `o 41 r 6(1) the Accountant-General may make a payment in respect of the debenture or stock` TRUE FALSE FALSE EQUALS JUST FALSE
-- the certificate is produced, or the Court has dispensed with it: the bar is lifted and the Rule grants nothing (QA)
#ASSERT `o 41 r 6(1) the Accountant-General may make a payment in respect of the debenture or stock` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 41 r 6(1) the Accountant-General may make a payment in respect of the debenture or stock` TRUE FALSE TRUE EQUALS NOTHING
-- no order for payment: the paragraph does not speak
#ASSERT `o 41 r 6(1) the Accountant-General may make a payment in respect of the debenture or stock` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `o 41 r 6(2) the steps for obtaining payment are done` (`o 41 r 6(2) what has been done` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 41 r 6(2) the steps for obtaining payment are done` (`o 41 r 6(2) what has been done` OF FALSE, TRUE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 41 r 6(2) the steps for obtaining payment are done` (`o 41 r 6(2) what has been done` OF TRUE, FALSE, TRUE, TRUE) EQUALS NOTHING
#ASSERT `o 41 r 6(2) the steps for obtaining payment are done` (`o 41 r 6(2) what has been done` OF TRUE, TRUE, FALSE, TRUE) EQUALS NOTHING
#ASSERT `o 41 r 6(2) the steps for obtaining payment are done` (`o 41 r 6(2) what has been done` OF TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING
-- the two duties in order: endorse, then certify and send
#TRACE `o 41 r 6(2) the duties of the solicitor or person to whom the debenture is produced` AT 0 WITH
    PARTY `o 41 r 6(2) the solicitor of the claimant or the person the Court directs` DOES `o 41 r 6(2)(a) endorse a memorandum of payment on the debenture or debenture stock certificate` AT 1
    PARTY `o 41 r 6(2) the solicitor of the claimant or the person the Court directs` DOES `o 41 r 6(2)(b) make and sign the certificate and send it to the Accountant-General` AT 2
-- expect: FULFILLED

-- ---- Further tests (Order 41) ----
-- Rule 6(1), "is the Accountant-General barred yet?"
#ASSERT `o 41 r 6(1) the Accountant-General is barred from making the payment` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 41 r 6(1) the Accountant-General is barred from making the payment` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 41 r 6(1) the Accountant-General is barred from making the payment` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 41 r 6(1) the Accountant-General is barred from making the payment` FALSE FALSE FALSE EQUALS JUST FALSE
