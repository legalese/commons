IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc8-nouns`
IMPORT `roc8-order-35`

-- Rules of Court 2021 (Singapore), Order 35: TESTS.  Every expected value is written from the text of the paragraph
-- named beside it, before running.

-- ---------------------------------------------------------------------------
§§ `Rule 1`
-- ---------------------------------------------------------------------------

#ASSERT `o 35 r 1(1) the application must be made by originating application` TRUE EQUALS JUST TRUE
#ASSERT `o 35 r 1(1) the application must be made by originating application` FALSE EQUALS NOTHING
#ASSERT `o 35 r 1(1) the application is made by originating application` TRUE `o 34 r 2 by originating application` EQUALS JUST TRUE
#ASSERT `o 35 r 1(1) the application is made by originating application` TRUE `o 34 r 2 by summons in the action` EQUALS NOTHING
#ASSERT `o 35 r 1(1) the application is made by originating application` TRUE `o 34 r 2 by originating application without notice` EQUALS NOTHING
#ASSERT `o 35 r 1(1) the application is made by originating application` FALSE `o 34 r 2 by originating application` EQUALS NOTHING
#ASSERT `o 35 r 1(2) the application must be supported by an affidavit setting out the grounds` TRUE EQUALS JUST TRUE
#ASSERT `o 35 r 1(2) the application must be supported by an affidavit setting out the grounds` FALSE EQUALS NOTHING
#ASSERT `o 35 r 1(2) the application is supported by an affidavit setting out the grounds` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 35 r 1(2) the application is supported by an affidavit setting out the grounds` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `o 35 r 1(2) the application is supported by an affidavit setting out the grounds` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 35 r 1(2) the application is supported by an affidavit setting out the grounds` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `o 35 r 1(3) the Act is the Bills of Sale Act` TRUE EQUALS JUST TRUE
#ASSERT `o 35 r 1(3) the Act is the Bills of Sale Act` FALSE EQUALS JUST FALSE
#ASSERT `o 35 r 1(3) a reference to a section is a reference to a section in the Act` TRUE EQUALS JUST TRUE
#ASSERT `o 35 r 1(3) a reference to a section is a reference to a section in the Act` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§§ `Rule 2`
-- ---------------------------------------------------------------------------

GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN
GIVETH AN `o 35 r 2(2) supporting affidavit`
`o 35 r 2(2) test affidavit` MEANS `o 35 r 2(2) supporting affidavit` WITH
    `o 35 r 2(2) it sets out particulars of the bill of sale` IS a
    `o 35 r 2(2) it sets out particulars of the omission or misstatement in question` IS b
    `o 35 r 2(2) it states the grounds on which the application is made` IS c

#ASSERT `o 35 r 2(1) the application must be made by originating application without notice` TRUE EQUALS JUST TRUE
#ASSERT `o 35 r 2(1) the application must be made by originating application without notice` FALSE EQUALS NOTHING
#ASSERT `o 35 r 2(1) the application is made by originating application without notice` TRUE `o 34 r 2 by originating application without notice` EQUALS JUST TRUE
#ASSERT `o 35 r 2(1) the application is made by originating application without notice` TRUE `o 34 r 2 by originating application` EQUALS NOTHING
#ASSERT `o 35 r 2(1) the application is made by originating application without notice` TRUE `o 34 r 2 by summons without notice` EQUALS NOTHING
#ASSERT `o 35 r 2(1) the application is made by originating application without notice` FALSE `o 34 r 2 by originating application without notice` EQUALS NOTHING
#ASSERT `o 35 r 2(2) the application must be supported by an affidavit` TRUE EQUALS JUST TRUE
#ASSERT `o 35 r 2(2) the application must be supported by an affidavit` FALSE EQUALS NOTHING
#ASSERT `o 35 r 2(2) the affidavit has the required content` (`o 35 r 2(2) test affidavit` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT `o 35 r 2(2) the affidavit has the required content` (`o 35 r 2(2) test affidavit` FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT `o 35 r 2(2) the affidavit has the required content` (`o 35 r 2(2) test affidavit` TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT `o 35 r 2(2) the affidavit has the required content` (`o 35 r 2(2) test affidavit` TRUE TRUE FALSE) EQUALS NOTHING

-- ---------------------------------------------------------------------------
§§ `Rule 3`
-- ---------------------------------------------------------------------------

GIVEN a IS A BOOLEAN, b IS A BOOLEAN
GIVETH AN `o 35 r 3(3) application under paragraph (1)`
`o 35 r 3(3) test application` MEANS `o 35 r 3(3) application under paragraph (1)` WITH
    `o 35 r 3(3)(a) it is served on the person entitled to the benefit of the bill of sale` IS a
    `o 35 r 3(3)(b) it is supported by an affidavit that the debt (if any) for which the bill of sale was made has been satisfied or discharged` IS b

GIVEN a IS A BOOLEAN, b IS A BOOLEAN
GIVETH AN `o 35 r 3(4) application under paragraph (2)`
`o 35 r 3(4) test application` MEANS `o 35 r 3(4) application under paragraph (2)` WITH
    `o 35 r 3(4)(a) it is supported by an affidavit setting out the particulars of the consent to the satisfaction` IS a
    `o 35 r 3(4)(b) it is supported by an affidavit by a witness who attested the consent verifying the signature on it` IS b

#ASSERT `o 35 r 3(1) the application must be made by originating application` TRUE EQUALS JUST TRUE
#ASSERT `o 35 r 3(1) the application must be made by originating application` FALSE EQUALS NOTHING
#ASSERT `o 35 r 3(1) the application is made by originating application` TRUE `o 34 r 2 by originating application` EQUALS JUST TRUE
#ASSERT `o 35 r 3(1) the application is made by originating application` TRUE `o 34 r 2 by originating application without notice` EQUALS NOTHING
#ASSERT `o 35 r 3(1) the application is made by originating application` FALSE `o 34 r 2 by originating application` EQUALS NOTHING
#ASSERT `o 35 r 3(2) the form of the consent to the satisfaction` EQUALS "Form 39"
#ASSERT `o 35 r 3(2) the application may be made by originating application without notice to the Registrar of the Supreme Court` TRUE EQUALS JUST TRUE
#ASSERT `o 35 r 3(2) the application may be made by originating application without notice to the Registrar of the Supreme Court` FALSE EQUALS JUST FALSE
#ASSERT `o 35 r 3(3) the application under paragraph (1) is served and supported as required` (`o 35 r 3(3) test application` TRUE TRUE) EQUALS JUST TRUE
#ASSERT `o 35 r 3(3) the application under paragraph (1) is served and supported as required` (`o 35 r 3(3) test application` FALSE TRUE) EQUALS NOTHING
#ASSERT `o 35 r 3(3) the application under paragraph (1) is served and supported as required` (`o 35 r 3(3) test application` TRUE FALSE) EQUALS NOTHING
#ASSERT `o 35 r 3(4) the application under paragraph (2) is supported as required` (`o 35 r 3(4) test application` TRUE TRUE) EQUALS JUST TRUE
#ASSERT `o 35 r 3(4) the application under paragraph (2) is supported as required` (`o 35 r 3(4) test application` FALSE TRUE) EQUALS NOTHING
#ASSERT `o 35 r 3(4) the application under paragraph (2) is supported as required` (`o 35 r 3(4) test application` TRUE FALSE) EQUALS NOTHING

-- ---------------------------------------------------------------------------
§§ `Rule 4`
-- ---------------------------------------------------------------------------

#ASSERT `o 35 r 4 the duty arises to make a request in writing to the registrar of bills of sale` TRUE EQUALS JUST TRUE
#ASSERT `o 35 r 4 the duty arises to make a request in writing to the registrar of bills of sale` FALSE EQUALS JUST FALSE
#ASSERT `o 35 r 4 the request is made as the rule requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 35 r 4 the request is made as the rule requires` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `o 35 r 4 the request is made as the rule requires` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `o 35 r 4 the request is made as the rule requires` FALSE TRUE TRUE EQUALS NOTHING
