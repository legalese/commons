#ASSERT `o 22 r 2(8) the enforcement order has ceased to be valid` FALSE FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§§ `Rules 3 and 4 -- satisfaction by consent; discharge of a non-party`
-- ---------------------------------------------------------------------------

#ASSERT `o 22 r 3(1) the person may apply to the Court for satisfaction to be recorded` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 3(1) the person may apply to the Court for satisfaction to be recorded` TRUE FALSE EQUALS NOTHING
#ASSERT `o 22 r 3(1) the person may apply to the Court for satisfaction to be recorded` FALSE TRUE EQUALS NOTHING
#ASSERT `o 22 r 3(1) the Court may order satisfaction to be recorded` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 3(1) the Court may order satisfaction to be recorded` TRUE TRUE FALSE EQUALS NOTHING
-- (2): attested by the solicitor if there is one, otherwise by a commissioner for oaths.
#ASSERT `o 22 r 3(2) the consent is attested as the rule requires` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 3(2) the consent is attested as the rule requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 3(2) the consent is attested as the rule requires` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 3(2) the consent is attested as the rule requires` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 4 the payment or execution is a valid discharge of the non-party's liability to the enforcement respondent` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 4 the payment or execution is a valid discharge of the non-party's liability to the enforcement respondent` FALSE EQUALS NOTHING
#ASSERT `o 22 r 4 the extent of the discharge` TRUE 750 EQUALS JUST 750
#ASSERT `o 22 r 4 the extent of the discharge` FALSE 750 EQUALS NOTHING

-- ---------------------------------------------------------------------------
§§ `Rule 5 -- money in Court`
-- ---------------------------------------------------------------------------

#ASSERT `o 22 r 5(1) the enforcement applicant is entitled to an enforcement order for attachment of debt in respect of the money` TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 5(1) the enforcement applicant is entitled to an enforcement order for attachment of debt in respect of the money` FALSE EQUALS NOTHING
#ASSERT `o 22 r 5(1) the enforcement applicant may apply to the Court by summons for payment of the money to the enforcement applicant` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 5(1) the enforcement applicant may apply to the Court by summons for payment of the money to the enforcement applicant` FALSE EQUALS NOTHING
-- the money, or so much as is sufficient to satisfy the judgment and the costs of the application.
#ASSERT `o 22 r 5(1) the most that may be ordered to be paid to the enforcement applicant` TRUE 10000 6000 500 EQUALS JUST 6500
#ASSERT `o 22 r 5(1) the most that may be ordered to be paid to the enforcement applicant` TRUE 5000 6000 500 EQUALS JUST 5000
#ASSERT `o 22 r 5(1) the most that may be ordered to be paid to the enforcement applicant` FALSE 5000 6000 500 EQUALS NOTHING
-- (2): production of the summons; the money cannot be paid out until the application is determined.
#ASSERT `o 22 r 5(2) the applicant must produce the summons at the office of the Accountant-General and leave a copy there` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 5(2) the applicant must produce the summons at the office of the Accountant-General and leave a copy there` FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 5(2) the money cannot yet be paid out of Court` FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 5(2) the money cannot yet be paid out of Court` TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 5(3) the applicant must give notice to the Accountant-General` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 5(3) the applicant must give notice to the Accountant-General` FALSE EQUALS JUST FALSE
-- (4): served at least 14 days before the hearing; hearing on 30 June 2027, so the last day is 16 June 2027 (made-up answer).
#ASSERT `o 22 r 5(4) the period before the hearing by which the summons must be served`'s `period length` EQUALS 14
#ASSERT `o 22 r 5(4) the summons is served on the enforcement respondent in time` FALSE (Date 16 6 2027) (Date 16 6 2027) EQUALS JUST TRUE
#ASSERT `o 22 r 5(4) the summons is served on the enforcement respondent in time` FALSE (Date 17 6 2027) (Date 16 6 2027) EQUALS JUST FALSE
#ASSERT `o 22 r 5(4) the summons is served on the enforcement respondent in time` TRUE (Date 17 6 2027) (Date 16 6 2027) EQUALS NOTHING
-- (5): "Subject to Order 33, Rule 25".
#ASSERT `o 22 r 5(5) the Court may make such order with respect to the money in Court as it thinks just` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `o 22 r 5(5) the Court may make such order with respect to the money in Court as it thinks just` TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `o 22 r 5(5) the Court may make such order with respect to the money in Court as it thinks just` TRUE NOTHING EQUALS NOTHING
#ASSERT `o 22 r 5(5) the Court may make such order with respect to the money in Court as it thinks just` FALSE (JUST FALSE) EQUALS NOTHING
