IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc5-o22-order`

-- TESTS for roc5-o22-order.l4 (Order 22, rules 1 to 5).  Every expected value is written from the text of the
-- Rules (lines 3379 to 3448 of the raw file), beside the assertion, before the module was run.
-- A "last day" or "first day" below is a made-up answer of O 3 r 3 (seam S-T1).

§ `Tests -- Order 22, rules 1 to 5`

-- ---------------------------------------------------------------------------
§§ `Rule 1 -- definitions`
-- ---------------------------------------------------------------------------

-- "includes": the two named are in; any other component is not covered.
#ASSERT `o 22 r 1 the component is within the amount due to the enforcement applicant` `o 22 r 1 interest` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the component is within the amount due to the enforcement applicant` `o 22 r 1 costs` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the component is within the amount due to the enforcement applicant` `o 22 r 1 another component` EQUALS NOTHING
#ASSERT `o 22 r 1 the judgment or order is a Court order` `o 22 r 1 a judgment or order for the payment of money (including costs)` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the judgment or order is a Court order` `o 22 r 1 a judgment or order for the delivery of movable property` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the judgment or order is a Court order` `o 22 r 1 a judgment or order for the title to or possession of immovable property` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the judgment or order is a Court order` `o 22 r 1 a judgment or order for the doing of an act` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the judgment or order is a Court order` `o 22 r 1 a judgment or order for the restraint or cessation of an act` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the judgment or order is a Court order` `o 22 r 1 a judgment or order for the declaration of rights` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the judgment or order is a Court order` `o 22 r 1 another kind of judgment or order` EQUALS NOTHING
-- "means": closed.
#ASSERT `o 22 r 1 the person is an enforcement applicant` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 1 the person is an enforcement applicant` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 1 the person is an enforcement applicant` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 1 the cost is within the enforcement costs` `o 22 r 1 charges, commissions, expenses and fees incurred by or payable to the Sheriff in carrying out an enforcement order` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the cost is within the enforcement costs` `o 22 r 1 costs allowed under these Rules payable to the enforcement applicant in applying for and carrying out an enforcement order` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the cost is within the enforcement costs` `o 22 r 1 expenses incurred by the enforcement applicant in applying for and carrying out an enforcement order` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the cost is within the enforcement costs` `o 22 r 1 another cost` EQUALS JUST FALSE
#ASSERT `o 22 r 1 the order is an enforcement order` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 1 the order is an enforcement order` FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 1 the person is an enforcement respondent` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 1 the person is an enforcement respondent` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 1 the person is an enforcement respondent` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 1 the thing is movable property` `o 22 r 1 cash` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the thing is movable property` `o 22 r 1 a debt` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the thing is movable property` `o 22 r 1 a deposit of money` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the thing is movable property` `o 22 r 1 bonds, shares or other securities` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the thing is movable property` `o 22 r 1 membership in a club or society` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the thing is movable property` `o 22 r 1 cryptocurrency or other digital currency` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the thing is movable property` `o 22 r 1 another kind of thing` EQUALS NOTHING
#ASSERT `o 22 r 1 the person is a non-party` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 1 the person is a non-party` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 1 the person is a non-party` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 1 the thing is property` `o 22 r 1 immovable property` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the thing is property` `o 22 r 1 movable property` EQUALS JUST TRUE
#ASSERT `o 22 r 1 the thing is property` `o 22 r 1 another kind of property` EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§§ `Rule 2 -- the enforcement order`
-- ---------------------------------------------------------------------------

#ASSERT `o 22 r 2(1) the person may apply for an enforcement order to enforce the Court orders` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 2(1) the person may apply for an enforcement order to enforce the Court orders` FALSE EQUALS NOTHING
#ASSERT `o 22 r 2(1) applying for an enforcement order affects the other method of enforcement` TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 2(1) applying for an enforcement order affects the other method of enforcement` FALSE EQUALS NOTHING
-- (2): (a) to (c) are tied to a kind of order; (d) is not.
#ASSERT `o 22 r 2(2) the enforcement order authorises the Sheriff to do the thing` `o 22 r 2(2)(a) an enforcement order for seizure and sale of property` `o 22 r 2(2)(a) seize and sell all property belonging to the enforcement respondent` FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(2) the enforcement order authorises the Sheriff to do the thing` `o 22 r 2(2)(b) an enforcement order for delivery or possession of property` `o 22 r 2(2)(a) seize and sell all property belonging to the enforcement respondent` FALSE EQUALS NOTHING
#ASSERT `o 22 r 2(2) the enforcement order authorises the Sheriff to do the thing` `o 22 r 2(2)(b) an enforcement order for delivery or possession of property` `o 22 r 2(2)(b) seize and deliver or give possession of property in the possession or control of the enforcement respondent` FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(2) the enforcement order authorises the Sheriff to do the thing` `o 22 r 2(2)(a) an enforcement order for seizure and sale of property` `o 22 r 2(2)(b) seize and deliver or give possession of property in the possession or control of the enforcement respondent` FALSE EQUALS NOTHING
#ASSERT `o 22 r 2(2) the enforcement order authorises the Sheriff to do the thing` `o 22 r 2(2)(c) an enforcement order for attachment of a debt` `o 22 r 2(2)(c) attach a debt which is due to the enforcement respondent from a non-party` FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(2) the enforcement order authorises the Sheriff to do the thing` `o 22 r 2(2)(a) an enforcement order for seizure and sale of property` `o 22 r 2(2)(c) attach a debt which is due to the enforcement respondent from a non-party` FALSE EQUALS NOTHING
#ASSERT `o 22 r 2(2) the enforcement order authorises the Sheriff to do the thing` `o 22 r 2(2) another enforcement order` `o 22 r 2(2)(d) do anything specified in the Court order` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 2(2) the enforcement order authorises the Sheriff to do the thing` `o 22 r 2(2)(a) an enforcement order for seizure and sale of property` `o 22 r 2(2)(d) do anything specified in the Court order` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 2(2) the enforcement order authorises the Sheriff to do the thing` `o 22 r 2(2)(a) an enforcement order for seizure and sale of property` `o 22 r 2(2)(d) do anything specified in the Court order` FALSE EQUALS NOTHING
#ASSERT `o 22 r 2(2) the enforcement order authorises the Sheriff to do the thing` `o 22 r 2(2)(a) an enforcement order for seizure and sale of property` `o 22 r 2(2) anything else` TRUE EQUALS NOTHING
#ASSERT `o 22 r 2(2)(c) the debt may be attached` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 2(2)(c) the debt may be attached` FALSE EQUALS NOTHING
#ASSERT `o 22 r 2(2)(c) the deposit may be attached whether or not it has matured and despite any restriction as to the mode of withdrawal` TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 2(2)(c) the deposit may be attached whether or not it has matured and despite any restriction as to the mode of withdrawal` FALSE EQUALS NOTHING
-- (3).
#ASSERT `o 22 r 2(3) the period before which the application may not be made`'s `period length` EQUALS 3
#ASSERT `o 22 r 2(3) the application is made in the way the rule provides` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 2(3) the application is made in the way the rule provides` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `o 22 r 2(3) the application is made in the way the rule provides` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `o 22 r 2(3) the application is made in the way the rule provides` TRUE TRUE FALSE EQUALS NOTHING
-- Court order served on 1 July 2027: the first day is 4 July 2027 (made-up O 3 r 3 answer).
#ASSERT `o 22 r 2(3) the application is made early enough` (Date 4 7 2027) (Date 4 7 2027) EQUALS JUST TRUE
#ASSERT `o 22 r 2(3) the application is made early enough` (Date 5 7 2027) (Date 4 7 2027) EQUALS JUST TRUE
#ASSERT `o 22 r 2(3) the application is made early enough` (Date 3 7 2027) (Date 4 7 2027) EQUALS JUST FALSE
-- (4): the items the affidavit must state: (a) to (d), (l), (m) always; the others only on their condition.
-- Argument order after the item: 6 years, change of identity, money order, interest, specific property, not in the respondent's hands, deposit or debt.
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(a) the terms of the Court order` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(b) the enforcement respondent's name and address` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(c) the date that the Court order was served on the enforcement respondent` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(d) the terms of the Court order which have not been complied with and which are to be enforced` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(e) the reasons for the delay in the application` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(e) the reasons for the delay in the application` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(f) the change in the identity of the enforcement applicant or the enforcement respondent` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(f) the change in the identity of the enforcement applicant or the enforcement respondent` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(g) the amount due, the amount recovered from any security, the amount paid and the amount that remains owing` FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(g) the amount due, the amount recovered from any security, the amount paid and the amount that remains owing` TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(h) the amount of interest owing daily from the time of making the affidavit` FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(h) the amount of interest owing daily from the time of making the affidavit` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(i) the description of the specific property and the evidence that it belongs to or is in the possession or control of the enforcement respondent` FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(i) the description of the specific property and the evidence that it belongs to or is in the possession or control of the enforcement respondent` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(j) the evidence that all persons in actual possession or control of the specific property have been notified about the application` FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(j) the evidence that all persons in actual possession or control of the specific property have been notified about the application` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(k) the description of the deposit of money or debt and the evidence that it belongs or is due to the enforcement respondent` FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(k) the description of the deposit of money or debt and the evidence that it belongs or is due to the enforcement respondent` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(l) whether the Sheriff is to enforce the parts of the enforcement order in a particular sequence or simultaneously` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4) the affidavit must state the item` `o 22 r 2(4)(m) the undertaking` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (4)(m): the undertaking: solicitors if represented, the applicant if not; three matters; exhibited.
#ASSERT `o 22 r 2(4)(m) the affidavit states the undertaking and exhibits it as the rule requires` TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4)(m) the affidavit states the undertaking and exhibits it as the rule requires` FALSE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 22 r 2(4)(m) the affidavit states the undertaking and exhibits it as the rule requires` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 2(4)(m) the affidavit states the undertaking and exhibits it as the rule requires` FALSE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 2(4)(m) the affidavit states the undertaking and exhibits it as the rule requires` TRUE TRUE FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 2(4)(m) the affidavit states the undertaking and exhibits it as the rule requires` TRUE TRUE FALSE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 2(4)(m) the affidavit states the undertaking and exhibits it as the rule requires` TRUE TRUE FALSE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 22 r 2(4)(m) the affidavit states the undertaking and exhibits it as the rule requires` TRUE TRUE FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- (5): valid for 12 months beginning with the date of issue.
#ASSERT `o 22 r 2(5) the period of validity of an enforcement order in the first instance`'s `period length` EQUALS 12
#ASSERT `o 22 r 2(5) the period of validity of an enforcement order in the first instance`'s `period unit` EQUALS Months
-- issued 10 January 2027: the 12 months end on 9 January 2028 (made-up O 3 r 3 answer).
#ASSERT `o 22 r 2(5) the enforcement order is valid in the first instance on the day` (Date 10 1 2027) (Date 10 1 2027) (Date 9 1 2028) FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(5) the enforcement order is valid in the first instance on the day` (Date 9 1 2028) (Date 10 1 2027) (Date 9 1 2028) FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 22 r 2(5) the enforcement order is valid in the first instance on the day` (Date 10 1 2028) (Date 10 1 2027) (Date 9 1 2028) FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 2(5) the enforcement order is valid in the first instance on the day` (Date 9 1 2027) (Date 10 1 2027) (Date 9 1 2028) FALSE FALSE EQUALS JUST FALSE
-- subject to (8): ceased on notice to the Sheriff or on an order recording satisfaction.
#ASSERT `o 22 r 2(5) the enforcement order is valid in the first instance on the day` (Date 1 6 2027) (Date 10 1 2027) (Date 9 1 2028) TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 22 r 2(5) the enforcement order is valid in the first instance on the day` (Date 1 6 2027) (Date 10 1 2027) (Date 9 1 2028) FALSE TRUE EQUALS JUST FALSE
-- (6): the extension.
#ASSERT `o 22 r 2(6) the period of each extension`'s `period length` EQUALS 12
