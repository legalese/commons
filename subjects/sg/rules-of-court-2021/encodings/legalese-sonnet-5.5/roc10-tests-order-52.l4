IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc10-order-52`

-- Rules of Court 2021 (Singapore), Order 52 (Mortgage actions): TESTS.
-- Every expected value is written beside its assertion from the text of the rule it cites (lines 6480 to 6520 of the text),
-- never copied from the output of the code.  Last days are worked out by hand under O 3 r 3.

#ASSERT `o 52 r 1(1) this Order applies to the action` TRUE (`o 52 r 1(1) the reliefs claimed` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE -- by a mortgagee or mortgagor, claiming only relief (a) payment
#ASSERT `o 52 r 1(1) this Order applies to the action` TRUE (`o 52 r 1(1) the reliefs claimed` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE -- by a mortgagee or mortgagor, claiming only relief (b) sale
#ASSERT `o 52 r 1(1) this Order applies to the action` TRUE (`o 52 r 1(1) the reliefs claimed` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE -- by a mortgagee or mortgagor, claiming only relief (c) foreclosure
#ASSERT `o 52 r 1(1) this Order applies to the action` TRUE (`o 52 r 1(1) the reliefs claimed` OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE) EQUALS JUST TRUE -- by a mortgagee or mortgagor, claiming only relief (d) delivery of possession to the mortgagee
#ASSERT `o 52 r 1(1) this Order applies to the action` TRUE (`o 52 r 1(1) the reliefs claimed` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE) EQUALS JUST TRUE -- by a mortgagee or mortgagor, claiming only relief (e) redemption
#ASSERT `o 52 r 1(1) this Order applies to the action` TRUE (`o 52 r 1(1) the reliefs claimed` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE) EQUALS JUST TRUE -- by a mortgagee or mortgagor, claiming only relief (f) reconveyance or release
#ASSERT `o 52 r 1(1) this Order applies to the action` TRUE (`o 52 r 1(1) the reliefs claimed` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS JUST TRUE -- by a mortgagee or mortgagor, claiming only relief (g) delivery of possession by the mortgagee
#ASSERT `o 52 r 1(1) this Order applies to the action` TRUE (`o 52 r 1(1) the reliefs claimed` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS NOTHING -- no claim for any of the reliefs
#ASSERT `o 52 r 1(1) this Order applies to the action` FALSE (`o 52 r 1(1) the reliefs claimed` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- not by a mortgagee, mortgagor or person with the right to foreclose or redeem
#ASSERT `o 52 r 1(1) the way the action began affects whether this Order applies` EQUALS JUST FALSE -- "(whether begun by originating claim or originating application)"
#ASSERT `o 52 r 1(2) a security is a mortgage` `o 52 r 1(2) a legal mortgage` EQUALS JUST TRUE -- "mortgage" includes a legal mortgage
#ASSERT `o 52 r 1(2) a security is a mortgage` `o 52 r 1(2) an equitable mortgage` EQUALS JUST TRUE -- "mortgage" includes an equitable mortgage
#ASSERT `o 52 r 1(2) a security is a mortgage` `o 52 r 1(2) a legal charge` EQUALS JUST TRUE -- "mortgage" includes a legal charge
#ASSERT `o 52 r 1(2) a security is a mortgage` `o 52 r 1(2) an equitable charge` EQUALS JUST TRUE -- "mortgage" includes an equitable charge
#ASSERT `o 52 r 1(2) a security is a mortgage` `o 52 r 1(2) another kind of security` EQUALS NOTHING -- "includes" does not close the list
#ASSERT `o 52 r 1(3) an action is a mortgage action` (JUST TRUE) EQUALS JUST TRUE -- an action to which this Order applies
#ASSERT `o 52 r 1(3) an action is a mortgage action` (JUST FALSE) EQUALS JUST FALSE -- an action to which this Order does not apply
#ASSERT `o 52 r 1(3) an action is a mortgage action` NOTHING EQUALS NOTHING -- whether the Order applies is not answered
#ASSERT `o 52 r 1(4) these Rules apply to the action subject to the following provisions of this Order` TRUE EQUALS JUST TRUE -- a mortgage action
#ASSERT `o 52 r 1(4) these Rules apply to the action subject to the following provisions of this Order` FALSE EQUALS NOTHING -- not a mortgage action
-- Rule 2 (lines 6501 to 6504)
#ASSERT `o 52 r 2(1) the provisions of this Rule apply` TRUE `Originating application` TRUE TRUE FALSE EQUALS JUST TRUE -- begun by originating application, claimant is the mortgagee, claims possession
#ASSERT `o 52 r 2(1) the provisions of this Rule apply` TRUE `Originating application` TRUE FALSE TRUE EQUALS JUST TRUE -- claims payment
#ASSERT `o 52 r 2(1) the provisions of this Rule apply` TRUE `Originating application` TRUE TRUE TRUE EQUALS JUST TRUE -- claims both
#ASSERT `o 52 r 2(1) the provisions of this Rule apply` TRUE `Originating claim` TRUE TRUE TRUE EQUALS NOTHING -- begun by originating claim
#ASSERT `o 52 r 2(1) the provisions of this Rule apply` TRUE `Originating application` FALSE TRUE TRUE EQUALS NOTHING -- the claimant is not the mortgagee
#ASSERT `o 52 r 2(1) the provisions of this Rule apply` TRUE `Originating application` TRUE FALSE FALSE EQUALS NOTHING -- claims neither possession nor payment
#ASSERT `o 52 r 2(1) the provisions of this Rule apply` FALSE `Originating application` TRUE TRUE TRUE EQUALS NOTHING -- not a mortgage action
#ASSERT `o 52 r 2(2) the duty to endorse a notice on the affidavit arises` TRUE TRUE EQUALS JUST TRUE -- the claimant claims delivery of possession
#ASSERT `o 52 r 2(2) the duty to endorse a notice on the affidavit arises` TRUE FALSE EQUALS JUST FALSE -- "Where the claimant claims delivery of possession"
#ASSERT `o 52 r 2(2) the duty to endorse a notice on the affidavit arises` FALSE TRUE EQUALS NOTHING -- this Rule does not apply
#ASSERT `o 52 r 2(2) the notice has been endorsed as it must be` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- endorsed on the outside fold and informing the defendant
#ASSERT `o 52 r 2(2) the notice has been endorsed as it must be` TRUE TRUE FALSE TRUE EQUALS NOTHING -- not endorsed on the outside fold: a bare "must"
#ASSERT `o 52 r 2(2) the notice has been endorsed as it must be` TRUE TRUE TRUE FALSE EQUALS NOTHING -- the notice does not inform the defendant as required
#ASSERT `o 52 r 2(2) the notice has been endorsed as it must be` TRUE FALSE TRUE TRUE EQUALS NOTHING -- no possession claim: nothing to comply with
-- (3): hearing fixed for 10 July 2026 (Friday); 2 clear days before: the last day for service is 7 July 2026
#ASSERT `o 52 r 2(3) the period before the day fixed for the adjourned hearing`'s `period length` EQUALS 2 -- "at least 2 clear days"
#ASSERT `o 52 r 2(3) the period before the day fixed for the adjourned hearing`'s `period unit` EQUALS `Clear days` -- "2 clear days"
#ASSERT `o 52 r 2(3) the duty to serve a written notice of the adjourned hearing arises` TRUE TRUE TRUE FALSE EQUALS JUST TRUE -- adjourned, defendant absent, no directions
#ASSERT `o 52 r 2(3) the duty to serve a written notice of the adjourned hearing arises` TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- "subject to any directions given by the Court"
#ASSERT `o 52 r 2(3) the duty to serve a written notice of the adjourned hearing arises` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- the defendant was present: the "where" fails
#ASSERT `o 52 r 2(3) the duty to serve a written notice of the adjourned hearing arises` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- not adjourned
#ASSERT `o 52 r 2(3) the duty to serve a written notice of the adjourned hearing arises` FALSE TRUE TRUE FALSE EQUALS NOTHING -- this Rule does not apply
#ASSERT `o 52 r 2(3) the written notice has been served in time` TRUE TRUE TRUE FALSE (Date 7 7 2026) (Date 7 7 2026) EQUALS JUST TRUE -- served on the last day
#ASSERT `o 52 r 2(3) the written notice has been served in time` TRUE TRUE TRUE FALSE (Date 8 7 2026) (Date 7 7 2026) EQUALS JUST FALSE -- served a day late (fewer than 2 clear days)
#ASSERT `o 52 r 2(3) the written notice has been served in time` TRUE TRUE FALSE FALSE (Date 8 7 2026) (Date 7 7 2026) EQUALS NOTHING -- the duty does not arise
#ASSERT `o 52 r 2(4) the copy of the affidavit is endorsed as it must be` TRUE TRUE EQUALS JUST TRUE -- endorsed in accordance with paragraph (2)
#ASSERT `o 52 r 2(4) the copy of the affidavit is endorsed as it must be` TRUE FALSE EQUALS NOTHING -- not endorsed: a bare "must"
#ASSERT `o 52 r 2(4) the copy of the affidavit is endorsed as it must be` FALSE TRUE EQUALS NOTHING -- not a copy served under paragraph (3)
#ASSERT `o 52 r 2(5) service may be proved by the certificate` TRUE `o 52 r 2(5) the claimant` EQUALS JUST TRUE -- claimant in person, signed by the claimant
#ASSERT `o 52 r 2(5) service may be proved by the certificate` FALSE `o 52 r 2(5) the claimant's solicitor` EQUALS JUST TRUE -- otherwise, signed by the solicitor
#ASSERT `o 52 r 2(5) service may be proved by the certificate` TRUE `o 52 r 2(5) the claimant's solicitor` EQUALS NOTHING -- claimant in person, signed by the solicitor: not within the text
#ASSERT `o 52 r 2(5) service may be proved by the certificate` FALSE `o 52 r 2(5) the claimant` EQUALS NOTHING -- represented, signed by the claimant: not within the text
#ASSERT `o 52 r 2(5) service may be proved by the certificate` TRUE `o 52 r 2(5) someone else` EQUALS NOTHING -- signed by someone else
-- Rule 3 (lines 6506 to 6514)
#ASSERT `o 52 r 3(2) this Rule applies to the action` TRUE `Originating application` TRUE TRUE FALSE EQUALS JUST TRUE -- possession claim
#ASSERT `o 52 r 3(2) this Rule applies to the action` TRUE `Originating application` TRUE FALSE TRUE EQUALS JUST TRUE -- payment claim
#ASSERT `o 52 r 3(2) this Rule applies to the action` TRUE `Originating claim` TRUE TRUE TRUE EQUALS NOTHING -- begun by originating claim
#ASSERT `o 52 r 3(2) this Rule applies to the action` TRUE `Originating application` FALSE TRUE TRUE EQUALS NOTHING -- the claimant is not the mortgagee
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE TRUE FALSE FALSE FALSE (`o 52 r 3 what the affidavit contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE -- possession claim, everything shown
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE TRUE FALSE FALSE FALSE (`o 52 r 3 what the affidavit contains` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- r 3(3): no true copy of the mortgage exhibited
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE TRUE FALSE FALSE FALSE (`o 52 r 3 what the affidavit contains` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- r 3(4): circumstances of the right to possession not shown
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE TRUE FALSE FALSE FALSE (`o 52 r 3 what the affidavit contains` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- r 3(4)(a): arrears not particularised
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE TRUE FALSE FALSE FALSE (`o 52 r 3 what the affidavit contains` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS NOTHING -- r 3(4)(b): amount remaining due not particularised
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE TRUE FALSE FALSE TRUE (`o 52 r 3 what the affidavit contains` OF TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, TRUE) EQUALS JUST TRUE -- the Court has otherwise directed: the state of the account may be left out
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE TRUE FALSE FALSE TRUE (`o 52 r 3 what the affidavit contains` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- a direction on the account does not excuse the circumstances of the right to possession
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE TRUE FALSE FALSE FALSE (`o 52 r 3 what the affidavit contains` OF TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS NOTHING -- r 3(5): persons in possession not particularised
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE TRUE FALSE TRUE FALSE (`o 52 r 3 what the affidavit contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE -- tenancy other than at will, determination shown
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE TRUE FALSE TRUE FALSE (`o 52 r 3 what the affidavit contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS NOTHING -- r 3(6): tenancy determination not shown
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE FALSE FALSE FALSE FALSE (`o 52 r 3 what the affidavit contains` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE) EQUALS JUST TRUE -- neither possession nor payment claimed: only the copy of the mortgage is needed
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE FALSE TRUE FALSE FALSE (`o 52 r 3 what the affidavit contains` OF TRUE, FALSE, TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS JUST TRUE -- payment claim: proof of money due and the paragraph (4) particulars
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE FALSE TRUE FALSE FALSE (`o 52 r 3 what the affidavit contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING -- r 3(7): proof that the money is due and payable missing
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE FALSE TRUE FALSE FALSE (`o 52 r 3 what the affidavit contains` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- r 3(7): the paragraph (4)(a) particulars missing
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` TRUE FALSE TRUE FALSE TRUE (`o 52 r 3 what the affidavit contains` OF TRUE, TRUE, FALSE, FALSE, TRUE, TRUE, TRUE) EQUALS NOTHING -- r 3(7): a direction under (4) does not excuse the particulars (7) requires (literal reading)
#ASSERT `o 52 r 3(1) the supporting affidavit complies with this Rule` FALSE TRUE FALSE FALSE FALSE (`o 52 r 3 what the affidavit contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- this Rule does not apply to the action
-- Rule 4 (lines 6516 to 6518)
#ASSERT `o 52 r 4(1) Order 6, Rules 6(5) and 7(7) allow judgment in default without permission in the action` TRUE EQUALS JUST FALSE -- "Despite anything in Order 6, Rules 6(5) and 7(7)"
#ASSERT `o 52 r 4(1) Order 6, Rules 6(5) and 7(7) allow judgment in default without permission in the action` FALSE EQUALS NOTHING -- not a mortgage action begun by originating claim
#ASSERT `o 52 r 4(1) entry of the judgment in default is barred` TRUE TRUE FALSE EQUALS JUST TRUE -- judgment in default, no permission
#ASSERT `o 52 r 4(1) entry of the judgment in default is barred` TRUE TRUE TRUE EQUALS JUST FALSE -- "except with the permission of the Court"
#ASSERT `o 52 r 4(1) entry of the judgment in default is barred` FALSE TRUE FALSE EQUALS NOTHING -- not begun by originating claim
#ASSERT `o 52 r 4(1) the judgment in default may be entered` TRUE TRUE FALSE EQUALS JUST FALSE -- "must not be entered except with the permission"
#ASSERT `o 52 r 4(1) the judgment in default may be entered` TRUE TRUE TRUE EQUALS NOTHING -- permission lifts the bar and grants nothing (QA)
#ASSERT `o 52 r 4(2) the application for permission is made by summons as it must be` TRUE `Summons` EQUALS JUST TRUE -- made by summons
#ASSERT `o 52 r 4(2) the application for permission is made by summons as it must be` TRUE `Originating application` EQUALS NOTHING -- not by summons: a bare "must"
-- (2): hearing of the summons on 20 July 2026 (Monday); 4 clear days before: the last day for service is 15 July 2026
#ASSERT `o 52 r 4(2) the period before the hearing of the summons`'s `period length` EQUALS 4 -- "at least 4 clear days"
#ASSERT `o 52 r 4(2) the period before the hearing of the summons`'s `period unit` EQUALS `Clear days` -- "4 clear days"
#ASSERT `o 52 r 4(2) the duty to serve the summons on the defendant arises` TRUE FALSE EQUALS JUST TRUE -- no contrary order
#ASSERT `o 52 r 4(2) the duty to serve the summons on the defendant arises` TRUE TRUE EQUALS JUST FALSE -- "unless the Court otherwise orders"
#ASSERT `o 52 r 4(2) the summons has been served in time` TRUE FALSE (Date 15 7 2026) (Date 15 7 2026) EQUALS JUST TRUE -- served on the last day
#ASSERT `o 52 r 4(2) the summons has been served in time` TRUE FALSE (Date 16 7 2026) (Date 15 7 2026) EQUALS JUST FALSE -- a day late (fewer than 4 clear days)
#ASSERT `o 52 r 4(2) the summons has been served in time` TRUE TRUE (Date 16 7 2026) (Date 15 7 2026) EQUALS NOTHING -- the Court ordered otherwise: nothing to comply with
#ASSERT `o 52 r 4(3) Rule 2(2), (3), (4) and (5) applies in relation to the action with the summons in place of the originating application` TRUE EQUALS JUST TRUE -- a summons for permission is issued
#ASSERT `o 52 r 4(3) Rule 2(2), (3), (4) and (5) applies in relation to the action with the summons in place of the originating application` FALSE EQUALS JUST FALSE -- no summons: the "where" fails
#ASSERT `o 52 r 4(4) the duty to put the information required by Rule 3 in the affidavit in support arises` TRUE TRUE EQUALS JUST TRUE -- summons issued in an action to which Rule 3 would apply
#ASSERT `o 52 r 4(4) the duty to put the information required by Rule 3 in the affidavit in support arises` TRUE FALSE EQUALS JUST FALSE -- Rule 3 would not apply: the "where" fails
#ASSERT `o 52 r 4(4) the affidavit in support contains the information as it must` TRUE TRUE TRUE EQUALS JUST TRUE -- contains it
#ASSERT `o 52 r 4(4) the affidavit in support contains the information as it must` TRUE TRUE FALSE EQUALS NOTHING -- does not: a bare "must"
#ASSERT `o 52 r 4(4) the affidavit in support contains the information as it must` TRUE FALSE FALSE EQUALS NOTHING -- the duty does not arise
-- Rule 5 (line 6520)
#ASSERT `o 52 r 5 the defendant may apply by summons for an order for delivery of possession` TRUE TRUE EQUALS JUST TRUE -- foreclosure in the defendant's favour after the claimant failed to redeem
#ASSERT `o 52 r 5 the defendant may apply by summons for an order for delivery of possession` TRUE FALSE EQUALS JUST FALSE -- foreclosure not in the defendant's favour
#ASSERT `o 52 r 5 the defendant may apply by summons for an order for delivery of possession` FALSE TRUE EQUALS JUST FALSE -- no foreclosure on the claimant's failure to redeem: the "where" fails
#ASSERT `o 52 r 5 the Court may make such order on the application as it thinks fit` TRUE EQUALS JUST TRUE -- on the application
#ASSERT `o 52 r 5 the Court may make such order on the application as it thinks fit` FALSE EQUALS JUST FALSE -- no application: the "on" fails
