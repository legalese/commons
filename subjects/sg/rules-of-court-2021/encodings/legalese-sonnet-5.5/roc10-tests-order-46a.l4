IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc10-order-46a`

-- Rules of Court 2021 (Singapore), Order 46A (Express Track): TESTS.
-- Every expected value is written beside its assertion from the text of the rule it cites
-- (lines 6128 to 6174 of the text), never copied from the output of the code.
-- The last day of each period is the seam input `o 3 r 3 the last day for doing the act`; the tests use last days worked
-- out by hand under O 3 r 3(3) ("the period begins immediately after that date"), r 3(2) (a calendar month) and r 3(4).

-- ---------------------------------------------------------------------------
-- Rule 1(1) (line 6131): applies to "any action in the General Division that is placed on the Express Track in accordance with paragraph (2)".
-- ---------------------------------------------------------------------------
#ASSERT `o 46A r 1(1) this Order applies to the action` `General Division` TRUE EQUALS JUST TRUE -- GD action placed on the Express Track
#ASSERT `o 46A r 1(1) this Order applies to the action` `General Division` FALSE EQUALS NOTHING -- GD action not placed: outside the scope, not covered
#ASSERT `o 46A r 1(1) this Order applies to the action` `District Court` TRUE EQUALS NOTHING -- a District Court action: outside the scope, not covered
#ASSERT `o 46A r 1(1) this Order applies to the action` `Appellate Division` FALSE EQUALS NOTHING -- not a General Division action

-- ---------------------------------------------------------------------------
-- Rule 1(2) (line 6131): request "no later than 2 months after the filing of the last pleading".
-- Last pleading filed 10 March 2026: the 2 months begin on 11 March (O 3 r 3(3)) and end on 10 May 2026.
-- A Sunday is a non-court day, so the last day is Monday 11 May 2026 (O 3 r 3(7)): the tests use 11 May 2026.
-- ---------------------------------------------------------------------------
#ASSERT `o 46A r 1(2) the period for the request`'s `period length` EQUALS 2 -- "2 months"
#ASSERT `o 46A r 1(2) the period for the request`'s `period unit` EQUALS Months -- "2 months"
#ASSERT `o 46A r 1(2) the Court may place the action on the Express Track` `General Division` `Originating claim` TRUE (Date 11 5 2026) (Date 11 5 2026) EQUALS JUST TRUE -- by consent, on the last day: in time
#ASSERT `o 46A r 1(2) the Court may place the action on the Express Track` `General Division` `Originating claim` TRUE (Date 10 5 2026) (Date 11 5 2026) EQUALS JUST TRUE -- by consent, the day before the last day
#ASSERT `o 46A r 1(2) the Court may place the action on the Express Track` `General Division` `Originating claim` TRUE (Date 12 5 2026) (Date 11 5 2026) EQUALS JUST FALSE -- one day after the last day: "no later than 2 months"
#ASSERT `o 46A r 1(2) the Court may place the action on the Express Track` `General Division` `Originating claim` FALSE (Date 11 5 2026) (Date 11 5 2026) EQUALS NOTHING -- not by all parties by consent: the grant is limited by its own wording
#ASSERT `o 46A r 1(2) the Court may place the action on the Express Track` `General Division` `Originating claim` FALSE (Date 12 5 2026) (Date 11 5 2026) EQUALS JUST FALSE -- late and not by consent: the period is the text's no
#ASSERT `o 46A r 1(2) the Court may place the action on the Express Track` `General Division` `Originating application` TRUE (Date 11 5 2026) (Date 11 5 2026) EQUALS JUST FALSE -- commenced by originating application: the "where" fails
#ASSERT `o 46A r 1(2) the Court may place the action on the Express Track` `District Court` `Originating claim` TRUE (Date 11 5 2026) (Date 11 5 2026) EQUALS JUST FALSE -- not in the General Division: the "where" fails

-- ---------------------------------------------------------------------------
-- Rule 1(3) (line 6132): removal "no later than 14 days before the commencement of the trial", "if the Court determines that it is no longer suitable".
-- Trial begins 20 July 2026: the period ends immediately before that date (O 3 r 3(4)): the last day is 6 July 2026 (a Monday).
-- ---------------------------------------------------------------------------
#ASSERT `o 46A r 1(3) the period before the trial`'s `period length` EQUALS 14 -- "14 days"
#ASSERT `o 46A r 1(3) the period before the trial`'s `period direction` EQUALS `Before the anchor` -- "before the commencement of the trial"
#ASSERT `o 46A r 1(3) the Court may order the removal of the action from the Express Track` TRUE (Date 6 7 2026) (Date 6 7 2026) TRUE EQUALS JUST TRUE -- on the last day, unsuitable
#ASSERT `o 46A r 1(3) the Court may order the removal of the action from the Express Track` TRUE (Date 7 7 2026) (Date 6 7 2026) TRUE EQUALS JUST FALSE -- one day too late
#ASSERT `o 46A r 1(3) the Court may order the removal of the action from the Express Track` FALSE (Date 6 7 2026) (Date 6 7 2026) TRUE EQUALS JUST FALSE -- not placed on the Express Track: the "where" fails
#ASSERT `o 46A r 1(3) the Court may order the removal of the action from the Express Track` TRUE (Date 6 7 2026) (Date 6 7 2026) FALSE EQUALS JUST FALSE -- the Court has not determined unsuitability: the "if" fails

-- ---------------------------------------------------------------------------
-- Rule 1(4) (line 6133): "the decision of the Judge is final".  Sitting OF level, decision-maker.
-- ---------------------------------------------------------------------------
#ASSERT `o 46A r 1(4) the decision of the Judge is final` (Sitting OF `General Division`, `A Judge`) `o 46A r 1(4) an order under paragraph (3)` EQUALS JUST TRUE -- a Judge in the General Division made an order under (3)
#ASSERT `o 46A r 1(4) the decision of the Judge is final` (Sitting OF `General Division`, `A Judge`) `o 46A r 1(4) a refusal of an order under paragraph (2) despite a request under that paragraph` EQUALS JUST TRUE -- the Judge declined despite a request
#ASSERT `o 46A r 1(4) the decision of the Judge is final` (Sitting OF `General Division`, `A Judge`) `o 46A r 1(4) any other decision` EQUALS JUST FALSE -- another decision: the "where" fails
#ASSERT `o 46A r 1(4) the decision of the Judge is final` (Sitting OF `District Court`, `A District Judge`) `o 46A r 1(4) an order under paragraph (3)` EQUALS JUST FALSE -- not a Judge sitting in the General Division: the "where" fails
#ASSERT `o 46A r 1(4) the decision of the Judge is final` (Sitting OF `General Division`, `The Registrar`) `o 46A r 1(4) an order under paragraph (3)` EQUALS NOTHING -- the Registrar is within "Judge" only where empowered (O 1 r 3(1)): not covered on these facts
#ASSERT `o 46A r 1(4) the decision of the Judge is final` (Sitting OF `Appellate Division`, `A Judge`) `o 46A r 1(4) an order under paragraph (3)` EQUALS JUST FALSE -- a judge sitting in the Appellate Division, not the General Division: the "where" fails

-- ---------------------------------------------------------------------------
-- Rule 1(5) (line 6134): the bar on appeals in an Express Track action.
-- ---------------------------------------------------------------------------
#ASSERT `o 46A r 1(5) paragraph 4(1) of the Fourth Schedule to the Supreme Court of Judicature Act 1969 applies to the action` TRUE EQUALS JUST TRUE -- on the Express Track
#ASSERT `o 46A r 1(5) paragraph 4(1) of the Fourth Schedule to the Supreme Court of Judicature Act 1969 applies to the action` FALSE EQUALS JUST FALSE -- not on the Express Track: the "where" fails
#ASSERT `o 46A r 1(5) an appeal is barred under this paragraph` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE -- on the Express Track, a Judge's decision, no circumstances: barred
#ASSERT `o 46A r 1(5) an appeal is barred under this paragraph` TRUE TRUE (JUST TRUE) EQUALS JUST FALSE -- the circumstances exist: "except in the circumstances" lifts the bar
#ASSERT `o 46A r 1(5) an appeal is barred under this paragraph` TRUE TRUE NOTHING EQUALS NOTHING -- the circumstances are in the Supreme Court of Judicature Act: not supplied, not covered
#ASSERT `o 46A r 1(5) an appeal is barred under this paragraph` FALSE TRUE (JUST FALSE) EQUALS JUST FALSE -- not on the Express Track: the "where" fails
#ASSERT `o 46A r 1(5) an appeal is barred under this paragraph` TRUE FALSE (JUST FALSE) EQUALS NOTHING -- not a decision of a Judge: outside the scope of the bar
#ASSERT `o 46A r 1(5) an appeal can be brought against the decision under this paragraph` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE -- barred: "an appeal cannot be brought"
#ASSERT `o 46A r 1(5) an appeal can be brought against the decision under this paragraph` TRUE TRUE (JUST TRUE) EQUALS NOTHING -- the exception lifts the bar and grants nothing (QA)
#ASSERT `o 46A r 1(5) an appeal can be brought against the decision under this paragraph` TRUE TRUE NOTHING EQUALS NOTHING -- circumstances not supplied
#ASSERT `o 46A r 1(5) an appeal can be brought against the decision under this paragraph` FALSE TRUE (JUST FALSE) EQUALS NOTHING -- the bar is not engaged, so nothing is granted either

-- ---------------------------------------------------------------------------
-- Rule 1(6) (line 6135): "Except as otherwise provided in this Order, all the other Orders ... continue to apply"
-- ---------------------------------------------------------------------------
#ASSERT `o 46A r 1(6) another Order continues to apply to the proceedings` TRUE FALSE EQUALS JUST TRUE -- an Express Track action, nothing otherwise provided
#ASSERT `o 46A r 1(6) another Order continues to apply to the proceedings` TRUE TRUE EQUALS JUST FALSE -- this Order provides otherwise
#ASSERT `o 46A r 1(6) another Order continues to apply to the proceedings` FALSE FALSE EQUALS NOTHING -- not proceedings to which this Order applies: outside the scope

-- ---------------------------------------------------------------------------
-- Rule 1(7) (lines 6136 to 6141): placing on and removal from the Express Track, by dates.
-- ---------------------------------------------------------------------------
#ASSERT `o 46A r 1(7)(a) this Order applies to and in relation to the action on the date in question` (JUST (Date 1 6 2026)) (Date 1 6 2026) EQUALS JUST TRUE -- on the day of the order: "on and after the making of the order"
#ASSERT `o 46A r 1(7)(a) this Order applies to and in relation to the action on the date in question` (JUST (Date 1 6 2026)) (Date 2 6 2026) EQUALS JUST TRUE -- after the order
#ASSERT `o 46A r 1(7)(a) this Order applies to and in relation to the action on the date in question` (JUST (Date 1 6 2026)) (Date 31 5 2026) EQUALS JUST FALSE -- the day before the order
#ASSERT `o 46A r 1(7)(a) this Order applies to and in relation to the action on the date in question` NOTHING (Date 2 6 2026) EQUALS JUST FALSE -- no order has been made: a "when" condition unmet (fork 46A.5)
#ASSERT `o 46A r 1(7)(b) this Order has ceased to apply to and in relation to the action on the date in question` (JUST (Date 1 8 2026)) (Date 1 8 2026) EQUALS JUST TRUE -- on the day of the removal order: "on and after the making of the order"
#ASSERT `o 46A r 1(7)(b) this Order has ceased to apply to and in relation to the action on the date in question` (JUST (Date 1 8 2026)) (Date 31 7 2026) EQUALS JUST FALSE -- the day before the removal order
#ASSERT `o 46A r 1(7)(b) this Order has ceased to apply to and in relation to the action on the date in question` NOTHING (Date 1 8 2026) EQUALS JUST FALSE -- no removal order has been made: a "when" condition unmet (fork 46A.5)
#ASSERT `o 46A r 1(7)(c) the action is on the Express Track on the date in question` (JUST (Date 1 6 2026)) NOTHING (Date 15 6 2026) EQUALS JUST TRUE -- placed on 1 June, not removed: on the Express Track on 15 June
#ASSERT `o 46A r 1(7)(c) the action is on the Express Track on the date in question` (JUST (Date 1 6 2026)) (JUST (Date 1 8 2026)) (Date 31 7 2026) EQUALS JUST TRUE -- the day before the removal order
#ASSERT `o 46A r 1(7)(c) the action is on the Express Track on the date in question` (JUST (Date 1 6 2026)) (JUST (Date 1 8 2026)) (Date 1 8 2026) EQUALS JUST FALSE -- on the day of the removal order the Order ceases to apply
#ASSERT `o 46A r 1(7)(c) the action is on the Express Track on the date in question` (JUST (Date 1 6 2026)) NOTHING (Date 31 5 2026) EQUALS JUST FALSE -- before the placing order
#ASSERT `o 46A r 1(7)(c) the action is on the Express Track on the date in question` NOTHING NOTHING (Date 15 6 2026) EQUALS JUST FALSE -- no order placing the action on the Express Track: a "when" condition unmet (fork 46A.5)

-- ---------------------------------------------------------------------------
-- Rule 2 (lines 6143 to 6146): documents with pleadings.
-- ---------------------------------------------------------------------------
-- (a) arguments: Court otherwise ordered, placed under Rule 1(2), date pleading served, date placed.
#ASSERT `o 46A r 2(a) the duty to accompany the pleading with a list and a copy arises` FALSE TRUE (Date 2 6 2026) (Date 1 6 2026) EQUALS JUST TRUE -- a pleading served after the action was placed
#ASSERT `o 46A r 2(a) the duty to accompany the pleading with a list and a copy arises` FALSE TRUE (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST TRUE -- a pleading served "on" the day it is placed
#ASSERT `o 46A r 2(a) the duty to accompany the pleading with a list and a copy arises` FALSE TRUE (Date 31 5 2026) (Date 1 6 2026) EQUALS JUST FALSE -- served before the action was placed: paragraph (b) applies, not (a)
#ASSERT `o 46A r 2(a) the duty to accompany the pleading with a list and a copy arises` TRUE TRUE (Date 2 6 2026) (Date 1 6 2026) EQUALS JUST FALSE -- "Unless the Court otherwise orders"
#ASSERT `o 46A r 2(a) the duty to accompany the pleading with a list and a copy arises` FALSE FALSE (Date 2 6 2026) (Date 1 6 2026) EQUALS JUST FALSE -- not placed under Rule 1(2): the "where" fails
-- compliance arguments: ordered otherwise, placed, served, placed on, list, copy.
#ASSERT `o 46A r 2(a) the pleading is accompanied by a list of and a copy of every document relied on` FALSE TRUE (Date 2 6 2026) (Date 1 6 2026) TRUE TRUE EQUALS JUST TRUE -- list and copy supplied
#ASSERT `o 46A r 2(a) the pleading is accompanied by a list of and a copy of every document relied on` FALSE TRUE (Date 2 6 2026) (Date 1 6 2026) TRUE FALSE EQUALS NOTHING -- a copy missing: a bare "must", not done
#ASSERT `o 46A r 2(a) the pleading is accompanied by a list of and a copy of every document relied on` FALSE TRUE (Date 2 6 2026) (Date 1 6 2026) FALSE TRUE EQUALS NOTHING -- a list missing
#ASSERT `o 46A r 2(a) the pleading is accompanied by a list of and a copy of every document relied on` TRUE TRUE (Date 2 6 2026) (Date 1 6 2026) FALSE FALSE EQUALS NOTHING -- the duty does not arise (the Court ordered otherwise)
-- (b): placed on 1 June 2026; 14 days after begin on 2 June, so the last day is 15 June 2026 (a Monday).
#ASSERT `o 46A r 2(b) the period to serve the list and the copies`'s `period length` EQUALS 14 -- "within 14 days"
#ASSERT `o 46A r 2(b) the duty to serve a list and copies arises` FALSE TRUE TRUE EQUALS JUST TRUE -- a pleading served before the action was placed
#ASSERT `o 46A r 2(b) the duty to serve a list and copies arises` FALSE TRUE FALSE EQUALS JUST FALSE -- no pleading served before: the "where" fails
#ASSERT `o 46A r 2(b) the duty to serve a list and copies arises` TRUE TRUE TRUE EQUALS JUST FALSE -- "Unless the Court otherwise orders"
#ASSERT `o 46A r 2(b) the duty to serve a list and copies arises` FALSE FALSE TRUE EQUALS JUST FALSE -- not placed under Rule 1(2)
#ASSERT `o 46A r 2(b) the list and copies are served as required` FALSE TRUE TRUE (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- served on the last day
#ASSERT `o 46A r 2(b) the list and copies are served as required` FALSE TRUE TRUE (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- served one day late: "within 14 days after"
#ASSERT `o 46A r 2(b) the list and copies are served as required` FALSE TRUE FALSE (Date 10 6 2026) (Date 15 6 2026) EQUALS NOTHING -- the duty does not arise
#ASSERT `o 46A r 2(b) the list and copies are served as required` TRUE TRUE TRUE (Date 10 6 2026) (Date 15 6 2026) EQUALS NOTHING -- the Court ordered otherwise: nothing to comply with

-- ---------------------------------------------------------------------------
-- Rule 3 (lines 6148 to 6157): affidavits of evidence-in-chief.
-- ---------------------------------------------------------------------------
#ASSERT `o 46A r 3(1) Order 9, Rule 8 stops this Rule from applying` EQUALS JUST FALSE -- "This Rule applies despite Order 9, Rule 8"
#ASSERT `o 46A r 3(2) the Court must order every party to file and serve a list of witnesses and affidavits of evidence-in-chief` FALSE TRUE FALSE EQUALS JUST TRUE -- pleadings filed and served, no exchange of documents yet
#ASSERT `o 46A r 3(2) the Court must order every party to file and serve a list of witnesses and affidavits of evidence-in-chief` TRUE TRUE FALSE EQUALS JUST FALSE -- "Unless the Court otherwise orders"
#ASSERT `o 46A r 3(2) the Court must order every party to file and serve a list of witnesses and affidavits of evidence-in-chief` FALSE FALSE FALSE EQUALS JUST FALSE -- pleadings not yet filed and served
#ASSERT `o 46A r 3(2) the Court must order every party to file and serve a list of witnesses and affidavits of evidence-in-chief` FALSE TRUE TRUE EQUALS JUST FALSE -- after an exchange of documents
#ASSERT `o 46A r 3(2)(a) the party's list of witnesses has been filed and served as ordered` FALSE TRUE FALSE TRUE EQUALS JUST TRUE -- the order is due and the list was filed and served
#ASSERT `o 46A r 3(2)(a) the party's list of witnesses has been filed and served as ordered` FALSE TRUE FALSE FALSE EQUALS NOTHING -- the list was not filed: a bare "must"
#ASSERT `o 46A r 3(2)(a) the party's list of witnesses has been filed and served as ordered` TRUE TRUE FALSE TRUE EQUALS NOTHING -- the Court ordered otherwise: no order, nothing to comply with
#ASSERT `o 46A r 3(2)(b) the affidavit of evidence-in-chief of the witness must be filed and served` FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- not dispensed with
#ASSERT `o 46A r 3(2)(b) the affidavit of evidence-in-chief of the witness must be filed and served` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- "unless the Court dispenses with the affidavit"
#ASSERT `o 46A r 3(2)(b) the affidavit of evidence-in-chief of the witness must be filed and served` FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- the Court has ordered otherwise
#ASSERT `o 46A r 3(3) the page limit for the affidavit of evidence-in-chief of each witness` EQUALS 30 -- "30 pages"
#ASSERT `o 46A r 3(3) the page limit of 30 pages applies` FALSE EQUALS JUST TRUE -- no other order
#ASSERT `o 46A r 3(3) the page limit of 30 pages applies` TRUE EQUALS JUST FALSE -- "Unless the Court otherwise orders"
#ASSERT `o 46A r 3(3) the affidavit is within the page limit` FALSE 30 0 EQUALS JUST TRUE -- exactly 30 pages: within the limit
#ASSERT `o 46A r 3(3) the affidavit is within the page limit` FALSE 31 0 EQUALS JUST FALSE -- 31 pages: over the limit
#ASSERT `o 46A r 3(3) the affidavit is within the page limit` FALSE 80 50 EQUALS JUST TRUE -- 80 pages in all, 50 of exhibits: 30 pages "excluding exhibits"
#ASSERT `o 46A r 3(3) the affidavit is within the page limit` FALSE 81 50 EQUALS JUST FALSE -- 31 pages excluding exhibits
#ASSERT `o 46A r 3(3) the affidavit is within the page limit` TRUE 90 0 EQUALS NOTHING -- the Court otherwise ordered: the text states no other limit
#ASSERT `o 46A r 3(4) the Court may allow the page limit to be exceeded` TRUE TRUE FALSE EQUALS JUST TRUE -- special circumstances and the fees paid
#ASSERT `o 46A r 3(4) the Court may allow the page limit to be exceeded` TRUE FALSE TRUE EQUALS JUST TRUE -- special circumstances and the fees waived under paragraph (5)
#ASSERT `o 46A r 3(4) the Court may allow the page limit to be exceeded` TRUE FALSE FALSE EQUALS JUST FALSE -- special circumstances but neither fees paid nor waived: "upon the payment of the fees", and "upon" counts as "where"
#ASSERT `o 46A r 3(4) the Court may allow the page limit to be exceeded` FALSE TRUE FALSE EQUALS NOTHING -- no special circumstances: a limit on the power, fees paid
#ASSERT `o 46A r 3(4) the Court may allow the page limit to be exceeded` FALSE FALSE TRUE EQUALS NOTHING -- no special circumstances, fees waived under paragraph (5)
#ASSERT `o 46A r 3(4) the Court may allow the page limit to be exceeded` FALSE FALSE FALSE EQUALS JUST FALSE -- no special circumstances and the fees neither paid nor waived: the failed "upon" answers first (fork 46A.3)
#ASSERT `o 46A r 3(5) the Court may waive, refund, defer or apportion the payment of the fees` TRUE EQUALS JUST TRUE -- on application
#ASSERT `o 46A r 3(5) the Court may waive, refund, defer or apportion the payment of the fees` FALSE EQUALS JUST FALSE -- no application: "upon application" counts as "where"

-- ---------------------------------------------------------------------------
-- Rule 4 (lines 6159 to 6167): interlocutory applications.
-- ---------------------------------------------------------------------------
#ASSERT `o 46A r 4(1) Order 9, Rule 9 continues to apply to the action` TRUE FALSE EQUALS JUST TRUE -- an Express Track action, nothing otherwise provided in the Rule
#ASSERT `o 46A r 4(1) Order 9, Rule 9 continues to apply to the action` TRUE TRUE EQUALS JUST FALSE -- "Except as otherwise provided in this Rule"
#ASSERT `o 46A r 4(1) Order 9, Rule 9 continues to apply to the action` FALSE FALSE EQUALS NOTHING -- not an Express Track action
#ASSERT `o 46A r 4(2) the Court must give the directions in paragraphs (a) to (d)` TRUE TRUE FALSE EQUALS JUST TRUE -- notified at a case conference: a single application pending trial
#ASSERT `o 46A r 4(2) the Court must give the directions in paragraphs (a) to (d)` TRUE FALSE TRUE EQUALS JUST TRUE -- notified at a case conference: an application in Order 9, Rule 9(7)(a) to (o)
#ASSERT `o 46A r 4(2) the Court must give the directions in paragraphs (a) to (d)` FALSE TRUE FALSE EQUALS JUST FALSE -- not notified at a case conference: the "where" fails
#ASSERT `o 46A r 4(2) the Court must give the directions in paragraphs (a) to (d)` TRUE FALSE FALSE EQUALS JUST FALSE -- notified, but of no application named in the paragraph
-- Case conference on 1 June 2026: 14 days -> 15 June; 28 days -> 29 June; 6 weeks -> 13 July 2026 (each a Monday).
#ASSERT `o 46A r 4(2)(a) the period to file and serve the application and supporting affidavit`'s `period length` EQUALS 14 -- "within 14 days after the date of the case conference"
#ASSERT `o 46A r 4(2)(b) the period to file and serve an affidavit in reply`'s `period length` EQUALS 28 -- "within 28 days"
#ASSERT `o 46A r 4(2)(d) the period to file and serve written submissions and any bundle of authorities`'s `period length` EQUALS 6 -- "within 6 weeks"
#ASSERT `o 46A r 4(2)(d) the period to file and serve written submissions and any bundle of authorities`'s `period unit` EQUALS Weeks -- "within 6 weeks"
#ASSERT `o 46A r 4(2)(a) the application and supporting affidavit are filed and served within the period directed` (Date 15 6 2026) (Date 15 6 2026) EQUALS JUST TRUE -- on the 14th day
#ASSERT `o 46A r 4(2)(a) the application and supporting affidavit are filed and served within the period directed` (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE -- the 15th day: late
#ASSERT `o 46A r 4(2)(b) the affidavit in reply is filed and served within the period directed` (Date 29 6 2026) (Date 29 6 2026) EQUALS JUST TRUE -- on the 28th day
#ASSERT `o 46A r 4(2)(b) the affidavit in reply is filed and served within the period directed` (Date 30 6 2026) (Date 29 6 2026) EQUALS JUST FALSE -- the 29th day: late
#ASSERT `o 46A r 4(2)(c) a further affidavit is barred without the Court's approval` FALSE EQUALS JUST TRUE -- no approval: barred
#ASSERT `o 46A r 4(2)(c) a further affidavit is barred without the Court's approval` TRUE EQUALS JUST FALSE -- approved: "without the Court's approval" no longer bars
#ASSERT `o 46A r 4(2)(c) a further affidavit may be filed` FALSE EQUALS JUST FALSE -- "no further affidavits are to be filed without the Court's approval"
#ASSERT `o 46A r 4(2)(c) a further affidavit may be filed` TRUE EQUALS NOTHING -- approved: the exception lifts the bar and grants nothing (QA)
#ASSERT `o 46A r 4(2)(d) the written submissions and any bundle of authorities are filed and served within the period directed` (Date 13 7 2026) (Date 13 7 2026) EQUALS JUST TRUE -- on the last day of 6 weeks
#ASSERT `o 46A r 4(2)(d) the written submissions and any bundle of authorities are filed and served within the period directed` (Date 14 7 2026) (Date 13 7 2026) EQUALS JUST FALSE -- a day late
#ASSERT `o 46A r 4(3) the application will be decided without hearing oral arguments` TRUE FALSE EQUALS JUST TRUE -- an interlocutory application in an Express Track action
#ASSERT `o 46A r 4(3) the application will be decided without hearing oral arguments` TRUE TRUE EQUALS JUST FALSE -- "unless the Court otherwise orders"
#ASSERT `o 46A r 4(3) the application will be decided without hearing oral arguments` FALSE FALSE EQUALS NOTHING -- not such an application: outside the scope

-- ---------------------------------------------------------------------------
-- Rule 5 (line 6169): trial length and when the trial is fixed.
-- ---------------------------------------------------------------------------
#ASSERT `o 46A r 5(1) the longest trial the Court may direct, in days` EQUALS 4 -- "must not exceed 4 days"
#ASSERT `o 46A r 5(1) the length of the trial directed is within the limit` TRUE 4 EQUALS JUST TRUE -- 4 days: does not exceed
#ASSERT `o 46A r 5(1) the length of the trial directed is within the limit` TRUE 5 EQUALS JUST FALSE -- 5 days: exceeds
#ASSERT `o 46A r 5(1) the length of the trial directed is within the limit` TRUE 0 EQUALS JUST TRUE -- no days
#ASSERT `o 46A r 5(1) the length of the trial directed is within the limit` FALSE 6 EQUALS NOTHING -- not an Express Track action: the rule does not speak
-- Placed on 1 June 2026: 9 months after begin on 2 June 2026 and end on 1 March 2027 (a Monday).
#ASSERT `o 46A r 5(2) the period within which the trial is to be fixed`'s `period length` EQUALS 9 -- "within 9 months"
#ASSERT `o 46A r 5(2) the trial is fixed within 9 months after the action is placed on the Express Track` (Date 1 3 2027) (Date 1 3 2027) EQUALS JUST TRUE -- on the last day
#ASSERT `o 46A r 5(2) the trial is fixed within 9 months after the action is placed on the Express Track` (Date 2 3 2027) (Date 1 3 2027) EQUALS NOTHING -- a day later: "As far as possible" is not the text's no

-- ---------------------------------------------------------------------------
-- Rule 6 (lines 6171 to 6174): closing submissions.
-- ---------------------------------------------------------------------------
#ASSERT `o 46A r 6(1) the parties are to make oral closing submissions at the end of the trial` TRUE FALSE EQUALS JUST TRUE -- an Express Track action, no other order
#ASSERT `o 46A r 6(1) the parties are to make oral closing submissions at the end of the trial` TRUE TRUE EQUALS JUST FALSE -- "Unless the Court otherwise orders"
#ASSERT `o 46A r 6(1) the parties are to make oral closing submissions at the end of the trial` FALSE FALSE EQUALS NOTHING -- not an Express Track action
#ASSERT `o 46A r 6(2)(a) there is to be only one round of written closing submissions` TRUE FALSE 1 EQUALS JUST TRUE -- one round
#ASSERT `o 46A r 6(2)(a) there is to be only one round of written closing submissions` TRUE FALSE 2 EQUALS JUST FALSE -- two rounds: "only one round"
#ASSERT `o 46A r 6(2)(a) there is to be only one round of written closing submissions` FALSE FALSE 1 EQUALS JUST FALSE -- the Court has not ordered written submissions: the "if" fails
#ASSERT `o 46A r 6(2)(a) there is to be only one round of written closing submissions` TRUE TRUE 2 EQUALS JUST FALSE -- the Court otherwise ordered
-- Last day of trial 20 July 2026: 3 weeks after begin on 21 July and end on 10 August 2026 (a Monday).
#ASSERT `o 46A r 6(2)(b) the period for filing and exchanging the written closing submissions`'s `period length` EQUALS 3 -- "within 3 weeks"
#ASSERT `o 46A r 6(2)(b) the written closing submissions are filed and exchanged within 3 weeks after the last day of the trial` TRUE FALSE (Date 10 8 2026) (Date 10 8 2026) EQUALS JUST TRUE -- on the last day
#ASSERT `o 46A r 6(2)(b) the written closing submissions are filed and exchanged within 3 weeks after the last day of the trial` TRUE FALSE (Date 11 8 2026) (Date 10 8 2026) EQUALS JUST FALSE -- a day late
#ASSERT `o 46A r 6(2)(b) the written closing submissions are filed and exchanged within 3 weeks after the last day of the trial` FALSE FALSE (Date 5 8 2026) (Date 10 8 2026) EQUALS JUST FALSE -- the Court has not ordered written submissions
#ASSERT `o 46A r 6(2)(b) the written closing submissions are filed and exchanged within 3 weeks after the last day of the trial` TRUE TRUE (Date 5 8 2026) (Date 10 8 2026) EQUALS JUST FALSE -- "unless the Court otherwise orders"
