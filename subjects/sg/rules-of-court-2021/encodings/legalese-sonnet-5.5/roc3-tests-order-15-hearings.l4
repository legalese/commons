IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc3-order-15-hearings`

-- Tests for Order 15, rules 1 to 8 (src lines 1405-1506).  Expected values are written from the text,
-- decided before running.  Dates: a hearing on Monday 1 December 2025; the 28 days before it end on
-- Monday 3 November 2025 (the last day for service, counted by hand from O 3 r 3(4): the period ends
-- immediately before the hearing date, so the last day is 28 days before it).

-- Rule 1(1)
#ASSERT `o 15 r 1(1) the kind of matter is one that must be heard in chambers` `o 15 r 1(1) a summons` EQUALS TRUE
#ASSERT `o 15 r 1(1) the kind of matter is one that must be heard in chambers` `o 15 r 1(2) a trial in an originating claim` EQUALS FALSE
#ASSERT `o 15 r 1(1) the matter must be heard in chambers` `o 15 r 1(1) an originating application` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 1(1) the matter must be heard in chambers` `o 15 r 1(1) an assessment of damages` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 1(1) the matter must be heard in chambers` `o 15 r 1(1) an appeal to a court other than the Appellate Division or the Court of Appeal` TRUE EQUALS NOTHING -- a written law or practice directions provide otherwise
#ASSERT `o 15 r 1(1) the matter must be heard in chambers` `o 15 r 1(3) an application or appeal to the Appellate Division or the Court of Appeal` FALSE EQUALS NOTHING -- fork 15.1
#ASSERT `o 15 r 1(1) the matter must be heard in chambers` `o 15 r 1 any other matter` FALSE EQUALS NOTHING
-- Rule 1(2)
#ASSERT `o 15 r 1(2) the matter must be heard in open court` `o 15 r 1(2) a trial in an originating claim` EQUALS JUST TRUE
#ASSERT `o 15 r 1(2) the matter must be heard in open court` `o 15 r 1(1) a summons` EQUALS NOTHING
-- Rule 1(3)
#ASSERT `o 15 r 1(3) the matter must be heard in open court` `o 15 r 1(3) an application or appeal to the Appellate Division or the Court of Appeal` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 1(3) the matter must be heard in open court` `o 15 r 1(3) an application or appeal to the Appellate Division or the Court of Appeal` TRUE EQUALS JUST FALSE -- "unless ... otherwise orders"
#ASSERT `o 15 r 1(3) the matter must be heard in open court` `o 15 r 1(1) a summons` FALSE EQUALS NOTHING
-- Rule 1(4) to (8)
#ASSERT `o 15 r 1(4) the Court may order the matter to be heard in the other way` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 1(4) the Court may order the matter to be heard in the other way` TRUE TRUE EQUALS NOTHING -- a written law provides otherwise
#ASSERT `o 15 r 1(4) the Court may order the matter to be heard in the other way` FALSE FALSE EQUALS NOTHING
#ASSERT `o 15 r 1(5) the person may attend the hearing in chambers as of right` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 1(5) the person may attend the hearing in chambers as of right` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 1(5) the person may attend the hearing in chambers as of right` FALSE FALSE EQUALS NOTHING -- a general rule
#ASSERT `o 15 r 1(6) the Court may allow the person to attend the hearing in chambers` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 1(6) the Court may allow the person to attend the hearing in chambers` TRUE FALSE TRUE EQUALS NOTHING -- no security
#ASSERT `o 15 r 1(6) the Court may allow the person to attend the hearing in chambers` FALSE TRUE TRUE EQUALS NOTHING -- no space
#ASSERT `o 15 r 1(6) the Court may allow the person to attend the hearing in chambers` TRUE TRUE FALSE EQUALS NOTHING -- not in the interests of justice
#ASSERT `o 15 r 1(7) the Court may hear the matter in court in private with attendance restricted` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 1(7) the Court may hear the matter in court in private with attendance restricted` TRUE EQUALS NOTHING
#ASSERT `o 15 r 1(8) the person must comply with the practice directions and the Court's directions` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 1(8) the person must comply with the practice directions and the Court's directions` FALSE EQUALS NOTHING

-- Rule 2
#ASSERT `o 15 r 2(1) the Registrar of the Supreme Court has the jurisdiction and powers of a Judge sitting in chambers in the General Division` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 2(1) the Registrar of the Supreme Court has the jurisdiction and powers of a Judge sitting in chambers in the General Division` TRUE EQUALS NOTHING
#ASSERT `o 15 r 2(1) the Registrar of the Supreme Court may hear the matter in open court` FALSE EQUALS JUST FALSE -- "must hear all matters in chambers only"
#ASSERT `o 15 r 2(1) the Registrar of the Supreme Court may hear the matter in open court` TRUE EQUALS NOTHING
#ASSERT `o 15 r 2(2) the Registrar of the Supreme Court may refer the matter to a Judge in the General Division` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 2(2) the Registrar of the Supreme Court may refer the matter to a Judge in the General Division` FALSE EQUALS NOTHING
#ASSERT `o 15 r 2(2) the Judge to whom a matter is referred may hear it or send it back to the Registrar with directions` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 2(2) the Judge to whom a matter is referred may hear it or send it back to the Registrar with directions` FALSE EQUALS NOTHING
#ASSERT `o 15 r 2(3) the directions that bind the Registrar are given by` `Supreme Court` EQUALS `o 15 r 2(1) the Chief Justice`
#ASSERT `o 15 r 2(3) the directions that bind the Registrar are given by` `State Courts` EQUALS `o 15 r 2(3) the Presiding Judge of the State Courts, with the concurrence of the Chief Justice`
#ASSERT `o 15 r 2(3) paragraphs (1) and (2) apply to the Registrar of the State Courts` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 2(3) paragraphs (1) and (2) apply to the Registrar of the State Courts` FALSE EQUALS NOTHING

-- Rule 3
#ASSERT `o 15 r 3(1) the party attends as the Rule requires` TRUE FALSE TRUE EQUALS JUST TRUE -- represented, by solicitor
#ASSERT `o 15 r 3(1) the party attends as the Rule requires` TRUE TRUE FALSE EQUALS JUST FALSE -- represented but attends in person
#ASSERT `o 15 r 3(1) the party attends as the Rule requires` FALSE TRUE FALSE EQUALS JUST TRUE -- not represented, in person
#ASSERT `o 15 r 3(1) the party attends as the Rule requires` FALSE FALSE TRUE EQUALS JUST FALSE -- not represented, only a solicitor
#ASSERT `o 15 r 3(2) the Court may dismiss the party's application, action or appeal or make any other appropriate order against the party` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 3(2) the Court may dismiss the party's application, action or appeal or make any other appropriate order against the party` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 3(3) the Court may dispense with the attendance of the parties or their solicitors and decide the matter on the documents` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 3(3) the Court may dispense with the attendance of the parties or their solicitors and decide the matter on the documents` TRUE FALSE FALSE EQUALS JUST FALSE -- oral evidence, not all consent
#ASSERT `o 15 r 3(3) the Court may dispense with the attendance of the parties or their solicitors and decide the matter on the documents` TRUE TRUE FALSE EQUALS JUST TRUE -- oral evidence but all consent
#ASSERT `o 15 r 3(3) the Court may dispense with the attendance of the parties or their solicitors and decide the matter on the documents` FALSE FALSE TRUE EQUALS JUST FALSE -- to be advertised or published
#ASSERT `o 15 r 3(3) the Court may dispense with the attendance of the parties or their solicitors and decide the matter on the documents` TRUE TRUE TRUE EQUALS JUST FALSE -- advertised: consent does not help under (b)
#ASSERT `o 15 r 3(4) the Court may direct that the matter be heard in an asynchronous manner` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 3(4) the Court may direct that the matter be heard in an asynchronous manner` TRUE TRUE EQUALS JUST FALSE -- inconsistent with the duty to ensure fairness
#ASSERT `o 15 r 3(4) the Court may direct that the matter be heard in an asynchronous manner` FALSE FALSE EQUALS NOTHING -- not a matter decided without oral arguments

-- Rule 4
#ASSERT `o 15 r 4(3) the period before the hearing for serving the order`'s `period length` EQUALS 28
#ASSERT `o 15 r 4(3) the period before the hearing for serving the order`'s `period direction` EQUALS `Before the anchor`
#ASSERT `o 15 r 4(6) the period after the Registrar's decision for the application`'s `period length` EQUALS 14
#ASSERT `o 15 r 4(12) the period before the hearing for serving the order on the Superintendent`'s `period length` EQUALS 14
#ASSERT `o 15 r 4(1) the person may request the Registrar to issue an order to attend court or to produce documents in Form 29` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 4(1) the person may request the Registrar to issue an order to attend court or to produce documents in Form 29` FALSE EQUALS NOTHING
#ASSERT `o 15 r 4(2) the order is as the Rule requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 4(2) the order is as the Rule requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 4(2) the order is as the Rule requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 4(3) the order is served in the way and in time the Rule requires` TRUE TRUE (Date 3 11 2025) (Date 3 11 2025) EQUALS JUST TRUE -- on the last day
#ASSERT `o 15 r 4(3) the order is served in the way and in time the Rule requires` TRUE TRUE (Date 4 11 2025) (Date 3 11 2025) EQUALS JUST FALSE -- a day late
#ASSERT `o 15 r 4(3) the order is served in the way and in time the Rule requires` FALSE TRUE (Date 3 11 2025) (Date 3 11 2025) EQUALS JUST FALSE -- not served by the requesting party
#ASSERT `o 15 r 4(3) the order is served in the way and in time the Rule requires` TRUE FALSE (Date 3 11 2025) (Date 3 11 2025) EQUALS JUST FALSE -- not personal service in Singapore
#ASSERT `o 15 r 4(4) the Registrar may revoke the order` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 4(4) the Registrar may revoke the order` FALSE EQUALS NOTHING
#ASSERT `o 15 r 4(5) the party may apply to a Judge sitting in the General Division or a District Judge for a review of the decision` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 4(5) the party may apply to a Judge sitting in the General Division or a District Judge for a review of the decision` FALSE EQUALS NOTHING
#ASSERT `o 15 r 4(6) the application for review is made as the Rule requires` TRUE (Date 17 11 2025) (Date 17 11 2025) EQUALS JUST TRUE
#ASSERT `o 15 r 4(6) the application for review is made as the Rule requires` TRUE (Date 18 11 2025) (Date 17 11 2025) EQUALS JUST FALSE -- late
#ASSERT `o 15 r 4(6) the application for review is made as the Rule requires` FALSE (Date 17 11 2025) (Date 17 11 2025) EQUALS JUST FALSE -- not by summons with an affidavit
#ASSERT `o 15 r 4(7) the order continues to have effect` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 4(7) the order continues to have effect` TRUE EQUALS JUST FALSE -- hearing concluded
#ASSERT `o 15 r 4(8) the witness need not attend court personally` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 4(8) the witness need not attend court personally` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 4(8) the witness need not attend court personally` FALSE TRUE EQUALS NOTHING -- not served with an order to produce documents only
#ASSERT `o 15 r 4(9) the witness is entitled to claim reasonable compensation for time and expenses from the requesting party` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 4(9) the witness is entitled to claim reasonable compensation for time and expenses from the requesting party` TRUE FALSE EQUALS JUST FALSE -- no request yet
#ASSERT `o 15 r 4(9) the witness is entitled to claim reasonable compensation for time and expenses from the requesting party` FALSE TRUE EQUALS NOTHING -- did not comply
#ASSERT `o 15 r 4(10) the requesting party must include in the letter the name of the prison, the reasons for requiring the witness to attend and an undertaking to pay the prison's costs` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 4(10) the requesting party must include in the letter the name of the prison, the reasons for requiring the witness to attend and an undertaking to pay the prison's costs` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 4(11) the order to attend court is to include the words of paragraph (11)` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 4(11) the order to attend court is to include the words of paragraph (11)` FALSE EQUALS NOTHING
#ASSERT `o 15 r 4(12) the order to attend court is served on the Superintendent of the prison in time` (Date 17 11 2025) (Date 17 11 2025) EQUALS JUST TRUE
#ASSERT `o 15 r 4(12) the order to attend court is served on the Superintendent of the prison in time` (Date 18 11 2025) (Date 17 11 2025) EQUALS JUST FALSE
#ASSERT `o 15 r 4(12) the order to attend court may be served on the Superintendent of the prison by ordinary service` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 4(12) the order to attend court may be served on the Superintendent of the prison by ordinary service` FALSE EQUALS NOTHING
#ASSERT `o 15 r 4(13) the witness must remain outside the courtroom` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 4(13) the witness must remain outside the courtroom` FALSE FALSE TRUE EQUALS JUST FALSE -- called into Court
#ASSERT `o 15 r 4(13) the witness must remain outside the courtroom` TRUE FALSE FALSE EQUALS NOTHING -- a party
#ASSERT `o 15 r 4(13) the witness must remain outside the courtroom` FALSE TRUE FALSE EQUALS NOTHING -- has given evidence
#ASSERT `o 15 r 4(14) the witness may remain in or leave the courtroom` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 4(14) the witness may remain in or leave the courtroom` FALSE EQUALS NOTHING
#ASSERT `o 15 r 4(15) the requesting party may request the Registrar to produce the document or the Court's records` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 4(15) the requesting party may request the Registrar to produce the document or the Court's records` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 4(16) it is sufficient for the Registrar to produce a copy of the document or the records requested` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 4(16) it is sufficient for the Registrar to produce a copy of the document or the records requested` FALSE EQUALS NOTHING -- the paragraph speaks of a copy and does not say what is sufficient otherwise
#ASSERT `o 15 r 4(1) the form of the order to attend court or to produce documents` EQUALS "Form 29"
#ASSERT `o 15 r 5(1) the form of the application for the issue of a letter of request` EQUALS "Form 30"

-- Rule 5
#ASSERT `o 15 r 5(1) an application may be made for an order in Form 30 for the issue of a letter of request` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 5(1) an application may be made for an order in Form 30 for the issue of a letter of request` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 5(1) an application may be made for an order in Form 30 for the issue of a letter of request` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 5(2) the application may be made in the court` `General Division` EQUALS JUST TRUE
#ASSERT `o 15 r 5(2) the application may be made in the court` `District Court` EQUALS JUST FALSE -- "may only be made in the General Division even if the proceedings are commenced in the State Courts"
#ASSERT `o 15 r 5(3) the application is made as the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 5(3) the application is made as the Rule requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 5(3) the application is made as the Rule requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 5(4) paragraphs (5) to (8) apply` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 5(4) paragraphs (5) to (8) apply` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 5(5) the letter of request must be in` TRUE EQUALS `o 15 r 5(5)(a) the current version of the applicable Recommended Model Form`
#ASSERT `o 15 r 5(5) the letter of request must be in` FALSE EQUALS `o 15 r 5(5)(b) Form 17`
#ASSERT `o 15 r 5(6) a translation must accompany the letter of request or a document attached to it` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 5(6) a translation must accompany the letter of request or a document attached to it` TRUE EQUALS JUST FALSE -- the jurisdiction accepts English
#ASSERT `o 15 r 5(7) the translation is certified as the Rule requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 5(7) the translation is certified as the Rule requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- no address
#ASSERT `o 15 r 5(7) the translation is certified as the Rule requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- not certified
#ASSERT `o 15 r 5(8) the party obtaining the order must also file an undertaking in Form 18` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 5(8) the party obtaining the order must also file an undertaking in Form 18` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 5(8) the undertaking is signed as the Rule requires` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 5(8) the undertaking is signed as the Rule requires` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 5(8) the undertaking is signed as the Rule requires` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 5(9) the meaning of the term in this Rule` `o 15 r 5(9) Hague Evidence Convention` EQUALS "the Convention on the Taking of Evidence Abroad in Civil or Commercial Matters done at the Hague on 18 March 1970"
#ASSERT `o 15 r 5(9) the meaning of the term in this Rule` `o 15 r 5(9) issuing authority` EQUALS "an authority responsible for issuing a letter of request under this Rule"
#ASSERT `o 15 r 5(9) the meaning of the term in this Rule` `o 15 r 5(9) transmitting authority` EQUALS "an authority responsible for transmitting a letter of request issued under this Rule to the relevant authorities of the jurisdiction in which the evidence is to be taken"
#ASSERT `o 15 r 5(9) an instrument is the Hague Evidence Convention` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 5(9) an instrument is the Hague Evidence Convention` FALSE EQUALS JUST FALSE -- "means"
#ASSERT `o 15 r 5(9) an authority is an issuing authority` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 5(9) an authority is an issuing authority` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 5(9) a form is a Recommended Model Form` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 5(9) a form is a Recommended Model Form` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 5(9) an authority is a transmitting authority` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 5(9) an authority is a transmitting authority` FALSE EQUALS JUST FALSE

-- Rule 6
#ASSERT `o 15 r 6(1) the person may attend the hearing` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 6(1) the person may attend the hearing` FALSE EQUALS NOTHING -- a hearing in chambers: paragraph (1) is silent
#ASSERT `o 15 r 6(2) the Court may disallow the person to attend the hearing` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 6(2) the Court may disallow the person to attend the hearing` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 6(2) the Court may disallow the person to attend the hearing` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 6(2) the Court may disallow the person to attend the hearing` FALSE FALSE FALSE EQUALS JUST FALSE

-- Rule 7
#ASSERT `o 15 r 7(1) the originating application must be heard by one Judge` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 7(1) the originating application must be heard by one Judge` TRUE EQUALS NOTHING
#ASSERT `o 15 r 7(2) the Judge may hear the matter with the assistance of assessors` 1 EQUALS JUST TRUE
#ASSERT `o 15 r 7(2) the Judge may hear the matter with the assistance of assessors` 2 EQUALS JUST TRUE
#ASSERT `o 15 r 7(2) the Judge may hear the matter with the assistance of assessors` 3 EQUALS NOTHING
#ASSERT `o 15 r 7(2) the Judge may hear the matter with the assistance of assessors` 0 EQUALS NOTHING
#ASSERT `o 15 r 7(3) the Court may dismiss the matter` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 7(3) the Court may dismiss the matter` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 7(4) the Court may proceed with the hearing, give judgment against or dismiss the claim of the absent party, or make any other appropriate order` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 7(4) the Court may proceed with the hearing, give judgment against or dismiss the claim of the absent party, or make any other appropriate order` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 7(5) the originating application or summons must be decided on affidavits and submissions without oral evidence or cross-examination` FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 7(5) the originating application or summons must be decided on affidavits and submissions without oral evidence or cross-examination` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 7(5) the originating application or summons must be decided on affidavits and submissions without oral evidence or cross-examination` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 7(6) the Court may order further affidavits, cross-examination of the makers, conversion into an originating claim, or any other appropriate order` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 7(6) the Court may order further affidavits, cross-examination of the makers, conversion into an originating claim, or any other appropriate order` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 7(7) the Court may give its decision immediately after the hearing or at a later date` EQUALS JUST TRUE

-- Rule 8
#ASSERT `o 15 r 8(1) the trial must be heard by one Judge` FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 8(1) the trial must be heard by one Judge` TRUE FALSE EQUALS NOTHING
#ASSERT `o 15 r 8(1) the trial must be heard by one Judge` FALSE TRUE EQUALS NOTHING
#ASSERT `o 15 r 8(2) the Judge may hear the trial or part of it with the assistance of assessors` 2 EQUALS JUST TRUE
#ASSERT `o 15 r 8(2) the Judge may hear the trial or part of it with the assistance of assessors` 3 EQUALS NOTHING
#ASSERT `o 15 r 8(3) the Court may dismiss the claim and any counterclaim` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 8(3) the Court may dismiss the claim and any counterclaim` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 8(4) the Court may proceed with the trial, give judgment against or dismiss the claim of the absent party, or make any other appropriate order` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 8(4) the Court may proceed with the trial, give judgment against or dismiss the claim of the absent party, or make any other appropriate order` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 8(5) the order of proceedings in paragraphs (6) to (13) applies` FALSE EQUALS JUST TRUE
#ASSERT `o 15 r 8(5) the order of proceedings in paragraphs (6) to (13) applies` TRUE EQUALS NOTHING
#ASSERT `o 15 r 8(6) the opening statements and affidavits of evidence-in-chief must be read out in Court` FALSE EQUALS JUST FALSE -- "need not be read out in Court"
#ASSERT `o 15 r 8(6) the opening statements and affidavits of evidence-in-chief must be read out in Court` TRUE EQUALS NOTHING
#ASSERT `o 15 r 8(7) the claimant's evidence is given in the order the Rule requires` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 8(7) the claimant's evidence is given in the order the Rule requires` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 8(8) the person may cross-examine the claimant and the claimant's witnesses` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 8(8) the person may cross-examine the claimant and the claimant's witnesses` FALSE EQUALS NOTHING
#ASSERT `o 15 r 8(9) the defendant's evidence is given in the order the Rule requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 8(9) the defendant's evidence is given in the order the Rule requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 8(9) the defendant's evidence is given in the order the Rule requires` FALSE TRUE EQUALS JUST FALSE -- the claimant's evidence is not yet complete
#ASSERT `o 15 r 8(10) the person may cross-examine the defendant and the defendant's witnesses` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 8(10) the person may cross-examine the defendant and the defendant's witnesses` FALSE EQUALS NOTHING
#ASSERT `o 15 r 8(11) the defendant may make a submission of No case to answer` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 8(11) the defendant may make a submission of No case to answer` FALSE TRUE TRUE EQUALS NOTHING -- not the conclusion of the claimant's case
#ASSERT `o 15 r 8(11) the defendant may make a submission of No case to answer` TRUE FALSE TRUE EQUALS JUST FALSE -- the defendant will give evidence: condition (a) of the submission fails
#ASSERT `o 15 r 8(11) the defendant may make a submission of No case to answer` TRUE TRUE FALSE EQUALS JUST FALSE -- a related counterclaim is kept: condition (b) of the submission fails
#ASSERT `o 15 r 8(11) the defendant may make a submission of No case to answer` TRUE FALSE FALSE EQUALS JUST FALSE -- both conditions fail
#ASSERT `o 15 r 8(11) the defendant may make a submission of No case to answer` FALSE FALSE FALSE EQUALS NOTHING -- not the conclusion of the claimant's case: the occasion phrase answers first
#ASSERT `o 15 r 8(11)(c) the defendant who makes the submission may rely on the evidence of another party or cross-examine a party or witness who gives evidence after it` TRUE TRUE EQUALS JUST FALSE
#ASSERT `o 15 r 8(11)(c) the defendant who makes the submission may rely on the evidence of another party or cross-examine a party or witness who gives evidence after it` TRUE FALSE EQUALS NOTHING
#ASSERT `o 15 r 8(11)(c) the defendant who makes the submission may rely on the evidence of another party or cross-examine a party or witness who gives evidence after it` FALSE TRUE EQUALS NOTHING
#ASSERT `o 15 r 8(11)(d) the defendant who makes the submission may rely on the evidence of experts` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 8(11)(d) the defendant who makes the submission may rely on the evidence of experts` FALSE EQUALS JUST FALSE
#ASSERT `o 15 r 8(11)(e) the defendant who makes the submission may make submissions on the costs of the action` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 8(11)(e) the defendant who makes the submission may make submissions on the costs of the action` FALSE EQUALS NOTHING
#ASSERT `o 15 r 8(12) the Court must hear the submissions of all the parties` TRUE EQUALS JUST TRUE
#ASSERT `o 15 r 8(12) the Court must hear the submissions of all the parties` FALSE EQUALS NOTHING
#ASSERT `o 15 r 8(13) the Court may give its decision immediately after the hearing or at a later date` EQUALS JUST TRUE
