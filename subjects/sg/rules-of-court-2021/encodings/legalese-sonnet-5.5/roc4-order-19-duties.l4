-- ===========================================================================
§ `Order 19 -- more timed duties, and the bars that name the respondent`
-- ===========================================================================

-- More parties and acts, each named for the first provision that uses it.
DECLARE `o 19 duties more party` IS ONE OF
    `o 19 r 15(1) the party who needs permission to appeal`
    `o 19 r 26(8) the party who opposes the application for permission`
    `o 19 r 35(14) the applicant`
    `o 19 r 36 the applicant for the permission`
    `o 19 r 17(9) the respondent`

DECLARE `o 19 duties more act` IS ONE OF
    `o 19 r 15(1) apply to the lower Court for permission to appeal and serve the application`
    `o 19 r 15(3) file and serve the notice of appeal after permission is granted`
    `o 19 r 26(1) apply to the appellate Court for permission to appeal and file and serve the application and the documents mentioned in paragraph (7)`
    `o 19 r 26(8) file and serve written submissions and any accompanying bundle of authorities in opposition`
    `o 19 r 26(17) file and serve the notice of appeal after permission is granted`
    `o 19 r 30(4) file and serve the documents mentioned in paragraph (4) or, on an appeal from the Appellate Division, paragraph (5)`
    `o 19 r 30(9) file and serve the respondent's Case, the respondent's core bundle of documents (if necessary) and the respondent's bundle of authorities`
    `o 19 r 30(11) file and serve the appellant's Reply (if any), the second core bundle (if necessary) and the appellant's second bundle of authorities (if any)`
    `o 19 r 35(14) file and serve the summons and the supporting affidavit`
    `o 19 r 36 file and serve the application for permission`
    `o 19 r 17(9) make submissions at the hearing of the appeal`
    `o 19 r 18(3) make the submissions mentioned in paragraph (2)(d)`

