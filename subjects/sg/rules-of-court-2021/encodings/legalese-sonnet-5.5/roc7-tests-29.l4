IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc7-order-29`

-- Rules of Court 2021 (Singapore): TESTS for roc7-order-29.
-- Expected values are written from the text of the rule named after each assertion (the comment on its line),
-- never copied from what the code printed.  The gate-shaped rules (a MAYBE BOOLEAN over BOOLEAN conditions) are tested
-- by the kind of the rule: every condition met; then each condition missing in turn.


-- Hand-written tests for Orders 29 and 29A (the gate-shaped rules are tested by the generated assertions below them).

#ASSERT `o 29 r 1 a defined term has its defined meaning` FALSE EQUALS JUST TRUE -- the context does not require otherwise
#ASSERT `o 29 r 1 a defined term has its defined meaning` TRUE EQUALS NOTHING -- "unless the context otherwise requires"
#ASSERT `o 29A r 1 a defined term has its defined meaning` FALSE EQUALS JUST TRUE -- the context does not require otherwise
#ASSERT `o 29A r 1 a defined term has its defined meaning` TRUE EQUALS NOTHING -- "unless the context otherwise requires"

-- "Court" in both Orders
#ASSERT `o 29 r 1 a court is the Court` `General Division` EQUALS JUST TRUE -- the General Division
#ASSERT `o 29 r 1 a court is the Court` `Appellate Division` EQUALS JUST TRUE -- the Appellate Division
#ASSERT `o 29 r 1 a court is the Court` `Court of Appeal` EQUALS JUST TRUE -- the Court of Appeal
#ASSERT `o 29 r 1 a court is the Court` `District Court` EQUALS JUST FALSE -- "means" the three
#ASSERT `o 29 r 1 a court is the Court` `Singapore International Commercial Court` EQUALS JUST FALSE -- "means" the three
#ASSERT `o 29A r 1 a court is the Court` `General Division` EQUALS JUST TRUE -- the General Division
#ASSERT `o 29A r 1 a court is the Court` `Court of Appeal` EQUALS JUST TRUE -- the Court of Appeal
#ASSERT `o 29A r 1 a court is the Court` `Magistrate's Court` EQUALS JUST FALSE -- "means" the three

-- Rule 6 of Order 29: the specified foreign countries (a bare list: NOTHING for another)
#ASSERT `o 29 r 6 a place is a specified foreign country` `o 29 r 6(a) New South Wales, Australia` EQUALS JUST TRUE -- (a)
#ASSERT `o 29 r 6 a place is a specified foreign country` `o 29 r 6(b) Dubai, United Arab Emirates` EQUALS JUST TRUE -- (b)
#ASSERT `o 29 r 6 a place is a specified foreign country` `o 29 r 6(c) Bermuda` EQUALS JUST TRUE -- (c)
#ASSERT `o 29 r 6 a place is a specified foreign country` `o 29 r 6 any other foreign country` EQUALS JUST FALSE -- a country not on the list is not specified in Rule 6 (Rule 1 hands the term to the list)
-- Rule 1 hands "specified foreign country" to rule 6: no entry holds, JUST FALSE (ruling of 2026-11-05 (a))
#ASSERT `o 29 r 1 a place is a specified foreign country` `o 29 r 6(c) Bermuda` EQUALS JUST TRUE -- listed
#ASSERT `o 29 r 1 a place is a specified foreign country` `o 29 r 6 any other foreign country` EQUALS JUST FALSE -- "means a foreign country that is specified in Rule 6"

-- Rule 7: the specified courts, country by country
#ASSERT `o 29 r 7 a court is a specified court` `o 29 r 6(a) New South Wales, Australia` `o 29 r 7(a) a court of competent jurisdiction in New South Wales, Australia` EQUALS JUST TRUE -- (a) every court of competent jurisdiction in New South Wales
#ASSERT `o 29 r 7 a court is a specified court` `o 29 r 6(b) Dubai, United Arab Emirates` `o 29 r 7(b) a court of competent jurisdiction which forms part of the Dubai International Financial Centre Courts` EQUALS JUST TRUE -- (b) the DIFC Courts
#ASSERT `o 29 r 7 a court is a specified court` `o 29 r 6(c) Bermuda` `o 29 r 7(c) the Supreme Court of Bermuda` EQUALS JUST TRUE -- (c) the Supreme Court of Bermuda
#ASSERT `o 29 r 7 a court is a specified court` `o 29 r 6(c) Bermuda` `o 29 r 7(a) a court of competent jurisdiction in New South Wales, Australia` EQUALS JUST FALSE -- a New South Wales court is specified "where the specified foreign country is New South Wales"; the "where" is not met
#ASSERT `o 29 r 7 a court is a specified court` `o 29 r 6(a) New South Wales, Australia` `o 29 r 7 any other court` EQUALS JUST FALSE -- a court not on the list is not specified in Rule 7 (Rule 1 hands the term to the list)
#ASSERT `o 29 r 1 a court is a specified court` `o 29 r 6(c) Bermuda` `o 29 r 7(c) the Supreme Court of Bermuda` EQUALS JUST TRUE -- listed
#ASSERT `o 29 r 1 a court is a specified court` `o 29 r 6(c) Bermuda` `o 29 r 7 any other court` EQUALS JUST FALSE -- "means a court that is specified in Rule 7"
#ASSERT `o 29 r 1 a court is a specified court` `o 29 r 6(c) Bermuda` `o 29 r 7(a) a court of competent jurisdiction in New South Wales, Australia` EQUALS JUST FALSE -- a mismatched pair is not listed

-- Order 29A, rules 4 and 5
#ASSERT `o 29A r 4 a place is a specified foreign country` TRUE EQUALS JUST TRUE -- the People's Republic of China
#ASSERT `o 29A r 4 a place is a specified foreign country` FALSE EQUALS JUST FALSE -- not on the list (Rule 1 hands the term to the list)
#ASSERT `o 29A r 5 a court is a specified court` TRUE EQUALS JUST TRUE -- the Supreme People's Court
#ASSERT `o 29A r 5 a court is a specified court` FALSE EQUALS JUST FALSE -- not on the list (Rule 1 hands the term to the list)
#ASSERT `o 29A r 1 a place is a specified foreign country` TRUE EQUALS JUST TRUE -- listed in rule 4
#ASSERT `o 29A r 1 a place is a specified foreign country` FALSE EQUALS JUST FALSE -- "means a foreign country that is specified in Rule 4"
#ASSERT `o 29A r 1 a court is a specified court` TRUE EQUALS JUST TRUE -- listed in rule 5
#ASSERT `o 29A r 1 a court is a specified court` FALSE EQUALS JUST FALSE -- "means a court that is specified in Rule 5"

-- Order 29A rule 3(2): a flat negative
#ASSERT `o 29A r 3(2) a request may identify the proceedings or the parties` TRUE EQUALS JUST FALSE -- "must not identify the proceedings ... or the parties"
#ASSERT `o 29A r 3(2) a request may identify the proceedings or the parties` FALSE EQUALS NOTHING -- other requests: the paragraph is silent


-- Gate and period assertions follow, written from the kind of each rule (every condition met; then each condition missing in turn).
#ASSERT `o 29 r 1 a place is a foreign country` TRUE TRUE EQUALS JUST TRUE -- O 29 r 1 “foreign country”: every condition met
#ASSERT `o 29 r 1 a place is a foreign country` FALSE TRUE EQUALS JUST FALSE -- O 29 r 1 “foreign country”: condition 1 missing
#ASSERT `o 29 r 1 a place is a foreign country` TRUE FALSE EQUALS JUST FALSE -- O 29 r 1 “foreign country”: condition 2 missing
#ASSERT `o 29 r 2(1) the Court may order proceedings in a specified court in a specified foreign country` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- O 29 r 2(1): every condition met
#ASSERT `o 29 r 2(1) the Court may order proceedings in a specified court in a specified foreign country` FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- O 29 r 2(1): condition 1 missing
#ASSERT `o 29 r 2(1) the Court may order proceedings in a specified court in a specified foreign country` TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- O 29 r 2(1): condition 2 missing
#ASSERT `o 29 r 2(1) the Court may order proceedings in a specified court in a specified foreign country` TRUE TRUE FALSE TRUE EQUALS NOTHING -- O 29 r 2(1): condition 3 missing
#ASSERT `o 29 r 2(1) the Court may order proceedings in a specified court in a specified foreign country` TRUE TRUE TRUE FALSE EQUALS NOTHING -- O 29 r 2(1): condition 4 missing
#ASSERT `o 29 r 2(2) the application is made by summons and supported by an affidavit` TRUE TRUE TRUE EQUALS JUST TRUE -- O 29 r 2(2): every condition met
#ASSERT `o 29 r 2(2) the application is made by summons and supported by an affidavit` FALSE TRUE TRUE EQUALS NOTHING -- O 29 r 2(2): condition 1 missing
#ASSERT `o 29 r 2(2) the application is made by summons and supported by an affidavit` TRUE FALSE TRUE EQUALS NOTHING -- O 29 r 2(2): condition 2 missing
#ASSERT `o 29 r 2(2) the application is made by summons and supported by an affidavit` TRUE TRUE FALSE EQUALS NOTHING -- O 29 r 2(2): condition 3 missing
#ASSERT `o 29 r 2(2) the application is made by summons and supported by an affidavit (the duty arises)` TRUE EQUALS JUST TRUE -- O 29 r 2(2): the duty arises
#ASSERT `o 29 r 2(2) the application is made by summons and supported by an affidavit (the duty arises)` FALSE EQUALS JUST FALSE -- O 29 r 2(2): trigger or exception 1: the duty does not arise
#ASSERT `o 29 r 2(3) the Court may give directions for a statement of the issue` TRUE EQUALS JUST TRUE -- O 29 r 2(3): every condition met
#ASSERT `o 29 r 2(3) the Court may give directions for a statement of the issue` FALSE EQUALS JUST FALSE -- O 29 r 2(3): condition 1 missing
#ASSERT `o 29 r 3 this Order does not prevent the Court ordering proceedings in another foreign country on its own motion` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- O 29 r 3: every condition met
#ASSERT `o 29 r 3 this Order does not prevent the Court ordering proceedings in another foreign country on its own motion` FALSE TRUE TRUE TRUE EQUALS NOTHING -- O 29 r 3: condition 1 missing
#ASSERT `o 29 r 3 this Order does not prevent the Court ordering proceedings in another foreign country on its own motion` TRUE FALSE TRUE TRUE EQUALS NOTHING -- O 29 r 3: condition 2 missing
#ASSERT `o 29 r 3 this Order does not prevent the Court ordering proceedings in another foreign country on its own motion` TRUE TRUE FALSE TRUE EQUALS NOTHING -- O 29 r 3: condition 3 missing
#ASSERT `o 29 r 3 this Order does not prevent the Court ordering proceedings in another foreign country on its own motion` TRUE TRUE TRUE FALSE EQUALS NOTHING -- O 29 r 3: condition 4 missing
#ASSERT `o 29 r 4 the order states what it must state` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- O 29 r 4: every condition met
#ASSERT `o 29 r 4 the order states what it must state` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- O 29 r 4: condition 1 missing
#ASSERT `o 29 r 4 the order states what it must state` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING -- O 29 r 4: condition 2 missing
#ASSERT `o 29 r 4 the order states what it must state` TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING -- O 29 r 4: condition 3 missing
#ASSERT `o 29 r 4 the order states what it must state` TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING -- O 29 r 4: condition 4 missing
#ASSERT `o 29 r 4 the order states what it must state` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- O 29 r 4: condition 5 missing
#ASSERT `o 29 r 4 the order states what it must state (the duty arises)` TRUE EQUALS JUST TRUE -- O 29 r 4: the duty arises
#ASSERT `o 29 r 4 the order states what it must state (the duty arises)` FALSE EQUALS JUST FALSE -- O 29 r 4: trigger or exception 1: the duty does not arise
#ASSERT `o 29 r 5(1) proceedings on an issue of Singapore law may be commenced by originating application` TRUE TRUE TRUE EQUALS JUST TRUE -- O 29 r 5(1): every condition met
#ASSERT `o 29 r 5(1) proceedings on an issue of Singapore law may be commenced by originating application` FALSE TRUE TRUE EQUALS JUST FALSE -- O 29 r 5(1): condition 1 missing
#ASSERT `o 29 r 5(1) proceedings on an issue of Singapore law may be commenced by originating application` TRUE FALSE TRUE EQUALS NOTHING -- O 29 r 5(1): condition 2 missing
#ASSERT `o 29 r 5(1) proceedings on an issue of Singapore law may be commenced by originating application` TRUE TRUE FALSE EQUALS NOTHING -- O 29 r 5(1): condition 3 missing
#ASSERT `o 29 r 5(2) the originating application or affidavit states what it must state` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- O 29 r 5(2): every condition met
#ASSERT `o 29 r 5(2) the originating application or affidavit states what it must state` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- O 29 r 5(2): condition 1 missing
#ASSERT `o 29 r 5(2) the originating application or affidavit states what it must state` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING -- O 29 r 5(2): condition 2 missing
#ASSERT `o 29 r 5(2) the originating application or affidavit states what it must state` TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING -- O 29 r 5(2): condition 3 missing
#ASSERT `o 29 r 5(2) the originating application or affidavit states what it must state` TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING -- O 29 r 5(2): condition 4 missing
#ASSERT `o 29 r 5(2) the originating application or affidavit states what it must state` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- O 29 r 5(2): condition 5 missing
#ASSERT `o 29 r 5(2) the originating application or affidavit states what it must state (the duty arises)` TRUE EQUALS JUST TRUE -- O 29 r 5(2): the duty arises
#ASSERT `o 29 r 5(2) the originating application or affidavit states what it must state (the duty arises)` FALSE EQUALS JUST FALSE -- O 29 r 5(2): trigger or exception 1: the duty does not arise
#ASSERT `o 29A r 1 a place is a foreign country` TRUE TRUE EQUALS JUST TRUE -- O 29A r 1 “foreign country”: every condition met
#ASSERT `o 29A r 1 a place is a foreign country` FALSE TRUE EQUALS JUST FALSE -- O 29A r 1 “foreign country”: condition 1 missing
#ASSERT `o 29A r 1 a place is a foreign country` TRUE FALSE EQUALS JUST FALSE -- O 29A r 1 “foreign country”: condition 2 missing
#ASSERT `o 29A r 2(1) the Court may transmit a request for an opinion to a specified court` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- O 29A r 2(1): every condition met
#ASSERT `o 29A r 2(1) the Court may transmit a request for an opinion to a specified court` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- O 29A r 2(1): condition 1 missing
#ASSERT `o 29A r 2(1) the Court may transmit a request for an opinion to a specified court` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- O 29A r 2(1): condition 2 missing
#ASSERT `o 29A r 2(1) the Court may transmit a request for an opinion to a specified court` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE -- O 29A r 2(1): condition 3 missing
#ASSERT `o 29A r 2(1) the Court may transmit a request for an opinion to a specified court` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE -- O 29A r 2(1): condition 4 missing
#ASSERT `o 29A r 2(1) the Court may transmit a request for an opinion to a specified court` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- O 29A r 2(1): condition 5 missing
#ASSERT `o 29A r 2(1) the Court may transmit a request for an opinion to a specified court` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- O 29A r 2(1): condition 6 missing
#ASSERT `o 29A r 2(2) the application is made by summons` TRUE TRUE EQUALS JUST TRUE -- O 29A r 2(2): every condition met
#ASSERT `o 29A r 2(2) the application is made by summons` FALSE TRUE EQUALS NOTHING -- O 29A r 2(2): condition 1 missing
#ASSERT `o 29A r 2(2) the application is made by summons` TRUE FALSE EQUALS NOTHING -- O 29A r 2(2): condition 2 missing
#ASSERT `o 29A r 2(2) the application is made by summons (the duty arises)` TRUE EQUALS JUST TRUE -- O 29A r 2(2): the duty arises
#ASSERT `o 29A r 2(2) the application is made by summons (the duty arises)` FALSE EQUALS JUST FALSE -- O 29A r 2(2): trigger or exception 1: the duty does not arise
#ASSERT `o 29A r 3(1) the initial request states what it must state` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- O 29A r 3(1): every condition met
#ASSERT `o 29A r 3(1) the initial request states what it must state` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- O 29A r 3(1): condition 1 missing
#ASSERT `o 29A r 3(1) the initial request states what it must state` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING -- O 29A r 3(1): condition 2 missing
#ASSERT `o 29A r 3(1) the initial request states what it must state` TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING -- O 29A r 3(1): condition 3 missing
#ASSERT `o 29A r 3(1) the initial request states what it must state` TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING -- O 29A r 3(1): condition 4 missing
#ASSERT `o 29A r 3(1) the initial request states what it must state` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- O 29A r 3(1): condition 5 missing
#ASSERT `o 29A r 3(1) the initial request states what it must state (the duty arises)` TRUE EQUALS JUST TRUE -- O 29A r 3(1): the duty arises
#ASSERT `o 29A r 3(1) the initial request states what it must state (the duty arises)` FALSE EQUALS JUST FALSE -- O 29A r 3(1): trigger or exception 1: the duty does not arise
