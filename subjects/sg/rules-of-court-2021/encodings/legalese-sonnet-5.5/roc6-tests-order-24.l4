IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc6-order-24`

-- Tests for roc6-order-24.l4 (Order 24, Prerogative orders).
-- Every expected value is written from the text of Order 24 (lines 3744 to 3826 of the source), beside the
-- assertion, before the code was run.  The last days are made up: Order 3, Rule 3 (roc1's range) counts them.

-- Sittings used below.
`roc6 test 24 a Judge sitting in the General Division` MEANS Sitting WITH
    `sitting court level` IS `General Division`
    `sitting decision maker` IS `A Judge`

`roc6 test 24 a Judge sitting in the Appellate Division` MEANS Sitting WITH
    `sitting court level` IS `Appellate Division`
    `sitting decision maker` IS `A Judge`

`roc6 test 24 the Registrar sitting in the General Division` MEANS Sitting WITH
    `sitting court level` IS `General Division`
    `sitting decision maker` IS `The Registrar`

`roc6 test 24 a District Judge sitting in the District Court` MEANS Sitting WITH
    `sitting court level` IS `District Court`
    `sitting decision maker` IS `A District Judge`

-- ---------------------------------------------------------------------------
§ `Tests -- Rules 1 and 2`
-- ---------------------------------------------------------------------------

#ASSERT `o 24 r 1 this Order applies to the court` `Supreme Court` EQUALS JUST TRUE -- "This Order applies to the Supreme Court only"
#ASSERT `o 24 r 1 this Order applies to the court` `State Courts` EQUALS JUST FALSE -- "only"

#ASSERT `o 24 r 2(1) the order is a prerogative order` `o 24 r 2(1)(a) an Order for Review of Detention` EQUALS JUST TRUE -- (a)
#ASSERT `o 24 r 2(1) the order is a prerogative order` `o 24 r 2(1)(b) a Mandatory Order` EQUALS JUST TRUE -- (b)
#ASSERT `o 24 r 2(1) the order is a prerogative order` `o 24 r 2(1)(c) a Prohibiting Order` EQUALS JUST TRUE -- (c)
#ASSERT `o 24 r 2(1) the order is a prerogative order` `o 24 r 2(1)(d) a Quashing Order` EQUALS JUST TRUE -- (d)
#ASSERT `o 24 r 2(1) the order is a prerogative order` `o 24 r 2(1) some other order` EQUALS NOTHING -- the list does not say "only"

#ASSERT `o 24 r 2(2) the application for a prerogative order may be made` TRUE EQUALS NOTHING -- remedies exhausted: the paragraph does not say the application is then allowed
#ASSERT `o 24 r 2(2) the application for a prerogative order may be made` FALSE EQUALS JUST FALSE -- "must not be made before the applicant has exhausted"

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 3`
-- ---------------------------------------------------------------------------

#ASSERT `o 24 r 3(1) the application for an Order for Review of Detention is made by originating application without notice` TRUE EQUALS JUST TRUE -- "must be made by originating application without notice"
#ASSERT `o 24 r 3(1) the application for an Order for Review of Detention is made by originating application without notice` FALSE EQUALS NOTHING -- silent on what follows

-- arguments: affidavit made; at the subject's instance; nature; when and how; where; reasons (if any); why released
#ASSERT `o 24 r 3(2) the subject's affidavit supports the application as required` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- every item
#ASSERT `o 24 r 3(2) the subject's affidavit supports the application as required` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING -- no affidavit
#ASSERT `o 24 r 3(2) the subject's affidavit supports the application as required` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING -- not at the subject's instance
#ASSERT `o 24 r 3(2) the subject's affidavit supports the application as required` TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- nature missing
#ASSERT `o 24 r 3(2) the subject's affidavit supports the application as required` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING -- when and how missing
#ASSERT `o 24 r 3(2) the subject's affidavit supports the application as required` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING -- where missing
#ASSERT `o 24 r 3(2) the subject's affidavit supports the application as required` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING -- reasons missing
#ASSERT `o 24 r 3(2) the subject's affidavit supports the application as required` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- why released missing

#ASSERT `o 24 r 3(3) some other person may make the affidavit` TRUE FALSE EQUALS JUST TRUE -- the subject is unable
#ASSERT `o 24 r 3(3) some other person may make the affidavit` FALSE TRUE EQUALS JUST TRUE -- the application is urgent
#ASSERT `o 24 r 3(3) some other person may make the affidavit` TRUE TRUE EQUALS JUST TRUE -- both
#ASSERT `o 24 r 3(3) some other person may make the affidavit` FALSE FALSE EQUALS JUST FALSE -- "If ... unable ... or ... urgent"
#ASSERT `o 24 r 3(3) the other person's affidavit states what it must` TRUE TRUE EQUALS JUST TRUE -- relationship and reason
#ASSERT `o 24 r 3(3) the other person's affidavit states what it must` FALSE TRUE EQUALS NOTHING -- relationship missing
#ASSERT `o 24 r 3(3) the other person's affidavit states what it must` TRUE FALSE EQUALS NOTHING -- reason missing

#ASSERT `o 24 r 3(4) the application is heard by a Judge sitting in the General Division` `roc6 test 24 a Judge sitting in the General Division` EQUALS JUST TRUE -- a Judge sitting in the General Division
#ASSERT `o 24 r 3(4) the application is heard by a Judge sitting in the General Division` `roc6 test 24 a Judge sitting in the Appellate Division` EQUALS NOTHING -- not the General Division
#ASSERT `o 24 r 3(4) the application is heard by a Judge sitting in the General Division` `roc6 test 24 the Registrar sitting in the General Division` EQUALS NOTHING -- not a Judge
#ASSERT `o 24 r 3(4) the application is heard by a Judge sitting in the General Division` `roc6 test 24 a District Judge sitting in the District Court` EQUALS NOTHING -- neither

#ASSERT `o 24 r 3(5) the subject must be brought before the Court hearing the originating application` FALSE EQUALS JUST FALSE -- "need not be brought ... unless the Court otherwise directs"
#ASSERT `o 24 r 3(5) the subject must be brought before the Court hearing the originating application` TRUE EQUALS JUST TRUE -- the Court so directs

#ASSERT `o 24 r 3(6)(a) the form of the Order for Review of Detention` EQUALS "Form 43" -- "in Form 43"
#ASSERT `o 24 r 3(6) the Court may do this at the hearing of the application` `o 24 r 3(6)(a) make an Order for Review of Detention in Form 43 forthwith and order that the subject is to be brought before the Court by a certain time` EQUALS JUST TRUE -- (a)
#ASSERT `o 24 r 3(6) the Court may do this at the hearing of the application` `o 24 r 3(6)(b) direct that a summons for the Order for Review of Detention be issued` EQUALS JUST TRUE -- (b)
#ASSERT `o 24 r 3(6) the Court may do this at the hearing of the application` `o 24 r 3(6) something else` EQUALS NOTHING -- the grant names two things

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 4`
-- ---------------------------------------------------------------------------

#ASSERT `o 24 r 4(1) the summons for the Order for Review of Detention is a summons in the originating application` TRUE EQUALS JUST TRUE -- "is to be a summons in the originating application"
#ASSERT `o 24 r 4(1) the summons for the Order for Review of Detention is a summons in the originating application` FALSE EQUALS NOTHING -- silent on what follows

#ASSERT `o 24 r 4(2) two working days`'s `period length` EQUALS 2 -- "2 working days"
#ASSERT `o 24 r 4(2) two working days`'s `period unit` EQUALS `Working days` -- working days
#ASSERT `o 24 r 4(2) two working days`'s `period direction` EQUALS `After the anchor` -- after the filing

-- arguments: date served; the last day (O 3 r 3); served as soon as practicable
#ASSERT `o 24 r 4(2) the document is served as soon as practicable and no later than 2 working days after it is filed` (Date 6 7 2026) (Date 8 7 2026) TRUE EQUALS JUST TRUE -- served early and practicably
#ASSERT `o 24 r 4(2) the document is served as soon as practicable and no later than 2 working days after it is filed` (Date 8 7 2026) (Date 8 7 2026) TRUE EQUALS JUST TRUE -- served on the last day
#ASSERT `o 24 r 4(2) the document is served as soon as practicable and no later than 2 working days after it is filed` (Date 9 7 2026) (Date 8 7 2026) TRUE EQUALS JUST FALSE -- one day late: "in any case no later than" (ruling (a))
#ASSERT `o 24 r 4(2) the document is served as soon as practicable and no later than 2 working days after it is filed` (Date 6 7 2026) (Date 8 7 2026) FALSE EQUALS NOTHING -- within the 2 days but not as soon as practicable: a judgment the text leaves open
#ASSERT `o 24 r 4(2) the document is served as soon as practicable and no later than 2 working days after it is filed` (Date 9 7 2026) (Date 8 7 2026) FALSE EQUALS JUST FALSE -- past the outer limit whatever the practicability

#ASSERT `o 24 r 4(2) the four documents are served on the defendant and on the Attorney-General` TRUE TRUE EQUALS JUST TRUE -- both served
#ASSERT `o 24 r 4(2) the four documents are served on the defendant and on the Attorney-General` FALSE TRUE EQUALS NOTHING -- not on the defendant
#ASSERT `o 24 r 4(2) the four documents are served on the defendant and on the Attorney-General` TRUE FALSE EQUALS NOTHING -- not on the Attorney-General

#ASSERT `o 24 r 4(3) the applicant may name the Attorney-General as the defendant` TRUE EQUALS JUST TRUE -- identity unknown or uncertain
#ASSERT `o 24 r 4(3) the applicant may name the Attorney-General as the defendant` FALSE EQUALS JUST FALSE -- "Where the identity of the defendant is unknown or uncertain"

#ASSERT `o 24 r 4(4) the Attorney-General may apply to the Court for another defendant to be added or substituted` TRUE EQUALS JUST TRUE -- he or she is a defendant
#ASSERT `o 24 r 4(4) the Attorney-General may apply to the Court for another defendant to be added or substituted` FALSE EQUALS NOTHING -- the order sought presupposes it

#ASSERT `o 24 r 4(5) the person may file and serve an affidavit to contest the summons` `o 24 r 4(5) the defendant` EQUALS JUST TRUE -- the defendant
#ASSERT `o 24 r 4(5) the person may file and serve an affidavit to contest the summons` `o 24 r 4(5) the Attorney-General` EQUALS JUST TRUE -- the Attorney-General
#ASSERT `o 24 r 4(5) the person may file and serve an affidavit to contest the summons` `o 24 r 4(5) someone else` EQUALS NOTHING -- the grant names two persons
#ASSERT `o 24 r 4(5) the affidavits may be made in this way` `o 24 r 4(5) jointly` EQUALS JUST TRUE -- jointly
#ASSERT `o 24 r 4(5) the affidavits may be made in this way` `o 24 r 4(5) separately` EQUALS JUST TRUE -- separately
#ASSERT `o 24 r 4(5) the affidavits may be made in this way` `o 24 r 4(5) in some other way` EQUALS NOTHING -- the grant names two ways

#ASSERT `o 24 r 4(6) the copy of each affidavit is served on every other party in time` (Date 6 7 2026) (Date 8 7 2026) TRUE EQUALS JUST TRUE -- in time
#ASSERT `o 24 r 4(6) the copy of each affidavit is served on every other party in time` (Date 8 7 2026) (Date 8 7 2026) TRUE EQUALS JUST TRUE -- last day
#ASSERT `o 24 r 4(6) the copy of each affidavit is served on every other party in time` (Date 9 7 2026) (Date 8 7 2026) TRUE EQUALS JUST FALSE -- late
#ASSERT `o 24 r 4(6) the copy of each affidavit is served on every other party in time` (Date 6 7 2026) (Date 8 7 2026) FALSE EQUALS NOTHING -- not as soon as practicable

#ASSERT `o 24 r 4(7) the summons is heard by a Judge sitting in the General Division` `roc6 test 24 a Judge sitting in the General Division` EQUALS JUST TRUE -- a Judge sitting in the General Division
#ASSERT `o 24 r 4(7) the summons is heard by a Judge sitting in the General Division` `roc6 test 24 a Judge sitting in the Appellate Division` EQUALS NOTHING -- not the General Division
#ASSERT `o 24 r 4(7) the summons is heard by a Judge sitting in the General Division` `roc6 test 24 the Registrar sitting in the General Division` EQUALS NOTHING -- not a Judge

#ASSERT `o 24 r 4(8) the subject must be brought before the Court hearing the summons` FALSE EQUALS JUST FALSE -- "need not be brought ... unless the Court otherwise directs"
#ASSERT `o 24 r 4(8) the subject must be brought before the Court hearing the summons` TRUE EQUALS JUST TRUE -- the Court so directs

#ASSERT `o 24 r 4(9) the Court may order this at the hearing of the summons` `o 24 r 4(9)(a) the summons be dismissed` EQUALS JUST TRUE -- (a)
#ASSERT `o 24 r 4(9) the Court may order this at the hearing of the summons` `o 24 r 4(9)(b) further affidavits be filed and served by the parties` EQUALS JUST TRUE -- (b)
#ASSERT `o 24 r 4(9) the Court may order this at the hearing of the summons` `o 24 r 4(9)(c) an Order for Review of Detention be made in Form 43 and the defendant release the subject immediately or by a certain time` EQUALS JUST TRUE -- (c)
#ASSERT `o 24 r 4(9) the Court may order this at the hearing of the summons` `o 24 r 4(9) something else` EQUALS NOTHING -- the grant names three things

-- arguments: the Court made an order under (9)(c) or r 3(6)(a); the Order has been served
#ASSERT `o 24 r 4(10) the defendant or the appropriate person or entity must comply with the Order for Review of Detention` TRUE FALSE EQUALS JUST TRUE -- "although the Order has not been served"
#ASSERT `o 24 r 4(10) the defendant or the appropriate person or entity must comply with the Order for Review of Detention` TRUE TRUE EQUALS JUST TRUE -- served, a fortiori
#ASSERT `o 24 r 4(10) the defendant or the appropriate person or entity must comply with the Order for Review of Detention` FALSE FALSE EQUALS JUST FALSE -- "Where the Court makes an order under paragraph (9)(c) or Rule 3(6)(a)": it did not
#ASSERT `o 24 r 4(10) the solicitor appearing for the defendant has informed the defendant or the appropriate person or entity` TRUE TRUE EQUALS JUST TRUE -- informed as soon as practicable
#ASSERT `o 24 r 4(10) the solicitor appearing for the defendant has informed the defendant or the appropriate person or entity` TRUE FALSE EQUALS NOTHING -- not informed: silent on what follows
#ASSERT `o 24 r 4(10) the solicitor appearing for the defendant has informed the defendant or the appropriate person or entity` FALSE TRUE EQUALS JUST FALSE -- no such order: the duty does not arise
#ASSERT `o 24 r 4(11) the defendant or the appropriate person or entity must comply with the Order for Review of Detention although it has not been served` TRUE EQUALS JUST TRUE -- order made in the defendant's presence
#ASSERT `o 24 r 4(11) the defendant or the appropriate person or entity must comply with the Order for Review of Detention although it has not been served` FALSE EQUALS JUST FALSE -- "Where the Court makes an order under paragraph (9)(c) in the presence of"

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 5`
-- ---------------------------------------------------------------------------

#ASSERT `o 24 r 5(1)(a) the application may include an application for a declaration` TRUE EQUALS JUST TRUE -- ancillary or consequential
#ASSERT `o 24 r 5(1)(a) the application may include an application for a declaration` FALSE EQUALS NOTHING -- the grant is limited by its own wording
#ASSERT `o 24 r 5(1)(b) the application for a Mandatory Order, Prohibiting Order or Quashing Order may be made` TRUE EQUALS NOTHING -- permission granted: the paragraph does not say the application is then allowed
#ASSERT `o 24 r 5(1)(b) the application for a Mandatory Order, Prohibiting Order or Quashing Order may be made` FALSE EQUALS JUST FALSE -- "must not be made, unless permission ... has been granted"

#ASSERT `o 24 r 5(2) three months`'s `period length` EQUALS 3 -- "within 3 months"
#ASSERT `o 24 r 5(2) three months`'s `period unit` EQUALS Months -- months
#ASSERT `o 24 r 5(2) three months`'s `period direction` EQUALS `After the anchor` -- after the omission, judgment, order, conviction or proceedings
-- arguments: a written law provides a different time; date applied; the last day (O 3 r 3)
#ASSERT `o 24 r 5(2) the application for permission is made within 3 months after the omission, judgment, order, conviction or proceedings` FALSE (Date 10 8 2026) (Date 12 8 2026) EQUALS JUST TRUE -- inside
#ASSERT `o 24 r 5(2) the application for permission is made within 3 months after the omission, judgment, order, conviction or proceedings` FALSE (Date 12 8 2026) (Date 12 8 2026) EQUALS JUST TRUE -- the last day
#ASSERT `o 24 r 5(2) the application for permission is made within 3 months after the omission, judgment, order, conviction or proceedings` FALSE (Date 13 8 2026) (Date 12 8 2026) EQUALS JUST FALSE -- one day late (ruling (a))
#ASSERT `o 24 r 5(2) the application for permission is made within 3 months after the omission, judgment, order, conviction or proceedings` TRUE (Date 13 8 2026) (Date 12 8 2026) EQUALS NOTHING -- "Subject to any written law": the other time is outside the sources
#ASSERT `o 24 r 5(2) the application for permission is made within 3 months after the omission, judgment, order, conviction or proceedings` TRUE (Date 10 8 2026) (Date 12 8 2026) EQUALS NOTHING -- a written law may have its own time

-- arguments: by originating application; statement; statement contents; affidavit; (i) standing; (ii) arguable case; (iii) susceptible
#ASSERT `o 24 r 5(3) the application for permission is made and supported as required` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- every limb
#ASSERT `o 24 r 5(3) the application for permission is made and supported as required` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING -- not an originating application
#ASSERT `o 24 r 5(3) the application for permission is made and supported as required` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING -- no statement
#ASSERT `o 24 r 5(3) the application for permission is made and supported as required` TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING -- statement lacks its contents
#ASSERT `o 24 r 5(3) the application for permission is made and supported as required` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING -- no affidavit
#ASSERT `o 24 r 5(3) the application for permission is made and supported as required` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING -- (b)(i) missing
#ASSERT `o 24 r 5(3) the application for permission is made and supported as required` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING -- (b)(ii) missing
#ASSERT `o 24 r 5(3) the application for permission is made and supported as required` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING -- (b)(iii) missing

#ASSERT `o 24 r 5(4) the applicant may rely on the ground or seek the relief` TRUE FALSE EQUALS JUST TRUE -- set out in the statement
#ASSERT `o 24 r 5(4) the applicant may rely on the ground or seek the relief` FALSE TRUE EQUALS JUST TRUE -- the Court otherwise allows
#ASSERT `o 24 r 5(4) the applicant may rely on the ground or seek the relief` FALSE FALSE EQUALS JUST FALSE -- "may not rely upon any ground ... that is not set out in the statement unless the Court otherwise allows"

#ASSERT `o 24 r 5(5) the originating application, the statement and the affidavit are served on the defendant and the Attorney-General in time` (Date 6 7 2026) (Date 8 7 2026) TRUE EQUALS JUST TRUE -- in time
#ASSERT `o 24 r 5(5) the originating application, the statement and the affidavit are served on the defendant and the Attorney-General in time` (Date 8 7 2026) (Date 8 7 2026) TRUE EQUALS JUST TRUE -- last day
#ASSERT `o 24 r 5(5) the originating application, the statement and the affidavit are served on the defendant and the Attorney-General in time` (Date 9 7 2026) (Date 8 7 2026) TRUE EQUALS JUST FALSE -- late
#ASSERT `o 24 r 5(5) the originating application, the statement and the affidavit are served on the defendant and the Attorney-General in time` (Date 6 7 2026) (Date 8 7 2026) FALSE EQUALS NOTHING -- not as soon as practicable

#ASSERT `o 24 r 5(6) the Attorney-General may apply to the Court for another defendant to be added or substituted` TRUE EQUALS JUST TRUE -- a defendant
#ASSERT `o 24 r 5(6) the Attorney-General may apply to the Court for another defendant to be added or substituted` FALSE EQUALS NOTHING -- presupposes it
#ASSERT `o 24 r 5(7) the person may file and serve an affidavit to contest the application for permission` `o 24 r 4(5) the defendant` EQUALS JUST TRUE -- the defendant
#ASSERT `o 24 r 5(7) the person may file and serve an affidavit to contest the application for permission` `o 24 r 4(5) the Attorney-General` EQUALS JUST TRUE -- the Attorney-General
#ASSERT `o 24 r 5(7) the person may file and serve an affidavit to contest the application for permission` `o 24 r 4(5) someone else` EQUALS NOTHING -- the grant names two persons

#ASSERT `o 24 r 5(8) the application for permission is heard by a Judge` `roc6 test 24 a Judge sitting in the General Division` EQUALS JUST TRUE -- a Judge
#ASSERT `o 24 r 5(8) the application for permission is heard by a Judge` `roc6 test 24 a Judge sitting in the Appellate Division` EQUALS JUST TRUE -- a Judge: the paragraph does not name a Division
#ASSERT `o 24 r 5(8) the application for permission is heard by a Judge` `roc6 test 24 the Registrar sitting in the General Division` EQUALS NOTHING -- not a Judge

#ASSERT `o 24 r 5(9) the Court may order this at the hearing of the application for permission` `o 24 r 5(9)(a) the application be allowed` EQUALS JUST TRUE -- (a)
#ASSERT `o 24 r 5(9) the Court may order this at the hearing of the application for permission` `o 24 r 5(9)(b) the application be dismissed` EQUALS JUST TRUE -- (b)
#ASSERT `o 24 r 5(9) the Court may order this at the hearing of the application for permission` `o 24 r 5(9)(c) the application be served on some other persons` EQUALS JUST TRUE -- (c)
#ASSERT `o 24 r 5(9) the Court may order this at the hearing of the application for permission` `o 24 r 5(9)(d) further affidavits be filed and served by the parties` EQUALS JUST TRUE -- (d)
#ASSERT `o 24 r 5(9) the Court may order this at the hearing of the application for permission` `o 24 r 5(9) something else` EQUALS NOTHING -- the grant names four things
#ASSERT `o 24 r 5(9)(a) the Court may also order a stay of the proceedings in question until the application for the Order is determined` `o 24 r 2(1)(c) a Prohibiting Order` TRUE EQUALS JUST TRUE -- permission granted, Prohibiting Order
#ASSERT `o 24 r 5(9)(a) the Court may also order a stay of the proceedings in question until the application for the Order is determined` `o 24 r 2(1)(d) a Quashing Order` TRUE EQUALS JUST TRUE -- permission granted, Quashing Order
#ASSERT `o 24 r 5(9)(a) the Court may also order a stay of the proceedings in question until the application for the Order is determined` `o 24 r 2(1)(b) a Mandatory Order` TRUE EQUALS JUST FALSE -- "where permission is granted to apply for a Prohibiting Order or a Quashing Order": a Mandatory Order is outside the "where" (ruling (b))
#ASSERT `o 24 r 5(9)(a) the Court may also order a stay of the proceedings in question until the application for the Order is determined` `o 24 r 2(1)(a) an Order for Review of Detention` TRUE EQUALS JUST FALSE -- an Order for Review of Detention is outside the "where" too
#ASSERT `o 24 r 5(9)(a) the Court may also order a stay of the proceedings in question until the application for the Order is determined` `o 24 r 2(1)(b) a Mandatory Order` FALSE EQUALS JUST FALSE -- no permission and a Mandatory Order
#ASSERT `o 24 r 5(9)(a) the Court may also order a stay of the proceedings in question until the application for the Order is determined` `o 24 r 2(1)(c) a Prohibiting Order` FALSE EQUALS JUST FALSE -- "where permission is granted": it is not (ruling (b))
#ASSERT `o 24 r 4(10) the person who must inform the defendant or the appropriate person or entity` EQUALS "the solicitor appearing for the defendant" -- Rule 4(10): "the solicitor appearing for the defendant must inform"

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 6`
-- ---------------------------------------------------------------------------

#ASSERT `o 24 r 6(1) the application for the Order is made by summons in the originating application` TRUE TRUE EQUALS JUST TRUE -- permission granted, summons in the originating application
#ASSERT `o 24 r 6(1) the application for the Order is made by summons in the originating application` TRUE FALSE EQUALS NOTHING -- made another way: silent on what follows
#ASSERT `o 24 r 6(1) the application for the Order is made by summons in the originating application` FALSE TRUE EQUALS JUST FALSE -- "Where permission has been granted": it was not
#ASSERT `o 24 r 6(1) the application for the Order is made by summons in the originating application` FALSE FALSE EQUALS JUST FALSE -- no permission

#ASSERT `o 24 r 6(2) fourteen days`'s `period length` EQUALS 14 -- "within 14 days"
#ASSERT `o 24 r 6(2) fourteen days`'s `period direction` EQUALS `After the anchor` -- after permission was granted
-- arguments: the date the summons was filed (if it was); the last day (O 3 r 3); the date asked about
#ASSERT `o 24 r 6(2) the permission lapses` (JUST (Date 10 9 2026)) (Date 14 9 2026) (Date 30 9 2026) EQUALS JUST FALSE -- filed inside the 14 days
#ASSERT `o 24 r 6(2) the permission lapses` (JUST (Date 14 9 2026)) (Date 14 9 2026) (Date 30 9 2026) EQUALS JUST FALSE -- filed on the last day
#ASSERT `o 24 r 6(2) the permission lapses` (JUST (Date 15 9 2026)) (Date 14 9 2026) (Date 30 9 2026) EQUALS JUST TRUE -- filed one day late
#ASSERT `o 24 r 6(2) the permission lapses` NOTHING (Date 14 9 2026) (Date 15 9 2026) EQUALS JUST TRUE -- never filed and the 14 days have run
#ASSERT `o 24 r 6(2) the permission lapses` NOTHING (Date 14 9 2026) (Date 14 9 2026) EQUALS JUST FALSE -- not filed yet and the last day has not passed

#ASSERT `o 24 r 6(3) the order granting permission and the summons are served on the defendant and the Attorney-General in time` (Date 6 7 2026) (Date 8 7 2026) TRUE EQUALS JUST TRUE -- in time
#ASSERT `o 24 r 6(3) the order granting permission and the summons are served on the defendant and the Attorney-General in time` (Date 8 7 2026) (Date 8 7 2026) TRUE EQUALS JUST TRUE -- last day
#ASSERT `o 24 r 6(3) the order granting permission and the summons are served on the defendant and the Attorney-General in time` (Date 9 7 2026) (Date 8 7 2026) TRUE EQUALS JUST FALSE -- late
#ASSERT `o 24 r 6(3) the order granting permission and the summons are served on the defendant and the Attorney-General in time` (Date 6 7 2026) (Date 8 7 2026) FALSE EQUALS NOTHING -- not as soon as practicable

#ASSERT `o 24 r 6(4) the application is heard by a Judge` `roc6 test 24 a Judge sitting in the General Division` EQUALS JUST TRUE -- a Judge
#ASSERT `o 24 r 6(4) the application is heard by a Judge` `roc6 test 24 the Registrar sitting in the General Division` EQUALS NOTHING -- not a Judge

#ASSERT `o 24 r 6(5) the Court may order this at the hearing` `o 24 r 6(5)(a) the application be dismissed` EQUALS JUST TRUE -- (a)
#ASSERT `o 24 r 6(5) the Court may order this at the hearing` `o 24 r 6(5)(b) the application be served on some other persons` EQUALS JUST TRUE -- (b)
#ASSERT `o 24 r 6(5) the Court may order this at the hearing` `o 24 r 6(5)(c) further affidavits be filed and served by the parties` EQUALS JUST TRUE -- (c)
#ASSERT `o 24 r 6(5) the Court may order this at the hearing` `o 24 r 6(5)(d) a Mandatory Order, Prohibiting Order or Quashing Order be made to take effect or be complied with immediately or by a certain time, with consequential orders` EQUALS JUST TRUE -- (d)
#ASSERT `o 24 r 6(5) the Court may order this at the hearing` `o 24 r 6(5) something else` EQUALS NOTHING -- the grant names four things

#ASSERT `o 24 r 6(6) the solicitor appearing for the defendant has informed the defendant or the appropriate person or entity` TRUE TRUE EQUALS JUST TRUE -- informed as soon as practicable
#ASSERT `o 24 r 6(6) the solicitor appearing for the defendant has informed the defendant or the appropriate person or entity` TRUE FALSE EQUALS NOTHING -- not informed: silent on what follows
#ASSERT `o 24 r 6(6) the solicitor appearing for the defendant has informed the defendant or the appropriate person or entity` FALSE TRUE EQUALS JUST FALSE -- no order under (5)(d): the duty does not arise
#ASSERT `o 24 r 6(6) the defendant or the appropriate person or entity must comply with the relevant Order although it has not been served` TRUE EQUALS JUST TRUE -- an order under (5)(d)
#ASSERT `o 24 r 6(6) the defendant or the appropriate person or entity must comply with the relevant Order although it has not been served` FALSE EQUALS JUST FALSE -- "Where the Court makes an order under paragraph (5)(d)"
#ASSERT `o 24 r 6(7) the defendant or the appropriate person or entity must comply with the relevant Order although it has not been served` TRUE EQUALS JUST TRUE -- order made in the presence of the defendant
#ASSERT `o 24 r 6(7) the defendant or the appropriate person or entity must comply with the relevant Order although it has not been served` FALSE EQUALS JUST FALSE -- "Where ... in the presence of"

-- arguments: the Court made an order under (5)(d); the declaration is ancillary or consequential; what the Government Proceedings Act allows
#ASSERT `o 24 r 6(8)(a) the Court may also make a declaration` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE -- ancillary, and the Act allows it
#ASSERT `o 24 r 6(8)(a) the Court may also make a declaration` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE -- ancillary, and the Act forbids it
#ASSERT `o 24 r 6(8)(a) the Court may also make a declaration` TRUE TRUE NOTHING EQUALS NOTHING -- "Subject to the Government Proceedings Act": outside the sources
#ASSERT `o 24 r 6(8)(a) the Court may also make a declaration` TRUE FALSE (JUST TRUE) EQUALS NOTHING -- the grant is limited by its own wording: ancillary or consequential
#ASSERT `o 24 r 6(8)(a) the Court may also make a declaration` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE -- "where the Court makes an order under paragraph (5)(d)": it did not
-- arguments: the Court made an order under (5)(d); satisfied the applicant would have been entitled in a separate action; what the Government Proceedings Act allows
#ASSERT `o 24 r 6(8)(b) the Court may also order that the applicant be awarded a liquidated amount, damages to be assessed or equitable relief` TRUE TRUE (JUST TRUE) EQUALS JUST TRUE -- satisfied, and the Act allows it
#ASSERT `o 24 r 6(8)(b) the Court may also order that the applicant be awarded a liquidated amount, damages to be assessed or equitable relief` TRUE TRUE (JUST FALSE) EQUALS JUST FALSE -- satisfied, and the Act forbids it
#ASSERT `o 24 r 6(8)(b) the Court may also order that the applicant be awarded a liquidated amount, damages to be assessed or equitable relief` TRUE TRUE NOTHING EQUALS NOTHING -- the Act is outside the sources
#ASSERT `o 24 r 6(8)(b) the Court may also order that the applicant be awarded a liquidated amount, damages to be assessed or equitable relief` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE -- "if it is satisfied": it is not
#ASSERT `o 24 r 6(8)(b) the Court may also order that the applicant be awarded a liquidated amount, damages to be assessed or equitable relief` FALSE TRUE (JUST TRUE) EQUALS JUST FALSE -- "where the Court makes an order under paragraph (5)(d)": it did not

-- ---------------------------------------------------------------------------
§ `Tests -- the duties as regulative rules (traces, not assertions)`
-- ---------------------------------------------------------------------------

-- A #TRACE prints its result and counts as no assertion on this binary; the decision function that says the
-- same thing is asserted above.  The result each should print is written beside it, from the text.
-- expected: the prohibition is still standing, unbroken, after 30 days: the trace prints the rule itself, with no BREACH (O 24 r 2(2))
#TRACE `o 24 r 2(2) the applicant shall not apply for a prerogative order before exhausting every right of appeal or other remedy` AT 0 WITH
    (WAITUNTIL 30)
-- expected: BREACH -- the applicant applies too early
#TRACE `o 24 r 2(2) the applicant shall not apply for a prerogative order before exhausting every right of appeal or other remedy` AT 0 WITH
    PARTY `o 24 the applicant` DOES `o 24 r 2(2) apply for a prerogative order before exhausting every right of appeal or other remedy` AT 3
-- expected: FULFILLED -- service on day 2 (the last day) (O 24 r 4(2))
#TRACE `o 24 r 4(2) the applicant must serve the documents within 2 working days after filing` AT 0 WITH
    PARTY `o 24 the applicant` DOES `o 24 r 4(2) serve the documents on the defendant and the Attorney-General` AT 2
-- expected: BREACH -- service on day 3
#TRACE `o 24 r 4(2) the applicant must serve the documents within 2 working days after filing` AT 0 WITH
    PARTY `o 24 the applicant` DOES `o 24 r 4(2) serve the documents on the defendant and the Attorney-General` AT 3
-- expected: FULFILLED -- the defendant complies (O 24 r 4(11))
#TRACE `o 24 r 4(11) the defendant must comply with the Order for Review of Detention` AT 0 WITH
    PARTY `o 24 the defendant` DOES `o 24 r 4(11) comply with the Order for Review of Detention` AT 1
