IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc10-order-46`

-- Rules of Court 2021 (Singapore), Order 46 (Employment Act): TESTS.
-- Every expected value is written beside its assertion from the text of the rule it cites
-- (lines 6102 to 6127 of the text), never copied from the output of the code.

-- ---------------------------------------------------------------------------
-- Rule 1 (line 6105): "These Rules apply to proceedings under the Employment Act subject to the following Rules."
-- ---------------------------------------------------------------------------
#ASSERT `o 46 r 1 these Rules apply to the proceedings under the Employment Act` TRUE EQUALS JUST TRUE -- proceedings under the Act: the Rules apply
#ASSERT `o 46 r 1 these Rules apply to the proceedings under the Employment Act` FALSE EQUALS NOTHING -- not proceedings under the Act: a scope limit with no "only", so not covered

-- ---------------------------------------------------------------------------
-- Rule 2(1) (line 6107): the duty arises "Where the Commissioner ... has made an order under the Employment Act
-- and such order is sought to be enforced in a District Court"; both limbs are needed.
-- ---------------------------------------------------------------------------
#ASSERT `o 46 r 2(1) the duty of the Commissioner for Labour to issue a certificate arises` TRUE TRUE EQUALS JUST TRUE -- both limbs met
#ASSERT `o 46 r 2(1) the duty of the Commissioner for Labour to issue a certificate arises` FALSE TRUE EQUALS JUST FALSE -- no order of the Commissioner: the "where" fails
#ASSERT `o 46 r 2(1) the duty of the Commissioner for Labour to issue a certificate arises` TRUE FALSE EQUALS JUST FALSE -- not sought to be enforced in a District Court: the "where" fails
#ASSERT `o 46 r 2(1) the duty of the Commissioner for Labour to issue a certificate arises` FALSE FALSE EQUALS JUST FALSE -- neither limb

-- Compliance: issued AND filed with a copy.  Argument order: order made, sought in District Court, issued, filed.
#ASSERT `o 46 r 2(1) the Commissioner for Labour has issued the certificate and it has been filed with a copy of the order` TRUE TRUE TRUE TRUE EQUALS JUST TRUE -- issued and filed
#ASSERT `o 46 r 2(1) the Commissioner for Labour has issued the certificate and it has been filed with a copy of the order` TRUE TRUE TRUE FALSE EQUALS NOTHING -- issued, not filed: a bare "must", not done
#ASSERT `o 46 r 2(1) the Commissioner for Labour has issued the certificate and it has been filed with a copy of the order` TRUE TRUE FALSE FALSE EQUALS NOTHING -- not issued: a bare "must", not done
#ASSERT `o 46 r 2(1) the Commissioner for Labour has issued the certificate and it has been filed with a copy of the order` TRUE FALSE TRUE TRUE EQUALS NOTHING -- the duty does not arise (not sought in a District Court): nothing to comply with
#ASSERT `o 46 r 2(1) the Commissioner for Labour has issued the certificate and it has been filed with a copy of the order` FALSE TRUE TRUE TRUE EQUALS NOTHING -- the duty does not arise (no Commissioner's order): nothing to comply with

-- ---------------------------------------------------------------------------
-- Rule 2(2) (line 6107): "Where the certificate and a copy of the order have been filed ... the order may be enforced by the Court as if it were a judgment of the Court."
-- ---------------------------------------------------------------------------
#ASSERT `o 46 r 2(2) the order may be enforced by the Court as if it were a judgment of the Court` TRUE EQUALS JUST TRUE -- filed: the order may be enforced
#ASSERT `o 46 r 2(2) the order may be enforced by the Court as if it were a judgment of the Court` FALSE EQUALS JUST FALSE -- not filed: the "where" fails

-- ---------------------------------------------------------------------------
-- Rule 3(1) (lines 6109 to 6122): the certificate must state (a) to (g).
-- ---------------------------------------------------------------------------
-- Positional record: the seven facts are (a), (b), (c), (d), (e), (f), (g) in this order.
#ASSERT `o 46 r 3(1) the certificate states what it must` (`o 46 r 3(1) what the certificate states` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE -- all of (a) to (g)
#ASSERT `o 46 r 3(1) the certificate states what it must` (`o 46 r 3(1) what the certificate states` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- (a) missing: a bare "must", not done
#ASSERT `o 46 r 3(1) the certificate states what it must` (`o 46 r 3(1) what the certificate states` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- (b) missing
#ASSERT `o 46 r 3(1) the certificate states what it must` (`o 46 r 3(1) what the certificate states` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING -- (c) missing
#ASSERT `o 46 r 3(1) the certificate states what it must` (`o 46 r 3(1) what the certificate states` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS NOTHING -- (d) missing
#ASSERT `o 46 r 3(1) the certificate states what it must` (`o 46 r 3(1) what the certificate states` OF TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS NOTHING -- (e) missing
#ASSERT `o 46 r 3(1) the certificate states what it must` (`o 46 r 3(1) what the certificate states` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS NOTHING -- (f) missing
#ASSERT `o 46 r 3(1) the certificate states what it must` (`o 46 r 3(1) what the certificate states` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING -- (g) missing

-- ---------------------------------------------------------------------------
-- Rule 3(2) (line 6123): "Where the persons are numerous the particulars ... may be set out in a schedule"
-- ---------------------------------------------------------------------------
#ASSERT `o 46 r 3(2) the particulars may be set out in a schedule attached to the certificate` TRUE EQUALS JUST TRUE -- the persons are numerous
#ASSERT `o 46 r 3(2) the particulars may be set out in a schedule attached to the certificate` FALSE EQUALS JUST FALSE -- not numerous: the "where" fails

-- ---------------------------------------------------------------------------
-- Rule 3(3) (line 6124): "Where the order is that the amount is to be paid to the Commissioner for distribution ..., it is sufficient to state the name of each person and the amount ..."
-- ---------------------------------------------------------------------------
#ASSERT `o 46 r 3(3) it is sufficient to state the name of each person and the amount to be paid on each person's account` TRUE TRUE EQUALS JUST TRUE -- payable to the Commissioner for distribution, and the names and amounts are stated
#ASSERT `o 46 r 3(3) it is sufficient to state the name of each person and the amount to be paid on each person's account` TRUE FALSE EQUALS NOTHING -- payable to the Commissioner, names and amounts not stated: the text says what suffices, not what does not
#ASSERT `o 46 r 3(3) it is sufficient to state the name of each person and the amount to be paid on each person's account` FALSE TRUE EQUALS JUST FALSE -- the "where" fails: the order is not for payment to the Commissioner for distribution
#ASSERT `o 46 r 3(3) it is sufficient to state the name of each person and the amount to be paid on each person's account` FALSE FALSE EQUALS JUST FALSE -- the "where" fails

-- ---------------------------------------------------------------------------
-- Rule 3(4) (line 6125): sealed with the seal of the Commissioner, dated and signed by the Commissioner.
-- ---------------------------------------------------------------------------
#ASSERT `o 46 r 3(4) the certificate is sealed, dated and signed as it must be` (`o 46 r 3(4) what is done to the certificate` OF TRUE, TRUE, TRUE) EQUALS JUST TRUE -- sealed, dated and signed
#ASSERT `o 46 r 3(4) the certificate is sealed, dated and signed as it must be` (`o 46 r 3(4) what is done to the certificate` OF FALSE, TRUE, TRUE) EQUALS NOTHING -- not sealed
#ASSERT `o 46 r 3(4) the certificate is sealed, dated and signed as it must be` (`o 46 r 3(4) what is done to the certificate` OF TRUE, FALSE, TRUE) EQUALS NOTHING -- not dated
#ASSERT `o 46 r 3(4) the certificate is sealed, dated and signed as it must be` (`o 46 r 3(4) what is done to the certificate` OF TRUE, TRUE, FALSE) EQUALS NOTHING -- not signed

-- ---------------------------------------------------------------------------
-- Rule 4 (line 6127): "Unless the Commissioner otherwise orders, all sums of money recovered by the Court under
-- the order, after payment of the costs, charges and expenses of enforcing the order, must be paid to the Commissioner."
-- ---------------------------------------------------------------------------
#ASSERT `o 46 r 4 the sums recovered must be paid to the Commissioner` TRUE FALSE EQUALS JUST TRUE -- a sum was recovered and the Commissioner has not otherwise ordered
#ASSERT `o 46 r 4 the sums recovered must be paid to the Commissioner` TRUE TRUE EQUALS JUST FALSE -- the Commissioner has otherwise ordered: "Unless" lifts the duty
#ASSERT `o 46 r 4 the sums recovered must be paid to the Commissioner` FALSE TRUE EQUALS JUST FALSE -- "Unless" lifts the duty whether or not a sum was recovered
#ASSERT `o 46 r 4 the sums recovered must be paid to the Commissioner` FALSE FALSE EQUALS NOTHING -- no sum recovered: nothing for the rule to say

#ASSERT `o 46 r 4 the amount that must be paid to the Commissioner` 1000 150 EQUALS 850 -- $1,000 recovered less $150 costs: $850
#ASSERT `o 46 r 4 the amount that must be paid to the Commissioner` 1000 1000 EQUALS 0 -- costs equal to the sum recovered: nothing is left
#ASSERT `o 46 r 4 the amount that must be paid to the Commissioner` 1000 1200 EQUALS 0 -- costs above the sum recovered: still nothing, never a negative sum
#ASSERT `o 46 r 4 the amount that must be paid to the Commissioner` 1000 0 EQUALS 1000 -- no costs: the whole sum
