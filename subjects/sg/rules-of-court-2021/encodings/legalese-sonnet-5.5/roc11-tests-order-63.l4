IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc11-order-63`

-- TESTS for Order 63 (Securities and Futures Act, order for disgorgement against third party).  Every expected value is
-- written from the text of the rule, beside the assertion, before the code was run.  The "last day" inputs are made-up
-- dates: the merged file replaces them with calls to roc1's O 3 r 3.

-- ---------------------------------------------------------------------------
§ `Order 63 rule 1 -- definitions and application`
-- ---------------------------------------------------------------------------
#ASSERT `o 63 r 1(1) the Act` EQUALS "the Securities and Futures Act"
#ASSERT `o 63 r 1(1) the Authority` EQUALS "the Monetary Authority of Singapore established by section 3 of the Monetary Authority of Singapore Act"
#ASSERT `o 63 r 1(1) "claimant" the section that gives its meaning` EQUALS "section 236L(12)"
#ASSERT `o 63 r 1(1) "third party" the section that gives its meaning` EQUALS "section 236L(1)"
#ASSERT `o 63 r 1(1) a reference to a section is a reference to a section in the Act` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 1(1) a reference to a section is a reference to a section in the Act` FALSE FALSE EQUALS NOTHING
#ASSERT `o 63 r 1(1) a reference to a section is a reference to a section in the Act` TRUE TRUE EQUALS NOTHING
-- "order for disgorgement" means an order applied for under section 236L(1).
#ASSERT `o 63 r 1(1) "order for disgorgement" the order is an order for disgorgement` TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 1(1) "order for disgorgement" the order is an order for disgorgement` FALSE EQUALS JUST FALSE
#ASSERT `o 63 r 1(2) these Rules apply to the proceeding` TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 1(2) these Rules apply to the proceeding` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 63 rule 2 -- commencement of the action`
-- ---------------------------------------------------------------------------
#ASSERT `o 63 r 2(1) the application for an order for disgorgement may be made in this way` TRUE `Originating application` TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 2(1) the application for an order for disgorgement may be made in this way` TRUE Summons TRUE EQUALS NOTHING
#ASSERT `o 63 r 2(1) the application for an order for disgorgement may be made in this way` TRUE `Originating application` FALSE EQUALS NOTHING
#ASSERT `o 63 r 2(1) the application for an order for disgorgement may be made in this way` FALSE `Originating application` TRUE EQUALS NOTHING
#ASSERT `o 63 r 2(2) the provision applies to the originating application` TRUE "Order 6 rule 13" FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 2(2) the provision applies to the originating application` TRUE "Order 9" FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 2(2) the provision applies to the originating application` TRUE "Order 15 rule 7" FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 2(2) the provision applies to the originating application` TRUE "Order 9" TRUE EQUALS JUST FALSE
#ASSERT `o 63 r 2(2) the provision applies to the originating application` TRUE "Order 8" FALSE EQUALS NOTHING
#ASSERT `o 63 r 2(2) the provision applies to the originating application` FALSE "Order 9" FALSE EQUALS NOTHING
-- (3): fields (a); (a)(i); (a)(ii); (a)(iii); (a)(iv); (b) made by a claimant; (b)(i); (b)(ii); (b)(iii); (b)(iv).
`o 63 r 2(3) fixture applicant is the Authority, all of (a)` MEANS `o 63 r 2(3) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`o 63 r 2(3) fixture applicant is a claimant, all stated` MEANS `o 63 r 2(3) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE
`o 63 r 2(3) fixture applicant is a claimant, part (b) missing` MEANS `o 63 r 2(3) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, FALSE, TRUE
`o 63 r 2(3) fixture nothing, applicant is a claimant` MEANS `o 63 r 2(3) affidavit` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`o 63 r 2(3) fixture nothing, applicant is the Authority` MEANS `o 63 r 2(3) affidavit` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
#ASSERT count (`o 63 r 2(3) the matters the affidavit has not yet set out` `o 63 r 2(3) fixture applicant is the Authority, all of (a)`) EQUALS 0
#ASSERT count (`o 63 r 2(3) the matters the affidavit has not yet set out` `o 63 r 2(3) fixture applicant is a claimant, all stated`) EQUALS 0
#ASSERT count (`o 63 r 2(3) the matters the affidavit has not yet set out` `o 63 r 2(3) fixture applicant is a claimant, part (b) missing`) EQUALS 2
#ASSERT elem "(b)(i) particulars of the securities transaction, futures contract, or contract or arrangement in connection with leveraged foreign exchange trading, in respect of which the claimant suffered a loss" (`o 63 r 2(3) the matters the affidavit has not yet set out` `o 63 r 2(3) fixture applicant is a claimant, part (b) missing`)
#ASSERT elem "(b)(iii) circumstances leading to the loss suffered" (`o 63 r 2(3) the matters the affidavit has not yet set out` `o 63 r 2(3) fixture applicant is a claimant, part (b) missing`)
-- Part (b) is not asked of an applicant who is not a claimant: the five items of (a) are missing.
#ASSERT count (`o 63 r 2(3) the matters the affidavit has not yet set out` `o 63 r 2(3) fixture nothing, applicant is the Authority`) EQUALS 5
-- A claimant who states nothing: (a) five and (b) four = 9.
#ASSERT count (`o 63 r 2(3) the matters the affidavit has not yet set out` `o 63 r 2(3) fixture nothing, applicant is a claimant`) EQUALS 9
#ASSERT `o 63 r 2(3) the affidavit supporting the application sets out what the Rule requires` `o 63 r 2(3) fixture applicant is the Authority, all of (a)` EQUALS JUST TRUE
#ASSERT `o 63 r 2(3) the affidavit supporting the application sets out what the Rule requires` `o 63 r 2(3) fixture applicant is a claimant, all stated` EQUALS JUST TRUE
#ASSERT `o 63 r 2(3) the affidavit supporting the application sets out what the Rule requires` `o 63 r 2(3) fixture applicant is a claimant, part (b) missing` EQUALS NOTHING
-- (4): the last day for serving is 20 November 2026 (made up).
#ASSERT `o 63 r 2(4) the period for serving the application before the hearing`'s `period length` EQUALS 28
#ASSERT `o 63 r 2(4) the period for serving the application before the hearing`'s `period unit` EQUALS `Clear days`
#ASSERT `o 63 r 2(4) the duty to serve the application personally in time arises` FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 2(4) the duty to serve the application personally in time arises` TRUE EQUALS JUST FALSE
-- Arguments: Court otherwise orders; served on the third party; Court directed another; served on that other; date served; last day.
#ASSERT `o 63 r 2(4) the application and affidavit are served as the Rule requires` FALSE TRUE FALSE FALSE (Date 20 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `o 63 r 2(4) the application and affidavit are served as the Rule requires` FALSE TRUE TRUE TRUE (Date 19 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `o 63 r 2(4) the application and affidavit are served as the Rule requires` FALSE TRUE FALSE FALSE (Date 21 11 2026) (Date 20 11 2026) EQUALS JUST FALSE
-- The Court directed service on another interested person and it was not served on them.
#ASSERT `o 63 r 2(4) the application and affidavit are served as the Rule requires` FALSE TRUE TRUE FALSE (Date 19 11 2026) (Date 20 11 2026) EQUALS NOTHING
-- Not served personally on the third party.
#ASSERT `o 63 r 2(4) the application and affidavit are served as the Rule requires` FALSE FALSE FALSE FALSE (Date 19 11 2026) (Date 20 11 2026) EQUALS NOTHING
-- The Court otherwise orders: the duty does not arise.
#ASSERT `o 63 r 2(4) the application and affidavit are served as the Rule requires` TRUE FALSE FALSE FALSE (Date 25 11 2026) (Date 20 11 2026) EQUALS NOTHING
#ASSERT `o 63 r 2(4) the applicant complied with paragraph (4)` FALSE TRUE FALSE FALSE (Date 20 11 2026) (Date 20 11 2026) EQUALS TRUE
#ASSERT `o 63 r 2(4) the applicant complied with paragraph (4)` FALSE TRUE FALSE FALSE (Date 21 11 2026) (Date 20 11 2026) EQUALS FALSE
#ASSERT `o 63 r 2(4) the applicant complied with paragraph (4)` TRUE FALSE FALSE FALSE (Date 25 11 2026) (Date 20 11 2026) EQUALS TRUE
-- (5): deemed dismissed unless the Court otherwise directs.
#ASSERT `o 63 r 2(5) the application is deemed dismissed` FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 2(5) the application is deemed dismissed` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 63 r 2(5) the application is deemed dismissed` FALSE TRUE EQUALS JUST FALSE
-- (6) and (7).
#ASSERT `o 63 r 2(6) the form of the notice to show cause` EQUALS "92"
#ASSERT `o 63 r 2(6) the Court may direct the applicant to serve a notice to show cause on the third party` TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 2(6) the Court may direct the applicant to serve a notice to show cause on the third party` FALSE EQUALS JUST FALSE
#ASSERT `o 63 r 2(7) the person may show cause by affidavit or otherwise to the satisfaction of the Court` TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 2(7) the person may show cause by affidavit or otherwise to the satisfaction of the Court` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `Order 63 rule 3 -- application for directions`
-- ---------------------------------------------------------------------------
-- (1): the order has been made final, and the person is the applicant for the order or a claimant.
#ASSERT `o 63 r 3(1) the person may apply for directions on claims for compensation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 3(1) the person may apply for directions on claims for compensation` TRUE FALSE EQUALS NOTHING
-- The "If" is not met: the order is not yet final.
#ASSERT `o 63 r 3(1) the person may apply for directions on claims for compensation` FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 63 r 3(1) the person may apply for directions on claims for compensation` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 63 r 3(1) the Court may fix a return date for hearing the application` TRUE TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 3(1) the Court may fix a return date for hearing the application` TRUE FALSE EQUALS NOTHING
#ASSERT `o 63 r 3(1) the Court may fix a return date for hearing the application` FALSE TRUE EQUALS NOTHING
#ASSERT `o 63 r 3(2) the application for directions is made as the Rule requires` TRUE Summons EQUALS JUST TRUE
#ASSERT `o 63 r 3(2) the application for directions is made as the Rule requires` TRUE `Originating application` EQUALS NOTHING
#ASSERT `o 63 r 3(2) the application for directions is made as the Rule requires` FALSE Summons EQUALS NOTHING
-- (3): the last day for serving is 20 November 2026 (made up).
#ASSERT `o 63 r 3(3) the period for serving the application before the return date`'s `period length` EQUALS 28
#ASSERT `o 63 r 3(3) the duty to serve the application personally in time arises` FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 3(3) the duty to serve the application personally in time arises` TRUE EQUALS JUST FALSE
#ASSERT `o 63 r 3(3) the application is served as the Rule requires` FALSE TRUE FALSE FALSE (Date 20 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `o 63 r 3(3) the application is served as the Rule requires` FALSE TRUE TRUE TRUE (Date 20 11 2026) (Date 20 11 2026) EQUALS JUST TRUE
#ASSERT `o 63 r 3(3) the application is served as the Rule requires` FALSE TRUE FALSE FALSE (Date 21 11 2026) (Date 20 11 2026) EQUALS JUST FALSE
#ASSERT `o 63 r 3(3) the application is served as the Rule requires` FALSE TRUE TRUE FALSE (Date 19 11 2026) (Date 20 11 2026) EQUALS NOTHING
#ASSERT `o 63 r 3(3) the application is served as the Rule requires` TRUE FALSE FALSE FALSE (Date 25 11 2026) (Date 20 11 2026) EQUALS NOTHING
#ASSERT `o 63 r 3(3) the applicant for directions complied with paragraph (3)` FALSE TRUE FALSE FALSE (Date 20 11 2026) (Date 20 11 2026) EQUALS TRUE
#ASSERT `o 63 r 3(3) the applicant for directions complied with paragraph (3)` FALSE TRUE FALSE FALSE (Date 21 11 2026) (Date 20 11 2026) EQUALS FALSE
-- (4): Form 93, at least 21 clear days; the last day is 27 November 2026 (made up).
#ASSERT `o 63 r 3(4) the form of the advertisement` EQUALS "93"
#ASSERT `o 63 r 3(4) the period for advertising the application before the return date`'s `period length` EQUALS 21
#ASSERT `o 63 r 3(4) the application is advertised as the Rule requires` TRUE TRUE FALSE (Date 27 11 2026) (Date 27 11 2026) EQUALS JUST TRUE
#ASSERT `o 63 r 3(4) the application is advertised as the Rule requires` TRUE FALSE TRUE (Date 26 11 2026) (Date 27 11 2026) EQUALS JUST TRUE
#ASSERT `o 63 r 3(4) the application is advertised as the Rule requires` TRUE TRUE FALSE (Date 28 11 2026) (Date 27 11 2026) EQUALS JUST FALSE
#ASSERT `o 63 r 3(4) the application is advertised as the Rule requires` FALSE TRUE FALSE (Date 26 11 2026) (Date 27 11 2026) EQUALS NOTHING
#ASSERT `o 63 r 3(4) the application is advertised as the Rule requires` TRUE FALSE FALSE (Date 26 11 2026) (Date 27 11 2026) EQUALS NOTHING
#ASSERT `o 63 r 3(4) the applicant for directions complied with paragraph (4)` TRUE TRUE FALSE (Date 27 11 2026) (Date 27 11 2026) EQUALS TRUE
#ASSERT `o 63 r 3(4) the applicant for directions complied with paragraph (4)` TRUE TRUE FALSE (Date 28 11 2026) (Date 27 11 2026) EQUALS FALSE
-- (5): what the advertisement states.
#ASSERT count (`o 63 r 3(5) the matters the advertisement has not yet stated` (`o 63 r 3(5) advertisement` OF TRUE, TRUE, TRUE, TRUE)) EQUALS 0
#ASSERT count (`o 63 r 3(5) the matters the advertisement has not yet stated` (`o 63 r 3(5) advertisement` OF TRUE, TRUE, FALSE, FALSE)) EQUALS 0
#ASSERT count (`o 63 r 3(5) the matters the advertisement has not yet stated` (`o 63 r 3(5) advertisement` OF FALSE, TRUE, TRUE, FALSE)) EQUALS 2
#ASSERT elem "the day on which the application was filed" (`o 63 r 3(5) the matters the advertisement has not yet stated` (`o 63 r 3(5) advertisement` OF FALSE, TRUE, TRUE, FALSE))
#ASSERT `o 63 r 3(5) the advertisement states what the Rule requires` (`o 63 r 3(5) advertisement` OF TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 63 r 3(5) the advertisement states what the Rule requires` (`o 63 r 3(5) advertisement` OF TRUE, FALSE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `o 63 r 3(5) the applicant for directions complied with paragraph (5)` (`o 63 r 3(5) advertisement` OF TRUE, TRUE, FALSE, FALSE) EQUALS TRUE
#ASSERT `o 63 r 3(5) the applicant for directions complied with paragraph (5)` (`o 63 r 3(5) advertisement` OF TRUE, FALSE, FALSE, FALSE) EQUALS FALSE
-- (6): cancel and deem dismissed unless the Court otherwise directs.
#ASSERT `o 63 r 3(6) the application is deemed dismissed` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 63 r 3(6) the application is deemed dismissed` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 3(6) the application is deemed dismissed` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 3(6) the application is deemed dismissed` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 3(6) the application is deemed dismissed` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `o 63 r 3(6) the Court must cancel the appointment of the time and place for the hearing` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 3(6) the Court must cancel the appointment of the time and place for the hearing` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 63 r 3(6) the Court must cancel the appointment of the time and place for the hearing` FALSE TRUE TRUE TRUE EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§ `Order 63 rule 4 -- proof of claim`
-- ---------------------------------------------------------------------------
#ASSERT `o 63 r 4(1) the period for filing the affidavit of claim before the return date`'s `period length` EQUALS 7
#ASSERT `o 63 r 4(1) the duty to file an affidavit of claim arises` TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 4(1) the duty to file an affidavit of claim arises` FALSE EQUALS JUST FALSE
-- The last day for filing is 4 December 2026 (made up).
#ASSERT `o 63 r 4(1) the claimant files the affidavit of claim in time` TRUE (JUST (Date 4 12 2026)) (Date 5 12 2026) (Date 4 12 2026) EQUALS JUST TRUE
#ASSERT `o 63 r 4(1) the claimant files the affidavit of claim in time` TRUE (JUST (Date 5 12 2026)) (Date 5 12 2026) (Date 4 12 2026) EQUALS JUST FALSE
#ASSERT `o 63 r 4(1) the claimant files the affidavit of claim in time` TRUE NOTHING (Date 4 12 2026) (Date 4 12 2026) EQUALS NOTHING
#ASSERT `o 63 r 4(1) the claimant files the affidavit of claim in time` TRUE NOTHING (Date 5 12 2026) (Date 4 12 2026) EQUALS JUST FALSE
#ASSERT `o 63 r 4(1) the claimant files the affidavit of claim in time` FALSE NOTHING (Date 5 12 2026) (Date 4 12 2026) EQUALS NOTHING
#ASSERT count (`o 63 r 4(2) the matters the affidavit has not yet covered` (`o 63 r 4(2) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE)) EQUALS 0
#ASSERT count (`o 63 r 4(2) the matters the affidavit has not yet covered` (`o 63 r 4(2) affidavit` OF FALSE, TRUE, TRUE, FALSE, TRUE, TRUE)) EQUALS 2
#ASSERT elem "(b) circumstances leading to the entering into of the transaction in question" (`o 63 r 4(2) the matters the affidavit has not yet covered` (`o 63 r 4(2) affidavit` OF FALSE, TRUE, TRUE, FALSE, TRUE, TRUE))
#ASSERT count (`o 63 r 4(2) the matters the affidavit has not yet covered` (`o 63 r 4(2) affidavit` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE)) EQUALS 6
#ASSERT `o 63 r 4(2) the affidavit of claim covers what the Rule requires` (`o 63 r 4(2) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
#ASSERT `o 63 r 4(2) the affidavit of claim covers what the Rule requires` (`o 63 r 4(2) affidavit` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS NOTHING
#ASSERT `o 63 r 4(3) the exhibits may include` `o 63 r 4(3)(a) trade notes or slips` EQUALS JUST TRUE
#ASSERT `o 63 r 4(3) the exhibits may include` `o 63 r 4(3)(b) statements of accounts for the relevant period` EQUALS JUST TRUE
#ASSERT `o 63 r 4(3) the exhibits may include` `o 63 r 4(3)(c) copies of instructions given to a broker or remisier` EQUALS JUST TRUE
#ASSERT `o 63 r 4(3) the exhibits may include` `o 63 r 4(3) another exhibit` EQUALS NOTHING
#ASSERT `o 63 r 4(4) the period for serving a copy of the affidavit on the third party`'s `period length` EQUALS 3
#ASSERT `o 63 r 4(4) the claimant serves a copy of the affidavit on the third party in time` (JUST (Date 8 12 2026)) (Date 9 12 2026) (Date 8 12 2026) EQUALS JUST TRUE
#ASSERT `o 63 r 4(4) the claimant serves a copy of the affidavit on the third party in time` (JUST (Date 9 12 2026)) (Date 9 12 2026) (Date 8 12 2026) EQUALS JUST FALSE
#ASSERT `o 63 r 4(4) the claimant serves a copy of the affidavit on the third party in time` NOTHING (Date 8 12 2026) (Date 8 12 2026) EQUALS NOTHING
#ASSERT `o 63 r 4(4) the claimant serves a copy of the affidavit on the third party in time` NOTHING (Date 9 12 2026) (Date 8 12 2026) EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§ `Order 63 rule 5 -- powers of the Court`
-- ---------------------------------------------------------------------------
#ASSERT `o 63 r 5(1) the Court may give directions or make orders after the hearing` `o 63 r 5(1)(a) the hearing of an application under Rule 2(1)` FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 5(1) the Court may give directions or make orders after the hearing` `o 63 r 5(1)(b) the hearing of the third party under Rule 2(7)` FALSE EQUALS JUST TRUE
-- Item (c) carries the proviso: everyone served, and every claimant who filed, must appear.
#ASSERT `o 63 r 5(1) the Court may give directions or make orders after the hearing` `o 63 r 5(1)(c) the hearing of an application under Rule 3(1)` TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 5(1) the Court may give directions or make orders after the hearing` `o 63 r 5(1)(c) the hearing of an application under Rule 3(1)` FALSE EQUALS JUST FALSE
#ASSERT `o 63 r 5(1) the Court may give directions or make orders after the hearing` `o 63 r 5(1) some other stage` TRUE EQUALS JUST FALSE
#ASSERT `o 63 r 5(1) the Court may give this kind of direction or make this kind of order` `o 63 r 5(1)(f) that an issue be stated and tried` `o 63 r 5(1)(c) the hearing of an application under Rule 3(1)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 5(1) the Court may give this kind of direction or make this kind of order` `o 63 r 5(1)(j) that the application under Rule 2(1) or 3(1) be dismissed` `o 63 r 5(1)(a) the hearing of an application under Rule 2(1)` FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 5(1) the Court may give this kind of direction or make this kind of order` `o 63 r 5(1)(g) that the matter be adjourned` `o 63 r 5(1)(c) the hearing of an application under Rule 3(1)` FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 63 r 5(1) the Court may give this kind of direction or make this kind of order` `o 63 r 5(1) another kind of direction or order` `o 63 r 5(1)(a) the hearing of an application under Rule 2(1)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 5(1) the Court may give this kind of direction or make this kind of order` `o 63 r 5(1) another kind of direction or order` `o 63 r 5(1)(a) the hearing of an application under Rule 2(1)` FALSE FALSE EQUALS NOTHING
-- (2): arguments: is the third party or another interested party; served with notice; did not appear at that hearing; served with application; did not appear; appeared but did not comply.
#ASSERT `o 63 r 5(2) the Court may make such order as it deems appropriate` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 5(2) the Court may make such order as it deems appropriate` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 5(2) the Court may make such order as it deems appropriate` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- Served with the notice but appeared, and complied.
#ASSERT `o 63 r 5(2) the Court may make such order as it deems appropriate` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- Did not appear, but was never served.
#ASSERT `o 63 r 5(2) the Court may make such order as it deems appropriate` TRUE FALSE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- Not the third party or an interested party.
#ASSERT `o 63 r 5(2) the Court may make such order as it deems appropriate` FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 63 r 5(3) the Court may declare the claimant forever barred` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 5(3) the Court may declare the claimant forever barred` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 5(3) the Court may declare the claimant forever barred` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `o 63 r 5(3) the Court may declare the claimant forever barred` FALSE TRUE FALSE EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
§ `Order 63 rules 6, 7 and 8`
-- ---------------------------------------------------------------------------
#ASSERT `o 63 r 6 the Court may make such order as to costs or any other matter as it thinks just` TRUE FALSE EQUALS JUST TRUE
#ASSERT `o 63 r 6 the Court may make such order as to costs or any other matter as it thinks just` TRUE TRUE EQUALS NOTHING
#ASSERT `o 63 r 6 the Court may make such order as to costs or any other matter as it thinks just` FALSE FALSE EQUALS NOTHING
#ASSERT `o 63 r 7(1) Order 15 applies to the trial of the issue` TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 7(1) Order 15 applies to the trial of the issue` FALSE EQUALS NOTHING
#ASSERT `o 63 r 7(2) the Court may give such judgment or make such order as finally to dispose of all questions` TRUE EQUALS JUST TRUE
#ASSERT `o 63 r 7(2) the Court may give such judgment or make such order as finally to dispose of all questions` FALSE EQUALS NOTHING
#ASSERT `o 63 r 8(1) a rule of Order 62 applies to the application` TRUE "6" EQUALS JUST TRUE
#ASSERT `o 63 r 8(1) a rule of Order 62 applies to the application` TRUE "7" EQUALS JUST TRUE
#ASSERT `o 63 r 8(1) a rule of Order 62 applies to the application` TRUE "8" EQUALS JUST TRUE
#ASSERT `o 63 r 8(1) a rule of Order 62 applies to the application` TRUE "10" EQUALS JUST TRUE
#ASSERT `o 63 r 8(1) a rule of Order 62 applies to the application` TRUE "12" EQUALS JUST TRUE
#ASSERT `o 63 r 8(1) a rule of Order 62 applies to the application` TRUE "9" EQUALS NOTHING
#ASSERT `o 63 r 8(1) a rule of Order 62 applies to the application` FALSE "8" EQUALS NOTHING
#ASSERT `o 63 r 8(2) a reference to the defendant in Order 62 rule 8 is a reference to` TRUE TRUE EQUALS JUST "the person referred to in section 236L(1)(a), (b) or (c) (as the case may be) or the third party"
#ASSERT `o 63 r 8(2) a reference to the defendant in Order 62 rule 8 is a reference to` TRUE FALSE EQUALS NOTHING
#ASSERT `o 63 r 8(2) a reference to the defendant in Order 62 rule 8 is a reference to` FALSE TRUE EQUALS NOTHING
