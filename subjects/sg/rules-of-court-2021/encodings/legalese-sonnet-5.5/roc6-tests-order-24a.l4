IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc6-order-24a`

-- Tests for roc6-order-24a.l4 (Order 24A, Post-appeal applications in capital cases).
-- Every expected value is written from the text of Order 24A (lines 3827 to 3925 of the source), beside the
-- assertion, before the code was run.  The last days are made up: Order 3, Rule 3 (roc1's range) counts them.

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 1`
-- ---------------------------------------------------------------------------

#ASSERT `o 24A r 1(1) "Act" is the Supreme Court of Judicature Act 1969` TRUE EQUALS JUST TRUE -- "Act" means that Act
#ASSERT `o 24A r 1(1) "Act" is the Supreme Court of Judicature Act 1969` FALSE EQUALS JUST FALSE -- "means"
-- arguments: the reference is to a section in the Act; it is otherwise expressly provided
#ASSERT `o 24A r 1(1) a reference to a section is a reference to a section in the Act` TRUE FALSE EQUALS JUST TRUE -- no other provision: a section in the Act
#ASSERT `o 24A r 1(1) a reference to a section is a reference to a section in the Act` FALSE FALSE EQUALS JUST FALSE -- no other provision, so it is not a section of the Act, which the Rule says it is
#ASSERT `o 24A r 1(1) a reference to a section is a reference to a section in the Act` TRUE TRUE EQUALS NOTHING -- "unless it is otherwise expressly provided": what is provided is not stated
#ASSERT `o 24A r 1(1) a reference to a section is a reference to a section in the Act` FALSE TRUE EQUALS NOTHING -- "unless it is otherwise expressly provided"
#ASSERT `o 24A r 1(2) the expression has the meaning given by section 60F` (JUST TRUE) EQUALS JUST TRUE -- section 60F says so
#ASSERT `o 24A r 1(2) the expression has the meaning given by section 60F` (JUST FALSE) EQUALS JUST FALSE -- section 60F says otherwise
#ASSERT `o 24A r 1(2) the expression has the meaning given by section 60F` NOTHING EQUALS NOTHING -- section 60F is outside the sources

#ASSERT `o 24A r 1(3) the application is made in the way required` `o 24A r 1(3)(a) an application for PACC permission` `o 24A r 1(3) by originating application` EQUALS JUST TRUE -- (a)
#ASSERT `o 24A r 1(3) the application is made in the way required` `o 24A r 1(3)(a) an application for PACC permission` `o 24A r 1(3) by summons in the originating application in which the application for PACC permission was granted` EQUALS NOTHING -- (a) but made by summons: silent on what follows
#ASSERT `o 24A r 1(3) the application is made in the way required` `o 24A r 1(3)(a) an application for PACC permission` `o 24A r 1(3) in some other way` EQUALS NOTHING -- (a) but another way
#ASSERT `o 24A r 1(3) the application is made in the way required` `o 24A r 1(3)(b) a PACC application` `o 24A r 1(3) by summons in the originating application in which the application for PACC permission was granted` EQUALS JUST TRUE -- (b)
#ASSERT `o 24A r 1(3) the application is made in the way required` `o 24A r 1(3)(b) a PACC application` `o 24A r 1(3) by originating application` EQUALS NOTHING -- (b) but by originating application
#ASSERT `o 24A r 1(3) the application is made in the way required` `o 24A r 1(3)(b) a PACC application` `o 24A r 1(3) in some other way` EQUALS NOTHING -- (b) but another way
#ASSERT `o 24A r 1(3) the application is made in the way required` `o 24A r 1(3) some other application` `o 24A r 1(3) by originating application` EQUALS NOTHING -- not an application to which this Order applies

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 2`
-- ---------------------------------------------------------------------------

#ASSERT `o 24A r 2(1) twenty-one days`'s `period length` EQUALS 21 -- "within 21 days"
#ASSERT `o 24A r 2(1) twenty-one days`'s `period unit` EQUALS Days -- days
#ASSERT `o 24A r 2(1) twenty-one days`'s `period direction` EQUALS `After the anchor` -- after the filing
-- arguments: the hearing date; the last day (O 3 r 3)
#ASSERT `o 24A r 2(1) the application for PACC permission is fixed for hearing within 21 days after it is filed` (Date 20 1 2027) (Date 22 1 2027) EQUALS JUST TRUE -- inside
#ASSERT `o 24A r 2(1) the application for PACC permission is fixed for hearing within 21 days after it is filed` (Date 22 1 2027) (Date 22 1 2027) EQUALS JUST TRUE -- the last day
#ASSERT `o 24A r 2(1) the application for PACC permission is fixed for hearing within 21 days after it is filed` (Date 23 1 2027) (Date 22 1 2027) EQUALS JUST FALSE -- one day late (ruling (a))

-- arguments: the date the application was filed; the date the submissions were filed; the date the other documents were filed
#ASSERT `o 24A r 2(2) the written submissions and the other documents are filed at the same time as the application` (Date 5 1 2027) (Date 5 1 2027) (Date 5 1 2027) EQUALS JUST TRUE -- all on one day
#ASSERT `o 24A r 2(2) the written submissions and the other documents are filed at the same time as the application` (Date 5 1 2027) (Date 6 1 2027) (Date 5 1 2027) EQUALS JUST FALSE -- the submissions a day later
#ASSERT `o 24A r 2(2) the written submissions and the other documents are filed at the same time as the application` (Date 5 1 2027) (Date 5 1 2027) (Date 6 1 2027) EQUALS JUST FALSE -- the other documents a day later

#ASSERT `o 24A r 2(3) the page limit for the applicant's written submissions` EQUALS 35 -- "35 pages"
-- arguments: pages; the Court of Appeal otherwise allows
#ASSERT `o 24A r 2(3) the written submissions are within the page limit` 35 FALSE EQUALS JUST TRUE -- exactly 35 pages
#ASSERT `o 24A r 2(3) the written submissions are within the page limit` 1 FALSE EQUALS JUST TRUE -- 1 page
#ASSERT `o 24A r 2(3) the written submissions are within the page limit` 36 FALSE EQUALS JUST FALSE -- 36 pages, no leave
#ASSERT `o 24A r 2(3) the written submissions are within the page limit` 36 TRUE EQUALS JUST TRUE -- 36 pages, the Court of Appeal allows it

-- A helper: every matter required of counsel, and every matter required of an applicant without counsel.
`roc6 test 24A every matter required of counsel` MEANS `o 24A r 2(4)(a) all the matters`
`roc6 test 24A every matter required of an applicant without counsel` MEANS `o 24A r 2(4)(b) all the matters`

-- arguments: the applicant is represented by counsel; the matters the affidavit states
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE `roc6 test 24A every matter required of counsel` EQUALS JUST TRUE -- all of (i) to (xi)
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` FALSE `roc6 test 24A every matter required of counsel` EQUALS JUST FALSE -- "where the applicant is represented by one or more counsel": not represented (ruling (b))
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (append `roc6 test 24A every matter required of counsel` (LIST `o 24A r 2(4)(a) some other matter`)) EQUALS JUST TRUE -- every required matter, and another the affidavit also states: nothing in the Rule makes that a failure
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (LIST) EQUALS NOTHING -- an empty affidavit
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(i) the date each counsel was instructed, and who instructed each`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(ii) the material that will be relied on in the PACC application`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(iii) the date the material was first obtained`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(iv) why the material could not have been adduced before the relevant date with reasonable diligence`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(v) the reason for the interval between that date and the filing of the application for PACC permission`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(vi) whether a similar argument was made before and whether it was dismissed`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(vii)(A) the details of every application for review permission and every review application`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(vii)(B) the details of every other application for PACC permission and every PACC application`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(viii)(A) the details of every other application made on or after 28 June 2024 found to be an abuse of process`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(viii)(B) the details of every action filed on or after 28 June 2024 found to be an abuse of process`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(ix) that each counsel genuinely believes the PACC application to be of merit`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(x) why each counsel believes the PACC application to be of merit and its legal arguments persuasive`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(a) the counsel's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(xi) that each counsel is aware of the consequences of making a false statement in the affidavit`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- "all of the following": this one is missing

-- arguments: the applicant is not represented by counsel; the matters the affidavit states
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` TRUE `roc6 test 24A every matter required of an applicant without counsel` EQUALS JUST TRUE -- all of (i) to (vii)
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` FALSE `roc6 test 24A every matter required of an applicant without counsel` EQUALS JUST FALSE -- "where the applicant is not represented by counsel": represented (ruling (b))
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` TRUE (append `roc6 test 24A every matter required of an applicant without counsel` (LIST `o 24A r 2(4)(b) some other matter`)) EQUALS JUST TRUE -- every required matter, and another the affidavit also states
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` TRUE (LIST) EQUALS NOTHING -- an empty affidavit
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(b)(i) the material that will be relied on in the PACC application`))) `roc6 test 24A every matter required of an applicant without counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(b)(ii) the date the applicant first obtained the material`))) `roc6 test 24A every matter required of an applicant without counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(b)(iii) why the material could not have been adduced before the relevant date with reasonable diligence`))) `roc6 test 24A every matter required of an applicant without counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(b)(iv) the reason for the interval between that date and the filing of the application for PACC permission`))) `roc6 test 24A every matter required of an applicant without counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(b)(v)(A) the details of every application for review permission and every review application`))) `roc6 test 24A every matter required of an applicant without counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(b)(v)(B) the details of every other application for PACC permission and every PACC application`))) `roc6 test 24A every matter required of an applicant without counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(b)(vi)(A) the details of every other application made on or after 28 June 2024 found to be an abuse of process`))) `roc6 test 24A every matter required of an applicant without counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(b)(vi)(B) the details of every action filed on or after 28 June 2024 found to be an abuse of process`))) `roc6 test 24A every matter required of an applicant without counsel`) EQUALS NOTHING -- "all of the following": this one is missing
#ASSERT `o 24A r 2(4)(b) the applicant's affidavit states all the matters required` TRUE (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(b)(vii) whether the applicant is or was assisted by any person or organisation, and who and how`))) `roc6 test 24A every matter required of an applicant without counsel`) EQUALS NOTHING -- "all of the following": this one is missing

-- arguments: the information relates to an event before 28 June 2024; the affidavit states it
#ASSERT `o 24A r 2(5) the affidavit must state the information even though it relates to an event before 28 June 2024` TRUE TRUE EQUALS JUST TRUE -- an earlier event, stated
#ASSERT `o 24A r 2(5) the affidavit must state the information even though it relates to an event before 28 June 2024` TRUE FALSE EQUALS NOTHING -- an earlier event, not stated: silent on what follows
#ASSERT `o 24A r 2(5) the affidavit must state the information even though it relates to an event before 28 June 2024` FALSE TRUE EQUALS NOTHING -- not an earlier event: the paragraph is about earlier events

-- arguments: the application served; the submissions served; the other documents served
#ASSERT `o 24A r 2(6) the applicant has served the application, the submissions and the other documents on the respondent` TRUE TRUE TRUE EQUALS JUST TRUE -- all three served
#ASSERT `o 24A r 2(6) the applicant has served the application, the submissions and the other documents on the respondent` FALSE TRUE TRUE EQUALS NOTHING -- the application not served
#ASSERT `o 24A r 2(6) the applicant has served the application, the submissions and the other documents on the respondent` TRUE FALSE TRUE EQUALS NOTHING -- the submissions not served
#ASSERT `o 24A r 2(6) the applicant has served the application, the submissions and the other documents on the respondent` TRUE TRUE FALSE EQUALS NOTHING -- the other documents not served

-- arguments: represented at filing; appoints additional or different counsel; appoints one or more counsel; by filing a notice
#ASSERT `o 24A r 2(7) paragraphs (8) and (9) apply to the applicant` TRUE TRUE FALSE TRUE EQUALS JUST TRUE -- (a): represented at filing, appoints additional or different counsel by notice
#ASSERT `o 24A r 2(7) paragraphs (8) and (9) apply to the applicant` FALSE FALSE TRUE TRUE EQUALS JUST TRUE -- (b): not represented at filing, appoints counsel by notice
#ASSERT `o 24A r 2(7) paragraphs (8) and (9) apply to the applicant` TRUE FALSE TRUE TRUE EQUALS NOTHING -- represented at filing, and only (b)'s kind of appointment
#ASSERT `o 24A r 2(7) paragraphs (8) and (9) apply to the applicant` FALSE TRUE FALSE TRUE EQUALS NOTHING -- not represented at filing, and only (a)'s kind of appointment
#ASSERT `o 24A r 2(7) paragraphs (8) and (9) apply to the applicant` TRUE TRUE FALSE FALSE EQUALS NOTHING -- (a) but not by a notice
#ASSERT `o 24A r 2(7) paragraphs (8) and (9) apply to the applicant` FALSE FALSE TRUE FALSE EQUALS NOTHING -- (b) but not by a notice
#ASSERT `o 24A r 2(7) paragraphs (8) and (9) apply to the applicant` FALSE FALSE FALSE FALSE EQUALS NOTHING -- no appointment

#ASSERT `o 24A r 2(8) three days`'s `period length` EQUALS 3 -- "within 3 days"
#ASSERT `o 24A r 2(8) three days`'s `period direction` EQUALS `After the anchor` -- after the appointment
-- arguments: paragraph (7) applies; the date filed; the last day (O 3 r 3)
#ASSERT `o 24A r 2(8) the affidavit of the newly appointed counsel is filed within 3 days after the appointment` TRUE (Date 8 2 2027) (Date 10 2 2027) EQUALS JUST TRUE -- inside
#ASSERT `o 24A r 2(8) the affidavit of the newly appointed counsel is filed within 3 days after the appointment` TRUE (Date 10 2 2027) (Date 10 2 2027) EQUALS JUST TRUE -- the last day
#ASSERT `o 24A r 2(8) the affidavit of the newly appointed counsel is filed within 3 days after the appointment` TRUE (Date 11 2 2027) (Date 10 2 2027) EQUALS JUST FALSE -- one day late (ruling (a))
#ASSERT `o 24A r 2(8) the affidavit of the newly appointed counsel is filed within 3 days after the appointment` FALSE (Date 8 2 2027) (Date 10 2 2027) EQUALS NOTHING -- paragraph (7) does not apply to the applicant
#ASSERT `o 24A r 2(8) the affidavit states all the matters in paragraph (4)(a)(i) to (xi)` `roc6 test 24A every matter required of counsel` EQUALS JUST TRUE -- all of (i) to (xi)
#ASSERT `o 24A r 2(8) the affidavit states all the matters in paragraph (4)(a)(i) to (xi)` (LIST) EQUALS NOTHING -- none stated
#ASSERT `o 24A r 2(8) the affidavit states all the matters in paragraph (4)(a)(i) to (xi)` (filter (GIVEN m YIELD (NOT (m EQUALS `o 24A r 2(4)(a)(xi) that each counsel is aware of the consequences of making a false statement in the affidavit`))) `roc6 test 24A every matter required of counsel`) EQUALS NOTHING -- (xi) missing

#ASSERT `o 24A r 2(9) the applicant has served every affidavit filed under paragraph (8) on the respondent` TRUE EQUALS JUST TRUE -- served
#ASSERT `o 24A r 2(9) the applicant has served every affidavit filed under paragraph (8) on the respondent` FALSE EQUALS NOTHING -- silent on what follows

-- arguments: the date the respondent filed; the last day (O 3 r 3)
#ASSERT `o 24A r 2(10)(a) the respondent's written submissions are filed within 3 days after the application is filed and served on the respondent` (Date 8 2 2027) (Date 10 2 2027) EQUALS JUST TRUE -- inside
#ASSERT `o 24A r 2(10)(a) the respondent's written submissions are filed within 3 days after the application is filed and served on the respondent` (Date 10 2 2027) (Date 10 2 2027) EQUALS JUST TRUE -- the last day
#ASSERT `o 24A r 2(10)(a) the respondent's written submissions are filed within 3 days after the application is filed and served on the respondent` (Date 11 2 2027) (Date 10 2 2027) EQUALS JUST FALSE -- one day late (ruling (a))
-- arguments: paragraphs (7), (8), (9) apply; filed and served at the same time; the date the respondent filed; the last day
#ASSERT `o 24A r 2(10)(b)(i) the respondent's written submissions are filed within 3 days after the affidavit or affidavits are filed and served` TRUE TRUE (Date 8 2 2027) (Date 10 2 2027) EQUALS JUST TRUE -- inside
#ASSERT `o 24A r 2(10)(b)(i) the respondent's written submissions are filed within 3 days after the affidavit or affidavits are filed and served` TRUE TRUE (Date 10 2 2027) (Date 10 2 2027) EQUALS JUST TRUE -- the last day
#ASSERT `o 24A r 2(10)(b)(i) the respondent's written submissions are filed within 3 days after the affidavit or affidavits are filed and served` TRUE TRUE (Date 11 2 2027) (Date 10 2 2027) EQUALS JUST FALSE -- one day late
#ASSERT `o 24A r 2(10)(b)(i) the respondent's written submissions are filed within 3 days after the affidavit or affidavits are filed and served` FALSE TRUE (Date 8 2 2027) (Date 10 2 2027) EQUALS JUST FALSE -- "where paragraphs (7), (8) and (9) apply": they do not (ruling (b))
#ASSERT `o 24A r 2(10)(b)(i) the respondent's written submissions are filed within 3 days after the affidavit or affidavits are filed and served` TRUE FALSE (Date 8 2 2027) (Date 10 2 2027) EQUALS JUST FALSE -- sub-paragraph (i) begins "if" the affidavits are filed and served at the same time (the "if" rule)
-- arguments: paragraphs (7), (8), (9) apply; more than one affidavit at different times; the date the respondent filed; the last day
#ASSERT `o 24A r 2(10)(b)(ii) the respondent's written submissions are filed within 3 days after each affidavit is filed and served` TRUE TRUE (Date 8 2 2027) (Date 10 2 2027) EQUALS JUST TRUE -- inside
#ASSERT `o 24A r 2(10)(b)(ii) the respondent's written submissions are filed within 3 days after each affidavit is filed and served` TRUE TRUE (Date 10 2 2027) (Date 10 2 2027) EQUALS JUST TRUE -- the last day
#ASSERT `o 24A r 2(10)(b)(ii) the respondent's written submissions are filed within 3 days after each affidavit is filed and served` TRUE TRUE (Date 11 2 2027) (Date 10 2 2027) EQUALS JUST FALSE -- one day late
#ASSERT `o 24A r 2(10)(b)(ii) the respondent's written submissions are filed within 3 days after each affidavit is filed and served` FALSE TRUE (Date 8 2 2027) (Date 10 2 2027) EQUALS JUST FALSE -- paragraphs (7), (8), (9) do not apply (ruling (b))
#ASSERT `o 24A r 2(10)(b)(ii) the respondent's written submissions are filed within 3 days after each affidavit is filed and served` TRUE FALSE (Date 8 2 2027) (Date 10 2 2027) EQUALS JUST FALSE -- sub-paragraph (ii) begins "if" more than one affidavit is filed and served at different times (the "if" rule)

#ASSERT `o 24A r 2(11) the page limit for the respondent's written submissions` EQUALS 35 -- "35 pages"
#ASSERT `o 24A r 2(11) the respondent's written submissions are within the page limit` 35 FALSE EQUALS JUST TRUE -- exactly 35 pages
#ASSERT `o 24A r 2(11) the respondent's written submissions are within the page limit` 36 FALSE EQUALS JUST FALSE -- 36 pages, no leave
#ASSERT `o 24A r 2(11) the respondent's written submissions are within the page limit` 36 TRUE EQUALS JUST TRUE -- the Court of Appeal allows it

-- arguments: the date the affidavit was filed; the date the submissions were filed
#ASSERT `o 24A r 2(12) the respondent may file an affidavit in support at the same time as the written submissions` (Date 8 2 2027) (Date 8 2 2027) EQUALS JUST TRUE -- the same day
#ASSERT `o 24A r 2(12) the respondent may file an affidavit in support at the same time as the written submissions` (Date 9 2 2027) (Date 8 2 2027) EQUALS JUST FALSE -- "at the same time as": a day later
#ASSERT `o 24A r 2(13) the Court of Appeal may allow the page limit to be exceeded` TRUE EQUALS JUST TRUE -- special circumstances
#ASSERT `o 24A r 2(13) the Court of Appeal may allow the page limit to be exceeded` FALSE EQUALS NOTHING -- "in special circumstances": the grant is limited by its own wording

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 3`
-- ---------------------------------------------------------------------------

#ASSERT `o 24A r 3(1) three days`'s `period length` EQUALS 3 -- "within 3 days"
#ASSERT `o 24A r 3(1) three days`'s `period direction` EQUALS `After the anchor` -- after permission is granted
-- arguments: the Court of Appeal grants permission; the date the PACC application was made; the last day (O 3 r 3)
#ASSERT `o 24A r 3(1) the PACC application is made within 3 days after permission is granted` TRUE (Date 8 3 2027) (Date 10 3 2027) EQUALS JUST TRUE -- inside
#ASSERT `o 24A r 3(1) the PACC application is made within 3 days after permission is granted` TRUE (Date 10 3 2027) (Date 10 3 2027) EQUALS JUST TRUE -- the last day
#ASSERT `o 24A r 3(1) the PACC application is made within 3 days after permission is granted` TRUE (Date 11 3 2027) (Date 10 3 2027) EQUALS JUST FALSE -- one day late (ruling (a))
#ASSERT `o 24A r 3(1) the PACC application is made within 3 days after permission is granted` FALSE (Date 8 3 2027) (Date 10 3 2027) EQUALS JUST FALSE -- "where the Court of Appeal grants the application for PACC permission": it did not (ruling (b))

#ASSERT `o 24A r 3(2) the PACC application is fixed for hearing within 21 days after it is made` (Date 20 3 2027) (Date 22 3 2027) EQUALS JUST TRUE -- inside
#ASSERT `o 24A r 3(2) the PACC application is fixed for hearing within 21 days after it is made` (Date 22 3 2027) (Date 22 3 2027) EQUALS JUST TRUE -- the last day
#ASSERT `o 24A r 3(2) the PACC application is fixed for hearing within 21 days after it is made` (Date 23 3 2027) (Date 22 3 2027) EQUALS JUST FALSE -- one day late (ruling (a))

#ASSERT `o 24A r 3(3)(a) the affidavit in support is filed at the same time as the PACC application` (Date 8 3 2027) (Date 8 3 2027) EQUALS JUST TRUE -- the same day
#ASSERT `o 24A r 3(3)(a) the affidavit in support is filed at the same time as the PACC application` (Date 8 3 2027) (Date 9 3 2027) EQUALS JUST FALSE -- a day later
#ASSERT `o 24A r 3(3)(b) the applicant's written submissions are filed within 3 days after the PACC application is made` (Date 10 3 2027) (Date 10 3 2027) EQUALS JUST TRUE -- the last day
#ASSERT `o 24A r 3(3)(b) the applicant's written submissions are filed within 3 days after the PACC application is made` (Date 11 3 2027) (Date 10 3 2027) EQUALS JUST FALSE -- one day late
#ASSERT `o 24A r 3(3)(b) the applicant's written submissions are filed within 3 days after the PACC application is made` (Date 8 3 2027) (Date 10 3 2027) EQUALS JUST TRUE -- inside

#ASSERT `o 24A r 3(4) the PACC application and the affidavit are served on the respondent within the day on which it is made` (Date 8 3 2027) (Date 8 3 2027) EQUALS JUST TRUE -- the day it is made
#ASSERT `o 24A r 3(4) the PACC application and the affidavit are served on the respondent within the day on which it is made` (Date 8 3 2027) (Date 9 3 2027) EQUALS JUST FALSE -- the next day: "within the day on which that application is made"
#ASSERT `o 24A r 3(5) the respondent's written submissions in response are filed within 3 days after the application is made and served` (Date 10 3 2027) (Date 10 3 2027) EQUALS JUST TRUE -- the last day
#ASSERT `o 24A r 3(5) the respondent's written submissions in response are filed within 3 days after the application is made and served` (Date 11 3 2027) (Date 10 3 2027) EQUALS JUST FALSE -- one day late
#ASSERT `o 24A r 3(5) the respondent's written submissions in response are filed within 3 days after the application is made and served` (Date 9 3 2027) (Date 10 3 2027) EQUALS JUST TRUE -- inside

#ASSERT `o 24A r 3(6) the page limit for written submissions on the PACC application` EQUALS 35 -- "35 pages"
#ASSERT `o 24A r 3(6) the written submissions are within the page limit` 35 FALSE EQUALS JUST TRUE -- exactly 35 pages
#ASSERT `o 24A r 3(6) the written submissions are within the page limit` 36 FALSE EQUALS JUST FALSE -- 36 pages, no leave
#ASSERT `o 24A r 3(6) the written submissions are within the page limit` 36 TRUE EQUALS JUST TRUE -- the Court of Appeal allows it
#ASSERT `o 24A r 3(7) the Court of Appeal may allow the page limit to be exceeded` TRUE EQUALS JUST TRUE -- special circumstances
#ASSERT `o 24A r 3(7) the Court of Appeal may allow the page limit to be exceeded` FALSE EQUALS NOTHING -- the grant is limited by its own wording
#ASSERT `o 24A r 3(8) the party serves its written submissions on every other party within the day on which they are filed` (Date 8 3 2027) (Date 8 3 2027) EQUALS JUST TRUE -- the day they are filed
#ASSERT `o 24A r 3(8) the party serves its written submissions on every other party within the day on which they are filed` (Date 8 3 2027) (Date 9 3 2027) EQUALS JUST FALSE -- the next day

-- ---------------------------------------------------------------------------
§ `Tests -- Rule 4`
-- ---------------------------------------------------------------------------

#ASSERT `o 24A r 4 the form of the notice of appointment` EQUALS "Form 3" -- "a notice of appointment in Form 3"
-- arguments: represented by counsel in the application; decides to appoint additional counsel
#ASSERT `o 24A r 4 the applicant must file and serve a notice of appointment` TRUE TRUE EQUALS JUST TRUE -- represented, and appoints additional counsel
#ASSERT `o 24A r 4 the applicant must file and serve a notice of appointment` TRUE FALSE EQUALS JUST FALSE -- "Where ... decides to appoint": no such decision
#ASSERT `o 24A r 4 the applicant must file and serve a notice of appointment` FALSE TRUE EQUALS JUST FALSE -- "Where an applicant ... who is represented": not represented
#ASSERT `o 24A r 4 the applicant must file and serve a notice of appointment` FALSE FALSE EQUALS JUST FALSE -- neither
-- arguments: the form the notice is in; names each additional counsel; filed and served
#ASSERT `o 24A r 4 the notice of appointment is filed and served as required` "Form 3" TRUE TRUE EQUALS JUST TRUE -- Form 3, naming each, filed and served
#ASSERT `o 24A r 4 the notice of appointment is filed and served as required` "Form 4" TRUE TRUE EQUALS NOTHING -- not Form 3: silent on what follows
#ASSERT `o 24A r 4 the notice of appointment is filed and served as required` "Form 3" FALSE TRUE EQUALS NOTHING -- does not name each additional counsel
#ASSERT `o 24A r 4 the notice of appointment is filed and served as required` "Form 3" TRUE FALSE EQUALS NOTHING -- not filed and served

-- ---------------------------------------------------------------------------
§ `Tests -- the duties as regulative rules (traces, not assertions)`
-- ---------------------------------------------------------------------------

-- A #TRACE prints its result and counts as no assertion on this binary; the decision functions that say the
-- same thing are asserted above.  The result each should print is written beside it, from the text.
-- expected: FULFILLED -- permission granted at day 0; the application is made on day 3 and the submissions on day 3 after that (O 24A r 3(1), 3(3)(b))
#TRACE `o 24A r 3(1) the applicant must make the PACC application within 3 days after permission is granted` AT 0 WITH
    PARTY `o 24A the applicant` DOES `o 24A r 3(1) make the PACC application to the Court of Appeal` AT 3
    PARTY `o 24A the applicant` DOES `o 24A r 3(3)(b) file written submissions in support of the PACC application` AT 5
-- expected: BREACH -- the application is made on day 4, one day late
#TRACE `o 24A r 3(1) the applicant must make the PACC application within 3 days after permission is granted` AT 0 WITH
    PARTY `o 24A the applicant` DOES `o 24A r 3(1) make the PACC application to the Court of Appeal` AT 4
-- expected: BREACH -- the application is made in time but the submissions come on day 7, after the three days that follow it
#TRACE `o 24A r 3(1) the applicant must make the PACC application within 3 days after permission is granted` AT 0 WITH
    PARTY `o 24A the applicant` DOES `o 24A r 3(1) make the PACC application to the Court of Appeal` AT 2
    PARTY `o 24A the applicant` DOES `o 24A r 3(3)(b) file written submissions in support of the PACC application` AT 7
-- expected: FULFILLED -- the respondent files on day 3 (O 24A r 2(10)(a))
#TRACE `o 24A r 2(10) the respondent may file written submissions within 3 days after the application is filed and served` AT 0 WITH
    PARTY `o 24A the respondent` DOES `o 24A r 2(10) file written submissions in response` AT 3
