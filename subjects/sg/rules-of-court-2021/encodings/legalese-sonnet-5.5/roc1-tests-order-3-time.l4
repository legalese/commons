IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc1-order-3-time`

-- TESTS for roc1-order-3-time.l4 (Order 3, Rules 3 and 4).  Every expected value is written beside its
-- assertion from the text of the Rule and from the calendar (checked by hand, below), never from the code.
--
-- THE CALENDAR.  November 2026: 1 Nov is a Sunday, so 5 Nov is a Thursday, 7 and 8 Nov are a weekend,
-- 14-15, 21-22, 28-29 Nov are weekends.  The fixture lists two made-up public holidays, Wednesday 11 Nov 2026 and
-- Monday 23 Nov 2026.  They are test fixtures and not statements that those days are holidays.

`o 3 r 3 test calendar` MEANS `Court calendar` WITH
    `public holidays` IS LIST Date 11 11 2026, Date 23 11 2026

`o 3 r 3 test calendar without holidays` MEANS `Court calendar` WITH
    `public holidays` IS EMPTY

`o 3 r 3 test 14 days after` MEANS Period WITH
    `period length` IS 14
    `period unit` IS Days
    `period direction` IS `After the anchor`

`o 3 r 3 test 5 days after` MEANS Period WITH
    `period length` IS 5
    `period unit` IS Days
    `period direction` IS `After the anchor`

`o 3 r 3 test 6 days after` MEANS Period WITH
    `period length` IS 6
    `period unit` IS Days
    `period direction` IS `After the anchor`

`o 3 r 3 test 7 days after` MEANS Period WITH
    `period length` IS 7
    `period unit` IS Days
    `period direction` IS `After the anchor`

`o 3 r 3 test 5 weeks after` MEANS Period WITH
    `period length` IS 5
    `period unit` IS Weeks
    `period direction` IS `After the anchor`

`o 3 r 3 test 3 months after` MEANS Period WITH
    `period length` IS 3
    `period unit` IS Months
    `period direction` IS `After the anchor`

`o 3 r 3 test 7 clear days after` MEANS Period WITH
    `period length` IS 7
    `period unit` IS `Clear days`
    `period direction` IS `After the anchor`

`o 3 r 3 test 3 clear days after` MEANS Period WITH
    `period length` IS 3
    `period unit` IS `Clear days`
    `period direction` IS `After the anchor`

`o 3 r 3 test 7 working days after` MEANS Period WITH
    `period length` IS 7
    `period unit` IS `Working days`
    `period direction` IS `After the anchor`

`o 3 r 3 test 14 days before` MEANS Period WITH
    `period length` IS 14
    `period unit` IS Days
    `period direction` IS `Before the anchor`

`o 3 r 3 test 10 days before` MEANS Period WITH
    `period length` IS 10
    `period unit` IS Days
    `period direction` IS `Before the anchor`

`o 3 r 3 test 5 days before` MEANS Period WITH
    `period length` IS 5
    `period unit` IS Days
    `period direction` IS `Before the anchor`

`o 3 r 3 test 7 clear days before` MEANS Period WITH
    `period length` IS 7
    `period unit` IS `Clear days`
    `period direction` IS `Before the anchor`

`o 3 r 3 test 48 hours after` MEANS Period WITH
    `period length` IS 48
    `period unit` IS Hours
    `period direction` IS `After the anchor`

-- ---------------------------------------------------------------------------
-- Rule 3(1)
-- ---------------------------------------------------------------------------
-- (1) "The Interpretation Act does not apply to the calculation of time in these Rules": flat negative, JUST FALSE.
#ASSERT `o 3 r 3(1) the Interpretation Act applies to the calculation of time in these Rules` TRUE EQUALS JUST FALSE
-- time that is not time in these Rules is outside the sentence: NOTHING (a scope limit).
#ASSERT `o 3 r 3(1) the Interpretation Act applies to the calculation of time in these Rules` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
-- Rule 3(2)
-- ---------------------------------------------------------------------------
-- (2) "month" means a calendar month unless the context otherwise requires.
#ASSERT `o 3 r 3(2) the word month is read as a calendar month` FALSE EQUALS JUST TRUE
#ASSERT `o 3 r 3(2) the word month is read as a calendar month` TRUE EQUALS JUST FALSE
-- 5 Nov plus 3 months lands on 5 Feb: the day exists, so the corresponding day is answered.
#ASSERT `o 3 r 3(2) a period of calendar months from a date ends on the corresponding day` (Date 5 11 2026) 3 EQUALS JUST TRUE
-- 31 Jan plus one month has no corresponding day in February: the Rules are silent.
#ASSERT `o 3 r 3(2) a period of calendar months from a date ends on the corresponding day` (Date 31 1 2027) 1 EQUALS NOTHING

-- ---------------------------------------------------------------------------
-- Rule 3(3): the period begins immediately after the date
-- ---------------------------------------------------------------------------
#ASSERT `o 3 r 3(3) the first day of a period after or from a date` (Date 5 11 2026) EQUALS Date 6 11 2026
#ASSERT `o 3 r 3(3) the first day of a period after or from a date` (Date 30 11 2026) EQUALS Date 1 12 2026
-- 14 days after Thursday 5 Nov 2026: the 14th day is Thursday 19 Nov (a court day).
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 14 days after` (Date 5 11 2026) `o 3 r 3 test calendar` EQUALS Date 19 11 2026
-- 7 days (more than 6, so weekends and the holiday are NOT left out): 12 Nov.
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 7 days after` (Date 5 11 2026) `o 3 r 3 test calendar` EQUALS Date 12 11 2026
-- Rule 3(7): 14 days after Sunday 8 Nov is Sunday 22 Nov (non-court); Monday 23 Nov is the fixture holiday; the next court day is Tue 24 Nov.
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 14 days after` (Date 8 11 2026) `o 3 r 3 test calendar` EQUALS Date 24 11 2026
-- the same expiry without the fixture holiday: Sunday 22 Nov moves to Monday 23 Nov.
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 14 days after` (Date 8 11 2026) `o 3 r 3 test calendar without holidays` EQUALS Date 23 11 2026

-- ---------------------------------------------------------------------------
-- Rule 3(6): a period of 6 days or less leaves out non-court days
-- ---------------------------------------------------------------------------
-- 5 days after Thu 5 Nov, leaving out Sat 7, Sun 8 and the holiday Wed 11: Fri 6 (1), Mon 9 (2), Tue 10 (3), Thu 12 (4), Fri 13 (5).
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 5 days after` (Date 5 11 2026) `o 3 r 3 test calendar` EQUALS Date 13 11 2026
-- the boundary: 6 days is still "6 days or less": Fri 6 (1), Mon 9 (2), Tue 10 (3), Thu 12 (4), Fri 13 (5), Mon 16 (6).
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 6 days after` (Date 5 11 2026) `o 3 r 3 test calendar` EQUALS Date 16 11 2026
-- the other side of the boundary: 7 days is not, so 5 Nov plus 7 is 12 Nov (asserted above).
-- the helper: Wed 11 Nov (fixture holiday), Sat 7 Nov, Thu 5 Nov
#ASSERT `o 3 r 3(6) the day is a non-court day to be left out` (Date 11 11 2026) `o 3 r 3 test calendar`
#ASSERT `o 3 r 3(6) the day is a non-court day to be left out` (Date 7 11 2026) `o 3 r 3 test calendar`
#ASSERT NOT (`o 3 r 3(6) the day is a non-court day to be left out` (Date 5 11 2026) `o 3 r 3 test calendar`)
-- stepping backwards: from Mon 30 Nov, 5 court days back (Fri 27, Thu 26, Wed 25, Tue 24, [Mon 23 holiday], Fri 20).
#ASSERT `o 3 r 3(6) the day reached by counting court days` (Date 30 11 2026) 5 FALSE `o 3 r 3 test calendar` EQUALS Date 20 11 2026
#ASSERT `o 3 r 3(6) the day reached by counting court days` (Date 30 11 2026) 0 FALSE `o 3 r 3 test calendar` EQUALS Date 30 11 2026

-- ---------------------------------------------------------------------------
-- Rule 3(7)
-- ---------------------------------------------------------------------------
-- a court day stays: Thu 5 Nov.  Saturday 7 Nov moves to Monday 9 Nov.  Wed 11 Nov (holiday) moves to Thu 12 Nov.
#ASSERT `o 3 r 3(7) the last day moved past non-court days` (Date 5 11 2026) `o 3 r 3 test calendar` EQUALS Date 5 11 2026
#ASSERT `o 3 r 3(7) the last day moved past non-court days` (Date 7 11 2026) `o 3 r 3 test calendar` EQUALS Date 9 11 2026
#ASSERT `o 3 r 3(7) the last day moved past non-court days` (Date 11 11 2026) `o 3 r 3 test calendar` EQUALS Date 12 11 2026
-- Friday 20 Nov to Saturday 21, Sunday 22, Monday 23 (holiday), Tuesday 24
#ASSERT `o 3 r 3(7) the last day moved past non-court days` (Date 21 11 2026) `o 3 r 3 test calendar` EQUALS Date 24 11 2026

-- ---------------------------------------------------------------------------
-- Weeks, months, working days, clear days
-- ---------------------------------------------------------------------------
-- 5 weeks after Thu 5 Nov is Thu 10 Dec.
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 5 weeks after` (Date 5 11 2026) `o 3 r 3 test calendar` EQUALS Date 10 12 2026
-- 3 calendar months after 5 Nov 2026 is Fri 5 Feb 2027.
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 3 months after` (Date 5 11 2026) `o 3 r 3 test calendar` EQUALS Date 5 2 2027
-- 7 working days after Thu 5 Nov: Fri 6 (1), Mon 9 (2), Tue 10 (3), Thu 12 (4) [Wed 11 holiday], Fri 13 (5), Mon 16 (6), Tue 17 (7).
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 7 working days after` (Date 5 11 2026) `o 3 r 3 test calendar` EQUALS Date 17 11 2026
-- Rule 3(5): 7 clear days after Thu 5 Nov: at least 7 days must intervene, so the earliest day is the 8th day after: Fri 13 Nov.
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 7 clear days after` (Date 5 11 2026) `o 3 r 3 test calendar` EQUALS Date 13 11 2026
#ASSERT `o 3 r 3 the first day on which the act may be done` `o 3 r 3 test 7 clear days after` (Date 5 11 2026) `o 3 r 3 test calendar` EQUALS Date 13 11 2026
-- 3 clear days (6 or less, non-court days left out; no holiday here): Fri 6 (1), Mon 9 (2), Tue 10 (3); the next day, Wed 11 Nov.
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 3 clear days after` (Date 5 11 2026) `o 3 r 3 test calendar without holidays` EQUALS Date 11 11 2026
-- a "within" period's first day is the day after the date (S-T1b).
#ASSERT `o 3 r 3 the first day on which the act may be done` `o 3 r 3 test 14 days after` (Date 5 11 2026) `o 3 r 3 test calendar` EQUALS Date 6 11 2026

-- ---------------------------------------------------------------------------
-- Rule 3(4): a period before a date
-- ---------------------------------------------------------------------------
-- the period ends immediately before the date
#ASSERT `o 3 r 3(4) the last day of a period before a date` (Date 30 11 2026) EQUALS Date 29 11 2026
-- not less than 14 days before Monday 30 Nov: Monday 16 Nov.
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 14 days before` (Date 30 11 2026) `o 3 r 3 test calendar` EQUALS Date 16 11 2026
-- 14 days before Monday 7 Dec is Monday 23 Nov, the fixture holiday: Rule 3(7) moves it to Tuesday 24 Nov (see the fork register).
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 14 days before` (Date 7 12 2026) `o 3 r 3 test calendar` EQUALS Date 24 11 2026
-- A deadline counted BACKWARDS, both sides of Rule 3(7) (fork F1).  10 days before Tuesday 17 Nov is Saturday 7 Nov, a non-court day;
-- read literally Rule 3(7) moves it LATER, to Monday 9 Nov, so the notice given is 8 days where the count said 10.
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 10 days before` (Date 17 11 2026) `o 3 r 3 test calendar` EQUALS Date 9 11 2026
-- the same Saturday deadline: an act done on the moved day Monday 9 Nov is in time (the literal reading), and one done on Tuesday 10 Nov is not.
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 10 days before` (Date 17 11 2026) (Date 9 11 2026) `o 3 r 3 test calendar` NOTHING EQUALS JUST TRUE
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 10 days before` (Date 17 11 2026) (Date 10 11 2026) `o 3 r 3 test calendar` NOTHING EQUALS JUST FALSE
-- 10 days before Monday 16 Nov is Friday 6 Nov, a court day: Rule 3(7) does not touch it, so the deadline stays at 6 Nov.
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 10 days before` (Date 16 11 2026) `o 3 r 3 test calendar` EQUALS Date 6 11 2026
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 10 days before` (Date 16 11 2026) (Date 6 11 2026) `o 3 r 3 test calendar` NOTHING EQUALS JUST TRUE
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 10 days before` (Date 16 11 2026) (Date 9 11 2026) `o 3 r 3 test calendar` NOTHING EQUALS JUST FALSE
-- 7 clear days before Monday 30 Nov: at least 7 days intervene, so Sunday 22 Nov at the latest (30 - 7 - 1).
#ASSERT `o 3 r 3 the last day for doing the act` `o 3 r 3 test 7 clear days before` (Date 30 11 2026) `o 3 r 3 test calendar` EQUALS Date 22 11 2026
-- the first day of a window "within 14 days before" Monday 30 Nov is Monday 16 Nov
#ASSERT `o 3 r 3(4) the first day of a window within a period before a date` `o 3 r 3 test 14 days before` (Date 30 11 2026) `o 3 r 3 test calendar` EQUALS Date 16 11 2026
-- "within 5 days before" Monday 30 Nov, leaving out non-court days (Rule 3(6)): Fri 20 Nov
#ASSERT `o 3 r 3(4) the first day of a window within a period before a date` `o 3 r 3 test 5 days before` (Date 30 11 2026) `o 3 r 3 test calendar` EQUALS Date 20 11 2026

-- ---------------------------------------------------------------------------
-- What Rule 3 can count; the act in time
-- ---------------------------------------------------------------------------
#ASSERT `o 3 r 3 the period can be counted under this Rule` `o 3 r 3 test 14 days after` EQUALS JUST TRUE
#ASSERT `o 3 r 3 the period can be counted under this Rule` `o 3 r 3 test 5 weeks after` EQUALS JUST TRUE
#ASSERT `o 3 r 3 the period can be counted under this Rule` `o 3 r 3 test 48 hours after` EQUALS NOTHING

-- 14 days after 5 Nov, last day Thu 19 Nov: done on 19 Nov is in time, done on 20 Nov is not (a stated period: JUST FALSE).
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 14 days after` (Date 5 11 2026) (Date 19 11 2026) `o 3 r 3 test calendar` NOTHING EQUALS JUST TRUE
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 14 days after` (Date 5 11 2026) (Date 20 11 2026) `o 3 r 3 test calendar` NOTHING EQUALS JUST FALSE
-- done well inside the period
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 14 days after` (Date 5 11 2026) (Date 6 11 2026) `o 3 r 3 test calendar` NOTHING EQUALS JUST TRUE
-- the Court has ordered the period to end on Thu 26 Nov: 26 Nov is in time, 27 Nov is not.
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 14 days after` (Date 5 11 2026) (Date 26 11 2026) `o 3 r 3 test calendar` (JUST (Date 26 11 2026)) EQUALS JUST TRUE
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 14 days after` (Date 5 11 2026) (Date 27 11 2026) `o 3 r 3 test calendar` (JUST (Date 26 11 2026)) EQUALS JUST FALSE
-- a period in hours is not counted by Rule 3: NOTHING
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 48 hours after` (Date 5 11 2026) (Date 6 11 2026) `o 3 r 3 test calendar` NOTHING EQUALS NOTHING

-- two acts: file and serve
#ASSERT `o 3 r 3 both of two acts are in time` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `o 3 r 3 both of two acts are in time` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `o 3 r 3 both of two acts are in time` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `o 3 r 3 both of two acts are in time` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `o 3 r 3 both of two acts are in time` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `o 3 r 3 both of two acts are in time` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `o 3 r 3 both of two acts are in time` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `o 3 r 3 both of two acts are in time` NOTHING NOTHING EQUALS NOTHING

-- ---------------------------------------------------------------------------
-- Rule 4
-- ---------------------------------------------------------------------------
-- (1) the Court may extend or shorten a period within which a person is required to do an act
#ASSERT `o 3 r 4(1) the Court may extend or shorten the period` TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 4(1) the Court may extend or shorten the period` FALSE EQUALS NOTHING
-- (2) "Unless these Rules otherwise provide": where they do, JUST FALSE; otherwise before or after expiry both TRUE
#ASSERT `o 3 r 4(2) the Court may extend the period whether the application is made before or after it expires` FALSE FALSE EQUALS JUST TRUE
#ASSERT `o 3 r 4(2) the Court may extend the period whether the application is made before or after it expires` FALSE TRUE EQUALS JUST TRUE
#ASSERT `o 3 r 4(2) the Court may extend the period whether the application is made before or after it expires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `o 3 r 4(2) the Court may extend the period whether the application is made before or after it expires` TRUE TRUE EQUALS JUST FALSE
-- (3) once, in writing, at most 14 days: 14 is the boundary
#ASSERT `o 3 r 4(3) the period may be extended by consent in writing without an order of the Court` TRUE TRUE 14 FALSE EQUALS JUST TRUE
#ASSERT `o 3 r 4(3) the period may be extended by consent in writing without an order of the Court` TRUE TRUE 15 FALSE EQUALS NOTHING
#ASSERT `o 3 r 4(3) the period may be extended by consent in writing without an order of the Court` TRUE TRUE 1 FALSE EQUALS JUST TRUE
#ASSERT `o 3 r 4(3) the period may be extended by consent in writing without an order of the Court` TRUE TRUE 14 TRUE EQUALS NOTHING
#ASSERT `o 3 r 4(3) the period may be extended by consent in writing without an order of the Court` TRUE FALSE 14 FALSE EQUALS NOTHING
#ASSERT `o 3 r 4(3) the period may be extended by consent in writing without an order of the Court` FALSE TRUE 14 FALSE EQUALS NOTHING
-- S-T2: the Court's order wins; a consent extension adds its days; neither is NOTHING
#ASSERT `o 3 r 4 the last day as extended or shortened` (Date 19 11 2026) (JUST (Date 26 11 2026)) NOTHING FALSE EQUALS JUST (Date 26 11 2026)
#ASSERT `o 3 r 4 the last day as extended or shortened` (Date 19 11 2026) (JUST (Date 16 11 2026)) NOTHING FALSE EQUALS JUST (Date 16 11 2026)
#ASSERT `o 3 r 4 the last day as extended or shortened` (Date 19 11 2026) NOTHING (JUST 14) FALSE EQUALS JUST (Date 3 12 2026)
#ASSERT `o 3 r 4 the last day as extended or shortened` (Date 19 11 2026) NOTHING (JUST 15) FALSE EQUALS NOTHING
#ASSERT `o 3 r 4 the last day as extended or shortened` (Date 19 11 2026) NOTHING (JUST 7) TRUE EQUALS NOTHING
#ASSERT `o 3 r 4 the last day as extended or shortened` (Date 19 11 2026) NOTHING NOTHING FALSE EQUALS NOTHING
-- the act in time under a consent extension of 14 days: 3 Dec 2026 is in time, 4 Dec is not
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 14 days after` (Date 5 11 2026) (Date 3 12 2026) `o 3 r 3 test calendar` (JUST (Date 3 12 2026)) EQUALS JUST TRUE
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 14 days after` (Date 5 11 2026) (Date 4 12 2026) `o 3 r 3 test calendar` (JUST (Date 3 12 2026)) EQUALS JUST FALSE

-- A number of clear days AFTER a date is a minimum gap (Rule 3(5)): an act before the earliest day is outside what the text allows, so JUST FALSE (ruling of 2026-11-05 (a)); on or after the earliest day the gap is met, so JUST TRUE (fork F2).
-- 7 clear days after Thursday 5 Nov: the earliest day is Friday 13 Nov.
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 7 clear days after` (Date 5 11 2026) (Date 13 11 2026) `o 3 r 3 test calendar` NOTHING EQUALS JUST TRUE
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 7 clear days after` (Date 5 11 2026) (Date 12 11 2026) `o 3 r 3 test calendar` NOTHING EQUALS JUST FALSE
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 7 clear days after` (Date 5 11 2026) (Date 5 11 2026) `o 3 r 3 test calendar` NOTHING EQUALS JUST FALSE
#ASSERT `o 3 r 3 the act is in time` `o 3 r 3 test 7 clear days after` (Date 5 11 2026) (Date 30 11 2026) `o 3 r 3 test calendar` NOTHING EQUALS JUST TRUE
