IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc12-order-70`

-- Rules of Court 2021 (Singapore) -- tests for Order 70 (roc12-order-70.l4).
-- Every expected value is written from the text of the Rule (lines 7719 to 7744 of the source file) before the run.
-- The last day of each 14-day period is an input from Order 3, Rule 3 (here 24 March 2025).

-- A period an order giving permission might specify instead of the 14 days: 30 days.
`o 70 r 5 a period of 30 days specified by the order` MEANS Period WITH
    `period length` IS 30
    `period unit` IS Days
    `period direction` IS `After the anchor`

§ `O 70 r 1`
#ASSERT `o 70 r 1 the enactment is the Act` TRUE EQUALS JUST TRUE -- ""Act" means the Supreme Court of Judicature Act 1969"
#ASSERT `o 70 r 1 the enactment is the Act` FALSE EQUALS JUST FALSE -- "means"
-- Arguments: by a person against whom an order is in force; for permission under s 74(1); to institute or continue.
#ASSERT `o 70 r 1 the application is an application for permission` TRUE TRUE TRUE EQUALS JUST TRUE -- all three limbs
#ASSERT `o 70 r 1 the application is an application for permission` FALSE TRUE TRUE EQUALS JUST FALSE -- "means": not by such a person
#ASSERT `o 70 r 1 the application is an application for permission` TRUE FALSE TRUE EQUALS JUST FALSE -- "means": not for permission under section 74(1)
#ASSERT `o 70 r 1 the application is an application for permission` TRUE TRUE FALSE EQUALS JUST FALSE -- "means": not to institute or continue

§ `O 70 r 2`
#ASSERT `o 70 r 2 the application is heard in open court as the Rule requires` TRUE TRUE EQUALS JUST TRUE -- heard in open court
#ASSERT `o 70 r 2 the application is heard in open court as the Rule requires` TRUE FALSE EQUALS NOTHING -- QB: not heard in open court
#ASSERT `o 70 r 2 the application is heard in open court as the Rule requires` FALSE TRUE EQUALS NOTHING -- an application outside the Rule

§ `O 70 r 3`
#ASSERT `o 70 r 3(1) the form of the order under section 74(1)` EQUALS "102" -- "must be in Form 102"
#ASSERT `o 70 r 3(1) the order is in the form the Rule requires` TRUE "102" EQUALS JUST TRUE -- Form 102
#ASSERT `o 70 r 3(1) the order is in the form the Rule requires` TRUE "101" EQUALS NOTHING -- QB: another form
#ASSERT `o 70 r 3(1) the order is in the form the Rule requires` FALSE "102" EQUALS NOTHING -- not an order under section 74(1)
-- r 3(2).  Arguments: an order under s 74(1); extracted by the applicant; served on all other parties.
#ASSERT `o 70 r 3(2) the order is extracted and served as the Rule requires` TRUE TRUE TRUE EQUALS JUST TRUE -- extracted and served
#ASSERT `o 70 r 3(2) the order is extracted and served as the Rule requires` TRUE FALSE TRUE EQUALS NOTHING -- QB: not extracted
#ASSERT `o 70 r 3(2) the order is extracted and served as the Rule requires` TRUE TRUE FALSE EQUALS NOTHING -- QB: not served
#ASSERT `o 70 r 3(2) the order is extracted and served as the Rule requires` FALSE TRUE TRUE EQUALS NOTHING -- not an order under section 74(1)

§ `O 70 r 4`
-- r 4(1).  Arguments: an order in force against the person; the application is by that person for permission.
#ASSERT `o 70 r 4(1) the duty to serve the application and affidavit arises` TRUE TRUE EQUALS JUST TRUE -- "Where an order under section 74(1) is in force against a person"
#ASSERT `o 70 r 4(1) the duty to serve the application and affidavit arises` FALSE TRUE EQUALS JUST FALSE -- no order in force
#ASSERT `o 70 r 4(1) the duty to serve the application and affidavit arises` TRUE FALSE EQUALS JUST FALSE -- not that person's application for permission
-- Arguments: the answer above; served on the Attorney-General; served on every other party.
#ASSERT `o 70 r 4(1) the application and affidavit are served as the Rule requires` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE -- (a) and (b)
#ASSERT `o 70 r 4(1) the application and affidavit are served as the Rule requires` (JUST TRUE) TRUE FALSE EQUALS NOTHING -- QB: (b) not done
#ASSERT `o 70 r 4(1) the application and affidavit are served as the Rule requires` (JUST TRUE) FALSE TRUE EQUALS NOTHING -- QB: (a) not done
#ASSERT `o 70 r 4(1) the application and affidavit are served as the Rule requires` (JUST FALSE) TRUE TRUE EQUALS NOTHING -- QD: the duty does not arise
#ASSERT `o 70 r 4(1) the application and affidavit are served as the Rule requires` NOTHING TRUE TRUE EQUALS NOTHING -- whether the duty arises is not answered
-- r 4(2).  Arguments: served with an application for permission; the date to file and serve; the last day.
#ASSERT `o 70 r 4(2) the person may file and serve the affidavit in reply` TRUE (Date 24 3 2025) (Date 24 3 2025) EQUALS JUST TRUE -- on the last day
#ASSERT `o 70 r 4(2) the person may file and serve the affidavit in reply` TRUE (Date 25 3 2025) (Date 24 3 2025) EQUALS JUST FALSE -- after the last day: "within 14 days"
#ASSERT `o 70 r 4(2) the person may file and serve the affidavit in reply` FALSE (Date 20 3 2025) (Date 24 3 2025) EQUALS NOTHING -- a person not served
#ASSERT `o 70 r 4(2) the period for the affidavit in reply`'s `period length` EQUALS 14 -- "within 14 days after the date on which the application is served"
#ASSERT `o 70 r 4(2) the period for the affidavit in reply`'s `period unit` EQUALS Days -- days
-- r 4(3).
#ASSERT `o 70 r 4(3) the Court may give other directions for service and affidavits` TRUE EQUALS JUST TRUE -- an application for permission
#ASSERT `o 70 r 4(3) the Court may give other directions for service and affidavits` FALSE EQUALS NOTHING -- other applications are outside

§ `O 70 r 5`
#ASSERT (`o 70 r 5 the period for filing and serving` NOTHING)'s `period length` EQUALS 14 -- "within 14 days after the date of the order giving such permission"
#ASSERT (`o 70 r 5 the period for filing and serving` NOTHING)'s `period unit` EQUALS Days -- days
#ASSERT (`o 70 r 5 the period for filing and serving` NOTHING)'s `period direction` EQUALS `After the anchor` -- after the date of the order
#ASSERT (`o 70 r 5 the period for filing and serving` (JUST `o 70 r 5 a period of 30 days specified by the order`))'s `period length` EQUALS 30 -- "or such other period as that order may specify"
-- Arguments: given permission; the date the order and process were filed and served; the last day.
#ASSERT `o 70 r 5 the order and the process are filed and served within the period` TRUE (JUST (Date 24 3 2025)) (Date 24 3 2025) EQUALS JUST TRUE -- on the last day
#ASSERT `o 70 r 5 the order and the process are filed and served within the period` TRUE (JUST (Date 25 3 2025)) (Date 24 3 2025) EQUALS JUST FALSE -- after the last day
#ASSERT `o 70 r 5 the order and the process are filed and served within the period` TRUE NOTHING (Date 24 3 2025) EQUALS NOTHING -- not yet filed and served: the period may still be running
#ASSERT `o 70 r 5 the order and the process are filed and served within the period` FALSE (JUST (Date 20 3 2025)) (Date 24 3 2025) EQUALS NOTHING -- a person not given permission

§ `O 70 r 6`
-- Arguments: an order in force; institutes or continues proceedings; without the General Division's permission.
#ASSERT `o 70 r 6 this Rule applies` TRUE TRUE TRUE EQUALS JUST TRUE -- all three
#ASSERT `o 70 r 6 this Rule applies` TRUE TRUE FALSE EQUALS JUST FALSE -- with permission: the "Where" is not met
#ASSERT `o 70 r 6 this Rule applies` TRUE FALSE TRUE EQUALS JUST FALSE -- no proceedings instituted or continued
#ASSERT `o 70 r 6 this Rule applies` FALSE TRUE TRUE EQUALS JUST FALSE -- no order in force
#ASSERT `o 70 r 6(a) the person may apply for those legal proceedings to be struck out` (JUST TRUE) TRUE EQUALS JUST TRUE -- any other party
#ASSERT `o 70 r 6(a) the person may apply for those legal proceedings to be struck out` (JUST TRUE) FALSE EQUALS NOTHING -- a stranger
#ASSERT `o 70 r 6(a) the person may apply for those legal proceedings to be struck out` (JUST FALSE) TRUE EQUALS JUST FALSE -- the Rule does not apply
#ASSERT `o 70 r 6(a) the person may apply for those legal proceedings to be struck out` NOTHING TRUE EQUALS NOTHING -- whether it applies is not answered
#ASSERT `o 70 r 6(b) the Court may strike out those legal proceedings` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE -- on an application under (a)
#ASSERT `o 70 r 6(b) the Court may strike out those legal proceedings` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE -- on the Court's own motion
#ASSERT `o 70 r 6(b) the Court may strike out those legal proceedings` (JUST TRUE) FALSE FALSE EQUALS NOTHING -- neither
#ASSERT `o 70 r 6(b) the Court may strike out those legal proceedings` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE -- the Rule does not apply
#ASSERT `o 70 r 6(b) the Court may strike out those legal proceedings` NOTHING TRUE TRUE EQUALS NOTHING -- whether the Rule applies is not answered

§ `O 70 -- the duties as regulative rules`
-- expected: FULFILLED
#TRACE `o 70 r 3(2) the duty to extract and serve the order` AT 0 WITH
    PARTY `o 70 the person that applies for the order` DOES `o 70 extract the order and serve it on all other parties` AT 2
-- expected: FULFILLED
#TRACE `o 70 r 4(1) the duty to serve the application for permission` AT 0 WITH
    PARTY `o 70 the person against whom the order is in force` DOES `o 70 serve the application and affidavit on the Attorney-General and every other party` AT 1
-- expected: FULFILLED (day 10)
#TRACE `o 70 r 5 the duty to file and serve the order and the process` AT 0 WITH
    PARTY `o 70 the person given permission` DOES `o 70 file the order and the process and serve them` AT 10
-- expected: BREACH (day 15)
#TRACE `o 70 r 5 the duty to file and serve the order and the process` AT 0 WITH
    PARTY `o 70 the person given permission` DOES `o 70 file the order and the process and serve them` AT 15
