#ASSERT `o 30 r 4(1) the Tribunal consists of the Chief Justice and the other Judges` FALSE TRUE EQUALS NOTHING -- O 30 r 4(1): condition 1 missing
#ASSERT `o 30 r 4(1) the Tribunal consists of the Chief Justice and the other Judges` TRUE FALSE EQUALS NOTHING -- O 30 r 4(1): condition 2 missing
