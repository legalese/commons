IMPORT prelude
IMPORT daydate
IMPORT `roc-core`
IMPORT `roc-definitions`
IMPORT `roc7-order-30`

-- Rules of Court 2021 (Singapore): TESTS for roc7-order-30.
-- Expected values are written from the text of the rule named after each assertion (the comment on its line),
-- never copied from what the code printed.  The gate-shaped rules (a MAYBE BOOLEAN over BOOLEAN conditions) are tested
-- by the kind of the rule: every condition met; then each condition missing in turn.


-- Hand-written tests for Orders 30 and 31 (the gate-shaped rules and the 7-day period are tested by the generated assertions).

#ASSERT `o 30 r 9 the Tribunal is bound by the strict rules of evidence` TRUE EQUALS JUST FALSE -- "the Tribunal is not bound by the strict rules of evidence"
#ASSERT `o 30 r 9 the Tribunal is bound by the strict rules of evidence` FALSE EQUALS NOTHING -- a proceeding that is not on a Reference: silent
#ASSERT `o 30 r 10 the requirement to hold the proceeding in open court applies` FALSE EQUALS JUST TRUE -- not the hearing for directions
#ASSERT `o 30 r 10 the requirement to hold the proceeding in open court applies` TRUE EQUALS JUST FALSE -- "except for the hearing for directions"
#ASSERT `o 30 r 12 the directions may include` `o 30 r 12(a) the dates by which counsel must file their respective Cases in the manner required by Division 3 of Order 19` EQUALS JUST TRUE -- (a)
#ASSERT `o 30 r 12 the directions may include` `o 30 r 12(b) the dates, time and venue for the hearing of the Reference` EQUALS JUST TRUE -- (b)
#ASSERT `o 30 r 12 the directions may include` `o 30 r 12(c) the manner and time in which final submissions are to be made` EQUALS JUST TRUE -- (c)
#ASSERT `o 30 r 12 the directions may include` `o 30 r 12 any other direction` EQUALS NOTHING -- "include", the list is not closed
#ASSERT `o 30 r 14 a party may be ordered to pay costs` TRUE EQUALS JUST FALSE -- "No party ... may be ordered to pay any costs"
#ASSERT `o 30 r 14 a party may be ordered to pay costs` FALSE EQUALS NOTHING -- proceedings outside this Order
#ASSERT `o 30 r 15 a fee is payable in respect of the proceedings` TRUE EQUALS JUST FALSE -- "No fees are payable"
#ASSERT `o 30 r 15 a fee is payable in respect of the proceedings` FALSE EQUALS NOTHING -- proceedings outside this Order
#ASSERT `o 31 r 4(2) an order for costs incurred in the General Division may be made` TRUE EQUALS JUST FALSE -- "no order for costs incurred in the General Division is to be made"
#ASSERT `o 31 r 4(2) an order for costs incurred in the General Division may be made` FALSE EQUALS NOTHING -- not the State Court's costs orders in these proceedings


-- Gate and period assertions follow, written from the kind of each rule (every condition met; then each condition missing in turn).
#ASSERT `o 30 r 1(1) this Order applies to the Reference` TRUE TRUE TRUE EQUALS JUST TRUE -- O 30 r 1(1): every condition met
#ASSERT `o 30 r 1(1) this Order applies to the Reference` FALSE TRUE TRUE EQUALS NOTHING -- O 30 r 1(1): condition 1 missing
#ASSERT `o 30 r 1(1) this Order applies to the Reference` TRUE FALSE TRUE EQUALS NOTHING -- O 30 r 1(1): condition 2 missing
#ASSERT `o 30 r 1(1) this Order applies to the Reference` TRUE TRUE FALSE EQUALS NOTHING -- O 30 r 1(1): condition 3 missing
#ASSERT `o 30 r 1(2) a reference is a Reference` TRUE TRUE EQUALS JUST TRUE -- O 30 r 1(2) “Reference”: every condition met
#ASSERT `o 30 r 1(2) a reference is a Reference` FALSE TRUE EQUALS JUST FALSE -- O 30 r 1(2) “Reference”: condition 1 missing
#ASSERT `o 30 r 1(2) a reference is a Reference` TRUE FALSE EQUALS JUST FALSE -- O 30 r 1(2) “Reference”: condition 2 missing
#ASSERT `o 30 r 1(2) a tribunal is the Tribunal` TRUE TRUE EQUALS JUST TRUE -- O 30 r 1(2) “Tribunal”: every condition met
#ASSERT `o 30 r 1(2) a tribunal is the Tribunal` FALSE TRUE EQUALS JUST FALSE -- O 30 r 1(2) “Tribunal”: condition 1 missing
#ASSERT `o 30 r 1(2) a tribunal is the Tribunal` TRUE FALSE EQUALS JUST FALSE -- O 30 r 1(2) “Tribunal”: condition 2 missing
