#ASSERT `o 30 r 2(1) the Reference is brought by filing it in Form 47` TRUE FALSE EQUALS NOTHING -- O 30 r 2(1): condition 2 missing
#ASSERT `o 30 r 2(2) the Reference is made under the hand of the President of Singapore` TRUE EQUALS JUST TRUE -- O 30 r 2(2): every condition met
#ASSERT `o 30 r 2(2) the Reference is made under the hand of the President of Singapore` FALSE EQUALS NOTHING -- O 30 r 2(2): condition 1 missing
#ASSERT `o 30 r 2(3) the Registrar causes a copy of the Reference to be served on the Attorney-General` TRUE EQUALS JUST TRUE -- O 30 r 2(3): every condition met
#ASSERT `o 30 r 2(3) the Registrar causes a copy of the Reference to be served on the Attorney-General` FALSE EQUALS NOTHING -- O 30 r 2(3): condition 1 missing
#ASSERT `o 30 r 3(1) the Reference states the questions in a form which can be answered yes or no` TRUE EQUALS JUST TRUE -- O 30 r 3(1): every condition met
#ASSERT `o 30 r 3(1) the Reference states the questions in a form which can be answered yes or no` FALSE EQUALS NOTHING -- O 30 r 3(1): condition 1 missing
#ASSERT `o 30 r 3(2) the Reference is divided into paragraphs and states what is necessary` TRUE TRUE TRUE EQUALS JUST TRUE -- O 30 r 3(2): every condition met
#ASSERT `o 30 r 3(2) the Reference is divided into paragraphs and states what is necessary` FALSE TRUE TRUE EQUALS NOTHING -- O 30 r 3(2): condition 1 missing
#ASSERT `o 30 r 3(2) the Reference is divided into paragraphs and states what is necessary` TRUE FALSE TRUE EQUALS NOTHING -- O 30 r 3(2): condition 2 missing
#ASSERT `o 30 r 3(2) the Reference is divided into paragraphs and states what is necessary` TRUE TRUE FALSE EQUALS NOTHING -- O 30 r 3(2): condition 3 missing
