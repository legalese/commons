#ASSERT `o 30 r 4(2) the Tribunal consists of Judges appointed by the Chief Justice` FALSE TRUE EQUALS NOTHING -- O 30 r 4(2): condition 1 missing
#ASSERT `o 30 r 4(2) the Tribunal consists of Judges appointed by the Chief Justice` TRUE FALSE EQUALS NOTHING -- O 30 r 4(2): condition 2 missing
