IMPORT prelude
IMPORT `rbda-father-particulars`

-- Registration of Births and Deaths Act 2021, ss 2(1), 2(2), 8, 9, 15, 16, 38, 40(3), 61(2)(a) -- worked cases for the
-- father's particulars where the parents are not married (REQ-0272).
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked against
-- a decided case, the regulations or the Registrar-General's website (none was retrieved). Expected results were written
-- by hand from the text.

§ `REQ-0272 -- Jun Hao registers his daughter's birth (event j051, 22 January 2033)`

-- The facts: parents not married to each other; ordinary conception (the ART Act does not apply); Jun Hao, the father,
-- wants his name and particulars in the register.
-- What the Act says: nothing -- the father's entry is left to regulations and the Registrar-General's website.
#ASSERT `what the Act says about the parents' particulars` FALSE FALSE FALSE FALSE FALSE EQUALS `the Act does not say: left to regulations and the Registrar-General's website`
-- The expected "joint request of both parents" is not a rule of this Act.
#ASSERT NOT `the Act requires a joint request of both parents` FALSE
-- On whose request: anyone may give the particulars (s 9(1)); the father is himself a responsible person (s 8(5)(a),
-- INFERENCE that "parent" includes him).
#ASSERT `may give the birth particulars` `the father`
#ASSERT `is a responsible person` `the father` FALSE FALSE

§ `the parents' marriage makes no difference to what the Act says`

#ASSERT `what the Act says about the parents' particulars` TRUE FALSE FALSE FALSE FALSE EQUALS `the Act does not say: left to regulations and the Registrar-General's website`
#ASSERT NOT `the Act requires a joint request of both parents` TRUE

§ `s 16 -- the assisted-reproduction cases, the only place the Act rules on the parents' particulars`

#ASSERT `what the Act says about the parents' particulars` FALSE TRUE TRUE FALSE FALSE EQUALS `as a court order under the ART Act directs`
-- A court order wins even if the Registrar-General has heard of a dispute.
#ASSERT `what the Act says about the parents' particulars` FALSE TRUE TRUE FALSE TRUE EQUALS `as a court order under the ART Act directs`
#ASSERT `what the Act says about the parents' particulars` FALSE TRUE FALSE TRUE FALSE EQUALS `as the ART Act directs`
#ASSERT `what the Act says about the parents' particulars` FALSE TRUE FALSE TRUE TRUE EQUALS `the Registrar-General may register without either or both parents' particulars`
#ASSERT `what the Act says about the parents' particulars` FALSE TRUE FALSE FALSE FALSE EQUALS `the Registrar-General may register without either or both parents' particulars`
#ASSERT `what the Act says about the parents' particulars` TRUE TRUE FALSE TRUE FALSE EQUALS `as the ART Act directs`

§ `s 2(1), 2(2), 61(2)(a) -- where a birth particular can come from`

#ASSERT `can make something a birth particular` `this Act`
#ASSERT `can make something a birth particular` `regulations under section 61`
#ASSERT `can make something a birth particular` `the Registrar-General's prescribed website`
#ASSERT NOT `can make something a birth particular` `somewhere else`

§ `s 8(5) -- responsible persons`

#ASSERT `is a responsible person` `the mother` FALSE FALSE
#ASSERT NOT `is a responsible person` `a legal guardian` FALSE FALSE
#ASSERT `is a responsible person` `a legal guardian` TRUE FALSE
#ASSERT NOT `is a responsible person` `a CYPA protector with naming power` FALSE FALSE
#ASSERT `is a responsible person` `a CYPA protector with naming power` FALSE TRUE
#ASSERT NOT `is a responsible person` `any other person` TRUE TRUE

§ `s 9(1) -- anyone may give the particulars`

#ASSERT `may give the birth particulars` `the mother`
#ASSERT `may give the birth particulars` `any other person`

§ `s 8(1), (3) -- the 42-day duty`

#ASSERT `still owes the birth particulars` `the father` FALSE FALSE 10 FALSE
-- The mother's giving them discharges the father.
#ASSERT NOT `still owes the birth particulars` `the father` FALSE FALSE 10 TRUE
#ASSERT `still owes the birth particulars` `the father` FALSE FALSE 42 FALSE
#ASSERT NOT `still owes the birth particulars` `the father` FALSE FALSE 43 FALSE
#ASSERT NOT `still owes the birth particulars` `any other person` FALSE FALSE 10 FALSE

§ `ss 8(1A)(b), 9(2) -- registering with a particular missing`

#ASSERT `may register with incomplete particulars` TRUE TRUE
#ASSERT NOT `may register with incomplete particulars` FALSE TRUE
#ASSERT NOT `may register with incomplete particulars` TRUE FALSE
#ASSERT `the duty to give the missing particular continues` TRUE FALSE
#ASSERT NOT `the duty to give the missing particular continues` TRUE TRUE
#ASSERT NOT `the duty to give the missing particular continues` FALSE FALSE

§ `ss 38, 40(3) -- adding or correcting later`

#ASSERT `counts as an alteration` TRUE
#ASSERT NOT `adding or changing the record is lawful` TRUE FALSE
#ASSERT `adding or changing the record is lawful` TRUE TRUE
#ASSERT `may correct an error of fact in the births register` TRUE TRUE FALSE
#ASSERT NOT `may correct an error of fact in the births register` TRUE FALSE FALSE
#ASSERT `may correct an error of fact in the births register` FALSE FALSE TRUE

§ `s 15 -- the parents later marry`

#ASSERT `section 15 applies` TRUE TRUE
#ASSERT NOT `section 15 applies` TRUE FALSE
-- Jun Hao alone may apply while his daughter is a minor; no joint application is needed.
#ASSERT `may apply for re-registration on legitimation` `a parent` TRUE FALSE
#ASSERT NOT `may apply for re-registration on legitimation` `the subject person` TRUE TRUE
#ASSERT `may apply for re-registration on legitimation` `the subject person` FALSE FALSE
#ASSERT NOT `may apply for re-registration on legitimation` `a parent` FALSE FALSE
#ASSERT `may apply for re-registration on legitimation` `a parent` FALSE TRUE
#ASSERT NOT `may apply for re-registration on legitimation` `someone else` TRUE TRUE
-- Re-registration with a surname change to the father's: allowed if the change only reflects paternity and the name passes s 19.
#ASSERT `may re-register on legitimation` TRUE TRUE TRUE TRUE TRUE FALSE
#ASSERT NOT `may re-register on legitimation` TRUE TRUE TRUE FALSE TRUE FALSE
#ASSERT NOT `may re-register on legitimation` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT `may re-register on legitimation` TRUE TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT `may re-register on legitimation` TRUE FALSE FALSE FALSE FALSE FALSE
