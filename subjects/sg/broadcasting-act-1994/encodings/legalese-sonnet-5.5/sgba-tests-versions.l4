§ `The items of each version, and the equipment they reach`

-- equipment, described by what a witness could say about it
`equipment used for visual and aural reception` MEANS
    `Receiving equipment` WITH `capable of the reception of a broadcasting service` IS TRUE
                              , `designed or constructed for the reception of a broadcasting service` IS TRUE
                              , `used for the aural reception of a broadcasting service` IS TRUE
                              , `used for the visual and aural reception of a broadcasting service in monochrome or colour` IS TRUE
                              , `capable of direct reception of a broadcasting service from a satellite` IS FALSE

`equipment used for aural reception only` MEANS
    `Receiving equipment` WITH `capable of the reception of a broadcasting service` IS TRUE
                              , `designed or constructed for the reception of a broadcasting service` IS TRUE
                              , `used for the aural reception of a broadcasting service` IS TRUE
                              , `used for the visual and aural reception of a broadcasting service in monochrome or colour` IS FALSE
                              , `capable of direct reception of a broadcasting service from a satellite` IS FALSE

`equipment capable of direct reception from a satellite` MEANS
    `Receiving equipment` WITH `capable of the reception of a broadcasting service` IS TRUE
                              , `designed or constructed for the reception of a broadcasting service` IS TRUE
                              , `used for the aural reception of a broadcasting service` IS FALSE
                              , `used for the visual and aural reception of a broadcasting service in monochrome or colour` IS FALSE
                              , `capable of direct reception of a broadcasting service from a satellite` IS TRUE

`equipment that cannot receive a broadcasting service` MEANS
    `Receiving equipment` WITH `capable of the reception of a broadcasting service` IS FALSE
                              , `designed or constructed for the reception of a broadcasting service` IS FALSE
                              , `used for the aural reception of a broadcasting service` IS FALSE
                              , `used for the visual and aural reception of a broadcasting service in monochrome or colour` IS FALSE
                              , `capable of direct reception of a broadcasting service from a satellite` IS FALSE

-- items listed in each version
#ASSERT `the equipment is an item of the First Schedule version` `the First Schedule in the Revised Edition 2003` `equipment used for visual and aural reception`
#ASSERT `the equipment is an item of the First Schedule version` `the First Schedule in the Revised Edition 2003` `equipment used for aural reception only`
#ASSERT `the equipment is an item of the First Schedule version` `the First Schedule in the Revised Edition 2003` `equipment capable of direct reception from a satellite`
#ASSERT NOT (`the equipment is an item of the First Schedule version` `the First Schedule in the Revised Edition 2003` `equipment that cannot receive a broadcasting service`)
#ASSERT `the equipment is an item of the First Schedule version` `the First Schedule in the Revised Edition 2012` `equipment used for visual and aural reception`
#ASSERT `the equipment is an item of the First Schedule version` `the First Schedule in the Revised Edition 2012` `equipment used for aural reception only`
#ASSERT `the equipment is an item of the First Schedule version` `the First Schedule in the Revised Edition 2012` `equipment capable of direct reception from a satellite`
#ASSERT NOT (`the equipment is an item of the First Schedule version` `the First Schedule as substituted by S 549/2012` `equipment used for visual and aural reception`)
#ASSERT NOT (`the equipment is an item of the First Schedule version` `the First Schedule as substituted by S 549/2012` `equipment used for aural reception only`)
#ASSERT `the equipment is an item of the First Schedule version` `the First Schedule as substituted by S 549/2012` `equipment capable of direct reception from a satellite`
#ASSERT NOT (`the equipment is an item of the First Schedule version` `the First Schedule in the consolidation in force from 25 September 2024` `equipment used for visual and aural reception`)
#ASSERT NOT (`the equipment is an item of the First Schedule version` `the First Schedule in the consolidation in force from 25 September 2024` `equipment used for aural reception only`)
#ASSERT `the equipment is an item of the First Schedule version` `the First Schedule in the consolidation in force from 25 September 2024` `equipment capable of direct reception from a satellite`

-- the dates of the table's rows, as the Gazette prints them
#ASSERT `the First Schedule as substituted by S 549/2012`'s `takes effect on` EQUALS (Date 1 1 2011)
#ASSERT `the First Schedule as substituted by S 549/2012`'s `published on` EQUALS (Date 31 10 2012)
#ASSERT `the First Schedule in the Revised Edition 2003`'s `published on` EQUALS (Date 31 7 2003)
#ASSERT `the First Schedule in the Revised Edition 2012`'s `published on` EQUALS (Date 31 8 2012)
#ASSERT `the Third Schedule as substituted by S 559/2010`'s `takes effect on` EQUALS (Date 1 10 2010)
#ASSERT `the Third Schedule as substituted by S 559/2010`'s `published on` EQUALS (Date 30 9 2010)

