#ASSERT `s 8(2) the licence is in the form, for the period and on the terms the Authority determined` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 8(2) the licence is in the form, for the period and on the terms the Authority determined` TRUE TRUE EQUALS NOTHING
#ASSERT `s 8(3) the licensee must pay the fee` TRUE
#ASSERT NOT (`s 8(3) the licensee must pay the fee` FALSE)
#ASSERT `s 8(4) the condition may be attached to a free-to-air licence granted under section 8` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 8(4) the condition may be attached to a free-to-air licence granted under section 8` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 8(4) the condition may be attached to a free-to-air licence granted under section 8` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 8(4) the condition may be attached to a free-to-air licence granted under section 8` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 8(4) the condition may be attached to a free-to-air licence granted under section 8` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 8(4) the condition may be attached to a free-to-air licence granted under section 8` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 8(4) the condition may be attached to a free-to-air licence granted under section 8` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 8(4) the condition may be attached to a free-to-air licence granted under section 8` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 8(4) the condition may be attached to a free-to-air licence granted under section 8` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 8(5) the licensee must pay the late payment charge` TRUE
#ASSERT `s 8(6) the amount is deemed always to have been validly collected, and no legal proceedings lie on account of the collection` TRUE EQUALS JUST TRUE
#ASSERT `s 8(6) the amount is deemed always to have been validly collected, and no legal proceedings lie on account of the collection` FALSE EQUALS NOTHING

§ `s 9: class licences`

#ASSERT `s 9(1) the class licence has been determined` TRUE TRUE
#ASSERT NOT (`s 9(1) the class licence has been determined` TRUE FALSE)
#ASSERT NOT (`s 9(1) the class licence has been determined` FALSE TRUE)
#ASSERT `s 9(2) the Authority may include the condition in a class licence` TRUE
#ASSERT `s 9(3) different conditions may be specified` TRUE
#ASSERT `s 9(4) the Authority may impose the condition on a class licence` TRUE
#ASSERT NOT (`s 9(4) the Authority may impose the condition on a class licence` FALSE)

§ `ss 10 to 12: modification, class licence conditions, suspension or cancellation`

#ASSERT `s 10(1) the Authority may modify the conditions of the licence under section 10` FALSE
#ASSERT NOT (`s 10(1) the Authority may modify the conditions of the licence under section 10` TRUE)
#ASSERT `s 10(2) the notice is a notice the Authority must give before modifying` FALSE TRUE TRUE TRUE 28
#ASSERT `s 10(2) the notice is a notice the Authority must give before modifying` TRUE TRUE FALSE TRUE 28
#ASSERT NOT (`s 10(2) the notice is a notice the Authority must give before modifying` FALSE TRUE FALSE TRUE 28)
#ASSERT NOT (`s 10(2) the notice is a notice the Authority must give before modifying` FALSE TRUE TRUE TRUE 27)
#ASSERT NOT (`s 10(2) the notice is a notice the Authority must give before modifying` FALSE TRUE TRUE FALSE 28)
#ASSERT NOT (`s 10(2) the notice is a notice the Authority must give before modifying` FALSE FALSE TRUE TRUE 28)
#ASSERT `s 10(3) the Authority must issue a direction in writing giving effect to the proposed modification, or the modification as amended` TRUE EQUALS JUST TRUE
#ASSERT `s 10(3) the Authority must issue a direction in writing giving effect to the proposed modification, or the modification as amended` FALSE EQUALS NOTHING
#ASSERT `s 10(4) the licensee may still appeal to the Minister, whose decision is final` 14
#ASSERT NOT (`s 10(4) the licensee may still appeal to the Minister, whose decision is final` 15)
#ASSERT `s 10(5) the Authority must not enforce the direction` TRUE FALSE
#ASSERT `s 10(5) the Authority must not enforce the direction` FALSE TRUE
#ASSERT NOT (`s 10(5) the Authority must not enforce the direction` FALSE FALSE)
#ASSERT `s 10(6) the Authority may immediately carry out the modification specified in the notice` TRUE
#ASSERT NOT (`s 10(6) the Authority may immediately carry out the modification specified in the notice` FALSE)
#ASSERT `s 11 the class licence conditions are as modified or added to` TRUE
#ASSERT `s 12(1) the Authority may by written notice and without compensation cancel or suspend the licence, or require a fine of an amount it thinks fit, or both` TRUE FALSE FALSE FALSE
#ASSERT `s 12(1) the Authority may by written notice and without compensation cancel or suspend the licence, or require a fine of an amount it thinks fit, or both` FALSE TRUE FALSE FALSE
#ASSERT `s 12(1) the Authority may by written notice and without compensation cancel or suspend the licence, or require a fine of an amount it thinks fit, or both` FALSE FALSE TRUE FALSE
#ASSERT `s 12(1) the Authority may by written notice and without compensation cancel or suspend the licence, or require a fine of an amount it thinks fit, or both` FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 12(1) the Authority may by written notice and without compensation cancel or suspend the licence, or require a fine of an amount it thinks fit, or both` FALSE FALSE FALSE FALSE)
#ASSERT `s 12(2) the aggrieved person may still appeal to the Minister, whose decision is final` 14
#ASSERT NOT (`s 12(2) the aggrieved person may still appeal to the Minister, whose decision is final` 15)
#ASSERT `s 12(3) Code of Practice includes this code` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 12(3) Code of Practice includes this code` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 12(3) Code of Practice includes this code` FALSE FALSE EQUALS NOTHING

§ `ss 13 to 19: duties of broadcasting licensees`

#ASSERT `s 13(1) the licensee does what the subsection requires` TRUE
#ASSERT NOT (`s 13(1) the licensee does what the subsection requires` FALSE)
#ASSERT `s 13(2) the licensee has not allowed a service to be transmitted otherwise than as the subsection requires` TRUE TRUE
#ASSERT NOT (`s 13(2) the licensee has not allowed a service to be transmitted otherwise than as the subsection requires` TRUE FALSE)
#ASSERT NOT (`s 13(2) the licensee has not allowed a service to be transmitted otherwise than as the subsection requires` FALSE TRUE)
#ASSERT `s 14(1) the free-to-air licensee does what the subsection requires` TRUE
#ASSERT NOT (`s 14(1) the free-to-air licensee does what the subsection requires` FALSE)
#ASSERT `s 14(2) the free-to-air broadcasting service is broadcast for at least the hours specified` 18 18
#ASSERT `s 14(2) the free-to-air broadcasting service is broadcast for at least the hours specified` 19 18
#ASSERT NOT (`s 14(2) the free-to-air broadcasting service is broadcast for at least the hours specified` 17 18)
#ASSERT `s 15(1) the licensee has supplied the material the Authority demanded` TRUE
#ASSERT `s 15(2) the licensee required to supply material has complied` TRUE FALSE
#ASSERT `s 15(2) the licensee required to supply material has complied` FALSE TRUE
#ASSERT NOT (`s 15(2) the licensee required to supply material has complied` FALSE FALSE)
#ASSERT `s 15(3) the Authority may require the licensee to pre-record the programme and submit it for approval before it is broadcast` TRUE
#ASSERT NOT (`s 15(3) the Authority may require the licensee to pre-record the programme and submit it for approval before it is broadcast` FALSE)
#ASSERT `s 16(1) the Authority may direct in writing that the licensee take the action with regard to programme or advertisement contents or broadcast standards` TRUE
#ASSERT `s 16(2) the direction is one the subsection allows to be included` TRUE EQUALS JUST TRUE
#ASSERT `s 16(2) the direction is one the subsection allows to be included` FALSE EQUALS NOTHING
#ASSERT `s 16(3) the person is guilty of an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 16(3) the person is guilty of an offence` FALSE EQUALS NOTHING
#ASSERT `s 16(3) the punishment`'s `fine not exceeding` EQUALS 20000
#ASSERT `s 16(3) the punishment`'s `imprisonment` EQUALS `imprisonment not exceeding` 24
#ASSERT `s 17 the licensee must include the programme within the services it is required to broadcast` TRUE TRUE
#ASSERT NOT (`s 17 the licensee must include the programme within the services it is required to broadcast` TRUE FALSE)
#ASSERT `s 17 the programme is of a kind the section lists` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 17 the programme is of a kind the section lists` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 17 the programme is of a kind the section lists` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 17 the programme is of a kind the section lists` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 17 the programme is of a kind the section lists` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 18(1) the programme required under section 17 or by a licence condition is broadcast as the subsection requires` TRUE FALSE
#ASSERT `s 18(1) the programme required under section 17 or by a licence condition is broadcast as the subsection requires` FALSE TRUE
#ASSERT NOT (`s 18(1) the programme required under section 17 or by a licence condition is broadcast as the subsection requires` FALSE FALSE)
#ASSERT `s 18(2) the licensee has done what the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 18(2) the licensee has done what the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 18(2) the licensee has done what the subsection requires` FALSE TRUE EQUALS NOTHING
#ASSERT `s 19(1) the Authority may by a direction in writing require the licensee to provide the service for transmission and reception` TRUE TRUE
#ASSERT NOT (`s 19(1) the Authority may by a direction in writing require the licensee to provide the service for transmission and reception` TRUE FALSE)
#ASSERT `s 19(2) the licensee must comply with the direction` TRUE
#ASSERT `s 19(3) the notice is the notice the Authority must give before proposing the direction` TRUE 28
#ASSERT NOT (`s 19(3) the notice is the notice the Authority must give before proposing the direction` TRUE 27)
#ASSERT NOT (`s 19(3) the notice is the notice the Authority must give before proposing the direction` FALSE 28)
#ASSERT `s 19(4) the Authority must issue a direction in writing giving effect to the proposed direction, or as amended` TRUE EQUALS JUST TRUE
#ASSERT `s 19(4) the Authority must issue a direction in writing giving effect to the proposed direction, or as amended` FALSE EQUALS NOTHING
#ASSERT `s 19(5) the licensee may still appeal to the Minister, whose decision is final` 14
#ASSERT NOT (`s 19(5) the licensee may still appeal to the Minister, whose decision is final` 15)
#ASSERT `s 19(6) the Authority must not enforce the direction` TRUE FALSE
#ASSERT `s 19(6) the Authority must not enforce the direction` FALSE TRUE
#ASSERT NOT (`s 19(6) the Authority must not enforce the direction` FALSE FALSE)
#ASSERT `s 19(7) the Authority may immediately give effect to the requirements of the direction` TRUE
