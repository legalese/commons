IMPORT prelude
IMPORT daydate
IMPORT `sgba-nouns`
IMPORT `sgba-vintage`
IMPORT `sgba-sched`
IMPORT `sgba-p1-defs`
IMPORT `sgba-p4-services`

-- Tests for sgba-p4-services.l4 (ss 5 to 19). Expected values are written from the text of each section. s 8(1) is dated and tested both sides of its window.

§ `Part 3: ss 5 to 7`

#ASSERT `s 5(1) the Authority may grant a licence of this kind by this subsection` `a broadcasting licence granted under section 8`
#ASSERT `s 5(1) the Authority may grant a licence of this kind by this subsection` `a broadcasting apparatus licence granted under section 20`
#ASSERT NOT (`s 5(1) the Authority may grant a licence of this kind by this subsection` `a class licence determined under section 9`)
#ASSERT `s 5(2) the Authority may grant a licence in this category` TRUE
#ASSERT NOT (`s 5(2) the Authority may grant a licence in this category` FALSE)
#ASSERT `s 6(1) the Authority may issue this Code of Practice` TRUE FALSE
#ASSERT `s 6(1) the Authority may issue this Code of Practice` FALSE TRUE
#ASSERT NOT (`s 6(1) the Authority may issue this Code of Practice` FALSE FALSE)
#ASSERT `s 6(2) the provision of the Code has effect subject to the regulations, to the extent of the inconsistency` TRUE EQUALS JUST TRUE
#ASSERT `s 6(2) the provision of the Code has effect subject to the regulations, to the extent of the inconsistency` FALSE EQUALS NOTHING
#ASSERT `s 6(3) the licensee is exempt from the provision of the Code of Practice` TRUE
#ASSERT NOT (`s 6(3) the licensee is exempt from the provision of the Code of Practice` FALSE)
#ASSERT `s 7(1) the licence may be transferred to another person` TRUE
#ASSERT NOT (`s 7(1) the licence may be transferred to another person` FALSE)
#ASSERT `s 7(2) the purported transfer is void and of no effect, read literally` TRUE EQUALS JUST TRUE
#ASSERT `s 7(2) the purported transfer is void and of no effect, read literally` FALSE EQUALS NOTHING
#ASSERT `s 7(2) the purported transfer is void, on the reading that only a transfer without consent is` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 7(2) the purported transfer is void, on the reading that only a transfer without consent is` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 7(2) the purported transfer is void, on the reading that only a transfer without consent is` FALSE FALSE EQUALS NOTHING

§ `s 8: licensing of broadcasting services (dated)`

-- the person provides a licensable service in or from Singapore with no licence and no class licence
#ASSERT `s 8(1) the person provides a licensable broadcasting service without the licence the subsection requires, on` (Date 1 6 2025) (JUST `subscription nationwide television services`) FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- each route out: a section 8 licence; a class licence under section 9; not provided in or from Singapore; the service is or was an online communication service
#ASSERT `s 8(1) the person provides a licensable broadcasting service without the licence the subsection requires, on` (Date 1 6 2025) (JUST `subscription nationwide television services`) FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 8(1) the person provides a licensable broadcasting service without the licence the subsection requires, on` (Date 1 6 2025) (JUST `audiotext services`) FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 8(1) the person provides a licensable broadcasting service without the licence the subsection requires, on` (Date 1 6 2025) (JUST `subscription nationwide television services`) FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 8(1) the person provides a licensable broadcasting service without the licence the subsection requires, on` (Date 1 6 2025) (JUST `subscription nationwide television services`) TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- a service not on the Second Schedule is not licensable
#ASSERT `s 8(1) the person provides a licensable broadcasting service without the licence the subsection requires, on` (Date 1 6 2025) NOTHING FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- dates
#ASSERT `s 8(1) the person provides a licensable broadcasting service without the licence the subsection requires, on` (Date 25 9 2024) (JUST `teletext services`) FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 8(1) the person provides a licensable broadcasting service without the licence the subsection requires, on` (Date 24 9 2024) (JUST `teletext services`) FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 8(1) the person provides a licensable broadcasting service without the licence the subsection requires, on` (Date 5 11 2026) (JUST `teletext services`) FALSE TRUE FALSE FALSE EQUALS NOTHING
