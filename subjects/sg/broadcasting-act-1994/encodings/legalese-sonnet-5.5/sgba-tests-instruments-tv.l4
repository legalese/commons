IMPORT prelude
IMPORT daydate
IMPORT `sgba-nouns`
IMPORT `sgba-vintage`
IMPORT `sgba-i-tvro-regs`
IMPORT `sgba-i-composition`

-- Tests for sgba-i-tvro-regs.l4 (Broadcasting (TVRO System) Regulations) and sgba-i-composition.l4 (Broadcasting (Composition of Offences) Regulations).
-- Expected values are written from the text of each regulation, and both sides of the dates of each window.

§ `TVRO System Regulations: window 29 February 2004 to 4 November 2026`

#ASSERT `the TVRO System Regulations as deposited are the text in force on` (Date 29 2 2004)
#ASSERT NOT (`the TVRO System Regulations as deposited are the text in force on` (Date 28 2 2004))
#ASSERT `the TVRO System Regulations as deposited are the text in force on` (Date 1 10 2026)
#ASSERT NOT (`the TVRO System Regulations as deposited are the text in force on` (Date 5 11 2026))

§ `reg 2: definitions`

#ASSERT `reg 2 the apparatus is a broadcast television receiver` TRUE
#ASSERT NOT (`reg 2 the apparatus is a broadcast television receiver` FALSE)
#ASSERT `reg 2 the person is an institution` TRUE FALSE
#ASSERT `reg 2 the person is an institution` FALSE TRUE
#ASSERT NOT (`reg 2 the person is an institution` FALSE FALSE)
#ASSERT `reg 2 the licence is a licence within these Regulations` TRUE
#ASSERT `reg 2 the person is a licensee` TRUE
#ASSERT `reg 2 the thing is telecommunications` TRUE
#ASSERT `reg 2 the apparatus is a TVRO system` (Apparatus WITH `capable of reception of a broadcasting service` IS TRUE, `capable of direct reception from a satellite` IS TRUE)
#ASSERT NOT (`reg 2 the apparatus is a TVRO system` (Apparatus WITH `capable of reception of a broadcasting service` IS TRUE, `capable of direct reception from a satellite` IS FALSE))

§ `reg 3: application and qualifications`

#ASSERT `reg 3(1) the application for a licence is as the regulation requires` TRUE TRUE
#ASSERT NOT (`reg 3(1) the application for a licence is as the regulation requires` TRUE FALSE)
#ASSERT NOT (`reg 3(1) the application for a licence is as the regulation requires` FALSE TRUE)
#ASSERT `reg 3(2) the person may be granted a licence, on` (Date 1 6 2015) TRUE EQUALS JUST TRUE
#ASSERT `reg 3(2) the person may be granted a licence, on` (Date 1 6 2015) FALSE EQUALS JUST FALSE
#ASSERT `reg 3(2) the person may be granted a licence, on` (Date 29 2 2004) TRUE EQUALS JUST TRUE
#ASSERT `reg 3(2) the person may be granted a licence, on` (Date 28 2 2004) TRUE EQUALS NOTHING
#ASSERT `reg 3(2) the person may be granted a licence, on` (Date 1 10 2026) FALSE EQUALS JUST FALSE
#ASSERT `reg 3(2) the person may be granted a licence, on` (Date 5 11 2026) FALSE EQUALS NOTHING
#ASSERT `reg 3(2) the person may be granted a licence, on` (Date 1 1 2011) TRUE EQUALS JUST TRUE

§ `regs 4 to 14`

#ASSERT `reg 4(1) the Authority may not refuse to grant or renew the licence for want of the fee` TRUE
#ASSERT NOT (`reg 4(1) the Authority may not refuse to grant or renew the licence for want of the fee` FALSE)
#ASSERT `reg 4(2) any fee or part of a fee paid is refundable for the unexpired period` TRUE EQUALS JUST FALSE
#ASSERT `reg 4(2) any fee or part of a fee paid is refundable for the unexpired period` FALSE EQUALS NOTHING
#ASSERT `reg 5 the licence is valid` TRUE FALSE
#ASSERT NOT (`reg 5 the licence is valid` FALSE FALSE)
#ASSERT NOT (`reg 5 the licence is valid` TRUE TRUE)
#ASSERT `reg 6(1) the Authority may issue a duplicate licence on payment of the fee` TRUE 2
#ASSERT NOT (`reg 6(1) the Authority may issue a duplicate licence on payment of the fee` TRUE 1)
#ASSERT NOT (`reg 6(1) the Authority may issue a duplicate licence on payment of the fee` FALSE 2)
#ASSERT `reg 6(2) a duplicate licence may be issued` FALSE FALSE
#ASSERT `reg 6(2) a duplicate licence may be issued` TRUE TRUE
#ASSERT NOT (`reg 6(2) a duplicate licence may be issued` TRUE FALSE)
#ASSERT `reg 7 the licensee has breached the regulation` TRUE
#ASSERT NOT (`reg 7 the licensee has breached the regulation` FALSE)
#ASSERT `reg 8 the licensee has complied` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 8 the licensee has complied` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 8 the licensee has complied` FALSE FALSE EQUALS NOTHING
#ASSERT `reg 9 the person must surrender the licence within the time the Authority specifies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 9 the person must surrender the licence within the time the Authority specifies` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 9 the person must surrender the licence within the time the Authority specifies` FALSE TRUE EQUALS NOTHING
#ASSERT `reg 10 the licensee has furnished what the regulation requires in time` 14 TRUE TRUE TRUE
#ASSERT NOT (`reg 10 the licensee has furnished what the regulation requires in time` 15 TRUE TRUE TRUE)
#ASSERT NOT (`reg 10 the licensee has furnished what the regulation requires in time` 14 FALSE TRUE TRUE)
#ASSERT NOT (`reg 10 the licensee has furnished what the regulation requires in time` 14 TRUE FALSE TRUE)
#ASSERT NOT (`reg 10 the licensee has furnished what the regulation requires in time` 14 TRUE TRUE FALSE)
#ASSERT `reg 11(1) the operation is prohibited` TRUE
#ASSERT NOT (`reg 11(1) the operation is prohibited` FALSE)
#ASSERT `reg 11(2) the operation is prohibited` TRUE
#ASSERT `reg 11(3) the interception is prohibited` TRUE
#ASSERT NOT (`reg 11(3) the interception is prohibited` FALSE)
#ASSERT `reg 12 the licensee has done what the regulation requires` TRUE
#ASSERT `reg 13(1) the licensee has breached the regulation` TRUE FALSE
#ASSERT NOT (`reg 13(1) the licensee has breached the regulation` TRUE TRUE)
#ASSERT NOT (`reg 13(1) the licensee has breached the regulation` FALSE FALSE)
#ASSERT `reg 13(2) the licensee has complied` TRUE TRUE EQUALS JUST TRUE
#ASSERT `reg 13(2) the licensee has complied` TRUE FALSE EQUALS JUST FALSE
#ASSERT `reg 13(2) the licensee has complied` FALSE TRUE EQUALS NOTHING
#ASSERT `reg 14 the licensee has breached the regulation` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `reg 14 the licensee has breached the regulation` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `reg 14 the licensee has breached the regulation` FALSE TRUE FALSE EQUALS NOTHING

§ `Composition of Offences Regulations: window 2 July 2007 to 4 November 2026; reg 2`

#ASSERT `the Composition of Offences Regulations as deposited are the text in force on` (Date 2 7 2007)
#ASSERT NOT (`the Composition of Offences Regulations as deposited are the text in force on` (Date 1 7 2007))
#ASSERT `reg 2 the offence may be compounded by the Authority in accordance with section 57(1), on` (Date 1 6 2015) 47 EQUALS JUST TRUE
#ASSERT `reg 2 the offence may be compounded by the Authority in accordance with section 57(1), on` (Date 1 6 2015) 46 EQUALS JUST FALSE
#ASSERT `reg 2 the offence may be compounded by the Authority in accordance with section 57(1), on` (Date 1 6 2015) 48 EQUALS JUST FALSE
#ASSERT `reg 2 the offence may be compounded by the Authority in accordance with section 57(1), on` (Date 2 7 2007) 47 EQUALS JUST TRUE
#ASSERT `reg 2 the offence may be compounded by the Authority in accordance with section 57(1), on` (Date 1 7 2007) 47 EQUALS NOTHING
#ASSERT `reg 2 the offence may be compounded by the Authority in accordance with section 57(1), on` (Date 5 11 2026) 47 EQUALS NOTHING
