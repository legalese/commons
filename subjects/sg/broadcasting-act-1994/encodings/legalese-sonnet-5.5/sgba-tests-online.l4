IMPORT prelude
IMPORT daydate
IMPORT `sgba-nouns`
IMPORT `sgba-vintage`
IMPORT `sgba-p1-online`

-- Tests for sgba-p1-online.l4 (ss 2A to 2D and the Fourth Schedule). Expected values are written from the text of each provision.

§ `2A: online communication service, electronic service, excluded electronic service`

#ASSERT `s 2A(1) the service, or the part of it, is an online communication service` TRUE
#ASSERT NOT (`s 2A(1) the service, or the part of it, is an online communication service` FALSE)
#ASSERT `s 2A(2)(a) the service is of the kind the paragraph describes` TRUE FALSE
#ASSERT `s 2A(2)(a) the service is of the kind the paragraph describes` FALSE TRUE
#ASSERT NOT (`s 2A(2)(a) the service is of the kind the paragraph describes` FALSE FALSE)
#ASSERT `s 2A(2)(b) the service is between points as the paragraph requires` TRUE FALSE
#ASSERT `s 2A(2)(b) the service is between points as the paragraph requires` FALSE TRUE
#ASSERT NOT (`s 2A(2)(b) the service is between points as the paragraph requires` FALSE FALSE)
#ASSERT `s 2A(2)(c) the service is not an excluded electronic service` FALSE
#ASSERT NOT (`s 2A(2)(c) the service is not an excluded electronic service` TRUE)
#ASSERT `s 2A(2) the service is an electronic service` TRUE TRUE TRUE
#ASSERT NOT (`s 2A(2) the service is an electronic service` TRUE TRUE FALSE)
#ASSERT NOT (`s 2A(2) the service is an electronic service` TRUE FALSE TRUE)
#ASSERT NOT (`s 2A(2) the service is an electronic service` FALSE TRUE TRUE)
#ASSERT `s 2A(3) the service is an excluded electronic service` TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 2A(3) the service is an excluded electronic service` FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 2A(3) the service is an excluded electronic service` FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 2A(3) the service is an excluded electronic service` FALSE FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `s 2A(3) the service is an excluded electronic service` FALSE FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `s 2A(3) the service is an excluded electronic service` FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `s 2A(3) the service is an excluded electronic service` FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 2A(3) the service is an excluded electronic service` FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 2A(4) the place the service is provided from stops it being an online communication service` TRUE)
#ASSERT NOT (`s 2A(4) the place the service is provided from stops it being an online communication service` FALSE)
#ASSERT `s 2A(5) the feature is a functionality of the electronic service` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2A(5) the feature is a functionality of the electronic service` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2A(5) the feature is a functionality of the electronic service` FALSE FALSE EQUALS NOTHING
#ASSERT `s 2A(5) the electronic service is an MMS` TRUE
#ASSERT `s 2A(5) the message is an MMS message` TRUE
#ASSERT `s 2A(5) the content is one-to-one live aural communications` TRUE FALSE FALSE
#ASSERT NOT (`s 2A(5) the content is one-to-one live aural communications` TRUE TRUE FALSE)
#ASSERT NOT (`s 2A(5) the content is one-to-one live aural communications` TRUE FALSE TRUE)
#ASSERT NOT (`s 2A(5) the content is one-to-one live aural communications` FALSE FALSE FALSE)
#ASSERT `s 2A(5) the electronic service is a point-to-multipoint service` TRUE
#ASSERT NOT (`s 2A(5) the electronic service is a point-to-multipoint service` FALSE)
#ASSERT `s 2A(5) the electronic service is an SMS` TRUE
#ASSERT `s 2A(5) the message is an SMS message` TRUE
#ASSERT `s 2A(5) the content is user-generated content` TRUE FALSE TRUE
#ASSERT `s 2A(5) the content is user-generated content` FALSE TRUE TRUE
#ASSERT NOT (`s 2A(5) the content is user-generated content` TRUE FALSE FALSE)
#ASSERT NOT (`s 2A(5) the content is user-generated content` FALSE FALSE TRUE)

§ `2B and 2C`

#ASSERT `s 2B(1) the Fourth Schedule has been changed by order` TRUE
#ASSERT NOT (`s 2B(1) the Fourth Schedule has been changed by order` FALSE)
#ASSERT `s 2B(2) the order has been presented to Parliament as the subsection requires` TRUE
#ASSERT `s 2C(1)(a) this Act still applies to the service as a licensable broadcasting service` TRUE EQUALS JUST FALSE
#ASSERT `s 2C(1)(a) this Act still applies to the service as a licensable broadcasting service` FALSE EQUALS NOTHING
#ASSERT `s 2C(1)(a)(ii) this Act still applies to the provider as a broadcasting licensee` TRUE EQUALS JUST FALSE
#ASSERT `s 2C(1)(a)(ii) this Act still applies to the provider as a broadcasting licensee` FALSE EQUALS NOTHING
#ASSERT `s 2C(1)(b) this Act continues to apply to the service as an online communication service` TRUE EQUALS JUST TRUE
#ASSERT `s 2C(1)(b) this Act continues to apply to the service as an online communication service` FALSE EQUALS NOTHING
#ASSERT `s 2C(1)(b)(ii) this Act continues to apply to the former licensee as a provider of an online communication service` TRUE EQUALS JUST TRUE
#ASSERT `s 2C(1)(b)(ii) this Act continues to apply to the former licensee as a provider of an online communication service` FALSE EQUALS NOTHING
#ASSERT `s 2C(1)(c)-(f) the conversion affects it` TRUE EQUALS JUST FALSE
#ASSERT `s 2C(1)(c)-(f) the conversion affects it` FALSE EQUALS NOTHING
#ASSERT `s 2C(2) the proceeding or appeal may be continued under sections 12 and 59 as if the Fourth Schedule had not been enacted` TRUE EQUALS JUST TRUE
#ASSERT `s 2C(2) the proceeding or appeal may be continued under sections 12 and 59 as if the Fourth Schedule had not been enacted` FALSE EQUALS NOTHING

§ `2D: provider`

#ASSERT `s 2D(1) the entity is the provider of the online communication service` TRUE FALSE FALSE
#ASSERT `s 2D(1) the entity is the provider of the online communication service` FALSE TRUE FALSE
#ASSERT `s 2D(1) the entity is the provider of the online communication service` FALSE FALSE TRUE
#ASSERT NOT (`s 2D(1) the entity is the provider of the online communication service` FALSE FALSE FALSE)
#ASSERT `s 2D(2) the entity, and that entity alone, is treated as the provider` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2D(2) the entity, and that entity alone, is treated as the provider` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2D(2) the entity, and that entity alone, is treated as the provider` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2D(3) the individual or individuals who control the machine are treated as the provider` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2D(3) the individual or individuals who control the machine are treated as the provider` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2D(3) the individual or individuals who control the machine are treated as the provider` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 2D(4) the individual or individuals are treated as the provider` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2D(4) the individual or individuals are treated as the provider` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2D(4) the individual or individuals are treated as the provider` FALSE TRUE EQUALS NOTHING
#ASSERT `s 2D(5) the person is treated as having control over who can use the online communication service` TRUE EQUALS JUST FALSE
#ASSERT `s 2D(5) the person is treated as having control over who can use the online communication service` FALSE EQUALS NOTHING
#ASSERT `s 2D(6) the regulations' choice decides who is treated as the provider` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2D(6) the regulations' choice decides who is treated as the provider` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2D(6) the regulations' choice decides who is treated as the provider` FALSE TRUE EQUALS NOTHING

§ `Fourth Schedule`

#ASSERT `Fourth Schedule Part 1 the electronic service has a specified characteristic` TRUE FALSE
#ASSERT `Fourth Schedule Part 1 the electronic service has a specified characteristic` FALSE TRUE
#ASSERT NOT (`Fourth Schedule Part 1 the electronic service has a specified characteristic` FALSE FALSE)
#ASSERT `Fourth Schedule Part 2 the thing is an app` TRUE FALSE
#ASSERT `Fourth Schedule Part 2 the thing is an app` FALSE TRUE
#ASSERT NOT (`Fourth Schedule Part 2 the thing is an app` FALSE FALSE)
#ASSERT `Fourth Schedule Part 2 the service is an app distribution service` TRUE TRUE TRUE
#ASSERT NOT (`Fourth Schedule Part 2 the service is an app distribution service` TRUE TRUE FALSE)
#ASSERT NOT (`Fourth Schedule Part 2 the service is an app distribution service` TRUE FALSE TRUE)
#ASSERT NOT (`Fourth Schedule Part 2 the service is an app distribution service` FALSE TRUE TRUE)
