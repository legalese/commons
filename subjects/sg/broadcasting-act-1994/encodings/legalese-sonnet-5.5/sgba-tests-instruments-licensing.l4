-- Tests for the licensing and exemption instruments: the Class Licence Notification (N 1), the Digital Display Panels class licence (S 477/2020),
-- the Exemption Orders (O 1, O 2, O 3, S 121/2008, S 211/2022, S 523/2010), the Service of Documents Website Notification (S 30/2023) and the
-- Online Codes of Practice Procedure Rules (S 47/2023). Expected values are written from each instrument's text; each dated rule is tested both sides of its window.

§ `N 1: Class Licence Notification (window 22 June 2020 to 4 November 2026)`

#ASSERT `N 1 para 2 the person is an Internet Content Provider` TRUE FALSE
#ASSERT `N 1 para 2 the person is an Internet Content Provider` FALSE TRUE
#ASSERT NOT (`N 1 para 2 the person is an Internet Content Provider` FALSE FALSE)
#ASSERT `N 1 para 2 the person is an Internet Service Provider` TRUE FALSE FALSE
#ASSERT `N 1 para 2 the person is an Internet Service Provider` FALSE TRUE FALSE
#ASSERT `N 1 para 2 the person is an Internet Service Provider` FALSE FALSE TRUE
#ASSERT NOT (`N 1 para 2 the person is an Internet Service Provider` FALSE FALSE FALSE)
#ASSERT `N 1 para 2 the person is a Localised Internet Service Reseller` TRUE TRUE TRUE FALSE
#ASSERT NOT (`N 1 para 2 the person is a Localised Internet Service Reseller` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`N 1 para 2 the person is a Localised Internet Service Reseller` TRUE TRUE FALSE FALSE)
#ASSERT `N 1 para 2 the person is a Non-localised Internet Service Reseller` TRUE TRUE FALSE
#ASSERT NOT (`N 1 para 2 the person is a Non-localised Internet Service Reseller` TRUE TRUE TRUE)
#ASSERT `N 1 para 2 the service is a VAN computer on-line service` TRUE
#ASSERT NOT (`N 1 para 2 the service is a VAN computer on-line service` FALSE)
-- para 3: each listed service, inside the window
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 6 2025) (JUST `audiotext services`) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 6 2025) (JUST `videotext services`) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 6 2025) (JUST `teletext services`) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 6 2025) (JUST `broadcast data services`) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 6 2025) (JUST `computer online services`) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 6 2025) (JUST `computer online services`) FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 6 2025) (JUST `computer online services`) FALSE FALSE FALSE EQUALS JUST FALSE
-- para 3 exception: a computer on-line service once the date in a para 3A notice has been reached
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 6 2025) (JUST `computer online services`) TRUE FALSE TRUE EQUALS JUST FALSE
-- services not listed in para 3
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 6 2025) (JUST `free-to-air nationwide television services`) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 6 2025) (JUST `subscription nationwide television services`) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 6 2025) (JUST `video-on-demand services`) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 6 2025) NOTHING FALSE FALSE FALSE EQUALS JUST FALSE
-- window edges
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 22 6 2020) (JUST `audiotext services`) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 21 6 2020) (JUST `audiotext services`) FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 1 10 2026) (JUST `audiotext services`) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `N 1 para 3 the provision of the service is subject to the class licence, on` (Date 5 11 2026) (JUST `audiotext services`) FALSE FALSE FALSE EQUALS NOTHING
-- para 3A
#ASSERT `N 1 para 3A(1) a notice may be given by the Authority to the provider` TRUE TRUE
#ASSERT NOT (`N 1 para 3A(1) a notice may be given by the Authority to the provider` TRUE FALSE)
#ASSERT NOT (`N 1 para 3A(1) a notice may be given by the Authority to the provider` FALSE TRUE)
#ASSERT `N 1 para 3A(1) the notice has ceased to have effect by reason only of that` TRUE TRUE EQUALS JUST FALSE
#ASSERT `N 1 para 3A(1) the notice has ceased to have effect by reason only of that` FALSE TRUE EQUALS NOTHING
#ASSERT `N 1 para 3A(2)(a) all sub-domains are regarded as part of the domain of the web site` TRUE EQUALS JUST TRUE
#ASSERT `N 1 para 3A(2)(a) all sub-domains are regarded as part of the domain of the web site` FALSE EQUALS NOTHING
#ASSERT `N 1 para 3A(2)(b) all mirrored web sites are regarded as part of the original web site` TRUE EQUALS JUST TRUE
#ASSERT `N 1 para 3A(3) the programme is a Singapore news programme` TRUE FALSE
#ASSERT NOT (`N 1 para 3A(3) the programme is a Singapore news programme` TRUE TRUE)
#ASSERT NOT (`N 1 para 3A(3) the programme is a Singapore news programme` FALSE FALSE)
#ASSERT `N 1 para 3A(4) this Notification does not apply to or in relation to the person` TRUE
#ASSERT `N 1 para 4 the conditions of the class licence are set out in the Schedule` TRUE EQUALS JUST TRUE
-- the Schedule was not obtained: the conditions answer NOTHING until they are known
#ASSERT `N 1 para 4 the conditions of the class licence are set out in the Schedule` FALSE EQUALS NOTHING
#ASSERT `N 1 para 5 the conditions of the class licence apply to the service, even if it was available or first provided before 15 July 1996` TRUE EQUALS JUST TRUE
#ASSERT `N 1 para 5 the conditions of the class licence apply to the service, even if it was available or first provided before 15 July 1996` FALSE EQUALS NOTHING

