IMPORT prelude
IMPORT daydate
IMPORT `sgba-nouns`
IMPORT `sgba-vintage`
IMPORT `sgba-sched`
IMPORT `sgba-p1-defs`
IMPORT `sgba-p4-services`
IMPORT `sgba-p5-apparatus`
IMPORT `sgba-p11-offences`

-- Tests for sgba-p11-offences.l4 (ss 46 to 58). Expected values are written from the text of each section; the penalty tests assert the figures the section prints.

§ `ss 46 and 47: guilt follows the contravention; the ceilings are what the sections print`

#ASSERT `s 46 the person is guilty of an offence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 46 the person is guilty of an offence` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 46 the person is guilty of an offence` NOTHING EQUALS NOTHING
#ASSERT `s 47 the person is guilty of an offence` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 47 the person is guilty of an offence` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 47 the person is guilty of an offence` NOTHING EQUALS NOTHING
#ASSERT `s 46 the punishment on conviction`'s `fine not exceeding` EQUALS 200000
#ASSERT `s 46 the punishment on conviction`'s `imprisonment` EQUALS `imprisonment not exceeding` 36
#ASSERT `s 46 the punishment on conviction`'s `daily fine` EQUALS `a further fine not exceeding, per day or part of a day after conviction` 10000
#ASSERT `s 46 the punishment on conviction`'s `forfeiture` EQUALS `no forfeiture is provided`
#ASSERT `s 47 the punishment on conviction`'s `fine not exceeding` EQUALS 40000
#ASSERT `s 47 the punishment on conviction`'s `imprisonment` EQUALS `imprisonment not exceeding` 36
#ASSERT `s 47 the punishment on conviction`'s `daily fine` EQUALS `no further daily fine is provided`
#ASSERT `s 47 the punishment on conviction`'s `forfeiture` EQUALS `the apparatus installed or found in the possession of the person convicted is forfeited to the Authority`
#ASSERT `s 47 the apparatus is forfeited to the Authority` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 47 the apparatus is forfeited to the Authority` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 47 the apparatus is forfeited to the Authority` FALSE TRUE EQUALS NOTHING

§ `s 48: decoders and encrypted programmes`

#ASSERT `s 48(1) the person's act is prohibited` `manufacture` TRUE TRUE
#ASSERT `s 48(1) the person's act is prohibited` `assemble` TRUE TRUE
#ASSERT `s 48(1) the person's act is prohibited` `modify` TRUE TRUE
#ASSERT `s 48(1) the person's act is prohibited` `import` TRUE TRUE
#ASSERT `s 48(1) the person's act is prohibited` `export` TRUE TRUE
#ASSERT `s 48(1) the person's act is prohibited` `sell` TRUE TRUE
#ASSERT `s 48(1) the person's act is prohibited` `offer for sale` TRUE TRUE
#ASSERT `s 48(1) the person's act is prohibited` `let for hire` TRUE TRUE
#ASSERT `s 48(1) the person's act is prohibited` `otherwise distribute` TRUE TRUE
#ASSERT NOT (`s 48(1) the person's act is prohibited` `sell` TRUE FALSE)
#ASSERT NOT (`s 48(1) the person's act is prohibited` `sell` FALSE TRUE)
#ASSERT `s 48(2) the person's reception or rebroadcast is prohibited` TRUE TRUE FALSE
#ASSERT NOT (`s 48(2) the person's reception or rebroadcast is prohibited` TRUE TRUE TRUE)
#ASSERT NOT (`s 48(2) the person's reception or rebroadcast is prohibited` FALSE TRUE FALSE)
#ASSERT NOT (`s 48(2) the person's reception or rebroadcast is prohibited` TRUE FALSE FALSE)
#ASSERT `s 48(3) the person is guilty of an offence` TRUE
#ASSERT NOT (`s 48(3) the person is guilty of an offence` FALSE)
#ASSERT `s 48(3) the punishment on conviction`'s `fine not exceeding` EQUALS 40000
#ASSERT `s 48(3) the punishment on conviction`'s `imprisonment` EQUALS `imprisonment not exceeding` 36
#ASSERT `s 48(3) the punishment on conviction`'s `forfeiture` EQUALS `the unauthorised decoder is forfeited to the Authority`
#ASSERT `s 48(4) it is presumed that the person knew that the decoder was an unauthorised decoder` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 48(4) it is presumed that the person knew that the decoder was an unauthorised decoder` TRUE TRUE EQUALS NOTHING
#ASSERT `s 48(4) it is presumed that the person knew that the decoder was an unauthorised decoder` FALSE FALSE EQUALS NOTHING
#ASSERT `s 48(5) the thing is a decoder` TRUE TRUE
#ASSERT NOT (`s 48(5) the thing is a decoder` TRUE FALSE)
#ASSERT NOT (`s 48(5) the thing is a decoder` FALSE TRUE)
#ASSERT `s 48(5) the person is the lawful provider in relation to the broadcasting service` TRUE FALSE FALSE
#ASSERT `s 48(5) the person is the lawful provider in relation to the broadcasting service` FALSE TRUE TRUE
#ASSERT NOT (`s 48(5) the person is the lawful provider in relation to the broadcasting service` FALSE TRUE FALSE)
#ASSERT NOT (`s 48(5) the person is the lawful provider in relation to the broadcasting service` FALSE FALSE TRUE)
#ASSERT `s 48(5) the decoder is an unauthorised decoder` TRUE TRUE TRUE
#ASSERT NOT (`s 48(5) the decoder is an unauthorised decoder` TRUE TRUE FALSE)
#ASSERT NOT (`s 48(5) the decoder is an unauthorised decoder` FALSE TRUE TRUE)

§ `s 48A: civil action and the six-year limit`

#ASSERT `s 48A(1) the lawful provider or the copyright owner may bring a civil action against the person` TRUE TRUE TRUE
#ASSERT NOT (`s 48A(1) the lawful provider or the copyright owner may bring a civil action against the person` TRUE TRUE FALSE)
#ASSERT NOT (`s 48A(1) the lawful provider or the copyright owner may bring a civil action against the person` TRUE FALSE TRUE)
#ASSERT `s 48A(2) the lawful provider or the copyright owner may bring a civil action against the person` TRUE TRUE
#ASSERT NOT (`s 48A(2) the lawful provider or the copyright owner may bring a civil action against the person` TRUE FALSE)
-- an act on 10 March 2020: the sixth anniversary is 10 March 2026; the day before, the day itself and the day after
#ASSERT `s 48A(3) the action is not barred` 10 3 2020 (Date 9 3 2026)
#ASSERT `s 48A(3) the action is not barred` 10 3 2020 (Date 10 3 2026)
#ASSERT NOT (`s 48A(3) the action is not barred` 10 3 2020 (Date 11 3 2026))

§ `ss 49 and 50`

#ASSERT `s 49 the person is guilty of an offence` TRUE
#ASSERT NOT (`s 49 the person is guilty of an offence` FALSE)
#ASSERT `s 49 the punishment on conviction`'s `fine not exceeding` EQUALS 5000
#ASSERT `s 49 the punishment on conviction`'s `imprisonment` EQUALS `no imprisonment is provided`
#ASSERT `s 50(1) the person must provide the document or information` TRUE TRUE
#ASSERT NOT (`s 50(1) the person must provide the document or information` TRUE FALSE)
#ASSERT `s 50(2) the person is guilty of an offence` TRUE TRUE
#ASSERT NOT (`s 50(2) the person is guilty of an offence` TRUE FALSE)
#ASSERT `s 50(3) the person is guilty of an offence` TRUE FALSE FALSE
#ASSERT `s 50(3) the person is guilty of an offence` FALSE TRUE FALSE
#ASSERT `s 50(3) the person is guilty of an offence` FALSE FALSE TRUE
#ASSERT NOT (`s 50(3) the person is guilty of an offence` FALSE FALSE FALSE)
#ASSERT `s 50(4) the punishment on conviction of an offence under subsection (2) or (3)`'s `fine not exceeding` EQUALS 5000
#ASSERT `s 50(4) the punishment on conviction of an offence under subsection (2) or (3)`'s `imprisonment` EQUALS `imprisonment not exceeding` 12

§ `ss 51 to 55`

#ASSERT `s 51(1) the person may enter and inspect the premises and seize broadcasting apparatus found there which appears to be used for or in connection with broadcasting` TRUE TRUE FALSE FALSE
#ASSERT `s 51(1) the person may enter and inspect the premises and seize broadcasting apparatus found there which appears to be used for or in connection with broadcasting` TRUE FALSE TRUE FALSE
#ASSERT `s 51(1) the person may enter and inspect the premises and seize broadcasting apparatus found there which appears to be used for or in connection with broadcasting` TRUE FALSE FALSE TRUE
#ASSERT NOT (`s 51(1) the person may enter and inspect the premises and seize broadcasting apparatus found there which appears to be used for or in connection with broadcasting` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 51(1) the person may enter and inspect the premises and seize broadcasting apparatus found there which appears to be used for or in connection with broadcasting` TRUE FALSE FALSE FALSE)
#ASSERT `s 51(2) the apparatus is taken and deemed to be forfeited to the Authority` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 51(2) the apparatus is taken and deemed to be forfeited to the Authority` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 51(2) the apparatus is taken and deemed to be forfeited to the Authority` FALSE FALSE EQUALS NOTHING
#ASSERT `s 51(3) the person may, personally or by authorised agent, give written notice to the Authority that the person claims the apparatus` TRUE
#ASSERT `s 51(4) the Authority may direct that the apparatus be released or refer the matter to a District Court or a Magistrate's Court` TRUE
#ASSERT `s 51(5) the court is to examine the matter and, upon examination, order that the apparatus be forfeited or released` TRUE
#ASSERT `s 52(1) the person may arrest the arrestee without warrant` TRUE TRUE FALSE
#ASSERT `s 52(1) the person may arrest the arrestee without warrant` TRUE FALSE TRUE
#ASSERT NOT (`s 52(1) the person may arrest the arrestee without warrant` FALSE TRUE TRUE)
#ASSERT `s 52(1) the arrested person may be searched by that searcher` FALSE FALSE
#ASSERT `s 52(1) the arrested person may be searched by that searcher` TRUE TRUE
#ASSERT NOT (`s 52(1) the arrested person may be searched by that searcher` TRUE FALSE)
#ASSERT `s 52(2) the person arrested must be taken, with any article as to which an offence may have been committed or attempted, to a police station` TRUE
#ASSERT `s 52(3) an offence punishable under that section is deemed an arrestable offence within the meaning of the Criminal Procedure Code 2010` 30
#ASSERT `s 52(3) an offence punishable under that section is deemed an arrestable offence within the meaning of the Criminal Procedure Code 2010` 46
#ASSERT `s 52(3) an offence punishable under that section is deemed an arrestable offence within the meaning of the Criminal Procedure Code 2010` 47
#ASSERT `s 52(3) an offence punishable under that section is deemed an arrestable offence within the meaning of the Criminal Procedure Code 2010` 48
#ASSERT NOT (`s 52(3) an offence punishable under that section is deemed an arrestable offence within the meaning of the Criminal Procedure Code 2010` 49)
#ASSERT NOT (`s 52(3) an offence punishable under that section is deemed an arrestable offence within the meaning of the Criminal Procedure Code 2010` 20)
#ASSERT `s 53 the bar on costs, damages and other relief, save an order for return or payment of value, applies` FALSE
#ASSERT NOT (`s 53 the bar on costs, damages and other relief, save an order for return or payment of value, applies` TRUE)
#ASSERT `s 54 the person may be prosecuted under the other written law and be liable to its punishment or penalty, higher or other than this Act's` TRUE FALSE
#ASSERT NOT (`s 54 the person may be prosecuted under the other written law and be liable to its punishment or penalty, higher or other than this Act's` TRUE TRUE)
#ASSERT `s 55 the person may conduct proceedings in respect of an offence under this Act` TRUE TRUE
#ASSERT NOT (`s 55 the person may conduct proceedings in respect of an offence under this Act` FALSE TRUE)

§ `s 56: corporate offenders and unincorporated associations`

#ASSERT `s 56(1) the officer as well as the body corporate is guilty of the offence` TRUE TRUE
#ASSERT NOT (`s 56(1) the officer as well as the body corporate is guilty of the offence` TRUE FALSE)
#ASSERT `s 56(2) subsection (1) applies to the acts and defaults of a member in connection with the member's functions of management as if the member were a director` TRUE EQUALS JUST TRUE
#ASSERT `s 56(2) subsection (1) applies to the acts and defaults of a member in connection with the member's functions of management as if the member were a director` FALSE EQUALS NOTHING
#ASSERT `s 56(3) proceedings must be brought against the association in its own name and not in that of any of its members` TRUE EQUALS JUST TRUE
#ASSERT `s 56(4) the partner as well as the partnership is guilty of the offence` TRUE TRUE
#ASSERT NOT (`s 56(4) the partner as well as the partnership is guilty of the offence` FALSE TRUE)
#ASSERT `s 56(5) the officer or member as well as the association is guilty of the offence` TRUE TRUE
#ASSERT NOT (`s 56(5) the officer or member as well as the association is guilty of the offence` TRUE FALSE)
#ASSERT `s 56(6) the section applies to the foreign body as the regulations provide` TRUE
#ASSERT `s 56(7) the person is an officer in relation to a body corporate` TRUE FALSE
#ASSERT `s 56(7) the person is an officer in relation to a body corporate` FALSE TRUE
#ASSERT NOT (`s 56(7) the person is an officer in relation to a body corporate` FALSE FALSE)
#ASSERT `s 56(7) the person is an officer in relation to an unincorporated association other than a partnership` TRUE FALSE
#ASSERT `s 56(7) the person is an officer in relation to an unincorporated association other than a partnership` FALSE TRUE
#ASSERT `s 56(7) the person is treated as a partner` TRUE FALSE
#ASSERT `s 56(7) the person is treated as a partner` FALSE TRUE
#ASSERT NOT (`s 56(7) the person is treated as a partner` FALSE FALSE)

§ `ss 57 and 58: composition and jurisdiction`

#ASSERT `s 57(1) the Authority may compound the offence by collecting that sum` TRUE 1000
#ASSERT `s 57(1) the Authority may compound the offence by collecting that sum` TRUE 999
#ASSERT NOT (`s 57(1) the Authority may compound the offence by collecting that sum` TRUE 1001)
#ASSERT NOT (`s 57(1) the Authority may compound the offence by collecting that sum` FALSE 500)
#ASSERT `s 57(2) the offence has been prescribed as one which may be compounded` TRUE
#ASSERT NOT (`s 57(2) the offence has been prescribed as one which may be compounded` FALSE)
#ASSERT `s 58 the court has jurisdiction to try an offence under this Act and power to impose the full penalty or punishment` TRUE
#ASSERT NOT (`s 58 the court has jurisdiction to try an offence under this Act and power to impose the full penalty or punishment` FALSE)
