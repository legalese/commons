#ASSERT `S 70/2012 N 1 Schedule para 2A(1) the provider has complied` TRUE TRUE TRUE TRUE FALSE EQUALS FALSE
#ASSERT `S 70/2012 N 1 Schedule para 2A(1) the provider has complied` TRUE FALSE TRUE TRUE TRUE EQUALS FALSE
#ASSERT `S 70/2012 N 1 Schedule para 2A(1) the provider has complied` FALSE FALSE FALSE FALSE FALSE EQUALS TRUE
#ASSERT `S 70/2012 N 1 Schedule para 2A(2) the provider has complied` TRUE TRUE EQUALS TRUE
#ASSERT `S 70/2012 N 1 Schedule para 2A(2) the provider has complied` TRUE FALSE EQUALS FALSE
#ASSERT `S 70/2012 N 1 Schedule para 2A(2) the provider has complied` FALSE FALSE EQUALS TRUE
-- S 330/2013: in operation 1 June 2013; para 3 and 3A
#ASSERT `S 330/2013 the amendments are in operation on` (Date 31 5 2013) EQUALS FALSE
#ASSERT `S 330/2013 the amendments are in operation on` (Date 1 6 2013) EQUALS TRUE
#ASSERT `S 330/2013 N 1 para 3 the computer on-line service is excepted from the class licence` TRUE EQUALS TRUE
#ASSERT `S 330/2013 N 1 para 3 the computer on-line service is excepted from the class licence` FALSE EQUALS FALSE
#ASSERT `S 330/2013 N 1 para 3A(1) the Authority may give a notice` 50000 1 EQUALS TRUE
#ASSERT `S 330/2013 N 1 para 3A(1) the Authority may give a notice` 49999 1 EQUALS FALSE
#ASSERT `S 330/2013 N 1 para 3A(1) the Authority may give a notice` 50000 0 EQUALS FALSE
#ASSERT `S 330/2013 N 1 para 3A(1) the Authority may give a notice` 60000 2 EQUALS TRUE
#ASSERT `S 330/2013 N 1 para 3A(3) the programme is a Singapore news programme` TRUE FALSE EQUALS TRUE
#ASSERT `S 330/2013 N 1 para 3A(3) the programme is a Singapore news programme` TRUE TRUE EQUALS FALSE
#ASSERT `S 330/2013 N 1 para 3A(3) the programme is a Singapore news programme` FALSE FALSE EQUALS FALSE
