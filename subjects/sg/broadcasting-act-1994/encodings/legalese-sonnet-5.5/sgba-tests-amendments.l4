-- Tests for the Gazette amendments to the Exemption Order and the Class Licence Notification, the Schedule to S 523/2010 and the Exemption Order of the Revised Edition 2004.
-- Every expected value is written from the Gazette text of the paragraph named in the comment (each instrument's own deposit), not from what the code returned.

-- S 600/2014: in operation 15 September 2014; O 1 para 1(f) as amended; para 2 deleted
#ASSERT `S 600/2014 the amendments are in operation on` (Date 14 9 2014) EQUALS FALSE
#ASSERT `S 600/2014 the amendments are in operation on` (Date 15 9 2014) EQUALS TRUE
#ASSERT `S 600/2014 O 1 para 1(f) the service is exempt from sections 8 and 9 (as amended)` TRUE FALSE FALSE EQUALS TRUE
#ASSERT `S 600/2014 O 1 para 1(f) the service is exempt from sections 8 and 9 (as amended)` TRUE TRUE FALSE EQUALS FALSE
#ASSERT `S 600/2014 O 1 para 1(f) the service is exempt from sections 8 and 9 (as amended)` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `S 600/2014 O 1 para 1(f) the service is exempt from sections 8 and 9 (as amended)` FALSE FALSE FALSE EQUALS FALSE
#ASSERT `S 600/2014 O 1 para 2 (the exemption includes computer on-line services of individual Internet Content Providers) still has effect on` (Date 14 9 2014) EQUALS TRUE
#ASSERT `S 600/2014 O 1 para 2 (the exemption includes computer on-line services of individual Internet Content Providers) still has effect on` (Date 15 9 2014) EQUALS FALSE
-- O 1 as the Revised Edition 2004 prints it: para 1(f) and para 2
#ASSERT `O 1 para 1(f) the service is exempt from sections 8 and 9 (RevEd 2004)` TRUE FALSE EQUALS TRUE
#ASSERT `O 1 para 1(f) the service is exempt from sections 8 and 9 (RevEd 2004)` TRUE TRUE EQUALS FALSE
#ASSERT `O 1 para 1(f) the service is exempt from sections 8 and 9 (RevEd 2004)` FALSE FALSE EQUALS FALSE
#ASSERT `O 1 para 2 the exemption under paragraph 1(f) includes the service (RevEd 2004)` TRUE FALSE EQUALS TRUE
#ASSERT `O 1 para 2 the exemption under paragraph 1(f) includes the service (RevEd 2004)` TRUE TRUE EQUALS FALSE
#ASSERT `O 1 para 2 the exemption under paragraph 1(f) includes the service (RevEd 2004)` FALSE FALSE EQUALS FALSE
-- S 478/2020: in operation 22 June 2020; para 3A(4)
#ASSERT `S 478/2020 the amendment is in operation on` (Date 21 6 2020) EQUALS FALSE
#ASSERT `S 478/2020 the amendment is in operation on` (Date 22 6 2020) EQUALS TRUE
#ASSERT `S 478/2020 N 1 para 3A(4) the Class Licence Notification (N 1) applies to the person` TRUE EQUALS FALSE
#ASSERT `S 478/2020 N 1 para 3A(4) the Class Licence Notification (N 1) applies to the person` FALSE EQUALS TRUE
-- S 196/2004: in operation 15 April 2004; para 11A (14 days)
#ASSERT `S 196/2004 the amendment is in operation on` (Date 14 4 2004) EQUALS FALSE
#ASSERT `S 196/2004 the amendment is in operation on` (Date 15 4 2004) EQUALS TRUE
#ASSERT `S 196/2004 N 1 Schedule para 11A the licensee has registered in time` TRUE FALSE 14 EQUALS TRUE
#ASSERT `S 196/2004 N 1 Schedule para 11A the licensee has registered in time` TRUE FALSE 15 EQUALS FALSE
#ASSERT `S 196/2004 N 1 Schedule para 11A the licensee has registered in time` FALSE FALSE 90 EQUALS TRUE
#ASSERT `S 196/2004 N 1 Schedule para 11A the licensee has registered in time` TRUE TRUE 0 EQUALS TRUE
-- S 555/2003: in operation 1 December 2003; para 9(1), 9(2), 9A
#ASSERT `S 555/2003 the amendments are in operation on` (Date 30 11 2003) EQUALS FALSE
#ASSERT `S 555/2003 the amendments are in operation on` (Date 1 12 2003) EQUALS TRUE
#ASSERT `S 555/2003 N 1 Schedule para 9(1) the licensee has complied` TRUE TRUE EQUALS TRUE
#ASSERT `S 555/2003 N 1 Schedule para 9(1) the licensee has complied` TRUE FALSE EQUALS FALSE
#ASSERT `S 555/2003 N 1 Schedule para 9(1) the licensee has complied` FALSE FALSE EQUALS TRUE
#ASSERT `S 555/2003 N 1 Schedule para 9(2) the licensee has complied` TRUE EQUALS TRUE
#ASSERT `S 555/2003 N 1 Schedule para 9(2) the licensee has complied` FALSE EQUALS FALSE
#ASSERT `S 555/2003 N 1 Schedule para 9A the annual licence fee for each period of 12 months` TRUE EQUALS 2000
#ASSERT `S 555/2003 N 1 Schedule para 9A the annual licence fee for each period of 12 months` FALSE EQUALS 0
-- S 496/2001: in operation 10 October 2001; para 2A, para 5
#ASSERT `S 496/2001 the amendments are in operation on` (Date 9 10 2001) EQUALS FALSE
#ASSERT `S 496/2001 the amendments are in operation on` (Date 10 10 2001) EQUALS TRUE
#ASSERT `S 496/2001 N 1 Schedule para 2A the provider has registered or re-registered in time` TRUE TRUE 14 FALSE EQUALS TRUE
#ASSERT `S 496/2001 N 1 Schedule para 2A the provider has registered or re-registered in time` TRUE TRUE 15 FALSE EQUALS FALSE
#ASSERT `S 496/2001 N 1 Schedule para 2A the provider has registered or re-registered in time` TRUE TRUE 30 TRUE EQUALS TRUE
#ASSERT `S 496/2001 N 1 Schedule para 2A the provider has registered or re-registered in time` FALSE FALSE 99 FALSE EQUALS TRUE
#ASSERT `S 496/2001 N 1 Schedule para 5 the provider has complied` TRUE TRUE EQUALS TRUE
#ASSERT `S 496/2001 N 1 Schedule para 5 the provider has complied` TRUE FALSE EQUALS FALSE
#ASSERT `S 496/2001 N 1 Schedule para 5 the provider has complied` FALSE TRUE EQUALS FALSE
