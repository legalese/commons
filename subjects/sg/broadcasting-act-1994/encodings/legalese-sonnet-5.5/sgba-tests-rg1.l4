IMPORT prelude
IMPORT daydate
IMPORT `sgba-nouns`
IMPORT `sgba-i-rg1`
IMPORT `sgba-i-s333-2004`
IMPORT `sgba-i-s548-2012`
IMPORT `sgba-i-s212-1999`
IMPORT `sgba-i-s354-2001`
IMPORT `sgba-versions`

-- Tests for the Television and Radio Licensing Regulations (Rg 1), the amendments by S 333/2004 and S 212/1999, the revocation by S 548/2012, the TVRO amendment S 354/2001 and the version tables of sgba-versions.l4.
-- Every expected value is written from the Gazette text of the regulation named in the comment (BA1994-RG1.txt, BA1994-S333-2004.txt, BA1994-S548-2012.txt, BA1994-S212-1999.txt, BA1994-S354-2001.txt), not from what the code returned.
-- Dates: the Revised Edition 2004 takes effect on 29 February 2004; S 333/2004 was published on 15 June 2004 and came into operation on 21 June 2004; S 548/2012 was published on 31 October 2012 and is deemed in operation from 1 January 2011.

`equipment used for aural reception only` MEANS
    `Receiving equipment` WITH `capable of the reception of a broadcasting service` IS TRUE
                              , `designed or constructed for the reception of a broadcasting service` IS TRUE
                              , `used for the aural reception of a broadcasting service` IS TRUE
                              , `used for the visual and aural reception of a broadcasting service in monochrome or colour` IS FALSE
                              , `capable of direct reception of a broadcasting service from a satellite` IS FALSE

`equipment used for visual and aural reception, not a TVRO system` MEANS
    `Receiving equipment` WITH `capable of the reception of a broadcasting service` IS TRUE
                              , `designed or constructed for the reception of a broadcasting service` IS TRUE
                              , `used for the aural reception of a broadcasting service` IS TRUE
                              , `used for the visual and aural reception of a broadcasting service in monochrome or colour` IS TRUE
                              , `capable of direct reception of a broadcasting service from a satellite` IS FALSE

`equipment capable of direct reception from a satellite` MEANS
    `Receiving equipment` WITH `capable of the reception of a broadcasting service` IS TRUE
                              , `designed or constructed for the reception of a broadcasting service` IS TRUE
                              , `used for the aural reception of a broadcasting service` IS FALSE
                              , `used for the visual and aural reception of a broadcasting service in monochrome or colour` IS FALSE
                              , `capable of direct reception of a broadcasting service from a satellite` IS TRUE

GIVEN c IS A DATE
      r IS A DATE
GIVETH A STRING
`the Rg 1 text read` MEANS
    CONSIDER `the Rg 1 version read for conduct on a day, the law read as at a day` c r
    WHEN NOTHING THEN "NOTHING"
    WHEN JUST v THEN v's `the text read`

§ `Which text of Rg 1 is read: the conduct day and the reading day`

-- conduct before the Revised Edition of 29 February 2004: no text obtained
#ASSERT `the Rg 1 text read` (Date 1 1 2004) (Date 1 1 2005) EQUALS "NOTHING"
-- the day before
#ASSERT `the Rg 1 text read` (Date 28 2 2004) (Date 1 1 2005) EQUALS "NOTHING"
-- reading day before the Revised Edition
#ASSERT `the Rg 1 text read` (Date 29 2 2004) (Date 28 2 2004) EQUALS "NOTHING"
-- the Revised Edition, on its own day
#ASSERT `the Rg 1 text read` (Date 29 2 2004) (Date 29 2 2004) EQUALS "RevEd 2004"
-- S 333/2004 is published on this day but not yet in operation
#ASSERT `the Rg 1 text read` (Date 15 6 2004) (Date 15 6 2004) EQUALS "RevEd 2004"
-- the day before S 333/2004 comes into operation
#ASSERT `the Rg 1 text read` (Date 20 6 2004) (Date 1 1 2010) EQUALS "RevEd 2004"
-- in operation, but not yet published on the reading day
#ASSERT `the Rg 1 text read` (Date 21 6 2004) (Date 14 6 2004) EQUALS "RevEd 2004"
-- in operation and published
#ASSERT `the Rg 1 text read` (Date 21 6 2004) (Date 15 6 2004) EQUALS "amended by S 333/2004"
#ASSERT `the Rg 1 text read` (Date 21 6 2004) (Date 20 6 2004) EQUALS "amended by S 333/2004"
#ASSERT `the Rg 1 text read` (Date 1 1 2010) (Date 1 1 2010) EQUALS "amended by S 333/2004"
-- the day before the revocation is deemed in operation: conduct is read under the amended Regulations even after the revocation is published
#ASSERT `the Rg 1 text read` (Date 31 12 2010) (Date 1 11 2012) EQUALS "amended by S 333/2004"
-- the day the revocation is deemed in operation, read on that day
#ASSERT `the Rg 1 text read` (Date 1 1 2011) (Date 1 1 2011) EQUALS "amended by S 333/2004"
-- the revocation is not yet published
#ASSERT `the Rg 1 text read` (Date 1 1 2011) (Date 30 10 2012) EQUALS "amended by S 333/2004"
-- the revocation is published
#ASSERT `the Rg 1 text read` (Date 1 1 2011) (Date 31 10 2012) EQUALS "revoked by S 548/2012"
#ASSERT `the Rg 1 text read` (Date 1 6 2011) (Date 15 9 2012) EQUALS "amended by S 333/2004"
#ASSERT `the Rg 1 text read` (Date 1 6 2011) (Date 15 11 2012) EQUALS "revoked by S 548/2012"
#ASSERT `the Rg 1 text read` (Date 31 10 2012) (Date 30 10 2012) EQUALS "amended by S 333/2004"
#ASSERT `the Rg 1 text read` (Date 31 10 2012) (Date 31 10 2012) EQUALS "revoked by S 548/2012"
-- the retrieval day
#ASSERT `the Rg 1 text read` (Date 1 6 2019) (Date 1 10 2026) EQUALS "revoked by S 548/2012"
-- "today" (3 November 2026)
#ASSERT `the Rg 1 text read` (Date 1 6 2019) (Date 3 11 2026) EQUALS "revoked by S 548/2012"
-- the day the sources were last checked (4 November 2026, assumed, not ruled)
#ASSERT `the Rg 1 text read` (Date 1 6 2019) (Date 4 11 2026) EQUALS "revoked by S 548/2012"
-- a reading day after the day the sources were last checked (4 November 2026)
#ASSERT `the Rg 1 text read` (Date 1 6 2019) (Date 5 11 2026) EQUALS "NOTHING"

-- the rows of the table, as the Gazette prints their dates
#ASSERT `Rg 1 as printed in the Revised Edition 2004`'s `takes effect on` EQUALS (Date 29 2 2004)
#ASSERT `Rg 1 as amended by S 333/2004`'s `takes effect on` EQUALS (Date 21 6 2004)
#ASSERT `Rg 1 as amended by S 333/2004`'s `published on` EQUALS (Date 15 6 2004)
#ASSERT `Rg 1 as revoked by S 548/2012`'s `takes effect on` EQUALS (Date 1 1 2011)
#ASSERT `Rg 1 as revoked by S 548/2012`'s `published on` EQUALS (Date 31 10 2012)
#ASSERT `Rg 1 as revoked by S 548/2012`'s `the Regulations are in force` EQUALS FALSE
#ASSERT foldr (GIVEN a, n YIELD n PLUS 1) 0 `the Rg 1 versions` EQUALS 3
#ASSERT (`the later published of two Rg 1 versions` `Rg 1 as printed in the Revised Edition 2004` (JUST `Rg 1 as revoked by S 548/2012`)) EQUALS JUST `Rg 1 as revoked by S 548/2012`
#ASSERT (`the later published of two Rg 1 versions` `Rg 1 as revoked by S 548/2012` (JUST `Rg 1 as printed in the Revised Edition 2004`)) EQUALS JUST `Rg 1 as revoked by S 548/2012`
#ASSERT (`the later published of two Rg 1 versions` `Rg 1 as printed in the Revised Edition 2004` NOTHING) EQUALS JUST `Rg 1 as printed in the Revised Edition 2004`

§ `Dispatchers: what the version read says about a licence, for each pair of days`

-- Argument order of the sound receiver rule: day of the conduct; day read as at; installed in a vehicle; in a vessel; a ship station licence has been granted.
-- Revised Edition reg 23(1): installed in a vehicle
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 3 2004) (Date 1 3 2004) TRUE FALSE FALSE EQUALS JUST TRUE
-- installed in a vessel without a ship station licence
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 3 2004) (Date 1 3 2004) FALSE TRUE FALSE EQUALS JUST TRUE
-- a vessel with a ship station licence
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 3 2004) (Date 1 3 2004) FALSE TRUE TRUE EQUALS JUST FALSE
-- neither
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 3 2004) (Date 1 3 2004) FALSE FALSE FALSE EQUALS JUST FALSE
-- as amended: reg 23(2) names a vessel only
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 1 2010) (Date 1 1 2010) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 1 2010) (Date 1 1 2010) FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 1 2010) (Date 1 1 2010) FALSE TRUE TRUE EQUALS JUST FALSE
-- conduct in 2011 read before the revocation was published
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 6 2011) (Date 15 9 2012) FALSE TRUE FALSE EQUALS JUST TRUE
-- read after the revocation was published
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 6 2011) (Date 15 11 2012) FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 6 2011) (Date 15 11 2012) TRUE FALSE FALSE EQUALS JUST FALSE
-- before any text obtained
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 1 2004) (Date 1 1 2005) TRUE FALSE FALSE EQUALS NOTHING
-- "today" (3 November 2026): the Regulations are revoked, and the answer comes from the revoked version
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 6 2015) (Date 3 11 2026) FALSE TRUE FALSE EQUALS JUST FALSE
-- the day the sources were last checked (4 November 2026, assumed, not ruled)
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 6 2015) (Date 4 11 2026) FALSE TRUE FALSE EQUALS JUST FALSE
-- a reading day after it
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 6 2015) (Date 5 11 2026) FALSE TRUE FALSE EQUALS NOTHING

-- What reg 23 states in terms is about a vehicle or a vessel; a sound receiver kept elsewhere is not within its words, so this function answers FALSE for it. Whether a licence is needed for such a receiver is a different question, answered by s 20(1)(c) of the Act (fork F-BA-12).
#ASSERT `Rg 1 reg 23 states in terms that a licence is required for a broadcast sound receiver installed in a vehicle or in a vessel, for conduct on a day, the law read as at a day` (Date 1 3 2004) (Date 1 3 2004) FALSE FALSE FALSE EQUALS JUST FALSE

-- Argument order of the television prohibition: day; read as at; the person operates a broadcast television receiver; the person has a licence.
-- Revised Edition reg 27(1): no person shall operate a broadcast television receiver without a licence
#ASSERT `Rg 1 the person contravenes the prohibition on operating a broadcast television receiver without a licence, for conduct on a day, the law read as at a day` (Date 1 3 2004) (Date 1 3 2004) TRUE FALSE EQUALS JUST TRUE
-- with a licence
#ASSERT `Rg 1 the person contravenes the prohibition on operating a broadcast television receiver without a licence, for conduct on a day, the law read as at a day` (Date 1 3 2004) (Date 1 3 2004) TRUE TRUE EQUALS JUST FALSE
-- not operating one
#ASSERT `Rg 1 the person contravenes the prohibition on operating a broadcast television receiver without a licence, for conduct on a day, the law read as at a day` (Date 1 3 2004) (Date 1 3 2004) FALSE FALSE EQUALS JUST FALSE
-- as amended by S 333/2004, reg 27(1) is an application provision: the prohibition is gone from the Regulations
#ASSERT `Rg 1 the person contravenes the prohibition on operating a broadcast television receiver without a licence, for conduct on a day, the law read as at a day` (Date 1 1 2010) (Date 1 1 2010) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Rg 1 the person contravenes the prohibition on operating a broadcast television receiver without a licence, for conduct on a day, the law read as at a day` (Date 1 6 2011) (Date 15 9 2012) TRUE FALSE EQUALS JUST FALSE
-- revoked
#ASSERT `Rg 1 the person contravenes the prohibition on operating a broadcast television receiver without a licence, for conduct on a day, the law read as at a day` (Date 1 6 2011) (Date 15 11 2012) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Rg 1 the person contravenes the prohibition on operating a broadcast television receiver without a licence, for conduct on a day, the law read as at a day` (Date 1 1 2004) (Date 1 1 2005) TRUE FALSE EQUALS NOTHING

-- Reg 28(2), unchanged in substance by S 333/2004: day; read as at; installed in a vehicle; in a vessel; a ship station licence has been granted.
#ASSERT `Rg 1 reg 28(2) states in terms that a separate licence is required for a broadcast television receiver installed in a vehicle or vessel, for conduct on a day, the law read as at a day` (Date 1 3 2004) (Date 1 3 2004) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Rg 1 reg 28(2) states in terms that a separate licence is required for a broadcast television receiver installed in a vehicle or vessel, for conduct on a day, the law read as at a day` (Date 1 1 2010) (Date 1 1 2010) TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Rg 1 reg 28(2) states in terms that a separate licence is required for a broadcast television receiver installed in a vehicle or vessel, for conduct on a day, the law read as at a day` (Date 1 1 2010) (Date 1 1 2010) FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Rg 1 reg 28(2) states in terms that a separate licence is required for a broadcast television receiver installed in a vehicle or vessel, for conduct on a day, the law read as at a day` (Date 1 1 2010) (Date 1 1 2010) FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Rg 1 reg 28(2) states in terms that a separate licence is required for a broadcast television receiver installed in a vehicle or vessel, for conduct on a day, the law read as at a day` (Date 1 6 2011) (Date 15 11 2012) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Rg 1 reg 28(2) states in terms that a separate licence is required for a broadcast television receiver installed in a vehicle or vessel, for conduct on a day, the law read as at a day` (Date 1 6 2011) (Date 15 9 2012) TRUE FALSE FALSE EQUALS JUST TRUE
-- Reg 29A, new from 21 June 2004: day; read as at; installed in a commercial property.
#ASSERT `Rg 1 reg 29A(1) states in terms that a separate licence is required for a broadcast television receiver installed in a commercial property, for conduct on a day, the law read as at a day` (Date 1 3 2004) (Date 1 3 2004) TRUE EQUALS JUST FALSE
#ASSERT `Rg 1 reg 29A(1) states in terms that a separate licence is required for a broadcast television receiver installed in a commercial property, for conduct on a day, the law read as at a day` (Date 21 6 2004) (Date 21 6 2004) TRUE EQUALS JUST TRUE
#ASSERT `Rg 1 reg 29A(1) states in terms that a separate licence is required for a broadcast television receiver installed in a commercial property, for conduct on a day, the law read as at a day` (Date 1 1 2010) (Date 1 1 2010) TRUE EQUALS JUST TRUE
#ASSERT `Rg 1 reg 29A(1) states in terms that a separate licence is required for a broadcast television receiver installed in a commercial property, for conduct on a day, the law read as at a day` (Date 1 1 2010) (Date 1 1 2010) FALSE EQUALS JUST FALSE
#ASSERT `Rg 1 reg 29A(1) states in terms that a separate licence is required for a broadcast television receiver installed in a commercial property, for conduct on a day, the law read as at a day` (Date 1 6 2011) (Date 15 11 2012) TRUE EQUALS JUST FALSE
-- Regs 24 and 29: day; read as at; the use is temporary; the use is in a public place, or at an official or social function, or at a charitable function.
#ASSERT `Rg 1 regs 24 and 29 state in terms that a licence is not required for the temporary use of a receiver, for conduct on a day, the law read as at a day` (Date 1 3 2004) (Date 1 3 2004) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Rg 1 regs 24 and 29 state in terms that a licence is not required for the temporary use of a receiver, for conduct on a day, the law read as at a day` (Date 1 1 2010) (Date 1 1 2010) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Rg 1 regs 24 and 29 state in terms that a licence is not required for the temporary use of a receiver, for conduct on a day, the law read as at a day` (Date 1 1 2010) (Date 1 1 2010) FALSE TRUE EQUALS JUST FALSE
#ASSERT `Rg 1 regs 24 and 29 state in terms that a licence is not required for the temporary use of a receiver, for conduct on a day, the law read as at a day` (Date 1 1 2010) (Date 1 1 2010) TRUE FALSE EQUALS JUST FALSE
#ASSERT `Rg 1 regs 24 and 29 state in terms that a licence is not required for the temporary use of a receiver, for conduct on a day, the law read as at a day` (Date 1 6 2011) (Date 15 11 2012) TRUE TRUE EQUALS JUST FALSE

§ `Revised Edition 2004: regulations 2 to 39 and the Schedules`

-- reg 2(1) definitions
#ASSERT `Rg 1 reg 2(1) the apparatus is a broadcast sound receiver (RevEd 2004)` `equipment used for aural reception only` EQUALS TRUE
