#ASSERT `s 24 the licensee must obtain another licence under this Act or the Telecommunications Act 1999 for the use of that frequency or those satellite orbits` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 24 the licensee must obtain another licence under this Act or the Telecommunications Act 1999 for the use of that frequency or those satellite orbits` FALSE TRUE TRUE EQUALS NOTHING

§ `ss 25 to 28`

#ASSERT `s 25(1) the broadcasting licensee has complied` TRUE
#ASSERT NOT (`s 25(1) the broadcasting licensee has complied` FALSE)
#ASSERT `s 25(2) the free-to-air licensee has complied` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 25(2) the free-to-air licensee has complied` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 25(2) the free-to-air licensee has complied` FALSE TRUE EQUALS NOTHING
#ASSERT `s 26(1) the Authority may direct the licensee to coordinate and cooperate in the use or sharing of the broadcasting apparatus or related equipment or facility` TRUE FALSE
#ASSERT NOT (`s 26(1) the Authority may direct the licensee to coordinate and cooperate in the use or sharing of the broadcasting apparatus or related equipment or facility` TRUE TRUE)
#ASSERT NOT (`s 26(1) the Authority may direct the licensee to coordinate and cooperate in the use or sharing of the broadcasting apparatus or related equipment or facility` FALSE FALSE)
#ASSERT `s 26(2) the Authority may direct the broadcasting licensee to coordinate and cooperate with the telecommunication licensee` TRUE
#ASSERT NOT (`s 26(2) the Authority may direct the broadcasting licensee to coordinate and cooperate with the telecommunication licensee` FALSE)
#ASSERT `s 26(3) the person or thing is a telecommunication licensee or telecommunication system` TRUE
#ASSERT `s 27(1) the person may inspect and test the broadcasting apparatus` TRUE TRUE TRUE
#ASSERT NOT (`s 27(1) the person may inspect and test the broadcasting apparatus` FALSE TRUE TRUE)
#ASSERT NOT (`s 27(1) the person may inspect and test the broadcasting apparatus` TRUE FALSE TRUE)
#ASSERT NOT (`s 27(1) the person may inspect and test the broadcasting apparatus` TRUE TRUE FALSE)
#ASSERT `s 27(2) the directors, officers and employees have done what the subsection requires` TRUE TRUE TRUE
#ASSERT NOT (`s 27(2) the directors, officers and employees have done what the subsection requires` TRUE TRUE FALSE)
#ASSERT NOT (`s 27(2) the directors, officers and employees have done what the subsection requires` FALSE TRUE TRUE)
#ASSERT `s 28(1) the Authority may by direction require the developer or owner to provide the apparatus, installation or plant or space, and access` TRUE TRUE
#ASSERT NOT (`s 28(1) the Authority may by direction require the developer or owner to provide the apparatus, installation or plant or space, and access` TRUE FALSE)
#ASSERT NOT (`s 28(1) the Authority may by direction require the developer or owner to provide the apparatus, installation or plant or space, and access` FALSE TRUE)
#ASSERT `s 28(2) the Authority may by direction require the developer or owner to provide access to the building or land and to or interconnection with the apparatus` TRUE TRUE
#ASSERT NOT (`s 28(2) the Authority may by direction require the developer or owner to provide access to the building or land and to or interconnection with the apparatus` FALSE TRUE)
#ASSERT `s 28(3) a direction under subsection (1) or (2) may include this requirement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 28(3) a direction under subsection (1) or (2) may include this requirement` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 28(3) a direction under subsection (1) or (2) may include this requirement` FALSE FALSE EQUALS NOTHING
#ASSERT `s 28(4) the person is guilty of an offence` TRUE
#ASSERT NOT (`s 28(4) the person is guilty of an offence` FALSE)
#ASSERT `s 28(4) the punishment on conviction`'s `fine not exceeding` EQUALS 10000
#ASSERT `s 28(4) the punishment on conviction`'s `imprisonment` EQUALS `no imprisonment is provided`
#ASSERT `s 28(5) the direction grants an exemption from a licensing requirement under this Act or any other written law` TRUE EQUALS JUST FALSE
#ASSERT `s 28(5) the direction grants an exemption from a licensing requirement under this Act or any other written law` FALSE EQUALS NOTHING
#ASSERT `s 28(6) installation or plant includes this thing` TRUE EQUALS JUST TRUE
#ASSERT `s 28(6) installation or plant includes this thing` FALSE EQUALS NOTHING

§ `ss 29 to 31`

#ASSERT `s 29(1) the foreign broadcasting service is proscribed` TRUE
#ASSERT NOT (`s 29(1) the foreign broadcasting service is proscribed` FALSE)
#ASSERT `s 29(2) the Authority must notify the Minister of the details of the service and its reasons` TRUE
