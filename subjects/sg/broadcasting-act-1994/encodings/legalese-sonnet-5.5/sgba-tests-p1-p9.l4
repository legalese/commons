#ASSERT `s 31(4) the Minister may impose this condition` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 31(4) the Minister may impose this condition` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 31(4) the Minister may impose this condition` FALSE FALSE EQUALS NOTHING
#ASSERT `s 31(5) the person is guilty of an offence` TRUE FALSE
#ASSERT `s 31(5) the person is guilty of an offence` FALSE TRUE
#ASSERT NOT (`s 31(5) the person is guilty of an offence` FALSE FALSE)
#ASSERT `s 31(5) the punishment on conviction`'s `fine not exceeding` EQUALS 100000
#ASSERT `s 31(5) the punishment on conviction`'s `imprisonment` EQUALS `no imprisonment is provided`
