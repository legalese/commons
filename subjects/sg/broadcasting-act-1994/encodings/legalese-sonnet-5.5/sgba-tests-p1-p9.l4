-- Tests for sgba-p1-other.l4 (s 1, s 2(2) to (6)), sgba-p2-authority.l4 (ss 3 and 4), sgba-p6-p7.l4 (ss 22 to 28) and sgba-p8-p9-foreign.l4 (ss 29 to 31).
-- Expected values are written from the text of each provision; an "includes" rule is JUST TRUE for a listed thing and NOTHING otherwise (an inclusive definition never excludes).

§ `s 1; s 2(2) to (6)`

#ASSERT `s 1 the Act is called the Broadcasting Act 1994` "Broadcasting Act 1994"
#ASSERT NOT (`s 1 the Act is called the Broadcasting Act 1994` "Broadcasting Act 1993")
#ASSERT `s 2(2) part of the public includes this group` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2(2) part of the public includes this group` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2(2) part of the public includes this group` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2(2) part of the public includes this group` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2(2) part of the public includes this group` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2(3) the company is regarded as wholly owned by the Government` TRUE
#ASSERT NOT (`s 2(3) the company is regarded as wholly owned by the Government` FALSE)
#ASSERT `s 2(4) the communication of content is of a private or domestic nature` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2(4) the communication of content is of a private or domestic nature` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2(4) the communication of content is of a private or domestic nature` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2(4) the communication of content is of a private or domestic nature` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2(4) the communication of content is of a private or domestic nature` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2(5) the factor counts as a restriction on access to content for the purposes of subsection (4)` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2(5) the factor counts as a restriction on access to content for the purposes of subsection (4)` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2(5) the factor counts as a restriction on access to content for the purposes of subsection (4)` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2(5) the factor counts as a restriction on access to content for the purposes of subsection (4)` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2(6) the end-user is assumed not to falsify or conceal identity or location in deciding physical presence in Singapore` TRUE
#ASSERT `s 2(1) the definitions in this section apply` FALSE
#ASSERT NOT (`s 2(1) the definitions in this section apply` TRUE)

§ `ss 3 and 4`

#ASSERT `s 3(1) the Minister may give the person the directions the Minister thinks fit as to the exercise of its functions under this Act` TRUE
#ASSERT NOT (`s 3(1) the Minister may give the person the directions the Minister thinks fit as to the exercise of its functions under this Act` FALSE)
#ASSERT `s 3(2) the Minister may, after consultation, give the directions that are necessary in the circumstances` TRUE FALSE TRUE
#ASSERT `s 3(2) the Minister may, after consultation, give the directions that are necessary in the circumstances` FALSE TRUE TRUE
#ASSERT NOT (`s 3(2) the Minister may, after consultation, give the directions that are necessary in the circumstances` FALSE FALSE TRUE)
#ASSERT NOT (`s 3(2) the Minister may, after consultation, give the directions that are necessary in the circumstances` TRUE FALSE FALSE)
#ASSERT NOT (`s 3(2) the Minister may, after consultation, give the directions that are necessary in the circumstances` FALSE TRUE FALSE)
#ASSERT `s 3(3) directions under subsection (1) or (2) may include this provision` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 3(3) directions under subsection (1) or (2) may include this provision` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 3(3) directions under subsection (1) or (2) may include this provision` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 3(3) directions under subsection (1) or (2) may include this provision` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 3(4) the person must give immediate effect to the directions despite any other duty under this Act` TRUE
#ASSERT NOT (`s 3(4) the person must give immediate effect to the directions despite any other duty under this Act` FALSE)
#ASSERT `s 3(5) the person must not disclose the directions` TRUE
#ASSERT NOT (`s 3(5) the person must not disclose the directions` FALSE)
#ASSERT `s 3(6) the Minister may pay this compensation or make this grant` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 3(6) the Minister may pay this compensation or make this grant` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 3(6) the Minister may pay this compensation or make this grant` FALSE FALSE EQUALS NOTHING
#ASSERT `s 3(7) the sum is paid out of the Consolidated Fund` TRUE EQUALS JUST TRUE
#ASSERT `s 3(7) the sum is paid out of the Consolidated Fund` FALSE EQUALS NOTHING
#ASSERT `s 3(8) the section applies to it` TRUE FALSE
#ASSERT `s 3(8) the section applies to it` FALSE TRUE
#ASSERT NOT (`s 3(8) the section applies to it` FALSE FALSE)
#ASSERT `s 3(9) the Minister's certificate is conclusive evidence of the matters stated` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 3(9) the Minister's certificate is conclusive evidence of the matters stated` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 3(9) the Minister's certificate is conclusive evidence of the matters stated` FALSE TRUE EQUALS NOTHING
#ASSERT `s 4 the Authority is liable to the person for that injury, loss or damage` TRUE EQUALS JUST FALSE
#ASSERT `s 4 the Authority is liable to the person for that injury, loss or damage` FALSE EQUALS NOTHING

§ `ss 22 to 24`

#ASSERT `s 22 the Authority must have regard to the matter` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `s 22 the Authority must have regard to the matter` FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 22 the Authority must have regard to the matter` FALSE FALSE TRUE FALSE FALSE FALSE
