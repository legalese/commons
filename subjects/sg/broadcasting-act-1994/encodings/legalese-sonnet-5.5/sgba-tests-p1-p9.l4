#ASSERT NOT (`s 29(3) the Authority may consider the service unacceptable for the purposes of subsection (2)` FALSE)
#ASSERT `s 29(4) the service is a foreign broadcasting service` TRUE
#ASSERT `s 30(1) the service is a proscribed service` TRUE
