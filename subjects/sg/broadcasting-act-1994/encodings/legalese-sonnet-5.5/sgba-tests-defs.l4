IMPORT `sgba-p1-online`
IMPORT `sgba-p1-defs`

-- Tests for sgba-p1-defs.l4 (s 2(1), the defined terms), one group of assertions per entry. A "means" term is tested true and false;
-- an "includes" term is tested JUST TRUE for the listed thing and NOTHING for anything else (an inclusive definition never excludes).

§ `a point; access; Authority`

#ASSERT `s 2(1) a point includes this mobile or potentially mobile point, wherever it is` TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) a point includes this mobile or potentially mobile point, wherever it is` FALSE EQUALS NOTHING
#ASSERT `s 2(1) the person has access to the content` TRUE TRUE
#ASSERT NOT (`s 2(1) the person has access to the content` TRUE FALSE)
#ASSERT NOT (`s 2(1) the person has access to the content` FALSE TRUE)
#ASSERT `s 2(1) access includes this kind of access` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2(1) access includes this kind of access` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2(1) access includes this kind of access` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2(1) access includes this kind of access` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) access includes this kind of access` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 2(1) the body is the Authority` TRUE
#ASSERT NOT (`s 2(1) the body is the Authority` FALSE)

§ `broadcasting apparatus and its licences`

#ASSERT `s 2(1) the apparatus is broadcasting apparatus on` (Date 1 6 2025) (Apparatus WITH `capable of reception of a broadcasting service` IS TRUE, `capable of direct reception from a satellite` IS TRUE) EQUALS JUST TRUE
#ASSERT `s 2(1) the apparatus is broadcasting apparatus on` (Date 1 6 2025) (Apparatus WITH `capable of reception of a broadcasting service` IS TRUE, `capable of direct reception from a satellite` IS FALSE) EQUALS JUST FALSE
#ASSERT `s 2(1) the apparatus is broadcasting apparatus on` (Date 24 9 2024) (Apparatus WITH `capable of reception of a broadcasting service` IS TRUE, `capable of direct reception from a satellite` IS TRUE) EQUALS NOTHING
#ASSERT `s 2(1) the licence is a broadcasting apparatus licence` TRUE
#ASSERT NOT (`s 2(1) the licence is a broadcasting apparatus licence` FALSE)
#ASSERT `s 2(1) the person is a broadcasting apparatus licensee` TRUE
#ASSERT `s 2(1) the licence is a broadcasting licence` TRUE
#ASSERT `s 2(1) the person is a broadcasting licensee` TRUE
#ASSERT NOT (`s 2(1) the person is a broadcasting licensee` FALSE)

§ `broadcasting service`

-- argument order: signs or signals transmitted; visual programme; sound programme; combined programme; equipment appropriate for receiving
#ASSERT `s 2(1) the service is a broadcasting service` TRUE TRUE FALSE FALSE TRUE
#ASSERT `s 2(1) the service is a broadcasting service` TRUE FALSE TRUE FALSE TRUE
#ASSERT `s 2(1) the service is a broadcasting service` TRUE FALSE FALSE TRUE TRUE
#ASSERT NOT (`s 2(1) the service is a broadcasting service` TRUE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`s 2(1) the service is a broadcasting service` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 2(1) the service is a broadcasting service` TRUE TRUE TRUE TRUE FALSE)

§ `Chief Executive; class licence; class licensee; Code of Practice; communicate; content`

#ASSERT `s 2(1) the person is the Chief Executive in relation to the Authority` TRUE FALSE
#ASSERT `s 2(1) the person is the Chief Executive in relation to the Authority` FALSE TRUE
#ASSERT NOT (`s 2(1) the person is the Chief Executive in relation to the Authority` FALSE FALSE)
#ASSERT `s 2(1) the licence is a class licence` TRUE
#ASSERT NOT (`s 2(1) the licence is a class licence` FALSE)
#ASSERT `s 2(1) the person is a class licensee` TRUE
#ASSERT `s 2(1) the document is a Code of Practice` TRUE
#ASSERT NOT (`s 2(1) the document is a Code of Practice` FALSE)
#ASSERT `s 2(1) the person communicates the content` TRUE FALSE
#ASSERT `s 2(1) the person communicates the content` FALSE TRUE
#ASSERT NOT (`s 2(1) the person communicates the content` FALSE FALSE)
#ASSERT `s 2(1) the information or material is content, in whatever form (text, speech, music or other sounds, visual images, any other form, or any combination)` TRUE
#ASSERT NOT (`s 2(1) the information or material is content, in whatever form (text, speech, music or other sounds, visual images, any other form, or any combination)` FALSE)

§ `debenture; dwelling house; electronic service; encrypted; end-user; engage in conduct; entity`

#ASSERT `s 2(1) debenture includes this debenture stock` TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) debenture includes this debenture stock` FALSE EQUALS NOTHING
#ASSERT `s 2(1) dwelling house includes this establishment` TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) dwelling house includes this establishment` FALSE EQUALS NOTHING
#ASSERT `s 2(1) the service is an electronic service as section 2A(2) gives the meaning` TRUE
#ASSERT NOT (`s 2(1) the service is an electronic service as section 2A(2) gives the meaning` FALSE)
#ASSERT `s 2(1) the transmission is encrypted` TRUE
#ASSERT NOT (`s 2(1) the transmission is encrypted` FALSE)
#ASSERT `s 2(1) the person is an end-user of the electronic service` TRUE TRUE FALSE FALSE
#ASSERT `s 2(1) the person is an end-user of the electronic service` TRUE FALSE TRUE FALSE
#ASSERT NOT (`s 2(1) the person is an end-user of the electronic service` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 2(1) the person is an end-user of the electronic service` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`s 2(1) the person is an end-user of the electronic service` FALSE TRUE TRUE FALSE)
#ASSERT `s 2(1) the person engages in conduct, on a single occasion or on a number of occasions over a period of time` TRUE FALSE
#ASSERT `s 2(1) the person engages in conduct, on a single occasion or on a number of occasions over a period of time` FALSE TRUE
#ASSERT NOT (`s 2(1) the person engages in conduct, on a single occasion or on a number of occasions over a period of time` FALSE FALSE)
#ASSERT `s 2(1) the person is an entity` `a body corporate` FALSE FALSE
#ASSERT `s 2(1) the person is an entity` `an unincorporated association other than a partnership` FALSE FALSE
#ASSERT `s 2(1) the person is an entity` `a partnership` FALSE FALSE
#ASSERT `s 2(1) the person is an entity` `an individual` TRUE FALSE
#ASSERT `s 2(1) the person is an entity` `an individual` FALSE TRUE
#ASSERT NOT (`s 2(1) the person is an entity` `an individual` FALSE FALSE)

§ `excluded electronic service; free-to-air; internet access service; licence; licensable broadcasting service`

#ASSERT `s 2(1) the service is an excluded electronic service as section 2A(3) gives the meaning` TRUE
#ASSERT `s 2(1) the service is a free-to-air broadcasting service` TRUE 2 FALSE
#ASSERT `s 2(1) the service is a free-to-air broadcasting service` TRUE 9 FALSE
#ASSERT NOT (`s 2(1) the service is a free-to-air broadcasting service` TRUE 1 FALSE)
#ASSERT NOT (`s 2(1) the service is a free-to-air broadcasting service` TRUE 2 TRUE)
#ASSERT NOT (`s 2(1) the service is a free-to-air broadcasting service` FALSE 2 FALSE)
#ASSERT `s 2(1) the licence is a free-to-air licence` TRUE
#ASSERT `s 2(1) the service is an internet access service` TRUE TRUE FALSE TRUE FALSE FALSE
#ASSERT `s 2(1) the service is an internet access service` TRUE FALSE TRUE TRUE FALSE FALSE
#ASSERT NOT (`s 2(1) the service is an internet access service` TRUE TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 2(1) the service is an internet access service` TRUE TRUE FALSE TRUE TRUE FALSE)
#ASSERT NOT (`s 2(1) the service is an internet access service` TRUE TRUE FALSE TRUE FALSE TRUE)
#ASSERT NOT (`s 2(1) the service is an internet access service` FALSE TRUE FALSE TRUE FALSE FALSE)
#ASSERT `s 2(1) the licence is a licence` TRUE
#ASSERT `s 2(1) the broadcasting service is a licensable broadcasting service on` (Date 1 6 2025) (JUST `teletext services`) FALSE EQUALS JUST TRUE
#ASSERT `s 2(1) the broadcasting service is a licensable broadcasting service on` (Date 1 6 2025) (JUST `teletext services`) TRUE EQUALS JUST FALSE
#ASSERT `s 2(1) the broadcasting service is a licensable broadcasting service on` (Date 1 6 2025) NOTHING FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) the broadcasting service is a licensable broadcasting service on` (Date 24 9 2024) (JUST `teletext services`) FALSE EQUALS NOTHING

§ `member; online Code of Practice; online communication service; Part 10A regulations; programme; provider`

#ASSERT `s 2(1) the person is a member` TRUE
#ASSERT `s 2(1) the Code of Practice is an online Code of Practice` TRUE FALSE
#ASSERT `s 2(1) the Code of Practice is an online Code of Practice` FALSE TRUE
#ASSERT NOT (`s 2(1) the Code of Practice is an online Code of Practice` FALSE FALSE)
#ASSERT `s 2(1) the service is an online communication service as section 2A(1) gives the meaning` TRUE
#ASSERT `s 2(1) the regulations are Part 10A regulations` TRUE
-- argument order: primary purpose to entertain, educate or inform; advertising or sponsorship matter; wholly private communication; wholly internal communication; wholly prescribed circumstances
#ASSERT `s 2(1) the matter is a programme in relation to a broadcasting service` TRUE FALSE FALSE FALSE FALSE
#ASSERT `s 2(1) the matter is a programme in relation to a broadcasting service` FALSE TRUE FALSE FALSE FALSE
#ASSERT NOT (`s 2(1) the matter is a programme in relation to a broadcasting service` TRUE FALSE TRUE FALSE FALSE)
#ASSERT NOT (`s 2(1) the matter is a programme in relation to a broadcasting service` TRUE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`s 2(1) the matter is a programme in relation to a broadcasting service` TRUE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`s 2(1) the matter is a programme in relation to a broadcasting service` FALSE FALSE FALSE FALSE FALSE)
#ASSERT `s 2(1) the entity is the provider of the online communication service as section 2D gives the meaning` TRUE

§ `regulated online communication service; regulations; securities; shares; Singapore end-user; social media service; subscription`

#ASSERT `s 2(1) the service is a regulated online communication service` TRUE
#ASSERT NOT (`s 2(1) the service is a regulated online communication service` FALSE)
#ASSERT `s 2(1) the instrument is regulations` TRUE
#ASSERT `s 2(1) securities in relation to a company include this security` TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) securities in relation to a company include this security` FALSE EQUALS NOTHING
#ASSERT `s 2(1) the thing is shares in relation to the company` TRUE
#ASSERT NOT (`s 2(1) the thing is shares in relation to the company` FALSE)
#ASSERT `s 2(1) the end-user is a Singapore end-user of the service` TRUE TRUE FALSE FALSE
#ASSERT `s 2(1) the end-user is a Singapore end-user of the service` TRUE FALSE TRUE FALSE
#ASSERT `s 2(1) the end-user is a Singapore end-user of the service` TRUE FALSE FALSE TRUE
#ASSERT NOT (`s 2(1) the end-user is a Singapore end-user of the service` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`s 2(1) the end-user is a Singapore end-user of the service` FALSE TRUE TRUE TRUE)
#ASSERT `s 2(1) the service is a social media service as section 45T gives the meaning` TRUE
#ASSERT NOT (`s 2(1) the service is a social media service as section 45T gives the meaning` FALSE)
#ASSERT `s 2(1) the service is a subscription broadcasting service` TRUE TRUE
#ASSERT NOT (`s 2(1) the service is a subscription broadcasting service` TRUE FALSE)
#ASSERT NOT (`s 2(1) the service is a subscription broadcasting service` FALSE TRUE)
#ASSERT `s 2(1) the consideration is a subscription fee` TRUE
#ASSERT NOT (`s 2(1) the consideration is a subscription fee` FALSE)
