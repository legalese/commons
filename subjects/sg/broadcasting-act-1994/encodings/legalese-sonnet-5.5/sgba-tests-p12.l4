IMPORT prelude
IMPORT daydate
IMPORT `sgba-nouns`
IMPORT `sgba-vintage`
IMPORT `sgba-p12-misc`

-- Tests for sgba-p12-misc.l4 (ss 59 to 68). Expected values are written from the text of each section.

§ `s 59: appeal to the Minister`

#ASSERT `s 59(1) the person may appeal to the Minister` TRUE TRUE FALSE
#ASSERT `s 59(1) the person may appeal to the Minister` TRUE FALSE TRUE
#ASSERT NOT (`s 59(1) the person may appeal to the Minister` FALSE TRUE TRUE)
#ASSERT NOT (`s 59(1) the person may appeal to the Minister` TRUE FALSE FALSE)
#ASSERT `s 59(2) the decision, direction or other thing appealed against must be complied with` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 59(2) the decision, direction or other thing appealed against must be complied with` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 59(2) the decision, direction or other thing appealed against must be complied with` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 59(2) the decision, direction or other thing appealed against must be complied with` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 59(3) the Minister may confirm, vary or reverse a decision or direction of the Authority, or amend a Code of Practice` TRUE
#ASSERT `s 59(4) the Minister's decision is final` TRUE EQUALS JUST TRUE
#ASSERT `s 59(4) the Minister's decision is final` FALSE EQUALS NOTHING
#ASSERT `s 59(5) sections 45H, 45I, 45K, 45L(3) and (4) and 45N(1) apply as if the reference to the Authority in a limit were a reference to the Minister` TRUE EQUALS JUST TRUE
#ASSERT `s 59(5) sections 45H, 45I, 45K, 45L(3) and (4) and 45N(1) apply as if the reference to the Authority in a limit were a reference to the Minister` FALSE EQUALS NOTHING

§ `s 60: exemption`

#ASSERT `s 60(a) the class or description of shares or interests in shares is exempt from section 35 or 36 or both` TRUE
#ASSERT NOT (`s 60(a) the class or description of shares or interests in shares is exempt from section 35 or 36 or both` FALSE)
#ASSERT `s 60(b) the person is exempt from the provision of this Act or its subsidiary legislation the order names` TRUE TRUE
#ASSERT NOT (`s 60(b) the person is exempt from the provision of this Act or its subsidiary legislation the order names` TRUE FALSE)
#ASSERT NOT (`s 60(b) the person is exempt from the provision of this Act or its subsidiary legislation the order names` FALSE TRUE)

§ `ss 61 to 63`

#ASSERT `s 61(1) the equipment or facility may be subject to distress or taken under the process of a court` FALSE FALSE
#ASSERT `s 61(1) the equipment or facility may be subject to distress or taken under the process of a court` TRUE TRUE
#ASSERT `s 61(1) the equipment or facility may be subject to distress or taken under the process of a court` FALSE TRUE
#ASSERT NOT (`s 61(1) the equipment or facility may be subject to distress or taken under the process of a court` TRUE FALSE)
#ASSERT `s 61(2) section 61 applies to the licensee` FALSE
#ASSERT NOT (`s 61(2) section 61 applies to the licensee` TRUE)
#ASSERT `s 62 the Authority may enter into direct communication, arrangement and agreement with the lawfully constituted broadcasting authority of a country or a duly authorised international agency or organisation concerned with broadcasting` TRUE TRUE
#ASSERT NOT (`s 62 the Authority may enter into direct communication, arrangement and agreement with the lawfully constituted broadcasting authority of a country or a duly authorised international agency or organisation concerned with broadcasting` TRUE FALSE)
#ASSERT NOT (`s 63(1) the Government's right at any time to determine its relations with any country or international agency or organisation is abrogated` TRUE)
#ASSERT `s 63(2) the Authority or the licensee has discharged its responsibilities as the subsection requires` TRUE
#ASSERT NOT (`s 63(2) the Authority or the licensee has discharged its responsibilities as the subsection requires` FALSE)

§ `s 64: service of documents`

#ASSERT `s 64(1) the document may be served as section 64 describes` TRUE
#ASSERT `s 64 the document may be served in this way on this kind of person` `an individual` `give it personally to the individual, or to a partner, secretary or other similar officer, or manager`
#ASSERT `s 64 the document may be served in this way on this kind of person` `a partnership` `give it personally to the individual, or to a partner, secretary or other similar officer, or manager`
#ASSERT `s 64 the document may be served in this way on this kind of person` `a body corporate` `give it personally to the individual, or to a partner, secretary or other similar officer, or manager`
#ASSERT `s 64 the document may be served in this way on this kind of person` `an unincorporated association other than a partnership` `leave it at, or send it by prepaid registered post to, the address the section names`
#ASSERT `s 64 the document may be served in this way on this kind of person` `an individual` `leave it with an adult apparently resident or employed at the individual's address`
#ASSERT NOT (`s 64 the document may be served in this way on this kind of person` `a partnership` `leave it with an adult apparently resident or employed at the individual's address`)
#ASSERT NOT (`s 64 the document may be served in this way on this kind of person` `a body corporate` `leave it with an adult apparently resident or employed at the individual's address`)
#ASSERT `s 64 the document may be served in this way on this kind of person` `an individual` `affix a copy in a conspicuous place at the individual's address`
#ASSERT NOT (`s 64 the document may be served in this way on this kind of person` `a body corporate` `affix a copy in a conspicuous place at the individual's address`)
#ASSERT `s 64 the document may be served in this way on this kind of person` `a body corporate` `send it by fax`
#ASSERT `s 64 the document may be served in this way on this kind of person` `an individual` `send it by email`
#ASSERT `s 64 the document may be served in this way on this kind of person` `a partnership` `give an electronic notice by the addressee's chosen means of notification`
#ASSERT `s 64 the document may be served in this way on this kind of person` `an individual` `post it on the website the Minister prescribed`
#ASSERT `s 64 the document may be served in this way on this kind of person` `an individual` `use another method the regulations authorise, with the addressee's consent`
#ASSERT `s 64(5)(b) the document may be served by posting it on the website the Authority maintains and the Minister prescribed` TRUE
#ASSERT NOT (`s 64(5)(b) the document may be served by posting it on the website the Authority maintains and the Minister prescribed` FALSE)
-- s 64(6): fax and email take effect the day of transmission or retrievability; post two days after posting; the website the day after
#ASSERT `s 64(6) the day service takes effect` `send it by fax` (Date 10 3 2025) EQUALS JUST (Date 10 3 2025)
#ASSERT `s 64(6) the day service takes effect` `send it by email` (Date 10 3 2025) EQUALS JUST (Date 10 3 2025)
#ASSERT `s 64(6) the day service takes effect` `leave it at, or send it by prepaid registered post to, the address the section names` (Date 10 3 2025) EQUALS JUST (Date 12 3 2025)
#ASSERT `s 64(6) the day service takes effect` `leave it at, or send it by prepaid registered post to, the address the section names` (Date 30 12 2025) EQUALS JUST (Date 1 1 2026)
#ASSERT `s 64(6) the day service takes effect` `post it on the website the Minister prescribed` (Date 10 3 2025) EQUALS JUST (Date 11 3 2025)
#ASSERT `s 64(6) the day service takes effect` `give it personally to the individual, or to a partner, secretary or other similar officer, or manager` (Date 10 3 2025) EQUALS NOTHING
#ASSERT `s 64(7) service by email or by an electronic notice may be effected` TRUE
#ASSERT NOT (`s 64(7) service by email or by an electronic notice may be effected` FALSE)
#ASSERT `s 64(8) section 64 applies to the document` FALSE
#ASSERT NOT (`s 64(8) section 64 applies to the document` TRUE)
#ASSERT `s 64(9) Act includes this subsidiary legislation` TRUE EQUALS JUST TRUE
#ASSERT `s 64(9) Act includes this subsidiary legislation` FALSE EQUALS NOTHING
#ASSERT `s 64(9) the place is a business address` TRUE FALSE
#ASSERT `s 64(9) the place is a business address` FALSE TRUE
#ASSERT NOT (`s 64(9) the place is a business address` FALSE FALSE)
#ASSERT `s 64(9) the means is the chosen means of access` TRUE
#ASSERT `s 64(9) the means is the chosen means of notification` TRUE
#ASSERT `s 64(9) document includes this notice` TRUE EQUALS JUST TRUE
#ASSERT `s 64(9) document includes this notice` FALSE EQUALS NOTHING
#ASSERT `s 64(9) the address is the last email address` TRUE
#ASSERT `s 64(9) the place is a residential address` TRUE

§ `ss 64A to 68`

#ASSERT `s 64A the fine or penalty may be recovered by the Authority in a court as if it were a simple contract debt and must be paid into the Consolidated Fund` TRUE EQUALS JUST TRUE
#ASSERT `s 64A the fine or penalty may be recovered by the Authority in a court as if it were a simple contract debt and must be paid into the Consolidated Fund` FALSE EQUALS NOTHING
#ASSERT `s 65(1) the Schedule reads as amended` TRUE
#ASSERT NOT (`s 65(1) the Schedule reads as amended` FALSE)
#ASSERT `s 65(2) the notification may contain those provisions` TRUE
#ASSERT `s 66 the regulations are validly made under the section` TRUE TRUE FALSE
#ASSERT `s 66 the regulations are validly made under the section` TRUE FALSE TRUE
#ASSERT NOT (`s 66 the regulations are validly made under the section` FALSE TRUE TRUE)
#ASSERT NOT (`s 66 the regulations are validly made under the section` TRUE FALSE FALSE)
#ASSERT `s 68(1) the act continues valid and applicable as though done by the Authority` TRUE FALSE
#ASSERT NOT (`s 68(1) the act continues valid and applicable as though done by the Authority` TRUE TRUE)
#ASSERT NOT (`s 68(1) the act continues valid and applicable as though done by the Authority` FALSE FALSE)
#ASSERT `s 68(2) it is deemed to have been made, issued or granted by the Authority` TRUE FALSE
#ASSERT NOT (`s 68(2) it is deemed to have been made, issued or granted by the Authority` TRUE TRUE)
#ASSERT NOT (`s 68(2) it is deemed to have been made, issued or granted by the Authority` FALSE FALSE)
#ASSERT `s 68(3) the thing may be carried on and completed by or under the authority of the Authority` TRUE
#ASSERT `s 68(4) sections 49 to 53 of that Act continue in force and apply to the company as if Part XI had not been repealed` TRUE
#ASSERT `s 68(5) the company is a broadcasting successor company` TRUE
#ASSERT NOT (`s 68(5) the company is a broadcasting successor company` FALSE)
