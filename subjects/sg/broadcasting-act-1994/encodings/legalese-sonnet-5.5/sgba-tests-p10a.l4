#ASSERT `s 45E(4) it is presumed until the contrary is proved that the person knew the service provided access to that content and that the content was egregious content, at the time of the direction` TRUE FALSE EQUALS NOTHING
#ASSERT `s 45E(4) it is presumed until the contrary is proved that the person knew the service provided access to that content and that the content was egregious content, at the time of the direction` FALSE TRUE EQUALS NOTHING
#ASSERT `s 45F(1) the person commits an offence` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 45F(1) the person commits an offence` FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 45F(1) the person commits an offence` TRUE TRUE TRUE TRUE TRUE FALSE)
-- $20,000 for each day or part of a day, but not exceeding a total of $500,000
#ASSERT `s 45F(2) the most the person can be fined in total` 1 EQUALS 20000
#ASSERT `s 45F(2) the most the person can be fined in total` 25 EQUALS 500000
#ASSERT `s 45F(2) the most the person can be fined in total` 24 EQUALS 480000
#ASSERT `s 45F(2) the most the person can be fined in total` 26 EQUALS 500000
#ASSERT `s 45F(2) the most the person can be fined in total` 100 EQUALS 500000
#ASSERT NOT (`s 45F(3) it matters whether the service is provided from outside Singapore or in or from Singapore` TRUE)
#ASSERT `s 45F(4) it is presumed until the contrary is proved that the person knew that access was possible and that the content was egregious content, at the time of the direction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 45F(4) it is presumed until the contrary is proved that the person knew that access was possible and that the content was egregious content, at the time of the direction` TRUE FALSE EQUALS NOTHING
#ASSERT `s 45G the person has the defence` TRUE TRUE
#ASSERT NOT (`s 45G the person has the defence` TRUE FALSE)
#ASSERT NOT (`s 45G the person has the defence` FALSE TRUE)

