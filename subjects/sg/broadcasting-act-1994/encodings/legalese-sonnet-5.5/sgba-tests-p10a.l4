#ASSERT NOT (`s 45O(1) the notice is the notice the Authority must give before exercising its powers under section 45N(1)` TRUE FALSE TRUE 14)
#ASSERT NOT (`s 45O(1) the notice is the notice the Authority must give before exercising its powers under section 45N(1)` TRUE TRUE FALSE 14)
#ASSERT `s 45O(2) the Authority may decide to take the regulatory action in section 45N(1) it considers appropriate` TRUE
#ASSERT `s 45O(3) the Authority must serve a notice of its decision on the defaulting provider` TRUE
#ASSERT `s 45O(4) the date the decision takes effect` (Date 10 3 2025) NOTHING EQUALS (Date 10 3 2025)
#ASSERT `s 45O(4) the date the decision takes effect` (Date 10 3 2025) (JUST (Date 20 3 2025)) EQUALS (Date 20 3 2025)

