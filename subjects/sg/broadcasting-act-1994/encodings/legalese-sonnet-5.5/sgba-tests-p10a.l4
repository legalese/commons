§ `45E to 45G`

#ASSERT `s 45E(1) the person commits an offence` TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 45E(1) the person commits an offence` FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 45E(1) the person commits an offence` TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 45E(1) the person commits an offence` TRUE TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`s 45E(1) the person commits an offence` TRUE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 45E(1) the person commits an offence` TRUE TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`s 45E(1) the person commits an offence` TRUE TRUE TRUE TRUE TRUE FALSE)
#ASSERT `s 45E(2) the punishment on conviction`'s `fine not exceeding` EQUALS 1000000
#ASSERT `s 45E(2) the punishment on conviction`'s `imprisonment` EQUALS `no imprisonment is provided`
#ASSERT `s 45E(2) the punishment on conviction`'s `daily fine` EQUALS `a further fine not exceeding, per day or part of a day after conviction` 100000
#ASSERT NOT (`s 45E(3) it matters whether the service is provided from outside Singapore or in or from Singapore` TRUE)
