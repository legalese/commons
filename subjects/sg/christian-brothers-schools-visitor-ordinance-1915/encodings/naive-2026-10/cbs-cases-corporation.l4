§ `ss 2(1), 2(4) and 2(5)`

#ASSERT `is the Corporation` `Brother James himself`
#ASSERT `is the Corporation` `a successor approved, filed and gazetted`
#ASSERT NOT `is the Corporation` `a successor approved and filed but not yet gazetted`
#ASSERT NOT `is the Corporation` `a successor filed and gazetted without the Minister's approval`
#ASSERT NOT `is the Corporation` `a successor approved but whose instrument was never filed`
#ASSERT NOT `is the Corporation` `an appointed Visitor who has done nothing yet`

#ASSERT NOT `the Gazette is sufficient evidence of qualification` `Brother James himself`
#ASSERT `the Gazette is sufficient evidence of qualification` `a successor approved, filed and gazetted`
#ASSERT NOT `the Gazette is sufficient evidence of qualification` `a successor approved and filed but not yet gazetted`
#ASSERT `the Gazette is sufficient evidence of qualification` `a successor filed and gazetted without the Minister's approval`
#ASSERT NOT `the Gazette is sufficient evidence of qualification` `a successor approved but whose instrument was never filed`
#ASSERT NOT `the Gazette is sufficient evidence of qualification` `an appointed Visitor who has done nothing yet`

§ `s 2(2), (3)`

#ASSERT `the Ordinance empowers the Corporation to` `use and change its corporate seal` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `acquire or purchase property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `hold and enjoy property` TRUE
#ASSERT `the Ordinance empowers the Corporation to` `sell property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `mortgage property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `lease property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `transfer or otherwise dispose of property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sue or be sued` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `borrow money without security` TRUE

§ `s 3`

#ASSERT `is duly sealed` `a conveyance sealed before and signed by Brother James`
#ASSERT `is duly sealed` `a mortgage sealed before and signed by Byrne's deposited attorney`
#ASSERT `is duly sealed` `a lease sealed before and signed by a qualified successor`
#ASSERT `is duly sealed` `a deed sealed before a qualified successor and signed by his deposited attorney`
#ASSERT NOT `is duly sealed` `a deed sealed before and signed by a successor's deposited attorney`
#ASSERT NOT `is duly sealed` `a transfer sealed before and signed by an undeposited attorney`
#ASSERT NOT `is duly sealed` `a deed sealed before and signed by a successor not yet gazetted`
#ASSERT NOT `is duly sealed` `a deed sealed before a school Director and signed by Brother James`
#ASSERT NOT `is duly sealed` `a document signed by Brother James but never sealed`
#ASSERT NOT `is duly sealed` `a deed sealed before Brother James but signed by nobody`

#ASSERT `the signature is sufficient evidence of due sealing` `a deed sealed before and signed by a successor's deposited attorney`
#ASSERT NOT `the signature is sufficient evidence of due sealing` `a transfer sealed before and signed by an undeposited attorney`
#ASSERT `the signature is sufficient evidence of due sealing` `a deed sealed before a school Director and signed by Brother James`
#ASSERT NOT `the signature is sufficient evidence of due sealing` `a document signed by Brother James but never sealed`

§ `s 4`

#ASSERT `section 4 vests it in the Corporation` `school land in Singapore conveyed in 1905 to the Director of St Joseph's`
#ASSERT `section 4 vests it in the Corporation` `school land in Penang conveyed in 1890 to the Director of St Xavier's by name`
#ASSERT `section 4 vests it in the Corporation` `furniture and books held in 1910 by the Director of St Joseph's`
