IMPORT prelude
IMPORT daydate
IMPORT `sfa-seller`

-- Sale of Food Act 1973, from the seat of the food seller -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_sale-of-food-act-1973_baseline.py). Expected results were written by
-- hand from the text.

§ `s 2A -- is it food`

`a bowl of laksa` MEANS `The article` WITH
    `what it is` IS `something people eat or drink`
    `the Minister has declared it food by order` IS FALSE
    `the Minister has declared it not food by order` IS FALSE
    `it is fit for people to eat` IS TRUE

`mouldy bread` MEANS `The article` WITH
    `what it is` IS `something people eat or drink`
    `the Minister has declared it food by order` IS FALSE
    `the Minister has declared it not food by order` IS FALSE
    `it is fit for people to eat` IS FALSE

`live crabs` MEANS `The article` WITH
    `what it is` IS `a live animal or plant sold to be eaten`
    `the Minister has declared it food by order` IS FALSE
    `the Minister has declared it not food by order` IS FALSE
    `it is fit for people to eat` IS TRUE

`rice-paper wrapping` MEANS `The article` WITH
    `what it is` IS `edible packaging`
    `the Minister has declared it food by order` IS FALSE
    `the Minister has declared it not food by order` IS FALSE
    `it is fit for people to eat` IS TRUE

`cough syrup` MEANS `The article` WITH
    `what it is` IS `a medicinal product`
    `the Minister has declared it food by order` IS FALSE
    `the Minister has declared it not food by order` IS FALSE
    `it is fit for people to eat` IS TRUE

`a herbal drink declared not food` MEANS `The article` WITH
    `what it is` IS `something people eat or drink`
    `the Minister has declared it food by order` IS FALSE
    `the Minister has declared it not food by order` IS TRUE
    `it is fit for people to eat` IS TRUE

#ASSERT `Is what I sell food` `a bowl of laksa`
#ASSERT `Is what I sell food` `mouldy bread`
#ASSERT `Is what I sell food` `live crabs`
#ASSERT `Is what I sell food` `rice-paper wrapping`
#ASSERT NOT `Is what I sell food` `cough syrup`
#ASSERT NOT `Is what I sell food` `a herbal drink declared not food`

§ `ss 2B, 2F, 21 -- food business and licence`

`my hawker stall` MEANS `My activity` WITH
    `it involves handling food intended for sale` IS TRUE
    `it involves selling food` IS TRUE
    `it involves primary food production` IS FALSE
    `it only provides a place or service to food traders in a non-food business` IS FALSE
    `it consists only of hiring out marquees, tables and chairs` IS FALSE
    `it is declared not a food business by order` IS FALSE
    `it is charitable or happens only once` IS FALSE
    `its retail character` IS `wholly for a First Schedule purpose of the Environmental Public Health Act`
    `I hold a licence for it and operate in accordance with it` IS FALSE

`my central kitchen` MEANS `My activity` WITH
    `it involves handling food intended for sale` IS TRUE
    `it involves selling food` IS FALSE
    `it involves primary food production` IS FALSE
    `it only provides a place or service to food traders in a non-food business` IS FALSE
    `it consists only of hiring out marquees, tables and chairs` IS FALSE
    `it is declared not a food business by order` IS FALSE
    `it is charitable or happens only once` IS FALSE
    `its retail character` IS `not for any such purpose`
    `I hold a licence for it and operate in accordance with it` IS FALSE

`my licensed central kitchen` MEANS `My activity` WITH
    `it involves handling food intended for sale` IS TRUE
    `it involves selling food` IS FALSE
    `it involves primary food production` IS FALSE
    `it only provides a place or service to food traders in a non-food business` IS FALSE
    `it consists only of hiring out marquees, tables and chairs` IS FALSE
    `it is declared not a food business by order` IS FALSE
    `it is charitable or happens only once` IS FALSE
    `its retail character` IS `not for any such purpose`
    `I hold a licence for it and operate in accordance with it` IS TRUE

`my factory with a shopfront` MEANS `My activity` WITH
    `it involves handling food intended for sale` IS TRUE
    `it involves selling food` IS TRUE
    `it involves primary food production` IS FALSE
    `it only provides a place or service to food traders in a non-food business` IS FALSE
    `it consists only of hiring out marquees, tables and chairs` IS FALSE
    `it is declared not a food business by order` IS FALSE
    `it is charitable or happens only once` IS FALSE
    `its retail character` IS `partly for such a purpose and partly not`
    `I hold a licence for it and operate in accordance with it` IS FALSE

`my vegetable farm` MEANS `My activity` WITH
    `it involves handling food intended for sale` IS FALSE
    `it involves selling food` IS FALSE
    `it involves primary food production` IS TRUE
    `it only provides a place or service to food traders in a non-food business` IS FALSE
    `it consists only of hiring out marquees, tables and chairs` IS FALSE
    `it is declared not a food business by order` IS FALSE
    `it is charitable or happens only once` IS FALSE
    `its retail character` IS `not for any such purpose`
    `I hold a licence for it and operate in accordance with it` IS FALSE

`my online marketplace` MEANS `My activity` WITH
    `it involves handling food intended for sale` IS FALSE
    `it involves selling food` IS TRUE
    `it involves primary food production` IS FALSE
    `it only provides a place or service to food traders in a non-food business` IS TRUE
    `it consists only of hiring out marquees, tables and chairs` IS FALSE
    `it is declared not a food business by order` IS FALSE
    `it is charitable or happens only once` IS FALSE
    `its retail character` IS `not for any such purpose`
    `I hold a licence for it and operate in accordance with it` IS FALSE

`my one-off charity bake sale` MEANS `My activity` WITH
    `it involves handling food intended for sale` IS FALSE
    `it involves selling food` IS TRUE
    `it involves primary food production` IS FALSE
    `it only provides a place or service to food traders in a non-food business` IS FALSE
    `it consists only of hiring out marquees, tables and chairs` IS FALSE
    `it is declared not a food business by order` IS FALSE
    `it is charitable or happens only once` IS TRUE
    `its retail character` IS `wholly for a First Schedule purpose of the Environmental Public Health Act`
    `I hold a licence for it and operate in accordance with it` IS FALSE

