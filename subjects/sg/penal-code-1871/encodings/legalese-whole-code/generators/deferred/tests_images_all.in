#ASSERT `s 377BN(6)(a) the defence of marriage to a charge under section 377BG(1) or 377BH(1) is made out` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 377BN(6)(a) the defence of marriage to a charge under section 377BG(1) or 377BH(1) is made out` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE

