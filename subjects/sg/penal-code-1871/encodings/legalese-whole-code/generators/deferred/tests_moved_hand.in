#ASSERT `s 12 the group is the public` TRUE EQUALS JUST TRUE
-- "includes": a group that is neither a class of the public nor a community is not said to be outside the word
#ASSERT `s 12 the group is the public` FALSE EQUALS NOTHING
#ASSERT `s 17 the person is the Government` TRUE EQUALS JUST TRUE
#ASSERT `s 17 the person is the Government` FALSE EQUALS NOTHING

§§ `s 22A: "fault element" and "physical element"`

-- a state of mind, proof of which is needed to establish liability: a fault element
#ASSERT `s 22A the kind of element` TRUE TRUE EQUALS JUST `a fault element`
-- a fact (not a state of mind), proof of which is needed: a physical element
#ASSERT `s 22A the kind of element` FALSE TRUE EQUALS JUST `a physical element`
-- proof of it is not needed: neither
#ASSERT `s 22A the kind of element` TRUE FALSE EQUALS NOTHING
#ASSERT `s 22A the kind of element` FALSE FALSE EQUALS NOTHING

