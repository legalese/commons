-- Punishments written for these tests (the Code's records are used where the Code has one with the shape wanted).
-- Each is a made-up record for the boundary of 'twice the maximum term of imprisonment ... does not exceed 5 years', which is 30 months;
-- the section it stands for is none: the section is the string "test".

`a fine only` MEANS Punishment WITH
    section                  IS "test"
    words                    IS "fine only"
    death                    IS `not prescribed`
    `imprisonment for life`  IS `not prescribed`
    imprisonment             IS `not prescribed`
    `maximum term in months` IS NOTHING
    `minimum term in months` IS NOTHING
    `forfeiture of property` IS `not prescribed`
    fine                     IS `shall be punished with`
    `maximum fine`           IS NOTHING
    `minimum fine`           IS NOTHING
    caning                   IS `not prescribed`
    `minimum strokes`        IS NOTHING
    `maximum strokes`        IS NOTHING
    `or with both`           IS FALSE

`imprisonment up to 30 months` MEANS Punishment WITH
    section                  IS "test"
    words                    IS "imprisonment for a term which may extend to 30 months"
    death                    IS `not prescribed`
    `imprisonment for life`  IS `not prescribed`
    imprisonment             IS `shall be punished with`
    `maximum term in months` IS JUST 30
    `minimum term in months` IS NOTHING
    `forfeiture of property` IS `not prescribed`
    fine                     IS `not prescribed`
    `maximum fine`           IS NOTHING
    `minimum fine`           IS NOTHING
    caning                   IS `not prescribed`
    `minimum strokes`        IS NOTHING
    `maximum strokes`        IS NOTHING
    `or with both`           IS FALSE

`imprisonment up to 31 months` MEANS Punishment WITH
    section                  IS "test"
    words                    IS "imprisonment for a term which may extend to 31 months"
    death                    IS `not prescribed`
    `imprisonment for life`  IS `not prescribed`
    imprisonment             IS `shall be punished with`
    `maximum term in months` IS JUST 31
    `minimum term in months` IS NOTHING
    `forfeiture of property` IS `not prescribed`
    fine                     IS `not prescribed`
    `maximum fine`           IS NOTHING
    `minimum fine`           IS NOTHING
    caning                   IS `not prescribed`
    `minimum strokes`        IS NOTHING
    `maximum strokes`        IS NOTHING
    `or with both`           IS FALSE

`imprisonment of a stated kind but no stated maximum` MEANS Punishment WITH
    section                  IS "test"
    words                    IS "imprisonment"
    death                    IS `not prescribed`
    `imprisonment for life`  IS `not prescribed`
    imprisonment             IS `shall be punished with`
    `maximum term in months` IS NOTHING
    `minimum term in months` IS NOTHING
    `forfeiture of property` IS `not prescribed`
    fine                     IS `not prescribed`
    `maximum fine`           IS NOTHING
    `minimum fine`           IS NOTHING
    caning                   IS `not prescribed`
    `minimum strokes`        IS NOTHING
    `maximum strokes`        IS NOTHING
    `or with both`           IS FALSE

