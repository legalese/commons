
§§ `s 372`

-- s 372: selling minor for purposes of prostitution, etc.
-- @fixture `Selling Minor 372 via 1` OF `Selling Minor Facts`
-- S victim = "Lim Mei Ling"
-- S the manner = "by the act charged"
-- T the accused sells, lets to hire, or otherwise disposes of a person
-- T the person is below 21 years of age
-- T the accused intends that the person shall at any age be employed or used for the purpose of prostitution or illicit intercourse with any person or for any unlawful and immoral purpose
-- @end
#ASSERT `offence under s 372` `Selling Minor 372 via 1`
#ASSERT (`charge under s 372` `Selling Minor 372 via 1`)'s `made out`
#ASSERT (`charge under s 372` `Selling Minor 372 via 1`)'s section EQUALS "372"
#ASSERT (`charge under s 372` `Selling Minor 372 via 1`)'s offence EQUALS "selling minor for purposes of prostitution, etc."
#ASSERT (`charge under s 372` `Selling Minor 372 via 1`)'s punishment EQUALS "imprisonment for a term which may extend to 10 years, and shall also be liable to fine"
#ASSERT NOT ((`charge under s 372` `Selling Minor 372 via 1`)'s text EQUALS "")
#ASSERT (`charge under s 372` `Selling Minor 372 via 1`)'s refusal EQUALS ""
-- @fixture `Selling Minor 372 via 2` OF `Selling Minor Facts`
-- S victim = "Lim Mei Ling"
-- S the manner = "by the act charged"
-- T the accused sells, lets to hire, or otherwise disposes of a person
-- T the person is below 21 years of age
-- T the accused knows it to be likely that the person will at any age be employed or used for any such purpose
-- @end
#ASSERT `offence under s 372` `Selling Minor 372 via 2`
#ASSERT (`charge under s 372` `Selling Minor 372 via 2`)'s `made out`
#ASSERT (`charge under s 372` `Selling Minor 372 via 2`)'s section EQUALS "372"
#ASSERT (`charge under s 372` `Selling Minor 372 via 2`)'s offence EQUALS "selling minor for purposes of prostitution, etc."
#ASSERT (`charge under s 372` `Selling Minor 372 via 2`)'s punishment EQUALS "imprisonment for a term which may extend to 10 years, and shall also be liable to fine"
#ASSERT NOT ((`charge under s 372` `Selling Minor 372 via 2`)'s text EQUALS "")
#ASSERT (`charge under s 372` `Selling Minor 372 via 2`)'s refusal EQUALS ""
-- @fixture `Selling Minor 372 without element 1` OF `Selling Minor Facts`
-- S victim = "Lim Mei Ling"
-- S the manner = "by the act charged"
-- T the person is below 21 years of age
-- T the accused intends that the person shall at any age be employed or used for the purpose of prostitution or illicit intercourse with any person or for any unlawful and immoral purpose
-- @end
#ASSERT NOT (`offence under s 372` `Selling Minor 372 without element 1`)
#ASSERT NOT ((`charge under s 372` `Selling Minor 372 without element 1`)'s `made out`)
#ASSERT (`charge under s 372` `Selling Minor 372 without element 1`)'s text EQUALS ""
#ASSERT NOT ((`charge under s 372` `Selling Minor 372 without element 1`)'s refusal EQUALS "")
-- @fixture `Selling Minor 372 without element 2` OF `Selling Minor Facts`
-- S victim = "Lim Mei Ling"
-- S the manner = "by the act charged"
-- T the accused sells, lets to hire, or otherwise disposes of a person
-- T the person is below 21 years of age
-- @end
#ASSERT NOT (`offence under s 372` `Selling Minor 372 without element 2`)
#ASSERT NOT ((`charge under s 372` `Selling Minor 372 without element 2`)'s `made out`)
#ASSERT (`charge under s 372` `Selling Minor 372 without element 2`)'s text EQUALS ""
#ASSERT NOT ((`charge under s 372` `Selling Minor 372 without element 2`)'s refusal EQUALS "")
-- @fixture `Selling Minor 372 nothing established` OF `Selling Minor Facts`
-- S victim = "Lim Mei Ling"
-- S the manner = "by the act charged"
-- @end
#ASSERT NOT (`offence under s 372` `Selling Minor 372 nothing established`)
#ASSERT NOT ((`charge under s 372` `Selling Minor 372 nothing established`)'s `made out`)

