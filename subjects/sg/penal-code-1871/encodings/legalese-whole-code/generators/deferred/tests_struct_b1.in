§§ `s 373A`

-- s 373A: importing woman for purposes of prostitution, etc.
-- @fixture `Importing Woman 373A via 1` OF `Importing Woman Facts`
-- S victim = "Lim Mei Ling"
-- S the manner = "by the act charged"
-- T the accused by any false pretence, false representation, or fraudulent or deceitful means brings, or assists in bringing, into Singapore a woman
-- T the accused intends that the woman may be employed or used for the purpose of prostitution
-- @end
#ASSERT `offence under s 373A` `Importing Woman 373A via 1`
#ASSERT (`charge under s 373A` `Importing Woman 373A via 1`)'s `made out`
#ASSERT (`charge under s 373A` `Importing Woman 373A via 1`)'s section EQUALS "373A"
