IMPORT prelude
IMPORT daydate
IMPORT `ma-units`

-- Metrication Act 1970, ss 2, 3, 4, 5, 7 and the four Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_metrication-act-1970_baseline.py). Expected results were written by
-- hand from the text.

§ `Schedules -- row counts as printed`

#ASSERT count `the First Schedule` EQUALS 6
#ASSERT count `the Second Schedule` EQUALS 15
#ASSERT count `the Fourth Schedule` EQUALS 4
#ASSERT count `the Third Schedule` EQUALS 7

§ `ss 2 and 3(2) -- is my unit SI, and in which Schedule`

#ASSERT `What role does my unit play in the International System of Units` metre FALSE EQUALS `a basic unit (First Schedule)`
#ASSERT `What role does my unit play in the International System of Units` candela FALSE EQUALS `a basic unit (First Schedule)`
#ASSERT `What role does my unit play in the International System of Units` metre TRUE EQUALS `a basic unit (First Schedule)`
#ASSERT `What role does my unit play in the International System of Units` hertz FALSE EQUALS `a supplementary or derived unit (Second Schedule)`
#ASSERT `What role does my unit play in the International System of Units` steradian FALSE EQUALS `a supplementary or derived unit (Second Schedule)`
#ASSERT `What role does my unit play in the International System of Units` hectare FALSE EQUALS `a unit used in conjunction with them (Fourth Schedule)`
#ASSERT `What role does my unit play in the International System of Units` hectare TRUE EQUALS `not a unit of the International System of Units`
#ASSERT `What role does my unit play in the International System of Units` yard FALSE EQUALS `not a unit of the International System of Units`
#ASSERT `What role does my unit play in the International System of Units` tahil FALSE EQUALS `not a unit of the International System of Units`
#ASSERT `What role does my unit play in the International System of Units` foot FALSE EQUALS `not a unit of the International System of Units`

#ASSERT `Is my unit a unit of the International System of Units` litre FALSE
#ASSERT NOT `Is my unit a unit of the International System of Units` litre TRUE
#ASSERT NOT `Is my unit a unit of the International System of Units` kati FALSE
#ASSERT `Is my unit a unit of the International System of Units` kelvin TRUE

#ASSERT `What is the symbol of my unit` ohm EQUALS JUST "Ω"
#ASSERT `What is the symbol of my unit` `centigrade or Celsius` EQUALS JUST "°C"
#ASSERT `What is the symbol of my unit` yard EQUALS NOTHING

#ASSERT `What quantity does my unit measure` farad EQUALS JUST "electric capacitance"
#ASSERT `What quantity does my unit measure` kelvin EQUALS JUST "thermodynamic temperature"
#ASSERT `What quantity does my unit measure` foot EQUALS NOTHING

#ASSERT `Is the abbreviation SI a legal reference to the International System of Units`

§ `ss 3(1) and 7(2) -- legal force of my use`

#ASSERT `Does my use of this unit have legal force` metre FALSE (Date 15 2 1971) FALSE EQUALS `it has legal force and validity under s 3(1)`
#ASSERT `Does my use of this unit have legal force` metre FALSE (Date 14 2 1971) FALSE EQUALS `this Act gives it no legal force`
#ASSERT `Does my use of this unit have legal force` metre FALSE (Date 14 2 1971) TRUE EQUALS `its force under another lawful system is untouched by this Act (s 7(2))`
#ASSERT `Does my use of this unit have legal force` yard FALSE (Date 1 1 2020) TRUE EQUALS `its force under another lawful system is untouched by this Act (s 7(2))`
#ASSERT `Does my use of this unit have legal force` kati FALSE (Date 1 1 2020) FALSE EQUALS `this Act gives it no legal force`
#ASSERT `Does my use of this unit have legal force` litre FALSE (Date 1 1 2020) FALSE EQUALS `it has legal force and validity under s 3(1)`
#ASSERT `Does my use of this unit have legal force` litre TRUE (Date 1 1 2020) FALSE EQUALS `this Act gives it no legal force`

§ `s 5 and Third Schedule -- my measurement in SI units`

#ASSERT `What is my measurement in SI units` 5 yard EQUALS JUST 4.572
#ASSERT `What is my measurement in SI units` 10 pound EQUALS JUST 4.5359237
#ASSERT `What is my measurement in SI units` 2 gallon EQUALS JUST 9.09218
#ASSERT `What is my measurement in SI units` 16 tahil EQUALS JUST 604.789824
#ASSERT `What is my measurement in SI units` 1 kati EQUALS JUST 0.604790
#ASSERT `What is my measurement in SI units` 10 chhun EQUALS JUST 374.65
#ASSERT `What is my measurement in SI units` 3 foot EQUALS NOTHING
#ASSERT `What is my measurement in SI units` 7 metre EQUALS NOTHING

#ASSERT `In which SI unit is my converted measurement` gallon EQUALS JUST "litres (or cubic decimetres)"
#ASSERT `In which SI unit is my converted measurement` chhun EQUALS JUST "millimetres"

#ASSERT `Is the conversion of my unit exact` yard EQUALS JUST TRUE
#ASSERT `Is the conversion of my unit exact` gallon EQUALS JUST FALSE
#ASSERT `Is the conversion of my unit exact` chhek EQUALS JUST TRUE
#ASSERT `Is the conversion of my unit exact` foot EQUALS NOTHING

#ASSERT `Under which limb of s 5 may my unit be converted` pound EQUALS `(a) an imperial standard`
#ASSERT `Under which limb of s 5 may my unit be converted` kati EQUALS `(b) the local customary system of weights and measures`
#ASSERT `Under which limb of s 5 may my unit be converted` foot EQUALS `neither: the Third Schedule does not list this unit`

§ `s 4 -- an order converting my written law`

#ASSERT `Is the order converting my written law one s 4 allows` TRUE TRUE FALSE TRUE
#ASSERT `Is the order converting my written law one s 4 allows` TRUE FALSE TRUE TRUE
#ASSERT NOT `Is the order converting my written law one s 4 allows` TRUE FALSE FALSE TRUE
#ASSERT NOT `Is the order converting my written law one s 4 allows` TRUE TRUE FALSE FALSE

§ `s 7(1) -- a challenge on the unit alone`

#ASSERT `Can what I did be challenged only because of the unit I used` TRUE TRUE (Date 1 6 1975) (JUST (Date 1 1 1980)) EQUALS `s 7(1) bars that challenge`
#ASSERT `Can what I did be challenged only because of the unit I used` TRUE TRUE (Date 1 1 1980) (JUST (Date 1 1 1980)) EQUALS `s 7(1) does not bar that challenge`
#ASSERT `Can what I did be challenged only because of the unit I used` TRUE TRUE (Date 2 1 1980) (JUST (Date 1 1 1980)) EQUALS `s 7(1) does not bar that challenge`
#ASSERT `Can what I did be challenged only because of the unit I used` TRUE FALSE (Date 1 6 1975) (JUST (Date 1 1 1980)) EQUALS `s 7(1) does not bar that challenge`
#ASSERT `Can what I did be challenged only because of the unit I used` FALSE TRUE (Date 1 6 1975) (JUST (Date 1 1 1980)) EQUALS `s 7(1) does not bar that challenge`
#ASSERT `Can what I did be challenged only because of the unit I used` TRUE TRUE (Date 1 6 1975) NOTHING EQUALS `not covered by this encoding: no s 4 order date given`

