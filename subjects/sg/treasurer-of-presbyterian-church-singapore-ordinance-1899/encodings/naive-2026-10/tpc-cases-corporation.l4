IMPORT prelude
IMPORT `tpc-corporation`

-- Treasurer of Presbyterian Church, Singapore Ordinance 1899, ss 2-8 and the Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_treasurer-of-presbyterian-church-singapore-ordinance-1899.py). Expected results were written by
-- hand from the text.

`a Treasurer appointed, certified, filed and gazetted` MEANS Treasurer WITH
    `is appointed Treasurer by the Board of Managers` IS TRUE
    `the extract of minutes is certified by the Chairman` IS TRUE
    `the certified extract is filed` IS TRUE
    `notification of the filing has appeared in the Gazette` IS TRUE

`a Treasurer appointed, certified and filed but not yet gazetted` MEANS Treasurer WITH
    `is appointed Treasurer by the Board of Managers` IS TRUE
    `the extract of minutes is certified by the Chairman` IS TRUE
    `the certified extract is filed` IS TRUE
    `notification of the filing has appeared in the Gazette` IS FALSE

`a Treasurer whose extract was never certified by the Chairman` MEANS Treasurer WITH
    `is appointed Treasurer by the Board of Managers` IS TRUE
    `the extract of minutes is certified by the Chairman` IS FALSE
    `the certified extract is filed` IS TRUE
    `notification of the filing has appeared in the Gazette` IS TRUE

`a person gazetted who was never appointed by the Board` MEANS Treasurer WITH
    `is appointed Treasurer by the Board of Managers` IS FALSE
    `the extract of minutes is certified by the Chairman` IS TRUE
    `the certified extract is filed` IS TRUE
    `notification of the filing has appeared in the Gazette` IS TRUE

`a lease sealed before and signed by the Treasurer` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the duly qualified Treasurer`
    `signed by` IS `the duly qualified Treasurer`

`a transfer sealed before and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney of the Treasurer under a deposited power of attorney`
    `signed by` IS `an attorney of the Treasurer under a deposited power of attorney`

`a mortgage sealed before the Treasurer and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the duly qualified Treasurer`
    `signed by` IS `an attorney of the Treasurer under a deposited power of attorney`

`a conveyance sealed before and signed by an undeposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney whose power of attorney is not deposited`
    `signed by` IS `an attorney whose power of attorney is not deposited`

`a deed sealed before the Chairman and signed by the Treasurer` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Chairman of the Board of Managers`
    `signed by` IS `the duly qualified Treasurer`

`a deed sealed before and signed by a Treasurer not yet gazetted` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a Treasurer appointed but not yet gazetted`
    `signed by` IS `a Treasurer appointed but not yet gazetted`

`a document signed by the Treasurer but never sealed` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS FALSE
    `sealed in the presence of` IS `the duly qualified Treasurer`
    `signed by` IS `the duly qualified Treasurer`

§ `ss 2(1) and 4`

#ASSERT `is the Corporation` `a Treasurer appointed, certified, filed and gazetted`
#ASSERT NOT `is the Corporation` `a Treasurer appointed, certified and filed but not yet gazetted`
#ASSERT NOT `is the Corporation` `a Treasurer whose extract was never certified by the Chairman`
#ASSERT NOT `is the Corporation` `a person gazetted who was never appointed by the Board`

#ASSERT `the Gazette is sufficient evidence of qualification` `a Treasurer appointed, certified, filed and gazetted`
#ASSERT NOT `the Gazette is sufficient evidence of qualification` `a Treasurer appointed, certified and filed but not yet gazetted`
#ASSERT `the Gazette is sufficient evidence of qualification` `a Treasurer whose extract was never certified by the Chairman`
#ASSERT `the Gazette is sufficient evidence of qualification` `a person gazetted who was never appointed by the Board`

§ `s 2(2), (3)`

#ASSERT `the Ordinance empowers the Corporation to` `break, change or make anew its seal` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `acquire or purchase property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `sell property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell property` FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `mortgage property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `demise property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `surrender property` FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sue or be sued` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `borrow money without security` TRUE

