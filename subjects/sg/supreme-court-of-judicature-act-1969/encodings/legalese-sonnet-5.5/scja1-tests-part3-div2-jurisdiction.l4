IMPORT prelude
IMPORT daydate
IMPORT `scja-core`
IMPORT `scja1-part3-div2-jurisdiction`

-- Tests for scja1-part3-div2-jurisdiction.l4 (ss 15, 16, 17, 17A). Expected values are written from the text (SCJA1969.txt lines 994-1227), not from the code.

§ `Fixtures`

`a citizen of Singapore` MEANS Person OF "citizen", EMPTY, FALSE, TRUE
`a foreigner` MEANS Person OF "foreigner", EMPTY, FALSE, FALSE

-- the six paragraphs of s 15(1), in order: (a) within Singapore, (b) ship or aircraft registered in Singapore, (c) high seas or an aircraft, (d) piracy, (e) Hijacking / Maritime Offences Act, (f) written law
`an offence within Singapore` MEANS `s 15(1) offence` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`an offence on a Singapore-registered ship` MEANS `s 15(1) offence` OF FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`an offence on the high seas` MEANS `s 15(1) offence` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`an act of piracy by the law of nations` MEANS `s 15(1) offence` OF FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
`an offence under the Hijacking or Maritime Offences Acts` MEANS `s 15(1) offence` OF FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
`an offence a written law makes triable in Singapore` MEANS `s 15(1) offence` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
`an offence under none of the paragraphs` MEANS `s 15(1) offence` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

§§ `s 15: criminal jurisdiction`

#ASSERT (`s 15(1) the General Division has jurisdiction to try the offence` `an offence within Singapore` `a foreigner`) EQUALS JUST TRUE
#ASSERT (`s 15(1) the General Division has jurisdiction to try the offence` `an offence on a Singapore-registered ship` `a foreigner`) EQUALS JUST TRUE
#ASSERT (`s 15(1) the General Division has jurisdiction to try the offence` `an offence on the high seas` `a citizen of Singapore`) EQUALS JUST TRUE
-- (c) needs a citizen of Singapore: a foreigner's offence on the high seas is not under (c)
#ASSERT (`s 15(1) the General Division has jurisdiction to try the offence` `an offence on the high seas` `a foreigner`) EQUALS NOTHING
#ASSERT (`s 15(1) the General Division has jurisdiction to try the offence` `an act of piracy by the law of nations` `a foreigner`) EQUALS JUST TRUE
#ASSERT (`s 15(1) the General Division has jurisdiction to try the offence` `an offence under the Hijacking or Maritime Offences Acts` `a foreigner`) EQUALS JUST TRUE
#ASSERT (`s 15(1) the General Division has jurisdiction to try the offence` `an offence a written law makes triable in Singapore` `a foreigner`) EQUALS JUST TRUE
#ASSERT (`s 15(1) the General Division has jurisdiction to try the offence` `an offence under none of the paragraphs` `a citizen of Singapore`) EQUALS NOTHING
#ASSERT (`s 15(2) the General Division may pass the sentence` TRUE) EQUALS JUST TRUE
#ASSERT (`s 15(2) the General Division may pass the sentence` FALSE) EQUALS NOTHING

§§ `s 16: civil jurisdiction -- general`

-- order of inputs: in personam, served in Singapore, served outside Singapore, submits
#ASSERT (`s 16(1) the General Division has jurisdiction to hear and try the action in personam` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 16(1) the General Division has jurisdiction to hear and try the action in personam` TRUE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 16(1) the General Division has jurisdiction to hear and try the action in personam` TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
-- "where" neither service nor submission: the subsection gives no jurisdiction
#ASSERT (`s 16(1) the General Division has jurisdiction to hear and try the action in personam` TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- not an action in personam
#ASSERT (`s 16(1) the General Division has jurisdiction to hear and try the action in personam` FALSE TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 16(2) the General Division has the jurisdiction vested in it by another written law` TRUE) EQUALS JUST TRUE
#ASSERT (`s 16(2) the General Division has the jurisdiction vested in it by another written law` FALSE) EQUALS NOTHING

§§ `s 17: civil jurisdiction -- specific`

#ASSERT (`s 17(1) the civil jurisdiction of the General Division includes the subject` `divorce and matrimonial causes` FALSE) EQUALS JUST TRUE
#ASSERT (`s 17(1) the civil jurisdiction of the General Division includes the subject` `admiralty or shipping` FALSE) EQUALS JUST TRUE
#ASSERT (`s 17(1) the civil jurisdiction of the General Division includes the subject` bankruptcy FALSE) EQUALS JUST TRUE
#ASSERT (`s 17(1) the civil jurisdiction of the General Division includes the subject` companies FALSE) EQUALS JUST TRUE
#ASSERT (`s 17(1) the civil jurisdiction of the General Division includes the subject` `guardianship of infants` FALSE) EQUALS JUST TRUE
#ASSERT (`s 17(1) the civil jurisdiction of the General Division includes the subject` `guardianship of mentally disordered persons or persons of unsound mind` FALSE) EQUALS JUST TRUE
#ASSERT (`s 17(1) the civil jurisdiction of the General Division includes the subject` `probate or letters of administration` FALSE) EQUALS JUST TRUE
#ASSERT (`s 17(1) the civil jurisdiction of the General Division includes the subject` `an international settlement agreement under the Singapore Convention on Mediation Act 2020` FALSE) EQUALS JUST TRUE
-- (g): only for a dispute for which no proceedings have been commenced in a court
#ASSERT (`s 17(1) the civil jurisdiction of the General Division includes the subject` `recording a mediated settlement agreement under the Mediation Act 2017` TRUE) EQUALS JUST TRUE
#ASSERT (`s 17(1) the civil jurisdiction of the General Division includes the subject` `recording a mediated settlement agreement under the Mediation Act 2017` FALSE) EQUALS NOTHING
-- "includes": other subjects are not decided by this paragraph list
#ASSERT (`s 17(1) the civil jurisdiction of the General Division includes the subject` `patents` FALSE) EQUALS NOTHING
#ASSERT (`s 17(1) the civil jurisdiction of the General Division includes the subject` `any other civil matter` TRUE) EQUALS NOTHING

#ASSERT (`s 17(2) international settlement agreement: it has the meaning given by section 2(1) of the Singapore Convention on Mediation Act 2020` TRUE) EQUALS JUST TRUE
#ASSERT (`s 17(2) international settlement agreement: it has the meaning given by section 2(1) of the Singapore Convention on Mediation Act 2020` FALSE) EQUALS JUST FALSE
#ASSERT (`s 17(2) mediated settlement agreement: it has the meaning given by the Mediation Act 2017` TRUE) EQUALS JUST TRUE
#ASSERT (`s 17(2) mediated settlement agreement: it has the meaning given by the Mediation Act 2017` FALSE) EQUALS JUST FALSE
#ASSERT (`s 17(2) mediation: it has the meaning given by the Mediation Act 2017` TRUE) EQUALS JUST TRUE
#ASSERT (`s 17(2) mediation: it has the meaning given by the Mediation Act 2017` FALSE) EQUALS JUST FALSE

§§ `s 17A(1), (2): the Syariah Court carve-out`

-- (1): JUST TRUE means "the General Division has no jurisdiction"
#ASSERT (`s 17A(1) the General Division has no jurisdiction to hear and try the civil proceedings` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 17A(1) the General Division has no jurisdiction to hear and try the civil proceedings` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 17A(1) the General Division has no jurisdiction to hear and try the civil proceedings` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 17A(1) the General Division has no jurisdiction to hear and try the civil proceedings` FALSE TRUE TRUE) EQUALS NOTHING
-- (2): maintenance, custody, property on divorce, where a written law vests the jurisdiction
#ASSERT (`s 17A(2) the General Division has the jurisdiction vested in it by written law over the civil proceedings` `maintenance for a wife or child` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 17A(2) the General Division has the jurisdiction vested in it by written law over the civil proceedings` `custody of a child` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 17A(2) the General Division has the jurisdiction vested in it by written law over the civil proceedings` `disposition or division of property on divorce` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 17A(2) the General Division has the jurisdiction vested in it by written law over the civil proceedings` `custody of a child` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 17A(2) the General Division has the jurisdiction vested in it by written law over the civil proceedings` `custody of a child` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 17A(2) the General Division has the jurisdiction vested in it by written law over the civil proceedings` `patents` TRUE TRUE) EQUALS NOTHING

§§ `s 17A(3), (3A), (4), (5), (6): the stay`

-- (3A): a registered divorce counts only if registered before 1 March 2009
#ASSERT (`s 17A(3A) the registration of the divorce counts for section 17A(3)` (Date 28 2 2009)) EQUALS JUST TRUE
#ASSERT (`s 17A(3A) the registration of the divorce counts for section 17A(3)` (Date 1 3 2009)) EQUALS JUST FALSE
#ASSERT (`s 17A(3A) the registration of the divorce counts for section 17A(3)` (Date 2 3 2009)) EQUALS JUST FALSE
-- (4): the same day: the Syariah Court proceedings are deemed commenced first
#ASSERT (`s 17A(4) the Syariah Court proceedings are deemed to have been commenced before the civil proceedings` (Date 10 6 2024) (Date 10 6 2024)) EQUALS JUST TRUE
#ASSERT (`s 17A(4) the Syariah Court proceedings are deemed to have been commenced before the civil proceedings` (Date 10 6 2024) (Date 9 6 2024)) EQUALS JUST TRUE
#ASSERT (`s 17A(4) the Syariah Court proceedings are deemed to have been commenced before the civil proceedings` (Date 10 6 2024) (Date 11 6 2024)) EQUALS JUST FALSE

-- A proceeding: subject, all parties Muslims, married under Muslim law, civil proceedings commenced on, Syariah divorce proceedings commenced on, decree made on,
-- divorce registered on, commencement certificate filed, continuation certificate filed, commenced by consent with attendance certificates, continued by consent with attendance certificates.
GIVEN m IS A `Subject of the case`
      muslims IS A BOOLEAN
      married IS A BOOLEAN
      civil IS A DATE
      sc IS A MAYBE DATE
      decree IS A MAYBE DATE
      reg IS A MAYBE DATE
      cc IS A BOOLEAN
      ct IS A BOOLEAN
      consentStart IS A BOOLEAN
      consentCont IS A BOOLEAN
GIVETH A `s 17A civil proceedings`
`a proceeding` MEANS `s 17A civil proceedings` OF m, muslims, married, civil, sc, decree, reg, cc, ct, consentStart, consentCont

`the civil day` MEANS Date 10 6 2024

-- (a): Syariah divorce proceedings commenced before (1 June), the same day (10 June), after (20 June)
#ASSERT `s 17A(3)(a) a Syariah Court divorce event precedes or coincides with the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 1 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE)
#ASSERT `s 17A(3)(a) a Syariah Court divorce event precedes or coincides with the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 10 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 17A(3)(a) a Syariah Court divorce event precedes or coincides with the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 20 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE))
-- (a): a decree or order made before (9 June) counts; one made the same day does not ("after the making of a decree")
#ASSERT `s 17A(3)(a) a Syariah Court divorce event precedes or coincides with the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` NOTHING (JUST (Date 9 6 2024)) NOTHING FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 17A(3)(a) a Syariah Court divorce event precedes or coincides with the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` NOTHING (JUST (Date 10 6 2024)) NOTHING FALSE FALSE FALSE FALSE))
-- (a): a registered divorce on or before the civil day counts only if registered before 1 March 2009
#ASSERT `s 17A(3)(a) a Syariah Court divorce event precedes or coincides with the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` NOTHING NOTHING (JUST (Date 28 2 2009)) FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 17A(3)(a) a Syariah Court divorce event precedes or coincides with the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` NOTHING NOTHING (JUST (Date 1 3 2009)) FALSE FALSE FALSE FALSE))
-- (b): an event after the civil day (20 June) counts; the same day does not
#ASSERT `s 17A(3)(b) a Syariah Court divorce event follows the commencement of the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 20 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 17A(3)(b) a Syariah Court divorce event follows the commencement of the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 10 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE))
#ASSERT `s 17A(3)(b) a Syariah Court divorce event follows the commencement of the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` NOTHING (JUST (Date 11 6 2024)) NOTHING FALSE FALSE FALSE FALSE)
#ASSERT NOT (`s 17A(3)(b) a Syariah Court divorce event follows the commencement of the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` NOTHING NOTHING NOTHING FALSE FALSE FALSE FALSE))

-- (3) as a whole.
-- custody; Syariah divorce proceedings began 1 June, before the civil proceedings of 10 June, no commencement certificate: stayed
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 1 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE)) EQUALS JUST TRUE
-- same, but the Syariah Court commencement certificate has been filed: "unless" met, not stayed
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 1 6 2024)) NOTHING NOTHING TRUE FALSE FALSE FALSE)) EQUALS JUST FALSE
-- same day: deemed before, so stayed
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 10 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE)) EQUALS JUST TRUE
-- (b): Syariah divorce proceedings begin after the civil proceedings, custody, no continuation certificate: stayed
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 20 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE)) EQUALS JUST TRUE
-- (b) with a continuation certificate filed: not stayed
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 20 6 2024)) NOTHING NOTHING FALSE TRUE FALSE FALSE)) EQUALS JUST FALSE
-- (b) is for the matter in s 17A(2)(b) (custody) only: a property proceeding with a later Syariah event is not stayed under (b)
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `disposition or division of property on divorce` TRUE FALSE `the civil day` (JUST (Date 20 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE)) EQUALS JUST FALSE
-- (a) property: decree made before: stayed; with the (5) consent exception: not stayed
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `disposition or division of property on divorce` FALSE TRUE `the civil day` NOTHING (JUST (Date 1 6 2024)) NOTHING FALSE FALSE FALSE FALSE)) EQUALS JUST TRUE
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `disposition or division of property on divorce` FALSE TRUE `the civil day` NOTHING (JUST (Date 1 6 2024)) NOTHING FALSE FALSE TRUE FALSE)) EQUALS JUST FALSE
-- (6): the (b) exception for proceedings continued by consent
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 20 6 2024)) NOTHING NOTHING FALSE FALSE FALSE TRUE)) EQUALS JUST FALSE
-- a divorce registered on or after 1 March 2009 does not count (3A): not stayed
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `disposition or division of property on divorce` TRUE FALSE `the civil day` NOTHING NOTHING (JUST (Date 1 3 2009)) FALSE FALSE FALSE FALSE)) EQUALS JUST FALSE
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `disposition or division of property on divorce` TRUE FALSE `the civil day` NOTHING NOTHING (JUST (Date 28 2 2009)) FALSE FALSE FALSE FALSE)) EQUALS JUST TRUE
-- no event in the Syariah Court at all: not stayed
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` NOTHING NOTHING NOTHING FALSE FALSE FALSE FALSE)) EQUALS JUST FALSE
-- parties who are neither Muslims nor married under the Muslim law: "Where" is not met
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `custody of a child` FALSE FALSE `the civil day` (JUST (Date 1 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE)) EQUALS JUST FALSE
-- parties married under the Muslim law (not both Muslims): within the stay
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `custody of a child` FALSE TRUE `the civil day` (JUST (Date 1 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE)) EQUALS JUST TRUE
-- maintenance is not a matter in (2)(b) or (c): "Where" the proceedings involve a matter in (2)(b) or (c) is not met, so the text's no, like the parties limb (fork F8)
#ASSERT (`s 17A(3) the General Division is to stay the civil proceedings` (`a proceeding` `maintenance for a wife or child` TRUE FALSE `the civil day` (JUST (Date 1 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE)) EQUALS JUST FALSE

-- The stay as a regulative rule, run: a General Division that stays the proceedings is FULFILLED; where no stay is due the rule is FULFILLED at once.
-- The section sets no time for the stay, so a rule with no WITHIN cannot lapse into a breach: a General Division that only takes some other step leaves the duty standing (a residual obligation, not FULFILLED).
-- (Read from the output of `l4 run`: a residual MUST obligation, FULFILLED, FULFILLED.)
#TRACE `s 17A(3) the General Division must stay the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 1 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE) AT 0 WITH
    PARTY `s 17A(3) the General Division` DOES `s 17A(3) takes some other step in the civil proceedings` AT 99
#TRACE `s 17A(3) the General Division must stay the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` (JUST (Date 1 6 2024)) NOTHING NOTHING FALSE FALSE FALSE FALSE) AT 0 WITH
    PARTY `s 17A(3) the General Division` DOES `s 17A(3) stays the civil proceedings` AT 1
#TRACE `s 17A(3) the General Division must stay the civil proceedings` (`a proceeding` `custody of a child` TRUE FALSE `the civil day` NOTHING NOTHING NOTHING FALSE FALSE FALSE FALSE) AT 0 WITH
    PARTY `s 17A(3) the General Division` DOES `s 17A(3) takes some other step in the civil proceedings` AT 99

§§ `s 17A(7), (8), (9)`

#ASSERT (`s 17A(7) the General Division applies the civil law` TRUE) EQUALS JUST TRUE
#ASSERT (`s 17A(7) the General Division applies the civil law` FALSE) EQUALS NOTHING
#ASSERT (`s 17A(8) section 112 of the Women's Charter 1961 applies to the General Division in the proceeding` `disposition or division of property on divorce`) EQUALS JUST TRUE
#ASSERT (`s 17A(8) section 112 of the Women's Charter 1961 applies to the General Division in the proceeding` `custody of a child`) EQUALS NOTHING
#ASSERT (`s 17A(9) Syariah Court: the court is the Syariah Court constituted under the Administration of Muslim Law Act 1966` `Syariah Court`) EQUALS JUST TRUE
#ASSERT (`s 17A(9) Syariah Court: the court is the Syariah Court constituted under the Administration of Muslim Law Act 1966` `Family Court`) EQUALS JUST FALSE
#ASSERT (`s 17A(9) Syariah Court commencement certificate: it is a commencement certificate issued by the Syariah Court under section 35A(4)` TRUE) EQUALS JUST TRUE
#ASSERT (`s 17A(9) Syariah Court commencement certificate: it is a commencement certificate issued by the Syariah Court under section 35A(4)` FALSE) EQUALS JUST FALSE
#ASSERT (`s 17A(9) Syariah Court continuation certificate: it is a continuation certificate issued by the Syariah Court under section 35A(4)` TRUE) EQUALS JUST TRUE
#ASSERT (`s 17A(9) Syariah Court continuation certificate: it is a continuation certificate issued by the Syariah Court under section 35A(4)` FALSE) EQUALS JUST FALSE

§§ `ss 16, 17 and 17A together`

-- order: s 16(1), s 16(2), s 17(1), s 17A(1), s 17A(2)
#ASSERT (`ss 16, 17 and 17A the General Division has civil jurisdiction by one of these sections` (JUST TRUE) NOTHING NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`ss 16, 17 and 17A the General Division has civil jurisdiction by one of these sections` NOTHING (JUST TRUE) NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`ss 16, 17 and 17A the General Division has civil jurisdiction by one of these sections` NOTHING NOTHING (JUST TRUE) NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`ss 16, 17 and 17A the General Division has civil jurisdiction by one of these sections` NOTHING NOTHING NOTHING NOTHING (JUST TRUE)) EQUALS JUST TRUE
-- s 17A(1): "Despite sections 16 and 17, the General Division has no jurisdiction"
#ASSERT (`ss 16, 17 and 17A the General Division has civil jurisdiction by one of these sections` (JUST TRUE) NOTHING (JUST TRUE) (JUST TRUE) NOTHING) EQUALS JUST FALSE
-- a s 16(1) "where" that fails is not a route; with no other route the sections do not decide
#ASSERT (`ss 16, 17 and 17A the General Division has civil jurisdiction by one of these sections` (JUST FALSE) NOTHING NOTHING NOTHING NOTHING) EQUALS NOTHING
#ASSERT (`ss 16, 17 and 17A the General Division has civil jurisdiction by one of these sections` NOTHING NOTHING NOTHING NOTHING NOTHING) EQUALS NOTHING
