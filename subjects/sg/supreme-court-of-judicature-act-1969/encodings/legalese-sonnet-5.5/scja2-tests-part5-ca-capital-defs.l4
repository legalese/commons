IMPORT prelude
IMPORT daydate
IMPORT `scja-core`
IMPORT `scja2-part5-ca-capital-defs`

-- Tests for s 60F. Expected values are written from the text of the definitions, not from the code.

-- chapeau: "In this Division, unless the context otherwise requires"
#ASSERT (`s 60F chapeau the definitions of this Division apply in this use` FALSE) EQUALS JUST TRUE
#ASSERT (`s 60F chapeau the definitions of this Division apply in this use` TRUE) EQUALS JUST FALSE
-- "application for PACC permission" means an application for permission to make a PACC application
#ASSERT (`s 60F "application for PACC permission" the application is an application for PACC permission` TRUE) EQUALS JUST TRUE
#ASSERT (`s 60F "application for PACC permission" the application is an application for PACC permission` FALSE) EQUALS JUST FALSE
-- "application for review permission" means an application for permission to make a review application
#ASSERT (`s 60F "application for review permission" the application is an application for review permission` TRUE) EQUALS JUST TRUE
#ASSERT (`s 60F "application for review permission" the application is an application for review permission` FALSE) EQUALS JUST FALSE
-- "counsel" means any advocate and solicitor
#ASSERT (`s 60F "counsel" the person is counsel` `Advocate and solicitor`) EQUALS JUST TRUE
#ASSERT (`s 60F "counsel" the person is counsel` `Public Prosecutor`) EQUALS JUST FALSE
#ASSERT (`s 60F "counsel" the person is counsel` Accused) EQUALS JUST FALSE
-- "Judge of the Court of Appeal": a Judge sitting in the Court of Appeal in accordance with this Act and the Constitution
#ASSERT (`s 60F "Judge of the Court of Appeal" the Judge is a Judge of the Court of Appeal` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 60F "Judge of the Court of Appeal" the Judge is a Judge of the Court of Appeal` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 60F "Judge of the Court of Appeal" the Judge is a Judge of the Court of Appeal` FALSE TRUE) EQUALS JUST FALSE
-- "PACP" means a prisoner awaiting capital punishment
#ASSERT (`s 60F "PACP" the person is a PACP` TRUE) EQUALS JUST TRUE
#ASSERT (`s 60F "PACP" the person is a PACP` FALSE) EQUALS JUST FALSE
-- "President's order"
#ASSERT (`s 60F "President's order" the order is the President's order` TRUE) EQUALS JUST TRUE
#ASSERT (`s 60F "President's order" the order is the President's order` FALSE) EQUALS JUST FALSE
-- "review application"
#ASSERT (`s 60F "review application" the application is a review application` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 60F "review application" the application is a review application` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 60F "review application" the application is a review application` FALSE TRUE) EQUALS JUST FALSE
-- "relevant application": (a) to (d), and no other
#ASSERT (`s 60F "relevant application" the application is a relevant application` `s 60F "relevant application"(a) an application for PACC permission`) EQUALS JUST TRUE
#ASSERT (`s 60F "relevant application" the application is a relevant application` `s 60F "relevant application"(b) a PACC application`) EQUALS JUST TRUE
#ASSERT (`s 60F "relevant application" the application is a relevant application` `s 60F "relevant application"(c) an application for review permission`) EQUALS JUST TRUE
#ASSERT (`s 60F "relevant application" the application is a relevant application` `s 60F "relevant application"(d) a review application`) EQUALS JUST TRUE
#ASSERT (`s 60F "relevant application" the application is a relevant application` `s 60F "relevant application" another application`) EQUALS JUST FALSE

-- Examples: each of the five is within limb (b)(ii); an application the Examples do not name is NOTHING (the list is not closed)
#ASSERT (`s 60F Examples the application is an example of an application made by a PACP whose determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples(a) an application challenging the President's order`) EQUALS JUST TRUE
#ASSERT (`s 60F Examples the application is an example of an application made by a PACP whose determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples(b) an application challenging the manner in which the death sentence is to be carried out`) EQUALS JUST TRUE
#ASSERT (`s 60F Examples the application is an example of an application made by a PACP whose determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples(c) an application challenging the imposition of the sentence of death as a form of punishment`) EQUALS JUST TRUE
#ASSERT (`s 60F Examples the application is an example of an application made by a PACP whose determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples(d) an application challenging the Public Prosecutor's decision not to certify that the PACP has substantively assisted the Central Narcotics Bureau`) EQUALS JUST TRUE
#ASSERT (`s 60F Examples the application is an example of an application made by a PACP whose determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples(e) an application challenging the Public Prosecutor's decision to institute and conduct proceedings against the PACP for an offence punishable with death`) EQUALS JUST TRUE
#ASSERT (`s 60F Examples the application is an example of an application made by a PACP whose determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples another application`) EQUALS NOTHING
-- limb (b)(ii) holds for each Example even when the "otherwise" input is FALSE
#ASSERT `s 60F "post-appeal application in a capital case"(b)(ii) the determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples(a) an application challenging the President's order` FALSE
#ASSERT `s 60F "post-appeal application in a capital case"(b)(ii) the determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples(b) an application challenging the manner in which the death sentence is to be carried out` FALSE
#ASSERT `s 60F "post-appeal application in a capital case"(b)(ii) the determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples(c) an application challenging the imposition of the sentence of death as a form of punishment` FALSE
#ASSERT `s 60F "post-appeal application in a capital case"(b)(ii) the determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples(d) an application challenging the Public Prosecutor's decision not to certify that the PACP has substantively assisted the Central Narcotics Bureau` FALSE
#ASSERT `s 60F "post-appeal application in a capital case"(b)(ii) the determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples(e) an application challenging the Public Prosecutor's decision to institute and conduct proceedings against the PACP for an offence punishable with death` FALSE
-- an application the Examples do not name holds limb (b)(ii) only if the general words hold
#ASSERT `s 60F "post-appeal application in a capital case"(b)(ii) the determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples another application` TRUE
#ASSERT NOT (`s 60F "post-appeal application in a capital case"(b)(ii) the determination calls into question the propriety of the conviction, the sentence or its carrying out` `s 60F Examples another application` FALSE)

-- "relevant date", (a): the first PACC application, by (i) dismissal of the appeal, (ii) imposition of the sentence by the Court of Appeal, or (iii) the certificate
#ASSERT (`s 60F "relevant date" the relevant date` TRUE (JUST (Date 10 1 2020)) NOTHING NOTHING NOTHING) EQUALS JUST (Date 10 1 2020)
#ASSERT (`s 60F "relevant date" the relevant date` TRUE NOTHING (JUST (Date 11 2 2021)) NOTHING NOTHING) EQUALS JUST (Date 11 2 2021)
#ASSERT (`s 60F "relevant date" the relevant date` TRUE NOTHING NOTHING (JUST (Date 12 3 2022)) NOTHING) EQUALS JUST (Date 12 3 2022)
-- none of the three stated: the date cannot be worked out
#ASSERT (`s 60F "relevant date" the relevant date` TRUE NOTHING NOTHING NOTHING NOTHING) EQUALS NOTHING
-- two of the three stated: the text does not say which prevails
#ASSERT (`s 60F "relevant date" the relevant date` TRUE (JUST (Date 10 1 2020)) (JUST (Date 11 2 2021)) NOTHING NOTHING) EQUALS NOTHING
#ASSERT (`s 60F "relevant date" the relevant date` TRUE (JUST (Date 10 1 2020)) NOTHING (JUST (Date 12 3 2022)) NOTHING) EQUALS NOTHING
#ASSERT (`s 60F "relevant date" the relevant date` TRUE NOTHING (JUST (Date 11 2 2021)) (JUST (Date 12 3 2022)) NOTHING) EQUALS NOTHING
-- (b): the second or any subsequent PACC application: the date of the most recent determination, else the date mentioned in paragraph (a)
#ASSERT (`s 60F "relevant date" the relevant date` FALSE (JUST (Date 10 1 2020)) NOTHING NOTHING (JUST (Date 5 6 2023))) EQUALS JUST (Date 5 6 2023)
#ASSERT (`s 60F "relevant date" the relevant date` FALSE (JUST (Date 10 1 2020)) NOTHING NOTHING NOTHING) EQUALS JUST (Date 10 1 2020)
#ASSERT (`s 60F "relevant date" the relevant date` FALSE NOTHING NOTHING NOTHING NOTHING) EQUALS NOTHING
-- made after the relevant date: strictly after
#ASSERT (`s 60F "relevant date" it is made after the relevant date` (Date 11 1 2020) (JUST (Date 10 1 2020))) EQUALS JUST TRUE
#ASSERT (`s 60F "relevant date" it is made after the relevant date` (Date 10 1 2020) (JUST (Date 10 1 2020))) EQUALS JUST FALSE
#ASSERT (`s 60F "relevant date" it is made after the relevant date` (Date 9 1 2020) (JUST (Date 10 1 2020))) EQUALS JUST FALSE
#ASSERT (`s 60F "relevant date" it is made after the relevant date` (Date 11 1 2020) NOTHING) EQUALS NOTHING

-- "PACC application": any application (not being a review application) (a) made by a PACP after the relevant date; and (b) to which (i) or (ii) applies
#ASSERT (`s 60F "post-appeal application in a capital case" the application is a PACC application` FALSE TRUE (JUST TRUE) TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 60F "post-appeal application in a capital case" the application is a PACC application` FALSE TRUE (JUST TRUE) FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 60F "post-appeal application in a capital case" the application is a PACC application` FALSE TRUE (JUST TRUE) TRUE TRUE) EQUALS JUST TRUE
-- neither limb of (b)
#ASSERT (`s 60F "post-appeal application in a capital case" the application is a PACC application` FALSE TRUE (JUST TRUE) FALSE FALSE) EQUALS JUST FALSE
-- a review application is excluded
#ASSERT (`s 60F "post-appeal application in a capital case" the application is a PACC application` TRUE TRUE (JUST TRUE) TRUE TRUE) EQUALS JUST FALSE
-- not made by a PACP
#ASSERT (`s 60F "post-appeal application in a capital case" the application is a PACC application` FALSE FALSE (JUST TRUE) TRUE TRUE) EQUALS JUST FALSE
-- made on or before the relevant date
#ASSERT (`s 60F "post-appeal application in a capital case" the application is a PACC application` FALSE TRUE (JUST FALSE) TRUE TRUE) EQUALS JUST FALSE
-- the relevant date is not settled: NOTHING, unless a limb the text answers already says no
#ASSERT (`s 60F "post-appeal application in a capital case" the application is a PACC application` FALSE TRUE NOTHING TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 60F "post-appeal application in a capital case" the application is a PACC application` FALSE TRUE NOTHING FALSE FALSE) EQUALS JUST FALSE
