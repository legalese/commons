IMPORT prelude
IMPORT daydate
IMPORT `scja-core`
IMPORT `scja3-sch9-ninth-schedule`

-- scja3-tests-sch9.l4: tests for the Ninth Schedule.  Expected values are written from the text of the Schedule
-- (SCJA1969.txt lines 6487-6540) beside each assertion, and not from the module's output.

§ `Tests: the Ninth Schedule`

GIVEN court IS A Court
      about IS A `Subject of an order or application`
      way IS A `Way an order went`
      consent IS A BOOLEAN
      writtenLaw IS A BOOLEAN
      agreedFinal IS A BOOLEAN
GIVETH A Decision
`sch 9 test: a decision` MEANS
    Decision WITH
        `made by` IS court
        `in the exercise of` IS `appellate jurisdiction`
        `nature of the proceeding` IS `a civil proceeding`
        `subject of the case` IS `any other civil matter`
        `the order` IS (Order OF about, way)
        `made after the trial of an action` IS FALSE
        `made by consent of the parties` IS consent
        `amount in dispute or value of the subject matter, excluding interest and costs` IS NOTHING
        `date made` IS Date 1 7 2024
        `date the judgment or order was extracted` IS NOTHING
        `a written law provides that it is final or that no appeal lies` IS writtenLaw
        `the parties agreed in writing, signed by or for each, that it is final` IS agreedFinal

-- positional: permission was against a General Division decision; appeal only costs or fees; proves fraud; proves natural justice; agreement covers only part; appeal is against that part
GIVEN fromGD IS A BOOLEAN, costsOnly IS A BOOLEAN, fraud IS A BOOLEAN, naturalJustice IS A BOOLEAN, partOnly IS A BOOLEAN, thatPart IS A BOOLEAN
GIVETH A `sch 9 facts about the decision`
`sch 9 test: facts` MEANS
    `sch 9 facts about the decision` WITH
        `the permission given or refused was permission to appeal against a decision of the General Division` IS fromGD
        `the appeal relates only to costs or fees for hearing dates` IS costsOnly
        `the party seeking to appeal proves that the decision is affected by fraud or illegality` IS fraud
        `the party seeking to appeal proves a fundamental breach of the rules of natural justice` IS naturalJustice
        `the agreement that the decision is final relates only to part of the decision` IS partOnly
        `the appeal is against the part of the decision that the agreement relates to` IS thatPart

`sch 9 test: no facts` MEANS `sch 9 test: facts` FALSE FALSE FALSE FALSE FALSE FALSE
`sch 9 test: permission was against a General Division decision` MEANS `sch 9 test: facts` TRUE FALSE FALSE FALSE FALSE FALSE
`sch 9 test: appeal only about costs` MEANS `sch 9 test: facts` FALSE TRUE FALSE FALSE FALSE FALSE
`sch 9 test: proves fraud` MEANS `sch 9 test: facts` FALSE FALSE TRUE FALSE FALSE FALSE
`sch 9 test: proves breach of natural justice` MEANS `sch 9 test: facts` FALSE FALSE FALSE TRUE FALSE FALSE
`sch 9 test: agreement covers only part, appeal is against another part` MEANS `sch 9 test: facts` FALSE FALSE FALSE FALSE TRUE FALSE
`sch 9 test: agreement covers only part, appeal is against that part` MEANS `sch 9 test: facts` FALSE FALSE FALSE FALSE TRUE TRUE
`sch 9 test: fraud proved, agreement covers only part, appeal is against that part` MEANS `sch 9 test: facts` FALSE FALSE TRUE FALSE TRUE TRUE

`sch 9 test: AD interim order under s 40(1)` MEANS `sch 9 test: a decision` `Appellate Division` `an incidental direction or interim order under section 40(1) or 58(1)` `granted unconditionally` FALSE FALSE FALSE
`sch 9 test: AD refused an interim order under s 40(1)` MEANS `sch 9 test: a decision` `Appellate Division` `an incidental direction or interim order under section 40(1) or 58(1)` refused FALSE FALSE FALSE
`sch 9 test: AD order by consent` MEANS `sch 9 test: a decision` `Appellate Division` `recording a judgment or order made by consent` `made, being neither a grant nor a refusal` TRUE FALSE FALSE
`sch 9 test: AD gave permission to appeal` MEANS `sch 9 test: a decision` `Appellate Division` `permission to appeal` `granted unconditionally` FALSE FALSE FALSE
`sch 9 test: AD refused permission to appeal` MEANS `sch 9 test: a decision` `Appellate Division` `permission to appeal` refused FALSE FALSE FALSE
`sch 9 test: AD gave permission to appeal on condition` MEANS `sch 9 test: a decision` `Appellate Division` `permission to appeal` `granted on condition that the party pays into court or gives security for the sum claimed` FALSE FALSE FALSE
`sch 9 test: AD order about a stay` MEANS `sch 9 test: a decision` `Appellate Division` `a stay of execution or enforcement` `granted unconditionally` FALSE FALSE FALSE
`sch 9 test: AD written law makes it final` MEANS `sch 9 test: a decision` `Appellate Division` `a stay of execution or enforcement` `granted unconditionally` FALSE TRUE FALSE
`sch 9 test: AD agreed final` MEANS `sch 9 test: a decision` `Appellate Division` `a stay of execution or enforcement` `granted unconditionally` FALSE FALSE TRUE
`sch 9 test: CA interim order under s 40(1)` MEANS `sch 9 test: a decision` `Court of Appeal` `an incidental direction or interim order under section 40(1) or 58(1)` `granted unconditionally` FALSE FALSE FALSE
`sch 9 test: GD order by consent` MEANS `sch 9 test: a decision` `General Division` `recording a judgment or order made by consent` `made, being neither a grant nor a refusal` TRUE FALSE FALSE

-- ---- paragraph 1 limbs ----
#ASSERT (`sch 9 para 1(a) the Appellate Division makes an incidental direction or interim order under section 40(1)` `sch 9 test: AD interim order under s 40(1)`) EQUALS JUST TRUE
-- refusing to make is not making
#ASSERT (`sch 9 para 1(a) the Appellate Division makes an incidental direction or interim order under section 40(1)` `sch 9 test: AD refused an interim order under s 40(1)`) EQUALS JUST FALSE
#ASSERT (`sch 9 para 1(a) the Appellate Division makes an incidental direction or interim order under section 40(1)` `sch 9 test: AD gave permission to appeal`) EQUALS JUST FALSE
#ASSERT (`sch 9 para 1(b) the judgment or order is made by consent of the parties` `sch 9 test: AD order by consent`) EQUALS JUST TRUE
#ASSERT (`sch 9 para 1(b) the judgment or order is made by consent of the parties` `sch 9 test: AD gave permission to appeal`) EQUALS JUST FALSE
#ASSERT (`sch 9 para 1(c) the Appellate Division gives or refuses permission to appeal against a decision of the General Division` `sch 9 test: AD gave permission to appeal` `sch 9 test: permission was against a General Division decision`) EQUALS JUST TRUE
#ASSERT (`sch 9 para 1(c) the Appellate Division gives or refuses permission to appeal against a decision of the General Division` `sch 9 test: AD refused permission to appeal` `sch 9 test: permission was against a General Division decision`) EQUALS JUST TRUE
#ASSERT (`sch 9 para 1(c) the Appellate Division gives or refuses permission to appeal against a decision of the General Division` `sch 9 test: AD gave permission to appeal on condition` `sch 9 test: permission was against a General Division decision`) EQUALS JUST TRUE
-- the permission was against some other decision
#ASSERT (`sch 9 para 1(c) the Appellate Division gives or refuses permission to appeal against a decision of the General Division` `sch 9 test: AD gave permission to appeal` `sch 9 test: no facts`) EQUALS JUST FALSE
-- not a permission to appeal at all
#ASSERT (`sch 9 para 1(c) the Appellate Division gives or refuses permission to appeal against a decision of the General Division` `sch 9 test: AD order about a stay` `sch 9 test: permission was against a General Division decision`) EQUALS JUST FALSE
#ASSERT (`sch 9 para 1(d) a written law expressly provides that the decision is final or that there is no appeal` `sch 9 test: AD written law makes it final`) EQUALS JUST TRUE
#ASSERT (`sch 9 para 1(d) a written law expressly provides that the decision is final or that there is no appeal` `sch 9 test: AD order about a stay`) EQUALS JUST FALSE

-- ---- paragraph 2 ----
#ASSERT (`sch 9 para 2 the appeal relates only to costs or fees for hearing dates` `sch 9 test: appeal only about costs`) EQUALS JUST TRUE
#ASSERT (`sch 9 para 2 the appeal relates only to costs or fees for hearing dates` `sch 9 test: no facts`) EQUALS JUST FALSE

-- ---- paragraph 3(2)(a) ----
#ASSERT (`sch 9 para 3(2)(a) the agreement counts whenever it was made` `sch 9 para 3(2)(a) before the decision was made`) EQUALS JUST TRUE
#ASSERT (`sch 9 para 3(2)(a) the agreement counts whenever it was made` `sch 9 para 3(2)(a) after the decision was made`) EQUALS JUST TRUE
#ASSERT (`sch 9 para 3(2)(a) the agreement counts whenever it was made` `sch 9 para 3(2)(a) at the same time as the decision`) EQUALS NOTHING

-- ---- paragraph 3(2)(b) ----
#ASSERT (`sch 9 para 3(2)(b) the part of the decision appealed against is covered by the agreement` `sch 9 test: no facts`) EQUALS JUST TRUE
#ASSERT (`sch 9 para 3(2)(b) the part of the decision appealed against is covered by the agreement` `sch 9 test: agreement covers only part, appeal is against that part`) EQUALS JUST TRUE
#ASSERT (`sch 9 para 3(2)(b) the part of the decision appealed against is covered by the agreement` `sch 9 test: agreement covers only part, appeal is against another part`) EQUALS JUST FALSE

-- ---- paragraph 3(1) ----
#ASSERT (`sch 9 para 3(1) an appeal cannot be brought against a decision the parties agreed in writing is final` `sch 9 test: AD agreed final` `sch 9 test: no facts`) EQUALS JUST TRUE
-- "unless the party seeking to appeal proves": either of the two proofs lifts the bar
#ASSERT (`sch 9 para 3(1) an appeal cannot be brought against a decision the parties agreed in writing is final` `sch 9 test: AD agreed final` `sch 9 test: proves fraud`) EQUALS JUST FALSE
#ASSERT (`sch 9 para 3(1) an appeal cannot be brought against a decision the parties agreed in writing is final` `sch 9 test: AD agreed final` `sch 9 test: proves breach of natural justice`) EQUALS JUST FALSE
-- no agreement in writing
#ASSERT (`sch 9 para 3(1) an appeal cannot be brought against a decision the parties agreed in writing is final` `sch 9 test: AD order about a stay` `sch 9 test: no facts`) EQUALS JUST FALSE
-- the agreement covers only part, and the appeal is against another part
#ASSERT (`sch 9 para 3(1) an appeal cannot be brought against a decision the parties agreed in writing is final` `sch 9 test: AD agreed final` `sch 9 test: agreement covers only part, appeal is against another part`) EQUALS JUST FALSE
#ASSERT (`sch 9 para 3(1) an appeal cannot be brought against a decision the parties agreed in writing is final` `sch 9 test: AD agreed final` `sch 9 test: agreement covers only part, appeal is against that part`) EQUALS JUST TRUE
-- the agreement covers only part, the appeal is against that part, but fraud is proved
#ASSERT (`sch 9 para 3(1) an appeal cannot be brought against a decision the parties agreed in writing is final` `sch 9 test: AD agreed final` `sch 9 test: fraud proved, agreement covers only part, appeal is against that part`) EQUALS JUST FALSE

-- ---- the scope ----
#ASSERT (`sch 9 the decision is one of the Appellate Division` `sch 9 test: AD order by consent`) EQUALS JUST TRUE
#ASSERT (`sch 9 the decision is one of the Appellate Division` `sch 9 test: CA interim order under s 40(1)`) EQUALS NOTHING
#ASSERT (`sch 9 the decision is one of the Appellate Division` `sch 9 test: GD order by consent`) EQUALS NOTHING

-- ---- seam 15: the decision is a case specified in the Ninth Schedule ----
#ASSERT (`sch 9 the Appellate Division decision is a case specified in the Ninth Schedule` `sch 9 test: AD interim order under s 40(1)` `sch 9 test: no facts`) EQUALS JUST TRUE
#ASSERT (`sch 9 the Appellate Division decision is a case specified in the Ninth Schedule` `sch 9 test: AD order by consent` `sch 9 test: no facts`) EQUALS JUST TRUE
#ASSERT (`sch 9 the Appellate Division decision is a case specified in the Ninth Schedule` `sch 9 test: AD refused permission to appeal` `sch 9 test: permission was against a General Division decision`) EQUALS JUST TRUE
#ASSERT (`sch 9 the Appellate Division decision is a case specified in the Ninth Schedule` `sch 9 test: AD written law makes it final` `sch 9 test: no facts`) EQUALS JUST TRUE
#ASSERT (`sch 9 the Appellate Division decision is a case specified in the Ninth Schedule` `sch 9 test: AD order about a stay` `sch 9 test: appeal only about costs`) EQUALS JUST TRUE
#ASSERT (`sch 9 the Appellate Division decision is a case specified in the Ninth Schedule` `sch 9 test: AD agreed final` `sch 9 test: no facts`) EQUALS JUST TRUE
-- fraud lifts the para 3(1) bar, and no other limb applies
#ASSERT (`sch 9 the Appellate Division decision is a case specified in the Ninth Schedule` `sch 9 test: AD agreed final` `sch 9 test: proves fraud`) EQUALS JUST FALSE
-- fraud lifts only para 3(1): the other limbs still bar
#ASSERT (`sch 9 the Appellate Division decision is a case specified in the Ninth Schedule` `sch 9 test: AD order by consent` `sch 9 test: proves fraud`) EQUALS JUST TRUE
-- no limb applies
#ASSERT (`sch 9 the Appellate Division decision is a case specified in the Ninth Schedule` `sch 9 test: AD order about a stay` `sch 9 test: no facts`) EQUALS JUST FALSE
#ASSERT (`sch 9 the Appellate Division decision is a case specified in the Ninth Schedule` `sch 9 test: AD refused an interim order under s 40(1)` `sch 9 test: no facts`) EQUALS JUST FALSE
-- not a decision of the Appellate Division
#ASSERT (`sch 9 the Appellate Division decision is a case specified in the Ninth Schedule` `sch 9 test: CA interim order under s 40(1)` `sch 9 test: no facts`) EQUALS NOTHING
#ASSERT (`sch 9 the Appellate Division decision is a case specified in the Ninth Schedule` `sch 9 test: GD order by consent` `sch 9 test: no facts`) EQUALS NOTHING

-- ---- the helpers ----
#ASSERT (`sch 9 the limbs taken together` (LIST JUST FALSE, JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`sch 9 the limbs taken together` (LIST JUST FALSE, JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`sch 9 the limbs taken together` (LIST JUST FALSE, NOTHING)) EQUALS NOTHING
#ASSERT `sch 9 the order gave or refused` refused
#ASSERT NOT (`sch 9 the order gave or refused` `made, being neither a grant nor a refusal`)
#ASSERT `sch 9 the order was made` `made, being neither a grant nor a refusal`
#ASSERT NOT (`sch 9 the order was made` refused)
