-- the examiner was appointed
#ASSERT (`sch 1 para 20(b) the court may prohibit the evidence from being adduced` `General Division` TRUE FALSE) EQUALS NOTHING
#ASSERT (`sch 1 para 20(b) the court may prohibit the evidence from being adduced` `General Division` FALSE TRUE) EQUALS NOTHING
#ASSERT (`sch 1 para 20(b) the court may prohibit the evidence from being adduced` `District Court` TRUE TRUE) EQUALS NOTHING

-- ---- paragraph 21 ----
#ASSERT (`sch 1 para 21(1) the court may order the person to undergo mediation, counselling or a family support programme, or to attend intervention sessions` `General Division` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 21(1) the court may order the person to undergo mediation, counselling or a family support programme, or to attend intervention sessions` `General Division` FALSE TRUE) EQUALS JUST TRUE
-- neither a party nor such a child
#ASSERT (`sch 1 para 21(1) the court may order the person to undergo mediation, counselling or a family support programme, or to attend intervention sessions` `General Division` FALSE FALSE) EQUALS NOTHING
#ASSERT (`sch 1 para 21(1) the court may order the person to undergo mediation, counselling or a family support programme, or to attend intervention sessions` `District Court` TRUE FALSE) EQUALS NOTHING
#ASSERT (`sch 1 para 21(2) the programme or activity is a family support programme or activity` TRUE `sch 1 para 21(2) between spouses or former spouses`) EQUALS JUST TRUE
-- "means any programme or activity carried out for the purpose of addressing or resolving"
#ASSERT (`sch 1 para 21(2) the programme or activity is a family support programme or activity` FALSE `sch 1 para 21(2) between spouses or former spouses`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 21(2) the programme or activity is a family support programme or activity` TRUE `sch 1 para 21(2) between siblings`) EQUALS JUST TRUE
-- "means any programme or activity carried out for the purpose of addressing or resolving"
#ASSERT (`sch 1 para 21(2) the programme or activity is a family support programme or activity` FALSE `sch 1 para 21(2) between siblings`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 21(2) the programme or activity is a family support programme or activity` TRUE `sch 1 para 21(2) between parent and child`) EQUALS JUST TRUE
-- "means any programme or activity carried out for the purpose of addressing or resolving"
#ASSERT (`sch 1 para 21(2) the programme or activity is a family support programme or activity` FALSE `sch 1 para 21(2) between parent and child`) EQUALS JUST FALSE
-- "means": between spouses or former spouses, between siblings or between parent and child
#ASSERT (`sch 1 para 21(2) the programme or activity is a family support programme or activity` TRUE `sch 1 para 21(2) another relationship`) EQUALS JUST FALSE

-- ---- paragraph 21A ----
#ASSERT (`sch 1 para 21A the court may conduct the process, or appoint a Judge, a Registrar, an officer of the Supreme Court or any other person to conduct it` `General Division` TRUE) EQUALS JUST TRUE
-- "Where a court orders"
#ASSERT (`sch 1 para 21A the court may conduct the process, or appoint a Judge, a Registrar, an officer of the Supreme Court or any other person to conduct it` `General Division` FALSE) EQUALS JUST FALSE
#ASSERT (`sch 1 para 21A the court may conduct the process, or appoint a Judge, a Registrar, an officer of the Supreme Court or any other person to conduct it` `District Court` TRUE) EQUALS NOTHING

-- ---- paragraph 22: the power ----
`sch 1 test: the last day of the period` MEANS Date 10 1 2025

-- filed 5 days late
#ASSERT (`sch 1 para 22 the court may require the person to pay a late filing charge` `General Division` TRUE `sch 1 test: the last day of the period` (Date 15 1 2025)) EQUALS JUST TRUE
-- filed the day after the last day
#ASSERT (`sch 1 para 22 the court may require the person to pay a late filing charge` `General Division` TRUE `sch 1 test: the last day of the period` (Date 11 1 2025)) EQUALS JUST TRUE
-- filed on the last day
#ASSERT (`sch 1 para 22 the court may require the person to pay a late filing charge` `General Division` TRUE `sch 1 test: the last day of the period` (Date 10 1 2025)) EQUALS JUST FALSE
-- filed before the last day
#ASSERT (`sch 1 para 22 the court may require the person to pay a late filing charge` `General Division` TRUE `sch 1 test: the last day of the period` (Date 3 1 2025)) EQUALS JUST FALSE
-- no period was specified
#ASSERT (`sch 1 para 22 the court may require the person to pay a late filing charge` `General Division` FALSE `sch 1 test: the last day of the period` (Date 15 1 2025)) EQUALS JUST FALSE
#ASSERT (`sch 1 para 22 the court may require the person to pay a late filing charge` `District Court` TRUE `sch 1 test: the last day of the period` (Date 15 1 2025)) EQUALS NOTHING

-- ---- paragraph 22: the charge, at $20 a day (an input: the Rules of Court prescribe it) ----
-- filed 5 days after the last day: the days after the expiry on which it remained unfiled are 11, 12, 13 and 14 January, 4 days
#ASSERT (`sch 1 para 22 the late filing charge` `General Division` TRUE `sch 1 test: the last day of the period` (Date 15 1 2025) 20) EQUALS JUST 80
-- filed on the day after the last day: no whole day remained unfiled
#ASSERT (`sch 1 para 22 the late filing charge` `General Division` TRUE `sch 1 test: the last day of the period` (Date 11 1 2025) 20) EQUALS JUST 0
-- filed two days after the last day: one day
#ASSERT (`sch 1 para 22 the late filing charge` `General Division` TRUE `sch 1 test: the last day of the period` (Date 12 1 2025) 20) EQUALS JUST 20
-- filed in time: the paragraph gives no power, so no charge
#ASSERT (`sch 1 para 22 the late filing charge` `General Division` TRUE `sch 1 test: the last day of the period` (Date 10 1 2025) 20) EQUALS JUST 0
-- a period reaching across a month end
#ASSERT (`sch 1 para 22 the late filing charge` `General Division` TRUE `sch 1 test: the last day of the period` (Date 3 2 2025) 20) EQUALS JUST 460
#ASSERT (`sch 1 para 22 the late filing charge` `District Court` TRUE `sch 1 test: the last day of the period` (Date 15 1 2025) 20) EQUALS NOTHING

-- ---- paragraph 23(2) ----
#ASSERT (`sch 1 para 23(2) the thing is amicable resolution` `sch 1 para 23(2)(a) settlement of an action or appeal relating to a dispute`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 23(2) the thing is amicable resolution` `sch 1 para 23(2)(b) resolution of a dispute other than by litigation, whether in whole or in part`) EQUALS JUST TRUE
-- "means"
#ASSERT (`sch 1 para 23(2) the thing is amicable resolution` `sch 1 para 23(2) another thing`) EQUALS JUST FALSE
