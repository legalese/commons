#ASSERT (`sch 1 para 18 the court may attach the deposits` `General Division` FALSE) EQUALS NOTHING
#ASSERT (`sch 1 para 18 the court may attach the deposits` `District Court` TRUE) EQUALS NOTHING

-- ---- paragraph 19 ----
#ASSERT (`sch 1 para 19 the court may order a medical examination of the person` `General Division` TRUE TRUE) EQUALS JUST TRUE
-- "where the physical or mental condition of the person is relevant"
#ASSERT (`sch 1 para 19 the court may order a medical examination of the person` `General Division` TRUE FALSE) EQUALS JUST FALSE
-- not a party
#ASSERT (`sch 1 para 19 the court may order a medical examination of the person` `General Division` FALSE TRUE) EQUALS NOTHING
#ASSERT (`sch 1 para 19 the court may order a medical examination of the person` `District Court` TRUE TRUE) EQUALS NOTHING

-- ---- paragraph 20 ----
#ASSERT (`sch 1 para 20(a) the court may appoint a professional to examine and assess the child or person` `General Division` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 20(a) the court may appoint a professional to examine and assess the child or person` `General Division` FALSE TRUE TRUE) EQUALS NOTHING
-- not one of the five kinds of professional
#ASSERT (`sch 1 para 20(a) the court may appoint a professional to examine and assess the child or person` `General Division` TRUE FALSE TRUE) EQUALS NOTHING
-- not for the purpose of expert evidence
#ASSERT (`sch 1 para 20(a) the court may appoint a professional to examine and assess the child or person` `General Division` TRUE TRUE FALSE) EQUALS NOTHING
#ASSERT (`sch 1 para 20(a) the court may appoint a professional to examine and assess the child or person` `District Court` TRUE TRUE TRUE) EQUALS NOTHING
