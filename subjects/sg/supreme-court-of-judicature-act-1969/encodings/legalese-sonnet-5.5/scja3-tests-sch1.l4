IMPORT prelude
IMPORT daydate
IMPORT `scja-core`
IMPORT `scja3-sch1-first-schedule`

-- scja3-tests-sch1.l4: tests for the First Schedule.  Expected values are written from the text of the Schedule
-- (SCJA1969.txt lines 5462-5714) beside each assertion, and not from the module's output.

§ `Tests: the First Schedule`

-- ---- seam 1: the power is one set out in the First Schedule ----
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 1 the power to issue a direction, order or writ, including a prerogative order`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 2 the power to partition land, direct a sale instead of partition, or order land sold`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 3 the power to order land charged or mortgaged instead of sold`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 4 the power to grant relief by way of interpleader and to order a sale`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 5 the power to preserve the subject matter, evidence and assets`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 6 the power to direct interest to be paid`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 7 the power to enlarge or abridge time`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 8 the power to enforce a judgment`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 9 the power to dismiss or stay proceedings`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 10 the power to transfer proceedings`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 11 the power to allow a defence of set-off`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 12 the power to order discovery`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 13 the power to award costs`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 14 the power to grant all reliefs and remedies at law and in equity`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 15 the power to order interim payments`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 16 the power to award provisional damages for personal injuries`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 17 the power to order damages for personal injuries to be paid in periodic instalments`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 18 the power to attach deposits with a financial institution`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 19 the power to order a medical examination of a party`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 20 the power to appoint an examiner of a child or person and to bar other evidence`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 21 the power to order mediation, counselling, intervention sessions or a family support programme`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 21A the power to conduct a mediation or to appoint a person to conduct it`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 22 the power to require a late filing charge`) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 para 23 the power to order amicable resolution`) EQUALS JUST TRUE
-- a power the Schedule does not set out may be the General Division's under another written law (s 18(1)): NOTHING, never JUST FALSE
#ASSERT (`sch 1 the power is one set out in the First Schedule` `sch 1 another power that the First Schedule does not set out`) EQUALS NOTHING

-- ---- seam 2: the power is the power under paragraph 1 ----
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 1 the power to issue a direction, order or writ, including a prerogative order`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 2 the power to partition land, direct a sale instead of partition, or order land sold`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 3 the power to order land charged or mortgaged instead of sold`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 4 the power to grant relief by way of interpleader and to order a sale`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 5 the power to preserve the subject matter, evidence and assets`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 6 the power to direct interest to be paid`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 7 the power to enlarge or abridge time`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 8 the power to enforce a judgment`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 9 the power to dismiss or stay proceedings`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 10 the power to transfer proceedings`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 11 the power to allow a defence of set-off`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 12 the power to order discovery`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 13 the power to award costs`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 14 the power to grant all reliefs and remedies at law and in equity`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 15 the power to order interim payments`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 16 the power to award provisional damages for personal injuries`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 17 the power to order damages for personal injuries to be paid in periodic instalments`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 18 the power to attach deposits with a financial institution`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 19 the power to order a medical examination of a party`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 20 the power to appoint an examiner of a child or person and to bar other evidence`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 21 the power to order mediation, counselling, intervention sessions or a family support programme`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 21A the power to conduct a mediation or to appoint a person to conduct it`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 22 the power to require a late filing charge`) EQUALS JUST FALSE
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 para 23 the power to order amicable resolution`) EQUALS JUST FALSE
-- para 1 reaches a direction, order or writ "for any other purpose"
#ASSERT (`sch 1 para 1 the power is the power under paragraph 1` `sch 1 another power that the First Schedule does not set out`) EQUALS NOTHING

-- ---- the scope gate ----
#ASSERT (`sch 1 the power is the General Division's` `General Division` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`sch 1 the power is the General Division's` `General Division` (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`sch 1 the power is the General Division's` `General Division` NOTHING) EQUALS NOTHING
#ASSERT (`sch 1 the power is the General Division's` `Singapore International Commercial Court` (JUST TRUE)) EQUALS NOTHING
#ASSERT (`sch 1 the power is the General Division's` `Family Division of the High Court` (JUST TRUE)) EQUALS NOTHING
#ASSERT (`sch 1 the power is the General Division's` `District Court` (JUST TRUE)) EQUALS NOTHING
#ASSERT `sch 1 all of the conditions hold` (LIST TRUE, TRUE)
#ASSERT NOT (`sch 1 all of the conditions hold` (LIST TRUE, FALSE))

-- ---- paragraph 1 ----
#ASSERT (`sch 1 para 1 the court may issue the direction, order or writ to a person or authority` `General Division` `sch 1 para 1(a) a Mandatory Order`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 1 the court may issue the direction, order or writ to a person or authority` `General Division` `sch 1 para 1(b) a Prohibiting Order`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 1 the court may issue the direction, order or writ to a person or authority` `General Division` `sch 1 para 1(c) a Quashing Order`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 1 the court may issue the direction, order or writ to a person or authority` `General Division` `sch 1 para 1(d) an Order for Review of Detention`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 1 the court may issue the direction, order or writ to a person or authority` `General Division` `sch 1 para 1 another direction, order or writ`) EQUALS JUST TRUE
-- the Singapore International Commercial Court has its share through s 18I(1), which excludes para 1: not this Schedule's question
#ASSERT (`sch 1 para 1 the court may issue the direction, order or writ to a person or authority` `Singapore International Commercial Court` `sch 1 para 1(a) a Mandatory Order`) EQUALS NOTHING
#ASSERT (`sch 1 para 1 the court may issue the direction, order or writ to a person or authority` `District Court` `sch 1 para 1(c) a Quashing Order`) EQUALS NOTHING

-- ---- paragraph 2 ----
#ASSERT (`sch 1 para 2 the court may partition land or direct a sale instead of partition` `General Division` TRUE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 2 the court may partition land or direct a sale instead of partition` `General Division` FALSE) EQUALS NOTHING
#ASSERT (`sch 1 para 2 the court may partition land or direct a sale instead of partition` `Family Division of the High Court` TRUE) EQUALS NOTHING
#ASSERT (`sch 1 para 2 the court may order land sold in a cause or matter relating to land` `General Division` TRUE TRUE) EQUALS JUST TRUE
-- "where it appears necessary or expedient"
#ASSERT (`sch 1 para 2 the court may order land sold in a cause or matter relating to land` `General Division` TRUE FALSE) EQUALS JUST FALSE
-- not a cause or matter relating to land
#ASSERT (`sch 1 para 2 the court may order land sold in a cause or matter relating to land` `General Division` FALSE TRUE) EQUALS NOTHING
#ASSERT (`sch 1 para 2 the court may order land sold in a cause or matter relating to land` `General Division` FALSE FALSE) EQUALS NOTHING
#ASSERT (`sch 1 para 2 the court may order land sold in a cause or matter relating to land` `District Court` TRUE TRUE) EQUALS NOTHING

-- ---- paragraph 3 ----
#ASSERT (`sch 1 para 3 the court may order land charged or mortgaged instead of sold` `General Division` TRUE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 3 the court may order land charged or mortgaged instead of sold` `General Division` FALSE) EQUALS JUST FALSE
#ASSERT (`sch 1 para 3 the court may order land charged or mortgaged instead of sold` `District Court` TRUE) EQUALS NOTHING

-- ---- paragraph 4 ----
#ASSERT (`sch 1 para 4(a) the court may grant relief by way of interpleader to a person under liability to adverse claimants` `General Division` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 4(a) the court may grant relief by way of interpleader to a person under liability to adverse claimants` `General Division` FALSE TRUE TRUE) EQUALS JUST FALSE
-- sued by one party only
#ASSERT (`sch 1 para 4(a) the court may grant relief by way of interpleader to a person under liability to adverse claimants` `General Division` TRUE FALSE TRUE) EQUALS JUST FALSE
-- the claims are not adverse
#ASSERT (`sch 1 para 4(a) the court may grant relief by way of interpleader to a person under liability to adverse claimants` `General Division` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`sch 1 para 4(a) the court may grant relief by way of interpleader to a person under liability to adverse claimants` `District Court` TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`sch 1 para 4(b) the court may grant relief by way of interpleader to an officer of court charged with execution` `General Division` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 4(b) the court may grant relief by way of interpleader to an officer of court charged with execution` `General Division` FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`sch 1 para 4(b) the court may grant relief by way of interpleader to an officer of court charged with execution` `General Division` TRUE FALSE TRUE) EQUALS JUST FALSE
-- the claimant is the person against whom the process was issued
#ASSERT (`sch 1 para 4(b) the court may grant relief by way of interpleader to an officer of court charged with execution` `General Division` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`sch 1 para 4(b) the court may grant relief by way of interpleader to an officer of court charged with execution` `District Court` TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`sch 1 para 4 the court may order the sale of property subject to interpleader proceedings` `General Division` TRUE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 4 the court may order the sale of property subject to interpleader proceedings` `General Division` FALSE) EQUALS NOTHING

-- ---- paragraph 5 ----
#ASSERT (`sch 1 para 5 the court may provide for the preservation, before or after proceedings are commenced` `General Division` `sch 1 para 5(a) the interim preservation of property which is the subject matter of the proceedings`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 5 the court may provide for the preservation, before or after proceedings are commenced` `General Division` `sch 1 para 5(b) the preservation of evidence`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 5 the court may provide for the preservation, before or after proceedings are commenced` `General Division` `sch 1 para 5(c) the preservation of assets for the satisfaction of a judgment which has been or may be made`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 5 the court may provide for the preservation, before or after proceedings are commenced` `General Division` `sch 1 para 5 another purpose`) EQUALS NOTHING
#ASSERT (`sch 1 para 5 the court may provide for the preservation, before or after proceedings are commenced` `Singapore International Commercial Court` `sch 1 para 5(b) the preservation of evidence`) EQUALS NOTHING

-- ---- paragraph 6 ----
#ASSERT (`sch 1 para 6 the court may direct interest to be paid on the sum` `General Division` `sch 1 para 6 damages`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 6 the court may direct interest to be paid on the sum` `General Division` `sch 1 para 6 debts, whether paid before or after commencement of proceedings`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 6 the court may direct interest to be paid on the sum` `General Division` `sch 1 para 6 judgment debts`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 6 the court may direct interest to be paid on the sum` `General Division` `sch 1 para 6 sums found due on taking accounts between parties`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 6 the court may direct interest to be paid on the sum` `General Division` `sch 1 para 6 sums found due and unpaid by receivers or other persons liable to account to the court`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 6 the court may direct interest to be paid on the sum` `General Division` `sch 1 para 6 another sum`) EQUALS NOTHING
#ASSERT (`sch 1 para 6 the court may direct interest to be paid on the sum` `District Court` `sch 1 para 6 damages`) EQUALS NOTHING

-- ---- paragraph 7 ----
#ASSERT (`sch 1 para 7 the court may enlarge or abridge the time` `General Division` TRUE FALSE) EQUALS JUST TRUE
-- "this provision does not affect any written law relating to limitation"
#ASSERT (`sch 1 para 7 the court may enlarge or abridge the time` `General Division` TRUE TRUE) EQUALS JUST FALSE
-- a time fixed other than by a written law
#ASSERT (`sch 1 para 7 the court may enlarge or abridge the time` `General Division` FALSE FALSE) EQUALS NOTHING
#ASSERT (`sch 1 para 7 the court may enlarge or abridge the time` `District Court` TRUE FALSE) EQUALS NOTHING

-- ---- paragraphs 8, 11, 12, 13, 14 and 23(1): grants with no condition in the paragraph ----
#ASSERT (`sch 1 para 8 the court may enforce its judgment in a manner prescribed by a written law, Rules of Court or Family Justice Rules` `General Division`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 8 the court may enforce its judgment in a manner prescribed by a written law, Rules of Court or Family Justice Rules` `District Court`) EQUALS NOTHING
#ASSERT (`sch 1 para 11 the court may allow a defence of set-off` `General Division`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 11 the court may allow a defence of set-off` `District Court`) EQUALS NOTHING
#ASSERT (`sch 1 para 12 the court may order discovery of facts or documents by a party or any other person` `General Division`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 12 the court may order discovery of facts or documents by a party or any other person` `District Court`) EQUALS NOTHING
#ASSERT (`sch 1 para 13 the court may award costs` `General Division`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 13 the court may award costs` `District Court`) EQUALS NOTHING
#ASSERT (`sch 1 para 14 the court may grant all reliefs and remedies at law and in equity` `General Division`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 14 the court may grant all reliefs and remedies at law and in equity` `District Court`) EQUALS NOTHING
#ASSERT (`sch 1 para 23(1) the court may order a party to attempt to resolve a dispute by amicable resolution` `General Division`) EQUALS JUST TRUE
#ASSERT (`sch 1 para 23(1) the court may order a party to attempt to resolve a dispute by amicable resolution` `District Court`) EQUALS NOTHING

-- ---- paragraph 9 ----
#ASSERT (`sch 1 para 9 the court may dismiss or stay the proceedings` `General Division` TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 9 the court may dismiss or stay the proceedings` `General Division` FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 9 the court may dismiss or stay the proceedings` `General Division` FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 9 the court may dismiss or stay the proceedings` `General Division` FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`sch 1 para 9 the court may dismiss or stay the proceedings` `District Court` TRUE FALSE FALSE) EQUALS NOTHING

-- ---- paragraph 10 ----
#ASSERT (`sch 1 para 10 the court may transfer the proceedings` `General Division` TRUE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 10 the court may transfer the proceedings` `General Division` FALSE) EQUALS NOTHING
#ASSERT (`sch 1 para 10 the court may transfer the proceedings` `District Court` TRUE) EQUALS NOTHING

-- ---- paragraph 15 ----
#ASSERT (`sch 1 para 15 the court may order a party to make an interim payment` `General Division` TRUE FALSE) EQUALS JUST TRUE
-- "excluding costs"
#ASSERT (`sch 1 para 15 the court may order a party to make an interim payment` `General Division` TRUE TRUE) EQUALS JUST FALSE
-- not a pending proceeding
#ASSERT (`sch 1 para 15 the court may order a party to make an interim payment` `General Division` FALSE FALSE) EQUALS NOTHING
#ASSERT (`sch 1 para 15 the court may order a party to make an interim payment` `District Court` TRUE FALSE) EQUALS NOTHING

-- ---- paragraphs 16, 17 and 18 ----
#ASSERT (`sch 1 para 16 the court may award provisional damages` `General Division` TRUE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 16 the court may award provisional damages` `General Division` FALSE) EQUALS NOTHING
#ASSERT (`sch 1 para 16 the court may award provisional damages` `District Court` TRUE) EQUALS NOTHING
#ASSERT (`sch 1 para 17 the court may order damages to be paid in periodic instalments` `General Division` TRUE) EQUALS JUST TRUE
#ASSERT (`sch 1 para 17 the court may order damages to be paid in periodic instalments` `General Division` FALSE) EQUALS NOTHING
#ASSERT (`sch 1 para 17 the court may order damages to be paid in periodic instalments` `District Court` TRUE) EQUALS NOTHING
