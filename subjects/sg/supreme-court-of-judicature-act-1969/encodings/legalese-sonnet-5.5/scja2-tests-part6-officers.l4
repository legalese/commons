IMPORT prelude
IMPORT daydate
IMPORT `scja-core`
IMPORT `scja2-part6-officers`

-- Tests for ss 61 to 72. Expected values are written from the text of the sections, not from the code.
-- Calendar facts used below (hand-checked): 1 January 2026 is a Thursday, so 3 January 2026 is a Saturday, 4 January a Sunday and 5 January a Monday.

-- s 61(1): the President may, on the recommendation of the Chief Justice, appoint a Registrar, a Deputy Registrar and Assistant Registrars
#ASSERT (`s 61(1) the President may appoint the officer of the Supreme Court` Registrar TRUE) EQUALS JUST TRUE
#ASSERT (`s 61(1) the President may appoint the officer of the Supreme Court` `Deputy Registrar` TRUE) EQUALS JUST TRUE
#ASSERT (`s 61(1) the President may appoint the officer of the Supreme Court` `Assistant Registrar` TRUE) EQUALS JUST TRUE
#ASSERT (`s 61(1) the President may appoint the officer of the Supreme Court` Registrar FALSE) EQUALS JUST FALSE
#ASSERT (`s 61(1) the President may appoint the officer of the Supreme Court` `Assistant Registrar` FALSE) EQUALS JUST FALSE
#ASSERT (`s 61(1) the President may appoint the officer of the Supreme Court` Sheriff TRUE) EQUALS NOTHING
#ASSERT (`s 61(1) the President may appoint the officer of the Supreme Court` Accountant FALSE) EQUALS NOTHING
-- s 61(2): "must not be appointed ... unless ... a qualified person"
#ASSERT (`s 61(2) the person may be appointed to be or to act as the Registrar, the Deputy Registrar or an Assistant Registrar` FALSE) EQUALS JUST FALSE
#ASSERT (`s 61(2) the person may be appointed to be or to act as the Registrar, the Deputy Registrar or an Assistant Registrar` TRUE) EQUALS NOTHING
-- the bar-phrased twin: the person is not a qualified person, so the bar applies
#ASSERT (`s 61(2) the bar on appointing the person to be or to act as the Registrar, the Deputy Registrar or an Assistant Registrar applies` FALSE) EQUALS JUST TRUE
-- the unless is met: the bar is lifted
#ASSERT (`s 61(2) the bar on appointing the person to be or to act as the Registrar, the Deputy Registrar or an Assistant Registrar applies` TRUE) EQUALS JUST FALSE
-- s 62(1)
#ASSERT (`s 62(1) the Registrar, the Deputy Registrar and the Assistant Registrars have the jurisdiction, power or duty` TRUE) EQUALS JUST TRUE
#ASSERT (`s 62(1) the Registrar, the Deputy Registrar and the Assistant Registrars have the jurisdiction, power or duty` FALSE) EQUALS NOTHING
-- s 62(2): the Deputy Registrar or the Assistant Registrars, subject to Rules of Court
#ASSERT (`s 62(2) the officer may exercise or perform the powers and duties conferred and imposed on the Registrar` `Deputy Registrar` FALSE) EQUALS JUST TRUE
#ASSERT (`s 62(2) the officer may exercise or perform the powers and duties conferred and imposed on the Registrar` `Assistant Registrar` FALSE) EQUALS JUST TRUE
#ASSERT (`s 62(2) the officer may exercise or perform the powers and duties conferred and imposed on the Registrar` `Deputy Registrar` TRUE) EQUALS NOTHING
#ASSERT (`s 62(2) the officer may exercise or perform the powers and duties conferred and imposed on the Registrar` `Assistant Registrar` TRUE) EQUALS NOTHING
#ASSERT (`s 62(2) the officer may exercise or perform the powers and duties conferred and imposed on the Registrar` Clerk FALSE) EQUALS NOTHING

-- s 63(1)
#ASSERT (`s 63(1) the office of the Sheriff that the officer holds` Registrar) EQUALS JUST Sheriff
#ASSERT (`s 63(1) the office of the Sheriff that the officer holds` `Deputy Registrar`) EQUALS JUST `Deputy Sheriff`
#ASSERT (`s 63(1) the office of the Sheriff that the officer holds` `Assistant Registrar`) EQUALS JUST `Assistant Sheriff`
#ASSERT (`s 63(1) the office of the Sheriff that the officer holds` Accountant) EQUALS NOTHING
-- s 63(1), the yes/no twin: the Registrar, the Deputy Registrar and the Assistant Registrars are the Sheriff, the Deputy Sheriff and the Assistant Sheriffs
#ASSERT (`s 63(1) the officer is a Sheriff, Deputy Sheriff or Assistant Sheriff of the Supreme Court` Registrar) EQUALS JUST TRUE
#ASSERT (`s 63(1) the officer is a Sheriff, Deputy Sheriff or Assistant Sheriff of the Supreme Court` `Deputy Registrar`) EQUALS JUST TRUE
#ASSERT (`s 63(1) the officer is a Sheriff, Deputy Sheriff or Assistant Sheriff of the Supreme Court` `Assistant Registrar`) EQUALS JUST TRUE
#ASSERT (`s 63(1) the officer is a Sheriff, Deputy Sheriff or Assistant Sheriff of the Supreme Court` Accountant) EQUALS NOTHING
-- s 63(2)
#ASSERT (`s 63(2) the officer has all the powers and privileges and may perform all the duties of the Sheriff` `Deputy Sheriff`) EQUALS JUST TRUE
#ASSERT (`s 63(2) the officer has all the powers and privileges and may perform all the duties of the Sheriff` `Assistant Sheriff`) EQUALS JUST TRUE
#ASSERT (`s 63(2) the officer has all the powers and privileges and may perform all the duties of the Sheriff` Clerk) EQUALS NOTHING
-- s 64(1)
#ASSERT (`s 64(1)(a) the Sheriff or the Sheriff's officer must execute the process` TRUE) EQUALS JUST TRUE
#ASSERT (`s 64(1)(a) the Sheriff or the Sheriff's officer must execute the process` FALSE) EQUALS NOTHING
#ASSERT (`s 64(1)(b) the Sheriff or the Sheriff's officer must make a return of the process and the manner of its execution` TRUE) EQUALS JUST TRUE
#ASSERT (`s 64(1)(b) the Sheriff or the Sheriff's officer must make a return of the process and the manner of its execution` FALSE) EQUALS NOTHING
#ASSERT (`s 64(1)(c) the Sheriff or the Sheriff's officer must receive the person` TRUE) EQUALS JUST TRUE
#ASSERT (`s 64(1)(c) the Sheriff or the Sheriff's officer must receive the person` FALSE) EQUALS NOTHING
-- s 64(2): entry, and breaking open "if necessary", with "such force as is reasonably necessary"
#ASSERT (`s 64(2) the Sheriff or the Sheriff's officer may effect an entry into the building` TRUE) EQUALS JUST TRUE
#ASSERT (`s 64(2) the Sheriff or the Sheriff's officer may effect an entry into the building` FALSE) EQUALS NOTHING
#ASSERT (`s 64(2) the Sheriff or the Sheriff's officer may break open any outer or inner door or window of the building or any receptacle therein` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 64(2) the Sheriff or the Sheriff's officer may break open any outer or inner door or window of the building or any receptacle therein` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 64(2) the Sheriff or the Sheriff's officer may break open any outer or inner door or window of the building or any receptacle therein` TRUE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 64(2) the Sheriff or the Sheriff's officer may break open any outer or inner door or window of the building or any receptacle therein` FALSE TRUE TRUE) EQUALS NOTHING
-- s 64(3): seven named kinds, and "any other appropriate person"
#ASSERT (`s 64(3) the Sheriff may engage the person to assist the Sheriff in the discharge of the Sheriff's duties` `s 64(3) an auxiliary police officer appointed under the Police Force Act 2004` FALSE) EQUALS JUST TRUE
#ASSERT (`s 64(3) the Sheriff may engage the person to assist the Sheriff in the discharge of the Sheriff's duties` `s 64(3) a security agency` FALSE) EQUALS JUST TRUE
#ASSERT (`s 64(3) the Sheriff may engage the person to assist the Sheriff in the discharge of the Sheriff's duties` `s 64(3) a provider of transport and of warehousing` FALSE) EQUALS JUST TRUE
#ASSERT (`s 64(3) the Sheriff may engage the person to assist the Sheriff in the discharge of the Sheriff's duties` `s 64(3) a valuer` FALSE) EQUALS JUST TRUE
#ASSERT (`s 64(3) the Sheriff may engage the person to assist the Sheriff in the discharge of the Sheriff's duties` `s 64(3) an estate agent` FALSE) EQUALS JUST TRUE
#ASSERT (`s 64(3) the Sheriff may engage the person to assist the Sheriff in the discharge of the Sheriff's duties` `s 64(3) a broker` FALSE) EQUALS JUST TRUE
#ASSERT (`s 64(3) the Sheriff may engage the person to assist the Sheriff in the discharge of the Sheriff's duties` `s 64(3) a solicitor` FALSE) EQUALS JUST TRUE
#ASSERT (`s 64(3) the Sheriff may engage the person to assist the Sheriff in the discharge of the Sheriff's duties` `s 64(3) any other person` TRUE) EQUALS JUST TRUE
#ASSERT (`s 64(3) the Sheriff may engage the person to assist the Sheriff in the discharge of the Sheriff's duties` `s 64(3) any other person` FALSE) EQUALS NOTHING
-- s 65: "Where ... the Sheriff is an interested party"
#ASSERT (`s 65 the court may appoint an officer or a person to act in the place of the Sheriff` TRUE) EQUALS JUST TRUE
#ASSERT (`s 65 the court may appoint an officer or a person to act in the place of the Sheriff` FALSE) EQUALS JUST FALSE
-- s 65A(1): a solicitor or a person employed by a solicitor, subject to the Chief Justice's directions
#ASSERT (`s 65A(1) the Registrar may authorise the person to exercise the powers and perform the duties of an officer of the Sheriff` `s 65A(1) a solicitor` FALSE) EQUALS JUST TRUE
#ASSERT (`s 65A(1) the Registrar may authorise the person to exercise the powers and perform the duties of an officer of the Sheriff` `s 65A(1) a person employed by a solicitor` FALSE) EQUALS JUST TRUE
#ASSERT (`s 65A(1) the Registrar may authorise the person to exercise the powers and perform the duties of an officer of the Sheriff` `s 65A(1) a solicitor` TRUE) EQUALS NOTHING
#ASSERT (`s 65A(1) the Registrar may authorise the person to exercise the powers and perform the duties of an officer of the Sheriff` `s 65A(1) a person employed by a solicitor` TRUE) EQUALS NOTHING
#ASSERT (`s 65A(1) the Registrar may authorise the person to exercise the powers and perform the duties of an officer of the Sheriff` `s 65A(1) another person` FALSE) EQUALS NOTHING
-- s 65A(2): the answer of section 79(2), passed through
#ASSERT (`s 65A(2) the solicitor or person authorised under subsection (1) is not liable to be sued` TRUE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 65A(2) the solicitor or person authorised under subsection (1) is not liable to be sued` TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 65A(2) the solicitor or person authorised under subsection (1) is not liable to be sued` TRUE NOTHING) EQUALS NOTHING
#ASSERT (`s 65A(2) the solicitor or person authorised under subsection (1) is not liable to be sued` FALSE (JUST TRUE)) EQUALS NOTHING

-- s 66(1)
#ASSERT (`s 66(1) the Accountant is appointed as the Act requires` TRUE) EQUALS JUST TRUE
#ASSERT (`s 66(1) the Accountant is appointed as the Act requires` FALSE) EQUALS NOTHING
-- s 66(2)
#ASSERT (`s 66(2) the Accountant must do the thing` TRUE) EQUALS JUST TRUE
#ASSERT (`s 66(2) the Accountant must do the thing` FALSE) EQUALS NOTHING
-- s 67(1): the four named kinds, and other officers as appear to the Chief Justice to be necessary
#ASSERT (`s 67(1) officers of that kind are to be attached to the Supreme Court` `Commissioner for oaths` FALSE) EQUALS JUST TRUE
#ASSERT (`s 67(1) officers of that kind are to be attached to the Supreme Court` Interpreter FALSE) EQUALS JUST TRUE
#ASSERT (`s 67(1) officers of that kind are to be attached to the Supreme Court` Clerk FALSE) EQUALS JUST TRUE
#ASSERT (`s 67(1) officers of that kind are to be attached to the Supreme Court` `Process server` FALSE) EQUALS JUST TRUE
#ASSERT (`s 67(1) officers of that kind are to be attached to the Supreme Court` `Another officer of the Supreme Court` TRUE) EQUALS JUST TRUE
#ASSERT (`s 67(1) officers of that kind are to be attached to the Supreme Court` `Another officer of the Supreme Court` FALSE) EQUALS NOTHING
#ASSERT (`s 67(1) officers of that kind are to be attached to the Supreme Court` Accountant TRUE) EQUALS NOTHING
-- s 67(2): with the approval of the Chief Justice
#ASSERT (`s 67(2) the officer may be attached to that Judge` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 67(2) the officer may be attached to that Judge` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 67(2) the officer may be attached to that Judge` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 67(2) the officer may be attached to that Judge` FALSE FALSE) EQUALS NOTHING
-- s 68(1)
#ASSERT (`s 68(1) the officer is an ex-officio commissioner for oaths` Registrar) EQUALS JUST TRUE
#ASSERT (`s 68(1) the officer is an ex-officio commissioner for oaths` `Deputy Registrar`) EQUALS JUST TRUE
#ASSERT (`s 68(1) the officer is an ex-officio commissioner for oaths` `Assistant Registrar`) EQUALS JUST TRUE
#ASSERT (`s 68(1) the officer is an ex-officio commissioner for oaths` Clerk) EQUALS NOTHING
-- s 68(2): fit and proper persons
#ASSERT (`s 68(2) the Senate of the Singapore Academy of Law may appoint the person to be a commissioner for oaths` TRUE) EQUALS JUST TRUE
#ASSERT (`s 68(2) the Senate of the Singapore Academy of Law may appoint the person to be a commissioner for oaths` FALSE) EQUALS NOTHING
-- s 68(2): the things a commissioner may do, subject to the limitations expressed in the appointment
#ASSERT (`s 68(2) the commissioner for oaths appointed by the Senate may do the thing` `s 68(2)(a) receive acknowledgements of married women in all cases where such acknowledgements are required by law to be taken before a public officer` FALSE) EQUALS JUST TRUE
#ASSERT (`s 68(2) the commissioner for oaths appointed by the Senate may do the thing` `s 68(2)(b) receive acknowledgements of recognisances of bail and bail bonds` FALSE) EQUALS JUST TRUE
#ASSERT (`s 68(2) the commissioner for oaths appointed by the Senate may do the thing` `s 68(2)(c)(i) administer oaths for the justification for bail` FALSE) EQUALS JUST TRUE
#ASSERT (`s 68(2) the commissioner for oaths appointed by the Senate may do the thing` `s 68(2)(c)(ii) administer oaths for taking any affidavit or affirmation` FALSE) EQUALS JUST TRUE
#ASSERT (`s 68(2) the commissioner for oaths appointed by the Senate may do the thing` `s 68(2)(c)(iii) administer oaths for receiving and taking the answer, plea, demurrer, disclaimer, allegation or examination of any party or parties to any action` FALSE) EQUALS JUST TRUE
#ASSERT (`s 68(2) the commissioner for oaths appointed by the Senate may do the thing` `s 68(2)(c)(iv) administer oaths for the examination of any witnesses upon any interrogatories or de bene esse or in chief or on any other occasions` FALSE) EQUALS JUST TRUE
#ASSERT (`s 68(2) the commissioner for oaths appointed by the Senate may do the thing` `s 68(2)(c)(v) administer oaths for swearing executors and administrators` FALSE) EQUALS JUST TRUE
#ASSERT (`s 68(2) the commissioner for oaths appointed by the Senate may do the thing` `s 68(2)(c)(vi) administer oaths for swearing persons in any cause or matter which is pending or about to be instituted in any court in any of its jurisdiction` FALSE) EQUALS JUST TRUE
#ASSERT (`s 68(2) the commissioner for oaths appointed by the Senate may do the thing` `s 68(2)(d) take and receive statutory declarations` FALSE) EQUALS JUST TRUE
#ASSERT (`s 68(2) the commissioner for oaths appointed by the Senate may do the thing` `s 68(2)(c)(ii) administer oaths for taking any affidavit or affirmation` TRUE) EQUALS NOTHING
#ASSERT (`s 68(2) the commissioner for oaths appointed by the Senate may do the thing` `s 68(2) another thing` FALSE) EQUALS NOTHING

-- s 69(1): the Registrar, Deputy Registrar, Assistant Registrars, and other officers the Chief Justice requires
#ASSERT (`s 69(1) the officer has taken and subscribed the oath before exercising the functions of the office, as the section requires` Registrar FALSE TRUE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 69(1) the officer has taken and subscribed the oath before exercising the functions of the office, as the section requires` `Deputy Registrar` FALSE TRUE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 69(1) the officer has taken and subscribed the oath before exercising the functions of the office, as the section requires` `Assistant Registrar` FALSE TRUE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 69(1) the officer has taken and subscribed the oath before exercising the functions of the office, as the section requires` Registrar FALSE FALSE (JUST TRUE)) EQUALS NOTHING
-- the oath taken is not the appropriate oath
#ASSERT (`s 69(1) the officer has taken and subscribed the oath before exercising the functions of the office, as the section requires` Registrar FALSE TRUE (JUST FALSE)) EQUALS JUST FALSE
-- the Second Schedule's answer is not settled
#ASSERT (`s 69(1) the officer has taken and subscribed the oath before exercising the functions of the office, as the section requires` Registrar FALSE TRUE NOTHING) EQUALS NOTHING
-- another officer: bound only if the Chief Justice requires it
#ASSERT (`s 69(1) the officer has taken and subscribed the oath before exercising the functions of the office, as the section requires` Clerk TRUE FALSE (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 69(1) the officer has taken and subscribed the oath before exercising the functions of the office, as the section requires` Clerk TRUE TRUE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 69(1) the officer has taken and subscribed the oath before exercising the functions of the office, as the section requires` Clerk FALSE FALSE (JUST TRUE)) EQUALS NOTHING
-- s 69(2): live video link or live television link, with the three capabilities
#ASSERT (`s 69(2) the person may take and subscribe the oath by appearing before the person administering the oath through a live link` TRUE `s 69(2) through a live video link` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 69(2) the person may take and subscribe the oath by appearing before the person administering the oath through a live link` TRUE `s 69(2) through a live television link` TRUE TRUE TRUE) EQUALS JUST TRUE
-- a capability missing: the subsection does not say what follows
#ASSERT (`s 69(2) the person may take and subscribe the oath by appearing before the person administering the oath through a live link` TRUE `s 69(2) through a live video link` FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 69(2) the person may take and subscribe the oath by appearing before the person administering the oath through a live link` TRUE `s 69(2) through a live video link` TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 69(2) the person may take and subscribe the oath by appearing before the person administering the oath through a live link` TRUE `s 69(2) through a live video link` TRUE TRUE FALSE) EQUALS NOTHING
-- another way of taking the oath
#ASSERT (`s 69(2) the person may take and subscribe the oath by appearing before the person administering the oath through a live link` TRUE `s 69(2) in another way` TRUE TRUE TRUE) EQUALS NOTHING
-- no oath of office is required under subsection (1): the "where" is not met
#ASSERT (`s 69(2) the person may take and subscribe the oath by appearing before the person administering the oath through a live link` FALSE `s 69(2) through a live video link` TRUE TRUE TRUE) EQUALS JUST FALSE

-- s 71(1), (2)
#ASSERT (`s 71(1) the department is part of the Registry of the Supreme Court` TRUE) EQUALS JUST TRUE
#ASSERT (`s 71(1) the department is part of the Registry of the Supreme Court` FALSE) EQUALS NOTHING
#ASSERT (`s 71(2) the officer has the control and supervision of the Registry` Registrar) EQUALS JUST TRUE
#ASSERT (`s 71(2) the officer has the control and supervision of the Registry` `Deputy Registrar`) EQUALS NOTHING
-- s 72(1): open every day except Saturdays, Sundays and public holidays (1 January 2026, a Thursday, is the public holiday below)
#ASSERT (`s 72(1) the day is a Saturday` (Date 3 1 2026))
#ASSERT NOT (`s 72(1) the day is a Saturday` (Date 2 1 2026))
#ASSERT NOT (`s 72(1) the day is a Saturday` (Date 4 1 2026))
#ASSERT (`s 72(1) the day is a Saturday` (Date 10 1 2026))
#ASSERT (`s 72(1) the Registry of the Supreme Court is to be open on the day` (Date 2 1 2026) (LIST Date 1 1 2026)) EQUALS JUST TRUE
#ASSERT (`s 72(1) the Registry of the Supreme Court is to be open on the day` (Date 5 1 2026) (LIST Date 1 1 2026)) EQUALS JUST TRUE
#ASSERT (`s 72(1) the Registry of the Supreme Court is to be open on the day` (Date 3 1 2026) (LIST Date 1 1 2026)) EQUALS JUST FALSE
#ASSERT (`s 72(1) the Registry of the Supreme Court is to be open on the day` (Date 4 1 2026) (LIST Date 1 1 2026)) EQUALS JUST FALSE
#ASSERT (`s 72(1) the Registry of the Supreme Court is to be open on the day` (Date 1 1 2026) (LIST Date 1 1 2026)) EQUALS JUST FALSE
-- the same Thursday is an ordinary day when it is not a public holiday
#ASSERT (`s 72(1) the Registry of the Supreme Court is to be open on the day` (Date 1 1 2026) EMPTY) EQUALS JUST TRUE
-- s 72(2): on a Saturday, Sunday or public holiday, if the Chief Justice directed it or the Registrar thinks the business extremely urgent
#ASSERT (`s 72(2) the Registrar may lawfully sit or carry out the business of the Registry on the day` (Date 3 1 2026) (LIST Date 1 1 2026) TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 72(2) the Registrar may lawfully sit or carry out the business of the Registry on the day` (Date 4 1 2026) (LIST Date 1 1 2026) FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 72(2) the Registrar may lawfully sit or carry out the business of the Registry on the day` (Date 1 1 2026) (LIST Date 1 1 2026) TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 72(2) the Registrar may lawfully sit or carry out the business of the Registry on the day` (Date 3 1 2026) (LIST Date 1 1 2026) FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 72(2) the Registrar may lawfully sit or carry out the business of the Registry on the day` (Date 1 1 2026) (LIST Date 1 1 2026) FALSE FALSE) EQUALS JUST FALSE
-- an ordinary day: the subsection does not speak of it
#ASSERT (`s 72(2) the Registrar may lawfully sit or carry out the business of the Registry on the day` (Date 2 1 2026) (LIST Date 1 1 2026) FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 72(2) the Registrar may lawfully sit or carry out the business of the Registry on the day` (Date 2 1 2026) (LIST Date 1 1 2026) TRUE TRUE) EQUALS NOTHING
-- s 72(3)
#ASSERT (`s 72(3) the times are the office hours of the Registry` TRUE) EQUALS JUST TRUE
#ASSERT (`s 72(3) the times are the office hours of the Registry` FALSE) EQUALS NOTHING
