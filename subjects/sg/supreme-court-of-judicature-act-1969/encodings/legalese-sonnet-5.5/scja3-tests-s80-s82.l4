IMPORT prelude
IMPORT daydate
IMPORT `scja-core`
IMPORT `scja3-s80-s82-rules-and-conversion`

-- scja3-tests-s80-s82.l4: tests for sections 80 and 82.  Expected values are written from the text of the sections
-- (SCJA1969.txt lines 5133-5139, 5329-5337 and 5376-5431) beside each assertion, and not from the module's output.

§ `Tests: sections 80 and 82`

-- ---- s 80(2)(j) ----
#ASSERT `s 80(2)(j) the Act's maximum rate of interest per annum` EQUALS 8
#ASSERT (`s 80(2)(j) the Rules of Court may regulate the rate of interest at that rate` 5 FALSE) EQUALS JUST TRUE
#ASSERT (`s 80(2)(j) the Rules of Court may regulate the rate of interest at that rate` 8 FALSE) EQUALS JUST TRUE
#ASSERT (`s 80(2)(j) the Rules of Court may regulate the rate of interest at that rate` 8.01 FALSE) EQUALS JUST FALSE
#ASSERT (`s 80(2)(j) the Rules of Court may regulate the rate of interest at that rate` 12 FALSE) EQUALS JUST FALSE
-- "unless it has been otherwise agreed between the parties"
#ASSERT (`s 80(2)(j) the Rules of Court may regulate the rate of interest at that rate` 12 TRUE) EQUALS NOTHING
#ASSERT (`s 80(2)(j) the Rules of Court may regulate the rate of interest at that rate` 5 TRUE) EQUALS JUST TRUE

-- ---- s 80(3) ---- (head-counts: "not more than 5" Supreme Court Judges; "a District Judge" is one; "2" practising advocates and solicitors; the Chief Justice, the Attorney-General and the Presiding Judge are each one office)
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(a) the Chief Justice, who is the Chairperson of the Committee` 1) EQUALS JUST TRUE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(a) the Chief Justice, who is the Chairperson of the Committee` 2) EQUALS JUST FALSE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(b) the Attorney-General` 1) EQUALS JUST TRUE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(b) the Attorney-General` 0) EQUALS JUST FALSE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(c) a Supreme Court Judge (excluding the Presiding Judge of the State Courts) appointed by the Chief Justice` 5) EQUALS JUST TRUE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(c) a Supreme Court Judge (excluding the Presiding Judge of the State Courts) appointed by the Chief Justice` 6) EQUALS JUST FALSE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(c) a Supreme Court Judge (excluding the Presiding Judge of the State Courts) appointed by the Chief Justice` 0) EQUALS JUST TRUE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(d) the Presiding Judge of the State Courts` 1) EQUALS JUST TRUE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(d) the Presiding Judge of the State Courts` 2) EQUALS JUST FALSE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(e) a District Judge appointed by the Chief Justice` 1) EQUALS JUST TRUE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(e) a District Judge appointed by the Chief Justice` 2) EQUALS JUST FALSE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(f) a practising advocate and solicitor appointed by the Chief Justice` 2) EQUALS JUST TRUE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(f) a practising advocate and solicitor appointed by the Chief Justice` 3) EQUALS JUST FALSE
#ASSERT (`s 80(3) the Rules Committee has this number of members of the kind` `s 80(3)(f) a practising advocate and solicitor appointed by the Chief Justice` 1) EQUALS JUST FALSE

-- ---- s 80(4) ----
#ASSERT `s 80(4) the Act's number of members that form a quorum` EQUALS 5
#ASSERT (`s 80(4) the meeting of the Rules Committee has a quorum` 5) EQUALS JUST TRUE
#ASSERT (`s 80(4) the meeting of the Rules Committee has a quorum` 9) EQUALS JUST TRUE
#ASSERT (`s 80(4) the meeting of the Rules Committee has a quorum` 4) EQUALS JUST FALSE
#ASSERT (`s 80(4) the question is decided by a majority of the votes of the members present and voting, as the section requires` 3 2) EQUALS JUST TRUE
#ASSERT (`s 80(4) the question is decided by a majority of the votes of the members present and voting, as the section requires` 3 3) EQUALS NOTHING
#ASSERT (`s 80(4) the question is decided by a majority of the votes of the members present and voting, as the section requires` 2 3) EQUALS NOTHING

-- ---- s 80(5), (6) ----
#ASSERT (`s 80(5) the Rules of Court may be made` FALSE) EQUALS JUST FALSE
#ASSERT (`s 80(5) the Rules of Court may be made` TRUE) EQUALS NOTHING
#ASSERT (`s 80(6) the Rules of Court must be presented to Parliament as soon as possible after publication in the Gazette` TRUE) EQUALS JUST TRUE
#ASSERT (`s 80(6) the Rules of Court must be presented to Parliament as soon as possible after publication in the Gazette` FALSE) EQUALS NOTHING

-- ---- s 82(1) ----
#ASSERT (`s 82(1) the Court may order that the pending action or application be converted and continued` TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
-- one condition missing at a time
#ASSERT (`s 82(1) the Court may order that the pending action or application be converted and continued` FALSE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 82(1) the Court may order that the pending action or application be converted and continued` TRUE FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 82(1) the Court may order that the pending action or application be converted and continued` TRUE TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 82(1) the Court may order that the pending action or application be converted and continued` TRUE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 82(1) the Court may order that the pending action or application be converted and continued` TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT `s 82(1) all of the conditions hold` (LIST TRUE, TRUE)
#ASSERT NOT (`s 82(1) all of the conditions hold` (LIST TRUE, FALSE))

-- ---- s 82(2), (3) ----
#ASSERT (`s 82(2) the Chief Justice may by order direct that a class or description of pending actions or applications be converted` TRUE) EQUALS JUST TRUE
#ASSERT (`s 82(2) the Chief Justice may by order direct that a class or description of pending actions or applications be converted` FALSE) EQUALS JUST FALSE
#ASSERT (`s 82(3)(a) the action or application is to be continued under the relevant written law and the practice and procedure in force at the time of the conversion` TRUE) EQUALS JUST TRUE
#ASSERT (`s 82(3)(a) the action or application is to be continued under the relevant written law and the practice and procedure in force at the time of the conversion` FALSE) EQUALS JUST FALSE
#ASSERT (`s 82(3)(b) the Court may give the parties directions as to the conduct and costs of the action or application` TRUE) EQUALS JUST TRUE
#ASSERT (`s 82(3)(b) the Court may give the parties directions as to the conduct and costs of the action or application` FALSE) EQUALS JUST FALSE

-- ---- the bar twins, fork S3-B6 ----
-- s 80(2)(j): the rate as a percentage, whether the parties have otherwise agreed the rate
#ASSERT (`s 80(2)(j) the cap of the Act's maximum rate bars the rate of interest` 9 FALSE) EQUALS JUST TRUE
#ASSERT (`s 80(2)(j) the cap of the Act's maximum rate bars the rate of interest` 9 TRUE) EQUALS JUST FALSE
#ASSERT (`s 80(2)(j) the cap of the Act's maximum rate bars the rate of interest` 8 FALSE) EQUALS JUST FALSE
#ASSERT (`s 80(2)(j) the cap of the Act's maximum rate bars the rate of interest` 5 FALSE) EQUALS JUST FALSE
-- the grant side is unchanged: the same inputs
#ASSERT (`s 80(2)(j) the Rules of Court may regulate the rate of interest at that rate` 9 TRUE) EQUALS NOTHING
#ASSERT (`s 80(2)(j) the Rules of Court may regulate the rate of interest at that rate` 9 FALSE) EQUALS JUST FALSE
-- s 80(5)
#ASSERT (`s 80(5) the bar on making the Rules of Court applies` FALSE) EQUALS JUST TRUE
#ASSERT (`s 80(5) the bar on making the Rules of Court applies` TRUE) EQUALS JUST FALSE

-- ---- section 81 ----
#ASSERT (`s 81 the council of the Supreme Court Judges has assembled in the year as the section requires` 1) EQUALS JUST TRUE
#ASSERT (`s 81 the council of the Supreme Court Judges has assembled in the year as the section requires` 3) EQUALS JUST TRUE
-- "at least once in every year": none is a bare "is to" not done, so the text is silent
#ASSERT (`s 81 the council of the Supreme Court Judges has assembled in the year as the section requires` 0) EQUALS NOTHING

-- ---- section 83(1): the six Schedules it names, the consultation, the order in the Gazette ----
#ASSERT (`s 83(1) the Schedule is one that the Minister may amend by order` `s 83 the Third Schedule`) EQUALS TRUE
#ASSERT (`s 83(1) the Schedule is one that the Minister may amend by order` `s 83 the Ninth Schedule`) EQUALS TRUE
#ASSERT (`s 83(1) the Schedule is one that the Minister may amend by order` `s 83 the Tenth Schedule`) EQUALS FALSE
#ASSERT (`s 83(1) the Schedule is one that the Minister may amend by order` `s 83 the First Schedule`) EQUALS FALSE
#ASSERT (`s 83(1) the Minister may amend the Schedule` `s 83 the Fifth Schedule` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 83(1) the Minister may amend the Schedule` `s 83 the Seventh Schedule` TRUE TRUE) EQUALS JUST TRUE
-- "after consulting the Chief Justice": not consulted
#ASSERT (`s 83(1) the Minister may amend the Schedule` `s 83 the Fifth Schedule` FALSE TRUE) EQUALS JUST FALSE
-- "by order in the Gazette": no order
#ASSERT (`s 83(1) the Minister may amend the Schedule` `s 83 the Fifth Schedule` TRUE FALSE) EQUALS JUST FALSE
-- a Schedule s 83(1) does not name (the Tenth, the First and the Second)
#ASSERT (`s 83(1) the Minister may amend the Schedule` `s 83 the Tenth Schedule` TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 83(1) the Minister may amend the Schedule` `s 83 the First Schedule` TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 83(1) the Minister may amend the Schedule` `s 83 the Second Schedule` FALSE FALSE) EQUALS NOTHING

