#ASSERT (`Under section 27(2), may the General Division take the step in my matter` `s 27(2) calls for the record` `District Court` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 27(2), may the General Division take the step in my matter` `s 27(2) calls for the record` `District Court` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 27(2), may the General Division take the step in my matter` `s 27(2) calls for the record` `Court of Appeal` FALSE TRUE) EQUALS NOTHING
#ASSERT (`Under section 27(3), are the proceedings in the lower court stayed` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 27(3), are the proceedings in the lower court stayed` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 27(3), are the proceedings in the lower court stayed` FALSE FALSE) EQUALS JUST FALSE
