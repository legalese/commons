#ASSERT (`Under section 73B(5) and (6), can I appeal against the refusal of permission without permission` `scja3 the General Division` FALSE) EQUALS NOTHING
#ASSERT (`Under section 73C(1), can the court make an extended civil restraint order against me` `scja3 the General Division` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 73C(1), can the court make an extended civil restraint order against me` `scja3 the General Division` FALSE) EQUALS JUST FALSE
