#ASSERT (`Under section 73B(4)(b), does the limited civil restraint order still remain in effect` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 73B(4)(b), does the limited civil restraint order still remain in effect` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 73B(4)(b), does the limited civil restraint order still remain in effect` FALSE TRUE) EQUALS JUST FALSE
