IMPORT prelude
IMPORT daydate
IMPORT `scja-core`
IMPORT `sgia-interpretation-time`
IMPORT `scja1-part2-hearings`
IMPORT `scja1-part3-div1`
IMPORT `scja1-part3-div2-jurisdiction`
IMPORT `scja1-part3-div3-sicc`
IMPORT `scja1-part3-div4`
IMPORT `scja1-part3-div5-6`
IMPORT `scja1-part3-div7-9`
IMPORT `scja-seat`
IMPORT `scja2-part5-ca-civil`
IMPORT `scja2-part4-ad-civil`

-- ============================================================
-- scja1: this part's cases seat text, unchanged (merged by concatenation)
-- ============================================================
-- Cases for scja1-seat.l4: one or more real-looking sets of facts for every seat question, with the answer written from the text (SCJA1969.txt), not from the code.
-- Every question has at least one case; where the Act has a no, there is a JUST FALSE case, and where it does not answer, a NOTHING case.
-- The inputs follow the order of the question's GIVEN lines.

§ `Will my matter be heard in private? (s 8)`

-- s 8(2): the court is satisfied that it is expedient, on the interests of justice
#ASSERT (`Under section 8(2), can the court hear my matter in private` `s 8(2) the interests of justice` TRUE) EQUALS JUST TRUE
-- not satisfied: the section gives the power only if satisfied
#ASSERT (`Under section 8(2), can the court hear my matter in private` `s 8(2) the interests of justice` FALSE) EQUALS JUST FALSE
-- ss 8(2AA) and 8(2AB): a national security application, not expedient to hear it otherwise than in private
#ASSERT (`Under sections 8(2AA) and 8(2AB), will my application be heard in private` TRUE FALSE FALSE) EQUALS JUST TRUE
-- expedient in the interests of justice to hear it otherwise, and not prejudicial: the court has the power to hear it otherwise than in private, and the Act does not say whether it will use it
#ASSERT (`Under sections 8(2AA) and 8(2AB), will my application be heard in private` TRUE TRUE TRUE) EQUALS NOTHING
-- not such an application: not covered
#ASSERT (`Under sections 8(2AA) and 8(2AB), will my application be heard in private` FALSE FALSE FALSE) EQUALS NOTHING
-- s 8(5): a journalist, where the court hears the matter in private
#ASSERT (`Under section 8(5), may the court let me be present in the courtroom` `s 8(5)(a) a journalist who reports news for a newspaper or a broadcasting service` TRUE) EQUALS JUST TRUE
-- the court does not hear the matter in private
#ASSERT (`Under section 8(5), may the court let me be present in the courtroom` `s 8(5)(a) a journalist who reports news for a newspaper or a broadcasting service` FALSE) EQUALS NOTHING

§ `Can my hearing be by video, television or audio link? (s 8A)`

-- s 8A(1): a live video link, a matter the Rules do not prescribe as outside electronic hearings
#ASSERT (`Under section 8A(1), can the court conduct my hearing this way` FALSE `through a live video link` FALSE) EQUALS JUST TRUE
-- a matter the Rules prescribe: "other than a matter or proceeding prescribed", the text's no
#ASSERT (`Under section 8A(1), can the court conduct my hearing this way` TRUE `through a live video link` FALSE) EQUALS JUST FALSE
-- some other way of hearing, not an electronic means the Chief Justice approved: not covered
#ASSERT (`Under section 8A(1), can the court conduct my hearing this way` FALSE `in open court` FALSE) EQUALS NOTHING
-- s 8A(3): a civil hearing with oral evidence and the parties do not all consent: the court must not use audio only
#ASSERT (`Under section 8A(3), must the court not use an audio link only for this part` TRUE FALSE FALSE) EQUALS JUST TRUE
-- all the parties consent: the prohibition is lifted
#ASSERT (`Under section 8A(3), must the court not use an audio link only for this part` TRUE TRUE FALSE) EQUALS JUST FALSE
-- no oral evidence in this part, and not a prescribed matter
#ASSERT (`Under section 8A(3), must the court not use an audio link only for this part` FALSE FALSE FALSE) EQUALS JUST FALSE
-- a matter the Rules prescribe: the ban applies whatever the evidence
#ASSERT (`Under section 8A(3), must the court not use an audio link only for this part` FALSE FALSE TRUE) EQUALS JUST TRUE
-- s 8A(5): inconsistent with the duty to ensure fairness
#ASSERT (`Under section 8A(5), must the court not conduct my hearing this way` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 8A(5), must the court not conduct my hearing this way` FALSE) EQUALS JUST FALSE

§ `Who sits on my case, and when? (ss 10 to 14)`

-- s 10(1): no written law provides another number, so one Judge; a written law provides 3
#ASSERT (`Under section 10(1), before how many Judges will my proceeding be heard` 0) EQUALS 1
#ASSERT (`Under section 10(1), before how many Judges will my proceeding be heard` 3) EQUALS 3
-- s 10(1A): the Chief Justice may direct an uneven number greater than the number under (1)
#ASSERT (`Under section 10(1A), may the Chief Justice direct this number of Judges` 3 1) EQUALS JUST TRUE
#ASSERT (`Under section 10(1A), may the Chief Justice direct this number of Judges` 2 1) EQUALS NOTHING
-- s 10(2)
#ASSERT (`Under section 10(2), may a single Judge hear my case` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 10(2), may a single Judge hear my case` FALSE FALSE) EQUALS NOTHING
-- s 10A: the Appellate Division thinks fit; the Singapore International Commercial Court is not named
#ASSERT (`Under section 10A, may the court summon assessors` `Appellate Division` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 10A, may the court summon assessors` `Singapore International Commercial Court` TRUE) EQUALS NOTHING
#ASSERT (`Under section 10A(4), may I object to the proposed assessor` TRUE TRUE TRUE) EQUALS JUST TRUE
-- not in the prescribed manner: the Act names the manner and does not say what follows, so it does not answer
#ASSERT (`Under section 10A(4), may I object to the proposed assessor` TRUE TRUE FALSE) EQUALS NOTHING
-- nobody is proposed as an assessor: "Where any person is proposed to be summoned as an assessor" is not met
#ASSERT (`Under section 10A(4), may I object to the proposed assessor` FALSE TRUE TRUE) EQUALS JUST FALSE
-- s 10B(1): 3 January 2026 is a Saturday, 5 January 2026 a Monday, 4 January 2026 a Sunday
#ASSERT (`Under section 10B(1), is the General Division to sit on the day` (Date 5 1 2026) FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 10B(1), is the General Division to sit on the day` (Date 3 1 2026) FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 10B(1), is the General Division to sit on the day` (Date 4 1 2026) FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 10B(1), is the General Division to sit on the day` (Date 5 1 2026) TRUE) EQUALS JUST FALSE
-- s 10B(2)
#ASSERT (`Under section 10B(2), may a Judge lawfully sit on the day` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 10B(2), may a Judge lawfully sit on the day` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 10B(2), may a Judge lawfully sit on the day` TRUE FALSE FALSE) EQUALS JUST FALSE
-- s 13: a money judgment; wages are excepted; a car (any other description) may be seized; apparel worth $1,000 is excepted, $1,001 is not
#ASSERT (`Under section 13, can the judgment debtor's property be seized` TRUE `s 13 property of any other description` 0 FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 13, can the judgment debtor's property be seized` TRUE `s 13(c) the wages or salary of the judgment debtor` 0 FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 13, can the judgment debtor's property be seized` TRUE `s 13(a) wearing apparel and bedding of the judgment debtor or the judgment debtor's family, and the tools and implements of the judgment debtor's trade` 1000 FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 13, can the judgment debtor's property be seized` TRUE `s 13(a) wearing apparel and bedding of the judgment debtor or the judgment debtor's family, and the tools and implements of the judgment debtor's trade` 1001 FALSE FALSE) EQUALS JUST TRUE
-- not a judgment for the payment of money: not covered
#ASSERT (`Under section 13, can the judgment debtor's property be seized` FALSE `s 13 property of any other description` 0 FALSE FALSE) EQUALS NOTHING
-- s 14(1)
#ASSERT (`Under section 14(1), may I prepare the instrument and tender it for execution` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 14(1), may I prepare the instrument and tender it for execution` TRUE FALSE) EQUALS JUST FALSE

§ `Does the High Court have jurisdiction over my case? (ss 16, 17, 17A)`

-- s 16(1): in personam, served in Singapore
#ASSERT (`Under section 16(1), does the General Division have jurisdiction over my action in personam` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
-- in personam, but neither served nor submitting
#ASSERT (`Under section 16(1), does the General Division have jurisdiction over my action in personam` TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- not in personam
#ASSERT (`Under section 16(1), does the General Division have jurisdiction over my action in personam` FALSE TRUE FALSE FALSE) EQUALS NOTHING
-- s 17(1)
#ASSERT (`Under section 17(1), does the General Division's civil jurisdiction include my kind of case` `probate or letters of administration` FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 17(1), does the General Division's civil jurisdiction include my kind of case` `recording a mediated settlement agreement under the Mediation Act 2017` FALSE) EQUALS NOTHING
#ASSERT (`Under section 17(1), does the General Division's civil jurisdiction include my kind of case` `patents` FALSE) EQUALS NOTHING
-- s 17A(1): within the Syariah Court's jurisdiction, all Muslims
#ASSERT (`Under section 17A(1), does the General Division have no jurisdiction over my case` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 17A(1), does the General Division have no jurisdiction over my case` TRUE FALSE FALSE) EQUALS NOTHING
-- s 17A(3): custody; all Muslims; civil proceedings commenced 10 June 2024; Syariah Court divorce proceedings commenced 1 June 2024; no certificates
#ASSERT (`Under section 17A(3), is the General Division to stay my civil proceedings` `custody of a child` TRUE FALSE (Date 10 6 2024) TRUE (Date 1 6 2024) FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
-- the Syariah Court commencement certificate has been filed
#ASSERT (`Under section 17A(3), is the General Division to stay my civil proceedings` `custody of a child` TRUE FALSE (Date 10 6 2024) TRUE (Date 1 6 2024) FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- maintenance is not a matter in (2)(b) or (c): the "where" is not met, the text's no
#ASSERT (`Under section 17A(3), is the General Division to stay my civil proceedings` `maintenance for a wife or child` TRUE FALSE (Date 10 6 2024) TRUE (Date 1 6 2024) FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- ss 16, 17 and 17A together: served in Singapore in personam, a probate matter: the General Division has civil jurisdiction
#ASSERT (`Under sections 16, 17 and 17A together, does the General Division have civil jurisdiction over my case` TRUE TRUE FALSE FALSE FALSE `probate or letters of administration` FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
-- a matter within the Syariah Court's jurisdiction under s 35(2)(a) between Muslims: "Despite sections 16 and 17" no jurisdiction
#ASSERT (`Under sections 16, 17 and 17A together, does the General Division have civil jurisdiction over my case` TRUE TRUE FALSE FALSE FALSE `probate or letters of administration` FALSE TRUE FALSE TRUE FALSE FALSE) EQUALS JUST FALSE
-- no route applies: the sections do not decide
#ASSERT (`Under sections 16, 17 and 17A together, does the General Division have civil jurisdiction over my case` FALSE FALSE FALSE FALSE FALSE `patents` FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING

§ `Can the court decide without a hearing, or dismiss an appeal summarily? (ss 17B, 17C)`

#ASSERT (`Under section 17B(1), may the General Division decide my matter without hearing oral arguments` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 17B(1), may the General Division decide my matter without hearing oral arguments` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 17B(1), may the General Division decide my matter without hearing oral arguments` FALSE FALSE) EQUALS NOTHING
-- s 17B(2): oral evidence in the part; no consent
#ASSERT (`Under section 17B(2), does section 17B(1) allow this part to be conducted without an oral hearing` TRUE FALSE) EQUALS JUST FALSE
-- the "unless all the parties consent" is met
#ASSERT (`Under section 17B(2), does section 17B(1) allow this part to be conducted without an oral hearing` TRUE TRUE) EQUALS JUST TRUE
-- no oral evidence in the part: the subsection does not speak of it
#ASSERT (`Under section 17B(2), does section 17B(1) allow this part to be conducted without an oral hearing` FALSE FALSE) EQUALS NOTHING
#ASSERT (`Under section 17B(3), may the General Division direct a written-correspondence hearing` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 17B(3), may the General Division direct a written-correspondence hearing` FALSE) EQUALS NOTHING
#ASSERT (`Under section 17B(4), must the General Division not hear my matter asynchronously` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 17B(4), must the General Division not hear my matter asynchronously` FALSE) EQUALS JUST FALSE
-- s 17C
#ASSERT (`Under section 17C(1), may a Judge summarily dismiss my appeal from the Registrar` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 17C(1), may a Judge summarily dismiss my appeal from the Registrar` TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 17C(1), may a Judge summarily dismiss my appeal from the Registrar` FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`Under section 17C(2), can the Judge summarily dismiss my appeal now` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 17C(2), can the Judge summarily dismiss my appeal now` FALSE TRUE) EQUALS NOTHING

§ `Is my case for the Singapore International Commercial Court? (ss 18D to 18M)`

#ASSERT (`Under section 18D(1), does the Singapore International Commercial Court have jurisdiction over my action` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 18D(1), does the Singapore International Commercial Court have jurisdiction over my action` FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 18D(3)(b), does the Court's jurisdiction include my counterclaim` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 18D(3)(b), does the Court's jurisdiction include my counterclaim` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 18D(3)(b), does the Court's jurisdiction include my counterclaim` FALSE TRUE TRUE) EQUALS JUST FALSE
-- s 18F: the term of submitting, no express provision to the contrary; and with one
#ASSERT (`Under section 18F(1), are we considered to have agreed to the term` `s 18F(1)(a) to submit to the exclusive jurisdiction of the Singapore International Commercial Court` TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 18F(1), are we considered to have agreed to the term` `s 18F(1)(a) to submit to the exclusive jurisdiction of the Singapore International Commercial Court` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 18F(1), are we considered to have agreed to the term` `s 18F(1)(a) to submit to the exclusive jurisdiction of the Singapore International Commercial Court` FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`Under section 18J(2), may the General Division transfer my case to the Singapore International Commercial Court` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 18J(2), may the General Division transfer my case to the Singapore International Commercial Court` FALSE TRUE) EQUALS NOTHING
#ASSERT (`Under section 18J(1), may the Singapore International Commercial Court transfer my case to the General Division` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 18J(1), may the Singapore International Commercial Court transfer my case to the General Division` TRUE FALSE) EQUALS NOTHING
#ASSERT (`Under section 18M, may I be represented by a registered foreign lawyer or law expert` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 18M, may I be represented by a registered foreign lawyer or law expert` TRUE FALSE TRUE) EQUALS NOTHING

§ `Can I appeal to the High Court, and do I need permission? (ss 20, 21, 22, 22A, 22B)`

-- s 20: a civil appeal from a District Court; a criminal case is s 19's
#ASSERT (`Under section 20, is my appeal part of the General Division's appellate civil jurisdiction` `District Court` `a civil proceeding` FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 20, is my appeal part of the General Division's appellate civil jurisdiction` `District Court` `a criminal proceeding` FALSE) EQUALS NOTHING
-- s 21(1): a District Court decision for $60,000, no permission: permission needed, none given, the text's no
#ASSERT (`Under section 21(1), can I appeal to the General Division from the decision` `District Court` 60000 0 (`scja1 seat No`) FALSE FALSE) EQUALS JUST FALSE
-- with the District Court's permission
#ASSERT (`Under section 21(1), can I appeal to the General Division from the decision` `District Court` 60000 0 (`scja1 seat No`) TRUE FALSE) EQUALS JUST TRUE
-- $60,001, not a Third Schedule case: the subsection does not say
#ASSERT (`Under section 21(1), can I appeal to the General Division from the decision` `District Court` 60001 0 (`scja1 seat No`) FALSE FALSE) EQUALS NOTHING
-- a Third Schedule case of any amount needs permission
#ASSERT (`Under section 21(1), can I appeal to the General Division from the decision` `District Court` 90000 0 (`scja1 seat Yes`) FALSE FALSE) EQUALS JUST FALSE
-- the Schedule is not known and the amount is over: not decided
#ASSERT (`Under section 21(1), can I appeal to the General Division from the decision` `District Court` 90000 0 (`scja1 seat I am not sure`) FALSE FALSE) EQUALS NOTHING
-- do I need permission?
#ASSERT (`Under section 21(1), do I need permission to appeal from the decision` `Magistrate's Court` 1000 0 (`scja1 seat No`)) EQUALS JUST TRUE
#ASSERT (`Under section 21(1), do I need permission to appeal from the decision` `Magistrate's Court` 70000 0 (`scja1 seat No`)) EQUALS NOTHING
#ASSERT (`Under section 21(1), do I need permission to appeal from the decision` `Magistrate's Court` 70000 100000 (`scja1 seat No`)) EQUALS JUST TRUE
#ASSERT (`Under section 21(1), do I need permission to appeal from the decision` `Family Court` 1000 0 (`scja1 seat No`)) EQUALS NOTHING
#ASSERT (`Under section 21(2A), is the order final` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 21(2A), is the order final` FALSE) EQUALS NOTHING
#ASSERT (`Under section 22(1), is my appeal by way of rehearing` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 22(1), is my appeal by way of rehearing` FALSE) EQUALS NOTHING
-- s 22(4): the decision was on 10 June 2024
#ASSERT (`Under section 22(4), may I give further evidence on my appeal` (Date 11 6 2024) (Date 10 6 2024) FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 22(4), may I give further evidence on my appeal` (Date 9 6 2024) (Date 10 6 2024) TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 22(4), may I give further evidence on my appeal` (Date 9 6 2024) (Date 10 6 2024) TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 22A(1), may the General Division decide my appeal without hearing oral arguments` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 22A(1), may the General Division decide my appeal without hearing oral arguments` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 22A(1), may the General Division decide my appeal without hearing oral arguments` FALSE FALSE) EQUALS NOTHING
#ASSERT (`Under section 22A(4), must the General Division not hear my appeal asynchronously` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 22A(4), must the General Division not hear my appeal asynchronously` FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 22B(1), may the General Division summarily dismiss my appeal` TRUE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 22B(1), may the General Division summarily dismiss my appeal` TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 22B(1), may the General Division summarily dismiss my appeal` FALSE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`Under section 22B(2), can the General Division summarily dismiss my appeal now` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 22B(2), can the General Division summarily dismiss my appeal now` TRUE FALSE) EQUALS NOTHING

§ `Supervision and revision of lower courts (ss 24 to 28)`

#ASSERT (`Under section 24, may the General Division call for the record of my civil proceedings` `District Court` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 24, may the General Division call for the record of my civil proceedings` `District Court` FALSE FALSE) EQUALS NOTHING
#ASSERT (`Under section 24, may the General Division call for the record of my civil proceedings` `Court of Appeal` FALSE TRUE) EQUALS NOTHING
