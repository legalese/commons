#ASSERT (`Under section 73B(2)(a), may I make a further application in the legal proceedings now that a limited civil restraint order is made` TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`Under section 73B(2)(a), am I restrained from making a further application in the legal proceedings without permission, now that a limited civil restraint order is made` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 73B(2)(a), am I restrained from making a further application in the legal proceedings without permission, now that a limited civil restraint order is made` TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 73B(2)(a), am I restrained from making a further application in the legal proceedings without permission, now that a limited civil restraint order is made` FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 73B(2)(a), am I restrained from making a further application in the legal proceedings without permission, now that a limited civil restraint order is made` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`Under section 73B(2)(b), may I apply to amend, vary or discharge the limited civil restraint order` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 73B(2)(b), may I apply to amend, vary or discharge the limited civil restraint order` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 73B(3), is my application treated as dismissed` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 73B(3), is my application treated as dismissed` TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
