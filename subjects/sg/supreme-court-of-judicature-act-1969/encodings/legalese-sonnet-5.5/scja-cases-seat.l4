#ASSERT (`Under section 28(1), do I have a right to be heard` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 28(1), do I have a right to be heard` TRUE TRUE) EQUALS NOTHING
#ASSERT (`Under section 28(2), may a final order be made to my prejudice` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 28(2), may a final order be made to my prejudice` TRUE TRUE) EQUALS NOTHING
-- s 28(2) asked as the bar: it applies if I have not been heard, and not once I have
#ASSERT (`Under section 28(2), does the bar on a final order to my prejudice apply` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 28(2), does the bar on a final order to my prejudice apply` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 28(2), does the bar on a final order to my prejudice apply` FALSE FALSE) EQUALS NOTHING

§ `Appealing a decision of the General Division (ss 29 to 29E)`

-- s 29: a written law says the decision is final
#ASSERT (`Under section 29, can no appeal be brought against the decision` `General Division` `original jurisdiction` TRUE (`scja1 seat No`)) EQUALS JUST TRUE
-- the Fourth Schedule says no appeal
#ASSERT (`Under section 29, can no appeal be brought against the decision` `General Division` `original jurisdiction` FALSE (`scja1 seat Yes`)) EQUALS JUST TRUE
-- neither
#ASSERT (`Under section 29, can no appeal be brought against the decision` `General Division` `original jurisdiction` FALSE (`scja1 seat No`)) EQUALS NOTHING
-- a decision of the Singapore International Commercial Court (fork K1)
#ASSERT (`Under section 29, can no appeal be brought against the decision` `Singapore International Commercial Court` `original jurisdiction` TRUE (`scja1 seat Yes`)) EQUALS NOTHING
-- s 29A(1): $250,000, no exception: permission required; $250,001: not decided
#ASSERT (`Under section 29A(1), do I need permission before I can appeal` `General Division` `original jurisdiction` 250000 FALSE 0 (`scja1 seat No`) (`scja1 seat No`)) EQUALS JUST TRUE
#ASSERT (`Under section 29A(1), do I need permission before I can appeal` `General Division` `original jurisdiction` 250001 FALSE 0 (`scja1 seat No`) (`scja1 seat No`)) EQUALS NOTHING
-- a written law expressly provides permission
#ASSERT (`Under section 29A(1), do I need permission before I can appeal` `General Division` `appellate jurisdiction` 900000 TRUE 0 (`scja1 seat No`) (`scja1 seat No`)) EQUALS JUST TRUE
-- a Fifth Schedule paragraph 3, 4(1) or 5(1) case
#ASSERT (`Under section 29A(1), do I need permission before I can appeal` `General Division` `original jurisdiction` 900000 FALSE 0 (`scja1 seat No`) (`scja1 seat Yes`)) EQUALS JUST TRUE
-- the Fifth Schedule's exception takes the case out of the amount rule
#ASSERT (`Under section 29A(1), do I need permission before I can appeal` `General Division` `original jurisdiction` 1000 FALSE 0 (`scja1 seat Yes`) (`scja1 seat No`)) EQUALS NOTHING
-- no amount known and the Fifth Schedule is not known: not decided
#ASSERT (`Under section 29A(1), do I need permission before I can appeal` `General Division` `original jurisdiction` 0 FALSE 0 (`scja1 seat I am not sure`) (`scja1 seat I am not sure`)) EQUALS NOTHING
-- s 29A(2): a written law names the Court of Appeal; the Fifth Schedule names the Appellate Division
#ASSERT (`Under section 29A(2), must I obtain permission from this court` `Court of Appeal` TRUE `Court of Appeal` TRUE `Appellate Division`) EQUALS JUST TRUE
#ASSERT (`Under section 29A(2), must I obtain permission from this court` `Appellate Division` TRUE `Court of Appeal` TRUE `Appellate Division`) EQUALS JUST FALSE
#ASSERT (`Under section 29A(2), must I obtain permission from this court` `Appellate Division` FALSE `Court of Appeal` TRUE `Appellate Division`) EQUALS JUST TRUE
#ASSERT (`Under section 29A(2), must I obtain permission from this court` `Appellate Division` FALSE `Court of Appeal` FALSE `Appellate Division`) EQUALS NOTHING
-- s 29B(2): decision made on 3 June 2024 by a Judge, not after a trial, not extracted; the 15th day is 18 June 2024
-- inputs: court, jurisdiction, after a trial, by a Judge, date made, extracted, date extracted, notice filed, a request, date of request, a public holiday, its date
#ASSERT (`Under section 29B(2), is my request for further arguments in time` `General Division` `original jurisdiction` FALSE TRUE (Date 3 6 2024) FALSE (Date 1 1 2000) FALSE TRUE (Date 17 6 2024) FALSE (Date 1 1 2000)) EQUALS JUST TRUE
#ASSERT (`Under section 29B(2), is my request for further arguments in time` `General Division` `original jurisdiction` FALSE TRUE (Date 3 6 2024) FALSE (Date 1 1 2000) FALSE TRUE (Date 18 6 2024) FALSE (Date 1 1 2000)) EQUALS JUST FALSE
-- a notice of appeal has already been filed
#ASSERT (`Under section 29B(2), is my request for further arguments in time` `General Division` `original jurisdiction` FALSE TRUE (Date 3 6 2024) FALSE (Date 1 1 2000) TRUE TRUE (Date 10 6 2024) FALSE (Date 1 1 2000)) EQUALS JUST FALSE
-- a decision after a trial of an action
#ASSERT (`Under section 29B(2), is my request for further arguments in time` `General Division` `original jurisdiction` TRUE TRUE (Date 3 6 2024) FALSE (Date 1 1 2000) FALSE TRUE (Date 10 6 2024) FALSE (Date 1 1 2000)) EQUALS JUST FALSE
-- the decision was made on Saturday 1 June 2024: the 15th day, Sunday 16 June, moves to Monday 17 June, so a request on Sunday 16 June is in time and on Monday 17 June is not;
-- with Monday 17 June a public holiday the day moves to Tuesday 18 June, so Monday 17 June is in time
#ASSERT (`Under section 29B(2), is my request for further arguments in time` `General Division` `original jurisdiction` FALSE TRUE (Date 1 6 2024) FALSE (Date 1 1 2000) FALSE TRUE (Date 16 6 2024) FALSE (Date 1 1 2000)) EQUALS JUST TRUE
#ASSERT (`Under section 29B(2), is my request for further arguments in time` `General Division` `original jurisdiction` FALSE TRUE (Date 1 6 2024) FALSE (Date 1 1 2000) FALSE TRUE (Date 17 6 2024) FALSE (Date 1 1 2000)) EQUALS JUST FALSE
#ASSERT (`Under section 29B(2), is my request for further arguments in time` `General Division` `original jurisdiction` FALSE TRUE (Date 1 6 2024) FALSE (Date 1 1 2000) FALSE TRUE (Date 17 6 2024) TRUE (Date 17 6 2024)) EQUALS JUST TRUE
-- a decision of the Singapore International Commercial Court (fork K1)
#ASSERT (`Under section 29B(2), is my request for further arguments in time` `Singapore International Commercial Court` `original jurisdiction` FALSE TRUE (Date 3 6 2024) FALSE (Date 1 1 2000) FALSE TRUE (Date 10 6 2024) FALSE (Date 1 1 2000)) EQUALS NOTHING
-- s 29B(4)(b): the time begins on the date the Judge affirmed the decision, 1 July 2024
#ASSERT (`Under section 29B(4)(b), on what date does the time for filing my notice of appeal begin` TRUE TRUE (Date 1 7 2024) FALSE (Date 1 1 2000)) EQUALS JUST (Date 1 7 2024)
#ASSERT (`Under section 29B(4)(b), on what date does the time for filing my notice of appeal begin` TRUE FALSE (Date 1 1 2000) TRUE (Date 2 7 2024)) EQUALS JUST (Date 2 7 2024)
-- neither has happened: the time has not begun
#ASSERT (`Under section 29B(4)(b), on what date does the time for filing my notice of appeal begin` TRUE FALSE (Date 1 1 2000) FALSE (Date 1 1 2000)) EQUALS NOTHING
-- s 29B(4)(a): the bar
#ASSERT (`Under section 29B(4)(a), am I barred for now from filing my notice of appeal` TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 29B(4)(a), am I barred for now from filing my notice of appeal` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 29B(4)(a), am I barred for now from filing my notice of appeal` FALSE FALSE FALSE) EQUALS JUST FALSE
-- s 29C: the Sixth Schedule says the Court of Appeal; says not; not known
#ASSERT (`Under section 29C, to which court is my appeal to be made` `General Division` `original jurisdiction` (`scja1 seat Yes`) FALSE) EQUALS JUST `Court of Appeal`
#ASSERT (`Under section 29C, to which court is my appeal to be made` `General Division` `original jurisdiction` (`scja1 seat No`) FALSE) EQUALS JUST `Appellate Division`
#ASSERT (`Under section 29C, to which court is my appeal to be made` `General Division` `appellate jurisdiction` (`scja1 seat No`) TRUE) EQUALS JUST `Court of Appeal`
#ASSERT (`Under section 29C, to which court is my appeal to be made` `General Division` `original jurisdiction` (`scja1 seat I am not sure`) FALSE) EQUALS NOTHING
#ASSERT (`Under section 29C, to which court is my appeal to be made` `District Court` `original jurisdiction` (`scja1 seat No`) FALSE) EQUALS NOTHING
-- a Singapore International Commercial Court decision when the person says the Sixth Schedule sends the appeal to the Court of Appeal: the Schedule's own answer holds
#ASSERT (`Under section 29C, to which court is my appeal to be made` `Singapore International Commercial Court` `original jurisdiction` (`scja1 seat Yes`) FALSE) EQUALS JUST `Court of Appeal`
-- the same decision when the person is not sure of the Schedule: whether the SICC is the General Division is not said, so NOTHING
#ASSERT (`Under section 29C, to which court is my appeal to be made` `Singapore International Commercial Court` `original jurisdiction` (`scja1 seat I am not sure`) FALSE) EQUALS NOTHING
-- s 29D and s 29E
#ASSERT (`Under section 29D, may the Court of Appeal transfer my appeal to itself on my application` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 29D, may the Court of Appeal transfer my appeal to itself on my application` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 29D, may the Court of Appeal transfer my appeal to itself on my application` TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 29D, may the Court of Appeal transfer my appeal to itself on my application` FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`Under section 29E, may the Court of Appeal transfer my appeal to the Appellate Division on my application` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 29E, may the Court of Appeal transfer my appeal to the Appellate Division on my application` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 29E, may the Court of Appeal transfer my appeal to the Appellate Division on my application` FALSE TRUE) EQUALS NOTHING

-- ============================================================
-- scja2: this part's cases seat text, unchanged (merged by concatenation)
-- ============================================================
-- Cases for the seat layer, ss 30 to 72: one or more facts a real person would state for each question, with the answer the text gives, written from the text and not from the code.
-- Where the text does not answer, the case asserts NOTHING (not covered), never FALSE.
-- Calendar facts used: 1 March 2025 is a Saturday, so 8 March 2025 is a Saturday and 9 March 2025 a Sunday; 1 January 2026 is a Thursday, so 3 January 2026 is a Saturday and 5 January 2026 a Monday.


-- Ms Tan lost a civil claim in the General Division's original jurisdiction and appeals against it.
-- s 31(1) and s 35(2): the matter is an appeal against a decision of the General Division in a civil cause or matter.
#ASSERT (`Under section 31(1), does the Appellate Division have the civil jurisdiction over my matter` `General Division` `original jurisdiction` `a civil proceeding` TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 35(2), is my matter one of the matters of the civil jurisdiction of the Appellate Division` `General Division` `original jurisdiction` `a civil proceeding` TRUE FALSE FALSE) EQUALS JUST TRUE
-- the General Division's decision on appeal from a lower court is also within limb (a)
#ASSERT (`Under section 35(2), is my matter one of the matters of the civil jurisdiction of the Appellate Division` `General Division` `appellate jurisdiction` `a civil proceeding` TRUE FALSE FALSE) EQUALS JUST TRUE
-- a decision of a District Court: not within limb (a), and the list is closed by "consists of"
#ASSERT (`Under section 35(2), is my matter one of the matters of the civil jurisdiction of the Appellate Division` `District Court` `original jurisdiction` `a civil proceeding` TRUE FALSE FALSE) EQUALS JUST FALSE
-- the same, but a written law provides that the appeal lies to the Appellate Division: limb (b)
#ASSERT (`Under section 35(2), is my matter one of the matters of the civil jurisdiction of the Appellate Division` `District Court` `original jurisdiction` `a civil proceeding` TRUE TRUE FALSE) EQUALS JUST TRUE
-- the appeal was transferred to the Appellate Division under section 29E(1): limb (b)
#ASSERT (`Under section 31(1), does the Appellate Division have the civil jurisdiction over my matter` `District Court` `original jurisdiction` `a civil proceeding` TRUE FALSE TRUE) EQUALS JUST TRUE
-- a criminal case: section 35(2) says no, and section 31(1) then says nothing of its own
#ASSERT (`Under section 35(2), is my matter one of the matters of the civil jurisdiction of the Appellate Division` `General Division` `original jurisdiction` `a criminal proceeding` TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 31(1), does the Appellate Division have the civil jurisdiction over my matter` `General Division` `original jurisdiction` `a criminal proceeding` TRUE FALSE FALSE) EQUALS NOTHING
-- not covered: whether the Singapore International Commercial Court is the General Division is not settled by the text
#ASSERT (`Under section 35(2), is my matter one of the matters of the civil jurisdiction of the Appellate Division` `Singapore International Commercial Court` `original jurisdiction` `a civil proceeding` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`Under section 31(1), does the Appellate Division have the civil jurisdiction over my matter` `Singapore International Commercial Court` `original jurisdiction` `a civil proceeding` TRUE FALSE FALSE) EQUALS NOTHING
-- s 31(2): "The Appellate Division has no criminal jurisdiction."
#ASSERT (`Under section 31(2), does the Appellate Division have criminal jurisdiction over my case` `a criminal proceeding`) EQUALS JUST FALSE
#ASSERT (`Under section 31(2), does the Appellate Division have criminal jurisdiction over my case` `a civil proceeding`) EQUALS NOTHING
#ASSERT (`Under section 31(2), does the Appellate Division have criminal jurisdiction over my case` `a quasi-criminal proceeding`) EQUALS NOTHING

-- 31(3): in an appeal the Appellate Division has all the jurisdiction and powers of the court appealed from.
#ASSERT (`Under section 31(3), does the Appellate Division have the jurisdiction or power of the court or tribunal my appeal was brought from` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 31(3), does the Appellate Division have the jurisdiction or power of the court or tribunal my appeal was brought from` TRUE FALSE) EQUALS NOTHING
-- 31(4): the Appellate Division may decide any question that needs to be decided to do justice in a case before it.
#ASSERT (`Under section 31(4), may the Appellate Division decide a question that needs to be decided to do justice in my case` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 31(4), may the Appellate Division decide a question that needs to be decided to do justice in my case` FALSE TRUE) EQUALS NOTHING

-- s 32(1): 3 or any greater uneven number of Judges.
#ASSERT (`Under section 32(1), may my case in the Appellate Division be heard by this number of Judges` 3) EQUALS JUST TRUE
#ASSERT (`Under section 32(1), may my case in the Appellate Division be heard by this number of Judges` 5) EQUALS JUST TRUE
-- not covered: an even number, or fewer than 3, is not said to be forbidden in the subsection's own words
#ASSERT (`Under section 32(1), may my case in the Appellate Division be heard by this number of Judges` 4) EQUALS NOTHING
#ASSERT (`Under section 32(1), may my case in the Appellate Division be heard by this number of Judges` 1) EQUALS NOTHING
-- s 32(2): a Judge must not sit on an appeal from the Judge's own decision, or a related matter.
#ASSERT (`Under section 32(2), may a Judge sit in the Appellate Division on my appeal from that Judge's own decision` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 32(2), may a Judge sit in the Appellate Division on my appeal from that Judge's own decision` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 32(2), may a Judge sit in the Appellate Division on my appeal from that Judge's own decision` FALSE FALSE) EQUALS NOTHING
-- s 32(3): section 10A applies to proceedings before the Appellate Division as it applies to the General Division; its answer is passed through.
#ASSERT (`Under section 32(3), may the Appellate Division summon assessors to sit with it on my case` `scja2 seat: yes`) EQUALS JUST TRUE
#ASSERT (`Under section 32(3), may the Appellate Division summon assessors to sit with it on my case` `scja2 seat: no`) EQUALS JUST FALSE
#ASSERT (`Under section 32(3), may the Appellate Division summon assessors to sit with it on my case` `scja2 seat: I am not sure`) EQUALS NOTHING
-- s 33(1) and (2): the majority decides; an evenly divided bench dismisses.
#ASSERT (`Under section 33(1), does the decision of the Appellate Division go the way of the majority of the Judges` 2 1) EQUALS JUST TRUE
#ASSERT (`Under section 33(1), does the decision of the Appellate Division go the way of the majority of the Judges` 1 2) EQUALS JUST FALSE
#ASSERT (`Under section 33(1), does the decision of the Appellate Division go the way of the majority of the Judges` 1 1) EQUALS NOTHING
#ASSERT (`Under section 33(2), is my appeal or application dismissed because the Judges are evenly divided` 2 2) EQUALS JUST TRUE
#ASSERT (`Under section 33(2), is my appeal or application dismissed because the Judges are evenly divided` 3 1) EQUALS JUST FALSE
-- s 36(1): a smaller panel only if the Seventh Schedule so provides.
#ASSERT (`Under section 36(1), may my case in the Appellate Division be heard and decided by this number of Judges` 2 `scja2 seat: yes` `2 Judges`) EQUALS JUST TRUE
#ASSERT (`Under section 36(1), may my case in the Appellate Division be heard and decided by this number of Judges` 1 `scja2 seat: yes` `a single Judge or 2 Judges`) EQUALS JUST TRUE
#ASSERT (`Under section 36(1), may my case in the Appellate Division be heard and decided by this number of Judges` 3 `scja2 seat: yes` `2 Judges`) EQUALS JUST FALSE
#ASSERT (`Under section 36(1), may my case in the Appellate Division be heard and decided by this number of Judges` 1 `scja2 seat: yes` `2 Judges`) EQUALS JUST FALSE
-- the person says the Seventh Schedule does not allow fewer than 3 Judges: the "if" is not met
#ASSERT (`Under section 36(1), may my case in the Appellate Division be heard and decided by this number of Judges` 2 `scja2 seat: no` `2 Judges`) EQUALS JUST FALSE
-- not covered: the person cannot say what the Schedule provides
#ASSERT (`Under section 36(1), may my case in the Appellate Division be heard and decided by this number of Judges` 2 `scja2 seat: I am not sure` `2 Judges`) EQUALS NOTHING
-- s 36(2): a Judge must not sit on an application to discharge or vary the Judge's own direction or order.
#ASSERT (`Under section 36(2), may the Judge who made a direction or order in my case sit on my application to discharge or vary it` TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 36(2), may the Judge who made a direction or order in my case sit on my application to discharge or vary it` FALSE) EQUALS NOTHING
-- s 36(3): of 3 Judges one falls ill; every party consents, so the 2 remaining carry on.
#ASSERT (`Under section 36(3)(a), must the Appellate Division carry on and decide my case after some of its Judges can no longer continue` 3 1 TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 36(3)(b), must my case be reheard after some of the Judges can no longer continue` 3 1 TRUE) EQUALS JUST FALSE
-- only one Judge remains: the case must be reheard
#ASSERT (`Under section 36(3)(a), must the Appellate Division carry on and decide my case after some of its Judges can no longer continue` 3 2 TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 36(3)(b), must my case be reheard after some of the Judges can no longer continue` 3 2 TRUE) EQUALS JUST TRUE
-- a party does not consent
#ASSERT (`Under section 36(3)(b), must my case be reheard after some of the Judges can no longer continue` 3 1 FALSE) EQUALS JUST TRUE
-- s 37(1), (3)
#ASSERT (`Under section 37(1), may the Appellate Division decide my matter without hearing oral arguments` FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 37(1), may the Appellate Division decide my matter without hearing oral arguments` TRUE) EQUALS NOTHING
#ASSERT (`Under section 37(3), may the Appellate Division direct that my matter be heard by exchange of written correspondence` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 37(3), may the Appellate Division direct that my matter be heard by exchange of written correspondence` FALSE) EQUALS NOTHING
-- s 38(1): summary dismissal on the court's own motion if it is satisfied of any of three things.
#ASSERT (`Under section 38(1), may the Appellate Division summarily dismiss my appeal or application on its own motion` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 38(1), may the Appellate Division summarily dismiss my appeal or application on its own motion` TRUE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 38(1), may the Appellate Division summarily dismiss my appeal or application on its own motion` TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- not covered: the court is not acting on its own motion
#ASSERT (`Under section 38(1), may the Appellate Division summarily dismiss my appeal or application on its own motion` FALSE TRUE FALSE FALSE) EQUALS NOTHING
-- s 38(2): an opportunity to show cause, and consideration of the representations
#ASSERT (`Under section 38(2), has the Appellate Division done what it must before summarily dismissing my appeal or application` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 38(2), has the Appellate Division done what it must before summarily dismissing my appeal or application` TRUE FALSE) EQUALS NOTHING
#ASSERT (`Under section 38(2), has the Appellate Division done what it must before summarily dismissing my appeal or application` FALSE TRUE) EQUALS NOTHING

-- s 39: an application that may be made to the General Division or the Appellate Division must first be made to the General Division.
#ASSERT (`Under section 39, must I first make my application to the General Division` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 39, must I first make my application to the General Division` FALSE) EQUALS JUST FALSE

-- s 40(1): in a pending appeal the court may make an incidental direction, an interim order or an order for security for costs.
#ASSERT (`Under section 40(1), may the Appellate Division make this kind of direction or order in my pending appeal or application` TRUE `s 40(1)(b) an interim order to prevent prejudice to the claims of the parties pending the determination of the pending matter`) EQUALS JUST TRUE
#ASSERT (`Under section 40(1), may the Appellate Division make this kind of direction or order in my pending appeal or application` TRUE `s 40(1)(c) an order for security for costs, or for the dismissal of the pending matter for default in furnishing security so ordered`) EQUALS JUST TRUE
-- not covered: another kind of order, or nothing pending
#ASSERT (`Under section 40(1), may the Appellate Division make this kind of direction or order in my pending appeal or application` TRUE `s 40(1) another direction or order`) EQUALS NOTHING
#ASSERT (`Under section 40(1), may the Appellate Division make this kind of direction or order in my pending appeal or application` FALSE `s 40(1)(a) a direction or order incidental to the pending matter not involving the decision of the pending matter`) EQUALS NOTHING
-- s 40(4)(b): an application to vary a single Judge's order may only be made with permission; the decision on permission is final.
#ASSERT (`Under section 40(4)(b), may I apply to vary or discharge a direction or order a single Judge made in my case` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 40(4)(b), may I apply to vary or discharge a direction or order a single Judge made in my case` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 40(4)(b), may I apply to vary or discharge a direction or order a single Judge made in my case` FALSE FALSE) EQUALS NOTHING
#ASSERT (`Under section 40(4)(b), is a Judge's decision to give or refuse me permission to apply to vary or discharge an order final` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 40(4)(b), is a Judge's decision to give or refuse me permission to apply to vary or discharge an order final` FALSE) EQUALS NOTHING
-- s 41(4) and (5): further evidence on appeal.
#ASSERT (`Under section 41(4), may I give further evidence to the Appellate Division on my appeal` FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 41(4), may I give further evidence to the Appellate Division on my appeal` FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 41(4), may I give further evidence to the Appellate Division on my appeal` FALSE FALSE TRUE) EQUALS JUST FALSE
-- subsection (5) applies: subsection (4) does not decide it
#ASSERT (`Under section 41(4), may I give further evidence to the Appellate Division on my appeal` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`Under section 41(5), may I give evidence of matters after the decision I am appealing without permission` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 41(5), may I give evidence of matters after the decision I am appealing without permission` FALSE) EQUALS JUST FALSE
-- s 41(8) and (9): asking the full panel to rehear
#ASSERT (`Under section 41(8), may I ask the full panel to rehear the arguments on my application to adduce further evidence` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 41(8), may I ask the full panel to rehear the arguments on my application to adduce further evidence` FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 41(9), am I barred from asking the full panel to rehear my application to adduce further evidence` 2 2) EQUALS JUST TRUE
#ASSERT (`Under section 41(9), am I barred from asking the full panel to rehear my application to adduce further evidence` 5 3) EQUALS JUST TRUE
#ASSERT (`Under section 41(9), am I barred from asking the full panel to rehear my application to adduce further evidence` 2 3) EQUALS JUST FALSE
-- the bar: 2 Judges decided and 2 hear the appeal (the 2-2 case), or 3 or more decided
#ASSERT (`Under section 41(9), am I barred from asking the full panel to rehear my application to adduce further evidence` 3 3) EQUALS JUST TRUE
-- not barred: a single Judge decided, or 2 decided and 3 hear the appeal
#ASSERT (`Under section 41(9), am I barred from asking the full panel to rehear my application to adduce further evidence` 1 3) EQUALS JUST FALSE
#ASSERT (`Under section 41(9), am I barred from asking the full panel to rehear my application to adduce further evidence` 1 2) EQUALS JUST FALSE
-- s 41(10): the decision was made on Saturday 1 March 2025; 7 days after that date end on Saturday 8 March 2025
#ASSERT (`Under section 41(10), is my request for the full panel to rehear my application to adduce further evidence in time` (Date 8 3 2025) FALSE (Date 1 3 2025) EMPTY) EQUALS JUST TRUE
#ASSERT (`Under section 41(10), is my request for the full panel to rehear my application to adduce further evidence in time` (Date 9 3 2025) FALSE (Date 1 3 2025) EMPTY) EQUALS JUST FALSE
-- 8 March a public holiday and 9 March a Sunday: the last day is Monday 10 March 2025
#ASSERT (`Under section 41(10), is my request for the full panel to rehear my application to adduce further evidence in time` (Date 10 3 2025) FALSE (Date 1 3 2025) (LIST Date 8 3 2025)) EQUALS JUST TRUE
#ASSERT (`Under section 41(10), is my request for the full panel to rehear my application to adduce further evidence in time` (Date 11 3 2025) FALSE (Date 1 3 2025) (LIST Date 8 3 2025)) EQUALS JUST FALSE
-- the judgment or order had already been extracted
#ASSERT (`Under section 41(10), is my request for the full panel to rehear my application to adduce further evidence in time` (Date 3 3 2025) TRUE (Date 1 3 2025) EMPTY) EQUALS JUST FALSE
-- s 42: costs
#ASSERT (`Under section 42, may the Appellate Division make an order as to the costs of my appeal` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 42, may the Appellate Division make an order as to the costs of my appeal` FALSE) EQUALS NOTHING

-- s 43(1): a matter tried by the General Division in its original or appellate civil jurisdiction.
#ASSERT (`Under section 43(1), may the Appellate Division order a new trial of my matter` `General Division` `original jurisdiction` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 43(1), may the Appellate Division order a new trial of my matter` `General Division` `appellate jurisdiction` TRUE) EQUALS JUST TRUE
-- not covered: a criminal matter is outside the power's scope, and the text has no "only" (ruling (c))
#ASSERT (`Under section 43(1), may the Appellate Division order a new trial of my matter` `General Division` `original jurisdiction` FALSE) EQUALS NOTHING
-- not covered: another court, the Singapore International Commercial Court, or supervisory jurisdiction
#ASSERT (`Under section 43(1), may the Appellate Division order a new trial of my matter` `District Court` `original jurisdiction` TRUE) EQUALS NOTHING
#ASSERT (`Under section 43(1), may the Appellate Division order a new trial of my matter` `Singapore International Commercial Court` `original jurisdiction` TRUE) EQUALS NOTHING
-- s 43(2) and (3)(a)
#ASSERT (`Under section 43(2), may a new trial be ordered because evidence was wrongly admitted or rejected` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 43(2), may a new trial be ordered because evidence was wrongly admitted or rejected` TRUE TRUE) EQUALS NOTHING
#ASSERT (`Under section 43(3)(a), may the Appellate Division give final judgment for the part of my case that was not affected` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 43(3)(a), may the Appellate Division give final judgment for the part of my case that was not affected` FALSE) EQUALS JUST FALSE
-- s 44: an error that does not affect the merits or the jurisdiction
#ASSERT (`Under section 44, may the Appellate Division reverse or substantially vary a decision, or order a new trial, because of an error that does not affect the merits` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 44, may the Appellate Division reverse or substantially vary a decision, or order a new trial, because of an error that does not affect the merits` TRUE FALSE) EQUALS NOTHING
-- s 45: no stay unless the court orders one; no intermediate act invalidated unless the court directs
#ASSERT (`Under section 45(1), does my appeal stop the decision I am appealing from being enforced` FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 45(1), does my appeal stop the decision I am appealing from being enforced` TRUE) EQUALS NOTHING
#ASSERT (`Under section 45(2), is an act or step taken in my case while the appeal is pending invalidated` FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 45(2), is an act or step taken in my case while the appeal is pending invalidated` TRUE) EQUALS NOTHING

-- s 46: no appeal against a decision of the Appellate Division in the cases in the Ninth Schedule.
#ASSERT (`Under section 46, can I appeal against the decision of the Appellate Division` `scja2 seat: yes`) EQUALS JUST FALSE
-- not covered: the decision is not in the Ninth Schedule, or the person cannot say
#ASSERT (`Under section 46, can I appeal against the decision of the Appellate Division` `scja2 seat: no`) EQUALS NOTHING
#ASSERT (`Under section 46, can I appeal against the decision of the Appellate Division` `scja2 seat: I am not sure`) EQUALS NOTHING
-- s 47(1): "may only be brought with the permission of the Court of Appeal"
#ASSERT (`Under section 47(1), may I appeal to the Court of Appeal against the decision of the Appellate Division` `appellate jurisdiction` `a civil proceeding` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 47(1), may I appeal to the Court of Appeal against the decision of the Appellate Division` `appellate jurisdiction` `a civil proceeding` FALSE) EQUALS JUST FALSE
-- not covered: the Appellate Division's decision was not in its appellate civil jurisdiction
#ASSERT (`Under section 47(1), may I appeal to the Court of Appeal against the decision of the Appellate Division` `original jurisdiction` `a civil proceeding` FALSE) EQUALS NOTHING
-- s 47(2): permission only if the appeal will raise a point of law of public importance
#ASSERT (`Under section 47(2), may the Court of Appeal grant me permission to appeal from the Appellate Division` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 47(2), may the Court of Appeal grant me permission to appeal from the Appellate Division` FALSE) EQUALS JUST FALSE
-- s 47(4)(b): permission may be granted despite the history of the appeal
#ASSERT (`Under section 47(4)(b), may I be given permission to appeal even though my appeal was transferred to the Appellate Division` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 47(4)(b), may I be given permission to appeal even though my appeal was transferred to the Appellate Division` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 47(4)(b), may I be given permission to appeal even though my appeal was transferred to the Appellate Division` FALSE FALSE) EQUALS NOTHING

-- Mr Lim lost a civil claim in the General Division and appeals against it.
-- s 49(1) with s 53(2).
