#ASSERT (`Under section 73B(3)(a), does the court have to make a further order for my application to be treated as dismissed` `scja3 No`) EQUALS NOTHING
#ASSERT (`Under section 73B(3)(b), must the other party be heard on the merits of my application before it is treated as dismissed` `scja3 Yes`) EQUALS JUST FALSE
#ASSERT (`Under section 73B(3)(b), must the other party be heard on the merits of my application before it is treated as dismissed` `scja3 No`) EQUALS NOTHING
#ASSERT (`Under section 73B(4)(a), does the limited civil restraint order reach these other legal proceedings` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 73B(4)(a), does the limited civil restraint order reach these other legal proceedings` FALSE) EQUALS JUST FALSE
