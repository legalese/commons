#ASSERT (`Under section 73C(2)(a), am I restrained from commencing the action or making the application without permission, because of the extended civil restraint order` TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 73C(2)(a), am I restrained from commencing the action or making the application without permission, because of the extended civil restraint order` FALSE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 73C(2)(a), am I restrained from commencing the action or making the application without permission, because of the extended civil restraint order` TRUE TRUE FALSE FALSE) EQUALS NOTHING
