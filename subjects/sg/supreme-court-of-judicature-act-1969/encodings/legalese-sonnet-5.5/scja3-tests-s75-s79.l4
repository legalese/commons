IMPORT prelude
IMPORT daydate
IMPORT `scja-core`
IMPORT `scja3-s75-s79-officers`

-- scja3-tests-s75-s79.l4: tests for sections 75 to 79.  Expected values are written from the text of the sections
-- (SCJA1969.txt lines 4841-5012) beside each assertion, and not from the module's output.

§ `Tests: sections 75 to 79`

-- ---- s 75 ----
#ASSERT `s 75 the officer is the Registrar, the Deputy Registrar or an Assistant Registrar` Registrar
#ASSERT `s 75 the officer is the Registrar, the Deputy Registrar or an Assistant Registrar` `Deputy Registrar`
#ASSERT `s 75 the officer is the Registrar, the Deputy Registrar or an Assistant Registrar` `Assistant Registrar`
#ASSERT NOT (`s 75 the officer is the Registrar, the Deputy Registrar or an Assistant Registrar` Sheriff)
#ASSERT NOT (`s 75 the officer is the Registrar, the Deputy Registrar or an Assistant Registrar` Interpreter)

#ASSERT (`s 75(1)(a)(i) the officer is capable of accepting or taking any other office of emolument` Registrar FALSE) EQUALS JUST FALSE
#ASSERT (`s 75(1)(a)(i) the officer is capable of accepting or taking any other office of emolument` `Deputy Registrar` FALSE) EQUALS JUST FALSE
#ASSERT (`s 75(1)(a)(i) the officer is capable of accepting or taking any other office of emolument` `Assistant Registrar` FALSE) EQUALS JUST FALSE
#ASSERT (`s 75(1)(a)(i) the officer is capable of accepting or taking any other office of emolument` Registrar TRUE) EQUALS NOTHING
#ASSERT (`s 75(1)(a)(i) the officer is capable of accepting or taking any other office of emolument` Sheriff FALSE) EQUALS NOTHING
#ASSERT (`s 75(1)(a)(ii) the officer is capable of carrying on any business either directly or indirectly` `Assistant Registrar` FALSE) EQUALS JUST FALSE
#ASSERT (`s 75(1)(a)(ii) the officer is capable of carrying on any business either directly or indirectly` `Assistant Registrar` TRUE) EQUALS NOTHING
#ASSERT (`s 75(1)(a)(ii) the officer is capable of carrying on any business either directly or indirectly` Clerk FALSE) EQUALS NOTHING
-- officer, approved, salary or allowances
#ASSERT (`s 75(1)(b) the officer may accept fees of office, perquisites, emoluments or advantages` Registrar FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 75(1)(b) the officer may accept fees of office, perquisites, emoluments or advantages` Registrar TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 75(1)(b) the officer may accept fees of office, perquisites, emoluments or advantages` Registrar FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 75(1)(b) the officer may accept fees of office, perquisites, emoluments or advantages` Sheriff FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 75(2) the officer may be appointed to a commission or tribunal, hold office in a charitable or learned society, and receive an allowance or honorarium` Registrar TRUE) EQUALS JUST TRUE
#ASSERT (`s 75(2) the officer may be appointed to a commission or tribunal, hold office in a charitable or learned society, and receive an allowance or honorarium` `Deputy Registrar` TRUE) EQUALS JUST TRUE
#ASSERT (`s 75(2) the officer may be appointed to a commission or tribunal, hold office in a charitable or learned society, and receive an allowance or honorarium` Registrar FALSE) EQUALS NOTHING
#ASSERT (`s 75(2) the officer may be appointed to a commission or tribunal, hold office in a charitable or learned society, and receive an allowance or honorarium` Sheriff TRUE) EQUALS NOTHING

-- ---- s 76 ----
-- officer, interested, approved, consented
#ASSERT (`s 76 the officer may investigate or hear and determine the proceedings` Registrar TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 76 the officer may investigate or hear and determine the proceedings` `Assistant Registrar` TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 76 the officer may investigate or hear and determine the proceedings` Registrar TRUE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 76 the officer may investigate or hear and determine the proceedings` Registrar TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 76 the officer may investigate or hear and determine the proceedings` Registrar FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 76 the officer may investigate or hear and determine the proceedings` Sheriff TRUE FALSE FALSE) EQUALS NOTHING

-- the regulative twin: the proceedings end at time 10
-- expect: BREACH
#TRACE `s 76 the Registrar must not investigate or hear and determine proceedings in which the Registrar is interested` TRUE FALSE FALSE 10 AT 0 WITH
   PARTY `s 76 the Registrar, the Deputy Registrar or an Assistant Registrar` DOES `s 76 investigates or hears and determines the proceedings` AT 4

-- expect: FULFILLED
#TRACE `s 76 the Registrar must not investigate or hear and determine proceedings in which the Registrar is interested` TRUE FALSE FALSE 10 AT 0 WITH
   (WAITUNTIL 11)

-- with the Chief Justice's approval the duty does not arise
-- expect: FULFILLED
#TRACE `s 76 the Registrar must not investigate or hear and determine proceedings in which the Registrar is interested` TRUE TRUE FALSE 10 AT 0 WITH
   PARTY `s 76 the Registrar, the Deputy Registrar or an Assistant Registrar` DOES `s 76 investigates or hears and determines the proceedings` AT 4

-- with the parties' consent the duty does not arise: the condition is interested AND (NOT approved) AND (NOT consented)
-- expect: FULFILLED
#TRACE `s 76 the Registrar must not investigate or hear and determine proceedings in which the Registrar is interested` TRUE FALSE TRUE 10 AT 0 WITH
   PARTY `s 76 the Registrar, the Deputy Registrar or an Assistant Registrar` DOES `s 76 investigates or hears and determines the proceedings` AT 4

-- not interested: the duty does not arise
-- expect: FULFILLED
#TRACE `s 76 the Registrar must not investigate or hear and determine proceedings in which the Registrar is interested` FALSE FALSE FALSE 10 AT 0 WITH
   PARTY `s 76 the Registrar, the Deputy Registrar or an Assistant Registrar` DOES `s 76 investigates or hears and determines the proceedings` AT 4

-- ---- s 77 ----
#ASSERT (`s 77 the officer may purchase or bid for the property` TRUE) EQUALS JUST FALSE
#ASSERT (`s 77 the officer may purchase or bid for the property` FALSE) EQUALS NOTHING
-- expect: BREACH
#TRACE `s 77 the officer must not purchase or bid for the property` TRUE 8 AT 0 WITH
   PARTY `s 77 the officer of the Supreme Court` DOES `s 77 purchases or bids for the property` AT 3

-- expect: FULFILLED
#TRACE `s 77 the officer must not purchase or bid for the property` TRUE 8 AT 0 WITH
   (WAITUNTIL 9)

-- expect: FULFILLED
#TRACE `s 77 the officer must not purchase or bid for the property` FALSE 8 AT 0 WITH
   PARTY `s 77 the officer of the Supreme Court` DOES `s 77 purchases or bids for the property` AT 3

-- ---- s 78 ----
#ASSERT (`s 78(1) it is lawful for the Registrar to inquire into the matter in a summary way` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 78(1) it is lawful for the Registrar to inquire into the matter in a summary way` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 78(1) it is lawful for the Registrar to inquire into the matter in a summary way` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 78(1) it is lawful for the Registrar to inquire into the matter in a summary way` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 78(2) the Registrar may summon and enforce the attendance of all necessary parties` TRUE) EQUALS JUST TRUE
#ASSERT (`s 78(2) the Registrar may summon and enforce the attendance of all necessary parties` FALSE) EQUALS NOTHING
#ASSERT (`s 78(3) the Registrar may order repayment of the money extorted, due payment of the money levied, and payment of damages and costs` TRUE) EQUALS JUST TRUE
#ASSERT (`s 78(3) the Registrar may order repayment of the money extorted, due payment of the money levied, and payment of damages and costs` FALSE) EQUALS NOTHING
#ASSERT `s 78(3) the Act's maximum fine for each offence` EQUALS 100
#ASSERT (`s 78(3) the Registrar may impose a fine of that amount on the officer for the offence` TRUE 100) EQUALS JUST TRUE
#ASSERT (`s 78(3) the Registrar may impose a fine of that amount on the officer for the offence` TRUE 50) EQUALS JUST TRUE
#ASSERT (`s 78(3) the Registrar may impose a fine of that amount on the officer for the offence` TRUE 101) EQUALS JUST FALSE
#ASSERT (`s 78(3) the Registrar may impose a fine of that amount on the officer for the offence` FALSE 50) EQUALS NOTHING
-- found, allowed fee
#ASSERT (`s 78(4) the officer is incapable of being an officer of the Supreme Court` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 78(4) the officer is incapable of being an officer of the Supreme Court` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 78(4) the officer is incapable of being an officer of the Supreme Court` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 78(5) an appeal lies to the Chief Justice` TRUE) EQUALS JUST TRUE
#ASSERT (`s 78(5) an appeal lies to the Chief Justice` FALSE) EQUALS NOTHING
#ASSERT (`s 78(6) a further appeal lies from the decision of the Chief Justice` TRUE) EQUALS JUST FALSE
#ASSERT (`s 78(6) a further appeal lies from the decision of the Chief Justice` FALSE) EQUALS NOTHING

-- ---- s 79(1) ----
-- person, act in the discharge of judicial duty, good faith belief in jurisdiction
#ASSERT (`s 79(1) the person is not liable to be sued in a court exercising civil jurisdiction for the act` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 79(1) the person is not liable to be sued in a court exercising civil jurisdiction for the act` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 79(1) the person is not liable to be sued in a court exercising civil jurisdiction for the act` FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 79(1) the person is not liable to be sued in a court exercising civil jurisdiction for the act` TRUE FALSE TRUE) EQUALS NOTHING

-- ---- s 79(3) ----
#ASSERT (`s 79(3) the officer is deemed to have acted knowingly in excess of his or her authority` TRUE) EQUALS JUST FALSE
#ASSERT (`s 79(3) the officer is deemed to have acted knowingly in excess of his or her authority` FALSE) EQUALS NOTHING

-- ---- s 79(2): seam 17 ----
-- charged with the duty of executing, claim for execution or damage, appears knowingly in excess, only ground is an ownership dispute
#ASSERT (`s 79(2) the officer is not liable to be sued` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 79(2) the officer is not liable to be sued` TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
-- the only ground is a dispute as to ownership: not deemed to have acted knowingly in excess
#ASSERT (`s 79(2) the officer is not liable to be sued` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 79(2) the officer is not liable to be sued` FALSE TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 79(2) the officer is not liable to be sued` TRUE FALSE FALSE FALSE) EQUALS NOTHING

-- ---- s 79(4) ----
-- appointed, for the purposes, good faith, fraud or wilful misconduct
#ASSERT (`s 79(4) the registered medical practitioner, psychologist, counsellor, social worker or mental health professional is not liable to be sued for the act` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 79(4) the registered medical practitioner, psychologist, counsellor, social worker or mental health professional is not liable to be sued for the act` TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 79(4) the registered medical practitioner, psychologist, counsellor, social worker or mental health professional is not liable to be sued for the act` TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
-- not appointed by the General Division: the "Where" of the subsection is unmet, JUST FALSE (ruling (b) of 2026-11-05; fork S3-B3); an act outside the purposes stays NOTHING
#ASSERT (`s 79(4) the registered medical practitioner, psychologist, counsellor, social worker or mental health professional is not liable to be sued for the act` FALSE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 79(4) the registered medical practitioner, psychologist, counsellor, social worker or mental health professional is not liable to be sued for the act` TRUE FALSE TRUE FALSE) EQUALS NOTHING

-- ---- s 79(5) ----
#ASSERT (`s 79(5) the person is not liable to be sued for the act done for the purposes of the mediation` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 79(5) the person is not liable to be sued for the act done for the purposes of the mediation` TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 79(5) the person is not liable to be sued for the act done for the purposes of the mediation` TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 79(5) the person is not liable to be sued for the act done for the purposes of the mediation` FALSE TRUE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 79(5) the person is not liable to be sued for the act done for the purposes of the mediation` TRUE FALSE TRUE FALSE) EQUALS NOTHING

-- ---- s 79(6) ----
#ASSERT (`s 79(6) the person or entity is immune from legal proceedings in respect of the act or omission` TRUE) EQUALS JUST TRUE
#ASSERT (`s 79(6) the person or entity is immune from legal proceedings in respect of the act or omission` FALSE) EQUALS NOTHING

-- ---- the bar twins, fork S3-B6 (the approval or consent lifts the bar: JUST FALSE here, NOTHING in the grant-side function) ----
-- s 75(1)(a)(i): the officer, the Chief Justice's approval
#ASSERT (`s 75(1)(a)(i) the bar on accepting or taking any other office of emolument applies` Registrar FALSE) EQUALS JUST TRUE
#ASSERT (`s 75(1)(a)(i) the bar on accepting or taking any other office of emolument applies` `Deputy Registrar` FALSE) EQUALS JUST TRUE
#ASSERT (`s 75(1)(a)(i) the bar on accepting or taking any other office of emolument applies` `Assistant Registrar` FALSE) EQUALS JUST TRUE
#ASSERT (`s 75(1)(a)(i) the bar on accepting or taking any other office of emolument applies` Registrar TRUE) EQUALS JUST FALSE
#ASSERT (`s 75(1)(a)(i) the bar on accepting or taking any other office of emolument applies` Sheriff FALSE) EQUALS NOTHING
#ASSERT (`s 75(1)(a)(ii) the bar on carrying on any business either directly or indirectly applies` Registrar FALSE) EQUALS JUST TRUE
#ASSERT (`s 75(1)(a)(ii) the bar on carrying on any business either directly or indirectly applies` Registrar TRUE) EQUALS JUST FALSE
#ASSERT (`s 75(1)(a)(ii) the bar on carrying on any business either directly or indirectly applies` Sheriff FALSE) EQUALS NOTHING
-- s 75(1)(b): the officer, the Chief Justice's approval, the thing is the salary or allowances
#ASSERT (`s 75(1)(b) the bar on accepting fees of office, perquisites, emoluments or advantages applies` Registrar FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 75(1)(b) the bar on accepting fees of office, perquisites, emoluments or advantages applies` Registrar TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 75(1)(b) the bar on accepting fees of office, perquisites, emoluments or advantages applies` Registrar FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 75(1)(b) the bar on accepting fees of office, perquisites, emoluments or advantages applies` Sheriff FALSE FALSE) EQUALS NOTHING
-- s 76: the officer, party or interested, approval, consent
#ASSERT (`s 76 the bar on investigating or hearing and determining the proceedings applies` Registrar TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 76 the bar on investigating or hearing and determining the proceedings applies` `Assistant Registrar` TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 76 the bar on investigating or hearing and determining the proceedings applies` Registrar TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 76 the bar on investigating or hearing and determining the proceedings applies` Registrar TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 76 the bar on investigating or hearing and determining the proceedings applies` Registrar FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 76 the bar on investigating or hearing and determining the proceedings applies` Sheriff TRUE FALSE FALSE) EQUALS NOTHING

