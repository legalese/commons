IMPORT prelude
IMPORT daydate
IMPORT `scja-core`
IMPORT `scja3-sch7-seventh-schedule`

-- scja3-tests-sch7.l4: tests for the Seventh Schedule.  Expected values are written from the text of the Schedule
-- (SCJA1969.txt lines 6270-6481) beside each assertion, and not from the module's output.

§ `Tests: the Seventh Schedule`

`sch 7 test: no paragraph 2(k) facts` MEANS `sch 7 para 2(k) facts` OF FALSE, FALSE, FALSE
`sch 7 test: all of the paragraph 2(k) facts` MEANS `sch 7 para 2(k) facts` OF TRUE, TRUE, TRUE
`sch 7 test: 2 Judges and no oral arguments consented, Appellate Division does not consider it appropriate` MEANS `sch 7 para 2(k) facts` OF TRUE, TRUE, FALSE
`sch 7 test: 2 Judges consented, but not to no oral arguments` MEANS `sch 7 para 2(k) facts` OF TRUE, FALSE, TRUE
`sch 7 test: no oral arguments consented, but not to 2 Judges` MEANS `sch 7 para 2(k) facts` OF FALSE, TRUE, TRUE

-- ---- paragraph 1(1): a single Judge or 2 Judges of the Appellate Division ----
#ASSERT (`sch 7 para 1(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Appellate Division` `sch 7 an application to record a judgment or order made by consent`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 1(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Appellate Division` `sch 7 an application for an order incidental to a judgment or order made by consent`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 1(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Appellate Division` `sch 7 an application to adduce further evidence in proceedings before the court`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 1(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Appellate Division` `sch 7 an application for costs, or any other matter remaining to be dealt with, after an application or appeal is withdrawn`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 1(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Appellate Division` `sch 7 an application for a direction or order mentioned in section 40(1) or 58(1)`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 1(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Appellate Division` `sch 7 an appeal against an interlocutory judgment`) EQUALS JUST FALSE
#ASSERT (`sch 7 para 1(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Appellate Division` `sch 7 another matter`) EQUALS JUST FALSE

-- ---- paragraph 1(2) ----
#ASSERT (`sch 7 para 1(2) the matter is one of the two powers a single Judge or 2 Judges of the Appellate Division may exercise` `sch 7 referring an appeal to the Court of Appeal under section 29D(2)(b)`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 1(2) the matter is one of the two powers a single Judge or 2 Judges of the Appellate Division may exercise` `sch 7 deciding under paragraph 2(k)(ii) whether it is appropriate for 2 Judges to hear and decide an appeal`) EQUALS JUST TRUE
-- the Court of Appeal's transfer power is paragraph 3(2), not paragraph 1(2)
#ASSERT (`sch 7 para 1(2) the matter is one of the two powers a single Judge or 2 Judges of the Appellate Division may exercise` `sch 7 the power under section 29D(1) to transfer to the Court of Appeal an appeal made to the Appellate Division`) EQUALS JUST FALSE

-- ---- paragraph 1(3) and 3(3): a single Judge alone ----
#ASSERT (`sch 7 para 1(3) the matter is an application to vary or discharge a Registrar's direction, for a single Judge of the Appellate Division` `sch 7 an application to vary or discharge a direction or order made by the Registrar, the Deputy Registrar or an Assistant Registrar`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 1(3) the matter is an application to vary or discharge a Registrar's direction, for a single Judge of the Appellate Division` `sch 7 an application to extend the time for filing and serving a notice of appeal`) EQUALS JUST FALSE
#ASSERT (`sch 7 para 3(3) the matter is an application to vary or discharge a Registrar's direction, for a single Judge of the Court of Appeal` `sch 7 an application to vary or discharge a direction or order made by the Registrar, the Deputy Registrar or an Assistant Registrar`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 3(3) the matter is an application to vary or discharge a Registrar's direction, for a single Judge of the Court of Appeal` `sch 7 another matter`) EQUALS JUST FALSE

-- ---- paragraph 2 (a) to (k): 2 Judges of the Appellate Division ----
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 an application to extend the time for filing and serving a notice of appeal` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 an application to discharge or vary a direction or order made under section 40(1) or 58(1) by a single Judge` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 an application for permission to appeal, to extend time for applying for it, or for a declaration that it is not required` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 an application for a stay of execution or enforcement, or of proceedings under the decision appealed from` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 an appeal against an interlocutory judgment` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 an appeal against a judgment or order obtained after an application for admission under section 15 of the Legal Profession Act 1966` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 an appeal against a judgment or order obtained after an assessment of damages` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 an appeal against a judgment or order obtained after a taking of accounts between parties` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 an appeal against a judgment or order obtained after proceedings other than the trial or hearing of an action or matter commenced by originating process` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 an appeal which under a written law may be heard and decided by 2 Judges` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST TRUE
-- (k): all three facts are needed
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 any other appeal` `sch 7 test: all of the paragraph 2(k) facts`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 any other appeal` `sch 7 test: 2 Judges and no oral arguments consented, Appellate Division does not consider it appropriate`) EQUALS JUST FALSE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 any other appeal` `sch 7 test: 2 Judges consented, but not to no oral arguments`) EQUALS JUST FALSE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 any other appeal` `sch 7 test: no oral arguments consented, but not to 2 Judges`) EQUALS JUST FALSE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 any other appeal` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST FALSE
#ASSERT (`sch 7 para 2 the matter is one of cases (a) to (k), for 2 Judges of the Appellate Division` `sch 7 an application to record a judgment or order made by consent` `sch 7 test: all of the paragraph 2(k) facts`) EQUALS JUST FALSE

-- ---- paragraph 3(1) and 3(2) ----
#ASSERT (`sch 7 para 3(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Court of Appeal` `sch 7 an application to record a judgment or order made by consent`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 3(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Court of Appeal` `sch 7 an application for an order incidental to a judgment or order made by consent`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 3(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Court of Appeal` `sch 7 an application to adduce further evidence in proceedings before the court`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 3(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Court of Appeal` `sch 7 an application for costs, or any other matter remaining to be dealt with, after an application or appeal is withdrawn`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 3(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Court of Appeal` `sch 7 an application for a direction or order mentioned in section 40(1) or 58(1)`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 3(1) the matter is one of cases (a) to (d), for a single Judge or 2 Judges of the Court of Appeal` `sch 7 an appeal against an interlocutory judgment`) EQUALS JUST FALSE
#ASSERT (`sch 7 para 3(2) the matter is one of the two transfer powers a single Judge or 2 Judges of the Court of Appeal may exercise` `sch 7 the power under section 29D(1) to transfer to the Court of Appeal an appeal made to the Appellate Division`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 3(2) the matter is one of the two transfer powers a single Judge or 2 Judges of the Court of Appeal may exercise` `sch 7 the power under section 29E(1) to transfer to the Appellate Division an appeal made to the Court of Appeal`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 3(2) the matter is one of the two transfer powers a single Judge or 2 Judges of the Court of Appeal may exercise` `sch 7 referring an appeal to the Court of Appeal under section 29D(2)(b)`) EQUALS JUST FALSE

-- ---- paragraph 4 (a) to (j): 2 Judges of the Court of Appeal ----
#ASSERT (`sch 7 para 4 the matter is one of cases (a) to (j), for 2 Judges of the Court of Appeal` `sch 7 an application to extend the time for filing and serving a notice of appeal`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 4 the matter is one of cases (a) to (j), for 2 Judges of the Court of Appeal` `sch 7 an application to discharge or vary a direction or order made under section 40(1) or 58(1) by a single Judge`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 4 the matter is one of cases (a) to (j), for 2 Judges of the Court of Appeal` `sch 7 an application for permission to appeal, to extend time for applying for it, or for a declaration that it is not required`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 4 the matter is one of cases (a) to (j), for 2 Judges of the Court of Appeal` `sch 7 an application for a stay of execution or enforcement, or of proceedings under the decision appealed from`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 4 the matter is one of cases (a) to (j), for 2 Judges of the Court of Appeal` `sch 7 an appeal against an interlocutory judgment`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 4 the matter is one of cases (a) to (j), for 2 Judges of the Court of Appeal` `sch 7 an appeal against a judgment or order obtained after an application for admission under section 15 of the Legal Profession Act 1966`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 4 the matter is one of cases (a) to (j), for 2 Judges of the Court of Appeal` `sch 7 an appeal against a judgment or order obtained after an assessment of damages`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 4 the matter is one of cases (a) to (j), for 2 Judges of the Court of Appeal` `sch 7 an appeal against a judgment or order obtained after a taking of accounts between parties`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 4 the matter is one of cases (a) to (j), for 2 Judges of the Court of Appeal` `sch 7 an appeal against a judgment or order obtained after proceedings other than the trial or hearing of an action or matter commenced by originating process`) EQUALS JUST TRUE
#ASSERT (`sch 7 para 4 the matter is one of cases (a) to (j), for 2 Judges of the Court of Appeal` `sch 7 an appeal which under a written law may be heard and decided by 2 Judges`) EQUALS JUST TRUE
-- paragraph 4 has no case (k): consent does not bring an "other appeal" within it
#ASSERT (`sch 7 para 4 the matter is one of cases (a) to (j), for 2 Judges of the Court of Appeal` `sch 7 any other appeal`) EQUALS JUST FALSE
#ASSERT (`sch 7 para 4 the matter is one of cases (a) to (j), for 2 Judges of the Court of Appeal` `sch 7 an application to record a judgment or order made by consent`) EQUALS JUST FALSE

-- ---- the smaller panel the Schedule allows (seam 14) ----
-- Appellate Division
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Appellate Division` `sch 7 an application to record a judgment or order made by consent` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST `a single Judge or 2 Judges`
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Appellate Division` `sch 7 referring an appeal to the Court of Appeal under section 29D(2)(b)` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST `a single Judge or 2 Judges`
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Appellate Division` `sch 7 an application to vary or discharge a direction or order made by the Registrar, the Deputy Registrar or an Assistant Registrar` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST `a single Judge`
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Appellate Division` `sch 7 an application to extend the time for filing and serving a notice of appeal` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST `2 Judges`
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Appellate Division` `sch 7 any other appeal` `sch 7 test: all of the paragraph 2(k) facts`) EQUALS JUST `2 Judges`
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Appellate Division` `sch 7 any other appeal` `sch 7 test: no paragraph 2(k) facts`) EQUALS NOTHING
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Appellate Division` `sch 7 the power under section 29E(1) to transfer to the Appellate Division an appeal made to the Court of Appeal` `sch 7 test: no paragraph 2(k) facts`) EQUALS NOTHING
-- Court of Appeal
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Court of Appeal` `sch 7 an application to adduce further evidence in proceedings before the court` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST `a single Judge or 2 Judges`
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Court of Appeal` `sch 7 the power under section 29E(1) to transfer to the Appellate Division an appeal made to the Court of Appeal` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST `a single Judge or 2 Judges`
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Court of Appeal` `sch 7 an application to vary or discharge a direction or order made by the Registrar, the Deputy Registrar or an Assistant Registrar` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST `a single Judge`
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Court of Appeal` `sch 7 an appeal against an interlocutory judgment` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST `2 Judges`
-- the Court of Appeal has no paragraph 2(k): the consents make no difference
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Court of Appeal` `sch 7 any other appeal` `sch 7 test: all of the paragraph 2(k) facts`) EQUALS NOTHING
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `Court of Appeal` `sch 7 referring an appeal to the Court of Appeal under section 29D(2)(b)` `sch 7 test: no paragraph 2(k) facts`) EQUALS NOTHING
-- any other court: the Schedule does not speak of it
#ASSERT (`sch 7 the smaller panel the Seventh Schedule allows` `General Division` `sch 7 an application to record a judgment or order made by consent` `sch 7 test: no paragraph 2(k) facts`) EQUALS NOTHING

-- ---- the yes/no twin ----
#ASSERT (`sch 7 the Seventh Schedule allows fewer than 3 Judges` `Appellate Division` `sch 7 an application to record a judgment or order made by consent` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST TRUE
#ASSERT (`sch 7 the Seventh Schedule allows fewer than 3 Judges` `Court of Appeal` `sch 7 an appeal against an interlocutory judgment` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST TRUE
#ASSERT (`sch 7 the Seventh Schedule allows fewer than 3 Judges` `Appellate Division` `sch 7 another matter` `sch 7 test: no paragraph 2(k) facts`) EQUALS JUST FALSE
#ASSERT (`sch 7 the Seventh Schedule allows fewer than 3 Judges` `Court of Appeal` `sch 7 any other appeal` `sch 7 test: all of the paragraph 2(k) facts`) EQUALS JUST FALSE
#ASSERT (`sch 7 the Seventh Schedule allows fewer than 3 Judges` `General Division` `sch 7 an application to record a judgment or order made by consent` `sch 7 test: no paragraph 2(k) facts`) EQUALS NOTHING
#ASSERT (`sch 7 the Seventh Schedule allows fewer than 3 Judges` `District Court` `sch 7 another matter` `sch 7 test: no paragraph 2(k) facts`) EQUALS NOTHING
