#ASSERT (`s 73B(4)(b) the order remains in effect` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 73B(4)(b) the order remains in effect` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73B(4)(b) the order remains in effect` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 73B(4)(b) the order remains in effect` FALSE TRUE) EQUALS JUST FALSE
