IMPORT prelude
IMPORT daydate
IMPORT `scja-core`
IMPORT `scja3-s73a-d-restraint`

-- scja3-tests-s73a-d.l4: tests for sections 73A to 73D.  Expected values are written from the text of the sections
-- (SCJA1969.txt lines 4382-4764) beside each assertion, and not from the module's output.

§ `Tests: sections 73A to 73D`

-- ---- the court gate ----
#ASSERT (`s 73A the court is a court within the section` `General Division`) EQUALS JUST TRUE
#ASSERT (`s 73A the court is a court within the section` `Appellate Division`) EQUALS JUST TRUE
#ASSERT (`s 73A the court is a court within the section` `Court of Appeal`) EQUALS JUST TRUE
#ASSERT (`s 73A the court is a court within the section` `Singapore International Commercial Court`) EQUALS JUST TRUE
#ASSERT (`s 73A the court is a court within the section` `Family Division of the High Court`) EQUALS NOTHING
-- s 2: "“court” means the General Division, the Appellate Division, or the Court of Appeal", so a subordinate court is outside it and the answer is JUST FALSE (fork S3-B1); the Family Division of the High Court stays NOTHING (undefined term)
#ASSERT (`s 73A the court is a court within the section` `District Court`) EQUALS JUST FALSE
#ASSERT (`s 73A the court is a court within the section` `Family Court`) EQUALS JUST FALSE
#ASSERT (`s 73A the court is a court within the section` `Magistrate's Court`) EQUALS JUST FALSE
#ASSERT (`s 73A the court is a court within the section` `another subordinate court, tribunal or judicial or quasi-judicial body`) EQUALS JUST FALSE
#ASSERT (`s 73A the court is the General Division` `General Division`) EQUALS JUST TRUE
#ASSERT (`s 73A the court is the General Division` `Singapore International Commercial Court`) EQUALS JUST TRUE
#ASSERT (`s 73A the court is the General Division` `Appellate Division`) EQUALS NOTHING
#ASSERT (`s 73A the court is the General Division` `Court of Appeal`) EQUALS NOTHING
#ASSERT (`s 73A the court is the General Division` `Family Division of the High Court`) EQUALS NOTHING
#ASSERT (`s 73A the court is the General Division` `District Court`) EQUALS NOTHING
#ASSERT (`s 73A the answer holds where the court is within the section` (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 73A the answer holds where the court is within the section` (JUST TRUE) NOTHING) EQUALS NOTHING
#ASSERT (`s 73A the answer holds where the court is within the section` NOTHING (JUST TRUE)) EQUALS NOTHING

-- ---- 73A(1) to (3) ----
#ASSERT (`s 73A(1) the court may make a limited, extended or general civil restraint order in respect of the legal proceedings` `General Division` TRUE) EQUALS JUST TRUE
#ASSERT (`s 73A(1) the court may make a limited, extended or general civil restraint order in respect of the legal proceedings` `Appellate Division` TRUE) EQUALS JUST TRUE
#ASSERT (`s 73A(1) the court may make a limited, extended or general civil restraint order in respect of the legal proceedings` `Court of Appeal` TRUE) EQUALS JUST TRUE
#ASSERT (`s 73A(1) the court may make a limited, extended or general civil restraint order in respect of the legal proceedings` `Singapore International Commercial Court` TRUE) EQUALS JUST TRUE
#ASSERT (`s 73A(1) the court may make a limited, extended or general civil restraint order in respect of the legal proceedings` `General Division` FALSE) EQUALS NOTHING
#ASSERT (`s 73A(1) the court may make a limited, extended or general civil restraint order in respect of the legal proceedings` `Family Division of the High Court` TRUE) EQUALS NOTHING
#ASSERT (`s 73A(1) the court may make a limited, extended or general civil restraint order in respect of the legal proceedings` `District Court` TRUE) EQUALS JUST FALSE
#ASSERT (`s 73A(2) the court may order the legal proceedings stayed on such terms as it considers appropriate` `General Division` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 73A(2) the court may order the legal proceedings stayed on such terms as it considers appropriate` `Court of Appeal` TRUE TRUE) EQUALS JUST TRUE
-- "if satisfied"
#ASSERT (`s 73A(2) the court may order the legal proceedings stayed on such terms as it considers appropriate` `General Division` TRUE FALSE) EQUALS JUST FALSE
-- proceedings in another court
#ASSERT (`s 73A(2) the court may order the legal proceedings stayed on such terms as it considers appropriate` `General Division` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 73A(2) the court may order the legal proceedings stayed on such terms as it considers appropriate` `District Court` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 73A(3) the court may order that no further documents be filed by the party in relation to the legal proceedings` `Appellate Division` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 73A(3) the court may order that no further documents be filed by the party in relation to the legal proceedings` `Appellate Division` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73A(3) the court may order that no further documents be filed by the party in relation to the legal proceedings` `Appellate Division` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 73A(3) the court may order that no further documents be filed by the party in relation to the legal proceedings` `Family Division of the High Court` TRUE TRUE) EQUALS NOTHING

-- ---- 73A(4) to (6): the General Division and proceedings in a subordinate court ----
#ASSERT (`s 73A(4) the General Division may make a limited, extended or general civil restraint order in respect of the legal proceedings in a subordinate court` `General Division` TRUE) EQUALS JUST TRUE
#ASSERT (`s 73A(4) the General Division may make a limited, extended or general civil restraint order in respect of the legal proceedings in a subordinate court` `Singapore International Commercial Court` TRUE) EQUALS JUST TRUE
#ASSERT (`s 73A(4) the General Division may make a limited, extended or general civil restraint order in respect of the legal proceedings in a subordinate court` `General Division` FALSE) EQUALS NOTHING
#ASSERT (`s 73A(4) the General Division may make a limited, extended or general civil restraint order in respect of the legal proceedings in a subordinate court` `Appellate Division` TRUE) EQUALS NOTHING
#ASSERT (`s 73A(4) the General Division may make a limited, extended or general civil restraint order in respect of the legal proceedings in a subordinate court` `Court of Appeal` TRUE) EQUALS NOTHING
#ASSERT (`s 73A(5) the General Division may order the legal proceedings in a subordinate court stayed on such terms as it considers appropriate` `General Division` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 73A(5) the General Division may order the legal proceedings in a subordinate court stayed on such terms as it considers appropriate` `General Division` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73A(5) the General Division may order the legal proceedings in a subordinate court stayed on such terms as it considers appropriate` `General Division` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 73A(5) the General Division may order the legal proceedings in a subordinate court stayed on such terms as it considers appropriate` `Appellate Division` TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 73A(6) the General Division may order that no further documents be filed by the party in relation to the legal proceedings in a subordinate court` `General Division` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 73A(6) the General Division may order that no further documents be filed by the party in relation to the legal proceedings in a subordinate court` `General Division` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73A(6) the General Division may order that no further documents be filed by the party in relation to the legal proceedings in a subordinate court` `General Division` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 73A(6) the General Division may order that no further documents be filed by the party in relation to the legal proceedings in a subordinate court` `Court of Appeal` TRUE TRUE) EQUALS NOTHING

-- ---- 73A(7): the order, on whose motion, after a hearing ----
-- own motion
#ASSERT (`s 73A(7) the court may make the order against the other party` `General Division` TRUE TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
-- the Attorney-General applies
#ASSERT (`s 73A(7) the court may make the order against the other party` `General Division` TRUE FALSE TRUE FALSE TRUE) EQUALS JUST TRUE
-- a party applies
#ASSERT (`s 73A(7) the court may make the order against the other party` `General Division` TRUE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
-- "after giving the other party an opportunity to be heard": not yet heard
#ASSERT (`s 73A(7) the court may make the order against the other party` `General Division` TRUE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- nobody who is named made the application
#ASSERT (`s 73A(7) the court may make the order against the other party` `General Division` TRUE FALSE FALSE FALSE TRUE) EQUALS NOTHING
-- not an order mentioned in the subsection
#ASSERT (`s 73A(7) the court may make the order against the other party` `General Division` FALSE TRUE FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 73A(7) the court may make the order against the other party` `District Court` TRUE TRUE FALSE FALSE TRUE) EQUALS JUST FALSE

-- ---- 73A(8): the General Division, proceedings in a subordinate court: no own motion ----
#ASSERT (`s 73A(8) the General Division may make the order against the other party` `General Division` TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 73A(8) the General Division may make the order against the other party` `General Division` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
-- not yet heard
#ASSERT (`s 73A(8) the General Division may make the order against the other party` `General Division` TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
-- no application by the Attorney-General or a party: the subsection names no own motion
#ASSERT (`s 73A(8) the General Division may make the order against the other party` `General Division` TRUE FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 73A(8) the General Division may make the order against the other party` `General Division` FALSE TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 73A(8) the General Division may make the order against the other party` `Appellate Division` TRUE TRUE FALSE TRUE) EQUALS NOTHING

-- ---- 73A(9) and (9A): appeal only with permission ----
#ASSERT (`s 73A(9) the court whose permission is needed to appeal against an order of the General Division` `General Division` TRUE (JUST `Appellate Division`)) EQUALS JUST `Appellate Division`
#ASSERT (`s 73A(9) the court whose permission is needed to appeal against an order of the General Division` `General Division` TRUE (JUST `Court of Appeal`)) EQUALS JUST `Court of Appeal`
#ASSERT (`s 73A(9) the court whose permission is needed to appeal against an order of the General Division` `Singapore International Commercial Court` TRUE (JUST `Court of Appeal`)) EQUALS JUST `Court of Appeal`
-- the court of s 29C is not known
#ASSERT (`s 73A(9) the court whose permission is needed to appeal against an order of the General Division` `General Division` TRUE NOTHING) EQUALS NOTHING
-- not an order the subsection mentions
#ASSERT (`s 73A(9) the court whose permission is needed to appeal against an order of the General Division` `General Division` FALSE (JUST `Appellate Division`)) EQUALS NOTHING
-- an order of the Appellate Division is subsection (9A)'s
#ASSERT (`s 73A(9) the court whose permission is needed to appeal against an order of the General Division` `Appellate Division` TRUE (JUST `Appellate Division`)) EQUALS NOTHING
-- "only with the permission"
#ASSERT (`s 73A(9) the party may appeal against the order of the General Division without permission` `General Division` TRUE) EQUALS JUST FALSE
#ASSERT (`s 73A(9) the party may appeal against the order of the General Division without permission` `General Division` FALSE) EQUALS NOTHING
#ASSERT (`s 73A(9) the party may appeal against the order of the General Division without permission` `Appellate Division` TRUE) EQUALS NOTHING
#ASSERT (`s 73A(9A) the court whose permission is needed to appeal against an order of the Appellate Division` `Appellate Division` TRUE) EQUALS JUST `Court of Appeal`
#ASSERT (`s 73A(9A) the court whose permission is needed to appeal against an order of the Appellate Division` `Appellate Division` FALSE) EQUALS NOTHING
#ASSERT (`s 73A(9A) the court whose permission is needed to appeal against an order of the Appellate Division` `General Division` TRUE) EQUALS NOTHING
#ASSERT (`s 73A(9A) the party may appeal against the order of the Appellate Division without permission` `Appellate Division` TRUE) EQUALS JUST FALSE
#ASSERT (`s 73A(9A) the party may appeal against the order of the Appellate Division without permission` `Appellate Division` FALSE) EQUALS NOTHING
#ASSERT (`s 73A(9A) the party may appeal against the order of the Appellate Division without permission` `General Division` TRUE) EQUALS NOTHING

-- ---- 73A(10): legal proceedings ----
#ASSERT (`s 73A(10) the thing is within legal proceedings for ss 73A, 73B and 73C` `s 73A(10) proceedings` `a civil proceeding`) EQUALS JUST TRUE
#ASSERT (`s 73A(10) the thing is within legal proceedings for ss 73A, 73B and 73C` `s 73A(10) proceedings` `a quasi-criminal proceeding`) EQUALS JUST TRUE
#ASSERT (`s 73A(10) the thing is within legal proceedings for ss 73A, 73B and 73C` `s 73A(10) process` `a civil proceeding`) EQUALS JUST TRUE
#ASSERT (`s 73A(10) the thing is within legal proceedings for ss 73A, 73B and 73C` `s 73A(10) process` `a quasi-criminal proceeding`) EQUALS JUST TRUE
#ASSERT (`s 73A(10) the thing is within legal proceedings for ss 73A, 73B and 73C` `s 73A(10) action` `a civil proceeding`) EQUALS JUST TRUE
#ASSERT (`s 73A(10) the thing is within legal proceedings for ss 73A, 73B and 73C` `s 73A(10) action` `a quasi-criminal proceeding`) EQUALS JUST TRUE
#ASSERT (`s 73A(10) the thing is within legal proceedings for ss 73A, 73B and 73C` `s 73A(10) application` `a civil proceeding`) EQUALS JUST TRUE
#ASSERT (`s 73A(10) the thing is within legal proceedings for ss 73A, 73B and 73C` `s 73A(10) application` `a quasi-criminal proceeding`) EQUALS JUST TRUE
#ASSERT (`s 73A(10) the thing is within legal proceedings for ss 73A, 73B and 73C` `s 73A(10) appeal` `a civil proceeding`) EQUALS JUST TRUE
#ASSERT (`s 73A(10) the thing is within legal proceedings for ss 73A, 73B and 73C` `s 73A(10) appeal` `a quasi-criminal proceeding`) EQUALS JUST TRUE
-- the subsection names a civil matter or a quasi-criminal matter, and "includes" never closes the list
#ASSERT (`s 73A(10) the thing is within legal proceedings for ss 73A, 73B and 73C` `s 73A(10) action` `a criminal proceeding`) EQUALS NOTHING
-- "includes"
#ASSERT (`s 73A(10) the thing is within legal proceedings for ss 73A, 73B and 73C` `s 73A(10) another kind of thing` `a civil proceeding`) EQUALS NOTHING

-- ==== section 73B ====
#ASSERT (`s 73B(1) the Act's number of applications totally without merit`) EQUALS 2
-- exactly 2: "2 or more"
#ASSERT (`s 73B(1) the court may make a limited civil restraint order against the party` `General Division` 2) EQUALS JUST TRUE
#ASSERT (`s 73B(1) the court may make a limited civil restraint order against the party` `General Division` 5) EQUALS JUST TRUE
-- "if satisfied that a party has made 2 or more"
#ASSERT (`s 73B(1) the court may make a limited civil restraint order against the party` `General Division` 1) EQUALS JUST FALSE
#ASSERT (`s 73B(1) the court may make a limited civil restraint order against the party` `General Division` 0) EQUALS JUST FALSE
#ASSERT (`s 73B(1) the court may make a limited civil restraint order against the party` `Court of Appeal` 3) EQUALS JUST TRUE
#ASSERT (`s 73B(1) the court may make a limited civil restraint order against the party` `Family Division of the High Court` 3) EQUALS NOTHING
#ASSERT (`s 73B(1) the court may make a limited civil restraint order against the party` `District Court` 3) EQUALS JUST FALSE
-- subject, a further application in those proceedings, no permission
#ASSERT (`s 73B(2)(a) the party may make the further application in the legal proceedings` TRUE TRUE FALSE) EQUALS JUST FALSE
-- with permission the restraint is lifted and the text grants nothing
#ASSERT (`s 73B(2)(a) the party may make the further application in the legal proceedings` TRUE TRUE TRUE) EQUALS NOTHING
-- not subject to the order
#ASSERT (`s 73B(2)(a) the party may make the further application in the legal proceedings` FALSE TRUE FALSE) EQUALS NOTHING
-- an application in other proceedings
#ASSERT (`s 73B(2)(a) the party may make the further application in the legal proceedings` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 73B(2)(b) the party may apply to amend, vary or discharge the order` TRUE TRUE) EQUALS JUST TRUE
-- "only if"
#ASSERT (`s 73B(2)(b) the party may apply to amend, vary or discharge the order` TRUE FALSE) EQUALS JUST FALSE
-- "Where a court makes ... the party against whom the order is made ... may apply": no such order, so the "Where" is unmet and the answer is JUST FALSE (ruling (b) of 2026-11-05; fork S3-B3)
#ASSERT (`s 73B(2)(b) the party may apply to amend, vary or discharge the order` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 73B(2)(b) the party may apply to amend, vary or discharge the order` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73B(3) the application is to be treated as dismissed` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
-- with permission
#ASSERT (`s 73B(3) the application is to be treated as dismissed` TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
-- not subject
#ASSERT (`s 73B(3) the application is to be treated as dismissed` FALSE TRUE TRUE FALSE) EQUALS JUST FALSE
-- an application for the permission itself
#ASSERT (`s 73B(3) the application is to be treated as dismissed` TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
-- in other proceedings
#ASSERT (`s 73B(3) the application is to be treated as dismissed` TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
-- "without the court having to make any further order"
#ASSERT (`s 73B(3)(a) the court has to make a further order for the application to be treated as dismissed` (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 73B(3)(a) the court has to make a further order for the application to be treated as dismissed` (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 73B(3)(a) the court has to make a further order for the application to be treated as dismissed` NOTHING) EQUALS NOTHING
-- "without the need for any other party to be heard on the merits"
#ASSERT (`s 73B(3)(b) any other party must be heard on the merits of the application` (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 73B(3)(b) any other party must be heard on the merits of the application` (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 73B(3)(b) any other party must be heard on the merits of the application` NOTHING) EQUALS NOTHING
#ASSERT (`s 73B(4)(a) the order reaches the legal proceedings` TRUE) EQUALS JUST TRUE
-- "limited to the particular legal proceedings", with no "only"
-- "is limited to the particular legal proceedings": "limited to" says "only", so other proceedings are outside it, JUST FALSE (fork S3-B5)
#ASSERT (`s 73B(4)(a) the order reaches the legal proceedings` FALSE) EQUALS JUST FALSE
#ASSERT (`s 73B(4)(b) the order remains in effect` TRUE FALSE) EQUALS JUST TRUE
-- the duration of the proceedings has ended
#ASSERT (`s 73B(4)(b) the order remains in effect` FALSE FALSE) EQUALS JUST FALSE
-- "unless the court orders otherwise"
-- "unless the court orders otherwise": the court has ordered otherwise, so the order no longer remains in effect for that duration, JUST FALSE (fork S3-B2)
#ASSERT (`s 73B(4)(b) the order remains in effect` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 73B(4)(b) the order remains in effect` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 73B(5) and (6) the court whose permission is needed to appeal against the refusal` `General Division` TRUE (JUST `Appellate Division`)) EQUALS JUST `Appellate Division`
#ASSERT (`s 73B(5) and (6) the court whose permission is needed to appeal against the refusal` `General Division` TRUE (JUST `Court of Appeal`)) EQUALS JUST `Court of Appeal`
-- subsection (6): the Court of Appeal, whatever s 29C says
#ASSERT (`s 73B(5) and (6) the court whose permission is needed to appeal against the refusal` `Appellate Division` TRUE (JUST `Appellate Division`)) EQUALS JUST `Court of Appeal`
#ASSERT (`s 73B(5) and (6) the court whose permission is needed to appeal against the refusal` `Appellate Division` TRUE NOTHING) EQUALS JUST `Court of Appeal`
#ASSERT (`s 73B(5) and (6) the court whose permission is needed to appeal against the refusal` `General Division` TRUE NOTHING) EQUALS NOTHING
-- permission was not refused
#ASSERT (`s 73B(5) and (6) the court whose permission is needed to appeal against the refusal` `General Division` FALSE (JUST `Court of Appeal`)) EQUALS NOTHING
#ASSERT (`s 73B(5) and (6) the court whose permission is needed to appeal against the refusal` `Court of Appeal` TRUE (JUST `Court of Appeal`)) EQUALS NOTHING
#ASSERT (`s 73B(5) and (6) the court whose permission is needed to appeal against the refusal` `District Court` TRUE (JUST `Court of Appeal`)) EQUALS NOTHING
#ASSERT (`s 73B(5) and (6) the party may appeal against the refusal without permission` `General Division` TRUE) EQUALS JUST FALSE
#ASSERT (`s 73B(5) and (6) the party may appeal against the refusal without permission` `Appellate Division` TRUE) EQUALS JUST FALSE
#ASSERT (`s 73B(5) and (6) the party may appeal against the refusal without permission` `General Division` FALSE) EQUALS NOTHING
#ASSERT (`s 73B(5) and (6) the party may appeal against the refusal without permission` `Court of Appeal` TRUE) EQUALS NOTHING

-- ==== section 73C ====
#ASSERT (`s 73C(1) the court may make an extended civil restraint order against the party` `General Division` TRUE) EQUALS JUST TRUE
-- "if satisfied that a party has persistently"
#ASSERT (`s 73C(1) the court may make an extended civil restraint order against the party` `General Division` FALSE) EQUALS JUST FALSE
#ASSERT (`s 73C(1) the court may make an extended civil restraint order against the party` `Family Division of the High Court` TRUE) EQUALS NOTHING
#ASSERT (`s 73C(1) the court may make an extended civil restraint order against the party` `District Court` TRUE) EQUALS JUST FALSE
#ASSERT (`s 73C(2)(a) the party may commence the action or make the application` TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73C(2)(a) the party may commence the action or make the application` TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 73C(2)(a) the party may commence the action or make the application` FALSE TRUE TRUE FALSE) EQUALS NOTHING
-- a court the order does not specify
#ASSERT (`s 73C(2)(a) the party may commence the action or make the application` TRUE FALSE TRUE FALSE) EQUALS NOTHING
-- an unrelated matter
#ASSERT (`s 73C(2)(a) the party may commence the action or make the application` TRUE TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 73C(2)(b) the party may apply to amend, vary or discharge the order` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 73C(2)(b) the party may apply to amend, vary or discharge the order` TRUE FALSE) EQUALS JUST FALSE
-- no extended civil restraint order: the "Where" is unmet, JUST FALSE (fork S3-B3)
#ASSERT (`s 73C(2)(b) the party may apply to amend, vary or discharge the order` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 73C(3) the action or application is to be treated as struck out or dismissed` TRUE TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 73C(3) the action or application is to be treated as struck out or dismissed` TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 73C(3) the action or application is to be treated as struck out or dismissed` FALSE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73C(3) the action or application is to be treated as struck out or dismissed` TRUE FALSE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73C(3) the action or application is to be treated as struck out or dismissed` TRUE TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73C(3) the action or application is to be treated as struck out or dismissed` TRUE TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73C(3)(a) the court has to make a further order for the action or application to be treated as struck out or dismissed` (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 73C(3)(a) the court has to make a further order for the action or application to be treated as struck out or dismissed` (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 73C(3)(a) the court has to make a further order for the action or application to be treated as struck out or dismissed` NOTHING) EQUALS NOTHING
#ASSERT (`s 73C(3)(b) any other party must be heard on the merits of the action or application` (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 73C(3)(b) any other party must be heard on the merits of the action or application` (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 73C(3)(b) any other party must be heard on the merits of the action or application` NOTHING) EQUALS NOTHING
-- the last day of a 2-year period: the day before the second anniversary
#ASSERT (`s 73C(4)(a) the period specified in the order is within the limit` (Date 1 1 2025) (Date 31 12 2026)) EQUALS JUST TRUE
-- the second anniversary itself is more than 2 years
#ASSERT (`s 73C(4)(a) the period specified in the order is within the limit` (Date 1 1 2025) (Date 1 1 2027)) EQUALS JUST FALSE
#ASSERT (`s 73C(4)(a) the period specified in the order is within the limit` (Date 1 1 2025) (Date 30 6 2025)) EQUALS JUST TRUE
-- a start on 29 February (fork): `add years` gives 28 February 2026 for the second anniversary, so 27 February 2026 is the last permitted day
#ASSERT (`s 73C(4)(a) the period specified in the order is within the limit` (Date 29 2 2024) (Date 27 2 2026)) EQUALS JUST TRUE
-- the same fork, one day later
#ASSERT (`s 73C(4)(a) the period specified in the order is within the limit` (Date 29 2 2024) (Date 28 2 2026)) EQUALS JUST FALSE
#ASSERT (`s 73C(4)(a) the period specified in the order is within the limit` (Date 1 3 2024) (Date 1 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 73C(4)(b) the order specifies every court or subordinate court in which the party is restrained, as the section requires` TRUE) EQUALS JUST TRUE
-- "must specify every court or subordinate court": a bare "must" not done, so the text is silent (QB, fork S3-F7)
#ASSERT (`s 73C(4)(b) the order specifies every court or subordinate court in which the party is restrained, as the section requires` FALSE) EQUALS NOTHING
#ASSERT (`s 73C(5)(a) the court may extend the period for which the order remains in effect` `General Division` TRUE TRUE) EQUALS JUST TRUE
-- "if the court considers it appropriate"
#ASSERT (`s 73C(5)(a) the court may extend the period for which the order remains in effect` `General Division` TRUE FALSE) EQUALS JUST FALSE
-- no such order is in effect
#ASSERT (`s 73C(5)(a) the court may extend the period for which the order remains in effect` `General Division` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 73C(5)(a) the court may extend the period for which the order remains in effect` `Family Division of the High Court` TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 73C(5)(a) the court may extend the period for which the order remains in effect` `District Court` TRUE TRUE) EQUALS JUST FALSE
-- an extension of exactly 2 years: from 1 January 2027 to 31 December 2028
#ASSERT (`s 73C(5)(b) the extension is within the limit` (Date 31 12 2026) (Date 31 12 2028)) EQUALS JUST TRUE
-- one day more than 2 years
#ASSERT (`s 73C(5)(b) the extension is within the limit` (Date 31 12 2026) (Date 1 1 2029)) EQUALS JUST FALSE
#ASSERT (`s 73C(5)(b) the extension is within the limit` (Date 31 12 2026) (Date 30 6 2027)) EQUALS JUST TRUE
#ASSERT (`s 73C(5)(b) the extension is within the limit` (Date 28 2 2025) (Date 28 2 2027)) EQUALS JUST TRUE
#ASSERT (`s 73C(6) and (7) the court whose permission is needed to appeal against the refusal` `General Division` TRUE (JUST `Appellate Division`)) EQUALS JUST `Appellate Division`
#ASSERT (`s 73C(6) and (7) the court whose permission is needed to appeal against the refusal` `Appellate Division` TRUE (JUST `Appellate Division`)) EQUALS JUST `Court of Appeal`
#ASSERT (`s 73C(6) and (7) the court whose permission is needed to appeal against the refusal` `General Division` TRUE NOTHING) EQUALS NOTHING
#ASSERT (`s 73C(6) and (7) the court whose permission is needed to appeal against the refusal` `General Division` FALSE (JUST `Appellate Division`)) EQUALS NOTHING
#ASSERT (`s 73C(6) and (7) the court whose permission is needed to appeal against the refusal` `Court of Appeal` TRUE (JUST `Appellate Division`)) EQUALS NOTHING
#ASSERT (`s 73C(6) and (7) the party may appeal against the refusal without permission` `General Division` TRUE) EQUALS JUST FALSE
#ASSERT (`s 73C(6) and (7) the party may appeal against the refusal without permission` `Appellate Division` TRUE) EQUALS JUST FALSE
#ASSERT (`s 73C(6) and (7) the party may appeal against the refusal without permission` `General Division` FALSE) EQUALS NOTHING
#ASSERT (`s 73C(6) and (7) the party may appeal against the refusal without permission` `Court of Appeal` TRUE) EQUALS NOTHING

-- ==== section 73D ====
#ASSERT (`s 73D(1) the court may make a general civil restraint order against the party` `General Division` TRUE TRUE) EQUALS JUST TRUE
-- an extended civil restraint order would be sufficient and appropriate
#ASSERT (`s 73D(1) the court may make a general civil restraint order against the party` `General Division` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73D(1) the court may make a general civil restraint order against the party` `General Division` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 73D(1) the court may make a general civil restraint order against the party` `Family Division of the High Court` TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 73D(2)(a) the party may commence the action or make the application` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73D(2)(a) the party may commence the action or make the application` TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 73D(2)(a) the party may commence the action or make the application` FALSE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 73D(2)(a) the party may commence the action or make the application` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 73D(2)(b) the party may apply to amend, vary or discharge the order` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 73D(2)(b) the party may apply to amend, vary or discharge the order` TRUE FALSE) EQUALS JUST FALSE
-- no general civil restraint order: the "Where" is unmet, JUST FALSE (fork S3-B3)
#ASSERT (`s 73D(2)(b) the party may apply to amend, vary or discharge the order` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 73D(3) the action or application is to be treated as struck out or dismissed` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 73D(3) the action or application is to be treated as struck out or dismissed` TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 73D(3) the action or application is to be treated as struck out or dismissed` FALSE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73D(3) the action or application is to be treated as struck out or dismissed` TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73D(3) the action or application is to be treated as struck out or dismissed` TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73D(3)(a) the court has to make a further order for the action or application to be treated as struck out or dismissed` (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 73D(3)(a) the court has to make a further order for the action or application to be treated as struck out or dismissed` (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 73D(3)(a) the court has to make a further order for the action or application to be treated as struck out or dismissed` NOTHING) EQUALS NOTHING
#ASSERT (`s 73D(3)(b) any other party must be heard on the merits of the action or application` (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 73D(3)(b) any other party must be heard on the merits of the action or application` (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 73D(3)(b) any other party must be heard on the merits of the action or application` NOTHING) EQUALS NOTHING
-- the last day of a 2-year period: the day before the second anniversary
#ASSERT (`s 73D(4)(a) the period specified in the order is within the limit` (Date 1 1 2025) (Date 31 12 2026)) EQUALS JUST TRUE
-- the second anniversary itself is more than 2 years
#ASSERT (`s 73D(4)(a) the period specified in the order is within the limit` (Date 1 1 2025) (Date 1 1 2027)) EQUALS JUST FALSE
#ASSERT (`s 73D(4)(a) the period specified in the order is within the limit` (Date 1 1 2025) (Date 30 6 2025)) EQUALS JUST TRUE
-- a start on 29 February (fork): `add years` gives 28 February 2026 for the second anniversary, so 27 February 2026 is the last permitted day
#ASSERT (`s 73D(4)(a) the period specified in the order is within the limit` (Date 29 2 2024) (Date 27 2 2026)) EQUALS JUST TRUE
-- the same fork, one day later
#ASSERT (`s 73D(4)(a) the period specified in the order is within the limit` (Date 29 2 2024) (Date 28 2 2026)) EQUALS JUST FALSE
#ASSERT (`s 73D(4)(a) the period specified in the order is within the limit` (Date 1 3 2024) (Date 1 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 73D(4)(b) the order specifies every court or subordinate court in which the party is restrained, as the section requires` TRUE) EQUALS JUST TRUE
-- "must specify every court or subordinate court"
#ASSERT (`s 73D(4)(b) the order specifies every court or subordinate court in which the party is restrained, as the section requires` FALSE) EQUALS NOTHING
#ASSERT (`s 73D(5)(a) the court may extend the period for which the order remains in effect` `General Division` TRUE TRUE) EQUALS JUST TRUE
-- "if the court considers it appropriate"
#ASSERT (`s 73D(5)(a) the court may extend the period for which the order remains in effect` `General Division` TRUE FALSE) EQUALS JUST FALSE
-- no such order is in effect
#ASSERT (`s 73D(5)(a) the court may extend the period for which the order remains in effect` `General Division` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 73D(5)(a) the court may extend the period for which the order remains in effect` `Family Division of the High Court` TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 73D(5)(a) the court may extend the period for which the order remains in effect` `District Court` TRUE TRUE) EQUALS JUST FALSE
-- an extension of exactly 2 years: from 1 January 2027 to 31 December 2028
#ASSERT (`s 73D(5)(b) the extension is within the limit` (Date 31 12 2026) (Date 31 12 2028)) EQUALS JUST TRUE
-- one day more than 2 years
#ASSERT (`s 73D(5)(b) the extension is within the limit` (Date 31 12 2026) (Date 1 1 2029)) EQUALS JUST FALSE
#ASSERT (`s 73D(5)(b) the extension is within the limit` (Date 31 12 2026) (Date 30 6 2027)) EQUALS JUST TRUE
#ASSERT (`s 73D(5)(b) the extension is within the limit` (Date 28 2 2025) (Date 28 2 2027)) EQUALS JUST TRUE
#ASSERT (`s 73D(6) and (7) the court whose permission is needed to appeal against the refusal` `General Division` TRUE (JUST `Appellate Division`)) EQUALS JUST `Appellate Division`
#ASSERT (`s 73D(6) and (7) the court whose permission is needed to appeal against the refusal` `Appellate Division` TRUE (JUST `Appellate Division`)) EQUALS JUST `Court of Appeal`
#ASSERT (`s 73D(6) and (7) the court whose permission is needed to appeal against the refusal` `General Division` TRUE NOTHING) EQUALS NOTHING
#ASSERT (`s 73D(6) and (7) the court whose permission is needed to appeal against the refusal` `General Division` FALSE (JUST `Appellate Division`)) EQUALS NOTHING
#ASSERT (`s 73D(6) and (7) the court whose permission is needed to appeal against the refusal` `Court of Appeal` TRUE (JUST `Appellate Division`)) EQUALS NOTHING
#ASSERT (`s 73D(6) and (7) the party may appeal against the refusal without permission` `General Division` TRUE) EQUALS JUST FALSE
#ASSERT (`s 73D(6) and (7) the party may appeal against the refusal without permission` `Appellate Division` TRUE) EQUALS JUST FALSE
#ASSERT (`s 73D(6) and (7) the party may appeal against the refusal without permission` `General Division` FALSE) EQUALS NOTHING
#ASSERT (`s 73D(6) and (7) the party may appeal against the refusal without permission` `Court of Appeal` TRUE) EQUALS NOTHING

-- ---- the restraint twins (a restraint lifted by permission is JUST FALSE here, and NOTHING in the grant-side function), fork S3-B6 ----
-- s 73B(2)(a): subject, a further application in those proceedings, then permission
#ASSERT (`s 73B(2)(a) the restraint on making the further application applies` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 73B(2)(a) the restraint on making the further application applies` TRUE TRUE TRUE) EQUALS JUST FALSE
