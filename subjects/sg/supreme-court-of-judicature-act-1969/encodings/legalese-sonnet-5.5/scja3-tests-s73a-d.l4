#ASSERT (`s 73B(2)(a) the restraint on making the further application applies` FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73B(2)(a) the restraint on making the further application applies` TRUE FALSE FALSE) EQUALS NOTHING
-- s 73C(2)(a): subject, a specified court, a matter touching the proceedings, then permission
#ASSERT (`s 73C(2)(a) the restraint on commencing the action or making the application applies` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 73C(2)(a) the restraint on commencing the action or making the application applies` TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
-- no extended civil restraint order: the "Where" is unmet, JUST FALSE (fork S3-B3)
#ASSERT (`s 73C(2)(a) the restraint on commencing the action or making the application applies` FALSE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73C(2)(a) the restraint on commencing the action or making the application applies` TRUE FALSE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 73C(2)(a) the restraint on commencing the action or making the application applies` TRUE TRUE FALSE FALSE) EQUALS NOTHING
-- s 73D(2)(a): subject, a specified court, then permission
#ASSERT (`s 73D(2)(a) the restraint on commencing the action or making the application applies` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 73D(2)(a) the restraint on commencing the action or making the application applies` TRUE TRUE TRUE) EQUALS JUST FALSE
-- no general civil restraint order: the "Where" is unmet, JUST FALSE (fork S3-B3)
#ASSERT (`s 73D(2)(a) the restraint on commencing the action or making the application applies` FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73D(2)(a) the restraint on commencing the action or making the application applies` TRUE FALSE FALSE) EQUALS NOTHING

