IMPORT prelude
IMPORT daydate
IMPORT `scja-core`
IMPORT `scja3-s74-vexatious-litigants`

-- scja3-tests-s74.l4: tests for section 74.  Expected values are written from the text of the section
-- (SCJA1969.txt lines 4772-4832) beside each assertion, and not from the module's output.

§ `Tests: section 74`

#ASSERT (`s 74 the court is the General Division` `General Division`) EQUALS JUST TRUE
#ASSERT (`s 74 the court is the General Division` `Singapore International Commercial Court`) EQUALS JUST TRUE
#ASSERT (`s 74 the court is the General Division` `Appellate Division`) EQUALS NOTHING
#ASSERT (`s 74 the court is the General Division` `Court of Appeal`) EQUALS NOTHING
#ASSERT (`s 74 the court is the General Division` `Family Division of the High Court`) EQUALS NOTHING
#ASSERT (`s 74 the court is the General Division` `District Court`) EQUALS NOTHING
#ASSERT (`s 74 the answer holds where the court is the General Division` (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 74 the answer holds where the court is the General Division` NOTHING (JUST TRUE)) EQUALS NOTHING

-- ---- (1): the order ----
-- court, Attorney-General applies, satisfied, heard
#ASSERT (`s 74(1) the General Division may order that the person institute and continue legal proceedings only with its permission` `General Division` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 74(1) the General Division may order that the person institute and continue legal proceedings only with its permission` `Singapore International Commercial Court` TRUE TRUE TRUE) EQUALS JUST TRUE
-- not heard yet
#ASSERT (`s 74(1) the General Division may order that the person institute and continue legal proceedings only with its permission` `General Division` TRUE TRUE FALSE) EQUALS JUST FALSE
-- the Attorney-General did not apply
#ASSERT (`s 74(1) the General Division may order that the person institute and continue legal proceedings only with its permission` `General Division` FALSE TRUE TRUE) EQUALS JUST FALSE
-- not satisfied
#ASSERT (`s 74(1) the General Division may order that the person institute and continue legal proceedings only with its permission` `General Division` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 74(1) the General Division may order that the person institute and continue legal proceedings only with its permission` `Appellate Division` TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 74(1) the General Division may order that the person institute and continue legal proceedings only with its permission` `District Court` TRUE TRUE TRUE) EQUALS NOTHING

-- ---- (1)(a) ----
#ASSERT (`s 74(1)(a) the person may institute legal proceedings in a court or subordinate court` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 74(1)(a) the person may institute legal proceedings in a court or subordinate court` TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 74(1)(a) the person may institute legal proceedings in a court or subordinate court` FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 74(1)(a) the person may institute legal proceedings in a court or subordinate court` FALSE TRUE) EQUALS NOTHING

-- ---- (1)(b) ----
-- order made, proceedings instituted before the order, permission
#ASSERT (`s 74(1)(b) the person may continue the legal proceedings instituted before the order` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 74(1)(b) the person may continue the legal proceedings instituted before the order` TRUE TRUE TRUE) EQUALS NOTHING
-- proceedings instituted after the order: paragraph (a) governs, not (b)
#ASSERT (`s 74(1)(b) the person may continue the legal proceedings instituted before the order` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 74(1)(b) the person may continue the legal proceedings instituted before the order` FALSE TRUE FALSE) EQUALS NOTHING
-- giving permission: "must not be given unless" both
#ASSERT (`s 74(1)(b) the General Division may give permission to continue the legal proceedings` TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 74(1)(b) the General Division may give permission to continue the legal proceedings` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 74(1)(b) the General Division may give permission to continue the legal proceedings` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 74(1)(b) the General Division may give permission to continue the legal proceedings` FALSE FALSE) EQUALS JUST FALSE

-- ---- (2): an advocate and solicitor ----
#ASSERT (`s 74(2) the General Division is to assign an advocate and solicitor to the person` `General Division` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 74(2) the General Division is to assign an advocate and solicitor to the person` `General Division` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 74(2) the General Division is to assign an advocate and solicitor to the person` `General Division` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 74(2) the General Division is to assign an advocate and solicitor to the person` `Court of Appeal` TRUE TRUE) EQUALS NOTHING

-- ---- (2A): appeal only with permission ----
#ASSERT (`s 74(2A) the court whose permission is needed to appeal against the order` `General Division` TRUE (JUST `Appellate Division`)) EQUALS JUST `Appellate Division`
#ASSERT (`s 74(2A) the court whose permission is needed to appeal against the order` `General Division` TRUE (JUST `Court of Appeal`)) EQUALS JUST `Court of Appeal`
#ASSERT (`s 74(2A) the court whose permission is needed to appeal against the order` `General Division` TRUE NOTHING) EQUALS NOTHING
#ASSERT (`s 74(2A) the court whose permission is needed to appeal against the order` `General Division` FALSE (JUST `Appellate Division`)) EQUALS NOTHING
#ASSERT (`s 74(2A) the court whose permission is needed to appeal against the order` `Appellate Division` TRUE (JUST `Appellate Division`)) EQUALS NOTHING
#ASSERT (`s 74(2A) the person may appeal against the order without permission` `General Division` TRUE) EQUALS JUST FALSE
#ASSERT (`s 74(2A) the person may appeal against the order without permission` `General Division` FALSE) EQUALS NOTHING
#ASSERT (`s 74(2A) the person may appeal against the order without permission` `Court of Appeal` TRUE) EQUALS NOTHING

-- ---- (3), (4) ----
#ASSERT (`s 74(3) an appeal lies from the order refusing permission` TRUE) EQUALS JUST FALSE
#ASSERT (`s 74(3) an appeal lies from the order refusing permission` FALSE) EQUALS NOTHING
#ASSERT (`s 74(4) a copy of the order must be published in the Gazette` TRUE) EQUALS JUST TRUE
#ASSERT (`s 74(4) a copy of the order must be published in the Gazette` FALSE) EQUALS NOTHING

-- ---- (5) ----
#ASSERT (`s 74(5) the thing is within legal proceedings for section 74` `s 74(5) proceedings`) EQUALS JUST TRUE
#ASSERT (`s 74(5) the thing is within legal proceedings for section 74` `s 74(5) process`) EQUALS JUST TRUE
#ASSERT (`s 74(5) the thing is within legal proceedings for section 74` `s 74(5) action`) EQUALS JUST TRUE
#ASSERT (`s 74(5) the thing is within legal proceedings for section 74` `s 74(5) application`) EQUALS JUST TRUE
#ASSERT (`s 74(5) the thing is within legal proceedings for section 74` `s 74(5) appeal`) EQUALS JUST TRUE
#ASSERT (`s 74(5) the thing is within legal proceedings for section 74` `s 74(5) another kind of thing`) EQUALS NOTHING

-- ---- the bar twins, fork S3-B6 ----
-- (1)(a): an order was made, the permission
#ASSERT (`s 74(1)(a) the bar on instituting legal proceedings in a court or subordinate court applies` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 74(1)(a) the bar on instituting legal proceedings in a court or subordinate court applies` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 74(1)(a) the bar on instituting legal proceedings in a court or subordinate court applies` FALSE FALSE) EQUALS NOTHING
-- (1)(b), continuing: an order was made, proceedings instituted before it, the permission
#ASSERT (`s 74(1)(b) the bar on continuing the legal proceedings instituted before the order applies` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 74(1)(b) the bar on continuing the legal proceedings instituted before the order applies` TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 74(1)(b) the bar on continuing the legal proceedings instituted before the order applies` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 74(1)(b) the bar on continuing the legal proceedings instituted before the order applies` FALSE TRUE FALSE) EQUALS NOTHING
-- (1)(b), giving permission: satisfied of no abuse, satisfied of a prima facie ground
#ASSERT (`s 74(1)(b) the bar on giving permission to continue the legal proceedings applies` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 74(1)(b) the bar on giving permission to continue the legal proceedings applies` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 74(1)(b) the bar on giving permission to continue the legal proceedings applies` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 74(1)(b) the bar on giving permission to continue the legal proceedings applies` FALSE FALSE) EQUALS JUST TRUE

