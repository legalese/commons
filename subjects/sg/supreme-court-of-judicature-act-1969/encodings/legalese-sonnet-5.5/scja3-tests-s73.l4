IMPORT prelude
IMPORT daydate
IMPORT `scja-core`
IMPORT `scja3-s73-touts`

-- scja3-tests-s73.l4: tests for section 73.  Expected values are written from the text of the section
-- (SCJA1969.txt lines 4330-4368) beside each assertion, and not from the module's output.

§ `Tests: section 73`

-- ---- (1) ----
#ASSERT (`s 73(1) the Registrar may include the person in the list of touts` TRUE) EQUALS JUST TRUE
#ASSERT (`s 73(1) the Registrar may include the person in the list of touts` FALSE) EQUALS NOTHING

-- ---- (3): the bar ----
#ASSERT (`s 73(3) the person's name cannot yet be included in the list` FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 73(3) the person's name cannot yet be included in the list` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 73(3) the person's name cannot yet be included in the list` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 73(3) the person's name cannot yet be included in the list` TRUE TRUE) EQUALS JUST FALSE

-- ---- (2) ----
#ASSERT (`s 73(2) the Registrar may exclude the person from the precincts of the Supreme Court` TRUE FALSE) EQUALS JUST TRUE
-- a party or a witness is to be allowed to remain
#ASSERT (`s 73(2) the Registrar may exclude the person from the precincts of the Supreme Court` TRUE TRUE) EQUALS JUST FALSE
-- not on the list
#ASSERT (`s 73(2) the Registrar may exclude the person from the precincts of the Supreme Court` FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 73(2) the Registrar may exclude the person from the precincts of the Supreme Court` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 73(2) the person is to be allowed to remain in the precincts for such time as is necessary` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 73(2) the person is to be allowed to remain in the precincts for such time as is necessary` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 73(2) the person is to be allowed to remain in the precincts for such time as is necessary` FALSE TRUE) EQUALS NOTHING

-- ---- (4), (5), (6) ----
#ASSERT (`s 73(4) an appeal lies to a Judge sitting in chambers in the General Division` TRUE) EQUALS JUST TRUE
#ASSERT (`s 73(4) an appeal lies to a Judge sitting in chambers in the General Division` FALSE) EQUALS NOTHING
#ASSERT (`s 73(5) a further appeal lies from the decision` TRUE) EQUALS JUST FALSE
#ASSERT (`s 73(5) a further appeal lies from the decision` FALSE) EQUALS NOTHING
#ASSERT (`s 73(6) a copy of the list must be kept hung up in the Registry and published in the Gazette` TRUE) EQUALS JUST TRUE
#ASSERT (`s 73(6) a copy of the list must be kept hung up in the Registry and published in the Gazette` FALSE) EQUALS NOTHING

-- ---- (7) ----
#ASSERT (`s 73(7) the person is deemed to be included in the list under this section` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 73(7) the person is deemed to be included in the list under this section` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 73(7) the person is deemed to be included in the list under this section` FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 73(7) the person is deemed to be included in the lists under section 39 of the Family Justice Act 2014 and section 62 of the State Courts Act 1970` TRUE) EQUALS JUST TRUE
#ASSERT (`s 73(7) the person is deemed to be included in the lists under section 39 of the Family Justice Act 2014 and section 62 of the State Courts Act 1970` FALSE) EQUALS NOTHING

-- ---- (3): the Registrar's duty, as a trace.  The person is heard at time 5. ----
-- expect: BREACH
#TRACE `s 73(3) the Registrar must not include the person's name in the list until the person has been heard` 5 AT 0 WITH
   PARTY `s 73(3) the Registrar` DOES `s 73(3) includes the person's name in the list` AT 3

-- expect: FULFILLED
#TRACE `s 73(3) the Registrar must not include the person's name in the list until the person has been heard` 5 AT 0 WITH
   (WAITUNTIL 6)

-- expect: BREACH
#TRACE `s 73(3) the Registrar must not include the person's name in the list until the person has been heard` 5 AT 0 WITH
   PARTY `s 73(3) the Registrar` DOES `s 73(3) includes the person's name in the list` AT 1
