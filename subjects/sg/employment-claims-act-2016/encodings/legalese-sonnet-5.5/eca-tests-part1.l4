IMPORT prelude
IMPORT daydate
IMPORT `eca-nouns`
IMPORT `eca-schedules`
IMPORT `eca-part1-preliminary`

-- Tests of Part 1 (s 2).  Every expected value below was decided from the text of s 2 before the run, and is written beside its assertion.
-- J = JUST TRUE is the Act's yes; JUST FALSE is the Act's no in its own words; NOTHING is "not covered".

§ `Tests -- s 2(1)`

-- "approved mediator": an individual approved for one or more of the five kinds.
#ASSERT `s 2(1) the person is an approved mediator` TRUE (LIST `A mediation under Part 2 of a specified employment dispute`) EQUALS JUST TRUE  -- (a)
#ASSERT `s 2(1) the person is an approved mediator` TRUE (LIST `A tripartite mediation`) EQUALS JUST TRUE  -- (b)
#ASSERT `s 2(1) the person is an approved mediator` TRUE (LIST `A mediation mentioned in section 115(2A) of the Employment Act 1968`) EQUALS JUST TRUE  -- (c)
#ASSERT `s 2(1) the person is an approved mediator` TRUE (LIST `A consultation or conciliation under section 8A(5) of the Retirement and Re-employment Act 1993`) EQUALS JUST TRUE  -- (d)
#ASSERT `s 2(1) the person is an approved mediator` TRUE (LIST `A mediation or conciliation under another written law relating to employment that the Commissioner has determined`) EQUALS JUST TRUE  -- (e)
#ASSERT `s 2(1) the person is an approved mediator` TRUE (LIST `A tripartite mediation`, `A mediation under Part 2 of a specified employment dispute`) EQUALS JUST TRUE  -- one or more
#ASSERT `s 2(1) the person is an approved mediator` TRUE EMPTY EQUALS JUST FALSE  -- approved for none: not "approved ... for one or more"
#ASSERT `s 2(1) the person is an approved mediator` FALSE (LIST `A tripartite mediation`) EQUALS JUST FALSE  -- not an individual

-- "authorised person"
#ASSERT `s 2(1) the person is an authorised person` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the person is an authorised person` FALSE TRUE TRUE EQUALS JUST FALSE  -- not an individual
#ASSERT `s 2(1) the person is an authorised person` TRUE FALSE TRUE EQUALS JUST FALSE  -- not appointed under s 3(3) EA
#ASSERT `s 2(1) the person is an authorised person` TRUE TRUE FALSE EQUALS JUST FALSE  -- not for the Commissioner's functions under this Act

-- "claim" includes a counterclaim lodged with a tribunal
#ASSERT `s 2(1) the thing is a claim` TRUE `A claim` EQUALS JUST TRUE
#ASSERT `s 2(1) the thing is a claim` TRUE `A counterclaim` EQUALS JUST TRUE
#ASSERT `s 2(1) the thing is a claim` FALSE `A claim` EQUALS JUST FALSE  -- not lodged with a tribunal
#ASSERT `s 2(1) the thing is a claim` FALSE `A counterclaim` EQUALS JUST FALSE

-- "claim referral certificate": under s 6(2) or 7(7)(a); or s 30H(6) IRA
#ASSERT `s 2(1) the certificate is a claim referral certificate` `Section 6(2) of the Employment Claims Act 2016` EQUALS JUST TRUE
#ASSERT `s 2(1) the certificate is a claim referral certificate` `Section 7(7)(a) of the Employment Claims Act 2016` EQUALS JUST TRUE
#ASSERT `s 2(1) the certificate is a claim referral certificate` `Section 30H(6) of the Industrial Relations Act 1960` EQUALS JUST TRUE
#ASSERT `s 2(1) the certificate is a claim referral certificate` `Some other provision` EQUALS JUST FALSE

-- "claimant": a person who lodges a claim; for the purposes of Part 2 also a person who intends to lodge one
#ASSERT `s 2(1) the person is a claimant` TRUE FALSE FALSE EQUALS JUST TRUE  -- lodges a claim
#ASSERT `s 2(1) the person is a claimant` FALSE TRUE TRUE EQUALS JUST TRUE  -- intends to lodge, asked for Part 2
#ASSERT `s 2(1) the person is a claimant` FALSE TRUE FALSE EQUALS JUST FALSE  -- intends to lodge, not asked for Part 2
#ASSERT `s 2(1) the person is a claimant` FALSE FALSE TRUE EQUALS JUST FALSE  -- Part 2 but no intention to lodge

-- "Commissioner"
#ASSERT `s 2(1) the person is the Commissioner` TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the person is the Commissioner` FALSE EQUALS JUST FALSE

-- "contract of service": any form of agreement (the form is not an input); an apprenticeship agreement
#ASSERT `s 2(1) the agreement is a contract of service` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2(1) the agreement is a contract of service` FALSE FALSE FALSE TRUE EQUALS JUST TRUE  -- "includes an apprenticeship agreement"
#ASSERT `s 2(1) the agreement is a contract of service` TRUE TRUE FALSE FALSE EQUALS JUST FALSE  -- the individual does not agree to serve
#ASSERT `s 2(1) the agreement is a contract of service` TRUE FALSE TRUE FALSE EQUALS JUST FALSE  -- nobody agrees to employ
#ASSERT `s 2(1) the agreement is a contract of service` FALSE TRUE TRUE FALSE EQUALS JUST FALSE  -- not an agreement

-- "court"
#ASSERT `s 2(1) the body is a court` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the body is a court` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) the body is a court` FALSE TRUE EQUALS JUST FALSE

-- "employee": args = individual, entered, works, gov employee, gov prescribed, termination-or-after-end, worked-under
#ASSERT `s 2(1) the person is an employee` TRUE TRUE TRUE FALSE NOTHING FALSE FALSE EQUALS JUST TRUE  -- the main limb
#ASSERT `s 2(1) the person is an employee` FALSE FALSE FALSE TRUE (JUST TRUE) FALSE FALSE EQUALS JUST TRUE  -- (a) Government employee in a prescribed category
#ASSERT `s 2(1) the person is an employee` FALSE FALSE FALSE TRUE (JUST FALSE) FALSE FALSE EQUALS JUST FALSE  -- Government employee not in a prescribed category
#ASSERT `s 2(1) the person is an employee` FALSE FALSE FALSE TRUE NOTHING FALSE FALSE EQUALS NOTHING  -- prescribed category not known: points outside the text
#ASSERT `s 2(1) the person is an employee` FALSE TRUE FALSE FALSE NOTHING TRUE TRUE EQUALS JUST TRUE  -- (b) former employee, claim made after the contract ended
#ASSERT `s 2(1) the person is an employee` FALSE TRUE FALSE FALSE NOTHING FALSE TRUE EQUALS JUST FALSE  -- former employee but neither limb of (b) is met
#ASSERT `s 2(1) the person is an employee` FALSE TRUE FALSE FALSE NOTHING TRUE FALSE EQUALS JUST FALSE  -- did not work under that contract
#ASSERT `s 2(1) the person is an employee` TRUE TRUE FALSE FALSE NOTHING FALSE FALSE EQUALS JUST FALSE  -- entered into a contract but does not work under it

-- "employer": args = employs, is Government, Government prescribed, statutory body, authorised agent/manager, owns/carries on/manages, termination-or-after-end, former employer
#ASSERT `s 2(1) the person is an employer` TRUE FALSE NOTHING FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE  -- the main limb
#ASSERT `s 2(1) the person is an employer` FALSE TRUE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE  -- (a)
#ASSERT `s 2(1) the person is an employer` FALSE TRUE NOTHING FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING  -- (a) category not known
#ASSERT `s 2(1) the person is an employer` FALSE TRUE (JUST FALSE) FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) the person is an employer` FALSE FALSE NOTHING TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE  -- (b) statutory body
#ASSERT `s 2(1) the person is an employer` FALSE FALSE NOTHING FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE  -- (c) agent or manager
#ASSERT `s 2(1) the person is an employer` FALSE FALSE NOTHING FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE  -- (d) owner or manager of the business
#ASSERT `s 2(1) the person is an employer` FALSE FALSE NOTHING FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE  -- (e) former employer after termination
#ASSERT `s 2(1) the person is an employer` FALSE FALSE NOTHING FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE  -- former employer but neither limb of (e)
#ASSERT `s 2(1) the person is an employer` FALSE FALSE NOTHING FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- "employment assistance payment", "salary", "tripartite mediation", "workman": the meaning is given by another Act
#ASSERT `s 2(1) the payment is an employment assistance payment` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2(1) the payment is an employment assistance payment` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2(1) the payment is an employment assistance payment` NOTHING EQUALS NOTHING
#ASSERT `s 2(1) the payment is salary` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2(1) the payment is salary` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2(1) the payment is salary` NOTHING EQUALS NOTHING
#ASSERT `s 2(1) the mediation is a tripartite mediation` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2(1) the mediation is a tripartite mediation` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2(1) the mediation is a tripartite mediation` NOTHING EQUALS NOTHING
#ASSERT `s 2(1) the person is a workman` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 2(1) the person is a workman` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 2(1) the person is a workman` NOTHING EQUALS NOTHING

-- "Industrial Arbitration Court"
#ASSERT `s 2(1) the court is an Industrial Arbitration Court` TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the court is an Industrial Arbitration Court` FALSE EQUALS JUST FALSE

-- "mediation" INCLUDES three things (open list)
#ASSERT `s 2(1) the thing is mediation` TRUE FALSE FALSE EQUALS JUST TRUE  -- (a)
#ASSERT `s 2(1) the thing is mediation` FALSE TRUE FALSE EQUALS JUST TRUE  -- (b)
#ASSERT `s 2(1) the thing is mediation` FALSE FALSE TRUE EQUALS JUST TRUE  -- (c)
#ASSERT `s 2(1) the thing is mediation` FALSE FALSE FALSE EQUALS NOTHING  -- "includes": a thing outside the three is not said to be outside the term

-- "mediation request", "mediation session"
#ASSERT `s 2(1) the request is a mediation request` TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the request is a mediation request` FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) the meeting is a mediation session` 2 TRUE EQUALS JUST TRUE  -- "2 or more": the boundary
#ASSERT `s 2(1) the meeting is a mediation session` 3 TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the meeting is a mediation session` 1 TRUE EQUALS JUST FALSE  -- one party is not "2 or more parties"
#ASSERT `s 2(1) the meeting is a mediation session` 2 FALSE EQUALS JUST FALSE

-- "Registrar"
#ASSERT `s 2(1) the officer is a Registrar` `The registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the officer is a Registrar` `A deputy registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the officer is a Registrar` `An assistant registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the officer is a Registrar` `Another officer` TRUE EQUALS JUST FALSE
#ASSERT `s 2(1) the officer is a Registrar` `The registrar` FALSE EQUALS JUST FALSE  -- not "for the tribunals"
#ASSERT `s 2(1) the registry is the Registry` TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the registry is the Registry` FALSE EQUALS JUST FALSE

-- "respondent"
#ASSERT `s 2(1) the person is a respondent` TRUE FALSE FALSE FALSE EQUALS JUST TRUE  -- a claim is made against the person
#ASSERT `s 2(1) the person is a respondent` FALSE TRUE FALSE FALSE EQUALS JUST TRUE  -- joined as a respondent
#ASSERT `s 2(1) the person is a respondent` FALSE FALSE TRUE TRUE EQUALS JUST TRUE  -- Part 2: a claimant intends to claim against the person
#ASSERT `s 2(1) the person is a respondent` FALSE FALSE TRUE FALSE EQUALS JUST FALSE  -- intended claim, but not Part 2
#ASSERT `s 2(1) the person is a respondent` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- "tribunal", "tribunal magistrate", the two sets of guidelines
#ASSERT `s 2(1) the body is a tribunal` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the body is a tribunal` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) the body is a tribunal` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2(1) the body is a tribunal` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2(1) the person is a tribunal magistrate` `Appointed under section 9(1)(a)` EQUALS JUST TRUE
#ASSERT `s 2(1) the person is a tribunal magistrate` `Designated under section 9(5)` EQUALS JUST TRUE
#ASSERT `s 2(1) the person is a tribunal magistrate` `Neither` EQUALS JUST FALSE
#ASSERT `s 2(1) the guidelines are the tripartite guidelines on re-employment` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the guidelines are the tripartite guidelines on re-employment` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) the guidelines are the tripartite guidelines on re-employment` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2(1) the guidelines are the tripartite guidelines on wrongful dismissal` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the guidelines are the tripartite guidelines on wrongful dismissal` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) the guidelines are the tripartite guidelines on wrongful dismissal` FALSE TRUE EQUALS JUST FALSE

§ `Tests -- the three families of dispute (s 2(1), First to Third Schedules)`

-- Fixtures.  A dispute about salary (First Schedule item 16) that relates to a payment and arises out of employment.
`salary dispute` MEANS Dispute WITH
    matter IS `A matter in the First Schedule` `Salary`
    `relates to a payment of an amount of money` IS TRUE
    `arises out of or in the course of employment under a contract of service` IS TRUE
    `relates to the dismissal of an employee` IS FALSE

`salary dispute not arising out of employment` MEANS Dispute WITH
    matter IS `A matter in the First Schedule` `Salary`
    `relates to a payment of an amount of money` IS TRUE
    `arises out of or in the course of employment under a contract of service` IS FALSE
    `relates to the dismissal of an employee` IS FALSE

`salary dispute not about a payment` MEANS Dispute WITH
    matter IS `A matter in the First Schedule` `Salary`
    `relates to a payment of an amount of money` IS FALSE
    `arises out of or in the course of employment under a contract of service` IS TRUE
    `relates to the dismissal of an employee` IS FALSE

-- A dispute about overtime for a part-time employee (Second Schedule item 35).
`part-time overtime dispute` MEANS Dispute WITH
    matter IS `A matter in the Second Schedule` `Item 35: part-time employee's overtime pay (EA Part-Time Employees Regs reg 5(1))`
    `relates to a payment of an amount of money` IS TRUE
    `arises out of or in the course of employment under a contract of service` IS FALSE
    `relates to the dismissal of an employee` IS FALSE

`part-time overtime dispute not about a payment` MEANS Dispute WITH
    matter IS `A matter in the Second Schedule` `Item 35: part-time employee's overtime pay (EA Part-Time Employees Regs reg 5(1))`
    `relates to a payment of an amount of money` IS FALSE
    `arises out of or in the course of employment under a contract of service` IS FALSE
    `relates to the dismissal of an employee` IS FALSE

-- A dismissal dispute (Third Schedule item 1).
`dismissal dispute` MEANS Dispute WITH
    matter IS `A matter in the Third Schedule` `Item 1: dismissal without just cause or excuse, where the employee may claim under EA 1968 s 14(2)`
    `relates to a payment of an amount of money` IS FALSE
    `arises out of or in the course of employment under a contract of service` IS FALSE
    `relates to the dismissal of an employee` IS TRUE

`dismissal dispute not about a dismissal` MEANS Dispute WITH
    matter IS `A matter in the Third Schedule` `Item 1: dismissal without just cause or excuse, where the employee may claim under EA 1968 s 14(2)`
    `relates to a payment of an amount of money` IS FALSE
    `arises out of or in the course of employment under a contract of service` IS FALSE
    `relates to the dismissal of an employee` IS FALSE

`a dispute about a matter in no Schedule` MEANS Dispute WITH
    matter IS `None of the matters in the Schedules`
    `relates to a payment of an amount of money` IS TRUE
    `arises out of or in the course of employment under a contract of service` IS TRUE
    `relates to the dismissal of an employee` IS TRUE

#ASSERT `s 2(1) the dispute is a specified contractual dispute` `salary dispute` EQUALS JUST TRUE
#ASSERT `s 2(1) the dispute is a specified contractual dispute` `salary dispute not arising out of employment` EQUALS JUST FALSE
#ASSERT `s 2(1) the dispute is a specified contractual dispute` `salary dispute not about a payment` EQUALS JUST FALSE
#ASSERT `s 2(1) the dispute is a specified contractual dispute` `part-time overtime dispute` EQUALS JUST FALSE  -- a Second Schedule matter
#ASSERT `s 2(1) the dispute is a specified contractual dispute` `dismissal dispute` EQUALS JUST FALSE
#ASSERT `s 2(1) the dispute is a specified contractual dispute` `a dispute about a matter in no Schedule` EQUALS JUST FALSE

#ASSERT `s 2(1) the dispute is a specified statutory dispute` `part-time overtime dispute` EQUALS JUST TRUE  -- no "arises out of employment" limb in this definition
#ASSERT `s 2(1) the dispute is a specified statutory dispute` `part-time overtime dispute not about a payment` EQUALS JUST FALSE
#ASSERT `s 2(1) the dispute is a specified statutory dispute` `salary dispute` EQUALS JUST FALSE  -- a First Schedule matter
#ASSERT `s 2(1) the dispute is a specified statutory dispute` `dismissal dispute` EQUALS JUST FALSE
#ASSERT `s 2(1) the dispute is a specified statutory dispute` `a dispute about a matter in no Schedule` EQUALS JUST FALSE

#ASSERT `s 2(1) the dispute is a wrongful dismissal dispute` `dismissal dispute` EQUALS JUST TRUE
#ASSERT `s 2(1) the dispute is a wrongful dismissal dispute` `dismissal dispute not about a dismissal` EQUALS JUST FALSE
#ASSERT `s 2(1) the dispute is a wrongful dismissal dispute` `salary dispute` EQUALS JUST FALSE
#ASSERT `s 2(1) the dispute is a wrongful dismissal dispute` `part-time overtime dispute` EQUALS JUST FALSE
#ASSERT `s 2(1) the dispute is a wrongful dismissal dispute` `a dispute about a matter in no Schedule` EQUALS JUST FALSE

#ASSERT `s 2(1) the dispute is a specified employment dispute` `salary dispute` EQUALS JUST TRUE
#ASSERT `s 2(1) the dispute is a specified employment dispute` `part-time overtime dispute` EQUALS JUST TRUE
#ASSERT `s 2(1) the dispute is a specified employment dispute` `dismissal dispute` EQUALS JUST TRUE
#ASSERT `s 2(1) the dispute is a specified employment dispute` `salary dispute not about a payment` EQUALS JUST FALSE
#ASSERT `s 2(1) the dispute is a specified employment dispute` `a dispute about a matter in no Schedule` EQUALS JUST FALSE

§ `Tests -- s 2(2) and (3)`

`Ann` MEANS Person WITH name IS "Ann"
`Bob` MEANS Person WITH name IS "Bob"

#ASSERT `s 2(2) the person a reference in the Act is a reference to` `The claimant` TRUE `Ann` `Bob` EQUALS JUST `Ann`  -- (a): the person making the counterclaim
#ASSERT `s 2(2) the person a reference in the Act is a reference to` `The respondent` TRUE `Ann` `Bob` EQUALS JUST `Bob`  -- (b): the person against whom it is made
#ASSERT `s 2(2) the person a reference in the Act is a reference to` `The claimant` FALSE `Ann` `Bob` EQUALS NOTHING  -- not a counterclaim: s 2(2) does not speak to it
#ASSERT `s 2(2) the person a reference in the Act is a reference to` `The respondent` FALSE `Ann` `Bob` EQUALS NOTHING

#ASSERT `s 2(3) the officer may carry out a function or duty or exercise a power of the Commissioner under this Act` `A Deputy Commissioner for Labour` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(3) the officer may carry out a function or duty or exercise a power of the Commissioner under this Act` `A Principal Assistant Commissioner for Labour` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(3) the officer may carry out a function or duty or exercise a power of the Commissioner under this Act` `An Assistant Commissioner for Labour` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(3) the officer may carry out a function or duty or exercise a power of the Commissioner under this Act` `A Deputy Commissioner for Labour` TRUE FALSE EQUALS JUST FALSE  -- not authorised
#ASSERT `s 2(3) the officer may carry out a function or duty or exercise a power of the Commissioner under this Act` `A Deputy Commissioner for Labour` FALSE TRUE EQUALS NOTHING  -- not appointed under s 3(1) EA: outside the grant
#ASSERT `s 2(3) the officer may carry out a function or duty or exercise a power of the Commissioner under this Act` `Another officer` TRUE TRUE EQUALS NOTHING  -- an officer s 2(3) does not name
