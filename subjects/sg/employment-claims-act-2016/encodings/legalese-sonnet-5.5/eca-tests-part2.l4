#ASSERT `s 5(5) the person is an officer of the body corporate` `Manager` FALSE EQUALS JUST TRUE
#ASSERT `s 5(5) the person is an officer of the body corporate` `Secretary` FALSE EQUALS JUST TRUE
#ASSERT `s 5(5) the person is an officer of the body corporate` `Another position` TRUE EQUALS JUST TRUE  -- "or other similar officer"
#ASSERT `s 5(5) the person is an officer of the body corporate` `Another position` FALSE EQUALS JUST FALSE

-- s 5(1) to (3): args = kind of party, kind of representative, whether the regulations prescribe the representative for the party
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `The Government` `A public officer` NOTHING EQUALS JUST TRUE  -- (2)(a)
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `The Government` `An officer of the body corporate` NOTHING EQUALS JUST FALSE
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `A body corporate` `An officer of the body corporate` NOTHING EQUALS JUST TRUE  -- (2)(b)
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `A body corporate` `A full-time employee of the party` NOTHING EQUALS JUST TRUE  -- (2)(b)
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `A body corporate` `A partner of the partnership` NOTHING EQUALS JUST FALSE
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `A partnership` `A partner of the partnership` NOTHING EQUALS JUST TRUE  -- (2)(c)
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `A partnership` `A full-time employee of the party` NOTHING EQUALS JUST TRUE  -- (2)(c)
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `An unincorporated association` `A member of the governing body of the unincorporated association` NOTHING EQUALS JUST TRUE  -- (2)(d)
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `An unincorporated association` `A full-time employee of the party` NOTHING EQUALS JUST TRUE  -- (2)(d)
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `A body corporate` `Another individual prescribed by regulations` (JUST TRUE) EQUALS JUST TRUE  -- (2)(e)
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `An individual` `Another individual prescribed by regulations` (JUST TRUE) EQUALS JUST TRUE  -- (3)
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `An individual` `Another individual prescribed by regulations` NOTHING EQUALS NOTHING  -- the regulations are outside the sources
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `An individual` `Another individual prescribed by regulations` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `An individual` `An advocate and solicitor` NOTHING EQUALS JUST FALSE  -- (1)(b)
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `A body corporate` `An advocate and solicitor` NOTHING EQUALS JUST FALSE  -- (1)(b): not among (2)
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `An individual` `An agent, whether paid or otherwise` NOTHING EQUALS JUST FALSE  -- (1)(c)
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `An individual` `A full-time employee of the party` NOTHING EQUALS JUST FALSE  -- (2) is for a party other than an individual
#ASSERT `s 5(1) to (3) the party may be represented at the mediation by the representative` `An individual` `Anyone else` NOTHING EQUALS JUST FALSE  -- (1)(a): must act in person

-- s 5(1)(b) and (c) as regulative rules.  Trace 7: the party is represented by an advocate and solicitor -> BREACH.  Trace 8: nothing happens -> the prohibition stands.
#TRACE `s 5(1)(b) the party's prohibition on representation by an advocate and solicitor` `A party` AT 0 WITH
    PARTY `A party` DOES `be represented by an advocate and solicitor` AT 5
#TRACE `s 5(1)(c) the party's prohibition on representation by an agent` `A party` AT 0 WITH
    PARTY `A party` DOES `be represented by an agent` AT 5
#TRACE `s 5(1)(c) the party's prohibition on representation by an agent` `A party` AT 0 WITH
    PARTY `A party` DOES `be represented by an advocate and solicitor` AT 5

