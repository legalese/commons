#ASSERT `s 7(3)(a) the date from which the settlement agreement has the force and effect of a judgment for execution or enforcement` TRUE (Date 5 5 2026) EQUALS JUST (Date 5 5 2026)
#ASSERT `s 7(3)(a) the date from which the settlement agreement has the force and effect of a judgment for execution or enforcement` FALSE (Date 5 5 2026) EQUALS NOTHING
#ASSERT `s 7(3)(b) proceedings may be taken on the settlement agreement as on a judgment` TRUE EQUALS JUST TRUE
#ASSERT `s 7(3)(b) proceedings may be taken on the settlement agreement as on a judgment` FALSE EQUALS JUST FALSE
#ASSERT `s 7(3)(c) an amount for which the settlement agreement is registered carries interest as a judgment debt` TRUE EQUALS JUST TRUE
#ASSERT `s 7(3)(c) an amount for which the settlement agreement is registered carries interest as a judgment debt` FALSE EQUALS JUST FALSE

#ASSERT `s 7(4) a party may apply to set aside the registration` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 7(4) a party may apply to set aside the registration` TRUE (JUST FALSE) EQUALS JUST FALSE  -- outside the period (ruled I(a), 2026-11-05)
#ASSERT `s 7(4) a party may apply to set aside the registration` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 7(4) a party may apply to set aside the registration` FALSE (JUST TRUE) EQUALS JUST FALSE

-- s 7(6): args = (a) void or voidable, (b) subject matter not relating to a specified employment dispute, (c) a term cannot be enforced as an order, (d) registration contrary to public policy
#ASSERT `s 7(6) a condition for setting aside is satisfied` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 7(6) a condition for setting aside is satisfied` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 7(6) a condition for setting aside is satisfied` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 7(6) a condition for setting aside is satisfied` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 7(6) a condition for setting aside is satisfied` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

#ASSERT `s 7(5)(a) a District Court may set aside the registration of the settlement agreement` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 7(5)(a) a District Court may set aside the registration of the settlement agreement` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 7(5)(a) a District Court may set aside the registration of the settlement agreement` NOTHING EQUALS NOTHING
#ASSERT `s 7(5)(b)(i) a District Court may set aside the settlement agreement` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 7(5)(b)(i) a District Court may set aside the settlement agreement` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 7(5)(b)(i) a District Court may set aside the settlement agreement` NOTHING EQUALS NOTHING
#ASSERT `s 7(5)(b)(ii) the kind of mediation a District Court may refer the dispute to` (JUST TRUE) `From a mediation under Part 2` TRUE EQUALS JUST `Mediation under Part 2`
#ASSERT `s 7(5)(b)(ii) the kind of mediation a District Court may refer the dispute to` (JUST TRUE) `From a mediation under Part 2` FALSE EQUALS JUST `Mediation under Part 2`  -- "with or without the consent"
#ASSERT `s 7(5)(b)(ii) the kind of mediation a District Court may refer the dispute to` (JUST TRUE) `From a tripartite mediation conducted by an approved mediator` TRUE EQUALS JUST `Tripartite mediation to be conducted by an approved mediator`
#ASSERT `s 7(5)(b)(ii) the kind of mediation a District Court may refer the dispute to` (JUST TRUE) `From a tripartite mediation conducted by an approved mediator` FALSE EQUALS JUST `Tripartite mediation to be conducted by an approved mediator`
#ASSERT `s 7(5)(b)(ii) the kind of mediation a District Court may refer the dispute to` (JUST FALSE) `From a mediation under Part 2` TRUE EQUALS NOTHING

#ASSERT `s 7(8) the specified employment dispute referred by the District Court is unresolved` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 7(8) the specified employment dispute referred by the District Court is unresolved` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 7(8) the specified employment dispute referred by the District Court is unresolved` FALSE TRUE EQUALS JUST FALSE

#ASSERT `s 7(7)(a) the approved mediator must issue the claimant a claim referral certificate for the dispute referred by the District Court` TRUE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST TRUE  -- (i)
#ASSERT `s 7(7)(a) the approved mediator must issue the claimant a claim referral certificate for the dispute referred by the District Court` TRUE (JUST TRUE) FALSE TRUE FALSE EQUALS JUST TRUE  -- (ii)
#ASSERT `s 7(7)(a) the approved mediator must issue the claimant a claim referral certificate for the dispute referred by the District Court` TRUE (JUST TRUE) FALSE FALSE TRUE EQUALS JUST TRUE  -- (iii)
#ASSERT `s 7(7)(a) the approved mediator must issue the claimant a claim referral certificate for the dispute referred by the District Court` TRUE (JUST TRUE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 7(7)(a) the approved mediator must issue the claimant a claim referral certificate for the dispute referred by the District Court` FALSE (JUST TRUE) TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 7(7)(a) the approved mediator must issue the claimant a claim referral certificate for the dispute referred by the District Court` TRUE (JUST FALSE) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 7(7)(a) the approved mediator must issue the claimant a claim referral certificate for the dispute referred by the District Court` TRUE NOTHING TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 7(7)(b) the approved mediator may discontinue the mediation and refuse to issue a claim referral certificate for the disputes referred by the District Court` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 7(7)(b) the approved mediator may discontinue the mediation and refuse to issue a claim referral certificate for the disputes referred by the District Court` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 7(7)(b) the approved mediator may discontinue the mediation and refuse to issue a claim referral certificate for the disputes referred by the District Court` FALSE TRUE EQUALS JUST FALSE

#ASSERT `s 7(9) section 30H(3) to (9) of the Industrial Relations Act 1960 applies to the dispute` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 7(9) section 30H(3) to (9) of the Industrial Relations Act 1960 applies to the dispute` TRUE FALSE EQUALS NOTHING
#ASSERT `s 7(9) section 30H(3) to (9) of the Industrial Relations Act 1960 applies to the dispute` FALSE TRUE EQUALS NOTHING

§ `Tests -- the rulings of 2026-11-05 and the review's findings`

-- s 3(1), the other half: the request must relate to every dispute the claim is lodged for.  args = disputes the claim is lodged for, disputes the request relates to
#ASSERT `s 3(1) the mediation request relates to every specified employment dispute for which the claim will be lodged` 2 2 EQUALS JUST TRUE
#ASSERT `s 3(1) the mediation request relates to every specified employment dispute for which the claim will be lodged` 2 1 EQUALS JUST FALSE  -- one dispute is left out
#ASSERT `s 3(1) the mediation request relates to every specified employment dispute for which the claim will be lodged` 1 3 EQUALS JUST TRUE  -- the request may relate to more
-- s 3(3)(a)(ii), ruled I(a): "not earlier than one year before" is a period in the text's own words, so outside it the answer is JUST FALSE, whatever (i) and (iii) say
#ASSERT `s 3(3)(a) the mediation request must list the specified employment dispute` FALSE FALSE (Date 14 1 2025) (Date 15 1 2026) FALSE FALSE EQUALS JUST FALSE  -- one year and a day
#ASSERT `s 3(3)(a) the mediation request must list the specified employment dispute` FALSE FALSE (Date 15 1 2025) (Date 15 1 2026) FALSE FALSE EQUALS JUST TRUE  -- exactly one year
#ASSERT `s 3(3)(a) the mediation request must list the specified employment dispute` TRUE FALSE (Date 14 1 2025) (Date 15 1 2026) TRUE FALSE EQUALS JUST FALSE  -- (ii) fails and so do (i) and (iii)
-- s 3(5): "Upon accepting" is read as "where" (assumed, fork F9); the dispute must be one listed in the request (scope, ruled I(c))
#ASSERT `s 3(5) the Commissioner must refer the specified employment dispute for mediation by an approved mediator` TRUE FALSE EQUALS NOTHING  -- accepted, but this dispute is not listed
#ASSERT `s 3(5) the Commissioner must refer the specified employment dispute for mediation by an approved mediator` FALSE FALSE EQUALS JUST FALSE  -- not accepted: the "upon" is not met first
-- s 4(4): "Subsection (4) applies where" is ruled I(b); an unknown answer to s 4(5) is not a no
#ASSERT `s 4(4) the same approved mediator may take the disputes together` NOTHING EQUALS NOTHING
-- s 6(2): section 6 applies "where" is ruled I(b); a settled or withdrawn dispute is outside "every unresolved ... dispute" (scope, ruled I(c))
#ASSERT `s 6(2) the approved mediator must issue the claimant a claim referral certificate for the dispute` NOTHING (JUST TRUE) TRUE FALSE FALSE EQUALS NOTHING  -- whether section 6 applies was not given
#ASSERT `s 6(2) the approved mediator must issue the claimant a claim referral certificate for the dispute` (JUST TRUE) (JUST FALSE) TRUE FALSE FALSE EQUALS NOTHING  -- the dispute is settled or withdrawn
#ASSERT `s 6(2) the approved mediator must issue the claimant a claim referral certificate for the dispute` (JUST TRUE) NOTHING TRUE FALSE FALSE EQUALS NOTHING  -- whether the dispute is unresolved was not given
-- s 7(1)(b) and (c): "(if any)" -- a total of nothing cannot exceed a limit whatever the limit is (fork F11)
#ASSERT `s 7(1)(b) the total amount payable to the party for contractual and statutory disputes is within the limit` TRUE 0 NOTHING EQUALS JUST TRUE
#ASSERT `s 7(1)(c) the total amount payable to the party for wrongful dismissal disputes is within the limit` TRUE 0 NOTHING EQUALS JUST TRUE
#ASSERT `s 7(1)(c) the total amount payable to the party for wrongful dismissal disputes is within the limit` TRUE 1 NOTHING EQUALS NOTHING  -- a positive total against a limit that is not known
-- s 7(4): the period is fixed by reference to Rules of Court (ruled I(a), fork F10); an unknown period is not a no
#ASSERT `s 7(4) a party may apply to set aside the registration` TRUE NOTHING EQUALS NOTHING

-- s 3(6)(b): who may submit a mediation request for a claimant is whom the regulations prescribe
#ASSERT `s 3(6)(b) the person may submit the mediation request on behalf of the claimant` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 3(6)(b) the person may submit the mediation request on behalf of the claimant` (JUST FALSE) EQUALS NOTHING  -- the Act does not say that a person the regulations do not prescribe may not
#ASSERT `s 3(6)(b) the person may submit the mediation request on behalf of the claimant` NOTHING EQUALS NOTHING  -- the regulations are not among the sources
-- s 6(2): the certificate is issued to the claimant
#ASSERT `s 6(2) the claim referral certificate is issued to the person` TRUE EQUALS JUST TRUE
#ASSERT `s 6(2) the claim referral certificate is issued to the person` FALSE EQUALS NOTHING
