#ASSERT `s 4(4) the same approved mediator may take the disputes together` NOTHING EQUALS NOTHING
#ASSERT `s 4(4) the same approved mediator may take the disputes together` (JUST FALSE) EQUALS JUST FALSE

-- s 4(1) as a regulative rule.  Trace 6 (first session conducted on day 10) -> FULFILLED.
#TRACE `s 4(1) the approved mediator's duty to conduct the first mediation session` AT 0 WITH
    PARTY `Approved mediator` DOES `conduct the first mediation session` AT 10

§ `Tests -- s 5`

#ASSERT `s 5(5) the entity is a body corporate` TRUE EQUALS JUST TRUE
#ASSERT `s 5(5) the entity is a body corporate` FALSE EQUALS NOTHING  -- "includes": the text does not list what else is a body corporate
#ASSERT `s 5(5) the person is an officer of the body corporate` `Director` FALSE EQUALS JUST TRUE
#ASSERT `s 5(5) the person is an officer of the body corporate` `Partner` FALSE EQUALS JUST TRUE
