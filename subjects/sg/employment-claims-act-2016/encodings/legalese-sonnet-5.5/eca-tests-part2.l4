IMPORT prelude
IMPORT daydate
IMPORT `eca-nouns`
IMPORT `eca-schedules`
IMPORT `eca-part1-preliminary`
IMPORT `eca-part2-mediation`

-- Tests of Part 2 (ss 3 to 7).  Every expected value was decided from the text before the run and is written beside its assertion.
-- Numbers used for amounts, fees and claim limits in these tests are arbitrary test values: the Act fixes none of them (they are prescribed outside it).

§ `Tests -- s 3`

#ASSERT `s 3(8) section 3 does not apply to the claim` TRUE EQUALS JUST TRUE
#ASSERT `s 3(8) section 3 does not apply to the claim` FALSE EQUALS JUST FALSE  -- no tripartite mediation, so section 3 applies (the "if" rule of 2026-10-29)

#ASSERT `s 3(1) the claimant must submit a mediation request before lodging the claim` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 3(1) the claimant must submit a mediation request before lodging the claim` TRUE TRUE EQUALS JUST FALSE  -- s 3(8): a tripartite mediation was conducted
#ASSERT `s 3(1) the claimant must submit a mediation request before lodging the claim` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 3(1) the claimant must submit a mediation request before lodging the claim` FALSE FALSE EQUALS NOTHING  -- a claim not lodged for a specified employment dispute

-- s 3(1) and (2) as a regulative rule.  Expected (decided from the text): an act within the days allowed fulfils the duty; an act after them, or no act, does not.
-- Trace 1 (act on day 100 of 180) -> FULFILLED
#TRACE `s 3(1) and (2) the claimant's duty to submit a mediation request` 180 AT 0 WITH
    PARTY Claimant DOES `submit a mediation request` AT 100
-- Trace 2 (act on day 180 of 180: the last day) -> FULFILLED
#TRACE `s 3(1) and (2) the claimant's duty to submit a mediation request` 180 AT 0 WITH
    PARTY Claimant DOES `submit a mediation request` AT 180
-- Trace 3 (act on day 181 of 180) -> BREACH BY Claimant
#TRACE `s 3(1) and (2) the claimant's duty to submit a mediation request` 180 AT 0 WITH
    PARTY Claimant DOES `submit a mediation request` AT 181

§§ `Tests -- s 3(2)`

#ASSERT `s 3(2)(a) the last day for a request about recovering salary under section 65 of the Employment Act 1968` (JUST (Date 15 3 2026)) EQUALS JUST (Date 15 3 2026)
#ASSERT `s 3(2)(a) the last day for a request about recovering salary under section 65 of the Employment Act 1968` NOTHING EQUALS NOTHING  -- the EA period is outside the sources

-- 6 months after 31 August 2025: the corresponding day, 28 February 2026 (February has 28 days in 2026, fork F6)
#ASSERT `s 3(2)(b) the last day for a request about a re-employment dispute described in section 8A(3) of the Retirement and Re-employment Act 1993` (JUST (Date 31 8 2025)) EQUALS JUST (Date 28 2 2026)
#ASSERT `s 3(2)(b) the last day for a request about a re-employment dispute described in section 8A(3) of the Retirement and Re-employment Act 1993` (JUST (Date 30 9 2025)) EQUALS JUST (Date 30 3 2026)
#ASSERT `s 3(2)(b) the last day for a request about a re-employment dispute described in section 8A(3) of the Retirement and Re-employment Act 1993` (JUST (Date 31 1 2025)) EQUALS JUST (Date 31 7 2025)
#ASSERT `s 3(2)(b) the last day for a request about a re-employment dispute described in section 8A(3) of the Retirement and Re-employment Act 1993` NOTHING EQUALS NOTHING

#ASSERT `s 3(2)(c) the last day for a request about a re-employment dispute under section 8B(7) of the Retirement and Re-employment Act 1993` (JUST (Date 1 12 2026)) EQUALS JUST (Date 1 12 2026)
#ASSERT `s 3(2)(c) the last day for a request about a re-employment dispute under section 8B(7) of the Retirement and Re-employment Act 1993` NOTHING EQUALS NOTHING

-- one month after 15 January 2026 is 15 February 2026; after 31 January 2026 it is 28 February 2026
#ASSERT `s 3(2)(d) the last day for a request about a wrongful dismissal dispute for a claim mentioned in section 14(2) of the Employment Act 1968` (JUST (Date 15 1 2026)) EQUALS JUST (Date 15 2 2026)
#ASSERT `s 3(2)(d) the last day for a request about a wrongful dismissal dispute for a claim mentioned in section 14(2) of the Employment Act 1968` (JUST (Date 31 1 2026)) EQUALS JUST (Date 28 2 2026)
#ASSERT `s 3(2)(d) the last day for a request about a wrongful dismissal dispute for a claim mentioned in section 14(2) of the Employment Act 1968` NOTHING EQUALS NOTHING

-- 2 months after confinement on 10 March 2026 is 10 May 2026; after 31 December 2025 it is 28 February 2026
#ASSERT `s 3(2)(e) the last day for a request about a wrongful dismissal dispute for a claim mentioned in section 84(2) of the Employment Act 1968` (JUST (Date 10 3 2026)) EQUALS JUST (Date 10 5 2026)
#ASSERT `s 3(2)(e) the last day for a request about a wrongful dismissal dispute for a claim mentioned in section 84(2) of the Employment Act 1968` (JUST (Date 31 12 2025)) EQUALS JUST (Date 28 2 2026)
#ASSERT `s 3(2)(e) the last day for a request about a wrongful dismissal dispute for a claim mentioned in section 84(2) of the Employment Act 1968` NOTHING EQUALS NOTHING

#ASSERT `s 3(2)(f) the last day for a request about another specified employment dispute after the employment relationship has ended` (JUST (Date 31 8 2025)) EQUALS JUST (Date 28 2 2026)
#ASSERT `s 3(2)(f) the last day for a request about another specified employment dispute after the employment relationship has ended` (JUST (Date 15 6 2025)) EQUALS JUST (Date 15 12 2025)
#ASSERT `s 3(2)(f) the last day for a request about another specified employment dispute after the employment relationship has ended` NOTHING EQUALS NOTHING

-- one year after 15 June 2025 is 15 June 2026; after 29 February 2024 it is 28 February 2025
#ASSERT `s 3(2)(g) the last day for a request about any other specified employment dispute` (JUST (Date 15 6 2025)) EQUALS JUST (Date 15 6 2026)
#ASSERT `s 3(2)(g) the last day for a request about any other specified employment dispute` (JUST (Date 29 2 2024)) EQUALS JUST (Date 28 2 2025)
#ASSERT `s 3(2)(g) the last day for a request about any other specified employment dispute` NOTHING EQUALS NOTHING

-- Fixtures for the chooser.  `time limit facts` builds the record: kind, employment ended, then the five dates it may need (NOTHING for a date not given).
GIVEN k IS A `Kind of dispute for the time limit`
      ended IS A BOOLEAN
      s65 IS A MAYBE DATE
      lastday IS A MAYBE DATE
      s8b8 IS A MAYBE DATE
      dismissal IS A MAYBE DATE
      confinement IS A MAYBE DATE
      material IS A MAYBE DATE
GIVETH A `Facts for the mediation request time limit`
`time limit facts` MEANS
    `Facts for the mediation request time limit` WITH
        kind IS k
        `the employment relationship has ended` IS ended
        `the last day of the period in section 65(2A) of the Employment Act 1968, as extended under section 65(2B)` IS s65
        `the last day of employment of the employee` IS lastday
        `the last day of the time determined under section 8B(8) of the Retirement and Re-employment Act 1993` IS s8b8
        `the date of the dismissal of the employee` IS dismissal
        `the date of the employee's confinement` IS confinement
        `the date on which the material facts giving rise to the earliest specified employment dispute listed in the mediation request occurred` IS material

-- (a) salary recovery
#ASSERT `s 3(2) the last day by which the mediation request must be submitted` (`time limit facts` `Recovery of salary under section 65 of the Employment Act 1968` FALSE (JUST (Date 15 3 2026)) NOTHING NOTHING NOTHING NOTHING NOTHING) EQUALS JUST (Date 15 3 2026)
-- (b) re-employment under 8A(3): 6 months after the last day of employment
#ASSERT `s 3(2) the last day by which the mediation request must be submitted` (`time limit facts` `Re-employment dispute described in section 8A(3) of the Retirement and Re-employment Act 1993` TRUE NOTHING (JUST (Date 31 8 2025)) NOTHING NOTHING NOTHING NOTHING) EQUALS JUST (Date 28 2 2026)
-- (c) re-employment under 8B(7)
#ASSERT `s 3(2) the last day by which the mediation request must be submitted` (`time limit facts` `Re-employment dispute under section 8B(7) of the Retirement and Re-employment Act 1993` TRUE NOTHING NOTHING (JUST (Date 1 12 2026)) NOTHING NOTHING NOTHING) EQUALS JUST (Date 1 12 2026)
-- (d) wrongful dismissal, s 14(2) EA: one month after the dismissal
#ASSERT `s 3(2) the last day by which the mediation request must be submitted` (`time limit facts` `Wrongful dismissal dispute for a claim mentioned in section 14(2) of the Employment Act 1968` TRUE NOTHING NOTHING NOTHING (JUST (Date 15 1 2026)) NOTHING NOTHING) EQUALS JUST (Date 15 2 2026)
-- (e) wrongful dismissal, s 84(2) EA: 2 months after confinement
#ASSERT `s 3(2) the last day by which the mediation request must be submitted` (`time limit facts` `Wrongful dismissal dispute for a claim mentioned in section 84(2) of the Employment Act 1968` TRUE NOTHING NOTHING NOTHING NOTHING (JUST (Date 10 3 2026)) NOTHING) EQUALS JUST (Date 10 5 2026)
-- (f) another dispute, employment ended: 6 months after the last day of employment
#ASSERT `s 3(2) the last day by which the mediation request must be submitted` (`time limit facts` `Another specified employment dispute` TRUE NOTHING (JUST (Date 31 8 2025)) NOTHING NOTHING NOTHING (JUST (Date 1 1 2025))) EQUALS JUST (Date 28 2 2026)
-- (g) another dispute, employment not ended: one year after the material facts
#ASSERT `s 3(2) the last day by which the mediation request must be submitted` (`time limit facts` `Another specified employment dispute` FALSE NOTHING (JUST (Date 31 8 2025)) NOTHING NOTHING NOTHING (JUST (Date 15 6 2025))) EQUALS JUST (Date 15 6 2026)
-- the date the paragraph counts from was not given
#ASSERT `s 3(2) the last day by which the mediation request must be submitted` (`time limit facts` `Another specified employment dispute` TRUE NOTHING NOTHING NOTHING NOTHING NOTHING (JUST (Date 15 6 2025))) EQUALS NOTHING
#ASSERT `s 3(2) the last day by which the mediation request must be submitted` (`time limit facts` `Another specified employment dispute` FALSE NOTHING (JUST (Date 31 8 2025)) NOTHING NOTHING NOTHING NOTHING) EQUALS NOTHING

-- in time: on or before the last day
#ASSERT `s 3(2) the mediation request is submitted by the time` (JUST (Date 28 2 2026)) (Date 28 2 2026) EQUALS JUST TRUE  -- the last day itself
#ASSERT `s 3(2) the mediation request is submitted by the time` (JUST (Date 28 2 2026)) (Date 1 3 2026) EQUALS JUST FALSE  -- a day late
#ASSERT `s 3(2) the mediation request is submitted by the time` (JUST (Date 28 2 2026)) (Date 1 1 2026) EQUALS JUST TRUE
#ASSERT `s 3(2) the mediation request is submitted by the time` NOTHING (Date 1 1 2026) EQUALS NOTHING

§§ `Tests -- s 3(3)`

-- s 3(3)(a): args = claim for an amount exists, it satisfies s 12(2) to (4), date of material facts, date submitted, listed in an earlier accepted request, withdrawn before its first session
#ASSERT `s 3(3)(a) the mediation request must list the specified employment dispute` FALSE FALSE (Date 1 6 2025) (Date 1 6 2026) FALSE FALSE EQUALS JUST TRUE  -- no claim for an amount; exactly one year: not earlier than one year before
#ASSERT `s 3(3)(a) the mediation request must list the specified employment dispute` FALSE FALSE (Date 31 5 2025) (Date 1 6 2026) FALSE FALSE EQUALS JUST FALSE  -- one year and a day: (ii) fails
#ASSERT `s 3(3)(a) the mediation request must list the specified employment dispute` TRUE TRUE (Date 1 6 2025) (Date 1 6 2026) FALSE FALSE EQUALS JUST TRUE  -- (i): the claim satisfies s 12(2) to (4)
#ASSERT `s 3(3)(a) the mediation request must list the specified employment dispute` TRUE FALSE (Date 1 6 2025) (Date 1 6 2026) FALSE FALSE EQUALS NOTHING  -- (i) fails
#ASSERT `s 3(3)(a) the mediation request must list the specified employment dispute` FALSE FALSE (Date 1 6 2025) (Date 1 6 2026) TRUE FALSE EQUALS NOTHING  -- (iii): listed earlier and not withdrawn
#ASSERT `s 3(3)(a) the mediation request must list the specified employment dispute` FALSE FALSE (Date 1 6 2025) (Date 1 6 2026) TRUE TRUE EQUALS JUST TRUE  -- (iii): listed earlier but withdrawn before the first session

-- s 3(3)(b): args = (a) requires an earlier request to list it, the prescribed requirements are satisfied
#ASSERT `s 3(3)(b) the mediation request must not list the specified employment dispute` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 3(3)(b) the mediation request must not list the specified employment dispute` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 3(3)(b) the mediation request must not list the specified employment dispute` TRUE NOTHING EQUALS NOTHING  -- the prescribed requirements are outside the sources
#ASSERT `s 3(3)(b) the mediation request must not list the specified employment dispute` FALSE (JUST FALSE) EQUALS JUST FALSE

-- s 3(3)(c)
#ASSERT `s 3(3)(c) the mediation request must not list the specified employment dispute` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 3(3)(c) the mediation request must not list the specified employment dispute` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 3(3)(c) the mediation request must not list the specified employment dispute` FALSE TRUE EQUALS JUST FALSE

-- s 3(3)(d): the amount that accompanies the request against the prescribed fee (test values)
#ASSERT `s 3(3)(d) the mediation request is accompanied by the prescribed fee` 50 (JUST 50) EQUALS JUST TRUE  -- exactly the fee
#ASSERT `s 3(3)(d) the mediation request is accompanied by the prescribed fee` 49 (JUST 50) EQUALS JUST FALSE
#ASSERT `s 3(3)(d) the mediation request is accompanied by the prescribed fee` 60 (JUST 50) EQUALS JUST TRUE
#ASSERT `s 3(3)(d) the mediation request is accompanied by the prescribed fee` 50 NOTHING EQUALS NOTHING

§§ `Tests -- s 3(4) and (5)`

-- s 3(4)(a): args = complies with (2) and (3), s 12(7) can be satisfied
#ASSERT `s 3(4)(a) the Commissioner may refuse to accept the mediation request` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 3(4)(a) the Commissioner may refuse to accept the mediation request` FALSE TRUE EQUALS JUST TRUE  -- (i)
#ASSERT `s 3(4)(a) the Commissioner may refuse to accept the mediation request` TRUE FALSE EQUALS JUST TRUE  -- (ii)
#ASSERT `s 3(4)(a) the Commissioner may refuse to accept the mediation request` FALSE FALSE EQUALS JUST TRUE

#ASSERT `s 3(4)(b) the Commissioner may waive, remit or refund the fee` EQUALS JUST TRUE

#ASSERT `s 3(4)(c) the Commissioner may pay the whole or a part of the fee to the person` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 3(4)(c) the Commissioner may pay the whole or a part of the fee to the person` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 3(4)(c) the Commissioner may pay the whole or a part of the fee to the person` NOTHING EQUALS NOTHING

#ASSERT `s 3(5) the Commissioner must refer the specified employment dispute for mediation by an approved mediator` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 3(5) the Commissioner must refer the specified employment dispute for mediation by an approved mediator` FALSE TRUE EQUALS JUST FALSE  -- not yet accepted
#ASSERT `s 3(5) the Commissioner must refer the specified employment dispute for mediation by an approved mediator` TRUE FALSE EQUALS NOTHING  -- not listed in the request

-- s 3(5) as a regulative rule: no time stated, so the duty stands until done.  Trace 4 (referred on day 7) -> FULFILLED.  Trace 5 (nothing happens) -> the obligation stands as the residual.
#TRACE `s 3(5) the Commissioner's duty to refer the listed disputes for mediation` AT 0 WITH
    PARTY Commissioner DOES `refer every listed specified employment dispute for mediation` AT 7
#TRACE `s 3(5) the Commissioner's duty to refer the listed disputes for mediation` AT 0 WITH
    PARTY Claimant DOES `submit a mediation request` AT 7

§ `Tests -- s 4`

#ASSERT `s 4(1) the approved mediator must conduct the first mediation session` TRUE EQUALS JUST TRUE
#ASSERT `s 4(1) the approved mediator must conduct the first mediation session` FALSE EQUALS JUST FALSE
