#ASSERT `s 4(5) subsection (4) applies` TRUE FALSE FALSE FALSE EQUALS JUST FALSE  -- (a) without the Commissioner's satisfaction
#ASSERT `s 4(5) subsection (4) applies` FALSE FALSE TRUE FALSE EQUALS JUST TRUE  -- (b)
#ASSERT `s 4(5) subsection (4) applies` FALSE FALSE FALSE TRUE EQUALS JUST TRUE  -- (c)
#ASSERT `s 4(5) subsection (4) applies` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
