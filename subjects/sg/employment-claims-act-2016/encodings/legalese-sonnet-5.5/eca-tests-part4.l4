IMPORT prelude
IMPORT daydate
IMPORT `eca-nouns`
IMPORT `eca-schedules`
IMPORT `eca-part1-preliminary`
IMPORT `eca-part4-miscellaneous`

-- Tests of Part 4 (ss 28 to 31 and 35(2)).  Every expected value was decided from the text before the run and is written beside its assertion.

§ `Tests -- s 28`

#ASSERT `s 28 the date on which the agreement was made does not affect whether the provision is void` (Date 31 3 2017) EQUALS JUST TRUE
#ASSERT `s 28 the date on which the agreement was made does not affect whether the provision is void` (Date 1 4 2017) EQUALS JUST TRUE
#ASSERT `s 28 the date on which the agreement was made does not affect whether the provision is void` (Date 2 4 2017) EQUALS JUST TRUE
#ASSERT `s 28 the provision in the agreement is void to that extent` `Exclude or limit the jurisdiction of a tribunal` EQUALS JUST TRUE
#ASSERT `s 28 the provision in the agreement is void to that extent` `Prevent a person from submitting a mediation request` EQUALS JUST TRUE
#ASSERT `s 28 the provision in the agreement is void to that extent` `Prevent a person from making a claim, an application or an appeal under this Act` EQUALS JUST TRUE
#ASSERT `s 28 the provision in the agreement is void to that extent` `Something else` EQUALS NOTHING

§ `Tests -- s 29`

#ASSERT `s 29(3) the body is a law enforcement agency` TRUE EQUALS JUST TRUE
#ASSERT `s 29(3) the body is a law enforcement agency` FALSE EQUALS JUST FALSE
#ASSERT `s 29(3) the body is a public agency` TRUE (JUST FALSE) EQUALS JUST TRUE  -- the Government
#ASSERT `s 29(3) the body is a public agency` FALSE (JUST TRUE) EQUALS JUST TRUE  -- a prescribed statutory body
#ASSERT `s 29(3) the body is a public agency` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 29(3) the body is a public agency` FALSE NOTHING EQUALS NOTHING
-- s 29(1): args = discloser, (a) administration, (b) assistance, (c) law enforcement, (d) policy, (e) public interest, (f) prescribed purpose
#ASSERT `s 29(1) the person may disclose the information` `The Commissioner` TRUE FALSE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 29(1) the person may disclose the information` `An approved mediator` FALSE TRUE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 29(1) the person may disclose the information` `A tribunal magistrate` FALSE FALSE TRUE FALSE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 29(1) the person may disclose the information` `A Registrar` FALSE FALSE FALSE TRUE FALSE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 29(1) the person may disclose the information` `The Commissioner` FALSE FALSE FALSE FALSE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 29(1) the person may disclose the information` `The Commissioner` FALSE FALSE FALSE FALSE FALSE (JUST TRUE) EQUALS JUST TRUE  -- (f)
#ASSERT `s 29(1) the person may disclose the information` `The Commissioner` FALSE FALSE FALSE FALSE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 29(1) the person may disclose the information` `The Commissioner` FALSE FALSE FALSE FALSE FALSE NOTHING EQUALS NOTHING
#ASSERT `s 29(1) the person may disclose the information` `Someone else who holds information` TRUE TRUE TRUE TRUE TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 29(2) the person may publish the information` `A tribunal magistrate` TRUE EQUALS JUST TRUE
#ASSERT `s 29(2) the person may publish the information` `A Registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 29(2) the person may publish the information` `The Commissioner` TRUE EQUALS NOTHING
#ASSERT `s 29(2) the person may publish the information` `A Registrar` FALSE EQUALS NOTHING

§ `Tests -- ss 30 and 31`

#ASSERT `s 30(1) the person has the same protection that a Magistrate has under the State Courts Act 1970` TRUE EQUALS JUST TRUE
#ASSERT `s 30(1) the person has the same protection that a Magistrate has under the State Courts Act 1970` FALSE EQUALS NOTHING
#ASSERT `s 30(2) the Registrar has the same protection as a tribunal magistrate` TRUE EQUALS JUST TRUE
#ASSERT `s 30(2) the Registrar has the same protection as a tribunal magistrate` FALSE EQUALS JUST FALSE
#ASSERT `s 30(3) no liability lies personally against the person` `The Commissioner` TRUE EQUALS JUST TRUE
#ASSERT `s 30(3) no liability lies personally against the person` `An individual authorised to carry out a function or duty of the Commissioner under this Act` TRUE EQUALS JUST TRUE
#ASSERT `s 30(3) no liability lies personally against the person` `An approved mediator` TRUE EQUALS JUST TRUE
#ASSERT `s 30(3) no liability lies personally against the person` `An approved mediator` FALSE EQUALS NOTHING  -- acted in bad faith or without reasonable care
#ASSERT `s 30(3) no liability lies personally against the person` `Someone else` TRUE EQUALS NOTHING
#ASSERT `s 31(1) the approved mediator is deemed to be a public servant for the purposes of the Penal Code 1871` TRUE EQUALS JUST TRUE
#ASSERT `s 31(1) the approved mediator is deemed to be a public servant for the purposes of the Penal Code 1871` FALSE EQUALS JUST FALSE
#ASSERT `s 31(2) the authorised person is deemed to be a public servant for the purposes of the Penal Code 1871` TRUE EQUALS JUST TRUE
#ASSERT `s 31(2) the authorised person is deemed to be a public servant for the purposes of the Penal Code 1871` FALSE EQUALS JUST FALSE

§ `Tests -- s 35(2)`

#ASSERT `s 35(2) regard may be had to the guidelines for the purposes of sections 20(7) and 25(4)` TRUE EQUALS JUST TRUE
#ASSERT `s 35(2) regard may be had to the guidelines for the purposes of sections 20(7) and 25(4)` FALSE EQUALS JUST FALSE
