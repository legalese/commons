§ `s 7 -- Small Claims Tribunal, business use`

#ASSERT NOT `Can a Small Claims Tribunal hear my claim` TRUE TRUE FALSE
#ASSERT `Can a Small Claims Tribunal hear my claim` FALSE FALSE TRUE

#ASSERT `What relief can I get for goods or services I meant for business use` FALSE FALSE FALSE FALSE EQUALS `relief may be granted`
#ASSERT `What relief can I get for goods or services I meant for business use` FALSE FALSE TRUE FALSE EQUALS `no relief -- intended for business use`
#ASSERT `What relief can I get for goods or services I meant for business use` FALSE TRUE FALSE FALSE EQUALS `relief only for the part the court attributes to non-business use`

§ `ss 35, 36, 39, 40`

#ASSERT NOT `Am I bound by the term or waiver` TRUE FALSE
#ASSERT `Am I bound by the term or waiver` TRUE TRUE

#ASSERT `Do I have the consumer's rights as heir or assignee` TRUE TRUE TRUE FALSE

