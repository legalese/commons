IMPORT prelude
IMPORT `amla-wills-inheritance`

-- Administration of Muslim Law Act 1966, ss 110 to 116 and 118 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case, a Syariah Court certificate, a fatwa or subsidiary legislation (none was retrieved).
-- Expected results were written by hand from the text.

`Haziq` MEANS Testator WITH
    `is a Muslim` IS TRUE
    `is domiciled in Singapore` IS TRUE
    `died before 1 July 1968` IS FALSE

`a Muslim domiciled abroad` MEANS Testator WITH
    `is a Muslim` IS TRUE
    `is domiciled in Singapore` IS FALSE
    `died before 1 July 1968` IS FALSE

`a Muslim who died in 1967` MEANS Testator WITH
    `is a Muslim` IS TRUE
    `is domiciled in Singapore` IS TRUE
    `died before 1 July 1968` IS TRUE

`a non-Muslim domiciled in Singapore` MEANS Testator WITH
    `is a Muslim` IS FALSE
    `is domiciled in Singapore` IS TRUE
    `died before 1 July 1968` IS FALSE

`Aminah` MEANS Testator WITH
    `is a Muslim` IS TRUE
    `is domiciled in Singapore` IS TRUE
    `died before 1 July 1968` IS FALSE

`Haziq's estate proceedings` MEANS EstateProceeding WITH
    `proceedings on administration or distribution are on foot` IS TRUE
    `the estate is to be distributed according to Muslim law` IS TRUE
    `a court or authority must determine the persons entitled or their shares` IS TRUE

`no proceedings yet` MEANS EstateProceeding WITH
    `proceedings on administration or distribution are on foot` IS FALSE
    `the estate is to be distributed according to Muslim law` IS TRUE
    `a court or authority must determine the persons entitled or their shares` IS FALSE

`a non-Muslim estate` MEANS EstateProceeding WITH
    `proceedings on administration or distribution are on foot` IS TRUE
    `the estate is to be distributed according to Muslim law` IS FALSE
    `a court or authority must determine the persons entitled or their shares` IS TRUE

§ `REQ-0282 (Haziq scenario, h085)`

-- Haziq, Muslim, domiciled in Singapore, dying now, leaves one third to a registered charity by will. s 111 governs his will.
#ASSERT `s 111 restricts the will` `Haziq`

-- The will is valid under the Act only if his school allows the gift. The Act itself states no fraction.
-- If his school allows a one-third gift to a non-heir (the ledger's assumption; not stated in the Act), it stands:
#ASSERT `s 111 allows the disposition` `Haziq` TRUE
-- If his school did not allow it, s 111(1) would bar it, "despite anything in ... English law":
#ASSERT NOT `s 111 allows the disposition` `Haziq` FALSE

-- With a school limit of one third supplied by the caller, a one-third gift is within it; anything more is not.
#ASSERT `the share is within the school's limit` (1 DIVIDED BY 3) (1 DIVIDED BY 3)
#ASSERT NOT `the share is within the school's limit` (2 DIVIDED BY 5) (1 DIVIDED BY 3)

-- The two thirds not disposed of by will pass as on partial intestacy, by Muslim law (s 112(1), (2)).
#ASSERT `s 112 sends the undisposed estate by Muslim law` `Haziq` FALSE TRUE

-- No provision makes an inheritance certificate a precondition of distribution.
#ASSERT NOT `the Act makes an inheritance certificate a precondition of distribution`

-- But once the estate is in administration proceedings where a court or authority must fix the heirs and shares, a family
-- member claiming to be a beneficiary may apply, on paying the fee, and the Syariah Court may certify (s 115(1)).
#ASSERT `the Syariah Court may certify` `Haziq's estate proceedings` `a person claiming to be a beneficiary` TRUE

-- The probate affidavit for his estate must state his Mazhab (s 113).
#ASSERT `the affidavit must state the Mazhab` TRUE TRUE

§ `ss 110 and 111`

#ASSERT NOT `s 111 restricts the will` `a Muslim domiciled abroad`
#ASSERT NOT `s 111 restricts the will` `a Muslim who died in 1967`
#ASSERT NOT `s 111 restricts the will` `a non-Muslim domiciled in Singapore`
#ASSERT `s 111 allows the disposition` `a Muslim domiciled abroad` FALSE

#ASSERT `the share is within the school's limit` 0.25 (1 DIVIDED BY 3)
#ASSERT NOT `the share is within the school's limit` 0.34 (1 DIVIDED BY 3)

#ASSERT NOT `s 111 leaves the law unaffected` `the Wills Act 1838 section 3`
#ASSERT `s 111 leaves the law unaffected` `the Wills Act 1838 other provisions`
#ASSERT `s 111 leaves the law unaffected` `the Insurance Act 1966`
#ASSERT `s 111 leaves the law unaffected` `the Probate and Administration Act 1934`
#ASSERT NOT `s 111 leaves the law unaffected` `English law generally`

§ `s 112`

#ASSERT `s 112 sends the undisposed estate by Muslim law` `Haziq` TRUE FALSE
#ASSERT NOT `s 112 sends the undisposed estate by Muslim law` `a Muslim domiciled abroad` TRUE FALSE
#ASSERT NOT `s 112 sends the undisposed estate by Muslim law` `a non-Muslim domiciled in Singapore` TRUE FALSE

#ASSERT `the court may divide harta sepencarian` TRUE TRUE FALSE
#ASSERT `the court may divide harta sepencarian` TRUE FALSE TRUE
#ASSERT NOT `the court may divide harta sepencarian` FALSE TRUE FALSE

§ `s 113`

#ASSERT NOT `the affidavit must state the Mazhab` FALSE TRUE

§ `s 115`

#ASSERT `the Syariah Court may certify` `Haziq's estate proceedings` `the court or authority` TRUE
#ASSERT NOT `the Syariah Court may certify` `Haziq's estate proceedings` `a person not claiming to be a beneficiary` TRUE
#ASSERT NOT `the Syariah Court may certify` `Haziq's estate proceedings` `a person claiming to be a beneficiary` FALSE
#ASSERT NOT `the Syariah Court may certify` `no proceedings yet` `a person claiming to be a beneficiary` TRUE
#ASSERT NOT `the Syariah Court may certify` `a non-Muslim estate` `the court or authority` TRUE

#ASSERT `the certificate may rest on` `facts found by the court or authority`
#ASSERT `the certificate may rest on` `a hypothetical set of facts`
#ASSERT NOT `the certificate may rest on` `facts the Syariah Court finds itself`

#ASSERT `the Syariah Court may take the step` `hearing the parties on a question of law`
#ASSERT NOT `the Syariah Court may take the step` `hearing evidence`
#ASSERT NOT `the Syariah Court may take the step` `making findings of fact`

#ASSERT `whose opinion is certified` TRUE TRUE EQUALS `the Legal Committee's opinion`
#ASSERT `whose opinion is certified` TRUE FALSE EQUALS `the Syariah Court's own opinion`

§ `s 116`

#ASSERT `s 116 lets the court grant letters of administration to the person` TRUE FALSE
#ASSERT NOT `s 116 lets the court grant letters of administration to the person` FALSE FALSE

§ `s 118`

#ASSERT `a married woman's will of her own property is allowed` `Aminah` TRUE FALSE
#ASSERT NOT `a married woman's will of her own property is allowed` `Aminah` FALSE TRUE
