IMPORT prelude
IMPORT `lsp-corporation`

-- Little Sisters of the Poor Ordinance 1957, ss 2-5 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_little-sisters-of-the-poor-ordinance-1957.py). Expected results were written by
-- hand from the text.

`a deed sealed before and signed by the Reverend Mother Superior` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Reverend Mother Superior for the time being`
    `signed by` IS `the Reverend Mother Superior for the time being`

`a deed sealed before and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney under a deposited power of attorney`
    `signed by` IS `an attorney under a deposited power of attorney`

`a deed sealed before the Reverend Mother Superior and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Reverend Mother Superior for the time being`
    `signed by` IS `an attorney under a deposited power of attorney`

`a deed signed by an attorney whose power was not deposited` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Reverend Mother Superior for the time being`
    `signed by` IS `an attorney whose power of attorney is not deposited`

`an unsealed deed signed by the Reverend Mother Superior` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS FALSE
    `sealed in the presence of` IS `the Reverend Mother Superior for the time being`
    `signed by` IS `the Reverend Mother Superior for the time being`

`a deed sealed before another Sister and signed by the Reverend Mother Superior` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `another Sister`
    `signed by` IS `the Reverend Mother Superior for the time being`

`a deed sealed before and signed by a former Reverend Mother Superior` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a former Reverend Mother Superior`
    `signed by` IS `a former Reverend Mother Superior`

§ `ss 2(1), 4 -- the holder and the Gazette`

#ASSERT `authorisation is conclusively proved` `Reverend Mother Superior` TRUE
#ASSERT NOT `authorisation is conclusively proved` `some other office in the Congregation` TRUE
#ASSERT NOT `authorisation is conclusively proved` `Reverend Mother Superior` FALSE
#ASSERT NOT `authorisation is conclusively proved` `some other office in the Congregation` FALSE

#ASSERT `holds the corporate office` TRUE TRUE
#ASSERT NOT `holds the corporate office` TRUE FALSE
#ASSERT NOT `holds the corporate office` FALSE TRUE

§ `ss 2(2), 2(3) -- powers`

#ASSERT `the Ordinance empowers the Corporation to` `use and change its corporate seal` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `acquire or purchase property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `hold and enjoy property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `sell property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `mortgage property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `mortgage property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `lease property` TRUE
#ASSERT `the Ordinance empowers the Corporation to` `surrender property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `exchange or otherwise dispose of property` FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sue in respect of its property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `be sued in respect of its property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `borrow money without security` TRUE

§ `s 3 -- execution`

#ASSERT `may act for the Corporation under section 3` `the Reverend Mother Superior for the time being` TRUE
#ASSERT `may act for the Corporation under section 3` `an attorney under a deposited power of attorney` TRUE
#ASSERT NOT `may act for the Corporation under section 3` `an attorney whose power of attorney is not deposited` TRUE
#ASSERT NOT `may act for the Corporation under section 3` `a former Reverend Mother Superior` TRUE
#ASSERT NOT `may act for the Corporation under section 3` `another Sister` TRUE
#ASSERT NOT `may act for the Corporation under section 3` `an attorney under a deposited power of attorney` FALSE

#ASSERT `is executed as section 3 requires` `a deed sealed before and signed by the Reverend Mother Superior` TRUE
#ASSERT NOT `is executed as section 3 requires` `a deed sealed before and signed by the Reverend Mother Superior` FALSE
#ASSERT `is executed as section 3 requires` `a deed sealed before and signed by a deposited attorney` TRUE
#ASSERT NOT `is executed as section 3 requires` `a deed sealed before and signed by a deposited attorney` FALSE
#ASSERT `is executed as section 3 requires` `a deed sealed before the Reverend Mother Superior and signed by a deposited attorney` TRUE
#ASSERT NOT `is executed as section 3 requires` `a deed signed by an attorney whose power was not deposited` TRUE
#ASSERT NOT `is executed as section 3 requires` `an unsealed deed signed by the Reverend Mother Superior` TRUE
#ASSERT NOT `is executed as section 3 requires` `a deed sealed before another Sister and signed by the Reverend Mother Superior` TRUE
#ASSERT NOT `is executed as section 3 requires` `a deed sealed before and signed by a former Reverend Mother Superior` TRUE

#ASSERT `the signature is sufficient evidence the seal was duly affixed` `a deed sealed before another Sister and signed by the Reverend Mother Superior` TRUE
#ASSERT NOT `the signature is sufficient evidence the seal was duly affixed` `an unsealed deed signed by the Reverend Mother Superior` TRUE
#ASSERT NOT `the signature is sufficient evidence the seal was duly affixed` `a deed signed by an attorney whose power was not deposited` TRUE
#ASSERT `the signature is sufficient evidence the seal was duly affixed` `a deed sealed before and signed by a deposited attorney` TRUE

