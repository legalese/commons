#ASSERT `the Tribunal may give a successful applicant` `amending a procurement document` FALSE TRUE
#ASSERT `the Tribunal may give a successful applicant` `tender or qualification costs` FALSE TRUE
#ASSERT `the Tribunal may give a successful applicant` `costs of the challenge proceeding` FALSE TRUE
