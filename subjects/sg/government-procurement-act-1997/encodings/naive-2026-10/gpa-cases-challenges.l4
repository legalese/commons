#ASSERT `the determination is out of time` 46 FALSE FALSE
#ASSERT NOT `the determination is out of time` 45 FALSE FALSE
#ASSERT NOT `the determination is out of time` 60 FALSE TRUE

#ASSERT NOT `the certified copies were sent in time` 8

