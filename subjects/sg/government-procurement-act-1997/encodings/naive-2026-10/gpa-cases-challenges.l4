§ `ss 2 and 7(2)`

#ASSERT `the supplier is a relevant supplier` `a Singapore citizen trading alone`
#ASSERT `the supplier is a relevant supplier` `a company formed and based in a specified State`
#ASSERT NOT `the supplier is a relevant supplier` `a Singapore company based in an unlisted country`
#ASSERT NOT `the supplier is a relevant supplier` `an unlisted-country company based in Singapore`
#ASSERT `the supplier is a relevant supplier` `a foreign company named in the order`

#ASSERT `the duty is owed to the supplier` `a foreign company declared by the Minister`
#ASSERT NOT `the duty is owed to the supplier` `a Singapore company based in an unlisted country`

§ `s 7(3)`

#ASSERT `where the breach may be challenged` `a Singapore citizen trading alone` TRUE TRUE FALSE EQUALS `the Tribunal`
#ASSERT `where the breach may be challenged` `a Singapore citizen trading alone` TRUE FALSE TRUE EQUALS `the Tribunal`
#ASSERT `where the breach may be challenged` `a Singapore citizen trading alone` FALSE TRUE FALSE EQUALS `no forum under this Act`
#ASSERT `where the breach may be challenged` `a national of an unlisted country` TRUE TRUE FALSE EQUALS `no forum under this Act`

§ `ss 12 to 14`

#ASSERT `the challenge is within the 15 days` 15
#ASSERT NOT `the challenge is within the 15 days` 16

#ASSERT `the challenge is deemed withdrawn` FALSE

#ASSERT `the deposit released to the applicant` 5000 3000 EQUALS 2000
#ASSERT `the deposit released to the applicant` 5000 8000 EQUALS 0

#ASSERT `the costs still recoverable from the applicant` 5000 8000 EQUALS 3000

#ASSERT NOT `the notice of hearing is enough` 13

§ `ss 15(2) and 26`

#ASSERT NOT `the procurement was initiated before 13 May 2002` FALSE FALSE FALSE
#ASSERT `the procurement was initiated before 13 May 2002` FALSE TRUE FALSE

#ASSERT NOT `the challenge must be declared invalid` `a timely challenge in proper form`
#ASSERT `the challenge must be declared invalid` `a challenge to an uncovered procurement`
#ASSERT `the challenge must be declared invalid` `a challenge under a regulation excluded by order`
#ASSERT `the challenge must be declared invalid` `a challenge to a tender invited in 2001`
#ASSERT `the challenge must be declared invalid` `a challenge by a supplier not owed the duty`
#ASSERT `the challenge must be declared invalid` `a challenge lodged on day 20 with unreasonable delay`
#ASSERT NOT `the challenge must be declared invalid` `a challenge lodged on day 20 with the delay excused`
#ASSERT `the challenge must be declared invalid` `a challenge not in the prescribed form`

§ `ss 16 and 17`

#ASSERT `the Tribunal may suspend the procurement` `a complete application before award`
#ASSERT NOT `the Tribunal may suspend the procurement` `an application before the deposit is paid`
#ASSERT NOT `the Tribunal may suspend the procurement` `an application heard after award`
#ASSERT NOT `the Tribunal may suspend the procurement` `an application met by a Minister's certificate`

#ASSERT `the Tribunal must rescind the suspension` FALSE TRUE

#ASSERT NOT `the applicant may rely on the breach` FALSE FALSE
#ASSERT `the applicant may rely on the breach` FALSE TRUE

