`a complete application before award` MEANS SuspensionApplication WITH
    `notice lodged` IS TRUE
    `fee and deposit paid` IS TRUE
    `notice served` IS TRUE
    `suspension against the public interest` IS FALSE
    `Minister certified against the public interest` IS FALSE
    `contract awarded by the hearing date` IS FALSE

`an application before the deposit is paid` MEANS SuspensionApplication WITH
    `notice lodged` IS TRUE
    `fee and deposit paid` IS FALSE
    `notice served` IS TRUE
    `suspension against the public interest` IS FALSE
    `Minister certified against the public interest` IS FALSE
    `contract awarded by the hearing date` IS FALSE

`an application heard after award` MEANS SuspensionApplication WITH
    `notice lodged` IS TRUE
    `fee and deposit paid` IS TRUE
    `notice served` IS TRUE
    `suspension against the public interest` IS FALSE
    `Minister certified against the public interest` IS FALSE
    `contract awarded by the hearing date` IS TRUE

