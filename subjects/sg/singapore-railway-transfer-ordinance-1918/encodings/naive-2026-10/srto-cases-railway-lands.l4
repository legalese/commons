§ `s 2`

#ASSERT `the thing vested under section 2` `land coloured pink on the 1913 plan` FALSE FALSE
#ASSERT NOT `the thing vested under section 2` `land not shown pink on the 1913 plan` TRUE TRUE
#ASSERT `the thing vested under section 2` `a station or workshop used for the railway` FALSE FALSE
#ASSERT `the thing vested under section 2` `a wharf used for the railway` FALSE FALSE
#ASSERT `the thing vested under section 2` `an engine or wagon` TRUE FALSE
#ASSERT NOT `the thing vested under section 2` `an engine or wagon` FALSE FALSE
#ASSERT `the thing vested under section 2` `a wagon-ferry-boat` TRUE FALSE
#ASSERT NOT `the thing vested under section 2` `a wagon-ferry-boat` FALSE TRUE
#ASSERT `the thing vested under section 2` `the cable across the Johore Straits` FALSE TRUE
#ASSERT NOT `the thing vested under section 2` `the cable across the Johore Straits` FALSE FALSE

