IMPORT prelude
IMPORT `mswra-wrecks`

-- Merchant Shipping (Wreck Removal) Act 2017, ss 2 to 5, 7, 8, 10, 13 to 17, 20, 23(5), 28 and Second Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_merchant-shipping-wreck-removal-act-2017.py). Expected results were written by
-- hand from the text.

`a Singapore bulk carrier fully papered` MEANS Ship WITH
    `is a Singapore ship` IS TRUE
    `gross tonnage` IS 40000
    `is a licensed or exempted harbour or pleasure craft` IS FALSE
    `is insured as the Port Master requires` IS FALSE
    `navigates only within port limits` IS FALSE
    `is covered by wreck removal insurance` IS TRUE
    `has the Director's certificate` IS TRUE
    `carries a copy of the Director's certificate` IS TRUE
    `carries written evidence of insurance` IS FALSE
    `is State Party owned and carries its State's certificate` IS FALSE

`a Singapore tanker without the certificate copy on board` MEANS Ship WITH
    `is a Singapore ship` IS TRUE
    `gross tonnage` IS 5000
    `is a licensed or exempted harbour or pleasure craft` IS FALSE
    `is insured as the Port Master requires` IS FALSE
    `navigates only within port limits` IS FALSE
    `is covered by wreck removal insurance` IS TRUE
    `has the Director's certificate` IS TRUE
    `carries a copy of the Director's certificate` IS FALSE
    `carries written evidence of insurance` IS FALSE
    `is State Party owned and carries its State's certificate` IS FALSE

`an uninsured foreign cargo ship` MEANS Ship WITH
    `is a Singapore ship` IS FALSE
    `gross tonnage` IS 2000
    `is a licensed or exempted harbour or pleasure craft` IS FALSE
    `is insured as the Port Master requires` IS FALSE
    `navigates only within port limits` IS FALSE
    `is covered by wreck removal insurance` IS FALSE
    `has the Director's certificate` IS FALSE
    `carries a copy of the Director's certificate` IS FALSE
    `carries written evidence of insurance` IS FALSE
    `is State Party owned and carries its State's certificate` IS FALSE

`an uninsured 250-tonne Singapore coaster` MEANS Ship WITH
    `is a Singapore ship` IS TRUE
    `gross tonnage` IS 250
    `is a licensed or exempted harbour or pleasure craft` IS FALSE
    `is insured as the Port Master requires` IS FALSE
    `navigates only within port limits` IS FALSE
    `is covered by wreck removal insurance` IS FALSE
    `has the Director's certificate` IS FALSE
    `carries a copy of the Director's certificate` IS FALSE
    `carries written evidence of insurance` IS FALSE
    `is State Party owned and carries its State's certificate` IS FALSE

`a licensed Singapore harbour tug that stays in port limits` MEANS Ship WITH
    `is a Singapore ship` IS TRUE
    `gross tonnage` IS 400
    `is a licensed or exempted harbour or pleasure craft` IS TRUE
    `is insured as the Port Master requires` IS TRUE
    `navigates only within port limits` IS TRUE
    `is covered by wreck removal insurance` IS FALSE
    `has the Director's certificate` IS FALSE
    `carries a copy of the Director's certificate` IS FALSE
    `carries written evidence of insurance` IS FALSE
    `is State Party owned and carries its State's certificate` IS FALSE

`a licensed Singapore harbour craft that goes beyond port limits` MEANS Ship WITH
    `is a Singapore ship` IS TRUE
    `gross tonnage` IS 400
    `is a licensed or exempted harbour or pleasure craft` IS TRUE
    `is insured as the Port Master requires` IS TRUE
    `navigates only within port limits` IS FALSE
    `is covered by wreck removal insurance` IS FALSE
    `has the Director's certificate` IS FALSE
    `carries a copy of the Director's certificate` IS FALSE
    `carries written evidence of insurance` IS FALSE
    `is State Party owned and carries its State's certificate` IS FALSE

`a foreign State-owned cargo ship with its State's certificate` MEANS Ship WITH
    `is a Singapore ship` IS FALSE
    `gross tonnage` IS 10000
    `is a licensed or exempted harbour or pleasure craft` IS FALSE
    `is insured as the Port Master requires` IS FALSE
    `navigates only within port limits` IS FALSE
    `is covered by wreck removal insurance` IS FALSE
    `has the Director's certificate` IS FALSE
    `carries a copy of the Director's certificate` IS FALSE
    `carries written evidence of insurance` IS FALSE
    `is State Party owned and carries its State's certificate` IS TRUE

§ `ss 2, 3 and 20(1)`

#ASSERT `the object is a wreck` `a sunken ship` TRUE FALSE
#ASSERT `the object is a wreck` `a container lost overboard and adrift` TRUE FALSE
#ASSERT `the object is a wreck` `a ship expected to sink` TRUE FALSE
#ASSERT NOT `the object is a wreck` `a ship expected to sink` TRUE TRUE
#ASSERT NOT `the object is a wreck` `a damaged ship still afloat and not expected to sink` TRUE FALSE

#ASSERT `the Act applies to the wreck` 20170908 FALSE
#ASSERT NOT `the Act applies to the wreck` 20170907 FALSE
#ASSERT NOT `the Act applies to the wreck` 20250101 TRUE

§ `s 4`

#ASSERT `the wreck must be reported to` TRUE `in Singapore's Convention area` EQUALS `the Director`
#ASSERT `the wreck must be reported to` TRUE `in another State Party's Convention area` EQUALS `the government of the affected State`
#ASSERT `the wreck must be reported to` TRUE `in Singapore's territorial sea or port` EQUALS `no one under section 4`
#ASSERT `the wreck must be reported to` FALSE `in Singapore's Convention area` EQUALS `no one under section 4`

#ASSERT `the person commits an offence under section 4` `the master` TRUE FALSE FALSE TRUE
#ASSERT NOT `the person commits an offence under section 4` `the operator` TRUE TRUE FALSE TRUE
#ASSERT `the person commits an offence under section 4` `the master` TRUE TRUE FALSE FALSE
#ASSERT NOT `the person commits an offence under section 4` `the operator` TRUE TRUE FALSE FALSE
#ASSERT NOT `the person commits an offence under section 4` `the master` FALSE FALSE FALSE TRUE

§ `ss 5, 7, 8`

#ASSERT `the Director may remove the wreck` TRUE TRUE TRUE FALSE FALSE
#ASSERT `the Director may remove the wreck` TRUE TRUE FALSE FALSE TRUE
#ASSERT NOT `the Director may remove the wreck` TRUE FALSE TRUE FALSE FALSE
#ASSERT NOT `the Director may remove the wreck` FALSE TRUE TRUE FALSE FALSE
#ASSERT NOT `the Director may remove the wreck` TRUE TRUE FALSE FALSE FALSE

§ `s 10`

#ASSERT `the registered owner is liable for the Director's costs` TRUE TRUE FALSE `a navigational error by the crew` FALSE
#ASSERT NOT `the registered owner is liable for the Director's costs` TRUE TRUE FALSE `an act of war` TRUE
#ASSERT `the registered owner is liable for the Director's costs` TRUE TRUE FALSE `an act of war` FALSE
#ASSERT `the registered owner is liable for the Director's costs` TRUE TRUE FALSE `a third party's sabotage, partly` TRUE
#ASSERT NOT `the registered owner is liable for the Director's costs` TRUE TRUE FALSE `a third party's sabotage, wholly` TRUE
#ASSERT NOT `the registered owner is liable for the Director's costs` TRUE TRUE TRUE `a navigational error by the crew` FALSE

§ `s 13`

#ASSERT `the last day to sue for the costs` 20200115 TRUE 20200601 EQUALS 20230601
#ASSERT `the last day to sue for the costs` 20200115 TRUE 20240301 EQUALS 20260115
#ASSERT `the last day to sue for the costs` 20200115 FALSE 0 EQUALS 20260115

#ASSERT `the action is in time` 20200115 TRUE 20200601 20230601
#ASSERT NOT `the action is in time` 20200115 TRUE 20200601 20230602

§ `ss 14, 15, 20(2) and Second Schedule`

#ASSERT NOT `Division 2 applies to the ship` `an uninsured 250-tonne Singapore coaster`
#ASSERT NOT `Division 2 applies to the ship` `a licensed Singapore harbour tug that stays in port limits`
#ASSERT `Division 2 applies to the ship` `a licensed Singapore harbour craft that goes beyond port limits`

#ASSERT NOT `section 15 bars the ship from entering or leaving the port` `a Singapore bulk carrier fully papered` TRUE
#ASSERT `section 15 bars the ship from entering or leaving the port` `a Singapore tanker without the certificate copy on board` FALSE
#ASSERT `section 15 bars the ship from entering or leaving the port` `an uninsured foreign cargo ship` TRUE
#ASSERT NOT `section 15 bars the ship from entering or leaving the port` `an uninsured foreign cargo ship` FALSE
#ASSERT `section 15 bars the ship from entering or leaving the port` `a licensed Singapore harbour craft that goes beyond port limits` TRUE
#ASSERT NOT `section 15 bars the ship from entering or leaving the port` `a foreign State-owned cargo ship with its State's certificate` TRUE

§ `s 16`

#ASSERT `the certificate application outcome` TRUE FALSE TRUE FALSE EQUALS `the Director must issue`
#ASSERT `the certificate application outcome` TRUE FALSE TRUE TRUE EQUALS `the Director may refuse`
#ASSERT `the certificate application outcome` FALSE FALSE TRUE FALSE EQUALS `the Director may issue or refuse`
#ASSERT `the certificate application outcome` FALSE TRUE TRUE FALSE EQUALS `no application lies under section 16`

§ `s 17`

#ASSERT `the Director may recover from the insurer` TRUE TRUE FALSE
#ASSERT NOT `the Director may recover from the insurer` TRUE TRUE TRUE

§ `ss 4(7), 15(4), (5), 23(5), 28`

#ASSERT `the maximum fine for` `failing to report a wreck` EQUALS 10000
#ASSERT `the maximum fine for` `entering or leaving a port without cover` EQUALS 20000
#ASSERT `the maximum fine for` `obstructing an authorised officer` EQUALS 20000

#ASSERT `the maximum imprisonment in months for` `obstructing an authorised officer` EQUALS 12

#ASSERT `the most that may be collected to compound` 10000 EQUALS 1000

