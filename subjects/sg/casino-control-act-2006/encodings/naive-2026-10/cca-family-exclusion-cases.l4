§ `REQ-0271 -- a sister, a brother who gambles on paydays`

-- Who may apply: a sibling is a family member with no further condition; Simone, adult and adversely affected, files herself.
#ASSERT `is a family member under s 2` `sibling`
#ASSERT `a family exclusion order application may be made` `Simone, Jun Hao's sister` `the affected family member personally` FALSE
-- Who decides: she files with the National Council on Problem Gambling, which must refer it to a three-member Committee of Assessors.
#ASSERT `who acts at` `receiving the application` EQUALS `the National Council on Problem Gambling`
#ASSERT `who acts at` `deciding the application` EQUALS `a Committee of Assessors`
#ASSERT `the Committee is constituted as s 157 requires` TRUE 2
-- On what grounds: six months of payday gambling ignoring the family's needs, likely to continue -- the order may be made.
#ASSERT `the Committee may make a family exclusion order` `Jun Hao gambling on paydays`

§ `s 2 -- family member`

#ASSERT `is a family member under s 2` `half-sibling`
#ASSERT NOT `is a family member under s 2` `cousin`
#ASSERT NOT `is a family member under s 2` `sibling-in-law`
#ASSERT NOT `is a family member under s 2` `grandparent`

§ `ss 157, 158 -- the decision-makers`

#ASSERT NOT `the Committee is constituted as s 157 requires` FALSE 2
#ASSERT `who acts at` `varying or revoking the order` EQUALS `the National Council on Problem Gambling`
#ASSERT NOT `a lawyer may appear before the Committee` FALSE

§ `ss 159 to 161, 163A -- applicants`

#ASSERT NOT `a family exclusion order application may be made` `a sister not yet affected but likely to be` `the affected family member personally` FALSE
#ASSERT `may benefit from an application for a family visit limit` `a sister not yet affected but likely to be`
#ASSERT NOT `a family exclusion order application may be made` `an affected cousin` `the affected family member personally` FALSE
#ASSERT `a family exclusion order application may be made` `an affected 17-year-old half-sister` `the affected family member personally` TRUE
#ASSERT NOT `a family exclusion order application may be made` `an affected 15-year-old son` `the affected family member personally` TRUE
#ASSERT `a family exclusion order application may be made` `an affected 15-year-old son` `a parent or guardian of the affected family member` FALSE
#ASSERT `a family exclusion order application may be made` `an affected wife in hospital and unable to apply` `a person appointed by the Minister` FALSE

§ `s 162 -- grounds`

#ASSERT NOT `the Committee may make a family exclusion order` `two paydays only`
#ASSERT `the Committee may make a family exclusion order` `two paydays only, but he consents`
#ASSERT `the Committee may make a family exclusion order` `one payday's whole salary and the rent lost in a night`
#ASSERT NOT `the Committee may make a family exclusion order` `paydays, but he has since stopped for good`
#ASSERT NOT `the Committee may make a family exclusion order` `paydays, never given notice`
#ASSERT `the Committee may make a family exclusion order` `paydays, ignored the notice to object`

§ `ss 163, 164 -- terms and provisional orders`

#ASSERT `the Committee may make a provisional order` `Jun Hao gambling on paydays` TRUE TRUE
#ASSERT NOT `the Committee may make a provisional order` `Jun Hao gambling on paydays` FALSE TRUE
#ASSERT `the provisional order is in effect` TRUE 27 0 FALSE FALSE FALSE
#ASSERT NOT `the provisional order is in effect` TRUE 28 0 FALSE FALSE FALSE
#ASSERT `the provisional order is in effect` TRUE 30 42 FALSE FALSE FALSE
#ASSERT `a provisional order may impose` `ban entering or remaining on all casino premises`
#ASSERT NOT `a provisional order may impose` `cap monthly casino visits`

§ `ss 165C, 166 -- challenge and revocation`

#ASSERT NOT `an appeal lies under the Act against the order` TRUE
#ASSERT NOT `the Council may entertain an application to vary or revoke` FALSE TRUE FALSE
#ASSERT `the Council may entertain an application to vary or revoke` FALSE TRUE TRUE

§ `ss 125 to 128, 167, 195 -- effect`

#ASSERT `the respondent is a casino-excluded person` TRUE TRUE FALSE
#ASSERT NOT `the respondent is a casino-excluded person` TRUE FALSE FALSE
#ASSERT `the respondent commits the s 125 offence` TRUE TRUE TRUE
#ASSERT `the maximum fine for the s 125 offence` EQUALS 10000
#ASSERT NOT `the operator is liable to disciplinary action under s 126` TRUE TRUE TRUE
