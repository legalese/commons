IMPORT prelude
IMPORT `edma-demutualisation`

-- Exchanges (Demutualisation and Merger) Act 1999, ss 3(1), 4 to 6 and 8 to 12 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_exchanges-demutualisation-and-merger-act-1999.py). Expected results were written by
-- hand from the text.

`a broker with one SES share` MEANS Member WITH
    `SES shares held on the transfer date` IS 1
    `SIMEX shares held on the transfer date` IS 0
    `SIMEX seats registered on the transfer date` IS 0
    `in involuntary liquidation as at 4 November 1998` IS FALSE

`a broker with two SES shares` MEANS Member WITH
    `SES shares held on the transfer date` IS 2
    `SIMEX shares held on the transfer date` IS 0
    `SIMEX seats registered on the transfer date` IS 0
    `in involuntary liquidation as at 4 November 1998` IS FALSE

`a SIMEX member with one share and one seat` MEANS Member WITH
    `SES shares held on the transfer date` IS 0
    `SIMEX shares held on the transfer date` IS 1
    `SIMEX seats registered on the transfer date` IS 1
    `in involuntary liquidation as at 4 November 1998` IS FALSE

`a seat-holder with three seats` MEANS Member WITH
    `SES shares held on the transfer date` IS 0
    `SIMEX shares held on the transfer date` IS 0
    `SIMEX seats registered on the transfer date` IS 3
    `in involuntary liquidation as at 4 November 1998` IS FALSE

`a liquidated SES shareholder` MEANS Member WITH
    `SES shares held on the transfer date` IS 1
    `SIMEX shares held on the transfer date` IS 0
    `SIMEX seats registered on the transfer date` IS 0
    `in involuntary liquidation as at 4 November 1998` IS TRUE

`a liquidated SIMEX shareholder with a seat` MEANS Member WITH
    `SES shares held on the transfer date` IS 0
    `SIMEX shares held on the transfer date` IS 1
    `SIMEX seats registered on the transfer date` IS 1
    `in involuntary liquidation as at 4 November 1998` IS TRUE

`a member of both exchanges` MEANS Member WITH
    `SES shares held on the transfer date` IS 1
    `SIMEX shares held on the transfer date` IS 1
    `SIMEX seats registered on the transfer date` IS 2
    `in involuntary liquidation as at 4 November 1998` IS FALSE

`no results yet` MEANS `Actual Results` WITH
    `paid a dividend in year 1` IS FALSE
    `paid a dividend in year 2` IS FALSE
    `paid a dividend in year 3` IS FALSE
    `reported a profit in year 1` IS FALSE
    `reported a profit in year 2` IS FALSE
    `reported a profit in year 3` IS FALSE

`a steady payer` MEANS `Actual Results` WITH
    `paid a dividend in year 1` IS TRUE
    `paid a dividend in year 2` IS TRUE
    `paid a dividend in year 3` IS TRUE
    `reported a profit in year 1` IS TRUE
    `reported a profit in year 2` IS TRUE
    `reported a profit in year 3` IS TRUE

`dividends paid but a loss in year 1` MEANS `Actual Results` WITH
    `paid a dividend in year 1` IS TRUE
    `paid a dividend in year 2` IS TRUE
    `paid a dividend in year 3` IS TRUE
    `reported a profit in year 1` IS FALSE
    `reported a profit in year 2` IS TRUE
    `reported a profit in year 3` IS TRUE

`profitable but no dividend in year 2` MEANS `Actual Results` WITH
    `paid a dividend in year 1` IS TRUE
    `paid a dividend in year 2` IS FALSE
    `paid a dividend in year 3` IS TRUE
    `reported a profit in year 1` IS TRUE
    `reported a profit in year 2` IS TRUE
    `reported a profit in year 3` IS TRUE

§ `s 6`

#ASSERT `the value of holding company shares due` `a broker with one SES share` EQUALS 6000000
#ASSERT `the value of holding company shares due` `a broker with two SES shares` EQUALS 12000000
#ASSERT `the value of holding company shares due` `a SIMEX member with one share and one seat` EQUALS 285000
#ASSERT `the value of holding company shares due` `a seat-holder with three seats` EQUALS 510000
#ASSERT `the value of holding company shares due` `a liquidated SES shareholder` EQUALS 0
#ASSERT `the value of holding company shares due` `a liquidated SIMEX shareholder with a seat` EQUALS 170000
#ASSERT `the value of holding company shares due` `a member of both exchanges` EQUALS 6455000

#ASSERT `the allotment fits section 6` 6000000 1 6000000
#ASSERT `the allotment fits section 6` 285000 7 40714
#ASSERT NOT `the allotment fits section 6` 285000 7 40715

§ `ss 3(1), 4, 5`

#ASSERT `the shares cancelled and re-created` SES EQUALS 34
#ASSERT `the shares cancelled and re-created` SIMEX EQUALS 40
#ASSERT `the shares cancelled and re-created` SCCS EQUALS 34

#ASSERT `the capital in dollars after re-creation` SES EQUALS 34
#ASSERT `the capital in dollars after re-creation` SIMEX EQUALS 40

#ASSERT NOT `an old certificate is still a document of title` TRUE

#ASSERT `the notice to the Registrar is in time` 30
#ASSERT NOT `the notice to the Registrar is in time` 31

§ `ss 4(5), 8(3), 8(4), 9`

#ASSERT `the Act disapplies the requirement` `special resolution for reducing capital` `the s 4 capital reduction`
#ASSERT NOT `the Act disapplies the requirement` `special resolution for reducing capital` `the s 6 allotment to members`
#ASSERT `the Act disapplies the requirement` `SFA prospectus requirements` `the single offer to the special purpose company`
#ASSERT `the Act disapplies the requirement` `SFA prospectus requirements` `a sale by the special purpose company on the Minister's direction`
#ASSERT NOT `the Act disapplies the requirement` `SFA prospectus requirements` `the s 6 allotment to members`
#ASSERT `the Act disapplies the requirement` `statement in lieu of prospectus` `the s 6 allotment to members`
#ASSERT NOT `the Act disapplies the requirement` `statement in lieu of prospectus` `a later share issue by the holding company outside the Act`
#ASSERT `the Act disapplies the requirement` `ban on financing dealings in own shares` `a sale by the special purpose company on the Minister's direction`

§ `ss 8(1A), 8(2), 11(2)`

#ASSERT NOT `the special purpose company may take the action` `vote the shares` TRUE
#ASSERT NOT `the special purpose company may take the action` `vote the shares` FALSE
#ASSERT `the special purpose company may take the action` `sell on the Minister's s 8(2) direction` FALSE
#ASSERT NOT `the special purpose company may take the action` `sell on its own initiative` FALSE
#ASSERT `the special purpose company may take the action` `sell on its own initiative` TRUE
#ASSERT NOT `the special purpose company may take the action` `charge the shares as security` FALSE
#ASSERT `the special purpose company may take the action` `subscribe to a rights issue` TRUE
#ASSERT NOT `the special purpose company may take the action` `subscribe to a rights issue` FALSE
#ASSERT NOT `the special purpose company may take the action` `keep a dividend for itself` TRUE

§ `s 11(1)`

#ASSERT NOT `the shares count towards a take-over threshold` `the single offer under s 8(1)`
#ASSERT NOT `the shares count towards a take-over threshold` `a Minister-approved corporate action under s 8(1A)`
#ASSERT `the shares count towards a take-over threshold` `a purchase in the market`

§ `s 10`

#ASSERT `the amount payable into the Fund` 100000000 20000000 EQUALS 80000000
#ASSERT `the amount payable into the Fund` 5000000 8000000 EQUALS 0

§ `s 12`

#ASSERT `the deemed and actual record meets paragraphs 1(1)(b) to (d)` `no results yet` 0
#ASSERT `the deemed and actual record meets paragraphs 1(1)(b) to (d)` `no results yet` 1
#ASSERT NOT `the deemed and actual record meets paragraphs 1(1)(b) to (d)` `no results yet` 2
#ASSERT `the deemed and actual record meets paragraphs 1(1)(b) to (d)` `a steady payer` 2
#ASSERT `the deemed and actual record meets paragraphs 1(1)(b) to (d)` `a steady payer` 4
#ASSERT NOT `the deemed and actual record meets paragraphs 1(1)(b) to (d)` `dividends paid but a loss in year 1` 2
#ASSERT `the deemed and actual record meets paragraphs 1(1)(b) to (d)` `dividends paid but a loss in year 1` 3
