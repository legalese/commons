IMPORT prelude

-- UCTA LAYER 1, MODULE 2: three-valued reading rules.
-- Not a provision of the Act.  The Act's answers are JUST TRUE, JUST FALSE or NOTHING (a MAYBE BOOLEAN);
-- these functions combine such answers without ever turning NOTHING into FALSE.
--   * JUST TRUE / JUST FALSE : the text (or an input) says yes / no;
--   * NOTHING                : not covered (silent, list not closed, includes, undefined term,
--                              points outside the text, or limited by its own wording).
-- Kleene's rule: AND is JUST FALSE if either side is JUST FALSE, JUST TRUE if both are JUST TRUE,
-- else NOTHING; OR is the dual.

§ `Three-valued reading rules`

GIVEN a IS A MAYBE BOOLEAN
      b IS A MAYBE BOOLEAN
GIVETH A MAYBE BOOLEAN
a `and also` b MEANS
    CONSIDER a
    WHEN JUST x THEN
        CONSIDER b
        WHEN JUST y THEN JUST (x AND y)
        WHEN NOTHING THEN IF x THEN NOTHING ELSE JUST FALSE
    WHEN NOTHING THEN
        CONSIDER b
        WHEN JUST y THEN IF y THEN NOTHING ELSE JUST FALSE
        WHEN NOTHING THEN NOTHING

GIVEN a IS A MAYBE BOOLEAN
      b IS A MAYBE BOOLEAN
GIVETH A MAYBE BOOLEAN
a `or else` b MEANS
    CONSIDER a
    WHEN JUST x THEN
        CONSIDER b
        WHEN JUST y THEN JUST (x OR y)
        WHEN NOTHING THEN IF x THEN JUST TRUE ELSE NOTHING
    WHEN NOTHING THEN
        CONSIDER b
        WHEN JUST y THEN IF y THEN JUST TRUE ELSE NOTHING
        WHEN NOTHING THEN NOTHING

GIVEN a IS A MAYBE BOOLEAN
GIVETH A MAYBE BOOLEAN
`not so` a MEANS
    CONSIDER a
    WHEN JUST x THEN JUST (NOT x)
    WHEN NOTHING THEN NOTHING

-- A BOOLEAN fact as a MAYBE BOOLEAN answer.
GIVEN x IS A BOOLEAN
GIVETH A MAYBE BOOLEAN
`known to be` x MEANS JUST x

-- "Is it JUST TRUE?" -- for a branch that acts only on a yes.
GIVEN a IS A MAYBE BOOLEAN
GIVETH A BOOLEAN
`is a yes` a MEANS
    CONSIDER a
    WHEN JUST x THEN x
    WHEN NOTHING THEN FALSE

-- "Is it JUST FALSE?" -- for a branch that acts only on a no.
GIVEN a IS A MAYBE BOOLEAN
GIVETH A BOOLEAN
`is a no` a MEANS
    CONSIDER a
    WHEN JUST x THEN NOT x
    WHEN NOTHING THEN FALSE

-- "Is it NOTHING?" -- for a branch that acts only on a missing answer.
GIVEN a IS A MAYBE BOOLEAN
GIVETH A BOOLEAN
`is unknown` a MEANS
    CONSIDER a
    WHEN JUST x THEN FALSE
    WHEN NOTHING THEN TRUE

#ASSERT ((JUST TRUE) `and also` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT ((JUST TRUE) `and also` (JUST FALSE)) EQUALS JUST FALSE
#ASSERT ((JUST FALSE) `and also` NOTHING) EQUALS JUST FALSE
#ASSERT (NOTHING `and also` (JUST FALSE)) EQUALS JUST FALSE
#ASSERT ((JUST TRUE) `and also` NOTHING) EQUALS NOTHING
#ASSERT (NOTHING `and also` (JUST TRUE)) EQUALS NOTHING
#ASSERT (NOTHING `and also` NOTHING) EQUALS NOTHING
#ASSERT ((JUST FALSE) `or else` (JUST FALSE)) EQUALS JUST FALSE
#ASSERT ((JUST TRUE) `or else` NOTHING) EQUALS JUST TRUE
#ASSERT (NOTHING `or else` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT ((JUST FALSE) `or else` NOTHING) EQUALS NOTHING
#ASSERT (NOTHING `or else` NOTHING) EQUALS NOTHING
#ASSERT `not so` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `not so` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `not so` NOTHING EQUALS NOTHING
#ASSERT `is a yes` (JUST TRUE)
#ASSERT NOT (`is a yes` NOTHING)
#ASSERT `is a no` (JUST FALSE)
#ASSERT NOT (`is a no` NOTHING)
#ASSERT `is unknown` NOTHING
#ASSERT NOT (`is unknown` (JUST TRUE))
#ASSERT NOT (`is unknown` (JUST FALSE))
