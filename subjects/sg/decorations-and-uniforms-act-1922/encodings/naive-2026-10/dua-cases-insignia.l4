#ASSERT NOT `wearing or using the item is an offence` `a club or school badge` FALSE FALSE
#ASSERT NOT `wearing or using the item is an offence` `a military uniform` FALSE TRUE
#ASSERT NOT `wearing or using the item is an offence` `a Presidential decoration` FALSE TRUE
#ASSERT `wearing or using the item is an offence` `a military medal` FALSE TRUE
