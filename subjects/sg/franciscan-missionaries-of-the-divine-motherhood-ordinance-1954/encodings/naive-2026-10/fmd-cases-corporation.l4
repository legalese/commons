IMPORT prelude
IMPORT `fmd-corporation`

-- Franciscan Missionaries of the Divine Motherhood Ordinance 1954, ss 2-5 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_franciscan-missionaries-of-the-divine-motherhood-ordinance-1954.py). Expected results were written by
-- hand from the text.

`a Superior in Malaya appointed and gazetted` MEANS Claimant WITH
    `is Reverend Mother Superior of the congregation for` IS `Malaya`
    `is duly authorised and appointed` IS TRUE
    `appointment is notified in the Gazette` IS TRUE

`a Superior in Malaya appointed but not yet gazetted` MEANS Claimant WITH
    `is Reverend Mother Superior of the congregation for` IS `Malaya`
    `is duly authorised and appointed` IS TRUE
    `appointment is notified in the Gazette` IS FALSE

`a Superior in Malaya gazetted where other proof of appointment is lacking` MEANS Claimant WITH
    `is Reverend Mother Superior of the congregation for` IS `Malaya`
    `is duly authorised and appointed` IS FALSE
    `appointment is notified in the Gazette` IS TRUE

`a Superior in Malaya neither shown appointed nor gazetted` MEANS Claimant WITH
    `is Reverend Mother Superior of the congregation for` IS `Malaya`
    `is duly authorised and appointed` IS FALSE
    `appointment is notified in the Gazette` IS FALSE

`a Superior of the congregation for another region` MEANS Claimant WITH
    `is Reverend Mother Superior of the congregation for` IS `another region`
    `is duly authorised and appointed` IS TRUE
    `appointment is notified in the Gazette` IS FALSE

`a gazetted sister who is not a Superior` MEANS Claimant WITH
    `is Reverend Mother Superior of the congregation for` IS `no region -- not a Superior`
    `is duly authorised and appointed` IS FALSE
    `appointment is notified in the Gazette` IS TRUE

`a lease sealed before and signed by the Superior` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Reverend Mother Superior for the time being`
    `signed by` IS `the Reverend Mother Superior for the time being`

`a transfer sealed before and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney under a deposited power of attorney`
    `signed by` IS `an attorney under a deposited power of attorney`

`a mortgage sealed before the Superior and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Reverend Mother Superior for the time being`
    `signed by` IS `an attorney under a deposited power of attorney`

`a conveyance sealed before and signed by an undeposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney whose power of attorney is not deposited`
    `signed by` IS `an attorney whose power of attorney is not deposited`

`a deed sealed before a sister and signed by the Superior` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a sister with no power of attorney`
    `signed by` IS `the Reverend Mother Superior for the time being`

`a deed sealed before and signed by a former Superior` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a former Reverend Mother Superior`
    `signed by` IS `a former Reverend Mother Superior`

`a document signed by the Superior but never sealed` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS FALSE
    `sealed in the presence of` IS `the Reverend Mother Superior for the time being`
    `signed by` IS `the Reverend Mother Superior for the time being`

`a deed sealed before the Superior but signed by nobody` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Reverend Mother Superior for the time being`
    `signed by` IS `nobody`

§ `ss 2(1) and 4`

#ASSERT `holds the office that is the Corporation` `a Superior in Malaya appointed and gazetted`
#ASSERT `holds the office that is the Corporation` `a Superior in Malaya appointed but not yet gazetted`
#ASSERT `holds the office that is the Corporation` `a Superior in Malaya gazetted where other proof of appointment is lacking`
#ASSERT NOT `holds the office that is the Corporation` `a Superior in Malaya neither shown appointed nor gazetted`
#ASSERT NOT `holds the office that is the Corporation` `a Superior of the congregation for another region`
#ASSERT NOT `holds the office that is the Corporation` `a gazetted sister who is not a Superior`

#ASSERT `authorisation is conclusively proved` `a Superior in Malaya appointed and gazetted`
#ASSERT NOT `authorisation is conclusively proved` `a Superior in Malaya appointed but not yet gazetted`
#ASSERT `authorisation is conclusively proved` `a Superior in Malaya gazetted where other proof of appointment is lacking`
#ASSERT NOT `authorisation is conclusively proved` `a Superior in Malaya neither shown appointed nor gazetted`
#ASSERT NOT `authorisation is conclusively proved` `a Superior of the congregation for another region`
#ASSERT `authorisation is conclusively proved` `a gazetted sister who is not a Superior`

#ASSERT `is Malaya` `Malaya`
#ASSERT NOT `is Malaya` `another region`
#ASSERT NOT `is Malaya` `no region -- not a Superior`

§ `s 2(2), (3)`

#ASSERT `the Ordinance empowers the Corporation to` `use and change its corporate seal` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `acquire or purchase property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `hold and enjoy property` TRUE
#ASSERT `the Ordinance empowers the Corporation to` `sell property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `mortgage property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `mortgage property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `lease property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `lease property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `transfer or otherwise dispose of property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `transfer or otherwise dispose of property` FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sue in respect of its property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `borrow money without security` TRUE

