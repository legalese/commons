IMPORT prelude
IMPORT `slfa-foundation`

-- Singapore Labour Foundation Act 1977, ss 4(c), 6, 7, 10, 13, 14, 16, 16B, 17, 19 and 23 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_singapore-labour-foundation-act-1977.py). Expected results were written by
-- hand from the text.

§ `s 4(c)`

#ASSERT `the applicant is within the bursary object` `a child of a member of an NTUC-affiliated trade union`
#ASSERT `the applicant is within the bursary object` `a child of a member of an NTUC-affiliated platform work association`
#ASSERT `the applicant is within the bursary object` `a child of a member of an NTUC associate affiliate`
#ASSERT `the applicant is within the bursary object` `a foreign worker training in Singapore in a field relevant to trade unions`
#ASSERT NOT `the applicant is within the bursary object` `a Singapore worker studying abroad in a field relevant to trade unions, not nominated`
#ASSERT `the applicant is within the bursary object` `a person nominated by NTUC to study at a university abroad`
#ASSERT NOT `the applicant is within the bursary object` `a child of a worker in no union`

§ `s 6(4), (5)`

#ASSERT `what the resigning member still owes` 120 50 EQUALS 120

#ASSERT NOT `the Board may terminate the membership` FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `the Board may terminate the membership` FALSE FALSE FALSE FALSE FALSE TRUE

§ `s 7`

#ASSERT `the Minister may remove the director without reason` `a director appointed on NTUC advice`
#ASSERT `the Minister may remove the director without reason` `a director appointed by the Minister`
#ASSERT NOT `the Minister may remove the director without reason` `an elected director`

#ASSERT `a general meeting may remove the director` `an elected director`
#ASSERT NOT `a general meeting may remove the director` `a director appointed by the Minister`

