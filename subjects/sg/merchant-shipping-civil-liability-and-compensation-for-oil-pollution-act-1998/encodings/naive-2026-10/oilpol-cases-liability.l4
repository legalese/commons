#ASSERT NOT `the defendant may limit liability` `the owner` TRUE
#ASSERT `the defendant may limit liability` `the insurer` TRUE

§ `s 12`

#ASSERT `the action against the owner is in time` 3 6
#ASSERT NOT `the action against the owner is in time` 2 6.5
#ASSERT NOT `the action against the owner is in time` 3.5 4

§ `s 13(1), (2)`

#ASSERT `a certificate is required for the movement` `a Singapore product tanker` `entering or leaving a foreign port`
#ASSERT NOT `a certificate is required for the movement` `a laden tanker` `entering or leaving a foreign port`
#ASSERT `a certificate is required for the movement` `a laden tanker` `entering or leaving a Singapore port`
#ASSERT NOT `a certificate is required for the movement` `a laden tanker` `passing through Singapore waters without calling`
#ASSERT NOT `a certificate is required for the movement` `a Singapore coastal tanker` `entering or leaving a Singapore port`

