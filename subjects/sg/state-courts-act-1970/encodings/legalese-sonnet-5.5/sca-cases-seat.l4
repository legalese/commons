#ASSERT `May a District Court take over my Magistrate's Court case` TRUE TRUE EQUALS JUST TRUE
#ASSERT `May a District Court take over my Magistrate's Court case` TRUE FALSE EQUALS JUST FALSE
#ASSERT `May the High Court take over my State Court case` TRUE TRUE EQUALS JUST TRUE
#ASSERT `May the High Court take over my State Court case` FALSE TRUE EQUALS JUST FALSE
#ASSERT `May I apply to move my High Court case to a State Court` TRUE TRUE EQUALS JUST TRUE
#ASSERT `May I apply to move my High Court case to a State Court` TRUE FALSE EQUALS NOTHING
#ASSERT `May I apply to move my District Court case to a Magistrate's Court` TRUE TRUE EQUALS JUST TRUE
#ASSERT `May I apply to move my District Court case to a Magistrate's Court` FALSE TRUE EQUALS NOTHING
#ASSERT `May I apply to move a counterclaim beyond the District Court limit` TRUE 250_001 TRUE EQUALS JUST TRUE
#ASSERT `May I apply to move a counterclaim beyond the District Court limit` TRUE 250_000 TRUE EQUALS JUST FALSE
#ASSERT `May I apply to move a counterclaim beyond the District Court limit` TRUE 300_000 FALSE EQUALS NOTHING
#ASSERT `May I apply to move a counterclaim beyond the Magistrate's Court limit` TRUE 60_001 TRUE EQUALS JUST TRUE
#ASSERT `May I apply to move a counterclaim beyond the Magistrate's Court limit` TRUE 60_000 TRUE EQUALS JUST FALSE
#ASSERT `Are the costs in the discretion of the court I am moved to` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Are the costs in the discretion of the court I am moved to` TRUE TRUE EQUALS NOTHING
#ASSERT `Are the costs in the discretion of the court I am moved to` FALSE FALSE EQUALS JUST FALSE

