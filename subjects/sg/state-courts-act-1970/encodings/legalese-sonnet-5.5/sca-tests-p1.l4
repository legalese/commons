IMPORT prelude
IMPORT `sca-nouns`
IMPORT `sca-p1-preliminary`

-- Tests for Part 1 (s 2).  Every expected value is written from the text beside the assertion, never from the code's output.

-- s 2 table: ten defined words, in the Act's order; the kinds read off the text ("means", "includes", "means and includes", "has the meaning given by").
#ASSERT count `s 2 the ten definitions` EQUALS 10
#ASSERT `s 2 definition: action`'s kind EQUALS Means
#ASSERT `s 2 definition: Coroner`'s kind EQUALS `Has the meaning given by another law`
#ASSERT `s 2 definition: District Court limit`'s `the Act's words` EQUALS "“District Court limit” means $250,000 or any other amount specified by an order under section 30;"
#ASSERT `s 2 definition: registrar`'s kind EQUALS `Means and includes`
#ASSERT `s 2 definition: seal`'s kind EQUALS Includes
#ASSERT `s 2 definition: Magistrate's Court limit`'s `what the Act points at` EQUALS LIST "section 52(3)"
#ASSERT `s 2 definition: judicial officer`'s `what the Act names` EQUALS LIST "a District Judge", "a Magistrate", "a registrar"

-- s 2 chapeau: "unless the context otherwise requires".
#ASSERT `s 2 the definitions in this section apply to this provision` FALSE EQUALS JUST TRUE
#ASSERT `s 2 the definitions in this section apply to this provision` TRUE EQUALS JUST FALSE

-- "action" means a civil proceeding commenced by summons or in another prescribed manner.
#ASSERT `s 2 "action" the proceeding is an action` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2 "action" the proceeding is an action` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2 "action" the proceeding is an action` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2 "action" the proceeding is an action` FALSE TRUE FALSE EQUALS JUST FALSE

#ASSERT `s 2 "commissioner for oaths" the person is a commissioner for oaths` TRUE EQUALS JUST TRUE
#ASSERT `s 2 "commissioner for oaths" the person is a commissioner for oaths` FALSE EQUALS JUST FALSE
#ASSERT `s 2 "Coroner" the person is a Coroner` TRUE EQUALS JUST TRUE
#ASSERT `s 2 "Coroner" the person is a Coroner` FALSE EQUALS JUST FALSE

-- The limits: $250,000 and $60,000 unless an order specifies another amount.
#ASSERT `s 2 "District Court limit" the amount in dollars` NOTHING EQUALS 250_000
#ASSERT `s 2 "District Court limit" the amount in dollars` (JUST 400_000) EQUALS 400_000
#ASSERT `s 2 "Magistrate's Court limit" the amount in dollars` NOTHING EQUALS 60_000
#ASSERT `s 2 "Magistrate's Court limit" the amount in dollars` (JUST 100_000) EQUALS 100_000

-- "judicial officer" means a District Judge, Magistrate or registrar (a deputy registrar is a registrar).
#ASSERT `s 2 "judicial officer" the holder is a judicial officer` `District Judge` EQUALS JUST TRUE
#ASSERT `s 2 "judicial officer" the holder is a judicial officer` Magistrate EQUALS JUST TRUE
#ASSERT `s 2 "judicial officer" the holder is a judicial officer` `Registrar of the State Courts` EQUALS JUST TRUE
#ASSERT `s 2 "judicial officer" the holder is a judicial officer` `Deputy registrar of the State Courts` EQUALS JUST TRUE
#ASSERT `s 2 "judicial officer" the holder is a judicial officer` Bailiff EQUALS JUST FALSE
#ASSERT `s 2 "judicial officer" the holder is a judicial officer` `Presiding Judge of the State Courts` EQUALS JUST FALSE

#ASSERT `s 2 "registrar" the holder is the registrar` `Registrar of the State Courts` EQUALS JUST TRUE
#ASSERT `s 2 "registrar" the holder is the registrar` `Deputy registrar of the State Courts` EQUALS JUST TRUE
#ASSERT `s 2 "registrar" the holder is the registrar` Magistrate EQUALS JUST FALSE

#ASSERT `s 2 "prescribed" the matter is prescribed` TRUE EQUALS JUST TRUE
#ASSERT `s 2 "prescribed" the matter is prescribed` FALSE EQUALS JUST FALSE
#ASSERT `s 2 "Rules of Court" the instrument is within the Rules of Court` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2 "Rules of Court" the instrument is within the Rules of Court` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2 "Rules of Court" the instrument is within the Rules of Court` FALSE FALSE EQUALS JUST FALSE

-- "seal" includes stamp: a stamp is a seal; a thing that is not a stamp is not decided (the word is open).
#ASSERT `s 2 "seal" the thing is within the word seal` TRUE EQUALS JUST TRUE
#ASSERT `s 2 "seal" the thing is within the word seal` FALSE EQUALS NOTHING
