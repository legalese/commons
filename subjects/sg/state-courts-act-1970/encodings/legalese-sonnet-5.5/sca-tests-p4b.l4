#ASSERT `s 54F(4) the Magistrate's Court has jurisdiction to try the proceedings despite any other provision of this Act` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 54F(4) the Magistrate's Court has jurisdiction to try the proceedings despite any other provision of this Act` FALSE FALSE EQUALS JUST FALSE
