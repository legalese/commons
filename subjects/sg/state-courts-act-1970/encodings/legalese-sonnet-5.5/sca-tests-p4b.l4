#ASSERT `s 54F(1) a party may apply to the District Court for a transfer of the proceedings or of the counterclaim` TRUE 60_000 60_000 TRUE EQUALS JUST FALSE
#ASSERT `s 54F(1) a party may apply to the District Court for a transfer of the proceedings or of the counterclaim` TRUE 70_000 60_000 FALSE EQUALS NOTHING
