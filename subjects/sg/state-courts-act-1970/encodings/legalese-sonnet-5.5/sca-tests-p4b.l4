#ASSERT `s 54E(4) the State Court has jurisdiction to try the proceedings despite any other provision of this Act` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 54E(4) the State Court has jurisdiction to try the proceedings despite any other provision of this Act` FALSE FALSE EQUALS JUST FALSE
