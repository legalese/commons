#ASSERT `s 19(3) the action falls within a class that subsection (3) excludes from a District Court's jurisdiction` (`an action with the flags` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE 1_000) EQUALS JUST TRUE
#ASSERT `s 19(3) the action falls within a class that subsection (3) excludes from a District Court's jurisdiction` (`an action with the flags` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE 1_000) EQUALS JUST TRUE
#ASSERT `s 19(3) the action falls within a class that subsection (3) excludes from a District Court's jurisdiction` (`an action with the flags` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE 1_000) EQUALS JUST TRUE
#ASSERT `s 19(3) the action falls within a class that subsection (3) excludes from a District Court's jurisdiction` (`an action with the flags` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 1_000) EQUALS JUST FALSE
#ASSERT `s 19(3) a District Court's jurisdiction under subsection (2) includes the action` (`an action with the flags` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE 1_000) EQUALS JUST FALSE
#ASSERT `s 19(3) a District Court's jurisdiction under subsection (2) includes the action` (`an action with the flags` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE 1_000) EQUALS JUST FALSE
#ASSERT `s 19(3) a District Court's jurisdiction under subsection (2) includes the action` (`an action with the flags` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 1_000) EQUALS NOTHING
