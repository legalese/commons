#ASSERT `s 19(6) a District Court has the jurisdiction vested in it by another written law` TRUE EQUALS JUST TRUE
#ASSERT `s 19(6) a District Court has the jurisdiction vested in it by another written law` FALSE EQUALS NOTHING

