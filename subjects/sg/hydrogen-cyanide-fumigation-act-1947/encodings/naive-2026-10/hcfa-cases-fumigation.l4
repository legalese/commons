#ASSERT NOT `the Act reaches the fumigation` `a container fumigated with methyl bromide with no order`
#ASSERT `the Act reaches the fumigation` `an open-air fumigation with another gas under a section 6 order`

#ASSERT `the regulations apply to the fumigation` `a ship hold fumigated with hydrogen cyanide`
#ASSERT `the regulations apply to the fumigation` `a shophouse fumigated with hydrogen cyanide`
#ASSERT NOT `the regulations apply to the fumigation` `timber stacked in a yard fumigated with hydrogen cyanide in the open air`
#ASSERT `the regulations apply to the fumigation` `a container fumigated with methyl bromide under a section 6 order`
#ASSERT NOT `the regulations apply to the fumigation` `a container fumigated with methyl bromide with no order`
#ASSERT NOT `the regulations apply to the fumigation` `an open-air fumigation with another gas under a section 6 order`

§ `s 2(4)`

#ASSERT `contravening the regulations is an offence` `a shophouse fumigated with hydrogen cyanide` TRUE
#ASSERT NOT `contravening the regulations is an offence` `a shophouse fumigated with hydrogen cyanide` FALSE
#ASSERT NOT `contravening the regulations is an offence` `timber stacked in a yard fumigated with hydrogen cyanide in the open air` TRUE
#ASSERT `contravening the regulations is an offence` `a container fumigated with methyl bromide under a section 6 order` TRUE
#ASSERT NOT `contravening the regulations is an offence` `a container fumigated with methyl bromide with no order` TRUE

#ASSERT `the maximum total fine for contravening the regulations` 1 EQUALS 500
#ASSERT `the maximum total fine for contravening the regulations` 3 EQUALS 1500

§ `s 3`

#ASSERT `notice of the accident is required` `a shophouse fumigated with hydrogen cyanide` `loss of human life`
#ASSERT `notice of the accident is required` `a shophouse fumigated with hydrogen cyanide` `personal injury`
#ASSERT NOT `notice of the accident is required` `a shophouse fumigated with hydrogen cyanide` `damage to property only`
#ASSERT NOT `notice of the accident is required` `a shophouse fumigated with hydrogen cyanide` `no harm`
#ASSERT `notice of the accident is required` `timber stacked in a yard fumigated with hydrogen cyanide in the open air` `personal injury`
#ASSERT NOT `notice of the accident is required` `a container fumigated with methyl bromide with no order` `loss of human life`

#ASSERT `bears the duty to notify` `carried out the fumigation personally`
#ASSERT `bears the duty to notify` `the fumigation was carried out by its agent`
#ASSERT NOT `bears the duty to notify` `owns the premises fumigated by an independent fumigator`
#ASSERT NOT `bears the duty to notify` `a bystander`

#ASSERT `failing to notify is an offence` `a ship hold fumigated with hydrogen cyanide` `personal injury` `the fumigation was carried out by its agent` FALSE
#ASSERT NOT `failing to notify is an offence` `a ship hold fumigated with hydrogen cyanide` `personal injury` `the fumigation was carried out by its agent` TRUE
#ASSERT `failing to notify is an offence` `timber stacked in a yard fumigated with hydrogen cyanide in the open air` `loss of human life` `carried out the fumigation personally` FALSE
#ASSERT NOT `failing to notify is an offence` `a ship hold fumigated with hydrogen cyanide` `damage to property only` `carried out the fumigation personally` FALSE

#ASSERT `the maximum fine for failing to notify` EQUALS 200

