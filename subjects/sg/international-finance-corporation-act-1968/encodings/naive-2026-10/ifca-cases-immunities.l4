IMPORT prelude
IMPORT `ifca-immunities`

-- International Finance Corporation Act 1968, ss 4, 5, 7(1) and Schedule Article VI sections 3, 4, 8, 9, 11 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_international-finance-corporation-act-1968.py). Expected results were written by
-- hand from the text.

§ `ss 4, 5 -- payments and borrowing`

#ASSERT `s 4 charges the payment on the Consolidated Fund` `a subscription for shares under Article II section 3`
#ASSERT `s 4 charges the payment on the Consolidated Fund` `a payment on ceasing to be a member under Article V section 4`
#ASSERT NOT `s 4 charges the payment on the Consolidated Fund` `some other payment to the Corporation`

#ASSERT `the Minister may raise the loan under s 5` TRUE TRUE
#ASSERT NOT `the Minister may raise the loan under s 5` TRUE FALSE
#ASSERT NOT `the Minister may raise the loan under s 5` FALSE TRUE

§ `Article VI section 3 -- suing the Corporation`

#ASSERT `an action may be brought against the Corporation` `a claim on the Corporation's borrowing` FALSE TRUE
#ASSERT `an action may be brought against the Corporation` `a supplier's claim for the price of goods` FALSE TRUE
#ASSERT `an action may be brought against the Corporation` `an employee's claim for wages` FALSE TRUE
#ASSERT `an action may be brought against the Corporation` `a claim for personal injury on Corporation premises` FALSE TRUE
#ASSERT NOT `an action may be brought against the Corporation` `a claim for personal injury on Corporation premises` FALSE FALSE
#ASSERT NOT `an action may be brought against the Corporation` `a claim on a Corporation guarantee` FALSE FALSE
#ASSERT NOT `an action may be brought against the Corporation` `a claim on the Corporation's borrowing` TRUE TRUE
#ASSERT NOT `an action may be brought against the Corporation` `a supplier's claim for the price of goods` TRUE TRUE

§ `Article VI sections 3, 4, 11 -- seizure`

#ASSERT `the Corporation's property may be seized` TRUE FALSE FALSE
#ASSERT NOT `the Corporation's property may be seized` FALSE FALSE FALSE
#ASSERT NOT `the Corporation's property may be seized` TRUE TRUE FALSE
#ASSERT `the Corporation's property may be seized` FALSE FALSE TRUE
#ASSERT `the Corporation's property may be seized` FALSE TRUE TRUE

§ `Article VI section 8 -- personnel`

#ASSERT `the person is immune from legal process for the act` `an officer` TRUE FALSE
#ASSERT NOT `the person is immune from legal process for the act` `an officer` FALSE FALSE
#ASSERT NOT `the person is immune from legal process for the act` `an officer` TRUE TRUE
#ASSERT `the person is immune from legal process for the act` `a Governor` TRUE FALSE
#ASSERT NOT `the person is immune from legal process for the act` `a consultant on a Corporation mission` TRUE FALSE
#ASSERT NOT `the person is immune from legal process for the act` `a contractor supplying the Corporation` TRUE FALSE

#ASSERT `the person gets the immigration and national service immunities` `an employee` FALSE
#ASSERT NOT `the person gets the immigration and national service immunities` `an employee` TRUE
#ASSERT `the person gets the immigration and national service immunities` `a Director` FALSE
#ASSERT NOT `the person gets the immigration and national service immunities` `a contractor supplying the Corporation` FALSE

§ `Article VI section 9(a) and s 7(1) proviso -- the Corporation's own taxes`

#ASSERT `the Corporation is immune from the levy` `income tax on the Corporation's income`
#ASSERT `the Corporation is immune from the levy` `customs duty on goods imported with a restriction on resale`
#ASSERT NOT `the Corporation is immune from the levy` `customs duty on goods imported with no restriction on resale`
#ASSERT NOT `the Corporation is immune from the levy` `a tax forming part of the price of goods sold to the Corporation`
#ASSERT NOT `the Corporation is immune from the levy` `a charge for services rendered`
#ASSERT `the Corporation is immune from the levy` `a duty to withhold tax from the Corporation's payments`
#ASSERT `the Corporation is immune from the levy` `a tax on the Corporation's authorised transactions`

§ `Article VI section 9(b) -- salaries`

#ASSERT `section 9(b) bars tax on the Corporation salary` `an employee` FALSE
#ASSERT NOT `section 9(b) bars tax on the Corporation salary` `an employee` TRUE
#ASSERT `section 9(b) bars tax on the Corporation salary` `an Alternate` FALSE
#ASSERT `section 9(b) bars tax on the Corporation salary` `an officer` FALSE
#ASSERT NOT `section 9(b) bars tax on the Corporation salary` `a Governor` FALSE
#ASSERT NOT `section 9(b) bars tax on the Corporation salary` `a contractor supplying the Corporation` FALSE

