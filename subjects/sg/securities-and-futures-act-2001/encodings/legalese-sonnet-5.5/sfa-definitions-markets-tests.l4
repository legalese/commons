IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-definitions-markets`

-- Tests for sfa-definitions-markets.
-- Expected values are written from the text of the Act (the quote lines in the module under test), never from its output.

-- a corporation the Authority has approved
#ASSERT `s 2(1) "approved clearing house" the corporation is approved clearing house` TRUE TRUE EQUALS JUST TRUE
-- the Authority has not
#ASSERT `s 2(1) "approved clearing house" the corporation is approved clearing house` TRUE FALSE EQUALS JUST FALSE
-- not a corporation
#ASSERT `s 2(1) "approved clearing house" the corporation is approved clearing house` FALSE TRUE EQUALS JUST FALSE

-- a corporation the Authority has approved
#ASSERT `s 2(1) "approved exchange" the corporation is approved exchange` TRUE TRUE EQUALS JUST TRUE
-- the Authority has not
#ASSERT `s 2(1) "approved exchange" the corporation is approved exchange` TRUE FALSE EQUALS JUST FALSE
-- not a corporation
#ASSERT `s 2(1) "approved exchange" the corporation is approved exchange` FALSE TRUE EQUALS JUST FALSE

-- a corporation the Authority has approved
#ASSERT `s 2(1) "approved holding company" the corporation is approved holding company` TRUE TRUE EQUALS JUST TRUE
-- the Authority has not
#ASSERT `s 2(1) "approved holding company" the corporation is approved holding company` TRUE FALSE EQUALS JUST FALSE
-- not a corporation
#ASSERT `s 2(1) "approved holding company" the corporation is approved holding company` FALSE TRUE EQUALS JUST FALSE

-- a corporation the Authority has recognised
#ASSERT `s 2(1) "recognised clearing house" the corporation is recognised clearing house` TRUE TRUE EQUALS JUST TRUE
-- the Authority has not
#ASSERT `s 2(1) "recognised clearing house" the corporation is recognised clearing house` TRUE FALSE EQUALS JUST FALSE
-- not a corporation
#ASSERT `s 2(1) "recognised clearing house" the corporation is recognised clearing house` FALSE TRUE EQUALS JUST FALSE

-- a corporation the Authority has recognised
#ASSERT `s 2(1) "recognised market operator" the corporation is recognised market operator` TRUE TRUE EQUALS JUST TRUE
-- the Authority has not
#ASSERT `s 2(1) "recognised market operator" the corporation is recognised market operator` TRUE FALSE EQUALS JUST FALSE
-- not a corporation
#ASSERT `s 2(1) "recognised market operator" the corporation is recognised market operator` FALSE TRUE EQUALS JUST FALSE

-- a corporation with the licence in force
#ASSERT `s 2(1) "licensed trade repository" the corporation is a licensed trade repository` TRUE TRUE EQUALS JUST TRUE
-- no licence in force
#ASSERT `s 2(1) "licensed trade repository" the corporation is a licensed trade repository` TRUE FALSE EQUALS JUST FALSE
-- not a corporation
#ASSERT `s 2(1) "licensed trade repository" the corporation is a licensed trade repository` FALSE TRUE EQUALS JUST FALSE

-- a corporation with the licence in force
#ASSERT `s 2(1) "licensed foreign trade repository" the corporation is a licensed foreign trade repository` TRUE TRUE EQUALS JUST TRUE
-- no licence in force
#ASSERT `s 2(1) "licensed foreign trade repository" the corporation is a licensed foreign trade repository` TRUE FALSE EQUALS JUST FALSE
-- not a corporation
#ASSERT `s 2(1) "licensed foreign trade repository" the corporation is a licensed foreign trade repository` FALSE TRUE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "Authority" the body is the Authority` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "means the Monetary Authority of Singapore established under the Monetary Authority of Singapore Act 1970"
#ASSERT `s 2(1) "Authority" the body is the Authority` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "Securities Industry Council" the body is the Securities Industry Council` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "means the Securities Industry Council referred to in section 138"
#ASSERT `s 2(1) "Securities Industry Council" the body is the Securities Industry Council` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "Take-over Code" the document is the Take-over Code` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "means the Singapore Code on Take-overs and Mergers referred to in section 139 which is issued by the Authority under section 321(1)"
#ASSERT `s 2(1) "Take-over Code" the document is the Take-over Code` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "organised market" the market is an organised market` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given in the First Schedule"
#ASSERT `s 2(1) "organised market" the market is an organised market` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "clearing facility" the facility is a clearing facility` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given in Part 2 of the First Schedule"
#ASSERT `s 2(1) "clearing facility" the facility is a clearing facility` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "clearing or settlement" the activity is clearing or settlement` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given in Part 2 of the First Schedule"
#ASSERT `s 2(1) "clearing or settlement" the activity is clearing or settlement` FALSE EQUALS JUST FALSE

-- rules governing the body and its members and other persons
#ASSERT (`s 2(1) "business rules" the statements are the business rules of the body` WITH `the body is an approved holding company, approved exchange, recognised market operator, licensed trade repository, licensed foreign trade repository, approved clearing house or recognised clearing house` IS TRUE, `the statements are rules, regulations, by-laws or a similar body of statements, by whatever name called` IS TRUE, `they govern the activities and conduct of the body and its members, or of the trade repository and its participants` IS TRUE, `they govern the activities and conduct of other persons in relation to the body` IS TRUE, `they are the listing rules of an approved exchange or of a recognised market operator that is an overseas exchange` IS FALSE) EQUALS JUST TRUE
-- (b) missing: "and" joins (a) and (b)
#ASSERT (`s 2(1) "business rules" the statements are the business rules of the body` WITH `the body is an approved holding company, approved exchange, recognised market operator, licensed trade repository, licensed foreign trade repository, approved clearing house or recognised clearing house` IS TRUE, `the statements are rules, regulations, by-laws or a similar body of statements, by whatever name called` IS TRUE, `they govern the activities and conduct of the body and its members, or of the trade repository and its participants` IS TRUE, `they govern the activities and conduct of other persons in relation to the body` IS FALSE, `they are the listing rules of an approved exchange or of a recognised market operator that is an overseas exchange` IS FALSE) EQUALS JUST FALSE
-- the listing rules of an approved exchange are excluded
#ASSERT (`s 2(1) "business rules" the statements are the business rules of the body` WITH `the body is an approved holding company, approved exchange, recognised market operator, licensed trade repository, licensed foreign trade repository, approved clearing house or recognised clearing house` IS TRUE, `the statements are rules, regulations, by-laws or a similar body of statements, by whatever name called` IS TRUE, `they govern the activities and conduct of the body and its members, or of the trade repository and its participants` IS TRUE, `they govern the activities and conduct of other persons in relation to the body` IS TRUE, `they are the listing rules of an approved exchange or of a recognised market operator that is an overseas exchange` IS TRUE) EQUALS JUST FALSE
-- not one of the seven bodies: the text gives no meaning
#ASSERT (`s 2(1) "business rules" the statements are the business rules of the body` WITH `the body is an approved holding company, approved exchange, recognised market operator, licensed trade repository, licensed foreign trade repository, approved clearing house or recognised clearing house` IS FALSE, `the statements are rules, regulations, by-laws or a similar body of statements, by whatever name called` IS TRUE, `they govern the activities and conduct of the body and its members, or of the trade repository and its participants` IS TRUE, `they govern the activities and conduct of other persons in relation to the body` IS TRUE, `they are the listing rules of an approved exchange or of a recognised market operator that is an overseas exchange` IS FALSE) EQUALS NOTHING

-- (a) admission rules made by the corporation
#ASSERT (`s 2(1) "listing rules" the rules are the listing rules of the corporation` WITH `the body is a corporation that establishes or operates, or proposes to establish or operate, an organised market of an approved exchange or a recognised market operator, or an overseas exchange doing so for a recognised market operator` IS TRUE, `the rules govern or relate to the admission to the official list of persons for the quotation of their securities, securities-based derivatives contracts or units, or their removal from it` IS TRUE, `the rules govern or relate to the activities or conduct of the persons admitted to that list` IS FALSE, `the rules are made by the corporation or overseas exchange, or are contained in its constituent documents` IS TRUE, `the rules are made by another person and adopted by the corporation or overseas exchange` IS FALSE) EQUALS JUST TRUE
-- (b) conduct rules made by another and adopted
#ASSERT (`s 2(1) "listing rules" the rules are the listing rules of the corporation` WITH `the body is a corporation that establishes or operates, or proposes to establish or operate, an organised market of an approved exchange or a recognised market operator, or an overseas exchange doing so for a recognised market operator` IS TRUE, `the rules govern or relate to the admission to the official list of persons for the quotation of their securities, securities-based derivatives contracts or units, or their removal from it` IS FALSE, `the rules govern or relate to the activities or conduct of the persons admitted to that list` IS TRUE, `the rules are made by the corporation or overseas exchange, or are contained in its constituent documents` IS FALSE, `the rules are made by another person and adopted by the corporation or overseas exchange` IS TRUE) EQUALS JUST TRUE
-- rules about admission but neither (c) nor (d)
#ASSERT (`s 2(1) "listing rules" the rules are the listing rules of the corporation` WITH `the body is a corporation that establishes or operates, or proposes to establish or operate, an organised market of an approved exchange or a recognised market operator, or an overseas exchange doing so for a recognised market operator` IS TRUE, `the rules govern or relate to the admission to the official list of persons for the quotation of their securities, securities-based derivatives contracts or units, or their removal from it` IS TRUE, `the rules govern or relate to the activities or conduct of the persons admitted to that list` IS FALSE, `the rules are made by the corporation or overseas exchange, or are contained in its constituent documents` IS FALSE, `the rules are made by another person and adopted by the corporation or overseas exchange` IS FALSE) EQUALS JUST FALSE
-- made by the corporation but about neither (a) nor (b)
#ASSERT (`s 2(1) "listing rules" the rules are the listing rules of the corporation` WITH `the body is a corporation that establishes or operates, or proposes to establish or operate, an organised market of an approved exchange or a recognised market operator, or an overseas exchange doing so for a recognised market operator` IS TRUE, `the rules govern or relate to the admission to the official list of persons for the quotation of their securities, securities-based derivatives contracts or units, or their removal from it` IS FALSE, `the rules govern or relate to the activities or conduct of the persons admitted to that list` IS FALSE, `the rules are made by the corporation or overseas exchange, or are contained in its constituent documents` IS TRUE, `the rules are made by another person and adopted by the corporation or overseas exchange` IS FALSE) EQUALS JUST FALSE
-- not a corporation of that kind: the text gives no meaning
#ASSERT (`s 2(1) "listing rules" the rules are the listing rules of the corporation` WITH `the body is a corporation that establishes or operates, or proposes to establish or operate, an organised market of an approved exchange or a recognised market operator, or an overseas exchange doing so for a recognised market operator` IS FALSE, `the rules govern or relate to the admission to the official list of persons for the quotation of their securities, securities-based derivatives contracts or units, or their removal from it` IS TRUE, `the rules govern or relate to the activities or conduct of the persons admitted to that list` IS FALSE, `the rules are made by the corporation or overseas exchange, or are contained in its constituent documents` IS TRUE, `the rules are made by another person and adopted by the corporation or overseas exchange` IS FALSE) EQUALS NOTHING

-- all three
#ASSERT `s 2(1) "overseas exchange" the person is an overseas exchange` TRUE TRUE TRUE EQUALS JUST TRUE
-- not regulated by a foreign authority
#ASSERT `s 2(1) "overseas exchange" the person is an overseas exchange` TRUE TRUE FALSE EQUALS JUST FALSE
-- market not outside Singapore
#ASSERT `s 2(1) "overseas exchange" the person is an overseas exchange` TRUE FALSE TRUE EQUALS JUST FALSE
-- operates no organised market
#ASSERT `s 2(1) "overseas exchange" the person is an overseas exchange` FALSE TRUE TRUE EQUALS JUST FALSE

-- every element
#ASSERT (`s 2(1) "quote" the display or provision of information is to quote` WITH `the information is displayed or provided on an organised market of an approved exchange or a recognised market operator` IS TRUE, `the information concerns the particular prices or particular consideration at which offers or invitations to sell, purchase or exchange are made on that organised market` IS TRUE, `the offers or invitations are of securities, securities-based derivatives contracts or units in a collective investment scheme` IS TRUE, `the offers or invitations are intended, or may reasonably be expected, to result directly or indirectly in the making or acceptance of offers to sell, purchase or exchange` IS TRUE) EQUALS JUST TRUE
-- element disp missing
#ASSERT (`s 2(1) "quote" the display or provision of information is to quote` WITH `the information is displayed or provided on an organised market of an approved exchange or a recognised market operator` IS FALSE, `the information concerns the particular prices or particular consideration at which offers or invitations to sell, purchase or exchange are made on that organised market` IS TRUE, `the offers or invitations are of securities, securities-based derivatives contracts or units in a collective investment scheme` IS TRUE, `the offers or invitations are intended, or may reasonably be expected, to result directly or indirectly in the making or acceptance of offers to sell, purchase or exchange` IS TRUE) EQUALS JUST FALSE
-- element info missing
#ASSERT (`s 2(1) "quote" the display or provision of information is to quote` WITH `the information is displayed or provided on an organised market of an approved exchange or a recognised market operator` IS TRUE, `the information concerns the particular prices or particular consideration at which offers or invitations to sell, purchase or exchange are made on that organised market` IS FALSE, `the offers or invitations are of securities, securities-based derivatives contracts or units in a collective investment scheme` IS TRUE, `the offers or invitations are intended, or may reasonably be expected, to result directly or indirectly in the making or acceptance of offers to sell, purchase or exchange` IS TRUE) EQUALS JUST FALSE
-- element prod missing
#ASSERT (`s 2(1) "quote" the display or provision of information is to quote` WITH `the information is displayed or provided on an organised market of an approved exchange or a recognised market operator` IS TRUE, `the information concerns the particular prices or particular consideration at which offers or invitations to sell, purchase or exchange are made on that organised market` IS TRUE, `the offers or invitations are of securities, securities-based derivatives contracts or units in a collective investment scheme` IS FALSE, `the offers or invitations are intended, or may reasonably be expected, to result directly or indirectly in the making or acceptance of offers to sell, purchase or exchange` IS TRUE) EQUALS JUST FALSE
-- element res missing
#ASSERT (`s 2(1) "quote" the display or provision of information is to quote` WITH `the information is displayed or provided on an organised market of an approved exchange or a recognised market operator` IS TRUE, `the information concerns the particular prices or particular consideration at which offers or invitations to sell, purchase or exchange are made on that organised market` IS TRUE, `the offers or invitations are of securities, securities-based derivatives contracts or units in a collective investment scheme` IS TRUE, `the offers or invitations are intended, or may reasonably be expected, to result directly or indirectly in the making or acceptance of offers to sell, purchase or exchange` IS FALSE) EQUALS JUST FALSE

-- holds membership (whether or not a shareholder)
#ASSERT `s 2(1) "member" the person is a member of the body` TRUE TRUE EQUALS JUST TRUE
-- holds no membership
#ASSERT `s 2(1) "member" the person is a member of the body` TRUE FALSE EQUALS JUST FALSE
-- a membership of some other kind of body: the text gives no meaning
#ASSERT `s 2(1) "member" the person is a member of the body` FALSE TRUE EQUALS NOTHING

-- (a)(i): a member
#ASSERT (`s 2(1) "user" the person is a user` WITH `the kind of body` IS (`s 2(1) "user" an approved exchange, recognised market operator, approved clearing house or recognised clearing house`), `the person is a member of the body` IS TRUE, `the person is a customer of a member of the body` IS FALSE, `the person is a participant of the trade repository` IS FALSE, `the person is a client of a participant of the trade repository` IS FALSE) EQUALS JUST TRUE
-- (a)(ii): a customer of a member
#ASSERT (`s 2(1) "user" the person is a user` WITH `the kind of body` IS (`s 2(1) "user" an approved exchange, recognised market operator, approved clearing house or recognised clearing house`), `the person is a member of the body` IS FALSE, `the person is a customer of a member of the body` IS TRUE, `the person is a participant of the trade repository` IS FALSE, `the person is a client of a participant of the trade repository` IS FALSE) EQUALS JUST TRUE
-- (a): a trade repository participant is not a user of an exchange
#ASSERT (`s 2(1) "user" the person is a user` WITH `the kind of body` IS (`s 2(1) "user" an approved exchange, recognised market operator, approved clearing house or recognised clearing house`), `the person is a member of the body` IS FALSE, `the person is a customer of a member of the body` IS FALSE, `the person is a participant of the trade repository` IS TRUE, `the person is a client of a participant of the trade repository` IS FALSE) EQUALS JUST FALSE
-- (b)(i): a participant
#ASSERT (`s 2(1) "user" the person is a user` WITH `the kind of body` IS (`s 2(1) "user" a licensed trade repository or licensed foreign trade repository`), `the person is a member of the body` IS FALSE, `the person is a customer of a member of the body` IS FALSE, `the person is a participant of the trade repository` IS TRUE, `the person is a client of a participant of the trade repository` IS FALSE) EQUALS JUST TRUE
-- (b)(ii): a client of a participant
#ASSERT (`s 2(1) "user" the person is a user` WITH `the kind of body` IS (`s 2(1) "user" a licensed trade repository or licensed foreign trade repository`), `the person is a member of the body` IS FALSE, `the person is a customer of a member of the body` IS FALSE, `the person is a participant of the trade repository` IS FALSE, `the person is a client of a participant of the trade repository` IS TRUE) EQUALS JUST TRUE
-- (b): a member of an exchange is not a user of a trade repository
#ASSERT (`s 2(1) "user" the person is a user` WITH `the kind of body` IS (`s 2(1) "user" a licensed trade repository or licensed foreign trade repository`), `the person is a member of the body` IS TRUE, `the person is a customer of a member of the body` IS FALSE, `the person is a participant of the trade repository` IS FALSE, `the person is a client of a participant of the trade repository` IS FALSE) EQUALS JUST FALSE

-- transaction information: the information relates to offers or invitations to enter into, purchase, sell or exchange capital markets products
#ASSERT (`s 2(1) "transaction information" the information is transaction information` WITH `the information relates to offers or invitations to enter into, purchase, sell or exchange capital markets products` IS TRUE, `the information relates to executed transactions in capital markets products` IS FALSE, `the information relates to transactions cleared or settled by an approved clearing house or a recognised clearing house` IS FALSE, `the information relates to transactions reported to a licensed trade repository or licensed foreign trade repository` IS FALSE) EQUALS JUST TRUE
-- transaction information: the information relates to executed transactions in capital markets products
#ASSERT (`s 2(1) "transaction information" the information is transaction information` WITH `the information relates to offers or invitations to enter into, purchase, sell or exchange capital markets products` IS FALSE, `the information relates to executed transactions in capital markets products` IS TRUE, `the information relates to transactions cleared or settled by an approved clearing house or a recognised clearing house` IS FALSE, `the information relates to transactions reported to a licensed trade repository or licensed foreign trade repository` IS FALSE) EQUALS JUST TRUE
-- transaction information: the information relates to transactions cleared or settled by an approved clearing house or a recognised clearing house
#ASSERT (`s 2(1) "transaction information" the information is transaction information` WITH `the information relates to offers or invitations to enter into, purchase, sell or exchange capital markets products` IS FALSE, `the information relates to executed transactions in capital markets products` IS FALSE, `the information relates to transactions cleared or settled by an approved clearing house or a recognised clearing house` IS TRUE, `the information relates to transactions reported to a licensed trade repository or licensed foreign trade repository` IS FALSE) EQUALS JUST TRUE
-- transaction information: the information relates to transactions reported to a licensed trade repository or licensed foreign trade repository
#ASSERT (`s 2(1) "transaction information" the information is transaction information` WITH `the information relates to offers or invitations to enter into, purchase, sell or exchange capital markets products` IS FALSE, `the information relates to executed transactions in capital markets products` IS FALSE, `the information relates to transactions cleared or settled by an approved clearing house or a recognised clearing house` IS FALSE, `the information relates to transactions reported to a licensed trade repository or licensed foreign trade repository` IS TRUE) EQUALS JUST TRUE
-- none of (a) to (d)
#ASSERT (`s 2(1) "transaction information" the information is transaction information` WITH `the information relates to offers or invitations to enter into, purchase, sell or exchange capital markets products` IS FALSE, `the information relates to executed transactions in capital markets products` IS FALSE, `the information relates to transactions cleared or settled by an approved clearing house or a recognised clearing house` IS FALSE, `the information relates to transactions reported to a licensed trade repository or licensed foreign trade repository` IS FALSE) EQUALS JUST FALSE

-- (a): a named user
#ASSERT `s 2(1) "user information" the information is user information` TRUE TRUE FALSE EQUALS JUST TRUE
-- (b): a group from which a user can be inferred
#ASSERT `s 2(1) "user information" the information is user information` TRUE FALSE TRUE EQUALS JUST TRUE
-- not referable to a user
#ASSERT `s 2(1) "user information" the information is user information` TRUE FALSE FALSE EQUALS JUST FALSE
-- not transaction information
#ASSERT `s 2(1) "user information" the information is user information` FALSE TRUE FALSE EQUALS JUST FALSE

-- a record, register or document
#ASSERT `s 2(1) "book" the thing is a book` TRUE FALSE EQUALS JUST TRUE
-- an account or accounting record
#ASSERT `s 2(1) "book" the thing is a book` FALSE TRUE EQUALS JUST TRUE
-- neither: "includes" does not say no
#ASSERT `s 2(1) "book" the thing is a book` FALSE FALSE EQUALS NOTHING

-- fixed on a tangible medium
#ASSERT `s 2(1) "record" the information is a record` TRUE FALSE FALSE EQUALS JUST TRUE
-- stored electronically and retrievable in perceivable form
#ASSERT `s 2(1) "record" the information is a record` FALSE TRUE TRUE EQUALS JUST TRUE
-- stored electronically but not retrievable in perceivable form
#ASSERT `s 2(1) "record" the information is a record` FALSE TRUE FALSE EQUALS JUST FALSE
-- neither
#ASSERT `s 2(1) "record" the information is a record` FALSE FALSE FALSE EQUALS JUST FALSE

-- a misapplication
#ASSERT `s 2(1) "defalcation" the act is a defalcation` TRUE FALSE EQUALS JUST TRUE
-- a misappropriation (included in misapplication)
#ASSERT `s 2(1) "defalcation" the act is a defalcation` FALSE TRUE EQUALS JUST TRUE
-- neither
#ASSERT `s 2(1) "defalcation" the act is a defalcation` FALSE FALSE EQUALS JUST FALSE

-- made under section 7(1)
#ASSERT `s 2(1) "FSMA prohibition order" the order is an FSMA prohibition order` TRUE EQUALS JUST TRUE
-- not so made
#ASSERT `s 2(1) "FSMA prohibition order" the order is an FSMA prohibition order` FALSE EQUALS JUST FALSE

-- related Acts prohibition order: the order is a prohibition order made under section 68(1) of the Financial Advisers Act 2001 as in force immediately before the commencement of section 200(1)(b) and (2) to (7) of the Financial Services and Markets Act 2022
#ASSERT (`s 2(1) "related Acts prohibition order" the order is a related Acts prohibition order` WITH `the order is a prohibition order made under section 68(1) of the Financial Advisers Act 2001 as in force immediately before the commencement of section 200(1)(b) and (2) to (7) of the Financial Services and Markets Act 2022` IS TRUE, `the order is such a prohibition order, as continued by section 217(2) of the Financial Services and Markets Act 2022` IS FALSE, `the order is an order made under section 74(1) of the Insurance Act 1966 as in force immediately before the commencement of section 204(1) to (4) of the Financial Services and Markets Act 2022` IS FALSE, `the order is such an order under the Insurance Act 1966, as continued by section 218(2) of the Financial Services and Markets Act 2022` IS FALSE) EQUALS JUST TRUE
-- related Acts prohibition order: the order is such a prohibition order, as continued by section 217(2) of the Financial Services and Markets Act 2022
#ASSERT (`s 2(1) "related Acts prohibition order" the order is a related Acts prohibition order` WITH `the order is a prohibition order made under section 68(1) of the Financial Advisers Act 2001 as in force immediately before the commencement of section 200(1)(b) and (2) to (7) of the Financial Services and Markets Act 2022` IS FALSE, `the order is such a prohibition order, as continued by section 217(2) of the Financial Services and Markets Act 2022` IS TRUE, `the order is an order made under section 74(1) of the Insurance Act 1966 as in force immediately before the commencement of section 204(1) to (4) of the Financial Services and Markets Act 2022` IS FALSE, `the order is such an order under the Insurance Act 1966, as continued by section 218(2) of the Financial Services and Markets Act 2022` IS FALSE) EQUALS JUST TRUE
-- related Acts prohibition order: the order is an order made under section 74(1) of the Insurance Act 1966 as in force immediately before the commencement of section 204(1) to (4) of the Financial Services and Markets Act 2022
#ASSERT (`s 2(1) "related Acts prohibition order" the order is a related Acts prohibition order` WITH `the order is a prohibition order made under section 68(1) of the Financial Advisers Act 2001 as in force immediately before the commencement of section 200(1)(b) and (2) to (7) of the Financial Services and Markets Act 2022` IS FALSE, `the order is such a prohibition order, as continued by section 217(2) of the Financial Services and Markets Act 2022` IS FALSE, `the order is an order made under section 74(1) of the Insurance Act 1966 as in force immediately before the commencement of section 204(1) to (4) of the Financial Services and Markets Act 2022` IS TRUE, `the order is such an order under the Insurance Act 1966, as continued by section 218(2) of the Financial Services and Markets Act 2022` IS FALSE) EQUALS JUST TRUE
-- related Acts prohibition order: the order is such an order under the Insurance Act 1966, as continued by section 218(2) of the Financial Services and Markets Act 2022
#ASSERT (`s 2(1) "related Acts prohibition order" the order is a related Acts prohibition order` WITH `the order is a prohibition order made under section 68(1) of the Financial Advisers Act 2001 as in force immediately before the commencement of section 200(1)(b) and (2) to (7) of the Financial Services and Markets Act 2022` IS FALSE, `the order is such a prohibition order, as continued by section 217(2) of the Financial Services and Markets Act 2022` IS FALSE, `the order is an order made under section 74(1) of the Insurance Act 1966 as in force immediately before the commencement of section 204(1) to (4) of the Financial Services and Markets Act 2022` IS FALSE, `the order is such an order under the Insurance Act 1966, as continued by section 218(2) of the Financial Services and Markets Act 2022` IS TRUE) EQUALS JUST TRUE
-- none of (a) to (d)
#ASSERT (`s 2(1) "related Acts prohibition order" the order is a related Acts prohibition order` WITH `the order is a prohibition order made under section 68(1) of the Financial Advisers Act 2001 as in force immediately before the commencement of section 200(1)(b) and (2) to (7) of the Financial Services and Markets Act 2022` IS FALSE, `the order is such a prohibition order, as continued by section 217(2) of the Financial Services and Markets Act 2022` IS FALSE, `the order is an order made under section 74(1) of the Insurance Act 1966 as in force immediately before the commencement of section 204(1) to (4) of the Financial Services and Markets Act 2022` IS FALSE, `the order is such an order under the Insurance Act 1966, as continued by section 218(2) of the Financial Services and Markets Act 2022` IS FALSE) EQUALS JUST FALSE

-- (a)
#ASSERT `s 2(1) "section 101A prohibition order" the order is a section 101A prohibition order` TRUE FALSE EQUALS JUST TRUE
-- (b): as continued by section 220(3)
#ASSERT `s 2(1) "section 101A prohibition order" the order is a section 101A prohibition order` FALSE TRUE EQUALS JUST TRUE
-- neither
#ASSERT `s 2(1) "section 101A prohibition order" the order is a section 101A prohibition order` FALSE FALSE EQUALS JUST FALSE

-- (a)
#ASSERT `s 2(1) "section 123ZZC prohibition order" the order is a section 123ZZC prohibition order` TRUE FALSE EQUALS JUST TRUE
-- (b): as continued by section 220(5)
#ASSERT `s 2(1) "section 123ZZC prohibition order" the order is a section 123ZZC prohibition order` FALSE TRUE EQUALS JUST TRUE
-- neither
#ASSERT `s 2(1) "section 123ZZC prohibition order" the order is a section 123ZZC prohibition order` FALSE FALSE EQUALS JUST FALSE

-- (a)(ii): the Credit Bureau Act 2016 is listed for Division 3 of Part 9
#ASSERT `s 2(1) "prescribed written law" the written law is a prescribed written law` (`s 2(1) "prescribed written law" for the purpose of Division 3 of Part 9`) (`s 2(1) "prescribed written law" the Credit Bureau Act 2016`) FALSE EQUALS JUST TRUE
-- (b) does not list the Credit Bureau Act 2016: the same Act is not a prescribed written law for any other provision
#ASSERT `s 2(1) "prescribed written law" the written law is a prescribed written law` (`s 2(1) "prescribed written law" for the purpose of any other provision`) (`s 2(1) "prescribed written law" the Credit Bureau Act 2016`) FALSE EQUALS JUST FALSE
-- (a)(xi): the Trust Companies Act 2005 is listed for Division 3 of Part 9
#ASSERT `s 2(1) "prescribed written law" the written law is a prescribed written law` (`s 2(1) "prescribed written law" for the purpose of Division 3 of Part 9`) (`s 2(1) "prescribed written law" the Trust Companies Act 2005`) FALSE EQUALS JUST TRUE
-- (b) does not list the Trust Companies Act 2005
#ASSERT `s 2(1) "prescribed written law" the written law is a prescribed written law` (`s 2(1) "prescribed written law" for the purpose of any other provision`) (`s 2(1) "prescribed written law" the Trust Companies Act 2005`) FALSE EQUALS JUST FALSE
-- (b)(i): the Banking Act 1970 (and its subsidiary legislation, which is named by the Act it is made under)
#ASSERT `s 2(1) "prescribed written law" the written law is a prescribed written law` (`s 2(1) "prescribed written law" for the purpose of any other provision`) (`s 2(1) "prescribed written law" the Banking Act 1970`) FALSE EQUALS JUST TRUE
-- (b): this Act
