IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfaa-div1-interpretation`

-- Tests for sfaa-div1-interpretation.l4 (sections 130 and 131). Every expected value is written from the text, beside the assertion.
-- Dates: 2 November 2026 is a Monday.

§ `s 130(1)`
-- the section has effect for Division 1; it "does not affect the operation of any other provision": a provision outside Division 1 is a no
#ASSERT `s 130(1) section 130 has effect for the purposes of Division 1 and does not affect any other provision` TRUE EQUALS JUST TRUE
#ASSERT `s 130(1) section 130 has effect for the purposes of Division 1 and does not affect any other provision` FALSE EQUALS JUST FALSE

§ `s 130(2): a reference to a corporation`
-- paragraph (a): a company with any or all of its shares listed
#ASSERT `s 130(2)(a) the body is a company listed on an approved exchange` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 130(2)(a) the body is a company listed on an approved exchange` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 130(2)(a) the body is a company listed on an approved exchange` FALSE TRUE EQUALS JUST FALSE
-- paragraph (b): not a company, not a collective investment scheme constituted as a corporation, listed, and a primary listing
#ASSERT `s 130(2)(b) the body is a corporation other than a company with a primary listing` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 130(2)(b) the body is a corporation other than a company with a primary listing` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 130(2)(b) the body is a corporation other than a company with a primary listing` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 130(2)(b) the body is a corporation other than a company with a primary listing` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 130(2)(b) the body is a corporation other than a company with a primary listing` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
-- the combining function: either paragraph is enough; both no is the text's no; an unanswered limb is not a no
#ASSERT `s 130(2) the body is a corporation for the purposes of Division 1` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 130(2) the body is a corporation for the purposes of Division 1` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 130(2) the body is a corporation for the purposes of Division 1` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 130(2) the body is a corporation for the purposes of Division 1` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 130(2) the body is a corporation for the purposes of Division 1` NOTHING NOTHING EQUALS NOTHING

§ `s 130(3): stock`
#ASSERT `s 130(3) the person's interest in stock is deemed to be an interest in an issued share` TRUE TRUE EQUALS JUST TRUE
-- outside "In relation to a corporation the whole or a portion of the share capital of which consists of stock": not covered
#ASSERT `s 130(3) the person's interest in stock is deemed to be an interest in an issued share` FALSE TRUE EQUALS NOTHING
#ASSERT `s 130(3) the person's interest in stock is deemed to be an interest in an issued share` TRUE FALSE EQUALS NOTHING

§ `s 130(4): a member`
#ASSERT `s 130(4)(a) the person is a member of the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 130(4)(a) the person is a member of the company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 130(4)(a) the person is a member of the company` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 130(4)(b) the person is a member of a corporation other than a company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 130(4)(b) the person is a member of a corporation other than a company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 130(4)(b) the person is a member of a corporation other than a company` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 130(4) the person is a member of the corporation` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 130(4) the person is a member of the corporation` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 130(4) the person is a member of the corporation` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 130(4) the person is a member of the corporation` NOTHING (JUST FALSE) EQUALS NOTHING

§ `s 130(5): section 4 applies (the keel's function is called)`
-- a security, with authority to dispose of it (s 4(1)), not disregarded: an interest
#ASSERT `s 130(5) the person has an interest in the securities or securities-based derivatives contracts under Division 1` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- the same interest disregarded under s 4(10): no interest
#ASSERT `s 130(5) the person has an interest in the securities or securities-based derivatives contracts under Division 1` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
-- every route fails: the keel says no
#ASSERT `s 130(5) the person has an interest in the securities or securities-based derivatives contracts under Division 1` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- a route the caller could not answer stays "not covered"
#ASSERT `s 130(5) the person has an interest in the securities or securities-based derivatives contracts under Division 1` TRUE NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
-- the thing is not a security or a securities-based derivatives contract (a unit in a collective investment scheme, say): outside the wording of this Division
#ASSERT `s 130(5) the person has an interest in the securities or securities-based derivatives contracts under Division 1` FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING

§ `s 130(6): the conclusive presumption of awareness`
-- outside the five named provisions the presumption does not speak
#ASSERT `s 130(6) the person is conclusively presumed to have been aware of the fact or occurrence` FALSE (`s 130(6) an individual`) TRUE FALSE FALSE FALSE EQUALS NOTHING
-- (a): a person who would, with reasonable diligence, have been aware
#ASSERT `s 130(6) the person is conclusively presumed to have been aware of the fact or occurrence` TRUE (`s 130(6) an individual`) TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (b): a body corporate whose officer would have been aware
#ASSERT `s 130(6) the person is conclusively presumed to have been aware of the fact or occurrence` TRUE (`s 130(6) a body corporate or an unincorporated association other than a partnership`) FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- (c): a limited liability partnership whose partner or manager would have been aware
#ASSERT `s 130(6) the person is conclusively presumed to have been aware of the fact or occurrence` TRUE (`s 130(6) a limited liability partnership`) FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- (d): a partnership whose partner would have been aware
#ASSERT `s 130(6) the person is conclusively presumed to have been aware of the fact or occurrence` TRUE (`s 130(6) a partnership`) FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- the officer limb belongs to a body corporate only: for a partnership an officer's awareness is not a ground
#ASSERT `s 130(6) the person is conclusively presumed to have been aware of the fact or occurrence` TRUE (`s 130(6) a partnership`) FALSE TRUE FALSE FALSE EQUALS NOTHING
-- no ground at all: the presumption is silent (not "unaware")
#ASSERT `s 130(6) the person is conclusively presumed to have been aware of the fact or occurrence` TRUE (`s 130(6) an individual`) FALSE FALSE FALSE FALSE EQUALS NOTHING
-- the day from which the person is taken to be aware: the earlier of the two
#ASSERT `s 130(6) the day from which the person is taken to have been aware` (Date 10 11 2026) (Date 6 11 2026) EQUALS Date 6 11 2026
#ASSERT `s 130(6) the day from which the person is taken to have been aware` (Date 6 11 2026) (Date 10 11 2026) EQUALS Date 6 11 2026
#ASSERT `s 130(6) the day from which the person is taken to have been aware` (Date 6 11 2026) (Date 6 11 2026) EQUALS Date 6 11 2026

§ `s 130(7): officer and partner`
#ASSERT `s 130(7) "officer" (a) the person is an officer of a body corporate` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 130(7) "officer" (a) the person is an officer of a body corporate` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 130(7) "officer" (a) the person is an officer of a body corporate` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 130(7) "officer" (b) the person is an officer of an unincorporated association` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 130(7) "officer" (b) the person is an officer of an unincorporated association` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 130(7) "officer" (b) the person is an officer of an unincorporated association` FALSE FALSE EQUALS JUST FALSE
-- "includes" is an open word: a person who does not purport to act as a partner is not thereby excluded
#ASSERT `s 130(7) "partner" the person is a partner` TRUE EQUALS JUST TRUE
#ASSERT `s 130(7) "partner" the person is a partner` FALSE EQUALS NOTHING

§ `s 131: who must comply, exemption, extension`
#ASSERT `s 131(1) the obligation to comply with Division 1 extends to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 131(1) the obligation to comply with Division 1 extends to the person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 131(1) the obligation to comply with Division 1 extends to the person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 131(2) Division 1 extends to the act or omission` TRUE EQUALS JUST TRUE
#ASSERT `s 131(2) Division 1 extends to the act or omission` FALSE EQUALS NOTHING
#ASSERT `s 131(3) the person is exempt from the provision of Division 1` TRUE EQUALS JUST TRUE
#ASSERT `s 131(3) the person is exempt from the provision of Division 1` FALSE EQUALS NOTHING
#ASSERT `s 131(4) the exempted person must comply with the condition or restriction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 131(4) the exempted person must comply with the condition or restriction` TRUE FALSE EQUALS NOTHING
#ASSERT `s 131(4) the exempted person must comply with the condition or restriction` FALSE TRUE EQUALS NOTHING
-- s 131(5): the offence, and the split site (i) both ways
#ASSERT `s 131(5) the person is guilty of an offence of contravening a condition or restriction` TRUE EQUALS JUST TRUE
#ASSERT `s 131(5) the person is guilty of an offence of contravening a condition or restriction` FALSE EQUALS NOTHING
#ASSERT `s 131(5) the penalty on conviction` EQUALS Penalty OF 50000, 0, FALSE, 5000
-- s 131(6): the Authority's power on application (split site (ii)): applied, and not applied
#ASSERT `s 131(6) the Authority has power to extend, or further extend, the time for giving the notice` TRUE EQUALS JUST TRUE
#ASSERT `s 131(6) the Authority has power to extend, or further extend, the time for giving the notice` FALSE EQUALS NOTHING
-- the last day after an extension: the later day if the Authority has extended; the original otherwise
#ASSERT `s 131(6) the last day for giving the notice, as extended on the person's application` (Date 4 11 2026) TRUE (Date 11 11 2026) EQUALS Date 11 11 2026
#ASSERT `s 131(6) the last day for giving the notice, as extended on the person's application` (Date 4 11 2026) FALSE (Date 11 11 2026) EQUALS Date 4 11 2026
#ASSERT `s 131(6) the last day for giving the notice, as extended on the person's application` (Date 4 11 2026) TRUE (Date 2 11 2026) EQUALS Date 4 11 2026

§ `s 131(4) and (5): the prohibition as a regulative rule, and its breach path`
-- EXPECT BREACH
#TRACE `s 131(4) and (5) the exempted person shall not contravene a condition or restriction` AT 0 WITH
    PARTY Individual "the exempted person" DOES `s 131 contravene a condition or restriction imposed under subsection (4)` AT 1
-- EXPECT RESIDUAL
#TRACE `s 131(4) and (5) the exempted person shall not contravene a condition or restriction` AT 0 WITH
    (WAITUNTIL 5)
