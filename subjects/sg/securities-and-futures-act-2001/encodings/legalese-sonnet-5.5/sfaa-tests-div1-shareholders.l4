IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfaa-div1-shareholders`

-- Tests for sfaa-div1-shareholders.l4 (sections 135 to 137B). Every expected value is written from the text, beside the assertion.
-- Dates: 2 November 2026 is a Monday; 6 November 2026 is the public holiday in the examples that have one.


§ `s 135(1): who must give notice`
-- a substantial shareholder in a listed corporation: the duty
#ASSERT `s 135(1) the person must give the corporation written notice of particulars of the voting shares` TRUE TRUE FALSE EQUALS JUST TRUE
-- a person who had been one and has ceased to be one is still within it ("or (if the person has ceased to be one) had been")
#ASSERT `s 135(1) the person must give the corporation written notice of particulars of the voting shares` TRUE FALSE TRUE EQUALS JUST TRUE
-- never one: the subsection says nothing about this person
#ASSERT `s 135(1) the person must give the corporation written notice of particulars of the voting shares` TRUE FALSE FALSE EQUALS NOTHING
-- the body is not a corporation as section 130(2) reads the word
#ASSERT `s 135(1) the person must give the corporation written notice of particulars of the voting shares` FALSE TRUE FALSE EQUALS NOTHING

§ `s 135(2): form, time, and ceasing within the period`
#ASSERT `s 135(2)(a) the notice is in the form and contains the information the Authority prescribes` FALSE TRUE EQUALS NOTHING
#ASSERT `s 135(2)(a) the notice is in the form and contains the information the Authority prescribes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 135(2)(a) the notice is in the form and contains the information the Authority prescribes` TRUE FALSE EQUALS JUST FALSE
-- aware on Monday 2 Nov, diligence the same day: the last day is Wednesday 4 Nov
#ASSERT `s 135(2)(b) the last day for the notice` (Date 2 11 2026) (Date 2 11 2026) (LIST) EQUALS Date 4 11 2026
-- the day reasonable diligence would have given awareness is earlier (Friday 30 Oct): the count starts there, and ends Tuesday 3 Nov (s 130(6))
#ASSERT `s 135(2)(b) the last day for the notice` (Date 2 11 2026) (Date 30 10 2026) (LIST) EQUALS Date 3 11 2026
-- a public holiday on Friday 6 Nov inside the count: aware Wednesday 4 Nov, the last day is Monday 9 Nov
#ASSERT `s 135(2)(b) the last day for the notice` (Date 4 11 2026) (Date 4 11 2026) (LIST (Date 6 11 2026)) EQUALS Date 9 11 2026
-- on the last day: in time; the day after: not
#ASSERT `s 135(2)(b) the notice is given in time` (Date 2 11 2026) (Date 2 11 2026) (Date 4 11 2026) (LIST) EQUALS JUST TRUE
#ASSERT `s 135(2)(b) the notice is given in time` (Date 2 11 2026) (Date 2 11 2026) (Date 5 11 2026) (LIST) EQUALS JUST FALSE
-- on the day the person becomes aware: in time (fork register A3)
#ASSERT `s 135(2)(b) the notice is given in time` (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (LIST) EQUALS JUST TRUE
-- the person ceased before the period ended: the notice must still be given; if not ceased, paragraph (b) alone applies and this paragraph says nothing
#ASSERT `s 135(2)(c) the notice must be given although the person has ceased to be a substantial shareholder within the period` TRUE EQUALS JUST TRUE
#ASSERT `s 135(2)(c) the notice must be given although the person has ceased to be a substantial shareholder within the period` FALSE EQUALS NOTHING

§ `s 135: the rule and its breach path`
-- EXPECT FULFILLED
#TRACE `s 135(1) and (2)(b) the substantial shareholder must give written notice within 2 business days` (Individual "the substantial shareholder") AT 0 WITH
    PARTY Individual "the substantial shareholder" DOES `s 135 give the corporation written notice` AT 2
-- EXPECT BREACH
#TRACE `s 135(1) and (2)(b) the substantial shareholder must give written notice within 2 business days` (Individual "the substantial shareholder") AT 0 WITH
    PARTY Individual "the substantial shareholder" DOES `s 135 give the corporation written notice` AT 3
-- EXPECT BREACH
#TRACE `s 135(1) and (2)(b) the substantial shareholder must give written notice within 2 business days` (Individual "the substantial shareholder") AT 0 WITH
    (WAITUNTIL 5)

§ `s 136(3): the percentage level`
-- 129 votes out of 1,000 is 12.9 per cent, rounded down to 12
#ASSERT `s 136(3) the percentage level of the substantial shareholder's interests` 129 FALSE 1000 0 EQUALS 12
-- a whole number is kept: 150 of 1,000 is 15
#ASSERT `s 136(3) the percentage level of the substantial shareholder's interests` 150 FALSE 1000 0 EQUALS 15
-- two classes of shares: the votes of the class concerned are the denominator; 129 of 500 is 25.8, rounded down to 25
#ASSERT `s 136(3) the percentage level of the substantial shareholder's interests` 129 TRUE 1000 500 EQUALS 25
-- no votes in the denominator: nought rather than a division by nought
#ASSERT `s 136(3) the percentage level of the substantial shareholder's interests` 5 FALSE 0 0 EQUALS 0
#ASSERT `s 136(3) the percentage level of the substantial shareholder's interests` 5 TRUE 100 0 EQUALS 0

§ `s 136(1): a change in the percentage level`
-- a change from 14 to 16 per cent: the substantial shareholder must give notice
#ASSERT `s 136(1) the substantial shareholder must give the corporation written notice of the change in the percentage level` TRUE TRUE 14 16 EQUALS JUST TRUE
-- no change in the level: "Where there is a change" is not met, so the text's no (periods ruling of 2026-11-05, (b))
#ASSERT `s 136(1) the substantial shareholder must give the corporation written notice of the change in the percentage level` TRUE TRUE 15 15 EQUALS JUST FALSE
-- not a substantial shareholder: the subsection speaks to a substantial shareholder
#ASSERT `s 136(1) the substantial shareholder must give the corporation written notice of the change in the percentage level` TRUE FALSE 14 16 EQUALS NOTHING
#ASSERT `s 136(1) the substantial shareholder must give the corporation written notice of the change in the percentage level` FALSE TRUE 14 16 EQUALS NOTHING
#ASSERT `s 136(1) the last day for the notice` (Date 2 11 2026) (Date 2 11 2026) (LIST) EQUALS Date 4 11 2026
#ASSERT `s 136(1) the notice is given in time` (Date 2 11 2026) (Date 2 11 2026) (Date 4 11 2026) (LIST) EQUALS JUST TRUE
#ASSERT `s 136(1) the notice is given in time` (Date 2 11 2026) (Date 2 11 2026) (Date 5 11 2026) (LIST) EQUALS JUST FALSE
#ASSERT `s 136(2) the notice is in the form and contains the information the Authority prescribes` FALSE TRUE EQUALS NOTHING
#ASSERT `s 136(2) the notice is in the form and contains the information the Authority prescribes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 136(2) the notice is in the form and contains the information the Authority prescribes` TRUE FALSE EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 136(1) the substantial shareholder must give written notice of the change within 2 business days` (Individual "the substantial shareholder") AT 0 WITH
    PARTY Individual "the substantial shareholder" DOES `s 136 give the corporation written notice of the change` AT 1
-- EXPECT BREACH
#TRACE `s 136(1) the substantial shareholder must give written notice of the change within 2 business days` (Individual "the substantial shareholder") AT 0 WITH
    (WAITUNTIL 5)

§ `s 137(1): ceasing to be a substantial shareholder`
#ASSERT `s 137(1) the person who ceases to be a substantial shareholder must give the corporation written notice` TRUE TRUE EQUALS JUST TRUE
-- a person who does not cease: outside the sentence
#ASSERT `s 137(1) the person who ceases to be a substantial shareholder must give the corporation written notice` TRUE FALSE EQUALS NOTHING
#ASSERT `s 137(1) the person who ceases to be a substantial shareholder must give the corporation written notice` FALSE TRUE EQUALS NOTHING
#ASSERT `s 137(1) the last day for the notice` (Date 2 11 2026) (Date 2 11 2026) (LIST) EQUALS Date 4 11 2026
#ASSERT `s 137(1) the notice is given in time` (Date 2 11 2026) (Date 2 11 2026) (Date 4 11 2026) (LIST) EQUALS JUST TRUE
#ASSERT `s 137(1) the notice is given in time` (Date 2 11 2026) (Date 2 11 2026) (Date 5 11 2026) (LIST) EQUALS JUST FALSE
#ASSERT `s 137(2) the notice is in the form and contains the information the Authority prescribes` FALSE TRUE EQUALS NOTHING
#ASSERT `s 137(2) the notice is in the form and contains the information the Authority prescribes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137(2) the notice is in the form and contains the information the Authority prescribes` TRUE FALSE EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 137(1) the person who ceases to be a substantial shareholder must give written notice within 2 business days` (Individual "the former substantial shareholder") AT 0 WITH
    PARTY Individual "the former substantial shareholder" DOES `s 137 give the corporation written notice of ceasing` AT 2
-- EXPECT BREACH
#TRACE `s 137(1) the person who ceases to be a substantial shareholder must give written notice within 2 business days` (Individual "the former substantial shareholder") AT 0 WITH
    (WAITUNTIL 5)

§ `s 137A: the beneficial owner and the person who acts on the owner's behalf`
-- authorised another person, who has effected an acquisition or disposal: the duty to take reasonable steps
#ASSERT `s 137A the person must take reasonable steps to ensure that the other person notifies the person` TRUE TRUE EQUALS JUST TRUE
-- authorised, nothing effected yet: not covered
#ASSERT `s 137A the person must take reasonable steps to ensure that the other person notifies the person` TRUE FALSE EQUALS NOTHING
-- never authorised anyone: "Where a person (A) authorises another person (B)" is not met, so the text's no
#ASSERT `s 137A the person must take reasonable steps to ensure that the other person notifies the person` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 137A the person has taken reasonable steps` TRUE EQUALS JUST TRUE
#ASSERT `s 137A the person has taken reasonable steps` FALSE EQUALS JUST FALSE
-- effected Monday 2 Nov: the last day for the notice is Wednesday 4 Nov
#ASSERT `s 137A the last day for the notice` (Date 2 11 2026) (LIST) EQUALS Date 4 11 2026
-- a holiday on Wednesday 4 Nov moves it to Thursday 5 Nov
#ASSERT `s 137A the last day for the notice` (Date 2 11 2026) (LIST (Date 4 11 2026)) EQUALS Date 5 11 2026
#ASSERT `s 137A the notice is given in time` (Date 2 11 2026) (Date 4 11 2026) (LIST) EQUALS JUST TRUE
#ASSERT `s 137A the notice is given in time` (Date 2 11 2026) (Date 5 11 2026) (LIST) EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 137A the beneficial owner must take reasonable steps within 2 business days of the acquisition or disposal` (Individual "the beneficial owner") AT 0 WITH
    PARTY Individual "the beneficial owner" DOES `s 137A take reasonable steps so that the other person notifies the person` AT 2
-- EXPECT BREACH
#TRACE `s 137A the beneficial owner must take reasonable steps within 2 business days of the acquisition or disposal` (Individual "the beneficial owner") AT 0 WITH
    (WAITUNTIL 5)

§ `s 137B: the holder who acquires or disposes for the benefit of another person`
-- holds voting shares in which another person has an interest, and has acquired or disposed of some: the duty to give that person notice
#ASSERT `s 137B the person must give the other person a notice of the acquisition or disposal` TRUE TRUE EQUALS JUST TRUE
-- holds, nothing acquired or disposed of: not covered
#ASSERT `s 137B the person must give the other person a notice of the acquisition or disposal` TRUE FALSE EQUALS NOTHING
-- holds no shares in which another has an interest: "Where" is not met, the text's no
#ASSERT `s 137B the person must give the other person a notice of the acquisition or disposal` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 137B the last day for the notice` (Date 2 11 2026) (LIST) EQUALS Date 4 11 2026
#ASSERT `s 137B the notice is given in time` (Date 2 11 2026) (Date 4 11 2026) (LIST) EQUALS JUST TRUE
#ASSERT `s 137B the notice is given in time` (Date 2 11 2026) (Date 5 11 2026) (LIST) EQUALS JUST FALSE
#ASSERT `s 137B the notice is in the form the Authority prescribes` FALSE TRUE EQUALS NOTHING
#ASSERT `s 137B the notice is in the form the Authority prescribes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137B the notice is in the form the Authority prescribes` TRUE FALSE EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 137B the holder must give the other person notice within 2 business days` (Individual "the holder") AT 0 WITH
    PARTY Individual "the holder" DOES `s 137B give the other person a notice of the acquisition or disposal` AT 2
-- EXPECT BREACH
#TRACE `s 137B the holder must give the other person notice within 2 business days` (Individual "the holder") AT 0 WITH
    (WAITUNTIL 5)
