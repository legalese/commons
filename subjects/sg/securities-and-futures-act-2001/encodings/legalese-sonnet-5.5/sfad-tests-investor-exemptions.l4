-- MODULES sfad-investor-exemptions
IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-periods`
IMPORT `sfad-nocons-small-private`
IMPORT `sfad-investor-exemptions`

-- Tests for sfad-investor-exemptions.l4 (Securities and Futures Act 2001, ss 274, 275 and 276).
-- Every expected value is written from the text, beside the assertion; none is copied from the module's output.
-- Inputs are positional, in the order of the GIVEN of the function under test.

§ `s 274: offers to institutional investors`

-- arguments: an offer of securities or contracts; the answer of section 4A(1) for the buyer asked about an institutional investor
#ASSERT (`s 274 the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 274 the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 274 the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE NOTHING) EQUALS NOTHING
#ASSERT (`s 274 the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` FALSE (JUST TRUE)) EQUALS NOTHING

§ `s 275(2) and (2A): definitions`

-- information memorandum: (a)(i) describes the securities or (a)(ii) describes the business and affairs, AND (b) prepared for relevant persons to assist an investment decision
#ASSERT (`s 275(2) the document is an information memorandum` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 275(2) the document is an information memorandum` FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 275(2) the document is an information memorandum` FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 275(2) the document is an information memorandum` TRUE TRUE FALSE) EQUALS JUST FALSE
-- advertisement: arguments: written, radio or telephone; published in connection with an offer; an information memorandum; a required disclosure; a general-meeting publication
#ASSERT (`s 275(2) the communication is an advertisement` TRUE TRUE (JUST FALSE) FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 275(2) the communication is an advertisement` TRUE TRUE (JUST TRUE) FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 275(2) the communication is an advertisement` TRUE TRUE NOTHING FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 275(2) the communication is an advertisement` TRUE TRUE NOTHING TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 275(2) the communication is an advertisement` TRUE TRUE (JUST FALSE) FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 275(2) the communication is an advertisement` FALSE TRUE (JUST FALSE) FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 275(2) the communication is an advertisement` TRUE FALSE (JUST FALSE) FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 275(2A) the matter is included in the affairs of the person making the offer, the issuer, the underlying entity, the trustee-manager or the business trust` TRUE (JUST TRUE) FALSE) EQUALS JUST TRUE
#ASSERT (`s 275(2A) the matter is included in the affairs of the person making the offer, the issuer, the underlying entity, the trustee-manager or the business trust` TRUE NOTHING FALSE) EQUALS NOTHING
#ASSERT (`s 275(2A) the matter is included in the affairs of the person making the offer, the issuer, the underlying entity, the trustee-manager or the business trust` FALSE NOTHING TRUE) EQUALS JUST TRUE
#ASSERT (`s 275(2A) the matter is included in the affairs of the person making the offer, the issuer, the underlying entity, the trustee-manager or the business trust` FALSE (JUST TRUE) FALSE) EQUALS NOTHING
-- relevant person: arguments: (a) the keel's answer for an accredited investor; (b) a corporation of sole investment business; its share capital owned by accredited individuals; (c) a trustee of a trust of sole investment purpose; each beneficiary an accredited individual; (d); (e)
#ASSERT (`s 275(2) the person is a relevant person` (JUST TRUE) FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 275(2) the person is a relevant person` (JUST FALSE) TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 275(2) the person is a relevant person` (JUST FALSE) TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 275(2) the person is a relevant person` (JUST FALSE) FALSE FALSE TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 275(2) the person is a relevant person` (JUST FALSE) FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 275(2) the person is a relevant person` (JUST FALSE) FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 275(2) the person is a relevant person` (JUST FALSE) FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 275(2) the person is a relevant person` (JUST FALSE) FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 275(2) the person is a relevant person` NOTHING FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 275(2) the person is a relevant person` NOTHING FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE

§ `s 275(1): offers to relevant persons`

#ASSERT (`s 275(1)(a) the offer is not accompanied by an advertisement` FALSE) EQUALS JUST TRUE
#ASSERT (`s 275(1)(a) the offer is not accompanied by an advertisement` TRUE) EQUALS JUST FALSE
#ASSERT (`s 275(1)(b) no selling or promotional expenses are paid or incurred other than those the paragraph allows` EMPTY) EQUALS JUST TRUE
#ASSERT (`s 275(1)(b) no selling or promotional expenses are paid or incurred other than those the paragraph allows` (LIST `s 272A(1)(d) an expense incurred for administrative or professional services`, `s 272A(1)(d)(ii) a commission or fee for services rendered by an exempt person in respect of dealing in capital markets products that are securities or securities-based derivatives contracts`)) EQUALS JUST TRUE
#ASSERT (`s 275(1)(b) no selling or promotional expenses are paid or incurred other than those the paragraph allows` (LIST `s 272A(1)(d) any other selling or promotional expense`)) EQUALS JUST FALSE
-- (c): arguments: a prospectus has been registered; it has expired; the Authority was informed; reasonable steps to inform the offeree
#ASSERT (`s 275(1)(c) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 275(1)(c) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 275(1)(c) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 275(1)(c) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 275(1)(c) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 275(1)(c) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (1): arguments: an offer of securities or contracts; the person is a relevant person; (a); (b); (c)
#ASSERT (`s 275(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 275(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 275(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` FALSE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 275(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 275(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 275(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 275(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 275(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE)) EQUALS NOTHING

§ `s 275(1A), (3), (4): offers at $200,000 or more, and the exempt-person rule`

-- (4) the Authority may specify another amount
#ASSERT (`s 275(4) the amount that applies in place of $200,000` FALSE 0) EQUALS 200000
#ASSERT (`s 275(4) the amount that applies in place of $200,000` TRUE 300000) EQUALS 300000
-- (1A)(a): "not less than $200,000": exactly $200,000 is enough, one dollar less is not; a substituted amount replaces it
#ASSERT (`s 275(1A)(a) the offer is on terms that the securities or contracts may only be acquired at a consideration of not less than the amount for each transaction` 200000 FALSE 0) EQUALS JUST TRUE
#ASSERT (`s 275(1A)(a) the offer is on terms that the securities or contracts may only be acquired at a consideration of not less than the amount for each transaction` 199999 FALSE 0) EQUALS JUST FALSE
#ASSERT (`s 275(1A)(a) the offer is on terms that the securities or contracts may only be acquired at a consideration of not less than the amount for each transaction` 250000 TRUE 300000) EQUALS JUST FALSE
#ASSERT (`s 275(1A)(a) the offer is on terms that the securities or contracts may only be acquired at a consideration of not less than the amount for each transaction` 300000 TRUE 300000) EQUALS JUST TRUE
#ASSERT (`s 275(1A)(a) the offer is on terms that the securities or contracts may only be acquired at a consideration of not less than the amount for each transaction` 150000 TRUE 100000) EQUALS JUST TRUE
#ASSERT (`s 275(1A)(b) the offer is not accompanied by an advertisement` FALSE) EQUALS JUST TRUE
#ASSERT (`s 275(1A)(b) the offer is not accompanied by an advertisement` TRUE) EQUALS JUST FALSE
#ASSERT (`s 275(1A)(c) no selling or promotional expenses are paid or incurred other than those the paragraph allows` EMPTY) EQUALS JUST TRUE
#ASSERT (`s 275(1A)(c) no selling or promotional expenses are paid or incurred other than those the paragraph allows` (LIST `s 272A(1)(d) any other selling or promotional expense`)) EQUALS JUST FALSE
#ASSERT (`s 275(1A)(d) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 275(1A)(d) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 275(1A)(d) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
-- (1A): arguments: an offer of securities or contracts; the person acquires as principal; (a); (b); (c); (d)
#ASSERT (`s 275(1A) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 275(1A) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE FALSE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 275(1A) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE TRUE (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 275(1A) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE TRUE (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 275(1A) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE TRUE (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 275(1A) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 275(1A) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE TRUE (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 275(3) the person is treated as an exempt person` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 275(3) the person is treated as an exempt person` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 275(3) the person is treated as an exempt person` FALSE TRUE) EQUALS NOTHING

§ `s 276: offer of securities acquired pursuant to section 274 or 275`

-- (7): arguments: of a corporation and the same class; units of the same class; the others are listed; a document earlier issued
#ASSERT (`s 276(7) subsections (1), (3) and (4) do not apply to the securities or contracts acquired` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 276(7) subsections (1), (3) and (4) do not apply to the securities or contracts acquired` FALSE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 276(7) subsections (1), (3) and (4) do not apply to the securities or contracts acquired` TRUE FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 276(7) subsections (1), (3) and (4) do not apply to the securities or contracts acquired` TRUE FALSE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 276(7) subsections (1), (3) and (4) do not apply to the securities or contracts acquired` FALSE FALSE TRUE TRUE) EQUALS NOTHING
-- (1A): the sale of converted securities
#ASSERT (`s 276(1A) the sale of the converted securities is a sale for subsection (1)` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 276(1A) the sale of the converted securities is a sale for subsection (1)` FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 276(1A) the sale of the converted securities is a sale for subsection (1)` TRUE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 276(1A) the sale of the converted securities is a sale for subsection (1)` FALSE FALSE FALSE FALSE) EQUALS NOTHING
-- (1): acquired on 1 January 2025; the 6 months end on 1 July 2025.
-- arguments: initially acquired under section 274 or 275; sold; the day of acquisition; the day of the sale; the buyer is an institutional investor; the buyer is a relevant person; the sale is under an offer of section 275(1A); (7)
#ASSERT (`s 276(1) Subdivisions (1A), (2) and (3) of this Division apply to the offer resulting in the sale` TRUE TRUE (Date 1 1 2025) (Date 1 7 2025) (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 276(1) Subdivisions (1A), (2) and (3) of this Division apply to the offer resulting in the sale` TRUE TRUE (Date 1 1 2025) (Date 2 7 2025) (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(1) Subdivisions (1A), (2) and (3) of this Division apply to the offer resulting in the sale` TRUE TRUE (Date 1 1 2025) (Date 31 12 2024) (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(1) Subdivisions (1A), (2) and (3) of this Division apply to the offer resulting in the sale` TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) (JUST TRUE) (JUST FALSE) FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(1) Subdivisions (1A), (2) and (3) of this Division apply to the offer resulting in the sale` TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) (JUST FALSE) (JUST TRUE) FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(1) Subdivisions (1A), (2) and (3) of this Division apply to the offer resulting in the sale` TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) (JUST FALSE) (JUST FALSE) TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(1) Subdivisions (1A), (2) and (3) of this Division apply to the offer resulting in the sale` TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) (JUST FALSE) (JUST FALSE) FALSE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 276(1) Subdivisions (1A), (2) and (3) of this Division apply to the offer resulting in the sale` FALSE TRUE (Date 1 1 2025) (Date 1 3 2025) (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 276(1) Subdivisions (1A), (2) and (3) of this Division apply to the offer resulting in the sale` TRUE FALSE (Date 1 1 2025) (Date 1 3 2025) (JUST FALSE) (JUST FALSE) FALSE (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 276(1) Subdivisions (1A), (2) and (3) of this Division apply to the offer resulting in the sale` TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) NOTHING (JUST FALSE) FALSE (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 276(1) Subdivisions (1A), (2) and (3) of this Division apply to the offer resulting in the sale` TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) (JUST FALSE) (JUST FALSE) FALSE NOTHING) EQUALS NOTHING
-- (2): arguments: initially acquired under section 274 or 275; buyer institutional; buyer relevant; section 275(1A) offer
#ASSERT (`s 276(2) Subdivisions (1A), (2) and (3) of this Division do not apply to the offer resulting in the sale` TRUE (JUST TRUE) (JUST FALSE) FALSE) EQUALS JUST TRUE
#ASSERT (`s 276(2) Subdivisions (1A), (2) and (3) of this Division do not apply to the offer resulting in the sale` TRUE (JUST FALSE) (JUST TRUE) FALSE) EQUALS JUST TRUE
#ASSERT (`s 276(2) Subdivisions (1A), (2) and (3) of this Division do not apply to the offer resulting in the sale` TRUE (JUST FALSE) (JUST FALSE) TRUE) EQUALS JUST TRUE
#ASSERT (`s 276(2) Subdivisions (1A), (2) and (3) of this Division do not apply to the offer resulting in the sale` TRUE (JUST FALSE) (JUST FALSE) FALSE) EQUALS NOTHING
#ASSERT (`s 276(2) Subdivisions (1A), (2) and (3) of this Division do not apply to the offer resulting in the sale` FALSE (JUST TRUE) (JUST FALSE) FALSE) EQUALS NOTHING
-- (3): arguments: a corporation (not an accredited investor) of sole investment business; its share capital owned by accredited individuals; acquired under section 275; the day acquired; the day of the transfer; exception (c); exception (d); exception (e); (7)
#ASSERT (`s 276(3) the transfer of the securities or contracts of the investment-holding corporation is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 1 7 2025) FALSE FALSE FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 276(3) the transfer of the securities or contracts of the investment-holding corporation is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 2 7 2025) FALSE FALSE FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(3) the transfer of the securities or contracts of the investment-holding corporation is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) TRUE FALSE FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(3) the transfer of the securities or contracts of the investment-holding corporation is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) FALSE TRUE FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(3) the transfer of the securities or contracts of the investment-holding corporation is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) FALSE FALSE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(3) the transfer of the securities or contracts of the investment-holding corporation is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) FALSE FALSE FALSE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 276(3) the transfer of the securities or contracts of the investment-holding corporation is barred` FALSE TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) FALSE FALSE FALSE (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 276(3) the transfer of the securities or contracts of the investment-holding corporation is barred` TRUE FALSE TRUE (Date 1 1 2025) (Date 1 3 2025) FALSE FALSE FALSE (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 276(3) the transfer of the securities or contracts of the investment-holding corporation is barred` TRUE TRUE FALSE (Date 1 1 2025) (Date 1 3 2025) FALSE FALSE FALSE (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 276(3) the transfer of the securities or contracts of the investment-holding corporation is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) FALSE FALSE FALSE NOTHING) EQUALS NOTHING
-- (4): arguments: a trust (trustee not an accredited investor) of sole investment purpose; each beneficiary an accredited individual; acquired under section 275; the day acquired; the day of the transfer; (c)(i); (c)(ii); (d); (e); (7)
#ASSERT (`s 276(4) the transfer of the beneficiaries' rights and interest in the trust is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 1 7 2025) FALSE FALSE FALSE FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 276(4) the transfer of the beneficiaries' rights and interest in the trust is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 2 7 2025) FALSE FALSE FALSE FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(4) the transfer of the beneficiaries' rights and interest in the trust is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) TRUE FALSE FALSE FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(4) the transfer of the beneficiaries' rights and interest in the trust is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) FALSE TRUE FALSE FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(4) the transfer of the beneficiaries' rights and interest in the trust is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) FALSE FALSE TRUE FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(4) the transfer of the beneficiaries' rights and interest in the trust is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) FALSE FALSE FALSE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 276(4) the transfer of the beneficiaries' rights and interest in the trust is barred` TRUE TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) FALSE FALSE FALSE FALSE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 276(4) the transfer of the beneficiaries' rights and interest in the trust is barred` FALSE TRUE TRUE (Date 1 1 2025) (Date 1 3 2025) FALSE FALSE FALSE FALSE (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 276(4) the transfer of the beneficiaries' rights and interest in the trust is barred` TRUE FALSE TRUE (Date 1 1 2025) (Date 1 3 2025) FALSE FALSE FALSE FALSE (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 276(5) the person is a beneficiary for subsection (4)` TRUE) EQUALS JUST TRUE
#ASSERT (`s 276(5) the person is a beneficiary for subsection (4)` FALSE) EQUALS NOTHING
-- (6): the offer to sell is made after the 6 months have elapsed from 1 January 2025: 2 July 2025 is the first such day
#ASSERT (`s 276(6) an offer to sell may be made in reliance on section 273(1)(d), (da), (e) or (ea)` TRUE (Date 1 1 2025) (Date 2 7 2025)) EQUALS JUST TRUE
#ASSERT (`s 276(6) an offer to sell may be made in reliance on section 273(1)(d), (da), (e) or (ea)` TRUE (Date 1 1 2025) (Date 1 7 2025)) EQUALS JUST FALSE
#ASSERT (`s 276(6) an offer to sell may be made in reliance on section 273(1)(d), (da), (e) or (ea)` FALSE (Date 1 1 2025) (Date 2 7 2025)) EQUALS NOTHING
