#ASSERT (`s 252(2) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 0
#ASSERT (`s 252(2) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS FALSE
