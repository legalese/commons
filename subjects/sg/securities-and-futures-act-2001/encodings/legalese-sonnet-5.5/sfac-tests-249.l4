IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfac-249`

-- Tests for sfac-249.l4 (ss 249, 249A, 250, 251, 252). Every expected value is written from the text of the Act (SFA2001.txt lines 40240 to 40969) before the code was run.
-- The arguments of a call are in the order of the function's GIVEN; a comment above a group names them.

§ `s 249(1): the expert's consent`
-- arguments: offer made in or with a prospectus; it includes an expert's statement; the exemption of subsection (3) (MAYBE); consent given and not withdrawn; the statement of consent appears
#ASSERT (`s 249(1) the prospectus or profile statement must not be issued` TRUE TRUE NOTHING FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 249(1) the prospectus or profile statement must not be issued` TRUE TRUE NOTHING TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 249(1) the prospectus or profile statement must not be issued` TRUE TRUE NOTHING FALSE TRUE) EQUALS JUST TRUE
-- both limbs of the "unless" are met: the text says the prospectus may be issued
#ASSERT (`s 249(1) the prospectus or profile statement must not be issued` TRUE TRUE NOTHING TRUE TRUE) EQUALS JUST FALSE
-- the "Where" gate fails (periods ruling, rule (b))
#ASSERT (`s 249(1) the prospectus or profile statement must not be issued` FALSE TRUE NOTHING FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 249(1) the prospectus or profile statement must not be issued` TRUE FALSE NOTHING FALSE FALSE) EQUALS JUST FALSE
-- exempt under subsection (3): only an answer JUST TRUE counts
#ASSERT (`s 249(1) the prospectus or profile statement must not be issued` TRUE TRUE (JUST TRUE) FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 249(1) the prospectus or profile statement must not be issued` TRUE TRUE (JUST FALSE) FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 249(1) the prospectus or profile statement must not be issued` TRUE TRUE (JUST FALSE) TRUE TRUE) EQUALS JUST FALSE
-- the bar as a rule

-- EXPECT BREACH: the bar bites and the person issues
#TRACE (`s 249(1) the person shall not issue the prospectus or profile statement` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 249(1) issue the prospectus or profile statement without the expert's consent` AT 2

-- EXPECT RESIDUAL: the bar bites and nothing is issued yet
#TRACE (`s 249(1) the person shall not issue the prospectus or profile statement` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH

-- EXPECT FULFILLED: the bar does not bite
#TRACE (`s 249(1) the person shall not issue the prospectus or profile statement` (`An offeror` "Acme Pte Ltd") (JUST FALSE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 249(1) issue the prospectus or profile statement without the expert's consent` AT 2

§ `s 249(1A) and (1B): depositing and keeping the consents`
-- s 249(1A) arguments: a consent has been given; the date of registration (Monday 2 March 2026); the issuer has a registered office in Singapore; copy at the registered office; copy at the address in the prospectus; the date deposited
-- the seventh day after registration is in time (fork F9)
#ASSERT (`s 249(1A) the person making the offer has deposited the copies of the consents` TRUE (Date 2 3 2026) TRUE TRUE FALSE (Date 9 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 249(1A) the person making the offer has deposited the copies of the consents` TRUE (Date 2 3 2026) TRUE TRUE FALSE (Date 2 3 2026)) EQUALS JUST TRUE
-- one day late
#ASSERT (`s 249(1A) the person making the offer has deposited the copies of the consents` TRUE (Date 2 3 2026) TRUE TRUE FALSE (Date 10 3 2026)) EQUALS JUST FALSE
-- the issuer has a registered office, so the address elsewhere does not do
#ASSERT (`s 249(1A) the person making the offer has deposited the copies of the consents` TRUE (Date 2 3 2026) TRUE FALSE TRUE (Date 5 3 2026)) EQUALS JUST FALSE
-- no registered office in Singapore: the address in the prospectus
#ASSERT (`s 249(1A) the person making the offer has deposited the copies of the consents` TRUE (Date 2 3 2026) FALSE FALSE TRUE (Date 5 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 249(1A) the person making the offer has deposited the copies of the consents` TRUE (Date 2 3 2026) FALSE TRUE FALSE (Date 5 3 2026)) EQUALS JUST FALSE
-- no consent was given: the duty is limited by its own wording
#ASSERT (`s 249(1A) the person making the offer has deposited the copies of the consents` FALSE (Date 2 3 2026) TRUE TRUE FALSE (Date 5 3 2026)) EQUALS NOTHING
-- s 249(1B) arguments: deposited under (1A); the date of registration; the issuer keeps a copy; makes it available free; the date until which it keeps the copy
-- six months after 2 March 2026 is 2 September 2026
#ASSERT (`s 249(1B) the issuer has kept the copies and made them available` TRUE (Date 2 3 2026) TRUE TRUE (Date 2 9 2026)) EQUALS JUST TRUE
#ASSERT (`s 249(1B) the issuer has kept the copies and made them available` TRUE (Date 2 3 2026) TRUE TRUE (Date 1 9 2026)) EQUALS JUST FALSE
#ASSERT (`s 249(1B) the issuer has kept the copies and made them available` TRUE (Date 2 3 2026) FALSE TRUE (Date 2 9 2026)) EQUALS JUST FALSE
#ASSERT (`s 249(1B) the issuer has kept the copies and made them available` TRUE (Date 2 3 2026) TRUE FALSE (Date 2 9 2026)) EQUALS JUST FALSE
#ASSERT (`s 249(1B) the issuer has kept the copies and made them available` FALSE (Date 2 3 2026) TRUE TRUE (Date 2 9 2026)) EQUALS NOTHING

§ `s 249(2): the offence`
-- arguments: what s 249(1) answers (MAYBE); the prospectus is issued; the person is the person making the offer; the person is knowingly a party
#ASSERT (`s 249(2) the person is guilty of an offence` (JUST TRUE) TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 249(2) the person is guilty of an offence` (JUST TRUE) TRUE FALSE TRUE) EQUALS JUST TRUE
-- the text names two kinds of person and says nothing of others (SPLIT-SITE (i))
#ASSERT (`s 249(2) the person is guilty of an offence` (JUST TRUE) TRUE FALSE FALSE) EQUALS NOTHING
-- not issued in contravention: the "If" fails (SPLIT-SITE (i), MARGINAL-READING (a))
#ASSERT (`s 249(2) the person is guilty of an offence` (JUST FALSE) TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 249(2) the person is guilty of an offence` (JUST TRUE) FALSE TRUE TRUE) EQUALS JUST FALSE
-- the answer under subsection (1) was not worked out
#ASSERT (`s 249(2) the person is guilty of an offence` NOTHING TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 249(2) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 50000
#ASSERT (`s 249(2) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 12
#ASSERT (`s 249(2) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS TRUE
#ASSERT (`s 249(2) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 5000

§ `s 249(3) and (4): the exemption and its conditions`
#ASSERT (`s 249(3) the person or document is exempt from the section` TRUE) EQUALS JUST TRUE
#ASSERT (`s 249(3) the person or document is exempt from the section` FALSE) EQUALS NOTHING
#ASSERT (`s 249(4) the person is guilty of an offence` TRUE) EQUALS JUST TRUE
#ASSERT (`s 249(4) the person is guilty of an offence` FALSE) EQUALS NOTHING
#ASSERT (`s 249(4) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 50000
#ASSERT (`s 249(4) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 0
#ASSERT (`s 249(4) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS FALSE
#ASSERT (`s 249(4) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 5000

-- EXPECT BREACH: a condition is in force and the person contravenes it
#TRACE (`s 249(4) the person shall not contravene a condition or restriction` (`An offeror` "Acme Pte Ltd") TRUE) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 249(4) contravene the condition or restriction` AT 3

-- EXPECT FULFILLED: no condition is in force
#TRACE (`s 249(4) the person shall not contravene a condition or restriction` (`An offeror` "Acme Pte Ltd") FALSE) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 249(4) contravene the condition or restriction` AT 3

§ `s 249A(1) and (2): the consent of an issue manager or an underwriter`
-- arguments: offer made in or with a prospectus; it names the person; consent given and not withdrawn; the statement of consent appears
#ASSERT (`s 249A(1) the prospectus or profile statement must not be issued` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 249A(1) the prospectus or profile statement must not be issued` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 249A(1) the prospectus or profile statement must not be issued` TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- the issue manager has consented and the prospectus says so
#ASSERT (`s 249A(1) the prospectus or profile statement must not be issued` TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
-- the "Where" gate fails
#ASSERT (`s 249A(1) the prospectus or profile statement must not be issued` FALSE TRUE FALSE FALSE) EQUALS JUST FALSE
-- no issue manager is named
#ASSERT (`s 249A(1) the prospectus or profile statement must not be issued` TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 249A(2) the prospectus or profile statement must not be issued` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 249A(2) the prospectus or profile statement must not be issued` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 249A(2) the prospectus or profile statement must not be issued` TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- the underwriter has consented and the prospectus says so
#ASSERT (`s 249A(2) the prospectus or profile statement must not be issued` TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
-- the "Where" gate fails
#ASSERT (`s 249A(2) the prospectus or profile statement must not be issued` FALSE TRUE FALSE FALSE) EQUALS JUST FALSE
-- no underwriter is named
#ASSERT (`s 249A(2) the prospectus or profile statement must not be issued` TRUE FALSE FALSE FALSE) EQUALS JUST FALSE

-- EXPECT BREACH: the bar bites and the person issues
#TRACE (`s 249A(1) the person shall not issue the prospectus or profile statement` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 249A(1) issue the prospectus or profile statement without the issue manager's consent` AT 2

-- EXPECT BREACH: the bar bites and the person issues
#TRACE (`s 249A(2) the person shall not issue the prospectus or profile statement` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 249A(2) issue the prospectus or profile statement without the underwriter's consent` AT 2

-- EXPECT RESIDUAL: the bar bites and nothing is issued yet
#TRACE (`s 249A(2) the person shall not issue the prospectus or profile statement` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH

§ `s 249A(3): the offence`
-- arguments: what s 249A(1) answers; what s 249A(2) answers; the prospectus is issued; the person is the person making the offer; the person is knowingly a party
#ASSERT (`s 249A(3) the person is guilty of an offence` (JUST TRUE) (JUST FALSE) TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 249A(3) the person is guilty of an offence` (JUST FALSE) (JUST TRUE) TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 249A(3) the person is guilty of an offence` (JUST TRUE) (JUST TRUE) TRUE FALSE FALSE) EQUALS NOTHING
-- issued in contravention of neither
#ASSERT (`s 249A(3) the person is guilty of an offence` (JUST FALSE) (JUST FALSE) TRUE TRUE TRUE) EQUALS JUST FALSE
-- not issued
#ASSERT (`s 249A(3) the person is guilty of an offence` (JUST TRUE) (JUST TRUE) FALSE TRUE TRUE) EQUALS JUST FALSE
-- one of the answers was not worked out
#ASSERT (`s 249A(3) the person is guilty of an offence` (JUST FALSE) NOTHING TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 249A(3) the person is guilty of an offence` NOTHING NOTHING TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 249A(3) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 50000
#ASSERT (`s 249A(3) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 12
#ASSERT (`s 249A(3) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS TRUE
#ASSERT (`s 249A(3) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 5000

§ `s 249A(4) and (5): depositing and keeping the consents`
#ASSERT (`s 249A(4) the person making the offer has deposited the copies of the consents` TRUE (Date 2 3 2026) TRUE TRUE FALSE (Date 9 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 249A(4) the person making the offer has deposited the copies of the consents` TRUE (Date 2 3 2026) TRUE TRUE FALSE (Date 10 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 249A(4) the person making the offer has deposited the copies of the consents` TRUE (Date 2 3 2026) FALSE FALSE TRUE (Date 5 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 249A(4) the person making the offer has deposited the copies of the consents` TRUE (Date 2 3 2026) TRUE FALSE TRUE (Date 5 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 249A(4) the person making the offer has deposited the copies of the consents` FALSE (Date 2 3 2026) TRUE TRUE FALSE (Date 5 3 2026)) EQUALS NOTHING
#ASSERT (`s 249A(5) the issuer has kept the copies and made them available` TRUE (Date 2 3 2026) TRUE TRUE (Date 2 9 2026)) EQUALS JUST TRUE
#ASSERT (`s 249A(5) the issuer has kept the copies and made them available` TRUE (Date 2 3 2026) TRUE TRUE (Date 1 9 2026)) EQUALS JUST FALSE
#ASSERT (`s 249A(5) the issuer has kept the copies and made them available` TRUE (Date 2 3 2026) TRUE FALSE (Date 2 9 2026)) EQUALS JUST FALSE
#ASSERT (`s 249A(5) the issuer has kept the copies and made them available` FALSE (Date 2 3 2026) TRUE TRUE (Date 2 9 2026)) EQUALS NOTHING

§ `s 250(3): the period`
-- arguments: the securities are debentures issued under a debenture issuance programme under s 240A; the date of registration
-- 24 months from 2 March 2026
#ASSERT (`s 250(3) the last day of the period` TRUE (Date 2 3 2026)) EQUALS (Date 2 3 2028)
-- 6 months from 2 March 2026
#ASSERT (`s 250(3) the last day of the period` FALSE (Date 2 3 2026)) EQUALS (Date 2 9 2026)
-- no 31 February: the keel counts to the last day of the month
#ASSERT (`s 250(3) the last day of the period` FALSE (Date 31 8 2026)) EQUALS (Date 28 2 2027)

§ `s 250(1) and (2): offering, allotting, issuing or selling on the basis of an expired prospectus`
-- arguments: (1): the person makes an offer, or allots, issues or sells; the day; the last day of the period
-- after the expiration of the period
#ASSERT (`s 250(1) the person must not make the offer or allot, issue or sell on the basis of the prospectus` TRUE (Date 3 9 2026) (Date 2 9 2026)) EQUALS JUST TRUE
-- on the last day is within the period
#ASSERT (`s 250(1) the person must not make the offer or allot, issue or sell on the basis of the prospectus` TRUE (Date 2 9 2026) (Date 2 9 2026)) EQUALS JUST FALSE
#ASSERT (`s 250(1) the person must not make the offer or allot, issue or sell on the basis of the prospectus` TRUE (Date 1 9 2026) (Date 2 9 2026)) EQUALS JUST FALSE
-- the person does nothing the bar names (SPLIT-SITE (i))
#ASSERT (`s 250(1) the person must not make the offer or allot, issue or sell on the basis of the prospectus` FALSE (Date 3 9 2026) (Date 2 9 2026)) EQUALS NOTHING
-- (2) arguments: an entity makes the offer or the securities are issued by an entity or proposed entity; the person is an officer, equivalent person or promoter; the person authorises or permits; the day; the last day
#ASSERT (`s 250(2) the officer or promoter must not authorise or permit the offer, allotment, issue or sale` TRUE TRUE TRUE (Date 3 9 2026) (Date 2 9 2026)) EQUALS JUST TRUE
#ASSERT (`s 250(2) the officer or promoter must not authorise or permit the offer, allotment, issue or sale` TRUE TRUE TRUE (Date 2 9 2026) (Date 2 9 2026)) EQUALS JUST FALSE
-- the "In a case where" gate fails
#ASSERT (`s 250(2) the officer or promoter must not authorise or permit the offer, allotment, issue or sale` FALSE TRUE TRUE (Date 3 9 2026) (Date 2 9 2026)) EQUALS JUST FALSE
#ASSERT (`s 250(2) the officer or promoter must not authorise or permit the offer, allotment, issue or sale` TRUE FALSE TRUE (Date 3 9 2026) (Date 2 9 2026)) EQUALS NOTHING
#ASSERT (`s 250(2) the officer or promoter must not authorise or permit the offer, allotment, issue or sale` TRUE TRUE FALSE (Date 3 9 2026) (Date 2 9 2026)) EQUALS NOTHING

-- EXPECT BREACH: the bar bites and the person sells
#TRACE (`s 250(1) the person shall not make the offer or allot, issue or sell after the period` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 250(1) make the offer or allot, issue or sell on the basis of an expired prospectus` AT 2

-- EXPECT RESIDUAL: the bar bites and nothing is sold yet
#TRACE (`s 250(1) the person shall not make the offer or allot, issue or sell after the period` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH

-- EXPECT BREACH: the officer authorises
#TRACE (`s 250(2) the officer or promoter shall not authorise or permit the offer, allotment, issue or sale after the period` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 250(2) authorise or permit the offer, or the allotment, issue or sale, on the basis of an expired prospectus` AT 2

§ `s 250(4) and (5): the offence and the validity of the sale`
-- arguments: what s 250(1) answers; what s 250(2) answers; an officer or promoter of an entity in default
#ASSERT (`s 250(4) the person is guilty of an offence` (JUST TRUE) NOTHING FALSE) EQUALS JUST TRUE
#ASSERT (`s 250(4) the person is guilty of an offence` NOTHING (JUST TRUE) FALSE) EQUALS JUST TRUE
-- an officer of an entity in default is liable too
#ASSERT (`s 250(4) the person is guilty of an offence` NOTHING NOTHING TRUE) EQUALS JUST TRUE
-- no default in complying with (1) or (2): the "If" fails (SPLIT-SITE (i), MARGINAL-READING (a))
#ASSERT (`s 250(4) the person is guilty of an offence` (JUST FALSE) (JUST FALSE) FALSE) EQUALS JUST FALSE
#ASSERT (`s 250(4) the person is guilty of an offence` (JUST FALSE) NOTHING FALSE) EQUALS NOTHING
#ASSERT (`s 250(4) the person is guilty of an offence` NOTHING NOTHING FALSE) EQUALS NOTHING
#ASSERT (`s 250(4) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 50000
#ASSERT (`s 250(4) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 12
#ASSERT (`s 250(4) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS TRUE
#ASSERT (`s 250(4) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 5000
-- not, by reason only of that fact, voidable or void
#ASSERT (`s 250(5) the allotment, issue or sale is void or voidable by reason only of the contravention` TRUE) EQUALS JUST FALSE
#ASSERT (`s 250(5) the allotment, issue or sale is void or voidable by reason only of the contravention` FALSE) EQUALS NOTHING

§ `s 251(1): the bar on advertising`
-- arguments: a prospectus is required; the person advertises; publishes a statement that refers to the offer; publishes a statement likely to induce; authorised by this section (MAYBE); exempt under (14) (MAYBE)
#ASSERT (`s 251(1) the person must not advertise the offer or publish the statement` TRUE TRUE FALSE FALSE NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 251(1) the person must not advertise the offer or publish the statement` TRUE FALSE TRUE FALSE NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 251(1) the person must not advertise the offer or publish the statement` TRUE FALSE FALSE TRUE NOTHING NOTHING) EQUALS JUST TRUE
-- no prospectus is required: the "If" fails (SPLIT-SITE (i), MARGINAL-READING (a))
#ASSERT (`s 251(1) the person must not advertise the offer or publish the statement` FALSE TRUE FALSE FALSE NOTHING NOTHING) EQUALS JUST FALSE
-- the person does none of the three acts (SPLIT-SITE (i))
#ASSERT (`s 251(1) the person must not advertise the offer or publish the statement` TRUE FALSE FALSE FALSE NOTHING NOTHING) EQUALS NOTHING
-- "unless ... authorised by this section"
#ASSERT (`s 251(1) the person must not advertise the offer or publish the statement` TRUE TRUE FALSE FALSE (JUST TRUE) NOTHING) EQUALS JUST FALSE
-- exempt under subsection (14)
#ASSERT (`s 251(1) the person must not advertise the offer or publish the statement` TRUE TRUE FALSE FALSE NOTHING (JUST TRUE)) EQUALS JUST FALSE
-- only an answer JUST TRUE counts
#ASSERT (`s 251(1) the person must not advertise the offer or publish the statement` TRUE TRUE FALSE FALSE (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 251(1) the person must not advertise the offer or publish the statement` TRUE TRUE FALSE FALSE NOTHING NOTHING) EQUALS JUST TRUE

-- EXPECT BREACH: the bar bites and the person advertises
#TRACE (`s 251(1) the person shall not advertise the offer or publish the statement` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 251(1) advertise the offer or intended offer or publish the statement` AT 2

-- EXPECT RESIDUAL: the bar bites and nothing is published yet
#TRACE (`s 251(1) the person shall not advertise the offer or publish the statement` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH

-- EXPECT FULFILLED: the advertisement is authorised
#TRACE (`s 251(1) the person shall not advertise the offer or publish the statement` (`An offeror` "Acme Pte Ltd") (JUST FALSE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 251(1) advertise the offer or intended offer or publish the statement` AT 2

§ `s 251(2): the three matters regard must be had to`
-- arguments: a determination is made; regard is had to (c); to (d); to (e)
#ASSERT (`s 251(2) regard has been had to the three matters` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 251(2) regard has been had to the three matters` TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 251(2) regard has been had to the three matters` TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 251(2) regard has been had to the three matters` TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- no determination is being made
#ASSERT (`s 251(2) regard has been had to the three matters` FALSE TRUE TRUE TRUE) EQUALS NOTHING
-- s 251(2)(c) arguments: normal advertising of an entity; genuinely directed (entity); normal advertising by a trustee-manager; genuinely directed (business trust)
#ASSERT (`s 251(2)(c) the statement forms part of the normal advertising` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 251(2)(c) the statement forms part of the normal advertising` FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
-- the limbs are not closed
#ASSERT (`s 251(2)(c) the statement forms part of the normal advertising` TRUE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 251(2)(c) the statement forms part of the normal advertising` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 251(2)(c) the statement forms part of the normal advertising` FALSE FALSE FALSE FALSE) EQUALS NOTHING

§ `s 251(3) and (4): the preliminary document`
-- s 251(3) arguments: disseminates; lodged; registered; front-page statement; bold statement; form of application attached; steps to notify on registration
#ASSERT (`s 251(3) the person may disseminate the preliminary document without contravening subsection (1)` TRUE TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- a form of application is attached: the "if" fails (the grant ruling)
#ASSERT (`s 251(3) the person may disseminate the preliminary document without contravening subsection (1)` TRUE TRUE FALSE TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 251(3) the person may disseminate the preliminary document without contravening subsection (1)` TRUE TRUE FALSE FALSE TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 251(3) the person may disseminate the preliminary document without contravening subsection (1)` TRUE TRUE FALSE TRUE FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 251(3) the person may disseminate the preliminary document without contravening subsection (1)` TRUE TRUE FALSE TRUE TRUE FALSE FALSE) EQUALS NOTHING
-- the prospectus is already registered: "before ... is registered" (SPLIT-SITE (ii))
#ASSERT (`s 251(3) the person may disseminate the preliminary document without contravening subsection (1)` TRUE TRUE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 251(3) the person may disseminate the preliminary document without contravening subsection (1)` FALSE TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS NOTHING
-- not a lodged document
#ASSERT (`s 251(3) the person may disseminate the preliminary document without contravening subsection (1)` TRUE FALSE FALSE TRUE TRUE FALSE TRUE) EQUALS NOTHING
-- s 251(4)(a) arguments: presents; lodged; registered; states "subject to amendments"; states "no offer"; form attached; steps to notify
#ASSERT (`s 251(4)(a) the person does not contravene subsection (1) by presenting the material` TRUE TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 251(4)(a) the person does not contravene subsection (1) by presenting the material` TRUE TRUE FALSE FALSE TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 251(4)(a) the person does not contravene subsection (1) by presenting the material` TRUE TRUE FALSE TRUE FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 251(4)(a) the person does not contravene subsection (1) by presenting the material` TRUE TRUE FALSE TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 251(4)(a) the person does not contravene subsection (1) by presenting the material` TRUE TRUE FALSE TRUE TRUE FALSE FALSE) EQUALS NOTHING
-- registered already (SPLIT-SITE (ii))
#ASSERT (`s 251(4)(a) the person does not contravene subsection (1) by presenting the material` TRUE TRUE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 251(4)(a) the person does not contravene subsection (1) by presenting the material` FALSE TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 251(4)(a) the person does not contravene subsection (1) by presenting the material` TRUE FALSE FALSE TRUE TRUE FALSE TRUE) EQUALS NOTHING
-- s 251(4)(b) the eight persons, in the order of the text
#ASSERT (`s 251(4)(b) the person equipped is one of the eight persons listed` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 251(4)(b) the person equipped is one of the eight persons listed` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 251(4)(b) the person equipped is one of the eight persons listed` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 251(4)(b) the person equipped is one of the eight persons listed` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 251(4)(b) the person equipped is one of the eight persons listed` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 251(4)(b) the person equipped is one of the eight persons listed` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 251(4)(b) the person equipped is one of the eight persons listed` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 251(4)(b) the person equipped is one of the eight persons listed` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 251(4)(b) the person equipped is one of the eight persons listed` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
-- s 251(4)(b) arguments: presents; lodged; registered; the sole purpose; the persons function (MAYBE)
#ASSERT (`s 251(4)(b) the person does not contravene subsection (1) by presenting the material to equip those persons` TRUE TRUE FALSE TRUE (JUST TRUE)) EQUALS JUST TRUE
