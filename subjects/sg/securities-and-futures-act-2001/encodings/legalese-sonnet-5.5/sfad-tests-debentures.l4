IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-periods`
IMPORT `sfad-debentures`

-- Tests for sfad-debentures.l4 (Securities and Futures Act 2001, ss 261 to 271).
-- Every expected value is written from the text, beside the assertion; none is copied from the module's output.
-- Inputs are positional, in the order of the GIVEN of the function under test.

§ `s 261`

-- "this Subdivision applies where an entity makes an offer of debentures"
#ASSERT (`s 261(1) this Subdivision applies to the offer` TRUE) EQUALS JUST TRUE
#ASSERT (`s 261(1) this Subdivision applies to the offer` FALSE) EQUALS JUST FALSE
-- (1A) "do not apply if the borrowing entity is a prescribed entity"
#ASSERT (`s 261(1A) sections 268, 269 and 270 do not apply to the borrowing entity` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 261(1A) sections 268, 269 and 270 do not apply to the borrowing entity` (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 261(1A) sections 268, 269 and 270 do not apply to the borrowing entity` NOTHING) EQUALS NOTHING
-- (1B) a bank licensed under the Banking Act 1970, or an entity the Authority declared
#ASSERT (`s 261(1B) the entity is a prescribed entity` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 261(1B) the entity is a prescribed entity` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 261(1B) the entity is a prescribed entity` FALSE FALSE) EQUALS JUST FALSE
-- (1C)(a), (b): the Authority's powers, as what they mean to the entity
#ASSERT (`s 261(1C)(a) the Authority may impose a condition or restriction on the entity` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 261(1C)(a) the Authority may impose a condition or restriction on the entity` (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 261(1C)(a) the Authority may impose a condition or restriction on the entity` NOTHING) EQUALS NOTHING
#ASSERT (`s 261(1C)(b) the Authority may vary or revoke the condition or restriction` TRUE) EQUALS JUST TRUE
#ASSERT (`s 261(1C)(b) the Authority may vary or revoke the condition or restriction` FALSE) EQUALS NOTHING
-- (1C) "must comply with every such condition or restriction imposed on it by the Authority that has not been revoked"
#ASSERT (`s 261(1C) the prescribed entity must comply with the condition or restriction` (JUST TRUE) TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 261(1C) the prescribed entity must comply with the condition or restriction` (JUST TRUE) TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 261(1C) the prescribed entity must comply with the condition or restriction` (JUST TRUE) FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 261(1C) the prescribed entity must comply with the condition or restriction` (JUST FALSE) TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 261(1C) the prescribed entity must comply with the condition or restriction` NOTHING TRUE FALSE) EQUALS NOTHING
-- (1D) offence and penalty: fine not exceeding $50,000, a further fine not exceeding $5,000 a day
#ASSERT (`s 261(1D) the person is guilty of an offence` TRUE) EQUALS JUST TRUE
#ASSERT (`s 261(1D) the person is guilty of an offence` FALSE) EQUALS JUST FALSE
#ASSERT (`s 261(1D) the penalty for the offence`) EQUALS (Penalty OF 50000, 0, FALSE, 5000)
-- (3) related corporation
#ASSERT (`s 261(3) the corporation is related to the other corporation for this Subdivision` TRUE) EQUALS JUST TRUE
#ASSERT (`s 261(3) the corporation is related to the other corporation for this Subdivision` FALSE) EQUALS JUST FALSE
-- The regulative rule for (1C): a duty with no time limit, so no trace reaches BREACH.
-- EXPECT RESIDUAL
#TRACE `s 261(1C) the duty of a prescribed entity to comply with a condition or restriction` AT 0 WITH
    (WAITUNTIL 40)
-- EXPECT FULFILLED
#TRACE `s 261(1C) the duty of a prescribed entity to comply with a condition or restriction` AT 0 WITH
    PARTY `s 268 the prescribed entity` DOES `s 261(1C) comply with the condition or restriction` AT 5

§ `s 262`

-- (3) "special purpose vehicle": an entity, or a trust, established solely to hold the assets or issue the securities
#ASSERT (`s 262(3) the body is a special purpose vehicle` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 262(3) the body is a special purpose vehicle` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 262(3) the body is a special purpose vehicle` FALSE FALSE) EQUALS JUST FALSE
-- (3) "securitisation transaction": the sale to a special purpose vehicle AND the funding by debentures AND the payments from the cash flows
#ASSERT (`s 262(3) the arrangement is a securitisation transaction` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 262(3) the arrangement is a securitisation transaction` FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 262(3) the arrangement is a securitisation transaction` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 262(3) the arrangement is a securitisation transaction` TRUE TRUE FALSE) EQUALS JUST FALSE
-- (3) "asset-backed securities": debentures or units of debentures issued pursuant to a securitisation transaction
#ASSERT (`s 262(3) the securities are asset-backed securities` TRUE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 262(3) the securities are asset-backed securities` TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 262(3) the securities are asset-backed securities` FALSE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 262(3) the securities are asset-backed securities` TRUE NOTHING) EQUALS NOTHING
-- (1) "An offer of asset-backed securities is made only if they are issued by (a) a special purpose vehicle other than a trust; or (b) the trustee of a trust that is a special purpose vehicle"
#ASSERT (`s 262(1) the asset-backed securities are issued by a special purpose vehicle or the trustee of one` (JUST TRUE) TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 262(1) the asset-backed securities are issued by a special purpose vehicle or the trustee of one` (JUST TRUE) FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 262(1) the asset-backed securities are issued by a special purpose vehicle or the trustee of one` (JUST TRUE) FALSE FALSE) EQUALS JUST FALSE
-- securities that are not asset-backed securities: the section speaks only of an offer of asset-backed securities
#ASSERT (`s 262(1) the asset-backed securities are issued by a special purpose vehicle or the trustee of one` (JUST FALSE) FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 262(1) the asset-backed securities are issued by a special purpose vehicle or the trustee of one` NOTHING TRUE TRUE) EQUALS NOTHING
-- (2) the Authority may exempt, subject to conditions
#ASSERT (`s 262(2) the person is exempt from section 262` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 262(2) the person is exempt from section 262` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 262(2) the person is exempt from section 262` FALSE TRUE) EQUALS NOTHING

§ `s 265`

-- (1) all of: irredeemable debentures; application by the trustee (or a holder if none); (a); (b) proceeds AT MOST 60% of the principal sum; (c) value below the principal sum and insufficient profit
-- 600 is exactly 60% of 1000: "not more than 60%" includes the boundary; 601 is above it.
#ASSERT (`s 265(1) the court may order the security for the debentures to be enforceable` TRUE TRUE TRUE 600 1000 TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 265(1) the court may order the security for the debentures to be enforceable` TRUE TRUE TRUE 601 1000 TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 265(1) the court may order the security for the debentures to be enforceable` FALSE TRUE TRUE 500 1000 TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 265(1) the court may order the security for the debentures to be enforceable` TRUE FALSE TRUE 500 1000 TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 265(1) the court may order the security for the debentures to be enforceable` TRUE TRUE FALSE 500 1000 TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 265(1) the court may order the security for the debentures to be enforceable` TRUE TRUE TRUE 500 1000 FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 265(1) the court may order the security for the debentures to be enforceable` TRUE TRUE TRUE 500 1000 TRUE FALSE) EQUALS NOTHING
-- (2) "Subsection (1) does not affect any power ... created by the terms of the debentures"
#ASSERT (`s 265(2) section 265(1) does not affect the power` TRUE) EQUALS JUST TRUE
#ASSERT (`s 265(2) section 265(1) does not affect the power` FALSE) EQUALS NOTHING

§ `s 265A`

-- (5) the two definitions by cross-reference
#ASSERT (`s 265A(5) the debentures are asset-backed securities or structured notes` (JUST TRUE) FALSE) EQUALS JUST TRUE
#ASSERT (`s 265A(5) the debentures are asset-backed securities or structured notes` (JUST FALSE) TRUE) EQUALS JUST TRUE
#ASSERT (`s 265A(5) the debentures are asset-backed securities or structured notes` (JUST FALSE) FALSE) EQUALS JUST FALSE
#ASSERT (`s 265A(5) the debentures are asset-backed securities or structured notes` NOTHING FALSE) EQUALS NOTHING
-- (1) "Where an offer of debentures is made in or accompanied by a prospectus, the borrowing entity must appoint a trustee"
#ASSERT (`s 265A(1) the borrowing entity must appoint a trustee for the holders of debentures for the entire tenure` TRUE) EQUALS JUST TRUE
#ASSERT (`s 265A(1) the borrowing entity must appoint a trustee for the holders of debentures for the entire tenure` FALSE) EQUALS JUST FALSE
-- (2)(a) asset-backed securities or structured notes: licensed trust company, bank, approved trustee (s 289) or prescribed person; AND independent AND prescribed requirements met
-- arguments: asset-backed or structured; trust company; bank; approved trustee; satisfied (b)(iv); prescribed person; independent; meets prescribed requirements
#ASSERT (`s 265A(2) the borrowing entity has ensured that the appointed trustee meets the requirements` (JUST TRUE) TRUE FALSE FALSE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 265A(2) the borrowing entity has ensured that the appointed trustee meets the requirements` (JUST TRUE) FALSE TRUE FALSE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 265A(2) the borrowing entity has ensured that the appointed trustee meets the requirements` (JUST TRUE) FALSE FALSE TRUE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 265A(2) the borrowing entity has ensured that the appointed trustee meets the requirements` (JUST TRUE) FALSE FALSE FALSE FALSE TRUE TRUE TRUE) EQUALS JUST TRUE
-- the borrowing entity's own satisfaction ((b)(iv)) is NOT enough for asset-backed securities or structured notes
#ASSERT (`s 265A(2) the borrowing entity has ensured that the appointed trustee meets the requirements` (JUST TRUE) FALSE FALSE FALSE TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
-- not independent, or a prescribed requirement not met
#ASSERT (`s 265A(2) the borrowing entity has ensured that the appointed trustee meets the requirements` (JUST TRUE) TRUE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 265A(2) the borrowing entity has ensured that the appointed trustee meets the requirements` (JUST TRUE) TRUE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE
-- (2)(b) other debentures: the same list, and the borrowing entity's own reasonable satisfaction is enough
#ASSERT (`s 265A(2) the borrowing entity has ensured that the appointed trustee meets the requirements` (JUST FALSE) FALSE FALSE FALSE TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 265A(2) the borrowing entity has ensured that the appointed trustee meets the requirements` (JUST FALSE) TRUE FALSE FALSE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 265A(2) the borrowing entity has ensured that the appointed trustee meets the requirements` (JUST FALSE) FALSE FALSE FALSE FALSE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 265A(2) the borrowing entity has ensured that the appointed trustee meets the requirements` NOTHING TRUE FALSE FALSE FALSE FALSE TRUE TRUE) EQUALS NOTHING
-- (3) the matters to consider: (a) and (b) always; (c) if the person is the appointed trustee; (d) if the Authority prescribed any
-- arguments: (a); (b); person is the appointed trustee; (c); Authority prescribed others; (d)
#ASSERT (`s 265A(3) the borrowing entity has considered the matters before being satisfied` TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 265A(3) the borrowing entity has considered the matters before being satisfied` TRUE TRUE TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 265A(3) the borrowing entity has considered the matters before being satisfied` TRUE TRUE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 265A(3) the borrowing entity has considered the matters before being satisfied` TRUE TRUE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 265A(3) the borrowing entity has considered the matters before being satisfied` TRUE TRUE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 265A(3) the borrowing entity has considered the matters before being satisfied` FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 265A(3) the borrowing entity has considered the matters before being satisfied` TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (4) offence and penalty
#ASSERT (`s 265A(4) the person is guilty of an offence` TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 265A(4) the person is guilty of an offence` FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 265A(4) the person is guilty of an offence` FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 265A(4) the person is guilty of an offence` FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 265A(4) the penalty for the offence`) EQUALS (Penalty OF 50000, 0, FALSE, 5000)
-- the duty to appoint has no time limit: no trace reaches BREACH
-- EXPECT RESIDUAL
#TRACE `s 265A(1) the duty to appoint a trustee for the holders of debentures` AT 0 WITH
    (WAITUNTIL 400)
-- EXPECT FULFILLED
#TRACE `s 265A(1) the duty to appoint a trustee for the holders of debentures` AT 0 WITH
    PARTY `s 268 the borrowing entity` DOES `s 265A(1) appoint a trustee for the holders of debentures for the entire tenure` AT 2

§ `s 266`

-- (1)(a) to (d): all four, (d) only where the Authority prescribed or imposed other requirements
#ASSERT (`s 266(1) the trustee for the holders of debentures has done what paragraphs (a) to (d) require` TRUE TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 266(1) the trustee for the holders of debentures has done what paragraphs (a) to (d) require` TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 266(1) the trustee for the holders of debentures has done what paragraphs (a) to (d) require` TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 266(1) the trustee for the holders of debentures has done what paragraphs (a) to (d) require` FALSE TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 266(1) the trustee for the holders of debentures has done what paragraphs (a) to (d) require` TRUE FALSE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 266(1) the trustee for the holders of debentures has done what paragraphs (a) to (d) require` TRUE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (2) "Where, after due inquiry, the trustee ... is of the opinion that the assets ... are insufficient"
#ASSERT (`s 266(2) the trustee may apply to the Authority for an order` TRUE) EQUALS JUST TRUE
#ASSERT (`s 266(2) the trustee may apply to the Authority for an order` FALSE) EQUALS JUST FALSE
-- (3)(a) "after giving the borrowing entity an opportunity of making representations ..., by written order served ..., may impose such restrictions"
#ASSERT (`s 266(3)(a) the Authority may impose restrictions on the activities of the borrowing entity` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 266(3)(a) the Authority may impose restrictions on the activities of the borrowing entity` TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 266(3)(a) the Authority may impose restrictions on the activities of the borrowing entity` TRUE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 266(3)(a) the Authority may impose restrictions on the activities of the borrowing entity` FALSE TRUE TRUE) EQUALS NOTHING
-- (3)(b) "may, and if the borrowing entity so requires, must direct the trustee to apply to the court"
#ASSERT (`s 266(3)(b) the Authority must direct the trustee to apply to the court` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 266(3)(b) the Authority must direct the trustee to apply to the court` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 266(3)(b) the Authority must direct the trustee to apply to the court` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 266(3)(b) the trustee must apply to the court as directed` TRUE) EQUALS JUST TRUE
#ASSERT (`s 266(3)(b) the trustee must apply to the court as directed` FALSE) EQUALS JUST FALSE
-- (4) the trustee "may, and where the borrowing entity has requested the trustee to do so, must apply to the court": (a) the opinion; (b) a contravened order
#ASSERT (`s 266(4) the trustee may apply to the court for an order under subsection (5)` TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 266(4) the trustee may apply to the court for an order under subsection (5)` FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 266(4) the trustee may apply to the court for an order under subsection (5)` FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 266(4) the trustee must apply to the court for an order under subsection (5)` (JUST TRUE) TRUE) EQUALS JUST TRUE
#ASSERT (`s 266(4) the trustee must apply to the court for an order under subsection (5)` (JUST TRUE) FALSE) EQUALS JUST FALSE
#ASSERT (`s 266(4) the trustee must apply to the court for an order under subsection (5)` (JUST FALSE) TRUE) EQUALS JUST FALSE
#ASSERT (`s 266(4) the trustee must apply to the court for an order under subsection (5)` NOTHING TRUE) EQUALS NOTHING
-- (5) "Where an application is made ..., the court may, after giving the borrowing entity an opportunity to be heard, by order, do all or any of the following things"
#ASSERT (`s 266(5) the court may make the order` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 266(5) the court may make the order` FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 266(5) the court may make the order` TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 266(5) the court may make the order` TRUE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 266(5) the court has done what it must in making the order` TRUE) EQUALS JUST TRUE
#ASSERT (`s 266(5) the court has done what it must in making the order` FALSE) EQUALS JUST FALSE
-- (6) the court may vary or rescind an order made under (5)
#ASSERT (`s 266(6) the court may vary or rescind the order` TRUE) EQUALS JUST TRUE
#ASSERT (`s 266(6) the court may vary or rescind the order` FALSE) EQUALS NOTHING
-- (7) "A trustee in making any application ... must have regard to the nature and kind of the security given ..., and if no security was given must have regard to the position of the holders ... as unsecured creditors"
#ASSERT (`s 266(7) the trustee has had the regard the subsection requires` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 266(7) the trustee has had the regard the subsection requires` TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 266(7) the trustee has had the regard the subsection requires` TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 266(7) the trustee has had the regard the subsection requires` TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 266(7) the trustee has had the regard the subsection requires` FALSE TRUE TRUE TRUE) EQUALS NOTHING
-- (8) the trustee "may rely ... if it has reasonable grounds for believing" the giver was competent
#ASSERT (`s 266(8) the trustee may rely on the certificate, report or statement` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 266(8) the trustee may rely on the certificate, report or statement` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 266(8) the trustee may rely on the certificate, report or statement` FALSE TRUE) EQUALS NOTHING
-- the duties of the trustee as regulative rules: no time limit, so no BREACH trace
-- EXPECT RESIDUAL
#TRACE `s 266(3)(b) the duty of the trustee to apply to the court as directed` AT 0 WITH
    (WAITUNTIL 30)
-- EXPECT FULFILLED
#TRACE `s 266(3)(b) the duty of the trustee to apply to the court as directed` AT 0 WITH
    PARTY `s 268 the trustee for the holders of the debentures` DOES `s 266(3)(b) apply to the court as the Authority directs` AT 9
-- EXPECT RESIDUAL
#TRACE `s 266(4) the duty of the trustee to apply to the court on the request of the borrowing entity` AT 0 WITH
    (WAITUNTIL 30)
-- EXPECT FULFILLED
#TRACE `s 266(4) the duty of the trustee to apply to the court on the request of the borrowing entity` AT 0 WITH
    PARTY `s 268 the trustee for the holders of the debentures` DOES `s 266(4) apply to the court as the borrowing entity requests` AT 9

§ `s 267 and s 267A`

#ASSERT (`s 267(1) the trustee for the holders of debentures may apply to the court` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 267(1) the trustee for the holders of debentures may apply to the court` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 267(1) the trustee for the holders of debentures may apply to the court` FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 267(2) the court may give directions or accede to the application` TRUE) EQUALS JUST TRUE
#ASSERT (`s 267(2) the court may give directions or accede to the application` FALSE) EQUALS NOTHING
-- (2)(b) "if satisfied that the determination of the question will be just and beneficial"
#ASSERT (`s 267(2)(b) the court may accede to the application on terms or make another order` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 267(2)(b) the court may accede to the application on terms or make another order` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 267(2)(b) the court may accede to the application on terms or make another order` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 267(3) the court may order a meeting of the holders of debentures to be called` TRUE) EQUALS JUST TRUE
#ASSERT (`s 267(3) the court may order a meeting of the holders of debentures to be called` FALSE) EQUALS NOTHING
-- (4) held as the court directs, by a chairperson nominated by the trustee or another person the meeting appoints
#ASSERT (`s 267(4) the meeting is held and conducted as the subsection requires` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 267(4) the meeting is held and conducted as the subsection requires` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 267(4) the meeting is held and conducted as the subsection requires` TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 267(4) the meeting is held and conducted as the subsection requires` FALSE TRUE FALSE) EQUALS JUST FALSE
-- 267A: a holder of debentures, the Authority or an approved exchange (where the debentures are quoted or listed for quotation on it)
#ASSERT (`s 267A the person may apply to the court for an order compelling the trustee to perform the trustee's duties` TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 267A the person may apply to the court for an order compelling the trustee to perform the trustee's duties` FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 267A the person may apply to the court for an order compelling the trustee to perform the trustee's duties` FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 267A the person may apply to the court for an order compelling the trustee to perform the trustee's duties` FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 267A the court may make the order or dismiss the application` TRUE) EQUALS JUST TRUE
#ASSERT (`s 267A the court may make the order or dismiss the application` FALSE) EQUALS NOTHING

§ `s 268`

-- (4) "Where there is a trustee ..., the borrowing entity and each of its guarantor entities which has guaranteed the repayment"
#ASSERT (`s 268(4) the entity must provide the trustee with particulars of the charge` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 268(4) the entity must provide the trustee with particulars of the charge` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(4) the entity must provide the trustee with particulars of the charge` TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 268(4) the entity must provide the trustee with particulars of the charge` FALSE TRUE FALSE) EQUALS JUST FALSE
-- (4)(a) charge created 1 March 2025: 21 days after is 22 March 2025
#ASSERT (`s 268(4)(a) the particulars of the charge are provided in time` (Date 1 3 2025) (Date 22 3 2025) TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(4)(a) the particulars of the charge are provided in time` (Date 1 3 2025) (Date 23 3 2025) TRUE) EQUALS JUST FALSE
#ASSERT (`s 268(4)(a) the particulars of the charge are provided in time` (Date 1 3 2025) (Date 22 3 2025) FALSE) EQUALS JUST FALSE
-- (4)(b) advance on 10 January 2025: 7 days after is 17 January 2025; "when the amount ... is indeterminate"
#ASSERT (`s 268(4)(b) the particulars of the amounts advanced are provided in time` TRUE (Date 10 1 2025) (Date 17 1 2025) TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(4)(b) the particulars of the amounts advanced are provided in time` TRUE (Date 10 1 2025) (Date 18 1 2025) TRUE) EQUALS JUST FALSE
#ASSERT (`s 268(4)(b) the particulars of the amounts advanced are provided in time` TRUE (Date 10 1 2025) (Date 17 1 2025) FALSE) EQUALS JUST FALSE
#ASSERT (`s 268(4)(b) the particulars of the amounts advanced are provided in time` FALSE (Date 10 1 2025) (Date 17 1 2025) TRUE) EQUALS NOTHING
-- (5) "it is sufficient ... for particulars of the net amount outstanding ... to be provided every 3 months"
#ASSERT (`s 268(5) it is sufficient to provide particulars of the net amount every 3 months` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(5) it is sufficient to provide particulars of the net amount every 3 months` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 268(5) it is sufficient to provide particulars of the net amount every 3 months` FALSE TRUE) EQUALS NOTHING
-- (6) lodged with the trustee "if any"
#ASSERT (`s 268(6) the directors or equivalent persons must cause the accounts to be made out and lodged with the trustee` TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(6) the directors or equivalent persons must cause the accounts to be made out and lodged with the trustee` FALSE) EQUALS JUST FALSE
-- (6)(a) the first 6 months end 30 June 2025: 3 months after is 30 September 2025
#ASSERT (`s 268(6)(a) the half-year accounts are made out and lodged in time` (Date 30 6 2025) (Date 30 9 2025) TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(6)(a) the half-year accounts are made out and lodged in time` (Date 30 6 2025) (Date 1 10 2025) TRUE) EQUALS JUST FALSE
#ASSERT (`s 268(6)(a) the half-year accounts are made out and lodged in time` (Date 30 6 2025) (Date 30 9 2025) FALSE) EQUALS JUST FALSE
-- (6)(b) the financial year ends 31 December 2025: 5 months after is 31 May 2026
#ASSERT (`s 268(6)(b) the annual accounts are made out and lodged in time` (Date 31 12 2025) (Date 31 5 2026) TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(6)(b) the annual accounts are made out and lodged in time` (Date 31 12 2025) (Date 1 6 2026) TRUE) EQUALS JUST FALSE
#ASSERT (`s 268(6)(b) the annual accounts are made out and lodged in time` (Date 31 12 2025) (Date 31 5 2026) FALSE) EQUALS JUST FALSE
-- (6A) due care
#ASSERT (`s 268(6A) the person has used the due care the subsection requires` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(6A) the person has used the due care the subsection requires` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 268(6A) the person has used the due care the subsection requires` FALSE TRUE) EQUALS NOTHING
-- (7) and (7A): offences and penalties
#ASSERT (`s 268(7) the person is guilty of an offence` TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(7) the person is guilty of an offence` FALSE) EQUALS JUST FALSE
#ASSERT (`s 268(7) the penalty for the offence`) EQUALS (Penalty OF 15000, 0, FALSE, 1000)
#ASSERT (`s 268(7A) the person is guilty of an offence` TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(7A) the person is guilty of an offence` FALSE) EQUALS JUST FALSE
#ASSERT (`s 268(7A) the penalty for the offence`) EQUALS (Penalty OF 50000, 24, TRUE, 0)
-- (8) the Companies Act sections apply to accounts made out and lodged under (6)
#ASSERT (`s 268(8) the account and balance sheet are treated as financial statements for the Companies Act 1967 sections` TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(8) the account and balance sheet are treated as financial statements for the Companies Act 1967 sections` FALSE) EQUALS NOTHING
-- (9) "Where the directors ... do not lodge ..., the trustee must immediately lodge notice"
#ASSERT (`s 268(9) the trustee must lodge notice of that fact with the Authority` TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(9) the trustee must lodge notice of that fact with the Authority` FALSE) EQUALS JUST FALSE
-- (10)(a) need not be audited; (b) need not be audited, or limited, if the trustee consented in writing
#ASSERT (`s 268(10)(a) the half-year accounts need not be audited` TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(10)(a) the half-year accounts need not be audited` FALSE) EQUALS NOTHING
#ASSERT (`s 268(10)(b) the annual accounts need not be audited, or the audit may be limited` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 268(10)(b) the annual accounts need not be audited, or the audit may be limited` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 268(10)(b) the annual accounts need not be audited, or the audit may be limited` FALSE TRUE) EQUALS NOTHING
