§ `s 269`

-- (1) the borrowing entity "may, by written notice, require any of its guarantor entities to provide it with any information relating to that guarantor entity"
#ASSERT (`s 269(1) the borrowing entity may require the guarantor entity to provide the information` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 269(1) the borrowing entity may require the guarantor entity to provide the information` FALSE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 269(1) the borrowing entity may require the guarantor entity to provide the information` TRUE FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 269(1) the borrowing entity may require the guarantor entity to provide the information` TRUE TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 269(1) the borrowing entity may require the guarantor entity to provide the information` TRUE TRUE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 269(2) the guarantor entity must provide the borrowing entity with the information` TRUE) EQUALS JUST TRUE
#ASSERT (`s 269(2) the guarantor entity must provide the borrowing entity with the information` FALSE) EQUALS JUST FALSE
-- (2) the date specified must not be earlier than 14 days after the notice: notice on 1 March 2025, so 15 March 2025 is the earliest
#ASSERT (`s 269(2) the date specified in the notice is not earlier than 14 days after the notice is given` (Date 1 3 2025) (Date 15 3 2025)) EQUALS JUST TRUE
#ASSERT (`s 269(2) the date specified in the notice is not earlier than 14 days after the notice is given` (Date 1 3 2025) (Date 14 3 2025)) EQUALS JUST FALSE
-- (2) "before such date": provided on 14 March for a date of 15 March is in time; provided on 15 March is not
#ASSERT (`s 269(2) the information is provided before the date specified in the notice` (Date 15 3 2025) (Date 14 3 2025)) EQUALS JUST TRUE
#ASSERT (`s 269(2) the information is provided before the date specified in the notice` (Date 15 3 2025) (Date 15 3 2025)) EQUALS JUST FALSE
-- (3) the guarantor entity, and every officer in default
#ASSERT (`s 269(3) the person is guilty of an offence` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 269(3) the person is guilty of an offence` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 269(3) the person is guilty of an offence` TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 269(3) the person is guilty of an offence` FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 269(3) the penalty for the offence`) EQUALS (Penalty OF 20000, 0, FALSE, 2000)
-- the rule: notice on 1 March 2025, date specified 15 March 2025, so the last day is 14 March 2025 (13 days)
-- EXPECT FULFILLED
#TRACE `s 269(2) the duty of the guarantor entity to provide the information before the specified date` (((Date 15 3 2025) MINUS (Date 1 3 2025)) MINUS 1) AT 0 WITH
    PARTY `s 268 a guarantor entity` DOES `s 269(2) provide the information to the borrowing entity` AT 13
-- EXPECT BREACH
#TRACE `s 269(2) the duty of the guarantor entity to provide the information before the specified date` (((Date 15 3 2025) MINUS (Date 1 3 2025)) MINUS 1) AT 0 WITH
    PARTY `s 268 a guarantor entity` DOES `s 269(2) provide the information to the borrowing entity` AT 14

§ `s 270`

-- (1) "Where there is, in any prospectus ..., a statement as to any particular purpose or project ..., the borrowing entity must, where there is a trustee"
#ASSERT (`s 270(1) the borrowing entity must make reports to the trustee on the progress of the purpose or project` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 270(1) the borrowing entity must make reports to the trustee on the progress of the purpose or project` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 270(1) the borrowing entity must make reports to the trustee on the progress of the purpose or project` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 270(2) the progress report is included in the report required under section 268(1)` TRUE) EQUALS JUST TRUE
#ASSERT (`s 270(2) the progress report is included in the report required under section 268(1)` FALSE) EQUALS JUST FALSE
-- (3) "When it appears to the trustee ... that such purpose or project has not been achieved or completed (a) within the time stated in the prospectus ...; or (b) where no such time was stated, within a reasonable time"
#ASSERT (`s 270(3) the trustee may give written notice requiring the borrowing entity to repay the moneys` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 270(3) the trustee may give written notice requiring the borrowing entity to repay the moneys` FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 270(3) the trustee may give written notice requiring the borrowing entity to repay the moneys` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 270(3) the trustee may give written notice requiring the borrowing entity to repay the moneys` FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 270(3) the trustee must give written notice requiring the borrowing entity to repay the moneys` (JUST TRUE) TRUE) EQUALS JUST TRUE
#ASSERT (`s 270(3) the trustee must give written notice requiring the borrowing entity to repay the moneys` (JUST TRUE) FALSE) EQUALS JUST FALSE
#ASSERT (`s 270(3) the trustee must give written notice requiring the borrowing entity to repay the moneys` (JUST FALSE) TRUE) EQUALS JUST FALSE
#ASSERT (`s 270(3) the trustee must give written notice requiring the borrowing entity to repay the moneys` NOTHING TRUE) EQUALS NOTHING
-- (3) "within one month after such notice is given, lodge with the Authority a copy": notice on 10 January 2025, so 10 February 2025
#ASSERT (`s 270(3) the copy of the notice is lodged with the Authority in time` (Date 10 1 2025) (Date 10 2 2025)) EQUALS JUST TRUE
#ASSERT (`s 270(3) the copy of the notice is lodged with the Authority in time` (Date 10 1 2025) (Date 11 2 2025)) EQUALS JUST FALSE
-- (4) "The trustee must not give notice under subsection (3) if the trustee is satisfied" of (a), (b) or (c)
#ASSERT (`s 270(4) the trustee must not give notice under subsection (3)` TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 270(4) the trustee must not give notice under subsection (3)` FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 270(4) the trustee must not give notice under subsection (3)` FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 270(4) the trustee must not give notice under subsection (3)` FALSE FALSE FALSE) EQUALS JUST FALSE
-- (5) arguments: notice received; moneys owing; (a) notice before acceptance; (b)(i) specified; (b)(ii) offered to repay; demanded in writing; day notice received; day demanded; longer time in days
-- liable: notice received, moneys owing, no exception
#ASSERT (`s 270(5) the borrowing entity is liable to repay the moneys` TRUE TRUE FALSE FALSE FALSE FALSE (Date 1 3 2025) (Date 1 3 2025) 0) EQUALS JUST TRUE
-- no notice received, or nothing owing
#ASSERT (`s 270(5) the borrowing entity is liable to repay the moneys` FALSE TRUE FALSE FALSE FALSE FALSE (Date 1 3 2025) (Date 1 3 2025) 0) EQUALS JUST FALSE
#ASSERT (`s 270(5) the borrowing entity is liable to repay the moneys` TRUE FALSE FALSE FALSE FALSE FALSE (Date 1 3 2025) (Date 1 3 2025) 0) EQUALS JUST FALSE
-- unless (a)
#ASSERT (`s 270(5) the borrowing entity is liable to repay the moneys` TRUE TRUE TRUE FALSE FALSE FALSE (Date 1 3 2025) (Date 1 3 2025) 0) EQUALS JUST FALSE
-- unless (b): specified and offered to repay, and no demand within 14 days: received 1 March 2025, so the 14 days end on 15 March 2025
#ASSERT (`s 270(5) the borrowing entity is liable to repay the moneys` TRUE TRUE FALSE TRUE TRUE FALSE (Date 1 3 2025) (Date 1 3 2025) 0) EQUALS JUST FALSE
#ASSERT (`s 270(5) the borrowing entity is liable to repay the moneys` TRUE TRUE FALSE TRUE TRUE TRUE (Date 1 3 2025) (Date 16 3 2025) 0) EQUALS JUST FALSE
-- a demand on the last day (15 March 2025) is within the 14 days, so exception (b) does not hold and the borrowing entity is liable
#ASSERT (`s 270(5) the borrowing entity is liable to repay the moneys` TRUE TRUE FALSE TRUE TRUE TRUE (Date 1 3 2025) (Date 15 3 2025) 0) EQUALS JUST TRUE
-- "or such longer time as was specified in the notice": 30 days, so the last day is 31 March 2025
#ASSERT (`s 270(5) the borrowing entity is liable to repay the moneys` TRUE TRUE FALSE TRUE TRUE TRUE (Date 1 3 2025) (Date 31 3 2025) 30) EQUALS JUST TRUE
#ASSERT (`s 270(5) the borrowing entity is liable to repay the moneys` TRUE TRUE FALSE TRUE TRUE TRUE (Date 1 3 2025) (Date 1 4 2025) 30) EQUALS JUST FALSE
-- (b) needs both (i) and (ii)
#ASSERT (`s 270(5) the borrowing entity is liable to repay the moneys` TRUE TRUE FALSE TRUE FALSE FALSE (Date 1 3 2025) (Date 1 3 2025) 0) EQUALS JUST TRUE
-- (6)
#ASSERT (`s 270(6) the purpose in the notice is treated as the purpose specified in the prospectus` TRUE) EQUALS JUST TRUE
#ASSERT (`s 270(6) the purpose in the notice is treated as the purpose specified in the prospectus` FALSE) EQUALS NOTHING
