#ASSERT `s 137M(2)(b) the trustee-manager may require the other person who holds the interest as trustee to indicate the persons for whom it is held` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137M(2)(b) the trustee-manager may require the other person who holds the interest as trustee to indicate the persons for whom it is held` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING

