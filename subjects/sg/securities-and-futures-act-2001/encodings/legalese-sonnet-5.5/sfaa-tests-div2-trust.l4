IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-interests`
IMPORT `sfaa-div2-trust`

-- Tests for sfaa-div2-trust.l4 (sections 137H to 137M). Every expected value is written from the text, beside the assertion.
-- Most of this file is generated from the Division 1 tests, with the same words changed as in the module (the module's header says so); sections 137H and 137J(1) are written here.
-- Dates: 2 November 2026 is a Monday.


§ `s 137H(1)`
#ASSERT `s 137H(1) section 137H has effect for the purposes of Division 2 and does not affect any other provision` TRUE EQUALS JUST TRUE
#ASSERT `s 137H(1) section 137H has effect for the purposes of Division 2 and does not affect any other provision` FALSE EQUALS JUST FALSE

§ `s 137H(2) and (3): the business trusts of Division 2`
-- a registered business trust with units listed: within paragraph (2); not listed: the text's no
#ASSERT `s 137H(2) the trust is a registered business trust for the purposes of Division 2` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137H(2) the trust is a registered business trust for the purposes of Division 2` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 137H(2) the trust is a registered business trust for the purposes of Division 2` FALSE TRUE EQUALS JUST FALSE
-- a recognised business trust needs a primary listing as well
#ASSERT `s 137H(3) the trust is a recognised business trust for the purposes of Division 2` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137H(3) the trust is a recognised business trust for the purposes of Division 2` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 137H(3) the trust is a recognised business trust for the purposes of Division 2` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 137H(3) the trust is a recognised business trust for the purposes of Division 2` FALSE TRUE TRUE EQUALS JUST FALSE
-- the combining function: either is enough; both no is the text's no; a limb the caller could not answer is not a no
#ASSERT `s 137H the trust is a business trust within Division 2` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 137H the trust is a business trust within Division 2` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 137H the trust is a business trust within Division 2` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 137H the trust is a business trust within Division 2` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 137H the trust is a business trust within Division 2` NOTHING NOTHING EQUALS NOTHING

§ `s 137H(4): section 4 applies (the keel's function is called)`
#ASSERT `s 137H(4) the person has an interest in the securities or securities-based derivatives contracts under Division 2` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
-- disregarded under s 4(10): no interest
#ASSERT `s 137H(4) the person has an interest in the securities or securities-based derivatives contracts under Division 2` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
-- every route fails: the keel says no
#ASSERT `s 137H(4) the person has an interest in the securities or securities-based derivatives contracts under Division 2` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- not a security or a securities-based derivatives contract (a unit in a collective investment scheme, say): outside the wording of this Division
#ASSERT `s 137H(4) the person has an interest in the securities or securities-based derivatives contracts under Division 2` FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING

§ `s 137H(5): section 130(6) and (7) apply to listed provisions`
#ASSERT `s 137H(5) section 130(6) and (7) apply to the provision` TRUE EQUALS JUST TRUE
-- a provision the subsection does not list is outside it
#ASSERT `s 137H(5) section 130(6) and (7) apply to the provision` FALSE EQUALS NOTHING

§ `s 137I: who must comply, exemption, extension`
#ASSERT `s 137I(1) the obligation to comply with Division 2 extends to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137I(1) the obligation to comply with Division 2 extends to the person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 137I(1) the obligation to comply with Division 2 extends to the person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 137I(2) Division 2 extends to the act or omission` TRUE EQUALS JUST TRUE
#ASSERT `s 137I(2) Division 2 extends to the act or omission` FALSE EQUALS NOTHING
#ASSERT `s 137I(3) the person is exempt from the provision of Division 2` TRUE EQUALS JUST TRUE
#ASSERT `s 137I(3) the person is exempt from the provision of Division 2` FALSE EQUALS NOTHING
#ASSERT `s 137I(4) the exempted person must comply with the condition or restriction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137I(4) the exempted person must comply with the condition or restriction` TRUE FALSE EQUALS NOTHING
#ASSERT `s 137I(4) the exempted person must comply with the condition or restriction` FALSE TRUE EQUALS NOTHING
-- s 137I(5): the offence, and the split site (i) both ways
#ASSERT `s 137I(5) the person is guilty of an offence of contravening a condition or restriction` TRUE EQUALS JUST TRUE
#ASSERT `s 137I(5) the person is guilty of an offence of contravening a condition or restriction` FALSE EQUALS NOTHING
#ASSERT `s 137I(5) the penalty on conviction` EQUALS Penalty OF 50000, 0, FALSE, 5000
-- s 137I(6): the Authority's power on application (split site (ii)): applied, and not applied
#ASSERT `s 137I(6) the Authority has power to extend, or further extend, the time for giving the notice` TRUE EQUALS JUST TRUE
#ASSERT `s 137I(6) the Authority has power to extend, or further extend, the time for giving the notice` FALSE EQUALS NOTHING
-- the last day after an extension: the later day if the Authority has extended; the original otherwise
#ASSERT `s 137I(6) the last day for giving the notice, as extended on the person's application` (Date 4 11 2026) TRUE (Date 11 11 2026) EQUALS Date 11 11 2026
#ASSERT `s 137I(6) the last day for giving the notice, as extended on the person's application` (Date 4 11 2026) FALSE (Date 11 11 2026) EQUALS Date 4 11 2026
#ASSERT `s 137I(6) the last day for giving the notice, as extended on the person's application` (Date 4 11 2026) TRUE (Date 2 11 2026) EQUALS Date 4 11 2026

§ `s 137I(4) and (5): the prohibition as a regulative rule, and its breach path`
-- EXPECT BREACH
#TRACE `s 137I(4) and (5) the exempted person shall not contravene a condition or restriction` AT 0 WITH
    PARTY Individual "the exempted person" DOES `s 137I contravene a condition or restriction imposed under subsection (4)` AT 1
-- EXPECT RESIDUAL
#TRACE `s 137I(4) and (5) the exempted person shall not contravene a condition or restriction` AT 0 WITH
    (WAITUNTIL 5)


§ `s 137J(1): who the application reaches`
#ASSERT `s 137J(1) sections 135 to 137B apply to the substantial unitholder` TRUE TRUE EQUALS JUST TRUE
-- a person who is not a substantial unitholder, or a trust outside Division 2: the subsection says nothing about them
#ASSERT `s 137J(1) sections 135 to 137B apply to the substantial unitholder` TRUE FALSE EQUALS NOTHING
#ASSERT `s 137J(1) sections 135 to 137B apply to the substantial unitholder` FALSE TRUE EQUALS NOTHING


§ `s 137J(2): intentional or reckless contravention, or knowingly false information (split site (i), both readings)`
-- intentional contravention of one of the named sections: guilty
#ASSERT `s 137J(2) the person is guilty of an offence under subsection (2)` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- knowingly false information in purported compliance: guilty
#ASSERT `s 137J(2) the person is guilty of an offence under subsection (2)` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- a contravention that is not intentional or reckless: not covered by subsection (1), which says who is guilty and not who is innocent
#ASSERT `s 137J(2) the person is guilty of an offence under subsection (2)` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- false information the person did not know to be false: not covered by subsection (1)
#ASSERT `s 137J(2) the person is guilty of an offence under subsection (2)` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 137J(2) the person is guilty of an offence under subsection (2)` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- the penalty: an individual and a corporation
#ASSERT `s 137J(2) the penalty on conviction` TRUE FALSE EQUALS JUST (Penalty OF 250000, 24, TRUE, 25000)
#ASSERT `s 137J(2) the penalty on conviction` FALSE TRUE EQUALS JUST (Penalty OF 250000, 0, FALSE, 25000)
-- neither: the paragraphs name only those two cases
#ASSERT `s 137J(2) the penalty on conviction` FALSE FALSE EQUALS NOTHING

§ `s 137J(3): the lesser offence`
-- a contravention that is not intentional or reckless
#ASSERT `s 137J(3) the person is guilty of an offence under subsection (3)` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- false or misleading information without the knowledge or recklessness of subsection (1)
#ASSERT `s 137J(3) the person is guilty of an offence under subsection (3)` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- an intentional contravention is within subsection (1) and carved out of this one ("in circumstances other than as set out in subsection (1)")
#ASSERT `s 137J(3) the person is guilty of an offence under subsection (3)` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- no contravention and no false information: not covered
#ASSERT `s 137J(3) the person is guilty of an offence under subsection (3)` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 137J(3) the penalty on conviction` EQUALS Penalty OF 25000, 0, FALSE, 2500

§ `s 137J(4): the bar on proceedings`
#ASSERT `s 137J(4) no proceedings may be instituted for an offence under section 137J` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137J(4) no proceedings may be instituted for an offence under section 137J` FALSE TRUE EQUALS JUST TRUE
-- outside both triggers the bar does not apply (marginal reading (b))
#ASSERT `s 137J(4) no proceedings may be instituted for an offence under section 137J` FALSE FALSE EQUALS JUST FALSE



§ `s 137K(1): keeping and entering`
#ASSERT `s 137K(1) the trustee-manager must keep a register` TRUE EQUALS JUST TRUE
-- not a trustee-manager as section 130(2) reads the word: "The trustee-manager of a registered business trust or recognised business trust must keep a register" says nothing about it
#ASSERT `s 137K(1) the trustee-manager must keep a register` FALSE EQUALS NOTHING
#ASSERT `s 137K(1) the trustee-manager must immediately enter the names and information in the register` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137K(1) the trustee-manager must immediately enter the names and information in the register` TRUE FALSE EQUALS NOTHING
#ASSERT `s 137K(1) the trustee-manager must immediately enter the names and information in the register` FALSE TRUE EQUALS NOTHING
-- "immediately" is read as a window of nought days (fork register A6): an entry on the day of receipt is in time, one a day later is not
-- EXPECT FULFILLED
#TRACE `s 137K(1) the trustee-manager must immediately enter the names and information in the register` (Individual "the trustee-manager") AT 0 WITH
    PARTY Individual "the trustee-manager" DOES `s 137K enter the names and information in the register` AT 0
-- EXPECT BREACH
#TRACE `s 137K(1) the trustee-manager must immediately enter the names and information in the register` (Individual "the trustee-manager") AT 0 WITH
    PARTY Individual "the trustee-manager" DOES `s 137K enter the names and information in the register` AT 1
-- EXPECT BREACH
#TRACE `s 137K(1) the trustee-manager must immediately enter the names and information in the register` (Individual "the trustee-manager") AT 0 WITH
    (WAITUNTIL 2)

§ `s 137K(2): where the register is kept, and what inspection costs`
-- a trustee-manager with a registered office keeps it there; kept elsewhere is the text's no
#ASSERT `s 137K(2) the register is kept at the place the subsection requires` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137K(2) the register is kept at the place the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
-- no registered office: the principal place of business in Singapore
#ASSERT `s 137K(2) the register is kept at the place the subsection requires` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 137K(2) the register is kept at the place the subsection requires` FALSE TRUE FALSE EQUALS JUST FALSE
-- a unitholder inspects without charge; anyone else pays at most $2
#ASSERT `s 137K(2) the most the trustee-manager may charge for each inspection of the register, in Singapore dollars` TRUE EQUALS 0
#ASSERT `s 137K(2) the most the trustee-manager may charge for each inspection of the register, in Singapore dollars` FALSE EQUALS 2

§ `s 137K(3): copies`
-- $1 a page
#ASSERT `s 137K(3) the most the trustee-manager may charge in advance for each page copied, in Singapore dollars` EQUALS 1
-- request received Monday 2 Nov: 14 days later is Monday 16 Nov
