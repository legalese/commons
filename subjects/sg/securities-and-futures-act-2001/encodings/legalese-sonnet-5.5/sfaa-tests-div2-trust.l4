#ASSERT `s 137K(3) the copy is sent in time` (Date 2 11 2026) FALSE (Date 23 11 2026) (Date 16 11 2026) EQUALS JUST TRUE
#ASSERT `s 137K(3) the copy is sent in time` (Date 2 11 2026) FALSE (Date 23 11 2026) (Date 17 11 2026) EQUALS JUST FALSE
#ASSERT `s 137K(3) the copy is sent in time` (Date 2 11 2026) TRUE (Date 23 11 2026) (Date 23 11 2026) EQUALS JUST TRUE
#ASSERT `s 137K(3) the copy is sent in time` (Date 2 11 2026) TRUE (Date 23 11 2026) (Date 24 11 2026) EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 137K(3) the trustee-manager must send the copy within 14 days` (Individual "the trustee-manager") AT 0 WITH
    PARTY Individual "the trustee-manager" DOES `s 137K send the copy of the register` AT 14
-- EXPECT BREACH
#TRACE `s 137K(3) the trustee-manager must send the copy within 14 days` (Individual "the trustee-manager") AT 0 WITH
    PARTY Individual "the trustee-manager" DOES `s 137K send the copy of the register` AT 15
-- EXPECT BREACH
#TRACE `s 137K(3) the trustee-manager must send the copy within 14 days` (Individual "the trustee-manager") AT 0 WITH
    (WAITUNTIL 20)

