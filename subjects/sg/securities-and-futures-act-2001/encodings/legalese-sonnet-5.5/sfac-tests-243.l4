IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfac-243`

-- Tests for sfac-243.l4 (ss 243 to 248). Every expected value is written from the text of the Act (SFA2001.txt lines 39813 to 40238) before the code was run.
-- The arguments of a call are in the order of the function's GIVEN; a comment above a group names them.

§ `s 243(1) and (2): what a prospectus must contain`
-- s 243(1) arguments: a prospectus for an offer; contains all the information as (2) limits it; contains the matters the Authority prescribed
#ASSERT (`s 243(1) the prospectus contains what it must contain` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(1) the prospectus contains what it must contain` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 243(1) the prospectus contains what it must contain` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 243(1) the prospectus contains what it must contain` FALSE TRUE TRUE) EQUALS NOTHING
-- s 243(2) arguments: the item is information investors would reasonably require; reasonable to expect to find it; a relevant person actually knows it; ought reasonably to have obtained it
#ASSERT (`s 243(2) the item of information must be contained in the prospectus` TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(2) the item of information must be contained in the prospectus` TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
-- "only to the extent": not reasonable to expect it, or nobody relevant knows or ought to have found it
#ASSERT (`s 243(2) the item of information must be contained in the prospectus` TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 243(2) the item of information must be contained in the prospectus` TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
-- not information within (1)(a) at all
#ASSERT (`s 243(2) the item of information must be contained in the prospectus` FALSE TRUE TRUE TRUE) EQUALS NOTHING

§ `s 243(3): the matters`
#ASSERT (`s 243(3)(a) the rights and liabilities attaching to the securities or contracts are a matter the information must relate to` TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(3)(a) the rights and liabilities attaching to the securities or contracts are a matter the information must relate to` FALSE) EQUALS NOTHING
#ASSERT (`s 243(3)(b) the issuer's assets and liabilities, profits and losses, financial position and performance, and prospects are a matter the information must relate to` TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(3)(b) the issuer's assets and liabilities, profits and losses, financial position and performance, and prospects are a matter the information must relate to` FALSE) EQUALS NOTHING
#ASSERT (`s 243(3)(c) the underlying entity's assets and liabilities, profits and losses, financial position and performance, and prospects are a matter the information must relate to` TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(3)(c) the underlying entity's assets and liabilities, profits and losses, financial position and performance, and prospects are a matter the information must relate to` FALSE) EQUALS NOTHING
-- (d) arguments: an offer of units of shares or debentures; the person making the offer is or will be required to issue or deliver; a controlled entity is or will be required
#ASSERT (`s 243(3)(d) the capacity of the person or entity to issue or deliver the units, or to meet its obligations, is a matter the information must relate to` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(3)(d) the capacity of the person or entity to issue or deliver the units, or to meet its obligations, is a matter the information must relate to` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(3)(d) the capacity of the person or entity to issue or deliver the units, or to meet its obligations, is a matter the information must relate to` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 243(3)(d) the capacity of the person or entity to issue or deliver the units, or to meet its obligations, is a matter the information must relate to` FALSE TRUE TRUE) EQUALS NOTHING
-- (e) arguments: an offer of units or derivatives of units in a business trust; the person making the offer is the trustee-manager; the trustee-manager is controlled by the person or its related parties
#ASSERT (`s 243(3)(e) the business trust's and the trustee-manager's assets and liabilities, profits and losses, financial position and performance, and the prospects of the business trust, are a matter the information must relate to` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(3)(e) the business trust's and the trustee-manager's assets and liabilities, profits and losses, financial position and performance, and the prospects of the business trust, are a matter the information must relate to` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(3)(e) the business trust's and the trustee-manager's assets and liabilities, profits and losses, financial position and performance, and the prospects of the business trust, are a matter the information must relate to` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 243(3)(e) the business trust's and the trustee-manager's assets and liabilities, profits and losses, financial position and performance, and the prospects of the business trust, are a matter the information must relate to` FALSE TRUE TRUE) EQUALS NOTHING
-- (f) arguments: derivatives of units issued by an entity A other than the trustee-manager; the person making the offer is A; A is controlled by the person or its related parties
#ASSERT (`s 243(3)(f) the assets and liabilities, profits and losses, financial position and performance, and prospects of the issuing entity are a matter the information must relate to` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(3)(f) the assets and liabilities, profits and losses, financial position and performance, and prospects of the issuing entity are a matter the information must relate to` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(3)(f) the assets and liabilities, profits and losses, financial position and performance, and prospects of the issuing entity are a matter the information must relate to` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 243(3)(f) the assets and liabilities, profits and losses, financial position and performance, and prospects of the issuing entity are a matter the information must relate to` FALSE TRUE TRUE) EQUALS NOTHING
-- (g) arguments: an offer of derivatives of units in the business trust; the person making the offer is or will be required to issue or deliver; a controlled entity is or will be required
#ASSERT (`s 243(3)(g) the capacity of the person or entity to issue or deliver the units or derivatives of units, or to meet its obligations, is a matter the information must relate to` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(3)(g) the capacity of the person or entity to issue or deliver the units or derivatives of units, or to meet its obligations, is a matter the information must relate to` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(3)(g) the capacity of the person or entity to issue or deliver the units or derivatives of units, or to meet its obligations, is a matter the information must relate to` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 243(3)(g) the capacity of the person or entity to issue or deliver the units or derivatives of units, or to meet its obligations, is a matter the information must relate to` FALSE TRUE TRUE) EQUALS NOTHING

§ `s 243(4) to (8)`
-- s 243(4) arguments: a decision is made under (1)(a); regard to (a) the nature; regard to (b) what investors know; regard to (c) what advisers know
#ASSERT (`s 243(4) regard has been had to the matters` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(4) regard has been had to the matters` TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 243(4) regard has been had to the matters` TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 243(4) regard has been had to the matters` TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 243(4) regard has been had to the matters` FALSE TRUE TRUE TRUE) EQUALS NOTHING
-- s 243(4A) arguments: the reference document is lodged together with the prospectus; every prescribed condition is met
#ASSERT (`s 243(4A) the information may be incorporated in the prospectus by reference to the reference document` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(4A) the information may be incorporated in the prospectus by reference to the reference document` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 243(4A) the information may be incorporated in the prospectus by reference to the reference document` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 243(4B) the information is part of the prospectus` TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(4B) the information is part of the prospectus` FALSE) EQUALS NOTHING
-- s 243(5) arguments: the person making the offer; a director of the entity making the offer; the issuer; a director or proposed director of the issuer; named underwriter with consent; named stockbroker who participates in the preparation; named as having made a statement; named as having performed a function
#ASSERT (`s 243(5) the person's knowledge is relevant` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(5) the person's knowledge is relevant` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(5) the person's knowledge is relevant` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(5) the person's knowledge is relevant` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(5) the person's knowledge is relevant` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(5) the person's knowledge is relevant` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(5) the person's knowledge is relevant` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(5) the person's knowledge is relevant` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
-- "only if": none of the eight
#ASSERT (`s 243(5) the person's knowledge is relevant` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- s 243(6) arguments: requires an applicant to waive compliance; purports to affect the applicant with notice of something not in the prospectus
#ASSERT (`s 243(6) the condition is void` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 243(6) the condition is void` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(6) the condition is void` FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 243(7) this section affects the liability` TRUE) EQUALS JUST FALSE
#ASSERT (`s 243(7) this section affects the liability` FALSE) EQUALS NOTHING
-- s 243(8) arguments: the term is used in s 243(3)(e) for a business trust; the figures (the prospects) are as defined
#ASSERT (`s 243(8) "assets and liabilities, profits and losses, financial position and performance" the figures are those of the business trust` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(8) "assets and liabilities, profits and losses, financial position and performance" the figures are those of the business trust` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 243(8) "assets and liabilities, profits and losses, financial position and performance" the figures are those of the business trust` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 243(8) "prospects" the prospects are those of the business trust` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 243(8) "prospects" the prospects are those of the business trust` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 243(8) "prospects" the prospects are those of the business trust` FALSE TRUE) EQUALS NOTHING

§ `s 245: over-subscriptions and asset-backing`
-- s 245(1) arguments: the body is an entity; it accepts or retains subscriptions in excess of the amount of the issue; the prospectus reserves the right; it states a limit as a specific sum; the amount of the issue; the limit
-- 25% of 1,000,000 is 250,000
#ASSERT (`s 245(1) the entity must not accept or retain the subscriptions` TRUE TRUE TRUE TRUE 1000000 250000) EQUALS JUST FALSE
#ASSERT (`s 245(1) the entity must not accept or retain the subscriptions` TRUE TRUE TRUE TRUE 1000000 250001) EQUALS JUST TRUE
#ASSERT (`s 245(1) the entity must not accept or retain the subscriptions` TRUE TRUE FALSE TRUE 1000000 100000) EQUALS JUST TRUE
#ASSERT (`s 245(1) the entity must not accept or retain the subscriptions` TRUE TRUE TRUE FALSE 1000000 0) EQUALS JUST TRUE
#ASSERT (`s 245(1) the entity must not accept or retain the subscriptions` TRUE TRUE FALSE FALSE 1000000 0) EQUALS JUST TRUE
-- no excess subscriptions, or not an entity: the bar is limited by its own wording (SPLIT-SITE (i): NOTHING)
#ASSERT (`s 245(1) the entity must not accept or retain the subscriptions` TRUE FALSE FALSE FALSE 1000000 0) EQUALS NOTHING
#ASSERT (`s 245(1) the entity must not accept or retain the subscriptions` FALSE TRUE FALSE FALSE 1000000 0) EQUALS NOTHING
-- EXPECT BREACH: the bar bites and the entity accepts the excess
#TRACE (`s 245(1) the entity shall not accept or retain over-subscriptions` (`A corporation` "Bond Co Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`A corporation` "Bond Co Pte Ltd") DOES `s 245(1) accept or retain subscriptions in excess of the amount of the issue` AT 5

-- EXPECT FULFILLED: the prospectus reserves the right with a limit, so the bar does not bite
#TRACE (`s 245(1) the entity shall not accept or retain over-subscriptions` (`A corporation` "Bond Co Pte Ltd") (JUST FALSE)) AT 0 WITH
    PARTY (`A corporation` "Bond Co Pte Ltd") DOES `s 245(1) accept or retain subscriptions in excess of the amount of the issue` AT 5

-- s 245(2)(a) arguments: regulations for subsection (2) apply; the prospectus specifies the right to accept over-subscriptions; the entity makes, authorises or permits a statement of the asset-backing; the statement is only to the total tangible assets and total liabilities of the entity and its guarantors
#ASSERT (`s 245(2)(a) the entity must not make, authorise or permit the statement of asset-backing` FALSE TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 245(2)(a) the entity must not make, authorise or permit the statement of asset-backing` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
-- "where": the entity has not reserved the right
#ASSERT (`s 245(2)(a) the entity must not make, authorise or permit the statement of asset-backing` FALSE FALSE TRUE FALSE) EQUALS JUST FALSE
-- no statement of asset-backing is made (SPLIT-SITE (i): NOTHING)
#ASSERT (`s 245(2)(a) the entity must not make, authorise or permit the statement of asset-backing` FALSE TRUE FALSE FALSE) EQUALS NOTHING
-- "Subject to regulations": the text points outside itself
#ASSERT (`s 245(2)(a) the entity must not make, authorise or permit the statement of asset-backing` TRUE TRUE TRUE FALSE) EQUALS NOTHING
-- EXPECT BREACH
#TRACE (`s 245(2)(a) the entity shall not make, authorise or permit a statement of asset-backing` (`A corporation` "Bond Co Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`A corporation` "Bond Co Pte Ltd") DOES `s 245(2) make, authorise or permit a statement of the asset-backing` AT 2

-- s 245(2)(b) arguments: the prospectus specifies the right to accept over-subscriptions; it contains the statement of total assets and total liabilities
#ASSERT (`s 245(2)(b) the prospectus contains the statement of total assets and total liabilities` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 245(2)(b) the prospectus contains the statement of total assets and total liabilities` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 245(2)(b) the prospectus contains the statement of total assets and total liabilities` FALSE FALSE) EQUALS NOTHING
-- s 245(3) arguments: the answer of (1); the answer of (2)(a); the answer of (2)(b)
#ASSERT (`s 245(3) the person is guilty of an offence` (JUST TRUE) (JUST FALSE) NOTHING) EQUALS JUST TRUE
#ASSERT (`s 245(3) the person is guilty of an offence` (JUST FALSE) (JUST TRUE) NOTHING) EQUALS JUST TRUE
#ASSERT (`s 245(3) the person is guilty of an offence` (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
-- no contravention: the text names the person who contravenes and says nothing of anyone else (SPLIT-SITE (i): NOTHING)
#ASSERT (`s 245(3) the person is guilty of an offence` (JUST FALSE) (JUST FALSE) (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 245(3) the person is guilty of an offence` (JUST FALSE) (JUST FALSE) NOTHING) EQUALS NOTHING
#ASSERT (`s 245(3) the person is guilty of an offence` NOTHING (JUST FALSE) NOTHING) EQUALS NOTHING
#ASSERT (`s 245(3) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 50000
#ASSERT (`s 245(3) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 5000

§ `s 246: the profile statement`
-- s 246(1) arguments: a profile statement; identifies the person making the offer; the person is not the issuer; identifies the issuer; a business trust offer; identifies the trust, trustee-manager and issuer; identifies the signers; nature of the securities; the risks; amounts payable; copies statement; fair summary statement
#ASSERT (`s 246(1) the profile statement contains what it must contain` TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
-- (ia) applies where the person making the offer is not the issuer
#ASSERT (`s 246(1) the profile statement contains what it must contain` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 246(1) the profile statement contains what it must contain` TRUE TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
-- (ib) applies in a business trust offer
#ASSERT (`s 246(1) the profile statement contains what it must contain` TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 246(1) the profile statement contains what it must contain` TRUE TRUE FALSE FALSE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
-- each of the other limbs missing in turn
#ASSERT (`s 246(1) the profile statement contains what it must contain` TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 246(1) the profile statement contains what it must contain` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 246(1) the profile statement contains what it must contain` TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 246(1) the profile statement contains what it must contain` TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 246(1) the profile statement contains what it must contain` TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 246(1) the profile statement contains what it must contain` TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 246(1) the profile statement contains what it must contain` TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 246(1) the profile statement contains what it must contain` FALSE TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE) EQUALS NOTHING
-- s 246(2) arguments: a profile statement; contains a false or misleading statement; contains material information not in the prospectus; contains material information that differs from the prospectus
#ASSERT (`s 246(2) the profile statement contains something it must not contain` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 246(2) the profile statement contains something it must not contain` TRUE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 246(2) the profile statement contains something it must not contain` TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
-- none of the three: the bar is limited by its own wording (SPLIT-SITE (i): NOTHING)
#ASSERT (`s 246(2) the profile statement contains something it must not contain` TRUE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 246(2) the profile statement contains something it must not contain` FALSE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 246(3) the information presented is a statement for the purposes of subsection (2)(a)` TRUE) EQUALS JUST TRUE
#ASSERT (`s 246(3) the information presented is a statement for the purposes of subsection (2)(a)` FALSE) EQUALS NOTHING

§ `s 247: exemption from requirements as to form or content`
-- s 247(1) and (3) arguments: the Authority has exempted the person, document or class; the exemption extends to the requirement asked about
#ASSERT (`s 247(1) and (3) the person or document is exempt from the requirement of form or content` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 247(1) and (3) the person or document is exempt from the requirement of form or content` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 247(1) and (3) the person or document is exempt from the requirement of form or content` FALSE TRUE) EQUALS NOTHING
-- s 247(2) arguments: the opinion that the cost outweighs the protection; the opinion that it would not be prejudicial to the public interest
#ASSERT (`s 247(2) the Authority is barred from granting the exemption under subsection (1)` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 247(2) the Authority is barred from granting the exemption under subsection (1)` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 247(2) the Authority is barred from granting the exemption under subsection (1)` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 247(2) the Authority is barred from granting the exemption under subsection (1)` FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 247(5) the person is guilty of an offence` TRUE) EQUALS JUST TRUE
#ASSERT (`s 247(5) the person is guilty of an offence` FALSE) EQUALS NOTHING
#ASSERT (`s 247(5) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 50000
#ASSERT (`s 247(5) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 5000
-- EXPECT BREACH: the person contravenes a condition
#TRACE (`s 247(5) the person shall not contravene a condition or restriction` (Individual "Jo Tan")) AT 0 WITH
    PARTY (Individual "Jo Tan") DOES `s 247(5) contravene the condition or restriction` AT 3

-- EXPECT RESIDUAL: the person has done nothing yet
#TRACE (`s 247(5) the person shall not contravene a condition or restriction` (Individual "Jo Tan")) AT 0 WITH

§ `s 248: governmental and international entities`
-- s 248(1) arguments: governmental character; international character
#ASSERT (`s 248(1) this section applies to the entity` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 248(1) this section applies to the entity` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 248(1) this section applies to the entity` FALSE TRUE) EQUALS JUST FALSE
-- s 248(2) arguments: the answer of s 248(1); applied in writing; the Authority considers the requirements unduly burdensome
#ASSERT (`s 248(2) the Authority may exempt the entity from the requirements` (JUST TRUE) TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 248(2) the Authority may exempt the entity from the requirements` (JUST TRUE) TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 248(2) the Authority may exempt the entity from the requirements` (JUST TRUE) FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 248(2) the Authority may exempt the entity from the requirements` (JUST FALSE) TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 248(2) the Authority may exempt the entity from the requirements` NOTHING TRUE TRUE) EQUALS NOTHING
-- s 248(3) arguments: the Authority has imposed the requirement; the number resident in Singapore who have signed; the minimum number decided
#ASSERT (`s 248(3) the requirement as to signing by directors resident in Singapore is met` TRUE 2 2) EQUALS JUST TRUE
#ASSERT (`s 248(3) the requirement as to signing by directors resident in Singapore is met` TRUE 3 2) EQUALS JUST TRUE
#ASSERT (`s 248(3) the requirement as to signing by directors resident in Singapore is met` TRUE 1 2) EQUALS JUST FALSE
#ASSERT (`s 248(3) the requirement as to signing by directors resident in Singapore is met` FALSE 1 2) EQUALS NOTHING
-- s 248(4) arguments: no director or equivalent person is resident in Singapore; the authorisation is supported by a board resolution
#ASSERT (`s 248(4) the Authority may permit a duly authorised agent to sign` TRUE TRUE) EQUALS JUST TRUE
-- "so long as" closes the grant
#ASSERT (`s 248(4) the Authority may permit a duly authorised agent to sign` TRUE FALSE) EQUALS JUST FALSE
-- the "in the event" gate fails
#ASSERT (`s 248(4) the Authority may permit a duly authorised agent to sign` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 248(5) the Authority may grant the exemption applied for` TRUE) EQUALS JUST TRUE
#ASSERT (`s 248(5) the Authority may grant the exemption applied for` FALSE) EQUALS NOTHING
#ASSERT (`s 248(6) the document is deemed to be a prospectus or profile statement for the purposes of this Division` TRUE) EQUALS JUST TRUE
#ASSERT (`s 248(6) the document is deemed to be a prospectus or profile statement for the purposes of this Division` FALSE) EQUALS NOTHING
#ASSERT (`s 248(6) a copy of the document must be registered by the Authority` TRUE) EQUALS JUST TRUE
#ASSERT (`s 248(6) a copy of the document must be registered by the Authority` FALSE) EQUALS NOTHING
