IMPORT prelude
IMPORT daydate
IMPORT `sfa-interests`

-- Tests for sfa-interests.
-- Expected values are written from the text of the Act (the quote lines in the module under test), never from its output.

-- authority to dispose
#ASSERT `s 4(1) the person has authority over the disposal of the thing` TRUE FALSE EQUALS JUST TRUE
-- authority to control the disposal
#ASSERT `s 4(1) the person has authority over the disposal of the thing` FALSE TRUE EQUALS JUST TRUE
-- both
#ASSERT `s 4(1) the person has authority over the disposal of the thing` TRUE TRUE EQUALS JUST TRUE
-- neither: this route fails (reading (a))
#ASSERT `s 4(1) the person has authority over the disposal of the thing` FALSE FALSE EQUALS JUST FALSE

-- authority over the disposal
#ASSERT (`s 4 the person has an interest in the securities, securities-based derivatives contracts or units` WITH `the thing is a security, a securities-based derivatives contract or a unit in a collective investment scheme` IS TRUE, `the person has an interest by the route of s 4(1)` IS (JUST TRUE), `the person has an interest by the route of s 4(3)` IS (JUST FALSE), `the person has an interest by the route of s 4(4)` IS (JUST FALSE), `the person has an interest by the route of s 4(5)` IS (JUST FALSE), `the person has an interest by the route of s 4(7)` IS (JUST FALSE), `the person has an interest by the route of s 4(8)` IS (JUST FALSE), `the interest is to be disregarded under section 4(10)` IS (JUST FALSE)) EQUALS JUST TRUE
-- the route of s 4(3) alone
#ASSERT (`s 4 the person has an interest in the securities, securities-based derivatives contracts or units` WITH `the thing is a security, a securities-based derivatives contract or a unit in a collective investment scheme` IS TRUE, `the person has an interest by the route of s 4(1)` IS (JUST FALSE), `the person has an interest by the route of s 4(3)` IS (JUST TRUE), `the person has an interest by the route of s 4(4)` IS (JUST FALSE), `the person has an interest by the route of s 4(5)` IS (JUST FALSE), `the person has an interest by the route of s 4(7)` IS (JUST FALSE), `the person has an interest by the route of s 4(8)` IS (JUST FALSE), `the interest is to be disregarded under section 4(10)` IS (JUST FALSE)) EQUALS JUST TRUE
-- the route of s 4(4) alone
#ASSERT (`s 4 the person has an interest in the securities, securities-based derivatives contracts or units` WITH `the thing is a security, a securities-based derivatives contract or a unit in a collective investment scheme` IS TRUE, `the person has an interest by the route of s 4(1)` IS (JUST FALSE), `the person has an interest by the route of s 4(3)` IS (JUST FALSE), `the person has an interest by the route of s 4(4)` IS (JUST TRUE), `the person has an interest by the route of s 4(5)` IS (JUST FALSE), `the person has an interest by the route of s 4(7)` IS (JUST FALSE), `the person has an interest by the route of s 4(8)` IS (JUST FALSE), `the interest is to be disregarded under section 4(10)` IS (JUST FALSE)) EQUALS JUST TRUE
-- the route of s 4(5) alone
#ASSERT (`s 4 the person has an interest in the securities, securities-based derivatives contracts or units` WITH `the thing is a security, a securities-based derivatives contract or a unit in a collective investment scheme` IS TRUE, `the person has an interest by the route of s 4(1)` IS (JUST FALSE), `the person has an interest by the route of s 4(3)` IS (JUST FALSE), `the person has an interest by the route of s 4(4)` IS (JUST FALSE), `the person has an interest by the route of s 4(5)` IS (JUST TRUE), `the person has an interest by the route of s 4(7)` IS (JUST FALSE), `the person has an interest by the route of s 4(8)` IS (JUST FALSE), `the interest is to be disregarded under section 4(10)` IS (JUST FALSE)) EQUALS JUST TRUE
-- the route of s 4(7) alone
#ASSERT (`s 4 the person has an interest in the securities, securities-based derivatives contracts or units` WITH `the thing is a security, a securities-based derivatives contract or a unit in a collective investment scheme` IS TRUE, `the person has an interest by the route of s 4(1)` IS (JUST FALSE), `the person has an interest by the route of s 4(3)` IS (JUST FALSE), `the person has an interest by the route of s 4(4)` IS (JUST FALSE), `the person has an interest by the route of s 4(5)` IS (JUST FALSE), `the person has an interest by the route of s 4(7)` IS (JUST TRUE), `the person has an interest by the route of s 4(8)` IS (JUST FALSE), `the interest is to be disregarded under section 4(10)` IS (JUST FALSE)) EQUALS JUST TRUE
-- the route of s 4(8) alone
#ASSERT (`s 4 the person has an interest in the securities, securities-based derivatives contracts or units` WITH `the thing is a security, a securities-based derivatives contract or a unit in a collective investment scheme` IS TRUE, `the person has an interest by the route of s 4(1)` IS (JUST FALSE), `the person has an interest by the route of s 4(3)` IS (JUST FALSE), `the person has an interest by the route of s 4(4)` IS (JUST FALSE), `the person has an interest by the route of s 4(5)` IS (JUST FALSE), `the person has an interest by the route of s 4(7)` IS (JUST FALSE), `the person has an interest by the route of s 4(8)` IS (JUST TRUE), `the interest is to be disregarded under section 4(10)` IS (JUST FALSE)) EQUALS JUST TRUE
-- an interest that is to be disregarded under (10): "Subject to this section"
#ASSERT (`s 4 the person has an interest in the securities, securities-based derivatives contracts or units` WITH `the thing is a security, a securities-based derivatives contract or a unit in a collective investment scheme` IS TRUE, `the person has an interest by the route of s 4(1)` IS (JUST TRUE), `the person has an interest by the route of s 4(3)` IS (JUST FALSE), `the person has an interest by the route of s 4(4)` IS (JUST FALSE), `the person has an interest by the route of s 4(5)` IS (JUST FALSE), `the person has an interest by the route of s 4(7)` IS (JUST FALSE), `the person has an interest by the route of s 4(8)` IS (JUST FALSE), `the interest is to be disregarded under section 4(10)` IS (JUST TRUE)) EQUALS JUST FALSE
-- (10) not shown to apply: the interest stands
#ASSERT (`s 4 the person has an interest in the securities, securities-based derivatives contracts or units` WITH `the thing is a security, a securities-based derivatives contract or a unit in a collective investment scheme` IS TRUE, `the person has an interest by the route of s 4(1)` IS (JUST TRUE), `the person has an interest by the route of s 4(3)` IS (JUST FALSE), `the person has an interest by the route of s 4(4)` IS (JUST FALSE), `the person has an interest by the route of s 4(5)` IS (JUST FALSE), `the person has an interest by the route of s 4(7)` IS (JUST FALSE), `the person has an interest by the route of s 4(8)` IS (JUST FALSE), `the interest is to be disregarded under section 4(10)` IS NOTHING) EQUALS JUST TRUE
-- a route not answered
#ASSERT (`s 4 the person has an interest in the securities, securities-based derivatives contracts or units` WITH `the thing is a security, a securities-based derivatives contract or a unit in a collective investment scheme` IS TRUE, `the person has an interest by the route of s 4(1)` IS NOTHING, `the person has an interest by the route of s 4(3)` IS (JUST FALSE), `the person has an interest by the route of s 4(4)` IS (JUST FALSE), `the person has an interest by the route of s 4(5)` IS (JUST FALSE), `the person has an interest by the route of s 4(7)` IS (JUST FALSE), `the person has an interest by the route of s 4(8)` IS (JUST FALSE), `the interest is to be disregarded under section 4(10)` IS (JUST FALSE)) EQUALS NOTHING
-- one route met, another not answered: an interest on any route is an interest
#ASSERT (`s 4 the person has an interest in the securities, securities-based derivatives contracts or units` WITH `the thing is a security, a securities-based derivatives contract or a unit in a collective investment scheme` IS TRUE, `the person has an interest by the route of s 4(1)` IS NOTHING, `the person has an interest by the route of s 4(3)` IS (JUST FALSE), `the person has an interest by the route of s 4(4)` IS (JUST FALSE), `the person has an interest by the route of s 4(5)` IS (JUST FALSE), `the person has an interest by the route of s 4(7)` IS (JUST FALSE), `the person has an interest by the route of s 4(8)` IS (JUST TRUE), `the interest is to be disregarded under section 4(10)` IS (JUST FALSE)) EQUALS JUST TRUE
-- every route failed (reading (a))
#ASSERT (`s 4 the person has an interest in the securities, securities-based derivatives contracts or units` WITH `the thing is a security, a securities-based derivatives contract or a unit in a collective investment scheme` IS TRUE, `the person has an interest by the route of s 4(1)` IS (JUST FALSE), `the person has an interest by the route of s 4(3)` IS (JUST FALSE), `the person has an interest by the route of s 4(4)` IS (JUST FALSE), `the person has an interest by the route of s 4(5)` IS (JUST FALSE), `the person has an interest by the route of s 4(7)` IS (JUST FALSE), `the person has an interest by the route of s 4(8)` IS (JUST FALSE), `the interest is to be disregarded under section 4(10)` IS (JUST FALSE)) EQUALS JUST FALSE
-- the thing is not a security, derivatives contract or unit: section 4 does not speak
#ASSERT (`s 4 the person has an interest in the securities, securities-based derivatives contracts or units` WITH `the thing is a security, a securities-based derivatives contract or a unit in a collective investment scheme` IS FALSE, `the person has an interest by the route of s 4(1)` IS (JUST TRUE), `the person has an interest by the route of s 4(3)` IS (JUST FALSE), `the person has an interest by the route of s 4(4)` IS (JUST FALSE), `the person has an interest by the route of s 4(5)` IS (JUST FALSE), `the person has an interest by the route of s 4(7)` IS (JUST FALSE), `the person has an interest by the route of s 4(8)` IS (JUST FALSE), `the interest is to be disregarded under section 4(10)` IS (JUST FALSE)) EQUALS NOTHING

-- restrained or capable of restraint: immaterial for subsection (1); the section 4(1) function does not ask about it
#ASSERT `s 4(2) it is immaterial that the authority is subject to restraint or restriction` TRUE EQUALS JUST TRUE
-- no restraint: subsection (2) has nothing to say
#ASSERT `s 4(2) it is immaterial that the authority is subject to restraint or restriction` FALSE EQUALS NOTHING

-- trust property includes the thing and the person knows or has reasonable grounds to believe they have an interest
#ASSERT `s 4(3) the person is treated as having an interest through a trust` TRUE TRUE EQUALS JUST TRUE
-- the person neither knows nor has reasonable grounds to believe
#ASSERT `s 4(3) the person is treated as having an interest through a trust` TRUE FALSE EQUALS JUST FALSE
-- the trust property does not include the thing
#ASSERT `s 4(3) the person is treated as having an interest through a trust` FALSE TRUE EQUALS JUST FALSE

-- (a): the corporation or its directors are accustomed to act on the person's directions
#ASSERT `s 4(4) the person is treated as having an interest through a corporation the person directs or controls` TRUE TRUE FALSE EQUALS JUST TRUE
-- (b): the person has a controlling interest in the corporation
#ASSERT `s 4(4) the person is treated as having an interest through a corporation the person directs or controls` TRUE FALSE TRUE EQUALS JUST TRUE
-- the corporation has no interest in the thing
#ASSERT `s 4(4) the person is treated as having an interest through a corporation the person directs or controls` FALSE TRUE TRUE EQUALS JUST FALSE
-- neither (a) nor (b)
#ASSERT `s 4(4) the person is treated as having an interest through a corporation the person directs or controls` TRUE FALSE FALSE EQUALS JUST FALSE

-- exactly 20%: "not less than 20%"
#ASSERT `s 4(5) the person is treated as having an interest through a corporation in which the person and associates hold 20% of the votes` TRUE 20 100 EQUALS JUST TRUE
-- 19.99%
#ASSERT `s 4(5) the person is treated as having an interest through a corporation in which the person and associates hold 20% of the votes` TRUE 1999 10000 EQUALS JUST FALSE
-- 20.01%
#ASSERT `s 4(5) the person is treated as having an interest through a corporation in which the person and associates hold 20% of the votes` TRUE 2001 10000 EQUALS JUST TRUE
-- no corporation has an interest in the thing
#ASSERT `s 4(5) the person is treated as having an interest through a corporation in which the person and associates hold 20% of the votes` FALSE 50 100 EQUALS JUST FALSE
-- no votes at all: assumed not to be 20%
#ASSERT `s 4(5) the person is treated as having an interest through a corporation in which the person and associates hold 20% of the votes` TRUE 0 0 EQUALS JUST FALSE

-- an associate for subsection (5): limb the person is a subsidiary of the other person
#ASSERT `s 4(6) the person is an associate of the other person for the purposes of subsection (5)` TRUE FALSE FALSE EQUALS JUST TRUE
-- an associate for subsection (5): limb the person is accustomed or under an obligation to act in accordance with the directions, instructions or wishes of the other person in relation to the thing
#ASSERT `s 4(6) the person is an associate of the other person for the purposes of subsection (5)` FALSE TRUE FALSE EQUALS JUST TRUE
-- an associate for subsection (5): limb the person is a corporation that is, or a majority of whose directors are, accustomed or under an obligation to act in accordance with the other person's directions in relation to the thing
#ASSERT `s 4(6) the person is an associate of the other person for the purposes of subsection (5)` FALSE FALSE TRUE EQUALS JUST TRUE
-- none of (a) to (c)
#ASSERT `s 4(6) the person is an associate of the other person for the purposes of subsection (5)` FALSE FALSE FALSE EQUALS JUST FALSE

-- a contract to purchase
#ASSERT `s 4(7)(a) the person has entered into a contract to purchase the thing` TRUE EQUALS JUST TRUE
-- no such contract
#ASSERT `s 4(7)(a) the person has entered into a contract to purchase the thing` FALSE EQUALS JUST FALSE
-- a right to have the thing transferred (presently or in the future, conditional or not: not asked, it is immaterial)
#ASSERT `s 4(7)(b) the person has a right to have the thing transferred to the person or to the person's order` TRUE FALSE EQUALS JUST TRUE
-- the right arises only by reason of an interest under a trust: see subsection (3) instead
#ASSERT `s 4(7)(b) the person has a right to have the thing transferred to the person or to the person's order` TRUE TRUE EQUALS JUST FALSE
-- no such right
#ASSERT `s 4(7)(b) the person has a right to have the thing transferred to the person or to the person's order` FALSE FALSE EQUALS JUST FALSE
-- an option over the thing: limb (c)(the person has the right to acquire the thing under an option)
#ASSERT `s 4(7)(c) the person has the right to acquire the thing, or an interest in it, under an option` TRUE FALSE EQUALS JUST TRUE
-- an option over the thing: limb (c)(the person has the right to acquire an interest in the thing under an option)
#ASSERT `s 4(7)(c) the person has the right to acquire the thing, or an interest in it, under an option` FALSE TRUE EQUALS JUST TRUE
-- no option
#ASSERT `s 4(7)(c) the person has the right to acquire the thing, or an interest in it, under an option` FALSE FALSE EQUALS JUST FALSE
-- entitled to exercise a right attached to a thing the person neither holds on the register nor is party to
#ASSERT `s 4(7)(d) the person is entitled to exercise or control the exercise of a right attached to the thing` TRUE FALSE FALSE EQUALS JUST TRUE
-- entitled only as a proxy or representative
#ASSERT `s 4(7)(d) the person is entitled to exercise or control the exercise of a right attached to the thing` TRUE TRUE FALSE EQUALS JUST FALSE
-- the registered holder, or a party: not within (d)
#ASSERT `s 4(7)(d) the person is entitled to exercise or control the exercise of a right attached to the thing` TRUE FALSE TRUE EQUALS JUST FALSE
-- no such entitlement
#ASSERT `s 4(7)(d) the person is entitled to exercise or control the exercise of a right attached to the thing` FALSE FALSE FALSE EQUALS JUST FALSE
-- paragraph (a)
#ASSERT (`s 4(7) the person is treated as having an interest in one of the circumstances` WITH `the circumstance in paragraph (a) is met` IS (JUST TRUE), `the circumstance in paragraph (b) is met` IS (JUST FALSE), `the circumstance in paragraph (c) is met` IS (JUST FALSE), `the circumstance in paragraph (d) is met` IS (JUST FALSE)) EQUALS JUST TRUE
-- paragraph (b)
#ASSERT (`s 4(7) the person is treated as having an interest in one of the circumstances` WITH `the circumstance in paragraph (a) is met` IS (JUST FALSE), `the circumstance in paragraph (b) is met` IS (JUST TRUE), `the circumstance in paragraph (c) is met` IS (JUST FALSE), `the circumstance in paragraph (d) is met` IS (JUST FALSE)) EQUALS JUST TRUE
-- paragraph (c)
#ASSERT (`s 4(7) the person is treated as having an interest in one of the circumstances` WITH `the circumstance in paragraph (a) is met` IS (JUST FALSE), `the circumstance in paragraph (b) is met` IS (JUST FALSE), `the circumstance in paragraph (c) is met` IS (JUST TRUE), `the circumstance in paragraph (d) is met` IS (JUST FALSE)) EQUALS JUST TRUE
-- paragraph (d)
#ASSERT (`s 4(7) the person is treated as having an interest in one of the circumstances` WITH `the circumstance in paragraph (a) is met` IS (JUST FALSE), `the circumstance in paragraph (b) is met` IS (JUST FALSE), `the circumstance in paragraph (c) is met` IS (JUST FALSE), `the circumstance in paragraph (d) is met` IS (JUST TRUE)) EQUALS JUST TRUE
-- "any one or more"
#ASSERT (`s 4(7) the person is treated as having an interest in one of the circumstances` WITH `the circumstance in paragraph (a) is met` IS (JUST TRUE), `the circumstance in paragraph (b) is met` IS (JUST FALSE), `the circumstance in paragraph (c) is met` IS (JUST TRUE), `the circumstance in paragraph (d) is met` IS (JUST FALSE)) EQUALS JUST TRUE
-- no circumstance met: this route fails (reading (a))
#ASSERT (`s 4(7) the person is treated as having an interest in one of the circumstances` WITH `the circumstance in paragraph (a) is met` IS (JUST FALSE), `the circumstance in paragraph (b) is met` IS (JUST FALSE), `the circumstance in paragraph (c) is met` IS (JUST FALSE), `the circumstance in paragraph (d) is met` IS (JUST FALSE)) EQUALS JUST FALSE
-- a circumstance not answered
#ASSERT (`s 4(7) the person is treated as having an interest in one of the circumstances` WITH `the circumstance in paragraph (a) is met` IS (JUST FALSE), `the circumstance in paragraph (b) is met` IS NOTHING, `the circumstance in paragraph (c) is met` IS (JUST FALSE), `the circumstance in paragraph (d) is met` IS (JUST FALSE)) EQUALS NOTHING

-- held jointly
#ASSERT `s 4(8) the thing is held jointly by the person with another person` TRUE EQUALS JUST TRUE
-- not held jointly
#ASSERT `s 4(8) the thing is held jointly by the person with another person` FALSE EQUALS JUST FALSE

-- an interest that cannot be related to a particular thing is still an interest: immaterial
#ASSERT `s 4(9) it is immaterial that the interest cannot be related to a particular thing` TRUE EQUALS JUST TRUE
-- it can be related to a particular thing: subsection (9) has nothing to say
#ASSERT `s 4(9) it is immaterial that the interest cannot be related to a particular thing` FALSE EQUALS NOTHING

-- held as bare trustee: disregarded
#ASSERT `s 4(10)(a) the interest is that of a bare trustee` TRUE EQUALS JUST TRUE
-- not held as bare trustee
#ASSERT `s 4(10)(a) the interest is that of a bare trustee` FALSE EQUALS JUST FALSE
-- a lender holding only as security for an ordinary lending transaction
#ASSERT `s 4(10)(b) the interest is that of a lender holding it only as security` TRUE TRUE EQUALS JUST TRUE
-- holds it for some other purpose than security for the lending
#ASSERT `s 4(10)(b) the interest is that of a lender holding it only as security` TRUE FALSE EQUALS JUST FALSE
-- lending is not part of the person's ordinary business
#ASSERT `s 4(10)(b) the interest is that of a lender holding it only as security` FALSE TRUE EQUALS JUST FALSE
-- held by reason of a prescribed office
#ASSERT `s 4(10)(c) the interest is held by reason of holding a prescribed office` TRUE EQUALS JUST TRUE
-- not held by reason of such an office
#ASSERT `s 4(10)(c) the interest is held by reason of holding a prescribed office` FALSE EQUALS JUST FALSE
-- own securities acquired under the Companies Act
#ASSERT `s 4(10)(d) the interest is a company's interest in its own securities bought under the Companies Act` TRUE TRUE EQUALS JUST TRUE
-- not acquired in accordance with sections 76B to 76G
#ASSERT `s 4(10)(d) the interest is a company's interest in its own securities bought under the Companies Act` TRUE FALSE EQUALS JUST FALSE
-- not the company's interest in its own securities
#ASSERT `s 4(10)(d) the interest is a company's interest in its own securities bought under the Companies Act` FALSE TRUE EQUALS JUST FALSE
-- a prescribed interest of a prescribed person or class
#ASSERT `s 4(10)(e) the interest is a prescribed interest` TRUE EQUALS JUST TRUE
-- not prescribed
#ASSERT `s 4(10)(e) the interest is a prescribed interest` FALSE EQUALS JUST FALSE
-- Part 7 and cash settlement only
#ASSERT `s 4(10)(f) for Part 7, the interest is in a cash-settled securities-based derivatives contract` TRUE TRUE EQUALS JUST TRUE
-- not for the purposes of Part 7
#ASSERT `s 4(10)(f) for Part 7, the interest is in a cash-settled securities-based derivatives contract` FALSE TRUE EQUALS JUST FALSE
-- physical settlement is possible
#ASSERT `s 4(10)(f) for Part 7, the interest is in a cash-settled securities-based derivatives contract` TRUE FALSE EQUALS JUST FALSE
-- disregarded under paragraph (a)
#ASSERT (`s 4(10) the interest is to be disregarded` WITH `the interest is within paragraph (a) of section 4(10)` IS (JUST TRUE), `the interest is within paragraph (b) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (c) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (d) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (e) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (f) of section 4(10)` IS (JUST FALSE)) EQUALS JUST TRUE
-- disregarded under paragraph (b)
#ASSERT (`s 4(10) the interest is to be disregarded` WITH `the interest is within paragraph (a) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (b) of section 4(10)` IS (JUST TRUE), `the interest is within paragraph (c) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (d) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (e) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (f) of section 4(10)` IS (JUST FALSE)) EQUALS JUST TRUE
-- disregarded under paragraph (c)
#ASSERT (`s 4(10) the interest is to be disregarded` WITH `the interest is within paragraph (a) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (b) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (c) of section 4(10)` IS (JUST TRUE), `the interest is within paragraph (d) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (e) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (f) of section 4(10)` IS (JUST FALSE)) EQUALS JUST TRUE
-- disregarded under paragraph (d)
#ASSERT (`s 4(10) the interest is to be disregarded` WITH `the interest is within paragraph (a) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (b) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (c) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (d) of section 4(10)` IS (JUST TRUE), `the interest is within paragraph (e) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (f) of section 4(10)` IS (JUST FALSE)) EQUALS JUST TRUE
-- disregarded under paragraph (e)
#ASSERT (`s 4(10) the interest is to be disregarded` WITH `the interest is within paragraph (a) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (b) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (c) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (d) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (e) of section 4(10)` IS (JUST TRUE), `the interest is within paragraph (f) of section 4(10)` IS (JUST FALSE)) EQUALS JUST TRUE
-- disregarded under paragraph (f)
#ASSERT (`s 4(10) the interest is to be disregarded` WITH `the interest is within paragraph (a) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (b) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (c) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (d) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (e) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (f) of section 4(10)` IS (JUST TRUE)) EQUALS JUST TRUE
-- no paragraph met: reading (a)
#ASSERT (`s 4(10) the interest is to be disregarded` WITH `the interest is within paragraph (a) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (b) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (c) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (d) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (e) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (f) of section 4(10)` IS (JUST FALSE)) EQUALS JUST FALSE
-- a paragraph not answered
#ASSERT (`s 4(10) the interest is to be disregarded` WITH `the interest is within paragraph (a) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (b) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (c) of section 4(10)` IS NOTHING, `the interest is within paragraph (d) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (e) of section 4(10)` IS (JUST FALSE), `the interest is within paragraph (f) of section 4(10)` IS (JUST FALSE)) EQUALS NOTHING

-- remoteness alone does not justify disregarding
#ASSERT (`s 4(11) the interest is to be disregarded by reason only of its remoteness, how it arose, or restraint` WITH `the ground for disregarding the interest is its remoteness` IS TRUE, `the ground for disregarding the interest is the manner in which it arose` IS FALSE, `the ground for disregarding the interest is that the exercise of a right conferred by the interest is, or is capable of being made, subject to restraint or restriction` IS FALSE, `there is some other ground for disregarding the interest` IS FALSE) EQUALS JUST FALSE
-- the manner in which it arose, alone
#ASSERT (`s 4(11) the interest is to be disregarded by reason only of its remoteness, how it arose, or restraint` WITH `the ground for disregarding the interest is its remoteness` IS FALSE, `the ground for disregarding the interest is the manner in which it arose` IS TRUE, `the ground for disregarding the interest is that the exercise of a right conferred by the interest is, or is capable of being made, subject to restraint or restriction` IS FALSE, `there is some other ground for disregarding the interest` IS FALSE) EQUALS JUST FALSE
-- restraint alone
#ASSERT (`s 4(11) the interest is to be disregarded by reason only of its remoteness, how it arose, or restraint` WITH `the ground for disregarding the interest is its remoteness` IS FALSE, `the ground for disregarding the interest is the manner in which it arose` IS FALSE, `the ground for disregarding the interest is that the exercise of a right conferred by the interest is, or is capable of being made, subject to restraint or restriction` IS TRUE, `there is some other ground for disregarding the interest` IS FALSE) EQUALS JUST FALSE
-- all three together, nothing else
#ASSERT (`s 4(11) the interest is to be disregarded by reason only of its remoteness, how it arose, or restraint` WITH `the ground for disregarding the interest is its remoteness` IS TRUE, `the ground for disregarding the interest is the manner in which it arose` IS TRUE, `the ground for disregarding the interest is that the exercise of a right conferred by the interest is, or is capable of being made, subject to restraint or restriction` IS TRUE, `there is some other ground for disregarding the interest` IS FALSE) EQUALS JUST FALSE
-- another ground as well: "by reason only of" is not met
#ASSERT (`s 4(11) the interest is to be disregarded by reason only of its remoteness, how it arose, or restraint` WITH `the ground for disregarding the interest is its remoteness` IS TRUE, `the ground for disregarding the interest is the manner in which it arose` IS FALSE, `the ground for disregarding the interest is that the exercise of a right conferred by the interest is, or is capable of being made, subject to restraint or restriction` IS FALSE, `there is some other ground for disregarding the interest` IS TRUE) EQUALS NOTHING
-- no ground given
#ASSERT (`s 4(11) the interest is to be disregarded by reason only of its remoteness, how it arose, or restraint` WITH `the ground for disregarding the interest is its remoteness` IS FALSE, `the ground for disregarding the interest is the manner in which it arose` IS FALSE, `the ground for disregarding the interest is that the exercise of a right conferred by the interest is, or is capable of being made, subject to restraint or restriction` IS FALSE, `there is some other ground for disregarding the interest` IS FALSE) EQUALS NOTHING
