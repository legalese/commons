IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfac-242`

-- Tests for sfac-242.l4 (s 242). Every expected value is written from the text of the Act (SFA2001.txt lines 39583 to 39809) before the code was run.
-- The arguments of a call are in the order of the function's GIVEN; a comment above a group names them.

§ `s 242(1) and (2): the stop order`
-- arguments: registered; (a) opinion of a false or misleading statement; (b) an omission of information required under s 243; (c) opinion that it does not comply; (d) opinion that it is in the public interest
#ASSERT (`s 242(1) the Authority may serve a stop order on the person making the offer for the prospectus` TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 242(1) the Authority may serve a stop order on the person making the offer for the prospectus` TRUE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 242(1) the Authority may serve a stop order on the person making the offer for the prospectus` TRUE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 242(1) the Authority may serve a stop order on the person making the offer for the prospectus` TRUE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
-- the gate fails: no registration, or none of the four grounds: the power is limited by its own wording (NOTHING)
#ASSERT (`s 242(1) the Authority may serve a stop order on the person making the offer for the prospectus` FALSE TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 242(1) the Authority may serve a stop order on the person making the offer for the prospectus` TRUE FALSE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 242(2) the Authority may serve a stop order on the person making the offer for the profile statement` TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 242(2) the Authority may serve a stop order on the person making the offer for the profile statement` TRUE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 242(2) the Authority may serve a stop order on the person making the offer for the profile statement` TRUE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 242(2) the Authority may serve a stop order on the person making the offer for the profile statement` TRUE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 242(2) the Authority may serve a stop order on the person making the offer for the profile statement` FALSE TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 242(2) the Authority may serve a stop order on the person making the offer for the profile statement` TRUE FALSE FALSE FALSE FALSE) EQUALS NOTHING

§ `s 242(3) and (4): limits on the stop order`
-- s 242(3) arguments: any has been issued or sold; any has been listed for quotation on an approved exchange; trading has commenced
#ASSERT (`s 242(3) the Authority must not serve a stop order` TRUE TRUE TRUE) EQUALS JUST TRUE
-- the "if" is not met (reading (a): JUST FALSE; SPLIT-SITE (i))
#ASSERT (`s 242(3) the Authority must not serve a stop order` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 242(3) the Authority must not serve a stop order` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 242(3) the Authority must not serve a stop order` FALSE TRUE TRUE) EQUALS JUST FALSE
-- s 242(4) arguments: a stop order is to be served under (1) or (2); served on the ground of the public interest; (a) winding up or dissolution; (aa) undischarged bankrupt; (b) a receiver appointed
#ASSERT (`s 242(4) the Authority must give the person making the offer an opportunity to be heard` TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 242(4) the Authority must give the person making the offer an opportunity to be heard` TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
-- "except that an opportunity ... need not be given": the public interest on the basis of one of the circumstances
#ASSERT (`s 242(4) the Authority must give the person making the offer an opportunity to be heard` TRUE TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 242(4) the Authority must give the person making the offer an opportunity to be heard` TRUE TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 242(4) the Authority must give the person making the offer an opportunity to be heard` TRUE TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
-- a circumstance but not on the public interest ground: the exception does not apply
#ASSERT (`s 242(4) the Authority must give the person making the offer an opportunity to be heard` TRUE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
-- no stop order to be served
#ASSERT (`s 242(4) the Authority must give the person making the offer an opportunity to be heard` FALSE TRUE TRUE FALSE FALSE) EQUALS NOTHING

§ `s 242(5) and (6): applicants to subscribe`
-- gate arguments: applications made before the stop order; the securities have (not) been issued
#ASSERT (`s 242(5)(a) the person making the offer is bound by paragraph (a)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 242(5)(a) the person making the offer is bound by paragraph (a)` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 242(5)(a) the person making the offer is bound by paragraph (a)` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 242(5)(a)(i) the applications are deemed to have been withdrawn and cancelled` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 242(5)(a)(i) the applications are deemed to have been withdrawn and cancelled` TRUE FALSE) EQUALS JUST FALSE
-- payment arguments: the date of the stop order (Monday 2 March 2026); paid all moneys; the date paid. 14 days after 2 March is 16 March.
#ASSERT (`s 242(5)(a)(ii) the person making the offer has paid the applicants within 14 days from the date of the stop order` (Date 2 3 2026) TRUE (Date 16 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 242(5)(a)(ii) the person making the offer has paid the applicants within 14 days from the date of the stop order` (Date 2 3 2026) TRUE (Date 17 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 242(5)(a)(ii) the person making the offer has paid the applicants within 14 days from the date of the stop order` (Date 2 3 2026) FALSE (Date 5 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 242(5)(b) the person making the offer is bound by paragraph (b)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 242(5)(b) the person making the offer is bound by paragraph (b)` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 242(5)(b)(i) the issue of the securities or contracts is deemed to be void` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 242(5)(b)(i) the issue of the securities or contracts is deemed to be void` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 242(5)(b)(ii) the person making the offer has paid the applicants within 14 days from the date of the stop order` (Date 2 3 2026) TRUE (Date 16 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 242(5)(b)(ii) the person making the offer has paid the applicants within 14 days from the date of the stop order` (Date 2 3 2026) TRUE (Date 17 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 242(6) the provision has effect despite sections 76 and 76A and Division 3A of Part 4 of the Companies Act 1967` TRUE) EQUALS JUST TRUE
#ASSERT (`s 242(6) the provision has effect despite sections 76 and 76A and Division 3A of Part 4 of the Companies Act 1967` FALSE) EQUALS NOTHING

§ `s 242(7): applicants to purchase`
#ASSERT (`s 242(7)(a) the person making the offer is bound by paragraph (a)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 242(7)(a) the person making the offer is bound by paragraph (a)` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 242(7)(a)(i) the applications are deemed to have been withdrawn and cancelled` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 242(7)(a)(i) the applications are deemed to have been withdrawn and cancelled` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 242(7)(a)(ii) the person making the offer has paid the applicants within 14 days from the date of the stop order` (Date 2 3 2026) TRUE (Date 16 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 242(7)(a)(ii) the person making the offer has paid the applicants within 14 days from the date of the stop order` (Date 2 3 2026) TRUE (Date 17 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 242(7)(b) the person making the offer is bound by paragraph (b)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 242(7)(b) the person making the offer is bound by paragraph (b)` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 242(7)(b) the sale is deemed to be void` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 242(7)(b) the sale is deemed to be void` TRUE FALSE) EQUALS JUST FALSE
-- (b)(i) arguments: title documents have been issued; the date of the stop order (2 March); informed the applicants; the date informed; the date the documents were received; paid all moneys; the date paid
-- inform by 9 March; pay within 7 days of the later of the receipt (5 March) and the stop order (2 March): by 12 March
#ASSERT (`s 242(7)(b)(i) the person making the offer has informed the applicants and paid them, where title documents were issued` TRUE (Date 2 3 2026) TRUE (Date 9 3 2026) (Date 5 3 2026) TRUE (Date 12 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 242(7)(b)(i) the person making the offer has informed the applicants and paid them, where title documents were issued` TRUE (Date 2 3 2026) TRUE (Date 10 3 2026) (Date 5 3 2026) TRUE (Date 12 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 242(7)(b)(i) the person making the offer has informed the applicants and paid them, where title documents were issued` TRUE (Date 2 3 2026) TRUE (Date 9 3 2026) (Date 5 3 2026) TRUE (Date 13 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 242(7)(b)(i) the person making the offer has informed the applicants and paid them, where title documents were issued` TRUE (Date 2 3 2026) FALSE (Date 9 3 2026) (Date 5 3 2026) TRUE (Date 12 3 2026)) EQUALS JUST FALSE
-- documents received before the stop order: the stop order date is the later
#ASSERT (`s 242(7)(b)(i) the person making the offer has informed the applicants and paid them, where title documents were issued` TRUE (Date 2 3 2026) TRUE (Date 9 3 2026) (Date 1 2 2026) TRUE (Date 9 3 2026)) EQUALS JUST TRUE
-- no title documents were issued: this "if" is unmet
#ASSERT (`s 242(7)(b)(i) the person making the offer has informed the applicants and paid them, where title documents were issued` FALSE (Date 2 3 2026) FALSE (Date 2 3 2026) (Date 2 3 2026) TRUE (Date 9 3 2026)) EQUALS NOTHING
-- (b)(ii) arguments: title documents have been issued; the date of the stop order; paid all moneys; the date paid
#ASSERT (`s 242(7)(b)(ii) the person making the offer has paid the applicants within 7 days, where no title documents were issued` FALSE (Date 2 3 2026) TRUE (Date 9 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 242(7)(b)(ii) the person making the offer has paid the applicants within 7 days, where no title documents were issued` FALSE (Date 2 3 2026) TRUE (Date 10 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 242(7)(b)(ii) the person making the offer has paid the applicants within 7 days, where no title documents were issued` FALSE (Date 2 3 2026) FALSE (Date 5 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 242(7)(b)(ii) the person making the offer has paid the applicants within 7 days, where no title documents were issued` TRUE (Date 2 3 2026) TRUE (Date 5 3 2026)) EQUALS NOTHING

§ `s 242(8) to (10): the interim stop order`
#ASSERT (`s 242(8) the Authority may serve an interim stop order without giving an opportunity to be heard` TRUE) EQUALS JUST TRUE
#ASSERT (`s 242(8) the Authority may serve an interim stop order without giving an opportunity to be heard` FALSE) EQUALS NOTHING
-- s 242(9) arguments: revoked; served during a hearing or a hearing commenced while in force; the Authority has made an order under (1) or (2); the day it was served (Monday 2 March 2026); the day asked about
-- in any other case: for 14 days beginning with the day of service, so 2 March to 15 March
#ASSERT (`s 242(9) the interim stop order is in force` FALSE FALSE FALSE (Date 2 3 2026) (Date 2 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 242(9) the interim stop order is in force` FALSE FALSE FALSE (Date 2 3 2026) (Date 15 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 242(9) the interim stop order is in force` FALSE FALSE FALSE (Date 2 3 2026) (Date 16 3 2026)) EQUALS JUST FALSE
-- revoked: "unless revoked"
#ASSERT (`s 242(9) the interim stop order is in force` TRUE FALSE FALSE (Date 2 3 2026) (Date 5 3 2026)) EQUALS JUST FALSE
-- the hearing case: in force until the Authority makes an order, however long that takes
#ASSERT (`s 242(9) the interim stop order is in force` FALSE TRUE FALSE (Date 2 3 2026) (Date 20 4 2026)) EQUALS JUST TRUE
#ASSERT (`s 242(9) the interim stop order is in force` FALSE TRUE TRUE (Date 2 3 2026) (Date 20 4 2026)) EQUALS JUST FALSE
-- before service
#ASSERT (`s 242(9) the interim stop order is in force` FALSE FALSE FALSE (Date 2 3 2026) (Date 1 3 2026)) EQUALS NOTHING
#ASSERT (`s 242(10) subsections (5) and (7) apply` TRUE) EQUALS JUST FALSE
#ASSERT (`s 242(10) subsections (5) and (7) apply` FALSE) EQUALS NOTHING

§ `s 242(11) to (13): offences`
-- s 242(11) arguments: fails to comply with a stop order; fails to comply with an interim stop order
#ASSERT (`s 242(11) the person is guilty of an offence` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 242(11) the person is guilty of an offence` FALSE TRUE) EQUALS JUST TRUE
-- the person complies: the text names the person who fails and says nothing of anyone else (SPLIT-SITE (i): NOTHING)
#ASSERT (`s 242(11) the person is guilty of an offence` FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 242(11) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 150000
#ASSERT (`s 242(11) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 24
#ASSERT (`s 242(11) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS TRUE
#ASSERT (`s 242(11) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 15000

-- EXPECT BREACH: an order is in force and the person sells
#TRACE (`s 242(11) the person making the offer shall not allot, issue or sell contrary to the order` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 242(11) allot, issue or sell securities or securities-based derivatives contracts contrary to the order` AT 4

-- EXPECT RESIDUAL: an order is in force and the person has done nothing yet
#TRACE (`s 242(11) the person making the offer shall not allot, issue or sell contrary to the order` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH

-- EXPECT FULFILLED: no order is in force, so selling is no breach
#TRACE (`s 242(11) the person making the offer shall not allot, issue or sell contrary to the order` (`An offeror` "Acme Pte Ltd") (JUST FALSE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 242(11) allot, issue or sell securities or securities-based derivatives contracts contrary to the order` AT 4

-- s 242(12) arguments: bound by (5)(a); paid under (5)(a)(ii); bound by (5)(b); paid under (5)(b)(ii); bound by (7)(a); paid under (7)(a)(ii); bound by (7)(b); acted under (7)(b)(i); paid under (7)(b)(ii)
#ASSERT (`s 242(12) the person is guilty of an offence` (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING (JUST FALSE) NOTHING (JUST FALSE) NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 242(12) the person is guilty of an offence` (JUST FALSE) NOTHING (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING (JUST FALSE) NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 242(12) the person is guilty of an offence` (JUST FALSE) NOTHING (JUST FALSE) NOTHING (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING NOTHING) EQUALS JUST TRUE
-- (7)(b): either route not followed
#ASSERT (`s 242(12) the person is guilty of an offence` (JUST FALSE) NOTHING (JUST FALSE) NOTHING (JUST FALSE) NOTHING (JUST TRUE) (JUST FALSE) NOTHING) EQUALS JUST TRUE
#ASSERT (`s 242(12) the person is guilty of an offence` (JUST FALSE) NOTHING (JUST FALSE) NOTHING (JUST FALSE) NOTHING (JUST TRUE) NOTHING (JUST FALSE)) EQUALS JUST TRUE
-- no paragraph contravened (SPLIT-SITE (i): NOTHING)
#ASSERT (`s 242(12) the person is guilty of an offence` (JUST TRUE) (JUST TRUE) (JUST FALSE) NOTHING (JUST FALSE) NOTHING (JUST FALSE) NOTHING NOTHING) EQUALS NOTHING
#ASSERT (`s 242(12) the person is guilty of an offence` (JUST FALSE) NOTHING (JUST FALSE) NOTHING (JUST FALSE) NOTHING (JUST TRUE) (JUST TRUE) NOTHING) EQUALS NOTHING
-- an answer nobody has worked out
#ASSERT (`s 242(12) the person is guilty of an offence` NOTHING NOTHING (JUST FALSE) NOTHING (JUST FALSE) NOTHING (JUST FALSE) NOTHING NOTHING) EQUALS NOTHING
#ASSERT (`s 242(12) the person is guilty of an offence` (JUST TRUE) NOTHING (JUST FALSE) NOTHING (JUST FALSE) NOTHING (JUST FALSE) NOTHING NOTHING) EQUALS NOTHING
#ASSERT (`s 242(12) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 100000
#ASSERT (`s 242(12) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 10000
#ASSERT (`s 242(13) the information presented is a statement for the purposes of subsections (1)(a) and (2)(a)` TRUE) EQUALS JUST TRUE
#ASSERT (`s 242(13) the information presented is a statement for the purposes of subsections (1)(a) and (2)(a)` FALSE) EQUALS NOTHING
