-- MODULES sfad-exemption-summary
IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-periods`
IMPORT `sfad-debentures`
IMPORT `sfad-exemption-summary`

-- Tests for sfad-exemption-summary.l4 (the seams S4 and S5 of the plan).
-- Every expected value is written from the text and the plan, beside the assertion; none is copied from the module's output.

§ `Subdivision (4): the offer qualifies for an exemption`

-- arguments: the list of (provision, answer, revoked under section 281)
#ASSERT (`Subdivision (4) the offer qualifies for an exemption under Subdivision (4) of Division 1 of Part 13, other than section 280` (LIST (`Subdivision (4) an exemption relied on` OF "s 274", (JUST TRUE), FALSE))) EQUALS TRUE
#ASSERT (`Subdivision (4) the offer qualifies for an exemption under Subdivision (4) of Division 1 of Part 13, other than section 280` (LIST (`Subdivision (4) an exemption relied on` OF "s 274", (JUST FALSE), FALSE), (`Subdivision (4) an exemption relied on` OF "s 275(1)", (JUST TRUE), FALSE))) EQUALS TRUE
#ASSERT (`Subdivision (4) the offer qualifies for an exemption under Subdivision (4) of Division 1 of Part 13, other than section 280` (LIST (`Subdivision (4) an exemption relied on` OF "s 274", (JUST FALSE), FALSE), (`Subdivision (4) an exemption relied on` OF "s 275(1)", (JUST FALSE), FALSE))) EQUALS FALSE
#ASSERT (`Subdivision (4) the offer qualifies for an exemption under Subdivision (4) of Division 1 of Part 13, other than section 280` (LIST (`Subdivision (4) an exemption relied on` OF "s 274", NOTHING, FALSE))) EQUALS FALSE
#ASSERT (`Subdivision (4) the offer qualifies for an exemption under Subdivision (4) of Division 1 of Part 13, other than section 280` (LIST (`Subdivision (4) an exemption relied on` OF "s 274", (JUST TRUE), TRUE))) EQUALS FALSE
#ASSERT (`Subdivision (4) the offer qualifies for an exemption under Subdivision (4) of Division 1 of Part 13, other than section 280` (LIST (`Subdivision (4) an exemption relied on` OF "s 274", (JUST TRUE), TRUE), (`Subdivision (4) an exemption relied on` OF "s 277(1)", (JUST TRUE), FALSE))) EQUALS TRUE
#ASSERT (`Subdivision (4) the offer qualifies for an exemption under Subdivision (4) of Division 1 of Part 13, other than section 280` EMPTY) EQUALS FALSE
#ASSERT (`Subdivision (4) the number of exemptions that hold and have not been revoked` (LIST (`Subdivision (4) an exemption relied on` OF "s 274", (JUST TRUE), FALSE), (`Subdivision (4) an exemption relied on` OF "s 279", (JUST TRUE), FALSE), (`Subdivision (4) an exemption relied on` OF "s 278(1)", NOTHING, FALSE))) EQUALS 2

§ `s 262(3): asset-backed securities`

-- arguments: the securities are debentures or units of debentures; the answer of the securitisation-transaction function
#ASSERT (`s 262(3) the securities are asset-backed securities as section 262(3) defines them` TRUE (JUST TRUE)) EQUALS TRUE
#ASSERT (`s 262(3) the securities are asset-backed securities as section 262(3) defines them` TRUE (JUST FALSE)) EQUALS FALSE
#ASSERT (`s 262(3) the securities are asset-backed securities as section 262(3) defines them` TRUE NOTHING) EQUALS FALSE
#ASSERT (`s 262(3) the securities are asset-backed securities as section 262(3) defines them` FALSE (JUST TRUE)) EQUALS FALSE
