IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-interests`
IMPORT `sfaa-div3-reit`

-- Tests for sfaa-div3-reit.l4 (sections 137S to 137X). Every expected value is written from the text, beside the assertion.
-- Most of this file is generated from the Division 1 tests, with the same words changed as in the module; sections 137S and 137U(1) are written here.
-- Dates: 2 November 2026 is a Monday.


§ `s 137S(1)`
#ASSERT `s 137S(1) section 137S has effect for the purposes of Division 3 and does not affect any other provision` TRUE EQUALS JUST TRUE
#ASSERT `s 137S(1) section 137S has effect for the purposes of Division 3 and does not affect any other provision` FALSE EQUALS JUST FALSE

§ `s 137S(2): "real estate investment trust" and "trustee"`
-- a collective investment scheme that is a trust, invests primarily in real estate, with a primary listing: the definition is met
#ASSERT `s 137S(2) the scheme is a real estate investment trust` TRUE TRUE TRUE EQUALS JUST TRUE
-- any one element missing: the text's no ("means")
#ASSERT `s 137S(2) the scheme is a real estate investment trust` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 137S(2) the scheme is a real estate investment trust` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 137S(2) the scheme is a real estate investment trust` TRUE TRUE FALSE EQUALS JUST FALSE
-- (a): the trustee approved under section 289 for a trust authorised under section 286
#ASSERT `s 137S(2) "trustee" (a) the person is the trustee of an authorised real estate investment trust` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137S(2) "trustee" (a) the person is the trustee of an authorised real estate investment trust` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 137S(2) "trustee" (a) the person is the trustee of an authorised real estate investment trust` FALSE TRUE EQUALS JUST FALSE
-- (b): in relation to any other trust (one not authorised under section 286), an entity equivalent to such a trustee
#ASSERT `s 137S(2) "trustee" (b) the person is the trustee of any other real estate investment trust` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 137S(2) "trustee" (b) the person is the trustee of any other real estate investment trust` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 137S(2) "trustee" (b) the person is the trustee of any other real estate investment trust` FALSE FALSE EQUALS JUST FALSE
-- the combining function: either paragraph is enough; both no is the text's no; a limb the caller could not answer is not a no
#ASSERT `s 137S(2) "trustee" the person is the trustee of the real estate investment trust` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 137S(2) "trustee" the person is the trustee of the real estate investment trust` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 137S(2) "trustee" the person is the trustee of the real estate investment trust` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 137S(2) "trustee" the person is the trustee of the real estate investment trust` NOTHING (JUST FALSE) EQUALS NOTHING

§ `s 137S(3) and (4): section 4 applies; section 130(6) and (7) apply`
-- a unit in a collective investment scheme is within this Division (it was outside Division 1)
#ASSERT `s 137S(3) the person has an interest in the securities, securities-based derivatives contracts or units under Division 3` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 137S(3) the person has an interest in the securities, securities-based derivatives contracts or units under Division 3` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 137S(3) the person has an interest in the securities, securities-based derivatives contracts or units under Division 3` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- none of the three things: outside the wording of this Division
#ASSERT `s 137S(3) the person has an interest in the securities, securities-based derivatives contracts or units under Division 3` FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 137S(4) section 130(6) and (7) apply to the provision` TRUE EQUALS JUST TRUE
#ASSERT `s 137S(4) section 130(6) and (7) apply to the provision` FALSE EQUALS NOTHING

§ `s 137T: who must comply, exemption, extension`
#ASSERT `s 137T(1) the obligation to comply with Division 3 extends to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137T(1) the obligation to comply with Division 3 extends to the person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 137T(1) the obligation to comply with Division 3 extends to the person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 137T(2) Division 3 extends to the act or omission` TRUE EQUALS JUST TRUE
#ASSERT `s 137T(2) Division 3 extends to the act or omission` FALSE EQUALS NOTHING
#ASSERT `s 137T(3) the person is exempt from the provision of Division 3` TRUE EQUALS JUST TRUE
#ASSERT `s 137T(3) the person is exempt from the provision of Division 3` FALSE EQUALS NOTHING
#ASSERT `s 137T(4) the exempted person must comply with the condition or restriction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137T(4) the exempted person must comply with the condition or restriction` TRUE FALSE EQUALS NOTHING
#ASSERT `s 137T(4) the exempted person must comply with the condition or restriction` FALSE TRUE EQUALS NOTHING
-- s 137T(5): the offence, and the split site (i) both ways
#ASSERT `s 137T(5) the person is guilty of an offence of contravening a condition or restriction` TRUE EQUALS JUST TRUE
#ASSERT `s 137T(5) the person is guilty of an offence of contravening a condition or restriction` FALSE EQUALS NOTHING
#ASSERT `s 137T(5) the penalty on conviction` EQUALS Penalty OF 50000, 0, FALSE, 5000
-- s 137T(6): the Authority's power on application (split site (ii)): applied, and not applied
#ASSERT `s 137T(6) the Authority has power to extend, or further extend, the time for giving the notice` TRUE EQUALS JUST TRUE
#ASSERT `s 137T(6) the Authority has power to extend, or further extend, the time for giving the notice` FALSE EQUALS NOTHING
-- the last day after an extension: the later day if the Authority has extended; the original otherwise
#ASSERT `s 137T(6) the last day for giving the notice, as extended on the person's application` (Date 4 11 2026) TRUE (Date 11 11 2026) EQUALS Date 11 11 2026
#ASSERT `s 137T(6) the last day for giving the notice, as extended on the person's application` (Date 4 11 2026) FALSE (Date 11 11 2026) EQUALS Date 4 11 2026
#ASSERT `s 137T(6) the last day for giving the notice, as extended on the person's application` (Date 4 11 2026) TRUE (Date 2 11 2026) EQUALS Date 4 11 2026

§ `s 137T(4) and (5): the prohibition as a regulative rule, and its breach path`
-- EXPECT BREACH
#TRACE `s 137T(4) and (5) the exempted person shall not contravene a condition or restriction` AT 0 WITH
    PARTY Individual "the exempted person" DOES `s 137T contravene a condition or restriction imposed under subsection (4)` AT 1
-- EXPECT RESIDUAL
#TRACE `s 137T(4) and (5) the exempted person shall not contravene a condition or restriction` AT 0 WITH
    (WAITUNTIL 5)


§ `s 137U(1): who the application reaches`
#ASSERT `s 137U(1) sections 135 to 137B apply to the substantial unitholder` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137U(1) sections 135 to 137B apply to the substantial unitholder` TRUE FALSE EQUALS NOTHING
#ASSERT `s 137U(1) sections 135 to 137B apply to the substantial unitholder` FALSE TRUE EQUALS NOTHING


§ `s 137U(2): intentional or reckless contravention, or knowingly false information (split site (i), both readings)`
-- intentional contravention of one of the named sections: guilty
#ASSERT `s 137U(2) the person is guilty of an offence under subsection (2)` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- knowingly false information in purported compliance: guilty
#ASSERT `s 137U(2) the person is guilty of an offence under subsection (2)` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- a contravention that is not intentional or reckless: not covered by subsection (1), which says who is guilty and not who is innocent
#ASSERT `s 137U(2) the person is guilty of an offence under subsection (2)` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- false information the person did not know to be false: not covered by subsection (1)
#ASSERT `s 137U(2) the person is guilty of an offence under subsection (2)` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 137U(2) the person is guilty of an offence under subsection (2)` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- the penalty: an individual and a corporation
#ASSERT `s 137U(2) the penalty on conviction` TRUE FALSE EQUALS JUST (Penalty OF 250000, 24, TRUE, 25000)
#ASSERT `s 137U(2) the penalty on conviction` FALSE TRUE EQUALS JUST (Penalty OF 250000, 0, FALSE, 25000)
-- neither: the paragraphs name only those two cases
#ASSERT `s 137U(2) the penalty on conviction` FALSE FALSE EQUALS NOTHING

§ `s 137U(3): the lesser offence`
-- a contravention that is not intentional or reckless
#ASSERT `s 137U(3) the person is guilty of an offence under subsection (3)` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- false or misleading information without the knowledge or recklessness of subsection (1)
#ASSERT `s 137U(3) the person is guilty of an offence under subsection (3)` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- an intentional contravention is within subsection (1) and carved out of this one ("in circumstances other than as set out in subsection (1)")
#ASSERT `s 137U(3) the person is guilty of an offence under subsection (3)` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- no contravention and no false information: not covered
#ASSERT `s 137U(3) the person is guilty of an offence under subsection (3)` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 137U(3) the penalty on conviction` EQUALS Penalty OF 25000, 0, FALSE, 2500

§ `s 137U(4): the bar on proceedings`
#ASSERT `s 137U(4) no proceedings may be instituted for an offence under section 137U` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137U(4) no proceedings may be instituted for an offence under section 137U` FALSE TRUE EQUALS JUST TRUE
-- outside both triggers the bar does not apply (marginal reading (b))
#ASSERT `s 137U(4) no proceedings may be instituted for an offence under section 137U` FALSE FALSE EQUALS JUST FALSE



§ `s 137V(1): keeping and entering`
#ASSERT `s 137V(1) the trustee must keep a register` TRUE EQUALS JUST TRUE
-- not a trustee as section 130(2) reads the word: "The trustee of a real estate investment trust must keep a register" says nothing about it
#ASSERT `s 137V(1) the trustee must keep a register` FALSE EQUALS NOTHING
#ASSERT `s 137V(1) the trustee must immediately enter the names and information in the register` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137V(1) the trustee must immediately enter the names and information in the register` TRUE FALSE EQUALS NOTHING
#ASSERT `s 137V(1) the trustee must immediately enter the names and information in the register` FALSE TRUE EQUALS NOTHING
-- "immediately" is read as a window of nought days (fork register A6): an entry on the day of receipt is in time, one a day later is not
-- EXPECT FULFILLED
#TRACE `s 137V(1) the trustee must immediately enter the names and information in the register` (Individual "the trustee") AT 0 WITH
    PARTY Individual "the trustee" DOES `s 137V enter the names and information in the register` AT 0
-- EXPECT BREACH
#TRACE `s 137V(1) the trustee must immediately enter the names and information in the register` (Individual "the trustee") AT 0 WITH
    PARTY Individual "the trustee" DOES `s 137V enter the names and information in the register` AT 1
-- EXPECT BREACH
#TRACE `s 137V(1) the trustee must immediately enter the names and information in the register` (Individual "the trustee") AT 0 WITH
    (WAITUNTIL 2)

§ `s 137V(2): where the register is kept, and what inspection costs`
-- a trustee with a registered office keeps it there; kept elsewhere is the text's no
#ASSERT `s 137V(2) the register is kept at the place the subsection requires` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137V(2) the register is kept at the place the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
-- no registered office: the principal place of business in Singapore
#ASSERT `s 137V(2) the register is kept at the place the subsection requires` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 137V(2) the register is kept at the place the subsection requires` FALSE TRUE FALSE EQUALS JUST FALSE
-- a unitholder inspects without charge; anyone else pays at most $2
#ASSERT `s 137V(2) the most the trustee may charge for each inspection of the register, in Singapore dollars` TRUE EQUALS 0
#ASSERT `s 137V(2) the most the trustee may charge for each inspection of the register, in Singapore dollars` FALSE EQUALS 2

§ `s 137V(3): copies`
-- $1 a page
#ASSERT `s 137V(3) the most the trustee may charge in advance for each page copied, in Singapore dollars` EQUALS 1
-- request received Monday 2 Nov: 14 days later is Monday 16 Nov
#ASSERT `s 137V(3) the last day for the trustee to send the copy` (Date 2 11 2026) FALSE (Date 23 11 2026) EQUALS Date 16 11 2026
-- the Authority has allowed a longer period, to 23 Nov: that day
#ASSERT `s 137V(3) the last day for the trustee to send the copy` (Date 2 11 2026) TRUE (Date 23 11 2026) EQUALS Date 23 11 2026
-- an allowed period that is not longer than 14 days changes nothing
#ASSERT `s 137V(3) the last day for the trustee to send the copy` (Date 2 11 2026) TRUE (Date 10 11 2026) EQUALS Date 16 11 2026
#ASSERT `s 137V(3) the copy is sent in time` (Date 2 11 2026) FALSE (Date 23 11 2026) (Date 16 11 2026) EQUALS JUST TRUE
#ASSERT `s 137V(3) the copy is sent in time` (Date 2 11 2026) FALSE (Date 23 11 2026) (Date 17 11 2026) EQUALS JUST FALSE
#ASSERT `s 137V(3) the copy is sent in time` (Date 2 11 2026) TRUE (Date 23 11 2026) (Date 23 11 2026) EQUALS JUST TRUE
#ASSERT `s 137V(3) the copy is sent in time` (Date 2 11 2026) TRUE (Date 23 11 2026) (Date 24 11 2026) EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 137V(3) the trustee must send the copy within 14 days` (Individual "the trustee") AT 0 WITH
    PARTY Individual "the trustee" DOES `s 137V send the copy of the register` AT 14
-- EXPECT BREACH
#TRACE `s 137V(3) the trustee must send the copy within 14 days` (Individual "the trustee") AT 0 WITH
    PARTY Individual "the trustee" DOES `s 137V send the copy of the register` AT 15
-- EXPECT BREACH
#TRACE `s 137V(3) the trustee must send the copy within 14 days` (Individual "the trustee") AT 0 WITH
    (WAITUNTIL 20)

§ `s 137V(4): the Authority's requirement`
#ASSERT `s 137V(4) the trustee must send the Authority a copy of the register` TRUE TRUE EQUALS JUST TRUE
-- no requirement: "The Authority may at any time in writing require" is not triggered
#ASSERT `s 137V(4) the trustee must send the Authority a copy of the register` TRUE FALSE EQUALS NOTHING
#ASSERT `s 137V(4) the trustee must send the Authority a copy of the register` FALSE TRUE EQUALS NOTHING
-- requirement received Monday 2 Nov: 7 days later is Monday 9 Nov
#ASSERT `s 137V(4) the last day for the trustee to send the copy to the Authority` (Date 2 11 2026) EQUALS Date 9 11 2026
#ASSERT `s 137V(4) the copy is sent to the Authority in time` (Date 2 11 2026) (Date 9 11 2026) EQUALS JUST TRUE
#ASSERT `s 137V(4) the copy is sent to the Authority in time` (Date 2 11 2026) (Date 10 11 2026) EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 137V(4) the trustee must send the Authority the copy within 7 days` (Individual "the trustee") AT 0 WITH
    PARTY Individual "the trustee" DOES `s 137V send the copy of the register` AT 7
-- EXPECT BREACH
