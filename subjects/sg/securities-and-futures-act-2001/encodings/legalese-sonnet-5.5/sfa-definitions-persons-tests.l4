#ASSERT `s 2(1) "partner" the person is a partner of the limited liability partnership` FALSE EQUALS JUST FALSE
-- a manager under that Act
#ASSERT `s 2(1) "manager" (limited liability partnership) the person is a manager of the limited liability partnership` TRUE EQUALS JUST TRUE
-- not one
#ASSERT `s 2(1) "manager" (limited liability partnership) the person is a manager of the limited liability partnership` FALSE EQUALS JUST FALSE

