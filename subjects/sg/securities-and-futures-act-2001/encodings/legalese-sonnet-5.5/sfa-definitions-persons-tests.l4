-- the borrowed test is not met: "has the meaning given by section 4(1) of the Companies Act 1967"
#ASSERT `s 2(1) "financial year" the period is a financial year` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "foreign company" the body is a foreign company` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 4(1) of the Companies Act 1967"
#ASSERT `s 2(1) "foreign company" the body is a foreign company` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "holding company" the corporation is a holding company` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 5(4) of the Companies Act 1967"
#ASSERT `s 2(1) "holding company" the corporation is a holding company` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "public company" the body is a public company` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 4(1) of the Companies Act 1967"
#ASSERT `s 2(1) "public company" the body is a public company` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "related corporation" the corporation is a related corporation` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 4(1) of the Companies Act 1967"
#ASSERT `s 2(1) "related corporation" the corporation is a related corporation` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "subsidiary" the corporation is a subsidiary` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 5 of the Companies Act 1967"
#ASSERT `s 2(1) "subsidiary" the corporation is a subsidiary` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "office copy" the document is an office copy` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 4(1) of the Companies Act 1967"
#ASSERT `s 2(1) "office copy" the document is an office copy` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "firm" the body is a firm` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 2(1) of the Business Names Registration Act 2014"
#ASSERT `s 2(1) "firm" the body is a firm` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "limited liability partnership" the body is a limited liability partnership` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 2(1) of the Limited Liability Partnerships Act 2005"
#ASSERT `s 2(1) "limited liability partnership" the body is a limited liability partnership` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
