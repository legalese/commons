-- employed by or acting for the person, and carrying out a regulated activity on the person's behalf
#ASSERT `s 2(1) "principal" the person is the principal of the representative` TRUE TRUE EQUALS JUST TRUE
-- no regulated activity on the person's behalf
#ASSERT `s 2(1) "principal" the person is the principal of the representative` TRUE FALSE EQUALS JUST FALSE
-- not employed by or acting for the person
#ASSERT `s 2(1) "principal" the person is the principal of the representative` FALSE TRUE EQUALS JUST FALSE

-- (a)(i): an employee carrying out a regulated activity for the principal
#ASSERT (`s 2(1) "representative" the person is a representative of the principal` WITH `what the principal is` IS (`s 2(1) "representative" a person who carries on business in a regulated activity`), `the provision being read is in Part 13` IS FALSE, `the person, by whatever name called, is in the direct employment of, or acting for, or by arrangement with, the principal` IS TRUE, `the person carries out for the principal the activity that goes with that kind of principal` IS TRUE, `the work is work ordinarily performed by accountants, clerks or cashiers` IS FALSE, `the principal is a corporation and the person is an officer of it who performs the activity for it` IS FALSE) EQUALS JUST TRUE
-- (a)(i): the work is ordinarily performed by accountants, clerks or cashiers
#ASSERT (`s 2(1) "representative" the person is a representative of the principal` WITH `what the principal is` IS (`s 2(1) "representative" a person who carries on business in a regulated activity`), `the provision being read is in Part 13` IS FALSE, `the person, by whatever name called, is in the direct employment of, or acting for, or by arrangement with, the principal` IS TRUE, `the person carries out for the principal the activity that goes with that kind of principal` IS TRUE, `the work is work ordinarily performed by accountants, clerks or cashiers` IS TRUE, `the principal is a corporation and the person is an officer of it who performs the activity for it` IS FALSE) EQUALS JUST FALSE
-- (a)(ii): an officer of a corporation principal who performs a regulated activity
#ASSERT (`s 2(1) "representative" the person is a representative of the principal` WITH `what the principal is` IS (`s 2(1) "representative" a person who carries on business in a regulated activity`), `the provision being read is in Part 13` IS FALSE, `the person, by whatever name called, is in the direct employment of, or acting for, or by arrangement with, the principal` IS FALSE, `the person carries out for the principal the activity that goes with that kind of principal` IS TRUE, `the work is work ordinarily performed by accountants, clerks or cashiers` IS FALSE, `the principal is a corporation and the person is an officer of it who performs the activity for it` IS TRUE) EQUALS JUST TRUE
-- (a)(i): carries out no regulated activity for the principal
#ASSERT (`s 2(1) "representative" the person is a representative of the principal` WITH `what the principal is` IS (`s 2(1) "representative" a person who carries on business in a regulated activity`), `the provision being read is in Part 13` IS FALSE, `the person, by whatever name called, is in the direct employment of, or acting for, or by arrangement with, the principal` IS TRUE, `the person carries out for the principal the activity that goes with that kind of principal` IS FALSE, `the work is work ordinarily performed by accountants, clerks or cashiers` IS FALSE, `the principal is a corporation and the person is an officer of it who performs the activity for it` IS FALSE) EQUALS JUST FALSE
-- (a): "except for the purposes of Part 13"; the definition says nothing there
#ASSERT (`s 2(1) "representative" the person is a representative of the principal` WITH `what the principal is` IS (`s 2(1) "representative" a person who carries on business in a regulated activity`), `the provision being read is in Part 13` IS TRUE, `the person, by whatever name called, is in the direct employment of, or acting for, or by arrangement with, the principal` IS TRUE, `the person carries out for the principal the activity that goes with that kind of principal` IS TRUE, `the work is work ordinarily performed by accountants, clerks or cashiers` IS FALSE, `the principal is a corporation and the person is an officer of it who performs the activity for it` IS FALSE) EQUALS NOTHING
-- (b)(i): an employee administering a designated benchmark for a benchmark administrator
#ASSERT (`s 2(1) "representative" the person is a representative of the principal` WITH `what the principal is` IS (`s 2(1) "representative" an authorised or exempt benchmark administrator`), `the provision being read is in Part 13` IS FALSE, `the person, by whatever name called, is in the direct employment of, or acting for, or by arrangement with, the principal` IS TRUE, `the person carries out for the principal the activity that goes with that kind of principal` IS TRUE, `the work is work ordinarily performed by accountants, clerks or cashiers` IS FALSE, `the principal is a corporation and the person is an officer of it who performs the activity for it` IS FALSE) EQUALS JUST TRUE
-- (b)(ii): an officer of a corporate benchmark administrator
#ASSERT (`s 2(1) "representative" the person is a representative of the principal` WITH `what the principal is` IS (`s 2(1) "representative" an authorised or exempt benchmark administrator`), `the provision being read is in Part 13` IS FALSE, `the person, by whatever name called, is in the direct employment of, or acting for, or by arrangement with, the principal` IS FALSE, `the person carries out for the principal the activity that goes with that kind of principal` IS TRUE, `the work is work ordinarily performed by accountants, clerks or cashiers` IS FALSE, `the principal is a corporation and the person is an officer of it who performs the activity for it` IS TRUE) EQUALS JUST TRUE
-- (c)(i): an employee providing information for a benchmark submitter
#ASSERT (`s 2(1) "representative" the person is a representative of the principal` WITH `what the principal is` IS (`s 2(1) "representative" an authorised, exempt or designated benchmark submitter`), `the provision being read is in Part 13` IS FALSE, `the person, by whatever name called, is in the direct employment of, or acting for, or by arrangement with, the principal` IS TRUE, `the person carries out for the principal the activity that goes with that kind of principal` IS TRUE, `the work is work ordinarily performed by accountants, clerks or cashiers` IS FALSE, `the principal is a corporation and the person is an officer of it who performs the activity for it` IS FALSE) EQUALS JUST TRUE
-- (c)(ii): an officer of a corporate benchmark submitter
#ASSERT (`s 2(1) "representative" the person is a representative of the principal` WITH `what the principal is` IS (`s 2(1) "representative" an authorised, exempt or designated benchmark submitter`), `the provision being read is in Part 13` IS FALSE, `the person, by whatever name called, is in the direct employment of, or acting for, or by arrangement with, the principal` IS FALSE, `the person carries out for the principal the activity that goes with that kind of principal` IS TRUE, `the work is work ordinarily performed by accountants, clerks or cashiers` IS FALSE, `the principal is a corporation and the person is an officer of it who performs the activity for it` IS TRUE) EQUALS JUST TRUE
-- (c): neither employed nor an officer
#ASSERT (`s 2(1) "representative" the person is a representative of the principal` WITH `what the principal is` IS (`s 2(1) "representative" an authorised, exempt or designated benchmark submitter`), `the provision being read is in Part 13` IS FALSE, `the person, by whatever name called, is in the direct employment of, or acting for, or by arrangement with, the principal` IS FALSE, `the person carries out for the principal the activity that goes with that kind of principal` IS FALSE, `the work is work ordinarily performed by accountants, clerks or cashiers` IS FALSE, `the principal is a corporation and the person is an officer of it who performs the activity for it` IS FALSE) EQUALS JUST FALSE
-- the Part 13 exception is in (a) only: it does not touch (b)
#ASSERT (`s 2(1) "representative" the person is a representative of the principal` WITH `what the principal is` IS (`s 2(1) "representative" an authorised or exempt benchmark administrator`), `the provision being read is in Part 13` IS TRUE, `the person, by whatever name called, is in the direct employment of, or acting for, or by arrangement with, the principal` IS TRUE, `the person carries out for the principal the activity that goes with that kind of principal` IS TRUE, `the work is work ordinarily performed by accountants, clerks or cashiers` IS FALSE, `the principal is a corporation and the person is an officer of it who performs the activity for it` IS FALSE) EQUALS JUST TRUE

-- meets section 99D
#ASSERT `s 2(1) "appointed representative" (a) the person is an appointed representative in respect of a type of regulated activity` TRUE EQUALS JUST TRUE
-- does not
#ASSERT `s 2(1) "appointed representative" (a) the person is an appointed representative in respect of a type of regulated activity` FALSE EQUALS JUST FALSE
-- appointed for some type
#ASSERT `s 2(1) "appointed representative" (b) the person is an appointed representative` TRUE EQUALS JUST TRUE
-- for none
#ASSERT `s 2(1) "appointed representative" (b) the person is an appointed representative` FALSE EQUALS JUST FALSE

-- meets section 99E
#ASSERT `s 2(1) "provisional representative" (a) the person is a provisional representative in respect of a type of regulated activity` TRUE EQUALS JUST TRUE
-- does not
#ASSERT `s 2(1) "provisional representative" (a) the person is a provisional representative in respect of a type of regulated activity` FALSE EQUALS JUST FALSE
-- for some type
#ASSERT `s 2(1) "provisional representative" (b) the person is a provisional representative` TRUE EQUALS JUST TRUE
-- for none
#ASSERT `s 2(1) "provisional representative" (b) the person is a provisional representative` FALSE EQUALS JUST FALSE

-- meets section 99F
#ASSERT `s 2(1) "temporary representative" (a) the person is a temporary representative in respect of a type of regulated activity` TRUE EQUALS JUST TRUE
-- does not
#ASSERT `s 2(1) "temporary representative" (a) the person is a temporary representative in respect of a type of regulated activity` FALSE EQUALS JUST FALSE
-- for some type
#ASSERT `s 2(1) "temporary representative" (b) the person is a temporary representative` TRUE EQUALS JUST TRUE
-- for none
#ASSERT `s 2(1) "temporary representative" (b) the person is a temporary representative` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "public register of representatives" the register is the public register of representatives` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "means the register of that name under section 99C(3)"
#ASSERT `s 2(1) "public register of representatives" the register is the public register of representatives` FALSE EQUALS JUST FALSE

-- regulated by the Authority
#ASSERT `s 2(1) "regulated financial institution" the person is a regulated financial institution` TRUE FALSE EQUALS JUST TRUE
-- would be regulated if carried on in Singapore
#ASSERT `s 2(1) "regulated financial institution" the person is a regulated financial institution` FALSE TRUE EQUALS JUST TRUE
-- neither
#ASSERT `s 2(1) "regulated financial institution" the person is a regulated financial institution` FALSE FALSE EQUALS JUST FALSE

-- a foreign authority exercising a corresponding function
#ASSERT `s 2(1) "regulatory authority" the authority is a regulatory authority of the foreign country or jurisdiction` TRUE TRUE EQUALS JUST TRUE
-- no corresponding function
#ASSERT `s 2(1) "regulatory authority" the authority is a regulatory authority of the foreign country or jurisdiction` TRUE FALSE EQUALS JUST FALSE
-- not an authority of that country
#ASSERT `s 2(1) "regulatory authority" the authority is a regulatory authority of the foreign country or jurisdiction` FALSE TRUE EQUALS JUST FALSE

-- granted under section 86 for a regulated activity
#ASSERT `s 2(1) "capital markets services licence" the licence is a capital markets services licence` TRUE TRUE EQUALS JUST TRUE
-- not for a regulated activity
#ASSERT `s 2(1) "capital markets services licence" the licence is a capital markets services licence` TRUE FALSE EQUALS JUST FALSE
-- not granted under section 86
#ASSERT `s 2(1) "capital markets services licence" the licence is a capital markets services licence` FALSE TRUE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "exempt person" the person is an exempt person` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "means a person who is exempted under section 99"
#ASSERT `s 2(1) "exempt person" the person is an exempt person` FALSE EQUALS JUST FALSE
