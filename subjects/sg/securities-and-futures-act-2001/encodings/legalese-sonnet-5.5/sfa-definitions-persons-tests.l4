IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-definitions-persons`

-- Tests for sfa-definitions-persons.
-- Expected values are written from the text of the Act (the quote lines in the module under test), never from its output.

-- an advocate and solicitor of the Supreme Court
#ASSERT `s 2(1) "advocate and solicitor" the person is an advocate and solicitor` TRUE FALSE EQUALS JUST TRUE
-- a foreign lawyer under the Legal Profession Act 1966
#ASSERT `s 2(1) "advocate and solicitor" the person is an advocate and solicitor` FALSE TRUE EQUALS JUST TRUE
-- neither
#ASSERT `s 2(1) "advocate and solicitor" the person is an advocate and solicitor` FALSE FALSE EQUALS JUST FALSE

-- a public accountant registered under the Accountants Act 2004
#ASSERT (`s 2(1) "auditor" the person is an auditor` WITH `the person is a public accountant registered or deemed to be registered under the Accountants Act 2004` IS TRUE, `the provision being read is in Division 1 of Part 13 and the entity is not a company` IS FALSE, `the person is duly registered, licensed, approved or otherwise authorised to practise as an auditor under the laws of the place where the entity is formed or constituted` IS FALSE, `the person is so authorised under the laws of the place of the person's practice` IS FALSE, `the auditing standards applied to the entity's financial statements are those commonly applied in that place of practice` IS FALSE, `the auditing standards applied to the entity's financial statements are international auditing standards, by whatever name called` IS FALSE, `the Authority has approved the person in this case to be an auditor for the entity` IS FALSE) EQUALS JUST TRUE
-- not a public accountant, and not in the Part 13 case: "means"
#ASSERT (`s 2(1) "auditor" the person is an auditor` WITH `the person is a public accountant registered or deemed to be registered under the Accountants Act 2004` IS FALSE, `the provision being read is in Division 1 of Part 13 and the entity is not a company` IS FALSE, `the person is duly registered, licensed, approved or otherwise authorised to practise as an auditor under the laws of the place where the entity is formed or constituted` IS FALSE, `the person is so authorised under the laws of the place of the person's practice` IS FALSE, `the auditing standards applied to the entity's financial statements are those commonly applied in that place of practice` IS FALSE, `the auditing standards applied to the entity's financial statements are international auditing standards, by whatever name called` IS FALSE, `the Authority has approved the person in this case to be an auditor for the entity` IS FALSE) EQUALS JUST FALSE
-- authorised where the entity is formed, but outside Division 1 of Part 13 or for a company: the extension does not apply
#ASSERT (`s 2(1) "auditor" the person is an auditor` WITH `the person is a public accountant registered or deemed to be registered under the Accountants Act 2004` IS FALSE, `the provision being read is in Division 1 of Part 13 and the entity is not a company` IS FALSE, `the person is duly registered, licensed, approved or otherwise authorised to practise as an auditor under the laws of the place where the entity is formed or constituted` IS TRUE, `the person is so authorised under the laws of the place of the person's practice` IS FALSE, `the auditing standards applied to the entity's financial statements are those commonly applied in that place of practice` IS FALSE, `the auditing standards applied to the entity's financial statements are international auditing standards, by whatever name called` IS FALSE, `the Authority has approved the person in this case to be an auditor for the entity` IS FALSE) EQUALS JUST FALSE
-- (a)(i): Part 13, entity not a company, authorised under the laws of the place of formation
#ASSERT (`s 2(1) "auditor" the person is an auditor` WITH `the person is a public accountant registered or deemed to be registered under the Accountants Act 2004` IS FALSE, `the provision being read is in Division 1 of Part 13 and the entity is not a company` IS TRUE, `the person is duly registered, licensed, approved or otherwise authorised to practise as an auditor under the laws of the place where the entity is formed or constituted` IS TRUE, `the person is so authorised under the laws of the place of the person's practice` IS FALSE, `the auditing standards applied to the entity's financial statements are those commonly applied in that place of practice` IS FALSE, `the auditing standards applied to the entity's financial statements are international auditing standards, by whatever name called` IS FALSE, `the Authority has approved the person in this case to be an auditor for the entity` IS FALSE) EQUALS JUST TRUE
-- (a)(ii)(A): authorised where the person practises, standards commonly applied there
#ASSERT (`s 2(1) "auditor" the person is an auditor` WITH `the person is a public accountant registered or deemed to be registered under the Accountants Act 2004` IS FALSE, `the provision being read is in Division 1 of Part 13 and the entity is not a company` IS TRUE, `the person is duly registered, licensed, approved or otherwise authorised to practise as an auditor under the laws of the place where the entity is formed or constituted` IS FALSE, `the person is so authorised under the laws of the place of the person's practice` IS TRUE, `the auditing standards applied to the entity's financial statements are those commonly applied in that place of practice` IS TRUE, `the auditing standards applied to the entity's financial statements are international auditing standards, by whatever name called` IS FALSE, `the Authority has approved the person in this case to be an auditor for the entity` IS FALSE) EQUALS JUST TRUE
-- (a)(ii)(B): authorised where the person practises, international auditing standards
#ASSERT (`s 2(1) "auditor" the person is an auditor` WITH `the person is a public accountant registered or deemed to be registered under the Accountants Act 2004` IS FALSE, `the provision being read is in Division 1 of Part 13 and the entity is not a company` IS TRUE, `the person is duly registered, licensed, approved or otherwise authorised to practise as an auditor under the laws of the place where the entity is formed or constituted` IS FALSE, `the person is so authorised under the laws of the place of the person's practice` IS TRUE, `the auditing standards applied to the entity's financial statements are those commonly applied in that place of practice` IS FALSE, `the auditing standards applied to the entity's financial statements are international auditing standards, by whatever name called` IS TRUE, `the Authority has approved the person in this case to be an auditor for the entity` IS FALSE) EQUALS JUST TRUE
-- (a)(ii) needs (A) or (B): neither, and no other limb; "includes" does not say no
#ASSERT (`s 2(1) "auditor" the person is an auditor` WITH `the person is a public accountant registered or deemed to be registered under the Accountants Act 2004` IS FALSE, `the provision being read is in Division 1 of Part 13 and the entity is not a company` IS TRUE, `the person is duly registered, licensed, approved or otherwise authorised to practise as an auditor under the laws of the place where the entity is formed or constituted` IS FALSE, `the person is so authorised under the laws of the place of the person's practice` IS TRUE, `the auditing standards applied to the entity's financial statements are those commonly applied in that place of practice` IS FALSE, `the auditing standards applied to the entity's financial statements are international auditing standards, by whatever name called` IS FALSE, `the Authority has approved the person in this case to be an auditor for the entity` IS FALSE) EQUALS NOTHING
-- (b): approved by the Authority in the case
#ASSERT (`s 2(1) "auditor" the person is an auditor` WITH `the person is a public accountant registered or deemed to be registered under the Accountants Act 2004` IS FALSE, `the provision being read is in Division 1 of Part 13 and the entity is not a company` IS TRUE, `the person is duly registered, licensed, approved or otherwise authorised to practise as an auditor under the laws of the place where the entity is formed or constituted` IS FALSE, `the person is so authorised under the laws of the place of the person's practice` IS FALSE, `the auditing standards applied to the entity's financial statements are those commonly applied in that place of practice` IS FALSE, `the auditing standards applied to the entity's financial statements are international auditing standards, by whatever name called` IS FALSE, `the Authority has approved the person in this case to be an auditor for the entity` IS TRUE) EQUALS JUST TRUE
-- Part 13, entity not a company, no limb: "includes" leaves the list open
#ASSERT (`s 2(1) "auditor" the person is an auditor` WITH `the person is a public accountant registered or deemed to be registered under the Accountants Act 2004` IS FALSE, `the provision being read is in Division 1 of Part 13 and the entity is not a company` IS TRUE, `the person is duly registered, licensed, approved or otherwise authorised to practise as an auditor under the laws of the place where the entity is formed or constituted` IS FALSE, `the person is so authorised under the laws of the place of the person's practice` IS FALSE, `the auditing standards applied to the entity's financial statements are those commonly applied in that place of practice` IS FALSE, `the auditing standards applied to the entity's financial statements are international auditing standards, by whatever name called` IS FALSE, `the Authority has approved the person in this case to be an auditor for the entity` IS FALSE) EQUALS NOTHING

-- chairs a board of directors
#ASSERT `s 2(1) "chairperson" the person is a chairperson` TRUE EQUALS JUST TRUE
-- does not
#ASSERT `s 2(1) "chairperson" the person is a chairperson` FALSE EQUALS JUST FALSE

-- (a) and (b) both met
#ASSERT `s 2(1) "chief executive officer" the person is a chief executive officer of the relevant person` TRUE TRUE TRUE EQUALS JUST TRUE
-- (b) not met: "and" joins (a) and (b)
#ASSERT `s 2(1) "chief executive officer" the person is a chief executive officer of the relevant person` TRUE TRUE FALSE EQUALS JUST FALSE
-- (a) not met
#ASSERT `s 2(1) "chief executive officer" the person is a chief executive officer of the relevant person` TRUE FALSE TRUE EQUALS JUST FALSE
-- the relevant person is not a body the definition names, nor a corporation: the definition has no "only" and does not say
#ASSERT `s 2(1) "chief executive officer" the person is a chief executive officer of the relevant person` FALSE TRUE TRUE EQUALS NOTHING

-- (a) and (b) both met
#ASSERT `s 2(1) "executive officer" the person is an executive officer of the relevant person` TRUE TRUE TRUE EQUALS JUST TRUE
-- (b) not met: "and" joins (a) and (b)
#ASSERT `s 2(1) "executive officer" the person is an executive officer of the relevant person` TRUE TRUE FALSE EQUALS JUST FALSE
-- (a) not met
#ASSERT `s 2(1) "executive officer" the person is an executive officer of the relevant person` TRUE FALSE TRUE EQUALS JUST FALSE
-- the relevant person is not a body the definition names, nor a corporation: the definition has no "only" and does not say
#ASSERT `s 2(1) "executive officer" the person is an executive officer of the relevant person` FALSE TRUE TRUE EQUALS NOTHING

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "company" the body is a company` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 4(1) of the Companies Act 1967"
#ASSERT `s 2(1) "company" the body is a company` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "corporation" the body is a corporation` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 4(1) of the Companies Act 1967"
#ASSERT `s 2(1) "corporation" the body is a corporation` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "director" the person is a director` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 4(1) of the Companies Act 1967"
#ASSERT `s 2(1) "director" the person is a director` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "officer" the person is an officer` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 4(1) of the Companies Act 1967"
#ASSERT `s 2(1) "officer" the person is an officer` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
