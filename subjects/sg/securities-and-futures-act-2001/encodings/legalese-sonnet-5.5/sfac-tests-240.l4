IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-periods`
IMPORT `sfac-239`
IMPORT `sfac-240`

-- Tests for sfac-240.l4 (s 240). Every expected value is written from the text of the Act (SFA2001.txt lines 38379 to 38827) before the code was run.
-- The arguments of a call are in the order of the function's GIVEN; a comment above a group names them.

§ `s 240(1): the bar`
-- arguments: the person makes an offer; this Subdivision applies; made in or with a prospectus; prepared under s 243; copy signed and lodged; registered; complies with prescribed requirements; the profile statement route (s 240(4))
-- every limb of (a)(i), (ii), (iii) and (b) met: "unless the offer" is satisfied, the bar does not bite
#ASSERT (`s 240(1) the person must not make the offer` TRUE (JUST TRUE) TRUE TRUE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
-- each limb missing in turn, the offer is made: the bar bites
#ASSERT (`s 240(1) the person must not make the offer` TRUE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 240(1) the person must not make the offer` TRUE (JUST TRUE) FALSE TRUE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 240(1) the person must not make the offer` TRUE (JUST TRUE) TRUE FALSE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 240(1) the person must not make the offer` TRUE (JUST TRUE) TRUE TRUE FALSE TRUE TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 240(1) the person must not make the offer` TRUE (JUST TRUE) TRUE TRUE TRUE FALSE TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 240(1) the person must not make the offer` TRUE (JUST TRUE) TRUE TRUE TRUE TRUE FALSE (JUST FALSE)) EQUALS JUST TRUE
-- no offer is made: the bar speaks only of a person who makes an offer (SPLIT-SITE (i): NOTHING)
#ASSERT (`s 240(1) the person must not make the offer` FALSE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE (JUST FALSE)) EQUALS NOTHING
-- the profile statement route (s 240(4)) is open: "Despite subsection (1)"
#ASSERT (`s 240(1) the person must not make the offer` TRUE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE (JUST TRUE)) EQUALS JUST FALSE
-- the Subdivision does not apply to the offer (an exemption or a declaration)
#ASSERT (`s 240(1) the person must not make the offer` TRUE (JUST FALSE) FALSE FALSE FALSE FALSE FALSE (JUST FALSE)) EQUALS JUST FALSE
-- an answer nobody has worked out is not turned into a yes or a no
#ASSERT (`s 240(1) the person must not make the offer` TRUE NOTHING FALSE FALSE FALSE FALSE FALSE (JUST FALSE)) EQUALS NOTHING
-- the route answers NOTHING (its own "if" gate failed, section 240(4) as a grant): the route is not shown open, so the bar bites
#ASSERT (`s 240(1) the person must not make the offer` TRUE (JUST TRUE) FALSE FALSE FALSE FALSE FALSE NOTHING) EQUALS JUST TRUE
#ASSERT (`s 240(1) the person must not make the offer` TRUE (JUST TRUE) TRUE TRUE TRUE TRUE TRUE NOTHING) EQUALS JUST FALSE
-- the gate is NOTHING but the offer meets every limb: the bar is off whatever the gate says
#ASSERT (`s 240(1) the person must not make the offer` TRUE NOTHING TRUE TRUE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
-- the profile statement route is open and the gate is NOTHING: the route decides first
#ASSERT (`s 240(1) the person must not make the offer` TRUE NOTHING FALSE FALSE FALSE FALSE FALSE (JUST TRUE)) EQUALS JUST FALSE

-- EXPECT BREACH: the bar bites and the person makes the offer
#TRACE (`s 240(1) the person shall not make the offer without a registered prospectus` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 240(1) make the offer` AT 3

-- EXPECT RESIDUAL: the bar bites and nothing has yet been done
#TRACE (`s 240(1) the person shall not make the offer without a registered prospectus` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH

-- EXPECT FULFILLED: the bar does not bite (the offer has a registered prospectus), so making the offer is no breach
#TRACE (`s 240(1) the person shall not make the offer without a registered prospectus` (`An offeror` "Acme Pte Ltd") (JUST FALSE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 240(1) make the offer` AT 3

§ `s 240(2) and (3): the preliminary document`
#ASSERT (`s 240(2) the person is deemed to have lodged a prospectus with the Authority` TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(2) the person is deemed to have lodged a prospectus with the Authority` FALSE) EQUALS NOTHING
-- arguments: a preliminary document referred to in s 240(2); it contains all the information a prospectus must contain, less what the Authority prescribes
#ASSERT (`s 240(3) the preliminary document contains all the information it must contain` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(3) the preliminary document contains all the information it must contain` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 240(3) the preliminary document contains all the information it must contain` FALSE TRUE) EQUALS NOTHING

§ `s 240(4): the profile statement route`
-- arguments: an extract or abridged version; prospectus prepared under s 243; profile statement prepared under s 246; copies signed and lodged; date the prospectus is lodged; date the profile statement is lodged; both registered; copies available for collection; complies with prescribed requirements
#ASSERT (`s 240(4) the offer may be made in or accompanied by a profile statement instead of a prospectus` TRUE TRUE TRUE TRUE (Date 1 3 2026) (Date 1 3 2026) TRUE TRUE TRUE) EQUALS JUST TRUE
-- "the prospectus is lodged no later than the profile statement": the day before is in, the day after is out
#ASSERT (`s 240(4) the offer may be made in or accompanied by a profile statement instead of a prospectus` TRUE TRUE TRUE TRUE (Date 28 2 2026) (Date 1 3 2026) TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(4) the offer may be made in or accompanied by a profile statement instead of a prospectus` TRUE TRUE TRUE TRUE (Date 2 3 2026) (Date 1 3 2026) TRUE TRUE TRUE) EQUALS NOTHING
-- each other limb missing in turn: a failed "if" gate on a permission is NOTHING (grant ruling of 2026-11-12, limit (1))
#ASSERT (`s 240(4) the offer may be made in or accompanied by a profile statement instead of a prospectus` FALSE TRUE TRUE TRUE (Date 1 3 2026) (Date 1 3 2026) TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 240(4) the offer may be made in or accompanied by a profile statement instead of a prospectus` TRUE FALSE TRUE TRUE (Date 1 3 2026) (Date 1 3 2026) TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 240(4) the offer may be made in or accompanied by a profile statement instead of a prospectus` TRUE TRUE FALSE TRUE (Date 1 3 2026) (Date 1 3 2026) TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 240(4) the offer may be made in or accompanied by a profile statement instead of a prospectus` TRUE TRUE TRUE FALSE (Date 1 3 2026) (Date 1 3 2026) TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 240(4) the offer may be made in or accompanied by a profile statement instead of a prospectus` TRUE TRUE TRUE TRUE (Date 1 3 2026) (Date 1 3 2026) FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 240(4) the offer may be made in or accompanied by a profile statement instead of a prospectus` TRUE TRUE TRUE TRUE (Date 1 3 2026) (Date 1 3 2026) TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 240(4) the offer may be made in or accompanied by a profile statement instead of a prospectus` TRUE TRUE TRUE TRUE (Date 1 3 2026) (Date 1 3 2026) TRUE TRUE FALSE) EQUALS NOTHING

§ `s 240(4A): who signs the copy lodged`
-- arguments: who makes the offer; the issuer is the government of a State; every director and proposed director of the issuer has signed; an official of the issuer's government has signed; the individual offeror has signed; every director of the entity offeror has signed; an official of the offeror government has signed; the issuer is controlled by the offeror and/or its related parties
-- (a) the issuer makes the offer: (i) a non-government issuer: every director and proposed director; (ii) a government issuer: an authorised official
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is the issuer` FALSE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is the issuer` FALSE FALSE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is the issuer` TRUE FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is the issuer` TRUE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (b) an individual who is not the issuer: (i)(A) that person, and (B) if the issuer is controlled by that person or related parties, also every director and proposed director; (ii) a government issuer: that person
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is an individual and is not the issuer` FALSE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is an individual and is not the issuer` FALSE FALSE FALSE TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is an individual and is not the issuer` FALSE TRUE FALSE TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is an individual and is not the issuer` FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is an individual and is not the issuer` TRUE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is an individual and is not the issuer` TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (c) an entity (not a government) that is not the issuer: (i)(A) every director of that entity, (B) if the issuer is controlled by it, also the issuer's directors; (ii) a government issuer: every director of that entity
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is an entity, not being the government of a State, and is not the issuer` FALSE FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is an entity, not being the government of a State, and is not the issuer` FALSE FALSE FALSE FALSE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is an entity, not being the government of a State, and is not the issuer` FALSE TRUE FALSE FALSE TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is an entity, not being the government of a State, and is not the issuer` FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is an entity, not being the government of a State, and is not the issuer` TRUE FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is an entity, not being the government of a State, and is not the issuer` TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (d) the government of a State that is not the issuer: (i)(A) an authorised official, (B) if controlled, also the issuer's directors; (ii) the issuer is the government of another State: an authorised official
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is the government of a State and is not the issuer` FALSE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is the government of a State and is not the issuer` FALSE FALSE FALSE FALSE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is the government of a State and is not the issuer` FALSE TRUE FALSE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is the government of a State and is not the issuer` FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is the government of a State and is not the issuer` TRUE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is the government of a State and is not the issuer` TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- a person making the offer outside the four cases: the text says nothing
#ASSERT (`s 240(4A) the copy lodged with the Authority has been signed as required` `s 240(4A) the person making the offer is none of these` FALSE TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS NOTHING

§ `s 240(4B) and (4C): signing by an authorised person`
#ASSERT (`s 240(4B) the requirement for signature by a director or equivalent person is satisfied` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(4B) the requirement for signature by a director or equivalent person is satisfied` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(4B) the requirement for signature by a director or equivalent person is satisfied` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 240(4C) the requirement for signature by a proposed director or equivalent person is satisfied` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(4C) the requirement for signature by a proposed director or equivalent person is satisfied` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(4C) the requirement for signature by a proposed director or equivalent person is satisfied` FALSE FALSE) EQUALS JUST FALSE

§ `s 240(5): no offer in respect of an entity not formed`
-- arguments: the person makes an offer; it is in respect of an entity or business trust not formed or not existing; this Subdivision applies
#ASSERT (`s 240(5) the person must not make the offer` TRUE TRUE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 240(5) the person must not make the offer` TRUE FALSE (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 240(5) the person must not make the offer` FALSE TRUE (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 240(5) the person must not make the offer` TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 240(5) the person must not make the offer` TRUE TRUE NOTHING) EQUALS NOTHING

-- EXPECT BREACH: the bar bites and the person makes the offer
#TRACE (`s 240(5) the person shall not make an offer in respect of an entity or business trust not formed` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 240(5) make the offer` AT 1

-- EXPECT FULFILLED: the bar does not bite
#TRACE (`s 240(5) the person shall not make an offer in respect of an entity or business trust not formed` (`An offeror` "Acme Pte Ltd") (JUST FALSE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 240(5) make the offer` AT 1

§ `s 240(7): the offence and its penalty`
-- arguments: what s 240(1) answers; what s 240(5) answers
#ASSERT (`s 240(7) the person is guilty of an offence` (JUST TRUE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 240(7) the person is guilty of an offence` (JUST FALSE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 240(7) the person is guilty of an offence` (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 240(7) the person is guilty of an offence` NOTHING (JUST TRUE)) EQUALS JUST TRUE
-- neither subsection is contravened: the text does not say that the person is guiltless (SPLIT-SITE (i): NOTHING)
#ASSERT (`s 240(7) the person is guilty of an offence` (JUST FALSE) (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 240(7) the person is guilty of an offence` NOTHING (JUST FALSE)) EQUALS NOTHING
-- a fine not exceeding $150,000, or imprisonment not exceeding 2 years (24 months), or both; a further fine not exceeding $15,000 a day
#ASSERT (`s 240(7) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 150000
#ASSERT (`s 240(7) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 24
#ASSERT (`s 240(7) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS TRUE
#ASSERT (`s 240(7) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 15000

§ `s 240(8): when the Authority may register`
-- arguments: date of lodgment; the day asked about; the days the Authority has prescribed; hearing notice given; extension notice given; extension granted on application; the date the extended period ends; withdrawal notice given
-- no notice: any day up to the last day of the prescribed period (lodged 1 March 2026, 7 days: 8 March), not after
#ASSERT (`s 240(8) the Authority may register the prospectus or profile statement on the day` (Date 1 3 2026) (Date 8 3 2026) 7 FALSE FALSE FALSE (Date 1 1 2000) FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(8) the Authority may register the prospectus or profile statement on the day` (Date 1 3 2026) (Date 9 3 2026) 7 FALSE FALSE FALSE (Date 1 1 2000) FALSE) EQUALS JUST FALSE
#ASSERT (`s 240(8) the Authority may register the prospectus or profile statement on the day` (Date 1 3 2026) (Date 1 3 2026) 7 FALSE FALSE FALSE (Date 1 1 2000) FALSE) EQUALS JUST TRUE
-- (a) a notice of an opportunity to be heard: the power in subsection (8) is not available
#ASSERT (`s 240(8) the Authority may register the prospectus or profile statement on the day` (Date 1 3 2026) (Date 5 3 2026) 7 TRUE FALSE FALSE (Date 1 1 2000) FALSE) EQUALS JUST FALSE
-- (b) a notice of an extension: not later than 28 days from lodgment (29 March 2026 is the last day)
#ASSERT (`s 240(8) the Authority may register the prospectus or profile statement on the day` (Date 1 3 2026) (Date 29 3 2026) 7 FALSE TRUE FALSE (Date 1 1 2000) FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(8) the Authority may register the prospectus or profile statement on the day` (Date 1 3 2026) (Date 30 3 2026) 7 FALSE TRUE FALSE (Date 1 1 2000) FALSE) EQUALS JUST FALSE
-- (c) an extension on the person's application: up to and including the day the extended period ends (30 June 2026)
#ASSERT (`s 240(8) the Authority may register the prospectus or profile statement on the day` (Date 1 3 2026) (Date 30 6 2026) 7 FALSE FALSE TRUE (Date 30 6 2026) FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(8) the Authority may register the prospectus or profile statement on the day` (Date 1 3 2026) (Date 1 7 2026) 7 FALSE FALSE TRUE (Date 30 6 2026) FALSE) EQUALS JUST FALSE
-- (d) the person withdraws the lodgment: the Authority must not register
#ASSERT (`s 240(8) the Authority may register the prospectus or profile statement on the day` (Date 1 3 2026) (Date 5 3 2026) 7 FALSE FALSE FALSE (Date 1 1 2000) TRUE) EQUALS JUST FALSE

§ `s 240(8A): registration after a hearing notice`
-- arguments: a hearing notice was given; the Authority decides not to refuse; date of lodgment; the date it proceeds; the days the Authority prescribes as the earliest day
-- lodged 1 March 2026, 7 days: the earliest day is 8 March 2026
#ASSERT (`s 240(8A) the Authority may proceed with the registration on the date` TRUE TRUE (Date 1 3 2026) (Date 10 3 2026) 7) EQUALS JUST TRUE
#ASSERT (`s 240(8A) the Authority may proceed with the registration on the date` TRUE TRUE (Date 1 3 2026) (Date 8 3 2026) 7) EQUALS JUST TRUE
#ASSERT (`s 240(8A) the Authority may proceed with the registration on the date` TRUE TRUE (Date 1 3 2026) (Date 7 3 2026) 7) EQUALS JUST FALSE
-- the "Where" gate fails (SPLIT-SITE (ii): JUST FALSE under rule (b) of the periods ruling)
#ASSERT (`s 240(8A) the Authority may proceed with the registration on the date` FALSE TRUE (Date 1 3 2026) (Date 10 3 2026) 7) EQUALS JUST FALSE
#ASSERT (`s 240(8A) the Authority may proceed with the registration on the date` TRUE FALSE (Date 1 3 2026) (Date 10 3 2026) 7) EQUALS JUST FALSE

§ `s 240(9): a preliminary document is not registered until the full prospectus is lodged`
-- arguments: the prospectus lodged is a preliminary document; the full signed copy with all information has been lodged
#ASSERT (`s 240(9) the Authority must not register the prospectus` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 240(9) the Authority must not register the prospectus` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(9) the Authority must not register the prospectus` FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 240(9) the Authority must not register the prospectus` FALSE TRUE) EQUALS NOTHING

§ `s 240(9A): an amendment may be lodged before, but not after, registration`
-- arguments: the day the amendment would be lodged; the day the Authority registered (NOTHING if not yet)
#ASSERT (`s 240(9A) the person may lodge an amendment on the day` (Date 1 3 2026) NOTHING) EQUALS JUST TRUE
#ASSERT (`s 240(9A) the person may lodge an amendment on the day` (Date 1 3 2026) (JUST (Date 2 3 2026))) EQUALS JUST TRUE
#ASSERT (`s 240(9A) the person may lodge an amendment on the day` (Date 2 3 2026) (JUST (Date 2 3 2026))) EQUALS JUST FALSE
#ASSERT (`s 240(9A) the person may lodge an amendment on the day` (Date 3 3 2026) (JUST (Date 2 3 2026))) EQUALS JUST FALSE

§ `s 240(10) and (11): the date taken as the date of lodgment`
-- arguments: the date the original was lodged; an amendment is lodged; the date of the amendment; the amendment is lodged with the consent of the Authority
#ASSERT (`s 240(10) and (11) the date taken as the date of lodgment for the purposes of subsection (8)` (Date 1 3 2026) TRUE (Date 5 3 2026) FALSE) EQUALS Date 5 3 2026
#ASSERT (`s 240(10) and (11) the date taken as the date of lodgment for the purposes of subsection (8)` (Date 1 3 2026) TRUE (Date 5 3 2026) TRUE) EQUALS Date 1 3 2026
#ASSERT (`s 240(10) and (11) the date taken as the date of lodgment for the purposes of subsection (8)` (Date 1 3 2026) FALSE (Date 5 3 2026) FALSE) EQUALS Date 1 3 2026

§ `s 240(11A), (12), (18), (19)`
#ASSERT (`s 240(11A) the amendment is treated as part of the original prospectus or profile statement` TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(11A) the amendment is treated as part of the original prospectus or profile statement` FALSE) EQUALS NOTHING
-- arguments: lodged under s 240; the Authority requires a form or medium
#ASSERT (`s 240(12) the person making the offer must provide the Authority with a copy in the form or medium required` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(12) the person making the offer must provide the Authority with a copy in the form or medium required` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 240(12) the person making the offer must provide the Authority with a copy in the form or medium required` FALSE TRUE) EQUALS NOTHING
-- the duty has no time limit and no stated consequence: it can be done (FULFILLED) or left pending (RESIDUAL), never breached
-- EXPECT FULFILLED
#TRACE (`s 240(12) the person making the offer must provide the Authority with a copy for publication` (`An offeror` "Acme Pte Ltd")) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 240(12) provide the Authority with a copy in the form or medium required` AT 4
-- EXPECT RESIDUAL
#TRACE (`s 240(12) the person making the offer must provide the Authority with a copy for publication` (`An offeror` "Acme Pte Ltd")) AT 0 WITH
#ASSERT (`s 240(18) this section yields to section 240A for the offer` TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(18) this section yields to section 240A for the offer` FALSE) EQUALS NOTHING
#ASSERT (`s 240(19) the information is a statement for the purposes of subsections (13)(a) and (14)(a)` TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(19) the information is a statement for the purposes of subsections (13)(a) and (14)(a)` FALSE) EQUALS NOTHING

§ `s 240(13): the Authority must refuse to register a prospectus`
-- arguments, in order: false or misleading (opinion); information omitted; copy not signed; does not comply (opinion); expert's consent not lodged; issue manager's consent not lodged; underwriter's consent not lodged; not in the public interest (opinion)
#ASSERT (`s 240(13) the Authority must refuse to register the prospectus` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(13) the Authority must refuse to register the prospectus` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(13) the Authority must refuse to register the prospectus` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(13) the Authority must refuse to register the prospectus` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(13) the Authority must refuse to register the prospectus` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(13) the Authority must refuse to register the prospectus` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(13) the Authority must refuse to register the prospectus` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(13) the Authority must refuse to register the prospectus` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(13) the Authority must refuse to register the prospectus` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE

§ `s 240(14): the Authority must refuse to register a profile statement`
-- arguments, in order: false or misleading (opinion); information omitted or prohibited information included; copy not signed; expert's consent not lodged; issue manager's consent not lodged; underwriter's consent not lodged; does not comply (opinion); the prospectus is not registered; not in the public interest (opinion)
#ASSERT (`s 240(14) the Authority must refuse to register the profile statement` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(14) the Authority must refuse to register the profile statement` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(14) the Authority must refuse to register the profile statement` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(14) the Authority must refuse to register the profile statement` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(14) the Authority must refuse to register the profile statement` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(14) the Authority must refuse to register the profile statement` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(14) the Authority must refuse to register the profile statement` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(14) the Authority must refuse to register the profile statement` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(14) the Authority must refuse to register the profile statement` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 240(14) the Authority must refuse to register the profile statement` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE

§ `s 240(15): the opportunity to be heard`
-- arguments: the Authority refuses under (13) or (14); the refusal is on the public-interest ground; (a) winding up or dissolution; (b) undischarged bankrupt; (c) receiver appointed; the refusal rests on one of those circumstances
#ASSERT (`s 240(15) the Authority must give the person making the offer an opportunity to be heard before refusing` TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 240(15) the Authority must give the person making the offer an opportunity to be heard before refusing` TRUE TRUE TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 240(15) the Authority must give the person making the offer an opportunity to be heard before refusing` TRUE TRUE FALSE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 240(15) the Authority must give the person making the offer an opportunity to be heard before refusing` TRUE TRUE FALSE FALSE TRUE TRUE) EQUALS JUST FALSE
-- the public-interest ground without one of the three circumstances: a hearing must be given
#ASSERT (`s 240(15) the Authority must give the person making the offer an opportunity to be heard before refusing` TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
-- a circumstance exists but the refusal is on another ground: a hearing must be given
#ASSERT (`s 240(15) the Authority must give the person making the offer an opportunity to be heard before refusing` TRUE FALSE TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
