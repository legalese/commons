IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfab-insider-3`

-- Tests for sfab-insider-3 (Securities and Futures Act 2001, Part 12). Every expected value below is written from the text of the section named above it,
-- by hand, with the inputs that decide it; none is copied from output. Case order: the case that meets the provision, then each input taken away in turn,
-- then the case the text does not decide. A `#S` case is one that takes a branch marked SPLIT-SITE in the module.


-- s 222 sections 218(2) and 219(2) do not apply to the redemption of units
#ASSERT `s 222 sections 218(2) and 219(2) do not apply to the redemption of units` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 222 sections 218(2) and 219(2) do not apply to the redemption of units` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 222 sections 218(2) and 219(2) do not apply to the redemption of units` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 222 sections 218(2) and 219(2) do not apply to the redemption of units` TRUE TRUE FALSE EQUALS NOTHING

-- s 223(1) sections 218(2) and 219(2) do not apply to the underwriting act
#ASSERT `s 223(1) sections 218(2) and 219(2) do not apply to the underwriting act` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 223(1) sections 218(2) and 219(2) do not apply to the underwriting act` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 223(1) sections 218(2) and 219(2) do not apply to the underwriting act` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 223(1) sections 218(2) and 219(2) do not apply to the underwriting act` FALSE FALSE FALSE EQUALS NOTHING

-- s 223(2) sections 218(3) and 219(3) do not apply to the underwriting communication
#ASSERT `s 223(2) sections 218(3) and 219(3) do not apply to the underwriting communication` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 223(2) sections 218(3) and 219(3) do not apply to the underwriting communication` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 223(2) sections 218(3) and 219(3) do not apply to the underwriting communication` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 223(2) sections 218(3) and 219(3) do not apply to the underwriting communication` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 223(2) sections 218(3) and 219(3) do not apply to the underwriting communication` FALSE FALSE FALSE EQUALS NOTHING

-- s 224(1) sections 218(2) and 219(2) do not apply to the purchase
#ASSERT `s 224(1) sections 218(2) and 219(2) do not apply to the purchase` TRUE EQUALS JUST TRUE
#ASSERT `s 224(1) sections 218(2) and 219(2) do not apply to the purchase` FALSE EQUALS NOTHING

-- s 224(2) sections 218(2) and 219(2) do not apply to the sale
#ASSERT `s 224(2) sections 218(2) and 219(2) do not apply to the sale` TRUE EQUALS JUST TRUE
#ASSERT `s 224(2) sections 218(2) and 219(2) do not apply to the sale` FALSE EQUALS NOTHING

-- s 225 sections 218(3) and 219(3) do not apply to the communication
#ASSERT `s 225 sections 218(3) and 219(3) do not apply to the communication` TRUE EQUALS JUST TRUE
#ASSERT `s 225 sections 218(3) and 219(3) do not apply to the communication` FALSE EQUALS NOTHING

-- s 226(1)(a) the corporation is taken to possess the information that its officer possesses
#ASSERT `s 226(1)(a) the corporation is taken to possess the information that its officer possesses` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 226(1)(a) the corporation is taken to possess the information that its officer possesses` TRUE FALSE EQUALS NOTHING
#ASSERT `s 226(1)(a) the corporation is taken to possess the information that its officer possesses` FALSE TRUE EQUALS NOTHING

-- s 226(1)(b) the corporation is presumed to know or ought reasonably to know the matter or thing
#ASSERT `s 226(1)(b) the corporation is presumed to know or ought reasonably to know the matter or thing` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 226(1)(b) the corporation is presumed to know or ought reasonably to know the matter or thing` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 226(1)(b) the corporation is presumed to know or ought reasonably to know the matter or thing` FALSE FALSE EQUALS NOTHING
#ASSERT `s 226(1)(b) the corporation is presumed to know or ought reasonably to know the matter or thing` FALSE TRUE EQUALS NOTHING

-- s 226(2) the corporation does not contravene section 218(2) or 219(2) by reason of its officer's information
#ASSERT `s 226(2) the corporation does not contravene section 218(2) or 219(2) by reason of its officer's information` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 226(2) the corporation does not contravene section 218(2) or 219(2) by reason of its officer's information` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 226(2) the corporation does not contravene section 218(2) or 219(2) by reason of its officer's information` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 226(2) the corporation does not contravene section 218(2) or 219(2) by reason of its officer's information` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 226(2) the corporation does not contravene section 218(2) or 219(2) by reason of its officer's information` FALSE TRUE TRUE TRUE EQUALS NOTHING

-- s 227(1)(a) the partner is taken to possess the information that another partner, an employee or a manager possesses
#ASSERT `s 227(1)(a) the partner is taken to possess the information that another partner, an employee or a manager possesses` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 227(1)(a) the partner is taken to possess the information that another partner, an employee or a manager possesses` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 227(1)(a) the partner is taken to possess the information that another partner, an employee or a manager possesses` FALSE FALSE EQUALS NOTHING

-- s 227(1)(b) every partner is presumed to know or ought reasonably to know the matter or thing
#ASSERT `s 227(1)(b) every partner is presumed to know or ought reasonably to know the matter or thing` TRUE EQUALS JUST TRUE
#ASSERT `s 227(1)(b) every partner is presumed to know or ought reasonably to know the matter or thing` FALSE EQUALS NOTHING

-- s 227(2) the partners do not contravene section 218(2) or 219(2) by reason of one partner's, manager's or employee's information
#ASSERT `s 227(2) the partners do not contravene section 218(2) or 219(2) by reason of one partner's, manager's or employee's information` TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 227(2) the partners do not contravene section 218(2) or 219(2) by reason of one partner's, manager's or employee's information` TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 227(2) the partners do not contravene section 218(2) or 219(2) by reason of one partner's, manager's or employee's information` TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 227(2) the partners do not contravene section 218(2) or 219(2) by reason of one partner's, manager's or employee's information` TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 227(2) the partners do not contravene section 218(2) or 219(2) by reason of one partner's, manager's or employee's information` TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 227(2) the partners do not contravene section 218(2) or 219(2) by reason of one partner's, manager's or employee's information` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING

-- s 227(3) the partner does not contravene section 218(2) or 219(2) merely because the partner is taken to possess the information
#ASSERT `s 227(3) the partner does not contravene section 218(2) or 219(2) merely because the partner is taken to possess the information` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 227(3) the partner does not contravene section 218(2) or 219(2) merely because the partner is taken to possess the information` TRUE FALSE EQUALS NOTHING
#ASSERT `s 227(3) the partner does not contravene section 218(2) or 219(2) merely because the partner is taken to possess the information` FALSE TRUE EQUALS NOTHING

-- s 228 the individual does not contravene section 218(2) or 219(2) merely because the individual is aware of the individual's own intentions or activities
#ASSERT `s 228 the individual does not contravene section 218(2) or 219(2) merely because the individual is aware of the individual's own intentions or activities` TRUE EQUALS JUST TRUE
#ASSERT `s 228 the individual does not contravene section 218(2) or 219(2) merely because the individual is aware of the individual's own intentions or activities` FALSE EQUALS NOTHING

-- s 229(1) the corporation does not contravene section 218(2) or 219(2) merely because the corporation is aware of its own intentions or activities
#ASSERT `s 229(1) the corporation does not contravene section 218(2) or 219(2) merely because the corporation is aware of its own intentions or activities` TRUE EQUALS JUST TRUE
#ASSERT `s 229(1) the corporation does not contravene section 218(2) or 219(2) merely because the corporation is aware of its own intentions or activities` FALSE EQUALS NOTHING

-- s 229(3) subsection (2) applies to the officer's awareness
#ASSERT `s 229(3) subsection (2) applies to the officer's awareness` TRUE EQUALS JUST TRUE
#ASSERT `s 229(3) subsection (2) applies to the officer's awareness` FALSE EQUALS JUST FALSE

-- s 229(2) the corporation does not contravene section 218(2) or 219(2) merely because an officer is aware of the corporation's intentions or activities
#ASSERT `s 229(2) the corporation does not contravene section 218(2) or 219(2) merely because an officer is aware of the corporation's intentions or activities` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 229(2) the corporation does not contravene section 218(2) or 219(2) merely because an officer is aware of the corporation's intentions or activities` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 229(2) the corporation does not contravene section 218(2) or 219(2) merely because an officer is aware of the corporation's intentions or activities` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 229(2) the corporation does not contravene section 218(2) or 219(2) merely because an officer is aware of the corporation's intentions or activities` FALSE (JUST TRUE) EQUALS NOTHING

-- s 229(5) subsection (4) applies to the person's awareness
#ASSERT `s 229(5) subsection (4) applies to the person's awareness` TRUE EQUALS JUST TRUE
#ASSERT `s 229(5) subsection (4) applies to the person's awareness` FALSE EQUALS JUST FALSE

-- s 229(4) the person does not contravene section 218(2) or 219(2) by dealing on behalf of a corporation merely because the person is aware of the corporation's intentions or activities
#ASSERT `s 229(4) the person does not contravene section 218(2) or 219(2) by dealing on behalf of a corporation merely because the person is aware of the corporation's intentions or activities` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 229(4) the person does not contravene section 218(2) or 219(2) by dealing on behalf of a corporation merely because the person is aware of the corporation's intentions or activities` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 229(4) the person does not contravene section 218(2) or 219(2) by dealing on behalf of a corporation merely because the person is aware of the corporation's intentions or activities` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 229(4) the person does not contravene section 218(2) or 219(2) by dealing on behalf of a corporation merely because the person is aware of the corporation's intentions or activities` FALSE (JUST TRUE) EQUALS NOTHING

-- s 230(1) the holder or representative does not contravene section 218(2) or 219(2) by an unsolicited transaction for a principal
#ASSERT `s 230(1) the holder or representative does not contravene section 218(2) or 219(2) by an unsolicited transaction for a principal` TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 230(1) the holder or representative does not contravene section 218(2) or 219(2) by an unsolicited transaction for a principal` FALSE TRUE TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 230(1) the holder or representative does not contravene section 218(2) or 219(2) by an unsolicited transaction for a principal` TRUE FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 230(1) the holder or representative does not contravene section 218(2) or 219(2) by an unsolicited transaction for a principal` TRUE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 230(1) the holder or representative does not contravene section 218(2) or 219(2) by an unsolicited transaction for a principal` TRUE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 230(1) the holder or representative does not contravene section 218(2) or 219(2) by an unsolicited transaction for a principal` TRUE TRUE TRUE NOTHING EQUALS NOTHING

-- s 230(2) section 230 does not affect the application of sections 218(2) and 219(2) to the principal
#ASSERT `s 230(2) section 230 does not affect the application of sections 218(2) and 219(2) to the principal` TRUE EQUALS JUST TRUE
#ASSERT `s 230(2) section 230 does not affect the application of sections 218(2) and 219(2) to the principal` FALSE EQUALS NOTHING

-- s 231(1) the person has the parity of information defence to the contravention by dealing or procuring
#ASSERT `s 231(1) the person has the parity of information defence to the contravention by dealing or procuring` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 231(1) the person has the parity of information defence to the contravention by dealing or procuring` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 231(1) the person has the parity of information defence to the contravention by dealing or procuring` TRUE FALSE FALSE EQUALS JUST FALSE  -- S
#ASSERT `s 231(1) the person has the parity of information defence to the contravention by dealing or procuring` FALSE TRUE TRUE EQUALS NOTHING

-- s 231(2) the person has the parity of information defence to the contravention by communicating
#ASSERT `s 231(2) the person has the parity of information defence to the contravention by communicating` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 231(2) the person has the parity of information defence to the contravention by communicating` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 231(2) the person has the parity of information defence to the contravention by communicating` TRUE FALSE FALSE EQUALS JUST FALSE  -- S
#ASSERT `s 231(2) the person has the parity of information defence to the contravention by communicating` FALSE TRUE TRUE EQUALS NOTHING
