-- a name changed under the Companies Act 1967: the change does not affect the corporation's identity or the application of this Act or any other written law to it
#ASSERT `s 2(3) the change of the corporation's name does not affect its identity or the application of the law to it` TRUE EQUALS JUST TRUE
-- a change made some other way: the text does not say
#ASSERT `s 2(3) the change of the corporation's name does not affect its identity or the application of the law to it` FALSE EQUALS NOTHING

-- exactly 5%: "not less than 5%"
#ASSERT `s 2(4) the person has a substantial shareholding in the corporation` TRUE 5 100 EQUALS JUST TRUE
-- 4.99% is less than 5%
#ASSERT `s 2(4) the person has a substantial shareholding in the corporation` TRUE 499 10000 EQUALS JUST FALSE
-- 5.01%
#ASSERT `s 2(4) the person has a substantial shareholding in the corporation` TRUE 501 10000 EQUALS JUST TRUE
-- limb (a) fails: no interest in a voting share, however many votes are stated
#ASSERT `s 2(4) the person has a substantial shareholding in the corporation` FALSE 50 100 EQUALS JUST FALSE
-- limb (b) fails: 4%
#ASSERT `s 2(4) the person has a substantial shareholding in the corporation` TRUE 4 100 EQUALS JUST FALSE
-- all the votes
#ASSERT `s 2(4) the person has a substantial shareholding in the corporation` TRUE 100 100 EQUALS JUST TRUE

-- exactly 5% of class A (it would be only 0.5% of the whole corporation): subsection (5) looks at one class
#ASSERT `s 2(5) the person has a substantial shareholding in the corporation whose share capital has 2 or more classes` TRUE (LIST (`Class of voting shares` WITH `the name of the class` IS "A", `the votes attached to the voting shares in the class that the person has an interest in` IS 5, `the total votes attached to all the voting shares in the class, excluding treasury shares` IS 100), (`Class of voting shares` WITH `the name of the class` IS "B", `the votes attached to the voting shares in the class that the person has an interest in` IS 0, `the total votes attached to all the voting shares in the class, excluding treasury shares` IS 900)) EQUALS JUST TRUE
-- 4% of class A and about 1.1% of class B: under 5% in each
#ASSERT `s 2(5) the person has a substantial shareholding in the corporation whose share capital has 2 or more classes` TRUE (LIST (`Class of voting shares` WITH `the name of the class` IS "A", `the votes attached to the voting shares in the class that the person has an interest in` IS 4, `the total votes attached to all the voting shares in the class, excluding treasury shares` IS 100), (`Class of voting shares` WITH `the name of the class` IS "B", `the votes attached to the voting shares in the class that the person has an interest in` IS 10, `the total votes attached to all the voting shares in the class, excluding treasury shares` IS 900)) EQUALS JUST FALSE
-- no interest in any class: limb (a) fails
#ASSERT `s 2(5) the person has a substantial shareholding in the corporation whose share capital has 2 or more classes` TRUE (LIST (`Class of voting shares` WITH `the name of the class` IS "A", `the votes attached to the voting shares in the class that the person has an interest in` IS 0, `the total votes attached to all the voting shares in the class, excluding treasury shares` IS 100), (`Class of voting shares` WITH `the name of the class` IS "B", `the votes attached to the voting shares in the class that the person has an interest in` IS 0, `the total votes attached to all the voting shares in the class, excluding treasury shares` IS 900)) EQUALS JUST FALSE
-- no class listed
#ASSERT `s 2(5) the person has a substantial shareholding in the corporation whose share capital has 2 or more classes` TRUE EMPTY EQUALS JUST FALSE
-- under 5% of class A but exactly 5% of class B: "one of those classes"
#ASSERT `s 2(5) the person has a substantial shareholding in the corporation whose share capital has 2 or more classes` TRUE (LIST (`Class of voting shares` WITH `the name of the class` IS "A", `the votes attached to the voting shares in the class that the person has an interest in` IS 4, `the total votes attached to all the voting shares in the class, excluding treasury shares` IS 100), (`Class of voting shares` WITH `the name of the class` IS "B", `the votes attached to the voting shares in the class that the person has an interest in` IS 45, `the total votes attached to all the voting shares in the class, excluding treasury shares` IS 900)) EQUALS JUST TRUE
-- a corporation of one class: subsection (5) does not speak to it
#ASSERT `s 2(5) the person has a substantial shareholding in the corporation whose share capital has 2 or more classes` FALSE (LIST (`Class of voting shares` WITH `the name of the class` IS "A", `the votes attached to the voting shares in the class that the person has an interest in` IS 100, `the total votes attached to all the voting shares in the class, excluding treasury shares` IS 100)) EQUALS NOTHING

-- a substantial shareholding under (4) makes a substantial shareholder
#ASSERT `s 2(6) the person is a substantial shareholder in the corporation` TRUE FALSE EQUALS JUST TRUE
-- a substantial shareholding under (5) does too
#ASSERT `s 2(6) the person is a substantial shareholder in the corporation` FALSE TRUE EQUALS JUST TRUE
-- neither: (6) is silent about a person without a substantial shareholding
#ASSERT `s 2(6) the person is a substantial shareholder in the corporation` FALSE FALSE EQUALS NOTHING
