IMPORT prelude
IMPORT daydate
IMPORT `sfa-application`

-- Tests for sfa-application.
-- Expected values are written from the text of the Act (the quote lines in the module under test), never from its output.

-- a transitional licence is in force and the activities are regulated and authorised by section 66: the Act does not apply
#ASSERT `s 4B this Act applies to the person in respect of the activities` TRUE TRUE EQUALS JUST FALSE
-- a licence is in force but the activity is not one regulated and authorised by section 66: section 4B is silent
#ASSERT `s 4B this Act applies to the person in respect of the activities` TRUE FALSE EQUALS NOTHING
-- no transitional approval or licence in force: section 4B is silent
#ASSERT `s 4B this Act applies to the person in respect of the activities` FALSE TRUE EQUALS NOTHING
-- neither
#ASSERT `s 4B this Act applies to the person in respect of the activities` FALSE FALSE EQUALS NOTHING
