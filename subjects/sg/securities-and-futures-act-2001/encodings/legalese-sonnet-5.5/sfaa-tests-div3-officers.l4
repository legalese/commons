IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfaa-div1-directors`
IMPORT `sfaa-div3-reit`
IMPORT `sfaa-div3-officers`

-- Tests for sfaa-div3-officers.l4 (sections 137Y to 137ZC). Every expected value is written from the text, beside the assertion.
-- Parts of this file are generated from the Division 1 tests (sections 133, 134, 136 and 137G), with the same words changed as in the module.
-- Dates: 2 November 2026 is a Monday; 6 November 2026 is a public holiday in the examples that have one.







§ `s 137Y(1): who must give written notice`
-- a director, units held: the duty; a chief executive officer likewise
#ASSERT `s 137Y(1) the director or chief executive officer must give the responsible person written notice of the matter` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 137Y(1) the director or chief executive officer must give the responsible person written notice of the matter` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- not the responsible person of a trust within Division 3, neither a director nor a chief executive officer, or nothing held and no change: not covered
#ASSERT `s 137Y(1) the director or chief executive officer must give the responsible person written notice of the matter` FALSE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 137Y(1) the director or chief executive officer must give the responsible person written notice of the matter` TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 137Y(1) the director or chief executive officer must give the responsible person written notice of the matter` TRUE TRUE FALSE FALSE EQUALS NOTHING

§ `s 137Y(2)(a): the form and information`
-- the Authority has not prescribed one: the text points outside itself
#ASSERT `s 137Y(2)(a) the notice is in the form and contains the information the Authority prescribes` FALSE TRUE EQUALS NOTHING
#ASSERT `s 137Y(2)(a) the notice is in the form and contains the information the Authority prescribes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137Y(2)(a) the notice is in the form and contains the information the Authority prescribes` TRUE FALSE EQUALS JUST FALSE

§ `s 137Y(2)(b): the time (2 business days)`
-- a change: the person became aware on Monday 2 Nov and would have been aware on Friday 30 Oct with reasonable diligence; the earlier day starts the count (s 130(6))
-- 30 Oct + 2 business days = Tuesday 3 Nov (31 Oct and 1 Nov are the weekend)
#ASSERT `s 137Y(2)(b)(i) the last day for the notice of a change` (Date 2 11 2026) (Date 30 10 2026) (LIST) EQUALS Date 3 11 2026
-- the diligence day is later than the actual day: the actual day starts the count; 2 Nov + 2 business days = Wednesday 4 Nov
#ASSERT `s 137Y(2)(b)(i) the last day for the notice of a change` (Date 2 11 2026) (Date 3 11 2026) (LIST) EQUALS Date 4 11 2026
-- a public holiday inside the count pushes the last day on: 4 Nov + 2 business days with Fri 6 Nov a holiday = Monday 9 Nov
#ASSERT `s 137Y(2)(b)(i) the last day for the notice of a change` (Date 4 11 2026) (Date 4 11 2026) (LIST (Date 6 11 2026)) EQUALS Date 9 11 2026
-- any other notice: two business days after whichever of the two events is later ("whichever last occurs")
#ASSERT `s 137Y(2)(b)(ii) the last day for any other notice` (Date 2 11 2026) (Date 4 11 2026) (LIST) EQUALS Date 6 11 2026
#ASSERT `s 137Y(2)(b)(ii) the last day for any other notice` (Date 4 11 2026) (Date 2 11 2026) (LIST) EQUALS Date 6 11 2026
#ASSERT `s 137Y(2)(b)(ii) the last day for any other notice` (Date 4 11 2026) (Date 2 11 2026) (LIST (Date 6 11 2026)) EQUALS Date 9 11 2026
-- in time: a notice of a change given on the last day is in time; the day after is not (the text says "within 2 business days after")
#ASSERT `s 137Y(2)(b) the notice is given in time` TRUE (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 4 11 2026) (LIST) EQUALS JUST TRUE
#ASSERT `s 137Y(2)(b) the notice is given in time` TRUE (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 5 11 2026) (LIST) EQUALS JUST FALSE
-- a notice given on the very day the person becomes aware is in time (fork register A3)
#ASSERT `s 137Y(2)(b) the notice is given in time` TRUE (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (LIST) EQUALS JUST TRUE
-- any other notice: became director on 2 Nov, acquired the interest on 4 Nov: the last day is 6 Nov; given on 6 Nov in time, on 9 Nov late
#ASSERT `s 137Y(2)(b) the notice is given in time` FALSE (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 4 11 2026) (Date 6 11 2026) (LIST) EQUALS JUST TRUE
#ASSERT `s 137Y(2)(b) the notice is given in time` FALSE (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 4 11 2026) (Date 9 11 2026) (LIST) EQUALS JUST FALSE
-- the same case with 6 Nov a public holiday: the last day is 9 Nov
#ASSERT `s 137Y(2)(b) the notice is given in time` FALSE (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 4 11 2026) (Date 9 11 2026) (LIST (Date 6 11 2026)) EQUALS JUST TRUE

§ `s 137Y(1) and (2): the rule and its breach path`
-- EXPECT FULFILLED
#TRACE `s 137Y(1) and (2) the director or chief executive officer must give written notice within 2 business days` (Individual "the director") AT 0 WITH
    PARTY Individual "the director" DOES `s 137Y give the responsible person written notice` AT 1
-- EXPECT FULFILLED
#TRACE `s 137Y(1) and (2) the director or chief executive officer must give written notice within 2 business days` (Individual "the director") AT 0 WITH
    PARTY Individual "the director" DOES `s 137Y give the responsible person written notice` AT 2
-- EXPECT BREACH
#TRACE `s 137Y(1) and (2) the director or chief executive officer must give written notice within 2 business days` (Individual "the director") AT 0 WITH
    PARTY Individual "the director" DOES `s 137Y give the responsible person written notice` AT 3
-- EXPECT BREACH
#TRACE `s 137Y(1) and (2) the director or chief executive officer must give written notice within 2 business days` (Individual "the director") AT 0 WITH
    (WAITUNTIL 5)

§ `s 137Y(4): "family member"`
-- a spouse, of any age
#ASSERT `s 137Y(4) "family member" the person is a family member` `a spouse` 45 EQUALS JUST TRUE
-- a child below 21 is a family member; a child of 21 or over is the text's no ("below the age of 21 years", fork register A2: the age limits the children)
#ASSERT `s 137Y(4) "family member" the person is a family member` `a son` 20 EQUALS JUST TRUE
#ASSERT `s 137Y(4) "family member" the person is a family member` `a son` 21 EQUALS JUST FALSE
#ASSERT `s 137Y(4) "family member" the person is a family member` `a stepdaughter` 12 EQUALS JUST TRUE
#ASSERT `s 137Y(4) "family member" the person is a family member` `an adopted daughter` 30 EQUALS JUST FALSE
-- any other relation is outside the definition ("means a spouse, or a son, ...")
#ASSERT `s 137Y(4) "family member" the person is a family member` `a mother` 60 EQUALS JUST FALSE
#ASSERT `s 137Y(4) "family member" the person is a family member` `a brother` 20 EQUALS JUST FALSE
#ASSERT `s 137Y(4) the child is below the age of 21 years` 20 EQUALS JUST TRUE
#ASSERT `s 137Y(4) the child is below the age of 21 years` 21 EQUALS JUST FALSE


§ `s 137Y(3) and (4): deemed interests and the meaning of "unit"`
-- (3): a family member who is not himself or herself a director or chief executive officer of the responsible person, and who holds an interest
#ASSERT `s 137Y(3) the director or chief executive officer is deemed to have the family member's interest` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
-- a family member who holds nothing: "if" is not met, the text's no (marginal reading (a))
#ASSERT `s 137Y(3) the director or chief executive officer is deemed to have the family member's interest` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
-- a family member who is himself or herself a director: carved out in the text's own words
#ASSERT `s 137Y(3) the director or chief executive officer is deemed to have the family member's interest` (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 137Y(3) the director or chief executive officer is deemed to have the family member's interest` (JUST FALSE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 137Y(3) the director or chief executive officer is deemed to have the family member's interest` NOTHING FALSE TRUE EQUALS NOTHING
-- (4) "unit" in relation to a debenture: a right or interest in the debenture, or an option to acquire one
#ASSERT `s 137Y(4) "unit" in relation to a debenture the thing is a unit` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137Y(4) "unit" in relation to a debenture the thing is a unit` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 137Y(4) "unit" in relation to a debenture the thing is a unit` FALSE FALSE EQUALS JUST FALSE

§ `s 137Z(1) to (3): penalties`
#ASSERT `s 137Z(1) the person is guilty of an offence under subsection (1)` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 137Z(1) the person is guilty of an offence under subsection (1)` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 137Z(1) the person is guilty of an offence under subsection (1)` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137Z(1) the person is guilty of an offence under subsection (1)` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 137Z(1) the penalty on conviction` EQUALS Penalty OF 250000, 24, TRUE, 25000
#ASSERT `s 137Z(2) the person is guilty of an offence under subsection (2)` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 137Z(2) the person is guilty of an offence under subsection (2)` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 137Z(2) the person is guilty of an offence under subsection (2)` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 137Z(2) the penalty on conviction` EQUALS Penalty OF 25000, 0, FALSE, 2500
#ASSERT `s 137Z(3) no proceedings may be instituted for an offence under section 137Z` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137Z(3) no proceedings may be instituted for an offence under section 137Z` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 137Z(3) no proceedings may be instituted for an offence under section 137Z` FALSE FALSE EQUALS JUST FALSE

§ `s 137ZA(3): the percentage level`
-- 129 votes out of 1,000 is 12.9 per cent, rounded down to 12
#ASSERT `s 137ZA(3) the percentage of interest of the person in the voting shares` 129 FALSE 1000 0 EQUALS 12
-- a whole number is kept: 150 of 1,000 is 15
#ASSERT `s 137ZA(3) the percentage of interest of the person in the voting shares` 150 FALSE 1000 0 EQUALS 15
-- two classes of shares: the votes of the class concerned are the denominator; 129 of 500 is 25.8, rounded down to 25
#ASSERT `s 137ZA(3) the percentage of interest of the person in the voting shares` 129 TRUE 1000 500 EQUALS 25
-- no votes in the denominator: nought rather than a division by nought
#ASSERT `s 137ZA(3) the percentage of interest of the person in the voting shares` 5 FALSE 0 0 EQUALS 0
#ASSERT `s 137ZA(3) the percentage of interest of the person in the voting shares` 5 TRUE 100 0 EQUALS 0


§ `s 137ZA(1) and (2): the thresholds, the duty and the notice`
-- rising: from below 15 to 15 (reaches), from 14 to 31 (crosses 15 and 30), from 49 to 50 (reaches); falling: from 15 to 14 (below), from 75 to 74
#ASSERT `s 137ZA(1) the percentage of interest reaches, crosses or falls below 15%, 30%, 50% or 75%` 14 15 EQUALS TRUE
#ASSERT `s 137ZA(1) the percentage of interest reaches, crosses or falls below 15%, 30%, 50% or 75%` 14 31 EQUALS TRUE
#ASSERT `s 137ZA(1) the percentage of interest reaches, crosses or falls below 15%, 30%, 50% or 75%` 49 50 EQUALS TRUE
#ASSERT `s 137ZA(1) the percentage of interest reaches, crosses or falls below 15%, 30%, 50% or 75%` 15 14 EQUALS TRUE
#ASSERT `s 137ZA(1) the percentage of interest reaches, crosses or falls below 15%, 30%, 50% or 75%` 75 74 EQUALS TRUE
-- no threshold between the two levels: no event
#ASSERT `s 137ZA(1) the percentage of interest reaches, crosses or falls below 15%, 30%, 50% or 75%` 16 29 EQUALS FALSE
#ASSERT `s 137ZA(1) the percentage of interest reaches, crosses or falls below 15%, 30%, 50% or 75%` 15 15 EQUALS FALSE
#ASSERT `s 137ZA(1) the percentage of interest reaches, crosses or falls below 15%, 30%, 50% or 75%` 76 99 EQUALS FALSE
-- the duty: with a threshold event the person must give written notice; with none, "Where" is not met and the text's no
#ASSERT `s 137ZA(1) the person must give the responsible person written notice of the change in the percentage of interest` TRUE 14 15 EQUALS JUST TRUE
#ASSERT `s 137ZA(1) the person must give the responsible person written notice of the change in the percentage of interest` TRUE 16 29 EQUALS JUST FALSE
#ASSERT `s 137ZA(1) the person must give the responsible person written notice of the change in the percentage of interest` FALSE 14 15 EQUALS NOTHING
-- the last day: aware Monday 2 Nov, 2 business days later is Wednesday 4 Nov
#ASSERT `s 137ZA(1) the last day for the notice` (Date 2 11 2026) (Date 2 11 2026) (LIST) EQUALS Date 4 11 2026
#ASSERT `s 137ZA(1) the notice is given in time` (Date 2 11 2026) (Date 2 11 2026) (Date 4 11 2026) (LIST) EQUALS JUST TRUE
#ASSERT `s 137ZA(1) the notice is given in time` (Date 2 11 2026) (Date 2 11 2026) (Date 5 11 2026) (LIST) EQUALS JUST FALSE
#ASSERT `s 137ZA(2) the notice is in the form and contains the information the Authority prescribes` FALSE TRUE EQUALS NOTHING
#ASSERT `s 137ZA(2) the notice is in the form and contains the information the Authority prescribes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137ZA(2) the notice is in the form and contains the information the Authority prescribes` TRUE FALSE EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 137ZA(1) the person must give written notice within 2 business days` (Individual "the holder") AT 0 WITH
    PARTY Individual "the holder" DOES `s 137ZA give the responsible person written notice` AT 2
-- EXPECT BREACH
#TRACE `s 137ZA(1) the person must give written notice within 2 business days` (Individual "the holder") AT 0 WITH
    (WAITUNTIL 5)

§ `s 137ZB(1) to (3): penalties`
§ `s 137ZB(1): intentional or reckless contravention, or knowingly false information (split site (i), both readings)`
-- intentional contravention of one of the named sections: guilty
#ASSERT `s 137ZB(1) the person is guilty of an offence under subsection (1)` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- knowingly false information in purported compliance: guilty
#ASSERT `s 137ZB(1) the person is guilty of an offence under subsection (1)` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- a contravention that is not intentional or reckless: not covered by subsection (1), which says who is guilty and not who is innocent
#ASSERT `s 137ZB(1) the person is guilty of an offence under subsection (1)` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- false information the person did not know to be false: not covered by subsection (1)
#ASSERT `s 137ZB(1) the person is guilty of an offence under subsection (1)` FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 137ZB(1) the person is guilty of an offence under subsection (1)` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- the penalty: an individual and a corporation
#ASSERT `s 137ZB(1) the penalty on conviction` TRUE FALSE EQUALS JUST (Penalty OF 250000, 24, TRUE, 25000)
#ASSERT `s 137ZB(1) the penalty on conviction` FALSE TRUE EQUALS JUST (Penalty OF 250000, 0, FALSE, 25000)
-- neither: the paragraphs name only those two cases
#ASSERT `s 137ZB(1) the penalty on conviction` FALSE FALSE EQUALS NOTHING

§ `s 137ZB(2): the lesser offence`
-- a contravention that is not intentional or reckless
#ASSERT `s 137ZB(2) the person is guilty of an offence under subsection (2)` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- false or misleading information without the knowledge or recklessness of subsection (1)
#ASSERT `s 137ZB(2) the person is guilty of an offence under subsection (2)` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- an intentional contravention is within subsection (1) and carved out of this one ("in circumstances other than as set out in subsection (1)")
#ASSERT `s 137ZB(2) the person is guilty of an offence under subsection (2)` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- no contravention and no false information: not covered
#ASSERT `s 137ZB(2) the person is guilty of an offence under subsection (2)` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 137ZB(2) the penalty on conviction` EQUALS Penalty OF 25000, 0, FALSE, 2500

§ `s 137ZB(3): the bar on proceedings`
#ASSERT `s 137ZB(3) no proceedings may be instituted for an offence under section 137ZB` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137ZB(3) no proceedings may be instituted for an offence under section 137ZB` FALSE TRUE EQUALS JUST TRUE
-- outside both triggers the bar does not apply (marginal reading (b))
#ASSERT `s 137ZB(3) no proceedings may be instituted for an offence under section 137ZB` FALSE FALSE EQUALS JUST FALSE


