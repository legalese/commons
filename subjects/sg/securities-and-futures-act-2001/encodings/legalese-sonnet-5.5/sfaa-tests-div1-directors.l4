IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfaa-div1-directors`

-- Tests for sfaa-div1-directors.l4 (sections 133 and 134). Every expected value is written from the text, beside the assertion.
-- Dates: 2 November 2026 is a Monday; 6 November 2026 is the public holiday in the examples that have one.


§ `s 133(2): the paragraphs that apply only to a director of a company`
-- the related-corporation paragraphs: a director of a company is within them; a chief executive officer, or a director of a non-company, is the text's no ("only apply")
#ASSERT `s 133(2) the paragraph applies to a director of a corporation which is a company` `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 133(2) the paragraph applies to a director of a corporation which is a company` `s 133(1)(a)(ii) shares in a related corporation of the corporation` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 133(2) the paragraph applies to a director of a corporation which is a company` `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 133(2) the paragraph applies to a director of a corporation which is a company` `s 133(1)(e)(i) participatory interests made available by the corporation` TRUE TRUE EQUALS JUST TRUE
-- paragraph (a)(i) is not one of the limited paragraphs: the subsection says nothing about it
#ASSERT `s 133(2) the paragraph applies to a director of a corporation which is a company` `s 133(1)(a)(i) shares in the corporation` TRUE TRUE EQUALS NOTHING
#ASSERT `s 133(2) the paragraph applies to a director of a corporation which is a company` `s 133(1)(f) other securities or securities-based derivatives contracts the Authority prescribes` FALSE FALSE EQUALS NOTHING
#ASSERT `s 133(2) the person is a director of a company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 133(2) the person is a director of a company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 133(2) the person is a director of a company` FALSE TRUE EQUALS JUST FALSE

§ `s 133(1): who must give written notice of what`
-- a director of a listed company, shares in the corporation, held: the duty
#ASSERT `s 133(1) the director or chief executive officer must give the corporation written notice of the matter` TRUE TRUE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE EQUALS JUST TRUE
-- a chief executive officer, shares in the corporation, held: the duty
#ASSERT `s 133(1) the director or chief executive officer must give the corporation written notice of the matter` TRUE FALSE TRUE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE EQUALS JUST TRUE
-- the body is not a corporation as section 130(2) reads the word: not covered
#ASSERT `s 133(1) the director or chief executive officer must give the corporation written notice of the matter` FALSE TRUE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE EQUALS NOTHING
-- neither a director nor a chief executive officer: "Every director and chief executive officer" says nothing about this person
#ASSERT `s 133(1) the director or chief executive officer must give the corporation written notice of the matter` TRUE FALSE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE EQUALS NOTHING
-- shares in a related corporation: a director of a company is within paragraph (a)(ii); a chief executive officer and a director of a non-company are the text's no
#ASSERT `s 133(1) the director or chief executive officer must give the corporation written notice of the matter` TRUE TRUE FALSE TRUE `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE EQUALS JUST TRUE
#ASSERT `s 133(1) the director or chief executive officer must give the corporation written notice of the matter` TRUE FALSE TRUE TRUE `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE EQUALS JUST FALSE
#ASSERT `s 133(1) the director or chief executive officer must give the corporation written notice of the matter` TRUE TRUE FALSE FALSE `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE EQUALS JUST FALSE
-- nothing held and no change: "particulars of ... which he or she holds, or in which he or she has an interest" is not triggered
#ASSERT `s 133(1) the director or chief executive officer must give the corporation written notice of the matter` TRUE TRUE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` FALSE EQUALS NOTHING

§ `s 133(3)(a): the form and information`
-- the Authority has not prescribed one: the text points outside itself
#ASSERT `s 133(3)(a) the notice is in the form and contains the information the Authority prescribes` FALSE TRUE EQUALS NOTHING
#ASSERT `s 133(3)(a) the notice is in the form and contains the information the Authority prescribes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 133(3)(a) the notice is in the form and contains the information the Authority prescribes` TRUE FALSE EQUALS JUST FALSE

§ `s 133(3)(b): the time (2 business days)`
-- a change: the person became aware on Monday 2 Nov and would have been aware on Friday 30 Oct with reasonable diligence; the earlier day starts the count (s 130(6))
-- 30 Oct + 2 business days = Tuesday 3 Nov (31 Oct and 1 Nov are the weekend)
#ASSERT `s 133(3)(b)(i) the last day for the notice of a change` (Date 2 11 2026) (Date 30 10 2026) (LIST) EQUALS Date 3 11 2026
-- the diligence day is later than the actual day: the actual day starts the count; 2 Nov + 2 business days = Wednesday 4 Nov
#ASSERT `s 133(3)(b)(i) the last day for the notice of a change` (Date 2 11 2026) (Date 3 11 2026) (LIST) EQUALS Date 4 11 2026
-- a public holiday inside the count pushes the last day on: 4 Nov + 2 business days with Fri 6 Nov a holiday = Monday 9 Nov
#ASSERT `s 133(3)(b)(i) the last day for the notice of a change` (Date 4 11 2026) (Date 4 11 2026) (LIST (Date 6 11 2026)) EQUALS Date 9 11 2026
-- any other notice: two business days after whichever of the two events is later ("whichever last occurs")
#ASSERT `s 133(3)(b)(ii) the last day for any other notice` (Date 2 11 2026) (Date 4 11 2026) (LIST) EQUALS Date 6 11 2026
#ASSERT `s 133(3)(b)(ii) the last day for any other notice` (Date 4 11 2026) (Date 2 11 2026) (LIST) EQUALS Date 6 11 2026
#ASSERT `s 133(3)(b)(ii) the last day for any other notice` (Date 4 11 2026) (Date 2 11 2026) (LIST (Date 6 11 2026)) EQUALS Date 9 11 2026
-- in time: a notice of a change given on the last day is in time; the day after is not (the text says "within 2 business days after")
#ASSERT `s 133(3)(b) the notice is given in time` TRUE (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 4 11 2026) (LIST) EQUALS JUST TRUE
#ASSERT `s 133(3)(b) the notice is given in time` TRUE (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 5 11 2026) (LIST) EQUALS JUST FALSE
-- a notice given on the very day the person becomes aware is in time (fork register A3)
#ASSERT `s 133(3)(b) the notice is given in time` TRUE (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (LIST) EQUALS JUST TRUE
-- any other notice: became director on 2 Nov, acquired the interest on 4 Nov: the last day is 6 Nov; given on 6 Nov in time, on 9 Nov late
#ASSERT `s 133(3)(b) the notice is given in time` FALSE (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 4 11 2026) (Date 6 11 2026) (LIST) EQUALS JUST TRUE
#ASSERT `s 133(3)(b) the notice is given in time` FALSE (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 4 11 2026) (Date 9 11 2026) (LIST) EQUALS JUST FALSE
-- the same case with 6 Nov a public holiday: the last day is 9 Nov
#ASSERT `s 133(3)(b) the notice is given in time` FALSE (Date 2 11 2026) (Date 2 11 2026) (Date 2 11 2026) (Date 4 11 2026) (Date 9 11 2026) (LIST (Date 6 11 2026)) EQUALS JUST TRUE

§ `s 133(1) and (3): the rule and its breach path`
-- EXPECT FULFILLED
#TRACE `s 133(1) and (3) the director or chief executive officer must give written notice within 2 business days` (Individual "the director") AT 0 WITH
    PARTY Individual "the director" DOES `s 133 give the corporation written notice` AT 1
-- EXPECT FULFILLED
#TRACE `s 133(1) and (3) the director or chief executive officer must give written notice within 2 business days` (Individual "the director") AT 0 WITH
    PARTY Individual "the director" DOES `s 133 give the corporation written notice` AT 2
-- EXPECT BREACH
#TRACE `s 133(1) and (3) the director or chief executive officer must give written notice within 2 business days` (Individual "the director") AT 0 WITH
    PARTY Individual "the director" DOES `s 133 give the corporation written notice` AT 3
-- EXPECT BREACH
#TRACE `s 133(1) and (3) the director or chief executive officer must give written notice within 2 business days` (Individual "the director") AT 0 WITH
    (WAITUNTIL 5)

§ `s 133(6): "family member"`
-- a spouse, of any age
#ASSERT `s 133(6) "family member" the person is a family member` `a spouse` 45 EQUALS JUST TRUE
-- a child below 21 is a family member; a child of 21 or over is the text's no ("below the age of 21 years", fork register A2: the age limits the children)
#ASSERT `s 133(6) "family member" the person is a family member` `a son` 20 EQUALS JUST TRUE
#ASSERT `s 133(6) "family member" the person is a family member` `a son` 21 EQUALS JUST FALSE
#ASSERT `s 133(6) "family member" the person is a family member` `a stepdaughter` 12 EQUALS JUST TRUE
#ASSERT `s 133(6) "family member" the person is a family member` `an adopted daughter` 30 EQUALS JUST FALSE
-- any other relation is outside the definition ("means a spouse, or a son, ...")
#ASSERT `s 133(6) "family member" the person is a family member` `a mother` 60 EQUALS JUST FALSE
#ASSERT `s 133(6) "family member" the person is a family member` `a brother` 20 EQUALS JUST FALSE
#ASSERT `s 133(6) the child is below the age of 21 years` 20 EQUALS JUST TRUE
#ASSERT `s 133(6) the child is below the age of 21 years` 21 EQUALS JUST FALSE

§ `s 133(4) and (5): deemed interests and meanings`
-- (4)(a): a family member who is not himself or herself a director or chief executive officer, and who holds an interest: the director is deemed to have it
#ASSERT `s 133(4)(a) the director or chief executive officer is deemed to have the family member's interest` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
-- a family member who holds nothing: "if" is not met, so the text's no (marginal reading (a))
#ASSERT `s 133(4)(a) the director or chief executive officer is deemed to have the family member's interest` (JUST TRUE) FALSE FALSE EQUALS JUST FALSE
-- a family member who is himself or herself a director: carved out in the text's own words, so not covered
#ASSERT `s 133(4)(a) the director or chief executive officer is deemed to have the family member's interest` (JUST TRUE) TRUE TRUE EQUALS NOTHING
-- not a family member as section 133(6) defines it: outside the defined term, not covered
#ASSERT `s 133(4)(a) the director or chief executive officer is deemed to have the family member's interest` (JUST FALSE) FALSE TRUE EQUALS NOTHING
-- the caller could not say whether the person is a family member: not covered
#ASSERT `s 133(4)(a) the director or chief executive officer is deemed to have the family member's interest` NOTHING FALSE TRUE EQUALS NOTHING
-- (4)(b): the family member's own contract, assignment, right of subscription or grant
#ASSERT `s 133(4)(b) the family member's contract, assignment, right of subscription or grant is deemed to be the director's or chief executive officer's` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 133(4)(b) the family member's contract, assignment, right of subscription or grant is deemed to be the director's or chief executive officer's` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 133(4)(b) the family member's contract, assignment, right of subscription or grant is deemed to be the director's or chief executive officer's` (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 133(4)(b) the family member's contract, assignment, right of subscription or grant is deemed to be the director's or chief executive officer's` (JUST FALSE) FALSE TRUE EQUALS NOTHING
-- (5)(a): a participatory interest is a unit in a collective investment scheme
#ASSERT `s 133(5)(a) the thing is a participatory interest` TRUE EQUALS JUST TRUE
#ASSERT `s 133(5)(a) the thing is a participatory interest` FALSE EQUALS JUST FALSE
-- (5)(b): "includes" a person holding or acquiring a right under an option; the definition is not closed, so a person without such a right is not covered
#ASSERT `s 133(5)(b) the person who under an option holds or acquires a right is included among those who hold or acquire` TRUE EQUALS JUST TRUE
#ASSERT `s 133(5)(b) the person who under an option holds or acquires a right is included among those who hold or acquire` FALSE EQUALS NOTHING

§ `s 134(1): the matters it names`
#ASSERT `s 134(1) the matter is one that subsection (1) names` `s 133(1)(a)(i) shares in the corporation` EQUALS TRUE
#ASSERT `s 134(1) the matter is one that subsection (1) names` `s 133(1)(f) other securities or securities-based derivatives contracts the Authority prescribes` EQUALS TRUE
#ASSERT `s 134(1) the matter is one that subsection (1) names` `s 133(1)(a)(ii) shares in a related corporation of the corporation` EQUALS FALSE
#ASSERT `s 134(1) the matter is one that subsection (1) names` `s 133(1)(e)(i) participatory interests made available by the corporation` EQUALS FALSE

§ `s 134(1): intentional or reckless contraventions (split site (i), both readings)`
-- a named matter, a contravention of section 133(1), intentional: guilty
#ASSERT `s 134(1)(a) the director or chief executive officer intentionally or recklessly contravened section 133(1)` `s 133(1)(a)(i) shares in the corporation` TRUE TRUE EQUALS JUST TRUE
-- the contravention is not intentional or reckless: the text says who is guilty, not that anyone else is innocent
#ASSERT `s 134(1)(a) the director or chief executive officer intentionally or recklessly contravened section 133(1)` `s 133(1)(a)(i) shares in the corporation` TRUE FALSE EQUALS NOTHING
-- no contravention of section 133(1): not covered
#ASSERT `s 134(1)(a) the director or chief executive officer intentionally or recklessly contravened section 133(1)` `s 133(1)(a)(i) shares in the corporation` FALSE TRUE EQUALS NOTHING
-- a matter subsection (1) does not name (a related corporation's shares): not covered
#ASSERT `s 134(1)(a) the director or chief executive officer intentionally or recklessly contravened section 133(1)` `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE TRUE EQUALS NOTHING
#ASSERT `s 134(1)(b) the director or chief executive officer intentionally or recklessly contravened section 133(3)` `s 133(1)(a)(i) shares in the corporation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 134(1)(b) the director or chief executive officer intentionally or recklessly contravened section 133(3)` `s 133(1)(a)(i) shares in the corporation` TRUE FALSE EQUALS NOTHING
#ASSERT `s 134(1)(b) the director or chief executive officer intentionally or recklessly contravened section 133(3)` `s 133(1)(e)(i) participatory interests made available by the corporation` TRUE TRUE EQUALS NOTHING
#ASSERT `s 134(1)(c) the director or chief executive officer in purported compliance provided information known to be false or misleading` `s 133(1)(a)(i) shares in the corporation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 134(1)(c) the director or chief executive officer in purported compliance provided information known to be false or misleading` `s 133(1)(a)(i) shares in the corporation` TRUE FALSE EQUALS NOTHING
#ASSERT `s 134(1)(c) the director or chief executive officer in purported compliance provided information known to be false or misleading` `s 133(1)(a)(i) shares in the corporation` FALSE TRUE EQUALS NOTHING
#ASSERT `s 134(1)(c) the director or chief executive officer in purported compliance provided information known to be false or misleading` `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE TRUE EQUALS NOTHING
-- the combined offence, any one limb
#ASSERT `s 134(1) the director or chief executive officer is guilty of an offence under subsection (1)` `s 133(1)(a)(i) shares in the corporation` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 134(1) the director or chief executive officer is guilty of an offence under subsection (1)` `s 133(1)(a)(i) shares in the corporation` FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 134(1) the director or chief executive officer is guilty of an offence under subsection (1)` `s 133(1)(a)(i) shares in the corporation` FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 134(1) the director or chief executive officer is guilty of an offence under subsection (1)` `s 133(1)(a)(i) shares in the corporation` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 134(1) the director or chief executive officer is guilty of an offence under subsection (1)` `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 134(1) the penalty on conviction` EQUALS Penalty OF 250000, 24, TRUE, 25000

§ `s 134(2): the lesser offence ("in circumstances other than as set out in subsection (1)")`
-- a contravention that is not intentional or reckless: guilty under subsection (2)
#ASSERT `s 134(2) the director or chief executive officer is guilty of an offence under subsection (2)` `s 133(1)(a)(i) shares in the corporation` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- a contravention of section 133(3) alone: guilty under subsection (2)
#ASSERT `s 134(2) the director or chief executive officer is guilty of an offence under subsection (2)` `s 133(1)(a)(i) shares in the corporation` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- false or misleading information that the person did not know to be false: guilty under subsection (2)
#ASSERT `s 134(2) the director or chief executive officer is guilty of an offence under subsection (2)` `s 133(1)(a)(i) shares in the corporation` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- an intentional contravention of section 133(1) in a named matter falls within subsection (1) and is carved out of this one
#ASSERT `s 134(2) the director or chief executive officer is guilty of an offence under subsection (2)` `s 133(1)(a)(i) shares in the corporation` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
-- no contravention at all: not covered
#ASSERT `s 134(2) the director or chief executive officer is guilty of an offence under subsection (2)` `s 133(1)(a)(i) shares in the corporation` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- a matter outside subsection (1): an intentional contravention is not carved out, because subsection (1) does not reach it
#ASSERT `s 134(2) the director or chief executive officer is guilty of an offence under subsection (2)` `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 134(2) the penalty on conviction` EQUALS Penalty OF 25000, 0, FALSE, 2500

§ `s 134(3): the bar on proceedings`
#ASSERT `s 134(3) no proceedings may be instituted for an offence under section 134` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 134(3) no proceedings may be instituted for an offence under section 134` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 134(3) no proceedings may be instituted for an offence under section 134` TRUE TRUE EQUALS JUST TRUE
-- outside the two triggers the bar does not apply (marginal reading (b): a bar limited by "after")
#ASSERT `s 134(3) no proceedings may be instituted for an offence under section 134` FALSE FALSE EQUALS JUST FALSE
