IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfab-division-1`

-- Tests for sfab-division-1 (Securities and Futures Act 2001, Part 12). Every expected value below is written from the text of the section named above it,
-- by hand, with the inputs that decide it; none is copied from output. Case order: the case that meets the provision, then each input taken away in turn,
-- then the case the text does not decide. A `#S` case is one that takes a branch marked SPLIT-SITE in the module.


-- s 196 this Division applies to the act
#ASSERT `s 196 this Division applies to the act` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 196 this Division applies to the act` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 196 this Division applies to the act` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 196 this Division applies to the act` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 196 this Division applies to the act` (JUST FALSE) (JUST FALSE) EQUALS NOTHING

-- s 196(a) this Division applies to the act occurring within Singapore
#ASSERT `s 196(a) this Division applies to the act occurring within Singapore` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 196(a) this Division applies to the act occurring within Singapore` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 196(a) this Division applies to the act occurring within Singapore` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
