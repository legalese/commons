-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "Code on Collective Investment Schemes" the document is the Code on Collective Investment Schemes` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "means the Code on Collective Investment Schemes referred to in section 284 which is issued by the Authority under section 321(1)"
#ASSERT `s 2(1) "Code on Collective Investment Schemes" the document is the Code on Collective Investment Schemes` FALSE EQUALS JUST FALSE

-- a VCC scheme whose assets are entrusted to the entity
#ASSERT `s 2(1) "custodian" the entity is a custodian of the scheme` TRUE TRUE EQUALS JUST TRUE
-- a VCC scheme, assets not entrusted to this entity: "means"
#ASSERT `s 2(1) "custodian" the entity is a custodian of the scheme` TRUE FALSE EQUALS JUST FALSE
-- a scheme that is not a VCC or sub-fund: outside the scope of the definition, which has no "only"; the text does not say
#ASSERT `s 2(1) "custodian" the entity is a custodian of the scheme` FALSE TRUE EQUALS NOTHING

-- the person is responsible for managing or operating
#ASSERT `s 2(1) "manager" the person is the manager of the collective investment scheme` TRUE EQUALS JUST TRUE
-- the person is not
#ASSERT `s 2(1) "manager" the person is the manager of the collective investment scheme` FALSE EQUALS JUST FALSE

-- Part 2: may participate in the services of an approved exchange
#ASSERT (`s 2(1) "participant" the person is a participant` WITH `the provision being read` IS (`s 2(1) "participant" for Part 2`), `the person may participate in one or more of the services provided by an approved exchange or recognised market operator in that capacity` IS TRUE, `the person may participate in one or more of the services provided by a licensed trade repository or licensed foreign trade repository in that capacity` IS FALSE, `the person may, under the business rules of an approved clearing house or recognised clearing house, participate in one or more of the services it provides in that capacity` IS FALSE, `the person participates in a collective investment scheme by owning one or more units in it` IS FALSE) EQUALS JUST TRUE
-- Part 2: a unit owner who may not use the exchange's services is not a participant for Part 2
#ASSERT (`s 2(1) "participant" the person is a participant` WITH `the provision being read` IS (`s 2(1) "participant" for Part 2`), `the person may participate in one or more of the services provided by an approved exchange or recognised market operator in that capacity` IS FALSE, `the person may participate in one or more of the services provided by a licensed trade repository or licensed foreign trade repository in that capacity` IS FALSE, `the person may, under the business rules of an approved clearing house or recognised clearing house, participate in one or more of the services it provides in that capacity` IS FALSE, `the person participates in a collective investment scheme by owning one or more units in it` IS TRUE) EQUALS JUST FALSE
-- Part 2A: may participate in a licensed trade repository's services
#ASSERT (`s 2(1) "participant" the person is a participant` WITH `the provision being read` IS (`s 2(1) "participant" for Part 2A`), `the person may participate in one or more of the services provided by an approved exchange or recognised market operator in that capacity` IS FALSE, `the person may participate in one or more of the services provided by a licensed trade repository or licensed foreign trade repository in that capacity` IS TRUE, `the person may, under the business rules of an approved clearing house or recognised clearing house, participate in one or more of the services it provides in that capacity` IS FALSE, `the person participates in a collective investment scheme by owning one or more units in it` IS FALSE) EQUALS JUST TRUE
-- Part 2A: no such right
#ASSERT (`s 2(1) "participant" the person is a participant` WITH `the provision being read` IS (`s 2(1) "participant" for Part 2A`), `the person may participate in one or more of the services provided by an approved exchange or recognised market operator in that capacity` IS FALSE, `the person may participate in one or more of the services provided by a licensed trade repository or licensed foreign trade repository in that capacity` IS FALSE, `the person may, under the business rules of an approved clearing house or recognised clearing house, participate in one or more of the services it provides in that capacity` IS FALSE, `the person participates in a collective investment scheme by owning one or more units in it` IS FALSE) EQUALS JUST FALSE
-- Part 3: may participate under the business rules of a clearing house
#ASSERT (`s 2(1) "participant" the person is a participant` WITH `the provision being read` IS (`s 2(1) "participant" for Part 3`), `the person may participate in one or more of the services provided by an approved exchange or recognised market operator in that capacity` IS FALSE, `the person may participate in one or more of the services provided by a licensed trade repository or licensed foreign trade repository in that capacity` IS FALSE, `the person may, under the business rules of an approved clearing house or recognised clearing house, participate in one or more of the services it provides in that capacity` IS TRUE, `the person participates in a collective investment scheme by owning one or more units in it` IS FALSE) EQUALS JUST TRUE
-- Part 3: an exchange participant that is not a clearing house participant
#ASSERT (`s 2(1) "participant" the person is a participant` WITH `the provision being read` IS (`s 2(1) "participant" for Part 3`), `the person may participate in one or more of the services provided by an approved exchange or recognised market operator in that capacity` IS TRUE, `the person may participate in one or more of the services provided by a licensed trade repository or licensed foreign trade repository in that capacity` IS FALSE, `the person may, under the business rules of an approved clearing house or recognised clearing house, participate in one or more of the services it provides in that capacity` IS FALSE, `the person participates in a collective investment scheme by owning one or more units in it` IS FALSE) EQUALS JUST FALSE
-- any other provision: owns one or more units in a collective investment scheme
#ASSERT (`s 2(1) "participant" the person is a participant` WITH `the provision being read` IS (`s 2(1) "participant" for any other provision`), `the person may participate in one or more of the services provided by an approved exchange or recognised market operator in that capacity` IS FALSE, `the person may participate in one or more of the services provided by a licensed trade repository or licensed foreign trade repository in that capacity` IS FALSE, `the person may, under the business rules of an approved clearing house or recognised clearing house, participate in one or more of the services it provides in that capacity` IS FALSE, `the person participates in a collective investment scheme by owning one or more units in it` IS TRUE) EQUALS JUST TRUE
-- any other provision: owns no unit
#ASSERT (`s 2(1) "participant" the person is a participant` WITH `the provision being read` IS (`s 2(1) "participant" for any other provision`), `the person may participate in one or more of the services provided by an approved exchange or recognised market operator in that capacity` IS FALSE, `the person may participate in one or more of the services provided by a licensed trade repository or licensed foreign trade repository in that capacity` IS FALSE, `the person may, under the business rules of an approved clearing house or recognised clearing house, participate in one or more of the services it provides in that capacity` IS TRUE, `the person participates in a collective investment scheme by owning one or more units in it` IS FALSE) EQUALS JUST FALSE

-- (a) a scheme constituted as a VCC or a sub-fund: the VCC
#ASSERT `s 2(1) "responsible person" who is the responsible person of the scheme` (`s 2(1) "responsible person" a VCC or a sub-fund`) EQUALS `s 2(1) "responsible person" the VCC`
-- (b) a scheme constituted as a corporation other than a VCC: the corporation
#ASSERT `s 2(1) "responsible person" who is the responsible person of the scheme` (`s 2(1) "responsible person" a corporation other than a VCC`) EQUALS `s 2(1) "responsible person" the corporation`
-- (c) any other scheme: the manager for the scheme
#ASSERT `s 2(1) "responsible person" who is the responsible person of the scheme` (`s 2(1) "responsible person" some other way`) EQUALS `s 2(1) "responsible person" the manager for the scheme`

-- a listed, authorised trust scheme investing in real estate (a) to (d)
#ASSERT (`s 2(1) "real estate investment trust" the scheme is a real estate investment trust` WITH `the provision being read is in Division 3 of Part 7` IS FALSE, `the scheme is a collective investment scheme` IS TRUE, `the scheme is authorised under section 286 or recognised under section 287` IS TRUE, `the scheme is a trust` IS TRUE, `the scheme invests primarily in real estate and real estate-related assets specified by the Authority in the Code on Collective Investment Schemes` IS TRUE, `all or any of the units of the scheme are listed for quotation on an approved exchange` IS TRUE) EQUALS JUST TRUE
-- (d) missing: unlisted
#ASSERT (`s 2(1) "real estate investment trust" the scheme is a real estate investment trust` WITH `the provision being read is in Division 3 of Part 7` IS FALSE, `the scheme is a collective investment scheme` IS TRUE, `the scheme is authorised under section 286 or recognised under section 287` IS TRUE, `the scheme is a trust` IS TRUE, `the scheme invests primarily in real estate and real estate-related assets specified by the Authority in the Code on Collective Investment Schemes` IS TRUE, `all or any of the units of the scheme are listed for quotation on an approved exchange` IS FALSE) EQUALS JUST FALSE
-- (b) missing: not a trust
#ASSERT (`s 2(1) "real estate investment trust" the scheme is a real estate investment trust` WITH `the provision being read is in Division 3 of Part 7` IS FALSE, `the scheme is a collective investment scheme` IS TRUE, `the scheme is authorised under section 286 or recognised under section 287` IS TRUE, `the scheme is a trust` IS FALSE, `the scheme invests primarily in real estate and real estate-related assets specified by the Authority in the Code on Collective Investment Schemes` IS TRUE, `all or any of the units of the scheme are listed for quotation on an approved exchange` IS TRUE) EQUALS JUST FALSE
-- (a) missing: neither authorised nor recognised
#ASSERT (`s 2(1) "real estate investment trust" the scheme is a real estate investment trust` WITH `the provision being read is in Division 3 of Part 7` IS FALSE, `the scheme is a collective investment scheme` IS TRUE, `the scheme is authorised under section 286 or recognised under section 287` IS FALSE, `the scheme is a trust` IS TRUE, `the scheme invests primarily in real estate and real estate-related assets specified by the Authority in the Code on Collective Investment Schemes` IS TRUE, `all or any of the units of the scheme are listed for quotation on an approved exchange` IS TRUE) EQUALS JUST FALSE
-- (c) missing
#ASSERT (`s 2(1) "real estate investment trust" the scheme is a real estate investment trust` WITH `the provision being read is in Division 3 of Part 7` IS FALSE, `the scheme is a collective investment scheme` IS TRUE, `the scheme is authorised under section 286 or recognised under section 287` IS TRUE, `the scheme is a trust` IS TRUE, `the scheme invests primarily in real estate and real estate-related assets specified by the Authority in the Code on Collective Investment Schemes` IS FALSE, `all or any of the units of the scheme are listed for quotation on an approved exchange` IS TRUE) EQUALS JUST FALSE
-- read for Division 3 of Part 7: this definition does not apply there (the text says "except in Division 3 of Part 7"), so the text gives no answer here
#ASSERT (`s 2(1) "real estate investment trust" the scheme is a real estate investment trust` WITH `the provision being read is in Division 3 of Part 7` IS TRUE, `the scheme is a collective investment scheme` IS TRUE, `the scheme is authorised under section 286 or recognised under section 287` IS TRUE, `the scheme is a trust` IS TRUE, `the scheme invests primarily in real estate and real estate-related assets specified by the Authority in the Code on Collective Investment Schemes` IS TRUE, `all or any of the units of the scheme are listed for quotation on an approved exchange` IS TRUE) EQUALS NOTHING

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "real estate investment trust management" the activity is real estate investment trust management` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given in the Second Schedule"
#ASSERT `s 2(1) "real estate investment trust management" the activity is real estate investment trust management` FALSE EQUALS JUST FALSE

-- (a): a right or interest in a collective investment scheme
#ASSERT `s 2(1) "unit" (a) the right or interest is a unit in a collective investment scheme` TRUE FALSE EQUALS JUST TRUE
-- (a): "includes an option to acquire"
#ASSERT `s 2(1) "unit" (a) the right or interest is a unit in a collective investment scheme` FALSE TRUE EQUALS JUST TRUE
-- (a): neither
#ASSERT `s 2(1) "unit" (a) the right or interest is a unit in a collective investment scheme` FALSE FALSE EQUALS JUST FALSE
-- (b): a unit under the Business Trusts Act 2004
#ASSERT `s 2(1) "unit" (b) the thing is a unit in a business trust` TRUE EQUALS JUST TRUE
-- (b): not one
#ASSERT `s 2(1) "unit" (b) the thing is a unit in a business trust` FALSE EQUALS JUST FALSE

-- (a) a participant
#ASSERT `s 2(1) "unitholder" (a) the person is a unitholder of a collective investment scheme` TRUE EQUALS JUST TRUE
-- (a) not a participant
#ASSERT `s 2(1) "unitholder" (a) the person is a unitholder of a collective investment scheme` FALSE EQUALS JUST FALSE
-- (b) holds a unit
#ASSERT `s 2(1) "unitholder" (b) the person is a unitholder of a business trust` TRUE EQUALS JUST TRUE
-- (b) holds none
#ASSERT `s 2(1) "unitholder" (b) the person is a unitholder of a business trust` FALSE EQUALS JUST FALSE

-- an issued unit with a general right to vote (a vote in some circumstance beyond the six)
#ASSERT `s 2(1) "voting unit" (a) the unit is a voting unit in a business trust` TRUE (LIST `s 2(1) "voting unit" a vote on a proposal that affects rights attached to the unit`, `s 2(1) "voting unit" a vote in any other circumstance`) EQUALS JUST TRUE
-- (i): no circumstances in which a right to vote is attached
#ASSERT `s 2(1) "voting unit" (a) the unit is a voting unit in a business trust` TRUE EMPTY EQUALS JUST FALSE
-- (ii)(A): a right to vote only while a distribution is in arrears
#ASSERT `s 2(1) "voting unit" (a) the unit is a voting unit in a business trust` TRUE (LIST `s 2(1) "voting unit" a vote while a distribution is in arrears`) EQUALS JUST FALSE
-- (ii)(B), (C), (D): only on those proposals
#ASSERT `s 2(1) "voting unit" (a) the unit is a voting unit in a business trust` TRUE (LIST `s 2(1) "voting unit" a vote on a proposal to reduce the unitholders' equity or the participants' funds`, `s 2(1) "voting unit" a vote on a proposal that affects rights attached to the unit`, `s 2(1) "voting unit" a vote on a proposal to wind up the business trust or the scheme`) EQUALS JUST FALSE
-- (ii)(E), (F): only on disposal of everything, and during winding up
#ASSERT `s 2(1) "voting unit" (a) the unit is a voting unit in a business trust` TRUE (LIST `s 2(1) "voting unit" a vote on a proposal to dispose of the whole of the property, business and undertakings`, `s 2(1) "voting unit" a vote during the winding up`) EQUALS JUST FALSE
-- a unit not yet issued is not a voting unit: "means an issued unit"
#ASSERT `s 2(1) "voting unit" (a) the unit is a voting unit in a business trust` FALSE (LIST `s 2(1) "voting unit" a vote in any other circumstance`) EQUALS JUST FALSE
-- an issued unit with a general right to vote (a vote in some circumstance beyond the six)
#ASSERT `s 2(1) "voting unit" (b) the unit is a voting unit in a collective investment scheme` TRUE (LIST `s 2(1) "voting unit" a vote on a proposal that affects rights attached to the unit`, `s 2(1) "voting unit" a vote in any other circumstance`) EQUALS JUST TRUE
-- (i): no circumstances in which a right to vote is attached
#ASSERT `s 2(1) "voting unit" (b) the unit is a voting unit in a collective investment scheme` TRUE EMPTY EQUALS JUST FALSE
-- (ii)(A): a right to vote only while a distribution is in arrears
#ASSERT `s 2(1) "voting unit" (b) the unit is a voting unit in a collective investment scheme` TRUE (LIST `s 2(1) "voting unit" a vote while a distribution is in arrears`) EQUALS JUST FALSE

-- exactly 5%: "not less than 5%"
#ASSERT (`s 2(1) "substantial unitholder" (a) the participant is a substantial unitholder of a collective investment scheme` WITH `the person is a participant in the scheme` IS TRUE, `the person has an interest in one or more voting units in the scheme` IS TRUE, `the total votes attached to the voting units the person has an interest in` IS 5, `the total votes attached to all the voting units in the scheme` IS 100) EQUALS JUST TRUE
-- 4%: below 5%
#ASSERT (`s 2(1) "substantial unitholder" (a) the participant is a substantial unitholder of a collective investment scheme` WITH `the person is a participant in the scheme` IS TRUE, `the person has an interest in one or more voting units in the scheme` IS TRUE, `the total votes attached to the voting units the person has an interest in` IS 4, `the total votes attached to all the voting units in the scheme` IS 100) EQUALS JUST FALSE
-- not a participant
#ASSERT (`s 2(1) "substantial unitholder" (a) the participant is a substantial unitholder of a collective investment scheme` WITH `the person is a participant in the scheme` IS FALSE, `the person has an interest in one or more voting units in the scheme` IS TRUE, `the total votes attached to the voting units the person has an interest in` IS 50, `the total votes attached to all the voting units in the scheme` IS 100) EQUALS JUST FALSE
-- no interest in a voting unit
#ASSERT (`s 2(1) "substantial unitholder" (a) the participant is a substantial unitholder of a collective investment scheme` WITH `the person is a participant in the scheme` IS TRUE, `the person has an interest in one or more voting units in the scheme` IS FALSE, `the total votes attached to the voting units the person has an interest in` IS 50, `the total votes attached to all the voting units in the scheme` IS 100) EQUALS JUST FALSE
-- exactly 5%
#ASSERT `s 2(1) "substantial unitholder" (b) the person is a substantial unitholder of a business trust` TRUE 5 100 EQUALS JUST TRUE
-- 4.99%
#ASSERT `s 2(1) "substantial unitholder" (b) the person is a substantial unitholder of a business trust` TRUE 499 10000 EQUALS JUST FALSE
-- no interest in a voting unit
#ASSERT `s 2(1) "substantial unitholder" (b) the person is a substantial unitholder of a business trust` FALSE 50 100 EQUALS JUST FALSE

