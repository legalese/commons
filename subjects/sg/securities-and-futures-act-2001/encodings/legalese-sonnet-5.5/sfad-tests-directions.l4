-- MODULES sfad-directions
IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-periods`
IMPORT `sfad-directions`

-- Tests for sfad-directions.l4 (Securities and Futures Act 2001, s 282AA).
-- Every expected value is written from the text, beside the assertion; none is copied from the module's output.
-- Inputs are positional, in the order of the GIVEN of the function under test.

§ `s 282AA(1): the three paragraphs and the power`

-- (a): arguments: the direction is to a person making an offer of securities; the offer is made in or accompanied by a prospectus or profile statement; the offer is an offer referred to in section 280; the direction is on matters in connection with the offer
#ASSERT (`s 282AA(1)(a) the direction is to a person making an offer of securities, on matters in connection with the offer` TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 282AA(1)(a) the direction is to a person making an offer of securities, on matters in connection with the offer` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 282AA(1)(a) the direction is to a person making an offer of securities, on matters in connection with the offer` TRUE FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 282AA(1)(a) the direction is to a person making an offer of securities, on matters in connection with the offer` FALSE TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 282AA(1)(a) the direction is to a person making an offer of securities, on matters in connection with the offer` TRUE TRUE FALSE FALSE) EQUALS NOTHING
-- (b): arguments: the person is one referred to in paragraph (a); the person is a borrowing entity; the matters concern Subdivision (3)
#ASSERT (`s 282AA(1)(b) the direction is to a borrowing entity, on matters in connection with the requirements and obligations of Subdivision (3)` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 282AA(1)(b) the direction is to a borrowing entity, on matters in connection with the requirements and obligations of Subdivision (3)` FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 282AA(1)(b) the direction is to a borrowing entity, on matters in connection with the requirements and obligations of Subdivision (3)` TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 282AA(1)(b) the direction is to a borrowing entity, on matters in connection with the requirements and obligations of Subdivision (3)` TRUE TRUE FALSE) EQUALS NOTHING
-- (c): the direction is to a trustee appointed under section 265A(1)
#ASSERT (`s 282AA(1)(c) the direction is to a trustee appointed under section 265A(1)` TRUE) EQUALS JUST TRUE
#ASSERT (`s 282AA(1)(c) the direction is to a trustee appointed under section 265A(1)` FALSE) EQUALS NOTHING
-- (1): arguments: the Authority thinks it necessary or expedient; by written notice; the answers of (a), (b) and (c)
-- (split site (ii): JUST FALSE where the Authority holds no such view, by the S1b ruling (2026S1bC); the other reading answers NOTHING)
#ASSERT (`s 282AA(1) the Authority may issue the direction` TRUE TRUE (JUST TRUE) NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 282AA(1) the Authority may issue the direction` TRUE TRUE NOTHING (JUST TRUE) NOTHING) EQUALS JUST TRUE
#ASSERT (`s 282AA(1) the Authority may issue the direction` TRUE TRUE NOTHING NOTHING (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 282AA(1) the Authority may issue the direction` FALSE TRUE (JUST TRUE) NOTHING NOTHING) EQUALS JUST FALSE
#ASSERT (`s 282AA(1) the Authority may issue the direction` TRUE FALSE (JUST TRUE) NOTHING NOTHING) EQUALS JUST FALSE
#ASSERT (`s 282AA(1) the Authority may issue the direction` TRUE TRUE NOTHING NOTHING NOTHING) EQUALS NOTHING

§ `s 282AA(2) to (5)`

-- (2): a notice is given to the person under subsection (1)
#ASSERT (`s 282AA(2) the person given the notice must comply with every direction contained in it` TRUE) EQUALS JUST TRUE
#ASSERT (`s 282AA(2) the person given the notice must comply with every direction contained in it` FALSE) EQUALS JUST FALSE
-- the duty of (2) as a rule: no time limit, so no trace reaches BREACH
-- EXPECT FULFILLED
#TRACE `s 282AA(2) the duty to comply with every direction contained in the notice` AT 0 WITH
    PARTY `s 282AA a person given a notice` DOES `s 282AA(2) comply with every direction contained in the notice` AT 5
-- EXPECT RESIDUAL
#TRACE `s 282AA(2) the duty to comply with every direction contained in the notice` AT 0 WITH
    (WAITUNTIL 400)
#ASSERT (`s 282AA(3) the direction need not be published in the Gazette` TRUE) EQUALS JUST TRUE
#ASSERT (`s 282AA(3) the direction need not be published in the Gazette` FALSE) EQUALS NOTHING
#ASSERT (`s 282AA(4) the person is guilty of an offence` TRUE) EQUALS JUST TRUE
#ASSERT (`s 282AA(4) the person is guilty of an offence` FALSE) EQUALS JUST FALSE
#ASSERT (`s 282AA(4) the penalty for the offence`) EQUALS (Penalty OF 50000, 0, FALSE, 5000)
-- (5): arguments: a trustee under section 265A(1) or a person acting for one; the thing was done in connection with compliance with a direction; with reasonable care; in good faith
#ASSERT (`s 282AA(5) the person incurs no criminal or civil liability for the thing done or omitted` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 282AA(5) the person incurs no criminal or civil liability for the thing done or omitted` FALSE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 282AA(5) the person incurs no criminal or civil liability for the thing done or omitted` TRUE FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 282AA(5) the person incurs no criminal or civil liability for the thing done or omitted` TRUE TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 282AA(5) the person incurs no criminal or civil liability for the thing done or omitted` TRUE TRUE TRUE FALSE) EQUALS NOTHING
