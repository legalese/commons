#ASSERT `s 4A(1)(a)(i)(B) the asset is a financial asset` FALSE FALSE TRUE EQUALS JUST TRUE
-- none of (BA) to (BC)
#ASSERT `s 4A(1)(a)(i)(B) the asset is a financial asset` FALSE FALSE FALSE EQUALS JUST FALSE

