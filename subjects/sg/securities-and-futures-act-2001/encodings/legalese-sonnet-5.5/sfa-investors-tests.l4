-- the trustee of a prescribed trust, acting in that capacity
#ASSERT `s 4A(1)(a)(iii) the person is the trustee of a prescribed trust, when acting in that capacity` TRUE TRUE EQUALS JUST TRUE
-- not acting in that capacity
#ASSERT `s 4A(1)(a)(iii) the person is the trustee of a prescribed trust, when acting in that capacity` TRUE FALSE EQUALS JUST FALSE
-- not the trustee of a prescribed trust
#ASSERT `s 4A(1)(a)(iii) the person is the trustee of a prescribed trust, when acting in that capacity` FALSE TRUE EQUALS JUST FALSE

-- prescribed
#ASSERT `s 4A(1)(a)(iv) the person is a person the Authority has prescribed as an accredited investor` TRUE EQUALS JUST TRUE
-- not prescribed
#ASSERT `s 4A(1)(a)(iv) the person is a person the Authority has prescribed as an accredited investor` FALSE EQUALS JUST FALSE

-- (i): a business of acquiring and disposing of, or holding, capital markets products
#ASSERT (`s 4A(1)(b) the person is an expert investor` WITH `the person's business involves the acquisition and disposal, or the holding, of capital markets products, whether as principal or agent` IS TRUE, `the person is the trustee of a trust the Authority has prescribed for this purpose` IS FALSE, `the person is acting in that capacity` IS FALSE, `the Authority has prescribed the person as an expert investor` IS FALSE) EQUALS JUST TRUE
-- (ii): the trustee of a prescribed trust, acting in that capacity
#ASSERT (`s 4A(1)(b) the person is an expert investor` WITH `the person's business involves the acquisition and disposal, or the holding, of capital markets products, whether as principal or agent` IS FALSE, `the person is the trustee of a trust the Authority has prescribed for this purpose` IS TRUE, `the person is acting in that capacity` IS TRUE, `the Authority has prescribed the person as an expert investor` IS FALSE) EQUALS JUST TRUE
