IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-periods`
IMPORT `sfa-investors`

-- Tests for sfa-investors.
-- Expected values are written from the text of the Act (the quote lines in the module under test), never from its output.

-- asked about accredited investors: the accredited answer
#ASSERT (`s 4A(1) the person is in the class of investor` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `the Authority has prescribed a modification of the definitions for the provision` IS FALSE, `the class of investor asked about` IS (`an accredited investor`), `the person is an accredited investor` IS (JUST TRUE), `the person is an expert investor` IS (JUST FALSE), `the person is an institutional investor` IS (JUST FALSE)) EQUALS JUST TRUE
-- asked about expert investors: the expert answer, whatever the accredited answer is
#ASSERT (`s 4A(1) the person is in the class of investor` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `the Authority has prescribed a modification of the definitions for the provision` IS FALSE, `the class of investor asked about` IS (`an expert investor`), `the person is an accredited investor` IS (JUST TRUE), `the person is an expert investor` IS (JUST FALSE), `the person is an institutional investor` IS (JUST FALSE)) EQUALS JUST FALSE
-- asked about institutional investors
#ASSERT (`s 4A(1) the person is in the class of investor` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `the Authority has prescribed a modification of the definitions for the provision` IS FALSE, `the class of investor asked about` IS (`an institutional investor`), `the person is an accredited investor` IS (JUST FALSE), `the person is an expert investor` IS (JUST FALSE), `the person is an institutional investor` IS (JUST TRUE)) EQUALS JUST TRUE
-- an unanswered class stays NOTHING
#ASSERT (`s 4A(1) the person is in the class of investor` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `the Authority has prescribed a modification of the definitions for the provision` IS FALSE, `the class of investor asked about` IS (`an accredited investor`), `the person is an accredited investor` IS NOTHING, `the person is an expert investor` IS (JUST FALSE), `the person is an institutional investor` IS (JUST FALSE)) EQUALS NOTHING
-- a person in two classes (accredited and expert) is in a class
#ASSERT (`s 4A(1) the person is in the class of investor` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `the Authority has prescribed a modification of the definitions for the provision` IS FALSE, `the class of investor asked about` IS (`none of the classes in section 4A(1)`), `the person is an accredited investor` IS (JUST TRUE), `the person is an expert investor` IS (JUST TRUE), `the person is an institutional investor` IS (JUST FALSE)) EQUALS JUST FALSE
-- none of the three
#ASSERT (`s 4A(1) the person is in the class of investor` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `the Authority has prescribed a modification of the definitions for the provision` IS FALSE, `the class of investor asked about` IS (`none of the classes in section 4A(1)`), `the person is an accredited investor` IS (JUST FALSE), `the person is an expert investor` IS (JUST FALSE), `the person is an institutional investor` IS (JUST FALSE)) EQUALS JUST TRUE
-- one class not answered
#ASSERT (`s 4A(1) the person is in the class of investor` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `the Authority has prescribed a modification of the definitions for the provision` IS FALSE, `the class of investor asked about` IS (`none of the classes in section 4A(1)`), `the person is an accredited investor` IS (JUST FALSE), `the person is an expert investor` IS NOTHING, `the person is an institutional investor` IS (JUST FALSE)) EQUALS NOTHING
-- "unless the context otherwise requires"
#ASSERT (`s 4A(1) the person is in the class of investor` WITH `the context of the provision otherwise requires a different meaning` IS TRUE, `the Authority has prescribed a modification of the definitions for the provision` IS FALSE, `the class of investor asked about` IS (`an accredited investor`), `the person is an accredited investor` IS (JUST TRUE), `the person is an expert investor` IS (JUST FALSE), `the person is an institutional investor` IS (JUST FALSE)) EQUALS NOTHING
-- "Subject to subsection (2)": the Authority has modified the definition for the provision
#ASSERT (`s 4A(1) the person is in the class of investor` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `the Authority has prescribed a modification of the definitions for the provision` IS TRUE, `the class of investor asked about` IS (`an accredited investor`), `the person is an accredited investor` IS (JUST TRUE), `the person is an expert investor` IS (JUST FALSE), `the person is an institutional investor` IS (JUST FALSE)) EQUALS NOTHING

-- an accredited investor under limb iA
#ASSERT (`s 4A(1)(a) the person is an accredited investor` WITH `the person is within paragraph (iA)` IS (JUST TRUE), `the person is within paragraph (iB)` IS (JUST FALSE), `the person is within paragraph (iC)` IS (JUST FALSE), `the person is within paragraph (ii)` IS (JUST FALSE), `the person is within paragraph (iii)` IS (JUST FALSE), `the person is within paragraph (iv)` IS (JUST FALSE)) EQUALS JUST TRUE
-- an accredited investor under limb iB
#ASSERT (`s 4A(1)(a) the person is an accredited investor` WITH `the person is within paragraph (iA)` IS (JUST FALSE), `the person is within paragraph (iB)` IS (JUST TRUE), `the person is within paragraph (iC)` IS (JUST FALSE), `the person is within paragraph (ii)` IS (JUST FALSE), `the person is within paragraph (iii)` IS (JUST FALSE), `the person is within paragraph (iv)` IS (JUST FALSE)) EQUALS JUST TRUE
-- an accredited investor under limb iC
#ASSERT (`s 4A(1)(a) the person is an accredited investor` WITH `the person is within paragraph (iA)` IS (JUST FALSE), `the person is within paragraph (iB)` IS (JUST FALSE), `the person is within paragraph (iC)` IS (JUST TRUE), `the person is within paragraph (ii)` IS (JUST FALSE), `the person is within paragraph (iii)` IS (JUST FALSE), `the person is within paragraph (iv)` IS (JUST FALSE)) EQUALS JUST TRUE
-- an accredited investor under limb ii
#ASSERT (`s 4A(1)(a) the person is an accredited investor` WITH `the person is within paragraph (iA)` IS (JUST FALSE), `the person is within paragraph (iB)` IS (JUST FALSE), `the person is within paragraph (iC)` IS (JUST FALSE), `the person is within paragraph (ii)` IS (JUST TRUE), `the person is within paragraph (iii)` IS (JUST FALSE), `the person is within paragraph (iv)` IS (JUST FALSE)) EQUALS JUST TRUE
-- an accredited investor under limb iii
#ASSERT (`s 4A(1)(a) the person is an accredited investor` WITH `the person is within paragraph (iA)` IS (JUST FALSE), `the person is within paragraph (iB)` IS (JUST FALSE), `the person is within paragraph (iC)` IS (JUST FALSE), `the person is within paragraph (ii)` IS (JUST FALSE), `the person is within paragraph (iii)` IS (JUST TRUE), `the person is within paragraph (iv)` IS (JUST FALSE)) EQUALS JUST TRUE
-- an accredited investor under limb iv
#ASSERT (`s 4A(1)(a) the person is an accredited investor` WITH `the person is within paragraph (iA)` IS (JUST FALSE), `the person is within paragraph (iB)` IS (JUST FALSE), `the person is within paragraph (iC)` IS (JUST FALSE), `the person is within paragraph (ii)` IS (JUST FALSE), `the person is within paragraph (iii)` IS (JUST FALSE), `the person is within paragraph (iv)` IS (JUST TRUE)) EQUALS JUST TRUE
-- no limb: "means" closes the list
#ASSERT (`s 4A(1)(a) the person is an accredited investor` WITH `the person is within paragraph (iA)` IS (JUST FALSE), `the person is within paragraph (iB)` IS (JUST FALSE), `the person is within paragraph (iC)` IS (JUST FALSE), `the person is within paragraph (ii)` IS (JUST FALSE), `the person is within paragraph (iii)` IS (JUST FALSE), `the person is within paragraph (iv)` IS (JUST FALSE)) EQUALS JUST FALSE
-- a limb not answered: NOTHING, never FALSE
#ASSERT (`s 4A(1)(a) the person is an accredited investor` WITH `the person is within paragraph (iA)` IS NOTHING, `the person is within paragraph (iB)` IS (JUST FALSE), `the person is within paragraph (iC)` IS (JUST FALSE), `the person is within paragraph (ii)` IS (JUST FALSE), `the person is within paragraph (iii)` IS (JUST FALSE), `the person is within paragraph (iv)` IS (JUST FALSE)) EQUALS NOTHING
-- one limb met and another not answered
#ASSERT (`s 4A(1)(a) the person is an accredited investor` WITH `the person is within paragraph (iA)` IS NOTHING, `the person is within paragraph (iB)` IS (JUST FALSE), `the person is within paragraph (iC)` IS (JUST FALSE), `the person is within paragraph (ii)` IS (JUST FALSE), `the person is within paragraph (iii)` IS (JUST TRUE), `the person is within paragraph (iv)` IS (JUST FALSE)) EQUALS JUST TRUE

-- just over $2 million: "exceed"
#ASSERT (`s 4A(1)(a)(i)(A) the individual's net personal assets exceed the amount` WITH `the person is an individual` IS TRUE, `the value of the individual's net personal assets other than the primary residence` IS 2000001, `the estimated fair market value of the primary residence` IS 0, `the outstanding amounts in respect of credit facilities secured by the residence` IS 0, `the Authority has prescribed another amount in place of the first amount` IS FALSE, `the other amount the Authority has prescribed, in Singapore dollars` IS 0) EQUALS JUST TRUE
-- exactly $2 million does not exceed it
#ASSERT (`s 4A(1)(a)(i)(A) the individual's net personal assets exceed the amount` WITH `the person is an individual` IS TRUE, `the value of the individual's net personal assets other than the primary residence` IS 2000000, `the estimated fair market value of the primary residence` IS 0, `the outstanding amounts in respect of credit facilities secured by the residence` IS 0, `the Authority has prescribed another amount in place of the first amount` IS FALSE, `the other amount the Authority has prescribed, in Singapore dollars` IS 0) EQUALS JUST FALSE
-- just under
#ASSERT (`s 4A(1)(a)(i)(A) the individual's net personal assets exceed the amount` WITH `the person is an individual` IS TRUE, `the value of the individual's net personal assets other than the primary residence` IS 1999999, `the estimated fair market value of the primary residence` IS 0, `the outstanding amounts in respect of credit facilities secured by the residence` IS 0, `the Authority has prescribed another amount in place of the first amount` IS FALSE, `the other amount the Authority has prescribed, in Singapore dollars` IS 0) EQUALS JUST FALSE
-- a residence worth $3 million counts for $1 million: 1.5 + 1 = 2.5 million
#ASSERT (`s 4A(1)(a)(i)(A) the individual's net personal assets exceed the amount` WITH `the person is an individual` IS TRUE, `the value of the individual's net personal assets other than the primary residence` IS 1500000, `the estimated fair market value of the primary residence` IS 3000000, `the outstanding amounts in respect of credit facilities secured by the residence` IS 0, `the Authority has prescribed another amount in place of the first amount` IS FALSE, `the other amount the Authority has prescribed, in Singapore dollars` IS 0) EQUALS JUST TRUE
-- 1 + 1 (capped) = exactly 2 million: does not exceed
#ASSERT (`s 4A(1)(a)(i)(A) the individual's net personal assets exceed the amount` WITH `the person is an individual` IS TRUE, `the value of the individual's net personal assets other than the primary residence` IS 1000000, `the estimated fair market value of the primary residence` IS 3000000, `the outstanding amounts in respect of credit facilities secured by the residence` IS 0, `the Authority has prescribed another amount in place of the first amount` IS FALSE, `the other amount the Authority has prescribed, in Singapore dollars` IS 0) EQUALS JUST FALSE
-- residence net of a secured loan counts for $0.5 million: 1.6 + 0.5 = 2.1 million
#ASSERT (`s 4A(1)(a)(i)(A) the individual's net personal assets exceed the amount` WITH `the person is an individual` IS TRUE, `the value of the individual's net personal assets other than the primary residence` IS 1600000, `the estimated fair market value of the primary residence` IS 3000000, `the outstanding amounts in respect of credit facilities secured by the residence` IS 2500000, `the Authority has prescribed another amount in place of the first amount` IS FALSE, `the other amount the Authority has prescribed, in Singapore dollars` IS 0) EQUALS JUST TRUE
-- the residence counts negatively (the text does not floor it): 2.4 - 0.5 = 1.9 million
#ASSERT (`s 4A(1)(a)(i)(A) the individual's net personal assets exceed the amount` WITH `the person is an individual` IS TRUE, `the value of the individual's net personal assets other than the primary residence` IS 2400000, `the estimated fair market value of the primary residence` IS 1000000, `the outstanding amounts in respect of credit facilities secured by the residence` IS 1500000, `the Authority has prescribed another amount in place of the first amount` IS FALSE, `the other amount the Authority has prescribed, in Singapore dollars` IS 0) EQUALS JUST FALSE
