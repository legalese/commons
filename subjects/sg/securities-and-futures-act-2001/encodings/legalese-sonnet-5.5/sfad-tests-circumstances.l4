-- MODULES sfad-circumstances
IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-periods`
IMPORT `sfad-nocons-small-private`
IMPORT `sfad-circumstances`

-- Tests for sfad-circumstances.l4 (Securities and Futures Act 2001, s 273).
-- Every expected value is written from the text, beside the assertion; none is copied from the module's output.
-- Inputs are positional, in the order of the GIVEN of the function under test.

§ `s 273(9), (10): unlisted corporation, corporation that is not a company`

-- (9) a corporation that (a) is not a company AND (b) has no shares or debentures, or units of them, listed on an approved exchange
-- arguments: the corporation is a company; its shares or debentures are listed
#ASSERT (`s 273(9) the corporation is an unlisted corporation` FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(9) the corporation is an unlisted corporation` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(9) the corporation is an unlisted corporation` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(10) the corporation is a corporation for paragraphs (ca) and (cb)` FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(10) the corporation is a corporation for paragraphs (ca) and (cb)` TRUE) EQUALS JUST FALSE

§ `s 273(1)(a) to (cc)`

#ASSERT (`s 273(1)(a) the offer is made in connection with a take-over offer in compliance with the Take-over Code` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(a) the offer is made in connection with a take-over offer in compliance with the Take-over Code` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(a) the offer is made in connection with a take-over offer in compliance with the Take-over Code` TRUE FALSE) EQUALS JUST FALSE
-- (b): arguments: an acquisition offer for shares of an unlisted corporation; (i) to all members; (ii) the person already holds shares and the offer is to all other members; in compliance with the foreign take-over laws
#ASSERT (`s 273(1)(b) the offer is made in connection with an acquisition offer for the shares of an unlisted corporation` TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(b) the offer is made in connection with an acquisition offer for the shares of an unlisted corporation` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(b) the offer is made in connection with an acquisition offer for the shares of an unlisted corporation` TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(b) the offer is made in connection with an acquisition offer for the shares of an unlisted corporation` TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(b) the offer is made in connection with an acquisition offer for the shares of an unlisted corporation` FALSE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(c) the offer is made in connection with a compromise or arrangement of an unlisted corporation` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(c) the offer is made in connection with a compromise or arrangement of an unlisted corporation` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(c) the offer is made in connection with a compromise or arrangement of an unlisted corporation` FALSE TRUE) EQUALS JUST FALSE
-- (ca): the Take-over Code applied as though applicable
#ASSERT (`s 273(1)(ca) the offer is made in connection with an acquisition offer for the shares of a corporation that complies with the Take-over Code` TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(ca) the offer is made in connection with an acquisition offer for the shares of a corporation that complies with the Take-over Code` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(ca) the offer is made in connection with an acquisition offer for the shares of a corporation that complies with the Take-over Code` TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(ca) the offer is made in connection with an acquisition offer for the shares of a corporation that complies with the Take-over Code` TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cb) the offer is made in connection with a compromise or arrangement of a corporation that complies with the Take-over Code` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(cb) the offer is made in connection with a compromise or arrangement of a corporation that complies with the Take-over Code` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cc) the offer is an offer to enter into an underwriting agreement` TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(cc) the offer is an offer to enter into an underwriting agreement` FALSE) EQUALS JUST FALSE

§ `s 273(1AA), (1AB), (1AC) and (1)(cd) to (cm)`

#ASSERT (`s 273(1AA) the securities of the entity are treated as listed for quotation on the approved exchange` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(1AA) the securities of the entity are treated as listed for quotation on the approved exchange` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1AA) the securities of the entity are treated as listed for quotation on the approved exchange` FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 273(1AB) the shares of the entity are treated as listed for quotation on the approved exchange` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(1AB) the shares of the entity are treated as listed for quotation on the approved exchange` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1AB) the shares of the entity are treated as listed for quotation on the approved exchange` FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 273(1AC) the units in the business trust are treated as listed for quotation on the approved exchange` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(1AC) the units in the business trust are treated as listed for quotation on the approved exchange` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1AC) the units in the business trust are treated as listed for quotation on the approved exchange` FALSE FALSE) EQUALS NOTHING
-- (cd): arguments: an offer of securities or contracts of an entity; the securities are listed (counting SDRs); the entity is not formed in Singapore; the listing is a primary listing; offered to existing members or debenture holders; offered to existing SDR holders
-- (i) the entity's securities are not listed, wherever it is formed
#ASSERT (`s 273(1)(cd) the offer is an offer of securities of an unlisted entity, or a non-primary listing, to existing members, debenture holders or SDR holders` TRUE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
-- (ii) an entity not formed in Singapore, listed on a non-primary listing
#ASSERT (`s 273(1)(cd) the offer is an offer of securities of an unlisted entity, or a non-primary listing, to existing members, debenture holders or SDR holders` TRUE TRUE TRUE FALSE TRUE FALSE) EQUALS JUST TRUE
-- a primary listing is not within (ii)
#ASSERT (`s 273(1)(cd) the offer is an offer of securities of an unlisted entity, or a non-primary listing, to existing members, debenture holders or SDR holders` TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
-- listed, and formed in Singapore: neither (i) nor (ii)
#ASSERT (`s 273(1)(cd) the offer is an offer of securities of an unlisted entity, or a non-primary listing, to existing members, debenture holders or SDR holders` TRUE TRUE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE
-- (iv) existing SDR holders
#ASSERT (`s 273(1)(cd) the offer is an offer of securities of an unlisted entity, or a non-primary listing, to existing members, debenture holders or SDR holders` TRUE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(cd) the offer is an offer of securities of an unlisted entity, or a non-primary listing, to existing members, debenture holders or SDR holders` TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cd) the offer is an offer of securities of an unlisted entity, or a non-primary listing, to existing members, debenture holders or SDR holders` FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE
-- (cda): arguments: an offer of SDRs, then the same five
#ASSERT (`s 273(1)(cda) the offer is an offer of SDRs whose underlying securities are of an unlisted entity, or a non-primary listing, made to existing members, debenture holders or SDR holders` TRUE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(cda) the offer is an offer of SDRs whose underlying securities are of an unlisted entity, or a non-primary listing, made to existing members, debenture holders or SDR holders` TRUE TRUE TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(cda) the offer is an offer of SDRs whose underlying securities are of an unlisted entity, or a non-primary listing, made to existing members, debenture holders or SDR holders` TRUE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cda) the offer is an offer of SDRs whose underlying securities are of an unlisted entity, or a non-primary listing, made to existing members, debenture holders or SDR holders` FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(ce) the offer of shares or debentures is made to existing holders where the shares are listed` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(ce) the offer of shares or debentures is made to existing holders where the shares are listed` FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(ce) the offer of shares or debentures is made to existing holders where the shares are listed` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(ce) the offer of shares or debentures is made to existing holders where the shares are listed` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cf) the offer of debentures is made to an existing holder of listed debentures` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(cf) the offer of debentures is made to an existing holder of listed debentures` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cf) the offer of debentures is made to an existing holder of listed debentures` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cg) the offer of units of shares or debentures is made to existing holders where the shares are listed and the units may only be exercised by them` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(cg) the offer of units of shares or debentures is made to existing holders where the shares are listed and the units may only be exercised by them` TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cg) the offer of units of shares or debentures is made to existing holders where the shares are listed and the units may only be exercised by them` TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cg) the offer of units of shares or debentures is made to existing holders where the shares are listed and the units may only be exercised by them` TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(ch) the offer of units of debentures is made to an existing holder of listed debentures and the units may only be exercised by holders` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(ch) the offer of units of debentures is made to an existing holder of listed debentures and the units may only be exercised by holders` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(ci) the offer is made in the circumstances specified under section 178 of the Insolvency, Restructuring and Dissolution Act 2018` TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(ci) the offer is made in the circumstances specified under section 178 of the Insolvency, Restructuring and Dissolution Act 2018` FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cj) the offer of units in a listed business trust is made to existing holders` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(cj) the offer of units in a listed business trust is made to existing holders` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cj) the offer of units in a listed business trust is made to existing holders` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(ck) the offer of derivatives of units in a listed business trust is made to existing holders who alone may exercise them` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(ck) the offer of derivatives of units in a listed business trust is made to existing holders who alone may exercise them` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(ck) the offer of derivatives of units in a listed business trust is made to existing holders who alone may exercise them` FALSE TRUE TRUE) EQUALS JUST FALSE
-- (cl): arguments: an offer of units or derivatives; listed (counting SDRs); the trust is not registered in Singapore; primary listing; offered to existing holders
#ASSERT (`s 273(1)(cl) the offer of units or derivatives of units is made to existing holders of an unlisted business trust, or a non-primary listing` TRUE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(cl) the offer of units or derivatives of units is made to existing holders of an unlisted business trust, or a non-primary listing` TRUE TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(cl) the offer of units or derivatives of units is made to existing holders of an unlisted business trust, or a non-primary listing` TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cl) the offer of units or derivatives of units is made to existing holders of an unlisted business trust, or a non-primary listing` TRUE TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cl) the offer of units or derivatives of units is made to existing holders of an unlisted business trust, or a non-primary listing` TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cm) the offer of SDRs with units in a business trust is made to existing holders of an unlisted business trust, or a non-primary listing` TRUE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(cm) the offer of SDRs with units in a business trust is made to existing holders of an unlisted business trust, or a non-primary listing` TRUE TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(cm) the offer of SDRs with units in a business trust is made to existing holders of an unlisted business trust, or a non-primary listing` TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(cm) the offer of SDRs with units in a business trust is made to existing holders of an unlisted business trust, or a non-primary listing` FALSE FALSE FALSE FALSE TRUE) EQUALS JUST FALSE

§ `s 273(1A), (1AAA), (1B), (2), (4)`

-- (1A): arguments: borrowed solely to facilitate the offer from a listed lender; treated as borrowed under (1AAA); the agreement promises an issue to the lender; an offer of securities-based derivatives contracts; cash settlement only
#ASSERT (`s 273(1A) the offer is excluded from paragraphs (d), (da), (e), (ea) and (h) of subsection (1)` TRUE NOTHING TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(1A) the offer is excluded from paragraphs (d), (da), (e), (ea) and (h) of subsection (1)` FALSE (JUST TRUE) TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(1A) the offer is excluded from paragraphs (d), (da), (e), (ea) and (h) of subsection (1)` TRUE NOTHING FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1A) the offer is excluded from paragraphs (d), (da), (e), (ea) and (h) of subsection (1)` FALSE NOTHING TRUE FALSE FALSE) EQUALS JUST FALSE
-- (c) applies only to an offer of securities-based derivatives contracts: cash settlement only defeats the exclusion there
#ASSERT (`s 273(1A) the offer is excluded from paragraphs (d), (da), (e), (ea) and (h) of subsection (1)` TRUE NOTHING TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1A) the offer is excluded from paragraphs (d), (da), (e), (ea) and (h) of subsection (1)` TRUE NOTHING TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(1A) the offer is excluded from paragraphs (d), (da), (e), (ea) and (h) of subsection (1)` TRUE NOTHING TRUE FALSE TRUE) EQUALS JUST TRUE
-- (1AAA): arguments: the securities being offered are SDRs; the issuer borrowed SDRs with those securities as the underlying securities; the issuer borrowed securities to form the underlying securities of the SDRs
#ASSERT (`s 273(1AAA) the issuer is treated as having borrowed the securities being offered` FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(1AAA) the issuer is treated as having borrowed the securities being offered` FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 273(1AAA) the issuer is treated as having borrowed the securities being offered` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1AAA) the issuer is treated as having borrowed the securities being offered` TRUE TRUE FALSE) EQUALS NOTHING
-- (1B): arguments: an offer of units or derivatives of units in a business trust; the kinds (b), (c), (cc), (cl), (j)
#ASSERT (`s 273(1B) Subdivision (1A) of this Division does not apply to the offer` TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 273(1B) Subdivision (1A) of this Division does not apply to the offer` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 273(1B) Subdivision (1A) of this Division does not apply to the offer` TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 273(1B) Subdivision (1A) of this Division does not apply to the offer` FALSE (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS NOTHING
-- (2): the same list of persons as section 272A(1)(d)
#ASSERT (`s 273(2) no selling or promotional expenses are paid or incurred other than those the subsection allows` EMPTY) EQUALS JUST TRUE
#ASSERT (`s 273(2) no selling or promotional expenses are paid or incurred other than those the subsection allows` (LIST `s 272A(1)(d) an expense incurred for administrative or professional services`)) EQUALS JUST TRUE
#ASSERT (`s 273(2) no selling or promotional expenses are paid or incurred other than those the subsection allows` (LIST `s 272A(1)(d) any other selling or promotional expense`)) EQUALS JUST FALSE
-- (4): arguments: the person is a director, employee and so on; the person is the spouse or a child below 18 of one
#ASSERT (`s 273(4)(a) the person is a qualifying person in relation to the entity` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(4)(a) the person is a qualifying person in relation to the entity` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(4)(a) the person is a qualifying person in relation to the entity` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(4)(b) the person is a qualifying person in relation to the business trust` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(4)(b) the person is a qualifying person in relation to the business trust` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(4)(b) the person is a qualifying person in relation to the business trust` FALSE FALSE) EQUALS JUST FALSE

§ `s 273(1)(d) to (k)`

-- (d): arguments: an offer of shares or debentures; excluded by the Authority; previously issued; listed or quoted; traded; excluded by (1A)
#ASSERT (`s 273(1)(d) the offer is an offer of previously issued shares or debentures listed and traded on an approved exchange` TRUE FALSE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 273(1)(d) the offer is an offer of previously issued shares or debentures listed and traded on an approved exchange` TRUE TRUE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(d) the offer is an offer of previously issued shares or debentures listed and traded on an approved exchange` TRUE FALSE FALSE TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(d) the offer is an offer of previously issued shares or debentures listed and traded on an approved exchange` TRUE FALSE TRUE FALSE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(d) the offer is an offer of previously issued shares or debentures listed and traded on an approved exchange` TRUE FALSE TRUE TRUE FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(d) the offer is an offer of previously issued shares or debentures listed and traded on an approved exchange` FALSE FALSE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
-- excluded by (1A): the offer "does not come within" paragraph (d)
#ASSERT (`s 273(1)(d) the offer is an offer of previously issued shares or debentures listed and traded on an approved exchange` TRUE FALSE TRUE TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(d) the offer is an offer of previously issued shares or debentures listed and traded on an approved exchange` TRUE FALSE TRUE TRUE TRUE NOTHING) EQUALS NOTHING
#ASSERT (`s 273(1)(d) the offer is an offer of previously issued shares or debentures listed and traded on an approved exchange` TRUE TRUE TRUE TRUE TRUE NOTHING) EQUALS JUST FALSE
#ASSERT (`s 273(1)(da) the offer is an offer of previously issued units in a business trust listed and traded on an approved exchange` TRUE FALSE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 273(1)(da) the offer is an offer of previously issued units in a business trust listed and traded on an approved exchange` TRUE FALSE TRUE TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(da) the offer is an offer of previously issued units in a business trust listed and traded on an approved exchange` TRUE TRUE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(e) the offer is an offer of previously issued securities-based derivatives contracts listed and traded on an approved exchange` TRUE FALSE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 273(1)(e) the offer is an offer of previously issued securities-based derivatives contracts listed and traded on an approved exchange` TRUE FALSE TRUE TRUE FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(e) the offer is an offer of previously issued securities-based derivatives contracts listed and traded on an approved exchange` TRUE FALSE TRUE TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
-- (ea): arguments: an offer of SDRs; the underlying securities are excluded; previously issued; listed or quoted; traded; excluded by (1A)
#ASSERT (`s 273(1)(ea) the offer is an offer of previously issued SDRs listed and traded on an approved exchange` TRUE FALSE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 273(1)(ea) the offer is an offer of previously issued SDRs listed and traded on an approved exchange` TRUE TRUE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(ea) the offer is an offer of previously issued SDRs listed and traded on an approved exchange` TRUE FALSE TRUE TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
-- (f): arguments: an offer of securities-based derivatives contracts; excluded; determined by securities indices; an application for listing
#ASSERT (`s 273(1)(f) the offer is an offer of securities-based derivatives contracts determined by reference to securities indices` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(f) the offer is an offer of securities-based derivatives contracts determined by reference to securities indices` TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(f) the offer is an offer of securities-based derivatives contracts determined by reference to securities indices` TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(f) the offer is an offer of securities-based derivatives contracts determined by reference to securities indices` TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
-- (g): arguments: an offer of contracts; excluded; cash settlement only; underlying securities listed on an organised market; that market is an excluded one; an application for listing; complies with the prescribed disclosure requirements
#ASSERT (`s 273(1)(g) the offer is an offer of cash-settled securities-based derivatives contracts over securities listed on an organised market` TRUE FALSE TRUE TRUE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(g) the offer is an offer of cash-settled securities-based derivatives contracts over securities listed on an organised market` TRUE FALSE TRUE TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(1)(g) the offer is an offer of cash-settled securities-based derivatives contracts over securities listed on an organised market` TRUE FALSE TRUE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(g) the offer is an offer of cash-settled securities-based derivatives contracts over securities listed on an organised market` TRUE FALSE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(g) the offer is an offer of cash-settled securities-based derivatives contracts over securities listed on an organised market` TRUE FALSE FALSE TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(1)(g) the offer is an offer of cash-settled securities-based derivatives contracts over securities listed on an organised market` TRUE TRUE TRUE TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
-- (h): arguments: an offer of contracts; excluded; settled otherwise than by cash only; underlying securities listed on an approved exchange or a recognised securities exchange; an application for listing; excluded by (1A)
#ASSERT (`s 273(1)(h) the offer is an offer of securities-based derivatives contracts settled otherwise than by cash only, over listed securities` TRUE FALSE TRUE TRUE TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 273(1)(h) the offer is an offer of securities-based derivatives contracts settled otherwise than by cash only, over listed securities` TRUE FALSE FALSE TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(h) the offer is an offer of securities-based derivatives contracts settled otherwise than by cash only, over listed securities` TRUE FALSE TRUE FALSE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(h) the offer is an offer of securities-based derivatives contracts settled otherwise than by cash only, over listed securities` TRUE FALSE TRUE TRUE FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(h) the offer is an offer of securities-based derivatives contracts settled otherwise than by cash only, over listed securities` TRUE FALSE TRUE TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
-- (i): arguments: an offer of securities or contracts of an entity; made by an entity to a qualifying person; the person is a qualifying person (section 273(4)); to be held by or for the qualifying person; those of the entity or its related parties; the expenses condition of (2)
#ASSERT (`s 273(1)(i) the offer is made by an entity to a qualifying person` TRUE TRUE (JUST TRUE) TRUE TRUE (JUST TRUE)) EQUALS JUST TRUE
-- subsection (2): the offer comes within (i) "only if" the expenses condition holds
#ASSERT (`s 273(1)(i) the offer is made by an entity to a qualifying person` TRUE TRUE (JUST TRUE) TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(i) the offer is made by an entity to a qualifying person` TRUE TRUE (JUST FALSE) TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(i) the offer is made by an entity to a qualifying person` TRUE TRUE (JUST TRUE) FALSE TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(i) the offer is made by an entity to a qualifying person` TRUE TRUE (JUST TRUE) TRUE FALSE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(i) the offer is made by an entity to a qualifying person` FALSE TRUE (JUST TRUE) TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(i) the offer is made by an entity to a qualifying person` TRUE TRUE (JUST TRUE) TRUE TRUE NOTHING) EQUALS NOTHING
-- (ia): arguments: an offer of SDRs made or treated as made by the entity to a qualifying person; qualifying person; held by; underlying securities are those of the entity; the expenses condition
#ASSERT (`s 273(1)(ia) the offer is an offer of SDRs made or treated as made by an entity to a qualifying person` TRUE (JUST TRUE) TRUE TRUE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 273(1)(ia) the offer is an offer of SDRs made or treated as made by an entity to a qualifying person` TRUE (JUST TRUE) TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(ia) the offer is an offer of SDRs made or treated as made by an entity to a qualifying person` FALSE (JUST TRUE) TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
-- (j) and (k): the same shape for a trustee-manager of a business trust
#ASSERT (`s 273(1)(j) the offer is made by a trustee-manager of a business trust to a qualifying person` TRUE (JUST TRUE) TRUE TRUE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 273(1)(j) the offer is made by a trustee-manager of a business trust to a qualifying person` TRUE (JUST TRUE) TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(j) the offer is made by a trustee-manager of a business trust to a qualifying person` TRUE (JUST FALSE) TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(k) the offer is an offer of SDRs made or treated as made by a trustee-manager of a business trust to a qualifying person` TRUE (JUST TRUE) TRUE TRUE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 273(1)(k) the offer is an offer of SDRs made or treated as made by a trustee-manager of a business trust to a qualifying person` TRUE (JUST TRUE) FALSE TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 273(1)(k) the offer is an offer of SDRs made or treated as made by a trustee-manager of a business trust to a qualifying person` TRUE (JUST TRUE) TRUE FALSE (JUST TRUE)) EQUALS JUST FALSE

§ `s 273(5) to (8B)`

-- (5) the declaration is made on 1 January 2025: "a period of 6 months from the date of the declaration" runs 1 January 2025 to 30 June 2025
#ASSERT (`s 273(5) the offer is within the period of 6 months from the date of the Authority's declaration` TRUE (Date 1 1 2025) (Date 1 1 2025)) EQUALS JUST TRUE
#ASSERT (`s 273(5) the offer is within the period of 6 months from the date of the Authority's declaration` TRUE (Date 1 1 2025) (Date 30 6 2025)) EQUALS JUST TRUE
#ASSERT (`s 273(5) the offer is within the period of 6 months from the date of the Authority's declaration` TRUE (Date 1 1 2025) (Date 1 7 2025)) EQUALS JUST FALSE
#ASSERT (`s 273(5) the offer is within the period of 6 months from the date of the Authority's declaration` TRUE (Date 1 1 2025) (Date 31 12 2024)) EQUALS JUST FALSE
#ASSERT (`s 273(5) the offer is within the period of 6 months from the date of the Authority's declaration` FALSE (Date 1 1 2025) (Date 1 3 2025)) EQUALS NOTHING
#ASSERT (`s 273(6) the Authority may impose conditions or restrictions on the offer` TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(6) the Authority may impose conditions or restrictions on the offer` FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(7) the declaration made under subsection (5) is final` TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(7) the declaration made under subsection (5) is final` FALSE) EQUALS NOTHING
#ASSERT (`s 273(8) the person is guilty of an offence` TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(8) the person is guilty of an offence` FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(8) the penalty for the offence`) EQUALS (Penalty OF 50000, 0, FALSE, 5000)
-- (8A): arguments: advertises; publishes a statement that refers to an offer; publishes a statement likely to induce; complies with the requirements prescribed under section 341
#ASSERT (`s 273(8A) the person must not advertise or publish what the subsection bars` TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(8A) the person must not advertise or publish what the subsection bars` FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(8A) the person must not advertise or publish what the subsection bars` FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(8A) the person must not advertise or publish what the subsection bars` TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 273(8A) the person must not advertise or publish what the subsection bars` FALSE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 273(8B) the person is guilty of an offence` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 273(8B) the person is guilty of an offence` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 273(8B) the person is guilty of an offence` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 273(8B) the penalty for the offence`) EQUALS (Penalty OF 50000, 12, TRUE, 5000)
-- the bar of (8A) as a rule: the forbidden act is a breach; with no act the bar stands
-- EXPECT BREACH
#TRACE `s 273(8A) the bar on advertising or publishing` AT 0 WITH
    PARTY `s 273 a person` DOES `s 273(8A) advertise or publish what the subsection bars` AT 4
-- EXPECT RESIDUAL
#TRACE `s 273(8A) the bar on advertising or publishing` AT 0 WITH
    (WAITUNTIL 30)

§ `s 273(1): any paragraph`

#ASSERT (`s 273(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` (LIST (`s 273(1) a paragraph and its answer` OF "(a)", (JUST FALSE)), (`s 273(1) a paragraph and its answer` OF "(ce)", (JUST TRUE)))) EQUALS JUST TRUE
#ASSERT (`s 273(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` (LIST (`s 273(1) a paragraph and its answer` OF "(a)", (JUST FALSE)), (`s 273(1) a paragraph and its answer` OF "(ce)", (JUST FALSE)))) EQUALS JUST FALSE
#ASSERT (`s 273(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` (LIST (`s 273(1) a paragraph and its answer` OF "(a)", (JUST FALSE)), (`s 273(1) a paragraph and its answer` OF "(ce)", NOTHING))) EQUALS NOTHING
#ASSERT (`s 273(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` (LIST (`s 273(1) a paragraph and its answer` OF "(a)", NOTHING), (`s 273(1) a paragraph and its answer` OF "(ce)", (JUST TRUE)))) EQUALS JUST TRUE
#ASSERT (`s 273(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` EMPTY) EQUALS JUST FALSE
#ASSERT (`s 273(1) the number of paragraphs that hold` (LIST (`s 273(1) a paragraph and its answer` OF "(a)", (JUST TRUE)), (`s 273(1) a paragraph and its answer` OF "(b)", (JUST TRUE)), (`s 273(1) a paragraph and its answer` OF "(c)", NOTHING))) EQUALS 2
#ASSERT (`s 273(1) the number of paragraphs that are not answered` (LIST (`s 273(1) a paragraph and its answer` OF "(a)", (JUST TRUE)), (`s 273(1) a paragraph and its answer` OF "(b)", NOTHING), (`s 273(1) a paragraph and its answer` OF "(c)", NOTHING))) EQUALS 2
