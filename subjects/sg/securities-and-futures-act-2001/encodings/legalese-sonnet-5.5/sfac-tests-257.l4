#ASSERT (`s 260(7C)(a) the director must pay into the trust property the loss, damages or costs` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 260(7C)(a) the director must pay into the trust property the loss, damages or costs` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 260(7C)(b) the director must compensate the allottee` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 260(7C)(b) the director must compensate the allottee` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 260(7C)(b) the director must compensate the allottee` FALSE TRUE) EQUALS NOTHING
