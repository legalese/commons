#ASSERT (`s 260(7B)(a) the trustee-manager must pay into the trust property the loss, damages or costs` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 260(7B)(b) the trustee-manager must compensate the allottee` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 260(7B)(b) the trustee-manager must compensate the allottee` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 260(7B)(b) the trustee-manager must compensate the allottee` FALSE TRUE) EQUALS NOTHING
