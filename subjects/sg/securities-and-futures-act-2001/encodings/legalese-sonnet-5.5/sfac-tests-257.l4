#ASSERT (`s 260(7D)(a) the director must compensate the company` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 260(7D)(a) the director must compensate the company` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 260(7D)(b) the director must compensate the allottee` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 260(7D)(b) the director must compensate the allottee` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 260(7D)(b) the director must compensate the allottee` FALSE TRUE) EQUALS NOTHING
