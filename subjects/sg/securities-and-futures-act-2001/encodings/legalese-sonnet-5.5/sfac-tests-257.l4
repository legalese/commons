#ASSERT (`s 260(7C) the director of the trustee-manager is guilty of an offence` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 260(7C) the director of the trustee-manager is guilty of an offence` FALSE TRUE) EQUALS NOTHING
