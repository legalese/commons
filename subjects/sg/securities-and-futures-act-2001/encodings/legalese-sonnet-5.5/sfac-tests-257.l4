IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfac-257`

-- Tests for sfac-257.l4 (ss 257, 258, 259, 260). Every expected value is written from the text of the Act (SFA2001.txt lines 41377 to 41829) before the code was run.
-- The arguments of a call are in the order of the function's GIVEN; a comment above a group names them.

§ `s 257: a document offering securities for sale`
-- arguments: (1): an entity allots with a view to sale; the Subdivision (4) exemption (MAYBE)
#ASSERT (`s 257(1) subsection (2) applies` TRUE (JUST FALSE)) EQUALS JUST TRUE
-- the subsequent offer qualifies for an exemption
#ASSERT (`s 257(1) subsection (2) applies` TRUE (JUST TRUE)) EQUALS JUST FALSE
-- "Subsection (2) applies where" fails
#ASSERT (`s 257(1) subsection (2) applies` FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 257(1) subsection (2) applies` TRUE NOTHING) EQUALS NOTHING
#ASSERT (`s 257(1) subsection (2) applies` FALSE NOTHING) EQUALS JUST FALSE
-- the three deemings: what (1) answers; the document is the one making the subsequent offer
#ASSERT (`s 257(2) the document is deemed to be a prospectus issued by the entity` (JUST TRUE) TRUE) EQUALS JUST TRUE
#ASSERT (`s 257(2) the document is deemed to be a prospectus issued by the entity` (JUST TRUE) FALSE) EQUALS NOTHING
#ASSERT (`s 257(2) the document is deemed to be a prospectus issued by the entity` (JUST FALSE) TRUE) EQUALS JUST FALSE
#ASSERT (`s 257(2) the document is deemed to be a prospectus issued by the entity` NOTHING TRUE) EQUALS NOTHING
#ASSERT (`s 257(2) the entity is deemed to be the person making the offer` (JUST TRUE) TRUE) EQUALS JUST TRUE
#ASSERT (`s 257(2) the entity is deemed to be the person making the offer` (JUST TRUE) FALSE) EQUALS NOTHING
#ASSERT (`s 257(2) the entity is deemed to be the person making the offer` (JUST FALSE) TRUE) EQUALS JUST FALSE
#ASSERT (`s 257(2) the entity is deemed to be the person making the offer` NOTHING TRUE) EQUALS NOTHING
#ASSERT (`s 257(2) the persons accepting the subsequent offer are deemed subscribers` (JUST TRUE) TRUE) EQUALS JUST TRUE
#ASSERT (`s 257(2) the persons accepting the subsequent offer are deemed subscribers` (JUST TRUE) FALSE) EQUALS NOTHING
#ASSERT (`s 257(2) the persons accepting the subsequent offer are deemed subscribers` (JUST FALSE) TRUE) EQUALS JUST FALSE
#ASSERT (`s 257(2) the persons accepting the subsequent offer are deemed subscribers` NOTHING TRUE) EQUALS NOTHING
#ASSERT (`s 257(2) the deeming affects the liability of the persons making the subsequent offer` TRUE) EQUALS JUST FALSE
#ASSERT (`s 257(2) the deeming affects the liability of the persons making the subsequent offer` FALSE) EQUALS NOTHING
-- (3) arguments: the date of the allotment (2 March 2026); the date the offer for sale was made; the whole consideration had not been received; the contrary is proved
-- within 6 months after the allotment
#ASSERT (`s 257(3) it is sufficient evidence that the allotment was made with a view to subsequent sale` (Date 2 3 2026) (Date 2 9 2026) FALSE FALSE) EQUALS JUST TRUE
-- the text gives two ways and says nothing of another
#ASSERT (`s 257(3) it is sufficient evidence that the allotment was made with a view to subsequent sale` (Date 2 3 2026) (Date 3 9 2026) FALSE FALSE) EQUALS NOTHING
-- (b) the whole consideration not yet received
#ASSERT (`s 257(3) it is sufficient evidence that the allotment was made with a view to subsequent sale` (Date 2 3 2026) (Date 3 9 2026) TRUE FALSE) EQUALS JUST TRUE
-- "unless the contrary is proved"
#ASSERT (`s 257(3) it is sufficient evidence that the allotment was made with a view to subsequent sale` (Date 2 3 2026) (Date 3 9 2026) TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 257(3) it is sufficient evidence that the allotment was made with a view to subsequent sale` (Date 2 3 2026) (Date 1 3 2026) FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 257(4) the person making the subsequent offer is treated as a person named in the prospectus as a director` (JUST TRUE) TRUE) EQUALS JUST TRUE
#ASSERT (`s 257(4) the person making the subsequent offer is treated as a person named in the prospectus as a director` (JUST TRUE) FALSE) EQUALS NOTHING
#ASSERT (`s 257(4) the person making the subsequent offer is treated as a person named in the prospectus as a director` (JUST FALSE) TRUE) EQUALS JUST FALSE
#ASSERT (`s 257(5) the document states what it must state` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 257(5) the document states what it must state` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 257(5) the document states what it must state` TRUE TRUE FALSE) EQUALS JUST FALSE
-- not the document making the subsequent offer
#ASSERT (`s 257(5) the document states what it must state` FALSE TRUE TRUE) EQUALS NOTHING

§ `s 258: application moneys`
-- arguments: (1) arguments: application moneys paid before allotment; the allotment has been made; held on trust; in a separate bank account; the account is kept solely for those moneys
#ASSERT (`s 258(1) the person making the offer holds the moneys on trust in a separate bank account` TRUE FALSE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 258(1) the person making the offer holds the moneys on trust in a separate bank account` TRUE FALSE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 258(1) the person making the offer holds the moneys on trust in a separate bank account` TRUE FALSE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 258(1) the person making the offer holds the moneys on trust in a separate bank account` TRUE FALSE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 258(1) the person making the offer holds the moneys on trust in a separate bank account` FALSE FALSE TRUE TRUE TRUE) EQUALS NOTHING
-- the duty runs "until the allotment"
#ASSERT (`s 258(1) the person making the offer holds the moneys on trust in a separate bank account` TRUE TRUE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 258(2) the bank has an obligation or duty to enquire into the application of the moneys` TRUE) EQUALS JUST FALSE
#ASSERT (`s 258(2) the bank has an obligation or duty to enquire into the application of the moneys` FALSE) EQUALS NOTHING
#ASSERT (`s 258(3) the person is guilty of an offence` (JUST FALSE)) EQUALS JUST TRUE
-- SPLIT-SITE (i)
#ASSERT (`s 258(3) the person is guilty of an offence` (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 258(3) the person is guilty of an offence` NOTHING) EQUALS NOTHING
#ASSERT (`s 258(3) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 50000
#ASSERT (`s 258(3) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 24
#ASSERT (`s 258(3) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS TRUE
#ASSERT (`s 258(3) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 5000

§ `s 259: where the prospectus indicates an application to list`
-- (1)(a) arguments: the prospectus states or implies an application; the date of issue (Monday 2 March 2026); applied for in the form required; the date applied
-- within 3 days from the issue
#ASSERT (`s 259(1)(a) the permission was not applied for in time` TRUE (Date 2 3 2026) TRUE (Date 5 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 259(1)(a) the permission was not applied for in time` TRUE (Date 2 3 2026) TRUE (Date 6 3 2026)) EQUALS JUST TRUE
-- never applied for
#ASSERT (`s 259(1)(a) the permission was not applied for in time` TRUE (Date 2 3 2026) FALSE (Date 2 3 2026)) EQUALS JUST TRUE
-- the "Where" gate fails
#ASSERT (`s 259(1)(a) the permission was not applied for in time` FALSE (Date 2 3 2026) TRUE (Date 5 3 2026)) EQUALS JUST FALSE
-- (1)(b) arguments: the prospectus states or implies an application; the date of issue; permission was granted; the date granted; the weeks of a longer period notified (0 if none)
-- 6 weeks from 2 March is 13 April
#ASSERT (`s 259(1)(b) the permission was not granted in time` TRUE (Date 2 3 2026) TRUE (Date 13 4 2026) 0) EQUALS JUST FALSE
#ASSERT (`s 259(1)(b) the permission was not granted in time` TRUE (Date 2 3 2026) TRUE (Date 14 4 2026) 0) EQUALS JUST TRUE
-- a longer period of 8 weeks notified
#ASSERT (`s 259(1)(b) the permission was not granted in time` TRUE (Date 2 3 2026) TRUE (Date 27 4 2026) 8) EQUALS JUST FALSE
#ASSERT (`s 259(1)(b) the permission was not granted in time` TRUE (Date 2 3 2026) TRUE (Date 28 4 2026) 8) EQUALS JUST TRUE
-- a period beyond 12 weeks is not one the text allows
#ASSERT (`s 259(1)(b) the permission was not granted in time` TRUE (Date 2 3 2026) TRUE (Date 14 4 2026) 13) EQUALS JUST TRUE
#ASSERT (`s 259(1)(b) the permission was not granted in time` TRUE (Date 2 3 2026) FALSE (Date 2 3 2026) 0) EQUALS JUST TRUE
#ASSERT (`s 259(1)(b) the permission was not granted in time` FALSE (Date 2 3 2026) TRUE (Date 13 4 2026) 0) EQUALS JUST FALSE
#ASSERT (`s 259(1) the permission was not applied for or not granted in time` (JUST TRUE) NOTHING) EQUALS JUST TRUE
#ASSERT (`s 259(1) the permission was not applied for or not granted in time` NOTHING (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 259(1) the permission was not applied for or not granted in time` (JUST FALSE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 259(1) the permission was not applied for or not granted in time` (JUST FALSE) NOTHING) EQUALS NOTHING
-- (1)(c) arguments: what (1) answers; the allotment was made on an application pursuant to the prospectus; what (3) answers
#ASSERT (`s 259(1)(c) the allotment is void` (JUST TRUE) TRUE NOTHING) EQUALS JUST TRUE
#ASSERT (`s 259(1)(c) the allotment is void` (JUST FALSE) TRUE NOTHING) EQUALS JUST FALSE
-- subject to subsection (3)
#ASSERT (`s 259(1)(c) the allotment is void` (JUST TRUE) TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 259(1)(c) the allotment is void` (JUST TRUE) FALSE NOTHING) EQUALS NOTHING
#ASSERT (`s 259(1)(c) the allotment is void` NOTHING TRUE NOTHING) EQUALS NOTHING
-- (1)(d) arguments: what (1) answers; the last day of the period missed; the date of the allotment; the person continues to allot; what (3) answers
#ASSERT (`s 259(1)(d) the person is guilty of an offence` (JUST TRUE) (Date 5 3 2026) (Date 6 3 2026) TRUE NOTHING) EQUALS JUST TRUE
-- not after the period (SPLIT-SITE (i))
#ASSERT (`s 259(1)(d) the person is guilty of an offence` (JUST TRUE) (Date 5 3 2026) (Date 5 3 2026) TRUE NOTHING) EQUALS NOTHING
#ASSERT (`s 259(1)(d) the person is guilty of an offence` (JUST TRUE) (Date 5 3 2026) (Date 6 3 2026) FALSE NOTHING) EQUALS NOTHING
#ASSERT (`s 259(1)(d) the person is guilty of an offence` (JUST FALSE) (Date 5 3 2026) (Date 6 3 2026) TRUE NOTHING) EQUALS JUST FALSE
#ASSERT (`s 259(1)(d) the person is guilty of an offence` (JUST TRUE) (Date 5 3 2026) (Date 6 3 2026) TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 259(1)(d) the person is guilty of an offence` NOTHING (Date 5 3 2026) (Date 6 3 2026) TRUE NOTHING) EQUALS NOTHING
#ASSERT (`s 259(1)(d) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 150000
#ASSERT (`s 259(1)(d) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 24
#ASSERT (`s 259(1)(d) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS TRUE
#ASSERT (`s 259(1)(d) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 15000
-- (2) arguments: what (1) answers; what (3) answers; the person making the offer has immediately repaid all moneys
#ASSERT (`s 259(2) the person making the offer has repaid the moneys` (JUST TRUE) NOTHING TRUE) EQUALS JUST TRUE
#ASSERT (`s 259(2) the person making the offer has repaid the moneys` (JUST TRUE) NOTHING FALSE) EQUALS JUST FALSE
#ASSERT (`s 259(2) the person making the offer has repaid the moneys` (JUST FALSE) NOTHING TRUE) EQUALS NOTHING
-- subject to subsection (3)
#ASSERT (`s 259(2) the person making the offer has repaid the moneys` (JUST TRUE) (JUST TRUE) FALSE) EQUALS NOTHING
#ASSERT (`s 259(2) the person making the offer has repaid the moneys` NOTHING NOTHING FALSE) EQUALS NOTHING
-- (2)(a) arguments: what (1) answers; what (3) answers; the date the person became liable to repay (10 March 2026); repaid; the date repaid
-- repaid within 14 days: the "if" fails (MARGINAL-READING (a))
#ASSERT (`s 259(2)(a) the person making the offer is liable to repay with interest at 10% per annum` (JUST TRUE) NOTHING (Date 10 3 2026) TRUE (Date 24 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 259(2)(a) the person making the offer is liable to repay with interest at 10% per annum` (JUST TRUE) NOTHING (Date 10 3 2026) TRUE (Date 25 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 259(2)(a) the person making the offer is liable to repay with interest at 10% per annum` (JUST TRUE) NOTHING (Date 10 3 2026) FALSE (Date 10 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 259(2)(a) the person making the offer is liable to repay with interest at 10% per annum` (JUST FALSE) NOTHING (Date 10 3 2026) FALSE (Date 10 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 259(2)(a) the person making the offer is liable to repay with interest at 10% per annum` (JUST TRUE) (JUST TRUE) (Date 10 3 2026) FALSE (Date 10 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 259(2)(a) the person making the offer is liable to repay with interest at 10% per annum` NOTHING NOTHING (Date 10 3 2026) FALSE (Date 10 3 2026)) EQUALS NOTHING
#ASSERT (`s 259(4) this section gives the director a defence` TRUE TRUE) EQUALS JUST TRUE
-- this section gives no defence on these facts
#ASSERT (`s 259(4) this section gives the director a defence` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 259(4) this section gives the director a defence` FALSE TRUE) EQUALS NOTHING
-- (2)(b) arguments: what (2)(a) answers; the person making the offer is an entity; the person is a director; what (4) answers
#ASSERT (`s 259(2)(b) the director is jointly and severally liable to repay with interest at 10% per annum` (JUST TRUE) TRUE TRUE NOTHING) EQUALS JUST TRUE
-- not an entity
#ASSERT (`s 259(2)(b) the director is jointly and severally liable to repay with interest at 10% per annum` (JUST TRUE) FALSE TRUE NOTHING) EQUALS JUST FALSE
-- the defence of subsection (4)
#ASSERT (`s 259(2)(b) the director is jointly and severally liable to repay with interest at 10% per annum` (JUST TRUE) TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 259(2)(b) the director is jointly and severally liable to repay with interest at 10% per annum` (JUST FALSE) TRUE TRUE NOTHING) EQUALS JUST FALSE
#ASSERT (`s 259(2)(b) the director is jointly and severally liable to repay with interest at 10% per annum` (JUST TRUE) TRUE FALSE NOTHING) EQUALS NOTHING
#ASSERT (`s 259(2)(b) the director is jointly and severally liable to repay with interest at 10% per annum` NOTHING TRUE TRUE NOTHING) EQUALS NOTHING
-- (3) arguments: permission not applied for; not granted; the issuer applied before any allotment
#ASSERT (`s 259(3) the Authority may exempt the allotment` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 259(3) the Authority may exempt the allotment` FALSE TRUE TRUE) EQUALS JUST TRUE
-- a "may" gated by "Where" (SPLIT-SITE (ii))
#ASSERT (`s 259(3) the Authority may exempt the allotment` FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 259(3) the Authority may exempt the allotment` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 259(3) the Authority has given notice of the exemption in the Gazette` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 259(3) the Authority has given notice of the exemption in the Gazette` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 259(3) the Authority has given notice of the exemption in the Gazette` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 259(5) the condition is void` TRUE) EQUALS JUST TRUE
#ASSERT (`s 259(5) the condition is void` FALSE) EQUALS NOTHING
#ASSERT (`s 259(6)(a) the underwriter is treated as having applied pursuant to the prospectus` TRUE) EQUALS JUST TRUE
#ASSERT (`s 259(6)(a) the underwriter is treated as having applied pursuant to the prospectus` FALSE) EQUALS NOTHING
#ASSERT (`s 259(6)(b) a reference to sale is read for a reference to allotment` TRUE) EQUALS JUST TRUE
#ASSERT (`s 259(6)(b) a reference to sale is read for a reference to allotment` FALSE) EQUALS NOTHING
-- (7) arguments: moneys received pursuant to the prospectus; the person may become liable to repay; kept in a separate bank account
#ASSERT (`s 259(7) the moneys are kept in a separate bank account` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 259(7) the moneys are kept in a separate bank account` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 259(7) the moneys are kept in a separate bank account` FALSE TRUE TRUE) EQUALS NOTHING
-- "so long as" the person may become liable
#ASSERT (`s 259(7) the moneys are kept in a separate bank account` TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 259(8) the person is guilty of an offence` (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 259(8) the person is guilty of an offence` (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 259(8) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 50000
#ASSERT (`s 259(8) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 12
#ASSERT (`s 259(8) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS TRUE
#ASSERT (`s 259(8) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 5000
#ASSERT (`s 259(9) permission is deemed to have been granted` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 259(9) permission is deemed to have been granted` TRUE FALSE) EQUALS NOTHING
-- the "Where" gate fails
#ASSERT (`s 259(9) permission is deemed to have been granted` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 259(10) the director is guilty of an offence` TRUE TRUE) EQUALS JUST TRUE
-- the "If" fails (SPLIT-SITE (i), MARGINAL-READING (a))
#ASSERT (`s 259(10) the director is guilty of an offence` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 259(10) the director is guilty of an offence` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 259(10) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 50000
#ASSERT (`s 259(10) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 0
#ASSERT (`s 259(10) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS FALSE
#ASSERT (`s 259(10) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 5000
-- (11) arguments: issues a prospectus inviting subscriptions of an entity; includes a false statement that permission was granted; includes a statement referring to permission or listing; that statement is to the effect permission granted or application within 3 days; approved by the Authority
#ASSERT (`s 259(11) the person must not issue the prospectus` TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 259(11) the person must not issue the prospectus` TRUE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
-- "unless" the statement is to the effect permission granted
#ASSERT (`s 259(11) the person must not issue the prospectus` TRUE FALSE TRUE TRUE FALSE) EQUALS JUST FALSE
-- "unless" approved by the Authority
#ASSERT (`s 259(11) the person must not issue the prospectus` TRUE FALSE TRUE FALSE TRUE) EQUALS JUST FALSE
-- SPLIT-SITE (i)
#ASSERT (`s 259(11) the person must not issue the prospectus` TRUE FALSE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 259(11) the person must not issue the prospectus` FALSE TRUE FALSE FALSE FALSE) EQUALS NOTHING
-- a false statement is barred whatever the exceptions
#ASSERT (`s 259(11) the person must not issue the prospectus` TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE

-- EXPECT BREACH: the bar bites and the person issues
#TRACE (`s 259(11) the person shall not issue the prospectus` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 259(11) issue the prospectus inviting persons to subscribe` AT 2

-- EXPECT FULFILLED: the statement is within an exception
#TRACE (`s 259(11) the person shall not issue the prospectus` (`An offeror` "Acme Pte Ltd") (JUST FALSE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 259(11) issue the prospectus inviting persons to subscribe` AT 2
#ASSERT (`s 259(12) the person is guilty of an offence` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 259(12) the person is guilty of an offence` (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 259(12) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 50000
#ASSERT (`s 259(12) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 12
#ASSERT (`s 259(12) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS TRUE
#ASSERT (`s 259(12) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 5000
#ASSERT (`s 259(13) the prospectus is deemed to imply that application has been or will be made for permission` TRUE FALSE) EQUALS JUST TRUE
-- "unless the contrary intention appears"
#ASSERT (`s 259(13) the prospectus is deemed to imply that application has been or will be made for permission` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 259(13) the prospectus is deemed to imply that application has been or will be made for permission` FALSE FALSE) EQUALS NOTHING

§ `s 260: no allotment unless the minimum subscription is received`
-- (1A) arguments: the sum was received by cheque; the cheque has been paid; the sum was received otherwise than by cheque
-- treated as not received until the cheque is paid
#ASSERT (`s 260(1A) the sum payable on application is treated as received` TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 260(1A) the sum payable on application is treated as received` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 260(1A) the sum payable on application is treated as received` FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 260(1A) the sum payable on application is treated as received` FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 260(1A) the sum payable on application is treated as received` TRUE FALSE TRUE) EQUALS JUST TRUE
-- (1) arguments: the person makes an allotment of securities of a company or business trust; the minimum subscription has been subscribed; what (1A) answers
-- both conditions of the "unless" are met
#ASSERT (`s 260(1) the person must not make the allotment` TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 260(1) the person must not make the allotment` TRUE FALSE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 260(1) the person must not make the allotment` TRUE TRUE (JUST FALSE)) EQUALS JUST TRUE
-- only an answer JUST TRUE counts
#ASSERT (`s 260(1) the person must not make the allotment` TRUE TRUE NOTHING) EQUALS JUST TRUE
-- SPLIT-SITE (i)
#ASSERT (`s 260(1) the person must not make the allotment` FALSE TRUE (JUST TRUE)) EQUALS NOTHING

-- EXPECT BREACH: the bar bites and the person allots
#TRACE (`s 260(1) the person shall not make the allotment` (`An offeror` "Acme Pte Ltd") (JUST TRUE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 260(1) make an allotment before the minimum subscription is subscribed and the sums received` AT 2

-- EXPECT FULFILLED: the conditions are met
#TRACE (`s 260(1) the person shall not make the allotment` (`An offeror` "Acme Pte Ltd") (JUST FALSE)) AT 0 WITH
    PARTY (`An offeror` "Acme Pte Ltd") DOES `s 260(1) make an allotment before the minimum subscription is subscribed and the sums received` AT 2
#ASSERT (`s 260(2) the minimum subscription is calculated as it must be` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 260(2) the minimum subscription is calculated as it must be` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 260(2) the minimum subscription is calculated as it must be` FALSE TRUE) EQUALS JUST FALSE
-- arguments: the price; the amount payable on application
-- 5 is 5% of 100
#ASSERT (`s 260(3) the amount payable on application is not less than 5% of the price` 100 5) EQUALS JUST TRUE
#ASSERT (`s 260(3) the amount payable on application is not less than 5% of the price` 100 4) EQUALS JUST FALSE
#ASSERT (`s 260(3) the amount payable on application is not less than 5% of the price` 1000 50) EQUALS JUST TRUE
#ASSERT (`s 260(3) the amount payable on application is not less than 5% of the price` 1000 49) EQUALS JUST FALSE
-- arguments: the conditions were satisfied on the expiration of 4 months; all moneys have been immediately repaid
#ASSERT (`s 260(4) the moneys have been repaid` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 260(4) the moneys have been repaid` FALSE FALSE) EQUALS JUST FALSE
-- the "If" on a duty is unmet
#ASSERT (`s 260(4) the moneys have been repaid` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 260(6) this section gives the director a defence` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 260(6) this section gives the director a defence` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 260(6) this section gives the director a defence` FALSE TRUE) EQUALS NOTHING
-- (5) arguments: the date of issue (2 March 2026); the money has been repaid; the date repaid; the person is a director; what (6) answers
-- repaid within 5 months (MARGINAL-READING (a))
#ASSERT (`s 260(5) the director is jointly and severally liable to repay with interest at 10% per annum` (Date 2 3 2026) TRUE (Date 2 8 2026) TRUE NOTHING) EQUALS JUST FALSE
#ASSERT (`s 260(5) the director is jointly and severally liable to repay with interest at 10% per annum` (Date 2 3 2026) TRUE (Date 3 8 2026) TRUE NOTHING) EQUALS JUST TRUE
#ASSERT (`s 260(5) the director is jointly and severally liable to repay with interest at 10% per annum` (Date 2 3 2026) FALSE (Date 2 3 2026) TRUE NOTHING) EQUALS JUST TRUE
#ASSERT (`s 260(5) the director is jointly and severally liable to repay with interest at 10% per annum` (Date 2 3 2026) FALSE (Date 2 3 2026) TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 260(5) the director is jointly and severally liable to repay with interest at 10% per annum` (Date 2 3 2026) FALSE (Date 2 3 2026) FALSE NOTHING) EQUALS NOTHING
-- (7) arguments: the allotment is made in contravention; the allotter is a company; the company must hold a statutory meeting and the allotment came first; the date of the statutory meeting (20 April 2026); the date of the allotment (2 March 2026); the notice is in writing and served; the date served
-- one month after the statutory meeting
#ASSERT (`s 260(7) the applicant has exercised the option to avoid the allotment in time` TRUE TRUE TRUE (Date 20 4 2026) (Date 2 3 2026) TRUE (Date 20 5 2026)) EQUALS JUST TRUE
#ASSERT (`s 260(7) the applicant has exercised the option to avoid the allotment in time` TRUE TRUE TRUE (Date 20 4 2026) (Date 2 3 2026) TRUE (Date 21 5 2026)) EQUALS JUST FALSE
-- no statutory meeting before the allotment: one month after the allotment
#ASSERT (`s 260(7) the applicant has exercised the option to avoid the allotment in time` TRUE TRUE FALSE (Date 20 4 2026) (Date 2 3 2026) TRUE (Date 2 4 2026)) EQUALS JUST TRUE
#ASSERT (`s 260(7) the applicant has exercised the option to avoid the allotment in time` TRUE TRUE FALSE (Date 20 4 2026) (Date 2 3 2026) TRUE (Date 3 4 2026)) EQUALS JUST FALSE
-- a trustee-manager of a business trust
#ASSERT (`s 260(7) the applicant has exercised the option to avoid the allotment in time` TRUE FALSE FALSE (Date 20 4 2026) (Date 2 3 2026) TRUE (Date 2 4 2026)) EQUALS JUST TRUE
#ASSERT (`s 260(7) the applicant has exercised the option to avoid the allotment in time` TRUE FALSE FALSE (Date 20 4 2026) (Date 2 3 2026) TRUE (Date 3 4 2026)) EQUALS JUST FALSE
