#ASSERT (`s 260(7D) the director of the company is guilty of an offence` FALSE TRUE) EQUALS NOTHING
-- (8) arguments: the date of the allotment (2 March 2026); the date the proceedings are commenced
-- the last day of the 2 years is 2 March 2028
#ASSERT (`s 260(8) the proceedings may not be commenced` (Date 2 3 2026) (Date 2 3 2028)) EQUALS JUST FALSE
#ASSERT (`s 260(8) the proceedings may not be commenced` (Date 2 3 2026) (Date 3 3 2028)) EQUALS JUST TRUE
