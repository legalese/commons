IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfab-insider-2`

-- Tests for sfab-insider-2 (Securities and Futures Act 2001, Part 12). Every expected value below is written from the text of the section named above it,
-- by hand, with the inputs that decide it; none is copied from output. Case order: the case that meets the provision, then each input taken away in turn,
-- then the case the text does not decide. A `#S` case is one that takes a branch marked SPLIT-SITE in the module.


-- s 218(6) the person is an officer of the corporation for the purposes of subsection (5)
#ASSERT `s 218(6) the person is an officer of the corporation for the purposes of subsection (5)` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 218(6) the person is an officer of the corporation for the purposes of subsection (5)` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 218(6) the person is an officer of the corporation for the purposes of subsection (5)` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 218(6) the person is an officer of the corporation for the purposes of subsection (5)` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 218(6) the person is an officer of the corporation for the purposes of subsection (5)` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 218(6) the person is an officer of the corporation for the purposes of subsection (5)` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- s 218(5)(b) the person is connected to the corporation
#ASSERT `s 218(5)(b) the person is connected to the corporation` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 218(5)(b) the person is connected to the corporation` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 218(5)(b) the person is connected to the corporation` FALSE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 218(5)(b) the person is connected to the corporation` FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 218(5)(b) the person is connected to the corporation` FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 218(5)(b) the person is connected to the corporation` FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 218(5)(b) the person is connected to the corporation` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 218(5)(a) the person is a connected person
#ASSERT `s 218(5)(a) the person is a connected person` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 218(5)(a) the person is a connected person` FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 218(5)(a) the person is a connected person` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 218(5)(a) the person is a connected person` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 218(5)(a) the person is a connected person` TRUE NOTHING EQUALS NOTHING

-- s 218(1) subsections (2), (3), (4), (5) and (6) apply to the connected person
#ASSERT `s 218(1) subsections (2), (3), (4), (5) and (6) apply to the connected person` (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 218(1) subsections (2), (3), (4), (5) and (6) apply to the connected person` NOTHING TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 218(1) subsections (2), (3), (4), (5) and (6) apply to the connected person` (JUST TRUE) TRUE NOTHING (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 218(1) subsections (2), (3), (4), (5) and (6) apply to the connected person` (JUST TRUE) TRUE (JUST FALSE) NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 218(1) subsections (2), (3), (4), (5) and (6) apply to the connected person` (JUST FALSE) TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1) subsections (2), (3), (4), (5) and (6) apply to the connected person` (JUST TRUE) FALSE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1) subsections (2), (3), (4), (5) and (6) apply to the connected person` (JUST TRUE) TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1) subsections (2), (3), (4), (5) and (6) apply to the connected person` (JUST TRUE) TRUE (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1) subsections (2), (3), (4), (5) and (6) apply to the connected person` (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) FALSE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1) subsections (2), (3), (4), (5) and (6) apply to the connected person` (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) TRUE FALSE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1) subsections (2), (3), (4), (5) and (6) apply to the connected person` NOTHING TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE  -- S

-- s 218 subsection (2) and (3) apply to the person under subsection (1) or (1A)
#ASSERT `s 218 subsection (2) and (3) apply to the person under subsection (1) or (1A)` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 218 subsection (2) and (3) apply to the person under subsection (1) or (1A)` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 218 subsection (2) and (3) apply to the person under subsection (1) or (1A)` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 218 subsection (2) and (3) apply to the person under subsection (1) or (1A)` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 218 subsection (2) and (3) apply to the person under subsection (1) or (1A)` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 218 subsection (2) and (3) apply to the person under subsection (1) or (1A)` NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 218 subsection (2) and (3) apply to the person under subsection (1) or (1A)` NOTHING NOTHING EQUALS NOTHING

