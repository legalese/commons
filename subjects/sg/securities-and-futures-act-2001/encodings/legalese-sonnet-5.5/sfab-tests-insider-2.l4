#ASSERT `s 218(1A) subsections (2), (3), (4A), (5) and (6) apply to the person connected to a business trust or scheme corporation` FALSE TRUE FALSE (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1A) subsections (2), (3), (4A), (5) and (6) apply to the person connected to a business trust or scheme corporation` FALSE FALSE FALSE (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1A) subsections (2), (3), (4A), (5) and (6) apply to the person connected to a business trust or scheme corporation` TRUE FALSE FALSE NOTHING TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 218(1A) subsections (2), (3), (4A), (5) and (6) apply to the person connected to a business trust or scheme corporation` TRUE FALSE FALSE (JUST TRUE) FALSE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1A) subsections (2), (3), (4A), (5) and (6) apply to the person connected to a business trust or scheme corporation` TRUE FALSE FALSE (JUST FALSE) TRUE (JUST FALSE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1A) subsections (2), (3), (4A), (5) and (6) apply to the person connected to a business trust or scheme corporation` TRUE FALSE FALSE (JUST TRUE) TRUE (JUST TRUE) (JUST TRUE) TRUE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1A) subsections (2), (3), (4A), (5) and (6) apply to the person connected to a business trust or scheme corporation` TRUE FALSE FALSE (JUST TRUE) TRUE (JUST FALSE) (JUST FALSE) TRUE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1A) subsections (2), (3), (4A), (5) and (6) apply to the person connected to a business trust or scheme corporation` TRUE FALSE FALSE (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) FALSE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1A) subsections (2), (3), (4A), (5) and (6) apply to the person connected to a business trust or scheme corporation` TRUE FALSE FALSE (JUST TRUE) TRUE (JUST FALSE) (JUST TRUE) TRUE FALSE EQUALS JUST FALSE  -- S
#ASSERT `s 218(1A) subsections (2), (3), (4A), (5) and (6) apply to the person connected to a business trust or scheme corporation` TRUE FALSE FALSE (JUST TRUE) TRUE NOTHING (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 218(1A) subsections (2), (3), (4A), (5) and (6) apply to the person connected to a business trust or scheme corporation` TRUE FALSE FALSE (JUST TRUE) TRUE (JUST FALSE) NOTHING TRUE TRUE EQUALS NOTHING

-- s 218(2) the connected person's dealing or procuring contravenes the bar
#ASSERT `s 218(2) the connected person's dealing or procuring contravenes the bar` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 218(2) the connected person's dealing or procuring contravenes the bar` (JUST TRUE) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 218(2) the connected person's dealing or procuring contravenes the bar` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
