#ASSERT `s 218(2) the connected person's dealing or procuring contravenes the bar` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 218(2) the connected person's dealing or procuring contravenes the bar` NOTHING TRUE TRUE EQUALS NOTHING

