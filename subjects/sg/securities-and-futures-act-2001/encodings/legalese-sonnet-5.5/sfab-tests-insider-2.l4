#ASSERT `s 218(4A) the presumption in subsection (4B) applies` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 218(4A) the presumption in subsection (4B) applies` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 218(4A) the presumption in subsection (4B) applies` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 218(4A) the presumption in subsection (4B) applies` TRUE TRUE FALSE EQUALS NOTHING

