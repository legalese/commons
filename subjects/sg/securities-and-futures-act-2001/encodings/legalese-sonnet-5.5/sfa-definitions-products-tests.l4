#ASSERT (`s 2(1) "debenture" the instrument is a debenture` WITH `the instrument is a debenture stock, bond, note or other debt security issued, or proposed to be issued, by a corporation or any other entity` IS FALSE, `the instrument is a debenture stock, bond, note or other debt security issued, or proposed to be issued, by a trustee-manager of a business trust or a trustee of a real estate investment trust in that capacity` IS FALSE, `the Authority has prescribed the product, or its class, as a debenture` IS TRUE, `the instrument is a cheque, letter of credit, order for the payment of money or bill of exchange` IS FALSE, `regulations under the provision in question say that the word debenture does not include the document or its class` IS FALSE) EQUALS JUST TRUE
-- excluded from "debenture": the instrument is a cheque, letter of credit, order for the payment of money or bill of exchange
#ASSERT (`s 2(1) "debenture" the instrument is a debenture` WITH `the instrument is a debenture stock, bond, note or other debt security issued, or proposed to be issued, by a corporation or any other entity` IS FALSE, `the instrument is a debenture stock, bond, note or other debt security issued, or proposed to be issued, by a trustee-manager of a business trust or a trustee of a real estate investment trust in that capacity` IS FALSE, `the Authority has prescribed the product, or its class, as a debenture` IS FALSE, `the instrument is a cheque, letter of credit, order for the payment of money or bill of exchange` IS TRUE, `regulations under the provision in question say that the word debenture does not include the document or its class` IS FALSE) EQUALS JUST FALSE
-- excluded from "debenture": regulations under the provision in question say that the word debenture does not include the document or its class
#ASSERT (`s 2(1) "debenture" the instrument is a debenture` WITH `the instrument is a debenture stock, bond, note or other debt security issued, or proposed to be issued, by a corporation or any other entity` IS FALSE, `the instrument is a debenture stock, bond, note or other debt security issued, or proposed to be issued, by a trustee-manager of a business trust or a trustee of a real estate investment trust in that capacity` IS FALSE, `the Authority has prescribed the product, or its class, as a debenture` IS FALSE, `the instrument is a cheque, letter of credit, order for the payment of money or bill of exchange` IS FALSE, `regulations under the provision in question say that the word debenture does not include the document or its class` IS TRUE) EQUALS JUST FALSE
-- a bill of exchange that is also a note: the exclusion governs
#ASSERT (`s 2(1) "debenture" the instrument is a debenture` WITH `the instrument is a debenture stock, bond, note or other debt security issued, or proposed to be issued, by a corporation or any other entity` IS TRUE, `the instrument is a debenture stock, bond, note or other debt security issued, or proposed to be issued, by a trustee-manager of a business trust or a trustee of a real estate investment trust in that capacity` IS FALSE, `the Authority has prescribed the product, or its class, as a debenture` IS FALSE, `the instrument is a cheque, letter of credit, order for the payment of money or bill of exchange` IS TRUE, `regulations under the provision in question say that the word debenture does not include the document or its class` IS FALSE) EQUALS JUST FALSE
-- no limb and no exclusion: "includes" is an open list, so the text does not say no
#ASSERT (`s 2(1) "debenture" the instrument is a debenture` WITH `the instrument is a debenture stock, bond, note or other debt security issued, or proposed to be issued, by a corporation or any other entity` IS FALSE, `the instrument is a debenture stock, bond, note or other debt security issued, or proposed to be issued, by a trustee-manager of a business trust or a trustee of a real estate investment trust in that capacity` IS FALSE, `the Authority has prescribed the product, or its class, as a debenture` IS FALSE, `the instrument is a cheque, letter of credit, order for the payment of money or bill of exchange` IS FALSE, `regulations under the provision in question say that the word debenture does not include the document or its class` IS FALSE) EQUALS NOTHING

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "share" the interest is a share` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 4(1) of the Companies Act 1967"
#ASSERT `s 2(1) "share" the interest is a share` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "voting share" the share is a voting share` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 4(1) of the Companies Act 1967"
#ASSERT `s 2(1) "voting share" the share is a voting share` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "derivative" the thing is a derivative of a unit in a business trust` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given by section 2 of the Business Trusts Act 2004"
#ASSERT `s 2(1) "derivative" the thing is a derivative of a unit in a business trust` FALSE EQUALS JUST FALSE

-- (a): a company's share that is a treasury share under the Companies Act 1967
#ASSERT `s 2(1) "treasury share" (a) the share of a company is a treasury share` TRUE EQUALS JUST TRUE
-- (a): not one
#ASSERT `s 2(1) "treasury share" (a) the share of a company is a treasury share` FALSE EQUALS JUST FALSE
-- (b): equivalent to a treasury share in a company
#ASSERT `s 2(1) "treasury share" (b) the share of a corporation other than a company is a treasury share` TRUE EQUALS JUST TRUE
-- (b): not equivalent
#ASSERT `s 2(1) "treasury share" (b) the share of a corporation other than a company is a treasury share` FALSE EQUALS JUST FALSE
