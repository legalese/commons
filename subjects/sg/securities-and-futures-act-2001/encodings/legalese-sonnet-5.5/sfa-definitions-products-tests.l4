IMPORT prelude
IMPORT daydate
IMPORT `sfa-definitions-products`

-- Tests for sfa-definitions-products.
-- Expected values are written from the text of the Act (the quote lines in the module under test), never from its output.

-- one limb of "capital markets products" alone is enough: the product is securities
#ASSERT (`s 2(1) "capital markets products" the product is capital markets products` WITH `the product is securities` IS TRUE, `the product is a unit in a collective investment scheme` IS FALSE, `the product is a derivatives contract` IS FALSE, `the product is a spot foreign exchange contract for the purposes of leveraged foreign exchange trading` IS FALSE, `the Authority has prescribed the product as capital markets products` IS FALSE) EQUALS JUST TRUE
-- one limb of "capital markets products" alone is enough: the product is a unit in a collective investment scheme
#ASSERT (`s 2(1) "capital markets products" the product is capital markets products` WITH `the product is securities` IS FALSE, `the product is a unit in a collective investment scheme` IS TRUE, `the product is a derivatives contract` IS FALSE, `the product is a spot foreign exchange contract for the purposes of leveraged foreign exchange trading` IS FALSE, `the Authority has prescribed the product as capital markets products` IS FALSE) EQUALS JUST TRUE
-- one limb of "capital markets products" alone is enough: the product is a derivatives contract
#ASSERT (`s 2(1) "capital markets products" the product is capital markets products` WITH `the product is securities` IS FALSE, `the product is a unit in a collective investment scheme` IS FALSE, `the product is a derivatives contract` IS TRUE, `the product is a spot foreign exchange contract for the purposes of leveraged foreign exchange trading` IS FALSE, `the Authority has prescribed the product as capital markets products` IS FALSE) EQUALS JUST TRUE
-- one limb of "capital markets products" alone is enough: the product is a spot foreign exchange contract for the purposes of leveraged foreign exchange trading
#ASSERT (`s 2(1) "capital markets products" the product is capital markets products` WITH `the product is securities` IS FALSE, `the product is a unit in a collective investment scheme` IS FALSE, `the product is a derivatives contract` IS FALSE, `the product is a spot foreign exchange contract for the purposes of leveraged foreign exchange trading` IS TRUE, `the Authority has prescribed the product as capital markets products` IS FALSE) EQUALS JUST TRUE
-- one limb of "capital markets products" alone is enough: the Authority has prescribed the product as capital markets products
#ASSERT (`s 2(1) "capital markets products" the product is capital markets products` WITH `the product is securities` IS FALSE, `the product is a unit in a collective investment scheme` IS FALSE, `the product is a derivatives contract` IS FALSE, `the product is a spot foreign exchange contract for the purposes of leveraged foreign exchange trading` IS FALSE, `the Authority has prescribed the product as capital markets products` IS TRUE) EQUALS JUST TRUE
-- no limb: the definition says "means", so the text says no
#ASSERT (`s 2(1) "capital markets products" the product is capital markets products` WITH `the product is securities` IS FALSE, `the product is a unit in a collective investment scheme` IS FALSE, `the product is a derivatives contract` IS FALSE, `the product is a spot foreign exchange contract for the purposes of leveraged foreign exchange trading` IS FALSE, `the Authority has prescribed the product as capital markets products` IS FALSE) EQUALS JUST FALSE

-- (a), (b) or (c) of "securities" alone is enough: the instrument is a share
#ASSERT (`s 2(1) "securities" the instrument is securities` WITH `the instrument is a share` IS TRUE, `the instrument is a unit in a business trust` IS FALSE, `the instrument confers or represents a legal or beneficial ownership interest in a corporation, partnership or limited liability partnership` IS FALSE, `the instrument is a debenture` IS FALSE, `the Authority has prescribed the instrument, or its class, as securities` IS FALSE, `the instrument is a unit of a collective investment scheme` IS FALSE, `the instrument is a bill of exchange` IS FALSE, `the instrument is a certificate of deposit issued by a bank or finance company, whether situated in Singapore or elsewhere` IS FALSE, `the Authority has prescribed the instrument, or its class, as not being securities` IS FALSE) EQUALS JUST TRUE
-- (a), (b) or (c) of "securities" alone is enough: the instrument is a unit in a business trust
#ASSERT (`s 2(1) "securities" the instrument is securities` WITH `the instrument is a share` IS FALSE, `the instrument is a unit in a business trust` IS TRUE, `the instrument confers or represents a legal or beneficial ownership interest in a corporation, partnership or limited liability partnership` IS FALSE, `the instrument is a debenture` IS FALSE, `the Authority has prescribed the instrument, or its class, as securities` IS FALSE, `the instrument is a unit of a collective investment scheme` IS FALSE, `the instrument is a bill of exchange` IS FALSE, `the instrument is a certificate of deposit issued by a bank or finance company, whether situated in Singapore or elsewhere` IS FALSE, `the Authority has prescribed the instrument, or its class, as not being securities` IS FALSE) EQUALS JUST TRUE
-- (a), (b) or (c) of "securities" alone is enough: the instrument confers or represents a legal or beneficial ownership interest in a corporation, partnership or limited liability partnership
#ASSERT (`s 2(1) "securities" the instrument is securities` WITH `the instrument is a share` IS FALSE, `the instrument is a unit in a business trust` IS FALSE, `the instrument confers or represents a legal or beneficial ownership interest in a corporation, partnership or limited liability partnership` IS TRUE, `the instrument is a debenture` IS FALSE, `the Authority has prescribed the instrument, or its class, as securities` IS FALSE, `the instrument is a unit of a collective investment scheme` IS FALSE, `the instrument is a bill of exchange` IS FALSE, `the instrument is a certificate of deposit issued by a bank or finance company, whether situated in Singapore or elsewhere` IS FALSE, `the Authority has prescribed the instrument, or its class, as not being securities` IS FALSE) EQUALS JUST TRUE
-- (a), (b) or (c) of "securities" alone is enough: the instrument is a debenture
#ASSERT (`s 2(1) "securities" the instrument is securities` WITH `the instrument is a share` IS FALSE, `the instrument is a unit in a business trust` IS FALSE, `the instrument confers or represents a legal or beneficial ownership interest in a corporation, partnership or limited liability partnership` IS FALSE, `the instrument is a debenture` IS TRUE, `the Authority has prescribed the instrument, or its class, as securities` IS FALSE, `the instrument is a unit of a collective investment scheme` IS FALSE, `the instrument is a bill of exchange` IS FALSE, `the instrument is a certificate of deposit issued by a bank or finance company, whether situated in Singapore or elsewhere` IS FALSE, `the Authority has prescribed the instrument, or its class, as not being securities` IS FALSE) EQUALS JUST TRUE
-- (a), (b) or (c) of "securities" alone is enough: the Authority has prescribed the instrument, or its class, as securities
#ASSERT (`s 2(1) "securities" the instrument is securities` WITH `the instrument is a share` IS FALSE, `the instrument is a unit in a business trust` IS FALSE, `the instrument confers or represents a legal or beneficial ownership interest in a corporation, partnership or limited liability partnership` IS FALSE, `the instrument is a debenture` IS FALSE, `the Authority has prescribed the instrument, or its class, as securities` IS TRUE, `the instrument is a unit of a collective investment scheme` IS FALSE, `the instrument is a bill of exchange` IS FALSE, `the instrument is a certificate of deposit issued by a bank or finance company, whether situated in Singapore or elsewhere` IS FALSE, `the Authority has prescribed the instrument, or its class, as not being securities` IS FALSE) EQUALS JUST TRUE
-- an exclusion alone: the instrument is a unit of a collective investment scheme
#ASSERT (`s 2(1) "securities" the instrument is securities` WITH `the instrument is a share` IS FALSE, `the instrument is a unit in a business trust` IS FALSE, `the instrument confers or represents a legal or beneficial ownership interest in a corporation, partnership or limited liability partnership` IS FALSE, `the instrument is a debenture` IS FALSE, `the Authority has prescribed the instrument, or its class, as securities` IS FALSE, `the instrument is a unit of a collective investment scheme` IS TRUE, `the instrument is a bill of exchange` IS FALSE, `the instrument is a certificate of deposit issued by a bank or finance company, whether situated in Singapore or elsewhere` IS FALSE, `the Authority has prescribed the instrument, or its class, as not being securities` IS FALSE) EQUALS JUST FALSE
-- an exclusion alone: the instrument is a bill of exchange
#ASSERT (`s 2(1) "securities" the instrument is securities` WITH `the instrument is a share` IS FALSE, `the instrument is a unit in a business trust` IS FALSE, `the instrument confers or represents a legal or beneficial ownership interest in a corporation, partnership or limited liability partnership` IS FALSE, `the instrument is a debenture` IS FALSE, `the Authority has prescribed the instrument, or its class, as securities` IS FALSE, `the instrument is a unit of a collective investment scheme` IS FALSE, `the instrument is a bill of exchange` IS TRUE, `the instrument is a certificate of deposit issued by a bank or finance company, whether situated in Singapore or elsewhere` IS FALSE, `the Authority has prescribed the instrument, or its class, as not being securities` IS FALSE) EQUALS JUST FALSE
-- an exclusion alone: the instrument is a certificate of deposit issued by a bank or finance company, whether situated in Singapore or elsewhere
#ASSERT (`s 2(1) "securities" the instrument is securities` WITH `the instrument is a share` IS FALSE, `the instrument is a unit in a business trust` IS FALSE, `the instrument confers or represents a legal or beneficial ownership interest in a corporation, partnership or limited liability partnership` IS FALSE, `the instrument is a debenture` IS FALSE, `the Authority has prescribed the instrument, or its class, as securities` IS FALSE, `the instrument is a unit of a collective investment scheme` IS FALSE, `the instrument is a bill of exchange` IS FALSE, `the instrument is a certificate of deposit issued by a bank or finance company, whether situated in Singapore or elsewhere` IS TRUE, `the Authority has prescribed the instrument, or its class, as not being securities` IS FALSE) EQUALS JUST FALSE
-- an exclusion alone: the Authority has prescribed the instrument, or its class, as not being securities
#ASSERT (`s 2(1) "securities" the instrument is securities` WITH `the instrument is a share` IS FALSE, `the instrument is a unit in a business trust` IS FALSE, `the instrument confers or represents a legal or beneficial ownership interest in a corporation, partnership or limited liability partnership` IS FALSE, `the instrument is a debenture` IS FALSE, `the Authority has prescribed the instrument, or its class, as securities` IS FALSE, `the instrument is a unit of a collective investment scheme` IS FALSE, `the instrument is a bill of exchange` IS FALSE, `the instrument is a certificate of deposit issued by a bank or finance company, whether situated in Singapore or elsewhere` IS FALSE, `the Authority has prescribed the instrument, or its class, as not being securities` IS TRUE) EQUALS JUST FALSE
-- a share that is also (somehow) a bill of exchange: the exclusion "does not include" governs
#ASSERT (`s 2(1) "securities" the instrument is securities` WITH `the instrument is a share` IS TRUE, `the instrument is a unit in a business trust` IS FALSE, `the instrument confers or represents a legal or beneficial ownership interest in a corporation, partnership or limited liability partnership` IS FALSE, `the instrument is a debenture` IS FALSE, `the Authority has prescribed the instrument, or its class, as securities` IS FALSE, `the instrument is a unit of a collective investment scheme` IS FALSE, `the instrument is a bill of exchange` IS TRUE, `the instrument is a certificate of deposit issued by a bank or finance company, whether situated in Singapore or elsewhere` IS FALSE, `the Authority has prescribed the instrument, or its class, as not being securities` IS FALSE) EQUALS JUST FALSE
-- no limb: the definition says "means"
#ASSERT (`s 2(1) "securities" the instrument is securities` WITH `the instrument is a share` IS FALSE, `the instrument is a unit in a business trust` IS FALSE, `the instrument confers or represents a legal or beneficial ownership interest in a corporation, partnership or limited liability partnership` IS FALSE, `the instrument is a debenture` IS FALSE, `the Authority has prescribed the instrument, or its class, as securities` IS FALSE, `the instrument is a unit of a collective investment scheme` IS FALSE, `the instrument is a bill of exchange` IS FALSE, `the instrument is a certificate of deposit issued by a bank or finance company, whether situated in Singapore or elsewhere` IS FALSE, `the Authority has prescribed the instrument, or its class, as not being securities` IS FALSE) EQUALS JUST FALSE

-- a derivatives contract on a security
#ASSERT `s 2(1) "securities-based derivatives contract" the contract is a securities-based derivatives contract` TRUE TRUE FALSE EQUALS JUST TRUE
-- a derivatives contract whose underlying thing is neither a security nor a securities index
#ASSERT `s 2(1) "securities-based derivatives contract" the contract is a securities-based derivatives contract` TRUE FALSE FALSE EQUALS JUST FALSE
-- not a derivatives contract at all
#ASSERT `s 2(1) "securities-based derivatives contract" the contract is a securities-based derivatives contract` FALSE TRUE FALSE EQUALS JUST FALSE
-- prescribed out by regulations under section 341
#ASSERT `s 2(1) "securities-based derivatives contract" the contract is a securities-based derivatives contract` TRUE TRUE TRUE EQUALS JUST FALSE

-- "specified products": the product is securities alone
#ASSERT `s 2(1) "specified products" the product is a specified product` TRUE FALSE FALSE EQUALS JUST TRUE
-- "specified products": the product is a specified securities-based derivatives contract alone
#ASSERT `s 2(1) "specified products" the product is a specified product` FALSE TRUE FALSE EQUALS JUST TRUE
-- "specified products": the product is a unit in a collective investment scheme alone
#ASSERT `s 2(1) "specified products" the product is a specified product` FALSE FALSE TRUE EQUALS JUST TRUE
-- none of the three: the definition says "means"
#ASSERT `s 2(1) "specified products" the product is a specified product` FALSE FALSE FALSE EQUALS JUST FALSE

-- a securities-based derivatives contract that is not a futures contract
#ASSERT `s 2(1) "specified securities-based derivatives contract" the contract is a specified securities-based derivatives contract` TRUE FALSE EQUALS JUST TRUE
-- a securities-based derivatives contract that is a futures contract
#ASSERT `s 2(1) "specified securities-based derivatives contract" the contract is a specified securities-based derivatives contract` TRUE TRUE EQUALS JUST FALSE
-- a futures contract that is not securities-based
#ASSERT `s 2(1) "specified securities-based derivatives contract" the contract is a specified securities-based derivatives contract` FALSE TRUE EQUALS JUST FALSE
-- neither
#ASSERT `s 2(1) "specified securities-based derivatives contract" the contract is a specified securities-based derivatives contract` FALSE FALSE EQUALS JUST FALSE

-- delivery in exactly the market-convention period (2 days): "must not be longer than"
#ASSERT (`s 2(1) "spot contract" the contract or arrangement is a spot contract` WITH `the contract or arrangement is for the sale or purchase of an underlying thing at the spot price` IS TRUE, `it is intended for a party to take delivery of the underlying thing` IS TRUE, `the number of days within which delivery is intended to be taken (0 if immediately)` IS 2, `the number of days the market convention allows for delivery of the underlying thing` IS 2) EQUALS JUST TRUE
-- one day longer than the market convention
#ASSERT (`s 2(1) "spot contract" the contract or arrangement is a spot contract` WITH `the contract or arrangement is for the sale or purchase of an underlying thing at the spot price` IS TRUE, `it is intended for a party to take delivery of the underlying thing` IS TRUE, `the number of days within which delivery is intended to be taken (0 if immediately)` IS 3, `the number of days the market convention allows for delivery of the underlying thing` IS 2) EQUALS JUST FALSE
-- delivery immediately
#ASSERT (`s 2(1) "spot contract" the contract or arrangement is a spot contract` WITH `the contract or arrangement is for the sale or purchase of an underlying thing at the spot price` IS TRUE, `it is intended for a party to take delivery of the underlying thing` IS TRUE, `the number of days within which delivery is intended to be taken (0 if immediately)` IS 0, `the number of days the market convention allows for delivery of the underlying thing` IS 2) EQUALS JUST TRUE
-- no party is intended to take delivery
#ASSERT (`s 2(1) "spot contract" the contract or arrangement is a spot contract` WITH `the contract or arrangement is for the sale or purchase of an underlying thing at the spot price` IS TRUE, `it is intended for a party to take delivery of the underlying thing` IS FALSE, `the number of days within which delivery is intended to be taken (0 if immediately)` IS 0, `the number of days the market convention allows for delivery of the underlying thing` IS 2) EQUALS JUST FALSE
-- not at the spot price
#ASSERT (`s 2(1) "spot contract" the contract or arrangement is a spot contract` WITH `the contract or arrangement is for the sale or purchase of an underlying thing at the spot price` IS FALSE, `it is intended for a party to take delivery of the underlying thing` IS TRUE, `the number of days within which delivery is intended to be taken (0 if immediately)` IS 0, `the number of days the market convention allows for delivery of the underlying thing` IS 2) EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "spot foreign exchange contract" the contract is a spot foreign exchange contract` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "has the meaning given in the Second Schedule"
#ASSERT `s 2(1) "spot foreign exchange contract" the contract is a spot foreign exchange contract` FALSE EQUALS JUST FALSE

-- underlying thing (a): the thing is a unit in a collective investment scheme alone
#ASSERT (`s 2(1) "underlying thing" (a) the thing is an underlying thing in relation to a derivatives contract or a spot contract` WITH `the thing is a unit in a collective investment scheme` IS TRUE, `the thing is a commodity` IS FALSE, `the thing is a financial instrument` IS FALSE, `the thing is the credit of a person` IS FALSE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a derivatives contract or a spot contract` IS FALSE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a derivatives contract or a spot contract` IS FALSE) EQUALS JUST TRUE
-- underlying thing (a): the thing is a commodity alone
#ASSERT (`s 2(1) "underlying thing" (a) the thing is an underlying thing in relation to a derivatives contract or a spot contract` WITH `the thing is a unit in a collective investment scheme` IS FALSE, `the thing is a commodity` IS TRUE, `the thing is a financial instrument` IS FALSE, `the thing is the credit of a person` IS FALSE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a derivatives contract or a spot contract` IS FALSE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a derivatives contract or a spot contract` IS FALSE) EQUALS JUST TRUE
-- underlying thing (a): the thing is a financial instrument alone
#ASSERT (`s 2(1) "underlying thing" (a) the thing is an underlying thing in relation to a derivatives contract or a spot contract` WITH `the thing is a unit in a collective investment scheme` IS FALSE, `the thing is a commodity` IS FALSE, `the thing is a financial instrument` IS TRUE, `the thing is the credit of a person` IS FALSE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a derivatives contract or a spot contract` IS FALSE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a derivatives contract or a spot contract` IS FALSE) EQUALS JUST TRUE
-- underlying thing (a): the thing is the credit of a person alone
#ASSERT (`s 2(1) "underlying thing" (a) the thing is an underlying thing in relation to a derivatives contract or a spot contract` WITH `the thing is a unit in a collective investment scheme` IS FALSE, `the thing is a commodity` IS FALSE, `the thing is a financial instrument` IS FALSE, `the thing is the credit of a person` IS TRUE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a derivatives contract or a spot contract` IS FALSE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a derivatives contract or a spot contract` IS FALSE) EQUALS JUST TRUE
-- underlying thing (a): regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a derivatives contract or a spot contract alone
#ASSERT (`s 2(1) "underlying thing" (a) the thing is an underlying thing in relation to a derivatives contract or a spot contract` WITH `the thing is a unit in a collective investment scheme` IS FALSE, `the thing is a commodity` IS FALSE, `the thing is a financial instrument` IS FALSE, `the thing is the credit of a person` IS FALSE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a derivatives contract or a spot contract` IS TRUE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a derivatives contract or a spot contract` IS FALSE) EQUALS JUST TRUE
-- a commodity that regulations prescribe not to be an underlying thing: the exclusion governs
#ASSERT (`s 2(1) "underlying thing" (a) the thing is an underlying thing in relation to a derivatives contract or a spot contract` WITH `the thing is a unit in a collective investment scheme` IS FALSE, `the thing is a commodity` IS TRUE, `the thing is a financial instrument` IS FALSE, `the thing is the credit of a person` IS FALSE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a derivatives contract or a spot contract` IS FALSE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a derivatives contract or a spot contract` IS TRUE) EQUALS JUST FALSE
-- none of the five limbs: "means"
#ASSERT (`s 2(1) "underlying thing" (a) the thing is an underlying thing in relation to a derivatives contract or a spot contract` WITH `the thing is a unit in a collective investment scheme` IS FALSE, `the thing is a commodity` IS FALSE, `the thing is a financial instrument` IS FALSE, `the thing is the credit of a person` IS FALSE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a derivatives contract or a spot contract` IS FALSE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a derivatives contract or a spot contract` IS FALSE) EQUALS JUST FALSE

-- underlying thing (b): the thing is an investment product as defined in section 2(1) of the Financial Advisers Act 2001 alone
#ASSERT (`s 2(1) "underlying thing" (b) the thing is an underlying thing in relation to a financial benchmark` WITH `the thing is an investment product as defined in section 2(1) of the Financial Advisers Act 2001` IS TRUE, `the thing is a commodity` IS FALSE, `the thing is a financial instrument` IS FALSE, `the thing is intangible property or a class of intangible properties` IS FALSE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a financial benchmark` IS FALSE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a financial benchmark` IS FALSE) EQUALS JUST TRUE
-- underlying thing (b): the thing is a commodity alone
#ASSERT (`s 2(1) "underlying thing" (b) the thing is an underlying thing in relation to a financial benchmark` WITH `the thing is an investment product as defined in section 2(1) of the Financial Advisers Act 2001` IS FALSE, `the thing is a commodity` IS TRUE, `the thing is a financial instrument` IS FALSE, `the thing is intangible property or a class of intangible properties` IS FALSE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a financial benchmark` IS FALSE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a financial benchmark` IS FALSE) EQUALS JUST TRUE
-- underlying thing (b): the thing is a financial instrument alone
#ASSERT (`s 2(1) "underlying thing" (b) the thing is an underlying thing in relation to a financial benchmark` WITH `the thing is an investment product as defined in section 2(1) of the Financial Advisers Act 2001` IS FALSE, `the thing is a commodity` IS FALSE, `the thing is a financial instrument` IS TRUE, `the thing is intangible property or a class of intangible properties` IS FALSE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a financial benchmark` IS FALSE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a financial benchmark` IS FALSE) EQUALS JUST TRUE
-- underlying thing (b): the thing is intangible property or a class of intangible properties alone
#ASSERT (`s 2(1) "underlying thing" (b) the thing is an underlying thing in relation to a financial benchmark` WITH `the thing is an investment product as defined in section 2(1) of the Financial Advisers Act 2001` IS FALSE, `the thing is a commodity` IS FALSE, `the thing is a financial instrument` IS FALSE, `the thing is intangible property or a class of intangible properties` IS TRUE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a financial benchmark` IS FALSE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a financial benchmark` IS FALSE) EQUALS JUST TRUE
-- underlying thing (b): regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a financial benchmark alone
#ASSERT (`s 2(1) "underlying thing" (b) the thing is an underlying thing in relation to a financial benchmark` WITH `the thing is an investment product as defined in section 2(1) of the Financial Advisers Act 2001` IS FALSE, `the thing is a commodity` IS FALSE, `the thing is a financial instrument` IS FALSE, `the thing is intangible property or a class of intangible properties` IS FALSE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a financial benchmark` IS TRUE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a financial benchmark` IS FALSE) EQUALS JUST TRUE
-- a financial instrument that regulations prescribe not to be an underlying thing for a benchmark
#ASSERT (`s 2(1) "underlying thing" (b) the thing is an underlying thing in relation to a financial benchmark` WITH `the thing is an investment product as defined in section 2(1) of the Financial Advisers Act 2001` IS FALSE, `the thing is a commodity` IS FALSE, `the thing is a financial instrument` IS TRUE, `the thing is intangible property or a class of intangible properties` IS FALSE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a financial benchmark` IS FALSE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a financial benchmark` IS TRUE) EQUALS JUST FALSE
-- none of the five limbs: "means"
#ASSERT (`s 2(1) "underlying thing" (b) the thing is an underlying thing in relation to a financial benchmark` WITH `the thing is an investment product as defined in section 2(1) of the Financial Advisers Act 2001` IS FALSE, `the thing is a commodity` IS FALSE, `the thing is a financial instrument` IS FALSE, `the thing is intangible property or a class of intangible properties` IS FALSE, `regulations under section 341 prescribe the thing, or its class, to be an underlying thing in relation to a financial benchmark` IS FALSE, `regulations under section 341 prescribe the thing, or its class, not to be an underlying thing in relation to a financial benchmark` IS FALSE) EQUALS JUST FALSE

-- limb (a)
#ASSERT (`s 2(1) "commodity" the thing is a commodity` WITH `the thing is a produce, item, goods or article` IS TRUE, `the thing is an index, right or interest in a produce, item, goods or article` IS FALSE, `the thing is an index, right, interest, tangible property or intangible property that is, or belongs to a class that is, prescribed as a commodity` IS FALSE, `the thing is a produce, item, goods or article that is, or belongs to a class that is, prescribed not to be a commodity` IS FALSE, `the thing is an index, right or interest in a produce, item, goods or article that is, or belongs to a class that is, prescribed not to be a commodity` IS FALSE) EQUALS JUST TRUE
-- limb (b)
#ASSERT (`s 2(1) "commodity" the thing is a commodity` WITH `the thing is a produce, item, goods or article` IS FALSE, `the thing is an index, right or interest in a produce, item, goods or article` IS TRUE, `the thing is an index, right, interest, tangible property or intangible property that is, or belongs to a class that is, prescribed as a commodity` IS FALSE, `the thing is a produce, item, goods or article that is, or belongs to a class that is, prescribed not to be a commodity` IS FALSE, `the thing is an index, right or interest in a produce, item, goods or article that is, or belongs to a class that is, prescribed not to be a commodity` IS FALSE) EQUALS JUST TRUE
-- limb (c): prescribed
#ASSERT (`s 2(1) "commodity" the thing is a commodity` WITH `the thing is a produce, item, goods or article` IS FALSE, `the thing is an index, right or interest in a produce, item, goods or article` IS FALSE, `the thing is an index, right, interest, tangible property or intangible property that is, or belongs to a class that is, prescribed as a commodity` IS TRUE, `the thing is a produce, item, goods or article that is, or belongs to a class that is, prescribed not to be a commodity` IS FALSE, `the thing is an index, right or interest in a produce, item, goods or article that is, or belongs to a class that is, prescribed not to be a commodity` IS FALSE) EQUALS JUST TRUE
-- goods prescribed not to be a commodity: exclusion (d)
#ASSERT (`s 2(1) "commodity" the thing is a commodity` WITH `the thing is a produce, item, goods or article` IS TRUE, `the thing is an index, right or interest in a produce, item, goods or article` IS FALSE, `the thing is an index, right, interest, tangible property or intangible property that is, or belongs to a class that is, prescribed as a commodity` IS FALSE, `the thing is a produce, item, goods or article that is, or belongs to a class that is, prescribed not to be a commodity` IS TRUE, `the thing is an index, right or interest in a produce, item, goods or article that is, or belongs to a class that is, prescribed not to be a commodity` IS FALSE) EQUALS JUST FALSE
-- an index prescribed not to be a commodity: exclusion (e)
#ASSERT (`s 2(1) "commodity" the thing is a commodity` WITH `the thing is a produce, item, goods or article` IS FALSE, `the thing is an index, right or interest in a produce, item, goods or article` IS TRUE, `the thing is an index, right, interest, tangible property or intangible property that is, or belongs to a class that is, prescribed as a commodity` IS FALSE, `the thing is a produce, item, goods or article that is, or belongs to a class that is, prescribed not to be a commodity` IS FALSE, `the thing is an index, right or interest in a produce, item, goods or article that is, or belongs to a class that is, prescribed not to be a commodity` IS TRUE) EQUALS JUST FALSE
-- none of the limbs: "means"
#ASSERT (`s 2(1) "commodity" the thing is a commodity` WITH `the thing is a produce, item, goods or article` IS FALSE, `the thing is an index, right or interest in a produce, item, goods or article` IS FALSE, `the thing is an index, right, interest, tangible property or intangible property that is, or belongs to a class that is, prescribed as a commodity` IS FALSE, `the thing is a produce, item, goods or article that is, or belongs to a class that is, prescribed not to be a commodity` IS FALSE, `the thing is an index, right or interest in a produce, item, goods or article that is, or belongs to a class that is, prescribed not to be a commodity` IS FALSE) EQUALS JUST FALSE

-- "financial instrument" includes: the thing is a currency
#ASSERT (`s 2(1) "financial instrument" the thing is a financial instrument` WITH `the thing is a currency` IS TRUE, `the thing is a currency index` IS FALSE, `the thing is an interest rate` IS FALSE, `the thing is an interest rate instrument` IS FALSE, `the thing is an interest rate index` IS FALSE, `the thing is securities` IS FALSE, `the thing is a securities index` IS FALSE, `the thing is a group or groups of such financial instruments` IS FALSE, `the Authority has prescribed the thing by regulations under section 341 as a financial instrument` IS FALSE) EQUALS JUST TRUE
-- "financial instrument" includes: the thing is a currency index
