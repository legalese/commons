#ASSERT (`s 241(8)(b) the person making the offer has met one of the routes` (JUST FALSE) NOTHING (JUST FALSE)) EQUALS NOTHING

§ `s 241(9) to (11): despite the Companies Act, and the applicant who withdraws or returns`
#ASSERT (`s 241(9) the provision has effect despite sections 76 and 76A and Division 3A of Part 4 of the Companies Act 1967` TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(9) the provision has effect despite sections 76 and 76A and Division 3A of Part 4 of the Companies Act 1967` FALSE) EQUALS NOTHING
-- s 241(10) arguments: the applicant wishes to withdraw; the date of lodgment (6 March 2026); notified; the date of notification. 14 days after 6 March is 20 March.
#ASSERT (`s 241(10) the applicant has notified the person making the offer within 14 days` TRUE (Date 6 3 2026) TRUE (Date 20 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 241(10) the applicant has notified the person making the offer within 14 days` TRUE (Date 6 3 2026) TRUE (Date 21 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(10) the applicant has notified the person making the offer within 14 days` TRUE (Date 6 3 2026) FALSE (Date 10 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(10) the applicant has notified the person making the offer within 14 days` FALSE (Date 6 3 2026) FALSE (Date 10 3 2026)) EQUALS NOTHING
-- s 241(10) payment arguments: the applicant notified; the date the notification was received (9 March); paid; the date paid. 7 days after 9 March is 16 March.
#ASSERT (`s 241(10) the person making the offer has paid the applicant within 7 days from the receipt of the notification` TRUE (Date 9 3 2026) TRUE (Date 16 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 241(10) the person making the offer has paid the applicant within 7 days from the receipt of the notification` TRUE (Date 9 3 2026) TRUE (Date 17 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(10) the person making the offer has paid the applicant within 7 days from the receipt of the notification` TRUE (Date 9 3 2026) FALSE (Date 12 3 2026)) EQUALS JUST FALSE
-- "upon which": no notification, nothing was due (the rule for "upon", fork F18)
#ASSERT (`s 241(10) the person making the offer has paid the applicant within 7 days from the receipt of the notification` FALSE (Date 9 3 2026) FALSE (Date 12 3 2026)) EQUALS JUST FALSE
-- s 241(11) arguments: wishes to return; the date of lodgment; notified; the date notified; returned all title documents (yes if none); the date returned
#ASSERT (`s 241(11) the applicant has notified the person making the offer and returned the documents within 14 days` TRUE (Date 6 3 2026) TRUE (Date 20 3 2026) TRUE (Date 20 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 241(11) the applicant has notified the person making the offer and returned the documents within 14 days` TRUE (Date 6 3 2026) TRUE (Date 20 3 2026) TRUE (Date 21 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(11) the applicant has notified the person making the offer and returned the documents within 14 days` TRUE (Date 6 3 2026) TRUE (Date 21 3 2026) TRUE (Date 20 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(11) the applicant has notified the person making the offer and returned the documents within 14 days` TRUE (Date 6 3 2026) TRUE (Date 10 3 2026) FALSE (Date 10 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(11) the applicant has notified the person making the offer and returned the documents within 14 days` TRUE (Date 6 3 2026) FALSE (Date 10 3 2026) TRUE (Date 10 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(11) the applicant has notified the person making the offer and returned the documents within 14 days` FALSE (Date 6 3 2026) FALSE (Date 10 3 2026) FALSE (Date 10 3 2026)) EQUALS NOTHING
-- s 241(11) payment arguments: the applicant notified; the date the notification was received; the date the documents were received; paid; the date paid. The 7 days run from the later of the two receipts.
#ASSERT (`s 241(11) the person making the offer has paid the applicant within 7 days from the receipt of the notification and documents` TRUE (Date 9 3 2026) (Date 12 3 2026) TRUE (Date 19 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 241(11) the person making the offer has paid the applicant within 7 days from the receipt of the notification and documents` TRUE (Date 9 3 2026) (Date 12 3 2026) TRUE (Date 20 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(11) the person making the offer has paid the applicant within 7 days from the receipt of the notification and documents` TRUE (Date 12 3 2026) (Date 9 3 2026) TRUE (Date 19 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 241(11) the person making the offer has paid the applicant within 7 days from the receipt of the notification and documents` FALSE (Date 9 3 2026) (Date 9 3 2026) FALSE (Date 12 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(11) the issue of the securities or contracts is deemed to be void` TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(11) the issue of the securities or contracts is deemed to be void` FALSE) EQUALS NOTHING

