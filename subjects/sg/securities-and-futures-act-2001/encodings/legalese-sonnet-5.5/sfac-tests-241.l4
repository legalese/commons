#ASSERT (`s 241(8)(b) the person making the offer has met one of the routes` (JUST TRUE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 241(8)(b) the person making the offer has met one of the routes` (JUST FALSE) (JUST TRUE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 241(8)(b) the person making the offer has met one of the routes` (JUST FALSE) (JUST FALSE) (JUST TRUE)) EQUALS JUST TRUE
