IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfac-241`

-- Tests for sfac-241.l4 (s 241). Every expected value is written from the text of the Act (SFA2001.txt lines 39098 to 39579) before the code was run.
-- The arguments of a call are in the order of the function's GIVEN; a comment above a group names them.
-- Calendar: 6 March 2026 is a Friday; the second business day after it is Tuesday 10 March (Monday 9 March is a public holiday in the holiday cases, which moves it to Wednesday 11 March).

§ `s 241(1): the person may lodge`
-- arguments: registered; the offer has not yet closed; aware of a false or misleading statement; aware of an omission; aware of a new circumstance since lodgment; it would have been required by s 243 or s 246; materially adverse
#ASSERT (`s 241(1) the person making the offer may lodge a supplementary or replacement document` TRUE TRUE TRUE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(1) the person making the offer may lodge a supplementary or replacement document` TRUE TRUE FALSE TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(1) the person making the offer may lodge a supplementary or replacement document` TRUE TRUE FALSE FALSE TRUE TRUE TRUE) EQUALS JUST TRUE
-- (c) needs both (i) and (ii)
#ASSERT (`s 241(1) the person making the offer may lodge a supplementary or replacement document` TRUE TRUE FALSE FALSE TRUE FALSE TRUE) EQUALS NOTHING
-- the gate fails: the power is limited by its own wording, so the text does not say (NOTHING), not that the person may not
#ASSERT (`s 241(1) the person making the offer may lodge a supplementary or replacement document` FALSE TRUE TRUE FALSE FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 241(1) the person making the offer may lodge a supplementary or replacement document` TRUE FALSE TRUE FALSE FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 241(1) the person making the offer may lodge a supplementary or replacement document` TRUE TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 241(1) the person making the offer may lodge a supplementary or replacement document` TRUE TRUE FALSE FALSE FALSE FALSE TRUE) EQUALS NOTHING

§ `s 241(1A) to (1C): the base prospectus, and when an offer subsists`
-- arguments: the base prospectus is registered; the date it was registered; the date of the lodgment; intends to update; an offer is subsisting
#ASSERT (`s 241(1A) the person making the offer may lodge a supplementary or replacement document for a base prospectus or base profile statement` TRUE (Date 1 3 2026) (Date 1 3 2027) TRUE FALSE) EQUALS JUST TRUE
-- 24 months from 1 March 2026 end on 1 March 2028: the last day is in time, the next day is not
#ASSERT (`s 241(1A) the person making the offer may lodge a supplementary or replacement document for a base prospectus or base profile statement` TRUE (Date 1 3 2026) (Date 1 3 2028) TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 241(1A) the person making the offer may lodge a supplementary or replacement document for a base prospectus or base profile statement` TRUE (Date 1 3 2026) (Date 2 3 2028) TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 241(1A) the person making the offer may lodge a supplementary or replacement document for a base prospectus or base profile statement` FALSE (Date 1 3 2026) (Date 1 3 2027) TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 241(1A) the person making the offer may lodge a supplementary or replacement document for a base prospectus or base profile statement` TRUE (Date 1 3 2026) (Date 1 3 2027) FALSE FALSE) EQUALS NOTHING
-- "provided that no offer ... is subsisting": the grant is closed
#ASSERT (`s 241(1A) the person making the offer may lodge a supplementary or replacement document for a base prospectus or base profile statement` TRUE (Date 1 3 2026) (Date 1 3 2027) TRUE TRUE) EQUALS JUST FALSE
-- the gate fails and an offer is subsisting: the gate comes first
#ASSERT (`s 241(1A) the person making the offer may lodge a supplementary or replacement document for a base prospectus or base profile statement` FALSE (Date 1 3 2026) (Date 1 3 2027) TRUE TRUE) EQUALS NOTHING

#ASSERT (`s 241(1B) subsections (7) to (16) apply to the document` TRUE) EQUALS JUST FALSE
#ASSERT (`s 241(1B) subsections (7) to (16) apply to the document` FALSE) EQUALS NOTHING

-- arguments: a pricing statement has been registered under s 240A; the offer closed with no application received or accepted; applications received or accepted; listed or to be listed on an approved exchange; trading has commenced; all issued or sold
-- (a): no pricing statement registered
#ASSERT (`s 241(1C) the offer is not treated as subsisting` FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
-- (b)(i): registered, closed with no application
#ASSERT (`s 241(1C) the offer is not treated as subsisting` TRUE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
-- (b)(ii)(A): listed and trading has commenced
#ASSERT (`s 241(1C) the offer is not treated as subsisting` TRUE FALSE TRUE TRUE TRUE FALSE) EQUALS JUST TRUE
-- (b)(ii)(A) not met: listed, trading not commenced, even though all are issued: (B) is for "any other case"
#ASSERT (`s 241(1C) the offer is not treated as subsisting` TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- (b)(ii)(B): not listed, all issued or sold
#ASSERT (`s 241(1C) the offer is not treated as subsisting` TRUE FALSE TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(1C) the offer is not treated as subsisting` TRUE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- registered and not closed with no application: none of the limbs (reading (a): JUST FALSE)
#ASSERT (`s 241(1C) the offer is not treated as subsisting` TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE

§ `s 241(2) to (7): the document, and what the person must do`
-- s 241(2) arguments: a supplementary document; (a) statement that it is supplementary; (b) identification of what it supplements; (c) identification of any previous supplementary document; (d) read-together statement
#ASSERT (`s 241(2) the supplementary document begins as it must` TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(2) the supplementary document begins as it must` TRUE FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 241(2) the supplementary document begins as it must` TRUE TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 241(2) the supplementary document begins as it must` TRUE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 241(2) the supplementary document begins as it must` TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 241(2) the supplementary document begins as it must` FALSE TRUE TRUE TRUE TRUE) EQUALS NOTHING
-- s 241(3) arguments: a replacement document; (a) statement that it is a replacement; (b) identification of what it replaces
#ASSERT (`s 241(3) the replacement document begins as it must` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(3) the replacement document begins as it must` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 241(3) the replacement document begins as it must` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 241(3) the replacement document begins as it must` FALSE TRUE TRUE) EQUALS NOTHING
-- s 241(4) arguments: a supplementary or replacement document; the date it bears; the date it is lodged
#ASSERT (`s 241(4) the document is dated with the date on which it is lodged` TRUE (Date 6 3 2026) (Date 6 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 241(4) the document is dated with the date on which it is lodged` TRUE (Date 5 3 2026) (Date 6 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(4) the document is dated with the date on which it is lodged` FALSE (Date 6 3 2026) (Date 6 3 2026)) EQUALS NOTHING
-- s 241(5) arguments: a document has been lodged under (1) or (1A); reasonable steps to inform potential investors; reasonable steps to make it available
#ASSERT (`s 241(5) the person making the offer has taken the reasonable steps` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(5) the person making the offer has taken the reasonable steps` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 241(5) the person making the offer has taken the reasonable steps` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 241(5) the person making the offer has taken the reasonable steps` FALSE TRUE TRUE) EQUALS NOTHING
-- s 241(6)(a), (6)(b), (6B)(a), (6B)(b) arguments: the events occur after the lodgment; the document is of the kind the paragraph names
#ASSERT (`s 241(6)(a) the prospectus in relation to the offer is taken to be the original prospectus with the supplementary prospectus and any previous one` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(6)(a) the prospectus in relation to the offer is taken to be the original prospectus with the supplementary prospectus and any previous one` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 241(6)(a) the prospectus in relation to the offer is taken to be the original prospectus with the supplementary prospectus and any previous one` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 241(6)(b) the profile statement in relation to the offer is taken to be the original profile statement with the supplementary profile statement and any previous one` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(6)(b) the profile statement in relation to the offer is taken to be the original profile statement with the supplementary profile statement and any previous one` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 241(6B)(a) the prospectus in relation to the offer is taken to be the replacement prospectus` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(6B)(a) the prospectus in relation to the offer is taken to be the replacement prospectus` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 241(6B)(b) the profile statement in relation to the offer is taken to be the replacement profile statement` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(6B)(b) the profile statement in relation to the offer is taken to be the replacement profile statement` TRUE FALSE) EQUALS JUST FALSE
-- s 241(7) arguments: a document is lodged; the date of lodgment; the date until which the offer is kept open. 14 days after 6 March is 20 March.
#ASSERT (`s 241(7) the offer has been kept open for at least 14 days after the lodgment` TRUE (Date 6 3 2026) (Date 20 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 241(7) the offer has been kept open for at least 14 days after the lodgment` TRUE (Date 6 3 2026) (Date 19 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(7) the offer has been kept open for at least 14 days after the lodgment` TRUE (Date 6 3 2026) (Date 31 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 241(7) the offer has been kept open for at least 14 days after the lodgment` FALSE (Date 6 3 2026) (Date 6 3 2026)) EQUALS NOTHING

§ `s 241(8): applicants to subscribe`

-- s 241(8)(a): gate arguments: applications were made before the lodgment; the securities have not yet been issued/transferred
#ASSERT (`s 241(8)(a) the person making the offer is bound by paragraph (a)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(8)(a) the person making the offer is bound by paragraph (a)` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 241(8)(a) the person making the offer is bound by paragraph (a)` FALSE TRUE) EQUALS JUST FALSE
-- s 241(8)(a)(i): arguments: the date of lodgment (Friday 6 March 2026); gave written notice with the option; the date of the notice; the public holidays; took all reasonable steps
#ASSERT (`s 241(8)(a)(i) the person making the offer has given written notice with an option to withdraw their applications and made the document available` (Date 6 3 2026) TRUE (Date 10 3 2026) EMPTY TRUE) EQUALS JUST TRUE
-- the day of lodgment itself is in time (fork F9)
#ASSERT (`s 241(8)(a)(i) the person making the offer has given written notice with an option to withdraw their applications and made the document available` (Date 6 3 2026) TRUE (Date 6 3 2026) EMPTY TRUE) EQUALS JUST TRUE
-- the third business day is out; with Monday a public holiday the second business day is Wednesday 11 March
#ASSERT (`s 241(8)(a)(i) the person making the offer has given written notice with an option to withdraw their applications and made the document available` (Date 6 3 2026) TRUE (Date 11 3 2026) EMPTY TRUE) EQUALS JUST FALSE
#ASSERT (`s 241(8)(a)(i) the person making the offer has given written notice with an option to withdraw their applications and made the document available` (Date 6 3 2026) TRUE (Date 11 3 2026) (LIST (Date 9 3 2026)) TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(8)(a)(i) the person making the offer has given written notice with an option to withdraw their applications and made the document available` (Date 6 3 2026) TRUE (Date 12 3 2026) (LIST (Date 9 3 2026)) TRUE) EQUALS JUST FALSE
#ASSERT (`s 241(8)(a)(i) the person making the offer has given written notice with an option to withdraw their applications and made the document available` (Date 6 3 2026) FALSE (Date 10 3 2026) EMPTY TRUE) EQUALS JUST FALSE
#ASSERT (`s 241(8)(a)(i) the person making the offer has given written notice with an option to withdraw their applications and made the document available` (Date 6 3 2026) TRUE (Date 10 3 2026) EMPTY FALSE) EQUALS JUST FALSE
-- s 241(8)(a)(ii): arguments: the date of lodgment; gave the document with the option; the date it was given
#ASSERT (`s 241(8)(a)(ii) the person making the offer has given the document with an option to withdraw their applications` (Date 6 3 2026) TRUE (Date 13 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 241(8)(a)(ii) the person making the offer has given the document with an option to withdraw their applications` (Date 6 3 2026) TRUE (Date 14 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(8)(a)(ii) the person making the offer has given the document with an option to withdraw their applications` (Date 6 3 2026) FALSE (Date 10 3 2026)) EQUALS JUST FALSE
-- s 241(8)(a)(iii): arguments: the date of lodgment; the person treats the applications as withdrawn and cancelled; paid all moneys; the date paid
#ASSERT (`s 241(8)(a)(iii) the person making the offer has treated the applications as withdrawn and cancelled and paid all moneys` (Date 6 3 2026) TRUE TRUE (Date 13 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 241(8)(a)(iii) the person making the offer has treated the applications as withdrawn and cancelled and paid all moneys` (Date 6 3 2026) TRUE TRUE (Date 14 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(8)(a)(iii) the person making the offer has treated the applications as withdrawn and cancelled and paid all moneys` (Date 6 3 2026) FALSE TRUE (Date 10 3 2026)) EQUALS JUST FALSE
#ASSERT (`s 241(8)(a)(iii) the person making the offer has treated the applications as withdrawn and cancelled and paid all moneys` (Date 6 3 2026) TRUE FALSE (Date 10 3 2026)) EQUALS JUST FALSE
-- s 241(8)(a)(iii)(A): the deeming
#ASSERT (`s 241(8)(a)(iii)(A) the applications are deemed to have been withdrawn and cancelled` TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(8)(a)(iii)(A) the applications are deemed to have been withdrawn and cancelled` FALSE) EQUALS NOTHING
-- s 241(8)(a): the three route answers
#ASSERT (`s 241(8)(a) the person making the offer has met one of the routes` (JUST TRUE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 241(8)(a) the person making the offer has met one of the routes` (JUST FALSE) (JUST TRUE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 241(8)(a) the person making the offer has met one of the routes` (JUST FALSE) (JUST FALSE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 241(8)(a) the person making the offer has met one of the routes` NOTHING NOTHING (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 241(8)(a) the person making the offer has met one of the routes` (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 241(8)(a) the person making the offer has met one of the routes` (JUST FALSE) NOTHING (JUST FALSE)) EQUALS NOTHING

-- s 241(8)(b): gate arguments: applications were made before the lodgment; the securities have been issued/transferred
#ASSERT (`s 241(8)(b) the person making the offer is bound by paragraph (b)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 241(8)(b) the person making the offer is bound by paragraph (b)` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 241(8)(b) the person making the offer is bound by paragraph (b)` FALSE TRUE) EQUALS JUST FALSE
