-- a corporation the Authority has authorised
#ASSERT `s 2(1) "authorised benchmark administrator" the corporation is an authorised benchmark administrator` TRUE TRUE EQUALS JUST TRUE
-- the Authority has not
#ASSERT `s 2(1) "authorised benchmark administrator" the corporation is an authorised benchmark administrator` TRUE FALSE EQUALS JUST FALSE
-- not a corporation
#ASSERT `s 2(1) "authorised benchmark administrator" the corporation is an authorised benchmark administrator` FALSE TRUE EQUALS JUST FALSE

-- a corporation the Authority has authorised
#ASSERT `s 2(1) "authorised benchmark submitter" the corporation is an authorised benchmark submitter` TRUE TRUE EQUALS JUST TRUE
-- the Authority has not
#ASSERT `s 2(1) "authorised benchmark submitter" the corporation is an authorised benchmark submitter` TRUE FALSE EQUALS JUST FALSE
-- not a corporation
#ASSERT `s 2(1) "authorised benchmark submitter" the corporation is an authorised benchmark submitter` FALSE TRUE EQUALS JUST FALSE

-- a corporation the Authority has designated
#ASSERT `s 2(1) "designated benchmark submitter" the corporation is a designated benchmark submitter` TRUE TRUE EQUALS JUST TRUE
-- the Authority has not
#ASSERT `s 2(1) "designated benchmark submitter" the corporation is a designated benchmark submitter` TRUE FALSE EQUALS JUST FALSE
-- not a corporation
#ASSERT `s 2(1) "designated benchmark submitter" the corporation is a designated benchmark submitter` FALSE TRUE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "exempt benchmark administrator" the person is an exempt benchmark administrator` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "means a person who is exempted under section 123K(1) from the requirement to be an authorised benchmark administrator"
#ASSERT `s 2(1) "exempt benchmark administrator" the person is an exempt benchmark administrator` FALSE EQUALS JUST FALSE

-- the borrowed test is met: the text equates the term with it
#ASSERT `s 2(1) "exempt benchmark submitter" the person is an exempt benchmark submitter` TRUE EQUALS JUST TRUE
-- the borrowed test is not met: "means a person who is exempted under section 123ZH(1) from the requirement to be an authorised benchmark submitter"
#ASSERT `s 2(1) "exempt benchmark submitter" the person is an exempt benchmark submitter` FALSE EQUALS JUST FALSE

-- (a)(iii)(A): used to determine interest on deposits or credit facilities
#ASSERT (`s 2(1) "financial benchmark" the price, rate, index or value is a financial benchmark` WITH `it is determined periodically by applying a formula or other method of calculation to information or expressions of opinion concerning transactions in, or the state of, the market in respect of one or more underlying things` IS TRUE, `it is made available to the public, free of charge or for payment` IS TRUE, `it is used for reference to determine the interest payable or other sums due on deposits or credit facilities` IS TRUE, `it is used for reference to determine the price or value of an investment product as defined in section 2(1) of the Financial Advisers Act 2001` IS FALSE, `it is used for reference to measure the performance of a product offered by a person, or a class of persons, prescribed by regulations under section 341` IS FALSE, `regulations under section 341 prescribe it as a financial benchmark` IS FALSE, `it is determined by or on behalf of the Government or a statutory body established under an Act` IS FALSE, `it is determined by a person and intended for that person's exclusive use in transactions or agreements entered or to be entered into by that person` IS FALSE, `it is the price of a capital markets product` IS FALSE, `regulations under section 341 prescribe it as not being a financial benchmark` IS FALSE) EQUALS JUST TRUE
-- (a)(iii)(B): used to price an investment product
#ASSERT (`s 2(1) "financial benchmark" the price, rate, index or value is a financial benchmark` WITH `it is determined periodically by applying a formula or other method of calculation to information or expressions of opinion concerning transactions in, or the state of, the market in respect of one or more underlying things` IS TRUE, `it is made available to the public, free of charge or for payment` IS TRUE, `it is used for reference to determine the interest payable or other sums due on deposits or credit facilities` IS FALSE, `it is used for reference to determine the price or value of an investment product as defined in section 2(1) of the Financial Advisers Act 2001` IS TRUE, `it is used for reference to measure the performance of a product offered by a person, or a class of persons, prescribed by regulations under section 341` IS FALSE, `regulations under section 341 prescribe it as a financial benchmark` IS FALSE, `it is determined by or on behalf of the Government or a statutory body established under an Act` IS FALSE, `it is determined by a person and intended for that person's exclusive use in transactions or agreements entered or to be entered into by that person` IS FALSE, `it is the price of a capital markets product` IS FALSE, `regulations under section 341 prescribe it as not being a financial benchmark` IS FALSE) EQUALS JUST TRUE
