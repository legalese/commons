-- a financial benchmark designated under section 123B
#ASSERT `s 2(1) "designated benchmark" the benchmark is a designated benchmark` TRUE TRUE EQUALS JUST TRUE
-- not designated
#ASSERT `s 2(1) "designated benchmark" the benchmark is a designated benchmark` TRUE FALSE EQUALS JUST FALSE
-- not a financial benchmark
#ASSERT `s 2(1) "designated benchmark" the benchmark is a designated benchmark` FALSE TRUE EQUALS JUST FALSE

-- (a) and (b)
#ASSERT `s 2(1) "providing information in relation to a designated benchmark" the act is providing information in relation to a designated benchmark` TRUE TRUE EQUALS JUST TRUE
-- (b) missing: it does not enable A to determine the benchmark
#ASSERT `s 2(1) "providing information in relation to a designated benchmark" the act is providing information in relation to a designated benchmark` TRUE FALSE EQUALS JUST FALSE
-- (a) missing
#ASSERT `s 2(1) "providing information in relation to a designated benchmark" the act is providing information in relation to a designated benchmark` FALSE TRUE EQUALS JUST FALSE

-- (a) and (b)
#ASSERT `s 2(1) "providing information in relation to a financial benchmark" the act is providing information in relation to a financial benchmark` TRUE TRUE EQUALS JUST TRUE
-- (b) missing: it does not enable A to determine the benchmark
#ASSERT `s 2(1) "providing information in relation to a financial benchmark" the act is providing information in relation to a financial benchmark` TRUE FALSE EQUALS JUST FALSE
-- (a) missing
#ASSERT `s 2(1) "providing information in relation to a financial benchmark" the act is providing information in relation to a financial benchmark` FALSE TRUE EQUALS JUST FALSE
