IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfac-253`

-- Tests for sfac-253.l4 (ss 253, 254, 255; s 256 is repealed). Every expected value is written from the text of the Act (SFA2001.txt lines 40971 to 41375) before the code was run.
-- The arguments of a call are in the order of the function's GIVEN; a comment above a group names them.

§ `s 253(1) to (3): the facts, the deeming and the safe harbour`
-- arguments: an offer is made in or with a prospectus or profile statement; the offer is an offer referred to in section 280; a prospectus or profile statement is prepared and issued in relation to the offer; (a) a false or misleading statement; (b) an omission of required information; (c)(i) an omission of a new circumstance; (c)(ii) it would have been required
#ASSERT (`s 253(1) the false or misleading statement or omission is present` TRUE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 253(1) the false or misleading statement or omission is present` TRUE FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
-- a new circumstance that would have been required
#ASSERT (`s 253(1) the false or misleading statement or omission is present` TRUE FALSE FALSE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
-- a new circumstance that would not have been required is none of (a), (b), (c)
#ASSERT (`s 253(1) the false or misleading statement or omission is present` TRUE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE
-- an offer of section 280 with a prospectus prepared and issued
#ASSERT (`s 253(1) the false or misleading statement or omission is present` FALSE TRUE TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
-- the "Where" block fails (periods ruling, rule (b))
#ASSERT (`s 253(1) the false or misleading statement or omission is present` FALSE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 253(1) the false or misleading statement or omission is present` TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- an offer of section 280 with no prospectus prepared and issued: the "Where" block fails
#ASSERT (`s 253(1) the false or misleading statement or omission is present` FALSE TRUE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- arguments: the statement is about a future matter; the person made it; the person had reasonable grounds
-- made without reasonable grounds
#ASSERT (`s 253(2) a false or misleading statement about a future matter is taken to have been made` TRUE TRUE FALSE) EQUALS JUST TRUE
-- a deeming "if": silent when unmet
#ASSERT (`s 253(2) a false or misleading statement about a future matter is taken to have been made` TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 253(2) a false or misleading statement about a future matter is taken to have been made` FALSE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 253(2) a false or misleading statement about a future matter is taken to have been made` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 253(3) the person does not contravene subsection (1)` TRUE) EQUALS JUST TRUE
#ASSERT (`s 253(3) the person does not contravene subsection (1)` FALSE) EQUALS NOTHING

§ `s 253(4): the persons guilty`
-- (b) arguments: the person making the offer is an entity; the person is a director or equivalent; the entity is also the issuer; the person is named as a proposed director
#ASSERT (`s 253(4)(b) the person is a director or proposed director of the entity making the offer` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 253(4)(b) the person is a director or proposed director of the entity making the offer` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
-- named as a proposed director, but the entity is not also the issuer
#ASSERT (`s 253(4)(b) the person is a director or proposed director of the entity making the offer` TRUE FALSE FALSE TRUE) EQUALS NOTHING
-- the "where" gate fails
#ASSERT (`s 253(4)(b) the person is a director or proposed director of the entity making the offer` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 253(4)(b) the person is a director or proposed director of the entity making the offer` TRUE FALSE FALSE FALSE) EQUALS NOTHING
-- (c) arguments: the issuer is controlled; the person is the issuer; a director of the issuer; named as a proposed director of the issuer
#ASSERT (`s 253(4)(c) the person is the issuer or a director or proposed director of the issuer` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 253(4)(c) the person is the issuer or a director or proposed director of the issuer` TRUE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 253(4)(c) the person is the issuer or a director or proposed director of the issuer` TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 253(4)(c) the person is the issuer or a director or proposed director of the issuer` TRUE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 253(4)(c) the person is the issuer or a director or proposed director of the issuer` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
-- (d), (e) arguments: the person is the issue manager (underwriter) named with consent; intentionally or recklessly makes it; knows and fails remedial action; is reckless
#ASSERT (`s 253(4)(d) the issue manager is one of the persons guilty` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 253(4)(d) the issue manager is one of the persons guilty` TRUE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 253(4)(d) the issue manager is one of the persons guilty` TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 253(4)(d) the issue manager is one of the persons guilty` TRUE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 253(4)(d) the issue manager is one of the persons guilty` FALSE TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 253(4)(e) the underwriter is one of the persons guilty` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 253(4)(e) the underwriter is one of the persons guilty` TRUE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 253(4)(e) the underwriter is one of the persons guilty` TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 253(4)(e) the underwriter is one of the persons guilty` TRUE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 253(4)(e) the underwriter is one of the persons guilty` FALSE TRUE TRUE TRUE) EQUALS NOTHING
-- (f) arguments: named as having made the false statement; intentionally or recklessly makes it; named as having made the statement it is based on; knows and fails to withdraw consent; in respect of the inclusion
#ASSERT (`s 253(4)(f) the person named as having made a statement is one of the persons guilty` TRUE TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 253(4)(f) the person named as having made a statement is one of the persons guilty` FALSE FALSE TRUE TRUE TRUE) EQUALS JUST TRUE
-- "but only in respect of the inclusion"
#ASSERT (`s 253(4)(f) the person named as having made a statement is one of the persons guilty` TRUE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 253(4)(f) the person named as having made a statement is one of the persons guilty` TRUE FALSE FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 253(4)(f) the person named as having made a statement is one of the persons guilty` TRUE FALSE TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 253(4)(f) the person named as having made a statement is one of the persons guilty` FALSE FALSE TRUE FALSE TRUE) EQUALS NOTHING
-- (g) arguments: intentionally or recklessly makes the statement or omits; in respect of the inclusion or the omission
#ASSERT (`s 253(4)(g) any other person is one of the persons guilty` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 253(4)(g) any other person is one of the persons guilty` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 253(4)(g) any other person is one of the persons guilty` FALSE TRUE) EQUALS NOTHING
-- the combiner: the person making the offer; (b); (c); (d); (e); (f); (g)
#ASSERT (`s 253(4) the person is one of the persons guilty of the offence` TRUE NOTHING NOTHING NOTHING NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 253(4) the person is one of the persons guilty of the offence` FALSE (JUST TRUE) NOTHING NOTHING NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 253(4) the person is one of the persons guilty of the offence` FALSE NOTHING (JUST TRUE) NOTHING NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 253(4) the person is one of the persons guilty of the offence` FALSE NOTHING NOTHING (JUST TRUE) NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 253(4) the person is one of the persons guilty of the offence` FALSE NOTHING NOTHING NOTHING (JUST TRUE) NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 253(4) the person is one of the persons guilty of the offence` FALSE NOTHING NOTHING NOTHING NOTHING (JUST TRUE) NOTHING) EQUALS JUST TRUE
#ASSERT (`s 253(4) the person is one of the persons guilty of the offence` FALSE NOTHING NOTHING NOTHING NOTHING NOTHING (JUST TRUE)) EQUALS JUST TRUE
-- the list is not closed with "only"
#ASSERT (`s 253(4) the person is one of the persons guilty of the offence` FALSE NOTHING NOTHING NOTHING NOTHING NOTHING NOTHING) EQUALS NOTHING
#ASSERT (`s 253(4) the person is one of the persons guilty of the offence` FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS NOTHING

§ `s 253(1): the offence`
-- arguments: what s 253(1) answers; what s 253(3) answers; what s 253(4) answers; what s 255 answers
#ASSERT (`s 253(1) the person is guilty of an offence` (JUST TRUE) NOTHING (JUST TRUE) NOTHING) EQUALS JUST TRUE
#ASSERT (`s 253(1) the person is guilty of an offence` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE)) EQUALS JUST TRUE
-- the "Where" block fails
#ASSERT (`s 253(1) the person is guilty of an offence` (JUST FALSE) NOTHING (JUST TRUE) NOTHING) EQUALS JUST FALSE
-- "A person does not contravene subsection (1) if" not materially adverse
#ASSERT (`s 253(1) the person is guilty of an offence` (JUST TRUE) (JUST TRUE) (JUST TRUE) NOTHING) EQUALS JUST FALSE
-- a defence under section 255 is proved
#ASSERT (`s 253(1) the person is guilty of an offence` (JUST TRUE) NOTHING (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
-- the persons of subsection (4) are the only ones the text names (SPLIT-SITE (i))
#ASSERT (`s 253(1) the person is guilty of an offence` (JUST TRUE) NOTHING NOTHING NOTHING) EQUALS NOTHING
#ASSERT (`s 253(1) the person is guilty of an offence` (JUST TRUE) NOTHING (JUST FALSE) NOTHING) EQUALS NOTHING
#ASSERT (`s 253(1) the person is guilty of an offence` NOTHING NOTHING (JUST TRUE) NOTHING) EQUALS NOTHING
#ASSERT (`s 253(1) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 150000
#ASSERT (`s 253(1) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 24
#ASSERT (`s 253(1) the penalty for the offence`'s `penalty: the text allows both the fine and the imprisonment`) EQUALS TRUE
#ASSERT (`s 253(1) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 15000

§ `s 253(5) and (6): remedial action, reckless, includes`
#ASSERT (`s 253(5)(a) the action is remedial action` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 253(5)(a) the action is remedial action` FALSE TRUE) EQUALS JUST TRUE
-- "includes"
#ASSERT (`s 253(5)(a) the action is remedial action` FALSE FALSE) EQUALS NOTHING
-- (b) arguments: put upon inquiry; made all reasonable inquiries; took appropriate remedial action without delay; remedial action was warranted by the outcome
-- put upon inquiry and made none
#ASSERT (`s 253(5)(b) the person is reckless` TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
-- inquired, action warranted, none taken
#ASSERT (`s 253(5)(b) the person is reckless` TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 253(5)(b) the person is reckless` TRUE TRUE TRUE TRUE) EQUALS NOTHING
-- action not warranted
#ASSERT (`s 253(5)(b) the person is reckless` TRUE TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 253(5)(b) the person is reckless` FALSE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 253(6) the item is a statement for the purposes of this section` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 253(6) the item is a statement for the purposes of this section` FALSE TRUE) EQUALS JUST TRUE
-- an "includes" does not close the list
#ASSERT (`s 253(6) the item is a statement for the purposes of this section` FALSE FALSE) EQUALS NOTHING

§ `s 254(1) to (3): the facts, the deeming and the persons liable`
-- arguments: an offer is made in or with a prospectus or profile statement; the offer is an offer referred to in section 280; a prospectus or profile statement is prepared and issued in relation to the offer; (a) a false or misleading statement; (b) an omission of required information; (c)(i) an omission of a new circumstance; (c)(ii) it would have been required
#ASSERT (`s 254(1) the false or misleading statement or omission is present` TRUE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 254(1) the false or misleading statement or omission is present` TRUE FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
-- a new circumstance that would have been required
#ASSERT (`s 254(1) the false or misleading statement or omission is present` TRUE FALSE FALSE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
-- a new circumstance that would not have been required is none of (a), (b), (c)
#ASSERT (`s 254(1) the false or misleading statement or omission is present` TRUE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE
-- an offer of section 280 with a prospectus prepared and issued
#ASSERT (`s 254(1) the false or misleading statement or omission is present` FALSE TRUE TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
-- the "Where" block fails (periods ruling, rule (b))
#ASSERT (`s 254(1) the false or misleading statement or omission is present` FALSE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 254(1) the false or misleading statement or omission is present` TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- an offer of section 280 with no prospectus prepared and issued: the "Where" block fails
#ASSERT (`s 254(1) the false or misleading statement or omission is present` FALSE TRUE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
-- arguments: the statement is about a future matter; the person made it; the person had reasonable grounds
-- made without reasonable grounds
#ASSERT (`s 254(2) a false or misleading statement about a future matter is taken to have been made` TRUE TRUE FALSE) EQUALS JUST TRUE
-- a deeming "if": silent when unmet
#ASSERT (`s 254(2) a false or misleading statement about a future matter is taken to have been made` TRUE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 254(2) a false or misleading statement about a future matter is taken to have been made` FALSE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 254(2) a false or misleading statement about a future matter is taken to have been made` TRUE FALSE FALSE) EQUALS NOTHING
-- (b), (c): as for section 253(4)
#ASSERT (`s 254(3)(b) the person is a director or proposed director of the entity making the offer` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 254(3)(b) the person is a director or proposed director of the entity making the offer` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 254(3)(b) the person is a director or proposed director of the entity making the offer` TRUE FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 254(3)(b) the person is a director or proposed director of the entity making the offer` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 254(3)(c) the person is the issuer or a director or proposed director of the issuer` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 254(3)(c) the person is the issuer or a director or proposed director of the issuer` TRUE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 254(3)(c) the person is the issuer or a director or proposed director of the issuer` TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 254(3)(c) the person is the issuer or a director or proposed director of the issuer` TRUE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 254(3)(c) the person is the issuer or a director or proposed director of the issuer` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 254(3)(d) the issue manager is one of the persons liable` TRUE) EQUALS JUST TRUE
#ASSERT (`s 254(3)(d) the issue manager is one of the persons liable` FALSE) EQUALS NOTHING
#ASSERT (`s 254(3)(da) the underwriter is one of the persons liable` TRUE) EQUALS JUST TRUE
#ASSERT (`s 254(3)(da) the underwriter is one of the persons liable` FALSE) EQUALS NOTHING
-- (e) arguments: named with consent as having made the statement or the statement it is based on; in respect of the inclusion of that statement
#ASSERT (`s 254(3)(e) the person named as having made a statement is one of the persons liable` TRUE TRUE) EQUALS JUST TRUE
-- "but only in respect of the inclusion of that statement"
#ASSERT (`s 254(3)(e) the person named as having made a statement is one of the persons liable` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 254(3)(e) the person named as having made a statement is one of the persons liable` FALSE TRUE) EQUALS NOTHING
-- (f) arguments: made the false statement or omitted; in respect of the inclusion or the omission
#ASSERT (`s 254(3)(f) any other person is one of the persons liable` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 254(3)(f) any other person is one of the persons liable` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 254(3)(f) any other person is one of the persons liable` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 254(3) the person is one of the persons liable` TRUE NOTHING NOTHING NOTHING NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 254(3) the person is one of the persons liable` FALSE (JUST TRUE) NOTHING NOTHING NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 254(3) the person is one of the persons liable` FALSE NOTHING (JUST TRUE) NOTHING NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 254(3) the person is one of the persons liable` FALSE NOTHING NOTHING (JUST TRUE) NOTHING NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 254(3) the person is one of the persons liable` FALSE NOTHING NOTHING NOTHING (JUST TRUE) NOTHING NOTHING) EQUALS JUST TRUE
#ASSERT (`s 254(3) the person is one of the persons liable` FALSE NOTHING NOTHING NOTHING NOTHING (JUST TRUE) NOTHING) EQUALS JUST TRUE
#ASSERT (`s 254(3) the person is one of the persons liable` FALSE NOTHING NOTHING NOTHING NOTHING NOTHING (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 254(3) the person is one of the persons liable` FALSE NOTHING NOTHING NOTHING NOTHING NOTHING NOTHING) EQUALS NOTHING
#ASSERT (`s 254(3) the person is one of the persons liable` FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS NOTHING

§ `s 254(1): the liability`
-- arguments: what s 254(1) answers; what s 254(3) answers; the claimant suffers loss or damage as a result; what s 255 answers
#ASSERT (`s 254(1) the person is liable to compensate the claimant` (JUST TRUE) (JUST TRUE) TRUE NOTHING) EQUALS JUST TRUE
-- no loss or damage shown: the text says liable "to compensate any person who suffers loss or damage"
#ASSERT (`s 254(1) the person is liable to compensate the claimant` (JUST TRUE) (JUST TRUE) FALSE NOTHING) EQUALS NOTHING
-- the "Where" block fails
#ASSERT (`s 254(1) the person is liable to compensate the claimant` (JUST FALSE) (JUST TRUE) TRUE NOTHING) EQUALS JUST FALSE
-- a defence under section 255
#ASSERT (`s 254(1) the person is liable to compensate the claimant` (JUST TRUE) (JUST TRUE) TRUE (JUST TRUE)) EQUALS JUST FALSE
-- the person is not shown to be one of those in subsection (3)
#ASSERT (`s 254(1) the person is liable to compensate the claimant` (JUST TRUE) NOTHING TRUE NOTHING) EQUALS NOTHING
#ASSERT (`s 254(1) the person is liable to compensate the claimant` (JUST TRUE) (JUST FALSE) TRUE NOTHING) EQUALS NOTHING
#ASSERT (`s 254(4) the person is taken to have acquired in reliance on both the profile statement and the prospectus` TRUE) EQUALS JUST TRUE
#ASSERT (`s 254(4) the person is taken to have acquired in reliance on both the profile statement and the prospectus` FALSE) EQUALS NOTHING
#ASSERT (`s 254(4A) the item is a statement for the purposes of this section` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 254(4A) the item is a statement for the purposes of this section` FALSE TRUE) EQUALS JUST TRUE
-- an "includes" does not close the list
#ASSERT (`s 254(4A) the item is a statement for the purposes of this section` FALSE FALSE) EQUALS NOTHING
-- s 254(5) arguments: the date the cause of action arose (2 March 2026); the date the action is commenced
-- the last day of the 6 years is 2 March 2032
#ASSERT (`s 254(5) the action may not be commenced` (Date 2 3 2026) (Date 2 3 2032)) EQUALS JUST FALSE
-- after the expiration of 6 years
#ASSERT (`s 254(5) the action may not be commenced` (Date 2 3 2026) (Date 3 3 2032)) EQUALS JUST TRUE
#ASSERT (`s 254(5) the action may not be commenced` (Date 2 3 2026) (Date 1 1 2030)) EQUALS JUST FALSE
#ASSERT (`s 254(6) this section affects a liability under another law` TRUE) EQUALS JUST FALSE
#ASSERT (`s 254(6) this section affects a liability under another law` FALSE) EQUALS NOTHING

§ `s 255: defences`
-- (1) arguments: the person is one of the persons the text names, under the matching section; the liability is only because of the statement; proves all reasonable inquiries; proves a belief on reasonable grounds
#ASSERT (`s 255(1) this section gives a defence for the false or misleading statement` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
-- this section gives no defence on these facts
#ASSERT (`s 255(1) this section gives a defence for the false or misleading statement` TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 255(1) this section gives a defence for the false or misleading statement` TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- liable on some other ground: outside the paragraph
#ASSERT (`s 255(1) this section gives a defence for the false or misleading statement` TRUE FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 255(1) this section gives a defence for the false or misleading statement` FALSE TRUE TRUE TRUE) EQUALS NOTHING
-- (2) arguments: the person is one of the persons the text names, under the matching section; the liability is only because of the omission; proves all reasonable inquiries; proves a belief on reasonable grounds
#ASSERT (`s 255(2) this section gives a defence for the omission` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
-- this section gives no defence on these facts
#ASSERT (`s 255(2) this section gives a defence for the omission` TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 255(2) this section gives a defence for the omission` TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
-- liable on some other ground: outside the paragraph
#ASSERT (`s 255(2) this section gives a defence for the omission` TRUE FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 255(2) this section gives a defence for the omission` FALSE TRUE TRUE TRUE) EQUALS NOTHING
-- (3) arguments: the liability is only because of the statement or omission; the person is an entity; is an individual; proves reasonable reliance; the informant is a director or equivalent; an employee or agent of the entity; an employee or agent of the individual
#ASSERT (`s 255(3) this section gives a defence for reasonable reliance on information` TRUE TRUE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 255(3) this section gives a defence for reasonable reliance on information` TRUE TRUE FALSE TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 255(3) this section gives a defence for reasonable reliance on information` TRUE TRUE FALSE TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 255(3) this section gives a defence for reasonable reliance on information` TRUE FALSE TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 255(3) this section gives a defence for reasonable reliance on information` TRUE FALSE TRUE TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 255(3) this section gives a defence for reasonable reliance on information` TRUE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 255(3) this section gives a defence for reasonable reliance on information` FALSE TRUE FALSE TRUE FALSE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 255(4) the person is an agent of the entity or individual` TRUE) EQUALS JUST FALSE
#ASSERT (`s 255(4) the person is an agent of the entity or individual` FALSE) EQUALS NOTHING
-- (5) arguments: the person is named in one of the three ways; the liability is only because of the statement or omission; proves the public withdrawal of consent
#ASSERT (`s 255(5) this section gives a defence for publicly withdrawing consent` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 255(5) this section gives a defence for publicly withdrawing consent` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 255(5) this section gives a defence for publicly withdrawing consent` FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 255(5) this section gives a defence for publicly withdrawing consent` TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 255(6) this section gives a defence for not being aware of a new circumstance` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 255(6) this section gives a defence for not being aware of a new circumstance` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 255(6) this section gives a defence for not being aware of a new circumstance` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 255(7) the item is a statement for the purposes of this section` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 255(7) the item is a statement for the purposes of this section` FALSE TRUE) EQUALS JUST TRUE
-- an "includes" does not close the list
#ASSERT (`s 255(7) the item is a statement for the purposes of this section` FALSE FALSE) EQUALS NOTHING
-- the combiner: (1), (2), (3), (5), (6)
#ASSERT (`s 255 the person has a defence` NOTHING NOTHING NOTHING NOTHING NOTHING) EQUALS NOTHING
-- this section gives no defence on these facts
#ASSERT (`s 255 the person has a defence` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 255 the person has a defence` (JUST FALSE) (JUST FALSE) (JUST FALSE) NOTHING (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 255 the person has a defence` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 255 the person has a defence` (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 255 the person has a defence` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 255 the person has a defence` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 255 the person has a defence` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST TRUE)) EQUALS JUST TRUE

