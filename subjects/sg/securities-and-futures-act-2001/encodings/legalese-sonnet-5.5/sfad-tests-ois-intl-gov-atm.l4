-- MODULES sfad-ois-intl-gov-atm
IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-periods`
IMPORT `sfad-ois-intl-gov-atm`

-- Tests for sfad-ois-intl-gov-atm.l4 (Securities and Futures Act 2001, ss 277 to 282).
-- Every expected value is written from the text, beside the assertion; none is copied from the module's output.
-- Inputs are positional, in the order of the GIVEN of the function under test.

§ `s 277(1AA) and (1)(a): the securities offered`

-- (1AA): arguments: the units or shares are listed; SDRs with them as the underlying securities are listed
#ASSERT (`s 277(1AA) the units in the business trust or the shares of the corporation are treated as being listed for quotation on an approved exchange` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 277(1AA) the units in the business trust or the shares of the corporation are treated as being listed for quotation on an approved exchange` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1AA) the units in the business trust or the shares of the corporation are treated as being listed for quotation on an approved exchange` FALSE FALSE) EQUALS NOTHING
-- (a)(i): arguments: units or derivatives of units in a business trust issued by a trustee-manager; listed counting SDRs as (1AA) says
#ASSERT (`s 277(1)(a)(i) the securities or contracts are units or derivatives of units in a listed business trust` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1)(a)(i) the securities or contracts are units or derivatives of units in a listed business trust` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 277(1)(a)(i) the securities or contracts are units or derivatives of units in a listed business trust` FALSE TRUE) EQUALS JUST FALSE
-- (a)(ia): the same shape for SDRs of such units
#ASSERT (`s 277(1)(a)(ia) the securities are SDRs of a listed business trust` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1)(a)(ia) the securities are SDRs of a listed business trust` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 277(1)(a)(ia) the securities are SDRs of a listed business trust` FALSE TRUE) EQUALS JUST FALSE
-- (a)(ii): arguments: those mentioned in (i), or SDRs; issued by a corporation; the shares are listed counting SDRs as (1AA) says
#ASSERT (`s 277(1)(a)(ii) the securities or contracts are issued by a corporation whose shares are listed` FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1)(a)(ii) the securities or contracts are issued by a corporation whose shares are listed` TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1)(a)(ii) the securities or contracts are issued by a corporation whose shares are listed` FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1)(a)(ii) the securities or contracts are issued by a corporation whose shares are listed` FALSE TRUE FALSE) EQUALS JUST FALSE
-- (a)(iii): arguments: SDRs the underlying securities of which are securities issued by a corporation; those underlying securities are the ones in (i); the shares are listed
#ASSERT (`s 277(1)(a)(iii) the securities are SDRs of a listed corporation` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1)(a)(iii) the securities are SDRs of a listed corporation` TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1)(a)(iii) the securities are SDRs of a listed corporation` FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1)(a)(iii) the securities are SDRs of a listed corporation` TRUE FALSE FALSE) EQUALS JUST FALSE
-- (a): the four sub-paragraphs are alternatives
#ASSERT (`s 277(1)(a) the securities or contracts are of a kind the paragraph names` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 277(1)(a) the securities or contracts are of a kind the paragraph names` (JUST FALSE) (JUST FALSE) (JUST TRUE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 277(1)(a) the securities or contracts are of a kind the paragraph names` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 277(1)(a) the securities or contracts are of a kind the paragraph names` (JUST FALSE) NOTHING (JUST FALSE) (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 277(1)(a) the securities or contracts are of a kind the paragraph names` (JUST FALSE) NOTHING (JUST TRUE) (JUST FALSE)) EQUALS JUST TRUE
-- (aa) and (ab): arguments: the securities are units of shares or debentures (derivatives of units); the issuer is the same
#ASSERT (`s 277(1)(aa) the issuer of the units is the issuer of the shares or debentures` FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 277(1)(aa) the issuer of the units is the issuer of the shares or debentures` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1)(aa) the issuer of the units is the issuer of the shares or debentures` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 277(1)(ab) the issuer of the derivatives is the issuer of the units in the business trust` FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 277(1)(ab) the issuer of the derivatives is the issuer of the units in the business trust` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1)(ab) the issuer of the derivatives is the issuer of the units in the business trust` TRUE FALSE) EQUALS JUST FALSE

§ `s 277(1)(b), (1B), (1)(c), (1A) and (1)`

-- (b): arguments: the statement is lodged with the Authority; it complies with the prescribed form and content
#ASSERT (`s 277(1)(b) an offer information statement complying with the prescribed requirements is lodged with the Authority` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1)(b) an offer information statement complying with the prescribed requirements is lodged with the Authority` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 277(1)(b) an offer information statement complying with the prescribed requirements is lodged with the Authority` FALSE TRUE) EQUALS JUST FALSE
-- (1B): arguments: made using an ATM; made using other prescribed electronic means; indicates how to obtain a copy; indicates that it should be read; indications given before enabling an application; the person complies with other requirements
#ASSERT (`s 277(1B) all the conditions are satisfied` TRUE FALSE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1B) all the conditions are satisfied` FALSE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1B) all the conditions are satisfied` FALSE FALSE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1B) all the conditions are satisfied` TRUE FALSE FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1B) all the conditions are satisfied` TRUE FALSE TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1B) all the conditions are satisfied` TRUE FALSE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1B) all the conditions are satisfied` TRUE FALSE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
-- (c): arguments: the offer is made in or accompanied by the statement; the answer of (1B)
#ASSERT (`s 277(1)(c) the offer is made in or accompanied by the statement, or all the conditions in subsection (1B) are satisfied` TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 277(1)(c) the offer is made in or accompanied by the statement, or all the conditions in subsection (1B) are satisfied` FALSE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 277(1)(c) the offer is made in or accompanied by the statement, or all the conditions in subsection (1B) are satisfied` FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 277(1)(c) the offer is made in or accompanied by the statement, or all the conditions in subsection (1B) are satisfied` FALSE NOTHING) EQUALS NOTHING
#ASSERT (`s 277(1)(c) the offer is made in or accompanied by the statement, or all the conditions in subsection (1B) are satisfied` TRUE NOTHING) EQUALS JUST TRUE
-- (1A): arguments: a statement has been lodged; the day it was lodged; the day of the offer. "a period of 6 months from the date" lodged on 1 January 2025 runs to 30 June 2025
#ASSERT (`s 277(1A) the offer is made within the period of 6 months from the date the offer information statement is lodged` TRUE (Date 1 1 2025) (Date 1 1 2025)) EQUALS JUST TRUE
#ASSERT (`s 277(1A) the offer is made within the period of 6 months from the date the offer information statement is lodged` TRUE (Date 1 1 2025) (Date 30 6 2025)) EQUALS JUST TRUE
#ASSERT (`s 277(1A) the offer is made within the period of 6 months from the date the offer information statement is lodged` TRUE (Date 1 1 2025) (Date 1 7 2025)) EQUALS JUST FALSE
#ASSERT (`s 277(1A) the offer is made within the period of 6 months from the date the offer information statement is lodged` TRUE (Date 1 1 2025) (Date 31 12 2024)) EQUALS JUST FALSE
#ASSERT (`s 277(1A) the offer is made within the period of 6 months from the date the offer information statement is lodged` FALSE (Date 1 1 2025) (Date 1 3 2025)) EQUALS NOTHING
-- (1): arguments: prescribed as excluded; answers of (a), (aa), (ab), (b), (c) and (1A)
#ASSERT (`s 277(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` FALSE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 277(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` TRUE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 277(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` FALSE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 277(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` FALSE (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 277(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` FALSE (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 277(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` FALSE (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 277(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` FALSE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 277(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` FALSE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 277(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` FALSE NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 277(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` FALSE (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) NOTHING) EQUALS NOTHING
#ASSERT (`s 277(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` FALSE NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 277(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` FALSE NOTHING (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE

§ `s 277(1AB) to (1AD)`

-- (1AB): arguments: an offer of securities; issued by a subsidiary of a listed entity; the listed entity has guaranteed all payment obligations; the subsidiary or the listed entity has applied
#ASSERT (`s 277(1AB) the Authority may declare that the provision of an offer information statement in lieu of a prospectus would not be prejudicial to investors` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1AB) the Authority may declare that the provision of an offer information statement in lieu of a prospectus would not be prejudicial to investors` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1AB) the Authority may declare that the provision of an offer information statement in lieu of a prospectus would not be prejudicial to investors` TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1AB) the Authority may declare that the provision of an offer information statement in lieu of a prospectus would not be prejudicial to investors` TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1AB) the Authority may declare that the provision of an offer information statement in lieu of a prospectus would not be prejudicial to investors` TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
-- (1AC)(a): arguments: complies with the prescribed form and content; signed by every director of the subsidiary and the listed entity; lodged by the subsidiary or the listed entity
#ASSERT (`s 277(1AC)(a) the offer information statement meets the three requirements of paragraph (a)` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1AC)(a) the offer information statement meets the three requirements of paragraph (a)` FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1AC)(a) the offer information statement meets the three requirements of paragraph (a)` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(1AC)(a) the offer information statement meets the three requirements of paragraph (a)` TRUE TRUE FALSE) EQUALS JUST FALSE
-- (1AC)(b): arguments: the offer is made in or accompanied by the statement; the answer of (1B)
#ASSERT (`s 277(1AC)(b) the offer is made in or accompanied by the statement, or all the conditions in subsection (1B) are satisfied` TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 277(1AC)(b) the offer is made in or accompanied by the statement, or all the conditions in subsection (1B) are satisfied` FALSE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 277(1AC)(b) the offer is made in or accompanied by the statement, or all the conditions in subsection (1B) are satisfied` FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 277(1AC)(b) the offer is made in or accompanied by the statement, or all the conditions in subsection (1B) are satisfied` FALSE NOTHING) EQUALS NOTHING
-- (1AC): arguments: a declaration has been made; the day of the declaration; the day of the offer; the answers of (a) and (b). "a period of 6 months starting on the date of the declaration": 1 March 2025 to 31 August 2025
#ASSERT (`s 277(1AC) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257) for 6 months from the declaration` TRUE (Date 1 3 2025) (Date 1 3 2025) (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 277(1AC) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257) for 6 months from the declaration` TRUE (Date 1 3 2025) (Date 31 8 2025) (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 277(1AC) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257) for 6 months from the declaration` TRUE (Date 1 3 2025) (Date 1 9 2025) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 277(1AC) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257) for 6 months from the declaration` TRUE (Date 1 3 2025) (Date 28 2 2025) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 277(1AC) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257) for 6 months from the declaration` TRUE (Date 1 3 2025) (Date 1 4 2025) (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 277(1AC) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257) for 6 months from the declaration` TRUE (Date 1 3 2025) (Date 1 4 2025) (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 277(1AC) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257) for 6 months from the declaration` TRUE (Date 1 3 2025) (Date 1 4 2025) NOTHING (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 277(1AC) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257) for 6 months from the declaration` FALSE (Date 1 3 2025) (Date 1 4 2025) (JUST TRUE) (JUST TRUE)) EQUALS NOTHING
-- (1AD): the power exists on making a declaration (the reading taken for the split site (ii): JUST FALSE where no declaration is being made; the other reading answers NOTHING)
#ASSERT (`s 277(1AD) the Authority may provide that the offer may only be made subject to conditions or restrictions` TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(1AD) the Authority may provide that the offer may only be made subject to conditions or restrictions` FALSE) EQUALS JUST FALSE

§ `s 277(2) to (6)`

-- (2): a person interested has applied (split site (ii): JUST FALSE where no one has applied; the other reading answers NOTHING)
#ASSERT (`s 277(2) the Authority may modify the prescribed form and content of the offer information statement` TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(2) the Authority may modify the prescribed form and content of the offer information statement` FALSE) EQUALS JUST FALSE
#ASSERT (`s 277(3) sections 249, 249A, 253, 254 and 255 apply to the offer information statement as they apply to a prospectus` TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(3) sections 249, 249A, 253, 254 and 255 apply to the offer information statement as they apply to a prospectus` FALSE) EQUALS NOTHING
-- (4)(a): arguments: applied to a statement under (3); the reference is one in section 249 or 249A to the registration of the prospectus
#ASSERT (`s 277(4)(a) the reference to the registration of the prospectus is to be read as a reference to the lodgment of the offer information statement` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(4)(a) the reference to the registration of the prospectus is to be read as a reference to the lodgment of the offer information statement` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 277(4)(a) the reference to the registration of the prospectus is to be read as a reference to the lodgment of the offer information statement` TRUE FALSE) EQUALS NOTHING
-- (4)(b): arguments: applied under (3); the reference is one in section 253 or 254 to information required in a prospectus under section 243
#ASSERT (`s 277(4)(b) the reference to information required in a prospectus is to be read as a reference to the information prescribed under subsection (1)(b)` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(4)(b) the reference to information required in a prospectus is to be read as a reference to the information prescribed under subsection (1)(b)` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 277(4)(b) the reference to information required in a prospectus is to be read as a reference to the information prescribed under subsection (1)(b)` TRUE FALSE) EQUALS NOTHING
-- (4)(c): arguments: applied under (3); the statement is one mentioned in (1AC); the reference is to the person making the offer in section 253(4) or 254(3)
#ASSERT (`s 277(4)(c) the reference to the person making the offer is to be read as a reference to the subsidiary and the listed entity` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(4)(c) the reference to the person making the offer is to be read as a reference to the subsidiary and the listed entity` TRUE FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 277(4)(c) the reference to the person making the offer is to be read as a reference to the subsidiary and the listed entity` TRUE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 277(4)(c) the reference to the person making the offer is to be read as a reference to the subsidiary and the listed entity` FALSE TRUE TRUE) EQUALS NOTHING
-- (5): arguments: the expert's consent is required; the day it is lodged; the day the statement is lodged ("at the same time" read as the same day)
#ASSERT (`s 277(5) the written consent of the expert is lodged with the Authority at the same time as the lodgment of the statement` TRUE (Date 1 6 2025) (Date 1 6 2025)) EQUALS JUST TRUE
#ASSERT (`s 277(5) the written consent of the expert is lodged with the Authority at the same time as the lodgment of the statement` TRUE (Date 2 6 2025) (Date 1 6 2025)) EQUALS JUST FALSE
#ASSERT (`s 277(5) the written consent of the expert is lodged with the Authority at the same time as the lodgment of the statement` TRUE (Date 31 5 2025) (Date 1 6 2025)) EQUALS JUST FALSE
#ASSERT (`s 277(5) the written consent of the expert is lodged with the Authority at the same time as the lodgment of the statement` FALSE (Date 1 6 2025) (Date 1 6 2025)) EQUALS NOTHING
#ASSERT (`s 277(6) the written consent of the issue manager or underwriter is lodged with the Authority at the same time as the lodgment of the statement` TRUE (Date 1 6 2025) (Date 1 6 2025)) EQUALS JUST TRUE
#ASSERT (`s 277(6) the written consent of the issue manager or underwriter is lodged with the Authority at the same time as the lodgment of the statement` TRUE (Date 2 6 2025) (Date 1 6 2025)) EQUALS JUST FALSE
#ASSERT (`s 277(6) the written consent of the issue manager or underwriter is lodged with the Authority at the same time as the lodgment of the statement` FALSE (Date 1 6 2025) (Date 1 6 2025)) EQUALS NOTHING

§ `s 277(7) and (8)`

-- (7): arguments: advertises; publishes a statement that refers to the offer; publishes a statement likely to induce; complies with the requirements prescribed under section 341
#ASSERT (`s 277(7) the person must not advertise or publish what the subsection bars` TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 277(7) the person must not advertise or publish what the subsection bars` FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 277(7) the person must not advertise or publish what the subsection bars` FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 277(7) the person must not advertise or publish what the subsection bars` TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 277(7) the person must not advertise or publish what the subsection bars` FALSE FALSE FALSE FALSE) EQUALS NOTHING
-- (8): arguments: contravenes (7); knowingly authorises or permits the publication
#ASSERT (`s 277(8) the person is guilty of an offence` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 277(8) the person is guilty of an offence` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 277(8) the person is guilty of an offence` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 277(8) the penalty for the offence`) EQUALS (Penalty OF 50000, 12, TRUE, 5000)
-- the bar of (7) as a rule: the forbidden act is a breach; with no act the bar stands
-- EXPECT BREACH
#TRACE `s 277(7) the bar on advertising or publishing` AT 0 WITH
    PARTY `s 277 a person` DOES `s 277(7) advertise or publish what the subsection bars` AT 4
-- EXPECT RESIDUAL
#TRACE `s 277(7) the bar on advertising or publishing` AT 0 WITH
    (WAITUNTIL 30)

§ `s 278`

-- (1)(a): arguments: made by the holder of a capital markets services licence; made by an exempt person under section 99(1)(a) or (b); made to investors the Authority has specified
#ASSERT (`s 278(1)(a) the offer is made by a licensee or an exempt person to the investors the Authority has specified` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 278(1)(a) the offer is made by a licensee or an exempt person to the investors the Authority has specified` FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 278(1)(a) the offer is made by a licensee or an exempt person to the investors the Authority has specified` FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 278(1)(a) the offer is made by a licensee or an exempt person to the investors the Authority has specified` TRUE FALSE FALSE) EQUALS JUST FALSE
-- (2)(a): arguments: denominated in a currency other than the Singapore dollar; the lowest face value in US dollars (at least US$5,000)
#ASSERT (`s 278(2)(a) the debentures are denominated in a foreign currency and each has a face value of at least US$5,000` TRUE 5000) EQUALS JUST TRUE
#ASSERT (`s 278(2)(a) the debentures are denominated in a foreign currency and each has a face value of at least US$5,000` TRUE 100000) EQUALS JUST TRUE
#ASSERT (`s 278(2)(a) the debentures are denominated in a foreign currency and each has a face value of at least US$5,000` TRUE 4999) EQUALS JUST FALSE
#ASSERT (`s 278(2)(a) the debentures are denominated in a foreign currency and each has a face value of at least US$5,000` FALSE 10000) EQUALS JUST FALSE
-- (2)(b): arguments: the shares of the issuing corporation are listed; the offer is guaranteed by a corporation whose shares are listed
#ASSERT (`s 278(2)(b) the shares of the issuing corporation, or of a guarantor, are listed on a recognised securities exchange` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 278(2)(b) the shares of the issuing corporation, or of a guarantor, are listed on a recognised securities exchange` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 278(2)(b) the shares of the issuing corporation, or of a guarantor, are listed on a recognised securities exchange` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 278(2) the offer complies with the conditions specified in this subsection` (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 278(2) the offer complies with the conditions specified in this subsection` (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 278(2) the offer complies with the conditions specified in this subsection` (JUST FALSE) NOTHING) EQUALS JUST FALSE
#ASSERT (`s 278(2) the offer complies with the conditions specified in this subsection` NOTHING (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 278(1)(b) the offer complies with the conditions specified in subsection (2)` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 278(1)(b) the offer complies with the conditions specified in subsection (2)` (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 278(1)(b) the offer complies with the conditions specified in subsection (2)` NOTHING) EQUALS NOTHING
-- (1): arguments: an offer of debentures by a body incorporated outside Singapore; the answers of (a) and (b)
#ASSERT (`s 278(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` TRUE (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 278(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` FALSE (JUST TRUE) (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 278(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` TRUE (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 278(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` TRUE (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 278(1) the offer is exempt from Subdivisions (2) and (3) of this Division (other than section 257)` TRUE NOTHING (JUST TRUE)) EQUALS NOTHING
-- (3): the Authority acts by order in the Gazette
#ASSERT (`s 278(3) the Authority may add to, vary or amend the conditions specified in subsection (2)` TRUE) EQUALS JUST TRUE
#ASSERT (`s 278(3) the Authority may add to, vary or amend the conditions specified in subsection (2)` FALSE) EQUALS NOTHING

§ `s 279`

-- arguments: an offer of debentures or units of debentures; made or guaranteed by the Government; made or guaranteed by an international financial institution in which Singapore holds membership
#ASSERT (`s 279 the offer is exempt from Subdivisions (2) and (3) of this Division` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 279 the offer is exempt from Subdivisions (2) and (3) of this Division` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 279 the offer is exempt from Subdivisions (2) and (3) of this Division` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 279 the offer is exempt from Subdivisions (2) and (3) of this Division` FALSE TRUE FALSE) EQUALS NOTHING

§ `s 280, 280A`

-- (1), the offer referred to in section 280: arguments: an offer of securities or contracts; using an ATM; using other prescribed electronic means
#ASSERT (`s 280(1) the offer is an offer referred to in section 280` TRUE TRUE FALSE) EQUALS TRUE
#ASSERT (`s 280(1) the offer is an offer referred to in section 280` TRUE FALSE TRUE) EQUALS TRUE
#ASSERT (`s 280(1) the offer is an offer referred to in section 280` TRUE FALSE FALSE) EQUALS FALSE
#ASSERT (`s 280(1) the offer is an offer referred to in section 280` FALSE TRUE FALSE) EQUALS FALSE
-- (1), the exemption: arguments: an offer referred to in subsection (1); the person complies with the prescribed requirements; the answer of (3)
#ASSERT (`s 280(1) the person making the offer is exempted from the requirement of a prospectus or profile statement` TRUE TRUE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 280(1) the person making the offer is exempted from the requirement of a prospectus or profile statement` TRUE TRUE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 280(1) the person making the offer is exempted from the requirement of a prospectus or profile statement` TRUE FALSE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 280(1) the person making the offer is exempted from the requirement of a prospectus or profile statement` TRUE TRUE NOTHING) EQUALS NOTHING
#ASSERT (`s 280(1) the person making the offer is exempted from the requirement of a prospectus or profile statement` FALSE TRUE (JUST TRUE)) EQUALS NOTHING
-- (2): arguments: an offer referred to in subsection (1); a prospectus or profile statement has been prepared and issued
#ASSERT (`s 280(2) a prospectus or profile statement complying with the other requirements has been prepared and issued for the offer` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 280(2) a prospectus or profile statement complying with the other requirements has been prepared and issued for the offer` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 280(2) a prospectus or profile statement complying with the other requirements has been prepared and issued for the offer` FALSE TRUE) EQUALS NOTHING
-- (3): arguments: indicates how to obtain a copy; indicates it should be read first; the indications come before an application can be submitted
#ASSERT (`s 280(3) the machine or the electronic means gives the indications that subsection (1) needs` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 280(3) the machine or the electronic means gives the indications that subsection (1) needs` FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 280(3) the machine or the electronic means gives the indications that subsection (1) needs` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 280(3) the machine or the electronic means gives the indications that subsection (1) needs` TRUE TRUE FALSE) EQUALS JUST FALSE
-- 280A: arguments: the information relates to an offer made in reliance on an exemption under this Subdivision; the Authority acts by regulations under section 341
#ASSERT (`s 280A the Authority may require a person or class of persons to provide information about an offer made in reliance on an exemption` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 280A the Authority may require a person or class of persons to provide information about an offer made in reliance on an exemption` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 280A the Authority may require a person or class of persons to provide information about an offer made in reliance on an exemption` TRUE FALSE) EQUALS NOTHING

§ `s 281 and 282`

-- (1): arguments: the Authority considers a person is contravening a condition under section 273(6); the Authority considers revocation necessary in the public interest or for the protection of investors
-- (split site (ii): NOTHING where the Authority holds neither view; the other reading answers JUST FALSE)
#ASSERT (`s 281(1) the Authority may revoke an exemption under this Subdivision` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 281(1) the Authority may revoke an exemption under this Subdivision` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 281(1) the Authority may revoke an exemption under this Subdivision` FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 281(2) the Authority may revoke the exemption without giving the person affected an opportunity to be heard` TRUE) EQUALS JUST TRUE
#ASSERT (`s 281(2) the Authority may revoke the exemption without giving the person affected an opportunity to be heard` FALSE) EQUALS NOTHING
-- (2), the review: arguments: the exemption has been revoked; the day of the revocation; the day of the application. "within 14 days of the revocation": 1 March 2025 to 15 March 2025
#ASSERT (`s 281(2) the person may apply to the Authority for the revocation to be reviewed` TRUE (Date 1 3 2025) (Date 1 3 2025)) EQUALS JUST TRUE
#ASSERT (`s 281(2) the person may apply to the Authority for the revocation to be reviewed` TRUE (Date 1 3 2025) (Date 15 3 2025)) EQUALS JUST TRUE
#ASSERT (`s 281(2) the person may apply to the Authority for the revocation to be reviewed` TRUE (Date 1 3 2025) (Date 16 3 2025)) EQUALS JUST FALSE
#ASSERT (`s 281(2) the person may apply to the Authority for the revocation to be reviewed` TRUE (Date 1 3 2025) (Date 28 2 2025)) EQUALS JUST FALSE
#ASSERT (`s 281(2) the person may apply to the Authority for the revocation to be reviewed` FALSE (Date 1 3 2025) (Date 5 3 2025)) EQUALS NOTHING
-- (2), the effect: arguments: the exemption has been revoked; the Authority has withdrawn the revocation
#ASSERT (`s 281(2) the revocation remains in effect` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 281(2) the revocation remains in effect` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 281(2) the revocation remains in effect` FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 281(3) the revocation is final and no appeal lies from it` TRUE) EQUALS JUST TRUE
#ASSERT (`s 281(3) the revocation is final and no appeal lies from it` FALSE) EQUALS NOTHING
-- 282: arguments: a transaction under an exempted offer under Part 13; the liability is for a relevant offence under Division 2 of Part 12 of the Companies Act 1967 or Part 12 of this Act
#ASSERT (`s 282 nothing in this Part limits or diminishes the liability` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 282 nothing in this Part limits or diminishes the liability` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 282 nothing in this Part limits or diminishes the liability` TRUE FALSE) EQUALS NOTHING
