#ASSERT (`s 272B(1) the offers are exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 272B(1) the offers are exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272B(1) the offers are exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272B(1) the offers are exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272B(1) the offers are exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 272B(1) the offers are exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 272B(1) the offers are exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` NOTHING (JUST FALSE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
