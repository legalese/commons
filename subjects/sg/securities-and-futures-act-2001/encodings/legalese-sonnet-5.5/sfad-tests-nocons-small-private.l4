IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-periods`
IMPORT `sfad-nocons-small-private`

-- Tests for sfad-nocons-small-private.l4 (Securities and Futures Act 2001, ss 272, 272A and 272B).
-- Every expected value is written from the text, beside the assertion; none is copied from the module's output.
-- Inputs are positional, in the order of the GIVEN of the function under test.

§ `s 272`

-- (1) shares or debentures of an entity, or units in a business trust, "if no consideration is or will be given"
#ASSERT (`s 272(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE FALSE) EQUALS JUST TRUE
-- consideration is given: the "if" fails
#ASSERT (`s 272(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE TRUE) EQUALS JUST FALSE
-- the offer is not of shares, debentures or business-trust units: the section is silent, whatever the consideration
#ASSERT (`s 272(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 272(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` FALSE TRUE) EQUALS NOTHING
-- (2) units of shares or debentures, or derivatives of units in a business trust: (a) no consideration for the issue or transfer AND (b) none for the underlying securities on exercise or conversion
#ASSERT (`s 272(2) the offer of securities-based derivatives contracts is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 272(2) the offer of securities-based derivatives contracts is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 272(2) the offer of securities-based derivatives contracts is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 272(2) the offer of securities-based derivatives contracts is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 272(2) the offer of securities-based derivatives contracts is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` FALSE FALSE FALSE) EQUALS NOTHING

§ `s 272A definitions: advertisement, affairs, expenses`

-- (10) "advertisement" means (a) written or printed; (b) radio, television or other medium; or (c) a recorded telephone message, published in connection with an offer, but not (d), (e) or (f)
-- arguments: a communication of the kinds (a) to (c); published in connection with an offer; a document of (d); a publication of (e); a publication of (f)
#ASSERT (`s 272A(10) the communication is an advertisement` TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 272A(10) the communication is an advertisement` TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 272A(10) the communication is an advertisement` FALSE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 272A(10) the communication is an advertisement` TRUE TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 272A(10) the communication is an advertisement` TRUE TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 272A(10) the communication is an advertisement` TRUE TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
-- (11) "includes" (a) for a corporation the matters of section 2(2), (b) in any other case the matters prescribed
#ASSERT (`s 272A(11) the matter is included in the affairs of the person making the offer, the issuer, the underlying entity or the business trust` TRUE (JUST TRUE) FALSE) EQUALS JUST TRUE
#ASSERT (`s 272A(11) the matter is included in the affairs of the person making the offer, the issuer, the underlying entity or the business trust` TRUE NOTHING FALSE) EQUALS NOTHING
#ASSERT (`s 272A(11) the matter is included in the affairs of the person making the offer, the issuer, the underlying entity or the business trust` FALSE NOTHING TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(11) the matter is included in the affairs of the person making the offer, the issuer, the underlying entity or the business trust` FALSE (JUST TRUE) FALSE) EQUALS NOTHING
-- (1)(d) each kind of expense
#ASSERT (`s 272A(1)(d) the expense is one the exemption allows` `s 272A(1)(d) an expense incurred for administrative or professional services`) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(d) the expense is one the exemption allows` `s 272A(1)(d)(i) a commission or fee for services rendered by the holder of a capital markets services licence to deal in capital markets products that are securities or securities-based derivatives contracts`) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(d) the expense is one the exemption allows` `s 272A(1)(d)(ii) a commission or fee for services rendered by an exempt person in respect of dealing in capital markets products that are securities or securities-based derivatives contracts`) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(d) the expense is one the exemption allows` `s 272A(1)(d)(iii)(A) a commission or fee for services rendered by a person licensed, approved, authorised or otherwise regulated under the laws of a foreign jurisdiction in respect of dealing in capital markets products that are securities or securities-based derivatives contracts`) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(d) the expense is one the exemption allows` `s 272A(1)(d)(iii)(B) a commission or fee for services rendered by a person exempted from those foreign laws, codes or requirements in respect of dealing in capital markets products that are securities or securities-based derivatives contracts`) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(d) the expense is one the exemption allows` `s 272A(1)(d) any other selling or promotional expense`) EQUALS JUST FALSE
-- (1)(d) the list: no expenses at all; allowed ones only; one other expense anywhere in the list
#ASSERT (`s 272A(1)(d) the selling or promotional expenses are ones the exemption allows` EMPTY) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(d) the selling or promotional expenses are ones the exemption allows` (LIST `s 272A(1)(d) an expense incurred for administrative or professional services`, `s 272A(1)(d)(i) a commission or fee for services rendered by the holder of a capital markets services licence to deal in capital markets products that are securities or securities-based derivatives contracts`, `s 272A(1)(d)(iii)(B) a commission or fee for services rendered by a person exempted from those foreign laws, codes or requirements in respect of dealing in capital markets products that are securities or securities-based derivatives contracts`)) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(d) the selling or promotional expenses are ones the exemption allows` (LIST `s 272A(1)(d) an expense incurred for administrative or professional services`, `s 272A(1)(d) any other selling or promotional expense`)) EQUALS JUST FALSE
#ASSERT (`s 272A(1)(d) the selling or promotional expenses are ones the exemption allows` (LIST `s 272A(1)(d) any other selling or promotional expense`, `s 272A(1)(d) an expense incurred for administrative or professional services`)) EQUALS JUST FALSE
-- (1)(c) no advertisement
#ASSERT (`s 272A(1)(c) none of the offers is accompanied by an advertisement` FALSE) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(c) none of the offers is accompanied by an advertisement` TRUE) EQUALS JUST FALSE

§ `s 272A(3): a personal offer`

#ASSERT (`s 272A(3)(a) the offer may be accepted only by the person to whom it is made` TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(a) the offer may be accepted only by the person to whom it is made` FALSE) EQUALS JUST FALSE
-- (F): (FA) regulated for dealing, (FB) exempt for dealing, (FC) regulated for advisory services, (FD) exempt for advisory services
#ASSERT (`s 272A(3)(b)(iii)(F) the person to whom the indication was made is a foreign regulated or exempt person` TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(b)(iii)(F) the person to whom the indication was made is a foreign regulated or exempt person` FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(b)(iii)(F) the person to whom the indication was made is a foreign regulated or exempt person` FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(b)(iii)(F) the person to whom the indication was made is a foreign regulated or exempt person` FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(b)(iii)(F) the person to whom the indication was made is a foreign regulated or exempt person` FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
-- (iii) indication to (A) the offeror, (B) a capital markets services licence holder, (C) an exempt person, (D) a Financial Advisers Act licensee, (E) an exempt financial adviser, (F)
#ASSERT (`s 272A(3)(b)(iii) the person has previously indicated that the person is interested in offers of that kind` TRUE FALSE FALSE FALSE FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(b)(iii) the person has previously indicated that the person is interested in offers of that kind` FALSE TRUE FALSE FALSE FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(b)(iii) the person has previously indicated that the person is interested in offers of that kind` FALSE FALSE TRUE FALSE FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(b)(iii) the person has previously indicated that the person is interested in offers of that kind` FALSE FALSE FALSE TRUE FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(b)(iii) the person has previously indicated that the person is interested in offers of that kind` FALSE FALSE FALSE FALSE TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(b)(iii) the person has previously indicated that the person is interested in offers of that kind` FALSE FALSE FALSE FALSE FALSE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(b)(iii) the person has previously indicated that the person is interested in offers of that kind` FALSE FALSE FALSE FALSE FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 272A(3)(b)(iii) the person has previously indicated that the person is interested in offers of that kind` FALSE FALSE FALSE FALSE FALSE NOTHING) EQUALS NOTHING
#ASSERT (`s 272A(3)(b)(iii) the person has previously indicated that the person is interested in offers of that kind` TRUE FALSE FALSE FALSE FALSE NOTHING) EQUALS JUST TRUE
-- (b) likely to be interested, having regard to (i) contact, (ii) connection, (iii) indication
#ASSERT (`s 272A(3)(b) the offer is made to a person who is likely to be interested in that offer` FALSE TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272A(3)(b) the offer is made to a person who is likely to be interested in that offer` TRUE TRUE FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(b) the offer is made to a person who is likely to be interested in that offer` TRUE FALSE TRUE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 272A(3)(b) the offer is made to a person who is likely to be interested in that offer` TRUE FALSE FALSE (JUST TRUE)) EQUALS JUST TRUE
-- likely, but none of the three matters is shown: the text does not close the list with "only"
#ASSERT (`s 272A(3)(b) the offer is made to a person who is likely to be interested in that offer` TRUE FALSE FALSE (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 272A(3)(b) the offer is made to a person who is likely to be interested in that offer` TRUE FALSE FALSE NOTHING) EQUALS NOTHING
-- (3) "is one that (a) ... and (b)"
#ASSERT (`s 272A(3) the offer is a personal offer of securities or securities-based derivatives contracts` (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 272A(3) the offer is a personal offer of securities or securities-based derivatives contracts` (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272A(3) the offer is a personal offer of securities or securities-based derivatives contracts` (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 272A(3) the offer is a personal offer of securities or securities-based derivatives contracts` (JUST TRUE) NOTHING) EQUALS NOTHING
#ASSERT (`s 272A(3) the offer is a personal offer of securities or securities-based derivatives contracts` NOTHING (JUST FALSE)) EQUALS JUST FALSE

§ `s 272A(2): the statement and notification on the first page`

#ASSERT (`s 272A(2) the statement and notification are treated as given` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(2) the statement and notification are treated as given` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 272A(2) the statement and notification are treated as given` TRUE FALSE) EQUALS NOTHING

§ `s 272A(1)(a) to (e): the limbs of the small-offers exemption`

-- (1)(a) $5 million: exactly the limit is "does not exceed"; one dollar more is over; a prescribed substitute replaces it
#ASSERT (`s 272A(1)(a) the total amount raised within the period of 12 months does not exceed the limit` 5000000 FALSE 0) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(a) the total amount raised within the period of 12 months does not exceed the limit` 5000001 FALSE 0) EQUALS JUST FALSE
#ASSERT (`s 272A(1)(a) the total amount raised within the period of 12 months does not exceed the limit` 3000000 TRUE 3000000) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(a) the total amount raised within the period of 12 months does not exceed the limit` 3000001 TRUE 3000000) EQUALS JUST FALSE
#ASSERT (`s 272A(1)(a) the total amount raised within the period of 12 months does not exceed the limit` 6000000 TRUE 8000000) EQUALS JUST TRUE
-- (1)(b)(i) the statement: arguments: given; deemed under (2); business trust not registered; words (A); words (B)
#ASSERT (`s 272A(1)(b)(i) the statement in writing is given as the paragraph requires` TRUE NOTHING FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(b)(i) the statement in writing is given as the paragraph requires` TRUE NOTHING TRUE TRUE FALSE) EQUALS JUST TRUE
-- an unregistered business trust needs the (A) words, and the (B) words alone are not enough
#ASSERT (`s 272A(1)(b)(i) the statement in writing is given as the paragraph requires` TRUE NOTHING TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 272A(1)(b)(i) the statement in writing is given as the paragraph requires` FALSE NOTHING FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 272A(1)(b)(i) the statement in writing is given as the paragraph requires` FALSE (JUST TRUE) FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(b)(i) the statement in writing is given as the paragraph requires` FALSE (JUST FALSE) FALSE FALSE TRUE) EQUALS JUST FALSE
-- (1)(b)(ii) the notification: arguments: given; deemed; names (A); names (B); names (C)
#ASSERT (`s 272A(1)(b)(ii) the notification in writing is given as the paragraph requires` TRUE NOTHING TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(b)(ii) the notification in writing is given as the paragraph requires` TRUE NOTHING TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 272A(1)(b)(ii) the notification in writing is given as the paragraph requires` TRUE NOTHING FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 272A(1)(b)(ii) the notification in writing is given as the paragraph requires` FALSE NOTHING TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 272A(1)(b)(ii) the notification in writing is given as the paragraph requires` FALSE (JUST TRUE) TRUE TRUE TRUE) EQUALS JUST TRUE
-- (1)(b) both
#ASSERT (`s 272A(1)(b) the person making each offer gives the statement and the notification` (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(b) the person making each offer gives the statement and the notification` (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272A(1)(b) the person making each offer gives the statement and the notification` (JUST TRUE) NOTHING) EQUALS NOTHING
#ASSERT (`s 272A(1)(b) the person making each offer gives the statement and the notification` NOTHING (JUST FALSE)) EQUALS JUST FALSE
-- (1)(e): arguments: a prospectus has been registered; it has expired under section 250; the Authority was told
#ASSERT (`s 272A(1)(e) no prospectus is registered, or the registered prospectus has expired or the Authority has been told` FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(e) no prospectus is registered, or the registered prospectus has expired or the Authority has been told` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(e) no prospectus is registered, or the registered prospectus has expired or the Authority has been told` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(1)(e) no prospectus is registered, or the registered prospectus has expired or the Authority has been told` TRUE FALSE FALSE) EQUALS JUST FALSE
-- (1) the exemption: arguments: personal offer; (a); (b); (c); (d); (e)
#ASSERT (`s 272A(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 272A(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS NOTHING
#ASSERT (`s 272A(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272A(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272A(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272A(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272A(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 272A(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) NOTHING) EQUALS NOTHING
#ASSERT (`s 272A(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` NOTHING (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272A(1) the offer is exempt from Subdivisions (1A), (2) and (3) of this Division (other than section 257)` NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS NOTHING

§ `s 272A(4) to (7): the amount raised, earlier offers, closely related offers and agents`

-- (4) the amount payable at allotment, issue or sale; the amount payable on a call (partly paid); the amount payable on conversion or acquisition
#ASSERT (`s 272A(4) the amount raised by an offer` 100 50 25) EQUALS 175
#ASSERT (`s 272A(4) the amount raised by an offer` 100 0 0) EQUALS 100
-- (5) the window is 1 January 2025 to 31 December 2025; each offer is counted only if it relied on the exemption and was (a) by that person for the same entity or (b) closely related
-- fields of an earlier offer: day; amount; (a) same person and entity; (b) closely related; relied on section 272A(1) or 302B(1)
#ASSERT (`s 272A(5) the amounts raised by earlier offers that must be included` (Date 1 1 2025) EMPTY) EQUALS 0
-- 1 June 2025, 100, (a), relied: counted. 31 December 2025, 7, (b), relied: the last day of the window, counted.
#ASSERT (`s 272A(5) the amounts raised by earlier offers that must be included` (Date 1 1 2025) (LIST (`s 272A(5) an earlier offer` OF (Date 1 6 2025), 100, TRUE, FALSE, TRUE), (`s 272A(5) an earlier offer` OF (Date 31 12 2025), 7, FALSE, TRUE, TRUE))) EQUALS 107
-- 1 January 2026 is the day after the window: not counted. 31 December 2024 is the day before: not counted.
#ASSERT (`s 272A(5) the amounts raised by earlier offers that must be included` (Date 1 1 2025) (LIST (`s 272A(5) an earlier offer` OF (Date 1 1 2026), 50, TRUE, FALSE, TRUE), (`s 272A(5) an earlier offer` OF (Date 31 12 2024), 99, TRUE, FALSE, TRUE))) EQUALS 0
-- an offer that did not rely on the exemption is not counted, nor one that is neither (a) nor (b)
#ASSERT (`s 272A(5) the amounts raised by earlier offers that must be included` (Date 1 1 2025) (LIST (`s 272A(5) an earlier offer` OF (Date 1 7 2025), 30, TRUE, FALSE, FALSE), (`s 272A(5) an earlier offer` OF (Date 1 7 2025), 11, FALSE, FALSE, TRUE))) EQUALS 0
#ASSERT (`s 272A(5) the total amount raised within the period of 12 months` 175 107) EQUALS 282
-- (6) the factors are the Authority's; (7) the agent's offer is the principal's
#ASSERT (`s 272A(6) the offer is a closely related offer` TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(6) the offer is a closely related offer` FALSE) EQUALS NOTHING
#ASSERT (`s 272A(7) the offer is treated as made by that other person` TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(7) the offer is treated as made by that other person` FALSE) EQUALS NOTHING

§ `s 272A(8) and (9): the resale of securities acquired under the exemption`

#ASSERT (`s 272A(8)(a) the subsequent offer is made in reliance on another exemption of this Subdivision` TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(8)(a) the subsequent offer is made in reliance on another exemption of this Subdivision` FALSE) EQUALS JUST FALSE
-- (b) acquired 1 January 2025: 6 months run to 1 July 2025; 2 July 2025 is the first day after
#ASSERT (`s 272A(8)(b) the subsequent offer is made in reliance on subsection (1) and at least 6 months have elapsed` TRUE (Date 1 1 2025) (Date 2 7 2025)) EQUALS JUST TRUE
#ASSERT (`s 272A(8)(b) the subsequent offer is made in reliance on subsection (1) and at least 6 months have elapsed` TRUE (Date 1 1 2025) (Date 1 7 2025)) EQUALS JUST FALSE
#ASSERT (`s 272A(8)(b) the subsequent offer is made in reliance on subsection (1) and at least 6 months have elapsed` FALSE (Date 1 1 2025) (Date 2 7 2025)) EQUALS JUST FALSE
-- acquired 31 August 2025: 6 months end on the last day of February 2026 (the keel's P4)
#ASSERT (`s 272A(8)(b) the subsequent offer is made in reliance on subsection (1) and at least 6 months have elapsed` TRUE (Date 31 8 2025) (Date 28 2 2026)) EQUALS JUST FALSE
#ASSERT (`s 272A(8)(b) the subsequent offer is made in reliance on subsection (1) and at least 6 months have elapsed` TRUE (Date 31 8 2025) (Date 1 3 2026)) EQUALS JUST TRUE
#ASSERT (`s 272A(8)(c)(i) the subsequent offer may be accepted only by the person to whom it is made` TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(8)(c)(i) the subsequent offer may be accepted only by the person to whom it is made` FALSE) EQUALS JUST FALSE
-- (CA) the person making the initial offer, (CB), (CC), (CD), (CE), (CF) to (CI)
#ASSERT (`s 272A(8)(c)(ii)(C) the person has previously indicated that the person is interested in offers of that kind` TRUE FALSE FALSE FALSE FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 272A(8)(c)(ii)(C) the person has previously indicated that the person is interested in offers of that kind` FALSE FALSE FALSE FALSE FALSE (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 272A(8)(c)(ii)(C) the person has previously indicated that the person is interested in offers of that kind` FALSE FALSE FALSE FALSE FALSE (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 272A(8)(c)(ii)(C) the person has previously indicated that the person is interested in offers of that kind` FALSE FALSE FALSE FALSE FALSE NOTHING) EQUALS NOTHING
#ASSERT (`s 272A(8)(c)(ii) the subsequent offer is made to a person likely to be interested in the offer` TRUE TRUE FALSE (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 272A(8)(c)(ii) the subsequent offer is made to a person likely to be interested in the offer` FALSE TRUE TRUE (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272A(8)(c)(ii) the subsequent offer is made to a person likely to be interested in the offer` TRUE FALSE FALSE (JUST FALSE)) EQUALS NOTHING
-- (iii): arguments: statement given; deemed under (9); business trust not registered; words (AA); words (AB); notification given; names (BA); names (BB); names (BC)
#ASSERT (`s 272A(8)(c)(iii) the statement and notification are given` TRUE NOTHING FALSE FALSE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(8)(c)(iii) the statement and notification are given` TRUE NOTHING TRUE TRUE FALSE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(8)(c)(iii) the statement and notification are given` TRUE NOTHING TRUE FALSE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 272A(8)(c)(iii) the statement and notification are given` TRUE NOTHING FALSE FALSE TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 272A(8)(c)(iii) the statement and notification are given` FALSE NOTHING FALSE FALSE TRUE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 272A(8)(c)(iii) the statement and notification are given` FALSE (JUST TRUE) FALSE FALSE TRUE FALSE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(9) the statement and notification in subsection (8)(c)(iii) are treated as given` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 272A(9) the statement and notification in subsection (8)(c)(iii) are treated as given` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 272A(8)(c)(iv) the subsequent offer is not accompanied by an advertisement` FALSE) EQUALS JUST TRUE
#ASSERT (`s 272A(8)(c)(iv) the subsequent offer is not accompanied by an advertisement` TRUE) EQUALS JUST FALSE
#ASSERT (`s 272A(8)(c)(v) no selling or promotional expenses are paid or incurred other than those the paragraph allows` (LIST `s 272A(1)(d) an expense incurred for administrative or professional services`, `s 272A(1)(d)(ii) a commission or fee for services rendered by an exempt person in respect of dealing in capital markets products that are securities or securities-based derivatives contracts`)) EQUALS JUST TRUE
#ASSERT (`s 272A(8)(c)(v) no selling or promotional expenses are paid or incurred other than those the paragraph allows` (LIST `s 272A(1)(d) any other selling or promotional expense`)) EQUALS JUST FALSE
-- (c): arguments (i) to (v)
#ASSERT (`s 272A(8)(c) the subsequent offer is one that meets sub-paragraphs (i) to (v)` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 272A(8)(c) the subsequent offer is one that meets sub-paragraphs (i) to (v)` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 272A(8)(c) the subsequent offer is one that meets sub-paragraphs (i) to (v)` (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272A(8)(c) the subsequent offer is one that meets sub-paragraphs (i) to (v)` (JUST TRUE) NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE)) EQUALS NOTHING
-- (8): arguments: acquired through an offer under (1); sold on; (a); (b); (c)
#ASSERT (`s 272A(8) Subdivisions (2) and (3) of this Division apply to the offer that resulted in the sale` TRUE TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 272A(8) Subdivisions (2) and (3) of this Division apply to the offer that resulted in the sale` TRUE TRUE (JUST TRUE) (JUST FALSE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 272A(8) Subdivisions (2) and (3) of this Division apply to the offer that resulted in the sale` TRUE TRUE (JUST FALSE) (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 272A(8) Subdivisions (2) and (3) of this Division apply to the offer that resulted in the sale` TRUE TRUE (JUST FALSE) (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 272A(8) Subdivisions (2) and (3) of this Division apply to the offer that resulted in the sale` TRUE TRUE NOTHING (JUST FALSE) (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 272A(8) Subdivisions (2) and (3) of this Division apply to the offer that resulted in the sale` FALSE TRUE (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 272A(8) Subdivisions (2) and (3) of this Division apply to the offer that resulted in the sale` TRUE FALSE (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS NOTHING

§ `s 272B: private placement`

-- (2) 50, or the number the Authority prescribes
#ASSERT (`s 272B(2) the applicable number of persons` FALSE 0) EQUALS 50
#ASSERT (`s 272B(2) the applicable number of persons` TRUE 100) EQUALS 100
-- (5) the number of persons an offer counts as: arguments: the kind; the number of equity owners, partners, members or beneficiaries
#ASSERT (`s 272B(5) the number of persons the offer to the offeree counts as` `s 272B(1)(a) an individual or an entity counted as itself` 0) EQUALS 1
#ASSERT (`s 272B(5) the number of persons the offer to the offeree counts as` `s 272B(5)(a) an entity or a trustee, the entity or trust not formed primarily for the purpose of acquiring the securities` 0) EQUALS 1
#ASSERT (`s 272B(5) the number of persons the offer to the offeree counts as` `s 272B(5)(b) an entity or a trustee, the entity or trust formed primarily for the purpose of acquiring the securities` 12) EQUALS 12
#ASSERT (`s 272B(5) the number of persons the offer to the offeree counts as` `s 272B(5)(c) two or more persons who will own the securities as joint owners` 0) EQUALS 1
#ASSERT (`s 272B(5) the number of persons the offer to the offeree counts as` `s 272B(5)(d) a person acting on behalf of another person` 0) EQUALS 1
#ASSERT (`s 272B(5) the number of persons the offer to the offeree counts as` `s 272B(5)(f) a person offered with a view to another person acquiring an interest by virtue of section 4` 0) EQUALS 1
#ASSERT (`s 272B(5) the number of persons the offer to the offeree counts as` `s 272B(5)(g) a person offered with a view to the securities being subsequently offered for sale to another person` 0) EQUALS 2
#ASSERT (`s 272B(5)(f) only the second-mentioned person is counted` (JUST TRUE)) EQUALS JUST TRUE
#ASSERT (`s 272B(5)(f) only the second-mentioned person is counted` (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 272B(5)(f) only the second-mentioned person is counted` NOTHING) EQUALS NOTHING
-- (g): an offer in reliance on (1) with a view to a later offer for sale; (ii)(A) the later offer relies on no exemption of the Subdivision, or (ii)(B) relies on subsection (1) or section 280
#ASSERT (`s 272B(5)(g) both persons are counted` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 272B(5)(g) both persons are counted` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 272B(5)(g) both persons are counted` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 272B(5)(g) both persons are counted` FALSE TRUE TRUE) EQUALS NOTHING
#ASSERT (`s 272B(5)(e) the offers are treated as made by that other person` TRUE) EQUALS JUST TRUE
#ASSERT (`s 272B(5)(e) the offers are treated as made by that other person` FALSE) EQUALS NOTHING
-- (3) earlier offerees in the window 1 January 2025 to 31 December 2025
-- fields: day; persons the offer counted as; (a) same person and entity; (b) closely related; relied on section 272B; relied on section 302C
-- counted: 1 June 2025, 10 persons, (a), relied on 272B. Not counted: (a) but relied only on 302C (paragraph (a) names "this section" only), 5 persons.
-- counted: 4 persons, (b), relied on 302C (paragraph (b) names "this section or section 302C"). Not counted: 8 persons, neither (a) nor (b).
#ASSERT (`s 272B(3) the number of persons to whom earlier offers were made that must be included` (Date 1 1 2025) (LIST (`s 272B(3) an earlier offeree` OF (Date 1 6 2025), 10, TRUE, FALSE, TRUE, FALSE), (`s 272B(3) an earlier offeree` OF (Date 1 6 2025), 5, TRUE, FALSE, FALSE, TRUE), (`s 272B(3) an earlier offeree` OF (Date 1 6 2025), 4, FALSE, TRUE, FALSE, TRUE), (`s 272B(3) an earlier offeree` OF (Date 1 6 2025), 8, FALSE, FALSE, TRUE, FALSE))) EQUALS 14
#ASSERT (`s 272B(3) the number of persons to whom earlier offers were made that must be included` (Date 1 1 2025) EMPTY) EQUALS 0
-- the day after the window and the day before it are not counted; the last day of the window is
#ASSERT (`s 272B(3) the number of persons to whom earlier offers were made that must be included` (Date 1 1 2025) (LIST (`s 272B(3) an earlier offeree` OF (Date 1 1 2026), 10, TRUE, FALSE, TRUE, FALSE), (`s 272B(3) an earlier offeree` OF (Date 31 12 2024), 10, TRUE, FALSE, TRUE, FALSE))) EQUALS 0
#ASSERT (`s 272B(3) the number of persons to whom earlier offers were made that must be included` (Date 1 1 2025) (LIST (`s 272B(3) an earlier offeree` OF (Date 31 12 2025), 3, TRUE, FALSE, TRUE, FALSE))) EQUALS 3
#ASSERT (`s 272B(3) the number of persons to whom offers are made within the period of 12 months` 3 14) EQUALS 17
#ASSERT (`s 272B(4) the offer is a closely related offer` TRUE) EQUALS JUST TRUE
#ASSERT (`s 272B(4) the offer is a closely related offer` FALSE) EQUALS NOTHING
-- (1)(a) "no more than 50": exactly 50 is within, 51 is over; a prescribed number of 100 replaces it
#ASSERT (`s 272B(1)(a) the offers are made to no more than the applicable number of persons within the period of 12 months` 50 50) EQUALS JUST TRUE
#ASSERT (`s 272B(1)(a) the offers are made to no more than the applicable number of persons within the period of 12 months` 51 50) EQUALS JUST FALSE
#ASSERT (`s 272B(1)(a) the offers are made to no more than the applicable number of persons within the period of 12 months` 51 100) EQUALS JUST TRUE
#ASSERT (`s 272B(1)(b) none of the offers is accompanied by an advertisement` FALSE) EQUALS JUST TRUE
#ASSERT (`s 272B(1)(b) none of the offers is accompanied by an advertisement` TRUE) EQUALS JUST FALSE
-- (6) "advertisement" has the meaning given by section 272A(10)
#ASSERT (`s 272B(6) the communication is an advertisement for subsection (1)(b)` TRUE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 272B(6) the communication is an advertisement for subsection (1)(b)` TRUE TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 272B(1)(c) no selling or promotional expenses are paid or incurred other than those the paragraph allows` (LIST `s 272A(1)(d) an expense incurred for administrative or professional services`, `s 272A(1)(d)(iii)(A) a commission or fee for services rendered by a person licensed, approved, authorised or otherwise regulated under the laws of a foreign jurisdiction in respect of dealing in capital markets products that are securities or securities-based derivatives contracts`, `s 272A(1)(d)(iii)(B) a commission or fee for services rendered by a person exempted from those foreign laws, codes or requirements in respect of dealing in capital markets products that are securities or securities-based derivatives contracts`)) EQUALS JUST TRUE
#ASSERT (`s 272B(1)(c) no selling or promotional expenses are paid or incurred other than those the paragraph allows` (LIST `s 272A(1)(d) an expense incurred for administrative or professional services`, `s 272A(1)(d) any other selling or promotional expense`)) EQUALS JUST FALSE
#ASSERT (`s 272B(1)(c) no selling or promotional expenses are paid or incurred other than those the paragraph allows` EMPTY) EQUALS JUST TRUE
-- (1)(d): arguments: registered; expired under section 250; informed the Authority; took reasonable steps to inform the offeree
#ASSERT (`s 272B(1)(d) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 272B(1)(d) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 272B(1)(d) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
-- (ii)(A) and (B) are joined by "and": informing the Authority alone, or the offeree alone, is not enough
#ASSERT (`s 272B(1)(d) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 272B(1)(d) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 272B(1)(d) no prospectus is registered, or the registered prospectus has expired or the Authority and the offeree have been told` TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
