IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfaa-div1-directors`
IMPORT `sfaa-div1-beneficial-disclosure`

-- Tests for sfaa-div1-beneficial-disclosure.l4 (sections 137F and 137G). Every expected value is written from the text, beside the assertion.
-- Dates: 2 November 2026 is a Monday; 6 November 2026 is a public holiday in the example that has one.


§ `s 137F(1): the notice to a member (a power: not covered when a condition is missing)`
-- a corporation, a member, a written notice with a reasonable time
#ASSERT `s 137F(1) the corporation may require the member to give the information` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137F(1)(a) the corporation may require the member to inform it whether the member holds voting shares as beneficial owner or as trustee` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
-- not a corporation as section 130(2) reads the word; not a member; not in writing; no reasonable time; a member the caller could not state
#ASSERT `s 137F(1) the corporation may require the member to give the information` FALSE (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 137F(1) the corporation may require the member to give the information` TRUE (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 137F(1) the corporation may require the member to give the information` TRUE NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 137F(1) the corporation may require the member to give the information` TRUE (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 137F(1) the corporation may require the member to give the information` TRUE (JUST TRUE) TRUE FALSE EQUALS NOTHING
-- (b): only a member who holds the shares as trustee; a member who does not is outside the "if", and the function is named for a power, so the answer is NOTHING (the grant ruling of 2026-11-12, limit 1; the other reading is JUST FALSE)
#ASSERT `s 137F(1)(b) the corporation may require the member who holds the shares as trustee to indicate the persons for whom the member holds them` TRUE (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137F(1)(b) the corporation may require the member who holds the shares as trustee to indicate the persons for whom the member holds them` TRUE (JUST TRUE) TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 137F(1)(b) the corporation may require the member who holds the shares as trustee to indicate the persons for whom the member holds them` FALSE (JUST TRUE) TRUE TRUE TRUE EQUALS NOTHING

§ `s 137F(2): a further notice (a gated power, split site (ii), both readings)`
#ASSERT `s 137F(2) the corporation may require the other person to give the information` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137F(2)(a) the corporation may require the other person to inform it whether the person holds the interest as beneficial owner or as trustee` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- the corporation has not been informed that the person has an interest: not covered (the grant reading), where the "where" reading would say no
#ASSERT `s 137F(2) the corporation may require the other person to give the information` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 137F(2) the corporation may require the other person to give the information` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 137F(2)(b) the corporation may require the other person who holds the interest as trustee to indicate the persons for whom it is held` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137F(2)(b) the corporation may require the other person who holds the interest as trustee to indicate the persons for whom it is held` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING

§ `s 137F(3): control of voting rights by agreement or arrangement`
#ASSERT `s 137F(3) the corporation may require the member to inform it whether the voting rights are subject to an agreement or arrangement` TRUE (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137F(3) the corporation may require the member to inform it whether the voting rights are subject to an agreement or arrangement` TRUE (JUST FALSE) TRUE TRUE EQUALS NOTHING
-- particulars only "if so"; no agreement or arrangement is outside the "if" and the answer is NOTHING (the grant ruling, limit 1)
#ASSERT `s 137F(3) the corporation may require the member to give particulars of the agreement or arrangement and the parties to it` TRUE (JUST TRUE) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137F(3) the corporation may require the member to give particulars of the agreement or arrangement and the parties to it` TRUE (JUST TRUE) TRUE TRUE FALSE EQUALS NOTHING

§ `s 137F(4) to (7): the notice's content, the duty to comply, the register`
#ASSERT `s 137F(4) the notice contains the other information the Authority prescribes and is delivered as it prescribes` FALSE TRUE EQUALS NOTHING
#ASSERT `s 137F(4) the notice contains the other information the Authority prescribes and is delivered as it prescribes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137F(4) the notice contains the other information the Authority prescribes and is delivered as it prescribes` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 137F(5) the person must comply with the notice` TRUE EQUALS JUST TRUE
-- no notice issued to the person: "Any person to whom a notice is issued" says nothing about this person
#ASSERT `s 137F(5) the person must comply with the notice` FALSE EQUALS NOTHING
-- the notice allows 5 days: an answer on day 5 is in time, on day 6 not
-- EXPECT FULFILLED
#TRACE `s 137F(5) the person must comply with the notice within the time it specifies` (Individual "the member") 5 AT 0 WITH
    PARTY Individual "the member" DOES `s 137F comply with the notice` AT 5
-- EXPECT BREACH
#TRACE `s 137F(5) the person must comply with the notice within the time it specifies` (Individual "the member") 5 AT 0 WITH
    PARTY Individual "the member" DOES `s 137F comply with the notice` AT 6
-- EXPECT BREACH
#TRACE `s 137F(5) the person must comply with the notice within the time it specifies` (Individual "the member") 5 AT 0 WITH
    (WAITUNTIL 10)
-- (6): "Whenever" counts as "where": no information received, the text's no
#ASSERT `s 137F(6) the corporation must inscribe the fact of the requirement, its date and the information in a separate part of the register` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137F(6) the corporation must inscribe the fact of the requirement, its date and the information in a separate part of the register` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 137F(6) the corporation must inscribe the fact of the requirement, its date and the information in a separate part of the register` FALSE TRUE EQUALS NOTHING
#ASSERT `s 137F(7) section 137C applies to the separate part of the register` TRUE EQUALS JUST TRUE
#ASSERT `s 137F(7) section 137C applies to the separate part of the register` FALSE EQUALS NOTHING

§ `s 137F(8) to (11): offences, the defence and the bar`
-- split site (i), both readings, as in section 137D
#ASSERT `s 137F(8) the person is guilty of an offence under subsection (8)` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 137F(8) the person is guilty of an offence under subsection (8)` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 137F(8) the person is guilty of an offence under subsection (8)` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137F(8) the penalty on conviction` TRUE FALSE EQUALS JUST (Penalty OF 250000, 24, TRUE, 25000)
#ASSERT `s 137F(8) the penalty on conviction` FALSE TRUE EQUALS JUST (Penalty OF 250000, 0, FALSE, 25000)
#ASSERT `s 137F(9) the person is guilty of an offence under subsection (9)` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 137F(9) the person is guilty of an offence under subsection (9)` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 137F(9) the penalty on conviction` EQUALS Penalty OF 25000, 0, FALSE, 2500
-- the defence: the information was already in the corporation's possession, or the requirement was frivolous or vexatious
#ASSERT `s 137F(10) the person is not guilty of an offence under subsection (8)(a) or (9)(a)` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137F(10) the person is not guilty of an offence under subsection (8)(a) or (9)(a)` TRUE FALSE TRUE EQUALS JUST TRUE
-- neither proved: this section gives no defence on these facts
#ASSERT `s 137F(10) the person is not guilty of an offence under subsection (8)(a) or (9)(a)` TRUE FALSE FALSE EQUALS JUST FALSE
-- a charge for false information is outside the defence's wording
#ASSERT `s 137F(10) the person is not guilty of an offence under subsection (8)(a) or (9)(a)` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 137F(11) no proceedings may be instituted for an offence under section 137F` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137F(11) no proceedings may be instituted for an offence under section 137F` FALSE FALSE EQUALS JUST FALSE

§ `s 137G(1): the corporation's duty to disclose`
#ASSERT `s 137G(1)(a) the matter is one the paragraph names` `s 133(1)(a)(i) shares in the corporation` EQUALS JUST TRUE
#ASSERT `s 137G(1)(a) the matter is one the paragraph names` `s 133(1)(f) other securities or securities-based derivatives contracts the Authority prescribes` EQUALS JUST TRUE
-- paragraph (e) and the related-corporation paragraphs are not named: the paragraph is silent
#ASSERT `s 137G(1)(a) the matter is one the paragraph names` `s 133(1)(e)(i) participatory interests made available by the corporation` EQUALS NOTHING
#ASSERT `s 137G(1)(a) the matter is one the paragraph names` `s 133(1)(a)(ii) shares in a related corporation of the corporation` EQUALS NOTHING
-- notified by a substantial shareholder: the duty
#ASSERT `s 137G(1) the corporation must announce or disseminate the information stated in the notice` TRUE TRUE FALSE `s 133(1)(a)(i) shares in the corporation` TRUE EQUALS JUST TRUE
-- notified by a director about shares in the corporation: the duty
#ASSERT `s 137G(1) the corporation must announce or disseminate the information stated in the notice` TRUE TRUE TRUE `s 133(1)(a)(i) shares in the corporation` FALSE EQUALS JUST TRUE
-- notified by a director about a matter the paragraph does not name: not covered
#ASSERT `s 137G(1) the corporation must announce or disseminate the information stated in the notice` TRUE TRUE TRUE `s 133(1)(e)(i) participatory interests made available by the corporation` FALSE EQUALS NOTHING
-- not notified by anyone: "Where a corporation has been notified in writing" is not met, so the text's no
#ASSERT `s 137G(1) the corporation must announce or disseminate the information stated in the notice` TRUE TRUE FALSE `s 133(1)(a)(i) shares in the corporation` FALSE EQUALS JUST FALSE
-- not a corporation within section 130(2), or shares not listed: not covered
#ASSERT `s 137G(1) the corporation must announce or disseminate the information stated in the notice` FALSE TRUE FALSE `s 133(1)(a)(i) shares in the corporation` TRUE EQUALS NOTHING
#ASSERT `s 137G(1) the corporation must announce or disseminate the information stated in the notice` TRUE FALSE FALSE `s 133(1)(a)(i) shares in the corporation` TRUE EQUALS NOTHING
-- received Monday 2 Nov: the end of the next business day is Tuesday 3 Nov; with Tuesday 3 Nov a holiday, Wednesday 4 Nov
#ASSERT `s 137G(1) the last day for the announcement` (Date 2 11 2026) (LIST) EQUALS Date 3 11 2026
#ASSERT `s 137G(1) the last day for the announcement` (Date 2 11 2026) (LIST (Date 3 11 2026)) EQUALS Date 4 11 2026
-- received Friday 6 Nov: the next business day is Monday 9 Nov
#ASSERT `s 137G(1) the last day for the announcement` (Date 6 11 2026) (LIST) EQUALS Date 9 11 2026
#ASSERT `s 137G(1) the announcement is made in time` (Date 2 11 2026) (Date 3 11 2026) (LIST) EQUALS JUST TRUE
#ASSERT `s 137G(1) the announcement is made in time` (Date 2 11 2026) (Date 4 11 2026) (LIST) EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 137G(1) the corporation must announce or disseminate the information by the end of the next business day` (Individual "the corporation") AT 0 WITH
    PARTY Individual "the corporation" DOES `s 137G announce or disseminate the information stated in the notice` AT 1
-- EXPECT BREACH
#TRACE `s 137G(1) the corporation must announce or disseminate the information by the end of the next business day` (Individual "the corporation") AT 0 WITH
    PARTY Individual "the corporation" DOES `s 137G announce or disseminate the information stated in the notice` AT 2
-- EXPECT BREACH
#TRACE `s 137G(1) the corporation must announce or disseminate the information by the end of the next business day` (Individual "the corporation") AT 0 WITH
    (WAITUNTIL 5)
#ASSERT `s 137G(2) the corporation announces or disseminates the information in the form and manner the Authority prescribes` FALSE TRUE EQUALS NOTHING
#ASSERT `s 137G(2) the corporation announces or disseminates the information in the form and manner the Authority prescribes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137G(2) the corporation announces or disseminates the information in the form and manner the Authority prescribes` TRUE FALSE EQUALS JUST FALSE

§ `s 137G(3) to (7): the corporation's offences, the officers and the bar`
#ASSERT `s 137G(3) the person is guilty of an offence under subsection (3)` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 137G(3) the person is guilty of an offence under subsection (3)` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 137G(3) the person is guilty of an offence under subsection (3)` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137G(3) the penalty on conviction` EQUALS Penalty OF 250000, 0, FALSE, 25000
#ASSERT `s 137G(4) the person is guilty of an offence under subsection (4)` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 137G(4) the person is guilty of an offence under subsection (4)` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 137G(4) the penalty on conviction` EQUALS Penalty OF 25000, 0, FALSE, 2500
#ASSERT `s 137G(7) no proceedings may be instituted for an offence under section 137G` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137G(7) no proceedings may be instituted for an offence under section 137G` FALSE FALSE EQUALS JUST FALSE
-- (6): an officer is one of the listed holders of an office, or a person purporting to act in one of them
#ASSERT `s 137G(6) the person is an officer of the corporation` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137G(6) the person is an officer of the corporation` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 137G(6) the person is an officer of the corporation` FALSE FALSE EQUALS JUST FALSE
-- (5): an officer of a corporation that has committed the offence, who caused the contravention
#ASSERT `s 137G(5) the officer is within the subsection` TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 137G(5) the officer is within the subsection` FALSE FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING
-- the corporation has not committed an offence: not covered
#ASSERT `s 137G(5) the officer is within the subsection` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING
-- none of the three acts: not covered
#ASSERT `s 137G(5) the officer is within the subsection` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
-- (d): acted intentionally or recklessly; (e): acted negligently; each an "if"
#ASSERT `s 137G(5)(d) the officer is guilty of an offence for acting intentionally or recklessly` TRUE FALSE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 137G(5)(d) the officer is guilty of an offence for acting intentionally or recklessly` TRUE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 137G(5)(d) the officer is guilty of an offence for acting intentionally or recklessly` FALSE FALSE TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 137G(5)(d) the penalty on conviction` EQUALS Penalty OF 250000, 24, TRUE, 0
#ASSERT `s 137G(5)(e) the officer is guilty of an offence for acting negligently` TRUE FALSE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 137G(5)(e) the officer is guilty of an offence for acting negligently` TRUE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 137G(5)(e) the officer is guilty of an offence for acting negligently` FALSE FALSE TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 137G(5)(e) the penalty on conviction` EQUALS Penalty OF 25000, 0, FALSE, 0
