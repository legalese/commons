-- s 236(3A) the compensation amount ordered for the claimant
#ASSERT `s 236(3A) the compensation amount ordered for the claimant` 50000 100000 0 EQUALS 50000
#ASSERT `s 236(3A) the compensation amount ordered for the claimant` 50000 100000 150000 EQUALS 25000
#ASSERT `s 236(3A) the compensation amount ordered for the claimant` 20000 100000 80000 EQUALS 20000
#ASSERT `s 236(3A) the compensation amount ordered for the claimant` 0 100000 50000 EQUALS 0
#ASSERT `s 236(3A) the compensation amount ordered for the claimant` 30000 90000 60000 EQUALS 30000
#ASSERT `s 236(3A) the compensation amount ordered for the claimant` 60000 90000 60000 EQUALS 45000

-- s 232(6) the person on whom a civil penalty is imposed must pay it into the Consolidated Fund
-- EXPECT FULFILLED
#TRACE `s 232(6) the person on whom a civil penalty is imposed must pay it into the Consolidated Fund` 30 AT 0 WITH
    PARTY (Individual "the person on whom the civil penalty is imposed") DOES `s 232(6) pay the civil penalty into the Consolidated Fund` AT 30
-- EXPECT BREACH
#TRACE `s 232(6) the person on whom a civil penalty is imposed must pay it into the Consolidated Fund` 30 AT 0 WITH
    (WAITUNTIL 31)
-- EXPECT RESIDUAL
#TRACE `s 232(6) the person on whom a civil penalty is imposed must pay it into the Consolidated Fund` 30 AT 0 WITH
    (WAITUNTIL 29)

-- s 235(3) the claimant must comply with the court's directions on the filing and proof of the claim
-- EXPECT FULFILLED
#TRACE `s 235(3) the claimant must comply with the court's directions on the filing and proof of the claim` 14 AT 0 WITH
    PARTY (Individual "the claimant") DOES `s 235(3) comply with the court's directions on the filing and proof of the claim under section 236` AT 14
-- EXPECT BREACH
#TRACE `s 235(3) the claimant must comply with the court's directions on the filing and proof of the claim` 14 AT 0 WITH
    (WAITUNTIL 15)
-- EXPECT RESIDUAL
#TRACE `s 235(3) the claimant must comply with the court's directions on the filing and proof of the claim` 14 AT 0 WITH
    (WAITUNTIL 13)
