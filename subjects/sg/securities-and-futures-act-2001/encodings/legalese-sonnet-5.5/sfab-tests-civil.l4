#ASSERT `s 234(1) the contravening person is liable to pay compensation to the claimant` (JUST TRUE) TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 234(1) the contravening person is liable to pay compensation to the claimant` NOTHING TRUE (JUST TRUE) (JUST TRUE) EQUALS NOTHING  -- S
#ASSERT `s 234(1) the contravening person is liable to pay compensation to the claimant` (JUST FALSE) TRUE (JUST TRUE) (JUST TRUE) EQUALS NOTHING  -- S
#ASSERT `s 234(1) the contravening person is liable to pay compensation to the claimant` (JUST TRUE) FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE  -- S
#ASSERT `s 234(1) the contravening person is liable to pay compensation to the claimant` (JUST TRUE) TRUE NOTHING (JUST TRUE) EQUALS NOTHING  -- S
#ASSERT `s 234(1) the contravening person is liable to pay compensation to the claimant` (JUST TRUE) TRUE (JUST TRUE) NOTHING EQUALS NOTHING  -- S
#ASSERT `s 234(1) the contravening person is liable to pay compensation to the claimant` (JUST TRUE) TRUE NOTHING NOTHING EQUALS NOTHING  -- S

