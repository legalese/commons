IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfab-civil`

-- Tests for sfab-civil (Securities and Futures Act 2001, Part 12). Every expected value below is written from the text of the section named above it,
-- by hand, with the inputs that decide it; none is copied from output. Case order: the case that meets the provision, then each input taken away in turn,
-- then the case the text does not decide. A `#S` case is one that takes a branch marked SPLIT-SITE in the module.


-- s 232(1) the Authority may bring an action in a court against the person to seek an order for a civil penalty
#ASSERT `s 232(1) the Authority may bring an action in a court against the person to seek an order for a civil penalty` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 232(1) the Authority may bring an action in a court against the person to seek an order for a civil penalty` FALSE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 232(1) the Authority may bring an action in a court against the person to seek an order for a civil penalty` FALSE FALSE EQUALS JUST FALSE  -- S
#ASSERT `s 232(1) the Authority may bring an action in a court against the person to seek an order for a civil penalty` TRUE FALSE EQUALS NOTHING  -- S

-- s 232(2) the court may make an order against the person for the payment of a civil penalty
#ASSERT `s 232(2) the court may make an order against the person for the payment of a civil penalty` TRUE EQUALS JUST TRUE
#ASSERT `s 232(2) the court may make an order against the person for the payment of a civil penalty` FALSE EQUALS NOTHING  -- S

-- s 232(2) the highest civil penalty the court may order
#ASSERT `s 232(2) the highest civil penalty the court may order` 300000 2000000 EQUALS 2000000
#ASSERT `s 232(2) the highest civil penalty the court may order` 9000000 2000000 EQUALS 9000000
#ASSERT `s 232(2) the highest civil penalty the court may order` 2000000 2000000 EQUALS 2000000

-- s 232(2)(a) three times the profit gained or the loss avoided
#ASSERT `s 232(2)(a) three times the profit gained or the loss avoided` 1000000 0 EQUALS 3000000
#ASSERT `s 232(2)(a) three times the profit gained or the loss avoided` 0 400000 EQUALS 1200000
#ASSERT `s 232(2)(a) three times the profit gained or the loss avoided` 500000 700000 EQUALS 2100000
#ASSERT `s 232(2)(a) three times the profit gained or the loss avoided` 700000 500000 EQUALS 2100000
#ASSERT `s 232(2)(a) three times the profit gained or the loss avoided` 0 0 EQUALS 0

-- s 232(2)(b) the fixed amount in the cap
#ASSERT `s 232(2)(b) the fixed amount in the cap` EQUALS 2000000

-- s 232(3) the lowest civil penalty the court may order
#ASSERT `s 232(3) the lowest civil penalty the court may order` TRUE EQUALS 100000
#ASSERT `s 232(3) the lowest civil penalty the court may order` FALSE EQUALS 50000

-- s 232(2) and (3) the civil penalty ordered is within the limits
#ASSERT `s 232(2) and (3) the civil penalty ordered is within the limits` 150000 2000000 100000 EQUALS JUST TRUE
#ASSERT `s 232(2) and (3) the civil penalty ordered is within the limits` 2000000 2000000 100000 EQUALS JUST TRUE
#ASSERT `s 232(2) and (3) the civil penalty ordered is within the limits` 2000001 2000000 100000 EQUALS JUST FALSE
#ASSERT `s 232(2) and (3) the civil penalty ordered is within the limits` 100000 2000000 100000 EQUALS JUST TRUE
#ASSERT `s 232(2) and (3) the civil penalty ordered is within the limits` 99999 2000000 100000 EQUALS JUST FALSE
#ASSERT `s 232(2) and (3) the civil penalty ordered is within the limits` 50000 2000000 50000 EQUALS JUST TRUE
#ASSERT `s 232(2) and (3) the civil penalty ordered is within the limits` 49999 2000000 50000 EQUALS JUST FALSE

-- s 232(4) the court may make the order on the terms agreed between the Authority and the defendant despite subsections (2) and (3)
#ASSERT `s 232(4) the court may make the order on the terms agreed between the Authority and the defendant despite subsections (2) and (3)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 232(4) the court may make the order on the terms agreed between the Authority and the defendant despite subsections (2) and (3)` TRUE FALSE EQUALS NOTHING  -- S
#ASSERT `s 232(4) the court may make the order on the terms agreed between the Authority and the defendant despite subsections (2) and (3)` FALSE TRUE EQUALS NOTHING  -- S
#ASSERT `s 232(4) the court may make the order on the terms agreed between the Authority and the defendant despite subsections (2) and (3)` FALSE FALSE EQUALS NOTHING  -- S

-- s 232(5) section 232 does not prevent the Authority from entering into the agreement
#ASSERT `s 232(5) section 232 does not prevent the Authority from entering into the agreement` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 232(5) section 232 does not prevent the Authority from entering into the agreement` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 232(5) section 232 does not prevent the Authority from entering into the agreement` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 232(5) section 232 does not prevent the Authority from entering into the agreement` FALSE (JUST TRUE) EQUALS NOTHING

-- s 232(6) the civil penalty is to be treated as a judgment debt due to the Government
#ASSERT `s 232(6) the civil penalty is to be treated as a judgment debt due to the Government` TRUE EQUALS JUST TRUE
#ASSERT `s 232(6) the civil penalty is to be treated as a judgment debt due to the Government` FALSE EQUALS NOTHING

-- s 232(7) the Authority may recover the civil penalty on behalf of the Government as though it were a judgment debt due to the Authority
#ASSERT `s 232(7) the Authority may recover the civil penalty on behalf of the Government as though it were a judgment debt due to the Authority` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 232(7) the Authority may recover the civil penalty on behalf of the Government as though it were a judgment debt due to the Authority` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 232(7) the Authority may recover the civil penalty on behalf of the Government as though it were a judgment debt due to the Authority` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 232(7) the Authority may recover the civil penalty on behalf of the Government as though it were a judgment debt due to the Authority` FALSE FALSE EQUALS NOTHING  -- S

-- s 232(8) a defence available in a prosecution is also available to the defendant to the action
#ASSERT `s 232(8) a defence available in a prosecution is also available to the defendant to the action` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 232(8) a defence available in a prosecution is also available to the defendant to the action` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 232(8) a defence available in a prosecution is also available to the defendant to the action` NOTHING EQUALS NOTHING

-- s 233(1) the action under section 232 is barred because 6 years have expired from the date of the contravention
#ASSERT `s 233(1) the action under section 232 is barred because 6 years have expired from the date of the contravention` (Date 15 3 2020) (Date 15 3 2026) EQUALS JUST FALSE
#ASSERT `s 233(1) the action under section 232 is barred because 6 years have expired from the date of the contravention` (Date 15 3 2020) (Date 16 3 2026) EQUALS JUST TRUE
#ASSERT `s 233(1) the action under section 232 is barred because 6 years have expired from the date of the contravention` (Date 15 3 2020) (Date 1 1 2021) EQUALS JUST FALSE
#ASSERT `s 233(1) the action under section 232 is barred because 6 years have expired from the date of the contravention` (Date 15 3 2020) (Date 15 3 2020) EQUALS JUST FALSE
#ASSERT `s 233(1) the action under section 232 is barred because 6 years have expired from the date of the contravention` (Date 29 2 2020) (Date 28 2 2026) EQUALS JUST FALSE
#ASSERT `s 233(1) the action under section 232 is barred because 6 years have expired from the date of the contravention` (Date 29 2 2020) (Date 1 3 2026) EQUALS JUST TRUE

-- s 233(2) the action under section 232 is barred because the person has been convicted or acquitted
#ASSERT `s 233(2) the action under section 232 is barred because the person has been convicted or acquitted` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 233(2) the action under section 232 is barred because the person has been convicted or acquitted` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 233(2) the action under section 232 is barred because the person has been convicted or acquitted` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 233(2) the action under section 232 is barred because the person has been convicted or acquitted` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 233(2) the action under section 232 is barred because the person has been convicted or acquitted` TRUE TRUE TRUE EQUALS JUST TRUE

-- s 233(3) the action under section 232 must be stayed
#ASSERT `s 233(3) the action under section 232 must be stayed` TRUE EQUALS JUST TRUE
#ASSERT `s 233(3) the action under section 232 must be stayed` FALSE EQUALS NOTHING

-- s 233(3) the stayed action under section 232 may thereafter be continued
#ASSERT `s 233(3) the stayed action under section 232 may thereafter be continued` (JUST TRUE) (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 233(3) the stayed action under section 232 may thereafter be continued` (JUST TRUE) NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 233(3) the stayed action under section 232 may thereafter be continued` (JUST TRUE) NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 233(3) the stayed action under section 232 may thereafter be continued` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 233(3) the stayed action under section 232 may thereafter be continued` NOTHING (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 233(3) the stayed action under section 232 may thereafter be continued` (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING

-- s 233(3)(a) the person has been discharged in respect of the contravention and the discharge does not amount to an acquittal
#ASSERT `s 233(3)(a) the person has been discharged in respect of the contravention and the discharge does not amount to an acquittal` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 233(3)(a) the person has been discharged in respect of the contravention and the discharge does not amount to an acquittal` TRUE TRUE EQUALS NOTHING
#ASSERT `s 233(3)(a) the person has been discharged in respect of the contravention and the discharge does not amount to an acquittal` FALSE FALSE EQUALS NOTHING

-- s 233(3)(b) the charge against the person in respect of the contravention has been withdrawn
#ASSERT `s 233(3)(b) the charge against the person in respect of the contravention has been withdrawn` TRUE EQUALS JUST TRUE
#ASSERT `s 233(3)(b) the charge against the person in respect of the contravention has been withdrawn` FALSE EQUALS NOTHING

-- s 234(1)(a) the claimant had been dealing in capital markets products of the same description contemporaneously with the contravention
#ASSERT `s 234(1)(a) the claimant had been dealing in capital markets products of the same description contemporaneously with the contravention` TRUE EQUALS JUST TRUE
#ASSERT `s 234(1)(a) the claimant had been dealing in capital markets products of the same description contemporaneously with the contravention` FALSE EQUALS NOTHING

-- s 234(1)(b)(ii)(A) the price to compare is the price had the information been generally available
#ASSERT `s 234(1)(b)(ii)(A) the price to compare is the price had the information been generally available` TRUE EQUALS JUST TRUE
#ASSERT `s 234(1)(b)(ii)(A) the price to compare is the price had the information been generally available` FALSE EQUALS NOTHING

-- s 234(1)(b)(ii)(B) the price to compare is the price had the contravention not occurred
