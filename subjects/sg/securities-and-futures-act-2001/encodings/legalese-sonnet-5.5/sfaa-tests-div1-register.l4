IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfaa-div1-register`

-- Tests for sfaa-div1-register.l4 (section 137C). Every expected value is written from the text, beside the assertion.
-- Dates: 2 November 2026 is a Monday. The periods of 14 and 7 days are calendar days (sfa-periods P1: the day of the event is not counted).


§ `s 137C(1): keeping and entering`
#ASSERT `s 137C(1) the corporation must keep a register` TRUE EQUALS JUST TRUE
-- not a corporation as section 130(2) reads the word: "A corporation must keep a register" says nothing about it
#ASSERT `s 137C(1) the corporation must keep a register` FALSE EQUALS NOTHING
#ASSERT `s 137C(1) the corporation must immediately enter the names and information in the register` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 137C(1) the corporation must immediately enter the names and information in the register` TRUE FALSE EQUALS NOTHING
#ASSERT `s 137C(1) the corporation must immediately enter the names and information in the register` FALSE TRUE EQUALS NOTHING
-- "immediately" is read as a window of nought days (fork register A6): an entry on the day of receipt is in time, one a day later is not
-- EXPECT FULFILLED
#TRACE `s 137C(1) the corporation must immediately enter the names and information in the register` (Individual "the corporation") AT 0 WITH
    PARTY Individual "the corporation" DOES `s 137C enter the names and information in the register` AT 0
-- EXPECT BREACH
#TRACE `s 137C(1) the corporation must immediately enter the names and information in the register` (Individual "the corporation") AT 0 WITH
    PARTY Individual "the corporation" DOES `s 137C enter the names and information in the register` AT 1
-- EXPECT BREACH
#TRACE `s 137C(1) the corporation must immediately enter the names and information in the register` (Individual "the corporation") AT 0 WITH
    (WAITUNTIL 2)

§ `s 137C(2): where the register is kept, and what inspection costs`
-- a corporation with a registered office keeps it there; kept elsewhere is the text's no
#ASSERT `s 137C(2) the register is kept at the place the subsection requires` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 137C(2) the register is kept at the place the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
-- no registered office: the principal place of business in Singapore
#ASSERT `s 137C(2) the register is kept at the place the subsection requires` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 137C(2) the register is kept at the place the subsection requires` FALSE TRUE FALSE EQUALS JUST FALSE
-- a member inspects without charge; anyone else pays at most $2
#ASSERT `s 137C(2) the most the corporation may charge for each inspection of the register, in Singapore dollars` TRUE EQUALS 0
#ASSERT `s 137C(2) the most the corporation may charge for each inspection of the register, in Singapore dollars` FALSE EQUALS 2

§ `s 137C(3): copies`
-- $1 a page
#ASSERT `s 137C(3) the most the corporation may charge in advance for each page copied, in Singapore dollars` EQUALS 1
-- request received Monday 2 Nov: 14 days later is Monday 16 Nov
#ASSERT `s 137C(3) the last day for the corporation to send the copy` (Date 2 11 2026) FALSE (Date 23 11 2026) EQUALS Date 16 11 2026
-- the Authority has allowed a longer period, to 23 Nov: that day
#ASSERT `s 137C(3) the last day for the corporation to send the copy` (Date 2 11 2026) TRUE (Date 23 11 2026) EQUALS Date 23 11 2026
-- an allowed period that is not longer than 14 days changes nothing
#ASSERT `s 137C(3) the last day for the corporation to send the copy` (Date 2 11 2026) TRUE (Date 10 11 2026) EQUALS Date 16 11 2026
#ASSERT `s 137C(3) the copy is sent in time` (Date 2 11 2026) FALSE (Date 23 11 2026) (Date 16 11 2026) EQUALS JUST TRUE
#ASSERT `s 137C(3) the copy is sent in time` (Date 2 11 2026) FALSE (Date 23 11 2026) (Date 17 11 2026) EQUALS JUST FALSE
#ASSERT `s 137C(3) the copy is sent in time` (Date 2 11 2026) TRUE (Date 23 11 2026) (Date 23 11 2026) EQUALS JUST TRUE
#ASSERT `s 137C(3) the copy is sent in time` (Date 2 11 2026) TRUE (Date 23 11 2026) (Date 24 11 2026) EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 137C(3) the corporation must send the copy within 14 days` (Individual "the corporation") AT 0 WITH
    PARTY Individual "the corporation" DOES `s 137C send the copy of the register` AT 14
-- EXPECT BREACH
#TRACE `s 137C(3) the corporation must send the copy within 14 days` (Individual "the corporation") AT 0 WITH
    PARTY Individual "the corporation" DOES `s 137C send the copy of the register` AT 15
-- EXPECT BREACH
#TRACE `s 137C(3) the corporation must send the copy within 14 days` (Individual "the corporation") AT 0 WITH
    (WAITUNTIL 20)

§ `s 137C(4): the Authority's requirement`
#ASSERT `s 137C(4) the corporation must send the Authority a copy of the register` TRUE TRUE EQUALS JUST TRUE
-- no requirement: "The Authority may at any time in writing require" is not triggered
#ASSERT `s 137C(4) the corporation must send the Authority a copy of the register` TRUE FALSE EQUALS NOTHING
#ASSERT `s 137C(4) the corporation must send the Authority a copy of the register` FALSE TRUE EQUALS NOTHING
-- requirement received Monday 2 Nov: 7 days later is Monday 9 Nov
#ASSERT `s 137C(4) the last day for the corporation to send the copy to the Authority` (Date 2 11 2026) EQUALS Date 9 11 2026
#ASSERT `s 137C(4) the copy is sent to the Authority in time` (Date 2 11 2026) (Date 9 11 2026) EQUALS JUST TRUE
#ASSERT `s 137C(4) the copy is sent to the Authority in time` (Date 2 11 2026) (Date 10 11 2026) EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 137C(4) the corporation must send the Authority the copy within 7 days` (Individual "the corporation") AT 0 WITH
    PARTY Individual "the corporation" DOES `s 137C send the copy of the register` AT 7
-- EXPECT BREACH
#TRACE `s 137C(4) the corporation must send the Authority the copy within 7 days` (Individual "the corporation") AT 0 WITH
    PARTY Individual "the corporation" DOES `s 137C send the copy of the register` AT 8
-- EXPECT BREACH
#TRACE `s 137C(4) the corporation must send the Authority the copy within 7 days` (Individual "the corporation") AT 0 WITH
    (WAITUNTIL 10)

§ `s 137C(5): the offence`
-- split site (i), both readings: a failure is guilty; no failure is not read as innocent
#ASSERT `s 137C(5) the corporation is guilty of an offence of failing to comply with the register provisions` TRUE EQUALS JUST TRUE
#ASSERT `s 137C(5) the corporation is guilty of an offence of failing to comply with the register provisions` FALSE EQUALS NOTHING
#ASSERT `s 137C(5) the penalty on conviction` EQUALS Penalty OF 50000, 0, FALSE, 5000

§ `s 137C(6): what the corporation is not taken to know`
#ASSERT `s 137C(6) the corporation is not taken to have notice of, or to be put upon inquiry as to, a right in a share by reason of the thing done` TRUE EQUALS JUST TRUE
-- a thing done under another provision is outside the subsection
#ASSERT `s 137C(6) the corporation is not taken to have notice of, or to be put upon inquiry as to, a right in a share by reason of the thing done` FALSE EQUALS NOTHING
