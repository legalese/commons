IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-definitions-products`
IMPORT `sfac-239`

-- Tests for sfac-239.l4 (s 239, 239AA, 239A; s 239B is inert, reason 2).
-- Every expected value is written from the text of the Act (SFA2001.txt lines 37511 to 37946), before the code was run, and sits beside its assertion.
-- A boundary is tested on both sides. The arguments of a call are in the order of the function's GIVEN.

§ `s 239(1) "borrowing entity"`
-- means an entity that is or will be under a liability to repay money received in response to an invitation to subscribe for or purchase its debentures
#ASSERT (`s 239(1) "borrowing entity" the body is a borrowing entity` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "borrowing entity" the body is a borrowing entity` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "borrowing entity" the body is a borrowing entity` FALSE TRUE) EQUALS JUST FALSE

§ `s 239(1) "control"`
-- the capacity to determine the outcome; the capacity to influence that the law, a contract or a court order requires to be used for others is not control
#ASSERT (`s 239(1) "control" the person has control of the entity` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "control" the person has control of the entity` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "control" the person has control of the entity` FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "control" the person has control of the entity` FALSE TRUE) EQUALS JUST FALSE

§ `s 239(1) "dealing in capital markets products"`
-- (a) making or offering to make, or (b) inducing or attempting to induce, any agreement for or with a view to acquiring, disposing of ... any securities or securities-based derivatives contracts
#ASSERT (`s 239(1) "dealing in capital markets products" the activity is dealing in securities or securities-based derivatives contracts` TRUE TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "dealing in capital markets products" the activity is dealing in securities or securities-based derivatives contracts` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "dealing in capital markets products" the activity is dealing in securities or securities-based derivatives contracts` TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "dealing in capital markets products" the activity is dealing in securities or securities-based derivatives contracts` FALSE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "dealing in capital markets products" the activity is dealing in securities or securities-based derivatives contracts` TRUE TRUE FALSE FALSE) EQUALS JUST FALSE

§ `s 239(1) "debenture issuance programme"`
#ASSERT (`s 239(1) "debenture issuance programme" the arrangement is a debenture issuance programme` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "debenture issuance programme" the arrangement is a debenture issuance programme` TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "debenture issuance programme" the arrangement is a debenture issuance programme` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "debenture issuance programme" the arrangement is a debenture issuance programme` FALSE TRUE TRUE) EQUALS JUST FALSE

§ `s 239(1) "expert", "statutory meeting", "trust deed", "trust property", "deposit": meanings borrowed from other Acts`
#ASSERT (`s 239(1) "expert" the person is an expert` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "expert" the person is an expert` FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "statutory meeting" the meeting is a statutory meeting` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "statutory meeting" the meeting is a statutory meeting` FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "trust deed" the document is a trust deed` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "trust deed" the document is a trust deed` FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "trust property" the property is trust property` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "trust property" the property is trust property` FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(4) "deposit" the thing is a deposit` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(4) "deposit" the thing is a deposit` FALSE) EQUALS JUST FALSE

§ `s 239(1) "guarantor entity"`
#ASSERT (`s 239(1) "guarantor entity" the body is a guarantor entity of the borrowing entity` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "guarantor entity" the body is a guarantor entity of the borrowing entity` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "guarantor entity" the body is a guarantor entity of the borrowing entity` FALSE TRUE) EQUALS JUST FALSE

§ `s 239(1) "immediate family"`
-- the closed list: spouse, son, adopted son, stepson, daughter, adopted daughter, stepdaughter, father, stepfather, mother, stepmother, brother, stepbrother, sister or stepsister
#ASSERT (`s 239(1) "immediate family" the person is in the immediate family of the individual` `a spouse`) EQUALS JUST TRUE
#ASSERT (`s 239(1) "immediate family" the person is in the immediate family of the individual` `a stepsister`) EQUALS JUST TRUE
#ASSERT (`s 239(1) "immediate family" the person is in the immediate family of the individual` `an adopted daughter`) EQUALS JUST TRUE
#ASSERT (`s 239(1) "immediate family" the person is in the immediate family of the individual` `a stepfather`) EQUALS JUST TRUE
#ASSERT (`s 239(1) "immediate family" the person is in the immediate family of the individual` `some other relation`) EQUALS JUST FALSE

§ `s 239(1) "issuer"`
-- (a) the entity that issues or will issue; (b) the trustee-manager issuing units; (c) the trustee-manager issuing derivatives of units, or any other entity that issues them
#ASSERT (`s 239(1) "issuer" the person is the issuer in relation to the offer` `s 239(1) "issuer" an offer of securities or securities-based derivatives contracts other than units or derivatives of units in a business trust` TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "issuer" the person is the issuer in relation to the offer` `s 239(1) "issuer" an offer of securities or securities-based derivatives contracts other than units or derivatives of units in a business trust` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "issuer" the person is the issuer in relation to the offer` `s 239(1) "issuer" an offer of units in a business trust` FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "issuer" the person is the issuer in relation to the offer` `s 239(1) "issuer" an offer of units in a business trust` TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "issuer" the person is the issuer in relation to the offer` `s 239(1) "issuer" an offer of derivatives of units in a business trust` FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "issuer" the person is the issuer in relation to the offer` `s 239(1) "issuer" an offer of derivatives of units in a business trust` FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "issuer" the person is the issuer in relation to the offer` `s 239(1) "issuer" an offer of derivatives of units in a business trust` TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "issuer" the person is the issuer in relation to the offer` `s 239(1) "issuer" an offer of something else` TRUE TRUE TRUE TRUE) EQUALS NOTHING

§ `s 239(1) "minimum subscription"`
-- the amount a prospectus states as the minimum that must be raised, failing which nothing is allotted
#ASSERT (`s 239(1) "minimum subscription" the amount of the minimum subscription` TRUE TRUE 5000000) EQUALS JUST 5000000
#ASSERT (`s 239(1) "minimum subscription" the amount of the minimum subscription` TRUE FALSE 5000000) EQUALS NOTHING
#ASSERT (`s 239(1) "minimum subscription" the amount of the minimum subscription` FALSE FALSE 0) EQUALS NOTHING

§ `s 239(1) "preliminary document"`
#ASSERT (`s 239(1) "preliminary document" the document is a preliminary document` TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "preliminary document" the document is a preliminary document` FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "preliminary document" the document is a preliminary document` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "preliminary document" the document is a preliminary document` TRUE TRUE FALSE) EQUALS JUST FALSE

§ `s 239(1) "product highlights sheet", "profile statement", "replacement document", "supplementary document": pointers`
#ASSERT (`s 239(1) "product highlights sheet" the document is a product highlights sheet` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "product highlights sheet" the document is a product highlights sheet` FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "profile statement" the document is a profile statement` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "profile statement" the document is a profile statement` FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "replacement document" the document is a replacement document` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "replacement document" the document is a replacement document` FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "supplementary document" the document is a supplementary document` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "supplementary document" the document is a supplementary document` FALSE) EQUALS JUST FALSE

§ `s 239(1) "promoter"`
-- a promoter who was a party to the preparation; "does not include any person by reason only of the person acting in a professional capacity"
#ASSERT (`s 239(1) "promoter" the person is a promoter in relation to the prospectus` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "promoter" the person is a promoter in relation to the prospectus` TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "promoter" the person is a promoter in relation to the prospectus` TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "promoter" the person is a promoter in relation to the prospectus` FALSE TRUE FALSE) EQUALS JUST FALSE

§ `s 239(1) "prospectus"`
-- arguments: the document is a prospectus etc used to make an offer; is deemed a prospectus under s 257; is a profile statement; is authorised by s 251 (other than (5)); is a product highlights sheet
#ASSERT (`s 239(1) "prospectus" the document is a prospectus` TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "prospectus" the document is a prospectus` FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "prospectus" the document is a prospectus` TRUE FALSE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "prospectus" the document is a prospectus` TRUE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "prospectus" the document is a prospectus` TRUE FALSE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "prospectus" the document is a prospectus` FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "prospectus" the document is a prospectus` FALSE TRUE FALSE FALSE TRUE) EQUALS JUST FALSE

§ `s 239(1) "recognised securities exchange"`
#ASSERT (`s 239(1) "recognised securities exchange" the corporation is a recognised securities exchange` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "recognised securities exchange" the corporation is a recognised securities exchange` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "recognised securities exchange" the corporation is a recognised securities exchange` FALSE TRUE) EQUALS JUST FALSE

§ `s 239(1) "related party" (a): in relation to an entity`
-- (i) director; (ii) chief executive officer; (iii) controller; (iv) related corporation; (v) entity controlled by it; (vi) entity controlled by the controller; (vii) related party of an individual in (i), (ii) or (iii)
#ASSERT (`s 239(1) "related party" (a) the person is a related party of the entity` TRUE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "related party" (a) the person is a related party of the entity` FALSE TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "related party" (a) the person is a related party of the entity` FALSE FALSE TRUE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "related party" (a) the person is a related party of the entity` FALSE FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "related party" (a) the person is a related party of the entity` FALSE FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "related party" (a) the person is a related party of the entity` FALSE FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "related party" (a) the person is a related party of the entity` FALSE FALSE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "related party" (a) the person is a related party of the entity` FALSE FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE

§ `s 239(1) "related party" (b): in relation to an individual`
-- arguments: immediate family; trustee of a trust with the individual or family as beneficiary; trustee of a discretionary trust with them as discretionary object; the trustee acts in that capacity; the person is a corporation; votes the individual and family have interests in; total votes
-- (iii) "not less than 30%": 30 of 100 is in, 29 of 100 is out
#ASSERT (`s 239(1) "related party" (b) the person is a related party of the individual` TRUE FALSE FALSE FALSE FALSE 0 0) EQUALS JUST TRUE
#ASSERT (`s 239(1) "related party" (b) the person is a related party of the individual` FALSE TRUE FALSE TRUE FALSE 0 0) EQUALS JUST TRUE
#ASSERT (`s 239(1) "related party" (b) the person is a related party of the individual` FALSE FALSE TRUE TRUE FALSE 0 0) EQUALS JUST TRUE
#ASSERT (`s 239(1) "related party" (b) the person is a related party of the individual` FALSE TRUE FALSE FALSE FALSE 0 0) EQUALS JUST FALSE
#ASSERT (`s 239(1) "related party" (b) the person is a related party of the individual` FALSE FALSE FALSE FALSE TRUE 30 100) EQUALS JUST TRUE
#ASSERT (`s 239(1) "related party" (b) the person is a related party of the individual` FALSE FALSE FALSE FALSE TRUE 29 100) EQUALS JUST FALSE
#ASSERT (`s 239(1) "related party" (b) the person is a related party of the individual` FALSE FALSE FALSE FALSE TRUE 31 100) EQUALS JUST TRUE
#ASSERT (`s 239(1) "related party" (b) the person is a related party of the individual` FALSE FALSE FALSE FALSE FALSE 60 100) EQUALS JUST FALSE
#ASSERT (`s 239(1) "related party" (b) the person is a related party of the individual` FALSE FALSE FALSE FALSE TRUE 5 0) EQUALS JUST FALSE

§ `s 239(1) "underlying entity"`
#ASSERT (`s 239(1) "underlying entity" the body is the underlying entity of the offer` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "underlying entity" the body is the underlying entity of the offer` FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(1) "underlying entity" the body is the underlying entity of the offer` TRUE FALSE) EQUALS JUST FALSE

§ `s 239(1) "unit" of a share or debenture`
#ASSERT (`s 239(1) "unit" the thing is a unit of a share or debenture` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "unit" the thing is a unit of a share or debenture` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(1) "unit" the thing is a unit of a share or debenture` FALSE FALSE) EQUALS JUST FALSE

§ `s 239(2): a statement in a report or memorandum`
-- arguments: contained in a report or memorandum; appears on the face; incorporated by reference; issued with
#ASSERT (`s 239(2) the statement is deemed to be included in the prospectus or profile statement` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(2) the statement is deemed to be included in the prospectus or profile statement` TRUE FALSE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(2) the statement is deemed to be included in the prospectus or profile statement` TRUE FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(2) the statement is deemed to be included in the prospectus or profile statement` TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(2) the statement is deemed to be included in the prospectus or profile statement` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE

§ `s 239(3): an invitation to deposit or lend is deemed an offer of debentures; the acknowledgment is deemed a debenture`
#ASSERT (`s 239(3)(a) the invitation is deemed to be an offer of debentures of the entity` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(3)(a) the invitation is deemed to be an offer of debentures of the entity` FALSE) EQUALS NOTHING
#ASSERT (`s 239(3)(b) the document is deemed to be a debenture` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(3)(b) the document is deemed to be a debenture` TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 239(3)(b) the document is deemed to be a debenture` FALSE TRUE) EQUALS NOTHING

§ `s 239(3A): despite (3), a prescribed entity's deposit invitation is not an offer of debentures, and its deposit documents are not debentures`
#ASSERT (`s 239(3A)(a) the invitation by the prescribed entity is an offer of debentures` TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(3A)(a) the invitation by the prescribed entity is an offer of debentures` FALSE TRUE) EQUALS NOTHING
#ASSERT (`s 239(3A)(a) the invitation by the prescribed entity is an offer of debentures` TRUE FALSE) EQUALS NOTHING
-- arguments: the body is a prescribed entity; issued by it; is a certificate of deposit; acknowledges indebtedness for a deposit
#ASSERT (`s 239(3A)(b) the document issued by the prescribed entity is a debenture` TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(3A)(b) the document issued by the prescribed entity is a debenture` TRUE TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(3A)(b) the document issued by the prescribed entity is a debenture` TRUE TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 239(3A)(b) the document issued by the prescribed entity is a debenture` FALSE TRUE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 239(3A)(b) the document issued by the prescribed entity is a debenture` TRUE FALSE TRUE FALSE) EQUALS NOTHING
-- (3) and (3A)(a) together: (3A)(a) wins over (3)(a)
#ASSERT (`s 239(3) and (3A) the invitation to deposit or lend is an offer of debentures` (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 239(3) and (3A) the invitation to deposit or lend is an offer of debentures` (JUST TRUE) NOTHING) EQUALS JUST TRUE
#ASSERT (`s 239(3) and (3A) the invitation to deposit or lend is an offer of debentures` NOTHING NOTHING) EQUALS NOTHING
#ASSERT (`s 239(3) and (3A) the invitation to deposit or lend is an offer of debentures` NOTHING (JUST FALSE)) EQUALS JUST FALSE

§ `s 239(4): "prescribed entity"`
#ASSERT (`s 239(4) "prescribed entity" the body is a prescribed entity` TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(4) "prescribed entity" the body is a prescribed entity` FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(4) "prescribed entity" the body is a prescribed entity` FALSE FALSE) EQUALS JUST FALSE

§ `s 239(4A): a debenture issued by a trustee on behalf of a trust`
#ASSERT (`s 239(4A) the instrument is within the references to a debenture in this Division` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(4A) the instrument is within the references to a debenture in this Division` FALSE) EQUALS NOTHING

§ `s 239(5) and (5A): conditions imposed on a prescribed entity, and the offence`
-- arguments: the body is a prescribed entity; the Authority imposed the condition by written notice; the Authority has revoked it
#ASSERT (`s 239(5) the prescribed entity must comply with the condition or restriction` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(5) the prescribed entity must comply with the condition or restriction` TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239(5) the prescribed entity must comply with the condition or restriction` TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(5) the prescribed entity must comply with the condition or restriction` FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(5A) the person is guilty of an offence` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(5A) the person is guilty of an offence` FALSE) EQUALS NOTHING
-- the penalty: a fine not exceeding $50,000; no imprisonment; a further fine not exceeding $5,000 for every day or part of a day of a continuing offence
#ASSERT (`s 239(5A) the penalty for the offence`'s `penalty: the highest fine, in Singapore dollars`) EQUALS 50000
#ASSERT (`s 239(5A) the penalty for the offence`'s `penalty: the longest imprisonment, in months`) EQUALS 0
#ASSERT (`s 239(5A) the penalty for the offence`'s `penalty: the highest further fine for each day the offence continues, in Singapore dollars`) EQUALS 5000

-- EXPECT BREACH: the prescribed entity contravenes a condition (the prohibition is broken)
#TRACE (`s 239(5A) the prescribed entity shall not contravene a condition or restriction` (`A corporation` "The Bank")) AT 0 WITH
    PARTY (`A corporation` "The Bank") DOES `s 239(5) contravene the condition or restriction` AT 5

-- EXPECT RESIDUAL: no contravention has occurred, the prohibition is still standing
#TRACE (`s 239(5A) the prescribed entity shall not contravene a condition or restriction` (`A corporation` "The Bank")) AT 0 WITH
    PARTY (`A corporation` "The Bank") DOES `s 239(5) comply with the condition or restriction` AT 5

§ `s 239(6): when a person makes an offer`
-- arguments: acts as principal; makes an offer to a person in Singapore; on acceptance it would give rise to the contract; invites a person in Singapore to make an offer; that offer would on acceptance give rise to the contract
#ASSERT (`s 239(6) the person makes an offer of securities or securities-based derivatives contracts` TRUE TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239(6) the person makes an offer of securities or securities-based derivatives contracts` TRUE FALSE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(6) the person makes an offer of securities or securities-based derivatives contracts` FALSE TRUE TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(6) the person makes an offer of securities or securities-based derivatives contracts` TRUE TRUE FALSE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(6) the person makes an offer of securities or securities-based derivatives contracts` TRUE FALSE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239(6) the person makes an offer of securities or securities-based derivatives contracts` TRUE FALSE FALSE FALSE FALSE) EQUALS JUST FALSE

§ `s 239(7) and (8)`
#ASSERT (`s 239(7) the disposal is a sale for the purposes of subsection (6)` TRUE) EQUALS JUST TRUE
#ASSERT (`s 239(7) the disposal is a sale for the purposes of subsection (6)` FALSE) EQUALS NOTHING
-- "on or after 1 July 2002": the day itself is in, the day before is out
#ASSERT (`s 239(8) this Division applies to the offer` (Date 1 7 2002)) EQUALS JUST TRUE
#ASSERT (`s 239(8) this Division applies to the offer` (Date 30 6 2002)) EQUALS JUST FALSE
#ASSERT (`s 239(8) this Division applies to the offer` (Date 15 3 2026)) EQUALS JUST TRUE

§ `s 239AA(1): "depositary" and "SDR"`
#ASSERT (`s 239AA(1) "depositary" the person is the depositary in relation to the offer of SDRs` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239AA(1) "depositary" the person is the depositary in relation to the offer of SDRs` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239AA(1) "depositary" the person is the depositary in relation to the offer of SDRs` FALSE TRUE) EQUALS JUST FALSE
-- arguments: right to exchange; all or substantially all distributions; other financial benefits; issued under an agreement between depositary and issuer; prescribed by the Authority
#ASSERT (`s 239AA(1) "SDR" the instrument is an SDR or sponsored depositary receipt` TRUE TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239AA(1) "SDR" the instrument is an SDR or sponsored depositary receipt` TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239AA(1) "SDR" the instrument is an SDR or sponsored depositary receipt` FALSE TRUE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239AA(1) "SDR" the instrument is an SDR or sponsored depositary receipt` TRUE FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239AA(1) "SDR" the instrument is an SDR or sponsored depositary receipt` TRUE TRUE FALSE TRUE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239AA(1) "SDR" the instrument is an SDR or sponsored depositary receipt` TRUE TRUE TRUE FALSE TRUE) EQUALS JUST FALSE

§ `s 239AA(2): SDRs that are securities`
-- arguments: share; unit in a business trust; ownership interest; debenture; prescribed as securities; prescribed as not securities
#ASSERT (`s 239AA(2) the offer of SDRs is within the references to an offer of securities` TRUE FALSE FALSE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239AA(2) the offer of SDRs is within the references to an offer of securities` FALSE FALSE TRUE FALSE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239AA(2) the offer of SDRs is within the references to an offer of securities` FALSE FALSE FALSE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239AA(2) the offer of SDRs is within the references to an offer of securities` FALSE FALSE FALSE FALSE TRUE FALSE) EQUALS JUST TRUE
-- not excluded by paragraph (g): prescribed as not securities
#ASSERT (`s 239AA(2) the offer of SDRs is within the references to an offer of securities` TRUE FALSE FALSE FALSE FALSE TRUE) EQUALS JUST FALSE
-- none of paragraphs (a), (b) or (c): the text says nothing
#ASSERT (`s 239AA(2) the offer of SDRs is within the references to an offer of securities` FALSE FALSE FALSE FALSE FALSE FALSE) EQUALS NOTHING

§ `s 239AA(3) and (4): the issuer of the underlying securities stands in for the depositary`
-- arguments: an offer of SDRs by the depositary; the person is the issuer of the underlying securities (X); the person is the depositary (Y)
#ASSERT (`s 239AA(3)(a) the person is treated as the issuer of the SDRs being offered` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239AA(3)(a) the person is treated as the issuer of the SDRs being offered` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239AA(3)(a) the person is treated as the issuer of the SDRs being offered` TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT (`s 239AA(3)(a) the person is treated as the issuer of the SDRs being offered` FALSE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 239AA(3)(b) the person is treated as the person who makes the offer of the SDRs` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239AA(3)(b) the person is treated as the person who makes the offer of the SDRs` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239AA(3)(b) the person is treated as the person who makes the offer of the SDRs` FALSE TRUE FALSE) EQUALS NOTHING
#ASSERT (`s 239AA(3)(c) the person has the rights and duties under this Act of the issuer and of the person making the offer` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239AA(3)(c) the person has the rights and duties under this Act of the issuer and of the person making the offer` TRUE FALSE) EQUALS NOTHING
-- (4): subsection (3) prevails over section 239: where (3)(a) answers, that answer is the answer; where it is silent, section 239(1) "issuer" answers
#ASSERT (`s 239AA(4) the person is the issuer of the SDRs, section 239AA(3) prevailing over section 239` (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
#ASSERT (`s 239AA(4) the person is the issuer of the SDRs, section 239AA(3) prevailing over section 239` (JUST TRUE) (JUST FALSE)) EQUALS JUST TRUE
#ASSERT (`s 239AA(4) the person is the issuer of the SDRs, section 239AA(3) prevailing over section 239` NOTHING (JUST TRUE)) EQUALS JUST TRUE

§ `s 239A(1) and (2): the Division is disapplied`
-- arguments: both Divisions would apply but for s 239A; the Authority has by order in the Gazette declared that this Division does not apply to the offer or its class
#ASSERT (`s 239A(1) the Authority's declaration disapplies this Division to the offer` TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239A(1) the Authority's declaration disapplies this Division to the offer` TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239A(1) the Authority's declaration disapplies this Division to the offer` FALSE TRUE) EQUALS JUST FALSE
-- arguments: an offer of units or derivatives of units in a business trust; the trust is also a scheme authorised under s 286 or recognised under s 287; the trust is also a scheme; the offer is made in reliance on a Subdivision (4) exemption
#ASSERT (`s 239A(2) this Division does not apply to the offer of units or derivatives of units in a business trust` TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`s 239A(2) this Division does not apply to the offer of units or derivatives of units in a business trust` TRUE FALSE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`s 239A(2) this Division does not apply to the offer of units or derivatives of units in a business trust` TRUE FALSE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`s 239A(2) this Division does not apply to the offer of units or derivatives of units in a business trust` TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`s 239A(2) this Division does not apply to the offer of units or derivatives of units in a business trust` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE

§ `s 239A(1) and (2), s 239(8) and Subdivision (4): this Subdivision applies to the offer`
-- arguments: what s 239(8), s 239A(1) and s 239A(2) answer; whether Subdivision (4) exempts the offer
#ASSERT (`s 239A(1) and (2), s 239(8) and Subdivision (4): this Subdivision applies to the offer` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST TRUE
-- any one disapplication switches it off
#ASSERT (`s 239A(1) and (2), s 239(8) and Subdivision (4): this Subdivision applies to the offer` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 239A(1) and (2), s 239(8) and Subdivision (4): this Subdivision applies to the offer` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST FALSE)) EQUALS JUST FALSE
#ASSERT (`s 239A(1) and (2), s 239(8) and Subdivision (4): this Subdivision applies to the offer` (JUST TRUE) (JUST FALSE) (JUST FALSE) (JUST TRUE)) EQUALS JUST FALSE
-- an offer made before 1 July 2002 is outside the Division
#ASSERT (`s 239A(1) and (2), s 239(8) and Subdivision (4): this Subdivision applies to the offer` (JUST FALSE) (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS JUST FALSE
-- an answer nobody worked out stays NOTHING, unless another answer already disapplies
#ASSERT (`s 239A(1) and (2), s 239(8) and Subdivision (4): this Subdivision applies to the offer` (JUST TRUE) (JUST FALSE) (JUST FALSE) NOTHING) EQUALS NOTHING
#ASSERT (`s 239A(1) and (2), s 239(8) and Subdivision (4): this Subdivision applies to the offer` NOTHING (JUST FALSE) (JUST FALSE) (JUST FALSE)) EQUALS NOTHING
#ASSERT (`s 239A(1) and (2), s 239(8) and Subdivision (4): this Subdivision applies to the offer` NOTHING (JUST TRUE) (JUST FALSE) NOTHING) EQUALS JUST FALSE
