IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-seat`

-- ====================================================================================================
-- cases-seat questions from part keel (merged by the lead; unchanged text follows)
-- ====================================================================================================
-- Tests for sfa-seat-keel.
-- Expected values are written from the text of the Act (the quote lines in the module under test), never from its output.

-- I have an interest in voting shares carrying exactly 5% of all the votes
#ASSERT `Under section 2(4), do I have a substantial shareholding in the corporation` TRUE 5 100 EQUALS JUST TRUE
-- 4.99%: not less than 5% is not met
#ASSERT `Under section 2(4), do I have a substantial shareholding in the corporation` TRUE 499 10000 EQUALS JUST FALSE
-- I have no interest in a voting share, whatever the votes stated
#ASSERT `Under section 2(4), do I have a substantial shareholding in the corporation` FALSE 800 1000 EQUALS JUST FALSE

-- I hold 5% of the whole: (4) is met
#ASSERT (`Under section 2(6), am I a substantial shareholder in the corporation` WITH `the person has an interest or interests in one or more voting shares (excluding treasury shares) in the corporation` IS TRUE, `the total votes attached to the voting shares (excluding treasury shares) the person has an interest in` IS 5, `the total votes attached to all the voting shares (excluding treasury shares) in the corporation` IS 100, `the share capital of the corporation is divided into 2 or more classes of shares` IS FALSE, `the votes attached to the voting shares I have an interest in, in the class where my holding is largest` IS 0, `the votes attached to all the voting shares in that class, excluding treasury shares` IS 0) EQUALS JUST TRUE
-- only 1% of the whole, but 5% of one of two classes: (5) is met
#ASSERT (`Under section 2(6), am I a substantial shareholder in the corporation` WITH `the person has an interest or interests in one or more voting shares (excluding treasury shares) in the corporation` IS TRUE, `the total votes attached to the voting shares (excluding treasury shares) the person has an interest in` IS 10, `the total votes attached to all the voting shares (excluding treasury shares) in the corporation` IS 1000, `the share capital of the corporation is divided into 2 or more classes of shares` IS TRUE, `the votes attached to the voting shares I have an interest in, in the class where my holding is largest` IS 5, `the votes attached to all the voting shares in that class, excluding treasury shares` IS 100) EQUALS JUST TRUE
-- 1% of the whole and 4% of my class: neither (4) nor (5): the text does not say a person without a substantial shareholding is not a substantial shareholder
#ASSERT (`Under section 2(6), am I a substantial shareholder in the corporation` WITH `the person has an interest or interests in one or more voting shares (excluding treasury shares) in the corporation` IS TRUE, `the total votes attached to the voting shares (excluding treasury shares) the person has an interest in` IS 10, `the total votes attached to all the voting shares (excluding treasury shares) in the corporation` IS 1000, `the share capital of the corporation is divided into 2 or more classes of shares` IS TRUE, `the votes attached to the voting shares I have an interest in, in the class where my holding is largest` IS 4, `the votes attached to all the voting shares in that class, excluding treasury shares` IS 100) EQUALS NOTHING
-- one class, 1%: not a substantial shareholding, and subsection (6) is silent about it
#ASSERT (`Under section 2(6), am I a substantial shareholder in the corporation` WITH `the person has an interest or interests in one or more voting shares (excluding treasury shares) in the corporation` IS TRUE, `the total votes attached to the voting shares (excluding treasury shares) the person has an interest in` IS 10, `the total votes attached to all the voting shares (excluding treasury shares) in the corporation` IS 1000, `the share capital of the corporation is divided into 2 or more classes of shares` IS FALSE, `the votes attached to the voting shares I have an interest in, in the class where my holding is largest` IS 0, `the votes attached to all the voting shares in that class, excluding treasury shares` IS 0) EQUALS NOTHING

-- the other person is a corporation and this person is its secretary
#ASSERT (`Under section 3(1)(a), is this person a director, secretary or related corporation of the corporation` WITH `the other person is a corporation` IS TRUE, `the person is a director or secretary of the corporation` IS TRUE, `the person is a related corporation of the corporation` IS FALSE, `the person is a director or secretary of a related corporation of the corporation` IS FALSE) EQUALS JUST TRUE
-- a corporation, and this person is none of a director, secretary, related corporation or such a related corporation's director or secretary
#ASSERT (`Under section 3(1)(a), is this person a director, secretary or related corporation of the corporation` WITH `the other person is a corporation` IS TRUE, `the person is a director or secretary of the corporation` IS FALSE, `the person is a related corporation of the corporation` IS FALSE, `the person is a director or secretary of a related corporation of the corporation` IS FALSE) EQUALS JUST FALSE
-- the other person is not a corporation: paragraph (a) applies only where it is
#ASSERT (`Under section 3(1)(a), is this person a director, secretary or related corporation of the corporation` WITH `the other person is a corporation` IS FALSE, `the person is a director or secretary of the corporation` IS TRUE, `the person is a related corporation of the corporation` IS FALSE, `the person is a director or secretary of a related corporation of the corporation` IS FALSE) EQUALS JUST FALSE

-- an informal understanding by reason of which either of us may control the exercise of voting power
#ASSERT (`Under section 3(1)(b), does this person have an agreement about voting power with me` WITH `the matter is the extent of a power to exercise, or to control the exercise of, the voting power attached to voting shares in a corporation` IS TRUE, `the person has, or proposes to enter into with the other person, an agreement, arrangement, understanding or undertaking` IS TRUE, `by reason of it either of them may exercise or control, or substantially influence, the voting power attached to a share in the corporation` IS TRUE, `it is made with a view to controlling or influencing the composition of the board of directors, or the conduct of affairs, of the corporation` IS FALSE, `under it either of them may acquire shares in the corporation from the other, or may be required to dispose of such shares as the other directs` IS FALSE) EQUALS JUST TRUE
-- an agreement, but not one within (i), (ii) or (iii)
#ASSERT (`Under section 3(1)(b), does this person have an agreement about voting power with me` WITH `the matter is the extent of a power to exercise, or to control the exercise of, the voting power attached to voting shares in a corporation` IS TRUE, `the person has, or proposes to enter into with the other person, an agreement, arrangement, understanding or undertaking` IS TRUE, `by reason of it either of them may exercise or control, or substantially influence, the voting power attached to a share in the corporation` IS FALSE, `it is made with a view to controlling or influencing the composition of the board of directors, or the conduct of affairs, of the corporation` IS FALSE, `under it either of them may acquire shares in the corporation from the other, or may be required to dispose of such shares as the other directs` IS FALSE) EQUALS JUST FALSE
-- no agreement, arrangement, understanding or undertaking at all
#ASSERT (`Under section 3(1)(b), does this person have an agreement about voting power with me` WITH `the matter is the extent of a power to exercise, or to control the exercise of, the voting power attached to voting shares in a corporation` IS TRUE, `the person has, or proposes to enter into with the other person, an agreement, arrangement, understanding or undertaking` IS FALSE, `by reason of it either of them may exercise or control, or substantially influence, the voting power attached to a share in the corporation` IS FALSE, `it is made with a view to controlling or influencing the composition of the board of directors, or the conduct of affairs, of the corporation` IS FALSE, `under it either of them may acquire shares in the corporation from the other, or may be required to dispose of such shares as the other directs` IS TRUE) EQUALS JUST FALSE

-- we are acting in concert in relation to the matter
#ASSERT `Under section 3(1)(c), is this person acting in concert with me` TRUE EQUALS JUST TRUE
-- we are not
#ASSERT `Under section 3(1)(c), is this person acting in concert with me` FALSE EQUALS JUST FALSE

-- a fellow director, and nobody alleges association in proceedings
#ASSERT (`Under section 3(1)(d), is this person a fellow director or a trustee connected with me` WITH `the matter is a matter other than the extent of a power to exercise, or to control the exercise of, the voting power attached to voting shares in a corporation` IS TRUE, `the person is a director of a corporation of which the other person is a director` IS TRUE, `it is alleged in proceedings under this Act that the person was associated with the other person as a fellow director at a particular time` IS FALSE, `the person alleging the association proves that the person at that time knew or ought reasonably to have known the material particulars of the matter` IS FALSE, `the person is a trustee of a trust` IS FALSE, `the other person benefits, or is capable of benefiting, from the trust otherwise than by reason of transactions entered into in the ordinary course of business in connection with the lending of money` IS FALSE) EQUALS JUST TRUE
-- alleged in proceedings and knowledge not proved: section 3(2) bars the allegation
#ASSERT (`Under section 3(1)(d), is this person a fellow director or a trustee connected with me` WITH `the matter is a matter other than the extent of a power to exercise, or to control the exercise of, the voting power attached to voting shares in a corporation` IS TRUE, `the person is a director of a corporation of which the other person is a director` IS TRUE, `it is alleged in proceedings under this Act that the person was associated with the other person as a fellow director at a particular time` IS TRUE, `the person alleging the association proves that the person at that time knew or ought reasonably to have known the material particulars of the matter` IS FALSE, `the person is a trustee of a trust` IS FALSE, `the other person benefits, or is capable of benefiting, from the trust otherwise than by reason of transactions entered into in the ordinary course of business in connection with the lending of money` IS FALSE) EQUALS JUST FALSE
-- a trustee of a trust I benefit from other than through ordinary lending
#ASSERT (`Under section 3(1)(d), is this person a fellow director or a trustee connected with me` WITH `the matter is a matter other than the extent of a power to exercise, or to control the exercise of, the voting power attached to voting shares in a corporation` IS TRUE, `the person is a director of a corporation of which the other person is a director` IS FALSE, `it is alleged in proceedings under this Act that the person was associated with the other person as a fellow director at a particular time` IS FALSE, `the person alleging the association proves that the person at that time knew or ought reasonably to have known the material particulars of the matter` IS FALSE, `the person is a trustee of a trust` IS TRUE, `the other person benefits, or is capable of benefiting, from the trust otherwise than by reason of transactions entered into in the ordinary course of business in connection with the lending of money` IS TRUE) EQUALS JUST TRUE

-- the subsidiary legislation says so
#ASSERT `Under section 3(1)(e), does subsidiary legislation regard this person as associated with me` TRUE EQUALS JUST TRUE
-- none does
#ASSERT `Under section 3(1)(e), does subsidiary legislation regard this person as associated with me` FALSE EQUALS JUST FALSE

-- associated informally in another way
#ASSERT `Under section 3(1)(f), is this person associated with me in some other way` TRUE EQUALS JUST TRUE
-- not associated in any way
#ASSERT `Under section 3(1)(f), is this person associated with me in some other way` FALSE EQUALS JUST FALSE

-- I entered a transaction with a view to becoming associated with this person
#ASSERT `Under section 3(1)(g), have I acted with a view to becoming associated with this person` TRUE TRUE EQUALS JUST TRUE
-- a transaction, but not with that view
#ASSERT `Under section 3(1)(g), have I acted with a view to becoming associated with this person` TRUE FALSE EQUALS JUST FALSE

-- within paragraph (a)
#ASSERT (`Under section 3(1), is this person associated with me` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `this person is within paragraph (a) of section 3(1)` IS TRUE, `this person is within paragraph (b) of section 3(1)` IS FALSE, `this person is within paragraph (c) of section 3(1)` IS FALSE, `this person is within paragraph (d) of section 3(1)` IS FALSE, `this person is within paragraph (e) of section 3(1)` IS FALSE, `this person is within paragraph (f) of section 3(1)` IS FALSE, `this person is within paragraph (g) of section 3(1)` IS FALSE, `the association rests only on the circumstances in section 3(3)` IS FALSE) EQUALS JUST TRUE
-- within paragraph (d)
#ASSERT (`Under section 3(1), is this person associated with me` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `this person is within paragraph (a) of section 3(1)` IS FALSE, `this person is within paragraph (b) of section 3(1)` IS FALSE, `this person is within paragraph (c) of section 3(1)` IS FALSE, `this person is within paragraph (d) of section 3(1)` IS TRUE, `this person is within paragraph (e) of section 3(1)` IS FALSE, `this person is within paragraph (f) of section 3(1)` IS FALSE, `this person is within paragraph (g) of section 3(1)` IS FALSE, `the association rests only on the circumstances in section 3(3)` IS FALSE) EQUALS JUST TRUE
-- acting in concert
#ASSERT (`Under section 3(1), is this person associated with me` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `this person is within paragraph (a) of section 3(1)` IS FALSE, `this person is within paragraph (b) of section 3(1)` IS FALSE, `this person is within paragraph (c) of section 3(1)` IS TRUE, `this person is within paragraph (d) of section 3(1)` IS FALSE, `this person is within paragraph (e) of section 3(1)` IS FALSE, `this person is within paragraph (f) of section 3(1)` IS FALSE, `this person is within paragraph (g) of section 3(1)` IS FALSE, `the association rests only on the circumstances in section 3(3)` IS FALSE) EQUALS JUST TRUE
-- acting in concert only because of a section 3(3) circumstance: not taken to be associated
#ASSERT (`Under section 3(1), is this person associated with me` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `this person is within paragraph (a) of section 3(1)` IS FALSE, `this person is within paragraph (b) of section 3(1)` IS FALSE, `this person is within paragraph (c) of section 3(1)` IS TRUE, `this person is within paragraph (d) of section 3(1)` IS FALSE, `this person is within paragraph (e) of section 3(1)` IS FALSE, `this person is within paragraph (f) of section 3(1)` IS FALSE, `this person is within paragraph (g) of section 3(1)` IS FALSE, `the association rests only on the circumstances in section 3(3)` IS TRUE) EQUALS JUST FALSE
-- section 3(3) does not touch paragraph (a)
#ASSERT (`Under section 3(1), is this person associated with me` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `this person is within paragraph (a) of section 3(1)` IS TRUE, `this person is within paragraph (b) of section 3(1)` IS FALSE, `this person is within paragraph (c) of section 3(1)` IS TRUE, `this person is within paragraph (d) of section 3(1)` IS FALSE, `this person is within paragraph (e) of section 3(1)` IS FALSE, `this person is within paragraph (f) of section 3(1)` IS FALSE, `this person is within paragraph (g) of section 3(1)` IS FALSE, `the association rests only on the circumstances in section 3(3)` IS TRUE) EQUALS JUST TRUE
-- within no paragraph
#ASSERT (`Under section 3(1), is this person associated with me` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `this person is within paragraph (a) of section 3(1)` IS FALSE, `this person is within paragraph (b) of section 3(1)` IS FALSE, `this person is within paragraph (c) of section 3(1)` IS FALSE, `this person is within paragraph (d) of section 3(1)` IS FALSE, `this person is within paragraph (e) of section 3(1)` IS FALSE, `this person is within paragraph (f) of section 3(1)` IS FALSE, `this person is within paragraph (g) of section 3(1)` IS FALSE, `the association rests only on the circumstances in section 3(3)` IS FALSE) EQUALS JUST FALSE
-- "Unless the context otherwise requires"
#ASSERT (`Under section 3(1), is this person associated with me` WITH `the context of the provision otherwise requires a different meaning` IS TRUE, `this person is within paragraph (a) of section 3(1)` IS TRUE, `this person is within paragraph (b) of section 3(1)` IS FALSE, `this person is within paragraph (c) of section 3(1)` IS FALSE, `this person is within paragraph (d) of section 3(1)` IS FALSE, `this person is within paragraph (e) of section 3(1)` IS FALSE, `this person is within paragraph (f) of section 3(1)` IS FALSE, `this person is within paragraph (g) of section 3(1)` IS FALSE, `the association rests only on the circumstances in section 3(3)` IS FALSE) EQUALS NOTHING

-- this person only advises me in the proper performance of professional functions: not taken to be associated
#ASSERT (`Under section 3(3), am I taken to be associated with this person by virtue of paragraph (b), (c), (e) or (f) of section 3(1)` WITH `one of the two persons (B) provides advice to, or acts on behalf of, the other (A)` IS TRUE, `B does so in the proper performance of the functions attaching to B's professional capacity or B's business relationship with A` IS TRUE, `one of the two persons, a customer, gives specific instructions to the other (A)` IS FALSE, `A's ordinary business includes dealing in capital markets products` IS FALSE, `the instructions are to acquire shares on the customer's behalf in the ordinary course of that business` IS FALSE, `one of the two persons has sent, or proposes to send, the other (A) a take-over offer` IS FALSE, `one of the two persons has made, or proposes to make, offers under a take-over announcement within the meaning of the Take-over Code` IS FALSE, `it is in relation to shares held by A` IS FALSE, `one of the two persons has appointed the other (A) to vote as a proxy or representative at a meeting of members, or of a class of members, of a corporation` IS FALSE, `the appointment was for valuable consideration given by A or by an associate of A` IS FALSE, `the association rests on some ground other than the circumstances in paragraphs (a) to (d) of section 3(3)` IS FALSE) EQUALS JUST FALSE
-- only a customer's instruction to a dealer to buy shares in the ordinary course
#ASSERT (`Under section 3(3), am I taken to be associated with this person by virtue of paragraph (b), (c), (e) or (f) of section 3(1)` WITH `one of the two persons (B) provides advice to, or acts on behalf of, the other (A)` IS FALSE, `B does so in the proper performance of the functions attaching to B's professional capacity or B's business relationship with A` IS FALSE, `one of the two persons, a customer, gives specific instructions to the other (A)` IS TRUE, `A's ordinary business includes dealing in capital markets products` IS TRUE, `the instructions are to acquire shares on the customer's behalf in the ordinary course of that business` IS TRUE, `one of the two persons has sent, or proposes to send, the other (A) a take-over offer` IS FALSE, `one of the two persons has made, or proposes to make, offers under a take-over announcement within the meaning of the Take-over Code` IS FALSE, `it is in relation to shares held by A` IS FALSE, `one of the two persons has appointed the other (A) to vote as a proxy or representative at a meeting of members, or of a class of members, of a corporation` IS FALSE, `the appointment was for valuable consideration given by A or by an associate of A` IS FALSE, `the association rests on some ground other than the circumstances in paragraphs (a) to (d) of section 3(3)` IS FALSE) EQUALS JUST FALSE
-- only a take-over offer for shares I hold
#ASSERT (`Under section 3(3), am I taken to be associated with this person by virtue of paragraph (b), (c), (e) or (f) of section 3(1)` WITH `one of the two persons (B) provides advice to, or acts on behalf of, the other (A)` IS FALSE, `B does so in the proper performance of the functions attaching to B's professional capacity or B's business relationship with A` IS FALSE, `one of the two persons, a customer, gives specific instructions to the other (A)` IS FALSE, `A's ordinary business includes dealing in capital markets products` IS FALSE, `the instructions are to acquire shares on the customer's behalf in the ordinary course of that business` IS FALSE, `one of the two persons has sent, or proposes to send, the other (A) a take-over offer` IS TRUE, `one of the two persons has made, or proposes to make, offers under a take-over announcement within the meaning of the Take-over Code` IS FALSE, `it is in relation to shares held by A` IS TRUE, `one of the two persons has appointed the other (A) to vote as a proxy or representative at a meeting of members, or of a class of members, of a corporation` IS FALSE, `the appointment was for valuable consideration given by A or by an associate of A` IS FALSE, `the association rests on some ground other than the circumstances in paragraphs (a) to (d) of section 3(3)` IS FALSE) EQUALS JUST FALSE
-- only a proxy appointment without consideration
#ASSERT (`Under section 3(3), am I taken to be associated with this person by virtue of paragraph (b), (c), (e) or (f) of section 3(1)` WITH `one of the two persons (B) provides advice to, or acts on behalf of, the other (A)` IS FALSE, `B does so in the proper performance of the functions attaching to B's professional capacity or B's business relationship with A` IS FALSE, `one of the two persons, a customer, gives specific instructions to the other (A)` IS FALSE, `A's ordinary business includes dealing in capital markets products` IS FALSE, `the instructions are to acquire shares on the customer's behalf in the ordinary course of that business` IS FALSE, `one of the two persons has sent, or proposes to send, the other (A) a take-over offer` IS FALSE, `one of the two persons has made, or proposes to make, offers under a take-over announcement within the meaning of the Take-over Code` IS FALSE, `it is in relation to shares held by A` IS FALSE, `one of the two persons has appointed the other (A) to vote as a proxy or representative at a meeting of members, or of a class of members, of a corporation` IS TRUE, `the appointment was for valuable consideration given by A or by an associate of A` IS FALSE, `the association rests on some ground other than the circumstances in paragraphs (a) to (d) of section 3(3)` IS FALSE) EQUALS JUST FALSE
-- a proxy appointment for consideration is not a section 3(3) circumstance: the text says nothing
#ASSERT (`Under section 3(3), am I taken to be associated with this person by virtue of paragraph (b), (c), (e) or (f) of section 3(1)` WITH `one of the two persons (B) provides advice to, or acts on behalf of, the other (A)` IS FALSE, `B does so in the proper performance of the functions attaching to B's professional capacity or B's business relationship with A` IS FALSE, `one of the two persons, a customer, gives specific instructions to the other (A)` IS FALSE, `A's ordinary business includes dealing in capital markets products` IS FALSE, `the instructions are to acquire shares on the customer's behalf in the ordinary course of that business` IS FALSE, `one of the two persons has sent, or proposes to send, the other (A) a take-over offer` IS FALSE, `one of the two persons has made, or proposes to make, offers under a take-over announcement within the meaning of the Take-over Code` IS FALSE, `it is in relation to shares held by A` IS FALSE, `one of the two persons has appointed the other (A) to vote as a proxy or representative at a meeting of members, or of a class of members, of a corporation` IS TRUE, `the appointment was for valuable consideration given by A or by an associate of A` IS TRUE, `the association rests on some ground other than the circumstances in paragraphs (a) to (d) of section 3(3)` IS FALSE) EQUALS NOTHING
-- the association rests on another ground as well
#ASSERT (`Under section 3(3), am I taken to be associated with this person by virtue of paragraph (b), (c), (e) or (f) of section 3(1)` WITH `one of the two persons (B) provides advice to, or acts on behalf of, the other (A)` IS TRUE, `B does so in the proper performance of the functions attaching to B's professional capacity or B's business relationship with A` IS TRUE, `one of the two persons, a customer, gives specific instructions to the other (A)` IS FALSE, `A's ordinary business includes dealing in capital markets products` IS FALSE, `the instructions are to acquire shares on the customer's behalf in the ordinary course of that business` IS FALSE, `one of the two persons has sent, or proposes to send, the other (A) a take-over offer` IS FALSE, `one of the two persons has made, or proposes to make, offers under a take-over announcement within the meaning of the Take-over Code` IS FALSE, `it is in relation to shares held by A` IS FALSE, `one of the two persons has appointed the other (A) to vote as a proxy or representative at a meeting of members, or of a class of members, of a corporation` IS FALSE, `the appointment was for valuable consideration given by A or by an associate of A` IS FALSE, `the association rests on some ground other than the circumstances in paragraphs (a) to (d) of section 3(3)` IS TRUE) EQUALS NOTHING
-- no circumstance
#ASSERT (`Under section 3(3), am I taken to be associated with this person by virtue of paragraph (b), (c), (e) or (f) of section 3(1)` WITH `one of the two persons (B) provides advice to, or acts on behalf of, the other (A)` IS FALSE, `B does so in the proper performance of the functions attaching to B's professional capacity or B's business relationship with A` IS FALSE, `one of the two persons, a customer, gives specific instructions to the other (A)` IS FALSE, `A's ordinary business includes dealing in capital markets products` IS FALSE, `the instructions are to acquire shares on the customer's behalf in the ordinary course of that business` IS FALSE, `one of the two persons has sent, or proposes to send, the other (A) a take-over offer` IS FALSE, `one of the two persons has made, or proposes to make, offers under a take-over announcement within the meaning of the Take-over Code` IS FALSE, `it is in relation to shares held by A` IS FALSE, `one of the two persons has appointed the other (A) to vote as a proxy or representative at a meeting of members, or of a class of members, of a corporation` IS FALSE, `the appointment was for valuable consideration given by A or by an associate of A` IS FALSE, `the association rests on some ground other than the circumstances in paragraphs (a) to (d) of section 3(3)` IS FALSE) EQUALS NOTHING

-- I can instruct the sale
#ASSERT `Under section 4(1), do I have authority over the disposal of these securities, contracts or units` TRUE FALSE EQUALS JUST TRUE
-- I control the disposal informally, by an understanding with the registered holder
#ASSERT `Under section 4(1), do I have authority over the disposal of these securities, contracts or units` FALSE TRUE EQUALS JUST TRUE
-- I have no authority over their disposal
#ASSERT `Under section 4(1), do I have authority over the disposal of these securities, contracts or units` FALSE FALSE EQUALS JUST FALSE

-- the trust holds the securities and I know I am a beneficiary
#ASSERT `Under section 4(3), am I treated as having an interest through a trust` TRUE TRUE EQUALS JUST TRUE
-- the trust holds the securities but I neither know nor have reason to believe I am a beneficiary
#ASSERT `Under section 4(3), am I treated as having an interest through a trust` TRUE FALSE EQUALS JUST FALSE

-- a corporation holds them and its directors act on my wishes
#ASSERT `Under section 4(4), am I treated as having an interest through a corporation I direct or control` TRUE TRUE FALSE EQUALS JUST TRUE
-- a corporation holds them and I have a controlling interest in it
#ASSERT `Under section 4(4), am I treated as having an interest through a corporation I direct or control` TRUE FALSE TRUE EQUALS JUST TRUE
-- a corporation holds them but I neither direct nor control it
#ASSERT `Under section 4(4), am I treated as having an interest through a corporation I direct or control` TRUE FALSE FALSE EQUALS JUST FALSE

-- my associates and I can exercise exactly 20% of the votes
#ASSERT `Under section 4(5), am I treated as having an interest through a corporation in which my associates and I hold 20 percent of the votes` TRUE 20 100 EQUALS JUST TRUE
-- 19%
#ASSERT `Under section 4(5), am I treated as having an interest through a corporation in which my associates and I hold 20 percent of the votes` TRUE 19 100 EQUALS JUST FALSE

-- a subsidiary of mine
#ASSERT `Under section 4(6), is this person my associate for the purposes of section 4(5)` TRUE FALSE FALSE EQUALS JUST TRUE
-- accustomed to act on my directions about these securities
#ASSERT `Under section 4(6), is this person my associate for the purposes of section 4(5)` FALSE TRUE FALSE EQUALS JUST TRUE
-- none of the three
#ASSERT `Under section 4(6), is this person my associate for the purposes of section 4(5)` FALSE FALSE FALSE EQUALS JUST FALSE

-- I have contracted to buy them
#ASSERT (`Under section 4(7), am I treated as having an interest in one of the listed circumstances` WITH `the person has entered into a contract to purchase the thing` IS TRUE, `the person has a right to have the thing transferred to the person or to the person's order` IS FALSE, `the right is by reason of the person having an interest under a trust` IS FALSE, `the person has the right to acquire the thing under an option` IS FALSE, `the person has the right to acquire an interest in the thing under an option` IS FALSE, `the person is entitled to exercise, or to control the exercise of, a right attached to the thing` IS FALSE, `the person is entitled only by reason of having been appointed a proxy or representative to vote at a meeting of members of a corporation or of a class of its members` IS FALSE, `the person is the registered holder of the security or unit, or a party to the securities-based derivatives contract` IS FALSE) EQUALS JUST TRUE
-- I have a right to have them transferred to me, not by reason of a trust interest
#ASSERT (`Under section 4(7), am I treated as having an interest in one of the listed circumstances` WITH `the person has entered into a contract to purchase the thing` IS FALSE, `the person has a right to have the thing transferred to the person or to the person's order` IS TRUE, `the right is by reason of the person having an interest under a trust` IS FALSE, `the person has the right to acquire the thing under an option` IS FALSE, `the person has the right to acquire an interest in the thing under an option` IS FALSE, `the person is entitled to exercise, or to control the exercise of, a right attached to the thing` IS FALSE, `the person is entitled only by reason of having been appointed a proxy or representative to vote at a meeting of members of a corporation or of a class of its members` IS FALSE, `the person is the registered holder of the security or unit, or a party to the securities-based derivatives contract` IS FALSE) EQUALS JUST TRUE
-- the right is only by reason of an interest under a trust
#ASSERT (`Under section 4(7), am I treated as having an interest in one of the listed circumstances` WITH `the person has entered into a contract to purchase the thing` IS FALSE, `the person has a right to have the thing transferred to the person or to the person's order` IS TRUE, `the right is by reason of the person having an interest under a trust` IS TRUE, `the person has the right to acquire the thing under an option` IS FALSE, `the person has the right to acquire an interest in the thing under an option` IS FALSE, `the person is entitled to exercise, or to control the exercise of, a right attached to the thing` IS FALSE, `the person is entitled only by reason of having been appointed a proxy or representative to vote at a meeting of members of a corporation or of a class of its members` IS FALSE, `the person is the registered holder of the security or unit, or a party to the securities-based derivatives contract` IS FALSE) EQUALS JUST FALSE
-- I hold an option to acquire them
