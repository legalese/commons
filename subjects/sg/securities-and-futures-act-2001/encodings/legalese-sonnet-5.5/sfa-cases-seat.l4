#ASSERT (`Under section 270(3), may the trustee give written notice requiring the borrowing entity to repay the moneys` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 270(3), may the trustee give written notice requiring the borrowing entity to repay the moneys` FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 270(3), may the trustee give written notice requiring the borrowing entity to repay the moneys` TRUE FALSE TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 270(3), may the trustee give written notice requiring the borrowing entity to repay the moneys` FALSE TRUE FALSE) EQUALS JUST FALSE
