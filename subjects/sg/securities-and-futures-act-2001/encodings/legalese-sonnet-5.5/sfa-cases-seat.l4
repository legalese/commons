-- granted a day late
#ASSERT (`Under section 259(1), was permission to list the securities not applied for, or not granted, in time` TRUE (Date 2 3 2026) TRUE (Date 5 3 2026) TRUE (Date 14 4 2026) 0) EQUALS JUST TRUE
-- the prospectus does not state or imply an application to list
#ASSERT (`Under section 259(1), was permission to list the securities not applied for, or not granted, in time` FALSE (Date 2 3 2026) TRUE (Date 5 3 2026) TRUE (Date 13 4 2026) 0) EQUALS JUST FALSE
-- arguments: I make an allotment; the minimum subscription has been subscribed; the sum was received by cheque; the cheque has been paid; the sum was received otherwise than by cheque
-- minimum subscribed and the sum received
#ASSERT (`Under section 260(1), am I barred from making this allotment` TRUE TRUE FALSE FALSE TRUE) EQUALS JUST FALSE
-- only an unpaid cheque: the sum is treated as not received
#ASSERT (`Under section 260(1), am I barred from making this allotment` TRUE TRUE TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 260(1), am I barred from making this allotment` TRUE TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
