-- in two classes, so in a class
#ASSERT (`Under section 4A(1), is this person in this class of investor` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `the Authority has prescribed a modification of the definitions for the provision` IS FALSE, `the class of investor asked about` IS (`none of the classes in section 4A(1)`), `the investor is an accredited investor` IS TRUE, `the investor is an expert investor` IS TRUE, `the investor is an institutional investor` IS FALSE) EQUALS JUST FALSE
-- in none of the three
#ASSERT (`Under section 4A(1), is this person in this class of investor` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `the Authority has prescribed a modification of the definitions for the provision` IS FALSE, `the class of investor asked about` IS (`none of the classes in section 4A(1)`), `the investor is an accredited investor` IS FALSE, `the investor is an expert investor` IS FALSE, `the investor is an institutional investor` IS FALSE) EQUALS JUST TRUE
-- the Authority has modified the definitions for this provision: not among the sources
#ASSERT (`Under section 4A(1), is this person in this class of investor` WITH `the context of the provision otherwise requires a different meaning` IS FALSE, `the Authority has prescribed a modification of the definitions for the provision` IS TRUE, `the class of investor asked about` IS (`an institutional investor`), `the investor is an accredited investor` IS FALSE, `the investor is an expert investor` IS FALSE, `the investor is an institutional investor` IS TRUE) EQUALS NOTHING

-- worth $3 million, no loan: counts for $1 million
#ASSERT `Under section 4A(1A), what is the value of my primary residence to count in my net personal assets` 3000000 0 EQUALS 1000000
-- worth $3 million with a $2.5 million loan against it: $0.5 million
#ASSERT `Under section 4A(1A), what is the value of my primary residence to count in my net personal assets` 3000000 2500000 EQUALS 500000
-- worth $0.8 million: counts in full
#ASSERT `Under section 4A(1A), what is the value of my primary residence to count in my net personal assets` 800000 0 EQUALS 800000

-- a transitional licence under section 66 of the Commodity Trading Act 1992, and the activities are regulated and authorised by that section: the Act does not apply
#ASSERT `Under section 4B, does this Act apply to this person in respect of the activities` TRUE TRUE EQUALS JUST FALSE
-- a licence, but other activities: section 4B says nothing
#ASSERT `Under section 4B, does this Act apply to this person in respect of the activities` TRUE FALSE EQUALS NOTHING

-- ====================================================================================================
-- cases-seat questions from part sfaa (merged by the lead; unchanged text follows)
-- ====================================================================================================
-- Cases for sfaa-seat.l4: the individual's questions, asked with the facts a real person in the seat would state.
-- Every expected value is written from the text, beside the assertion. Dates: 2 November 2026 is a Monday; Friday 6 November is a public holiday in the cases that say so.
-- JUST TRUE is yes; JUST FALSE is the text's no in its own words; NOTHING is "the text does not say".
-- Names are invented: Mei Ling (a director), Raj (a chief executive officer), Ng (an employee), Priya and Daniel (shareholders), Samir and Anika (unitholders),
-- Omar (a holder of voting shares in a trustee-manager or responsible person), Kavita (an officer), Tom (the person the Authority may pursue), Lim (an advocate and solicitor), Lena (an offeror).
-- Each question has at least one case with the facts a real person would state, and one outside the encoding.


§ `Division 1: is this corporation within Division 1 (section 130(2))?`
-- Mei Ling asks about Orchid Holdings Ltd, a company whose shares are listed on an approved exchange: paragraph (a)
#ASSERT `Under section 130(2), is this corporation one to which Division 1 applies` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- Harbour Estates Corp is a corporation, not a company, and not a collective investment scheme, with a primary listing: paragraph (b)
#ASSERT `Under section 130(2), is this corporation one to which Division 1 applies` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
-- the same corporation with only a secondary listing: neither paragraph (the listing must be a primary listing)
#ASSERT `Under section 130(2), is this corporation one to which Division 1 applies` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- Kestrel Pte Ltd is a company with no listed shares: paragraph (a) needs a listing
#ASSERT `Under section 130(2), is this corporation one to which Division 1 applies` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- a collective investment scheme constituted as a corporation is excluded by paragraph (b)'s own words
#ASSERT `Under section 130(2), is this corporation one to which Division 1 applies` FALSE TRUE TRUE TRUE EQUALS JUST FALSE

§ `Division 1: an extension of time (section 131(6))`
-- Wei Jie's notice was due on Wednesday 4 November; the Authority extended the time on his application to Friday 13 November
#ASSERT `Under section 131(6), what is the last day for my notice, if the Authority has extended the time on my application` (Date 4 11 2026) TRUE (Date 13 11 2026) EQUALS Date 13 11 2026
-- no extension was given: the original day stands
#ASSERT `Under section 131(6), what is the last day for my notice, if the Authority has extended the time on my application` (Date 4 11 2026) FALSE (Date 13 11 2026) EQUALS Date 4 11 2026

§ `Division 1: a director or chief executive officer (sections 133 and 134)`
-- Mei Ling is a director of Orchid Holdings Ltd and holds shares in it
#ASSERT `Under section 133(1), must I give the corporation written notice of my interests as a director or chief executive officer` TRUE TRUE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE EQUALS JUST TRUE
-- Raj is Orchid's chief executive officer and holds shares in it
#ASSERT `Under section 133(1), must I give the corporation written notice of my interests as a director or chief executive officer` TRUE FALSE TRUE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE EQUALS JUST TRUE
-- Raj holds shares in a related corporation: that paragraph applies only to a director of a company, so the Act's own words say no to a chief executive officer
#ASSERT `Under section 133(1), must I give the corporation written notice of my interests as a director or chief executive officer` TRUE FALSE TRUE TRUE `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE EQUALS JUST FALSE
-- Mei Ling, a director of a company, holds shares in a related corporation: within the paragraph
#ASSERT `Under section 133(1), must I give the corporation written notice of my interests as a director or chief executive officer` TRUE TRUE FALSE TRUE `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE EQUALS JUST TRUE
-- Ng is an employee, neither a director nor a chief executive officer: the section is silent about her
#ASSERT `Under section 133(1), must I give the corporation written notice of my interests as a director or chief executive officer` TRUE FALSE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE EQUALS NOTHING
-- Mei Ling asks about a corporation that Division 1 does not reach: not covered
#ASSERT `Under section 133(1), must I give the corporation written notice of my interests as a director or chief executive officer` FALSE TRUE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE EQUALS NOTHING
-- Mei Ling holds nothing and nothing has changed: the duty is not triggered
#ASSERT `Under section 133(1), must I give the corporation written notice of my interests as a director or chief executive officer` TRUE TRUE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` FALSE EQUALS NOTHING
-- Mei Ling learned of a change on Monday 2 Nov, but with reasonable diligence she would have known on Friday 30 Oct: the earlier day starts the count, two business days on is Tuesday 3 Nov
#ASSERT `Under section 133(3)(b)(i), what is the last day for my notice of a change in my interests` (Date 2 11 2026) (Date 30 10 2026) (LIST) EQUALS Date 3 11 2026
-- she learned of it on Monday 2 Nov and no earlier day applies: Wednesday 4 Nov
#ASSERT `Under section 133(3)(b)(i), what is the last day for my notice of a change in my interests` (Date 2 11 2026) (Date 2 11 2026) (LIST) EQUALS Date 4 11 2026
-- she learned of it on Wednesday 4 Nov and Friday 6 Nov is a public holiday: Monday 9 Nov
#ASSERT `Under section 133(3)(b)(i), what is the last day for my notice of a change in my interests` (Date 4 11 2026) (Date 4 11 2026) (LIST (Date 6 11 2026)) EQUALS Date 9 11 2026
-- Raj became chief executive officer on Monday 2 Nov and acquired the interest on Wednesday 4 Nov: two business days after the later event is Friday 6 Nov
#ASSERT `Under section 133(3)(b)(ii), what is the last day for my first notice of my interests` (Date 2 11 2026) (Date 4 11 2026) (LIST) EQUALS Date 6 11 2026
-- the same events in the other order, with Friday 6 Nov a public holiday: Monday 9 Nov
#ASSERT `Under section 133(3)(b)(ii), what is the last day for my first notice of my interests` (Date 4 11 2026) (Date 2 11 2026) (LIST (Date 6 11 2026)) EQUALS Date 9 11 2026
-- Mei Ling's husband, who is not a director, holds Orchid shares: she is deemed to have the interest
#ASSERT `Under section 133(4)(a), am I deemed to have my family member's interest in securities or securities-based derivatives contracts` `a spouse` 45 FALSE TRUE EQUALS JUST TRUE
-- her son, aged 20, holds Orchid shares: a child below 21 is a family member
#ASSERT `Under section 133(4)(a), am I deemed to have my family member's interest in securities or securities-based derivatives contracts` `a son` 20 FALSE TRUE EQUALS JUST TRUE
-- her son, aged 21, is not a family member as section 133(6) defines it: section 133(4)(a) does not reach him
#ASSERT `Under section 133(4)(a), am I deemed to have my family member's interest in securities or securities-based derivatives contracts` `a son` 21 FALSE TRUE EQUALS NOTHING
-- her husband holds nothing: the deeming needs him to hold an interest (marginal reading (a))
#ASSERT `Under section 133(4)(a), am I deemed to have my family member's interest in securities or securities-based derivatives contracts` `a spouse` 45 FALSE FALSE EQUALS JUST FALSE
-- her husband is himself a director of Orchid: the paragraph carves him out
#ASSERT `Under section 133(4)(a), am I deemed to have my family member's interest in securities or securities-based derivatives contracts` `a spouse` 45 TRUE TRUE EQUALS NOTHING
-- her mother is not within the defined list
#ASSERT `Under section 133(4)(a), am I deemed to have my family member's interest in securities or securities-based derivatives contracts` `a mother` 60 FALSE TRUE EQUALS NOTHING
-- Raj knew of his duty and deliberately gave no notice about his Orchid shares
#ASSERT `Under section 134(1), am I guilty of an offence for failing to notify the corporation, or for giving it false or misleading information` `s 133(1)(a)(i) shares in the corporation` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- Raj simply forgot: subsection (1) is for intentional or reckless failures, so section 134(1) does not say he is guilty (subsection (2), the lesser offence, is a layer-1 question)
#ASSERT `Under section 134(1), am I guilty of an offence for failing to notify the corporation, or for giving it false or misleading information` `s 133(1)(a)(i) shares in the corporation` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- Raj gave a notice he knew was false in a material particular
#ASSERT `Under section 134(1), am I guilty of an offence for failing to notify the corporation, or for giving it false or misleading information` `s 133(1)(a)(i) shares in the corporation` FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- the matter is a related corporation's shares, which subsection (1) does not name
#ASSERT `Under section 134(1), am I guilty of an offence for failing to notify the corporation, or for giving it false or misleading information` `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING
-- he contravened nothing
#ASSERT `Under section 134(1), am I guilty of an offence for failing to notify the corporation, or for giving it false or misleading information` `s 133(1)(a)(i) shares in the corporation` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Division 1: a substantial shareholder (sections 135 to 137B)`
-- Priya holds 12 percent of Orchid and is a substantial shareholder
#ASSERT `Under section 135(1), must I give the corporation written notice of particulars of my voting shares` TRUE TRUE FALSE EQUALS JUST TRUE
-- Priya sold down last week and is no longer a substantial shareholder: the duty to give particulars remains
#ASSERT `Under section 135(1), must I give the corporation written notice of particulars of my voting shares` TRUE FALSE TRUE EQUALS JUST TRUE
-- Daniel holds 3 percent and never was a substantial shareholder: not covered
#ASSERT `Under section 135(1), must I give the corporation written notice of particulars of my voting shares` TRUE FALSE FALSE EQUALS NOTHING
-- Priya asks about a corporation that Division 1 does not reach
#ASSERT `Under section 135(1), must I give the corporation written notice of particulars of my voting shares` FALSE TRUE FALSE EQUALS NOTHING
-- Priya learned of her position on Monday 2 Nov: Wednesday 4 Nov
#ASSERT `Under section 135(2)(b), what is the last day for my notice of particulars of my voting shares` (Date 2 11 2026) (Date 2 11 2026)(LIST) EQUALS Date 4 11 2026
-- with reasonable diligence she would have known on Friday 30 Oct: Tuesday 3 Nov
#ASSERT `Under section 135(2)(b), what is the last day for my notice of particulars of my voting shares` (Date 2 11 2026) (Date 30 10 2026) (LIST) EQUALS Date 3 11 2026
-- Priya's interests rose from 14 to 16 percent
#ASSERT `Under section 136(1), must I give the corporation written notice of a change in the percentage level of my interests` TRUE TRUE 14 16 EQUALS JUST TRUE
-- her interests stayed at 15 percent: no change in the percentage level, the Act's own words
#ASSERT `Under section 136(1), must I give the corporation written notice of a change in the percentage level of my interests` TRUE TRUE 15 15 EQUALS JUST FALSE
-- Daniel is not a substantial shareholder: the section is silent about him
#ASSERT `Under section 136(1), must I give the corporation written notice of a change in the percentage level of my interests` TRUE FALSE 14 16 EQUALS NOTHING
-- Priya learned of the change on Monday 2 Nov: Wednesday 4 Nov
#ASSERT `Under section 136(1), what is the last day for my notice of a change in the percentage level of my interests` (Date 2 11 2026) (Date 2 11 2026) (LIST) EQUALS Date 4 11 2026
-- Priya sells until she holds 4 percent and ceases to be a substantial shareholder
#ASSERT `Under section 137(1), must I give the corporation written notice that I have ceased to be a substantial shareholder` TRUE TRUE EQUALS JUST TRUE
-- Priya does not cease to be one: the section is silent
#ASSERT `Under section 137(1), must I give the corporation written notice that I have ceased to be a substantial shareholder` TRUE FALSE EQUALS NOTHING
-- she learned she had ceased on Monday 2 Nov: Wednesday 4 Nov
#ASSERT `Under section 137(1), what is the last day for my notice that I have ceased to be a substantial shareholder` (Date 2 11 2026) (Date 2 11 2026) (LIST) EQUALS Date 4 11 2026
-- Daniel authorised a broker to hold and deal in the shares for him, and the broker has bought shares: he must take reasonable steps to ensure the broker notifies him
#ASSERT `Under section 137A, must I take reasonable steps to ensure that the person acting for me gives me notice of an acquisition or disposal` TRUE TRUE EQUALS JUST TRUE
-- the broker has not yet bought or sold anything: not covered
#ASSERT `Under section 137A, must I take reasonable steps to ensure that the person acting for me gives me notice of an acquisition or disposal` TRUE FALSE EQUALS NOTHING
-- Daniel gave nobody authority and the shares were acquired by someone else: the duty rests on a person who authorised another
#ASSERT `Under section 137A, must I take reasonable steps to ensure that the person acting for me gives me notice of an acquisition or disposal` FALSE TRUE EQUALS JUST FALSE
-- Daniel's broker holds Orchid shares in which Priya has an interest, and the broker has bought more: the broker must give Priya notice
#ASSERT `Under section 137B, must I give the other person notice of my acquisition or disposal of voting shares` TRUE TRUE EQUALS JUST TRUE
-- the broker has not bought or sold: not covered
#ASSERT `Under section 137B, must I give the other person notice of my acquisition or disposal of voting shares` TRUE FALSE EQUALS NOTHING
-- the broker holds no shares in which anyone else has an interest: no duty to give notice to another person
#ASSERT `Under section 137B, must I give the other person notice of my acquisition or disposal of voting shares` FALSE TRUE EQUALS JUST FALSE

§ `Division 1: what follows if I do not (sections 137D to 137G)`
-- Priya deliberately gave no notice of her shares
#ASSERT `Under section 137D(1), am I guilty of an offence for failing to notify as a substantial shareholder, or for giving false or misleading information` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- she forgot: section 137D(1) is for intentional or reckless contraventions, so it does not say she is guilty
#ASSERT `Under section 137D(1), am I guilty of an offence for failing to notify as a substantial shareholder, or for giving false or misleading information` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- she gave a notice she knew was false in a material particular
#ASSERT `Under section 137D(1), am I guilty of an offence for failing to notify as a substantial shareholder, or for giving false or misleading information` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- she contravened nothing
#ASSERT `Under section 137D(1), am I guilty of an offence for failing to notify as a substantial shareholder, or for giving false or misleading information` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- Priya, an individual, is convicted: a fine of up to $250,000 (and imprisonment, which layer 1 records)
#ASSERT `Under section 137D(1), what is the most I can be fined on conviction` TRUE FALSE EQUALS JUST 250000
-- a corporation is convicted: the same limit on the fine
#ASSERT `Under section 137D(1), what is the most I can be fined on conviction` FALSE TRUE EQUALS JUST 250000
-- the caller says the person is neither: the section does not say
#ASSERT `Under section 137D(1), what is the most I can be fined on conviction` FALSE FALSE EQUALS NOTHING
-- Priya is a substantial shareholder who failed to give notice, and the Authority has applied to the court: the court has power to make the orders listed
#ASSERT `Under section 137E(1), may the court make an order against me for failing to notify as a substantial shareholder` TRUE TRUE TRUE EQUALS JUST TRUE
-- the Authority has not applied: the power is gated by the application, so the Act does not say (the split site of NOTES.md, fork B3)
#ASSERT `Under section 137E(1), may the court make an order against me for failing to notify as a substantial shareholder` TRUE TRUE FALSE EQUALS NOTHING
-- Orchid has served Priya a notice under section 137F asking who holds her shares: she must comply
#ASSERT `Under section 137F(5), must I comply with the corporation's notice asking about my interest in its voting shares` TRUE EQUALS JUST TRUE
-- nobody has served her a notice: the duty is not triggered
#ASSERT `Under section 137F(5), must I comply with the corporation's notice asking about my interest in its voting shares` FALSE EQUALS NOTHING
-- Priya deliberately refused to answer Orchid's notice
#ASSERT `Under section 137F(8), am I guilty of an offence for not complying with the corporation's notice, or for giving false or misleading information` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- she answered late by mistake: not an intentional or reckless contravention
#ASSERT `Under section 137F(8), am I guilty of an offence for not complying with the corporation's notice, or for giving false or misleading information` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- Priya, an individual, is convicted under section 137F(8): a fine of up to $250,000
#ASSERT `Under section 137F(8), what is the most I can be fined on conviction` TRUE FALSE EQUALS JUST 250000
-- Orchid itself, a corporation, is convicted: the same limit
#ASSERT `Under section 137F(8), what is the most I can be fined on conviction` FALSE TRUE EQUALS JUST 250000
-- Kavita, a director of Orchid, caused it to fail to announce Priya's notice, intentionally, and Orchid has committed the offence
#ASSERT `Under section 137G(5)(d), am I, as an officer, guilty of an offence because the corporation failed to announce a notice, or announced false information, intentionally or recklessly` TRUE FALSE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- Kavita acted without intent or recklessness: not within paragraph (d) (paragraph (e), negligence, is a layer-1 question)
#ASSERT `Under section 137G(5)(d), am I, as an officer, guilty of an offence because the corporation failed to announce a notice, or announced false information, intentionally or recklessly` TRUE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- Ng is not an officer: the subsection is silent about her
#ASSERT `Under section 137G(5)(d), am I, as an officer, guilty of an offence because the corporation failed to announce a notice, or announced false information, intentionally or recklessly` FALSE FALSE TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING

§ `Division 2: business trusts (sections 137H to 137R)`
-- Harbour Business Trust is registered and its units are listed
#ASSERT `Under section 137H, is this business trust one to which Division 2 applies` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- Estuary Trust is a recognised business trust with a primary listing
#ASSERT `Under section 137H, is this business trust one to which Division 2 applies` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- a recognised business trust with only a secondary listing is outside paragraph (3)
#ASSERT `Under section 137H, is this business trust one to which Division 2 applies` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- an unregistered, unrecognised trust is outside Division 2
#ASSERT `Under section 137H, is this business trust one to which Division 2 applies` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- Samir is a substantial unitholder of Harbour Business Trust: sections 135 to 137B apply to him as though the trustee-manager were the corporation
#ASSERT `Under section 137J(1), must I give the trustee-manager written notice of particulars of my voting units` TRUE TRUE EQUALS JUST TRUE
-- Samir holds 2 percent of the units: section 137J(1) reaches only a substantial unitholder
#ASSERT `Under section 137J(1), must I give the trustee-manager written notice of particulars of my voting units` TRUE FALSE EQUALS NOTHING
-- the trust is outside Division 2: not covered
#ASSERT `Under section 137J(1), must I give the trustee-manager written notice of particulars of my voting units` FALSE TRUE EQUALS NOTHING
-- Samir learned of his position on Monday 2 Nov: Wednesday 4 Nov
#ASSERT `Under section 137J(1), what is the last day for my notice to the trustee-manager of particulars of my voting units` (Date 2 11 2026) (Date 2 11 2026) (LIST) EQUALS Date 4 11 2026
-- Mei Ling is a director of the trustee-manager and holds units: she must give it written notice
#ASSERT `Under section 137N(1), must I give the trustee-manager written notice of my interests as a director or chief executive officer` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- Raj is the trustee-manager's chief executive officer
#ASSERT `Under section 137N(1), must I give the trustee-manager written notice of my interests as a director or chief executive officer` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- Ng is neither: not covered
#ASSERT `Under section 137N(1), must I give the trustee-manager written notice of my interests as a director or chief executive officer` TRUE FALSE FALSE TRUE EQUALS NOTHING
-- the body is not the trustee-manager of a business trust within Division 2
#ASSERT `Under section 137N(1), must I give the trustee-manager written notice of my interests as a director or chief executive officer` FALSE TRUE FALSE TRUE EQUALS NOTHING
-- Omar's interest in the trustee-manager's voting shares reaches 15 percent
#ASSERT `Under section 137P(1), must I give the trustee-manager written notice of the change in the percentage of my interest in its voting shares` TRUE 14 15 EQUALS JUST TRUE
-- his interest moves from 16 to 29 percent: no threshold is reached, crossed or fallen below
#ASSERT `Under section 137P(1), must I give the trustee-manager written notice of the change in the percentage of my interest in its voting shares` TRUE 16 29 EQUALS JUST FALSE
-- the body is not the trustee-manager of such a trust
#ASSERT `Under section 137P(1), must I give the trustee-manager written notice of the change in the percentage of my interest in its voting shares` FALSE 14 15 EQUALS NOTHING

§ `Division 3: real estate investment trusts (sections 137S to 137ZC)`
-- Delta REIT is a unit trust that invests primarily in real estate and has a primary listing
#ASSERT `Under section 137S(2), is this scheme a real estate investment trust for the purposes of Division 3` TRUE TRUE TRUE EQUALS JUST TRUE
-- a trust that does not invest primarily in real estate is not a real estate investment trust
#ASSERT `Under section 137S(2), is this scheme a real estate investment trust for the purposes of Division 3` TRUE FALSE TRUE EQUALS JUST FALSE
-- a real estate trust with only a secondary listing is not one
#ASSERT `Under section 137S(2), is this scheme a real estate investment trust for the purposes of Division 3` TRUE TRUE FALSE EQUALS JUST FALSE
-- Anika is a substantial unitholder of Delta REIT
#ASSERT `Under section 137U(1), must I give the responsible person written notice of particulars of my voting units` TRUE TRUE EQUALS JUST TRUE
-- Anika holds 2 percent of the units: section 137U(1) reaches only a substantial unitholder
#ASSERT `Under section 137U(1), must I give the responsible person written notice of particulars of my voting units` TRUE FALSE EQUALS NOTHING
-- Mei Ling is a director of Delta REIT's responsible person and holds units
#ASSERT `Under section 137Y(1), must I give the responsible person written notice of my interests as a director or chief executive officer` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- Ng is neither a director nor a chief executive officer
#ASSERT `Under section 137Y(1), must I give the responsible person written notice of my interests as a director or chief executive officer` TRUE FALSE FALSE TRUE EQUALS NOTHING
-- Omar's interest in the responsible person's voting shares reaches 15 percent
#ASSERT `Under section 137ZA(1), must I give the responsible person written notice of the change in the percentage of my interest in its voting shares` TRUE 14 15 EQUALS JUST TRUE
-- no threshold is reached, crossed or fallen below
#ASSERT `Under section 137ZA(1), must I give the responsible person written notice of the change in the percentage of my interest in its voting shares` TRUE 16 29 EQUALS JUST FALSE

§ `Division 4: the civil penalty (sections 137ZD to 137ZG)`
-- Tom, a substantial shareholder, intentionally failed to give a section 135 notice; the Authority has formed the view and the Public Prosecutor has consented
#ASSERT `Under section 137ZD(1), may the Authority, with the consent of the Public Prosecutor, bring an action against me for a civil penalty` `s 137ZD(1)(a)(i) section 135` TRUE `s 137ZD(1)(b) a provision the paragraph does not list` FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- the same, but the Public Prosecutor has not consented: the power is gated by the consent (the split site of NOTES.md, fork B13)
#ASSERT `Under section 137ZD(1), may the Authority, with the consent of the Public Prosecutor, bring an action against me for a civil penalty` `s 137ZD(1)(a)(i) section 135` TRUE `s 137ZD(1)(b) a provision the paragraph does not list` FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING
-- the contravention was not intentional or reckless: the paragraph does not say the Authority may sue
#ASSERT `Under section 137ZD(1), may the Authority, with the consent of the Public Prosecutor, bring an action against me for a civil penalty` `s 137ZD(1)(a)(i) section 135` FALSE `s 137ZD(1)(b) a provision the paragraph does not list` FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS NOTHING
-- Tom gave information to Orchid in purported compliance with section 137 that he knew was false
#ASSERT `Under section 137ZD(1), may the Authority, with the consent of the Public Prosecutor, bring an action against me for a civil penalty` `s 137ZD(1)(a) a provision the paragraph does not list` FALSE `s 137ZD(1)(b)(i) section 137` TRUE TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- Kavita, an officer, intentionally committed an act of the kind section 137G(5) describes
#ASSERT `Under section 137ZD(1), may the Authority, with the consent of the Public Prosecutor, bring an action against me for a civil penalty` `s 137ZD(1)(a) a provision the paragraph does not list` FALSE `s 137ZD(1)(b) a provision the paragraph does not list` FALSE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- the lowest penalty the court may order
#ASSERT `Under section 137ZD(2), is a civil penalty of this amount within the limits the section sets` 50000 EQUALS JUST TRUE
-- the highest
#ASSERT `Under section 137ZD(2), is a civil penalty of this amount within the limits the section sets` 2000000 EQUALS JUST TRUE
-- one dollar below the minimum: the Act's own words say no
#ASSERT `Under section 137ZD(2), is a civil penalty of this amount within the limits the section sets` 49999 EQUALS JUST FALSE
-- one dollar above the maximum
#ASSERT `Under section 137ZD(2), is a civil penalty of this amount within the limits the section sets` 2000001 EQUALS JUST FALSE
-- Tom's act was on 15 March 2020; the Authority commences the action on 15 March 2026, the last day of the six years: not barred
#ASSERT `Under section 137ZE(1), is an action against me for a civil penalty barred` (Date 15 3 2020) (Date 15 3 2026) FALSE FALSE FALSE EQUALS JUST FALSE
-- the day after: barred
#ASSERT `Under section 137ZE(1), is an action against me for a civil penalty barred` (Date 15 3 2020) (Date 16 3 2026) FALSE FALSE FALSE EQUALS JUST TRUE
-- Tom has been convicted of the same act: barred
#ASSERT `Under section 137ZE(1), is an action against me for a civil penalty barred` (Date 15 3 2020) (Date 15 3 2021) TRUE FALSE FALSE EQUALS JUST TRUE
-- Tom was acquitted: barred
#ASSERT `Under section 137ZE(1), is an action against me for a civil penalty barred` (Date 15 3 2020) (Date 15 3 2021) FALSE TRUE FALSE EQUALS JUST TRUE
-- Tom was acquitted only because the charge was withdrawn: the Act carves that out, so not barred
#ASSERT `Under section 137ZE(1), is an action against me for a civil penalty barred` (Date 15 3 2020) (Date 15 3 2021) FALSE TRUE TRUE EQUALS JUST FALSE

§ `Part 8: the Securities Industry Council and take-over offers (sections 138 to 140)`
-- the Council is enquiring into a matter related to the securities industry and the evidence is necessary: it may summon the person
#ASSERT `Under section 138(4), may the Securities Industry Council summon me to give evidence on oath or affirmation or to produce a document or material` TRUE TRUE EQUALS JUST TRUE
-- the evidence is not necessary for the enquiry: the subsection does not say
#ASSERT `Under section 138(4), may the Securities Industry Council summon me to give evidence on oath or affirmation or to produce a document or material` TRUE FALSE EQUALS NOTHING
-- Lim, an advocate and solicitor, holds a client's privileged document: subsection (4) does not compel its production
#ASSERT `Under section 138(5), is my document protected from production and from the taking of possession under section 138(4)` TRUE TRUE EQUALS JUST TRUE
-- Tan is not a lawyer: subsection (5) says nothing about his document
#ASSERT `Under section 138(5), is my document protected from production and from the taking of possession under section 138(4)` FALSE TRUE EQUALS NOTHING
-- Lim refuses to produce the document and knows the client's name and address: she must give them
#ASSERT `Under section 138(6), must I give the name and address of the person for whom or by whom the privileged communication was made` TRUE TRUE TRUE EQUALS JUST TRUE
-- Lim does not know them: the duty is limited to what she knows (marginal reading (a))
#ASSERT `Under section 138(6), must I give the name and address of the person for whom or by whom the privileged communication was made` TRUE TRUE FALSE EQUALS JUST FALSE
-- Tan is not a lawyer
#ASSERT `Under section 138(6), must I give the name and address of the person for whom or by whom the privileged communication was made` FALSE TRUE TRUE EQUALS NOTHING
-- Delta Capital is a party concerned in a take-over offer: it must comply with the Code's provisions (what they say is not in the Act)
#ASSERT `Under section 139(4), must I comply with the provisions of the Take-over Code` TRUE EQUALS JUST TRUE
-- a person with no connection to a take-over offer
#ASSERT `Under section 139(4), must I comply with the provisions of the Take-over Code` FALSE EQUALS NOTHING
-- Delta Capital failed to observe the Code: the Act's own words say it does not of itself render it liable to criminal proceedings
#ASSERT `Under section 139(8), does my failure to observe the Take-over Code of itself make me liable to criminal proceedings` TRUE EQUALS JUST FALSE
-- no failure to observe the Code: not covered
#ASSERT `Under section 139(8), does my failure to observe the Take-over Code of itself make me liable to criminal proceedings` FALSE EQUALS NOTHING
-- Lena has no intention to bid but publicly announces that she will: guilty
#ASSERT `Under section 140(3), am I guilty of an offence for announcing, or making, a take-over offer I do not intend or cannot perform` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- Lena does intend to bid and announces it, and the question of her grounds does not arise: the section does not say
#ASSERT `Under section 140(3), am I guilty of an offence for announcing, or making, a take-over offer I do not intend or cannot perform` FALSE TRUE FALSE FALSE EQUALS NOTHING
-- Lena makes an offer with no reasonable or probable grounds for believing she can perform: guilty
#ASSERT `Under section 140(3), am I guilty of an offence for announcing, or making, a take-over offer I do not intend or cannot perform` FALSE FALSE TRUE TRUE EQUALS JUST TRUE

§ `Mirror cases: the same facts asked from the person's seat and from the text's neutral side, with answers that agree`
-- section 133(1): a director who holds shares, asked as 'must I' and as 'must the director'
#ASSERT (`Under section 133(1), must I give the corporation written notice of my interests as a director or chief executive officer` TRUE TRUE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE) EQUALS (`s 133(1) the director or chief executive officer must give the corporation written notice of the matter` TRUE TRUE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE)
-- section 133(1): a chief executive officer's related-corporation shares: the Act's own no, both ways
#ASSERT (`Under section 133(1), must I give the corporation written notice of my interests as a director or chief executive officer` TRUE FALSE TRUE TRUE `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE) EQUALS (`s 133(1) the director or chief executive officer must give the corporation written notice of the matter` TRUE FALSE TRUE TRUE `s 133(1)(a)(ii) shares in a related corporation of the corporation` TRUE)
-- section 136(1): a rise from 14 to 16 percent
#ASSERT (`Under section 136(1), must I give the corporation written notice of a change in the percentage level of my interests` TRUE TRUE 14 16) EQUALS (`s 136(1) the substantial shareholder must give the corporation written notice of the change in the percentage level` TRUE TRUE 14 16)
-- section 137D(1): an intentional contravention
#ASSERT (`Under section 137D(1), am I guilty of an offence for failing to notify as a substantial shareholder, or for giving false or misleading information` TRUE TRUE FALSE FALSE) EQUALS (`s 137D(1) the person is guilty of an offence under subsection (1)` TRUE TRUE FALSE FALSE)
-- section 137ZD(2): the lowest penalty
#ASSERT (`Under section 137ZD(2), is a civil penalty of this amount within the limits the section sets` 50000) EQUALS (`s 137ZD(2) the amount of the civil penalty is within the limits` 50000)
-- a director who holds: Division 1 (the corporation) and Division 2 (the trustee-manager) agree
#ASSERT (`Under section 133(1), must I give the corporation written notice of my interests as a director or chief executive officer` TRUE TRUE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE) EQUALS (`Under section 137N(1), must I give the trustee-manager written notice of my interests as a director or chief executive officer` TRUE TRUE FALSE TRUE)
-- a director who holds: Division 1 and Division 3 (the responsible person) agree
#ASSERT (`Under section 133(1), must I give the corporation written notice of my interests as a director or chief executive officer` TRUE TRUE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE) EQUALS (`Under section 137Y(1), must I give the responsible person written notice of my interests as a director or chief executive officer` TRUE TRUE FALSE TRUE)
-- neither a director nor a chief executive officer: NOTHING in Division 1 and in Division 2
#ASSERT (`Under section 133(1), must I give the corporation written notice of my interests as a director or chief executive officer` TRUE FALSE FALSE TRUE `s 133(1)(a)(i) shares in the corporation` TRUE) EQUALS (`Under section 137N(1), must I give the trustee-manager written notice of my interests as a director or chief executive officer` TRUE FALSE FALSE TRUE)
-- a substantial shareholder and a substantial unitholder: Division 1 and Division 2 agree (section 137J(1) applies section 135)
#ASSERT (`Under section 135(1), must I give the corporation written notice of particulars of my voting shares` TRUE TRUE FALSE) EQUALS (`Under section 137J(1), must I give the trustee-manager written notice of particulars of my voting units` TRUE TRUE)
-- a substantial shareholder and a substantial unitholder: Division 1 and Division 3 agree (section 137U(1) applies section 135)
#ASSERT (`Under section 135(1), must I give the corporation written notice of particulars of my voting shares` TRUE TRUE FALSE) EQUALS (`Under section 137U(1), must I give the responsible person written notice of particulars of my voting units` TRUE TRUE)
-- the last day for the notice: Division 1 and the application of section 135 by section 137J(1) count the same two business days
#ASSERT (`Under section 135(2)(b), what is the last day for my notice of particulars of my voting shares` (Date 2 11 2026) (Date 30 10 2026) (LIST)) EQUALS (`Under section 137J(1), what is the last day for my notice to the trustee-manager of particulars of my voting units` (Date 2 11 2026) (Date 30 10 2026) (LIST))
-- a holder of voting shares in the trustee-manager and in the responsible person: the thresholds agree
#ASSERT (`Under section 137P(1), must I give the trustee-manager written notice of the change in the percentage of my interest in its voting shares` TRUE 14 15) EQUALS (`Under section 137ZA(1), must I give the responsible person written notice of the change in the percentage of my interest in its voting shares` TRUE 14 15)

