#ASSERT (`Under section 260(3), is the amount payable on application at least 5% of the price` 100 5) EQUALS JUST TRUE
#ASSERT (`Under section 260(3), is the amount payable on application at least 5% of the price` 100 4) EQUALS JUST FALSE

-- ====================================================================================================
-- cases-seat questions from part sfad (merged by the lead; unchanged text follows)
-- ====================================================================================================
-- MODULES sfad-seat
IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfa-periods`
IMPORT `sfad-seat`

-- Cases for the seat layer of sfad (Securities and Futures Act 2001, Part 13 Division 1 Subdivisions (3), (4) and (5), ss 261 to 282AA).
-- Every expected value is written from the text of the section the question names, beside the assertion; none is copied from the layer's output.
-- Inputs are positional, in the order of the question's GIVEN. A date is Date day month year.
-- Each question has at least one case in which the answer is yes, one in which it is no, and, where the text leaves the case open, one in which the answer is NOTHING
-- (the case is outside what the section says: the "not covered" answer).

§ `Subdivision (3): debentures`

-- 261(1D): arguments: I contravene a condition or restriction imposed on a prescribed entity
#ASSERT (`Under section 261(1D), am I guilty of an offence for contravening a condition or restriction imposed on a prescribed entity` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 261(1D), am I guilty of an offence for contravening a condition or restriction imposed on a prescribed entity` FALSE) EQUALS JUST FALSE
-- 262(3): arguments: sale or transfer to a special purpose vehicle; funded by debentures; payments from the assets' cash flows; the securities are debentures
#ASSERT (`Under section 262(3), are the securities I hold asset-backed securities` TRUE TRUE TRUE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 262(3), are the securities I hold asset-backed securities` TRUE TRUE TRUE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 262(3), are the securities I hold asset-backed securities` FALSE TRUE TRUE TRUE) EQUALS JUST FALSE
-- 265A(1) and (4)
#ASSERT (`Under section 265A(1), must the borrowing entity appoint a trustee for the holders of its debentures` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 265A(1), must the borrowing entity appoint a trustee for the holders of its debentures` FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 265A(4), am I guilty of an offence for contravening section 265A(1), (2) or (3)` TRUE FALSE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 265A(4), am I guilty of an offence for contravening section 265A(1), (2) or (3)` FALSE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 265A(4), am I guilty of an offence for contravening section 265A(1), (2) or (3)` FALSE FALSE FALSE) EQUALS JUST FALSE
-- 268(6)(a): "within 3 months after the end of the first 6 months": the first 6 months end 30 June 2025, so the last day is 30 September 2025
#ASSERT (`Under section 268(6)(a), did I lodge the half-year accounts with the trustee in time` (Date 30 6 2025) (Date 30 9 2025) TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 268(6)(a), did I lodge the half-year accounts with the trustee in time` (Date 30 6 2025) (Date 1 10 2025) TRUE) EQUALS JUST FALSE
#ASSERT (`Under section 268(6)(a), did I lodge the half-year accounts with the trustee in time` (Date 30 6 2025) (Date 30 9 2025) FALSE) EQUALS JUST FALSE
-- 268(6)(b): "within 5 months after the end of the financial year": the year ends 31 December 2025, so the last day is 31 May 2026
#ASSERT (`Under section 268(6)(b), did I lodge the annual accounts with the trustee in time` (Date 31 12 2025) (Date 31 5 2026) TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 268(6)(b), did I lodge the annual accounts with the trustee in time` (Date 31 12 2025) (Date 1 6 2026) TRUE) EQUALS JUST FALSE
-- 268(7)
#ASSERT (`Under section 268(7), am I guilty of an offence for failing to comply with section 268(6)` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 268(7), am I guilty of an offence for failing to comply with section 268(6)` FALSE) EQUALS JUST FALSE
-- 268A(2): "within 2 months": the 6 months end 30 June 2025, so the last day is 30 August 2025
#ASSERT (`Under section 268A(2), was the semi-annual report lodged with the trustee in time` (Date 30 6 2025) (Date 30 8 2025)) EQUALS JUST TRUE
#ASSERT (`Under section 268A(2), was the semi-annual report lodged with the trustee in time` (Date 30 6 2025) (Date 31 8 2025)) EQUALS JUST FALSE
-- 269(2) and (3)
#ASSERT (`Under section 269(2), must the guarantor entity provide the borrowing entity with the information` TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 269(2), must the guarantor entity provide the borrowing entity with the information` FALSE) EQUALS JUST FALSE
-- 269(3): arguments: the guarantor entity fails to comply; I am the guarantor entity; I am an officer of the guarantor entity in default
#ASSERT (`Under section 269(3), am I guilty of an offence because the guarantor entity failed to provide the information` TRUE TRUE FALSE) EQUALS JUST TRUE
#ASSERT (`Under section 269(3), am I guilty of an offence because the guarantor entity failed to provide the information` TRUE FALSE TRUE) EQUALS JUST TRUE
#ASSERT (`Under section 269(3), am I guilty of an offence because the guarantor entity failed to provide the information` TRUE FALSE FALSE) EQUALS JUST FALSE
#ASSERT (`Under section 269(3), am I guilty of an offence because the guarantor entity failed to provide the information` FALSE TRUE FALSE) EQUALS JUST FALSE
