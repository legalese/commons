IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfaa-part8`

-- Tests for sfaa-part8.l4 (sections 138 to 140). Every expected value is written from the text, beside the assertion.
-- The Singapore Code on Take-overs and Mergers is not in the Act and is not encoded: what the Code says is an input in every test below.


§ `s 138(1): the Securities Industry Council continues` 
-- the seam S1 answer: the advisory body referred to in section 14 of the repealed Securities Industry Act
#ASSERT `s 138(1) the body is the Securities Industry Council referred to in section 138` TRUE EQUALS JUST TRUE
#ASSERT `s 138(1) the body is the Securities Industry Council referred to in section 138` FALSE EQUALS NOTHING

§ `s 138(2) and (3): the function and the membership`
#ASSERT `s 138(2) the Securities Industry Council has the function of advising the Minister on the matter` TRUE EQUALS JUST TRUE
#ASSERT `s 138(2) the Securities Industry Council has the function of advising the Minister on the matter` FALSE EQUALS NOTHING
-- a representative of business, the Government or the Authority whom the Minister has appointed, within the period the Minister determined
#ASSERT `s 138(3) the person serves on the Securities Industry Council` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 138(3) the person serves on the Securities Industry Council` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 138(3) the person serves on the Securities Industry Council` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 138(3) the person serves on the Securities Industry Council` TRUE TRUE FALSE EQUALS NOTHING

§ `s 138(4) and (5): summons and the lawyer's privilege`
#ASSERT `s 138(4) the Securities Industry Council may summon the person to give evidence on oath or affirmation or produce a document or material` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 138(4) the Securities Industry Council may summon the person to give evidence on oath or affirmation or produce a document or material` TRUE FALSE EQUALS NOTHING
#ASSERT `s 138(4) the Securities Industry Council may summon the person to give evidence on oath or affirmation or produce a document or material` FALSE TRUE EQUALS NOTHING
-- an advocate and solicitor holding a privileged document: "Nothing in subsection (4) compels the production"
#ASSERT `s 138(5) the document is protected from production and from the taking of possession under subsection (4)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 138(5) the document is protected from production and from the taking of possession under subsection (4)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 138(5) the document is protected from production and from the taking of possession under subsection (4)` FALSE TRUE EQUALS NOTHING

§ `s 138(6): the lawyer still gives the name and address if known`
#ASSERT `s 138(6) the person must give the name and address of the person to whom or by or on behalf of whom the communication was made` TRUE TRUE TRUE EQUALS JUST TRUE
-- refuses and does not know them: "(if he or she knows them)"; marginal reading (a)
#ASSERT `s 138(6) the person must give the name and address of the person to whom or by or on behalf of whom the communication was made` TRUE TRUE FALSE EQUALS JUST FALSE
-- not a lawyer, or does not refuse: outside the sentence
#ASSERT `s 138(6) the person must give the name and address of the person to whom or by or on behalf of whom the communication was made` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 138(6) the person must give the name and address of the person to whom or by or on behalf of whom the communication was made` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 138(6) the person must give the name and address of the person to whom or by or on behalf of whom the communication was made` FALSE FALSE FALSE EQUALS NOTHING
-- a MUST with no time limit: giving it on any day reads FULFILLED; nothing yet leaves the duty standing (it can never read BREACH)
-- EXPECT FULFILLED
#TRACE `s 138(6) the lawyer must give the name and address` (Individual "the lawyer") AT 0 WITH
    PARTY Individual "the lawyer" DOES `s 138 give the name and address of the person to whom or by or on behalf of whom the communication was made` AT 30
-- EXPECT RESIDUAL
#TRACE `s 138(6) the lawyer must give the name and address` (Individual "the lawyer") AT 0 WITH
    (WAITUNTIL 30)

§ `s 138(7) to (10): consultation, members, the Council's duty and procedure`
#ASSERT `s 138(7) the Authority may consult the Securities Industry Council` TRUE EQUALS JUST TRUE
#ASSERT `s 138(7) the Authority may consult the Securities Industry Council` FALSE EQUALS NOTHING
#ASSERT `s 138(8)(a) the member is deemed to be a public servant within the meaning of the Penal Code 1871` TRUE EQUALS JUST TRUE
#ASSERT `s 138(8)(a) the member is deemed to be a public servant within the meaning of the Penal Code 1871` FALSE EQUALS NOTHING
#ASSERT `s 138(8)(b) the member has the like protection and privileges as are by law given to a Judge` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 138(8)(b) the member has the like protection and privileges as are by law given to a Judge` TRUE FALSE EQUALS NOTHING
#ASSERT `s 138(8)(b) the member has the like protection and privileges as are by law given to a Judge` FALSE TRUE EQUALS NOTHING
#ASSERT `s 138(9) the Securities Industry Council must have regard to the matter in the exercise of its functions` TRUE EQUALS JUST TRUE
#ASSERT `s 138(9) the Securities Industry Council must have regard to the matter in the exercise of its functions` FALSE EQUALS NOTHING
-- "Subject to the provisions of this Act": where a provision provides otherwise the answer is that provision's
#ASSERT `s 138(10) the Securities Industry Council may regulate its own procedure and is not bound by the rules of evidence` FALSE EQUALS JUST TRUE
#ASSERT `s 138(10) the Securities Industry Council may regulate its own procedure and is not bound by the rules of evidence` TRUE EQUALS NOTHING

§ `s 139(1): who sections 139 and 140 reach`
#ASSERT `s 139(1) sections 139 and 140 apply to the person and extend to acts done outside Singapore` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 139(1) sections 139 and 140 apply to the person and extend to acts done outside Singapore` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 139(1) sections 139 and 140 apply to the person and extend to acts done outside Singapore` TRUE TRUE EQUALS JUST TRUE
-- neither a natural person nor a corporation or body unincorporate: the list is not closed, so NOTHING
#ASSERT `s 139(1) sections 139 and 140 apply to the person and extend to acts done outside Singapore` FALSE FALSE EQUALS NOTHING

§ `s 139(2) and (3): the Take-over Code`
-- the seam S2 answer: the code known as the Singapore Code on Take-overs and Mergers, issued by the Authority on the Council's advice under section 321
#ASSERT `s 139(2) the document is the Singapore Code on Take-overs and Mergers referred to in section 139 and issued by the Authority under section 321(1)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 139(2) the document is the Singapore Code on Take-overs and Mergers referred to in section 139 and issued by the Authority under section 321(1)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 139(2) the document is the Singapore Code on Take-overs and Mergers referred to in section 139 and issued by the Authority under section 321(1)` FALSE TRUE EQUALS NOTHING
#ASSERT `s 139(3) the Take-over Code is deemed not to be subsidiary legislation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 139(3) the Take-over Code is deemed not to be subsidiary legislation` FALSE TRUE EQUALS NOTHING

§ `s 139(4) and (5): the Code applies, and must be complied with`
#ASSERT `s 139(4) the Take-over Code applies to the thing` TRUE EQUALS JUST TRUE
#ASSERT `s 139(4) the Take-over Code applies to the thing` FALSE EQUALS NOTHING
#ASSERT `s 139(4) the person must comply with the provisions of the Take-over Code` TRUE EQUALS JUST TRUE
#ASSERT `s 139(4) the person must comply with the provisions of the Take-over Code` FALSE EQUALS NOTHING
-- the duty has no time limit and subsection (8) says a failure is not of itself criminal, so it can never read BREACH
-- EXPECT FULFILLED
#TRACE `s 139(4) the party concerned must comply with the Take-over Code` (Individual "the party") AT 0 WITH
    PARTY Individual "the party" DOES `s 139 comply with the provisions of the Take-over Code` AT 90
-- EXPECT RESIDUAL
#TRACE `s 139(4) the party concerned must comply with the Take-over Code` (Individual "the party") AT 0 WITH
    (WAITUNTIL 90)
#ASSERT `s 139(5) the body administers and enforces the Take-over Code` TRUE EQUALS JUST TRUE
#ASSERT `s 139(5) the body administers and enforces the Take-over Code` FALSE EQUALS NOTHING

§ `s 139(6) to (7): revising the Code, and rulings`
-- "on the advice of": a power gated like "with consent" (split site (ii)): a failed gate on a public body's power is JUST FALSE (S1b ruling, 2026S1bC)
#ASSERT `s 139(6) the Authority may revise the Take-over Code by deleting, amending or adding to its provisions` TRUE EQUALS JUST TRUE
#ASSERT `s 139(6) the Authority may revise the Take-over Code by deleting, amending or adding to its provisions` FALSE EQUALS JUST FALSE
#ASSERT `s 139(7) the Securities Industry Council may issue a ruling or lay down the practice on the matter` TRUE EQUALS JUST TRUE
#ASSERT `s 139(7) the Securities Industry Council may issue a ruling or lay down the practice on the matter` FALSE EQUALS NOTHING
#ASSERT `s 139(7) the ruling or practice is final` TRUE EQUALS JUST TRUE
#ASSERT `s 139(7) the ruling or practice is final` FALSE EQUALS NOTHING

§ `s 139(8) and (9): a failure to observe the Code`
-- "does not of itself render that party liable to criminal proceedings": the text's no, in its own words
#ASSERT `s 139(8) the failure of itself renders the party liable to criminal proceedings` TRUE EQUALS JUST FALSE
#ASSERT `s 139(8) the failure of itself renders the party liable to criminal proceedings` FALSE EQUALS NOTHING
#ASSERT `s 139(8) the failure may be relied upon in proceedings as tending to establish or to negate a liability` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 139(8) the failure may be relied upon in proceedings as tending to establish or to negate a liability` TRUE FALSE EQUALS NOTHING
#ASSERT `s 139(8) the failure may be relied upon in proceedings as tending to establish or to negate a liability` FALSE TRUE EQUALS NOTHING
#ASSERT `s 139(9) subsection (8) does not prevent the Securities Industry Council from invoking the sanction` TRUE EQUALS JUST TRUE
#ASSERT `s 139(9) subsection (8) does not prevent the Securities Industry Council from invoking the sanction` FALSE EQUALS NOTHING

§ `s 139(10) and (11): the Council's enquiry`
-- "Where the Securities Industry Council has reason to believe": a power gated by "Where" (split site (ii)): a failed gate on a public body's power is JUST FALSE (S1b ruling, 2026S1bC)
#ASSERT `s 139(10) the Securities Industry Council has power to enquire into the suspected breach or misconduct` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 139(10) the Securities Industry Council has power to enquire into the suspected breach or misconduct` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 139(10) the Securities Industry Council has power to enquire into the suspected breach or misconduct` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 139(11) the Securities Industry Council may summon the person to give evidence on oath or affirmation or produce a document or material` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 139(11) the Securities Industry Council may summon the person to give evidence on oath or affirmation or produce a document or material` TRUE FALSE EQUALS NOTHING
#ASSERT `s 139(11) the Securities Industry Council may summon the person to give evidence on oath or affirmation or produce a document or material` FALSE TRUE EQUALS NOTHING

§ `s 140(1) and (2): the two prohibitions`
#ASSERT `s 140(1) the person must not give notice or publicly announce that the person intends to make a take-over offer` TRUE EQUALS JUST TRUE
#ASSERT `s 140(1) the person must not give notice or publicly announce that the person intends to make a take-over offer` FALSE EQUALS NOTHING
#ASSERT `s 140(2) the person must not make a take-over offer or give notice or publicly announce that the person intends to make one` TRUE EQUALS JUST TRUE
#ASSERT `s 140(2) the person must not make a take-over offer or give notice or publicly announce that the person intends to make one` FALSE EQUALS NOTHING
-- the prohibition as a rule: the forbidden act is a breach; doing nothing leaves the rule standing
-- EXPECT BREACH
#TRACE `s 140(1) the person with no intention shall not give notice or publicly announce an intention to make a take-over offer` (Individual "the person") AT 0 WITH
    PARTY Individual "the person" DOES `s 140(1) give notice or publicly announce that the person intends to make a take-over offer` AT 1
-- EXPECT RESIDUAL
#TRACE `s 140(1) the person with no intention shall not give notice or publicly announce an intention to make a take-over offer` (Individual "the person") AT 0 WITH
    (WAITUNTIL 5)
-- EXPECT BREACH
#TRACE `s 140(2) the person with no grounds shall not make a take-over offer or announce an intention to make one` (Individual "the person") AT 0 WITH
    PARTY Individual "the person" DOES `s 140(2) make a take-over offer, or give notice or publicly announce that the person intends to make one` AT 1
-- EXPECT RESIDUAL
#TRACE `s 140(2) the person with no grounds shall not make a take-over offer or announce an intention to make one` (Individual "the person") AT 0 WITH
    (WAITUNTIL 5)

§ `s 140(3): the offence and its penalty`
#ASSERT `s 140(3) the person is guilty of an offence under section 140` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 140(3) the person is guilty of an offence under section 140` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 140(3) the person is guilty of an offence under section 140` TRUE TRUE EQUALS JUST TRUE
-- neither subsection contravened: the offence is not mentioned, so NOTHING (split site (i))
#ASSERT `s 140(3) the person is guilty of an offence under section 140` FALSE FALSE EQUALS NOTHING
-- the officer: only where the person is a corporation, and the officer is in default
#ASSERT `s 140(3) the officer of the corporation is guilty of an offence under section 140` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 140(3) the officer of the corporation is guilty of an offence under section 140` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 140(3) the officer of the corporation is guilty of an offence under section 140` FALSE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 140(3) the officer of the corporation is guilty of an offence under section 140` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 140(3) the officer of the corporation is guilty of an offence under section 140` TRUE FALSE FALSE TRUE EQUALS NOTHING
-- "a fine not exceeding $250,000 or to imprisonment for a term not exceeding 7 years or to both": 7 years is 84 months
#ASSERT `s 140(3) the penalty on conviction` EQUALS Penalty OF 250000, 84, TRUE, 0
