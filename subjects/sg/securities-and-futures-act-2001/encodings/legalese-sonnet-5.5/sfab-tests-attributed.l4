IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfab-attributed`

-- Tests for sfab-attributed (Securities and Futures Act 2001, Part 12). Every expected value below is written from the text of the section named above it,
-- by hand, with the inputs that decide it; none is copied from output. Case order: the case that meets the provision, then each input taken away in turn,
-- then the case the text does not decide. A `#S` case is one that takes a branch marked SPLIT-SITE in the module.


-- s 236A "defendant" an individual liable to an order for a civil penalty under section 236H
#ASSERT `s 236A "defendant" an individual liable to an order for a civil penalty under section 236H` TRUE EQUALS JUST TRUE
#ASSERT `s 236A "defendant" an individual liable to an order for a civil penalty under section 236H` FALSE EQUALS JUST FALSE

-- s 236A "defendant corporation" a corporation liable under section 236B or 236C
#ASSERT `s 236A "defendant corporation" a corporation liable under section 236B or 236C` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 236A "defendant corporation" a corporation liable under section 236B or 236C` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 236A "defendant corporation" a corporation liable under section 236B or 236C` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236A "defendant corporation" a corporation liable under section 236B or 236C` FALSE FALSE EQUALS JUST FALSE

-- s 236A "defendant partnership" a partnership or limited liability partnership liable under section 236E or 236F
#ASSERT `s 236A "defendant partnership" a partnership or limited liability partnership liable under section 236E or 236F` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 236A "defendant partnership" a partnership or limited liability partnership liable under section 236E or 236F` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 236A "defendant partnership" a partnership or limited liability partnership liable under section 236E or 236F` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236A "defendant partnership" a partnership or limited liability partnership liable under section 236E or 236F` FALSE FALSE EQUALS JUST FALSE

-- s 236A "partnership" in Subdivision (2) the partnership at the time of the contravention
#ASSERT `s 236A "partnership" in Subdivision (2) the partnership at the time of the contravention` TRUE EQUALS JUST TRUE
#ASSERT `s 236A "partnership" in Subdivision (2) the partnership at the time of the contravention` FALSE EQUALS JUST FALSE

-- s 236B(1) the corporation is guilty of the offence as if it had committed the contravention
#ASSERT `s 236B(1) the corporation is guilty of the offence as if it had committed the contravention` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236B(1) the corporation is guilty of the offence as if it had committed the contravention` FALSE TRUE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 236B(1) the corporation is guilty of the offence as if it had committed the contravention` TRUE FALSE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 236B(1) the corporation is guilty of the offence as if it had committed the contravention` TRUE TRUE FALSE EQUALS JUST FALSE  -- S
#ASSERT `s 236B(1) the corporation is guilty of the offence as if it had committed the contravention` FALSE FALSE FALSE EQUALS JUST FALSE  -- S

-- s 236B(1) the corporation is liable to be proceeded against and punished accordingly
#ASSERT `s 236B(1) the corporation is liable to be proceeded against and punished accordingly` (Penalty OF 250000, 84, TRUE, 0) EQUALS (Penalty OF 250000, 84, TRUE, 0)
#ASSERT `s 236B(1) the corporation is liable to be proceeded against and punished accordingly` (Penalty OF 100000, 12, FALSE, 500) EQUALS (Penalty OF 100000, 12, FALSE, 500)

-- s 236B(2) proceedings against the corporation under subsection (1) are barred
#ASSERT `s 236B(2) proceedings against the corporation under subsection (1) are barred` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 236B(2) proceedings against the corporation under subsection (1) are barred` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 236B(2) proceedings against the corporation under subsection (1) are barred` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236B(2) proceedings against the corporation under subsection (1) are barred` FALSE FALSE EQUALS NOTHING

-- s 236B(3) the Authority may bring an action in a court against the corporation to seek an order for a civil penalty
#ASSERT `s 236B(3) the Authority may bring an action in a court against the corporation to seek an order for a civil penalty` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236B(3) the Authority may bring an action in a court against the corporation to seek an order for a civil penalty` FALSE TRUE EQUALS JUST FALSE  -- S
#ASSERT `s 236B(3) the Authority may bring an action in a court against the corporation to seek an order for a civil penalty` TRUE FALSE EQUALS NOTHING  -- S
#ASSERT `s 236B(3) the Authority may bring an action in a court against the corporation to seek an order for a civil penalty` FALSE FALSE EQUALS JUST FALSE  -- S

-- s 236B(4) the court may make an order against the corporation for the payment of a civil penalty
#ASSERT `s 236B(4) the court may make an order against the corporation for the payment of a civil penalty` TRUE EQUALS JUST TRUE
#ASSERT `s 236B(4) the court may make an order against the corporation for the payment of a civil penalty` FALSE EQUALS NOTHING  -- S

-- s 236B(4) the highest civil penalty the court may order
#ASSERT `s 236B(4) the highest civil penalty the court may order` 1000000 0 EQUALS 3000000
#ASSERT `s 236B(4) the highest civil penalty the court may order` 0 1000000 EQUALS 3000000
#ASSERT `s 236B(4) the highest civil penalty the court may order` 500000 100000 EQUALS 2000000
#ASSERT `s 236B(4) the highest civil penalty the court may order` 700000 0 EQUALS 2100000
#ASSERT `s 236B(4) the highest civil penalty the court may order` 0 0 EQUALS 2000000
#ASSERT `s 236B(4) the highest civil penalty the court may order` 900000 1000000 EQUALS 3000000
#ASSERT `s 236B(4) the highest civil penalty the court may order` 666666 0 EQUALS 2000000

-- s 236B(4) the lowest civil penalty the court may order
#ASSERT `s 236B(4) the lowest civil penalty the court may order` EQUALS 100000

-- s 236B(6) sections 232(4) to (7) and 233 apply to the action under subsection (3)
#ASSERT `s 236B(6) sections 232(4) to (7) and 233 apply to the action under subsection (3)` TRUE EQUALS JUST TRUE
#ASSERT `s 236B(6) sections 232(4) to (7) and 233 apply to the action under subsection (3)` FALSE EQUALS NOTHING

