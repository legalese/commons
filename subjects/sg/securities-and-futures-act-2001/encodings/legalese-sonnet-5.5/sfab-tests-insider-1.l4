IMPORT prelude
IMPORT daydate
IMPORT `sfa-core`
IMPORT `sfab-insider-1`

-- Tests for sfab-insider-1 (Securities and Futures Act 2001, Part 12). Every expected value below is written from the text of the section named above it,
-- by hand, with the inputs that decide it; none is copied from output. Case order: the case that meets the provision, then each input taken away in turn,
-- then the case the text does not decide. A `#S` case is one that takes a branch marked SPLIT-SITE in the module.


-- s 213 this Division applies to the act
#ASSERT `s 213 this Division applies to the act` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 213 this Division applies to the act` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 213 this Division applies to the act` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 213 this Division applies to the act` (JUST FALSE) (JUST FALSE) EQUALS NOTHING

-- s 213(a) this Division applies to the act occurring within Singapore
#ASSERT `s 213(a) this Division applies to the act occurring within Singapore` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 213(a) this Division applies to the act occurring within Singapore` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 213(a) this Division applies to the act occurring within Singapore` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 213(a) this Division applies to the act occurring within Singapore` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING  -- S
#ASSERT `s 213(a) this Division applies to the act occurring within Singapore` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING  -- S

-- s 213(b) this Division applies to the act occurring outside Singapore
#ASSERT `s 213(b) this Division applies to the act occurring outside Singapore` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 213(b) this Division applies to the act occurring outside Singapore` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 213(b) this Division applies to the act occurring outside Singapore` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 213(b) this Division applies to the act occurring outside Singapore` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING  -- S
#ASSERT `s 213(b) this Division applies to the act occurring outside Singapore` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING  -- S

-- s 214(1) "CIS unit" the thing is a CIS unit
#ASSERT `s 214(1) "CIS unit" the thing is a CIS unit` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 214(1) "CIS unit" the thing is a CIS unit` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 214(1) "CIS unit" the thing is a CIS unit` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 214(1) "CIS unit" the thing is a CIS unit` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 214(1) "CIS unit" the thing is a CIS unit` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 214(1) "CIS unit" the thing is a CIS unit` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 214(1) "debenture" the instrument is a debenture for the purposes of this Division
#ASSERT `s 214(1) "debenture" the instrument is a debenture for the purposes of this Division` (JUST TRUE) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 214(1) "debenture" the instrument is a debenture for the purposes of this Division` NOTHING FALSE FALSE EQUALS NOTHING
#ASSERT `s 214(1) "debenture" the instrument is a debenture for the purposes of this Division` (JUST FALSE) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 214(1) "debenture" the instrument is a debenture for the purposes of this Division` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 214(1) "debenture" the instrument is a debenture for the purposes of this Division` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 214(1) "debenture" the instrument is a debenture for the purposes of this Division` (JUST FALSE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 214(1) "debenture" the instrument is a debenture for the purposes of this Division` NOTHING TRUE TRUE EQUALS NOTHING

-- s 214(1) "financial performance" the matter is the financial performance of a business trust
#ASSERT `s 214(1) "financial performance" the matter is the financial performance of a business trust` TRUE EQUALS JUST TRUE
#ASSERT `s 214(1) "financial performance" the matter is the financial performance of a business trust` FALSE EQUALS JUST FALSE

-- s 214(1) "information" the matter is information
#ASSERT `s 214(1) "information" the matter is information` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 214(1) "information" the matter is information` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 214(1) "information" the matter is information` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 214(1) "information" the matter is information` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 214(1) "information" the matter is information` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 214(1) "information" the matter is information` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 214(1) "information" the matter is information` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 214(1) "information" the matter is information` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 214(1) "information" the matter is information` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- s 214(1) "persons who commonly invest" the persons are persons who commonly invest
#ASSERT `s 214(1) "persons who commonly invest" the persons are persons who commonly invest` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 214(1) "persons who commonly invest" the persons are persons who commonly invest` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 214(1) "persons who commonly invest" the persons are persons who commonly invest` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 214(1) "persons who commonly invest" the persons are persons who commonly invest` FALSE TRUE TRUE EQUALS JUST FALSE

-- s 214(1) "purchase" the act is a purchase of a securities-based derivatives contract or CIS unit
#ASSERT `s 214(1) "purchase" the act is a purchase of a securities-based derivatives contract or CIS unit` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 214(1) "purchase" the act is a purchase of a securities-based derivatives contract or CIS unit` TRUE FALSE EQUALS NOTHING
#ASSERT `s 214(1) "purchase" the act is a purchase of a securities-based derivatives contract or CIS unit` FALSE TRUE EQUALS NOTHING

-- s 214(1) "sell" the act is a sale of a securities-based derivatives contract or CIS unit
#ASSERT `s 214(1) "sell" the act is a sale of a securities-based derivatives contract or CIS unit` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 214(1) "sell" the act is a sale of a securities-based derivatives contract or CIS unit` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 214(1) "sell" the act is a sale of a securities-based derivatives contract or CIS unit` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 214(1) "sell" the act is a sale of a securities-based derivatives contract or CIS unit` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 214(1) "sell" the act is a sale of a securities-based derivatives contract or CIS unit` FALSE TRUE TRUE TRUE EQUALS NOTHING

-- s 214(1) "trust property" the thing is trust property
#ASSERT `s 214(1) "trust property" the thing is trust property` TRUE EQUALS JUST TRUE
#ASSERT `s 214(1) "trust property" the thing is trust property` FALSE EQUALS JUST FALSE

-- s 214(2)(a) the contract is a securities-based derivatives contract of the corporation
#ASSERT `s 214(2)(a) the contract is a securities-based derivatives contract of the corporation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 214(2)(a) the contract is a securities-based derivatives contract of the corporation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 214(2)(a) the contract is a securities-based derivatives contract of the corporation` FALSE TRUE EQUALS JUST FALSE

-- s 214(2)(b) the contract is a securities-based derivatives contract of the business trust
#ASSERT `s 214(2)(b) the contract is a securities-based derivatives contract of the business trust` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 214(2)(b) the contract is a securities-based derivatives contract of the business trust` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 214(2)(b) the contract is a securities-based derivatives contract of the business trust` FALSE TRUE EQUALS JUST FALSE

-- s 215 the information is generally available
#ASSERT `s 215 the information is generally available` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 215 the information is generally available` FALSE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 215 the information is generally available` FALSE FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 215 the information is generally available` FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 215 the information is generally available` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 215 the information is generally available` FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 215 the information is generally available` FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 215 the information is generally available` FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 215 the information is generally available` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 216 a reasonable person would be taken to expect the information to have a material effect on the price or value
#ASSERT `s 216 a reasonable person would be taken to expect the information to have a material effect on the price or value` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 216 a reasonable person would be taken to expect the information to have a material effect on the price or value` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 216 a reasonable person would be taken to expect the information to have a material effect on the price or value` FALSE FALSE EQUALS JUST FALSE

-- s 217(1) trading is taken to be permitted on the organised market
#ASSERT `s 217(1) trading is taken to be permitted on the organised market` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 217(1) trading is taken to be permitted on the organised market` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 217(1) trading is taken to be permitted on the organised market` FALSE FALSE EQUALS NOTHING
#ASSERT `s 217(1) trading is taken to be permitted on the organised market` FALSE TRUE EQUALS NOTHING

-- s 217(2) the person is taken to procure the act or omission by the other person
#ASSERT `s 217(2) the person is taken to procure the act or omission by the other person` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 217(2) the person is taken to procure the act or omission by the other person` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 217(2) the person is taken to procure the act or omission by the other person` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 217(2) the person is taken to procure the act or omission by the other person` FALSE FALSE FALSE EQUALS NOTHING
