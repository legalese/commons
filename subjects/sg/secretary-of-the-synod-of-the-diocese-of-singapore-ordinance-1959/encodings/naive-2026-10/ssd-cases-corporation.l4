§ `ss 2(1) and 4`

#ASSERT `is the Corporation` `Roland Keith Hudson himself`
#ASSERT `is the Corporation` `a successor appointed, certified by the Bishop and gazetted`
#ASSERT NOT `is the Corporation` `a successor certified by the Bishop but not yet gazetted`
#ASSERT `is the Corporation` `a successor certified by the Bishop's Commissary in the Bishop's absence, gazetted`
#ASSERT NOT `is the Corporation` `a successor certified by the Bishop's Commissary while the Bishop is present, gazetted`
#ASSERT `is the Corporation` `a successor certified by the Archbishop's Commissary during a vacancy, gazetted`
#ASSERT NOT `is the Corporation` `a successor certified by the Archbishop in person during a vacancy, gazetted`
#ASSERT NOT `is the Corporation` `a successor certified by someone else, gazetted`
#ASSERT NOT `is the Corporation` `a person gazetted but never appointed by the Synod`

#ASSERT NOT `publication is sufficient evidence of qualification` `a successor certified by the Bishop but not yet gazetted`
#ASSERT `publication is sufficient evidence of qualification` `a successor certified by the Bishop's Commissary while the Bishop is present, gazetted`
#ASSERT `publication is sufficient evidence of qualification` `a successor certified by the Archbishop in person during a vacancy, gazetted`
#ASSERT `publication is sufficient evidence of qualification` `a person gazetted but never appointed by the Synod`

§ `ss 2(2)-(4), 5(2)`

#ASSERT `the Ordinance empowers the Corporation to` `break and remake its corporate seal` FALSE FALSE
#ASSERT `the Ordinance empowers the Corporation to` `acquire or purchase property` FALSE FALSE
#ASSERT `the Ordinance empowers the Corporation to` `sell property` TRUE TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell property` TRUE FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell property` FALSE TRUE
#ASSERT `the Ordinance empowers the Corporation to` `mortgage property` TRUE TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `lease property` TRUE FALSE
#ASSERT `the Ordinance empowers the Corporation to` `sue on a matter not about its property` FALSE FALSE
#ASSERT `the Ordinance empowers the Corporation to` `be sued on a matter not about its property` FALSE FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `borrow money without security` TRUE TRUE

§ `s 3`

#ASSERT `is executed as section 3 requires` `a lease sealed on resolution before the witness and the Secretary, signed by both`
#ASSERT `is executed as section 3 requires` `a mortgage sealed before a deposited attorney who signs with the witness`
#ASSERT NOT `is executed as section 3 requires` `a transfer sealed and signed properly but with no Standing Committee resolution`
#ASSERT NOT `is executed as section 3 requires` `a deed signed by the Secretary but not by the witness`
#ASSERT NOT `is executed as section 3 requires` `a conveyance sealed before and signed by an undeposited attorney`
#ASSERT NOT `is executed as section 3 requires` `a deed sealed while the named witness was absent, both signing later`
#ASSERT NOT `is executed as section 3 requires` `a document signed by the Secretary and the witness but never sealed`

#ASSERT `the signing is sufficient evidence the seal was duly affixed` `a lease sealed on resolution before the witness and the Secretary, signed by both`
#ASSERT `the signing is sufficient evidence the seal was duly affixed` `a mortgage sealed before a deposited attorney who signs with the witness`
#ASSERT `the signing is sufficient evidence the seal was duly affixed` `a transfer sealed and signed properly but with no Standing Committee resolution`
#ASSERT NOT `the signing is sufficient evidence the seal was duly affixed` `a deed signed by the Secretary but not by the witness`
#ASSERT NOT `the signing is sufficient evidence the seal was duly affixed` `a conveyance sealed before and signed by an undeposited attorney`
#ASSERT `the signing is sufficient evidence the seal was duly affixed` `a deed sealed while the named witness was absent, both signing later`
#ASSERT NOT `the signing is sufficient evidence the seal was duly affixed` `a document signed by the Secretary and the witness but never sealed`

