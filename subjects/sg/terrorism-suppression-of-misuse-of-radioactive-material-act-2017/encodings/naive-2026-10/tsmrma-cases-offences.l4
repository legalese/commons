IMPORT prelude
IMPORT `tsmrma-offences`

-- Terrorism (Suppression of Misuse of Radioactive Material) Act 2017, ss 2 to 14 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_terrorism-suppression-of-misuse-of-radioactive-material-act-2017.py). Expected results were written by
-- hand from the text.

§ `s 2 -- nuclear and radioactive material`

#ASSERT `the material is nuclear material` `plutonium` 0
#ASSERT `the material is nuclear material` `plutonium` 80
#ASSERT NOT `the material is nuclear material` `plutonium` 81
#ASSERT `the material is nuclear material` `enriched uranium` 0
#ASSERT `the material is nuclear material` `refined natural uranium` 0
#ASSERT NOT `the material is nuclear material` `natural uranium ore or ore residue` 0
#ASSERT NOT `the material is nuclear material` `depleted uranium` 0
#ASSERT NOT `the material is nuclear material` `another radioactive substance` 0

#ASSERT `the material is radioactive material` `plutonium` 81 TRUE TRUE
#ASSERT `the material is radioactive material` `enriched uranium` 0 FALSE FALSE
#ASSERT `the material is radioactive material` `depleted uranium` 0 TRUE TRUE
#ASSERT NOT `the material is radioactive material` `another radioactive substance` 0 TRUE FALSE

§ `s 3 -- application`

#ASSERT `the Act applies` FALSE FALSE
#ASSERT NOT `the Act applies` TRUE FALSE

§ `ss 4 to 7 -- the offences`

#ASSERT `the conduct is an offence` `possessing radioactive material or a Convention device` TRUE FALSE TRUE FALSE FALSE FALSE
#ASSERT NOT `the conduct is an offence` `possessing radioactive material or a Convention device` TRUE TRUE TRUE FALSE FALSE FALSE
#ASSERT NOT `the conduct is an offence` `possessing radioactive material or a Convention device` FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT NOT `the conduct is an offence` `possessing radioactive material or a Convention device` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT `the conduct is an offence` `possessing radioactive material or a Convention device` TRUE FALSE FALSE FALSE TRUE FALSE
#ASSERT `the conduct is an offence` `making a Convention device` TRUE FALSE FALSE TRUE FALSE FALSE
#ASSERT `the conduct is an offence` `using radioactive material or a Convention device` TRUE FALSE FALSE FALSE TRUE FALSE
#ASSERT `the conduct is an offence` `using or damaging a nuclear facility` TRUE FALSE FALSE FALSE TRUE TRUE
#ASSERT NOT `the conduct is an offence` `using or damaging a nuclear facility` TRUE FALSE TRUE TRUE TRUE FALSE

§ `ss 8 to 10 -- threats, demands, attempts`

#ASSERT `the threat is an offence` `using radioactive material or a Convention device` TRUE
#ASSERT `the threat is an offence` `using or damaging a nuclear facility` TRUE
#ASSERT NOT `the threat is an offence` `making a Convention device` TRUE
#ASSERT NOT `the threat is an offence` `possessing radioactive material or a Convention device` TRUE

#ASSERT `the demand is an offence` TRUE FALSE TRUE TRUE
#ASSERT NOT `the demand is an offence` TRUE FALSE TRUE FALSE
#ASSERT NOT `the demand is an offence` TRUE TRUE TRUE TRUE

#ASSERT `the attempt is an offence` TRUE TRUE
#ASSERT NOT `the attempt is an offence` TRUE FALSE

§ `ss 4 to 10 -- punishment`

#ASSERT `the punishment` `the s 4 possession offence` TRUE TRUE EQUALS `imprisonment which may extend to life`
#ASSERT `the punishment` `the s 6 use offence` TRUE TRUE EQUALS `the same punishment as Penal Code s 300(a)`
#ASSERT `the punishment` `the s 6 use offence` FALSE TRUE EQUALS `imprisonment for life`
#ASSERT `the punishment` `the s 6 use offence` TRUE FALSE EQUALS `imprisonment for life`
#ASSERT `the punishment` `the s 7 nuclear facility offence` TRUE TRUE EQUALS `the same punishment as Penal Code s 300(a)`
#ASSERT `the punishment` `the s 8 threat offence` FALSE FALSE EQUALS `imprisonment up to 10 years`
#ASSERT `the punishment` `the s 10 attempt offence` FALSE FALSE EQUALS `imprisonment up to 15 years`

#ASSERT NOT `the court must impose life imprisonment` `the s 4 possession offence` FALSE FALSE
#ASSERT `the court must impose life imprisonment` `the s 6 use offence` FALSE FALSE

§ `ss 2 and 11 -- nuclear terrorism offences`

#ASSERT `it is a nuclear terrorism offence` `the s 10 attempt offence` `committing it`
#ASSERT `it is a nuclear terrorism offence` `the s 9 demand offence` `abetting it`
#ASSERT NOT `it is a nuclear terrorism offence` `the s 10 attempt offence` `abetting it`
#ASSERT NOT `it is a nuclear terrorism offence` `the s 10 attempt offence` `conspiring to commit it`

#ASSERT `it may be tried in Singapore` `the s 4 possession offence` `committing it` TRUE
#ASSERT NOT `it may be tried in Singapore` `the s 10 attempt offence` `conspiring to commit it` TRUE

