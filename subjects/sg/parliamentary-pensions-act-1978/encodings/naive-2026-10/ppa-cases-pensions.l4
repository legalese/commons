IMPORT prelude
IMPORT `ppa-pensions`

-- Parliamentary Pensions Act 1978, ss 2A, 3, 4, 5(1), (2), 7(1) to (5), 12, 13 and 15 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_parliamentary-pensions-act-1978.py). Expected results were written by
-- hand from the text.

§ `ss 2A and 3 -- Member's pension`

#ASSERT `the months that count for a Member's pension` 150 40 EQUALS 110

#ASSERT `a Member's pension may be granted` TRUE 108
#ASSERT NOT `a Member's pension may be granted` TRUE 107
#ASSERT NOT `a Member's pension may be granted` FALSE 200

#ASSERT `the Member's annual pension` 108 360000 EQUALS 108000
#ASSERT `the Member's annual pension` 125 360000 EQUALS 125000
#ASSERT `the Member's annual pension` 240 360000 EQUALS 240000
#ASSERT `the Member's annual pension` 300 360000 EQUALS 240000
#ASSERT `the Member's annual pension` 119 180000 EQUALS 59500

§ `ss 4 and 5 -- office pension`

#ASSERT `an office pension may be granted` TRUE 96 FALSE FALSE
#ASSERT NOT `an office pension may be granted` TRUE 95 FALSE FALSE
#ASSERT `an office pension may be granted` FALSE 120 TRUE FALSE
#ASSERT NOT `an office pension may be granted` FALSE 120 FALSE FALSE
#ASSERT NOT `an office pension may be granted` FALSE 120 TRUE TRUE

#ASSERT `the uncapped pension for one office` 100 324000 EQUALS 100000

#ASSERT `the office pension over two offices` 120 324000 60 270000 EQUALS 170000
#ASSERT `the office pension over two offices` 180 324000 60 162000 EQUALS 210000
#ASSERT `the office pension over two offices` 200 324000 60 324000 EQUALS 216000
#ASSERT `the office pension over two offices` 60 162000 180 324000 EQUALS 210000

§ `ss 3(4), (6), 4(4) and 15 -- payability`

#ASSERT `the Member's pension is payable for the period` FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT `the Member's pension is payable for the period` TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT `the Member's pension is payable for the period` FALSE TRUE FALSE FALSE FALSE
#ASSERT NOT `the Member's pension is payable for the period` FALSE FALSE TRUE FALSE FALSE
#ASSERT NOT `the Member's pension is payable for the period` FALSE FALSE FALSE TRUE FALSE

