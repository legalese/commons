#ASSERT NOT `the office pension is payable for the period` FALSE FALSE TRUE FALSE

#ASSERT `bankruptcy bars the grant` TRUE FALSE
#ASSERT NOT `bankruptcy bars the grant` TRUE TRUE

§ `s 7 -- the option`

#ASSERT NOT `the option is open to` `a future Member who became an office-holder` `a reduced pension with a gratuity`
#ASSERT `the option is open to` `a Member who is not a future Member` `a reduced pension with a gratuity`
#ASSERT `the option is open to` `a future Member who kept eligibility under section 2A(2)(b)` `a reduced pension with a gratuity`
#ASSERT NOT `the option is open to` `a pensioned office-holder who returned to office` `a reduced pension with a gratuity`

#ASSERT `the reduced pension` 90000 EQUALS 60000

#ASSERT `the gratuity with a reduced pension` 90000 EQUALS 375000

#ASSERT `the commuted pension gratuity` 15 90000 EQUALS 1350000

#ASSERT `the option that applies` TRUE `a full pension without any gratuity` 30 FALSE EQUALS `a full pension without any gratuity`
#ASSERT `the option that applies` TRUE `a full pension without any gratuity` 31 FALSE EQUALS `a commuted pension gratuity without any pension`
#ASSERT `the option that applies` TRUE `a reduced pension with a gratuity` 45 TRUE EQUALS `a reduced pension with a gratuity`
#ASSERT `the option that applies` FALSE `a full pension without any gratuity` 10 FALSE EQUALS `a commuted pension gratuity without any pension`

§ `s 12 -- assignment and attachment`

#ASSERT `the pension may be assigned to satisfy` `a debt due to the Government`
#ASSERT `the pension may be assigned to satisfy` `a court maintenance order for a wife or former wife`
#ASSERT NOT `the pension may be assigned to satisfy` `a court maintenance order for a husband or former husband`
#ASSERT NOT `the pension may be assigned to satisfy` `a judgment debt owed to a private creditor`

#ASSERT `the pension may be attached for` `a debt due to the Government`
#ASSERT NOT `the pension may be attached for` `a court maintenance order for a wife or former wife`
#ASSERT NOT `the pension may be attached for` `a judgment debt owed to a private creditor`

§ `s 13 -- corruption`

#ASSERT `the President may reduce or withhold the pension` TRUE FALSE TRUE
#ASSERT `the President may reduce or withhold the pension` FALSE TRUE TRUE
#ASSERT NOT `the President may reduce or withhold the pension` TRUE FALSE FALSE

