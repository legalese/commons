§ `s 2`

#ASSERT `is a foreign State` `a recognised foreign government`
#ASSERT `is a foreign State` `persons exercising the powers of government over a foreign province`
#ASSERT `is a foreign State` `an authority assuming to exercise the powers of government over a people abroad`
#ASSERT NOT `is a foreign State` `the Government of Singapore`
#ASSERT NOT `is a foreign State` `a private foreign company`
#ASSERT NOT `is a foreign State` `a foreign private individual`

§ `s 3`

#ASSERT `the President may make a section 3 order` `an agent in Singapore signing up soldiers for a foreign army`
#ASSERT NOT `the President may make a section 3 order` `the same agent working from across the Causeway`
#ASSERT NOT `the President may make a section 3 order` `a foreign official in Singapore who is not seeking recruits`
#ASSERT `the President may make a section 3 order` `an agent in Singapore trying to sign up fighters for a self-proclaimed government abroad`
#ASSERT NOT `the President may make a section 3 order` `an agent in Singapore hiring guards for a private foreign security company`

#ASSERT `a section 3 order is in proper form` TRUE TRUE
#ASSERT NOT `a section 3 order is in proper form` TRUE FALSE
#ASSERT NOT `a section 3 order is in proper form` FALSE TRUE

§ `s 4`

#ASSERT `a section 4 general order is in proper form` TRUE
#ASSERT NOT `a section 4 general order is in proper form` FALSE

§ `s 5 -- prohibition or condition`

#ASSERT NOT `the conduct violates a prohibition or condition` `no order`
#ASSERT `the conduct violates a prohibition or condition` `a general prohibition notified in the Gazette under section 4`
#ASSERT `the conduct violates a prohibition or condition` `a section 3 order prohibiting this person`
#ASSERT NOT `the conduct violates a prohibition or condition` `a section 3 order prohibiting another person only`
#ASSERT `the conduct violates a prohibition or condition` `a permission or general conditions that this conduct breaches`
#ASSERT NOT `the conduct violates a prohibition or condition` `a permission or general conditions that this conduct complies with`

§ `s 5(a) and (b)`

#ASSERT `limb (a) is met` `an unsuccessful attempt to persuade someone to travel abroad to seek a commission, under a general prohibition`
#ASSERT NOT `limb (a) is met` `a recruiter for a private foreign security company under a general prohibition`

#ASSERT `limb (b) is met` `a travel agent who knowingly books the recruits' passages under a general prohibition`
#ASSERT NOT `limb (b) is met` `a travel agent who books the same passages not knowing their purpose`

§ `s 5 -- offence`

#ASSERT NOT `commits a section 5 offence` `a recruiter for a foreign army where no order has been made`
#ASSERT `commits a section 5 offence` `the same recruiter after a Gazette general prohibition`
#ASSERT `commits a section 5 offence` `a recruiter personally prohibited by a section 3 order`
#ASSERT NOT `commits a section 5 offence` `the prohibited recruiter's assistant, who is not named in the order`
#ASSERT `commits a section 5 offence` `a permitted recruiter who breaks a condition of the permission`
#ASSERT NOT `commits a section 5 offence` `a permitted recruiter who keeps every condition`
#ASSERT `commits a section 5 offence` `a travel agent who knowingly books the recruits' passages under a general prohibition`
#ASSERT NOT `commits a section 5 offence` `a travel agent who books the same passages not knowing their purpose`
#ASSERT `commits a section 5 offence` `a friend who knowingly lends a recruit his fare under a general prohibition`
#ASSERT `commits a section 5 offence` `a recruiter for a self-proclaimed government abroad under a general prohibition`
#ASSERT `commits a section 5 offence` `an unsuccessful attempt to persuade someone to travel abroad to seek a commission, under a general prohibition`
#ASSERT NOT `commits a section 5 offence` `a recruiter for a private foreign security company under a general prohibition`
#ASSERT NOT `commits a section 5 offence` `a recruiter for the Government of Singapore under a general prohibition`
#ASSERT NOT `commits a section 5 offence` `a commentator who neither induces nor aids, under a general prohibition`

§ `s 5 -- penalty`

#ASSERT `the maximum imprisonment in years` EQUALS 7
#ASSERT NOT `the Act states a maximum fine`

#ASSERT `is a kind of sentence section 5 allows` `a fine only`
#ASSERT `is a kind of sentence section 5 allows` `imprisonment only`
#ASSERT `is a kind of sentence section 5 allows` `a fine and imprisonment`

#ASSERT `the imprisonment term is within section 5` 7
#ASSERT NOT `the imprisonment term is within section 5` 7.5
#ASSERT `the imprisonment term is within section 5` 2

