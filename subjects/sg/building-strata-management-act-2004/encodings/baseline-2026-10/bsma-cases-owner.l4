#ASSERT `When may the management corporation enter my lot` `to do work under section 30` TRUE EQUALS `at any time`
#ASSERT `When may the management corporation enter my lot` `to repair or renew a service pipe, wire, cable or duct` FALSE EQUALS `at any reasonable time, after notice to the occupier`
#ASSERT `When may the management corporation enter my lot` `for some other purpose` TRUE EQUALS `section 31 gives no right of entry`

