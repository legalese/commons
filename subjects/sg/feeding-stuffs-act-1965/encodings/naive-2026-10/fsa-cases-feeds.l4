IMPORT prelude
IMPORT `fsa-feeds`

-- Feeding Stuffs Act 1965, ss 4 to 8A, 10 and 11(3) -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_feeding-stuffs-act-1965.py). Expected results were written by
-- hand from the text.

§ `s 4 -- licence`

#ASSERT `a licence is needed` `importing` `a feed concentrate`
#ASSERT `a licence is needed` `manufacturing` `a compound feed`
#ASSERT `a licence is needed` `processing for sale` `a simple feed`
#ASSERT `a licence is needed` `selling` `a compound feed`
#ASSERT NOT `a licence is needed` `selling` `another animal feed`
#ASSERT NOT `a licence is needed` `buying` `a compound feed`
#ASSERT NOT `a licence is needed` `storing for own animals` `a feed concentrate`
#ASSERT NOT `a licence is needed` `importing` `another animal feed`

#ASSERT `dealing without a licence is an offence` `selling` `a compound feed` FALSE
#ASSERT NOT `dealing without a licence is an offence` `selling` `a compound feed` TRUE
#ASSERT NOT `dealing without a licence is an offence` `buying` `a compound feed` FALSE
#ASSERT NOT `dealing without a licence is an offence` `selling` `another animal feed` FALSE

§ `ss 5 and 10(1) -- statutory statement`

#ASSERT `failing to furnish the statement is an offence` TRUE FALSE
#ASSERT NOT `failing to furnish the statement is an offence` TRUE TRUE
#ASSERT NOT `failing to furnish the statement is an offence` FALSE FALSE

§ `ss 6 and 10(2), (3) -- warranty`

#ASSERT `a warranty is due` `a compound feed` TRUE
#ASSERT `a warranty is due` `a simple feed` TRUE
#ASSERT NOT `a warranty is due` `another animal feed` TRUE
#ASSERT NOT `a warranty is due` `a compound feed` FALSE

#ASSERT `a warranty offence is committed` `a compound feed` TRUE FALSE FALSE
#ASSERT `a warranty offence is committed` `a compound feed` TRUE TRUE TRUE
#ASSERT NOT `a warranty offence is committed` `a compound feed` TRUE TRUE FALSE
#ASSERT NOT `a warranty offence is committed` `another animal feed` TRUE FALSE FALSE
#ASSERT NOT `a warranty offence is committed` `a compound feed` FALSE FALSE FALSE

§ `s 7 -- sample and analysis`

#ASSERT `the purchaser is entitled to a sample and certificate` TRUE TRUE
#ASSERT NOT `the purchaser is entitled to a sample and certificate` TRUE FALSE
#ASSERT NOT `the purchaser is entitled to a sample and certificate` FALSE TRUE

§ `s 10(4) -- deleterious ingredients`

#ASSERT `the seller is deemed guilty` `a compound feed` TRUE TRUE FALSE
#ASSERT `the seller is deemed guilty` `a feed concentrate` TRUE TRUE TRUE
#ASSERT NOT `the seller is deemed guilty` `a compound feed` TRUE FALSE FALSE
#ASSERT NOT `the seller is deemed guilty` `another animal feed` TRUE TRUE TRUE
#ASSERT NOT `the seller is deemed guilty` `a compound feed` FALSE TRUE TRUE

§ `s 10(5), (6) -- tampering and obstruction`

#ASSERT `a tampering offence is committed` TRUE TRUE FALSE
#ASSERT NOT `a tampering offence is committed` TRUE FALSE FALSE
#ASSERT `a tampering offence is committed` FALSE FALSE TRUE

#ASSERT `an obstruction offence is committed` `a compound feed` TRUE TRUE FALSE
#ASSERT `an obstruction offence is committed` `a simple feed` TRUE FALSE TRUE
#ASSERT NOT `an obstruction offence is committed` `another animal feed` TRUE TRUE FALSE
#ASSERT NOT `an obstruction offence is committed` `a compound feed` FALSE TRUE FALSE
#ASSERT NOT `an obstruction offence is committed` `a compound feed` TRUE FALSE FALSE

§ `ss 4(5), 10, 11(3) -- maxima`

#ASSERT `the maximum fine` `an offence under the Act` EQUALS 1000
#ASSERT `the maximum fine` `an offence under rules` EQUALS 500

#ASSERT `the maximum imprisonment in months` `an offence under the Act` EQUALS 12
#ASSERT `the maximum imprisonment in months` `an offence under rules` EQUALS 6

#ASSERT `licence cancellation may be added` `an offence under rules`
#ASSERT NOT `licence cancellation may be added` `an offence under the Act`

§ `s 8(3) -- arrest without warrant`

#ASSERT NOT `arrest without warrant is allowed` TRUE FALSE FALSE FALSE FALSE
#ASSERT `arrest without warrant is allowed` TRUE TRUE FALSE FALSE FALSE
#ASSERT `arrest without warrant is allowed` TRUE FALSE TRUE FALSE FALSE
#ASSERT `arrest without warrant is allowed` TRUE FALSE FALSE FALSE TRUE
#ASSERT NOT `arrest without warrant is allowed` FALSE TRUE FALSE FALSE FALSE

