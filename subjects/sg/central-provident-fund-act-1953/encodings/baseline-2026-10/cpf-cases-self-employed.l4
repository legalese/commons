§ `s 2(1A)(a) -- age on 1 January`

#ASSERT `How old am I taken to be for the year` `a rider born on 1 January 2006, in 2027` EQUALS 21

§ `regs 2A and 3(1)`

#ASSERT `Do the Self-Employed Persons Regulations apply to me` `a rider born 30 August 2006 with $31,000 of trade income in 2027`
#ASSERT NOT `Do the Self-Employed Persons Regulations apply to me` `the rider with $6,000`

§ `reg 4(1)(m), First Schedule item 23, regs 8A and 14 -- How much must I contribute`

#ASSERT `How much must I contribute for the year` `a rider born 30 August 2006 with $31,000 of trade income in 2027` EQUALS JUST 2480
#ASSERT `How much must I contribute for the year` `the same rider with $15,000` EQUALS JUST 960
#ASSERT `How much must I contribute for the year` `a designer born in 1987 with $100,000 in 2027` EQUALS JUST 8640
#ASSERT `How much must I contribute for the year` `the rider whose $31,000 is all platform remuneration` EQUALS JUST 0
#ASSERT `How much must I contribute for the year` `the rider with $500 of estimated contributions already paid` EQUALS JUST 1980
#ASSERT `How much must I contribute for the year` `the rider's $31,000 in 2025` EQUALS NOTHING

§ `reg 7A(2) and (3) -- Have I paid in time`

#ASSERT `Have I paid in time` 2480 2480 30 0
#ASSERT NOT `Have I paid in time` 2480 2480 31 0
#ASSERT `Have I paid in time` 2480 2480 45 60

§ `ss 9(2), 9(3), 58(1)(e), 61(1)`

#ASSERT `Must I pay interest on my contributions` FALSE FALSE

#ASSERT `What is the most I can be fined for not paying my contributions` FALSE EQUALS 5000
#ASSERT `What is the most I can be fined for not paying my contributions` TRUE EQUALS 10000

