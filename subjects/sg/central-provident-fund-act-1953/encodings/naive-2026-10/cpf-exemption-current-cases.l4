IMPORT prelude
IMPORT `cpf-exemption`
IMPORT `cpf-exemption-current`

-- Central Provident Fund (Exemption) Order 2018 -- the current version (from 1 June 2026), compared where useful with the
-- version as made (cpf-exemption.l4). Expected results written by hand from CPFA1953-OR10.txt. Every assertion is a claim about
-- the ENCODING on stated facts, not about the law. Nothing here speaks to the version in force in May 2025, which was not
-- obtainable.

§ `Fixtures`

GIVEN i IS A Institution, approved IS A BOOLEAN
GIVETH A Student
`a student of` i approved MEANS
    Student WITH
        `institution` IS i
        `matriculated or registered` IS TRUE
        `employed for training approved by the institution` IS approved
        `in a full-time MOE-subsidised programme listed on the MOE website` IS FALSE
        `required by the institution to train in Singapore for months` IS 0
        `gave the employer the institution's written confirmation` IS FALSE
        `has completed the GCE A Level or equivalent` IS FALSE
        `employed during a school holiday period` IS FALSE

GIVEN subsidised IS A BOOLEAN
GIVETH A Student
`a private institution student on approved training` subsidised MEANS
    Student WITH
        `institution` IS `a private education institution`
        `matriculated or registered` IS TRUE
        `employed for training approved by the institution` IS TRUE
        `in a full-time MOE-subsidised programme listed on the MOE website` IS subsidised
        `required by the institution to train in Singapore for months` IS 0
        `gave the employer the institution's written confirmation` IS FALSE
        `has completed the GCE A Level or equivalent` IS FALSE
        `employed during a school holiday period` IS FALSE

GIVEN months IS A NUMBER, confirmed IS A BOOLEAN
GIVETH A Student
`an overseas student training here for` months confirmed MEANS
    Student WITH
        `institution` IS `an overseas tertiary education institution`
        `matriculated or registered` IS TRUE
        `employed for training approved by the institution` IS TRUE
        `in a full-time MOE-subsidised programme listed on the MOE website` IS FALSE
        `required by the institution to train in Singapore for months` IS months
        `gave the employer the institution's written confirmation` IS confirmed
        `has completed the GCE A Level or equivalent` IS FALSE
        `employed during a school holiday period` IS FALSE

GIVEN `done A levels` IS A BOOLEAN
GIVETH A Student
`a pupil's holiday job` `done A levels` MEANS
    Student WITH
        `institution` IS `a school listed in paragraph 8`
        `matriculated or registered` IS TRUE
        `employed for training approved by the institution` IS FALSE
        `in a full-time MOE-subsidised programme listed on the MOE website` IS FALSE
        `required by the institution to train in Singapore for months` IS 0
        `gave the employer the institution's written confirmation` IS FALSE
        `has completed the GCE A Level or equivalent` IS `done A levels`
        `employed during a school holiday period` IS TRUE

GIVETH A Student
`no student` MEANS `a student of` `none of these` FALSE

GIVETH A Student
`a university student on approved training` MEANS `a student of` `a university whose function is determined by written law` TRUE

GIVEN entered IS A BOOLEAN, started IS A BOOLEAN, late IS A BOOLEAN, `hours to 31 May` IS A NUMBER, `a month within 14` IS A BOOLEAN, after IS A BOOLEAN, weekly IS A NUMBER
GIVETH A `Domestic engagement`
`a domestic engagement` entered started late `hours to 31 May` `a month within 14` after weekly MEANS
    `Domestic engagement` WITH
        `X is a domestic employee of Y` IS TRUE
        `the current contract or a prior connected contract was entered into before 1 June 2026` IS entered
        `the employment under that contract started before 1 June 2026` IS started
        `the employment under that contract started on or after 25 May 2026` IS late
        `hours worked from the start to 31 May 2026` IS `hours to 31 May`
        `within any one calendar month to 31 May 2026, no 7 consecutive days exceeded 14 hours` IS `a month within 14`
        `the month is after 31 May 2026` IS after
        `most hours in any 7 consecutive days within the month` IS weekly

GIVETH A `Domestic engagement`
`no domestic engagement` MEANS
    `Domestic engagement` WITH
        `X is a domestic employee of Y` IS FALSE
        `the current contract or a prior connected contract was entered into before 1 June 2026` IS FALSE
        `the employment under that contract started before 1 June 2026` IS FALSE
        `the employment under that contract started on or after 25 May 2026` IS FALSE
        `hours worked from the start to 31 May 2026` IS 0
        `within any one calendar month to 31 May 2026, no 7 consecutive days exceeded 14 hours` IS FALSE
        `the month is after 31 May 2026` IS FALSE
        `most hours in any 7 consecutive days within the month` IS 0

GIVEN k IS A `Seaman contract kind`, entered IS A BOOLEAN, started IS A BOOLEAN, after IS A BOOLEAN
GIVETH A `Seaman engagement`
`a seaman engagement` k entered started after MEANS
    `Seaman engagement` WITH
        `kind of contract` IS k
        `the current contract or a prior connected contract was entered into before 1 June 2026` IS entered
        `the employment under that contract started before 1 June 2026` IS started
        `the period is after 31 May 2026` IS after

GIVETH A `Seaman engagement`
`no seaman engagement` MEANS `a seaman engagement` `not a seaman contract` FALSE FALSE FALSE

-- Shorthands: an employee with no Schedule employer, no domestic engagement and no seaman contract.
GIVEN status IS A `Residence status`, s IS A Student
GIVETH A BOOLEAN
`exempt today` status s MEANS
    `today the employer is exempt from section 7 contributions` status s `any other employer` `no domestic engagement` `no seaman engagement`

GIVEN status IS A `Residence status`, s IS A Student
GIVETH A STRING
`which paragraph today` status s MEANS
    `the exempting paragraph` status s `any other employer` `no domestic engagement` `no seaman engagement`

§ `REQ-0265 (Haziq scenario, rule-version check of 11 Oct 2026)`

-- Has the Order been amended? Yes: the Legislative History lists six amending instruments and a revised edition (not an
-- assertion; see NOTES). Does an amendment change who is exempt among students on approved training? On the current text, no:
-- a citizen who is a matriculated university student, employed for training approved by the university, is specified in
-- Schedule para 6(a) (para 5(a) as made), and para 2(2) exempts the employer from s 7 contributions and community-fund
-- contributions. The same facts gave the same answer under the version as made.
#ASSERT `exempt today` `a citizen of Singapore` `a university student on approved training` EQUALS TRUE
#ASSERT `which paragraph today` `a citizen of Singapore` `a university student on approved training` EQUALS "para 2(2)"
#ASSERT `is specified in Schedule paragraph 6(a)` `a university student on approved training` EQUALS TRUE
#ASSERT `today the employer is exempt from community-fund contributions` `a citizen of Singapore` `a university student on approved training` `any other employer` `no domestic engagement` `no seaman engagement` EQUALS TRUE
#ASSERT `the employer is exempt from section 7 contributions` TRUE `a university student on approved training` `none of the others` EQUALS TRUE
-- Training the university has not approved: not exempt, then or now.
#ASSERT `today section 7 contributions are payable on the wages` `a citizen of Singapore` (`a student of` `a university whose function is determined by written law` FALSE) `any other employer` `no domestic engagement` `no seaman engagement` EQUALS TRUE
#ASSERT `which paragraph today` `a permanent resident of Singapore` (`a student of` `a university whose function is determined by written law` FALSE) EQUALS "none"

-- The student paragraphs give the same result in both versions, fixture by fixture (old paras 5-8, new paras 6-9).
#ASSERT `is a student specified in the current Schedule` (`a student of` `a university whose function is determined by written law` FALSE) EQUALS `is a specified student employee` (`a student of` `a university whose function is determined by written law` FALSE)
#ASSERT `is a student specified in the current Schedule` (`a private institution student on approved training` TRUE) EQUALS `is a specified student employee` (`a private institution student on approved training` TRUE)
#ASSERT `is a student specified in the current Schedule` (`an overseas student training here for` 7 TRUE) EQUALS `is a specified student employee` (`an overseas student training here for` 7 TRUE)
#ASSERT `is a student specified in the current Schedule` (`a pupil's holiday job` TRUE) EQUALS `is a specified student employee` (`a pupil's holiday job` TRUE)

§ `Schedule paragraphs 6 to 9 -- students`

#ASSERT `which paragraph today` `a citizen of Singapore` (`a student of` `the Institute of Technical Education` TRUE) EQUALS "para 2(1)"
#ASSERT `is specified in Schedule paragraph 6(a)` (`a student of` `a polytechnic established by written law` TRUE) EQUALS FALSE
#ASSERT `is specified in Schedule paragraph 7` (`a private institution student on approved training` TRUE) EQUALS TRUE
#ASSERT `is specified in Schedule paragraph 7` (`a private institution student on approved training` FALSE) EQUALS FALSE
#ASSERT `is specified in Schedule paragraph 8` (`an overseas student training here for` 6 TRUE) EQUALS TRUE
#ASSERT `is specified in Schedule paragraph 8` (`an overseas student training here for` 7 TRUE) EQUALS FALSE
#ASSERT `is specified in Schedule paragraph 8` (`an overseas student training here for` 3 FALSE) EQUALS FALSE
#ASSERT `is specified in Schedule paragraph 9` (`a pupil's holiday job` FALSE) EQUALS TRUE
#ASSERT `is specified in Schedule paragraph 9` (`a pupil's holiday job` TRUE) EQUALS FALSE

§ `Paragraphs 3 and 3A -- foreign employees and platform workers`

#ASSERT `exempt today` `neither a citizen nor a permanent resident` `no student` EQUALS TRUE
#ASSERT `which paragraph today` `neither a citizen nor a permanent resident` `no student` EQUALS "para 3"
#ASSERT `today the employer is exempt from community-fund contributions` `neither a citizen nor a permanent resident` `no student` `any other employer` `no domestic engagement` `no seaman engagement` EQUALS FALSE
#ASSERT `paragraph 3A exempts the platform operator from section 8A contributions` `neither a citizen nor a permanent resident` EQUALS TRUE
#ASSERT `paragraph 3A exempts the platform operator from section 8A contributions` `a permanent resident of Singapore` EQUALS FALSE

§ `Schedule paragraphs 2, 2A and 3 -- international organisations`

#ASSERT `the exempting paragraph` `a citizen of Singapore` `no student` `the UN or a UN agency, institution or related organisation located in Singapore` `no domestic engagement` `no seaman engagement` EQUALS "para 2(1)"
#ASSERT `is specified in Schedule paragraph 2, 2A or 3` `the Multilateral Investment Guarantee Agency, located in Singapore` EQUALS TRUE
#ASSERT `is specified in Schedule paragraph 2, 2A or 3` `the OECD, assigning the employee to the IEA Regional Cooperation Centre in Singapore` EQUALS TRUE
#ASSERT `is specified in Schedule paragraph 2, 2A or 3` `the OECD, on other work` EQUALS FALSE

§ `Paragraph 4 -- domestic employees`

-- A citizen cleaner, contract made and work begun in January 2026, never over 14 hours in any 7 days; July 2026, at most 10
-- hours in any 7 days: exempt under para 4 (s 7 and community funds).
#ASSERT `the exempting paragraph` `a citizen of Singapore` `no student` `any other employer` (`a domestic engagement` TRUE TRUE FALSE 0 TRUE TRUE 10) `no seaman engagement` EQUALS "para 4"
#ASSERT `today the employer is exempt from community-fund contributions` `a citizen of Singapore` `no student` `any other employer` (`a domestic engagement` TRUE TRUE FALSE 0 TRUE TRUE 10) `no seaman engagement` EQUALS TRUE
-- The same, but one 7-day stretch in July of 15 hours: not exempt for July.
#ASSERT `paragraph 4 exempts the employer` `a citizen of Singapore` (`a domestic engagement` TRUE TRUE FALSE 0 TRUE TRUE 15) EQUALS FALSE
-- A NEW contract made and begun after 1 June 2026, 10 hours a week: not exempt today; the as-made Schedule para 1 exempted it.
#ASSERT `paragraph 4 exempts the employer` `a permanent resident of Singapore` (`a domestic engagement` FALSE FALSE FALSE 0 FALSE TRUE 10) EQUALS FALSE
#ASSERT `the employer is exempt from section 7 contributions` TRUE `no student` `a domestic employee working at most 14 hours a week` EQUALS TRUE
-- Started 28 May 2026 (on or after 25 May): the test is the hours from the start to 31 May. 12 hours: exempt; 16: not.
#ASSERT `paragraph 4 exempts the employer` `a citizen of Singapore` (`a domestic engagement` TRUE TRUE TRUE 12 FALSE TRUE 10) EQUALS TRUE
#ASSERT `paragraph 4 exempts the employer` `a citizen of Singapore` (`a domestic engagement` TRUE TRUE TRUE 16 TRUE TRUE 10) EQUALS FALSE
-- May 2026 itself is not a month after 31 May 2026: para 4 does not reach it.
#ASSERT `paragraph 4 exempts the employer` `a citizen of Singapore` (`a domestic engagement` TRUE TRUE FALSE 0 TRUE FALSE 10) EQUALS FALSE
-- A foreign domestic employee: para 4 requires a citizen or PR, but para 3 exempts anyway.
#ASSERT `the exempting paragraph` `neither a citizen nor a permanent resident` `no student` `any other employer` (`a domestic engagement` TRUE TRUE FALSE 0 TRUE TRUE 10) `no seaman engagement` EQUALS "para 3"

§ `Paragraphs 4(3) and 5(3) -- prior connected contracts`

#ASSERT `contract A is a prior connected contract` TRUE 1 FALSE EQUALS TRUE
#ASSERT `contract A is a prior connected contract` TRUE 2 FALSE EQUALS FALSE
#ASSERT `contract A is a prior connected contract` TRUE 3 TRUE EQUALS TRUE
#ASSERT `contract A is a prior connected contract` FALSE 0 TRUE EQUALS FALSE

§ `Paragraph 5 -- seamen`

#ASSERT `the exempting paragraph` `a citizen of Singapore` `no student` `any other employer` `no domestic engagement` (`a seaman engagement` `in a Swedish ship on Swedish seamen's terms` TRUE TRUE TRUE) EQUALS "para 5"
#ASSERT `paragraph 5 exempts the employer` `a permanent resident of Singapore` (`a seaman engagement` `in a Norwegian ship on Norwegian seamen's terms` TRUE TRUE TRUE) EQUALS FALSE
#ASSERT `paragraph 5 exempts the employer` `a citizen of Singapore` (`a seaman engagement` `by the East Asiatic Co Ltd of Denmark on the Danish agreement terms` FALSE FALSE TRUE) EQUALS FALSE
#ASSERT `paragraph 5 exempts the employer` `a citizen of Singapore` (`a seaman engagement` `not a seaman contract` TRUE TRUE TRUE) EQUALS FALSE
