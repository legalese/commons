§ `s 1 and Article IV`

#ASSERT `the Agreement has force or effect` TRUE
#ASSERT NOT `the Agreement has force or effect` FALSE

§ `Article I -- the line`

#ASSERT `the boundary line in the Strait` FALSE EQUALS `the centre of the deep-water channel`
#ASSERT `the boundary line in the Strait` TRUE EQUALS `midway between the two portions`

#ASSERT `its Northern Shore faces the boundary on the Singapore side` `Singapore`
#ASSERT `its Northern Shore faces the boundary on the Singapore side` `Pulau Ubin`
#ASSERT `its Northern Shore faces the boundary on the Singapore side` `Pulau Tekong Kechil`
#ASSERT `its Northern Shore faces the boundary on the Singapore side` `Pulau Tekong Besar`
#ASSERT NOT `its Northern Shore faces the boundary on the Singapore side` `Pulau Merambong`
#ASSERT NOT `its Northern Shore faces the boundary on the Singapore side` `Johore Shoal`

#ASSERT `where the boundary ends seaward` `the Western entrance` EQUALS `the 3-mile limit from the low water mark of the South Coast of Pulau Merambong`
#ASSERT `where the boundary ends seaward` `the Eastern entrance` EQUALS `the 3-mile limit from the low water mark of the Johore mainland, bearing 192 degrees from Tanjong Sitapa`

#ASSERT `what prevails where the map conflicts with the text` `alterations in the channels` EQUALS `the text of the Agreement`
#ASSERT `what prevails where the map conflicts with the text` `some other cause` EQUALS `the text of the Agreement`

§ `Articles I and II -- whose waters`

#ASSERT `whose territorial waters` `a fishing boat north of the channel line in the Strait` TRUE EQUALS `the State and Territory of Johore`
#ASSERT `whose territorial waters` `a boat just south of the channel line, within 3 miles of Johore` TRUE EQUALS `the Settlement of Singapore`
#ASSERT `whose territorial waters` `a boat south of the channel line, beyond 3 miles of Johore` TRUE EQUALS `the Settlement of Singapore`
#ASSERT `whose territorial waters` `a boat north of the channel line, beyond 3 miles of Johore` TRUE EQUALS `the State and Territory of Johore`
#ASSERT `whose territorial waters` `ceded water outside the Strait within 3 miles of Johore` TRUE EQUALS `the State and Territory of Johore`
#ASSERT `whose territorial waters` `ceded water outside the Strait beyond 3 miles of Johore` TRUE EQUALS `the Settlement of Singapore`
#ASSERT `whose territorial waters` `water never ceded, within 3 miles of Johore` TRUE EQUALS `not decided by the Agreement`
#ASSERT `whose territorial waters` `water never ceded, beyond 3 miles of Johore` TRUE EQUALS `not decided by the Agreement`
#ASSERT `whose territorial waters` `a fishing boat north of the channel line in the Strait` FALSE EQUALS `not decided by the Agreement`
#ASSERT `whose territorial waters` `ceded water outside the Strait within 3 miles of Johore` FALSE EQUALS `not decided by the Agreement`

§ `Article III -- islets`

#ASSERT `the islet is ceded to the Sultan of Johore` TRUE TRUE
#ASSERT NOT `the islet is ceded to the Sultan of Johore` TRUE FALSE
#ASSERT NOT `the islet is ceded to the Sultan of Johore` FALSE TRUE
#ASSERT NOT `the islet is ceded to the Sultan of Johore` FALSE FALSE

