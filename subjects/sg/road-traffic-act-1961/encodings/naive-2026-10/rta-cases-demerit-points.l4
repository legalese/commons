#ASSERT NOT `the licence is liable to suspension under rule 4` 23 23 FALSE
#ASSERT `the licence is liable to suspension under rule 4` 24 10 FALSE
#ASSERT NOT `the licence is liable to suspension under rule 4` 12 12 FALSE
#ASSERT `the licence is liable to suspension under rule 4` 12 12 TRUE
#ASSERT NOT `the licence is liable to suspension under rule 4` 11 11 TRUE
#ASSERT `the rule 4(2) regime applies` TRUE FALSE
#ASSERT NOT `the rule 4(2) regime applies` TRUE TRUE
