#ASSERT `the demerit points for exceeding a speed limit` 1 EQUALS 6
#ASSERT `the demerit points for exceeding a speed limit` 20 EQUALS 6
#ASSERT `the demerit points for exceeding a speed limit` 21 EQUALS 8
#ASSERT `the demerit points for exceeding a speed limit` 30 EQUALS 8
#ASSERT `the demerit points for exceeding a speed limit` 31 EQUALS 12
#ASSERT `the demerit points for exceeding a speed limit` 40 EQUALS 12
#ASSERT `the demerit points for exceeding a speed limit` 41 EQUALS 18
#ASSERT `the demerit points for exceeding a speed limit` 50 EQUALS 18
#ASSERT `the demerit points for exceeding a speed limit` 51 EQUALS 24

§ `R 25 rule 3 -- award, and the zone supplement`

#ASSERT NOT `demerit points must be awarded` FALSE FALSE
#ASSERT `the most demerit points for speeding` 25 TRUE FALSE FALSE EQUALS 10
#ASSERT `the most demerit points for speeding` 25 TRUE TRUE TRUE EQUALS 10
#ASSERT `the most demerit points for speeding` 25 FALSE FALSE FALSE EQUALS 8
#ASSERT `the most demerit points for speeding` 0 TRUE FALSE FALSE EQUALS 0

§ `R 29 rule 2 -- who may compound, and the offer`

#ASSERT `may compound under rule 2` `a sergeant or above specially authorised by name`
#ASSERT NOT `may compound under rule 2` `a police officer below the rank of sergeant`
#ASSERT `may compound under rule 2` `an Authority employee specially authorised by name by the Registrar`
#ASSERT `the speeding composition offer is lawful` 300 FALSE `a sergeant or above specially authorised by name`
#ASSERT NOT `the speeding composition offer is lawful` 600 FALSE `a sergeant or above specially authorised by name`
#ASSERT NOT `the speeding composition offer is lawful` 300 FALSE `a police officer below the rank of sergeant`
#ASSERT `the speeding composition offer is lawful` 600 TRUE `the Deputy Commissioner of Police`

