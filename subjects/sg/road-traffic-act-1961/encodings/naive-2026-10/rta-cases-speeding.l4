IMPORT prelude
IMPORT `rta-speeding`

-- Road Traffic Act 1961, ss 35A, 42, 43, 45 to 47A, 63, 64(11)(b), 67A(2), 81(1B), 131(2), 135 and 139AA -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked against a
-- decided case or subsidiary legislation (none was retrieved). Where a fixture needs a speed limit, a composition sum, a
-- number of points or a threshold, the figure is an ILLUSTRATIVE INPUT standing in for the rules, not a statement of them.
-- Expected results were written by hand from the text.

§ `Fixtures`

-- REQ-0273: Jun Hao, on a motorcycle, 25 km/h over the limit on an expressway, no earlier speeding conviction (assumed).
-- The limit (90), the sum (300), the points (6), the points already held (0) and the threshold (24) are ILLUSTRATIVE.
`Jun Hao at 25 over on the expressway` MEANS SpeedingCase WITH
    `speed limit` IS 90
    `speed` IS 115
    `an earlier speeding conviction` IS FALSE
    `prescribed as compoundable` IS TRUE
    `composition sum demanded` IS 300
    `points for this offence` IS 6
    `points already in the period` IS 0
    `suspension threshold` IS 24

`Jun Hao, with 20 points already` MEANS SpeedingCase WITH
    `speed limit` IS 90
    `speed` IS 115
    `an earlier speeding conviction` IS FALSE
    `prescribed as compoundable` IS TRUE
    `composition sum demanded` IS 300
    `points for this offence` IS 6
    `points already in the period` IS 20
    `suspension threshold` IS 24

`Jun Hao, asked for 600` MEANS SpeedingCase WITH
    `speed limit` IS 90
    `speed` IS 115
    `an earlier speeding conviction` IS FALSE
    `prescribed as compoundable` IS TRUE
    `composition sum demanded` IS 600
    `points for this offence` IS 6
    `points already in the period` IS 0
    `suspension threshold` IS 24

`Jun Hao, a second-time speeder asked for 600` MEANS SpeedingCase WITH
    `speed limit` IS 90
    `speed` IS 115
    `an earlier speeding conviction` IS TRUE
    `prescribed as compoundable` IS TRUE
    `composition sum demanded` IS 600
    `points for this offence` IS 6
    `points already in the period` IS 0
    `suspension threshold` IS 24

`a rider at 45 over` MEANS SpeedingCase WITH
    `speed limit` IS 90
    `speed` IS 135
    `an earlier speeding conviction` IS FALSE
    `prescribed as compoundable` IS FALSE
    `composition sum demanded` IS 0
    `points for this offence` IS 0
    `points already in the period` IS 0
    `suspension threshold` IS 24

§ `REQ-0273 (Jun Hao scenario, j084)`

-- The offence is committed; the maximum is $1,000 or 3 months or both (s 131(2)(a)); the composition sum may not exceed $500
-- (s 135(1)); the sum and the points are for the rules; 25 km/h over does not feed s 64(11)(b) or s 67A(2).
#ASSERT `the speeding offence is committed` 90 115
#ASSERT `the case's maximum fine` `Jun Hao at 25 over on the expressway` EQUALS 1000
#ASSERT `the case's maximum months` `Jun Hao at 25 over on the expressway` EQUALS 3
#ASSERT `the case's composition cap` `Jun Hao at 25 over on the expressway` EQUALS 500
#ASSERT `the case's composition sum is within the Act` `Jun Hao at 25 over on the expressway`
#ASSERT NOT `the case's licence may be suspended` `Jun Hao at 25 over on the expressway`
#ASSERT NOT `the case counts towards a repeat dangerous driver` `Jun Hao at 25 over on the expressway`
#ASSERT `the mandatory minimum disqualification months for speeding` EQUALS 0

§ `s 63 -- the offence`

#ASSERT NOT `the speeding offence is committed` 90 90
#ASSERT `the speeding offence is committed` 90 91
#ASSERT `the excess over the limit` 90 115 EQUALS 25
#ASSERT `the excess over the limit` 90 80 EQUALS 0

§ `s 131(2) -- the punishment`

#ASSERT `the maximum fine for speeding` TRUE EQUALS 2000
#ASSERT `the maximum months of imprisonment for speeding` TRUE EQUALS 6
#ASSERT `the minimum fine for speeding` EQUALS 0

§ `s 135 -- composition`

-- The $5,000 limb bites only where the maximum fine exceeds $10,000.
#ASSERT `the composition cap for speeding` TRUE EQUALS 1000
#ASSERT `the composition cap for` 20000 EQUALS 5000
#ASSERT `the composition cap for` 10000 EQUALS 5000
#ASSERT NOT `the case's composition sum is within the Act` `Jun Hao, asked for 600`
#ASSERT `the case's composition sum is within the Act` `Jun Hao, a second-time speeder asked for 600`
#ASSERT NOT `the composition sum is within the Act` 300 FALSE FALSE
#ASSERT `the compounded offence may aggravate a later sentence` TRUE TRUE
#ASSERT NOT `the compounded offence may aggravate a later sentence` FALSE TRUE

§ `ss 64(11)(b), 67A(2) -- when speeding counts`

#ASSERT `speeding makes a repeat dangerous or careless driver` 2 2
#ASSERT NOT `speeding makes a repeat dangerous or careless driver` 5 1
#ASSERT `the case counts towards a repeat dangerous driver` `a rider at 45 over`
#ASSERT `the enhanced penalty is open for speeding` 2 45 TRUE
#ASSERT NOT `the enhanced penalty is open for speeding` 2 25 TRUE
#ASSERT NOT `the enhanced penalty is open for speeding` 2 45 FALSE
#ASSERT NOT `the enhanced penalty is open for speeding` 1 45 TRUE
#ASSERT `the enhanced maximum fine for speeding` FALSE EQUALS 3000
#ASSERT `the enhanced maximum months for speeding` TRUE EQUALS 18

§ `ss 42, 43(1) -- disqualification by the court`

#ASSERT `the court may disqualify` TRUE
#ASSERT `the effect of a court disqualification` 6 EQUALS `suspended for the period`
#ASSERT `the effect of a court disqualification` 12 EQUALS `of no effect, and a new test is needed`
#ASSERT `the points are cancelled by the disqualification` TRUE

§ `ss 45 to 47A -- points and suspension`

#ASSERT `the case's points total` `Jun Hao, with 20 points already` EQUALS 26
#ASSERT `the case's licence may be suspended` `Jun Hao, with 20 points already`
#ASSERT `the Deputy Commissioner may suspend on points` 24 24
#ASSERT NOT `the Deputy Commissioner may suspend on points` 23 24
#ASSERT `the maximum suspension months` EQUALS 60
#ASSERT `a half-threshold warning is due` 12 24
#ASSERT NOT `a half-threshold warning is due` 11 24
#ASSERT `the points awarded for one occasion` 6 12 EQUALS 12
#ASSERT `the points awarded for one occasion` 9 4 EQUALS 9
#ASSERT `the earliest suspension day` 100 EQUALS 128
#ASSERT `a new test is needed after the suspension` 12
#ASSERT NOT `a new test is needed after the suspension` 3

§ `s 35A -- the new driver`

#ASSERT `is a new driver` 364
#ASSERT NOT `is a new driver` 365
#ASSERT `the Deputy Commissioner may revoke on points` 200 13 13
#ASSERT NOT `the Deputy Commissioner may revoke on points` 400 13 13
#ASSERT `the other licence falls with it` TRUE 100
#ASSERT NOT `the other licence falls with it` TRUE 2000

§ `s 81(1B) -- the owner's presumption`

#ASSERT `the owner is presumed to have been driving` TRUE TRUE TRUE
#ASSERT NOT `the owner is presumed to have been driving` TRUE FALSE TRUE
