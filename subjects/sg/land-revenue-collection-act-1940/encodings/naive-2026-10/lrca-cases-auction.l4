IMPORT prelude
IMPORT `lrca-auction`

-- Land Revenue Collection Act 1940, ss 2, 4 to 8, 10 to 14, 16, 17, 19 to 24, 26 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_land-revenue-collection-act-1940.py). Expected results were written by
-- hand from the text.

§ `ss 2 and 4`

#ASSERT `the charge is land revenue` `annual rent`
#ASSERT `the charge is land revenue` `survey fees`
#ASSERT NOT `the charge is land revenue` `income tax`

#ASSERT NOT `the annual rent is an arrear` 3 FALSE
#ASSERT `the annual rent is an arrear` 4 FALSE

#ASSERT NOT `other land revenue is an arrear` 14 FALSE
#ASSERT `other land revenue is an arrear` 15 FALSE

#ASSERT `the rent for the year of alienation` 3650 100 365 EQUALS 1000

§ `ss 5 and 6`

#ASSERT `a notice of sale must be served on the proprietor` TRUE
#ASSERT NOT `a notice of sale must be served on the proprietor` FALSE

#ASSERT NOT `failure to serve the notice invalidates the sale` FALSE

#ASSERT `the sale date meets the notice periods` 3 28
#ASSERT NOT `the sale date meets the notice periods` 2 60
#ASSERT NOT `the sale date meets the notice periods` 4 27

§ `ss 7, 8, 10`

#ASSERT `the upset price` 5000 300 200 EQUALS 5500

#ASSERT `the Collector must stop the sale` 5500 5000 300 200
#ASSERT NOT `the Collector must stop the sale` 5000 5000 300 200

#ASSERT `the cash deposit` 80000 EQUALS 20000

#ASSERT `the balance of the purchase money` 80000 EQUALS 60000

§ `ss 11, 12, 13`

#ASSERT `the sale is final and conclusive` 3 TRUE FALSE FALSE FALSE
#ASSERT NOT `the sale is final and conclusive` 2 TRUE FALSE FALSE FALSE
#ASSERT NOT `the sale is final and conclusive` 3 FALSE FALSE FALSE FALSE
#ASSERT NOT `the sale is final and conclusive` 3 TRUE FALSE TRUE FALSE

#ASSERT `the deposit is forfeited and the land resold` 3 FALSE
#ASSERT NOT `the deposit is forfeited and the land resold` 3 TRUE

§ `s 14`

#ASSERT `the purchaser takes free of the interest` TRUE FALSE
#ASSERT NOT `the purchaser takes free of the interest` TRUE TRUE

#ASSERT `the dealing is deemed cheating under Penal Code s 415` TRUE TRUE TRUE

