IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgc1-s201-statement`

-- Tests for sgc1-s201-statement.l4 (s 201(16) to (23)). Expected values are written from the text, beside each assertion.

§ `s 201(16): the directors' statement`

-- accompanied, signed by 2 directors, the Twelfth Schedule information, before the auditor reports
#ASSERT `s 201(16) the financial statements are accompanied by the directors' statement the subsection requires` TRUE 2 TRUE TRUE EQUALS JUST TRUE
-- one signature is not enough, and the boundary: 1 against 2
#ASSERT `s 201(16) the financial statements are accompanied by the directors' statement the subsection requires` TRUE 1 TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 201(16) the financial statements are accompanied by the directors' statement the subsection requires` TRUE 0 TRUE TRUE EQUALS JUST FALSE
-- more than 2 signatures (read as "at least 2": fork F-16)
#ASSERT `s 201(16) the financial statements are accompanied by the directors' statement the subsection requires` TRUE 3 TRUE TRUE EQUALS JUST TRUE
-- no statement at all
#ASSERT `s 201(16) the financial statements are accompanied by the directors' statement the subsection requires` FALSE 2 TRUE TRUE EQUALS JUST FALSE
-- the Twelfth Schedule information missing
#ASSERT `s 201(16) the financial statements are accompanied by the directors' statement the subsection requires` TRUE 2 FALSE TRUE EQUALS JUST FALSE
-- made after the auditor reported
#ASSERT `s 201(16) the financial statements are accompanied by the directors' statement the subsection requires` TRUE 2 TRUE FALSE EQUALS JUST FALSE

-- the auditor reports on day 40 of the trace
-- EXPECT FULFILLED
#TRACE `s 201(16) the directors must accompany the financial statements with a statement signed on their behalf by 2 directors` "Ann" 40 AT 0 WITH
    PARTY Director "Ann" DOES `s 201(16) accompany the financial statements with the directors' statement` AT 39

-- EXPECT BREACH
#TRACE `s 201(16) the directors must accompany the financial statements with a statement signed on their behalf by 2 directors` "Ann" 40 AT 0 WITH
    WAITUNTIL 41

§ `s 201(17): reserves`

-- A: not financial statements, not a bank, a representation of a reserve invested outside the business, no accompanying statement: barred
#ASSERT `s 201(17) the representation that the company has a reserve is barred` FALSE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- B: the same with the statement showing the manner and security: the "unless" is met
#ASSERT `s 201(17) the representation that the company has a reserve is barred` FALSE FALSE TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- C: a reserve used in the business, no statement to that effect: barred
#ASSERT `s 201(17) the representation that the company has a reserve is barred` FALSE FALSE TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- D: a reserve used in the business, with the statement
#ASSERT `s 201(17) the representation that the company has a reserve is barred` FALSE FALSE TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- E: a reserve invested outside the business, but only the "being used" statement is given: not the statement paragraph (a) asks for
#ASSERT `s 201(17) the representation that the company has a reserve is barred` FALSE FALSE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- F: financial statements prepared in accordance with this Act are outside the bar
#ASSERT `s 201(17) the representation that the company has a reserve is barred` TRUE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- G: a banking corporation is outside the bar
#ASSERT `s 201(17) the representation that the company has a reserve is barred` FALSE TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- H: no representation of a reserve
#ASSERT `s 201(17) the representation that the company has a reserve is barred` FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- I: a reserve neither invested outside the business nor used in it: the text is silent
#ASSERT `s 201(17) the representation that the company has a reserve is barred` FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- EXPECT BREACH (the forbidden publication occurs)
#TRACE `s 201(17) a company must not publish a document that represents that it has a reserve unless the representation is accompanied` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 201(17) publish a document or advertisement that represents that the company has a reserve without the accompanying statement` AT 3

-- EXPECT RESIDUAL (no event: the standing prohibition; reads as a standing obligation, not a pass)
#TRACE `s 201(17) a company must not publish a document that represents that it has a reserve unless the representation is accompanied` "Acme Pte Ltd" AT 0 WITH

§ `s 201(18) and (19): banks and charities`

#ASSERT `s 201(18) the form and content provisions apply to the banking corporation as they stand` TRUE FALSE EQUALS JUST TRUE
-- the Monetary Authority of Singapore has determined modifications: the content of the determination is outside the text
#ASSERT `s 201(18) the form and content provisions apply to the banking corporation as they stand` TRUE TRUE EQUALS NOTHING
-- not a banking corporation: not covered
#ASSERT `s 201(18) the form and content provisions apply to the banking corporation as they stand` FALSE FALSE EQUALS NOTHING
#ASSERT `s 201(19) the Accounting Standards requirements apply to the charity as they stand` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 201(19) the Accounting Standards requirements apply to the charity as they stand` TRUE TRUE EQUALS NOTHING
#ASSERT `s 201(19) the Accounting Standards requirements apply to the charity as they stand` FALSE FALSE EQUALS NOTHING

§ `s 201(20) to (23): old financial years`

#ASSERT `s 201(20) the documents are within a reference to the preceding financial statements` TRUE EQUALS JUST TRUE
#ASSERT `s 201(20) the documents are within a reference to the preceding financial statements` FALSE EQUALS NOTHING
-- both sides of 1 July 2015 for a financial year that ended on the day
#ASSERT `s 201(21) the laying of the documents is within a reference to the requirement to lay financial statements` TRUE (Date 30 6 2015) EQUALS JUST TRUE
#ASSERT `s 201(21) the laying of the documents is within a reference to the requirement to lay financial statements` TRUE (Date 1 7 2015) EQUALS NOTHING
#ASSERT `s 201(21) the laying of the documents is within a reference to the requirement to lay financial statements` FALSE (Date 30 6 2015) EQUALS NOTHING
#ASSERT `s 201(22) subsection (16) applies to the company for the financial year` (Date 30 6 2015) EQUALS JUST FALSE
#ASSERT `s 201(22) subsection (16) applies to the company for the financial year` (Date 1 7 2015) EQUALS NOTHING
#ASSERT `s 201(22) the earlier provisions of section 201 continue to apply to the company for the financial year` (Date 31 12 2014) EQUALS JUST TRUE
#ASSERT `s 201(22) the earlier provisions of section 201 continue to apply to the company for the financial year` (Date 31 12 2015) EQUALS NOTHING
#ASSERT `s 201(23) the company must attach a copy of the report prepared under section 201(5) as it then stood to the return` (Date 30 6 2015) EQUALS JUST TRUE
#ASSERT `s 201(23) the company must attach a copy of the report prepared under section 201(5) as it then stood to the return` (Date 1 7 2015) EQUALS NOTHING

-- EXPECT FULFILLED
#TRACE `s 201(23) a company with an old financial year must attach a copy of the report to its return` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 201(23) attach a copy of the report prepared under section 201(5) as in force before 1 July 2015 to the return` AT 2

-- EXPECT RESIDUAL (no time limit and no consequence inside the subsection)
#TRACE `s 201(23) a company with an old financial year must attach a copy of the report to its return` "Acme Pte Ltd" AT 0 WITH
