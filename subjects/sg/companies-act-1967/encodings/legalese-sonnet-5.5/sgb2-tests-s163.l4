#ASSERT `s 163B the thing done is within the exception from sections 162, 163 and 172` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 163B the thing done is within the exception from sections 162, 163 and 172` FALSE TRUE EQUALS JUST TRUE
