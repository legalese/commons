IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgb1-s156-interests`

-- Tests for sgb1-s156-interests.l4 (Companies Act 1967, s 156; text lines 12936-13166 of CoA1967.txt).
-- Every expected value was written from the text of the Act, not from what the code printed; each group names the words it rests on.
-- JUST TRUE yes; JUST FALSE the text says no in its own words; NOTHING the text does not say.


-- s 156(13): "an interest of a member of a director's family is treated as an interest of the director and the words ... include his or her spouse, son, adopted son, stepson, daughter, adopted daughter and stepdaughter"
#ASSERT `s 156(13) the person is a member of the director's or chief executive officer's family whose interest is treated as an interest of the director or chief executive officer` `s 156(13) spouse` EQUALS JUST TRUE
-- the last relation listed
#ASSERT `s 156(13) the person is a member of the director's or chief executive officer's family whose interest is treated as an interest of the director or chief executive officer` `s 156(13) stepdaughter` EQUALS JUST TRUE
#ASSERT `s 156(13) the person is a member of the director's or chief executive officer's family whose interest is treated as an interest of the director or chief executive officer` `s 156(13) adopted son` EQUALS JUST TRUE
-- "include": the list is open, so a brother, say, is not covered
#ASSERT `s 156(13) the person is a member of the director's or chief executive officer's family whose interest is treated as an interest of the director or chief executive officer` `s 156(13) another relation` EQUALS NOTHING

-- s 156(3): "The requirements of subsection (1) do not apply in any case where the interest ... consists only of being a member or creditor of a corporation which is interested in a transaction ... if the interest ... may properly be regarded as not being a material interest"
#ASSERT `s 156(3) the requirements of subsection (1) do not apply` TRUE TRUE EQUALS JUST TRUE
-- a material interest
#ASSERT `s 156(3) the requirements of subsection (1) do not apply` TRUE FALSE EQUALS JUST FALSE
-- an interest of another kind: the "where" gate fails (ruling (b))
#ASSERT `s 156(3) the requirements of subsection (1) do not apply` FALSE TRUE EQUALS JUST FALSE

-- s 156(4): "not deemed to be interested ... by reason only -- (a) in the case where the transaction ... relates to any loan to the company -- that he or she has guaranteed ... the loan; or (b) in the case where the transaction ... with ... a corporation which by virtue of section 6 is deemed to be related to the company -- that he or she is a director or chief executive officer of that corporation"
-- (a): a guarantee of a loan to the company
#ASSERT `s 156(4) the director or chief executive officer is not deemed to be interested in the transaction by reason only of the guarantee or the office` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- (b): a director of a corporation related by section 6
#ASSERT `s 156(4) the director or chief executive officer is not deemed to be interested in the transaction by reason only of the guarantee or the office` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- (b) without the office: neither reason named
#ASSERT `s 156(4) the director or chief executive officer is not deemed to be interested in the transaction by reason only of the guarantee or the office` FALSE TRUE FALSE TRUE EQUALS NOTHING
-- "by reason only": the guarantee is not the only reason, so the subsection says nothing
#ASSERT `s 156(4) the director or chief executive officer is not deemed to be interested in the transaction by reason only of the guarantee or the office` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- neither reason named
#ASSERT `s 156(4) the director or chief executive officer is not deemed to be interested in the transaction by reason only of the guarantee or the office` FALSE FALSE FALSE TRUE EQUALS NOTHING

-- s 156(4): "this subsection has effect not only for the purposes of this Act but also for the purposes of any other law, but does not affect the operation of any provision in the constitution of the company"
#ASSERT `s 156(4) the subsection has effect for the purpose` `s 156(4) the purposes of this Act` EQUALS JUST TRUE
#ASSERT `s 156(4) the subsection has effect for the purpose` `s 156(4) the purposes of any other law` EQUALS JUST TRUE
#ASSERT `s 156(4) the subsection has effect for the purpose` `s 156(4) a provision in the constitution of the company` EQUALS JUST FALSE

-- s 156(1): "every director or chief executive officer of a company who is in any way, whether directly or indirectly, interested in a transaction or proposed transaction with the company must as soon as is practicable ... (a) declare ...; or (b) send a written notice"; with (3) and (4)
#ASSERT `s 156(1) the director or chief executive officer must declare the nature of the interest or send a written notice` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- not a director or chief executive officer: outside "every director or chief executive officer"
#ASSERT `s 156(1) the director or chief executive officer must declare the nature of the interest or send a written notice` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
-- not interested: outside "who is ... interested"
#ASSERT `s 156(1) the director or chief executive officer must declare the nature of the interest or send a written notice` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- subsection (4): not deemed to be interested
#ASSERT `s 156(1) the director or chief executive officer must declare the nature of the interest or send a written notice` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- subsection (3): only a member or creditor, and not material
#ASSERT `s 156(1) the director or chief executive officer must declare the nature of the interest or send a written notice` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- subsection (3): a material interest
#ASSERT `s 156(1) the director or chief executive officer must declare the nature of the interest or send a written notice` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- (a)
#ASSERT `s 156(1) the person has made the declaration or sent the written notice the subsection requires` TRUE FALSE EQUALS JUST TRUE
-- (b)
#ASSERT `s 156(1) the person has made the declaration or sent the written notice the subsection requires` FALSE TRUE EQUALS JUST TRUE
-- neither: the duty is not met
#ASSERT `s 156(1) the person has made the declaration or sent the written notice the subsection requires` FALSE FALSE EQUALS JUST FALSE

-- s 156(2): the notice under (1)(b) must be given as soon as practicable after (a) the date the person became a director or chief executive officer, or (b) (if already one) the date the person became interested
-- (a)
#ASSERT `s 156(2) the date after which the notice under subsection (1)(b) must be given as soon as practicable` FALSE (Date 1 1 2026) (Date 1 3 2026) EQUALS (Date 1 1 2026)
-- (b): already a director
#ASSERT `s 156(2) the date after which the notice under subsection (1)(b) must be given as soon as practicable` TRUE (Date 1 1 2026) (Date 1 3 2026) EQUALS (Date 1 3 2026)

-- s 156(8): the notice under (6)(b) must be given as soon as practicable after (a) the date the person became a director or chief executive officer, or (b) (if already one) the date the person commenced to hold the office or possess the property
-- (a)
#ASSERT `s 156(8) the date after which the written notice under subsection (6)(b) must be given as soon as practicable` FALSE (Date 1 1 2026) (Date 1 3 2026) EQUALS (Date 1 1 2026)
-- (b): already a director
#ASSERT `s 156(8) the date after which the written notice under subsection (6)(b) must be given as soon as practicable` TRUE (Date 1 1 2026) (Date 1 3 2026) EQUALS (Date 1 3 2026)

-- s 156(5): a declaration or written notice is treated as sufficient for a later transaction "if (a) in the case of a declaration, the declaration is given at a meeting of the directors or the director ... takes reasonable steps to ensure that it is brought up and read at the next meeting; (b) ... to the effect that (i) he or she is an officer or a member of a specified corporation ...; and (ii) ... to be regarded as interested in any transaction which may, after the date ..., be made with ...; (c) ... specifies the nature and extent ...; and (d) at the time ... his or her interest is not different in nature or greater in extent"
-- a declaration given at a meeting, with (b), (c) and (d)
#ASSERT `s 156(5) the declaration or written notice is treated as a sufficient declaration or written notice in relation to the transaction` `s 156(5) a declaration under subsection (1)(a)` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- a declaration with reasonable steps to have it read at the next meeting
#ASSERT `s 156(5) the declaration or written notice is treated as a sufficient declaration or written notice in relation to the transaction` `s 156(5) a declaration under subsection (1)(a)` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- (a) fails for a declaration
#ASSERT `s 156(5) the declaration or written notice is treated as a sufficient declaration or written notice in relation to the transaction` `s 156(5) a declaration under subsection (1)(a)` FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- (a) is stated "in the case of a declaration": a written notice needs only (b), (c) and (d)
#ASSERT `s 156(5) the declaration or written notice is treated as a sufficient declaration or written notice in relation to the transaction` `s 156(5) a written notice under subsection (1)(b)` FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- (b)(i) fails
#ASSERT `s 156(5) the declaration or written notice is treated as a sufficient declaration or written notice in relation to the transaction` `s 156(5) a written notice under subsection (1)(b)` FALSE FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- (b)(ii) fails
#ASSERT `s 156(5) the declaration or written notice is treated as a sufficient declaration or written notice in relation to the transaction` `s 156(5) a written notice under subsection (1)(b)` FALSE FALSE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- (c) fails
#ASSERT `s 156(5) the declaration or written notice is treated as a sufficient declaration or written notice in relation to the transaction` `s 156(5) a written notice under subsection (1)(b)` FALSE FALSE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- (d) fails: the interest is different or greater
#ASSERT `s 156(5) the declaration or written notice is treated as a sufficient declaration or written notice in relation to the transaction` `s 156(5) a written notice under subsection (1)(b)` FALSE FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE

-- s 156(6): "Every director and chief executive officer of a company who holds any office or possess any property whereby ... any duty or interest might be created in conflict ... must -- (a) declare at a meeting of the directors ...; or (b) send a written notice"
#ASSERT `s 156(6) the director or chief executive officer must declare the conflict or send a written notice` TRUE TRUE EQUALS JUST TRUE
-- not a director or chief executive officer
#ASSERT `s 156(6) the director or chief executive officer must declare the conflict or send a written notice` FALSE TRUE EQUALS NOTHING
-- holds no such office or property
#ASSERT `s 156(6) the director or chief executive officer must declare the conflict or send a written notice` TRUE FALSE EQUALS NOTHING
-- (a)
#ASSERT `s 156(6) the person has made the declaration or sent the written notice the subsection requires` TRUE FALSE EQUALS JUST TRUE
-- (b)
#ASSERT `s 156(6) the person has made the declaration or sent the written notice the subsection requires` FALSE TRUE EQUALS JUST TRUE
-- neither: the duty is not met
#ASSERT `s 156(6) the person has made the declaration or sent the written notice the subsection requires` FALSE FALSE EQUALS JUST FALSE

-- s 156(7): "A declaration under subsection (6)(a) must be made at the first meeting of the directors of the company held (a) after he or she becomes a director or chief executive officer; or (b) (if already a director ...) after he or she commenced to hold the office or to possess the property"; meetings held 15 May, 10 June (listed out of order), 5 July 2026
-- the earliest meeting after 1 June, whatever the order of the list
#ASSERT `s 156(7) the first of the meetings held after the date` (Date 1 6 2026) (LIST (Date 5 7 2026), (Date 10 6 2026), (Date 15 5 2026)) EQUALS JUST (Date 10 6 2026)
-- no meeting held after the date: silent
#ASSERT `s 156(7) the first of the meetings held after the date` (Date 1 6 2026) (LIST (Date 15 5 2026), (Date 1 6 2026)) EQUALS NOTHING
-- no meeting at all
#ASSERT `s 156(7) the first of the meetings held after the date` (Date 1 6 2026) (LIST) EQUALS NOTHING
-- assumed, not ruled: a meeting on the very day is not "after" it (fork line in NOTES.md)
#ASSERT `s 156(7) the first of the meetings held after the date` (Date 1 6 2026) (LIST (Date 1 6 2026), (Date 2 6 2026)) EQUALS JUST (Date 2 6 2026)
-- (a): after becoming a director
#ASSERT `s 156(7) the meeting of the directors at which the declaration under subsection (6)(a) must be made` FALSE (Date 1 6 2026) (Date 1 7 2026) (LIST (Date 10 6 2026), (Date 10 7 2026)) EQUALS JUST (Date 10 6 2026)
-- (b): after commencing to hold the office or property
#ASSERT `s 156(7) the meeting of the directors at which the declaration under subsection (6)(a) must be made` TRUE (Date 1 6 2026) (Date 1 7 2026) (LIST (Date 10 6 2026), (Date 10 7 2026)) EQUALS JUST (Date 10 7 2026)
-- (b) and no later meeting
#ASSERT `s 156(7) the meeting of the directors at which the declaration under subsection (6)(a) must be made` TRUE (Date 1 6 2026) (Date 1 7 2026) (LIST (Date 10 6 2026)) EQUALS NOTHING

-- s 156(9): "send a copy of the notice to (a) in the case where the notice is given by a chief executive officer -- all the directors; or (b) in the case where the notice is given by a director -- all the other directors"
#ASSERT `s 156(9) the persons to whom the company must send a copy of the notice` TRUE TRUE FALSE EQUALS `s 156(9)(a) all the directors`
#ASSERT `s 156(9) the persons to whom the company must send a copy of the notice` TRUE FALSE TRUE EQUALS `s 156(9)(b) all the other directors`
-- no written notice received
#ASSERT `s 156(9) the persons to whom the company must send a copy of the notice` FALSE TRUE FALSE EQUALS `s 156(9) no one the subsection names`
-- given by neither a chief executive officer nor a director
#ASSERT `s 156(9) the persons to whom the company must send a copy of the notice` TRUE FALSE FALSE EQUALS `s 156(9) no one the subsection names`

-- s 156(10): "Where a chief executive officer or a director ... declares an interest or conflict by a written notice ... in accordance with this section -- (a) the making of the declaration is deemed to form part of the proceedings at the next meeting of the directors after the notice is given; and (b) the provisions of section 188 (minutes of proceedings) apply as if the declaration had been made at that meeting"
#ASSERT `s 156(10)(a) the declaration is deemed to form part of the proceedings at the next meeting of the directors after the notice is given` TRUE EQUALS JUST TRUE
-- a "Where" gate that fails
#ASSERT `s 156(10)(a) the declaration is deemed to form part of the proceedings at the next meeting of the directors after the notice is given` FALSE EQUALS JUST FALSE
#ASSERT `s 156(10)(b) section 188 applies as if the declaration had been made at that meeting` TRUE EQUALS JUST TRUE
-- a "Where" gate that fails
#ASSERT `s 156(10)(b) section 188 applies as if the declaration had been made at that meeting` FALSE EQUALS JUST FALSE

-- s 156(11): "The secretary of the company must record every declaration under this section in the minutes of the meeting at which it was made and keep records of every written resolution duly signed and returned"
#ASSERT `s 156(11) the secretary must record the declaration in the minutes of the meeting at which it was made` TRUE EQUALS JUST TRUE
-- no declaration made at a meeting: outside "every declaration"
#ASSERT `s 156(11) the secretary must record the declaration in the minutes of the meeting at which it was made` FALSE EQUALS NOTHING
#ASSERT `s 156(11) the secretary must keep a record of the written resolution` TRUE EQUALS JUST TRUE
#ASSERT `s 156(11) the secretary must keep a record of the written resolution` FALSE EQUALS NOTHING

-- s 156(12): "The directors of a company must permit a chief executive officer of the company who is not a director to attend a meeting of the board of directors where such attendance is necessary for the chief executive officer to make a declaration"
#ASSERT `s 156(12) the directors must permit the chief executive officer to attend the meeting of the board of directors` TRUE TRUE EQUALS JUST TRUE
-- a "where" gate (attendance necessary) that fails (ruling (b))
#ASSERT `s 156(12) the directors must permit the chief executive officer to attend the meeting of the board of directors` TRUE FALSE EQUALS JUST FALSE
-- a director: outside the words "who is not a director"
#ASSERT `s 156(12) the directors must permit the chief executive officer to attend the meeting of the board of directors` FALSE TRUE EQUALS JUST FALSE

-- s 156(14): "Subject to subsection (4), this section is in addition to and not in derogation of the operation of any rule of law or any provision in the constitution restricting a director ... from having any interest in transactions with the company"
-- a flat negative
#ASSERT `s 156(14) the section derogates from the rule of law or the provision in the constitution` TRUE FALSE EQUALS JUST FALSE
-- "Subject to subsection (4)": where subsection (4) applies the text says no more here
#ASSERT `s 156(14) the section derogates from the rule of law or the provision in the constitution` TRUE TRUE EQUALS NOTHING
-- no restricting rule or provision: outside the subsection
#ASSERT `s 156(14) the section derogates from the rule of law or the provision in the constitution` FALSE FALSE EQUALS NOTHING

-- s 156(15): "Any director or chief executive officer of a company who fails to comply with any of the provisions of this section shall be guilty of an offence and shall be liable on conviction to a fine not exceeding $5,000 or to imprisonment for a term not exceeding 12 months" (the text says "or", not "or to both")
#ASSERT `s 156(15) the person is guilty of the offence this subsection creates` TRUE TRUE EQUALS JUST TRUE
-- complies
#ASSERT `s 156(15) the person is guilty of the offence this subsection creates` TRUE FALSE EQUALS JUST FALSE
-- not a director or chief executive officer
#ASSERT `s 156(15) the person is guilty of the offence this subsection creates` FALSE TRUE EQUALS JUST FALSE
-- a fine of $5,000 or 12 months; not both
#ASSERT `s 156(15) the most the person may be penalised on conviction` TRUE TRUE EQUALS JUST (`s 156(15) penalty` OF 5000, 12, FALSE)
#ASSERT `s 156(15) the most the person may be penalised on conviction` TRUE FALSE EQUALS NOTHING

-- Regulative rules: each #TRACE has an EXPECT line above it naming the outcome the text gives. s 156(1), (11) and (12) have no number of days ("as soon as is practicable", no time limit): no breach path (NOTES.md). s 156(7) has a time the first meeting fixes.

-- the director declares
-- EXPECT FULFILLED
#TRACE `s 156(1) a director must declare the nature of the interest` "D" AT 0 WITH
    PARTY Director "D" DOES `s 156(1) declare the nature of the interest at a meeting of the directors, or send a written notice to the company` AT 3

-- a very late declaration still reads FULFILLED: "as soon as is practicable" is not a number of days
-- EXPECT FULFILLED
#TRACE `s 156(1) a director must declare the nature of the interest` "D" AT 0 WITH
    PARTY Director "D" DOES `s 156(1) declare the nature of the interest at a meeting of the directors, or send a written notice to the company` AT 400

-- nothing declared: the obligation stays open, never BREACH
-- EXPECT RESIDUAL
#TRACE `s 156(1) a director must declare the nature of the interest` "D" AT 0 WITH
    WAITUNTIL 400

-- became a director on 1 June, the first meeting is 11 July, day 40: declared at that meeting
-- EXPECT FULFILLED
#TRACE `s 156(7) a director must declare the conflict at the first meeting of the directors held after` "D" 40 AT 0 WITH
    PARTY Director "D" DOES `s 156(7) declare the conflict at the first meeting of the directors held after the date` AT 40

-- declared a day after the meeting
-- EXPECT BREACH
#TRACE `s 156(7) a director must declare the conflict at the first meeting of the directors held after` "D" 40 AT 0 WITH
    PARTY Director "D" DOES `s 156(7) declare the conflict at the first meeting of the directors held after the date` AT 41

-- not declared by the meeting
-- EXPECT BREACH
#TRACE `s 156(7) a director must declare the conflict at the first meeting of the directors held after` "D" 40 AT 0 WITH
    WAITUNTIL 41

-- the secretary records the declaration
-- EXPECT FULFILLED
#TRACE `s 156(11) the secretary must record every declaration in the minutes` "Sec" AT 0 WITH
    PARTY Secretary "Sec" DOES `s 156(11) record the declaration in the minutes` AT 2

-- nothing recorded: no deadline, never BREACH
-- EXPECT RESIDUAL
#TRACE `s 156(11) the secretary must record every declaration in the minutes` "Sec" AT 0 WITH
    WAITUNTIL 400

-- the directors permit the attendance
-- EXPECT FULFILLED
#TRACE `s 156(12) the directors must permit the chief executive officer to attend` "D" AT 0 WITH
    PARTY Director "D" DOES `s 156(12) permit the chief executive officer to attend the meeting of the board of directors` AT 2

-- attendance not permitted: no deadline, never BREACH
-- EXPECT RESIDUAL
#TRACE `s 156(12) the directors must permit the chief executive officer to attend` "D" AT 0 WITH
    WAITUNTIL 400
