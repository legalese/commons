    IF `the thing is a share in the share capital of a corporation`
    THEN JUST TRUE
    ELSE (IF `the thing is stock` AND `a distinction between stocks and shares is expressed or implied`
          THEN JUST FALSE   -- FALSE-kind (the text says no in its own words): "includes stock except where a distinction between stocks and shares is expressed or implied"
          ELSE (IF `the thing is stock`
                THEN JUST TRUE
                ELSE NOTHING))   -- NOTHING-kind (includes): "share means share in the share capital of a corporation and includes stock" leaves the list open


