#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(b) a person present or personally present at a meeting` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(b) a person present or personally present at a meeting` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (c) and (d): a vote or voting by electronic means or any other means the constitution permits
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(c) a vote of a member at a meeting` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(c) a vote of a member at a meeting` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(d) voting by a member at a meeting` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(d) voting by a member at a meeting` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (e): where the person is present by virtual meeting technology
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(e) the entitlement or right of a person to vote at a meeting` TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(e) the entitlement or right of a person to vote at a meeting` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(e) the entitlement or right of a person to vote at a meeting` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (f): on a show of hands, "but only if the person can be identified"
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(f) voting by a person on a show of hands` TRUE FALSE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(f) voting by a person on a show of hands` TRUE FALSE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(f) voting by a person on a show of hands` TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(f) voting by a person on a show of hands` TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(f) voting by a person on a show of hands` TRUE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (g), (h), (i), (j): where the person is present by VMT, by synchronous communication the directors determine
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(g) the entitlement or right of a person to be heard at a meeting` TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(g) the entitlement or right of a person to be heard at a meeting` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(h) the right of a person to speak on a resolution before a meeting` TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(h) the right of a person to speak on a resolution before a meeting` TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(i) the right of a person to speak at a meeting` TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(i) the right of a person to speak at a meeting` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
