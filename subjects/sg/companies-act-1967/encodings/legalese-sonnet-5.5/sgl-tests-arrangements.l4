IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgl-arrangements`

-- Tests for sgl-arrangements.l4 (s 173J). Every expected value below was decided from the text of s 173J before the module was run (never copied from its output).
-- JUST TRUE is yes; JUST FALSE is the text's no; NOTHING is "the text does not say".

§ `s 173J(1): the meetings the section applies to`

#ASSERT `s 173J(1) the section applies to the meeting` `an annual general meeting` FALSE `s 173J(1)(f) no meeting ordered by the Court` FALSE EQUALS JUST TRUE
#ASSERT `s 173J(1) the section applies to the meeting` `an extraordinary general meeting` FALSE `s 173J(1)(f) no meeting ordered by the Court` FALSE EQUALS JUST TRUE
#ASSERT `s 173J(1) the section applies to the meeting` `the statutory meeting` FALSE `s 173J(1)(f) no meeting ordered by the Court` FALSE EQUALS JUST TRUE
#ASSERT `s 173J(1) the section applies to the meeting` `a meeting of a class of members` FALSE `s 173J(1)(f) no meeting ordered by the Court` FALSE EQUALS JUST TRUE
-- (d): a general meeting of an amalgamating company mentioned in section 215C or 215D
#ASSERT `s 173J(1) the section applies to the meeting` `a meeting of creditors` TRUE `s 173J(1)(f) no meeting ordered by the Court` FALSE EQUALS JUST TRUE
-- (f)(i) and (ii): ordered by the Court "if the Court so directs"
#ASSERT `s 173J(1) the section applies to the meeting` `a meeting of creditors` FALSE `s 173J(1)(f)(i) a meeting ordered by the Court under section 182` TRUE EQUALS JUST TRUE
#ASSERT `s 173J(1) the section applies to the meeting` `a meeting of creditors` FALSE `s 173J(1)(f)(ii) a meeting of creditors, members, holders of units of shares, or a class of such persons, ordered by the Court under section 210` TRUE EQUALS JUST TRUE
#ASSERT `s 173J(1) the section applies to the meeting` `a meeting of creditors` FALSE `s 173J(1)(f)(i) a meeting ordered by the Court under section 182` FALSE EQUALS JUST FALSE
#ASSERT `s 173J(1) the section applies to the meeting` `a meeting of creditors` FALSE `s 173J(1)(f)(ii) a meeting of creditors, members, holders of units of shares, or a class of such persons, ordered by the Court under section 210` FALSE EQUALS JUST FALSE
-- a meeting of no listed type: the list does not say "only", so the text does not say
#ASSERT `s 173J(1) the section applies to the meeting` `a meeting of creditors` FALSE `s 173J(1)(f) no meeting ordered by the Court` FALSE EQUALS NOTHING
#ASSERT `s 173J(1) the section applies to the meeting` `a meeting of creditors` FALSE `s 173J(1)(f) no meeting ordered by the Court` TRUE EQUALS NOTHING

§ `s 173J(2) and (3): how a meeting may be held`

#ASSERT `s 173J(2) the meeting may be held in the way` `s 173J(2)(a) at a physical place` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(2) the meeting may be held in the way` `s 173J(2)(a) at a physical place` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 173J(2) the meeting may be held in the way` `s 173J(2)(b) at a physical place and using virtual meeting technology` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(2) the meeting may be held in the way` `s 173J(2)(b) at a physical place and using virtual meeting technology` TRUE TRUE FALSE EQUALS NOTHING
-- (7) excludes only (2)(c), not (2)(b)
#ASSERT `s 173J(2) the meeting may be held in the way` `s 173J(2)(b) at a physical place and using virtual meeting technology` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 173J(2) the meeting may be held in the way` `s 173J(2)(c) using virtual meeting technology only` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(2) the meeting may be held in the way` `s 173J(2)(c) using virtual meeting technology only` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 173J(2) the meeting may be held in the way` `s 173J(2)(c) using virtual meeting technology only` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 173J(2) the meeting may be held in the way` `s 173J(2)(c) using virtual meeting technology only` FALSE FALSE FALSE EQUALS NOTHING
-- s 173J(3): a failed "Where" gate on the participants' liberty answers NOTHING (S1b ruling, 2026S1bC)
#ASSERT `s 173J(3) the participants need not be together at the same place` `s 173J(2)(b) at a physical place and using virtual meeting technology` TRUE EQUALS JUST TRUE
#ASSERT `s 173J(3) the participants need not be together at the same place` `s 173J(2)(c) using virtual meeting technology only` TRUE EQUALS JUST TRUE
#ASSERT `s 173J(3) the participants need not be together at the same place` `s 173J(2)(a) at a physical place` TRUE EQUALS NOTHING
#ASSERT `s 173J(3) the participants need not be together at the same place` `s 173J(2)(c) using virtual meeting technology only` FALSE EQUALS NOTHING

§ `s 173J(4): the table of references`

-- arguments after the paragraph: held with virtual meeting technology; excluded; present by VMT; electronic or constitution-permitted means; identified by prescribed method;
-- identified by directors' method (none prescribed); synchronous means the directors determined; made available during the meeting; on a website; by other means the company determined
-- (a) and (b): attendance
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(a) a person attending a meeting` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(a) a person attending a meeting` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(a) a person attending a meeting` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
