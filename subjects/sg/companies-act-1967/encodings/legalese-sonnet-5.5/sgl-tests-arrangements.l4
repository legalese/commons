#ASSERT `s 173J(4) the reference includes the virtual form of what it names` `s 173J(4)(q) a statement or other document being laid or caused to be laid before the company at a meeting` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE

§ `s 173J(5): when the section yields to the constitution`

-- arguments: incorporated; the date the exclusion took effect; excludes (2)(b) or (c); excludes or modifies (4)
#ASSERT `s 173J(5) the constitution excludes or modifies the section` (Date 1 6 2023) (Date 1 7 2023) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(5) the constitution excludes or modifies the section` (Date 30 6 2023) (Date 1 7 2023) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 173J(5) the constitution excludes or modifies the section` (Date 1 6 2023) (Date 30 6 2023) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 173J(5) the constitution excludes or modifies the section` (Date 1 7 2023) (Date 1 7 2023) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 173J(5) the constitution excludes or modifies the section` (Date 15 1 2024) (Date 15 1 2024) FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 173J(5) the constitution excludes or modifies the section` (Date 15 1 2024) (Date 1 2 2025) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 173J(5) the constitution excludes or modifies the section` (Date 15 1 2024) (Date 15 1 2024) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 173J(5) the constitution excludes or modifies the section` (Date 1 1 2010) (Date 1 1 2015) TRUE TRUE EQUALS JUST FALSE

