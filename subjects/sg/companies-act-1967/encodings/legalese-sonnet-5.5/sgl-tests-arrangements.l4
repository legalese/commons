#ASSERT `s 173J(6) the reference to a member in subsection (4) includes the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 173J(6) the reference to a member in subsection (4) includes the person` FALSE TRUE EQUALS NOTHING
