IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgj-div5-debentures`

-- Tests for ss 93 to 100 (Division 5, debentures). Every expected value is written from the text of the section, not from the output of the code.

§ `Section 93(1) to (4)`

-- (1): arguments: the company issues debentures; transferable by delivery; keeps a register; at the registered office or another place in Singapore
#ASSERT `s 93(1) the company has kept the register as the subsection requires` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 93(1) the company has kept the register as the subsection requires` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 93(1) the company has kept the register as the subsection requires` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 93(1) the company has kept the register as the subsection requires` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- debentures transferable by delivery: the duty is not addressed to the company; a company that issues no debentures
#ASSERT `s 93(1) the company has kept the register as the subsection requires` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 93(1) the company has kept the register as the subsection requires` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- a standing duty with no time limit: never breached by the passing of time
-- EXPECT FULFILLED
#TRACE `s 93(1) the company must keep a register of holders of the debentures` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 93(1) keep a register of holders of the debentures at the registered office or at some other place in Singapore` AT 5

-- EXPECT RESIDUAL
#TRACE `s 93(1) the company must keep a register of holders of the debentures` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- (2): 7 days after the register is first kept elsewhere, or after any change of place
#ASSERT `s 93(2) the last day for lodging notice of the place or of the change` (Date 1 1 2026) EQUALS Date 8 1 2026
#ASSERT `s 93(2) the last day for lodging notice of the place or of the change` (Date 28 1 2026) EQUALS Date 4 2 2026
#ASSERT `s 93(2) the notice was lodged within 7 days` (Date 1 1 2026) (Date 8 1 2026) EQUALS JUST TRUE
#ASSERT `s 93(2) the notice was lodged within 7 days` (Date 1 1 2026) (Date 9 1 2026) EQUALS JUST FALSE
#ASSERT `s 93(2) the notice was lodged within 7 days` (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST TRUE
-- EXPECT FULFILLED
#TRACE `s 93(2) the company must lodge notice of the place or of the change within 7 days` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 93(2) lodge with the Registrar notice of the place where the register is kept, or of the change of place` AT 7

-- EXPECT BREACH
#TRACE `s 93(2) the company must lodge notice of the place or of the change within 7 days` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 93(2) lodge with the Registrar notice of the place where the register is kept, or of the change of place` AT 8

-- EXPECT BREACH
#TRACE `s 93(2) the company must lodge notice of the place or of the change within 7 days` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 8)

-- (4): duly closed: in accordance with the provisions, during the periods specified, not more than 30 days in the calendar year in aggregate
#ASSERT `s 93(4) the register is deemed to be duly closed` TRUE TRUE 30 EQUALS JUST TRUE
#ASSERT `s 93(4) the register is deemed to be duly closed` TRUE TRUE 0 EQUALS JUST TRUE
#ASSERT `s 93(4) the register is deemed to be duly closed` TRUE TRUE 31 EQUALS NOTHING
#ASSERT `s 93(4) the register is deemed to be duly closed` TRUE FALSE 10 EQUALS NOTHING
#ASSERT `s 93(4) the register is deemed to be duly closed` FALSE TRUE 10 EQUALS NOTHING
-- (3): inspection by a registered holder of debentures and by a holder of shares, except when duly closed; the content
#ASSERT `s 93(3) the register must be open to the inspection of the person` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 93(3) the register must be open to the inspection of the person` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 93(3) the register must be open to the inspection of the person` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 93(3) the register must be open to the inspection of the person` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 93(3) the register must be open to the inspection of the person` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 93(3) the register has the content the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 93(3) the register has the content the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 93(3) the register has the content the subsection requires` FALSE TRUE EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 93(3) the company must keep the register open to inspection` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 93(3) keep the register open to inspection` AT 3

-- EXPECT RESIDUAL
#TRACE `s 93(3) the company must keep the register open to inspection` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 100)

§ `Section 93(5) to (9)`

#ASSERT `s 93(5) the company must supply the person with a copy of the register` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 93(5) the company must supply the person with a copy of the register` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 93(5) the company must supply the person with a copy of the register` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 93(5) the company must supply the person with a copy of the register` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 93(5) the most the company may require to be paid for the copy of the register` 3 EQUALS 3
#ASSERT `s 93(5) the most the company may require to be paid for the copy of the register` 0 EQUALS 0
-- "the copy need not include any particulars ... other than the debenture holder's name and address and the debentures held"
#ASSERT `s 93(5) the copy must include the particulars` TRUE EQUALS JUST FALSE
#ASSERT `s 93(5) the copy must include the particulars` FALSE EQUALS NOTHING
#ASSERT `s 93(6) the company must forward the copy of the trust deed to the holder` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 93(6) the company must forward the copy of the trust deed to the holder` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 93(6) the company must forward the copy of the trust deed to the holder` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 93(6) the company must forward the copy of the trust deed to the holder` FALSE TRUE TRUE EQUALS NOTHING
-- $3 for a copy; $1 a page where specially made (4 pages: $4; a 10-page deed that is not specially made: still $3)
#ASSERT `s 93(6) the most the company may require to be paid for the copy of the trust deed` FALSE 10 EQUALS 3
#ASSERT `s 93(6) the most the company may require to be paid for the copy of the trust deed` TRUE 4 EQUALS 4
#ASSERT `s 93(6) the most the company may require to be paid for the copy of the trust deed` TRUE 1 EQUALS 1
-- the one-month outer limit (the trace clock counts months)
-- EXPECT FULFILLED
#TRACE `s 93(6) the company must forward the copy of the trust deed within one month` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 93(6) forward a copy of the trust deed` AT 1

-- EXPECT BREACH
#TRACE `s 93(6) the company must forward the copy of the trust deed within one month` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 93(6) forward a copy of the trust deed` AT 2

-- (7): "within a reasonable time (but not more than one month)"
#ASSERT `s 93(7) the copy was forwarded within the time the subsection allows` (Date 1 1 2026) (Date 1 2 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 93(7) the copy was forwarded within the time the subsection allows` (Date 1 1 2026) (Date 2 2 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 93(7) the copy was forwarded within the time the subsection allows` (Date 1 1 2026) (Date 10 1 2026) FALSE EQUALS JUST FALSE
-- a request on 31 January 2026: one month later is the last day of February (sg-periods P4), 28 February 2026
#ASSERT `s 93(7) the copy was forwarded within the time the subsection allows` (Date 31 1 2026) (Date 28 2 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 93(7) the copy was forwarded within the time the subsection allows` (Date 31 1 2026) (Date 1 3 2026) TRUE EQUALS JUST FALSE
-- the offence: arguments: inspection refused; copy refused; copy not forwarded in time; the company; an officer in default
#ASSERT `s 93(7) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 93(7) the person is guilty of the offence this subsection creates` FALSE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 93(7) the person is guilty of the offence this subsection creates` FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 93(7) the person is guilty of the offence this subsection creates` FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 93(7) the person is guilty of the offence this subsection creates` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- subsection (7) states no penalty: the text does not say (subsection (9) does)
#ASSERT `s 93(7) the most the person may be sentenced to on conviction under this subsection` TRUE EQUALS NOTHING
-- (8)
#ASSERT `s 93(8) the company may cause a branch register of debenture holders to be kept outside Singapore` TRUE EQUALS JUST TRUE
#ASSERT `s 93(8) the company may cause a branch register of debenture holders to be kept outside Singapore` FALSE EQUALS NOTHING
#ASSERT `s 93(8) the register is a branch register of holders of debentures kept pursuant to section 93` TRUE EQUALS JUST TRUE
#ASSERT `s 93(8) the register is a branch register of holders of debentures kept pursuant to section 93` FALSE EQUALS NOTHING
#ASSERT `s 93(8) the branch register is deemed to be part of the company's register of debenture holders` TRUE EQUALS JUST TRUE
#ASSERT `s 93(8) the branch register is deemed to be part of the company's register of debenture holders` FALSE EQUALS NOTHING
#ASSERT `s 93(8) Division 4 of Part 5 applies, with the adaptations necessary, to the keeping of the branch register` TRUE EQUALS JUST TRUE
#ASSERT `s 93(8) Division 4 of Part 5 applies, with the adaptations necessary, to the keeping of the branch register` FALSE EQUALS NOTHING
-- (9): the offence, "a fine not exceeding $1,000 and also to a default penalty"
#ASSERT `s 93(9) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 93(9) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 93(9) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 93(9) the person is guilty of the offence this subsection creates` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 93(9) the most the person may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
#ASSERT `s 93(9) the most the person may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING

§ `Sections 94 to 96`

#ASSERT `s 94 the contract may be enforced by an order for specific performance` TRUE EQUALS JUST TRUE
#ASSERT `s 94 the contract may be enforced by an order for specific performance` FALSE EQUALS NOTHING
#ASSERT `s 95 the condition is invalid by reason only that it makes the debentures irredeemable or redeemable only on a contingency or after a period` TRUE TRUE EQUALS JUST FALSE
-- another ground of invalidity is relied on; the condition is not in a debenture or deed
#ASSERT `s 95 the condition is invalid by reason only that it makes the debentures irredeemable or redeemable only on a contingency or after a period` TRUE FALSE EQUALS NOTHING
#ASSERT `s 95 the condition is invalid by reason only that it makes the debentures irredeemable or redeemable only on a contingency or after a period` FALSE TRUE EQUALS NOTHING
-- s 96(1): arguments: the company has redeemed debentures; a provision to the contrary; manifested an intention to cancel
#ASSERT `s 96(1) the company has power to reissue the redeemed debentures` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 96(1) the company has power to reissue the redeemed debentures` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 96(1) the company has power to reissue the redeemed debentures` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 96(1) the company has power to reissue the redeemed debentures` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 96(1) the company has power to reissue the redeemed debentures` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 96(1) the reissue is regarded as the issue of a new debenture for the purpose of a provision limiting the amount or number of debentures` TRUE EQUALS JUST FALSE
#ASSERT `s 96(1) the reissue is regarded as the issue of a new debenture for the purpose of a provision limiting the amount or number of debentures` FALSE EQUALS NOTHING
#ASSERT `s 96(2) the person entitled to the debentures has the same priorities as if the debentures had never been redeemed` TRUE EQUALS JUST TRUE
#ASSERT `s 96(2) the person entitled to the debentures has the same priorities as if the debentures had never been redeemed` FALSE EQUALS NOTHING
#ASSERT `s 96(3) the debentures are deemed to have been redeemed by reason of the account having ceased to be in debit` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 96(3) the debentures are deemed to have been redeemed by reason of the account having ceased to be in debit` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 96(3) the debentures are deemed to have been redeemed by reason of the account having ceased to be in debit` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 96(3) the debentures are deemed to have been redeemed by reason of the account having ceased to be in debit` TRUE TRUE FALSE EQUALS NOTHING

§ `Section 100`

#ASSERT `s 100(3) subsection (1) applies to the debenture` TRUE EQUALS JUST FALSE
#ASSERT `s 100(3) subsection (1) applies to the debenture` FALSE EQUALS NOTHING
#ASSERT `s 100(2) subsection (1) affects the power` TRUE EQUALS JUST FALSE
#ASSERT `s 100(2) subsection (1) affects the power` FALSE EQUALS NOTHING
-- (1): arguments: irredeemable or redeemable only on a contingency; the applicant is the trustee (or a holder where there is none); (a) assets sufficient at the issue; the sum the security would bring;
-- the principal sum outstanding; (c) assets worth less than the principal sum; (c) the corporation is not making sufficient profit; offered to the public
#ASSERT `s 100(1) the Court may order that the security be enforceable` TRUE TRUE TRUE 50 100 TRUE TRUE FALSE EQUALS JUST TRUE
-- (b) "not more than 60%": exactly 60 of 100 is within it, 61 is not, 59 is
#ASSERT `s 100(1) the Court may order that the security be enforceable` TRUE TRUE TRUE 60 100 TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 100(1) the Court may order that the security be enforceable` TRUE TRUE TRUE 59 100 TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 100(1) the Court may order that the security be enforceable` TRUE TRUE TRUE 61 100 TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 100(1) the Court may order that the security be enforceable` TRUE TRUE TRUE 600 1000 TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 100(1) the Court may order that the security be enforceable` TRUE TRUE TRUE 601 1000 TRUE TRUE FALSE EQUALS NOTHING
-- each other gate unmet
#ASSERT `s 100(1) the Court may order that the security be enforceable` FALSE TRUE TRUE 50 100 TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 100(1) the Court may order that the security be enforceable` TRUE FALSE TRUE 50 100 TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 100(1) the Court may order that the security be enforceable` TRUE TRUE FALSE 50 100 TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 100(1) the Court may order that the security be enforceable` TRUE TRUE TRUE 50 100 FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 100(1) the Court may order that the security be enforceable` TRUE TRUE TRUE 50 100 TRUE FALSE FALSE EQUALS NOTHING
-- offered to the public: subsection (3) says subsection (1) does not apply
#ASSERT `s 100(1) the Court may order that the security be enforceable` TRUE TRUE TRUE 50 100 TRUE TRUE TRUE EQUALS JUST FALSE
