IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgc1-s203a`

-- Tests for sgc1-s203a.l4 (s 203A). Expected values are written from the text, beside each assertion.

§ `s 203A(1): sending a summary instead`

-- a case the regulations specify, every specified condition complied with
#ASSERT `s 203A(1) the company may send a summary financial statement instead of copies of the documents referred to in section 203(1)` TRUE TRUE EQUALS JUST TRUE
-- a specified case, a condition not complied with: "provided all the conditions so specified are complied with"
#ASSERT `s 203A(1) the company may send a summary financial statement instead of copies of the documents referred to in section 203(1)` TRUE FALSE EQUALS JUST FALSE
-- not a case the regulations specify: the regulations are not among the sources
#ASSERT `s 203A(1) the company may send a summary financial statement instead of copies of the documents referred to in section 203(1)` FALSE TRUE EQUALS NOTHING
#ASSERT `s 203A(1) the company may send a summary financial statement instead of copies of the documents referred to in section 203(1)` FALSE FALSE EQUALS NOTHING

§ `s 203A(2): a member asks for the summary`

#ASSERT `s 203A(2) the person may instead request a summary financial statement` TRUE TRUE EQUALS JUST TRUE
-- the company sent no summary: "Where a company sends to its members a summary financial statement"
#ASSERT `s 203A(2) the person may instead request a summary financial statement` FALSE TRUE EQUALS JUST FALSE
-- not a member or debenture holder entitled to a copy under section 203(3)
#ASSERT `s 203A(2) the person may instead request a summary financial statement` TRUE FALSE EQUALS NOTHING
#ASSERT `s 203A(2) the person may instead request a summary financial statement` FALSE FALSE EQUALS NOTHING

§ `s 203A(3) and (4): the member who does or does not want it`

#ASSERT `s 203A(3) the company need not send the summary financial statement to the member` TRUE EQUALS JUST TRUE
#ASSERT `s 203A(3) the company need not send the summary financial statement to the member` FALSE EQUALS JUST FALSE

#ASSERT `s 203A(4) the company must send copies of the documents referred to in section 203(1) to the member` TRUE TRUE EQUALS JUST TRUE
-- a member who does not wish to receive them, or a person who is not a member
#ASSERT `s 203A(4) the company must send copies of the documents referred to in section 203(1) to the member` TRUE FALSE EQUALS NOTHING
#ASSERT `s 203A(4) the company must send copies of the documents referred to in section 203(1) to the member` FALSE TRUE EQUALS NOTHING

-- EXPECT FULFILLED
#TRACE `s 203A(4) the company must send copies of the documents to the member who wishes to receive them` "Acme Ltd" 7 AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 203A(4) send copies of the documents referred to in section 203(1) to the member who wishes to receive them` AT 5

-- EXPECT RESIDUAL (no time limit and no consequence inside the subsection)
#TRACE `s 203A(4) the company must send copies of the documents to the member who wishes to receive them` "Acme Ltd" 7 AT 0 WITH

§ `s 203A(5) and (6): what a summary financial statement must be`

#ASSERT `s 203A(5) the summary financial statement is derived and in the form the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 203A(5) the summary financial statement is derived and in the form the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 203A(5) the summary financial statement is derived and in the form the subsection requires` FALSE TRUE EQUALS JUST FALSE

-- states that it is only a summary, and the auditors' statement is there
#ASSERT `s 203A(6) the summary financial statement contains the statements the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
-- the auditors' statement is missing
#ASSERT `s 203A(6) the summary financial statement contains the statements the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- "(if any)": a company with no auditors owes no auditors' statement
#ASSERT `s 203A(6) the summary financial statement contains the statements the subsection requires` TRUE FALSE FALSE EQUALS JUST TRUE
-- it does not say it is only a summary
#ASSERT `s 203A(6) the summary financial statement contains the statements the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 203A(6) the summary financial statement contains the statements the subsection requires` FALSE FALSE FALSE EQUALS JUST FALSE

#ASSERT `s 203A(6A) the directors have ensured that the summary financial statements comply with subsections (5) and (6)` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- each requirement failing in turn
#ASSERT `s 203A(6A) the directors have ensured that the summary financial statements comply with subsections (5) and (6)` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 203A(6A) the directors have ensured that the summary financial statements comply with subsections (5) and (6)` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 203A(6A) the directors have ensured that the summary financial statements comply with subsections (5) and (6)` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 203A(6A) the directors have ensured that the summary financial statements comply with subsections (5) and (6)` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- no auditors: no auditors' statement is owed
#ASSERT `s 203A(6A) the directors have ensured that the summary financial statements comply with subsections (5) and (6)` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE

-- EXPECT FULFILLED
#TRACE `s 203A(6A) the directors must ensure that the summary financial statements comply` "Ann" AT 0 WITH
    PARTY Director "Ann" DOES `s 203A(6A) ensure that the summary financial statements comply with the requirements referred to in subsections (5) and (6)` AT 3

-- EXPECT RESIDUAL (no time limit and no consequence inside the subsection)
#TRACE `s 203A(6A) the directors must ensure that the summary financial statements comply` "Ann" AT 0 WITH

§ `s 203A(7): the offence of default`

-- the company in default
#ASSERT `s 203A(7) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST TRUE
-- an officer in default
#ASSERT `s 203A(7) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST TRUE
-- neither the company nor an officer in default
#ASSERT `s 203A(7) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST FALSE
-- no default of this kind (a default of subsection (6A) alone is left out of the subsection)
#ASSERT `s 203A(7) the person is guilty of the offence this subsection creates` FALSE TRUE FALSE EQUALS JUST FALSE
-- $5,000 and a default penalty; no imprisonment in the text
#ASSERT `s 203A(7) the most the person may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (`s 203A(7) penalty` OF 5000, 0, FALSE, TRUE)
#ASSERT `s 203A(7) the most the person may be sentenced to on conviction` TRUE FALSE TRUE EQUALS JUST (`s 203A(7) penalty` OF 5000, 0, FALSE, TRUE)
#ASSERT `s 203A(7) the most the person may be sentenced to on conviction` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 203A(7) the most the person may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING
