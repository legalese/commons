IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgc1-s203`

-- Tests for sgc1-s203.l4 (s 203). Expected values are written from the text, beside each assertion.

§ `s 203(1): sending the documents`

#ASSERT `s 203(1) the company must send the documents to all persons entitled to receive notice of general meetings` TRUE TRUE EQUALS JUST TRUE
-- the documents are not duly audited, or are not the ones to be laid: outside the duty
#ASSERT `s 203(1) the company must send the documents to all persons entitled to receive notice of general meetings` FALSE TRUE EQUALS NOTHING
#ASSERT `s 203(1) the company must send the documents to all persons entitled to receive notice of general meetings` TRUE FALSE EQUALS NOTHING

-- a meeting on 30 June 2026: not less than 14 days before is 16 June 2026
#ASSERT `s 203(1)(a) the last day for sending the documents` (Date 30 6 2026) EQUALS (Date 16 6 2026)
-- the financial year ends on 31 December 2025: 5 months after is 31 May 2026
#ASSERT `s 203(1)(b) the last day for sending the documents` (Date 31 12 2025) EQUALS (Date 31 5 2026)
-- the financial year ends on 30 September 2025: no 30 February, so 28 February 2026 (P4)
#ASSERT `s 203(1)(b) the last day for sending the documents` (Date 30 9 2025) EQUALS (Date 28 2 2026)

-- paragraph (a), the meeting on 30 June 2026, no agreement under subsection (2): both sides of 16 June
#ASSERT `s 203(1) the documents were sent in time` FALSE FALSE (Date 30 6 2026) (Date 31 12 2025) (Date 16 6 2026) EQUALS JUST TRUE
#ASSERT `s 203(1) the documents were sent in time` FALSE FALSE (Date 30 6 2026) (Date 31 12 2025) (Date 17 6 2026) EQUALS JUST FALSE
#ASSERT `s 203(1) the documents were sent in time` FALSE FALSE (Date 30 6 2026) (Date 31 12 2025) (Date 1 6 2026) EQUALS JUST TRUE
-- subsection (2) applies: sending less than 14 days before the meeting is allowed; on the day of the meeting, still before it is over
#ASSERT `s 203(1) the documents were sent in time` FALSE TRUE (Date 30 6 2026) (Date 31 12 2025) (Date 17 6 2026) EQUALS JUST TRUE
#ASSERT `s 203(1) the documents were sent in time` FALSE TRUE (Date 30 6 2026) (Date 31 12 2025) (Date 30 6 2026) EQUALS JUST TRUE
-- subsection (2) applies and the documents are sent after the meeting: the text is silent
#ASSERT `s 203(1) the documents were sent in time` FALSE TRUE (Date 30 6 2026) (Date 31 12 2025) (Date 1 7 2026) EQUALS NOTHING
-- paragraph (b), the year ending 31 December 2025: both sides of 31 May 2026 (the meeting date is not used)
#ASSERT `s 203(1) the documents were sent in time` TRUE FALSE (Date 1 1 2000) (Date 31 12 2025) (Date 31 5 2026) EQUALS JUST TRUE
#ASSERT `s 203(1) the documents were sent in time` TRUE FALSE (Date 1 1 2000) (Date 31 12 2025) (Date 1 6 2026) EQUALS JUST FALSE
-- the agreement of subsection (2) is a paragraph (a) matter and does not move paragraph (b)
#ASSERT `s 203(1) the documents were sent in time` TRUE TRUE (Date 1 1 2000) (Date 31 12 2025) (Date 1 6 2026) EQUALS JUST FALSE

-- now is 1 June 2026, the last day is 16 June 2026: 15 days from now
-- EXPECT FULFILLED
#TRACE `s 203(1) the company must send the documents by the last day` "Acme Ltd" 15 AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 203(1) send the documents to all persons entitled to receive notice of general meetings of the company` AT 15

-- EXPECT BREACH
#TRACE `s 203(1) the company must send the documents by the last day` "Acme Ltd" 15 AT 0 WITH
    WAITUNTIL 16

§ `s 203(2): sending less than 14 days before the meeting`

#ASSERT `s 203(2) the documents may be sent less than 14 days before the date of the meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 203(2) the documents may be sent less than 14 days before the date of the meeting` FALSE EQUALS NOTHING

§ `s 203(3): a copy on request`

-- a member to whom copies have not been sent, who asks
#ASSERT `s 203(3) the company must furnish the person without charge with a copy of the last financial statements and the auditor's report` TRUE FALSE TRUE EQUALS JUST TRUE
-- a debenture holder, who asks
#ASSERT `s 203(3) the company must furnish the person without charge with a copy of the last financial statements and the auditor's report` FALSE TRUE TRUE EQUALS JUST TRUE
-- no request made
#ASSERT `s 203(3) the company must furnish the person without charge with a copy of the last financial statements and the auditor's report` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 203(3) the company must furnish the person without charge with a copy of the last financial statements and the auditor's report` FALSE TRUE FALSE EQUALS JUST FALSE
-- neither a member to whom copies have not been sent nor a debenture holder
#ASSERT `s 203(3) the company must furnish the person without charge with a copy of the last financial statements and the auditor's report` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 203(3) the company must furnish the person without charge with a copy of the last financial statements and the auditor's report` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 203(3) the company must furnish the person without charge with a copy of the last financial statements and the auditor's report` TRUE TRUE TRUE EQUALS JUST TRUE

-- EXPECT FULFILLED
#TRACE `s 203(3) the company must furnish a copy of the last financial statements on request` "Acme Ltd" 7 AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 203(3) furnish the member or debenture holder without charge with a copy of the last financial statements and the auditor's report` AT 6

-- EXPECT RESIDUAL (no time limit and no consequence inside the subsection)
#TRACE `s 203(3) the company must furnish a copy of the last financial statements on request` "Acme Ltd" 7 AT 0 WITH

§ `s 203(3A): the offence of default`

#ASSERT `s 203(3A) the subsection gives the person a defence on these facts` TRUE EQUALS JUST TRUE
-- not proved: "this section gives no defence on these facts"
#ASSERT `s 203(3A) the subsection gives the person a defence on these facts` FALSE EQUALS JUST FALSE
-- the company, in default, no defence
#ASSERT `s 203(3A) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- an officer in default, no defence
#ASSERT `s 203(3A) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- neither the company nor an officer in default
#ASSERT `s 203(3A) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- no default
#ASSERT `s 203(3A) the person is guilty of the offence this subsection creates` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- the defence is proved
#ASSERT `s 203(3A) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- $5,000 and a default penalty; no imprisonment in the text
#ASSERT `s 203(3A) the most the person may be sentenced to on conviction` TRUE TRUE FALSE FALSE EQUALS JUST (`s 203(3A) penalty` OF 5000, 0, FALSE, TRUE)
#ASSERT `s 203(3A) the most the person may be sentenced to on conviction` TRUE FALSE TRUE FALSE EQUALS JUST (`s 203(3A) penalty` OF 5000, 0, FALSE, TRUE)
#ASSERT `s 203(3A) the most the person may be sentenced to on conviction` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 203(3A) the most the person may be sentenced to on conviction` TRUE TRUE FALSE TRUE EQUALS NOTHING

§ `s 203(4) and (4A): requiring a general meeting`

-- the documents were sent out on 1 July 2026: 14 days after is 15 July 2026
#ASSERT `s 203(4) the last day for the notice requiring a general meeting` (Date 1 7 2026) EQUALS (Date 15 7 2026)
-- the end of a month: sent on 20 January 2026, 14 days after is 3 February 2026
#ASSERT `s 203(4) the last day for the notice requiring a general meeting` (Date 20 1 2026) EQUALS (Date 3 2 2026)
#ASSERT `s 203(4) the person may by notice require that a general meeting be held to lay the documents before the company` TRUE TRUE (Date 1 7 2026) (Date 15 7 2026) EQUALS JUST TRUE
#ASSERT `s 203(4) the person may by notice require that a general meeting be held to lay the documents before the company` TRUE TRUE (Date 1 7 2026) (Date 16 7 2026) EQUALS JUST FALSE
#ASSERT `s 203(4) the person may by notice require that a general meeting be held to lay the documents before the company` TRUE TRUE (Date 1 7 2026) (Date 2 7 2026) EQUALS JUST TRUE
-- not a case referred to in subsection (1)(b), or not a member or the auditor
#ASSERT `s 203(4) the person may by notice require that a general meeting be held to lay the documents before the company` FALSE TRUE (Date 1 7 2026) (Date 15 7 2026) EQUALS NOTHING
#ASSERT `s 203(4) the person may by notice require that a general meeting be held to lay the documents before the company` TRUE FALSE (Date 1 7 2026) (Date 15 7 2026) EQUALS NOTHING

#ASSERT `s 203(4A) the person may by notice require that a general meeting be held to lay the documents before the company` TRUE TRUE (Date 1 7 2026) (Date 15 7 2026) EQUALS JUST TRUE
#ASSERT `s 203(4A) the person may by notice require that a general meeting be held to lay the documents before the company` TRUE TRUE (Date 1 7 2026) (Date 16 7 2026) EQUALS JUST FALSE
-- the company is not within section 175A(1)(b): "Where ..." fails
#ASSERT `s 203(4A) the person may by notice require that a general meeting be held to lay the documents before the company` FALSE TRUE (Date 1 7 2026) (Date 15 7 2026) EQUALS JUST FALSE
-- not a member or the auditor
#ASSERT `s 203(4A) the person may by notice require that a general meeting be held to lay the documents before the company` TRUE FALSE (Date 1 7 2026) (Date 15 7 2026) EQUALS NOTHING
#ASSERT `s 203(4A) the person may by notice require that a general meeting be held to lay the documents before the company` FALSE FALSE (Date 1 7 2026) (Date 15 7 2026) EQUALS NOTHING

§ `s 203(5): the notice and section 175A(5)`

#ASSERT `s 203(5) section 175A(5) applies, with the necessary modifications, to the giving of the notice` TRUE EQUALS JUST TRUE
#ASSERT `s 203(5) section 175A(5) applies, with the necessary modifications, to the giving of the notice` FALSE EQUALS NOTHING

§ `s 203(6): the directors convene the meeting`

#ASSERT `s 203(6) the directors must convene a meeting for the purpose referred to in the notice` TRUE EQUALS JUST TRUE
#ASSERT `s 203(6) the directors must convene a meeting for the purpose referred to in the notice` FALSE EQUALS NOTHING
-- the notice was given on 1 July 2026: 14 days after is 15 July 2026
#ASSERT `s 203(6) the last day for the directors to convene the meeting` (Date 1 7 2026) EQUALS (Date 15 7 2026)
#ASSERT `s 203(6) the directors convened the meeting in time` (Date 1 7 2026) (Date 15 7 2026) EQUALS JUST TRUE
#ASSERT `s 203(6) the directors convened the meeting in time` (Date 1 7 2026) (Date 16 7 2026) EQUALS JUST FALSE
#ASSERT `s 203(6) the directors convened the meeting in time` (Date 1 7 2026) (Date 3 7 2026) EQUALS JUST TRUE

-- EXPECT FULFILLED
#TRACE `s 203(6) the directors must within 14 days convene the meeting` "Ann" AT 0 WITH
    PARTY Director "Ann" DOES `s 203(6) convene a meeting for the purpose of laying the documents before the company` AT 14

-- EXPECT BREACH
#TRACE `s 203(6) the directors must within 14 days convene the meeting` "Ann" AT 0 WITH
    WAITUNTIL 15

-- EXPECT BREACH
#TRACE `s 203(6) the directors must within 14 days convene the meeting` "Ann" AT 0 WITH
    PARTY Director "Ann" DOES `s 203(6) convene a meeting for the purpose of laying the documents before the company` AT 15

§ `s 203(7): default in convening the meeting`

#ASSERT `s 203(7)(a) the person is guilty of the offence this paragraph creates` TRUE TRUE EQUALS JUST TRUE
-- not a director in default
#ASSERT `s 203(7)(a) the person is guilty of the offence this paragraph creates` TRUE FALSE EQUALS JUST FALSE
-- the meeting was convened
#ASSERT `s 203(7)(a) the person is guilty of the offence this paragraph creates` FALSE TRUE EQUALS JUST FALSE
-- $5,000, no imprisonment, no default penalty
#ASSERT `s 203(7)(a) the most the person may be sentenced to on conviction` TRUE TRUE EQUALS JUST (`s 203(7)(a) penalty` OF 5000, 0, FALSE, FALSE)
#ASSERT `s 203(7)(a) the most the person may be sentenced to on conviction` FALSE TRUE EQUALS NOTHING
#ASSERT `s 203(7)(a) the most the person may be sentenced to on conviction` TRUE FALSE EQUALS NOTHING
-- the Court: default made and the member or auditor applies
#ASSERT `s 203(7)(b) the Court may order a general meeting to be called` TRUE TRUE EQUALS JUST TRUE
-- default made and no application
#ASSERT `s 203(7)(b) the Court may order a general meeting to be called` TRUE FALSE EQUALS JUST FALSE
-- no default made
#ASSERT `s 203(7)(b) the Court may order a general meeting to be called` FALSE TRUE EQUALS NOTHING
#ASSERT `s 203(7)(b) the Court may order a general meeting to be called` FALSE FALSE EQUALS NOTHING
