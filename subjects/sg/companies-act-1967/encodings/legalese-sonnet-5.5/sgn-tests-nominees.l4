IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgn-nominees`

-- Tests for sgn-nominees.l4 (ss 386AKA, 386AL, 386ALA, 386ALB). Expected values are written from the text beside each assertion.
-- The appointed day is an input; the tests use 16 June 2025 (assumed test value, the date the consolidation's amendment marks show; not text).

§ `s 386AKA(1): keep the register of nominee directors`

-- arguments: the body is a company or a foreign company registered under Division 2 of Part 11; it has kept the register in the prescribed form and place
#ASSERT `s 386AKA(1) the company or foreign company has kept the register of nominee directors as required` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AKA(1) the company or foreign company has kept the register of nominee directors as required` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 386AKA(1) the company or foreign company has kept the register of nominee directors as required` FALSE TRUE EQUALS NOTHING
#ASSERT `s 386AKA(1) the company or foreign company has kept the register of nominee directors as required` FALSE FALSE EQUALS NOTHING

§ `s 386AKA(2): the register of nominee directors is not to be shown to a member of the public`

-- arguments: the person is a member of the public; the disclosure is under s 386AM
#ASSERT `s 386AKA(2) the company or foreign company is barred from disclosing the register of nominee directors to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AKA(2) the company or foreign company is barred from disclosing the register of nominee directors to the person` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386AKA(2) the company or foreign company is barred from disclosing the register of nominee directors to the person` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 386AKA(2) the company or foreign company is barred from disclosing the register of nominee directors to the person` FALSE FALSE EQUALS NOTHING

§ `s 386AKA(3), (4), (5): enter within 7 days after the company is informed`

-- arguments: entered; the day entered; the day informed; the date asked. Informed on 1 June 2026: the last day is 8 June 2026.
#ASSERT `s 386AKA(3) the company or foreign company has entered the fact and the particulars in time` TRUE (Date 8 6 2026) (Date 1 6 2026) (Date 20 6 2026) EQUALS JUST TRUE
#ASSERT `s 386AKA(3) the company or foreign company has entered the fact and the particulars in time` TRUE (Date 9 6 2026) (Date 1 6 2026) (Date 20 6 2026) EQUALS JUST FALSE
#ASSERT `s 386AKA(3) the company or foreign company has entered the fact and the particulars in time` FALSE (Date 1 1 2000) (Date 1 6 2026) (Date 9 6 2026) EQUALS JUST FALSE
#ASSERT `s 386AKA(3) the company or foreign company has entered the fact and the particulars in time` FALSE (Date 1 1 2000) (Date 1 6 2026) (Date 8 6 2026) EQUALS NOTHING
#ASSERT `s 386AKA(4) the company or foreign company has entered the cessation in time` TRUE (Date 8 6 2026) (Date 1 6 2026) (Date 20 6 2026) EQUALS JUST TRUE
#ASSERT `s 386AKA(4) the company or foreign company has entered the cessation in time` TRUE (Date 9 6 2026) (Date 1 6 2026) (Date 20 6 2026) EQUALS JUST FALSE
#ASSERT `s 386AKA(4) the company or foreign company has entered the cessation in time` FALSE (Date 1 1 2000) (Date 1 6 2026) (Date 8 6 2026) EQUALS NOTHING
#ASSERT `s 386AKA(5) the company or foreign company has entered the change in time` TRUE (Date 8 6 2026) (Date 1 6 2026) (Date 20 6 2026) EQUALS JUST TRUE
#ASSERT `s 386AKA(5) the company or foreign company has entered the change in time` TRUE (Date 9 6 2026) (Date 1 6 2026) (Date 20 6 2026) EQUALS JUST FALSE
#ASSERT `s 386AKA(5) the company or foreign company has entered the change in time` FALSE (Date 1 1 2000) (Date 1 6 2026) (Date 9 6 2026) EQUALS JUST FALSE

§ `s 386AKA(6): the offence`

#ASSERT `s 386AKA(6) the company or foreign company is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 386AKA(6) the company or foreign company is guilty of the offence` FALSE EQUALS JUST FALSE
#ASSERT `s 386AKA(6) the officer of the company or foreign company is guilty of the offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AKA(6) the officer of the company or foreign company is guilty of the offence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 386AKA(6) the officer of the company or foreign company is guilty of the offence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 386AKA(6) the most the company or foreign company or an officer in default may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (Penalty OF 25000, 0, FALSE, FALSE)
#ASSERT `s 386AKA(6) the most the company or foreign company or an officer in default may be sentenced to on conviction` TRUE FALSE TRUE EQUALS JUST (Penalty OF 25000, 0, FALSE, FALSE)
#ASSERT `s 386AKA(6) the most the company or foreign company or an officer in default may be sentenced to on conviction` FALSE TRUE FALSE EQUALS NOTHING

§ `s 386AL(1): a company incorporated on or after 31 March 2017 but before the appointed day`

-- arguments: the date of incorporation; the appointed day; nominee on the date of incorporation; becomes a nominee after it; the date the director becomes a nominee
#ASSERT `s 386AL(1) the last day by which the director must have informed the company` (Date 1 1 2020) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 31 1 2020)
-- paragraph (b): becomes a nominee 10 March 2020; 21 days to 31 March plus 9: 9 April 2020
#ASSERT `s 386AL(1) the last day by which the director must have informed the company` (Date 1 1 2020) (Date 16 6 2025) FALSE TRUE (Date 10 3 2020) EQUALS JUST (Date 9 4 2020)
-- the date of becoming is not after the date of incorporation
#ASSERT `s 386AL(1) the last day by which the director must have informed the company` (Date 1 1 2020) (Date 16 6 2025) FALSE TRUE (Date 1 1 2020) EQUALS NOTHING
#ASSERT `s 386AL(1) the last day by which the director must have informed the company` (Date 1 1 2020) (Date 16 6 2025) FALSE FALSE (Date 1 1 2000) EQUALS NOTHING
-- the first day the subsection covers, and the day before
#ASSERT `s 386AL(1) the last day by which the director must have informed the company` (Date 31 3 2017) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 30 4 2017)
#ASSERT `s 386AL(1) the last day by which the director must have informed the company` (Date 30 3 2017) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING
-- the last day it covers (the day before the appointed day) and the appointed day itself
#ASSERT `s 386AL(1) the last day by which the director must have informed the company` (Date 15 6 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 15 7 2025)
#ASSERT `s 386AL(1) the last day by which the director must have informed the company` (Date 16 6 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING

§ `s 386AL(1A): a company incorporated on or after the appointed day`

#ASSERT `s 386AL(1A) the last day by which the director must have informed the company` (Date 16 6 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 16 6 2025)
#ASSERT `s 386AL(1A) the last day by which the director must have informed the company` (Date 15 6 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING
-- paragraph (b): becomes a nominee 1 August 2025; 31 days in August, so 31 August 2025
#ASSERT `s 386AL(1A) the last day by which the director must have informed the company` (Date 1 7 2025) (Date 16 6 2025) FALSE TRUE (Date 1 8 2025) EQUALS JUST (Date 31 8 2025)
#ASSERT `s 386AL(1A) the last day by which the director must have informed the company` (Date 1 7 2025) (Date 16 6 2025) FALSE FALSE (Date 1 1 2000) EQUALS NOTHING

§ `s 386AL(2): a company incorporated before 31 March 2017`

-- arguments: the date of incorporation; becomes a nominee after 31 March 2017; the date the director becomes a nominee
#ASSERT `s 386AL(2) the last day by which the director must have informed the company` (Date 1 1 2010) TRUE (Date 1 6 2020) EQUALS JUST (Date 1 7 2020)
-- 1 April 2017 is after 31 March 2017; 31 March 2017 itself is not
#ASSERT `s 386AL(2) the last day by which the director must have informed the company` (Date 1 1 2010) TRUE (Date 1 4 2017) EQUALS JUST (Date 1 5 2017)
#ASSERT `s 386AL(2) the last day by which the director must have informed the company` (Date 1 1 2010) TRUE (Date 31 3 2017) EQUALS NOTHING
#ASSERT `s 386AL(2) the last day by which the director must have informed the company` (Date 1 1 2010) FALSE (Date 1 6 2020) EQUALS NOTHING
-- a company incorporated on 31 March 2017 is not "before 31 March 2017"
#ASSERT `s 386AL(2) the last day by which the director must have informed the company` (Date 31 3 2017) TRUE (Date 1 6 2020) EQUALS NOTHING

§ `s 386AL(3), (5A): cessation and change`

#ASSERT `s 386AL(3) the last day by which the director must have informed the company` (Date 1 6 2026) EQUALS JUST (Date 1 7 2026)
-- arguments: the foreign company is registered under Division 2 of Part 11; the date of cessation or change
#ASSERT `s 386AL(5A) the last day by which the director must have informed the foreign company` TRUE (Date 1 6 2026) EQUALS JUST (Date 1 7 2026)
#ASSERT `s 386AL(5A) the last day by which the director must have informed the foreign company` FALSE (Date 1 6 2026) EQUALS NOTHING

§ `s 386AL(4): a foreign company registered on or after the appointed day`

#ASSERT `s 386AL(4) the last day by which the director must have informed the foreign company` (Date 16 6 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 16 6 2025)
#ASSERT `s 386AL(4) the last day by which the director must have informed the foreign company` (Date 15 6 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING
-- paragraph (b): becomes a nominee 1 October 2025; 31 October 2025
#ASSERT `s 386AL(4) the last day by which the director must have informed the foreign company` (Date 1 9 2025) (Date 16 6 2025) FALSE TRUE (Date 1 10 2025) EQUALS JUST (Date 31 10 2025)

§ `s 386AL(5): a foreign company registered before the appointed day`

-- arguments: the date of registration; the appointed day; nominee on the appointed day; becomes a nominee after the appointed day; the date the director becomes a nominee
-- paragraph (a): 60 days after 16 June 2025: 14 days to 30 June, 31 in July, 15 in August: 15 August 2025
#ASSERT `s 386AL(5) the last day by which the director must have informed the foreign company` (Date 1 1 2020) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 15 8 2025)
#ASSERT `s 386AL(5) the last day by which the director must have informed the foreign company` (Date 1 1 2020) (Date 16 6 2025) FALSE TRUE (Date 1 1 2026) EQUALS JUST (Date 31 1 2026)
-- becomes a nominee on the appointed day itself is not "after the appointed day"
#ASSERT `s 386AL(5) the last day by which the director must have informed the foreign company` (Date 1 1 2020) (Date 16 6 2025) FALSE TRUE (Date 16 6 2025) EQUALS NOTHING
#ASSERT `s 386AL(5) the last day by which the director must have informed the foreign company` (Date 16 6 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING

§ `s 386AL(1), (1A), (2), (4) and (5) together`

-- arguments: the kind of body; the date of incorporation or registration; the appointed day; nominee on that date; nominee on the appointed day; becomes a nominee after that date; the date the director becomes a nominee
#ASSERT `s 386AL(1), (1A), (2), (4) and (5) the last day by which the director must have informed the company or foreign company` `s 386AL a company` (Date 1 1 2020) (Date 16 6 2025) TRUE FALSE FALSE (Date 1 1 2000) EQUALS JUST (Date 31 1 2020)
#ASSERT `s 386AL(1), (1A), (2), (4) and (5) the last day by which the director must have informed the company or foreign company` `s 386AL a company` (Date 1 7 2025) (Date 16 6 2025) TRUE FALSE FALSE (Date 1 1 2000) EQUALS JUST (Date 1 7 2025)
-- before 31 March 2017, a director who was a nominee already: paragraph (a) is deleted, so the text says nothing
#ASSERT `s 386AL(1), (1A), (2), (4) and (5) the last day by which the director must have informed the company or foreign company` `s 386AL a company` (Date 1 1 2010) (Date 16 6 2025) TRUE FALSE FALSE (Date 1 1 2000) EQUALS NOTHING
#ASSERT `s 386AL(1), (1A), (2), (4) and (5) the last day by which the director must have informed the company or foreign company` `s 386AL a company` (Date 1 1 2010) (Date 16 6 2025) FALSE FALSE TRUE (Date 1 6 2020) EQUALS JUST (Date 1 7 2020)
#ASSERT `s 386AL(1), (1A), (2), (4) and (5) the last day by which the director must have informed the company or foreign company` `s 386AL a foreign company registered under Division 2 of Part 11` (Date 1 9 2025) (Date 16 6 2025) TRUE FALSE FALSE (Date 1 1 2000) EQUALS JUST (Date 1 9 2025)
#ASSERT `s 386AL(1), (1A), (2), (4) and (5) the last day by which the director must have informed the company or foreign company` `s 386AL a foreign company registered under Division 2 of Part 11` (Date 1 1 2020) (Date 16 6 2025) FALSE TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 15 8 2025)
#ASSERT `s 386AL(1), (1A), (2), (4) and (5) the last day by which the director must have informed the company or foreign company` `s 386AL a foreign company registered under Division 2 of Part 11` (Date 1 1 2020) (Date 16 6 2025) FALSE FALSE TRUE (Date 1 1 2026) EQUALS JUST (Date 31 1 2026)

§ `s 386AL(6), (8), (9)`

#ASSERT `s 386AL(6) the director is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 386AL(6) the director is guilty of the offence` FALSE EQUALS JUST FALSE
#ASSERT `s 386AL(6) the most the director may be sentenced to on conviction` TRUE EQUALS JUST (Penalty OF 25000, 0, FALSE, FALSE)
#ASSERT `s 386AL(6) the most the director may be sentenced to on conviction` FALSE EQUALS NOTHING
#ASSERT `s 386AL(8) the director is a nominee` TRUE EQUALS JUST TRUE
#ASSERT `s 386AL(8) the director is a nominee` FALSE EQUALS JUST FALSE
#ASSERT `s 386AL(9) "appointed day" the appointed day` (Date 16 6 2025) EQUALS (Date 16 6 2025)

§ `s 386ALA: the register of nominee shareholders`

#ASSERT `s 386ALA(1) the company or foreign company has kept the register of nominee shareholders as required` TRUE EQUALS JUST TRUE
#ASSERT `s 386ALA(1) the company or foreign company has kept the register of nominee shareholders as required` FALSE EQUALS JUST FALSE
#ASSERT `s 386ALA(2) the company or foreign company has entered the fact and the particulars in time` TRUE (Date 8 6 2026) (Date 1 6 2026) (Date 20 6 2026) EQUALS JUST TRUE
#ASSERT `s 386ALA(2) the company or foreign company has entered the fact and the particulars in time` TRUE (Date 9 6 2026) (Date 1 6 2026) (Date 20 6 2026) EQUALS JUST FALSE
#ASSERT `s 386ALA(2) the company or foreign company has entered the fact and the particulars in time` FALSE (Date 1 1 2000) (Date 1 6 2026) (Date 8 6 2026) EQUALS NOTHING
#ASSERT `s 386ALA(3) the company or foreign company has entered the cessation in time` TRUE (Date 8 6 2026) (Date 1 6 2026) (Date 20 6 2026) EQUALS JUST TRUE
#ASSERT `s 386ALA(3) the company or foreign company has entered the cessation in time` FALSE (Date 1 1 2000) (Date 1 6 2026) (Date 9 6 2026) EQUALS JUST FALSE
#ASSERT `s 386ALA(4) the company or foreign company has entered the change in time` TRUE (Date 9 6 2026) (Date 1 6 2026) (Date 20 6 2026) EQUALS JUST FALSE
#ASSERT `s 386ALA(4) the company or foreign company has entered the change in time` TRUE (Date 8 6 2026) (Date 1 6 2026) (Date 20 6 2026) EQUALS JUST TRUE
#ASSERT `s 386ALA(5) the company or foreign company is barred from disclosing the register of nominee shareholders to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386ALA(5) the company or foreign company is barred from disclosing the register of nominee shareholders to the person` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386ALA(5) the company or foreign company is barred from disclosing the register of nominee shareholders to the person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 386ALA(6) the company or foreign company is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 386ALA(6) the company or foreign company is guilty of the offence` FALSE EQUALS JUST FALSE
#ASSERT `s 386ALA(6) the officer of the company or foreign company is guilty of the offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386ALA(6) the officer of the company or foreign company is guilty of the offence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 386ALA(6) the most the company or foreign company or an officer in default may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (Penalty OF 25000, 0, FALSE, FALSE)
#ASSERT `s 386ALA(6) the most the company or foreign company or an officer in default may be sentenced to on conviction` FALSE TRUE FALSE EQUALS NOTHING

§ `s 386ALB(1): a company incorporated on or after 4 October 2022 but before the appointed day`

-- arguments: the date of incorporation; the appointed day; nominee on the date of incorporation; becomes a nominee after it; the date the shareholder becomes a nominee
-- 4 October 2022 plus 30 days: 27 days to 31 October, then 3 November 2022
#ASSERT `s 386ALB(1) the last day by which the shareholder must have informed the company` (Date 4 10 2022) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 3 11 2022)
#ASSERT `s 386ALB(1) the last day by which the shareholder must have informed the company` (Date 3 10 2022) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING
-- paragraph (b): becomes a nominee 1 February 2024 (2024 is a leap year): 2 March 2024
#ASSERT `s 386ALB(1) the last day by which the shareholder must have informed the company` (Date 1 1 2024) (Date 16 6 2025) FALSE TRUE (Date 1 2 2024) EQUALS JUST (Date 2 3 2024)
#ASSERT `s 386ALB(1) the last day by which the shareholder must have informed the company` (Date 1 1 2024) (Date 16 6 2025) FALSE FALSE (Date 1 1 2000) EQUALS NOTHING
#ASSERT `s 386ALB(1) the last day by which the shareholder must have informed the company` (Date 16 6 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING

§ `s 386ALB(1A), (2): after the appointed day, and before 4 October 2022`

#ASSERT `s 386ALB(1A) the last day by which the shareholder must have informed the company` (Date 16 6 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 16 6 2025)
#ASSERT `s 386ALB(1A) the last day by which the shareholder must have informed the company` (Date 15 6 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING
#ASSERT `s 386ALB(1A) the last day by which the shareholder must have informed the company` (Date 1 7 2025) (Date 16 6 2025) FALSE TRUE (Date 1 8 2025) EQUALS JUST (Date 31 8 2025)
-- arguments: the date of incorporation; becomes a nominee after 4 October 2022; the date the shareholder becomes a nominee
#ASSERT `s 386ALB(2) the last day by which the shareholder must have informed the company` (Date 1 1 2020) TRUE (Date 1 12 2022) EQUALS JUST (Date 31 12 2022)
#ASSERT `s 386ALB(2) the last day by which the shareholder must have informed the company` (Date 1 1 2020) TRUE (Date 4 10 2022) EQUALS NOTHING
#ASSERT `s 386ALB(2) the last day by which the shareholder must have informed the company` (Date 4 10 2022) TRUE (Date 1 12 2022) EQUALS NOTHING

§ `s 386ALB(3), (3A), (4): foreign companies`

#ASSERT `s 386ALB(3) the last day by which the shareholder must have informed the foreign company` (Date 4 10 2022) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 3 11 2022)
#ASSERT `s 386ALB(3) the last day by which the shareholder must have informed the foreign company` (Date 3 10 2022) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING
#ASSERT `s 386ALB(3) the last day by which the shareholder must have informed the foreign company` (Date 16 6 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING
