#ASSERT `s 386ALB(3A) the last day by which the shareholder must have informed the foreign company` (Date 15 6 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING
#ASSERT `s 386ALB(4) the last day by which the shareholder must have informed the foreign company` (Date 1 1 2020) TRUE (Date 1 12 2022) EQUALS JUST (Date 31 12 2022)
#ASSERT `s 386ALB(4) the last day by which the shareholder must have informed the foreign company` (Date 1 1 2020) TRUE (Date 4 10 2022) EQUALS NOTHING
#ASSERT `s 386ALB(4) the last day by which the shareholder must have informed the foreign company` (Date 4 10 2022) TRUE (Date 1 12 2022) EQUALS NOTHING

§ `s 386ALB(5): cessation and change`

#ASSERT `s 386ALB(5) the last day by which the shareholder must have informed the company or foreign company` (Date 1 6 2026) EQUALS JUST (Date 1 7 2026)

§ `s 386ALB(1), (1A), (2), (3), (3A) and (4) together`

-- arguments: the kind of body; the date of incorporation or registration; the appointed day; nominee on that date; becomes a nominee after that date; the date the shareholder becomes a nominee
#ASSERT `s 386ALB(1), (1A), (2), (3), (3A) and (4) the last day by which the shareholder must have informed the company or foreign company` `s 386ALB a company` (Date 1 1 2024) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 31 1 2024)
#ASSERT `s 386ALB(1), (1A), (2), (3), (3A) and (4) the last day by which the shareholder must have informed the company or foreign company` `s 386ALB a company` (Date 1 7 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 1 7 2025)
#ASSERT `s 386ALB(1), (1A), (2), (3), (3A) and (4) the last day by which the shareholder must have informed the company or foreign company` `s 386ALB a company` (Date 1 1 2020) (Date 16 6 2025) FALSE TRUE (Date 1 12 2022) EQUALS JUST (Date 31 12 2022)
#ASSERT `s 386ALB(1), (1A), (2), (3), (3A) and (4) the last day by which the shareholder must have informed the company or foreign company` `s 386ALB a company` (Date 1 1 2020) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING
#ASSERT `s 386ALB(1), (1A), (2), (3), (3A) and (4) the last day by which the shareholder must have informed the company or foreign company` `s 386ALB a foreign company registered under Division 2 of Part 11` (Date 1 1 2024) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 31 1 2024)
#ASSERT `s 386ALB(1), (1A), (2), (3), (3A) and (4) the last day by which the shareholder must have informed the company or foreign company` `s 386ALB a foreign company registered under Division 2 of Part 11` (Date 1 7 2025) (Date 16 6 2025) TRUE FALSE (Date 1 1 2000) EQUALS JUST (Date 1 7 2025)
#ASSERT `s 386ALB(1), (1A), (2), (3), (3A) and (4) the last day by which the shareholder must have informed the company or foreign company` `s 386ALB a foreign company registered under Division 2 of Part 11` (Date 1 1 2020) (Date 16 6 2025) FALSE TRUE (Date 1 12 2022) EQUALS JUST (Date 31 12 2022)

§ `s 386ALB(6), (7), (7A), (8)`

#ASSERT `s 386ALB(6) the shareholder is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 386ALB(6) the shareholder is guilty of the offence` FALSE EQUALS JUST FALSE
#ASSERT `s 386ALB(6) the most the shareholder may be sentenced to on conviction` TRUE EQUALS JUST (Penalty OF 25000, 0, FALSE, FALSE)
#ASSERT `s 386ALB(6) the most the shareholder may be sentenced to on conviction` FALSE EQUALS NOTHING
-- (7): arguments: votes as directed; receives dividends on behalf of another
#ASSERT `s 386ALB(7) the shareholder is a nominee` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386ALB(7) the shareholder is a nominee` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386ALB(7) the shareholder is a nominee` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386ALB(7) the shareholder is a nominee` FALSE FALSE EQUALS JUST FALSE
-- (7A): arguments: the body is older than the appointed day; not a nominee under the old wording; a nominee under the new wording; the appointed day
#ASSERT `s 386ALB(7A) the day on which the shareholder is treated as becoming a nominee` TRUE TRUE TRUE (Date 16 6 2025) EQUALS JUST (Date 16 6 2025)
#ASSERT `s 386ALB(7A) the day on which the shareholder is treated as becoming a nominee` FALSE TRUE TRUE (Date 16 6 2025) EQUALS NOTHING
#ASSERT `s 386ALB(7A) the day on which the shareholder is treated as becoming a nominee` TRUE FALSE TRUE (Date 16 6 2025) EQUALS NOTHING
#ASSERT `s 386ALB(7A) the day on which the shareholder is treated as becoming a nominee` TRUE TRUE FALSE (Date 16 6 2025) EQUALS NOTHING
-- (8)
#ASSERT `s 386ALB(8) "appointed day" the appointed day` (Date 16 6 2025) EQUALS (Date 16 6 2025)
#ASSERT `s 386ALB(8) "company" and "foreign company" the body is one within this section and section 386ALA` TRUE EQUALS JUST TRUE
#ASSERT `s 386ALB(8) "company" and "foreign company" the body is one within this section and section 386ALA` FALSE EQUALS JUST FALSE
#ASSERT `s 386ALB(8) "shareholder" the person is a shareholder` TRUE EQUALS JUST TRUE
#ASSERT `s 386ALB(8) "shareholder" the person is a shareholder` FALSE EQUALS JUST FALSE
