IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgl-voting`

-- Tests for sgl-voting.l4 (ss 178, 179, 180, 181). Expected values were decided from the text before the module was run.
-- A percentage is "not less than 5%" when 100 times the part is at least 5 times the whole, so exactly 5% counts.

§ `s 178(1): voidness of constitution provisions`

-- arguments: the provision excludes the right to demand a poll; the matter is the election of the chairperson or an adjournment
#ASSERT `s 178(1)(a) the constitution provision is void insofar as it excludes the right to demand a poll` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 178(1)(a) the constitution provision is void insofar as it excludes the right to demand a poll` TRUE TRUE EQUALS NOTHING
#ASSERT `s 178(1)(a) the constitution provision is void insofar as it excludes the right to demand a poll` FALSE FALSE EQUALS NOTHING
-- arguments: makes a demand ineffective; the matter is the chairperson or an adjournment; members demanding; voting rights of those demanding; total voting rights; sum paid up on their shares; total sum paid up
#ASSERT `s 178(1)(b) the constitution provision is void insofar as it makes the demand ineffective` TRUE FALSE 5 0 0 0 0 EQUALS JUST TRUE
#ASSERT `s 178(1)(b) the constitution provision is void insofar as it makes the demand ineffective` TRUE FALSE 4 0 0 0 0 EQUALS NOTHING
-- exactly 5% of the voting rights: 5 of 100
#ASSERT `s 178(1)(b) the constitution provision is void insofar as it makes the demand ineffective` TRUE FALSE 1 5 100 0 0 EQUALS JUST TRUE
#ASSERT `s 178(1)(b) the constitution provision is void insofar as it makes the demand ineffective` TRUE FALSE 1 4 100 0 0 EQUALS NOTHING
-- exactly 5% of the sum paid up: 5 of 100
#ASSERT `s 178(1)(b) the constitution provision is void insofar as it makes the demand ineffective` TRUE FALSE 1 0 0 5 100 EQUALS JUST TRUE
#ASSERT `s 178(1)(b) the constitution provision is void insofar as it makes the demand ineffective` TRUE FALSE 1 0 0 4 100 EQUALS NOTHING
-- a zero total: no percentage of it is counted
#ASSERT `s 178(1)(b) the constitution provision is void insofar as it makes the demand ineffective` TRUE FALSE 1 0 0 0 0 EQUALS NOTHING
-- the carved-out matter, and a provision that does not make a demand ineffective
#ASSERT `s 178(1)(b) the constitution provision is void insofar as it makes the demand ineffective` TRUE TRUE 5 0 0 0 0 EQUALS NOTHING
#ASSERT `s 178(1)(b) the constitution provision is void insofar as it makes the demand ineffective` FALSE FALSE 5 0 0 0 0 EQUALS NOTHING
-- the hours before the meeting by which the provision requires receipt
#ASSERT `s 178(1)(c) the constitution provision is void insofar as it requires receipt more than 72 hours before the meeting` 73 EQUALS JUST TRUE
#ASSERT `s 178(1)(c) the constitution provision is void insofar as it requires receipt more than 72 hours before the meeting` 72 EQUALS NOTHING
#ASSERT `s 178(1)(c) the constitution provision is void insofar as it requires receipt more than 72 hours before the meeting` 48 EQUALS NOTHING

§ `s 178(1A): a demand may be made despite (1)(b)`

-- arguments: date incorporated; the provision is void under (1)(b)(ii) or (iii); the matter is the chairperson or an adjournment; voting rights of those demanding; total voting rights; sum paid up on their shares; total sum paid up
-- incorporated on 2 January 2016 (before 3 January 2016): the gate is met
#ASSERT `s 178(1A) a demand for a poll may be made` (Date 2 1 2016) TRUE FALSE 5 100 0 0 EQUALS JUST TRUE
#ASSERT `s 178(1A) a demand for a poll may be made` (Date 2 1 2016) TRUE FALSE 4 100 0 0 EQUALS NOTHING
#ASSERT `s 178(1A) a demand for a poll may be made` (Date 2 1 2016) TRUE FALSE 0 0 5 100 EQUALS JUST TRUE
#ASSERT `s 178(1A) a demand for a poll may be made` (Date 2 1 2016) TRUE FALSE 0 0 4 100 EQUALS NOTHING
-- incorporated on 3 January 2016: not "before", so the gate fails (split site (ii), JUST FALSE)
#ASSERT `s 178(1A) a demand for a poll may be made` (Date 3 1 2016) TRUE FALSE 5 100 0 0 EQUALS JUST FALSE
-- the provision is not void under (1)(b)(ii) or (iii); the matter is the chairperson or an adjournment
#ASSERT `s 178(1A) a demand for a poll may be made` (Date 2 1 2016) FALSE FALSE 5 100 0 0 EQUALS JUST FALSE
#ASSERT `s 178(1A) a demand for a poll may be made` (Date 2 1 2016) TRUE TRUE 5 100 0 0 EQUALS JUST FALSE

§ `s 178(2) and (3): proxies and persons entitled to vote`

#ASSERT `s 178(2) the instrument appointing a proxy confers authority to demand or join in demanding a poll` TRUE EQUALS JUST TRUE
#ASSERT `s 178(2) the instrument appointing a proxy confers authority to demand or join in demanding a poll` FALSE EQUALS NOTHING
#ASSERT `s 178(2) the number of members whose demand is counted` 3 2 EQUALS 5
#ASSERT `s 178(2) the number of members whose demand is counted` 0 4 EQUALS 4
#ASSERT `s 178(3) the person is a person entitled to vote for the purposes of this Act` TRUE EQUALS JUST TRUE
#ASSERT `s 178(3) the person is a person entitled to vote for the purposes of this Act` FALSE EQUALS NOTHING

§ `s 179(1): quorum, chairperson and votes`

-- arguments: the constitution makes other provision; section 64 or 64A makes other provision; members personally present
#ASSERT `s 179(1)(a) the members personally present form a quorum` FALSE FALSE 2 EQUALS JUST TRUE
#ASSERT `s 179(1)(a) the members personally present form a quorum` FALSE FALSE 3 EQUALS JUST TRUE
#ASSERT `s 179(1)(a) the members personally present form a quorum` FALSE FALSE 1 EQUALS JUST FALSE
#ASSERT `s 179(1)(a) the members personally present form a quorum` FALSE FALSE 0 EQUALS JUST FALSE
#ASSERT `s 179(1)(a) the members personally present form a quorum` TRUE FALSE 5 EQUALS NOTHING
#ASSERT `s 179(1)(a) the members personally present form a quorum` FALSE TRUE 5 EQUALS NOTHING
-- arguments: members physically present; members by virtual meeting technology; section 173J(4)(b) applies; corporations deemed present
#ASSERT `s 179(1)(a) the number of members of the company personally present, counting those section 173J(4)(b) and section 179(4) add` 1 1 TRUE 1 EQUALS 3
#ASSERT `s 179(1)(a) the number of members of the company personally present, counting those section 173J(4)(b) and section 179(4) add` 1 1 FALSE 1 EQUALS 2
#ASSERT `s 179(1)(a) the number of members of the company personally present, counting those section 173J(4)(b) and section 179(4) add` 0 3 TRUE 0 EQUALS 3
#ASSERT `s 179(1)(a) the number of members of the company personally present, counting those section 173J(4)(b) and section 179(4) add` 0 3 FALSE 0 EQUALS 0
-- arguments: the constitution makes other provision; section 64 or 64A makes other provision; the member has been elected
#ASSERT `s 179(1)(b) the member may be chairperson of the meeting` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 179(1)(b) the member may be chairperson of the meeting` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 179(1)(b) the member may be chairperson of the meeting` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 179(1)(b) the member may be chairperson of the meeting` FALSE TRUE TRUE EQUALS NOTHING
-- arguments: the constitution makes other provision; section 64 or 64A makes other provision; the company has a share capital; the member is personally present; the member is entitled to vote
#ASSERT `s 179(1)(c)(i) the number of votes the member has on a show of hands` FALSE FALSE TRUE TRUE TRUE EQUALS JUST 1
#ASSERT `s 179(1)(c)(i) the number of votes the member has on a show of hands` FALSE FALSE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 179(1)(c)(i) the number of votes the member has on a show of hands` FALSE FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 179(1)(c)(i) the number of votes the member has on a show of hands` FALSE FALSE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 179(1)(c)(i) the number of votes the member has on a show of hands` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING
-- arguments: the constitution makes other provision; section 64 or 64A makes other provision; the company has a share capital; shares held; units of stock equivalent to one share
#ASSERT `s 179(1)(c)(ii) the number of votes the member has on a poll` FALSE FALSE TRUE 10 0 EQUALS JUST 10
#ASSERT `s 179(1)(c)(ii) the number of votes the member has on a poll` FALSE FALSE TRUE 10 5 EQUALS JUST 15
#ASSERT `s 179(1)(c)(ii) the number of votes the member has on a poll` FALSE FALSE TRUE 0 0 EQUALS JUST 0
#ASSERT `s 179(1)(c)(ii) the number of votes the member has on a poll` FALSE FALSE FALSE 10 0 EQUALS NOTHING
#ASSERT `s 179(1)(c)(ii) the number of votes the member has on a poll` TRUE FALSE TRUE 10 0 EQUALS NOTHING
-- arguments: the constitution makes other provision; section 64 or 64A makes other provision; the company has a share capital
#ASSERT `s 179(1)(d) the number of votes every member has` FALSE FALSE FALSE EQUALS JUST 1
#ASSERT `s 179(1)(d) the number of votes every member has` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 179(1)(d) the number of votes every member has` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 179(1)(d) the number of votes every member has` FALSE TRUE FALSE EQUALS NOTHING

§ `s 179(2), (3), (4), (5): votes and corporate representatives`

-- arguments: the vote is on a poll; the votes the person is entitled to
#ASSERT `s 179(2) the person need not use all the person's votes or cast all the votes the person uses in the same way` TRUE 5 EQUALS JUST TRUE
#ASSERT `s 179(2) the person need not use all the person's votes or cast all the votes the person uses in the same way` TRUE 2 EQUALS JUST TRUE
#ASSERT `s 179(2) the person need not use all the person's votes or cast all the votes the person uses in the same way` TRUE 1 EQUALS NOTHING
#ASSERT `s 179(2) the person need not use all the person's votes or cast all the votes the person uses in the same way` FALSE 5 EQUALS JUST FALSE
-- arguments: the corporation is a member; the corporation is a creditor; the corporation has authorised the person by resolution
#ASSERT `s 179(3) the corporation may authorise the person to act as its representative` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 179(3) the corporation may authorise the person to act as its representative` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 179(3) the corporation may authorise the person to act as its representative` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 179(3) the corporation may authorise the person to act as its representative` TRUE FALSE FALSE EQUALS NOTHING
-- arguments: the person has been authorised; the person acts in accordance with the authority; the corporation has revoked the authority
#ASSERT `s 179(3) the person so authorised is entitled to exercise the corporation's powers` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 179(3) the person so authorised is entitled to exercise the corporation's powers` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 179(3) the person so authorised is entitled to exercise the corporation's powers` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 179(3) the person so authorised is entitled to exercise the corporation's powers` FALSE TRUE FALSE EQUALS NOTHING
-- arguments: the person is authorised under (3); the person is not otherwise entitled to be present
#ASSERT `s 179(4) the corporation is deemed to be personally present at the meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 179(4) the corporation is deemed to be personally present at the meeting` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 179(4) the corporation is deemed to be personally present at the meeting` FALSE TRUE EQUALS JUST FALSE
-- arguments: section 41(8) or (9) applies; the certificate is under the seal; the certificate is of the appointment or its revocation
#ASSERT `s 179(5) the certificate is prima facie evidence of the appointment or of the revocation of the appointment` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 179(5) the certificate is prima facie evidence of the appointment or of the revocation of the appointment` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 179(5) the certificate is prima facie evidence of the appointment or of the revocation of the appointment` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 179(5) the certificate is prima facie evidence of the appointment or of the revocation of the appointment` FALSE TRUE FALSE EQUALS NOTHING

§ `s 179(6), (7), (8): the holding company's minute`

-- arguments: the holding company holds the whole of the issued shares; the minute is signed by the authorised representative; the minute states the act has been done
#ASSERT `s 179(6) the act, matter, thing or resolution is deemed to have been duly made, performed or passed` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 179(6) the act, matter, thing or resolution is deemed to have been duly made, performed or passed` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 179(6) the act, matter, thing or resolution is deemed to have been duly made, performed or passed` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 179(6) the act, matter, thing or resolution is deemed to have been duly made, performed or passed` TRUE TRUE FALSE EQUALS JUST FALSE
-- arguments: a document is required to be lodged with the Registrar; a (6) minute is signed and relates to it; the day the minute was signed; the day a copy was lodged
-- signed on 1 March 2026: 14 days after is 15 March 2026
#ASSERT `s 179(7) the number of days from the signing to the last day for lodging` (Date 1 3 2026) EQUALS 14
#ASSERT `s 179(7) the company has lodged a copy of the minute with the Registrar in time` TRUE TRUE (Date 1 3 2026) (Date 15 3 2026) EQUALS JUST TRUE
#ASSERT `s 179(7) the company has lodged a copy of the minute with the Registrar in time` TRUE TRUE (Date 1 3 2026) (Date 16 3 2026) EQUALS JUST FALSE
#ASSERT `s 179(7) the company has lodged a copy of the minute with the Registrar in time` TRUE TRUE (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 179(7) the company has lodged a copy of the minute with the Registrar in time` FALSE TRUE (Date 1 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
#ASSERT `s 179(7) the company has lodged a copy of the minute with the Registrar in time` TRUE FALSE (Date 1 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
-- time 0 is the day the minute is signed; the last day, 15 March, is day 14
-- EXPECT FULFILLED
#TRACE `s 179(7) the company must lodge a copy of the minute with the Registrar` "Gamma Pte Ltd" AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 179(7) lodge a copy of the minute with the Registrar` AT 14
-- EXPECT BREACH
#TRACE `s 179(7) the company must lodge a copy of the minute with the Registrar` "Gamma Pte Ltd" AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 179(7) lodge a copy of the minute with the Registrar` AT 15
-- EXPECT BREACH
#TRACE `s 179(7) the company must lodge a copy of the minute with the Registrar` "Gamma Pte Ltd" AT 0 WITH
    WAITUNTIL 15
#ASSERT `s 179(8) the company is a member for the purposes of this section` TRUE EQUALS JUST FALSE
#ASSERT `s 179(8) the company is a member for the purposes of this section` FALSE EQUALS NOTHING

§ `s 180: a member's rights at meetings`

#ASSERT `s 180(1) the member has the right to attend any general meeting and to speak on any resolution before the meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 180(1) the member has the right to attend any general meeting and to speak on any resolution before the meeting` FALSE EQUALS NOTHING
-- arguments: the kind of company; the share confers a right to vote under section 64
#ASSERT `s 180(2) the holder of the share may vote on the resolution` `limited by shares` TRUE EQUALS JUST TRUE
#ASSERT `s 180(2) the holder of the share may vote on the resolution` `limited by shares` FALSE EQUALS NOTHING
#ASSERT `s 180(2) the holder of the share may vote on the resolution` `limited by guarantee` TRUE EQUALS NOTHING
#ASSERT `s 180(2) the holder of the share may vote on the resolution` `limited by shares and by guarantee` TRUE EQUALS NOTHING
#ASSERT `s 180(2) the holder of the share may vote on the resolution` `unlimited` TRUE EQUALS NOTHING
-- arguments: the kind of company; the right to vote is conferred under the constitution
#ASSERT `s 180(3) the member may vote on the resolution` `limited by guarantee` TRUE EQUALS JUST TRUE
#ASSERT `s 180(3) the member may vote on the resolution` `unlimited` TRUE EQUALS JUST TRUE
#ASSERT `s 180(3) the member may vote on the resolution` `limited by guarantee` FALSE EQUALS NOTHING
#ASSERT `s 180(3) the member may vote on the resolution` `limited by shares` TRUE EQUALS NOTHING

§ `s 180(4) and (5): the preference share`

-- the latest day the period may start: 12 months after the due date of 31 December 2020 is 31 December 2021; a lesser period of 6 months gives 30 June 2021
#ASSERT `s 180(4) the latest day on which the period may start` (Date 31 12 2020) NOTHING EQUALS Date 31 12 2021
#ASSERT `s 180(4) the latest day on which the period may start` (Date 31 12 2020) (JUST 6) EQUALS Date 30 6 2021
-- arguments: the day the share was issued; it is a preference share; the dividend is in arrears; the due date; the lesser period in months; the day the constitution starts the period; the date asked
-- issued 16 August 1984 (after 15 August 1984), constitution silent: the period starts at the latest on 31 December 2021
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 16 8 1984) TRUE TRUE (Date 31 12 2020) NOTHING NOTHING (Date 31 12 2021) EQUALS JUST TRUE
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 16 8 1984) TRUE TRUE (Date 31 12 2020) NOTHING NOTHING (Date 1 1 2022) EQUALS JUST TRUE
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 16 8 1984) TRUE TRUE (Date 31 12 2020) NOTHING NOTHING (Date 30 12 2021) EQUALS NOTHING
-- the constitution starts the period at 1 July 2021, earlier than the latest day
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 16 8 1984) TRUE TRUE (Date 31 12 2020) NOTHING (JUST (Date 1 7 2021)) (Date 1 7 2021) EQUALS JUST TRUE
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 16 8 1984) TRUE TRUE (Date 31 12 2020) NOTHING (JUST (Date 1 7 2021)) (Date 30 6 2021) EQUALS JUST FALSE
-- the constitution names a day after the latest day: the text's cap of 31 December 2021 governs
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 16 8 1984) TRUE TRUE (Date 31 12 2020) NOTHING (JUST (Date 1 6 2022)) (Date 31 12 2021) EQUALS JUST TRUE
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 16 8 1984) TRUE TRUE (Date 31 12 2020) NOTHING (JUST (Date 1 6 2022)) (Date 30 12 2021) EQUALS JUST FALSE
-- a lesser period of 6 months in the constitution: the latest day is 30 June 2021
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 16 8 1984) TRUE TRUE (Date 31 12 2020) (JUST 6) NOTHING (Date 30 6 2021) EQUALS JUST TRUE
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 16 8 1984) TRUE TRUE (Date 31 12 2020) (JUST 6) NOTHING (Date 29 6 2021) EQUALS NOTHING
-- no arrears: the right is not carried
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 16 8 1984) TRUE FALSE (Date 31 12 2020) NOTHING NOTHING (Date 31 12 2021) EQUALS JUST FALSE
-- the issue day: 15 August 1984 is not "after"; 2 January 2016 is "before 3 January 2016"; 3 January 2016 is not
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 15 8 1984) TRUE TRUE (Date 31 12 2020) NOTHING NOTHING (Date 31 12 2021) EQUALS NOTHING
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 2 1 2016) TRUE TRUE (Date 31 12 2020) NOTHING NOTHING (Date 31 12 2021) EQUALS JUST TRUE
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 3 1 2016) TRUE TRUE (Date 31 12 2020) NOTHING NOTHING (Date 31 12 2021) EQUALS NOTHING
-- not a preference share
#ASSERT `s 180(4) the preference share carries the right to at least one vote on a poll in respect of the share` (Date 16 8 1984) FALSE TRUE (Date 31 12 2020) NOTHING NOTHING (Date 31 12 2021) EQUALS NOTHING
-- arguments: the share does not entitle the holder to vote (except under (4)); the share does not entitle the holder to participate beyond a specified amount
#ASSERT `s 180(5)(a) the share is a preference share` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 180(5)(a) the share is a preference share` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 180(5)(a) the share is a preference share` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 180(5)(a) the share is a preference share` FALSE FALSE EQUALS JUST FALSE
-- arguments: the day appointed in the constitution; the last day of the year or period
#ASSERT `s 180(5)(b) the date on which the dividend is deemed to be due` (JUST (Date 15 3 2026)) (Date 31 12 2025) EQUALS Date 15 3 2026
#ASSERT `s 180(5)(b) the date on which the dividend is deemed to be due` NOTHING (Date 31 12 2025) EQUALS Date 1 1 2026
#ASSERT `s 180(5)(b) the date on which the dividend is deemed to be due` NOTHING (Date 28 2 2026) EQUALS Date 1 3 2026

§ `s 181(1) and (1A): who may appoint proxies`

-- arguments: the person is a member; the member is entitled to attend and vote
#ASSERT `s 181(1) the member is entitled to appoint another person as the member's proxy` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 181(1) the member is entitled to appoint another person as the member's proxy` FALSE TRUE EQUALS NOTHING
#ASSERT `s 181(1) the member is entitled to appoint another person as the member's proxy` TRUE FALSE EQUALS NOTHING
#ASSERT `s 181(1) the proxy has the same right as the member to speak at the meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 181(1) the proxy has the same right as the member to speak at the meeting` FALSE EQUALS NOTHING
-- arguments: the constitution otherwise provides; the proxy was appointed under (1C); the question is decided on a poll
#ASSERT `s 181(1A)(a) the proxy is barred from voting on the question` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 181(1A)(a) the proxy is barred from voting on the question` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 181(1A)(a) the proxy is barred from voting on the question` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 181(1A)(a) the proxy is barred from voting on the question` FALSE TRUE FALSE EQUALS NOTHING
-- arguments: the constitution otherwise provides; (1C) applies to the member; the number of proxies the member proposes to appoint
#ASSERT `s 181(1A)(b) the member is entitled to appoint that number of proxies` FALSE FALSE 1 EQUALS JUST TRUE
#ASSERT `s 181(1A)(b) the member is entitled to appoint that number of proxies` FALSE FALSE 2 EQUALS JUST TRUE
#ASSERT `s 181(1A)(b) the member is entitled to appoint that number of proxies` FALSE FALSE 3 EQUALS JUST FALSE
#ASSERT `s 181(1A)(b) the member is entitled to appoint that number of proxies` FALSE FALSE 0 EQUALS NOTHING
#ASSERT `s 181(1A)(b) the member is entitled to appoint that number of proxies` TRUE FALSE 3 EQUALS NOTHING
#ASSERT `s 181(1A)(b) the member is entitled to appoint that number of proxies` FALSE TRUE 3 EQUALS NOTHING
-- arguments: the constitution otherwise provides; the member appoints 2 proxies; the member specifies the proportions
#ASSERT `s 181(1A)(c) the appointments of the 2 proxies are valid` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 181(1A)(c) the appointments of the 2 proxies are valid` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 181(1A)(c) the appointments of the 2 proxies are valid` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 181(1A)(c) the appointments of the 2 proxies are valid` TRUE TRUE FALSE EQUALS NOTHING

§ `s 181(1B) to (1D): electronic appointment and relevant intermediaries`

-- arguments: the person is a member; the instrument is deposited by electronic means
#ASSERT `s 181(1B) the member may appoint a proxy by depositing an instrument of appointment by electronic means` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 181(1B) the member may appoint a proxy by depositing an instrument of appointment by electronic means` FALSE TRUE EQUALS NOTHING
#ASSERT `s 181(1B) the member may appoint a proxy by depositing an instrument of appointment by electronic means` TRUE FALSE EQUALS NOTHING
#ASSERT `s 181(1BA) the company has specified the electronic means in the notice of meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 181(1BA) the company has specified the electronic means in the notice of meeting` FALSE EQUALS JUST FALSE
-- arguments: the company has a share capital; the member is a relevant intermediary; each proxy is appointed for different shares; the number and class are specified
#ASSERT `s 181(1C) the member may appoint more than 2 proxies` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 181(1C) the member may appoint more than 2 proxies` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 181(1C) the member may appoint more than 2 proxies` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 181(1C) the member may appoint more than 2 proxies` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 181(1C) the member may appoint more than 2 proxies` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 181(1D) the proxy has the right to vote on a show of hands` TRUE EQUALS JUST TRUE
#ASSERT `s 181(1D) the proxy has the right to vote on a show of hands` FALSE EQUALS NOTHING

§ `s 181(2) to (5): the notice, the offences and the defence`

-- arguments: a statement appears in the notice; it appears with reasonable prominence; the notice states that a proxy need not be a member
#ASSERT `s 181(2) the notice contains the statement the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 181(2) the notice contains the statement the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 181(2) the notice contains the statement the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 181(2) the notice contains the statement the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
-- arguments: default is made in complying with the subsection; the person is an officer in default
#ASSERT `s 181(2) the officer is guilty of the offence this subsection creates` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 181(2) the officer is guilty of the offence this subsection creates` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 181(2) the officer is guilty of the offence this subsection creates` FALSE TRUE EQUALS JUST FALSE
-- the subsection states no penalty
#ASSERT `s 181(2) the most the officer may be sentenced to on conviction` TRUE TRUE EQUALS NOTHING
-- arguments: the person authorises or permits the invitation; it is at the company's expense; it goes to some only of the members; subsection (4) gives a defence
#ASSERT `s 181(3) the person is guilty of the offence this subsection creates` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 181(3) the person is guilty of the offence this subsection creates` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 181(3) the person is guilty of the offence this subsection creates` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 181(3) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 181(3) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 181(3) the most the person may be sentenced to on conviction` TRUE TRUE TRUE FALSE EQUALS JUST (Penalty OF 2000, 0, FALSE, FALSE)
#ASSERT `s 181(3) the most the person may be sentenced to on conviction` TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 181(3) the most the person may be sentenced to on conviction` TRUE FALSE TRUE FALSE EQUALS NOTHING
-- arguments: the invitation is the issue to a member at the member's request of a form or list; the form or list is available on request to every member entitled to vote by proxy
#ASSERT `s 181(4) this subsection gives the person a defence to guilt under subsection (3)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 181(4) this subsection gives the person a defence to guilt under subsection (3)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 181(4) this subsection gives the person a defence to guilt under subsection (3)` FALSE TRUE EQUALS JUST FALSE
-- arguments: the person authorises or permits the invitation; it is accompanied by a form of proxy that allows a direction for or against
#ASSERT `s 181(5) the person is guilty of the offence this subsection creates` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 181(5) the person is guilty of the offence this subsection creates` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 181(5) the person is guilty of the offence this subsection creates` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 181(5) the most the person may be sentenced to on conviction` TRUE FALSE EQUALS NOTHING

§ `s 181(6): relevant intermediary`

-- arguments: a bank or merchant bank licensed under the Banking Act 1970; a wholly owned subsidiary of one; its business includes nominee services; it holds shares in that capacity
#ASSERT `s 181(6)(a) the member is a relevant intermediary because of its banking business` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 181(6)(a) the member is a relevant intermediary because of its banking business` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 181(6)(a) the member is a relevant intermediary because of its banking business` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 181(6)(a) the member is a relevant intermediary because of its banking business` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 181(6)(a) the member is a relevant intermediary because of its banking business` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- arguments: it holds a capital markets services licence for custodial services; it holds shares in that capacity
#ASSERT `s 181(6)(b) the member is a relevant intermediary because of its custodial licence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 181(6)(b) the member is a relevant intermediary because of its custodial licence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 181(6)(b) the member is a relevant intermediary because of its custodial licence` FALSE TRUE EQUALS JUST FALSE
-- arguments: it is the Central Provident Fund Board; the shares were bought under the subsidiary legislation; it holds them as an intermediary
#ASSERT `s 181(6)(c) the member is a relevant intermediary because it is the Central Provident Fund Board` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 181(6)(c) the member is a relevant intermediary because it is the Central Provident Fund Board` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 181(6)(c) the member is a relevant intermediary because it is the Central Provident Fund Board` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 181(6)(c) the member is a relevant intermediary because it is the Central Provident Fund Board` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 181(6) the member is a relevant intermediary` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 181(6) the member is a relevant intermediary` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 181(6) the member is a relevant intermediary` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 181(6) the member is a relevant intermediary` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
