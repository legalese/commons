IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgo-penalties`
IMPORT `sgo-records`

-- Tests for sgo-records.l4 (ss 393, 395, 396, 396A, 396B, 397, 398).
-- Every expected value is written from the text of the section, beside the assertion, before the code was run.

§ `Section 393`

-- an inspector, a privileged communication: barred.
#ASSERT `s 393 the inspector is barred from requiring disclosure by the solicitor` TRUE TRUE FALSE EQUALS JUST TRUE
-- the name and address of the client: "except as respects".
#ASSERT `s 393 the inspector is barred from requiring disclosure by the solicitor` TRUE TRUE TRUE EQUALS JUST FALSE
-- not privileged: the section does not speak.
#ASSERT `s 393 the inspector is barred from requiring disclosure by the solicitor` TRUE FALSE FALSE EQUALS NOTHING
-- not an inspector appointed under the Act.
#ASSERT `s 393 the inspector is barred from requiring disclosure by the solicitor` FALSE TRUE FALSE EQUALS NOTHING

§ `Section 395(4): the words`

#ASSERT `s 395(4) "company" the corporation is within the word company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 395(4) "company" the corporation is within the word company` TRUE FALSE EQUALS NOTHING
#ASSERT `s 395(4) "company" the corporation is within the word company` FALSE TRUE EQUALS NOTHING
#ASSERT `s 395(4) "company record" the thing is a company record` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 395(4) "company record" the thing is a company record` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 395(4) "company record" the thing is a company record` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 395(4) "company record" the thing is a company record` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 395(4) "in electronic form" the record is in electronic form` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 395(4) "in electronic form" the record is in electronic form` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 395(4) "in electronic form" the record is in electronic form` FALSE TRUE EQUALS NOTHING
#ASSERT `s 395(4) "in hard copy form" the record is in hard copy form` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 395(4) "in hard copy form" the record is in hard copy form` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 395(4) "in hard copy form" the record is in hard copy form` FALSE TRUE EQUALS NOTHING

§ `Section 395(1) to (3)`

#ASSERT `s 395(1) the company has adequately recorded for future reference the information required to be contained in its company records` TRUE EQUALS JUST TRUE
#ASSERT `s 395(1) the company has adequately recorded for future reference the information required to be contained in its company records` FALSE EQUALS JUST FALSE
-- (2)(a): the form, subject to (1).
#ASSERT `s 395(2)(a) the company records may be kept in that form` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 395(2)(a) the company records may be kept in that form` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 395(2)(a) the company records may be kept in that form` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 395(2)(a) the company records may be kept in that form` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 395(2)(b) the company records may be arranged in that manner` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 395(2)(b) the company records may be arranged in that manner` TRUE FALSE EQUALS NOTHING
#ASSERT `s 395(2)(b) the company records may be arranged in that manner` FALSE TRUE EQUALS NOTHING
-- (3): electronic records must be capable of reproduction in hard copy.
#ASSERT `s 395(3) the company has ensured that its company records are capable of being reproduced in hard copy form` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 395(3) the company has ensured that its company records are capable of being reproduced in hard copy form` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 395(3) the company has ensured that its company records are capable of being reproduced in hard copy form` FALSE FALSE EQUALS NOTHING
-- The duties of s 395(1) and (3) have no time limit and no stated consequence: a late act still reads FULFILLED.
-- EXPECT FULFILLED
#TRACE `s 395(1) a company must adequately record the information required to be contained in its company records` "Acme" AT 0 WITH
    PARTY Company "Acme" DOES `s 395(1) adequately record for future reference the information required to be contained in the company records` AT 900
-- EXPECT RESIDUAL
#TRACE `s 395(1) a company must adequately record the information required to be contained in its company records` "Acme" AT 0 WITH
    WAITUNTIL 900
-- EXPECT FULFILLED
#TRACE `s 395(3) a company that keeps records in electronic form must ensure they can be reproduced in hard copy form` "Acme" AT 0 WITH
    PARTY Company "Acme" DOES `s 395(3) ensure that the company records kept in electronic form are capable of being reproduced in hard copy form` AT 900

§ `Section 396`

#ASSERT `s 396(1) the reasonable precautions that the subsection requires have been taken` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 396(1) the reasonable precautions that the subsection requires have been taken` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 396(1) the reasonable precautions that the subsection requires have been taken` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 396(1) the reasonable precautions that the subsection requires have been taken` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- hard copy records: the subsection does not reach them.
#ASSERT `s 396(1) the reasonable precautions that the subsection requires have been taken` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 396(2) the company has provided for the manner by which the electronic records are to be authenticated and verified` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 396(2) the company has provided for the manner by which the electronic records are to be authenticated and verified` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 396(2) the company has provided for the manner by which the electronic records are to be authenticated and verified` FALSE FALSE EQUALS NOTHING
-- the offence of (3).
#ASSERT `s 396(3) the company is guilty of an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 396(3) the company is guilty of an offence` FALSE EQUALS NOTHING
#ASSERT `s 396(3) the officer of the company is guilty of an offence` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 396(3) the officer of the company is guilty of an offence` TRUE FALSE TRUE EQUALS JUST TRUE
-- an officer who neither commits the offence knowingly and wilfully nor authorises or permits it is not "in default".
#ASSERT `s 396(3) the officer of the company is guilty of an offence` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 396(3) the officer of the company is guilty of an offence` FALSE TRUE FALSE EQUALS NOTHING
-- a fine not exceeding $1,000 and also a default penalty.
#ASSERT `s 396(3) the highest penalty on conviction` TRUE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
#ASSERT `s 396(3) the highest penalty on conviction` FALSE EQUALS NOTHING
-- EXPECT BREACH
#TRACE `s 396(3) a company must not make default in taking the precautions` "Acme" AT 0 WITH
    PARTY Company "Acme" DOES `s 396(3) make default in complying with section 396(1) or (2)` AT 1
-- EXPECT RESIDUAL
#TRACE `s 396(3) a company must not make default in taking the precautions` "Acme" AT 0 WITH
    WAITUNTIL 3
-- The duty of (2) has no time limit and no stated consequence in the subsection itself.
-- EXPECT FULFILLED
#TRACE `s 396(2) a company that keeps records in electronic form must provide for how they are authenticated and verified` "Acme" AT 0 WITH
    PARTY Company "Acme" DOES `s 396(2) provide for the manner by which the electronic records are to be authenticated and verified` AT 900

§ `Section 396A`

#ASSERT `s 396A(1) the company must make the company record available for inspection at that place and time` TRUE TRUE TRUE EQUALS JUST TRUE
-- outside the hours the registered office is accessible to the public.
#ASSERT `s 396A(1) the company must make the company record available for inspection at that place and time` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 396A(1) the company must make the company record available for inspection at that place and time` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 396A(1) the company must make the company record available for inspection at that place and time` FALSE TRUE TRUE EQUALS NOTHING
-- (2): electronic records: a hard copy reproduction, and the recording itself if the inspector asks.
#ASSERT `s 396A(2) the duty to allow inspection is a duty to allow inspection in that form` TRUE FALSE `s 396A(2)(a) a reproduction of the recording, or the relevant part of the recording, in hard copy form` EQUALS JUST TRUE
#ASSERT `s 396A(2) the duty to allow inspection is a duty to allow inspection in that form` TRUE FALSE `s 396A(2)(b) the recording, or the relevant part of the recording, by electronic means` EQUALS NOTHING
#ASSERT `s 396A(2) the duty to allow inspection is a duty to allow inspection in that form` TRUE TRUE `s 396A(2)(b) the recording, or the relevant part of the recording, by electronic means` EQUALS JUST TRUE
#ASSERT `s 396A(2) the duty to allow inspection is a duty to allow inspection in that form` FALSE TRUE `s 396A(2)(a) a reproduction of the recording, or the relevant part of the recording, in hard copy form` EQUALS NOTHING
#ASSERT `s 396A(3) the person may make copies of or take extracts from the company records` TRUE EQUALS JUST TRUE
#ASSERT `s 396A(3) the person may make copies of or take extracts from the company records` FALSE EQUALS NOTHING
-- (4)
#ASSERT `s 396A(4) the company has ensured that proper facilities are provided to enable the company records to be inspected` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 396A(4) the company has ensured that proper facilities are provided to enable the company records to be inspected` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 396A(4) the company has ensured that proper facilities are provided to enable the company records to be inspected` FALSE FALSE EQUALS NOTHING
#ASSERT `s 396A(4) the company is guilty of an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 396A(4) the company is guilty of an offence` FALSE EQUALS NOTHING
#ASSERT `s 396A(4) the officer of the company is guilty of an offence` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 396A(4) the officer of the company is guilty of an offence` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 396A(4) the officer of the company is guilty of an offence` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 396A(4) the officer of the company is guilty of an offence` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 396A(4) the highest penalty on conviction` TRUE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
#ASSERT `s 396A(4) the highest penalty on conviction` FALSE EQUALS NOTHING
-- EXPECT BREACH
#TRACE `s 396A(4) a company must not make default in providing proper facilities for inspection` "Acme" AT 0 WITH
    PARTY Company "Acme" DOES `s 396A(4) make default in providing proper facilities for the inspection of company records kept in electronic form` AT 1
-- The duty of (1) has no time limit and no stated consequence.
-- EXPECT FULFILLED
#TRACE `s 396A(1) a company must make a company record required to be available for inspection available at the place and hours` "Acme" AT 0 WITH
    PARTY Company "Acme" DOES `s 396A(1) make the company record available for inspection at the place where it is kept during the hours in which the registered office is accessible to the public` AT 900

§ `Section 396B`

-- investigation commenced on 10 March 2025: the 2 years before it end on 9 March 2025 and begin on 10 March 2023.
#ASSERT `s 396B(1) the first day of the period throughout which proper books of account must have been kept` (Date 1 1 2000) (Date 10 3 2025) EQUALS Date 10 3 2023
-- the company was incorporated on 1 June 2024: the shorter period, from incorporation.
#ASSERT `s 396B(1) the first day of the period throughout which proper books of account must have been kept` (Date 1 6 2024) (Date 10 3 2025) EQUALS Date 1 6 2024
-- incorporated on 10 March 2023: the two periods are the same.
#ASSERT `s 396B(1) the first day of the period throughout which proper books of account must have been kept` (Date 10 3 2023) (Date 10 3 2025) EQUALS Date 10 3 2023
-- incorporated the day before the 2 years began, and the day after.
#ASSERT `s 396B(1) the first day of the period throughout which proper books of account must have been kept` (Date 9 3 2023) (Date 10 3 2025) EQUALS Date 10 3 2023
#ASSERT `s 396B(1) the first day of the period throughout which proper books of account must have been kept` (Date 11 3 2023) (Date 10 3 2025) EQUALS Date 11 3 2023
-- a leap year: investigation on 1 March 2024, the 2 years before it end on 29 February 2024 and begin on 1 March 2022.
#ASSERT `s 396B(1) the first day of the period throughout which proper books of account must have been kept` (Date 1 1 2000) (Date 1 3 2024) EQUALS Date 1 3 2022
-- the offence: an officer in default.
#ASSERT `s 396B(1) the officer is guilty of an offence` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 396B(1) the officer is guilty of an offence` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 396B(1) the officer is guilty of an offence` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 396B(1) the officer is guilty of an offence` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 396B(1) the officer is guilty of an offence` TRUE FALSE TRUE FALSE EQUALS NOTHING
-- a fine not exceeding $5,000 or imprisonment for a term not exceeding 12 months, not both.
#ASSERT `s 396B(1) the highest penalty on conviction` TRUE EQUALS JUST (Penalty OF 5000, 12, FALSE, FALSE)
#ASSERT `s 396B(1) the highest penalty on conviction` FALSE EQUALS NOTHING
-- (2): honestly, and the default excusable.
#ASSERT `s 396B(2) this section gives a defence on these facts` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 396B(2) this section gives a defence on these facts` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 396B(2) this section gives a defence on these facts` FALSE TRUE EQUALS JUST FALSE
-- (3): the books deemed not kept.
#ASSERT `s 396B(3) proper books of account are deemed not to have been kept` TRUE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 396B(3) proper books of account are deemed not to have been kept` FALSE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 396B(3) proper books of account are deemed not to have been kept` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- dealings in goods but no statements of the annual stocktakings.
#ASSERT `s 396B(3) proper books of account are deemed not to have been kept` TRUE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- stocktakings kept, not retail, but no statement of goods sold and purchased.
#ASSERT `s 396B(3) proper books of account are deemed not to have been kept` TRUE TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
-- goods sold by way of ordinary retail trade: the statement of goods sold and purchased is not needed.
#ASSERT `s 396B(3) proper books of account are deemed not to have been kept` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 396B(3) proper books of account are deemed not to have been kept` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING
-- (b): not kept in a manner that enables them to be conveniently and properly audited.
#ASSERT `s 396B(3) proper books of account are deemed not to have been kept` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE

§ `Section 397`

#ASSERT `s 397(1) the corporation has lodged the certified translation that the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 397(1) the corporation has lodged the certified translation that the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 397(1) the corporation has lodged the certified translation that the subsection requires` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 397(1) the corporation has lodged the certified translation that the subsection requires` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 397(2) the corporation has kept the certified translation that the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 397(2) the corporation has kept the certified translation that the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 397(2) the corporation has kept the certified translation that the subsection requires` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 397(2) the corporation has kept the certified translation that the subsection requires` TRUE FALSE FALSE EQUALS NOTHING
-- (3): the last true translation on 1 March 2025: the next by 8 March 2025 at the latest.
#ASSERT `s 397(3) the directors have caused the true translations to be made and kept as the subsection requires` TRUE (Date 1 3 2025) (Date 8 3 2025) TRUE EQUALS JUST TRUE
#ASSERT `s 397(3) the directors have caused the true translations to be made and kept as the subsection requires` TRUE (Date 1 3 2025) (Date 2 3 2025) TRUE EQUALS JUST TRUE
#ASSERT `s 397(3) the directors have caused the true translations to be made and kept as the subsection requires` TRUE (Date 1 3 2025) (Date 9 3 2025) TRUE EQUALS JUST FALSE
-- translations not kept with the originals.
#ASSERT `s 397(3) the directors have caused the true translations to be made and kept as the subsection requires` TRUE (Date 1 3 2025) (Date 8 3 2025) FALSE EQUALS JUST FALSE
-- records kept in English: the subsection does not reach them.
#ASSERT `s 397(3) the directors have caused the true translations to be made and kept as the subsection requires` FALSE (Date 1 3 2025) (Date 20 3 2025) TRUE EQUALS NOTHING
-- The duty to translate within 7 days of the last: breached when the 7 days pass.
-- EXPECT BREACH
#TRACE `s 397(3) the directors must cause a true translation to be made within 7 days of the last` "Acme" AT 0 WITH
    WAITUNTIL 8
-- EXPECT FULFILLED
#TRACE `s 397(3) the directors must cause a true translation to be made within 7 days of the last` "Acme" AT 0 WITH
    PARTY `Board of directors` "Acme" DOES `s 397(3) cause a true translation of the accounts, financial statements, minute books and other records to be made` AT 7
-- EXPECT RESIDUAL
#TRACE `s 397(3) the directors must cause a true translation to be made within 7 days of the last` "Acme" AT 0 WITH
    WAITUNTIL 3
-- The duties of (1) and (2) have no time limit stated beyond "at the same time" and no stated consequence.
-- EXPECT FULFILLED
#TRACE `s 397(1) a corporation must lodge a certified English translation at the same time` "Acme" AT 0 WITH
    PARTY Company "Acme" DOES `s 397(1) lodge at the same time with the Registrar a certified translation in the English language` AT 900
-- EXPECT FULFILLED
#TRACE `s 397(2) a corporation must keep a certified English translation at its registered office` "Acme" AT 0 WITH
    PARTY Company "Acme" DOES `s 397(2) keep at the registered office in Singapore a certified translation in the English language` AT 900

§ `Section 398`

#ASSERT `s 398 the document is conclusive evidence that the requirements of this Act in respect of registration have been complied with and that the company is duly incorporated under this Act` `s 398 a certificate of incorporation under the hand and seal of the Registrar issued under this Act in force before 13 January 2003` EQUALS JUST TRUE
#ASSERT `s 398 the document is conclusive evidence that the requirements of this Act in respect of registration have been complied with and that the company is duly incorporated under this Act` `s 398 a notice of incorporation issued by the Registrar under this Act` EQUALS JUST TRUE
#ASSERT `s 398 the document is conclusive evidence that the requirements of this Act in respect of registration have been complied with and that the company is duly incorporated under this Act` `s 398 a certificate of confirmation of incorporation of the Registrar issued under this Act` EQUALS JUST TRUE
#ASSERT `s 398 the document is conclusive evidence that the requirements of this Act in respect of registration have been complied with and that the company is duly incorporated under this Act` `s 398 some other document` EQUALS NOTHING
