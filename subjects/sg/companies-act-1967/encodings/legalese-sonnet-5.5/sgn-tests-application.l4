IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgn-application`

-- Tests for sgn-application.l4 (ss 386AA, 386AB, 386AC). Every expected value is written from the text, beside the assertion:
-- JUST TRUE where the text says yes, JUST FALSE where it says no in its own words, NOTHING where it does not say.

§ `s 386AA(1)(a): all companies other than a company set out in the Fourteenth Schedule`

-- a company that is not in the Fourteenth Schedule: the Part applies
#ASSERT `s 386AA(1)(a) this Part applies to the company` TRUE FALSE EQUALS JUST TRUE
-- a company set out in the Fourteenth Schedule: "other than" says no
#ASSERT `s 386AA(1)(a) this Part applies to the company` TRUE TRUE EQUALS JUST FALSE
-- a body that is not a company: paragraph (a) does not speak of it
#ASSERT `s 386AA(1)(a) this Part applies to the company` FALSE FALSE EQUALS NOTHING
#ASSERT `s 386AA(1)(a) this Part applies to the company` FALSE TRUE EQUALS NOTHING

§ `s 386AA(1)(b): all foreign companies registered under Division 2 of Part 11 other than one set out in the Fifteenth Schedule`

#ASSERT `s 386AA(1)(b) this Part applies to the foreign company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AA(1)(b) this Part applies to the foreign company` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386AA(1)(b) this Part applies to the foreign company` FALSE FALSE EQUALS NOTHING
#ASSERT `s 386AA(1)(b) this Part applies to the foreign company` FALSE TRUE EQUALS NOTHING

§ `s 386AA(1): the two paragraphs together`

-- arguments: the body is a company; it is in the Fourteenth Schedule; it is a registered foreign company; it is in the Fifteenth Schedule
#ASSERT `s 386AA(1) this Part applies to the company or foreign company` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 386AA(1) this Part applies to the company or foreign company` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 386AA(1) this Part applies to the company or foreign company` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AA(1) this Part applies to the company or foreign company` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- neither a company nor a registered foreign company: the subsection does not say
#ASSERT `s 386AA(1) this Part applies to the company or foreign company` FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `s 386AA(1A): six provisions apply to a registrable controller even if it is itself in a Schedule`

-- arguments: the provision; the person is (or is believed to be) a registrable controller; the Part applies to the controlled company under (1)
#ASSERT `s 386AA(1A) the provision applies to the person` `s 386AA(1A) section 386AG(6)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AA(1A) the provision applies to the person` `s 386AA(1A) section 386AH(6)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AA(1A) the provision applies to the person` `s 386AA(1A) section 386AI(6)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AA(1A) the provision applies to the person` `s 386AA(1A) section 386AIA(3)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AA(1A) the provision applies to the person` `s 386AA(1A) section 386AJ` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AA(1A) the provision applies to the person` `s 386AA(1A) section 386AK` TRUE TRUE EQUALS JUST TRUE
-- a provision the subsection does not name
#ASSERT `s 386AA(1A) the provision applies to the person` `s 386AA(1A) some other provision of this Part` TRUE TRUE EQUALS NOTHING
-- not a (believed) registrable controller
#ASSERT `s 386AA(1A) the provision applies to the person` `s 386AA(1A) section 386AJ` FALSE TRUE EQUALS NOTHING
-- the controlled company is outside the Part (a Fourteenth Schedule company)
#ASSERT `s 386AA(1A) the provision applies to the person` `s 386AA(1A) section 386AJ` TRUE FALSE EQUALS NOTHING

§ `s 386AA(2) and (3): reach of the Part`

#ASSERT `s 386AA(2) the obligation to comply with this Part extends to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AA(2) the obligation to comply with this Part extends to the person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AA(2) the obligation to comply with this Part extends to the person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 386AA(3) this Part extends to the act or omission` TRUE EQUALS JUST TRUE
#ASSERT `s 386AA(3) this Part extends to the act or omission` FALSE EQUALS NOTHING

§ `s 386AB: definitions`

#ASSERT `s 386AB "approved exchange" the exchange is an approved exchange` TRUE EQUALS JUST TRUE
#ASSERT `s 386AB "approved exchange" the exchange is an approved exchange` FALSE EQUALS JUST FALSE

#ASSERT `s 386AB "significant interest" the person has a significant interest` TRUE EQUALS JUST TRUE
#ASSERT `s 386AB "significant interest" the person has a significant interest` FALSE EQUALS JUST FALSE
#ASSERT `s 386AB "significant control" the person has significant control` TRUE EQUALS JUST TRUE
#ASSERT `s 386AB "significant control" the person has significant control` FALSE EQUALS JUST FALSE

-- "legal entity": a body corporate anywhere, or a foreign company
#ASSERT `s 386AB "legal entity" the body is a legal entity` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AB "legal entity" the body is a legal entity` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AB "legal entity" the body is a legal entity` FALSE FALSE EQUALS JUST FALSE

-- "corporate controller": a legal entity with a significant interest in, or significant control over, the company
-- arguments: the person is a legal entity; significant interest; significant control
#ASSERT `s 386AB "corporate controller" the person is a corporate controller` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AB "corporate controller" the person is a corporate controller` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AB "corporate controller" the person is a corporate controller` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 386AB "corporate controller" the person is a corporate controller` FALSE TRUE TRUE EQUALS JUST FALSE

-- "individual controller": an individual with a significant interest in, or significant control over, the company
#ASSERT `s 386AB "individual controller" the person is an individual controller` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AB "individual controller" the person is an individual controller` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AB "individual controller" the person is an individual controller` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 386AB "individual controller" the person is an individual controller` FALSE TRUE TRUE EQUALS JUST FALSE

-- "controller": an individual controller or a corporate controller
-- arguments: the person is an individual; the person is a legal entity; significant interest; significant control
#ASSERT `s 386AB "controller" the person is a controller of the company or foreign company` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AB "controller" the person is a controller of the company or foreign company` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AB "controller" the person is a controller of the company or foreign company` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 386AB "controller" the person is a controller of the company or foreign company` FALSE FALSE TRUE TRUE EQUALS JUST FALSE

#ASSERT `s 386AB "limited liability partnership" the partnership is a limited liability partnership` TRUE EQUALS JUST TRUE
#ASSERT `s 386AB "limited liability partnership" the partnership is a limited liability partnership` FALSE EQUALS JUST FALSE

-- "member of the public" includes a member of the company, or of the foreign company, acting as such: an open list
#ASSERT `s 386AB "member of the public" the person is a member of the public` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AB "member of the public" the person is a member of the public` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AB "member of the public" the person is a member of the public` FALSE FALSE EQUALS NOTHING

-- "register of controllers": for a company, the register it must keep under s 386AF(1), (1A), (2) or (3); for a foreign company, under (4), (4A), (5) or (6)
-- arguments: the kind of body; the company-register fact; the foreign-company-register fact
#ASSERT `s 386AB "register of controllers" the register is the register of controllers` `s 386AB "register of controllers" a company to which this Part applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AB "register of controllers" the register is the register of controllers` `s 386AB "register of controllers" a company to which this Part applies` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 386AB "register of controllers" the register is the register of controllers` `s 386AB "register of controllers" a foreign company to which this Part applies` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AB "register of controllers" the register is the register of controllers` `s 386AB "register of controllers" a foreign company to which this Part applies` TRUE FALSE EQUALS JUST FALSE

§ `s 386AC(c): the eight kinds of controller B`

#ASSERT `s 386AC(c) the controller is of a kind that paragraph (c) lists` `s 386AC(c)(i) a company, or foreign company to which this Part applies, that is required to keep a register of controllers under section 386AF`
#ASSERT `s 386AC(c) the controller is of a kind that paragraph (c) lists` `s 386AC(c)(ii) a company that is set out in the Fourteenth Schedule`
#ASSERT `s 386AC(c) the controller is of a kind that paragraph (c) lists` `s 386AC(c)(iii) a foreign company that is set out in the Fifteenth Schedule`
#ASSERT `s 386AC(c) the controller is of a kind that paragraph (c) lists` `s 386AC(c)(iv) a corporation whose shares are listed for quotation on an approved exchange`
#ASSERT `s 386AC(c) the controller is of a kind that paragraph (c) lists` `s 386AC(c)(v) a limited liability partnership to which Part 6A of the Limited Liability Partnerships Act 2005 applies, that is required to keep a register of controllers of limited liability partnerships under that Act`
#ASSERT `s 386AC(c) the controller is of a kind that paragraph (c) lists` `s 386AC(c)(vi) a limited liability partnership that is set out in the Sixth Schedule to the Limited Liability Partnerships Act 2005`
#ASSERT `s 386AC(c) the controller is of a kind that paragraph (c) lists` `s 386AC(c)(vii) a trustee of an express trust to which Part 7 of the Trustees Act 1967 applies`
#ASSERT `s 386AC(c) the controller is of a kind that paragraph (c) lists` `s 386AC(c)(viii) a VCC`
#ASSERT NOT (`s 386AC(c) the controller is of a kind that paragraph (c) lists` `s 386AC(c) none of those eight kinds`)

§ `s 386AC: a controller is registrable unless (a), (b) and (c) all hold`

-- arguments: A is a controller of X; A's interest is only through controllers B; A is a controller of B; the kinds of the B's
-- a direct holder (not only through another controller): registrable
#ASSERT `s 386AC the controller is registrable` TRUE FALSE FALSE EMPTY EQUALS JUST TRUE
-- only through one controller B that is a listed company, and A controls B: not registrable (the "unless" is met)
#ASSERT `s 386AC the controller is registrable` TRUE TRUE TRUE (LIST `s 386AC(c)(i) a company, or foreign company to which this Part applies, that is required to keep a register of controllers under section 386AF`) EQUALS JUST FALSE
-- each of the other seven listed kinds also meets (c)
#ASSERT `s 386AC the controller is registrable` TRUE TRUE TRUE (LIST `s 386AC(c)(ii) a company that is set out in the Fourteenth Schedule`) EQUALS JUST FALSE
#ASSERT `s 386AC the controller is registrable` TRUE TRUE TRUE (LIST `s 386AC(c)(iii) a foreign company that is set out in the Fifteenth Schedule`) EQUALS JUST FALSE
#ASSERT `s 386AC the controller is registrable` TRUE TRUE TRUE (LIST `s 386AC(c)(iv) a corporation whose shares are listed for quotation on an approved exchange`) EQUALS JUST FALSE
#ASSERT `s 386AC the controller is registrable` TRUE TRUE TRUE (LIST `s 386AC(c)(v) a limited liability partnership to which Part 6A of the Limited Liability Partnerships Act 2005 applies, that is required to keep a register of controllers of limited liability partnerships under that Act`) EQUALS JUST FALSE
#ASSERT `s 386AC the controller is registrable` TRUE TRUE TRUE (LIST `s 386AC(c)(vi) a limited liability partnership that is set out in the Sixth Schedule to the Limited Liability Partnerships Act 2005`) EQUALS JUST FALSE
#ASSERT `s 386AC the controller is registrable` TRUE TRUE TRUE (LIST `s 386AC(c)(vii) a trustee of an express trust to which Part 7 of the Trustees Act 1967 applies`) EQUALS JUST FALSE
#ASSERT `s 386AC the controller is registrable` TRUE TRUE TRUE (LIST `s 386AC(c)(viii) a VCC`) EQUALS JUST FALSE
-- "(or each B if more than one)": two B's, both listed: not registrable; two B's, one not listed: registrable
#ASSERT `s 386AC the controller is registrable` TRUE TRUE TRUE (LIST `s 386AC(c)(viii) a VCC`, `s 386AC(c)(iv) a corporation whose shares are listed for quotation on an approved exchange`) EQUALS JUST FALSE
#ASSERT `s 386AC the controller is registrable` TRUE TRUE TRUE (LIST `s 386AC(c)(viii) a VCC`, `s 386AC(c) none of those eight kinds`) EQUALS JUST TRUE
-- the one B is not of a listed kind: registrable
#ASSERT `s 386AC the controller is registrable` TRUE TRUE TRUE (LIST `s 386AC(c) none of those eight kinds`) EQUALS JUST TRUE
-- (b) fails: A is not a controller of B
#ASSERT `s 386AC the controller is registrable` TRUE TRUE FALSE (LIST `s 386AC(c)(viii) a VCC`) EQUALS JUST TRUE
-- (a) fails: A holds directly as well, so not "only through" B
#ASSERT `s 386AC the controller is registrable` TRUE FALSE TRUE (LIST `s 386AC(c)(viii) a VCC`) EQUALS JUST TRUE
-- not a controller at all: the section does not speak of it
#ASSERT `s 386AC the controller is registrable` FALSE TRUE TRUE (LIST `s 386AC(c)(viii) a VCC`) EQUALS NOTHING

§ `s 386AB: the lead-in "unless the context otherwise requires"`

-- the context requires otherwise: the definitions of this Part do not apply there; otherwise they apply
#ASSERT `s 386AB the definitions of this Part apply here` TRUE EQUALS JUST FALSE
#ASSERT `s 386AB the definitions of this Part apply here` FALSE EQUALS JUST TRUE
