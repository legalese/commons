-- Fixtures: a body with every fact FALSE, and the same with one fact TRUE. Columns of `s 4(1) body`, in DECLARE order:
-- a body corporate; a foreign company by limb (a); a foreign unincorporated body (limb (b) first part); head office in Singapore;
-- a Gazetted public authority incorporated in Singapore; a corporation sole; a cooperative society; a registered trade union;
-- a platform work association; a limited liability partnership.
`a body that is nothing the Act names` MEANS `s 4(1) body` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a body corporate formed in Singapore` MEANS `s 4(1) body` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a body corporate formed outside Singapore` MEANS `s 4(1) body` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`an unincorporated foreign association that can sue through its secretary and has no head office in Singapore` MEANS `s 4(1) body` OF FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`an unincorporated foreign association that can sue through its secretary and has its head office in Singapore` MEANS `s 4(1) body` OF FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE
`a Gazetted public authority incorporated in Singapore` MEANS `s 4(1) body` OF TRUE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE
`a corporation sole` MEANS `s 4(1) body` OF TRUE, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE
`a cooperative society formed in Singapore` MEANS `s 4(1) body` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`a cooperative society formed outside Singapore` MEANS `s 4(1) body` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`a registered trade union` MEANS `s 4(1) body` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE
`a registered platform work association` MEANS `s 4(1) body` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE
`a limited liability partnership formed in Singapore` MEANS `s 4(1) body` OF TRUE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE
`a limited liability partnership formed outside Singapore, not within section 2(1) of the Limited Liability Partnerships Act 2005` MEANS `s 4(1) body` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE

-- s 4(1) "corporation": any body corporate, in Singapore or outside, and any foreign company.
#ASSERT `s 4(1) "corporation" the body is a corporation` `a body corporate formed in Singapore` EQUALS JUST TRUE
#ASSERT `s 4(1) "corporation" the body is a corporation` `a body corporate formed outside Singapore` EQUALS JUST TRUE
-- Includes any foreign company, though it is not a body corporate.
#ASSERT `s 4(1) "corporation" the body is a corporation` `an unincorporated foreign association that can sue through its secretary and has no head office in Singapore` EQUALS JUST TRUE
-- But an unincorporated body with its head office in Singapore is not a foreign company, so not a corporation.
#ASSERT `s 4(1) "corporation" the body is a corporation` `an unincorporated foreign association that can sue through its secretary and has its head office in Singapore` EQUALS JUST FALSE
#ASSERT `s 4(1) "corporation" the body is a corporation` `a body that is nothing the Act names` EQUALS JUST FALSE
-- The five exclusions, and the one in (da).
#ASSERT `s 4(1) "corporation" the body is a corporation` `a Gazetted public authority incorporated in Singapore` EQUALS JUST FALSE        -- (a)
#ASSERT `s 4(1) "corporation" the body is a corporation` `a corporation sole` EQUALS JUST FALSE                                        -- (b)
#ASSERT `s 4(1) "corporation" the body is a corporation` `a cooperative society formed in Singapore` EQUALS JUST FALSE                  -- (c)
#ASSERT `s 4(1) "corporation" the body is a corporation` `a registered trade union` EQUALS JUST FALSE                                  -- (d)
#ASSERT `s 4(1) "corporation" the body is a corporation` `a registered platform work association` EQUALS JUST FALSE                    -- (da)
#ASSERT `s 4(1) "corporation" the body is a corporation` `a limited liability partnership formed in Singapore` EQUALS JUST FALSE        -- (e)
-- A cooperative society formed abroad is a foreign company (limb (a)) and an excluded cooperative society (c): "does not include" has the last word (fork F-C1).
#ASSERT `s 4(1) "foreign company" the body is a foreign company` `a cooperative society formed outside Singapore` EQUALS JUST TRUE
#ASSERT `s 4(1) "corporation" the body is a corporation` `a cooperative society formed outside Singapore` EQUALS JUST FALSE
-- An LLP formed abroad is not within the LLP Act's definition (the exclusion (e) names that Act's term); it is a foreign company, so a corporation.
#ASSERT `s 4(1) "corporation" the body is a corporation` `a limited liability partnership formed outside Singapore, not within section 2(1) of the Limited Liability Partnerships Act 2005` EQUALS JUST TRUE


#ASSERT `s 4(1) "Court" the court is the Court` FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "Court" the court is the Court` TRUE EQUALS JUST TRUE


#ASSERT `s 4(1) "corresponding previous written law" the law is a corresponding previous written law` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "corresponding previous written law" the law is a corresponding previous written law` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4(1) "corresponding previous written law" the law is a corresponding previous written law` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "corresponding previous written law" the law is a corresponding previous written law` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4(1) "corresponding previous written law" the law is a corresponding previous written law` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "corresponding previous written law" the law is a corresponding previous written law` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4(1) "corresponding previous written law" the law is a corresponding previous written law` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "corresponding previous written law" the law is a corresponding previous written law` TRUE TRUE TRUE EQUALS JUST TRUE


-- Columns: debenture stock/bond/note/other security; a cheque, letter of credit, order or bill; a promissory note; face value;
-- maturity in months; regulations change the note exclusion; a prescribed document.
#ASSERT `s 4(1) "debenture" the instrument is a debenture` TRUE FALSE FALSE 0 0 FALSE FALSE EQUALS JUST TRUE
-- A cheque, letter of credit, order or bill is not, even if it could be called a security.
#ASSERT `s 4(1) "debenture" the instrument is a debenture` TRUE TRUE FALSE 0 0 FALSE FALSE EQUALS JUST FALSE
-- A promissory note of $100,000 or more and at most 12 months is excluded: both limbs, on both sides of each.
#ASSERT `s 4(1) "debenture" the instrument is a debenture` TRUE FALSE TRUE 100000 12 FALSE FALSE EQUALS JUST FALSE   -- exactly on both limits: excluded
#ASSERT `s 4(1) "debenture" the instrument is a debenture` TRUE FALSE TRUE 99999 12 FALSE FALSE EQUALS JUST TRUE     -- $1 under the face value
#ASSERT `s 4(1) "debenture" the instrument is a debenture` TRUE FALSE TRUE 100000 13 FALSE FALSE EQUALS JUST TRUE    -- a month over the maturity
#ASSERT `s 4(1) "debenture" the instrument is a debenture` TRUE FALSE TRUE 250000 6 FALSE FALSE EQUALS JUST FALSE
-- "Subject to the regulations": if the regulations change the note exclusion, the Act does not say.
#ASSERT `s 4(1) "debenture" the instrument is a debenture` TRUE FALSE TRUE 100000 12 TRUE FALSE EQUALS NOTHING
-- A prescribed document is excluded for the provision in question.
#ASSERT `s 4(1) "debenture" the instrument is a debenture` TRUE FALSE FALSE 0 0 FALSE TRUE EQUALS JUST FALSE
-- Not on the list at all: the list is open.
#ASSERT `s 4(1) "debenture" the instrument is a debenture` FALSE FALSE FALSE 0 0 FALSE FALSE EQUALS NOTHING


#ASSERT `s 4(1) "default penalty" the penalty is a default penalty` FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "default penalty" the penalty is a default penalty` TRUE EQUALS JUST TRUE


#ASSERT `s 4(1) "Depository" the body is the Depository` FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "Depository" the body is the Depository` TRUE EQUALS JUST TRUE


-- Columns: occupies the position; the directors are accustomed to act on the person's directions; and that is only because of professional advice; an alternate or substitute.
#ASSERT `s 4(1) "director" the person is within the word director` TRUE FALSE FALSE FALSE EQUALS JUST TRUE         -- the position, by whatever name
#ASSERT `s 4(1) "director" the person is within the word director` FALSE TRUE FALSE FALSE EQUALS JUST TRUE        -- a shadow director
#ASSERT `s 4(1) "director" the person is within the word director` FALSE FALSE FALSE TRUE EQUALS JUST TRUE        -- an alternate or substitute
#ASSERT `s 4(1) "director" the person is within the word director` FALSE FALSE FALSE FALSE EQUALS NOTHING         -- not on the list: open
-- s 4(2): the directors follow the person only because of the person's professional advice: not a shadow director.
#ASSERT `s 4(1) "director" the person is within the word director` FALSE TRUE TRUE FALSE EQUALS NOTHING
-- ... but the professional adviser who also holds the position, or is an alternate, is still within it.
#ASSERT `s 4(1) "director" the person is within the word director` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) "director" the person is within the word director` FALSE TRUE TRUE TRUE EQUALS JUST TRUE


