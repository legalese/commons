IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-definitions`

-- Tests for sg-definitions.l4 (s 4(1) and (2)).
-- THE POINTER DEFINITIONS (one fact in, the term out) are tested from the same table that writes them: for each, every row of the
-- truth table (or, past three facts, the all-true, all-false, each-one-true and each-one-false rows) is asserted against what the
-- text's connectives ("means", "includes", "and", "or", "but does not include") say. That tests the wiring and the closed/open
-- choice, not the reading of the text; the terms with a real structure (corporation, foreign company, debenture, director,
-- exempt private company, officer, voting share, identification, ...) have hand-written cases beside them, below.
-- Expected values come from the connectives in the text, never from the module's output.

#ASSERT `s 4(1) "accounting corporation" the company is an accounting corporation` FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "accounting corporation" the company is an accounting corporation` TRUE EQUALS JUST TRUE


#ASSERT `s 4(1) "accounting entity" the person is an accounting entity` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "accounting entity" the person is an accounting entity` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 4(1) "accounting entity" the person is an accounting entity` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) "accounting entity" the person is an accounting entity` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) "accounting entity" the person is an accounting entity` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 4(1) "accounting entity" the person is an accounting entity` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) "accounting entity" the person is an accounting entity` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 4(1) "accounting entity" the person is an accounting entity` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 4(1) "accounting entity" the person is an accounting entity` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) "accounting entity" the person is an accounting entity` TRUE TRUE TRUE TRUE EQUALS JUST TRUE


#ASSERT `s 4(1) "accounting firm" the firm is an accounting firm` FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "accounting firm" the firm is an accounting firm` TRUE EQUALS JUST TRUE


#ASSERT `s 4(1) "accounting limited liability partnership" the limited liability partnership is an accounting limited liability partnership` FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "accounting limited liability partnership" the limited liability partnership is an accounting limited liability partnership` TRUE EQUALS JUST TRUE


#ASSERT `s 4(1) "accounting records" the paper or document is within the accounting records of the corporation` FALSE EQUALS NOTHING
#ASSERT `s 4(1) "accounting records" the paper or document is within the accounting records of the corporation` TRUE EQUALS JUST TRUE


#ASSERT `s 4(1) "Accounting Standards" the standards are the Accounting Standards` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "Accounting Standards" the standards are the Accounting Standards` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4(1) "Accounting Standards" the standards are the Accounting Standards` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "Accounting Standards" the standards are the Accounting Standards` TRUE TRUE EQUALS JUST TRUE


-- s 4(1) "accounts": a P&L account or a balance sheet; a note read with them; but not an auditors' or directors' report.
#ASSERT `s 4(1) "accounts" the thing is within the word accounts` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) "accounts" the thing is within the word accounts` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) "accounts" the thing is within the word accounts` FALSE TRUE TRUE EQUALS JUST FALSE      -- a note that is a directors' report is excluded
#ASSERT `s 4(1) "accounts" the thing is within the word accounts` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 4(1) "accounts" the thing is within the word accounts` FALSE FALSE TRUE EQUALS NOTHING      -- a report that is not a note: not covered


