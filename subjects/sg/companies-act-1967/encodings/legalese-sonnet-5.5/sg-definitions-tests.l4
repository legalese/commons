#ASSERT `s 4(1) "document" the thing is within the word document` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 4(1) "document" the thing is within the word document` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) "document" the thing is within the word document` TRUE TRUE TRUE EQUALS JUST TRUE


