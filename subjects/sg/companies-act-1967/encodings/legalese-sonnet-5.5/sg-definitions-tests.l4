#ASSERT `s 4(1) "emoluments" the payment is within the emoluments of the director or auditor` TRUE TRUE TRUE TRUE EQUALS JUST TRUE


-- Columns: a private company; no beneficial interest held by any corporation; members; wholly Government-owned; declared by the Minister.
#ASSERT `s 4(1) "exempt private company" the company is an exempt private company` TRUE TRUE 20 FALSE FALSE EQUALS JUST TRUE     -- (a): exactly 20 members
#ASSERT `s 4(1) "exempt private company" the company is an exempt private company` TRUE TRUE 21 FALSE FALSE EQUALS JUST FALSE    -- 21 members: over
#ASSERT `s 4(1) "exempt private company" the company is an exempt private company` TRUE TRUE 1 FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) "exempt private company" the company is an exempt private company` TRUE FALSE 5 FALSE FALSE EQUALS JUST FALSE    -- a corporation holds a beneficial interest
#ASSERT `s 4(1) "exempt private company" the company is an exempt private company` FALSE TRUE 5 FALSE FALSE EQUALS JUST FALSE    -- not a private company
-- (b): wholly owned by the Government AND declared by the Minister; either alone is not enough; the member count and the corporation rule do not apply.
#ASSERT `s 4(1) "exempt private company" the company is an exempt private company` TRUE FALSE 500 TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 4(1) "exempt private company" the company is an exempt private company` TRUE FALSE 500 TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 4(1) "exempt private company" the company is an exempt private company` TRUE FALSE 500 FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4(1) "exempt private company" the company is an exempt private company` FALSE FALSE 500 TRUE TRUE EQUALS JUST FALSE   -- (b) is "any private company"


