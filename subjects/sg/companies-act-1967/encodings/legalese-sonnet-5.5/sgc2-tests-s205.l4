IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgc2-common`
IMPORT `sgc2-s205-appointment`

-- Tests for sgc2-s205-appointment.l4 (section 205). Every expected value is written from the text of section 205, beside the assertion, not from the code.
-- A date is Date day month year. Argument order is the order of the GIVEN lines of the function under test.

§ `The common helpers`

-- "within 3 months after" counts the day of the event out (P1): 1 January 2026 + 3 months is 1 April 2026; 30 November 2025 + 3 months clamps to 28 February 2026 (P4).
#ASSERT `s 205 helper: default in an act due by the last day` TRUE (Date 1 4 2026) (Date 1 4 2026) (Date 1 7 2026) EQUALS FALSE
#ASSERT `s 205 helper: default in an act due by the last day` TRUE (Date 2 4 2026) (Date 1 4 2026) (Date 1 7 2026) EQUALS TRUE
#ASSERT `s 205 helper: default in an act due by the last day` FALSE (Date 1 1 2026) (Date 1 4 2026) (Date 1 4 2026) EQUALS FALSE
#ASSERT `s 205 helper: default in an act due by the last day` FALSE (Date 1 1 2026) (Date 1 4 2026) (Date 2 4 2026) EQUALS TRUE
#ASSERT `s 205 helper: the days from the event to the last day` (Date 1 1 2026) (Date 1 4 2026) EQUALS 90
#ASSERT `s 205 helper: the days from the event to the last day` (Date 1 1 2026) (Date 1 1 2026) EQUALS 0

§ `Section 205(1)`

#ASSERT `s 205(1) the last day for the directors to appoint the first auditor` (Date 1 1 2026) EQUALS Date 1 4 2026
-- 30 November 2025 + 3 months: no 30 February, so the last day of February (P4).
#ASSERT `s 205(1) the last day for the directors to appoint the first auditor` (Date 30 11 2025) EQUALS Date 28 2 2026
-- Appointed on the last day: in time, so no default.
#ASSERT `s 205(1) the directors are in default of the duty to appoint the first auditor` (Date 1 1 2026) TRUE (Date 1 4 2026) (Date 1 7 2026) EQUALS JUST FALSE
-- Appointed one day after the last day: default.
#ASSERT `s 205(1) the directors are in default of the duty to appoint the first auditor` (Date 1 1 2026) TRUE (Date 2 4 2026) (Date 1 7 2026) EQUALS JUST TRUE
-- Not appointed, and the last day has not passed: the duty is still due, no default yet.
#ASSERT `s 205(1) the directors are in default of the duty to appoint the first auditor` (Date 1 1 2026) FALSE (Date 1 1 2026) (Date 1 4 2026) EQUALS JUST FALSE
-- Not appointed, and the last day has passed: default.
#ASSERT `s 205(1) the directors are in default of the duty to appoint the first auditor` (Date 1 1 2026) FALSE (Date 1 1 2026) (Date 2 4 2026) EQUALS JUST TRUE
-- Tenure: until the conclusion of the first annual general meeting, subject to removal or resignation.
#ASSERT `s 205(1) the auditor appointed by the directors holds office` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 205(1) the auditor appointed by the directors holds office` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 205(1) the auditor appointed by the directors holds office` FALSE TRUE EQUALS JUST FALSE

-- EXPECT FULFILLED
#TRACE `s 205(1) the directors must appoint the first auditor` "Ann" (Date 1 1 2026) AT 0 WITH
    PARTY Director "Ann" DOES `s 205(1) appoint an accounting entity or accounting entities as the auditor or auditors of the company` AT 90

-- EXPECT BREACH
#TRACE `s 205(1) the directors must appoint the first auditor` "Ann" (Date 1 1 2026) AT 0 WITH
    PARTY Director "Ann" DOES `s 205(1) appoint an accounting entity or accounting entities as the auditor or auditors of the company` AT 91

-- EXPECT BREACH
#TRACE `s 205(1) the directors must appoint the first auditor` "Ann" (Date 1 1 2026) AT 0 WITH
    (WAITUNTIL 91)

-- EXPECT RESIDUAL
#TRACE `s 205(1) the directors must appoint the first auditor` "Ann" (Date 1 1 2026) AT 0 WITH
    (WAITUNTIL 90)

§ `Section 205(2)`

#ASSERT `s 205(2) the company is in default of the duty to appoint an auditor at the annual general meeting` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 205(2) the company is in default of the duty to appoint an auditor at the annual general meeting` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 205(2) the company is in default of the duty to appoint an auditor at the annual general meeting` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 205(2) the auditor appointed at the annual general meeting holds office` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 205(2) the auditor appointed at the annual general meeting holds office` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 205(2) the auditor appointed at the annual general meeting holds office` FALSE TRUE EQUALS JUST FALSE

-- No time limit in the text but the meeting itself: the duty read as a trace has no breach path (NOTES.md).
-- EXPECT FULFILLED
#TRACE `s 205(2) the company must appoint an auditor at each annual general meeting` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205(2) appoint an accounting entity or accounting entities as the auditor or auditors at the annual general meeting` AT 400

-- EXPECT RESIDUAL
#TRACE `s 205(2) the company must appoint an auditor at each annual general meeting` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 400)

§ `Section 205(3)`

#ASSERT `s 205(3) the directors may appoint the accounting entity to fill the casual vacancy` TRUE TRUE FALSE EQUALS JUST TRUE
-- A vacancy but the appointee is not an accounting entity: the grant is not made out (NOTHING, not FALSE).
#ASSERT `s 205(3) the directors may appoint the accounting entity to fill the casual vacancy` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 205(3) the directors may appoint the accounting entity to fill the casual vacancy` FALSE TRUE FALSE EQUALS NOTHING
-- "Subject to subsections (7) and (8) and section 205AF": where those govern, this subsection does not answer.
#ASSERT `s 205(3) the directors may appoint the accounting entity to fill the casual vacancy` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 205(3) the surviving or continuing auditor may act` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 205(3) the surviving or continuing auditor may act` FALSE TRUE EQUALS NOTHING
#ASSERT `s 205(3) the surviving or continuing auditor may act` TRUE FALSE EQUALS NOTHING

§ `Section 205(4)`

#ASSERT `s 205(4) the auditor may be removed from office by the resolution` TRUE TRUE EQUALS JUST TRUE
-- "but not otherwise": no special notice, or no resolution at a general meeting, is a no.
#ASSERT `s 205(4) the auditor may be removed from office by the resolution` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 205(4) the auditor may be removed from office by the resolution` FALSE TRUE EQUALS JUST FALSE

§ `Section 205(5)`

#ASSERT `s 205(5)(a) the company is in default of the duty to send a copy of the notice` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 205(5)(a) the company is in default of the duty to send a copy of the notice` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 205(5)(a) the company is in default of the duty to send a copy of the notice` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 205(5)(a) the company is in default of the duty to send a copy of the notice` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 205(5)(a) the company is in default of the duty to send a copy of the notice` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- No number is stated ("immediately"): the section's own standard of time sets the time, as the input `the period the standard of time allows, as found`.
-- EXPECT FULFILLED
#TRACE `s 205(5)(a) the company must send a copy of the notice of the removal resolution` "Acme Pte Ltd" 7 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205(5)(a) send a copy of the notice of the resolution to remove the auditor to the auditor concerned and to the Registrar` AT 3

-- late: the act is done on day 400, past the 7 days the input is, so BREACH
-- EXPECT BREACH
#TRACE `s 205(5)(a) the company must send a copy of the notice of the removal resolution` "Acme Pte Ltd" 7 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205(5)(a) send a copy of the notice of the resolution to remove the auditor to the auditor concerned and to the Registrar` AT 400

-- EXPECT RESIDUAL
#TRACE `s 205(5)(a) the company must send a copy of the notice of the removal resolution` "Acme Pte Ltd" 45 AT 0 WITH
    (WAITUNTIL 3)

-- (5)(b): received 1 March, representations on 8 March (7 days after: in time), writing, reasonable, asked before the meeting on 20 March.
#ASSERT `s 205(5)(b) the auditor may make representations and have a copy sent to every member` (Date 1 3 2026) (Date 8 3 2026) TRUE TRUE (Date 9 3 2026) (Date 20 3 2026) EQUALS JUST TRUE
-- On 9 March: outside the 7 days, a period fixed in the text's words: JUST FALSE.
#ASSERT `s 205(5)(b) the auditor may make representations and have a copy sent to every member` (Date 1 3 2026) (Date 9 3 2026) TRUE TRUE (Date 9 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
-- In time but not in writing, or too long, or the request came on the day of the meeting: NOTHING.
#ASSERT `s 205(5)(b) the auditor may make representations and have a copy sent to every member` (Date 1 3 2026) (Date 8 3 2026) FALSE TRUE (Date 9 3 2026) (Date 20 3 2026) EQUALS NOTHING
#ASSERT `s 205(5)(b) the auditor may make representations and have a copy sent to every member` (Date 1 3 2026) (Date 8 3 2026) TRUE FALSE (Date 9 3 2026) (Date 20 3 2026) EQUALS NOTHING
#ASSERT `s 205(5)(b) the auditor may make representations and have a copy sent to every member` (Date 1 3 2026) (Date 8 3 2026) TRUE TRUE (Date 20 3 2026) (Date 20 3 2026) EQUALS NOTHING
-- Representations made on the day the copy was received (day 0): still not later than 7 days after.
#ASSERT `s 205(5)(b) the auditor may make representations and have a copy sent to every member` (Date 1 3 2026) (Date 1 3 2026) TRUE TRUE (Date 2 3 2026) (Date 20 3 2026) EQUALS JUST TRUE

§ `Section 205(6)`

#ASSERT `s 205(6) the company is in default of the duty to send a copy of the representations` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 205(6) the company is in default of the duty to send a copy of the representations` TRUE FALSE TRUE EQUALS JUST FALSE
-- "Unless the Registrar ... otherwise orders": the duty falls away.
#ASSERT `s 205(6) the company is in default of the duty to send a copy of the representations` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 205(6) the company is in default of the duty to send a copy of the representations` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 205(6) the auditor may require that the representations be read out at the meeting` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 205(6) the auditor may require that the representations be read out at the meeting` FALSE FALSE EQUALS NOTHING
#ASSERT `s 205(6) the auditor may require that the representations be read out at the meeting` TRUE TRUE EQUALS JUST FALSE

-- EXPECT FULFILLED
#TRACE `s 205(6) the company must send a copy of the representations` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205(6) send a copy of the representations to every member to whom notice of the meeting is sent` AT 5

§ `Section 205(7)`

-- (a): 3 of 4 members voting is three-fourths, the least that will do; 2 of 3 is not.
#ASSERT `s 205(7)(a) the company may immediately appoint another accounting entity as auditor` TRUE TRUE 3 4 EQUALS JUST TRUE
#ASSERT `s 205(7)(a) the company may immediately appoint another accounting entity as auditor` TRUE TRUE 2 3 EQUALS NOTHING
#ASSERT `s 205(7)(a) the company may immediately appoint another accounting entity as auditor` TRUE TRUE 75 100 EQUALS JUST TRUE
#ASSERT `s 205(7)(a) the company may immediately appoint another accounting entity as auditor` TRUE TRUE 74 100 EQUALS NOTHING
-- Not an accounting entity nominated at the meeting: NOTHING.
#ASSERT `s 205(7)(a) the company may immediately appoint another accounting entity as auditor` TRUE FALSE 4 4 EQUALS NOTHING
-- Not removed under (4) at a general meeting: the "where" fails.
#ASSERT `s 205(7)(a) the company may immediately appoint another accounting entity as auditor` FALSE TRUE 4 4 EQUALS JUST FALSE
-- (b): meeting on 1 March; resumed 21 March (20 days after) is the earliest; 31 March (30 days after) the latest; nomination received at least 10 days before.
#ASSERT `s 205(7)(b) the company may appoint another accounting entity as auditor at the adjourned meeting` TRUE (Date 1 3 2026) (Date 21 3 2026) (Date 11 3 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 205(7)(b) the company may appoint another accounting entity as auditor at the adjourned meeting` TRUE (Date 1 3 2026) (Date 31 3 2026) (Date 21 3 2026) TRUE TRUE EQUALS JUST TRUE
-- One day too early (19 days), one day too late (31 days): outside the period the text fixes.
#ASSERT `s 205(7)(b) the company may appoint another accounting entity as auditor at the adjourned meeting` TRUE (Date 1 3 2026) (Date 20 3 2026) (Date 10 3 2026) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 205(7)(b) the company may appoint another accounting entity as auditor at the adjourned meeting` TRUE (Date 1 3 2026) (Date 1 4 2026) (Date 22 3 2026) TRUE TRUE EQUALS JUST FALSE
-- Nomination received 9 days before the resumption (12 March for a 21 March resumption): too late.
#ASSERT `s 205(7)(b) the company may appoint another accounting entity as auditor at the adjourned meeting` TRUE (Date 1 3 2026) (Date 21 3 2026) (Date 12 3 2026) TRUE TRUE EQUALS JUST FALSE
-- Dates right but the appointment is not by ordinary resolution, or the appointee is not an accounting entity: NOTHING.
#ASSERT `s 205(7)(b) the company may appoint another accounting entity as auditor at the adjourned meeting` TRUE (Date 1 3 2026) (Date 21 3 2026) (Date 11 3 2026) TRUE FALSE EQUALS NOTHING
#ASSERT `s 205(7)(b) the company may appoint another accounting entity as auditor at the adjourned meeting` TRUE (Date 1 3 2026) (Date 21 3 2026) (Date 11 3 2026) FALSE TRUE EQUALS NOTHING
#ASSERT `s 205(7)(b) the company may appoint another accounting entity as auditor at the adjourned meeting` FALSE (Date 1 3 2026) (Date 21 3 2026) (Date 11 3 2026) TRUE TRUE EQUALS JUST FALSE

§ `Section 205(8)`

#ASSERT `s 205(8) the company is in default of the duty to give written notice of the removal to the Registrar` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 205(8) the company is in default of the duty to give written notice of the removal to the Registrar` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 205(8) the company is in default of the duty to give written notice of the removal to the Registrar` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 205(8) the company is in default of the duty to give written notice of the removal to the Registrar` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 205(8) the Registrar may appoint an auditor of the company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 205(8) the Registrar may appoint an auditor of the company` TRUE TRUE EQUALS NOTHING
#ASSERT `s 205(8) the Registrar may appoint an auditor of the company` FALSE FALSE EQUALS NOTHING

-- EXPECT FULFILLED
#TRACE `s 205(8) the company must give written notice of the removal to the Registrar` "Acme Pte Ltd" 45 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205(8) give written notice of the removal of the auditor to the Registrar` AT 1

-- late: the act is done on day 400, past the 7 days the input is, so BREACH
-- EXPECT BREACH
#TRACE `s 205(8) the company must give written notice of the removal to the Registrar` "Acme Pte Ltd" 7 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205(8) give written notice of the removal of the auditor to the Registrar` AT 400

-- EXPECT RESIDUAL
#TRACE `s 205(8) the company must give written notice of the removal to the Registrar` "Acme Pte Ltd" 45 AT 0 WITH
    (WAITUNTIL 30)

§ `Sections 205(9) and 205(10)`

#ASSERT `s 205(9) the auditor appointed under subsection (7) or (8) holds office` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 205(9) the auditor appointed under subsection (7) or (8) holds office` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 205(9) the auditor appointed under subsection (7) or (8) holds office` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 205(10) the Registrar may make the appointment on the application of a member` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 205(10) the Registrar may make the appointment on the application of a member` TRUE FALSE EQUALS NOTHING
#ASSERT `s 205(10) the Registrar may make the appointment on the application of a member` FALSE TRUE EQUALS NOTHING

§ `Section 205(11)`

-- Held office immediately before the meeting: capable, with no nomination at all.
#ASSERT `s 205(11) the accounting entity is capable of being appointed auditor at the annual general meeting` FALSE TRUE FALSE (Date 1 1 2026) (Date 1 4 2026) EQUALS JUST TRUE
-- A member's notice exactly 21 days before the meeting (11 March for a 1 April meeting): capable.
#ASSERT `s 205(11) the accounting entity is capable of being appointed auditor at the annual general meeting` FALSE FALSE TRUE (Date 11 3 2026) (Date 1 4 2026) EQUALS JUST TRUE
-- 20 days before (12 March): not capable.
#ASSERT `s 205(11) the accounting entity is capable of being appointed auditor at the annual general meeting` FALSE FALSE TRUE (Date 12 3 2026) (Date 1 4 2026) EQUALS JUST FALSE
-- Neither held office nor nominated by a member: not capable.
#ASSERT `s 205(11) the accounting entity is capable of being appointed auditor at the annual general meeting` FALSE FALSE FALSE (Date 1 1 2026) (Date 1 4 2026) EQUALS JUST FALSE
-- Subject to subsection (7): where that governs, this subsection does not answer.
#ASSERT `s 205(11) the accounting entity is capable of being appointed auditor at the annual general meeting` TRUE FALSE FALSE (Date 1 1 2026) (Date 1 4 2026) EQUALS NOTHING

§ `Section 205(12)`

-- Not less than 7 days before a meeting on 1 April: the last day is 25 March.
#ASSERT `s 205(12) the last day for the company to send a copy of the notice of nomination` (Date 1 4 2026) EQUALS Date 25 3 2026
#ASSERT `s 205(12) the company is in default of the duty to send a copy of the notice of nomination` TRUE (Date 1 4 2026) TRUE (Date 25 3 2026) (Date 30 3 2026) EQUALS JUST FALSE
#ASSERT `s 205(12) the company is in default of the duty to send a copy of the notice of nomination` TRUE (Date 1 4 2026) TRUE (Date 26 3 2026) (Date 30 3 2026) EQUALS JUST TRUE
#ASSERT `s 205(12) the company is in default of the duty to send a copy of the notice of nomination` TRUE (Date 1 4 2026) FALSE (Date 1 1 2026) (Date 25 3 2026) EQUALS JUST FALSE
#ASSERT `s 205(12) the company is in default of the duty to send a copy of the notice of nomination` TRUE (Date 1 4 2026) FALSE (Date 1 1 2026) (Date 26 3 2026) EQUALS JUST TRUE
#ASSERT `s 205(12) the company is in default of the duty to send a copy of the notice of nomination` FALSE (Date 1 4 2026) FALSE (Date 1 1 2026) (Date 26 3 2026) EQUALS JUST FALSE

-- The trace clock runs from the day the company received the notice (1 March); the meeting is on 1 April, so the last day is 25 March: day 24.
-- EXPECT FULFILLED
#TRACE `s 205(12) the company must send a copy of the notice of nomination` "Acme Pte Ltd" (Date 1 3 2026) (Date 1 4 2026) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205(12) send a copy of the notice of nomination to the accounting entity nominated, to each auditor and to each person entitled to receive notice of general meetings` AT 24

-- EXPECT BREACH
#TRACE `s 205(12) the company must send a copy of the notice of nomination` "Acme Pte Ltd" (Date 1 3 2026) (Date 1 4 2026) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205(12) send a copy of the notice of nomination to the accounting entity nominated, to each auditor and to each person entitled to receive notice of general meetings` AT 25

-- EXPECT BREACH
#TRACE `s 205(12) the company must send a copy of the notice of nomination` "Acme Pte Ltd" (Date 1 3 2026) (Date 1 4 2026) AT 0 WITH
    (WAITUNTIL 25)

§ `Section 205(12A)`

#ASSERT `s 205(12A) the day that stands for the date of the annual general meeting` TRUE TRUE TRUE (Date 1 5 2026) (Date 2 5 2026) EQUALS JUST (Date 1 5 2026)
#ASSERT `s 205(12A) the day that stands for the date of the annual general meeting` TRUE TRUE FALSE (Date 1 5 2026) (Date 2 5 2026) EQUALS JUST (Date 2 5 2026)
#ASSERT `s 205(12A) the day that stands for the date of the annual general meeting` FALSE TRUE TRUE (Date 1 5 2026) (Date 2 5 2026) EQUALS NOTHING
#ASSERT `s 205(12A) the day that stands for the date of the annual general meeting` TRUE FALSE TRUE (Date 1 5 2026) (Date 2 5 2026) EQUALS NOTHING

§ `Section 205(13)`

-- Notice given 1 March; a meeting called for 22 March is 21 days after: (11) does not apply. 23 March is 22 days after: it does.
#ASSERT `s 205(13) subsection (11) does not apply in relation to the accounting entity` TRUE (Date 1 3 2026) (Date 22 3 2026) EQUALS JUST TRUE
#ASSERT `s 205(13) subsection (11) does not apply in relation to the accounting entity` TRUE (Date 1 3 2026) (Date 23 3 2026) EQUALS JUST FALSE
#ASSERT `s 205(13) subsection (11) does not apply in relation to the accounting entity` FALSE (Date 1 3 2026) (Date 22 3 2026) EQUALS JUST FALSE
-- Called for a date 7 days after (8 March) with the copy sent at the time notice of the meeting is given: deemed to have complied; 8 days (9 March): not.
#ASSERT `s 205(13) the company is deemed to have complied with subsection (12)` TRUE (Date 1 3 2026) (Date 8 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 205(13) the company is deemed to have complied with subsection (12)` TRUE (Date 1 3 2026) (Date 9 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 205(13) the company is deemed to have complied with subsection (12)` TRUE (Date 1 3 2026) (Date 8 3 2026) FALSE EQUALS JUST FALSE

§ `Section 205(16)`

#ASSERT `s 205(16) the fees and expenses of the auditor are fixed as the subsection requires` `s 205(16)(a) the company at a general meeting` `s 205(16) fixed by the company in general meeting` FALSE EQUALS JUST TRUE
#ASSERT `s 205(16) the fees and expenses of the auditor are fixed as the subsection requires` `s 205(16)(a) the company at a general meeting` `s 205(16) fixed by the directors` TRUE EQUALS JUST TRUE
#ASSERT `s 205(16) the fees and expenses of the auditor are fixed as the subsection requires` `s 205(16)(a) the company at a general meeting` `s 205(16) fixed by the directors` FALSE EQUALS JUST FALSE
#ASSERT `s 205(16) the fees and expenses of the auditor are fixed as the subsection requires` `s 205(16)(a) the company at a general meeting` `s 205(16) not fixed` TRUE EQUALS JUST FALSE
#ASSERT `s 205(16) the fees and expenses of the auditor are fixed as the subsection requires` `s 205(16)(b) the directors` `s 205(16) fixed by the directors` FALSE EQUALS JUST TRUE
#ASSERT `s 205(16) the fees and expenses of the auditor are fixed as the subsection requires` `s 205(16)(b) the directors` `s 205(16) fixed by the company in general meeting` FALSE EQUALS JUST TRUE
#ASSERT `s 205(16) the fees and expenses of the auditor are fixed as the subsection requires` `s 205(16)(b) the directors` `s 205(16) not fixed` FALSE EQUALS JUST FALSE
#ASSERT `s 205(16) the fees and expenses of the auditor are fixed as the subsection requires` `s 205(16)(b) the Registrar` `s 205(16) fixed by the Registrar` FALSE EQUALS JUST TRUE
#ASSERT `s 205(16) the fees and expenses of the auditor are fixed as the subsection requires` `s 205(16)(b) the Registrar` `s 205(16) fixed by the directors` FALSE EQUALS JUST FALSE

§ `Section 205(17)`

#ASSERT `s 205(17) the person is guilty of the offence` TRUE `s 205(17) the company` EQUALS JUST TRUE
#ASSERT `s 205(17) the person is guilty of the offence` TRUE `s 205(17) a director of the company who is in default` EQUALS JUST TRUE
#ASSERT `s 205(17) the person is guilty of the offence` TRUE `s 205(17) any other person` EQUALS JUST FALSE
#ASSERT `s 205(17) the person is guilty of the offence` FALSE `s 205(17) the company` EQUALS JUST FALSE
#ASSERT `s 205(17) the most the person may be fined on conviction` TRUE `s 205(17) the company` EQUALS JUST 5000
#ASSERT `s 205(17) the most the person may be fined on conviction` TRUE `s 205(17) a director of the company who is in default` EQUALS JUST 5000
#ASSERT `s 205(17) the most the person may be fined on conviction` TRUE `s 205(17) any other person` EQUALS NOTHING
#ASSERT `s 205(17) the most the person may be fined on conviction` FALSE `s 205(17) the company` EQUALS NOTHING
