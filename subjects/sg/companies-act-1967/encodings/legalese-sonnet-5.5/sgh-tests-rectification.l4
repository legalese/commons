IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgh-rectification`

-- Tests for sgh-rectification.l4 (ss 12B to 12D). Every expected value is written from the text of the section, beside the assertion, before the run.

§ `s 12B: rectification by the Court`
-- (test alias a12b1 = `s 12B(1) the Court may by order direct the Registrar to rectify the register`)
#ASSERT `s 12B(1) the Court may by order direct the Registrar to rectify the register` TRUE TRUE EQUALS JUST TRUE   -- "Where it appears to the Court, as a result of evidence adduced before it by an applicant company, that any particular recorded in a register is erroneous or defective, the Court may, by order, direct the Registrar to rectify the register"
#ASSERT `s 12B(1) the Court may by order direct the Registrar to rectify the register` FALSE TRUE EQUALS JUST FALSE   -- no evidence adduced by an applicant company: a failed "Where" (periods ruling (b); split site (ii))
#ASSERT `s 12B(1) the Court may by order direct the Registrar to rectify the register` TRUE FALSE EQUALS JUST FALSE   -- it does not appear to the Court that the particular is erroneous or defective: a failed "Where"
-- (test alias a12b1r = `s 12B(1) the Registrar must rectify the register accordingly`)
#ASSERT `s 12B(1) the Registrar must rectify the register accordingly` TRUE EQUALS JUST TRUE   -- "the Registrar must, upon receipt of the order, rectify the register accordingly"
#ASSERT `s 12B(1) the Registrar must rectify the register accordingly` FALSE EQUALS JUST FALSE   -- no order received: a failed "upon" (counts as "where")
-- (test alias a12b2 = `s 12B(2) the applicant company must file the fresh document with the Registrar together with a copy of the Court order and a copy of the Court application`)
#ASSERT `s 12B(2) the applicant company must file the fresh document with the Registrar together with a copy of the Court order and a copy of the Court application` TRUE EQUALS JUST TRUE   -- "An order ... may require that a fresh document, showing the rectification, must be filed by the applicant company with the Registrar together with a copy of the Court order, and a copy of the Court application": the order so requires
#ASSERT `s 12B(2) the applicant company must file the fresh document with the Registrar together with a copy of the Court order and a copy of the Court application` FALSE EQUALS NOTHING   -- the order does not so require: the text says nothing

§ `s 12C: rectification by the Registrar on an officer's notice`
-- (test alias a12c1 = `s 12C(1) the officer of the company may notify the Registrar of the error`)
-- arguments: an officer of the company; the error is contained in a document relating to the company filed or lodged; the error is in the filing or lodgment; the notification is in the prescribed form
#ASSERT `s 12C(1) the officer of the company may notify the Registrar of the error` TRUE TRUE FALSE TRUE EQUALS JUST TRUE   -- "(a) any error contained in any document relating to the company filed or lodged with the Registrar"
#ASSERT `s 12C(1) the officer of the company may notify the Registrar of the error` TRUE FALSE TRUE TRUE EQUALS JUST TRUE   -- "(b) any error in the filing or lodgment of any document relating to the company with the Registrar"
#ASSERT `s 12C(1) the officer of the company may notify the Registrar of the error` FALSE TRUE FALSE TRUE EQUALS NOTHING   -- not an officer of the company: the text says nothing
#ASSERT `s 12C(1) the officer of the company may notify the Registrar of the error` TRUE FALSE FALSE TRUE EQUALS NOTHING   -- neither kind of error
#ASSERT `s 12C(1) the officer of the company may notify the Registrar of the error` TRUE TRUE FALSE FALSE EQUALS NOTHING   -- not in the prescribed form: the text says nothing
-- (test alias a12c2 = `s 12C(2) the Registrar may rectify the register accordingly`)
-- arguments: notification received; (1)(a) error and satisfied it is typographical or clerical; (1)(b) error and satisfied it is unintended and prejudices no one
#ASSERT `s 12C(2) the Registrar may rectify the register accordingly` TRUE TRUE FALSE EQUALS JUST TRUE   -- "(a) the error referred to in subsection (1)(a) is typographical or clerical in nature"
#ASSERT `s 12C(2) the Registrar may rectify the register accordingly` TRUE FALSE TRUE EQUALS JUST TRUE   -- "(b) the error referred to in subsection (1)(b) is, in the Registrar's opinion, unintended and does not prejudice any person"
#ASSERT `s 12C(2) the Registrar may rectify the register accordingly` TRUE FALSE FALSE EQUALS NOTHING   -- notification received but the Registrar is not satisfied: a failed "if" gating a grant (grant ruling, limit 1)
#ASSERT `s 12C(2) the Registrar may rectify the register accordingly` FALSE TRUE TRUE EQUALS JUST FALSE   -- no notification received: a failed "upon receipt" (counts as "where"; split site (ii))
-- (test alias a12c3 = `s 12C(3) the Registrar is barred from expunging a document from the register`)
#ASSERT `s 12C(3) the Registrar is barred from expunging a document from the register` TRUE EQUALS JUST TRUE   -- "In rectifying the register under subsection (2), the Registrar must not expunge any document from the register"
#ASSERT `s 12C(3) the Registrar is barred from expunging a document from the register` FALSE EQUALS NOTHING   -- a rectification not under subsection (2): the text says nothing
-- (test alias a12c4 = `s 12C(4) the Registrar's decision on whether to rectify the register is final`)
#ASSERT `s 12C(4) the Registrar's decision on whether to rectify the register is final` TRUE EQUALS JUST TRUE   -- "The decision made by the Registrar on whether to rectify the register under subsection (2) is final"
#ASSERT `s 12C(4) the Registrar's decision on whether to rectify the register is final` FALSE EQUALS NOTHING   -- another decision: the text says nothing

§ `s 12D(1) and (1A)`
-- (test alias a12d1 = `s 12D(1) the Registrar may rectify or update the particulars or document in the register`)
#ASSERT `s 12D(1) the Registrar may rectify or update the particulars or document in the register` TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- "(a) there is a defect or error in the particulars or document arising from any grammatical, typographical or similar mistake"
#ASSERT `s 12D(1) the Registrar may rectify or update the particulars or document in the register` FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- "(aa) the register is inaccurate in respect of the particulars or document, taking account of information given in ... a notice under section 173A(1) or 173E(1), (2) or (3)"
#ASSERT `s 12D(1) the Registrar may rectify or update the particulars or document in the register` FALSE FALSE TRUE FALSE EQUALS JUST TRUE   -- "(b)(i) other information in the register relating to that company or person"
#ASSERT `s 12D(1) the Registrar may rectify or update the particulars or document in the register` FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- "(b)(ii) other information ... obtained from such department or Ministry of the Government, or statutory body or other body corporate as may be prescribed, or the courts"
#ASSERT `s 12D(1) the Registrar may rectify or update the particulars or document in the register` FALSE FALSE FALSE FALSE EQUALS NOTHING   -- the Registrar is not satisfied of any: a failed "if" gating a grant (grant ruling, limit 1)
-- (test alias a12d1a = `s 12D(1A) subsections (2) to (5) apply to the rectification or updating`)
#ASSERT `s 12D(1A) subsections (2) to (5) apply to the rectification or updating` TRUE EQUALS JUST FALSE   -- "Subsections (2) to (5) do not apply where the Registrar rectifies or updates the register under subsection (1)(aa)"
#ASSERT `s 12D(1A) subsections (2) to (5) apply to the rectification or updating` FALSE EQUALS NOTHING   -- a rectification under (1)(a) or (b): subsections (2) to (5) apply by their own terms; this subsection does not speak

§ `s 12D(2) to (7)`
-- (test alias a12d2 = `s 12D(2) the Registrar must give written notice to the company or person before rectifying or updating the register`)
-- arguments: under subsection (1)(a) or (b); under subsection (1)(aa); prescribed circumstances in which notice need not be given
#ASSERT `s 12D(2) the Registrar must give written notice to the company or person before rectifying or updating the register` TRUE FALSE FALSE EQUALS JUST TRUE   -- "the Registrar must, except under prescribed circumstances, give written notice to the company or person whose documents or particulars are to be rectified or updated"
#ASSERT `s 12D(2) the Registrar must give written notice to the company or person before rectifying or updating the register` TRUE FALSE TRUE EQUALS JUST FALSE   -- "except under prescribed circumstances"
#ASSERT `s 12D(2) the Registrar must give written notice to the company or person before rectifying or updating the register` FALSE TRUE FALSE EQUALS JUST FALSE   -- (1A): subsections (2) to (5) do not apply to a rectification under (1)(aa)
#ASSERT `s 12D(2) the Registrar must give written notice to the company or person before rectifying or updating the register` FALSE FALSE FALSE EQUALS NOTHING   -- not a rectification or updating under subsection (1): the text says nothing
-- (test alias a12d2b = `s 12D(2)(b) the earliest date that may be stated for delivering a written objection`)
#ASSERT `s 12D(2)(b) the earliest date that may be stated for delivering a written objection` (Date 1 3 2025) EQUALS Date 31 3 2025   -- "at least 30 days after the date of the notice": 1 March plus 30 days is 31 March
#ASSERT `s 12D(2)(b) the earliest date that may be stated for delivering a written objection` (Date 31 1 2025) EQUALS Date 2 3 2025   -- 31 January plus 30 days is 2 March (28 days in February 2025)
-- (test alias a12d2n = `s 12D(2) the notice has the content and form the subsection requires`)
-- arguments: in writing; states reasons and details; states a date for objections; the date of the notice; the date stated for objections
#ASSERT `s 12D(2) the notice has the content and form the subsection requires` TRUE TRUE TRUE (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST TRUE   -- exactly 30 days after: "a date at least 30 days after the date of the notice"
#ASSERT `s 12D(2) the notice has the content and form the subsection requires` TRUE TRUE TRUE (Date 1 3 2025) (Date 30 3 2025) EQUALS JUST FALSE   -- 29 days after: fewer than 30
#ASSERT `s 12D(2) the notice has the content and form the subsection requires` TRUE TRUE TRUE (Date 1 3 2025) (Date 15 4 2025) EQUALS JUST TRUE   -- more than 30 days after
#ASSERT `s 12D(2) the notice has the content and form the subsection requires` FALSE TRUE TRUE (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST FALSE   -- not in writing: "give written notice"
#ASSERT `s 12D(2) the notice has the content and form the subsection requires` TRUE FALSE TRUE (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST FALSE   -- the notice does not state the reasons and details
#ASSERT `s 12D(2) the notice has the content and form the subsection requires` TRUE TRUE FALSE (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST FALSE   -- the notice states no date for objections
-- (test alias a12d3 = `s 12D(3) the company or person may deliver a written objection to the proposed rectification or updating`)
-- arguments: notified under (2); the date the objection is delivered; the date specified under (2)(b)
#ASSERT `s 12D(3) the company or person may deliver a written objection to the proposed rectification or updating` TRUE (Date 31 3 2025) (Date 31 3 2025) EQUALS JUST TRUE   -- "not later than the date specified": delivered on the date specified
#ASSERT `s 12D(3) the company or person may deliver a written objection to the proposed rectification or updating` TRUE (Date 20 3 2025) (Date 31 3 2025) EQUALS JUST TRUE   -- delivered before it
#ASSERT `s 12D(3) the company or person may deliver a written objection to the proposed rectification or updating` TRUE (Date 1 4 2025) (Date 31 3 2025) EQUALS JUST FALSE   -- one day late: a period the text fixes in its own words (periods ruling (a))
#ASSERT `s 12D(3) the company or person may deliver a written objection to the proposed rectification or updating` FALSE (Date 20 3 2025) (Date 31 3 2025) EQUALS NOTHING   -- a company or person not notified under (2): the text says nothing
-- (test alias a12d4 = `s 12D(4) the Registrar is barred from rectifying or updating the register`)
-- arguments: objection received under (3) by the date specified; satisfied the objection is frivolous or vexatious; the objection has been withdrawn
#ASSERT `s 12D(4) the Registrar is barred from rectifying or updating the register` TRUE FALSE FALSE EQUALS JUST TRUE   -- "The Registrar must not rectify or update the register if the Registrar receives a written objection under subsection (3) ... by the date specified"
#ASSERT `s 12D(4) the Registrar is barred from rectifying or updating the register` TRUE TRUE FALSE EQUALS JUST FALSE   -- "unless the Registrar is satisfied that the objection is frivolous or vexatious"
#ASSERT `s 12D(4) the Registrar is barred from rectifying or updating the register` TRUE FALSE TRUE EQUALS JUST FALSE   -- "or has been withdrawn"
#ASSERT `s 12D(4) the Registrar is barred from rectifying or updating the register` FALSE FALSE FALSE EQUALS JUST FALSE   -- no objection received by the date: the bar does not arise (a failed "if" of a bar; marginal reading (a))
-- (test alias a12d5 = `s 12D(5) the Registrar may rectify or update the register`)
#ASSERT `s 12D(5) the Registrar may rectify or update the register` TRUE EQUALS JUST TRUE   -- "The Registrar may rectify or update the register if the Registrar does not receive a written objection under subsection (3) by the date specified"
#ASSERT `s 12D(5) the Registrar may rectify or update the register` FALSE EQUALS NOTHING   -- an objection was received: a failed "if" gating a grant (grant ruling, limit 1); subsection (4) governs
-- (test alias a12d6a = `s 12D(6) the Registrar may include the notation on the register`)
#ASSERT `s 12D(6) the Registrar may include the notation on the register` TRUE EQUALS JUST TRUE   -- "may include such notation as the Registrar thinks fit on the register for the purposes of providing information relating to any error, defect or inaccuracy"
#ASSERT `s 12D(6) the Registrar may include the notation on the register` FALSE EQUALS NOTHING   -- a notation for another purpose: the text says nothing
-- (test alias a12d6b = `s 12D(6) the Registrar may remove the notation`)
#ASSERT `s 12D(6) the Registrar may remove the notation` TRUE EQUALS JUST TRUE   -- "may remove such notation if the Registrar is satisfied that it no longer serves any useful purpose"
#ASSERT `s 12D(6) the Registrar may remove the notation` FALSE EQUALS NOTHING   -- not satisfied: a failed "if" gating a grant
-- (test alias a12d7 = `s 12D(7) the Registrar may by written notice request the company or its officers to take steps within a time the Registrar specifies`)
#ASSERT `s 12D(7) the Registrar may by written notice request the company or its officers to take steps within a time the Registrar specifies` TRUE EQUALS JUST TRUE   -- "Despite anything in this section, the Registrar may, if the Registrar is satisfied that there is any error, defect or inaccuracy ..., by written notice, request"
#ASSERT `s 12D(7) the Registrar may by written notice request the company or its officers to take steps within a time the Registrar specifies` FALSE EQUALS NOTHING   -- not satisfied: a failed "if" gating a grant

§ `Regulative rules of ss 12B to 12D`
-- EXPECT BREACH
#TRACE `s 12C(3) the Registrar must not expunge any document from the register` AT 0 WITH
    PARTY Registrar DOES `s 12C(3) expunge a document from the register in rectifying it under subsection (2)` AT 4
-- EXPECT RESIDUAL
#TRACE `s 12C(3) the Registrar must not expunge any document from the register` AT 0 WITH
-- EXPECT BREACH
#TRACE `s 12D(4) the Registrar must not rectify or update the register despite a written objection` AT 0 WITH
    PARTY Registrar DOES `s 12D(4) rectify or update the register despite a written objection under subsection (3)` AT 10
-- EXPECT RESIDUAL
#TRACE `s 12D(4) the Registrar must not rectify or update the register despite a written objection` AT 0 WITH
-- no time limit and no stated consequence: a late act still reads FULFILLED, and no act reads RESIDUAL (no breach path)
-- EXPECT FULFILLED
#TRACE `s 12B(1) the Registrar must rectify the register on receipt of the order` AT 0 WITH
    PARTY Registrar DOES `s 12B(1) rectify the register on receipt of the Court's order` AT 900
-- EXPECT RESIDUAL
#TRACE `s 12B(1) the Registrar must rectify the register on receipt of the order` AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 12B(2) the applicant company must file the fresh document` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 12B(2) file the fresh document with a copy of the Court order and a copy of the Court application` AT 900
-- EXPECT RESIDUAL
#TRACE `s 12B(2) the applicant company must file the fresh document` "Acme Pte Ltd" AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 12D(2) the Registrar must give written notice before rectifying or updating the register` AT 0 WITH
    PARTY Registrar DOES `s 12D(2) give written notice of the intention to rectify or update the register` AT 900
-- EXPECT RESIDUAL
#TRACE `s 12D(2) the Registrar must give written notice before rectifying or updating the register` AT 0 WITH
