IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgk-part9-declared`
IMPORT `sgk-part9-inspectors`

-- Tests for ss 232 to 236. Every expected value is written from the text of the section, beside the assertion.

§ `Section 232`

-- (1)(a)(i): "not less than 200 members (excluding the company itself if it is registered as a member) or of members holding not less than 10% of the shares issued (excluding treasury shares)".
#ASSERT `s 232(1)(a)(i) the application is made by enough members` 200 0 1000 EQUALS TRUE      -- 200 members is "not less than 200"
#ASSERT `s 232(1)(a)(i) the application is made by enough members` 199 0 1000 EQUALS FALSE     -- 199 members, no shares
#ASSERT `s 232(1)(a)(i) the application is made by enough members` 1 100 1000 EQUALS TRUE      -- 100 of 1,000 shares is exactly 10%
#ASSERT `s 232(1)(a)(i) the application is made by enough members` 1 99 1000 EQUALS FALSE      -- 99 of 1,000 shares is under 10%
#ASSERT `s 232(1)(a)(i) the application is made by enough members` 1 101 1000 EQUALS TRUE
#ASSERT `s 232(1)(a)(i) the application is made by enough members` 0 0 0 EQUALS FALSE          -- no shares issued: no percentage to reach
#ASSERT `s 232(1)(a)(i) the application is made by enough members` 199 100 1000 EQUALS TRUE    -- either limb suffices ("or")
-- (1)(a)(ii): "holders of debentures holding not less than 20% in nominal value of debentures issued".
#ASSERT `s 232(1)(a)(ii) the application is made by enough debenture holders` 200 1000 EQUALS TRUE      -- exactly 20%
#ASSERT `s 232(1)(a)(ii) the application is made by enough debenture holders` 199 1000 EQUALS FALSE     -- just under 20%
#ASSERT `s 232(1)(a)(ii) the application is made by enough debenture holders` 1000 1000 EQUALS TRUE
#ASSERT `s 232(1)(a)(ii) the application is made by enough debenture holders` 0 0 EQUALS FALSE          -- no debentures issued
-- (1)(b): "not less than 20% in number of the persons on the company's register of members".
#ASSERT `s 232(1)(b) the application is made by enough of the persons on the register of members` 10 50 EQUALS TRUE      -- 10 of 50 is exactly 20%
#ASSERT `s 232(1)(b) the application is made by enough of the persons on the register of members` 9 50 EQUALS FALSE      -- 9 of 50 is under 20%
#ASSERT `s 232(1)(b) the application is made by enough of the persons on the register of members` 1 5 EQUALS TRUE        -- 1 of 5 is exactly 20%
#ASSERT `s 232(1)(b) the application is made by enough of the persons on the register of members` 0 0 EQUALS FALSE        -- an empty register
-- (1): the Minister "may appoint" on an application of one of the three kinds. Arguments: has a share capital; members who apply; shares they hold; shares issued; debenture nominal value held; debentures issued; persons who apply; persons on the register; special resolution.
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` TRUE 200 0 1000 0 0 0 0 FALSE EQUALS JUST TRUE       -- (a)(i), 200 members
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` TRUE 199 0 1000 0 0 0 0 FALSE EQUALS NOTHING
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` TRUE 1 100 1000 0 0 0 0 FALSE EQUALS JUST TRUE     -- (a)(i), 10%
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` TRUE 1 99 1000 0 0 0 0 FALSE EQUALS NOTHING
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` TRUE 0 0 0 200 1000 0 0 FALSE EQUALS JUST TRUE       -- (a)(ii), 20% of the debentures
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` TRUE 0 0 0 199 1000 0 0 FALSE EQUALS NOTHING
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` FALSE 0 0 0 0 0 10 50 FALSE EQUALS JUST TRUE         -- (b), 20% of the persons
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` FALSE 0 0 0 0 0 9 50 FALSE EQUALS NOTHING
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` FALSE 200 0 1000 0 0 0 0 FALSE EQUALS NOTHING        -- (a) is only for a company having a share capital
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` TRUE 0 0 0 0 0 10 50 FALSE EQUALS NOTHING             -- (b) is only for a company not having one
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` TRUE 0 0 0 0 0 0 0 TRUE EQUALS JUST TRUE              -- (c) "in any case", on a special resolution
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` FALSE 0 0 0 0 0 0 0 TRUE EQUALS JUST TRUE
#ASSERT `s 232(1) the Minister may appoint inspectors on the application` FALSE 0 0 0 0 0 0 0 FALSE EQUALS NOTHING
-- (2): "such evidence as the Minister requires"; "the Minister may before appointing an inspector require ... security".
#ASSERT `s 232(2) the application must be supported by the evidence the Minister requires` TRUE EQUALS JUST TRUE
#ASSERT `s 232(2) the application must be supported by the evidence the Minister requires` FALSE EQUALS JUST FALSE
#ASSERT `s 232(2) the Minister may require the applicants to give security for the cost of the investigation` TRUE EQUALS JUST TRUE
#ASSERT `s 232(2) the Minister may require the applicants to give security for the cost of the investigation` FALSE EQUALS JUST FALSE       -- after appointing an inspector the power has gone

§ `Section 233`

-- (1): interim reports "may, and if so directed by the Minister must".
#ASSERT `s 233(1) the inspector may make interim reports to the Minister` TRUE EQUALS JUST TRUE
#ASSERT `s 233(1) the inspector may make interim reports to the Minister` FALSE EQUALS NOTHING
#ASSERT `s 233(1) the inspector must make an interim report to the Minister` TRUE EQUALS JUST TRUE
#ASSERT `s 233(1) the inspector must make an interim report to the Minister` FALSE EQUALS JUST FALSE
-- (1): "a copy of the report must, subject to subsection (1B), be forwarded by the Minister to the registered office". Arguments: the investigation has concluded; the Minister is of the opinion under (1B).
#ASSERT `s 233(1) the Minister must forward a copy of the report to the registered office of the company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 233(1) the Minister must forward a copy of the report to the registered office of the company` TRUE TRUE EQUALS JUST FALSE        -- (1B): not bound
#ASSERT `s 233(1) the Minister must forward a copy of the report to the registered office of the company` FALSE FALSE EQUALS JUST FALSE      -- no report yet
#ASSERT `s 233(1) the Minister must forward a copy of the report to the registered office of the company` FALSE TRUE EQUALS JUST FALSE
-- (1): "a further copy must, subject to that subsection, at the request of the applicants be delivered to them". Arguments: concluded; requested; (1B) opinion.
#ASSERT `s 233(1) the Minister must deliver a further copy of the report to the applicants` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 233(1) the Minister must deliver a further copy of the report to the applicants` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 233(1) the Minister must deliver a further copy of the report to the applicants` TRUE FALSE FALSE EQUALS JUST FALSE      -- no request
#ASSERT `s 233(1) the Minister must deliver a further copy of the report to the applicants` FALSE TRUE FALSE EQUALS JUST FALSE      -- no report yet
-- (1A) to (1D). Arguments of (1A): in the Minister's opinion the report relates to the person to a material extent; (1B) opinion; belief that legal proceedings might be unduly prejudiced; a court has ordered that a copy be given.
#ASSERT `s 233(1A) the Minister must give the person a copy of the report` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 233(1A) the Minister must give the person a copy of the report` FALSE FALSE FALSE FALSE EQUALS JUST FALSE      -- the report does not materially relate to the person
#ASSERT `s 233(1A) the Minister must give the person a copy of the report` TRUE TRUE FALSE FALSE EQUALS JUST FALSE        -- subject to (1B)
#ASSERT `s 233(1A) the Minister must give the person a copy of the report` TRUE FALSE TRUE FALSE EQUALS JUST FALSE        -- subject to (1C)
#ASSERT `s 233(1A) the Minister must give the person a copy of the report` TRUE TRUE TRUE TRUE EQUALS JUST TRUE           -- (1C) is "Subject to subsection (1D)": the court's order
#ASSERT `s 233(1A) the Minister must give the person a copy of the report` FALSE FALSE FALSE TRUE EQUALS JUST TRUE        -- (1D): the court "may order that a copy ... must be given to that person"
#ASSERT `s 233(1C) the Minister must not give the person a copy of the report under subsection (1A)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 233(1C) the Minister must not give the person a copy of the report under subsection (1A)` TRUE TRUE EQUALS JUST FALSE     -- "Subject to subsection (1D)"
#ASSERT `s 233(1C) the Minister must not give the person a copy of the report under subsection (1A)` FALSE FALSE EQUALS JUST FALSE    -- no belief
#ASSERT `s 233(1C) the Minister must not give the person a copy of the report under subsection (1A)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 233(1D) the court may order that a copy of the report or part of it be given to the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 233(1D) the court may order that a copy of the report or part of it be given to the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 233(1D) the court may order that a copy of the report or part of it be given to the person` FALSE TRUE EQUALS NOTHING
-- (2): "may, if ... in the public interest ... but must refrain ... if the Attorney-General has certified". Arguments: public interest opinion; the certificate.
#ASSERT `s 233(2) the Minister may cause the report to be printed and published` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 233(2) the Minister may cause the report to be printed and published` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 233(2) the Minister may cause the report to be printed and published` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 233(2) the Minister may cause the report to be printed and published` FALSE FALSE EQUALS NOTHING
-- (3): the prosecution and the assistance. Arguments of the assistance: an officer or agent of the company; the defendant; required by the Minister; reasonably able.
#ASSERT `s 233(3) the Minister must cause a prosecution to be instituted` TRUE EQUALS JUST TRUE
#ASSERT `s 233(3) the Minister must cause a prosecution to be instituted` FALSE EQUALS JUST FALSE
#ASSERT `s 233(3) the officer or agent must give the Minister all assistance in connection with the prosecution` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 233(3) the officer or agent must give the Minister all assistance in connection with the prosecution` TRUE TRUE TRUE TRUE EQUALS JUST FALSE       -- "other than the defendant in the proceedings"
#ASSERT `s 233(3) the officer or agent must give the Minister all assistance in connection with the prosecution` TRUE FALSE FALSE TRUE EQUALS JUST FALSE      -- "on being required by the Minister"
#ASSERT `s 233(3) the officer or agent must give the Minister all assistance in connection with the prosecution` TRUE FALSE TRUE FALSE EQUALS JUST FALSE      -- "which they are reasonably able to give"
#ASSERT `s 233(3) the officer or agent must give the Minister all assistance in connection with the prosecution` FALSE FALSE TRUE TRUE EQUALS NOTHING        -- the duty is stated for "all officers and agents of the company"
-- (4): the Minister may bring proceedings in the company's name.
#ASSERT `s 233(4) the Minister may bring proceedings in the name of the company` TRUE EQUALS JUST TRUE
#ASSERT `s 233(4) the Minister may bring proceedings in the name of the company` FALSE EQUALS NOTHING
-- The rules. (1), (1A), (3) state no time: the s 52 input (the period of all convenient speed, as found) sets the time. (1C) and (2) are prohibitions: the act is the breach.
-- EXPECT RESIDUAL
#TRACE `s 233(1) the inspector must report to the Minister on the conclusion of the investigation` 7 AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 233(1) the inspector must report to the Minister on the conclusion of the investigation` 45 AT 0 WITH
    PARTY `s 231 an inspector appointed under Part 9` DOES `s 233(1) report to the Minister the inspector's opinion on the affairs investigated, with the facts on which it is based` AT 30

-- late: the act is done on day 400, past the 7 days the input is, so BREACH
-- EXPECT BREACH
#TRACE `s 233(1) the inspector must report to the Minister on the conclusion of the investigation` 7 AT 0 WITH
    PARTY `s 231 an inspector appointed under Part 9` DOES `s 233(1) report to the Minister the inspector's opinion on the affairs investigated, with the facts on which it is based` AT 400

-- EXPECT RESIDUAL
#TRACE `s 233(1) the Minister must forward a copy of the report to the registered office` 45 AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 233(1) the Minister must forward a copy of the report to the registered office` 7 AT 0 WITH
    PARTY `s 231 the Minister` DOES `s 233(1) forward a copy of the report to the registered office of the company` AT 2

-- late: the act is done on day 400, past the 7 days the input is, so BREACH
-- EXPECT BREACH
#TRACE `s 233(1) the Minister must forward a copy of the report to the registered office` 7 AT 0 WITH
    PARTY `s 231 the Minister` DOES `s 233(1) forward a copy of the report to the registered office of the company` AT 400

-- EXPECT RESIDUAL
#TRACE `s 233(1A) the Minister must give a copy of the report to the person whose affairs it relates to` 45 AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 233(1A) the Minister must give a copy of the report to the person whose affairs it relates to` 7 AT 0 WITH
    PARTY `s 231 the Minister` DOES `s 233(1A) give a copy of the report to a person whose affairs it relates to in a material extent` AT 2

-- late: the act is done on day 400, past the 7 days the input is, so BREACH
-- EXPECT BREACH
#TRACE `s 233(1A) the Minister must give a copy of the report to the person whose affairs it relates to` 7 AT 0 WITH
    PARTY `s 231 the Minister` DOES `s 233(1A) give a copy of the report to a person whose affairs it relates to in a material extent` AT 400

-- EXPECT RESIDUAL
#TRACE `s 233(1C) the Minister must not give a copy of the report where legal proceedings might be unduly prejudiced` AT 0 WITH
-- EXPECT BREACH
#TRACE `s 233(1C) the Minister must not give a copy of the report where legal proceedings might be unduly prejudiced` AT 0 WITH
    PARTY `s 231 the Minister` DOES `s 233(1C) give a copy of the report to a person when legal proceedings might be unduly prejudiced` AT 3
-- EXPECT RESIDUAL
#TRACE `s 233(2) the Minister must refrain from publishing the report when the Attorney-General has certified that publication would be prejudicial` AT 0 WITH
-- EXPECT BREACH
#TRACE `s 233(2) the Minister must refrain from publishing the report when the Attorney-General has certified that publication would be prejudicial` AT 0 WITH
    PARTY `s 231 the Minister` DOES `s 233(2) publish the report when the Attorney-General has certified that publication would be prejudicial to the administration of justice` AT 3
-- EXPECT RESIDUAL
#TRACE `s 233(3) the Minister must cause a prosecution to be instituted` 45 AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 233(3) the Minister must cause a prosecution to be instituted` 45 AT 0 WITH
    PARTY `s 231 the Minister` DOES `s 233(3) institute a prosecution` AT 40

-- late: the act is done on day 400, past the 7 days the input is, so BREACH
-- EXPECT BREACH
#TRACE `s 233(3) the Minister must cause a prosecution to be instituted` 7 AT 0 WITH
    PARTY `s 231 the Minister` DOES `s 233(3) institute a prosecution` AT 400

-- EXPECT RESIDUAL
#TRACE `s 233(3) the officer or agent must give the assistance on being required by the Minister` "A. Tan" AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 233(3) the officer or agent must give the assistance on being required by the Minister` "A. Tan" AT 0 WITH
    PARTY `s 231 an officer or agent of a corporation` "A. Tan" DOES `s 233(3) give the Minister all assistance in connection with the prosecution that the person is reasonably able to give` AT 6

§ `Section 234`

-- Section 234 reads "[Repealed by Act 13 of 1987]": nothing to encode and nothing to test; the coverage table in NOTES.md records it.

§ `Section 235`

-- "the inspector may, with the consent in writing of the Minister, investigate the affairs of that corporation" where the inspector thinks it necessary and the corporation is, or has been, deemed related by section 6. Arguments: thinks it necessary; related; consent.
#ASSERT `s 235 the inspector may investigate the affairs of the other corporation` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 235 the inspector may investigate the affairs of the other corporation` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 235 the inspector may investigate the affairs of the other corporation` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 235 the inspector may investigate the affairs of the other corporation` TRUE TRUE FALSE EQUALS NOTHING      -- without the Minister's consent in writing

§ `Section 236`

-- (1): "the inspector has power to do so, and the inspector must report on the affairs of the other corporation".
#ASSERT `s 236(1) the inspector has power to investigate also the affairs of the other corporation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236(1) the inspector has power to investigate also the affairs of the other corporation` TRUE FALSE EQUALS NOTHING
#ASSERT `s 236(1) the inspector has power to investigate also the affairs of the other corporation` FALSE TRUE EQUALS NOTHING
#ASSERT `s 236(1) the inspector must report on the affairs of the other corporation so far as the inspector thinks the results of the investigation relevant` TRUE EQUALS JUST TRUE
#ASSERT `s 236(1) the inspector must report on the affairs of the other corporation so far as the inspector thinks the results of the investigation relevant` FALSE EQUALS JUST FALSE
-- EXPECT RESIDUAL
#TRACE `s 236(1) the inspector must report on the affairs of the related corporation` 7 AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 236(1) the inspector must report on the affairs of the related corporation` 45 AT 0 WITH
    PARTY `s 231 an inspector appointed under Part 9` DOES `s 236(1) report on the affairs of the related corporation` AT 20

-- late: the act is done on day 400, past the 7 days the input is, so BREACH
-- EXPECT BREACH
#TRACE `s 236(1) the inspector must report on the affairs of the related corporation` 7 AT 0 WITH
    PARTY `s 231 an inspector appointed under Part 9` DOES `s 236(1) report on the affairs of the related corporation` AT 400

-- (2): "must, if required by an inspector ..., produce ... and must give ... all assistance ... which he or she is reasonably able to give". Arguments: an officer or agent of a corporation being investigated; required by an inspector.
#ASSERT `s 236(2) the officer or agent must produce to the inspector all books and documents in the officer's or agent's custody or power` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236(2) the officer or agent must produce to the inspector all books and documents in the officer's or agent's custody or power` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 236(2) the officer or agent must produce to the inspector all books and documents in the officer's or agent's custody or power` FALSE TRUE EQUALS NOTHING
#ASSERT `s 236(2) the officer or agent must give the inspector all assistance in connection with the investigation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236(2) the officer or agent must give the inspector all assistance in connection with the investigation` TRUE FALSE EQUALS JUST FALSE      -- beyond what the person is reasonably able to give
#ASSERT `s 236(2) the officer or agent must give the inspector all assistance in connection with the investigation` FALSE TRUE EQUALS NOTHING
-- EXPECT RESIDUAL
#TRACE `s 236(2) the officer or agent must produce the books and documents and give the assistance` "A. Tan" 45 AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 236(2) the officer or agent must produce the books and documents and give the assistance` "A. Tan" 7 AT 0 WITH
    PARTY `s 231 an officer or agent of a corporation` "A. Tan" DOES `s 236(2) produce to the inspector all books and documents in the person's custody or power and give all assistance reasonably able` AT 7

-- late: the act is done on day 400, past the 7 days the input is, so BREACH
-- EXPECT BREACH
#TRACE `s 236(2) the officer or agent must produce the books and documents and give the assistance` "A. Tan" 7 AT 0 WITH
    PARTY `s 231 an officer or agent of a corporation` "A. Tan" DOES `s 236(2) produce to the inspector all books and documents in the person's custody or power and give all assistance reasonably able` AT 400

-- (3): the notice in the prescribed form.
#ASSERT `s 236(3) the inspector may require the person to appear for examination on oath or affirmation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236(3) the inspector may require the person to appear for examination on oath or affirmation` TRUE FALSE EQUALS NOTHING
#ASSERT `s 236(3) the inspector may require the person to appear for examination on oath or affirmation` FALSE TRUE EQUALS NOTHING
-- (4): (a) take possession; (b) retain "for such time as the inspector considers to be necessary"; (c) "must permit such corporation to have access at all reasonable times ... so long as they are in his or her possession".
#ASSERT `s 236(4)(a) the inspector may take possession of all the books and documents` TRUE EQUALS JUST TRUE
#ASSERT `s 236(4)(a) the inspector may take possession of all the books and documents` FALSE EQUALS NOTHING
#ASSERT `s 236(4)(b) the inspector may retain the books and documents for the time` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236(4)(b) the inspector may retain the books and documents for the time` TRUE FALSE EQUALS NOTHING
#ASSERT `s 236(4)(b) the inspector may retain the books and documents for the time` FALSE TRUE EQUALS NOTHING
#ASSERT `s 236(4)(c) the inspector must permit the corporation to have access to the books and documents` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236(4)(c) the inspector must permit the corporation to have access to the books and documents` TRUE FALSE TRUE EQUALS JUST FALSE      -- no longer in the inspector's possession
#ASSERT `s 236(4)(c) the inspector must permit the corporation to have access to the books and documents` TRUE TRUE FALSE EQUALS JUST FALSE      -- not at a reasonable time
#ASSERT `s 236(4)(c) the inspector must permit the corporation to have access to the books and documents` FALSE TRUE TRUE EQUALS NOTHING
-- EXPECT RESIDUAL
#TRACE `s 236(4)(c) the inspector must permit the corporation to have access to the books and documents` AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 236(4)(c) the inspector must permit the corporation to have access to the books and documents` AT 0 WITH
    PARTY `s 231 an inspector appointed under Part 9` DOES `s 236(4)(c) permit the corporation to have access to the books and documents taken possession of` AT 4
-- (4A): a director or past director; reasonable grounds as to the account; reasonable grounds as to the money. Arguments in that order.
#ASSERT `s 236(4A) the inspector may require the person to produce all documents in the person's possession or under the person's control relating to the bank account` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236(4A) the inspector may require the person to produce all documents in the person's possession or under the person's control relating to the bank account` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 236(4A) the inspector may require the person to produce all documents in the person's possession or under the person's control relating to the bank account` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 236(4A) the inspector may require the person to produce all documents in the person's possession or under the person's control relating to the bank account` TRUE TRUE FALSE EQUALS NOTHING
-- (5): the three failures; the Court "may thereupon inquire ... and, after hearing ... punish". Arguments of the Court's power: certified under the hand of the inspector; inquired and heard.
#ASSERT `s 236(5) the inspector may certify the failure or refusal to the Court` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 236(5) the inspector may certify the failure or refusal to the Court` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 236(5) the inspector may certify the failure or refusal to the Court` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 236(5) the inspector may certify the failure or refusal to the Court` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 236(5) the Court may punish the offender in like manner as if the offender had been guilty of contempt of the Court` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236(5) the Court may punish the offender in like manner as if the offender had been guilty of contempt of the Court` TRUE FALSE EQUALS JUST FALSE      -- before the Court has inquired and heard
#ASSERT `s 236(5) the Court may punish the offender in like manner as if the offender had been guilty of contempt of the Court` FALSE TRUE EQUALS JUST FALSE      -- nothing certified
-- (6): no entitlement to refuse for a present or former officer or agent as to a relevant or material question; the answer "may not be used in any subsequent criminal proceedings except ... a charge ... for making a false statement".
#ASSERT `s 236(6) the person is entitled to refuse to answer the question on the ground that the answer might tend to incriminate the person` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 236(6) the person is entitled to refuse to answer the question on the ground that the answer might tend to incriminate the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 236(6) the person is entitled to refuse to answer the question on the ground that the answer might tend to incriminate the person` FALSE TRUE EQUALS NOTHING
-- Arguments of the bar: officer or agent; relevant; claims it might incriminate; but for (6) would have been entitled; the proceeding is a charge of making a false statement.
#ASSERT `s 236(6) the answer is barred from use in a subsequent criminal proceeding` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 236(6) the answer is barred from use in a subsequent criminal proceeding` TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE      -- the charge of making a false statement in answer to that question
#ASSERT `s 236(6) the answer is barred from use in a subsequent criminal proceeding` TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING     -- no claim made
#ASSERT `s 236(6) the answer is barred from use in a subsequent criminal proceeding` TRUE TRUE TRUE FALSE FALSE EQUALS NOTHING     -- the person would not have been entitled to refuse anyway
#ASSERT `s 236(6) the answer is barred from use in a subsequent criminal proceeding` FALSE TRUE TRUE TRUE FALSE EQUALS NOTHING
-- (7): "Subject to subsection (6), any person is entitled to refuse". Arguments: officer or agent; relevant; might incriminate.
#ASSERT `s 236(7) the person is entitled to refuse to answer the question on the ground that the answer might tend to incriminate the person` TRUE TRUE TRUE EQUALS JUST FALSE     -- taken away by (6)
#ASSERT `s 236(7) the person is entitled to refuse to answer the question on the ground that the answer might tend to incriminate the person` FALSE FALSE TRUE EQUALS JUST TRUE     -- any other person
#ASSERT `s 236(7) the person is entitled to refuse to answer the question on the ground that the answer might tend to incriminate the person` TRUE FALSE TRUE EQUALS JUST TRUE      -- an officer asked a question that is not relevant or material
#ASSERT `s 236(7) the person is entitled to refuse to answer the question on the ground that the answer might tend to incriminate the person` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 236(7) the person is entitled to refuse to answer the question on the ground that the answer might tend to incriminate the person` FALSE FALSE FALSE EQUALS NOTHING     -- an answer that would not incriminate: the subsection says nothing
-- (8): the examination; the signed notes "may except in the case of any answer which that person would not have been required to give but for subsection (6) thereafter be used in evidence". Arguments: signed; the excepted answer.
#ASSERT `s 236(8) the inspector may cause notes of the examination to be recorded, reduced to writing and read to or by and signed by the person examined` TRUE EQUALS JUST TRUE
#ASSERT `s 236(8) the inspector may cause notes of the examination to be recorded, reduced to writing and read to or by and signed by the person examined` FALSE EQUALS NOTHING
#ASSERT `s 236(8) the signed notes may be used in evidence in legal proceedings against the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 236(8) the signed notes may be used in evidence in legal proceedings against the person` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 236(8) the signed notes may be used in evidence in legal proceedings against the person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 236(8) the signed notes may be used in evidence in legal proceedings against the person` FALSE TRUE EQUALS JUST FALSE
