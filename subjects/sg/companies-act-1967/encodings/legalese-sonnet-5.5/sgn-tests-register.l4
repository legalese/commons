#ASSERT `s 386AFA(7) the most the company or foreign company or an officer in default may be sentenced to on conviction` TRUE FALSE TRUE EQUALS JUST (Penalty OF 25000, 0, FALSE, FALSE)
#ASSERT `s 386AFA(7) the most the company or foreign company or an officer in default may be sentenced to on conviction` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 386AFA(7) the most the company or foreign company or an officer in default may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING

