§ `s 386AFA(7): the offence`

#ASSERT `s 386AFA(7) the company or foreign company is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 386AFA(7) the company or foreign company is guilty of the offence` FALSE EQUALS JUST FALSE
-- arguments: fails (3), (4), (5) or (6); the person is an officer in default
#ASSERT `s 386AFA(7) the officer of the company or foreign company is guilty of the offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AFA(7) the officer of the company or foreign company is guilty of the offence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 386AFA(7) the officer of the company or foreign company is guilty of the offence` FALSE TRUE EQUALS JUST FALSE
-- arguments: fails; the person is the company or foreign company; the person is an officer in default
