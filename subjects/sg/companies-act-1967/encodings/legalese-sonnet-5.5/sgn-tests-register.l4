#ASSERT `s 386AFA(9) the reference to a controller or a registrable controller includes the person` `s 386AFA(9) section 386AG(1) or (2)` TRUE EQUALS JUST FALSE
#ASSERT `s 386AFA(9) the reference to a controller or a registrable controller includes the person` `s 386AFA(9) section 386AH(1) or (7)` TRUE EQUALS JUST FALSE
#ASSERT `s 386AFA(9) the reference to a controller or a registrable controller includes the person` `s 386AFA(9) section 386AI(1)` TRUE EQUALS JUST FALSE
#ASSERT `s 386AFA(9) the reference to a controller or a registrable controller includes the person` `s 386AFA(9) section 386AIA(1) or (6)` TRUE EQUALS JUST FALSE
#ASSERT `s 386AFA(9) the reference to a controller or a registrable controller includes the person` `s 386AFA(9) section 386AJ(1)` TRUE EQUALS JUST FALSE
