#ASSERT `s 76D(4A)(b) section 76D(7) applies to the resolution` TRUE EQUALS JUST FALSE
#ASSERT `s 76D(4A)(b) section 76D(7) applies to the resolution` FALSE EQUALS NOTHING
-- (4A)(b): the documents were given to the members in time.
#ASSERT `s 76D(4A)(b) the documents have been given to the members in time` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76D(4A)(b) the documents have been given to the members in time` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 76D(4A)(b) the documents have been given to the members in time` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 76D(4A)(b) the documents have been given to the members in time` FALSE TRUE TRUE EQUALS NOTHING
