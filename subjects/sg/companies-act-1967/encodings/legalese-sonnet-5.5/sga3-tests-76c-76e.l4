IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sga3-76b`
IMPORT `sga3-76c-76e`

-- Tests for sga3-76c-76e.l4 (ss 76C, 76D, 76DA, 76E; lines 8509-8935 of inputs/CoA1967.txt). Every expected value is decided from the text before the run.
-- JUST TRUE is yes; JUST FALSE is the text saying no in its own words; NOTHING is "the text does not say".

-- ===== s 76C =====
-- (1) "otherwise than on an approved exchange in Singapore or any securities exchange outside Singapore": an off-market purchase is neither.
#ASSERT `s 76C(1) the purchase or acquisition is an off-market purchase` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76C(1) the purchase or acquisition is an off-market purchase` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 76C(1) the purchase or acquisition is an off-market purchase` FALSE TRUE EQUALS JUST FALSE
-- (1) the grant: off-market, on an equal access scheme, authorised in advance in general meeting; a gate failed is NOTHING (grant rule of 2026-11-12, limit 1).
#ASSERT `s 76C(1) the company may make an off-market purchase or acquisition of its own shares` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76C(1) the company may make an off-market purchase or acquisition of its own shares` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 76C(1) the company may make an off-market purchase or acquisition of its own shares` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 76C(1) the company may make an off-market purchase or acquisition of its own shares` TRUE TRUE FALSE EQUALS NOTHING
-- (2)(c) "must not be later than the date on which the next annual general meeting is or is required by law to be held, whichever is the earlier".
#ASSERT `s 76C(2)(c) the expiry date is not later than the date of the next annual general meeting` (Date 10 4 2026) (Date 10 4 2026) (Date 30 4 2026)
#ASSERT `s 76C(2)(c) the expiry date is not later than the date of the next annual general meeting` (Date 9 4 2026) (Date 10 4 2026) (Date 30 4 2026)
#ASSERT (NOT `s 76C(2)(c) the expiry date is not later than the date of the next annual general meeting` (Date 11 4 2026) (Date 10 4 2026) (Date 30 4 2026))
#ASSERT (NOT `s 76C(2)(c) the expiry date is not later than the date of the next annual general meeting` (Date 11 4 2026) (Date 30 4 2026) (Date 10 4 2026))
-- (2): the notice states the maximum number, the maximum price, an expiry date not later than the meeting, and the sources of funds.
#ASSERT `s 76C(2) the notice specifying the intention to propose the resolution has the content the subsection requires` TRUE TRUE (Date 10 4 2026) (Date 10 4 2026) (Date 30 4 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 76C(2) the notice specifying the intention to propose the resolution has the content the subsection requires` FALSE TRUE (Date 10 4 2026) (Date 10 4 2026) (Date 30 4 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 76C(2) the notice specifying the intention to propose the resolution has the content the subsection requires` TRUE FALSE (Date 10 4 2026) (Date 10 4 2026) (Date 30 4 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 76C(2) the notice specifying the intention to propose the resolution has the content the subsection requires` TRUE TRUE (Date 11 4 2026) (Date 10 4 2026) (Date 30 4 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 76C(2) the notice specifying the intention to propose the resolution has the content the subsection requires` TRUE TRUE (Date 10 4 2026) (Date 10 4 2026) (Date 30 4 2026) FALSE EQUALS JUST FALSE
-- (3): the resolution states the maximum number, the maximum price and the expiry date.
#ASSERT `s 76C(3) the resolution states the particulars the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76C(3) the resolution states the particulars the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76C(3) the resolution states the particulars the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 76C(3) the resolution states the particulars the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- (4): the authority "may be varied or revoked by the company in general meeting".
#ASSERT `s 76C(4) the authority for an off-market purchase may be varied or revoked` TRUE EQUALS JUST TRUE
#ASSERT `s 76C(4) the authority for an off-market purchase may be varied or revoked` FALSE EQUALS NOTHING
-- (5): the maximum price may be "a particular sum" or "a basis or formula"; the list is not closed.
#ASSERT `s 76C(5) the resolution may determine the maximum price in this way` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76C(5) the resolution may determine the maximum price in this way` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 76C(5) the resolution may determine the maximum price in this way` FALSE FALSE EQUALS NOTHING
-- (6): an equal access scheme: offers to every holder for the same percentage, a reasonable opportunity to accept, and the same terms (or only the listed differences).
#ASSERT `s 76C(6) the scheme is an equal access scheme` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76C(6) the scheme is an equal access scheme` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 76C(6) the scheme is an equal access scheme` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 76C(6) the scheme is an equal access scheme` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76C(6) the scheme is an equal access scheme` TRUE FALSE TRUE TRUE EQUALS JUST FALSE

-- ===== s 76D =====
-- (1) "otherwise than on a securities exchange" and not on an equal access scheme: a selective off-market purchase.
