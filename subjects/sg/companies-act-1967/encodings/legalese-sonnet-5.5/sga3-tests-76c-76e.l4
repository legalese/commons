#ASSERT `s 76D(5) the authority for a selective off-market purchase may be varied or revoked` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76D(5) the authority for a selective off-market purchase may be varied or revoked` TRUE TRUE EQUALS NOTHING
#ASSERT `s 76D(5) the authority for a selective off-market purchase may be varied or revoked` FALSE FALSE EQUALS NOTHING
