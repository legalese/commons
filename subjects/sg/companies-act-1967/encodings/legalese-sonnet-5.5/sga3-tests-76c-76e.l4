-- (3): the notice states the expiry (not later than the meeting) and the sources of funds.
#ASSERT `s 76D(3) the notice specifying the intention to propose the special resolution has the content the subsection requires` (Date 10 4 2026) (Date 10 4 2026) (Date 30 4 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 76D(3) the notice specifying the intention to propose the special resolution has the content the subsection requires` (Date 11 4 2026) (Date 10 4 2026) (Date 30 4 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 76D(3) the notice specifying the intention to propose the special resolution has the content the subsection requires` (Date 10 4 2026) (Date 10 4 2026) (Date 30 4 2026) FALSE EQUALS JUST FALSE
-- (4): the special resolution states the expiry date.
#ASSERT `s 76D(4) the special resolution states the expiry date` TRUE EQUALS JUST TRUE
#ASSERT `s 76D(4) the special resolution states the expiry date` FALSE EQUALS JUST FALSE
-- (4A)(a): for a resolution by written means, a seller or associated person is not regarded as a member having the right to vote.
#ASSERT `s 76D(4A)(a) the person is regarded as a member having the right to vote on the resolution at a general meeting for the purposes of section 184A` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76D(4A)(a) the person is regarded as a member having the right to vote on the resolution at a general meeting for the purposes of section 184A` TRUE FALSE EQUALS NOTHING
