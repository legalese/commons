IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sga3-78d-78k`

-- Tests for sga3-78d-78k.l4 (ss 78D to 78K; lines 9502-9881 of inputs/CoA1967.txt). Every expected value is decided from the text before the run.

-- ===== s 78D =====
#ASSERT `s 78D(1) this section applies` TRUE EQUALS JUST TRUE
#ASSERT `s 78D(1) this section applies` FALSE EQUALS NOTHING
#ASSERT `s 78D(3) subsection (2) applies to the creditor` TRUE EQUALS JUST TRUE
#ASSERT `s 78D(3) subsection (2) applies to the creditor` FALSE EQUALS NOTHING
-- (2) a creditor may apply "at any time during the 6 weeks beginning with the resolution date": 1 June 2026 to 12 July 2026 inclusive.
-- Inputs in order: the company has passed the special resolution; the creditor has an admissible debt or claim; the resolution date; the date of the application.
#ASSERT `s 78D(2) the creditor may apply to the Court for the resolution to be cancelled` TRUE TRUE (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 78D(2) the creditor may apply to the Court for the resolution to be cancelled` TRUE TRUE (Date 1 6 2026) (Date 12 7 2026) EQUALS JUST TRUE
#ASSERT `s 78D(2) the creditor may apply to the Court for the resolution to be cancelled` TRUE TRUE (Date 1 6 2026) (Date 13 7 2026) EQUALS JUST FALSE
#ASSERT `s 78D(2) the creditor may apply to the Court for the resolution to be cancelled` TRUE TRUE (Date 1 6 2026) (Date 31 5 2026) EQUALS JUST FALSE
#ASSERT `s 78D(2) the creditor may apply to the Court for the resolution to be cancelled` FALSE TRUE (Date 1 6 2026) (Date 5 6 2026) EQUALS NOTHING
#ASSERT `s 78D(2) the creditor may apply to the Court for the resolution to be cancelled` TRUE FALSE (Date 1 6 2026) (Date 5 6 2026) EQUALS NOTHING
-- (4) "as soon as possible" names no day: the rules cannot reach BREACH (NOTES.md, rules with no breach path).
-- EXPECT FULFILLED
#TRACE `s 78D(4)(a) the creditor must as soon as possible serve the application on the company` "A Creditor" AT 0 WITH
    PARTY Creditor "A Creditor" DOES `s 78D(4)(a) serve the application on the company` AT 9
-- EXPECT RESIDUAL
#TRACE `s 78D(4)(a) the creditor must as soon as possible serve the application on the company` "A Creditor" AT 0 WITH
    (WAITUNTIL 60)
-- EXPECT FULFILLED
#TRACE `s 78D(4)(b) the company must as soon as possible give to the Registrar notice of the application` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 78D(4)(b) give to the Registrar notice of the application` AT 3
-- EXPECT RESIDUAL
#TRACE `s 78D(4)(b) the company must as soon as possible give to the Registrar notice of the application` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 60)

