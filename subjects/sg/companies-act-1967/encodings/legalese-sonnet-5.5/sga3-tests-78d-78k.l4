#ASSERT `s 78F(3) the Court is to dismiss the application` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 78F(3) the Court is to dismiss the application` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 78F(3) the Court is to dismiss the application` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
