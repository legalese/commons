#ASSERT `s 78G(1) the resolution and the reduction of the share capital cannot yet take effect` `limited by guarantee` TRUE TRUE TRUE EQUALS NOTHING

-- ===== s 78H =====
-- (1) applies where the company applied under 78G(1) and the reduction involves (a) a reduction of liability on unpaid capital or (b) payment to a shareholder of paid-up capital, and where the Court directs.
#ASSERT `s 78H(1) this section applies` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 78H(1) this section applies` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 78H(1) this section applies` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 78H(1) this section applies` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 78H(1) this section applies` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 78H(2) the Court is to settle a list of qualifying creditors` TRUE EQUALS JUST TRUE
#ASSERT `s 78H(2) the Court is to settle a list of qualifying creditors` FALSE EQUALS NOTHING
-- (3) the Court may direct that a class of creditors are not qualifying creditors where the reduction involves (a) or (b) and it thinks it appropriate.
#ASSERT `s 78H(3) the Court may direct that a class or classes of creditors are not qualifying creditors` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 78H(3) the Court may direct that a class or classes of creditors are not qualifying creditors` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 78H(3) the Court may direct that a class or classes of creditors are not qualifying creditors` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 78H(3) the Court may direct that a class or classes of creditors are not qualifying creditors` FALSE FALSE TRUE EQUALS NOTHING
-- (4)(a) the Court must ascertain the names and debts as far as possible: no day is named. (4)(b) the Court may publish notices.
-- EXPECT FULFILLED
#TRACE `s 78H(4)(a) the Court must ascertain the names of qualifying creditors and the nature and amount of their debts or claims` AT 0 WITH
    PARTY Court DOES `s 78H(4)(a) ascertain the names of qualifying creditors and the nature and amount of their debts or claims` AT 5
-- EXPECT RESIDUAL
#TRACE `s 78H(4)(a) the Court must ascertain the names of qualifying creditors and the nature and amount of their debts or claims` AT 0 WITH
    (WAITUNTIL 60)
#ASSERT `s 78H(4)(b) the Court may publish notices` TRUE EQUALS JUST TRUE
#ASSERT `s 78H(4)(b) the Court may publish notices` FALSE EQUALS NOTHING
-- (5) the offence: an officer who intentionally conceals a creditor's name, intentionally misrepresents a debt or claim, or aids, abets or is privy; a fine up to $15,000 or imprisonment up to 3 years ("or", not both).
#ASSERT `s 78H(5) the officer is guilty of the offence this subsection creates` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 78H(5) the officer is guilty of the offence this subsection creates` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 78H(5) the officer is guilty of the offence this subsection creates` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 78H(5) the officer is guilty of the offence this subsection creates` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 78H(5) the officer is guilty of the offence this subsection creates` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 78H(5) the most the officer may be sentenced to on conviction` TRUE TRUE FALSE FALSE EQUALS JUST (`s 78H(5) penalty` OF 15000, 3, FALSE)
#ASSERT `s 78H(5) the most the officer may be sentenced to on conviction` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- EXPECT BREACH
#TRACE `s 78H(5) an officer must not conceal or misrepresent the debts or claims of creditors, or aid or abet it` (Officer "An Officer") AT 0 WITH
    PARTY Officer "An Officer" DOES `s 78H(5) conceal intentionally the name of a qualifying creditor, misrepresent intentionally the nature or amount of the debt or claim of a creditor, or aid, abet or be privy to such concealment or misrepresentation` AT 4
-- EXPECT RESIDUAL
#TRACE `s 78H(5) an officer must not conceal or misrepresent the debts or claims of creditors, or aid or abet it` (Officer "An Officer") AT 0 WITH
    (WAITUNTIL 60)
-- (6) "qualifying creditor" means a creditor who at a date fixed by the Court is entitled to a debt or claim admissible in proof on a winding up, subject to subsection (3).
#ASSERT `s 78H(6) "qualifying creditor" the creditor is a qualifying creditor` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 78H(6) "qualifying creditor" the creditor is a qualifying creditor` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 78H(6) "qualifying creditor" the creditor is a qualifying creditor` TRUE TRUE EQUALS JUST FALSE

-- ===== s 78I =====
-- (2) a creditor on the Court's list, whose claim or debt is live, stands in the way unless the Court is satisfied of consent, security or that safeguards are unnecessary.
-- Record fields in order: on the list; claim or debt live; consented; secured or adequate safeguards; safeguards unnecessary.
#ASSERT `s 78I(2) the creditor stands in the way of an order approving the reduction` (`s 78I(2) qualifying creditor` OF TRUE, TRUE, FALSE, FALSE, FALSE)
#ASSERT (NOT `s 78I(2) the creditor stands in the way of an order approving the reduction` (`s 78I(2) qualifying creditor` OF TRUE, TRUE, TRUE, FALSE, FALSE))
#ASSERT (NOT `s 78I(2) the creditor stands in the way of an order approving the reduction` (`s 78I(2) qualifying creditor` OF TRUE, TRUE, FALSE, TRUE, FALSE))
#ASSERT (NOT `s 78I(2) the creditor stands in the way of an order approving the reduction` (`s 78I(2) qualifying creditor` OF TRUE, TRUE, FALSE, FALSE, TRUE))
#ASSERT (NOT `s 78I(2) the creditor stands in the way of an order approving the reduction` (`s 78I(2) qualifying creditor` OF FALSE, TRUE, FALSE, FALSE, FALSE))
#ASSERT (NOT `s 78I(2) the creditor stands in the way of an order approving the reduction` (`s 78I(2) qualifying creditor` OF TRUE, FALSE, FALSE, FALSE, FALSE))
