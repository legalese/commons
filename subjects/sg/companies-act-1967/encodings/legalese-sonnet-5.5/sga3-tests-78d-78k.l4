#ASSERT `s 78I(2) the Court must not make an order approving the reduction` (LIST (`s 78I(2) qualifying creditor` OF TRUE, TRUE, TRUE, FALSE, FALSE), (`s 78I(2) qualifying creditor` OF TRUE, TRUE, FALSE, FALSE, FALSE)) EQUALS JUST TRUE
#ASSERT `s 78I(2) the Court must not make an order approving the reduction` (LIST (`s 78I(2) qualifying creditor` OF TRUE, TRUE, TRUE, FALSE, FALSE), (`s 78I(2) qualifying creditor` OF TRUE, TRUE, FALSE, TRUE, FALSE)) EQUALS JUST FALSE
#ASSERT `s 78I(2) the Court must not make an order approving the reduction` (LIST (`s 78I(2) qualifying creditor` OF FALSE, TRUE, FALSE, FALSE, FALSE)) EQUALS JUST FALSE
-- (1) the Court may, subject to (2), approve on an application under 78G(1).
#ASSERT `s 78I(1) the Court may make an order approving the reduction in share capital` TRUE (LIST (`s 78I(2) qualifying creditor` OF TRUE, TRUE, TRUE, FALSE, FALSE)) EQUALS JUST TRUE
#ASSERT `s 78I(1) the Court may make an order approving the reduction in share capital` TRUE (LIST (`s 78I(2) qualifying creditor` OF TRUE, TRUE, FALSE, FALSE, FALSE)) EQUALS JUST FALSE
#ASSERT `s 78I(1) the Court may make an order approving the reduction in share capital` FALSE (LIST (`s 78I(2) qualifying creditor` OF TRUE, TRUE, TRUE, FALSE, FALSE)) EQUALS NOTHING
