-- ===== s 78G =====
#ASSERT `s 78G(1) the company limited by shares may reduce its share capital in any way by a special resolution approved by an order of the Court` `limited by shares` TRUE EQUALS JUST TRUE
#ASSERT `s 78G(1) the company limited by shares may reduce its share capital in any way by a special resolution approved by an order of the Court` `limited by shares` FALSE EQUALS NOTHING
#ASSERT `s 78G(1) the company limited by shares may reduce its share capital in any way by a special resolution approved by an order of the Court` `unlimited` TRUE EQUALS NOTHING
-- "do not take effect until (a) the order has been made; (b) the company has complied with s 78I(3); (c) the Registrar has recorded the information": TRUE before all three, FALSE after.
#ASSERT `s 78G(1) the resolution and the reduction of the share capital cannot yet take effect` `limited by shares` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 78G(1) the resolution and the reduction of the share capital cannot yet take effect` `limited by shares` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 78G(1) the resolution and the reduction of the share capital cannot yet take effect` `limited by shares` TRUE FALSE TRUE EQUALS JUST TRUE
