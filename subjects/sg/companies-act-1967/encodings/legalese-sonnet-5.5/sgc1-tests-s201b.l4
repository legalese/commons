IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgc1-s201b`

-- Tests for sgc1-s201b.l4 (ss 201B and 201C). Expected values are written from the text, beside each assertion.

§ `s 201B(1): every listed company must have an audit committee`

#ASSERT `s 201B(1) the company must have an audit committee` TRUE EQUALS JUST TRUE
-- the subsection speaks of listed companies only and is silent on any other
#ASSERT `s 201B(1) the company must have an audit committee` FALSE EQUALS NOTHING

-- EXPECT FULFILLED
#TRACE `s 201B(1) a listed company must have an audit committee` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 201B(1) have an audit committee` AT 5

-- EXPECT RESIDUAL (no time limit and no consequence inside the subsection)
#TRACE `s 201B(1) a listed company must have an audit committee` "Acme Ltd" AT 0 WITH

§ `s 201B(2): how the audit committee is appointed and composed`

-- appointed by the directors from among their number, by board resolution; 3 members, none within (a) to (c)
#ASSERT `s 201B(2) the audit committee is appointed and composed as the subsection requires` TRUE TRUE 3 0 EQUALS JUST TRUE
-- 3 members of whom 1 is within (a) to (c): not a majority
#ASSERT `s 201B(2) the audit committee is appointed and composed as the subsection requires` TRUE TRUE 3 1 EQUALS JUST TRUE
-- 3 members of whom 2 are within (a) to (c): a majority
#ASSERT `s 201B(2) the audit committee is appointed and composed as the subsection requires` TRUE TRUE 3 2 EQUALS JUST FALSE
-- 4 members of whom 2 are within (a) to (c): exactly half is not a majority
#ASSERT `s 201B(2) the audit committee is appointed and composed as the subsection requires` TRUE TRUE 4 2 EQUALS JUST TRUE
-- 4 members of whom 3 are within (a) to (c): a majority
#ASSERT `s 201B(2) the audit committee is appointed and composed as the subsection requires` TRUE TRUE 4 3 EQUALS JUST FALSE
-- 2 members: fewer than 3
#ASSERT `s 201B(2) the audit committee is appointed and composed as the subsection requires` TRUE TRUE 2 0 EQUALS JUST FALSE
-- not appointed by the directors from among their number
#ASSERT `s 201B(2) the audit committee is appointed and composed as the subsection requires` FALSE TRUE 3 0 EQUALS JUST FALSE
-- not appointed pursuant to a resolution of the board
#ASSERT `s 201B(2) the audit committee is appointed and composed as the subsection requires` TRUE FALSE 3 0 EQUALS JUST FALSE

§ `s 201B(3): the chairperson`

-- a member who is neither an executive director nor an employee
#ASSERT `s 201B(3) the person is eligible to be elected chairperson of the audit committee` TRUE FALSE FALSE EQUALS JUST TRUE
-- not a member: "from among their number"
#ASSERT `s 201B(3) the person is eligible to be elected chairperson of the audit committee` FALSE FALSE FALSE EQUALS JUST FALSE
-- an executive director
#ASSERT `s 201B(3) the person is eligible to be elected chairperson of the audit committee` TRUE TRUE FALSE EQUALS JUST FALSE
-- an employee
#ASSERT `s 201B(3) the person is eligible to be elected chairperson of the audit committee` TRUE FALSE TRUE EQUALS JUST FALSE

§ `s 201B(4): making up the number of members`

-- a member ceases on 15 January 2026 and 2 members are left: 3 months later is 15 April 2026
#ASSERT `s 201B(4) the last day for the board of directors to appoint new members` (Date 15 1 2026) 2 EQUALS JUST (Date 15 4 2026)
-- the event on 30 November 2025: no 30 February, so the last day is 28 February 2026 (P4)
#ASSERT `s 201B(4) the last day for the board of directors to appoint new members` (Date 30 11 2025) 2 EQUALS JUST (Date 28 2 2026)
-- the event on 31 May 2026: 31 August 2026
#ASSERT `s 201B(4) the last day for the board of directors to appoint new members` (Date 31 5 2026) 1 EQUALS JUST (Date 31 8 2026)
-- the number is not reduced below 3: the subsection is silent
#ASSERT `s 201B(4) the last day for the board of directors to appoint new members` (Date 15 1 2026) 3 EQUALS NOTHING
-- both sides of the last day (event 15 January 2026, 2 members left)
#ASSERT `s 201B(4) the board of directors has appointed new members in time` (Date 15 1 2026) 2 (Date 15 4 2026) EQUALS JUST TRUE
#ASSERT `s 201B(4) the board of directors has appointed new members in time` (Date 15 1 2026) 2 (Date 16 4 2026) EQUALS JUST FALSE
#ASSERT `s 201B(4) the board of directors has appointed new members in time` (Date 15 1 2026) 2 (Date 20 1 2026) EQUALS JUST TRUE
#ASSERT `s 201B(4) the board of directors has appointed new members in time` (Date 15 1 2026) 3 (Date 16 4 2026) EQUALS NOTHING

-- 15 January to 15 April 2026 is 31 + 28 + 31 = 90 days
-- EXPECT FULFILLED
#TRACE `s 201B(4) the board of directors must within 3 months appoint new members to make up the minimum number` "Ann" 90 AT 0 WITH
    PARTY Director "Ann" DOES `s 201B(4) appoint new members of the audit committee to make up the minimum number of 3` AT 90

-- EXPECT BREACH
#TRACE `s 201B(4) the board of directors must within 3 months appoint new members to make up the minimum number` "Ann" 90 AT 0 WITH
    WAITUNTIL 91

§ `s 201B(5): the functions of an audit committee`

#ASSERT `s 201B(5) the function is one of the functions of an audit committee` `s 201B(5)(a)(i) review with the auditor the audit plan` FALSE EQUALS JUST TRUE
#ASSERT `s 201B(5) the function is one of the functions of an audit committee` `s 201B(5)(a)(vi) review the financial statements and any consolidated financial statements submitted to the committee, and thereafter submit them to the directors` FALSE EQUALS JUST TRUE
#ASSERT `s 201B(5) the function is one of the functions of an audit committee` `s 201B(5)(b) nominate a person or persons as auditor, despite anything contained in the constitution or under section 205` FALSE EQUALS JUST TRUE
-- "together with such other functions as may be agreed to by the audit committee and the board of directors"
#ASSERT `s 201B(5) the function is one of the functions of an audit committee` `s 201B(5) some other function` TRUE EQUALS JUST TRUE
#ASSERT `s 201B(5) the function is one of the functions of an audit committee` `s 201B(5) some other function` FALSE EQUALS JUST FALSE

§ `s 201B(6): the auditor and the committee`

#ASSERT `s 201B(6) the auditor has the right to appear and be heard at any meeting of the audit committee` TRUE EQUALS JUST TRUE
-- the right is given to the auditor and the subsection is silent on anyone else
#ASSERT `s 201B(6) the auditor has the right to appear and be heard at any meeting of the audit committee` FALSE EQUALS NOTHING
#ASSERT `s 201B(6) the auditor must appear before the committee` TRUE TRUE EQUALS JUST TRUE
-- "when required to do so by the committee": no requirement, no duty
#ASSERT `s 201B(6) the auditor must appear before the committee` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 201B(6) the auditor must appear before the committee` FALSE TRUE EQUALS JUST FALSE

-- EXPECT FULFILLED
#TRACE `s 201B(6) the auditor must appear before the committee when required to do so` "Bee & Co" AT 0 WITH
    PARTY Auditor "Bee & Co" DOES `s 201B(6) appear before the audit committee when required to do so` AT 3

-- EXPECT RESIDUAL (no time limit and no consequence inside the subsection)
#TRACE `s 201B(6) the auditor must appear before the committee when required to do so` "Bee & Co" AT 0 WITH

§ `s 201B(7): the chairperson convenes a meeting on the auditor's request`

#ASSERT `s 201B(7) the chairperson must convene a meeting of the audit committee` TRUE EQUALS JUST TRUE
-- no request, no duty: a failed "upon"
#ASSERT `s 201B(7) the chairperson must convene a meeting of the audit committee` FALSE EQUALS JUST FALSE

-- EXPECT FULFILLED
#TRACE `s 201B(7) the chairperson must convene a meeting of the committee on the auditor's request` "Cho" AT 0 WITH
    PARTY Individual "Cho" DOES `s 201B(7) convene a meeting of the audit committee on the auditor's request` AT 2

-- EXPECT RESIDUAL (no time limit and no consequence inside the subsection)
#TRACE `s 201B(7) the chairperson must convene a meeting of the committee on the auditor's request` "Cho" AT 0 WITH

§ `s 201B(8): the committee's own procedure`

#ASSERT `s 201B(8) the audit committee may regulate the matter` TRUE EQUALS JUST TRUE
-- the grant is of "its own procedure" and the subsection is silent on any other matter
#ASSERT `s 201B(8) the audit committee may regulate the matter` FALSE EQUALS NOTHING

§ `s 201B(9): the audit committee in the directors' statement`

#ASSERT `s 201B(9) the directors must describe the audit committee's functions in the statement` TRUE TRUE EQUALS JUST TRUE
-- not required to make a statement under section 201(16)
#ASSERT `s 201B(9) the directors must describe the audit committee's functions in the statement` FALSE TRUE EQUALS JUST FALSE
-- the company is not a listed company
#ASSERT `s 201B(9) the directors must describe the audit committee's functions in the statement` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 201B(9) the directors must describe the audit committee's functions in the statement` FALSE FALSE EQUALS JUST FALSE
-- the statement does describe the functions
#ASSERT `s 201B(9) the directors' statement describes the audit committee's functions as the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
-- the statement leaves them out
#ASSERT `s 201B(9) the directors' statement describes the audit committee's functions as the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- the subsection does not apply: it is silent
#ASSERT `s 201B(9) the directors' statement describes the audit committee's functions as the subsection requires` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 201B(9) the directors' statement describes the audit committee's functions as the subsection requires` TRUE FALSE TRUE EQUALS NOTHING

-- EXPECT FULFILLED
#TRACE `s 201B(9) the directors of a listed company must describe the audit committee's functions in the statement` "Ann" AT 0 WITH
    PARTY Director "Ann" DOES `s 201B(9) describe in the directors' statement the nature and extent of the functions performed by the audit committee` AT 4

-- EXPECT RESIDUAL (no time limit and no consequence inside the subsection)
#TRACE `s 201B(9) the directors of a listed company must describe the audit committee's functions in the statement` "Ann" AT 0 WITH

§ `s 201B(11): who is an executive director`

-- an employee of the company, or holding another office of profit in it
#ASSERT `s 201B(11) the director is an executive director` TRUE FALSE FALSE EQUALS JUST TRUE
-- an employee of another corporation that is deemed related by section 6
#ASSERT `s 201B(11) the director is an executive director` FALSE TRUE TRUE EQUALS JUST TRUE
-- an employee of another corporation that is not related
#ASSERT `s 201B(11) the director is an executive director` FALSE TRUE FALSE EQUALS JUST FALSE
-- a related corporation, but the director holds no employment or office of profit in it
#ASSERT `s 201B(11) the director is an executive director` FALSE FALSE TRUE EQUALS JUST FALSE
-- no employment and no office of profit anywhere
#ASSERT `s 201B(11) the director is an executive director` FALSE FALSE FALSE EQUALS JUST FALSE

§ `s 201C(1): private companies that need not hold an annual general meeting`

#ASSERT `s 201C(1) the directors need not lay financial statements before the company at its annual general meeting` TRUE TRUE EQUALS JUST TRUE
-- the company must hold an annual general meeting: the "if" fails
#ASSERT `s 201C(1) the directors need not lay financial statements before the company at its annual general meeting` TRUE FALSE EQUALS JUST FALSE
-- the subsection speaks of a private company and is silent on any other
#ASSERT `s 201C(1) the directors need not lay financial statements before the company at its annual general meeting` FALSE TRUE EQUALS NOTHING
#ASSERT `s 201C(1) the directors need not lay financial statements before the company at its annual general meeting` FALSE FALSE EQUALS NOTHING

§ `s 201C(2): the reference in section 207(1)`

#ASSERT `s 201C(2) the reference in section 207(1) is read as a reference to the documents sent under section 203(1)` TRUE EQUALS JUST TRUE
-- the statements were laid after all: the "where" fails
#ASSERT `s 201C(2) the reference in section 207(1) is read as a reference to the documents sent under section 203(1)` FALSE EQUALS JUST FALSE
