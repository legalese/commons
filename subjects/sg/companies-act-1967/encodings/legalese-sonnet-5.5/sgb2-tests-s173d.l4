IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgb2-s173d-s173i-transitional-and-notice`

-- Tests for ss 173D, 173E, 173F, 173G and 173I. Every expected value is written from the text, beside the assertion, before it was run.
-- The commencement dates the text leaves out are inputs: the test dates below are made up for the tests and are not the real ones.

§ `s 173D: particulars lodged before 3 January 2016`

-- Arguments: the day the company was incorporated; the person was lodged under the old s 173; a notification of change has been received.
#ASSERT `s 173D(1) the name and particulars must remain entered in the register of directors, secretaries or auditors` (Date 1 6 2010) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 173D(1) the name and particulars must remain entered in the register of directors, secretaries or auditors` (Date 1 6 2010) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 173D(1) the name and particulars must remain entered in the register of directors, secretaries or auditors` (Date 2 1 2016) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 173D(1) the name and particulars must remain entered in the register of directors, secretaries or auditors` (Date 3 1 2016) TRUE FALSE EQUALS NOTHING
#ASSERT `s 173D(1) the name and particulars must remain entered in the register of directors, secretaries or auditors` (Date 1 6 2010) FALSE FALSE EQUALS NOTHING
#ASSERT `s 173D(2) the name and particulars of the manager must remain entered in the register of chief executive officers` (Date 1 6 2010) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 173D(2) the name and particulars of the manager must remain entered in the register of chief executive officers` (Date 1 6 2010) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 173D(2) the name and particulars of the manager must remain entered in the register of chief executive officers` (Date 3 1 2016) TRUE FALSE EQUALS NOTHING
#ASSERT `s 173D(2) the name and particulars of the manager must remain entered in the register of chief executive officers` (Date 1 6 2010) FALSE FALSE EQUALS NOTHING
#ASSERT `s 173D(3) the address lodged is to be entered as` `s 173D(3)(a) a director or a secretary` EQUALS JUST `s 173D(3) the residential address`
#ASSERT `s 173D(3) the address lodged is to be entered as` `s 173D(3)(b) a manager` EQUALS JUST `s 173D(3) the residential address in his or her capacity as chief executive officer of the company`
#ASSERT `s 173D(3) the address lodged is to be entered as` `s 173D(3)(c) an auditor` EQUALS JUST `s 173D(3) the auditor's address`
#ASSERT `s 173D(3) the address lodged is to be entered as` `s 173D(3) another person` EQUALS NOTHING

§ `s 173E: self-notification`

-- Arguments: the day the director ceased to be qualified; the commencement day of s 66 (an input, made up here as 1 July 2025); the day the director notified the company; as soon as practicable.
#ASSERT `s 173E(1)(a) the director notified the company of the disqualification in time` (Date 1 6 2026) (Date 1 7 2025) (Date 15 6 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 173E(1)(a) the director notified the company of the disqualification in time` (Date 1 6 2026) (Date 1 7 2025) (Date 16 6 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 173E(1)(a) the director notified the company of the disqualification in time` (Date 1 6 2026) (Date 1 7 2025) (Date 15 6 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 173E(1)(a) the director notified the company of the disqualification in time` (Date 30 6 2025) (Date 1 7 2025) (Date 10 7 2025) TRUE EQUALS NOTHING
#ASSERT `s 173E(1)(a) the director notified the company of the disqualification in time` (Date 1 7 2025) (Date 1 7 2025) (Date 10 7 2025) TRUE EQUALS JUST TRUE

-- EXPECT FULFILLED
#TRACE `s 173E(1)(a) the director must notify the company of the disqualification within 14 days` "Dana Tan" AT 0 WITH
    PARTY Director "Dana Tan" DOES `s 173E(1)(a) notify the company of the director's disqualification` AT 14

-- EXPECT BREACH
#TRACE `s 173E(1)(a) the director must notify the company of the disqualification within 14 days` "Dana Tan" AT 0 WITH
    PARTY Director "Dana Tan" DOES `s 173E(1)(a) notify the company of the director's disqualification` AT 15

-- EXPECT RESIDUAL
#TRACE `s 173E(1)(a) the director must notify the company of the disqualification within 14 days` "Dana Tan" AT 0 WITH

#ASSERT `s 173E(1)(b) the director may give the notice to the Registrar` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 173E(1)(b) the director may give the notice to the Registrar` TRUE FALSE EQUALS NOTHING
#ASSERT `s 173E(1)(b) the director may give the notice to the Registrar` FALSE TRUE EQUALS NOTHING
#ASSERT `s 173E the person may give the notice to the Registrar` `s 173E(2) a director who resigns from office and has given notice of his or her resignation to the company` TRUE EQUALS JUST TRUE
#ASSERT `s 173E the person may give the notice to the Registrar` `s 173E(2) a director who resigns from office and has given notice of his or her resignation to the company` FALSE EQUALS NOTHING
#ASSERT `s 173E the person may give the notice to the Registrar` `s 173E(2) a director who is removed or retires from office` TRUE EQUALS JUST TRUE
#ASSERT `s 173E the person may give the notice to the Registrar` `s 173E(2) a director who is removed or retires from office` FALSE EQUALS NOTHING
#ASSERT `s 173E the person may give the notice to the Registrar` `s 173E(3) a secretary who resigns from office and has given notice of his or her resignation to the company` TRUE EQUALS JUST TRUE
#ASSERT `s 173E the person may give the notice to the Registrar` `s 173E(3) a secretary who resigns from office and has given notice of his or her resignation to the company` FALSE EQUALS NOTHING
#ASSERT `s 173E the person may give the notice to the Registrar` `s 173E(3) a secretary who is removed or retires from office` TRUE EQUALS JUST TRUE
#ASSERT `s 173E the person may give the notice to the Registrar` `s 173E(3) a secretary who is removed or retires from office` FALSE EQUALS NOTHING
#ASSERT `s 173E the person may give the notice to the Registrar` `s 173E(4) a director, chief executive officer or secretary who has changed his or her residential address or contact address, or an auditor who has changed the auditor's address` TRUE EQUALS JUST TRUE
#ASSERT `s 173E the person may give the notice to the Registrar` `s 173E(4) a director, chief executive officer or secretary who has changed his or her residential address or contact address, or an auditor who has changed the auditor's address` FALSE EQUALS NOTHING
#ASSERT `s 173E the person may give the notice to the Registrar` `s 173E another person` TRUE EQUALS NOTHING

§ `s 173F: amendment of a register by the Registrar`

-- a failed gate at a public body's power answers JUST FALSE (S1b ruling, 2026S1bC); a case the section does not name stays NOTHING
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(1) a director of the company has been disqualified from being or acting as a director` TRUE EQUALS JUST TRUE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(1) a director of the company has been disqualified from being or acting as a director` FALSE EQUALS JUST FALSE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(1A) a director of the company is dead` TRUE EQUALS JUST TRUE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(1A) a director of the company is dead` FALSE EQUALS JUST FALSE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(2) a chief executive officer of the company is dead` TRUE EQUALS JUST TRUE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(2) a chief executive officer of the company is dead` FALSE EQUALS JUST FALSE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(3) a secretary of the company is dead` TRUE EQUALS JUST TRUE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(3) a secretary of the company is dead` FALSE EQUALS JUST FALSE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(4)(a) the auditor has had its registration as an accounting entity suspended or removed` TRUE EQUALS JUST TRUE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(4)(a) the auditor has had its registration as an accounting entity suspended or removed` FALSE EQUALS JUST FALSE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(4)(b) the auditor, being an individual, is dead` TRUE EQUALS JUST TRUE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(4)(b) the auditor, being an individual, is dead` FALSE EQUALS JUST FALSE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(5) the Registrar made an amendment under subsection (1), (1A), (2), (3) or (4) under a mistaken belief that the person had ceased to be director, chief executive officer, secretary or auditor` TRUE EQUALS JUST TRUE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F(5) the Registrar made an amendment under subsection (1), (1A), (2), (3) or (4) under a mistaken belief that the person had ceased to be director, chief executive officer, secretary or auditor` FALSE EQUALS JUST FALSE
#ASSERT `s 173F the Registrar may on his or her own initiative amend the register` `s 173F another case` TRUE EQUALS NOTHING

§ `s 173G: the transitional rules for contact and residential addresses`

-- The commencement date is an input (made up here as 9 December 2024).
#ASSERT `s 173G(6) the day is the commencement date` (Date 9 12 2024) (Date 9 12 2024) EQUALS JUST TRUE
#ASSERT `s 173G(6) the day is the commencement date` (Date 9 12 2024) (Date 10 12 2024) EQUALS JUST FALSE
#ASSERT `s 173G(1)(a) the Registrar must keep the alternate address as the contact address` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 173G(1)(a) the Registrar must keep the alternate address as the contact address` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 173G(1)(a) the Registrar must keep the alternate address as the contact address` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 173G(1)(b) the Registrar must make the contact address available for public access` TRUE EQUALS JUST TRUE
#ASSERT `s 173G(1)(b) the Registrar must make the contact address available for public access` FALSE EQUALS JUST FALSE
-- Arguments: no alternate address was entered; the residential address was entered; notice of a change in the contact address has been lodged.
#ASSERT `s 173G(2)(c) the Registrar must keep the residential address as the contact address as well` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 173G(2)(c) the Registrar must keep the residential address as the contact address as well` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 173G(2)(c) the Registrar must keep the residential address as the contact address as well` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 173G(2)(c) the Registrar must keep the residential address as the contact address as well` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 173G(2)(d) the Registrar must make the contact address available for public access` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 173G(2)(d) the Registrar must make the contact address available for public access` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 173G(2)(d) the Registrar must make the contact address available for public access` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 173G(3) the Registrar must exclude the individual's residential address from public access` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 173G(3) the Registrar must exclude the individual's residential address from public access` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 173G(3) the Registrar must exclude the individual's residential address from public access` TRUE FALSE EQUALS JUST FALSE
-- Arguments: the day of the appointment or change; the day the notice is furnished; the commencement date (made up as 9 December 2024).
#ASSERT `s 173G(5) the notice or information must provide the information required under section 173 as in force when it is furnished` (Date 1 6 2024) (Date 1 2 2025) (Date 9 12 2024) EQUALS JUST TRUE
#ASSERT `s 173G(5) the notice or information must provide the information required under section 173 as in force when it is furnished` (Date 1 6 2024) (Date 1 11 2024) (Date 9 12 2024) EQUALS JUST FALSE
#ASSERT `s 173G(5) the notice or information must provide the information required under section 173 as in force when it is furnished` (Date 10 12 2024) (Date 1 2 2025) (Date 9 12 2024) EQUALS NOTHING
#ASSERT `s 173G(5) the notice or information must provide the information required under section 173 as in force when it is furnished` (Date 9 12 2024) (Date 1 2 2025) (Date 9 12 2024) EQUALS NOTHING

§ `s 173I: old records a company keeps`

-- Arguments: the record; the person was a director (or secretary) immediately before 3 January 2016; there is evidence of a change of name; the person has ceased; the day the person ceased; the day in question.
#ASSERT `s 173I the company must continue to keep the record on the day` `s 173I(1)(a)(i) the signed copy of the person's consent to act as a director mentioned in section 173(2)(a) in force immediately before 3 January 2016` TRUE FALSE FALSE (Date 1 1 2000) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 173I the company must continue to keep the record on the day` `s 173I(1)(a)(i) the signed copy of the person's consent to act as a director mentioned in section 173(2)(a) in force immediately before 3 January 2016` TRUE FALSE TRUE (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 173I the company must continue to keep the record on the day` `s 173I(1)(a)(i) the signed copy of the person's consent to act as a director mentioned in section 173(2)(a) in force immediately before 3 January 2016` TRUE FALSE TRUE (Date 1 6 2026) (Date 2 6 2026) EQUALS JUST FALSE
#ASSERT `s 173I the company must continue to keep the record on the day` `s 173I(1)(a)(i) the signed copy of the person's consent to act as a director mentioned in section 173(2)(a) in force immediately before 3 January 2016` FALSE FALSE FALSE (Date 1 1 2000) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `s 173I the company must continue to keep the record on the day` `s 173I(1)(a)(i) the signed copy of the person's consent to act as a director mentioned in section 173(2)(a) in force immediately before 3 January 2016` TRUE FALSE FALSE (Date 1 1 2000) (Date 2 1 2016) EQUALS NOTHING
#ASSERT `s 173I the company must continue to keep the record on the day` `s 173I(1)(a)(i) the signed copy of the person's consent to act as a director mentioned in section 173(2)(a) in force immediately before 3 January 2016` TRUE FALSE FALSE (Date 1 1 2000) (Date 3 1 2016) EQUALS JUST TRUE
#ASSERT `s 173I the company must continue to keep the record on the day` `s 173I(1)(a)(ii) documentary evidence (if any) of any change in the person's name mentioned in section 173(2)(c) in force immediately before that date` TRUE FALSE FALSE (Date 1 1 2000) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 173I the company must continue to keep the record on the day` `s 173I(1)(a)(ii) documentary evidence (if any) of any change in the person's name mentioned in section 173(2)(c) in force immediately before that date` TRUE TRUE FALSE (Date 1 1 2000) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 173I the company must continue to keep the record on the day` `s 173I(1)(a)(ii) documentary evidence (if any) of any change in the person's name mentioned in section 173(2)(c) in force immediately before that date` TRUE TRUE TRUE (Date 1 6 2026) (Date 2 6 2026) EQUALS JUST FALSE
#ASSERT `s 173I the company must continue to keep the record on the day` `s 173I(1)(b) the signed copy of the person's consent to act as a secretary mentioned in section 173(4A) in force immediately before that date` TRUE FALSE FALSE (Date 1 1 2000) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 173I the company must continue to keep the record on the day` `s 173I(1)(b) the signed copy of the person's consent to act as a secretary mentioned in section 173(4A) in force immediately before that date` TRUE FALSE TRUE (Date 1 6 2026) (Date 2 6 2026) EQUALS JUST FALSE
#ASSERT `s 173I the company must continue to keep the record on the day` `s 173I some other record` TRUE FALSE FALSE (Date 1 1 2000) (Date 1 6 2026) EQUALS NOTHING

-- No period: done, FULFILLED; not done, RESIDUAL; never BREACH.
-- EXPECT FULFILLED
#TRACE `s 173I(1) the company must continue to keep the old consents and evidence of change of name` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 173I(1) continue to keep the old consents and evidence of change of name` AT 1

-- EXPECT RESIDUAL
#TRACE `s 173I(1) the company must continue to keep the old consents and evidence of change of name` "Acme Pte Ltd" AT 0 WITH

#ASSERT `s 173I(3) section 173(8) as in force immediately before 3 January 2016 continues to apply to the information` TRUE EQUALS JUST TRUE
#ASSERT `s 173I(3) section 173(8) as in force immediately before 3 January 2016 continues to apply to the information` FALSE EQUALS NOTHING
