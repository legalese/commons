IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgn-registrar`

-- Tests for sgn-registrar.l4 (ss 386AM, 386AN, 386ANA, 386AO, 386AP). Expected values are written from the text beside each assertion.
-- A prescribed time is a number of days; the tests use 14 days (assumed, not text), counted from 1 June 2026, so the last day is 15 June 2026.

`s 386AN test registrar` MEANS Registrar
`s 386AN test company` MEANS Company "Acme Pte Ltd"

§ `s 386AM(1): the powers`

-- arguments: the paragraph; the person is the Registrar or an officer of the Authority; the body is a company or foreign company to which the Part applies; the inquiry is necessary
#ASSERT `s 386AM(1) the Registrar or an officer of the Authority may exercise the power` `s 386AM(1)(a) require a company or foreign company to which this Part applies to produce its registers and documents` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AM(1) the Registrar or an officer of the Authority may exercise the power` `s 386AM(1)(a) require a company or foreign company to which this Part applies to produce its registers and documents` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 386AM(1) the Registrar or an officer of the Authority may exercise the power` `s 386AM(1)(a) require a company or foreign company to which this Part applies to produce its registers and documents` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 386AM(1) the Registrar or an officer of the Authority may exercise the power` `s 386AM(1)(b) inspect, examine and make copies of the registers and any document so produced` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 386AM(1) the Registrar or an officer of the Authority may exercise the power` `s 386AM(1)(b) inspect, examine and make copies of the registers and any document so produced` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 386AM(1) the Registrar or an officer of the Authority may exercise the power` `s 386AM(1)(c) make such inquiry as may be necessary to ascertain whether the provisions of this Part are complied with` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AM(1) the Registrar or an officer of the Authority may exercise the power` `s 386AM(1)(c) make such inquiry as may be necessary to ascertain whether the provisions of this Part are complied with` TRUE FALSE FALSE EQUALS NOTHING

§ `s 386AM(2): documents kept in electronic form`

-- arguments: the paragraph; the register or documents are kept in electronic form
#ASSERT `s 386AM(2) the power of the Registrar or an officer of the Authority extends to the requirement` `s 386AM(2)(a) require a copy of the register or documents to be made available in legible form` TRUE EQUALS JUST TRUE
#ASSERT `s 386AM(2) the power of the Registrar or an officer of the Authority extends to the requirement` `s 386AM(2)(a) require a copy of the register or documents to be made available in legible form` FALSE EQUALS JUST FALSE
#ASSERT `s 386AM(2) the power of the Registrar or an officer of the Authority extends to the requirement` `s 386AM(2)(b) require any person on the premises to give such assistance as the Registrar or officer may reasonably require` TRUE EQUALS JUST TRUE
#ASSERT `s 386AM(2) the power of the Registrar or an officer of the Authority extends to the requirement` `s 386AM(2)(b) require any person on the premises to give such assistance as the Registrar or officer may reasonably require` FALSE EQUALS JUST FALSE

§ `s 386AM(3): a public agency`

#ASSERT `s 386AM(3) the public agency may exercise the powers conferred by subsections (1) and (2)` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AM(3) the public agency may exercise the powers conferred by subsections (1) and (2)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 386AM(3) the public agency may exercise the powers conferred by subsections (1) and (2)` FALSE TRUE EQUALS NOTHING

§ `s 386AM(4), (4A), (4B): the offences and the defence`

#ASSERT `s 386AM(4) the person is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 386AM(4) the person is guilty of the offence` FALSE EQUALS JUST FALSE
#ASSERT `s 386AM(4) the most the person may be sentenced to on conviction` TRUE EQUALS JUST (Penalty OF 25000, 0, FALSE, FALSE)
#ASSERT `s 386AM(4) the most the person may be sentenced to on conviction` FALSE EQUALS NOTHING
#ASSERT `s 386AM(4A) the person is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 386AM(4A) the person is guilty of the offence` FALSE EQUALS JUST FALSE
#ASSERT `s 386AM(4A) the most the person may be sentenced to on conviction` TRUE EQUALS JUST (Penalty OF 25000, 0, FALSE, FALSE)
#ASSERT `s 386AM(4A) the most the person may be sentenced to on conviction` FALSE EQUALS NOTHING
-- (4B): arguments: the proceedings are for an offence under (4A); the accused has proved all reasonable steps and due diligence
#ASSERT `s 386AM(4B) this section gives a defence on these facts` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AM(4B) this section gives a defence on these facts` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 386AM(4B) this section gives a defence on these facts` FALSE TRUE EQUALS NOTHING
#ASSERT `s 386AM(4B) this section gives a defence on these facts` FALSE FALSE EQUALS NOTHING
#ASSERT `s 386AM(5) this section applies in addition to any right of inspection conferred by section 396A` EQUALS TRUE

§ `s 386AM(6): "public agency"`

-- arguments: a public officer; an Organ of State; a ministry or department of the Government; a public authority; a member, officer, employee or department of one
#ASSERT `s 386AM(6) "public agency" the person is a public agency` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 386AM(6) "public agency" the person is a public agency` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 386AM(6) "public agency" the person is a public agency` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 386AM(6) "public agency" the person is a public agency` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AM(6) "public agency" the person is a public agency` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AM(6) "public agency" the person is a public agency` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§ `s 386AN: the central register of controllers`

#ASSERT `s 386AN(1) this section applies` TRUE EQUALS JUST TRUE
#ASSERT `s 386AN(1) this section applies` FALSE EQUALS JUST FALSE
#ASSERT `s 386AN(2) the duties of paragraphs (a) and (b) apply to the Registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 386AN(2) the duties of paragraphs (a) and (b) apply to the Registrar` FALSE EQUALS JUST FALSE
-- the Registrar's duties have no time limit: they can be fulfilled or stay open, but no trace can show them breached ("Rules with no breach path")
-- EXPECT FULFILLED
#TRACE `s 386AN(2)(a) the Registrar must keep a central register of controllers` `s 386AN test registrar` AT 0 WITH
    PARTY `s 386AN test registrar` DOES `s 386AN(2)(a) keep a central register of controllers consisting of the particulars contained in the registers kept by companies and foreign companies to which this Part applies` AT 3
-- EXPECT RESIDUAL
#TRACE `s 386AN(2)(a) the Registrar must keep a central register of controllers` `s 386AN test registrar` AT 0 WITH
    (WAITUNTIL 400)
-- EXPECT FULFILLED
#TRACE `s 386AN(2)(b) the Registrar must require each company or foreign company to lodge the particulars and updates` `s 386AN test registrar` AT 0 WITH
    PARTY `s 386AN test registrar` DOES `s 386AN(2)(b) require a company or foreign company to which this Part applies to lodge the particulars contained in its register and all later updates` AT 3
-- EXPECT RESIDUAL
#TRACE `s 386AN(2)(b) the Registrar must require each company or foreign company to lodge the particulars and updates` `s 386AN test registrar` AT 0 WITH
    (WAITUNTIL 400)
-- (3): arguments: lodged; in the prescribed form and manner; the day lodged; the day the Registrar required it; the prescribed time in days; the date asked
#ASSERT `s 386AN(3) the company or foreign company has lodged what the Registrar required in time and in the prescribed form and manner` TRUE TRUE (Date 15 6 2026) (Date 1 6 2026) 14 (Date 20 6 2026) EQUALS JUST TRUE
#ASSERT `s 386AN(3) the company or foreign company has lodged what the Registrar required in time and in the prescribed form and manner` TRUE TRUE (Date 16 6 2026) (Date 1 6 2026) 14 (Date 20 6 2026) EQUALS JUST FALSE
-- lodged in time but not in the prescribed form and manner: not done as the subsection requires; the last day has passed
#ASSERT `s 386AN(3) the company or foreign company has lodged what the Registrar required in time and in the prescribed form and manner` TRUE FALSE (Date 10 6 2026) (Date 1 6 2026) 14 (Date 20 6 2026) EQUALS JUST FALSE
-- the same, with the last day not yet passed
#ASSERT `s 386AN(3) the company or foreign company has lodged what the Registrar required in time and in the prescribed form and manner` TRUE FALSE (Date 10 6 2026) (Date 1 6 2026) 14 (Date 15 6 2026) EQUALS NOTHING
#ASSERT `s 386AN(3) the company or foreign company has lodged what the Registrar required in time and in the prescribed form and manner` FALSE FALSE (Date 1 1 2000) (Date 1 6 2026) 14 (Date 15 6 2026) EQUALS NOTHING
#ASSERT `s 386AN(3) the company or foreign company has lodged what the Registrar required in time and in the prescribed form and manner` FALSE FALSE (Date 1 1 2000) (Date 1 6 2026) 14 (Date 16 6 2026) EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 386AN(3) a company or foreign company must lodge the particulars, matters and updates within the prescribed time after the Registrar requires it` `s 386AN test company` 14 AT 0 WITH
    PARTY `s 386AN test company` DOES `s 386AN(3) lodge with the Registrar the particulars, matters and updates in the prescribed form and manner` AT 14
-- EXPECT BREACH
#TRACE `s 386AN(3) a company or foreign company must lodge the particulars, matters and updates within the prescribed time after the Registrar requires it` `s 386AN test company` 14 AT 0 WITH
    PARTY `s 386AN test company` DOES `s 386AN(3) lodge with the Registrar the particulars, matters and updates in the prescribed form and manner` AT 15
-- (4): the offence
#ASSERT `s 386AN(4) the company or foreign company is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 386AN(4) the company or foreign company is guilty of the offence` FALSE EQUALS JUST FALSE
#ASSERT `s 386AN(4) the officer of the company or foreign company is guilty of the offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AN(4) the officer of the company or foreign company is guilty of the offence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 386AN(4) the most the company or foreign company or an officer in default may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (Penalty OF 25000, 0, FALSE, FALSE)
#ASSERT `s 386AN(4) the most the company or foreign company or an officer in default may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING
-- (5) and (6): arguments: the person is a member of the public; the disclosure is one that subsection (6) allows
#ASSERT `s 386AN(5) the Registrar is barred from disclosing the central register to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AN(5) the Registrar is barred from disclosing the central register to the person` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386AN(5) the Registrar is barred from disclosing the central register to the person` FALSE FALSE EQUALS NOTHING
-- EXPECT BREACH
#TRACE `s 386AN(5) the Registrar must not disclose the central register of controllers to a member of the public` `s 386AN test registrar` AT 0 WITH
    PARTY `s 386AN test registrar` DOES `s 386AN(5) disclose the central register of controllers, or make it available for inspection, to a member of the public` AT 9
-- EXPECT RESIDUAL
#TRACE `s 386AN(5) the Registrar must not disclose the central register of controllers to a member of the public` `s 386AN test registrar` AT 0 WITH
    (WAITUNTIL 400)
-- (6): arguments: the information is prescribed; the person is prescribed; the circumstances are prescribed
#ASSERT `s 386AN(6) the Registrar may disclose the information to the person` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AN(6) the Registrar may disclose the information to the person` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 386AN(6) the Registrar may disclose the information to the person` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 386AN(6) the Registrar may disclose the information to the person` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 386AN(7) different information and persons may be prescribed for the different circumstances` TRUE EQUALS JUST TRUE
#ASSERT `s 386AN(7) different information and persons may be prescribed for the different circumstances` FALSE EQUALS NOTHING

§ `s 386ANA: the central registers of nominee directors and nominee shareholders`

-- EXPECT FULFILLED
#TRACE `s 386ANA(1) the Registrar must keep a central register of nominee directors and a central register of nominee shareholders` `s 386AN test registrar` AT 0 WITH
    PARTY `s 386AN test registrar` DOES `s 386ANA(1) keep a central register of nominee directors and a central register of nominee shareholders` AT 3
-- EXPECT RESIDUAL
#TRACE `s 386ANA(1) the Registrar must keep a central register of nominee directors and a central register of nominee shareholders` `s 386AN test registrar` AT 0 WITH
    (WAITUNTIL 400)
-- (2): arguments: (a) particulars of nominee directors; (b) updates; (c) particulars of nominee shareholders; (d) updates
#ASSERT `s 386ANA(2) the company or foreign company has lodged what the subsection requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386ANA(2) the company or foreign company has lodged what the subsection requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386ANA(2) the company or foreign company has lodged what the subsection requires` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386ANA(2) the company or foreign company has lodged what the subsection requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 386ANA(2) the company or foreign company has lodged what the subsection requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- (3): arguments: lodged; in the prescribed form and manner; the day lodged; the day the prescribed time began; the prescribed time in days; the date asked
#ASSERT `s 386ANA(3) the company or foreign company has lodged in time and in the prescribed form and manner` TRUE TRUE (Date 15 6 2026) (Date 1 6 2026) 14 (Date 20 6 2026) EQUALS JUST TRUE
#ASSERT `s 386ANA(3) the company or foreign company has lodged in time and in the prescribed form and manner` TRUE TRUE (Date 16 6 2026) (Date 1 6 2026) 14 (Date 20 6 2026) EQUALS JUST FALSE
#ASSERT `s 386ANA(3) the company or foreign company has lodged in time and in the prescribed form and manner` FALSE FALSE (Date 1 1 2000) (Date 1 6 2026) 14 (Date 15 6 2026) EQUALS NOTHING
#ASSERT `s 386ANA(3) the company or foreign company has lodged in time and in the prescribed form and manner` FALSE FALSE (Date 1 1 2000) (Date 1 6 2026) 14 (Date 16 6 2026) EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 386ANA(3) a company or foreign company must lodge the particulars, matters and updates within the prescribed time` `s 386AN test company` 14 AT 0 WITH
    PARTY `s 386AN test company` DOES `s 386ANA(3) lodge with the Registrar the particulars and updates of its registers of nominee directors and nominee shareholders in the prescribed form and manner` AT 14
-- EXPECT BREACH
#TRACE `s 386ANA(3) a company or foreign company must lodge the particulars, matters and updates within the prescribed time` `s 386AN test company` 14 AT 0 WITH
    PARTY `s 386AN test company` DOES `s 386ANA(3) lodge with the Registrar the particulars and updates of its registers of nominee directors and nominee shareholders in the prescribed form and manner` AT 15
#ASSERT `s 386ANA(4) the company or foreign company is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 386ANA(4) the company or foreign company is guilty of the offence` FALSE EQUALS JUST FALSE
#ASSERT `s 386ANA(4) the officer of the company or foreign company is guilty of the offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386ANA(4) the officer of the company or foreign company is guilty of the offence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 386ANA(4) the most the company or foreign company or an officer in default may be sentenced to on conviction` TRUE FALSE TRUE EQUALS JUST (Penalty OF 25000, 0, FALSE, FALSE)
#ASSERT `s 386ANA(4) the most the company or foreign company or an officer in default may be sentenced to on conviction` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 386ANA(5) the Registrar is barred from disclosing the central registers of nominee directors and nominee shareholders to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386ANA(5) the Registrar is barred from disclosing the central registers of nominee directors and nominee shareholders to the person` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386ANA(5) the Registrar is barred from disclosing the central registers of nominee directors and nominee shareholders to the person` FALSE FALSE EQUALS NOTHING
-- EXPECT BREACH
#TRACE `s 386ANA(5) the Registrar must not disclose the central registers of nominee directors and nominee shareholders to a member of the public` `s 386AN test registrar` AT 0 WITH
    PARTY `s 386AN test registrar` DOES `s 386ANA(5) disclose the central register of nominee directors or the central register of nominee shareholders, or make it available for inspection, to a member of the public` AT 9
-- EXPECT RESIDUAL
#TRACE `s 386ANA(5) the Registrar must not disclose the central registers of nominee directors and nominee shareholders to a member of the public` `s 386AN test registrar` AT 0 WITH
    (WAITUNTIL 400)
#ASSERT `s 386ANA(6) the Registrar may disclose the information to the person` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386ANA(6) the Registrar may disclose the information to the person` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 386ANA(7) different information and persons may be prescribed for the different circumstances` TRUE EQUALS JUST TRUE
#ASSERT `s 386ANA(7) different information and persons may be prescribed for the different circumstances` FALSE EQUALS NOTHING

§ `s 386AO: codes of practice`

-- (1): arguments: the instrument; the purpose is guidance on a provision of the Part; the purpose is generally to carry out the purposes of the Part
#ASSERT `s 386AO(1) the Registrar may issue the instrument for the purpose` `s 386AO a code` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AO(1) the Registrar may issue the instrument for the purpose` `s 386AO guidance` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AO(1) the Registrar may issue the instrument for the purpose` `s 386AO a practice direction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AO(1) the Registrar may issue the instrument for the purpose` `s 386AO a guideline` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AO(1) the Registrar may issue the instrument for the purpose` `s 386AO a policy statement` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AO(1) the Registrar may issue the instrument for the purpose` `s 386AO a code` FALSE FALSE EQUALS NOTHING
#ASSERT `s 386AO(1) the Registrar may issue the instrument for the purpose` `s 386AO some other instrument` TRUE TRUE EQUALS NOTHING
#ASSERT `s 386AO(2) the Registrar may publish the instrument in such manner as the Registrar thinks fit` TRUE EQUALS JUST TRUE
#ASSERT `s 386AO(2) the Registrar may publish the instrument in such manner as the Registrar thinks fit` FALSE EQUALS NOTHING
#ASSERT `s 386AO(3) the Registrar may revoke, vary, revise or amend the instrument` TRUE EQUALS JUST TRUE
#ASSERT `s 386AO(3) the Registrar may revoke, vary, revise or amend the instrument` FALSE EQUALS NOTHING
-- (4)(b): arguments: the instrument has been amended; the context otherwise requires
#ASSERT `s 386AO(4)(b) a reference to the instrument is a reference to the instrument as amended` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AO(4)(b) a reference to the instrument is a reference to the instrument as amended` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386AO(4)(b) a reference to the instrument is a reference to the instrument as amended` FALSE FALSE EQUALS NOTHING
#ASSERT `s 386AO(4)(b) a reference to the instrument is a reference to the instrument as amended` FALSE TRUE EQUALS NOTHING
#ASSERT `s 386AO(5) the failure of itself renders the person liable to criminal proceedings` TRUE EQUALS JUST FALSE
#ASSERT `s 386AO(5) the failure of itself renders the person liable to criminal proceedings` FALSE EQUALS NOTHING
#ASSERT `s 386AO(5) a party to proceedings may rely on the failure as tending to establish or to negate a liability in question` TRUE EQUALS JUST TRUE
#ASSERT `s 386AO(5) a party to proceedings may rely on the failure as tending to establish or to negate a liability in question` FALSE EQUALS NOTHING
#ASSERT `s 386AO(6) the instrument is of a kind that the subsection allows` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 386AO(6) the instrument is of a kind that the subsection allows` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AO(6) the instrument is of a kind that the subsection allows` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AO(6) the instrument is of a kind that the subsection allows` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 386AO(7) the instrument must be published in the Gazette` TRUE EQUALS JUST FALSE
#ASSERT `s 386AO(7) the instrument must be published in the Gazette` FALSE EQUALS NOTHING

§ `s 386AP: exemption`

#ASSERT `s 386AP the person is exempt from the provision of this Part` TRUE EQUALS JUST TRUE
#ASSERT `s 386AP the person is exempt from the provision of this Part` FALSE EQUALS NOTHING
