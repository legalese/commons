IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgj-part5-office-name`

-- Tests for ss 142 to 144. Every expected value is written from the text of the section, not from the output of the code.
-- Notation: the arguments are in the order of each function's GIVEN.

§ `Section 142(1): registered office`

-- "must as from the date of its incorporation have a registered office within Singapore ... open and accessible to the public for not less than 3 hours ... on each business day"
#ASSERT `s 142(1) the company has a registered office as the subsection requires` TRUE 3 EQUALS JUST TRUE
#ASSERT `s 142(1) the company has a registered office as the subsection requires` TRUE 8 EQUALS JUST TRUE
-- one hour short of the minimum, and just under it
#ASSERT `s 142(1) the company has a registered office as the subsection requires` TRUE 2 EQUALS JUST FALSE
#ASSERT `s 142(1) the company has a registered office as the subsection requires` TRUE 2.5 EQUALS JUST FALSE
-- no registered office within Singapore from incorporation
#ASSERT `s 142(1) the company has a registered office as the subsection requires` FALSE 8 EQUALS JUST FALSE

-- EXPECT FULFILLED
#TRACE `s 142(1) the company must have a registered office from the date of its incorporation` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 142(1) have a registered office within Singapore from the date of incorporation` AT 0

-- the breach path: the office is established a day after incorporation
-- EXPECT BREACH
#TRACE `s 142(1) the company must have a registered office from the date of its incorporation` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 142(1) have a registered office within Singapore from the date of incorporation` AT 1

-- the breach path: no office is ever established
-- EXPECT BREACH
#TRACE `s 142(1) the company must have a registered office from the date of its incorporation` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 1)

-- the 3-hours limb has no time limit and no consequence the text states: it is never breached, and stays a standing duty
-- EXPECT RESIDUAL
#TRACE `s 142(1) the company must keep the registered office open for 3 hours on each business day` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- EXPECT FULFILLED
#TRACE `s 142(1) the company must keep the registered office open for 3 hours on each business day` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 142(1) keep the registered office open and accessible to the public for not less than 3 hours during ordinary business hours on each business day` AT 40

§ `Section 142(2): the offence`

-- default made, and the person is the company; default made, and the person is an officer in default
#ASSERT `s 142(2) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 142(2) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST TRUE
-- default made, but the person is neither the company nor an officer in default: the subsection makes them guilty of nothing
#ASSERT `s 142(2) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST FALSE
-- no default
#ASSERT `s 142(2) the person is guilty of the offence this subsection creates` FALSE TRUE TRUE EQUALS JUST FALSE
-- "a fine not exceeding $5,000 and also to a default penalty"
#ASSERT `s 142(2) the most the person may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (Penalty OF 5000, 0, FALSE, TRUE)
#ASSERT `s 142(2) the most the person may be sentenced to on conviction` TRUE FALSE TRUE EQUALS JUST (Penalty OF 5000, 0, FALSE, TRUE)
-- a person the subsection does not make guilty: no penalty is stated for them
#ASSERT `s 142(2) the most the person may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING

§ `Section 143(1): notice of the office and its hours`

-- "no notice of the days and hours ... is required if the office is open for at least 5 hours during ordinary business hours on each business day"
#ASSERT `s 143(1) the notice must state the days and hours during which the office is open and accessible to the public` 5 EQUALS JUST FALSE
#ASSERT `s 143(1) the notice must state the days and hours during which the office is open and accessible to the public` 8 EQUALS JUST FALSE
#ASSERT `s 143(1) the notice must state the days and hours during which the office is open and accessible to the public` 4 EQUALS JUST TRUE
#ASSERT `s 143(1) the notice must state the days and hours during which the office is open and accessible to the public` 4.9 EQUALS JUST TRUE
-- the proposed company's notice lodged together with the constitution at the time of lodgment for incorporation
#ASSERT `s 143(1) the proposed company's notice was lodged as the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 143(1) the proposed company's notice was lodged as the subsection requires` FALSE EQUALS JUST FALSE
-- "within 14 days after any such change": the day of the change is not counted (sg-periods P1), so a change on 1 January 2026 gives 15 January 2026
#ASSERT `s 143(1) the last day for lodging notice of a change of the particulars` (Date 1 1 2026) EQUALS Date 15 1 2026
-- over a month end: 25 January 2026 plus 14 days is 8 February 2026
#ASSERT `s 143(1) the last day for lodging notice of a change of the particulars` (Date 25 1 2026) EQUALS Date 8 2 2026
-- both sides of the last day, and a notice lodged on the day of the change itself
#ASSERT `s 143(1) the notice of the change was lodged within 14 days after the change` (Date 1 1 2026) (Date 14 1 2026) EQUALS JUST TRUE
#ASSERT `s 143(1) the notice of the change was lodged within 14 days after the change` (Date 1 1 2026) (Date 15 1 2026) EQUALS JUST TRUE
#ASSERT `s 143(1) the notice of the change was lodged within 14 days after the change` (Date 1 1 2026) (Date 16 1 2026) EQUALS JUST FALSE
#ASSERT `s 143(1) the notice of the change was lodged within 14 days after the change` (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST TRUE

-- the breach path: the notice is lodged on day 14 (in time), and on day 15 (late)
-- EXPECT FULFILLED
#TRACE `s 143(1) the company must lodge notice of a change of the particulars within 14 days` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 143(1) lodge notice of the change of the particulars of the registered office` AT 14

-- EXPECT BREACH
#TRACE `s 143(1) the company must lodge notice of a change of the particulars within 14 days` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 143(1) lodge notice of the change of the particulars of the registered office` AT 15

-- EXPECT BREACH
#TRACE `s 143(1) the company must lodge notice of a change of the particulars within 14 days` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 15)

-- EXPECT RESIDUAL
#TRACE `s 143(1) the company must lodge notice of a change of the particulars within 14 days` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 14)

§ `Section 143(1A) and (2)`

#ASSERT `s 143(1A) "particulars" the item is within the particulars of the situation of the registered office` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 143(1A) "particulars" the item is within the particulars of the situation of the registered office` FALSE TRUE EQUALS JUST TRUE
-- "includes": any other item is not covered
#ASSERT `s 143(1A) "particulars" the item is within the particulars of the situation of the registered office` FALSE FALSE EQUALS NOTHING
#ASSERT `s 143(2) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 143(2) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 143(2) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 143(2) the person is guilty of the offence this subsection creates` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 143(2) the most the person may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (Penalty OF 5000, 0, FALSE, TRUE)
#ASSERT `s 143(2) the most the person may be sentenced to on conviction` FALSE TRUE TRUE EQUALS NOTHING

§ `Section 144(1) and (1A): the name and the registration number`

-- (1): the seal and every (b) document; a thing not named is not covered
#ASSERT `s 144(1) the name of the company must appear on the item` `s 144 the company's seal` EQUALS JUST TRUE
#ASSERT `s 144(1) the name of the company must appear on the item` `s 144 a letter of credit` EQUALS JUST TRUE
#ASSERT `s 144(1) the name of the company must appear on the item` `s 144 a cheque` EQUALS JUST TRUE
#ASSERT `s 144(1) the name of the company must appear on the item` `s 144 another negotiable instrument` EQUALS NOTHING
#ASSERT `s 144(1) the name of the company must appear on the item` `s 144 some other thing` EQUALS NOTHING
#ASSERT `s 144(1) the company has complied with subsection (1) as to the item` `s 144 an invoice` TRUE EQUALS JUST TRUE
#ASSERT `s 144(1) the company has complied with subsection (1) as to the item` `s 144 an invoice` FALSE EQUALS JUST FALSE
#ASSERT `s 144(1) the company has complied with subsection (1) as to the item` `s 144 the company's seal` FALSE EQUALS JUST FALSE
#ASSERT `s 144(1) the company has complied with subsection (1) as to the item` `s 144 some other thing` FALSE EQUALS NOTHING
-- (1A): the shorter list, no seal and no instrument
#ASSERT `s 144(1A) the registration number of the company must appear on the item` `s 144 a business letter` EQUALS JUST TRUE
#ASSERT `s 144(1A) the registration number of the company must appear on the item` `s 144 a publication` EQUALS JUST TRUE
#ASSERT `s 144(1A) the registration number of the company must appear on the item` `s 144 the company's seal` EQUALS NOTHING
#ASSERT `s 144(1A) the registration number of the company must appear on the item` `s 144 a cheque` EQUALS NOTHING
#ASSERT `s 144(1A) the company has complied with subsection (1A) as to the item` `s 144 an official notice` TRUE EQUALS JUST TRUE
#ASSERT `s 144(1A) the company has complied with subsection (1A) as to the item` `s 144 an official notice` FALSE EQUALS JUST FALSE
#ASSERT `s 144(1A) the company has complied with subsection (1A) as to the item` `s 144 the company's seal` FALSE EQUALS NOTHING

§ `Section 144(1B) and (2): the offences and the liability to the holder`

#ASSERT `s 144(1B) the person is guilty of the offence this subsection creates` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 144(1B) the person is guilty of the offence this subsection creates` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 144(1B) the person is guilty of the offence this subsection creates` FALSE TRUE EQUALS JUST FALSE
-- no penalty is stated in s 144(1B) or (2): the text does not say
#ASSERT `s 144(1B) the most the company may be sentenced to on conviction` TRUE TRUE EQUALS NOTHING
#ASSERT `s 144(2) the most the person may be sentenced to on conviction` TRUE `s 144(2)(a) used or authorised the use of a seal purporting to be a seal of the company whereon its name does not appear in legible romanised letters` EQUALS NOTHING
#ASSERT `s 144(2) the person is guilty of the offence this subsection creates` TRUE `s 144(2)(a) used or authorised the use of a seal purporting to be a seal of the company whereon its name does not appear in legible romanised letters` EQUALS JUST TRUE
#ASSERT `s 144(2) the person is guilty of the offence this subsection creates` TRUE `s 144(2)(b) issued or authorised the issue of a business letter, statement of account, invoice, official notice or publication of the company wherein its name is not mentioned` EQUALS JUST TRUE
#ASSERT `s 144(2) the person is guilty of the offence this subsection creates` TRUE `s 144(2)(c) signed, issued or authorised to be signed or issued on behalf of the company a bill of exchange, promissory note, cheque or other negotiable instrument or an indorsement, order, receipt or letter of credit wherein its name is not mentioned` EQUALS JUST TRUE
#ASSERT `s 144(2) the person is guilty of the offence this subsection creates` FALSE `s 144(2)(b) issued or authorised the issue of a business letter, statement of account, invoice, official notice or publication of the company wherein its name is not mentioned` EQUALS JUST FALSE
#ASSERT `s 144(2) the person is guilty of the offence this subsection creates` TRUE `s 144(2) did something else` EQUALS NOTHING
-- the additional liability to the holder: "unless it is paid by the company"
#ASSERT `s 144(2) the person is liable to the holder of the instrument for the amount due on it` `s 144(2) a bill of exchange` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 144(2) the person is liable to the holder of the instrument for the amount due on it` `s 144(2) a bill of exchange` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 144(2) the person is liable to the holder of the instrument for the amount due on it` `s 144(2) a promissory note` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 144(2) the person is liable to the holder of the instrument for the amount due on it` `s 144(2) an indorsement on one of those` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 144(2) the person is liable to the holder of the instrument for the amount due on it` `s 144(2) an order` TRUE TRUE EQUALS JUST FALSE
-- the person did not sign or issue the instrument without the name: nothing is said
#ASSERT `s 144(2) the person is liable to the holder of the instrument for the amount due on it` `s 144(2) a bill of exchange` FALSE FALSE EQUALS NOTHING
-- a cheque is a negotiable instrument (limb (c) of the same subsection writes "cheque or other negotiable instrument"): the liability clause reaches it (fork F-j144-4, changed after the wave-2 reader)
#ASSERT `s 144(2) the person is liable to the holder of the instrument for the amount due on it` `s 144(2) a cheque` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 144(2) the person is liable to the holder of the instrument for the amount due on it` `s 144(2) a cheque` TRUE TRUE EQUALS JUST FALSE
-- a receipt is not named in the liability clause (fork F-j144-4)
#ASSERT `s 144(2) the person is liable to the holder of the instrument for the amount due on it` `s 144(2) a receipt` TRUE FALSE EQUALS NOTHING
#ASSERT `s 144(2) the person is liable to the holder of the instrument for the amount due on it` `s 144(2) a letter of credit` TRUE FALSE EQUALS NOTHING
