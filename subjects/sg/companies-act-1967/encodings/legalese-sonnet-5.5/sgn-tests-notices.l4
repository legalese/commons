#ASSERT `s 386AJ(4) the person is guilty of the offence` FALSE EQUALS JUST FALSE
#ASSERT `s 386AJ(4) the most the person may be sentenced to on conviction` TRUE EQUALS JUST (Penalty OF 25000, 0, FALSE, FALSE)
#ASSERT `s 386AJ(4) the most the person may be sentenced to on conviction` FALSE EQUALS NOTHING

§ `s 386AK: the controller's duty to provide change of information`

-- (5): arguments: a person ceases to be a registrable controller; a change in the contact details or other prescribed particulars
#ASSERT `s 386AK(5) a relevant change occurs` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AK(5) a relevant change occurs` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AK(5) a relevant change occurs` FALSE FALSE EQUALS JUST FALSE
-- (1) and (3): arguments: the person is a controller who knows or ought to know of a relevant change; the person has received a notice under 386AH(1) and complied with it in time
#ASSERT `s 386AK(1) the person must notify the company or foreign company of the relevant change` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AK(1) the person must notify the company or foreign company of the relevant change` TRUE TRUE EQUALS JUST FALSE
