IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgc1-s202`

-- Tests for sgc1-s202.l4 (ss 202, 202A and 202B). Expected values are written from the text, beside each assertion.

§ `s 202(1): the application`

-- a requirement on the form and content of the financial statements that is not a requirement of the Accounting Standards
#ASSERT `s 202(1) the directors may apply to the Registrar in writing for an order relieving them from the requirement` TRUE FALSE FALSE EQUALS JUST TRUE
-- a requirement of the Accounting Standards: outside the grant, "(other than a requirement of the Accounting Standards)"
#ASSERT `s 202(1) the directors may apply to the Registrar in writing for an order relieving them from the requirement` TRUE TRUE FALSE EQUALS NOTHING
-- the form and content of the statement required by section 201(16)
#ASSERT `s 202(1) the directors may apply to the Registrar in writing for an order relieving them from the requirement` FALSE FALSE TRUE EQUALS JUST TRUE
-- a requirement on neither
#ASSERT `s 202(1) the directors may apply to the Registrar in writing for an order relieving them from the requirement` FALSE FALSE FALSE EQUALS NOTHING
-- the section 201(16) limb carries no Accounting Standards exception
#ASSERT `s 202(1) the directors may apply to the Registrar in writing for an order relieving them from the requirement` TRUE TRUE TRUE EQUALS JUST TRUE

#ASSERT `s 202(1) the Registrar may make the order on condition that the directors comply with the other requirement` TRUE TRUE EQUALS JUST TRUE
-- a requirement on something else, or one the Registrar does not think fit
#ASSERT `s 202(1) the Registrar may make the order on condition that the directors comply with the other requirement` FALSE TRUE EQUALS NOTHING
#ASSERT `s 202(1) the Registrar may make the order on condition that the directors comply with the other requirement` TRUE FALSE EQUALS NOTHING

§ `s 202(4): how long the order lasts`

#ASSERT `s 202(4) the order made under section 202(1) has not ended` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- limited to a specific period that has not ended
#ASSERT `s 202(4) the order made under section 202(1) has not ended` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- limited to a specific period that has ended
#ASSERT `s 202(4) the order made under section 202(1) has not ended` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- not limited to a period
#ASSERT `s 202(4) the order made under section 202(1) has not ended` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- revoked
#ASSERT `s 202(4) the order made under section 202(1) has not ended` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- suspended
#ASSERT `s 202(4) the order made under section 202(1) has not ended` FALSE FALSE FALSE TRUE EQUALS JUST FALSE

§ `s 202(1) and (2): are the directors relieved?`

-- no order on the directors' application: the text does not say
#ASSERT `s 202(1) the directors are relieved by the Registrar's order from the requirement` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- an unconditional order
#ASSERT `s 202(1) the directors are relieved by the Registrar's order from the requirement` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- an order limited to a period that is still running, and one whose period has ended
#ASSERT `s 202(1) the directors are relieved by the Registrar's order from the requirement` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 202(1) the directors are relieved by the Registrar's order from the requirement` TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- revoked, suspended
#ASSERT `s 202(1) the directors are relieved by the Registrar's order from the requirement` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 202(1) the directors are relieved by the Registrar's order from the requirement` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- made on condition: not met, met
#ASSERT `s 202(1) the directors are relieved by the Registrar's order from the requirement` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 202(1) the directors are relieved by the Registrar's order from the requirement` TRUE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- an unconditional order, and the directors happen to comply with other requirements anyway
#ASSERT `s 202(1) the directors are relieved by the Registrar's order from the requirement` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE

#ASSERT `s 202(2) the directors are relieved by the Registrar's order for a class of companies from the requirement` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 202(2) the directors are relieved by the Registrar's order for a class of companies from the requirement` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 202(2) the directors are relieved by the Registrar's order for a class of companies from the requirement` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 202(2) the directors are relieved by the Registrar's order for a class of companies from the requirement` TRUE TRUE TRUE EQUALS JUST TRUE

§ `s 202(3): the Registrar's opinion`

#ASSERT `s 202(3) the Registrar is not barred from making an order under section 202(1)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 202(3) the Registrar is not barred from making an order under section 202(1)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 202(3) the Registrar is not barred from making an order under section 202(1)` TRUE TRUE EQUALS JUST TRUE
-- "must not make an order ... unless" an opinion: neither opinion, a bar
#ASSERT `s 202(3) the Registrar is not barred from making an order under section 202(1)` FALSE FALSE EQUALS JUST FALSE

§ `s 202A(1): when the revision is open`

-- no annual general meeting needed: open after the statements are sent to the members under section 203
#ASSERT `s 202A(1) the section applies` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 202A(1) the section applies` TRUE FALSE FALSE EQUALS JUST FALSE
-- no annual general meeting needed: laying at a meeting does not open it
#ASSERT `s 202A(1) the section applies` TRUE FALSE TRUE EQUALS JUST FALSE
-- any other case: open after the statements are laid at the annual general meeting
#ASSERT `s 202A(1) the section applies` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 202A(1) the section applies` FALSE FALSE FALSE EQUALS JUST FALSE
-- any other case: sending to the members does not open it
#ASSERT `s 202A(1) the section applies` FALSE TRUE FALSE EQUALS JUST FALSE

§ `s 202A(2): the directors may cause the statements to be revised`

#ASSERT `s 202A(2) the directors may cause the financial statements to be revised` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 202A(2) the directors may cause the financial statements to be revised` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- the section applies but it does not appear to the directors that the statements fail
#ASSERT `s 202A(2) the directors may cause the financial statements to be revised` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- the section does not apply yet
#ASSERT `s 202A(2) the directors may cause the financial statements to be revised` FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 202A(2) the directors may cause the financial statements to be revised` TRUE FALSE TRUE TRUE EQUALS JUST FALSE

§ `s 202A(3): what the revision may touch`

#ASSERT `s 202A(3) the revision is confined as the subsection requires` FALSE EQUALS JUST TRUE
#ASSERT `s 202A(3) the revision is confined as the subsection requires` TRUE EQUALS JUST FALSE

§ `s 202A(4): after the Registrar's notice`

-- no notice: no bar from this subsection
#ASSERT `s 202A(4) the directors are barred from causing the financial statements to be revised` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 202A(4) the directors are barred from causing the financial statements to be revised` FALSE TRUE EQUALS JUST FALSE
-- a notice and no agreement: barred
#ASSERT `s 202A(4) the directors are barred from causing the financial statements to be revised` TRUE FALSE EQUALS JUST TRUE
-- a notice and the Registrar agrees: not barred
#ASSERT `s 202A(4) the directors are barred from causing the financial statements to be revised` TRUE TRUE EQUALS JUST FALSE

§ `s 202B(1): the Registrar's notice`

#ASSERT `s 202B(1) the Registrar may give the directors a notice` TRUE EQUALS JUST TRUE
#ASSERT `s 202B(1) the Registrar may give the directors a notice` FALSE EQUALS NOTHING

§ `s 202B(2): the directors' response`

-- the Registrar specified 28 days and allowed no longer period: 28 days from 1 March 2026 is 29 March 2026
#ASSERT `s 202B(2) the number of days allowed for the response` 28 NOTHING EQUALS 28
-- a longer period of 45 days: 1 March plus 45 days is 15 April 2026
#ASSERT `s 202B(2) the number of days allowed for the response` 28 (JUST 45) EQUALS 45
-- a "longer" period that is not longer does not shorten the period
#ASSERT `s 202B(2) the number of days allowed for the response` 28 (JUST 20) EQUALS 28
#ASSERT `s 202B(2) the last day for the directors to respond` (Date 1 3 2026) 28 NOTHING EQUALS (Date 29 3 2026)
#ASSERT `s 202B(2) the last day for the directors to respond` (Date 1 3 2026) 28 (JUST 45) EQUALS (Date 15 4 2026)
-- both sides of the last day
#ASSERT `s 202B(2) the directors responded by the end of the period` (Date 1 3 2026) 28 NOTHING (Date 29 3 2026) EQUALS TRUE
#ASSERT `s 202B(2) the directors responded by the end of the period` (Date 1 3 2026) 28 NOTHING (Date 30 3 2026) EQUALS FALSE
#ASSERT `s 202B(2) the directors responded by the end of the period` (Date 1 3 2026) 28 NOTHING (Date 5 3 2026) EQUALS TRUE
#ASSERT `s 202B(2) the directors responded by the end of the period` (Date 1 3 2026) 28 (JUST 45) (Date 15 4 2026) EQUALS TRUE
#ASSERT `s 202B(2) the directors responded by the end of the period` (Date 1 3 2026) 28 (JUST 45) (Date 16 4 2026) EQUALS FALSE

-- notice given, the directors do not propose to revise: they must explain
#ASSERT `s 202B(2)(a) the directors must give the Registrar an explanation of the financial statements` TRUE FALSE EQUALS JUST TRUE
-- the directors propose to revise: the "if" of paragraph (a) fails
#ASSERT `s 202B(2)(a) the directors must give the Registrar an explanation of the financial statements` TRUE TRUE EQUALS JUST FALSE
-- no notice: the duty is that of the directors "to whom notice under subsection (1) is given"
#ASSERT `s 202B(2)(a) the directors must give the Registrar an explanation of the financial statements` FALSE FALSE EQUALS NOTHING
#ASSERT `s 202B(2)(a) the directors must give the Registrar an explanation of the financial statements` FALSE TRUE EQUALS NOTHING
#ASSERT `s 202B(2)(b) the directors must inform the Registrar how they propose to revise the financial statements` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 202B(2)(b) the directors must inform the Registrar how they propose to revise the financial statements` TRUE FALSE EQUALS NOTHING
#ASSERT `s 202B(2)(b) the directors must inform the Registrar how they propose to revise the financial statements` FALSE TRUE EQUALS NOTHING

-- 28 days from the notice: the response on day 28 is in time, silence to day 29 is a breach
-- EXPECT FULFILLED
#TRACE `s 202B(2) the directors must respond to the Registrar's notice by the end of the period` "Ann" 28 AT 0 WITH
    PARTY Director "Ann" DOES `s 202B(2) give the Registrar the explanation, or the proposed revision, that the subsection requires` AT 28

-- EXPECT BREACH
#TRACE `s 202B(2) the directors must respond to the Registrar's notice by the end of the period` "Ann" 28 AT 0 WITH
    WAITUNTIL 29

-- EXPECT BREACH
#TRACE `s 202B(2) the directors must respond to the Registrar's notice by the end of the period` "Ann" 28 AT 0 WITH
    PARTY Director "Ann" DOES `s 202B(2) give the Registrar the explanation, or the proposed revision, that the subsection requires` AT 29

§ `s 202B(3) and (4): after the response`

#ASSERT `s 202B(3) the directors need take no further action on the notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 202B(3) the directors need take no further action on the notice` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 202B(3) the directors need take no further action on the notice` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 202B(3) the directors need take no further action on the notice` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 202B(4) the directors may cause the financial statements to be revised in the manner agreed` TRUE EQUALS JUST TRUE
#ASSERT `s 202B(4) the directors may cause the financial statements to be revised in the manner agreed` FALSE EQUALS NOTHING

§ `s 202B(5) and (6): the Registrar applies to Court`

-- each of the three cases in turn
#ASSERT `s 202B(5) the Registrar may apply to Court under subsection (6)` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 202B(5) the Registrar may apply to Court under subsection (6)` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 202B(5) the Registrar may apply to Court under subsection (6)` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 202B(5) the Registrar may apply to Court under subsection (6)` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 202B(6) the application to Court may be for the relief` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 202B(6) the application to Court may be for the relief` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 202B(6) the application to Court may be for the relief` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 202B(6) the application to Court may be for the relief` FALSE FALSE EQUALS NOTHING

§ `s 202B(7): the Court's directions`

#ASSERT `s 202B(7) the Court may give directions on the matter` TRUE `s 202B(7)(a) the auditing of the financial statements, or consolidated financial statements or balance sheet` EQUALS JUST TRUE
#ASSERT `s 202B(7) the Court may give directions on the matter` TRUE `s 202B(7)(b) the making of revisions within a specified period` EQUALS JUST TRUE
#ASSERT `s 202B(7) the Court may give directions on the matter` TRUE `s 202B(7)(c) the review by the auditors of the revised summary financial statement` EQUALS JUST TRUE
#ASSERT `s 202B(7) the Court may give directions on the matter` TRUE `s 202B(7)(d) the making of necessary consequential revisions to any other document` EQUALS JUST TRUE
#ASSERT `s 202B(7) the Court may give directions on the matter` TRUE `s 202B(7)(e) the taking of steps to bring the order to the notice of persons likely to rely on the previous statements` EQUALS JUST TRUE
#ASSERT `s 202B(7) the Court may give directions on the matter` TRUE `s 202B(7)(f) such other matters as the Court thinks fit` EQUALS JUST TRUE
-- the Court has not ordered revised statements under subsection (6)
#ASSERT `s 202B(7) the Court may give directions on the matter` FALSE `s 202B(7)(a) the auditing of the financial statements, or consolidated financial statements or balance sheet` EQUALS JUST FALSE
#ASSERT `s 202B(7) the Court may give directions on the matter` FALSE `s 202B(7)(f) such other matters as the Court thinks fit` EQUALS JUST FALSE

§ `s 202B(8): who bears the costs`

#ASSERT `s 202B(8) the Court may order that the director bears all or part of the costs and expenses` TRUE TRUE EQUALS JUST TRUE
-- not a director as at the date of the directors' statement
#ASSERT `s 202B(8) the Court may order that the director bears all or part of the costs and expenses` TRUE FALSE EQUALS NOTHING
-- the Court did not find non-compliance
#ASSERT `s 202B(8) the Court may order that the director bears all or part of the costs and expenses` FALSE TRUE EQUALS NOTHING
#ASSERT `s 202B(8) the Court may order that the director bears all or part of the costs and expenses` FALSE FALSE EQUALS NOTHING

§ `s 202B(9): revised statements revised again`

#ASSERT `s 202B(9) the section applies to the statements as it applies to the first statements` TRUE EQUALS JUST TRUE
#ASSERT `s 202B(9) the section applies to the statements as it applies to the first statements` FALSE EQUALS NOTHING
