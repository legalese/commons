#ASSERT `s 78C(3) the company meets the solvency requirements` (`s 78B(3) test statement` (Date 3 5 2026) `a reduction of share capital under section 78B or 78C` 3 FALSE) TRUE TRUE (Date 1 6 2026) (Date 1 6 2026) TRUE (Date 16 6 2026) FALSE (Date 1 1 2020) EQUALS JUST FALSE
#ASSERT `s 78C(3) the company meets the solvency requirements` (`s 78B(3) test statement` (Date 3 5 2026) `a reduction of share capital under section 78B or 78C` 3 FALSE) TRUE TRUE (Date 1 6 2026) (Date 1 6 2026) TRUE (Date 31 5 2026) FALSE (Date 1 1 2020) EQUALS JUST FALSE
#ASSERT `s 78C(3) the company meets the solvency requirements` (`s 78B(3) test statement` (Date 3 5 2026) `a reduction of share capital under section 78B or 78C` 3 FALSE) TRUE TRUE (Date 1 6 2026) (Date 1 6 2026) FALSE (Date 15 6 2026) FALSE (Date 1 1 2020) EQUALS JUST FALSE
#ASSERT `s 78C(3) the company meets the solvency requirements` (`s 78B(3) test statement` (Date 3 5 2026) `a reduction of share capital under section 78B or 78C` 3 FALSE) TRUE FALSE (Date 1 6 2026) (Date 1 6 2026) TRUE (Date 15 6 2026) FALSE (Date 1 1 2020) EQUALS JUST FALSE
-- The statement (3 May) is made after the day (4)(a) falls due (2 May): not in time.
#ASSERT `s 78C(3) the company meets the solvency requirements` (`s 78B(3) test statement` (Date 3 5 2026) `a reduction of share capital under section 78B or 78C` 3 FALSE) TRUE TRUE (Date 1 6 2026) (Date 2 5 2026) TRUE (Date 15 6 2026) FALSE (Date 1 1 2020) EQUALS JUST FALSE
#ASSERT `s 78C(3) the company meets the solvency requirements` (`s 78B(3) test statement` (Date 3 5 2026) `a reduction of share capital under section 78B or 78C` 3 FALSE) TRUE TRUE (Date 1 6 2026) (Date 3 5 2026) TRUE (Date 15 6 2026) FALSE (Date 1 1 2020) EQUALS JUST TRUE
-- (6) a requirement under (3)(c) ceases if the resolution is revoked: revoked on 15 June no lodgement is needed; revoked on 16 June it was already missed.
#ASSERT `s 78C(3) the company meets the solvency requirements` (`s 78B(3) test statement` (Date 3 5 2026) `a reduction of share capital under section 78B or 78C` 3 FALSE) TRUE TRUE (Date 1 6 2026) (Date 1 6 2026) FALSE (Date 1 1 2020) TRUE (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 78C(3) the company meets the solvency requirements` (`s 78B(3) test statement` (Date 3 5 2026) `a reduction of share capital under section 78B or 78C` 3 FALSE) TRUE TRUE (Date 1 6 2026) (Date 1 6 2026) FALSE (Date 1 1 2020) TRUE (Date 16 6 2026) EQUALS JUST FALSE
