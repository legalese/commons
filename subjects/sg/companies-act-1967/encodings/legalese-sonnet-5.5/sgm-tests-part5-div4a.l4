IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgm-part5-div4a`

-- Tests of sgm-part5-div4a.l4 (ss 196A to 196E). Every expected value is written from the text, beside the assertion.
-- Dates are Date day month year. The trace clock counts days after the day of the event (AT 0).

§ `Fixtures`

-- One register of members, built from eight facts, in the order of the record: names, addresses, share capital, statement of shares,
-- allotment dates, date of entry, date of ceasing (previous 7 years), changes since 3 January 2016.
GIVEN `the names` IS A BOOLEAN
      `the addresses` IS A BOOLEAN
      `the share capital` IS A BOOLEAN
      `the statement of shares` IS A BOOLEAN
      `the allotment dates` IS A BOOLEAN
      `the date of entry` IS A BOOLEAN
      `the date of ceasing` IS A BOOLEAN
      `the changes` IS A BOOLEAN
GIVETH A `s 196A(2) electronic register entries`
`a register with` MEANS `s 196A(2) electronic register entries` WITH
    `the register contains the names of the members` IS `the names`
    `the register contains the addresses of the members that the paragraph requires` IS `the addresses`
    `the company has a share capital` IS `the share capital`
    `the register contains a statement of the shares held by each member and of the amount paid or agreed to be considered as paid on the shares of each member` IS `the statement of shares`
    `the register contains the date of every allotment of shares to members (including any deemed allotment as defined in section 63(3)) and the number of shares comprised in each allotment` IS `the allotment dates`
    `the register contains the date on which the name of each person was entered in the register as a member` IS `the date of entry`
    `the register contains the date on which each person who ceased to be a member during the previous 7 years so ceased to be a member` IS `the date of ceasing`
    `the register shows every change to the information in paragraph (a)(i), (ii) and (iii) that occurs on or after 3 January 2016` IS `the changes`

`a complete register of a company with a share capital` MEANS `a register with` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE
`a complete register of a company with no share capital` MEANS `a register with` TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE
`a register with no names` MEANS `a register with` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE
`a register with no addresses` MEANS `a register with` TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE
`a register with no statement of shares` MEANS `a register with` TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE
`a register with no allotment dates` MEANS `a register with` TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE
`a register with no date of entry` MEANS `a register with` TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE
`a register with no date of ceasing` MEANS `a register with` TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE
`a register with no changes shown` MEANS `a register with` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE

§ `s 196A(1): the Registrar keeps the register`

-- "On and after 3 January 2016, the Registrar must, in respect of every private company, keep and maintain an electronic register of members"
#ASSERT `s 196A(1) the Registrar must keep an electronic register of members of the company` TRUE (Date 3 1 2016) EQUALS JUST TRUE
#ASSERT `s 196A(1) the Registrar must keep an electronic register of members of the company` TRUE (Date 2 1 2016) EQUALS JUST FALSE
#ASSERT `s 196A(1) the Registrar must keep an electronic register of members of the company` TRUE (Date 1 3 2026) EQUALS JUST TRUE
-- a company that is not private: the text says nothing of it
#ASSERT `s 196A(1) the Registrar must keep an electronic register of members of the company` FALSE (Date 1 3 2026) EQUALS NOTHING
-- the duty has no time limit: no event leaves it open, the Registrar's act fulfils it
-- EXPECT RESIDUAL
#TRACE `s 196A(1) the Registrar must keep an electronic register of members of every private company` AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 196A(1) the Registrar must keep an electronic register of members of every private company` AT 0 WITH
    PARTY Registrar DOES `s 196A(1) keep and maintain an electronic register of members of the private company` AT 4

§ `s 196A(2): what the electronic register contains`

-- (a)(i): the names
#ASSERT `s 196A(2)(a)(i) the register contains the names of the members` `a complete register of a company with a share capital` EQUALS JUST TRUE
#ASSERT `s 196A(2)(a)(i) the register contains the names of the members` `a register with no names` EQUALS JUST FALSE
-- (a)(ii): the residential address and contact address of an individual, the address of any other member
#ASSERT `s 196A(2)(a)(ii) the register contains the addresses the paragraph requires of the member` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 196A(2)(a)(ii) the register contains the addresses the paragraph requires of the member` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 196A(2)(a)(ii) the register contains the addresses the paragraph requires of the member` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 196A(2)(a)(ii) the register contains the addresses the paragraph requires of the member` TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 196A(2)(a)(ii) the register contains the addresses the paragraph requires of the member` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 196A(2)(a)(ii) the register contains the addresses the paragraph requires of the member` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- (a)(iii)(A): the statement of shares, for a company having a share capital only
#ASSERT `s 196A(2)(a)(iii)(A) the register contains the statement of the shares and of the amount paid, for a company having a share capital` `a complete register of a company with a share capital` EQUALS JUST TRUE
#ASSERT `s 196A(2)(a)(iii)(A) the register contains the statement of the shares and of the amount paid, for a company having a share capital` `a register with no statement of shares` EQUALS JUST FALSE
#ASSERT `s 196A(2)(a)(iii)(A) the register contains the statement of the shares and of the amount paid, for a company having a share capital` `a complete register of a company with no share capital` EQUALS JUST TRUE
-- (a)(iii)(B): the allotment dates, for a company having a share capital only
#ASSERT `s 196A(2)(a)(iii)(B) the register contains the date and size of every allotment, for a company having a share capital` `a complete register of a company with a share capital` EQUALS JUST TRUE
#ASSERT `s 196A(2)(a)(iii)(B) the register contains the date and size of every allotment, for a company having a share capital` `a register with no allotment dates` EQUALS JUST FALSE
#ASSERT `s 196A(2)(a)(iii)(B) the register contains the date and size of every allotment, for a company having a share capital` `a complete register of a company with no share capital` EQUALS JUST TRUE
-- (a)(iv): the date of entry as a member
#ASSERT `s 196A(2)(a)(iv) the register contains the date on which the name of each person was entered as a member` `a complete register of a company with a share capital` EQUALS JUST TRUE
#ASSERT `s 196A(2)(a)(iv) the register contains the date on which the name of each person was entered as a member` `a register with no date of entry` EQUALS JUST FALSE
-- (a)(v): "any person who ceased to be a member during the previous 7 years"; asked on 3 January 2027 the window runs 3 January 2020 to 2 January 2027 (P6)
#ASSERT `s 196A(2)(a)(v) the person ceased to be a member during the previous 7 years` (Date 3 1 2020) (Date 3 1 2027)
#ASSERT NOT (`s 196A(2)(a)(v) the person ceased to be a member during the previous 7 years` (Date 2 1 2020) (Date 3 1 2027))
#ASSERT `s 196A(2)(a)(v) the person ceased to be a member during the previous 7 years` (Date 2 1 2027) (Date 3 1 2027)
#ASSERT NOT (`s 196A(2)(a)(v) the person ceased to be a member during the previous 7 years` (Date 3 1 2027) (Date 3 1 2027))
-- asked on 29 February 2028: 7 years back lands on a year with no 29 February, so the window opens on 28 February 2021 (P4)
#ASSERT `s 196A(2)(a)(v) the person ceased to be a member during the previous 7 years` (Date 28 2 2021) (Date 29 2 2028)
#ASSERT NOT (`s 196A(2)(a)(v) the person ceased to be a member during the previous 7 years` (Date 27 2 2021) (Date 29 2 2028))
#ASSERT `s 196A(2)(a)(v) the register must contain the date on which the person ceased to be a member` (Date 3 1 2020) (Date 3 1 2027) EQUALS JUST TRUE
#ASSERT `s 196A(2)(a)(v) the register must contain the date on which the person ceased to be a member` (Date 2 1 2020) (Date 3 1 2027) EQUALS JUST FALSE
#ASSERT `s 196A(2)(a)(v) the register must contain the date on which the person ceased to be a member` (Date 2 1 2027) (Date 3 1 2027) EQUALS JUST TRUE
-- (b): changes on or after 3 January 2016
#ASSERT `s 196A(2)(b) the register shows the changes to the information that occur on or after 3 January 2016` `a complete register of a company with a share capital` EQUALS JUST TRUE
#ASSERT `s 196A(2)(b) the register shows the changes to the information that occur on or after 3 January 2016` `a register with no changes shown` EQUALS JUST FALSE
-- the whole subsection
#ASSERT `s 196A(2) the electronic register contains what the subsection requires` `a complete register of a company with a share capital` EQUALS JUST TRUE
#ASSERT `s 196A(2) the electronic register contains what the subsection requires` `a complete register of a company with no share capital` EQUALS JUST TRUE
#ASSERT `s 196A(2) the electronic register contains what the subsection requires` `a register with no names` EQUALS JUST FALSE
#ASSERT `s 196A(2) the electronic register contains what the subsection requires` `a register with no addresses` EQUALS JUST FALSE
#ASSERT `s 196A(2) the electronic register contains what the subsection requires` `a register with no statement of shares` EQUALS JUST FALSE
#ASSERT `s 196A(2) the electronic register contains what the subsection requires` `a register with no allotment dates` EQUALS JUST FALSE
#ASSERT `s 196A(2) the electronic register contains what the subsection requires` `a register with no date of entry` EQUALS JUST FALSE
#ASSERT `s 196A(2) the electronic register contains what the subsection requires` `a register with no date of ceasing` EQUALS JUST FALSE
#ASSERT `s 196A(2) the electronic register contains what the subsection requires` `a register with no changes shown` EQUALS JUST FALSE

§ `s 196A(3) to (6): stock, changes, updating and evidence`

-- (3): "Where a private company has converted any of its shares into stock and the company notifies the Registrar of this fact"
#ASSERT `s 196A(3) the electronic register must show stock instead of shares` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 196A(3) the electronic register must show stock instead of shares` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 196A(3) the electronic register must show stock instead of shares` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 196A(3) the electronic register must show stock instead of shares` FALSE FALSE EQUALS JUST FALSE
-- (4): a purchase to which section 76H applies, "unless the company cancels all the shares or stocks immediately after the purchase"
#ASSERT `s 196A(4) particulars of the change must be given to the Registrar` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 196A(4) particulars of the change must be given to the Registrar` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 196A(4) particulars of the change must be given to the Registrar` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 196A(4) particulars of the change must be given to the Registrar` FALSE TRUE EQUALS JUST FALSE
-- (5): "any change that is required or authorised by any provision of this Act to be lodged with the Registrar, including section 31(1), ..."
#ASSERT `s 196A(5) the Registrar must update the electronic register of members in accordance with the change` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 196A(5) the Registrar must update the electronic register of members in accordance with the change` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 196A(5) the Registrar must update the electronic register of members in accordance with the change` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 196A(5) the Registrar must update the electronic register of members in accordance with the change` FALSE FALSE EQUALS NOTHING
-- the duty has no time limit
-- EXPECT RESIDUAL
#TRACE `s 196A(5) the Registrar must update the electronic register of members` 7 AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 196A(5) the Registrar must update the electronic register of members` 7 AT 0 WITH
    PARTY Registrar DOES `s 196A(5) update the electronic register of members in accordance with the change` AT 2
-- (6): an entry is prima facie evidence of the matters the Act directs or authorises to be entered
#ASSERT `s 196A(6) the entry is prima facie evidence of the truth of the matter` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 196A(6) the entry is prima facie evidence of the truth of the matter` TRUE FALSE EQUALS NOTHING
#ASSERT `s 196A(6) the entry is prima facie evidence of the truth of the matter` FALSE TRUE EQUALS NOTHING
#ASSERT `s 196A(6) the entry is prima facie evidence of the truth of the matter` FALSE FALSE EQUALS NOTHING

§ `s 196B: information from private companies that existed before 3 January 2016`

#ASSERT `s 196B(1) the private company must lodge the information with the Registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 196B(1) the private company must lodge the information with the Registrar` FALSE EQUALS NOTHING
-- (a): 6 months after 3 January 2016 is 3 July 2016
#ASSERT `s 196B(1)(a) the date 6 months after 3 January 2016` EQUALS Date 3 7 2016
-- the earlier of 6 months after 3 January 2016 and the first return date
#ASSERT `s 196B(1) the last day for lodging the information` (Date 30 6 2016) EQUALS Date 30 6 2016
#ASSERT `s 196B(1) the last day for lodging the information` (Date 31 12 2016) EQUALS Date 3 7 2016
#ASSERT `s 196B(1) the last day for lodging the information` (Date 3 7 2016) EQUALS Date 3 7 2016
#ASSERT `s 196B(1) the information was lodged by the last day` (Date 31 12 2016) (Date 3 7 2016)
#ASSERT NOT (`s 196B(1) the information was lodged by the last day` (Date 31 12 2016) (Date 4 7 2016))
#ASSERT `s 196B(1) the information was lodged by the last day` (Date 30 6 2016) (Date 30 6 2016)
#ASSERT NOT (`s 196B(1) the information was lodged by the last day` (Date 30 6 2016) (Date 1 7 2016))
-- the trace: the clock counts days after 3 January 2016. First return due 30 June 2016 (day 179): the last day is day 179
-- EXPECT FULFILLED
#TRACE `s 196B(1) a private company must lodge the information by the earlier of the two dates` "Acme Pte Ltd" (Date 30 6 2016) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 196B(1) lodge with the Registrar the information necessary to be included in the electronic register of members` AT 179
-- EXPECT BREACH
#TRACE `s 196B(1) a private company must lodge the information by the earlier of the two dates` "Acme Pte Ltd" (Date 30 6 2016) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 196B(1) lodge with the Registrar the information necessary to be included in the electronic register of members` AT 180
-- First return due 31 December 2016: the earlier is 3 July 2016 (day 182)
-- EXPECT FULFILLED
#TRACE `s 196B(1) a private company must lodge the information by the earlier of the two dates` "Acme Pte Ltd" (Date 31 12 2016) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 196B(1) lodge with the Registrar the information necessary to be included in the electronic register of members` AT 182
-- EXPECT BREACH
#TRACE `s 196B(1) a private company must lodge the information by the earlier of the two dates` "Acme Pte Ltd" (Date 31 12 2016) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 196B(1) lodge with the Registrar the information necessary to be included in the electronic register of members` AT 183
-- EXPECT BREACH
#TRACE `s 196B(1) a private company must lodge the information by the earlier of the two dates` "Acme Pte Ltd" (Date 31 12 2016) AT 0 WITH
    WAITUNTIL 183
-- EXPECT RESIDUAL
#TRACE `s 196B(1) a private company must lodge the information by the earlier of the two dates` "Acme Pte Ltd" (Date 31 12 2016) AT 0 WITH
-- (2): the Registrar's power when the company fails to lodge some of the information
#ASSERT `s 196B(2) the Registrar may enter the corresponding information from the old register of members` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 196B(2) the Registrar may enter the corresponding information from the old register of members` TRUE FALSE EQUALS NOTHING
#ASSERT `s 196B(2) the Registrar may enter the corresponding information from the old register of members` FALSE TRUE EQUALS NOTHING
-- (3): the power to extend the time
#ASSERT `s 196B(3) the Registrar may extend the time for furnishing the information` TRUE EQUALS JUST TRUE
#ASSERT `s 196B(3) the Registrar may extend the time for furnishing the information` FALSE EQUALS NOTHING

§ `s 196C: sections 194 and 195 apply to the electronic register`

#ASSERT `s 196C(1) section 194 applies in respect of the electronic register of members` TRUE EQUALS JUST TRUE
#ASSERT `s 196C(1) section 194 applies in respect of the electronic register of members` FALSE EQUALS NOTHING
#ASSERT `s 196C(2) section 195 applies in respect of the electronic register of members, with the modifications` TRUE EQUALS JUST TRUE
#ASSERT `s 196C(2) section 195 applies in respect of the electronic register of members, with the modifications` FALSE EQUALS NOTHING
-- (a): a reference to a register under section 194 refers to the electronic register
#ASSERT `s 196C(2)(a) the reference is read as a reference to the electronic register of the private company` `s 196C(2) a reference to a register under section 194` EQUALS JUST TRUE
#ASSERT `s 196C(2)(a) the reference is read as a reference to the electronic register of the private company` `s 196C(2) a reference to a branch register` EQUALS NOTHING
#ASSERT `s 196C(2)(a) the reference is read as a reference to the electronic register of the private company` `s 196C(2) some other reference` EQUALS NOTHING
-- (b): the reference to any branch register is omitted
#ASSERT `s 196C(2)(b) the reference is omitted` `s 196C(2) a reference to a branch register` EQUALS JUST TRUE
#ASSERT `s 196C(2)(b) the reference is omitted` `s 196C(2) a reference to a register under section 194` EQUALS NOTHING
#ASSERT `s 196C(2)(b) the reference is omitted` `s 196C(2) some other reference` EQUALS NOTHING
-- (c): notify the Registrar of a trustee's request within 14 days
#ASSERT `s 196C(2)(c) the company must notify the Registrar of the trustee's request` TRUE EQUALS JUST TRUE
#ASSERT `s 196C(2)(c) the company must notify the Registrar of the trustee's request` FALSE EQUALS NOTHING
#ASSERT `s 196C(2)(c) the last day for notifying the Registrar` (Date 1 3 2026) EQUALS Date 15 3 2026
#ASSERT `s 196C(2)(c) the last day for notifying the Registrar` (Date 18 2 2028) EQUALS Date 3 3 2028
#ASSERT `s 196C(2)(c) the Registrar was notified within 14 days after the request` (Date 1 3 2026) (Date 15 3 2026)
#ASSERT NOT (`s 196C(2)(c) the Registrar was notified within 14 days after the request` (Date 1 3 2026) (Date 16 3 2026))
#ASSERT `s 196C(2)(c) the Registrar was notified within 14 days after the request` (Date 1 3 2026) (Date 1 3 2026)
-- EXPECT FULFILLED
#TRACE `s 196C(2)(c) a private company must notify the Registrar of the trustee's request within 14 days` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 196C(2)(c) notify the Registrar of the trustee's request that the relevant shares be marked` AT 14
-- EXPECT BREACH
#TRACE `s 196C(2)(c) a private company must notify the Registrar of the trustee's request within 14 days` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 196C(2)(c) notify the Registrar of the trustee's request that the relevant shares be marked` AT 15
-- EXPECT RESIDUAL
#TRACE `s 196C(2)(c) a private company must notify the Registrar of the trustee's request within 14 days` "Acme Pte Ltd" AT 0 WITH

§ `s 196D: the old register of members`

#ASSERT `s 196D(1) the private company must keep its old registers` TRUE EQUALS JUST TRUE
#ASSERT `s 196D(1) the private company must keep its old registers` FALSE EQUALS NOTHING
-- (a): the branch register, 7 years after 3 January 2016: the last day is 3 January 2023
#ASSERT `s 196D(1)(a) the last day of the period for keeping the branch register` EQUALS Date 3 1 2023
#ASSERT `s 196D(1)(a) the private company must continue to keep the branch register` TRUE (Date 3 1 2023) EQUALS JUST TRUE
#ASSERT `s 196D(1)(a) the private company must continue to keep the branch register` TRUE (Date 4 1 2023) EQUALS JUST FALSE
#ASSERT `s 196D(1)(a) the private company must continue to keep the branch register` TRUE (Date 3 1 2016) EQUALS JUST TRUE
#ASSERT `s 196D(1)(a) the private company must continue to keep the branch register` TRUE (Date 2 1 2016) EQUALS JUST FALSE
#ASSERT `s 196D(1)(a) the private company must continue to keep the branch register` FALSE (Date 1 3 2020) EQUALS NOTHING
-- (b): the register of members, 7 years after the last member referred to in it ceases to be a member
#ASSERT `s 196D(1)(b) the last day of the period for keeping the register of members` (Date 1 3 2026) EQUALS Date 1 3 2033
#ASSERT `s 196D(1)(b) the last day of the period for keeping the register of members` (Date 29 2 2028) EQUALS Date 28 2 2035
-- asked while some member has not ceased: the 7 years have not begun, the register is still to be kept
#ASSERT `s 196D(1)(b) the private company must continue to keep its register of members` TRUE FALSE (Date 1 3 2026) (Date 1 3 2040) EQUALS JUST TRUE
#ASSERT `s 196D(1)(b) the private company must continue to keep its register of members` TRUE TRUE (Date 1 3 2026) (Date 1 3 2033) EQUALS JUST TRUE
#ASSERT `s 196D(1)(b) the private company must continue to keep its register of members` TRUE TRUE (Date 1 3 2026) (Date 2 3 2033) EQUALS JUST FALSE
#ASSERT `s 196D(1)(b) the private company must continue to keep its register of members` TRUE TRUE (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 196D(1)(b) the private company must continue to keep its register of members` FALSE TRUE (Date 1 3 2026) (Date 1 3 2020) EQUALS NOTHING
-- the prohibition derived from the keeping duty (N2): stopping within the period is a breach, stopping after it is not.
-- (a): the clock counts days after 3 January 2016; the period is 2,557 days (the 7 years 2016 to 2023 include 29 February 2016 and 29 February 2020).
-- EXPECT BREACH
#TRACE `s 196D(1)(a) a private company must not stop keeping the branch register within 7 years after 3 January 2016` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 196D(1)(a) stop keeping the branch register` AT 2557
-- EXPECT FULFILLED
#TRACE `s 196D(1)(a) a private company must not stop keeping the branch register within 7 years after 3 January 2016` "Acme Pte Ltd" AT 0 WITH
    WAITUNTIL 2558
-- EXPECT RESIDUAL
#TRACE `s 196D(1)(a) a private company must not stop keeping the branch register within 7 years after 3 January 2016` "Acme Pte Ltd" AT 0 WITH
-- (b): the clock counts days after the day the last member ceased (1 March 2026); the period is 2,557 days (29 February 2028 and 29 February 2032)
-- EXPECT BREACH
#TRACE `s 196D(1)(b) a private company must not stop keeping its register of members within 7 years after the last member ceased` "Acme Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 196D(1)(b) stop keeping the register of members` AT 2557
-- EXPECT FULFILLED
#TRACE `s 196D(1)(b) a private company must not stop keeping its register of members within 7 years after the last member ceased` "Acme Pte Ltd" (Date 1 3 2026) AT 0 WITH
    WAITUNTIL 2558
-- (2): the exemption from updating
#ASSERT `s 196D(2) the private company is not required to update the old register for the change` (Date 1 6 2016) (Date 1 6 2016) EQUALS JUST TRUE
#ASSERT `s 196D(2) the private company is not required to update the old register for the change` (Date 2 6 2016) (Date 1 6 2016) EQUALS JUST TRUE
#ASSERT `s 196D(2) the private company is not required to update the old register for the change` (Date 31 5 2016) (Date 1 6 2016) EQUALS NOTHING
-- (3)(a): "Until the expiry of the period for which any ... register is required to be kept under subsection (1)", the old sections continue to apply
#ASSERT `s 196D(3)(a) the old sections continue to apply to the old registers` TRUE EQUALS JUST TRUE
#ASSERT `s 196D(3)(a) the old sections continue to apply to the old registers` FALSE EQUALS JUST FALSE
-- (3)(b): non-compliance may be dealt with and punished as if the old sections were in force
#ASSERT `s 196D(3)(b) the non-compliance may be dealt with and punished as if the old sections were in force` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 196D(3)(b) the non-compliance may be dealt with and punished as if the old sections were in force` TRUE FALSE EQUALS NOTHING
#ASSERT `s 196D(3)(b) the non-compliance may be dealt with and punished as if the old sections were in force` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 196D(3)(b) the non-compliance may be dealt with and punished as if the old sections were in force` FALSE FALSE EQUALS JUST FALSE

§ `s 196E: the address of an individual member`

-- The commencement of section 43 of the ACRA (Registry and Regulatory Enhancements) Act 2024 is an input; the tests take 1 April 2026.
-- (a), the residential address: as from the commencement, for an individual
#ASSERT `s 196E(a) the address in the electronic register is kept as the residential address of the member` TRUE (Date 1 4 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `s 196E(a) the address in the electronic register is kept as the residential address of the member` TRUE (Date 1 4 2026) (Date 31 3 2026) EQUALS JUST FALSE
#ASSERT `s 196E(a) the address in the electronic register is kept as the residential address of the member` FALSE (Date 1 4 2026) (Date 1 4 2026) EQUALS NOTHING
-- (a), the contact address: also, until a notice of change of the contact address is lodged on or after that date
#ASSERT `s 196E(a) the address in the electronic register is also kept as the contact address of the member` TRUE (Date 1 4 2026) FALSE (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `s 196E(a) the address in the electronic register is also kept as the contact address of the member` TRUE (Date 1 4 2026) TRUE (Date 1 5 2026) EQUALS JUST FALSE
#ASSERT `s 196E(a) the address in the electronic register is also kept as the contact address of the member` TRUE (Date 1 4 2026) FALSE (Date 31 3 2026) EQUALS JUST FALSE
#ASSERT `s 196E(a) the address in the electronic register is also kept as the contact address of the member` FALSE (Date 1 4 2026) FALSE (Date 1 4 2026) EQUALS NOTHING
-- (b): the contact address is made available for public access under section 12(2)(d)
#ASSERT `s 196E(b) the contact address is made available for public access under section 12(2)(d) as the address of the member` TRUE (Date 1 4 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `s 196E(b) the contact address is made available for public access under section 12(2)(d) as the address of the member` TRUE (Date 1 4 2026) (Date 31 3 2026) EQUALS JUST FALSE
#ASSERT `s 196E(b) the contact address is made available for public access under section 12(2)(d) as the address of the member` FALSE (Date 1 4 2026) (Date 1 4 2026) EQUALS NOTHING
