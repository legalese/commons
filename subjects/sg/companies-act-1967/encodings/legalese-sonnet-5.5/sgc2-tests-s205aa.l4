IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgc2-common`
IMPORT `sgc2-s205aa-resignation`

-- Tests for sgc2-s205aa-resignation.l4 (sections 205AA to 205AF). Every expected value is written from the text, beside the assertion, not from the code.
-- "14 days beginning on the date" counts the date as day 1 (last day = date + 13); "within 14 days after" counts it out (last day = date + 14).

§ `Section 205AA(4): public interest company and non-public interest company`

#ASSERT `s 205AA(4) "public interest company" the company is a public interest company` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 205AA(4) "public interest company" the company is a public interest company` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 205AA(4) "public interest company" the company is a public interest company` FALSE FALSE TRUE EQUALS JUST TRUE
-- "means": a company that is none of the three is not one.
#ASSERT `s 205AA(4) "public interest company" the company is a public interest company` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 205AA(4) "non-public interest company" the company is a non-public interest company` TRUE EQUALS JUST FALSE
#ASSERT `s 205AA(4) "non-public interest company" the company is a non-public interest company` FALSE EQUALS JUST TRUE

§ `Section 205AA(1) to (3)`

#ASSERT `s 205AA(1) the auditor may resign by giving the company a notice of resignation in writing` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- The carve-out and the public interest company: this section does not answer (section 205AB does).
#ASSERT `s 205AA(1) the auditor may resign by giving the company a notice of resignation in writing` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 205AA(1) the auditor may resign by giving the company a notice of resignation in writing` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- Not in writing, or not before the end of the term: NOTHING.
#ASSERT `s 205AA(1) the auditor may resign by giving the company a notice of resignation in writing` FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 205AA(1) the auditor may resign by giving the company a notice of resignation in writing` FALSE FALSE TRUE FALSE EQUALS NOTHING
-- (2): the term ends at the end of the day notice is given, or at the later day the notice specifies.
#ASSERT `s 205AA(2) the day on which the auditor's term of office expires` (Date 1 3 2026) FALSE (Date 1 1 2026) EQUALS Date 1 3 2026
#ASSERT `s 205AA(2) the day on which the auditor's term of office expires` (Date 1 3 2026) TRUE (Date 15 3 2026) EQUALS Date 15 3 2026
-- A specified day that is not later than the day of notice gives (a).
#ASSERT `s 205AA(2) the day on which the auditor's term of office expires` (Date 1 3 2026) TRUE (Date 1 3 2026) EQUALS Date 1 3 2026
#ASSERT `s 205AA(2) the day on which the auditor's term of office expires` (Date 1 3 2026) TRUE (Date 20 2 2026) EQUALS Date 1 3 2026
-- (3): 14 days beginning on 1 March 2026 end on 14 March.
#ASSERT `s 205AA(3) the last day for the company to lodge the notification` (Date 1 3 2026) EQUALS Date 14 3 2026
#ASSERT `s 205AA(3) the company is in default of the duty to lodge the notification` (Date 1 3 2026) TRUE (Date 14 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 205AA(3) the company is in default of the duty to lodge the notification` (Date 1 3 2026) TRUE (Date 15 3 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 205AA(3) the company is in default of the duty to lodge the notification` (Date 1 3 2026) FALSE (Date 1 1 2026) (Date 14 3 2026) EQUALS JUST FALSE
#ASSERT `s 205AA(3) the company is in default of the duty to lodge the notification` (Date 1 3 2026) FALSE (Date 1 1 2026) (Date 15 3 2026) EQUALS JUST TRUE

-- EXPECT FULFILLED
#TRACE `s 205AA(3) the company must lodge the notification with the Registrar` "Acme Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205AA(3) lodge with the Registrar a notification that the company has received a notice of resignation` AT 13

-- EXPECT BREACH
#TRACE `s 205AA(3) the company must lodge the notification with the Registrar` "Acme Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205AA(3) lodge with the Registrar a notification that the company has received a notice of resignation` AT 14

-- EXPECT BREACH
#TRACE `s 205AA(3) the company must lodge the notification with the Registrar` "Acme Pte Ltd" (Date 1 3 2026) AT 0 WITH
    (WAITUNTIL 14)

§ `Section 205AB`

#ASSERT `s 205AB(1) the auditor may resign by giving the company a notice of resignation in writing` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- Each limb of the "if" in turn: (a) application, statement to the Registrar, notice to the company, statement to the company; (b) consent.
#ASSERT `s 205AB(1) the auditor may resign by giving the company a notice of resignation in writing` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 205AB(1) the auditor may resign by giving the company a notice of resignation in writing` TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 205AB(1) the auditor may resign by giving the company a notice of resignation in writing` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 205AB(1) the auditor may resign by giving the company a notice of resignation in writing` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 205AB(1) the auditor may resign by giving the company a notice of resignation in writing` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 205AB(1) the auditor may resign by giving the company a notice of resignation in writing` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING
-- A company that is neither a public interest company nor a subsidiary of one: section 205AA governs.
#ASSERT `s 205AB(1) the auditor may resign by giving the company a notice of resignation in writing` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 205AB(2) the auditor and the company are to be notified whether the Registrar consents` TRUE EQUALS JUST TRUE
#ASSERT `s 205AB(2) the auditor and the company are to be notified whether the Registrar consents` FALSE EQUALS NOTHING

-- No number of days is stated for the Registrar's notification: the s 52 input (the period of all convenient speed, as found) sets the time.
-- EXPECT FULFILLED
#TRACE `s 205AB(2) the Registrar must notify the auditor and the company whether it consents` 45 AT 0 WITH
    PARTY Registrar DOES `s 205AB(2) notify the auditor and the company whether the Registrar consents to the resignation` AT 10

-- late: the act is done on day 400, past the 7 days the input is, so BREACH
-- EXPECT BREACH
#TRACE `s 205AB(2) the Registrar must notify the auditor and the company whether it consents` 7 AT 0 WITH
    PARTY Registrar DOES `s 205AB(2) notify the auditor and the company whether the Registrar consents to the resignation` AT 400

-- EXPECT RESIDUAL
#TRACE `s 205AB(2) the Registrar must notify the auditor and the company whether it consents` 45 AT 0 WITH
    (WAITUNTIL 10)

-- (3)(a): a statement made in the application or in answer to the Registrar's inquiry is not admissible in civil or criminal proceedings against the auditor.
#ASSERT `s 205AB(3)(a) the statement is admissible in evidence in the proceedings` TRUE `s 205AB(3) civil or criminal proceedings against the auditor` EQUALS JUST FALSE
#ASSERT `s 205AB(3)(a) the statement is admissible in evidence in the proceedings` TRUE `s 205AB(3) a prosecution, an action or a suit against the auditor` EQUALS JUST FALSE
-- Disciplinary proceedings under the Accountants Act 2004 are not civil or criminal: paragraph (a) is silent (subsection (4) answers).
#ASSERT `s 205AB(3)(a) the statement is admissible in evidence in the proceedings` TRUE `s 205AB(4) disciplinary proceedings commenced under the Accountants Act 2004 against the auditor` EQUALS NOTHING
#ASSERT `s 205AB(3)(a) the statement is admissible in evidence in the proceedings` TRUE `s 205AB(3) any other proceedings` EQUALS NOTHING
-- A statement made elsewhere than in the application or the answer is outside the paragraph.
#ASSERT `s 205AB(3)(a) the statement is admissible in evidence in the proceedings` FALSE `s 205AB(3) civil or criminal proceedings against the auditor` EQUALS NOTHING
-- (3)(b): may not be made the ground of a prosecution, an action or a suit against the auditor.
#ASSERT `s 205AB(3)(b) the statement may be made the ground of a prosecution, an action or a suit against the auditor` TRUE `s 205AB(3) a prosecution, an action or a suit against the auditor` EQUALS JUST FALSE
#ASSERT `s 205AB(3)(b) the statement may be made the ground of a prosecution, an action or a suit against the auditor` TRUE `s 205AB(3) civil or criminal proceedings against the auditor` EQUALS JUST FALSE
#ASSERT `s 205AB(3)(b) the statement may be made the ground of a prosecution, an action or a suit against the auditor` TRUE `s 205AB(4) disciplinary proceedings commenced under the Accountants Act 2004 against the auditor` EQUALS NOTHING
#ASSERT `s 205AB(3)(b) the statement may be made the ground of a prosecution, an action or a suit against the auditor` TRUE `s 205AB(3) any other proceedings` EQUALS NOTHING
#ASSERT `s 205AB(3)(b) the statement may be made the ground of a prosecution, an action or a suit against the auditor` FALSE `s 205AB(3) a prosecution, an action or a suit against the auditor` EQUALS NOTHING
-- The Registrar's certificate.
#ASSERT `s 205AB(3) the Registrar's certificate is conclusive evidence that the statement was made in the application or the answer` TRUE EQUALS JUST TRUE
#ASSERT `s 205AB(3) the Registrar's certificate is conclusive evidence that the statement was made in the application or the answer` FALSE EQUALS NOTHING
-- (4): the statement may be used in disciplinary proceedings under the Accountants Act 2004 against the auditor.
#ASSERT `s 205AB(4) the statement may be used in the proceedings` `s 205AB(4) disciplinary proceedings commenced under the Accountants Act 2004 against the auditor` EQUALS JUST TRUE
#ASSERT `s 205AB(4) the statement may be used in the proceedings` `s 205AB(3) civil or criminal proceedings against the auditor` EQUALS NOTHING
#ASSERT `s 205AB(4) the statement may be used in the proceedings` `s 205AB(3) a prosecution, an action or a suit against the auditor` EQUALS NOTHING
#ASSERT `s 205AB(4) the statement may be used in the proceedings` `s 205AB(3) any other proceedings` EQUALS NOTHING
-- (5): the last of the three days. Specified 1 June, consent notified 10 June, Registrar fixes 20 June: 20 June.
#ASSERT `s 205AB(5) the day the resignation takes effect` TRUE (Date 1 6 2026) (Date 10 6 2026) TRUE (Date 20 6 2026) EQUALS Date 20 6 2026
-- No day fixed by the Registrar: the later of the specified day and the day consent is notified.
#ASSERT `s 205AB(5) the day the resignation takes effect` TRUE (Date 1 6 2026) (Date 10 6 2026) FALSE (Date 20 6 2026) EQUALS Date 10 6 2026
#ASSERT `s 205AB(5) the day the resignation takes effect` TRUE (Date 30 6 2026) (Date 10 6 2026) FALSE (Date 20 6 2026) EQUALS Date 30 6 2026
-- No day in the notice: the day consent is notified, unless the Registrar fixes a later one.
#ASSERT `s 205AB(5) the day the resignation takes effect` FALSE (Date 30 6 2026) (Date 10 6 2026) FALSE (Date 20 6 2026) EQUALS Date 10 6 2026
-- A day fixed by the Registrar that is earlier than another of the days does not bring the date forward.
#ASSERT `s 205AB(5) the day the resignation takes effect` TRUE (Date 1 6 2026) (Date 10 6 2026) TRUE (Date 5 6 2026) EQUALS Date 10 6 2026

§ `Section 205AC`

-- The notice and the statement received 1 March: "within 14 days after" ends on 15 March.
#ASSERT `s 205AC(1) the last day for the company to send a copy of the written statement to every member` (Date 1 3 2026) EQUALS Date 15 3 2026
#ASSERT `s 205AC(1) the company is in default of the duty to send a copy of the written statement to every member` (Date 1 3 2026) TRUE (Date 15 3 2026) FALSE (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 205AC(1) the company is in default of the duty to send a copy of the written statement to every member` (Date 1 3 2026) TRUE (Date 16 3 2026) FALSE (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 205AC(1) the company is in default of the duty to send a copy of the written statement to every member` (Date 1 3 2026) FALSE (Date 1 1 2026) FALSE (Date 15 3 2026) EQUALS JUST FALSE
#ASSERT `s 205AC(1) the company is in default of the duty to send a copy of the written statement to every member` (Date 1 3 2026) FALSE (Date 1 1 2026) FALSE (Date 16 3 2026) EQUALS JUST TRUE
-- Excused where an application to the Court has been made under (2): not sent, and no default.
#ASSERT `s 205AC(1) the company is in default of the duty to send a copy of the written statement to every member` (Date 1 3 2026) FALSE (Date 1 1 2026) TRUE (Date 16 3 2026) EQUALS JUST FALSE

-- EXPECT FULFILLED
#TRACE `s 205AC(1) the company must send a copy of the written statement to every member` "Acme Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205AC(1) send a copy of the written statement to every member of the company` AT 14

-- EXPECT BREACH
#TRACE `s 205AC(1) the company must send a copy of the written statement to every member` "Acme Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205AC(1) send a copy of the written statement to every member of the company` AT 15

-- (2): 14 days beginning on 1 March end on 14 March: an application on 14 March is in time, one on 15 March is not.
#ASSERT `s 205AC(2) copies of the written statement need not be sent out` (Date 1 3 2026) TRUE (Date 14 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 205AC(2) copies of the written statement need not be sent out` (Date 1 3 2026) TRUE (Date 15 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 205AC(2) copies of the written statement need not be sent out` (Date 1 3 2026) TRUE (Date 1 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 205AC(2) copies of the written statement need not be sent out` (Date 1 3 2026) FALSE (Date 5 3 2026) TRUE EQUALS JUST FALSE
-- An application for some other determination does not do.
#ASSERT `s 205AC(2) copies of the written statement need not be sent out` (Date 1 3 2026) TRUE (Date 5 3 2026) FALSE EQUALS JUST FALSE
-- (3): the company must tell the auditor; any other applicant must tell the company and the auditor.
#ASSERT `s 205AC(3) the applicant is in default of the duty to give notice of the application` `s 205AC(3)(a) the company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 205AC(3) the applicant is in default of the duty to give notice of the application` `s 205AC(3)(a) the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 205AC(3) the applicant is in default of the duty to give notice of the application` `s 205AC(3)(b) any other person who claims to be aggrieved by the written statement` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 205AC(3) the applicant is in default of the duty to give notice of the application` `s 205AC(3)(b) any other person who claims to be aggrieved by the written statement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 205AC(3) the applicant is in default of the duty to give notice of the application` `s 205AC(3)(b) any other person who claims to be aggrieved by the written statement` FALSE TRUE EQUALS JUST TRUE

-- No time limit stated for the notice: the s 52 input (the period of all convenient speed, as found) sets the time.
-- EXPECT FULFILLED
#TRACE `s 205AC(3)(a) the company that applies must give notice of the application to the auditor` "Acme Pte Ltd" 7 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205AC(3)(a) give notice of the application to the auditor of the company` AT 2

-- EXPECT BREACH
#TRACE `s 205AC(3)(a) the company that applies must give notice of the application to the auditor` "Acme Pte Ltd" 45 AT 0 WITH
    (WAITUNTIL 60)

-- EXPECT FULFILLED
#TRACE `s 205AC(3)(b) any other person who applies must give notice of the application to the company and the auditor` "Ann Lim" 7 AT 0 WITH
    PARTY Individual "Ann Lim" DOES `s 205AC(3)(b) give notice of the application to the company and the auditor of the company` AT 2

-- EXPECT BREACH
#TRACE `s 205AC(3)(b) any other person who applies must give notice of the application to the company and the auditor` "Ann Lim" 45 AT 0 WITH
    (WAITUNTIL 60)

#ASSERT `s 205AC(4) the person is guilty of the offence` TRUE `s 205(17) the company` EQUALS JUST TRUE
#ASSERT `s 205AC(4) the person is guilty of the offence` TRUE `s 205(17) a director of the company who is in default` EQUALS JUST TRUE
#ASSERT `s 205AC(4) the person is guilty of the offence` TRUE `s 205(17) any other person` EQUALS JUST FALSE
#ASSERT `s 205AC(4) the person is guilty of the offence` FALSE `s 205(17) the company` EQUALS JUST FALSE
#ASSERT `s 205AC(4) the most the person may be fined on conviction` TRUE `s 205(17) the company` EQUALS JUST 5000
#ASSERT `s 205AC(4) the most the person may be fined on conviction` TRUE `s 205(17) a director of the company who is in default` EQUALS JUST 5000
#ASSERT `s 205AC(4) the most the person may be fined on conviction` FALSE `s 205(17) the company` EQUALS NOTHING

§ `Section 205AD`

#ASSERT `s 205AD(1) section 205AD applies` TRUE EQUALS JUST TRUE
#ASSERT `s 205AD(1) section 205AD applies` FALSE EQUALS JUST FALSE
#ASSERT `s 205AD(2)(a) the Court is required to direct that copies of the written statement are not to be sent` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 205AD(2)(a) the Court is required to direct that copies of the written statement are not to be sent` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 205AD(2)(a) the Court is required to direct that copies of the written statement are not to be sent` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 205AD(2)(b) the Court may order the auditor to pay the applicant's costs in whole or in part` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 205AD(2)(b) the Court may order the auditor to pay the applicant's costs in whole or in part` TRUE FALSE EQUALS NOTHING
#ASSERT `s 205AD(2)(b) the Court may order the auditor to pay the applicant's costs in whole or in part` FALSE TRUE EQUALS NOTHING
-- (3): directions given 1 March: 14 days beginning on that date end on 14 March.
#ASSERT `s 205AD(3) the last day for the company to send the notice` (Date 1 3 2026) EQUALS Date 14 3 2026
#ASSERT `s 205AD(3) the company is in default of the duty to send a notice setting out the effect of the directions` (Date 1 3 2026) TRUE FALSE TRUE (Date 14 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 205AD(3) the company is in default of the duty to send a notice setting out the effect of the directions` (Date 1 3 2026) TRUE FALSE TRUE (Date 15 3 2026) (Date 1 6 2026) EQUALS JUST TRUE
-- The auditor already named as a party: notice to the members alone is enough.
#ASSERT `s 205AD(3) the company is in default of the duty to send a notice setting out the effect of the directions` (Date 1 3 2026) TRUE TRUE FALSE (Date 14 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
-- Not named as a party and not told: not complied with.
#ASSERT `s 205AD(3) the company is in default of the duty to send a notice setting out the effect of the directions` (Date 1 3 2026) TRUE FALSE FALSE (Date 14 3 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 205AD(3) the company is in default of the duty to send a notice setting out the effect of the directions` (Date 1 3 2026) FALSE TRUE TRUE (Date 1 1 2026) (Date 14 3 2026) EQUALS JUST FALSE
#ASSERT `s 205AD(3) the company is in default of the duty to send a notice setting out the effect of the directions` (Date 1 3 2026) FALSE TRUE TRUE (Date 1 1 2026) (Date 15 3 2026) EQUALS JUST TRUE
-- (4): decision made 1 March; the last day is 14 March.
#ASSERT `s 205AD(4) the last day for the company to give notice and send the copies` (Date 1 3 2026) EQUALS Date 14 3 2026
#ASSERT `s 205AD(4) the company is in default of the duty to give notice of the decision and send the copies` (Date 1 3 2026) TRUE TRUE (Date 14 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 205AD(4) the company is in default of the duty to give notice of the decision and send the copies` (Date 1 3 2026) TRUE TRUE (Date 15 3 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 205AD(4) the company is in default of the duty to give notice of the decision and send the copies` (Date 1 3 2026) TRUE FALSE (Date 14 3 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 205AD(4) the company is in default of the duty to give notice of the decision and send the copies` (Date 1 3 2026) FALSE FALSE (Date 1 1 2026) (Date 14 3 2026) EQUALS JUST FALSE
#ASSERT `s 205AD(4) the company is in default of the duty to give notice of the decision and send the copies` (Date 1 3 2026) FALSE FALSE (Date 1 1 2026) (Date 15 3 2026) EQUALS JUST TRUE

-- EXPECT FULFILLED
#TRACE `s 205AD(3) the company must send a notice setting out the effect of the directions` "Acme Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205AD(3) send a notice setting out the effect of the Court's directions to every member and, unless already named as a party, to the auditor` AT 13

-- EXPECT BREACH
#TRACE `s 205AD(3) the company must send a notice setting out the effect of the directions` "Acme Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205AD(3) send a notice setting out the effect of the Court's directions to every member and, unless already named as a party, to the auditor` AT 14

-- EXPECT FULFILLED
#TRACE `s 205AD(4) the company must give notice of the decision and send the copies` "Acme Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 205AD(4) give notice of the Court's decision to the auditor and send a copy of the written statement to every member and to the auditor` AT 13

-- EXPECT BREACH
#TRACE `s 205AD(4) the company must give notice of the decision and send the copies` "Acme Pte Ltd" (Date 1 3 2026) AT 0 WITH
    (WAITUNTIL 14)

#ASSERT `s 205AD(5) the person is guilty of the offence` TRUE `s 205(17) the company` EQUALS JUST TRUE
#ASSERT `s 205AD(5) the person is guilty of the offence` TRUE `s 205(17) a director of the company who is in default` EQUALS JUST TRUE
#ASSERT `s 205AD(5) the person is guilty of the offence` TRUE `s 205(17) any other person` EQUALS JUST FALSE
#ASSERT `s 205AD(5) the person is guilty of the offence` FALSE `s 205(17) a director of the company who is in default` EQUALS JUST FALSE
#ASSERT `s 205AD(5) the most the person may be fined on conviction` TRUE `s 205(17) the company` EQUALS JUST 5000
#ASSERT `s 205AD(5) the most the person may be fined on conviction` FALSE `s 205(17) the company` EQUALS NOTHING

§ `Section 205AE`

#ASSERT `s 205AE the person has the privilege against an action for defamation for the publication` `s 205AE(a) publication of the written statement to a member pursuant to section 205AC(1)` FALSE EQUALS JUST TRUE
-- With malice, paragraph (a) gives no privilege (NOTHING: the section does not say the person is liable).
#ASSERT `s 205AE the person has the privilege against an action for defamation for the publication` `s 205AE(a) publication of the written statement to a member pursuant to section 205AC(1)` TRUE EQUALS NOTHING
-- Paragraph (b) has no "absence of malice" condition.
#ASSERT `s 205AE the person has the privilege against an action for defamation for the publication` `s 205AE(b) publication of the written statement to a member pursuant to section 205AD(4)(b)` TRUE EQUALS JUST TRUE
#ASSERT `s 205AE the person has the privilege against an action for defamation for the publication` `s 205AE(b) publication of the written statement to a member pursuant to section 205AD(4)(b)` FALSE EQUALS JUST TRUE
#ASSERT `s 205AE the person has the privilege against an action for defamation for the publication` `s 205AE any other publication` FALSE EQUALS NOTHING

§ `Section 205AF`

#ASSERT `s 205AF(1)(c) the last day for the directors to call the general meeting` (Date 1 1 2026) EQUALS Date 1 4 2026
-- Not more than 3 months after the resignation (1 January): called on 1 April is in time, on 2 April is not.
#ASSERT `s 205AF(1)(c) the directors are in default of the duty to call a general meeting` TRUE FALSE (Date 1 1 2026) TRUE (Date 1 4 2026) (Date 1 7 2026) EQUALS JUST FALSE
#ASSERT `s 205AF(1)(c) the directors are in default of the duty to call a general meeting` TRUE FALSE (Date 1 1 2026) TRUE (Date 2 4 2026) (Date 1 7 2026) EQUALS JUST TRUE
#ASSERT `s 205AF(1)(c) the directors are in default of the duty to call a general meeting` TRUE FALSE (Date 1 1 2026) FALSE (Date 1 1 2026) (Date 1 4 2026) EQUALS JUST FALSE
#ASSERT `s 205AF(1)(c) the directors are in default of the duty to call a general meeting` TRUE FALSE (Date 1 1 2026) FALSE (Date 1 1 2026) (Date 2 4 2026) EQUALS JUST TRUE
-- Disapplied by subsection (3), or not a resignation of the kind (1)(a) or (b) describes: no default.
#ASSERT `s 205AF(1)(c) the directors are in default of the duty to call a general meeting` TRUE TRUE (Date 1 1 2026) FALSE (Date 1 1 2026) (Date 2 4 2026) EQUALS JUST FALSE
#ASSERT `s 205AF(1)(c) the directors are in default of the duty to call a general meeting` FALSE FALSE (Date 1 1 2026) FALSE (Date 1 1 2026) (Date 2 4 2026) EQUALS JUST FALSE
-- (1)(d): within 14 days of the appointment on 1 March: 15 March is in time, 16 March is not.
#ASSERT `s 205AF(1)(d) the last day for the directors to lodge the notification` (Date 1 3 2026) EQUALS Date 15 3 2026
#ASSERT `s 205AF(1)(d) the directors are in default of the duty to lodge a notification of the appointment` FALSE (Date 1 3 2026) TRUE (Date 15 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 205AF(1)(d) the directors are in default of the duty to lodge a notification of the appointment` FALSE (Date 1 3 2026) TRUE (Date 16 3 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 205AF(1)(d) the directors are in default of the duty to lodge a notification of the appointment` FALSE (Date 1 3 2026) FALSE (Date 1 1 2026) (Date 15 3 2026) EQUALS JUST FALSE
#ASSERT `s 205AF(1)(d) the directors are in default of the duty to lodge a notification of the appointment` FALSE (Date 1 3 2026) FALSE (Date 1 1 2026) (Date 16 3 2026) EQUALS JUST TRUE
#ASSERT `s 205AF(1)(d) the directors are in default of the duty to lodge a notification of the appointment` TRUE (Date 1 3 2026) FALSE (Date 1 1 2026) (Date 16 3 2026) EQUALS JUST FALSE

-- EXPECT FULFILLED
#TRACE `s 205AF(1)(c) the directors must call a general meeting to appoint an auditor in place` "Ann" (Date 1 1 2026) AT 0 WITH
    PARTY Director "Ann" DOES `s 205AF(1)(c) call a general meeting for the purpose of appointing an auditor in place of the auditor who resigns` AT 90

-- EXPECT BREACH
#TRACE `s 205AF(1)(c) the directors must call a general meeting to appoint an auditor in place` "Ann" (Date 1 1 2026) AT 0 WITH
    PARTY Director "Ann" DOES `s 205AF(1)(c) call a general meeting for the purpose of appointing an auditor in place of the auditor who resigns` AT 91

-- EXPECT FULFILLED
#TRACE `s 205AF(1)(d) the directors must lodge a notification of the appointment` "Ann" (Date 1 3 2026) AT 0 WITH
    PARTY Director "Ann" DOES `s 205AF(1)(d) lodge with the Registrar a notification of the appointment of the new auditor` AT 14

-- EXPECT BREACH
#TRACE `s 205AF(1)(d) the directors must lodge a notification of the appointment` "Ann" (Date 1 3 2026) AT 0 WITH
    PARTY Director "Ann" DOES `s 205AF(1)(d) lodge with the Registrar a notification of the appointment of the new auditor` AT 15

-- EXPECT BREACH
