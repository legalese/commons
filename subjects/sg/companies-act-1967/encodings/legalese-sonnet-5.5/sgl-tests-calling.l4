IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgl-calling`

-- Tests for sgl-calling.l4 (ss 176, 177, 182). Expected values were decided from the text before the module was run.
-- Period counting (a month from 31 December ends on 28 February) is the keel's convention P4, assumed and not ruled.

§ `s 176(1) and (1A): the requisition and the duty`

#ASSERT `s 176(1A) the number of paid-up shares counted` 1000 100 EQUALS 900
#ASSERT `s 176(1A) the number of paid-up shares counted` 1000 0 EQUALS 1000
-- a company with a share capital: exactly 10% is "not less than 10%"
#ASSERT `s 176(1) the requisition is by members holding or representing enough` TRUE 100 1000 0 0 EQUALS JUST TRUE
#ASSERT `s 176(1) the requisition is by members holding or representing enough` TRUE 99 1000 0 0 EQUALS JUST FALSE
#ASSERT `s 176(1) the requisition is by members holding or representing enough` TRUE 101 1000 0 0 EQUALS JUST TRUE
#ASSERT `s 176(1) the requisition is by members holding or representing enough` TRUE 10 0 0 0 EQUALS JUST FALSE
-- a company without a share capital: voting rights
#ASSERT `s 176(1) the requisition is by members holding or representing enough` FALSE 0 0 10 100 EQUALS JUST TRUE
#ASSERT `s 176(1) the requisition is by members holding or representing enough` FALSE 0 0 9 100 EQUALS JUST FALSE
#ASSERT `s 176(1) the requisition is by members holding or representing enough` FALSE 0 0 5 0 EQUALS JUST FALSE
#ASSERT `s 176(1) the directors must proceed to convene an extraordinary general meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 176(1) the directors must proceed to convene an extraordinary general meeting` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 176(1) the directors must proceed to convene an extraordinary general meeting` FALSE TRUE EQUALS JUST FALSE
-- received on 1 March 2026: held by 1 May 2026 (2 months after)
#ASSERT `s 176(1) the directors have complied with the duty to convene` TRUE TRUE (Date 1 3 2026) (Date 1 5 2026) EQUALS JUST TRUE
#ASSERT `s 176(1) the directors have complied with the duty to convene` TRUE TRUE (Date 1 3 2026) (Date 2 5 2026) EQUALS JUST FALSE
#ASSERT `s 176(1) the directors have complied with the duty to convene` TRUE FALSE (Date 1 3 2026) (Date 10 3 2026) EQUALS JUST FALSE
#ASSERT `s 176(1) the directors have complied with the duty to convene` FALSE TRUE (Date 1 3 2026) (Date 10 3 2026) EQUALS JUST FALSE
-- received on 31 December 2025: 2 months after is 28 February 2026 (P4)
#ASSERT `s 176(1) the directors have complied with the duty to convene` TRUE TRUE (Date 31 12 2025) (Date 28 2 2026) EQUALS JUST TRUE
#ASSERT `s 176(1) the directors have complied with the duty to convene` TRUE TRUE (Date 31 12 2025) (Date 1 3 2026) EQUALS JUST FALSE
#ASSERT `s 176(1) the number of days from receipt to the last day for the meeting` (Date 1 3 2026) EQUALS 61
-- EXPECT FULFILLED
#TRACE `s 176(1) the directors must hold the extraordinary general meeting` "Gamma Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY `Board of directors` "Gamma Pte Ltd" DOES `s 176(1) hold the extraordinary general meeting` AT 61
-- EXPECT BREACH
#TRACE `s 176(1) the directors must hold the extraordinary general meeting` "Gamma Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY `Board of directors` "Gamma Pte Ltd" DOES `s 176(1) hold the extraordinary general meeting` AT 62
-- EXPECT BREACH
#TRACE `s 176(1) the directors must hold the extraordinary general meeting` "Gamma Pte Ltd" (Date 1 3 2026) AT 0 WITH
    WAITUNTIL 62

§ `s 176(2): the form of the requisition`

-- arguments: states the objects; signed; deposited at the registered office; several documents; in like form; each signed by one or more requisitionists
#ASSERT `s 176(2) the requisition is in the form the subsection requires` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 176(2) the requisition is in the form the subsection requires` FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 176(2) the requisition is in the form the subsection requires` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 176(2) the requisition is in the form the subsection requires` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 176(2) the requisition is in the form the subsection requires` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 176(2) the requisition is in the form the subsection requires` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 176(2) the requisition is in the form the subsection requires` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 176(2) the requisition is in the form the subsection requires` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE

§ `s 176(3) to (5): the requisitionists, expenses, special resolutions`

-- deposited 1 March 2026; 21 days after is 22 March 2026. arguments: deposit; directors proceeded; date; rights of the requisitionists proposing; total rights of requisitionists; same manner
#ASSERT `s 176(3) the requisitionists may themselves convene a meeting` (Date 1 3 2026) TRUE (Date 23 3 2026) 51 100 TRUE EQUALS JUST TRUE
#ASSERT `s 176(3) the requisitionists may themselves convene a meeting` (Date 1 3 2026) TRUE (Date 22 3 2026) 51 100 TRUE EQUALS NOTHING
#ASSERT `s 176(3) the requisitionists may themselves convene a meeting` (Date 1 3 2026) TRUE (Date 1 3 2026) 51 100 TRUE EQUALS NOTHING
#ASSERT `s 176(3) the requisitionists may themselves convene a meeting` (Date 1 3 2026) FALSE (Date 1 3 2026) 51 100 TRUE EQUALS JUST TRUE
#ASSERT `s 176(3) the requisitionists may themselves convene a meeting` (Date 1 3 2026) FALSE (Date 1 3 2026) 50 100 TRUE EQUALS NOTHING
#ASSERT `s 176(3) the requisitionists may themselves convene a meeting` (Date 1 3 2026) FALSE (Date 1 3 2026) 100 100 TRUE EQUALS JUST TRUE
#ASSERT `s 176(3) the requisitionists may themselves convene a meeting` (Date 1 3 2026) FALSE (Date 1 3 2026) 51 100 FALSE EQUALS NOTHING
-- "must not be held after the expiration of 3 months from that date": deposited 1 March 2026, so 1 June 2026 is the last day
#ASSERT `s 176(3) the meeting so convened is barred because it would be held after 3 months from the date of the deposit` (Date 1 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 176(3) the meeting so convened is barred because it would be held after 3 months from the date of the deposit` (Date 1 3 2026) (Date 2 6 2026) EQUALS JUST TRUE
#ASSERT `s 176(3) the meeting so convened is barred because it would be held after 3 months from the date of the deposit` (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST FALSE
#ASSERT `s 176(4) the sum the company must pay the requisitionists` 1500 EQUALS 1500
#ASSERT `s 176(4) the sum the company must pay the requisitionists` 0 EQUALS 0
#ASSERT `s 176(4) the sum the company must retain out of sums due to the directors in default` 1500 EQUALS 1500
-- no time limit and no consequence is stated for these two duties: the trace ends FULFILLED however late the acts, and RESIDUAL with none (see NOTES.md, Rules with no breach path)
-- EXPECT FULFILLED
#TRACE `s 176(4) the company must pay the requisitionists and retain the sum` "Gamma Pte Ltd" AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 176(4) pay the requisitionists their reasonable expenses` AT 30
    PARTY Company "Gamma Pte Ltd" DOES `s 176(4) retain the sum out of sums due to the directors in default` AT 400
-- EXPECT RESIDUAL
#TRACE `s 176(4) the company must pay the requisitionists and retain the sum` "Gamma Pte Ltd" AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 176(4) pay the requisitionists their reasonable expenses` AT 30
#ASSERT `s 176(5) the meeting is deemed not to be duly convened by the directors` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 176(5) the meeting is deemed not to be duly convened by the directors` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 176(5) the meeting is deemed not to be duly convened by the directors` FALSE FALSE EQUALS JUST FALSE

§ `s 177(1): who may call a meeting`

-- arguments: has a share capital; members proposing; shares they hold; total shares; total members; the constitution's lesser number
#ASSERT `s 177(1) the members may call a meeting of the company` TRUE 2 100 1000 50 NOTHING EQUALS JUST TRUE
#ASSERT `s 177(1) the members may call a meeting of the company` TRUE 2 99 1000 50 NOTHING EQUALS NOTHING
#ASSERT `s 177(1) the members may call a meeting of the company` TRUE 1 500 1000 50 NOTHING EQUALS NOTHING
#ASSERT `s 177(1) the members may call a meeting of the company` TRUE 3 400 1000 50 NOTHING EQUALS JUST TRUE
#ASSERT `s 177(1) the members may call a meeting of the company` FALSE 5 0 0 100 NOTHING EQUALS JUST TRUE
#ASSERT `s 177(1) the members may call a meeting of the company` FALSE 4 0 0 100 NOTHING EQUALS NOTHING
#ASSERT `s 177(1) the members may call a meeting of the company` FALSE 4 0 0 100 (JUST 4) EQUALS JUST TRUE
#ASSERT `s 177(1) the members may call a meeting of the company` FALSE 3 0 0 100 (JUST 4) EQUALS NOTHING
#ASSERT `s 177(1) the members may call a meeting of the company` FALSE 1 0 0 10 (JUST 1) EQUALS NOTHING

§ `s 177(2): the length of the notice`

#ASSERT `s 177(2) the number of days of notice the meeting must be called by` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 177(2) the number of days of notice the meeting must be called by` FALSE NOTHING EQUALS JUST 14
#ASSERT `s 177(2) the number of days of notice the meeting must be called by` FALSE (JUST 21) EQUALS JUST 21
#ASSERT `s 177(2) the number of days of notice the meeting must be called by` FALSE (JUST 14) EQUALS JUST 14
#ASSERT `s 177(2) the number of days of notice the meeting must be called by` FALSE (JUST 10) EQUALS JUST 14
-- the meeting is on 28 March 2026: 14 days before is 14 March 2026. arguments: special resolution; constitution's longer period; written; date notice given; date of meeting
#ASSERT `s 177(2) the meeting is called by notice as the subsection requires` FALSE NOTHING TRUE (Date 14 3 2026) (Date 28 3 2026) EQUALS JUST TRUE
#ASSERT `s 177(2) the meeting is called by notice as the subsection requires` FALSE NOTHING TRUE (Date 15 3 2026) (Date 28 3 2026) EQUALS JUST FALSE
#ASSERT `s 177(2) the meeting is called by notice as the subsection requires` FALSE NOTHING FALSE (Date 1 3 2026) (Date 28 3 2026) EQUALS JUST FALSE
#ASSERT `s 177(2) the meeting is called by notice as the subsection requires` TRUE NOTHING TRUE (Date 1 3 2026) (Date 28 3 2026) EQUALS NOTHING
#ASSERT `s 177(2) the meeting is called by notice as the subsection requires` FALSE (JUST 21) TRUE (Date 14 3 2026) (Date 28 3 2026) EQUALS JUST FALSE
#ASSERT `s 177(2) the meeting is called by notice as the subsection requires` FALSE (JUST 21) TRUE (Date 7 3 2026) (Date 28 3 2026) EQUALS JUST TRUE
#ASSERT `s 177(2) the latest day for the notice` (Date 28 3 2026) 14 EQUALS Date 14 3 2026
-- time 0 is 1 March 2026; the latest day, 14 March, is day 13
-- EXPECT FULFILLED
#TRACE `s 177(2) the company must call the meeting by notice of the length the subsection requires` "Gamma Pte Ltd" (Date 1 3 2026) (Date 28 3 2026) 14 AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 177(2) call the meeting by written notice of the length the subsection requires` AT 13
-- EXPECT BREACH
#TRACE `s 177(2) the company must call the meeting by notice of the length the subsection requires` "Gamma Pte Ltd" (Date 1 3 2026) (Date 28 3 2026) 14 AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 177(2) call the meeting by written notice of the length the subsection requires` AT 14
-- EXPECT BREACH
#TRACE `s 177(2) the company must call the meeting by notice of the length the subsection requires` "Gamma Pte Ltd" (Date 1 3 2026) (Date 28 3 2026) 14 AT 0 WITH
    WAITUNTIL 14

§ `s 177(3) and (4)`

-- arguments: called as the annual general meeting; notice shorter than required; members entitled; members who agreed; total voting rights; voting rights of those who agreed
#ASSERT `s 177(3) the meeting is deemed to be duly called although called by shorter notice` TRUE TRUE 10 10 100 100 EQUALS JUST TRUE
#ASSERT `s 177(3) the meeting is deemed to be duly called although called by shorter notice` TRUE TRUE 10 9 100 99 EQUALS JUST FALSE
#ASSERT `s 177(3) the meeting is deemed to be duly called although called by shorter notice` TRUE TRUE 0 0 0 0 EQUALS JUST FALSE
#ASSERT `s 177(3) the meeting is deemed to be duly called although called by shorter notice` TRUE FALSE 10 10 100 100 EQUALS NOTHING
#ASSERT `s 177(3) the meeting is deemed to be duly called although called by shorter notice` FALSE TRUE 10 6 100 95 EQUALS JUST TRUE
#ASSERT `s 177(3) the meeting is deemed to be duly called although called by shorter notice` FALSE TRUE 10 6 100 94 EQUALS JUST FALSE
#ASSERT `s 177(3) the meeting is deemed to be duly called although called by shorter notice` FALSE TRUE 10 5 100 100 EQUALS JUST FALSE
#ASSERT `s 177(3) the meeting is deemed to be duly called although called by shorter notice` FALSE TRUE 10 10 100 100 EQUALS JUST TRUE
#ASSERT `s 177(3) the meeting is deemed to be duly called although called by shorter notice` FALSE FALSE 10 10 100 100 EQUALS NOTHING
-- (4): arguments: the constitution makes other provision; a model constitution is prescribed; served on every member; served in the manner
#ASSERT `s 177(4) the notice has been served as the subsection requires` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 177(4) the notice has been served as the subsection requires` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 177(4) the notice has been served as the subsection requires` FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 177(4) the notice has been served as the subsection requires` TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 177(4) the notice has been served as the subsection requires` FALSE FALSE TRUE TRUE EQUALS NOTHING

§ `s 182: the Court may order a meeting`

-- arguments: impracticable to call; impracticable to conduct; own motion; applicant a director; applicant a member entitled to vote; applicant the personal representative of such a member
#ASSERT `s 182 the Court may order a meeting to be called, held and conducted` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 182 the Court may order a meeting to be called, held and conducted` FALSE TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 182 the Court may order a meeting to be called, held and conducted` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 182 the Court may order a meeting to be called, held and conducted` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 182 the Court may order a meeting to be called, held and conducted` FALSE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 182 the Court may order a meeting to be called, held and conducted` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 182 the Court may direct that one member present in person or by proxy is deemed to constitute the meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 182 the Court may direct that one member present in person or by proxy is deemed to constitute the meeting` FALSE EQUALS NOTHING
#ASSERT `s 182 the Court may direct that the personal representative of the deceased member may exercise the member's powers at the meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 182 the Court may direct that the personal representative of the deceased member may exercise the member's powers at the meeting` TRUE FALSE EQUALS NOTHING
#ASSERT `s 182 the Court may direct that the personal representative of the deceased member may exercise the member's powers at the meeting` FALSE TRUE EQUALS NOTHING
