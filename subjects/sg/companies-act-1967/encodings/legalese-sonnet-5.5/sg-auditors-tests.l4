IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-auditors`

-- Tests for sg-auditors.l4 (s 10). Expected values are worked out by hand from the subsection named beside each assertion.

§ `Section 10(1)`

-- A person who is not an accounting entity and acts knowingly: barred.
#ASSERT `s 10(1) the person may consent to be appointed, or act, as auditor for a company` FALSE TRUE EQUALS JUST FALSE
-- An accounting entity: the subsection bars others and grants this one nothing; not covered.
#ASSERT `s 10(1) the person may consent to be appointed, or act, as auditor for a company` TRUE TRUE EQUALS NOTHING
-- Not knowingly: the bar is limited to "knowingly"; not covered.
#ASSERT `s 10(1) the person may consent to be appointed, or act, as auditor for a company` FALSE FALSE EQUALS NOTHING
#ASSERT `s 10(1) the person may consent to be appointed, or act, as auditor for a company` TRUE FALSE EQUALS NOTHING

-- The prohibition: the forbidden act is a breach.
-- EXPECT BREACH
#TRACE `s 10(1) a person who is not an accounting entity must not knowingly consent to be appointed as auditor` "Pat" AT 0 WITH
    PARTY Individual "Pat" DOES `s 10(1)(a) knowingly consent to be appointed as auditor for a company` AT 2
-- EXPECT BREACH
#TRACE `s 10(1) a person who is not an accounting entity must not knowingly act as auditor` "Pat" AT 0 WITH
    PARTY Individual "Pat" DOES `s 10(1)(b) knowingly act as an auditor for a company` AT 2
-- Another act is not the forbidden one: the prohibition stands.
-- EXPECT RESIDUAL
#TRACE `s 10(1) a person who is not an accounting entity must not knowingly consent to be appointed as auditor` "Pat" AT 0 WITH
    PARTY Individual "Pat" DOES `s 10(1)(b) knowingly act as an auditor for a company` AT 2
-- Nothing done: the prohibition stands.
-- EXPECT RESIDUAL
#TRACE `s 10(1) a person who is not an accounting entity must not knowingly act as auditor` "Pat" AT 0 WITH
    -- no events

§ `Section 10(2)`

#ASSERT `s 10(2) the person acts as an auditor for the company` TRUE EQUALS JUST TRUE
-- "Without limiting (1)(b)": another way of acting is not excluded; not covered.
#ASSERT `s 10(2) the person acts as an auditor for the company` FALSE EQUALS NOTHING

§ `Section 10(3)`

-- Appointed without the entity's prior consent: barred.
#ASSERT `s 10(3) the company or person may appoint the accounting entity as an auditor of the company` FALSE EQUALS JUST FALSE
-- With consent: the subsection grants no power; not covered.
#ASSERT `s 10(3) the company or person may appoint the accounting entity as an auditor of the company` TRUE EQUALS NOTHING
-- EXPECT BREACH
#TRACE `s 10(3) no person may appoint an accounting entity as auditor without its prior consent` "Pat" AT 0 WITH
    PARTY Individual "Pat" DOES `s 10(3) appoint an accounting entity as an auditor of a company without obtaining the accounting entity's prior consent` AT 1

§ `Section 10(4): the form of the consent`

-- (a) a public accountant: in writing, signed by the public accountant.
#ASSERT `s 10(4) the consent has the form the subsection requires` `s 10(4)(a) a public accountant` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 10(4) the consent has the form the subsection requires` `s 10(4)(a) a public accountant` FALSE TRUE FALSE FALSE EQUALS JUST FALSE     -- not in writing
#ASSERT `s 10(4) the consent has the form the subsection requires` `s 10(4)(a) a public accountant` TRUE FALSE TRUE TRUE EQUALS JUST FALSE        -- signed by someone else, not by the public accountant
-- (b) an accounting firm: in writing, signed by at least one partner.
#ASSERT `s 10(4) the consent has the form the subsection requires` `s 10(4)(b) an accounting firm` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 10(4) the consent has the form the subsection requires` `s 10(4)(b) an accounting firm` TRUE TRUE FALSE TRUE EQUALS JUST FALSE        -- signed by a director, which is not a partner
-- (b) an accounting limited liability partnership: the same.
#ASSERT `s 10(4) the consent has the form the subsection requires` `s 10(4)(b) an accounting limited liability partnership` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 10(4) the consent has the form the subsection requires` `s 10(4)(b) an accounting limited liability partnership` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- (c) an accounting corporation: in writing, signed by at least one director.
#ASSERT `s 10(4) the consent has the form the subsection requires` `s 10(4)(c) an accounting corporation` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 10(4) the consent has the form the subsection requires` `s 10(4)(c) an accounting corporation` TRUE TRUE TRUE FALSE EQUALS JUST FALSE         -- signed by a partner-like person, not by a director
#ASSERT `s 10(4) the consent has the form the subsection requires` `s 10(4)(c) an accounting corporation` FALSE FALSE FALSE TRUE EQUALS JUST FALSE        -- not in writing
#ASSERT `s 10(4) who must sign the consent` `s 10(4)(a) a public accountant` EQUALS "the public accountant"
#ASSERT `s 10(4) who must sign the consent` `s 10(4)(b) an accounting firm` EQUALS "at least one partner of the firm"
#ASSERT `s 10(4) who must sign the consent` `s 10(4)(b) an accounting limited liability partnership` EQUALS "at least one partner of the limited liability partnership"
#ASSERT `s 10(4) who must sign the consent` `s 10(4)(c) an accounting corporation` EQUALS "at least one director of the corporation"

§ `Section 10(5): an accounting firm appointed in its own name`

-- A partner at the time of the appointment, then a public accountant: appointed.
#ASSERT `s 10(5) the person is appointed as an auditor of the company by the appointment of the accounting firm` TRUE TRUE TRUE EQUALS JUST TRUE
-- A partner admitted later: the subsection names the partners at the time of the appointment; not covered (not "no").
#ASSERT `s 10(5) the person is appointed as an auditor of the company by the appointment of the accounting firm` TRUE FALSE TRUE EQUALS NOTHING
-- A partner who was not then a public accountant: not covered.
#ASSERT `s 10(5) the person is appointed as an auditor of the company by the appointment of the accounting firm` TRUE TRUE FALSE EQUALS NOTHING
-- The firm was not appointed in its own name: the "Where" of the subsection fails, so it does not appoint the person (the periods ruling of 2026-11-05, item (b)).
#ASSERT `s 10(5) the person is appointed as an auditor of the company by the appointment of the accounting firm` FALSE TRUE TRUE EQUALS JUST FALSE

§ `Section 10(6): an accounting corporation appointed in its own name`

-- A director practising as a public accountant, whether a director at the time or later: appointed.
#ASSERT `s 10(6) the person is appointed as an auditor of the company by the appointment of the accounting corporation` TRUE TRUE FALSE EQUALS JUST TRUE
-- An employee practising as a public accountant: appointed.
#ASSERT `s 10(6) the person is appointed as an auditor of the company by the appointment of the accounting corporation` TRUE FALSE TRUE EQUALS JUST TRUE
-- Neither: not covered.
#ASSERT `s 10(6) the person is appointed as an auditor of the company by the appointment of the accounting corporation` TRUE FALSE FALSE EQUALS NOTHING
-- The corporation was not appointed in its own name: the "Where" fails.
#ASSERT `s 10(6) the person is appointed as an auditor of the company by the appointment of the accounting corporation` FALSE TRUE TRUE EQUALS JUST FALSE

§ `The gap: an accounting limited liability partnership appointed in its own name`

-- Neither (5) nor (6) mentions it: silent, whoever the person is.
#ASSERT `s 10(5) and (6) the person is appointed as an auditor of the company by the appointment of the accounting limited liability partnership` TRUE TRUE EQUALS NOTHING
#ASSERT `s 10(5) and (6) the person is appointed as an auditor of the company by the appointment of the accounting limited liability partnership` TRUE FALSE EQUALS NOTHING
