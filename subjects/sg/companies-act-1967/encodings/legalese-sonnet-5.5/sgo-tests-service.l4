IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgo-service`

-- Tests for sgo-service.l4 (ss 386A, 387, 387A, 387B, 387C, 387D).
-- Every expected value is written from the text of the section, beside the assertion, before the code was run.

§ `Section 386A`

-- in scope, no contrary intention, one of the two terms: the s 209A meaning.
#ASSERT `s 386A the meaning of the term is the meaning given by section 209A` TRUE FALSE TRUE EQUALS JUST TRUE
-- used outside the sections the paragraph names.
#ASSERT `s 386A the meaning of the term is the meaning given by section 209A` FALSE FALSE TRUE EQUALS NOTHING
-- "unless the contrary intention appears".
#ASSERT `s 386A the meaning of the term is the meaning given by section 209A` TRUE TRUE TRUE EQUALS JUST FALSE
-- some other term: the paragraph is silent.
#ASSERT `s 386A the meaning of the term is the meaning given by section 209A` TRUE FALSE FALSE EQUALS NOTHING
-- "financial statements" of a company that is not a parent company: those required by the Accounting Standards.
#ASSERT `s 386A "financial statements" the statements are the financial statements` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386A "financial statements" the statements are the financial statements` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- of a parent company: the consolidated financial statements.
#ASSERT `s 386A "financial statements" the statements are the financial statements` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
-- a parent company's own statements are not the "financial statements" the paragraph means.
#ASSERT `s 386A "financial statements" the statements are the financial statements` TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 386A "financial statements" the statements are the financial statements` FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 386A "financial statements" the statements are the financial statements` TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE

§ `Section 387: serving a document on a company`

#ASSERT `s 387 the document is served on the company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 387 the document is served on the company` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 387 the document is served on the company` FALSE FALSE EQUALS NOTHING

§ `Section 387A(1): notice by electronic communications`

-- notice to a member, electronically to the current address.
#ASSERT `s 387A(1) the notice may be given, sent or served using electronic communications to the current address of the person` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- notice to an officer or auditor.
#ASSERT `s 387A(1) the notice may be given, sent or served using electronic communications to the current address of the person` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- sent some other way: the subsection grants one way and says nothing of another.
#ASSERT `s 387A(1) the notice may be given, sent or served using electronic communications to the current address of the person` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- not a notice required or permitted by the Act or the constitution: the "Where" gate on a liberty with no bar to relieve answers NOTHING (S1b ruling, 2026S1bC).
#ASSERT `s 387A(1) the notice may be given, sent or served using electronic communications to the current address of the person` FALSE TRUE FALSE TRUE EQUALS NOTHING
-- a person who is not a member, officer or auditor.
#ASSERT `s 387A(1) the notice may be given, sent or served using electronic communications to the current address of the person` TRUE FALSE FALSE TRUE EQUALS NOTHING

§ `Section 387A(2) and (3): a notice published on a website`

-- (a) to (e) all met.
#ASSERT `s 387A(2) the notice of a meeting is treated as given, sent or served by publication on a website` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- each limb missing in turn: (a) agreement in writing.
#ASSERT `s 387A(2) the notice of a meeting is treated as given, sent or served by publication on a website` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- (b) the meeting is one the agreement applies to.
#ASSERT `s 387A(2) the notice of a meeting is treated as given, sent or served by publication on a website` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- (c) published legibly.
#ASSERT `s 387A(2) the notice of a meeting is treated as given, sent or served by publication on a website` TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- (d)(i) notified of the publication.
#ASSERT `s 387A(2) the notice of a meeting is treated as given, sent or served by publication on a website` TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- (d)(ii) notified of the address.
#ASSERT `s 387A(2) the notice of a meeting is treated as given, sent or served by publication on a website` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- (d)(iii) notified of the place and how to access.
#ASSERT `s 387A(2) the notice of a meeting is treated as given, sent or served by publication on a website` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- (e) accessible throughout.
#ASSERT `s 387A(2) the notice of a meeting is treated as given, sent or served by publication on a website` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- (3): treated as given at the time of the notification.
#ASSERT `s 387A(3) the day on which the notice is treated as given, sent or served` TRUE (Date 5 3 2025) EQUALS JUST (Date 5 3 2025)
#ASSERT `s 387A(3) the day on which the notice is treated as given, sent or served` FALSE (Date 5 3 2025) EQUALS NOTHING

§ `Section 387A(4), (5), (6), (7)`

#ASSERT `s 387A(4) the notice specifies the matters or information that the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 387A(4) the notice specifies the matters or information that the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 387A(4) the notice specifies the matters or information that the subsection requires` FALSE TRUE EQUALS NOTHING
#ASSERT `s 387A(4) the notice specifies the matters or information that the subsection requires` FALSE FALSE EQUALS NOTHING
-- (5): accessible for a part only, and the failure wholly attributable to circumstances the company could not reasonably prevent.
#ASSERT `s 387A(5) subsection (2) does not invalidate the proceedings of the meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 387A(5) subsection (2) does not invalidate the proceedings of the meeting` TRUE FALSE EQUALS NOTHING
#ASSERT `s 387A(5) subsection (2) does not invalidate the proceedings of the meeting` FALSE TRUE EQUALS NOTHING
-- (6): despite the constitution, whether or not it says otherwise.
#ASSERT `s 387A(6) the company may take advantage of the subsection despite its constitution` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 387A(6) the company may take advantage of the subsection despite its constitution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 387A(6) the company may take advantage of the subsection despite its constitution` FALSE TRUE EQUALS NOTHING
-- (7): the current address: notified in writing, and no reason to believe it will not reach the person.
#ASSERT `s 387A(7) the number or address is the current address of the person of the company` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 387A(7) the number or address is the current address of the person of the company` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 387A(7) the number or address is the current address of the person of the company` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 387A(7) the number or address is the current address of the person of the company` FALSE TRUE TRUE EQUALS NOTHING

§ `Section 387B(1) and (2)`

#ASSERT `s 387B(1) the document may be sent using electronic communications to the current address of the person` `s 387B(6)(a) something else` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 387B(1) the document may be sent using electronic communications to the current address of the person` `s 387B(6)(a) something else` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 387B(1) the document may be sent using electronic communications to the current address of the person` `s 387B(6)(a) something else` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 387B(1) the document may be sent using electronic communications to the current address of the person` `s 387B(6)(a) something else` FALSE TRUE FALSE TRUE EQUALS NOTHING
-- a share certificate, a debenture, a certificate of another interest, an instrument of transfer: not a "document".
#ASSERT `s 387B(1) the document may be sent using electronic communications to the current address of the person` `s 387B(6)(a)(i) a share certificate` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 387B(1) the document may be sent using electronic communications to the current address of the person` `s 387B(6)(a)(ii) a debenture` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 387B(1) the document may be sent using electronic communications to the current address of the person` `s 387B(6)(a)(iii) a certificate of any other interest in a company` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 387B(1) the document may be sent using electronic communications to the current address of the person` `s 387B(6)(a)(iv) an instrument of transfer of any share, debenture or other interest in a company` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- (2): a website, (a) to (d) all met.
#ASSERT `s 387B(2) the document is treated as sent to the person by publication on a website` `s 387B(6)(a) something else` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 387B(2) the document is treated as sent to the person by publication on a website` `s 387B(6)(a) something else` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 387B(2) the document is treated as sent to the person by publication on a website` `s 387B(6)(a) something else` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 387B(2) the document is treated as sent to the person by publication on a website` `s 387B(6)(a) something else` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 387B(2) the document is treated as sent to the person by publication on a website` `s 387B(6)(a) something else` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 387B(2) the document is treated as sent to the person by publication on a website` `s 387B(6)(a) something else` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 387B(2) the document is treated as sent to the person by publication on a website` `s 387B(6)(a) something else` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 387B(2) the document is treated as sent to the person by publication on a website` `s 387B(6)(a)(ii) a debenture` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE

§ `Section 387B(3): not less than the specified number of days before the meeting`

-- meeting on 31 March 2025, 14 days: the latest day is 17 March 2025 (sg-periods P5).
-- published from 16 March (before the latest day), accessible to the end, notified on 17 March (the latest day): treated as sent in time.
#ASSERT `s 387B(3) the document is treated as sent to the person not less than the specified number of days before the date of the meeting` TRUE 14 (Date 31 3 2025) (Date 16 3 2025) TRUE (Date 17 3 2025) EQUALS JUST TRUE
-- published only from 17 March: not "beginning before" the latest day (fork F-387B-3).
#ASSERT `s 387B(3) the document is treated as sent to the person not less than the specified number of days before the date of the meeting` TRUE 14 (Date 31 3 2025) (Date 17 3 2025) TRUE (Date 17 3 2025) EQUALS JUST FALSE
-- notified on 18 March: one day too late.
#ASSERT `s 387B(3) the document is treated as sent to the person not less than the specified number of days before the date of the meeting` TRUE 14 (Date 31 3 2025) (Date 10 3 2025) TRUE (Date 18 3 2025) EQUALS JUST FALSE
-- not accessible until the end of the meeting.
#ASSERT `s 387B(3) the document is treated as sent to the person not less than the specified number of days before the date of the meeting` TRUE 14 (Date 31 3 2025) (Date 10 3 2025) FALSE (Date 17 3 2025) EQUALS JUST FALSE
-- not treated as sent under subsection (2) at all.
#ASSERT `s 387B(3) the document is treated as sent to the person not less than the specified number of days before the date of the meeting` FALSE 14 (Date 31 3 2025) (Date 10 3 2025) TRUE (Date 17 3 2025) EQUALS NOTHING

§ `Section 387B(4), (5), (6)`

#ASSERT `s 387B(4) subsection (3) does not invalidate the proceedings of the meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 387B(4) subsection (3) does not invalidate the proceedings of the meeting` TRUE FALSE EQUALS NOTHING
#ASSERT `s 387B(4) subsection (3) does not invalidate the proceedings of the meeting` FALSE TRUE EQUALS NOTHING
#ASSERT `s 387B(5) the company may take advantage of the subsection despite its constitution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 387B(5) the company may take advantage of the subsection despite its constitution` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 387B(5) the company may take advantage of the subsection despite its constitution` FALSE FALSE EQUALS NOTHING
#ASSERT `s 387B(6)(a) the thing is within the word document` `s 387B(6)(a)(i) a share certificate` EQUALS JUST FALSE
#ASSERT `s 387B(6)(a) the thing is within the word document` `s 387B(6)(a)(ii) a debenture` EQUALS JUST FALSE
#ASSERT `s 387B(6)(a) the thing is within the word document` `s 387B(6)(a)(iii) a certificate of any other interest in a company` EQUALS JUST FALSE
#ASSERT `s 387B(6)(a) the thing is within the word document` `s 387B(6)(a)(iv) an instrument of transfer of any share, debenture or other interest in a company` EQUALS JUST FALSE
-- anything else: the paragraph says what "document" does not include, not what it does.
#ASSERT `s 387B(6)(a) the thing is within the word document` `s 387B(6)(a) something else` EQUALS NOTHING
#ASSERT `s 387B(6)(b) the act is within the word sending` TRUE EQUALS JUST TRUE
#ASSERT `s 387B(6)(b) the act is within the word sending` FALSE EQUALS NOTHING

§ `Section 387C`

-- (2) implied consent: (a), (b) and (c) of the constitution.
#ASSERT `s 387C(2) the member has given implied consent` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 387C(2) the member has given implied consent` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 387C(2) the member has given implied consent` TRUE FALSE TRUE EQUALS JUST FALSE
-- (c) fails where the member keeps a right to elect a physical copy.
#ASSERT `s 387C(2) the member has given implied consent` TRUE TRUE FALSE EQUALS JUST FALSE
-- (3) deemed consent: given the opportunity to elect, and failed to elect in time.
#ASSERT `s 387C(3) the member is deemed to have consented` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 387C(3) the member is deemed to have consented` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 387C(3) the member is deemed to have consented` FALSE TRUE FALSE EQUALS JUST FALSE
-- "subject to regulations mentioned in subsection (4)": the regulations are outside the text.
#ASSERT `s 387C(3) the member is deemed to have consented` TRUE TRUE TRUE EQUALS NOTHING
-- (1): express consent, in accordance with the constitution.
#ASSERT `s 387C(1) the notice or document may be sent to the member using electronic communications with the member's consent` `s 387B(6)(a) something else` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- implied consent.
#ASSERT `s 387C(1) the notice or document may be sent to the member using electronic communications with the member's consent` `s 387B(6)(a) something else` TRUE FALSE TRUE TRUE TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- deemed consent.
#ASSERT `s 387C(1) the notice or document may be sent to the member using electronic communications with the member's consent` `s 387B(6)(a) something else` TRUE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- no consent of any of the three kinds.
#ASSERT `s 387C(1) the notice or document may be sent to the member using electronic communications with the member's consent` `s 387B(6)(a) something else` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING
-- consent that is not in accordance with the constitution.
#ASSERT `s 387C(1) the notice or document may be sent to the member using electronic communications with the member's consent` `s 387B(6)(a) something else` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- excluded by regulations under section 411.
#ASSERT `s 387C(1) the notice or document may be sent to the member using electronic communications with the member's consent` `s 387B(6)(a) something else` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS NOTHING
-- not a notice or document the company is required or permitted to send to a member.
#ASSERT `s 387C(1) the notice or document may be sent to the member using electronic communications with the member's consent` `s 387B(6)(a) something else` FALSE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- a share certificate is not a "document" for the purposes of section 387C (s 387B(6)).
#ASSERT `s 387C(1) the notice or document may be sent to the member using electronic communications with the member's consent` `s 387B(6)(a)(i) a share certificate` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE

§ `Section 387D`

#ASSERT `s 387D the document may be sent using electronic communications to the company or the director` `s 387B(6)(a) something else` TRUE TRUE FALSE EQUALS JUST TRUE
-- the agreement has been revoked.
#ASSERT `s 387D the document may be sent using electronic communications to the company or the director` `s 387B(6)(a) something else` TRUE TRUE TRUE EQUALS NOTHING
-- no agreement.
#ASSERT `s 387D the document may be sent using electronic communications to the company or the director` `s 387B(6)(a) something else` TRUE FALSE FALSE EQUALS NOTHING
-- not a document the Act requires or permits a member, officer or auditor to send.
#ASSERT `s 387D the document may be sent using electronic communications to the company or the director` `s 387B(6)(a) something else` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 387D the document may be sent using electronic communications to the company or the director` `s 387B(6)(a)(iv) an instrument of transfer of any share, debenture or other interest in a company` TRUE TRUE FALSE EQUALS JUST FALSE
