IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sga2-nouns`
IMPORT `sga2-s76-prohibition`

-- Tests for sga2-s76-prohibition.l4: s 76(1), (1A), (2), (3), (4), (16), (17) of the Companies Act 1967 (Singapore).
-- Every expected value is written from the text (inputs/CoA1967.txt lines 7323-7410 and 8092-8100), beside its assertion, before the code was run.
-- Argument order of s 76(1) subsection (1) bars ...: public company; holding company public; ultimate holding company public; gives assistance; purpose; connection;
-- taken by (3) or (4); acquisition before or at the same time; acquisition proposed; shares in the company; shares in a holding or ultimate holding company; exception; (17).

§ `s 76(1): the companies the subsection binds`

-- "a public company or a company whose holding company or ultimate holding company is a public company": any one of the three.
#ASSERT `s 76(1) the company is one the subsection binds` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(1) the company is one the subsection binds` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76(1) the company is one the subsection binds` FALSE FALSE TRUE EQUALS JUST TRUE
-- A private company with no public holding company: the subsection says nothing of it (scope limit, no "only"): not covered.
#ASSERT `s 76(1) the company is one the subsection binds` FALSE FALSE FALSE EQUALS NOTHING

§ `s 76(1)(a) and (b): the acquisition`

-- (a): before or at the same time as the giving; shares in the company, or in a holding company or ultimate holding company.
#ASSERT `s 76(1)(a) the acquisition is one that paragraph (a) names` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76(1)(a) the acquisition is one that paragraph (a) names` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 76(1)(a) the acquisition is one that paragraph (a) names` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 76(1)(a) the acquisition is one that paragraph (a) names` TRUE FALSE FALSE EQUALS JUST FALSE
-- (b): the proposed acquisition of the same shares.
#ASSERT `s 76(1)(b) the proposed acquisition is one that paragraph (b) names` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76(1)(b) the proposed acquisition is one that paragraph (b) names` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 76(1)(b) the proposed acquisition is one that paragraph (b) names` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76(1)(b) the proposed acquisition is one that paragraph (b) names` TRUE FALSE FALSE EQUALS JUST FALSE

§ `s 76(1): the prohibition as a whole`

-- A public company gives financial assistance for the purpose of an acquisition that took place at the same time, of its own shares: barred.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- A private company whose holding company is a public company: barred.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` FALSE TRUE FALSE TRUE TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- A private company whose ultimate holding company is a public company: barred.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` FALSE FALSE TRUE TRUE TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- A private company outside any public group: the subsection does not speak of it: not covered.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` FALSE FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
-- Not covered stays not covered even where an exception is claimed: the class limit comes first.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` FALSE FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE TRUE FALSE TRUE FALSE EQUALS NOTHING
-- No financial assistance given at all: an element is unmet: the subsection bars nothing here.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` TRUE FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- Purpose, connection and the deeming of (3) or (4) each suffice; none of the three does not.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` TRUE FALSE FALSE TRUE FALSE TRUE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` TRUE FALSE FALSE TRUE FALSE FALSE TRUE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` TRUE FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- A proposed acquisition (limb (b)) with no acquisition yet: barred.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- Neither an acquisition nor a proposed one: unmet.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- Shares in a holding company or ultimate holding company of the company: barred.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- Shares in neither the company nor a holding company (shares in a stranger): unmet.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- "Except as otherwise expressly provided by this Act": an exception that applies takes the bar away.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- s 76(17): a contract entered into before 15 May 1987 that would have been lawful takes the bar away.
#ASSERT `s 76(1) subsection (1) bars the company from giving the financial assistance` TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE TRUE EQUALS JUST FALSE

§ `s 76(1) as a rule on the company: traces`

-- The company gives the assistance: the forbidden act is BREACH.
-- EXPECT BREACH
#TRACE `s 76(1) a company the subsection binds must not give the financial assistance` "Acme Pte Ltd" AT 0 WITH
    PARTY (Company "Acme Pte Ltd") DOES `s 76(1) give financial assistance for the purpose of, or in connection with, the acquisition or proposed acquisition of shares or units of shares` AT 3

-- No event: a standing prohibition, not a pass.
-- EXPECT RESIDUAL
#TRACE `s 76(1) a company the subsection binds must not give the financial assistance` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 5)

§ `s 76(1A): the company must not acquire its own shares or lend on the security of them`

#ASSERT `s 76(1A) subsection (1A) bars the company from the act` `s 76(1A)(a)(i) acquire shares or units of shares in the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(1A) subsection (1A) bars the company from the act` `s 76(1A)(a)(ii) purport to acquire shares or units of shares in a holding company or ultimate holding company of the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(1A) subsection (1A) bars the company from the act` `s 76(1A)(b)(i) lend money on the security of shares or units of shares in the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(1A) subsection (1A) bars the company from the act` `s 76(1A)(b)(ii) lend money on the security of shares or units of shares in a holding company or ultimate holding company of the company` FALSE FALSE EQUALS JUST TRUE
-- An act that is not one of the four: the provision's own question, unmet.
#ASSERT `s 76(1A) subsection (1A) bars the company from the act` `s 76(1) give financial assistance for the purpose of, or in connection with, the acquisition or proposed acquisition of shares or units of shares` FALSE FALSE EQUALS JUST FALSE
-- An exception expressly provided, or s 76(17), takes the bar away.
#ASSERT `s 76(1A) subsection (1A) bars the company from the act` `s 76(1A)(a)(i) acquire shares or units of shares in the company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 76(1A) subsection (1A) bars the company from the act` `s 76(1A)(a)(i) acquire shares or units of shares in the company` FALSE TRUE EQUALS JUST FALSE

-- Each forbidden act of (1A) reaches BREACH on its own trace.
-- EXPECT BREACH
#TRACE `s 76(1A) a company must not acquire its own shares or lend on the security of them` "Acme Pte Ltd" AT 0 WITH
    PARTY (Company "Acme Pte Ltd") DOES `s 76(1A)(a)(i) acquire shares or units of shares in the company` AT 2

-- EXPECT BREACH
#TRACE `s 76(1A)(a)(ii) a company must not purport to acquire shares in its holding company or ultimate holding company` "Acme Pte Ltd" AT 0 WITH
    PARTY (Company "Acme Pte Ltd") DOES `s 76(1A)(a)(ii) purport to acquire shares or units of shares in a holding company or ultimate holding company of the company` AT 2

-- EXPECT BREACH
#TRACE `s 76(1A)(b)(i) a company must not lend money on the security of shares in the company` "Acme Pte Ltd" AT 0 WITH
    PARTY (Company "Acme Pte Ltd") DOES `s 76(1A)(b)(i) lend money on the security of shares or units of shares in the company` AT 2

-- EXPECT BREACH
#TRACE `s 76(1A)(b)(ii) a company must not lend money on the security of shares in its holding company or ultimate holding company` "Acme Pte Ltd" AT 0 WITH
    PARTY (Company "Acme Pte Ltd") DOES `s 76(1A)(b)(ii) lend money on the security of shares or units of shares in a holding company or ultimate holding company of the company` AT 2

-- No event: standing prohibition.
-- EXPECT RESIDUAL
#TRACE `s 76(1A) a company must not acquire its own shares or lend on the security of them` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 5)

§ `s 76(2): the means of giving financial assistance`

-- "includes ... the making of a loan, the giving of a guarantee, the provision of security, the release of an obligation or the release of a debt or otherwise".
#ASSERT `s 76(2) the means is within the giving of financial assistance` `s 76(2) the making of a loan` EQUALS JUST TRUE
#ASSERT `s 76(2) the means is within the giving of financial assistance` `s 76(2) the giving of a guarantee` EQUALS JUST TRUE
#ASSERT `s 76(2) the means is within the giving of financial assistance` `s 76(2) the provision of security` EQUALS JUST TRUE
#ASSERT `s 76(2) the means is within the giving of financial assistance` `s 76(2) the release of an obligation` EQUALS JUST TRUE
#ASSERT `s 76(2) the means is within the giving of financial assistance` `s 76(2) the release of a debt` EQUALS JUST TRUE
-- Any other means: the list is open ("includes"), so the subsection does not say.
#ASSERT `s 76(2) the means is within the giving of financial assistance` `s 76(2) some other means` EQUALS NOTHING

§ `s 76(3) and (4): taken to have given the assistance for the purpose of, or in connection with, an acquisition`

-- (3): both (a) purposes that included the relevant purpose and (b) a substantial purpose.
#ASSERT `s 76(3) the company is taken to have given the assistance for the purpose of the acquisition` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(3) the company is taken to have given the assistance for the purpose of the acquisition` TRUE FALSE EQUALS NOTHING
#ASSERT `s 76(3) the company is taken to have given the assistance for the purpose of the acquisition` FALSE TRUE EQUALS NOTHING
#ASSERT `s 76(3) the company is taken to have given the assistance for the purpose of the acquisition` FALSE FALSE EQUALS NOTHING
-- (4): awareness that the assistance would assist (a) the acquisition of shares in the company or (b) payment of unpaid subscription or calls on shares already acquired.
#ASSERT `s 76(4) the company is taken to have given the assistance in connection with the acquisition` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76(4) the company is taken to have given the assistance in connection with the acquisition` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 76(4) the company is taken to have given the assistance in connection with the acquisition` FALSE FALSE EQUALS NOTHING

§ `s 76(16): the ways of acquiring`

-- "whether by way of purchase, subscription or otherwise": every way is within the reference.
#ASSERT `s 76(16) the way of acquiring is within the acquisition the section speaks of` `s 76(16) purchase` EQUALS JUST TRUE
#ASSERT `s 76(16) the way of acquiring is within the acquisition the section speaks of` `s 76(16) subscription` EQUALS JUST TRUE
#ASSERT `s 76(16) the way of acquiring is within the acquisition the section speaks of` `s 76(16) some other way` EQUALS JUST TRUE

§ `s 76(17): contracts entered into before 15 May 1987`

-- "before 15 May 1987": 14 May 1987 is before; 15 May 1987 is not.
#ASSERT `s 76(17) the section does not apply to the act or thing` (Date 14 5 1987) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(17) the section does not apply to the act or thing` (Date 31 12 1986) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(17) the section does not apply to the act or thing` (Date 15 5 1987) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76(17) the section does not apply to the act or thing` (Date 16 5 1987) TRUE TRUE EQUALS JUST FALSE
-- "if the doing of that act or thing would have been lawful if this Act had not been enacted": unmet.
#ASSERT `s 76(17) the section does not apply to the act or thing` (Date 14 5 1987) TRUE FALSE EQUALS JUST FALSE
-- "pursuant to a contract": the act is not done under that contract.
#ASSERT `s 76(17) the section does not apply to the act or thing` (Date 14 5 1987) FALSE TRUE EQUALS JUST FALSE
