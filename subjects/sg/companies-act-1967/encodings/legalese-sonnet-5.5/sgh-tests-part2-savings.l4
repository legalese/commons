IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgh-part2-savings`

-- Tests for sgh-part2-savings.l4 (ss 8E to 8H). Every expected value is written from the text of the section, beside the assertion, before the run.

§ `s 8E: advocates and solicitors`
-- (test alias a8e1 = `s 8E section 8A compels the advocate and solicitor to produce the document`)
#ASSERT `s 8E section 8A compels the advocate and solicitor to produce the document` TRUE TRUE EQUALS JUST FALSE   -- "Nothing in sections 8A and 8B compels the production by an advocate and solicitor of a document containing a privileged communication"
#ASSERT `s 8E section 8A compels the advocate and solicitor to produce the document` TRUE FALSE EQUALS NOTHING   -- an advocate and solicitor, but the document holds no privileged communication: the saving does not speak
#ASSERT `s 8E section 8A compels the advocate and solicitor to produce the document` FALSE TRUE EQUALS NOTHING   -- not an advocate and solicitor: the saving does not speak
-- (test alias a8e2 = `s 8E section 8B authorises the taking of possession of the document`)
#ASSERT `s 8E section 8B authorises the taking of possession of the document` TRUE TRUE EQUALS JUST FALSE   -- "nothing ... authorises the taking of possession of any such document which is in his or her possession"
#ASSERT `s 8E section 8B authorises the taking of possession of the document` TRUE FALSE EQUALS NOTHING   -- the privileged document is not in the advocate and solicitor's possession: the saving does not speak
#ASSERT `s 8E section 8B authorises the taking of possession of the document` FALSE TRUE EQUALS NOTHING   -- not an advocate and solicitor
-- (test alias a8e3 = `s 8E the advocate and solicitor is obliged to give the name and address of the person to whom or by or on behalf of whom the communication was made`)
#ASSERT `s 8E the advocate and solicitor is obliged to give the name and address of the person to whom or by or on behalf of whom the communication was made` TRUE TRUE EQUALS JUST TRUE   -- refuses to produce, and knows the name and address: "he or she is nevertheless obliged to give the name and address (if he or she knows them)"
#ASSERT `s 8E the advocate and solicitor is obliged to give the name and address of the person to whom or by or on behalf of whom the communication was made` TRUE FALSE EQUALS JUST FALSE   -- refuses but does not know them: "(if he or she knows them)"
#ASSERT `s 8E the advocate and solicitor is obliged to give the name and address of the person to whom or by or on behalf of whom the communication was made` FALSE TRUE EQUALS JUST FALSE   -- has not refused: the obligation is gated by the refusal ("if the advocate and solicitor refuses")
#ASSERT `s 8E the advocate and solicitor is obliged to give the name and address of the person to whom or by or on behalf of whom the communication was made` FALSE FALSE EQUALS JUST FALSE   -- neither

§ `s 8F: the Minister's power to investigate`
-- (test alias a8f = `s 8F the Minister has power under this section to investigate`)
#ASSERT `s 8F the Minister has power under this section to investigate` TRUE EQUALS JUST TRUE   -- "where the Minister has reason to suspect that a person has committed an offence under this Act, the Minister may make such investigation"
#ASSERT `s 8F the Minister has power under this section to investigate` FALSE EQUALS JUST FALSE   -- no reason to suspect: a failed "where" (periods ruling (b); split site (ii))

§ `s 8G: banks, insurers and financial institutions`
-- (test alias a8g1 = `s 8G section 8A authorises the Minister to call for the production of the books`)
#ASSERT `s 8G section 8A authorises the Minister to call for the production of the books` TRUE FALSE FALSE EQUALS JUST FALSE   -- a bank or merchant bank licensed under the Banking Act 1970 (a banking corporation): "Nothing in section 8A authorises the Minister to call for the production of books of a banking corporation"
#ASSERT `s 8G section 8A authorises the Minister to call for the production of the books` FALSE TRUE FALSE EQUALS JUST FALSE   -- a company carrying on insurance business
#ASSERT `s 8G section 8A authorises the Minister to call for the production of the books` FALSE FALSE TRUE EQUALS JUST FALSE   -- a financial institution subject to control by the Monetary Authority of Singapore
#ASSERT `s 8G section 8A authorises the Minister to call for the production of the books` FALSE FALSE FALSE EQUALS NOTHING   -- none of the three: the saving does not speak
-- (test alias a8g2 = `s 8G section 8F authorises the Minister to conduct an investigation into the corporation, company or institution`)
#ASSERT `s 8G section 8F authorises the Minister to conduct an investigation into the corporation, company or institution` TRUE FALSE FALSE EQUALS JUST FALSE   -- "nothing in section 8F authorises the Minister to conduct an investigation into any such corporation"
#ASSERT `s 8G section 8F authorises the Minister to conduct an investigation into the corporation, company or institution` FALSE TRUE FALSE EQUALS JUST FALSE   -- insurer
#ASSERT `s 8G section 8F authorises the Minister to conduct an investigation into the corporation, company or institution` FALSE FALSE TRUE EQUALS JUST FALSE   -- financial institution
#ASSERT `s 8G section 8F authorises the Minister to conduct an investigation into the corporation, company or institution` FALSE FALSE FALSE EQUALS NOTHING   -- none of the three

§ `s 8H(1): the bar on publishing or disclosing what section 8A or 8B obtained`
-- (test alias a8h1 = `s 8H(1) the publication or disclosure is barred`)
-- arguments: obtained under 8A or 8B; previous written consent given; to the Minister, the Registrar, their officers or a Part 9 inspector; required for (a) criminal proceedings; (b) Part 9 reports; (c) winding up proceedings; (d) proceedings under 8A or 8B
#ASSERT `s 8H(1) the publication or disclosure is barred` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- information obtained under 8A or 8B, no consent, no exception: barred
#ASSERT `s 8H(1) the publication or disclosure is barred` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- not information obtained under 8A or 8B: the subsection does not speak
#ASSERT `s 8H(1) the publication or disclosure is barred` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- "without the previous consent in writing of that corporation": consent given
#ASSERT `s 8H(1) the publication or disclosure is barred` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- "except to the Minister, the Registrar of Companies and their officers or to an inspector appointed under Part 9"
#ASSERT `s 8H(1) the publication or disclosure is barred` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- "unless the publication or disclosure is required (a)" criminal proceedings
#ASSERT `s 8H(1) the publication or disclosure is barred` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- (b) reports made by inspectors appointed under Part 9
#ASSERT `s 8H(1) the publication or disclosure is barred` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE   -- (c) winding up proceedings by the Minister
#ASSERT `s 8H(1) the publication or disclosure is barred` TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- (d) proceedings under section 8A or 8B

§ `s 8H(2): the offence and its penalty`
-- (test alias a8h2 = `s 8H(2) the person is guilty of the offence this subsection creates`)
#ASSERT `s 8H(2) the person is guilty of the offence this subsection creates` TRUE EQUALS JUST TRUE   -- "A person who publishes or discloses any information or document in contravention of this section shall be guilty of an offence"
#ASSERT `s 8H(2) the person is guilty of the offence this subsection creates` FALSE EQUALS JUST FALSE   -- no contravention: the subsection's own question (split site (i))
-- (test alias a8h2p = `s 8H(2) the most the person may be sentenced to on conviction`)
#ASSERT `s 8H(2) the most the person may be sentenced to on conviction` TRUE EQUALS JUST (Penalty OF 10000, 24, TRUE, FALSE)   -- "a fine not exceeding $10,000 or to imprisonment for a term not exceeding 2 years or to both" (24 months)
#ASSERT `s 8H(2) the most the person may be sentenced to on conviction` FALSE EQUALS NOTHING   -- no penalty is stated for a person who is not guilty
-- The text says $10,000 and 2 years: 10000 and 24 months, and both may be imposed.
#ASSERT (`s 8H(2) the most the person may be sentenced to on conviction` TRUE) EQUALS JUST (Penalty OF 10000, 24, TRUE, FALSE)

§ `Regulative rule: s 8H(1) the prohibition derived from the offence`
-- (test alias r8h = `s 8H(1) a person must not publish or disclose information or a document obtained under section 8A or 8B`)
-- EXPECT BREACH
#TRACE `s 8H(1) a person must not publish or disclose information or a document obtained under section 8A or 8B` "Dana" AT 0 WITH
    PARTY Individual "Dana" DOES `s 8H(1) publish or disclose information or a document obtained under section 8A or 8B, in contravention of section 8H` AT 2
-- EXPECT RESIDUAL
#TRACE `s 8H(1) a person must not publish or disclose information or a document obtained under section 8A or 8B` "Dana" AT 0 WITH

§ `Regulative rule: s 8E the duty to give the name and address (no time limit, no stated consequence: no breach path)`
-- EXPECT FULFILLED
#TRACE `s 8E the advocate and solicitor who refuses to produce the document must give the name and address` "Lee" AT 0 WITH
    PARTY Individual "Lee" DOES `s 8E give the name and address of the person to whom or by or on behalf of whom the communication was made` AT 40
-- EXPECT RESIDUAL
#TRACE `s 8E the advocate and solicitor who refuses to produce the document must give the name and address` "Lee" AT 0 WITH
