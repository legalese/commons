IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgi-names`

-- Tests for sgi-names.l4 (s 27). Expected values are written from the text beside each assertion.

§ `s 27(1): the names the Registrar must refuse`

-- Arguments: the Minister has consented; subsection (1B) applies; undesirable; identical to another name; identical to a reserved name; a kind the Minister has directed against.
#ASSERT `s 27(1) the Registrar must refuse to register the company under the name` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 27(1) the Registrar must refuse to register the company under the name` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 27(1) the Registrar must refuse to register the company under the name` FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 27(1) the Registrar must refuse to register the company under the name` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- No ground in (a) to (d): the text does not address the name (NOTHING).
#ASSERT `s 27(1) the Registrar must refuse to register the company under the name` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- The Minister has consented, or (1B) applies: the exception is met and the text is silent (NOTHING).
#ASSERT `s 27(1) the Registrar must refuse to register the company under the name` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 27(1) the Registrar must refuse to register the company under the name` FALSE TRUE FALSE TRUE FALSE FALSE EQUALS NOTHING

§ `s 27(1A): the waiting years for each earlier holder, and the bar`

#ASSERT `s 27(1A) the years that must pass after the date of dissolution, cancellation or cessation` `s 27(1A)(a)(i) a company dissolved following its winding up under the Insolvency, Restructuring and Dissolution Act 2018` EQUALS 2
#ASSERT `s 27(1A) the years that must pass after the date of dissolution, cancellation or cessation` `s 27(1A)(a)(ii) a company dissolved following its name being struck off the register under section 344 or 344A` EQUALS 6
#ASSERT `s 27(1A) the years that must pass after the date of dissolution, cancellation or cessation` `s 27(1A)(b) a person whose registration and registration of the business name has been cancelled under the Business Names Registration Act 2014 or had ceased under section 22 of that Act` EQUALS 1
#ASSERT `s 27(1A) the years that must pass after the date of dissolution, cancellation or cessation` `s 27(1A)(c) a foreign company notice of the dissolution of which has been given to the Registrar under section 377(2)` EQUALS 2
#ASSERT `s 27(1A) the years that must pass after the date of dissolution, cancellation or cessation` `s 27(1A)(d)(i) a limited liability partnership dissolved following its winding up under section 39 of, and the Fifth Schedule to, the Limited Liability Partnerships Act 2005` EQUALS 2
#ASSERT `s 27(1A) the years that must pass after the date of dissolution, cancellation or cessation` `s 27(1A)(d)(ii) a limited liability partnership dissolved following its name being struck off the register under section 63 of the Limited Liability Partnerships Act 2005` EQUALS 6
#ASSERT `s 27(1A) the years that must pass after the date of dissolution, cancellation or cessation` `s 27(1A)(e)(i) a limited partnership the registration of which was cancelled under section 14(1) or 19(4) of the Limited Partnerships Act 2008` EQUALS 1
#ASSERT `s 27(1A) the years that must pass after the date of dissolution, cancellation or cessation` `s 27(1A)(e)(ii) a limited partnership of which notice was lodged with the Registrar of Limited Partnerships that it was dissolved under section 19(2) of the Limited Partnerships Act 2008` EQUALS 1
#ASSERT `s 27(1A) the years that must pass after the date of dissolution, cancellation or cessation` `s 27(1A)(f)(i) a VCC dissolved following its winding up under Part 11 of the VCC Act` EQUALS 2
#ASSERT `s 27(1A) the years that must pass after the date of dissolution, cancellation or cessation` `s 27(1A)(f)(ii) a VCC dissolved following its name being struck off the register under section 344 or 344A as applied by section 130B of the VCC Act` EQUALS 6

-- Arguments: the earlier holder; the name is identical; the day of the dissolution; the date asked; the Minister has consented.
-- (a)(i): dissolved on 10 March 2020, 2 years run to 10 March 2022 (P1): on that day the name is still held back; the day after, the text is silent.
#ASSERT `s 27(1A) the Registrar must refuse to register the company under the name` `s 27(1A)(a)(i) a company dissolved following its winding up under the Insolvency, Restructuring and Dissolution Act 2018` TRUE (Date 10 3 2020) (Date 10 3 2022) FALSE EQUALS JUST TRUE
#ASSERT `s 27(1A) the Registrar must refuse to register the company under the name` `s 27(1A)(a)(i) a company dissolved following its winding up under the Insolvency, Restructuring and Dissolution Act 2018` TRUE (Date 10 3 2020) (Date 11 3 2022) FALSE EQUALS NOTHING
-- (a)(ii): 6 years run to 10 March 2026.
#ASSERT `s 27(1A) the Registrar must refuse to register the company under the name` `s 27(1A)(a)(ii) a company dissolved following its name being struck off the register under section 344 or 344A` TRUE (Date 10 3 2020) (Date 10 3 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 27(1A) the Registrar must refuse to register the company under the name` `s 27(1A)(a)(ii) a company dissolved following its name being struck off the register under section 344 or 344A` TRUE (Date 10 3 2020) (Date 11 3 2026) FALSE EQUALS NOTHING
-- (b): 1 year from 10 March 2025 runs to 10 March 2026.
#ASSERT `s 27(1A) the Registrar must refuse to register the company under the name` `s 27(1A)(b) a person whose registration and registration of the business name has been cancelled under the Business Names Registration Act 2014 or had ceased under section 22 of that Act` TRUE (Date 10 3 2025) (Date 10 3 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 27(1A) the Registrar must refuse to register the company under the name` `s 27(1A)(b) a person whose registration and registration of the business name has been cancelled under the Business Names Registration Act 2014 or had ceased under section 22 of that Act` TRUE (Date 10 3 2025) (Date 11 3 2026) FALSE EQUALS NOTHING
-- The name is not identical: the "if" fails and the text says no.
#ASSERT `s 27(1A) the Registrar must refuse to register the company under the name` `s 27(1A)(a)(i) a company dissolved following its winding up under the Insolvency, Restructuring and Dissolution Act 2018` FALSE (Date 10 3 2020) (Date 10 3 2021) FALSE EQUALS JUST FALSE
-- The Minister has consented: the exception is met (NOTHING).
#ASSERT `s 27(1A) the Registrar must refuse to register the company under the name` `s 27(1A)(a)(i) a company dissolved following its winding up under the Insolvency, Restructuring and Dissolution Act 2018` TRUE (Date 10 3 2020) (Date 10 3 2021) TRUE EQUALS NOTHING
-- Before 3 January 2016 the subsection does not bind (JUST FALSE); on 3 January 2016 it does.
#ASSERT `s 27(1A) the Registrar must refuse to register the company under the name` `s 27(1A)(a)(i) a company dissolved following its winding up under the Insolvency, Restructuring and Dissolution Act 2018` TRUE (Date 1 1 2015) (Date 2 1 2016) FALSE EQUALS JUST FALSE
#ASSERT `s 27(1A) the Registrar must refuse to register the company under the name` `s 27(1A)(a)(i) a company dissolved following its winding up under the Insolvency, Restructuring and Dissolution Act 2018` TRUE (Date 1 1 2015) (Date 3 1 2016) FALSE EQUALS JUST TRUE

§ `s 27(1B): the names the Registrar may register despite subsection (1)`

-- Arguments: foreign company name identical; notice under s 377(1); day of cessation; name struck off under s 377(8), (9) or (10); day struck off; limited partnership name identical; notice under s 19(1); day of cessation; date asked.
-- (a): cessation 10 March 2025 (3 months run to 10 June 2025), struck off 10 March 2020 (6 years run to 10 March 2026).
#ASSERT `s 27(1B) the Registrar may register the company under the name` TRUE TRUE (Date 10 3 2025) TRUE (Date 10 3 2020) FALSE FALSE (Date 1 1 2000) (Date 11 3 2026) EQUALS JUST TRUE
#ASSERT `s 27(1B) the Registrar may register the company under the name` TRUE TRUE (Date 10 3 2025) TRUE (Date 10 3 2020) FALSE FALSE (Date 1 1 2000) (Date 10 3 2026) EQUALS NOTHING
-- 3 months from 1 January 2026 run to 1 April 2026: the cessation limb is not yet met on 11 March 2026 (and the 6 years are).
#ASSERT `s 27(1B) the Registrar may register the company under the name` TRUE TRUE (Date 1 1 2026) TRUE (Date 10 3 2020) FALSE FALSE (Date 1 1 2000) (Date 11 3 2026) EQUALS NOTHING
-- The name was not struck off under s 377(8), (9) or (10): the literal "and" of (a)(i) and (a)(ii) is not met (NOTHING; fork F-I16).
#ASSERT `s 27(1B) the Registrar may register the company under the name` TRUE TRUE (Date 10 3 2025) FALSE (Date 10 3 2020) FALSE FALSE (Date 1 1 2000) (Date 11 3 2026) EQUALS NOTHING
-- (b): cessation 10 March 2025, one year runs to 10 March 2026.
#ASSERT `s 27(1B) the Registrar may register the company under the name` FALSE FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) TRUE TRUE (Date 10 3 2025) (Date 11 3 2026) EQUALS JUST TRUE
#ASSERT `s 27(1B) the Registrar may register the company under the name` FALSE FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) TRUE TRUE (Date 10 3 2025) (Date 10 3 2026) EQUALS NOTHING
-- Neither name is identical: NOTHING.
#ASSERT `s 27(1B) the Registrar may register the company under the name` FALSE FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE FALSE (Date 1 1 2000) (Date 11 3 2026) EQUALS NOTHING
-- Before 3 January 2016 the subsection does not apply (JUST FALSE).
#ASSERT `s 27(1B) the Registrar may register the company under the name` FALSE FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) TRUE TRUE (Date 1 1 2000) (Date 2 1 2016) EQUALS JUST FALSE

§ `s 27(2) and (2A): a direction to change a name, and who may ask for one`

#ASSERT `s 27(2) the Registrar may direct the company to change its name` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 27(2) the Registrar may direct the company to change its name` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 27(2) the Registrar may direct the company to change its name` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 27(2) the Registrar may direct the company to change its name` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 27(2) the Registrar may direct the company to change its name` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- No ground: a power gated by "where": NOTHING (split site (ii)).
#ASSERT `s 27(2) the Registrar may direct the company to change its name` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- The last day for compliance: 6 weeks after 1 March 2026 is 12 April 2026 (P1); a longer period the Registrar allows replaces it only if it is longer.
#ASSERT `s 27(2) the last day for compliance` (Date 1 3 2026) FALSE (Date 1 1 2000) EQUALS Date 12 4 2026
#ASSERT `s 27(2) the last day for compliance` (Date 1 3 2026) TRUE (Date 30 4 2026) EQUALS Date 30 4 2026
#ASSERT `s 27(2) the last day for compliance` (Date 1 3 2026) TRUE (Date 5 4 2026) EQUALS Date 12 4 2026

-- Arguments: day of the direction; a longer period allowed; its last day; the Minister has annulled the direction; the company has changed its name; the day it did; the date asked.
#ASSERT `s 27(2) the company has complied with the direction` (Date 1 3 2026) FALSE (Date 1 1 2000) FALSE TRUE (Date 12 4 2026) (Date 20 4 2026) EQUALS JUST TRUE
#ASSERT `s 27(2) the company has complied with the direction` (Date 1 3 2026) FALSE (Date 1 1 2000) FALSE TRUE (Date 13 4 2026) (Date 20 4 2026) EQUALS JUST FALSE
#ASSERT `s 27(2) the company has complied with the direction` (Date 1 3 2026) TRUE (Date 30 4 2026) FALSE TRUE (Date 20 4 2026) (Date 25 4 2026) EQUALS JUST TRUE
#ASSERT `s 27(2) the company has complied with the direction` (Date 1 3 2026) TRUE (Date 30 4 2026) FALSE TRUE (Date 1 5 2026) (Date 5 5 2026) EQUALS JUST FALSE
-- Not changed: asked on 13 April the 6 weeks have run (JUST FALSE); asked on 12 April the last day has not run out (NOTHING).
#ASSERT `s 27(2) the company has complied with the direction` (Date 1 3 2026) FALSE (Date 1 1 2000) FALSE FALSE (Date 1 1 2000) (Date 13 4 2026) EQUALS JUST FALSE
#ASSERT `s 27(2) the company has complied with the direction` (Date 1 3 2026) FALSE (Date 1 1 2000) FALSE FALSE (Date 1 1 2000) (Date 12 4 2026) EQUALS NOTHING
#ASSERT `s 27(2) the company has complied with the direction` (Date 1 3 2026) TRUE (Date 30 4 2026) FALSE FALSE (Date 1 1 2000) (Date 20 4 2026) EQUALS NOTHING
#ASSERT `s 27(2) the company has complied with the direction` (Date 1 3 2026) TRUE (Date 30 4 2026) FALSE FALSE (Date 1 1 2000) (Date 1 5 2026) EQUALS JUST FALSE
-- Annulled by the Minister: NOTHING.
#ASSERT `s 27(2) the company has complied with the direction` (Date 1 3 2026) FALSE (Date 1 1 2000) TRUE FALSE (Date 1 1 2000) (Date 20 4 2026) EQUALS NOTHING

-- The regulative rule, 42 days from the direction: an act on day 42 is in time, on day 43 it is not.
-- EXPECT FULFILLED
#TRACE `s 27(2) the company must change its name within 6 weeks of the direction` "Acme Pte. Ltd." 42 AT 0 WITH
    PARTY Company "Acme Pte. Ltd." DOES `s 27(2) change the company's name as the Registrar has directed` AT 42
-- EXPECT BREACH
#TRACE `s 27(2) the company must change its name within 6 weeks of the direction` "Acme Pte. Ltd." 42 AT 0 WITH
    PARTY Company "Acme Pte. Ltd." DOES `s 27(2) change the company's name as the Registrar has directed` AT 43
-- EXPECT BREACH
#TRACE `s 27(2) the company must change its name within 6 weeks of the direction` "Acme Pte. Ltd." 42 AT 0 WITH
    (WAITUNTIL 43)
-- EXPECT RESIDUAL
#TRACE `s 27(2) the company must change its name within 6 weeks of the direction` "Acme Pte. Ltd." 42 AT 0 WITH
    (WAITUNTIL 42)

-- (2A): in writing and on a ground referred to in subsection (2).
#ASSERT `s 27(2A) the person may apply to the Registrar for a direction to the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 27(2A) the person may apply to the Registrar for a direction to the company` FALSE TRUE EQUALS NOTHING
#ASSERT `s 27(2A) the person may apply to the Registrar for a direction to the company` TRUE FALSE EQUALS NOTHING
-- The 12-month bar on ground (2)(b): incorporated 1 March 2026, 12 months run to 1 March 2027.
#ASSERT `s 27(2A) the Registrar is barred from considering the application` TRUE (Date 1 3 2026) (Date 2 3 2027) EQUALS JUST TRUE
#ASSERT `s 27(2A) the Registrar is barred from considering the application` TRUE (Date 1 3 2026) (Date 1 3 2027) EQUALS NOTHING
#ASSERT `s 27(2A) the Registrar is barred from considering the application` FALSE (Date 1 3 2026) (Date 2 3 2027) EQUALS NOTHING

§ `s 27(2B): the offence`

#ASSERT `s 27(2B) the person is guilty of the offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 27(2B) the person is guilty of the offence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 27(2B) the person is guilty of the offence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 27(2B) the most the person may be sentenced to on conviction` TRUE TRUE EQUALS JUST (Penalty OF 2000, 0, FALSE, TRUE)
#ASSERT `s 27(2B) the most the person may be sentenced to on conviction` FALSE TRUE EQUALS NOTHING

§ `s 27(5) to (6): appeals to the Minister`

-- Arguments: the decision; the person is the aggrieved company or applicant; the day the Registrar made the decision; the day the applicant was informed of the refusal; the day of the appeal.
-- (a): 30 days after the decision on 10 March 2026 run to 9 April 2026.
#ASSERT `s 27(5) the person may appeal to the Minister against the decision` `s 27(5)(a) the Registrar's decision under subsection (2)` TRUE (Date 10 3 2026) (Date 1 1 2000) (Date 9 4 2026) EQUALS JUST TRUE
#ASSERT `s 27(5) the person may appeal to the Minister against the decision` `s 27(5)(a) the Registrar's decision under subsection (2)` TRUE (Date 10 3 2026) (Date 1 1 2000) (Date 10 4 2026) EQUALS JUST FALSE
-- (b): decision on 1 March 2026; the applicant informed on 10 March 2026: 30 days run to 9 April 2026 (the time runs from being informed, not from the decision).
#ASSERT `s 27(5) the person may appeal to the Minister against the decision` `s 27(5)(b) the Registrar's refusal to give a direction to a company under subsection (2) pursuant to an application under subsection (2A)` TRUE (Date 1 3 2026) (Date 10 3 2026) (Date 9 4 2026) EQUALS JUST TRUE
#ASSERT `s 27(5) the person may appeal to the Minister against the decision` `s 27(5)(b) the Registrar's refusal to give a direction to a company under subsection (2) pursuant to an application under subsection (2A)` TRUE (Date 1 3 2026) (Date 10 3 2026) (Date 10 4 2026) EQUALS JUST FALSE
-- Another person than the aggrieved one, or another decision: the text names no other (NOTHING).
#ASSERT `s 27(5) the person may appeal to the Minister against the decision` `s 27(5)(a) the Registrar's decision under subsection (2)` FALSE (Date 10 3 2026) (Date 1 1 2000) (Date 9 4 2026) EQUALS NOTHING
#ASSERT `s 27(5) the person may appeal to the Minister against the decision` `s 27(5) another decision` TRUE (Date 10 3 2026) (Date 1 1 2000) (Date 9 4 2026) EQUALS NOTHING
-- A decision made before 3 January 2016 is outside the subsection (NOTHING); one made on 3 January 2016 is inside it.
#ASSERT `s 27(5) the person may appeal to the Minister against the decision` `s 27(5)(a) the Registrar's decision under subsection (2)` TRUE (Date 2 1 2016) (Date 1 1 2000) (Date 3 1 2016) EQUALS NOTHING
#ASSERT `s 27(5) the person may appeal to the Minister against the decision` `s 27(5)(a) the Registrar's decision under subsection (2)` TRUE (Date 3 1 2016) (Date 1 1 2000) (Date 2 2 2016) EQUALS JUST TRUE

#ASSERT `s 27(5AA) the decision of the Minister on the appeal is final` TRUE EQUALS JUST TRUE
#ASSERT `s 27(5AA) the decision of the Minister on the appeal is final` FALSE EQUALS NOTHING
#ASSERT `s 27(5A) the Registrar or the Minister must accept as correct the decision of the Court to grant the injunction` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 27(5A) the Registrar or the Minister must accept as correct the decision of the Court to grant the injunction` TRUE FALSE EQUALS NOTHING
#ASSERT `s 27(5A) the Registrar or the Minister must accept as correct the decision of the Court to grant the injunction` FALSE TRUE EQUALS NOTHING
#ASSERT `s 27(6) the Minister must cause the direction to be published in the Gazette` TRUE EQUALS JUST TRUE
#ASSERT `s 27(6) the Minister must cause the direction to be published in the Gazette` FALSE EQUALS NOTHING

§ `s 27(7) to (9): the words in a name`

-- Arguments: the members' liability; the 2 years of section 17(6) have expired; section 29 exempts the company; the name has the word.
#ASSERT `s 27(7) the name of the limited company has the word Limited or Berhad as the subsection requires` `limited by shares` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 27(7) the name of the limited company has the word Limited or Berhad as the subsection requires` `limited by shares` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 27(7) the name of the limited company has the word Limited or Berhad as the subsection requires` `limited by guarantee` FALSE FALSE FALSE EQUALS JUST FALSE
-- Section 29 exempts: "Subject to section 29" (NOTHING).
#ASSERT `s 27(7) the name of the limited company has the word Limited or Berhad as the subsection requires` `limited by shares` FALSE TRUE FALSE EQUALS NOTHING
-- An unlimited company is not a limited company: the subsection is silent (NOTHING).
#ASSERT `s 27(7) the name of the limited company has the word Limited or Berhad as the subsection requires` `unlimited` FALSE FALSE FALSE EQUALS NOTHING
-- A company limited both by shares and guarantee is a limited company until the 2 years of section 17(6) expire.
#ASSERT `s 27(7) the name of the limited company has the word Limited or Berhad as the subsection requires` `limited by shares and by guarantee` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 27(7) the name of the limited company has the word Limited or Berhad as the subsection requires` `limited by shares and by guarantee` TRUE FALSE FALSE EQUALS NOTHING

-- (8): arguments: a private company; the members' liability; the word before Limited or Berhad; the word at the end of an unlimited company's name.
#ASSERT `s 27(8) the name of the private company has the word Private or Sendirian as the subsection requires` TRUE `limited by shares` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 27(8) the name of the private company has the word Private or Sendirian as the subsection requires` TRUE `limited by shares` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 27(8) the name of the private company has the word Private or Sendirian as the subsection requires` TRUE `unlimited` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 27(8) the name of the private company has the word Private or Sendirian as the subsection requires` TRUE `unlimited` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 27(8) the name of the private company has the word Private or Sendirian as the subsection requires` FALSE `limited by shares` TRUE FALSE EQUALS NOTHING

#ASSERT `s 27(9) the use is lawful and does not make the description of the company inadequate or incorrect` `s 27(9)(a) the abbreviation Pte. in lieu of the word Private` EQUALS JUST TRUE
#ASSERT `s 27(9) the use is lawful and does not make the description of the company inadequate or incorrect` `s 27(9)(a) the abbreviation Sdn. in lieu of the word Sendirian` EQUALS JUST TRUE
#ASSERT `s 27(9) the use is lawful and does not make the description of the company inadequate or incorrect` `s 27(9)(b) the abbreviation Ltd. in lieu of the word Limited` EQUALS JUST TRUE
#ASSERT `s 27(9) the use is lawful and does not make the description of the company inadequate or incorrect` `s 27(9)(b) the abbreviation Bhd. in lieu of the word Berhad` EQUALS JUST TRUE
#ASSERT `s 27(9) the use is lawful and does not make the description of the company inadequate or incorrect` `s 27(9)(c) the word in lieu of its corresponding abbreviation` EQUALS JUST TRUE
#ASSERT `s 27(9) the use is lawful and does not make the description of the company inadequate or incorrect` `s 27(9) another use` EQUALS NOTHING

§ `s 27(10) to (16): reserving a name`

#ASSERT `s 27(10) the person may apply to the Registrar for the reservation of the name` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 27(10) the person may apply to the Registrar for the reservation of the name` FALSE TRUE EQUALS NOTHING
#ASSERT `s 27(10) the person may apply to the Registrar for the reservation of the name` TRUE FALSE EQUALS NOTHING
-- (11): a bar until the name is reserved.
#ASSERT `s 27(11) the registration of the company, or the approval of the change of name, is barred` FALSE EQUALS JUST TRUE
#ASSERT `s 27(11) the registration of the company, or the approval of the change of name, is barred` TRUE EQUALS NOTHING
-- (12): "only if" both are satisfied.
#ASSERT `s 27(12) the Registrar may approve the application` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 27(12) the Registrar may approve the application` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 27(12) the Registrar may approve the application` FALSE TRUE EQUALS JUST FALSE
-- (12A): refuse on either ground.
#ASSERT `s 27(12A) the Registrar must refuse to approve the application` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 27(12A) the Registrar must refuse to approve the application` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 27(12A) the Registrar must refuse to approve the application` FALSE FALSE EQUALS JUST FALSE

-- (12B): approved and notified on 10 March 2026: 60 days run to 9 May 2026; one further 60 days to 8 July 2026; refused: ends on the day of the notification.
#ASSERT `s 27(12B) the last day of the reservation` TRUE (Date 10 3 2026) 0 EQUALS Date 9 5 2026
#ASSERT `s 27(12B) the last day of the reservation` TRUE (Date 10 3 2026) 1 EQUALS Date 8 7 2026
#ASSERT `s 27(12B) the last day of the reservation` FALSE (Date 10 3 2026) 0 EQUALS Date 10 3 2026
-- Arguments: an application made under (10); the day the Registrar received it; notified; approved; the day of the notification; the number of further periods; the date asked.
#ASSERT `s 27(12B) the name is reserved on the day` TRUE (Date 1 3 2026) TRUE TRUE (Date 10 3 2026) 0 (Date 9 5 2026) EQUALS JUST TRUE
#ASSERT `s 27(12B) the name is reserved on the day` TRUE (Date 1 3 2026) TRUE TRUE (Date 10 3 2026) 0 (Date 10 5 2026) EQUALS JUST FALSE
#ASSERT `s 27(12B) the name is reserved on the day` TRUE (Date 1 3 2026) TRUE TRUE (Date 10 3 2026) 1 (Date 10 5 2026) EQUALS JUST TRUE
#ASSERT `s 27(12B) the name is reserved on the day` TRUE (Date 1 3 2026) TRUE FALSE (Date 10 3 2026) 0 (Date 10 3 2026) EQUALS JUST TRUE
#ASSERT `s 27(12B) the name is reserved on the day` TRUE (Date 1 3 2026) TRUE FALSE (Date 10 3 2026) 0 (Date 11 3 2026) EQUALS JUST FALSE
-- Before the Registrar receives the application: not yet reserved (JUST FALSE). Received and not yet notified: the reservation runs (JUST TRUE).
#ASSERT `s 27(12B) the name is reserved on the day` TRUE (Date 1 3 2026) FALSE FALSE (Date 1 1 2000) 0 (Date 28 2 2026) EQUALS JUST FALSE
#ASSERT `s 27(12B) the name is reserved on the day` TRUE (Date 1 3 2026) FALSE FALSE (Date 1 1 2000) 0 (Date 5 3 2026) EQUALS JUST TRUE
-- No application under (10): outside the subsection (NOTHING).
#ASSERT `s 27(12B) the name is reserved on the day` FALSE (Date 1 3 2026) FALSE FALSE (Date 1 1 2000) 0 (Date 5 3 2026) EQUALS NOTHING

-- (12C): 30 days after being informed on 10 March 2026 run to 9 April 2026.
#ASSERT `s 27(12C) the person may appeal to the Minister against the decision` TRUE TRUE (Date 10 3 2026) (Date 9 4 2026) EQUALS JUST TRUE
#ASSERT `s 27(12C) the person may appeal to the Minister against the decision` TRUE TRUE (Date 10 3 2026) (Date 10 4 2026) EQUALS JUST FALSE
#ASSERT `s 27(12C) the person may appeal to the Minister against the decision` FALSE TRUE (Date 10 3 2026) (Date 9 4 2026) EQUALS NOTHING
#ASSERT `s 27(12C) the person may appeal to the Minister against the decision` TRUE FALSE (Date 10 3 2026) (Date 9 4 2026) EQUALS NOTHING

-- (13): during a reservation, and the Registrar satisfied of the bona fides.
#ASSERT `s 27(13) the Registrar may extend the period for a further period of 60 days` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 27(13) the Registrar may extend the period for a further period of 60 days` TRUE FALSE EQUALS NOTHING
#ASSERT `s 27(13) the Registrar may extend the period for a further period of 60 days` FALSE TRUE EQUALS NOTHING

-- (15): a reservation does not in itself entitle.
#ASSERT `s 27(15) the reservation in itself entitles the company to be registered by the name` TRUE EQUALS JUST FALSE
#ASSERT `s 27(15) the reservation in itself entitles the company to be registered by the name` FALSE EQUALS NOTHING

-- (16): the meaning is given by another Act.
#ASSERT `s 27(16) "registered business name" the name is a registered business name` TRUE EQUALS JUST TRUE
#ASSERT `s 27(16) "registered business name" the name is a registered business name` FALSE EQUALS JUST FALSE
