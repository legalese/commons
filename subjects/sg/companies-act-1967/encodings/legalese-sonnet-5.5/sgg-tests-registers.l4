IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgg-scope`
IMPORT `sgg-registers`

-- Tests for sgg-registers.l4 (ss 379 to 386). Expected values are written from the text of each subsection, beside the assertion.
-- Dates: Date day month year. A `-- EXPECT` comment above a #TRACE says what the trace must print; the lead checks each against the output.

§ `Section 379: the register of members`

-- (1) "registered under this Division on or after 31 March 2017"; (2) "before 31 March 2017".
#ASSERT `s 379(1) the foreign company must keep a register of its members and lodge the notice within 30 days after it is registered` (Date 31 3 2017) EQUALS JUST TRUE
#ASSERT `s 379(1) the foreign company must keep a register of its members and lodge the notice within 30 days after it is registered` (Date 1 1 2020) EQUALS JUST TRUE
#ASSERT `s 379(1) the foreign company must keep a register of its members and lodge the notice within 30 days after it is registered` (Date 30 3 2017) EQUALS JUST FALSE
#ASSERT `s 379(2) the foreign company must keep a register of its members and lodge the notice within 60 days after 31 March 2017` (Date 30 3 2017) EQUALS JUST TRUE
#ASSERT `s 379(2) the foreign company must keep a register of its members and lodge the notice within 60 days after 31 March 2017` (Date 31 3 2017) EQUALS JUST FALSE

-- (1)(a) Arguments: kept at its registered office in Singapore; kept at some other place in Singapore.
#ASSERT `s 379(1)(a) the register of members is kept at a place the paragraph allows` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 379(1)(a) the register of members is kept at a place the paragraph allows` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 379(1)(a) the register of members is kept at a place the paragraph allows` FALSE FALSE EQUALS JUST FALSE

-- "within 30 days after it is registered": registered 1 June 2026, the thirtieth day is 1 July 2026.
#ASSERT `s 379(1) the act was done within 30 days after the foreign company was registered` (Date 1 6 2026) (Date 1 7 2026) EQUALS JUST TRUE
#ASSERT `s 379(1) the act was done within 30 days after the foreign company was registered` (Date 1 6 2026) (Date 2 7 2026) EQUALS JUST FALSE
-- "within 60 days after that date": 31 March 2017 and 60 days is 30 May 2017.
#ASSERT `s 379(2) the act was done within 60 days after 31 March 2017` (Date 30 5 2017) EQUALS JUST TRUE
#ASSERT `s 379(2) the act was done within 60 days after 31 March 2017` (Date 31 5 2017) EQUALS JUST FALSE

-- (3)
#ASSERT `s 379(3) the foreign company must lodge a notice of the change with the Registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 379(3) the foreign company must lodge a notice of the change with the Registrar` FALSE EQUALS JUST FALSE
#ASSERT `s 379(3) the notice of the change was lodged within 30 days after the change` (Date 1 6 2026) (Date 1 7 2026) EQUALS JUST TRUE
#ASSERT `s 379(3) the notice of the change was lodged within 30 days after the change` (Date 1 6 2026) (Date 2 7 2026) EQUALS JUST FALSE

-- the duties with their time limits: done on the last day it is fulfilled; a day later, or never, it is breached.
-- EXPECT FULFILLED
#TRACE `s 379(1)(a) the foreign company must keep a register of its members within 30 days after it is registered` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 379(1)(a) keep a register of its members at its registered office in Singapore or at some other place in Singapore` AT 30
-- EXPECT BREACH
#TRACE `s 379(1)(a) the foreign company must keep a register of its members within 30 days after it is registered` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 379(1)(a) keep a register of its members at its registered office in Singapore or at some other place in Singapore` AT 31
-- EXPECT BREACH
#TRACE `s 379(1)(a) the foreign company must keep a register of its members within 30 days after it is registered` "Overseas Co" AT 0 WITH
    (WAITUNTIL 31)
-- EXPECT FULFILLED
#TRACE `s 379(1)(b) the foreign company must lodge a notice of the address of the register within 30 days after it is registered` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 379(1)(b) lodge a notice with the Registrar specifying the address at which the register of members is kept` AT 30
-- EXPECT BREACH
#TRACE `s 379(1)(b) the foreign company must lodge a notice of the address of the register within 30 days after it is registered` "Overseas Co" AT 0 WITH
    (WAITUNTIL 31)
-- (2) the trace starts on 31 March 2017.
-- EXPECT FULFILLED
#TRACE `s 379(2)(a) the foreign company must keep a register of its members within 60 days after 31 March 2017` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 379(1)(a) keep a register of its members at its registered office in Singapore or at some other place in Singapore` AT 60
-- EXPECT BREACH
#TRACE `s 379(2)(a) the foreign company must keep a register of its members within 60 days after 31 March 2017` "Overseas Co" AT 0 WITH
    (WAITUNTIL 61)
-- EXPECT FULFILLED
#TRACE `s 379(2)(b) the foreign company must lodge a notice of the address of the register within 60 days after 31 March 2017` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 379(1)(b) lodge a notice with the Registrar specifying the address at which the register of members is kept` AT 60
-- EXPECT BREACH
#TRACE `s 379(2)(b) the foreign company must lodge a notice of the address of the register within 60 days after 31 March 2017` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 379(1)(b) lodge a notice with the Registrar specifying the address at which the register of members is kept` AT 61
-- EXPECT FULFILLED
#TRACE `s 379(3) the foreign company must lodge a notice of the change of address within 30 days after the change` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 379(3) lodge a notice of the change in the address at which the register of members is kept` AT 30
-- EXPECT BREACH
#TRACE `s 379(3) the foreign company must lodge a notice of the change of address within 30 days after the change` "Overseas Co" AT 0 WITH
    (WAITUNTIL 31)

§ `Section 380: contents of the register, the index`

-- (1) Arguments: names and addresses; the date each name was entered; the date a former member ceased (previous 7 years); a share capital; (d)(i) the statement of the shares held; (d)(ii) the other particulars of the shares; every other particular prescribed.
#ASSERT `s 380(1) the register of members contains the particulars the subsection requires` TRUE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 380(1) the register of members contains the particulars the subsection requires` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- paragraph (d) reaches "a foreign company having a share capital": with one, both (i) and (ii) are needed.
#ASSERT `s 380(1) the register of members contains the particulars the subsection requires` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 380(1) the register of members contains the particulars the subsection requires` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 380(1) the register of members contains the particulars the subsection requires` FALSE TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 380(1) the register of members contains the particulars the subsection requires` TRUE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 380(1) the register of members contains the particulars the subsection requires` TRUE TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 380(1) the register of members contains the particulars the subsection requires` TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- (2) Arguments: the number of members; the register is in such a form as to constitute in itself an index. "more than 50".
#ASSERT `s 380(2) the foreign company must keep an index of the names of its members` 51 FALSE EQUALS JUST TRUE
#ASSERT `s 380(2) the foreign company must keep an index of the names of its members` 100 FALSE EQUALS JUST TRUE
#ASSERT `s 380(2) the foreign company must keep an index of the names of its members` 50 FALSE EQUALS JUST FALSE
#ASSERT `s 380(2) the foreign company must keep an index of the names of its members` 51 TRUE EQUALS JUST FALSE
-- (b) alteration of the register on 1 June 2026: the fourteenth day is 15 June 2026.
#ASSERT `s 380(2)(b) the index was altered within 14 days after the alteration of the register` (Date 1 6 2026) (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 380(2)(b) the index was altered within 14 days after the alteration of the register` (Date 1 6 2026) (Date 16 6 2026) EQUALS JUST FALSE
-- (c)
#ASSERT `s 380(2)(c) the index is kept where paragraph (c) requires` TRUE EQUALS JUST TRUE
#ASSERT `s 380(2)(c) the index is kept where paragraph (c) requires` FALSE EQUALS JUST FALSE
-- (3)
#ASSERT `s 380(3) the index contains what the subsection requires` TRUE EQUALS JUST TRUE
#ASSERT `s 380(3) the index contains what the subsection requires` FALSE EQUALS JUST FALSE
-- (4)
#ASSERT `s 380(4) the foreign company must update the register of members to reflect the change` TRUE EQUALS JUST TRUE
#ASSERT `s 380(4) the foreign company must update the register of members to reflect the change` FALSE EQUALS JUST FALSE
#ASSERT `s 380(4) the register was updated within 30 days after the change` (Date 1 6 2026) (Date 1 7 2026) EQUALS JUST TRUE
#ASSERT `s 380(4) the register was updated within 30 days after the change` (Date 1 6 2026) (Date 2 7 2026) EQUALS JUST FALSE

-- (2)(a) and (2)(c) have no time limit in the text: with no event the duty stays open, and a late act still fulfils it.
-- EXPECT RESIDUAL
#TRACE `s 380(2)(a) the foreign company must keep an index in convenient form of the names of its members` "Overseas Co" AT 0 WITH
    (WAITUNTIL 400)
-- EXPECT FULFILLED
#TRACE `s 380(2)(a) the foreign company must keep an index in convenient form of the names of its members` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 380(2)(a) keep an index in convenient form of the names of the members` AT 400
-- EXPECT RESIDUAL
#TRACE `s 380(2)(c) the foreign company must keep the index at the same place as the register of members` "Overseas Co" AT 0 WITH
    (WAITUNTIL 400)
-- EXPECT FULFILLED
#TRACE `s 380(2)(c) the foreign company must keep the index at the same place as the register of members` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 380(2)(c) keep the index at the same place as the register of members` AT 400
-- (2)(b) 14 days.
-- EXPECT FULFILLED
#TRACE `s 380(2)(b) the foreign company must make the necessary alteration in the index within 14 days after the alteration of the register` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 380(2)(b) make the necessary alteration in the index` AT 14
-- EXPECT BREACH
#TRACE `s 380(2)(b) the foreign company must make the necessary alteration in the index within 14 days after the alteration of the register` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 380(2)(b) make the necessary alteration in the index` AT 15
-- EXPECT BREACH
#TRACE `s 380(2)(b) the foreign company must make the necessary alteration in the index within 14 days after the alteration of the register` "Overseas Co" AT 0 WITH
    (WAITUNTIL 15)
-- (4) 30 days.
-- EXPECT FULFILLED
#TRACE `s 380(4) the foreign company must update the register of members within 30 days after the change` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 380(4) update the register of members to reflect the change` AT 30
-- EXPECT BREACH
#TRACE `s 380(4) the foreign company must update the register of members within 30 days after the change` "Overseas Co" AT 0 WITH
    (WAITUNTIL 31)

§ `Sections 381 and 382: evidence`

-- 381 Arguments: the register was kept under section 379; the matter is one the register is required under this Division to contain.
#ASSERT `s 381 the register is prima facie evidence of the matter` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 381 the register is prima facie evidence of the matter` FALSE TRUE EQUALS NOTHING
#ASSERT `s 381 the register is prima facie evidence of the matter` TRUE FALSE EQUALS NOTHING
-- 382 Arguments: made under the seal of the foreign company; made in a manner permitted by the laws of the place where it is incorporated or established; specifies shares held by a member and registered in the register kept under section 379.
#ASSERT `s 382 the certificate is prima facie evidence of the title of the member to the shares and the registration of the shares in the register` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 382 the certificate is prima facie evidence of the title of the member to the shares and the registration of the shares in the register` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 382 the certificate is prima facie evidence of the title of the member to the shares and the registration of the shares in the register` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 382 the certificate is prima facie evidence of the title of the member to the shares and the registration of the shares in the register` TRUE FALSE FALSE EQUALS NOTHING

§ `Section 383: bearer shares and share warrants`

-- (1) Arguments: an allotment, issue, sale, transfer, assignment or other disposition; in Singapore; of a bearer share or share warrant; by a foreign company registered under this Division.
#ASSERT `s 383(1) the disposition is void` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 383(1) the disposition is void` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 383(1) the disposition is void` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 383(1) the disposition is void` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 383(1) the disposition is void` FALSE TRUE TRUE TRUE EQUALS NOTHING
-- (2) Arguments: civil proceedings in a court; for or in respect of such a share or warrant of a foreign company registered under this Division.
#ASSERT `s 383(2) the civil proceedings may not be brought or maintained` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 383(2) the civil proceedings may not be brought or maintained` FALSE TRUE EQUALS NOTHING
#ASSERT `s 383(2) the civil proceedings may not be brought or maintained` TRUE FALSE EQUALS NOTHING

§ `Sections 384 and 385: regulations`

#ASSERT `s 384(a)(i) the provision of Division 7 of Part 4 relating to the transfer of shares applies to the transfer of shares in the foreign company` TRUE EQUALS JUST TRUE
#ASSERT `s 384(a)(i) the provision of Division 7 of Part 4 relating to the transfer of shares applies to the transfer of shares in the foreign company` FALSE EQUALS NOTHING
#ASSERT `s 384(a)(ii) the provision of Division 4 of Part 5 relating to the register of members applies to the register of members of the foreign company` TRUE EQUALS JUST TRUE
#ASSERT `s 384(a)(ii) the provision of Division 4 of Part 5 relating to the register of members applies to the register of members of the foreign company` FALSE EQUALS NOTHING
#ASSERT `s 384(b) the foreign company is exempt from the provision of this Division` TRUE EQUALS JUST TRUE
#ASSERT `s 384(b) the foreign company is exempt from the provision of this Division` FALSE EQUALS NOTHING

§ `Section 386: penalties`

-- the provisions of this Division that expressly mention a penalty or punishment.
#ASSERT `s 386 a penalty or punishment is expressly mentioned in the provision` `s 368A(5) a director's or authorised representative's failure to give the information` EQUALS JUST TRUE
#ASSERT `s 386 a penalty or punishment is expressly mentioned in the provision` `s 372(1C) a director's or authorised representative's default in complying with subsection (1A)` EQUALS JUST TRUE
#ASSERT `s 386 a penalty or punishment is expressly mentioned in the provision` `s 373(18) a default in complying with section 373, other than subsection (7A)` EQUALS JUST TRUE
#ASSERT `s 386 a penalty or punishment is expressly mentioned in the provision` `s 373(18A) a default in complying with section 373(7A)` EQUALS JUST TRUE
#ASSERT `s 386 a penalty or punishment is expressly mentioned in the provision` `s 378(7) a failure to comply with section 378(4)` EQUALS JUST TRUE
#ASSERT `s 386 a penalty or punishment is expressly mentioned in the provision` `s 386 some other provision of this Division` EQUALS JUST FALSE

-- Arguments: the role of the person; default is made by the foreign company in complying with a provision of this Division; the provision is one in which a penalty or punishment is expressly mentioned; the officer is in default; the person knowingly and wilfully authorised or permitted the default.
-- the company: "a fine not exceeding $1,000 and also to a default penalty"; no term of imprisonment is stated.
#ASSERT (`s 386 the offence and its penalty` `s 365 role: the foreign company` TRUE FALSE FALSE FALSE)'s `s 386 the offence applies` EQUALS JUST TRUE
#ASSERT (`s 386 the offence and its penalty` `s 365 role: the foreign company` TRUE FALSE FALSE FALSE)'s `s 386 the maximum fine, in dollars` EQUALS JUST 1000
#ASSERT (`s 386 the offence and its penalty` `s 365 role: the foreign company` TRUE FALSE FALSE FALSE)'s `s 386 the maximum term of imprisonment, in months` EQUALS NOTHING
#ASSERT (`s 386 the offence and its penalty` `s 365 role: the foreign company` TRUE FALSE FALSE FALSE)'s `s 386 a default penalty also applies` EQUALS JUST TRUE
-- "other than a provision in which a penalty or punishment is expressly mentioned": that provision has its own penalty.
#ASSERT (`s 386 the offence and its penalty` `s 365 role: the foreign company` TRUE TRUE FALSE FALSE)'s `s 386 the offence applies` EQUALS JUST FALSE
-- no default made.
#ASSERT (`s 386 the offence and its penalty` `s 365 role: the foreign company` FALSE FALSE FALSE FALSE)'s `s 386 the offence applies` EQUALS JUST FALSE
-- every officer "who is in default"; a director is an officer.
#ASSERT (`s 386 the offence and its penalty` `s 365 role: an officer of the foreign company` TRUE FALSE TRUE FALSE)'s `s 386 the offence applies` EQUALS JUST TRUE
#ASSERT (`s 386 the offence and its penalty` `s 365 role: an officer of the foreign company` TRUE FALSE FALSE FALSE)'s `s 386 the offence applies` EQUALS JUST FALSE
#ASSERT (`s 386 the offence and its penalty` `s 365 role: a director of the foreign company, or an equivalent person` TRUE FALSE TRUE FALSE)'s `s 386 the offence applies` EQUALS JUST TRUE
#ASSERT (`s 386 the offence and its penalty` `s 365 role: a director of the foreign company, or an equivalent person` TRUE FALSE FALSE FALSE)'s `s 386 the offence applies` EQUALS JUST FALSE
-- every authorised representative "who knowingly and wilfully authorises or permits the default".
#ASSERT (`s 386 the offence and its penalty` `s 365 role: an authorised representative of the foreign company` TRUE FALSE FALSE TRUE)'s `s 386 the offence applies` EQUALS JUST TRUE
#ASSERT (`s 386 the offence and its penalty` `s 365 role: an authorised representative of the foreign company` TRUE FALSE TRUE FALSE)'s `s 386 the offence applies` EQUALS JUST FALSE
#ASSERT (`s 386 the offence and its penalty` `s 365 role: an authorised representative of the foreign company` TRUE FALSE FALSE TRUE)'s `s 386 the maximum fine, in dollars` EQUALS JUST 1000
-- anyone else is not named.
#ASSERT (`s 386 the offence and its penalty` `s 365 role: someone else` TRUE FALSE TRUE TRUE)'s `s 386 the offence applies` EQUALS NOTHING
