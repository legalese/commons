#ASSERT `s 76(9B)(a) the board has passed the resolution the paragraph requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(9B)(a) the board has passed the resolution the paragraph requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 76(9B)(a) the board has passed the resolution the paragraph requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76(9B)(a) the board has passed the resolution the paragraph requires` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76(9B)(a) the board has passed the resolution the paragraph requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 76(9B)(b) the resolution sets out the grounds` TRUE EQUALS JUST TRUE
#ASSERT `s 76(9B)(b) the resolution sets out the grounds` FALSE EQUALS JUST FALSE
