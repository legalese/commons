#ASSERT `s 76(9B)(d) the company has sent the members the notice in time` (Date 15 10 2026) (Date 16 10 2026) TRUE TRUE TRUE FALSE TRUE TRUE TRUE EMPTY EQUALS JUST FALSE
#ASSERT `s 76(9B)(d) the company has sent the members the notice in time` (Date 15 10 2026) (Date 16 10 2026) TRUE TRUE TRUE TRUE FALSE TRUE TRUE EMPTY EQUALS JUST FALSE
#ASSERT `s 76(9B)(d) the company has sent the members the notice in time` (Date 15 10 2026) (Date 16 10 2026) TRUE TRUE TRUE TRUE TRUE FALSE TRUE EMPTY EQUALS JUST FALSE
#ASSERT `s 76(9B)(d) the company has sent the members the notice in time` (Date 15 10 2026) (Date 16 10 2026) TRUE TRUE TRUE TRUE TRUE TRUE FALSE EMPTY EQUALS JUST FALSE
-- (e): passed by all the members present and voting (i), or, where proposed by written means under s 184A, by all the members (ii).
#ASSERT `s 76(9B)(e) the members have passed the resolution the paragraph requires` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(9B)(e) the members have passed the resolution the paragraph requires` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(9B)(e) the members have passed the resolution the paragraph requires` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 76(9B)(e) the members have passed the resolution the paragraph requires` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 76(9B)(e) the members have passed the resolution the paragraph requires` FALSE FALSE FALSE EQUALS JUST FALSE
-- (f): the members' resolution passed Friday 16 October 2026; lodged by Monday 19 October.
#ASSERT `s 76(9B)(f) the company has lodged the copies with the Registrar in time` (Date 16 10 2026) (Date 19 10 2026) TRUE TRUE EMPTY EQUALS JUST TRUE
#ASSERT `s 76(9B)(f) the company has lodged the copies with the Registrar in time` (Date 16 10 2026) (Date 20 10 2026) TRUE TRUE EMPTY EQUALS JUST FALSE
#ASSERT `s 76(9B)(f) the company has lodged the copies with the Registrar in time` (Date 16 10 2026) (Date 19 10 2026) FALSE TRUE EMPTY EQUALS JUST FALSE
#ASSERT `s 76(9B)(f) the company has lodged the copies with the Registrar in time` (Date 16 10 2026) (Date 19 10 2026) TRUE FALSE EMPTY EQUALS JUST FALSE
-- (g): "not more than 12 months after the resolution": 15 January 2026 to 15 January 2027 is within it; 16 January 2027 is not.
#ASSERT `s 76(9B)(g) the assistance is given within 12 months of the resolution` (Date 15 1 2026) (Date 15 1 2027) EQUALS JUST TRUE
#ASSERT `s 76(9B)(g) the assistance is given within 12 months of the resolution` (Date 15 1 2026) (Date 16 1 2027) EQUALS JUST FALSE
-- A resolution passed on 29 February 2024: 12 months later ends on 28 February 2025 (the keel's convention P4, a month's end clamped).
#ASSERT `s 76(9B)(g) the assistance is given within 12 months of the resolution` (Date 29 2 2024) (Date 28 2 2025) EQUALS JUST TRUE
#ASSERT `s 76(9B)(g) the assistance is given within 12 months of the resolution` (Date 29 2 2024) (Date 1 3 2025) EQUALS JUST FALSE

