IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgc1-s199`

-- Tests for sgc1-s199.l4 (section 199). Every expected value is written from the text of the section, before the run, and sits beside its assertion.
-- A "not covered" answer is asserted as NOTHING.

§ `s 199(1): the records`

-- all three limbs: JUST TRUE
#ASSERT `s 199(1) the company has caused the records to be kept as the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
-- each limb missing in turn: JUST FALSE ("must cause to be kept such records as will sufficiently explain ..., enable true and fair financial statements ... and be conveniently and properly audited")
#ASSERT `s 199(1) the company has caused the records to be kept as the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 199(1) the company has caused the records to be kept as the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 199(1) the company has caused the records to be kept as the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE

-- EXPECT FULFILLED (the company causes the records to be kept)
#TRACE `s 199(1) a company must cause accounting and other records to be kept` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 199(1) cause accounting and other records to be kept` AT 5

-- EXPECT RESIDUAL (no event: the standing duty; no time limit and no consequence inside the subsection, so no trace reaches BREACH)
#TRACE `s 199(1) a company must cause accounting and other records to be kept` "Acme Pte Ltd" AT 0 WITH

§ `s 199(2): the retention period`

-- the period ends 5 years after the end of the financial year: 31 December 2020 -> 31 December 2025
#ASSERT `s 199(2) the last day of the period for which the company must retain the records` (Date 31 12 2020) EQUALS Date 31 12 2025
-- the end of the financial year falls on 29 February 2020: 5 years later has no 29 February, so P4 gives 28 February 2025
#ASSERT `s 199(2) the last day of the period for which the company must retain the records` (Date 29 2 2020) EQUALS Date 28 2 2025
-- both sides of the end of the period
#ASSERT `s 199(2) the subsection requires the company to retain the records on the day` (Date 31 12 2020) (Date 31 12 2025) EQUALS JUST TRUE
#ASSERT `s 199(2) the subsection requires the company to retain the records on the day` (Date 31 12 2020) (Date 1 1 2026) EQUALS JUST FALSE
-- both sides of the start of the period
#ASSERT `s 199(2) the subsection requires the company to retain the records on the day` (Date 31 12 2020) (Date 1 1 2021) EQUALS JUST TRUE
#ASSERT `s 199(2) the subsection requires the company to retain the records on the day` (Date 31 12 2020) (Date 31 12 2020) EQUALS NOTHING
#ASSERT `s 199(2) the subsection requires the company to retain the records on the day` (Date 31 12 2020) (Date 30 6 2020) EQUALS NOTHING

-- the clock counts days from the end of the financial year; 31 December 2020 to 31 December 2025 is 1826 days (2024 is a leap year)
-- EXPECT BREACH (disposal on day 1000, inside the 5 years)
#TRACE `s 199(2) a company must not dispose of the records within 5 years from the end of the financial year` "Acme Pte Ltd" 1826 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 199(2) dispose of the records within 5 years from the end of the financial year in which the transactions or operations are completed` AT 1000

-- EXPECT BREACH (disposal on the last day of the 5 years)
#TRACE `s 199(2) a company must not dispose of the records within 5 years from the end of the financial year` "Acme Pte Ltd" 1826 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 199(2) dispose of the records within 5 years from the end of the financial year in which the transactions or operations are completed` AT 1826

-- EXPECT FULFILLED (disposal on the day after the 5 years)
#TRACE `s 199(2) a company must not dispose of the records within 5 years from the end of the financial year` "Acme Pte Ltd" 1826 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 199(2) dispose of the records within 5 years from the end of the financial year in which the transactions or operations are completed` AT 1827

-- EXPECT FULFILLED (no disposal and the period runs out)
#TRACE `s 199(2) a company must not dispose of the records within 5 years from the end of the financial year` "Acme Pte Ltd" 1826 AT 0 WITH
    WAITUNTIL 1827

§ `s 199(2A): internal accounting controls`

#ASSERT `s 199(2A) the company must devise and maintain a system of internal accounting controls` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 199(2A) the company must devise and maintain a system of internal accounting controls` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 199(2A) the company must devise and maintain a system of internal accounting controls` TRUE TRUE EQUALS JUST TRUE
-- a private company that is not a subsidiary of a public company: not covered
#ASSERT `s 199(2A) the company must devise and maintain a system of internal accounting controls` FALSE FALSE EQUALS NOTHING

-- compliance: public, system maintained, both assurances
#ASSERT `s 199(2A) the company has devised and maintained the system the subsection requires` TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- a subsidiary of a public company, all met
#ASSERT `s 199(2A) the company has devised and maintained the system the subsection requires` FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- no system
#ASSERT `s 199(2A) the company has devised and maintained the system the subsection requires` TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- assurance (a) missing
#ASSERT `s 199(2A) the company has devised and maintained the system the subsection requires` TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
-- assurance (b) missing
#ASSERT `s 199(2A) the company has devised and maintained the system the subsection requires` TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- outside the class of companies: not covered
#ASSERT `s 199(2A) the company has devised and maintained the system the subsection requires` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- EXPECT FULFILLED
#TRACE `s 199(2A) a public company or a subsidiary company of a public company must devise and maintain a system of internal accounting controls` "Acme Bhd" AT 0 WITH
    PARTY Company "Acme Bhd" DOES `s 199(2A) devise and maintain a system of internal accounting controls` AT 3

§ `s 199(3): where the records are kept`

#ASSERT `s 199(3) the records are kept as the subsection requires` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 199(3) the records are kept as the subsection requires` FALSE TRUE TRUE EQUALS JUST TRUE
-- neither place
#ASSERT `s 199(3) the records are kept as the subsection requires` FALSE FALSE TRUE EQUALS JUST FALSE
-- not open to inspection at all times
#ASSERT `s 199(3) the records are kept as the subsection requires` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 199(3) the records must be open to inspection by the person` TRUE EQUALS JUST TRUE
#ASSERT `s 199(3) the records must be open to inspection by the person` FALSE EQUALS NOTHING

-- EXPECT FULFILLED
#TRACE `s 199(3) a company must keep its accounting records open to inspection by the directors` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 199(3) keep the records open to inspection by the directors` AT 1

§ `s 199(4): records kept outside Singapore`

#ASSERT `s 199(4) the company must send to and keep at a place in Singapore statements and returns` TRUE EQUALS JUST TRUE
#ASSERT `s 199(4) the company must send to and keep at a place in Singapore statements and returns` FALSE EQUALS JUST FALSE
#ASSERT `s 199(4) the company has complied with the subsection` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 199(4) the company has complied with the subsection` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 199(4) the company has complied with the subsection` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 199(4) the company has complied with the subsection` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- records kept in Singapore: the subsection has no verdict
#ASSERT `s 199(4) the company has complied with the subsection` FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `s 199(5): the Court's order`

#ASSERT `s 199(5) the Court may order the records to be open to inspection by the public accountant` TRUE TRUE EQUALS JUST TRUE
-- "but only upon an undertaking in writing"
#ASSERT `s 199(5) the Court may order the records to be open to inspection by the public accountant` TRUE FALSE EQUALS JUST FALSE
-- a public accountant not acting for a director: not covered
#ASSERT `s 199(5) the Court may order the records to be open to inspection by the public accountant` FALSE TRUE EQUALS NOTHING
#ASSERT `s 199(5) the Court may order the records to be open to inspection by the public accountant` FALSE FALSE EQUALS NOTHING

§ `s 199(6): the offence of default`

#ASSERT `s 199(6) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 199(6) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST TRUE
-- default made, but the person is an officer who is not in default
#ASSERT `s 199(6) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST FALSE
-- no default
#ASSERT `s 199(6) the person is guilty of the offence this subsection creates` FALSE TRUE TRUE EQUALS JUST FALSE
-- $10,000 or 12 months (not both), and a default penalty
#ASSERT `s 199(6) the most the person may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (`s 199(6) penalty` OF 10000, 12, FALSE, TRUE)
#ASSERT `s 199(6) the most the person may be sentenced to on conviction` TRUE FALSE TRUE EQUALS JUST (`s 199(6) penalty` OF 10000, 12, FALSE, TRUE)
#ASSERT `s 199(6) the most the person may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 199(6) the most the person may be sentenced to on conviction` FALSE TRUE TRUE EQUALS NOTHING
