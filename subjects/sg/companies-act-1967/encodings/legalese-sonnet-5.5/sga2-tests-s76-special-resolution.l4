IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sga2-nouns`
IMPORT `sga2-s76-special-resolution`

-- Tests for sga2-s76-special-resolution.l4: s 76(10) to (15) of the Companies Act 1967 (Singapore).
-- Expected values are written from the text (inputs/CoA1967.txt lines 7816-8090), beside each assertion, before the code was run.
-- Calendar facts used: 5 October 2026 is a Monday; 5 October plus 21 days is 26 October; 12 October plus 21 days is 2 November.
-- A period "within N days after X" opens the day after X (the keel's convention P2), so the same day is outside it.
-- NOTHING for a route means: a paragraph is not met, so the subsection says nothing and s 76(1) decides.


§ `s 76(10)(a): the special resolution`

#ASSERT `s 76(10)(a) the company has resolved by special resolution to give the assistance` TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(a) the company has resolved by special resolution to give the assistance` FALSE EQUALS JUST FALSE

§ `s 76(10)(b): where the company is a subsidiary of a listed corporation or of a Singapore ultimate holding company`

-- Arguments: board control; more than half the votes; subsidiary of a subsidiary; admitted to the official list; removed from it; the other is a subsidiary of the first; the first is itself a subsidiary; the ultimate holding company is incorporated in Singapore.
-- Limb (i): the company is a subsidiary of a listed corporation (board control, and the parent is listed).
#ASSERT `s 76(10)(b) paragraph (b) applies to the company` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- more than half of the voting power, or a subsidiary of a subsidiary, also make it a subsidiary under s 5(1).
#ASSERT `s 76(10)(b) paragraph (b) applies to the company` FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(10)(b) paragraph (b) applies to the company` FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- A parent never admitted to the official list is not listed; nor one removed from it.
#ASSERT `s 76(10)(b) paragraph (b) applies to the company` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 76(10)(b) paragraph (b) applies to the company` TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- Not a subsidiary under s 5(1) at all: limb (i) fails.
#ASSERT `s 76(10)(b) paragraph (b) applies to the company` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- Limb (ii): an unlisted parent that is the ultimate holding company (s 5A), incorporated in Singapore.
#ASSERT `s 76(10)(b) paragraph (b) applies to the company` FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(b) paragraph (b) applies to the company` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- A corporation that is itself a subsidiary is not an ultimate holding company (s 5A(b)).
#ASSERT `s 76(10)(b) paragraph (b) applies to the company` FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- Neither limb.
#ASSERT `s 76(10)(b) paragraph (b) applies to the company` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- (b) as a requirement: the listed corporation or ultimate holding company must have approved by special resolution. Where (b) does not apply, nothing is asked of it.
#ASSERT `s 76(10)(b) the listed corporation or ultimate holding company has approved the giving by special resolution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(b) the listed corporation or ultimate holding company has approved the giving by special resolution` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 76(10)(b) the listed corporation or ultimate holding company has approved the giving by special resolution` FALSE TRUE EQUALS NOTHING
#ASSERT `s 76(10)(b) the listed corporation or ultimate holding company has approved the giving by special resolution` FALSE FALSE EQUALS NOTHING

§ `s 76(10)(c): the notice and the directors' statement`

-- Arguments: particulars and reasons; effect on the financial position; accompanied by the statement; names of directors who voted against; number of directors who signed; states whether prejudice is likely.
#ASSERT `s 76(10)(c) the notice and the statement are as the paragraph requires` TRUE TRUE TRUE TRUE 2 TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(c) the notice and the statement are as the paragraph requires` TRUE TRUE TRUE TRUE 3 TRUE EQUALS JUST TRUE
-- "made by not less than 2 directors": one signature is not enough.
#ASSERT `s 76(10)(c) the notice and the statement are as the paragraph requires` TRUE TRUE TRUE TRUE 1 TRUE EQUALS JUST FALSE
#ASSERT `s 76(10)(c) the notice and the statement are as the paragraph requires` TRUE TRUE TRUE TRUE 0 TRUE EQUALS JUST FALSE
#ASSERT `s 76(10)(c) the notice and the statement are as the paragraph requires` FALSE TRUE TRUE TRUE 2 TRUE EQUALS JUST FALSE
#ASSERT `s 76(10)(c) the notice and the statement are as the paragraph requires` TRUE FALSE TRUE TRUE 2 TRUE EQUALS JUST FALSE
#ASSERT `s 76(10)(c) the notice and the statement are as the paragraph requires` TRUE TRUE FALSE TRUE 2 TRUE EQUALS JUST FALSE
#ASSERT `s 76(10)(c) the notice and the statement are as the paragraph requires` TRUE TRUE TRUE FALSE 2 TRUE EQUALS JUST FALSE
#ASSERT `s 76(10)(c) the notice and the statement are as the paragraph requires` TRUE TRUE TRUE TRUE 2 FALSE EQUALS JUST FALSE

§ `s 76(10)(d): the notice to the parent`

#ASSERT `s 76(10)(d) the notice to the parent is accompanied by the notice and statement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(d) the notice to the parent is accompanied by the notice and statement` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 76(10)(d) the notice to the parent is accompanied by the notice and statement` FALSE TRUE EQUALS NOTHING
#ASSERT `s 76(10)(d) the notice to the parent is accompanied by the notice and statement` FALSE FALSE EQUALS NOTHING

§ `s 76(10)(e): the copies lodged by the day next following the despatch`

-- Arguments: day the notice was despatched; day the copies were lodged; a copy of the notice lodged; a copy of the statement lodged.
-- Despatched Monday 5 October 2026: the day next following is Tuesday 6 October.
#ASSERT `s 76(10)(e) the copies have been lodged with the Registrar in time` (Date 5 10 2026) (Date 6 10 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(e) the copies have been lodged with the Registrar in time` (Date 5 10 2026) (Date 7 10 2026) TRUE TRUE EQUALS JUST FALSE
-- "not later than the day next following": the same day is not later (fork F-A8).
#ASSERT `s 76(10)(e) the copies have been lodged with the Registrar in time` (Date 5 10 2026) (Date 5 10 2026) TRUE TRUE EQUALS JUST TRUE
-- Both copies must be lodged.
#ASSERT `s 76(10)(e) the copies have been lodged with the Registrar in time` (Date 5 10 2026) (Date 6 10 2026) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 76(10)(e) the copies have been lodged with the Registrar in time` (Date 5 10 2026) (Date 6 10 2026) TRUE FALSE EQUALS JUST FALSE
-- Despatched on the last day of a month: 30 September's next day is 1 October.
#ASSERT `s 76(10)(e) the copies have been lodged with the Registrar in time` (Date 30 9 2026) (Date 1 10 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(e) the copies have been lodged with the Registrar in time` (Date 30 9 2026) (Date 2 10 2026) TRUE TRUE EQUALS JUST FALSE

§ `s 76(10)(f): the notice and statement sent to the members and debenture holders`

-- Arguments: sent to all members; sent to all trustees for debenture holders; there are debenture holders with no trustee; sent to those whose names were known.
#ASSERT `s 76(10)(f) the notice and the statement have been sent to the members and debenture holders` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(10)(f) the notice and the statement have been sent to the members and debenture holders` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(f) the notice and the statement have been sent to the members and debenture holders` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 76(10)(f) the notice and the statement have been sent to the members and debenture holders` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 76(10)(f) the notice and the statement have been sent to the members and debenture holders` TRUE FALSE FALSE FALSE EQUALS JUST FALSE

§ `s 76(10)(g): the notice and documents sent in the parent`

-- Arguments: (b) applies; sent to all members; sent to all trustees; there are debenture holders with no trustee; sent to those whose names were known.
#ASSERT `s 76(10)(g) the notice and the documents have been sent to the members and debenture holders of the parent` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(10)(g) the notice and the documents have been sent to the members and debenture holders of the parent` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(g) the notice and the documents have been sent to the members and debenture holders of the parent` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 76(10)(g) the notice and the documents have been sent to the members and debenture holders of the parent` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 76(10)(g) the notice and the documents have been sent to the members and debenture holders of the parent` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- Where (b) does not apply there is no listed corporation or ultimate holding company to send to.
#ASSERT `s 76(10)(g) the notice and the documents have been sent to the members and debenture holders of the parent` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 76(10)(g) the notice and the documents have been sent to the members and debenture holders of the parent` FALSE TRUE TRUE FALSE FALSE EQUALS NOTHING

§ `s 76(10)(h): the notice published within 21 days after the resolution`

-- Arguments: day the company passed the resolution; (b) applies; day the parent passed its resolution; day the notice was published; sets out the terms; states the right to apply; published in a daily newspaper.
-- Resolution passed Monday 5 October 2026: the 21st day after is Monday 26 October.
#ASSERT `s 76(10)(h) the notice has been published in time` (Date 5 10 2026) FALSE (Date 1 1 2026) (Date 26 10 2026) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(h) the notice has been published in time` (Date 5 10 2026) FALSE (Date 1 1 2026) (Date 27 10 2026) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76(10)(h) the notice has been published in time` (Date 5 10 2026) FALSE (Date 1 1 2026) (Date 6 10 2026) TRUE TRUE TRUE EQUALS JUST TRUE
-- The same day as the resolution is not "after" it (P2).
#ASSERT `s 76(10)(h) the notice has been published in time` (Date 5 10 2026) FALSE (Date 1 1 2026) (Date 5 10 2026) TRUE TRUE TRUE EQUALS JUST FALSE
-- Where (b) applies the period runs from the later of the two resolutions: the parent passed its resolution on 12 October, so the last day is 2 November.
#ASSERT `s 76(10)(h) the notice has been published in time` (Date 5 10 2026) TRUE (Date 12 10 2026) (Date 2 11 2026) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(h) the notice has been published in time` (Date 5 10 2026) TRUE (Date 12 10 2026) (Date 3 11 2026) TRUE TRUE TRUE EQUALS JUST FALSE
-- A parent resolution earlier than the company's does not move the start: still 26 October.
#ASSERT `s 76(10)(h) the notice has been published in time` (Date 5 10 2026) TRUE (Date 1 10 2026) (Date 26 10 2026) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(h) the notice has been published in time` (Date 5 10 2026) TRUE (Date 1 10 2026) (Date 27 10 2026) TRUE TRUE TRUE EQUALS JUST FALSE
-- Where (b) does not apply a later parent date is ignored.
#ASSERT `s 76(10)(h) the notice has been published in time` (Date 5 10 2026) FALSE (Date 12 10 2026) (Date 27 10 2026) TRUE TRUE TRUE EQUALS JUST FALSE
-- The notice must set out the terms, state the right to apply, and be published in a daily newspaper circulating generally in Singapore.
#ASSERT `s 76(10)(h) the notice has been published in time` (Date 5 10 2026) FALSE (Date 1 1 2026) (Date 6 10 2026) FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76(10)(h) the notice has been published in time` (Date 5 10 2026) FALSE (Date 1 1 2026) (Date 6 10 2026) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 76(10)(h) the notice has been published in time` (Date 5 10 2026) FALSE (Date 1 1 2026) (Date 6 10 2026) TRUE TRUE FALSE EQUALS JUST FALSE

§ `s 76(10)(i): no application in the way`

-- Arguments: an application was made within the period; each has been withdrawn; the Court has approved the giving.
#ASSERT `s 76(10)(i) no application stands in the way of the giving of the assistance` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(10)(i) no application stands in the way of the giving of the assistance` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76(10)(i) no application stands in the way of the giving of the assistance` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 76(10)(i) no application stands in the way of the giving of the assistance` TRUE FALSE FALSE EQUALS JUST FALSE

§ `s 76(10)(j): given in accordance with the resolution and not earlier than the end of the waiting period`

-- Arguments: in accordance with the terms; day the assistance is given; day the notice was published; an application was made; each has been withdrawn; day of the withdrawal; day of the Court's decision.
-- Published Monday 5 October 2026: the period in (12) ends on 26 October; "not earlier than the expiration" means from 27 October (fork F-A12).
#ASSERT `s 76(10)(j) the assistance is given in accordance with the resolution and not too early` TRUE (Date 27 10 2026) (Date 5 10 2026) FALSE FALSE (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST TRUE
#ASSERT `s 76(10)(j) the assistance is given in accordance with the resolution and not too early` TRUE (Date 26 10 2026) (Date 5 10 2026) FALSE FALSE (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST FALSE
#ASSERT `s 76(10)(j) the assistance is given in accordance with the resolution and not too early` TRUE (Date 6 10 2026) (Date 5 10 2026) FALSE FALSE (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST FALSE
-- Not in accordance with the terms of the resolution.
#ASSERT `s 76(10)(j) the assistance is given in accordance with the resolution and not too early` FALSE (Date 27 10 2026) (Date 5 10 2026) FALSE FALSE (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST FALSE
-- (ii)(A): an application was made and all were withdrawn: not earlier than the withdrawal of the last one (10 October).
#ASSERT `s 76(10)(j) the assistance is given in accordance with the resolution and not too early` TRUE (Date 10 10 2026) (Date 5 10 2026) TRUE TRUE (Date 10 10 2026) (Date 1 1 2026) EQUALS JUST TRUE
#ASSERT `s 76(10)(j) the assistance is given in accordance with the resolution and not too early` TRUE (Date 9 10 2026) (Date 5 10 2026) TRUE TRUE (Date 10 10 2026) (Date 1 1 2026) EQUALS JUST FALSE
-- (ii)(B): an application was made and not all withdrawn: not earlier than the Court's decision (20 October).
#ASSERT `s 76(10)(j) the assistance is given in accordance with the resolution and not too early` TRUE (Date 20 10 2026) (Date 5 10 2026) TRUE FALSE (Date 1 1 2026) (Date 20 10 2026) EQUALS JUST TRUE
#ASSERT `s 76(10)(j) the assistance is given in accordance with the resolution and not too early` TRUE (Date 19 10 2026) (Date 5 10 2026) TRUE FALSE (Date 1 1 2026) (Date 20 10 2026) EQUALS JUST FALSE

§ `s 76(10) as a whole`

-- Arguments: the answers for paragraphs (a) to (j) in order. NOTHING for (b), (d) or (g) is read as "nothing asked" (fork F-A13).
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST TRUE) NOTHING (JUST TRUE) NOTHING (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
-- A paragraph that failed: NOTHING (the subsection says nothing for the assistance).
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS NOTHING
-- Paragraphs (a), (c), (e), (f), (h), (i), (j) apply in every case, so NOTHING there is not "nothing asked".
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 76(10) subsection (1) does not prohibit the giving of the assistance` (JUST TRUE) (JUST TRUE) NOTHING (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS NOTHING

§ `s 76(10A): resolutions passed by written means`

-- Arguments: proposed to be passed by written means under s 184A; the day the notice and statement or documents were sent; the day agreement is sought (s 184C) or the documents are served (s 183(3A)).
#ASSERT `s 76(10A) paragraph (f) or (g) has been complied with in time for a resolution by written means` TRUE (Date 4 10 2026) (Date 5 10 2026) EQUALS JUST TRUE
-- "at or before the time": the same day is in time (fork F-A15, a time compared as a day).
#ASSERT `s 76(10A) paragraph (f) or (g) has been complied with in time for a resolution by written means` TRUE (Date 5 10 2026) (Date 5 10 2026) EQUALS JUST TRUE
#ASSERT `s 76(10A) paragraph (f) or (g) has been complied with in time for a resolution by written means` TRUE (Date 6 10 2026) (Date 5 10 2026) EQUALS JUST FALSE
-- Not proposed to be passed by written means: the subsection says nothing.
#ASSERT `s 76(10A) paragraph (f) or (g) has been complied with in time for a resolution by written means` FALSE (Date 6 10 2026) (Date 5 10 2026) EQUALS NOTHING

§ `s 76(11): the Court's declaration`

#ASSERT `s 76(11) the Court may declare that the provisions of subsection (10) have been complied with` TRUE TRUE EQUALS JUST TRUE
-- Group G1: a "may" gated by "where, on application" answers the text's no when the gate fails (periods ruling of 2026-11-05, item (b)).
#ASSERT `s 76(11) the Court may declare that the provisions of subsection (10) have been complied with` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 76(11) the Court may declare that the provisions of subsection (10) have been complied with` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 76(11) the Court may declare that the provisions of subsection (10) have been complied with` FALSE FALSE EQUALS JUST FALSE

§ `s 76(12): who may apply to the Court`

-- Arguments: the special resolution has been passed; the day the notice was published; the day the application is made; the applicant; (b) applies.
-- Published Monday 5 October 2026: 26 October is the 21st day after.
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 26 10 2026) `s 76(12)(a) a member of the company` FALSE EQUALS JUST TRUE
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 6 10 2026) `s 76(12)(b) a trustee for debenture holders of the company` FALSE EQUALS JUST TRUE
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 6 10 2026) `s 76(12)(c) a debenture holder of the company` FALSE EQUALS JUST TRUE
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 6 10 2026) `s 76(12)(d) a creditor of the company` FALSE EQUALS JUST TRUE
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 6 10 2026) `s 76(12)(f) the Registrar` FALSE EQUALS JUST TRUE
-- Outside the 21 days (periods ruling of 2026-11-05, item (a)).
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 27 10 2026) `s 76(12)(a) a member of the company` FALSE EQUALS JUST FALSE
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 5 10 2026) `s 76(12)(a) a member of the company` FALSE EQUALS JUST FALSE
-- No special resolution passed: nothing to oppose (group G1).
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` FALSE (Date 5 10 2026) (Date 6 10 2026) `s 76(12)(a) a member of the company` FALSE EQUALS JUST FALSE
-- (e): persons in the parent, only if (10)(b) applies.
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 6 10 2026) `s 76(12)(e)(i) a member of the listed corporation or ultimate holding company that passed a special resolution mentioned in subsection (10)(b)` TRUE EQUALS JUST TRUE
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 6 10 2026) `s 76(12)(e)(ii) a trustee for debenture holders of that listed corporation or ultimate holding company` TRUE EQUALS JUST TRUE
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 6 10 2026) `s 76(12)(e)(iii) a debenture holder of that listed corporation or ultimate holding company` TRUE EQUALS JUST TRUE
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 6 10 2026) `s 76(12)(e)(iv) a creditor of that listed corporation or ultimate holding company` TRUE EQUALS JUST TRUE
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 6 10 2026) `s 76(12)(e)(i) a member of the listed corporation or ultimate holding company that passed a special resolution mentioned in subsection (10)(b)` FALSE EQUALS NOTHING
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 6 10 2026) `s 76(12)(e)(iv) a creditor of that listed corporation or ultimate holding company` FALSE EQUALS NOTHING
-- The list in (12) is not closed with "only": some other person is not named, and the text says nothing of one.
#ASSERT `s 76(12) the person may apply to the Court opposing the giving of the assistance` TRUE (Date 5 10 2026) (Date 6 10 2026) `s 76(12) some other person` FALSE EQUALS NOTHING

§ `s 76(13): what the Court must and may do`

#ASSERT `s 76(13)(a) the Court must have regard to the rights and interests of the members and of the creditors` TRUE EQUALS JUST TRUE
#ASSERT `s 76(13)(a) the Court must have regard to the rights and interests of the members and of the creditors` FALSE EQUALS JUST FALSE
-- (b): "must not make an order approving ... unless the Court is satisfied that (i) ... and (ii) ...": the bar is lifted only when both are satisfied.
#ASSERT `s 76(13)(b) the Court is barred from making an order approving the giving of the assistance` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76(13)(b) the Court is barred from making an order approving the giving of the assistance` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 76(13)(b) the Court is barred from making an order approving the giving of the assistance` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76(13)(b) the Court is barred from making an order approving the giving of the assistance` FALSE FALSE EQUALS JUST TRUE
-- The orders the Court may make. Arguments: an application was made; the order; satisfied of disclosure; satisfied of no material prejudice.
#ASSERT `s 76(13) the Court may make the order` TRUE `s 76(13)(b)(iii) an order for the purchase by the company of the interests of dissentient members and the reduction accordingly of the capital of the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(13) the Court may make the order` TRUE `s 76(13)(b)(iv) an adjournment of the proceedings so that an arrangement may be made for the purchase, otherwise than by the company or a subsidiary of it, of the interests of dissentient members` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(13) the Court may make the order` TRUE `s 76(13)(b)(v) ancillary or consequential directions or orders` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76(13) the Court may make the order` TRUE `s 76(13)(b)(vi) an order disapproving the giving of the financial assistance` FALSE FALSE EQUALS JUST TRUE
-- "subject to paragraph (b), an order approving": only when the Court is satisfied of both.
#ASSERT `s 76(13) the Court may make the order` TRUE `s 76(13)(b)(vi) an order approving the giving of the financial assistance` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76(13) the Court may make the order` TRUE `s 76(13)(b)(vi) an order approving the giving of the financial assistance` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 76(13) the Court may make the order` TRUE `s 76(13)(b)(vi) an order approving the giving of the financial assistance` TRUE FALSE EQUALS JUST FALSE
-- Not a listed order: the list is not closed with "only".
#ASSERT `s 76(13) the Court may make the order` TRUE `s 76(13) some other order` TRUE TRUE EQUALS NOTHING
-- No application under (12): the paragraph is not engaged (group G1).
#ASSERT `s 76(13) the Court may make the order` FALSE `s 76(13)(b)(vi) an order disapproving the giving of the financial assistance` TRUE TRUE EQUALS JUST FALSE

§ `s 76(14): lodging the Court's order`

-- Arguments: the day the order was made; the day the copy was lodged; a copy was lodged. Order made Monday 5 October 2026: the 14th day after is Monday 19 October.
#ASSERT `s 76(14) the company has lodged a copy of the order with the Registrar in time` (Date 5 10 2026) (Date 19 10 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 76(14) the company has lodged a copy of the order with the Registrar in time` (Date 5 10 2026) (Date 20 10 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 76(14) the company has lodged a copy of the order with the Registrar in time` (Date 5 10 2026) (Date 6 10 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 76(14) the company has lodged a copy of the order with the Registrar in time` (Date 5 10 2026) (Date 6 10 2026) FALSE EQUALS JUST FALSE

