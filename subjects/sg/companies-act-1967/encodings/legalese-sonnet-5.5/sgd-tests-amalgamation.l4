IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sg-definitions`
IMPORT `sgd-compromise`
IMPORT `sgd-amalgamation`

-- Tests for sgd-amalgamation.l4: Companies Act 1967, ss 215A to 215H and 215K.
-- Every expected value is written from the text (the comment beside it quotes or counts the words), never from the module's output.
-- A line "-- EXPECT <word>" above a #TRACE says what the trace must print: FULFILLED, BREACH, or RESIDUAL (an obligation still open).

§ `Section 215A: amalgamation`

#ASSERT `s 215A the amalgamated company is one of the amalgamating companies or a new company` `s 215A one of the amalgamating companies`
#ASSERT `s 215A the amalgamated company is one of the amalgamating companies or a new company` `s 215A a new company`
#ASSERT NOT (`s 215A the amalgamated company is one of the amalgamating companies or a new company` `s 215A some other company`)
-- arguments: the number of companies, the amalgamated company, in accordance with ss 215B to 215G
#ASSERT `s 215A the companies may amalgamate and continue as one company` 2 `s 215A one of the amalgamating companies` TRUE EQUALS JUST TRUE
#ASSERT `s 215A the companies may amalgamate and continue as one company` 3 `s 215A a new company` TRUE EQUALS JUST TRUE
#ASSERT `s 215A the companies may amalgamate and continue as one company` 1 `s 215A a new company` TRUE EQUALS NOTHING
#ASSERT `s 215A the companies may amalgamate and continue as one company` 2 `s 215A some other company` TRUE EQUALS NOTHING
#ASSERT `s 215A the companies may amalgamate and continue as one company` 2 `s 215A one of the amalgamating companies` FALSE EQUALS NOTHING

§ `Section 215B: the amalgamation proposal`

-- (1): fields in order: (a) name, (b) registered office, (c) directors' full names, (ca) addresses, (d)(i) number of shares, (d)(ii) rights, (d)(iii) transferability, (e) constitution, (f) conversion,
-- (g) shares not to be converted, (g) their consideration stated, (h) another payment is to be made, (h) it is stated, (i) arrangements.
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
-- item (a) is missing
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
-- item (b) is missing
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
-- item (c) is missing
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
-- item (ca) is missing
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
-- item (d(i)) is missing
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
-- item (d(ii)) is missing
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
-- item (d(iii)) is missing
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
-- item (e) is missing
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
-- item (f) is missing
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
-- the proposal converts every share: no consideration to state
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST TRUE
-- shares are not to be converted and the consideration is not stated
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
-- no other payment to a member or director: nothing to state
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS JUST TRUE
-- a payment is to be made and is not stated
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
-- item (i) is missing
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS JUST FALSE
-- neither conditional case arises: nothing more to state
#ASSERT `s 215B(1) the amalgamation proposal contains what the subsection requires` (`s 215B(1) what the proposal contains` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, TRUE) EQUALS JUST TRUE

-- (2): the document is an amalgamation proposal; the date specified is the date the amalgamation is intended to become effective
#ASSERT `s 215B(2) the amalgamation proposal may specify the date` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215B(2) the amalgamation proposal may specify the date` FALSE TRUE EQUALS NOTHING
#ASSERT `s 215B(2) the amalgamation proposal may specify the date` TRUE FALSE EQUALS NOTHING
-- (3): shares of one are held by another; the proposal cancels them without payment; the proposal converts them
#ASSERT `s 215B(3) the amalgamation proposal provides as the subsection requires` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 215B(3) the amalgamation proposal provides as the subsection requires` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 215B(3) the amalgamation proposal provides as the subsection requires` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 215B(3) the amalgamation proposal provides as the subsection requires` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215B(3) the amalgamation proposal provides as the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
-- (4)
#ASSERT `s 215B(4) the cancellation of the shares is deemed to be a reduction of share capital within the meaning of the Act` TRUE EQUALS JUST FALSE
#ASSERT `s 215B(4) the cancellation of the shares is deemed to be a reduction of share capital within the meaning of the Act` FALSE EQUALS NOTHING
-- (5): the name; the new name has been reserved under section 27(12B)
#ASSERT `s 215B(5) the name may be the name of the amalgamated company` `s 215B(5)(a) the name of one of the amalgamating companies` FALSE EQUALS JUST TRUE
#ASSERT `s 215B(5) the name may be the name of the amalgamated company` `s 215B(5)(b) a new name` TRUE EQUALS JUST TRUE
#ASSERT `s 215B(5) the name may be the name of the amalgamated company` `s 215B(5)(b) a new name` FALSE EQUALS NOTHING
#ASSERT `s 215B(5) the name may be the name of the amalgamated company` `s 215B(5) some other name` TRUE EQUALS NOTHING

§ `Section 215C: the manner of approving the proposal`

#ASSERT `s 215C(1)(a) the resolution is a special resolution` `a special resolution`
#ASSERT NOT (`s 215C(1)(a) the resolution is a special resolution` `an ordinary resolution`)
#ASSERT NOT (`s 215C(1)(a) the resolution is a special resolution` `a resolution of the directors`)
#ASSERT `s 215C(1)(a) the meeting is a general meeting` `an annual general meeting`
#ASSERT `s 215C(1)(a) the meeting is a general meeting` `an extraordinary general meeting`
#ASSERT NOT (`s 215C(1)(a) the meeting is a general meeting` `a meeting of creditors`)
-- (1): arguments: the kind of resolution, the kind of meeting, the constitution is complied with, another person's approval is required, that person approved
#ASSERT `s 215C(1) the amalgamation proposal has been approved as the subsection requires` `a special resolution` `an extraordinary general meeting` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 215C(1) the amalgamation proposal has been approved as the subsection requires` `a special resolution` `an annual general meeting` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215C(1) the amalgamation proposal has been approved as the subsection requires` `a special resolution` `an extraordinary general meeting` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 215C(1) the amalgamation proposal has been approved as the subsection requires` `an ordinary resolution` `an extraordinary general meeting` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 215C(1) the amalgamation proposal has been approved as the subsection requires` `a special resolution` `a meeting of creditors` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 215C(1) the amalgamation proposal has been approved as the subsection requires` `a special resolution` `an extraordinary general meeting` FALSE FALSE FALSE EQUALS JUST FALSE
-- (2): the general meeting is on 15 June 2026. An act on 14 June is before it; on 16 June after it; on 15 June it cannot be placed from a date.
#ASSERT `s 215C(2) the day is before the day of the general meeting` (Date 14 6 2026) (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 215C(2) the day is before the day of the general meeting` (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE
#ASSERT `s 215C(2) the day is before the day of the general meeting` (Date 15 6 2026) (Date 15 6 2026) EQUALS NOTHING
#ASSERT `s 215C(2)(a) the board resolved before the general meeting that the amalgamation is in the best interest of the amalgamating company` TRUE (Date 14 6 2026) (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 215C(2)(a) the board resolved before the general meeting that the amalgamation is in the best interest of the amalgamating company` TRUE (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE
#ASSERT `s 215C(2)(a) the board resolved before the general meeting that the amalgamation is in the best interest of the amalgamating company` TRUE (Date 15 6 2026) (Date 15 6 2026) EQUALS NOTHING
#ASSERT `s 215C(2)(a) the board resolved before the general meeting that the amalgamation is in the best interest of the amalgamating company` FALSE (Date 14 6 2026) (Date 15 6 2026) EQUALS JUST FALSE
#ASSERT `s 215C(2)(b) the board made the solvency statement in relation to the amalgamating company before the general meeting` TRUE (Date 1 6 2026) (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 215C(2)(b) the board made the solvency statement in relation to the amalgamating company before the general meeting` FALSE (Date 1 6 2026) (Date 15 6 2026) EQUALS JUST FALSE
#ASSERT `s 215C(2)(b) the board made the solvency statement in relation to the amalgamating company before the general meeting` TRUE (Date 20 6 2026) (Date 15 6 2026) EQUALS JUST FALSE
#ASSERT `s 215C(2)(c) the board made the solvency statement in relation to the amalgamated company before the general meeting` TRUE (Date 1 6 2026) (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 215C(2)(c) the board made the solvency statement in relation to the amalgamated company before the general meeting` FALSE (Date 1 6 2026) (Date 15 6 2026) EQUALS JUST FALSE
#ASSERT `s 215C(2)(c) the board made the solvency statement in relation to the amalgamated company before the general meeting` TRUE (Date 15 6 2026) (Date 15 6 2026) EQUALS NOTHING
-- the last day certain to be before the meeting: 14 June 2026, 13 days after 1 June
#ASSERT `s 215C(2) the number of days from the start day to the day before the general meeting` (Date 15 6 2026) (Date 1 6 2026) EQUALS 13
-- (3): the director votes in favour; the declaration states the opinion; it states the grounds
#ASSERT `s 215C(3) the director must sign the declaration` TRUE EQUALS JUST TRUE
#ASSERT `s 215C(3) the director must sign the declaration` FALSE EQUALS JUST FALSE
#ASSERT `s 215C(3) the declaration states what the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215C(3) the declaration states what the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 215C(3) the declaration states what the subsection requires` FALSE TRUE EQUALS JUST FALSE
-- (4): the meeting is on 15 June 2026: 21 days before is 25 May 2026 (P5). Arguments: the meeting, the day sent, then the four items (a) to (d).
#ASSERT `s 215C(4) the board sent what the subsection requires to every member at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215C(4) the board sent what the subsection requires to every member at least 21 days before the general meeting` (Date 15 6 2026) (Date 26 5 2026) TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215C(4) the board sent what the subsection requires to every member at least 21 days before the general meeting` (Date 15 6 2026) (Date 1 5 2026) TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215C(4) the board sent what the subsection requires to every member at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215C(4) the board sent what the subsection requires to every member at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215C(4) the board sent what the subsection requires to every member at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 215C(4) the board sent what the subsection requires to every member at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- a meeting on 3 March 2026: 21 days before is 10 February 2026 (across a month end)
#ASSERT `s 215C(4) the board sent what the subsection requires to every member at least 21 days before the general meeting` (Date 3 3 2026) (Date 10 2 2026) TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215C(4) the board sent what the subsection requires to every member at least 21 days before the general meeting` (Date 3 3 2026) (Date 11 2 2026) TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215C(4) the number of days from the start day to the last day for the sending` (Date 15 6 2026) (Date 1 5 2026) EQUALS 24
-- (5)(a): the meeting, the day sent, sent to every secured creditor
#ASSERT `s 215C(5)(a) the directors sent the amalgamation proposal to every secured creditor at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 215C(5)(a) the directors sent the amalgamation proposal to every secured creditor at least 21 days before the general meeting` (Date 15 6 2026) (Date 26 5 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 215C(5)(a) the directors sent the amalgamation proposal to every secured creditor at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) FALSE EQUALS JUST FALSE
-- (5)(b): the meeting, the day published, a daily English newspaper, the inspection statement, the free-copy statement
#ASSERT `s 215C(5)(b) the directors caused the notice to be published as the paragraph requires at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215C(5)(b) the directors caused the notice to be published as the paragraph requires at least 21 days before the general meeting` (Date 15 6 2026) (Date 26 5 2026) TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215C(5)(b) the directors caused the notice to be published as the paragraph requires at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215C(5)(b) the directors caused the notice to be published as the paragraph requires at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 215C(5)(b) the directors caused the notice to be published as the paragraph requires at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) TRUE TRUE FALSE EQUALS JUST FALSE
-- (6)
#ASSERT `s 215C(6) the director is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 215C(6) the director is guilty of the offence` FALSE EQUALS JUST FALSE

§ `Section 215D: short form amalgamation`

#ASSERT `s 215D(1)(a) the terms of paragraph (a) are in the resolution` `s 215D(1)(a)(i) the amalgamated holding company` TRUE FALSE FALSE
#ASSERT NOT (`s 215D(1)(a) the terms of paragraph (a) are in the resolution` `s 215D(1)(a)(i) the amalgamated holding company` FALSE TRUE TRUE)
#ASSERT `s 215D(1)(a) the terms of paragraph (a) are in the resolution` `s 215D(1)(a)(ii) the amalgamated subsidiary company` FALSE TRUE TRUE
#ASSERT NOT (`s 215D(1)(a) the terms of paragraph (a) are in the resolution` `s 215D(1)(a)(ii) the amalgamated subsidiary company` FALSE TRUE FALSE)
#ASSERT NOT (`s 215D(1)(a) the terms of paragraph (a) are in the resolution` `s 215D(1)(a)(ii) the amalgamated subsidiary company` TRUE FALSE TRUE)
-- (1): arguments: holding company and its wholly-owned subsidiaries; resolved by special resolution at a general meeting; which company continues; (a)(i); (a)(ii) issue; (a)(ii) cancellation; (b); (c); (d)
#ASSERT `s 215D(1) the amalgamating holding company and its wholly-owned subsidiaries may amalgamate without complying with sections 215B and 215C` TRUE TRUE `s 215D(1)(a)(i) the amalgamated holding company` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215D(1) the amalgamating holding company and its wholly-owned subsidiaries may amalgamate without complying with sections 215B and 215C` TRUE TRUE `s 215D(1)(a)(ii) the amalgamated subsidiary company` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215D(1) the amalgamating holding company and its wholly-owned subsidiaries may amalgamate without complying with sections 215B and 215C` FALSE TRUE `s 215D(1)(a)(i) the amalgamated holding company` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 215D(1) the amalgamating holding company and its wholly-owned subsidiaries may amalgamate without complying with sections 215B and 215C` TRUE FALSE `s 215D(1)(a)(i) the amalgamated holding company` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 215D(1) the amalgamating holding company and its wholly-owned subsidiaries may amalgamate without complying with sections 215B and 215C` TRUE TRUE `s 215D(1)(a)(i) the amalgamated holding company` FALSE FALSE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 215D(1) the amalgamating holding company and its wholly-owned subsidiaries may amalgamate without complying with sections 215B and 215C` TRUE TRUE `s 215D(1)(a)(ii) the amalgamated subsidiary company` FALSE TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 215D(1) the amalgamating holding company and its wholly-owned subsidiaries may amalgamate without complying with sections 215B and 215C` TRUE TRUE `s 215D(1)(a)(i) the amalgamated holding company` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 215D(1) the amalgamating holding company and its wholly-owned subsidiaries may amalgamate without complying with sections 215B and 215C` TRUE TRUE `s 215D(1)(a)(i) the amalgamated holding company` TRUE FALSE FALSE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 215D(1) the amalgamating holding company and its wholly-owned subsidiaries may amalgamate without complying with sections 215B and 215C` TRUE TRUE `s 215D(1)(a)(i) the amalgamated holding company` TRUE FALSE FALSE TRUE TRUE FALSE EQUALS NOTHING
-- (2): arguments: two or more wholly-owned subsidiaries of the same corporation; resolved; (a); (b); (c); (d)
#ASSERT `s 215D(2) the wholly-owned subsidiary companies of the same corporation may amalgamate without complying with sections 215B and 215C` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215D(2) the wholly-owned subsidiary companies of the same corporation may amalgamate without complying with sections 215B and 215C` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 215D(2) the wholly-owned subsidiary companies of the same corporation may amalgamate without complying with sections 215B and 215C` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 215D(2) the wholly-owned subsidiary companies of the same corporation may amalgamate without complying with sections 215B and 215C` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 215D(2) the wholly-owned subsidiary companies of the same corporation may amalgamate without complying with sections 215B and 215C` TRUE TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 215D(2) the wholly-owned subsidiary companies of the same corporation may amalgamate without complying with sections 215B and 215C` TRUE TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 215D(2) the wholly-owned subsidiary companies of the same corporation may amalgamate without complying with sections 215B and 215C` TRUE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING
-- (3): the meeting is on 15 June 2026; 21 days before is 25 May 2026
#ASSERT `s 215D(3) the directors gave the written notice to every secured creditor at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 215D(3) the directors gave the written notice to every secured creditor at least 21 days before the general meeting` (Date 15 6 2026) (Date 26 5 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 215D(3) the directors gave the written notice to every secured creditor at least 21 days before the general meeting` (Date 15 6 2026) (Date 25 5 2026) FALSE EQUALS JUST FALSE
-- (4)
#ASSERT `s 215D(4) the resolution is deemed to be an amalgamation proposal that has been approved` TRUE EQUALS JUST TRUE
#ASSERT `s 215D(4) the resolution is deemed to be an amalgamation proposal that has been approved` FALSE EQUALS NOTHING
-- (5): the statement was made; the day it was made; the day of the meeting
#ASSERT `s 215D(5) the board made the solvency statement in relation to the amalgamated company before the commencement of the general meeting` TRUE (Date 14 6 2026) (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `s 215D(5) the board made the solvency statement in relation to the amalgamated company before the commencement of the general meeting` TRUE (Date 16 6 2026) (Date 15 6 2026) EQUALS JUST FALSE
#ASSERT `s 215D(5) the board made the solvency statement in relation to the amalgamated company before the commencement of the general meeting` TRUE (Date 15 6 2026) (Date 15 6 2026) EQUALS NOTHING
#ASSERT `s 215D(5) the board made the solvency statement in relation to the amalgamated company before the commencement of the general meeting` FALSE (Date 1 6 2026) (Date 15 6 2026) EQUALS JUST FALSE
-- (6), (7), (8)
#ASSERT `s 215D(6) the director must sign the declaration` TRUE EQUALS JUST TRUE
#ASSERT `s 215D(6) the director must sign the declaration` FALSE EQUALS JUST FALSE
#ASSERT `s 215D(6) the declaration states what the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215D(6) the declaration states what the subsection requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 215D(6) the declaration states what the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 215D(7) the director is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 215D(7) the director is guilty of the offence` FALSE EQUALS JUST FALSE
#ASSERT `s 215D(8) the cancellation of the shares is deemed to be a reduction of share capital within the meaning of the Act` TRUE EQUALS JUST FALSE
#ASSERT `s 215D(8) the cancellation of the shares is deemed to be a reduction of share capital within the meaning of the Act` FALSE EQUALS NOTHING

§ `Section 215E: registration of the amalgamation`

-- (1): arguments: the approved proposal; any solvency statement; any declaration under 215C(3) or 215D(6); the directors' declaration of approval; a new company or a change of name; the name-reservation evidence; the creditors' declaration; the prescribed form; the prescribed fee
#ASSERT `s 215E(1) the documents filed with the Registrar are those the subsection requires` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215E(1) the documents filed with the Registrar are those the subsection requires` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215E(1) the documents filed with the Registrar are those the subsection requires` TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215E(1) the documents filed with the Registrar are those the subsection requires` TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215E(1) the documents filed with the Registrar are those the subsection requires` TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- a new company or a change of name: the reservation evidence is required; otherwise it is not
#ASSERT `s 215E(1) the documents filed with the Registrar are those the subsection requires` TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215E(1) the documents filed with the Registrar are those the subsection requires` TRUE TRUE TRUE TRUE FALSE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215E(1) the documents filed with the Registrar are those the subsection requires` TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 215E(1) the documents filed with the Registrar are those the subsection requires` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 215E(1) the documents filed with the Registrar are those the subsection requires` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- (2): the amalgamated company is a new company; subsection (1) has been complied with / the person is a proposed director
#ASSERT `s 215E(2)(a) section 19(1)(a) and (c) is deemed to have been complied with` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 215E(2)(a) section 19(1)(a) and (c) is deemed to have been complied with` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215E(2)(a) section 19(1)(a) and (c) is deemed to have been complied with` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 215E(2)(b) the person is within the reference in section 19(2)(b) to a person named in the constitution as a director or the secretary` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 215E(2)(b) the person is within the reference in section 19(2)(b) to a person named in the constitution as a director or the secretary` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 215E(2)(b) the person is within the reference in section 19(2)(b) to a person named in the constitution as a director or the secretary` TRUE FALSE EQUALS NOTHING

§ `Section 215F: notice of amalgamation`

#ASSERT `s 215F(1) what the Registrar must issue on receiving the documents and fees` FALSE `s 215F(1)(a) the amalgamated company is the same as one of the amalgamating companies` EQUALS NOTHING
#ASSERT `s 215F(1) what the Registrar must issue on receiving the documents and fees` TRUE `s 215F(1)(a) the amalgamated company is the same as one of the amalgamating companies` EQUALS JUST `s 215F(1)(a) a notice of amalgamation`
#ASSERT `s 215F(1) what the Registrar must issue on receiving the documents and fees` TRUE `s 215F(1)(b) the amalgamated company is a new company` EQUALS JUST `s 215F(1)(b) a notice of amalgamation together with the notice of incorporation under section 19(4)`
#ASSERT `s 215F(1) what the Registrar must issue on receiving the documents and fees` TRUE `s 215F(1) the amalgamated company is some other company` EQUALS NOTHING
-- (2): the proposal specifies a date; the date specified; the day the Registrar receives the documents and fees
