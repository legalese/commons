IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-groups`

-- Tests for sg-groups.l4 (ss 5, 5A, 5B, 6). Expected values are worked out by hand from the text of the section named
-- beside each assertion, never from the module's output.

§ `Fixtures: two groups`

-- Group 1: P controls S1 and S3; S1 controls S2; S2 controls C. So P > S1 > S2 > C (four tiers) and P > S3.
`corporation P` MEANS Corporation OF "P"
`corporation S1` MEANS Corporation OF "S1"
`corporation S2` MEANS Corporation OF "S2"
`corporation S3` MEANS Corporation OF "S3"
`corporation C` MEANS Corporation OF "C"
-- Group 2: A and B each control JV (a joint venture, each controlling its board). X stands alone.
`corporation A` MEANS Corporation OF "A"
`corporation B` MEANS Corporation OF "B"
`corporation JV` MEANS Corporation OF "JV"
`corporation X` MEANS Corporation OF "X"

`the links of both groups` MEANS
    LIST
        (`s 5(1) control link` OF `corporation P`, `corporation S1`)
        (`s 5(1) control link` OF `corporation S1`, `corporation S2`)
        (`s 5(1) control link` OF `corporation S2`, `corporation C`)
        (`s 5(1) control link` OF `corporation P`, `corporation S3`)
        (`s 5(1) control link` OF `corporation A`, `corporation JV`)
        (`s 5(1) control link` OF `corporation B`, `corporation JV`)

-- A cyclic list ends (the Act has no cycle; the bound keeps the function total). Z1 and Z2 control each other.
`the links of a cycle` MEANS
    LIST
        (`s 5(1) control link` OF (Corporation OF "Z1"), (Corporation OF "Z2"))
        (`s 5(1) control link` OF (Corporation OF "Z2"), (Corporation OF "Z1"))

§ `Section 5(1): subsidiary, directly and by a chain (s 5(1)(b))`

-- s 5(1)(a): C is directly controlled by S2, so is deemed a subsidiary of S2.
#ASSERT `s 5(1) the corporation is a subsidiary of the other corporation, by the links` `the links of both groups` `corporation C` `corporation S2` EQUALS JUST TRUE
-- s 5(1)(b): C is a subsidiary of S2, which is S1's subsidiary, so C is S1's subsidiary; and likewise P's, three tiers up.
#ASSERT `s 5(1) the corporation is a subsidiary of the other corporation, by the links` `the links of both groups` `corporation C` `corporation S1` EQUALS JUST TRUE
#ASSERT `s 5(1) the corporation is a subsidiary of the other corporation, by the links` `the links of both groups` `corporation C` `corporation P` EQUALS JUST TRUE
-- A parent is not the subsidiary of its subsidiary.
#ASSERT `s 5(1) the corporation is a subsidiary of the other corporation, by the links` `the links of both groups` `corporation P` `corporation C` EQUALS JUST FALSE
-- A sibling is not a subsidiary of its sibling: S3 and S1 are both P's subsidiaries and neither controls the other.
#ASSERT `s 5(1) the corporation is a subsidiary of the other corporation, by the links` `the links of both groups` `corporation S3` `corporation S1` EQUALS JUST FALSE
-- A corporation is not a subsidiary of itself.
#ASSERT `s 5(1) the corporation is a subsidiary of the other corporation, by the links` `the links of both groups` `corporation P` `corporation P` EQUALS JUST FALSE
-- A corporation in another group.
#ASSERT `s 5(1) the corporation is a subsidiary of the other corporation, by the links` `the links of both groups` `corporation JV` `corporation P` EQUALS JUST FALSE
-- A joint venture is the subsidiary of each of its two controlling corporations.
#ASSERT `s 5(1) the corporation is a subsidiary of the other corporation, by the links` `the links of both groups` `corporation JV` `corporation A` EQUALS JUST TRUE
#ASSERT `s 5(1) the corporation is a subsidiary of the other corporation, by the links` `the links of both groups` `corporation JV` `corporation B` EQUALS JUST TRUE
-- A cycle ends: Z2 is a subsidiary of Z1, and the function returns.
#ASSERT `s 5(1) the corporation is a subsidiary of the other corporation, by the links` `the links of a cycle` (Corporation OF "Z2") (Corporation OF "Z1") EQUALS JUST TRUE
-- No link at all: nothing is a subsidiary of anything.
#ASSERT `s 5(1) the corporation is a subsidiary of the other corporation, by the links` EMPTY `corporation C` `corporation P` EQUALS JUST FALSE

-- The three limbs as facts (s 5(1)(a)(i), (a)(ii), (b)): any one is enough; none is a failed "if".
#ASSERT `s 5(1) the corporation is deemed to be a subsidiary of the other corporation` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 5(1) the corporation is deemed to be a subsidiary of the other corporation` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 5(1) the corporation is deemed to be a subsidiary of the other corporation` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 5(1) the corporation is deemed to be a subsidiary of the other corporation` FALSE FALSE FALSE EQUALS JUST FALSE

§ `Section 5(2): control of the composition of the board`

`a director the other corporation appoints` MEANS
    (`s 5(2) director` OF TRUE, FALSE, FALSE, FALSE)
`a director who cannot be appointed without the other corporation` MEANS
    (`s 5(2) director` OF FALSE, TRUE, FALSE, FALSE)
`a director whose appointment follows from an office in the other corporation` MEANS
    (`s 5(2) director` OF FALSE, FALSE, TRUE, FALSE)
`a director of the other corporation's choosing, but by a power held only as a fiduciary` MEANS
    (`s 5(2) director` OF TRUE, FALSE, FALSE, TRUE)
`an independent director` MEANS
    (`s 5(2) director` OF FALSE, FALSE, FALSE, FALSE)

-- Three directors, two of them the other corporation's: a majority.
#ASSERT `s 5(2) the other corporation controls the composition of the board` (LIST `a director the other corporation appoints`, `a director the other corporation appoints`, `an independent director`) EQUALS JUST TRUE
-- Three directors, one: not a majority.
#ASSERT `s 5(2) the other corporation controls the composition of the board` (LIST `a director the other corporation appoints`, `an independent director`, `an independent director`) EQUALS JUST FALSE
-- Four directors, two: exactly half is not a majority.
#ASSERT `s 5(2) the other corporation controls the composition of the board` (LIST `a director the other corporation appoints`, `a director the other corporation appoints`, `an independent director`, `an independent director`) EQUALS JUST FALSE
-- Four directors, three: a majority.
#ASSERT `s 5(2) the other corporation controls the composition of the board` (LIST `a director the other corporation appoints`, `a director the other corporation appoints`, `a director the other corporation appoints`, `an independent director`) EQUALS JUST TRUE
-- All of the directors (a single director).
#ASSERT `s 5(2) the other corporation controls the composition of the board` (LIST `a director the other corporation appoints`) EQUALS JUST TRUE
-- Deeming limb (a): a person who cannot be appointed without the other corporation's exercise of the power counts.
#ASSERT `s 5(2) the other corporation controls the composition of the board` (LIST `a director who cannot be appointed without the other corporation`, `a director who cannot be appointed without the other corporation`, `an independent director`) EQUALS JUST TRUE
-- Deeming limb (b): a person whose appointment follows necessarily from an office in the other corporation counts.
#ASSERT `s 5(2) the other corporation controls the composition of the board` (LIST `a director whose appointment follows from an office in the other corporation`, `a director whose appointment follows from an office in the other corporation`, `an independent director`) EQUALS JUST TRUE
-- s 5(3)(a): a power held only in a fiduciary capacity is treated as not exercisable: two of three, but both fiduciary.
#ASSERT `s 5(2) the other corporation controls the composition of the board` (LIST `a director of the other corporation's choosing, but by a power held only as a fiduciary`, `a director of the other corporation's choosing, but by a power held only as a fiduciary`, `an independent director`) EQUALS JUST FALSE
-- No directors: nobody to control.
#ASSERT `s 5(2) the other corporation controls the composition of the board` EMPTY EQUALS JUST FALSE

§ `Section 5(3): which shares and which power count, and "more than half"`

`votes held by the other corporation itself` MEANS
    (`s 5(3) holding` OF `s 5(3) the other corporation itself`, 51, FALSE, FALSE, FALSE, FALSE)
`votes held by its nominee` MEANS
    (`s 5(3) holding` OF `s 5(3) a nominee for the other corporation`, 30, FALSE, FALSE, FALSE, FALSE)
`votes held by its subsidiary` MEANS
    (`s 5(3) holding` OF `s 5(3) a subsidiary of the other corporation`, 30, FALSE, FALSE, FALSE, FALSE)
`votes held by a nominee for its subsidiary` MEANS
    (`s 5(3) holding` OF `s 5(3) a nominee for a subsidiary of the other corporation`, 30, FALSE, FALSE, FALSE, FALSE)
`votes held by a stranger` MEANS
    (`s 5(3) holding` OF `s 5(3) any other person`, 100, FALSE, FALSE, FALSE, FALSE)

-- (a), (b): each counted block is the other corporation's.
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` `votes held by the other corporation itself` EQUALS 51
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` `votes held by its nominee` EQUALS 30
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` `votes held by its subsidiary` EQUALS 30
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` `votes held by a nominee for its subsidiary` EQUALS 30
-- A stranger's votes are not the other corporation's.
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` `votes held by a stranger` EQUALS 0
-- (a): held in a fiduciary capacity, treated as not held.
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` ((`s 5(3) holding` OF `s 5(3) the other corporation itself`, 51, TRUE, FALSE, FALSE, FALSE)) EQUALS 0
-- (b)(i) exception: a nominee for a corporation concerned only in a fiduciary capacity.
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` ((`s 5(3) holding` OF `s 5(3) a nominee for the other corporation`, 30, TRUE, FALSE, FALSE, FALSE)) EQUALS 0
-- (b)(ii) exception: a subsidiary concerned only in a fiduciary capacity.
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` ((`s 5(3) holding` OF `s 5(3) a subsidiary of the other corporation`, 30, TRUE, FALSE, FALSE, FALSE)) EQUALS 0
-- (c): held by virtue of debentures or a trust deed, disregarded, whoever holds.
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` ((`s 5(3) holding` OF `s 5(3) the other corporation itself`, 60, FALSE, TRUE, FALSE, FALSE)) EQUALS 0
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` ((`s 5(3) holding` OF `s 5(3) any other person`, 60, FALSE, TRUE, FALSE, FALSE)) EQUALS 0
-- (d): lending business and security only, both: treated as not held.
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` ((`s 5(3) holding` OF `s 5(3) the other corporation itself`, 60, FALSE, FALSE, TRUE, TRUE)) EQUALS 0
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` ((`s 5(3) holding` OF `s 5(3) a nominee for the other corporation`, 60, FALSE, FALSE, TRUE, TRUE)) EQUALS 0
-- (d) needs both limbs: a lender holding outright (not by way of security only) is counted.
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` ((`s 5(3) holding` OF `s 5(3) the other corporation itself`, 60, FALSE, FALSE, TRUE, FALSE)) EQUALS 60
-- (d) needs both limbs: security only, but not a lending business, is counted.
#ASSERT `s 5(3) the votes counted as held or exercisable by the other corporation` ((`s 5(3) holding` OF `s 5(3) the other corporation itself`, 60, FALSE, FALSE, FALSE, TRUE)) EQUALS 60

-- "more than half of the voting power": of 100 votes, 51 is, 50 is not.
#ASSERT `s 5(1)(a)(ii) the other corporation controls more than half of the voting power` (LIST `votes held by the other corporation itself`) 100 EQUALS JUST TRUE
#ASSERT `s 5(1)(a)(ii) the other corporation controls more than half of the voting power` (LIST (`s 5(3) holding` OF `s 5(3) the other corporation itself`, 50, FALSE, FALSE, FALSE, FALSE)) 100 EQUALS JUST FALSE
-- Added together, the corporation's own votes, its nominee's and its subsidiary's: 21 + 20 + 10 = 51 of 100.
#ASSERT `s 5(1)(a)(ii) the other corporation controls more than half of the voting power` (LIST (`s 5(3) holding` OF `s 5(3) the other corporation itself`, 21, FALSE, FALSE, FALSE, FALSE), (`s 5(3) holding` OF `s 5(3) a nominee for the other corporation`, 20, FALSE, FALSE, FALSE, FALSE), (`s 5(3) holding` OF `s 5(3) a subsidiary of the other corporation`, 10, FALSE, FALSE, FALSE, FALSE)) 100 EQUALS JUST TRUE
-- With the subsidiary's 10 held only as a fiduciary: 41 of 100, not more than half.
#ASSERT `s 5(1)(a)(ii) the other corporation controls more than half of the voting power` (LIST (`s 5(3) holding` OF `s 5(3) the other corporation itself`, 21, FALSE, FALSE, FALSE, FALSE), (`s 5(3) holding` OF `s 5(3) a nominee for the other corporation`, 20, FALSE, FALSE, FALSE, FALSE), (`s 5(3) holding` OF `s 5(3) a subsidiary of the other corporation`, 10, TRUE, FALSE, FALSE, FALSE)) 100 EQUALS JUST FALSE
-- The debenture holders' 60 are disregarded: the other corporation's own 40 of 100 is not more than half.
#ASSERT `s 5(1)(a)(ii) the other corporation controls more than half of the voting power` (LIST (`s 5(3) holding` OF `s 5(3) the other corporation itself`, 40, FALSE, FALSE, FALSE, FALSE), (`s 5(3) holding` OF `s 5(3) any other person`, 60, FALSE, TRUE, FALSE, FALSE)) 100 EQUALS JUST FALSE
-- No holdings at all.
#ASSERT `s 5(1)(a)(ii) the other corporation controls more than half of the voting power` EMPTY 100 EQUALS JUST FALSE

§ `Section 5(4) and (5): holding company`

#ASSERT `s 5(4) the corporation is the holding company of the other corporation, by the links` `the links of both groups` `corporation P` `corporation C` EQUALS JUST TRUE
#ASSERT `s 5(4) the corporation is the holding company of the other corporation, by the links` `the links of both groups` `corporation S1` `corporation C` EQUALS JUST TRUE
#ASSERT `s 5(4) the corporation is the holding company of the other corporation, by the links` `the links of both groups` `corporation C` `corporation P` EQUALS JUST FALSE
#ASSERT `s 5(4) the corporation is the holding company of the other corporation, by the links` `the links of both groups` `corporation S3` `corporation S1` EQUALS JUST FALSE
-- A joint venture has two holding companies.
#ASSERT `s 5(4) the corporation is the holding company of the other corporation, by the links` `the links of both groups` `corporation A` `corporation JV` EQUALS JUST TRUE
#ASSERT `s 5(4) the corporation is the holding company of the other corporation, by the links` `the links of both groups` `corporation B` `corporation JV` EQUALS JUST TRUE
-- s 5(5): the Depository by reason only of shares it holds as a bare trustee.
#ASSERT `s 5(5) the corporation is to be regarded as a holding company` TRUE TRUE EQUALS JUST FALSE
-- The Depository with another ground: the subsection says nothing; not covered.
#ASSERT `s 5(5) the corporation is to be regarded as a holding company` TRUE FALSE EQUALS NOTHING
-- Another corporation: not covered by this subsection.
#ASSERT `s 5(5) the corporation is to be regarded as a holding company` FALSE TRUE EQUALS NOTHING

§ `Section 5A: ultimate holding company`

#ASSERT `s 5A the corporation is the ultimate holding company of the other corporation, by the links` `the links of both groups` `corporation P` `corporation C` EQUALS JUST TRUE
#ASSERT `s 5A the corporation is the ultimate holding company of the other corporation, by the links` `the links of both groups` `corporation P` `corporation S3` EQUALS JUST TRUE
-- S1 is a holding company of C but is itself P's subsidiary: not the ultimate one.
#ASSERT `s 5A the corporation is the ultimate holding company of the other corporation, by the links` `the links of both groups` `corporation S1` `corporation C` EQUALS JUST FALSE
-- C is the subsidiary of P, not P of C.
#ASSERT `s 5A the corporation is the ultimate holding company of the other corporation, by the links` `the links of both groups` `corporation C` `corporation P` EQUALS JUST FALSE
-- Not in the same group.
#ASSERT `s 5A the corporation is the ultimate holding company of the other corporation, by the links` `the links of both groups` `corporation P` `corporation JV` EQUALS JUST FALSE
-- A joint venture has two ultimate holding companies, A and B.
#ASSERT `s 5A the corporation is the ultimate holding company of the other corporation, by the links` `the links of both groups` `corporation A` `corporation JV` EQUALS JUST TRUE
#ASSERT `s 5A the corporation is the ultimate holding company of the other corporation, by the links` `the links of both groups` `corporation B` `corporation JV` EQUALS JUST TRUE
-- The two limbs as facts.
#ASSERT `s 5A the firstmentioned corporation is the ultimate holding company of the other corporation` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 5A the firstmentioned corporation is the ultimate holding company of the other corporation` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 5A the firstmentioned corporation is the ultimate holding company of the other corporation` FALSE FALSE EQUALS JUST FALSE

§ `Section 5B: wholly owned subsidiary`

`a member that is the other corporation` MEANS (`s 5B member` OF `s 5B the other corporation`, EMPTY)
`a member that is a nominee of the other corporation` MEANS (`s 5B member` OF `s 5B a nominee of the other corporation`, EMPTY)
`a member that is some other person` MEANS (`s 5B member` OF `s 5B any other person`, EMPTY)
-- (c): a subsidiary all of whose members are the other corporation or its nominee.
`a member that is a closed subsidiary` MEANS
    (`s 5B member` OF `s 5B a subsidiary of the other corporation`, (LIST `s 5B the other corporation`, `s 5B a nominee of the other corporation`))
-- A subsidiary with an outsider among its members.
`a member that is a subsidiary with an outsider` MEANS
    (`s 5B member` OF `s 5B a subsidiary of the other corporation`, (LIST `s 5B the other corporation`, `s 5B any other person`))
-- A subsidiary whose member is itself a subsidiary: the three-tier case.
`a member that is a subsidiary of a subsidiary` MEANS
    (`s 5B member` OF `s 5B a subsidiary of the other corporation`, (LIST `s 5B a subsidiary of the other corporation`))
-- (d): a nominee of such a subsidiary.
`a member that is a nominee of a closed subsidiary` MEANS
    (`s 5B member` OF `s 5B a nominee of a subsidiary of the other corporation`, (LIST `s 5B the other corporation`))
`a member that is a nominee of a subsidiary with an outsider` MEANS
    (`s 5B member` OF `s 5B a nominee of a subsidiary of the other corporation`, (LIST `s 5B any other person`))

-- (a) the other corporation is the only member.
#ASSERT `s 5B the corporation is a wholly owned subsidiary of the other corporation` (LIST `a member that is the other corporation`) EQUALS JUST TRUE
-- (a) and (b).
#ASSERT `s 5B the corporation is a wholly owned subsidiary of the other corporation` (LIST `a member that is the other corporation`, `a member that is a nominee of the other corporation`) EQUALS JUST TRUE
-- (c) closed subsidiary.
#ASSERT `s 5B the corporation is a wholly owned subsidiary of the other corporation` (LIST `a member that is a closed subsidiary`) EQUALS JUST TRUE
-- (c) subsidiary with an outsider: the corporation is not wholly owned.
#ASSERT `s 5B the corporation is a wholly owned subsidiary of the other corporation` (LIST `a member that is a subsidiary with an outsider`) EQUALS JUST FALSE
-- (c) the three-tier chain: a member that is a subsidiary of a subsidiary is outside (c), because (c) asks that none of the subsidiary's members is a person other than the other corporation or its nominee.
#ASSERT `s 5B the corporation is a wholly owned subsidiary of the other corporation` (LIST `a member that is a subsidiary of a subsidiary`) EQUALS JUST FALSE
-- (d) nominee of a closed subsidiary.
#ASSERT `s 5B the corporation is a wholly owned subsidiary of the other corporation` (LIST `a member that is a nominee of a closed subsidiary`) EQUALS JUST TRUE
#ASSERT `s 5B the corporation is a wholly owned subsidiary of the other corporation` (LIST `a member that is a nominee of a subsidiary with an outsider`) EQUALS JUST FALSE
-- One outsider among many insiders spoils it.
#ASSERT `s 5B the corporation is a wholly owned subsidiary of the other corporation` (LIST `a member that is the other corporation`, `a member that is a closed subsidiary`, `a member that is some other person`) EQUALS JUST FALSE
-- A member that is some other person.
#ASSERT `s 5B the corporation is a wholly owned subsidiary of the other corporation` (LIST `a member that is some other person`) EQUALS JUST FALSE
-- No members at all: "none of the members ... is a person other than" holds vacuously (NOTES.md, finding).
#ASSERT `s 5B the corporation is a wholly owned subsidiary of the other corporation` EMPTY EQUALS JUST TRUE

§ `Section 6: related corporations`

-- (a) and (b): a corporation and its holding company, in either order.
#ASSERT `s 6 the corporation and the other corporation are deemed to be related, by the links` `the links of both groups` `corporation P` `corporation C` EQUALS JUST TRUE
#ASSERT `s 6 the corporation and the other corporation are deemed to be related, by the links` `the links of both groups` `corporation C` `corporation P` EQUALS JUST TRUE
-- (c): two subsidiaries of one holding company, siblings S1 and S3.
#ASSERT `s 6 the corporation and the other corporation are deemed to be related, by the links` `the links of both groups` `corporation S1` `corporation S3` EQUALS JUST TRUE
#ASSERT `s 6 the corporation and the other corporation are deemed to be related, by the links` `the links of both groups` `corporation S3` `corporation S1` EQUALS JUST TRUE
-- (c): an uncle and a nephew at different depths: C is a subsidiary of P, the holding company of S3.
#ASSERT `s 6 the corporation and the other corporation are deemed to be related, by the links` `the links of both groups` `corporation C` `corporation S3` EQUALS JUST TRUE
#ASSERT `s 6 the corporation and the other corporation are deemed to be related, by the links` `the links of both groups` `corporation S3` `corporation C` EQUALS JUST TRUE
-- The two parents of a joint venture are not related to each other: neither is the other's holding company or subsidiary, and neither is a subsidiary of anything.
#ASSERT `s 6 the corporation and the other corporation are deemed to be related, by the links` `the links of both groups` `corporation A` `corporation B` EQUALS JUST FALSE
-- But each is related to the joint venture.
#ASSERT `s 6 the corporation and the other corporation are deemed to be related, by the links` `the links of both groups` `corporation A` `corporation JV` EQUALS JUST TRUE
-- Corporations of different groups, and a stand-alone corporation.
#ASSERT `s 6 the corporation and the other corporation are deemed to be related, by the links` `the links of both groups` `corporation P` `corporation JV` EQUALS JUST FALSE
#ASSERT `s 6 the corporation and the other corporation are deemed to be related, by the links` `the links of both groups` `corporation X` `corporation P` EQUALS JUST FALSE
-- The three limbs as facts.
#ASSERT `s 6 the corporations are deemed to be related to each other` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 6 the corporations are deemed to be related to each other` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 6 the corporations are deemed to be related to each other` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 6 the corporations are deemed to be related to each other` FALSE FALSE FALSE EQUALS JUST FALSE

§ `Section 4(1): "related corporation"`

-- The same relation as s 6, whichever corporation is "the firstmentioned".
#ASSERT `s 4(1) "related corporation" the other corporation is a related corporation of the corporation, by the links` `the links of both groups` `corporation P` `corporation C` EQUALS JUST TRUE
#ASSERT `s 4(1) "related corporation" the other corporation is a related corporation of the corporation, by the links` `the links of both groups` `corporation S1` `corporation S3` EQUALS JUST TRUE
#ASSERT `s 4(1) "related corporation" the other corporation is a related corporation of the corporation, by the links` `the links of both groups` `corporation A` `corporation B` EQUALS JUST FALSE
#ASSERT `s 4(1) "related corporation" the other corporation is a related corporation of the corporation, by the links` `the links of both groups` `corporation X` `corporation P` EQUALS JUST FALSE
#ASSERT `s 4(1) "related corporation" the other corporation is a related corporation of the corporation` TRUE EQUALS JUST TRUE
#ASSERT `s 4(1) "related corporation" the other corporation is a related corporation of the corporation` FALSE EQUALS JUST FALSE
