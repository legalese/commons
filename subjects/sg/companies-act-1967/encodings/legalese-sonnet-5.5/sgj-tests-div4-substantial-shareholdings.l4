IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-interests`
IMPORT `sg-definitions`
IMPORT `sgj-div4-substantial-shareholdings`

-- Tests for ss 79 to 92 (Division 4, substantial shareholdings). Every expected value is written from the text of the section, not from the output of the code.
-- Weekdays used (checked against the calendar, not the code): 1 January 2026 is a Thursday, so 8 January 2026 is a Thursday, 9 a Friday, 10 and 11 the weekend, 12 a Monday.
-- 1 October 1971 was a Friday, so 2 October 1971 is a Saturday and 4 October 1971 a Monday.

§ `Test fixtures: the facts of s 7`

-- The 14 facts of `s 7 interest facts` in order: authority to dispose; trust interest; knows of it; contract to purchase; right to have transferred; option;
-- entitled to exercise a right (not the registered holder); unit in a collective investment scheme; bare trustee; lender; holds only as security; prescribed office;
-- company's own shares; prescribed interest; then the bodies corporate (none).
`s 81 test: facts with authority to dispose` MEANS `s 7 interest facts` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, EMPTY
`s 81 test: facts with an option` MEANS `s 7 interest facts` OF FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, EMPTY
`s 81 test: facts with no interest` MEANS `s 7 interest facts` OF FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, EMPTY
`s 81 test: facts of a bare trustee with authority` MEANS `s 7 interest facts` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, EMPTY
`s 81 test: facts of a scheme unit with authority` MEANS `s 7 interest facts` OF TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, EMPTY

§ `Section 79`

#ASSERT `s 79(1) section 79 has effect for the provision` TRUE EQUALS JUST TRUE
-- "does not affect the operation of any other provision of this Act"
#ASSERT `s 79(1) section 79 has effect for the provision` FALSE EQUALS JUST FALSE
-- (2)(b) a body corporate incorporated in Singapore, declared; (2)(c) a body not a body corporate formed in Singapore, declared
#ASSERT `s 79(2) the body is a company for the purposes of this Division` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 79(2) the body is a company for the purposes of this Division` FALSE TRUE TRUE EQUALS JUST TRUE
-- not declared by the Minister: the text does not say (paragraph (a) is deleted and the list is not closed with "only")
#ASSERT `s 79(2) the body is a company for the purposes of this Division` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 79(2) the body is a company for the purposes of this Division` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 79(3) the interest in the stock is deemed to be an interest in an issued share in the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 79(3) the interest in the stock is deemed to be an interest in an issued share in the company` TRUE FALSE EQUALS NOTHING
#ASSERT `s 79(3) the interest in the stock is deemed to be an interest in an issued share in the company` FALSE TRUE EQUALS NOTHING
#ASSERT `s 79(4) the body is within a reference to a body corporate in the definition of "voting share"` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 79(4) the body is within a reference to a body corporate in the definition of "voting share"` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 79(4) the body is within a reference to a body corporate in the definition of "voting share"` FALSE FALSE EQUALS NOTHING

§ `Section 80`

#ASSERT `s 80(1) the obligation to comply with this Division extends to the person` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 80(1) the obligation to comply with this Division extends to the person` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 80(1) the obligation to comply with this Division extends to the person` FALSE FALSE EQUALS NOTHING
#ASSERT `s 80(2) this Division extends to the act or omission` TRUE EQUALS JUST TRUE
#ASSERT `s 80(2) this Division extends to the act or omission` FALSE EQUALS NOTHING
#ASSERT `s 80(3) the person is exempt from the provision of this Division` TRUE TRUE EQUALS JUST TRUE
-- an order but the prescribed terms or conditions are not met; no order at all
#ASSERT `s 80(3) the person is exempt from the provision of this Division` TRUE FALSE EQUALS NOTHING
#ASSERT `s 80(3) the person is exempt from the provision of this Division` FALSE TRUE EQUALS NOTHING

§ `Section 81`

#ASSERT `s 81(4) the share is a voting share for the purposes of section 81 and section 83` TRUE EQUALS JUST FALSE
#ASSERT `s 81(4) the share is a voting share for the purposes of section 81 and section 83` FALSE EQUALS NOTHING
-- (1)(a): voting shares (not treasury shares) in which the person has an interest by s 7
#ASSERT `s 81(1)(a) the person has an interest or interests in one or more voting shares in the company` TRUE FALSE `s 81 test: facts with authority to dispose` EQUALS JUST TRUE
#ASSERT `s 81(1)(a) the person has an interest or interests in one or more voting shares in the company` TRUE FALSE `s 81 test: facts with an option` EQUALS JUST TRUE
-- treasury shares are excluded (s 81(4))
#ASSERT `s 81(1)(a) the person has an interest or interests in one or more voting shares in the company` TRUE TRUE `s 81 test: facts with authority to dispose` EQUALS JUST FALSE
-- not voting shares
#ASSERT `s 81(1)(a) the person has an interest or interests in one or more voting shares in the company` FALSE FALSE `s 81 test: facts with authority to dispose` EQUALS JUST FALSE
-- no interest in the s 7 sense; a bare trustee's interest is disregarded (s 7(9)(a)); a unit in a collective investment scheme is no interest (s 7(3))
#ASSERT `s 81(1)(a) the person has an interest or interests in one or more voting shares in the company` TRUE FALSE `s 81 test: facts with no interest` EQUALS JUST FALSE
#ASSERT `s 81(1)(a) the person has an interest or interests in one or more voting shares in the company` TRUE FALSE `s 81 test: facts of a bare trustee with authority` EQUALS JUST FALSE
#ASSERT `s 81(1)(a) the person has an interest or interests in one or more voting shares in the company` TRUE FALSE `s 81 test: facts of a scheme unit with authority` EQUALS JUST FALSE
-- the seam with the keel: the shares are voting shares as s 4(1) defines them (issued; a right to vote; not only in the six special circumstances)
#ASSERT `s 4(1) "voting share" the share is a voting share` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 81(1)(a) the person has an interest or interests in one or more voting shares in the company` (`s 4(1) "voting share" the share is a voting share` TRUE FALSE FALSE EQUALS JUST TRUE) FALSE `s 81 test: facts with authority to dispose` EQUALS JUST TRUE
#ASSERT `s 81(1)(a) the person has an interest or interests in one or more voting shares in the company` (`s 4(1) "voting share" the share is a voting share` TRUE TRUE FALSE EQUALS JUST TRUE) FALSE `s 81 test: facts with authority to dispose` EQUALS JUST FALSE
-- (1)(b): 5% exactly, and just under it
#ASSERT `s 81(1)(b) the votes are not less than 5% of the total votes attached to all the voting shares in the company` 5 100 EQUALS JUST TRUE
#ASSERT `s 81(1)(b) the votes are not less than 5% of the total votes attached to all the voting shares in the company` 4 100 EQUALS JUST FALSE
#ASSERT `s 81(1)(b) the votes are not less than 5% of the total votes attached to all the voting shares in the company` 500 10000 EQUALS JUST TRUE
#ASSERT `s 81(1)(b) the votes are not less than 5% of the total votes attached to all the voting shares in the company` 499 10000 EQUALS JUST FALSE
#ASSERT `s 81(1)(b) the votes are not less than 5% of the total votes attached to all the voting shares in the company` 100 100 EQUALS JUST TRUE
-- (1): both limbs, and a company for this Division
#ASSERT `s 81(1) the person has a substantial shareholding in the company` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 81(1) the person has a substantial shareholding in the company` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 81(1) the person has a substantial shareholding in the company` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 81(1) the person has a substantial shareholding in the company` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 81(1) the person has a substantial shareholding in the company` TRUE NOTHING (JUST TRUE) EQUALS JUST FALSE
-- (2): the classes limb; 5% of the votes of the class
#ASSERT `s 81(2) the person has a substantial shareholding in the company, the share capital of which is divided into 2 or more classes` TRUE TRUE (JUST TRUE) 20 400 EQUALS JUST TRUE
#ASSERT `s 81(2) the person has a substantial shareholding in the company, the share capital of which is divided into 2 or more classes` TRUE TRUE (JUST TRUE) 19 400 EQUALS JUST FALSE
#ASSERT `s 81(2) the person has a substantial shareholding in the company, the share capital of which is divided into 2 or more classes` TRUE FALSE (JUST TRUE) 20 400 EQUALS JUST FALSE
#ASSERT `s 81(2) the person has a substantial shareholding in the company, the share capital of which is divided into 2 or more classes` TRUE TRUE (JUST FALSE) 20 400 EQUALS JUST FALSE
#ASSERT `s 81(2) the person has a substantial shareholding in the company, the share capital of which is divided into 2 or more classes` FALSE TRUE (JUST TRUE) 20 400 EQUALS JUST FALSE
-- (3): a person who has a substantial shareholding is a substantial shareholder
#ASSERT `s 81(3) the person is a substantial shareholder in the company` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 81(3) the person is a substantial shareholder in the company` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 81(3) the person is a substantial shareholder in the company` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 81(3) the person is a substantial shareholder in the company` NOTHING NOTHING EQUALS NOTHING

§ `Section 82`

-- (1): the notice. Arguments: substantial shareholder; in writing and given to the company; name and address; particulars of the voting shares; cannot be related to a particular share; names the registered holder; particulars of each interest and the circumstances.
#ASSERT `s 82(1) the notice is the notice the subsection requires` TRUE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- the interests cannot be related to a particular share: the registered holder need not be named
#ASSERT `s 82(1) the notice is the notice the subsection requires` TRUE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- they can be related to a share, and the holder is not named
#ASSERT `s 82(1) the notice is the notice the subsection requires` TRUE TRUE TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 82(1) the notice is the notice the subsection requires` TRUE FALSE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 82(1) the notice is the notice the subsection requires` TRUE TRUE FALSE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 82(1) the notice is the notice the subsection requires` TRUE TRUE TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 82(1) the notice is the notice the subsection requires` TRUE TRUE TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 82(1) the notice is the notice the subsection requires` FALSE TRUE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- (2): the last day. Became a substantial shareholder on Thursday 8 January 2026: Friday 9 is business day 1, Monday 12 is business day 2.
#ASSERT `s 82(2) the last day for giving the notice` FALSE (Date 8 1 2026) EMPTY EQUALS JUST (Date 12 1 2026)
-- a public holiday on Monday 12 January moves it to Tuesday 13
#ASSERT `s 82(2) the last day for giving the notice` FALSE (Date 8 1 2026) (LIST (Date 12 1 2026)) EQUALS JUST (Date 13 1 2026)
-- became on Friday 9 January: Monday 12 is day 1, Tuesday 13 is day 2
#ASSERT `s 82(2) the last day for giving the notice` FALSE (Date 9 1 2026) EMPTY EQUALS JUST (Date 13 1 2026)
-- (a): a substantial shareholder on 1 October 1971: within one month after that date
#ASSERT `s 82(2) the last day for giving the notice` TRUE (Date 1 10 1971) EMPTY EQUALS JUST (Date 1 11 1971)
-- (b) just after the date: Saturday 2 October 1971, Monday 4 is day 1, Tuesday 5 is day 2
#ASSERT `s 82(2) the last day for giving the notice` FALSE (Date 2 10 1971) EMPTY EQUALS JUST (Date 5 10 1971)
-- neither on 1 October 1971 nor after it: the text does not say
#ASSERT `s 82(2) the last day for giving the notice` FALSE (Date 1 10 1971) EMPTY EQUALS NOTHING
#ASSERT `s 82(2) the last day for giving the notice` FALSE (Date 1 1 1970) EMPTY EQUALS NOTHING
-- in time: on the last day, before it, the day of becoming; and the day after
#ASSERT `s 82(2) the notice was given within the time the subsection allows` FALSE (Date 8 1 2026) EMPTY (Date 12 1 2026) EQUALS JUST TRUE
#ASSERT `s 82(2) the notice was given within the time the subsection allows` FALSE (Date 8 1 2026) EMPTY (Date 8 1 2026) EQUALS JUST TRUE
#ASSERT `s 82(2) the notice was given within the time the subsection allows` FALSE (Date 8 1 2026) EMPTY (Date 13 1 2026) EQUALS JUST FALSE
#ASSERT `s 82(2) the notice was given within the time the subsection allows` FALSE (Date 8 1 2026) (LIST (Date 12 1 2026)) (Date 13 1 2026) EQUALS JUST TRUE
#ASSERT `s 82(2) the notice was given within the time the subsection allows` FALSE (Date 8 1 2026) (LIST (Date 12 1 2026)) (Date 14 1 2026) EQUALS JUST FALSE
#ASSERT `s 82(2) the notice was given within the time the subsection allows` TRUE (Date 1 10 1971) EMPTY (Date 1 11 1971) EQUALS JUST TRUE
#ASSERT `s 82(2) the notice was given within the time the subsection allows` TRUE (Date 1 10 1971) EMPTY (Date 2 11 1971) EQUALS JUST FALSE
#ASSERT `s 82(2) the notice was given within the time the subsection allows` FALSE (Date 1 1 1970) EMPTY (Date 1 1 2026) EQUALS NOTHING
-- (3)
#ASSERT `s 82(3) the notice must be given although the person has ceased to be a substantial shareholder` TRUE EQUALS JUST TRUE
#ASSERT `s 82(3) the notice must be given although the person has ceased to be a substantial shareholder` FALSE EQUALS NOTHING
-- the duty as a regulative rule: the clock counts business days after the day the person became a substantial shareholder
-- EXPECT FULFILLED
#TRACE `s 82(1) a substantial shareholder must give notice to the company within 2 business days` "Ann Tan" AT 0 WITH
    PARTY Individual "Ann Tan" DOES `s 82(1) give written notice to the company of the person's interests` AT 2

-- EXPECT BREACH
#TRACE `s 82(1) a substantial shareholder must give notice to the company within 2 business days` "Ann Tan" AT 0 WITH
    PARTY Individual "Ann Tan" DOES `s 82(1) give written notice to the company of the person's interests` AT 3

-- EXPECT BREACH
#TRACE `s 82(1) a substantial shareholder must give notice to the company within 2 business days` "Ann Tan" AT 0 WITH
    (WAITUNTIL 3)

-- EXPECT RESIDUAL
#TRACE `s 82(1) a substantial shareholder must give notice to the company within 2 business days` "Ann Tan" AT 0 WITH
    (WAITUNTIL 2)

