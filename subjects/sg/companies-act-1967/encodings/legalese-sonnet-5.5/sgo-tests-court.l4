IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-definitions`
IMPORT `sgo-court`

-- Tests for sgo-court.l4 (ss 388, 389, 390, 391, 392, 394, 399, 409A, 409C).
-- Every expected value is written from the text of the section, beside the assertion, before the code was run.

§ `Section 388`

#ASSERT `s 388(1) the court may require sufficient security to be given for the costs of the defendant` TRUE TRUE EQUALS JUST TRUE
-- claimant, but no credible testimony: the "if" gate of a grant.
#ASSERT `s 388(1) the court may require sufficient security to be given for the costs of the defendant` TRUE FALSE EQUALS NOTHING
-- the corporation is not claimant: the "Where" gate.
#ASSERT `s 388(1) the court may require sufficient security to be given for the costs of the defendant` FALSE TRUE EQUALS JUST FALSE
-- the stay lasts until the security is given.
#ASSERT `s 388(1) the proceedings are stayed until the security is given` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 388(1) the proceedings are stayed until the security is given` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 388(1) the proceedings are stayed until the security is given` FALSE FALSE EQUALS NOTHING
-- (2): the party the court directs bears the costs.
#ASSERT `s 388(2) the party must bear the costs of the proceeding` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 388(2) the party must bear the costs of the proceeding` TRUE FALSE EQUALS NOTHING
#ASSERT `s 388(2) the party must bear the costs of the proceeding` FALSE TRUE EQUALS NOTHING

§ `Section 389`

#ASSERT `s 389 the person may employ a solicitor at the person's own cost` TRUE EQUALS JUST TRUE
#ASSERT `s 389 the person may employ a solicitor at the person's own cost` FALSE EQUALS NOTHING
#ASSERT `s 389 the solicitor is at liberty to put the question to the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 389 the solicitor is at liberty to put the question to the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 389 the solicitor is at liberty to put the question to the person` FALSE TRUE EQUALS NOTHING
-- A permission has no breach path: employing the solicitor, or not, never breaches it.
-- EXPECT FULFILLED
#TRACE `s 389 a person summoned for examination under Part 9 may employ a solicitor` "Ann" AT 0 WITH
    PARTY Individual "Ann" DOES `s 389 employ a solicitor at the person's own cost` AT 1
-- EXPECT RESIDUAL
#TRACE `s 389 a person summoned for examination under Part 9 may employ a solicitor` "Ann" AT 0 WITH
    WAITUNTIL 5

§ `Section 390`

-- (1): unable to find the shareholder for not less than 10 years.
#ASSERT `s 390(1) the company may cause the advertisement to be published` TRUE 10 TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 390(1) the company may cause the advertisement to be published` TRUE 11 TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 390(1) the company may cause the advertisement to be published` TRUE 9 TRUE TRUE EQUALS JUST FALSE
-- reasonable diligence not exercised.
#ASSERT `s 390(1) the company may cause the advertisement to be published` FALSE 15 TRUE TRUE EQUALS JUST FALSE
-- advertisement not in a newspaper circulating where the register shows the address.
#ASSERT `s 390(1) the company may cause the advertisement to be published` TRUE 10 FALSE TRUE EQUALS NOTHING
-- advertisement does not state the intention.
#ASSERT `s 390(1) the company may cause the advertisement to be published` TRUE 10 TRUE FALSE EQUALS NOTHING
-- (2): advertisement on 15 January 2025: one month expires on 15 February 2025; "after the expiration" is 16 February.
#ASSERT `s 390(2) the company may transfer the shares held by the shareholder to the Official Receiver and execute the transfer for the owner` (Date 15 1 2025) (Date 16 2 2025) TRUE EQUALS JUST TRUE
#ASSERT `s 390(2) the company may transfer the shares held by the shareholder to the Official Receiver and execute the transfer for the owner` (Date 15 1 2025) (Date 15 2 2025) TRUE EQUALS NOTHING
#ASSERT `s 390(2) the company may transfer the shares held by the shareholder to the Official Receiver and execute the transfer for the owner` (Date 15 1 2025) (Date 14 2 2025) TRUE EQUALS NOTHING
-- the whereabouts have become known.
#ASSERT `s 390(2) the company may transfer the shares held by the shareholder to the Official Receiver and execute the transfer for the owner` (Date 15 1 2025) (Date 20 2 2025) FALSE EQUALS NOTHING
-- advertisement on 31 January 2025: one month ends on 28 February 2025 (sg-periods P4), so 1 March is after it.
#ASSERT `s 390(2) the company may transfer the shares held by the shareholder to the Official Receiver and execute the transfer for the owner` (Date 31 1 2025) (Date 1 3 2025) TRUE EQUALS JUST TRUE
#ASSERT `s 390(2) the company may transfer the shares held by the shareholder to the Official Receiver and execute the transfer for the owner` (Date 31 1 2025) (Date 28 2 2025) TRUE EQUALS NOTHING
-- (3)
#ASSERT `s 390(3) the Official Receiver must sell or dispose of the shares and deal with the proceeds as if they were moneys paid under section 197 of the Insolvency, Restructuring and Dissolution Act 2018` TRUE EQUALS JUST TRUE
#ASSERT `s 390(3) the Official Receiver must sell or dispose of the shares and deal with the proceeds as if they were moneys paid under section 197 of the Insolvency, Restructuring and Dissolution Act 2018` FALSE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `s 390(1) a company that cannot find a shareholder may cause the advertisement to be published` "Acme" AT 0 WITH
    PARTY Company "Acme" DOES `s 390(1) cause an advertisement to be published in a newspaper` AT 1
-- EXPECT FULFILLED
#TRACE `s 390(2) a company that still cannot find the shareholder may transfer the shares to the Official Receiver` "Acme" AT 0 WITH
    PARTY Company "Acme" DOES `s 390(2) transfer the shares held by the shareholder to the Official Receiver` AT 1
-- The duty of the Official Receiver has no time limit: late is as good as on time, and nothing breaches it.
-- EXPECT FULFILLED
#TRACE `s 390(3) the Official Receiver must sell or dispose of the shares received` AT 0 WITH
    PARTY `Official Receiver` DOES `s 390(3) sell or dispose of the shares received and deal with the proceeds as if they were moneys paid under section 197 of the Insolvency, Restructuring and Dissolution Act 2018` AT 400
-- EXPECT RESIDUAL
#TRACE `s 390(3) the Official Receiver must sell or dispose of the shares received` AT 0 WITH
    WAITUNTIL 400

§ `Section 391`

-- (3): an officer.
#ASSERT `s 391(3) the person is a person to whom section 391 applies` `s 4(1) "officer" a director of the corporation` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- not an officer of any listed kind, and none of the other heads.
#ASSERT `s 391(3) the person is a person to whom section 391 applies` `s 4(1) "officer" anyone else` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- an auditor employed by a corporation, whether or not an officer.
#ASSERT `s 391(3) the person is a person to whom section 391 applies` `s 4(1) "officer" anyone else` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- an expert: an engineer, a valuer, an accountant, or another whose profession gives authority to a statement.
#ASSERT `s 391(3) the person is a person to whom section 391 applies` `s 4(1) "officer" anyone else` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 391(3) the person is a person to whom section 391 applies` `s 4(1) "officer" anyone else` FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 391(3) the person is a person to whom section 391 applies` `s 4(1) "officer" anyone else` FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 391(3) the person is a person to whom section 391 applies` `s 4(1) "officer" anyone else` FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- a receiver or liquidator appointed or directed by the Court, and any other person so appointed or directed.
#ASSERT `s 391(3) the person is a person to whom section 391 applies` `s 4(1) "officer" a liquidator appointed by the Court or by the creditors` FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 391(3) the person is a person to whom section 391 applies` `s 4(1) "officer" anyone else` FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- a receiver who is not also a manager is not an "officer" (s 4(1) "officer", (d)), and no other head applies.
#ASSERT `s 391(3) the person is a person to whom section 391 applies` `s 4(1) "officer" a receiver who is not also a manager` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (1): every element.
#ASSERT `s 391(1) the court may relieve the person either wholly or partly from the person's liability` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 391(1) the court may relieve the person either wholly or partly from the person's liability` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 391(1) the court may relieve the person either wholly or partly from the person's liability` TRUE FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 391(1) the court may relieve the person either wholly or partly from the person's liability` TRUE TRUE FALSE TRUE TRUE EQUALS NOTHING
-- not honestly and reasonably: both words are needed.
#ASSERT `s 391(1) the court may relieve the person either wholly or partly from the person's liability` TRUE TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 391(1) the court may relieve the person either wholly or partly from the person's liability` TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING
-- (1A): "liability" includes the liability to account for profits.
#ASSERT `s 391(1A) the liability is within the word liability in section 391(1)` TRUE EQUALS JUST TRUE
#ASSERT `s 391(1A) the liability is within the word liability in section 391(1)` FALSE EQUALS NOTHING
-- (2): apply in advance.
#ASSERT `s 391(2) the person may apply to the Court for relief` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 391(2) the person may apply to the Court for relief` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 391(2) the person may apply to the Court for relief` FALSE TRUE EQUALS JUST FALSE

§ `Section 392`

-- (1)
#ASSERT `s 392(1) the matter is within the words procedural irregularity` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 392(1) the matter is within the words procedural irregularity` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 392(1) the matter is within the words procedural irregularity` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 392(1) the matter is within the words procedural irregularity` TRUE TRUE FALSE EQUALS JUST FALSE
-- (2): not invalidated unless the Court is of the opinion and by order declares invalid.
#ASSERT `s 392(2) the proceeding is not invalidated by reason of the procedural irregularity` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 392(2) the proceeding is not invalidated by reason of the procedural irregularity` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 392(2) the proceeding is not invalidated by reason of the procedural irregularity` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 392(2) the proceeding is not invalidated by reason of the procedural irregularity` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 392(2) the proceeding is not invalidated by reason of the procedural irregularity` FALSE TRUE TRUE EQUALS NOTHING
-- (2A)
#ASSERT `s 392(2A) the meeting is not invalidated by reason of the technological disruption, malfunction or outage` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 392(2A) the meeting is not invalidated by reason of the technological disruption, malfunction or outage` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 392(2A) the meeting is not invalidated by reason of the technological disruption, malfunction or outage` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 392(2A) the meeting is not invalidated by reason of the technological disruption, malfunction or outage` FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 392(2A) the meeting is not invalidated by reason of the technological disruption, malfunction or outage` TRUE FALSE FALSE FALSE EQUALS NOTHING
-- (3): omission or non-receipt of notice, unless the Court on the application of one of three persons declares the proceedings void.
#ASSERT `s 392(3) the meeting or its proceedings are not invalidated by reason only of the omission or non-receipt of notice` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 392(3) the meeting or its proceedings are not invalidated by reason only of the omission or non-receipt of notice` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- declared void, but not on the application of the person concerned, a person entitled to attend, or the Registrar.
#ASSERT `s 392(3) the meeting or its proceedings are not invalidated by reason only of the omission or non-receipt of notice` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- invalid for some other reason as well: not "by reason only" of the omission.
#ASSERT `s 392(3) the meeting or its proceedings are not invalidated by reason only of the omission or non-receipt of notice` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 392(3) the meeting or its proceedings are not invalidated by reason only of the omission or non-receipt of notice` FALSE TRUE FALSE FALSE EQUALS NOTHING
-- (6): the bar. Order (4)(a): one of (i) procedural nature, (ii) honest, (iii) public interest, and (c) no substantial injustice.
#ASSERT `s 392(6) the Court is barred from making the order` `s 392(4)(a) an order declaring that an act, matter, thing or proceeding is not invalid by reason of a contravention or failure to comply` TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 392(6) the Court is barred from making the order` `s 392(4)(a) an order declaring that an act, matter, thing or proceeding is not invalid by reason of a contravention or failure to comply` FALSE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 392(6) the Court is barred from making the order` `s 392(4)(a) an order declaring that an act, matter, thing or proceeding is not invalid by reason of a contravention or failure to comply` FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
-- none of (i) to (iii).
#ASSERT `s 392(6) the Court is barred from making the order` `s 392(4)(a) an order declaring that an act, matter, thing or proceeding is not invalid by reason of a contravention or failure to comply` FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- one of (i) to (iii), but substantial injustice is likely.
#ASSERT `s 392(6) the Court is barred from making the order` `s 392(4)(a) an order declaring that an act, matter, thing or proceeding is not invalid by reason of a contravention or failure to comply` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- Order (4)(c): the person subject to the civil liability acted honestly, and (c).
#ASSERT `s 392(6) the Court is barred from making the order` `s 392(4)(c) an order relieving a person from civil liability in respect of a contravention or failure` FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 392(6) the Court is barred from making the order` `s 392(4)(c) an order relieving a person from civil liability in respect of a contravention or failure` TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 392(6) the Court is barred from making the order` `s 392(4)(c) an order relieving a person from civil liability in respect of a contravention or failure` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- Orders (4)(b), (4)(d) and consequential orders: only (c), in every case.
#ASSERT `s 392(6) the Court is barred from making the order` `s 392(4)(b) an order directing the rectification of a register kept by the Registrar` FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 392(6) the Court is barred from making the order` `s 392(4)(b) an order directing the rectification of a register kept by the Registrar` FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 392(6) the Court is barred from making the order` `s 392(4)(d) an order extending or abridging the period for doing an act or taking a proceeding` FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 392(6) the Court is barred from making the order` `s 392(4) a consequential or ancillary order` FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (4): the power, on an interested person's application, subject to (6).
#ASSERT `s 392(4) the Court may make the order on the application of an interested person` `s 392(4)(a) an order declaring that an act, matter, thing or proceeding is not invalid by reason of a contravention or failure to comply` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 392(4) the Court may make the order on the application of an interested person` `s 392(4)(a) an order declaring that an act, matter, thing or proceeding is not invalid by reason of a contravention or failure to comply` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 392(4) the Court may make the order on the application of an interested person` `s 392(4)(a) an order declaring that an act, matter, thing or proceeding is not invalid by reason of a contravention or failure to comply` FALSE TRUE FALSE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 392(4) the Court may make the order on the application of an interested person` `s 392(4)(b) an order directing the rectification of a register kept by the Registrar` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 392(4) the Court may make the order on the application of an interested person` `s 392(4)(c) an order relieving a person from civil liability in respect of a contravention or failure` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (5): an order under (4)(a) or (b) is possible although an offence resulted.
#ASSERT `s 392(5) the fact that the contravention or failure resulted in an offence does not prevent the order` `s 392(4)(a) an order declaring that an act, matter, thing or proceeding is not invalid by reason of a contravention or failure to comply` TRUE EQUALS JUST TRUE
#ASSERT `s 392(5) the fact that the contravention or failure resulted in an offence does not prevent the order` `s 392(4)(b) an order directing the rectification of a register kept by the Registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 392(5) the fact that the contravention or failure resulted in an offence does not prevent the order` `s 392(4)(c) an order relieving a person from civil liability in respect of a contravention or failure` TRUE EQUALS NOTHING
#ASSERT `s 392(5) the fact that the contravention or failure resulted in an offence does not prevent the order` `s 392(4)(d) an order extending or abridging the period for doing an act or taking a proceeding` TRUE EQUALS NOTHING
#ASSERT `s 392(5) the fact that the contravention or failure resulted in an offence does not prevent the order` `s 392(4)(a) an order declaring that an act, matter, thing or proceeding is not invalid by reason of a contravention or failure to comply` FALSE EQUALS NOTHING

§ `Section 394`

#ASSERT `s 394(1) an order of the kind may be made` `s 394(1)(a) an order authorising a person named in it to inspect the books or papers` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 394(1) an order of the kind may be made` `s 394(1)(b) an order requiring the secretary or another officer named in it to produce the books or papers to a person named in it at a place so named` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 394(1) an order of the kind may be made` `s 394(1) some other order` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 394(1) an order of the kind may be made` `s 394(1)(a) an order authorising a person named in it to inspect the books or papers` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 394(1) an order of the kind may be made` `s 394(1)(a) an order authorising a person named in it to inspect the books or papers` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 394(1) an order of the kind may be made` `s 394(1)(a) an order authorising a person named in it to inspect the books or papers` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 394(2) an appeal lies against the order or decision` TRUE EQUALS JUST FALSE
#ASSERT `s 394(2) an appeal lies against the order or decision` FALSE EQUALS NOTHING

§ `Section 399`

#ASSERT `s 399(1) the Court may by order compel an immediate inspection or order the copy to be supplied` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 399(1) the Court may by order compel an immediate inspection or order the copy to be supplied` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 399(1) the Court may by order compel an immediate inspection or order the copy to be supplied` FALSE FALSE EQUALS NOTHING
#ASSERT `s 399(2) the Court may by order require the officer or former officer to do the act, matter or thing immediately or within the time the order allows` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 399(2) the Court may by order require the officer or former officer to do the act, matter or thing immediately or within the time the order allows` TRUE FALSE EQUALS NOTHING
#ASSERT `s 399(2) the Court may by order require the officer or former officer to do the act, matter or thing immediately or within the time the order allows` FALSE TRUE EQUALS NOTHING
#ASSERT `s 399(2) the former officer is deemed to have the same status, powers and duties as at the time the act, matter or thing should have been done` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 399(2) the former officer is deemed to have the same status, powers and duties as at the time the act, matter or thing should have been done` TRUE FALSE EQUALS NOTHING
#ASSERT `s 399(2) the former officer is deemed to have the same status, powers and duties as at the time the act, matter or thing should have been done` FALSE TRUE EQUALS NOTHING

§ `Section 409A`

#ASSERT `s 409A(1) the Court may grant an injunction restraining the person from engaging in the conduct` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 409A(1) the Court may grant an injunction restraining the person from engaging in the conduct` TRUE FALSE TRUE EQUALS JUST TRUE
-- an application by a person whose interests are not affected.
#ASSERT `s 409A(1) the Court may grant an injunction restraining the person from engaging in the conduct` TRUE FALSE FALSE EQUALS NOTHING
-- no conduct contravening the Act: the "Where" gate.
#ASSERT `s 409A(1) the Court may grant an injunction restraining the person from engaging in the conduct` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 409A(2) the Court may grant an injunction requiring the person to do the act or thing` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 409A(2) the Court may grant an injunction requiring the person to do the act or thing` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 409A(2) the Court may grant an injunction requiring the person to do the act or thing` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 409A(2) the Court may grant an injunction requiring the person to do the act or thing` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 409A(3) the Court may grant an interim injunction pending the determination of the application` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 409A(3) the Court may grant an interim injunction pending the determination of the application` TRUE FALSE EQUALS NOTHING
#ASSERT `s 409A(3) the Court may grant an interim injunction pending the determination of the application` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 409A(4) the Court may rescind or vary the injunction` TRUE EQUALS JUST TRUE
#ASSERT `s 409A(4) the Court may rescind or vary the injunction` FALSE EQUALS NOTHING
#ASSERT `s 409A(5) the power of the Court to grant the injunction may be exercised` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 409A(5) the power of the Court to grant the injunction may be exercised` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 409A(5) the power of the Court to grant the injunction may be exercised` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 409A(5) the power of the Court to grant the injunction may be exercised` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 409A(6) the power of the Court to grant the injunction requiring the act or thing may be exercised` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 409A(6) the power of the Court to grant the injunction requiring the act or thing may be exercised` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 409A(6) the power of the Court to grant the injunction requiring the act or thing may be exercised` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 409A(6) the power of the Court to grant the injunction requiring the act or thing may be exercised` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 409A(7) the Court is barred from requiring the undertaking as to damages` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 409A(7) the Court is barred from requiring the undertaking as to damages` TRUE FALSE EQUALS NOTHING
#ASSERT `s 409A(7) the Court is barred from requiring the undertaking as to damages` FALSE TRUE EQUALS NOTHING
-- EXPECT BREACH
#TRACE `s 409A(7) the Court must not require an undertaking as to damages on the Registrar's application` AT 0 WITH
    PARTY Court DOES `s 409A(7) require an undertaking as to damages as a condition of granting an interim injunction` AT 1
-- EXPECT RESIDUAL
#TRACE `s 409A(7) the Court must not require an undertaking as to damages on the Registrar's application` AT 0 WITH
    WAITUNTIL 3
#ASSERT `s 409A(8) the Court may order the person to pay damages to any other person, in addition to or in substitution for the injunction` TRUE EQUALS JUST TRUE
#ASSERT `s 409A(8) the Court may order the person to pay damages to any other person, in addition to or in substitution for the injunction` FALSE EQUALS JUST FALSE

§ `Section 409C`

#ASSERT `s 409C(3) section 409C does not apply to the act or decision of the Registrar` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 409C(3) section 409C does not apply to the act or decision of the Registrar` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 409C(3) section 409C does not apply to the act or decision of the Registrar` FALSE FALSE EQUALS NOTHING
-- decision on 1 March 2025: 28 days after it ends on 29 March 2025.
#ASSERT `s 409C(1) the party may appeal to the Court against the act or decision` TRUE FALSE FALSE (Date 1 3 2025) (Date 29 3 2025) EQUALS JUST TRUE
#ASSERT `s 409C(1) the party may appeal to the Court against the act or decision` TRUE FALSE FALSE (Date 1 3 2025) (Date 30 3 2025) EQUALS JUST FALSE
#ASSERT `s 409C(1) the party may appeal to the Court against the act or decision` TRUE FALSE FALSE (Date 1 3 2025) (Date 2 3 2025) EQUALS JUST TRUE
-- the day of the decision itself is not "within 28 days after" it (sg-periods P2, fork F-409C-1).
#ASSERT `s 409C(1) the party may appeal to the Court against the act or decision` TRUE FALSE FALSE (Date 1 3 2025) (Date 1 3 2025) EQUALS JUST FALSE
-- not aggrieved.
#ASSERT `s 409C(1) the party may appeal to the Court against the act or decision` FALSE FALSE FALSE (Date 1 3 2025) (Date 5 3 2025) EQUALS NOTHING
-- subsection (3): an appeal or review is provided elsewhere, or the decision is conclusive.
#ASSERT `s 409C(1) the party may appeal to the Court against the act or decision` TRUE TRUE FALSE (Date 1 3 2025) (Date 5 3 2025) EQUALS JUST FALSE
#ASSERT `s 409C(1) the party may appeal to the Court against the act or decision` TRUE FALSE TRUE (Date 1 3 2025) (Date 5 3 2025) EQUALS JUST FALSE
#ASSERT `s 409C(2) the Court may confirm the act or decision, give such directions in the matter as seem proper, or otherwise determine the matter` TRUE EQUALS JUST TRUE
#ASSERT `s 409C(2) the Court may confirm the act or decision, give such directions in the matter as seem proper, or otherwise determine the matter` FALSE EQUALS NOTHING
