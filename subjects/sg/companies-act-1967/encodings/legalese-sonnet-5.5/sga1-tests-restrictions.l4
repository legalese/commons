IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sga1-restrictions`

-- Tests for sga1-restrictions.l4 (ss 59 to 62). Every expected value is written from the text of the section, beside the assertion.
-- Arguments are positional, in the order of each function's GIVEN.

§ `Section 59(1): the bar on allotment`

-- Arguments: public company; has a share capital; issued a prospectus on formation; SILP lodged; SILP complies; day lodged; day of the first allotment.
-- "at least 3 days before the first allotment": lodged on the 10th, first allotment on the 13th is 3 days before (not barred); lodged on the 11th is 2 days before (barred).
#ASSERT `s 59(1) the company is barred from allotting shares or debentures` TRUE TRUE FALSE TRUE TRUE (Date 10 1 2026) (Date 13 1 2026) EQUALS JUST FALSE
#ASSERT `s 59(1) the company is barred from allotting shares or debentures` TRUE TRUE FALSE TRUE TRUE (Date 11 1 2026) (Date 13 1 2026) EQUALS JUST TRUE
#ASSERT `s 59(1) the company is barred from allotting shares or debentures` TRUE TRUE FALSE TRUE TRUE (Date 1 1 2026) (Date 13 1 2026) EQUALS JUST FALSE
-- no statement lodged: barred
#ASSERT `s 59(1) the company is barred from allotting shares or debentures` TRUE TRUE FALSE FALSE FALSE (Date 1 1 2026) (Date 13 1 2026) EQUALS JUST TRUE
-- lodged in time but the statement does not comply with the requirements of the Act: barred
#ASSERT `s 59(1) the company is barred from allotting shares or debentures` TRUE TRUE FALSE TRUE FALSE (Date 1 1 2026) (Date 13 1 2026) EQUALS JUST TRUE
-- outside the description: a private company, a company with no share capital, a company that issued a prospectus on formation: not covered
#ASSERT `s 59(1) the company is barred from allotting shares or debentures` FALSE TRUE FALSE FALSE FALSE (Date 1 1 2026) (Date 13 1 2026) EQUALS NOTHING
#ASSERT `s 59(1) the company is barred from allotting shares or debentures` TRUE FALSE FALSE FALSE FALSE (Date 1 1 2026) (Date 13 1 2026) EQUALS NOTHING
#ASSERT `s 59(1) the company is barred from allotting shares or debentures` TRUE TRUE TRUE FALSE FALSE (Date 1 1 2026) (Date 13 1 2026) EQUALS NOTHING

-- The prohibition: allotting without the statement is a breach; no act leaves the prohibition standing (RESIDUAL, not a pass).
-- EXPECT BREACH
#TRACE `s 59(1) a public company must not allot without a statement in lieu of prospectus` "Acme Public Ltd" AT 0 WITH
    PARTY Company "Acme Public Ltd" DOES `s 59(1) allot shares or debentures without a complying statement in lieu of prospectus lodged at least 3 days before the first allotment` AT 1

-- EXPECT RESIDUAL
#TRACE `s 59(1) a public company must not allot without a statement in lieu of prospectus` "Acme Public Ltd" AT 0 WITH

§ `Section 59(2): the offence of default`

-- Arguments: default made; the person is the company; the person is an officer in default.
#ASSERT `s 59(2) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 59(2) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 59(2) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 59(2) the person is guilty of the offence this subsection creates` FALSE TRUE TRUE EQUALS JUST FALSE
-- penalty: a fine not exceeding $5,000 or imprisonment for a term not exceeding 12 months; no "or both"; no default penalty
#ASSERT `s 59(2) the most the person may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (`s 59(2) penalty` OF 5000, 12, FALSE, FALSE, 0)
#ASSERT `s 59(2) the most the person may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 59(2) the most the person may be sentenced to on conviction` FALSE TRUE FALSE EQUALS NOTHING

§ `Section 59(3): the director who knowingly contravenes, permits or authorises`

-- Arguments: is a director; knowingly contravened; knowingly permitted; knowingly authorised.
#ASSERT `s 59(3)(a) the director is guilty of an offence` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 59(3)(a) the director is guilty of an offence` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 59(3)(a) the director is guilty of an offence` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 59(3)(a) the director is guilty of an offence` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 59(3)(a) the director is guilty of an offence` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- no penalty is stated in the subsection
#ASSERT `s 59(3)(a) the highest fine for the offence` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- (b): the director compensates the company and the allottee respectively for what each sustained
#ASSERT `s 59(3)(b) what the director is liable to compensate` TRUE FALSE TRUE FALSE 1200 300 EQUALS JUST (`s 59(3)(b) compensation` OF 1200, 300)
#ASSERT `s 59(3)(b) what the director is liable to compensate` FALSE TRUE TRUE TRUE 1200 300 EQUALS NOTHING

§ `Section 59(4): the two years`

-- Arguments: the proceedings are for the compensation in (3)(b); day of the allotment; day the proceedings are commenced.
-- allotment on 10 June 2024: "after the expiration of 2 years from the date of the allotment": the last day of the 2 years is 10 June 2026.
#ASSERT `s 59(4) the proceedings are barred by the time limit` TRUE (Date 10 6 2024) (Date 10 6 2026) EQUALS JUST FALSE
#ASSERT `s 59(4) the proceedings are barred by the time limit` TRUE (Date 10 6 2024) (Date 11 6 2026) EQUALS JUST TRUE
#ASSERT `s 59(4) the proceedings are barred by the time limit` TRUE (Date 10 6 2024) (Date 1 3 2025) EQUALS JUST FALSE
-- other proceedings are not covered
#ASSERT `s 59(4) the proceedings are barred by the time limit` FALSE (Date 10 6 2024) (Date 11 6 2030) EQUALS NOTHING
-- leap day: allotment on 29 February 2024; two years later is 28 February 2026 (daydate clamps, keel convention P4)
#ASSERT `s 59(4) the proceedings are barred by the time limit` TRUE (Date 29 2 2024) (Date 28 2 2026) EQUALS JUST FALSE
#ASSERT `s 59(4) the proceedings are barred by the time limit` TRUE (Date 29 2 2024) (Date 1 3 2026) EQUALS JUST TRUE

§ `Section 60(1): what a statement in lieu of prospectus must be`

-- (a) Arguments: persons named; persons who signed; persons for whom an authorised agent signed.
#ASSERT `s 60(1)(a) the statement in lieu of prospectus is signed as the paragraph requires` 3 3 0 EQUALS JUST TRUE
#ASSERT `s 60(1)(a) the statement in lieu of prospectus is signed as the paragraph requires` 3 2 1 EQUALS JUST TRUE
#ASSERT `s 60(1)(a) the statement in lieu of prospectus is signed as the paragraph requires` 3 2 0 EQUALS JUST FALSE
#ASSERT `s 60(1)(a) the statement in lieu of prospectus is signed as the paragraph requires` 3 0 3 EQUALS JUST TRUE
-- (b) Arguments: in the form of Part 1; states the matters of Part 1; sets out the reports of Part 2.
#ASSERT `s 60(1)(b) the statement in lieu of prospectus is in the form and has the contents the paragraph requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 60(1)(b) the statement in lieu of prospectus is in the form and has the contents the paragraph requires` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 60(1)(b) the statement in lieu of prospectus is in the form and has the contents the paragraph requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 60(1)(b) the statement in lieu of prospectus is in the form and has the contents the paragraph requires` TRUE FALSE TRUE EQUALS JUST FALSE
-- (c) Arguments: adjustments made or indicated without reasons; a written statement signed by the report makers is attached.
#ASSERT `s 60(1)(c) the statement in lieu of prospectus has the written statement of adjustments the paragraph requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 60(1)(c) the statement in lieu of prospectus has the written statement of adjustments the paragraph requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 60(1)(c) the statement in lieu of prospectus has the written statement of adjustments the paragraph requires` FALSE FALSE EQUALS JUST TRUE
-- as a whole
#ASSERT `s 60(1) the statement in lieu of prospectus meets the three requirements of subsection (1)` (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 60(1) the statement in lieu of prospectus meets the three requirements of subsection (1)` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 60(1) the statement in lieu of prospectus meets the three requirements of subsection (1)` (JUST TRUE) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 60(1) the statement in lieu of prospectus meets the three requirements of subsection (1)` (JUST FALSE) NOTHING (JUST TRUE) EQUALS NOTHING

§ `Section 60(2): the Registrar's bar`

#ASSERT `s 60(2) the Registrar is barred from accepting the statement in lieu of prospectus for registration` TRUE EQUALS JUST FALSE
#ASSERT `s 60(2) the Registrar is barred from accepting the statement in lieu of prospectus for registration` FALSE EQUALS JUST TRUE

§ `Section 60(3): an untrue statement or wilful non-disclosure`

-- untrue: untrue in fact, or deemed untrue by s 4(3) (a misleading statement included in the statement in lieu of prospectus)
#ASSERT `s 60(3) the statement in lieu of prospectus contains an untrue statement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 60(3) the statement in lieu of prospectus contains an untrue statement` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 60(3) the statement in lieu of prospectus contains an untrue statement` FALSE FALSE EQUALS JUST FALSE
-- the defence: proves immaterial; or reasonable ground to believe and did believe up to delivery for registration. Arguments: immaterial; reasonable ground; did believe.
#ASSERT `s 60(3) the section gives the director a defence on these facts` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 60(3) the section gives the director a defence on these facts` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 60(3) the section gives the director a defence on these facts` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 60(3) the section gives the director a defence on these facts` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 60(3) the section gives the director a defence on these facts` FALSE FALSE FALSE EQUALS JUST FALSE
-- guilty. Arguments: a director who signed; an untrue statement; a wilful non-disclosure; the section gives a defence.
#ASSERT `s 60(3) the director is guilty of the offence this subsection creates` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 60(3) the director is guilty of the offence this subsection creates` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 60(3) the director is guilty of the offence this subsection creates` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 60(3) the director is guilty of the offence this subsection creates` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 60(3) the director is guilty of the offence this subsection creates` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- penalty: fine not exceeding $5,000 or imprisonment not exceeding 12 months or both
#ASSERT `s 60(3) the most the director may be sentenced to on conviction` TRUE TRUE FALSE FALSE EQUALS JUST (`s 60(3) penalty` OF 5000, 12, TRUE)
#ASSERT `s 60(3) the most the director may be sentenced to on conviction` TRUE TRUE FALSE TRUE EQUALS NOTHING

§ `Section 61(1): a company that issued a prospectus`

-- (b)(i): the minimum subscription is the amount the prospectus states; shares held subject to payment of the whole amount in cash allotted must be not less. Boundary: 500000 against 500000 and 499999.
#ASSERT `s 61(1)(b)(i) the amount allotted is not less than the minimum subscription` 500000 500000
#ASSERT `s 61(1)(b)(i) the amount allotted is not less than the minimum subscription` 600000 500000
#ASSERT (NOT `s 61(1)(b)(i) the amount allotted is not less than the minimum subscription` 499999 500000)
-- Arguments: share capital; issued a prospectus; money repayable by reason of a failure to get a listing; amount allotted in cash; minimum subscription; every director has paid;
-- declaration lodged; made by the secretary or a director; made by a registered qualified individual.
-- everything in order: the unless is met, no bar
#ASSERT `s 61(1) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE 500000 500000 TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 61(1) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE 500000 500000 TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- (a): money may become repayable for want of a listing: barred, whatever else is done
#ASSERT `s 61(1) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE TRUE 500000 500000 TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- (b)(i) not met
#ASSERT `s 61(1) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE 499999 500000 TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- (b)(ii) not met
#ASSERT `s 61(1) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE 500000 500000 FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- (b)(iii) not met: no declaration lodged
#ASSERT `s 61(1) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE 500000 500000 TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- (b)(iii) declaration lodged but by neither of the persons named
#ASSERT `s 61(1) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE 500000 500000 TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- the "Where" gate fails: no share capital, or no prospectus inviting the public
#ASSERT `s 61(1) the company is barred from commencing business or exercising a borrowing power` FALSE TRUE FALSE 0 0 FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 61(1) the company is barred from commencing business or exercising a borrowing power` TRUE FALSE FALSE 0 0 FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- the prohibition and its breach path
-- EXPECT BREACH
#TRACE `s 61(1) a company that issued a prospectus must not commence business before the conditions are met` "Acme Public Ltd" AT 0 WITH
    PARTY Company "Acme Public Ltd" DOES `s 61(1) commence business or exercise a borrowing power before the conditions of paragraph (b) are met` AT 1

-- EXPECT RESIDUAL
#TRACE `s 61(1) a company that issued a prospectus must not commence business before the conditions are met` "Acme Public Ltd" AT 0 WITH

§ `Section 61(2): a public company with no prospectus`

-- Arguments: public company; share capital; issued a prospectus; SILP lodged; SILP complies; every director has paid; declaration lodged; secretary or a director; registered qualified individual.
#ASSERT `s 61(2) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 61(2) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE TRUE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- (a) not met: no statement lodged
#ASSERT `s 61(2) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- (a) not met: the statement does not comply
#ASSERT `s 61(2) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE TRUE FALSE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- (b) not met
#ASSERT `s 61(2) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE TRUE TRUE FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- (c) not met: no declaration; or a declaration by a person not named
#ASSERT `s 61(2) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE TRUE TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(2) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE FALSE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- the "Where" gate fails: a private company; no share capital; a prospectus was issued
#ASSERT `s 61(2) the company is barred from commencing business or exercising a borrowing power` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 61(2) the company is barred from commencing business or exercising a borrowing power` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 61(2) the company is barred from commencing business or exercising a borrowing power` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- EXPECT BREACH
#TRACE `s 61(2) a public company without a prospectus must not commence business before the conditions are met` "Acme Public Ltd" AT 0 WITH
    PARTY Company "Acme Public Ltd" DOES `s 61(2) commence business or exercise a borrowing power before the conditions of paragraph (a) to (c) are met` AT 5

-- EXPECT RESIDUAL
#TRACE `s 61(2) a public company without a prospectus must not commence business before the conditions are met` "Acme Public Ltd" AT 0 WITH

§ `Section 61(3) to (7)`

#ASSERT `s 61(3) the Registrar must issue the notice that the company is entitled to commence business` TRUE EQUALS JUST TRUE
#ASSERT `s 61(3) the Registrar must issue the notice that the company is entitled to commence business` FALSE EQUALS JUST FALSE
#ASSERT `s 61(3) the notice is conclusive evidence of the matters stated in it` TRUE EQUALS JUST TRUE
#ASSERT `s 61(3) the notice is conclusive evidence of the matters stated in it` FALSE EQUALS NOTHING
-- (4) Arguments: the contract was made before the date the company is entitled to commence business; the day asked; the date entitled.
#ASSERT `s 61(4) the contract is provisional only and not yet binding on the company` TRUE (Date 1 3 2026) (Date 2 3 2026) EQUALS JUST TRUE
#ASSERT `s 61(4) the contract is provisional only and not yet binding on the company` TRUE (Date 2 3 2026) (Date 2 3 2026) EQUALS JUST FALSE
#ASSERT `s 61(4) the contract is provisional only and not yet binding on the company` TRUE (Date 3 3 2026) (Date 2 3 2026) EQUALS JUST FALSE
#ASSERT `s 61(4) the contract is provisional only and not yet binding on the company` FALSE (Date 1 3 2026) (Date 2 3 2026) EQUALS NOTHING
-- (5)
#ASSERT `s 61(5) section 61 prevents the company from receiving the money` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 61(5) section 61 prevents the company from receiving the money` TRUE FALSE EQUALS NOTHING
#ASSERT `s 61(5) section 61 prevents the company from receiving the money` FALSE TRUE EQUALS NOTHING
-- (6) Arguments: the company commenced business in contravention; the person is responsible.
#ASSERT `s 61(6) the person is guilty of the offence this subsection creates` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 61(6) the person is guilty of the offence this subsection creates` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 61(6) the person is guilty of the offence this subsection creates` FALSE TRUE EQUALS JUST FALSE
-- a fine not exceeding $4,000 and a default penalty of $250; no imprisonment
#ASSERT `s 61(6) the most the person may be sentenced to on conviction` TRUE TRUE EQUALS JUST (`s 61(6) penalty` OF 4000, 0, FALSE, TRUE, 250)
#ASSERT `s 61(6) the most the person may be sentenced to on conviction` TRUE FALSE EQUALS NOTHING
-- (7) Arguments: received a notice; applied; paid the prescribed fee.
#ASSERT `s 61(7) the Registrar must issue the certificate that the company is entitled to commence business` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 61(7) the Registrar must issue the certificate that the company is entitled to commence business` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 61(7) the Registrar must issue the certificate that the company is entitled to commence business` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 61(7) the Registrar must issue the certificate that the company is entitled to commence business` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 61(7) the certificate is conclusive evidence of the matters stated in it` TRUE EQUALS JUST TRUE
#ASSERT `s 61(7) the certificate is conclusive evidence of the matters stated in it` FALSE EQUALS NOTHING

§ `Section 62: varying a contract referred to in the prospectus`

-- Arguments: the contract is referred to in the prospectus or the statement in lieu of prospectus; the variation is made before the statutory meeting; made subject to the meeting's approval.
#ASSERT `s 62 the company is barred from varying the terms of the contract` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 62 the company is barred from varying the terms of the contract` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 62 the company is barred from varying the terms of the contract` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 62 the company is barred from varying the terms of the contract` FALSE TRUE FALSE EQUALS NOTHING

-- EXPECT BREACH
#TRACE `s 62 a company must not vary the terms of a contract referred to in the prospectus before the statutory meeting` "Acme Public Ltd" AT 0 WITH
    PARTY Company "Acme Public Ltd" DOES `s 62 vary the terms of a contract referred to in the prospectus before the statutory meeting without making the variation subject to its approval` AT 3

-- EXPECT RESIDUAL
#TRACE `s 62 a company must not vary the terms of a contract referred to in the prospectus before the statutory meeting` "Acme Public Ltd" AT 0 WITH
