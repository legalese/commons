IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sga3-77-78`

-- Tests for sga3-77-78.l4 (ss 77 and 78; lines 9244-9296 of inputs/CoA1967.txt). Every expected value is decided from the text before the run.

-- ===== s 77 =====
#ASSERT `s 77(1A) the day 18 November 1998` EQUALS Date 18 11 1998
-- (2) the option of holders of debentures to take up shares by way of redemption is outside (1) and (1A): a flat negative.
#ASSERT `s 77(2) subsection (1) or (1A) applies to the option` TRUE EQUALS JUST FALSE
#ASSERT `s 77(2) subsection (1) or (1A) applies to the option` FALSE EQUALS NOTHING
-- (1) an option granted after 29 December 1967 by a public company that enables any person to take up unissued shares after 5 years from the grant is void.
-- Inputs in order: public company; the date granted; the last day the option can be exercised; an employee option; a debenture-holders' option.
-- Granted 1 January 1990: 5 years end on 1 January 1995. Exercisable on 2 January 1995: void. On 1 January 1995: not void.
#ASSERT `s 77(1) the option is void under subsection (1)` TRUE (Date 1 1 1990) (Date 2 1 1995) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 77(1) the option is void under subsection (1)` TRUE (Date 1 1 1990) (Date 1 1 1995) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 77(1) the option is void under subsection (1)` TRUE (Date 1 1 1990) (Date 1 1 1992) FALSE FALSE EQUALS JUST FALSE
-- Not a public company, or granted on or before 29 December 1967: outside the subsection.
#ASSERT `s 77(1) the option is void under subsection (1)` FALSE (Date 1 1 1990) (Date 2 1 1995) FALSE FALSE EQUALS NOTHING
#ASSERT `s 77(1) the option is void under subsection (1)` TRUE (Date 29 12 1967) (Date 29 12 1980) FALSE FALSE EQUALS NOTHING
#ASSERT `s 77(1) the option is void under subsection (1)` TRUE (Date 30 12 1967) (Date 30 12 1980) FALSE FALSE EQUALS JUST TRUE
-- An employee option granted on or after 18 November 1998 is dealt with by (1A): subsection (1) does not apply to it. Granted on 17 November 1998, (1) still does.
#ASSERT `s 77(1) the option is void under subsection (1)` TRUE (Date 18 11 1998) (Date 19 11 2003) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 77(1) the option is void under subsection (1)` TRUE (Date 17 11 1998) (Date 18 11 2003) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 77(1) the option is void under subsection (1)` TRUE (Date 18 11 1998) (Date 19 11 2003) FALSE FALSE EQUALS JUST TRUE
-- (2) an option of debenture holders: not void.
#ASSERT `s 77(1) the option is void under subsection (1)` TRUE (Date 1 1 1990) (Date 2 1 1995) FALSE TRUE EQUALS JUST FALSE
-- (1A) an option granted on or after 18 November 1998 by a public company to an employee that can be exercised after 10 years from the grant is void.
#ASSERT `s 77(1A) the option is void under subsection (1A)` TRUE (Date 18 11 1998) (Date 19 11 2008) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 77(1A) the option is void under subsection (1A)` TRUE (Date 18 11 1998) (Date 18 11 2008) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 77(1A) the option is void under subsection (1A)` TRUE (Date 18 11 1998) (Date 18 11 2003) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 77(1A) the option is void under subsection (1A)` TRUE (Date 17 11 1998) (Date 19 11 2008) TRUE FALSE EQUALS NOTHING
#ASSERT `s 77(1A) the option is void under subsection (1A)` FALSE (Date 18 11 1998) (Date 19 11 2008) TRUE FALSE EQUALS NOTHING
#ASSERT `s 77(1A) the option is void under subsection (1A)` TRUE (Date 18 11 1998) (Date 19 11 2008) FALSE FALSE EQUALS NOTHING
#ASSERT `s 77(1A) the option is void under subsection (1A)` TRUE (Date 18 11 1998) (Date 19 11 2008) TRUE TRUE EQUALS JUST FALSE

-- ===== s 78 =====
-- The opening words: interest on so much of the share capital (except treasury shares) as is for the time being paid up, where the shares were issued to raise money for works that cannot be made profitable for a long period: 1,000 paid up, 100 held as treasury shares -> 900.
#ASSERT `s 78 the amount of share capital on which the company may pay interest` TRUE 1000 100 EQUALS JUST 900
#ASSERT `s 78 the amount of share capital on which the company may pay interest` TRUE 1000 0 EQUALS JUST 1000
#ASSERT `s 78 the amount of share capital on which the company may pay interest` FALSE 1000 100 EQUALS NOTHING
-- (a) "no such payment may be made unless it is authorised, by the constitution or by special resolution, and is approved by the Court": a bar.
#ASSERT `s 78(a) the payment of interest out of capital is barred` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 78(a) the payment of interest out of capital is barred` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 78(a) the payment of interest out of capital is barred` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 78(a) the payment of interest out of capital is barred` TRUE FALSE FALSE EQUALS JUST TRUE
-- (b) the Court may, before approving, appoint a person to inquire and report at the company's expense, and require security for the costs.
#ASSERT `s 78(b) the expense of the inquiry falls on the company` TRUE EQUALS JUST TRUE
#ASSERT `s 78(b) the expense of the inquiry falls on the company` FALSE EQUALS NOTHING
#ASSERT `s 78(b) the company may be required to give security for the costs of the inquiry` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 78(b) the company may be required to give security for the costs of the inquiry` TRUE TRUE EQUALS NOTHING
#ASSERT `s 78(b) the company may be required to give security for the costs of the inquiry` FALSE FALSE EQUALS NOTHING
-- (c) the payment is made only for the period the Court determines, never beyond 12 months after the works are completed or the plant provided: completed 1 March 2026 -> 1 March 2027.
#ASSERT `s 78(c) the last day to which the payment may be made` (Date 1 1 2027) (Date 1 3 2026) EQUALS Date 1 1 2027
#ASSERT `s 78(c) the last day to which the payment may be made` (Date 1 3 2027) (Date 1 3 2026) EQUALS Date 1 3 2027
#ASSERT `s 78(c) the last day to which the payment may be made` (Date 2 3 2027) (Date 1 3 2026) EQUALS Date 1 3 2027
-- (d) the rate must in no case exceed 5% per annum or such other rate as is for the time being prescribed.
#ASSERT `s 78(d) the rate of interest exceeds the limit` 5 FALSE 0 EQUALS JUST FALSE
#ASSERT `s 78(d) the rate of interest exceeds the limit` 5.01 FALSE 0 EQUALS JUST TRUE
#ASSERT `s 78(d) the rate of interest exceeds the limit` 6 TRUE 6 EQUALS JUST FALSE
#ASSERT `s 78(d) the rate of interest exceeds the limit` 6.01 TRUE 6 EQUALS JUST TRUE
#ASSERT `s 78(d) the rate of interest exceeds the limit` 4 TRUE 3 EQUALS JUST TRUE
-- (e) the payment of the interest does not operate as a reduction of the amount paid up on the shares.
#ASSERT `s 78(e) the payment of the interest operates as a reduction of the amount paid up on the shares in respect of which it is paid` TRUE EQUALS JUST FALSE
#ASSERT `s 78(e) the payment of the interest operates as a reduction of the amount paid up on the shares in respect of which it is paid` FALSE EQUALS NOTHING
-- The grant as a whole: purpose, authority and approval, rate within the limit, and a period within the Court's.
#ASSERT `s 78 the company may pay interest on the paid-up share capital and charge it to capital as part of the cost` TRUE TRUE FALSE TRUE 5 FALSE 0 TRUE EQUALS JUST TRUE
#ASSERT `s 78 the company may pay interest on the paid-up share capital and charge it to capital as part of the cost` FALSE TRUE FALSE TRUE 5 FALSE 0 TRUE EQUALS NOTHING
#ASSERT `s 78 the company may pay interest on the paid-up share capital and charge it to capital as part of the cost` TRUE FALSE FALSE TRUE 5 FALSE 0 TRUE EQUALS NOTHING
#ASSERT `s 78 the company may pay interest on the paid-up share capital and charge it to capital as part of the cost` TRUE TRUE FALSE FALSE 5 FALSE 0 TRUE EQUALS NOTHING
#ASSERT `s 78 the company may pay interest on the paid-up share capital and charge it to capital as part of the cost` TRUE TRUE FALSE TRUE 5.5 FALSE 0 TRUE EQUALS NOTHING
#ASSERT `s 78 the company may pay interest on the paid-up share capital and charge it to capital as part of the cost` TRUE TRUE FALSE TRUE 5 FALSE 0 FALSE EQUALS NOTHING
