IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sga3-76h-76k`

-- Tests for sga3-76h-76k.l4 (ss 76H, 76I, 76J, 76K; lines 9051-9242 of inputs/CoA1967.txt). Every expected value is decided from the text before the run.

-- ===== s 76H =====
-- (1) applies where ordinary shares or stocks are purchased or otherwise acquired in accordance with sections 76B to 76G.
#ASSERT `s 76H(1) section 76H applies to the shares or stocks` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76H(1) section 76H applies to the shares or stocks` TRUE FALSE EQUALS NOTHING
#ASSERT `s 76H(1) section 76H applies to the shares or stocks` FALSE TRUE EQUALS NOTHING
#ASSERT `s 76H(1)(a) the company may hold the shares or stocks` TRUE EQUALS JUST TRUE
#ASSERT `s 76H(1)(a) the company may hold the shares or stocks` FALSE EQUALS NOTHING
#ASSERT `s 76H(1)(b) the company may deal with the shares or stocks, at any time, in accordance with section 76K` TRUE EQUALS JUST TRUE
#ASSERT `s 76H(1)(b) the company may deal with the shares or stocks, at any time, in accordance with section 76K` FALSE EQUALS NOTHING
#ASSERT `s 76H(2) the company is entered in the register as the member holding the shares or stocks` TRUE EQUALS JUST TRUE
#ASSERT `s 76H(2) the company is entered in the register as the member holding the shares or stocks` FALSE EQUALS NOTHING

-- ===== s 76I =====
-- (1) a company with one class of shares: treasury shares must not at any time exceed 10% of the total number of shares. 100 of 1,000 is 10%: allowed. 101 exceeds.
#ASSERT `s 76I(1) the number of shares held as treasury shares exceeds the limit` TRUE 100 1000 EQUALS JUST FALSE
#ASSERT `s 76I(1) the number of shares held as treasury shares exceeds the limit` TRUE 101 1000 EQUALS JUST TRUE
#ASSERT `s 76I(1) the number of shares held as treasury shares exceeds the limit` TRUE 0 1000 EQUALS JUST FALSE
#ASSERT `s 76I(1) the number of shares held as treasury shares exceeds the limit` FALSE 500 1000 EQUALS JUST FALSE
-- (2) a company with shares of different classes: the same 10% for each class.
#ASSERT `s 76I(2) the number of shares of the class held as treasury shares exceeds the limit` TRUE 50 500 EQUALS JUST FALSE
#ASSERT `s 76I(2) the number of shares of the class held as treasury shares exceeds the limit` TRUE 51 500 EQUALS JUST TRUE
#ASSERT `s 76I(2) the number of shares of the class held as treasury shares exceeds the limit` FALSE 51 500 EQUALS JUST FALSE
-- (4) the excess shares are the shares above 10% (the largest whole number of shares within 10%): 10% of 1,000 is 100; 101 -> 1 excess; 100 -> 0.
#ASSERT `s 76I(4) the number of the excess shares` 101 1000 EQUALS 1
#ASSERT `s 76I(4) the number of the excess shares` 100 1000 EQUALS 0
#ASSERT `s 76I(4) the number of the excess shares` 150 1000 EQUALS 50
#ASSERT `s 76I(4) the number of the excess shares` 6 55 EQUALS 1
#ASSERT `s 76I(4) the number of the excess shares` 5 55 EQUALS 0
#ASSERT `s 76I(4) the number of the excess shares` 0 1000 EQUALS 0
-- (3) the 6 months beginning with the day of the contravention: 15 January 2026 -> last day 14 July 2026 (the day named is day 1).
#ASSERT `s 76I(3) the last day of the 6 months beginning with the day on which the contravention occurs` (Date 15 1 2026) EQUALS Date 14 7 2026
#ASSERT `s 76I(3) the last day of the 6 months beginning with the day on which the contravention occurs` (Date 31 8 2026) EQUALS Date 28 2 2027
-- A month with no such date: 31 December 2026 begins 6 months that end on the last day of June (30 June 2027); a date that exists in the later month steps back one day (28 February 2026 -> 27 August 2026).
#ASSERT `s 76I(3) the last day of the 6 months beginning with the day on which the contravention occurs` (Date 31 12 2026) EQUALS Date 30 6 2027
#ASSERT `s 76I(3) the last day of the 6 months beginning with the day on which the contravention occurs` (Date 28 2 2026) EQUALS Date 27 8 2026
-- (3) or the further period the Registrar allows.
#ASSERT `s 76I(3) the last day for the company to dispose of or cancel the excess shares` (Date 15 1 2026) FALSE (Date 1 1 2020) EQUALS Date 14 7 2026
#ASSERT `s 76I(3) the last day for the company to dispose of or cancel the excess shares` (Date 15 1 2026) TRUE (Date 31 12 2026) EQUALS Date 31 12 2026
#ASSERT `s 76I(3) the company has disposed of or cancelled the excess shares in time` (Date 15 1 2026) FALSE (Date 1 1 2020) TRUE (Date 14 7 2026) EQUALS JUST TRUE
#ASSERT `s 76I(3) the company has disposed of or cancelled the excess shares in time` (Date 15 1 2026) FALSE (Date 1 1 2020) TRUE (Date 15 7 2026) EQUALS JUST FALSE
#ASSERT `s 76I(3) the company has disposed of or cancelled the excess shares in time` (Date 15 1 2026) TRUE (Date 31 12 2026) TRUE (Date 15 7 2026) EQUALS JUST TRUE
#ASSERT `s 76I(3) the company has disposed of or cancelled the excess shares in time` (Date 15 1 2026) FALSE (Date 1 1 2020) FALSE (Date 1 2 2026) EQUALS JUST FALSE
-- The rule: day 0 is the day of the contravention; the number of days is taken from the date computed above: 15 Jan to 14 Jul 2026 is 180 days.
-- EXPECT FULFILLED
#TRACE `s 76I(3) the company must dispose of or cancel the excess shares before the end of the period` "Acme Pte Ltd" 180 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 76I(3) dispose of or cancel the excess shares in accordance with section 76K` AT 180
-- EXPECT BREACH
#TRACE `s 76I(3) the company must dispose of or cancel the excess shares before the end of the period` "Acme Pte Ltd" 180 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 76I(3) dispose of or cancel the excess shares in accordance with section 76K` AT 181
-- EXPECT BREACH
#TRACE `s 76I(3) the company must dispose of or cancel the excess shares before the end of the period` "Acme Pte Ltd" 180 AT 0 WITH
    (WAITUNTIL 181)

-- ===== s 76J =====
-- (2) the company's purported exercise of a right in respect of treasury shares is void.
#ASSERT `s 76J(2) the purported exercise by the company of a right in respect of the treasury shares is void` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76J(2) the purported exercise by the company of a right in respect of the treasury shares is void` TRUE FALSE EQUALS NOTHING
#ASSERT `s 76J(2) the purported exercise by the company of a right in respect of the treasury shares is void` FALSE TRUE EQUALS NOTHING
-- (3) the company has no right to vote on the treasury shares (a flat negative).
#ASSERT `s 76J(3) the company has a right to vote on the treasury shares` TRUE EQUALS JUST FALSE
#ASSERT `s 76J(3) the company has a right to vote on the treasury shares` FALSE EQUALS NOTHING
-- (4) no dividend or other distribution may be paid to the company in respect of the treasury shares.
#ASSERT `s 76J(4) the dividend or distribution to the company in respect of the treasury shares is barred` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76J(4) the dividend or distribution to the company in respect of the treasury shares is barred` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 76J(4) the dividend or distribution to the company in respect of the treasury shares is barred` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 76J(4) the dividend or distribution to the company in respect of the treasury shares is barred` FALSE TRUE TRUE EQUALS NOTHING
-- (5) nothing prevents an allotment of fully paid bonus shares, or a subdivision or consolidation that leaves the total value of the shares the same.
#ASSERT `s 76J(5) section 76J prevents the allotment, the subdivision or the consolidation` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 76J(5) section 76J prevents the allotment, the subdivision or the consolidation` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76J(5) section 76J prevents the allotment, the subdivision or the consolidation` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 76J(5) section 76J prevents the allotment, the subdivision or the consolidation` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 76J(5) section 76J prevents the allotment, the subdivision or the consolidation` FALSE TRUE FALSE FALSE EQUALS NOTHING
-- (6) bonus shares allotted in respect of treasury shares are treated as purchased when allotted.
#ASSERT `s 76J(6) the bonus shares are treated as purchased by the company at the time they were allotted, in circumstances in which section 76H applied` TRUE EQUALS JUST TRUE
#ASSERT `s 76J(6) the bonus shares are treated as purchased by the company at the time they were allotted, in circumstances in which section 76H applied` FALSE EQUALS NOTHING
-- The prohibition of (2): the company shall not exercise a right in respect of treasury shares.
-- EXPECT BREACH
#TRACE `s 76J(2) the company must not exercise any right in respect of the treasury shares` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 76J(2) exercise a right in respect of the treasury shares` AT 3
-- EXPECT RESIDUAL
#TRACE `s 76J(2) the company must not exercise any right in respect of the treasury shares` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 30)

-- ===== s 76K =====
-- (1) a private company holding treasury shares may at any time sell for cash, transfer for a share scheme, transfer as consideration, cancel, or (for a purpose the Minister has prescribed by order) use them.
#ASSERT `s 76K(1) the private company may deal with the treasury shares in this way` TRUE TRUE `s 76K(1)(a) sell the shares for cash` FALSE EQUALS JUST TRUE
#ASSERT `s 76K(1) the private company may deal with the treasury shares in this way` TRUE TRUE `s 76K(1)(b) transfer the shares for the purposes of or pursuant to a share scheme, whether for employees, directors or other persons` FALSE EQUALS JUST TRUE
#ASSERT `s 76K(1) the private company may deal with the treasury shares in this way` TRUE TRUE `s 76K(1)(c) transfer the shares as consideration for the acquisition of shares in or assets of another company or assets of a person` FALSE EQUALS JUST TRUE
#ASSERT `s 76K(1) the private company may deal with the treasury shares in this way` TRUE TRUE `s 76K(1)(d) cancel the shares` FALSE EQUALS JUST TRUE
#ASSERT `s 76K(1) the private company may deal with the treasury shares in this way` TRUE TRUE `s 76K(1)(e) sell, transfer or otherwise use the shares for another purpose the Minister has prescribed by order` TRUE EQUALS JUST TRUE
#ASSERT `s 76K(1) the private company may deal with the treasury shares in this way` TRUE TRUE `s 76K(1)(e) sell, transfer or otherwise use the shares for another purpose the Minister has prescribed by order` FALSE EQUALS NOTHING
#ASSERT `s 76K(1) the private company may deal with the treasury shares in this way` TRUE TRUE `s 76K(1) some other dealing` TRUE EQUALS NOTHING
#ASSERT `s 76K(1) the private company may deal with the treasury shares in this way` FALSE TRUE `s 76K(1)(a) sell the shares for cash` FALSE EQUALS NOTHING
#ASSERT `s 76K(1) the private company may deal with the treasury shares in this way` TRUE FALSE `s 76K(1)(a) sell the shares for cash` FALSE EQUALS NOTHING
-- (1A) a private company cancels or disposes of the treasury shares by lodging the notice with the Registrar.
#ASSERT `s 76K(1A) the private company has cancelled or disposed of the treasury shares by lodging the notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76K(1A) the private company has cancelled or disposed of the treasury shares by lodging the notice` TRUE FALSE EQUALS NOTHING
#ASSERT `s 76K(1A) the private company has cancelled or disposed of the treasury shares by lodging the notice` FALSE TRUE EQUALS NOTHING
-- (1B) the cancellation or disposal does not take effect until the electronic register is updated: TRUE before, FALSE after; scope as in 76B(8).
#ASSERT `s 76K(1B) the cancellation or disposal of the treasury shares cannot yet take effect` TRUE (Date 10 2 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 76K(1B) the cancellation or disposal of the treasury shares cannot yet take effect` TRUE (Date 10 2 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 76K(1B) the cancellation or disposal of the treasury shares cannot yet take effect` FALSE (Date 10 2 2026) FALSE EQUALS NOTHING
#ASSERT `s 76K(1B) the cancellation or disposal of the treasury shares cannot yet take effect` TRUE (Date 2 1 2016) FALSE EQUALS NOTHING
#ASSERT `s 76K(1B) the cancellation or disposal of the treasury shares cannot yet take effect` TRUE (Date 3 1 2016) FALSE EQUALS JUST TRUE
-- (1C) a public company: the same dealings.
#ASSERT `s 76K(1C) the public company may deal with the treasury shares in this way` TRUE TRUE `s 76K(1)(a) sell the shares for cash` FALSE EQUALS JUST TRUE
#ASSERT `s 76K(1C) the public company may deal with the treasury shares in this way` TRUE TRUE `s 76K(1)(d) cancel the shares` FALSE EQUALS JUST TRUE
#ASSERT `s 76K(1C) the public company may deal with the treasury shares in this way` TRUE TRUE `s 76K(1)(e) sell, transfer or otherwise use the shares for another purpose the Minister has prescribed by order` FALSE EQUALS NOTHING
#ASSERT `s 76K(1C) the public company may deal with the treasury shares in this way` TRUE TRUE `s 76K(1) some other dealing` TRUE EQUALS NOTHING
#ASSERT `s 76K(1C) the public company may deal with the treasury shares in this way` FALSE TRUE `s 76K(1)(a) sell the shares for cash` FALSE EQUALS NOTHING
-- (1D) the directors lodge the prescribed notice within 30 days after the cancellation or disposal: 1 March 2026 -> last day 31 March 2026.
#ASSERT `s 76K(1D) the last day for the directors to lodge the prescribed notice` (Date 1 3 2026) EQUALS Date 31 3 2026
#ASSERT `s 76K(1D) the directors have lodged the prescribed notice in time` TRUE (Date 1 3 2026) TRUE (Date 31 3 2026) EQUALS JUST TRUE
#ASSERT `s 76K(1D) the directors have lodged the prescribed notice in time` TRUE (Date 1 3 2026) TRUE (Date 1 4 2026) EQUALS JUST FALSE
#ASSERT `s 76K(1D) the directors have lodged the prescribed notice in time` TRUE (Date 1 3 2026) FALSE (Date 31 3 2026) EQUALS JUST FALSE
#ASSERT `s 76K(1D) the directors have lodged the prescribed notice in time` FALSE (Date 1 3 2026) TRUE (Date 31 3 2026) EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `s 76K(1D) the directors of the public company must lodge the prescribed notice within 30 days after the cancellation or disposal` "A Director" AT 0 WITH
    PARTY Director "A Director" DOES `s 76K(1D) lodge with the Registrar a prescribed notice of the cancellation or disposal of treasury shares together with the prescribed fee` AT 30
-- EXPECT BREACH
#TRACE `s 76K(1D) the directors of the public company must lodge the prescribed notice within 30 days after the cancellation or disposal` "A Director" AT 0 WITH
    PARTY Director "A Director" DOES `s 76K(1D) lodge with the Registrar a prescribed notice of the cancellation or disposal of treasury shares together with the prescribed fee` AT 31
-- (2) "cash" includes cash, a cheque, a release of a liability, or an undertaking to pay within 90 days.
-- Inputs: cash; cheque; release; undertaking; the date the undertaking was given; the date on or before which payment is due.
#ASSERT `s 76K(2) the consideration is cash` TRUE FALSE FALSE FALSE (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 76K(2) the consideration is cash` FALSE TRUE FALSE FALSE (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 76K(2) the consideration is cash` FALSE FALSE TRUE FALSE (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 76K(2) the consideration is cash` FALSE FALSE FALSE TRUE (Date 1 3 2026) (Date 30 5 2026) EQUALS JUST TRUE
#ASSERT `s 76K(2) the consideration is cash` FALSE FALSE FALSE TRUE (Date 1 3 2026) (Date 31 5 2026) EQUALS JUST FALSE
#ASSERT `s 76K(2) the consideration is cash` FALSE FALSE FALSE FALSE (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST FALSE
-- (3) the company must not sell or transfer shares to which a section 215 notice relates, except to the person who desires to acquire them.
#ASSERT `s 76K(3) the company is barred from selling or transferring the shares to the transferee` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76K(3) the company is barred from selling or transferring the shares to the transferee` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76K(3) the company is barred from selling or transferring the shares to the transferee` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 76K(3) the company is barred from selling or transferring the shares to the transferee` TRUE FALSE FALSE EQUALS NOTHING
-- EXPECT BREACH
#TRACE `s 76K(3) the company must not sell or transfer the shares to which the section 215 notice relates except to the person who desires to acquire them` "Acme Pte Ltd" TRUE AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 76K(3) sell or transfer the shares to which the section 215 notice relates to a person other than the person who desires to acquire them` AT 2
-- EXPECT FULFILLED
#TRACE `s 76K(3) the company must not sell or transfer the shares to which the section 215 notice relates except to the person who desires to acquire them` "Acme Pte Ltd" FALSE AT 0 WITH
    (WAITUNTIL 2)
-- (4) the directors may take the steps requisite to enable the company to cancel its shares without complying with section 78B, 78C or 78I.
#ASSERT `s 76K(4) the directors may take the steps requisite to enable the company to cancel its shares without complying with section 78B, 78C or 78I` TRUE EQUALS JUST TRUE
#ASSERT `s 76K(4) the directors may take the steps requisite to enable the company to cancel its shares without complying with section 78B, 78C or 78I` FALSE EQUALS NOTHING
