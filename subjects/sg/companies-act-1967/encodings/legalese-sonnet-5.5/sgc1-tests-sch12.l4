IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgc1-sch12`

-- Tests for sgc1-sch12.l4 (the Twelfth Schedule). Expected values are written from the text, beside each assertion.

§ `Twelfth Schedule paragraph 1`

#ASSERT `sch 12 para 1 the statement contains the matters the paragraph requires` TRUE TRUE EQUALS JUST TRUE
-- one of the two opinions is missing
#ASSERT `sch 12 para 1 the statement contains the matters the paragraph requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 12 para 1 the statement contains the matters the paragraph requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 1 the statement contains the matters the paragraph requires` FALSE FALSE EQUALS JUST FALSE

§ `Twelfth Schedule paragraph 2`

-- an option granted in the period by a company that is not a parent company for which consolidated statements are required
#ASSERT `sch 12 para 2 the statement must state the particulars of the option` TRUE FALSE EQUALS JUST TRUE
-- no option granted
#ASSERT `sch 12 para 2 the statement must state the particulars of the option` FALSE FALSE EQUALS JUST FALSE
-- "other than a parent company for which consolidated financial statements are required"
#ASSERT `sch 12 para 2 the statement must state the particulars of the option` TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 2 the statement must state the particulars of the option` FALSE TRUE EQUALS JUST FALSE

-- all of (a) to (d) given
#ASSERT `sch 12 para 2 the statement states the particulars of the option` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- each of (a) to (d) missing in turn
#ASSERT `sch 12 para 2 the statement states the particulars of the option` TRUE FALSE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 2 the statement states the particulars of the option` TRUE FALSE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 2 the statement states the particulars of the option` TRUE FALSE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 2 the statement states the particulars of the option` TRUE FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- the paragraph asks for nothing: no option, or a parent company for which consolidated statements are required
#ASSERT `sch 12 para 2 the statement states the particulars of the option` FALSE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `sch 12 para 2 the statement states the particulars of the option` TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING

§ `Twelfth Schedule paragraph 3`

-- stated in a previous directors' statement
#ASSERT `sch 12 para 3 the particulars may be stated by reference to the earlier statement or report` TRUE FALSE EQUALS JUST TRUE
-- stated in a previous directors' report made for the purposes of section 201(5) or (6A) as in force immediately before 1 July 2015
#ASSERT `sch 12 para 3 the particulars may be stated by reference to the earlier statement or report` FALSE TRUE EQUALS JUST TRUE
-- not stated before: "Where any of the particulars ... have been stated"
#ASSERT `sch 12 para 3 the particulars may be stated by reference to the earlier statement or report` FALSE FALSE EQUALS JUST FALSE

§ `Twelfth Schedule paragraph 4`

#ASSERT `sch 12 para 4 the directors' statement of the parent company must state the corporation and the other particulars` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 4 the directors' statement of the parent company must state the corporation and the other particulars` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 12 para 4 the directors' statement of the parent company must state the corporation and the other particulars` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 4 the statement states the corporation and the other particulars` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- the corporation's name missing, the other particulars missing
#ASSERT `sch 12 para 4 the statement states the corporation and the other particulars` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 4 the statement states the corporation and the other particulars` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- not a parent company, or no option granted by it or a subsidiary corporation
#ASSERT `sch 12 para 4 the statement states the corporation and the other particulars` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `sch 12 para 4 the statement states the corporation and the other particulars` TRUE FALSE TRUE TRUE EQUALS NOTHING

§ `Twelfth Schedule paragraph 5`

#ASSERT `sch 12 para 5 the statement states the particulars of shares issued on the exercise of options` TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 5 the statement states the particulars of shares issued on the exercise of options` TRUE FALSE EQUALS JUST FALSE
-- no shares issued on the exercise of options: the paragraph is silent
#ASSERT `sch 12 para 5 the statement states the particulars of shares issued on the exercise of options` FALSE TRUE EQUALS NOTHING
#ASSERT `sch 12 para 5 the statement states the particulars of shares issued on the exercise of options` FALSE FALSE EQUALS NOTHING

§ `Twelfth Schedule paragraph 6`

#ASSERT `sch 12 para 6 the statement states the unissued shares under option` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- each of the four items missing in turn
#ASSERT `sch 12 para 6 the statement states the unissued shares under option` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 6 the statement states the unissued shares under option` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 6 the statement states the unissued shares under option` TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 12 para 6 the statement states the unissued shares under option` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- no unissued shares under option at the end of the period
#ASSERT `sch 12 para 6 the statement states the unissued shares under option` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING

§ `Twelfth Schedule paragraph 7`

#ASSERT `sch 12 para 7 the statement states the names of the directors in office` TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 7 the statement states the names of the directors in office` FALSE EQUALS JUST FALSE

§ `Twelfth Schedule paragraph 8`

#ASSERT `sch 12 para 8 the statement must also explain the effect of the arrangements and name the directors` TRUE EQUALS JUST TRUE
#ASSERT `sch 12 para 8 the statement must also explain the effect of the arrangements and name the directors` FALSE EQUALS JUST FALSE
-- the statement says whether, no such arrangements subsisted: nothing more is asked
#ASSERT `sch 12 para 8 the statement states whether the arrangements subsisted and, if so, their effect` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- such arrangements subsisted, the effect explained and the directors named
#ASSERT `sch 12 para 8 the statement states whether the arrangements subsisted and, if so, their effect` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- the names missing, the explanation missing
#ASSERT `sch 12 para 8 the statement states whether the arrangements subsisted and, if so, their effect` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 12 para 8 the statement states whether the arrangements subsisted and, if so, their effect` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- the statement does not say whether
#ASSERT `sch 12 para 8 the statement states whether the arrangements subsisted and, if so, their effect` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 12 para 8 the statement states whether the arrangements subsisted and, if so, their effect` FALSE TRUE TRUE TRUE EQUALS JUST FALSE

§ `Twelfth Schedule paragraph 9`

-- not a director at the end of the financial year
#ASSERT `sch 12 para 9 the statement states the director's interests in shares and debentures` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
-- (a) not said at all
#ASSERT `sch 12 para 9 the statement states the director's interests in shares and debentures` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (a) said, not interested at the end of the year: nothing more is asked
#ASSERT `sch 12 para 9 the statement states the director's interests in shares and debentures` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (b) interested at the end, numbers given, beginning said, not interested at the beginning
#ASSERT `sch 12 para 9 the statement states the director's interests in shares and debentures` TRUE TRUE TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE
-- (b) interested at both ends, every number given
#ASSERT `sch 12 para 9 the statement states the director's interests in shares and debentures` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- interested at the beginning, the beginning numbers not given
#ASSERT `sch 12 para 9 the statement states the director's interests in shares and debentures` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- interested at the end, the end numbers not given
#ASSERT `sch 12 para 9 the statement states the director's interests in shares and debentures` TRUE TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- the statement does not say whether the director was interested at the beginning
#ASSERT `sch 12 para 9 the statement states the director's interests in shares and debentures` TRUE TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
