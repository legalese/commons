IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-definitions`
IMPORT `sgl-statutory`

-- Tests for sgl-statutory.l4 (s 174). Expected values were decided from the text of s 174 before the module was run.
-- Dates: Date day month year. The period counting (one month after 31 January is 28 February) is the keel's convention P4, assumed and not ruled.

§ `s 174(1): who must hold the statutory meeting, and when`

#ASSERT `s 174(1) the company must hold a statutory meeting` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 174(1) the company must hold a statutory meeting` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 174(1) the company must hold a statutory meeting` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 174(1) the company must hold a statutory meeting` TRUE TRUE FALSE EQUALS JUST FALSE
-- the seam: the keel's s 4(1) "statutory meeting" asks "the meeting is the meeting mentioned in section 174"; this module answers it
#ASSERT `s 174(1) the meeting is the statutory meeting the section requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 174(1) the meeting is the statutory meeting the section requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 174(1) the meeting is the statutory meeting the section requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4(1) "statutory meeting" the meeting is the statutory meeting` (`s 174(1) the meeting is the statutory meeting the section requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 4(1) "statutory meeting" the meeting is the statutory meeting` (`s 174(1) the meeting is the statutory meeting the section requires` FALSE TRUE TRUE TRUE EQUALS JUST TRUE) EQUALS JUST FALSE
-- entitled to commence business on 1 January 2026: the meeting from 1 February to 1 April 2026 inclusive
#ASSERT `s 174(1) the statutory meeting is held in the period the subsection fixes` (Date 1 1 2026) (Date 31 1 2026) EQUALS JUST FALSE
#ASSERT `s 174(1) the statutory meeting is held in the period the subsection fixes` (Date 1 1 2026) (Date 1 2 2026) EQUALS JUST TRUE
#ASSERT `s 174(1) the statutory meeting is held in the period the subsection fixes` (Date 1 1 2026) (Date 15 2 2026) EQUALS JUST TRUE
#ASSERT `s 174(1) the statutory meeting is held in the period the subsection fixes` (Date 1 1 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `s 174(1) the statutory meeting is held in the period the subsection fixes` (Date 1 1 2026) (Date 2 4 2026) EQUALS JUST FALSE
-- entitled on 31 January 2026: one month after is 28 February, three months after is 30 April (P4)
#ASSERT `s 174(1) the statutory meeting is held in the period the subsection fixes` (Date 31 1 2026) (Date 27 2 2026) EQUALS JUST FALSE
#ASSERT `s 174(1) the statutory meeting is held in the period the subsection fixes` (Date 31 1 2026) (Date 28 2 2026) EQUALS JUST TRUE
#ASSERT `s 174(1) the statutory meeting is held in the period the subsection fixes` (Date 31 1 2026) (Date 30 4 2026) EQUALS JUST TRUE
#ASSERT `s 174(1) the statutory meeting is held in the period the subsection fixes` (Date 31 1 2026) (Date 1 5 2026) EQUALS JUST FALSE
#ASSERT `s 174(1) the number of days from the date to the last day for the statutory meeting` (Date 1 1 2026) EQUALS 90

-- The duty as a regulative rule: time 0 is the date the company is entitled to commence business (1 January 2026); the last day is 1 April 2026, day 90.
-- EXPECT FULFILLED
#TRACE `s 174(1) the company must hold the statutory meeting` "Alpha Pte Ltd" (Date 1 1 2026) AT 0 WITH
    PARTY Company "Alpha Pte Ltd" DOES `s 174(1) hold the statutory meeting` AT 60
-- EXPECT FULFILLED
#TRACE `s 174(1) the company must hold the statutory meeting` "Alpha Pte Ltd" (Date 1 1 2026) AT 0 WITH
    PARTY Company "Alpha Pte Ltd" DOES `s 174(1) hold the statutory meeting` AT 90
-- EXPECT BREACH
#TRACE `s 174(1) the company must hold the statutory meeting` "Alpha Pte Ltd" (Date 1 1 2026) AT 0 WITH
    PARTY Company "Alpha Pte Ltd" DOES `s 174(1) hold the statutory meeting` AT 91
-- EXPECT BREACH
#TRACE `s 174(1) the company must hold the statutory meeting` "Alpha Pte Ltd" (Date 1 1 2026) AT 0 WITH
    WAITUNTIL 91

§ `s 174(2): the statutory report to every member`

-- the meeting is to be held on 20 March 2026: the report goes out on or before 13 March 2026
#ASSERT `s 174(2) the directors forward the statutory report in time` (Date 20 3 2026) (Date 13 3 2026) EQUALS JUST TRUE
#ASSERT `s 174(2) the directors forward the statutory report in time` (Date 20 3 2026) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 174(2) the directors forward the statutory report in time` (Date 20 3 2026) (Date 14 3 2026) EQUALS JUST FALSE
#ASSERT `s 174(2) the directors forward the statutory report in time` (Date 20 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
#ASSERT `s 174(2) the latest day for the directors to forward the statutory report` (Date 20 3 2026) EQUALS Date 13 3 2026
-- the seam: the keel's s 4(1) "statutory report"
#ASSERT `s 174(2) the report is the statutory report the section requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 174(2) the report is the statutory report the section requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 174(2) the report is the statutory report the section requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 4(1) "statutory report" the report is the statutory report` (`s 174(2) the report is the statutory report the section requires` TRUE TRUE EQUALS JUST TRUE) EQUALS JUST TRUE
-- the duty as a regulative rule: time 0 is 1 March 2026; the latest day is 13 March, day 12
-- EXPECT FULFILLED
#TRACE `s 174(2) the directors must forward the statutory report` "Alpha Pte Ltd" (Date 1 3 2026) (Date 20 3 2026) AT 0 WITH
    PARTY `Board of directors` "Alpha Pte Ltd" DOES `s 174(2) forward the statutory report to every member` AT 12
-- EXPECT BREACH
#TRACE `s 174(2) the directors must forward the statutory report` "Alpha Pte Ltd" (Date 1 3 2026) (Date 20 3 2026) AT 0 WITH
    PARTY `Board of directors` "Alpha Pte Ltd" DOES `s 174(2) forward the statutory report to every member` AT 13
-- EXPECT BREACH
#TRACE `s 174(2) the directors must forward the statutory report` "Alpha Pte Ltd" (Date 1 3 2026) (Date 20 3 2026) AT 0 WITH
    WAITUNTIL 13

§ `s 174(3): certified, and what it must state`

#ASSERT `s 174(3) the statutory report is certified by enough directors` 2 EQUALS JUST TRUE
#ASSERT `s 174(3) the statutory report is certified by enough directors` 3 EQUALS JUST TRUE
#ASSERT `s 174(3) the statutory report is certified by enough directors` 1 EQUALS JUST FALSE
#ASSERT `s 174(3) the statutory report is certified by enough directors` 0 EQUALS JUST FALSE
#ASSERT `s 174(3)(a) the report states the shares allotted` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 174(3)(a) the report states the shares allotted` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 174(3)(a) the report states the shares allotted` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 174(3)(a) the report states the shares allotted` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 174(3)(b) the report states the cash received` TRUE EQUALS JUST TRUE
#ASSERT `s 174(3)(b) the report states the cash received` FALSE EQUALS JUST FALSE
-- (c): the report is dated 20 March 2026; "up to a date within 7 days of the date of the report"
#ASSERT `s 174(3)(c) the abstract is made up to a date within 7 days of the date of the report` (Date 13 3 2026) (Date 20 3 2026) EQUALS JUST TRUE
#ASSERT `s 174(3)(c) the abstract is made up to a date within 7 days of the date of the report` (Date 12 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
#ASSERT `s 174(3)(c) the abstract is made up to a date within 7 days of the date of the report` (Date 20 3 2026) (Date 20 3 2026) EQUALS JUST TRUE
#ASSERT `s 174(3)(c) the abstract is made up to a date within 7 days of the date of the report` (Date 27 3 2026) (Date 20 3 2026) EQUALS JUST TRUE
#ASSERT `s 174(3)(c) the abstract is made up to a date within 7 days of the date of the report` (Date 28 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
#ASSERT `s 174(3)(c) the report states the abstract and the account` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 174(3)(c) the report states the abstract and the account` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 174(3)(c) the report states the abstract and the account` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 174(3)(c) the report states the abstract and the account` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 174(3)(c) the report states the abstract and the account` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- (d): arguments: directors stated; trustees exist; trustees stated; auditors exist; auditors stated; chief executive officers exist; they are stated; secretaries stated
#ASSERT `s 174(3)(d) the report states the names and addresses and descriptions` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 174(3)(d) the report states the names and addresses and descriptions` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 174(3)(d) the report states the names and addresses and descriptions` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 174(3)(d) the report states the names and addresses and descriptions` TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 174(3)(d) the report states the names and addresses and descriptions` TRUE FALSE FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 174(3)(d) the report states the names and addresses and descriptions` TRUE FALSE FALSE FALSE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 174(3)(d) the report states the names and addresses and descriptions` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (e): a contract whose modification is to be submitted exists; its particulars are stated
#ASSERT `s 174(3)(e) the report states the particulars of the contract` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 174(3)(e) the report states the particulars of the contract` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 174(3)(e) the report states the particulars of the contract` TRUE FALSE EQUALS JUST FALSE
-- (3) as a whole
#ASSERT `s 174(3) the statutory report is certified and states what the subsection requires` 2 (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 174(3) the statutory report is certified and states what the subsection requires` 1 (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 174(3) the statutory report is certified and states what the subsection requires` 2 (JUST TRUE) (JUST TRUE) (JUST FALSE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 174(3) the statutory report is certified and states what the subsection requires` 2 (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE

§ `s 174(4) to (6)`

#ASSERT `s 174(4) the statutory report has been examined and reported upon by the auditors` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 174(4) the statutory report has been examined and reported upon by the auditors` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 174(4) the statutory report has been examined and reported upon by the auditors` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 174(5) the copy has been lodged with the Registrar in time` (Date 20 3 2026) (Date 13 3 2026) EQUALS JUST TRUE
#ASSERT `s 174(5) the copy has been lodged with the Registrar in time` (Date 20 3 2026) (Date 14 3 2026) EQUALS JUST FALSE
#ASSERT `s 174(5) the latest day for the directors to cause the copy to be lodged` (Date 20 3 2026) EQUALS Date 13 3 2026
-- EXPECT FULFILLED
#TRACE `s 174(5) the directors must cause the copy to be lodged` "Alpha Pte Ltd" (Date 1 3 2026) (Date 20 3 2026) AT 0 WITH
    PARTY `Board of directors` "Alpha Pte Ltd" DOES `s 174(5) lodge a copy of the statutory report and the auditor's report with the Registrar` AT 12
-- EXPECT BREACH
#TRACE `s 174(5) the directors must cause the copy to be lodged` "Alpha Pte Ltd" (Date 1 3 2026) (Date 20 3 2026) AT 0 WITH
    PARTY `Board of directors` "Alpha Pte Ltd" DOES `s 174(5) lodge a copy of the statutory report and the auditor's report with the Registrar` AT 14
#ASSERT `s 174(6) the list of members has been produced and kept open and accessible` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 174(6) the list of members has been produced and kept open and accessible` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 174(6) the list of members has been produced and kept open and accessible` FALSE TRUE EQUALS JUST FALSE
-- no period and no consequence is stated: a late act still reads FULFILLED, and with no act the trace stays RESIDUAL
-- EXPECT FULFILLED
#TRACE `s 174(6) the directors must cause the list of members to be produced and kept open and accessible (no time limit)` "Alpha Pte Ltd" AT 0 WITH
    PARTY `Board of directors` "Alpha Pte Ltd" DOES `s 174(6) cause the list of members to be produced at the commencement of the meeting and to remain open and accessible to any member during the meeting` AT 400
-- EXPECT RESIDUAL
#TRACE `s 174(6) the directors must cause the list of members to be produced and kept open and accessible (no time limit)` "Alpha Pte Ltd" AT 0 WITH
    WAITUNTIL 400

§ `s 174(7) to (9): what the meeting may do`

#ASSERT `s 174(7) the members present are at liberty to discuss the matter` TRUE EQUALS JUST TRUE
#ASSERT `s 174(7) the members present are at liberty to discuss the matter` FALSE EQUALS NOTHING
#ASSERT `s 174(7) the resolution is barred because notice has not been given in accordance with the constitution` FALSE EQUALS JUST TRUE
#ASSERT `s 174(7) the resolution is barred because notice has not been given in accordance with the constitution` TRUE EQUALS JUST FALSE
#ASSERT `s 174(8) a resolution may be passed at the adjourned meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 174(8) a resolution may be passed at the adjourned meeting` TRUE FALSE EQUALS NOTHING
#ASSERT `s 174(8) a resolution may be passed at the adjourned meeting` FALSE TRUE EQUALS NOTHING
#ASSERT `s 174(8) the adjourned meeting has the same powers as an original meeting` TRUE EQUALS JUST TRUE
#ASSERT `s 174(8) the adjourned meeting has the same powers as an original meeting` FALSE EQUALS NOTHING
#ASSERT `s 174(9) the meeting may appoint a committee of inquiry by the resolution` `an ordinary resolution` EQUALS JUST TRUE
#ASSERT `s 174(9) the meeting may appoint a committee of inquiry by the resolution` `a special resolution` EQUALS NOTHING
#ASSERT `s 174(9) the meeting may appoint a committee of inquiry by the resolution` `a resolution of the directors` EQUALS NOTHING
-- the adjourned meeting is on 20 March 2026: at least 7 days' notice means notice by 13 March
#ASSERT `s 174(9) a special resolution that the company be wound up may be passed at the adjourned meeting` TRUE TRUE (Date 13 3 2026) (Date 20 3 2026) EQUALS JUST TRUE
#ASSERT `s 174(9) a special resolution that the company be wound up may be passed at the adjourned meeting` TRUE TRUE (Date 14 3 2026) (Date 20 3 2026) EQUALS NOTHING
#ASSERT `s 174(9) a special resolution that the company be wound up may be passed at the adjourned meeting` TRUE FALSE (Date 1 3 2026) (Date 20 3 2026) EQUALS NOTHING
#ASSERT `s 174(9) a special resolution that the company be wound up may be passed at the adjourned meeting` FALSE TRUE (Date 1 3 2026) (Date 20 3 2026) EQUALS NOTHING

§ `s 174(10): the offence`

#ASSERT `s 174(10) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 174(10) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 174(10) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 174(10) the person is guilty of the offence this subsection creates` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 174(10) the most the person may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
#ASSERT `s 174(10) the most the person may be sentenced to on conviction` TRUE FALSE TRUE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
#ASSERT `s 174(10) the most the person may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 174(10) the most the person may be sentenced to on conviction` FALSE TRUE TRUE EQUALS NOTHING
