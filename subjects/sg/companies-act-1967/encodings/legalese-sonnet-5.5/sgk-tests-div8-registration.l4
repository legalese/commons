`charge: a lien created on 30 September 2018 on book debts after a winding up order` MEANS `s 131(3) the facts about the charge` OF TRUE, Date 30 9 2018, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE
`charge: a lien created on 30 September 2018 on book debts after a voluntary winding up resolution` MEANS `s 131(3) the facts about the charge` OF TRUE, Date 30 9 2018, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE, FALSE
`charge: a lien created on 30 September 2018 on book debts after a creditor acquired an interest` MEANS `s 131(3) the facts about the charge` OF TRUE, Date 30 9 2018, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, TRUE
`charge: a lien created on 1 October 2018 on book debts` MEANS `s 131(3) the facts about the charge` OF TRUE, Date 1 10 2018, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE
`charge: a lien created on 1 October 2018 on book debts after a winding up order` MEANS `s 131(3) the facts about the charge` OF TRUE, Date 1 10 2018, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE
`charge: a lien created in 2014 within the old subsection (3) with no winding up` MEANS `s 131(3) the facts about the charge` OF TRUE, Date 1 6 2014, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, FALSE, FALSE, FALSE
`charge: a lien created in 2014 within the old subsection (3) after a winding up order` MEANS `s 131(3) the facts about the charge` OF TRUE, Date 1 6 2014, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, TRUE, TRUE, FALSE, FALSE

§ `Section 131(11): shipowner's lien`

-- "“shipowner’s lien” means a contractual lien on — (a) sub-freights; (b) sub-hires; or (c) bill of lading freight, created under a charter (or sub-charter) of a ship for any amount due under the charter (or sub-charter)."
#ASSERT `s 131(11) the lien is a shipowner's lien` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 131(11) the lien is a shipowner's lien` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 131(11) the lien is a shipowner's lien` TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 131(11) the lien is a shipowner's lien` FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE     -- not contractual
#ASSERT `s 131(11) the lien is a shipowner's lien` TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- on none of the three
#ASSERT `s 131(11) the lien is a shipowner's lien` TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE     -- not created under a charter

§ `Section 131(3) and (3A): the heads (a) to (j)`

#ASSERT `s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a debenture charge`                 -- (a)
#ASSERT `s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a charge on uncalled share capital`   -- (b)
#ASSERT `s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a charge on subsidiary shares`        -- (c)
#ASSERT `s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a bill of sale charge`               -- (d)
#ASSERT `s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a charge on land`                    -- (e)
#ASSERT NOT (`s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a rent charge on land`)          -- (e) "but not including any charge for any rent or other periodical sum issuing out of land"
#ASSERT `s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a charge on book debts`             -- (f)
#ASSERT NOT (`s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a charge on a negotiable instrument`)   -- (3A): book debts do not include a negotiable instrument
#ASSERT `s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a charge on a negotiable instrument and a floating charge`   -- (g) holds although (f) does not
#ASSERT `s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a floating charge`                  -- (g)
#ASSERT `s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a charge on calls`                  -- (h)
#ASSERT `s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a charge on a ship`                 -- (i)
#ASSERT `s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: a charge on goodwill`              -- (j)
#ASSERT NOT (`s 131(3) the charge falls within one of paragraphs (a) to (j)` `charge: no listed charge`)

§ `Section 131(3), (3AA) to (3C): the charges to which section 131 applies`

#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a debenture charge` EQUALS JUST TRUE
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a charge on land` EQUALS JUST TRUE
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a floating charge` EQUALS JUST TRUE
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: no listed charge` EQUALS NOTHING                 -- "applies to the following charges": the list is not closed
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a rent charge on land` EQUALS NOTHING            -- (e) excludes it; no other head holds; the text does not say
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a charge by a non-company` EQUALS NOTHING       -- "created by a company"
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a charge on aircraft registrable under the aircraft act` EQUALS JUST FALSE   -- (3B)
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a charge on aircraft not registrable under the aircraft act` EQUALS JUST TRUE
-- (3): "created on or after 3 January 2016"; (3AA): a charge created before that date that was within the subsection (3) then in force.
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a charge created on 3 January 2016` EQUALS JUST TRUE
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a charge created on 2 January 2016 with no old head` EQUALS NOTHING
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a charge created on 2 January 2016 within the old subsection (3)` EQUALS JUST TRUE
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a charge created in 2015 within the old subsection (3) but no current head` EQUALS JUST TRUE
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a charge created in 2015 with a current head but not within the old subsection (3)` EQUALS NOTHING
-- (3AB): a shipowner's lien created on or after 1 October 2018 "is not a charge to which this section applies".
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a lien created on 1 October 2018 on book debts` EQUALS JUST FALSE
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a lien created on 1 October 2018 on book debts after a winding up order` EQUALS JUST FALSE
-- (3AC): created before 1 October 2018, it applies "only if, as at that date" (a), (b) or (c); then (3) or (3AA) decides.
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a lien created on 30 September 2018 on book debts with no winding up` EQUALS JUST FALSE
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a lien created on 30 September 2018 on book debts after a winding up order` EQUALS JUST TRUE
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a lien created on 30 September 2018 on book debts after a voluntary winding up resolution` EQUALS JUST TRUE
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a lien created on 30 September 2018 on book debts after a creditor acquired an interest` EQUALS JUST TRUE
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a lien created in 2014 within the old subsection (3) with no winding up` EQUALS JUST FALSE   -- "Despite subsection (3) or (3AA)"
#ASSERT `s 131(3) the charge is one to which section 131 applies` `charge: a lien created in 2014 within the old subsection (3) after a winding up order` EQUALS JUST TRUE

§ `Section 131(1): time, duty and voidness`

-- "within 30 days after the creation of the charge": a charge created on 1 June 2020 may be registered up to and including 1 July 2020.
#ASSERT `s 131(1) the statement is lodged within 30 days after the creation of the charge` (Date 1 6 2020) (Date 1 7 2020) FALSE 0         -- the 30th day
#ASSERT NOT (`s 131(1) the statement is lodged within 30 days after the creation of the charge` (Date 1 6 2020) (Date 2 7 2020) FALSE 0)   -- the 31st day
#ASSERT `s 131(1) the statement is lodged within 30 days after the creation of the charge` (Date 1 6 2020) (Date 1 6 2020) FALSE 0         -- the day of creation (fork F-K4)
#ASSERT `s 131(1) the statement is lodged within 30 days after the creation of the charge` (Date 1 6 2020) (Date 8 7 2020) TRUE 0          -- made abroad: 37 days, s 139
#ASSERT NOT (`s 131(1) the statement is lodged within 30 days after the creation of the charge` (Date 1 6 2020) (Date 9 7 2020) TRUE 0)
#ASSERT `s 131(1) the statement is lodged within 30 days after the creation of the charge` (Date 1 6 2020) (Date 11 7 2020) TRUE 3         -- made abroad, 3 further days allowed: 40 days
#ASSERT NOT (`s 131(1) the statement is lodged within 30 days after the creation of the charge` (Date 1 6 2020) (Date 12 7 2020) TRUE 3)

#ASSERT `s 131(1) a statement of the charge must be lodged with the Registrar` `charge: a debenture charge` EQUALS JUST TRUE
#ASSERT `s 131(1) a statement of the charge must be lodged with the Registrar` `charge: a lien created on 1 October 2018 on book debts` EQUALS JUST FALSE    -- (3AB): the section does not apply
#ASSERT `s 131(1) a statement of the charge must be lodged with the Registrar` `charge: no listed charge` EQUALS NOTHING

-- Voidness: facts, lodged?, day lodged, abroad?, further days, Court extended?, day to which the Court extended.
#ASSERT `s 131(1) the security the charge confers is void against the liquidator and any creditor of the company` `charge: a debenture charge` FALSE (Date 1 6 2020) FALSE 0 FALSE (Date 1 6 2020) EQUALS JUST TRUE      -- never lodged
#ASSERT `s 131(1) the security the charge confers is void against the liquidator and any creditor of the company` `charge: a debenture charge` TRUE (Date 1 7 2020) FALSE 0 FALSE (Date 1 6 2020) EQUALS JUST FALSE     -- lodged on the 30th day
#ASSERT `s 131(1) the security the charge confers is void against the liquidator and any creditor of the company` `charge: a debenture charge` TRUE (Date 2 7 2020) FALSE 0 FALSE (Date 1 6 2020) EQUALS JUST TRUE      -- lodged on the 31st day
#ASSERT `s 131(1) the security the charge confers is void against the liquidator and any creditor of the company` `charge: a debenture charge` TRUE (Date 9 7 2020) TRUE 0 FALSE (Date 1 6 2020) EQUALS JUST TRUE         -- made abroad: 38th day
#ASSERT `s 131(1) the security the charge confers is void against the liquidator and any creditor of the company` `charge: a debenture charge` TRUE (Date 8 7 2020) TRUE 0 FALSE (Date 1 6 2020) EQUALS JUST FALSE        -- made abroad: 37th day
#ASSERT `s 131(1) the security the charge confers is void against the liquidator and any creditor of the company` `charge: a debenture charge` TRUE (Date 20 7 2020) FALSE 0 TRUE (Date 20 7 2020) EQUALS JUST FALSE        -- late, but the Court extended the time to the day it was lodged (s 137)
#ASSERT `s 131(1) the security the charge confers is void against the liquidator and any creditor of the company` `charge: a debenture charge` TRUE (Date 21 7 2020) FALSE 0 TRUE (Date 20 7 2020) EQUALS JUST TRUE         -- lodged after the day to which the Court extended the time
#ASSERT `s 131(1) the security the charge confers is void against the liquidator and any creditor of the company` `charge: a lien created on 1 October 2018 on book debts` FALSE (Date 1 6 2020) FALSE 0 FALSE (Date 1 6 2020) EQUALS JUST FALSE   -- the section does not apply
#ASSERT `s 131(1) the security the charge confers is void against the liquidator and any creditor of the company` `charge: no listed charge` FALSE (Date 1 6 2020) FALSE 0 FALSE (Date 1 6 2020) EQUALS NOTHING

-- The duty as a regulative rule: lodged on the 30th day, on the 31st day, and never.
-- EXPECT FULFILLED
#TRACE `s 131(1) the company must lodge the statement of the charge within 30 days after the creation of the charge` "Acme Ltd" 0 AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 131(1) lodge with the Registrar a statement containing the prescribed particulars of the charge` AT 30
-- EXPECT BREACH
#TRACE `s 131(1) the company must lodge the statement of the charge within 30 days after the creation of the charge` "Acme Ltd" 0 AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 131(1) lodge with the Registrar a statement containing the prescribed particulars of the charge` AT 31
-- EXPECT BREACH
#TRACE `s 131(1) the company must lodge the statement of the charge within 30 days after the creation of the charge` "Acme Ltd" 0 AT 0 WITH
    (WAITUNTIL 31)
-- EXPECT FULFILLED
#TRACE `s 131(1) the company must lodge the statement of the charge within 30 days after the creation of the charge` "Acme Ltd" 7 AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 131(1) lodge with the Registrar a statement containing the prescribed particulars of the charge` AT 37
-- EXPECT BREACH
#TRACE `s 131(1) the company must lodge the statement of the charge within 30 days after the creation of the charge` "Acme Ltd" 7 AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 131(1) lodge with the Registrar a statement containing the prescribed particulars of the charge` AT 38

§ `Section 131(1A): production of the instrument`

#ASSERT `s 131(1A) the instrument or a certified true copy must be produced to the Registrar` `charge: a debenture charge` TRUE EQUALS JUST TRUE
#ASSERT `s 131(1A) the instrument or a certified true copy must be produced to the Registrar` `charge: a debenture charge` FALSE EQUALS JUST FALSE    -- no request: "upon the Registrar's request"
#ASSERT `s 131(1A) the instrument or a certified true copy must be produced to the Registrar` `charge: a lien created on 1 October 2018 on book debts` TRUE EQUALS JUST FALSE
#ASSERT `s 131(1A) the instrument or a certified true copy must be produced to the Registrar` `charge: no listed charge` TRUE EQUALS NOTHING
#ASSERT `s 131(1A) the production is at no cost to the Registrar` 0 EQUALS JUST TRUE
#ASSERT `s 131(1A) the production is at no cost to the Registrar` 50 EQUALS JUST FALSE

§ `Section 131(2)`

#ASSERT `s 131(2) subsection (1) affects the contract or obligation` TRUE EQUALS JUST FALSE        -- "Nothing in subsection (1) affects any contract or obligation for repayment"
#ASSERT `s 131(2) subsection (1) affects the contract or obligation` FALSE EQUALS NOTHING
#ASSERT `s 131(2) the money secured by the charge becomes immediately payable by force of this subsection` TRUE EQUALS JUST TRUE
#ASSERT `s 131(2) the money secured by the charge becomes immediately payable by force of this subsection` FALSE EQUALS JUST FALSE

§ `Section 131(4)`

#ASSERT `s 131(4) the statement may be lodged even though further proceedings are necessary under the law of the place where the property is` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 131(4) the statement may be lodged even though further proceedings are necessary under the law of the place where the property is` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 131(4) the statement may be lodged even though further proceedings are necessary under the law of the place where the property is` TRUE FALSE EQUALS JUST FALSE

§ `Section 131(5) to (8)`

-- (5): executed 1 June 2020; the 30th day is 1 July 2020. Arguments: a series?, day executed, day lodged, abroad?, further days, then the four particulars.
#ASSERT `s 131(5) the lodging of the statement is sufficient` TRUE (Date 1 6 2020) (Date 1 7 2020) FALSE 0 TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 131(5) the lodging of the statement is sufficient` TRUE (Date 1 6 2020) (Date 2 7 2020) FALSE 0 TRUE TRUE TRUE TRUE EQUALS JUST FALSE    -- the 31st day
#ASSERT `s 131(5) the lodging of the statement is sufficient` TRUE (Date 1 6 2020) (Date 8 7 2020) TRUE 0 TRUE TRUE TRUE TRUE EQUALS JUST TRUE       -- made abroad: 37th day
#ASSERT `s 131(5) the lodging of the statement is sufficient` FALSE (Date 1 6 2020) (Date 1 7 2020) FALSE 0 TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- not a series
#ASSERT `s 131(5) the lodging of the statement is sufficient` TRUE (Date 1 6 2020) (Date 1 7 2020) FALSE 0 FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- (a) missing
#ASSERT `s 131(5) the lodging of the statement is sufficient` TRUE (Date 1 6 2020) (Date 1 7 2020) FALSE 0 TRUE FALSE TRUE TRUE EQUALS JUST FALSE   -- (b) missing
#ASSERT `s 131(5) the lodging of the statement is sufficient` TRUE (Date 1 6 2020) (Date 1 7 2020) FALSE 0 TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- (c) missing
#ASSERT `s 131(5) the lodging of the statement is sufficient` TRUE (Date 1 6 2020) (Date 1 7 2020) FALSE 0 TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- (d) missing
-- (6): 30 days after each issue.
#ASSERT `s 131(6) the particulars of the issue are lodged within 30 days after the issue` (Date 1 6 2020) (Date 1 7 2020) FALSE 0
#ASSERT NOT (`s 131(6) the particulars of the issue are lodged within 30 days after the issue` (Date 1 6 2020) (Date 2 7 2020) FALSE 0)
#ASSERT `s 131(6) the particulars of the issue are lodged within 30 days after the issue` (Date 1 6 2020) (Date 8 7 2020) TRUE 0
#ASSERT `s 131(6) the omission affects the validity of the debentures issued` TRUE EQUALS JUST FALSE      -- "an omission to do so does not affect the validity of the debentures issued"
#ASSERT `s 131(6) the omission affects the validity of the debentures issued` FALSE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `s 131(6) the company must lodge the particulars of each issue within 30 days after it` "Acme Ltd" 0 AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 131(6) lodge with the Registrar the particulars of the date and amount of an issue of debentures` AT 30
-- EXPECT BREACH
#TRACE `s 131(6) the company must lodge the particulars of each issue within 30 days after it` "Acme Ltd" 0 AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 131(6) lodge with the Registrar the particulars of the date and amount of an issue of debentures` AT 31
-- (7): commission, allowance or discount.
#ASSERT `s 131(7) the particulars required to be lodged must include the amount or rate per cent of the commission, allowance or discount` TRUE EQUALS JUST TRUE
#ASSERT `s 131(7) the particulars required to be lodged must include the amount or rate per cent of the commission, allowance or discount` FALSE EQUALS JUST FALSE
#ASSERT `s 131(7) the omission affects the validity of the debentures issued` TRUE EQUALS JUST FALSE
#ASSERT `s 131(7) the omission affects the validity of the debentures issued` FALSE EQUALS NOTHING
-- (8): deposit as security is not an issue at a discount.
#ASSERT `s 131(8) the deposit is treated as the issue of the debentures at a discount for the purposes of subsection (7)` TRUE EQUALS JUST FALSE
#ASSERT `s 131(8) the deposit is treated as the issue of the debentures at a discount for the purposes of subsection (7)` FALSE EQUALS NOTHING

§ `Section 131(9) and (10)`

#ASSERT `s 131(9) the charge or assignment needs to be filed or registered under another written law` `charge: a debenture charge` FALSE EQUALS JUST FALSE      -- a charge to which the section applies, not relating to land
#ASSERT `s 131(9) the charge or assignment needs to be filed or registered under another written law` `charge: a debenture charge` TRUE EQUALS NOTHING          -- relating to land: the sentence leaves it out
#ASSERT `s 131(9) the charge or assignment needs to be filed or registered under another written law` `charge: no listed charge` FALSE EQUALS NOTHING
#ASSERT `s 131(9) the charge or assignment needs to be filed or registered under another written law` `charge: a lien created on 1 October 2018 on book debts` FALSE EQUALS NOTHING   -- not a charge to which the section applies: the sentence speaks of one that is
-- (10): five conditions; then the Court's satisfaction. Arguments: requires registration, within 30 days of the prior, comprises prior property, same debt, Court satisfied.
#ASSERT `s 131(10) the subsequent charge is not operative and has no validity as respects the property comprised in the prior charge` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 131(10) the subsequent charge is not operative and has no validity as respects the property comprised in the prior charge` TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE       -- "unless it is proved to the satisfaction of the Court" (fork F-K9)
#ASSERT `s 131(10) the subsequent charge is not operative and has no validity as respects the property comprised in the prior charge` FALSE TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 131(10) the subsequent charge is not operative and has no validity as respects the property comprised in the prior charge` TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 131(10) the subsequent charge is not operative and has no validity as respects the property comprised in the prior charge` TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 131(10) the subsequent charge is not operative and has no validity as respects the property comprised in the prior charge` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE

§ `Section 132`

#ASSERT `s 132(1) the person may lodge the documents and particulars for registration` TRUE FALSE EQUALS JUST TRUE         -- the company concerned
#ASSERT `s 132(1) the person may lodge the documents and particulars for registration` FALSE TRUE EQUALS JUST TRUE        -- any person interested in the documents
#ASSERT `s 132(1) the person may lodge the documents and particulars for registration` FALSE FALSE EQUALS NOTHING
-- The offence: default in complying with s 131, fine not exceeding $1,000 and also a default penalty.
#ASSERT `s 132(1) the person is guilty of the offence of default in complying with section 131` TRUE TRUE FALSE EQUALS JUST TRUE       -- the company in default
#ASSERT `s 132(1) the person is guilty of the offence of default in complying with section 131` TRUE FALSE TRUE EQUALS JUST TRUE       -- an officer in default
