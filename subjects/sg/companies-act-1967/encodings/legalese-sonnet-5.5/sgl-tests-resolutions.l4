IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgl-resolutions`

-- Tests for sgl-resolutions.l4 (ss 184, 185, 186, 187). Expected values were decided from the text before the module was run.
-- Period counting (28 days before 1 April 2026 is 4 March 2026; 14 days before is 18 March 2026) is the keel's convention P5, assumed and not ruled.

§ `s 184(1) and (2): special resolutions`

#ASSERT `s 184(1) the number of days' written notice the subsection requires` TRUE EQUALS 14
#ASSERT `s 184(1) the number of days' written notice the subsection requires` FALSE EQUALS 21
-- arguments: those in favour; those against
#ASSERT `s 184(1) the number voting in favour is not less than three-fourths of those voting` 3 1 EQUALS TRUE
#ASSERT `s 184(1) the number voting in favour is not less than three-fourths of those voting` 2 1 EQUALS FALSE
#ASSERT `s 184(1) the number voting in favour is not less than three-fourths of those voting` 75 25 EQUALS TRUE
#ASSERT `s 184(1) the number voting in favour is not less than three-fourths of those voting` 74 26 EQUALS FALSE
#ASSERT `s 184(1) the number voting in favour is not less than three-fourths of those voting` 1 0 EQUALS TRUE
#ASSERT `s 184(1) the number voting in favour is not less than three-fourths of those voting` 0 0 EQUALS FALSE
#ASSERT `s 184(1) the number voting in favour is not less than three-fourths of those voting` 0 5 EQUALS FALSE
-- arguments: a private company; in favour; against; days of written notice; the notice specified the intention; the answer under subsection (2)
#ASSERT `s 184(1) the resolution is a special resolution` TRUE 3 1 14 TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 184(1) the resolution is a special resolution` TRUE 3 1 13 TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 184(1) the resolution is a special resolution` TRUE 3 1 13 TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 184(1) the resolution is a special resolution` TRUE 3 1 13 TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 184(1) the resolution is a special resolution` FALSE 3 1 21 TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 184(1) the resolution is a special resolution` FALSE 3 1 20 TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 184(1) the resolution is a special resolution` FALSE 3 1 14 TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 184(1) the resolution is a special resolution` TRUE 2 1 14 TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 184(1) the resolution is a special resolution` TRUE 3 1 14 FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 184(1) the resolution is a special resolution` TRUE 2 1 5 TRUE (JUST TRUE) EQUALS JUST FALSE
-- arguments: members agreeing to shorter notice; members having the right to attend and vote; voting rights of those agreeing; total voting rights
#ASSERT `s 184(2) the resolution may be proposed and passed as a special resolution on shorter notice` 5 9 95 100 EQUALS JUST TRUE
#ASSERT `s 184(2) the resolution may be proposed and passed as a special resolution on shorter notice` 4 8 95 100 EQUALS NOTHING
#ASSERT `s 184(2) the resolution may be proposed and passed as a special resolution on shorter notice` 5 9 94 100 EQUALS NOTHING
#ASSERT `s 184(2) the resolution may be proposed and passed as a special resolution on shorter notice` 1 1 95 100 EQUALS JUST TRUE
#ASSERT `s 184(2) the resolution may be proposed and passed as a special resolution on shorter notice` 0 0 0 0 EQUALS NOTHING
#ASSERT `s 184(2) the resolution may be proposed and passed as a special resolution on shorter notice` 5 9 0 0 EQUALS NOTHING

§ `s 184(3) to (8)`

-- arguments: the chairperson declared the resolution carried; a poll is demanded
#ASSERT `s 184(3) the chairperson's declaration is conclusive evidence that the resolution is carried` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 184(3) the chairperson's declaration is conclusive evidence that the resolution is carried` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 184(3) the chairperson's declaration is conclusive evidence that the resolution is carried` FALSE FALSE EQUALS NOTHING
#ASSERT `s 184(3) the chairperson's declaration is conclusive evidence that the resolution is carried` FALSE TRUE EQUALS NOTHING
-- arguments: members entitled to vote who demand; of them the company itself; the number the constitution specifies; paid-up shares the demanding members hold; total paid-up shares excluding treasury shares; voting rights they represent; total voting rights
-- the constitution specifies a number: never more than 5 is needed
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 3 0 (JUST 3) 0 0 0 0 EQUALS JUST TRUE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 2 0 (JUST 3) 0 0 0 0 EQUALS JUST FALSE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 5 0 (JUST 10) 0 0 0 0 EQUALS JUST TRUE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 4 0 (JUST 10) 0 0 0 0 EQUALS JUST FALSE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 2 0 (JUST 2) 0 0 0 0 EQUALS JUST TRUE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 1 0 (JUST 2) 0 0 0 0 EQUALS JUST FALSE
-- subsection (4A): the company itself registered as a member does not count
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 5 1 (JUST 10) 0 0 0 0 EQUALS JUST FALSE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 6 1 (JUST 10) 0 0 0 0 EQUALS JUST TRUE
-- no provision in the constitution
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 3 0 NOTHING 0 0 0 0 EQUALS JUST TRUE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 2 0 NOTHING 0 100 0 100 EQUALS JUST FALSE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 2 0 NOTHING 10 100 0 100 EQUALS JUST TRUE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 2 0 NOTHING 9 100 0 100 EQUALS JUST FALSE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 1 0 NOTHING 0 100 10 100 EQUALS JUST TRUE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 1 0 NOTHING 0 100 9 100 EQUALS JUST FALSE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 0 0 NOTHING 10 100 10 100 EQUALS JUST FALSE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 2 1 NOTHING 10 100 0 100 EQUALS JUST TRUE
#ASSERT `s 184(4) a poll is deemed to be effectively demanded` 1 1 NOTHING 10 100 10 100 EQUALS JUST FALSE
#ASSERT `s 184(4A) the registered member is a member for the purposes of subsection (4)` TRUE EQUALS JUST FALSE
#ASSERT `s 184(4A) the registered member is a member for the purposes of subsection (4)` FALSE EQUALS NOTHING
-- arguments: votes cast for; votes cast against
#ASSERT `s 184(5) the majority on the poll is not less than three-fourths` 300 100 EQUALS TRUE
#ASSERT `s 184(5) the majority on the poll is not less than three-fourths` 299 100 EQUALS FALSE
#ASSERT `s 184(6) notice of the meeting is deemed to be duly given` TRUE EQUALS JUST TRUE
#ASSERT `s 184(6) notice of the meeting is deemed to be duly given` FALSE EQUALS JUST FALSE
#ASSERT `s 184(6) the meeting is deemed to be duly held` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 184(6) the meeting is deemed to be duly held` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 184(6) the meeting is deemed to be duly held` FALSE TRUE EQUALS JUST FALSE
-- arguments: the day the extraordinary resolution was passed; duly and appropriately passed
#ASSERT `s 184(7) the extraordinary resolution is treated as a special resolution for the purposes of this Act` (Date 28 12 1967) TRUE EQUALS JUST TRUE
#ASSERT `s 184(7) the extraordinary resolution is treated as a special resolution for the purposes of this Act` (Date 29 12 1967) TRUE EQUALS NOTHING
#ASSERT `s 184(7) the extraordinary resolution is treated as a special resolution for the purposes of this Act` (Date 28 12 1967) FALSE EQUALS NOTHING
-- arguments: the day the company was incorporated; a matter is required or permitted to be done by extraordinary resolution
#ASSERT `s 184(8) the matter may be done by special resolution` (Date 28 12 1967) TRUE EQUALS JUST TRUE
#ASSERT `s 184(8) the matter may be done by special resolution` (Date 29 12 1967) TRUE EQUALS JUST FALSE
#ASSERT `s 184(8) the matter may be done by special resolution` (Date 28 12 1967) FALSE EQUALS JUST FALSE

§ `s 185: special notice`

-- arguments: special notice is required; the day notice of intention was given to the company; the day of the meeting; a meeting was called after that notice
-- 28 days before 1 April 2026 is 4 March 2026
#ASSERT `s 185 the resolution is not effective because notice of the intention to move it was not given to the company in time` TRUE (Date 4 3 2026) (Date 1 4 2026) FALSE EQUALS JUST FALSE
#ASSERT `s 185 the resolution is not effective because notice of the intention to move it was not given to the company in time` TRUE (Date 5 3 2026) (Date 1 4 2026) FALSE EQUALS JUST TRUE
-- a meeting called after the notice for a date 28 days or less after it: the notice is deemed properly given (1 April is within 28 days after 5 March, which ends on 2 April)
#ASSERT `s 185 the resolution is not effective because notice of the intention to move it was not given to the company in time` TRUE (Date 5 3 2026) (Date 1 4 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 185 the resolution is not effective because notice of the intention to move it was not given to the company in time` TRUE (Date 4 3 2026) (Date 1 4 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 185 the resolution is not effective because notice of the intention to move it was not given to the company in time` FALSE (Date 5 3 2026) (Date 1 4 2026) FALSE EQUALS JUST FALSE
-- arguments: special notice is required; notice given at the same time and in the same manner as the notice of the meeting; that was not practicable; notice given in a manner the constitution allows; the day members were given notice; the day of the meeting
#ASSERT `s 185 the company has given its members notice of the resolution as the section requires` TRUE TRUE FALSE FALSE (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `s 185 the company has given its members notice of the resolution as the section requires` TRUE FALSE TRUE TRUE (Date 18 3 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `s 185 the company has given its members notice of the resolution as the section requires` TRUE FALSE TRUE TRUE (Date 19 3 2026) (Date 1 4 2026) EQUALS JUST FALSE
#ASSERT `s 185 the company has given its members notice of the resolution as the section requires` TRUE FALSE TRUE FALSE (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST FALSE
#ASSERT `s 185 the company has given its members notice of the resolution as the section requires` TRUE FALSE FALSE TRUE (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST FALSE
#ASSERT `s 185 the company has given its members notice of the resolution as the section requires` FALSE TRUE FALSE FALSE (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST FALSE
-- time 0 is 1 March 2026; the last day, 18 March 2026, is day 17
-- EXPECT FULFILLED
#TRACE `s 185 the company must give its members notice of the resolution not less than 14 days before the meeting where giving it with the notice of the meeting is not practicable` "Gamma Pte Ltd" (Date 1 3 2026) (Date 1 4 2026) AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 185 give members notice of the resolution` AT 17
-- EXPECT BREACH
#TRACE `s 185 the company must give its members notice of the resolution not less than 14 days before the meeting where giving it with the notice of the meeting is not practicable` "Gamma Pte Ltd" (Date 1 3 2026) (Date 1 4 2026) AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 185 give members notice of the resolution` AT 18
-- EXPECT BREACH
#TRACE `s 185 the company must give its members notice of the resolution not less than 14 days before the meeting where giving it with the notice of the meeting is not practicable` "Gamma Pte Ltd" (Date 1 3 2026) (Date 1 4 2026) AT 0 WITH
    WAITUNTIL 18

§ `s 186: lodging and forwarding copies, and the offences`

-- arguments: the resolution is a special resolution; it effectively binds a class of shareholders; this Act expressly provides otherwise
#ASSERT `s 186(1) a copy of the resolution must be lodged by the company with the Registrar` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 186(1) a copy of the resolution must be lodged by the company with the Registrar` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 186(1) a copy of the resolution must be lodged by the company with the Registrar` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 186(1) a copy of the resolution must be lodged by the company with the Registrar` TRUE FALSE TRUE EQUALS NOTHING
-- passed on 1 March 2026: the last day is 15 March 2026
#ASSERT `s 186(1) the number of days from the passing or making to the last day for lodging` (Date 1 3 2026) EQUALS 14
#ASSERT `s 186(1) the copy was lodged within 14 days after the passing or making` (Date 1 3 2026) (Date 15 3 2026) EQUALS TRUE
#ASSERT `s 186(1) the copy was lodged within 14 days after the passing or making` (Date 1 3 2026) (Date 16 3 2026) EQUALS FALSE
-- time 0 is the day the resolution is passed; the last day, 15 March, is day 14
-- EXPECT FULFILLED
#TRACE `s 186(1) the company must lodge a copy of the resolution with the Registrar` "Gamma Pte Ltd" AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 186(1) lodge a copy of the resolution with the Registrar` AT 14
-- EXPECT BREACH
#TRACE `s 186(1) the company must lodge a copy of the resolution with the Registrar` "Gamma Pte Ltd" AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 186(1) lodge a copy of the resolution with the Registrar` AT 15
-- EXPECT BREACH
#TRACE `s 186(1) the company must lodge a copy of the resolution with the Registrar` "Gamma Pte Ltd" AT 0 WITH
    WAITUNTIL 15
#ASSERT `s 186(2) the sum the member must pay for a copy` NOTHING EQUALS 1
#ASSERT `s 186(2) the sum the member must pay for a copy` (JUST 2) EQUALS 1
#ASSERT `s 186(2) the sum the member must pay for a copy` (JUST 1) EQUALS 1
#ASSERT `s 186(2) the sum the member must pay for a copy` (JUST 0.5) EQUALS 0.5
-- arguments: the constitution has not been registered; the resolution is one to which section 186 applies; a member has requested a copy; the sum paid; the sum the company directs
#ASSERT `s 186(2) the company must forward a copy of the resolution to the member` TRUE TRUE TRUE 1 NOTHING EQUALS JUST TRUE
#ASSERT `s 186(2) the company must forward a copy of the resolution to the member` TRUE TRUE TRUE 0 NOTHING EQUALS JUST FALSE
#ASSERT `s 186(2) the company must forward a copy of the resolution to the member` TRUE TRUE TRUE 0.5 (JUST 0.5) EQUALS JUST TRUE
#ASSERT `s 186(2) the company must forward a copy of the resolution to the member` TRUE TRUE TRUE 0.4 (JUST 0.5) EQUALS JUST FALSE
#ASSERT `s 186(2) the company must forward a copy of the resolution to the member` FALSE TRUE TRUE 1 NOTHING EQUALS JUST FALSE
#ASSERT `s 186(2) the company must forward a copy of the resolution to the member` TRUE FALSE TRUE 1 NOTHING EQUALS JUST FALSE
#ASSERT `s 186(2) the company must forward a copy of the resolution to the member` TRUE TRUE FALSE 1 NOTHING EQUALS JUST FALSE
-- arguments: there is a default in complying with the subsection; the person is the company or an officer in default
#ASSERT `s 186(3) the person is guilty of the offence this subsection creates` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 186(3) the person is guilty of the offence this subsection creates` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 186(3) the person is guilty of the offence this subsection creates` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 186(3) the most the person may be sentenced to on conviction` TRUE TRUE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
#ASSERT `s 186(3) the most the person may be sentenced to on conviction` FALSE TRUE EQUALS NOTHING
#ASSERT `s 186(4) the person is guilty of the offence this subsection creates` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 186(4) the person is guilty of the offence this subsection creates` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 186(4) the person is guilty of the offence this subsection creates` FALSE TRUE EQUALS JUST FALSE
-- arguments: default in complying with (2); the person is the company or an officer in default; the number of copies
#ASSERT `s 186(4) the fine on conviction` TRUE TRUE 3 EQUALS JUST (Penalty OF 150, 0, FALSE, FALSE)
#ASSERT `s 186(4) the fine on conviction` TRUE TRUE 1 EQUALS JUST (Penalty OF 50, 0, FALSE, FALSE)
#ASSERT `s 186(4) the fine on conviction` FALSE TRUE 3 EQUALS NOTHING

§ `s 187: adjourned meetings`

#ASSERT `s 187 the date the resolution is treated as having been passed` TRUE (Date 1 3 2026) EQUALS JUST (Date 1 3 2026)
#ASSERT `s 187 the date the resolution is treated as having been passed` FALSE (Date 1 3 2026) EQUALS NOTHING
