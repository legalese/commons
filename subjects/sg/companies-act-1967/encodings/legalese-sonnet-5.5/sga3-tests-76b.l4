IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sga3-76b`

-- Tests for sga3-76b.l4 (s 76B). Every expected value is decided from the text of section 76B (lines 8312-8507 of inputs/CoA1967.txt) before the run.
-- JUST TRUE is yes; JUST FALSE is the text saying no in its own words; NOTHING is "the text does not say".

-- (1): "may purchase or otherwise acquire ... if it is expressly permitted to do so by its constitution" and "in accordance with this section and sections 76C to 76G".
-- Both conditions met: yes. Either failed: a grant whose gate fails is NOTHING (grant rule of 2026-11-12, limit 1).
#ASSERT `s 76B(1) the company may purchase or otherwise acquire shares issued by it` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 76B(1) the company may purchase or otherwise acquire shares issued by it` TRUE FALSE EQUALS NOTHING
#ASSERT `s 76B(1) the company may purchase or otherwise acquire shares issued by it` FALSE TRUE EQUALS NOTHING
#ASSERT `s 76B(1) the company may purchase or otherwise acquire shares issued by it` FALSE FALSE EQUALS NOTHING

-- (2): "apply to ordinary shares, stocks and preference shares".
#ASSERT `s 76B(2) section 76B and sections 76C to 76G apply to the shares` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 76B(2) section 76B and sections 76C to 76G apply to the shares` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76B(2) section 76B and sections 76C to 76G apply to the shares` FALSE FALSE TRUE EQUALS JUST TRUE
-- A share that is none of the three: a scope limit with no "only" (ruling 2026-11-05 (c)): not covered.
#ASSERT `s 76B(2) section 76B and sections 76C to 76G apply to the shares` FALSE FALSE FALSE EQUALS NOTHING

-- (3E): treasury shares are disregarded: 1,000 shares of which 100 are treasury shares count as 900.
#ASSERT `s 76B(3E) the number of the company's ordinary shares in the class that counts` 1000 100 EQUALS 900
#ASSERT `s 76B(3E) the number of the company's ordinary shares in the class that counts` 1000 0 EQUALS 1000
#ASSERT `s 76B(3E) the number of the company's ordinary shares in the class that counts` 0 0 EQUALS 0

-- (3): "20% (or such other percentage as the Minister may by notification prescribe)".
#ASSERT `s 76B(3) the percentage that applies` FALSE 0 EQUALS 20
#ASSERT `s 76B(3) the percentage that applies` TRUE 10 EQUALS 10
#ASSERT `s 76B(3) the percentage that applies` TRUE 25 EQUALS 25

-- (3A): after a reduction under s 78B or 78C or an order under s 78I the base is the altered total; otherwise the total at the date of the resolution.
#ASSERT `s 76B(3A) the total number of ordinary shares and stocks in the class that the limit is measured against` FALSE 1000 800 EQUALS 1000
#ASSERT `s 76B(3A) the total number of ordinary shares and stocks in the class that the limit is measured against` TRUE 1000 800 EQUALS 800

-- (3): not more than 20% of 1,000 = 200. 200 is within the limit; 201 exceeds it.
#ASSERT `s 76B(3) the number purchased or acquired in the relevant period exceeds the limit` 200 1000 20 EQUALS JUST FALSE
#ASSERT `s 76B(3) the number purchased or acquired in the relevant period exceeds the limit` 201 1000 20 EQUALS JUST TRUE
#ASSERT `s 76B(3) the number purchased or acquired in the relevant period exceeds the limit` 0 1000 20 EQUALS JUST FALSE
#ASSERT `s 76B(3) the number purchased or acquired in the relevant period exceeds the limit` 100 1000 10 EQUALS JUST FALSE
#ASSERT `s 76B(3) the number purchased or acquired in the relevant period exceeds the limit` 101 1000 10 EQUALS JUST TRUE
-- A base of 800 after a reduction: 20% is 160.
#ASSERT `s 76B(3) the number purchased or acquired in the relevant period exceeds the limit` 160 800 20 EQUALS JUST FALSE
#ASSERT `s 76B(3) the number purchased or acquired in the relevant period exceeds the limit` 161 800 20 EQUALS JUST TRUE

-- (3C), (3B): the same for non-redeemable preference shares.
#ASSERT `s 76B(3C) the total number of non-redeemable preference shares in the class that the limit is measured against` FALSE 500 300 EQUALS 500
#ASSERT `s 76B(3C) the total number of non-redeemable preference shares in the class that the limit is measured against` TRUE 500 300 EQUALS 300
#ASSERT `s 76B(3B) the number of non-redeemable preference shares purchased or acquired in the relevant period exceeds the limit` 100 500 20 EQUALS JUST FALSE
#ASSERT `s 76B(3B) the number of non-redeemable preference shares purchased or acquired in the relevant period exceeds the limit` 101 500 20 EQUALS JUST TRUE

-- (3D): the limit does not apply to redeemable preference shares: any number is not over a limit.
#ASSERT `s 76B(3D) the number of redeemable preference shares purchased or acquired in the relevant period exceeds a limit` 0 EQUALS JUST FALSE
#ASSERT `s 76B(3D) the number of redeemable preference shares purchased or acquired in the relevant period exceeds a limit` 1000000 EQUALS JUST FALSE

-- (4)(b): "whichever is the earlier" of the day the AGM is held and the day it is required by law to be held.
#ASSERT `s 76B(4)(b) the date the relevant period expires` (Date 10 4 2026) (Date 30 4 2026) EQUALS Date 10 4 2026
#ASSERT `s 76B(4)(b) the date the relevant period expires` (Date 30 4 2026) (Date 10 4 2026) EQUALS Date 10 4 2026
#ASSERT `s 76B(4)(b) the date the relevant period expires` (Date 15 4 2026) (Date 15 4 2026) EQUALS Date 15 4 2026

-- (4): the period runs "commencing from the date of the passing of the resolution" and "expiring on the date" of the AGM: both days are in it.
#ASSERT `s 76B(4) the date is within the relevant period` (Date 1 2 2026) (Date 10 4 2026) (Date 30 4 2026) (Date 31 1 2026) EQUALS JUST FALSE
#ASSERT `s 76B(4) the date is within the relevant period` (Date 1 2 2026) (Date 10 4 2026) (Date 30 4 2026) (Date 1 2 2026) EQUALS JUST TRUE
#ASSERT `s 76B(4) the date is within the relevant period` (Date 1 2 2026) (Date 10 4 2026) (Date 30 4 2026) (Date 10 4 2026) EQUALS JUST TRUE
#ASSERT `s 76B(4) the date is within the relevant period` (Date 1 2 2026) (Date 10 4 2026) (Date 30 4 2026) (Date 11 4 2026) EQUALS JUST FALSE
-- The AGM is required earlier than it is held: the required date ends the period.
#ASSERT `s 76B(4) the date is within the relevant period` (Date 1 2 2026) (Date 30 4 2026) (Date 10 4 2026) (Date 10 4 2026) EQUALS JUST TRUE
#ASSERT `s 76B(4) the date is within the relevant period` (Date 1 2 2026) (Date 30 4 2026) (Date 10 4 2026) (Date 11 4 2026) EQUALS JUST FALSE

-- (5): shares purchased or acquired under 76C, 76D, 76DA or 76E "shall be deemed to be cancelled immediately on purchase or acquisition by the company unless such ordinary shares are held in treasury".
#ASSERT `s 76B(5) the ordinary shares are deemed to be cancelled immediately on purchase or acquisition` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 76B(5) the ordinary shares are deemed to be cancelled immediately on purchase or acquisition` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 76B(5) the ordinary shares are deemed to be cancelled immediately on purchase or acquisition` FALSE FALSE EQUALS NOTHING
#ASSERT `s 76B(5) the ordinary shares are deemed to be cancelled immediately on purchase or acquisition` FALSE TRUE EQUALS NOTHING

-- (5A): preference shares purchased or acquired under 76C, 76D, 76DA or 76E are deemed cancelled.
#ASSERT `s 76B(5A) the preference shares are deemed to be cancelled immediately on purchase or acquisition` TRUE EQUALS JUST TRUE
#ASSERT `s 76B(5A) the preference shares are deemed to be cancelled immediately on purchase or acquisition` FALSE EQUALS NOTHING

-- (6): on cancellation "all rights and privileges attached to that share shall expire".
#ASSERT `s 76B(6) the rights and privileges attached to the share expire` TRUE EQUALS JUST TRUE
#ASSERT `s 76B(6) the rights and privileges attached to the share expire` FALSE EQUALS NOTHING

-- (7)(b): the notice must be in the prescribed form and have every listed particular (ten facts).
`s 76B(7)(b) test notice with every particular` MEANS `s 76B(7)(b) notice of purchase or acquisition` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE
#ASSERT `s 76B(7)(b) the notice of purchase or acquisition is in the prescribed form and has the particulars` `s 76B(7)(b) test notice with every particular` EQUALS JUST TRUE
#ASSERT `s 76B(7)(b) the notice of purchase or acquisition is in the prescribed form and has the particulars` (`s 76B(7)(b) notice of purchase or acquisition` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 76B(7)(b) the notice of purchase or acquisition is in the prescribed form and has the particulars` (`s 76B(7)(b) notice of purchase or acquisition` OF TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 76B(7)(b) the notice of purchase or acquisition is in the prescribed form and has the particulars` (`s 76B(7)(b) notice of purchase or acquisition` OF TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 76B(7)(b) the notice of purchase or acquisition is in the prescribed form and has the particulars` (`s 76B(7)(b) notice of purchase or acquisition` OF TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 76B(7)(b) the notice of purchase or acquisition is in the prescribed form and has the particulars` (`s 76B(7)(b) notice of purchase or acquisition` OF TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 76B(7)(b) the notice of purchase or acquisition is in the prescribed form and has the particulars` (`s 76B(7)(b) notice of purchase or acquisition` OF TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 76B(7)(b) the notice of purchase or acquisition is in the prescribed form and has the particulars` (`s 76B(7)(b) notice of purchase or acquisition` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 76B(7)(b) the notice of purchase or acquisition is in the prescribed form and has the particulars` (`s 76B(7)(b) notice of purchase or acquisition` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE, TRUE) EQUALS JUST FALSE
#ASSERT `s 76B(7)(b) the notice of purchase or acquisition is in the prescribed form and has the particulars` (`s 76B(7)(b) notice of purchase or acquisition` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE, TRUE) EQUALS JUST FALSE
#ASSERT `s 76B(7)(b) the notice of purchase or acquisition is in the prescribed form and has the particulars` (`s 76B(7)(b) notice of purchase or acquisition` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS JUST FALSE

-- (7): "A private company may purchase or acquire any of its shares ... by lodging" the resolution copy and the notice.
#ASSERT `s 76B(7) the private company has purchased or acquired its shares by lodging what the subsection lists` TRUE TRUE `s 76B(7)(b) test notice with every particular` EQUALS JUST TRUE
#ASSERT `s 76B(7) the private company has purchased or acquired its shares by lodging what the subsection lists` FALSE TRUE `s 76B(7)(b) test notice with every particular` EQUALS NOTHING
#ASSERT `s 76B(7) the private company has purchased or acquired its shares by lodging what the subsection lists` TRUE FALSE `s 76B(7)(b) test notice with every particular` EQUALS NOTHING
#ASSERT `s 76B(7) the private company has purchased or acquired its shares by lodging what the subsection lists` TRUE TRUE (`s 76B(7)(b) notice of purchase or acquisition` OF FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE) EQUALS NOTHING

-- (8): "does not take effect until the electronic register of members ... is updated": TRUE before, FALSE after; a bar for a private company (the text says "private company") and, for a purchase on or after 3 January 2016.
#ASSERT `s 76B(8) the purchase or acquisition cannot yet take effect` TRUE (Date 10 2 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 76B(8) the purchase or acquisition cannot yet take effect` TRUE (Date 10 2 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 76B(8) the purchase or acquisition cannot yet take effect` FALSE (Date 10 2 2026) FALSE EQUALS NOTHING
#ASSERT `s 76B(8) the purchase or acquisition cannot yet take effect` TRUE (Date 2 1 2016) FALSE EQUALS NOTHING
#ASSERT `s 76B(8) the purchase or acquisition cannot yet take effect` TRUE (Date 3 1 2016) FALSE EQUALS JUST TRUE

-- (9)(c): for a public company the deemed date is the day it would, apart from (5), become entitled to the rights.
#ASSERT `s 76B(9)(c) the date on which the shares are deemed to be purchased or acquired` TRUE (Date 5 3 2026) EQUALS JUST (Date 5 3 2026)
#ASSERT `s 76B(9)(c) the date on which the shares are deemed to be purchased or acquired` FALSE (Date 5 3 2026) EQUALS NOTHING

-- (9)(a): 30 days after the resolution was passed: passed 1 March 2026 -> last day 31 March 2026.
#ASSERT `s 76B(9)(a) the last day for the directors to lodge a copy of the resolution` (Date 1 3 2026) EQUALS Date 31 3 2026
#ASSERT `s 76B(9)(a) the directors have lodged a copy of the resolution in time` TRUE (Date 1 3 2026) TRUE (Date 31 3 2026) EQUALS JUST TRUE
#ASSERT `s 76B(9)(a) the directors have lodged a copy of the resolution in time` TRUE (Date 1 3 2026) TRUE (Date 1 4 2026) EQUALS JUST FALSE
#ASSERT `s 76B(9)(a) the directors have lodged a copy of the resolution in time` TRUE (Date 1 3 2026) TRUE (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 76B(9)(a) the directors have lodged a copy of the resolution in time` TRUE (Date 1 3 2026) FALSE (Date 1 3 2026) EQUALS JUST FALSE
#ASSERT `s 76B(9)(a) the directors have lodged a copy of the resolution in time` FALSE (Date 1 3 2026) TRUE (Date 31 3 2026) EQUALS NOTHING

-- (9)(b): 30 days after the deemed date: 1 March 2026 -> 31 March 2026.
#ASSERT `s 76B(9)(b) the last day for the directors to lodge the notice of purchase or acquisition` (Date 1 3 2026) EQUALS Date 31 3 2026
#ASSERT `s 76B(9)(b) the directors have lodged a notice of purchase or acquisition in time` TRUE (Date 1 3 2026) TRUE (Date 31 3 2026) `s 76B(7)(b) test notice with every particular` EQUALS JUST TRUE
#ASSERT `s 76B(9)(b) the directors have lodged a notice of purchase or acquisition in time` TRUE (Date 1 3 2026) TRUE (Date 1 4 2026) `s 76B(7)(b) test notice with every particular` EQUALS JUST FALSE
#ASSERT `s 76B(9)(b) the directors have lodged a notice of purchase or acquisition in time` TRUE (Date 1 3 2026) FALSE (Date 31 3 2026) `s 76B(7)(b) test notice with every particular` EQUALS JUST FALSE
#ASSERT `s 76B(9)(b) the directors have lodged a notice of purchase or acquisition in time` TRUE (Date 1 3 2026) TRUE (Date 31 3 2026) (`s 76B(7)(b) notice of purchase or acquisition` OF TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, FALSE) EQUALS JUST FALSE
#ASSERT `s 76B(9)(b) the directors have lodged a notice of purchase or acquisition in time` FALSE (Date 1 3 2026) TRUE (Date 31 3 2026) `s 76B(7)(b) test notice with every particular` EQUALS NOTHING

-- (10): "Nothing in this section or in sections 76C to 76G is to be construed so as to limit or affect an order of the Court" -- an order that requires the company to purchase its own shares is not limited.
#ASSERT `s 76B(10) section 76B or sections 76C to 76G limit or affect the order of the Court` TRUE EQUALS JUST FALSE
#ASSERT `s 76B(10) section 76B or sections 76C to 76G limit or affect the order of the Court` FALSE EQUALS NOTHING

-- The seam to s 7(9)(ca): in accordance with sections 76B to 76G when the power holds, the section applies, the limit is not exceeded and the authority was given.
#ASSERT `s 76B(1) the interest is a company's interest in its own shares purchased or otherwise acquired in accordance with sections 76B to 76G` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 76B(1) the interest is a company's interest in its own shares purchased or otherwise acquired in accordance with sections 76B to 76G` FALSE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 76B(1) the interest is a company's interest in its own shares purchased or otherwise acquired in accordance with sections 76B to 76G` TRUE FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 76B(1) the interest is a company's interest in its own shares purchased or otherwise acquired in accordance with sections 76B to 76G` TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 76B(1) the interest is a company's interest in its own shares purchased or otherwise acquired in accordance with sections 76B to 76G` TRUE TRUE FALSE FALSE EQUALS NOTHING

-- The rules of (9)(a) and (9)(b): day 0 is the day the clock starts; "within 30 days after" ends on day 30.
-- EXPECT FULFILLED
#TRACE `s 76B(9)(a) the directors must lodge a copy of the resolution within 30 days after it is passed` "A Director" AT 0 WITH
    PARTY Director "A Director" DOES `s 76B(9)(a) lodge with the Registrar a copy of the resolution` AT 30
-- EXPECT BREACH
#TRACE `s 76B(9)(a) the directors must lodge a copy of the resolution within 30 days after it is passed` "A Director" AT 0 WITH
    PARTY Director "A Director" DOES `s 76B(9)(a) lodge with the Registrar a copy of the resolution` AT 31
-- EXPECT BREACH
#TRACE `s 76B(9)(a) the directors must lodge a copy of the resolution within 30 days after it is passed` "A Director" AT 0 WITH
    (WAITUNTIL 31)
-- EXPECT FULFILLED
#TRACE `s 76B(9)(b) the directors must lodge the notice of purchase or acquisition within 30 days after the purchase or acquisition` "A Director" AT 0 WITH
    PARTY Director "A Director" DOES `s 76B(9)(b) lodge with the Registrar a notice of purchase or acquisition in the prescribed form with the particulars` AT 12
-- EXPECT BREACH
#TRACE `s 76B(9)(b) the directors must lodge the notice of purchase or acquisition within 30 days after the purchase or acquisition` "A Director" AT 0 WITH
    PARTY Director "A Director" DOES `s 76B(9)(b) lodge with the Registrar a notice of purchase or acquisition in the prescribed form with the particulars` AT 40
