IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgc1-s204`

-- Tests for sgc1-s204.l4 (s 204). Expected values are written from the text, beside each assertion.

§ `s 204(1): section 201(2) or (5)`

#ASSERT `s 204(1) the person is guilty of the offence this subsection creates` TRUE TRUE EQUALS JUST TRUE
-- not a director
#ASSERT `s 204(1) the person is guilty of the offence this subsection creates` FALSE TRUE EQUALS JUST FALSE
-- a director who complied
#ASSERT `s 204(1) the person is guilty of the offence this subsection creates` TRUE FALSE EQUALS JUST FALSE

§ `s 204(1AA): section 201(16)`

#ASSERT `s 204(1AA) the person is guilty of the offence this subsection creates` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 204(1AA) the person is guilty of the offence this subsection creates` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 204(1AA) the person is guilty of the offence this subsection creates` TRUE FALSE EQUALS JUST FALSE

§ `s 204(1A): the other provisions of the Division`

-- (a) fails to comply with a provision other than section 201(2), (5) or (16)
#ASSERT `s 204(1A) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- (b) fails to take all reasonable steps to secure compliance
#ASSERT `s 204(1A) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- (c) has by his or her own wilful act been the cause of a default
#ASSERT `s 204(1A) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- none of the three
#ASSERT `s 204(1A) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- the provision is section 201(2), (5) or (16): "(other than ...)"
#ASSERT `s 204(1A) the person is guilty of the offence this subsection creates` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 204(1A) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
-- not a director
#ASSERT `s 204(1A) the person is guilty of the offence this subsection creates` FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE

§ `s 204(2): the defence for an omission`

-- proceedings of that kind, the omission not intentional, the information immaterial and no effect on the true and fair view
#ASSERT `s 204(2) the subsection gives the person a defence on these facts` TRUE TRUE TRUE EQUALS JUST TRUE
-- the information was material
#ASSERT `s 204(2) the subsection gives the person a defence on these facts` TRUE TRUE FALSE EQUALS JUST FALSE
-- the omission was intentional
#ASSERT `s 204(2) the subsection gives the person a defence on these facts` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 204(2) the subsection gives the person a defence on these facts` TRUE FALSE FALSE EQUALS JUST FALSE
-- other proceedings: the subsection is silent
#ASSERT `s 204(2) the subsection gives the person a defence on these facts` FALSE TRUE TRUE EQUALS NOTHING

§ `s 204(3): penalties, and intent to defraud`

-- no intent to defraud: subsection (1) $250,000, no imprisonment; (1AA) $50,000; (1A) $10,000 or 2 years, not both
#ASSERT `s 204 the most the offender may be sentenced to on conviction` `s 204(1) failing to comply with section 201(2) or (5)` TRUE FALSE EQUALS JUST (`s 204 penalty` OF 250000, 0, FALSE, FALSE)
#ASSERT `s 204 the most the offender may be sentenced to on conviction` `s 204(1AA) failing to comply with section 201(16)` TRUE FALSE EQUALS JUST (`s 204 penalty` OF 50000, 0, FALSE, FALSE)
#ASSERT `s 204 the most the offender may be sentenced to on conviction` `s 204(1A) the failure in paragraph (a), (b) or (c)` TRUE FALSE EQUALS JUST (`s 204 penalty` OF 10000, 24, FALSE, FALSE)
-- intent to defraud creditors or a fraudulent purpose: (a) $250,000 or 3 years or both; (aa) $100,000 or 3 years or both; (b) $15,000 or 3 years or both
#ASSERT `s 204 the most the offender may be sentenced to on conviction` `s 204(1) failing to comply with section 201(2) or (5)` TRUE TRUE EQUALS JUST (`s 204 penalty` OF 250000, 36, TRUE, FALSE)
#ASSERT `s 204 the most the offender may be sentenced to on conviction` `s 204(1AA) failing to comply with section 201(16)` TRUE TRUE EQUALS JUST (`s 204 penalty` OF 100000, 36, TRUE, FALSE)
#ASSERT `s 204 the most the offender may be sentenced to on conviction` `s 204(1A) the failure in paragraph (a), (b) or (c)` TRUE TRUE EQUALS JUST (`s 204 penalty` OF 15000, 36, TRUE, FALSE)
-- not guilty of an offence under the section: no penalty
#ASSERT `s 204 the most the offender may be sentenced to on conviction` `s 204(1) failing to comply with section 201(2) or (5)` FALSE FALSE EQUALS NOTHING
#ASSERT `s 204 the most the offender may be sentenced to on conviction` `s 204(1A) the failure in paragraph (a), (b) or (c)` FALSE TRUE EQUALS NOTHING

§ `s 204(4): imprisonment only for a wilful offence`

-- the Court is of the opinion that the offence was committed wilfully: not barred
#ASSERT `s 204(4) the person is barred from being sentenced to imprisonment for the offence` TRUE TRUE EQUALS JUST FALSE
-- not of that opinion: barred
#ASSERT `s 204(4) the person is barred from being sentenced to imprisonment for the offence` TRUE FALSE EQUALS JUST TRUE
-- not an offence under section 204: the subsection is silent
#ASSERT `s 204(4) the person is barred from being sentenced to imprisonment for the offence` FALSE TRUE EQUALS NOTHING
#ASSERT `s 204(4) the person is barred from being sentenced to imprisonment for the offence` FALSE FALSE EQUALS NOTHING
