IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgo-penalties`

-- Tests for sgo-penalties.l4 (ss 407, 408, 409, 409B, First Schedule).
-- Every expected value is written from the text of the section, beside the assertion, before the code was run.

§ `Section 407(1): who is guilty`

-- (a) forbidden act done: guilty.
#ASSERT `s 407(1) the person is guilty of an offence` TRUE FALSE FALSE EQUALS JUST TRUE
-- (b) required act not done: guilty.
#ASSERT `s 407(1) the person is guilty of an offence` FALSE TRUE FALSE EQUALS JUST TRUE
-- (c) otherwise contravenes: guilty.
#ASSERT `s 407(1) the person is guilty of an offence` FALSE FALSE TRUE EQUALS JUST TRUE
-- none of (a) to (c): the section says nothing.
#ASSERT `s 407(1) the person is guilty of an offence` FALSE FALSE FALSE EQUALS NOTHING

§ `Section 407(2): the penalty where the Act names none`

-- the Act expressly mentions $5,000 or 12 months (not both): that is the highest.
#ASSERT `s 407(2) the highest penalty or punishment on conviction` TRUE (JUST (Penalty OF 5000, 12, FALSE, FALSE)) EQUALS JUST (Penalty OF 5000, 12, FALSE, FALSE)
-- no penalty mentioned: a fine not exceeding $1,000 and no imprisonment.
#ASSERT `s 407(2) the highest penalty or punishment on conviction` TRUE NOTHING EQUALS JUST (Penalty OF 1000, 0, FALSE, FALSE)
-- not guilty of an offence: the subsection does not speak.
#ASSERT `s 407(2) the highest penalty or punishment on conviction` FALSE NOTHING EQUALS NOTHING

§ `Section 407(3) and (4): service of a summons`

#ASSERT `s 407(3) the summons may be served in that way` TRUE `s 407(3)(a) delivering it to that person` EQUALS JUST TRUE
#ASSERT `s 407(3) the summons may be served in that way` TRUE `s 407(3)(b) delivering it to an adult person residing at that person's last known place of abode or employed at that person's last known place of business` EQUALS JUST TRUE
#ASSERT `s 407(3) the summons may be served in that way` TRUE `s 407(3)(c) forwarding it by registered post in a cover addressed to that person at the person's last known place of abode or business or at any address furnished by the person` EQUALS JUST TRUE
-- any other way: the list does not say "only".
#ASSERT `s 407(3) the summons may be served in that way` TRUE `s 407(3) some other way` EQUALS NOTHING
-- not a summons for an offence under the Act or its regulations: outside the subsection.
#ASSERT `s 407(3) the summons may be served in that way` FALSE `s 407(3)(a) delivering it to that person` EQUALS NOTHING
-- (4): duly addressed and posted is sufficient.
#ASSERT `s 407(4) service by registered post is sufficiently proved` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 407(4) service by registered post is sufficiently proved` TRUE FALSE EQUALS NOTHING
#ASSERT `s 407(4) service by registered post is sufficiently proved` FALSE TRUE EQUALS NOTHING

§ `Section 408(1): the further offence and the additional penalty`

-- default penalty provided; convicted; continues: guilty of a further offence.
#ASSERT `s 408(1) the person is guilty of a further offence` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- dealt with under section 409B instead of convicted: the same.
#ASSERT `s 408(1) the person is guilty of a further offence` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- neither convicted nor dealt with.
#ASSERT `s 408(1) the person is guilty of a further offence` TRUE FALSE FALSE TRUE EQUALS NOTHING
-- no default penalty in the section.
#ASSERT `s 408(1) the person is guilty of a further offence` FALSE TRUE FALSE TRUE EQUALS NOTHING
-- the offence has stopped.
#ASSERT `s 408(1) the person is guilty of a further offence` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- the section expresses $50: not more than $50 a day.
#ASSERT `s 408(1) the highest additional penalty for each day during which the offence continues` TRUE (JUST 50) EQUALS JUST 50
-- the section expresses no amount: not more than $200 a day.
#ASSERT `s 408(1) the highest additional penalty for each day during which the offence continues` TRUE NOTHING EQUALS JUST 200
-- no further offence: no daily penalty.
#ASSERT `s 408(1) the highest additional penalty for each day during which the offence continues` FALSE NOTHING EQUALS NOTHING
-- three days at $50, and at the $200 default.
#ASSERT `s 408(1) the highest total additional penalty for the days the offence has continued` TRUE (JUST 50) 3 EQUALS JUST 150
#ASSERT `s 408(1) the highest total additional penalty for the days the offence has continued` TRUE NOTHING 3 EQUALS JUST 600
#ASSERT `s 408(1) the highest total additional penalty for the days the offence has continued` FALSE (JUST 50) 3 EQUALS NOTHING
-- the seam the keel asks for ("default penalty within the meaning of section 408").
#ASSERT `s 408(1) the penalty is a default penalty within the meaning of section 408` TRUE
#ASSERT NOT (`s 408(1) the penalty is a default penalty within the meaning of section 408` FALSE)

-- The prohibition against letting the offence continue.
-- EXPECT BREACH
#TRACE `s 408(1) a person convicted or dealt with must not let the offence continue` "Tan" AT 0 WITH
    PARTY Individual "Tan" DOES `s 408(1) let the offence continue after the conviction or composition` AT 1
-- EXPECT RESIDUAL
#TRACE `s 408(1) a person convicted or dealt with must not let the offence continue` "Tan" AT 0 WITH
    WAITUNTIL 5

§ `Section 408(2): the offence continues until the thing is done`

#ASSERT `s 408(2) the offence is deemed to continue` TRUE TRUE EQUALS JUST TRUE
-- the thing has been done: the text says "so long as ... remains undone".
#ASSERT `s 408(2) the offence is deemed to continue` TRUE FALSE EQUALS JUST FALSE
-- not an offence of that kind.
#ASSERT `s 408(2) the offence is deemed to continue` FALSE TRUE EQUALS NOTHING

§ `Section 408(3): an officer who is in default`

#ASSERT `s 408(3) the officer is an officer who is in default` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 408(3) the officer is an officer who is in default` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 408(3) the officer is an officer who is in default` TRUE TRUE EQUALS JUST TRUE
-- the phrase "means" an officer who knowingly and wilfully does one of the two.
#ASSERT `s 408(3) the officer is an officer who is in default` FALSE FALSE EQUALS JUST FALSE

§ `Section 409(1): who may take proceedings`

-- no other provision, Public Prosecutor authorises, by the Registrar.
#ASSERT `s 409(1) the person may take proceedings for the offence` FALSE `s 409(1) the Registrar` TRUE FALSE EQUALS JUST TRUE
-- by another person: the Minister's written consent is needed as well.
#ASSERT `s 409(1) the person may take proceedings for the offence` FALSE `s 409(1) a person other than the Registrar` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 409(1) the person may take proceedings for the offence` FALSE `s 409(1) a person other than the Registrar` TRUE FALSE EQUALS NOTHING
-- no authorisation of the Public Prosecutor.
#ASSERT `s 409(1) the person may take proceedings for the offence` FALSE `s 409(1) the Registrar` FALSE FALSE EQUALS NOTHING
#ASSERT `s 409(1) the person may take proceedings for the offence` FALSE `s 409(1) a person other than the Registrar` FALSE TRUE EQUALS NOTHING
-- the Act otherwise provides: the case goes to that provision.
#ASSERT `s 409(1) the person may take proceedings for the offence` TRUE `s 409(1) the Registrar` TRUE TRUE EQUALS NOTHING

§ `Section 409(3): which court`

-- Magistrate's Court: "other than an offence punishable with imprisonment for a term exceeding 6 months".
#ASSERT `s 409(3) the proceedings may be prosecuted in a Magistrate's Court` 0 EQUALS JUST TRUE
#ASSERT `s 409(3) the proceedings may be prosecuted in a Magistrate's Court` 5 EQUALS JUST TRUE
#ASSERT `s 409(3) the proceedings may be prosecuted in a Magistrate's Court` 6 EQUALS JUST TRUE
#ASSERT `s 409(3) the proceedings may be prosecuted in a Magistrate's Court` 7 EQUALS NOTHING
-- District Court: "a term of 6 months or more".
#ASSERT `s 409(3) the proceedings may be prosecuted in a District Court` 5 EQUALS NOTHING
#ASSERT `s 409(3) the proceedings may be prosecuted in a District Court` 6 EQUALS JUST TRUE
#ASSERT `s 409(3) the proceedings may be prosecuted in a District Court` 7 EQUALS JUST TRUE
#ASSERT `s 409(3) the proceedings may be prosecuted in a District Court` 24 EQUALS JUST TRUE

§ `Section 409(7) and (8)`

#ASSERT `s 409(7) a District Court may impose the punishment although it is greater than the Court is otherwise empowered to impose` TRUE EQUALS JUST TRUE
#ASSERT `s 409(7) a District Court may impose the punishment although it is greater than the Court is otherwise empowered to impose` FALSE EQUALS NOTHING
#ASSERT `s 409(8) the person has the right to appear and be heard before a Magistrate's Court or a District Court in proceedings for an offence under this Act` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 409(8) the person has the right to appear and be heard before a Magistrate's Court or a District Court in proceedings for an offence under this Act` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 409(8) the person has the right to appear and be heard before a Magistrate's Court or a District Court in proceedings for an offence under this Act` FALSE FALSE EQUALS NOTHING

§ `Section 409B: composition`

-- (1): the lower of half the maximum fine and $20,000.
#ASSERT `s 409B(1) the highest sum the Registrar may collect to compound the offence` TRUE TRUE 50000 EQUALS JUST 20000
-- half of $40,000 is $20,000: both limbs give the same sum.
#ASSERT `s 409B(1) the highest sum the Registrar may collect to compound the offence` TRUE TRUE 40000 EQUALS JUST 20000
-- half of $41,000 is $20,500: the $20,000 limit is lower.
#ASSERT `s 409B(1) the highest sum the Registrar may collect to compound the offence` TRUE TRUE 41000 EQUALS JUST 20000
-- half of $39,000 is $19,500: lower than $20,000.
#ASSERT `s 409B(1) the highest sum the Registrar may collect to compound the offence` TRUE TRUE 39000 EQUALS JUST 19500
#ASSERT `s 409B(1) the highest sum the Registrar may collect to compound the offence` TRUE TRUE 10000 EQUALS JUST 5000
-- not prescribed as compoundable, or not reasonably suspected.
#ASSERT `s 409B(1) the highest sum the Registrar may collect to compound the offence` FALSE TRUE 50000 EQUALS NOTHING
#ASSERT `s 409B(1) the highest sum the Registrar may collect to compound the offence` TRUE FALSE 50000 EQUALS NOTHING
-- (2): an offence that has ceased to be compoundable.
#ASSERT `s 409B(2) the highest sum the Registrar may collect to compound the offence that has ceased to be compoundable` TRUE TRUE TRUE 30000 EQUALS JUST 15000
#ASSERT `s 409B(2) the highest sum the Registrar may collect to compound the offence that has ceased to be compoundable` TRUE TRUE TRUE 100000 EQUALS JUST 20000
#ASSERT `s 409B(2) the highest sum the Registrar may collect to compound the offence that has ceased to be compoundable` TRUE FALSE TRUE 30000 EQUALS NOTHING
#ASSERT `s 409B(2) the highest sum the Registrar may collect to compound the offence that has ceased to be compoundable` FALSE TRUE TRUE 30000 EQUALS NOTHING
#ASSERT `s 409B(2) the highest sum the Registrar may collect to compound the offence that has ceased to be compoundable` TRUE TRUE FALSE 30000 EQUALS NOTHING
-- (3): payment ends the proceedings.
#ASSERT `s 409B(3) no further proceedings may be taken against the person in respect of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 409B(3) no further proceedings may be taken against the person in respect of the offence` FALSE EQUALS NOTHING

§ `First Schedule: the repealed written laws`

#ASSERT `sch 1 the number in the 1955 Edition` `sch 1 The Foreign Corporations (Execution of Instruments under Seal) Ordinance` EQUALS 15
#ASSERT `sch 1 the number in the 1955 Edition` `sch 1 The Companies Ordinance` EQUALS 174
#ASSERT `sch 1 the number in the 1955 Edition` `sch 1 The Companies (Special Provisions) Ordinance` EQUALS 277
#ASSERT `sch 1 the extent of the repeal` `sch 1 The Companies Ordinance` EQUALS "The whole."
#ASSERT `sch 1 the extent of the repeal` `sch 1 The Foreign Corporations (Execution of Instruments under Seal) Ordinance` EQUALS "The whole."
#ASSERT `sch 1 the extent of the repeal` `sch 1 The Companies (Special Provisions) Ordinance` EQUALS "The whole."
#ASSERT `sch 1 the written law is one of those the First Schedule lists` 15 EQUALS JUST TRUE
#ASSERT `sch 1 the written law is one of those the First Schedule lists` 174 EQUALS JUST TRUE
#ASSERT `sch 1 the written law is one of those the First Schedule lists` 277 EQUALS JUST TRUE
#ASSERT `sch 1 the written law is one of those the First Schedule lists` 100 EQUALS NOTHING
