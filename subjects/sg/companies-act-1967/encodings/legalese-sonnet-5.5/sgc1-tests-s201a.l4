IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgc1-s201a`

-- Tests for sgc1-s201a.l4 (ss 201A and 201AA). Expected values are written from the text, beside each assertion.

§ `s 201A(1): the exemption`

-- relevant company, dormant, requirements satisfied, no notice
#ASSERT `s 201A(1) the directors are exempt from the requirements of section 201 for the financial year` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- each limb missing in turn
#ASSERT `s 201A(1) the directors are exempt from the requirements of section 201 for the financial year` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 201A(1) the directors are exempt from the requirements of section 201 for the financial year` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 201A(1) the directors are exempt from the requirements of section 201 for the financial year` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- "Subject to subsection (3)": a notice issued in time displaces the exemption
#ASSERT `s 201A(1) the directors are exempt from the requirements of section 201 for the financial year` TRUE TRUE TRUE TRUE EQUALS JUST FALSE

§ `s 201A(2): the requirements`

-- dormant from formation, statement lodged with its three contents, lodged with the annual return
#ASSERT `s 201A(2) the requirements for the exemption are satisfied` TRUE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- dormant since the end of the previous financial year
#ASSERT `s 201A(2) the requirements for the exemption are satisfied` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- not dormant for either period
#ASSERT `s 201A(2) the requirements for the exemption are satisfied` FALSE FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- no statement lodged
#ASSERT `s 201A(2) the requirements for the exemption are satisfied` TRUE FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- the statement leaves out (b)(i), (b)(ii) or (b)(iii) in turn
#ASSERT `s 201A(2) the requirements for the exemption are satisfied` TRUE FALSE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 201A(2) the requirements for the exemption are satisfied` TRUE FALSE TRUE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 201A(2) the requirements for the exemption are satisfied` TRUE FALSE TRUE TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- not lodged at the same time as the annual return
#ASSERT `s 201A(2) the requirements for the exemption are satisfied` TRUE FALSE TRUE TRUE TRUE TRUE FALSE EQUALS JUST FALSE

§ `s 201A(3): the notice`

-- the financial year ends on 31 December 2026: 3 months before is 30 September 2026
#ASSERT `s 201A(3) the relevant person may by written notice require the directors of the dormant relevant company to comply with section 201` TRUE TRUE (Date 30 9 2026) (Date 31 12 2026) EQUALS JUST TRUE
#ASSERT `s 201A(3) the relevant person may by written notice require the directors of the dormant relevant company to comply with section 201` TRUE TRUE (Date 1 10 2026) (Date 31 12 2026) EQUALS JUST FALSE
#ASSERT `s 201A(3) the relevant person may by written notice require the directors of the dormant relevant company to comply with section 201` TRUE TRUE (Date 1 3 2026) (Date 31 12 2026) EQUALS JUST TRUE
-- year end 30 November 2026: 3 months before is 30 August 2026
#ASSERT `s 201A(3) the relevant person may by written notice require the directors of the dormant relevant company to comply with section 201` TRUE TRUE (Date 30 8 2026) (Date 30 11 2026) EQUALS JUST TRUE
#ASSERT `s 201A(3) the relevant person may by written notice require the directors of the dormant relevant company to comply with section 201` TRUE TRUE (Date 31 8 2026) (Date 30 11 2026) EQUALS JUST FALSE
-- not in writing
#ASSERT `s 201A(3) the relevant person may by written notice require the directors of the dormant relevant company to comply with section 201` TRUE FALSE (Date 1 3 2026) (Date 31 12 2026) EQUALS JUST FALSE
-- not a relevant person: the subsection gives the power to a relevant person only by naming one
#ASSERT `s 201A(3) the relevant person may by written notice require the directors of the dormant relevant company to comply with section 201` FALSE TRUE (Date 1 3 2026) (Date 31 12 2026) EQUALS NOTHING

§ `s 201A(4): who is a relevant person`

-- (a) the Registrar
#ASSERT `s 201A(4) the person is a relevant person` TRUE 0 1000 0 100 EQUALS JUST TRUE
-- (b) 5% of the issued shares, excluding treasury shares: 50 of 1000 is 5%, 49 is not
#ASSERT `s 201A(4) the person is a relevant person` FALSE 50 1000 0 100 EQUALS JUST TRUE
#ASSERT `s 201A(4) the person is a relevant person` FALSE 49 1000 0 100 EQUALS JUST FALSE
-- (c) 5% of the members: 5 of 100 is 5%, 4 is not
#ASSERT `s 201A(4) the person is a relevant person` FALSE 0 1000 5 100 EQUALS JUST TRUE
#ASSERT `s 201A(4) the person is a relevant person` FALSE 0 1000 4 100 EQUALS JUST FALSE
-- (c) with a single member and the whole of the membership
#ASSERT `s 201A(4) the person is a relevant person` FALSE 0 0 1 1 EQUALS JUST TRUE
-- no shares and no members to measure against
#ASSERT `s 201A(4) the person is a relevant person` FALSE 5 0 5 0 EQUALS JUST FALSE

§ `s 201A(5): relevant company`

-- the Act's own amount
#ASSERT `s 201A(5)(a)(ii)(A) the amount the section states, in Singapore dollars` EQUALS 500000
-- not listed, assets at the amount, not a parent company
#ASSERT `s 201A(5)(a) the company is a relevant company` FALSE 500000 FALSE 0 500000 EQUALS JUST TRUE
-- assets one dollar over the amount
#ASSERT `s 201A(5)(a) the company is a relevant company` FALSE 500001 FALSE 0 500000 EQUALS JUST FALSE
-- a listed company, or a subsidiary of one
#ASSERT `s 201A(5)(a) the company is a relevant company` TRUE 1000 FALSE 0 500000 EQUALS JUST FALSE
-- a parent company that is not itself a subsidiary: the group's consolidated total assets count
#ASSERT `s 201A(5)(a) the company is a relevant company` FALSE 1000 TRUE 500000 500000 EQUALS JUST TRUE
#ASSERT `s 201A(5)(a) the company is a relevant company` FALSE 1000 TRUE 500001 500000 EQUALS JUST FALSE
-- a different amount the Minister has substituted
#ASSERT `s 201A(5)(a) the company is a relevant company` FALSE 600000 FALSE 0 700000 EQUALS JUST TRUE
#ASSERT `s 201A(5)(a) the company is a relevant company` FALSE 600000 FALSE 0 500000 EQUALS JUST FALSE
#ASSERT `s 201A(5)(b) the relevant company is dormant` TRUE EQUALS JUST TRUE
#ASSERT `s 201A(5)(b) the relevant company is dormant` FALSE EQUALS JUST FALSE

§ `s 201A(6) and (7): financial years that ended before 3 January 2016`

-- 2 January 2016 is before 3 January 2016 (test typed wrongly first; the text decides: before 3 January 2016 is JUST FALSE)
#ASSERT `s 201A(6) this section applies to the directors for the financial year` (Date 2 1 2016) EQUALS JUST FALSE
#ASSERT `s 201A(6) this section applies to the directors for the financial year` (Date 31 12 2015) EQUALS JUST FALSE
#ASSERT `s 201A(6) this section applies to the directors for the financial year` (Date 3 1 2016) EQUALS NOTHING
#ASSERT `s 201A(6) the directors must prepare and lay the accounts under Part VI as it stood` (Date 2 1 2016) EQUALS JUST TRUE
#ASSERT `s 201A(6) the directors must prepare and lay the accounts under Part VI as it stood` (Date 3 1 2016) EQUALS NOTHING
#ASSERT `s 201A(7) the company must attach a copy of the accounts to the return` (Date 2 1 2016) EQUALS JUST TRUE
#ASSERT `s 201A(7) the company must attach a copy of the accounts to the return` (Date 3 1 2016) EQUALS NOTHING

-- EXPECT FULFILLED
#TRACE `s 201A(7) a company with an old financial year must attach a copy of the accounts to its return` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 201A(7) attach a copy of the accounts or consolidated accounts to the return` AT 2

-- EXPECT RESIDUAL (no time limit and no consequence inside the subsection)
#TRACE `s 201A(7) a company with an old financial year must attach a copy of the accounts to its return` "Acme Pte Ltd" AT 0 WITH

§ `s 201AA(1): keeping the documents`

-- laid at an annual general meeting held on 30 June 2026: 5 years after is 30 June 2031
#ASSERT `s 201AA(1) the last day of the period for which the company must keep the documents` FALSE (Date 30 6 2026) (Date 1 1 2000) EQUALS JUST (Date 30 6 2031)
-- an annual general meeting on 29 February 2024: no 29 February in 2029, so the last day is 28 February 2029 (P4)
#ASSERT `s 201AA(1) the last day of the period for which the company must keep the documents` FALSE (Date 29 2 2024) (Date 1 1 2000) EQUALS JUST (Date 28 2 2029)
-- no annual general meeting needed (s 175A(1)): the documents were sent on 31 May 2026: 5 years after is 31 May 2031
#ASSERT `s 201AA(1) the last day of the period for which the company must keep the documents` TRUE (Date 1 1 2000) (Date 31 5 2026) EQUALS JUST (Date 31 5 2031)
-- a meeting on 2 January 2016 is before 3 January 2016: not covered; on 3 January 2016 it is
#ASSERT `s 201AA(1) the last day of the period for which the company must keep the documents` FALSE (Date 2 1 2016) (Date 1 1 2000) EQUALS NOTHING
#ASSERT `s 201AA(1) the last day of the period for which the company must keep the documents` FALSE (Date 3 1 2016) (Date 1 1 2000) EQUALS JUST (Date 3 1 2021)
#ASSERT `s 201AA(1) the last day of the period for which the company must keep the documents` TRUE (Date 1 1 2000) (Date 2 1 2016) EQUALS NOTHING
-- both sides of the last day (meeting on 30 June 2026)
#ASSERT `s 201AA(1) the subsection requires the company to keep the documents on the day` FALSE (Date 30 6 2026) (Date 1 1 2000) (Date 30 6 2031) EQUALS JUST TRUE
#ASSERT `s 201AA(1) the subsection requires the company to keep the documents on the day` FALSE (Date 30 6 2026) (Date 1 1 2000) (Date 1 7 2031) EQUALS JUST FALSE
#ASSERT `s 201AA(1) the subsection requires the company to keep the documents on the day` FALSE (Date 2 1 2016) (Date 1 1 2000) (Date 1 1 2017) EQUALS NOTHING
#ASSERT `s 201AA(1) the documents are kept at a place the subsection allows` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 201AA(1) the documents are kept at a place the subsection allows` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 201AA(1) the documents are kept at a place the subsection allows` FALSE FALSE EQUALS JUST FALSE

-- 5 years from 30 June 2026 to 30 June 2031 is 1826 days (2028 is a leap year)
-- EXPECT BREACH
#TRACE `s 201AA(1) a company must not dispose of the documents within 5 years` "Acme Pte Ltd" 1826 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 201AA(1) dispose of the documents within 5 years` AT 100

-- EXPECT FULFILLED
#TRACE `s 201AA(1) a company must not dispose of the documents within 5 years` "Acme Pte Ltd" 1826 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 201AA(1) dispose of the documents within 5 years` AT 1827

§ `s 201AA(2): the offence of default`

#ASSERT `s 201AA(2) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 201AA(2) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 201AA(2) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 201AA(2) the person is guilty of the offence this subsection creates` FALSE TRUE TRUE EQUALS JUST FALSE
-- fine not exceeding $5,000 or 12 months, and also a default penalty
#ASSERT `s 201AA(2) the most the person may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (`s 201AA(2) penalty` OF 5000, 12, FALSE, TRUE)
#ASSERT `s 201AA(2) the most the person may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING

§ `s 201AA(3) to (5)`

#ASSERT `s 201AA(3) the company may be required to furnish the document and the document may be inspected` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 201AA(3) the company may be required to furnish the document and the document may be inspected` FALSE TRUE EQUALS NOTHING
#ASSERT `s 201AA(3) the company may be required to furnish the document and the document may be inspected` TRUE FALSE EQUALS NOTHING
-- (a) a refusal without lawful excuse
#ASSERT `s 201AA(4) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST TRUE
-- (a) a refusal with a lawful excuse
#ASSERT `s 201AA(4) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST FALSE
-- (b) obstruction
#ASSERT `s 201AA(4) the person is guilty of the offence this subsection creates` FALSE FALSE TRUE EQUALS JUST TRUE
-- (b) obstruction, even with a lawful excuse for refusing
#ASSERT `s 201AA(4) the person is guilty of the offence this subsection creates` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 201AA(4) the person is guilty of the offence this subsection creates` FALSE FALSE FALSE EQUALS JUST FALSE
-- fine not exceeding $10,000 or 2 years or both; no default penalty
#ASSERT `s 201AA(4) the most the person may be sentenced to on conviction` TRUE FALSE FALSE EQUALS JUST (`s 201AA(2) penalty` OF 10000, 24, TRUE, FALSE)
#ASSERT `s 201AA(4) the most the person may be sentenced to on conviction` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 201AA(5) the person is an authorised officer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 201AA(5) the person is an authorised officer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 201AA(5) the person is an authorised officer` FALSE TRUE EQUALS JUST FALSE
