IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgb1-s155b-debarment`

-- Tests for sgb1-s155b-debarment.l4 (Companies Act 1967, ss 155B, 155C, 155D, 155E; text lines 12701-12932 of CoA1967.txt).
-- Every expected value was written from the text of the Act, not from what the code printed; each group names the words it rests on.
-- JUST TRUE yes; JUST FALSE the text says no in its own words; NOTHING the text does not say.


-- s 155B(1): "Where the Registrar is satisfied that a company is in default in relation to a relevant requirement of this Act, the Registrar may make a debarment order against any person who, at the time the order is made, is a director or secretary of the company"
#ASSERT `s 155B(1) the Registrar may make a debarment order against the person` TRUE TRUE EQUALS JUST TRUE
-- a "where" gate on a "may" that fails: group 3, ruling (b)
#ASSERT `s 155B(1) the Registrar may make a debarment order against the person` FALSE TRUE EQUALS JUST FALSE
-- not a director or secretary when the order is made
#ASSERT `s 155B(1) the Registrar may make a debarment order against the person` TRUE FALSE EQUALS JUST FALSE

-- s 155B(6): "The Registrar must not make a debarment order ... (a) unless the default ... has persisted for a continuous period of 3 months or more and the person was a director or secretary of the company during that period; and (b) unless the Registrar has, not less than 14 days before the order is made, sent ... a notice ... specifying the default ... and giving ... an opportunity to show cause"; default began 1 January 2026, so 3 months run to 1 April 2026
-- order on 1 April, 14 days' notice (18 March): both unlesses met, so not barred
#ASSERT `s 155B(6) the subsection bars the Registrar from making a debarment order against the person` (Date 1 1 2026) (Date 1 4 2026) TRUE (Date 18 3 2026) TRUE EQUALS JUST FALSE
-- order on 31 March: the default has not persisted 3 months
#ASSERT `s 155B(6) the subsection bars the Registrar from making a debarment order against the person` (Date 1 1 2026) (Date 31 3 2026) TRUE (Date 17 3 2026) TRUE EQUALS JUST TRUE
-- notice only 13 days before the order
#ASSERT `s 155B(6) the subsection bars the Registrar from making a debarment order against the person` (Date 1 1 2026) (Date 1 4 2026) TRUE (Date 19 3 2026) TRUE EQUALS JUST TRUE
-- the person was not a director or secretary during the period
#ASSERT `s 155B(6) the subsection bars the Registrar from making a debarment order against the person` (Date 1 1 2026) (Date 1 4 2026) FALSE (Date 18 3 2026) TRUE EQUALS JUST TRUE
-- the notice did not specify the default and give an opportunity to show cause
#ASSERT `s 155B(6) the subsection bars the Registrar from making a debarment order against the person` (Date 1 1 2026) (Date 1 4 2026) TRUE (Date 18 3 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 155B(7) the Registrar must consider the representation in determining whether to make a debarment order` TRUE EQUALS JUST TRUE
-- no representation was made: outside "any representation ... made pursuant to the notice"
#ASSERT `s 155B(7) the Registrar must consider the representation in determining whether to make a debarment order` FALSE EQUALS NOTHING

-- s 155B(5): "the suspension of the debarment order operates so long as that person fulfils and continues to fulfil all such conditions"
#ASSERT `s 155B(5) the suspension of the debarment order operates` TRUE EQUALS JUST TRUE
-- "so long as": the condition fails
#ASSERT `s 155B(5) the suspension of the debarment order operates` FALSE EQUALS JUST FALSE

-- s 155B(3): "The debarment order applies from the date that the order is made and continues in force until the Registrar cancels or suspends the order"
-- after the order is made
#ASSERT `s 155B(3) the debarment order is in force` (Date 2 6 2026) (Date 1 6 2026) FALSE FALSE EQUALS JUST TRUE
-- on the date the order is made
#ASSERT `s 155B(3) the debarment order is in force` (Date 1 6 2026) (Date 1 6 2026) FALSE FALSE EQUALS JUST TRUE
-- before the order is made
#ASSERT `s 155B(3) the debarment order is in force` (Date 31 5 2026) (Date 1 6 2026) FALSE FALSE EQUALS JUST FALSE
-- cancelled
#ASSERT `s 155B(3) the debarment order is in force` (Date 2 6 2026) (Date 1 6 2026) TRUE FALSE EQUALS JUST FALSE
-- suspended
#ASSERT `s 155B(3) the debarment order is in force` (Date 2 6 2026) (Date 1 6 2026) FALSE TRUE EQUALS JUST FALSE

-- s 155B(2): "a person who has a debarment order made against him or her must not -- (a) except in respect of a company of which the person is a director immediately before the order was made -- act as director of any company; or (b) except in respect of a company of which the person is a secretary immediately before the order was made -- act as secretary of any company"
-- acting as director of another company
#ASSERT `s 155B(2) the subsection bars the person from acting as director or secretary of the company` TRUE TRUE `s 155B(2)(a) director of a company` FALSE FALSE EQUALS JUST TRUE
-- the company of which the person was a director immediately before
#ASSERT `s 155B(2) the subsection bars the person from acting as director or secretary of the company` TRUE TRUE `s 155B(2)(a) director of a company` TRUE FALSE EQUALS JUST FALSE
-- acting as secretary of another company
#ASSERT `s 155B(2) the subsection bars the person from acting as director or secretary of the company` TRUE TRUE `s 155B(2)(b) secretary of a company` FALSE FALSE EQUALS JUST TRUE
-- the company of which the person was a secretary immediately before
#ASSERT `s 155B(2) the subsection bars the person from acting as director or secretary of the company` TRUE TRUE `s 155B(2)(b) secretary of a company` FALSE TRUE EQUALS JUST FALSE
-- a secretary of the company is not excepted when acting as director
#ASSERT `s 155B(2) the subsection bars the person from acting as director or secretary of the company` TRUE TRUE `s 155B(2)(a) director of a company` FALSE TRUE EQUALS JUST TRUE
-- the order is no longer in force
#ASSERT `s 155B(2) the subsection bars the person from acting as director or secretary of the company` TRUE FALSE `s 155B(2)(a) director of a company` FALSE FALSE EQUALS JUST FALSE
-- no debarment order made against the person: outside "a person who has"
#ASSERT `s 155B(2) the subsection bars the person from acting as director or secretary of the company` FALSE TRUE `s 155B(2)(a) director of a company` FALSE FALSE EQUALS NOTHING

-- s 155B(4): "The Registrar may ... cancel or suspend such debarment order where the default ... has been rectified or on such other ground as may be prescribed" (a "where" gate on a "may": group 3, ruling (b))
#ASSERT `s 155B(4) the Registrar may cancel or suspend the debarment order` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 155B(4) the Registrar may cancel or suspend the debarment order` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 155B(4) the Registrar may cancel or suspend the debarment order` FALSE FALSE EQUALS JUST FALSE

-- s 155B(8), (9), (10), (11), (12)
-- aggrieved by the order
#ASSERT `s 155B(8) the person may appeal to the Minister` TRUE FALSE EQUALS JUST TRUE
-- aggrieved by the refusal to cancel or suspend
#ASSERT `s 155B(8) the person may appeal to the Minister` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 155B(8) the person may appeal to the Minister` FALSE FALSE EQUALS NOTHING
-- "An appeal under subsection (8) does not suspend the effect of the debarment order"
#ASSERT `s 155B(9) the appeal suspends the effect of the debarment order` TRUE EQUALS JUST FALSE
#ASSERT `s 155B(9) the appeal suspends the effect of the debarment order` FALSE EQUALS NOTHING
#ASSERT `s 155B(10) the person is guilty of the offence this subsection creates` TRUE EQUALS JUST TRUE
#ASSERT `s 155B(10) the person is guilty of the offence this subsection creates` FALSE EQUALS JUST FALSE
#ASSERT `s 155B(10) the most the person may be penalised on conviction` TRUE EQUALS JUST (`s 155B(10) penalty` OF 10000, 24, TRUE)
#ASSERT `s 155B(10) the most the person may be penalised on conviction` FALSE EQUALS NOTHING
#ASSERT `s 155B(11) the Registrar may publish the name and particulars of the person` TRUE EQUALS JUST TRUE
-- the Registrar may publish names of those against whom an order has been made and continues in force; nothing is said of others
#ASSERT `s 155B(11) the Registrar may publish the name and particulars of the person` FALSE EQUALS NOTHING
#ASSERT `s 155B(12) "debarment order" the order is a debarment order` TRUE EQUALS JUST TRUE
-- "means a debarment order made under subsection (1)"
#ASSERT `s 155B(12) "debarment order" the order is a debarment order` FALSE EQUALS JUST FALSE
#ASSERT `s 155B(12) "relevant requirement of this Act" the requirement is a relevant requirement` TRUE EQUALS JUST TRUE
-- "has the meaning given by section 155(2)"
#ASSERT `s 155B(12) "relevant requirement of this Act" the requirement is a relevant requirement` FALSE EQUALS JUST FALSE
#ASSERT `s 155B(12) "secretary" the person is a secretary of the company` TRUE EQUALS JUST TRUE
-- "means a secretary of the company appointed under section 171"
#ASSERT `s 155B(12) "secretary" the person is a secretary of the company` FALSE EQUALS JUST FALSE

-- s 155C(1): "Subject to any permission ..., a person who is subject to a disqualification or disqualification order under section 59, 60 or 61 of the Limited Liability Partnerships Act 2005 must not act as director of, or ... be concerned in the management of, any company or any foreign company to which Division 2 of Part 11 applies during the period"
-- section 59
#ASSERT `s 155C(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155C section 59 of the Limited Liability Partnerships Act 2005` FALSE TRUE TRUE EQUALS JUST TRUE
-- section 60
#ASSERT `s 155C(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155C section 60 of the Limited Liability Partnerships Act 2005` FALSE TRUE TRUE EQUALS JUST TRUE
-- section 61
#ASSERT `s 155C(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155C section 61 of the Limited Liability Partnerships Act 2005` FALSE TRUE TRUE EQUALS JUST TRUE
-- no disqualification under those sections: outside "a person who is subject"
#ASSERT `s 155C(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155C none of these` FALSE TRUE TRUE EQUALS NOTHING
-- "Subject to any permission": the Court gave permission
#ASSERT `s 155C(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155C section 59 of the Limited Liability Partnerships Act 2005` TRUE TRUE TRUE EQUALS JUST FALSE
-- outside "during the period"
#ASSERT `s 155C(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155C section 59 of the Limited Liability Partnerships Act 2005` FALSE FALSE TRUE EQUALS JUST FALSE
-- not a company or a Division 2 foreign company
#ASSERT `s 155C(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155C section 59 of the Limited Liability Partnerships Act 2005` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 155C(2) the person is guilty of the offence this subsection creates` TRUE EQUALS JUST TRUE
#ASSERT `s 155C(2) the person is guilty of the offence this subsection creates` FALSE EQUALS JUST FALSE
#ASSERT `s 155C(2) the most the person may be penalised on conviction` TRUE EQUALS JUST (`s 155C(2) penalty` OF 10000, 24, TRUE)
#ASSERT `s 155C(2) the most the person may be penalised on conviction` FALSE EQUALS NOTHING

-- s 155C(3): "A person who is subject to a disqualification or disqualification order under section 59 or 61 ... may apply to the Court for permission ... upon giving the Minister not less than 14 days' notice" (section 60 is not named)
-- section 59, 14 days
#ASSERT `s 155C(3) the person may apply to the Court for permission to act as a director or to take part in the management of a company` `s 155C section 59 of the Limited Liability Partnerships Act 2005` (Date 1 1 2026) (Date 15 1 2026) EQUALS JUST TRUE
-- section 59, 13 days
#ASSERT `s 155C(3) the person may apply to the Court for permission to act as a director or to take part in the management of a company` `s 155C section 59 of the Limited Liability Partnerships Act 2005` (Date 2 1 2026) (Date 15 1 2026) EQUALS JUST FALSE
-- section 61, 14 days
#ASSERT `s 155C(3) the person may apply to the Court for permission to act as a director or to take part in the management of a company` `s 155C section 61 of the Limited Liability Partnerships Act 2005` (Date 1 1 2026) (Date 15 1 2026) EQUALS JUST TRUE
-- section 60 is not named in subsection (3)
#ASSERT `s 155C(3) the person may apply to the Court for permission to act as a director or to take part in the management of a company` `s 155C section 60 of the Limited Liability Partnerships Act 2005` (Date 1 1 2026) (Date 15 1 2026) EQUALS NOTHING
#ASSERT `s 155C(3) the person may apply to the Court for permission to act as a director or to take part in the management of a company` `s 155C none of these` (Date 1 1 2026) (Date 15 1 2026) EQUALS NOTHING
#ASSERT `s 155C(4) the Minister may be represented at the hearing and may oppose the granting of the application` TRUE EQUALS JUST TRUE
-- an "On the hearing" gate that fails
#ASSERT `s 155C(4) the Minister may be represented at the hearing and may oppose the granting of the application` FALSE EQUALS JUST FALSE

-- s 155D(1): the same with sections 56, 57, 58, 59 or 60 of the VCC Act
-- section 56
#ASSERT `s 155D(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155D section 56 of the VCC Act` FALSE TRUE TRUE EQUALS JUST TRUE
-- section 57
#ASSERT `s 155D(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155D section 57 of the VCC Act` FALSE TRUE TRUE EQUALS JUST TRUE
-- section 58
#ASSERT `s 155D(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155D section 58 of the VCC Act` FALSE TRUE TRUE EQUALS JUST TRUE
-- section 59
#ASSERT `s 155D(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155D section 59 of the VCC Act` FALSE TRUE TRUE EQUALS JUST TRUE
-- section 60
#ASSERT `s 155D(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155D section 60 of the VCC Act` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 155D(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155D none of these` FALSE TRUE TRUE EQUALS NOTHING
-- permission given
#ASSERT `s 155D(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155D section 56 of the VCC Act` TRUE TRUE TRUE EQUALS JUST FALSE
-- outside the period
#ASSERT `s 155D(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155D section 56 of the VCC Act` FALSE FALSE TRUE EQUALS JUST FALSE
-- not a company or a Division 2 foreign company
#ASSERT `s 155D(1) the subsection bars the person from acting as a director or taking part in the management of the company` `s 155D section 56 of the VCC Act` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 155D(2) the person is guilty of the offence this subsection creates` TRUE EQUALS JUST TRUE
#ASSERT `s 155D(2) the person is guilty of the offence this subsection creates` FALSE EQUALS JUST FALSE
#ASSERT `s 155D(2) the most the person may be penalised on conviction` TRUE EQUALS JUST (`s 155D(2) penalty` OF 10000, 24, TRUE)
#ASSERT `s 155D(2) the most the person may be penalised on conviction` FALSE EQUALS NOTHING

-- s 155D(3): "A person who is subject to a disqualification or disqualification order mentioned in sections 56, 58, 59 and 60 of the VCC Act may apply to the Court ... upon giving the Minister not less than 14 days' notice" (section 57 is not named)
-- section 56
#ASSERT `s 155D(3) the person may apply to the Court for permission to act as a director or to take part in the management of a company` `s 155D section 56 of the VCC Act` (Date 1 1 2026) (Date 15 1 2026) EQUALS JUST TRUE
-- section 58
#ASSERT `s 155D(3) the person may apply to the Court for permission to act as a director or to take part in the management of a company` `s 155D section 58 of the VCC Act` (Date 1 1 2026) (Date 15 1 2026) EQUALS JUST TRUE
-- section 59
#ASSERT `s 155D(3) the person may apply to the Court for permission to act as a director or to take part in the management of a company` `s 155D section 59 of the VCC Act` (Date 1 1 2026) (Date 15 1 2026) EQUALS JUST TRUE
-- section 60
#ASSERT `s 155D(3) the person may apply to the Court for permission to act as a director or to take part in the management of a company` `s 155D section 60 of the VCC Act` (Date 1 1 2026) (Date 15 1 2026) EQUALS JUST TRUE
-- 13 days
#ASSERT `s 155D(3) the person may apply to the Court for permission to act as a director or to take part in the management of a company` `s 155D section 60 of the VCC Act` (Date 2 1 2026) (Date 15 1 2026) EQUALS JUST FALSE
-- section 57 is not named in subsection (3)
#ASSERT `s 155D(3) the person may apply to the Court for permission to act as a director or to take part in the management of a company` `s 155D section 57 of the VCC Act` (Date 1 1 2026) (Date 15 1 2026) EQUALS NOTHING
#ASSERT `s 155D(4) the Minister may be represented at the hearing and may oppose the granting of the application` TRUE EQUALS JUST TRUE
#ASSERT `s 155D(4) the Minister may be represented at the hearing and may oppose the granting of the application` FALSE EQUALS JUST FALSE

-- s 155E(2): "Subsection (1) applies from the date that the debarment order is made until such time as the Registrar cancels or suspends the order"
#ASSERT `s 155E(2) subsection (1) applies on the date asked` (Date 2 6 2026) (Date 1 6 2026) FALSE FALSE EQUALS JUST TRUE
-- on the date the order is made
#ASSERT `s 155E(2) subsection (1) applies on the date asked` (Date 1 6 2026) (Date 1 6 2026) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 155E(2) subsection (1) applies on the date asked` (Date 31 5 2026) (Date 1 6 2026) FALSE FALSE EQUALS JUST FALSE
-- cancelled
#ASSERT `s 155E(2) subsection (1) applies on the date asked` (Date 2 6 2026) (Date 1 6 2026) TRUE FALSE EQUALS JUST FALSE
-- suspended
#ASSERT `s 155E(2) subsection (1) applies on the date asked` (Date 2 6 2026) (Date 1 6 2026) FALSE TRUE EQUALS JUST FALSE

-- s 155E(1): "A person who has a debarment order made against him or her under section 59 of the VCC Act must not -- (a) except ... a company of which the person is a director immediately before ... act as director of any company; or (b) ... secretary"
#ASSERT `s 155E(1) the subsection bars the person from acting as director or secretary of the company` TRUE TRUE `s 155E(1)(a) director of a company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 155E(1) the subsection bars the person from acting as director or secretary of the company` TRUE TRUE `s 155E(1)(a) director of a company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 155E(1) the subsection bars the person from acting as director or secretary of the company` TRUE TRUE `s 155E(1)(b) secretary of a company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 155E(1) the subsection bars the person from acting as director or secretary of the company` TRUE TRUE `s 155E(1)(b) secretary of a company` FALSE TRUE EQUALS JUST FALSE
-- subsection (1) no longer applies
#ASSERT `s 155E(1) the subsection bars the person from acting as director or secretary of the company` TRUE FALSE `s 155E(1)(a) director of a company` FALSE FALSE EQUALS JUST FALSE
-- no debarment order under section 59 of the VCC Act
#ASSERT `s 155E(1) the subsection bars the person from acting as director or secretary of the company` FALSE TRUE `s 155E(1)(a) director of a company` FALSE FALSE EQUALS NOTHING
#ASSERT `s 155E(3) the person is guilty of the offence this subsection creates` TRUE EQUALS JUST TRUE
#ASSERT `s 155E(3) the person is guilty of the offence this subsection creates` FALSE EQUALS JUST FALSE
#ASSERT `s 155E(3) the most the person may be penalised on conviction` TRUE EQUALS JUST (`s 155E(3) penalty` OF 10000, 24, TRUE)
#ASSERT `s 155E(3) the most the person may be penalised on conviction` FALSE EQUALS NOTHING

-- Regulative rules: each #TRACE has an EXPECT line above it naming the outcome the text gives; each rule has a breach trace where the text allows one.

-- the forbidden act occurs
-- EXPECT BREACH
#TRACE `s 155B(2)(a) a person with a debarment order must not act as director of another company` "P" AT 0 WITH
    PARTY Individual "P" DOES `s 155B(2)(a) act as director of a company other than one of which the person was a director immediately before the order was made` AT 7

-- nothing happens
-- EXPECT RESIDUAL
#TRACE `s 155B(2)(a) a person with a debarment order must not act as director of another company` "P" AT 0 WITH
    WAITUNTIL 7

-- the forbidden act occurs
-- EXPECT BREACH
#TRACE `s 155B(2)(b) a person with a debarment order must not act as secretary of another company` "P" AT 0 WITH
    PARTY Individual "P" DOES `s 155B(2)(b) act as secretary of a company other than one of which the person was secretary immediately before the order was made` AT 7

-- nothing happens
-- EXPECT RESIDUAL
#TRACE `s 155B(2)(b) a person with a debarment order must not act as secretary of another company` "P" AT 0 WITH
    WAITUNTIL 7
