IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgm-schedules`

-- Tests of sgm-schedules.l4 (the Fourteenth, Fifteenth and Sixteenth Schedules). Every expected value is written from the text, beside the assertion.

§ `Fourteenth Schedule paragraph 2: a Singapore financial institution`
-- (licensed, approved, registered or regulated by the MAS; exempted from the MAS's licensing or regulation; exempted under the Financial Advisers Act; exempted under the Securities and Futures Act)
#ASSERT `sch 14 para 2 the person is a Singapore financial institution` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `sch 14 para 2 the person is a Singapore financial institution` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 14 para 2 the person is a Singapore financial institution` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 14 para 2 the person is a Singapore financial institution` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 14 para 2 the person is a Singapore financial institution` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 14 para 2 the person is a Singapore financial institution` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 14 para 2 the person is a Singapore financial institution` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 14 para 2 the person is a Singapore financial institution` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 14 para 2(a) the financial institution is within paragraph (a)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `sch 14 para 2(a) the financial institution is within paragraph (a)` TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 14 para 2(a) the financial institution is within paragraph (a)` FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 14 para 2(a) the financial institution is within paragraph (a)` FALSE TRUE EQUALS JUST FALSE
