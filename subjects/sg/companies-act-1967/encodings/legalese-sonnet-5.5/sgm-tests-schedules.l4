§ `Sixteenth Schedule paragraph 1: significant control`
#ASSERT `sch 16 para 1(a) the person has significant control by the right to appoint or remove the directors` TRUE
#ASSERT NOT (`sch 16 para 1(a) the person has significant control by the right to appoint or remove the directors` FALSE)
#ASSERT NOT (`sch 16 para 1(b) the person has significant control by holding more than 25% of the rights to vote` 25)
#ASSERT `sch 16 para 1(b) the person has significant control by holding more than 25% of the rights to vote` 25.01
#ASSERT `sch 16 para 1(b) the person has significant control by holding more than 25% of the rights to vote` 26
#ASSERT NOT (`sch 16 para 1(b) the person has significant control by holding more than 25% of the rights to vote` 0)
-- (the right to appoint or remove directors; the percentage of the rights to vote; significant influence or control)
#ASSERT `sch 16 para 1 the person has significant control over the company or foreign company` TRUE 0 FALSE EQUALS JUST TRUE
#ASSERT `sch 16 para 1 the person has significant control over the company or foreign company` FALSE 26 FALSE EQUALS JUST TRUE
#ASSERT `sch 16 para 1 the person has significant control over the company or foreign company` FALSE 0 TRUE EQUALS JUST TRUE
#ASSERT `sch 16 para 1 the person has significant control over the company or foreign company` FALSE 25 FALSE EQUALS JUST FALSE
#ASSERT `sch 16 para 1 the person has significant control over the company or foreign company` FALSE 0 FALSE EQUALS JUST FALSE
§ `Sixteenth Schedule paragraphs 2 and 3: significant interest`
-- (the percentage of the shares in which the person has an interest; an interest in one or more voting shares; the percentage of the total voting power those votes make up)
#ASSERT `sch 16 para 2(1) the person has a significant interest in the company or foreign company having a share capital` 26 FALSE 0 EQUALS JUST TRUE
#ASSERT `sch 16 para 2(1) the person has a significant interest in the company or foreign company having a share capital` 25 FALSE 0 EQUALS JUST FALSE
#ASSERT `sch 16 para 2(1) the person has a significant interest in the company or foreign company having a share capital` 10 TRUE 26 EQUALS JUST TRUE
#ASSERT `sch 16 para 2(1) the person has a significant interest in the company or foreign company having a share capital` 10 TRUE 25 EQUALS JUST FALSE
#ASSERT `sch 16 para 2(1) the person has a significant interest in the company or foreign company having a share capital` 10 FALSE 60 EQUALS JUST FALSE
#ASSERT `sch 16 para 2(1) the person has a significant interest in the company or foreign company having a share capital` 25 TRUE 25 EQUALS JUST FALSE
#ASSERT `sch 16 para 2(2) the share is a voting share for sub-paragraph (1)(b)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 16 para 2(2) the share is a voting share for sub-paragraph (1)(b)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 16 para 2(2) the share is a voting share for sub-paragraph (1)(b)` TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 16 para 2(2) the share is a voting share for sub-paragraph (1)(b)` FALSE FALSE EQUALS NOTHING
-- (the percentage of the capital the person has a right to share in; the percentage of the profits)
#ASSERT `sch 16 para 3 the person has a significant interest in the company or foreign company that does not have a share capital` 26 0 EQUALS JUST TRUE
#ASSERT `sch 16 para 3 the person has a significant interest in the company or foreign company that does not have a share capital` 0 26 EQUALS JUST TRUE
#ASSERT `sch 16 para 3 the person has a significant interest in the company or foreign company that does not have a share capital` 25 25 EQUALS JUST FALSE
#ASSERT `sch 16 para 3 the person has a significant interest in the company or foreign company that does not have a share capital` 0 0 EQUALS JUST FALSE
§ `Sixteenth Schedule paragraph 4: supplementary provisions`
#ASSERT `sch 16 para 4(1) the subsection of section 7 applies in determining whether the person has an interest in a share` TRUE EQUALS JUST TRUE
#ASSERT `sch 16 para 4(1) the subsection of section 7 applies in determining whether the person has an interest in a share` FALSE EQUALS NOTHING
#ASSERT `sch 16 para 4(2) each of the persons is considered as having an interest in the share, or as holding the right` TRUE EQUALS JUST TRUE
#ASSERT `sch 16 para 4(2) each of the persons is considered as having an interest in the share, or as holding the right` FALSE EQUALS JUST FALSE
#ASSERT `sch 16 para 4(3) each of them is treated as having an interest in the combined shares of both of them` TRUE EQUALS JUST TRUE
#ASSERT `sch 16 para 4(3) each of them is treated as having an interest in the combined shares of both of them` FALSE EQUALS JUST FALSE
-- (a joint arrangement between them; the person's percentage; the other person's percentage)
#ASSERT `sch 16 para 4(3) the percentage of the shares in which the person is treated as having an interest` TRUE 15 12 EQUALS 27
#ASSERT `sch 16 para 4(3) the percentage of the shares in which the person is treated as having an interest` FALSE 15 12 EQUALS 15
#ASSERT `sch 16 para 4(4) each of them is treated as holding the combined rights of both of them` TRUE EQUALS JUST TRUE
#ASSERT `sch 16 para 4(4) each of them is treated as holding the combined rights of both of them` FALSE EQUALS JUST FALSE
#ASSERT `sch 16 para 4(4) the percentage of the rights the person is treated as holding` TRUE 10 20 EQUALS 30
#ASSERT `sch 16 para 4(4) the percentage of the rights the person is treated as holding` FALSE 10 20 EQUALS 10
#ASSERT `sch 16 para 4(5) the share or right is considered as held by the person for whom it is held as nominee` TRUE EQUALS JUST TRUE
#ASSERT `sch 16 para 4(5) the share or right is considered as held by the person for whom it is held as nominee` FALSE EQUALS NOTHING
#ASSERT `sch 16 para 4(5) the share or right is considered as held by the nominee` TRUE EQUALS JUST FALSE
#ASSERT `sch 16 para 4(5) the share or right is considered as held by the nominee` FALSE EQUALS NOTHING
#ASSERT `sch 16 para 4(6)(a) the arrangement is a joint arrangement` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 16 para 4(6)(a) the arrangement is a joint arrangement` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `sch 16 para 4(6)(a) the arrangement is a joint arrangement` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `sch 16 para 4(6)(a) the arrangement is a joint arrangement` TRUE TRUE FALSE EQUALS JUST FALSE
-- (a scheme, agreement or understanding; a convention, custom or practice; some degree of stability)
#ASSERT `sch 16 para 4(6)(b) the thing counts as an arrangement` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `sch 16 para 4(6)(b) the thing counts as an arrangement` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `sch 16 para 4(6)(b) the thing counts as an arrangement` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `sch 16 para 4(6)(b) the thing counts as an arrangement` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `sch 16 para 4(6)(b) the thing counts as an arrangement` FALSE FALSE TRUE EQUALS NOTHING
