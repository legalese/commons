IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-definitions`
IMPORT `sgl-agm`

-- Tests for sgl-agm.l4 (ss 175 and 175A). Expected values were decided from the text before the module was run.
-- Period counting (a period of months from 31 August ends on 28 February) is the keel's convention P4, assumed and not ruled.

§ `s 175(1) and (5): the months, the last day, the duty`

-- arguments: public company; admitted to the official list; removed from the list; the Minister's substituted number of months
#ASSERT `s 175(1) and (5) the number of months within which the annual general meeting must be held` TRUE TRUE FALSE NOTHING EQUALS 4
#ASSERT `s 175(1) and (5) the number of months within which the annual general meeting must be held` TRUE FALSE FALSE NOTHING EQUALS 6
#ASSERT `s 175(1) and (5) the number of months within which the annual general meeting must be held` TRUE TRUE TRUE NOTHING EQUALS 6
#ASSERT `s 175(1) and (5) the number of months within which the annual general meeting must be held` FALSE TRUE FALSE NOTHING EQUALS 6
#ASSERT `s 175(1) and (5) the number of months within which the annual general meeting must be held` FALSE FALSE FALSE NOTHING EQUALS 6
#ASSERT `s 175(1) and (5) the number of months within which the annual general meeting must be held` TRUE TRUE FALSE (JUST 5) EQUALS 5
#ASSERT `s 175(1) and (5) the number of months within which the annual general meeting must be held` FALSE FALSE FALSE (JUST 8) EQUALS 8
-- the financial year ends 31 December 2025
#ASSERT `s 175(1) and (2) the last day for the annual general meeting` (Date 31 12 2025) 6 NOTHING EQUALS Date 30 6 2026
#ASSERT `s 175(1) and (2) the last day for the annual general meeting` (Date 31 12 2025) 4 NOTHING EQUALS Date 30 4 2026
#ASSERT `s 175(1) and (2) the last day for the annual general meeting` (Date 31 8 2025) 6 NOTHING EQUALS Date 28 2 2026
-- the Registrar extends the period to 31 August 2026 (later than 30 June 2026), or to a date that is not later
#ASSERT `s 175(1) and (2) the last day for the annual general meeting` (Date 31 12 2025) 6 (JUST (Date 31 8 2026)) EQUALS Date 31 8 2026
#ASSERT `s 175(1) and (2) the last day for the annual general meeting` (Date 31 12 2025) 6 (JUST (Date 1 5 2026)) EQUALS Date 30 6 2026
#ASSERT `s 175(1) the company must hold an annual general meeting for the financial year` FALSE EQUALS JUST TRUE
#ASSERT `s 175(1) the company must hold an annual general meeting for the financial year` TRUE EQUALS JUST FALSE
-- held after the end of the year and not later than the last day (30 June 2026)
#ASSERT `s 175(1) the annual general meeting is held in time` (Date 31 12 2025) (Date 30 6 2026) (Date 1 1 2026) EQUALS JUST TRUE
#ASSERT `s 175(1) the annual general meeting is held in time` (Date 31 12 2025) (Date 30 6 2026) (Date 30 6 2026) EQUALS JUST TRUE
#ASSERT `s 175(1) the annual general meeting is held in time` (Date 31 12 2025) (Date 30 6 2026) (Date 1 7 2026) EQUALS JUST FALSE
#ASSERT `s 175(1) the annual general meeting is held in time` (Date 31 12 2025) (Date 30 6 2026) (Date 31 12 2025) EQUALS JUST FALSE
#ASSERT `s 175(1) the number of days from the end of the financial year to the last day for the annual general meeting` (Date 31 12 2025) (Date 30 6 2026) EQUALS 181
-- the seam: the keel's s 4(1) "annual general meeting" asks "the meeting is a meeting of the company required to be held by section 175"
#ASSERT `s 175(1) the meeting is the annual general meeting the section requires` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 175(1) the meeting is the annual general meeting the section requires` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 175(1) the meeting is the annual general meeting the section requires` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 175(1) the meeting is the annual general meeting the section requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 4(1) "annual general meeting" the meeting is an annual general meeting of the company` (`s 175(1) the meeting is the annual general meeting the section requires` TRUE TRUE FALSE EQUALS JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 4(1) "annual general meeting" the meeting is an annual general meeting of the company` (`s 175(1) the meeting is the annual general meeting the section requires` TRUE FALSE FALSE EQUALS JUST TRUE) EQUALS JUST FALSE
-- the duty as a regulative rule: time 0 is 31 December 2025; the last day, 30 June 2026, is day 181
-- EXPECT FULFILLED
#TRACE `s 175(1) the company must hold the annual general meeting` "Beta Pte Ltd" 181 AT 0 WITH
    PARTY Company "Beta Pte Ltd" DOES `s 175(1) hold the annual general meeting` AT 100
-- EXPECT FULFILLED
#TRACE `s 175(1) the company must hold the annual general meeting` "Beta Pte Ltd" 181 AT 0 WITH
    PARTY Company "Beta Pte Ltd" DOES `s 175(1) hold the annual general meeting` AT 181
-- EXPECT BREACH
#TRACE `s 175(1) the company must hold the annual general meeting` "Beta Pte Ltd" 181 AT 0 WITH
    PARTY Company "Beta Pte Ltd" DOES `s 175(1) hold the annual general meeting` AT 182
-- EXPECT BREACH
#TRACE `s 175(1) the company must hold the annual general meeting` "Beta Pte Ltd" 181 AT 0 WITH
    WAITUNTIL 182

§ `s 175(2) and (3)`

#ASSERT `s 175(2) the Registrar may extend the period` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 175(2) the Registrar may extend the period` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 175(2) the Registrar may extend the period` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 175(2) the Registrar may extend the period` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 175(2) the Registrar may extend the period` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 175(3) a general meeting may be held at any time` TRUE EQUALS JUST TRUE
#ASSERT `s 175(3) a general meeting may be held at any time` FALSE EQUALS NOTHING
#ASSERT `s 175(3) the company may resolve that the meeting is the annual general meeting` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 175(3) the company may resolve that the meeting is the annual general meeting` TRUE FALSE EQUALS NOTHING
#ASSERT `s 175(3) the company may resolve that the meeting is the annual general meeting` FALSE TRUE EQUALS NOTHING

§ `s 175(4): failure to hold the meeting`

#ASSERT `s 175(4)(a) the person is guilty of the offence this paragraph creates` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 175(4)(a) the person is guilty of the offence this paragraph creates` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 175(4)(a) the person is guilty of the offence this paragraph creates` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 175(4)(a) the person is guilty of the offence this paragraph creates` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 175(4)(a) the most the person may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (Penalty OF 5000, 0, FALSE, TRUE)
#ASSERT `s 175(4)(a) the most the person may be sentenced to on conviction` TRUE FALSE TRUE EQUALS JUST (Penalty OF 5000, 0, FALSE, TRUE)
#ASSERT `s 175(4)(a) the most the person may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 175(4)(b) the Court may on the application of the member order a general meeting to be called` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 175(4)(b) the Court may on the application of the member order a general meeting to be called` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 175(4)(b) the Court may on the application of the member order a general meeting to be called` FALSE TRUE EQUALS JUST FALSE

§ `s 175A(1): when a company need not hold an annual general meeting`

#ASSERT `s 175A(1)(a) the company need not hold an annual general meeting because of a resolution in force` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 175A(1)(a) the company need not hold an annual general meeting because of a resolution in force` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 175A(1)(a) the company need not hold an annual general meeting because of a resolution in force` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 175A(1)(b) the company need not hold an annual general meeting because it has sent the documents` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 175A(1)(b) the company need not hold an annual general meeting because it has sent the documents` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 175A(1)(b) the company need not hold an annual general meeting because it has sent the documents` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 175A(1)(c) the company need not hold an annual general meeting because it is a dormant relevant company` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 175A(1)(c) the company need not hold an annual general meeting because it is a dormant relevant company` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 175A(1)(c) the company need not hold an annual general meeting because it is a dormant relevant company` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 175A(1)(c) the company need not hold an annual general meeting because it is a dormant relevant company` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 175A(1) the company need not hold an annual general meeting for the financial year` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 175A(1) the company need not hold an annual general meeting for the financial year` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 175A(1) the company need not hold an annual general meeting for the financial year` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 175A(1) the company need not hold an annual general meeting for the financial year` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE

§ `s 175A(2) and (3)`

#ASSERT `s 175A(2) the resolution is treated as passed at a general meeting` 5 5 EQUALS JUST TRUE
#ASSERT `s 175A(2) the resolution is treated as passed at a general meeting` 1 1 EQUALS JUST TRUE
#ASSERT `s 175A(2) the resolution is treated as passed at a general meeting` 5 4 EQUALS JUST FALSE
#ASSERT `s 175A(2) the resolution is treated as passed at a general meeting` 5 0 EQUALS JUST FALSE
#ASSERT `s 175A(2) the resolution is treated as passed at a general meeting` 0 0 EQUALS JUST FALSE
#ASSERT `s 175A(3) the resolution has effect for the financial year` 2025 2025 EQUALS JUST TRUE
#ASSERT `s 175A(3) the resolution has effect for the financial year` 2025 2026 EQUALS JUST TRUE
#ASSERT `s 175A(3) the resolution has effect for the financial year` 2025 2024 EQUALS NOTHING
#ASSERT `s 175A(3) the resolution affects the liability` TRUE EQUALS JUST FALSE
#ASSERT `s 175A(3) the resolution affects the liability` FALSE EQUALS NOTHING

§ `s 175A(4) to (6): a member may require an annual general meeting`

-- the meeting would have been required by 30 June 2026; the latest day for the member's notice is 16 June 2026 (not later than 14 days before)
#ASSERT `s 175A(4) the latest day for the member's notice` (Date 30 6 2026) EQUALS Date 16 6 2026
#ASSERT `s 175A(4) the member may by notice require the holding of an annual general meeting` TRUE TRUE TRUE (Date 30 6 2026) (Date 16 6 2026) EQUALS JUST TRUE
#ASSERT `s 175A(4) the member may by notice require the holding of an annual general meeting` TRUE TRUE TRUE (Date 30 6 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 175A(4) the member may by notice require the holding of an annual general meeting` TRUE TRUE TRUE (Date 30 6 2026) (Date 17 6 2026) EQUALS JUST FALSE
#ASSERT `s 175A(4) the member may by notice require the holding of an annual general meeting` FALSE TRUE TRUE (Date 30 6 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `s 175A(4) the member may by notice require the holding of an annual general meeting` TRUE FALSE TRUE (Date 30 6 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `s 175A(4) the member may by notice require the holding of an annual general meeting` TRUE TRUE FALSE (Date 30 6 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `s 175A(5) the member has exercised the power under subsection (4)` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 175A(5) the member has exercised the power under subsection (4)` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 175A(5) the member has exercised the power under subsection (4)` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 175A(5) the member has exercised the power under subsection (4)` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 175A(6) section 175(1) and (4) apply to the calling of the meeting and the consequences of failure` TRUE EQUALS JUST TRUE
#ASSERT `s 175A(6) section 175(1) and (4) apply to the calling of the meeting and the consequences of failure` FALSE EQUALS JUST FALSE

§ `s 175A(7) to (11)`

#ASSERT `s 175A(7) the resolution has ceased to be in force` TRUE EQUALS JUST TRUE
#ASSERT `s 175A(7) the resolution has ceased to be in force` FALSE EQUALS JUST FALSE
-- the meeting would be required by 30 June 2026; less than 3 months remain after 30 March 2026
#ASSERT `s 175A(8) the company need not hold the annual general meeting after the resolution ceased` (Date 31 3 2026) (Date 30 6 2026) EQUALS JUST TRUE
#ASSERT `s 175A(8) the company need not hold the annual general meeting after the resolution ceased` (Date 30 3 2026) (Date 30 6 2026) EQUALS JUST FALSE
#ASSERT `s 175A(8) the company need not hold the annual general meeting after the resolution ceased` (Date 30 6 2026) (Date 30 6 2026) EQUALS JUST TRUE
#ASSERT `s 175A(8) the company need not hold the annual general meeting after the resolution ceased` (Date 1 7 2026) (Date 30 6 2026) EQUALS JUST FALSE
#ASSERT `s 175A(8) the company need not hold the annual general meeting after the resolution ceased` (Date 1 1 2026) (Date 30 6 2026) EQUALS JUST FALSE
#ASSERT `s 175A(9) subsection (8) relieves the company of the meeting the member required` TRUE EQUALS JUST FALSE
#ASSERT `s 175A(9) subsection (8) relieves the company of the meeting the member required` FALSE EQUALS NOTHING
-- (10): arguments: the reference; contrary intention; company need not hold; the meeting is held; company mentioned in (1)(a) or (b); company mentioned in (1)(c)
#ASSERT `s 175A(10) how the reference is read for the financial year` `s 175A(10)(a) a reference to the doing of anything at an annual general meeting` FALSE TRUE FALSE TRUE FALSE EQUALS JUST `s 175A(10)(a) read as the doing of that thing by way of a resolution by written means under section 184A`
#ASSERT `s 175A(10) how the reference is read for the financial year` `s 175A(10)(a) a reference to the doing of anything at an annual general meeting` TRUE TRUE FALSE TRUE FALSE EQUALS JUST `s 175A(10) the reference is not read differently`
#ASSERT `s 175A(10) how the reference is read for the financial year` `s 175A(10)(a) a reference to the doing of anything at an annual general meeting` FALSE FALSE FALSE TRUE FALSE EQUALS JUST `s 175A(10) the reference is not read differently`
#ASSERT `s 175A(10) how the reference is read for the financial year` `s 175A(10)(b) a reference to the date or conclusion of an annual general meeting` FALSE TRUE FALSE TRUE FALSE EQUALS JUST `s 175A(10)(b) read as the date of expiry of the period by which an annual general meeting would have been required under section 175 to be held`
#ASSERT `s 175A(10) how the reference is read for the financial year` `s 175A(10)(b) a reference to the date or conclusion of an annual general meeting` FALSE TRUE TRUE TRUE FALSE EQUALS JUST `s 175A(10) the reference is not read differently`
#ASSERT `s 175A(10) how the reference is read for the financial year` `s 175A(10)(c) the reference in section 197(1) or (1A) to the lodging of a return with the Registrar after its annual general meeting` FALSE TRUE FALSE TRUE FALSE EQUALS JUST `s 175A(10)(c)(i) read as the lodging of the return after the company has sent to all persons entitled to receive notice of general meetings the documents mentioned in section 203(1)`
#ASSERT `s 175A(10) how the reference is read for the financial year` `s 175A(10)(c) the reference in section 197(1) or (1A) to the lodging of a return with the Registrar after its annual general meeting` FALSE TRUE FALSE FALSE TRUE EQUALS JUST `s 175A(10)(c)(ii) read as the lodging of the return after the end of its financial year`
#ASSERT `s 175A(10) how the reference is read for the financial year` `s 175A(10)(c) the reference in section 197(1) or (1A) to the lodging of a return with the Registrar after its annual general meeting` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 175A(11) the thing is within the word address of a person` TRUE EQUALS JUST TRUE
#ASSERT `s 175A(11) the thing is within the word address of a person` FALSE EQUALS NOTHING
