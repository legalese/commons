IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgb2-s162-loans-to-directors`

-- Tests for s 162. Every expected value is written from the text of the section, beside the assertion, before it was run.

§ `s 162(8) the family of a director`

#ASSERT `s 162(8) the person counts as the director or relevant director` `s 162(8) the director` EQUALS JUST TRUE
#ASSERT `s 162(8) the person counts as the director or relevant director` `s 162(8) the director's spouse` EQUALS JUST TRUE
#ASSERT `s 162(8) the person counts as the director or relevant director` `s 162(8) the director's son` EQUALS JUST TRUE
#ASSERT `s 162(8) the person counts as the director or relevant director` `s 162(8) the director's adopted son` EQUALS JUST TRUE
#ASSERT `s 162(8) the person counts as the director or relevant director` `s 162(8) the director's stepson` EQUALS JUST TRUE
#ASSERT `s 162(8) the person counts as the director or relevant director` `s 162(8) the director's daughter` EQUALS JUST TRUE
#ASSERT `s 162(8) the person counts as the director or relevant director` `s 162(8) the director's adopted daughter` EQUALS JUST TRUE
#ASSERT `s 162(8) the person counts as the director or relevant director` `s 162(8) the director's stepdaughter` EQUALS JUST TRUE
-- "includes": a brother is not named, and the text does not say he is excluded: NOTHING.
#ASSERT `s 162(8) the person counts as the director or relevant director` `s 162(8) another person` EQUALS NOTHING

§ `s 162(11) and (12) the defined terms`

#ASSERT `s 162(11) "conditional sale agreement" the agreement is a conditional sale agreement` TRUE EQUALS JUST TRUE
#ASSERT `s 162(11) "conditional sale agreement" the agreement is a conditional sale agreement` FALSE EQUALS JUST FALSE

-- (a) hire-purchase, (a) conditional sale, (b) periodic hire, (c) deferred payment: each alone makes a credit transaction.
#ASSERT `s 162(11) "credit transaction" the transaction is a credit transaction` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 162(11) "credit transaction" the transaction is a credit transaction` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 162(11) "credit transaction" the transaction is a credit transaction` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 162(11) "credit transaction" the transaction is a credit transaction` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- "means": none of the three heads is a credit transaction (a sale for cash).
#ASSERT `s 162(11) "credit transaction" the transaction is a credit transaction` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- quasi-loan: pays or reimburses for the borrower, AND on reimbursement terms or in circumstances giving rise to the liability.
#ASSERT `s 162(11) "quasi-loan" the transaction is a quasi-loan` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 162(11) "quasi-loan" the transaction is a quasi-loan` FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 162(11) "quasi-loan" the transaction is a quasi-loan` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 162(11) "quasi-loan" the transaction is a quasi-loan` FALSE FALSE TRUE TRUE EQUALS JUST FALSE

#ASSERT `s 162(11) "services" the thing is services` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 162(11) "services" the thing is services` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 162(11) "services" the thing is services` FALSE TRUE EQUALS JUST FALSE

#ASSERT `s 162(12)(a) the person is the person to whom the quasi-loan is made` TRUE EQUALS JUST TRUE
#ASSERT `s 162(12)(a) the person is the person to whom the quasi-loan is made` FALSE EQUALS JUST FALSE
#ASSERT `s 162(12)(b) the liability is within the liabilities of the borrower under the quasi-loan` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 162(12)(b) the liability is within the liabilities of the borrower under the quasi-loan` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 162(12)(b) the liability is within the liabilities of the borrower under the quasi-loan` FALSE FALSE EQUALS NOTHING
#ASSERT `s 162(12)(c) the person is the person for whose benefit the credit transaction is entered into` TRUE EQUALS JUST TRUE
#ASSERT `s 162(12)(c) the person is the person for whose benefit the credit transaction is entered into` FALSE EQUALS JUST FALSE
-- (d): includes the transfer of choses in action / IP; otherwise anything other than goods or immovable property; goods or immovable property are not services.
#ASSERT `s 162(12)(d) the supply is a supply of services` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 162(12)(d) the supply is a supply of services` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 162(12)(d) the supply is a supply of services` TRUE FALSE EQUALS JUST FALSE

§ `s 162(1) the restricted transaction`

-- A director of the company: yes. A director of a deemed-related company: yes. Of neither: the text's own definition says no.
#ASSERT `s 162(1)(a) the person is a relevant director` `s 162(8) the director` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 162(1)(a) the person is a relevant director` `s 162(8) the director` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 162(1)(a) the person is a relevant director` `s 162(8) the director` FALSE FALSE EQUALS JUST FALSE
-- The director's spouse, where the director is a director of the company: counts (s 162(8)).
#ASSERT `s 162(1)(a) the person is a relevant director` `s 162(8) the director's spouse` TRUE FALSE EQUALS JUST TRUE
-- A relative the list does not name: the text does not say.
#ASSERT `s 162(1)(a) the person is a relevant director` `s 162(8) another person` TRUE FALSE EQUALS NOTHING
-- A spouse of someone who is a director of neither company: not a relevant director.
#ASSERT `s 162(1)(a) the person is a relevant director` `s 162(8) the director's spouse` FALSE FALSE EQUALS JUST FALSE

-- (a) loan or quasi-loan to a relevant director.
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1)(a) the company makes a loan or quasi-loan to a relevant director` (JUST TRUE) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1)(a) the company makes a loan or quasi-loan to a relevant director` (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1)(a) the company makes a loan or quasi-loan to a relevant director` NOTHING FALSE FALSE FALSE EQUALS NOTHING
-- (b), (c), (d) likewise depend on the relevant director.
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1)(b) the company enters into a guarantee or provides security in connection with a loan or quasi-loan made to a relevant director by another person` (JUST TRUE) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1)(c) the company enters into a credit transaction as creditor for the benefit of a relevant director` (JUST TRUE) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1)(d) the company enters into a guarantee or provides security in connection with a credit transaction entered into by any person for the benefit of a relevant director` (JUST TRUE) FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1)(d) the company enters into a guarantee or provides security in connection with a credit transaction entered into by any person for the benefit of a relevant director` (JUST FALSE) FALSE FALSE FALSE EQUALS JUST FALSE
-- (e) an arrangement: both limbs (the other's transaction would have been restricted; the other obtains a benefit).
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1)(e) the company takes part in an arrangement` NOTHING TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1)(e) the company takes part in an arrangement` NOTHING TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1)(e) the company takes part in an arrangement` NOTHING FALSE TRUE FALSE EQUALS JUST FALSE
-- (f) arranging an assignment or assumption of a restricted transaction.
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1)(f) the company arranges the assignment to it or assumption by it of rights, obligations or liabilities` NOTHING FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1)(f) the company arranges the assignment to it or assumption by it of rights, obligations or liabilities` NOTHING FALSE FALSE FALSE EQUALS JUST FALSE
-- A dealing of none of the six kinds: not a restricted transaction.
#ASSERT `s 162(1) the company makes a restricted transaction` `s 162(1) some other dealing` (JUST TRUE) TRUE TRUE TRUE EQUALS JUST FALSE

-- (9) the arrangement's date, for (1)(e) only.
#ASSERT `s 162(9) the date on which the transaction is treated as entered into` TRUE (Date 12 3 2026) EQUALS JUST (Date 12 3 2026)
#ASSERT `s 162(9) the date on which the transaction is treated as entered into` FALSE (Date 12 3 2026) EQUALS NOTHING

-- (10) approval given after the transaction does not count as prior approval; same day or earlier: the text is silent.
#ASSERT `s 162(10) the approval counts as prior approval` (Date 2 5 2026) (Date 1 5 2026) EQUALS JUST FALSE
#ASSERT `s 162(10) the approval counts as prior approval` (Date 1 5 2026) (Date 1 5 2026) EQUALS NOTHING
#ASSERT `s 162(10) the approval counts as prior approval` (Date 30 4 2026) (Date 1 5 2026) EQUALS NOTHING

§ `s 162(2) the bar, and the regulative rule`

-- Not an exempt private company, no exception: barred.
#ASSERT `s 162(2) the section bars the company from making the restricted transaction` FALSE FALSE EQUALS JUST TRUE
-- Exempt private company: "other than": NOTHING.
#ASSERT `s 162(2) the section bars the company from making the restricted transaction` TRUE FALSE EQUALS NOTHING
-- Within an exception: "nothing in this section applies": the text says no, in its own words.
#ASSERT `s 162(2) the section bars the company from making the restricted transaction` FALSE TRUE EQUALS JUST FALSE
-- Both an exempt private company and within an exception: the exempt company is outside the bar's reach, so NOTHING.
#ASSERT `s 162(2) the section bars the company from making the restricted transaction` TRUE TRUE EQUALS NOTHING

-- EXPECT BREACH. BREACH path: the company makes a restricted transaction outside every exception.
#TRACE `s 162(2) a company other than an exempt private company must not make a restricted transaction` "Acme Pte Ltd" FALSE FALSE AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 162(2) make a restricted transaction` AT 1

-- EXPECT FULFILLED. An exempt private company: nothing to forbid.
#TRACE `s 162(2) a company other than an exempt private company must not make a restricted transaction` "Acme Pte Ltd" TRUE FALSE AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 162(2) make a restricted transaction` AT 1

-- EXPECT FULFILLED. Within an exception: nothing to forbid.
#TRACE `s 162(2) a company other than an exempt private company must not make a restricted transaction` "Acme Pte Ltd" FALSE TRUE AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 162(2) make a restricted transaction` AT 1

-- EXPECT RESIDUAL. The prohibition stands while nothing is done.
#TRACE `s 162(2) a company other than an exempt private company must not make a restricted transaction` "Acme Pte Ltd" FALSE FALSE AT 0 WITH

§ `s 162(3) and (4) the exceptions`

-- (3)(a) expenditure for the company's purposes, with (4) satisfied.
#ASSERT `s 162(3) the transaction is within an exception in subsection (3)` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- (3)(a) without (4): not within.
#ASSERT `s 162(3) the transaction is within an exception in subsection (3)` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (3)(b) home loan, none other outstanding, (4) satisfied.
#ASSERT `s 162(3) the transaction is within an exception in subsection (3)` FALSE TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- (3)(b) home loan with another outstanding ("except that not more than one ... may be outstanding"): not within.
#ASSERT `s 162(3) the transaction is within an exception in subsection (3)` FALSE TRUE TRUE FALSE FALSE TRUE EQUALS NOTHING
-- (3)(b) without (4): not within.
#ASSERT `s 162(3) the transaction is within an exception in subsection (3)` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (3)(c) scheme approved at a general meeting: (4) does not condition it.
#ASSERT `s 162(3) the transaction is within an exception in subsection (3)` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- (3)(d) the lending company's ordinary course of business: (4) does not condition it.
#ASSERT `s 162(3) the transaction is within an exception in subsection (3)` FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- none of (a) to (d): the list is not closed with "only".
#ASSERT `s 162(3) the transaction is within an exception in subsection (3)` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING

-- (4)(a): prior approval at a general meeting disclosing the purposes and the amount.
#ASSERT `s 162(4) subsection (3)(a) or (b) authorises the making of the restricted transaction` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- (4)(a) missing a disclosure: not authorised unless (b).
#ASSERT `s 162(4) subsection (3)(a) or (b) authorises the making of the restricted transaction` TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 162(4) subsection (3)(a) or (b) authorises the making of the restricted transaction` TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 162(4) subsection (3)(a) or (b) authorises the making of the restricted transaction` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (4)(b): made on the repayment condition.
#ASSERT `s 162(4) subsection (3)(a) or (b) authorises the making of the restricted transaction` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- A transaction outside (3)(a) and (b): the subsection says nothing.
#ASSERT `s 162(4) subsection (3)(a) or (b) authorises the making of the restricted transaction` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING

-- (4)(b) the 6 months run from the conclusion of the meeting (the day itself not counted): meeting concludes 28 February 2026 -> 28 August 2026.
#ASSERT `s 162(4)(b) the last day on which the amount or liability must be repaid or discharged` (Date 28 2 2026) EQUALS Date 28 8 2026
-- A meeting concluding 31 August 2026: 6 months later is 28 February 2027 (the short month clamps: P4).
#ASSERT `s 162(4)(b) the last day on which the amount or liability must be repaid or discharged` (Date 31 8 2026) EQUALS Date 28 2 2027
#ASSERT `s 162(4)(b) the amount was repaid or the liability discharged within 6 months from the conclusion of the meeting` (Date 28 2 2026) (Date 28 8 2026) EQUALS TRUE
#ASSERT `s 162(4)(b) the amount was repaid or the liability discharged within 6 months from the conclusion of the meeting` (Date 28 2 2026) (Date 29 8 2026) EQUALS FALSE

§ `s 162(5) the directors' indemnity`

-- Made on the (4)(b) condition and approval never given by the next AGM: the directors who authorised it are liable.
#ASSERT `s 162(5) the directors who authorised the transaction are jointly and severally liable to indemnify the company against any loss` TRUE FALSE EQUALS JUST TRUE
-- Approval given at or before the next AGM: "Where the prior approval ... is not given": the gate fails, no liability under (5).
#ASSERT `s 162(5) the directors who authorised the transaction are jointly and severally liable to indemnify the company against any loss` TRUE TRUE EQUALS JUST FALSE
-- Not made on the (4)(b) condition: (5) says nothing.
#ASSERT `s 162(5) the directors who authorised the transaction are jointly and severally liable to indemnify the company against any loss` FALSE FALSE EQUALS NOTHING

§ `s 162(6) the offence and its penalty`

#ASSERT `s 162(6) the director is guilty of the offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 162(6) the director is guilty of the offence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 162(6) the director is guilty of the offence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 162(6) the director is guilty of the offence` FALSE FALSE EQUALS JUST FALSE
-- "a fine not exceeding $20,000 or to imprisonment for a term not exceeding 2 years".
#ASSERT `s 162(6) the most the director may be sentenced to on conviction` TRUE TRUE EQUALS JUST (`s 162(6) penalty` OF 20000, 2)
#ASSERT `s 162(6) the most the director may be sentenced to on conviction` TRUE FALSE EQUALS NOTHING
#ASSERT `s 162(6) the most the director may be sentenced to on conviction` FALSE TRUE EQUALS NOTHING

§ `s 162(7) the company's recovery`

#ASSERT `s 162(7) section 162 operates to prevent the company from recovering the amount` TRUE EQUALS JUST FALSE
#ASSERT `s 162(7) section 162 operates to prevent the company from recovering the amount` FALSE EQUALS NOTHING
