IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgc1-s201-departures`
IMPORT `sgc1-s201`

-- Tests for sgc1-s201.l4 (s 201(1) to (11)). Expected values are written from the text, beside each assertion.

§ `s 201(1): the financial statements to be laid`

#ASSERT `s 201(1) the financial statements are the ones the directors must lay before the company at its annual general meeting` TRUE EQUALS JUST TRUE
-- statements for another financial year: not covered
#ASSERT `s 201(1) the financial statements are the ones the directors must lay before the company at its annual general meeting` FALSE EQUALS NOTHING

-- the meeting is 60 days on from the start of the trace
-- EXPECT FULFILLED (laid on day 59)
#TRACE `s 201(1) the directors of a company must lay the financial statements before the company at its annual general meeting` "Ann" 60 AT 0 WITH
    PARTY Director "Ann" DOES `s 201(1) lay the financial statements before the company at its annual general meeting` AT 59

-- EXPECT FULFILLED (laid at the meeting itself, day 60: the deadline is inclusive)
#TRACE `s 201(1) the directors of a company must lay the financial statements before the company at its annual general meeting` "Ann" 60 AT 0 WITH
    PARTY Director "Ann" DOES `s 201(1) lay the financial statements before the company at its annual general meeting` AT 60

-- EXPECT BREACH (not laid by the meeting)
#TRACE `s 201(1) the directors of a company must lay the financial statements before the company at its annual general meeting` "Ann" 60 AT 0 WITH
    WAITUNTIL 61

§ `s 201(2) and (5): what the documents must be like`

-- complies, true and fair
#ASSERT `s 201(2) the document complies with the Accounting Standards and gives a true and fair view` TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
-- no true and fair view: the duty is not met, whatever the departure (the override of (13) goes to compliance with the Standards, not to the true and fair view)
#ASSERT `s 201(2) the document complies with the Accounting Standards and gives a true and fair view` TRUE FALSE (JUST TRUE) EQUALS JUST FALSE
-- departs from the Standards, but the departure is allowed by (12), (13) or (15A)
#ASSERT `s 201(2) the document complies with the Accounting Standards and gives a true and fair view` FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
-- departs, and no departure is allowed
#ASSERT `s 201(2) the document complies with the Accounting Standards and gives a true and fair view` FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
-- departs, and whether a departure is allowed is not decided
#ASSERT `s 201(2) the document complies with the Accounting Standards and gives a true and fair view` FALSE TRUE NOTHING EQUALS NOTHING

-- parent company: both documents
#ASSERT `s 201(5) the directors need not comply with subsection (1) but must lay the consolidated financial statements and the balance sheet` TRUE EQUALS JUST TRUE
-- not a parent company: the subsection says nothing of it
#ASSERT `s 201(5) the directors need not comply with subsection (1) but must lay the consolidated financial statements and the balance sheet` FALSE EQUALS NOTHING
#ASSERT `s 201(5) the consolidated financial statements and the balance sheet are as the subsection requires` TRUE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST TRUE
-- the consolidated statements fail
#ASSERT `s 201(5) the consolidated financial statements and the balance sheet are as the subsection requires` TRUE FALSE TRUE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 201(5) the consolidated financial statements and the balance sheet are as the subsection requires` TRUE TRUE FALSE TRUE TRUE (JUST FALSE) EQUALS JUST FALSE
-- the balance sheet fails
#ASSERT `s 201(5) the consolidated financial statements and the balance sheet are as the subsection requires` TRUE TRUE TRUE FALSE TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 201(5) the consolidated financial statements and the balance sheet are as the subsection requires` TRUE TRUE TRUE TRUE FALSE (JUST FALSE) EQUALS JUST FALSE
-- a departure from the Standards that is allowed covers both documents
#ASSERT `s 201(5) the consolidated financial statements and the balance sheet are as the subsection requires` TRUE FALSE TRUE FALSE TRUE (JUST TRUE) EQUALS JUST TRUE
-- not a parent company: not covered
#ASSERT `s 201(5) the consolidated financial statements and the balance sheet are as the subsection requires` FALSE TRUE TRUE TRUE TRUE (JUST FALSE) EQUALS NOTHING
-- the consolidated statements depart and whether that is allowed is not decided
#ASSERT `s 201(5) the consolidated financial statements and the balance sheet are as the subsection requires` TRUE FALSE TRUE TRUE TRUE NOTHING EQUALS NOTHING

-- EXPECT FULFILLED
#TRACE `s 201(5) the directors of a parent company must cause to be made out and lay the consolidated financial statements and the balance sheet` "Ann" 60 AT 0 WITH
    PARTY Director "Ann" DOES `s 201(5) cause to be made out and lay the consolidated financial statements and the balance sheet of the parent company` AT 30

-- EXPECT BREACH
#TRACE `s 201(5) the directors of a parent company must cause to be made out and lay the consolidated financial statements and the balance sheet` "Ann" 60 AT 0 WITH
    WAITUNTIL 61

§ `s 201(7): the reasonable steps`

-- (a)
#ASSERT `s 201(7)(a) the directors have taken the reasonable steps as to bad debts and doubtful debts` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 201(7)(a) the directors have taken the reasonable steps as to bad debts and doubtful debts` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 201(7)(a) the directors have taken the reasonable steps as to bad debts and doubtful debts` TRUE FALSE EQUALS JUST FALSE
-- (b): ascertained, none unlikely to realise: nothing more to do
#ASSERT `s 201(7)(b) the directors have taken the reasonable steps as to current assets` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- ascertained, some unlikely, written down
#ASSERT `s 201(7)(b) the directors have taken the reasonable steps as to current assets` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- ascertained, some unlikely, provision made
#ASSERT `s 201(7)(b) the directors have taken the reasonable steps as to current assets` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- ascertained, some unlikely, neither
#ASSERT `s 201(7)(b) the directors have taken the reasonable steps as to current assets` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- not ascertained
#ASSERT `s 201(7)(b) the directors have taken the reasonable steps as to current assets` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (c): none overstated
#ASSERT `s 201(7)(c) the directors have taken the reasonable steps as to non-current assets` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- overstated, adequate provision for writing down made (the "unless")
#ASSERT `s 201(7)(c) the directors have taken the reasonable steps as to non-current assets` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- overstated, no provision, information included
#ASSERT `s 201(7)(c) the directors have taken the reasonable steps as to non-current assets` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- overstated, neither
#ASSERT `s 201(7)(c) the directors have taken the reasonable steps as to non-current assets` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 201(7)(c) the directors have taken the reasonable steps as to non-current assets` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- the financial statements are made out on day 20
-- EXPECT FULFILLED
#TRACE `s 201(7) the directors must take reasonable steps before the financial statements are made out` "Ann" 20 AT 0 WITH
    PARTY Director "Ann" DOES `s 201(7) take the reasonable steps as to bad debts, current assets and non-current assets` AT 19

-- EXPECT BREACH
#TRACE `s 201(7) the directors must take reasonable steps before the financial statements are made out` "Ann" 20 AT 0 WITH
    WAITUNTIL 21

§ `s 201(8) and (9): the audit`

#ASSERT `s 201(8) the financial statements have been audited and reported on as the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 201(8) the financial statements have been audited and reported on as the subsection requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 201(8) the financial statements have been audited and reported on as the subsection requires` TRUE FALSE EQUALS JUST FALSE

-- the meeting is on 30 June 2026: "not less than 14 days before" is 16 June 2026
#ASSERT `s 201(9)(a) the latest day by which the financial statements are to be audited` (Date 30 6 2026) FALSE EQUALS JUST (Date 16 6 2026)
-- a meeting on 5 March 2026: 14 days earlier crosses the end of February (2026 is not a leap year): 19 February 2026
#ASSERT `s 201(9)(a) the latest day by which the financial statements are to be audited` (Date 5 3 2026) FALSE EQUALS JUST (Date 19 2 2026)
-- all the persons entitled agree: no latest day
#ASSERT `s 201(9)(a) the latest day by which the financial statements are to be audited` (Date 30 6 2026) TRUE EQUALS NOTHING
-- both sides of the 14th day before
#ASSERT `s 201(9)(a) the financial statements have been audited in time` (Date 30 6 2026) (Date 16 6 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 201(9)(a) the financial statements have been audited in time` (Date 30 6 2026) (Date 17 6 2026) FALSE EQUALS JUST FALSE
-- audited less than 14 days before, but all the persons entitled agree
#ASSERT `s 201(9)(a) the financial statements have been audited in time` (Date 30 6 2026) (Date 25 6 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 201(9)(b) the directors have caused the auditor's report to be attached` TRUE EQUALS JUST TRUE
#ASSERT `s 201(9)(b) the directors have caused the auditor's report to be attached` FALSE EQUALS JUST FALSE

-- the meeting is on day 30 of the trace: the audit is to be done by day 16
-- EXPECT FULFILLED
#TRACE `s 201(9)(a) the directors must take reasonable steps to ensure that the financial statements are audited not less than 14 days before the annual general meeting` "Ann" 16 AT 0 WITH
    PARTY Director "Ann" DOES `s 201(9)(a) take reasonable steps to ensure that the financial statements are audited as required` AT 16

-- EXPECT BREACH
#TRACE `s 201(9)(a) the directors must take reasonable steps to ensure that the financial statements are audited not less than 14 days before the annual general meeting` "Ann" 16 AT 0 WITH
    WAITUNTIL 17

-- EXPECT FULFILLED
#TRACE `s 201(9)(b) the directors must cause the auditor's report to be attached to the financial statements` "Ann" AT 0 WITH
    PARTY Director "Ann" DOES `s 201(9)(b) cause the auditor's report to be attached to the financial statements` AT 2

-- EXPECT RESIDUAL (no time limit and no consequence inside the paragraph: no trace reaches BREACH)
#TRACE `s 201(9)(b) the directors must cause the auditor's report to be attached to the financial statements` "Ann" AT 0 WITH

§ `s 201(10): the documents "financial statements" means`

#ASSERT `s 201(10) the documents that "financial statements" means in subsections (8) and (9)` FALSE EQUALS `s 201(10)(a) the financial statements required to be laid under subsection (1)`
#ASSERT `s 201(10) the documents that "financial statements" means in subsections (8) and (9)` TRUE EQUALS `s 201(10)(b) the consolidated financial statements of the group and the balance sheet of the parent company required to be laid under subsection (5)`

§ `s 201(11): the ultimate parent corporation`

#ASSERT `s 201(11) the directors must state the name of the ultimate parent corporation` TRUE EQUALS JUST TRUE
-- a company that is not a subsidiary company at the end of the financial year: the "where" fails
#ASSERT `s 201(11) the directors must state the name of the ultimate parent corporation` FALSE EQUALS JUST FALSE
#ASSERT `s 201(11) the directors have stated the name of the ultimate parent corporation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 201(11) the directors have stated the name of the ultimate parent corporation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 201(11) the directors have stated the name of the ultimate parent corporation` FALSE FALSE EQUALS NOTHING

-- EXPECT FULFILLED
#TRACE `s 201(11) the directors of a subsidiary company must state the name of its ultimate parent corporation` "Ann" AT 0 WITH
    PARTY Director "Ann" DOES `s 201(11) state the name of the ultimate parent corporation in the financial statements` AT 4
