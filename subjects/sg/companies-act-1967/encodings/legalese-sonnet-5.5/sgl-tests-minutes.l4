IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgl-minutes`

-- Tests for sgl-minutes.l4 (ss 188 and 189). Expected values were decided from the text before the module was run.
-- Period counting: one month after 31 January 2026 ends on 28 February 2026 (P4); one month after 1 March 2026 ends on 1 April 2026; 14 days after 1 March 2026 end on 15 March 2026.

§ `s 188(1): entering and signing the minutes`

-- arguments: the proceedings are of a general meeting or a meeting of the directors or chief executive officers; the day of the meeting; the day the minutes were entered
#ASSERT `s 188(1)(a) the number of days from the meeting to the last day for entering the minutes` (Date 1 3 2026) EQUALS 31
#ASSERT `s 188(1)(a) the number of days from the meeting to the last day for entering the minutes` (Date 31 1 2026) EQUALS 28
#ASSERT `s 188(1)(a) the company has caused the minutes to be entered in a book within one month` TRUE (Date 31 1 2026) (Date 28 2 2026) EQUALS JUST TRUE
#ASSERT `s 188(1)(a) the company has caused the minutes to be entered in a book within one month` TRUE (Date 31 1 2026) (Date 1 3 2026) EQUALS JUST FALSE
#ASSERT `s 188(1)(a) the company has caused the minutes to be entered in a book within one month` TRUE (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `s 188(1)(a) the company has caused the minutes to be entered in a book within one month` TRUE (Date 1 3 2026) (Date 2 4 2026) EQUALS JUST FALSE
#ASSERT `s 188(1)(a) the company has caused the minutes to be entered in a book within one month` TRUE (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 188(1)(a) the company has caused the minutes to be entered in a book within one month` FALSE (Date 1 3 2026) (Date 10 3 2026) EQUALS JUST FALSE
-- time 0 is the day of the meeting, 1 March 2026; the last day, 1 April, is day 31
-- EXPECT FULFILLED
#TRACE `s 188(1)(a) the company must cause the minutes to be entered in a book within one month` "Gamma Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 188(1)(a) enter the minutes in a book` AT 31
-- EXPECT BREACH
#TRACE `s 188(1)(a) the company must cause the minutes to be entered in a book within one month` "Gamma Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 188(1)(a) enter the minutes in a book` AT 32
-- EXPECT BREACH
#TRACE `s 188(1)(a) the company must cause the minutes to be entered in a book within one month` "Gamma Pte Ltd" (Date 1 3 2026) AT 0 WITH
    WAITUNTIL 32
-- arguments: signed by the chairperson of the meeting; signed by the chairperson of the next succeeding meeting
#ASSERT `s 188(1)(b) the minutes have been signed by the chairperson of the meeting or of the next succeeding meeting` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 188(1)(b) the minutes have been signed by the chairperson of the meeting or of the next succeeding meeting` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 188(1)(b) the minutes have been signed by the chairperson of the meeting or of the next succeeding meeting` FALSE FALSE EQUALS JUST FALSE

§ `s 188(2) and (3): minutes as evidence`

-- arguments: the minutes are entered in a book and purport to be signed; the contrary is proved
#ASSERT `s 188(2) the minutes are evidence of the proceedings to which they relate` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 188(2) the minutes are evidence of the proceedings to which they relate` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 188(2) the minutes are evidence of the proceedings to which they relate` FALSE FALSE EQUALS NOTHING
#ASSERT `s 188(2) the minutes are evidence of the proceedings to which they relate` FALSE TRUE EQUALS NOTHING
-- arguments: the minutes have been entered and signed; the contrary is proved
#ASSERT `s 188(3)(a) the meeting is deemed to have been duly held and convened` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 188(3)(a) the meeting is deemed to have been duly held and convened` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 188(3)(a) the meeting is deemed to have been duly held and convened` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 188(3)(b) all proceedings had at the meeting are deemed to have been duly had` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 188(3)(b) all proceedings had at the meeting are deemed to have been duly had` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 188(3)(b) all proceedings had at the meeting are deemed to have been duly had` TRUE TRUE EQUALS JUST FALSE
-- arguments: the minutes have been entered and signed; the appointment was made at the meeting; the contrary is proved
#ASSERT `s 188(3)(c) the appointment of the officer or liquidator is deemed to be valid` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 188(3)(c) the appointment of the officer or liquidator is deemed to be valid` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 188(3)(c) the appointment of the officer or liquidator is deemed to be valid` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 188(3)(c) the appointment of the officer or liquidator is deemed to be valid` TRUE TRUE TRUE EQUALS JUST FALSE

§ `s 188(3A) to (3D): sole directors and written resolutions`

-- arguments: the matter; the company has only one director
#ASSERT `s 188(3A) the duty to enter the matter applies` `s 188(3A)(a)(i) a resolution passed by the sole director` TRUE EQUALS TRUE
#ASSERT `s 188(3A) the duty to enter the matter applies` `s 188(3A)(a)(i) a resolution passed by the sole director` FALSE EQUALS FALSE
#ASSERT `s 188(3A) the duty to enter the matter applies` `s 188(3A)(a)(ii) a declaration made by the sole director` TRUE EQUALS TRUE
#ASSERT `s 188(3A) the duty to enter the matter applies` `s 188(3A)(a)(ii) a declaration made by the sole director` FALSE EQUALS FALSE
#ASSERT `s 188(3A) the duty to enter the matter applies` `s 188(3A)(b) a resolution passed by written means under section 184A` FALSE EQUALS TRUE
-- arguments: the matter; the company has only one director; the day passed or made; the day entered
#ASSERT `s 188(3A) the number of days from the passing or making to the last day for entering the matter` (Date 1 3 2026) EQUALS 31
#ASSERT `s 188(3A) the company has entered the matter in a minute book within one month` `s 188(3A)(b) a resolution passed by written means under section 184A` FALSE (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `s 188(3A) the company has entered the matter in a minute book within one month` `s 188(3A)(b) a resolution passed by written means under section 184A` FALSE (Date 1 3 2026) (Date 2 4 2026) EQUALS JUST FALSE
#ASSERT `s 188(3A) the company has entered the matter in a minute book within one month` `s 188(3A)(a)(i) a resolution passed by the sole director` TRUE (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `s 188(3A) the company has entered the matter in a minute book within one month` `s 188(3A)(a)(ii) a declaration made by the sole director` TRUE (Date 1 3 2026) (Date 2 4 2026) EQUALS JUST FALSE
#ASSERT `s 188(3A) the company has entered the matter in a minute book within one month` `s 188(3A)(a)(i) a resolution passed by the sole director` FALSE (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST FALSE
-- time 0 is the day the resolution is passed or the declaration made, 1 March 2026; the last day, 1 April, is day 31
-- EXPECT FULFILLED
#TRACE `s 188(3A) the company must cause the matter to be entered in a minute book within one month` "Gamma Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 188(3A) enter the matter in a minute book` AT 31
-- EXPECT BREACH
#TRACE `s 188(3A) the company must cause the matter to be entered in a minute book within one month` "Gamma Pte Ltd" (Date 1 3 2026) AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 188(3A) enter the matter in a minute book` AT 32
-- EXPECT BREACH
#TRACE `s 188(3A) the company must cause the matter to be entered in a minute book within one month` "Gamma Pte Ltd" (Date 1 3 2026) AT 0 WITH
    WAITUNTIL 32
-- arguments: the minutes are of a resolution mentioned in (3A)(b); signed by a director; signed within a reasonable time
#ASSERT `s 188(3B) the company has ensured that the minutes are signed by a director within a reasonable time` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 188(3B) the company has ensured that the minutes are signed by a director within a reasonable time` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 188(3B) the company has ensured that the minutes are signed by a director within a reasonable time` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 188(3B) the company has ensured that the minutes are signed by a director within a reasonable time` FALSE TRUE TRUE EQUALS JUST FALSE
-- arguments: the company has only one director; that director passed a resolution or made a declaration; the director signed; within a reasonable time
#ASSERT `s 188(3C) the sole director has signed the minutes within a reasonable time` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 188(3C) the sole director has signed the minutes within a reasonable time` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 188(3C) the sole director has signed the minutes within a reasonable time` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 188(3C) the sole director has signed the minutes within a reasonable time` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 188(3C) the sole director has signed the minutes within a reasonable time` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- arguments: the minutes are entered under (3A) and purportedly signed under (3B) or (3C); the contrary is proved
#ASSERT `s 188(3D) the minutes are evidence of the resolution or declaration to which they relate` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 188(3D) the minutes are evidence of the resolution or declaration to which they relate` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 188(3D) the minutes are evidence of the resolution or declaration to which they relate` FALSE FALSE EQUALS NOTHING

§ `s 188(4): the offence`

-- arguments: default is made in complying with section 188; the person is the company or an officer in default
#ASSERT `s 188(4) the person is guilty of the offence this subsection creates` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 188(4) the person is guilty of the offence this subsection creates` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 188(4) the person is guilty of the offence this subsection creates` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 188(4) the most the person may be sentenced to on conviction` TRUE TRUE EQUALS JUST (Penalty OF 2000, 0, FALSE, TRUE)
#ASSERT `s 188(4) the most the person may be sentenced to on conviction` FALSE TRUE EQUALS NOTHING
#ASSERT `s 188(4) the most the person may be sentenced to on conviction` TRUE FALSE EQUALS NOTHING

§ `s 189: inspection of minute books`

-- arguments: the book contains minutes of meetings of the directors or chief executive officers; the book contains minutes of the sole director's resolutions and declarations
#ASSERT `s 189(2A) the book is one to which subsections (1) and (2) do not apply` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 189(2A) the book is one to which subsections (1) and (2) do not apply` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 189(2A) the book is one to which subsections (1) and (2) do not apply` FALSE FALSE EQUALS NOTHING
-- arguments: the book is one mentioned in section 188(1) or (3A); the answer under subsection (2A)
#ASSERT `s 189(1) the company must keep the book at the registered office or the principal place of business in Singapore` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 189(1) the company must keep the book at the registered office or the principal place of business in Singapore` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 189(1) the company must keep the book at the registered office or the principal place of business in Singapore` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 189(1) the company must keep the book at the registered office or the principal place of business in Singapore` FALSE NOTHING EQUALS NOTHING
-- arguments: the book is one mentioned in section 188(1) or (3A); the answer under subsection (2A); the person is a member
#ASSERT `s 189(1) the book must be open to the inspection of the member without charge` TRUE NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 189(1) the book must be open to the inspection of the member without charge` TRUE NOTHING FALSE EQUALS NOTHING
#ASSERT `s 189(1) the book must be open to the inspection of the member without charge` TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 189(1) the book must be open to the inspection of the member without charge` FALSE NOTHING TRUE EQUALS NOTHING
-- arguments: the person is a member; a request in writing has been made; the minutes are specified in section 188(1) or (3A); the answer under subsection (2A)
#ASSERT `s 189(2) the member is entitled to be furnished with a copy of the minutes` TRUE TRUE TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 189(2) the member is entitled to be furnished with a copy of the minutes` TRUE FALSE TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 189(2) the member is entitled to be furnished with a copy of the minutes` TRUE TRUE FALSE NOTHING EQUALS JUST FALSE
#ASSERT `s 189(2) the member is entitled to be furnished with a copy of the minutes` TRUE TRUE TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 189(2) the member is entitled to be furnished with a copy of the minutes` FALSE TRUE TRUE NOTHING EQUALS NOTHING
-- request made on 1 March 2026: the last day is 15 March 2026
#ASSERT `s 189(2) the number of days from the request to the last day for furnishing the copy` (Date 1 3 2026) EQUALS 14
#ASSERT `s 189(2) the copy was furnished within 14 days after the request` (Date 1 3 2026) (Date 15 3 2026) EQUALS TRUE
#ASSERT `s 189(2) the copy was furnished within 14 days after the request` (Date 1 3 2026) (Date 16 3 2026) EQUALS FALSE
#ASSERT `s 189(2) the most the company may charge for the copy` 3 EQUALS 3
#ASSERT `s 189(2) the most the company may charge for the copy` 0 EQUALS 0
-- time 0 is the day the member makes the request; the last day, 15 March, is day 14
-- EXPECT FULFILLED
#TRACE `s 189(2) the company must furnish the member with a copy of the minutes within 14 days` "Gamma Pte Ltd" AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 189(2) furnish a copy of the minutes` AT 14
-- EXPECT BREACH
#TRACE `s 189(2) the company must furnish the member with a copy of the minutes within 14 days` "Gamma Pte Ltd" AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 189(2) furnish a copy of the minutes` AT 15
-- EXPECT BREACH
#TRACE `s 189(2) the company must furnish the member with a copy of the minutes within 14 days` "Gamma Pte Ltd" AT 0 WITH
    WAITUNTIL 15
-- arguments: a copy required under section 189 is not furnished; the person is the company or an officer in default
#ASSERT `s 189(3) the person is guilty of the offence this subsection creates` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 189(3) the person is guilty of the offence this subsection creates` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 189(3) the person is guilty of the offence this subsection creates` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 189(3) the most the person may be sentenced to on conviction` TRUE TRUE EQUALS JUST (Penalty OF 400, 0, FALSE, TRUE)
#ASSERT `s 189(3) the most the person may be sentenced to on conviction` FALSE TRUE EQUALS NOTHING

§ `Regulative rules of s 188(1)(b), (3B), (3C) and s 189(1): no time limit, no breach path`

-- no number of days and no consequence is stated for these three duties: a late act still reads FULFILLED, and with no act the trace stays RESIDUAL (see NOTES.md, Rules with no breach path)
-- EXPECT FULFILLED
#TRACE `s 188(1)(b) the company must cause the minutes to be signed by the chairperson (no time limit)` "Gamma Pte Ltd" AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 188(1)(b) have the minutes signed by the chairperson` AT 400
-- EXPECT RESIDUAL
#TRACE `s 188(1)(b) the company must cause the minutes to be signed by the chairperson (no time limit)` "Gamma Pte Ltd" AT 0 WITH
    WAITUNTIL 400
-- EXPECT FULFILLED
#TRACE `s 188(3B) the company must ensure that the minutes are signed by a director (no time limit)` "Gamma Pte Ltd" 7 AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 188(3B) ensure the minutes are signed by a director` AT 400
-- EXPECT RESIDUAL
#TRACE `s 188(3B) the company must ensure that the minutes are signed by a director (no time limit)` "Gamma Pte Ltd" 7 AT 0 WITH
    WAITUNTIL 400
-- EXPECT FULFILLED
#TRACE `s 188(3C) the sole director must sign the minutes (no time limit)` "Aiko Tan" 7 AT 0 WITH
    PARTY Director "Aiko Tan" DOES `s 188(3C) sign the minutes` AT 400
-- EXPECT RESIDUAL
#TRACE `s 188(3C) the sole director must sign the minutes (no time limit)` "Aiko Tan" 7 AT 0 WITH
    WAITUNTIL 400
-- EXPECT FULFILLED
#TRACE `s 189(1) the company must keep the books at the registered office or the principal place of business in Singapore (no time limit)` "Gamma Pte Ltd" AT 0 WITH
    PARTY Company "Gamma Pte Ltd" DOES `s 189(1) keep the books at the registered office or the principal place of business in Singapore` AT 400
-- EXPECT RESIDUAL
#TRACE `s 189(1) the company must keep the books at the registered office or the principal place of business in Singapore (no time limit)` "Gamma Pte Ltd" AT 0 WITH
    WAITUNTIL 400
