IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgn-evidence`

-- Tests for sgn-evidence.l4 (ss 386AD, 386AE). Expected values are written from the text beside each assertion.

§ `s 386AD(1): a corporation's state of mind`

-- arguments: the proceeding is for an offence under Part 11A; it is necessary to prove the corporation's state of mind; the kind of person;
-- the person acted within actual or apparent authority; the person had that state of mind
-- an officer, within authority, with the state of mind: evidence of the corporation's state of mind
#ASSERT `s 386AD(1) the evidence is evidence that the corporation had that state of mind` TRUE TRUE `s 386AD an officer of the body` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AD(1) the evidence is evidence that the corporation had that state of mind` TRUE TRUE `s 386AD an employee of the body` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AD(1) the evidence is evidence that the corporation had that state of mind` TRUE TRUE `s 386AD an agent of the body` TRUE TRUE EQUALS JUST TRUE
-- some other person (neither officer, employee nor agent): the subsection does not say
#ASSERT `s 386AD(1) the evidence is evidence that the corporation had that state of mind` TRUE TRUE `s 386AD some other person` TRUE TRUE EQUALS NOTHING
-- outside the scope of authority: paragraph (a) is not met
#ASSERT `s 386AD(1) the evidence is evidence that the corporation had that state of mind` TRUE TRUE `s 386AD an officer of the body` FALSE TRUE EQUALS NOTHING
-- the person did not have that state of mind: paragraph (b) is not met
#ASSERT `s 386AD(1) the evidence is evidence that the corporation had that state of mind` TRUE TRUE `s 386AD an officer of the body` TRUE FALSE EQUALS NOTHING
-- not a proceeding for an offence under the Part: the "where" fails
#ASSERT `s 386AD(1) the evidence is evidence that the corporation had that state of mind` FALSE TRUE `s 386AD an officer of the body` TRUE TRUE EQUALS JUST FALSE
-- it is not necessary to prove the state of mind: the "where" fails
#ASSERT `s 386AD(1) the evidence is evidence that the corporation had that state of mind` TRUE FALSE `s 386AD an officer of the body` TRUE TRUE EQUALS JUST FALSE

§ `s 386AD(2): an unincorporated association's or a partnership's state of mind`

-- employee or agent: yes; officer: subsection (2) names no officer
#ASSERT `s 386AD(2) the evidence is evidence that the unincorporated association or partnership had that state of mind` TRUE TRUE `s 386AD an employee of the body` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AD(2) the evidence is evidence that the unincorporated association or partnership had that state of mind` TRUE TRUE `s 386AD an agent of the body` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 386AD(2) the evidence is evidence that the unincorporated association or partnership had that state of mind` TRUE TRUE `s 386AD an officer of the body` TRUE TRUE EQUALS NOTHING
#ASSERT `s 386AD(2) the evidence is evidence that the unincorporated association or partnership had that state of mind` TRUE TRUE `s 386AD some other person` TRUE TRUE EQUALS NOTHING
#ASSERT `s 386AD(2) the evidence is evidence that the unincorporated association or partnership had that state of mind` TRUE TRUE `s 386AD an agent of the body` FALSE TRUE EQUALS NOTHING
#ASSERT `s 386AD(2) the evidence is evidence that the unincorporated association or partnership had that state of mind` TRUE TRUE `s 386AD an agent of the body` TRUE FALSE EQUALS NOTHING
#ASSERT `s 386AD(2) the evidence is evidence that the unincorporated association or partnership had that state of mind` FALSE TRUE `s 386AD an agent of the body` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 386AD(2) the evidence is evidence that the unincorporated association or partnership had that state of mind` TRUE FALSE `s 386AD an agent of the body` TRUE TRUE EQUALS JUST FALSE

§ `s 386AE(1): legal privilege`

-- arguments: the kind; connected with legal advice; connected with legal proceedings; intention of furthering a criminal purpose
-- (a) a communication between lawyer and client, in connection with legal advice
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1)(a) a communication between a lawyer and a client, or between a legal counsel acting as such and the legal counsel's employer` TRUE FALSE FALSE EQUALS JUST TRUE
-- (a) but not connected with legal advice
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1)(a) a communication between a lawyer and a client, or between a legal counsel acting as such and the legal counsel's employer` FALSE TRUE FALSE EQUALS JUST FALSE
-- (b) between two or more lawyers acting for a client, in connection with legal advice
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1)(b) a communication between 2 or more lawyers acting for a client, or between 2 or more legal counsel acting as such for their employer` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1)(b) a communication between 2 or more lawyers acting for a client, or between 2 or more legal counsel acting as such for their employer` FALSE FALSE FALSE EQUALS JUST FALSE
-- (c) with another person, for the purposes of legal proceedings
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1)(c) a communication between a client (or the employer of a legal counsel) and another person, between a lawyer acting for a client and the client or another person, or between a legal counsel acting as such and the employer or another person` FALSE TRUE FALSE EQUALS JUST TRUE
-- (c) connected only with advice, not with proceedings: not within (c)
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1)(c) a communication between a client (or the employer of a legal counsel) and another person, between a lawyer acting for a client and the client or another person, or between a legal counsel acting as such and the employer or another person` TRUE FALSE FALSE EQUALS JUST FALSE
-- (d) an item enclosed with a (a) or (b) communication, prepared in connection with legal advice
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1)(d) an item or document enclosed with or mentioned in a communication in paragraph (a) or (b)` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1)(d) an item or document enclosed with or mentioned in a communication in paragraph (a) or (b)` FALSE TRUE FALSE EQUALS JUST FALSE
-- (e) an item enclosed with a (c) communication, prepared for the purposes of legal proceedings
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1)(e) an item or document enclosed with or mentioned in a communication in paragraph (c)` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1)(e) an item or document enclosed with or mentioned in a communication in paragraph (c)` TRUE FALSE FALSE EQUALS JUST FALSE
-- the criminal purpose exception: any of (a) to (e) made to further a criminal purpose is not privileged
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1)(a) a communication between a lawyer and a client, or between a legal counsel acting as such and the legal counsel's employer` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1)(c) a communication between a client (or the employer of a legal counsel) and another person, between a lawyer acting for a client and the client or another person, or between a legal counsel acting as such and the employer or another person` FALSE TRUE TRUE EQUALS JUST FALSE
-- none of the five kinds
#ASSERT `s 386AE(1) the information or document is subject to legal privilege` `s 386AE(1) none of those kinds` TRUE TRUE FALSE EQUALS JUST FALSE

§ `s 386AE(2): client, employer, lawyer, legal counsel`

#ASSERT `s 386AE(2) "client" the person is within the word client` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AE(2) "client" the person is within the word client` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AE(2) "client" the person is within the word client` FALSE FALSE EQUALS NOTHING

#ASSERT `s 386AE(2) "employer" the person is within the word employer` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 386AE(2) "employer" the person is within the word employer` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AE(2) "employer" the person is within the word employer` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AE(2) "employer" the person is within the word employer` FALSE FALSE FALSE EQUALS NOTHING

#ASSERT `s 386AE(2) "lawyer" the person is a lawyer` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AE(2) "lawyer" the person is a lawyer` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AE(2) "lawyer" the person is a lawyer` FALSE FALSE EQUALS JUST FALSE

#ASSERT `s 386AE(2) "legal counsel" the person is a legal counsel` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 386AE(2) "legal counsel" the person is a legal counsel` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 386AE(2) "legal counsel" the person is a legal counsel` FALSE FALSE EQUALS JUST FALSE
