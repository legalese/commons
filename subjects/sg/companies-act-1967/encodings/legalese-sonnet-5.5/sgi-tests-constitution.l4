IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgi-constitution`

-- Tests for sgi-constitution.l4 (ss 35 to 40). Expected values are written from the text beside each assertion.

§ `s 35`

#ASSERT `s 35(1) the constitution of the company must contain the regulations for the company` FALSE EQUALS JUST TRUE
-- Subsection (2) excludes the company: "Subject to this section" (NOTHING).
#ASSERT `s 35(1) the constitution of the company must contain the regulations for the company` TRUE EQUALS NOTHING
-- (2): a company limited by shares incorporated before 3 January 2016.
#ASSERT `s 35(2) subsection (1) does not apply to the company` `limited by shares` (Date 2 1 2016) EQUALS JUST TRUE
#ASSERT `s 35(2) subsection (1) does not apply to the company` `limited by shares` (Date 3 1 2016) EQUALS NOTHING
#ASSERT `s 35(2) subsection (1) does not apply to the company` `limited by guarantee` (Date 2 1 2016) EQUALS NOTHING
#ASSERT `s 35(2) subsection (1) does not apply to the company` `unlimited` (Date 2 1 2016) EQUALS NOTHING
-- (3): arguments: regulations were in force immediately before 3 January 2016; the constitution has been amended to replace or amend them.
#ASSERT `s 35(3) the regulations are deemed to be the regulations for the company contained in its constitution` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 35(3) the regulations are deemed to be the regulations for the company contained in its constitution` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 35(3) the regulations are deemed to be the regulations for the company contained in its constitution` FALSE FALSE EQUALS NOTHING

§ `ss 36 to 38`

-- 36(1): arguments: a private company; the members' liability.
#ASSERT `s 36(1) the company is a specified company` TRUE `limited by shares` EQUALS JUST TRUE
#ASSERT `s 36(1) the company is a specified company` FALSE `limited by guarantee` EQUALS JUST TRUE
#ASSERT `s 36(1) the company is a specified company` FALSE `limited by shares` EQUALS JUST FALSE
#ASSERT `s 36(1) the company is a specified company` FALSE `unlimited` EQUALS JUST FALSE
-- 37(1): arguments: a specified company; the model constitution is the one prescribed for its type.
#ASSERT `s 37(1) the specified company may adopt the whole or any part of the model constitution as its constitution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 37(1) the specified company may adopt the whole or any part of the model constitution as its constitution` FALSE TRUE EQUALS NOTHING
#ASSERT `s 37(1) the specified company may adopt the whole or any part of the model constitution as its constitution` TRUE FALSE EQUALS NOTHING
-- 37(2): arguments: a specified company; adopts the whole; by reference to the title.
#ASSERT `s 37(2) the specified company may adopt the whole model constitution by reference to its title` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 37(2) the specified company may adopt the whole model constitution by reference to its title` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 37(2) the specified company may adopt the whole model constitution by reference to its title` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 37(2) the specified company may adopt the whole model constitution by reference to its title` TRUE TRUE FALSE EQUALS NOTHING
-- 37(3): arguments: adopts the whole; the choice.
#ASSERT `s 37(3) the specified company may choose` TRUE `s 37(3)(a) to adopt the model constitution as in force at the time of adoption` EQUALS JUST TRUE
#ASSERT `s 37(3) the specified company may choose` TRUE `s 37(3)(b) to adopt the model constitution as may be in force from time to time` EQUALS JUST TRUE
#ASSERT `s 37(3) the specified company may choose` TRUE `s 37(3) another choice` EQUALS NOTHING
#ASSERT `s 37(3) the specified company may choose` FALSE `s 37(3)(a) to adopt the model constitution as in force at the time of adoption` EQUALS NOTHING
#ASSERT `s 37(3)(b) the model constitution for the time being in force is, so far as applicable, the constitution of the specified company` TRUE EQUALS JUST TRUE
#ASSERT `s 37(3)(b) the model constitution for the time being in force is, so far as applicable, the constitution of the specified company` FALSE EQUALS JUST FALSE
-- 37(4): arguments: a specified company; adopts only part; includes additional provisions; includes object clauses.
#ASSERT `s 37(4) a copy of the constitution of the specified company must be submitted to the Registrar` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 37(4) a copy of the constitution of the specified company must be submitted to the Registrar` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 37(4) a copy of the constitution of the specified company must be submitted to the Registrar` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 37(4) a copy of the constitution of the specified company must be submitted to the Registrar` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 37(4) a copy of the constitution of the specified company must be submitted to the Registrar` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
-- The duty's time is fixed by section 19(1), outside this range: no trace reaches BREACH. The act done: FULFILLED. No act: the duty stands (RESIDUAL).
-- EXPECT FULFILLED
#TRACE `s 37(4) the specified company must submit a copy of its constitution to the Registrar` "Acme Pte. Ltd." AT 0 WITH
    PARTY Company "Acme Pte. Ltd." DOES `s 37(4) submit a copy of the constitution to the Registrar in accordance with section 19(1)` AT 5
-- EXPECT RESIDUAL
#TRACE `s 37(4) the specified company must submit a copy of its constitution to the Registrar` "Acme Pte. Ltd." AT 0 WITH
-- 38(1): arguments: the members' liability; the provision purports to give a right to participate in the divisible profits otherwise than as a member.
#ASSERT `s 38(1) the provision is void` `limited by guarantee` TRUE EQUALS JUST TRUE
#ASSERT `s 38(1) the provision is void` `limited by guarantee` FALSE EQUALS NOTHING
#ASSERT `s 38(1) the provision is void` `limited by shares` TRUE EQUALS NOTHING
-- Neither limb holds (a company limited by shares, a provision that gives no right to the profits): the subsection says nothing of that case, so NOTHING (fork line F-I32; the earlier pass answers FALSE).
#ASSERT `s 38(1) the provision is void` `limited by shares` FALSE EQUALS NOTHING
-- 38(2).
#ASSERT `s 38(2) the provision is treated as a provision for a share capital` `limited by guarantee` TRUE EQUALS JUST TRUE
#ASSERT `s 38(2) the provision is treated as a provision for a share capital` `limited by guarantee` FALSE EQUALS NOTHING
#ASSERT `s 38(2) the provision is treated as a provision for a share capital` `unlimited` TRUE EQUALS NOTHING

§ `ss 39 and 40`

-- 39(1): arguments: the constitution is registered; the person is the company or a member; this Act otherwise provides.
#ASSERT `s 39(1) the constitution binds the person to the same extent as if signed and sealed by each member` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 39(1) the constitution binds the person to the same extent as if signed and sealed by each member` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 39(1) the constitution binds the person to the same extent as if signed and sealed by each member` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 39(1) the constitution binds the person to the same extent as if signed and sealed by each member` TRUE TRUE TRUE EQUALS NOTHING
-- 39(2).
#ASSERT `s 39(2) the money is a debt due from the member to the company` TRUE EQUALS JUST TRUE
#ASSERT `s 39(2) the money is a debt due from the member to the company` FALSE EQUALS NOTHING
-- 39(3): arguments: made after the member became a member; requires more shares; increases the member's liability; the member agrees in writing.
#ASSERT `s 39(3) the member is bound by the alteration` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 39(3) the member is bound by the alteration` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 39(3) the member is bound by the alteration` TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 39(3) the member is bound by the alteration` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 39(3) the member is bound by the alteration` FALSE TRUE TRUE FALSE EQUALS NOTHING
-- 40(1): the sum is $5 or the lesser sum the directors fix. Arguments: the directors have fixed a sum; the sum.
#ASSERT `s 40(1) the sum the member must pay for a copy of the constitution` FALSE 0 EQUALS 5
#ASSERT `s 40(1) the sum the member must pay for a copy of the constitution` TRUE 3 EQUALS 3
#ASSERT `s 40(1) the sum the member must pay for a copy of the constitution` TRUE 5 EQUALS 5
#ASSERT `s 40(1) the sum the member must pay for a copy of the constitution` TRUE 8 EQUALS 5
-- Arguments: a member has required a copy; the company has a constitution; the member has paid.
#ASSERT `s 40(1) the company must send the member a copy of the constitution` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 40(1) the company must send the member a copy of the constitution` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 40(1) the company must send the member a copy of the constitution` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 40(1) the company must send the member a copy of the constitution` TRUE TRUE FALSE EQUALS JUST FALSE
-- No time is fixed, so no trace reaches BREACH.
-- EXPECT FULFILLED
#TRACE `s 40(1) the company must send a copy of the constitution to the member who requires it` "Acme Pte. Ltd." AT 0 WITH
    PARTY Company "Acme Pte. Ltd." DOES `s 40(1) send to the member a copy of the constitution` AT 5
-- EXPECT RESIDUAL
#TRACE `s 40(1) the company must send a copy of the constitution to the member who requires it` "Acme Pte. Ltd." AT 0 WITH
-- 40(2): arguments: an alteration is made; the day it is made; the day the copy is issued; the copy is in accordance with the alteration; the order or resolution is annexed and the clauses indicated.
#ASSERT `s 40(2) the company must not issue the copy of the constitution` TRUE (Date 1 3 2026) (Date 2 3 2026) FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 40(2) the company must not issue the copy of the constitution` TRUE (Date 1 3 2026) (Date 2 3 2026) TRUE FALSE EQUALS NOTHING
#ASSERT `s 40(2) the company must not issue the copy of the constitution` TRUE (Date 1 3 2026) (Date 2 3 2026) FALSE TRUE EQUALS NOTHING
-- A copy issued on the date of the alteration is not "after the date of alteration".
#ASSERT `s 40(2) the company must not issue the copy of the constitution` TRUE (Date 1 3 2026) (Date 1 3 2026) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 40(2) the company must not issue the copy of the constitution` FALSE (Date 1 3 2026) (Date 2 3 2026) FALSE FALSE EQUALS JUST FALSE
-- 40(4): the offence.
#ASSERT `s 40(4) the person is guilty of the offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 40(4) the person is guilty of the offence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 40(4) the person is guilty of the offence` FALSE TRUE EQUALS JUST FALSE
