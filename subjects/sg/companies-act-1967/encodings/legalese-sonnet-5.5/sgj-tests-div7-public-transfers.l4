IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgj-div7-public-transfers`

-- Tests for ss 130 to 130AE. Every expected value is written from the text of the section, not from the output of the code.
-- Argument orders are the orders of the GIVEN lists in sgj-div7-public-transfers.l4.
-- Dates: 1 February 2026 is a Sunday. 30 days after it ends on Tuesday 3 March 2026 (28 days to 1 March, 2 more), 42 days after it on 15 March, 60 days after it on 2 April.

§ `Section 130`

-- (1): arguments: the company is public; a proper instrument of transfer has been delivered; the right was transmitted by operation of law
#ASSERT `s 130(1) the public company is barred from registering the transfer of shares or debentures` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 130(1) the public company is barred from registering the transfer of shares or debentures` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 130(1) the public company is barred from registering the transfer of shares or debentures` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 130(1) the public company is barred from registering the transfer of shares or debentures` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 130(1) the public company is barred from registering the transfer of shares or debentures` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 130(1) the public company is barred from registering the transfer of shares or debentures` FALSE TRUE TRUE EQUALS NOTHING
-- EXPECT BREACH
#TRACE `s 130(1) a public company must not register a transfer of shares or debentures without a proper instrument of transfer` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130(1) register a transfer of shares or debentures without a proper instrument of transfer having been delivered to the company` AT 8

-- EXPECT RESIDUAL
#TRACE `s 130(1) a public company must not register a transfer of shares or debentures without a proper instrument of transfer` "Acme Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- (2): arguments: the company is public; there has been a transfer of shares
#ASSERT `s 130(2) the public company may lodge with the Registrar a notice of the transfer of shares in the prescribed form` TRUE TRUE EQUALS JUST TRUE
-- "Where there has been a transfer of shares": no transfer, no permission (periods ruling of 2026-11-05, item (b)); listed for a lawyer
#ASSERT `s 130(2) the public company may lodge with the Registrar a notice of the transfer of shares in the prescribed form` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 130(2) the public company may lodge with the Registrar a notice of the transfer of shares in the prescribed form` FALSE TRUE EQUALS NOTHING
#ASSERT `s 130(2) the public company may lodge with the Registrar a notice of the transfer of shares in the prescribed form` FALSE FALSE EQUALS NOTHING

-- (3): arguments: the notice is a notice lodged by a public company under (2); it states (a) the other un-notified transfers; it states (b) the prescribed information on the 50 largest members.
-- The text joins (a) and (b) with "or": stating either is enough (fork F-j130-2).
#ASSERT `s 130(3) the notice states what the subsection requires` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 130(3) the notice states what the subsection requires` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 130(3) the notice states what the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 130(3) the notice states what the subsection requires` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 130(3) the notice states what the subsection requires` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 130(3) the notice states what the subsection requires` FALSE FALSE FALSE EQUALS NOTHING

§ `Section 130AA`

-- (1): arguments: the company is public; the transferor made the request in writing
#ASSERT `s 130AA(1) the public company must enter the name of the transferee in the appropriate register` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 130AA(1) the public company must enter the name of the transferee in the appropriate register` TRUE FALSE EQUALS NOTHING
#ASSERT `s 130AA(1) the public company must enter the name of the transferee in the appropriate register` FALSE TRUE EQUALS NOTHING
-- no time is stated: the passing of time never breaches the duty
-- EXPECT RESIDUAL
#TRACE `s 130AA(1) a public company must enter the name of the transferee on the transferor's request` "Acme Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- EXPECT FULFILLED
#TRACE `s 130AA(1) a public company must enter the name of the transferee on the transferor's request` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130AA(1) enter in the appropriate register the name of the transferee` AT 12

-- (2): arguments: the company is public; the transferor made the request in writing
#ASSERT `s 130AA(2) the public company must by written notice require delivery or production of the documents` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 130AA(2) the public company must by written notice require delivery or production of the documents` TRUE FALSE EQUALS NOTHING
#ASSERT `s 130AA(2) the public company must by written notice require delivery or production of the documents` FALSE TRUE EQUALS NOTHING
-- "not less than 7 and not more than 28 days after the date of the notice": both ends are inside
#ASSERT `s 130AA(2) the period stated in the notice is a period the subsection allows` 7 EQUALS JUST TRUE
#ASSERT `s 130AA(2) the period stated in the notice is a period the subsection allows` 28 EQUALS JUST TRUE
#ASSERT `s 130AA(2) the period stated in the notice is a period the subsection allows` 6 EQUALS JUST FALSE
#ASSERT `s 130AA(2) the period stated in the notice is a period the subsection allows` 29 EQUALS JUST FALSE
-- EXPECT RESIDUAL
#TRACE `s 130AA(2) a public company must require delivery or production of the documents by written notice` "Acme Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- EXPECT FULFILLED
#TRACE `s 130AA(2) a public company must require delivery or production of the documents by written notice` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130AA(2) require by written notice the person having possession, custody or control to deliver or produce the share certificate or debenture and the instrument of transfer` AT 5

-- (3): a grant gated by "if"
#ASSERT `s 130AA(3) the transferor may apply to a judge for a summons` TRUE EQUALS JUST TRUE
#ASSERT `s 130AA(3) the transferor may apply to a judge for a summons` FALSE EQUALS NOTHING

-- (4): arguments: the person has been summoned; the person has appeared; the person has not appeared after being duly served
#ASSERT `s 130AA(4) the Court may order the person to deliver the documents to the company` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 130AA(4) the Court may order the person to deliver the documents to the company` TRUE FALSE TRUE EQUALS JUST TRUE
-- a "may" gated by "upon": when neither gate is met the answer is the text's no (periods ruling, item (b)), listed for a lawyer
#ASSERT `s 130AA(4) the Court may order the person to deliver the documents to the company` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 130AA(4) the Court may order the person to deliver the documents to the company` FALSE TRUE FALSE EQUALS JUST FALSE

-- (5): the lists must be exhibited and advertised; no time is stated
#ASSERT `s 130AA(5) the company must exhibit the list in its office and advertise it` TRUE EQUALS JUST TRUE
#ASSERT `s 130AA(5) the company must exhibit the list in its office and advertise it` FALSE EQUALS NOTHING
-- EXPECT RESIDUAL
#TRACE `s 130AA(5) the company must exhibit and advertise the list` "Acme Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- EXPECT FULFILLED
#TRACE `s 130AA(5) the company must exhibit and advertise the list` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130AA(5) exhibit and advertise the list of share certificates or debentures called in and not brought in` AT 45

§ `Section 130AB`

-- (1): 30 days after the date on which the transfer was lodged, the day of lodging not counted. Lodged on 1 February 2026: the last day is 3 March 2026.
#ASSERT `s 130AB(1) the last day for sending notice of the refusal` (Date 1 2 2026) EQUALS Date 3 3 2026
#ASSERT `s 130AB(1) the notice of the refusal was sent within 30 days` (Date 1 2 2026) (Date 2 3 2026) EQUALS JUST TRUE
#ASSERT `s 130AB(1) the notice of the refusal was sent within 30 days` (Date 1 2 2026) (Date 3 3 2026) EQUALS JUST TRUE
#ASSERT `s 130AB(1) the notice of the refusal was sent within 30 days` (Date 1 2 2026) (Date 4 3 2026) EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 130AB(1) a public company that refuses to register a transfer must send notice of the refusal within 30 days` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130AB(1) send to the transferor and to the transferee notice of the refusal to register a transfer` AT 30

-- EXPECT BREACH
#TRACE `s 130AB(1) a public company that refuses to register a transfer must send notice of the refusal within 30 days` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130AB(1) send to the transferor and to the transferee notice of the refusal to register a transfer` AT 31

-- EXPECT BREACH
#TRACE `s 130AB(1) a public company that refuses to register a transfer must send notice of the refusal within 30 days` "Acme Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- (2): "within 30 days beginning with the day on which the application was made": the day of the application is day 1.
-- Applied on 1 February 2026: 1 February is day 1, 28 February is day 28, 2 March is day 30.
#ASSERT `s 130AB(2) the last day for serving the written notice` (Date 1 2 2026) EQUALS Date 2 3 2026
-- arguments: the company is public; the application is for registration as a member in respect of shares transferred or transmitted by act of parties or operation of law;
-- the day of the application; the day the written notice was served; a written notice stating the facts has been served
#ASSERT `s 130AB(2) the public company is barred from refusing registration by virtue of a discretion in the constitution` TRUE TRUE (Date 1 2 2026) (Date 2 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 130AB(2) the public company is barred from refusing registration by virtue of a discretion in the constitution` TRUE TRUE (Date 1 2 2026) (Date 3 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `s 130AB(2) the public company is barred from refusing registration by virtue of a discretion in the constitution` TRUE TRUE (Date 1 2 2026) (Date 2 3 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 130AB(2) the public company is barred from refusing registration by virtue of a discretion in the constitution` FALSE TRUE (Date 1 2 2026) (Date 3 3 2026) FALSE EQUALS NOTHING
#ASSERT `s 130AB(2) the public company is barred from refusing registration by virtue of a discretion in the constitution` TRUE FALSE (Date 1 2 2026) (Date 3 3 2026) FALSE EQUALS NOTHING
-- EXPECT BREACH
#TRACE `s 130AB(2) a public company must not refuse registration by virtue of a discretion without a timely written notice` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130AB(2) refusal by virtue of a discretion` FALSE AT 31

-- EXPECT RESIDUAL
#TRACE `s 130AB(2) a public company must not refuse registration by virtue of a discretion without a timely written notice` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130AB(2) refusal by virtue of a discretion` TRUE AT 31

-- EXPECT RESIDUAL
#TRACE `s 130AB(2) a public company must not refuse registration by virtue of a discretion without a timely written notice` "Acme Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- (3): arguments: default is made in complying with section 130AB; the person is the public company; the person is an officer of the company in default
#ASSERT `s 130AB(3) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 130AB(3) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 130AB(3) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 130AB(3) the person is guilty of the offence this subsection creates` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 130AB(3) the most the person may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
#ASSERT `s 130AB(3) the most the person may be sentenced to on conviction` TRUE FALSE TRUE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
#ASSERT `s 130AB(3) the most the person may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 130AB(3) the most the person may be sentenced to on conviction` FALSE TRUE TRUE EQUALS NOTHING

§ `Section 130AC`

#ASSERT `s 130AC(1) the transfer is as valid as if the personal representative had been a member of the company at the time of the execution of the instrument of transfer` TRUE EQUALS JUST TRUE
#ASSERT `s 130AC(1) the transfer is as valid as if the personal representative had been a member of the company at the time of the execution of the instrument of transfer` FALSE EQUALS NOTHING
-- (2): arguments: the document has been produced to the company; the document is by law sufficient evidence of probate or letters of administration
#ASSERT `s 130AC(2) the company must accept the document as sufficient evidence of the grant` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 130AC(2) the company must accept the document as sufficient evidence of the grant` TRUE FALSE EQUALS NOTHING
#ASSERT `s 130AC(2) the company must accept the document as sufficient evidence of the grant` FALSE TRUE EQUALS NOTHING
-- EXPECT RESIDUAL
#TRACE `s 130AC(2) a company must accept the document as sufficient evidence of the grant` "Acme Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- EXPECT FULFILLED
#TRACE `s 130AC(2) a company must accept the document as sufficient evidence of the grant` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130AC(2) accept the document as sufficient evidence of the grant` AT 2

-- (3): "includes": a written application for transmission to a personal representative is an instrument of transfer; the list is not closed
#ASSERT `s 130AC(3) "instrument of transfer" the document is an instrument of transfer for the purposes of section 130AC` TRUE EQUALS JUST TRUE
#ASSERT `s 130AC(3) "instrument of transfer" the document is an instrument of transfer for the purposes of section 130AC` FALSE EQUALS NOTHING

§ `Section 130AD`

-- (1): arguments: the company has certified an instrument of transfer; the person is acting on the faith of the certification
#ASSERT `s 130AD(1) the certification is taken as a representation that documents showing a prima facie title in the transferor have been produced to the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 130AD(1) the certification is taken as a representation that documents showing a prima facie title in the transferor have been produced to the company` TRUE FALSE EQUALS NOTHING
#ASSERT `s 130AD(1) the certification is taken as a representation that documents showing a prima facie title in the transferor have been produced to the company` FALSE TRUE EQUALS NOTHING
-- "but not as a representation that the transferor has any title": a flat negative
#ASSERT `s 130AD(1) the certification is taken as a representation that the transferor has any title` TRUE EQUALS JUST FALSE
#ASSERT `s 130AD(1) the certification is taken as a representation that the transferor has any title` FALSE EQUALS NOTHING

-- (2): arguments: the person acts on the faith of a false certification by the company; the certification was made negligently
#ASSERT `s 130AD(2) the company is under the same liability to the person as if the certification had been made fraudulently` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 130AD(2) the company is under the same liability to the person as if the certification had been made fraudulently` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 130AD(2) the company is under the same liability to the person as if the certification had been made fraudulently` FALSE TRUE EQUALS JUST FALSE

-- (3) and (4): the period of a certification limited to 42 days or more. Certified on 1 February 2026 and limited to 42 days: the period ends on 15 March 2026.
#ASSERT `s 130AD(3) the last day of the period so limited or any extension of it` (Date 1 2 2026) 42 0 EQUALS Date 15 3 2026
-- extended by 10 days: 25 March 2026
#ASSERT `s 130AD(3) the last day of the period so limited or any extension of it` (Date 1 2 2026) 42 10 EQUALS Date 25 3 2026
-- limited to 60 days: 2 April 2026
#ASSERT `s 130AD(3) the last day of the period so limited or any extension of it` (Date 1 2 2026) 60 0 EQUALS Date 2 4 2026
-- (3)(a) arguments: the certification was made by a private company; the days limited to; the day of the certification; the days of extension; the day of the transfer;
-- the instrument of transfer was sent to or received by the company under section 126(1) within the period; there has been fraud
#ASSERT `s 130AD(3)(a) the company and its officers are liable in respect of the transfer of shares` TRUE 42 (Date 1 2 2026) 0 (Date 16 3 2026) FALSE FALSE EQUALS JUST FALSE
-- a transfer on the last day of the period is not "after the expiration"
#ASSERT `s 130AD(3)(a) the company and its officers are liable in respect of the transfer of shares` TRUE 42 (Date 1 2 2026) 0 (Date 15 3 2026) FALSE FALSE EQUALS NOTHING
-- an extension of 10 days: 16 March is inside, 26 March is after
#ASSERT `s 130AD(3)(a) the company and its officers are liable in respect of the transfer of shares` TRUE 42 (Date 1 2 2026) 10 (Date 16 3 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `s 130AD(3)(a) the company and its officers are liable in respect of the transfer of shares` TRUE 42 (Date 1 2 2026) 10 (Date 25 3 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `s 130AD(3)(a) the company and its officers are liable in respect of the transfer of shares` TRUE 42 (Date 1 2 2026) 10 (Date 26 3 2026) FALSE FALSE EQUALS JUST FALSE
-- a longer period: 60 days ends on 2 April
#ASSERT `s 130AD(3)(a) the company and its officers are liable in respect of the transfer of shares` TRUE 60 (Date 1 2 2026) 0 (Date 2 4 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `s 130AD(3)(a) the company and its officers are liable in respect of the transfer of shares` TRUE 60 (Date 1 2 2026) 0 (Date 3 4 2026) FALSE FALSE EQUALS JUST FALSE
-- the instrument was sent or received in time: the "if" is not met
#ASSERT `s 130AD(3)(a) the company and its officers are liable in respect of the transfer of shares` TRUE 42 (Date 1 2 2026) 0 (Date 16 3 2026) TRUE FALSE EQUALS NOTHING
-- "in the absence of fraud"
#ASSERT `s 130AD(3)(a) the company and its officers are liable in respect of the transfer of shares` TRUE 42 (Date 1 2 2026) 0 (Date 16 3 2026) FALSE TRUE EQUALS NOTHING
-- limited to fewer than 42 days: outside the subsection
#ASSERT `s 130AD(3)(a) the company and its officers are liable in respect of the transfer of shares` TRUE 41 (Date 1 2 2026) 0 (Date 16 3 2026) FALSE FALSE EQUALS NOTHING
-- a certification by a company that is not private: subsection (4) is the public company's
#ASSERT `s 130AD(3)(a) the company and its officers are liable in respect of the transfer of shares` FALSE 42 (Date 1 2 2026) 0 (Date 16 3 2026) FALSE FALSE EQUALS NOTHING
-- (3)(b): the same shape for the registration of a transfer of debentures or other interests, with "lodged within the period" in place of "sent or received"
#ASSERT `s 130AD(3)(b) the company and its officers are liable in respect of the registration of the transfer of debentures or other interests` TRUE 42 (Date 1 2 2026) 0 (Date 16 3 2026) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 130AD(3)(b) the company and its officers are liable in respect of the registration of the transfer of debentures or other interests` TRUE 42 (Date 1 2 2026) 0 (Date 15 3 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `s 130AD(3)(b) the company and its officers are liable in respect of the registration of the transfer of debentures or other interests` TRUE 42 (Date 1 2 2026) 0 (Date 16 3 2026) TRUE FALSE EQUALS NOTHING
#ASSERT `s 130AD(3)(b) the company and its officers are liable in respect of the registration of the transfer of debentures or other interests` TRUE 42 (Date 1 2 2026) 0 (Date 16 3 2026) FALSE TRUE EQUALS NOTHING
#ASSERT `s 130AD(3)(b) the company and its officers are liable in respect of the registration of the transfer of debentures or other interests` FALSE 42 (Date 1 2 2026) 0 (Date 16 3 2026) FALSE FALSE EQUALS NOTHING
-- (4): a certification by a public company
#ASSERT `s 130AD(4) the company and its officers are liable in respect of the registration of the transfer of shares, debentures or other interests` TRUE 42 (Date 1 2 2026) 0 (Date 16 3 2026) FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 130AD(4) the company and its officers are liable in respect of the registration of the transfer of shares, debentures or other interests` TRUE 42 (Date 1 2 2026) 0 (Date 15 3 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `s 130AD(4) the company and its officers are liable in respect of the registration of the transfer of shares, debentures or other interests` TRUE 42 (Date 1 2 2026) 0 (Date 16 3 2026) TRUE FALSE EQUALS NOTHING
#ASSERT `s 130AD(4) the company and its officers are liable in respect of the registration of the transfer of shares, debentures or other interests` TRUE 42 (Date 1 2 2026) 0 (Date 16 3 2026) FALSE TRUE EQUALS NOTHING
#ASSERT `s 130AD(4) the company and its officers are liable in respect of the registration of the transfer of shares, debentures or other interests` TRUE 41 (Date 1 2 2026) 0 (Date 16 3 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `s 130AD(4) the company and its officers are liable in respect of the registration of the transfer of shares, debentures or other interests` FALSE 42 (Date 1 2 2026) 0 (Date 16 3 2026) FALSE FALSE EQUALS NOTHING

-- (5)(a)
#ASSERT `s 130AD(5)(a) the instrument of transfer is treated as certificated` TRUE EQUALS JUST TRUE
#ASSERT `s 130AD(5)(a) the instrument of transfer is treated as certificated` FALSE EQUALS NOTHING
-- (5)(b): arguments: the issuer is apparently authorised; signed by a person apparently authorised; signed by an officer of the company or of a corporation so authorised
#ASSERT `s 130AD(5)(b) the certification of the instrument of transfer is treated as made by the company` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 130AD(5)(b) the certification of the instrument of transfer is treated as made by the company` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 130AD(5)(b) the certification of the instrument of transfer is treated as made by the company` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 130AD(5)(b) the certification of the instrument of transfer is treated as made by the company` FALSE TRUE TRUE EQUALS NOTHING
-- (5)(c): arguments: the certification purports to be authenticated by a signature or initials; shown not placed by the person; shown not placed by another person apparently authorised
#ASSERT `s 130AD(5)(c) the certification is deemed to be signed by the person` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 130AD(5)(c) the certification is deemed to be signed by the person` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 130AD(5)(c) the certification is deemed to be signed by the person` TRUE FALSE TRUE EQUALS JUST TRUE
-- "unless it is shown that the signature or initials were not placed there by the person and were not placed there by any other person apparently authorised": both must be shown
#ASSERT `s 130AD(5)(c) the certification is deemed to be signed by the person` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 130AD(5)(c) the certification is deemed to be signed by the person` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 130AD(5)(c) the certification is deemed to be signed by the person` FALSE TRUE TRUE EQUALS NOTHING

§ `Section 130AE`

-- (1), allotment: 60 days after the allotment. Allotted on 1 February 2026: the last day is 2 April 2026.
#ASSERT `s 130AE(1) the last day for completing the certificates after an allotment` (Date 1 2 2026) EQUALS Date 2 4 2026
-- arguments: the company is public; the day of the allotment; the day the certificates were complete and ready
#ASSERT `s 130AE(1) the public company completed the certificates in time after the allotment` TRUE (Date 1 2 2026) (Date 2 4 2026) EQUALS JUST TRUE
#ASSERT `s 130AE(1) the public company completed the certificates in time after the allotment` TRUE (Date 1 2 2026) (Date 3 4 2026) EQUALS JUST FALSE
#ASSERT `s 130AE(1) the public company completed the certificates in time after the allotment` FALSE (Date 1 2 2026) (Date 3 4 2026) EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `s 130AE(1) a public company must complete the certificates within 60 days after an allotment` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130AE(1) complete and have ready for delivery all the appropriate certificates and debentures in connection with the allotment` AT 60

-- EXPECT BREACH
#TRACE `s 130AE(1) a public company must complete the certificates within 60 days after an allotment` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130AE(1) complete and have ready for delivery all the appropriate certificates and debentures in connection with the allotment` AT 61

-- EXPECT BREACH
#TRACE `s 130AE(1) a public company must complete the certificates within 60 days after an allotment` "Acme Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- (1), transfer: 30 days after the transfer is lodged. Lodged on 1 February 2026: the last day is 3 March 2026.
#ASSERT `s 130AE(1) the last day for completing the certificates after a transfer was lodged` (Date 1 2 2026) EQUALS Date 3 3 2026
#ASSERT `s 130AE(1) the public company completed the certificates in time after the transfer` TRUE (Date 1 2 2026) (Date 3 3 2026) EQUALS JUST TRUE
#ASSERT `s 130AE(1) the public company completed the certificates in time after the transfer` TRUE (Date 1 2 2026) (Date 4 3 2026) EQUALS JUST FALSE
#ASSERT `s 130AE(1) the public company completed the certificates in time after the transfer` FALSE (Date 1 2 2026) (Date 4 3 2026) EQUALS NOTHING
-- arguments: the company is public; a transfer has been lodged with the company; the transfer is one the company is entitled to refuse and does not register
#ASSERT `s 130AE(1) the public company must complete the certificates after the transfer` TRUE TRUE FALSE EQUALS JUST TRUE
-- "(other than such a transfer as the company is for any reason entitled to refuse to register and does not register)"
#ASSERT `s 130AE(1) the public company must complete the certificates after the transfer` TRUE TRUE TRUE EQUALS JUST FALSE
-- no transfer lodged: the duty starts with a lodging and the text does not speak of the case where none was
#ASSERT `s 130AE(1) the public company must complete the certificates after the transfer` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 130AE(1) the public company must complete the certificates after the transfer` FALSE TRUE FALSE EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `s 130AE(1) a public company must complete the certificates within 30 days after a transfer is lodged` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130AE(1) complete and have ready for delivery all the appropriate certificates and debentures in connection with the transfer` AT 30

-- EXPECT BREACH
#TRACE `s 130AE(1) a public company must complete the certificates within 30 days after a transfer is lodged` "Acme Ltd" AT 0 WITH
    PARTY Company "Acme Ltd" DOES `s 130AE(1) complete and have ready for delivery all the appropriate certificates and debentures in connection with the transfer` AT 31

-- (2)(a): a private company, 60 days after the allotment
#ASSERT `s 130AE(2)(a) the last day for completing the certificates after an allotment` (Date 1 2 2026) EQUALS Date 2 4 2026
#ASSERT `s 130AE(2)(a) the private company completed the certificates in time after the allotment` TRUE (Date 1 2 2026) (Date 2 4 2026) EQUALS JUST TRUE
#ASSERT `s 130AE(2)(a) the private company completed the certificates in time after the allotment` TRUE (Date 1 2 2026) (Date 3 4 2026) EQUALS JUST FALSE
#ASSERT `s 130AE(2)(a) the private company completed the certificates in time after the allotment` FALSE (Date 1 2 2026) (Date 3 4 2026) EQUALS NOTHING
-- EXPECT FULFILLED
#TRACE `s 130AE(2)(a) a private company must complete the certificates within 60 days after an allotment` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 130AE(2)(a) complete and have ready for delivery all the appropriate certificates and debentures in connection with the allotment` AT 60

-- EXPECT BREACH
#TRACE `s 130AE(2)(a) a private company must complete the certificates within 60 days after an allotment` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 130AE(2)(a) complete and have ready for delivery all the appropriate certificates and debentures in connection with the allotment` AT 61

-- (2)(b): a private company, 30 days after a notice of transfer of shares is lodged with the Registrar
#ASSERT `s 130AE(2)(b) the last day for completing the certificates after a notice of transfer of shares was lodged` (Date 1 2 2026) EQUALS Date 3 3 2026
#ASSERT `s 130AE(2)(b) the private company completed the certificates in time after the notice of transfer of shares was lodged` TRUE (Date 1 2 2026) (Date 3 3 2026) EQUALS JUST TRUE
#ASSERT `s 130AE(2)(b) the private company completed the certificates in time after the notice of transfer of shares was lodged` TRUE (Date 1 2 2026) (Date 4 3 2026) EQUALS JUST FALSE
#ASSERT `s 130AE(2)(b) the private company completed the certificates in time after the notice of transfer of shares was lodged` FALSE (Date 1 2 2026) (Date 4 3 2026) EQUALS NOTHING
