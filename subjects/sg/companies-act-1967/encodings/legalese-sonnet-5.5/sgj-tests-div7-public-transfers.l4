-- (3): arguments: default is made in complying with section 130AE; the person is the company; the person is an officer of the company in default
#ASSERT `s 130AE(3) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 130AE(3) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 130AE(3) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 130AE(3) the person is guilty of the offence this subsection creates` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 130AE(3) the most the person may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
#ASSERT `s 130AE(3) the most the person may be sentenced to on conviction` TRUE FALSE TRUE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
#ASSERT `s 130AE(3) the most the person may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 130AE(3) the most the person may be sentenced to on conviction` FALSE TRUE TRUE EQUALS NOTHING

-- (4): 10 days after the service of the notice. Served on 1 February 2026: the last day is 11 February 2026.
#ASSERT `s 130AE(4) the last day for the company to make good the default` (Date 1 2 2026) EQUALS Date 11 2 2026
-- arguments: the day the notice was served; the company has made good the default; the day it did so; the day of the application
#ASSERT `s 130AE(4) the company failed to make good the default within 10 days after the service of the notice` (Date 1 2 2026) TRUE (Date 11 2 2026) (Date 20 2 2026) EQUALS FALSE
#ASSERT `s 130AE(4) the company failed to make good the default within 10 days after the service of the notice` (Date 1 2 2026) TRUE (Date 12 2 2026) (Date 20 2 2026) EQUALS TRUE
-- not made good by the day of the application: late if the application is after the last day
#ASSERT `s 130AE(4) the company failed to make good the default within 10 days after the service of the notice` (Date 1 2 2026) FALSE (Date 1 1 1900) (Date 11 2 2026) EQUALS FALSE
#ASSERT `s 130AE(4) the company failed to make good the default within 10 days after the service of the notice` (Date 1 2 2026) FALSE (Date 1 1 1900) (Date 12 2 2026) EQUALS TRUE
-- arguments: a notice requiring the company to make good has been served; the company failed within 10 days; the applicant is the person entitled
