IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgb2-s168-s169-payments-to-directors`

-- Tests for ss 168 and 169. Every expected value is written from the text, beside the assertion, before it was run.

§ `s 168(1): payments that are not lawful without disclosure and approval`

-- Arguments: kind, the payee is a director, the payment is within (5), (1A) lifts the approval, disclosed to the members, approved in general meeting.
-- Neither disclosed nor approved: not lawful.
#ASSERT `s 168(1) the payment is unlawful` `s 168(1)(a) a payment by way of compensation for loss of office, or as consideration for or in connection with retirement from office` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- Disclosed and approved: the "unless" is met.
#ASSERT `s 168(1) the payment is unlawful` `s 168(1)(a) a payment by way of compensation for loss of office, or as consideration for or in connection with retirement from office` TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- Disclosed only, or approved only: both are required.
#ASSERT `s 168(1) the payment is unlawful` `s 168(1)(a) a payment by way of compensation for loss of office, or as consideration for or in connection with retirement from office` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 168(1) the payment is unlawful` `s 168(1)(a) a payment by way of compensation for loss of office, or as consideration for or in connection with retirement from office` TRUE FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- (b): the transfer payments, same test.
#ASSERT `s 168(1) the payment is unlawful` `s 168(1)(b) a payment in connection with the transfer of the whole or any part of the undertaking or property of the company` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 168(1) the payment is unlawful` `s 168(1)(b) a payment in connection with the transfer of the whole or any part of the undertaking or property of the company` TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- (5): the references to compensation for loss of office do not include these payments: a flat negative.
#ASSERT `s 168(1) the payment is unlawful` `s 168(1)(a) a payment by way of compensation for loss of office, or as consideration for or in connection with retirement from office` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- (5) speaks of payments by way of compensation for loss of office or retirement; it does not touch the transfer payments of (1)(b).
#ASSERT `s 168(1) the payment is unlawful` `s 168(1)(b) a payment in connection with the transfer of the whole or any part of the undertaking or property of the company` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (1A): the approval is not required; disclosure still is.
#ASSERT `s 168(1) the payment is unlawful` `s 168(1)(a) a payment by way of compensation for loss of office, or as consideration for or in connection with retirement from office` TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 168(1) the payment is unlawful` `s 168(1)(a) a payment by way of compensation for loss of office, or as consideration for or in connection with retirement from office` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- Not a director (and not, by (7), a former director): the section speaks of directors only.
#ASSERT `s 168(1) the payment is unlawful` `s 168(1)(a) a payment by way of compensation for loss of office, or as consideration for or in connection with retirement from office` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- Another kind of payment: silent.
#ASSERT `s 168(1) the payment is unlawful` `s 168(1) some other payment` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- The company must not make the payment without disclosure and approval.
-- EXPECT BREACH
#TRACE `s 168(1)(a) the company must not make to a director a payment by way of compensation for loss of office without disclosure to the members and approval in general meeting` "Acme Pte Ltd" FALSE AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 168(1)(a) make the payment by way of compensation for loss of office or as consideration for retirement` AT 1

-- EXPECT FULFILLED
#TRACE `s 168(1)(a) the company must not make to a director a payment by way of compensation for loss of office without disclosure to the members and approval in general meeting` "Acme Pte Ltd" TRUE AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 168(1)(a) make the payment by way of compensation for loss of office or as consideration for retirement` AT 1

-- EXPECT RESIDUAL
#TRACE `s 168(1)(a) the company must not make to a director a payment by way of compensation for loss of office without disclosure to the members and approval in general meeting` "Acme Pte Ltd" FALSE AT 0 WITH

-- The trust: "when" counts as "where", so a payment that was not unlawfully made gives JUST FALSE.
#ASSERT `s 168(1) the amount received by the director is deemed to have been received in trust for the company` TRUE EQUALS JUST TRUE
#ASSERT `s 168(1) the amount received by the director is deemed to have been received in trust for the company` FALSE EQUALS JUST FALSE

§ `s 168(1A) and (1B): the existing legal obligation`

-- (a): the amount does not exceed the last year's emoluments.
#ASSERT `s 168(1A)(a) the amount of the payment does not exceed the total emoluments of the director for the preceding year` 100 120 EQUALS JUST TRUE
#ASSERT `s 168(1A)(a) the amount of the payment does not exceed the total emoluments of the director for the preceding year` 120 120 EQUALS JUST TRUE
#ASSERT `s 168(1A)(a) the amount of the payment does not exceed the total emoluments of the director for the preceding year` 121 120 EQUALS JUST FALSE
-- (b): disclosed "upon or prior to" the payment.
#ASSERT `s 168(1A)(b) the particulars have been disclosed to the members upon or prior to the payment` (Date 31 5 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 168(1A)(b) the particulars have been disclosed to the members upon or prior to the payment` (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 168(1A)(b) the particulars have been disclosed to the members upon or prior to the payment` (Date 2 6 2026) (Date 1 6 2026) EQUALS JUST FALSE
-- The whole of (1A): salaried director; payment under an existing obligation; (a); (b).
#ASSERT `s 168(1A) the requirement for approval does not apply to the payment` TRUE TRUE 100 120 (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 168(1A) the requirement for approval does not apply to the payment` FALSE TRUE 100 120 (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 168(1A) the requirement for approval does not apply to the payment` TRUE FALSE 100 120 (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 168(1A) the requirement for approval does not apply to the payment` TRUE TRUE 130 120 (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `s 168(1A) the requirement for approval does not apply to the payment` TRUE TRUE 100 120 (Date 2 6 2026) (Date 1 6 2026) EQUALS JUST FALSE
-- (1B)(a): an existing legal obligation is one of the company or of a corporation related by s 6, not entered into in connection with the event.
#ASSERT `s 168(1B)(a) the obligation is an existing legal obligation` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 168(1B)(a) the obligation is an existing legal obligation` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 168(1B)(a) the obligation is an existing legal obligation` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 168(1B)(a) the obligation is an existing legal obligation` FALSE FALSE FALSE EQUALS JUST FALSE
-- (1B)(b): on trust if (1A)(a) or (b) is not complied with.
#ASSERT `s 168(1B)(b) the amount received by the director is deemed to have been received on trust for the company` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 168(1B)(b) the amount received by the director is deemed to have been received on trust for the company` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 168(1B)(b) the amount received by the director is deemed to have been received on trust for the company` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 168(1B)(b) the amount received by the director is deemed to have been received on trust for the company` TRUE TRUE FALSE EQUALS JUST TRUE

§ `s 168(2) and (3): payments on a take-over offer`

#ASSERT `s 168(2) the director must take all reasonable steps to secure that the particulars are included in or sent with the notice of the offer` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 168(2) the director must take all reasonable steps to secure that the particulars are included in or sent with the notice of the offer` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 168(2) the director must take all reasonable steps to secure that the particulars are included in or sent with the notice of the offer` TRUE TRUE EQUALS JUST FALSE

-- The duty has no period: done, FULFILLED; not done, RESIDUAL; never BREACH.
-- EXPECT FULFILLED
#TRACE `s 168(2) the director must take all reasonable steps to secure that the particulars are included in or sent with the notice of the offer` "Dana Tan" AT 0 WITH
    PARTY Director "Dana Tan" DOES `s 168(2) take all reasonable steps to secure that the particulars are included in or sent with the notice of the offer` AT 1

-- EXPECT RESIDUAL
#TRACE `s 168(2) the director must take all reasonable steps to secure that the particulars are included in or sent with the notice of the offer` "Dana Tan" AT 0 WITH

#ASSERT `s 168(3) the person is guilty of the offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 168(3) the person is guilty of the offence` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 168(3) the person is guilty of the offence` FALSE FALSE EQUALS NOTHING
-- The trust for the person who sold shares: the requirements of (2) not complied with and the person sold as a result of the offer.
#ASSERT `s 168(3) any sum received by the director on account of the payment is deemed to have been received in trust for the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 168(3) any sum received by the director on account of the payment is deemed to have been received in trust for the person` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 168(3) any sum received by the director on account of the payment is deemed to have been received in trust for the person` TRUE FALSE EQUALS NOTHING

§ `s 168(4): a price above what other holders could have had`

#ASSERT `s 168(4) the excess of the price paid to the director over the price other holders could have obtained` 120 100 EQUALS 20
#ASSERT `s 168(4) the excess of the price paid to the director over the price other holders could have obtained` 100 100 EQUALS 0
#ASSERT `s 168(4) the excess of the price paid to the director over the price other holders could have obtained` 90 100 EQUALS 0
#ASSERT `s 168(4) the excess or the money value of the consideration is deemed to be a payment by way of compensation for loss of office` TRUE TRUE 120 100 0 EQUALS JUST TRUE
#ASSERT `s 168(4) the excess or the money value of the consideration is deemed to be a payment by way of compensation for loss of office` TRUE TRUE 100 100 0 EQUALS JUST FALSE
#ASSERT `s 168(4) the excess or the money value of the consideration is deemed to be a payment by way of compensation for loss of office` TRUE TRUE 100 100 5 EQUALS JUST TRUE
#ASSERT `s 168(4) the excess or the money value of the consideration is deemed to be a payment by way of compensation for loss of office` FALSE TRUE 120 100 0 EQUALS JUST FALSE
#ASSERT `s 168(4) the excess or the money value of the consideration is deemed to be a payment by way of compensation for loss of office` TRUE FALSE 120 100 0 EQUALS JUST FALSE
#ASSERT `s 168(4) the amount deemed to have been a payment by way of compensation for loss of office` 120 100 5 EQUALS 25
#ASSERT `s 168(4) the amount deemed to have been a payment by way of compensation for loss of office` 90 100 5 EQUALS 5

§ `s 168(5): payments the references do not include`

#ASSERT `s 168(5)(a) the payment is made under an agreement entered into before 1 January 1967` (Date 31 12 1966) EQUALS JUST TRUE
#ASSERT `s 168(5)(a) the payment is made under an agreement entered into before 1 January 1967` (Date 1 1 1967) EQUALS NOTHING
#ASSERT `s 168(5)(b) the payment is made under an agreement disclosed to and approved by special resolution of the company` TRUE EQUALS JUST TRUE
#ASSERT `s 168(5)(b) the payment is made under an agreement disclosed to and approved by special resolution of the company` FALSE EQUALS NOTHING
#ASSERT `s 168(5)(c) the payment is a bona fide payment by way of damages for breach of contract` TRUE EQUALS JUST TRUE
#ASSERT `s 168(5)(c) the payment is a bona fide payment by way of damages for breach of contract` FALSE EQUALS NOTHING
-- (d): the amount less the director's own contributions is at most the emoluments of the 3 years: 100 less 20 is 80.
#ASSERT `s 168(5)(d) the payment is a bona fide pension or lump sum payment in respect of past services within the limit` TRUE 100 20 80 EQUALS JUST TRUE
#ASSERT `s 168(5)(d) the payment is a bona fide pension or lump sum payment in respect of past services within the limit` TRUE 100 20 79 EQUALS NOTHING
#ASSERT `s 168(5)(d) the payment is a bona fide pension or lump sum payment in respect of past services within the limit` TRUE 100 0 100 EQUALS JUST TRUE
#ASSERT `s 168(5)(d) the payment is a bona fide pension or lump sum payment in respect of past services within the limit` FALSE 100 20 80 EQUALS NOTHING
#ASSERT `s 168(5)(e) the payment is made pursuant to an agreement made before the director became a director` TRUE EQUALS JUST TRUE
#ASSERT `s 168(5)(e) the payment is made pursuant to an agreement made before the director became a director` FALSE EQUALS NOTHING
#ASSERT `s 168(5) the payment is one that the references in the section to compensation for loss of office do not include` (JUST TRUE) NOTHING NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 168(5) the payment is one that the references in the section to compensation for loss of office do not include` NOTHING NOTHING NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 168(5) the payment is one that the references in the section to compensation for loss of office do not include` NOTHING NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING

§ `s 168(6) and (7)`

#ASSERT `s 168(6) the section displaces a rule of law requiring disclosure to be made with respect to the payment` TRUE EQUALS JUST FALSE
#ASSERT `s 168(6) the section displaces a rule of law requiring disclosure to be made with respect to the payment` FALSE EQUALS NOTHING
#ASSERT `s 168(7) the person is within the word director in the section` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 168(7) the person is within the word director in the section` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 168(7) the person is within the word director in the section` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 168(7) the person is within the word director in the section` FALSE FALSE FALSE EQUALS NOTHING

§ `s 169: provision and improvement of a director's emoluments`

#ASSERT `s 169(1) the provision or improvement of the emoluments is barred` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 169(1) the provision or improvement of the emoluments is barred` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 169(1) the provision or improvement of the emoluments is barred` FALSE FALSE EQUALS NOTHING
#ASSERT `s 169(1) the provision or improvement of the emoluments is barred` FALSE TRUE EQUALS NOTHING

-- EXPECT BREACH
#TRACE `s 169(1) the company must not provide or improve a director's emoluments unless approved by a resolution not related to other matters` "Acme Pte Ltd" FALSE AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 169(1) provide or improve emoluments for a director in respect of his or her office as such` AT 1

-- EXPECT FULFILLED
#TRACE `s 169(1) the company must not provide or improve a director's emoluments unless approved by a resolution not related to other matters` "Acme Pte Ltd" TRUE AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 169(1) provide or improve emoluments for a director in respect of his or her office as such` AT 1

-- EXPECT RESIDUAL
#TRACE `s 169(1) the company must not provide or improve a director's emoluments unless approved by a resolution not related to other matters` "Acme Pte Ltd" FALSE AT 0 WITH

#ASSERT `s 169(1) the resolution is void` TRUE EQUALS JUST TRUE
#ASSERT `s 169(1) the resolution is void` FALSE EQUALS NOTHING

#ASSERT `s 169(2) the payment or benefit is within the word emoluments` `s 169(2) fees and percentages` FALSE EQUALS JUST TRUE
#ASSERT `s 169(2) the payment or benefit is within the word emoluments` `s 169(2) a sum paid by way of expenses allowance` TRUE EQUALS JUST TRUE
#ASSERT `s 169(2) the payment or benefit is within the word emoluments` `s 169(2) a sum paid by way of expenses allowance` FALSE EQUALS NOTHING
#ASSERT `s 169(2) the payment or benefit is within the word emoluments` `s 169(2) a contribution paid in respect of a director under a pension scheme` FALSE EQUALS JUST TRUE
#ASSERT `s 169(2) the payment or benefit is within the word emoluments` `s 169(2) a benefit received otherwise than in cash in respect of the director's services as director` FALSE EQUALS JUST TRUE
#ASSERT `s 169(2) the payment or benefit is within the word emoluments` `s 169(2) some other payment or benefit` TRUE EQUALS NOTHING
