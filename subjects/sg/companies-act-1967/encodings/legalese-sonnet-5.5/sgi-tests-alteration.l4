IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgi-alteration`

-- Tests for sgi-alteration.l4 (ss 26 and 26A). Expected values are written from the text beside each assertion.

§ `s 26(1) to (1B)`

-- (1): a special resolution, this Act not otherwise providing: yes.
#ASSERT `s 26(1) the constitution may be altered or added to by the resolution` `a special resolution` FALSE EQUALS JUST TRUE
-- This Act otherwise provides: the text points to that other provision (NOTHING).
#ASSERT `s 26(1) the constitution may be altered or added to by the resolution` `a special resolution` TRUE EQUALS NOTHING
-- An ordinary resolution or a resolution of the directors: the subsection does not say (NOTHING).
#ASSERT `s 26(1) the constitution may be altered or added to by the resolution` `an ordinary resolution` FALSE EQUALS NOTHING
#ASSERT `s 26(1) the constitution may be altered or added to by the resolution` `a resolution of the directors` FALSE EQUALS NOTHING
-- (1AA): from the date of the special resolution, or a later date the resolution specifies.
#ASSERT `s 26(1AA) the date on and from which the alteration or addition forms part of the original constitution` TRUE (Date 10 3 2026) FALSE (Date 1 1 2020) EQUALS JUST (Date 10 3 2026)
#ASSERT `s 26(1AA) the date on and from which the alteration or addition forms part of the original constitution` TRUE (Date 10 3 2026) TRUE (Date 11 3 2026) EQUALS JUST (Date 11 3 2026)
-- A specified date that is the same as the resolution's is not "a later date": the text is silent (NOTHING).
#ASSERT `s 26(1AA) the date on and from which the alteration or addition forms part of the original constitution` TRUE (Date 10 3 2026) TRUE (Date 10 3 2026) EQUALS NOTHING
#ASSERT `s 26(1AA) the date on and from which the alteration or addition forms part of the original constitution` TRUE (Date 10 3 2026) TRUE (Date 9 3 2026) EQUALS NOTHING
-- Not an alteration made under subsection (1): outside the subsection (NOTHING).
#ASSERT `s 26(1AA) the date on and from which the alteration or addition forms part of the original constitution` FALSE (Date 10 3 2026) FALSE (Date 1 1 2020) EQUALS NOTHING
-- (1AB): adopting by reference to the title or the regulation numbers: the resolution "need not set out the text".
#ASSERT `s 26(1AB) the special resolution needs to set out the text of the model constitution adopted` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 26(1AB) the special resolution needs to set out the text of the model constitution adopted` TRUE FALSE EQUALS NOTHING
#ASSERT `s 26(1AB) the special resolution needs to set out the text of the model constitution adopted` FALSE TRUE EQUALS NOTHING
-- (1A): subject to an entrenching provision.
#ASSERT `s 26(1A) the power in subsection (1) is subject to an entrenching provision` TRUE EQUALS JUST TRUE
#ASSERT `s 26(1A) the power in subsection (1) is subject to an entrenching provision` FALSE EQUALS NOTHING
-- (1B): a provision from before 1 April 2004 that could not then be altered: only if all the members agree.
#ASSERT `s 26(1B) the provision may be altered` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 26(1B) the provision may be altered` TRUE TRUE FALSE EQUALS JUST FALSE
-- A provision outside the subsection (not there before 1 April 2004, or alterable then): NOTHING.
#ASSERT `s 26(1B) the provision may be altered` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 26(1B) the provision may be altered` TRUE FALSE TRUE EQUALS NOTHING

§ `s 26(2): lodging within 14 days`

-- Passed on 1 March 2026; the 14 days after run to 15 March 2026 (P1: the day of the event is not counted).
-- Lodged on 15 March 2026 with the constitution copy: in time.
#ASSERT `s 26(2) the company has complied with the duty to lodge a copy of the resolution, order or other document` (Date 1 3 2026) TRUE (Date 15 3 2026) TRUE FALSE (Date 20 3 2026) EQUALS JUST TRUE
-- Lodged on 16 March 2026: a day late (JUST FALSE).
#ASSERT `s 26(2) the company has complied with the duty to lodge a copy of the resolution, order or other document` (Date 1 3 2026) TRUE (Date 16 3 2026) TRUE FALSE (Date 20 3 2026) EQUALS JUST FALSE
-- Lodged in time without the constitution copy and no dispensation: not complied with (JUST FALSE).
#ASSERT `s 26(2) the company has complied with the duty to lodge a copy of the resolution, order or other document` (Date 1 3 2026) TRUE (Date 10 3 2026) FALSE FALSE (Date 20 3 2026) EQUALS JUST FALSE
-- Without the constitution copy but the Registrar dispenses with it: complied with.
#ASSERT `s 26(2) the company has complied with the duty to lodge a copy of the resolution, order or other document` (Date 1 3 2026) TRUE (Date 10 3 2026) FALSE TRUE (Date 20 3 2026) EQUALS JUST TRUE
-- Not lodged, asked on 16 March 2026 (the 14 days have run): not complied with.
#ASSERT `s 26(2) the company has complied with the duty to lodge a copy of the resolution, order or other document` (Date 1 3 2026) FALSE (Date 1 1 2000) FALSE FALSE (Date 16 3 2026) EQUALS JUST FALSE
-- Not lodged, asked on 15 March 2026 (the last day): not yet a default, the text says nothing (NOTHING).
#ASSERT `s 26(2) the company has complied with the duty to lodge a copy of the resolution, order or other document` (Date 1 3 2026) FALSE (Date 1 1 2000) FALSE FALSE (Date 15 3 2026) EQUALS NOTHING

-- The regulative rule: an act on day 14 is in time, an act on day 15 is not. EXPECT comments are checked by hand against the output on both builds.
-- EXPECT FULFILLED
#TRACE `s 26(2) the company must lodge a copy within 14 days` "Acme Pte. Ltd." AT 0 WITH
    PARTY Company "Acme Pte. Ltd." DOES `s 26(2) lodge with the Registrar a copy of the resolution, other document or order, with a copy of the constitution as adopted or altered (unless the Registrar dispenses with it)` AT 14
-- EXPECT BREACH
#TRACE `s 26(2) the company must lodge a copy within 14 days` "Acme Pte. Ltd." AT 0 WITH
    PARTY Company "Acme Pte. Ltd." DOES `s 26(2) lodge with the Registrar a copy of the resolution, other document or order, with a copy of the constitution as adopted or altered (unless the Registrar dispenses with it)` AT 15
-- EXPECT BREACH
#TRACE `s 26(2) the company must lodge a copy within 14 days` "Acme Pte. Ltd." AT 0 WITH
    (WAITUNTIL 15)
-- EXPECT RESIDUAL
#TRACE `s 26(2) the company must lodge a copy within 14 days` "Acme Pte. Ltd." AT 0 WITH

§ `s 26(2A): the offence and the fine`

-- Default made, and the person is the company or an officer in default: guilty.
#ASSERT `s 26(2A) the person is guilty of the offence` TRUE TRUE EQUALS JUST TRUE
-- No default, or a person who is not the company and not an officer in default: the provision's own question, JUST FALSE (split site (i)).
#ASSERT `s 26(2A) the person is guilty of the offence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 26(2A) the person is guilty of the offence` TRUE FALSE EQUALS JUST FALSE
-- The penalty: a fine not exceeding $1,000 and also a default penalty; no imprisonment.
#ASSERT `s 26(2A) the most the person may be sentenced to on conviction` TRUE TRUE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
-- A boundary check on the amount: one dollar more is not what the text says.
#ASSERT NOT (`s 26(2A) the most the person may be sentenced to on conviction` TRUE TRUE EQUALS JUST (Penalty OF 1001, 0, FALSE, TRUE))
-- No penalty is stated for a person the subsection does not make guilty (NOTHING).
#ASSERT `s 26(2A) the most the person may be sentenced to on conviction` FALSE TRUE EQUALS NOTHING

§ `s 26(3) to (7)`

#ASSERT `s 26(3) the Registrar must register the document` TRUE EQUALS JUST TRUE
#ASSERT `s 26(3) the Registrar must register the document` FALSE EQUALS NOTHING
#ASSERT `s 26(3) the Registrar must issue to the company a notice of the registration of the order` TRUE EQUALS JUST TRUE
#ASSERT `s 26(3) the Registrar must issue to the company a notice of the registration of the order` FALSE EQUALS NOTHING
#ASSERT `s 26(5) the notice of the registration must be published in the manner directed` TRUE EQUALS JUST TRUE
#ASSERT `s 26(5) the notice of the registration must be published in the manner directed` FALSE EQUALS NOTHING
#ASSERT `s 26(6) the Registrar must issue a notice of incorporation in accordance with the alteration` TRUE EQUALS JUST TRUE
#ASSERT `s 26(6) the Registrar must issue a notice of incorporation in accordance with the alteration` FALSE EQUALS JUST FALSE
-- (7): on the application and payment of the prescribed fee.
#ASSERT `s 26(7) the Registrar must issue to the company a certificate confirming the incorporation in accordance with the alteration` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 26(7) the Registrar must issue to the company a certificate confirming the incorporation in accordance with the alteration` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 26(7) the Registrar must issue to the company a certificate confirming the incorporation in accordance with the alteration` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 26(7) the Registrar must issue to the company a certificate confirming the incorporation in accordance with the alteration` FALSE FALSE EQUALS JUST FALSE

§ `s 26A: entrenching provisions`

-- (4)(a): a provision that other specified provisions may not be altered in the manner provided by this Act.
#ASSERT `s 26A(4) the provision is an entrenching provision` TRUE TRUE FALSE 0 FALSE EQUALS JUST TRUE
-- (4)(b)(i): a specified majority greater than 75%: 75.01 qualifies, 75 does not (boundary).
#ASSERT `s 26A(4) the provision is an entrenching provision` TRUE FALSE TRUE 75.01 FALSE EQUALS JUST TRUE
#ASSERT `s 26A(4) the provision is an entrenching provision` TRUE FALSE TRUE 75 FALSE EQUALS JUST FALSE
#ASSERT `s 26A(4) the provision is an entrenching provision` TRUE FALSE TRUE 90 FALSE EQUALS JUST TRUE
-- (4)(b)(ii): other specified conditions.
#ASSERT `s 26A(4) the provision is an entrenching provision` TRUE FALSE FALSE 0 TRUE EQUALS JUST TRUE
-- Not a provision of a constitution, or none of the three kinds: not an entrenching provision.
#ASSERT `s 26A(4) the provision is an entrenching provision` FALSE TRUE FALSE 0 FALSE EQUALS JUST FALSE
#ASSERT `s 26A(4) the provision is an entrenching provision` TRUE FALSE FALSE 0 FALSE EQUALS JUST FALSE
-- (1)(a) and (b), (2), (3).
#ASSERT `s 26A(1)(a) the entrenching provision may be included in the constitution with which the company is formed` TRUE EQUALS JUST TRUE
#ASSERT `s 26A(1)(a) the entrenching provision may be included in the constitution with which the company is formed` FALSE EQUALS NOTHING
#ASSERT `s 26A(1)(b) the entrenching provision may be inserted in the constitution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 26A(1)(b) the entrenching provision may be inserted in the constitution` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 26A(1)(b) the entrenching provision may be inserted in the constitution` FALSE TRUE EQUALS NOTHING
#ASSERT `s 26A(2) the entrenching provision may be removed or altered` TRUE EQUALS JUST TRUE
#ASSERT `s 26A(2) the entrenching provision may be removed or altered` FALSE EQUALS JUST FALSE
#ASSERT `s 26A(3) the provisions of this Act on the alteration of the constitution are subject to the entrenching provision` TRUE EQUALS JUST TRUE
#ASSERT `s 26A(3) the provisions of this Act on the alteration of the constitution are subject to the entrenching provision` FALSE EQUALS NOTHING
