IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgb2-s173-registers`

-- Tests for s 173. Every expected value is written from the text, beside the assertion, before it was run.

§ `s 173(1) and (2): the Registrar keeps the registers`

-- The duty has no period: done, FULFILLED; not done, RESIDUAL; never BREACH.
-- EXPECT FULFILLED
#TRACE `s 173(1) the Registrar must keep a register of each company's directors, chief executive officers, secretaries and auditors` AT 0 WITH
    PARTY Registrar DOES `s 173(1) keep a register of the company's directors, chief executive officers, secretaries and auditors (if any)` AT 1

-- EXPECT RESIDUAL
#TRACE `s 173(1) the Registrar must keep a register of each company's directors, chief executive officers, secretaries and auditors` AT 0 WITH

#ASSERT `s 173(2) the register is kept in the form the Registrar may determine` TRUE EQUALS JUST TRUE
#ASSERT `s 173(2) the register is kept in the form the Registrar may determine` FALSE EQUALS JUST FALSE

§ `s 173(3) to (7): what each register must contain`

-- (3) directors: name and any former name, residential address, contact address, nationality, identification, appointment, cessation.
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(a) the register of directors` `s 173 the full name` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(a) the register of directors` `s 173 any former name` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(a) the register of directors` `s 173 the residential address` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(a) the register of directors` `s 173 the contact address` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(a) the register of directors` `s 173 the nationality` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(a) the register of directors` `s 173 the identification` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(a) the register of directors` `s 173 the date of appointment` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(a) the register of directors` `s 173 the date of cessation of appointment` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(a) the register of directors` `s 173 an address at which the auditors may be contacted` TRUE EQUALS NOTHING
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(a) the register of directors` `s 173 some other item` TRUE EQUALS NOTHING
-- (5) chief executive officers: the same, but (a) is the full name only: no former name.
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(b) the register of chief executive officers` `s 173 the full name` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(b) the register of chief executive officers` `s 173 any former name` TRUE EQUALS NOTHING
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(b) the register of chief executive officers` `s 173 the residential address` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(b) the register of chief executive officers` `s 173 the contact address` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(b) the register of chief executive officers` `s 173 the nationality` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(b) the register of chief executive officers` `s 173 the identification` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(b) the register of chief executive officers` `s 173 the date of appointment` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(b) the register of chief executive officers` `s 173 the date of cessation of appointment` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(b) the register of chief executive officers` `s 173 an address at which the auditors may be contacted` TRUE EQUALS NOTHING
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(b) the register of chief executive officers` `s 173 some other item` TRUE EQUALS NOTHING
-- (6) secretaries: name, residential address, contact address, identification, appointment, cessation: no nationality, no former name.
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(c) the register of secretaries` `s 173 the full name` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(c) the register of secretaries` `s 173 any former name` TRUE EQUALS NOTHING
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(c) the register of secretaries` `s 173 the residential address` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(c) the register of secretaries` `s 173 the contact address` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(c) the register of secretaries` `s 173 the nationality` TRUE EQUALS NOTHING
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(c) the register of secretaries` `s 173 the identification` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(c) the register of secretaries` `s 173 the date of appointment` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(c) the register of secretaries` `s 173 the date of cessation of appointment` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(c) the register of secretaries` `s 173 an address at which the auditors may be contacted` TRUE EQUALS NOTHING
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(c) the register of secretaries` `s 173 some other item` TRUE EQUALS NOTHING
-- (7) auditors: name, an address at which they may be contacted, identification if any, appointment, cessation.
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(d) the register of auditors` `s 173 the full name` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(d) the register of auditors` `s 173 any former name` TRUE EQUALS NOTHING
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(d) the register of auditors` `s 173 the residential address` TRUE EQUALS NOTHING
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(d) the register of auditors` `s 173 the contact address` TRUE EQUALS NOTHING
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(d) the register of auditors` `s 173 the nationality` TRUE EQUALS NOTHING
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(d) the register of auditors` `s 173 the identification` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(d) the register of auditors` `s 173 the date of appointment` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(d) the register of auditors` `s 173 the date of cessation of appointment` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(d) the register of auditors` `s 173 an address at which the auditors may be contacted` TRUE EQUALS JUST TRUE
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(d) the register of auditors` `s 173 some other item` TRUE EQUALS NOTHING
-- (7)(c) "identification, if any": an auditor with none: NOTHING.
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(d) the register of auditors` `s 173 the identification` FALSE EQUALS NOTHING
-- For the other registers the flag does not matter.
#ASSERT `s 173 the register must contain the item of information for the person` `s 173(1)(a) the register of directors` `s 173 the identification` FALSE EQUALS JUST TRUE

§ `s 173(4): the former name is kept for 5 years`

-- Furnished 1 March 2026: kept up to and including 1 March 2031.
#ASSERT `s 173(4) the Registrar must keep the former name of the director in the register on the day` (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 173(4) the Registrar must keep the former name of the director in the register on the day` (Date 1 3 2026) (Date 1 3 2031) EQUALS JUST TRUE
#ASSERT `s 173(4) the Registrar must keep the former name of the director in the register on the day` (Date 1 3 2026) (Date 2 3 2031) EQUALS JUST FALSE
#ASSERT `s 173(4) the Registrar must keep the former name of the director in the register on the day` (Date 1 3 2026) (Date 28 2 2026) EQUALS NOTHING

§ `s 173(8) to (11): evidence, certificates and who is a director`

#ASSERT `s 173(8) the entry in the register is prima facie evidence of the truth of the matter` TRUE EQUALS JUST TRUE
#ASSERT `s 173(8) the entry in the register is prima facie evidence of the truth of the matter` FALSE EQUALS NOTHING
#ASSERT `s 173(9) the certificate is received as prima facie evidence of the entry of the particulars in the register` TRUE EQUALS JUST TRUE
#ASSERT `s 173(9) the certificate is received as prima facie evidence of the entry of the particulars in the register` FALSE EQUALS NOTHING
-- (10): until a notification of change shows the person has ceased or been disqualified.
#ASSERT `s 173(10) the certificate is received as prima facie evidence of the fact that the person was named in the register` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 173(10) the certificate is received as prima facie evidence of the fact that the person was named in the register` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 173(10) the certificate is received as prima facie evidence of the fact that the person was named in the register` FALSE FALSE EQUALS NOTHING
#ASSERT `s 173(11) the person is within the word director in the section` `s 173(11) a director` EQUALS JUST TRUE
#ASSERT `s 173(11) the person is within the word director in the section` `s 173(11) an alternate` EQUALS JUST TRUE
#ASSERT `s 173(11) the person is within the word director in the section` `s 173(11) a substitute` EQUALS JUST TRUE
#ASSERT `s 173(11) the person is within the word director in the section` `s 173(11) a local director` EQUALS JUST TRUE
#ASSERT `s 173(11) the person is within the word director in the section` `s 173(11) another person` EQUALS NOTHING

§ `s 173(14) and (15): service of documents`

#ASSERT `s 173(14) the document is sufficiently served on the person` `s 173(14) a director` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 173(14) the document is sufficiently served on the person` `s 173(14) a chief executive officer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 173(14) the document is sufficiently served on the person` `s 173(14) a secretary` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 173(14) the document is sufficiently served on the person` `s 173(14) a director` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 173(14) the document is sufficiently served on the person` `s 173(14) a director` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 173(14) the document is sufficiently served on the person` `s 173(14) another person` TRUE TRUE EQUALS NOTHING
#ASSERT `s 173(15) the document is sufficiently served on the auditor` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 173(15) the document is sufficiently served on the auditor` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 173(15) the document is sufficiently served on the auditor` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 173(15) the document is sufficiently served on the auditor` FALSE TRUE TRUE EQUALS NOTHING
