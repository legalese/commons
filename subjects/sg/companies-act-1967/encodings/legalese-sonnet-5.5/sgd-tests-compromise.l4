IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sg-definitions`
IMPORT `sgd-compromise`

-- Tests for sgd-compromise.l4: Companies Act 1967, ss 210 to 212.
-- Every expected value is written from the text (the comment beside it quotes the words), never from the module's output.
-- A line "-- EXPECT <word>" above a #TRACE says what the trace must print: FULFILLED, BREACH, or RESIDUAL (an obligation still open).

§ `Section 210(2): who may apply`

-- (2)(a): "in the case of a company being wound up — the liquidator"; (2)(b): "in any other case — (i) the company; or (ii) any creditor, member or holder of units of shares of the company".
#ASSERT `s 210(2) the person is a person referred to in subsection (1)` TRUE `s 210(2)(a) the liquidator of the company` EQUALS JUST TRUE
#ASSERT `s 210(2) the person is a person referred to in subsection (1)` TRUE `s 210(2)(b)(i) the company` EQUALS JUST FALSE
#ASSERT `s 210(2) the person is a person referred to in subsection (1)` TRUE `s 210(2)(b)(ii) a creditor of the company` EQUALS JUST FALSE
#ASSERT `s 210(2) the person is a person referred to in subsection (1)` TRUE `s 210(2)(b)(ii) a member of the company` EQUALS JUST FALSE
#ASSERT `s 210(2) the person is a person referred to in subsection (1)` TRUE `s 210(2)(b)(ii) a holder of units of shares of the company` EQUALS JUST FALSE
#ASSERT `s 210(2) the person is a person referred to in subsection (1)` TRUE `s 210(2) some other person` EQUALS JUST FALSE
#ASSERT `s 210(2) the person is a person referred to in subsection (1)` FALSE `s 210(2)(a) the liquidator of the company` EQUALS JUST FALSE
#ASSERT `s 210(2) the person is a person referred to in subsection (1)` FALSE `s 210(2)(b)(i) the company` EQUALS JUST TRUE
#ASSERT `s 210(2) the person is a person referred to in subsection (1)` FALSE `s 210(2)(b)(ii) a creditor of the company` EQUALS JUST TRUE
#ASSERT `s 210(2) the person is a person referred to in subsection (1)` FALSE `s 210(2)(b)(ii) a member of the company` EQUALS JUST TRUE
#ASSERT `s 210(2) the person is a person referred to in subsection (1)` FALSE `s 210(2)(b)(ii) a holder of units of shares of the company` EQUALS JUST TRUE
#ASSERT `s 210(2) the person is a person referred to in subsection (1)` FALSE `s 210(2) some other person` EQUALS JUST FALSE

§ `Section 210(1): the Court may order a meeting`

-- (1): a compromise or arrangement between a company and (a) creditors, (b) members, (c) holders of units of shares; on the application of a person referred to in (2).
#ASSERT `s 210(1) the Court may order a meeting to be summoned` `s 210(1)(a) a compromise or an arrangement between a company and its creditors or any class of them` FALSE `s 210(2)(b)(ii) a creditor of the company` EQUALS JUST TRUE
#ASSERT `s 210(1) the Court may order a meeting to be summoned` `s 210(1)(b) a compromise or an arrangement between a company and its members or any class of them` FALSE `s 210(2)(b)(ii) a member of the company` EQUALS JUST TRUE
#ASSERT `s 210(1) the Court may order a meeting to be summoned` `s 210(1)(c) a compromise or an arrangement between a company and holders of units of shares of the company or any class of them` FALSE `s 210(2)(b)(ii) a holder of units of shares of the company` EQUALS JUST TRUE
#ASSERT `s 210(1) the Court may order a meeting to be summoned` `s 210(1)(a) a compromise or an arrangement between a company and its creditors or any class of them` FALSE `s 210(2)(b)(i) the company` EQUALS JUST TRUE
#ASSERT `s 210(1) the Court may order a meeting to be summoned` `s 210(1)(a) a compromise or an arrangement between a company and its creditors or any class of them` TRUE `s 210(2)(a) the liquidator of the company` EQUALS JUST TRUE
-- a creditor applying for a company being wound up is not a person referred to in (2): the application gate fails
#ASSERT `s 210(1) the Court may order a meeting to be summoned` `s 210(1)(a) a compromise or an arrangement between a company and its creditors or any class of them` TRUE `s 210(2)(b)(ii) a creditor of the company` EQUALS JUST FALSE
-- a proposal of some other kind: the "Where" gate fails
#ASSERT `s 210(1) the Court may order a meeting to be summoned` `s 210(1) a proposal of some other kind` FALSE `s 210(2)(b)(i) the company` EQUALS JUST FALSE
#ASSERT `s 210(1) the Court may order a meeting to be summoned` `s 210(1)(a) a compromise or an arrangement between a company and its creditors or any class of them` FALSE `s 210(2) some other person` EQUALS JUST FALSE

§ `Section 210(3): adjourning the meeting`

-- Ten persons present and voting holding value 100. "a majority in number": more than half; "three-fourths in value": at least 75.
sgd_vote_ok MEANS `s 210(3) vote` OF 10, 6, 100, 75
sgd_vote_exactly_half MEANS `s 210(3) vote` OF 10, 5, 100, 80
sgd_vote_value_short MEANS `s 210(3) vote` OF 10, 6, 100, 74
sgd_vote_nobody MEANS `s 210(3) vote` OF 0, 0, 0, 0

#ASSERT `s 210(3) a majority in number of those present and voting voted in favour` sgd_vote_ok
#ASSERT NOT (`s 210(3) a majority in number of those present and voting voted in favour` sgd_vote_exactly_half)
#ASSERT `s 210(3) those who voted in favour represent three-fourths in value of those present and voting` sgd_vote_ok
#ASSERT NOT (`s 210(3) those who voted in favour represent three-fourths in value of those present and voting` sgd_vote_value_short)
#ASSERT NOT (`s 210(3) those who voted in favour represent three-fourths in value of those present and voting` sgd_vote_nobody)
#ASSERT `s 210(3) the meeting may be adjourned` sgd_vote_ok EQUALS JUST TRUE
#ASSERT `s 210(3) the meeting may be adjourned` sgd_vote_exactly_half EQUALS NOTHING
#ASSERT `s 210(3) the meeting may be adjourned` sgd_vote_value_short EQUALS NOTHING
#ASSERT `s 210(3) the meeting may be adjourned` sgd_vote_nobody EQUALS NOTHING

§ `Section 210(3AB): the conditions for the compromise or arrangement to bind`

-- (a) majority in number, unless the Court orders otherwise; (b) three-fourths in value; (c) approved by order of the Court.
#ASSERT `s 210(3AB) the conditions for the compromise or arrangement to be binding are satisfied` sgd_vote_ok FALSE 0 TRUE EQUALS JUST TRUE
#ASSERT `s 210(3AB) the conditions for the compromise or arrangement to be binding are satisfied` sgd_vote_ok FALSE 0 FALSE EQUALS JUST FALSE
#ASSERT `s 210(3AB) the conditions for the compromise or arrangement to be binding are satisfied` sgd_vote_exactly_half FALSE 0 TRUE EQUALS JUST FALSE
#ASSERT `s 210(3AB) the conditions for the compromise or arrangement to be binding are satisfied` sgd_vote_value_short FALSE 0 TRUE EQUALS JUST FALSE
-- the Court orders a number: 5 of the 10 agree and the Court ordered 5, with three-fourths in value
#ASSERT `s 210(3AB) the conditions for the compromise or arrangement to be binding are satisfied` (`s 210(3) vote` OF 10, 5, 100, 80) TRUE 5 TRUE EQUALS JUST TRUE
#ASSERT `s 210(3AB) the conditions for the compromise or arrangement to be binding are satisfied` (`s 210(3) vote` OF 10, 4, 100, 80) TRUE 5 TRUE EQUALS JUST FALSE
-- the Court ordered a higher number than a majority: 6 agree, 8 ordered
#ASSERT `s 210(3AB) the conditions for the compromise or arrangement to be binding are satisfied` sgd_vote_ok TRUE 8 TRUE EQUALS JUST FALSE
-- the Court ordered a number but the value test still bites
#ASSERT `s 210(3AB) the conditions for the compromise or arrangement to be binding are satisfied` sgd_vote_value_short TRUE 3 TRUE EQUALS JUST FALSE

§ `Section 210(3AA): whom the compromise or arrangement binds`

-- Conditions not satisfied: "If the conditions ... are satisfied, a compromise or an arrangement is binding" (a failed "if").
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` FALSE FALSE `s 210(3AA) a creditor of the class concerned` EQUALS JUST FALSE
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` FALSE TRUE `s 210(3AA)(a) the liquidator of a company in the course of being wound up` EQUALS JUST FALSE
-- (a) a company in the course of being wound up: the liquidator, the contributories, and all the creditors, members or holders of units of the class
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` TRUE TRUE `s 210(3AA)(a) the liquidator of a company in the course of being wound up` EQUALS JUST TRUE
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` TRUE TRUE `s 210(3AA)(a) a contributory of a company in the course of being wound up` EQUALS JUST TRUE
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` TRUE TRUE `s 210(3AA) a creditor of the class concerned` EQUALS JUST TRUE
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` TRUE TRUE `s 210(3AA) a member of the class concerned` EQUALS JUST TRUE
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` TRUE TRUE `s 210(3AA) a holder of units of shares of the class concerned` EQUALS JUST TRUE
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` TRUE TRUE `s 210(3AA)(b) the company, where it is not in the course of being wound up` EQUALS NOTHING
-- (b) any other company: the company and all the creditors, members or holders of units of the class
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` TRUE FALSE `s 210(3AA)(b) the company, where it is not in the course of being wound up` EQUALS JUST TRUE
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` TRUE FALSE `s 210(3AA) a member of the class concerned` EQUALS JUST TRUE
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` TRUE FALSE `s 210(3AA)(a) the liquidator of a company in the course of being wound up` EQUALS NOTHING
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` TRUE FALSE `s 210(3AA)(a) a contributory of a company in the course of being wound up` EQUALS NOTHING
-- a person the subsection does not name
#ASSERT `s 210(3AA) the compromise or arrangement is binding on the party` TRUE FALSE `s 210(3AA) some other person` EQUALS NOTHING

§ `Section 210(4): the Court's approval with conditions`

#ASSERT `s 210(4) the Court may grant its approval subject to the alteration or condition` TRUE EQUALS JUST TRUE
#ASSERT `s 210(4) the Court may grant its approval subject to the alteration or condition` FALSE EQUALS NOTHING

§ `Section 210(5): the order takes effect`

-- "has no effect until a copy of the order is lodged with the Registrar"
#ASSERT `s 210(5) the order cannot yet have effect` FALSE EQUALS JUST TRUE
#ASSERT `s 210(5) the order cannot yet have effect` TRUE EQUALS JUST FALSE
-- not lodged: no date yet
#ASSERT `s 210(5) the date from which the order takes effect` FALSE (Date 10 3 2026) FALSE (Date 1 3 2026) EQUALS NOTHING
-- lodged, nothing earlier specified: "on and from the date of lodgment"
#ASSERT `s 210(5) the date from which the order takes effect` TRUE (Date 10 3 2026) FALSE (Date 1 3 2026) EQUALS JUST (Date 10 3 2026)
-- lodged on 10 March, the Court determined 1 March and the order specifies it: "such earlier date"
#ASSERT `s 210(5) the date from which the order takes effect` TRUE (Date 10 3 2026) TRUE (Date 1 3 2026) EQUALS JUST (Date 1 3 2026)
-- the day before the lodgment is earlier; the same day and a later day are not "such earlier date"
#ASSERT `s 210(5) the date from which the order takes effect` TRUE (Date 10 3 2026) TRUE (Date 9 3 2026) EQUALS JUST (Date 9 3 2026)
#ASSERT `s 210(5) the date from which the order takes effect` TRUE (Date 10 3 2026) TRUE (Date 10 3 2026) EQUALS NOTHING
#ASSERT `s 210(5) the date from which the order takes effect` TRUE (Date 10 3 2026) TRUE (Date 11 3 2026) EQUALS NOTHING

§ `Sections 210(6) and (7): the order annexed to the constitution`

-- args: issued after the order, exempted by the Court, the Court determined a period, issued within that period
#ASSERT `s 210(6) a copy of the order must be annexed to the copy of the constitution` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 210(6) a copy of the order must be annexed to the copy of the constitution` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 210(6) a copy of the order must be annexed to the copy of the constitution` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 210(6) a copy of the order must be annexed to the copy of the constitution` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- a copy issued before the order was made is outside "issued after the order has been made"
#ASSERT `s 210(6) a copy of the order must be annexed to the copy of the constitution` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 210(7) the Court may do it by order` `s 210(7) exempts the company from compliance with subsection (6)` EQUALS JUST TRUE
#ASSERT `s 210(7) the Court may do it by order` `s 210(7) determines the period during which the company must comply with subsection (6)` EQUALS JUST TRUE
#ASSERT `s 210(7) the Court may do it by order` `s 210(7) does something else` EQUALS NOTHING

§ `Section 210(8): the report of accountants or solicitors`

-- (a): "Where any such compromise or arrangement ... has been proposed, the directors ... must (a) if a meeting of the members of the company by resolution so directs, instruct ..."
#ASSERT `s 210(8)(a) the directors must instruct the accountants or solicitors named in the resolution to report` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 210(8)(a) the directors must instruct the accountants or solicitors named in the resolution to report` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 210(8)(a) the directors must instruct the accountants or solicitors named in the resolution to report` FALSE TRUE EQUALS JUST FALSE
-- (b): "at least 7 days before the date of any meeting": a meeting on 30 March 2026; the last day is 23 March 2026
#ASSERT `s 210(8)(b) the reports have been made available at least 7 days before the meeting` (Date 30 3 2026) (Date 23 3 2026) EQUALS JUST TRUE
#ASSERT `s 210(8)(b) the reports have been made available at least 7 days before the meeting` (Date 30 3 2026) (Date 24 3 2026) EQUALS JUST FALSE
#ASSERT `s 210(8)(b) the reports have been made available at least 7 days before the meeting` (Date 30 3 2026) (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 210(8)(b) the reports have been made available at least 7 days before the meeting` (Date 30 3 2026) (Date 30 3 2026) EQUALS JUST FALSE
#ASSERT `s 210(8)(b) the number of days from the start day to the latest day for the reports` (Date 30 3 2026) (Date 1 3 2026) EQUALS 22
-- across a month end: a meeting on 3 March 2026 needs the reports on or before 24 February 2026
#ASSERT `s 210(8)(b) the reports have been made available at least 7 days before the meeting` (Date 3 3 2026) (Date 24 2 2026) EQUALS JUST TRUE
#ASSERT `s 210(8)(b) the reports have been made available at least 7 days before the meeting` (Date 3 3 2026) (Date 25 2 2026) EQUALS JUST FALSE

§ `Section 210(9): the offence`

#ASSERT `s 210(9) the company is guilty of the offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 210(9) the company is guilty of the offence` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 210(9) the company is guilty of the offence` FALSE FALSE EQUALS JUST FALSE
-- every officer of the company who is in default (the position decides whether the person is an officer: s 4(1) "officer")
#ASSERT `s 210(9) the officer is guilty of the offence` TRUE FALSE TRUE `s 4(1) "officer" a director of the corporation` EQUALS JUST TRUE
#ASSERT `s 210(9) the officer is guilty of the offence` FALSE TRUE TRUE `s 4(1) "officer" the secretary of the corporation` EQUALS JUST TRUE
#ASSERT `s 210(9) the officer is guilty of the offence` TRUE FALSE FALSE `s 4(1) "officer" a director of the corporation` EQUALS JUST FALSE
#ASSERT `s 210(9) the officer is guilty of the offence` FALSE FALSE TRUE `s 4(1) "officer" a director of the corporation` EQUALS JUST FALSE
#ASSERT `s 210(9) the officer is guilty of the offence` TRUE FALSE TRUE `s 4(1) "officer" a receiver who is not also a manager` EQUALS JUST FALSE
#ASSERT `s 210(9) the officer is guilty of the offence` TRUE FALSE TRUE `s 4(1) "officer" anyone else` EQUALS NOTHING
-- "a fine not exceeding $2,000": no imprisonment, no default penalty
#ASSERT `s 210(9) the most the person may be sentenced to on conviction` TRUE EQUALS JUST (`s 210(9) penalty` OF 2000, 0, FALSE, FALSE)
#ASSERT `s 210(9) the most the person may be sentenced to on conviction` FALSE EQUALS NOTHING

§ `Section 210(10): restraining proceedings`

#ASSERT `s 210(10) the Court may restrain further proceedings against the company` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 210(10) the Court may restrain further proceedings against the company` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 210(10) the Court may restrain further proceedings against the company` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 210(10) the Court may restrain further proceedings against the company` TRUE TRUE FALSE EQUALS JUST FALSE
-- what the restraint means for a person with an action: "except by permission of the Court"
#ASSERT `s 210(10) further proceedings against the company may continue` FALSE FALSE EQUALS NOTHING
#ASSERT `s 210(10) further proceedings against the company may continue` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 210(10) further proceedings against the company may continue` TRUE TRUE EQUALS JUST TRUE

§ `Section 210(10A): money held in trust`

-- Received on 1 March 2020. The last day of the 2 years is 1 March 2022; of the 10 years, 1 March 2030 (P1, P4).
#ASSERT `s 210(10A) the transfer to the Official Receiver is within the time the subsection allows` TRUE (Date 1 3 2020) (Date 1 3 2022) EQUALS JUST FALSE
#ASSERT `s 210(10A) the transfer to the Official Receiver is within the time the subsection allows` TRUE (Date 1 3 2020) (Date 2 3 2022) EQUALS JUST TRUE
#ASSERT `s 210(10A) the transfer to the Official Receiver is within the time the subsection allows` TRUE (Date 1 3 2020) (Date 1 3 2030) EQUALS JUST TRUE
#ASSERT `s 210(10A) the transfer to the Official Receiver is within the time the subsection allows` TRUE (Date 1 3 2020) (Date 2 3 2030) EQUALS JUST FALSE
#ASSERT `s 210(10A) the transfer to the Official Receiver is within the time the subsection allows` FALSE (Date 1 3 2020) (Date 2 3 2025) EQUALS JUST FALSE
-- received on 29 February 2020: 2 years later clamps to 28 February 2022 (P4)
#ASSERT `s 210(10A) the transfer to the Official Receiver is within the time the subsection allows` TRUE (Date 29 2 2020) (Date 28 2 2022) EQUALS JUST FALSE
#ASSERT `s 210(10A) the transfer to the Official Receiver is within the time the subsection allows` TRUE (Date 29 2 2020) (Date 1 3 2022) EQUALS JUST TRUE
-- 1 March 2020 to 1 March 2030 is 3,652 days (two leap days, 2024 and 2028)
#ASSERT `s 210(10A) the number of days from the start day to the last day before the 10 years expire` (Date 1 3 2020) (Date 1 3 2020) EQUALS 3652

§ `Section 210(10B): the Official Receiver`

#ASSERT `s 210(10B) how the Official Receiver must deal with what is received` TRUE FALSE EQUALS JUST `s 210(10B)(a) dealt with as if the moneys were paid to the Official Receiver under section 197 of the Insolvency, Restructuring and Dissolution Act 2018`
#ASSERT `s 210(10B) how the Official Receiver must deal with what is received` FALSE TRUE EQUALS JUST `s 210(10B)(b) sold or disposed of in the manner the Official Receiver thinks fit, the proceeds dealt with as if moneys paid under section 197 of that Act`
#ASSERT `s 210(10B) how the Official Receiver must deal with what is received` FALSE FALSE EQUALS NOTHING

§ `Section 210(11): the words defined`

#ASSERT `s 210(11) "arrangement" the thing is within the word arrangement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 210(11) "arrangement" the thing is within the word arrangement` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 210(11) "arrangement" the thing is within the word arrangement` FALSE FALSE EQUALS NOTHING
#ASSERT `s 210(11) "company" the body is a company` TRUE EQUALS JUST TRUE
#ASSERT `s 210(11) "company" the body is a company` FALSE EQUALS JUST FALSE
#ASSERT `s 210(11) "holder of units of shares" the person is a holder of units of shares` TRUE EQUALS JUST FALSE
#ASSERT `s 210(11) "holder of units of shares" the person is a holder of units of shares` FALSE EQUALS NOTHING

§ `Section 211(1) to (3): the information that goes with the notice`

-- (1)(a): a notice sent to a creditor, member or holder of units: a statement explaining the effect, stating the directors' material interests
#ASSERT `s 211(1) the notice carries what the subsection requires` TRUE `s 211(1)(a) a notice summoning the meeting sent to a creditor, member or holder of units of shares of the company` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 211(1) the notice carries what the subsection requires` TRUE `s 211(1)(a) a notice summoning the meeting sent to a creditor, member or holder of units of shares of the company` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 211(1) the notice carries what the subsection requires` TRUE `s 211(1)(a) a notice summoning the meeting sent to a creditor, member or holder of units of shares of the company` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- (1)(b): a notice given by advertisement: either the statement or the notification of where copies may be had
#ASSERT `s 211(1) the notice carries what the subsection requires` TRUE `s 211(1)(b) a notice summoning the meeting given by advertisement` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 211(1) the notice carries what the subsection requires` TRUE `s 211(1)(b) a notice summoning the meeting given by advertisement` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 211(1) the notice carries what the subsection requires` TRUE `s 211(1)(b) a notice summoning the meeting given by advertisement` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- no meeting summoned under s 210: the "Where" gate fails
#ASSERT `s 211(1) the notice carries what the subsection requires` FALSE `s 211(1)(b) a notice summoning the meeting given by advertisement` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- (2): debenture holders
#ASSERT `s 211(2) the statement gives what the subsection requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 211(2) the statement gives what the subsection requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 211(2) the statement gives what the subsection requires` FALSE TRUE EQUALS JUST FALSE
-- (3): a copy free of charge
#ASSERT `s 211(3) the company must furnish the person with a copy of the statement free of charge` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 211(3) the company must furnish the person with a copy of the statement free of charge` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 211(3) the company must furnish the person with a copy of the statement free of charge` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 211(3) the company must furnish the person with a copy of the statement free of charge` TRUE TRUE FALSE EQUALS JUST FALSE

§ `Section 211(4) to (7): notice by directors and trustees; the offence; the defence`

-- (4): "within 7 days of the receipt of a request in writing": request received 10 March 2026; the last day is 17 March 2026
#ASSERT `s 211(4) the director or trustee gave notice within 7 days of the receipt of the request` (Date 10 3 2026) (Date 17 3 2026) EQUALS JUST TRUE
#ASSERT `s 211(4) the director or trustee gave notice within 7 days of the receipt of the request` (Date 10 3 2026) (Date 18 3 2026) EQUALS JUST FALSE
#ASSERT `s 211(4) the director or trustee gave notice within 7 days of the receipt of the request` (Date 10 3 2026) (Date 10 3 2026) EQUALS JUST TRUE
#ASSERT `s 211(4) the number of days from the start day to the last day for the notice` (Date 10 3 2026) (Date 10 3 2026) EQUALS 7
-- across a month end: a request received 28 February 2026 gives 7 March 2026
#ASSERT `s 211(4) the director or trustee gave notice within 7 days of the receipt of the request` (Date 28 2 2026) (Date 7 3 2026) EQUALS JUST TRUE
#ASSERT `s 211(4) the director or trustee gave notice within 7 days of the receipt of the request` (Date 28 2 2026) (Date 8 3 2026) EQUALS JUST FALSE
-- (6): the liquidator and any trustee for debenture holders are deemed to be officers
#ASSERT `s 211(6) the person is deemed to be an officer of the company for subsection (5)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 211(6) the person is deemed to be an officer of the company for subsection (5)` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 211(6) the person is deemed to be an officer of the company for subsection (5)` FALSE FALSE EQUALS NOTHING
-- (5): the company
#ASSERT `s 211(5) the company is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 211(5) the company is guilty of the offence` FALSE EQUALS JUST FALSE
-- (5): an officer in default; a liquidator appointed by the Court is not an officer under s 4(1) but is deemed one by (6)
#ASSERT `s 211(5) the officer is guilty of the offence` TRUE TRUE `s 4(1) "officer" a director of the corporation` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 211(5) the officer is guilty of the offence` TRUE TRUE `s 4(1) "officer" a liquidator appointed by the Court or by the creditors` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 211(5) the officer is guilty of the offence` TRUE TRUE `s 4(1) "officer" a liquidator appointed by the Court or by the creditors` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 211(5) the officer is guilty of the offence` TRUE FALSE `s 4(1) "officer" a director of the corporation` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 211(5) the officer is guilty of the offence` FALSE TRUE `s 4(1) "officer" a director of the corporation` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 211(5) the officer is guilty of the offence` TRUE TRUE `s 4(1) "officer" anyone else` FALSE FALSE EQUALS NOTHING
-- "a fine not exceeding $5,000 or to imprisonment for a term not exceeding 12 months" (the text says "or", not "or to both")
#ASSERT `s 211(5) the most the person may be sentenced to on conviction` TRUE EQUALS JUST (`s 210(9) penalty` OF 5000, 12, FALSE, FALSE)
#ASSERT `s 211(5) the most the person may be sentenced to on conviction` FALSE EQUALS NOTHING
-- (7): the defence
#ASSERT `s 211(7) the section gives the person a defence` TRUE EQUALS JUST TRUE
#ASSERT `s 211(7) the section gives the person a defence` FALSE EQUALS JUST FALSE
#ASSERT `s 211(5) and (7) the person is liable under subsection (5)` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 211(5) and (7) the person is liable under subsection (5)` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 211(5) and (7) the person is liable under subsection (5)` FALSE FALSE EQUALS JUST FALSE

§ `Section 212(1) and (2): the Court's order`

#ASSERT `s 212(1) the Court may provide for the matter by its order` TRUE TRUE TRUE `s 212(1)(a) the transfer to the transferee company of the whole or any part of the undertaking and of the property or liabilities of the transferor company` EQUALS JUST TRUE
#ASSERT `s 212(1) the Court may provide for the matter by its order` TRUE TRUE TRUE `s 212(1)(d) the dissolution, without winding up, of the transferor company` EQUALS JUST TRUE
#ASSERT `s 212(1) the Court may provide for the matter by its order` TRUE TRUE TRUE `s 212(1)(f) such incidental, consequential and supplemental matters as are necessary to secure that the reconstruction or amalgamation is fully and effectively carried out` EQUALS JUST TRUE
#ASSERT `s 212(1) the Court may provide for the matter by its order` TRUE TRUE TRUE `s 212(1) some other matter` EQUALS NOTHING
#ASSERT `s 212(1) the Court may provide for the matter by its order` FALSE TRUE TRUE `s 212(1)(a) the transfer to the transferee company of the whole or any part of the undertaking and of the property or liabilities of the transferor company` EQUALS JUST FALSE
