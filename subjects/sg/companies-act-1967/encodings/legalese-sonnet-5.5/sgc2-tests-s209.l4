IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgc2-common`
IMPORT `sgc2-s209-interpretation`

-- Tests for sgc2-s209-interpretation.l4 (sections 209 and 209A; section 209B is repealed). Every expected value is written from the text of the sections, beside the assertion, not from the code.
-- A date is Date day month year. Argument order is the order of the GIVEN lines of the function under test.

§ `Section 209(1)`

-- "within 7 days after furnishing": the day of furnishing is not counted, so furnished on 1 March the last day is 8 March; furnished on 25 February 2026, 4 March (not a leap year).
#ASSERT `s 209(1) the last day for the auditor to send a copy to every trustee` (Date 1 3 2026) EQUALS Date 8 3 2026
#ASSERT `s 209(1) the last day for the auditor to send a copy to every trustee` (Date 25 2 2026) EQUALS Date 4 3 2026
#ASSERT `s 209(1) the last day for the auditor to send a copy to every trustee` (Date 28 2 2028) EQUALS Date 6 3 2028
-- Arguments: a borrowing corporation, a document furnished, the day it was furnished, a copy sent to every trustee by post, the day sent, the day as at which asked.
-- Sent on the last day: in time. Sent a day later: in default.
#ASSERT `s 209(1) the auditor is in default of the duty to send a copy to every trustee` TRUE TRUE (Date 1 3 2026) TRUE (Date 8 3 2026) (Date 1 4 2026) EQUALS JUST FALSE
#ASSERT `s 209(1) the auditor is in default of the duty to send a copy to every trustee` TRUE TRUE (Date 1 3 2026) TRUE (Date 9 3 2026) (Date 1 4 2026) EQUALS JUST TRUE
-- Not sent: on the last day the time is still running; the day after, in default.
#ASSERT `s 209(1) the auditor is in default of the duty to send a copy to every trustee` TRUE TRUE (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 8 3 2026) EQUALS JUST FALSE
#ASSERT `s 209(1) the auditor is in default of the duty to send a copy to every trustee` TRUE TRUE (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 9 3 2026) EQUALS JUST TRUE
-- Not a borrowing corporation, or nothing furnished: the duty does not arise.
#ASSERT `s 209(1) the auditor is in default of the duty to send a copy to every trustee` FALSE TRUE (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 9 3 2026) EQUALS JUST FALSE
#ASSERT `s 209(1) the auditor is in default of the duty to send a copy to every trustee` TRUE FALSE (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 9 3 2026) EQUALS JUST FALSE

-- Furnished on 1 March 2026: 7 days.
-- EXPECT FULFILLED
#TRACE `s 209(1) the auditor must send a copy to every trustee within 7 days` "Lim & Co" (Date 1 3 2026) AT 0 WITH
    PARTY Auditor "Lim & Co" DOES `s 209(1) send by post to every trustee for the holders of debentures of the borrowing corporation a copy of the financial statements or of the report, certificate or other document` AT 7

-- EXPECT BREACH
#TRACE `s 209(1) the auditor must send a copy to every trustee within 7 days` "Lim & Co" (Date 1 3 2026) AT 0 WITH
    PARTY Auditor "Lim & Co" DOES `s 209(1) send by post to every trustee for the holders of debentures of the borrowing corporation a copy of the financial statements or of the report, certificate or other document` AT 8

-- EXPECT BREACH
#TRACE `s 209(1) the auditor must send a copy to every trustee within 7 days` "Lim & Co" (Date 1 3 2026) AT 0 WITH
    (WAITUNTIL 8)

-- EXPECT RESIDUAL
#TRACE `s 209(1) the auditor must send a copy to every trustee within 7 days` "Lim & Co" (Date 1 3 2026) AT 0 WITH
    (WAITUNTIL 7)

§ `Section 209(2) and (3)`

#ASSERT `s 209(2) the last day for the auditor to send the report` (Date 1 3 2026) EQUALS Date 8 3 2026
-- Arguments: a borrowing corporation, aware of a relevant matter, the day aware, report and copy sent, the day sent, the day as at which asked.
#ASSERT `s 209(2) the auditor is in default of the duty to send the report` TRUE TRUE (Date 1 3 2026) TRUE (Date 8 3 2026) (Date 1 4 2026) EQUALS JUST FALSE
#ASSERT `s 209(2) the auditor is in default of the duty to send the report` TRUE TRUE (Date 1 3 2026) TRUE (Date 9 3 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `s 209(2) the auditor is in default of the duty to send the report` TRUE TRUE (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 8 3 2026) EQUALS JUST FALSE
#ASSERT `s 209(2) the auditor is in default of the duty to send the report` TRUE TRUE (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 9 3 2026) EQUALS JUST TRUE
#ASSERT `s 209(2) the auditor is in default of the duty to send the report` FALSE TRUE (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 9 3 2026) EQUALS JUST FALSE
#ASSERT `s 209(2) the auditor is in default of the duty to send the report` TRUE FALSE (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 9 3 2026) EQUALS JUST FALSE

-- EXPECT FULFILLED
#TRACE `s 209(2) the auditor must send the report within 7 days` "Lim & Co" (Date 1 3 2026) AT 0 WITH
    PARTY Auditor "Lim & Co" DOES `s 209(2) send by post a report in writing on the matter to the borrowing corporation and a copy of it to the trustee` AT 7

-- EXPECT BREACH
#TRACE `s 209(2) the auditor must send the report within 7 days` "Lim & Co" (Date 1 3 2026) AT 0 WITH
    (WAITUNTIL 8)

-- EXPECT RESIDUAL
#TRACE `s 209(2) the auditor must send the report within 7 days` "Lim & Co" (Date 1 3 2026) AT 0 WITH
    (WAITUNTIL 7)

-- (3): a person who fails to comply with subsection (2) is guilty; fine not exceeding $1,000, and also a default penalty.
#ASSERT `s 209(3) the person is guilty of the offence` TRUE EQUALS JUST TRUE
#ASSERT `s 209(3) the person is guilty of the offence` FALSE EQUALS JUST FALSE
#ASSERT `s 209(3) the most the person may be fined on conviction` TRUE EQUALS JUST 1000
#ASSERT `s 209(3) the most the person may be fined on conviction` FALSE EQUALS NOTHING
#ASSERT `s 209(3) the person is also liable on conviction to a default penalty` TRUE EQUALS JUST TRUE
#ASSERT `s 209(3) the person is also liable on conviction to a default penalty` FALSE EQUALS NOTHING

§ `Section 209A`

-- The lead-in: the definitions apply unless a contrary intention appears.
#ASSERT `s 209A the definitions of this section apply in this Part` FALSE EQUALS JUST TRUE
#ASSERT `s 209A the definitions of this section apply in this Part` TRUE EQUALS JUST FALSE
-- "balance sheet": the balance sheet, by whatever name called, prepared in accordance with the Accounting Standards: both limbs.
#ASSERT `s 209A "balance sheet" the document is a balance sheet of the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 209A "balance sheet" the document is a balance sheet of the company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 209A "balance sheet" the document is a balance sheet of the company` FALSE TRUE EQUALS JUST FALSE
-- "consolidated financial statements" and "group": the meaning is the Accounting Standards', which are not among the sources.
#ASSERT `s 209A "consolidated financial statements" the statements are consolidated financial statements` TRUE EQUALS JUST TRUE
#ASSERT `s 209A "consolidated financial statements" the statements are consolidated financial statements` FALSE EQUALS NOTHING
#ASSERT `s 209A "group" the arrangement is a group` TRUE EQUALS JUST TRUE
#ASSERT `s 209A "group" the arrangement is a group` FALSE EQUALS NOTHING
-- "consolidated total assets": (a) where consolidated statements are prepared, the figure under the standards applicable to the group; (b) where they are not, the aggregate of the members' total assets.
#ASSERT `s 209A "consolidated total assets" the consolidated total assets of the group, in Singapore dollars` TRUE 12000000 (LIST 4000000, 5000000) EQUALS JUST 12000000
#ASSERT `s 209A "consolidated total assets" the consolidated total assets of the group, in Singapore dollars` FALSE 12000000 (LIST 4000000, 5000000, 1) EQUALS JUST 9000001
#ASSERT `s 209A "consolidated total assets" the consolidated total assets of the group, in Singapore dollars` FALSE 12000000 (LIST 7000000) EQUALS JUST 7000000
-- "directors' statement".
#ASSERT `s 209A "directors' statement" the statement is the directors' statement` TRUE EQUALS JUST TRUE
#ASSERT `s 209A "directors' statement" the statement is the directors' statement` FALSE EQUALS JUST FALSE
-- "entity".
#ASSERT `s 209A "entity" the body is an entity` TRUE EQUALS JUST TRUE
#ASSERT `s 209A "entity" the body is an entity` FALSE EQUALS JUST FALSE
-- "financial statements": the financial statements of a company, required to be prepared by the Accounting Standards.
#ASSERT `s 209A "financial statements" the statements are financial statements` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 209A "financial statements" the statements are financial statements` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 209A "financial statements" the statements are financial statements` FALSE TRUE EQUALS JUST FALSE
-- "parent company": a company that must prepare financial statements in relation to a group.
#ASSERT `s 209A "parent company" the company is a parent company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 209A "parent company" the company is a parent company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 209A "parent company" the company is a parent company` FALSE TRUE EQUALS JUST FALSE
-- "subsidiary company" and "subsidiary corporation".
#ASSERT `s 209A "subsidiary company" the company is a subsidiary company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 209A "subsidiary company" the company is a subsidiary company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 209A "subsidiary company" the company is a subsidiary company` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 209A "subsidiary corporation" the corporation is a subsidiary corporation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 209A "subsidiary corporation" the corporation is a subsidiary corporation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 209A "subsidiary corporation" the corporation is a subsidiary corporation` FALSE TRUE EQUALS JUST FALSE
-- "ultimate parent corporation": a parent but not a subsidiary.
#ASSERT `s 209A "ultimate parent corporation" the corporation is an ultimate parent corporation` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 209A "ultimate parent corporation" the corporation is an ultimate parent corporation` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 209A "ultimate parent corporation" the corporation is an ultimate parent corporation` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 209A "ultimate parent corporation" the corporation is an ultimate parent corporation` FALSE TRUE FALSE EQUALS JUST FALSE
