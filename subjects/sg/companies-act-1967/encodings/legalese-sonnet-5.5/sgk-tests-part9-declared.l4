IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgk-part9-declared`

-- Tests for ss 228 to 231. Every expected value is written from the text of the section, beside the assertion.

§ `Section 228`

-- Part 9 runs from section 228 (Application of this Part) to section 246 (Inspectors appointed in other countries): the first and last sections are in; the section before and the section after are out.
#ASSERT `s 228 the provision is in Part 9` 227 EQUALS FALSE
#ASSERT `s 228 the provision is in Part 9` 228 EQUALS TRUE
#ASSERT `s 228 the provision is in Part 9` 236 EQUALS TRUE
#ASSERT `s 228 the provision is in Part 9` 246 EQUALS TRUE
#ASSERT `s 228 the provision is in Part 9` 247 EQUALS FALSE

-- "This Part does not authorise any investigation into the insurance business of a company or into the business of a banking corporation, unless specifically provided for in this Part".
#ASSERT `s 228 Part 9 is barred from authorising the investigation` TRUE FALSE FALSE EQUALS JUST TRUE      -- insurance business, nothing in Part 9 provides for it
#ASSERT `s 228 Part 9 is barred from authorising the investigation` FALSE TRUE FALSE EQUALS JUST TRUE      -- a banking corporation, nothing in Part 9 provides for it
#ASSERT `s 228 Part 9 is barred from authorising the investigation` TRUE FALSE TRUE EQUALS JUST FALSE      -- "unless specifically provided for in this Part", met
#ASSERT `s 228 Part 9 is barred from authorising the investigation` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 228 Part 9 is barred from authorising the investigation` FALSE FALSE FALSE EQUALS NOTHING       -- any other investigation: the section says nothing
#ASSERT `s 228 Part 9 is barred from authorising the investigation` FALSE FALSE TRUE EQUALS NOTHING

§ `Section 229`

-- "In this Part, unless the contrary intention appears".
#ASSERT `s 229 the definition governs the word where it is used in Part 9` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 229 the definition governs the word where it is used in Part 9` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 229 the definition governs the word where it is used in Part 9` FALSE FALSE EQUALS NOTHING
#ASSERT `s 229 the definition governs the word where it is used in Part 9` FALSE TRUE EQUALS NOTHING

-- "company" includes a foreign company which is a declared company: an "includes" definition, so the other bodies are left open.
#ASSERT `s 229 "company" the body is within the word company` TRUE EQUALS JUST TRUE
#ASSERT `s 229 "company" the body is within the word company` FALSE EQUALS NOTHING

-- "declared company" means a company or foreign company which the Minister has by order declared: a "means" definition, so both limbs are needed.
#ASSERT `s 229 "declared company" the body is a declared company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 229 "declared company" the body is a declared company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 229 "declared company" the body is a declared company` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 229 "declared company" the body is a declared company` FALSE FALSE EQUALS JUST FALSE

-- "officer or agent" includes (a) a director, banker, solicitor or auditor; (b) a person who has been such, or otherwise employed or appointed; (c) a person with its property, indebted to it, or capable of giving information; (d) a person reasonably suspected to be within (c).
#ASSERT `s 229 "officer or agent" the person is an officer or agent of the corporation` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE      -- (a)
#ASSERT `s 229 "officer or agent" the person is an officer or agent of the corporation` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE      -- (b)(i)
#ASSERT `s 229 "officer or agent" the person is an officer or agent of the corporation` FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE      -- (b)(ii)
#ASSERT `s 229 "officer or agent" the person is an officer or agent of the corporation` FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE      -- (c)(i)
#ASSERT `s 229 "officer or agent" the person is an officer or agent of the corporation` FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE      -- (c)(ii)
#ASSERT `s 229 "officer or agent" the person is an officer or agent of the corporation` FALSE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE      -- (c)(iii)
#ASSERT `s 229 "officer or agent" the person is an officer or agent of the corporation` FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE      -- (d)
#ASSERT `s 229 "officer or agent" the person is an officer or agent of the corporation` FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING         -- "includes": a person outside the list is left open

§ `Section 230`

-- "The Minister may by order declare ... if satisfied" of a ground: (a), (b), (c); (d) only in the case of a foreign company, with the request.
#ASSERT `s 230 the Minister may by order declare the body to be a company to which Part 9 applies` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE      -- (a)
#ASSERT `s 230 the Minister may by order declare the body to be a company to which Part 9 applies` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE      -- (b)
#ASSERT `s 230 the Minister may by order declare the body to be a company to which Part 9 applies` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE      -- (c)
#ASSERT `s 230 the Minister may by order declare the body to be a company to which Part 9 applies` FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE       -- (d), a foreign company with the request
#ASSERT `s 230 the Minister may by order declare the body to be a company to which Part 9 applies` FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING        -- a foreign company, no request
#ASSERT `s 230 the Minister may by order declare the body to be a company to which Part 9 applies` FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING        -- a request, but the body is not a foreign company
#ASSERT `s 230 the Minister may by order declare the body to be a company to which Part 9 applies` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

§ `Section 231`

-- (1): "Where a company or foreign company has been declared ... the Minister must appoint one or more inspectors".
#ASSERT `s 231(1) the Minister must appoint one or more inspectors to investigate the affairs of the company` TRUE EQUALS JUST TRUE
#ASSERT `s 231(1) the Minister must appoint one or more inspectors to investigate the affairs of the company` FALSE EQUALS JUST FALSE
-- EXPECT RESIDUAL
#TRACE `s 231(1) the Minister must appoint inspectors for a declared company` 7 AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 231(1) the Minister must appoint inspectors for a declared company` 7 AT 0 WITH
    PARTY `s 231 the Minister` DOES `s 231(1) appoint one or more inspectors to investigate the affairs of the declared company` AT 5

-- (2): an inspector "inform the Minister of matters coming to the inspector's knowledge as a result of the investigation which tend to show that an offence has been committed", and "the Minister may thereafter take such steps as the Minister may consider fit".
#ASSERT `s 231(2) the inspector may inform the Minister of the matters without making an interim report` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 231(2) the inspector may inform the Minister of the matters without making an interim report` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 231(2) the inspector may inform the Minister of the matters without making an interim report` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 231(2) the inspector may inform the Minister of the matters without making an interim report` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 231(2) the Minister may take such steps as the Minister considers fit` TRUE EQUALS JUST TRUE
#ASSERT `s 231(2) the Minister may take such steps as the Minister considers fit` FALSE EQUALS JUST FALSE

-- (3): "The expenses of and incidental to an investigation of a declared company must be defrayed in the first instance out of moneys provided by Parliament".
#ASSERT `s 231(3) the expenses are defrayed in the first instance out of moneys provided by Parliament` TRUE EQUALS JUST TRUE
#ASSERT `s 231(3) the expenses are defrayed in the first instance out of moneys provided by Parliament` FALSE EQUALS NOTHING

-- (4): "Where the Minister is of the opinion that the whole or any part of the expenses of and incidental to the investigation should be paid by the company or by any person who is convicted on a prosecution brought under section 233(3) or who is ordered to pay damages or restore property in proceedings under section 233(4)": opinion and one of three payers.
#ASSERT `s 231(4) the Minister may by notification in the Gazette direct that the expenses be paid by the payer` TRUE TRUE FALSE FALSE EQUALS JUST TRUE      -- the company
#ASSERT `s 231(4) the Minister may by notification in the Gazette direct that the expenses be paid by the payer` TRUE FALSE TRUE FALSE EQUALS JUST TRUE      -- a person convicted under section 233(3)
#ASSERT `s 231(4) the Minister may by notification in the Gazette direct that the expenses be paid by the payer` TRUE FALSE FALSE TRUE EQUALS JUST TRUE      -- a person ordered to pay under section 233(4)
#ASSERT `s 231(4) the Minister may by notification in the Gazette direct that the expenses be paid by the payer` TRUE FALSE FALSE FALSE EQUALS JUST FALSE     -- none of the three payers
#ASSERT `s 231(4) the Minister may by notification in the Gazette direct that the expenses be paid by the payer` FALSE TRUE FALSE FALSE EQUALS JUST FALSE     -- no opinion

-- (5), (6), (7), (8), (9).
#ASSERT `s 231(5) the notification may specify the time or times and the manner in which the payment of the expenses must be made` TRUE EQUALS JUST TRUE
#ASSERT `s 231(5) the notification may specify the time or times and the manner in which the payment of the expenses must be made` FALSE EQUALS NOTHING
#ASSERT `s 231(6) the person named in the notification is liable to reimburse the Minister in respect of the expenses to the extent specified` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 231(6) the person named in the notification is liable to reimburse the Minister in respect of the expenses to the extent specified` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 231(6) the person named in the notification is liable to reimburse the Minister in respect of the expenses to the extent specified` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 231(7) action to recover the expenses may be taken in the name of the Government in any court of competent jurisdiction` TRUE EQUALS JUST TRUE
#ASSERT `s 231(7) action to recover the expenses may be taken in the name of the Government in any court of competent jurisdiction` FALSE EQUALS NOTHING
#ASSERT `s 231(8) the expenses ordered to be paid by the company are part of the costs and expenses of the winding up for the purposes of section 203(1)(a) of the Insolvency, Restructuring and Dissolution Act 2018` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 231(8) the expenses ordered to be paid by the company are part of the costs and expenses of the winding up for the purposes of section 203(1)(a) of the Insolvency, Restructuring and Dissolution Act 2018` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 231(8) the expenses ordered to be paid by the company are part of the costs and expenses of the winding up for the purposes of section 203(1)(a) of the Insolvency, Restructuring and Dissolution Act 2018` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 231(9) the report must include a recommendation as to the terms of the notification` TRUE EQUALS JUST TRUE
#ASSERT `s 231(9) the report must include a recommendation as to the terms of the notification` FALSE EQUALS JUST FALSE
#ASSERT `s 231(9) the report may include a recommendation as to the terms of the notification` TRUE FALSE EQUALS JUST TRUE       -- "if the inspector thinks fit"
#ASSERT `s 231(9) the report may include a recommendation as to the terms of the notification` FALSE TRUE EQUALS JUST TRUE       -- "must, if the Minister so directs"
#ASSERT `s 231(9) the report may include a recommendation as to the terms of the notification` FALSE FALSE EQUALS NOTHING
