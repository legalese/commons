IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgc1-s201-departures`

-- Tests for sgc1-s201-departures.l4 (s 201(12) to (15A)). Expected values are written from the text, beside each assertion.

§ `s 201(12): the Registrar's approval`

-- "need not comply ... if the company has obtained the approval of the Registrar"
#ASSERT `s 201(12) the financial statements need not comply with the requirements of the Accounting Standards` TRUE EQUALS JUST TRUE
#ASSERT `s 201(12) the financial statements need not comply with the requirements of the Accounting Standards` FALSE EQUALS JUST FALSE

§ `s 201(13): the true and fair view override`

#ASSERT `s 201(13) the financial statements need not comply with the requirement of the Accounting Standards` TRUE TRUE EQUALS JUST TRUE
-- the requirement would not defeat a true and fair view: the "where" is not met
#ASSERT `s 201(13) the financial statements need not comply with the requirement of the Accounting Standards` FALSE TRUE EQUALS JUST FALSE
-- "to the extent that this is necessary": a departure that is not necessary is not allowed
#ASSERT `s 201(13) the financial statements need not comply with the requirement of the Accounting Standards` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 201(13) the financial statements need not comply with the requirement of the Accounting Standards` FALSE FALSE EQUALS JUST FALSE

§ `s 201(14): what a departure must carry`

-- all three items: (a) the auditor's statement, (b) particulars, reason and effect, (c) further information
#ASSERT `s 201(14) the financial statements include what the subsection requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 201(14) the financial statements include what the subsection requires` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 201(14) the financial statements include what the subsection requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 201(14) the financial statements include what the subsection requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
-- no non-compliance of the kind subsection (13) mentions: the subsection has no verdict
#ASSERT `s 201(14) the financial statements include what the subsection requires` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- whether the duty arises
#ASSERT `s 201(14) the financial statements must include the statement, particulars and information the subsection lists` TRUE EQUALS JUST TRUE
#ASSERT `s 201(14) the financial statements must include the statement, particulars and information the subsection lists` FALSE EQUALS JUST FALSE

§ `s 201(15): the Minister's substitution of accounting standards`

#ASSERT `s 201(15) the substituted standards apply to the company in place of the Accounting Standards` TRUE EQUALS JUST TRUE
#ASSERT `s 201(15) the substituted standards apply to the company in place of the Accounting Standards` FALSE EQUALS JUST FALSE

§ `s 201(15A): the Minister's exemption of directors`

#ASSERT `s 201(15A) the directors are exempt from having to ensure that the financial statements comply with the requirement` TRUE EQUALS JUST TRUE
#ASSERT `s 201(15A) the directors are exempt from having to ensure that the financial statements comply with the requirement` FALSE EQUALS JUST FALSE

§ `Together`

-- approval only
#ASSERT `s 201(12), (13) and (15A) a departure from the Accounting Standards is allowed` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- the true and fair view override only
#ASSERT `s 201(12), (13) and (15A) a departure from the Accounting Standards is allowed` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
-- an order only
#ASSERT `s 201(12), (13) and (15A) a departure from the Accounting Standards is allowed` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
-- none
#ASSERT `s 201(12), (13) and (15A) a departure from the Accounting Standards is allowed` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- the override is claimed but a departure is not necessary
#ASSERT `s 201(12), (13) and (15A) a departure from the Accounting Standards is allowed` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
