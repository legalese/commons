IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgj-div7-title`

-- Tests for ss 121 to 125. Every expected value is written from the text of the section, not from the output of the code.

§ `Section 121`

#ASSERT `s 121 the share or other interest of a member is movable property` TRUE EQUALS JUST TRUE
#ASSERT `s 121 the share or other interest of a member is movable property` FALSE EQUALS NOTHING
-- "is not of the nature of immovable property"
#ASSERT `s 121 the share or other interest of a member is of the nature of immovable property` TRUE EQUALS JUST FALSE
#ASSERT `s 121 the share or other interest of a member is of the nature of immovable property` FALSE EQUALS NOTHING
#ASSERT `s 121 the share or other interest of a member is transferable in the manner provided by the constitution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 121 the share or other interest of a member is transferable in the manner provided by the constitution` TRUE FALSE EQUALS NOTHING
#ASSERT `s 121 the share or other interest of a member is transferable in the manner provided by the constitution` FALSE TRUE EQUALS NOTHING

§ `Section 122`

#ASSERT `s 122(2)(a) the shares need no distinguishing number` TRUE TRUE EQUALS JUST TRUE
-- fully paid and equal now, but a share no longer remains so ("so long as each ... remains")
#ASSERT `s 122(2)(a) the shares need no distinguishing number` TRUE FALSE EQUALS NOTHING
#ASSERT `s 122(2)(a) the shares need no distinguishing number` FALSE TRUE EQUALS NOTHING
#ASSERT `s 122(2)(b) the shares need no distinguishing number` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 122(2)(b) the shares need no distinguishing number` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 122(2)(b) the shares need no distinguishing number` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 122(2)(b) the shares need no distinguishing number` FALSE TRUE TRUE EQUALS NOTHING
-- (1): each share must be numbered, except where (2)(a) or (2)(b) applies
#ASSERT `s 122(1) the share must be distinguished by an appropriate number` NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 122(1) the share must be distinguished by an appropriate number` (JUST TRUE) NOTHING EQUALS JUST FALSE
#ASSERT `s 122(1) the share must be distinguished by an appropriate number` NOTHING (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 122(1) the share must be distinguished by an appropriate number` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE

§ `Section 123`

#ASSERT `s 123(1) the certificate is prima facie evidence of the title of the member to the shares` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 123(1) the certificate is prima facie evidence of the title of the member to the shares` TRUE FALSE EQUALS NOTHING
#ASSERT `s 123(1) the certificate is prima facie evidence of the title of the member to the shares` FALSE TRUE EQUALS NOTHING
-- (2): arguments: branch register; common seal; official seal; name and authority; address; class, paid-up status and amount unpaid
#ASSERT `s 123(2) the share certificate is as the subsection requires` FALSE TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- a certificate relating to a branch register is under the official seal
#ASSERT `s 123(2) the share certificate is as the subsection requires` TRUE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 123(2) the share certificate is as the subsection requires` TRUE TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 123(2) the share certificate is as the subsection requires` FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 123(2) the share certificate is as the subsection requires` FALSE TRUE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 123(2) the share certificate is as the subsection requires` FALSE TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 123(2) the share certificate is as the subsection requires` FALSE TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- a duty with no time limit and no consequence the text states for the act: the passing of time never breaches it
-- EXPECT RESIDUAL
#TRACE `s 123(2) the company must issue share certificates as the subsection requires` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- EXPECT FULFILLED
#TRACE `s 123(2) the company must issue share certificates as the subsection requires` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 123(2) issue the share certificate under the seal and stating what the subsection requires` AT 10

#ASSERT `s 123(3) the failure affects the rights of a holder of shares` TRUE EQUALS JUST FALSE
#ASSERT `s 123(3) the failure affects the rights of a holder of shares` FALSE EQUALS NOTHING
#ASSERT `s 123(4) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 123(4) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 123(4) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 123(4) the person is guilty of the offence this subsection creates` FALSE TRUE TRUE EQUALS JUST FALSE
-- no penalty is stated
#ASSERT `s 123(4) the most the person may be sentenced to on conviction` TRUE EQUALS NOTHING

§ `Section 124`

#ASSERT `s 124 the company may have a duplicate common seal` TRUE EQUALS JUST TRUE
#ASSERT `s 124 the company may have a duplicate common seal` FALSE EQUALS NOTHING
#ASSERT `s 124 the duplicate common seal is as the section requires` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 124 the duplicate common seal is as the section requires` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 124 the duplicate common seal is as the section requires` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 124 the certificate is deemed to be sealed with the common seal for the purposes of this Act` TRUE EQUALS JUST TRUE
#ASSERT `s 124 the certificate is deemed to be sealed with the common seal for the purposes of this Act` FALSE EQUALS NOTHING

§ `Section 125`

-- (1): arguments: lost or destroyed; the owner applied; statutory declaration; undertaking; the fee; the directors required more under (2) and it was not done
#ASSERT `s 125(1) the company must issue a duplicate certificate or document to the owner` TRUE TRUE TRUE TRUE 2 FALSE EQUALS JUST TRUE
#ASSERT `s 125(1) the company must issue a duplicate certificate or document to the owner` TRUE TRUE TRUE TRUE 0 FALSE EQUALS JUST TRUE
-- a fee above $2 is not one the subsection allows the company to require
#ASSERT `s 125(1) the company must issue a duplicate certificate or document to the owner` TRUE TRUE TRUE TRUE 2.5 FALSE EQUALS NOTHING
#ASSERT `s 125(1) the company must issue a duplicate certificate or document to the owner` FALSE TRUE TRUE TRUE 2 FALSE EQUALS NOTHING
#ASSERT `s 125(1) the company must issue a duplicate certificate or document to the owner` TRUE FALSE TRUE TRUE 2 FALSE EQUALS NOTHING
#ASSERT `s 125(1) the company must issue a duplicate certificate or document to the owner` TRUE TRUE FALSE TRUE 2 FALSE EQUALS NOTHING
#ASSERT `s 125(1) the company must issue a duplicate certificate or document to the owner` TRUE TRUE TRUE FALSE 2 FALSE EQUALS NOTHING
#ASSERT `s 125(1) the company must issue a duplicate certificate or document to the owner` TRUE TRUE TRUE TRUE 2 TRUE EQUALS NOTHING
#ASSERT `s 125(1) the most the company may require as a fee for the duplicate, in dollars` EQUALS 2
-- the duty has no time limit: it is never breached by the passing of time
-- EXPECT RESIDUAL
#TRACE `s 125(1) the company must issue a duplicate certificate or document` "Acme Pte Ltd" 7 AT 0 WITH
    (WAITUNTIL 100)

-- EXPECT FULFILLED
#TRACE `s 125(1) the company must issue a duplicate certificate or document` "Acme Pte Ltd" 7 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 125(1) issue a duplicate certificate or document in lieu of the one lost or destroyed` AT 3

-- (2): greater than $500; (5) takes listed securities deposited with the Depository out of it
#ASSERT `s 125(2) the directors may require the applicant to advertise or to furnish a bond, or both` 500.01 NOTHING EQUALS JUST TRUE
#ASSERT `s 125(2) the directors may require the applicant to advertise or to furnish a bond, or both` 501 NOTHING EQUALS JUST TRUE
#ASSERT `s 125(2) the directors may require the applicant to advertise or to furnish a bond, or both` 500 NOTHING EQUALS JUST FALSE
#ASSERT `s 125(2) the directors may require the applicant to advertise or to furnish a bond, or both` 499 NOTHING EQUALS JUST FALSE
#ASSERT `s 125(2) the directors may require the applicant to advertise or to furnish a bond, or both` 10000 (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 125(5) subsection (2) applies to the document` TRUE EQUALS JUST FALSE
#ASSERT `s 125(5) subsection (2) applies to the document` FALSE EQUALS NOTHING
-- (2)(a): after the expiration of 14 days after the publication. Published 1 January 2026: the 14 days are 2 to 15 January and expire at the end of 15 January,
-- so 16 January is the first day "after the expiration". (The first draft of this test put 15 January here: a hand-counting error, found by the run and re-derived from the text, not copied from the output.)
#ASSERT `s 125(2)(a) the owner applies after the expiration of 14 days after the publication of the advertisement` (Date 1 1 2026) (Date 15 1 2026) EQUALS JUST FALSE
#ASSERT `s 125(2)(a) the owner applies after the expiration of 14 days after the publication of the advertisement` (Date 1 1 2026) (Date 16 1 2026) EQUALS JUST TRUE
#ASSERT `s 125(2)(a) the owner applies after the expiration of 14 days after the publication of the advertisement` (Date 1 1 2026) (Date 14 1 2026) EQUALS JUST FALSE
#ASSERT `s 125(2)(a) the owner applies after the expiration of 14 days after the publication of the advertisement` (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST FALSE
-- (2)(b): a bond of at least the current market value
#ASSERT `s 125(2)(b) the bond is for an amount the paragraph allows the directors to require` 1000 1000 EQUALS JUST TRUE
#ASSERT `s 125(2)(b) the bond is for an amount the paragraph allows the directors to require` 1500 1000 EQUALS JUST TRUE
#ASSERT `s 125(2)(b) the bond is for an amount the paragraph allows the directors to require` 999 1000 EQUALS JUST FALSE
-- (3): a duplicate issued on or after 30 January 2006 of a certificate issued before it
#ASSERT `s 125(3) the duplicate must state the amount paid and the amount unpaid in place of the historical nominal value of the shares` (Date 30 1 2006) (Date 29 1 2006) EQUALS JUST TRUE
#ASSERT `s 125(3) the duplicate must state the amount paid and the amount unpaid in place of the historical nominal value of the shares` (Date 1 6 2020) (Date 1 1 1990) EQUALS JUST TRUE
#ASSERT `s 125(3) the duplicate must state the amount paid and the amount unpaid in place of the historical nominal value of the shares` (Date 29 1 2006) (Date 1 1 1990) EQUALS NOTHING
#ASSERT `s 125(3) the duplicate must state the amount paid and the amount unpaid in place of the historical nominal value of the shares` (Date 1 6 2020) (Date 30 1 2006) EQUALS NOTHING
#ASSERT `s 125(4) the owner is the Depository` TRUE EQUALS JUST TRUE
#ASSERT `s 125(4) the owner is the Depository` FALSE EQUALS NOTHING
