IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgm-part5-div5`

-- Tests of sgm-part5-div5.l4 (ss 197 and 198). Every expected value is written from the text, beside the assertion.
-- Dates are Date day month year. The trace clock counts days after the day of the event (AT 0).

§ `Fixtures`

`the penalty of a fine of $10,000 and a default penalty` MEANS `Penalty` OF 10000, 0, FALSE, TRUE

§ `s 197(1) and (1A): when the return must be lodged`

-- The months: 5 and 7 for subsection (1), 6 and 8 for subsection (1A).
#ASSERT `s 197(1)(a) the months after the end of the financial year within which a listed company must lodge its return` EQUALS 5
#ASSERT `s 197(1)(b) the months after the end of the financial year within which any other company must lodge its return` EQUALS 7
#ASSERT `s 197(1A)(a) the months after the end of the financial year within which a listed company must lodge its return` EQUALS 6
#ASSERT `s 197(1A)(b) the months after the end of the financial year within which any other company must lodge its return` EQUALS 8
-- (1A): a company having a share capital and keeping a branch register in a place outside Singapore
#ASSERT `s 197(1A) the company is one mentioned in subsection (1A)` TRUE TRUE
#ASSERT NOT (`s 197(1A) the company is one mentioned in subsection (1A)` TRUE FALSE)
#ASSERT NOT (`s 197(1A) the company is one mentioned in subsection (1A)` FALSE TRUE)
#ASSERT NOT (`s 197(1A) the company is one mentioned in subsection (1A)` FALSE FALSE)
-- the months for a company: listed or not, (1A) or not (listed, share capital, branch register outside Singapore)
#ASSERT `s 197(1) the number of months after the end of the financial year within which the company must lodge its return` TRUE FALSE FALSE EQUALS 5
#ASSERT `s 197(1) the number of months after the end of the financial year within which the company must lodge its return` FALSE FALSE FALSE EQUALS 7
#ASSERT `s 197(1) the number of months after the end of the financial year within which the company must lodge its return` TRUE TRUE TRUE EQUALS 6
#ASSERT `s 197(1) the number of months after the end of the financial year within which the company must lodge its return` FALSE TRUE TRUE EQUALS 8
#ASSERT `s 197(1) the number of months after the end of the financial year within which the company must lodge its return` TRUE TRUE FALSE EQUALS 5
#ASSERT `s 197(1) the number of months after the end of the financial year within which the company must lodge its return` FALSE FALSE TRUE EQUALS 7
-- the last day, for a financial year ending on 31 December 2025 (listed, share capital, branch register outside Singapore, end of the year, days added by the Registrar)
#ASSERT `s 197(1) the last day for lodging the return` TRUE FALSE FALSE (Date 31 12 2025) 0 EQUALS Date 31 5 2026
#ASSERT `s 197(1) the last day for lodging the return` FALSE FALSE FALSE (Date 31 12 2025) 0 EQUALS Date 31 7 2026
#ASSERT `s 197(1) the last day for lodging the return` TRUE TRUE TRUE (Date 31 12 2025) 0 EQUALS Date 30 6 2026
#ASSERT `s 197(1) the last day for lodging the return` FALSE TRUE TRUE (Date 31 12 2025) 0 EQUALS Date 31 8 2026
#ASSERT `s 197(1) the last day for lodging the return` TRUE TRUE FALSE (Date 31 12 2025) 0 EQUALS Date 31 5 2026
-- the Registrar adds 30 days under subsection (1B)
#ASSERT `s 197(1) the last day for lodging the return` TRUE FALSE FALSE (Date 31 12 2025) 30 EQUALS Date 30 6 2026
-- a financial year ending on 31 August: 31 August plus 6 months is 28 February (P4); plus 5, 7 and 8 months are 31 January, 31 March and 30 April
#ASSERT `s 197(1) the last day for lodging the return` TRUE FALSE FALSE (Date 31 8 2025) 0 EQUALS Date 31 1 2026
#ASSERT `s 197(1) the last day for lodging the return` TRUE TRUE TRUE (Date 31 8 2025) 0 EQUALS Date 28 2 2026
#ASSERT `s 197(1) the last day for lodging the return` FALSE FALSE FALSE (Date 31 8 2025) 0 EQUALS Date 31 3 2026
#ASSERT `s 197(1) the last day for lodging the return` FALSE TRUE TRUE (Date 31 8 2025) 0 EQUALS Date 30 4 2026
-- 31 August 2027 plus 6 months is 29 February 2028, a leap year
#ASSERT `s 197(1) the last day for lodging the return` TRUE TRUE TRUE (Date 31 8 2027) 0 EQUALS Date 29 2 2028
-- lodged after the meeting (15 April 2026) and by the last day (31 May 2026 for a listed company, financial year ending 31 December 2025)
#ASSERT `s 197(1) the return was lodged after the annual general meeting and within the time the subsection allows` TRUE FALSE FALSE (Date 31 12 2025) 0 (Date 15 4 2026) (Date 15 4 2026) EQUALS JUST TRUE
#ASSERT `s 197(1) the return was lodged after the annual general meeting and within the time the subsection allows` TRUE FALSE FALSE (Date 31 12 2025) 0 (Date 15 4 2026) (Date 14 4 2026) EQUALS JUST FALSE
#ASSERT `s 197(1) the return was lodged after the annual general meeting and within the time the subsection allows` TRUE FALSE FALSE (Date 31 12 2025) 0 (Date 15 4 2026) (Date 31 5 2026) EQUALS JUST TRUE
#ASSERT `s 197(1) the return was lodged after the annual general meeting and within the time the subsection allows` TRUE FALSE FALSE (Date 31 12 2025) 0 (Date 15 4 2026) (Date 1 6 2026) EQUALS JUST FALSE
-- any other company: 31 July 2026
#ASSERT `s 197(1) the return was lodged after the annual general meeting and within the time the subsection allows` FALSE FALSE FALSE (Date 31 12 2025) 0 (Date 15 4 2026) (Date 31 7 2026) EQUALS JUST TRUE
#ASSERT `s 197(1) the return was lodged after the annual general meeting and within the time the subsection allows` FALSE FALSE FALSE (Date 31 12 2025) 0 (Date 15 4 2026) (Date 1 8 2026) EQUALS JUST FALSE
-- extended by 30 days: 30 June 2026
#ASSERT `s 197(1) the return was lodged after the annual general meeting and within the time the subsection allows` TRUE FALSE FALSE (Date 31 12 2025) 30 (Date 15 4 2026) (Date 30 6 2026) EQUALS JUST TRUE
#ASSERT `s 197(1) the return was lodged after the annual general meeting and within the time the subsection allows` TRUE FALSE FALSE (Date 31 12 2025) 30 (Date 15 4 2026) (Date 1 7 2026) EQUALS JUST FALSE
-- the trace: the clock counts days after the last day of the financial year (31 December 2025). A listed company: the last day is 31 May 2026, day 151.
-- EXPECT FULFILLED
#TRACE `s 197(1) a company must lodge a return with the Registrar within the time the subsection gives` "Acme Pte Ltd" TRUE FALSE FALSE (Date 31 12 2025) 0 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 197(1) lodge a return with the Registrar after the annual general meeting` AT 151
-- EXPECT BREACH
#TRACE `s 197(1) a company must lodge a return with the Registrar within the time the subsection gives` "Acme Pte Ltd" TRUE FALSE FALSE (Date 31 12 2025) 0 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 197(1) lodge a return with the Registrar after the annual general meeting` AT 152
-- EXPECT BREACH
#TRACE `s 197(1) a company must lodge a return with the Registrar within the time the subsection gives` "Acme Pte Ltd" TRUE FALSE FALSE (Date 31 12 2025) 0 AT 0 WITH
    WAITUNTIL 152
-- EXPECT RESIDUAL
#TRACE `s 197(1) a company must lodge a return with the Registrar within the time the subsection gives` "Acme Pte Ltd" TRUE FALSE FALSE (Date 31 12 2025) 0 AT 0 WITH
-- any other company: 31 July 2026, day 212
-- EXPECT FULFILLED
#TRACE `s 197(1) a company must lodge a return with the Registrar within the time the subsection gives` "Acme Pte Ltd" FALSE FALSE FALSE (Date 31 12 2025) 0 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 197(1) lodge a return with the Registrar after the annual general meeting` AT 212
-- EXPECT BREACH
#TRACE `s 197(1) a company must lodge a return with the Registrar within the time the subsection gives` "Acme Pte Ltd" FALSE FALSE FALSE (Date 31 12 2025) 0 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 197(1) lodge a return with the Registrar after the annual general meeting` AT 213
-- a listed company whose time the Registrar extended by 30 days: 30 June 2026, day 181
-- EXPECT FULFILLED
#TRACE `s 197(1) a company must lodge a return with the Registrar within the time the subsection gives` "Acme Pte Ltd" TRUE FALSE FALSE (Date 31 12 2025) 30 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 197(1) lodge a return with the Registrar after the annual general meeting` AT 181
-- EXPECT BREACH
#TRACE `s 197(1) a company must lodge a return with the Registrar within the time the subsection gives` "Acme Pte Ltd" TRUE FALSE FALSE (Date 31 12 2025) 30 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 197(1) lodge a return with the Registrar after the annual general meeting` AT 182

§ `s 197(1B): the Registrar may extend the time`

-- (the Registrar thinks there are special reasons, the company has applied, the company is in a prescribed class)
#ASSERT `s 197(1B) the Registrar may extend the period within which the company must lodge its return` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 197(1B) the Registrar may extend the period within which the company must lodge its return` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 197(1B) the Registrar may extend the period within which the company must lodge its return` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 197(1B) the Registrar may extend the period within which the company must lodge its return` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 197(1B) the Registrar may extend the period within which the company must lodge its return` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 197(1B) the Registrar may extend the period within which the company must lodge its return` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 197(1B) the Registrar may extend the period within which the company must lodge its return` FALSE TRUE TRUE EQUALS NOTHING

§ `s 197(2): what the return must be`

#ASSERT `s 197(2) the return is in the form, has the contents and is accompanied by the documents that the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 197(2) the return is in the form, has the contents and is accompanied by the documents that the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 197(2) the return is in the form, has the contents and is accompanied by the documents that the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 197(2) the return is in the form, has the contents and is accompanied by the documents that the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE

§ `s 197(4): notice of the date of the annual general meeting held after the return`

#ASSERT `s 197(4) the private company must lodge a notice of the date on which the annual general meeting was held` TRUE EQUALS JUST TRUE
#ASSERT `s 197(4) the private company must lodge a notice of the date on which the annual general meeting was held` FALSE EQUALS JUST FALSE
#ASSERT `s 197(4) the last day for lodging the notice` (Date 1 3 2026) EQUALS Date 15 3 2026
#ASSERT `s 197(4) the last day for lodging the notice` (Date 18 2 2028) EQUALS Date 3 3 2028
#ASSERT `s 197(4) the notice was lodged within 14 days` (Date 1 3 2026) (Date 15 3 2026)
#ASSERT NOT (`s 197(4) the notice was lodged within 14 days` (Date 1 3 2026) (Date 16 3 2026))
#ASSERT `s 197(4) the notice was lodged within 14 days` (Date 1 3 2026) (Date 1 3 2026)
-- EXPECT FULFILLED
#TRACE `s 197(4) a private company must lodge a notice of the date of the annual general meeting within 14 days` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 197(4) lodge with the Registrar a notice of the date on which the annual general meeting was held` AT 14
-- EXPECT BREACH
#TRACE `s 197(4) a private company must lodge a notice of the date of the annual general meeting within 14 days` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 197(4) lodge with the Registrar a notice of the date on which the annual general meeting was held` AT 15
-- EXPECT RESIDUAL
#TRACE `s 197(4) a private company must lodge a notice of the date of the annual general meeting within 14 days` "Acme Pte Ltd" AT 0 WITH

§ `s 197(6): the offence`

#ASSERT `s 197(6) the company is guilty of an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 197(6) the company is guilty of an offence` FALSE EQUALS JUST FALSE
#ASSERT `s 197(6) the officer of the company is guilty of an offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 197(6) the officer of the company is guilty of an offence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 197(6) the officer of the company is guilty of an offence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 197(6) the officer of the company is guilty of an offence` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 197(6) the most the company or an officer in default may be sentenced to on conviction` TRUE EQUALS JUST `the penalty of a fine of $10,000 and a default penalty`
#ASSERT `s 197(6) the most the company or an officer in default may be sentenced to on conviction` FALSE EQUALS NOTHING

§ `s 197: the seam the keel asks (s 4(1) "annual return")`

-- (the company has a share capital, keeps a branch register outside Singapore, the return is lodged after the annual general meeting)
#ASSERT `s 197(1) the return is the return required to be lodged under section 197(1)` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 197(1) the return is the return required to be lodged under section 197(1)` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 197(1) the return is the return required to be lodged under section 197(1)` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 197(1) the return is the return required to be lodged under section 197(1)` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 197(1) the return is the return required to be lodged under section 197(1)` TRUE TRUE FALSE EQUALS JUST FALSE

§ `s 198: which financial year; incorporation before or on and after 31 August 2018`

#ASSERT `s 198(1) the company is incorporated on or after 31 August 2018` (Date 31 8 2018) EQUALS JUST TRUE
#ASSERT `s 198(1) the company is incorporated on or after 31 August 2018` (Date 30 8 2018) EQUALS JUST FALSE
#ASSERT `s 198(3) the company was incorporated before 31 August 2018` (Date 30 8 2018) EQUALS JUST TRUE
#ASSERT `s 198(3) the company was incorporated before 31 August 2018` (Date 31 8 2018) EQUALS JUST FALSE

§ `s 198(1)(a): the first financial year of a company incorporated on or after 31 August 2018`

-- the last day: as furnished under section 19(1)(b), or the new last day a notice under subsection (4) specified
#ASSERT `s 198(1)(a) the last day of the company's first financial year` (Date 31 12 2019) FALSE (Date 30 6 2020) EQUALS Date 31 12 2019
#ASSERT `s 198(1)(a) the last day of the company's first financial year` (Date 31 12 2019) TRUE (Date 30 6 2020) EQUALS Date 30 6 2020
-- the period (incorporation, first day, last day, last day as furnished, notice, new last day)
#ASSERT `s 198(1)(a) the period is the first financial year of the company` (Date 1 3 2019) (Date 1 3 2019) (Date 31 12 2019) (Date 31 12 2019) FALSE (Date 30 6 2020) EQUALS JUST TRUE
#ASSERT `s 198(1)(a) the period is the first financial year of the company` (Date 1 3 2019) (Date 2 3 2019) (Date 31 12 2019) (Date 31 12 2019) FALSE (Date 30 6 2020) EQUALS JUST FALSE
#ASSERT `s 198(1)(a) the period is the first financial year of the company` (Date 1 3 2019) (Date 1 3 2019) (Date 30 12 2019) (Date 31 12 2019) FALSE (Date 30 6 2020) EQUALS JUST FALSE
#ASSERT `s 198(1)(a) the period is the first financial year of the company` (Date 1 3 2019) (Date 1 3 2019) (Date 30 6 2020) (Date 31 12 2019) TRUE (Date 30 6 2020) EQUALS JUST TRUE
#ASSERT `s 198(1)(a) the period is the first financial year of the company` (Date 1 3 2019) (Date 1 3 2019) (Date 31 12 2019) (Date 31 12 2019) TRUE (Date 30 6 2020) EQUALS JUST FALSE

§ `s 198(1)(b): the subsequent financial years`

-- the last day of a period of 12 months beginning with the first day (P10)
#ASSERT `s 198(1)(b) the last day of a subsequent financial year` (Date 1 1 2020) 12 EQUALS Date 31 12 2020
#ASSERT `s 198(1)(b) the last day of a subsequent financial year` (Date 1 3 2019) 12 EQUALS Date 29 2 2020
#ASSERT `s 198(1)(b) the last day of a subsequent financial year` (Date 1 3 2027) 12 EQUALS Date 29 2 2028
#ASSERT `s 198(1)(b) the last day of a subsequent financial year` (Date 1 3 2028) 12 EQUALS Date 28 2 2029
#ASSERT `s 198(1)(b) the last day of a subsequent financial year` (Date 1 7 2020) 6 EQUALS Date 31 12 2020
-- a year starting on 29 February: the clamped date of P10 (the keel's convention) is the last day
#ASSERT `s 198(1)(b) the last day of a subsequent financial year` (Date 29 2 2020) 12 EQUALS Date 28 2 2021
-- the period (the last day of the previous financial year, first day, last day, months in the regular interval)
#ASSERT `s 198(1)(b) the period is a subsequent financial year of the company` (Date 31 12 2019) (Date 1 1 2020) (Date 31 12 2020) 12 EQUALS JUST TRUE
#ASSERT `s 198(1)(b) the period is a subsequent financial year of the company` (Date 31 12 2019) (Date 2 1 2020) (Date 31 12 2020) 12 EQUALS JUST FALSE
#ASSERT `s 198(1)(b) the period is a subsequent financial year of the company` (Date 31 12 2019) (Date 1 1 2020) (Date 30 12 2020) 12 EQUALS JUST FALSE
#ASSERT `s 198(1)(b) the period is a subsequent financial year of the company` (Date 31 12 2019) (Date 1 1 2020) (Date 30 6 2020) 6 EQUALS JUST TRUE
#ASSERT `s 198(1)(b) the period is a subsequent financial year of the company` (Date 31 12 2019) (Date 1 1 2020) (Date 30 6 2020) 12 EQUALS JUST FALSE

§ `s 198(2): the first financial year must not be longer than 18 months`

-- beginning 1 January 2019, 18 months end on 30 June 2020
#ASSERT NOT (`s 198(2) the period is longer than 18 months` (Date 1 1 2019) (Date 30 6 2020))
#ASSERT `s 198(2) the period is longer than 18 months` (Date 1 1 2019) (Date 1 7 2020)
#ASSERT `s 198(2) the first financial year is no longer than the subsection allows` (Date 1 1 2019) (Date 30 6 2020) FALSE EQUALS JUST TRUE
#ASSERT `s 198(2) the first financial year is no longer than the subsection allows` (Date 1 1 2019) (Date 1 7 2020) FALSE EQUALS JUST FALSE
#ASSERT `s 198(2) the first financial year is no longer than the subsection allows` (Date 1 1 2019) (Date 1 7 2020) TRUE EQUALS JUST TRUE
#ASSERT `s 198(2) the first financial year is no longer than the subsection allows` (Date 1 1 2019) (Date 30 6 2020) TRUE EQUALS JUST TRUE

§ `s 198(3)(a): a company incorporated before 31 August 2018`

-- the first anniversary on or after 31 August 2018, stepping from the original day
#ASSERT `s 198(3)(a) the first anniversary on or after 31 August 2018` (Date 15 3 2016) 0 EQUALS Date 15 3 2019
#ASSERT `s 198(3)(a) the first anniversary on or after 31 August 2018` (Date 31 8 2017) 0 EQUALS Date 31 8 2018
#ASSERT `s 198(3)(a) the first anniversary on or after 31 August 2018` (Date 1 9 2017) 0 EQUALS Date 1 9 2018
#ASSERT `s 198(3)(a) the first anniversary on or after 31 August 2018` (Date 30 8 2017) 0 EQUALS Date 30 8 2019
-- (7)(a) and (b): a 29 February is taken as 28 February in a year that is not a leap year
#ASSERT `s 198(3)(a) the first anniversary on or after 31 August 2018` (Date 29 2 2016) 0 EQUALS Date 28 2 2019
-- (i): the anniversary of the last day indicated in the last return or notification
#ASSERT `s 198(3)(a)(i) the last day of the first financial year ending on or after 31 August 2018, where a return or notification had been lodged` (Date 31 12 2017) EQUALS Date 31 12 2018
#ASSERT `s 198(3)(a)(i) the last day of the first financial year ending on or after 31 August 2018, where a return or notification had been lodged` (Date 30 6 2017) EQUALS Date 30 6 2019
-- (ii): the anniversary of the date of incorporation
#ASSERT `s 198(3)(a)(ii) the last day of the first financial year ending on or after 31 August 2018, where none had been lodged` (Date 1 3 2010) EQUALS Date 1 3 2019
#ASSERT `s 198(3)(a)(ii) the last day of the first financial year ending on or after 31 August 2018, where none had been lodged` (Date 29 2 2012) EQUALS Date 28 2 2019
-- the two together (a return or notification lodged, the last day indicated, the date of incorporation)
#ASSERT `s 198(3)(a) the last day of the company's first financial year ending on or after 31 August 2018` TRUE (Date 31 12 2017) (Date 1 3 2010) EQUALS Date 31 12 2018
#ASSERT `s 198(3)(a) the last day of the company's first financial year ending on or after 31 August 2018` FALSE (Date 31 12 2017) (Date 1 3 2010) EQUALS Date 1 3 2019
-- the period (a return lodged, the last day indicated, the date of incorporation, the last day of the period)
#ASSERT `s 198(3)(a) the period is the company's first financial year ending on or after 31 August 2018` TRUE (Date 31 12 2017) (Date 1 3 2010) (Date 31 12 2018) EQUALS JUST TRUE
#ASSERT `s 198(3)(a) the period is the company's first financial year ending on or after 31 August 2018` TRUE (Date 31 12 2017) (Date 1 3 2010) (Date 31 12 2017) EQUALS JUST FALSE
#ASSERT `s 198(3)(a) the period is the company's first financial year ending on or after 31 August 2018` FALSE (Date 31 12 2017) (Date 1 3 2010) (Date 1 3 2019) EQUALS JUST TRUE
#ASSERT `s 198(3)(a) the period is the company's first financial year ending on or after 31 August 2018` FALSE (Date 31 12 2017) (Date 1 3 2010) (Date 31 12 2018) EQUALS JUST FALSE
-- (b): the subsequent years, as in subsection (1)(b)
#ASSERT `s 198(3)(b) the period is a subsequent financial year of the company` (Date 31 12 2018) (Date 1 1 2019) (Date 31 12 2019) 12 EQUALS JUST TRUE
#ASSERT `s 198(3)(b) the period is a subsequent financial year of the company` (Date 31 12 2018) (Date 1 1 2019) (Date 30 12 2019) 12 EQUALS JUST FALSE
#ASSERT `s 198(3)(b) the period is a subsequent financial year of the company` (Date 31 12 2018) (Date 2 1 2019) (Date 31 12 2019) 12 EQUALS JUST FALSE

§ `s 198(4) to (6): changing the last day of the financial year by notice`

-- (5)(b): lodged less than 5 years after the end of an earlier financial year (lodged, the last day of the earlier year, its end was changed under this section)
#ASSERT `s 198(5) the notice is lodged less than 5 years after the end of an earlier financial year` (Date 30 12 2024) (Date 31 12 2019) TRUE
