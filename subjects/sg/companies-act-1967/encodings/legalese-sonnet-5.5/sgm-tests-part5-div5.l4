#ASSERT `s 198(5) the Registrar's approval must be obtained for the notice` FALSE (Date 30 12 2024) (Date 31 12 2019) TRUE EQUALS JUST TRUE
#ASSERT `s 198(5) the Registrar's approval must be obtained for the notice` FALSE (Date 31 12 2024) (Date 31 12 2019) TRUE EQUALS JUST FALSE
#ASSERT `s 198(5) the Registrar's approval must be obtained for the notice` FALSE (Date 30 12 2024) (Date 31 12 2019) FALSE EQUALS JUST FALSE
-- (6): the three periods that bar the notice (the periods under section 175, section 197, section 203 have expired)
#ASSERT `s 198(6) the notice cannot specify the new date as the last day of the financial year` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 198(6) the notice cannot specify the new date as the last day of the financial year` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 198(6) the notice cannot specify the new date as the last day of the financial year` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 198(6) the notice cannot specify the new date as the last day of the financial year` FALSE FALSE FALSE EQUALS NOTHING
-- (4): the company may by notice specify a new date (notice in the prescribed form, approval must be obtained, approved, barred by subsection (6))
