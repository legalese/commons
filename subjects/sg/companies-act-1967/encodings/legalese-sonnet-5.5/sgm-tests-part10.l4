IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgm-part10`

-- Tests of sgm-part10.l4 (ss 344 to 344H). Every expected value is written from the text, beside the assertion.
-- Dates are Date day month year. The trace clock counts days after the day of the event (AT 0).

§ `Fixtures`

`the penalty of a fine of $2,000` MEANS `Penalty` OF 2000, 0, FALSE, FALSE

§ `s 344(1) and (1A): the Registrar's letter`
#ASSERT `s 344(1) the Registrar may send the company and its directors, secretaries and members a letter` TRUE EQUALS JUST TRUE
#ASSERT `s 344(1) the Registrar may send the company and its directors, secretaries and members a letter` FALSE EQUALS JUST FALSE
#ASSERT `s 344(1) the last day for an answer showing cause to the contrary` (Date 1 3 2026) EQUALS Date 31 3 2026
#ASSERT `s 344(1) the last day for an answer showing cause to the contrary` (Date 30 1 2028) EQUALS Date 29 2 2028
#ASSERT `s 344(1) the answer was received within 30 days after the date of the letter` (Date 1 3 2026) (Date 31 3 2026)
#ASSERT NOT (`s 344(1) the answer was received within 30 days after the date of the letter` (Date 1 3 2026) (Date 1 4 2026))
#ASSERT `s 344(1) the answer was received within 30 days after the date of the letter` (Date 1 3 2026) (Date 1 3 2026)
#ASSERT `s 344(1A) the Registrar may have regard to the circumstance in determining whether the company is not carrying on business` TRUE EQUALS JUST TRUE
#ASSERT `s 344(1A) the Registrar may have regard to the circumstance in determining whether the company is not carrying on business` FALSE EQUALS NOTHING
§ `s 344(2) and (3): the notice that the name will be struck off`
-- (the letter was sent, the date of the letter, an answer has been received, the day it was received)
#ASSERT `s 344(2) the Registrar may publish the notice that the name of the company will be struck off` FALSE (Date 1 3 2026) FALSE (Date 1 1 2000) EQUALS NOTHING
#ASSERT `s 344(2) the Registrar may publish the notice that the name of the company will be struck off` TRUE (Date 1 3 2026) TRUE (Date 1 4 2026) EQUALS JUST FALSE
#ASSERT `s 344(2) the Registrar may publish the notice that the name of the company will be struck off` TRUE (Date 1 3 2026) TRUE (Date 2 4 2026) EQUALS JUST TRUE
#ASSERT `s 344(2) the Registrar may publish the notice that the name of the company will be struck off` TRUE (Date 1 3 2026) FALSE (Date 1 1 2000) EQUALS JUST TRUE
-- one month from 31 January 2026 ends on 28 February (P4)
#ASSERT `s 344(2) the Registrar may publish the notice that the name of the company will be struck off` TRUE (Date 31 1 2026) TRUE (Date 28 2 2026) EQUALS JUST FALSE
#ASSERT `s 344(2) the Registrar may publish the notice that the name of the company will be struck off` TRUE (Date 31 1 2026) TRUE (Date 1 3 2026) EQUALS JUST TRUE
#ASSERT `s 344(2) the last day of the 60 days after the date of the notice` (Date 1 3 2026) EQUALS Date 30 4 2026
-- (the company is being wound up; limb (a); limb (b); limb (c))
#ASSERT `s 344(3) the Registrar may publish in the Gazette and send the notice to the same effect as the notice under subsection (2)` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 344(3) the Registrar may publish in the Gazette and send the notice to the same effect as the notice under subsection (2)` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 344(3) the Registrar may publish in the Gazette and send the notice to the same effect as the notice under subsection (2)` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 344(3) the Registrar may publish in the Gazette and send the notice to the same effect as the notice under subsection (2)` TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 344(3) the Registrar may publish in the Gazette and send the notice to the same effect as the notice under subsection (2)` FALSE TRUE FALSE FALSE EQUALS NOTHING
§ `s 344(4) to (6): striking off, dissolution, restoration by the Court`
-- (the date of the notice, cause to the contrary shown, the date asked): the 60 days after 1 March 2026 end on 30 April
#ASSERT `s 344(4) the Registrar may strike the name of the company off the register` (Date 1 3 2026) FALSE (Date 30 4 2026) EQUALS JUST FALSE
#ASSERT `s 344(4) the Registrar may strike the name of the company off the register` (Date 1 3 2026) FALSE (Date 1 5 2026) EQUALS JUST TRUE
#ASSERT `s 344(4) the Registrar may strike the name of the company off the register` (Date 1 3 2026) FALSE (Date 1 3 2026) EQUALS JUST FALSE
#ASSERT `s 344(4) the Registrar may strike the name of the company off the register` (Date 1 3 2026) TRUE (Date 1 5 2026) EQUALS JUST FALSE
#ASSERT `s 344(4) the Registrar must publish notice of the striking off in the Gazette` TRUE EQUALS JUST TRUE
#ASSERT `s 344(4) the Registrar must publish notice of the striking off in the Gazette` FALSE EQUALS NOTHING
-- EXPECT RESIDUAL
#TRACE `s 344(4) the Registrar must publish notice of the striking off in the Gazette (rule)` 7 AT 0 WITH
-- EXPECT FULFILLED
#TRACE `s 344(4) the Registrar must publish notice of the striking off in the Gazette (rule)` 45 AT 0 WITH
    PARTY Registrar DOES `s 344(4) publish in the Gazette notice of the striking off of the name of the company` AT 5

-- late: the act is done on day 400, past the 7 days the input is, so BREACH
-- EXPECT BREACH
#TRACE `s 344(4) the Registrar must publish notice of the striking off in the Gazette (rule)` 7 AT 0 WITH
    PARTY Registrar DOES `s 344(4) publish in the Gazette notice of the striking off of the name of the company` AT 400

#ASSERT `s 344(4) the company is dissolved` TRUE EQUALS JUST TRUE
#ASSERT `s 344(4) the company is dissolved` FALSE EQUALS NOTHING
#ASSERT `s 344(4)(a) the liability of the officer or member continues and may be enforced as if the company had not been dissolved` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 344(4)(a) the liability of the officer or member continues and may be enforced as if the company had not been dissolved` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 344(4)(a) the liability of the officer or member continues and may be enforced as if the company had not been dissolved` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 344(4)(a) the liability of the officer or member continues and may be enforced as if the company had not been dissolved` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 344(4)(b) the Court may wind up the company the name of which has been struck off the register` TRUE EQUALS JUST TRUE
#ASSERT `s 344(4)(b) the Court may wind up the company the name of which has been struck off the register` FALSE EQUALS NOTHING
-- (aggrieved, the day of the application, the day of the striking off, satisfied it was carrying on business, satisfied it is otherwise just)
#ASSERT `s 344(5) the Court may order the name of the company to be restored to the register` TRUE (Date 1 3 2032) (Date 1 3 2026) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 344(5) the Court may order the name of the company to be restored to the register` TRUE (Date 2 3 2032) (Date 1 3 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 344(5) the Court may order the name of the company to be restored to the register` TRUE (Date 28 2 2026) (Date 1 3 2026) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 344(5) the Court may order the name of the company to be restored to the register` FALSE (Date 1 3 2032) (Date 1 3 2026) TRUE TRUE EQUALS NOTHING
#ASSERT `s 344(5) the Court may order the name of the company to be restored to the register` TRUE (Date 1 3 2032) (Date 1 3 2026) FALSE FALSE EQUALS NOTHING
#ASSERT `s 344(5) the Court may order the name of the company to be restored to the register` TRUE (Date 1 3 2032) (Date 1 3 2026) FALSE TRUE EQUALS JUST TRUE
-- 6 years from 29 February 2028 end on 28 February 2034 (P4)
#ASSERT `s 344(5) the Court may order the name of the company to be restored to the register` TRUE (Date 28 2 2034) (Date 29 2 2028) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 344(5) the Court may order the name of the company to be restored to the register` TRUE (Date 1 3 2034) (Date 29 2 2028) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 344(5) the company is deemed to have continued in existence as if its name had not been struck off` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 344(5) the company is deemed to have continued in existence as if its name had not been struck off` TRUE FALSE EQUALS NOTHING
#ASSERT `s 344(5) the company is deemed to have continued in existence as if its name had not been struck off` FALSE TRUE EQUALS NOTHING
#ASSERT `s 344(6) the notice may be addressed to the liquidator at the liquidator's last known place of business` TRUE EQUALS JUST TRUE
#ASSERT `s 344(6) the notice may be addressed to the liquidator at the liquidator's last known place of business` FALSE EQUALS NOTHING
#ASSERT `s 344(6) the letter or notice may be addressed to the company at its registered office` TRUE EQUALS JUST TRUE
#ASSERT `s 344(6) the letter or notice may be addressed to the company at its registered office` FALSE EQUALS NOTHING
#ASSERT `s 344(6) the letter or notice may be addressed to the company in the care of some officer of the company` FALSE EQUALS JUST TRUE
#ASSERT `s 344(6) the letter or notice may be addressed to the company in the care of some officer of the company` TRUE EQUALS NOTHING
-- (the company has a registered office, there is an officer whose name and address are known to the Registrar)
#ASSERT `s 344(6) the letter or notice may be sent to each of the persons who subscribed the constitution` FALSE FALSE EQUALS JUST TRUE
