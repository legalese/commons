IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sg-groups`
IMPORT `sgg-scope`
IMPORT `sgg-returns`

-- Tests for sgg-returns.l4 (ss 372 to 374). Expected values are written from the text of each subsection, beside the assertion.

§ `Section 372(1): the return when documents are altered`

-- the nine kinds of change the subsection names
#ASSERT `s 372(1) the change is one the subsection names` `s 372(1)(a) a change in the charter, statutes, constitution, memorandum or articles of the foreign company or other instrument lodged with the Registrar` FALSE EQUALS JUST TRUE
#ASSERT `s 372(1) the change is one the subsection names` `s 372(1)(b) a change in the directors of the foreign company` FALSE EQUALS JUST TRUE
#ASSERT `s 372(1) the change is one the subsection names` `s 372(1)(c) a change in the authorised representative or authorised representatives of the foreign company` FALSE EQUALS JUST TRUE
#ASSERT `s 372(1) the change is one the subsection names` `s 372(1)(d) a change in the situation or address or designation of situation or address of the registered office in Singapore, or in the days or hours it is open and accessible to the public` FALSE EQUALS JUST TRUE
#ASSERT `s 372(1) the change is one the subsection names` `s 372(1)(e) a change in the address of the registered office of the foreign company in its place of incorporation or origin` FALSE EQUALS JUST TRUE
#ASSERT `s 372(1) the change is one the subsection names` `s 372(1)(f) a change in the name of the foreign company` FALSE EQUALS JUST TRUE
#ASSERT `s 372(1) the change is one the subsection names` `s 372(1)(g) a change in the description of the business carried on by the foreign company` FALSE EQUALS JUST TRUE
#ASSERT `s 372(1) the change is one the subsection names` `s 372(1)(h) a change in the type of legal form or legal entity of the foreign company` FALSE EQUALS JUST TRUE
-- (ca) particulars of a director or authorised representative "other than the director's or authorised representative's residential address"
#ASSERT `s 372(1) the change is one the subsection names` `s 372(1)(ca) a change in the particulars of a director or authorised representative lodged under section 368(1)` FALSE EQUALS JUST TRUE
#ASSERT `s 372(1) the change is one the subsection names` `s 372(1)(ca) a change in the particulars of a director or authorised representative lodged under section 368(1)` TRUE EQUALS JUST FALSE
-- a change the paragraphs do not name: not covered
#ASSERT `s 372(1) the change is one the subsection names` `s 372(1) some other change` FALSE EQUALS NOTHING
-- within 30 days after the change: 1 January 2025 + 30 days = 31 January 2025
#ASSERT `s 372(1) the particulars of the change were lodged within the time` (Date 1 1 2025) (Date 31 1 2025) 0 EQUALS JUST TRUE
#ASSERT `s 372(1) the particulars of the change were lodged within the time` (Date 1 1 2025) (Date 1 2 2025) 0 EQUALS JUST FALSE
-- "or within such further period as the Registrar in special circumstances allows": 45 days after 1 January 2025 is 15 February 2025
#ASSERT `s 372(1) the particulars of the change were lodged within the time` (Date 1 1 2025) (Date 15 2 2025) 45 EQUALS JUST TRUE
#ASSERT `s 372(1) the particulars of the change were lodged within the time` (Date 1 1 2025) (Date 16 2 2025) 45 EQUALS JUST FALSE
-- a "further" period shorter than 30 days adds nothing
#ASSERT `s 372(1) the particulars of the change were lodged within the time` (Date 1 1 2025) (Date 31 1 2025) 20 EQUALS JUST TRUE
#ASSERT `s 372(1) the particulars of the change were lodged within the time` (Date 1 1 2025) (Date 1 2 2025) 20 EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 372(1) the foreign company must lodge particulars of the change within 30 days or the further period the Registrar allows` "Overseas Co" 0 AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 372(1) lodge particulars of the change and the documents the regulations require` AT 30
-- EXPECT BREACH
#TRACE `s 372(1) the foreign company must lodge particulars of the change within 30 days or the further period the Registrar allows` "Overseas Co" 0 AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 372(1) lodge particulars of the change and the documents the regulations require` AT 31
-- EXPECT BREACH
#TRACE `s 372(1) the foreign company must lodge particulars of the change within 30 days or the further period the Registrar allows` "Overseas Co" 0 AT 0 WITH
    (WAITUNTIL 31)
-- EXPECT FULFILLED
#TRACE `s 372(1) the foreign company must lodge particulars of the change within 30 days or the further period the Registrar allows` "Overseas Co" 45 AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 372(1) lodge particulars of the change and the documents the regulations require` AT 45
-- EXPECT BREACH
#TRACE `s 372(1) the foreign company must lodge particulars of the change within 30 days or the further period the Registrar allows` "Overseas Co" 45 AT 0 WITH
    (WAITUNTIL 46)

§ `Section 372(1A), (1B), (1C)`

#ASSERT `s 372(1A) the notice of the new residential address was lodged within 30 days after the change` (Date 1 1 2025) (Date 31 1 2025) EQUALS JUST TRUE
#ASSERT `s 372(1A) the notice of the new residential address was lodged within 30 days after the change` (Date 1 1 2025) (Date 1 2 2025) EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 372(1A) a director or authorised representative must lodge a notice of the new residential address within 30 days` (`s 365 a director of the foreign company` "Ann Lim") AT 0 WITH
    PARTY `s 365 a director of the foreign company` "Ann Lim" DOES `s 372(1A) lodge a notice of the new residential address` AT 30
-- EXPECT BREACH
#TRACE `s 372(1A) a director or authorised representative must lodge a notice of the new residential address within 30 days` (`s 365 an authorised representative of the foreign company` "Raj Nair") AT 0 WITH
    (WAITUNTIL 31)
-- (1B) a report of the change under section 10 of the National Registration Act 1965 counts as informing the Registrar
#ASSERT `s 372(1B) the person is taken to have informed the Registrar of the change of residential address` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 372(1B) the person is taken to have informed the Registrar of the change of residential address` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 372(1B) the person is taken to have informed the Registrar of the change of residential address` FALSE TRUE EQUALS JUST FALSE
-- (1C) default in complying with (1A): guilty of an offence, a fine not exceeding $5,000 and also a default penalty
#ASSERT (`s 372(1C) the offence and its penalty` `s 365 role: a director of the foreign company, or an equivalent person` TRUE)'s `s 372(1C) the offence applies` EQUALS JUST TRUE
#ASSERT (`s 372(1C) the offence and its penalty` `s 365 role: a director of the foreign company, or an equivalent person` TRUE)'s `s 372(1C) the maximum fine, in dollars` EQUALS JUST 5000
#ASSERT (`s 372(1C) the offence and its penalty` `s 365 role: an authorised representative of the foreign company` TRUE)'s `s 372(1C) a default penalty also applies` EQUALS JUST TRUE
#ASSERT (`s 372(1C) the offence and its penalty` `s 365 role: an authorised representative of the foreign company` TRUE)'s `s 372(1C) the maximum term of imprisonment, in months` EQUALS NOTHING
#ASSERT (`s 372(1C) the offence and its penalty` `s 365 role: a director of the foreign company, or an equivalent person` FALSE)'s `s 372(1C) the offence applies` EQUALS JUST FALSE
#ASSERT (`s 372(1C) the offence and its penalty` `s 365 role: the foreign company` TRUE)'s `s 372(1C) the offence applies` EQUALS NOTHING

§ `Section 372(4)`

#ASSERT `s 372(4) the foreign company must lodge a copy of the order with the Registrar` TRUE EQUALS JUST TRUE
#ASSERT `s 372(4) the foreign company must lodge a copy of the order with the Registrar` FALSE EQUALS JUST FALSE
-- 30 days after an order made on 1 March 2025 is 31 March 2025
#ASSERT `s 372(4) the copy of the order was lodged within the time` (Date 1 3 2025) (Date 31 3 2025) 0 EQUALS JUST TRUE
#ASSERT `s 372(4) the copy of the order was lodged within the time` (Date 1 3 2025) (Date 1 4 2025) 0 EQUALS JUST FALSE
#ASSERT `s 372(4) the copy of the order was lodged within the time` (Date 1 3 2025) (Date 1 4 2025) 40 EQUALS JUST TRUE
-- EXPECT FULFILLED
#TRACE `s 372(4) the foreign company must lodge a copy of the order within 30 days` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 372(4) lodge a copy of the order` AT 30
-- EXPECT BREACH
#TRACE `s 372(4) the foreign company must lodge a copy of the order within 30 days` "Overseas Co" AT 0 WITH
    (WAITUNTIL 31)

§ `Section 373(1) to (3): what is lodged, which statements, and when`

#ASSERT `s 373(1) the foreign company has lodged what the subsection requires` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 373(1) the foreign company has lodged what the subsection requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- audited statements need the name of the auditor too
#ASSERT `s 373(1) the foreign company has lodged what the subsection requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 373(1) the foreign company has lodged what the subsection requires` FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 373(1) the foreign company has lodged what the subsection requires` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- (2) which statements: arguments are listed on an exchange; the exchange's rules require statements; substantially similar standards; the law of the place of incorporation's standards
#ASSERT `s 373(2) the financial statements the subsection means` TRUE TRUE FALSE FALSE EQUALS `s 373(2)(a) the financial statements the rules of the exchange require the foreign company to prepare`
-- listed, and the rules require statements, and it also prepares substantially similar ones: (a) governs, "in any other case" is (b)
#ASSERT `s 373(2) the financial statements the subsection means` TRUE TRUE TRUE FALSE EQUALS `s 373(2)(a) the financial statements the rules of the exchange require the foreign company to prepare`
-- listed but the rules do not require statements: (b)
#ASSERT `s 373(2) the financial statements the subsection means` TRUE FALSE TRUE FALSE EQUALS `s 373(2)(b)(i) the financial statements prepared in accordance with accounting standards substantially similar to the Accounting Standards`
#ASSERT `s 373(2) the financial statements the subsection means` FALSE FALSE TRUE FALSE EQUALS `s 373(2)(b)(i) the financial statements prepared in accordance with accounting standards substantially similar to the Accounting Standards`
#ASSERT `s 373(2) the financial statements the subsection means` FALSE FALSE FALSE TRUE EQUALS `s 373(2)(b)(ii) the financial statements prepared in accordance with the applicable accounting standards the law of the place of incorporation requires`
#ASSERT `s 373(2) the financial statements the subsection means` FALSE FALSE FALSE FALSE EQUALS `s 373(2)(b)(iii) the unaudited summary financial statements of the foreign company`
-- (3)(a) 60 days after an annual general meeting held on 1 March 2025: 30 April 2025 (30 days to 31 March, then 30 more)
#ASSERT `s 373(3) the last day for lodging the financial statements` TRUE (Date 1 3 2025) (Date 31 12 2025) EQUALS Date 30 4 2025
-- (3)(b) any other case: the last day a public company incorporated under the Act would have had, supplied as a fact
#ASSERT `s 373(3) the last day for lodging the financial statements` FALSE (Date 1 3 2025) (Date 31 12 2025) EQUALS Date 31 12 2025
#ASSERT `s 373(3) the financial statements were lodged within the time` (Date 30 4 2025) (Date 30 4 2025) EQUALS JUST TRUE
#ASSERT `s 373(3) the financial statements were lodged within the time` (Date 30 4 2025) (Date 1 5 2025) EQUALS JUST FALSE

§ `Section 373(4) to (6): the Registrar's requirement`

#ASSERT `s 373(4) the Registrar may require the foreign company by written notice to lodge further statements and annex documents` TRUE EQUALS JUST TRUE
-- not of that opinion: the grant is not open, and the text does not say the Registrar may not (the grant rule of 2026-11-12)
#ASSERT `s 373(4) the Registrar may require the foreign company by written notice to lodge further statements and annex documents` FALSE EQUALS NOTHING
#ASSERT `s 373(5) subsection (4) does not authorise the Registrar to require the particulars or documents` TRUE EQUALS JUST TRUE
#ASSERT `s 373(5) subsection (4) does not authorise the Registrar to require the particulars or documents` FALSE EQUALS NOTHING
#ASSERT `s 373(6) the foreign company has complied with the requirements in the notice` FALSE TRUE EQUALS NOTHING
#ASSERT `s 373(6) the foreign company has complied with the requirements in the notice` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 373(6) the foreign company has complied with the requirements in the notice` TRUE FALSE EQUALS JUST FALSE
-- the notice allows 10 days
-- EXPECT FULFILLED
#TRACE `s 373(6) the foreign company must comply with the requirements in the Registrar's notice within the period the notice gives` "Overseas Co" 10 AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 373(6) comply with the requirements set out in the Registrar's notice` AT 10
-- EXPECT BREACH
#TRACE `s 373(6) the foreign company must comply with the requirements in the Registrar's notice within the period the notice gives` "Overseas Co" 10 AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 373(6) comply with the requirements set out in the Registrar's notice` AT 11
-- EXPECT BREACH
#TRACE `s 373(6) the foreign company must comply with the requirements in the Registrar's notice within the period the notice gives` "Overseas Co" 10 AT 0 WITH
    (WAITUNTIL 11)

§ `Section 373(7) to (11)`

#ASSERT `s 373(7) the foreign company has lodged what the subsection requires in addition` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 373(7) the foreign company has lodged what the subsection requires in addition` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 373(7) the foreign company has lodged what the subsection requires in addition` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 373(7) the foreign company has lodged what the subsection requires in addition` TRUE TRUE FALSE EQUALS JUST FALSE
-- 40 days from now to the last day for lodging
-- EXPECT FULFILLED
#TRACE `s 373(7) the foreign company must lodge the audited statement, the audited profit and loss account and the auditor's name within the time in subsection (3)` "Overseas Co" 40 AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 373(7) lodge the statements, the profit and loss account and the auditor's name in addition` AT 40
-- EXPECT BREACH
#TRACE `s 373(7) the foreign company must lodge the audited statement, the audited profit and loss account and the auditor's name within the time in subsection (3)` "Overseas Co" 40 AT 0 WITH
    (WAITUNTIL 41)
-- (7A)
#ASSERT `s 373(7A) the foreign company has ensured that the profit and loss account complies and gives a true and fair view` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 373(7A) the foreign company has ensured that the profit and loss account complies and gives a true and fair view` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 373(7A) the foreign company has ensured that the profit and loss account complies and gives a true and fair view` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 373(7A) the foreign company has ensured that the profit and loss account complies and gives a true and fair view` TRUE TRUE FALSE EQUALS JUST FALSE
-- (8) entitled, for the purpose of (7A)
#ASSERT `s 373(8) the foreign company is entitled to make the apportionments and add the notes and explanations` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 373(8) the foreign company is entitled to make the apportionments and add the notes and explanations` FALSE TRUE EQUALS NOTHING
#ASSERT `s 373(8) the foreign company is entitled to make the apportionments and add the notes and explanations` TRUE FALSE EQUALS NOTHING
-- (9) a dormant foreign company may lodge unaudited documents
#ASSERT `s 373(9) the foreign company may lodge unaudited documents in lieu of subsection (7)` TRUE EQUALS JUST TRUE
#ASSERT `s 373(9) the foreign company may lodge unaudited documents in lieu of subsection (7)` FALSE EQUALS NOTHING
-- (10) on application and payment of the prescribed application fee; a requirement of (3)(b) or (7)
#ASSERT `s 373(10) the Registrar may extend the period for the requirement` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 373(10) the Registrar may extend the period for the requirement` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 373(10) the Registrar may extend the period for the requirement` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 373(10) the Registrar may extend the period for the requirement` TRUE TRUE FALSE EQUALS NOTHING
-- (11) deemed duly audited: a report by an accounting entity (a public accountant here) appointed for the operations in Singapore, complying insofar as practicable with section 207
#ASSERT `s 373(11) the statement and profit and loss account are deemed to have been duly audited` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 373(11) the statement and profit and loss account are deemed to have been duly audited` FALSE FALSE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- a person who is none of the four is not an accounting entity
#ASSERT `s 373(11) the statement and profit and loss account are deemed to have been duly audited` FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 373(11) the statement and profit and loss account are deemed to have been duly audited` TRUE FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 373(11) the statement and profit and loss account are deemed to have been duly audited` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE

§ `Section 373(12) to (17): the Registrar's and the Minister's relief`

-- (12) "upon the written application" and "if the Registrar is satisfied that" one of the four things
#ASSERT `s 373(12) the Registrar may waive the requirement to lodge the documents referred to in subsection (7)` FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 373(12) the Registrar may waive the requirement to lodge the documents referred to in subsection (7)` TRUE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 373(12) the Registrar may waive the requirement to lodge the documents referred to in subsection (7)` TRUE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 373(12) the Registrar may waive the requirement to lodge the documents referred to in subsection (7)` TRUE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 373(12) the Registrar may waive the requirement to lodge the documents referred to in subsection (7)` TRUE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 373(12) the Registrar may waive the requirement to lodge the documents referred to in subsection (7)` TRUE FALSE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- harmful to the other company, but it is not a company section 6 deems related to the foreign company: the paragraph does not reach it
#ASSERT `s 373(12) the Registrar may waive the requirement to lodge the documents referred to in subsection (7)` TRUE FALSE FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 373(12) the Registrar may waive the requirement to lodge the documents referred to in subsection (7)` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (13) and (13A) upon the application
#ASSERT `s 373(13) the Registrar may make the order on the application` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 373(13) the Registrar may make the order on the application` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 373(13) the Registrar may make the order on the application` TRUE FALSE EQUALS NOTHING
#ASSERT `s 373(13A) the Registrar may make the order relieving the foreign company from the requirement` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 373(13A) the Registrar may make the order relieving the foreign company from the requirement` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 373(13A) the Registrar may make the order relieving the foreign company from the requirement` TRUE FALSE EQUALS NOTHING
-- (14), (16)
#ASSERT `s 373(14) the Registrar may make the order unconditionally or subject to conditions` TRUE EQUALS JUST TRUE
#ASSERT `s 373(14) the Registrar may make the order unconditionally or subject to conditions` FALSE EQUALS NOTHING
#ASSERT `s 373(16) the order may be limited to a specific period and may be revoked or suspended from time to time` TRUE EQUALS JUST TRUE
#ASSERT `s 373(16) the order may be limited to a specific period and may be revoked or suspended from time to time` FALSE EQUALS NOTHING
-- (15) the bar: not of the opinion, the Registrar must not make the order
#ASSERT `s 373(15) the Registrar is barred from making an order under subsection (13) or (13A)` FALSE EQUALS JUST TRUE
#ASSERT `s 373(15) the Registrar is barred from making an order under subsection (13) or (13A)` TRUE EQUALS NOTHING
-- (17) the Minister's orders, supplied as facts
#ASSERT `s 373(17)(a) the other accounting standards apply to the foreign company in place of the Accounting Standards` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 373(17)(a) the other accounting standards apply to the foreign company in place of the Accounting Standards` TRUE FALSE EQUALS NOTHING
#ASSERT `s 373(17)(a) the other accounting standards apply to the foreign company in place of the Accounting Standards` FALSE TRUE EQUALS NOTHING
#ASSERT `s 373(17)(b) the foreign company is exempt from the requirements of subsection (7) or (7A) the order names` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 373(17)(b) the foreign company is exempt from the requirements of subsection (7) or (7A) the order names` FALSE TRUE EQUALS NOTHING

§ `Section 373(18), (18A), (19): offences and definitions`

-- (18) the company: a fine not exceeding $10,000
#ASSERT (`s 373(18) the offence and its penalty` `s 365 role: the foreign company` TRUE FALSE)'s `s 373(18) the offence applies` EQUALS JUST TRUE
#ASSERT (`s 373(18) the offence and its penalty` `s 365 role: the foreign company` TRUE FALSE)'s `s 373(18) the maximum fine, in dollars` EQUALS JUST 10000
#ASSERT (`s 373(18) the offence and its penalty` `s 365 role: the foreign company` TRUE FALSE)'s `s 373(18) the maximum term of imprisonment, in months` EQUALS NOTHING
#ASSERT (`s 373(18) the offence and its penalty` `s 365 role: the foreign company` TRUE FALSE)'s `s 373(18) a default penalty also applies` EQUALS NOTHING
#ASSERT (`s 373(18) the offence and its penalty` `s 365 role: the foreign company` FALSE FALSE)'s `s 373(18) the offence applies` EQUALS JUST FALSE
-- (18) a director who knowingly and wilfully authorises or permits the default; one who does not is outside the offence
#ASSERT (`s 373(18) the offence and its penalty` `s 365 role: a director of the foreign company, or an equivalent person` TRUE TRUE)'s `s 373(18) the offence applies` EQUALS JUST TRUE
#ASSERT (`s 373(18) the offence and its penalty` `s 365 role: a director of the foreign company, or an equivalent person` TRUE FALSE)'s `s 373(18) the offence applies` EQUALS JUST FALSE
#ASSERT (`s 373(18) the offence and its penalty` `s 365 role: an authorised representative of the foreign company` TRUE TRUE)'s `s 373(18) the maximum fine, in dollars` EQUALS JUST 10000
#ASSERT (`s 373(18) the offence and its penalty` `s 365 role: an officer of the foreign company` TRUE TRUE)'s `s 373(18) the offence applies` EQUALS NOTHING
-- (18A) the company: a fine not exceeding $250,000
#ASSERT (`s 373(18A) the offence and its penalty` `s 365 role: the foreign company` TRUE FALSE FALSE)'s `s 373(18A) the offence applies` EQUALS JUST TRUE
#ASSERT (`s 373(18A) the offence and its penalty` `s 365 role: the foreign company` TRUE FALSE FALSE)'s `s 373(18A) the maximum fine, in dollars` EQUALS JUST 250000
#ASSERT (`s 373(18A) the offence and its penalty` `s 365 role: the foreign company` TRUE FALSE FALSE)'s `s 373(18A) the maximum term of imprisonment, in months` EQUALS NOTHING
-- the company has no intent to defraud to prove: the same fine even if intent is asserted
#ASSERT (`s 373(18A) the offence and its penalty` `s 365 role: the foreign company` TRUE FALSE TRUE)'s `s 373(18A) the maximum term of imprisonment, in months` EQUALS NOTHING
-- (18A)(b)(i) a director, knowingly and wilfully, without intent to defraud: a fine not exceeding $250,000 only
#ASSERT (`s 373(18A) the offence and its penalty` `s 365 role: a director of the foreign company, or an equivalent person` TRUE TRUE FALSE)'s `s 373(18A) the maximum fine, in dollars` EQUALS JUST 250000
#ASSERT (`s 373(18A) the offence and its penalty` `s 365 role: a director of the foreign company, or an equivalent person` TRUE TRUE FALSE)'s `s 373(18A) the maximum term of imprisonment, in months` EQUALS NOTHING
-- (18A)(b)(ii) with intent to defraud creditors or for a fraudulent purpose: a fine not exceeding $250,000 or imprisonment not exceeding 3 years (36 months) or both
#ASSERT (`s 373(18A) the offence and its penalty` `s 365 role: a director of the foreign company, or an equivalent person` TRUE TRUE TRUE)'s `s 373(18A) the maximum term of imprisonment, in months` EQUALS JUST 36
#ASSERT (`s 373(18A) the offence and its penalty` `s 365 role: an authorised representative of the foreign company` TRUE TRUE TRUE)'s `s 373(18A) the maximum term of imprisonment, in months` EQUALS JUST 36
#ASSERT (`s 373(18A) the offence and its penalty` `s 365 role: an authorised representative of the foreign company` TRUE TRUE TRUE)'s `s 373(18A) the maximum fine, in dollars` EQUALS JUST 250000
-- not knowingly and wilfully: outside the offence; no default: no offence
#ASSERT (`s 373(18A) the offence and its penalty` `s 365 role: a director of the foreign company, or an equivalent person` TRUE FALSE TRUE)'s `s 373(18A) the offence applies` EQUALS JUST FALSE
#ASSERT (`s 373(18A) the offence and its penalty` `s 365 role: the foreign company` FALSE FALSE FALSE)'s `s 373(18A) the offence applies` EQUALS JUST FALSE
#ASSERT (`s 373(18A) the offence and its penalty` `s 365 role: someone else` TRUE TRUE TRUE)'s `s 373(18A) the offence applies` EQUALS NOTHING
-- (19)
#ASSERT `s 373(19)(a) the foreign company is dormant in Singapore during the period` TRUE EQUALS JUST TRUE
#ASSERT `s 373(19)(a) the foreign company is dormant in Singapore during the period` FALSE EQUALS JUST FALSE
#ASSERT `s 373(19)(b) the transaction is an accounting transaction` TRUE EQUALS JUST TRUE
#ASSERT `s 373(19)(b) the transaction is an accounting transaction` FALSE EQUALS JUST FALSE

§ `Section 374`

#ASSERT `s 374 the foreign company has lodged the return with its lodgment` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 374 the foreign company has lodged the return with its lodgment` TRUE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 374 the foreign company has lodged the return with its lodgment` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 374 the foreign company has lodged the return with its lodgment` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
-- a lodgment of some other kind: the section does not speak of it
#ASSERT `s 374 the foreign company has lodged the return with its lodgment` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- no time limit beyond "at the time": a late act still fulfils, and with no act the duty stays open (no breach path)
-- EXPECT RESIDUAL
#TRACE `s 374 the foreign company must lodge the return when it lodges its financial statements` "Overseas Co" AT 0 WITH
    (WAITUNTIL 400)
-- EXPECT FULFILLED
#TRACE `s 374 the foreign company must lodge the return when it lodges its financial statements` "Overseas Co" AT 0 WITH
    PARTY `s 365 the foreign company` "Overseas Co" DOES `s 374 lodge a return containing the prescribed information about the keeping of the registers` AT 400
