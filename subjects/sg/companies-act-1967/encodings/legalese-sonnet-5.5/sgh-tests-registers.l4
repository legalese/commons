IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgh-registers`

-- Tests for sgh-registers.l4 (ss 12 and 12A). Every expected value is written from the text of the section, beside the assertion, before the run.

§ `s 12(1)`
-- (test alias a121 = `s 12(1) the Registrar is to keep the register`)
#ASSERT `s 12(1) the Registrar is to keep the register` TRUE EQUALS JUST TRUE   -- "The Registrar is ... to keep such registers as the Registrar considers necessary"
#ASSERT `s 12(1) the Registrar is to keep the register` FALSE EQUALS NOTHING   -- a register the Registrar does not consider necessary: the text leaves it to the Registrar (fork line F-H-D1)

§ `s 12(2)(b): copies and certified copies`
-- (test alias a12b = `s 12(2)(b) the person may require a copy of the document or certificate, or an extract, to be given or certified by the Registrar`)
-- arguments: fee paid; request is for a copy of the notice of incorporation, a certificate or a document kept by the Registrar; prescribed excluded document (2AB); entry excluded by (2AC); company specified under (2A), notification not cancelled; notification cancelled and document filed before the cancellation (2B)
#ASSERT `s 12(2)(b) the person may require a copy of the document or certificate, or an extract, to be given or certified by the Registrar` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- "Any person may, on payment of the prescribed fee -- (b) ... require a copy of the notice of incorporation of a company, any certificate issued under this Act, any document or extract ... to be given or certified by the Registrar"
#ASSERT `s 12(2)(b) the person may require a copy of the document or certificate, or an extract, to be given or certified by the Registrar` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- the fee is not paid: a grant "on payment of the prescribed fee"; the text does not say (split site (ii), F-H-S3)
#ASSERT `s 12(2)(b) the person may require a copy of the document or certificate, or an extract, to be given or certified by the Registrar` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- a request for something other than those three things: the text does not say
#ASSERT `s 12(2)(b) the person may require a copy of the document or certificate, or an extract, to be given or certified by the Registrar` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- "Subsection (2)(b) does not apply to any document prescribed as an excluded document" (2AB)
#ASSERT `s 12(2)(b) the person may require a copy of the document or certificate, or an extract, to be given or certified by the Registrar` TRUE TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- (2AC) the entry is excluded from the document
#ASSERT `s 12(2)(b) the person may require a copy of the document or certificate, or an extract, to be given or certified by the Registrar` TRUE TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE   -- "Subsection (2)(b) and (d) does not apply to such exempt private company" (2A)
#ASSERT `s 12(2)(b) the person may require a copy of the document or certificate, or an extract, to be given or certified by the Registrar` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- "Despite the cancellation ... (2)(b) and (d) does not apply to any document or certificate ... filed or lodged ... before the date of such cancellation" (2B)
#ASSERT `s 12(2)(b) the person may require a copy of the document or certificate, or an extract, to be given or certified by the Registrar` FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- an excluded document with the fee unpaid: the exclusion has the last word

§ `s 12(2)(c) and (d): access to registers`
-- (test alias a12c = `s 12(2)(c) the person may have access to the register by obtaining a copy of or an extract from it`)
#ASSERT `s 12(2)(c) the person may have access to the register by obtaining a copy of or an extract from it` TRUE TRUE EQUALS JUST TRUE   -- "(c) have access to any register of directors, chief executive officers, secretaries or auditors of a company kept by the Registrar under section 173(1) by obtaining a copy of or an extract from it"
#ASSERT `s 12(2)(c) the person may have access to the register by obtaining a copy of or an extract from it` FALSE TRUE EQUALS NOTHING   -- fee not paid
#ASSERT `s 12(2)(c) the person may have access to the register by obtaining a copy of or an extract from it` TRUE FALSE EQUALS NOTHING   -- another register
-- (test alias a12d = `s 12(2)(d) the person may have access to the electronic register of members by obtaining a copy of or an extract from it`)
-- arguments: fee paid; the register is the electronic register of members of a private company kept under section 196A; company specified under (2A) and notification not cancelled; (2B) cancelled and filed before
#ASSERT `s 12(2)(d) the person may have access to the electronic register of members by obtaining a copy of or an extract from it` TRUE TRUE FALSE FALSE EQUALS JUST TRUE   -- "(d) have access to the electronic register of members of a private company kept by the Registrar under section 196A by obtaining a copy of or an extract from it"
#ASSERT `s 12(2)(d) the person may have access to the electronic register of members by obtaining a copy of or an extract from it` FALSE TRUE FALSE FALSE EQUALS NOTHING   -- fee not paid
#ASSERT `s 12(2)(d) the person may have access to the electronic register of members by obtaining a copy of or an extract from it` TRUE FALSE FALSE FALSE EQUALS NOTHING   -- another register
#ASSERT `s 12(2)(d) the person may have access to the electronic register of members by obtaining a copy of or an extract from it` TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- (2A) "Subsection (2)(b) and (d) does not apply to such exempt private company"
#ASSERT `s 12(2)(d) the person may have access to the electronic register of members by obtaining a copy of or an extract from it` TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- (2B) "subsection (2)(b) and (d) does not apply to any document or certificate relating to that company"

§ `s 12(2AA) to (2D)`
-- (test alias a12aa = `s 12(2AA) the certificate of confirmation of incorporation may be issued to the company`)
#ASSERT `s 12(2AA) the certificate of confirmation of incorporation may be issued to the company` FALSE EQUALS JUST FALSE   -- "may only be issued to the company upon an application made in accordance with those provisions": no application, so no
#ASSERT `s 12(2AA) the certificate of confirmation of incorporation may be issued to the company` TRUE EQUALS NOTHING   -- an application was made: the subsection only limits; it grants nothing (the grant is in sections 17(9) and 19(7))
-- (test alias a12ab = `s 12(2AB) subsection (2)(b) applies to the document`)
#ASSERT `s 12(2AB) subsection (2)(b) applies to the document` TRUE EQUALS JUST FALSE   -- "Subsection (2)(b) does not apply to any document prescribed as an excluded document"
#ASSERT `s 12(2AB) subsection (2)(b) applies to the document` FALSE EQUALS NOTHING   -- not prescribed as excluded: the subsection does not speak
-- (test alias a12ac = `s 12(2AC) the entry is excluded from the document for the purposes of subsection (2)(b)`)
#ASSERT `s 12(2AC) the entry is excluded from the document for the purposes of subsection (2)(b)` TRUE `s 12(2AC)(a) a means of notification provided by a person for the purposes of section 28A(1)(b) of the Accounting and Corporate Regulatory Authority Act 2004` EQUALS JUST TRUE   -- "(a) a means of notification provided by a person"
#ASSERT `s 12(2AC) the entry is excluded from the document for the purposes of subsection (2)(b)` TRUE `s 12(2AC)(b) an individual's date of birth obtained under this Act or section 28(1A) of the Accounting and Corporate Regulatory Authority Act 2004` EQUALS JUST TRUE   -- "(b) an individual's date of birth obtained under this Act"
#ASSERT `s 12(2AC) the entry is excluded from the document for the purposes of subsection (2)(b)` TRUE `s 12(2AC)(c) any other prescribed information` EQUALS JUST TRUE   -- "(c) any other prescribed information"
#ASSERT `s 12(2AC) the entry is excluded from the document for the purposes of subsection (2)(b)` TRUE `s 12(2AC) any other entry` EQUALS NOTHING   -- an entry not on the list: the text says nothing
#ASSERT `s 12(2AC) the entry is excluded from the document for the purposes of subsection (2)(b)` FALSE `s 12(2AC)(b) an individual's date of birth obtained under this Act or section 28(1A) of the Accounting and Corporate Regulatory Authority Act 2004` EQUALS JUST FALSE   -- the document was not submitted using a form on the electronic transaction system on or after the commencement: a failed "Where"
-- (test alias a12a = `s 12(2A) subsection (2)(b) and (d) does not apply to the company`)
#ASSERT `s 12(2A) subsection (2)(b) and (d) does not apply to the company` TRUE TRUE TRUE EQUALS JUST TRUE   -- an exempt private company wholly owned by the Government, specified by notification, where the Minister considers it would not be in the public interest
#ASSERT `s 12(2A) subsection (2)(b) and (d) does not apply to the company` FALSE TRUE TRUE EQUALS NOTHING   -- not such a company: the subsection does not speak
#ASSERT `s 12(2A) subsection (2)(b) and (d) does not apply to the company` TRUE FALSE TRUE EQUALS NOTHING   -- not specified by the Minister
#ASSERT `s 12(2A) subsection (2)(b) and (d) does not apply to the company` TRUE TRUE FALSE EQUALS NOTHING   -- the Minister does not consider it would not be in the public interest
-- (test alias a12b2 = `s 12(2B) subsection (2)(b) and (d) continues not to apply to the document or certificate`)
#ASSERT `s 12(2B) subsection (2)(b) and (d) continues not to apply to the document or certificate` TRUE TRUE EQUALS JUST TRUE   -- "Despite the cancellation of any notification ... (2)(b) and (d) does not apply to any document or certificate ... filed or lodged ... before the date of such cancellation"
#ASSERT `s 12(2B) subsection (2)(b) and (d) continues not to apply to the document or certificate` TRUE FALSE EQUALS NOTHING   -- filed after the cancellation: the subsection does not speak
#ASSERT `s 12(2B) subsection (2)(b) and (d) continues not to apply to the document or certificate` FALSE TRUE EQUALS NOTHING   -- no cancellation
-- (test alias a12c2 = `s 12(2C) the person may obtain the copy or extract from the Registrar without charge`)
#ASSERT `s 12(2C) the person may obtain the copy or extract from the Registrar without charge` TRUE TRUE EQUALS JUST TRUE   -- "Despite subsection (2), a director, chief executive officer, secretary, auditor or member of a company may, without charge -- (b) obtain from the Registrar a copy of or an extract from the register of directors ..."
#ASSERT `s 12(2C) the person may obtain the copy or extract from the Registrar without charge` FALSE TRUE EQUALS NOTHING   -- not one of those persons
#ASSERT `s 12(2C) the person may obtain the copy or extract from the Registrar without charge` TRUE FALSE EQUALS NOTHING   -- another register
-- (test alias a12d2 = `s 12(2D) the person may obtain the copy or extract of the register of members from the Registrar without charge`)
#ASSERT `s 12(2D) the person may obtain the copy or extract of the register of members from the Registrar without charge` TRUE TRUE EQUALS JUST TRUE   -- "a director, chief executive officer, secretary, auditor or member of a private company may, without charge -- (b) obtain from the Registrar a copy of or an extract from the register of members of that company kept by the Registrar under section 196A"
#ASSERT `s 12(2D) the person may obtain the copy or extract of the register of members from the Registrar without charge` FALSE TRUE EQUALS NOTHING   -- not one of those persons
#ASSERT `s 12(2D) the person may obtain the copy or extract of the register of members from the Registrar without charge` TRUE FALSE EQUALS NOTHING   -- another register

§ `s 12(3) to (7)`
-- (test alias a123 = `s 12(3) the copy or extract is admissible in evidence as of equal validity with the original document`)
#ASSERT `s 12(3) the copy or extract is admissible in evidence as of equal validity with the original document` TRUE TRUE EQUALS JUST TRUE   -- "A copy of or an extract from any document ... filed or lodged with the Registrar using a non-electronic medium that is certified to be a true copy or extract by the Registrar is in any proceedings admissible in evidence as of equal validity with the original document"
#ASSERT `s 12(3) the copy or extract is admissible in evidence as of equal validity with the original document` FALSE TRUE EQUALS NOTHING   -- a document filed electronically: the subsection does not speak
#ASSERT `s 12(3) the copy or extract is admissible in evidence as of equal validity with the original document` TRUE FALSE EQUALS NOTHING   -- not certified by the Registrar
-- (test alias a124 = `s 12(4) the certificate is to be received as prima facie evidence of the matters specified in it`)
#ASSERT `s 12(4) the certificate is to be received as prima facie evidence of the matters specified in it` TRUE TRUE TRUE EQUALS JUST TRUE   -- "shall be received as prima facie evidence of the matters specified in the certificate"
#ASSERT `s 12(4) the certificate is to be received as prima facie evidence of the matters specified in it` FALSE TRUE TRUE EQUALS NOTHING   -- not legal proceedings
#ASSERT `s 12(4) the certificate is to be received as prima facie evidence of the matters specified in it` TRUE FALSE TRUE EQUALS NOTHING   -- a certificate not issued by the Registrar
#ASSERT `s 12(4) the certificate is to be received as prima facie evidence of the matters specified in it` TRUE TRUE FALSE EQUALS NOTHING   -- a certificate that says something else
-- (test alias a125 = `s 12(5) the Registrar may refuse to register or receive the document and request that it be amended or completed and resubmitted, or that a fresh document be submitted in its place`)
#ASSERT `s 12(5) the Registrar may refuse to register or receive the document and request that it be amended or completed and resubmitted, or that a fresh document be submitted in its place` TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- "(a) contains any matter contrary to law"
#ASSERT `s 12(5) the Registrar may refuse to register or receive the document and request that it be amended or completed and resubmitted, or that a fresh document be submitted in its place` FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- "(b) by reason of any omission or misdescription has not been duly completed"
#ASSERT `s 12(5) the Registrar may refuse to register or receive the document and request that it be amended or completed and resubmitted, or that a fresh document be submitted in its place` FALSE FALSE TRUE FALSE EQUALS JUST TRUE   -- "(c) does not comply with the requirements of this Act"
#ASSERT `s 12(5) the Registrar may refuse to register or receive the document and request that it be amended or completed and resubmitted, or that a fresh document be submitted in its place` FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- "(d) contains any error, alteration or erasure"
#ASSERT `s 12(5) the Registrar may refuse to register or receive the document and request that it be amended or completed and resubmitted, or that a fresh document be submitted in its place` FALSE FALSE FALSE FALSE EQUALS NOTHING   -- none of the opinions: a failed "If" gating a grant (grant ruling, limit 1)
-- (test alias a126 = `s 12(6) the Registrar may destroy the document or transfer it to the National Archives of Singapore`)
#ASSERT `s 12(6) the Registrar may destroy the document or transfer it to the National Archives of Singapore` `s 12(6)(a) destroy the document with the authorisation of the National Library Board under section 17 of the National Library Board Act 1995` TRUE TRUE TRUE EQUALS JUST TRUE   -- "(a) destroy the document with the authorisation of the National Library Board"
#ASSERT `s 12(6) the Registrar may destroy the document or transfer it to the National Archives of Singapore` `s 12(6)(a) destroy the document with the authorisation of the National Library Board under section 17 of the National Library Board Act 1995` TRUE TRUE FALSE EQUALS NOTHING   -- destruction without the Board's authorisation
#ASSERT `s 12(6) the Registrar may destroy the document or transfer it to the National Archives of Singapore` `s 12(6)(b) transfer the document to the National Archives of Singapore under section 16 of that Act` TRUE TRUE FALSE EQUALS JUST TRUE   -- "(b) transfer the document to the National Archives of Singapore": no Board authorisation is needed for a transfer
#ASSERT `s 12(6) the Registrar may destroy the document or transfer it to the National Archives of Singapore` `s 12(6)(b) transfer the document to the National Archives of Singapore under section 16 of that Act` FALSE TRUE FALSE EQUALS NOTHING   -- the Registrar is not of the opinion that it is no longer necessary or desirable to retain the document
#ASSERT `s 12(6) the Registrar may destroy the document or transfer it to the National Archives of Singapore` `s 12(6)(b) transfer the document to the National Archives of Singapore under section 16 of that Act` TRUE FALSE FALSE EQUALS NOTHING   -- not microfilmed or converted to electronic form
-- (test alias a127 = `s 12(7) the medium is a non-electronic medium`)
#ASSERT `s 12(7) the medium is a non-electronic medium` TRUE EQUALS JUST FALSE   -- "'non-electronic medium' means a medium other than the electronic transaction system established under Part 6A"
#ASSERT `s 12(7) the medium is a non-electronic medium` FALSE EQUALS JUST TRUE   -- any other medium

§ `s 12A`
-- (test alias a12a1 = `s 12A(1) the system is the electronic transaction system mentioned in section 12A(1)`)
#ASSERT `s 12A(1) the system is the electronic transaction system mentioned in section 12A(1)` TRUE EQUALS JUST TRUE   -- "the electronic transaction system established under Part 6A of the Accounting and Corporate Regulatory Authority Act 2004"
#ASSERT `s 12A(1) the system is the electronic transaction system mentioned in section 12A(1)` FALSE EQUALS NOTHING   -- another system: the text does not say
-- (test alias a12a1a = `s 12A(1)(a) the Registrar may require or permit the person to carry out the transaction using the electronic transaction system`)
#ASSERT `s 12A(1)(a) the Registrar may require or permit the person to carry out the transaction using the electronic transaction system` TRUE EQUALS JUST TRUE   -- "(a) require or permit any person to carry out any transaction with the Registrar under this Act"
#ASSERT `s 12A(1)(a) the Registrar may require or permit the person to carry out the transaction using the electronic transaction system` FALSE EQUALS NOTHING   -- not a transaction in the sense of subsection (4)
-- (test alias a12a1b = `s 12A(1)(b) the Registrar may issue the document using the electronic transaction system`)
#ASSERT `s 12A(1)(b) the Registrar may issue the document using the electronic transaction system` TRUE EQUALS JUST TRUE   -- "(b) issue any approval, certificate, notice, determination or other document pursuant or connected to a transaction"
#ASSERT `s 12A(1)(b) the Registrar may issue the document using the electronic transaction system` FALSE EQUALS NOTHING   -- some other document
-- (test alias a12a2 = `s 12A(2) the Registrar may cause the electronic transaction system and the registers to reflect the earlier date and time`)
#ASSERT `s 12A(2) the Registrar may cause the electronic transaction system and the registers to reflect the earlier date and time` TRUE EQUALS JUST TRUE   -- "If the Registrar is satisfied that a transaction should be treated as having been carried out at some date and time earlier"
#ASSERT `s 12A(2) the Registrar may cause the electronic transaction system and the registers to reflect the earlier date and time` FALSE EQUALS NOTHING   -- not satisfied: a failed "If" gating a grant (grant ruling, limit 1)
-- (test alias a12a3 = `s 12A(3) the Registrar must keep a record of the alteration`)
#ASSERT `s 12A(3) the Registrar must keep a record of the alteration` TRUE EQUALS JUST TRUE   -- "The Registrar must keep a record whenever the electronic transaction system or the registers are altered under subsection (2)"
#ASSERT `s 12A(3) the Registrar must keep a record of the alteration` FALSE EQUALS JUST FALSE   -- not altered under (2): a failed "whenever" (counts as "where")
-- (test alias a12a4d = `s 12A(4) "document" the thing is a document`)
#ASSERT `s 12A(4) "document" the thing is a document` TRUE EQUALS JUST TRUE   -- "'document' includes any application, form, report, certification, notice, confirmation, declaration, return or other document ... filed or lodged with, or submitted to, the Registrar"
#ASSERT `s 12A(4) "document" the thing is a document` FALSE EQUALS NOTHING   -- "includes": the list is open
-- (test alias a12a4t = `s 12A(4) "transaction" the act is a transaction in relation to the Registrar`)
#ASSERT `s 12A(4) "transaction" the act is a transaction in relation to the Registrar` TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- "(a) the filing or lodging of any document with the Registrar"
#ASSERT `s 12A(4) "transaction" the act is a transaction in relation to the Registrar` FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- "(b) any making of any application, submission or request to the Registrar"
#ASSERT `s 12A(4) "transaction" the act is a transaction in relation to the Registrar` FALSE FALSE TRUE FALSE EQUALS JUST TRUE   -- "(c) any provision of any undertaking or declaration to the Registrar"
#ASSERT `s 12A(4) "transaction" the act is a transaction in relation to the Registrar` FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- "(d) any extraction, retrieval or accessing of any document, record or information maintained by the Registrar"
#ASSERT `s 12A(4) "transaction" the act is a transaction in relation to the Registrar` FALSE FALSE FALSE FALSE EQUALS JUST FALSE   -- "'transaction', in relation to the Registrar, means" (a "means" definition)

-- s 12A(3): a MUST with no time limit and no stated consequence: no breach path.
-- EXPECT FULFILLED
#TRACE `s 12A(3) the Registrar must keep a record whenever the system or the registers are altered under subsection (2)` AT 0 WITH
    PARTY Registrar DOES `s 12A(3) keep a record of the alteration of the electronic transaction system or the registers under subsection (2)` AT 5000
-- EXPECT RESIDUAL
#TRACE `s 12A(3) the Registrar must keep a record whenever the system or the registers are altered under subsection (2)` AT 0 WITH
