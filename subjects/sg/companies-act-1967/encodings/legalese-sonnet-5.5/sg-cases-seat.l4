-- Under section 211(5) and (7), am I liable under subsection (5)?
-- Arguments: default is made; I am an officer in default; my position; I am the liquidator; I am a trustee for debenture holders; I show the default was due to another's refusal.
-- a director in default, no defence shown: liable
#ASSERT `Under section 211(5) and (7), am I liable under subsection (5)` TRUE TRUE sgdseat_pos_director FALSE FALSE FALSE EQUALS JUST TRUE
-- (7): the director shows the default was due to another director's refusal to supply the particulars: the section gives a defence
#ASSERT `Under section 211(5) and (7), am I liable under subsection (5)` TRUE TRUE sgdseat_pos_director FALSE FALSE TRUE EQUALS JUST FALSE
-- no default, nothing to be liable for
#ASSERT `Under section 211(5) and (7), am I liable under subsection (5)` FALSE TRUE sgdseat_pos_director FALSE FALSE FALSE EQUALS JUST FALSE
-- (6): a liquidator appointed by the Court is deemed an officer for (5)
#ASSERT `Under section 211(5) and (7), am I liable under subsection (5)` TRUE TRUE sgdseat_pos_court_liquidator TRUE FALSE FALSE EQUALS JUST TRUE

-- Under section 211(5), what is the most I may be sentenced to on conviction?
-- Arguments: default is made; I am an officer in default; my position; I am the liquidator; I am a trustee for debenture holders.
-- "a fine not exceeding $5,000 or imprisonment for a term not exceeding 12 months": one or the other, not both
#ASSERT `Under section 211(5), what is the most I may be sentenced to on conviction` TRUE TRUE sgdseat_pos_director FALSE FALSE EQUALS JUST (`s 210(9) penalty` OF 5000, 12, FALSE, FALSE)
-- no default: no penalty stated for a person the subsection does not make guilty
#ASSERT `Under section 211(5), what is the most I may be sentenced to on conviction` FALSE TRUE sgdseat_pos_director FALSE FALSE EQUALS NOTHING
#ASSERT `Under section 211(5), what is the most I may be sentenced to on conviction` TRUE FALSE sgdseat_pos_director FALSE FALSE EQUALS NOTHING


