#ASSERT `Under section 205C(7), is the company in default of the duty to attach a copy of the accounts to the return` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 205C(7), is the company in default of the duty to attach a copy of the accounts to the return` TRUE FALSE FALSE EQUALS JUST FALSE
