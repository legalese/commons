-- Under section 212(5), is the thing within the word "property"?
#ASSERT `Under section 212(5), is the thing within the word "property"` TRUE EQUALS JUST TRUE
#ASSERT `Under section 212(5), is the thing within the word "property"` FALSE EQUALS NOTHING

-- Under section 212(6), is the body a "company" for the purposes of section 212?
#ASSERT `Under section 212(6), is the body a "company" for the purposes of section 212` TRUE EQUALS JUST TRUE
#ASSERT `Under section 212(6), is the body a "company" for the purposes of section 212` FALSE EQUALS JUST FALSE


§§ `Section 215: the compulsory acquisition of the shares of dissenting shareholders`

-- Under section 215(1), has the scheme or contract been approved by the holders of at least 90% of the shares within 4 months of the offer?
-- Arguments: what the scheme involves; shares in issue (treasury included); held as treasury; issued after the offer (not on an option); relevant treasury shares that ceased; already held by the transferee; shares counted whose holders approved; day of offer; day of approval.
-- an offer made on 1 January 2026: 4 months after it ends on 1 May 2026; the window opens the day after the offer
#ASSERT `Under section 215(1), has the scheme or contract been approved by the holders of at least 90% of the shares within 4 months of the offer` sgdseat_inv_all 1000 0 0 0 0 900 (Date 1 1 2026) (Date 1 5 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(1), has the scheme or contract been approved by the holders of at least 90% of the shares within 4 months of the offer` sgdseat_inv_all 1000 0 0 0 0 900 (Date 1 1 2026) (Date 2 5 2026) EQUALS JUST FALSE
#ASSERT `Under section 215(1), has the scheme or contract been approved by the holders of at least 90% of the shares within 4 months of the offer` sgdseat_inv_all 1000 0 0 0 0 900 (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST FALSE
-- 900 of 1,000 is exactly 90%; 899 is less
#ASSERT `Under section 215(1), has the scheme or contract been approved by the holders of at least 90% of the shares within 4 months of the offer` sgdseat_inv_all 1000 0 0 0 0 899 (Date 1 1 2026) (Date 1 5 2026) EQUALS JUST FALSE
-- treasury shares are left out of the total: 810 of 900 is 90%, 809 is not
#ASSERT `Under section 215(1), has the scheme or contract been approved by the holders of at least 90% of the shares within 4 months of the offer` sgdseat_inv_all 1000 100 0 0 0 810 (Date 1 1 2026) (Date 1 5 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(1), has the scheme or contract been approved by the holders of at least 90% of the shares within 4 months of the offer` sgdseat_inv_all 1000 100 0 0 0 809 (Date 1 1 2026) (Date 1 5 2026) EQUALS JUST FALSE
-- the class limb also leaves out the shares the transferee already held (fork F-215-2): 630 of 700 is 90%, 630 of 800 is not
#ASSERT `Under section 215(1), has the scheme or contract been approved by the holders of at least 90% of the shares within 4 months of the offer` sgdseat_inv_class 1000 100 50 50 100 630 (Date 1 1 2026) (Date 1 5 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(1), has the scheme or contract been approved by the holders of at least 90% of the shares within 4 months of the offer` sgdseat_inv_all 1000 100 50 50 100 630 (Date 1 1 2026) (Date 1 5 2026) EQUALS JUST FALSE
-- a transfer of only some of the shares is outside the subsection
#ASSERT `Under section 215(1), has the scheme or contract been approved by the holders of at least 90% of the shares within 4 months of the offer` sgdseat_inv_some 1000 0 0 0 0 900 (Date 1 1 2026) (Date 1 5 2026) EQUALS JUST FALSE

-- Under section 215(1), may the transferee give me notice that it desires to acquire my shares?
-- Approved on 1 May 2026: 2 months after ends on 1 July 2026. Arguments: the approval is as (1) requires, the day approved, the day of the notice, dissenting, in the prescribed manner.
#ASSERT `Under section 215(1), may the transferee give me notice that it desires to acquire my shares` TRUE (Date 1 5 2026) (Date 1 7 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 215(1), may the transferee give me notice that it desires to acquire my shares` TRUE (Date 1 5 2026) (Date 2 5 2026) TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 215(1), may the transferee give me notice that it desires to acquire my shares` TRUE (Date 1 5 2026) (Date 2 7 2026) TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(1), may the transferee give me notice that it desires to acquire my shares` TRUE (Date 1 5 2026) (Date 1 5 2026) TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(1), may the transferee give me notice that it desires to acquire my shares` FALSE (Date 1 5 2026) (Date 1 6 2026) TRUE TRUE EQUALS JUST FALSE
-- not a dissenting shareholder: outside the grant
#ASSERT `Under section 215(1), may the transferee give me notice that it desires to acquire my shares` TRUE (Date 1 5 2026) (Date 1 6 2026) FALSE TRUE EQUALS NOTHING
-- not in the prescribed manner: points outside the sources
#ASSERT `Under section 215(1), may the transferee give me notice that it desires to acquire my shares` TRUE (Date 1 5 2026) (Date 1 6 2026) TRUE FALSE EQUALS NOTHING
-- the period is tested before the person: a late notice to a person who is not dissenting is JUST FALSE
#ASSERT `Under section 215(1), may the transferee give me notice that it desires to acquire my shares` TRUE (Date 1 5 2026) (Date 2 7 2026) FALSE TRUE EQUALS JUST FALSE

-- Under section 215(1), what is the last day on which I may apply to the Court?
-- Arguments: the day the transferee gave the notice; I was supplied with the statement; the day it was supplied.
-- one month from 31 January 2026 ends on 28 February 2026 (the month has no 31st; keel convention P4)
#ASSERT `Under section 215(1), what is the last day on which I may apply to the Court` (Date 31 1 2026) FALSE (Date 1 1 2000) EQUALS (Date 28 2 2026)
-- "whichever is the later": 14 days from a statement supplied on 20 February 2026 end on 6 March 2026, later than 28 February
#ASSERT `Under section 215(1), what is the last day on which I may apply to the Court` (Date 31 1 2026) TRUE (Date 20 2 2026) EQUALS (Date 6 3 2026)
-- a statement supplied on 1 February: 14 days end on 15 February, earlier than 28 February
#ASSERT `Under section 215(1), what is the last day on which I may apply to the Court` (Date 31 1 2026) TRUE (Date 1 2 2026) EQUALS (Date 28 2 2026)

-- Under section 215(1), is my application to the Court within the time the subsection allows?
-- Arguments: the day of the notice; I was supplied with the statement; the day it was supplied; the day I applied.
#ASSERT `Under section 215(1), is my application to the Court within the time the subsection allows` (Date 31 1 2026) FALSE (Date 1 1 2000) (Date 28 2 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(1), is my application to the Court within the time the subsection allows` (Date 31 1 2026) FALSE (Date 1 1 2000) (Date 1 3 2026) EQUALS JUST FALSE
#ASSERT `Under section 215(1), is my application to the Court within the time the subsection allows` (Date 31 1 2026) TRUE (Date 20 2 2026) (Date 6 3 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(1), is my application to the Court within the time the subsection allows` (Date 31 1 2026) TRUE (Date 20 2 2026) (Date 7 3 2026) EQUALS JUST FALSE

-- Under section 215(1), may the Court order that the transferee is not entitled and bound to acquire my shares?
-- Arguments of the Court's power: the shareholder has applied, the application is in time, the Court thinks fit.
#ASSERT `Under section 215(1), may the Court order that the transferee is not entitled and bound to acquire my shares` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(1), may the Court order that the transferee is not entitled and bound to acquire my shares` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(1), may the Court order that the transferee is not entitled and bound to acquire my shares` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 215(1), may the Court order that the transferee is not entitled and bound to acquire my shares` TRUE TRUE FALSE EQUALS NOTHING

-- Under section 215(1), is the transferee entitled and bound to acquire my shares?
-- Arguments of the entitlement: the notice was given, the application was in time, the Court thought fit to order otherwise.
#ASSERT `Under section 215(1), is the transferee entitled and bound to acquire my shares` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 215(1), is the transferee entitled and bound to acquire my shares` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(1), is the transferee entitled and bound to acquire my shares` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 215(1), is the transferee entitled and bound to acquire my shares` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 215(1), is the transferee entitled and bound to acquire my shares` TRUE FALSE FALSE EQUALS JUST TRUE

-- Under section 215(1), on what terms must the transferee acquire my shares?
-- the terms: one set of terms; alternatives elected in time; alternatives and no election in time
#ASSERT `Under section 215(1), on what terms must the transferee acquire my shares` FALSE FALSE EQUALS `s 215(1) the terms on which the shares of the approving shareholders are to be transferred to the transferee`
#ASSERT `Under section 215(1), on what terms must the transferee acquire my shares` FALSE TRUE EQUALS `s 215(1) the terms on which the shares of the approving shareholders are to be transferred to the transferee`
#ASSERT `Under section 215(1), on what terms must the transferee acquire my shares` TRUE TRUE EQUALS `s 215(1A) the terms the dissenting shareholder has elected`
#ASSERT `Under section 215(1), on what terms must the transferee acquire my shares` TRUE FALSE EQUALS `s 215(1B) the terms the offer stated are to apply where the dissenting shareholder fails to elect in time`

-- Under section 215(1A), am I entitled to elect which of the terms I prefer?
-- Arguments: the offer contained alternative terms; the day of the notice; I was supplied with the statement; the day it was supplied; the day I elected.
-- "Where alternative terms were offered": none offered, no entitlement
#ASSERT `Under section 215(1A), am I entitled to elect which of the terms I prefer` FALSE (Date 31 1 2026) FALSE (Date 1 1 2000) (Date 1 2 2026) EQUALS JUST FALSE
-- not later than the end of one month after the notice (28 February), or 14 days after a statement, whichever is later
#ASSERT `Under section 215(1A), am I entitled to elect which of the terms I prefer` TRUE (Date 31 1 2026) FALSE (Date 1 1 2000) (Date 28 2 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(1A), am I entitled to elect which of the terms I prefer` TRUE (Date 31 1 2026) FALSE (Date 1 1 2000) (Date 1 3 2026) EQUALS JUST FALSE
#ASSERT `Under section 215(1A), am I entitled to elect which of the terms I prefer` TRUE (Date 31 1 2026) TRUE (Date 20 2 2026) (Date 6 3 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(1A), am I entitled to elect which of the terms I prefer` TRUE (Date 31 1 2026) TRUE (Date 20 2 2026) (Date 7 3 2026) EQUALS JUST FALSE

-- Under section 215(1B), has the transferee stated which of the terms is to apply if I fail to elect in time?
-- (1B): the offer contains alternative terms, the offer states which applies on a failure to elect
#ASSERT `Under section 215(1B), has the transferee stated which of the terms is to apply if I fail to elect in time` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(1B), has the transferee stated which of the terms is to apply if I fail to elect in time` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 215(1B), has the transferee stated which of the terms is to apply if I fail to elect in time` TRUE FALSE EQUALS JUST FALSE

-- Under section 215(1C)(a), are the shares to be disregarded in counting the 90%?
-- (1C)(a): issued after the date of the offer; issued pursuant to an option or convertible security
#ASSERT `Under section 215(1C)(a), are the shares to be disregarded in counting the 90%` FALSE FALSE EQUALS NOTHING
#ASSERT `Under section 215(1C)(a), are the shares to be disregarded in counting the 90%` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 215(1C)(a), are the shares to be disregarded in counting the 90%` TRUE TRUE EQUALS JUST FALSE

-- Under section 215(1D), are the shares relevant treasury shares?
-- (1D): held as treasury shares on the date of the offer; became treasury shares after the offer; before the date specified in the terms
#ASSERT `Under section 215(1D), are the shares relevant treasury shares` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 215(1D), are the shares relevant treasury shares` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 215(1D), are the shares relevant treasury shares` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 215(1D), are the shares relevant treasury shares` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(1D), are the shares relevant treasury shares` FALSE FALSE FALSE EQUALS JUST FALSE

-- Under section 215(1C)(b), are the shares to be disregarded because they have ceased to be held as treasury shares?
-- (1C)(b): relevant treasury shares; they cease to be held as treasury shares after the date of the offer
#ASSERT `Under section 215(1C)(b), are the shares to be disregarded because they have ceased to be held as treasury shares` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 215(1C)(b), are the shares to be disregarded because they have ceased to be held as treasury shares` TRUE FALSE EQUALS NOTHING
#ASSERT `Under section 215(1C)(b), are the shares to be disregarded because they have ceased to be held as treasury shares` FALSE TRUE EQUALS NOTHING

-- Under section 215(1E), does a later issue of shares on the exercise of an option affect the approval, the transferee's right to give notice or the notice's validity?
-- (1E): the requisite percentage was reached; a later issue pursuant to an option; the matter
#ASSERT `Under section 215(1E), does a later issue of shares on the exercise of an option affect the approval, the transferee's right to give notice or the notice's validity` TRUE TRUE `s 215(1E)(a) the approval` EQUALS JUST FALSE
#ASSERT `Under section 215(1E), does a later issue of shares on the exercise of an option affect the approval, the transferee's right to give notice or the notice's validity` TRUE TRUE `s 215(1E)(b) the transferee's right to give a notice mentioned in subsection (1) after the approval` EQUALS JUST FALSE
#ASSERT `Under section 215(1E), does a later issue of shares on the exercise of an option affect the approval, the transferee's right to give notice or the notice's validity` TRUE TRUE `s 215(1E)(c) the validity of any such notice` EQUALS JUST FALSE
#ASSERT `Under section 215(1E), does a later issue of shares on the exercise of an option affect the approval, the transferee's right to give notice or the notice's validity` TRUE TRUE `s 215(1E) some other matter` EQUALS NOTHING
#ASSERT `Under section 215(1E), does a later issue of shares on the exercise of an option affect the approval, the transferee's right to give notice or the notice's validity` FALSE TRUE `s 215(1E)(a) the approval` EQUALS NOTHING
#ASSERT `Under section 215(1E), does a later issue of shares on the exercise of an option affect the approval, the transferee's right to give notice or the notice's validity` TRUE FALSE `s 215(1E)(a) the approval` EQUALS NOTHING


§§ `Section 215(2): the statement of the other dissenting shareholders`

-- Under section 215(2), am I entitled to require the transferor company to supply the statement of the other dissenting shareholders?
-- Notice given on 10 March 2026: one month from it ends on 10 April 2026. Arguments: the notice was given, the day of it, the day the written demand was served.
#ASSERT `Under section 215(2), am I entitled to require the transferor company to supply the statement of the other dissenting shareholders` FALSE (Date 10 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
#ASSERT `Under section 215(2), am I entitled to require the transferor company to supply the statement of the other dissenting shareholders` TRUE (Date 10 3 2026) (Date 10 4 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(2), am I entitled to require the transferor company to supply the statement of the other dissenting shareholders` TRUE (Date 10 3 2026) (Date 11 4 2026) EQUALS JUST FALSE
#ASSERT `Under section 215(2), am I entitled to require the transferor company to supply the statement of the other dissenting shareholders` TRUE (Date 10 3 2026) (Date 10 3 2026) EQUALS JUST TRUE

-- Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago?
-- Arguments: the transferee has given the notice; I served a written demand; the statement was posted to me; the day it was posted; the day I ask about.
-- no notice given: the subsection's "where" is not met
#ASSERT `Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago` FALSE TRUE TRUE (Date 10 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
-- notice given but no demand made: the subsection says nothing of that case
#ASSERT `Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago` TRUE FALSE FALSE (Date 1 1 2000) (Date 20 3 2026) EQUALS NOTHING
-- demanded, the statement not yet posted: the transferee is not yet entitled or bound
#ASSERT `Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago` TRUE TRUE FALSE (Date 1 1 2000) (Date 20 3 2026) EQUALS JUST TRUE
-- posted on 10 March 2026: "until 14 days after the posting" ends on 24 March; on 25 March the bar is lifted
#ASSERT `Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago` TRUE TRUE TRUE (Date 10 3 2026) (Date 24 3 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago` TRUE TRUE TRUE (Date 10 3 2026) (Date 25 3 2026) EQUALS JUST FALSE
#ASSERT `Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago` TRUE TRUE TRUE (Date 10 3 2026) (Date 10 3 2026) EQUALS JUST TRUE


§§ `Section 215(3) and (3A): the 90% reached by the transfers; the holder's right to require acquisition`

-- Under section 215(3), do the shares transferred, together with the other shares the transferee holds, comprise or include 90%?
-- Arguments: total shares (treasury included); shares transferred; other shares the transferee held; treasury shares; the 90% is measured against a class.
-- 800 transferred + 50 held + 50 treasury (treated as acquired, (3A)) = 900 of 1,000: exactly 90%
#ASSERT `Under section 215(3), do the shares transferred, together with the other shares the transferee holds, comprise or include 90%` 1000 800 50 50 FALSE EQUALS JUST TRUE
-- measured against a class, the treasury shares are not added: 850 of 1,000 is under 90%
#ASSERT `Under section 215(3), do the shares transferred, together with the other shares the transferee holds, comprise or include 90%` 1000 800 50 50 TRUE EQUALS JUST FALSE
-- one share short: 899 of 1,000
#ASSERT `Under section 215(3), do the shares transferred, together with the other shares the transferee holds, comprise or include 90%` 1000 800 50 49 FALSE EQUALS JUST FALSE
-- no shares at all: no 90% of nothing
#ASSERT `Under section 215(3), do the shares transferred, together with the other shares the transferee holds, comprise or include 90%` 0 0 0 0 FALSE EQUALS JUST FALSE

-- Under section 215(3A), how many treasury shares are treated as acquired by the transferee?
#ASSERT `Under section 215(3A), how many treasury shares are treated as acquired by the transferee` 1000 800 50 50 FALSE EQUALS 50
#ASSERT `Under section 215(3A), how many treasury shares are treated as acquired by the transferee` 1000 800 50 50 TRUE EQUALS 0

-- Under section 215(3)(a), must the transferee give notice of the 90% to the holders of the remaining shares who have not assented?
-- (3)(a): the 90% was reached; the transferee has already complied on a previous transfer
#ASSERT `Under section 215(3)(a), must the transferee give notice of the 90% to the holders of the remaining shares who have not assented` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 215(3)(a), must the transferee give notice of the 90% to the holders of the remaining shares who have not assented` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(3)(a), must the transferee give notice of the 90% to the holders of the remaining shares who have not assented` TRUE FALSE EQUALS JUST TRUE

-- Under section 215(3)(a), was the notice of the 90% given within one month from the date of the transfer?
-- a transfer on 31 January 2026: one month from it ends on 28 February 2026 (P4)
#ASSERT `Under section 215(3)(a), was the notice of the 90% given within one month from the date of the transfer` (Date 31 1 2026) (Date 28 2 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(3)(a), was the notice of the 90% given within one month from the date of the transfer` (Date 31 1 2026) (Date 1 3 2026) EQUALS JUST FALSE
#ASSERT `Under section 215(3)(a), was the notice of the 90% given within one month from the date of the transfer` (Date 15 3 2026) (Date 15 4 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(3)(a), was the notice of the 90% given within one month from the date of the transfer` (Date 15 3 2026) (Date 16 4 2026) EQUALS JUST FALSE

-- Under section 215(3)(b), may I require the transferee to acquire my shares?
-- Arguments: the 90% is reached; I am a holder who has not assented; I was given notice of the 90%; the day I was given it; the day I required the transferee.
-- within 3 months of the notice given on 10 March 2026: up to and including 10 June 2026
#ASSERT `Under section 215(3)(b), may I require the transferee to acquire my shares` TRUE TRUE TRUE (Date 10 3 2026) (Date 10 6 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(3)(b), may I require the transferee to acquire my shares` TRUE TRUE TRUE (Date 10 3 2026) (Date 11 6 2026) EQUALS JUST FALSE
-- the 90% is not reached: the text's "where" is not met
#ASSERT `Under section 215(3)(b), may I require the transferee to acquire my shares` FALSE TRUE TRUE (Date 10 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
-- a holder who did assent, or who was never given the notice: the grant does not reach the case
#ASSERT `Under section 215(3)(b), may I require the transferee to acquire my shares` TRUE FALSE TRUE (Date 10 3 2026) (Date 20 3 2026) EQUALS NOTHING
#ASSERT `Under section 215(3)(b), may I require the transferee to acquire my shares` TRUE TRUE FALSE (Date 1 1 2000) (Date 20 3 2026) EQUALS NOTHING

-- Under section 215(3), is the transferee entitled and bound to acquire my shares?
-- (3): once the shareholder gives notice under (b), entitled and bound; the terms
#ASSERT `Under section 215(3), is the transferee entitled and bound to acquire my shares` TRUE EQUALS JUST TRUE
#ASSERT `Under section 215(3), is the transferee entitled and bound to acquire my shares` FALSE EQUALS JUST FALSE

-- Under section 215(3), on what terms must the transferee acquire my shares?
#ASSERT `Under section 215(3), on what terms must the transferee acquire my shares` TRUE TRUE EQUALS NOTHING
#ASSERT `Under section 215(3), on what terms must the transferee acquire my shares` FALSE TRUE EQUALS JUST `s 215(3) such other terms as the Court thinks fit to order`
#ASSERT `Under section 215(3), on what terms must the transferee acquire my shares` TRUE FALSE EQUALS JUST `s 215(3) such other terms as are agreed`
#ASSERT `Under section 215(3), on what terms must the transferee acquire my shares` FALSE FALSE EQUALS JUST `s 215(3) the terms on which under the scheme or contract the shares of the approving shareholders were transferred to the transferee`


§§ `Section 215(4) to (7): the transfer, the trust, the Official Receiver`

-- Under section 215(4), must the transferee transmit a copy of the notice and pay, allot or transfer the consideration to the transferor company?
-- Arguments: a notice has been given under (1); the Court has ordered to the contrary.
#ASSERT `Under section 215(4), must the transferee transmit a copy of the notice and pay, allot or transfer the consideration to the transferor company` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 215(4), must the transferee transmit a copy of the notice and pay, allot or transfer the consideration to the transferor company` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(4), must the transferee transmit a copy of the notice and pay, allot or transfer the consideration to the transferor company` FALSE FALSE EQUALS JUST FALSE

-- Under section 215(4), on what day must the transferee first act?
-- Arguments: the day of the notice; I was supplied with the statement; the day; an application to the Court is pending; it was disposed of; the day.
-- no statement, no application: the day after one month from 10 March 2026 (10 April), so 11 April
#ASSERT `Under section 215(4), on what day must the transferee first act` (Date 10 3 2026) FALSE (Date 1 1 2000) FALSE FALSE (Date 1 1 2000) EQUALS JUST (Date 11 4 2026)
-- a statement supplied on 5 April: 14 days end on 19 April, later than 10 April, so 20 April
#ASSERT `Under section 215(4), on what day must the transferee first act` (Date 10 3 2026) TRUE (Date 5 4 2026) FALSE FALSE (Date 1 1 2000) EQUALS JUST (Date 20 4 2026)
-- an application still pending: the day cannot yet be named
#ASSERT `Under section 215(4), on what day must the transferee first act` (Date 10 3 2026) FALSE (Date 1 1 2000) TRUE FALSE (Date 1 1 2000) EQUALS NOTHING
-- the application disposed of on 25 April, after the later period: the day after, 26 April
#ASSERT `Under section 215(4), on what day must the transferee first act` (Date 10 3 2026) TRUE (Date 5 4 2026) TRUE TRUE (Date 25 4 2026) EQUALS JUST (Date 26 4 2026)
-- disposed of on 15 April, within the period: the day after the period ends, 20 April
#ASSERT `Under section 215(4), on what day must the transferee first act` (Date 10 3 2026) TRUE (Date 5 4 2026) TRUE TRUE (Date 15 4 2026) EQUALS JUST (Date 20 4 2026)

-- Under section 215(5), has the transferor company paid the sums it received into a separate bank account?
#ASSERT `Under section 215(5), has the transferor company paid the sums it received into a separate bank account` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 215(5), has the transferor company paid the sums it received into a separate bank account` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(5), has the transferor company paid the sums it received into a separate bank account` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 215(5), has the transferor company paid the sums it received into a separate bank account` TRUE FALSE EQUALS JUST FALSE

-- Under section 215(6), was what is held in trust transferred to the Official Receiver within the time the subsection allows?
-- (6): received on 1 March 2020: the last day of the 2 years is 1 March 2022; of the 10 years, 1 March 2030 (P1, P4)
#ASSERT `Under section 215(6), was what is held in trust transferred to the Official Receiver within the time the subsection allows` TRUE (Date 1 3 2020) (Date 1 3 2022) EQUALS JUST FALSE
#ASSERT `Under section 215(6), was what is held in trust transferred to the Official Receiver within the time the subsection allows` TRUE (Date 1 3 2020) (Date 2 3 2022) EQUALS JUST TRUE
#ASSERT `Under section 215(6), was what is held in trust transferred to the Official Receiver within the time the subsection allows` TRUE (Date 1 3 2020) (Date 1 3 2030) EQUALS JUST TRUE
#ASSERT `Under section 215(6), was what is held in trust transferred to the Official Receiver within the time the subsection allows` TRUE (Date 1 3 2020) (Date 2 3 2030) EQUALS JUST FALSE
#ASSERT `Under section 215(6), was what is held in trust transferred to the Official Receiver within the time the subsection allows` FALSE (Date 1 3 2020) (Date 2 3 2025) EQUALS JUST FALSE

-- Under section 215(7), how is what has been transferred to the Official Receiver dealt with?
#ASSERT `Under section 215(7), how is what has been transferred to the Official Receiver dealt with` TRUE FALSE EQUALS JUST `s 215(7)(a) dealt with as if the moneys were paid to the Official Receiver under section 197 of the Insolvency, Restructuring and Dissolution Act 2018`
#ASSERT `Under section 215(7), how is what has been transferred to the Official Receiver dealt with` FALSE TRUE EQUALS JUST `s 215(7)(b) sold or disposed of in the manner the Official Receiver thinks fit, the proceeds dealt with as if moneys paid under section 197 of that Act`
#ASSERT `Under section 215(7), how is what has been transferred to the Official Receiver dealt with` FALSE FALSE EQUALS NOTHING


§§ `Section 215(8) to (12): the words defined and who is treated as holding or acquiring`

-- Under section 215(8), am I a dissenting shareholder?
#ASSERT `Under section 215(8), am I a dissenting shareholder` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 215(8), am I a dissenting shareholder` FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 215(8), am I a dissenting shareholder` FALSE FALSE EQUALS NOTHING

-- Under section 215(8A), am I within the reference to a shareholder in subsection (8)?
#ASSERT `Under section 215(8A), am I within the reference to a shareholder in subsection (8)` TRUE EQUALS JUST TRUE
