§ `Part 4 Division 8: the registration of charges`

§§ `Section 131: registration of a charge created by a company`

-- Under section 131(3): is the charge one to which section 131 applies.
#ASSERT `Under section 131(3), is the charge one to which section 131 applies` TRUE (Date 1 3 2026) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE      -- a charge securing debentures, created on 1 March 2026
#ASSERT `Under section 131(3), is the charge one to which section 131 applies` TRUE (Date 1 3 2026) FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE      -- a charge on land
#ASSERT `Under section 131(3), is the charge one to which section 131 applies` TRUE (Date 1 3 2026) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING      -- no listed head: the list is not closed
#ASSERT `Under section 131(3), is the charge one to which section 131 applies` TRUE (Date 1 3 2026) FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING      -- a rent charge on land is outside paragraph (e), and no other head holds
#ASSERT `Under section 131(3), is the charge one to which section 131 applies` FALSE (Date 1 3 2026) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING      -- not created by a company
#ASSERT `Under section 131(3), is the charge one to which section 131 applies` TRUE (Date 1 3 2026) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE      -- capable of registration under the aircraft Act (s 131(3B))
#ASSERT `Under section 131(3), is the charge one to which section 131 applies` TRUE (Date 1 10 2018) FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE      -- a shipowner's lien created on 1 October 2018 (s 131(3AB))
#ASSERT `Under section 131(3), is the charge one to which section 131 applies` TRUE (Date 30 9 2018) FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE      -- a lien created before 1 October 2018 after a winding up order (s 131(3AC)(a))
#ASSERT `Under section 131(3), is the charge one to which section 131 applies` TRUE (Date 1 6 2015) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE      -- a charge created in 2015 that section 131 covered under the old subsection (3) (s 131(3AA))

-- Under section 131(1): must a statement of the charge be lodged with the Registrar.
#ASSERT `Under section 131(1), must a statement of the charge be lodged with the Registrar` TRUE (Date 1 3 2026) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE      -- a debenture charge
#ASSERT `Under section 131(1), must a statement of the charge be lodged with the Registrar` TRUE (Date 1 10 2018) FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE      -- section 131 does not apply to the lien
#ASSERT `Under section 131(1), must a statement of the charge be lodged with the Registrar` TRUE (Date 1 3 2026) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING      -- the text does not say whether the section applies

-- Under section 131(1): was the statement lodged within 30 days after the creation of the charge.
#ASSERT `Under section 131(1), was the statement lodged within 30 days after the creation of the charge` (Date 1 6 2020) (Date 1 7 2020) FALSE 0 EQUALS TRUE      -- the 30th day
#ASSERT `Under section 131(1), was the statement lodged within 30 days after the creation of the charge` (Date 1 6 2020) (Date 2 7 2020) FALSE 0 EQUALS FALSE      -- the 31st day
#ASSERT `Under section 131(1), was the statement lodged within 30 days after the creation of the charge` (Date 1 6 2020) (Date 8 7 2020) TRUE 0 EQUALS TRUE      -- made abroad: 37 days (s 139)
#ASSERT `Under section 131(1), was the statement lodged within 30 days after the creation of the charge` (Date 1 6 2020) (Date 11 7 2020) TRUE 3 EQUALS TRUE      -- made abroad with 3 further days allowed: 40 days

-- Under section 131(1): is the security the charge confers void against the liquidator and any creditor of the company.
#ASSERT `Under section 131(1), is the security the charge confers void against the liquidator and any creditor of the company` TRUE (Date 1 6 2020) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE (Date 1 6 2020) FALSE 0 FALSE (Date 1 6 2020) EQUALS JUST TRUE      -- never lodged
#ASSERT `Under section 131(1), is the security the charge confers void against the liquidator and any creditor of the company` TRUE (Date 1 6 2020) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE (Date 1 7 2020) FALSE 0 FALSE (Date 1 6 2020) EQUALS JUST FALSE      -- lodged on the 30th day
#ASSERT `Under section 131(1), is the security the charge confers void against the liquidator and any creditor of the company` TRUE (Date 1 6 2020) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE (Date 2 7 2020) FALSE 0 FALSE (Date 1 6 2020) EQUALS JUST TRUE      -- lodged on the 31st day
#ASSERT `Under section 131(1), is the security the charge confers void against the liquidator and any creditor of the company` TRUE (Date 1 6 2020) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE (Date 20 7 2020) FALSE 0 TRUE (Date 20 7 2020) EQUALS JUST FALSE      -- late, but the Court extended the time to that day
#ASSERT `Under section 131(1), is the security the charge confers void against the liquidator and any creditor of the company` TRUE (Date 1 10 2018) FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE (Date 1 6 2020) FALSE 0 FALSE (Date 1 6 2020) EQUALS JUST FALSE      -- section 131 does not apply to the lien
#ASSERT `Under section 131(1), is the security the charge confers void against the liquidator and any creditor of the company` TRUE (Date 1 3 2026) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE (Date 1 6 2020) FALSE 0 FALSE (Date 1 6 2020) EQUALS NOTHING      -- the text does not say whether the section applies

-- Under section 131(1A): must the instrument or a certified true copy be produced to the Registrar.
#ASSERT `Under section 131(1A), must the instrument or a certified true copy be produced to the Registrar` TRUE (Date 1 3 2026) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS JUST TRUE      -- asked by the Registrar
#ASSERT `Under section 131(1A), must the instrument or a certified true copy be produced to the Registrar` TRUE (Date 1 3 2026) TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE      -- no request
#ASSERT `Under section 131(1A), must the instrument or a certified true copy be produced to the Registrar` TRUE (Date 1 3 2026) FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING      -- the text does not say whether the section applies

-- Under section 131(2): does subsection (1) affect the contract or obligation for repayment of the money secured by the charge.
#ASSERT `Under section 131(2), does subsection (1) affect the contract or obligation for repayment of the money secured by the charge` TRUE EQUALS JUST FALSE      -- "Nothing in subsection (1) affects any contract or obligation for repayment"
#ASSERT `Under section 131(2), does subsection (1) affect the contract or obligation for repayment of the money secured by the charge` FALSE EQUALS NOTHING      -- any other contract

-- Under section 131(2): does the money secured by the charge become immediately payable by force of this subsection.
#ASSERT `Under section 131(2), does the money secured by the charge become immediately payable by force of this subsection` TRUE EQUALS JUST TRUE
#ASSERT `Under section 131(2), does the money secured by the charge become immediately payable by force of this subsection` FALSE EQUALS JUST FALSE

-- Under section 131(5): is the lodging of the statement sufficient.
#ASSERT `Under section 131(5), is the lodging of the statement sufficient` TRUE (Date 1 6 2020) (Date 1 7 2020) FALSE 0 TRUE TRUE TRUE TRUE EQUALS JUST TRUE      -- all four particulars on the 30th day
#ASSERT `Under section 131(5), is the lodging of the statement sufficient` TRUE (Date 1 6 2020) (Date 2 7 2020) FALSE 0 TRUE TRUE TRUE TRUE EQUALS JUST FALSE      -- the 31st day
#ASSERT `Under section 131(5), is the lodging of the statement sufficient` TRUE (Date 1 6 2020) (Date 1 7 2020) FALSE 0 TRUE FALSE TRUE TRUE EQUALS JUST FALSE      -- the dates of the resolutions are missing
#ASSERT `Under section 131(5), is the lodging of the statement sufficient` FALSE (Date 1 6 2020) (Date 1 7 2020) FALSE 0 TRUE TRUE TRUE TRUE EQUALS JUST FALSE      -- not a series

-- Under section 131(6): were the particulars of the issue lodged within 30 days after the issue.
#ASSERT `Under section 131(6), were the particulars of the issue lodged within 30 days after the issue` (Date 1 6 2020) (Date 1 7 2020) FALSE 0 EQUALS TRUE      -- the 30th day
#ASSERT `Under section 131(6), were the particulars of the issue lodged within 30 days after the issue` (Date 1 6 2020) (Date 2 7 2020) FALSE 0 EQUALS FALSE      -- the 31st day
#ASSERT `Under section 131(6), were the particulars of the issue lodged within 30 days after the issue` (Date 1 6 2020) (Date 8 7 2020) TRUE 0 EQUALS TRUE      -- made abroad: 37 days

-- Under section 131(6): does the omission to lodge the particulars of an issue affect the validity of the debentures issued.
#ASSERT `Under section 131(6), does the omission to lodge the particulars of an issue affect the validity of the debentures issued` TRUE EQUALS JUST FALSE      -- "an omission to do so does not affect the validity of the debentures issued"
#ASSERT `Under section 131(6), does the omission to lodge the particulars of an issue affect the validity of the debentures issued` FALSE EQUALS NOTHING      -- no omission

-- Under section 131(10): is the subsequent charge not operative and without validity as respects the property comprised in the prior charge.
#ASSERT `Under section 131(10), is the subsequent charge not operative and without validity as respects the property comprised in the prior charge` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE      -- all four limbs, nothing proved to the Court
#ASSERT `Under section 131(10), is the subsequent charge not operative and without validity as respects the property comprised in the prior charge` TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE      -- "unless it is proved to the satisfaction of the Court"
#ASSERT `Under section 131(10), is the subsequent charge not operative and without validity as respects the property comprised in the prior charge` TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE      -- created after the 30 days

§§ `Section 132: default, and who may lodge`

-- Under section 132(1): may I lodge the documents and particulars for registration.
#ASSERT `Under section 132(1), may I lodge the documents and particulars for registration` TRUE FALSE EQUALS JUST TRUE      -- the company
#ASSERT `Under section 132(1), may I lodge the documents and particulars for registration` FALSE TRUE EQUALS JUST TRUE      -- a person interested
#ASSERT `Under section 132(1), may I lodge the documents and particulars for registration` FALSE FALSE EQUALS NOTHING      -- anyone else

-- Under section 132(1): am I guilty of the offence of default in complying with section 131.
#ASSERT `Under section 132(1), am I guilty of the offence of default in complying with section 131` TRUE TRUE EQUALS JUST TRUE      -- an officer in default
#ASSERT `Under section 132(1), am I guilty of the offence of default in complying with section 131` TRUE FALSE EQUALS JUST FALSE      -- not an officer in default (split site (i))
#ASSERT `Under section 132(1), am I guilty of the offence of default in complying with section 131` FALSE TRUE EQUALS JUST FALSE      -- no default

-- Under section 132(1): what is the most I can be fined for default in complying with section 131, in Singapore dollars.
#ASSERT `Under section 132(1), what is the most I can be fined for default in complying with section 131, in Singapore dollars` TRUE TRUE EQUALS JUST 1000      -- "a fine not exceeding $1,000" and a default penalty
#ASSERT `Under section 132(1), what is the most I can be fined for default in complying with section 131, in Singapore dollars` FALSE TRUE EQUALS NOTHING      -- no default

-- Under section 132(2): am I entitled to recover the fees from the company.
#ASSERT `Under section 132(2), am I entitled to recover the fees from the company` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 132(2), am I entitled to recover the fees from the company` FALSE TRUE EQUALS JUST FALSE      -- the company registered it
#ASSERT `Under section 132(2), am I entitled to recover the fees from the company` TRUE FALSE EQUALS JUST FALSE      -- no fees paid

-- Under section 132(2): how much may I recover from the company, in Singapore dollars.
#ASSERT `Under section 132(2), how much may I recover from the company, in Singapore dollars` TRUE 250 EQUALS JUST 250
#ASSERT `Under section 132(2), how much may I recover from the company, in Singapore dollars` FALSE 250 EQUALS NOTHING

