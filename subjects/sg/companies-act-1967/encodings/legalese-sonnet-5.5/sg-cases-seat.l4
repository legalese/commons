#ASSERT `Under section 201C(1), is it the case that the directors of a private company need not lay financial statements before the company at its annual general meeting` FALSE TRUE EQUALS NOTHING
#ASSERT `Under section 201C(1), is it the case that the directors of a private company need not lay financial statements before the company at its annual general meeting` TRUE TRUE EQUALS JUST TRUE
-- the company must hold an annual general meeting: the "if" fails
#ASSERT `Under section 201C(1), is it the case that the directors of a private company need not lay financial statements before the company at its annual general meeting` TRUE FALSE EQUALS JUST FALSE

-- Under section 201C(2), is the reference in section 207(1) read as a reference to the documents sent under section 203(1)?
#ASSERT `Under section 201C(2), is the reference in section 207(1) read as a reference to the documents sent under section 203(1)` TRUE EQUALS JUST TRUE
-- the statements were laid after all: the "where" fails
#ASSERT `Under section 201C(2), is the reference in section 207(1) read as a reference to the documents sent under section 203(1)` FALSE EQUALS JUST FALSE

