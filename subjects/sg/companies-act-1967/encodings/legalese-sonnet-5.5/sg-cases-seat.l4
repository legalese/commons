#ASSERT `Under section 215(4), must the transferee transmit a copy of the notice and pay, allot or transfer the consideration to the transferor company` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(4), must the transferee transmit a copy of the notice and pay, allot or transfer the consideration to the transferor company` FALSE FALSE EQUALS JUST FALSE

