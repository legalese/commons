#ASSERT `Under section 63C, is the private company late in lodging the notice of the increase in the total amount paid up` FALSE TRUE TRUE (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 1 6 2026) EQUALS JUST FALSE
§ `Sections 64 to 68: the rights attaching to shares`

-- A member, director or person dealing with the company asks about the rights its shares carry.

-- a share in a company confers one vote on a poll and nothing displaces it
#ASSERT `Under section 64(1), does the share confer on me, as its holder, the right to one vote on a poll on the resolution` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- the constitution has negated the right, as subsection (3) lets it
#ASSERT `Under section 64(1), does the share confer on me, as its holder, the right to one vote on a poll on the resolution` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- section 21, section 76J or a written law to the contrary decides: the text defers
#ASSERT `Under section 64(1), does the share confer on me, as its holder, the right to one vote on a poll on the resolution` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- the constitution so provides and my calls are unpaid: I am not entitled to vote
#ASSERT `Under section 64(2), am I, as a member, not entitled to vote by reason of the constitution's provision` TRUE FALSE EQUALS JUST TRUE
-- the constitution so provides but I have paid all calls
#ASSERT `Under section 64(2), am I, as a member, not entitled to vote by reason of the constitution's provision` TRUE TRUE EQUALS JUST FALSE
-- the constitution has no such provision: the subsection says nothing
#ASSERT `Under section 64(2), am I, as a member, not entitled to vote by reason of the constitution's provision` FALSE FALSE EQUALS NOTHING
-- the constitution negates the right and the right is not protected
#ASSERT `Under section 64(3), may the constitution negate, alter or add to the right to one vote on a poll` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- subsection (4) protects the right: it may not be negated or altered
#ASSERT `Under section 64(3), may the constitution negate, alter or add to the right to one vote on a poll` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- the constitution provides for the classes and sets out each class's rights
#ASSERT `Under section 64A(1), may different classes of shares in the public company be issued` TRUE TRUE TRUE EQUALS JUST TRUE
-- "only if": the rights are not set out
#ASSERT `Under section 64A(1), may different classes of shares in the public company be issued` TRUE TRUE FALSE EQUALS JUST FALSE
-- a private company is not covered by the subsection
#ASSERT `Under section 64A(1), may different classes of shares in the public company be issued` FALSE TRUE TRUE EQUALS NOTHING
-- special voting rights without a special resolution of the members: barred
#ASSERT `Under section 64A(3), is the public company barred from the issuance of shares with special, limited or conditional voting rights, or no voting rights` TRUE TRUE FALSE EQUALS JUST TRUE
-- approved by special resolution
#ASSERT `Under section 64A(3), is the public company barred from the issuance of shares with special, limited or conditional voting rights, or no voting rights` TRUE TRUE TRUE EQUALS JUST FALSE
-- ordinary voting rights: not covered
#ASSERT `Under section 64A(3), is the public company barred from the issuance of shares with special, limited or conditional voting rights, or no voting rights` TRUE FALSE FALSE EQUALS NOTHING
-- the public company has such a class and the notice does not specify the rights: falls short
#ASSERT `Under section 64A(4), does the notice of the general meeting fall short of what the subsection requires` TRUE TRUE FALSE EQUALS JUST TRUE
-- no such class: the "Where" gate is not met, nothing is required
#ASSERT `Under section 64A(4), does the notice of the general meeting fall short of what the subsection requires` TRUE FALSE FALSE EQUALS JUST FALSE
-- a private company may issue shares of different classes
#ASSERT `Under section 64A(6), may the private company issue shares of different classes, including shares with special, limited or conditional voting rights or no voting rights` TRUE FALSE EQUALS JUST TRUE
-- subject to its constitution, which forbids it
#ASSERT `Under section 64A(6), may the private company issue shares of different classes, including shares with special, limited or conditional voting rights or no voting rights` TRUE TRUE EQUALS JUST FALSE
-- a public company: not covered
#ASSERT `Under section 64A(6), may the private company issue shares of different classes, including shares with special, limited or conditional voting rights or no voting rights` FALSE FALSE EQUALS NOTHING
-- a warrant stating the bearer is entitled to the shares and transferable by delivery: barred
#ASSERT `Under section 66(1), is the company barred from issuing the share warrant` TRUE TRUE EQUALS JUST TRUE
-- a warrant that is not transferable by delivery: not covered
#ASSERT `Under section 66(1), is the company barred from issuing the share warrant` TRUE FALSE EQUALS NOTHING
-- a warrant issued in 1960, asked in the 2-year period after 1 July 2015
#ASSERT `Under section 66(2), am I, as the bearer, entitled to surrender the share warrant for cancellation and to have my name entered in the register of members` (Date 1 1 1960) (Date 1 1 2016) EQUALS JUST TRUE
-- after the 2-year period
#ASSERT `Under section 66(2), am I, as the bearer, entitled to surrender the share warrant for cancellation and to have my name entered in the register of members` (Date 1 1 1960) (Date 2 7 2017) EQUALS JUST FALSE
-- a warrant issued on or after 29 December 1967: not covered
#ASSERT `Under section 66(2), am I, as the bearer, entitled to surrender the share warrant for cancellation and to have my name entered in the register of members` (Date 1 1 1980) (Date 1 1 2016) EQUALS NOTHING
-- my loss came from the company entering the bearer's name without the warrant being surrendered and cancelled
#ASSERT `Under section 66(3), is the company responsible for the loss I incurred` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
-- the warrant was surrendered and cancelled: not covered
#ASSERT `Under section 66(3), is the company responsible for the loss I incurred` TRUE TRUE TRUE TRUE EQUALS NOTHING
-- expenses incurred directly in the issue of new shares
#ASSERT `Under section 67(1), may the company use its share capital to pay the expenses of issuing new shares` TRUE EQUALS JUST TRUE
-- other expenses: not covered
#ASSERT `Under section 67(1), may the company use its share capital to pay the expenses of issuing new shares` FALSE EQUALS NOTHING
-- a company with a share capital issues shares for no consideration
#ASSERT `Under section 68, may the company issue the shares for no consideration` TRUE TRUE EQUALS JUST TRUE
-- a company with no share capital: not covered
#ASSERT `Under section 68, may the company issue the shares for no consideration` FALSE TRUE EQUALS NOTHING
