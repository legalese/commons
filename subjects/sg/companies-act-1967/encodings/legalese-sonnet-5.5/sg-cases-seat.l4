#ASSERT `Under section 76(1)(a), is the acquisition one that paragraph (a) names` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 76(1)(a), is the acquisition one that paragraph (a) names` FALSE TRUE FALSE EQUALS JUST FALSE
