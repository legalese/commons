#ASSERT `Under section 15(3)(b), is no account taken of the day in applying a penalty imposed by reference to each day during which the omission continues` TRUE (Date 1 2 2026) (Date 10 2 2026) (Date 15 2 2026) EQUALS JUST TRUE   -- "no account is to be taken of any days falling within the period mentioned in subsection (4)"
#ASSERT `Under section 15(3)(b), is no account taken of the day in applying a penalty imposed by reference to each day during which the omission continues` TRUE (Date 1 2 2026) (Date 10 2 2026) (Date 25 2 2026) EQUALS JUST FALSE   -- after the period ends: a period the text fixes in its own words (periods ruling (a))
#ASSERT `Under section 15(3)(b), is no account taken of the day in applying a penalty imposed by reference to each day during which the omission continues` FALSE (Date 1 2 2026) (Date 10 2 2026) (Date 15 2 2026) EQUALS JUST FALSE   -- no notice served: a failed "Where" (periods ruling (b))

-- Under section 15(5), is the act a delivery of the document
#ASSERT `Under section 15(5), is the act a delivery of the document` `s 15(5) delivering the document` FALSE EQUALS JUST TRUE   -- "any reference to delivering a document"
#ASSERT `Under section 15(5), is the act a delivery of the document` `s 15(5) sending the document` FALSE EQUALS JUST TRUE   -- "including a reference to sending"
#ASSERT `Under section 15(5), is the act a delivery of the document` `s 15(5) forwarding the document` FALSE EQUALS JUST TRUE   -- "forwarding"
#ASSERT `Under section 15(5), is the act a delivery of the document` `s 15(5) producing the document` FALSE EQUALS JUST TRUE   -- "producing"
#ASSERT `Under section 15(5), is the act a delivery of the document` `s 15(5) giving the document` TRUE EQUALS JUST TRUE   -- "or (in the case of a notice) giving it"
#ASSERT `Under section 15(5), is the act a delivery of the document` `s 15(5) giving the document` FALSE EQUALS NOTHING   -- giving a document that is not a notice: "includes" leaves the term open
#ASSERT `Under section 15(5), is the act a delivery of the document` `s 15(5) some other act` FALSE EQUALS NOTHING   -- another act: "includes" leaves the term open

§ `Forming a company and the private company (sections 17 and 18)`

-- Under section 17(1), may I form an incorporated company
#ASSERT `Under section 17(1), may I form an incorporated company` TRUE TRUE EQUALS JUST TRUE   -- "by subscribing the person's name or their names to a constitution and complying with the requirements as to registration, form an incorporated company"
#ASSERT `Under section 17(1), may I form an incorporated company` FALSE TRUE EQUALS NOTHING   -- not subscribed: the text says nothing of forming one another way
#ASSERT `Under section 17(1), may I form an incorporated company` TRUE FALSE EQUALS NOTHING   -- requirements as to registration not complied with: the text says nothing

-- Under section 17(2), may a company be of this kind
#ASSERT `Under section 17(2), may a company be of this kind` `limited by shares` EQUALS JUST TRUE   -- "(a) a company limited by shares"
#ASSERT `Under section 17(2), may a company be of this kind` `limited by guarantee` EQUALS JUST TRUE   -- "(b) a company limited by guarantee"
#ASSERT `Under section 17(2), may a company be of this kind` `unlimited` EQUALS JUST TRUE   -- "(c) an unlimited company"
#ASSERT `Under section 17(2), may a company be of this kind` `limited by shares and by guarantee` EQUALS NOTHING   -- the list does not say "only" (list not closed)

-- Under section 17(3) and (4), is the formation of the body barred
#ASSERT `Under section 17(3) and (4), is the formation of the body barred` 21 TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- "No company, association or partnership consisting of more than 20 persons may be formed for the purpose of carrying on any business that has for its object the acquisition of gain": 21 persons
#ASSERT `Under section 17(3) and (4), is the formation of the body barred` 20 TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- exactly 20 persons: the bar is on "more than 20"; the text says nothing of 20 or fewer
#ASSERT `Under section 17(3) and (4), is the formation of the body barred` 21 FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING   -- no business for gain: the text says nothing
#ASSERT `Under section 17(3) and (4), is the formation of the body barred` 21 TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE   -- "unless it is registered as a company under this Act"
#ASSERT `Under section 17(3) and (4), is the formation of the body barred` 21 TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE   -- "or is formed pursuant to some other written law in Singapore or letters patent"
#ASSERT `Under section 17(3) and (4), is the formation of the body barred` 21 TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE   -- (4): an association or partnership formed for a qualified profession or calling: "does not apply"
#ASSERT `Under section 17(3) and (4), is the formation of the body barred` 21 TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- (4) speaks of "an association or a partnership", not a company: the bar stands for a company

-- Under section 17(5), may the company limited by guarantee with a share capital be registered under this Act
#ASSERT `Under section 17(5), may the company limited by guarantee with a share capital be registered under this Act` TRUE (Date 15 8 1984) EQUALS JUST FALSE   -- "As from 15 August 1984": the day itself is inside
#ASSERT `Under section 17(5), may the company limited by guarantee with a share capital be registered under this Act` TRUE (Date 1 1 2020) EQUALS JUST FALSE   -- after that date
#ASSERT `Under section 17(5), may the company limited by guarantee with a share capital be registered under this Act` TRUE (Date 14 8 1984) EQUALS NOTHING   -- before that date: the text says nothing
#ASSERT `Under section 17(5), may the company limited by guarantee with a share capital be registered under this Act` FALSE (Date 1 1 2020) EQUALS NOTHING   -- another kind of company: the text says nothing

-- Under section 17(6), does the prohibition in subsection (5) affect the company
#ASSERT `Under section 17(6), does the prohibition in subsection (5) affect the company` TRUE EQUALS JUST FALSE   -- "The prohibition referred to in subsection (5) does not affect a company limited by guarantee which has a share capital and is registered as such before 15 August 1984"
#ASSERT `Under section 17(6), does the prohibition in subsection (5) affect the company` FALSE EQUALS NOTHING   -- any other company: the text says nothing

-- Under section 17(6), does section 38(2) continue to apply to the company
#ASSERT `Under section 17(6), does section 38(2) continue to apply to the company` TRUE EQUALS JUST TRUE   -- "section 38(2) continues to apply to a company so registered"
#ASSERT `Under section 17(6), does section 38(2) continue to apply to the company` FALSE EQUALS NOTHING   -- any other company: the text says nothing

-- Under section 17(6), has the company elected within 2 years of 15 August 1984 to convert and re-register as the subsection requires
#ASSERT `Under section 17(6), has the company elected within 2 years of 15 August 1984 to convert and re-register as the subsection requires` TRUE (Date 15 8 1984) TRUE EQUALS JUST TRUE   -- "within 2 years of that date": the day itself is in time (fork line F-H-P2)
#ASSERT `Under section 17(6), has the company elected within 2 years of 15 August 1984 to convert and re-register as the subsection requires` TRUE (Date 15 8 1986) TRUE EQUALS JUST TRUE   -- the last day: 15 August 1984 plus 2 years
#ASSERT `Under section 17(6), has the company elected within 2 years of 15 August 1984 to convert and re-register as the subsection requires` TRUE (Date 16 8 1986) TRUE EQUALS JUST FALSE   -- one day later: a period the text fixes in its own words (periods ruling (a))
#ASSERT `Under section 17(6), has the company elected within 2 years of 15 August 1984 to convert and re-register as the subsection requires` TRUE (Date 14 8 1984) TRUE EQUALS JUST FALSE   -- before "that date": outside the period
#ASSERT `Under section 17(6), has the company elected within 2 years of 15 August 1984 to convert and re-register as the subsection requires` TRUE (Date 15 8 1985) FALSE EQUALS JUST FALSE   -- not an election to be a company limited by shares or by guarantee
#ASSERT `Under section 17(6), has the company elected within 2 years of 15 August 1984 to convert and re-register as the subsection requires` FALSE (Date 15 8 1985) TRUE EQUALS NOTHING   -- not such a company: the duty is on "any such company"

-- Under section 17(6), has the period of 2 years specified in section 17(6) expired
#ASSERT `Under section 17(6), has the period of 2 years specified in section 17(6) expired` (Date 15 8 1986) EQUALS FALSE   -- the last day of the 2 years is not yet past
#ASSERT `Under section 17(6), has the period of 2 years specified in section 17(6) expired` (Date 16 8 1986) EQUALS TRUE   -- the day after the last day
#ASSERT `Under section 17(6), has the period of 2 years specified in section 17(6) expired` (Date 1 1 1980) EQUALS FALSE   -- before the period began

-- Under section 17(7), is the conversion of the company effected
#ASSERT `Under section 17(7), is the conversion of the company effected` TRUE TRUE TRUE EQUALS JUST TRUE   -- "effected by lodging with the Registrar a special resolution ... and altering its constitution"
#ASSERT `Under section 17(7), is the conversion of the company effected` TRUE FALSE TRUE EQUALS NOTHING   -- no special resolution lodged: the text does not say "only"
#ASSERT `Under section 17(7), is the conversion of the company effected` TRUE TRUE FALSE EQUALS NOTHING   -- constitution not altered: the text does not say "only"
#ASSERT `Under section 17(7), is the conversion of the company effected` FALSE TRUE TRUE EQUALS NOTHING   -- not a company referred to in subsection (6): the text says nothing

-- Under section 17(8), what kind of company does the company become
#ASSERT `Under section 17(8), what kind of company does the company become` TRUE TRUE `limited by shares` EQUALS JUST `limited by shares`   -- "the company becomes a company limited by shares"
#ASSERT `Under section 17(8), what kind of company does the company become` TRUE TRUE `limited by guarantee` EQUALS JUST `limited by guarantee`   -- "or a company limited by guarantee, as the case may be"
#ASSERT `Under section 17(8), what kind of company does the company become` TRUE TRUE `limited by shares and by guarantee` EQUALS NOTHING   -- the text names no other result
#ASSERT `Under section 17(8), what kind of company does the company become` TRUE TRUE `unlimited` EQUALS NOTHING   -- the text names no other result
#ASSERT `Under section 17(8), what kind of company does the company become` TRUE FALSE `limited by shares` EQUALS NOTHING   -- no notice of incorporation issued: a failed "On" returns no value
#ASSERT `Under section 17(8), what kind of company does the company become` FALSE TRUE `limited by shares` EQUALS NOTHING   -- not complied with subsection (7): a failed "On" returns no value

-- Under section 17(9), must the Registrar issue to the company a certificate of confirmation of incorporation
#ASSERT `Under section 17(9), must the Registrar issue to the company a certificate of confirmation of incorporation` TRUE TRUE EQUALS JUST TRUE   -- "Upon the application of a company and payment of the prescribed fee"
#ASSERT `Under section 17(9), must the Registrar issue to the company a certificate of confirmation of incorporation` TRUE FALSE EQUALS JUST FALSE   -- fee unpaid: a duty whose "upon" gate is unmet (marginal reading (a))
#ASSERT `Under section 17(9), must the Registrar issue to the company a certificate of confirmation of incorporation` FALSE TRUE EQUALS JUST FALSE   -- no application: a duty whose "upon" gate is unmet

-- Under section 18(1)(b), how many members are counted against the limit of 50
#ASSERT `Under section 18(1)(b), how many members are counted against the limit of 50` 60 5 3 EQUALS 52   -- "not counting any person in the employment of the company or of its subsidiary or any person who while previously in the employment ... was and thereafter has continued to be a member": 60 less 5 less 3
#ASSERT `Under section 18(1)(b), how many members are counted against the limit of 50` 50 0 0 EQUALS 50   -- no one to leave out

-- Under section 18(1), may the company be incorporated as a private company
#ASSERT `Under section 18(1), may the company be incorporated as a private company` TRUE TRUE 50 EQUALS JUST TRUE   -- "limits to not more than 50 the number of its members": exactly 50
#ASSERT `Under section 18(1), may the company be incorporated as a private company` TRUE TRUE 51 EQUALS NOTHING   -- 51 is more than 50: a failed "if" gating a grant (grant ruling, limit 1)
#ASSERT `Under section 18(1), may the company be incorporated as a private company` TRUE FALSE 50 EQUALS NOTHING   -- no restriction on the transfer of shares: a failed "if" gating a grant
#ASSERT `Under section 18(1), may the company be incorporated as a private company` FALSE TRUE 50 EQUALS NOTHING   -- "A company having a share capital": the text says nothing of one with none

-- Under section 18(1), was the company incorporated as a private company by virtue of section 18
#ASSERT `Under section 18(1), was the company incorporated as a private company by virtue of section 18` TRUE TRUE 50 TRUE EQUALS TRUE   -- all conditions met
#ASSERT `Under section 18(1), was the company incorporated as a private company by virtue of section 18` TRUE TRUE 51 TRUE EQUALS FALSE   -- the constitution allows 51 members
#ASSERT `Under section 18(1), was the company incorporated as a private company by virtue of section 18` TRUE FALSE 50 TRUE EQUALS FALSE   -- no restriction on the transfer of shares
#ASSERT `Under section 18(1), was the company incorporated as a private company by virtue of section 18` FALSE TRUE 50 TRUE EQUALS FALSE   -- no share capital
#ASSERT `Under section 18(1), was the company incorporated as a private company by virtue of section 18` TRUE TRUE 50 FALSE EQUALS FALSE   -- the notice of incorporation does not state that it is a private company

-- Under section 18(2), is the constitution deemed to include the provision
#ASSERT `Under section 18(2), is the constitution deemed to include the provision` TRUE TRUE `s 18(2) a restriction on the right to transfer its shares` FALSE EQUALS JUST TRUE   -- "the constitution of the company is deemed to include each such restriction or limitation that is not so included"
#ASSERT `Under section 18(2), is the constitution deemed to include the provision` TRUE TRUE `s 18(2) a limitation on the number of its members` FALSE EQUALS JUST TRUE   -- the limitation on the number of members
#ASSERT `Under section 18(2), is the constitution deemed to include the provision` TRUE TRUE `s 18(2) a restriction on the right to transfer its shares` TRUE EQUALS NOTHING   -- already included: the text says nothing
#ASSERT `Under section 18(2), is the constitution deemed to include the provision` TRUE TRUE `s 18(2) any other provision` FALSE EQUALS NOTHING   -- not "required by subsection (1)": the text says nothing
#ASSERT `Under section 18(2), is the constitution deemed to include the provision` FALSE TRUE `s 18(2) a restriction on the right to transfer its shares` FALSE EQUALS JUST FALSE   -- not a private company by virtue of paragraph (a) on that day: a failed "Where" (periods ruling (b))
#ASSERT `Under section 18(2), is the constitution deemed to include the provision` TRUE FALSE `s 18(2) a restriction on the right to transfer its shares` FALSE EQUALS JUST FALSE   -- the constitution already contains what (1) requires: a failed "Where"

-- Under section 18(2), does the deemed restriction prohibit the transfer of shares
#ASSERT `Under section 18(2), does the deemed restriction prohibit the transfer of shares` TRUE FALSE EQUALS JUST TRUE   -- "a restriction that prohibits the transfer of shares except to a person approved by the directors of the company"
#ASSERT `Under section 18(2), does the deemed restriction prohibit the transfer of shares` TRUE TRUE EQUALS JUST FALSE   -- "except to a person approved by the directors": the exception
#ASSERT `Under section 18(2), does the deemed restriction prohibit the transfer of shares` FALSE FALSE EQUALS NOTHING   -- any other restriction: the text says nothing

-- Under section 18(3), does the deemed restriction or limitation prevail over the provision to the extent of the inconsistency
#ASSERT `Under section 18(3), does the deemed restriction or limitation prevail over the provision to the extent of the inconsistency` TRUE TRUE EQUALS JUST TRUE   -- "that restriction or limitation, to the extent of the inconsistency, prevails"
#ASSERT `Under section 18(3), does the deemed restriction or limitation prevail over the provision to the extent of the inconsistency` TRUE FALSE EQUALS JUST FALSE   -- no inconsistency: a failed "Where" (periods ruling (b))
#ASSERT `Under section 18(3), does the deemed restriction or limitation prevail over the provision to the extent of the inconsistency` FALSE TRUE EQUALS JUST FALSE   -- not a restriction or limitation deemed to be included under (2): a failed "Where"

-- Under section 18(4), may the private company by special resolution make the alteration
#ASSERT `Under section 18(4), may the private company by special resolution make the alteration` TRUE TRUE TRUE FALSE EQUALS JUST TRUE   -- "A private company may, by special resolution, alter any restriction ... or any limitation"
#ASSERT `Under section 18(4), may the private company by special resolution make the alteration` TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- "but not so that the constitution of the company ceases to include the limitation required by subsection (1)(b)"
#ASSERT `Under section 18(4), may the private company by special resolution make the alteration` FALSE TRUE TRUE FALSE EQUALS NOTHING   -- not a private company: the text says nothing
#ASSERT `Under section 18(4), may the private company by special resolution make the alteration` TRUE FALSE TRUE FALSE EQUALS NOTHING   -- not by special resolution: the text says nothing
#ASSERT `Under section 18(4), may the private company by special resolution make the alteration` TRUE TRUE FALSE FALSE EQUALS NOTHING   -- an alteration of another provision: the text says nothing

§ `Registering and incorporating a company, refusal and the minimum of one member (sections 19, 20 and 20A)`

-- Under section 19(1), have I, as the person desiring the incorporation of the company, done everything the subsection requires
#ASSERT `Under section 19(1), have I, as the person desiring the incorporation of the company, done everything the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE   -- "(a) submit ...; (b) furnish ...; and (c) pay the Registrar the prescribed fee": all three
#ASSERT `Under section 19(1), have I, as the person desiring the incorporation of the company, done everything the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE   -- (a) unmet
#ASSERT `Under section 19(1), have I, as the person desiring the incorporation of the company, done everything the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE   -- (b) unmet
#ASSERT `Under section 19(1), have I, as the person desiring the incorporation of the company, done everything the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE   -- (c) unmet

-- Under section 19(2), am I one of those who may make the declaration to the Registrar
#ASSERT `Under section 19(2), am I one of those who may make the declaration to the Registrar` TRUE FALSE EQUALS JUST TRUE   -- "(a) a registered qualified individual engaged in the formation of the proposed company"
#ASSERT `Under section 19(2), am I one of those who may make the declaration to the Registrar` FALSE TRUE EQUALS JUST TRUE   -- "(b) a person named in the constitution as a director or the secretary of the proposed company"
#ASSERT `Under section 19(2), am I one of those who may make the declaration to the Registrar` FALSE FALSE EQUALS NOTHING   -- anyone else: the text says nothing

-- Under section 19(2), has the declaration required by the subsection been made to the Registrar
#ASSERT `Under section 19(2), has the declaration required by the subsection been made to the Registrar` TRUE TRUE TRUE EQUALS JUST TRUE   -- "(c) all of the requirements of this Act relating to the formation of the company have been complied with; and (d) he or she has verified the identities"
#ASSERT `Under section 19(2), has the declaration required by the subsection been made to the Registrar` FALSE TRUE TRUE EQUALS JUST FALSE   -- made by someone outside (a) and (b)
#ASSERT `Under section 19(2), has the declaration required by the subsection been made to the Registrar` TRUE FALSE TRUE EQUALS JUST FALSE   -- (c) not stated
#ASSERT `Under section 19(2), has the declaration required by the subsection been made to the Registrar` TRUE TRUE FALSE EQUALS JUST FALSE   -- (d) not stated

-- Under section 19(2), may the Registrar accept the declaration as sufficient evidence of those matters
#ASSERT `Under section 19(2), may the Registrar accept the declaration as sufficient evidence of those matters` TRUE EQUALS JUST TRUE   -- "the Registrar may accept such declaration as sufficient evidence of those matters"
#ASSERT `Under section 19(2), may the Registrar accept the declaration as sufficient evidence of those matters` FALSE EQUALS NOTHING   -- another declaration: the text says nothing

-- Under section 19(3), must the Registrar register the company by registering its constitution
#ASSERT `Under section 19(3), must the Registrar register the company by registering its constitution` TRUE TRUE FALSE EQUALS JUST TRUE   -- "Upon receipt of the documents, information and payment referred to in subsection (1) and declaration mentioned in subsection (2), the Registrar must ... register the company"
#ASSERT `Under section 19(3), must the Registrar register the company by registering its constitution` FALSE TRUE FALSE EQUALS JUST FALSE   -- no documents, information and payment received: a duty whose "upon" gate is unmet (marginal reading (a))
#ASSERT `Under section 19(3), must the Registrar register the company by registering its constitution` TRUE FALSE FALSE EQUALS JUST FALSE   -- no declaration received: a duty whose "upon" gate is unmet
#ASSERT `Under section 19(3), must the Registrar register the company by registering its constitution` TRUE TRUE TRUE EQUALS JUST FALSE   -- "subject to this Act": another provision requires the Registrar not to register

-- Under section 19(3), is the document the constitution of the company registered with the Registrar under section 19, as amended from time to time
#ASSERT `Under section 19(3), is the document the constitution of the company registered with the Registrar under section 19, as amended from time to time` TRUE TRUE EQUALS TRUE   -- the seam: "the constitution of the company which is registered with the Registrar under section 19, as may be amended from time to time"
#ASSERT `Under section 19(3), is the document the constitution of the company registered with the Registrar under section 19, as amended from time to time` TRUE FALSE EQUALS FALSE   -- not registered
#ASSERT `Under section 19(3), is the document the constitution of the company registered with the Registrar under section 19, as amended from time to time` FALSE TRUE EQUALS FALSE   -- not the constitution submitted

-- Under section 19(4), must the Registrar issue a notice of incorporation
#ASSERT `Under section 19(4), must the Registrar issue a notice of incorporation` TRUE EQUALS JUST TRUE   -- "On the registration of the constitution the Registrar must issue in the prescribed manner a notice of incorporation"
#ASSERT `Under section 19(4), must the Registrar issue a notice of incorporation` FALSE EQUALS JUST FALSE   -- not registered: a duty whose "on" gate is unmet (marginal reading (a))

-- Under section 19(4), does the notice of incorporation state what the subsection requires
#ASSERT `Under section 19(4), does the notice of incorporation state what the subsection requires` TRUE TRUE `limited by shares` `limited by shares` FALSE FALSE EQUALS JUST TRUE   -- "(a) a company limited by shares", not a private company so nothing more to state
#ASSERT `Under section 19(4), does the notice of incorporation state what the subsection requires` TRUE TRUE `limited by guarantee` `limited by guarantee` FALSE FALSE EQUALS JUST TRUE   -- "(b) a company limited by guarantee"
#ASSERT `Under section 19(4), does the notice of incorporation state what the subsection requires` TRUE TRUE `unlimited` `unlimited` FALSE FALSE EQUALS JUST TRUE   -- "(c) an unlimited company"
#ASSERT `Under section 19(4), does the notice of incorporation state what the subsection requires` TRUE TRUE `limited by shares` `limited by shares` TRUE TRUE EQUALS JUST TRUE   -- "and where applicable, that it is a private company": stated
#ASSERT `Under section 19(4), does the notice of incorporation state what the subsection requires` TRUE TRUE `limited by shares` `limited by shares` TRUE FALSE EQUALS JUST FALSE   -- a private company, and the notice does not say so
#ASSERT `Under section 19(4), does the notice of incorporation state what the subsection requires` TRUE TRUE `limited by guarantee` `limited by shares` FALSE FALSE EQUALS JUST FALSE   -- "as the case may be": the notice states the wrong kind
#ASSERT `Under section 19(4), does the notice of incorporation state what the subsection requires` FALSE TRUE `limited by shares` `limited by shares` FALSE FALSE EQUALS JUST FALSE   -- not in the prescribed manner or form
#ASSERT `Under section 19(4), does the notice of incorporation state what the subsection requires` TRUE FALSE `limited by shares` `limited by shares` FALSE FALSE EQUALS JUST FALSE   -- no date of incorporation stated
#ASSERT `Under section 19(4), does the notice of incorporation state what the subsection requires` TRUE TRUE `limited by shares` `limited by shares and by guarantee` FALSE FALSE EQUALS NOTHING   -- a company limited both by shares and by guarantee: not one of (a) to (c)

-- Under section 19(5), am I, with the other members, a body corporate capable of exercising all the functions of an incorporated company
#ASSERT `Under section 19(5), am I, with the other members, a body corporate capable of exercising all the functions of an incorporated company` TRUE (Date 5 1 2026) (Date 5 1 2026) FALSE EQUALS JUST TRUE   -- "On and from the date of incorporation specified in the notice": the day itself
#ASSERT `Under section 19(5), am I, with the other members, a body corporate capable of exercising all the functions of an incorporated company` TRUE (Date 6 1 2026) (Date 5 1 2026) FALSE EQUALS JUST TRUE   -- after that date
#ASSERT `Under section 19(5), am I, with the other members, a body corporate capable of exercising all the functions of an incorporated company` TRUE (Date 4 1 2026) (Date 5 1 2026) FALSE EQUALS JUST FALSE   -- the day before: a failed "on and from" (periods ruling (b))
#ASSERT `Under section 19(5), am I, with the other members, a body corporate capable of exercising all the functions of an incorporated company` TRUE (Date 6 1 2026) (Date 5 1 2026) TRUE EQUALS NOTHING   -- "but subject to this Act": the provision that overrides is outside this subsection
#ASSERT `Under section 19(5), am I, with the other members, a body corporate capable of exercising all the functions of an incorporated company` FALSE (Date 6 1 2026) (Date 5 1 2026) FALSE EQUALS NOTHING   -- anyone else: the text says nothing

-- Under section 19(5), what is the liability of the members to contribute to the assets of the company in the event of its being wound up
#ASSERT `Under section 19(5), what is the liability of the members to contribute to the assets of the company in the event of its being wound up` EQUALS NOTHING   -- "with such liability ... as is provided by this Act": the text points outside the subsection

-- Under section 19(6), is the subscriber deemed to have agreed to become a member of the company
#ASSERT `Under section 19(6), is the subscriber deemed to have agreed to become a member of the company` TRUE EQUALS JUST TRUE   -- "The subscribers to the constitution are deemed to have agreed to become members of the company"
#ASSERT `Under section 19(6), is the subscriber deemed to have agreed to become a member of the company` FALSE EQUALS NOTHING   -- anyone else: the text says nothing

-- Under section 19(6), must the subscriber be entered as a member in the register
#ASSERT `Under section 19(6), must the subscriber be entered as a member in the register` TRUE TRUE FALSE `s 19(6)(a) the register of members kept by the public company under section 190` EQUALS JUST TRUE   -- "(a) in the case of a public company"
#ASSERT `Under section 19(6), must the subscriber be entered as a member in the register` TRUE FALSE TRUE `s 19(6)(b) the electronic register of members kept by the Registrar under section 196A` EQUALS JUST TRUE   -- "(b) in the case of a private company"
#ASSERT `Under section 19(6), must the subscriber be entered as a member in the register` TRUE FALSE TRUE `s 19(6)(a) the register of members kept by the public company under section 190` EQUALS NOTHING   -- a private company and the public company's register: the text names no such entry
#ASSERT `Under section 19(6), must the subscriber be entered as a member in the register` TRUE TRUE FALSE `s 19(6)(b) the electronic register of members kept by the Registrar under section 196A` EQUALS NOTHING   -- a public company and the electronic register: the text names no such entry
#ASSERT `Under section 19(6), must the subscriber be entered as a member in the register` TRUE TRUE FALSE `s 19(6) another register` EQUALS NOTHING   -- any other register: the text says nothing
#ASSERT `Under section 19(6), must the subscriber be entered as a member in the register` FALSE TRUE FALSE `s 19(6)(a) the register of members kept by the public company under section 190` EQUALS JUST FALSE   -- not yet incorporated: a duty whose "on" gate is unmet (marginal reading (a))

-- Under section 19(6A), am I a member of the company
#ASSERT `Under section 19(6A), am I a member of the company` TRUE FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE   -- "(a) in the case of a public company -- in the register of members kept by the public company under section 190"
#ASSERT `Under section 19(6A), am I a member of the company` TRUE FALSE FALSE TRUE FALSE TRUE EQUALS JUST TRUE   -- "(b) in the case of a private company -- in the electronic register of members kept by the Registrar under section 196A"
#ASSERT `Under section 19(6A), am I a member of the company` TRUE FALSE TRUE FALSE FALSE TRUE EQUALS NOTHING   -- a public company, entered only in the electronic register: the text does not say they are a member
#ASSERT `Under section 19(6A), am I a member of the company` TRUE TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING   -- a subscriber: (6A) speaks of "every other person"
#ASSERT `Under section 19(6A), am I a member of the company` FALSE FALSE TRUE FALSE TRUE FALSE EQUALS NOTHING   -- does not agree to become a member: the text does not say

-- Under section 19(7), must the Registrar issue to the company a certificate of confirmation of incorporation
#ASSERT `Under section 19(7), must the Registrar issue to the company a certificate of confirmation of incorporation` TRUE TRUE EQUALS JUST TRUE   -- "Upon the application of a company and payment of the prescribed fee"
#ASSERT `Under section 19(7), must the Registrar issue to the company a certificate of confirmation of incorporation` TRUE FALSE EQUALS JUST FALSE   -- fee unpaid: a duty whose "upon" gate is unmet (marginal reading (a))
#ASSERT `Under section 19(7), must the Registrar issue to the company a certificate of confirmation of incorporation` FALSE TRUE EQUALS JUST FALSE   -- no application: a duty whose "upon" gate is unmet

-- Under section 20(1), is the Registrar barred from registering the constitution
#ASSERT `Under section 20(1), is the Registrar barred from registering the constitution` TRUE FALSE EQUALS JUST TRUE   -- "the Registrar must not register the constitution unless the Registrar is satisfied that all the requirements of this Act ... have been complied with"
#ASSERT `Under section 20(1), is the Registrar barred from registering the constitution` TRUE TRUE EQUALS JUST FALSE   -- "unless the Registrar is satisfied": an "unless", met
#ASSERT `Under section 20(1), is the Registrar barred from registering the constitution` FALSE FALSE EQUALS JUST FALSE   -- no constitution delivered for registration: a failed "where" (the bar does not arise)

-- Under section 20(2), must the Registrar refuse to register the constitution of the proposed company
#ASSERT `Under section 20(2), must the Registrar refuse to register the constitution of the proposed company` TRUE FALSE EQUALS JUST TRUE   -- "(a) the proposed company is likely to be used for an unlawful purpose or for purposes prejudicial to public peace, welfare or good order in Singapore"
#ASSERT `Under section 20(2), must the Registrar refuse to register the constitution of the proposed company` FALSE TRUE EQUALS JUST TRUE   -- "(b) it would be contrary to the national security or interest for the proposed company to be registered"
#ASSERT `Under section 20(2), must the Registrar refuse to register the constitution of the proposed company` FALSE FALSE EQUALS JUST FALSE   -- neither: a duty whose "where" gate is unmet (marginal reading (a))

-- Under section 20(3), may I appeal to the Minister against the decision
#ASSERT `Under section 20(3), may I appeal to the Minister against the decision` TRUE (Date 1 3 2026) (Date 31 3 2026) EQUALS JUST TRUE   -- "within 30 days of the date of the decision": 1 March plus 30 days is 31 March
#ASSERT `Under section 20(3), may I appeal to the Minister against the decision` TRUE (Date 1 3 2026) (Date 1 3 2026) EQUALS JUST TRUE   -- the day of the decision is in time (fork line F-H-P2)
#ASSERT `Under section 20(3), may I appeal to the Minister against the decision` TRUE (Date 1 3 2026) (Date 1 4 2026) EQUALS JUST FALSE   -- one day late: a period the text fixes in its own words (periods ruling (a))
#ASSERT `Under section 20(3), may I appeal to the Minister against the decision` TRUE (Date 1 3 2026) (Date 28 2 2026) EQUALS JUST FALSE   -- before the decision: no appeal lies yet
#ASSERT `Under section 20(3), may I appeal to the Minister against the decision` FALSE (Date 1 3 2026) (Date 31 3 2026) EQUALS NOTHING   -- not aggrieved: "Any person aggrieved" (limited by its own wording)

-- Under section 20(3), is the decision of the Minister on the appeal final
#ASSERT `Under section 20(3), is the decision of the Minister on the appeal final` TRUE EQUALS JUST TRUE   -- "the Minister whose decision is final"
#ASSERT `Under section 20(3), is the decision of the Minister on the appeal final` FALSE EQUALS NOTHING   -- another decision: the text says nothing

-- Under section 20A, does the company have at least one member
#ASSERT `Under section 20A, does the company have at least one member` 1 EQUALS JUST TRUE   -- "A company must have at least one member": one
#ASSERT `Under section 20A, does the company have at least one member` 2 EQUALS JUST TRUE   -- two
#ASSERT `Under section 20A, does the company have at least one member` 0 EQUALS JUST FALSE   -- none

§ `Membership of a holding company (section 21)`

-- Under section 21(1), is the corporation barred from being a member of the company
#ASSERT `Under section 21(1), is the corporation barred from being a member of the company` TRUE EQUALS JUST TRUE   -- "A corporation cannot be a member of a company which is its holding company"
#ASSERT `Under section 21(1), is the corporation barred from being a member of the company` FALSE EQUALS NOTHING   -- a company that is not its holding company: the text says nothing

-- Under section 21(1), is the allotment or transfer of the shares void
#ASSERT `Under section 21(1), is the allotment or transfer of the shares void` TRUE EQUALS JUST TRUE   -- "any allotment or transfer of shares in a company to its subsidiary is void"
#ASSERT `Under section 21(1), is the allotment or transfer of the shares void` FALSE EQUALS NOTHING   -- an allotment or transfer to anyone else: the text says nothing

-- Under section 21(1A), is it so that subsection (1) does not make the transfer void
#ASSERT `Under section 21(1A), is it so that subsection (1) does not make the transfer void` TRUE EQUALS JUST TRUE   -- "does not apply to a disposition of book-entry securities"
#ASSERT `Under section 21(1A), is it so that subsection (1) does not make the transfer void` FALSE EQUALS NOTHING   -- any other transfer: the text says nothing here

-- Under section 21(1A), may the Court order the transfer of the shares acquired in contravention of subsection (1)
#ASSERT `Under section 21(1A), may the Court order the transfer of the shares acquired in contravention of subsection (1)` TRUE TRUE EQUALS JUST TRUE   -- "on being satisfied ... may, on the application of the Registrar or any other person, order the transfer"
#ASSERT `Under section 21(1A), may the Court order the transfer of the shares acquired in contravention of subsection (1)` TRUE FALSE EQUALS NOTHING   -- no application: a failed "on the application" gating a grant (fork line F-H-S3)
#ASSERT `Under section 21(1A), may the Court order the transfer of the shares acquired in contravention of subsection (1)` FALSE TRUE EQUALS JUST FALSE   -- not satisfied: a failed "on being satisfied" (periods ruling (b); split site (ii))
#ASSERT `Under section 21(1A), may the Court order the transfer of the shares acquired in contravention of subsection (1)` FALSE FALSE EQUALS JUST FALSE   -- the "on being satisfied" gate decides first

-- Under section 21(2), is it so that subsection (1) does not apply to the subsidiary
#ASSERT `Under section 21(2), is it so that subsection (1) does not apply to the subsidiary` TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- "where the subsidiary is concerned as personal representative"
#ASSERT `Under section 21(2), is it so that subsection (1) does not apply to the subsidiary` FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- "or where it is concerned as trustee": not beneficially interested
#ASSERT `Under section 21(2), is it so that subsection (1) does not apply to the subsidiary` FALSE TRUE TRUE FALSE EQUALS JUST FALSE   -- "unless the holding company or a subsidiary thereof is beneficially interested under the trust and is not so interested only by way of security"
#ASSERT `Under section 21(2), is it so that subsection (1) does not apply to the subsidiary` FALSE TRUE TRUE TRUE EQUALS JUST TRUE   -- interested only by way of security in a lending business: the "unless" is not met
#ASSERT `Under section 21(2), is it so that subsection (1) does not apply to the subsidiary` TRUE TRUE TRUE FALSE EQUALS JUST TRUE   -- as personal representative the "unless" (which follows the trustee limb) does not reach it
#ASSERT `Under section 21(2), is it so that subsection (1) does not apply to the subsidiary` FALSE FALSE FALSE FALSE EQUALS NOTHING   -- another capacity: the text says nothing

-- Under section 21(3), is it so that this section does not prevent the subsidiary from continuing to be a member of its holding company
#ASSERT `Under section 21(3), is it so that this section does not prevent the subsidiary from continuing to be a member of its holding company` TRUE EQUALS JUST TRUE   -- "a subsidiary which, on 29 December 1967, is a member of its holding company"
#ASSERT `Under section 21(3), is it so that this section does not prevent the subsidiary from continuing to be a member of its holding company` FALSE EQUALS NOTHING   -- any other subsidiary: the text says nothing

-- Under section 21(3), does the subsidiary have a right to vote at meetings of the holding company or any class of members
#ASSERT `Under section 21(3), does the subsidiary have a right to vote at meetings of the holding company or any class of members` TRUE FALSE EQUALS JUST FALSE   -- "the subsidiary has no right to vote at meetings of the holding company or any class of members thereof"
#ASSERT `Under section 21(3), does the subsidiary have a right to vote at meetings of the holding company or any class of members` TRUE TRUE EQUALS NOTHING   -- "subject to subsection (2)": left to that subsection
#ASSERT `Under section 21(3), does the subsidiary have a right to vote at meetings of the holding company or any class of members` FALSE FALSE EQUALS NOTHING   -- any other subsidiary: the text says nothing

-- Under section 21(4), is it so that this section does not prevent the subsidiary from continuing to be a member of its holding company
#ASSERT `Under section 21(4), is it so that this section does not prevent the subsidiary from continuing to be a member of its holding company` TRUE EQUALS JUST TRUE   -- "if, at the time when it becomes a subsidiary of the holding company, it already holds shares in that holding company"
#ASSERT `Under section 21(4), is it so that this section does not prevent the subsidiary from continuing to be a member of its holding company` FALSE EQUALS NOTHING   -- it held no shares then: a failed "if" on an exception (fork line F-H-S3)

-- Under section 21(4)(a), does the subsidiary have a right to vote at meetings of the holding company or any class of members
#ASSERT `Under section 21(4)(a), does the subsidiary have a right to vote at meetings of the holding company or any class of members` TRUE FALSE EQUALS JUST FALSE   -- "(a) subject to subsection (2), the subsidiary has no right to vote"
#ASSERT `Under section 21(4)(a), does the subsidiary have a right to vote at meetings of the holding company or any class of members` TRUE TRUE EQUALS NOTHING   -- "subject to subsection (2)"
#ASSERT `Under section 21(4)(a), does the subsidiary have a right to vote at meetings of the holding company or any class of members` FALSE FALSE EQUALS NOTHING   -- the (4) condition is not met: the text says nothing

-- Under section 21(4)(b), must the subsidiary dispose of all of its shares in the holding company within the period
#ASSERT `Under section 21(4)(b), must the subsidiary dispose of all of its shares in the holding company within the period` TRUE FALSE EQUALS JUST TRUE   -- "(b) ... the subsidiary must, within the period of 12 months ... dispose of all of its shares in the holding company"
#ASSERT `Under section 21(4)(b), must the subsidiary dispose of all of its shares in the holding company within the period` TRUE TRUE EQUALS JUST FALSE   -- (4A): "ceases to apply if, during the period ..., the subsidiary ceases to be a subsidiary of the holding company"
#ASSERT `Under section 21(4)(b), must the subsidiary dispose of all of its shares in the holding company within the period` FALSE FALSE EQUALS NOTHING   -- the (4) condition is not met: the text says nothing

-- Under section 21(4)(b), what is the last day of the period within which the subsidiary must dispose of all of its shares
#ASSERT `Under section 21(4)(b), what is the last day of the period within which the subsidiary must dispose of all of its shares` (Date 15 3 2026) FALSE (Date 1 1 1900) EQUALS Date 15 3 2027   -- "within the period of 12 months": 15 March 2026 plus 12 months (P4)
#ASSERT `Under section 21(4)(b), what is the last day of the period within which the subsidiary must dispose of all of its shares` (Date 15 3 2026) TRUE (Date 30 9 2027) EQUALS Date 30 9 2027   -- "or such longer period as the Court may allow": the later day
#ASSERT `Under section 21(4)(b), what is the last day of the period within which the subsidiary must dispose of all of its shares` (Date 15 3 2026) TRUE (Date 1 1 2027) EQUALS Date 15 3 2027   -- an earlier day is not "longer": 12 months stands
#ASSERT `Under section 21(4)(b), what is the last day of the period within which the subsidiary must dispose of all of its shares` (Date 29 2 2024) FALSE (Date 1 1 1900) EQUALS Date 28 2 2025   -- 29 February 2024 plus 12 months ends on the last day of February (P4)

-- Under section 21(4)(b), did the subsidiary dispose of all of its shares in the holding company within the period
#ASSERT `Under section 21(4)(b), did the subsidiary dispose of all of its shares in the holding company within the period` (Date 15 3 2026) FALSE (Date 1 1 1900) (Date 15 3 2027) EQUALS JUST TRUE   -- the last day of the 12 months
#ASSERT `Under section 21(4)(b), did the subsidiary dispose of all of its shares in the holding company within the period` (Date 15 3 2026) FALSE (Date 1 1 1900) (Date 16 3 2027) EQUALS JUST FALSE   -- one day later: a period the text fixes in its own words (periods ruling (a))
#ASSERT `Under section 21(4)(b), did the subsidiary dispose of all of its shares in the holding company within the period` (Date 15 3 2026) TRUE (Date 30 9 2027) (Date 16 3 2027) EQUALS JUST TRUE   -- inside the longer period the Court allowed
#ASSERT `Under section 21(4)(b), did the subsidiary dispose of all of its shares in the holding company within the period` (Date 15 3 2026) FALSE (Date 1 1 1900) (Date 14 3 2026) EQUALS JUST FALSE   -- before it became a subsidiary: outside "after becoming"

-- Under section 21(4A), does subsection (4)(b) cease to apply
#ASSERT `Under section 21(4A), does subsection (4)(b) cease to apply` TRUE EQUALS JUST TRUE   -- "ceases to apply if, during the period referred to in that subsection, the subsidiary ceases to be a subsidiary of the holding company"
#ASSERT `Under section 21(4A), does subsection (4)(b) cease to apply` FALSE EQUALS NOTHING   -- no other way is stated

-- Under section 21(4B), may the subsidiary hold or continue to hold the shares
#ASSERT `Under section 21(4B), may the subsidiary hold or continue to hold the shares` TRUE TRUE EQUALS JUST TRUE   -- "Any shares ... that are not disposed of in accordance with subsection (4)(b) may, subject to subsections (4C) and (6E), be held or continued to be held by the subsidiary"
#ASSERT `Under section 21(4B), may the subsidiary hold or continue to hold the shares` TRUE FALSE EQUALS NOTHING   -- not "subject to" (4C) and (6E): the text says nothing (fork line F-H-S3)
#ASSERT `Under section 21(4B), may the subsidiary hold or continue to hold the shares` FALSE TRUE EQUALS NOTHING   -- shares disposed of: the text says nothing

-- Under section 21(4C)(a), how is the reference read
#ASSERT `Under section 21(4C)(a), how is the reference read` TRUE `s 21(4C)(a)(i) a reference to treasury shares` EQUALS JUST "a reference to shares referred to in subsection (4B)"   -- "(i) a reference to treasury shares is a reference to shares referred to in subsection (4B)"
#ASSERT `Under section 21(4C)(a), how is the reference read` TRUE `s 21(4C)(a)(ii) a reference to a company holding treasury shares` EQUALS JUST "a reference to a subsidiary holding shares referred to in subsection (4B)"   -- "(ii) a reference to a company holding treasury shares is a reference to a subsidiary holding shares referred to in subsection (4B)"
#ASSERT `Under section 21(4C)(a), how is the reference read` TRUE `s 21(4C)(a)(iii) the reference in section 76J(6) to the purchase of the shares by the company at the time they were allotted, in circumstances in which section 76H applied` EQUALS JUST "as if they were already held by the subsidiary at the time they were allotted, in circumstances in which section 21(4) applied"   -- "(iii) ... is a reference to 'as if they were already held by the subsidiary at the time they were allotted, in circumstances in which section 21(4) applied'"
#ASSERT `Under section 21(4C)(a), how is the reference read` TRUE `s 21(4C) another reference in sections 76J(1), (2), (3), (5) and (6) and 76K` EQUALS NOTHING   -- "including the following modifications": the others are not stated (includes)
#ASSERT `Under section 21(4C)(a), how is the reference read` FALSE `s 21(4C)(a)(i) a reference to treasury shares` EQUALS NOTHING   -- other shares: the text says nothing

-- Under section 21(4C)(b), did the holding company lodge the notice with the Registrar in time
#ASSERT `Under section 21(4C)(b), did the holding company lodge the notice with the Registrar in time` (Date 1 5 2026) (Date 15 5 2026) EQUALS JUST TRUE   -- "within 14 days after any change": 1 May plus 14 days is 15 May
#ASSERT `Under section 21(4C)(b), did the holding company lodge the notice with the Registrar in time` (Date 1 5 2026) (Date 1 5 2026) EQUALS JUST TRUE   -- the day of the change is in time (fork line F-H-P2)
#ASSERT `Under section 21(4C)(b), did the holding company lodge the notice with the Registrar in time` (Date 1 5 2026) (Date 16 5 2026) EQUALS JUST FALSE   -- one day late: a period the text fixes in its own words (periods ruling (a))
#ASSERT `Under section 21(4C)(b), did the holding company lodge the notice with the Registrar in time` (Date 1 5 2026) (Date 30 4 2026) EQUALS JUST FALSE   -- before the change: not "after" it

-- Under section 21(5), does the subsection apply in relation to the nominee as it applies to the subsidiary
#ASSERT `Under section 21(5), does the subsection apply in relation to the nominee as it applies to the subsidiary` `s 21(5) subsection (1)` TRUE FALSE EQUALS JUST TRUE   -- "subsections (1), (3), (4), (4B), (6A) and (6C) apply in relation to a nominee"
#ASSERT `Under section 21(5), does the subsection apply in relation to the nominee as it applies to the subsidiary` `s 21(5) subsection (3)` TRUE FALSE EQUALS JUST TRUE   -- (3)
#ASSERT `Under section 21(5), does the subsection apply in relation to the nominee as it applies to the subsidiary` `s 21(5) subsection (4)` TRUE FALSE EQUALS JUST TRUE   -- (4)
#ASSERT `Under section 21(5), does the subsection apply in relation to the nominee as it applies to the subsidiary` `s 21(5) subsection (4B)` TRUE FALSE EQUALS JUST TRUE   -- (4B)
#ASSERT `Under section 21(5), does the subsection apply in relation to the nominee as it applies to the subsidiary` `s 21(5) subsection (6A)` TRUE FALSE EQUALS JUST TRUE   -- (6A)
#ASSERT `Under section 21(5), does the subsection apply in relation to the nominee as it applies to the subsidiary` `s 21(5) subsection (6C)` TRUE FALSE EQUALS JUST TRUE   -- (6C)
#ASSERT `Under section 21(5), does the subsection apply in relation to the nominee as it applies to the subsidiary` `s 21(5) another subsection` TRUE FALSE EQUALS NOTHING   -- another subsection: the text does not say "only"
#ASSERT `Under section 21(5), does the subsection apply in relation to the nominee as it applies to the subsidiary` `s 21(5) subsection (1)` TRUE TRUE EQUALS NOTHING   -- "Subject to subsection (2)": left to that subsection
#ASSERT `Under section 21(5), does the subsection apply in relation to the nominee as it applies to the subsidiary` `s 21(5) subsection (1)` FALSE FALSE EQUALS NOTHING   -- not a nominee: the text says nothing

-- Under section 21(6), is it so that this section does not operate to prevent the allotment of shares in the holding company to the subsidiary
#ASSERT `Under section 21(6), is it so that this section does not operate to prevent the allotment of shares in the holding company to the subsidiary` TRUE TRUE TRUE EQUALS JUST TRUE   -- "if the allotment is made by way of capitalisation of reserves ... and is made to all members ... in direct proportion"
#ASSERT `Under section 21(6), is it so that this section does not operate to prevent the allotment of shares in the holding company to the subsidiary` FALSE TRUE TRUE EQUALS NOTHING   -- the subsidiary held no shares lawfully: a failed "if" on an exception (fork line F-H-S3)
#ASSERT `Under section 21(6), is it so that this section does not operate to prevent the allotment of shares in the holding company to the subsidiary` TRUE FALSE TRUE EQUALS NOTHING   -- not by capitalisation of reserves
#ASSERT `Under section 21(6), is it so that this section does not operate to prevent the allotment of shares in the holding company to the subsidiary` TRUE TRUE FALSE EQUALS NOTHING   -- not in direct proportion

-- Under section 21(6A), is it so that this section does not operate to prevent the transfer of shares in the holding company to the subsidiary
#ASSERT `Under section 21(6A), is it so that this section does not operate to prevent the transfer of shares in the holding company to the subsidiary` `s 21(6A) a distribution in specie` EQUALS JUST TRUE   -- "by way of a distribution in specie"
#ASSERT `Under section 21(6A), is it so that this section does not operate to prevent the transfer of shares in the holding company to the subsidiary` `s 21(6A) an amalgamation` EQUALS JUST TRUE   -- "amalgamation"
#ASSERT `Under section 21(6A), is it so that this section does not operate to prevent the transfer of shares in the holding company to the subsidiary` `s 21(6A) a scheme of arrangement` EQUALS JUST TRUE   -- "scheme of arrangement"
#ASSERT `Under section 21(6A), is it so that this section does not operate to prevent the transfer of shares in the holding company to the subsidiary` `s 21(6A) another way of transfer` EQUALS NOTHING   -- the list does not say "only"

-- Under section 21(6A)(a), does the subsidiary have a right to vote at meetings of the holding company or any class of members
#ASSERT `Under section 21(6A)(a), does the subsidiary have a right to vote at meetings of the holding company or any class of members` TRUE FALSE EQUALS JUST FALSE   -- "(a) subject to subsection (2), the subsidiary has no right to vote"
#ASSERT `Under section 21(6A)(a), does the subsidiary have a right to vote at meetings of the holding company or any class of members` TRUE TRUE EQUALS NOTHING   -- "subject to subsection (2)"
#ASSERT `Under section 21(6A)(a), does the subsidiary have a right to vote at meetings of the holding company or any class of members` FALSE FALSE EQUALS NOTHING   -- another way of transfer: the text says nothing

-- Under section 21(6A)(b), must the subsidiary dispose of all of the shares in the holding company within the period
#ASSERT `Under section 21(6A)(b), must the subsidiary dispose of all of the shares in the holding company within the period` TRUE FALSE EQUALS JUST TRUE   -- "(b) ... the subsidiary must, within the period of 12 months ... dispose of all of the shares"
#ASSERT `Under section 21(6A)(b), must the subsidiary dispose of all of the shares in the holding company within the period` TRUE TRUE EQUALS JUST FALSE   -- (6B): "ceases to apply if, during the period ..., the subsidiary ceases to be a subsidiary"
#ASSERT `Under section 21(6A)(b), must the subsidiary dispose of all of the shares in the holding company within the period` FALSE FALSE EQUALS NOTHING   -- another way of transfer: the text says nothing

-- Under section 21(6A)(b), what is the last day of the period within which the subsidiary must dispose of all of the shares
#ASSERT `Under section 21(6A)(b), what is the last day of the period within which the subsidiary must dispose of all of the shares` (Date 30 6 2026) FALSE (Date 1 1 1900) EQUALS Date 30 6 2027   -- "within the period of 12 months": 30 June 2026 plus 12 months
#ASSERT `Under section 21(6A)(b), what is the last day of the period within which the subsidiary must dispose of all of the shares` (Date 30 6 2026) TRUE (Date 31 12 2027) EQUALS Date 31 12 2027   -- the longer period the Court allowed

