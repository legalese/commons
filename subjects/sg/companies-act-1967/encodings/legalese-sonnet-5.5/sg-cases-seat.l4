#ASSERT `Under section 21(6A)(b), did the subsidiary dispose of all of the shares in the holding company within the period` (Date 30 6 2026) FALSE (Date 1 1 1900) (Date 30 6 2027) EQUALS JUST TRUE   -- the last day of the 12 months
#ASSERT `Under section 21(6A)(b), did the subsidiary dispose of all of the shares in the holding company within the period` (Date 30 6 2026) FALSE (Date 1 1 1900) (Date 1 7 2027) EQUALS JUST FALSE   -- one day later (periods ruling (a))
#ASSERT `Under section 21(6A)(b), did the subsidiary dispose of all of the shares in the holding company within the period` (Date 30 6 2026) TRUE (Date 31 12 2027) (Date 1 7 2027) EQUALS JUST TRUE   -- inside the longer period

-- Under section 21(6B), does subsection (6A)(b) cease to apply
#ASSERT `Under section 21(6B), does subsection (6A)(b) cease to apply` TRUE EQUALS JUST TRUE   -- "ceases to apply if, during the period referred to in that subsection, the subsidiary ceases to be a subsidiary of the holding company"
#ASSERT `Under section 21(6B), does subsection (6A)(b) cease to apply` FALSE EQUALS NOTHING   -- no other way is stated

-- Under section 21(6C), may the subsidiary hold or continue to hold the shares
#ASSERT `Under section 21(6C), may the subsidiary hold or continue to hold the shares` TRUE TRUE EQUALS JUST TRUE   -- "may, subject to subsections (6D) and (6E), be held or continued to be held by the subsidiary"
#ASSERT `Under section 21(6C), may the subsidiary hold or continue to hold the shares` TRUE FALSE EQUALS NOTHING   -- not "subject to" (6D) and (6E) (fork line F-H-S3)
