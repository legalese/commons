-- A private company with no public parent: not covered.
#ASSERT `Under section 76(1), does subsection (1) bar the company from giving the financial assistance` TRUE FALSE FALSE TRUE TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
-- Acme Ltd gives no financial assistance: nothing is barred.
#ASSERT `Under section 76(1), does subsection (1) bar the company from giving the financial assistance` FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- The assistance is neither for the purpose of nor in connection with the acquisition, and not taken to be: unmet.
#ASSERT `Under section 76(1), does subsection (1) bar the company from giving the financial assistance` FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- A proposed acquisition, not yet made: barred under paragraph (b).
#ASSERT `Under section 76(1), does subsection (1) bar the company from giving the financial assistance` FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
