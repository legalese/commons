#ASSERT `Under section 366(1), is the person an authorised representative of the foreign company` (Date 2 1 2016) FALSE TRUE EQUALS JUST FALSE   -- the text's no

-- Under section 366(1), is the activity within carrying on business
#ASSERT `Under section 366(1), is the activity within carrying on business` TRUE EQUALS JUST TRUE   -- yes
#ASSERT `Under section 366(1), is the activity within carrying on business` FALSE EQUALS NOTHING   -- not covered

-- Under section 366(1), is the activity kept out of carrying on business only because it is carried on without a view to any profit
#ASSERT `Under section 366(1), is the activity kept out of carrying on business only because it is carried on without a view to any profit` TRUE EQUALS JUST FALSE   -- the text's no
#ASSERT `Under section 366(1), is the activity kept out of carrying on business only because it is carried on without a view to any profit` FALSE EQUALS NOTHING   -- not covered

-- Under section 366(2), is the foreign company not regarded as carrying on business in Singapore by reason only of the activity
#ASSERT `Under section 366(2), is the foreign company not regarded as carrying on business in Singapore by reason only of the activity` `s 366(2)(h) conducting an isolated transaction` 31 FALSE FALSE FALSE FALSE EQUALS JUST TRUE   -- yes
#ASSERT `Under section 366(2), is the foreign company not regarded as carrying on business in Singapore by reason only of the activity` `s 366(2)(h) conducting an isolated transaction` 32 FALSE FALSE FALSE FALSE EQUALS NOTHING   -- not covered


