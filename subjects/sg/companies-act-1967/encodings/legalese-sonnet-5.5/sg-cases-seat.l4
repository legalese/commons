-- I am not an officer in default
#ASSERT `Under section 63A(3), am I, as an officer in default, guilty of the offence` TRUE FALSE EQUALS JUST FALSE
-- a fine not exceeding $4,000 (and a default penalty of $250)
#ASSERT `Under section 63A(3), what is the highest fine I may be sentenced to, in Singapore dollars` TRUE TRUE EQUALS JUST 4000
-- shares allotted for a contract in writing and the contract is not lodged with the return: in default
#ASSERT `Under section 63B(1), is the company in default of the duty to lodge the contract with the return of allotment` TRUE TRUE FALSE EQUALS JUST TRUE
-- the contract is lodged: the duty is done
