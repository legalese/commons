#ASSERT `Under section 207(5), is the auditor entitled to require information and explanations from the person` TRUE `s 207(5) any other person` FALSE FALSE FALSE TRUE EQUALS NOTHING
-- 207(8): the auditor, or the agent authorised in writing; no one else.
#ASSERT `Under section 207(8), is the person entitled to attend any general meeting of the company` `s 207(8) an auditor of the company` EQUALS JUST TRUE
#ASSERT `Under section 207(8), is the person entitled to attend any general meeting of the company` `s 207(8) an agent authorised by the auditor in writing for the purpose` EQUALS JUST TRUE
#ASSERT `Under section 207(8), is the person entitled to attend any general meeting of the company` `s 207(8) any other person` EQUALS NOTHING
-- 207(9): satisfied of a breach, not adequately dealt with in the report or by the directors: report in writing to the Registrar immediately.
#ASSERT `Under section 207(9), is the auditor in default of the duty to report the matter to the Registrar` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
