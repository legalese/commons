#ASSERT `Under section 215(1C)(a), are the shares to be disregarded in counting the 90%` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 215(1C)(a), are the shares to be disregarded in counting the 90%` TRUE TRUE EQUALS JUST FALSE

