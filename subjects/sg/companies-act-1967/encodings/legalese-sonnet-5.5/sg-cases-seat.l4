-- wilfully makes a false statement, knowing.
#ASSERT `Under section 401(2), am I guilty of an offence for a false or misleading statement in a required document` TRUE TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- the person does none of the three acts.
#ASSERT `Under section 401(2), am I guilty of an offence for a false or misleading statement in a required document` TRUE TRUE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING

-- Under section 401(2), what is the highest penalty on conviction for a false or misleading statement in a required document
-- the facts of the layer-1 test in sgo-tests-offences.l4
#ASSERT `Under section 401(2), what is the highest penalty on conviction for a false or misleading statement in a required document` FALSE EQUALS NOTHING
-- fine not exceeding $50,000 or imprisonment not exceeding 2 years or both.
#ASSERT `Under section 401(2), what is the highest penalty on conviction for a false or misleading statement in a required document` TRUE EQUALS JUST (Penalty OF 50000, 24, TRUE, FALSE)

