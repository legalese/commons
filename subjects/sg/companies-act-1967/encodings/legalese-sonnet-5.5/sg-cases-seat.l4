-- Under section 232(1): may the Minister appoint inspectors on the application.
#ASSERT `Under section 232(1), may the Minister appoint inspectors on the application` TRUE 200 0 1000 0 0 0 0 FALSE EQUALS JUST TRUE      -- 200 members: "not less than 200"
#ASSERT `Under section 232(1), may the Minister appoint inspectors on the application` TRUE 199 0 1000 0 0 0 0 FALSE EQUALS NOTHING      -- 199 members, no shares
#ASSERT `Under section 232(1), may the Minister appoint inspectors on the application` TRUE 1 100 1000 0 0 0 0 FALSE EQUALS JUST TRUE      -- 10% of the shares
#ASSERT `Under section 232(1), may the Minister appoint inspectors on the application` TRUE 1 99 1000 0 0 0 0 FALSE EQUALS NOTHING      -- under 10%
#ASSERT `Under section 232(1), may the Minister appoint inspectors on the application` TRUE 0 0 0 200 1000 0 0 FALSE EQUALS JUST TRUE      -- 20% of the debentures
