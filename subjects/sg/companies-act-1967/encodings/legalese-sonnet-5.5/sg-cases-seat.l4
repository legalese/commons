#ASSERT `Under section 21(6D)(a), how is the reference read` TRUE `s 21(6D)(a)(i) a reference to treasury shares` EQUALS JUST "a reference to shares referred to in subsection (6C)"   -- "(i) a reference to treasury shares is a reference to shares referred to in subsection (6C)"
#ASSERT `Under section 21(6D)(a), how is the reference read` TRUE `s 21(6D)(a)(ii) a reference to a company holding treasury shares` EQUALS JUST "a reference to a subsidiary holding shares referred to in subsection (6C)"   -- "(ii)"
#ASSERT `Under section 21(6D)(a), how is the reference read` TRUE `s 21(6D)(a)(iii) the reference in section 76J(6) to the purchase of the shares by the company at the time they were allotted, in circumstances in which section 76H applied` EQUALS JUST "as if they were transferred to the subsidiary at the time they were allotted, in circumstances in which section 21(6A) applied"   -- "(iii) ... a reference to 'as if they were transferred to the subsidiary at the time they were allotted, in circumstances in which section 21(6A) applied'"
#ASSERT `Under section 21(6D)(a), how is the reference read` TRUE `s 21(6D) another reference in sections 76J(1), (2), (3), (5) and (6) and 76K` EQUALS NOTHING   -- "including the following modifications": the others are not stated (includes)
#ASSERT `Under section 21(6D)(a), how is the reference read` FALSE `s 21(6D)(a)(i) a reference to treasury shares` EQUALS NOTHING   -- other shares: the text says nothing

-- Under section 21(6D)(b), did the holding company lodge the notice with the Registrar in time
#ASSERT `Under section 21(6D)(b), did the holding company lodge the notice with the Registrar in time` (Date 1 5 2026) (Date 15 5 2026) EQUALS JUST TRUE   -- "within 14 days after any change": 1 May plus 14 days is 15 May
#ASSERT `Under section 21(6D)(b), did the holding company lodge the notice with the Registrar in time` (Date 1 5 2026) (Date 16 5 2026) EQUALS JUST FALSE   -- one day late (periods ruling (a))

-- Under section 21(6E)(a), does the aggregate number of shares exceed 10% of the total number of shares of the holding company
#ASSERT `Under section 21(6E)(a), does the aggregate number of shares exceed 10% of the total number of shares of the holding company` TRUE 100 1000 EQUALS JUST FALSE   -- "must not at any time exceed 10%": exactly 10% is not over
#ASSERT `Under section 21(6E)(a), does the aggregate number of shares exceed 10% of the total number of shares of the holding company` TRUE 101 1000 EQUALS JUST TRUE   -- one share over 10%
#ASSERT `Under section 21(6E)(a), does the aggregate number of shares exceed 10% of the total number of shares of the holding company` FALSE 500 1000 EQUALS JUST FALSE   -- "(a) where the holding company has shares of only one class": a failed "where" (periods ruling (b)); paragraph (b) governs

-- Under section 21(6E)(b), does the aggregate number of the shares of the class exceed 10% of the total number of the shares in that class
#ASSERT `Under section 21(6E)(b), does the aggregate number of the shares of the class exceed 10% of the total number of the shares in that class` TRUE 100 1000 EQUALS JUST FALSE   -- exactly 10% of the class is not over
#ASSERT `Under section 21(6E)(b), does the aggregate number of the shares of the class exceed 10% of the total number of the shares in that class` TRUE 101 1000 EQUALS JUST TRUE   -- one share over 10% of the class
#ASSERT `Under section 21(6E)(b), does the aggregate number of the shares of the class exceed 10% of the total number of the shares in that class` FALSE 500 1000 EQUALS JUST FALSE   -- "(b) where the share capital ... is divided into shares of different classes": a failed "where" (periods ruling (b)); paragraph (a) governs

-- Under section 21(6E)(c), must the holding company dispose of or cancel the excess shares, or procure the disposal of the excess shares by its subsidiary
#ASSERT `Under section 21(6E)(c), must the holding company dispose of or cancel the excess shares, or procure the disposal of the excess shares by its subsidiary` TRUE EQUALS JUST TRUE   -- "where paragraph (a) or (b) is contravened, the holding company must dispose of or cancel the excess shares"
#ASSERT `Under section 21(6E)(c), must the holding company dispose of or cancel the excess shares, or procure the disposal of the excess shares by its subsidiary` FALSE EQUALS JUST FALSE   -- no contravention: a duty whose "where" gate is unmet (marginal reading (a))

-- Under section 21(6E)(c), what is the last day of the period for disposing of or cancelling the excess shares
#ASSERT `Under section 21(6E)(c), what is the last day of the period for disposing of or cancelling the excess shares` (Date 1 1 2026) FALSE (Date 1 1 1900) EQUALS Date 30 6 2026   -- "the period of 6 months beginning with the day on which that contravention occurs": 1 January is day 1 (P10), so the period ends on 30 June
#ASSERT `Under section 21(6E)(c), what is the last day of the period for disposing of or cancelling the excess shares` (Date 1 1 2026) TRUE (Date 31 7 2026) EQUALS Date 31 7 2026   -- "or such further period as the Registrar may allow"
#ASSERT `Under section 21(6E)(c), what is the last day of the period for disposing of or cancelling the excess shares` (Date 1 1 2026) TRUE (Date 15 6 2026) EQUALS Date 30 6 2026   -- an earlier day is not "further": 6 months stands
#ASSERT `Under section 21(6E)(c), what is the last day of the period for disposing of or cancelling the excess shares` (Date 31 8 2026) FALSE (Date 1 1 1900) EQUALS Date 28 2 2027   -- beginning on 31 August, the 6 months end on 28 February (P4 clamp, P10)

-- Under section 21(6E)(c), were the excess shares disposed of or cancelled in time
#ASSERT `Under section 21(6E)(c), were the excess shares disposed of or cancelled in time` (Date 1 1 2026) FALSE (Date 1 1 1900) (Date 30 6 2026) TRUE EQUALS JUST TRUE   -- "before the end of the period of 6 months ..., in accordance with section 76K": the last day
#ASSERT `Under section 21(6E)(c), were the excess shares disposed of or cancelled in time` (Date 1 1 2026) FALSE (Date 1 1 1900) (Date 1 7 2026) TRUE EQUALS JUST FALSE   -- one day later (periods ruling (a))
#ASSERT `Under section 21(6E)(c), were the excess shares disposed of or cancelled in time` (Date 1 1 2026) FALSE (Date 1 1 1900) (Date 30 6 2026) FALSE EQUALS JUST FALSE   -- not "in accordance with section 76K"
#ASSERT `Under section 21(6E)(c), were the excess shares disposed of or cancelled in time` (Date 1 1 2026) TRUE (Date 31 7 2026) (Date 15 7 2026) TRUE EQUALS JUST TRUE   -- inside the further period the Registrar allowed
#ASSERT `Under section 21(6E)(c), were the excess shares disposed of or cancelled in time` (Date 1 1 2026) FALSE (Date 1 1 1900) (Date 31 12 2025) TRUE EQUALS JUST FALSE   -- before the contravention: outside the period

-- Under section 21(6E)(d), may a dividend or other distribution of the holding company's assets be paid or made to the subsidiary in respect of the shares
#ASSERT `Under section 21(6E)(d), may a dividend or other distribution of the holding company's assets be paid or made to the subsidiary in respect of the shares` TRUE TRUE EQUALS JUST FALSE   -- "(d) where the subsidiary is a wholly-owned subsidiary of the holding company, no dividend may be paid, and no other distribution ... may be made"
#ASSERT `Under section 21(6E)(d), may a dividend or other distribution of the holding company's assets be paid or made to the subsidiary in respect of the shares` TRUE FALSE EQUALS NOTHING   -- not wholly-owned: paragraph (e) is the question for that case
#ASSERT `Under section 21(6E)(d), may a dividend or other distribution of the holding company's assets be paid or made to the subsidiary in respect of the shares` FALSE TRUE EQUALS NOTHING   -- other shares: the text says nothing

-- Under section 21(6E)(e), may a dividend or other distribution of the holding company's assets be paid or made to the subsidiary in respect of the shares, as paragraph (e) provides
#ASSERT `Under section 21(6E)(e), may a dividend or other distribution of the holding company's assets be paid or made to the subsidiary in respect of the shares, as paragraph (e) provides` TRUE FALSE EQUALS JUST TRUE   -- "(e) where the subsidiary is not a wholly-owned subsidiary of the holding company, a dividend may be paid and other distribution ... may be made"
#ASSERT `Under section 21(6E)(e), may a dividend or other distribution of the holding company's assets be paid or made to the subsidiary in respect of the shares, as paragraph (e) provides` TRUE TRUE EQUALS JUST FALSE   -- a wholly-owned subsidiary: a failed "where" on a "may" (periods ruling (b); split site (ii)); paragraph (d) says no
#ASSERT `Under section 21(6E)(e), may a dividend or other distribution of the holding company's assets be paid or made to the subsidiary in respect of the shares, as paragraph (e) provides` FALSE FALSE EQUALS NOTHING   -- other shares: the text says nothing

-- Under section 21(6F), how many excess shares are there
#ASSERT `Under section 21(6F), how many excess shares are there` 101 1005 EQUALS 1   -- 10% of 1,005 is 100.5, so 100 shares are within the limit and 101 held is 1 over
#ASSERT `Under section 21(6F), how many excess shares are there` 100 1005 EQUALS 0   -- within the limit: no excess
#ASSERT `Under section 21(6F), how many excess shares are there` 150 1000 EQUALS 50   -- 10% of 1,000 is 100; 150 held is 50 over
#ASSERT `Under section 21(6F), how many excess shares are there` 0 0 EQUALS 0   -- no shares: no excess

-- Under section 21(6G), what does the reference include
#ASSERT `Under section 21(6G), what does the reference include` "78" `s 21(6G)(a) a reference to treasury shares` EQUALS JUST "a reference to shares held by a subsidiary under subsection (4B) or (6C)"   -- "(a) a reference to 'treasury shares' includes a reference to shares held by a subsidiary under subsection (4B) or (6C)"
#ASSERT `Under section 21(6G), what does the reference include` "232(1)(a)(i)" `s 21(6G)(b) a reference to a company being registered as a member of itself or being a member of itself` EQUALS JUST "a reference to a subsidiary being registered as a member of its holding company"   -- "(b) ... includes a reference to a subsidiary being registered as a member of its holding company"
#ASSERT `Under section 21(6G), what does the reference include` "215(1D)" `s 21(6G)(a) a reference to treasury shares` EQUALS JUST "a reference to shares held by a subsidiary under subsection (4B) or (6C)"   -- "215(1), (1C), (1D) and (3A)": the third of the four
#ASSERT `Under section 21(6G), what does the reference include` "7(9)(ca)" `s 21(6G)(a) a reference to treasury shares` EQUALS JUST "a reference to shares held by a subsidiary under subsection (4B) or (6C)"   -- the first listed
#ASSERT `Under section 21(6G), what does the reference include` "76J" `s 21(6G)(a) a reference to treasury shares` EQUALS NOTHING   -- a section not listed: the text says nothing
#ASSERT `Under section 21(6G), what does the reference include` "78" `s 21(6G) another reference` EQUALS NOTHING   -- another kind of reference: the text says nothing

-- Under section 21(7), may the holding company on behalf of the subsidiary sell the shares for which the subsidiary would otherwise have been entitled to subscribe
#ASSERT `Under section 21(7), may the holding company on behalf of the subsidiary sell the shares for which the subsidiary would otherwise have been entitled to subscribe` TRUE EQUALS JUST TRUE   -- "Where but for this section a subsidiary would have been entitled to subscribe for shares in the holding company, the holding company may, on behalf of the subsidiary, sell the shares"
#ASSERT `Under section 21(7), may the holding company on behalf of the subsidiary sell the shares for which the subsidiary would otherwise have been entitled to subscribe` FALSE EQUALS JUST FALSE   -- no such entitlement: a failed "where" on a "may" (periods ruling (b); split site (ii))

-- Under section 21(8), does the reference to shares in this section include a reference to the interest of the members as such, whatever the form of that interest
#ASSERT `Under section 21(8), does the reference to shares in this section include a reference to the interest of the members as such, whatever the form of that interest` `limited by guarantee` EQUALS JUST TRUE   -- "In relation to a holding company that is a company limited by guarantee"
#ASSERT `Under section 21(8), does the reference to shares in this section include a reference to the interest of the members as such, whatever the form of that interest` `limited by shares` EQUALS NOTHING   -- any other holding company: the text says nothing
#ASSERT `Under section 21(8), does the reference to shares in this section include a reference to the interest of the members as such, whatever the form of that interest` `unlimited` EQUALS NOTHING   -- any other holding company: the text says nothing
#ASSERT `Under section 21(8), does the reference to shares in this section include a reference to the interest of the members as such, whatever the form of that interest` `limited by shares and by guarantee` EQUALS NOTHING   -- a company limited both by shares and by guarantee is not named

-- Under section 21(9), must the company inform the Registrar of the occurrence of the event by lodging a notice in the prescribed form
#ASSERT `Under section 21(9), must the company inform the Registrar of the occurrence of the event by lodging a notice in the prescribed form` `s 21(9)(a) a shareholder of a company that is a corporation becomes a subsidiary of the company` EQUALS JUST TRUE   -- "(a) where a shareholder of a company that is a corporation becomes a subsidiary of the company"
#ASSERT `Under section 21(9), must the company inform the Registrar of the occurrence of the event by lodging a notice in the prescribed form` `s 21(9)(b) shares of the company are held by a subsidiary of the company and there is a change in the number of shares held by the subsidiary` EQUALS JUST TRUE   -- "(b) where shares of the company are held by a subsidiary of the company and there is a change in the number of shares held by the subsidiary"
#ASSERT `Under section 21(9), must the company inform the Registrar of the occurrence of the event by lodging a notice in the prescribed form` `s 21(9) another event` EQUALS NOTHING   -- "any of the following events": the text does not say "only"

-- Under section 21(9), did the company lodge the notice with the Registrar in time
#ASSERT `Under section 21(9), did the company lodge the notice with the Registrar in time` `s 21(9)(a) a shareholder of a company that is a corporation becomes a subsidiary of the company` (Date 1 5 2026) (Date 15 5 2026) EQUALS JUST TRUE   -- "within 14 days after the date of occurrence": 1 May plus 14 days is 15 May
#ASSERT `Under section 21(9), did the company lodge the notice with the Registrar in time` `s 21(9)(a) a shareholder of a company that is a corporation becomes a subsidiary of the company` (Date 1 5 2026) (Date 16 5 2026) EQUALS JUST FALSE   -- one day late (periods ruling (a))
#ASSERT `Under section 21(9), did the company lodge the notice with the Registrar in time` `s 21(9)(b) shares of the company are held by a subsidiary of the company and there is a change in the number of shares held by the subsidiary` (Date 1 5 2026) (Date 1 5 2026) EQUALS JUST TRUE   -- the day of occurrence is in time (fork line F-H-P2)
#ASSERT `Under section 21(9), did the company lodge the notice with the Registrar in time` `s 21(9) another event` (Date 1 5 2026) (Date 15 5 2026) EQUALS NOTHING   -- another event: the text says nothing

§ `What the constitution must state (section 22)`

-- Under section 22(1), must the constitution state the matter
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(a) the name of the company` `limited by shares` EQUALS JUST TRUE   -- "(a) the name of the company"
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(a) the name of the company` `unlimited` EQUALS JUST TRUE   -- "(a)" applies to every company
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(b) that the liability of the members is limited` `limited by shares` EQUALS JUST TRUE   -- "(b) if the company is a company limited by shares -- that the liability of the members is limited"
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(b) that the liability of the members is limited` `limited by guarantee` EQUALS JUST FALSE   -- not a company limited by shares: an "if" gate unmet on a duty (marginal reading (a))
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(b) that the liability of the members is limited` `limited by shares and by guarantee` EQUALS NOTHING   -- a company limited both by shares and by guarantee is not named
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(c) that the liability of the members is limited and that each member undertakes to contribute to the assets of the company in the event of its being wound up` `limited by guarantee` EQUALS JUST TRUE   -- "(c) if the company is a company limited by guarantee"
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(c) that the liability of the members is limited and that each member undertakes to contribute to the assets of the company in the event of its being wound up` `limited by shares` EQUALS JUST FALSE   -- not a company limited by guarantee: an "if" gate unmet
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(c) that the liability of the members is limited and that each member undertakes to contribute to the assets of the company in the event of its being wound up` `limited by shares and by guarantee` EQUALS NOTHING   -- not named
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(d) that the liability of the members is unlimited` `unlimited` EQUALS JUST TRUE   -- "(d) if the company is an unlimited company"
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(d) that the liability of the members is unlimited` `limited by shares` EQUALS JUST FALSE   -- not an unlimited company: an "if" gate unmet
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(d) that the liability of the members is unlimited` `limited by shares and by guarantee` EQUALS NOTHING   -- not named
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(e) the number of members with which the company is applying to be registered` `unlimited` EQUALS JUST TRUE   -- "(e) if the company is an unlimited company or a company limited by guarantee"
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(e) the number of members with which the company is applying to be registered` `limited by guarantee` EQUALS JUST TRUE   -- the other kind in (e)
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(e) the number of members with which the company is applying to be registered` `limited by shares` EQUALS JUST FALSE   -- a company limited by shares: an "if" gate unmet
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(e) the number of members with which the company is applying to be registered` `limited by shares and by guarantee` EQUALS NOTHING   -- not named
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(f) the full names, addresses and occupations of the subscribers to the constitution of the company` `limited by shares` EQUALS JUST TRUE   -- "(f) the full names, addresses and occupations of the subscribers"
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1)(g) that the subscribers are desirous of being formed into a company in pursuance of the constitution` `unlimited` EQUALS JUST TRUE   -- "(g) that such subscribers are desirous of being formed into a company"
#ASSERT `Under section 22(1), must the constitution state the matter` `s 22(1) another matter` `limited by shares` EQUALS NOTHING   -- "in addition to other requirements": the others are prescribed elsewhere (includes)

-- Under section 22(1), does the constitution comply with the subsection
#ASSERT `Under section 22(1), does the constitution comply with the subsection` `limited by shares` TRUE TRUE TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- as above: complies
#ASSERT `Under section 22(1), does the constitution comply with the subsection` `limited by shares` TRUE FALSE TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE TRUE EQUALS JUST FALSE   -- not dated: a duty not fully met (marginal reading (a))
#ASSERT `Under section 22(1), does the constitution comply with the subsection` `limited by shares and by guarantee` TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING   -- a company limited both by shares and by guarantee: the paragraphs name no requirement

-- Under section 22(1AA), must the company lodge with the Registrar a notice of the change
#ASSERT `Under section 22(1AA), must the company lodge with the Registrar a notice of the change` `unlimited` TRUE EQUALS JUST TRUE   -- "a company to which subsection (1)(e) applies": an unlimited company
#ASSERT `Under section 22(1AA), must the company lodge with the Registrar a notice of the change` `limited by guarantee` TRUE EQUALS JUST TRUE   -- a company limited by guarantee
#ASSERT `Under section 22(1AA), must the company lodge with the Registrar a notice of the change` `limited by guarantee` FALSE EQUALS JUST FALSE   -- no change: a duty whose "where" gate is unmet (marginal reading (a))
#ASSERT `Under section 22(1AA), must the company lodge with the Registrar a notice of the change` `limited by shares` TRUE EQUALS NOTHING   -- a company limited by shares: the text says nothing

-- Under section 22(1AA), did the company lodge the notice of the change in time
#ASSERT `Under section 22(1AA), did the company lodge the notice of the change in time` (Date 1 5 2026) (Date 15 5 2026) EQUALS JUST TRUE   -- "within 14 days after the occurrence of such change": 1 May plus 14 days is 15 May
#ASSERT `Under section 22(1AA), did the company lodge the notice of the change in time` (Date 1 5 2026) (Date 1 5 2026) EQUALS JUST TRUE   -- the day of the change is in time (fork line F-H-P2)
#ASSERT `Under section 22(1AA), did the company lodge the notice of the change in time` (Date 1 5 2026) (Date 16 5 2026) EQUALS JUST FALSE   -- one day late: a period the text fixes in its own words (periods ruling (a))
#ASSERT `Under section 22(1AA), did the company lodge the notice of the change in time` (Date 1 5 2026) (Date 30 4 2026) EQUALS JUST FALSE   -- before the change: not "after" it

-- Under section 22(1AB), am I, as the company or an officer in default, guilty of an offence
#ASSERT `Under section 22(1AB), am I, as the company or an officer in default, guilty of an offence` TRUE TRUE EQUALS JUST TRUE   -- "the company and every officer of the company who is in default shall each be guilty of an offence"
#ASSERT `Under section 22(1AB), am I, as the company or an officer in default, guilty of an offence` TRUE FALSE EQUALS JUST FALSE   -- an officer not in default: an element unmet (split site (i))
#ASSERT `Under section 22(1AB), am I, as the company or an officer in default, guilty of an offence` FALSE TRUE EQUALS JUST FALSE   -- no default in complying with (1AA): an element unmet (split site (i))

-- Under section 22(1AB), what is the most I may be sentenced to on conviction
#ASSERT `Under section 22(1AB), what is the most I may be sentenced to on conviction` TRUE TRUE EQUALS JUST (Penalty OF 2000, 0, FALSE, TRUE)   -- "a fine not exceeding $2,000 and also to a default penalty": no imprisonment, and the default penalty is added
#ASSERT `Under section 22(1AB), what is the most I may be sentenced to on conviction` TRUE FALSE EQUALS NOTHING   -- not guilty: the subsection states no penalty for them

-- Under section 22(1A), is the provision deemed to be deleted, insofar as it relates to those matters
#ASSERT `Under section 22(1A), is the provision deemed to be deleted, insofar as it relates to those matters` TRUE TRUE FALSE EQUALS JUST TRUE   -- "(a) the amount of share capital with which the company proposes to be or is registered"
#ASSERT `Under section 22(1A), is the provision deemed to be deleted, insofar as it relates to those matters` TRUE FALSE TRUE EQUALS JUST TRUE   -- "(b) the division of the share capital of the company into shares of a fixed amount"
#ASSERT `Under section 22(1A), is the provision deemed to be deleted, insofar as it relates to those matters` TRUE TRUE TRUE EQUALS JUST TRUE   -- "either or both of paragraphs (a) and (b)"
#ASSERT `Under section 22(1A), is the provision deemed to be deleted, insofar as it relates to those matters` TRUE FALSE FALSE EQUALS NOTHING   -- states neither: outside the class the deeming reaches, a scope limit with no "only" (periods ruling (c)); was JUST FALSE before the wave-2 reader
#ASSERT `Under section 22(1A), is the provision deemed to be deleted, insofar as it relates to those matters` FALSE TRUE FALSE EQUALS JUST FALSE   -- not subsisting on that day: a failed "on" gate (periods ruling (b))

-- Under section 22(2), must the subscriber make a declaration to the Registrar as to the number of shares the subscriber agrees to take
#ASSERT `Under section 22(2), must the subscriber make a declaration to the Registrar as to the number of shares the subscriber agrees to take` TRUE EQUALS JUST TRUE   -- "Each subscriber to the constitution must, if the company is to have a share capital, make a declaration to the Registrar"
#ASSERT `Under section 22(2), must the subscriber make a declaration to the Registrar as to the number of shares the subscriber agrees to take` FALSE EQUALS JUST FALSE   -- no share capital: an "if" gate unmet on a duty (marginal reading (a))

-- Under section 22(2), is the declaration made in a way the subsection allows
#ASSERT `Under section 22(2), is the declaration made in a way the subsection allows` TRUE FALSE EQUALS JUST TRUE   -- "either personally"
#ASSERT `Under section 22(2), is the declaration made in a way the subsection allows` FALSE TRUE EQUALS JUST TRUE   -- "or through a registered qualified individual authorised by the subscriber"
#ASSERT `Under section 22(2), is the declaration made in a way the subsection allows` FALSE FALSE EQUALS JUST FALSE   -- any other way: "either ... or" is a closed pair

-- Under section 22(2), is the number of shares the subscriber agrees to take a number the subsection allows
#ASSERT `Under section 22(2), is the number of shares the subscriber agrees to take a number the subsection allows` 1 EQUALS JUST TRUE   -- "(not being less than one)": exactly one
#ASSERT `Under section 22(2), is the number of shares the subscriber agrees to take a number the subsection allows` 5 EQUALS JUST TRUE   -- more than one
#ASSERT `Under section 22(2), is the number of shares the subscriber agrees to take a number the subsection allows` 0 EQUALS JUST FALSE   -- none

-- Under section 22(3), what is the most the member is liable to contribute
#ASSERT `Under section 22(3), what is the most the member is liable to contribute` `limited by shares` TRUE 250 EQUALS JUST 250   -- "the liability of the members is limited to the amount (if any) unpaid on the shares respectively held by them"
#ASSERT `Under section 22(3), what is the most the member is liable to contribute` `limited by shares` TRUE 0 EQUALS JUST 0   -- nothing unpaid: "(if any)"
#ASSERT `Under section 22(3), what is the most the member is liable to contribute` `limited by shares` FALSE 250 EQUALS NOTHING   -- no such statement in the constitution: the sentence does not speak
#ASSERT `Under section 22(3), what is the most the member is liable to contribute` `limited by guarantee` TRUE 250 EQUALS NOTHING   -- a company limited by guarantee: the sentence is about a company limited by shares

-- Under section 22(4), is the copy of the constitution kept as the subsection requires
#ASSERT `Under section 22(4), is the copy of the constitution kept as the subsection requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE   -- "duly signed by the subscribers and stating ... the number of shares that each subscriber has agreed to take, must be kept at the registered office of the company"
#ASSERT `Under section 22(4), is the copy of the constitution kept as the subsection requires` TRUE FALSE FALSE TRUE EQUALS JUST TRUE   -- no share capital: the number of shares need not be stated ("if the company is to have a share capital")
#ASSERT `Under section 22(4), is the copy of the constitution kept as the subsection requires` TRUE TRUE FALSE TRUE EQUALS JUST FALSE   -- share capital but the number of shares not stated
#ASSERT `Under section 22(4), is the copy of the constitution kept as the subsection requires` FALSE TRUE TRUE TRUE EQUALS JUST FALSE   -- not duly signed
#ASSERT `Under section 22(4), is the copy of the constitution kept as the subsection requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE   -- not kept at the registered office


