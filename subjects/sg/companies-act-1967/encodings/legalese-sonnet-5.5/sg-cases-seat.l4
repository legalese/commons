#ASSERT `Under section 12E(3), must the Registrar cause the exclusion of my residential address from public access to resume` TRUE FALSE FALSE FALSE EQUALS JUST FALSE   -- neither limb of the "if": the duty does not arise
#ASSERT `Under section 12E(3), must the Registrar cause the exclusion of my residential address from public access to resume` FALSE TRUE FALSE TRUE EQUALS JUST FALSE   -- the address has not ceased to be excluded: a failed "Where"

