#ASSERT `Under section 160(1), are the directors barred from carrying proposals for disposing of the undertaking or property into effect` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 160(2), may the Court restrain the directors from entering into a transaction in contravention of section 160(1)` TRUE TRUE EQUALS JUST TRUE
-- a "may" gated by "on the application": group 3, ruling (b)
#ASSERT `Under section 160(2), may the Court restrain the directors from entering into a transaction in contravention of section 160(1)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under section 160(3), is a transaction in contravention of section 160(1) as valid as if it had been complied with` TRUE TRUE FALSE EQUALS JUST TRUE
-- no valuable consideration: the text speaks only of a person dealing "for valuable consideration"
#ASSERT `Under section 160(3), is a transaction in contravention of section 160(1) as valid as if it had been complied with` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `Under section 160(4), does section 160 not apply to proposals made by a receiver and manager or a liquidator` TRUE FALSE EQUALS JUST TRUE
-- other makers: the text names two and says nothing of the rest
#ASSERT `Under section 160(4), does section 160 not apply to proposals made by a receiver and manager or a liquidator` FALSE FALSE EQUALS NOTHING
-- SCENARIOS, told as a person would tell them. Each expected value follows from the quoted words.

-- A. The sole director of a company with one director declares an interest. "Where a company only has one director, that director may make a declaration ... by recording the declaration and signing the record" (s 157B).
#ASSERT `Under section 157B, may the sole director of a company make a declaration by recording it and signing the record` 1 EQUALS JUST TRUE
#ASSERT `Under section 157B, does the recording and signing of a declaration satisfy the requirement that it be made at a meeting of the directors` 1 TRUE EQUALS JUST TRUE
-- A company with two directors is outside section 157B ("Where a company only has one director").
#ASSERT `Under section 157B, may the sole director of a company make a declaration by recording it and signing the record` 2 EQUALS JUST FALSE

-- B. An undischarged bankrupt takes a seat on a board without permission: guilty, and the fine and term are at most $10,000 and 2 years, or both (s 148(1)).
#ASSERT `Under section 148(1), is an undischarged bankrupt who acts as director of, or takes part in the management of, a corporation without permission guilty of an offence` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 148(1), what is the most an undischarged bankrupt may be penalised on conviction for acting as director without permission` TRUE FALSE TRUE FALSE FALSE EQUALS JUST (`s 148(1) penalty` OF 10000, 24, TRUE)
-- With the permission of the Court the same person commits no offence under the subsection.
#ASSERT `Under section 148(1), is an undischarged bankrupt who acts as director of, or takes part in the management of, a corporation without permission guilty of an offence` TRUE FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- Permission issued on 1 June 2026: the copy is due by 15 June 2026 and a copy lodged on 16 June is out of time (s 148(4): "within 14 days after the issue").
#ASSERT `Under section 148(4), what is the last day for lodging a copy of the Court order or written permission with the Registrar` (Date 1 6 2026) EQUALS (Date 15 6 2026)
#ASSERT `Under section 148(4), has a person granted permission lodged the copy within the time the subsection allows` TRUE (Date 1 6 2026) (Date 16 6 2026) EQUALS JUST FALSE

-- C. A director appointed on 15 January 2026 whose constitution requires a share qualification (s 147(1): "within 2 months after his or her appointment").
#ASSERT `Under section 147(1), what is the last day on which a director must have obtained the qualification` (Date 15 1 2026) FALSE 0 EQUALS (Date 15 3 2026)
#ASSERT `Under section 147(1), has a director obtained the qualification in time` TRUE TRUE (Date 15 1 2026) FALSE 0 (Date 15 3 2026) EQUALS JUST TRUE
#ASSERT `Under section 147(1), has a director obtained the qualification in time` TRUE TRUE (Date 15 1 2026) FALSE 0 (Date 16 3 2026) EQUALS JUST FALSE
-- Out of time, so the director must vacate office (s 147(3)), and cannot be re-appointed until qualified (s 147(5)).
#ASSERT `Under section 147(3), must a director vacate office` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 147(5), is a person who vacated office under section 147 incapable of being re-appointed as director until the qualification is obtained` TRUE FALSE EQUALS JUST TRUE

-- D. A 17-year-old is asked to be a director (s 145(2): "No person other than a natural person who has attained the age of 18 years ... may be a director").
#ASSERT `Under section 145(2), is a person barred from being a director of a company` TRUE 17 TRUE EQUALS JUST TRUE
#ASSERT `Under section 145(2), is a person barred from being a director of a company` TRUE 18 TRUE EQUALS NOTHING

-- E. A director with a declarable interest in a company that is a member of the group (s 156). The director is interested, the interest is material, and the director has declared at a meeting.
#ASSERT `Under section 156(1), must a director or chief executive officer declare the nature of an interest in a transaction or send a written notice` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 156(1), has a person made the declaration or sent the written notice the subsection requires` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 156(15), is a director or chief executive officer who fails to comply with section 156 guilty of an offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 156(15), what is the most a director or chief executive officer may be penalised on conviction for failing to comply with section 156` TRUE TRUE EQUALS JUST (`s 156(15) penalty` OF 5000, 12, FALSE)
-- The director is a spouse's interest holder: a spouse's interest is treated as the director's (s 156(13)).
#ASSERT `Under section 156(13), is a person a member of the director's or chief executive officer's family whose interest is treated as an interest of the director or chief executive officer` `s 156(13) spouse` EQUALS JUST TRUE
-- A director who became a director on 1 June 2026 must declare a conflict at the first meeting held after: meetings on 10 June, 10 July and 10 August 2026 (s 156(7)).
#ASSERT `Under section 156(7), at which meeting of the directors must a person declare a conflict of duty or interest` FALSE (Date 1 6 2026) (Date 1 6 2026) (Date 10 6 2026) (Date 10 7 2026) (Date 10 8 2026) EQUALS JUST (Date 10 6 2026)
#ASSERT `Under section 156(7), at which meeting of the directors must a person declare a conflict of duty or interest` TRUE (Date 1 6 2026) (Date 1 7 2026) (Date 10 6 2026) (Date 10 7 2026) (Date 10 8 2026) EQUALS JUST (Date 10 7 2026)
-- A chief executive officer's written notice goes to all the directors; a director's goes to all the other directors (s 156(9)).
#ASSERT `Under section 156(9), to whom must the company send a copy of the written notice` TRUE TRUE FALSE EQUALS `s 156(9)(a) all the directors`
#ASSERT `Under section 156(9), to whom must the company send a copy of the written notice` TRUE FALSE TRUE EQUALS `s 156(9)(b) all the other directors`

-- F. A member of a public company moves to remove a director (s 152).
#ASSERT `Under section 152(1), may a public company by ordinary resolution remove a director before the expiration of the period of office` FALSE `an ordinary resolution` TRUE EQUALS JUST TRUE
#ASSERT `Under section 152(2), must the company immediately send a copy of the notice of an intended resolution to the director concerned` TRUE EQUALS JUST TRUE
#ASSERT `Under section 152(2), is the director entitled to be heard on the resolution at the meeting` TRUE EQUALS JUST TRUE
-- A private company removes by ordinary resolution subject to the constitution (s 152(9)): the constitution says nothing contrary.
#ASSERT `Under section 152(9), may a private company by ordinary resolution remove a director before the expiration of the period of office` TRUE FALSE `an ordinary resolution` TRUE EQUALS JUST TRUE

-- G. A director sells the whole undertaking without a general meeting (s 160).
#ASSERT `Under section 160(1), are the directors barred from carrying proposals for disposing of the undertaking or property into effect` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 160(1), are the directors barred from carrying proposals for disposing of the undertaking or property into effect` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- A buyer who paid and did not know of the contravention: the transaction is as valid as if section 160(1) had been complied with (s 160(3)).
#ASSERT `Under section 160(3), is a transaction in contravention of section 160(1) as valid as if it had been complied with` TRUE TRUE FALSE EQUALS JUST TRUE

-- H. A director discloses company information to the person the director represents (s 158).
#ASSERT `Under section 158(1), may a director disclose information the director has in his or her capacity as a director or employee` TRUE `s 158(2)(a) a person whose interests the director represents` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 158(1), may a director disclose information the director has in his or her capacity as a director or employee` TRUE `s 158(2)(a) a person whose interests the director represents` FALSE TRUE EQUALS NOTHING

-- I. An officer makes improper use of information to gain an advantage (s 157(2)) and so is liable to the company for the profit made and guilty of an offence (s 157(3)).
#ASSERT `Under section 157(2), does an officer or agent contravene the subsection by making improper use of position or information` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 157(3), does an officer or agent commit a breach of a provision of section 157` FALSE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 157(3)(a), what profit is an officer or agent liable to the company for` TRUE 500 EQUALS JUST 500
#ASSERT `Under section 157(3)(b), what is the most an officer or agent may be penalised on conviction` TRUE TRUE EQUALS JUST (`s 157(3)(b) penalty` OF 20000, 12, TRUE)

