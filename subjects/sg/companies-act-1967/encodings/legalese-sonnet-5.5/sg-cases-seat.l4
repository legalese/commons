#ASSERT `Under section 63A(1), is the public company late in lodging the return of the allotment` TRUE TRUE (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 1 6 2026) EQUALS JUST FALSE
-- the company is listed on an approved exchange in Singapore: the return need not state the particulars of the 50 largest members
#ASSERT `Under section 63A(2), need the return of allotment not state the particulars of the 50 largest members` TRUE FALSE FALSE EQUALS JUST TRUE
-- an unlisted company is not covered by the relief
#ASSERT `Under section 63A(2), need the return of allotment not state the particulars of the 50 largest members` FALSE FALSE FALSE EQUALS NOTHING
-- default is made and I am an officer in default
#ASSERT `Under section 63A(3), am I, as an officer in default, guilty of the offence` TRUE TRUE EQUALS JUST TRUE
-- I am not an officer in default
#ASSERT `Under section 63A(3), am I, as an officer in default, guilty of the offence` TRUE FALSE EQUALS JUST FALSE
-- a fine not exceeding $4,000 (and a default penalty of $250)
#ASSERT `Under section 63A(3), what is the highest fine I may be sentenced to, in Singapore dollars` TRUE TRUE EQUALS JUST 4000
-- shares allotted for a contract in writing and the contract is not lodged with the return: in default
#ASSERT `Under section 63B(1), is the company in default of the duty to lodge the contract with the return of allotment` TRUE TRUE FALSE EQUALS JUST TRUE
-- the contract is lodged: the duty is done
#ASSERT `Under section 63B(1), is the company in default of the duty to lodge the contract with the return of allotment` TRUE TRUE TRUE EQUALS JUST FALSE
-- allotted for cash: the "where" gate is not met
#ASSERT `Under section 63B(1), is the company in default of the duty to lodge the contract with the return of allotment` FALSE TRUE FALSE EQUALS JUST FALSE
-- allotted otherwise than in cash under a contract not reduced to writing, and the statement of particulars is not lodged with the return: in default
#ASSERT `Under section 63B(3), is the company in default of the duty to lodge the document specified in subsection (4) with the return of allotment` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- the document is lodged within the time of subsection (5)
#ASSERT `Under section 63B(3), is the company in default of the duty to lodge the document specified in subsection (4) with the return of allotment` TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE
-- none of the three kinds of allotment: the duty does not arise
#ASSERT `Under section 63B(3), is the company in default of the duty to lodge the document specified in subsection (4) with the return of allotment` TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- default is made and I am an officer in default
