-- Under schedule 12 paragraph 4, must the directors' statement of the parent company state the corporation and the other particulars?
#ASSERT `Under schedule 12 paragraph 4, must the directors' statement of the parent company state the corporation and the other particulars` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under schedule 12 paragraph 4, must the directors' statement of the parent company state the corporation and the other particulars` TRUE FALSE EQUALS JUST FALSE

-- Under schedule 12 paragraph 4, does the directors' statement state the corporation and the other particulars?
-- not a parent company, or no option granted by it or a subsidiary corporation
#ASSERT `Under schedule 12 paragraph 4, does the directors' statement state the corporation and the other particulars` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Under schedule 12 paragraph 4, does the directors' statement state the corporation and the other particulars` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- the corporation's name missing, the other particulars missing
#ASSERT `Under schedule 12 paragraph 4, does the directors' statement state the corporation and the other particulars` TRUE TRUE FALSE TRUE EQUALS JUST FALSE

-- Under schedule 12 paragraph 5, does the directors' statement state the particulars of shares issued on the exercise of options?
-- no shares issued on the exercise of options: the paragraph is silent
#ASSERT `Under schedule 12 paragraph 5, does the directors' statement state the particulars of shares issued on the exercise of options` FALSE TRUE EQUALS NOTHING
#ASSERT `Under schedule 12 paragraph 5, does the directors' statement state the particulars of shares issued on the exercise of options` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under schedule 12 paragraph 5, does the directors' statement state the particulars of shares issued on the exercise of options` TRUE FALSE EQUALS JUST FALSE

-- Under schedule 12 paragraph 6, does the directors' statement state the unissued shares under option?
-- no unissued shares under option at the end of the period
#ASSERT `Under schedule 12 paragraph 6, does the directors' statement state the unissued shares under option` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Under schedule 12 paragraph 6, does the directors' statement state the unissued shares under option` TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
-- each of the four items missing in turn
#ASSERT `Under schedule 12 paragraph 6, does the directors' statement state the unissued shares under option` TRUE FALSE TRUE TRUE TRUE EQUALS JUST FALSE

-- Under schedule 12 paragraph 7, does the directors' statement state the names of the directors in office?
#ASSERT `Under schedule 12 paragraph 7, does the directors' statement state the names of the directors in office` TRUE EQUALS JUST TRUE
#ASSERT `Under schedule 12 paragraph 7, does the directors' statement state the names of the directors in office` FALSE EQUALS JUST FALSE

-- Under schedule 12 paragraph 8, must the directors' statement also explain the effect of the arrangements and name the directors?
#ASSERT `Under schedule 12 paragraph 8, must the directors' statement also explain the effect of the arrangements and name the directors` TRUE EQUALS JUST TRUE
#ASSERT `Under schedule 12 paragraph 8, must the directors' statement also explain the effect of the arrangements and name the directors` FALSE EQUALS JUST FALSE

-- Under schedule 12 paragraph 8, does the directors' statement state whether the arrangements subsisted and, if so, their effect?
-- the statement says whether, no such arrangements subsisted: nothing more is asked
#ASSERT `Under schedule 12 paragraph 8, does the directors' statement state whether the arrangements subsisted and, if so, their effect` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- the names missing, the explanation missing
#ASSERT `Under schedule 12 paragraph 8, does the directors' statement state whether the arrangements subsisted and, if so, their effect` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

-- Under schedule 12 paragraph 9, does the directors' statement state the director's interests in shares and debentures?
-- not a director at the end of the financial year
#ASSERT `Under schedule 12 paragraph 9, does the directors' statement state the director's interests in shares and debentures` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
-- (a) not said at all
#ASSERT `Under schedule 12 paragraph 9, does the directors' statement state the director's interests in shares and debentures` TRUE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- (a) said, not interested at the end of the year: nothing more is asked
