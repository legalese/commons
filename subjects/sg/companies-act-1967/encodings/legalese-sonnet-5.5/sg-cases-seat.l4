-- Under section 211(7), does the section give me a defence?
-- (7): the defence
#ASSERT `Under section 211(7), does the section give me a defence` TRUE EQUALS JUST TRUE
#ASSERT `Under section 211(7), does the section give me a defence` FALSE EQUALS JUST FALSE

-- Under section 211(5), am I guilty of the offence as an officer in default?
