#ASSERT `Under section 146(1), is a person barred from being named as a director or proposed director` `s 146(1)(a) in a document filed or lodged with or submitted to the Registrar for the purposes of the incorporation of a company` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 146(1A)(a), has a person made the filings that paragraph (a) requires` TRUE TRUE TRUE EQUALS JUST TRUE
-- (iii) is missing
#ASSERT `Under section 146(1A)(a), has a person made the filings that paragraph (a) requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- (i)
#ASSERT `Under section 146(1A)(b), has a person made the filing that paragraph (b) requires` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (iv) without the declaration
#ASSERT `Under section 146(1A)(b), has a person made the filing that paragraph (b) requires` FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 146(2), is a person who has undertaken to take and pay for qualification shares in the same position as if the person had signed the constitution for those shares` TRUE EQUALS JUST TRUE
-- a "where" condition that fails (ruling (b))
#ASSERT `Under section 146(2), is a person who has undertaken to take and pay for qualification shares in the same position as if the person had signed the constitution for those shares` FALSE EQUALS JUST FALSE
-- on the last day of the first year the year has not expired
#ASSERT `Under section 146(3)(c), is a prospectus, statement in lieu of prospectus or constitution outside section 146(1) and (2) because more than a year has passed since the company was entitled to commence business` TRUE (Date 1 1 2027) (Date 1 1 2026) EQUALS NOTHING
-- the day after the year expires
#ASSERT `Under section 146(3)(c), is a prospectus, statement in lieu of prospectus or constitution outside section 146(1) and (2) because more than a year has passed since the company was entitled to commence business` TRUE (Date 2 1 2027) (Date 1 1 2026) EQUALS JUST TRUE
-- (a)
#ASSERT `Under section 146(3), do the requirements of section 146(1) and (2), other than those on signing a consent to act as director, not apply` TRUE FALSE FALSE EQUALS JUST TRUE
-- a public company with a share capital, no document in (c): the exemption is not met
#ASSERT `Under section 146(3), do the requirements of section 146(1) and (2), other than those on signing a consent to act as director, not apply` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 146(4), is the company or an officer in default guilty of an offence for default in complying with section 146` TRUE TRUE EQUALS JUST TRUE
-- not in default
#ASSERT `Under section 146(4), is the company or an officer in default guilty of an offence for default in complying with section 146` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 146(4), what is the most the company or an officer in default may be penalised on conviction` TRUE TRUE EQUALS JUST (`s 146(4) penalty` OF 10000, TRUE)
#ASSERT `Under section 146(4), what is the most the company or an officer in default may be penalised on conviction` FALSE TRUE EQUALS NOTHING
#ASSERT `Under section 146(5), do the restrictions in section 146 apply to a director or proposed director of a foreign company` TRUE TRUE EQUALS JUST TRUE
-- not a foreign company
