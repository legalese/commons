-- ====================================================================================================
-- cases-seat questions from part sgc2 (merged by the lead; unchanged text follows)
-- ====================================================================================================
-- Cases for the seat layer sgc2-seat.l4: every question is asked at least once, each answer written from the text of the section (not copied from the code's output), and
-- most thresholds are asked on both sides. A date is Date day month year. Arguments follow the question's own GIVEN lines, in order.

§ `Section 205: appointing, removing and replacing the auditor`

-- 205(1): three months after incorporation; a company incorporated on 1 January 2026 must have its first auditor by 1 April; 30 November 2025 + 3 months clamps to 28 February 2026.
#ASSERT `Under section 205(1), what is the last day for the directors to appoint the first auditor` (Date 1 1 2026) EQUALS Date 1 4 2026
#ASSERT `Under section 205(1), what is the last day for the directors to appoint the first auditor` (Date 30 11 2025) EQUALS Date 28 2 2026
-- Appointed on 1 April: in time. On 2 April: in default. Not appointed: still running on 1 April, in default on 2 April.
#ASSERT `Under section 205(1), are the directors in default of the duty to appoint the first auditor` (Date 1 1 2026) TRUE (Date 1 4 2026) (Date 1 7 2026) EQUALS JUST FALSE
#ASSERT `Under section 205(1), are the directors in default of the duty to appoint the first auditor` (Date 1 1 2026) TRUE (Date 2 4 2026) (Date 1 7 2026) EQUALS JUST TRUE
#ASSERT `Under section 205(1), are the directors in default of the duty to appoint the first auditor` (Date 1 1 2026) FALSE (Date 1 1 2000) (Date 1 4 2026) EQUALS JUST FALSE
#ASSERT `Under section 205(1), are the directors in default of the duty to appoint the first auditor` (Date 1 1 2026) FALSE (Date 1 1 2000) (Date 2 4 2026) EQUALS JUST TRUE
-- 205(2): a meeting was held and no auditor appointed: in default; appointed: not in default.
#ASSERT `Under section 205(2), is the company in default of the duty to appoint an auditor at the annual general meeting` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 205(2), is the company in default of the duty to appoint an auditor at the annual general meeting` TRUE TRUE EQUALS JUST FALSE
-- 205(3): a casual vacancy, an accounting entity, nothing else governing: the directors may. A vacancy but the person is not an accounting entity: the text does not say (NOTHING).
#ASSERT `Under section 205(3), may the directors appoint the accounting entity to fill the casual vacancy` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 205(3), may the directors appoint the accounting entity to fill the casual vacancy` TRUE FALSE FALSE EQUALS NOTHING
-- Where subsection (7), (8) or section 205AF governs the vacancy, this subsection does not answer.
#ASSERT `Under section 205(3), may the directors appoint the accounting entity to fill the casual vacancy` TRUE TRUE TRUE EQUALS NOTHING
-- 205(4): removal needs a resolution at a general meeting, with special notice, "but not otherwise".
#ASSERT `Under section 205(4), may the auditor be removed from office by the resolution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 205(4), may the auditor be removed from office by the resolution` TRUE FALSE EQUALS JUST FALSE
-- 205(5)(a): notice received; copies to the auditor and the Registrar, immediately.
#ASSERT `Under section 205(5)(a), is the company in default of the duty to send a copy of the notice` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 205(5)(a), is the company in default of the duty to send a copy of the notice` TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 205(5)(a), is the company in default of the duty to send a copy of the notice` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- 205(5)(b): received on 1 March; representations within 7 days (8 March: in time; 9 March: out); in writing, of reasonable length; asked before the meeting on 20 March.
#ASSERT `Under section 205(5)(b), may the auditor make representations and have a copy sent to every member` (Date 1 3 2026) (Date 8 3 2026) TRUE TRUE (Date 9 3 2026) (Date 20 3 2026) EQUALS JUST TRUE
#ASSERT `Under section 205(5)(b), may the auditor make representations and have a copy sent to every member` (Date 1 3 2026) (Date 9 3 2026) TRUE TRUE (Date 9 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
#ASSERT `Under section 205(5)(b), may the auditor make representations and have a copy sent to every member` (Date 1 3 2026) (Date 8 3 2026) FALSE TRUE (Date 9 3 2026) (Date 20 3 2026) EQUALS NOTHING
-- 205(6): asked for a copy; no Registrar order; not sent: in default. Sent: not. The Registrar ordered otherwise: no duty.
#ASSERT `Under section 205(6), is the company in default of the duty to send a copy of the representations` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 205(6), is the company in default of the duty to send a copy of the representations` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under section 205(6), is the company in default of the duty to send a copy of the representations` TRUE TRUE FALSE EQUALS JUST FALSE
-- 205(7)(a): at least three-fourths of the members voting: 3 of 4; 2 of 3 is not enough; not removed at a general meeting: the "where" fails.
#ASSERT `Under section 205(7)(a), may the company immediately appoint another accounting entity as auditor` TRUE TRUE 3 4 EQUALS JUST TRUE
#ASSERT `Under section 205(7)(a), may the company immediately appoint another accounting entity as auditor` TRUE TRUE 2 3 EQUALS NOTHING
#ASSERT `Under section 205(7)(a), may the company immediately appoint another accounting entity as auditor` FALSE TRUE 4 4 EQUALS JUST FALSE
-- 205(8): immediately after the removal, written notice to the Registrar.
#ASSERT `Under section 205(8), is the company in default of the duty to give written notice of the removal to the Registrar` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 205(8), is the company in default of the duty to give written notice of the removal to the Registrar` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 205(8), is the company in default of the duty to give written notice of the removal to the Registrar` FALSE FALSE FALSE EQUALS JUST FALSE
-- 205(10): the directors have not appointed and a member has applied in writing: the Registrar may. Either missing: the "if" is not met (NOTHING).
#ASSERT `Under section 205(10), may the Registrar make the appointment on the application of a member` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 205(10), may the Registrar make the appointment on the application of a member` TRUE FALSE EQUALS NOTHING
#ASSERT `Under section 205(10), may the Registrar make the appointment on the application of a member` FALSE TRUE EQUALS NOTHING
-- 205(11): held office immediately before the meeting; or nominated by a member not less than 21 days before (11 March for a meeting on 1 April: in; 12 March: out).
#ASSERT `Under section 205(11), is the accounting entity capable of being appointed auditor at the annual general meeting` FALSE TRUE FALSE (Date 1 1 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `Under section 205(11), is the accounting entity capable of being appointed auditor at the annual general meeting` FALSE FALSE TRUE (Date 11 3 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `Under section 205(11), is the accounting entity capable of being appointed auditor at the annual general meeting` FALSE FALSE TRUE (Date 12 3 2026) (Date 1 4 2026) EQUALS JUST FALSE
-- 205(12): a copy of the notice of nomination not less than 7 days before the meeting on 1 April: the last day is 25 March.
#ASSERT `Under section 205(12), is the company in default of the duty to send a copy of the notice of nomination` TRUE (Date 1 4 2026) TRUE (Date 25 3 2026) (Date 30 3 2026) EQUALS JUST FALSE
#ASSERT `Under section 205(12), is the company in default of the duty to send a copy of the notice of nomination` TRUE (Date 1 4 2026) TRUE (Date 26 3 2026) (Date 30 3 2026) EQUALS JUST TRUE
-- 205(16): an auditor appointed at a general meeting has the fees fixed by the company in general meeting, or by the directors if the members authorised that; not fixed is not "as required".
#ASSERT `Under section 205(16), are the fees and expenses of the auditor fixed as the subsection requires` `s 205(16)(a) the company at a general meeting` `s 205(16) fixed by the directors` TRUE EQUALS JUST TRUE
#ASSERT `Under section 205(16), are the fees and expenses of the auditor fixed as the subsection requires` `s 205(16)(a) the company at a general meeting` `s 205(16) fixed by the directors` FALSE EQUALS JUST FALSE
#ASSERT `Under section 205(16), are the fees and expenses of the auditor fixed as the subsection requires` `s 205(16)(b) the Registrar` `s 205(16) fixed by the Registrar` FALSE EQUALS JUST TRUE
-- 205(17): fine not exceeding $5,000 for the company and the directors in default; none stated for anyone else, or where there is no default.
#ASSERT `Under section 205(17), what is the most the person may be fined on conviction` TRUE `s 205(17) the company` EQUALS JUST 5000
#ASSERT `Under section 205(17), what is the most the person may be fined on conviction` TRUE `s 205(17) a director of the company who is in default` EQUALS JUST 5000
#ASSERT `Under section 205(17), what is the most the person may be fined on conviction` TRUE `s 205(17) any other person` EQUALS NOTHING
#ASSERT `Under section 205(17), what is the most the person may be fined on conviction` FALSE `s 205(17) the company` EQUALS NOTHING

§ `Sections 205AA to 205AF: the auditor resigns`

-- 205AA(1): a non-public interest company, written notice, before the end of the term: the auditor may. A public interest company (or its subsidiary) is for section 205AB: NOTHING.
#ASSERT `Under section 205AA(1), may the auditor resign by giving the company a notice of resignation in writing` FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 205AA(1), may the auditor resign by giving the company a notice of resignation in writing` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Under section 205AA(1), may the auditor resign by giving the company a notice of resignation in writing` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `Under section 205AA(1), may the auditor resign by giving the company a notice of resignation in writing` FALSE FALSE FALSE TRUE EQUALS NOTHING
-- 205AA(3): notification to the Registrar within 14 days beginning on the day the notice is received (1 March): the last day is 14 March.
#ASSERT `Under section 205AA(3), is the company in default of the duty to lodge the notification` (Date 1 3 2026) TRUE (Date 14 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `Under section 205AA(3), is the company in default of the duty to lodge the notification` (Date 1 3 2026) TRUE (Date 15 3 2026) (Date 1 6 2026) EQUALS JUST TRUE
-- 205AB(1): a public interest company's auditor needs the Registrar's consent; every step done: may; consent missing: NOTHING.
#ASSERT `Under section 205AB(1), may the auditor resign by giving the company a notice of resignation in writing` TRUE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 205AB(1), may the auditor resign by giving the company a notice of resignation in writing` TRUE TRUE TRUE TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `Under section 205AB(1), may the auditor resign by giving the company a notice of resignation in writing` FALSE TRUE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING
-- 205AC(1): a copy of the written statement to every member within 14 days after the day it is received (1 March): the last day is 15 March.
#ASSERT `Under section 205AC(1), is the company in default of the duty to send a copy of the written statement to every member` (Date 1 3 2026) TRUE (Date 15 3 2026) FALSE (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `Under section 205AC(1), is the company in default of the duty to send a copy of the written statement to every member` (Date 1 3 2026) TRUE (Date 16 3 2026) FALSE (Date 1 6 2026) EQUALS JUST TRUE
-- Where an application to the Court has been made, copies need not be sent out.
#ASSERT `Under section 205AC(1), is the company in default of the duty to send a copy of the written statement to every member` (Date 1 3 2026) FALSE (Date 1 1 2026) TRUE (Date 16 3 2026) EQUALS JUST FALSE
-- 205AC(2): an application made to the Court on 14 March or 15 March (within the 14 days or not), aimed at an abuse of the statement.
#ASSERT `Under section 205AC(2), are copies of the written statement excused from being sent out` (Date 1 3 2026) TRUE (Date 14 3 2026) TRUE EQUALS JUST TRUE
#ASSERT `Under section 205AC(2), are copies of the written statement excused from being sent out` (Date 1 3 2026) TRUE (Date 15 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `Under section 205AC(2), are copies of the written statement excused from being sent out` (Date 1 3 2026) FALSE (Date 5 3 2026) TRUE EQUALS JUST FALSE
-- 205AC(4): fine not exceeding $5,000.
#ASSERT `Under section 205AC(4), what is the most the person may be fined on conviction` TRUE `s 205(17) the company` EQUALS JUST 5000
#ASSERT `Under section 205AC(4), what is the most the person may be fined on conviction` TRUE `s 205(17) any other person` EQUALS NOTHING
-- 205AD(3): a notice of the directions' effect to every member (and to the auditor if not already a party) within 14 days beginning on the day of the directions (1 March).
#ASSERT `Under section 205AD(3), is the company in default of the duty to send a notice setting out the effect of the directions` (Date 1 3 2026) TRUE FALSE TRUE (Date 14 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `Under section 205AD(3), is the company in default of the duty to send a notice setting out the effect of the directions` (Date 1 3 2026) TRUE FALSE TRUE (Date 15 3 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `Under section 205AD(3), is the company in default of the duty to send a notice setting out the effect of the directions` (Date 1 3 2026) TRUE TRUE FALSE (Date 14 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
-- 205AD(4): notice of the decision and copies within 14 days beginning on the day of the decision (1 March).
#ASSERT `Under section 205AD(4), is the company in default of the duty to give notice of the decision and send the copies` (Date 1 3 2026) TRUE TRUE (Date 14 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `Under section 205AD(4), is the company in default of the duty to give notice of the decision and send the copies` (Date 1 3 2026) TRUE TRUE (Date 15 3 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `Under section 205AD(4), is the company in default of the duty to give notice of the decision and send the copies` (Date 1 3 2026) TRUE FALSE (Date 14 3 2026) (Date 1 6 2026) EQUALS JUST TRUE
-- 205AD(5): fine not exceeding $5,000.
#ASSERT `Under section 205AD(5), what is the most the person may be fined on conviction` TRUE `s 205(17) a director of the company who is in default` EQUALS JUST 5000
#ASSERT `Under section 205AD(5), what is the most the person may be fined on conviction` FALSE `s 205(17) the company` EQUALS NOTHING
-- 205AE: the privilege for a publication under section 205AC(1) holds in the absence of malice; with malice the text does not say (NOTHING); under 205AD(4)(b), malice does not matter.
#ASSERT `Under section 205AE, does the person have the privilege against an action for defamation for the publication` `s 205AE(a) publication of the written statement to a member pursuant to section 205AC(1)` FALSE EQUALS JUST TRUE
#ASSERT `Under section 205AE, does the person have the privilege against an action for defamation for the publication` `s 205AE(a) publication of the written statement to a member pursuant to section 205AC(1)` TRUE EQUALS NOTHING
#ASSERT `Under section 205AE, does the person have the privilege against an action for defamation for the publication` `s 205AE(b) publication of the written statement to a member pursuant to section 205AD(4)(b)` TRUE EQUALS JUST TRUE
-- 205AF(1)(c): the directors must call a meeting within 3 months of the resignation (1 January: the last day is 1 April).
#ASSERT `Under section 205AF(1)(c), are the directors in default of the duty to call a general meeting` TRUE FALSE (Date 1 1 2026) TRUE (Date 1 4 2026) (Date 1 7 2026) EQUALS JUST FALSE
#ASSERT `Under section 205AF(1)(c), are the directors in default of the duty to call a general meeting` TRUE FALSE (Date 1 1 2026) TRUE (Date 2 4 2026) (Date 1 7 2026) EQUALS JUST TRUE
-- Subsections (1) and (2) do not apply where the statements need no audit or the resigning auditor is not the sole auditor (subsection (3)).
#ASSERT `Under section 205AF(1)(c), are the directors in default of the duty to call a general meeting` TRUE TRUE (Date 1 1 2026) FALSE (Date 1 1 2000) (Date 2 4 2026) EQUALS JUST FALSE
-- 205AF(1)(d): within 14 days after the appointment (1 March: the last day is 15 March).
#ASSERT `Under section 205AF(1)(d), are the directors in default of the duty to lodge a notification of the appointment` FALSE (Date 1 3 2026) TRUE (Date 15 3 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `Under section 205AF(1)(d), are the directors in default of the duty to lodge a notification of the appointment` FALSE (Date 1 3 2026) TRUE (Date 16 3 2026) (Date 1 6 2026) EQUALS JUST TRUE
-- 205AF(2): the directors failed and a member applied in writing: the Registrar may. Otherwise NOTHING.
#ASSERT `Under section 205AF(2), may the Registrar make the appointment on the application of a member` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 205AF(2), may the Registrar make the appointment on the application of a member` TRUE FALSE EQUALS NOTHING
-- 205AF(5): fine not exceeding $5,000.
#ASSERT `Under section 205AF(5), what is the most the person may be fined on conviction` TRUE `s 205(17) the company` EQUALS JUST 5000
#ASSERT `Under section 205AF(5), what is the most the person may be fined on conviction` FALSE `s 205(17) the company` EQUALS NOTHING

§ `Sections 205A to 205D: the exemptions from the audit`

-- 205A(1): an exempt company and its directors are exempt from section 205(1) and (2); a company not exempt: the subsection is silent (NOTHING).
#ASSERT `Under section 205A(1), are the company and its directors exempt from section 205(1) or (2)` TRUE EQUALS JUST TRUE
#ASSERT `Under section 205A(1), are the company and its directors exempt from section 205(1) or (2)` FALSE EQUALS NOTHING
-- 205A(2): ceased to be exempt; the next annual general meeting is on 15 June 2026; an auditor must be appointed before it (by 14 June).
#ASSERT `Under section 205A(2), is the company in default of the duty to appoint an auditor` TRUE (Date 15 6 2026) FALSE (Date 1 1 2000) (Date 14 6 2026) EQUALS JUST FALSE
#ASSERT `Under section 205A(2), is the company in default of the duty to appoint an auditor` TRUE (Date 15 6 2026) FALSE (Date 1 1 2000) (Date 15 6 2026) EQUALS JUST TRUE
#ASSERT `Under section 205A(2), is the company in default of the duty to appoint an auditor` TRUE (Date 15 6 2026) TRUE (Date 14 6 2026) (Date 30 6 2026) EQUALS JUST FALSE
-- 205A(3): fine not exceeding $5,000.
#ASSERT `Under section 205A(3), what is the most the person may be fined on conviction` TRUE `s 205(17) the company` EQUALS JUST 5000
#ASSERT `Under section 205A(3), what is the most the person may be fined on conviction` TRUE `s 205(17) any other person` EQUALS NOTHING
-- 205B(1) and (7): dormant from formation (or since the end of the previous year), no member's notice: exempt. A notice takes it away. Not dormant: not exempt under 205B.
#ASSERT `Under section 205B(1) and (7), is the company exempt from audit requirements under section 205B for the financial year` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 205B(1) and (7), is the company exempt from audit requirements under section 205B for the financial year` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 205B(1) and (7), is the company exempt from audit requirements under section 205B for the financial year` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 205B(1) and (7), is the company exempt from audit requirements under section 205B for the financial year` FALSE FALSE FALSE EQUALS JUST FALSE
-- 205B(2): arguments (a) (b) (c) (d) (e) (f) (fa), then (fb) flag, nominal sum, most prescribed, then (g), then any other accounting transaction. No transaction: dormant.
#ASSERT `Under section 205B(2), is the company dormant during the period` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 FALSE FALSE EQUALS JUST TRUE
-- Only a fee payable under a written law (f): disregarded, still dormant. Any other accounting transaction: not dormant.
#ASSERT `Under section 205B(2), is the company dormant during the period` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE 0 0 FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 205B(2), is the company dormant during the period` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE 0 0 FALSE TRUE EQUALS JUST FALSE
-- (fb): a nominal sum not exceeding the prescribed most is disregarded (100 of at most 100); 101 is not.
#ASSERT `Under section 205B(2), is the company dormant during the period` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE 100 100 FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 205B(2), is the company dormant during the period` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE 101 100 FALSE FALSE EQUALS JUST FALSE
-- 205B(4)(d): the statement must be made and say all three things.
#ASSERT `Under section 205B(4)(d), are the directors in default of the duty to accompany the annual return with the statement` TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 205B(4)(d), are the directors in default of the duty to accompany the annual return with the statement` TRUE TRUE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 205B(4)(d), are the directors in default of the duty to accompany the annual return with the statement` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- 205B(6): arguments: shares, shares held by those giving notice, class shares, class shares held, members, members giving notice, in writing, day given, first day, last day.
-- 50 of 1,000 shares is 5%, on the last day for notice (30 November for a year ending 31 December).
#ASSERT `Under section 205B(6), may the members require the company to obtain an audit of its accounts for the year` 1000 50 0 0 0 0 TRUE (Date 30 11 2026) (Date 1 1 2026) (Date 31 12 2026) EQUALS JUST TRUE
-- One day late.
#ASSERT `Under section 205B(6), may the members require the company to obtain an audit of its accounts for the year` 1000 50 0 0 0 0 TRUE (Date 1 12 2026) (Date 1 1 2026) (Date 31 12 2026) EQUALS JUST FALSE
-- 49 of 1,000 is under 5%: NOTHING.
#ASSERT `Under section 205B(6), may the members require the company to obtain an audit of its accounts for the year` 1000 49 0 0 0 0 TRUE (Date 30 11 2026) (Date 1 1 2026) (Date 31 12 2026) EQUALS NOTHING
-- 2 of 40 members is 5%.
#ASSERT `Under section 205B(6), may the members require the company to obtain an audit of its accounts for the year` 1000 0 0 0 40 2 TRUE (Date 30 11 2026) (Date 1 1 2026) (Date 31 12 2026) EQUALS JUST TRUE
-- 205B(7): a notice takes away the exemption; none, it takes nothing away.
#ASSERT `Under section 205B(7), is the company not entitled to the exemption under subsection (1) in respect of the financial year` TRUE EQUALS JUST TRUE
#ASSERT `Under section 205B(7), is the company not entitled to the exemption under subsection (1) in respect of the financial year` FALSE EQUALS JUST FALSE
-- 205C(1) and (2): arguments: small company, parent, subsidiary, part of a small group, first day of the year, notice given.
#ASSERT `Under section 205C(1) and (2), is the company exempt from audit requirements under section 205C for the financial year` TRUE FALSE FALSE FALSE (Date 1 1 2026) FALSE EQUALS JUST TRUE
-- A parent company in a small group: exempt; a parent company not in a small group: not (subsection (3)).
#ASSERT `Under section 205C(1) and (2), is the company exempt from audit requirements under section 205C for the financial year` TRUE TRUE FALSE TRUE (Date 1 1 2026) FALSE EQUALS JUST TRUE
#ASSERT `Under section 205C(1) and (2), is the company exempt from audit requirements under section 205C for the financial year` TRUE TRUE FALSE FALSE (Date 1 1 2026) FALSE EQUALS JUST FALSE
-- A subsidiary not in a small group (subsection (4)); a year commencing before 1 July 2015 (subsection (6)); a member's notice.
#ASSERT `Under section 205C(1) and (2), is the company exempt from audit requirements under section 205C for the financial year` TRUE FALSE TRUE FALSE (Date 1 1 2026) FALSE EQUALS JUST FALSE
#ASSERT `Under section 205C(1) and (2), is the company exempt from audit requirements under section 205C for the financial year` TRUE FALSE FALSE FALSE (Date 30 6 2015) FALSE EQUALS JUST FALSE
#ASSERT `Under section 205C(1) and (2), is the company exempt from audit requirements under section 205C for the financial year` TRUE FALSE FALSE FALSE (Date 1 1 2026) TRUE EQUALS JUST FALSE
-- Not a small company and neither parent nor subsidiary: section 205C is silent (it may still be dormant under 205B): NOTHING.
#ASSERT `Under section 205C(1) and (2), is the company exempt from audit requirements under section 205C for the financial year` FALSE FALSE FALSE FALSE (Date 1 1 2026) FALSE EQUALS NOTHING
-- 205C(6): a year commencing before 1 July 2015 and accounts not prepared or not laid as Part VI then required: in default.
#ASSERT `Under section 205C(6), are the company and its directors in default of the duty to prepare and lay the accounts as the earlier Part VI required` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 205C(6), are the company and its directors in default of the duty to prepare and lay the accounts as the earlier Part VI required` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 205C(6), are the company and its directors in default of the duty to prepare and lay the accounts as the earlier Part VI required` FALSE FALSE FALSE EQUALS JUST FALSE
-- 205C(7): a return lodged without the accounts attached.
