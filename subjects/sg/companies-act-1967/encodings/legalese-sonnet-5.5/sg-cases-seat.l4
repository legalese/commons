#ASSERT `Under section 76(1A), does subsection (1A) bar the company from the act` `s 76(1A)(b)(ii) lend money on the security of shares or units of shares in a holding company or ultimate holding company of the company` FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 76(1A), does subsection (1A) bar the company from the act` `s 76(1A)(a)(i) acquire shares or units of shares in the company` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 76(1A), does subsection (1A) bar the company from the act` `s 76(1A)(a)(i) acquire shares or units of shares in the company` FALSE TRUE EQUALS JUST FALSE
