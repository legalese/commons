-- not fully paid up: barred
#ASSERT `Under section 70(3), is the company barred from redeeming the shares` TRUE FALSE EQUALS JUST TRUE
-- not redeemable preference shares: not covered
#ASSERT `Under section 70(3), is the company barred from redeeming the shares` FALSE TRUE EQUALS NOTHING
