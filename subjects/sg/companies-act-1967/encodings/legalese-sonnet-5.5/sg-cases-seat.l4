#ASSERT `Under section 12D(2), does the notice have the content and form the subsection requires` TRUE TRUE TRUE (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST TRUE   -- exactly 30 days after: "a date at least 30 days after the date of the notice"
#ASSERT `Under section 12D(2), does the notice have the content and form the subsection requires` TRUE TRUE TRUE (Date 1 3 2025) (Date 30 3 2025) EQUALS JUST FALSE   -- 29 days after: fewer than 30
#ASSERT `Under section 12D(2), does the notice have the content and form the subsection requires` TRUE TRUE TRUE (Date 1 3 2025) (Date 15 4 2025) EQUALS JUST TRUE   -- more than 30 days after
#ASSERT `Under section 12D(2), does the notice have the content and form the subsection requires` FALSE TRUE TRUE (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST FALSE   -- not in writing: "give written notice"
#ASSERT `Under section 12D(2), does the notice have the content and form the subsection requires` TRUE FALSE TRUE (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST FALSE   -- the notice does not state the reasons and details
#ASSERT `Under section 12D(2), does the notice have the content and form the subsection requires` TRUE TRUE FALSE (Date 1 3 2025) (Date 31 3 2025) EQUALS JUST FALSE   -- the notice states no date for objections

