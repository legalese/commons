-- ====================================================================================================
-- cases-seat questions from part sgb1 (merged by the lead; unchanged text follows)
-- ====================================================================================================
-- Cases for sgb1-seat.l4 (Companies Act 1967, ss 145 to 160D, the seat layer).
-- Every case asks a SEAT question (named "Under section N, ...") and not the layer-1 function behind it, so that a wrong argument order or a wrong question
-- fails here. Expected values were written from the text of the Act in the layer-1 test files (sgb1-tests-*.l4), where each states the words it rests on;
-- this file reuses, for each question, the first row of each distinct answer (at most two rows), then adds scenario cases told as a person would tell them.
-- JUST TRUE yes; JUST FALSE the text says no in its own words; NOTHING the text does not say.


-- Section 145: directors
-- one resident director is the minimum the text names
#ASSERT `Under section 145(1), does the company have a director who is ordinarily resident in Singapore` 1 EQUALS JUST TRUE
-- none resident: the duty is not met
#ASSERT `Under section 145(1), does the company have a director who is ordinarily resident in Singapore` 0 EQUALS JUST FALSE
#ASSERT `Under section 145(1), may the sole director of a company that has only one member also be that sole member` TRUE EQUALS JUST TRUE
-- more than one member: the where-gate fails
#ASSERT `Under section 145(1), may the sole director of a company that has only one member also be that sole member` FALSE EQUALS JUST FALSE
-- a natural person of 18 with full capacity is outside the bar; the text grants nothing more
#ASSERT `Under section 145(2), is a person barred from being a director of a company` TRUE 18 TRUE EQUALS NOTHING
-- one year short of 18: barred
#ASSERT `Under section 145(2), is a person barred from being a director of a company` TRUE 17 TRUE EQUALS JUST TRUE
#ASSERT `Under section 145(4), is a constitution provision in force before 29 December 1967 that made a corporation a director read as authorising the corporation to appoint a natural person to be a director` TRUE TRUE EQUALS JUST TRUE
-- a provision made after that day is outside the subsection
#ASSERT `Under section 145(4), is a constitution provision in force before 29 December 1967 that made a corporation a director read as authorising the corporation to appoint a natural person to be a director` FALSE TRUE EQUALS NOTHING
-- notice given, a resident director would remain, constitution silent
#ASSERT `Under section 145(4A), may a director resign by giving the company a written notice of resignation` FALSE TRUE TRUE FALSE `s 145(6)(b) none of these` EQUALS JUST TRUE
-- "unless the constitution otherwise provides": the constitution is outside the text
#ASSERT `Under section 145(4A), may a director resign by giving the company a written notice of resignation` TRUE TRUE TRUE FALSE `s 145(6)(b) none of these` EQUALS NOTHING
-- a flat negative: the resignation is not conditional (so the answer to "is it conditional" is no)
#ASSERT `Under section 145(4B), is a director's resignation conditional upon the company's acceptance of it` TRUE FALSE `s 145(6)(b) none of these` EQUALS JUST FALSE
-- subject to the bar in subsection (5), which applies here: the text says no more
#ASSERT `Under section 145(4B), is a director's resignation conditional upon the company's acceptance of it` FALSE FALSE `s 145(6)(b) none of these` EQUALS NOTHING
-- no resident director would remain, and no exception in subsection (6)
#ASSERT `Under section 145(5), is a director barred from resigning or vacating office` FALSE FALSE `s 145(6)(b) none of these` EQUALS JUST TRUE
-- "unless there is remaining at least one director who is ordinarily resident in Singapore": the unless is met
#ASSERT `Under section 145(5), is a director barred from resigning or vacating office` TRUE FALSE `s 145(6)(b) none of these` EQUALS JUST FALSE
-- "any purported resignation or vacation of office in breach of this subsection is invalid"
#ASSERT `Under section 145(5), is a purported resignation or vacation of office invalid` FALSE FALSE `s 145(6)(b) none of these` EQUALS JUST TRUE
-- not in breach: the text says nothing about validity
#ASSERT `Under section 145(5), is a purported resignation or vacation of office invalid` TRUE FALSE `s 145(6)(b) none of these` EQUALS NOTHING
-- paragraph (a)
#ASSERT `Under section 145(6), is a director who is required to resign or vacate office outside the bar in section 145(5)` TRUE `s 145(6)(b) none of these` EQUALS JUST TRUE
-- neither ground: the where-gate of the exception fails (ruling (b)), so subsection (5) is not lifted
#ASSERT `Under section 145(6), is a director who is required to resign or vacate office outside the bar in section 145(5)` FALSE `s 145(6)(b) none of these` EQUALS JUST FALSE
#ASSERT `Under section 145(7), may the Registrar direct the members of the company to appoint a director who is ordinarily resident in Singapore` TRUE TRUE EQUALS JUST TRUE
-- an "if" gate on a power: the grant ruling gives NOTHING
#ASSERT `Under section 145(7), may the Registrar direct the members of the company to appoint a director who is ordinarily resident in Singapore` TRUE FALSE EQUALS NOTHING
#ASSERT `Under section 145(8), is a member in default guilty of an offence for not complying with the Registrar's direction` TRUE TRUE TRUE EQUALS JUST TRUE
-- no direction was given
#ASSERT `Under section 145(8), is a member in default guilty of an offence for not complying with the Registrar's direction` FALSE TRUE TRUE EQUALS JUST FALSE
-- a $2,000 fine, a further $1,000 a day, no imprisonment, no default penalty
#ASSERT `Under section 145(8), what is the most a member in default may be penalised on conviction` TRUE TRUE TRUE EQUALS JUST (`s 145(8) penalty` OF 2000, 0, 1000, FALSE, FALSE)
-- the text states a penalty only for a guilty member
#ASSERT `Under section 145(8), what is the most a member in default may be penalised on conviction` FALSE TRUE TRUE EQUALS NOTHING
-- paragraph (a)
#ASSERT `Under section 145(9), may the Court order the members of the company to make the appointment of a director who is ordinarily resident in Singapore` TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- neither (a) nor (b)
#ASSERT `Under section 145(9), may the Court order the members of the company to make the appointment of a director who is ordinarily resident in Singapore` TRUE FALSE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `Under section 145(10), is a member who knows the company is carrying on business without a resident director liable for the payment of the company's debts` 7 TRUE TRUE EQUALS JUST TRUE
-- exactly 6 months is not "more than 6 months"
#ASSERT `Under section 145(10), is a member who knows the company is carrying on business without a resident director liable for the payment of the company's debts` 6 TRUE TRUE EQUALS JUST FALSE
-- a debt contracted during the period
#ASSERT `Under section 145(10), is a debt of the company within the liability of such a member` 7 TRUE TRUE TRUE EQUALS JUST TRUE
-- a debt contracted before the 6 months run out: outside the words "contracted during the period"
#ASSERT `Under section 145(10), is a debt of the company within the liability of such a member` 7 TRUE TRUE FALSE EQUALS NOTHING

-- Section 145A: acting as a nominee director
-- a director accustomed to act on another's directions
#ASSERT `Under section 145A(4), is a director a nominee director` TRUE TRUE FALSE EQUALS JUST TRUE
-- "means a director who is accustomed or under an obligation": neither
#ASSERT `Under section 145A(4), is a director a nominee director` TRUE FALSE FALSE EQUALS JUST FALSE
-- a company that employs the person
#ASSERT `Under section 145A(4), is a company an affiliated company of a person` TRUE FALSE EQUALS JUST TRUE
-- "means" definition: neither limb
#ASSERT `Under section 145A(4), is a company an affiliated company of a person` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 145A(4), is a given date on or after the appointed day` (Date 2 1 2026) (Date 1 1 2026) EQUALS JUST TRUE
-- the day before the appointed day
#ASSERT `Under section 145A(4), is a given date on or after the appointed day` (Date 31 12 2025) (Date 1 1 2026) EQUALS JUST FALSE
-- acting by way of business after the appointed day, with none of the exceptions
#ASSERT `Under section 145A(1), is a person barred from acting as a nominee director of a company by way of business` TRUE (Date 2 1 2026) (Date 1 1 2026) FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- before the appointed day: outside the words "on or after the appointed day"
#ASSERT `Under section 145A(1), is a person barred from acting as a nominee director of a company by way of business` TRUE (Date 31 12 2025) (Date 1 1 2026) FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 145A(3), is a person who contravenes section 145A(1) guilty of an offence` TRUE EQUALS JUST TRUE
-- no contravention of subsection (1)
#ASSERT `Under section 145A(3), is a person who contravenes section 145A(1) guilty of an offence` FALSE EQUALS JUST FALSE
#ASSERT `Under section 145A(3), what is the most a person may be fined on conviction of the offence of acting as a nominee director by way of business` TRUE EQUALS JUST (`s 145A(3) penalty` OF 10000, 1000)
#ASSERT `Under section 145A(3), what is the most a person may be fined on conviction of the offence of acting as a nominee director by way of business` FALSE EQUALS NOTHING

-- Section 146: restrictions on appointment or advertisement of director
-- named in a document for incorporation; both conditions met first
#ASSERT `Under section 146(1), is a person barred from being named as a director or proposed director` `s 146(1)(a) in a document filed or lodged with or submitted to the Registrar for the purposes of the incorporation of a company` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
