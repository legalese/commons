#ASSERT `Under section 205D, may the Registrar require the exempt company to lodge audited financial statements` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 205D, may the Registrar require the exempt company to lodge audited financial statements` TRUE FALSE FALSE EQUALS NOTHING
