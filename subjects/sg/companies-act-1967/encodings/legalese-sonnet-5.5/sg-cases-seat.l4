#ASSERT `Under section 363(2), may I lodge the documents and particulars required to be lodged` FALSE TRUE EQUALS JUST TRUE
-- neither the company nor a person interested: the subsection grants nothing and says nothing
#ASSERT `Under section 363(2), may I lodge the documents and particulars required to be lodged` FALSE FALSE EQUALS NOTHING

-- Under section 363(3), am I entitled to recover the fees from the company
-- the registration was effected by someone other than the company
#ASSERT `Under section 363(3), am I entitled to recover the fees from the company` TRUE EQUALS JUST TRUE
-- the company itself effected it: the "Where" is not met
#ASSERT `Under section 363(3), am I entitled to recover the fees from the company` FALSE EQUALS JUST FALSE

-- Under section 363(3), how much in fees am I entitled to recover from the company
-- the fees properly paid, 250 dollars
#ASSERT `Under section 363(3), how much in fees am I entitled to recover from the company` TRUE 250 EQUALS JUST 250
-- the company itself effected it: the text states no amount
#ASSERT `Under section 363(3), how much in fees am I entitled to recover from the company` FALSE 250 EQUALS NOTHING

-- Under section 363(4), is the person I ask about guilty of an offence
-- default made, and the person is the company
#ASSERT `Under section 363(4), is the person I ask about guilty of an offence` TRUE TRUE FALSE EQUALS JUST TRUE
-- default made, and the person is an officer in default
#ASSERT `Under section 363(4), is the person I ask about guilty of an offence` TRUE FALSE TRUE EQUALS JUST TRUE
-- default made, but the person is neither: the subsection does not make them guilty
#ASSERT `Under section 363(4), is the person I ask about guilty of an offence` TRUE FALSE FALSE EQUALS JUST FALSE

-- Under section 363(4), what is the most the person I ask about may be sentenced to on conviction
-- a fine of 1,000 dollars and a default penalty
#ASSERT `Under section 363(4), what is the most the person I ask about may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (`s 363(4) penalty` OF 1000, TRUE)
-- not guilty: the subsection states no penalty
#ASSERT `Under section 363(4), what is the most the person I ask about may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING

-- Under section 363(5), does a failure to comply with section 363(1) affect the continuity of status, operation or effect of the charge
-- "does not affect the continuity" of any security of the charge
#ASSERT `Under section 363(5), does a failure to comply with section 363(1) affect the continuity of status, operation or effect of the charge` TRUE `s 363(5) a security of the charge` EQUALS JUST FALSE
-- no failure: the subsection says nothing
#ASSERT `Under section 363(5), does a failure to comply with section 363(1) affect the continuity of status, operation or effect of the charge` FALSE `s 363(5) a security of the charge` EQUALS NOTHING

-- Under section 363(6), may the Court order that the time for registration be extended or that the omission or mis-statement be rectified
-- satisfied the omission was accidental, on the company's application
#ASSERT `Under section 363(6), may the Court order that the time for registration be extended or that the omission or mis-statement be rectified` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
-- not satisfied of any ground: "on being satisfied" is not met
