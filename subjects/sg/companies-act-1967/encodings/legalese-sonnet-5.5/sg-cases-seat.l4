#ASSERT `Under section 215(1), is the transferee entitled and bound to acquire my shares` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(1), is the transferee entitled and bound to acquire my shares` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 215(1), is the transferee entitled and bound to acquire my shares` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 215(1), is the transferee entitled and bound to acquire my shares` TRUE FALSE FALSE EQUALS JUST TRUE

