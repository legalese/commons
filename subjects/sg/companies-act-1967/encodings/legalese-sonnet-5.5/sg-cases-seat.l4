#ASSERT `Under section 230, may the Minister by order declare the body to be a company to which Part 9 applies` FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE      -- (d)
#ASSERT `Under section 230, may the Minister by order declare the body to be a company to which Part 9 applies` FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING      -- a foreign company, no request

