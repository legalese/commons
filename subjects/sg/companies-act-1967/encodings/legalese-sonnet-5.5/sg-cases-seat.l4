#ASSERT `Under section 215(2), am I entitled to require the transferor company to supply the statement of the other dissenting shareholders` TRUE (Date 10 3 2026) (Date 10 3 2026) EQUALS JUST TRUE

-- Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago?
-- Arguments: the transferee has given the notice; I served a written demand; the statement was posted to me; the day it was posted; the day I ask about.
-- no notice given: the subsection's "where" is not met
#ASSERT `Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago` FALSE TRUE TRUE (Date 10 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
-- notice given but no demand made: the subsection says nothing of that case
#ASSERT `Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago` TRUE FALSE FALSE (Date 1 1 2000) (Date 20 3 2026) EQUALS NOTHING
-- demanded, the statement not yet posted: the transferee is not yet entitled or bound
#ASSERT `Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago` TRUE TRUE FALSE (Date 1 1 2000) (Date 20 3 2026) EQUALS JUST TRUE
-- posted on 10 March 2026: "until 14 days after the posting" ends on 24 March; on 25 March the bar is lifted
#ASSERT `Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago` TRUE TRUE TRUE (Date 10 3 2026) (Date 24 3 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago` TRUE TRUE TRUE (Date 10 3 2026) (Date 25 3 2026) EQUALS JUST FALSE
#ASSERT `Under section 215(2), is the transferee not yet entitled or bound to acquire my shares because the statement has not been posted to me 14 days ago` TRUE TRUE TRUE (Date 10 3 2026) (Date 10 3 2026) EQUALS JUST TRUE


§§ `Section 215(3) and (3A): the 90% reached by the transfers; the holder's right to require acquisition`

-- Under section 215(3), do the shares transferred, together with the other shares the transferee holds, comprise or include 90%?
-- Arguments: total shares (treasury included); shares transferred; other shares the transferee held; treasury shares; the 90% is measured against a class.
-- 800 transferred + 50 held + 50 treasury (treated as acquired, (3A)) = 900 of 1,000: exactly 90%
#ASSERT `Under section 215(3), do the shares transferred, together with the other shares the transferee holds, comprise or include 90%` 1000 800 50 50 FALSE EQUALS JUST TRUE
-- measured against a class, the treasury shares are not added: 850 of 1,000 is under 90%
#ASSERT `Under section 215(3), do the shares transferred, together with the other shares the transferee holds, comprise or include 90%` 1000 800 50 50 TRUE EQUALS JUST FALSE
-- one share short: 899 of 1,000
#ASSERT `Under section 215(3), do the shares transferred, together with the other shares the transferee holds, comprise or include 90%` 1000 800 50 49 FALSE EQUALS JUST FALSE
-- no shares at all: no 90% of nothing
#ASSERT `Under section 215(3), do the shares transferred, together with the other shares the transferee holds, comprise or include 90%` 0 0 0 0 FALSE EQUALS JUST FALSE

-- Under section 215(3A), how many treasury shares are treated as acquired by the transferee?
#ASSERT `Under section 215(3A), how many treasury shares are treated as acquired by the transferee` 1000 800 50 50 FALSE EQUALS 50
#ASSERT `Under section 215(3A), how many treasury shares are treated as acquired by the transferee` 1000 800 50 50 TRUE EQUALS 0

-- Under section 215(3)(a), must the transferee give notice of the 90% to the holders of the remaining shares who have not assented?
-- (3)(a): the 90% was reached; the transferee has already complied on a previous transfer
#ASSERT `Under section 215(3)(a), must the transferee give notice of the 90% to the holders of the remaining shares who have not assented` FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 215(3)(a), must the transferee give notice of the 90% to the holders of the remaining shares who have not assented` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 215(3)(a), must the transferee give notice of the 90% to the holders of the remaining shares who have not assented` TRUE FALSE EQUALS JUST TRUE

-- Under section 215(3)(a), was the notice of the 90% given within one month from the date of the transfer?
-- a transfer on 31 January 2026: one month from it ends on 28 February 2026 (P4)
#ASSERT `Under section 215(3)(a), was the notice of the 90% given within one month from the date of the transfer` (Date 31 1 2026) (Date 28 2 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(3)(a), was the notice of the 90% given within one month from the date of the transfer` (Date 31 1 2026) (Date 1 3 2026) EQUALS JUST FALSE
#ASSERT `Under section 215(3)(a), was the notice of the 90% given within one month from the date of the transfer` (Date 15 3 2026) (Date 15 4 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(3)(a), was the notice of the 90% given within one month from the date of the transfer` (Date 15 3 2026) (Date 16 4 2026) EQUALS JUST FALSE

-- Under section 215(3)(b), may I require the transferee to acquire my shares?
-- Arguments: the 90% is reached; I am a holder who has not assented; I was given notice of the 90%; the day I was given it; the day I required the transferee.
-- within 3 months of the notice given on 10 March 2026: up to and including 10 June 2026
#ASSERT `Under section 215(3)(b), may I require the transferee to acquire my shares` TRUE TRUE TRUE (Date 10 3 2026) (Date 10 6 2026) EQUALS JUST TRUE
#ASSERT `Under section 215(3)(b), may I require the transferee to acquire my shares` TRUE TRUE TRUE (Date 10 3 2026) (Date 11 6 2026) EQUALS JUST FALSE
-- the 90% is not reached: the text's "where" is not met
#ASSERT `Under section 215(3)(b), may I require the transferee to acquire my shares` FALSE TRUE TRUE (Date 10 3 2026) (Date 20 3 2026) EQUALS JUST FALSE
-- a holder who did assent, or who was never given the notice: the grant does not reach the case
#ASSERT `Under section 215(3)(b), may I require the transferee to acquire my shares` TRUE FALSE TRUE (Date 10 3 2026) (Date 20 3 2026) EQUALS NOTHING
#ASSERT `Under section 215(3)(b), may I require the transferee to acquire my shares` TRUE TRUE FALSE (Date 1 1 2000) (Date 20 3 2026) EQUALS NOTHING

-- Under section 215(3), is the transferee entitled and bound to acquire my shares?
-- (3): once the shareholder gives notice under (b), entitled and bound; the terms
#ASSERT `Under section 215(3), is the transferee entitled and bound to acquire my shares` TRUE EQUALS JUST TRUE
#ASSERT `Under section 215(3), is the transferee entitled and bound to acquire my shares` FALSE EQUALS JUST FALSE

-- Under section 215(3), on what terms must the transferee acquire my shares?
#ASSERT `Under section 215(3), on what terms must the transferee acquire my shares` TRUE TRUE EQUALS NOTHING
#ASSERT `Under section 215(3), on what terms must the transferee acquire my shares` FALSE TRUE EQUALS JUST `s 215(3) such other terms as the Court thinks fit to order`
#ASSERT `Under section 215(3), on what terms must the transferee acquire my shares` TRUE FALSE EQUALS JUST `s 215(3) such other terms as are agreed`
#ASSERT `Under section 215(3), on what terms must the transferee acquire my shares` FALSE FALSE EQUALS JUST `s 215(3) the terms on which under the scheme or contract the shares of the approving shareholders were transferred to the transferee`


§§ `Section 215(4) to (7): the transfer, the trust, the Official Receiver`

