#ASSERT `Under section 215(4), on what day must the transferee first act` (Date 10 3 2026) TRUE (Date 5 4 2026) TRUE TRUE (Date 25 4 2026) EQUALS JUST (Date 26 4 2026)
-- disposed of on 15 April, within the period: the day after the period ends, 20 April
#ASSERT `Under section 215(4), on what day must the transferee first act` (Date 10 3 2026) TRUE (Date 5 4 2026) TRUE TRUE (Date 15 4 2026) EQUALS JUST (Date 20 4 2026)

