#ASSERT `Under section 12C(1), may I, as an officer of the company, notify the Registrar of the error` FALSE TRUE FALSE TRUE EQUALS NOTHING   -- not an officer of the company: the text says nothing
#ASSERT `Under section 12C(1), may I, as an officer of the company, notify the Registrar of the error` TRUE FALSE FALSE TRUE EQUALS NOTHING   -- neither kind of error
#ASSERT `Under section 12C(1), may I, as an officer of the company, notify the Registrar of the error` TRUE TRUE FALSE FALSE EQUALS NOTHING   -- not in the prescribed form: the text says nothing

-- Under section 12C(2), may the Registrar rectify the register accordingly
#ASSERT `Under section 12C(2), may the Registrar rectify the register accordingly` TRUE TRUE FALSE EQUALS JUST TRUE   -- "(a) the error referred to in subsection (1)(a) is typographical or clerical in nature"
#ASSERT `Under section 12C(2), may the Registrar rectify the register accordingly` TRUE FALSE TRUE EQUALS JUST TRUE   -- "(b) the error referred to in subsection (1)(b) is, in the Registrar's opinion, unintended and does not prejudice any person"
#ASSERT `Under section 12C(2), may the Registrar rectify the register accordingly` TRUE FALSE FALSE EQUALS NOTHING   -- notification received but the Registrar is not satisfied: a failed "if" gating a grant (grant ruling, limit 1)
#ASSERT `Under section 12C(2), may the Registrar rectify the register accordingly` FALSE TRUE TRUE EQUALS JUST FALSE   -- no notification received: a failed "upon receipt" (counts as "where"; split site (ii))

-- Under section 12C(3), is the Registrar barred from expunging a document from the register
#ASSERT `Under section 12C(3), is the Registrar barred from expunging a document from the register` TRUE EQUALS JUST TRUE   -- "In rectifying the register under subsection (2), the Registrar must not expunge any document from the register"
#ASSERT `Under section 12C(3), is the Registrar barred from expunging a document from the register` FALSE EQUALS NOTHING   -- a rectification not under subsection (2): the text says nothing

-- Under section 12C(4), is the Registrar's decision on whether to rectify the register final
#ASSERT `Under section 12C(4), is the Registrar's decision on whether to rectify the register final` TRUE EQUALS JUST TRUE   -- "The decision made by the Registrar on whether to rectify the register under subsection (2) is final"
#ASSERT `Under section 12C(4), is the Registrar's decision on whether to rectify the register final` FALSE EQUALS NOTHING   -- another decision: the text says nothing

-- Under section 12D(1), may the Registrar rectify or update the particulars or document in the register
#ASSERT `Under section 12D(1), may the Registrar rectify or update the particulars or document in the register` TRUE FALSE FALSE FALSE EQUALS JUST TRUE   -- "(a) there is a defect or error in the particulars or document arising from any grammatical, typographical or similar mistake"
#ASSERT `Under section 12D(1), may the Registrar rectify or update the particulars or document in the register` FALSE TRUE FALSE FALSE EQUALS JUST TRUE   -- "(aa) the register is inaccurate in respect of the particulars or document, taking account of information given in ... a notice under section 173A(1) or 173E(1), (2) or (3)"
#ASSERT `Under section 12D(1), may the Registrar rectify or update the particulars or document in the register` FALSE FALSE TRUE FALSE EQUALS JUST TRUE   -- "(b)(i) other information in the register relating to that company or person"
#ASSERT `Under section 12D(1), may the Registrar rectify or update the particulars or document in the register` FALSE FALSE FALSE TRUE EQUALS JUST TRUE   -- "(b)(ii) other information ... obtained from such department or Ministry of the Government, or statutory body or other body corporate as may be prescribed, or the courts"
#ASSERT `Under section 12D(1), may the Registrar rectify or update the particulars or document in the register` FALSE FALSE FALSE FALSE EQUALS NOTHING   -- the Registrar is not satisfied of any: a failed "if" gating a grant (grant ruling, limit 1)

-- Under section 12D(1A), do subsections (2) to (5) apply to the rectification or updating
#ASSERT `Under section 12D(1A), do subsections (2) to (5) apply to the rectification or updating` TRUE EQUALS JUST FALSE   -- "Subsections (2) to (5) do not apply where the Registrar rectifies or updates the register under subsection (1)(aa)"
#ASSERT `Under section 12D(1A), do subsections (2) to (5) apply to the rectification or updating` FALSE EQUALS NOTHING   -- a rectification under (1)(a) or (b): subsections (2) to (5) apply by their own terms; this subsection does not speak

-- Under section 12D(2), must the Registrar give written notice to the company or person before rectifying or updating the register
#ASSERT `Under section 12D(2), must the Registrar give written notice to the company or person before rectifying or updating the register` TRUE FALSE FALSE EQUALS JUST TRUE   -- "the Registrar must, except under prescribed circumstances, give written notice to the company or person whose documents or particulars are to be rectified or updated"
#ASSERT `Under section 12D(2), must the Registrar give written notice to the company or person before rectifying or updating the register` TRUE FALSE TRUE EQUALS JUST FALSE   -- "except under prescribed circumstances"
#ASSERT `Under section 12D(2), must the Registrar give written notice to the company or person before rectifying or updating the register` FALSE TRUE FALSE EQUALS JUST FALSE   -- (1A): subsections (2) to (5) do not apply to a rectification under (1)(aa)
#ASSERT `Under section 12D(2), must the Registrar give written notice to the company or person before rectifying or updating the register` FALSE FALSE FALSE EQUALS NOTHING   -- not a rectification or updating under subsection (1): the text says nothing

