#ASSERT `Under section 207(5), does the auditor have a right of access at all times to the item` FALSE `s 207(5) an accounting or other record that is not a register` EQUALS NOTHING
-- 207(5), information and explanations: from any officer of the company; from the auditor of a company related by section 6; not from anyone else (NOTHING).
#ASSERT `Under section 207(5), is the auditor entitled to require information and explanations from the person` TRUE `s 207(5) an officer of the company` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 207(5), is the auditor entitled to require information and explanations from the person` TRUE `s 207(5) an auditor of another company` TRUE FALSE FALSE TRUE EQUALS JUST TRUE
