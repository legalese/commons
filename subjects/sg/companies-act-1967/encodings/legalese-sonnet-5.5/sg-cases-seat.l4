#ASSERT `Under section 232(1), may the Minister appoint inspectors on the application` FALSE 0 0 0 0 0 9 50 FALSE EQUALS NOTHING      -- under 20%
#ASSERT `Under section 232(1), may the Minister appoint inspectors on the application` FALSE 0 0 0 0 0 0 0 TRUE EQUALS JUST TRUE      -- a special resolution: "in any case"

-- Under section 232(2): must the application be supported by the evidence the Minister requires.
#ASSERT `Under section 232(2), must the application be supported by the evidence the Minister requires` TRUE EQUALS JUST TRUE
#ASSERT `Under section 232(2), must the application be supported by the evidence the Minister requires` FALSE EQUALS JUST FALSE

-- Under section 232(2): may the Minister require the applicants to give security for the cost of the investigation.
#ASSERT `Under section 232(2), may the Minister require the applicants to give security for the cost of the investigation` TRUE EQUALS JUST TRUE
#ASSERT `Under section 232(2), may the Minister require the applicants to give security for the cost of the investigation` FALSE EQUALS JUST FALSE      -- "before appointing an inspector"

§§ `Section 233: the reports of inspectors`

-- Under section 233(1A): must the Minister give me a copy of the report.
#ASSERT `Under section 233(1A), must the Minister give me a copy of the report` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 233(1A), must the Minister give me a copy of the report` FALSE FALSE FALSE FALSE EQUALS JUST FALSE      -- the report does not materially relate to you
#ASSERT `Under section 233(1A), must the Minister give me a copy of the report` TRUE TRUE FALSE FALSE EQUALS JUST FALSE      -- subject to (1B)
#ASSERT `Under section 233(1A), must the Minister give me a copy of the report` TRUE FALSE TRUE FALSE EQUALS JUST FALSE      -- subject to (1C)
#ASSERT `Under section 233(1A), must the Minister give me a copy of the report` TRUE TRUE TRUE TRUE EQUALS JUST TRUE      -- the court's order (1D)

-- Under section 233(2): may the Minister cause the report to be printed and published.
#ASSERT `Under section 233(2), may the Minister cause the report to be printed and published` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 233(2), may the Minister cause the report to be printed and published` TRUE TRUE EQUALS JUST FALSE      -- "must refrain" on the certificate
#ASSERT `Under section 233(2), may the Minister cause the report to be printed and published` FALSE FALSE EQUALS NOTHING      -- no opinion

-- Under section 233(3): must I give the Minister all assistance in connection with the prosecution.
#ASSERT `Under section 233(3), must I give the Minister all assistance in connection with the prosecution` TRUE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 233(3), must I give the Minister all assistance in connection with the prosecution` TRUE TRUE TRUE TRUE EQUALS JUST FALSE      -- the defendant
#ASSERT `Under section 233(3), must I give the Minister all assistance in connection with the prosecution` TRUE FALSE FALSE TRUE EQUALS JUST FALSE      -- not required
#ASSERT `Under section 233(3), must I give the Minister all assistance in connection with the prosecution` FALSE FALSE TRUE TRUE EQUALS NOTHING      -- not an officer or agent

§§ `Sections 235 and 236: related corporations, and the procedure and powers of an inspector`

-- Under section 235: may the inspector investigate the affairs of the other corporation.
#ASSERT `Under section 235, may the inspector investigate the affairs of the other corporation` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 235, may the inspector investigate the affairs of the other corporation` TRUE TRUE FALSE EQUALS NOTHING      -- no consent in writing

-- Under section 236(2): must I produce to the inspector all books and documents in my custody or power.
#ASSERT `Under section 236(2), must I produce to the inspector all books and documents in my custody or power` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 236(2), must I produce to the inspector all books and documents in my custody or power` TRUE FALSE EQUALS JUST FALSE      -- not required
#ASSERT `Under section 236(2), must I produce to the inspector all books and documents in my custody or power` FALSE TRUE EQUALS NOTHING      -- not an officer or agent of a corporation being investigated

-- Under section 236(2): must I give the inspector all assistance in connection with the investigation.
#ASSERT `Under section 236(2), must I give the inspector all assistance in connection with the investigation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 236(2), must I give the inspector all assistance in connection with the investigation` TRUE FALSE EQUALS JUST FALSE      -- beyond what you are reasonably able to give
#ASSERT `Under section 236(2), must I give the inspector all assistance in connection with the investigation` FALSE TRUE EQUALS NOTHING

-- Under section 236(3): may the inspector require me to appear for examination on oath or affirmation.
#ASSERT `Under section 236(3), may the inspector require me to appear for examination on oath or affirmation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 236(3), may the inspector require me to appear for examination on oath or affirmation` TRUE FALSE EQUALS NOTHING      -- no notice in the prescribed form

-- Under section 236(4A): may the inspector require me to produce all documents relating to the bank account.
#ASSERT `Under section 236(4A), may the inspector require me to produce all documents relating to the bank account` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 236(4A), may the inspector require me to produce all documents relating to the bank account` TRUE TRUE FALSE EQUALS NOTHING      -- no reasonable grounds as to the money

-- Under section 236(5): may the inspector certify the failure or refusal to the Court.
#ASSERT `Under section 236(5), may the inspector certify the failure or refusal to the Court` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 236(5), may the inspector certify the failure or refusal to the Court` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 236(5), may the inspector certify the failure or refusal to the Court` FALSE FALSE FALSE EQUALS NOTHING

-- Under section 236(6): am I entitled to refuse to answer the question on the ground that the answer might tend to incriminate me.
#ASSERT `Under section 236(6), am I entitled to refuse to answer the question on the ground that the answer might tend to incriminate me` TRUE TRUE EQUALS JUST FALSE      -- "No person ... is entitled to refuse"
#ASSERT `Under section 236(6), am I entitled to refuse to answer the question on the ground that the answer might tend to incriminate me` TRUE FALSE EQUALS NOTHING      -- a question not relevant or material: subsection (7) governs

-- Under section 236(6): is my answer barred from use in a subsequent criminal proceeding.
#ASSERT `Under section 236(6), is my answer barred from use in a subsequent criminal proceeding` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 236(6), is my answer barred from use in a subsequent criminal proceeding` TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE      -- "except in the case of a charge ... for making a false statement"
#ASSERT `Under section 236(6), is my answer barred from use in a subsequent criminal proceeding` TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING      -- no claim made

-- Under section 236(7): am I entitled to refuse to answer the question on the ground that the answer might tend to incriminate me.
#ASSERT `Under section 236(7), am I entitled to refuse to answer the question on the ground that the answer might tend to incriminate me` TRUE TRUE TRUE EQUALS JUST FALSE      -- taken away by section 236(6)
#ASSERT `Under section 236(7), am I entitled to refuse to answer the question on the ground that the answer might tend to incriminate me` FALSE FALSE TRUE EQUALS JUST TRUE      -- any other person
#ASSERT `Under section 236(7), am I entitled to refuse to answer the question on the ground that the answer might tend to incriminate me` FALSE FALSE FALSE EQUALS NOTHING

-- Under section 236(8): may my signed notes of the examination be used in evidence in legal proceedings against me.
#ASSERT `Under section 236(8), may my signed notes of the examination be used in evidence in legal proceedings against me` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 236(8), may my signed notes of the examination be used in evidence in legal proceedings against me` TRUE TRUE EQUALS JUST FALSE      -- "except in the case of any answer which that person would not have been required to give"
#ASSERT `Under section 236(8), may my signed notes of the examination be used in evidence in legal proceedings against me` FALSE FALSE EQUALS NOTHING      -- unsigned notes

§§ `Sections 237 to 239: costs, evidence and the inspector's helpers`

-- Under section 237(1): who must pay the expenses of and incidental to the investigation.
#ASSERT `Under section 237(1), who must pay the expenses of and incidental to the investigation` TRUE `s 237(1) the Minister has given no direction` EQUALS JUST `s 237(1) the company investigated`      -- the company
#ASSERT `Under section 237(1), who must pay the expenses of and incidental to the investigation` TRUE `s 237(1) the Minister directs that the applicants pay` EQUALS JUST `s 237(1) the applicants`      -- if the Minister so directs
#ASSERT `Under section 237(1), who must pay the expenses of and incidental to the investigation` FALSE `s 237(1) the Minister has given no direction` EQUALS NOTHING      -- an inspector not appointed under section 232 or 243

-- Under section 237(2)(a): how much must the applicants make good, in Singapore dollars.
#ASSERT `Under section 237(2)(a), how much must the applicants make good, in Singapore dollars` 1000 400 500 0 EQUALS 500      -- deficiency 600, ceiling 500
#ASSERT `Under section 237(2)(a), how much must the applicants make good, in Singapore dollars` 1000 400 700 0 EQUALS 600      -- deficiency 600, ceiling 700
#ASSERT `Under section 237(2)(a), how much must the applicants make good, in Singapore dollars` 1000 400 700 200 EQUALS 500      -- ceiling 700 less 200 directed
#ASSERT `Under section 237(2)(a), how much must the applicants make good, in Singapore dollars` 1000 1000 700 0 EQUALS 0      -- the company has not failed

-- Under section 238: is the copy admissible in any legal proceedings as evidence of the inspector's opinion and of the facts upon which the opinion is based.
#ASSERT `Under section 238, is the copy admissible in any legal proceedings as evidence of the inspector's opinion and of the facts upon which the opinion is based` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 238, is the copy admissible in any legal proceedings as evidence of the inspector's opinion and of the facts upon which the opinion is based` TRUE FALSE EQUALS NOTHING      -- not certified

-- Under section 239(2): am I liable to be dealt with in the manner provided in section 236(5).
#ASSERT `Under section 239(2), am I liable to be dealt with in the manner provided in section 236(5)` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 239(2), am I liable to be dealt with in the manner provided in section 236(5)` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 239(2), am I liable to be dealt with in the manner provided in section 236(5)` TRUE FALSE FALSE EQUALS NOTHING

§§ `Sections 240 to 242: suspension of proceedings, winding up and penalties`

-- Under section 240(1): is the action or proceeding barred without the consent of the Minister.
#ASSERT `Under section 240(1), is the action or proceeding barred without the consent of the Minister` TRUE `s 240(1)(a) an action or proceeding by the company upon or in respect of a contract, bill of exchange or promissory note` (Date 1 6 2026) (Date 1 3 2026) FALSE (Date 1 1 2026) FALSE FALSE FALSE (Date 1 5 2026) FALSE (Date 1 1 2026) EQUALS JUST TRUE      -- (a), in the window, no consent
#ASSERT `Under section 240(1), is the action or proceeding barred without the consent of the Minister` TRUE `s 240(1)(a) an action or proceeding by the company upon or in respect of a contract, bill of exchange or promissory note` (Date 1 6 2026) (Date 1 3 2026) FALSE (Date 1 1 2026) TRUE TRUE FALSE (Date 1 5 2026) FALSE (Date 1 1 2026) EQUALS JUST FALSE      -- consent given and the action within it
#ASSERT `Under section 240(1), is the action or proceeding barred without the consent of the Minister` TRUE `s 240(1)(a) an action or proceeding by the company upon or in respect of a contract, bill of exchange or promissory note` (Date 16 9 2026) (Date 1 3 2026) TRUE (Date 15 6 2026) FALSE FALSE FALSE (Date 1 5 2026) FALSE (Date 1 1 2026) EQUALS JUST FALSE      -- the day after the 3 months from the final report
#ASSERT `Under section 240(1), is the action or proceeding barred without the consent of the Minister` TRUE `s 240(1)(b) an action or proceeding by the holder or any other person in respect of a bill of exchange or promissory note dealt with by or to the company` (Date 1 6 2026) (Date 1 3 2026) FALSE (Date 1 1 2026) FALSE FALSE TRUE (Date 1 5 2026) FALSE (Date 1 1 2026) EQUALS JUST FALSE      -- (b): consideration given and never connected
#ASSERT `Under section 240(1), is the action or proceeding barred without the consent of the Minister` TRUE `s 240(1)(b) an action or proceeding by the holder or any other person in respect of a bill of exchange or promissory note dealt with by or to the company` (Date 1 6 2026) (Date 1 3 2026) FALSE (Date 1 1 2026) FALSE FALSE TRUE (Date 1 5 2026) TRUE (Date 1 5 2023) EQUALS JUST TRUE      -- (b): connected exactly 3 years before
#ASSERT `Under section 240(1), is the action or proceeding barred without the consent of the Minister` FALSE `s 240(1)(a) an action or proceeding by the company upon or in respect of a contract, bill of exchange or promissory note` (Date 1 6 2026) (Date 1 3 2026) FALSE (Date 1 1 2026) FALSE FALSE FALSE (Date 1 5 2026) FALSE (Date 1 1 2026) EQUALS NOTHING      -- not a declared company

-- Under section 240(2): is the action or proceeding void and of no effect.
#ASSERT `Under section 240(2), is the action or proceeding void and of no effect` TRUE EQUALS JUST TRUE
#ASSERT `Under section 240(2), is the action or proceeding void and of no effect` FALSE EQUALS NOTHING

-- Under section 241(2): is the foreign company barred from carrying on business or establishing or keeping a place of business in Singapore.
#ASSERT `Under section 241(2), is the foreign company barred from carrying on business or establishing or keeping a place of business in Singapore` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 241(2), is the foreign company barred from carrying on business or establishing or keeping a place of business in Singapore` TRUE FALSE EQUALS JUST FALSE      -- no order made

-- Under section 242(1): am I guilty of the offence of defeating the purposes of Part 9 or obstructing an investigation.
#ASSERT `Under section 242(1), am I guilty of the offence of defeating the purposes of Part 9 or obstructing an investigation` TRUE TRUE FALSE EQUALS JUST TRUE      -- (a)
#ASSERT `Under section 242(1), am I guilty of the offence of defeating the purposes of Part 9 or obstructing an investigation` TRUE FALSE TRUE EQUALS JUST TRUE      -- (b)
#ASSERT `Under section 242(1), am I guilty of the offence of defeating the purposes of Part 9 or obstructing an investigation` TRUE FALSE FALSE EQUALS JUST FALSE      -- intent but no act (split site (i))
#ASSERT `Under section 242(1), am I guilty of the offence of defeating the purposes of Part 9 or obstructing an investigation` FALSE TRUE FALSE EQUALS JUST FALSE      -- the act but no intent

-- Under section 242(1): what is the most I can be fined for defeating the purposes of Part 9 or obstructing an investigation, in Singapore dollars.
#ASSERT `Under section 242(1), what is the most I can be fined for defeating the purposes of Part 9 or obstructing an investigation, in Singapore dollars` TRUE TRUE FALSE EQUALS JUST 10000
#ASSERT `Under section 242(1), what is the most I can be fined for defeating the purposes of Part 9 or obstructing an investigation, in Singapore dollars` FALSE TRUE FALSE EQUALS NOTHING

-- Under section 242(1): what is the longest I can be imprisoned for defeating the purposes of Part 9 or obstructing an investigation, in months.
#ASSERT `Under section 242(1), what is the longest I can be imprisoned for defeating the purposes of Part 9 or obstructing an investigation, in months` TRUE TRUE FALSE EQUALS JUST 24      -- 2 years
#ASSERT `Under section 242(1), what is the longest I can be imprisoned for defeating the purposes of Part 9 or obstructing an investigation, in months` FALSE TRUE FALSE EQUALS NOTHING

-- Under section 242(2): do I bear the onus of proving that I did not act with the intent.
#ASSERT `Under section 242(2), do I bear the onus of proving that I did not act with the intent` TRUE EQUALS JUST TRUE
#ASSERT `Under section 242(2), do I bear the onus of proving that I did not act with the intent` FALSE EQUALS JUST FALSE

§§ `Sections 243 to 246: ownership of a company, interests in shares, restrictions and foreign inspectors`

-- Under section 243(3): must the Minister appoint an inspector to conduct the investigation.
#ASSERT `Under section 243(3), must the Minister appoint an inspector to conduct the investigation` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 243(3), must the Minister appoint an inspector to conduct the investigation` TRUE TRUE TRUE EQUALS JUST FALSE      -- vexatious
#ASSERT `Under section 243(3), must the Minister appoint an inspector to conduct the investigation` TRUE FALSE FALSE EQUALS JUST FALSE      -- below the section 232 threshold

-- Under section 243(5)(a): does Part 9 apply in relation to me as it applies in relation to officers and agents of the corporation.
#ASSERT `Under section 243(5)(a), does Part 9 apply in relation to me as it applies in relation to officers and agents of the corporation` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 243(5)(a), does Part 9 apply in relation to me as it applies in relation to officers and agents of the corporation` TRUE FALSE FALSE TRUE EQUALS JUST TRUE      -- reasonable cause to believe
#ASSERT `Under section 243(5)(a), does Part 9 apply in relation to me as it applies in relation to officers and agents of the corporation` TRUE FALSE FALSE FALSE EQUALS NOTHING

-- Under section 244(1): may the Minister require me to give the information to the Minister.
#ASSERT `Under section 244(1), may the Minister require me to give the information to the Minister` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 244(1), may the Minister require me to give the information to the Minister` TRUE FALSE TRUE EQUALS JUST FALSE      -- an inspector is necessary

-- Under section 244(3): am I guilty of the offence of failing to give information or giving false information.
#ASSERT `Under section 244(3), am I guilty of the offence of failing to give information or giving false information` TRUE FALSE FALSE EQUALS JUST TRUE      -- fails to give
#ASSERT `Under section 244(3), am I guilty of the offence of failing to give information or giving false information` FALSE TRUE FALSE EQUALS JUST TRUE      -- knowingly false
#ASSERT `Under section 244(3), am I guilty of the offence of failing to give information or giving false information` FALSE FALSE TRUE EQUALS JUST TRUE      -- recklessly false
#ASSERT `Under section 244(3), am I guilty of the offence of failing to give information or giving false information` FALSE FALSE FALSE EQUALS JUST FALSE      -- (split site (i))

-- Under section 244(3): what is the most I can be fined for failing to give information or giving false information, in Singapore dollars.
#ASSERT `Under section 244(3), what is the most I can be fined for failing to give information or giving false information, in Singapore dollars` TRUE FALSE FALSE EQUALS JUST 5000
#ASSERT `Under section 244(3), what is the most I can be fined for failing to give information or giving false information, in Singapore dollars` FALSE FALSE FALSE EQUALS NOTHING

-- Under section 244(3): what is the longest I can be imprisoned for failing to give information or giving false information, in months.
#ASSERT `Under section 244(3), what is the longest I can be imprisoned for failing to give information or giving false information, in months` TRUE FALSE FALSE EQUALS JUST 12
#ASSERT `Under section 244(3), what is the longest I can be imprisoned for failing to give information or giving false information, in months` FALSE FALSE FALSE EQUALS NOTHING

-- Under section 244(4): does section 244 require the banking corporation to disclose the information to the Minister.
#ASSERT `Under section 244(4), does section 244 require the banking corporation to disclose the information to the Minister` TRUE TRUE FALSE EQUALS JUST FALSE      -- "nothing therein requires"
#ASSERT `Under section 244(4), does section 244 require the banking corporation to disclose the information to the Minister` TRUE TRUE TRUE EQUALS NOTHING      -- the Banking Act is outside the text
#ASSERT `Under section 244(4), does section 244 require the banking corporation to disclose the information to the Minister` TRUE FALSE FALSE EQUALS NOTHING

-- Under section 245(1): is the act void or barred by the restrictions.
#ASSERT `Under section 245(1), is the act void or barred by the restrictions` TRUE `s 245(1)(b) an exercise of voting rights in respect of the shares` FALSE EQUALS JUST TRUE      -- (b)
#ASSERT `Under section 245(1), is the act void or barred by the restrictions` TRUE `s 245(1)(d) a payment of sums due from the company on the shares, whether in respect of capital or otherwise` FALSE EQUALS JUST TRUE      -- (d)
#ASSERT `Under section 245(1), is the act void or barred by the restrictions` TRUE `s 245(1)(d) a payment of sums due from the company on the shares, whether in respect of capital or otherwise` TRUE EQUALS JUST FALSE      -- "except in a liquidation"
#ASSERT `Under section 245(1), is the act void or barred by the restrictions` FALSE `s 245(1)(b) an exercise of voting rights in respect of the shares` FALSE EQUALS NOTHING      -- no order

-- Under section 245(3): am I guilty of the offence of dealing in shares subject to the restrictions.
#ASSERT `Under section 245(3), am I guilty of the offence of dealing in shares subject to the restrictions` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE      -- (a)
#ASSERT `Under section 245(3), am I guilty of the offence of dealing in shares subject to the restrictions` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE      -- (a) needs knowledge (split site (i))
#ASSERT `Under section 245(3), am I guilty of the offence of dealing in shares subject to the restrictions` TRUE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE      -- (b)
#ASSERT `Under section 245(3), am I guilty of the offence of dealing in shares subject to the restrictions` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE      -- (c)
#ASSERT `Under section 245(3), am I guilty of the offence of dealing in shares subject to the restrictions` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS JUST FALSE      -- the shares are not subject to the restrictions

-- Under section 245(3): what is the most I can be fined for dealing in shares subject to the restrictions, in Singapore dollars.
#ASSERT `Under section 245(3), what is the most I can be fined for dealing in shares subject to the restrictions, in Singapore dollars` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST 5000
#ASSERT `Under section 245(3), what is the most I can be fined for dealing in shares subject to the restrictions, in Singapore dollars` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING

-- Under section 245(3): what is the longest I can be imprisoned for dealing in shares subject to the restrictions, in months.
#ASSERT `Under section 245(3), what is the longest I can be imprisoned for dealing in shares subject to the restrictions, in months` TRUE TRUE TRUE FALSE FALSE FALSE EQUALS JUST 12
#ASSERT `Under section 245(3), what is the longest I can be imprisoned for dealing in shares subject to the restrictions, in months` FALSE TRUE TRUE TRUE TRUE TRUE EQUALS NOTHING

-- Under section 245(4): am I guilty of the offence of issuing shares in contravention of the restrictions.
#ASSERT `Under section 245(4), am I guilty of the offence of issuing shares in contravention of the restrictions` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 245(4), am I guilty of the offence of issuing shares in contravention of the restrictions` TRUE FALSE EQUALS JUST FALSE      -- not an officer in default (split site (i))
#ASSERT `Under section 245(4), am I guilty of the offence of issuing shares in contravention of the restrictions` FALSE TRUE EQUALS JUST FALSE      -- no shares issued in contravention

-- Under section 245(4): what is the most I can be fined for issuing shares in contravention of the restrictions, in Singapore dollars.
#ASSERT `Under section 245(4), what is the most I can be fined for issuing shares in contravention of the restrictions, in Singapore dollars` TRUE EQUALS JUST 5000
#ASSERT `Under section 245(4), what is the most I can be fined for issuing shares in contravention of the restrictions, in Singapore dollars` FALSE EQUALS NOTHING

-- Under section 245(5): is the prosecution barred for want of the consent of the Public Prosecutor.
#ASSERT `Under section 245(5), is the prosecution barred for want of the consent of the Public Prosecutor` TRUE FALSE EQUALS JUST TRUE
#ASSERT `Under section 245(5), is the prosecution barred for want of the consent of the Public Prosecutor` TRUE TRUE EQUALS JUST FALSE      -- "except with the consent"
#ASSERT `Under section 245(5), is the prosecution barred for want of the consent of the Public Prosecutor` FALSE FALSE EQUALS NOTHING

-- Under section 246: does the inspector have the powers and duties of an inspector appointed under section 231.
#ASSERT `Under section 246, does the inspector have the powers and duties of an inspector appointed under section 231` TRUE EQUALS JUST TRUE
#ASSERT `Under section 246, does the inspector have the powers and duties of an inspector appointed under section 231` FALSE EQUALS JUST FALSE


-- ====================================================================================================
-- cases-seat questions from part sgl (wave 2; merged by the lead; unchanged text follows)
-- ====================================================================================================
-- Cases for sgl-seat.l4, the seat layer of the Companies Act 1967 (Singapore), Part 5 Division 3,
-- ss 173J to 189 (2020 Revised Edition, SSO informal consolidation in force 6/5/2026 to 20/10/2026;
-- a rendering, not the official text).
--
-- Every question in sgl-seat.l4 has at least one case here. Each case states the facts a person
-- in the seat would state, as the plain inputs of the question, and the answer that the section
-- (not the code) gives for those facts: the values follow the layer-1 test files, which were
-- written from the text before the modules were run. Where a section has a threshold, the cases
-- sit on both sides of it. A NOTHING is asserted wherever the text does not answer on the facts.

§ `Section 173J: meetings held using technology`

#ASSERT `Under section 173J(1), does section 173J apply to the meeting` `an annual general meeting` FALSE `s 173J(1)(f) no meeting ordered by the Court` FALSE EQUALS JUST TRUE
#ASSERT `Under section 173J(1), does section 173J apply to the meeting` `a meeting of creditors` FALSE `s 173J(1)(f)(i) a meeting ordered by the Court under section 182` FALSE EQUALS JUST FALSE
#ASSERT `Under section 173J(1), does section 173J apply to the meeting` `a meeting of creditors` FALSE `s 173J(1)(f) no meeting ordered by the Court` FALSE EQUALS NOTHING

#ASSERT `Under section 173J(2), may the meeting be held in the way I propose` `s 173J(2)(a) at a physical place` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 173J(2), may the meeting be held in the way I propose` `s 173J(2)(c) using virtual meeting technology only` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 173J(2), may the meeting be held in the way I propose` `s 173J(2)(c) using virtual meeting technology only` TRUE TRUE FALSE EQUALS NOTHING

#ASSERT `Under section 173J(3), may the participants in the meeting be at different places` `s 173J(2)(c) using virtual meeting technology only` TRUE EQUALS JUST TRUE
#ASSERT `Under section 173J(3), may the participants in the meeting be at different places` `s 173J(2)(a) at a physical place` TRUE EQUALS JUST FALSE
#ASSERT `Under section 173J(3), may the participants in the meeting be at different places` `s 173J(2)(c) using virtual meeting technology only` FALSE EQUALS JUST FALSE

#ASSERT `Under section 173J(4), does the Act's reference to a thing at a meeting include its virtual form` `s 173J(4)(a) a person attending a meeting` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 173J(4), does the Act's reference to a thing at a meeting include its virtual form` `s 173J(4)(a) a person attending a meeting` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 173J(4), does the Act's reference to a thing at a meeting include its virtual form` `s 173J(4)(e) the entitlement or right of a person to vote at a meeting` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING

#ASSERT `Under section 173J(5), does the company's constitution exclude or modify section 173J` (Date 30 6 2023) (Date 1 7 2023) FALSE TRUE EQUALS JUST TRUE
#ASSERT `Under section 173J(5), does the company's constitution exclude or modify section 173J` (Date 1 1 2010) (Date 1 1 2015) TRUE TRUE EQUALS JUST FALSE

#ASSERT `Under section 173J(6), does the reference to a member in subsection (4) include me as the member's proxy or representative` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 173J(6), does the reference to a member in subsection (4) include me as the member's proxy or representative` TRUE FALSE EQUALS NOTHING

#ASSERT `Under section 173J(8), does this Act prohibit the meeting of the board or a committee from being held in the way proposed` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 173J(8), does this Act prohibit the meeting of the board or a committee from being held in the way proposed` FALSE TRUE EQUALS NOTHING

§ `Section 174: the statutory meeting`

#ASSERT `Under section 174(1), must the company hold a statutory meeting` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 174(1), must the company hold a statutory meeting` FALSE TRUE TRUE EQUALS JUST FALSE

#ASSERT `Under section 174(1), is the meeting the statutory meeting the section requires` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Under section 174(1), is the meeting the statutory meeting the section requires` TRUE TRUE TRUE FALSE EQUALS JUST FALSE

#ASSERT `Under section 174(1), is the statutory meeting held in the period the subsection fixes` (Date 1 1 2026) (Date 1 4 2026) EQUALS JUST TRUE
#ASSERT `Under section 174(1), is the statutory meeting held in the period the subsection fixes` (Date 1 1 2026) (Date 2 4 2026) EQUALS JUST FALSE
#ASSERT `Under section 174(1), is the statutory meeting held in the period the subsection fixes` (Date 1 1 2026) (Date 31 1 2026) EQUALS JUST FALSE

#ASSERT `Under section 174(1), how many days after the date the company is entitled to commence business is the last day for the statutory meeting` (Date 1 1 2026) EQUALS 90

#ASSERT `Under section 174(2), do the directors forward the statutory report to every member in time` (Date 1 4 2026) (Date 25 3 2026) EQUALS JUST TRUE
#ASSERT `Under section 174(2), do the directors forward the statutory report to every member in time` (Date 1 4 2026) (Date 26 3 2026) EQUALS JUST FALSE

#ASSERT `Under section 174(2), what is the latest day for the directors to forward the statutory report` (Date 1 4 2026) EQUALS Date 25 3 2026

#ASSERT `Under section 174(3), is the statutory report certified by enough directors` 2 EQUALS JUST TRUE
#ASSERT `Under section 174(3), is the statutory report certified by enough directors` 1 EQUALS JUST FALSE

#ASSERT `Under section 174(3), is the statutory report certified and does it state what the subsection requires` 2 TRUE TRUE TRUE TRUE TRUE (Date 25 3 2026) (Date 1 4 2026) TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 174(3), is the statutory report certified and does it state what the subsection requires` 1 TRUE TRUE TRUE TRUE TRUE (Date 25 3 2026) (Date 1 4 2026) TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 174(3), is the statutory report certified and does it state what the subsection requires` 2 TRUE TRUE TRUE TRUE TRUE (Date 20 3 2026) (Date 1 4 2026) TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE

