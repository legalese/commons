#ASSERT `Under section 14(4), from what date does the copy have the same force and effect as the original` TRUE (Date 1 6 2020) EQUALS JUST (Date 1 6 2020)   -- "from such date as is mentioned in the certificate as the date of the filing or lodging of the original"
#ASSERT `Under section 14(4), from what date does the copy have the same force and effect as the original` FALSE (Date 1 6 2020) EQUALS NOTHING   -- not lodged: the text names no date

-- Under section 14(5), may the Court by order confirm, vary or rescind the certificate
#ASSERT `Under section 14(5), may the Court by order confirm, vary or rescind the certificate` TRUE TRUE EQUALS JUST TRUE   -- "upon application by any person aggrieved and after notice to any other person whom the Court directs"
#ASSERT `Under section 14(5), may the Court by order confirm, vary or rescind the certificate` FALSE TRUE EQUALS JUST FALSE   -- no application: a failed "upon" (periods ruling (b); split site (ii))
#ASSERT `Under section 14(5), may the Court by order confirm, vary or rescind the certificate` TRUE FALSE EQUALS JUST FALSE   -- no notice: a failed "after" (periods ruling (b); split site (ii))

