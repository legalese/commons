-- 207(1): reported on the statements; a parent company with consolidated statements must report on those too.
#ASSERT `Under section 207(1), is the auditor in default of the duty to report to the members` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 207(1), is the auditor in default of the duty to report to the members` FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 207(1), is the auditor in default of the duty to report to the members` TRUE TRUE FALSE EQUALS JUST TRUE
-- 207(1A): furnished to the directors in sufficient time.
#ASSERT `Under section 207(1A), is the auditor in default of the duty to furnish the report to the directors in sufficient time` TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 207(1A), is the auditor in default of the duty to furnish the report to the directors in sufficient time` TRUE FALSE EQUALS JUST TRUE
-- 207(2)(a): the opinions on compliance and on a true and fair view; for a parent company with consolidated statements, on those as well.
#ASSERT `Under section 207(2)(a), is the auditor in default of the duty to state the opinions on the financial statements` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `Under section 207(2)(a), is the auditor in default of the duty to state the opinions on the financial statements` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `Under section 207(2)(a), is the auditor in default of the duty to state the opinions on the financial statements` TRUE TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- 207(5): a right of access to records and registers, but not to a register kept under Part 11A (section 207(11)); only for an auditor of the company.
#ASSERT `Under section 207(5), does the auditor have a right of access at all times to the item` TRUE `s 207(5) an accounting or other record that is not a register` EQUALS JUST TRUE
#ASSERT `Under section 207(5), does the auditor have a right of access at all times to the item` TRUE `s 207(5) a register other than a register kept under Part 11A` EQUALS JUST TRUE
