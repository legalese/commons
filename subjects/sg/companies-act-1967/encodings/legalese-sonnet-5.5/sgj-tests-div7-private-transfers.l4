IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgj-div7-private-transfers`

-- Tests for ss 126 to 129. Every expected value is written from the text of the section, not from the output of the code.
-- Argument orders are the orders of the GIVEN lists in sgj-div7-private-transfers.l4.

§ `Section 126`

-- (1): arguments: the company is private; a proper instrument of transfer has been delivered; the right was transmitted by operation of law
#ASSERT `s 126(1) the private company is barred from lodging the transfer of shares` TRUE FALSE FALSE EQUALS JUST TRUE
-- "unless a proper instrument of transfer has been delivered": the bar is closed once it is
#ASSERT `s 126(1) the private company is barred from lodging the transfer of shares` TRUE TRUE FALSE EQUALS JUST FALSE
-- "but this section does not affect any power to lodge a notice of transfer ... [for] any person to whom the right ... has been transmitted by operation of law"
#ASSERT `s 126(1) the private company is barred from lodging the transfer of shares` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 126(1) the private company is barred from lodging the transfer of shares` TRUE TRUE TRUE EQUALS JUST FALSE
-- a company that is not private: the section says nothing (the public company's rule is s 130(1))
#ASSERT `s 126(1) the private company is barred from lodging the transfer of shares` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 126(1) the private company is barred from lodging the transfer of shares` FALSE TRUE FALSE EQUALS NOTHING

-- the prohibition: lodging the transfer without the instrument is BREACH; time passing does not breach it
-- EXPECT BREACH
#TRACE `s 126(1) a private company must not lodge a transfer of shares without a proper instrument of transfer` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 126(1) lodge a transfer of shares without a proper instrument of transfer having been delivered to the company` AT 4

-- EXPECT RESIDUAL
#TRACE `s 126(1) a private company must not lodge a transfer of shares without a proper instrument of transfer` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- (2): arguments: the company is private; there has been a transfer of shares
#ASSERT `s 126(2) the private company must lodge with the Registrar notice of the transfer of shares` TRUE TRUE EQUALS JUST TRUE
-- "Where there has been a transfer of shares": no transfer, no duty (periods ruling of 2026-11-05, item (b))
#ASSERT `s 126(2) the private company must lodge with the Registrar notice of the transfer of shares` TRUE FALSE EQUALS JUST FALSE
-- a company that is not private: the subsection says nothing (the public company's rule is s 130(2))
#ASSERT `s 126(2) the private company must lodge with the Registrar notice of the transfer of shares` FALSE TRUE EQUALS NOTHING
#ASSERT `s 126(2) the private company must lodge with the Registrar notice of the transfer of shares` FALSE FALSE EQUALS NOTHING
-- no time is stated and no consequence for the act: the passing of time never breaches the duty
-- EXPECT RESIDUAL
#TRACE `s 126(2) a private company must lodge notice of a transfer of shares with the Registrar` "Acme Pte Ltd" 7 AT 0 WITH
    (WAITUNTIL 100)

-- EXPECT FULFILLED
#TRACE `s 126(2) a private company must lodge notice of a transfer of shares with the Registrar` "Acme Pte Ltd" 7 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 126(2) lodge with the Registrar notice of the transfer of shares in the prescribed form` AT 20

-- (3): arguments: the company is private; the day of the transfer; the electronic register has been updated under s 196A(5)
-- "on or after 3 January 2016": the first day is inside the scope
#ASSERT `s 126(3) the transfer cannot yet take effect` TRUE (Date 3 1 2016) FALSE EQUALS JUST TRUE
#ASSERT `s 126(3) the transfer cannot yet take effect` TRUE (Date 15 6 2026) FALSE EQUALS JUST TRUE
-- "does not take effect until the electronic register ... is updated": once it is, the bar is lifted
#ASSERT `s 126(3) the transfer cannot yet take effect` TRUE (Date 15 6 2026) TRUE EQUALS JUST FALSE
-- before 3 January 2016: outside the scope, and the scope limit has no "only"
#ASSERT `s 126(3) the transfer cannot yet take effect` TRUE (Date 2 1 2016) FALSE EQUALS NOTHING
#ASSERT `s 126(3) the transfer cannot yet take effect` TRUE (Date 31 12 2015) TRUE EQUALS NOTHING
-- a company that is not private: outside the scope
#ASSERT `s 126(3) the transfer cannot yet take effect` FALSE (Date 15 6 2026) FALSE EQUALS NOTHING

§ `Section 127`

-- arguments: the company is private; a proper instrument of transfer has been delivered; the right was transmitted by operation of law
#ASSERT `s 127 the private company is barred from registering the transfer of debentures` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 127 the private company is barred from registering the transfer of debentures` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 127 the private company is barred from registering the transfer of debentures` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 127 the private company is barred from registering the transfer of debentures` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 127 the private company is barred from registering the transfer of debentures` FALSE FALSE FALSE EQUALS NOTHING
-- EXPECT BREACH
#TRACE `s 127 a private company must not register a transfer of debentures without a proper instrument of transfer` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 127 register a transfer of debentures without a proper instrument of transfer having been delivered to the company` AT 2

-- EXPECT RESIDUAL
#TRACE `s 127 a private company must not register a transfer of debentures without a proper instrument of transfer` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 100)

§ `Section 128`

-- (1): arguments: the company is private; the transferor has requested in writing; section 129 allows the company to refuse
#ASSERT `s 128(1) the private company must act on the transferor's request` TRUE TRUE FALSE EQUALS JUST TRUE
-- "Subject to section 129": where s 129 lets the company refuse, the duty is displaced and the text does not say what is owed
#ASSERT `s 128(1) the private company must act on the transferor's request` TRUE TRUE TRUE EQUALS NOTHING
-- no request in writing: no duty arises under this subsection
#ASSERT `s 128(1) the private company must act on the transferor's request` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 128(1) the private company must act on the transferor's request` FALSE TRUE FALSE EQUALS NOTHING
-- no time is stated: the duty is never breached by the passing of time, and is met when it is done
-- EXPECT RESIDUAL
#TRACE `s 128(1)(a) a private company must lodge a notice of transfer of shares on the transferor's request` "Acme Pte Ltd" 7 AT 0 WITH
    (WAITUNTIL 100)

-- EXPECT FULFILLED
#TRACE `s 128(1)(a) a private company must lodge a notice of transfer of shares on the transferor's request` "Acme Pte Ltd" 7 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 128(1)(a) lodge with the Registrar a notice of transfer of shares in the prescribed form` AT 6

-- EXPECT RESIDUAL
#TRACE `s 128(1)(b) a private company must enter the name of the transferee on the transferor's request` "Acme Pte Ltd" 7 AT 0 WITH
    (WAITUNTIL 100)

-- EXPECT FULFILLED
#TRACE `s 128(1)(b) a private company must enter the name of the transferee on the transferor's request` "Acme Pte Ltd" 7 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 128(1)(b) enter the name of the transferee in the register the company considers appropriate` AT 6

-- (2): the same bar as s 126(3)
#ASSERT `s 128(2) the transfer cannot yet take effect` TRUE (Date 3 1 2016) FALSE EQUALS JUST TRUE
#ASSERT `s 128(2) the transfer cannot yet take effect` TRUE (Date 15 6 2026) FALSE EQUALS JUST TRUE
#ASSERT `s 128(2) the transfer cannot yet take effect` TRUE (Date 15 6 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 128(2) the transfer cannot yet take effect` TRUE (Date 2 1 2016) FALSE EQUALS NOTHING
#ASSERT `s 128(2) the transfer cannot yet take effect` FALSE (Date 15 6 2026) FALSE EQUALS NOTHING

-- (3): arguments: the company is private; the transferor has requested in writing
#ASSERT `s 128(3) the private company must by written notice require delivery or production of the documents` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 128(3) the private company must by written notice require delivery or production of the documents` TRUE FALSE EQUALS NOTHING
#ASSERT `s 128(3) the private company must by written notice require delivery or production of the documents` FALSE TRUE EQUALS NOTHING
-- "a stated period, being not less than 7 and not more than 28 days after the date of the notice": both ends are inside
#ASSERT `s 128(3) the period stated in the notice is a period the subsection allows` 7 EQUALS JUST TRUE
#ASSERT `s 128(3) the period stated in the notice is a period the subsection allows` 14 EQUALS JUST TRUE
#ASSERT `s 128(3) the period stated in the notice is a period the subsection allows` 28 EQUALS JUST TRUE
#ASSERT `s 128(3) the period stated in the notice is a period the subsection allows` 6 EQUALS JUST FALSE
#ASSERT `s 128(3) the period stated in the notice is a period the subsection allows` 29 EQUALS JUST FALSE
#ASSERT `s 128(3) the period stated in the notice is a period the subsection allows` 0 EQUALS JUST FALSE
-- no time is stated for giving the notice itself
-- EXPECT RESIDUAL
#TRACE `s 128(3) a private company must require delivery or production of the documents by written notice` "Acme Pte Ltd" 7 AT 0 WITH
    (WAITUNTIL 100)

-- EXPECT FULFILLED
#TRACE `s 128(3) a private company must require delivery or production of the documents by written notice` "Acme Pte Ltd" 7 AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 128(3) require by written notice the person having possession, custody or control to deliver or produce the share certificate or debenture and the instrument of transfer` AT 3

-- (4): a grant gated by "if": the transferor may apply when the person has refused or neglected; otherwise the text does not say
#ASSERT `s 128(4) the transferor may apply to a judge for a summons` TRUE EQUALS JUST TRUE
#ASSERT `s 128(4) the transferor may apply to a judge for a summons` FALSE EQUALS NOTHING

-- (5): arguments: the person has been summoned; the person has appeared; the person has not appeared after being duly served
#ASSERT `s 128(5) the Court may order the person to deliver the documents to the company` TRUE TRUE FALSE EQUALS JUST TRUE
-- "if the person does not appear after being duly served with such summons, the Court may receive evidence in the person's absence and in either case ... may order"
#ASSERT `s 128(5) the Court may order the person to deliver the documents to the company` TRUE FALSE TRUE EQUALS JUST TRUE
-- a "may" gated by "upon": when neither gate is met the answer is the text's no (periods ruling, item (b)), listed for a lawyer
#ASSERT `s 128(5) the Court may order the person to deliver the documents to the company` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 128(5) the Court may order the person to deliver the documents to the company` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 128(5) the Court may order the person to deliver the documents to the company` FALSE FALSE FALSE EQUALS JUST FALSE

-- (6): lists called in and not delivered or produced must be exhibited and advertised; no time is stated
#ASSERT `s 128(6) the company must exhibit the list in its office and advertise it` TRUE EQUALS JUST TRUE
#ASSERT `s 128(6) the company must exhibit the list in its office and advertise it` FALSE EQUALS NOTHING
-- EXPECT RESIDUAL
#TRACE `s 128(6) the company must exhibit and advertise the list` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- EXPECT FULFILLED
#TRACE `s 128(6) the company must exhibit and advertise the list` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 128(6) exhibit and advertise the list of share certificates or debentures called in and not delivered or produced` AT 40

§ `Section 129`

-- (1): 30 days after the date on which the transfer was lodged, the day of lodging not counted.
-- Lodged on Sunday 1 February 2026: 2 February is day 1, 28 February is day 27, 1 March is day 28, 3 March is day 30.
#ASSERT `s 129(1) the last day for sending notice of the refusal` (Date 1 2 2026) EQUALS Date 3 3 2026
#ASSERT `s 129(1) the notice of the refusal was sent within 30 days` (Date 1 2 2026) (Date 2 3 2026) EQUALS JUST TRUE
#ASSERT `s 129(1) the notice of the refusal was sent within 30 days` (Date 1 2 2026) (Date 3 3 2026) EQUALS JUST TRUE
#ASSERT `s 129(1) the notice of the refusal was sent within 30 days` (Date 1 2 2026) (Date 4 3 2026) EQUALS JUST FALSE
-- the clock of the trace counts days after the lodging: at day 30 the notice is in time, at day 31 it is not
-- EXPECT FULFILLED
#TRACE `s 129(1) a private company that refuses to lodge a notice of transfer must send notice of the refusal within 30 days` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 129(1) send to the transferor and the transferee notice of the refusal to lodge a notice of transfer of a share` AT 30

-- EXPECT BREACH
#TRACE `s 129(1) a private company that refuses to lodge a notice of transfer must send notice of the refusal within 30 days` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 129(1) send to the transferor and the transferee notice of the refusal to lodge a notice of transfer of a share` AT 31

-- EXPECT BREACH
#TRACE `s 129(1) a private company that refuses to lodge a notice of transfer must send notice of the refusal within 30 days` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- (2): the same for a debenture or other interest
#ASSERT `s 129(2) the last day for sending notice of the refusal` (Date 1 2 2026) EQUALS Date 3 3 2026
#ASSERT `s 129(2) the notice of the refusal was sent within 30 days` (Date 1 2 2026) (Date 3 3 2026) EQUALS JUST TRUE
#ASSERT `s 129(2) the notice of the refusal was sent within 30 days` (Date 1 2 2026) (Date 4 3 2026) EQUALS JUST FALSE
-- EXPECT FULFILLED
#TRACE `s 129(2) a private company that refuses to register a transfer must send notice of the refusal within 30 days` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 129(2) send to the transferor and the transferee notice of the refusal to register a transfer of a debenture or other interest` AT 30

-- EXPECT BREACH
#TRACE `s 129(2) a private company that refuses to register a transfer must send notice of the refusal within 30 days` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 129(2) send to the transferor and the transferee notice of the refusal to register a transfer of a debenture or other interest` AT 31

-- EXPECT BREACH
#TRACE `s 129(2) a private company that refuses to register a transfer must send notice of the refusal within 30 days` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- (3): "within 30 days beginning with the day on which the application was made": the day of the application is day 1.
-- Applied on Sunday 1 February 2026: 1 February is day 1, 28 February is day 28, 1 March is day 29, 2 March is day 30.
#ASSERT `s 129(3) the last day for serving the written notice` (Date 1 2 2026) EQUALS Date 2 3 2026
-- arguments: the company is private; the application is for a share transferred or transmitted by act of parties or operation of law; the day of the application;
-- the day the written notice was served; a written notice stating the facts has been served
#ASSERT `s 129(3) the private company is barred from refusing by virtue of a discretion in the constitution` TRUE TRUE (Date 1 2 2026) (Date 2 3 2026) TRUE EQUALS JUST FALSE
#ASSERT `s 129(3) the private company is barred from refusing by virtue of a discretion in the constitution` TRUE TRUE (Date 1 2 2026) (Date 1 2 2026) TRUE EQUALS JUST FALSE
-- served a day late: the "unless" is not met and the bar stands
#ASSERT `s 129(3) the private company is barred from refusing by virtue of a discretion in the constitution` TRUE TRUE (Date 1 2 2026) (Date 3 3 2026) TRUE EQUALS JUST TRUE
-- no notice served at all (the date given is then irrelevant)
#ASSERT `s 129(3) the private company is barred from refusing by virtue of a discretion in the constitution` TRUE TRUE (Date 1 2 2026) (Date 2 3 2026) FALSE EQUALS JUST TRUE
-- outside the scope the subsection sets: not a private company, or not a share transferred or transmitted by act of parties or operation of law
#ASSERT `s 129(3) the private company is barred from refusing by virtue of a discretion in the constitution` FALSE TRUE (Date 1 2 2026) (Date 3 3 2026) FALSE EQUALS NOTHING
#ASSERT `s 129(3) the private company is barred from refusing by virtue of a discretion in the constitution` TRUE FALSE (Date 1 2 2026) (Date 3 3 2026) FALSE EQUALS NOTHING
-- a refusal with no timely notice: BREACH; a refusal with the timely notice: the prohibition is not engaged and stays residual; no refusal: residual
-- EXPECT BREACH
#TRACE `s 129(3) a private company must not refuse by virtue of a discretion without a timely written notice` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 129(3) refusal by virtue of a discretion` FALSE AT 31

-- EXPECT RESIDUAL
#TRACE `s 129(3) a private company must not refuse by virtue of a discretion without a timely written notice` "Acme Pte Ltd" AT 0 WITH
    PARTY Company "Acme Pte Ltd" DOES `s 129(3) refusal by virtue of a discretion` TRUE AT 31

-- EXPECT RESIDUAL
#TRACE `s 129(3) a private company must not refuse by virtue of a discretion without a timely written notice` "Acme Pte Ltd" AT 0 WITH
    (WAITUNTIL 100)

-- (4): arguments: default is made in complying with section 129; the person is the private company; the person is an officer of the company in default
#ASSERT `s 129(4) the person is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 129(4) the person is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 129(4) the person is guilty of the offence this subsection creates` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 129(4) the person is guilty of the offence this subsection creates` FALSE TRUE TRUE EQUALS JUST FALSE
-- fine not exceeding $1,000 and a default penalty; no imprisonment
#ASSERT `s 129(4) the most the person may be sentenced to on conviction` TRUE TRUE FALSE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
#ASSERT `s 129(4) the most the person may be sentenced to on conviction` TRUE FALSE TRUE EQUALS JUST (Penalty OF 1000, 0, FALSE, TRUE)
-- the subsection states a penalty only for the person it makes guilty
#ASSERT `s 129(4) the most the person may be sentenced to on conviction` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 129(4) the most the person may be sentenced to on conviction` FALSE TRUE TRUE EQUALS NOTHING
