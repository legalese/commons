IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgk-div8-application`

-- Tests for ss 139, 140 and 141. Every expected value is written from the text of the section, beside the assertion.

§ `Section 139`

-- s 139: the time is "extended by 7 days or such further periods as the Registrar may from time to time allow" for a document made out of Singapore.
#ASSERT `s 139 the number of days added to the time specified` TRUE 0 EQUALS 7        -- made out of Singapore, nothing further allowed: 7 days
#ASSERT `s 139 the number of days added to the time specified` TRUE 14 EQUALS 21      -- 7 days and a further 14 days allowed (fork F-K1)
#ASSERT `s 139 the number of days added to the time specified` FALSE 5 EQUALS 0       -- made in Singapore: no extension by this section
#ASSERT `s 139 the time specified is extended by` TRUE TRUE 0 EQUALS JUST 7
#ASSERT `s 139 the time specified is extended by` TRUE TRUE 3 EQUALS JUST 10
#ASSERT `s 139 the time specified is extended by` TRUE FALSE 0 EQUALS NOTHING         -- a document made in Singapore: the section says nothing
#ASSERT `s 139 the time specified is extended by` FALSE TRUE 0 EQUALS NOTHING         -- no time specified under Division 8: the section says nothing

-- The last day: 30 days after 1 January 2026 is 31 January 2026 (the day of the event is not counted).
#ASSERT `s 139 the last day for lodging the document` (Date 1 1 2026) 30 FALSE 0 EQUALS Date 31 1 2026
#ASSERT `s 139 the last day for lodging the document` (Date 1 1 2026) 30 TRUE 0 EQUALS Date 7 2 2026      -- 37 days after 1 January: 31 + 6 = 7 February
#ASSERT `s 139 the last day for lodging the document` (Date 1 1 2026) 30 TRUE 3 EQUALS Date 10 2 2026    -- 40 days after
#ASSERT `s 139 the last day for lodging the document` (Date 31 1 2026) 30 FALSE 0 EQUALS Date 2 3 2026   -- 31 January + 30 days: February 2026 has 28 days, so 2 March
#ASSERT `s 139 the last day for lodging the document` (Date 31 1 2026) 30 TRUE 0 EQUALS Date 9 3 2026    -- 37 days after 31 January 2026

§ `Section 140`

-- s 140: "Except as is otherwise expressly provided, this Division applies to any charge that on 29 December 1967 was registrable under any of the repealed written laws but which at that date was not registered under any of those laws."
#ASSERT `s 140 this Division applies to the charge` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 140 this Division applies to the charge` TRUE FALSE FALSE EQUALS NOTHING     -- registrable but registered at that date: the text does not say
#ASSERT `s 140 this Division applies to the charge` FALSE TRUE FALSE EQUALS NOTHING     -- not registrable: the text does not say
#ASSERT `s 140 this Division applies to the charge` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 140 this Division applies to the charge` TRUE TRUE TRUE EQUALS JUST FALSE    -- "Except as is otherwise expressly provided" (fork F-K2)
#ASSERT `s 140 this Division applies to the charge` FALSE FALSE TRUE EQUALS JUST FALSE

§ `Section 141`

-- s 141: "A reference in this Division to a company includes a reference to a foreign company if, and only if, it is registered under Division 2 of Part 11,
-- but nothing in this Division applies to a charge on property outside Singapore of such foreign company."
#ASSERT `s 141 a reference in Division 8 to a company includes the foreign company` TRUE EQUALS JUST TRUE
#ASSERT `s 141 a reference in Division 8 to a company includes the foreign company` FALSE EQUALS JUST FALSE        -- "if, and only if"
#ASSERT `s 141 this Division applies to the charge of the foreign company` TRUE TRUE EQUALS JUST FALSE            -- registered foreign company, property outside Singapore
#ASSERT `s 141 this Division applies to the charge of the foreign company` TRUE FALSE EQUALS NOTHING              -- property in Singapore: the proviso is silent
#ASSERT `s 141 this Division applies to the charge of the foreign company` FALSE TRUE EQUALS NOTHING              -- not a registered foreign company: "such foreign company" does not apply
#ASSERT `s 141 this Division applies to the charge of the foreign company` FALSE FALSE EQUALS NOTHING
