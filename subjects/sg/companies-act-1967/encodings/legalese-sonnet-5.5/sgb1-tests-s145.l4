IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgb1-s145-directors`

-- Tests for sgb1-s145-directors.l4 (Companies Act 1967, ss 145, 145A, 146, 147; text lines 11592-11921 of CoA1967.txt).
-- Every expected value was written from the text of the Act, not from what the code printed; each group names the words it rests on.
-- JUST TRUE yes; JUST FALSE the text says no in its own words; NOTHING the text does not say.


-- s 145(1): "Every company must have at least one director who is ordinarily resident in Singapore" (a duty: the count one passes, zero does not)
-- one resident director is the minimum the text names
#ASSERT `s 145(1) the company has a director who is ordinarily resident in Singapore` 1 EQUALS JUST TRUE
#ASSERT `s 145(1) the company has a director who is ordinarily resident in Singapore` 4 EQUALS JUST TRUE
-- none resident: the duty is not met
#ASSERT `s 145(1) the company has a director who is ordinarily resident in Singapore` 0 EQUALS JUST FALSE

-- s 145(1): "where the company only has one member, that sole director may also be the sole member" (a where-gate on a liberty with no bar to relieve: the S1b ruling, 2026S1bC, gives NOTHING)
#ASSERT `s 145(1) the sole director may also be the sole member of the company` TRUE EQUALS JUST TRUE
-- more than one member: the where-gate fails (2026S1bC)
#ASSERT `s 145(1) the sole director may also be the sole member of the company` FALSE EQUALS NOTHING

-- s 145(2): "No person other than a natural person who has attained the age of 18 years and who is otherwise of full legal capacity may be a director" (age 17 against 18)
-- a natural person of 18 with full capacity is outside the bar; the text grants nothing more
#ASSERT `s 145(2) the subsection bars the person from being a director of a company` TRUE 18 TRUE EQUALS NOTHING
-- one year short of 18: barred
#ASSERT `s 145(2) the subsection bars the person from being a director of a company` TRUE 17 TRUE EQUALS JUST TRUE
#ASSERT `s 145(2) the subsection bars the person from being a director of a company` TRUE 40 TRUE EQUALS NOTHING
-- a corporation is not a natural person: barred
#ASSERT `s 145(2) the subsection bars the person from being a director of a company` FALSE 40 TRUE EQUALS JUST TRUE
-- not otherwise of full legal capacity: barred
#ASSERT `s 145(2) the subsection bars the person from being a director of a company` TRUE 30 FALSE EQUALS JUST TRUE

-- s 145(4): a constitution provision in force immediately before 29 December 1967 that made a corporation a director
#ASSERT `s 145(4) the provision is read as authorising the corporation to appoint a natural person to be a director` TRUE TRUE EQUALS JUST TRUE
-- a provision made after that day is outside the subsection
#ASSERT `s 145(4) the provision is read as authorising the corporation to appoint a natural person to be a director` FALSE TRUE EQUALS NOTHING
-- a provision that did not make a corporation a director is outside the subsection
#ASSERT `s 145(4) the provision is read as authorising the corporation to appoint a natural person to be a director` TRUE FALSE EQUALS NOTHING

-- s 145(6): subsection (5) "does not apply where a director ... is required to resign or vacate his or her office -- (a) if the director has not within the period ... obtained his or her qualification; or (b) by virtue of his or her disqualification or removal ... under section 148, 149, 149A, 154, 155, 155A or 155C ..., section 50 or 54 of the Banking Act 1970, ..."
-- paragraph (a)
#ASSERT `s 145(6) subsection (5) does not apply to the director's resignation or vacation of office` TRUE `s 145(6)(b) none of these` EQUALS JUST TRUE
-- paragraph (b): a section of this Act on the list
#ASSERT `s 145(6) subsection (5) does not apply to the director's resignation or vacation of office` FALSE `s 145(6)(b) section 148, 149, 149A, 154, 155, 155A or 155C of this Act` EQUALS JUST TRUE
-- paragraph (b): the Banking Act section
#ASSERT `s 145(6) subsection (5) does not apply to the director's resignation or vacation of office` FALSE `s 145(6)(b) section 50 or 54 of the Banking Act 1970` EQUALS JUST TRUE
-- paragraph (b): the Banking Act section as applied by section 55ZJ
#ASSERT `s 145(6) subsection (5) does not apply to the director's resignation or vacation of office` FALSE `s 145(6)(b) section 50 or 54 of the Banking Act 1970 as applied by section 55ZJ of that Act` EQUALS JUST TRUE
-- paragraph (b): the last item on the list, section 14 of the Trust Companies Act 2005
#ASSERT `s 145(6) subsection (5) does not apply to the director's resignation or vacation of office` FALSE `s 145(6)(b) section 14 of the Trust Companies Act 2005` EQUALS JUST TRUE
-- neither ground: the where-gate of the exception fails (ruling (b)), so subsection (5) is not lifted
#ASSERT `s 145(6) subsection (5) does not apply to the director's resignation or vacation of office` FALSE `s 145(6)(b) none of these` EQUALS JUST FALSE

-- s 145(5): "a director of a company must not resign or vacate his or her office unless there is remaining in the company at least one director who is ordinarily resident in Singapore"; the bar and its two exceptions in (6)
-- no resident director would remain, and no exception in subsection (6)
#ASSERT `s 145(5) the subsection bars the director from resigning or vacating office` FALSE FALSE `s 145(6)(b) none of these` EQUALS JUST TRUE
-- "unless there is remaining at least one director who is ordinarily resident in Singapore": the unless is met
#ASSERT `s 145(5) the subsection bars the director from resigning or vacating office` TRUE FALSE `s 145(6)(b) none of these` EQUALS JUST FALSE
-- subsection (6)(a): the bar does not apply
#ASSERT `s 145(5) the subsection bars the director from resigning or vacating office` FALSE TRUE `s 145(6)(b) none of these` EQUALS JUST FALSE
-- subsection (6)(b): the bar does not apply
#ASSERT `s 145(5) the subsection bars the director from resigning or vacating office` FALSE FALSE `s 145(6)(b) section 148, 149, 149A, 154, 155, 155A or 155C of this Act` EQUALS JUST FALSE
-- "any purported resignation or vacation of office in breach of this subsection is invalid"
#ASSERT `s 145(5) the purported resignation or vacation of office is invalid` FALSE FALSE `s 145(6)(b) none of these` EQUALS JUST TRUE
-- not in breach: the text says nothing about validity
#ASSERT `s 145(5) the purported resignation or vacation of office is invalid` TRUE FALSE `s 145(6)(b) none of these` EQUALS NOTHING
-- not in breach (subsection (6)(a)): the text says nothing about validity
#ASSERT `s 145(5) the purported resignation or vacation of office is invalid` FALSE TRUE `s 145(6)(b) none of these` EQUALS NOTHING

-- s 145(4A): "Subject to subsection (5), unless the constitution otherwise provides, a director of a company may resign by giving the company a written notice of his or her resignation"
-- notice given, a resident director would remain, constitution silent
#ASSERT `s 145(4A) the director may resign by giving the company a written notice of resignation` FALSE TRUE TRUE FALSE `s 145(6)(b) none of these` EQUALS JUST TRUE
-- "unless the constitution otherwise provides": the constitution is outside the text
#ASSERT `s 145(4A) the director may resign by giving the company a written notice of resignation` TRUE TRUE TRUE FALSE `s 145(6)(b) none of these` EQUALS NOTHING
-- "Subject to subsection (5)": the bar applies, so the right to resign by notice does not
#ASSERT `s 145(4A) the director may resign by giving the company a written notice of resignation` FALSE TRUE FALSE FALSE `s 145(6)(b) none of these` EQUALS JUST FALSE
-- no notice given: the text names only resignation by written notice
#ASSERT `s 145(4A) the director may resign by giving the company a written notice of resignation` FALSE FALSE TRUE FALSE `s 145(6)(b) none of these` EQUALS NOTHING

-- s 145(4B): "Subject to subsection (5), the resignation of a director is not conditional upon the company's acceptance"
-- a flat negative: the resignation is not conditional (so the answer to "is it conditional" is no)
#ASSERT `s 145(4B) the resignation is conditional upon the company's acceptance of it` TRUE FALSE `s 145(6)(b) none of these` EQUALS JUST FALSE
-- subject to the bar in subsection (5), which applies here: the text says no more
#ASSERT `s 145(4B) the resignation is conditional upon the company's acceptance of it` FALSE FALSE `s 145(6)(b) none of these` EQUALS NOTHING

-- s 145(7): "If there is a contravention of subsection (1), the Registrar may ... direct the members ... if the Registrar considers it to be in the interests of the company"
#ASSERT `s 145(7) the Registrar may direct the members of the company to appoint a director who is ordinarily resident in Singapore` TRUE TRUE EQUALS JUST TRUE
-- an "if" gate on a power: the grant ruling gives NOTHING
#ASSERT `s 145(7) the Registrar may direct the members of the company to appoint a director who is ordinarily resident in Singapore` TRUE FALSE EQUALS NOTHING
-- no contravention of subsection (1): outside the subsection
#ASSERT `s 145(7) the Registrar may direct the members of the company to appoint a director who is ordinarily resident in Singapore` FALSE TRUE EQUALS NOTHING

-- s 145(8): "If the direction under subsection (7) is not complied with, each member in default shall be guilty of an offence ... a fine not exceeding $2,000 and ... a further fine not exceeding $1,000 for every day or part thereof"
#ASSERT `s 145(8) the member is guilty of the offence this subsection creates` TRUE TRUE TRUE EQUALS JUST TRUE
-- no direction was given
#ASSERT `s 145(8) the member is guilty of the offence this subsection creates` FALSE TRUE TRUE EQUALS JUST FALSE
-- the direction was complied with
#ASSERT `s 145(8) the member is guilty of the offence this subsection creates` TRUE FALSE TRUE EQUALS JUST FALSE
-- not a member in default
#ASSERT `s 145(8) the member is guilty of the offence this subsection creates` TRUE TRUE FALSE EQUALS JUST FALSE
-- a $2,000 fine, a further $1,000 a day, no imprisonment, no default penalty
#ASSERT `s 145(8) the most the member may be penalised on conviction` TRUE TRUE TRUE EQUALS JUST (`s 145(8) penalty` OF 2000, 0, 1000, FALSE, FALSE)
-- the text states a penalty only for a guilty member
#ASSERT `s 145(8) the most the member may be penalised on conviction` FALSE TRUE TRUE EQUALS NOTHING

-- s 145(9): the Court may order the members to appoint, on the application of the Registrar or any person, if (a) the Registrar fails to direct or (b) the direction is not complied with
-- paragraph (a)
#ASSERT `s 145(9) the Court may order the members of the company to make the appointment` TRUE TRUE FALSE TRUE TRUE EQUALS JUST TRUE
-- paragraph (b)
#ASSERT `s 145(9) the Court may order the members of the company to make the appointment` TRUE FALSE TRUE TRUE TRUE EQUALS JUST TRUE
-- neither (a) nor (b)
#ASSERT `s 145(9) the Court may order the members of the company to make the appointment` TRUE FALSE FALSE TRUE TRUE EQUALS NOTHING
-- no contravention of subsection (1)
#ASSERT `s 145(9) the Court may order the members of the company to make the appointment` FALSE TRUE FALSE TRUE TRUE EQUALS NOTHING
-- the Court does not consider it in the interests of the company: an "if" gate on a power
#ASSERT `s 145(9) the Court may order the members of the company to make the appointment` TRUE TRUE FALSE TRUE FALSE EQUALS NOTHING

-- s 145(10): "for more than 6 months" ... a member who knows is liable for the debts contracted after those 6 months
#ASSERT `s 145(10) the member is liable for the payment of the debts of the company` 7 TRUE TRUE EQUALS JUST TRUE
-- exactly 6 months is not "more than 6 months"
#ASSERT `s 145(10) the member is liable for the payment of the debts of the company` 6 TRUE TRUE EQUALS JUST FALSE
-- not a member
#ASSERT `s 145(10) the member is liable for the payment of the debts of the company` 7 FALSE TRUE EQUALS JUST FALSE
-- does not know
#ASSERT `s 145(10) the member is liable for the payment of the debts of the company` 7 TRUE FALSE EQUALS JUST FALSE
-- a debt contracted during the period
#ASSERT `s 145(10) the debt is within the liability of the member` 7 TRUE TRUE TRUE EQUALS JUST TRUE
-- a debt contracted before the 6 months run out: outside the words "contracted during the period"
#ASSERT `s 145(10) the debt is within the liability of the member` 7 TRUE TRUE FALSE EQUALS NOTHING
-- the 6 months have not been passed
#ASSERT `s 145(10) the debt is within the liability of the member` 6 TRUE TRUE TRUE EQUALS JUST FALSE

-- s 145A(4): the three defined terms
-- a director accustomed to act on another's directions
#ASSERT `s 145A(4) "nominee director" the person is a nominee director` TRUE TRUE FALSE EQUALS JUST TRUE
-- a director under an obligation to act on another's directions
#ASSERT `s 145A(4) "nominee director" the person is a nominee director` TRUE FALSE TRUE EQUALS JUST TRUE
-- "means a director who is accustomed or under an obligation": neither
#ASSERT `s 145A(4) "nominee director" the person is a nominee director` TRUE FALSE FALSE EQUALS JUST FALSE
-- not a director
#ASSERT `s 145A(4) "nominee director" the person is a nominee director` FALSE TRUE TRUE EQUALS JUST FALSE
-- a company that employs the person
#ASSERT `s 145A(4) "affiliated company" the company is an affiliated company of the person` TRUE FALSE EQUALS JUST TRUE
-- a company deemed related by section 6 to a corporation that employs the person
#ASSERT `s 145A(4) "affiliated company" the company is an affiliated company of the person` FALSE TRUE EQUALS JUST TRUE
-- "means" definition: neither limb
#ASSERT `s 145A(4) "affiliated company" the company is an affiliated company of the person` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 145A(4) "appointed day" the date asked is on or after the appointed day` (Date 2 1 2026) (Date 1 1 2026) EQUALS JUST TRUE
-- on the appointed day itself
#ASSERT `s 145A(4) "appointed day" the date asked is on or after the appointed day` (Date 1 1 2026) (Date 1 1 2026) EQUALS JUST TRUE
-- the day before the appointed day
#ASSERT `s 145A(4) "appointed day" the date asked is on or after the appointed day` (Date 31 12 2025) (Date 1 1 2026) EQUALS JUST FALSE

-- s 145A(1): "on or after the appointed day, act as a nominee director of a company by way of business, unless (a) a registered corporate service provider ...; or (b) his or her so acting is arranged by a registered corporate service provider"; (2) not where affiliated company or commenced before the appointed day
-- acting by way of business after the appointed day, with none of the exceptions
#ASSERT `s 145A(1) the subsection bars the person from acting as a nominee director of the company by way of business` TRUE (Date 2 1 2026) (Date 1 1 2026) FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- on the appointed day itself ("on or after")
#ASSERT `s 145A(1) the subsection bars the person from acting as a nominee director of the company by way of business` TRUE (Date 1 1 2026) (Date 1 1 2026) FALSE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- before the appointed day: outside the words "on or after the appointed day"
#ASSERT `s 145A(1) the subsection bars the person from acting as a nominee director of the company by way of business` TRUE (Date 31 12 2025) (Date 1 1 2026) FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
-- not acting by way of business: the text bars only acting "by way of business"
#ASSERT `s 145A(1) the subsection bars the person from acting as a nominee director of the company by way of business` FALSE (Date 2 1 2026) (Date 1 1 2026) FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- unless (a): a registered corporate service provider for that service
#ASSERT `s 145A(1) the subsection bars the person from acting as a nominee director of the company by way of business` TRUE (Date 2 1 2026) (Date 1 1 2026) TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
-- registered, but not for the service of acting as a director: (a) is not met
#ASSERT `s 145A(1) the subsection bars the person from acting as a nominee director of the company by way of business` TRUE (Date 2 1 2026) (Date 1 1 2026) TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- unless (b): the acting is arranged by a registered corporate service provider
#ASSERT `s 145A(1) the subsection bars the person from acting as a nominee director of the company by way of business` TRUE (Date 2 1 2026) (Date 1 1 2026) FALSE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
-- subsection (2)(a): the affiliated company
#ASSERT `s 145A(1) the subsection bars the person from acting as a nominee director of the company by way of business` TRUE (Date 2 1 2026) (Date 1 1 2026) FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- subsection (2)(b): acting began before the appointed day
#ASSERT `s 145A(1) the subsection bars the person from acting as a nominee director of the company by way of business` TRUE (Date 2 1 2026) (Date 1 1 2026) FALSE FALSE FALSE FALSE TRUE EQUALS JUST FALSE

-- s 145A(3): "$10,000 and, in the case of a continuing offence, ... a further fine not exceeding $1,000 for every day"
#ASSERT `s 145A(3) the person is guilty of the offence this subsection creates` TRUE EQUALS JUST TRUE
-- no contravention of subsection (1)
#ASSERT `s 145A(3) the person is guilty of the offence this subsection creates` FALSE EQUALS JUST FALSE
#ASSERT `s 145A(3) the most the person may be fined on conviction` TRUE EQUALS JUST (`s 145A(3) penalty` OF 10000, 1000)
#ASSERT `s 145A(3) the most the person may be fined on conviction` FALSE EQUALS NOTHING

-- s 146(1A)(a): all three of (i), (ii) and (iii) are filed ("and")
#ASSERT `s 146(1A)(a) the person has made the filings paragraph (a) requires` TRUE TRUE TRUE EQUALS JUST TRUE
-- (iii) is missing
#ASSERT `s 146(1A)(a) the person has made the filings paragraph (a) requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- (i) is missing
#ASSERT `s 146(1A)(a) the person has made the filings paragraph (a) requires` FALSE TRUE TRUE EQUALS JUST FALSE

-- s 146(1A)(b): any one of (i), (ii), (iii) or (iv) ("or"); (iv) needs the reconstruction case and the declaration
-- (i)
#ASSERT `s 146(1A)(b) the person has made the filing paragraph (b) requires` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- (ii)
#ASSERT `s 146(1A)(b) the person has made the filing paragraph (b) requires` FALSE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- (iii)
#ASSERT `s 146(1A)(b) the person has made the filing paragraph (b) requires` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- (iv): a reconstruction and the declaration
#ASSERT `s 146(1A)(b) the person has made the filing paragraph (b) requires` FALSE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
-- (iv) without the declaration
#ASSERT `s 146(1A)(b) the person has made the filing paragraph (b) requires` FALSE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
-- none of the four
#ASSERT `s 146(1A)(b) the person has made the filing paragraph (b) requires` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

-- s 146(3)(c): "a constitution adopted by a company after the expiration of one year from the date on which the company was entitled to commence business"
-- on the last day of the first year the year has not expired
#ASSERT `s 146(3)(c) the document is outside subsections (1) and (2) by reason of paragraph (c)` TRUE (Date 1 1 2027) (Date 1 1 2026) EQUALS NOTHING
-- the day after the year expires
#ASSERT `s 146(3)(c) the document is outside subsections (1) and (2) by reason of paragraph (c)` TRUE (Date 2 1 2027) (Date 1 1 2026) EQUALS JUST TRUE
-- not a prospectus, statement in lieu or constitution
#ASSERT `s 146(3)(c) the document is outside subsections (1) and (2) by reason of paragraph (c)` FALSE (Date 2 1 2027) (Date 1 1 2026) EQUALS NOTHING

-- s 146(3): subsections (1) and (2) do not apply to (a) a company not having a share capital; (b) a private company; (c) the documents above
-- (a)
#ASSERT `s 146(3) the requirements of subsections (1) and (2), other than the provisions relating to the signing of a consent to act as director, do not apply` TRUE FALSE FALSE EQUALS JUST TRUE
-- (b)
#ASSERT `s 146(3) the requirements of subsections (1) and (2), other than the provisions relating to the signing of a consent to act as director, do not apply` FALSE TRUE FALSE EQUALS JUST TRUE
-- (c)
#ASSERT `s 146(3) the requirements of subsections (1) and (2), other than the provisions relating to the signing of a consent to act as director, do not apply` FALSE FALSE TRUE EQUALS JUST TRUE
-- a public company with a share capital, no document in (c): the exemption is not met
#ASSERT `s 146(3) the requirements of subsections (1) and (2), other than the provisions relating to the signing of a consent to act as director, do not apply` FALSE FALSE FALSE EQUALS JUST FALSE

-- s 146(1): "A person must not be named as a director or proposed director in (a) any document filed ... for the purposes of the incorporation ...; or (b) the register ..., unless, before ... the person has complied with the conditions set out in subsection (1A)"
-- named in a document for incorporation; both conditions met first
#ASSERT `s 146(1) the subsection bars the person from being named as a director or proposed director` `s 146(1)(a) in a document filed or lodged with or submitted to the Registrar for the purposes of the incorporation of a company` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- paragraph (b) of subsection (1A) is not met
#ASSERT `s 146(1) the subsection bars the person from being named as a director or proposed director` `s 146(1)(a) in a document filed or lodged with or submitted to the Registrar for the purposes of the incorporation of a company` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- paragraph (a) of subsection (1A) is not met
#ASSERT `s 146(1) the subsection bars the person from being named as a director or proposed director` `s 146(1)(a) in a document filed or lodged with or submitted to the Registrar for the purposes of the incorporation of a company` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- named in the register with neither condition met
#ASSERT `s 146(1) the subsection bars the person from being named as a director or proposed director` `s 146(1)(b) in the register of directors, chief executive officers and secretaries of a company` FALSE FALSE FALSE FALSE EQUALS JUST TRUE
-- named elsewhere: the text lists two places
#ASSERT `s 146(1) the subsection bars the person from being named as a director or proposed director` `s 146(1) somewhere else` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- subsection (3) applies and the consent to act is filed
#ASSERT `s 146(1) the subsection bars the person from being named as a director or proposed director` `s 146(1)(a) in a document filed or lodged with or submitted to the Registrar for the purposes of the incorporation of a company` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- subsection (3) excepts all but "the provisions relating to the signing of a consent to act as director": no consent filed
#ASSERT `s 146(1) the subsection bars the person from being named as a director or proposed director` `s 146(1)(a) in a document filed or lodged with or submitted to the Registrar for the purposes of the incorporation of a company` FALSE FALSE TRUE FALSE EQUALS JUST TRUE

-- s 146(2): "Where a person has undertaken to the Registrar under subsection (1A)(b)(ii) ... the person is, as regards those shares, in the same position as if the person had signed the constitution"
#ASSERT `s 146(2) the person is, as regards those shares, in the same position as if the person had signed the constitution for that number of shares` TRUE EQUALS JUST TRUE
-- a "where" condition that fails (ruling (b))
#ASSERT `s 146(2) the person is, as regards those shares, in the same position as if the person had signed the constitution for that number of shares` FALSE EQUALS JUST FALSE

-- s 146(4): "the company and every officer of the company who is in default shall be guilty of an offence ... a fine not exceeding $10,000 and also to a default penalty"
#ASSERT `s 146(4) the person is guilty of the offence this subsection creates` TRUE TRUE EQUALS JUST TRUE
-- not in default
#ASSERT `s 146(4) the person is guilty of the offence this subsection creates` TRUE FALSE EQUALS JUST FALSE
-- no default in complying with the section
#ASSERT `s 146(4) the person is guilty of the offence this subsection creates` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 146(4) the most the person may be penalised on conviction` TRUE TRUE EQUALS JUST (`s 146(4) penalty` OF 10000, TRUE)
#ASSERT `s 146(4) the most the person may be penalised on conviction` FALSE TRUE EQUALS NOTHING

-- s 146(5): the restrictions as to a prospectus apply to a director of a foreign company
#ASSERT `s 146(5) the restrictions apply to a director or proposed director of the foreign company` TRUE TRUE EQUALS JUST TRUE
-- not a foreign company
#ASSERT `s 146(5) the restrictions apply to a director or proposed director of the foreign company` FALSE TRUE EQUALS NOTHING
-- not a restriction in relation to a prospectus
#ASSERT `s 146(5) the restrictions apply to a director or proposed director of the foreign company` TRUE FALSE EQUALS NOTHING

-- s 147(1): "within 2 months after his or her appointment or such shorter period as is fixed by the constitution"; appointed 15 January 2026, two months after ends on 15 March 2026; 30 days after ends on 14 February 2026
#ASSERT `s 147(1) the last day on which the director must have obtained the qualification` (Date 15 1 2026) FALSE 0 EQUALS (Date 15 3 2026)
-- a shorter period of 30 days fixed by the constitution
#ASSERT `s 147(1) the last day on which the director must have obtained the qualification` (Date 15 1 2026) TRUE 30 EQUALS (Date 14 2 2026)
-- on the last day: in time
#ASSERT `s 147(1) the director has obtained the qualification in time` TRUE TRUE (Date 15 1 2026) FALSE 0 (Date 15 3 2026) EQUALS JUST TRUE
-- a day late
#ASSERT `s 147(1) the director has obtained the qualification in time` TRUE TRUE (Date 15 1 2026) FALSE 0 (Date 16 3 2026) EQUALS JUST FALSE
-- on the last day of the shorter period
#ASSERT `s 147(1) the director has obtained the qualification in time` TRUE TRUE (Date 15 1 2026) TRUE 30 (Date 14 2 2026) EQUALS JUST TRUE
-- a day after the shorter period
#ASSERT `s 147(1) the director has obtained the qualification in time` TRUE TRUE (Date 15 1 2026) TRUE 30 (Date 15 2 2026) EQUALS JUST FALSE
-- no specified share qualification required by the constitution: outside "every director who is by the constitution required to hold"
#ASSERT `s 147(1) the director has obtained the qualification in time` FALSE TRUE (Date 15 1 2026) FALSE 0 (Date 16 3 2026) EQUALS NOTHING
-- already qualified: outside "who is not already qualified"
#ASSERT `s 147(1) the director has obtained the qualification in time` TRUE FALSE (Date 15 1 2026) FALSE 0 (Date 16 3 2026) EQUALS NOTHING

-- s 147(2): "Unless otherwise provided by the constitution, the qualification of any director ... must be held by him or her solely and not as one of several joint holders"
#ASSERT `s 147(2) the way the qualification is held meets the subsection` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 147(2) the way the qualification is held meets the subsection` FALSE FALSE EQUALS JUST FALSE
-- the constitution may provide otherwise: outside the text
#ASSERT `s 147(2) the way the qualification is held meets the subsection` TRUE FALSE EQUALS NOTHING

-- s 147(3): "A director must vacate his or her office if he or she has not within the period ... obtained his or her qualification or if after so obtaining it he or she ceases at any time to hold"
#ASSERT `s 147(3) the director must vacate office` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 147(3) the director must vacate office` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 147(3) the director must vacate office` FALSE FALSE EQUALS JUST FALSE

-- s 147(4): "a fine not exceeding $4,000 and also to a default penalty"
#ASSERT `s 147(4) the person is guilty of the offence this subsection creates` TRUE EQUALS JUST TRUE
#ASSERT `s 147(4) the person is guilty of the offence this subsection creates` FALSE EQUALS JUST FALSE
#ASSERT `s 147(4) the most the person may be penalised on conviction` TRUE EQUALS JUST (`s 147(4) penalty` OF 4000, TRUE)
#ASSERT `s 147(4) the most the person may be penalised on conviction` FALSE EQUALS NOTHING

-- s 147(5): "A person vacating office under this section is incapable of being re-appointed as director until the person has obtained his or her qualification"
#ASSERT `s 147(5) the person cannot yet be re-appointed as director` TRUE FALSE EQUALS JUST TRUE
-- "until" met
#ASSERT `s 147(5) the person cannot yet be re-appointed as director` TRUE TRUE EQUALS JUST FALSE
-- did not vacate under section 147: outside the subsection
#ASSERT `s 147(5) the person cannot yet be re-appointed as director` FALSE FALSE EQUALS NOTHING

-- Regulative rules: each #TRACE has an EXPECT line above it naming the outcome the text gives; each rule has a breach trace where the text allows one.

-- the forbidden act occurs
-- EXPECT BREACH
#TRACE `s 145(5) a director must not resign or vacate office leaving no director ordinarily resident in Singapore` "D" AT 0 WITH
    PARTY Director "D" DOES `s 145(5) resign or vacate office leaving no director who is ordinarily resident in Singapore` AT 3

-- nothing happens: the prohibition is still on
-- EXPECT RESIDUAL
#TRACE `s 145(5) a director must not resign or vacate office leaving no director ordinarily resident in Singapore` "D" AT 0 WITH
    WAITUNTIL 3

-- the forbidden act occurs
-- EXPECT BREACH
#TRACE `s 145A(1) a person must not act as a nominee director by way of business unless a registered corporate service provider` "P" AT 0 WITH
    PARTY Individual "P" DOES `s 145A(1) act as a nominee director of a company by way of business on or after the appointed day, neither as nor through a registered corporate service provider` AT 5

-- nothing happens
-- EXPECT RESIDUAL
#TRACE `s 145A(1) a person must not act as a nominee director by way of business unless a registered corporate service provider` "P" AT 0 WITH
    WAITUNTIL 5

