IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sgb1-s149b-appointment`

-- Tests for sgb1-s149b-appointment.l4 (Companies Act 1967, ss 149B, 150, 151, 152; text lines 12236-12386 of CoA1967.txt).
-- Every expected value was written from the text of the Act, not from what the code printed; each group names the words it rests on.
-- JUST TRUE yes; JUST FALSE the text says no in its own words; NOTHING the text does not say.


-- s 149B: "Unless the constitution otherwise provides, a company may appoint a director by ordinary resolution passed at a general meeting"
#ASSERT `s 149B the company may appoint a director by ordinary resolution passed at a general meeting` FALSE `an ordinary resolution` TRUE EQUALS JUST TRUE
-- "Unless the constitution otherwise provides": the constitution is outside the text
#ASSERT `s 149B the company may appoint a director by ordinary resolution passed at a general meeting` TRUE `an ordinary resolution` TRUE EQUALS NOTHING
-- a special resolution is not what the section names
#ASSERT `s 149B the company may appoint a director by ordinary resolution passed at a general meeting` FALSE `a special resolution` TRUE EQUALS NOTHING
-- a resolution of the directors is not what the section names
#ASSERT `s 149B the company may appoint a director by ordinary resolution passed at a general meeting` FALSE `a resolution of the directors` TRUE EQUALS NOTHING
-- not passed at a general meeting
#ASSERT `s 149B the company may appoint a director by ordinary resolution passed at a general meeting` FALSE `an ordinary resolution` FALSE EQUALS NOTHING

-- s 150(1): "At a general meeting of a public company, a motion for the appointment of 2 or more persons as directors by a single resolution must not be made unless a resolution that it may be so made has first been agreed to by the meeting without any vote being given against it"; (5): nothing in this section applies to a resolution altering the constitution or prevents the election of 2 or more directors by ballot or poll
-- two persons, a single resolution, no prior agreement
#ASSERT `s 150(1) the section bars the motion for the appointment of 2 or more persons as directors by a single resolution` FALSE 2 TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- "unless" met: a resolution that it may be so made was agreed without a vote against
#ASSERT `s 150(1) the section bars the motion for the appointment of 2 or more persons as directors by a single resolution` FALSE 2 TRUE TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- one person: outside "2 or more persons"
#ASSERT `s 150(1) the section bars the motion for the appointment of 2 or more persons as directors by a single resolution` FALSE 1 TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
-- three persons
#ASSERT `s 150(1) the section bars the motion for the appointment of 2 or more persons as directors by a single resolution` FALSE 3 TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
-- a private company: outside "a public company"
#ASSERT `s 150(1) the section bars the motion for the appointment of 2 or more persons as directors by a single resolution` TRUE 2 TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
-- not by a single resolution
#ASSERT `s 150(1) the section bars the motion for the appointment of 2 or more persons as directors by a single resolution` FALSE 2 FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
-- subsection (5)(a): a resolution altering the constitution
#ASSERT `s 150(1) the section bars the motion for the appointment of 2 or more persons as directors by a single resolution` FALSE 2 TRUE TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- subsection (5)(b): election by ballot or poll
#ASSERT `s 150(1) the section bars the motion for the appointment of 2 or more persons as directors by a single resolution` FALSE 2 TRUE TRUE FALSE FALSE TRUE EQUALS JUST FALSE

-- s 150(5): "Nothing in this section (a) applies to a resolution altering the company's constitution; (b) prevents the election of 2 or more directors by ballot or poll"
-- (a)
#ASSERT `s 150(5) nothing in section 150 applies to the resolution or prevents the election` TRUE FALSE EQUALS JUST TRUE
-- (b)
#ASSERT `s 150(5) nothing in section 150 applies to the resolution or prevents the election` FALSE TRUE EQUALS JUST TRUE
-- neither case: the subsection names two cases and says nothing of the rest
#ASSERT `s 150(5) nothing in section 150 applies to the resolution or prevents the election` FALSE FALSE EQUALS NOTHING
-- "A resolution passed pursuant to a motion made in contravention of this section is void, whether or not its being so moved was objected to"
#ASSERT `s 150(2) the resolution passed pursuant to the motion is void` TRUE EQUALS JUST TRUE
#ASSERT `s 150(2) the resolution passed pursuant to the motion is void` FALSE EQUALS NOTHING
-- "no provision for the automatic re-appointment of retiring directors ... is to apply"
#ASSERT `s 150(3) a provision for the automatic re-appointment of retiring directors in default of another appointment applies` TRUE EQUALS JUST FALSE
#ASSERT `s 150(3) a provision for the automatic re-appointment of retiring directors in default of another appointment applies` FALSE EQUALS NOTHING
-- a motion for approving a person's appointment
#ASSERT `s 150(4) the motion is treated as a motion for the person's appointment` TRUE FALSE EQUALS JUST TRUE
-- a motion for nominating a person
#ASSERT `s 150(4) the motion is treated as a motion for the person's appointment` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 150(4) the motion is treated as a motion for the person's appointment` FALSE FALSE EQUALS NOTHING

-- s 151: "The acts of a director or chief executive officer or secretary are valid despite any defect that may afterwards be discovered in his or her appointment or qualification"
#ASSERT `s 151 the act is valid despite a defect in the appointment or qualification of the person who did it` `s 151 a director` TRUE EQUALS JUST TRUE
#ASSERT `s 151 the act is valid despite a defect in the appointment or qualification of the person who did it` `s 151 a chief executive officer` TRUE EQUALS JUST TRUE
#ASSERT `s 151 the act is valid despite a defect in the appointment or qualification of the person who did it` `s 151 a secretary` TRUE EQUALS JUST TRUE
-- an auditor, say: the text names three kinds of person
#ASSERT `s 151 the act is valid despite a defect in the appointment or qualification of the person who did it` `s 151 someone else` TRUE EQUALS NOTHING
-- no defect discovered: the text speaks only of a defect
#ASSERT `s 151 the act is valid despite a defect in the appointment or qualification of the person who did it` `s 151 a director` FALSE EQUALS NOTHING

-- s 152(1): "A public company may by ordinary resolution remove a director before the expiration of his or her period of office, despite anything in its constitution or in any agreement between it and the director"
#ASSERT `s 152(1) the public company may remove the director by ordinary resolution` FALSE `an ordinary resolution` TRUE EQUALS JUST TRUE
-- a private company: subsection (9) governs, not subsection (1)
#ASSERT `s 152(1) the public company may remove the director by ordinary resolution` TRUE `an ordinary resolution` TRUE EQUALS NOTHING
-- not by ordinary resolution
#ASSERT `s 152(1) the public company may remove the director by ordinary resolution` FALSE `a special resolution` TRUE EQUALS NOTHING
-- not before the expiration of the period of office
#ASSERT `s 152(1) the public company may remove the director by ordinary resolution` FALSE `an ordinary resolution` FALSE EQUALS NOTHING

-- s 152(1): "where any director so removed was appointed to represent the interests of any particular class of shareholders or debenture holders the resolution to remove the director does not take effect until the director's successor has been appointed" (an "until" bar)
-- before the successor is appointed
#ASSERT `s 152(1) the resolution to remove the director cannot yet take effect` TRUE FALSE EQUALS JUST TRUE
-- after the successor is appointed
#ASSERT `s 152(1) the resolution to remove the director cannot yet take effect` TRUE TRUE EQUALS JUST FALSE
-- not a director appointed to represent a class: outside the proviso
#ASSERT `s 152(1) the resolution to remove the director cannot yet take effect` FALSE FALSE EQUALS NOTHING

-- s 152(2): special notice; "on receipt of notice of an intended resolution to remove a director ... the company must immediately send a copy thereof to the director concerned, and the director ... is entitled to be heard on the resolution at the meeting"
-- removal under subsection (1)
#ASSERT `s 152(2) special notice is required of the resolution` TRUE FALSE EQUALS JUST TRUE
-- appointing a replacement at the meeting at which the director is removed
#ASSERT `s 152(2) special notice is required of the resolution` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 152(2) special notice is required of the resolution` FALSE FALSE EQUALS NOTHING
#ASSERT `s 152(2) the company must immediately send a copy of the notice to the director concerned` TRUE EQUALS JUST TRUE
-- an "on receipt" gate that fails
#ASSERT `s 152(2) the company must immediately send a copy of the notice to the director concerned` FALSE EQUALS JUST FALSE
#ASSERT `s 152(2) the director is entitled to be heard on the resolution at the meeting` TRUE EQUALS JUST TRUE
-- an "on receipt" gate that fails
#ASSERT `s 152(2) the director is entitled to be heard on the resolution at the meeting` FALSE EQUALS JUST FALSE

-- s 152(3): "Where notice is given pursuant to subsection (2) and the director ... makes ... representations in writing ... not exceeding a reasonable length, and requests their notification ..., the company must, unless the representations are received by it too late ... (a) ... state the fact of the representations having been made; and (b) send a copy"
#ASSERT `s 152(3) the company must notify the members of the representations` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- "unless" met: received too late
#ASSERT `s 152(3) the company must notify the members of the representations` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
-- a "where" gate that fails
#ASSERT `s 152(3) the company must notify the members of the representations` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
-- no representations made
#ASSERT `s 152(3) the company must notify the members of the representations` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- notification not requested
#ASSERT `s 152(3) the company must notify the members of the representations` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
-- not sent because received too late
#ASSERT `s 152(3) the director may require that the representations be read out at the meeting` TRUE FALSE EQUALS JUST TRUE
-- not sent because of the company's default
#ASSERT `s 152(3) the director may require that the representations be read out at the meeting` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 152(3) the director may require that the representations be read out at the meeting` FALSE FALSE EQUALS NOTHING

-- s 152(4): "Despite subsections (1), (2) and (3), copies of the representations need not be sent out ... if, on the application either of the public company or of any other person who claims to be aggrieved, the Court is satisfied that the rights ... are being abused to secure needless publicity for defamatory matter and the Court may order the company's costs ... to be paid in whole or in part by the director"
#ASSERT `s 152(4) copies of the representations need not be sent out and the representations need not be read out` TRUE TRUE EQUALS JUST TRUE
-- a condition introduced with "if" that fails
#ASSERT `s 152(4) copies of the representations need not be sent out and the representations need not be read out` FALSE TRUE EQUALS JUST FALSE
-- a condition introduced with "if" that fails
#ASSERT `s 152(4) copies of the representations need not be sent out and the representations need not be read out` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 152(4) the Court may order the company's costs to be paid in whole or in part by the director` TRUE TRUE EQUALS JUST TRUE
-- an "if" gate on a power: the grant ruling gives NOTHING
#ASSERT `s 152(4) the Court may order the company's costs to be paid in whole or in part by the director` TRUE FALSE EQUALS NOTHING

-- s 152(5) and (6)
#ASSERT `s 152(5) the vacancy may be filled as a casual vacancy` TRUE TRUE EQUALS JUST TRUE
-- filled at the meeting: outside "if not filled at the meeting"
#ASSERT `s 152(5) the vacancy may be filled as a casual vacancy` TRUE FALSE EQUALS NOTHING
#ASSERT `s 152(5) the vacancy may be filled as a casual vacancy` FALSE TRUE EQUALS NOTHING
-- treated as if he or she had become a director on the day on which the person removed was last appointed
#ASSERT `s 152(6) the day on which the replacement is treated as having become a director for the purpose of determining the time to retire` TRUE (Date 1 3 2020) EQUALS JUST (Date 1 3 2020)
-- not appointed in place of a person removed
#ASSERT `s 152(6) the day on which the replacement is treated as having become a director for the purpose of determining the time to retire` FALSE (Date 1 3 2020) EQUALS NOTHING

-- s 152(7): "Nothing in subsections (1) to (6) is to be taken as depriving a person removed ... of compensation or damages ... or as derogating from any power to remove a director which may exist apart from this section"
#ASSERT `s 152(7) the removal deprives the person of compensation or damages payable in respect of the termination of the appointment` TRUE EQUALS JUST FALSE
#ASSERT `s 152(7) the removal deprives the person of compensation or damages payable in respect of the termination of the appointment` FALSE EQUALS NOTHING
#ASSERT `s 152(7) the section derogates from a power to remove a director which exists apart from the section` TRUE EQUALS JUST FALSE
#ASSERT `s 152(7) the section derogates from a power to remove a director which exists apart from the section` FALSE EQUALS NOTHING

-- s 152(8): "A director of a public company must not be removed by, or be required to vacate his or her office by reason of, any resolution, request or notice of the directors or any of them despite anything in the constitution or any agreement"
#ASSERT `s 152(8) the subsection bars the directors from removing a director of a public company by their resolution, request or notice` FALSE TRUE EQUALS JUST TRUE
-- a private company: outside "a director of a public company"
#ASSERT `s 152(8) the subsection bars the directors from removing a director of a public company by their resolution, request or notice` TRUE TRUE EQUALS NOTHING
-- not by a resolution, request or notice of the directors
#ASSERT `s 152(8) the subsection bars the directors from removing a director of a public company by their resolution, request or notice` FALSE FALSE EQUALS NOTHING

-- s 152(9): "Subject to any provision to the contrary in the constitution, a private company may by ordinary resolution remove a director before the expiration of his or her period of office despite anything in any agreement"
#ASSERT `s 152(9) the private company may remove the director by ordinary resolution` TRUE FALSE `an ordinary resolution` TRUE EQUALS JUST TRUE
-- "Subject to any provision to the contrary in the constitution"
#ASSERT `s 152(9) the private company may remove the director by ordinary resolution` TRUE TRUE `an ordinary resolution` TRUE EQUALS NOTHING
-- a public company: subsection (1) governs
#ASSERT `s 152(9) the private company may remove the director by ordinary resolution` FALSE FALSE `an ordinary resolution` TRUE EQUALS NOTHING
#ASSERT `s 152(9) the private company may remove the director by ordinary resolution` TRUE FALSE `a special resolution` TRUE EQUALS NOTHING

-- Regulative rules: each #TRACE has an EXPECT line above it naming the outcome the text gives. s 152(2) has "immediately" and no number of days, so it has no deadline a trace can miss: no breach path (NOTES.md).

-- the company sends the copy
-- EXPECT FULFILLED
#TRACE `s 152(2) a public company must send a copy of the notice of an intended removal to the director` "Co" AT 0 WITH
    PARTY Company "Co" DOES `s 152(2) send a copy of the notice of the intended resolution to the director concerned` AT 1

-- a late sending still reads FULFILLED: "immediately" is not a number of days
-- EXPECT FULFILLED
#TRACE `s 152(2) a public company must send a copy of the notice of an intended removal to the director` "Co" AT 0 WITH
    PARTY Company "Co" DOES `s 152(2) send a copy of the notice of the intended resolution to the director concerned` AT 400

-- nothing sent: the obligation stays open, never BREACH
-- EXPECT RESIDUAL
#TRACE `s 152(2) a public company must send a copy of the notice of an intended removal to the director` "Co" AT 0 WITH
    WAITUNTIL 400
