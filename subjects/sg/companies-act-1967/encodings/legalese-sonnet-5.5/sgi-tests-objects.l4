IMPORT prelude
IMPORT daydate
IMPORT `sg-core`
IMPORT `sg-periods`
IMPORT `sgi-objects`

-- Tests for sgi-objects.l4 (ss 33 and 34). Expected values are written from the text beside each assertion.

§ `s 33(1): altering the objects by special resolution`

#ASSERT `s 33(1) the company may alter the provisions of its constitution with respect to its objects by the resolution` `a special resolution` TRUE EQUALS JUST TRUE
-- Another kind of resolution: the subsection does not say (NOTHING).
#ASSERT `s 33(1) the company may alter the provisions of its constitution with respect to its objects by the resolution` `an ordinary resolution` TRUE EQUALS NOTHING
-- "the objects of the company, if any": none, nothing to alter (NOTHING).
#ASSERT `s 33(1) the company may alter the provisions of its constitution with respect to its objects by the resolution` `a special resolution` FALSE EQUALS NOTHING

§ `s 33(2) to (4): the 21 days' notice`

-- Meeting on 31 March 2026; notice given on 10 March 2026 is exactly 21 days before (31 - 21 = 10): in time.
#ASSERT `s 33(2) the company has given the notice the subsection requires` (Date 10 3 2026) (Date 31 3 2026) TRUE TRUE EQUALS JUST TRUE
-- Notice given on 11 March 2026 is 20 days before: late.
#ASSERT `s 33(2) the company has given the notice the subsection requires` (Date 11 3 2026) (Date 31 3 2026) TRUE TRUE EQUALS JUST FALSE
-- Notice given on 9 March 2026: earlier than needed, in time.
#ASSERT `s 33(2) the company has given the notice the subsection requires` (Date 9 3 2026) (Date 31 3 2026) TRUE TRUE EQUALS JUST TRUE
-- Not in writing by post or electronic communications, or not specifying the special resolution: not the notice the subsection requires.
#ASSERT `s 33(2) the company has given the notice the subsection requires` (Date 10 3 2026) (Date 31 3 2026) FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 33(2) the company has given the notice the subsection requires` (Date 10 3 2026) (Date 31 3 2026) TRUE FALSE EQUALS JUST FALSE
-- The duty as a regulative rule: last day for giving notice is day 10 from time 0. An act on day 10 is in time; on day 11 it is not.
-- EXPECT FULFILLED
#TRACE `s 33(2) the company must give 21 days' written notice` "Acme Pte. Ltd." 10 AT 0 WITH
    PARTY Company "Acme Pte. Ltd." DOES `s 33(2) give 21 days' written notice of the intention to propose the resolution as a special resolution` AT 10
-- EXPECT BREACH
#TRACE `s 33(2) the company must give 21 days' written notice` "Acme Pte. Ltd." 10 AT 0 WITH
    PARTY Company "Acme Pte. Ltd." DOES `s 33(2) give 21 days' written notice of the intention to propose the resolution as a special resolution` AT 11
-- EXPECT BREACH
#TRACE `s 33(2) the company must give 21 days' written notice` "Acme Pte. Ltd." 10 AT 0 WITH
    (WAITUNTIL 11)
-- EXPECT RESIDUAL
#TRACE `s 33(2) the company must give 21 days' written notice` "Acme Pte. Ltd." 10 AT 0 WITH
-- (3): to all members, to all trustees for debenture holders, and to debenture holders of a class with no trustee whose names are known.
#ASSERT `s 33(3) the notice must be given to the person` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 33(3) the notice must be given to the person` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 33(3) the notice must be given to the person` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 33(3) the notice must be given to the person` FALSE FALSE FALSE EQUALS NOTHING
-- (4): the Court may dispense with the notice for reasons that seem sufficient to it.
#ASSERT `s 33(4) the Court may dispense with the notice for the person or class of persons` TRUE EQUALS JUST TRUE
#ASSERT `s 33(4) the Court may dispense with the notice for the person or class of persons` FALSE EQUALS NOTHING

§ `s 33(5) to (7): the application to cancel the alteration`

-- (5A): treasury shares are disregarded: 1,000 issued shares of which 100 are held as treasury shares count as 900.
#ASSERT `s 33(5A) the number of issued shares counted for subsection (5)` 1000 100 EQUALS 900
-- (5)(a), company limited by shares: 5% of 900 is 45: applicants holding 45 qualify (boundary), 44 do not.
#ASSERT `s 33(5)(a) the applicants hold enough of the shares, or are enough of the members` `limited by shares` 45 1000 100 0 0 EQUALS JUST TRUE
#ASSERT `s 33(5)(a) the applicants hold enough of the shares, or are enough of the members` `limited by shares` 44 1000 100 0 0 EQUALS JUST FALSE
-- Without the treasury-share rule 5% of 1,000 would be 50, so 45 would not qualify: this pair shows (5A) matters.
#ASSERT `s 33(5)(a) the applicants hold enough of the shares, or are enough of the members` `limited by shares` 45 1000 0 0 0 EQUALS JUST FALSE
-- A company limited by guarantee: 5% of the members: 5 of 100 qualify, 4 do not.
#ASSERT `s 33(5)(a) the applicants hold enough of the shares, or are enough of the members` `limited by guarantee` 0 0 0 5 100 EQUALS JUST TRUE
#ASSERT `s 33(5)(a) the applicants hold enough of the shares, or are enough of the members` `limited by guarantee` 0 0 0 4 100 EQUALS JUST FALSE
-- An unlimited company is "not limited by shares": members count.
#ASSERT `s 33(5)(a) the applicants hold enough of the shares, or are enough of the members` `unlimited` 0 0 0 5 100 EQUALS JUST TRUE
-- No issued shares and no members: no application can qualify.
#ASSERT `s 33(5)(a) the applicants hold enough of the shares, or are enough of the members` `limited by shares` 0 0 0 0 0 EQUALS JUST FALSE
#ASSERT `s 33(5)(a) the applicants hold enough of the shares, or are enough of the members` `limited by guarantee` 0 0 0 0 0 EQUALS JUST FALSE
-- (5)(b): 5% in nominal value of the debentures: 5,000 of 100,000 qualifies, 4,999 does not.
#ASSERT `s 33(5)(b) the applicants hold enough in nominal value of the company's debentures` 5000 100000 EQUALS JUST TRUE
#ASSERT `s 33(5)(b) the applicants hold enough in nominal value of the company's debentures` 4999 100000 EQUALS JUST FALSE
#ASSERT `s 33(5)(b) the applicants hold enough in nominal value of the company's debentures` 0 0 EQUALS JUST FALSE
-- (6): within 21 days after the resolution of 1 March 2026: the last day is 22 March 2026.
#ASSERT `s 33(6) the application is made in time` (Date 1 3 2026) (Date 22 3 2026) EQUALS JUST TRUE
#ASSERT `s 33(6) the application is made in time` (Date 1 3 2026) (Date 23 3 2026) EQUALS JUST FALSE
#ASSERT `s 33(6) the application may be made on behalf of the persons entitled by the applicants` TRUE EQUALS JUST TRUE
#ASSERT `s 33(6) the application may be made on behalf of the persons entitled by the applicants` FALSE EQUALS NOTHING
-- (5): an application in accordance with the section by qualifying holders: the alteration needs the Court's confirmation.
#ASSERT `s 33(5) the alteration does not have effect except so far as the Court confirms it` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 33(5) the alteration does not have effect except so far as the Court confirms it` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 33(5) the alteration does not have effect except so far as the Court confirms it` FALSE TRUE EQUALS JUST FALSE
-- (7): On the application, the Court.
#ASSERT `s 33(7)(a) the Court must have regard to the rights and interests of the members and of the creditors` TRUE EQUALS JUST TRUE
#ASSERT `s 33(7)(a) the Court must have regard to the rights and interests of the members and of the creditors` FALSE EQUALS JUST FALSE
#ASSERT `s 33(7)(b) the Court may adjourn the proceedings` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 33(7)(b) the Court may adjourn the proceedings` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 33(7)(b) the Court may adjourn the proceedings` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 33(7)(b) the Court may adjourn the proceedings` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 33(7)(c) the Court may give the directions and make the orders` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 33(7)(c) the Court may give the directions and make the orders` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 33(7)(c) the Court may give the directions and make the orders` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 33(7)(c) the Court may give the directions and make the orders` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 33(7)(d) the Court may make an order cancelling the alteration or confirming it, wholly or in part` TRUE EQUALS JUST TRUE
#ASSERT `s 33(7)(d) the Court may make an order cancelling the alteration or confirming it, wholly or in part` FALSE EQUALS NOTHING

§ `s 33(8) to (11): lodging`

-- Resolution passed 1 March 2026, no application. The 21 days after run to 22 March 2026 (P1); the first day lodging is not barred is 23 March 2026.
#ASSERT `s 33(8) the first day on which the copy may be lodged` (Date 1 3 2026) FALSE (Date 1 1 2000) EQUALS Date 23 3 2026
#ASSERT `s 33(8) lodging the copy of the resolution on the day is barred` (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 22 3 2026) EQUALS JUST TRUE
#ASSERT `s 33(8) lodging the copy of the resolution on the day is barred` (Date 1 3 2026) FALSE (Date 1 1 2000) (Date 23 3 2026) EQUALS JUST FALSE
-- An application made and determined on 10 April 2026 is later than the 21 days: lodging is barred until the determination.
#ASSERT `s 33(8) the first day on which the copy may be lodged` (Date 1 3 2026) TRUE (Date 10 4 2026) EQUALS Date 10 4 2026
#ASSERT `s 33(8) lodging the copy of the resolution on the day is barred` (Date 1 3 2026) TRUE (Date 10 4 2026) (Date 9 4 2026) EQUALS JUST TRUE
#ASSERT `s 33(8) lodging the copy of the resolution on the day is barred` (Date 1 3 2026) TRUE (Date 10 4 2026) (Date 10 4 2026) EQUALS JUST FALSE
-- An application determined earlier than the 21 days expire: the later of the two governs ("whichever is the later").
#ASSERT `s 33(8) the first day on which the copy may be lodged` (Date 1 3 2026) TRUE (Date 15 3 2026) EQUALS Date 23 3 2026
-- (9): no application: the 14 days after the expiration of the 21 days run from 22 March 2026 to 5 April 2026.
#ASSERT `s 33(9) the company has complied with the duty to lodge the copy of the resolution` (Date 1 3 2026) FALSE (Date 1 1 2000) TRUE (Date 5 4 2026) FALSE (Date 30 4 2026) EQUALS JUST TRUE
#ASSERT `s 33(9) the company has complied with the duty to lodge the copy of the resolution` (Date 1 3 2026) FALSE (Date 1 1 2000) TRUE (Date 6 4 2026) FALSE (Date 30 4 2026) EQUALS JUST FALSE
-- An application determined on 10 April 2026: the copy must be lodged with a copy of the order within 14 days after, that is by 24 April 2026.
#ASSERT `s 33(9) the company has complied with the duty to lodge the copy of the resolution` (Date 1 3 2026) TRUE (Date 10 4 2026) TRUE (Date 24 4 2026) TRUE (Date 30 4 2026) EQUALS JUST TRUE
#ASSERT `s 33(9) the company has complied with the duty to lodge the copy of the resolution` (Date 1 3 2026) TRUE (Date 10 4 2026) TRUE (Date 25 4 2026) TRUE (Date 30 4 2026) EQUALS JUST FALSE
-- Without the copy of the order the duty is not met.
#ASSERT `s 33(9) the company has complied with the duty to lodge the copy of the resolution` (Date 1 3 2026) TRUE (Date 10 4 2026) TRUE (Date 20 4 2026) FALSE (Date 30 4 2026) EQUALS JUST FALSE
-- Not lodged: asked after the last day, JUST FALSE; asked on the last day, NOTHING.
#ASSERT `s 33(9) the company has complied with the duty to lodge the copy of the resolution` (Date 1 3 2026) FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE (Date 6 4 2026) EQUALS JUST FALSE
#ASSERT `s 33(9) the company has complied with the duty to lodge the copy of the resolution` (Date 1 3 2026) FALSE (Date 1 1 2000) FALSE (Date 1 1 2000) FALSE (Date 5 4 2026) EQUALS NOTHING
-- The regulative rule: time 0 is the day the 14 days run from.
-- EXPECT FULFILLED
#TRACE `s 33(9) the company must lodge a copy of the resolution within 14 days` "Acme Pte. Ltd." AT 0 WITH
    PARTY Company "Acme Pte. Ltd." DOES `s 33(9) lodge with the Registrar a copy of the resolution altering the objects (with a copy of the order of the Court, if an application has been made)` AT 14
-- EXPECT BREACH
#TRACE `s 33(9) the company must lodge a copy of the resolution within 14 days` "Acme Pte. Ltd." AT 0 WITH
    PARTY Company "Acme Pte. Ltd." DOES `s 33(9) lodge with the Registrar a copy of the resolution altering the objects (with a copy of the order of the Court, if an application has been made)` AT 15
-- EXPECT BREACH
#TRACE `s 33(9) the company must lodge a copy of the resolution within 14 days` "Acme Pte. Ltd." AT 0 WITH
    (WAITUNTIL 15)
-- (10): on compliance with (9) the alteration takes effect.
#ASSERT `s 33(10) the alteration of the objects takes effect` TRUE EQUALS JUST TRUE
#ASSERT `s 33(10) the alteration of the objects takes effect` FALSE EQUALS JUST FALSE
-- (11): removal is within "alteration".
#ASSERT `s 33(11) the thing is within the word alteration` TRUE EQUALS JUST TRUE
#ASSERT `s 33(11) the thing is within the word alteration` FALSE EQUALS NOTHING

§ `s 34: the Residential Property Act 1976`

#ASSERT `s 34(1) the company may amend its constitution to remove the provision` TRUE `a special resolution` EQUALS JUST TRUE
#ASSERT `s 34(1) the company may amend its constitution to remove the provision` TRUE `an ordinary resolution` EQUALS NOTHING
-- No such provision in the constitution: the "Where" gate fails; NOTHING under the grant ruling (split site (ii)).
#ASSERT `s 34(1) the company may amend its constitution to remove the provision` FALSE `a special resolution` EQUALS NOTHING
-- (2)(a): the provision ceases to have effect as from 31 March 2006: on that day yes, the day before no.
#ASSERT `s 34(2)(a) the provision has ceased to have effect` TRUE (Date 31 3 2006) EQUALS JUST TRUE
#ASSERT `s 34(2)(a) the provision has ceased to have effect` TRUE (Date 30 3 2006) EQUALS JUST FALSE
#ASSERT `s 34(2)(a) the provision has ceased to have effect` TRUE (Date 1 1 2027) EQUALS JUST TRUE
#ASSERT `s 34(2)(a) the provision has ceased to have effect` FALSE (Date 1 1 2027) EQUALS NOTHING
#ASSERT `s 34(2)(b) the company may amend its constitution to remove that provision` TRUE `a special resolution` EQUALS JUST TRUE
#ASSERT `s 34(2)(b) the company may amend its constitution to remove that provision` TRUE `a resolution of the directors` EQUALS NOTHING
#ASSERT `s 34(2)(b) the company may amend its constitution to remove that provision` FALSE `a special resolution` EQUALS NOTHING
