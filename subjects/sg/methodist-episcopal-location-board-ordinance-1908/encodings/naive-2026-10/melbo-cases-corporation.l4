IMPORT prelude
IMPORT `melbo-corporation`

-- Methodist Episcopal Location Board Ordinance 1908, ss 2-6 and the Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_methodist-episcopal-location-board-ordinance-1908.py). Expected results were written by
-- hand from the text.

`a Secretary appointed, certified, filed and gazetted` MEANS Successor WITH
    `is appointed Secretary by the minutes of the Trustees` IS TRUE
    `the extract is certified correct by the Chairman` IS TRUE
    `the extract is filed in the office of the Minister` IS TRUE
    `the filing is notified in the Gazette` IS TRUE

`a Secretary whose filing is not yet gazetted` MEANS Successor WITH
    `is appointed Secretary by the minutes of the Trustees` IS TRUE
    `the extract is certified correct by the Chairman` IS TRUE
    `the extract is filed in the office of the Minister` IS TRUE
    `the filing is notified in the Gazette` IS FALSE

`a Secretary whose certified extract was never filed` MEANS Successor WITH
    `is appointed Secretary by the minutes of the Trustees` IS TRUE
    `the extract is certified correct by the Chairman` IS TRUE
    `the extract is filed in the office of the Minister` IS FALSE
    `the filing is notified in the Gazette` IS FALSE

`a Secretary gazetted on an uncertified extract` MEANS Successor WITH
    `is appointed Secretary by the minutes of the Trustees` IS TRUE
    `the extract is certified correct by the Chairman` IS FALSE
    `the extract is filed in the office of the Minister` IS TRUE
    `the filing is notified in the Gazette` IS TRUE

`a person gazetted who was never appointed by the Trustees` MEANS Successor WITH
    `is appointed Secretary by the minutes of the Trustees` IS FALSE
    `the extract is certified correct by the Chairman` IS TRUE
    `the extract is filed in the office of the Minister` IS TRUE
    `the filing is notified in the Gazette` IS TRUE

`a lease sealed before and signed by the qualified Secretary` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Secretary for the time being, duly qualified`
    `signed by` IS `the Secretary for the time being, duly qualified`

`a transfer sealed before the Secretary and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Secretary for the time being, duly qualified`
    `signed by` IS `an attorney under a deposited power of attorney`

`a mortgage sealed before and signed by a Secretary not yet gazetted` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Secretary for the time being, appointed but not yet gazetted`
    `signed by` IS `the Secretary for the time being, appointed but not yet gazetted`

`a conveyance sealed before and signed by an undeposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney whose power of attorney is not deposited`
    `signed by` IS `an attorney whose power of attorney is not deposited`

`a deed sealed before a Trustee and signed by the Secretary` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a Trustee who is not the Secretary`
    `signed by` IS `the Secretary for the time being, duly qualified`

`a document signed by the Secretary but never sealed` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS FALSE
    `sealed in the presence of` IS `the Secretary for the time being, duly qualified`
    `signed by` IS `the Secretary for the time being, duly qualified`

`the Financial Board's leasehold in item 2` MEANS Holding WITH
    `the land is listed in the Schedule` IS TRUE
    `the holder is specified in the third column for it` IS TRUE
    `the holder is executor or administrator of such a person` IS FALSE

`a named trustee's executor's estate in item 4` MEANS Holding WITH
    `the land is listed in the Schedule` IS TRUE
    `the holder is specified in the third column for it` IS FALSE
    `the holder is executor or administrator of such a person` IS TRUE

`a stranger's interest in Schedule land` MEANS Holding WITH
    `the land is listed in the Schedule` IS TRUE
    `the holder is specified in the third column for it` IS FALSE
    `the holder is executor or administrator of such a person` IS FALSE

`Financial Board land not listed in the Schedule` MEANS Holding WITH
    `the land is listed in the Schedule` IS FALSE
    `the holder is specified in the third column for it` IS TRUE
    `the holder is executor or administrator of such a person` IS FALSE

§ `ss 2(1) and 4`

#ASSERT `is duly qualified` `a Secretary appointed, certified, filed and gazetted`
#ASSERT NOT `is duly qualified` `a Secretary whose filing is not yet gazetted`
#ASSERT NOT `is duly qualified` `a Secretary whose certified extract was never filed`
#ASSERT NOT `is duly qualified` `a Secretary gazetted on an uncertified extract`
#ASSERT NOT `is duly qualified` `a person gazetted who was never appointed by the Trustees`

#ASSERT `the Gazette notification is sufficient evidence of qualification` `a Secretary appointed, certified, filed and gazetted`
#ASSERT NOT `the Gazette notification is sufficient evidence of qualification` `a Secretary whose filing is not yet gazetted`
#ASSERT NOT `the Gazette notification is sufficient evidence of qualification` `a Secretary whose certified extract was never filed`
#ASSERT `the Gazette notification is sufficient evidence of qualification` `a Secretary gazetted on an uncertified extract`
#ASSERT `the Gazette notification is sufficient evidence of qualification` `a person gazetted who was never appointed by the Trustees`

§ `s 2(2), (3)`

#ASSERT `the Ordinance empowers the Corporation to` `use and change its corporate seal` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `acquire or purchase property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `hold and enjoy property` TRUE
#ASSERT `the Ordinance empowers the Corporation to` `sell or convey property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell or convey property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `mortgage property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `demise property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `transfer or otherwise dispose of property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sue or be sued` TRUE

§ `s 3`

#ASSERT `is executed as section 3 requires` `a lease sealed before and signed by the qualified Secretary`
#ASSERT `is executed as section 3 requires` `a transfer sealed before the Secretary and signed by a deposited attorney`
#ASSERT `is executed as section 3 requires` `a mortgage sealed before and signed by a Secretary not yet gazetted`
#ASSERT NOT `is executed as section 3 requires` `a conveyance sealed before and signed by an undeposited attorney`
#ASSERT NOT `is executed as section 3 requires` `a deed sealed before a Trustee and signed by the Secretary`
#ASSERT NOT `is executed as section 3 requires` `a document signed by the Secretary but never sealed`

#ASSERT `the signature is sufficient evidence of due sealing` `a lease sealed before and signed by the qualified Secretary`
#ASSERT `the signature is sufficient evidence of due sealing` `a transfer sealed before the Secretary and signed by a deposited attorney`
#ASSERT `the signature is sufficient evidence of due sealing` `a mortgage sealed before and signed by a Secretary not yet gazetted`
#ASSERT NOT `the signature is sufficient evidence of due sealing` `a conveyance sealed before and signed by an undeposited attorney`
#ASSERT `the signature is sufficient evidence of due sealing` `a deed sealed before a Trustee and signed by the Secretary`
#ASSERT NOT `the signature is sufficient evidence of due sealing` `a document signed by the Secretary but never sealed`

