§ `s 2`

#ASSERT `is a foreign national emblem` `the flag of a foreign country`
#ASSERT `is a foreign national emblem` `the flag of a dependency or part of a foreign country`
#ASSERT NOT `is a foreign national emblem` `the Singapore flag`
#ASSERT NOT `is a foreign national emblem` `a likeness of a foreign film star`

#ASSERT `the premises are a school` TRUE
#ASSERT NOT `the premises are a school` FALSE

§ `s 3`

#ASSERT `is displayed in public` `a Singaporean waving a foreign team's flag on a street`
#ASSERT `is displayed in public` `a foreign resident's own national flag in a window facing the street`
#ASSERT NOT `is displayed in public` `the same flag hung inside a flat out of public view`

#ASSERT NOT `section 3 catches the display` `the same flag hung inside a flat out of public view`
#ASSERT `section 3 catches the display` `a poster of a former foreign leader in a tuition centre`
#ASSERT NOT `section 3 catches the display` `the Singapore flag on a street`

