IMPORT prelude
IMPORT `va-seat`

-- Vandalism Act 1966 -- worked cases for the questions in va-seat.l4. The expected values are those of the existing
-- hand-checked cases in va-cases-vandalism.l4, asked from the seat of the person accused.

§ `Is it vandalism, and is it an offence`

#ASSERT `Is what I did vandalism` `writing or marking on property` `the Government` FALSE
#ASSERT `Is what I did vandalism` `writing or marking on property` `a private individual` FALSE
#ASSERT NOT `Is what I did vandalism` `writing or marking on property` `a private individual` TRUE
#ASSERT `Is what I did vandalism` `damaging property` `a statutory body` FALSE
#ASSERT NOT `Is what I did vandalism` `damaging property` `a private company` FALSE
#ASSERT `Have I committed a vandalism offence` `writing or marking on property` `the Government` FALSE TRUE FALSE FALSE
#ASSERT `Have I committed a vandalism offence` `damaging property` `the Government` FALSE FALSE TRUE FALSE
#ASSERT NOT `Have I committed a vandalism offence` `writing or marking on property` `the Government` FALSE FALSE FALSE FALSE
#ASSERT NOT `Have I committed a vandalism offence` `writing or marking on property` `a private individual` TRUE TRUE FALSE FALSE

§ `What can happen to me`

#ASSERT `What is the most I can be fined` EQUALS 2000
#ASSERT `What is the longest I can be imprisoned in months` EQUALS 36
#ASSERT `What is the fewest strokes of the cane` EQUALS 3
#ASSERT `What is the most strokes of the cane` EQUALS 8
#ASSERT `Must I be caned` `damaging property` TRUE FALSE FALSE
#ASSERT `Must I be caned` `writing or marking on property` TRUE FALSE FALSE
#ASSERT NOT `Must I be caned` `writing or marking on property` TRUE TRUE FALSE
#ASSERT NOT `Must I be caned` `posting up a poster or notice` TRUE FALSE FALSE
#ASSERT `Must I be caned` `posting up a poster or notice` FALSE FALSE FALSE
#ASSERT NOT `Must I be caned` `damaging property` FALSE FALSE TRUE
#ASSERT `Can I be arrested without a warrant and refused bail` `the section 3 vandalism offence`
#ASSERT `Can I be arrested without a warrant and refused bail` `the section 4(2) failure to produce offence`

§ `If I am stopped`

#ASSERT `Do I have to hand it over` `a Singapore Police Force officer`
#ASSERT NOT `Do I have to hand it over` `a private security guard`
#ASSERT NOT `Do I have to hand it over` `the property owner`
#ASSERT `Is it an offence that I did not hand it over` `an Auxiliary Police Force officer` FALSE
#ASSERT NOT `Is it an offence that I did not hand it over` `an Auxiliary Police Force officer` TRUE
#ASSERT NOT `Is it an offence that I did not hand it over` `a town council officer` FALSE
#ASSERT `What is the most I can be fined for not handing it over` EQUALS 500
#ASSERT `Can they take the article from me` `SAF military police` TRUE
#ASSERT NOT `Can they take the article from me` `SAF military police` FALSE
#ASSERT NOT `Can they take the article from me` `a private security guard` TRUE
