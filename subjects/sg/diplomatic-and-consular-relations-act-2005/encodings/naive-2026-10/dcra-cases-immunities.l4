IMPORT prelude
IMPORT `dcra-immunities`

-- Diplomatic and Consular Relations Act 2005, ss 3, 4, 5, 7 and the Articles of the Vienna Conventions they enact -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_diplomatic-and-consular-relations-act-2005.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a foreign ambassador` MEANS Person WITH
    `role` IS `diplomatic agent`
    `is a Singapore citizen` IS FALSE
    `is permanently resident in Singapore` IS FALSE
    `carries on a private gainful occupation in Singapore` IS FALSE

`a Singapore-citizen diplomat of a foreign mission` MEANS Person WITH
    `role` IS `diplomatic agent`
    `is a Singapore citizen` IS TRUE
    `is permanently resident in Singapore` IS FALSE
    `carries on a private gainful occupation in Singapore` IS FALSE

`an ambassador's spouse who is a Singapore PR` MEANS Person WITH
    `role` IS `family member of a diplomatic agent`
    `is a Singapore citizen` IS FALSE
    `is permanently resident in Singapore` IS TRUE
    `carries on a private gainful occupation in Singapore` IS FALSE

`a foreign embassy clerk` MEANS Person WITH
    `role` IS `administrative and technical staff of a mission`
    `is a Singapore citizen` IS FALSE
    `is permanently resident in Singapore` IS FALSE
    `carries on a private gainful occupation in Singapore` IS FALSE

`a foreign embassy driver` MEANS Person WITH
    `role` IS `service staff of a mission`
    `is a Singapore citizen` IS FALSE
    `is permanently resident in Singapore` IS FALSE
    `carries on a private gainful occupation in Singapore` IS FALSE

`a diplomat's foreign maid` MEANS Person WITH
    `role` IS `private servant of a mission member`
    `is a Singapore citizen` IS FALSE
    `is permanently resident in Singapore` IS FALSE
    `carries on a private gainful occupation in Singapore` IS FALSE

`a diplomat's maid who is a Singapore PR` MEANS Person WITH
    `role` IS `private servant of a mission member`
    `is a Singapore citizen` IS FALSE
    `is permanently resident in Singapore` IS TRUE
    `carries on a private gainful occupation in Singapore` IS FALSE

`a foreign career consul` MEANS Person WITH
    `role` IS `career consular officer`
    `is a Singapore citizen` IS FALSE
    `is permanently resident in Singapore` IS FALSE
    `carries on a private gainful occupation in Singapore` IS FALSE

`a Singapore-citizen honorary consul` MEANS Person WITH
    `role` IS `honorary consular officer`
    `is a Singapore citizen` IS TRUE
    `is permanently resident in Singapore` IS FALSE
    `carries on a private gainful occupation in Singapore` IS FALSE

`a foreign consular clerk` MEANS Person WITH
    `role` IS `consular employee`
    `is a Singapore citizen` IS FALSE
    `is permanently resident in Singapore` IS FALSE
    `carries on a private gainful occupation in Singapore` IS FALSE

`a foreign consular clerk with a side business` MEANS Person WITH
    `role` IS `consular employee`
    `is a Singapore citizen` IS FALSE
    `is permanently resident in Singapore` IS FALSE
    `carries on a private gainful occupation in Singapore` IS TRUE

`a career consul's foreign spouse` MEANS Person WITH
    `role` IS `family member of a career consular officer`
    `is a Singapore citizen` IS FALSE
    `is permanently resident in Singapore` IS FALSE
    `carries on a private gainful occupation in Singapore` IS FALSE

`a prosecution for a private act` MEANS Proceedings WITH
    `criminal` IS TRUE
    `about an act in the course of official functions` IS FALSE
    `subject` IS `an ordinary matter`

`a prosecution for an act in the course of duties` MEANS Proceedings WITH
    `criminal` IS TRUE
    `about an act in the course of official functions` IS TRUE
    `subject` IS `an ordinary matter`

`a private debt claim` MEANS Proceedings WITH
    `criminal` IS FALSE
    `about an act in the course of official functions` IS FALSE
    `subject` IS `an ordinary matter`

`a claim on a private flat they own in Singapore` MEANS Proceedings WITH
    `criminal` IS FALSE
    `about an act in the course of official functions` IS FALSE
    `subject` IS `private immovable property in Singapore`

`a claim about their private consultancy business` MEANS Proceedings WITH
    `criminal` IS FALSE
    `about an act in the course of official functions` IS FALSE
    `subject` IS `private professional or commercial activity`

`a claim on an official act` MEANS Proceedings WITH
    `criminal` IS FALSE
    `about an act in the course of official functions` IS TRUE
    `subject` IS `an ordinary matter`

`a claim on an office lease signed in their own name` MEANS Proceedings WITH
    `criminal` IS FALSE
    `about an act in the course of official functions` IS TRUE
    `subject` IS `a contract not made as agent of the sending State`

`a car-accident claim from an official trip` MEANS Proceedings WITH
    `criminal` IS FALSE
    `about an act in the course of official functions` IS TRUE
    `subject` IS `a third-party claim for a vehicle, vessel or aircraft accident`

`a car-accident claim from a private trip` MEANS Proceedings WITH
    `criminal` IS FALSE
    `about an act in the course of official functions` IS FALSE
    `subject` IS `a third-party claim for a vehicle, vessel or aircraft accident`

