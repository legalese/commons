IMPORT prelude
IMPORT `mma-manoeuvres`

-- Military Manoeuvres Act 1905, ss 2 to 7 and 9 to 14 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_military-manoeuvres-act-1905.py). Expected results were written by
-- hand from the text.

§ `s 2 -- notice`

#ASSERT `notice to the Armed Forces Council is required` 501 FALSE
#ASSERT NOT `notice to the Armed Forces Council is required` 500 FALSE
#ASSERT NOT `notice to the Armed Forces Council is required` 5000 TRUE

#ASSERT `the notice was given early enough` 1
#ASSERT NOT `the notice was given early enough` 0.5

#ASSERT `the notified period is within the limit` 3
#ASSERT NOT `the notified period is within the limit` 4

#ASSERT `the notice was posted in time` 14
#ASSERT NOT `the notice was posted in time` 13

#ASSERT `the claims date in the notice is lawful` 1
#ASSERT NOT `the claims date in the notice is lawful` 0.5

#ASSERT `manoeuvres without notice stay within the Act` 500 48 FALSE
#ASSERT NOT `manoeuvres without notice stay within the Act` 500 49 FALSE
#ASSERT NOT `manoeuvres without notice stay within the Act` 501 24 FALSE
#ASSERT `manoeuvres without notice stay within the Act` 3000 100 TRUE

§ `s 3 -- entry and water`

#ASSERT `the troops may enter` `an open field` TRUE
#ASSERT `the troops may enter` `vacant land` TRUE
#ASSERT NOT `the troops may enter` `a dwelling house` TRUE
#ASSERT NOT `the troops may enter` `a garden within the curtilage of a dwelling house` TRUE
#ASSERT NOT `the troops may enter` `ground attached to a place of worship` TRUE
#ASSERT NOT `the troops may enter` `ground attached to a school` TRUE
#ASSERT NOT `the troops may enter` `a factory` TRUE
#ASSERT NOT `the troops may enter` `an open field` FALSE

#ASSERT `the troops may take water from the source` FALSE FALSE
#ASSERT NOT `the troops may take water from the source` TRUE FALSE
#ASSERT `the troops may take water from the source` TRUE TRUE

§ `ss 4, 5, 11(3), 12 -- compensation`

#ASSERT `the compensation route` `crops trampled during manoeuvres` EQUALS `s 4 full compensation`
#ASSERT `the compensation route` `land losing value by being proclaimed a firing ground` EQUALS `s 12 compensation`
#ASSERT `the compensation route` `a private fishing right obstructed by firing-ground rules` EQUALS `s 11(3) compensation`

#ASSERT `the s 4 claim is in time` TRUE TRUE FALSE
#ASSERT NOT `the s 4 claim is in time` TRUE FALSE TRUE
#ASSERT `the s 4 claim is in time` FALSE FALSE TRUE

#ASSERT `the number of arbitrators` EQUALS 2

#ASSERT `the total compensation for a firing-ground owner` 5000 1200 EQUALS 6200

§ `s 6 -- offences`

#ASSERT `the conduct is an offence under s 6` `wilfully and unlawfully interfering with the manoeuvres` TRUE TRUE
#ASSERT `the conduct is an offence under s 6` `entering a camp without authority` TRUE TRUE
#ASSERT NOT `the conduct is an offence under s 6` `entering a camp with authority` TRUE TRUE
#ASSERT `the conduct is an offence under s 6` `maliciously cutting a field telephone wire` TRUE TRUE
#ASSERT NOT `the conduct is an offence under s 6` `accidentally damaging a field telephone wire` TRUE TRUE
#ASSERT NOT `the conduct is an offence under s 6` `watching the manoeuvres` TRUE TRUE
#ASSERT NOT `the conduct is an offence under s 6` `entering a camp without authority` FALSE TRUE

#ASSERT `the maximum fine in dollars` EQUALS 2000

§ `s 7 -- catchments`

#ASSERT NOT `manoeuvres may be held on the land` TRUE FALSE
#ASSERT `manoeuvres may be held on the land` TRUE TRUE

§ `s 10 -- firing exercises`

#ASSERT `the occupiers were given the notice the Act requires` 24 TRUE
#ASSERT NOT `the occupiers were given the notice the Act requires` 12 TRUE

§ `s 11 -- rules`

#ASSERT `the rule's penalty is within the Act` 2000 6
#ASSERT NOT `the rule's penalty is within the Act` 5000 6

#ASSERT NOT `the rule can come into force` `fishing` FALSE
#ASSERT `the rule can come into force` `swimming` FALSE
#ASSERT `the rule can come into force` `fishing` TRUE

