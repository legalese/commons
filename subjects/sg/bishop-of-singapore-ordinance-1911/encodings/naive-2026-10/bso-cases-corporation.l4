IMPORT prelude
IMPORT `bso-corporation`

-- Bishop of Singapore Ordinance 1911, ss 2-6 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_bishop-of-singapore-ordinance-1911.py). Expected results were written by
-- hand from the text.

`a successor recognised and gazetted` MEANS Claimant WITH
    `is a Bishop of the Church of England` IS TRUE
    `is recognised by the Archbishop of Canterbury as authorised for the Settlements` IS TRUE
    `appointment is notified in the Gazette` IS TRUE

`a successor recognised but not yet gazetted` MEANS Claimant WITH
    `is a Bishop of the Church of England` IS TRUE
    `is recognised by the Archbishop of Canterbury as authorised for the Settlements` IS TRUE
    `appointment is notified in the Gazette` IS FALSE

`a Church of England bishop not recognised for the Settlements` MEANS Claimant WITH
    `is a Bishop of the Church of England` IS TRUE
    `is recognised by the Archbishop of Canterbury as authorised for the Settlements` IS FALSE
    `appointment is notified in the Gazette` IS FALSE

`a recognised bishop of another church` MEANS Claimant WITH
    `is a Bishop of the Church of England` IS FALSE
    `is recognised by the Archbishop of Canterbury as authorised for the Settlements` IS TRUE
    `appointment is notified in the Gazette` IS FALSE

`a gazetted person who is not a Church of England bishop` MEANS Claimant WITH
    `is a Bishop of the Church of England` IS FALSE
    `is recognised by the Archbishop of Canterbury as authorised for the Settlements` IS FALSE
    `appointment is notified in the Gazette` IS TRUE

`church land in Singapore conveyed in 1900 to The Bishop of Singapore` MEANS Holding WITH
    `is immovable` IS TRUE
    `is situated in` IS `Singapore`
    `was conveyed, assigned or vested in The Bishop of Singapore before the Ordinance` IS TRUE
    `the deed names the individual bishop` IS FALSE

`land in Penang conveyed before 1911 to the Bishop by his own name` MEANS Holding WITH
    `is immovable` IS TRUE
    `is situated in` IS `Penang`
    `was conveyed, assigned or vested in The Bishop of Singapore before the Ordinance` IS TRUE
    `the deed names the individual bishop` IS TRUE

`land in Malacca vested in The Bishop of Singapore before 1911` MEANS Holding WITH
    `is immovable` IS TRUE
    `is situated in` IS `Malacca`
    `was conveyed, assigned or vested in The Bishop of Singapore before the Ordinance` IS TRUE
    `the deed names the individual bishop` IS FALSE

`land outside the Settlements conveyed before 1911` MEANS Holding WITH
    `is immovable` IS TRUE
    `is situated in` IS `elsewhere`
    `was conveyed, assigned or vested in The Bishop of Singapore before the Ordinance` IS TRUE
    `the deed names the individual bishop` IS FALSE

`land in Singapore conveyed to the Bishop after the Ordinance` MEANS Holding WITH
    `is immovable` IS TRUE
    `is situated in` IS `Singapore`
    `was conveyed, assigned or vested in The Bishop of Singapore before the Ordinance` IS FALSE
    `the deed names the individual bishop` IS FALSE

`church plate given to the Bishop before 1911` MEANS Holding WITH
    `is immovable` IS FALSE
    `is situated in` IS `Singapore`
    `was conveyed, assigned or vested in The Bishop of Singapore before the Ordinance` IS TRUE
    `the deed names the individual bishop` IS FALSE

`a lease sealed before and signed by the Bishop` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Bishop for the time being`
    `signed by` IS `the Bishop for the time being`

`a transfer sealed before and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney under a deposited power of attorney`
    `signed by` IS `an attorney under a deposited power of attorney`

`a mortgage sealed before the Bishop and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Bishop for the time being`
    `signed by` IS `an attorney under a deposited power of attorney`

`a conveyance sealed before and signed by an undeposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney whose power of attorney is not deposited`
    `signed by` IS `an attorney whose power of attorney is not deposited`

`a deed sealed before a church officer and signed by the Bishop` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a church officer with no power of attorney`
    `signed by` IS `the Bishop for the time being`

`a document signed by the Bishop but never sealed` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS FALSE
    `sealed in the presence of` IS `the Bishop for the time being`
    `signed by` IS `the Bishop for the time being`

`a deed sealed before the Bishop but signed by nobody` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Bishop for the time being`
    `signed by` IS `nobody`

§ `ss 2(1) and 5`

#ASSERT `holds the office that is the Corporation` `a successor recognised and gazetted`
#ASSERT `holds the office that is the Corporation` `a successor recognised but not yet gazetted`
#ASSERT NOT `holds the office that is the Corporation` `a Church of England bishop not recognised for the Settlements`
#ASSERT NOT `holds the office that is the Corporation` `a recognised bishop of another church`
#ASSERT NOT `holds the office that is the Corporation` `a gazetted person who is not a Church of England bishop`

#ASSERT `authorisation is conclusively proved` `a successor recognised and gazetted`
#ASSERT NOT `authorisation is conclusively proved` `a successor recognised but not yet gazetted`
#ASSERT NOT `authorisation is conclusively proved` `a Church of England bishop not recognised for the Settlements`
#ASSERT NOT `authorisation is conclusively proved` `a recognised bishop of another church`
#ASSERT `authorisation is conclusively proved` `a gazetted person who is not a Church of England bishop`

§ `s 2(2), (3)`

#ASSERT `the Ordinance empowers the Corporation to` `use and change its corporate seal` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `acquire or purchase property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `hold and enjoy property` TRUE
#ASSERT `the Ordinance empowers the Corporation to` `sell property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `mortgage property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `mortgage property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `lease property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `transfer or otherwise dispose of property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `sue in respect of its property` TRUE
#ASSERT `the Ordinance empowers the Corporation to` `be sued in respect of its property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `be sued in respect of its property` FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sue on a matter not about its property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `borrow money without security` TRUE

§ `s 3`

#ASSERT `section 3 vests it in the Corporation` `church land in Singapore conveyed in 1900 to The Bishop of Singapore`
#ASSERT `section 3 vests it in the Corporation` `land in Penang conveyed before 1911 to the Bishop by his own name`
#ASSERT `section 3 vests it in the Corporation` `land in Malacca vested in The Bishop of Singapore before 1911`
#ASSERT NOT `section 3 vests it in the Corporation` `land outside the Settlements conveyed before 1911`
#ASSERT NOT `section 3 vests it in the Corporation` `land in Singapore conveyed to the Bishop after the Ordinance`
#ASSERT NOT `section 3 vests it in the Corporation` `church plate given to the Bishop before 1911`

§ `s 4`

#ASSERT `is executed as section 4 requires` `a lease sealed before and signed by the Bishop`
#ASSERT `is executed as section 4 requires` `a transfer sealed before and signed by a deposited attorney`
#ASSERT `is executed as section 4 requires` `a mortgage sealed before the Bishop and signed by a deposited attorney`
#ASSERT NOT `is executed as section 4 requires` `a conveyance sealed before and signed by an undeposited attorney`
#ASSERT NOT `is executed as section 4 requires` `a deed sealed before a church officer and signed by the Bishop`
#ASSERT NOT `is executed as section 4 requires` `a document signed by the Bishop but never sealed`
#ASSERT NOT `is executed as section 4 requires` `a deed sealed before the Bishop but signed by nobody`

#ASSERT `the signature is sufficient evidence the seal was duly affixed` `a lease sealed before and signed by the Bishop`
#ASSERT `the signature is sufficient evidence the seal was duly affixed` `a transfer sealed before and signed by a deposited attorney`
#ASSERT `the signature is sufficient evidence the seal was duly affixed` `a mortgage sealed before the Bishop and signed by a deposited attorney`
#ASSERT NOT `the signature is sufficient evidence the seal was duly affixed` `a conveyance sealed before and signed by an undeposited attorney`
#ASSERT `the signature is sufficient evidence the seal was duly affixed` `a deed sealed before a church officer and signed by the Bishop`
#ASSERT NOT `the signature is sufficient evidence the seal was duly affixed` `a document signed by the Bishop but never sealed`
#ASSERT NOT `the signature is sufficient evidence the seal was duly affixed` `a deed sealed before the Bishop but signed by nobody`

§ `s 6`

-- the Government
#ASSERT NOT `the Ordinance may affect their rights` FALSE FALSE
-- a neighbouring landowner
#ASSERT NOT `the Ordinance may affect their rights` FALSE FALSE
-- the Corporation
#ASSERT `the Ordinance may affect their rights` TRUE FALSE
-- a purchaser from the Corporation
#ASSERT `the Ordinance may affect their rights` FALSE TRUE

