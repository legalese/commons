IMPORT prelude
IMPORT `rca-corporation`

-- Roman Catholic Archbishop Act 1975, ss 2-7 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_roman-catholic-archbishop-act-1975.py). Expected results were written by
-- hand from the text.

`a church site in Singapore held before 1975 as Bishop of Malacca` MEANS Holding WITH
    `is situate in Singapore` IS TRUE
    `was vested in the former Corporation immediately before 12 December 1975` IS TRUE
    `is movable` IS FALSE
    `the title names the individual bishop` IS FALSE
    `the title adds resident in the Straits Settlements` IS FALSE

`a Singapore house held in the name of the bishop resident in the Straits Settlements` MEANS Holding WITH
    `is situate in Singapore` IS TRUE
    `was vested in the former Corporation immediately before 12 December 1975` IS TRUE
    `is movable` IS FALSE
    `the title names the individual bishop` IS TRUE
    `the title adds resident in the Straits Settlements` IS TRUE

`a bank deposit in Singapore of the former Corporation` MEANS Holding WITH
    `is situate in Singapore` IS TRUE
    `was vested in the former Corporation immediately before 12 December 1975` IS TRUE
    `is movable` IS TRUE
    `the title names the individual bishop` IS FALSE
    `the title adds resident in the Straits Settlements` IS FALSE

`a property in Malacca of the former Corporation` MEANS Holding WITH
    `is situate in Singapore` IS FALSE
    `was vested in the former Corporation immediately before 12 December 1975` IS TRUE
    `is movable` IS FALSE
    `the title names the individual bishop` IS FALSE
    `the title adds resident in the Straits Settlements` IS FALSE

`a Singapore property bought by the Corporation in 1980` MEANS Holding WITH
    `is situate in Singapore` IS TRUE
    `was vested in the former Corporation immediately before 12 December 1975` IS FALSE
    `is movable` IS FALSE
    `the title names the individual bishop` IS FALSE
    `the title adds resident in the Straits Settlements` IS FALSE

`a lease sealed before and signed by the Archbishop` MEANS Instrument WITH
    `the Archbishopric is vacant` IS FALSE
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Archbishop`
    `signed by` IS `the Archbishop`

`a transfer during a vacancy sealed before and signed by the Vicar Capitular` MEANS Instrument WITH
    `the Archbishopric is vacant` IS TRUE
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Vicar Capitular`
    `signed by` IS `the Vicar Capitular`

`a deed during a vacancy witnessed by the Administrator Apostolic and signed by a deposited attorney` MEANS Instrument WITH
    `the Archbishopric is vacant` IS TRUE
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Administrator Apostolic`
    `signed by` IS `an attorney under a deposited power whose donor still administers`

`a mortgage signed by the Administrator Apostolic while an Archbishop is in office` MEANS Instrument WITH
    `the Archbishopric is vacant` IS FALSE
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Administrator Apostolic`
    `signed by` IS `the Administrator Apostolic`

`a conveyance sealed before the attorney of an Archbishop who has resigned` MEANS Instrument WITH
    `the Archbishopric is vacant` IS TRUE
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney under a deposited power whose donor has ceased to administer`
    `signed by` IS `an attorney under a deposited power whose donor has ceased to administer`

`a deed sealed before and signed by an attorney whose power was never deposited` MEANS Instrument WITH
    `the Archbishopric is vacant` IS FALSE
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney whose power of attorney is not deposited`
    `signed by` IS `an attorney whose power of attorney is not deposited`

`a deed sealed before a parish priest and signed by the Archbishop` MEANS Instrument WITH
    `the Archbishopric is vacant` IS FALSE
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a parish priest with no power of attorney`
    `signed by` IS `the Archbishop`

`a document signed by the Archbishop but never sealed` MEANS Instrument WITH
    `the Archbishopric is vacant` IS FALSE
    `is sealed with the Corporation seal` IS FALSE
    `sealed in the presence of` IS `the Archbishop`
    `signed by` IS `the Archbishop`

`a deed sealed before the Archbishop and signed by nobody` MEANS Instrument WITH
    `the Archbishopric is vacant` IS FALSE
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Archbishop`
    `signed by` IS `nobody`

§ `ss 2(1), 2(3) and 5`

#ASSERT `is the Corporation for the time being` `Archbishop` FALSE
#ASSERT NOT `is the Corporation for the time being` `Archbishop` TRUE
#ASSERT `is the Corporation for the time being` `Administrator Apostolic` TRUE
#ASSERT NOT `is the Corporation for the time being` `Administrator Apostolic` FALSE
#ASSERT `is the Corporation for the time being` `Vicar Capitular` TRUE
#ASSERT NOT `is the Corporation for the time being` `parish priest` FALSE

#ASSERT `authorisation is conclusively proved` `Archbishop` TRUE
#ASSERT `authorisation is conclusively proved` `Vicar Capitular` TRUE
#ASSERT NOT `authorisation is conclusively proved` `Administrator Apostolic` FALSE
#ASSERT NOT `authorisation is conclusively proved` `parish priest` TRUE

§ `s 2(4)`

#ASSERT NOT `there are concurrent holders` TRUE FALSE FALSE
#ASSERT NOT `there are concurrent holders` FALSE TRUE FALSE
#ASSERT `there are concurrent holders` TRUE TRUE FALSE
#ASSERT `there are concurrent holders` FALSE TRUE TRUE
#ASSERT NOT `there are concurrent holders` FALSE FALSE FALSE

#ASSERT `the power of attorney is still valid` TRUE
#ASSERT NOT `the power of attorney is still valid` FALSE

§ `ss 2(1) and 2(2)`

#ASSERT `the Act makes the Corporation capable to` `sue`
#ASSERT `the Act makes the Corporation capable to` `be sued`
#ASSERT `the Act makes the Corporation capable to` `sell or otherwise dispose of property`
#ASSERT `the Act makes the Corporation capable to` `use a rubber stamp as its seal`
#ASSERT `the Act makes the Corporation capable to` `do an act a body corporate may lawfully perform`
#ASSERT NOT `the Act makes the Corporation capable to` `do an act no body corporate may lawfully perform`

§ `s 3`

#ASSERT `section 3 vests it in the Corporation` `a church site in Singapore held before 1975 as Bishop of Malacca`
#ASSERT `section 3 vests it in the Corporation` `a Singapore house held in the name of the bishop resident in the Straits Settlements`
#ASSERT `section 3 vests it in the Corporation` `a bank deposit in Singapore of the former Corporation`
#ASSERT NOT `section 3 vests it in the Corporation` `a property in Malacca of the former Corporation`
#ASSERT NOT `section 3 vests it in the Corporation` `a Singapore property bought by the Corporation in 1980`

§ `s 4`

#ASSERT `is executed as section 4 requires` `a lease sealed before and signed by the Archbishop`
#ASSERT `is executed as section 4 requires` `a transfer during a vacancy sealed before and signed by the Vicar Capitular`
#ASSERT `is executed as section 4 requires` `a deed during a vacancy witnessed by the Administrator Apostolic and signed by a deposited attorney`
#ASSERT NOT `is executed as section 4 requires` `a mortgage signed by the Administrator Apostolic while an Archbishop is in office`
#ASSERT NOT `is executed as section 4 requires` `a conveyance sealed before the attorney of an Archbishop who has resigned`
#ASSERT NOT `is executed as section 4 requires` `a deed sealed before and signed by an attorney whose power was never deposited`
#ASSERT NOT `is executed as section 4 requires` `a deed sealed before a parish priest and signed by the Archbishop`
#ASSERT NOT `is executed as section 4 requires` `a document signed by the Archbishop but never sealed`
#ASSERT NOT `is executed as section 4 requires` `a deed sealed before the Archbishop and signed by nobody`

#ASSERT `the signature is sufficient evidence the seal was duly affixed` `a lease sealed before and signed by the Archbishop`
#ASSERT `the signature is sufficient evidence the seal was duly affixed` `a deed sealed before a parish priest and signed by the Archbishop`
#ASSERT NOT `the signature is sufficient evidence the seal was duly affixed` `a document signed by the Archbishop but never sealed`

§ `s 6`

#ASSERT `the Act may affect their rights` TRUE FALSE
#ASSERT `the Act may affect their rights` FALSE TRUE
#ASSERT NOT `the Act may affect their rights` FALSE FALSE

§ `s 7`

#ASSERT `the agreement has effect as if the Corporation were a party` TRUE FALSE FALSE FALSE
#ASSERT `the agreement has effect as if the Corporation were a party` TRUE TRUE TRUE FALSE
#ASSERT NOT `the agreement has effect as if the Corporation were a party` FALSE TRUE TRUE FALSE

#ASSERT `the appointment is deemed made by the Corporation` TRUE TRUE
#ASSERT NOT `the appointment is deemed made by the Corporation` TRUE FALSE

#ASSERT `service counts as continuous for pension and gratuity` TRUE TRUE
#ASSERT NOT `service counts as continuous for pension and gratuity` TRUE FALSE
#ASSERT NOT `service counts as continuous for pension and gratuity` FALSE TRUE

#ASSERT `may be carried on and completed under the Corporation` TRUE
#ASSERT NOT `may be carried on and completed under the Corporation` FALSE

#ASSERT `passes by succession to the Corporation` TRUE

