IMPORT prelude
IMPORT `paa-association`

-- People's Association Act 1960, ss 4, 5, 6, 9(i), 10, 11, 13(1), 14, 15 and the Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_peoples-association-act-1960.py). Expected results were written by
-- hand from the text.

§ `s 15 -- symbols`

#ASSERT `the symbol is one of the Association's symbols` TRUE TRUE
#ASSERT NOT `the symbol is one of the Association's symbols` TRUE FALSE

#ASSERT `using the symbol is an offence` TRUE TRUE FALSE
#ASSERT `using the symbol is an offence` TRUE FALSE TRUE
#ASSERT NOT `using the symbol is an offence` TRUE FALSE FALSE
#ASSERT NOT `using the symbol is an offence` FALSE TRUE TRUE

#ASSERT `the maximum fine for misusing a symbol` EQUALS 10000

#ASSERT NOT `imprisonment is available for misusing a symbol`

§ `s 10 -- protection from personal liability`

#ASSERT `the suit is barred` `an employee of the Association` TRUE TRUE
#ASSERT NOT `the suit is barred` `an employee of the Association` FALSE TRUE
#ASSERT NOT `the suit is barred` `an employee of the Association` TRUE FALSE
#ASSERT `the suit is barred` `a volunteer acting under the Association's direction` TRUE TRUE
#ASSERT NOT `the suit is barred` `the Association itself` TRUE TRUE
#ASSERT NOT `the suit is barred` `a volunteer acting on his or her own initiative` TRUE TRUE

§ `s 9(i) -- certificates of proficiency`

#ASSERT `a certificate of proficiency may be awarded` TRUE TRUE
#ASSERT NOT `a certificate of proficiency may be awarded` TRUE FALSE

§ `ss 4, 5 and the Schedule -- membership`

#ASSERT `the number of member organisations in the Schedule` EQUALS 84

#ASSERT `the number of members of the Association` 84 EQUALS 94

#ASSERT `the number of members of the Board` EQUALS 14

#ASSERT `the year the appointment ends` 2020 FALSE 2020 EQUALS 2023
#ASSERT `the year the appointment ends` 2022 TRUE 2020 EQUALS 2023

#ASSERT `the elected Board member still holds office` 1 FALSE FALSE FALSE
#ASSERT NOT `the elected Board member still holds office` 3 FALSE FALSE FALSE
#ASSERT NOT `the elected Board member still holds office` 1 TRUE FALSE FALSE
#ASSERT NOT `the elected Board member still holds office` 1 FALSE TRUE FALSE
#ASSERT `the elected Board member still holds office` 1 FALSE TRUE TRUE

§ `s 6 -- meetings`

#ASSERT NOT `the Board is overdue to meet` 3
#ASSERT `the Board is overdue to meet` 4

#ASSERT `the general meeting notice complies` 7 TRUE TRUE TRUE
#ASSERT NOT `the general meeting notice complies` 6 TRUE TRUE TRUE
#ASSERT NOT `the general meeting notice complies` 7 TRUE TRUE FALSE

#ASSERT `the member is deemed to have received the notice` `ordinary post` TRUE
#ASSERT NOT `the member is deemed to have received the notice` `email` TRUE
#ASSERT NOT `the member is deemed to have received the notice` `ordinary post` FALSE

#ASSERT `who presides` TRUE TRUE EQUALS `the Chairperson`
#ASSERT `who presides` FALSE TRUE EQUALS `the Deputy Chairperson`
#ASSERT `who presides` FALSE FALSE EQUALS `a member selected by those present`

#ASSERT `the Association meeting is quorate` 32 94
#ASSERT NOT `the Association meeting is quorate` 31 94

#ASSERT `the Board meeting is quorate` 5
#ASSERT NOT `the Board meeting is quorate` 4

#ASSERT `the question is carried` 5 4 FALSE
#ASSERT `the question is carried` 4 4 TRUE
#ASSERT NOT `the question is carried` 4 4 FALSE
#ASSERT NOT `the question is carried` 3 5 TRUE

§ `s 11 -- execution of documents`

#ASSERT `the sealing complies` TRUE TRUE TRUE
#ASSERT NOT `the sealing complies` TRUE TRUE FALSE

§ `s 13(1) -- deposits`

#ASSERT `the Association may deposit there` `a finance company licensed under the Finance Companies Act 1967`
#ASSERT NOT `the Association may deposit there` `an unlicensed overseas bank`

§ `s 14 -- financial year`

#ASSERT `the year the financial year began` 3 2026 EQUALS 2025
#ASSERT `the year the financial year began` 4 2026 EQUALS 2026

