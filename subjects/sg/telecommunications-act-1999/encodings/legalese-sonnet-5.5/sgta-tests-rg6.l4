§ `Rg 6 reg 10(2) and (4): the Gazette's Revised Edition 2004 against S 478/2005 (NOTES.md finding 19)`

#ASSERT `Rg 6 reg 10(2) (Revised Edition 2004): the fee for a Dealer's Class Licence for each period of 5 years, in dollars` EQUALS 50
#ASSERT `Rg 6 reg 10(4)(a) (Revised Edition 2004): the first-period class licence fee is paid within time` 90
#ASSERT NOT (`Rg 6 reg 10(4)(a) (Revised Edition 2004): the first-period class licence fee is paid within time` 91)
#ASSERT `Rg 6 reg 10(4)(b) (Revised Edition 2004): the fee for a subsequent period of 5 years is paid within time` TRUE
#ASSERT NOT (`Rg 6 reg 10(4)(b) (Revised Edition 2004): the fee for a subsequent period of 5 years is paid within time` FALSE)
#ASSERT `Rg 6 reg 10(2) and (4): the class licence fee falls due for each period of 5 years, on the date` (Date 31 12 2004) EQUALS NOTHING
#ASSERT `Rg 6 reg 10(2) and (4): the class licence fee falls due for each period of 5 years, on the date` (Date 1 1 2005) EQUALS JUST TRUE
#ASSERT `Rg 6 reg 10(2) and (4): the class licence fee falls due for each period of 5 years, on the date` (Date 20 7 2005) EQUALS JUST TRUE
#ASSERT `Rg 6 reg 10(2) and (4): the class licence fee falls due for each period of 5 years, on the date` (Date 21 7 2005) EQUALS JUST FALSE
#ASSERT `Rg 6 reg 10(2) and (4): the class licence fee falls due for each period of 5 years, on the date` (Date 4 11 2026) EQUALS JUST FALSE
