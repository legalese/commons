-- LAYER-1 TESTS for the Dealers Regulations (Rg 6): the 2004 Revised Edition's regs 3 to 25 and Schedules, and the seven amending instruments.
-- Expected values are written by hand from the text (each rule's @ref gives the raw line).  Both sides of every commencement date.

§ `Rg 6, 2004 Revised Edition: regs 3 to 10`

#ASSERT `Rg 6 reg 3(1): the dealer is deemed to have been granted a Dealer's Class Licence under section 5 of the Act` TRUE TRUE
#ASSERT NOT (`Rg 6 reg 3(1): the dealer is deemed to have been granted a Dealer's Class Licence under section 5 of the Act` FALSE TRUE)
#ASSERT NOT (`Rg 6 reg 3(1): the dealer is deemed to have been granted a Dealer's Class Licence under section 5 of the Act` TRUE FALSE)
#ASSERT `Rg 6 reg 3(2) to (4): the holder of a Dealer's Class Licence is meeting the conditions` TRUE TRUE
#ASSERT NOT (`Rg 6 reg 3(2) to (4): the holder of a Dealer's Class Licence is meeting the conditions` TRUE FALSE)
#ASSERT `Rg 6 reg 3(5), (7), (8) and (9): the holder has done what the regulation requires` TRUE TRUE TRUE 14
#ASSERT NOT (`Rg 6 reg 3(5), (7), (8) and (9): the holder has done what the regulation requires` TRUE TRUE TRUE 15)
#ASSERT NOT (`Rg 6 reg 3(5), (7), (8) and (9): the holder has done what the regulation requires` FALSE TRUE TRUE 14)
#ASSERT `Rg 6 reg 3(10): the person has breached the regulation` TRUE
#ASSERT `Rg 6 reg 3(11): the holder has done what the regulation requires on ceasing to deal` FALSE FALSE
#ASSERT `Rg 6 reg 3(11): the holder has done what the regulation requires on ceasing to deal` TRUE TRUE
#ASSERT NOT (`Rg 6 reg 3(11): the holder has done what the regulation requires on ceasing to deal` TRUE FALSE)
#ASSERT `Rg 6 reg 4(1): the dealer must obtain a Dealer's Individual Licence` TRUE
#ASSERT `Rg 6 reg 4(2) and (3): the application is as the regulation requires` TRUE FALSE
#ASSERT NOT (`Rg 6 reg 4(2) and (3): the application is as the regulation requires` TRUE TRUE)
#ASSERT `Rg 6 reg 4(4) and (5): the Authority shall grant the Dealer's Individual Licence under section 5 of the Act` TRUE TRUE TRUE
#ASSERT NOT (`Rg 6 reg 4(4) and (5): the Authority shall grant the Dealer's Individual Licence under section 5 of the Act` TRUE FALSE TRUE)
#ASSERT `Rg 6 reg 4(7): the holder of a Dealer's Individual Licence may sell the equipment` TRUE FALSE FALSE
#ASSERT `Rg 6 reg 4(7): the holder of a Dealer's Individual Licence may sell the equipment` FALSE TRUE FALSE
#ASSERT `Rg 6 reg 4(7): the holder of a Dealer's Individual Licence may sell the equipment` FALSE FALSE TRUE
#ASSERT NOT (`Rg 6 reg 4(7): the holder of a Dealer's Individual Licence may sell the equipment` FALSE FALSE FALSE)
#ASSERT `Rg 6 reg 4(8) and (9): the dealer has done what the regulation requires` TRUE 14
#ASSERT NOT (`Rg 6 reg 4(8) and (9): the dealer has done what the regulation requires` TRUE 15)
#ASSERT `Rg 6 reg 4(6): the holder may deal in the equipment under the licence` TRUE TRUE
#ASSERT NOT (`Rg 6 reg 4(6): the holder may deal in the equipment under the licence` TRUE FALSE)
#ASSERT `Rg 6 reg 4(10) and (11): the Dealer's Individual Licence is valid and its holder is meeting its conditions` TRUE FALSE
#ASSERT NOT (`Rg 6 reg 4(10) and (11): the Dealer's Individual Licence is valid and its holder is meeting its conditions` TRUE TRUE)
#ASSERT `Rg 6 reg 5: the holder is deemed to have been granted a Dealer's Class Licence in respect of the premises` TRUE FALSE
#ASSERT NOT (`Rg 6 reg 5: the holder is deemed to have been granted a Dealer's Class Licence in respect of the premises` TRUE TRUE)
#ASSERT `Rg 6 reg 6: the person may operate the telecommunication equipment for demonstration purposes` TRUE
#ASSERT NOT (`Rg 6 reg 6: the person may operate the telecommunication equipment for demonstration purposes` FALSE)
#ASSERT `Rg 6 reg 7: the person may be granted a Dealer's Individual Licence or be deemed granted a Dealer's Class Licence` TRUE FALSE FALSE FALSE
#ASSERT `Rg 6 reg 7: the person may be granted a Dealer's Individual Licence or be deemed granted a Dealer's Class Licence` FALSE FALSE FALSE TRUE
#ASSERT NOT (`Rg 6 reg 7: the person may be granted a Dealer's Individual Licence or be deemed granted a Dealer's Class Licence` FALSE FALSE FALSE FALSE)
#ASSERT `Rg 6 reg 8: the fee in dollars for a replacement Dealer's Individual Licence` TRUE EQUALS JUST 5
#ASSERT `Rg 6 reg 8: the fee in dollars for a replacement Dealer's Individual Licence` FALSE EQUALS NOTHING
#ASSERT `Rg 6 reg 9: the renewal fee in dollars for a Dealer's Individual Licence` EQUALS 250
#ASSERT `Rg 6 reg 10(1): the fee for a Dealer's Individual Licence for the year, in dollars` 1 EQUALS 250
#ASSERT `Rg 6 reg 10(1): the fee for a Dealer's Individual Licence for the year, in dollars` 2 EQUALS 250
#ASSERT `Rg 6 reg 10(2): the fee for a Dealer's Class Licence held by a person carrying on a business or trade as a dealer, in dollars` EQUALS 50
#ASSERT `Rg 6 reg 10(3)(a): the first-year fee is paid within time` 90
#ASSERT NOT (`Rg 6 reg 10(3)(a): the first-year fee is paid within time` 91)
#ASSERT `Rg 6 reg 10(4): the class licence fee is paid within time` 90
#ASSERT NOT (`Rg 6 reg 10(4): the class licence fee is paid within time` 91)
#ASSERT `Rg 6 reg 10(5): the late payment fee in dollars` 7 EQUALS 0
#ASSERT `Rg 6 reg 10(5): the late payment fee in dollars` 8 EQUALS 10
#ASSERT `Rg 6 reg 10(5): the late payment fee in dollars` 15 EQUALS 20
#ASSERT `Rg 6 reg 10(5): the late payment fee in dollars` 31 EQUALS 50
