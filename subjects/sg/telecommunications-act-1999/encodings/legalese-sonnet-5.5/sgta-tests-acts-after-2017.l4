#ASSERT NOT (elem `G.N. No. S 26/2022` (`Instruments after Act 15 of 2017 whose amendments of the Telecommunications Act are in operation for the conduct day, as read on the reading day` (Date 12 1 2022) (Date 4 11 2026)))

