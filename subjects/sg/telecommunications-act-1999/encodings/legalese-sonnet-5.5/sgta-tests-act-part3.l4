#ASSERT NOT (`s 21(2): the public telecommunication licensee must alter, remove, relocate or divert the installation or plant` TRUE TRUE FALSE)
#ASSERT NOT (`s 21(2): the public telecommunication licensee must alter, remove, relocate or divert the installation or plant` TRUE FALSE TRUE)
#ASSERT `s 21(3): the terms and conditions the licensee may impose under subsection (2) may include this term` TRUE
#ASSERT `s 22(1): the licensee may cause the tree to be felled or dealt with in such other manner as will, in its opinion, avert the danger` TRUE
#ASSERT `s 22(2): the licensee is subject to the Parks and Trees Act 2005` TRUE
#ASSERT `s 22(3): the licensee may, subject to subsections (4) and (5), pay the person adversely affected such sum as may be agreed by way of compensation` TRUE
#ASSERT `s 22(4): further compensation is payable for the felling or lopping of the tree or the clearing of the vegetation` TRUE FALSE
#ASSERT `s 22(4): further compensation is payable for the felling or lopping of the tree or the clearing of the vegetation` FALSE TRUE
#ASSERT NOT (`s 22(4): further compensation is payable for the felling or lopping of the tree or the clearing of the vegetation` TRUE TRUE)
#ASSERT `s 22(5): compensation is payable by the licensee under subsection (3) in respect of the tree` FALSE FALSE
#ASSERT `s 22(5): compensation is payable by the licensee under subsection (3) in respect of the tree` TRUE TRUE
#ASSERT NOT (`s 22(5): compensation is payable by the licensee under subsection (3) in respect of the tree` TRUE FALSE)
#ASSERT `s 22(6): the owner or occupier has done what the subsection requires before felling, lopping or clearing a tree or vegetation adjacent to the licensee's installation or plant` 14 TRUE
#ASSERT NOT (`s 22(6): the owner or occupier has done what the subsection requires before felling, lopping or clearing a tree or vegetation adjacent to the licensee's installation or plant` 13 TRUE)
#ASSERT NOT (`s 22(6): the owner or occupier has done what the subsection requires before felling, lopping or clearing a tree or vegetation adjacent to the licensee's installation or plant` 14 FALSE)
#ASSERT `s 22(7): the owner or occupier is liable to pay the licensee any cost and expense incurred for damage caused to the installation or plant` TRUE
#ASSERT NOT (`s 22(7): the owner or occupier is liable to pay the licensee any cost and expense incurred for damage caused to the installation or plant` FALSE)
