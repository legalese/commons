#ASSERT `s 22(9): the amount may be recovered in the same manner as a simple contract debt` 8
#ASSERT NOT (`s 22(9): the amount may be recovered in the same manner as a simple contract debt` 7)
#ASSERT `s 22(10): the tree was felled or the vegetation cleared by the owner or occupier of the land or by the owner's or occupier's employees or agents acting as such` TRUE FALSE
#ASSERT NOT (`s 22(10): the tree was felled or the vegetation cleared by the owner or occupier of the land or by the owner's or occupier's employees or agents acting as such` TRUE TRUE)
#ASSERT NOT (`s 22(10): the tree was felled or the vegetation cleared by the owner or occupier of the land or by the owner's or occupier's employees or agents acting as such` FALSE FALSE)

§ `s 23 Provision of space or facility under code of practice`

#ASSERT `s 23(1): the Authority may issue, and amend, suspend or revoke, the code of practice` TRUE
#ASSERT `s 23(2)(a): the code of practice may require the person to provide, maintain or give access to the space or facility at the person's own expense` TRUE TRUE
#ASSERT NOT (`s 23(2)(a): the code of practice may require the person to provide, maintain or give access to the space or facility at the person's own expense` FALSE TRUE)
#ASSERT `s 23(2)(b): the code of practice may provide for the fee or charge` TRUE
#ASSERT `s 23(3): the code provision has effect only subject to the Act, or has no effect, to the extent of the inconsistency` TRUE
#ASSERT NOT (`s 23(4): the code of practice has legislative effect` TRUE)
#ASSERT `s 23(5): the developer, owner or telecommunication licensee must comply, at that person's expense, with the code of practice` TRUE FALSE
#ASSERT NOT (`s 23(5): the developer, owner or telecommunication licensee must comply, at that person's expense, with the code of practice` TRUE TRUE)
#ASSERT `s 23(7): the Authority may give the person a written notice requiring compliance with the code of practice` TRUE
#ASSERT NOT (`s 23(9): the prejudice to contractual obligations bars the Authority from giving the written notice` TRUE)
#ASSERT `s 23(8): the Authority may at any time vary, suspend or revoke the written notice` TRUE
#ASSERT `s 23(10): the party is liable for the breach of the contract` FALSE
#ASSERT NOT (`s 23(10): the party is liable for the breach of the contract` TRUE)
#ASSERT NOT (`s 23(11): subsection (10) affects the operation of the Frustrated Contracts Act 1959` TRUE)
#ASSERT `s 23(12): the Authority may issue the written order the Authority considers necessary to secure compliance` TRUE TRUE
#ASSERT NOT (`s 23(12): the Authority may issue the written order the Authority considers necessary to secure compliance` TRUE FALSE)
#ASSERT `s 23(13)(a): the order may require the person to do, or refrain from doing, the thing` TRUE
#ASSERT `s 23(13)(b): the order takes effect at this time` TRUE
#ASSERT `s 23(14): the Authority may at any time vary, suspend or revoke the order` TRUE
#ASSERT `s 23(15): the person is guilty of an offence` TRUE
#ASSERT NOT (`s 23(15): the person is guilty of an offence` FALSE)
#ASSERT `s 23(16): the relevant specification is deemed to be a code of practice issued under subsection (1) and remains in force` TRUE FALSE
#ASSERT NOT (`s 23(16): the relevant specification is deemed to be a code of practice issued under subsection (1) and remains in force` TRUE TRUE)

