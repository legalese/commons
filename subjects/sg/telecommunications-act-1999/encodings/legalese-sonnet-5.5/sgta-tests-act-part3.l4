IMPORT prelude
IMPORT `sgta-nouns`
IMPORT `sgta-part3-ss15-22`
IMPORT `sgta-part3-ss23-29`

-- LAYER-1 TESTS for Part 3 of the Act (ss 15 to 29).  Expected values are written by hand from the quoted text.
-- Thresholds are tested on both sides: 3 hours' notice (s 15(1)), 14 days (ss 17(4), (6), 22(6), 25(7), (8)), 7 days (s 22(9)), 20 metres (s 22(5)).

§ `ss 15 to 19`

#ASSERT `s 15(1): the licensee or its authorised person may enter the land and survey, take levels and do other necessary acts preparatory to the service or installation` TRUE 3 TRUE TRUE
#ASSERT NOT (`s 15(1): the licensee or its authorised person may enter the land and survey, take levels and do other necessary acts preparatory to the service or installation` TRUE 2 TRUE TRUE)
#ASSERT `s 15(1): the licensee or its authorised person may enter the land and survey, take levels and do other necessary acts preparatory to the service or installation` TRUE 0 FALSE TRUE
#ASSERT NOT (`s 15(1): the licensee or its authorised person may enter the land and survey, take levels and do other necessary acts preparatory to the service or installation` FALSE 5 TRUE TRUE)
#ASSERT NOT (`s 15(1): the licensee or its authorised person may enter the land and survey, take levels and do other necessary acts preparatory to the service or installation` TRUE 5 TRUE FALSE)
#ASSERT `s 15(2): the public telecommunication licensee must pay compensation to the owner or occupier of the land` TRUE
#ASSERT NOT (`s 15(2): the public telecommunication licensee must pay compensation to the owner or occupier of the land` FALSE)
#ASSERT NOT (`s 15(3): section 15 authorises the employee or agent to do the act` TRUE)
#ASSERT `s 15(3): section 15 authorises the employee or agent to do the act` FALSE
#ASSERT `s 16(1)(a): the person may enter upon State land` TRUE TRUE TRUE
#ASSERT NOT (`s 16(1)(a): the person may enter upon State land` TRUE TRUE FALSE)
#ASSERT NOT (`s 16(1)(a): the person may enter upon State land` FALSE TRUE TRUE)
#ASSERT `s 16(1)(b) and (c): the person may erect installation or plant or excavate trenches, carry out all necessary works, fell or lop trees and remove vegetation` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 16(1)(b) and (c): the person may erect installation or plant or excavate trenches, carry out all necessary works, fell or lop trees and remove vegetation` TRUE TRUE TRUE FALSE)
#ASSERT `s 16(2) and (3): compensation for damage or disturbance is payable by the licensee to` FALSE FALSE EQUALS "no one under this subsection"
#ASSERT `s 16(2) and (3): compensation for damage or disturbance is payable by the licensee to` TRUE TRUE EQUALS "the occupant under the licence"
#ASSERT `s 16(2) and (3): compensation for damage or disturbance is payable by the licensee to` TRUE FALSE EQUALS "the person who suffered the damage or disturbance"
#ASSERT `s 17(1): the public telecommunication licensee may do the act under, upon or over land (other than State land) or in a building` TRUE TRUE TRUE
#ASSERT NOT (`s 17(1): the public telecommunication licensee may do the act under, upon or over land (other than State land) or in a building` TRUE TRUE FALSE)
#ASSERT `s 17(2): the compensation payable under subsection (1) may include an annual payment` TRUE
#ASSERT NOT (`s 17(3): the public telecommunication licensee acquires the right` TRUE)
#ASSERT `s 17(3): the public telecommunication licensee acquires the right` FALSE
#ASSERT `s 17(4) and (5): the notice is as the licensee must give before entering` 14 TRUE TRUE
#ASSERT NOT (`s 17(4) and (5): the notice is as the licensee must give before entering` 13 TRUE TRUE)
#ASSERT NOT (`s 17(4) and (5): the notice is as the licensee must give before entering` 14 FALSE TRUE)
#ASSERT `s 17(6): the owner or occupier may lodge a written objection with the Authority` 14
#ASSERT NOT (`s 17(6): the owner or occupier may lodge a written objection with the Authority` 15)
#ASSERT `s 17(7) and (8): the Authority must notify the licensee to resolve the dispute and the licensee must take genuine steps to resolve it` TRUE
#ASSERT `s 17(9): the licensee must inform the Authority in writing and furnish all relevant information relating to the steps taken` TRUE
#ASSERT `s 17(10): the Authority must notify the licensee and the objector whether it is satisfied that the licensee took genuine steps to resolve the dispute` TRUE
#ASSERT `s 17(11): the Authority must hold an inquiry on the objection, giving each party a reasonable opportunity to be heard` TRUE TRUE
#ASSERT NOT (`s 17(11): the Authority must hold an inquiry on the objection, giving each party a reasonable opportunity to be heard` TRUE FALSE)
#ASSERT `s 17(12): the Authority may authorise, unconditionally or on such terms, conditions and stipulations as it thinks fit, any of the acts mentioned in the notice` TRUE
#ASSERT `s 17(13): the public telecommunication licensee may enter the land or building and do the acts mentioned in the notice` TRUE FALSE FALSE FALSE
#ASSERT `s 17(13): the public telecommunication licensee may enter the land or building and do the acts mentioned in the notice` FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 17(13): the public telecommunication licensee may enter the land or building and do the acts mentioned in the notice` FALSE FALSE FALSE FALSE)
#ASSERT `s 18(1): the rights conferred and obligations imposed on the transferor licensee in respect of the land, building or other property are deemed, on the transfer date, to have been transferred to the transferee licensee` TRUE TRUE
#ASSERT NOT (`s 18(1): the rights conferred and obligations imposed on the transferor licensee in respect of the land, building or other property are deemed, on the transfer date, to have been transferred to the transferee licensee` TRUE FALSE)
#ASSERT `s 18(2): subsection (1) applies to the transfer` TRUE
#ASSERT NOT (`s 18(2): subsection (1) applies to the transfer` FALSE)
#ASSERT NOT (`s 19: section 17(1) and (6) affect the matter` TRUE)
#ASSERT `s 19: section 17(1) and (6) affect the matter` FALSE

§ `ss 20 to 22`

#ASSERT `s 20(1): the Authority may enter upon any land or building, or stop or board any vessel, aircraft or vehicle, and carry out all necessary inspections or investigations` TRUE
#ASSERT NOT (`s 20(1): the Authority may enter upon any land or building, or stop or board any vessel, aircraft or vehicle, and carry out all necessary inspections or investigations` FALSE)
#ASSERT `s 20(2): the licensee or its authorised person may enter upon the land or building and carry out inspection, maintenance or repair, felling or lopping trees and removing vegetation` TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 20(2): the licensee or its authorised person may enter upon the land or building and carry out inspection, maintenance or repair, felling or lopping trees and removing vegetation` TRUE TRUE TRUE FALSE)
