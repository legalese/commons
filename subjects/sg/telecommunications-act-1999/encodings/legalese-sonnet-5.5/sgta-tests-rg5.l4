IMPORT prelude
IMPORT daydate
IMPORT `sgta-nouns`
IMPORT `sgta-i-rg5-spectrum`

-- LAYER-1 TESTS for the Radio-communication Regulations (Rg 5), Parts II and III (regs 3 to 18).
-- Expected values are written by hand from the regulation text (each rule's @ref gives the raw line).

§ `Rg 5 regs 3 to 5: the plans`

#ASSERT `Rg 5 reg 3(2): the radio spectrum plan has what the regulation requires of it` TRUE TRUE TRUE TRUE
#ASSERT NOT (`Rg 5 reg 3(2): the radio spectrum plan has what the regulation requires of it` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`Rg 5 reg 3(2): the radio spectrum plan has what the regulation requires of it` FALSE TRUE TRUE TRUE)
#ASSERT `Rg 5 reg 4(2): the radio frequency band plan has what the regulation requires of it` TRUE TRUE TRUE
#ASSERT NOT (`Rg 5 reg 4(2): the radio frequency band plan has what the regulation requires of it` TRUE FALSE TRUE)
#ASSERT `Rg 5 reg 5: the Authority may vary or revoke the plan, in whole or in part` TRUE
#ASSERT NOT (`Rg 5 reg 5: the Authority may vary or revoke the plan, in whole or in part` FALSE)

§ `Rg 5 regs 6 to 10: granting spectrum rights`

#ASSERT `Rg 5 reg 6(2): the Authority may grant the person a right to use the specified part of the spectrum` TRUE TRUE
#ASSERT NOT (`Rg 5 reg 6(2): the Authority may grant the person a right to use the specified part of the spectrum` TRUE FALSE)
#ASSERT NOT (`Rg 5 reg 6(2): the Authority may grant the person a right to use the specified part of the spectrum` FALSE TRUE)
#ASSERT `Rg 5 reg 7: this is a method of allocation the regulation names` "auction"
#ASSERT `Rg 5 reg 7: this is a method of allocation the regulation names` "tender"
#ASSERT NOT (`Rg 5 reg 7: this is a method of allocation the regulation names` "lottery")
#ASSERT `Rg 5 reg 8: the Authority may refuse to grant the person a spectrum right` FALSE
#ASSERT NOT (`Rg 5 reg 8: the Authority may refuse to grant the person a spectrum right` TRUE)
#ASSERT `Rg 5 reg 9(1): the Authority may by written notice exclude or limit the person's participation in the allocation` TRUE FALSE
#ASSERT `Rg 5 reg 9(1): the Authority may by written notice exclude or limit the person's participation in the allocation` FALSE TRUE
#ASSERT NOT (`Rg 5 reg 9(1): the Authority may by written notice exclude or limit the person's participation in the allocation` FALSE FALSE)
#ASSERT `Rg 5 reg 9(2): the exclusion or limit was made as the regulation requires` TRUE
#ASSERT NOT (`Rg 5 reg 9(2): the exclusion or limit was made as the regulation requires` FALSE)
#ASSERT `Rg 5 reg 9(3): the person may appeal to the Minister, whose decision is final` TRUE
#ASSERT `Rg 5 reg 10: this is a kind of condition the regulation names for a spectrum right` "the area within which operation is authorised"
#ASSERT NOT (`Rg 5 reg 10: this is a kind of condition the regulation names for a spectrum right` "the colour of the aerial")

§ `Rg 5 regs 11 to 14: using, sharing and trading`

#ASSERT `Rg 5 reg 11(1): the person is authorised to use the assigned spectrum for operating a station or network` TRUE FALSE
#ASSERT `Rg 5 reg 11(1): the person is authorised to use the assigned spectrum for operating a station or network` FALSE TRUE
#ASSERT NOT (`Rg 5 reg 11(1): the person is authorised to use the assigned spectrum for operating a station or network` FALSE FALSE)
#ASSERT `Rg 5 reg 11(2): the person is authorised to operate the station or network` TRUE FALSE
#ASSERT `Rg 5 reg 11(2): the person is authorised to operate the station or network` FALSE TRUE
#ASSERT NOT (`Rg 5 reg 11(2): the person is authorised to operate the station or network` FALSE FALSE)
#ASSERT `Rg 5 reg 12(1): the other person may use the assigned spectrum to operate a station or network` TRUE TRUE
#ASSERT NOT (`Rg 5 reg 12(1): the other person may use the assigned spectrum to operate a station or network` TRUE FALSE)
#ASSERT `Rg 5 reg 12(2): the authorised person is meeting what the regulation requires of the person` TRUE
#ASSERT `Rg 5 reg 13(1): the person granted the spectrum right may assign or deal with the rights and privileges` TRUE
#ASSERT `Rg 5 reg 13(2): the assignment or dealing takes effect` TRUE
#ASSERT NOT (`Rg 5 reg 13(2): the assignment or dealing takes effect` FALSE)
#ASSERT `Rg 5 reg 13(3): the parties have done what the regulation requires of them` TRUE
#ASSERT `Rg 5 reg 14: the Authority may vary, issue or cancel spectrum rights to give effect to the assignment or dealing` TRUE
#ASSERT NOT (`Rg 5 reg 14: the Authority may vary, issue or cancel spectrum rights to give effect to the assignment or dealing` FALSE)

§ `Rg 5 regs 15 to 18: variation, suspension, resumption`

-- 28 days and 14 days are the edges in regs 15(3), 15(5), 18(3) and 18(5).
#ASSERT `Rg 5 reg 15(1) and (2): the regulation applies to the variation` FALSE
#ASSERT NOT (`Rg 5 reg 15(1) and (2): the regulation applies to the variation` TRUE)
#ASSERT NOT (`Rg 5 reg 15(3): the time allowed for written representations is long enough` 27)
#ASSERT `Rg 5 reg 15(3): the time allowed for written representations is long enough` 28
#ASSERT `Rg 5 reg 15(5): the appeal to the Minister is within time` 14
#ASSERT NOT (`Rg 5 reg 15(5): the appeal to the Minister is within time` 15)
#ASSERT `Rg 5 reg 15(6): the Authority may enforce its direction` FALSE FALSE
#ASSERT NOT (`Rg 5 reg 15(6): the Authority may enforce its direction` TRUE FALSE)
#ASSERT NOT (`Rg 5 reg 15(6): the Authority may enforce its direction` FALSE TRUE)
#ASSERT `Rg 5 reg 15(7) and (8): the Authority may carry out the variation at once` TRUE FALSE
#ASSERT `Rg 5 reg 15(7) and (8): the Authority may carry out the variation at once` FALSE TRUE
#ASSERT NOT (`Rg 5 reg 15(7) and (8): the Authority may carry out the variation at once` FALSE FALSE)
#ASSERT `Rg 5 reg 16(1): the Authority may suspend or cancel the spectrum right, in whole or in part` TRUE FALSE
#ASSERT `Rg 5 reg 16(1): the Authority may suspend or cancel the spectrum right, in whole or in part` FALSE TRUE
#ASSERT NOT (`Rg 5 reg 16(1): the Authority may suspend or cancel the spectrum right, in whole or in part` FALSE FALSE)
#ASSERT `Rg 5 reg 16(2) and (3): the Authority may give notice of the date the suspension or cancellation takes effect` TRUE TRUE
#ASSERT NOT (`Rg 5 reg 16(2) and (3): the Authority may give notice of the date the suspension or cancellation takes effect` FALSE TRUE)
#ASSERT NOT (`Rg 5 reg 16(2) and (3): the Authority may give notice of the date the suspension or cancellation takes effect` TRUE FALSE)
#ASSERT `Rg 5 reg 17(1): the Authority may resume the spectrum right, or a part of it` TRUE
#ASSERT `Rg 5 reg 17(2): an agreement to resume a part of the right has the contents the regulation requires` TRUE TRUE
#ASSERT NOT (`Rg 5 reg 17(2): an agreement to resume a part of the right has the contents the regulation requires` TRUE FALSE)
#ASSERT `Rg 5 reg 17(4): the change is a resumption` TRUE
#ASSERT `Rg 5 reg 18(1) and (2): the Authority may resume the spectrum right without the agreement of the person granted it` TRUE
#ASSERT NOT (`Rg 5 reg 18(1) and (2): the Authority may resume the spectrum right without the agreement of the person granted it` FALSE)
#ASSERT `Rg 5 reg 18(3): the notice of resumption is as the regulation requires` 28 TRUE
#ASSERT NOT (`Rg 5 reg 18(3): the notice of resumption is as the regulation requires` 27 TRUE)
#ASSERT NOT (`Rg 5 reg 18(3): the notice of resumption is as the regulation requires` 28 FALSE)
#ASSERT `Rg 5 reg 18(5): the appeal to the Minister is within time` 14
#ASSERT NOT (`Rg 5 reg 18(5): the appeal to the Minister is within time` 15)
#ASSERT `Rg 5 reg 18(6): the Authority may enforce its direction` FALSE FALSE
#ASSERT NOT (`Rg 5 reg 18(6): the Authority may enforce its direction` TRUE FALSE)
#ASSERT `Rg 5 reg 18(7): the Authority may carry out the resumption at once` TRUE
#ASSERT NOT (`Rg 5 reg 18(7): the Authority may carry out the resumption at once` FALSE)
#ASSERT `Rg 5 reg 18(8): regulation 15 applies to the variation of the other conditions` FALSE
#ASSERT NOT (`Rg 5 reg 18(8): regulation 15 applies to the variation of the other conditions` TRUE)
