IMPORT prelude
IMPORT daydate
IMPORT `sgta-nouns`
IMPORT `sgta-i-rg1-ship`
IMPORT `sgta-i-rg4-cable`
IMPORT `sgta-i-iw-wiring`
IMPORT `sgta-i-resell`
IMPORT `sgta-i-trusts`

-- LAYER-1 TESTS for Rg 1 (ship station operators), Rg 4 (cable detection workers), the Internal Wiring Regulations 2005, the Resellers
-- Notification 2007 and the Prescribed Trusts Regulations 2017.  Expected values are written by hand from each instrument's text.

§ `Rg 1`

#ASSERT `Rg 1 reg 2: the person is a "radio operator"` TRUE
#ASSERT NOT (`Rg 1 reg 2: the person is a "radio operator"` FALSE)
#ASSERT `Rg 1 reg 2: this is a "ship"` FALSE TRUE
#ASSERT `Rg 1 reg 2: this is a "ship"` TRUE FALSE
#ASSERT NOT (`Rg 1 reg 2: this is a "ship"` FALSE FALSE)
#ASSERT `Rg 1 reg 2: this is a "ship station"` TRUE
#ASSERT `Rg 1 reg 2: this is a "station"` TRUE
#ASSERT `Rg 1 reg 3(2): this is a grade of certificate of competency` "General Operator's Certificate of Competency"
#ASSERT `Rg 1 reg 3(2): this is a grade of certificate of competency` "Restricted Operator's Certificate of Competency"
#ASSERT NOT (`Rg 1 reg 3(2): this is a grade of certificate of competency` "Master Mariner's Certificate")
#ASSERT `Rg 1 reg 5(2): the candidate may sit the examination` 18 TRUE TRUE
#ASSERT NOT (`Rg 1 reg 5(2): the candidate may sit the examination` 17 TRUE TRUE)
#ASSERT NOT (`Rg 1 reg 5(2): the candidate may sit the examination` 18 FALSE TRUE)
#ASSERT NOT (`Rg 1 reg 5(2): the candidate may sit the examination` 18 TRUE FALSE)
#ASSERT `Rg 1 reg 5(1): the Authority has held the examination as often as the regulation requires` 2
#ASSERT NOT (`Rg 1 reg 5(1): the Authority has held the examination as often as the regulation requires` 1)
#ASSERT `Rg 1 reg 6 and Second Schedule: the fee in dollars` "examination for a General Operator's Certificate of Competency" EQUALS JUST 100
#ASSERT `Rg 1 reg 6 and Second Schedule: the fee in dollars` "examination for a Restricted Operator's Certificate of Competency" EQUALS JUST 70
#ASSERT `Rg 1 reg 6 and Second Schedule: the fee in dollars` "issue of a certificate of competency" EQUALS JUST 10
#ASSERT `Rg 1 reg 6 and Second Schedule: the fee in dollars` "issue of a duplicate certificate of competency" EQUALS JUST 5
#ASSERT `Rg 1 reg 6 and Second Schedule: the fee in dollars` "revalidation of a certificate of competency" EQUALS JUST 10
#ASSERT `Rg 1 reg 6 and Second Schedule: the fee in dollars` "issue of a certificate of endorsement" EQUALS JUST 18
#ASSERT `Rg 1 reg 6 and Second Schedule: the fee in dollars` "issue of a duplicate certificate of endorsement" EQUALS JUST 18
#ASSERT `Rg 1 reg 6 and Second Schedule: the fee in dollars` "driving licence" EQUALS NOTHING
#ASSERT `Rg 1 reg 7: the candidate qualifies for a General Operator's Certificate of Competency` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`Rg 1 reg 7: the candidate qualifies for a General Operator's Certificate of Competency` TRUE TRUE TRUE TRUE FALSE)
#ASSERT `Rg 1 reg 8: the holder of a General Operator's Certificate of Competency is authorised to operate the radio-communication services of the ship station` TRUE TRUE
#ASSERT NOT (`Rg 1 reg 8: the holder of a General Operator's Certificate of Competency is authorised to operate the radio-communication services of the ship station` TRUE FALSE)
#ASSERT `Rg 1 reg 9: the candidate qualifies for a Restricted Operator's Certificate of Competency` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`Rg 1 reg 9: the candidate qualifies for a Restricted Operator's Certificate of Competency` FALSE TRUE TRUE TRUE TRUE)
#ASSERT `Rg 1 reg 10: the holder of a Restricted Operator's Certificate of Competency is authorised to operate the radio-communication services of the ship station` TRUE TRUE
#ASSERT `Rg 1 reg 11(3): the certificate must be revalidated to continue to qualify for sea service as a radio operator` 5 TRUE
#ASSERT NOT (`Rg 1 reg 11(3): the certificate must be revalidated to continue to qualify for sea service as a radio operator` 4 TRUE)
#ASSERT NOT (`Rg 1 reg 11(3): the certificate must be revalidated to continue to qualify for sea service as a radio operator` 6 FALSE)
#ASSERT `Rg 1 reg 11(5): the Authority may revalidate the certificate of competency` TRUE
#ASSERT NOT (`Rg 1 reg 11(5): the Authority may revalidate the certificate of competency` FALSE)
#ASSERT `Rg 1 reg 12(1) and (3): the Authority may recognise the foreign certificate of competency by a certificate of endorsement` TRUE TRUE
#ASSERT NOT (`Rg 1 reg 12(1) and (3): the Authority may recognise the foreign certificate of competency by a certificate of endorsement` TRUE FALSE)
#ASSERT `Rg 1 reg 12(8): the most the fine may be on conviction, in dollars` TRUE EQUALS JUST 2000
#ASSERT `Rg 1 reg 12(8): the most the fine may be on conviction, in dollars` FALSE EQUALS NOTHING
#ASSERT `Rg 1 reg 13: the Authority may cancel or suspend the certificate of competency` TRUE TRUE FALSE
#ASSERT `Rg 1 reg 13: the Authority may cancel or suspend the certificate of competency` FALSE FALSE TRUE
#ASSERT NOT (`Rg 1 reg 13: the Authority may cancel or suspend the certificate of competency` TRUE FALSE FALSE)
#ASSERT `Rg 1 reg 14: the certificate of competency may be suspended at any time` TRUE
#ASSERT `Rg 1 reg 15: the person is guilty of an offence` TRUE FALSE FALSE
#ASSERT `Rg 1 reg 15: the person is guilty of an offence` FALSE FALSE TRUE
#ASSERT NOT (`Rg 1 reg 15: the person is guilty of an offence` FALSE FALSE FALSE)
#ASSERT `Rg 1 reg 16(1): the certificate is deemed to be issued under these Regulations` TRUE
#ASSERT `Rg 1 reg 16(2) to (4): the certificate still entitles the holder to perform all the acts for which it authorised` TRUE FALSE FALSE
#ASSERT NOT (`Rg 1 reg 16(2) to (4): the certificate still entitles the holder to perform all the acts for which it authorised` TRUE FALSE TRUE)
#ASSERT NOT (`Rg 1 reg 16(2) to (4): the certificate still entitles the holder to perform all the acts for which it authorised` TRUE TRUE FALSE)

§ `Rg 4`

#ASSERT `Rg 4 reg 2: the person is a "licensee"` TRUE
#ASSERT `Rg 4 reg 2: this is a "licence"` TRUE
#ASSERT `Rg 4 reg 3: the application for a licence, or its renewal, is as the regulation requires` TRUE TRUE 1
#ASSERT NOT (`Rg 4 reg 3: the application for a licence, or its renewal, is as the regulation requires` TRUE TRUE 0)
#ASSERT `Rg 4 reg 4(1): the Authority may grant the licence` TRUE TRUE TRUE
#ASSERT NOT (`Rg 4 reg 4(1): the Authority may grant the licence` TRUE TRUE FALSE)
#ASSERT NOT (`Rg 4 reg 4(1): the Authority may grant the licence` FALSE TRUE TRUE)
#ASSERT `Rg 4 reg 4(2): the Authority may refuse to grant a licence to the person` TRUE
#ASSERT `Rg 4 reg 5: the licence is validly issued and is valid` TRUE TRUE
#ASSERT NOT (`Rg 4 reg 5: the licence is validly issued and is valid` TRUE FALSE)
#ASSERT `Rg 4 reg 7: the person may inspect the register during the Authority's office hours, or obtain a certified true copy of an entry` TRUE
#ASSERT `Rg 4 reg 8: the licensee has done what the regulation requires` TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`Rg 4 reg 8: the licensee has done what the regulation requires` TRUE TRUE FALSE TRUE TRUE)
#ASSERT `Rg 4 reg 9: the licensee must take and successfully complete the test or examination` TRUE
#ASSERT `Rg 4 reg 10(1): the Authority may, notwithstanding that the licence has been renewed since the relevant event, cancel or refuse to renew the licence or suspend it for such period as it thinks fit` FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT (`Rg 4 reg 10(1): the Authority may, notwithstanding that the licence has been renewed since the relevant event, cancel or refuse to renew the licence or suspend it for such period as it thinks fit` FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `Rg 4 reg 10(2) and (3): the Authority may order retraining of up to 12 months and suspend the licence until completed, and no fee is refunded` TRUE
#ASSERT `Rg 4 reg 11: the Authority may reduce the period of suspension` TRUE
#ASSERT `Rg 4 reg 12: the licensee delivered the licence within time` 14
#ASSERT NOT (`Rg 4 reg 12: the licensee delivered the licence within time` 15)
#ASSERT `Rg 4 reg 13: the Authority may grant a replacement licence` TRUE
#ASSERT `Rg 4 reg 14: the most the fine may be on conviction, in dollars` TRUE FALSE EQUALS JUST 2000
#ASSERT `Rg 4 reg 14: the most the fine may be on conviction, in dollars` FALSE TRUE EQUALS JUST 2000
#ASSERT `Rg 4 reg 14: the most the fine may be on conviction, in dollars` FALSE FALSE EQUALS NOTHING
#ASSERT `Rg 4 Schedule: the fee in dollars` 1 EQUALS JUST 30
#ASSERT `Rg 4 Schedule: the fee in dollars` 2 EQUALS JUST 20
#ASSERT `Rg 4 Schedule: the fee in dollars` 3 EQUALS JUST 5
#ASSERT `Rg 4 Schedule: the fee in dollars` 4 EQUALS JUST 5
#ASSERT `Rg 4 Schedule: the fee in dollars` 5 EQUALS NOTHING
#ASSERT `Rg 4 reg 3 (from 21 July 2005): the application for a licence is as the regulation requires` (Date 20 7 2005) TRUE EQUALS NOTHING
#ASSERT `Rg 4 reg 3 (from 21 July 2005): the application for a licence is as the regulation requires` (Date 21 7 2005) TRUE EQUALS JUST TRUE
#ASSERT `Rg 4 reg 5(b) (from 21 July 2005): the licence remains valid` (Date 21 7 2005) TRUE EQUALS JUST TRUE
#ASSERT `Rg 4 reg 6 (from 21 July 2005): the register records the date of expiry and whether an application to renew was refused` (Date 21 7 2005) EQUALS JUST FALSE
#ASSERT `Rg 4 reg 6 (from 21 July 2005): the register records the date of expiry and whether an application to renew was refused` (Date 20 7 2005) EQUALS NOTHING
#ASSERT `Rg 4 reg 10(1) (from 21 July 2005): the Authority may refuse to renew a licence` (Date 21 7 2005) EQUALS JUST FALSE
#ASSERT `Rg 4 Schedule item 1 (from 21 July 2005): the fee in dollars for the grant of a licence` (Date 21 7 2005) EQUALS JUST 30
#ASSERT `Rg 4 reg 8(2) and (3) (from 1 June 2007): the licensee is meeting the condition and the prohibition` (Date 31 5 2007) TRUE FALSE EQUALS NOTHING
#ASSERT `Rg 4 reg 8(2) and (3) (from 1 June 2007): the licensee is meeting the condition and the prohibition` (Date 1 6 2007) TRUE FALSE EQUALS JUST TRUE
#ASSERT `Rg 4 reg 8(2) and (3) (from 1 June 2007): the licensee is meeting the condition and the prohibition` (Date 1 6 2007) TRUE TRUE EQUALS JUST FALSE
#ASSERT `Rg 4 reg 10(3) (from 1 June 2007): the Authority may order retraining of up to 12 months` (Date 1 6 2007) TRUE EQUALS JUST TRUE
#ASSERT `Rg 4 reg 10(3) (from 1 June 2007): the Authority may order retraining of up to 12 months` (Date 31 5 2007) TRUE EQUALS NOTHING
#ASSERT `Rg 4 reg 14(a) (from 1 June 2007): the licensee is guilty of an offence` (Date 1 6 2007) TRUE EQUALS JUST TRUE
#ASSERT `Rg 4 reg 14(a) (from 1 June 2007): the licensee is guilty of an offence` (Date 31 5 2007) TRUE EQUALS NOTHING

§ `Internal Wiring Regulations 2005`

#ASSERT `IW reg 1: the Regulations are in operation on the date (from 21 July 2005)` (Date 21 7 2005)
#ASSERT NOT (`IW reg 1: the Regulations are in operation on the date (from 21 July 2005)` (Date 20 7 2005))
