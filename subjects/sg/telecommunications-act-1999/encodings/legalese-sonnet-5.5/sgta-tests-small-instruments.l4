#ASSERT NOT (`IW reg 6(4) to (6): the licensee has done what the regulation requires` TRUE 15)
#ASSERT `IW reg 7: the licence remains valid` FALSE
#ASSERT NOT (`IW reg 7: the licence remains valid` TRUE)
