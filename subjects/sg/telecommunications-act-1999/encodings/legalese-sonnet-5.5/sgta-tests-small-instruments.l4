#ASSERT NOT (`IW reg 11(3): the licensee has done what the regulation requires` TRUE FALSE)
#ASSERT NOT (`IW reg 11(4): the licensee is entitled to compensation or a refund of fees for the unexpired period` TRUE)
#ASSERT NOT (`IW reg 11(5): the cancellation prevents the person from subsequently being deemed a holder under regulation 5` TRUE)
