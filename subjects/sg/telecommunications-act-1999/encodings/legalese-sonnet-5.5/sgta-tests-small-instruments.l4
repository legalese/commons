#ASSERT `IW reg 12(2) and (3): the licensee is not guilty of an offence` FALSE TRUE
#ASSERT NOT (`IW reg 12(2) and (3): the licensee is not guilty of an offence` FALSE FALSE)
#ASSERT `IW reg 12(4): the fee in dollars the Authority may impose` TRUE EQUALS JUST 70
#ASSERT `IW reg 12(4): the fee in dollars the Authority may impose` FALSE EQUALS NOTHING
