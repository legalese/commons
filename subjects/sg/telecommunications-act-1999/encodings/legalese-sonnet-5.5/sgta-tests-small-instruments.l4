#ASSERT `IW reg 9: the licensee may do it` FALSE FALSE
#ASSERT NOT (`IW reg 9: the licensee may do it` FALSE TRUE)
#ASSERT `IW reg 10: the Authority may issue a replacement licence` TRUE FALSE FALSE
#ASSERT `IW reg 10: the Authority may issue a replacement licence` TRUE TRUE TRUE
#ASSERT NOT (`IW reg 10: the Authority may issue a replacement licence` TRUE TRUE FALSE)
