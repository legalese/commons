IMPORT prelude
IMPORT daydate
IMPORT `sgta-nouns`
IMPORT `sgta-i-rg3-licences`
IMPORT `sgta-i-rg3-amendments`

-- LAYER-1 TESTS for the Class Licences Regulations (Rg 3): the 2002 Revised Edition and the seven amending instruments.
-- Expected values are written by hand from the text (each rule's @ref gives the raw line).  Both sides of every commencement date.

§ `Rg 3, 2002 Revised Edition`

#ASSERT `Rg 3 reg 2: this is a "class licence"` TRUE
#ASSERT `Rg 3 reg 2: the person is a "Facilities-Based Operator" or "FBO"` TRUE
#ASSERT `Rg 3 reg 2: the person is a "licensee"` TRUE
#ASSERT `Rg 3 reg 2: the person is an "operator"` TRUE
#ASSERT `Rg 3 reg 2: the person is a "Services-Based Operator" or "SBO"` TRUE
#ASSERT `Rg 3 reg 2: this is a "specified telecommunication system and service"` TRUE
#ASSERT `Rg 3 reg 4: the operator has registered as the regulation requires` TRUE TRUE
#ASSERT NOT (`Rg 3 reg 4: the operator has registered as the regulation requires` TRUE FALSE)
#ASSERT `Rg 3 reg 5: the operator has paid the registration fee` TRUE
#ASSERT `Rg 3 reg 6: the registration is still in force` 2 FALSE
#ASSERT NOT (`Rg 3 reg 6: the registration is still in force` 3 FALSE)
#ASSERT `Rg 3 reg 6: the registration is still in force` 10 TRUE
#ASSERT `Rg 3 reg 7: the licensee must meet the conditions of these Regulations in addition to the code of practice or standard of performance` TRUE
#ASSERT `Rg 3 reg 8: the provision, condition or fee does not apply to the person` TRUE
#ASSERT `Rg 3 reg 9: the licensee may establish or provide the link` FALSE FALSE FALSE
#ASSERT `Rg 3 reg 9: the licensee may establish or provide the link` TRUE FALSE TRUE
#ASSERT `Rg 3 reg 9: the licensee may establish or provide the link` TRUE TRUE FALSE
#ASSERT NOT (`Rg 3 reg 9: the licensee may establish or provide the link` TRUE FALSE FALSE)
#ASSERT `Rg 3 reg 10: the licensee has published the information the regulation requires` FALSE FALSE
#ASSERT NOT (`Rg 3 reg 10: the licensee has published the information the regulation requires` TRUE FALSE)
#ASSERT `Rg 3 reg 11: the licensee has met the financial requirement` FALSE FALSE
#ASSERT `Rg 3 reg 11: the licensee has met the financial requirement` TRUE TRUE
#ASSERT NOT (`Rg 3 reg 11: the licensee has met the financial requirement` TRUE FALSE)
#ASSERT `Rg 3 reg 12: the licensee has met the condition` TRUE
#ASSERT `Rg 3 reg 13: the licensee has done what the regulation requires` FALSE FALSE
#ASSERT NOT (`Rg 3 reg 13: the licensee has done what the regulation requires` TRUE FALSE)
#ASSERT `Rg 3 reg 14: the licensee has notified the Authority` TRUE
#ASSERT `Rg 3 reg 15: the licence is deemed to have been granted under these Regulations` TRUE FALSE
#ASSERT `Rg 3 reg 15: the licence is deemed to have been granted under these Regulations` FALSE TRUE
#ASSERT NOT (`Rg 3 reg 15: the licence is deemed to have been granted under these Regulations` FALSE FALSE)
#ASSERT `Rg 3 First Schedule item 1: this is a store-and-retrieve value-added network service` "on-line games"
#ASSERT NOT (`Rg 3 First Schedule item 1: this is a store-and-retrieve value-added network service` "newspaper publishing")
#ASSERT `Rg 3 First Schedule items 2 to 4: the licensee is meeting the conditions` TRUE FALSE FALSE TRUE
#ASSERT `Rg 3 First Schedule items 2 to 4: the licensee is meeting the conditions` TRUE TRUE TRUE TRUE
#ASSERT NOT (`Rg 3 First Schedule items 2 to 4: the licensee is meeting the conditions` TRUE TRUE FALSE TRUE)
#ASSERT `Rg 3 Second Schedule item 1: this is an audiotex service` TRUE
#ASSERT `Rg 3 Second Schedule items 2 to 7: the licensee is meeting the conditions` TRUE TRUE TRUE FALSE TRUE
#ASSERT NOT (`Rg 3 Second Schedule items 2 to 7: the licensee is meeting the conditions` TRUE TRUE TRUE TRUE TRUE)
#ASSERT `Rg 3 Second Schedule item 8: the first seconds of the call for which the caller is not charged` 3 EQUALS JUST 6
#ASSERT `Rg 3 Second Schedule item 8: the first seconds of the call for which the caller is not charged` 4 EQUALS JUST 12
#ASSERT `Rg 3 Second Schedule item 8: the first seconds of the call for which the caller is not charged` 10 EQUALS JUST 12
#ASSERT `Rg 3 Second Schedule item 8: the first seconds of the call for which the caller is not charged` 11 EQUALS NOTHING
#ASSERT `Rg 3 Second Schedule item 4(d): the call is within the maximum period without the caller's option to extend` 10
#ASSERT NOT (`Rg 3 Second Schedule item 4(d): the call is within the maximum period without the caller's option to extend` 11)
#ASSERT `Rg 3 Third Schedule item 1: this is a public switched telecommunication service that may be resold under the class licence` "public radio paging services"
#ASSERT NOT (`Rg 3 Third Schedule item 1: this is a public switched telecommunication service that may be resold under the class licence` "public chain payphone services")
#ASSERT `Rg 3 Third Schedule items 2 to 9: the licensee is meeting the conditions` FALSE FALSE FALSE TRUE FALSE TRUE TRUE
#ASSERT NOT (`Rg 3 Third Schedule items 2 to 9: the licensee is meeting the conditions` FALSE FALSE FALSE TRUE TRUE TRUE TRUE)
#ASSERT `Rg 3 Third Schedule item 6: the maximum set-up charge in cents for each successful call` "international dialling (IDD)" EQUALS 30
#ASSERT `Rg 3 Third Schedule item 6: the maximum set-up charge in cents for each successful call` "subscriber trunk dialling (STD)" EQUALS 10
#ASSERT `Rg 3 Fourth Schedule items 2 to 10: the licensee is meeting the conditions` FALSE TRUE FALSE TRUE TRUE
#ASSERT NOT (`Rg 3 Fourth Schedule items 2 to 10: the licensee is meeting the conditions` FALSE TRUE FALSE TRUE FALSE)
#ASSERT `Rg 3 Fourth Schedule item 6: the maximum set-up charge in cents for each successful call` "international direct dialling (IDD)" EQUALS 30
#ASSERT `Rg 3 Fifth Schedule items 2 to 4: the licensee is meeting the conditions of the call-back and call re-origination class licence` FALSE TRUE TRUE
#ASSERT NOT (`Rg 3 Fifth Schedule items 2 to 4: the licensee is meeting the conditions of the call-back and call re-origination class licence` TRUE TRUE TRUE)
#ASSERT `Rg 3 Sixth Schedule item 2: the licensee is meeting the condition of the internet based voice and data services class licence` TRUE
#ASSERT `Rg 3 Seventh Schedule item 2: the licensee is meeting the condition of the international calling card class licence` FALSE
#ASSERT `Rg 3 Eighth Schedule Part I: the registration fee` "Audiotex services" FALSE EQUALS JUST "$200 for 3 years"
#ASSERT `Rg 3 Eighth Schedule Part I: the registration fee` "Store-and-retrieve value-added network services" FALSE EQUALS JUST "No fee"
#ASSERT `Rg 3 Eighth Schedule Part I: the registration fee` "Store-and-retrieve value-added network services" TRUE EQUALS JUST "$200 for 3 years"
#ASSERT `Rg 3 Eighth Schedule Part I: the registration fee` "Newspaper publishing" FALSE EQUALS NOTHING
#ASSERT `Rg 3 Eighth Schedule Part II: the fee payable for every 3 years, in dollars` 3 600 EQUALS 200
#ASSERT `Rg 3 Eighth Schedule Part II: the fee payable for every 3 years, in dollars` 2 200 EQUALS 200
#ASSERT `Rg 3 Eighth Schedule Part II: the fee payable for every 3 years, in dollars` 1 200 EQUALS 200

