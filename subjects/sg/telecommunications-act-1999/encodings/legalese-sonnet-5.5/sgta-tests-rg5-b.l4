-- LAYER-1 TESTS for the Radio-communication Regulations (Rg 5): Parts IV to X and the Schedules (regs 19(2) to 80).
-- Expected values are written by hand from the regulation text (each rule's @ref gives the raw line).

§ `Rg 5 regs 19 to 28: licensing requirement, spectrum licences, station licences`

#ASSERT `Rg 5 reg 19(2): the application for or renewal of a licence is as the regulation requires` TRUE TRUE
#ASSERT NOT (`Rg 5 reg 19(2): the application for or renewal of a licence is as the regulation requires` TRUE FALSE)
#ASSERT `Rg 5 reg 19(3): the licence is valid` TRUE FALSE
#ASSERT NOT (`Rg 5 reg 19(3): the licence is valid` TRUE TRUE)
#ASSERT NOT (`Rg 5 reg 19(3): the licence is valid` FALSE FALSE)
#ASSERT `Rg 5 reg 20: the Authority may grant the licence to the person` TRUE FALSE FALSE FALSE FALSE
#ASSERT `Rg 5 reg 20: the Authority may grant the licence to the person` FALSE TRUE FALSE FALSE FALSE
#ASSERT `Rg 5 reg 20: the Authority may grant the licence to the person` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`Rg 5 reg 20: the Authority may grant the licence to the person` FALSE FALSE FALSE FALSE FALSE)
#ASSERT `Rg 5 reg 21: the grant of the licence is enough to possess, establish, install, maintain, provide or operate the station or network` TRUE
#ASSERT NOT (`Rg 5 reg 21: the grant of the licence is enough to possess, establish, install, maintain, provide or operate the station or network` FALSE)
#ASSERT `Rg 5 reg 22: the licensee must meet both the Regulations' condition and the section 5 condition` TRUE TRUE
#ASSERT NOT (`Rg 5 reg 22: the licensee must meet both the Regulations' condition and the section 5 condition` TRUE FALSE)
#ASSERT `Rg 5 reg 23(1): the Authority may grant the station (spectrum) licence or network (spectrum) licence` TRUE TRUE TRUE TRUE
#ASSERT NOT (`Rg 5 reg 23(1): the Authority may grant the station (spectrum) licence or network (spectrum) licence` TRUE TRUE FALSE TRUE)
#ASSERT `Rg 5 reg 23(2): the licence specifies what the regulation requires` TRUE TRUE
#ASSERT NOT (`Rg 5 reg 23(2): the licence specifies what the regulation requires` TRUE FALSE)
-- reg 23(3): 7 days is not late; 8 to 14 days $10; 15 to 30 days $20; after 30 days $50.
#ASSERT `Rg 5 reg 23(3): the late payment fee in dollars` 7 EQUALS JUST 0
#ASSERT `Rg 5 reg 23(3): the late payment fee in dollars` 8 EQUALS JUST 10
#ASSERT `Rg 5 reg 23(3): the late payment fee in dollars` 14 EQUALS JUST 10
#ASSERT `Rg 5 reg 23(3): the late payment fee in dollars` 15 EQUALS JUST 20
#ASSERT `Rg 5 reg 23(3): the late payment fee in dollars` 30 EQUALS JUST 20
#ASSERT `Rg 5 reg 23(3): the late payment fee in dollars` 31 EQUALS JUST 50
#ASSERT `Rg 5 reg 24(1): the change to the particulars in the licence is permitted` TRUE
#ASSERT NOT (`Rg 5 reg 24(1): the change to the particulars in the licence is permitted` FALSE)
#ASSERT `Rg 5 reg 24(2) to (4): the licensee is keeping the record the regulation requires` TRUE TRUE TRUE
#ASSERT NOT (`Rg 5 reg 24(2) to (4): the licensee is keeping the record the regulation requires` TRUE TRUE FALSE)
#ASSERT `Rg 5 reg 25(1): this is a licence the regulation says may be granted` "Amateur Station Licence"
#ASSERT NOT (`Rg 5 reg 25(1): this is a licence the regulation says may be granted` "Television Receiver Licence")
#ASSERT `Rg 5 reg 25(3): the Authority may grant the licence for the band` FALSE FALSE
#ASSERT `Rg 5 reg 25(3): the Authority may grant the licence for the band` TRUE TRUE
#ASSERT NOT (`Rg 5 reg 25(3): the Authority may grant the licence for the band` FALSE TRUE)
#ASSERT `Rg 5 reg 26(6): the late payment fee in dollars` 7 EQUALS 0
#ASSERT `Rg 5 reg 26(6): the late payment fee in dollars` 8 EQUALS 10
#ASSERT `Rg 5 reg 26(6): the late payment fee in dollars` 15 EQUALS 20
#ASSERT `Rg 5 reg 26(6): the late payment fee in dollars` 31 EQUALS 50
#ASSERT `Rg 5 reg 26(4): the Authority may reduce the licence fees, the application and processing fees, or the annual fees` TRUE
#ASSERT `Rg 5 reg 27: the Authority may change or withdraw the frequency without compensation and without giving a reason` TRUE
#ASSERT `Rg 5 reg 28(1): this is a class of Network Licence the Authority may grant` "Fixed Wireless Network Licence"
#ASSERT NOT (`Rg 5 reg 28(1): this is a class of Network Licence the Authority may grant` "Amateur Network Licence")
#ASSERT `Rg 5 reg 28(2): a private network licence authorises the licensee to provide a telecommunication service to the general public` FALSE EQUALS FALSE
#ASSERT `Rg 5 reg 28(3): the Network Licence may be granted` TRUE
#ASSERT `Rg 5 reg 28(4): the Authority may refuse a Localised Private Network Licence or Wide-area Private Network Licence` TRUE FALSE
#ASSERT NOT (`Rg 5 reg 28(4): the Authority may refuse a Localised Private Network Licence or Wide-area Private Network Licence` FALSE FALSE)

