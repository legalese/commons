§ `Regulations 26(4) and 28(1), on both axes`
#ASSERT `Rg 5 reg 26(4): the fees the Authority may reduce, for the conduct day, as read on the reading day` (Date 1 3 2001) (Date 4 11 2026) EQUALS NOTHING
#ASSERT `Rg 5 reg 26(4): the fees the Authority may reduce, for the conduct day, as read on the reading day` (Date 2 3 2001) (Date 4 11 2026) EQUALS JUST (LIST "application and processing fees payable under paragraph (2)", "annual fees payable under paragraph (3)")
#ASSERT `Rg 5 reg 26(4): the fees the Authority may reduce, for the conduct day, as read on the reading day` (Date 17 9 2001) (Date 4 11 2026) EQUALS JUST (LIST "application and processing fees payable under paragraph (2)", "annual fees payable under paragraph (3)")
#ASSERT `Rg 5 reg 26(4): the fees the Authority may reduce, for the conduct day, as read on the reading day` (Date 18 9 2001) (Date 4 11 2026) EQUALS JUST (LIST "licence fees payable under paragraph (1)", "application and processing fees payable under paragraph (2)", "annual fees payable under paragraph (3)")
#ASSERT `Rg 5 reg 26(4): the fees the Authority may reduce, for the conduct day, as read on the reading day` (Date 18 9 2001) (Date 17 9 2001) EQUALS JUST (LIST "application and processing fees payable under paragraph (2)", "annual fees payable under paragraph (3)")
#ASSERT `Rg 5 reg 26(4): the fees the Authority may reduce, for the conduct day, as read on the reading day` (Date 18 9 2001) (Date 18 9 2001) EQUALS JUST (LIST "licence fees payable under paragraph (1)", "application and processing fees payable under paragraph (2)", "annual fees payable under paragraph (3)")
#ASSERT `Rg 5 reg 28(1): the classes of network licence the Authority may grant, for the conduct day, as read on the reading day` (Date 1 3 2001) (Date 4 11 2026) EQUALS NOTHING
#ASSERT `Rg 5 reg 28(1): the classes of network licence the Authority may grant, for the conduct day, as read on the reading day` (Date 2 3 2001) (Date 4 11 2026) EQUALS JUST (LIST "Localised Private Network Licence", "Wide-area Private Network Licence", "Public Mobile Network Licence")
#ASSERT `Rg 5 reg 28(1): the classes of network licence the Authority may grant, for the conduct day, as read on the reading day` (Date 17 9 2001) (Date 4 11 2026) EQUALS JUST (LIST "Localised Private Network Licence", "Wide-area Private Network Licence", "Public Mobile Network Licence")
#ASSERT `Rg 5 reg 28(1): the classes of network licence the Authority may grant, for the conduct day, as read on the reading day` (Date 18 9 2001) (Date 4 11 2026) EQUALS JUST (LIST "Localised Private Network Licence", "Wide-area Private Network Licence", "Public Mobile Network Licence", "Fixed Wireless Network Licence")
#ASSERT `Rg 5 reg 28(1): the classes of network licence the Authority may grant, for the conduct day, as read on the reading day` (Date 18 9 2001) (Date 17 9 2001) EQUALS JUST (LIST "Localised Private Network Licence", "Wide-area Private Network Licence", "Public Mobile Network Licence")

