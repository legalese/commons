IMPORT prelude
IMPORT `sgta-nouns`
IMPORT `sgta-part9-s89-90`
IMPORT `sgta-part9-s91-92`
IMPORT `sgta-part9-s93-94-97`

-- LAYER-1 TESTS for Part 9 of the Act (ss 89 to 94 and 97).  Expected values are written by hand from the quoted text.
-- Time limits are tested on both sides (14 days: s 89; 2 days: s 94(2); 6 months: s 92(9)); 10% of turnover against $1 million (s 92(17)) likewise.

§ `s 89 Reconsideration by Authority and appeal to Minister`

#ASSERT `s 89(1): the licensee may make a request to the Authority to reconsider the matter, or appeal to the Minister` TRUE TRUE FALSE 14
#ASSERT `s 89(1): the licensee may make a request to the Authority to reconsider the matter, or appeal to the Minister` TRUE FALSE TRUE 1
#ASSERT NOT (`s 89(1): the licensee may make a request to the Authority to reconsider the matter, or appeal to the Minister` TRUE TRUE FALSE 15)
#ASSERT NOT (`s 89(1): the licensee may make a request to the Authority to reconsider the matter, or appeal to the Minister` FALSE TRUE FALSE 5)
#ASSERT NOT (`s 89(1): the licensee may make a request to the Authority to reconsider the matter, or appeal to the Minister` TRUE FALSE FALSE 5)
#ASSERT `s 89(2): the person may make a request to the Authority to reconsider the matter, or appeal to the Minister` FALSE TRUE FALSE 14
#ASSERT `s 89(2): the person may make a request to the Authority to reconsider the matter, or appeal to the Minister` FALSE FALSE TRUE 14
#ASSERT NOT (`s 89(2): the person may make a request to the Authority to reconsider the matter, or appeal to the Minister` TRUE TRUE FALSE 14)
#ASSERT NOT (`s 89(2): the person may make a request to the Authority to reconsider the matter, or appeal to the Minister` FALSE TRUE FALSE 15)
#ASSERT `s 89(3): the person has acted in contravention of the subsection` TRUE TRUE
#ASSERT NOT (`s 89(3): the person has acted in contravention of the subsection` TRUE FALSE)
#ASSERT NOT (`s 89(3): the person has acted in contravention of the subsection` FALSE TRUE)
#ASSERT `s 89(4): the appeal is deemed to be withdrawn` TRUE
#ASSERT NOT (`s 89(4): the appeal is deemed to be withdrawn` FALSE)
#ASSERT `s 89(5): the appeal to the Minister is deemed to be withdrawn` TRUE TRUE
#ASSERT NOT (`s 89(5): the appeal to the Minister is deemed to be withdrawn` TRUE FALSE)
#ASSERT `s 89(6): the Authority may determine the request by confirming, varying or reversing the decision or direction, or amending the code of practice or standard of performance` TRUE
#ASSERT `s 89(7): the person may appeal to the Minister` TRUE 14
#ASSERT NOT (`s 89(7): the person may appeal to the Minister` TRUE 15)
#ASSERT NOT (`s 89(7): the person may appeal to the Minister` FALSE 3)
#ASSERT `s 89(8): the appellant has complied with the subsection` TRUE TRUE
#ASSERT NOT (`s 89(8): the appellant has complied with the subsection` TRUE FALSE)
#ASSERT `s 89(9): the Minister may reject the appeal` TRUE
#ASSERT NOT (`s 89(9): the Minister may reject the appeal` FALSE)
#ASSERT `s 89(10) and (11): the Minister may require the person to provide the information the Minister requires for considering and determining the appeal` TRUE TRUE FALSE
#ASSERT `s 89(10) and (11): the Minister may require the person to provide the information the Minister requires for considering and determining the appeal` TRUE FALSE TRUE
#ASSERT NOT (`s 89(10) and (11): the Minister may require the person to provide the information the Minister requires for considering and determining the appeal` FALSE TRUE FALSE)
#ASSERT NOT (`s 89(10) and (11): the Minister may require the person to provide the information the Minister requires for considering and determining the appeal` TRUE FALSE FALSE)
#ASSERT `s 89(12): the person has complied with the requirement` TRUE
#ASSERT `s 89(13): the Minister may confirm, vary or reverse the decision or direction, or amend the code of practice or standard of performance` TRUE
#ASSERT `s 89(14): the decision of the Minister is final` TRUE
#ASSERT `s 89(15): the decision, direction or other matter must be complied with` TRUE FALSE FALSE
#ASSERT NOT (`s 89(15): the decision, direction or other matter must be complied with` TRUE TRUE FALSE)
#ASSERT NOT (`s 89(15): the decision, direction or other matter must be complied with` FALSE FALSE FALSE)
#ASSERT NOT (`s 89(15): the decision, direction or other matter must be complied with` TRUE FALSE TRUE)
#ASSERT `s 89(16): the Minister may make the regulations` TRUE
#ASSERT `s 90: the licensee or person is liable to pay the Authority the prescribed interest on the unpaid sum for the period it remains unpaid` TRUE TRUE
#ASSERT NOT (`s 90: the licensee or person is liable to pay the Authority the prescribed interest on the unpaid sum for the period it remains unpaid` TRUE FALSE)
#ASSERT NOT (`s 90: the licensee or person is liable to pay the Authority the prescribed interest on the unpaid sum for the period it remains unpaid` FALSE TRUE)

§ `s 91 Power of Minister to issue written order relating to acquisition of assets, etc.`

#ASSERT `s 91(1): the Minister may issue a written order to the relevant person, to the licensee or trustee, or to both` TRUE TRUE TRUE
#ASSERT NOT (`s 91(1): the Minister may issue a written order to the relevant person, to the licensee or trustee, or to both` TRUE TRUE FALSE)
#ASSERT NOT (`s 91(1): the Minister may issue a written order to the relevant person, to the licensee or trustee, or to both` TRUE FALSE TRUE)
#ASSERT NOT (`s 91(1): the Minister may issue a written order to the relevant person, to the licensee or trustee, or to both` FALSE TRUE TRUE)
#ASSERT `s 91(2): the Minister may include this direction in the written order` "a restriction on the exercise of voting power by the relevant person"
#ASSERT NOT (`s 91(2): the Minister may include this direction in the written order` "a restriction on the issue of passports")
#ASSERT NOT (`s 91(3)(a): the voting rights in respect of the equity interests are exercisable` TRUE FALSE FALSE)
#ASSERT `s 91(3)(a): the voting rights in respect of the equity interests are exercisable` TRUE FALSE TRUE
#ASSERT `s 91(3)(a): the voting rights in respect of the equity interests are exercisable` TRUE TRUE FALSE
#ASSERT `s 91(3)(a): the voting rights in respect of the equity interests are exercisable` FALSE FALSE FALSE
#ASSERT `s 91(3)(b): equity interests may be issued or offered in respect of the equity interests` TRUE FALSE TRUE
#ASSERT `s 91(3)(c): a payment may be made in respect of the equity interests` TRUE FALSE FALSE TRUE
#ASSERT `s 91(3)(c): a payment may be made in respect of the equity interests` TRUE FALSE TRUE FALSE
#ASSERT `s 91(4): the Minister may issue the written order under subsection (1)` TRUE FALSE
#ASSERT `s 91(4): the Minister may issue the written order under subsection (1)` FALSE TRUE
#ASSERT NOT (`s 91(4): the Minister may issue the written order under subsection (1)` FALSE FALSE)
#ASSERT `s 91(5): the Minister has acted as the subsection requires` FALSE FALSE
#ASSERT `s 91(5): the Minister has acted as the subsection requires` TRUE TRUE
#ASSERT NOT (`s 91(5): the Minister has acted as the subsection requires` TRUE FALSE)
#ASSERT `s 91(6): the Minister may vary or revoke the written order` TRUE
#ASSERT `s 91(7): the person must comply with the written order, which takes effect despite any other written law and the constitution of the licensee, trust or designated trust` TRUE
#ASSERT `s 91(8): the person is guilty of an offence and the most the penalty may be (the further daily fine is $12,500 for an individual, $25,000 otherwise)` TRUE TRUE EQUALS JUST (`Penalty` OF 125000, 36, 12500, FALSE)
#ASSERT `s 91(8): the person is guilty of an offence and the most the penalty may be (the further daily fine is $12,500 for an individual, $25,000 otherwise)` TRUE FALSE EQUALS JUST (`Penalty` OF 250000, 0, 25000, FALSE)
#ASSERT `s 91(8): the person is guilty of an offence and the most the penalty may be (the further daily fine is $12,500 for an individual, $25,000 otherwise)` FALSE TRUE EQUALS NOTHING
#ASSERT `s 91(9): this is a "designated business trust" or "designated trust"` TRUE
#ASSERT `s 91(9): this is an "equity interest"` TRUE FALSE FALSE
#ASSERT `s 91(9): this is an "equity interest"` FALSE FALSE TRUE
#ASSERT NOT (`s 91(9): this is an "equity interest"` FALSE FALSE FALSE)

§ `s 92 Power of Minister to issue separation order`

#ASSERT `s 92(1): the Minister may issue a separation order to the relevant telecommunication licensee` TRUE FALSE FALSE FALSE TRUE TRUE
#ASSERT `s 92(1): the Minister may issue a separation order to the relevant telecommunication licensee` FALSE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`s 92(1): the Minister may issue a separation order to the relevant telecommunication licensee` FALSE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`s 92(1): the Minister may issue a separation order to the relevant telecommunication licensee` TRUE FALSE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`s 92(1): the Minister may issue a separation order to the relevant telecommunication licensee` TRUE FALSE FALSE FALSE TRUE FALSE)
#ASSERT `s 92(2): the Minister must have regard to whether the separation order is necessary or desirable for this purpose` "to promote the efficiency and international competitiveness of the telecommunication industry in Singapore"
#ASSERT NOT (`s 92(2): the Minister must have regard to whether the separation order is necessary or desirable for this purpose` "to raise revenue for the Government")
#ASSERT `s 92(3): the separation order may contain this direction` "to establish a separate entity and ensure that it applies for a licence under section 5"
#ASSERT NOT (`s 92(3): the separation order may contain this direction` "to dismiss the licensee's employees")
#ASSERT `s 92(4): the Minister has determined the directions as the subsection requires` TRUE TRUE
#ASSERT NOT (`s 92(4): the Minister has determined the directions as the subsection requires` TRUE FALSE)
#ASSERT `s 92(5): a licence granted under section 5 to the separate entity may include this condition` "to operate on a stand-alone basis"
#ASSERT NOT (`s 92(5): a licence granted under section 5 to the separate entity may include this condition` "to pay a dividend to the licensee")
#ASSERT `s 92(6): the separation order takes effect despite any other written law, rule of law, and the constitution of the relevant telecommunication licensee` TRUE
#ASSERT `s 92(7): the business or property is transferred to and vests in the transferee, and existing arrangements and proceedings are enforceable by or against the transferee` TRUE TRUE
#ASSERT NOT (`s 92(7): the business or property is transferred to and vests in the transferee, and existing arrangements and proceedings are enforceable by or against the transferee` TRUE FALSE)
#ASSERT `s 92(8): the Minister may award compensation to the relevant telecommunication licensee` TRUE TRUE
#ASSERT NOT (`s 92(8): the Minister may award compensation to the relevant telecommunication licensee` TRUE FALSE)
#ASSERT `s 92(9): the Minister has established the scheme in time` 6
#ASSERT NOT (`s 92(9): the Minister has established the scheme in time` 7)
#ASSERT `s 92(10): the scheme may provide for this matter` "the remuneration and expenses of the independent valuer"
#ASSERT NOT (`s 92(10): the scheme may provide for this matter` "the licensee's dividends")
#ASSERT `s 92(11): compensation may be awarded under subsection (8)` FALSE FALSE
#ASSERT NOT (`s 92(11): compensation may be awarded under subsection (8)` TRUE FALSE)
#ASSERT NOT (`s 92(11): compensation may be awarded under subsection (8)` FALSE TRUE)
#ASSERT `s 92(12): the compensation is charged on and paid out of the Consolidated Fund` TRUE
#ASSERT `s 92(13): the Minister may issue the separation order` TRUE FALSE
#ASSERT `s 92(13): the Minister may issue the separation order` FALSE TRUE
#ASSERT NOT (`s 92(13): the Minister may issue the separation order` FALSE FALSE)
#ASSERT `s 92(14): the Minister has acted as the subsection requires` FALSE FALSE
#ASSERT NOT (`s 92(14): the Minister has acted as the subsection requires` TRUE FALSE)
#ASSERT `s 92(15): the Minister may at any time vary, suspend or revoke the whole or any part of the separation order` TRUE
#ASSERT `s 92(16): the person must comply with the separation order` TRUE
#ASSERT `s 92(17): the most the fine may be on conviction, in dollars` FALSE TRUE FALSE 0 EQUALS NOTHING
#ASSERT `s 92(17): the most the fine may be on conviction, in dollars` TRUE TRUE FALSE 0 EQUALS JUST 125000
#ASSERT `s 92(17): the most the fine may be on conviction, in dollars` TRUE FALSE TRUE 5000000 EQUALS JUST 1000000
#ASSERT `s 92(17): the most the fine may be on conviction, in dollars` TRUE FALSE TRUE 20000000 EQUALS JUST 2000000
#ASSERT `s 92(17): the most the fine may be on conviction, in dollars` TRUE FALSE FALSE 0 EQUALS JUST 1000000
#ASSERT `s 92(17): the most the further fine may be for every day or part of a day of a continuing offence after conviction, in dollars` TRUE FALSE EQUALS 12500
#ASSERT `s 92(17): the most the further fine may be for every day or part of a day of a continuing offence after conviction, in dollars` FALSE TRUE EQUALS 100000
#ASSERT `s 92(17): the most the further fine may be for every day or part of a day of a continuing offence after conviction, in dollars` FALSE FALSE EQUALS 100000
#ASSERT `s 92(18): this subsection of section 37 applies with the necessary modifications to section 92` "37(6)"
#ASSERT NOT (`s 92(18): this subsection of section 37 applies with the necessary modifications to section 92` "37(5)(b)")
#ASSERT `s 92(19): the person is a "30% controller" of the telecommunication licensee` TRUE FALSE
#ASSERT `s 92(19): the person is a "30% controller" of the telecommunication licensee` FALSE TRUE
#ASSERT NOT (`s 92(19): the person is a "30% controller" of the telecommunication licensee` FALSE FALSE)
#ASSERT `s 92(19): this is a "broadcasting licensee"` TRUE FALSE
#ASSERT NOT (`s 92(19): this is a "broadcasting licensee"` TRUE TRUE)
#ASSERT `s 92(19): this is within "business"` TRUE EQUALS JUST TRUE
#ASSERT `s 92(19): this is within "business"` FALSE EQUALS NOTHING
#ASSERT `s 92(19): this is "consideration"` TRUE
#ASSERT `s 92(19): the person has "effective control" over the telecommunication licensee or independent entity` TRUE FALSE
#ASSERT `s 92(19): the person has "effective control" over the telecommunication licensee or independent entity` FALSE TRUE
#ASSERT NOT (`s 92(19): the person has "effective control" over the telecommunication licensee or independent entity` FALSE FALSE)
#ASSERT `s 92(19): this is an "independent entity"` FALSE FALSE FALSE
#ASSERT NOT (`s 92(19): this is an "independent entity"` TRUE FALSE FALSE)
#ASSERT NOT (`s 92(19): this is an "independent entity"` FALSE TRUE FALSE)
#ASSERT NOT (`s 92(19): this is an "independent entity"` FALSE FALSE TRUE)
#ASSERT `s 92(19): this is within "property"` TRUE EQUALS JUST TRUE
#ASSERT `s 92(19): this is within "property"` FALSE EQUALS NOTHING
#ASSERT `s 92(19): this is a "separate entity"` TRUE
#ASSERT `s 92(19): the person has "significant market power"` TRUE
#ASSERT NOT (`s 92(19): the person has "significant market power"` FALSE)
#ASSERT `s 92(19): this is a "voting share"` TRUE
#ASSERT `s 92(20): the reference to the issuing of a separation order includes the varying` TRUE

§ `ss 93, 94 and 97`

#ASSERT `s 93: the public telecommunication licensee is liable for the injury, loss or damage` TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT NOT (`s 93: the public telecommunication licensee is liable for the injury, loss or damage` TRUE FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`s 93: the public telecommunication licensee is liable for the injury, loss or damage` FALSE FALSE FALSE TRUE FALSE TRUE)
#ASSERT `s 93: the public telecommunication licensee is liable for the injury, loss or damage` FALSE FALSE FALSE FALSE TRUE TRUE
#ASSERT `s 94(1): the Authority may serve the decision, notice, order or document on the person by this method` TRUE "individual" "delivering it to the individual personally"
#ASSERT NOT (`s 94(1): the Authority may serve the decision, notice, order or document on the person by this method` FALSE "individual" "delivering it to the individual personally")
#ASSERT NOT (`s 94(1): the Authority may serve the decision, notice, order or document on the person by this method` TRUE "individual" "delivering it to any one of the partners or the secretary or other like officer of the partnership")
#ASSERT `s 94(1): the Authority may serve the decision, notice, order or document on the person by this method` TRUE "partnership" "delivering it to any one of the partners or the secretary or other like officer of the partnership"
#ASSERT `s 94(1): the Authority may serve the decision, notice, order or document on the person by this method` TRUE "body corporate" "delivering it to the manager of the limited liability partnership or the secretary or other like officer of the body corporate"
#ASSERT NOT (`s 94(1): the Authority may serve the decision, notice, order or document on the person by this method` TRUE "body corporate" "delivering it to the individual personally")
#ASSERT `s 94(2): the document sent by prepaid registered post is deemed duly served, whether or not it is returned undelivered` 2
#ASSERT NOT (`s 94(2): the document sent by prepaid registered post is deemed duly served, whether or not it is returned undelivered` 1)
#ASSERT `s 94(3): the document sent by fax transmission is deemed duly served` TRUE TRUE
#ASSERT NOT (`s 94(3): the document sent by fax transmission is deemed duly served` TRUE FALSE)
#ASSERT `s 94(4): the document sent by electronic communication is deemed duly served` TRUE
#ASSERT NOT (`s 94(4): the document sent by electronic communication is deemed duly served` FALSE)
#ASSERT `s 94(5): service may be effected on the person by electronic communication` TRUE
#ASSERT NOT (`s 94(5): service may be effected on the person by electronic communication` FALSE)
#ASSERT `s 94(6): section 94 applies to the notice or document` FALSE
#ASSERT NOT (`s 94(6): section 94 applies to the notice or document` TRUE)
#ASSERT `s 97(1): the Authority may make the regulations` TRUE TRUE
#ASSERT NOT (`s 97(1): the Authority may make the regulations` FALSE TRUE)
#ASSERT `s 97(2): the Authority may make regulations for or with respect to this matter` "the control and regulation of dealing in and use of telecommunication equipment" TRUE
#ASSERT `s 97(2): the Authority may make regulations for or with respect to this matter` "the control and regulation of interference by radiowaves or electrical or other means to telecommunications in Singapore" TRUE
#ASSERT NOT (`s 97(2): the Authority may make regulations for or with respect to this matter` "the control and regulation of dealing in and use of telecommunication equipment" FALSE)
#ASSERT NOT (`s 97(2): the Authority may make regulations for or with respect to this matter` "the price of newspapers" TRUE)
