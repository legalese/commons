-- LAYER-1 TESTS for instrument functions the other test files do not reach: the Composition of Offences lists, the Internal Wiring definitions,
-- Rg 1 definitions and notices, Rg 4 reg 6, Rg 5 (the five-tier annual fee, reg 16(2)(ii), the reg 65(4) and reg 78(a) lists) and the Rg 6 definitions.
-- Expected values are written by hand from the instrument texts.

§ `Composition of Offences Regulations: the lists`

#ASSERT elem "35(3)" (`Comp Regs reg 2(a): the sections of the Act (2000 Edition numbers) whose offences may be compounded`)
#ASSERT NOT (elem "35(2)" (`Comp Regs reg 2(a): the sections of the Act (2000 Edition numbers) whose offences may be compounded`))
#ASSERT elem "Rg 5 Radio-communication" (`Comp Regs reg 2(b) to (f), 2005 form: the subsidiary instruments whose offences may be compounded`)
#ASSERT NOT (elem "Rg 3 Class Licences" (`Comp Regs reg 2(b) to (f), 2005 form: the subsidiary instruments whose offences may be compounded`))
#ASSERT elem "Rg 3 Class Licences" (`Comp Regs reg 2: the subsidiary instruments whose offences may be compounded, from 28 December 2011`)
#ASSERT elem "Internal Wiring Regulations 2005" (`Comp Regs reg 2: the subsidiary instruments whose offences may be compounded, from 28 December 2011`)

§ `Internal Wiring Regulations 2005: definitions and reg 3, reg 4(2)`

#ASSERT `IW reg 2: this is an "interface point"` TRUE
#ASSERT NOT (`IW reg 2: this is an "interface point"` FALSE)
#ASSERT `IW reg 2: this is a "licence"` TRUE
#ASSERT `IW reg 2: this is "telecommunication equipment"` TRUE
#ASSERT `IW reg 2: this is the "Code of Practice"` TRUE
#ASSERT `IW reg 2: the person is a "licensee"` TRUE
#ASSERT NOT (`IW reg 2: the person is a "licensee"` FALSE)
#ASSERT `IW reg 3: the Authority is the licensing authority for the licence` TRUE
#ASSERT `IW reg 4(2): the Code of Practice is made available to the person` TRUE
#ASSERT NOT (`IW reg 4(2): the Code of Practice is made available to the person` FALSE)

§ `Rg 1 and Rg 4`

#ASSERT `Rg 1 reg 2: this is a "certificate of competency"` TRUE
#ASSERT NOT (`Rg 1 reg 2: this is a "certificate of competency"` FALSE)
#ASSERT `Rg 1 reg 2: this is the "Constitution and Convention of the International Telecommunication Union"` TRUE
#ASSERT `Rg 1 reg 2: this is the "International Convention for the Safety of Life at Sea"` TRUE
#ASSERT `Rg 1 reg 2: these are the "Radio Regulations"` TRUE
#ASSERT `Rg 1 reg 2: this is the "STCW Code"` TRUE
#ASSERT `Rg 1 reg 2: this is the "STCW Convention"` TRUE
#ASSERT NOT (`Rg 1 reg 2: this is the "STCW Convention"` FALSE)
#ASSERT `Rg 1 reg 3: the Authority may issue a certificate of competency in radio-communications to the person` TRUE
#ASSERT NOT (`Rg 1 reg 3: the Authority may issue a certificate of competency in radio-communications to the person` FALSE)
#ASSERT `Rg 1 reg 4: the holder has made the declaration` TRUE
#ASSERT NOT (`Rg 1 reg 4: the holder has made the declaration` FALSE)
#ASSERT `Rg 1 reg 11(1) and (2): the certificate of competency is as the regulation requires` TRUE
#ASSERT `Rg 1 reg 12(5) to (7): the Authority may give written notice that the certificate shall cease to be recognised from a specified date` TRUE TRUE
#ASSERT NOT (`Rg 1 reg 12(5) to (7): the Authority may give written notice that the certificate shall cease to be recognised from a specified date` TRUE FALSE)
#ASSERT NOT (`Rg 1 reg 12(5) to (7): the Authority may give written notice that the certificate shall cease to be recognised from a specified date` FALSE TRUE)
#ASSERT `Rg 1 reg 12(9) and (10): the appeal to the Minister, whose decision is final, stays the Authority's decision` TRUE
#ASSERT NOT (`Rg 1 reg 12(9) and (10): the appeal to the Minister, whose decision is final, stays the Authority's decision` FALSE)
#ASSERT `Rg 4 reg 6: the Authority's register is as the regulation requires` TRUE
#ASSERT NOT (`Rg 4 reg 6: the Authority's register is as the regulation requires` FALSE)

§ `Rg 5`

#ASSERT `Rg 5 five-tier annual fee` 25 10 20 30 40 50 EQUALS 10
#ASSERT `Rg 5 five-tier annual fee` 26 10 20 30 40 50 EQUALS 20
#ASSERT `Rg 5 five-tier annual fee` 500 10 20 30 40 50 EQUALS 20
#ASSERT `Rg 5 five-tier annual fee` 501 10 20 30 40 50 EQUALS 30
#ASSERT `Rg 5 five-tier annual fee` 10000 10 20 30 40 50 EQUALS 30
#ASSERT `Rg 5 five-tier annual fee` 10001 10 20 30 40 50 EQUALS 40
#ASSERT `Rg 5 five-tier annual fee` 20000 10 20 30 40 50 EQUALS 40
#ASSERT `Rg 5 five-tier annual fee` 20001 10 20 30 40 50 EQUALS 50
#ASSERT `Rg 5 reg 16(2)(ii) (S 707/2005 form, 11 November 2005 to 31 March 2016): the most the financial penalty may be, in dollars` (Date 10 11 2005) EQUALS NOTHING
#ASSERT `Rg 5 reg 16(2)(ii) (S 707/2005 form, 11 November 2005 to 31 March 2016): the most the financial penalty may be, in dollars` (Date 11 11 2005) EQUALS JUST 1000000
#ASSERT `Rg 5 reg 16(2)(ii) (S 707/2005 form, 11 November 2005 to 31 March 2016): the most the financial penalty may be, in dollars` (Date 31 3 2016) EQUALS JUST 1000000
#ASSERT `Rg 5 reg 16(2)(ii) (S 707/2005 form, 11 November 2005 to 31 March 2016): the most the financial penalty may be, in dollars` (Date 1 4 2016) EQUALS NOTHING
#ASSERT `Rg 5 reg 16(2)(ii) (S 100/2016 form, from 1 April 2016): the most the financial penalty may be, in dollars` (Date 31 3 2016) 5000000 EQUALS NOTHING
#ASSERT `Rg 5 reg 16(2)(ii) (S 100/2016 form, from 1 April 2016): the most the financial penalty may be, in dollars` (Date 1 4 2016) 5000000 EQUALS JUST 1000000
#ASSERT `Rg 5 reg 16(2)(ii) (S 100/2016 form, from 1 April 2016): the most the financial penalty may be, in dollars` (Date 1 4 2016) 10000000 EQUALS JUST 1000000
#ASSERT `Rg 5 reg 16(2)(ii) (S 100/2016 form, from 1 April 2016): the most the financial penalty may be, in dollars` (Date 1 4 2016) 20000000 EQUALS JUST 2000000
#ASSERT elem `a public wireless broadband access system` (`Rg 5 reg 65(4): the public systems, from 1 June 2006`)
#ASSERT NOT (elem `a public wireless broadband access system` (`Rg 5 reg 65(4): the public systems, 2002 Revised Edition`))
#ASSERT elem `a public radio paging system` (`Rg 5 reg 65(4): the public systems, 2002 Revised Edition`)
#ASSERT elem "35(2)" (`Rg 5 reg 78(a): the regulations whose breach is an offence, 2002 Revised Edition`)
#ASSERT NOT (elem "35(1)" (`Rg 5 reg 78(a): the regulations whose breach is an offence, 2002 Revised Edition`))
#ASSERT elem "24" (`Rg 5 reg 78(a): the regulations whose breach is an offence, 2002 Revised Edition`)
#ASSERT elem "24(1)" (`Rg 5 reg 78(a): the regulations whose breach is an offence, from 1 April 2016`)
#ASSERT NOT (elem "24" (`Rg 5 reg 78(a): the regulations whose breach is an offence, from 1 April 2016`))

