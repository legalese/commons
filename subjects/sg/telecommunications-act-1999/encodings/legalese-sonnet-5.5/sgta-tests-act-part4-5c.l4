IMPORT prelude
IMPORT `sgta-nouns`
IMPORT `sgta-part4-ss30-32`
IMPORT `sgta-part5-ss33-36`
IMPORT `sgta-part5a-s38-39`
IMPORT `sgta-part5a-s40`
IMPORT `sgta-part5a-s41-43`
IMPORT `sgta-part5b-5c-ss44-52`

-- LAYER-1 TESTS for Parts 4, 5, 5A (ss 38 to 43), 5B and 5C of the Act.  Expected values are written by hand from the quoted text.
-- Thresholds are tested on both sides: 7 days (ss 33(1), (2)), 5% and 12% (s 38), 6 months (s 48(2)), 14 days (ss 33(8), 49(1)).

§ `Part 4: ss 30 to 32`

#ASSERT `s 30(1): the Authority may act under paragraphs (a) to (c) with respect to this subject` TRUE "the operation of telecommunication systems and equipment"
#ASSERT NOT (`s 30(1): the Authority may act under paragraphs (a) to (c) with respect to this subject` TRUE "the price of newspapers")
#ASSERT NOT (`s 30(1): the Authority may act under paragraphs (a) to (c) with respect to this subject` FALSE "the operation of telecommunication systems and equipment")
#ASSERT `s 30(2): the code of practice issued or approved under subsection (1) may contain this` TRUE FALSE
#ASSERT `s 30(2): the code of practice issued or approved under subsection (1) may contain this` FALSE TRUE
#ASSERT NOT (`s 30(2): the code of practice issued or approved under subsection (1) may contain this` FALSE FALSE)
#ASSERT `s 30(3): the code provision has effect only subject to the Act, or has no effect, to the extent of the inconsistency` TRUE
#ASSERT NOT (`s 30(4): the code of practice or standard of performance has legislative effect` TRUE)
#ASSERT `s 30(5): the telecommunication licensee must comply with the code of practice or standard of performance` TRUE FALSE
#ASSERT NOT (`s 30(5): the telecommunication licensee must comply with the code of practice or standard of performance` TRUE TRUE)
#ASSERT `s 30(6): the waiver has effect` TRUE
#ASSERT `s 31(1): the Authority may give directions to be observed by telecommunication licensees for this purpose` "in the public interest"
#ASSERT NOT (`s 31(1): the Authority may give directions to be observed by telecommunication licensees for this purpose` "to promote exports")
#ASSERT `s 31(2): the Authority may give directions to be observed by telecommunication licensees for this purpose, in relation to broadcasting services requiring a telecommunication system` "to ensure the technical compatibility and safety of operation of any equipment or telecommunication system used for the provision of any broadcasting service"
#ASSERT NOT (`s 31(2): the Authority may give directions to be observed by telecommunication licensees for this purpose, in relation to broadcasting services requiring a telecommunication system` "to promote exports")
#ASSERT `s 31(3)(a): the direction may require the licensee to do, or to refrain from doing, the thing` TRUE
#ASSERT `s 31(3)(b): the direction takes effect at this time` TRUE
#ASSERT `s 31(4): the Authority may at any time vary, suspend or revoke the direction` TRUE
#ASSERT `s 31(5): the Authority has done what it must do before giving or varying the direction` TRUE FALSE FALSE
#ASSERT `s 31(5): the Authority has done what it must do before giving or varying the direction` FALSE TRUE TRUE
#ASSERT NOT (`s 31(5): the Authority has done what it must do before giving or varying the direction` FALSE TRUE FALSE)
#ASSERT NOT (`s 31(5): the Authority has done what it must do before giving or varying the direction` FALSE FALSE FALSE)
#ASSERT `s 31(6): the telecommunication licensee must comply with the direction` TRUE
#ASSERT `s 32(1): the Authority may make the advisory guideline` TRUE TRUE
#ASSERT NOT (`s 32(1): the Authority may make the advisory guideline` FALSE TRUE)
#ASSERT `s 32(2): advisory guidelines may, for example, be made about this matter` "interference with radio-communications"
#ASSERT NOT (`s 32(2): advisory guidelines may, for example, be made about this matter` "the price of newspapers")
#ASSERT `s 32(3): the Authority has done what it must do with the advisory guideline` TRUE TRUE
#ASSERT NOT (`s 32(3): the Authority has done what it must do with the advisory guideline` TRUE FALSE)

