#ASSERT `s 13(1): the Authority may make a scheme determining the charges, or the other terms and conditions, applicable to the service` TRUE
#ASSERT `s 13(2): the scheme may make that different provision` TRUE
#ASSERT `s 13(3): the Authority may recover the charge in any court of competent jurisdiction as if it were a simple contract debt` TRUE
