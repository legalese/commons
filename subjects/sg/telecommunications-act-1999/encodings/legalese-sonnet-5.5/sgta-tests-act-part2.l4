#ASSERT `s 9(3): the Authority has acted as the subsection requires` TRUE TRUE TRUE
#ASSERT NOT (`s 9(3): the Authority has acted as the subsection requires` TRUE TRUE FALSE)
#ASSERT NOT (`s 9(3): the Authority has acted as the subsection requires` TRUE FALSE TRUE)
#ASSERT `s 9(4): the Authority may enforce its direction` FALSE FALSE FALSE
#ASSERT NOT (`s 9(4): the Authority may enforce its direction` TRUE FALSE FALSE)
#ASSERT NOT (`s 9(4): the Authority may enforce its direction` FALSE TRUE FALSE)
#ASSERT NOT (`s 9(4): the Authority may enforce its direction` FALSE FALSE TRUE)
#ASSERT `s 9(5): the Authority may forthwith carry out the modifications specified in the notice` TRUE FALSE
#ASSERT `s 9(5): the Authority may forthwith carry out the modifications specified in the notice` FALSE TRUE
#ASSERT NOT (`s 9(5): the Authority may forthwith carry out the modifications specified in the notice` FALSE FALSE)

§ `s 10 Suspension or cancellation of licence, etc.`

#ASSERT `s 10(1): the Authority may by written notice issue an order or require a financial penalty` TRUE TRUE FALSE FALSE FALSE
#ASSERT `s 10(1): the Authority may by written notice issue an order or require a financial penalty` TRUE FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 10(1): the Authority may by written notice issue an order or require a financial penalty` FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`s 10(1): the Authority may by written notice issue an order or require a financial penalty` TRUE FALSE FALSE FALSE FALSE)
#ASSERT `s 10(1)(e): the Authority may issue this written order` TRUE
#ASSERT `s 10(1)(f): the most the financial penalty may be, in dollars` 5000000 EQUALS 1000000
#ASSERT `s 10(1)(f): the most the financial penalty may be, in dollars` 30000000 EQUALS 3000000
#ASSERT `s 10(2): the Authority may by written notice, without compensation or refund of any fee, cancel the licence or part, suspend it, or reduce its period` TRUE FALSE FALSE FALSE
#ASSERT `s 10(2): the Authority may by written notice, without compensation or refund of any fee, cancel the licence or part, suspend it, or reduce its period` FALSE FALSE FALSE TRUE
#ASSERT NOT (`s 10(2): the Authority may by written notice, without compensation or refund of any fee, cancel the licence or part, suspend it, or reduce its period` FALSE FALSE FALSE FALSE)
#ASSERT `s 10(3)(a): the order may require the person to do, or refrain from doing, the thing` TRUE
#ASSERT `s 10(3)(b): the order takes effect at this time` TRUE
#ASSERT `s 10(4): the Authority may at any time vary, suspend or revoke the order` TRUE
#ASSERT `s 10(5): the person is guilty of an offence and the most the penalty may be` TRUE EQUALS JUST (`Penalty` OF 100000, 36, 0, FALSE)
#ASSERT `s 10(5): the person is guilty of an offence and the most the penalty may be` FALSE EQUALS NOTHING
#ASSERT `s 10(6): the person has a defence to the offence under subsection (5)` TRUE
#ASSERT NOT (`s 10(6): the person has a defence to the offence under subsection (5)` FALSE)
#ASSERT `s 10(7): the Authority may by written notice, without compensation or refund of any fee, cancel the licence or part, suspend it, or reduce its period` TRUE TRUE
#ASSERT NOT (`s 10(7): the Authority may by written notice, without compensation or refund of any fee, cancel the licence or part, suspend it, or reduce its period` TRUE FALSE)
#ASSERT `s 10(7)(a) to (c): the Authority has taken a step open to it` TRUE
#ASSERT `s 10(8): the person is liable to pay the financial penalty, recoverable by the Authority as a debt` TRUE FALSE
#ASSERT `s 10(8): the person is liable to pay the financial penalty, recoverable by the Authority as a debt` TRUE TRUE

