IMPORT prelude
IMPORT `sgta-nouns`
IMPORT `sgta-s5-licence-terms`
IMPORT `sgta-s6-8-spectrum-orbit-designation`
IMPORT `sgta-s9-10-conditions-and-sanctions`
IMPORT `sgta-s11-14-approval-and-residual`

-- LAYER-1 TESTS for Part 2 of the Act (ss 5 to 14), the modules not covered by sgta-tests-s2-s5.l4.
-- Expected values are written by hand from the quoted text.  Each threshold is tested on both sides: 28 days (s 9(2)), 14 days (s 89 in another file),
-- the 10% turnover figure against $1 million (ss 6(13)(f), 10(1)(f)).

§ `s 5(2) to (9)`

#ASSERT `s 5(2)(a): the licensee is required to enter into the agreement or arrangement` TRUE TRUE FALSE FALSE
#ASSERT `s 5(2)(a): the licensee is required to enter into the agreement or arrangement` TRUE FALSE FALSE TRUE
#ASSERT NOT (`s 5(2)(a): the licensee is required to enter into the agreement or arrangement` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`s 5(2)(a): the licensee is required to enter into the agreement or arrangement` FALSE TRUE FALSE FALSE)
#ASSERT `s 5(2)(a): the terms and conditions of the agreement or arrangement are` TRUE EQUALS "as agreed by the licensee and the other persons or licensees"
#ASSERT `s 5(2)(a): the terms and conditions of the agreement or arrangement are` FALSE EQUALS "as determined by the Authority, in default of agreement"
#ASSERT `s 5(2)(b): the licensee is required to share and trade radio frequency spectrum` TRUE
#ASSERT NOT (`s 5(2)(b): the licensee is required to share and trade radio frequency spectrum` FALSE)
#ASSERT `s 5(2)(c): the licensee must comply with the Authority's direction` TRUE TRUE
#ASSERT NOT (`s 5(2)(c): the licensee must comply with the Authority's direction` TRUE FALSE)
#ASSERT `s 5(2)(d): the licensee must comply with the code of practice or standard of performance` TRUE TRUE
#ASSERT NOT (`s 5(2)(d): the licensee must comply with the code of practice or standard of performance` FALSE TRUE)
#ASSERT `s 5(2)(e): the licensee must do, or must not do, the thing` TRUE TRUE
#ASSERT NOT (`s 5(2)(e): the licensee must do, or must not do, the thing` TRUE FALSE)
#ASSERT `s 5(3): the grant of the licence is effective as to payment` TRUE
#ASSERT NOT (`s 5(3): the grant of the licence is effective as to payment` FALSE)
#ASSERT `s 5(4): the licensee must pay this other or periodic fee to the Authority` TRUE FALSE
#ASSERT `s 5(4): the licensee must pay this other or periodic fee to the Authority` FALSE TRUE
#ASSERT NOT (`s 5(4): the licensee must pay this other or periodic fee to the Authority` FALSE FALSE)
#ASSERT NOT (`s 5(5)(a): the fee must bear a relationship to the cost of granting or administering the licence` TRUE)
#ASSERT `s 5(5)(b): the Authority may recover the fee from the licensee as a debt due to the Authority` TRUE
#ASSERT `s 5(6): the licensee is entitled to the refund of a fee paid under subsection (3) or (4)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 5(6): the licensee is entitled to the refund of a fee paid under subsection (3) or (4)` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 5(6): the licensee is entitled to the refund of a fee paid under subsection (3) or (4)` FALSE FALSE EQUALS NOTHING
#ASSERT NOT (`s 5(7): the validity of the licence may be impugned on the ground that it was granted without the Minister's consent` TRUE)
#ASSERT NOT (`s 5(9): section 5 prevents the Minister from giving the direction` TRUE)

§ `s 6 Power to grant spectrum right`

#ASSERT `s 6(1): the Authority may grant the spectrum right` TRUE
#ASSERT NOT (`s 6(1): the Authority may grant the spectrum right` FALSE)
#ASSERT `s 6(1)(a): the spectrum right is held subject to this condition` TRUE
#ASSERT NOT (`s 6(1)(a): the spectrum right is held subject to this condition` FALSE)
#ASSERT `s 6(1)(b): the spectrum right is revocable` TRUE
#ASSERT `s 6(2): the spectrum right may be granted to this grantee` TRUE
#ASSERT `s 6(3): the Authority may specify this for the grant of a spectrum right` TRUE TRUE TRUE
#ASSERT NOT (`s 6(3): the Authority may specify this for the grant of a spectrum right` TRUE FALSE TRUE)
#ASSERT NOT (`s 6(3): the Authority may specify this for the grant of a spectrum right` TRUE TRUE FALSE)
#ASSERT `s 6(4): the Authority may use this method to determine the grant of a spectrum right` "auction"
#ASSERT `s 6(4): the Authority may use this method to determine the grant of a spectrum right` "tender"
#ASSERT `s 6(4): the Authority may use this method to determine the grant of a spectrum right` "allocation of the spectrum right in exchange for fees or charges determined or negotiated by the Authority"
#ASSERT NOT (`s 6(4): the Authority may use this method to determine the grant of a spectrum right` "lottery")
#ASSERT `s 6(5): the grant of the spectrum right is effective as to payment` TRUE
#ASSERT `s 6(6): the holder must pay this fee or charge to the Authority` TRUE TRUE
#ASSERT NOT (`s 6(6): the holder must pay this fee or charge to the Authority` TRUE FALSE)
#ASSERT `s 6(7): the Authority may recover the fee or charge as a debt due to it` TRUE
#ASSERT NOT (`s 6(8): the validity of the spectrum right may be impugned on the ground that it was granted without the Minister's consent` TRUE)
#ASSERT `s 6(9): a spectrum right is granted` TRUE
#ASSERT NOT (`s 6(10): section 6 prevents the Minister from giving the direction` TRUE)
#ASSERT `s 6(11): the act is not an infringement of the privilege conferred by section 3` TRUE
#ASSERT `s 6(12): the Authority may give this direction to the person` TRUE TRUE
#ASSERT NOT (`s 6(12): the Authority may give this direction to the person` FALSE TRUE)
#ASSERT `s 6(13)(a) to (e): the Authority may by regulations made under section 97 provide for this matter` "the variation of the conditions of the grant of a spectrum right"
#ASSERT NOT (`s 6(13)(a) to (e): the Authority may by regulations made under section 97 provide for this matter` "the sale of a spectrum right to a foreign state")
#ASSERT `s 6(13)(f): the most the financial penalty may be for breach of a condition of the grant or of a direction, in dollars` 5000000 EQUALS 1000000
#ASSERT `s 6(13)(f): the most the financial penalty may be for breach of a condition of the grant or of a direction, in dollars` 10000000 EQUALS 1000000
#ASSERT `s 6(13)(f): the most the financial penalty may be for breach of a condition of the grant or of a direction, in dollars` 10000010 EQUALS 1000001
#ASSERT `s 6(13)(f): the most the financial penalty may be for breach of a condition of the grant or of a direction, in dollars` 20000000 EQUALS 2000000

