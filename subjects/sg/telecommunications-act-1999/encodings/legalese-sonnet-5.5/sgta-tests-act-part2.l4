#ASSERT `s 7(2)(b)(iv): the licensee must do, or refrain from doing, the thing` TRUE TRUE
#ASSERT NOT (`s 7(2)(b)(iv): the licensee must do, or refrain from doing, the thing` FALSE TRUE)
#ASSERT `s 7(3): the grant of the licence is effective as to payment` TRUE
#ASSERT `s 7(4): the licensee must pay this other or periodic fee to the Authority` TRUE FALSE
#ASSERT `s 7(4): the licensee must pay this other or periodic fee to the Authority` FALSE TRUE
#ASSERT NOT (`s 7(4): the licensee must pay this other or periodic fee to the Authority` FALSE FALSE)
#ASSERT NOT (`s 7(5)(a): the fee must bear a relationship to the cost of granting or administering the licence` TRUE)
#ASSERT `s 7(5)(b): the Authority may recover the fee from the licensee as a debt due to the Authority` TRUE
#ASSERT `s 7(6): the licensee is entitled to the refund of a fee paid under subsection (3) or (4)` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 7(6): the licensee is entitled to the refund of a fee paid under subsection (3) or (4)` FALSE FALSE EQUALS NOTHING
#ASSERT NOT (`s 7(7): the validity of the licence may be impugned on the ground that it was granted without the Minister's consent` TRUE)
