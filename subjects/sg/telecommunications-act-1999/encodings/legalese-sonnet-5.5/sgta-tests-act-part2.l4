#ASSERT `s 7(1): the Authority may grant a licence for the use of a satellite orbital slot` TRUE
#ASSERT `s 7(1)(b): the licence for the satellite orbital slot is revocable` TRUE
#ASSERT `s 7(2)(a): the licence may be granted to this grantee` TRUE
