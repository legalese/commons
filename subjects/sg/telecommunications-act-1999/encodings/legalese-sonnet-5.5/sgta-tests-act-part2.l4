#ASSERT NOT (`s 11(4): the approval applies to the equipment or system for the purposes specified in the approval` TRUE FALSE)
#ASSERT `s 11(5): the approval may include this condition` TRUE
#ASSERT `s 11(6): the Authority or other person may charge a fee for the test or assessment` TRUE
