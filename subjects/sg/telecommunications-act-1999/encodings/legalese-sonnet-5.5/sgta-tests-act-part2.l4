#ASSERT NOT (`s 13(6): the rate, charge or fee continues to be valid as though determined by the Authority` TRUE TRUE)
#ASSERT NOT (`s 13(6): the rate, charge or fee continues to be valid as though determined by the Authority` FALSE FALSE)
