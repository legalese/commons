#ASSERT NOT (`s 9(2): the notice is as the Authority must give before modifying the licence conditions` TRUE TRUE TRUE 27)
#ASSERT NOT (`s 9(2): the notice is as the Authority must give before modifying the licence conditions` TRUE TRUE FALSE 30)
#ASSERT NOT (`s 9(2): the notice is as the Authority must give before modifying the licence conditions` FALSE TRUE TRUE 30)
