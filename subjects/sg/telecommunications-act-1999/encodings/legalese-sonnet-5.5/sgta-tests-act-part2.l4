#ASSERT `s 11(7): the public telecommunication licensee may cease or refuse to supply the telecommunication service to the person` TRUE FALSE TRUE
#ASSERT NOT (`s 11(7): the public telecommunication licensee may cease or refuse to supply the telecommunication service to the person` FALSE TRUE TRUE)
