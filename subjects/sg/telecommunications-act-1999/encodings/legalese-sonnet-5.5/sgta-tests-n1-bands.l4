#ASSERT `N 1 Schedule: the authorised radio frequency bands and the maximum approved field strength or power for item n, on the date` (Date 16 10 2001) 16 EQUALS NOTHING
#ASSERT `N 1 Schedule: the authorised radio frequency bands and the maximum approved field strength or power for item n, on the date` (Date 17 10 2001) 16 EQUALS JUST (LIST "76.00-77.00 GHz: 5W EIRP for vehicle in motion 250 mW EIRP for stationary vehicle")
