#ASSERT `Rg 5 reg 30(2) (from 1 June 2006): the condition of the Ship Station Licence is met` (Date 1 6 2006) FALSE EQUALS JUST FALSE
#ASSERT `Rg 5 reg 34(2) (from 1 June 2006): the condition of the Aircraft Station Licence is met` (Date 1 6 2006) TRUE EQUALS JUST TRUE
#ASSERT `Rg 5 reg 34(2) (from 1 June 2006): the condition of the Aircraft Station Licence is met` (Date 31 5 2006) TRUE EQUALS NOTHING
#ASSERT `Rg 5 reg 39(2) (deemed in operation from 1 May 2006): the fee to sit the Radio Amateur Examination in dollars` (Date 30 4 2006) TRUE EQUALS NOTHING
#ASSERT `Rg 5 reg 39(2) (deemed in operation from 1 May 2006): the fee to sit the Radio Amateur Examination in dollars` (Date 1 5 2006) TRUE EQUALS JUST 20
#ASSERT `Rg 5 reg 39(2) (deemed in operation from 1 May 2006): the fee to sit the Radio Amateur Examination in dollars` (Date 1 5 2006) FALSE EQUALS JUST 40
#ASSERT `Rg 5 Second Schedule: the Schedule is in force on the date (deleted from 1 May 2006)` (Date 30 4 2006)
#ASSERT NOT (`Rg 5 Second Schedule: the Schedule is in force on the date (deleted from 1 May 2006)` (Date 1 5 2006))
#ASSERT `Rg 5 reg 63A(1) (from 1 June 2006): the Authority may by written notice cancel the Ship Station Licence or Aircraft Station Licence` (Date 1 6 2006) TRUE EQUALS JUST TRUE
#ASSERT `Rg 5 reg 63A(1) (from 1 June 2006): the Authority may by written notice cancel the Ship Station Licence or Aircraft Station Licence` (Date 31 5 2006) TRUE EQUALS NOTHING
#ASSERT `Rg 5 reg 63A(2) (from 1 June 2006): the Authority refunds any part of the fee for the unexpired period of a licence cancelled under reg 63A(1)` (Date 1 6 2006) EQUALS JUST FALSE
#ASSERT `Rg 5 First Schedule Part IA (from 1 June 2006): the fee for a Ship Station Licence or an Aircraft Station Licence` (Date 1 6 2006) TRUE EQUALS JUST (`A fee for a period` OF 100, 5)
#ASSERT `Rg 5 First Schedule Part IA (from 1 June 2006): the fee for a Ship Station Licence or an Aircraft Station Licence` (Date 31 5 2006) TRUE EQUALS NOTHING

