#ASSERT (NOT (`s 98(1): the scheme, contract, document, licence, permission or resolution continues as the Authority's` TRUE TRUE FALSE))
#ASSERT (NOT (`s 98(1): the scheme, contract, document, licence, permission or resolution continues as the Authority's` TRUE FALSE TRUE))
#ASSERT `s 98(2): the subsidiary legislation continues in force as if made under the Act` TRUE TRUE FALSE FALSE
#ASSERT (NOT (`s 98(2): the subsidiary legislation continues in force as if made under the Act` TRUE FALSE FALSE FALSE))
#ASSERT (NOT (`s 98(2): the subsidiary legislation continues in force as if made under the Act` TRUE TRUE TRUE FALSE))
