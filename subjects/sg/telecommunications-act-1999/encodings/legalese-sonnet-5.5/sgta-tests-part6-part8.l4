§ `Part 8: ss 84 to 88`

-- s 84(1): compounded for a sum not exceeding $5,000, by an authorised officer, for a prescribed offence
#ASSERT `s 84(1): the offence may be compounded for this sum` 5000 TRUE TRUE
#ASSERT (NOT (`s 84(1): the offence may be compounded for this sum` 5001 TRUE TRUE))
#ASSERT (NOT (`s 84(1): the offence may be compounded for this sum` 5000 FALSE TRUE))
#ASSERT (NOT (`s 84(1): the offence may be compounded for this sum` 5000 TRUE FALSE))
-- the order of arguments: sum, prescribed, officer
#ASSERT `s 84(2): the offence is prescribed as a compoundable offence` TRUE
#ASSERT (NOT (`s 84(2): the offence is prescribed as a compoundable offence` FALSE))
-- s 85: the general penalty applies where no penalty is expressly provided; an express penalty is not displaced
#ASSERT `s 85: the penalty for an offence under the Act` NOTHING EQUALS `the general penalty`
#ASSERT `s 85: the penalty for an offence under the Act` (JUST (`s 53(2): the penalty`)) EQUALS `Penalty` OF 100000, 36, 10000, FALSE
#ASSERT `s 85: the penalty for an offence under the Act` NOTHING EQUALS `Penalty` OF 10000, 36, 1000, TRUE
-- s 86: other written laws; no punishment twice
#ASSERT `s 86: the person may be prosecuted under the other written law` TRUE FALSE
#ASSERT (NOT (`s 86: the person may be prosecuted under the other written law` TRUE TRUE))
#ASSERT (NOT (`s 86: the person may be prosecuted under the other written law` FALSE FALSE))
#ASSERT `s 87: the court may hear the offence and impose the full penalty` TRUE
#ASSERT (NOT (`s 87: the court may hear the offence and impose the full penalty` FALSE))
-- s 88: unless the officer proves BOTH no consent or connivance AND due diligence
#ASSERT `s 88: the officer or partner is guilty of the offence` TRUE TRUE FALSE FALSE
#ASSERT `s 88: the officer or partner is guilty of the offence` TRUE TRUE TRUE FALSE
#ASSERT `s 88: the officer or partner is guilty of the offence` TRUE TRUE FALSE TRUE
#ASSERT (NOT (`s 88: the officer or partner is guilty of the offence` TRUE TRUE TRUE TRUE))
#ASSERT (NOT (`s 88: the officer or partner is guilty of the offence` FALSE TRUE FALSE FALSE))
#ASSERT (NOT (`s 88: the officer or partner is guilty of the offence` TRUE FALSE FALSE FALSE))

