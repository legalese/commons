#ASSERT (NOT (`s 95: the Act does not apply to the licensing of this apparatus` TRUE FALSE TRUE))
#ASSERT (NOT (`s 95: the Act does not apply to the licensing of this apparatus` FALSE FALSE FALSE))
#ASSERT `s 96: the provision does not apply to the person` TRUE
#ASSERT (NOT (`s 96: the provision does not apply to the person` FALSE))
