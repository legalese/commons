IMPORT prelude
IMPORT `gras-authority`

-- Gambling Regulatory Authority of Singapore Act 2022, ss 2, 8, 11, 16, 18, 20, 23, 25, 34, 35, 43, 44 and 46 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_gambling-regulatory-authority-of-singapore-act-2022.py). Expected results were written by
-- hand from the text.

`a retired accountant` MEANS Candidate WITH
    `undischarged bankrupt or in an arrangement with creditors` IS FALSE
    `a Judge or judicial officer` IS FALSE
    `longest single prison sentence in months` IS 0
    `has a free pardon` IS FALSE
    `disqualified as a company director` IS FALSE
    `lacks capacity or is under a mental health order` IS FALSE

`an undischarged bankrupt` MEANS Candidate WITH
    `undischarged bankrupt or in an arrangement with creditors` IS TRUE
    `a Judge or judicial officer` IS FALSE
    `longest single prison sentence in months` IS 0
    `has a free pardon` IS FALSE
    `disqualified as a company director` IS FALSE
    `lacks capacity or is under a mental health order` IS FALSE

`a district judge` MEANS Candidate WITH
    `undischarged bankrupt or in an arrangement with creditors` IS FALSE
    `a Judge or judicial officer` IS TRUE
    `longest single prison sentence in months` IS 0
    `has a free pardon` IS FALSE
    `disqualified as a company director` IS FALSE
    `lacks capacity or is under a mental health order` IS FALSE

`a person once jailed for exactly 6 months` MEANS Candidate WITH
    `undischarged bankrupt or in an arrangement with creditors` IS FALSE
    `a Judge or judicial officer` IS FALSE
    `longest single prison sentence in months` IS 6
    `has a free pardon` IS FALSE
    `disqualified as a company director` IS FALSE
    `lacks capacity or is under a mental health order` IS FALSE

`a person once jailed for 5 months` MEANS Candidate WITH
    `undischarged bankrupt or in an arrangement with creditors` IS FALSE
    `a Judge or judicial officer` IS FALSE
    `longest single prison sentence in months` IS 5
    `has a free pardon` IS FALSE
    `disqualified as a company director` IS FALSE
    `lacks capacity or is under a mental health order` IS FALSE

`a person jailed for 2 years and pardoned` MEANS Candidate WITH
    `undischarged bankrupt or in an arrangement with creditors` IS FALSE
    `a Judge or judicial officer` IS FALSE
    `longest single prison sentence in months` IS 24
    `has a free pardon` IS TRUE
    `disqualified as a company director` IS FALSE
    `lacks capacity or is under a mental health order` IS FALSE

§ `s 2`

#ASSERT `the activity is one of the listed kinds of gambling` `buying a lottery ticket` FALSE
#ASSERT `the activity is one of the listed kinds of gambling` `playing a card game that mixes chance and skill` FALSE
#ASSERT `the activity is one of the listed kinds of gambling` `placing a bet on a football match` FALSE
#ASSERT NOT `the activity is one of the listed kinds of gambling` `playing a game of pure skill for a prize` FALSE
#ASSERT NOT `the activity is one of the listed kinds of gambling` `placing a bet on a football match` TRUE

§ `s 8`

#ASSERT `misusing the Authority's symbol is an offence` TRUE FALSE FALSE
#ASSERT NOT `misusing the Authority's symbol is an offence` TRUE TRUE FALSE
#ASSERT `misusing the Authority's symbol is an offence` FALSE FALSE TRUE
#ASSERT `misusing the Authority's symbol is an offence` FALSE TRUE TRUE

#ASSERT `the maximum fine for misusing the symbol` 0 EQUALS 10000
#ASSERT `the maximum fine for misusing the symbol` 10 EQUALS 12500

§ `s 11`

#ASSERT NOT `the candidate is disqualified from membership` `a retired accountant`
#ASSERT `the candidate is disqualified from membership` `an undischarged bankrupt`
#ASSERT `the candidate is disqualified from membership` `a district judge`
#ASSERT `the candidate is disqualified from membership` `a person once jailed for exactly 6 months`
#ASSERT NOT `the candidate is disqualified from membership` `a person once jailed for 5 months`
#ASSERT NOT `the candidate is disqualified from membership` `a person jailed for 2 years and pardoned`

§ `ss 16, 18, 20`

#ASSERT `the term of office in years` 2 EQUALS 2
#ASSERT `the term of office in years` 5 EQUALS 3

#ASSERT `the day the resignation takes effect` 100 0 EQUALS 100
#ASSERT `the day the resignation takes effect` 100 130 EQUALS 130

#ASSERT `the member loses the seat for absence` 3 FALSE
#ASSERT NOT `the member loses the seat for absence` 3 TRUE

