#ASSERT `the person is shielded from personal liability` TRUE TRUE TRUE
#ASSERT NOT `the person is shielded from personal liability` TRUE TRUE FALSE

§ `s 43`

#ASSERT `the most that may be collected to compound` 10000 EQUALS 2000
#ASSERT `the most that may be collected to compound` 2000 EQUALS 1000
#ASSERT `the most that may be collected to compound` 4000 EQUALS 2000

#ASSERT NOT `the offence may be compounded` FALSE

