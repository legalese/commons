IMPORT prelude
IMPORT `epha-cleaning-wages`

-- Environmental Public Health Act 1987, ss 2, 80D, 80E, 80H, 80J, 80K -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- THE WAGE FIGURES BELOW ARE ILLUSTRATIVE. The Commissioner for Labour's order under s 80H(2)(a) was not deposited; $3,000
-- and $3,200 and every date are made up to exercise the encoding. They are not the order in force in 2056 or at any time.
-- Expected results were written by hand from the text.

§ `Fixtures`

`a resident general cleaner` MEANS Worker WITH
    `performs cleaning work for someone other than the employer` IS TRUE
    `supervises such cleaning work` IS FALSE
    `declared a cleaner by the Minister` IS FALSE
    `is a citizen or permanent resident` IS TRUE
    `works under a cleaning contract made before the effective date` IS FALSE

`a resident cleaner on an older cleaning contract` MEANS Worker WITH
    `performs cleaning work for someone other than the employer` IS TRUE
    `supervises such cleaning work` IS FALSE
    `declared a cleaner by the Minister` IS FALSE
    `is a citizen or permanent resident` IS TRUE
    `works under a cleaning contract made before the effective date` IS TRUE

`a foreign general cleaner` MEANS Worker WITH
    `performs cleaning work for someone other than the employer` IS TRUE
    `supervises such cleaning work` IS FALSE
    `declared a cleaner by the Minister` IS FALSE
    `is a citizen or permanent resident` IS FALSE
    `works under a cleaning contract made before the effective date` IS FALSE

`a resident cleaning supervisor` MEANS Worker WITH
    `performs cleaning work for someone other than the employer` IS FALSE
    `supervises such cleaning work` IS TRUE
    `declared a cleaner by the Minister` IS FALSE
    `is a citizen or permanent resident` IS TRUE
    `works under a cleaning contract made before the effective date` IS FALSE

`a resident office clerk` MEANS Worker WITH
    `performs cleaning work for someone other than the employer` IS FALSE
    `supervises such cleaning work` IS FALSE
    `declared a cleaner by the Minister` IS FALSE
    `is a citizen or permanent resident` IS TRUE
    `works under a cleaning contract made before the effective date` IS FALSE

`a licensed cleaning company` MEANS Business WITH
    `charges a fee or reward for providing cleaning work` IS TRUE
    `cleaners employed under contracts of service` IS 40
    `individuals engaged by any contract to clean` IS 40
    `is a principal contractor engaging such a person` IS FALSE
    `holds a cleaning business licence in force` IS TRUE

`an unlicensed cleaning outfit` MEANS Business WITH
    `charges a fee or reward for providing cleaning work` IS TRUE
    `cleaners employed under contracts of service` IS 5
    `individuals engaged by any contract to clean` IS 5
    `is a principal contractor engaging such a person` IS FALSE
    `holds a cleaning business licence in force` IS FALSE

`a self-employed cleaner` MEANS Business WITH
    `charges a fee or reward for providing cleaning work` IS TRUE
    `cleaners employed under contracts of service` IS 0
    `individuals engaged by any contract to clean` IS 1
    `is a principal contractor engaging such a person` IS FALSE
    `holds a cleaning business licence in force` IS FALSE

`an unlicensed principal contractor` MEANS Business WITH
    `charges a fee or reward for providing cleaning work` IS TRUE
    `cleaners employed under contracts of service` IS 0
    `individuals engaged by any contract to clean` IS 0
    `is a principal contractor engaging such a person` IS TRUE
    `holds a cleaning business licence in force` IS FALSE

`a hotel with in-house cleaners` MEANS Business WITH
    `charges a fee or reward for providing cleaning work` IS FALSE
    `cleaners employed under contracts of service` IS 30
    `individuals engaged by any contract to clean` IS 30
    `is a principal contractor engaging such a person` IS FALSE
    `holds a cleaning business licence in force` IS FALSE

`an illustrative order` MEANS `Wage order` WITH
    `minimum monthly basic wage before the order` IS 3000
    `minimum monthly basic wage under the order` IS 3200
    `effective date` IS 20550701
    `postponed effective date` IS 0

`an illustrative postponed order` MEANS `Wage order` WITH
    `minimum monthly basic wage before the order` IS 3000
    `minimum monthly basic wage under the order` IS 3200
    `effective date` IS 20550701
    `postponed effective date` IS 20560101

§ `REQ-0275 (Jun Hao scenario, j088, 2056)`

-- A resident general cleaner employed by a licensed cleaning business, February 2056, with the s 80H(1)(b) condition
-- prescribed: the floor is whatever the Commissioner's order says for the cleaner's class -- here the illustrative $3,200.
#ASSERT `the lowest monthly basic wage under the Act` TRUE `a licensed cleaning company` `a resident general cleaner` `an illustrative order` 20560201 EQUALS 3200

#ASSERT `where the cleaner's minimum basic wage is written` EQUALS "an order of the Commissioner for Labour under s 80H(2)(a), applied through a licence condition prescribed by regulations under ss 80H(1)(b) and 111"

-- The ledger named s 31AA: that is the waste collection industry. Cleaning is s 80H.
#ASSERT `the section carrying the progressive wage condition for` `general cleaning` EQUALS "80H"
#ASSERT `the section carrying the progressive wage condition for` `waste collection` EQUALS "31AA"

-- The floor binds only for a resident cleaner (citizen or PR), and only if regulations prescribe the condition.
#ASSERT `the lowest monthly basic wage under the Act` TRUE `a licensed cleaning company` `a foreign general cleaner` `an illustrative order` 20560201 EQUALS 0
#ASSERT `the lowest monthly basic wage under the Act` FALSE `a licensed cleaning company` `a resident general cleaner` `an illustrative order` 20560201 EQUALS 0

§ `ss 23A, 2 -- which section; who is a cleaner`

#ASSERT `the section carrying the progressive wage condition for` `waste disposal` EQUALS "23A"
#ASSERT `the worker is a cleaner` `a resident general cleaner` EQUALS TRUE
#ASSERT `the worker is a cleaner` `a resident cleaning supervisor` EQUALS TRUE
#ASSERT `the worker is a cleaner` `a resident office clerk` EQUALS FALSE
#ASSERT `the worker is a resident cleaner` `a foreign general cleaner` EQUALS FALSE

§ `s 80D -- the licence requirement`

#ASSERT `the business is presumed to carry on a cleaning business` `a licensed cleaning company` EQUALS TRUE
#ASSERT `the business is presumed to carry on a cleaning business` `a self-employed cleaner` EQUALS FALSE
#ASSERT `the business is presumed to carry on a cleaning business` `an unlicensed principal contractor` EQUALS TRUE
#ASSERT `the business is presumed to carry on a cleaning business` `a hotel with in-house cleaners` EQUALS FALSE
#ASSERT `the business is presumed to be in breach of section 80D` `an unlicensed cleaning outfit` EQUALS TRUE
#ASSERT `the business is presumed to be in breach of section 80D` `a licensed cleaning company` EQUALS FALSE

-- $10,000; plus $1,000 a day continuing after conviction: 30 days gives 10,000 + 30,000 = 40,000.
#ASSERT `the maximum fine under section 80D` 0 EQUALS 10000
#ASSERT `the maximum fine under section 80D` 30 EQUALS 40000
#ASSERT `the maximum imprisonment in months under section 80D` EQUALS 12

§ `s 80E -- engaging an unlicensed cleaning business`

#ASSERT `A is liable under section 80E` TRUE FALSE FALSE EQUALS TRUE
#ASSERT `A is liable under section 80E` TRUE FALSE TRUE EQUALS FALSE
#ASSERT `A is liable under section 80E` TRUE TRUE FALSE EQUALS FALSE
-- 10,000 + 5 x 1,000 = 15,000.
#ASSERT `the maximum fine under section 80E` 5 EQUALS 15000

§ `s 80H -- the order's effective date and postponement`

#ASSERT `the lowest monthly basic wage under the Act` TRUE `a licensed cleaning company` `a resident general cleaner` `an illustrative order` 20550630 EQUALS 3000
#ASSERT `the lowest monthly basic wage under the Act` TRUE `a licensed cleaning company` `a resident general cleaner` `an illustrative order` 20550701 EQUALS 3200
#ASSERT `the date the order binds for` `an illustrative postponed order` `a resident cleaner on an older cleaning contract` EQUALS 20560101
#ASSERT `the lowest monthly basic wage under the Act` TRUE `a licensed cleaning company` `a resident cleaner on an older cleaning contract` `an illustrative postponed order` 20551201 EQUALS 3000
#ASSERT `the lowest monthly basic wage under the Act` TRUE `a licensed cleaning company` `a resident cleaner on an older cleaning contract` `an illustrative postponed order` 20560201 EQUALS 3200
#ASSERT `the lowest monthly basic wage under the Act` TRUE `a licensed cleaning company` `a resident general cleaner` `an illustrative postponed order` 20551201 EQUALS 3200
#ASSERT `the lowest monthly basic wage under the Act` TRUE `an unlicensed cleaning outfit` `a resident general cleaner` `an illustrative order` 20560201 EQUALS 0

§ `s 80H(6) -- collective agreements; compliance`

#ASSERT `the lowest basic wage allowing for a collective agreement` 3200 2800 EQUALS 3200
#ASSERT `the lowest basic wage allowing for a collective agreement` 3200 3500 EQUALS 3500
#ASSERT `the basic wage complies with the condition` 3200 3200 EQUALS TRUE
#ASSERT `the basic wage complies with the condition` 3199 3200 EQUALS FALSE

§ `ss 80J, 80K -- sanctions`

#ASSERT `the Director-General may revoke or suspend for a basic-wage breach` TRUE 7 EQUALS TRUE
#ASSERT `the Director-General may revoke or suspend for a basic-wage breach` FALSE 7 EQUALS FALSE
#ASSERT `the Director-General may revoke or suspend for a basic-wage breach` TRUE 2 EQUALS FALSE
#ASSERT `the Director-General may revoke or suspend for a basic-wage breach` TRUE 15 EQUALS FALSE
#ASSERT `the maximum financial penalty under section 80K` EQUALS 5000
#ASSERT `the longest suspension in months under section 80J` EQUALS 6
