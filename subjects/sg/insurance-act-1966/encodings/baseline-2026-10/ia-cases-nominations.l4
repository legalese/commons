IMPORT prelude
IMPORT `ia-nominations`

-- Insurance Act 1966, ss 131-133 and 150 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_insurance-act-1966_baseline.py). Expected results were written by
-- hand from the text.

§ `s 131, s 132(1) -- relevant policy`

`my whole-life policy` MEANS `My policy` WITH
    `a life policy or an accident and health policy` IS TRUE
    `issued by a licensed insurer` IS TRUE
    `governed by Singapore law` IS TRUE
    `provides death benefits` IS TRUE
    `insures my own life` IS TRUE
    `held on a trust under s 73 of the Conveyancing and Law of Property Act` IS FALSE
    `an annuity bought with my CPF retirement sum` IS FALSE
    `issued under the Dependants' Protection Insurance Scheme` IS FALSE
    `a CPF investment I must repay into the CPF` IS FALSE
    `of a kind the Authority has prescribed out of s 132` IS FALSE

`my policy governed by English law` MEANS `My policy` WITH
    `a life policy or an accident and health policy` IS TRUE
    `issued by a licensed insurer` IS TRUE
    `governed by Singapore law` IS FALSE
    `provides death benefits` IS TRUE
    `insures my own life` IS TRUE
    `held on a trust under s 73 of the Conveyancing and Law of Property Act` IS FALSE
    `an annuity bought with my CPF retirement sum` IS FALSE
    `issued under the Dependants' Protection Insurance Scheme` IS FALSE
    `a CPF investment I must repay into the CPF` IS FALSE
    `of a kind the Authority has prescribed out of s 132` IS FALSE

`my Dependants' Protection Insurance Scheme cover` MEANS `My policy` WITH
    `a life policy or an accident and health policy` IS TRUE
    `issued by a licensed insurer` IS TRUE
    `governed by Singapore law` IS TRUE
    `provides death benefits` IS TRUE
    `insures my own life` IS TRUE
    `held on a trust under s 73 of the Conveyancing and Law of Property Act` IS FALSE
    `an annuity bought with my CPF retirement sum` IS FALSE
    `issued under the Dependants' Protection Insurance Scheme` IS TRUE
    `a CPF investment I must repay into the CPF` IS FALSE
    `of a kind the Authority has prescribed out of s 132` IS FALSE

#ASSERT `Is my policy a relevant policy` `my whole-life policy`
#ASSERT NOT `Is my policy a relevant policy` `my policy governed by English law`

#ASSERT NOT `Can my policy carry a trust nomination` `my Dependants' Protection Insurance Scheme cover`

§ `ss 132(2)-(3), 133(1)-(3) -- valid nominations`

`my wife, half` MEANS Nominee WITH
    `who` IS "my wife"
    `my spouse` IS TRUE
    `my child` IS FALSE
    `portion in percent` IS 50
    `died before me` IS FALSE

`my son, half` MEANS Nominee WITH
    `who` IS "my son"
    `my spouse` IS FALSE
    `my child` IS TRUE
    `portion in percent` IS 50
    `died before me` IS FALSE

`my son, forty` MEANS Nominee WITH
    `who` IS "my son"
    `my spouse` IS FALSE
    `my child` IS TRUE
    `portion in percent` IS 40
    `died before me` IS FALSE

`my brother, half` MEANS Nominee WITH
    `who` IS "my brother"
    `my spouse` IS FALSE
    `my child` IS FALSE
    `portion in percent` IS 50
    `died before me` IS FALSE

`a trust nomination of my wife and son` MEANS `My nomination` WITH
    `kind` IS `a trust nomination`
    `nominees` IS LIST `my wife, half`, `my son, half`
    `my age when I nominated` IS 40
    `I expressed an intention to create a trust of the policy moneys` IS TRUE
    `made in the prescribed manner, giving each nominee's portion` IS TRUE
    `an earlier trust nomination of mine on this policy still stands` IS FALSE

`a trust nomination of my wife and brother` MEANS `My nomination` WITH
    `kind` IS `a trust nomination`
    `nominees` IS LIST `my wife, half`, `my brother, half`
    `my age when I nominated` IS 40
    `I expressed an intention to create a trust of the policy moneys` IS TRUE
    `made in the prescribed manner, giving each nominee's portion` IS TRUE
    `an earlier trust nomination of mine on this policy still stands` IS FALSE

`a trust nomination of 90 percent` MEANS `My nomination` WITH
    `kind` IS `a trust nomination`
    `nominees` IS LIST `my wife, half`, `my son, forty`
    `my age when I nominated` IS 40
    `I expressed an intention to create a trust of the policy moneys` IS TRUE
    `made in the prescribed manner, giving each nominee's portion` IS TRUE
    `an earlier trust nomination of mine on this policy still stands` IS FALSE

`a revocable nomination of my wife and brother` MEANS `My nomination` WITH
    `kind` IS `a revocable nomination`
    `nominees` IS LIST `my wife, half`, `my brother, half`
    `my age when I nominated` IS 40
    `I expressed an intention to create a trust of the policy moneys` IS FALSE
    `made in the prescribed manner, giving each nominee's portion` IS TRUE
    `an earlier trust nomination of mine on this policy still stands` IS FALSE

`a revocable nomination over a standing trust nomination` MEANS `My nomination` WITH
    `kind` IS `a revocable nomination`
    `nominees` IS LIST `my wife, half`, `my brother, half`
    `my age when I nominated` IS 40
    `I expressed an intention to create a trust of the policy moneys` IS FALSE
    `made in the prescribed manner, giving each nominee's portion` IS TRUE
    `an earlier trust nomination of mine on this policy still stands` IS TRUE

#ASSERT `Is my nomination valid` `my whole-life policy` `a trust nomination of my wife and son`
#ASSERT NOT `Is my nomination valid` `my whole-life policy` `a trust nomination of my wife and brother`
#ASSERT NOT `Is my nomination valid` `my whole-life policy` `a trust nomination of 90 percent`
#ASSERT `Is my nomination valid` `my whole-life policy` `a revocable nomination of my wife and brother`
#ASSERT NOT `Is my nomination valid` `my whole-life policy` `a revocable nomination over a standing trust nomination`

§ `s 132(4)-(5) -- creditors`

#ASSERT `What can my creditors take from my trust policy moneys` `my whole-life policy` `a trust nomination of my wife and son` TRUE 30000 EQUALS (JUST 30000)
#ASSERT `What can my creditors take from my trust policy moneys` `my whole-life policy` `a revocable nomination of my wife and brother` TRUE 30000 EQUALS NOTHING

§ `s 132(7) -- revoking a trust nomination`

#ASSERT `Whose written consent do I need to revoke my trust nomination` TRUE FALSE EQUALS `an outside trustee, or else every adult nominee and a parent or guardian of every minor nominee`
#ASSERT `Whose written consent do I need to revoke my trust nomination` TRUE TRUE EQUALS `an outside trustee`
#ASSERT `Whose written consent do I need to revoke my trust nomination` FALSE FALSE EQUALS `every adult nominee and a parent or guardian of every minor nominee`
#ASSERT `Whose written consent do I need to revoke my trust nomination` FALSE TRUE EQUALS `no one is named, only the prescribed requirements`

#ASSERT NOT `May I revoke my trust nomination` TRUE TRUE FALSE TRUE TRUE
#ASSERT `May I revoke my trust nomination` FALSE TRUE FALSE FALSE TRUE

§ `s 133(5)-(7) -- deemed revocation and redistribution`

#ASSERT `Is my revocable nomination deemed revoked` FALSE TRUE FALSE FALSE
#ASSERT NOT `Is my revocable nomination deemed revoked` FALSE FALSE FALSE FALSE

`my wife, sixty` MEANS Nominee WITH
    `who` IS "my wife"
    `my spouse` IS TRUE
    `my child` IS FALSE
    `portion in percent` IS 60
    `died before me` IS FALSE

`my son, twenty, died before me` MEANS Nominee WITH
    `who` IS "my son"
    `my spouse` IS FALSE
    `my child` IS TRUE
    `portion in percent` IS 20
    `died before me` IS TRUE

`my daughter, twenty` MEANS Nominee WITH
    `who` IS "my daughter"
    `my spouse` IS FALSE
    `my child` IS TRUE
    `portion in percent` IS 20
    `died before me` IS FALSE

`my son, forty, died before me` MEANS Nominee WITH
    `who` IS "my son"
    `my spouse` IS FALSE
    `my child` IS TRUE
    `portion in percent` IS 40
    `died before me` IS TRUE

`three nominees, the son dead` MEANS LIST `my wife, sixty`, `my son, twenty, died before me`, `my daughter, twenty`

`two nominees, the son dead` MEANS LIST `my wife, sixty`, `my son, forty, died before me`

