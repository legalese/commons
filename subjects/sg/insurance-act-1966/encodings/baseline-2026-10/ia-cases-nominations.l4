#ASSERT `Is the nominee treated as having died before me` FALSE TRUE TRUE TRUE EQUALS NOTHING

§ `s 133(8)-(9) -- where the death benefits go`

#ASSERT `Where will my death benefits go` TRUE FALSE FALSE FALSE FALSE EQUALS `to my nominees, on the trust my nomination created`
#ASSERT `Where will my death benefits go` FALSE TRUE FALSE TRUE FALSE EQUALS `as my last nomination says`
#ASSERT `Where will my death benefits go` FALSE TRUE TRUE TRUE FALSE EQUALS `as my last will says`
#ASSERT `Where will my death benefits go` FALSE TRUE TRUE FALSE FALSE EQUALS `under the Intestate Succession Act 1967`

§ `s 150 -- payment without probate`

`a notified trust nomination with an outside trustee` MEANS `What my insurer knows when I die` WITH
    `a trust nomination of mine stands unrevoked` IS TRUE
    `a revocable nomination of mine stands, not deemed revoked` IS FALSE
    `the insurer has written notice of that nomination` IS TRUE
    `a trustee of the policy moneys is someone other than me` IS TRUE
    `I made a nomination at all` IS TRUE
    `I made a will disposing of all death benefits with the prescribed particulars` IS FALSE
    `that will is unrevoked` IS FALSE
    `the insurer has written notice of that will signed by me` IS FALSE
    `the insurer has written notice of any nomination or such will` IS TRUE
    `circumstances the Authority has prescribed exist` IS FALSE

`a notified will and no nomination` MEANS `What my insurer knows when I die` WITH
    `a trust nomination of mine stands unrevoked` IS FALSE
    `a revocable nomination of mine stands, not deemed revoked` IS FALSE
    `the insurer has written notice of that nomination` IS FALSE
    `a trustee of the policy moneys is someone other than me` IS FALSE
    `I made a nomination at all` IS FALSE
    `I made a will disposing of all death benefits with the prescribed particulars` IS TRUE
    `that will is unrevoked` IS TRUE
    `the insurer has written notice of that will signed by me` IS TRUE
    `the insurer has written notice of any nomination or such will` IS TRUE
    `circumstances the Authority has prescribed exist` IS FALSE

`no nomination and no will` MEANS `What my insurer knows when I die` WITH
    `a trust nomination of mine stands unrevoked` IS FALSE
    `a revocable nomination of mine stands, not deemed revoked` IS FALSE
    `the insurer has written notice of that nomination` IS FALSE
    `a trustee of the policy moneys is someone other than me` IS FALSE
    `I made a nomination at all` IS FALSE
    `I made a will disposing of all death benefits with the prescribed particulars` IS FALSE
    `that will is unrevoked` IS FALSE
    `the insurer has written notice of that will signed by me` IS FALSE
    `the insurer has written notice of any nomination or such will` IS FALSE
    `circumstances the Authority has prescribed exist` IS FALSE

`a revocable nomination never notified` MEANS `What my insurer knows when I die` WITH
    `a trust nomination of mine stands unrevoked` IS FALSE
    `a revocable nomination of mine stands, not deemed revoked` IS TRUE
    `the insurer has written notice of that nomination` IS FALSE
    `a trustee of the policy moneys is someone other than me` IS FALSE
    `I made a nomination at all` IS TRUE
    `I made a will disposing of all death benefits with the prescribed particulars` IS FALSE
    `that will is unrevoked` IS FALSE
    `the insurer has written notice of that will signed by me` IS FALSE
    `the insurer has written notice of any nomination or such will` IS FALSE
    `circumstances the Authority has prescribed exist` IS FALSE

`a notified nomination later deemed revoked and no will` MEANS `What my insurer knows when I die` WITH
    `a trust nomination of mine stands unrevoked` IS FALSE
    `a revocable nomination of mine stands, not deemed revoked` IS FALSE
    `the insurer has written notice of that nomination` IS FALSE
    `a trustee of the policy moneys is someone other than me` IS FALSE
    `I made a nomination at all` IS TRUE
    `I made a will disposing of all death benefits with the prescribed particulars` IS FALSE
    `that will is unrevoked` IS FALSE
    `the insurer has written notice of that will signed by me` IS FALSE
    `the insurer has written notice of any nomination or such will` IS TRUE
    `circumstances the Authority has prescribed exist` IS FALSE

#ASSERT `Whom may my insurer pay without probate when I die` `a notified trust nomination with an outside trustee` EQUALS `the outside trustee, for every nominee`
#ASSERT `Whom may my insurer pay without probate when I die` `a notified will and no nomination` EQUALS `an executor of my will, up to the whole death benefits`
#ASSERT `Whom may my insurer pay without probate when I die` `no nomination and no will` EQUALS `any proper claimant, within the prescribed aggregate`
#ASSERT `Whom may my insurer pay without probate when I die` `a revocable nomination never notified` EQUALS `any proper claimant, within the prescribed aggregate`
#ASSERT `Whom may my insurer pay without probate when I die` `a notified nomination later deemed revoked and no will` EQUALS `no one: probate or letters of administration are needed`

#ASSERT `Is this claimant a proper claimant` `my nephew or niece`
#ASSERT `Is this claimant a proper claimant` `my child born outside marriage`
#ASSERT NOT `Is this claimant a proper claimant` `my grandchild`

#ASSERT `How much may a proper claimant be paid without probate` 2 100000 300000 150000 EQUALS 50000
#ASSERT `How much may a proper claimant be paid without probate` 2 20000 50000 150000 EQUALS 60000
