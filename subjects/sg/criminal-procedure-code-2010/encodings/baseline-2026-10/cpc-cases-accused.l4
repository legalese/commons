§ `s 2(1) -- arrestable and bailable`

#ASSERT `Is my offence arrestable` TRUE FALSE
#ASSERT NOT `Is my offence arrestable` FALSE FALSE

#ASSERT `Is my offence bailable` FALSE TRUE

§ `ss 7, 8, 9 -- which State Court may try me`

#ASSERT `May a Magistrate's Court try me` `a 3-year offence` FALSE
#ASSERT NOT `May a Magistrate's Court try me` `a 7-year offence` FALSE
#ASSERT NOT `May a Magistrate's Court try me` `an offence punishable with death` FALSE
#ASSERT `May a Magistrate's Court try me` `a fine-only offence` FALSE
#ASSERT `May a Magistrate's Court try me` `a 10-year offence the Schedule gives to a Magistrate's Court` FALSE
#ASSERT `May a Magistrate's Court try me` `a 7-year offence` TRUE

#ASSERT `May a District Court try me` `a 15-year offence the Schedule gives to a District Court` FALSE
#ASSERT NOT `May a District Court try me` `a 20-year offence` FALSE
#ASSERT NOT `May a District Court try me` `an offence punishable with life imprisonment` FALSE
#ASSERT `May a District Court try me` `a 20-year offence` TRUE
#ASSERT NOT `May a District Court try me` `an offence punishable with death` TRUE

