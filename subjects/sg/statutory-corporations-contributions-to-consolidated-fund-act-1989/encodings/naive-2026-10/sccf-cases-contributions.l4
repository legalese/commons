IMPORT prelude
IMPORT `sccf-contributions`

-- Statutory Corporations (Contributions to Consolidated Fund) Act 1989, ss 2, 3, 4 and the Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_statutory-corporations-contributions-to-consolidated-fund-act-1989.py). Expected results were written by
-- hand from the text.

`a board with a surplus` MEANS `Accounts for a financial year` WITH
    `moneys received or accruing, not on trust` IS 100
    `moneys received subject to a trust` IS 50
    `expenses properly incurred in its functions` IS 70
    `other expenses` IS 20
    `funds and reserves, not for trust moneys` IS 500
    `funds created to account for trust moneys` IS 300
    `amount the Minister opines it requires` IS 400

`a board in deficit` MEANS `Accounts for a financial year` WITH
    `moneys received or accruing, not on trust` IS 60
    `moneys received subject to a trust` IS 0
    `expenses properly incurred in its functions` IS 80
    `other expenses` IS 0
    `funds and reserves, not for trust moneys` IS 200
    `funds created to account for trust moneys` IS 0
    `amount the Minister opines it requires` IS 250

`a board holding mostly trust money` MEANS `Accounts for a financial year` WITH
    `moneys received or accruing, not on trust` IS 10
    `moneys received subject to a trust` IS 1000
    `expenses properly incurred in its functions` IS 10
    `other expenses` IS 0
    `funds and reserves, not for trust moneys` IS 40
    `funds created to account for trust moneys` IS 5000
    `amount the Minister opines it requires` IS 0

`a board that overspent improperly` MEANS `Accounts for a financial year` WITH
    `moneys received or accruing, not on trust` IS 100
    `moneys received subject to a trust` IS 0
    `expenses properly incurred in its functions` IS 60
    `other expenses` IS 50
    `funds and reserves, not for trust moneys` IS 0
    `funds created to account for trust moneys` IS 0
    `amount the Minister opines it requires` IS 0

§ `s 2 and the Schedule`

#ASSERT `is a specified statutory corporation` `Central Provident Fund Board`
#ASSERT `is a specified statutory corporation` `Housing and Development Board`
#ASSERT `is a specified statutory corporation` `Monetary Authority of Singapore`
#ASSERT `is a specified statutory corporation` `Council for Estate Agencies`
#ASSERT `is a specified statutory corporation` `Singapore Medical Council`
#ASSERT `is a specified statutory corporation` `Singapore Totalisator Board`
#ASSERT `is a specified statutory corporation` `Communicable Diseases Agency`
#ASSERT `is a specified statutory corporation` `Skills and Workforce Development Agency`
#ASSERT NOT `is a specified statutory corporation` `National Library Board`
#ASSERT NOT `is a specified statutory corporation` `People's Association`
#ASSERT NOT `is a specified statutory corporation` `Nanyang Technological University`
#ASSERT NOT `is a specified statutory corporation` `a private company`

#ASSERT `the Act under which it is established` `Council for Estate Agencies` EQUALS "Estate Agents Act 2010"
#ASSERT `the Act under which it is established` `Competition and Consumer Commission of Singapore` EQUALS "Competition Act 2004"
#ASSERT `the Act under which it is established` `Singapore Medical Council` EQUALS "Medical Registration Act 1997"
#ASSERT `the Act under which it is established` `Housing and Development Board` EQUALS "Housing and Development Act 1959"
#ASSERT `the Act under which it is established` `Singapore Dental Council` EQUALS "Dental Registration Act 1999"
#ASSERT `the Act under which it is established` `a private company` EQUALS "not in the Schedule"

§ `s 2 -- revenue, expenditure and funds`

#ASSERT `its revenue` `a board with a surplus` EQUALS 100
#ASSERT `its revenue` `a board holding mostly trust money` EQUALS 10

#ASSERT `its expenditure` `a board with a surplus` EQUALS 70
#ASSERT `its expenditure` `a board that overspent improperly` EQUALS 60

#ASSERT `its funds` `a board holding mostly trust money` EQUALS 40

§ `s 3 -- the two limbs`

#ASSERT `the most that may be required under limb (a)` `a board with a surplus` EQUALS 30
#ASSERT `the most that may be required under limb (a)` `a board in deficit` EQUALS 0
#ASSERT `the most that may be required under limb (a)` `a board holding mostly trust money` EQUALS 0
#ASSERT `the most that may be required under limb (a)` `a board that overspent improperly` EQUALS 40

#ASSERT `the most that may be required under limb (b)` `a board with a surplus` EQUALS 100
#ASSERT `the most that may be required under limb (b)` `a board in deficit` EQUALS 0
#ASSERT `the most that may be required under limb (b)` `a board holding mostly trust money` EQUALS 40
#ASSERT `the most that may be required under limb (b)` `a board that overspent improperly` EQUALS 0

