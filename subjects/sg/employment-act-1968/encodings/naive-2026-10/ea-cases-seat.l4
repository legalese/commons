IMPORT prelude
IMPORT `ea-part2`
IMPORT `ea-part2-continuity`
IMPORT `ea-part3-salary`
IMPORT `ea-part4-hours`
IMPORT `ea-part9-maternity`
IMPORT `ea-part10-leave`
IMPORT `ea-part12-records`
IMPORT `ea-part12-retrenchment`
IMPORT `ea-retrenchment-reporting-notification`
IMPORT `ea-seat`

-- Employment Act 1968 -- the seat layer, worked cases.
--
-- SEAT: the employee. Every case and every expected value below is copied
-- from the existing case files (ea-part2-cases.l4, ea-parts-3-and-4-cases.l4,
-- ea-parts-5-to-12-cases.l4, ea-retrenchment-reporting-notification-cases.l4),
-- where they were hand-checked. Nothing is computed afresh here.
--
-- Since 21 October 2026 the seat questions take plain inputs, in the order the
-- employee is asked them, so each case passes the facts directly rather than
-- through record fixtures. The facts and the answers are the ones the record
-- fixtures held before: for example "a mean contract of 1 day" for "ten years
-- in" is now TRUE 1 (the contract sets 1 day) followed by TRUE TRUE TRUE (26
-- weeks, 2 years, 5 years); wages of $2,000 in the s 29 cases, a basic day's
-- pay of $100 and $12.50 an hour in the s 37 cases. The seats take the Act's
-- own figures (0.25; $4,500 and $2,600; the 14 days of s 95A), as the
-- fixtures did.

§ `Notice, and leaving the job`

-- The contract's 1 day is void for a ten-year employee: 28 days. Lawful for a
-- new starter: 1 day. A generous 60 days stands.
#ASSERT `How many days of notice am I owed` TRUE 1 TRUE TRUE TRUE EQUALS 28
#ASSERT `How many days of notice am I owed` TRUE 1 FALSE FALSE FALSE EQUALS 1
#ASSERT `How many days of notice am I owed` TRUE 60 TRUE TRUE TRUE EQUALS 60

#ASSERT `How much must I be paid in lieu of notice` TRUE 1 TRUE TRUE TRUE 200 EQUALS 5600
#ASSERT `How much must I be paid in lieu of notice` FALSE 0 FALSE FALSE FALSE 200 EQUALS 200

#ASSERT (NOT (`Am I treated as having broken my contract by being absent` 2 FALSE FALSE FALSE))
#ASSERT `Am I treated as having broken my contract by being absent` 3 FALSE FALSE FALSE
#ASSERT (NOT (`Am I treated as having broken my contract by being absent` 10 FALSE TRUE TRUE))
#ASSERT `Am I treated as having broken my contract by being absent` 10 FALSE TRUE FALSE

#ASSERT `May I leave without notice because of danger` TRUE TRUE TRUE TRUE FALSE
#ASSERT (NOT (`May I leave without notice because of danger` TRUE FALSE TRUE TRUE FALSE))
#ASSERT (NOT (`May I leave without notice because of danger` TRUE TRUE TRUE TRUE TRUE))

§ `Dismissal and suspension`

#ASSERT `Can my employer dismiss me without notice for misconduct` TRUE TRUE
#ASSERT (NOT (`Can my employer dismiss me without notice for misconduct` TRUE FALSE))

#ASSERT `Is my suspension without pay lawful` TRUE TRUE TRUE 7
#ASSERT (NOT (`Is my suspension without pay lawful` TRUE TRUE TRUE 8))

#ASSERT `Can I claim for wrongful dismissal` TRUE TRUE FALSE TRUE
#ASSERT (NOT (`Can I claim for wrongful dismissal` TRUE TRUE FALSE FALSE))
#ASSERT `Can I claim for wrongful dismissal` TRUE FALSE FALSE FALSE
#ASSERT `Can I claim for wrongful dismissal` FALSE TRUE FALSE FALSE

#ASSERT `Am I barred from a retrenchment benefit by my short service` TRUE 1.5
#ASSERT (NOT (`Am I barred from a retrenchment benefit by my short service` TRUE 2))

§ `Being paid`

#ASSERT `Was I paid late` `dismissal by the employer` 4
#ASSERT (NOT (`Was I paid late` `dismissal by the employer` 3))
#ASSERT (NOT (`Was I paid late` `termination by the employee without notice` 7))

#ASSERT `Can my employer make this deduction from my salary` `absence from work` FALSE FALSE
#ASSERT `Can my employer make this deduction from my salary` `house accommodation supplied by the employer` TRUE FALSE
#ASSERT (NOT (`Can my employer make this deduction from my salary` `house accommodation supplied by the employer` TRUE TRUE))

#ASSERT `Can my employer deduct this amount for damage or loss I caused` 900 2000 400 FALSE TRUE
#ASSERT (NOT (`Can my employer deduct this amount for damage or loss I caused` 900 2000 600 FALSE TRUE))
#ASSERT (NOT (`Can my employer deduct this amount for damage or loss I caused` 900 2000 10 FALSE FALSE))

§ `Hours, rest days and overtime`

#ASSERT `Do the rest day, hours and overtime rules cover me` TRUE FALSE 4500
#ASSERT (NOT (`Do the rest day, hours and overtime rules cover me` TRUE FALSE 4501))
#ASSERT (NOT (`Do the rest day, hours and overtime rules cover me` FALSE TRUE 1000))

#ASSERT `What must I be paid for working on my rest day` TRUE 4 FALSE 0 100 12.5 EQUALS 50
#ASSERT `What must I be paid for working on my rest day` TRUE 10 FALSE 0 100 12.5 EQUALS 137.5
#ASSERT `What must I be paid for working on my rest day` FALSE 10 FALSE 0 100 12.5 EQUALS 237.5

#ASSERT `What is my overtime pay` 2 12.5 EQUALS 37.5

§ `Leave`

#ASSERT `How many days of annual leave do I get` 12 1 12 FALSE EQUALS 7
#ASSERT `How many days of annual leave do I get` 2 0 2 FALSE EQUALS 0
#ASSERT `How many days of annual leave do I get` 24 2 12 TRUE EQUALS 0
#ASSERT `How many days of annual leave do I get` 6 1 6 FALSE EQUALS 4

#ASSERT `How many days of paid sick leave can I take` 6 TRUE FALSE 0 EQUALS 14
#ASSERT `How many days of paid sick leave can I take` 6 TRUE TRUE 10 EQUALS 24
#ASSERT `How many days of paid sick leave can I take` 6 TRUE TRUE 100 EQUALS 60
#ASSERT `How many days of paid sick leave can I take` 36 FALSE FALSE 0 EQUALS 0

§ `Maternity`

#ASSERT `Am I entitled to be paid during my maternity benefit period` TRUE 3 FALSE
#ASSERT (NOT (`Am I entitled to be paid during my maternity benefit period` TRUE 2 FALSE))
#ASSERT (NOT (`Am I entitled to be paid during my maternity benefit period` TRUE 12 TRUE))

#ASSERT `How much maternity pay do I get` `the default -- 4 weeks before and 8 weeks after` TRUE 3 100 FALSE EQUALS 5600
#ASSERT `How much maternity pay do I get` `the default -- 4 weeks before and 8 weeks after` TRUE 2 100 FALSE EQUALS 0

#ASSERT `Is the notice of dismissal I was given during my maternity absence unlawful` TRUE TRUE FALSE
#ASSERT `Is the notice of dismissal I was given during my maternity absence unlawful` TRUE FALSE TRUE
#ASSERT (NOT (`Is the notice of dismissal I was given during my maternity absence unlawful` TRUE FALSE FALSE))

§ `What my employer must give me or report`

#ASSERT (NOT (`Has my employer failed to give me my key employment terms in time` TRUE TRUE TRUE 14))
#ASSERT `Has my employer failed to give me my key employment terms in time` TRUE TRUE TRUE 15
#ASSERT (NOT (`Has my employer failed to give me my key employment terms in time` FALSE TRUE FALSE 0))

#ASSERT `Must my employer report my retrenchment to the Commissioner` TRUE FALSE 0 40 TRUE TRUE 1806
#ASSERT (NOT (`Must my employer report my retrenchment to the Commissioner` TRUE FALSE 0 9 TRUE TRUE 1806))
