IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea2-part-12-returns`

-- Tests for ea2-part-12-returns.l4 (Employment Act 1968, ss 97 to 102).  Expected values were decided from the
-- text before the functions were run.

§ `Tests -- ss 97 to 99`

#ASSERT `s 97(1) the employer must furnish the particulars and information prescribed in the return` TRUE EQUALS JUST TRUE
#ASSERT `s 97(1) the employer must furnish the particulars and information prescribed in the return` FALSE EQUALS NOTHING
#ASSERT `s 97(2) the person is bound to furnish the particulars or information` FALSE EQUALS JUST FALSE
#ASSERT `s 97(2) the person is bound to furnish the particulars or information` TRUE EQUALS NOTHING
#ASSERT `s 98(1) the employer is required to furnish the fuller or further returns` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 98(1) the employer is required to furnish the fuller or further returns` TRUE FALSE EQUALS NOTHING
#ASSERT `s 98(1) the employer is required to furnish the fuller or further returns` FALSE TRUE EQUALS NOTHING
#ASSERT `s 99 the person must complete and deliver the return, or attend and produce the books, documents, accounts and returns, as the notice requires` TRUE EQUALS JUST TRUE
#ASSERT `s 99 the person must complete and deliver the return, or attend and produce the books, documents, accounts and returns, as the notice requires` FALSE EQUALS NOTHING

§ `Tests -- s 101 the offence`

-- (a): wilful refusal is enough; neglect is an offence unless a lawful excuse is proved (the proof lies on the employer)
#ASSERT `s 101(1)(a) the employer is guilty of an offence` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 101(1)(a) the employer is guilty of an offence` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 101(1)(a) the employer is guilty of an offence` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 101(1)(a) the employer is guilty of an offence` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 101(1)(a) the employer is guilty of an offence` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 101(1)(b) the employer is guilty of an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 101(1)(b) the employer is guilty of an offence` FALSE EQUALS NOTHING
#ASSERT `s 101(1)(c) the employer is guilty of an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 101(1)(c) the employer is guilty of an offence` FALSE EQUALS NOTHING
#ASSERT `s 101(1) the employer is guilty of an offence` (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 101(1) the employer is guilty of an offence` NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 101(1) the employer is guilty of an offence` NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 101(1) the employer is guilty of an offence` NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 101(1) the penalty on conviction` EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 6
#ASSERT `s 101(1) the greatest further fine for a continuing offence` 0 EQUALS 0
#ASSERT `s 101(1) the greatest further fine for a continuing offence` 10 EQUALS 5000
-- false on 1 June, true on 4 June: 1, 2 and 3 June, 3 days; still false on 11 June asked about: 10 days
#ASSERT `s 101(1) the days a false-particulars offence is deemed to continue` (Date 1 6 2026) (JUST (Date 4 6 2026)) (Date 20 6 2026) EQUALS 3
#ASSERT `s 101(1) the days a false-particulars offence is deemed to continue` (Date 1 6 2026) NOTHING (Date 11 6 2026) EQUALS 10
#ASSERT `s 101(1) the days a false-particulars offence is deemed to continue` (Date 1 6 2026) (JUST (Date 1 6 2026)) (Date 20 6 2026) EQUALS 0
#ASSERT `s 101(1) the days a false-particulars offence is deemed to continue` (Date 10 6 2026) NOTHING (Date 1 6 2026) EQUALS 0
#ASSERT `s 101(2) the certificate is sufficient prima facie evidence of the facts it states` TRUE EQUALS JUST TRUE
#ASSERT `s 101(2) the certificate is sufficient prima facie evidence of the facts it states` FALSE EQUALS NOTHING
#ASSERT `s 101(3) subsections (1) and (2) apply to the information` TRUE EQUALS JUST FALSE
#ASSERT `s 101(3) subsections (1) and (2) apply to the information` FALSE EQUALS NOTHING

§ `Tests -- s 102 secrecy of returns`

#ASSERT `s 102(1) the return or answer may be published` FALSE EQUALS JUST FALSE
#ASSERT `s 102(1) the return or answer may be published` TRUE EQUALS NOTHING
#ASSERT `s 102(1) the person may be permitted to see the individual return` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 102(1) the person may be permitted to see the individual return` TRUE FALSE EQUALS NOTHING
#ASSERT `s 102(1) the person may be permitted to see the individual return` FALSE TRUE EQUALS NOTHING
#ASSERT `s 102(2) the person must make the declaration in the prescribed form` TRUE EQUALS JUST TRUE
#ASSERT `s 102(2) the person must make the declaration in the prescribed form` FALSE EQUALS NOTHING
#ASSERT `s 102(2) the person is guilty of an offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 102(2) the person is guilty of an offence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 102(2) the person is guilty of an offence` FALSE TRUE EQUALS NOTHING
#ASSERT `s 102(2) the penalty on conviction` EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 12
#ASSERT `s 102(3) the publication may disclose or arrange the particulars in that way` TRUE EQUALS JUST FALSE
#ASSERT `s 102(3) the publication may disclose or arrange the particulars in that way` FALSE EQUALS NOTHING
#ASSERT `s 102(4) the person is guilty of an offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 102(4) the person is guilty of an offence` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 102(4) the person is guilty of an offence` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 102(4) the penalty on conviction` EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 12
#ASSERT `s 102(5) subsections (1) to (4) apply to the information` TRUE EQUALS JUST FALSE
#ASSERT `s 102(5) subsections (1) to (4) apply to the information` FALSE EQUALS NOTHING

§ `Tests -- the twins that can say no (rulings of 2026-11-05; fork F18, F19)`

-- s 102(1), first limb, with the text's own verb: published without the previous written consent is what the text forbids.
#ASSERT `s 102(1) the return or answer must not be published` FALSE EQUALS JUST TRUE
#ASSERT `s 102(1) the return or answer must not be published` TRUE EQUALS JUST FALSE
-- s 102(1), second limb: not engaged and not for a prosecution is what the text forbids.
#ASSERT `s 102(1) the person must not be permitted to see the individual return` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 102(1) the person must not be permitted to see the individual return` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 102(1) the person must not be permitted to see the individual return` FALSE TRUE EQUALS JUST FALSE
-- s 101(1): the "until" bar.  False particulars furnished on 1 March 2026, true ones on 11 March 2026.
#ASSERT `s 101(1) the false-particulars offence is deemed to continue on the day` (Date 1 3 2026) (JUST (Date 11 3 2026)) (Date 10 3 2026) EQUALS JUST TRUE
#ASSERT `s 101(1) the false-particulars offence is deemed to continue on the day` (Date 1 3 2026) (JUST (Date 11 3 2026)) (Date 11 3 2026) EQUALS JUST FALSE
#ASSERT `s 101(1) the false-particulars offence is deemed to continue on the day` (Date 1 3 2026) (JUST (Date 11 3 2026)) (Date 20 3 2026) EQUALS JUST FALSE
-- the true particulars have not been furnished (or the day is not given): the text does not end the offence.
#ASSERT `s 101(1) the false-particulars offence is deemed to continue on the day` (Date 1 3 2026) NOTHING (Date 20 3 2026) EQUALS JUST TRUE
-- before the false particulars were furnished the text says nothing.
#ASSERT `s 101(1) the false-particulars offence is deemed to continue on the day` (Date 1 3 2026) NOTHING (Date 28 2 2026) EQUALS NOTHING
