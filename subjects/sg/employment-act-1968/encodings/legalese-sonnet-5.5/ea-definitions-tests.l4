IMPORT prelude
IMPORT `ea-core`
IMPORT `ea-definitions`

-- Tests for ea-definitions.l4.
-- Every expected value below was worked out BY HAND from the quoted words of the
-- Act (inputs/EmA1968.txt) and written down before the function was run; none was
-- copied from the function's own output.  The quotation above each group is the
-- sentence the expected values come from.
-- Arguments are positional, in the order of the function's GIVEN; each assertion
-- says in a comment which ones are TRUE when there are more than three.
-- All of these assertions are meant to hold: a failing one is a defect.

§ `Tests of s 2(1) and ss 3(1), 5, 6`

§§ `The three pay terms and wages`

-- One month's pay, every item different, so that a wrong item shows in the sum.
`s 2(1) "basic rate of pay" test pay with every item` MEANS
    `Pay for a period` WITH
        `the amounts are for` IS `Pay is fixed for each month`
        `pay for the work, with wage adjustments and increments` IS 3000
        `overtime payments` IS 200
        `bonus payments or annual wage supplements` IS 500
        `commissions` IS 100
        `productivity incentive payments` IS 150
        `sums paid to reimburse special expenses incurred in the course of employment` IS 80
        `travelling allowances` IS 60
        `food allowances` IS 40
        `housing allowances` IS 300
        `allowances of any other kind` IS 25
        `value of house accommodation, electricity, water, medical attendance or other amenity` IS 11
        `value of a service excluded by order of the Minister` IS 12
        `value of a travelling concession` IS 13
        `employer's contributions on its own account to a pension fund or provident fund` IS 400
        `gratuity payable on discharge or retirement` IS 1000
        `retrenchment benefit payable on retrenchment` IS 2000

`s 2(1) "basic rate of pay" test pay of the work only` MEANS
    `Pay for a period` WITH
        `the amounts are for` IS `Pay is fixed for each day`
        `pay for the work, with wage adjustments and increments` IS 1000
        `overtime payments` IS 0
        `bonus payments or annual wage supplements` IS 0
        `commissions` IS 0
        `productivity incentive payments` IS 0
        `sums paid to reimburse special expenses incurred in the course of employment` IS 0
        `travelling allowances` IS 0
        `food allowances` IS 0
        `housing allowances` IS 0
        `allowances of any other kind` IS 0
        `value of house accommodation, electricity, water, medical attendance or other amenity` IS 0
        `value of a service excluded by order of the Minister` IS 0
        `value of a travelling concession` IS 0
        `employer's contributions on its own account to a pension fund or provident fund` IS 0
        `gratuity payable on discharge or retirement` IS 0
        `retrenchment benefit payable on retrenchment` IS 0

-- Basic: the money for working, less overtime (a), bonus (b), reimbursement (c), productivity incentive (d) and any allowance (e): 3000 + 100 commissions.
-- src:363 | “basic rate of pay” means the total amount of money (including
-- src:364 | wage adjustments and increments) to which an employee is
-- src:365 | entitled under his or her contract of service either for working
-- src:366 | for a period of time, that is, for one hour, one day, one week,
-- src:367 | one month or for such other period as may be stated or
-- src:368 | implied in his or her contract of service, or for each
-- src:369 | completed piece or task of work but does not include —
-- src:371 | (a) additional payments by way of overtime payments;
-- src:373 | (b) additional payments by way of bonus payments or
-- src:374 | annual wage supplements;
-- src:376 | (c) any sum paid to the employee to reimburse him or her
-- src:377 | for special expenses incurred by him or her in the
-- src:378 | course of his or her employment;
-- src:380 | (d) productivity incentive payments; and
-- src:382 | (e) any allowance however described;
#ASSERT `s 2(1) "basic rate of pay" the amount` `s 2(1) "basic rate of pay" test pay with every item` EQUALS 3100
#ASSERT `s 2(1) "basic rate of pay" the amount` `s 2(1) "basic rate of pay" test pay of the work only` EQUALS 1000

-- Gross: the money including allowances, less overtime, bonus, reimbursement, incentive and travelling, food or housing allowances: 3000 + 100 + 25 other allowance.
-- src:483 | “gross rate of pay” means the total amount of money including
-- src:484 | allowances to which an employee is entitled under his or her
-- src:485 | contract of service either for working for a period of time,
-- src:486 | that is, for one hour, one day, one week, one month or for such
-- src:487 | other period as may be stated or implied in his or her contract
-- src:488 | of service, or for each completed piece or task of work but
-- src:489 | does not include —
-- src:494 | (a) additional payments by way of overtime payments;
-- src:496 | (b) additional payments by way of bonus payments or
-- src:497 | annual wage supplements;
-- src:499 | (c) any sum paid to the employee to reimburse him or her
-- src:500 | for special expenses incurred by him or her in the
-- src:501 | course of his or her employment;
-- src:503 | (d) productivity incentive payments; and
-- src:505 | (e) travelling, food or housing allowances;
#ASSERT `s 2(1) "gross rate of pay" the amount` `s 2(1) "basic rate of pay" test pay with every item` EQUALS 3125
#ASSERT `s 2(1) "gross rate of pay" the amount` `s 2(1) "basic rate of pay" test pay of the work only` EQUALS 1000

-- Salary: all remuneration including allowances, less (a) amenity and ordered service, (b) employer's contributions, (c) travelling allowance and concession, (d) reimbursement, (e) gratuity, (f) retrenchment benefit: 3000 + 200 + 500 + 100 + 150 + 40 + 300 + 25.
-- src:605 | “salary” means all remuneration including allowances payable
-- src:606 | to an employee in respect of work done under his or her
-- src:607 | contract of service, but does not include —
-- src:609 | (a) the value of any house accommodation, supply of
-- src:610 | electricity, water, medical attendance, or other
-- src:611 | amenity, or of any service excluded by general or
-- src:612 | special order of the Minister published in the Gazette;
-- src:614 | (b) any contribution paid by the employer on his or her
-- src:615 | own account to any pension fund or provident fund;
-- src:617 | (c) any travelling allowance or the value of any
-- src:618 | travelling concession;
-- src:620 | (d) any sum paid to the employee to reimburse him or her
-- src:621 | for special expenses incurred by him or her in the
-- src:622 | course of his or her employment;
-- src:624 | (e) any gratuity payable on discharge or retirement; and
-- src:626 | (f) any retrenchment benefit payable on retrenchment;
#ASSERT `s 2(1) "salary" the amount` `s 2(1) "basic rate of pay" test pay with every item` EQUALS 4315
#ASSERT `s 2(1) "salary" the amount` `s 2(1) "basic rate of pay" test pay of the work only` EQUALS 1000

-- "wages" means salary.
-- src:672 | “wages” means salary;
#ASSERT `s 2(1) "wages" the amount` `s 2(1) "basic rate of pay" test pay with every item` EQUALS 4315
#ASSERT `s 2(1) "wages" the amount` `s 2(1) "basic rate of pay" test pay of the work only` EQUALS 1000

§§ `productivity incentive payment`

-- Arguments: variable payment to an employee; rewards improvement in performance; rewards increase in productivity or contribution; forms part of regular remuneration.
-- src:582 | “productivity incentive payment” means a variable payment,
-- src:583 | whether made annually or otherwise, to an employee as a
-- src:584 | reward for —
-- src:586 | (a) an improvement to the employee’s performance; or
-- src:588 | Informal Consolidation – version in force from 5/12/2025
-- src:589 | 13 Employment Act 1968 2020 Ed.
-- src:591 | (b) an increase in the employee’s productivity or
-- src:592 | contribution to the employer’s business, trade or
-- src:593 | undertaking,
-- src:595 | but does not include any payment which forms part of the
-- src:596 | employee’s regular remuneration;
#ASSERT `s 2(1) "productivity incentive payment" the payment is one` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 2(1) "productivity incentive payment" the payment is one` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2(1) "productivity incentive payment" the payment is one` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2(1) "productivity incentive payment" the payment is one` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) "productivity incentive payment" the payment is one` FALSE TRUE TRUE FALSE EQUALS JUST FALSE

§§ `day, week, hours of work and overtime`

-- src:423 | “day” means a period of 24 hours beginning at midnight;
#ASSERT `s 2(1) "day" the period is a day` 24 TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) "day" the period is a day` 23 TRUE EQUALS JUST FALSE
#ASSERT `s 2(1) "day" the period is a day` 24 FALSE EQUALS JUST FALSE

-- src:674 | “week” means a continuous period of 7 days;
#ASSERT `s 2(1) "week" the period is a week` 7 TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) "week" the period is a week` 6 TRUE EQUALS JUST FALSE
#ASSERT `s 2(1) "week" the period is a week` 7 FALSE EQUALS JUST FALSE

-- 10 hours at the employer's disposal, 1 hour of it allowed for rest and meals: 9 hours of work.
-- src:507 | “hours of work” means the time during which an employee is at
-- src:508 | the employer’s disposal and is not free to dispose of his or her
-- src:509 | own time and movements exclusive of any intervals allowed
-- src:510 | for rest and meals;
#ASSERT `s 2(1) "hours of work" the number of hours` 10 1 EQUALS 9
#ASSERT `s 2(1) "hours of work" the number of hours` 8 0 EQUALS 8

-- Overtime is the hours worked in excess of the Part 4 limit; the limit is Part 4's answer.
-- src:569 | “overtime” means the number of hours worked in any one day or
-- src:570 | in any one week in excess of the limits specified in Part 4;
#ASSERT `s 2(1) "overtime" the number of hours` 50 (JUST 44) EQUALS JUST 6
#ASSERT `s 2(1) "overtime" the number of hours` 40 (JUST 44) EQUALS JUST 0
#ASSERT `s 2(1) "overtime" the number of hours` 50 NOTHING EQUALS NOTHING

