#ASSERT `s 2(1) "seafarer" the person is one` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) "seafarer" the person is one` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) "seafarer" the person is one` TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) "seafarer" the person is one` TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 2(1) "seafarer" the person is one` FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE

§§ `contractor, principal, subcontractor, subcontractor for labour`

-- Arguments: contracts with a principal; to supply labour or carry out work; the work is undertaken by the principal in the course of or for the purposes of the principal's trade or business.
-- src:418 | “contractor” means any person who contracts with a principal to
-- src:419 | supply labour or to carry out the whole or any part of any
-- src:420 | work undertaken by the principal in the course of or for the
-- src:421 | purposes of the principal’s trade or business;
#ASSERT `s 2(1) "contractor" the person is one` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) "contractor" the person is one` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) "contractor" the person is one` FALSE TRUE TRUE EQUALS JUST FALSE

-- Arguments: acts in the course of or for the purposes of trade or business; contracts with a contractor; the contract is for the supply of labour or the execution of work the person undertook.
-- src:576 | “principal” means any person who, in the course of or for the
-- src:577 | purposes of the person’s trade or business, contracts with a
-- src:578 | contractor for the supply of labour or for the execution by the
-- src:579 | contractor of the whole or any part of any work undertaken by
-- src:580 | the principal;
#ASSERT `s 2(1) "principal" the person is one` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) "principal" the person is one` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 2(1) "principal" the person is one` TRUE FALSE TRUE EQUALS JUST FALSE

-- Arguments: contracts with a contractor for the supply of labour or the execution of the contractor's principal's work; contracts with a subcontractor to supply labour or carry out the subcontractor's work.
-- src:655 | “subcontractor” means any person who contracts with a
-- src:656 | contractor for the supply of labour or for the execution by
-- src:657 | the subcontractor of the whole or any part of any work
-- src:658 | undertaken by the contractor for the contractor’s principal,
-- src:659 | and includes any person who contracts with a subcontractor
-- src:660 | to supply labour or to carry out the whole or any part of any
-- src:661 | work undertaken by the subcontractor for a contractor;
#ASSERT `s 2(1) "subcontractor" the person is one` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2(1) "subcontractor" the person is one` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) "subcontractor" the person is one` FALSE FALSE EQUALS NOTHING

-- Arguments: contracts with a contractor or subcontractor; the contract is to supply the labour required for the work.
-- src:663 | “subcontractor for labour” means any person who contracts with
-- src:664 | a contractor or subcontractor to supply the labour required for
-- src:665 | the execution of the whole or any part of any work a
-- src:666 | contractor or subcontractor has contracted to carry out for a
-- src:667 | principal or contractor, as the case may be;
#ASSERT `s 2(1) "subcontractor for labour" the person is one` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) "subcontractor for labour" the person is one` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 2(1) "subcontractor for labour" the person is one` FALSE TRUE EQUALS JUST FALSE

