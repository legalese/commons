§§ `dependant`

`s 2(1) "dependant" test member who is a wife` MEANS
    `Family member of the employee` WITH
        `relationship` IS `Relationship: the employee's wife`
        `lives with the employee` IS FALSE
        `is dependent on the employee` IS FALSE
        `age in completed years` IS 30

`s 2(1) "dependant" test member who is an adopted child living with the employee` MEANS
    `Family member of the employee` WITH
        `relationship` IS `Relationship: the employee's adopted child`
        `lives with the employee` IS TRUE
        `is dependent on the employee` IS FALSE
        `age in completed years` IS 9

`s 2(1) "dependant" test member who is an adopted child neither living with nor dependent on the employee` MEANS
    `Family member of the employee` WITH
        `relationship` IS `Relationship: the employee's adopted child`
        `lives with the employee` IS FALSE
        `is dependent on the employee` IS FALSE
        `age in completed years` IS 25

`s 2(1) "dependant" test member who is an illegitimate child dependent on the employee` MEANS
    `Family member of the employee` WITH
        `relationship` IS `Relationship: the employee's illegitimate child`
        `lives with the employee` IS FALSE
        `is dependent on the employee` IS TRUE
        `age in completed years` IS 17

`s 2(1) "dependant" test member who is a stepchild` MEANS
    `Family member of the employee` WITH
        `relationship` IS `Relationship: the employee's stepchild`
        `lives with the employee` IS TRUE
        `is dependent on the employee` IS TRUE
        `age in completed years` IS 8

`s 2(1) "dependant" test member who is a child the employee fosters` MEANS
    `Family member of the employee` WITH
        `relationship` IS `Relationship: a child the employee fosters`
        `lives with the employee` IS TRUE
        `is dependent on the employee` IS TRUE
        `age in completed years` IS 8

`s 2(1) "dependant" test member who is a cousin` MEANS
    `Family member of the employee` WITH
        `relationship` IS `Relationship: no relationship the Act names`
        `lives with the employee` IS TRUE
        `is dependent on the employee` IS TRUE
        `age in completed years` IS 40

-- "wife, husband, father, mother, child and any adopted or illegitimate child living with or dependent on the employee"
-- src:425 | “dependant” means any of the following members of an
-- src:426 | employee’s family, namely, wife, husband, father, mother,
-- src:427 | child and any adopted or illegitimate child living with or
-- src:428 | dependent on the employee;
#ASSERT `s 2(1) "dependant" the member of the family is one` `s 2(1) "dependant" test member who is a wife` EQUALS JUST TRUE
#ASSERT `s 2(1) "dependant" the member of the family is one` `s 2(1) "dependant" test member who is an adopted child living with the employee` EQUALS JUST TRUE
#ASSERT `s 2(1) "dependant" the member of the family is one` `s 2(1) "dependant" test member who is an adopted child neither living with nor dependent on the employee` EQUALS JUST FALSE
#ASSERT `s 2(1) "dependant" the member of the family is one` `s 2(1) "dependant" test member who is an illegitimate child dependent on the employee` EQUALS JUST TRUE
#ASSERT `s 2(1) "dependant" the member of the family is one` `s 2(1) "dependant" test member who is a stepchild` EQUALS NOTHING
#ASSERT `s 2(1) "dependant" the member of the family is one` `s 2(1) "dependant" test member who is a child the employee fosters` EQUALS NOTHING
#ASSERT `s 2(1) "dependant" the member of the family is one` `s 2(1) "dependant" test member who is a cousin` EQUALS JUST FALSE

