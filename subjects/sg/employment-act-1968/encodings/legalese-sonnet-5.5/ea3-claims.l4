    WHEN `s 119(1)(f) withdraw the whole claim or a portion of it` THEN JUST TRUE
    WHEN `s 119(1)(f) make a counterclaim` THEN JUST TRUE
    WHEN `s 119(1)(f) reach a settlement in respect of the claim` THEN JUST TRUE
    -- NOTHING-kind (list not closed): paragraph (f) names four things the parties may do and does not say they may do nothing else
    WHEN `s 119(1)(f) a step of some other kind` THEN NOTHING

