#ASSERT `Under section 119(2)(a), is the Commissioner bound to follow formal procedure or the Evidence Act 1893 when hearing my claim` FALSE EQUALS NOTHING
#ASSERT `Under section 119(3), will the hearing of my claim be held in private` TRUE EQUALS JUST TRUE
#ASSERT `Under section 119(3), will the hearing of my claim be held in private` FALSE EQUALS NOTHING

-- s 120 (lines 4873-4892)
-- A member of a recognised trade union, represented by an officer of it.
#ASSERT `Under section 120, may I be represented before the Commissioner by this person` TRUE TRUE FALSE EQUALS JUST TRUE
-- Never by an advocate, solicitor or paid agent.
#ASSERT `Under section 120, may I be represented before the Commissioner by this person` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `Under section 120, may I be represented before the Commissioner by this person` TRUE FALSE TRUE EQUALS JUST FALSE
-- Not in a recognised union: the Act names who a party may be represented by and says nothing of anyone else.
#ASSERT `Under section 120, may I be represented before the Commissioner by this person` FALSE FALSE FALSE EQUALS NOTHING

