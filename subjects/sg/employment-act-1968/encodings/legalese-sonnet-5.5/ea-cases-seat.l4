-- no certificate known: s 68(3) is not shown to apply, so the prohibition stands
#ASSERT `Under section 68, may an employer employ me as a child` 13 `ea2 seat: No` FALSE TRUE `ea2 seat: I am not sure` FALSE FALSE FALSE EQUALS JUST FALSE
-- approved training in a training school: s 72(1) takes it out of s 68, so s 68 does not answer
#ASSERT `Under section 68, may an employer employ me as a child` 14 `ea2 seat: Yes` FALSE FALSE `ea2 seat: No` TRUE TRUE FALSE EQUALS NOTHING
-- 16 is not a child: the section speaks of a child
#ASSERT `Under section 68, may an employer employ me as a child` 16 `ea2 seat: Yes` FALSE FALSE `ea2 seat: No` FALSE FALSE FALSE EQUALS NOTHING
