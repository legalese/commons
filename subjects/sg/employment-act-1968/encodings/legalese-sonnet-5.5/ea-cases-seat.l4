-- Notice on 8 June is 2 days before.
#ASSERT `Under section 119(1)(d), did my employer give notice of its counterclaim against me in time` (Date 8 6 2025) (Date 10 6 2025) TRUE EQUALS JUST FALSE
-- Not in writing, or not stating the nature and amount.
#ASSERT `Under section 119(1)(d), did my employer give notice of its counterclaim against me in time` (Date 7 6 2025) (Date 10 6 2025) FALSE EQUALS JUST FALSE
#ASSERT `Under section 119(1)(i), can the Commissioner decide the claim without me if I do not attend` TRUE TRUE EQUALS JUST TRUE
-- "if any person interested has been duly summoned ... and makes default in so doing" (ruling (b), 2026-11-05): duly summoned but no default.
#ASSERT `Under section 119(1)(i), can the Commissioner decide the claim without me if I do not attend` TRUE FALSE EQUALS JUST FALSE
-- "if any person interested has been duly summoned" (ruling (b), 2026-11-05): not duly summoned.
#ASSERT `Under section 119(1)(i), can the Commissioner decide the claim without me if I do not attend` FALSE TRUE EQUALS JUST FALSE
#ASSERT `Under section 119(1)(j), am I entitled to a copy of the record of my case` TRUE TRUE EQUALS JUST TRUE
-- "Upon payment of the prescribed fee": no copy without it.
#ASSERT `Under section 119(1)(j), am I entitled to a copy of the record of my case` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Under section 119(1)(j), am I entitled to a copy of the record of my case` FALSE TRUE EQUALS NOTHING
