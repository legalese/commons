    IF `how the employment ended` EQUALS `Ending: the employee resigned`
       AND `part of the entitlement to absent herself is still unused when the employment ends`
    THEN JUST TRUE
    -- FALSE-kind (the text says no in its own words): "Where the employment of a female employee is terminated because she resigns before she has exercised"
    ELSE JUST FALSE

@ref s 76(5A)(b) (src:2898-2901)
