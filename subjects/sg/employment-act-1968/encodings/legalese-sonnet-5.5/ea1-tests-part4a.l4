#ASSERT `s 41A(2) the entitlement to be paid for extra work does not apply to the employee` TRUE FALSE EQUALS NOTHING
#ASSERT `s 41A(2) the entitlement to be paid for extra work does not apply to the employee` FALSE TRUE EQUALS NOTHING
#ASSERT `s 41A(3) the employer has displayed the order` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 41A(3) the employer has displayed the order` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 41A(3) the employer has displayed the order` FALSE TRUE EQUALS NOTHING
#TRACE `s 41A(3) the employer's duty to display the order` AT 0 WITH
    PARTY `s 41A(3) the employer` DOES `s 41A(3) display the order or a copy of it conspicuously in the place where the employee or class of employees are employed` AT 2

-- Added with the rulings of 2026-11-05: the provisos to s 38(1) that grant in their own words, and the s 41A(3) duty as a yes/no question.
-- Proviso (c): 7 consecutive hours where the limit is 8 (continuous work with the meal opportunity) is inside the grant; 6 hours is within the general limit, which only forbids more.
#ASSERT `s 38(1)(a) the employee may be required to work the consecutive hours` 7 8 EQUALS JUST TRUE
#ASSERT `s 38(1)(a) the employee may be required to work the consecutive hours` 6 8 EQUALS NOTHING
#ASSERT `s 38(1)(a) the employee may be required to work the consecutive hours` 6 6 EQUALS NOTHING
-- Provisos (d), (e): 8 hours with the limit raised to 9 is the general limit, not the grant.
#ASSERT `s 38(1)(b) the employee may be required to work the hours in the day` 8 (JUST 9) EQUALS NOTHING
#ASSERT `s 38(1)(b) the employee may be required to work the hours in the day` 10 (JUST 9) EQUALS JUST FALSE
-- Proviso (f): 44 hours with the limit raised to 48 is the general limit, not the grant.
#ASSERT `s 38(1)(b) the employee may be required to work the hours in the week` 44 (JUST 48) EQUALS NOTHING
#ASSERT `s 38(1)(b) the employee may be required to work the hours in the week` 49 (JUST 48) EQUALS JUST FALSE
-- s 41A(3): "Where the Commissioner exempts ... or directs ...", the employer must display the order.
#ASSERT `s 41A(3) the employer must display the order` TRUE EQUALS JUST TRUE
#ASSERT `s 41A(3) the employer must display the order` FALSE EQUALS JUST FALSE
