IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea2-part-10-sick`

-- Tests for ea2-part-10-sick.l4 (Employment Act 1968, ss 89 and 90).  Expected values were decided from
-- the text before the functions were run.

§ `Tests -- s 89(1) and (2) the most days in the year`

#ASSERT `s 89(1) the most days of paid sick leave in the year` 6 FALSE 0 EQUALS JUST 14
#ASSERT `s 89(1) the most days of paid sick leave in the year` 24 FALSE 0 EQUALS JUST 14
-- hospitalised: the lesser of 60 and 14 plus the days; 14 + 5 = 19; 14 + 45 = 59; 14 + 46 = 60; 14 + 47 = 61, cut to 60
#ASSERT `s 89(1) the most days of paid sick leave in the year` 6 TRUE 5 EQUALS JUST 19
#ASSERT `s 89(1) the most days of paid sick leave in the year` 6 TRUE 45 EQUALS JUST 59
#ASSERT `s 89(1) the most days of paid sick leave in the year` 6 TRUE 46 EQUALS JUST 60
#ASSERT `s 89(1) the most days of paid sick leave in the year` 6 TRUE 47 EQUALS JUST 60
#ASSERT `s 89(1) the most days of paid sick leave in the year` 5 FALSE 0 EQUALS NOTHING
#ASSERT `s 89(1) the most days of paid sick leave in the year` 5 TRUE 10 EQUALS NOTHING

-- (2)(a) 3 months: 5 days; hospitalised the lesser of 15 and 5 plus the days: 5 + 2 = 7; 5 + 10 = 15; 5 + 11 = 16, cut to 15
#ASSERT `s 89(2)(a) the most days of paid sick leave in the year` 3 FALSE 0 EQUALS JUST 5
#ASSERT `s 89(2)(a) the most days of paid sick leave in the year` 3 TRUE 2 EQUALS JUST 7
#ASSERT `s 89(2)(a) the most days of paid sick leave in the year` 3 TRUE 10 EQUALS JUST 15
#ASSERT `s 89(2)(a) the most days of paid sick leave in the year` 3 TRUE 11 EQUALS JUST 15
#ASSERT `s 89(2)(a) the most days of paid sick leave in the year` 4 FALSE 0 EQUALS NOTHING
#ASSERT `s 89(2)(a) the most days of paid sick leave in the year` 2 FALSE 0 EQUALS NOTHING
-- (2)(b) 4 months: 8 days; 8 + 20 = 28; 8 + 22 = 30; 8 + 23 = 31, cut to 30
#ASSERT `s 89(2)(b) the most days of paid sick leave in the year` 4 FALSE 0 EQUALS JUST 8
#ASSERT `s 89(2)(b) the most days of paid sick leave in the year` 4 TRUE 20 EQUALS JUST 28
#ASSERT `s 89(2)(b) the most days of paid sick leave in the year` 4 TRUE 22 EQUALS JUST 30
#ASSERT `s 89(2)(b) the most days of paid sick leave in the year` 4 TRUE 23 EQUALS JUST 30
#ASSERT `s 89(2)(b) the most days of paid sick leave in the year` 5 FALSE 0 EQUALS NOTHING
#ASSERT `s 89(2)(b) the most days of paid sick leave in the year` 3 FALSE 0 EQUALS NOTHING
-- (2)(c) 5 months: 11 days; 11 + 33 = 44; 11 + 34 = 45; 11 + 35 = 46, cut to 45
#ASSERT `s 89(2)(c) the most days of paid sick leave in the year` 5 FALSE 0 EQUALS JUST 11
#ASSERT `s 89(2)(c) the most days of paid sick leave in the year` 5 TRUE 33 EQUALS JUST 44
#ASSERT `s 89(2)(c) the most days of paid sick leave in the year` 5 TRUE 34 EQUALS JUST 45
#ASSERT `s 89(2)(c) the most days of paid sick leave in the year` 5 TRUE 35 EQUALS JUST 45
#ASSERT `s 89(2)(c) the most days of paid sick leave in the year` 6 FALSE 0 EQUALS NOTHING
#ASSERT `s 89(2)(c) the most days of paid sick leave in the year` 4 FALSE 0 EQUALS NOTHING
-- (2) as a whole picks the right paragraph; at 6 months it is subsection (1)'s case
#ASSERT `s 89(2) the most days of paid sick leave in the year` 2 FALSE 0 EQUALS NOTHING
#ASSERT `s 89(2) the most days of paid sick leave in the year` 3 FALSE 0 EQUALS JUST 5
#ASSERT `s 89(2) the most days of paid sick leave in the year` 4 FALSE 0 EQUALS JUST 8
#ASSERT `s 89(2) the most days of paid sick leave in the year` 5 FALSE 0 EQUALS JUST 11
#ASSERT `s 89(2) the most days of paid sick leave in the year` 5 TRUE 34 EQUALS JUST 45
#ASSERT `s 89(2) the most days of paid sick leave in the year` 6 FALSE 0 EQUALS NOTHING

-- on a certificate: the days certified, within what remains of the aggregate
#ASSERT `s 89 the days of paid sick leave the employee is entitled to on the certificate` 6 TRUE 10 FALSE 0 0 EQUALS JUST 10
#ASSERT `s 89 the days of paid sick leave the employee is entitled to on the certificate` 6 TRUE 10 FALSE 0 10 EQUALS JUST 4
#ASSERT `s 89 the days of paid sick leave the employee is entitled to on the certificate` 6 TRUE 10 FALSE 0 14 EQUALS JUST 0
#ASSERT `s 89 the days of paid sick leave the employee is entitled to on the certificate` 6 TRUE 10 FALSE 0 20 EQUALS JUST 0
#ASSERT `s 89 the days of paid sick leave the employee is entitled to on the certificate` 6 TRUE 20 FALSE 0 0 EQUALS JUST 14
#ASSERT `s 89 the days of paid sick leave the employee is entitled to on the certificate` 3 TRUE 8 FALSE 0 0 EQUALS JUST 5
#ASSERT `s 89 the days of paid sick leave the employee is entitled to on the certificate` 6 FALSE 10 FALSE 0 0 EQUALS NOTHING
#ASSERT `s 89 the days of paid sick leave the employee is entitled to on the certificate` 2 TRUE 3 FALSE 0 0 EQUALS NOTHING

§ `Tests -- s 89(3) hospitalised`

#ASSERT `s 89(3)(a) the employee is hospitalised` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 89(3)(a) the employee is hospitalised` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 89(3)(a) the employee is hospitalised` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 89(3)(b) the employee is to be treated as hospitalised for the period` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 89(3)(b) the employee is to be treated as hospitalised for the period` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 89(3)(b) the employee is to be treated as hospitalised for the period` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 89(3)(b) the employee is to be treated as hospitalised for the period` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 89(3) the employee is hospitalised or treated as hospitalised` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 89(3) the employee is hospitalised or treated as hospitalised` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 89(3) the employee is hospitalised or treated as hospitalised` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 89(3) the employee is hospitalised or treated as hospitalised` (JUST FALSE) NOTHING EQUALS NOTHING
#ASSERT `s 89(3) the employee is hospitalised or treated as hospitalised` NOTHING NOTHING EQUALS NOTHING

§ `Tests -- s 89(4) to (7)`

#ASSERT `s 89(4) the employee is deemed to have absented himself or herself without the employer's permission and without reasonable excuse` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 89(4) the employee is deemed to have absented himself or herself without the employer's permission and without reasonable excuse` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 89(4) the employee is deemed to have absented himself or herself without the employer's permission and without reasonable excuse` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 89(4) the employee is deemed to have absented himself or herself without the employer's permission and without reasonable excuse` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 89(4) the employee is deemed to have absented himself or herself without the employer's permission and without reasonable excuse` TRUE TRUE TRUE EQUALS NOTHING

-- 3 days, hospitalised, $100 a day: $300; not hospitalised and a $10 shift allowance in the rate: 3 x 90 = $270
#ASSERT `s 89(5) the amount the employer must pay for the days of sick leave` 3 TRUE (JUST 100) 10 EQUALS JUST 300
#ASSERT `s 89(5) the amount the employer must pay for the days of sick leave` 3 FALSE (JUST 100) 10 EQUALS JUST 270
#ASSERT `s 89(5) the amount the employer must pay for the days of sick leave` 3 FALSE (JUST 100) 0 EQUALS JUST 300
#ASSERT `s 89(5) the amount the employer must pay for the days of sick leave` 3 TRUE NOTHING 10 EQUALS NOTHING

#ASSERT `s 89(6) the employee is entitled to paid sick leave on the day` `Day: a rest day` EQUALS JUST FALSE
#ASSERT `s 89(6) the employee is entitled to paid sick leave on the day` `Day: a public holiday` EQUALS JUST FALSE
#ASSERT `s 89(6) the employee is entitled to paid sick leave on the day` `Day: a day of paid annual leave` EQUALS JUST FALSE
#ASSERT `s 89(6) the employee is entitled to paid sick leave on the day` `Day: a day the employee is not required to work` EQUALS JUST FALSE
#ASSERT `s 89(6) the employee is entitled to paid sick leave on the day` `Day: a day of no-pay leave` EQUALS JUST FALSE
#ASSERT `s 89(6) the employee is entitled to paid sick leave on the day` `Day: a working day` EQUALS NOTHING
#ASSERT `s 89(6) the employee is entitled to paid sick leave on the day` `Day: a day substituted for a public holiday` EQUALS NOTHING
#ASSERT `s 89(6) the employee is entitled to paid sick leave on the day` `Day: a day of paid sick leave` EQUALS NOTHING
#ASSERT `s 89(6) the employee is entitled to paid sick leave on the day` `Day: a day of childcare leave` EQUALS NOTHING
#ASSERT `s 89(6) the employee is entitled to paid sick leave on the day` `Day: a day within a maternity benefit period` EQUALS NOTHING

#ASSERT `s 89(7) the employee is entitled to paid sick leave for the period` TRUE EQUALS JUST FALSE
#ASSERT `s 89(7) the employee is entitled to paid sick leave for the period` FALSE EQUALS NOTHING

§ `Tests -- s 89(7A) to (10), s 90`

#ASSERT `s 89(7A) the employer is liable to bear or reimburse the fees of the examination` 2 TRUE NOTHING TRUE EQUALS JUST FALSE
#ASSERT `s 89(7A) the employer is liable to bear or reimburse the fees of the examination` 3 TRUE NOTHING TRUE EQUALS JUST TRUE
#ASSERT `s 89(7A) the employer is liable to bear or reimburse the fees of the examination` 3 FALSE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 89(7A) the employer is liable to bear or reimburse the fees of the examination` 3 FALSE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 89(7A) the employer is liable to bear or reimburse the fees of the examination` 3 FALSE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 89(7A) the employer is liable to bear or reimburse the fees of the examination` 3 TRUE NOTHING FALSE EQUALS JUST FALSE
#ASSERT `s 89(7A) the employer is liable to bear or reimburse the fees of the examination` 36 TRUE (JUST TRUE) TRUE EQUALS JUST TRUE

#ASSERT `s 89(8) the employer is deemed to fulfil its obligation under subsection (7A)` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 89(8) the employer is deemed to fulfil its obligation under subsection (7A)` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 89(8) the employer is deemed to fulfil its obligation under subsection (7A)` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 89(8) the employer is deemed to fulfil its obligation under subsection (7A)` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 89(8) the employer is deemed to fulfil its obligation under subsection (7A)` FALSE FALSE FALSE EQUALS JUST FALSE

#ASSERT `s 89(10) section 89 applies to the employee` TRUE EQUALS JUST FALSE
#ASSERT `s 89(10) section 89 applies to the employee` FALSE EQUALS NOTHING

#ASSERT `s 90(1) the employer is guilty of an offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 90(1) the employer is guilty of an offence` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 90(1) the employer is guilty of an offence` FALSE FALSE EQUALS NOTHING
#ASSERT `s 90(1) the penalty on conviction` FALSE EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 0
#ASSERT `s 90(1) the penalty on conviction` TRUE EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 10000, `longest imprisonment in months` IS JUST 12
#ASSERT `s 90(2)(a) the employer and the employees or their trade union may negotiate for and agree to the terms` TRUE EQUALS JUST TRUE
#ASSERT `s 90(2)(a) the employer and the employees or their trade union may negotiate for and agree to the terms` FALSE EQUALS NOTHING
#ASSERT `s 90(2)(b) it is an offence for the employer to grant the terms` TRUE EQUALS JUST FALSE
#ASSERT `s 90(2)(b) it is an offence for the employer to grant the terms` FALSE EQUALS NOTHING

§ `Tests -- the tier twins that can say no (rulings of 2026-11-05; fork F18)`

#ASSERT `s 89(2)(a) this paragraph applies to the employee` 3 EQUALS JUST TRUE
#ASSERT `s 89(2)(a) this paragraph applies to the employee` 4 EQUALS JUST FALSE
#ASSERT `s 89(2)(a) this paragraph applies to the employee` 2 EQUALS JUST FALSE
#ASSERT `s 89(2)(b) this paragraph applies to the employee` 4 EQUALS JUST TRUE
#ASSERT `s 89(2)(b) this paragraph applies to the employee` 5 EQUALS JUST FALSE
#ASSERT `s 89(2)(b) this paragraph applies to the employee` 3 EQUALS JUST FALSE
#ASSERT `s 89(2)(c) this paragraph applies to the employee` 5 EQUALS JUST TRUE
#ASSERT `s 89(2)(c) this paragraph applies to the employee` 6 EQUALS JUST FALSE
#ASSERT `s 89(2)(c) this paragraph applies to the employee` 4 EQUALS JUST FALSE
