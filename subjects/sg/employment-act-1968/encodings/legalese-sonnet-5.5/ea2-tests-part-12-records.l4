IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `sgia-interpretation-time`
IMPORT `ea2-part-12-records`

-- Tests for ea2-part-12-records.l4 (Employment Act 1968, ss 95 to 96A).  Expected values were decided from the
-- text before the functions were run.  Dates were worked out on a calendar (4 May 2026 is a Monday).

§ `Tests -- s 95 employee records (seam S9)`

#ASSERT `s 95(1) the employer must make and keep an employee record for the person` TRUE EQUALS JUST TRUE
#ASSERT `s 95(1) the employer must make and keep an employee record for the person` FALSE EQUALS NOTHING
#ASSERT `s 95(3) the employer is taken to have failed to comply with subsection (1)` TRUE EQUALS JUST TRUE
#ASSERT `s 95(3) the employer is taken to have failed to comply with subsection (1)` FALSE EQUALS JUST FALSE
-- made, kept, with the particulars, complete: the Act does not say the employer failed
#ASSERT `s 95(1) the employer failed to comply` TRUE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 95(1) the employer failed to comply` FALSE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 95(1) the employer failed to comply` TRUE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 95(1) the employer failed to comply` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 95(1) the employer failed to comply` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 95(2) the employer failed to ensure that the employee record is readily accessible` FALSE EQUALS JUST TRUE
#ASSERT `s 95(2) the employer failed to ensure that the employee record is readily accessible` TRUE EQUALS NOTHING
#ASSERT `s 95(5) "employee record" the record is one` TRUE EQUALS JUST TRUE
#ASSERT `s 95(5) "employee record" the record is one` FALSE EQUALS JUST FALSE

§ `Tests -- s 95A the written record of key employment terms (seam S10)`

#ASSERT `s 95A(1) section 95A applies to the employee` (Date 31 3 2016) TRUE EQUALS JUST FALSE
#ASSERT `s 95A(1) section 95A applies to the employee` (Date 1 4 2016) TRUE EQUALS JUST TRUE
#ASSERT `s 95A(1) section 95A applies to the employee` (Date 1 4 2016) FALSE EQUALS JUST FALSE
#ASSERT `s 95A(1) section 95A applies to the employee` (Date 4 5 2026) TRUE EQUALS JUST TRUE

-- 14 days after Monday 4 May 2026 is Monday 18 May
#ASSERT `s 95A(2) the last day for giving the written record of the key employment terms` (Date 4 5 2026) NOTHING EMPTY FALSE EQUALS JUST (Date 18 5 2026)
-- 14 days after Sunday 3 May is Sunday 17 May, carried to Monday 18 May (Interpretation Act s 50(b))
#ASSERT `s 95A(2) the last day for giving the written record of the key employment terms` (Date 3 5 2026) NOTHING EMPTY FALSE EQUALS JUST (Date 18 5 2026)
-- Monday 18 May a public holiday: carried to Tuesday 19 May
#ASSERT `s 95A(2) the last day for giving the written record of the key employment terms` (Date 4 5 2026) NOTHING (LIST Date 18 5 2026) FALSE EQUALS JUST (Date 19 5 2026)
-- a prescribed substitute of 21 days: Monday 25 May
#ASSERT `s 95A(2) the last day for giving the written record of the key employment terms` (Date 4 5 2026) (JUST 21) EMPTY FALSE EQUALS JUST (Date 25 5 2026)
-- a contrary intention in the Act: no last day is given
#ASSERT `s 95A(2) the last day for giving the written record of the key employment terms` (Date 4 5 2026) NOTHING EMPTY TRUE EQUALS NOTHING

#ASSERT `s 95A(5) the employer is taken to have failed to comply with subsection (2)` TRUE EQUALS JUST TRUE
#ASSERT `s 95A(5) the employer is taken to have failed to comply with subsection (2)` FALSE EQUALS JUST FALSE

-- the failure: arguments are the answer of s 95A(1), an exemption, the last day, the day given, incomplete, the day asked about
#ASSERT `s 95A(2) the employer failed to comply` (JUST TRUE) FALSE (JUST (Date 18 5 2026)) (JUST (Date 18 5 2026)) FALSE (Date 1 6 2026) EQUALS NOTHING
#ASSERT `s 95A(2) the employer failed to comply` (JUST TRUE) FALSE (JUST (Date 18 5 2026)) (JUST (Date 19 5 2026)) FALSE (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 95A(2) the employer failed to comply` (JUST TRUE) FALSE (JUST (Date 18 5 2026)) NOTHING FALSE (Date 18 5 2026) EQUALS NOTHING
#ASSERT `s 95A(2) the employer failed to comply` (JUST TRUE) FALSE (JUST (Date 18 5 2026)) NOTHING FALSE (Date 19 5 2026) EQUALS JUST TRUE
#ASSERT `s 95A(2) the employer failed to comply` (JUST TRUE) FALSE (JUST (Date 18 5 2026)) (JUST (Date 10 5 2026)) TRUE (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `s 95A(2) the employer failed to comply` (JUST FALSE) FALSE (JUST (Date 18 5 2026)) (JUST (Date 19 5 2026)) FALSE (Date 1 6 2026) EQUALS NOTHING
#ASSERT `s 95A(2) the employer failed to comply` NOTHING FALSE (JUST (Date 18 5 2026)) (JUST (Date 19 5 2026)) FALSE (Date 1 6 2026) EQUALS NOTHING
#ASSERT `s 95A(2) the employer failed to comply` (JUST TRUE) TRUE (JUST (Date 18 5 2026)) (JUST (Date 19 5 2026)) FALSE (Date 1 6 2026) EQUALS NOTHING
#ASSERT `s 95A(2) the employer failed to comply` (JUST TRUE) FALSE NOTHING NOTHING FALSE (Date 1 6 2026) EQUALS NOTHING

#ASSERT `s 95A(3) the requirement to give a written record is satisfied` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 95A(3) the requirement to give a written record is satisfied` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 95A(3) the requirement to give a written record is satisfied` FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 95A(3) the requirement to give a written record is satisfied` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 95A(3) the requirement to give a written record is satisfied` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 95A(4) subsection (3) limits the manner of giving the record` TRUE EQUALS JUST FALSE
#ASSERT `s 95A(4) subsection (3) limits the manner of giving the record` FALSE EQUALS NOTHING
#ASSERT `s 95A(7) "key employment term" the term is one` TRUE EQUALS JUST TRUE
#ASSERT `s 95A(7) "key employment term" the term is one` FALSE EQUALS JUST FALSE

§ `Tests -- s 96 pay slips (seam S11)`

#ASSERT `s 96(1)(a) the employer failed to give the employee a pay slip` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 96(1)(a) the employer failed to give the employee a pay slip` TRUE TRUE EQUALS NOTHING
#ASSERT `s 96(1)(a) the employer failed to give the employee a pay slip` FALSE FALSE EQUALS NOTHING
#ASSERT `s 96(1)(b) the employer failed to give the employee a pay slip for the sum paid` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 96(1)(b) the employer failed to give the employee a pay slip for the sum paid` TRUE TRUE EQUALS NOTHING
#ASSERT `s 96(1)(b) the employer failed to give the employee a pay slip for the sum paid` FALSE FALSE EQUALS NOTHING
#ASSERT `s 96(4) the employer is taken to have failed to comply with subsection (1)` TRUE EQUALS JUST TRUE
#ASSERT `s 96(4) the employer is taken to have failed to comply with subsection (1)` FALSE EQUALS JUST FALSE
#ASSERT `s 96(2) the pay slip given meets the requirements of form and information` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 96(2) the pay slip given meets the requirements of form and information` TRUE FALSE EQUALS NOTHING
#ASSERT `s 96(2) the pay slip given meets the requirements of form and information` FALSE TRUE EQUALS NOTHING
#ASSERT `s 96(3) the requirement to give a pay slip is satisfied` TRUE EQUALS JUST TRUE
#ASSERT `s 96(3) the requirement to give a pay slip is satisfied` FALSE EQUALS NOTHING
#ASSERT `s 96(1) the employer failed to comply` (JUST TRUE) NOTHING NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 96(1) the employer failed to comply` NOTHING (JUST TRUE) NOTHING FALSE EQUALS JUST TRUE
#ASSERT `s 96(1) the employer failed to comply` NOTHING NOTHING (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 96(1) the employer failed to comply` NOTHING NOTHING NOTHING FALSE EQUALS NOTHING
#ASSERT `s 96(1) the employer failed to comply` (JUST FALSE) (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 96(1) the employer failed to comply` (JUST TRUE) NOTHING NOTHING TRUE EQUALS NOTHING

§ `Tests -- s 96A retrenchment information (seam S12)`

#ASSERT `s 96A the employer failed to comply with a requirement in the notification` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 96A the employer failed to comply with a requirement in the notification` (JUST TRUE) (JUST TRUE) EQUALS NOTHING
#ASSERT `s 96A the employer failed to comply with a requirement in the notification` (JUST FALSE) (JUST FALSE) EQUALS NOTHING
#ASSERT `s 96A the employer failed to comply with a requirement in the notification` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 96A the employer failed to comply with a requirement in the notification` NOTHING (JUST FALSE) EQUALS NOTHING
