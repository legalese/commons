IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea2-notification`

-- Tests for ea2-notification.l4 (Employment (Retrenchment Reporting) Notification 2019, S 200/2019).  Expected values were
-- decided from the text before the functions were run.  Dates were worked out on a calendar: 4 November 2026 is a Wednesday,
-- 7 November a Saturday, 8 November a Sunday, 9 November a Monday.

§ `Tests -- paras 1 and 2 definitions`

#ASSERT NOT (`S 200/2019 para 1 the Notification is in operation on the day` (Date 31 3 2019))
#ASSERT `S 200/2019 para 1 the Notification is in operation on the day` (Date 1 4 2019)
#ASSERT `S 200/2019 para 2(1) "retrench" the termination is a retrenchment` TRUE TRUE EQUALS JUST TRUE
#ASSERT `S 200/2019 para 2(1) "retrench" the termination is a retrenchment` TRUE FALSE EQUALS JUST FALSE
#ASSERT `S 200/2019 para 2(1) "retrench" the termination is a retrenchment` FALSE TRUE EQUALS JUST FALSE
#ASSERT `S 200/2019 para 2(1) "retrenchment report" the report is one` TRUE TRUE EQUALS JUST TRUE
#ASSERT `S 200/2019 para 2(1) "retrenchment report" the report is one` TRUE FALSE EQUALS JUST FALSE
#ASSERT `S 200/2019 para 2(1) "retrenchment report" the report is one` FALSE TRUE EQUALS JUST FALSE
-- working days: a Saturday, a Sunday, a public holiday are not; a Monday and a Wednesday are
#ASSERT NOT (`S 200/2019 para 2(1) "working day" the day is one` (Date 7 11 2026) EMPTY)
#ASSERT NOT (`S 200/2019 para 2(1) "working day" the day is one` (Date 8 11 2026) EMPTY)
#ASSERT `S 200/2019 para 2(1) "working day" the day is one` (Date 9 11 2026) EMPTY
#ASSERT `S 200/2019 para 2(1) "working day" the day is one` (Date 4 11 2026) EMPTY
#ASSERT NOT (`S 200/2019 para 2(1) "working day" the day is one` (Date 9 11 2026) (LIST Date 9 11 2026))
-- employees the Notification refers to: no end date; an end date with a term of 6 months; of 5
#ASSERT `S 200/2019 para 2(2) the employee is one to whom the Notification refers` FALSE 0 EQUALS JUST TRUE
#ASSERT `S 200/2019 para 2(2) the employee is one to whom the Notification refers` TRUE 6 EQUALS JUST TRUE
#ASSERT `S 200/2019 para 2(2) the employee is one to whom the Notification refers` TRUE 12 EQUALS JUST TRUE
#ASSERT `S 200/2019 para 2(2) the employee is one to whom the Notification refers` TRUE 5 EQUALS JUST FALSE
#ASSERT `S 200/2019 para 2(2) the employee is one to whom the Notification refers` TRUE 5.5 EQUALS JUST FALSE
-- para 2(3)
#ASSERT `S 200/2019 para 2(3) the employer has 10 or more employees` 10
#ASSERT NOT (`S 200/2019 para 2(3) the employer has 10 or more employees` 9)

§ `Tests -- para 3 the report`

-- notice given before 1 November 2021: no duty under the Notification as it stands
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer` (Date 31 10 2021) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer` (Date 1 11 2021) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer` (Date 4 11 2026) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer` (Date 4 11 2026) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer` (Date 4 11 2026) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer` (Date 4 11 2026) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer` (Date 4 11 2026) (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer` (Date 31 10 2021) NOTHING NOTHING EQUALS JUST FALSE

-- the items the report must state: an individual employer, same trade name, benefits paid: 13 items
#ASSERT count (`S 200/2019 Schedule the items the report must state` TRUE TRUE FALSE FALSE) EQUALS 13
#ASSERT count (`S 200/2019 Schedule the items the report must state` FALSE TRUE FALSE FALSE) EQUALS 13
#ASSERT count (`S 200/2019 Schedule the items the report must state` FALSE FALSE FALSE FALSE) EQUALS 13
#ASSERT count (`S 200/2019 Schedule the items the report must state` TRUE TRUE TRUE FALSE) EQUALS 14
#ASSERT count (`S 200/2019 Schedule the items the report must state` TRUE TRUE FALSE TRUE) EQUALS 14
#ASSERT count (`S 200/2019 Schedule the items the report must state` TRUE TRUE TRUE TRUE) EQUALS 15
#ASSERT elem `S 200/2019 sch 1(a)(i) the name and address of an employer who is an individual` (`S 200/2019 Schedule the items the report must state` TRUE FALSE FALSE FALSE)
#ASSERT NOT (elem `S 200/2019 sch 1(a)(ii)(A) the name and address of an employer who is not an individual, as on a register or official record` (`S 200/2019 Schedule the items the report must state` TRUE FALSE FALSE FALSE))
#ASSERT elem `S 200/2019 sch 1(a)(ii)(A) the name and address of an employer who is not an individual, as on a register or official record` (`S 200/2019 Schedule the items the report must state` FALSE TRUE FALSE FALSE)
#ASSERT elem `S 200/2019 sch 1(a)(ii)(B) the name in which the employer employed the employee and the address of its principal place of business` (`S 200/2019 Schedule the items the report must state` FALSE FALSE FALSE FALSE)
#ASSERT elem `S 200/2019 sch 1(b) the trade name if different` (`S 200/2019 Schedule the items the report must state` TRUE TRUE TRUE FALSE)
#ASSERT NOT (elem `S 200/2019 sch 1(b) the trade name if different` (`S 200/2019 Schedule the items the report must state` TRUE TRUE FALSE FALSE))
#ASSERT elem `S 200/2019 sch 2(g) the reasons for not paying retrenchment benefits` (`S 200/2019 Schedule the items the report must state` TRUE TRUE FALSE TRUE)
#ASSERT NOT (elem `S 200/2019 sch 2(g) the reasons for not paying retrenchment benefits` (`S 200/2019 Schedule the items the report must state` TRUE TRUE FALSE FALSE))

-- para 3(2): every required item stated is not proof of completeness; one left out is a failure
`test required` MEANS `S 200/2019 Schedule the items the report must state` TRUE TRUE FALSE FALSE
#ASSERT `S 200/2019 para 3(2) the report contains all the information specified in the Schedule` `test required` `test required` EQUALS NOTHING
#ASSERT `S 200/2019 para 3(2) the report contains all the information specified in the Schedule` `test required` EMPTY EQUALS JUST FALSE
#ASSERT `S 200/2019 para 3(2) the report contains all the information specified in the Schedule` `test required` (LIST `S 200/2019 sch 1(a)(i) the name and address of an employer who is an individual`) EQUALS JUST FALSE
-- all but the job title (2(b))
`test all but 2b` MEANS LIST `S 200/2019 sch 1(a)(i) the name and address of an employer who is an individual`, `S 200/2019 sch 1(c) the nature of the profession, business, trade or work`, `S 200/2019 sch 1(d) the registered trade union recognised, and whether it was consulted`, `S 200/2019 sch 1(e) the particulars of the contact person`, `S 200/2019 sch 1(f) the number of retrenched employees`, `S 200/2019 sch 1(g) the number of employees on the date of the notice, by citizens, permanent residents and foreigners`, `S 200/2019 sch 2(a) the name and the identity or foreign identification number`, `S 200/2019 sch 2(c) whether a citizen, a permanent resident or a foreigner`, `S 200/2019 sch 2(d) the date the notice of retrenchment is given`, `S 200/2019 sch 2(e) the effective date of retrenchment`, `S 200/2019 sch 2(f) the retrenchment benefits paid or to be paid`, `S 200/2019 sch 2(h) the employment facilitation assistance provided or to be provided`
#ASSERT `S 200/2019 para 3(2) the report contains all the information specified in the Schedule` `test required` `test all but 2b` EQUALS JUST FALSE

§ `Tests -- paras 4 and 5 time and form`

-- 5 working days after Wednesday 4 November 2026: Thu 5, Fri 6, Mon 9, Tue 10, Wed 11
#ASSERT `S 200/2019 para 4 the last day for giving the retrenchment report` (Date 4 11 2026) EMPTY EQUALS Date 11 11 2026
-- after Friday 6 November: Mon 9, Tue 10, Wed 11, Thu 12, Fri 13
#ASSERT `S 200/2019 para 4 the last day for giving the retrenchment report` (Date 6 11 2026) EMPTY EQUALS Date 13 11 2026
-- after Saturday 7 November: the same
#ASSERT `S 200/2019 para 4 the last day for giving the retrenchment report` (Date 7 11 2026) EMPTY EQUALS Date 13 11 2026
-- Monday 9 November a public holiday: after Wednesday 4: Thu 5, Fri 6, Tue 10, Wed 11, Thu 12
#ASSERT `S 200/2019 para 4 the last day for giving the retrenchment report` (Date 4 11 2026) (LIST Date 9 11 2026) EQUALS Date 12 11 2026
-- after Friday 6 with Monday 9 a holiday: Tue 10, Wed 11, Thu 12, Fri 13, Mon 16
#ASSERT `S 200/2019 para 4 the last day for giving the retrenchment report` (Date 6 11 2026) (LIST Date 9 11 2026) EQUALS Date 16 11 2026
#ASSERT `S 200/2019 para 4 the retrenchment report was given in time` (Date 11 11 2026) (Date 4 11 2026) EMPTY
#ASSERT NOT (`S 200/2019 para 4 the retrenchment report was given in time` (Date 12 11 2026) (Date 4 11 2026) EMPTY)
#ASSERT `S 200/2019 para 4 the retrenchment report was given in time` (Date 4 11 2026) (Date 4 11 2026) EMPTY
#ASSERT `S 200/2019 para 5 the requirement as to the form of the report is met` TRUE FALSE EQUALS JUST TRUE
#ASSERT `S 200/2019 para 5 the requirement as to the form of the report is met` FALSE TRUE EQUALS JUST TRUE
#ASSERT `S 200/2019 para 5 the requirement as to the form of the report is met` FALSE FALSE EQUALS JUST FALSE

#ASSERT `S 200/2019 the employer met every requirement concerning the report` (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `S 200/2019 the employer met every requirement concerning the report` NOTHING FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `S 200/2019 the employer met every requirement concerning the report` NOTHING TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `S 200/2019 the employer met every requirement concerning the report` NOTHING TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `S 200/2019 the employer met every requirement concerning the report` NOTHING TRUE NOTHING EQUALS NOTHING

§ `Tests -- the headcount of paragraph 2(3) (fork F20)`

-- Reading A (the rule as written): the definition of "employer" is deleted from 1 November 2021, paragraph 3(1) says "Every employer",
-- so an employer with 5 employees who gives notice of retrenchment on 4 November 2026 is within paragraph 3(1).
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer` (Date 4 11 2026) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
-- Reading B: the 10-employee definition still operates; the headcount is taken at the time the notice is given (paragraph 2(3)).
#ASSERT `S 200/2019 para 2(3) the employer has 10 or more employees` 10 EQUALS TRUE
#ASSERT `S 200/2019 para 2(3) the employer has 10 or more employees` 9 EQUALS FALSE
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer, if the 10-employee definition still operates` 5 (Date 4 11 2026) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer, if the 10-employee definition still operates` 10 (Date 4 11 2026) (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer, if the 10-employee definition still operates` 10 (Date 31 10 2021) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer, if the 10-employee definition still operates` 10 (Date 4 11 2026) NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `S 200/2019 para 3(1) the Notification applies to the employer, if the 10-employee definition still operates` 9 (Date 4 11 2026) NOTHING (JUST TRUE) EQUALS JUST FALSE
