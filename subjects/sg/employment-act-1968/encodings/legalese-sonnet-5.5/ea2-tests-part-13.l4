IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea2-part-13`

-- Tests for ea2-part-13.l4 (Employment Act 1968, ss 103 to 107).  Expected values were decided from the text before the
-- functions were run.

`test commissioner` MEANS `Official: the Commissioner for Labour`
`test inspecting officer` MEANS `Official: an inspecting officer`

§ `Tests -- s 103 powers of inspection`

#ASSERT `s 103(1) the official has the powers in this subsection` `test commissioner` EQUALS JUST TRUE
#ASSERT `s 103(1) the official has the powers in this subsection` `test inspecting officer` EQUALS JUST TRUE
#ASSERT `s 103(1) the official has the powers in this subsection` `Official: the Minister` EQUALS NOTHING
#ASSERT `s 103(1) the official has the powers in this subsection` `Official: an authorised officer` EQUALS NOTHING
#ASSERT `s 103(1)(a) the official may enter and search the premises` `test inspecting officer` TRUE EQUALS JUST TRUE
#ASSERT `s 103(1)(a) the official may enter and search the premises` `test commissioner` TRUE EQUALS JUST TRUE
#ASSERT `s 103(1)(a) the official may enter and search the premises` `test inspecting officer` FALSE EQUALS JUST FALSE
#ASSERT `s 103(1)(a) the official may enter and search the premises` `Official: the Minister` TRUE EQUALS NOTHING
#ASSERT `s 103(1)(aa) the official may enter the place of employment without previous notice` `test inspecting officer` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 103(1)(aa) the official may enter the place of employment without previous notice` `test inspecting officer` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 103(1)(aa) the official may enter the place of employment without previous notice` `test inspecting officer` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 103(1)(aa) the official may enter the place of employment without previous notice` `test inspecting officer` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 103(1)(b) the official may examine the person orally and reduce the answer or statement into writing` `test inspecting officer` TRUE EQUALS JUST TRUE
#ASSERT `s 103(1)(b) the official may examine the person orally and reduce the answer or statement into writing` `test inspecting officer` FALSE EQUALS NOTHING
#ASSERT `s 103(1)(c) the official may require the person to produce the document and to answer questions about it` `test commissioner` TRUE EQUALS JUST TRUE
#ASSERT `s 103(1)(c) the official may require the person to produce the document and to answer questions about it` `test commissioner` FALSE EQUALS NOTHING
#ASSERT `s 103(1)(d) the official may examine the notice or document` `test commissioner` TRUE EQUALS JUST TRUE
#ASSERT `s 103(1)(d) the official may examine the notice or document` `test commissioner` FALSE EQUALS NOTHING
#ASSERT `s 103(1)(e) the official may make copies of or retain the notice or document` `test commissioner` TRUE EQUALS JUST TRUE
#ASSERT `s 103(1)(e) the official may make copies of or retain the notice or document` `test commissioner` FALSE EQUALS NOTHING
-- (f): used by employees and the employer notified: yes; used by employees and not notified: no ("except that"); not used by employees: not the power
#ASSERT `s 103(1)(f) the official may retain the samples for analysis` `test inspecting officer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 103(1)(f) the official may retain the samples for analysis` `test inspecting officer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 103(1)(f) the official may retain the samples for analysis` `test inspecting officer` FALSE TRUE EQUALS NOTHING
#ASSERT `s 103(1)(f) the official may retain the samples for analysis` `Official: the Minister` TRUE TRUE EQUALS NOTHING
#ASSERT `s 103(1)(g) the official may take the photograph or audio or video recording` `test inspecting officer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 103(1)(g) the official may take the photograph or audio or video recording` `test inspecting officer` TRUE FALSE EQUALS NOTHING
#ASSERT `s 103(1)(g) the official may take the photograph or audio or video recording` `test inspecting officer` FALSE TRUE EQUALS NOTHING
#ASSERT `s 103(1)(h) the official may require the person to produce the article and, if necessary, take it into custody` `test inspecting officer` TRUE EQUALS JUST TRUE
#ASSERT `s 103(1)(h) the official may require the person to produce the article and, if necessary, take it into custody` `test inspecting officer` FALSE EQUALS NOTHING
#ASSERT `s 103(2) the person examined is bound to state truly the facts and circumstances with which the person is acquainted` TRUE EQUALS JUST TRUE
#ASSERT `s 103(2) the person examined is bound to state truly the facts and circumstances with which the person is acquainted` FALSE EQUALS NOTHING
#ASSERT `s 103(3) the statement must be read over to the person and, after correction, signed by the person` TRUE EQUALS JUST TRUE
#ASSERT `s 103(3) the statement must be read over to the person and, after correction, signed by the person` FALSE EQUALS NOTHING
#ASSERT `s 103(4) the Commissioner or the inspecting officer must show his or her credentials` TRUE EQUALS JUST TRUE
#ASSERT `s 103(4) the Commissioner or the inspecting officer must show his or her credentials` FALSE EQUALS JUST FALSE
#ASSERT `s 104 the official must notify the employer or the employer's representative of his or her presence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 104 the official must notify the employer or the employer's representative of his or her presence` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 104 the official must notify the employer or the employer's representative of his or her presence` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 104 the official must notify the employer or the employer's representative of his or her presence` FALSE TRUE EQUALS JUST FALSE

§ `Tests -- ss 105 to 106A arrest, restraint, search, disposal`

#ASSERT `s 105(1) the inspecting officer may arrest the person without warrant` `test inspecting officer` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 105(1) the inspecting officer may arrest the person without warrant` `test inspecting officer` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 105(1) the inspecting officer may arrest the person without warrant` `test inspecting officer` FALSE FALSE EQUALS NOTHING
-- only an inspecting officer; the Commissioner is not named in s 105
#ASSERT `s 105(1) the inspecting officer may arrest the person without warrant` `test commissioner` TRUE FALSE EQUALS NOTHING
#ASSERT `s 105(2) the inspecting officer may arrest the person without warrant` `test inspecting officer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 105(2) the inspecting officer may arrest the person without warrant` `test inspecting officer` FALSE TRUE EQUALS NOTHING
#ASSERT `s 105(2) the inspecting officer may arrest the person without warrant` `test inspecting officer` TRUE FALSE EQUALS NOTHING
#ASSERT `s 105(2) the inspecting officer may arrest the person without warrant` `test commissioner` TRUE TRUE EQUALS NOTHING
#ASSERT `s 105(3) the inspecting officer must produce the person arrested before a Magistrate's Court` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 105(3) the inspecting officer must produce the person arrested before a Magistrate's Court` TRUE TRUE EQUALS NOTHING
#ASSERT `s 105(3) the inspecting officer must produce the person arrested before a Magistrate's Court` FALSE FALSE EQUALS NOTHING
-- 48 hours exactly is not "exceed 48 hours"
#ASSERT `s 105(4) the inspecting officer may detain the person in custody for that long` 49 FALSE EQUALS JUST FALSE
#ASSERT `s 105(4) the inspecting officer may detain the person in custody for that long` 48 FALSE EQUALS NOTHING
#ASSERT `s 105(4) the inspecting officer may detain the person in custody for that long` 10 TRUE EQUALS JUST FALSE
#ASSERT `s 105(4) the inspecting officer may detain the person in custody for that long` 0 FALSE EQUALS NOTHING
#ASSERT `s 105(5) an inspecting officer may release the person on bail or on his or her own bond` TRUE EQUALS JUST TRUE
#ASSERT `s 105(5) an inspecting officer may release the person on bail or on his or her own bond` FALSE EQUALS NOTHING
#ASSERT `s 105A(1) the inspecting officer must touch or confine the body of the person to be arrested` FALSE EQUALS JUST TRUE
#ASSERT `s 105A(1) the inspecting officer must touch or confine the body of the person to be arrested` TRUE EQUALS JUST FALSE
#ASSERT `s 105A(2) the inspecting officer may use all means necessary to effect the arrest` TRUE EQUALS JUST TRUE
#ASSERT `s 105A(2) the inspecting officer may use all means necessary to effect the arrest` FALSE EQUALS JUST FALSE
#ASSERT `s 105B(1) the person arrested may be subjected to the restraint` TRUE EQUALS JUST FALSE
#ASSERT `s 105B(1) the person arrested may be subjected to the restraint` FALSE EQUALS NOTHING
#ASSERT `s 105B(2) the inspecting officer may use handcuffs or a similar means of restraint` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 105B(2) the inspecting officer may use handcuffs or a similar means of restraint` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 105B(2) the inspecting officer may use handcuffs or a similar means of restraint` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 105B(2) the inspecting officer may use handcuffs or a similar means of restraint` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 105B(2) the inspecting officer may use handcuffs or a similar means of restraint` FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 105B(3) the handcuffs or similar means of restraint may be used` TRUE EQUALS JUST FALSE
#ASSERT `s 105B(3) the handcuffs or similar means of restraint may be used` FALSE EQUALS NOTHING
#ASSERT `s 105C(1) the inspecting officer may take possession of the article found upon the person` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 105C(1) the inspecting officer may take possession of the article found upon the person` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 105C(1) the inspecting officer may take possession of the article found upon the person` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 105C(1) the inspecting officer may take possession of the article found upon the person` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 105C(2) the inspecting officer may make the search` FALSE EQUALS JUST FALSE
#ASSERT `s 105C(2) the inspecting officer may make the search` TRUE EQUALS NOTHING
#ASSERT `s 105E the inspecting officer may take the offensive weapon from the person arrested` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 105E the inspecting officer may take the offensive weapon from the person arrested` TRUE FALSE EQUALS NOTHING
#ASSERT `s 105E the inspecting officer may take the offensive weapon from the person arrested` FALSE TRUE EQUALS NOTHING
#ASSERT `s 105F the inspecting officer may immediately pursue and arrest the person in any place within Singapore` TRUE EQUALS JUST TRUE
#ASSERT `s 105F the inspecting officer may immediately pursue and arrest the person in any place within Singapore` FALSE EQUALS JUST FALSE
#ASSERT `s 106 the person may reveal the manufacturing or commercial secret` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 106 the person may reveal the manufacturing or commercial secret` TRUE TRUE EQUALS NOTHING
#ASSERT `s 106 the person may reveal the manufacturing or commercial secret` FALSE FALSE EQUALS NOTHING
#ASSERT `s 106A(1) what must be done with the document, article or thing` TRUE TRUE EQUALS JUST `s 106A(1)(a) deal with it in accordance with section 364 of the Criminal Procedure Code 2010`
#ASSERT `s 106A(1) what must be done with the document, article or thing` TRUE FALSE EQUALS JUST `s 106A(1)(b) return it to the owner or report it to a Magistrate`
#ASSERT `s 106A(1) what must be done with the document, article or thing` FALSE TRUE EQUALS NOTHING
#ASSERT `s 106A(2) the Magistrate may order the document, article or thing to be forfeited or to be disposed of` TRUE EQUALS JUST TRUE
#ASSERT `s 106A(2) the Magistrate may order the document, article or thing to be forfeited or to be disposed of` FALSE EQUALS JUST FALSE
#ASSERT `s 106A(3) section 106A prejudices the right to retain or dispose of the property` TRUE EQUALS JUST FALSE
#ASSERT `s 106A(3) section 106A prejudices the right to retain or dispose of the property` FALSE EQUALS NOTHING

§ `Tests -- s 107 the offence`

#ASSERT `s 107(a) the person is guilty of an offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 107(a) the person is guilty of an offence` TRUE TRUE EQUALS NOTHING
#ASSERT `s 107(a) the person is guilty of an offence` FALSE FALSE EQUALS NOTHING
#ASSERT `s 107(b) the person is guilty of an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 107(b) the person is guilty of an offence` FALSE EQUALS NOTHING
#ASSERT `s 107(c) the person is guilty of an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 107(c) the person is guilty of an offence` FALSE EQUALS NOTHING
#ASSERT `s 107 the person is guilty of an offence` (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 107 the person is guilty of an offence` NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 107 the person is guilty of an offence` NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 107 the person is guilty of an offence` NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 107 the penalty on conviction` EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 6

§ `Tests -- the twins that can say no (rulings of 2026-11-05; fork F18)`

-- s 105(4), with the text's own verb: what the text forbids is a detention longer than is reasonable or one that exceeds 48 hours (net of the journey).
#ASSERT `s 105(4) the inspecting officer must not detain the person in custody for that long` 49 FALSE EQUALS JUST TRUE
#ASSERT `s 105(4) the inspecting officer must not detain the person in custody for that long` 10 TRUE EQUALS JUST TRUE
#ASSERT `s 105(4) the inspecting officer must not detain the person in custody for that long` 48 FALSE EQUALS JUST FALSE
#ASSERT `s 105(4) the inspecting officer must not detain the person in custody for that long` 0 FALSE EQUALS JUST FALSE
-- s 105C(2): "Whenever it is necessary to cause a person to be searched, the search must be made by an inspecting officer of the same sex".
#ASSERT `s 105C(2) the search must be made by an inspecting officer of the same sex as the person` TRUE EQUALS JUST TRUE
#ASSERT `s 105C(2) the search must be made by an inspecting officer of the same sex as the person` FALSE EQUALS JUST FALSE
-- s 103(1)(a): an official who is not the Commissioner or an inspecting officer is outside the subsection; one who is, without reasonable cause, is the text's no.
#ASSERT `s 103(1)(a) the official may enter and search the premises` `test inspecting officer` TRUE EQUALS JUST TRUE
