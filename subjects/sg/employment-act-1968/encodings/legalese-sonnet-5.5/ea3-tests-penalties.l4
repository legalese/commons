IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea-definitions`
IMPORT `sgia-interpretation-time`
IMPORT `ea3-procedure`
IMPORT `ea3-penalties`

-- Employment Act 1968 (Singapore) -- ea3: TESTS FOR PART 15A (ss 126A to 126D).
-- Every expected value is worked out by hand from the text cited beside the group, never copied from what the code printed.

-- ---------------------------------------------------------------------------
-- s 126A (lines 5017-5041)
-- ---------------------------------------------------------------------------

-- (a): a failure to comply with s 95(1), 95A(2) or 96(1); each input means "the employer failed to comply".
#ASSERT `s 126A(a) the failure is a civil contravention` (JUST TRUE) (JUST FALSE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 126A(a) the failure is a civil contravention` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 126A(a) the failure is a civil contravention` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 126A(a) the failure is a civil contravention` (JUST FALSE) (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
-- One answer not given and none of the others a failure.
#ASSERT `s 126A(a) the failure is a civil contravention` NOTHING (JUST FALSE) (JUST FALSE) EQUALS NOTHING
-- A failure found by one answer, whatever the others say.
#ASSERT `s 126A(a) the failure is a civil contravention` NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
-- (aa): a failure to comply with a requirement in a notification under s 96A.
#ASSERT `s 126A(aa) the failure is a civil contravention` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 126A(aa) the failure is a civil contravention` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 126A(aa) the failure is a civil contravention` NOTHING EQUALS NOTHING
-- (ab): a contravention of a provision of regulations mentioned in s 139(2)(aa) that the Minister has prescribed.
#ASSERT `s 126A(ab) the contravention is a civil contravention` TRUE TRUE EQUALS JUST TRUE
-- s 2(1) "civil contravention" "means a contravention that is declared to be a civil contravention under section 126A", and (ab) declares only what the Minister has prescribed under s 139(2B) (ruling (a) on delegated definitions). (re-read from the text on 2026-11-05; the expected value was NOTHING)
#ASSERT `s 126A(ab) the contravention is a civil contravention` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 126A(ab) the contravention is a civil contravention` FALSE TRUE EQUALS NOTHING
-- (b): inaccurate information given inadvertently or without intent to mislead or defraud.
#ASSERT `s 126A(b) the provision of information is a civil contravention` TRUE TRUE EQUALS JUST TRUE
-- s 2(1) "civil contravention" means a contravention declared under section 126A, and (b) declares only inaccurate information given "inadvertently or without intent to mislead or defraud" (ruling (a) on delegated definitions): information given with intent to mislead is not declared. (re-read from the text on 2026-11-05; the expected value was NOTHING)
#ASSERT `s 126A(b) the provision of information is a civil contravention` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 126A(b) the provision of information is a civil contravention` FALSE TRUE EQUALS NOTHING
-- The declaration, by kind: each kind takes its own limb's answer; any other kind is not declared.
#ASSERT `s 126A the contravention is declared to be a civil contravention` `s 126A(a) a failure by an employer to comply with section 95(1), 95A(2) or 96(1)` (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 126A the contravention is declared to be a civil contravention` `s 126A(aa) a failure by an employer to whom a notification under section 96A applies to comply with a requirement in it` NOTHING (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 126A the contravention is declared to be a civil contravention` `s 126A(ab) a contravention by an employer of a provision of regulations mentioned in section 139(2)(aa)` NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 126A the contravention is declared to be a civil contravention` `s 126A(b) the provision by an employer of inaccurate information or particulars, inadvertently or without intent to mislead or defraud` NOTHING NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 126A the contravention is declared to be a civil contravention` `s 126A a contravention of some other kind` (JUST TRUE) (JUST TRUE) (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
-- The seam: the keel's "civil contravention" takes this declaration as its input.
#ASSERT `s 2(1) "civil contravention" the contravention is one` (`s 126A the contravention is declared to be a civil contravention` `s 126A a contravention of some other kind` NOTHING NOTHING NOTHING NOTHING) EQUALS JUST FALSE
#ASSERT `s 2(1) "civil contravention" the contravention is one` (`s 126A the contravention is declared to be a civil contravention` `s 126A(a) a failure by an employer to comply with section 95(1), 95A(2) or 96(1)` (JUST TRUE) NOTHING NOTHING NOTHING) EQUALS JUST TRUE

-- ---------------------------------------------------------------------------
-- s 126B (lines 5047-5098)
-- ---------------------------------------------------------------------------

#ASSERT `s 126B(1) the authorised officer may issue a contravention notice to the employer for the occasion` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 126B(1) the authorised officer may issue a contravention notice to the employer for the occasion` FALSE TRUE EQUALS NOTHING
#ASSERT `s 126B(1) the authorised officer may issue a contravention notice to the employer for the occasion` TRUE FALSE EQUALS NOTHING
-- The amount is prescribed; section 139(2)(h) allows no more than $1,000 for an occasion and $2,000 for a second or subsequent occasion.
#ASSERT `s 126B(1) the administrative penalty the notice may require` 1000 FALSE EQUALS JUST 1000
#ASSERT `s 126B(1) the administrative penalty the notice may require` 1001 FALSE EQUALS NOTHING
#ASSERT `s 126B(1) the administrative penalty the notice may require` 2000 TRUE EQUALS JUST 2000
#ASSERT `s 126B(1) the administrative penalty the notice may require` 2001 TRUE EQUALS NOTHING
#ASSERT `s 126B(1) the administrative penalty the notice may require` 1500 FALSE EQUALS NOTHING
-- The notice must specify the amount, the date and the details.
#ASSERT `s 126B(2) the contravention notice is as the subsection requires` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 126B(2) the contravention notice is as the subsection requires` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 126B(2) the contravention notice is as the subsection requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 126B(2) the contravention notice is as the subsection requires` TRUE TRUE FALSE EQUALS JUST FALSE
-- (4): pay within the time specified in the notice, both sides of its end.
#ASSERT `s 126B(4) the employer must pay the administrative penalty to the authorised officer` TRUE EQUALS JUST TRUE
#ASSERT `s 126B(4) the employer must pay the administrative penalty to the authorised officer` FALSE EQUALS NOTHING
#ASSERT `s 126B(4) the payment is made within the time specified in the notice` (Date 30 6 2025) (Date 30 6 2025) EQUALS JUST TRUE
#ASSERT `s 126B(4) the payment is made within the time specified in the notice` (Date 30 6 2025) (Date 1 7 2025) EQUALS JUST FALSE

-- ---------------------------------------------------------------------------
-- s 126C (lines 5104-5198)
-- ---------------------------------------------------------------------------

#ASSERT `s 126C(1)(a) the employer may request an internal reconsideration` TRUE TRUE EQUALS JUST TRUE
-- "within the prescribed period": a request outside it is outside the grant, and the text says so in its own words (ruling (a), 2026-11-05, which overrules fork F7).
-- "within the prescribed period and in accordance with the prescribed procedure" (ruling (a); fork F7 overruled). (re-read from the text on 2026-11-05; the expected value was NOTHING)
#ASSERT `s 126C(1)(a) the employer may request an internal reconsideration` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 126C(1)(a) the employer may request an internal reconsideration` FALSE TRUE EQUALS NOTHING
#ASSERT `s 126C(1)(b) the employer may appeal to the General Division of the High Court` TRUE TRUE EQUALS JUST TRUE
-- "within the prescribed period" (ruling (a); fork F7 overruled). (re-read from the text on 2026-11-05; the expected value was NOTHING)
#ASSERT `s 126C(1)(b) the employer may appeal to the General Division of the High Court` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 126C(1)(b) the employer may appeal to the General Division of the High Court` FALSE TRUE EQUALS NOTHING
#ASSERT `s 126C(1) the High Court may hear and determine the matter afresh` TRUE EQUALS JUST TRUE
#ASSERT `s 126C(1) the High Court may hear and determine the matter afresh` FALSE EQUALS NOTHING
#ASSERT `s 126C(2) the reviewing authorised officer is not barred from reconsidering the notice` TRUE EQUALS JUST FALSE
#ASSERT `s 126C(2) the reviewing authorised officer is not barred from reconsidering the notice` FALSE EQUALS JUST TRUE
#ASSERT `s 126C(3) the reviewing authorised officer may take the step` `s 126C(3)(a) confirm the contravention notice issued by the initial authorised officer` EQUALS JUST TRUE
#ASSERT `s 126C(3) the reviewing authorised officer may take the step` `s 126C(3)(b) cancel the contravention notice` EQUALS JUST TRUE
#ASSERT `s 126C(3) the reviewing authorised officer may take the step` `s 126C(3) a step of some other kind` EQUALS NOTHING
#ASSERT `s 126C(4) the employer may appeal to the General Division of the High Court` TRUE TRUE EQUALS JUST TRUE
-- "within the prescribed period" (ruling (a); fork F7 overruled). (re-read from the text on 2026-11-05; the expected value was NOTHING)
#ASSERT `s 126C(4) the employer may appeal to the General Division of the High Court` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 126C(4) the employer may appeal to the General Division of the High Court` FALSE TRUE EQUALS NOTHING
#ASSERT `s 126C(5) the procedure governing the appeal is as provided in the Rules of Court` TRUE EQUALS JUST TRUE
#ASSERT `s 126C(5) the procedure governing the appeal is as provided in the Rules of Court` FALSE EQUALS NOTHING
-- (6): stayed while a request for reconsideration or an appeal is pending.
#ASSERT `s 126C(6) the enforcement of the payment is stayed` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 126C(6) the enforcement of the payment is stayed` FALSE TRUE EQUALS JUST TRUE
-- "(a) if a request ... is made, until after the reconsideration is completed; or (b) if an appeal ... is filed, until after the appeal is completed": no request or appeal pending (an unmet "if" or a bar that has run its course; rulings (b) and (d)). (re-read from the text on 2026-11-05; the expected value was NOTHING)
#ASSERT `s 126C(6) the enforcement of the payment is stayed` FALSE FALSE EQUALS JUST FALSE
-- (7): enforcement as a judgment of the District Court, by its permission, in the three cases.
#ASSERT `s 126C(7) the contravention notice may be enforced as a judgment of the District Court by its permission` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 126C(7) the contravention notice may be enforced as a judgment of the District Court by its permission` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 126C(7) the contravention notice may be enforced as a judgment of the District Court by its permission` FALSE FALSE TRUE EQUALS JUST TRUE
-- "where —(a) ... (b) ... or (c) ..., the contravention notice may, by permission of a District Court, be enforced" (ruling (b)): none of (a) to (c). (re-read from the text on 2026-11-05; the expected value was NOTHING)
#ASSERT `s 126C(7) the contravention notice may be enforced as a judgment of the District Court by its permission` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 126C(7) judgment may be entered in terms of the contravention notice` TRUE EQUALS JUST TRUE
-- "where permission is so given, judgment may be entered in terms of that contravention notice" (ruling (b)). (re-read from the text on 2026-11-05; the expected value was NOTHING)
#ASSERT `s 126C(7) judgment may be entered in terms of the contravention notice` FALSE EQUALS JUST FALSE
-- (6) as a bar (ruling (d), 2026-11-05): JUST TRUE until the reconsideration or appeal is completed, JUST FALSE after it, and JUST FALSE when none was lodged.
#ASSERT `s 126C(6) the stay on the enforcement of the payment is still in force` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 126C(6) the stay on the enforcement of the payment is still in force` TRUE TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 126C(6) the stay on the enforcement of the payment is still in force` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 126C(6) the stay on the enforcement of the payment is still in force` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 126C(6) the stay on the enforcement of the payment is still in force` FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 126C(6) the stay on the enforcement of the payment is still in force` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
-- What the bar holds back is never said to have happened: JUST FALSE while the bar stands, NOTHING after it (subsection (7) governs enforcement).
#ASSERT `s 126C(6) the enforcement of the payment is no longer held back and may go forward` TRUE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 126C(6) the enforcement of the payment is no longer held back and may go forward` FALSE FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 126C(6) the enforcement of the payment is no longer held back and may go forward` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 126C(6) the enforcement of the payment is no longer held back and may go forward` FALSE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 126C(6) the enforcement of the payment is no longer held back and may go forward` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- The prescribed period is in regulations that are not among the sources; its last day is an input (30 June 2025 here).
#ASSERT `s 126C the step is taken within the prescribed period` (Date 30 6 2025) (Date 30 6 2025) EQUALS JUST TRUE
#ASSERT `s 126C the step is taken within the prescribed period` (Date 30 6 2025) (Date 1 7 2025) EQUALS JUST FALSE
-- 126B(1)(a) and (aa): each occasion with respect to any one employee; two occasions for one employee and one for another make three.
#ASSERT `s 126B(1)(a) and (aa) the number of occasions for which a notice may require an administrative penalty` (LIST 2, 1) EQUALS 3
#ASSERT `s 126B(1)(a) and (aa) the number of occasions for which a notice may require an administrative penalty` (LIST 1) EQUALS 1
#ASSERT `s 126C(8) the initial authorised officer may waive, remit or refund the administrative penalty` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 126C(8) the initial authorised officer may waive, remit or refund the administrative penalty` TRUE FALSE EQUALS NOTHING
#ASSERT `s 126C(8) the initial authorised officer may waive, remit or refund the administrative penalty` FALSE TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
-- s 126D (lines 5204-5223)
-- ---------------------------------------------------------------------------

#ASSERT `s 126D(1) the authorised officer may give the direction` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 126D(1) the authorised officer may give the direction` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 126D(1) the authorised officer may give the direction` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 126D(1) the authorised officer may give the direction` TRUE NOTHING EQUALS NOTHING
-- (b): "where necessary, require the employer to take such action as is specified in the direction" (ruling (b), 2026-11-05).
#ASSERT `s 126D(1)(b) the authorised officer may require the employer to take the action specified in the direction` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 126D(1)(b) the authorised officer may require the employer to take the action specified in the direction` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 126D(1)(b) the authorised officer may require the employer to take the action specified in the direction` FALSE (JUST TRUE) TRUE EQUALS NOTHING
#ASSERT `s 126D(1)(b) the authorised officer may require the employer to take the action specified in the direction` TRUE (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 126D(1)(b) the authorised officer may require the employer to take the action specified in the direction` TRUE NOTHING TRUE EQUALS NOTHING
-- (2): the offence is a failure to comply "without reasonable excuse".
#ASSERT `s 126D(2) the employer is guilty of an offence` TRUE TRUE FALSE EQUALS JUST TRUE
-- "Without reasonable excuse" limits the offence in its own wording; with a reasonable excuse the text does not say the employer is not guilty (marginal reading (b)).
#ASSERT `s 126D(2) the employer is guilty of an offence` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 126D(2) the employer is guilty of an offence` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 126D(2) the employer is guilty of an offence` FALSE TRUE FALSE EQUALS NOTHING

GIVETH A `Penalty on conviction`
`ea3 test penalty of s 126D(2)` MEANS
    `Penalty on conviction` WITH
        `least fine in dollars` IS 0
        `greatest fine in dollars` IS JUST 5000
        `longest imprisonment in months` IS JUST 6

-- A fine not exceeding $5,000 or imprisonment not exceeding 6 months or both.
#ASSERT `s 126D(2) the penalty on conviction` (JUST TRUE) EQUALS JUST `ea3 test penalty of s 126D(2)`
#ASSERT `s 126D(2) the penalty on conviction` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 126D(2) the penalty on conviction` NOTHING EQUALS NOTHING
#ASSERT `s 126D(2) the court may impose both the fine and the imprisonment` TRUE EQUALS JUST TRUE
#ASSERT `s 126D(2) the court may impose both the fine and the imprisonment` FALSE EQUALS NOTHING
