IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea2-part-9c`

-- Tests for ea2-part-9c.l4 (Employment Act 1968, s 87A, childcare leave).  Expected values were
-- decided from the text before the functions were run.  Dates were worked out on a calendar.

`test calendar 2026` MEANS `Period of days` WITH `first day` IS Date 1 1 2026, `last day` IS Date 31 12 2026
`test calendar 2027` MEANS `Period of days` WITH `first day` IS Date 1 1 2027, `last day` IS Date 31 12 2027

§ `Tests -- s 87A(8) the definitions`

#ASSERT `s 87A(8) "child" the person is a child of the employee` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 87A(8) "child" the person is a child of the employee` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 87A(8) "child" the person is a child of the employee` FALSE FALSE TRUE EQUALS JUST TRUE
-- the list "includes" these; nothing else is said, so a person who is none of these is not answered
#ASSERT `s 87A(8) "child" the person is a child of the employee` FALSE FALSE FALSE EQUALS NOTHING

-- no agreement: the calendar year
#ASSERT `s 87A(8) "relevant period" the period` NOTHING 2026 EQUALS `test calendar 2026`
-- an agreed 12 months from 15 July 2026 end on 14 July 2027
#ASSERT `s 87A(8) "relevant period" the period` (JUST (Date 15 7 2026)) 2026 EQUALS `Period of days` WITH `first day` IS Date 15 7 2026, `last day` IS Date 14 7 2027
-- from 1 January: 1 January to 31 December
#ASSERT `s 87A(8) "relevant period" the period` (JUST (Date 1 1 2026)) 2026 EQUALS `test calendar 2026`
-- from 29 February 2024: 12 months end the day before 28 February 2025 + ... = 27 February 2025
#ASSERT `s 87A(8) "relevant period" the period` (JUST (Date 29 2 2024)) 2024 EQUALS `Period of days` WITH `first day` IS Date 29 2 2024, `last day` IS Date 27 2 2025

§ `Tests -- s 87A(1) who is entitled`

-- a child born on 1 January 2020 is 7 on 1 January 2027
#ASSERT `s 87A(1)(b) helper: the child is below 7 years of age at some time during the period` (Date 1 1 2020) `test calendar 2026`
#ASSERT NOT (`s 87A(1)(b) helper: the child is below 7 years of age at some time during the period` (Date 1 1 2020) `test calendar 2027`)
-- born the day after the period ends: not yet born during it; born on its last day: counts
#ASSERT NOT (`s 87A(1)(b) helper: the child is below 7 years of age at some time during the period` (Date 1 1 2027) `test calendar 2026`)
#ASSERT `s 87A(1)(b) helper: the child is below 7 years of age at some time during the period` (Date 31 12 2026) `test calendar 2026`
-- a period starting on the day before the 7th birthday still has a day below 7
#ASSERT `s 87A(1)(b) helper: the child is below 7 years of age at some time during the period` (Date 1 1 2020) (`Period of days` WITH `first day` IS Date 31 12 2026, `last day` IS Date 30 12 2027)
#ASSERT NOT (`s 87A(1)(b) helper: the child is below 7 years of age at some time during the period` (Date 1 1 2020) (`Period of days` WITH `first day` IS Date 2 1 2027, `last day` IS Date 1 1 2028))
-- a list: any one child is enough; none is none
#ASSERT `s 87A(1)(b) helper: some child is below 7 years of age at some time during the period` (LIST Date 1 1 2010, Date 1 1 2020) `test calendar 2026`
#ASSERT NOT (`s 87A(1)(b) helper: some child is below 7 years of age at some time during the period` (LIST Date 1 1 2010, Date 1 1 2015) `test calendar 2026`)
#ASSERT NOT (`s 87A(1)(b) helper: some child is below 7 years of age at some time during the period` EMPTY `test calendar 2026`)

#ASSERT `s 87A(1) the days of childcare leave the employee is entitled to for the relevant period` 3 (LIST Date 1 1 2020) `test calendar 2026` EQUALS JUST 2
#ASSERT `s 87A(1) the days of childcare leave the employee is entitled to for the relevant period` 36 (LIST Date 1 1 2020) `test calendar 2026` EQUALS JUST 2
-- 2 completed months of service: short of 3
#ASSERT `s 87A(1) the days of childcare leave the employee is entitled to for the relevant period` 2 (LIST Date 1 1 2020) `test calendar 2026` EQUALS JUST 0
-- no child below 7 in the period
#ASSERT `s 87A(1) the days of childcare leave the employee is entitled to for the relevant period` 3 (LIST Date 1 1 2020) `test calendar 2027` EQUALS JUST 0
#ASSERT `s 87A(1) the days of childcare leave the employee is entitled to for the relevant period` 3 EMPTY `test calendar 2026` EQUALS JUST 0

§ `Tests -- s 87A(2) the limits`

-- 12 already granted, 2 now: 14, not more than 14
#ASSERT `s 87A(2)(a) the employee is entitled to the days now claimed in respect of the child` 12 2 EQUALS NOTHING
-- 13 already granted, 2 now: 15, more than 14
#ASSERT `s 87A(2)(a) the employee is entitled to the days now claimed in respect of the child` 13 2 EQUALS JUST FALSE
#ASSERT `s 87A(2)(a) the employee is entitled to the days now claimed in respect of the child` 14 1 EQUALS JUST FALSE
#ASSERT `s 87A(2)(a) the employee is entitled to the days now claimed in respect of the child` 0 2 EQUALS NOTHING
#ASSERT `s 87A(2)(a) the days that remain within the 14-day limit for the child` 0 EQUALS 14
#ASSERT `s 87A(2)(a) the days that remain within the 14-day limit for the child` 13 EQUALS 1
#ASSERT `s 87A(2)(a) the days that remain within the 14-day limit for the child` 14 EQUALS 0
#ASSERT `s 87A(2)(a) the days that remain within the 14-day limit for the child` 20 EQUALS 0

-- (b)(i): arose for period 1: taken in period 1 or 2, not 3, not 0
#ASSERT `s 87A(2)(b)(i) the first entitlement is taken in time` 1 1
#ASSERT `s 87A(2)(b)(i) the first entitlement is taken in time` 1 2
#ASSERT NOT (`s 87A(2)(b)(i) the first entitlement is taken in time` 1 3)
#ASSERT NOT (`s 87A(2)(b)(i) the first entitlement is taken in time` 2 1)
-- (b)(ii): first taken in period 2: the second in 3, the third in 4; the first is under (i)
#ASSERT `s 87A(2)(b)(ii) the number of the relevant period in which the entitlement must be taken` 2 2 EQUALS JUST 3
#ASSERT `s 87A(2)(b)(ii) the number of the relevant period in which the entitlement must be taken` 2 3 EQUALS JUST 4
#ASSERT `s 87A(2)(b)(ii) the number of the relevant period in which the entitlement must be taken` 2 1 EQUALS NOTHING

#ASSERT `s 87A(3) the total days off the employee is entitled to` 2 52 11 14 14 EQUALS 93
#ASSERT `s 87A(3) the total days off the employee is entitled to` 0 0 0 0 0 EQUALS 0

§ `Tests -- s 87A(4) to (6) taking the leave, being paid, and losing it`

-- 2 days entitled, 0 taken by the last day: 2 lost; 1 taken: 1 lost; 2 taken: none
#ASSERT `s 87A(4) the days of the entitlement that are lost` 0 2 EQUALS 2
#ASSERT `s 87A(4) the days of the entitlement that are lost` 1 2 EQUALS 1
#ASSERT `s 87A(4) the days of the entitlement that are lost` 2 2 EQUALS 0
#ASSERT `s 87A(4)(a) the employee is still entitled to the days not taken by the last day` 0 2 EQUALS JUST FALSE
#ASSERT `s 87A(4)(a) the employee is still entitled to the days not taken by the last day` 1 2 EQUALS JUST FALSE
#ASSERT `s 87A(4)(a) the employee is still entitled to the days not taken by the last day` 2 2 EQUALS NOTHING
#ASSERT `s 87A(4)(b) the employee is entitled to payment in lieu of the days not taken` 0 2 EQUALS JUST FALSE
#ASSERT `s 87A(4)(b) the employee is entitled to payment in lieu of the days not taken` 2 2 EQUALS NOTHING

#ASSERT `s 87A(5) the amount the employer must pay for the childcare leave taken` 2 (JUST 150) EQUALS JUST 300
#ASSERT `s 87A(5) the amount the employer must pay for the childcare leave taken` 0 (JUST 150) EQUALS JUST 0
#ASSERT `s 87A(5) the amount the employer must pay for the childcare leave taken` 2 NOTHING EQUALS NOTHING
#ASSERT `s 87A(5A) the employee is entitled to take paid childcare leave on the day` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 87A(5A) the employee is entitled to take paid childcare leave on the day` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 87A(5A) the employee is entitled to take paid childcare leave on the day` NOTHING EQUALS NOTHING

-- (6): every way of ending counts, but only with days still untaken
#ASSERT `s 87A(6)(a) the employee is still entitled to the leave not yet taken` `Ending: the employee resigned` 2 EQUALS JUST FALSE
#ASSERT `s 87A(6)(a) the employee is still entitled to the leave not yet taken` `Ending: the employer dismissed the employee` 1 EQUALS JUST FALSE
#ASSERT `s 87A(6)(a) the employee is still entitled to the leave not yet taken` `Ending: the specified work was completed or the specified period expired` 2 EQUALS JUST FALSE
#ASSERT `s 87A(6)(a) the employee is still entitled to the leave not yet taken` `Ending: it ended in some other way` 2 EQUALS JUST FALSE
#ASSERT `s 87A(6)(a) the employee is still entitled to the leave not yet taken` `Ending: it has not ended` 2 EQUALS NOTHING
#ASSERT `s 87A(6)(a) the employee is still entitled to the leave not yet taken` `Ending: the employee resigned` 0 EQUALS NOTHING
#ASSERT `s 87A(6)(b) the employee is entitled to payment in lieu of the leave not yet taken` `Ending: the employee resigned` 2 EQUALS JUST FALSE
#ASSERT `s 87A(6)(b) the employee is entitled to payment in lieu of the leave not yet taken` `Ending: it has not ended` 2 EQUALS NOTHING
#ASSERT `s 87A(6)(b) the employee is entitled to payment in lieu of the leave not yet taken` `Ending: the employee resigned` 0 EQUALS NOTHING

§ `Tests -- s 87A(7) to (7C) offences and penalties`

#ASSERT `s 87A(7) the employer is guilty of an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 87A(7) the employer is guilty of an offence` FALSE EQUALS NOTHING
#ASSERT `s 87A(7) the penalty on conviction` EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 6
#ASSERT `s 87A(7A) the employer is guilty of an offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 87A(7A) the employer is guilty of an offence` TRUE TRUE EQUALS NOTHING
#ASSERT `s 87A(7A) the employer is guilty of an offence` FALSE FALSE EQUALS NOTHING
#ASSERT `s 87A(7A) the penalty on conviction` EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 6
#ASSERT `s 87A(7B) the penalty on conviction of a person convicted under subsection (7) or (7A)` (JUST TRUE) EQUALS JUST (`Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 10000, `longest imprisonment in months` IS JUST 12)
#ASSERT `s 87A(7B) the penalty on conviction of a person convicted under subsection (7) or (7A)` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 87A(7B) the penalty on conviction of a person convicted under subsection (7) or (7A)` NOTHING EQUALS NOTHING

`test earlier a` MEANS `s 87A(7C) Earlier conviction` WITH `kind of offence` IS `s 87A(7C)(a) an offence under subsection (7) or (7A)`, `the day the person was convicted or found guilty` IS Date 2 5 2013
`test earlier b` MEANS `s 87A(7C) Earlier conviction` WITH `kind of offence` IS `s 87A(7C)(b) an offence under section 12B(12) or (14) of the Child Development Co-Savings Act 2001`, `the day the person was convicted or found guilty` IS Date 1 5 2013
`test earlier c` MEANS `s 87A(7C) Earlier conviction` WITH `kind of offence` IS `s 87A(7C)(c) an offence under section 12B(13) of the Child Development Co-Savings Act 2001`, `the day the person was convicted or found guilty` IS Date 3 3 2020
`test earlier before` MEANS `s 87A(7C) Earlier conviction` WITH `kind of offence` IS `s 87A(7C)(a) an offence under subsection (7) or (7A)`, `the day the person was convicted or found guilty` IS Date 30 4 2013
`test earlier other` MEANS `s 87A(7C) Earlier conviction` WITH `kind of offence` IS `s 87A(7C) an offence of some other kind`, `the day the person was convicted or found guilty` IS Date 2 5 2013
`test earlier same day` MEANS `s 87A(7C) Earlier conviction` WITH `kind of offence` IS `s 87A(7C)(c) an offence under section 12B(13) of the Child Development Co-Savings Act 2001`, `the day the person was convicted or found guilty` IS Date 1 6 2026

#ASSERT `s 87A(7C) the person is a repeat offender` (Date 1 6 2026) (LIST `test earlier a`) EQUALS JUST TRUE
#ASSERT `s 87A(7C) the person is a repeat offender` (Date 1 6 2026) (LIST `test earlier b`) EQUALS JUST TRUE
#ASSERT `s 87A(7C) the person is a repeat offender` (Date 1 6 2026) (LIST `test earlier c`) EQUALS JUST TRUE
#ASSERT `s 87A(7C) the person is a repeat offender` (Date 1 6 2026) (LIST `test earlier before`) EQUALS JUST FALSE
#ASSERT `s 87A(7C) the person is a repeat offender` (Date 1 6 2026) (LIST `test earlier other`) EQUALS JUST FALSE
#ASSERT `s 87A(7C) the person is a repeat offender` (Date 1 6 2026) (LIST `test earlier same day`) EQUALS JUST FALSE
#ASSERT `s 87A(7C) the person is a repeat offender` (Date 1 6 2026) EMPTY EQUALS JUST FALSE
#ASSERT `s 87A(7C) the person is a repeat offender` (Date 2 5 2013) (LIST `test earlier a`) EQUALS JUST FALSE
#ASSERT `s 87A(7C) the person is a repeat offender` (Date 3 5 2013) (LIST `test earlier a`) EQUALS JUST TRUE

§ `Tests -- the twins that can say no (rulings of 2026-11-05; fork F18)`

-- s 87A(1): the yes/no question "does the entitlement arise?", with the text's own "where".
#ASSERT `s 87A(1) the entitlement to childcare leave for the relevant period arises` 3 (LIST Date 1 1 2020) `test calendar 2026` EQUALS JUST TRUE
#ASSERT `s 87A(1) the entitlement to childcare leave for the relevant period arises` 2 (LIST Date 1 1 2020) `test calendar 2026` EQUALS JUST FALSE
#ASSERT `s 87A(1) the entitlement to childcare leave for the relevant period arises` 3 (LIST Date 1 1 2020) `test calendar 2027` EQUALS JUST FALSE
#ASSERT `s 87A(1) the entitlement to childcare leave for the relevant period arises` 3 EMPTY `test calendar 2026` EQUALS JUST FALSE
-- s 87A(6): the text's own verbs, "ceases to be entitled" and "is not entitled to any payment in lieu", asked of the "If".
#ASSERT `s 87A(6)(a) the employee ceases to be entitled to the leave not yet taken` `Ending: the employee resigned` 2 EQUALS JUST TRUE
#ASSERT `s 87A(6)(a) the employee ceases to be entitled to the leave not yet taken` `Ending: it has not ended` 2 EQUALS JUST FALSE
#ASSERT `s 87A(6)(a) the employee ceases to be entitled to the leave not yet taken` `Ending: the employee resigned` 0 EQUALS JUST FALSE
#ASSERT `s 87A(6)(b) the employee is not entitled to payment in lieu of the leave not yet taken` `Ending: the employer dismissed the employee` 1 EQUALS JUST TRUE
#ASSERT `s 87A(6)(b) the employee is not entitled to payment in lieu of the leave not yet taken` `Ending: it has not ended` 1 EQUALS JUST FALSE
#ASSERT `s 87A(6)(b) the employee is not entitled to payment in lieu of the leave not yet taken` `Ending: the employee resigned` 0 EQUALS JUST FALSE
-- s 87A(7B): "Where ... is a repeat offender".
#ASSERT `s 87A(7B) the penalty for a repeat offender applies` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 87A(7B) the penalty for a repeat offender applies` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 87A(7B) the penalty for a repeat offender applies` NOTHING EQUALS NOTHING
