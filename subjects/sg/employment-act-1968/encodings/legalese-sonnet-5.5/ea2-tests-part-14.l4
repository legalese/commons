IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea2-part-14`

-- Tests for ea2-part-14.l4 (Employment Act 1968, ss 107A to 114).  Expected values were decided from the text before the
-- functions were run.

`test five thousand six months` MEANS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 6

§ `Tests -- s 107A the daily rates`

#ASSERT `s 107A(1) the gross rate of pay per day` TRUE (JUST 120) EQUALS JUST 120
#ASSERT `s 107A(1) the gross rate of pay per day` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 107A(1) the gross rate of pay per day` FALSE (JUST 120) EQUALS NOTHING
#ASSERT `s 107A(2) the basic rate of pay per day` TRUE (JUST 100) EQUALS JUST 100
#ASSERT `s 107A(2) the basic rate of pay per day` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 107A(2) the basic rate of pay per day` FALSE (JUST 100) EQUALS NOTHING

§ `Tests -- ss 108 to 111`

#ASSERT `s 108 the employer is guilty of an offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 108 the employer is guilty of an offence` TRUE TRUE EQUALS NOTHING
#ASSERT `s 108 the employer is guilty of an offence` FALSE FALSE EQUALS NOTHING
#ASSERT `s 108 the penalty on conviction` EQUALS `test five thousand six months`
#ASSERT `s 108 the court may adjudge the whole or any portion of the fine to be paid to the employee` TRUE EQUALS JUST TRUE
#ASSERT `s 108 the court may adjudge the whole or any portion of the fine to be paid to the employee` FALSE EQUALS NOTHING
#ASSERT `s 109 the employee is bound to answer for the debt, default or miscarriage of another person` TRUE EQUALS JUST FALSE
#ASSERT `s 109 the employee is bound to answer for the debt, default or miscarriage of another person` FALSE EQUALS NOTHING
#ASSERT `s 110 the employer or other person is guilty of an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 110 the employer or other person is guilty of an offence` FALSE EQUALS NOTHING
#ASSERT `s 110 the penalty on conviction` EQUALS `test five thousand six months`
#ASSERT `s 111 the person is guilty of an offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 111 the person is guilty of an offence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 111 the person is guilty of an offence` FALSE TRUE EQUALS NOTHING

§ `Tests -- ss 112 to 113 (seam S15)`

#ASSERT `s 112 first conviction` EQUALS JUST (`Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 6)
#ASSERT `s 112 subsequent conviction` EQUALS JUST (`Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 10000, `longest imprisonment in months` IS JUST 12)
#ASSERT `s 112 the penalty on conviction` TRUE FALSE EQUALS `s 112 first conviction`
#ASSERT `s 112 the penalty on conviction` TRUE TRUE EQUALS `s 112 subsequent conviction`
#ASSERT `s 112 the penalty on conviction` FALSE FALSE EQUALS NOTHING
#ASSERT `s 112 the penalty on conviction` FALSE TRUE EQUALS NOTHING
#ASSERT `s 112A the person is guilty of the offence abetted` TRUE EQUALS JUST TRUE
#ASSERT `s 112A the person is guilty of the offence abetted` FALSE EQUALS NOTHING
#ASSERT `s 112A the punishment of the person who abets` `test five thousand six months` EQUALS `test five thousand six months`
#ASSERT `s 113 the person is guilty of an offence` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 113 the person is guilty of an offence` TRUE FALSE EQUALS NOTHING
#ASSERT `s 113 the person is guilty of an offence` FALSE TRUE EQUALS NOTHING
#ASSERT `s 113 the penalty on conviction` EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 24

§ `Tests -- s 113A bodies corporate`

#ASSERT `s 113A(1) the officer of the body corporate is guilty of the offence as well` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 113A(1) the officer of the body corporate is guilty of the offence as well` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 113A(1) the officer of the body corporate is guilty of the offence as well` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 113A(1) the officer of the body corporate is guilty of the offence as well` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 113A(2) subsection (1) applies to the member as if he or she were a director` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 113A(2) subsection (1) applies to the member as if he or she were a director` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 113A(2) subsection (1) applies to the member as if he or she were a director` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 113A(3) the partner is guilty of the offence as well` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 113A(3) the partner is guilty of the offence as well` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 113A(3) the partner is guilty of the offence as well` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 113A(3) the partner is guilty of the offence as well` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 113A(4) the officer or member is guilty of the offence as well` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 113A(4) the officer or member is guilty of the offence as well` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 113A(4) the officer or member is guilty of the offence as well` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 113A(4) the officer or member is guilty of the offence as well` FALSE TRUE TRUE EQUALS JUST FALSE
-- (5): the presumption holds until the contrary is proved
#ASSERT `s 113A(5) the offence is presumed to be attributable to the neglect of the person` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 113A(5) the offence is presumed to be attributable to the neglect of the person` TRUE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 113A(5) the offence is presumed to be attributable to the neglect of the person` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 113A(5) the offence is presumed to be attributable to the neglect of the person` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 113A(5) the offence is presumed to be attributable to the neglect of the person` FALSE TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 113A(6) "body corporate" the entity is one` TRUE EQUALS JUST TRUE
#ASSERT `s 113A(6) "body corporate" the entity is one` FALSE EQUALS NOTHING
#ASSERT `s 113A(6) "officer" of a body corporate the person is one` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 113A(6) "officer" of a body corporate the person is one` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 113A(6) "officer" of a body corporate the person is one` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 113A(6) "officer" of an unincorporated association the person is one` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 113A(6) "officer" of an unincorporated association the person is one` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 113A(6) "officer" of an unincorporated association the person is one` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 113A(6) "partner" the person is one` TRUE EQUALS JUST TRUE
#ASSERT `s 113A(6) "partner" the person is one` FALSE EQUALS NOTHING

§ `Tests -- s 114 compounding`

#ASSERT `s 114 the Commissioner may compound the offence by accepting the sum` TRUE TRUE 5000 EQUALS JUST TRUE
#ASSERT `s 114 the Commissioner may compound the offence by accepting the sum` TRUE TRUE 5001 EQUALS JUST FALSE
#ASSERT `s 114 the Commissioner may compound the offence by accepting the sum` TRUE TRUE 0 EQUALS JUST TRUE
#ASSERT `s 114 the Commissioner may compound the offence by accepting the sum` FALSE TRUE 100 EQUALS NOTHING
#ASSERT `s 114 the Commissioner may compound the offence by accepting the sum` TRUE FALSE 100 EQUALS NOTHING
#ASSERT `s 114 the Commissioner may compound the offence by accepting the sum` FALSE FALSE 6000 EQUALS JUST FALSE
