IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea2-part-9a`

-- Tests for ea2-part-9a.l4 (Employment Act 1968, ss 76 to 80).  Every expected value was decided
-- from the text of the section, and written down, before the function was run; dates were worked
-- out on a calendar, not by the code.  The confinement used throughout is Wednesday 10 June 2026.

§ `Tests -- s 76(1) the female employee, and the length of the absence`

-- s 76(1) "every female employee": an employee who is female.
#ASSERT `s 76(1) the person is a female employee` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 76(1) the person is a female employee` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 76(1) the person is a female employee` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 76(1) the person is a female employee` NOTHING TRUE EQUALS NOTHING

-- s 76(1): a female employee is entitled; for anyone else the section is silent.
#ASSERT `s 76(1) the female employee is entitled to absent herself from work` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 76(1) the female employee is entitled to absent herself from work` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 76(1) the female employee is entitled to absent herself from work` NOTHING EQUALS NOTHING

-- s 76(1)(a): 4 weeks (28 days) immediately before, 8 weeks (56 days) immediately after.
-- 10 June minus 28 days is 13 May; the day before the confinement is 9 June; 10 June plus 55 days is 4 August.
#ASSERT `s 76(1)(a)(i) the 4 weeks immediately before the confinement` (Date 10 6 2026) EQUALS `Period of days` WITH `first day` IS Date 13 5 2026, `last day` IS Date 9 6 2026
#ASSERT `s 76(1)(a)(ii) the 8 weeks immediately after the confinement` (Date 10 6 2026) EQUALS `Period of days` WITH `first day` IS Date 10 6 2026, `last day` IS Date 4 8 2026

-- s 76(1)(b): 12 weeks (84 days) as agreed, starting not earlier than 28 days before the confinement
-- (13 May) and not later than the day of the confinement (10 June).
#ASSERT `s 76(1)(b) the agreed 12 weeks` (Date 10 6 2026) (Date 13 5 2026) EQUALS JUST (`Period of days` WITH `first day` IS Date 13 5 2026, `last day` IS Date 4 8 2026)
#ASSERT `s 76(1)(b) the agreed 12 weeks` (Date 10 6 2026) (Date 10 6 2026) EQUALS JUST (`Period of days` WITH `first day` IS Date 10 6 2026, `last day` IS Date 1 9 2026)
#ASSERT `s 76(1)(b) the agreed 12 weeks` (Date 10 6 2026) (Date 12 5 2026) EQUALS NOTHING
#ASSERT `s 76(1)(b) the agreed 12 weeks` (Date 10 6 2026) (Date 11 6 2026) EQUALS NOTHING

-- s 76(1)(c)(i): 8 weeks (56 days) as agreed, same window.
#ASSERT `s 76(1)(c)(i) the agreed 8 weeks` (Date 10 6 2026) (Date 13 5 2026) EQUALS JUST (`Period of days` WITH `first day` IS Date 13 5 2026, `last day` IS Date 7 7 2026)
#ASSERT `s 76(1)(c)(i) the agreed 8 weeks` (Date 10 6 2026) (Date 10 6 2026) EQUALS JUST (`Period of days` WITH `first day` IS Date 10 6 2026, `last day` IS Date 4 8 2026)
#ASSERT `s 76(1)(c)(i) the agreed 8 weeks` (Date 10 6 2026) (Date 12 5 2026) EQUALS NOTHING
#ASSERT `s 76(1)(c)(i) the agreed 8 weeks` (Date 10 6 2026) (Date 11 6 2026) EQUALS NOTHING

-- s 76(1)(c)(ii): "the Fifth Schedule or 24 days, whichever is the lower".
#ASSERT `s 76(1)(c)(ii) the least total of the further periods, in days` (JUST 10) EQUALS JUST 10
#ASSERT `s 76(1)(c)(ii) the least total of the further periods, in days` (JUST 24) EQUALS JUST 24
#ASSERT `s 76(1)(c)(ii) the least total of the further periods, in days` (JUST 25) EQUALS JUST 24
#ASSERT `s 76(1)(c)(ii) the least total of the further periods, in days` (JUST 30) EQUALS JUST 24
#ASSERT `s 76(1)(c)(ii) the least total of the further periods, in days` NOTHING EQUALS NOTHING

-- s 76(1)(c)(ii): 12 months commencing on 10 June 2026 end on 9 June 2027; commencing on 29 February
-- 2024 they end on 27 February 2025 (the 12th month ends on 28 February 2025, so the 12 months end the day before).
#ASSERT `s 76(1)(c)(ii) the 12 months within which the further periods must be taken` (Date 10 6 2026) EQUALS `Period of days` WITH `first day` IS Date 10 6 2026, `last day` IS Date 9 6 2027
#ASSERT `s 76(1)(c)(ii) the 12 months within which the further periods must be taken` (Date 29 2 2024) EQUALS `Period of days` WITH `first day` IS Date 29 2 2024, `last day` IS Date 27 2 2025

-- s 76(1)(c)(ii): two periods of 12 days (total 24) inside the 12 months satisfy it where the Fifth Schedule gives 30 (so 24 is the lower).
#ASSERT `s 76(1)(c)(ii) the further periods taken satisfy the paragraph` (Date 10 6 2026) (JUST 30) (LIST (`Period of days` WITH `first day` IS Date 1 1 2027, `last day` IS Date 12 1 2027), (`Period of days` WITH `first day` IS Date 1 3 2027, `last day` IS Date 12 3 2027)) EQUALS JUST TRUE
-- 23 days in aggregate: short by one.
#ASSERT `s 76(1)(c)(ii) the further periods taken satisfy the paragraph` (Date 10 6 2026) (JUST 30) (LIST (`Period of days` WITH `first day` IS Date 1 1 2027, `last day` IS Date 12 1 2027), (`Period of days` WITH `first day` IS Date 1 3 2027, `last day` IS Date 11 3 2027)) EQUALS JUST FALSE
-- the last day of the 12 months (9 June 2027) is inside; 10 June 2027 is outside.
#ASSERT `s 76(1)(c)(ii) the further periods taken satisfy the paragraph` (Date 10 6 2026) (JUST 24) (LIST (`Period of days` WITH `first day` IS Date 17 5 2027, `last day` IS Date 9 6 2027)) EQUALS JUST TRUE
#ASSERT `s 76(1)(c)(ii) the further periods taken satisfy the paragraph` (Date 10 6 2026) (JUST 24) (LIST (`Period of days` WITH `first day` IS Date 18 5 2027, `last day` IS Date 10 6 2027)) EQUALS JUST FALSE
-- a period that begins before the confinement is outside.
#ASSERT `s 76(1)(c)(ii) the further periods taken satisfy the paragraph` (Date 10 6 2026) (JUST 24) (LIST (`Period of days` WITH `first day` IS Date 9 6 2026, `last day` IS Date 2 7 2026)) EQUALS JUST FALSE
-- the Fifth Schedule's answer is not known.
#ASSERT `s 76(1)(c)(ii) the further periods taken satisfy the paragraph` (Date 10 6 2026) NOTHING (LIST (`Period of days` WITH `first day` IS Date 1 1 2027, `last day` IS Date 24 1 2027)) EQUALS NOTHING

§ `Tests -- s 76(1A) and (3) the benefit period and the payment`

-- (a): 13 May to 7 July 2026, 56 days (28 before, and the first 28 days from the day of the confinement).
#ASSERT `s 76(1A) the benefit period` `s 76(1A) absence under subsection (1)(a)` (Date 10 6 2026) (Date 1 1 2000) EQUALS JUST (`Period of days` WITH `first day` IS Date 13 5 2026, `last day` IS Date 7 7 2026)
-- (b): the first 8 weeks of an agreed 12 weeks starting 13 May: 13 May to 7 July.
#ASSERT `s 76(1A) the benefit period` `s 76(1A) absence under subsection (1)(b)` (Date 10 6 2026) (Date 13 5 2026) EQUALS JUST (`Period of days` WITH `first day` IS Date 13 5 2026, `last day` IS Date 7 7 2026)
-- (b) starting on the day of the confinement: 10 June to 4 August.
#ASSERT `s 76(1A) the benefit period` `s 76(1A) absence under subsection (1)(b)` (Date 10 6 2026) (Date 10 6 2026) EQUALS JUST (`Period of days` WITH `first day` IS Date 10 6 2026, `last day` IS Date 4 8 2026)
-- (b) starting outside its window: the paragraph gives no period.
#ASSERT `s 76(1A) the benefit period` `s 76(1A) absence under subsection (1)(b)` (Date 10 6 2026) (Date 12 5 2026) EQUALS NOTHING
-- (c): the 8 weeks of (1)(c)(i).
#ASSERT `s 76(1A) the benefit period` `s 76(1A) absence under subsection (1)(c)` (Date 10 6 2026) (Date 13 5 2026) EQUALS JUST (`Period of days` WITH `first day` IS Date 13 5 2026, `last day` IS Date 7 7 2026)
#ASSERT `s 76(1A) the benefit period` `s 76(1A) absence under subsection (1)(c)` (Date 10 6 2026) (Date 11 6 2026) EQUALS NOTHING

#ASSERT `s 76(1A) the female employee is entitled to payment at her gross rate of pay for the benefit period` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 76(1A) the female employee is entitled to payment at her gross rate of pay for the benefit period` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 76(1A) the female employee is entitled to payment at her gross rate of pay for the benefit period` NOTHING EQUALS NOTHING

-- 56 days at $100 a day is $5,600; no days is nothing owed; an unknown daily rate is unknown.
#ASSERT `s 76(1A) the sum payable for the days of the benefit period` 56 (JUST 100) EQUALS JUST 5600
#ASSERT `s 76(1A) the sum payable for the days of the benefit period` 0 (JUST 100) EQUALS JUST 0
#ASSERT `s 76(1A) the sum payable for the days of the benefit period` 56 NOTHING EQUALS NOTHING

-- s 76(3): 3 days worked at $120 a day: $360, or 3 other days off.
#ASSERT `s 76(3) the amount equivalent to a day's pay for the days worked` 3 (JUST 120) EQUALS JUST 360
#ASSERT `s 76(3) the amount equivalent to a day's pay for the days worked` 0 (JUST 120) EQUALS JUST 0
#ASSERT `s 76(3) the amount equivalent to a day's pay for the days worked` 3 NOTHING EQUALS NOTHING
#ASSERT `s 76(3) the days she may absent herself instead at the end of the benefit period` 3 EQUALS 3

§ `Tests -- s 76(2), (2A), (2B) service needed before the confinement`

-- s 76(2): delivered and certified due before 1 May 2013; less than 90 days' service: not entitled.
#ASSERT `s 76(2) the female employee is entitled to pay during the benefit period` (Date 30 4 2013) (JUST (Date 15 4 2013)) 89 EQUALS JUST FALSE
-- exactly 90 days is not "less than 90 days": the subsection says nothing.
#ASSERT `s 76(2) the female employee is entitled to pay during the benefit period` (Date 30 4 2013) (JUST (Date 15 4 2013)) 90 EQUALS NOTHING
-- delivered on 1 May 2013: not this subsection.
#ASSERT `s 76(2) the female employee is entitled to pay during the benefit period` (Date 1 5 2013) (JUST (Date 15 4 2013)) 10 EQUALS NOTHING
-- certified due on 1 May 2013: not this subsection (it is (2A)(b)'s case).
#ASSERT `s 76(2) the female employee is entitled to pay during the benefit period` (Date 30 4 2013) (JUST (Date 1 5 2013)) 10 EQUALS NOTHING
#ASSERT `s 76(2) the female employee is entitled to pay during the benefit period` (Date 30 4 2013) NOTHING 10 EQUALS NOTHING

-- s 76(2A)(a): delivered on or after 1 May 2013 and before 22 August 2015; less than 3 months' service.
#ASSERT `s 76(2A) the female employee is entitled to pay during the benefit period` (Date 1 5 2013) NOTHING 2 EQUALS JUST FALSE
#ASSERT `s 76(2A) the female employee is entitled to pay during the benefit period` (Date 21 8 2015) NOTHING 2 EQUALS JUST FALSE
-- 3 completed months is not "less than 3 months".
#ASSERT `s 76(2A) the female employee is entitled to pay during the benefit period` (Date 1 5 2013) NOTHING 3 EQUALS NOTHING
-- delivered on 22 August 2015 or after: subsection (2B), not (2A).
#ASSERT `s 76(2A) the female employee is entitled to pay during the benefit period` (Date 22 8 2015) NOTHING 2 EQUALS NOTHING
-- s 76(2A)(b): delivered before 1 May 2013 but certified due on or after 1 May 2013.
#ASSERT `s 76(2A) the female employee is entitled to pay during the benefit period` (Date 30 4 2013) (JUST (Date 1 5 2013)) 2 EQUALS JUST FALSE
#ASSERT `s 76(2A) the female employee is entitled to pay during the benefit period` (Date 30 4 2013) (JUST (Date 30 4 2013)) 2 EQUALS NOTHING
#ASSERT `s 76(2A) the female employee is entitled to pay during the benefit period` (Date 30 4 2013) NOTHING 2 EQUALS NOTHING

-- s 76(2B)(a): delivered on or after 22 August 2015; has not served at least 3 months.
#ASSERT `s 76(2B) the female employee is entitled to pay during the benefit period` (Date 22 8 2015) NOTHING 2 EQUALS JUST FALSE
#ASSERT `s 76(2B) the female employee is entitled to pay during the benefit period` (Date 22 8 2015) NOTHING 3 EQUALS NOTHING
-- s 76(2B)(b): delivered before 22 August 2015 but certified due on or after it.
#ASSERT `s 76(2B) the female employee is entitled to pay during the benefit period` (Date 21 8 2015) (JUST (Date 22 8 2015)) 2 EQUALS JUST FALSE
#ASSERT `s 76(2B) the female employee is entitled to pay during the benefit period` (Date 21 8 2015) (JUST (Date 21 8 2015)) 2 EQUALS NOTHING
#ASSERT `s 76(2B) the female employee is entitled to pay during the benefit period` (Date 21 8 2015) NOTHING 2 EQUALS NOTHING

§ `Tests -- s 76(4) and (5) two or more living children`

-- (4): 2 living children born in 2 previous confinements: no payment.
#ASSERT `s 76(4) the female employee is entitled to payment under subsection (1A) for the confinement` 2 2 FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 76(4) the female employee is entitled to payment under subsection (1A) for the confinement` 3 3 FALSE FALSE EQUALS JUST FALSE
-- twins: 2 living children born in ONE previous confinement: (b) is not met.
#ASSERT `s 76(4) the female employee is entitled to payment under subsection (1A) for the confinement` 2 1 FALSE FALSE EQUALS NOTHING
-- one living child, even from 2 confinements: (a) is not met.
#ASSERT `s 76(4) the female employee is entitled to payment under subsection (1A) for the confinement` 1 2 FALSE FALSE EQUALS NOTHING
-- a collective agreement or award to the contrary.
#ASSERT `s 76(4) the female employee is entitled to payment under subsection (1A) for the confinement` 2 2 TRUE FALSE EQUALS NOTHING
-- a class the Minister has specified under (5).
#ASSERT `s 76(4) the female employee is entitled to payment under subsection (1A) for the confinement` 2 2 FALSE TRUE EQUALS NOTHING
#ASSERT `s 76(5) subsection (4) applies to the female employee` TRUE EQUALS JUST FALSE
#ASSERT `s 76(5) subsection (4) applies to the female employee` FALSE EQUALS NOTHING

§ `Tests -- s 76(5A) and (6) leaving the employment before the absence is used up`

#ASSERT `s 76(5A)(a) the female employee keeps the entitlement to absent herself from work` `Ending: the employee resigned` TRUE EQUALS JUST FALSE
#ASSERT `s 76(5A)(b) the female employee keeps the entitlement to payment at her gross rate of pay for the forfeited period` `Ending: the employee resigned` TRUE EQUALS JUST FALSE
-- resigned but nothing is left to forfeit.
#ASSERT `s 76(5A)(a) the female employee keeps the entitlement to absent herself from work` `Ending: the employee resigned` FALSE EQUALS NOTHING
-- not a resignation: (5A) is silent (s 76(6) deals with the (1)(c)(ii) periods).
#ASSERT `s 76(5A)(a) the female employee keeps the entitlement to absent herself from work` `Ending: the employer dismissed the employee` TRUE EQUALS NOTHING
#ASSERT `s 76(5A)(b) the female employee keeps the entitlement to payment at her gross rate of pay for the forfeited period` `Ending: it has not ended` TRUE EQUALS NOTHING

#ASSERT `s 76(6) the female employee keeps the entitlement under subsection (1)(c)(ii)` `Ending: the employer dismissed the employee` TRUE EQUALS JUST FALSE
#ASSERT `s 76(6) the female employee keeps the entitlement under subsection (1)(c)(ii)` `Ending: the specified work was completed or the specified period expired` TRUE EQUALS JUST FALSE
#ASSERT `s 76(6) the female employee keeps the entitlement under subsection (1)(c)(ii)` `Ending: it ended in some other way` TRUE EQUALS JUST FALSE
-- a resignation is not within (6); neither is an employment that has not ended; neither is a fully used entitlement.
#ASSERT `s 76(6) the female employee keeps the entitlement under subsection (1)(c)(ii)` `Ending: the employee resigned` TRUE EQUALS NOTHING
#ASSERT `s 76(6) the female employee keeps the entitlement under subsection (1)(c)(ii)` `Ending: it has not ended` TRUE EQUALS NOTHING
#ASSERT `s 76(6) the female employee keeps the entitlement under subsection (1)(c)(ii)` `Ending: the employer dismissed the employee` FALSE EQUALS NOTHING

§ `Tests -- ss 77 and 78 the days that are paid, and when`

#ASSERT `s 77(1) the payment referred to in section 76 must be paid for the day` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 77(1) the payment referred to in section 76 must be paid for the day` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 77(1) the payment referred to in section 76 must be paid for the day` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 77(1) the payment referred to in section 76 must be paid for the day` FALSE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 77(2) section 77 requires the employer to pay an extra day's salary for the holiday` TRUE EQUALS JUST FALSE
#ASSERT `s 77(2) section 77 requires the employer to pay an extra day's salary for the holiday` FALSE EQUALS NOTHING

#ASSERT `s 78(1) the payment is made in 2 instalments` TRUE EQUALS JUST TRUE
#ASSERT `s 78(1) the payment is made in 2 instalments` FALSE EQUALS NOTHING
-- 13 May to 10 June inclusive is 29 days; nothing if the benefit period starts after the confinement.
#ASSERT `s 78(1) the days of the benefit period in the first instalment` (Date 13 5 2026) (Date 10 6 2026) EQUALS 29
#ASSERT `s 78(1) the days of the benefit period in the first instalment` (Date 10 6 2026) (Date 10 6 2026) EQUALS 1
#ASSERT `s 78(1) the days of the benefit period in the first instalment` (Date 15 6 2026) (Date 10 6 2026) EQUALS 0
-- 7 days from Wednesday 10 June 2026 is Wednesday 17 June.
#ASSERT `s 78(1) the last day for paying the first instalment` (Date 10 6 2026) EMPTY EQUALS JUST (Date 17 6 2026)
-- 17 June a public holiday: carried to Thursday 18 June (Interpretation Act s 50(b)).
#ASSERT `s 78(1) the last day for paying the first instalment` (Date 10 6 2026) (LIST (Date 17 6 2026)) EQUALS JUST (Date 18 6 2026)
-- 7 June 2026 is a Sunday; 7 days from it is Sunday 14 June, carried to Monday 15 June.
#ASSERT `s 78(1) the last day for paying the first instalment` (Date 7 6 2026) EMPTY EQUALS JUST (Date 15 6 2026)
-- the second instalment: 7 days from the end of the benefit period, Tuesday 7 July 2026: Tuesday 14 July.
#ASSERT `s 78(1) the last day for paying the second instalment` (Date 7 7 2026) EMPTY EQUALS JUST (Date 14 7 2026)
#ASSERT `s 78(2) the date by which the payment must be paid` FALSE (Date 30 6 2026) EQUALS JUST (Date 30 6 2026)
#ASSERT `s 78(2) the date by which the payment must be paid` TRUE (Date 30 6 2026) EQUALS NOTHING

§ `Tests -- s 79 if the female employee dies`

#ASSERT `s 79(1) the person to whom the employer must pay` TRUE EQUALS `s 79 the person she nominated under section 80(4)`
#ASSERT `s 79(1) the person to whom the employer must pay` FALSE EQUALS `s 79 her personal representative`
#ASSERT `s 79(1) the employer must pay a sum of money after her death` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 79(1) the employer must pay a sum of money after her death` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 79(1) the employer must pay a sum of money after her death` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 79(1) the employer must pay a sum of money after her death` TRUE TRUE FALSE EQUALS JUST FALSE
-- last worked 1 June, died 5 June: the 2nd, 3rd and 4th, three days.
#ASSERT `s 79(1) the days for which the sum is payable` (Date 1 6 2026) (Date 5 6 2026) EQUALS 3
#ASSERT `s 79(1) the days for which the sum is payable` (Date 1 6 2026) (Date 2 6 2026) EQUALS 0
#ASSERT `s 79(1) the days for which the sum is payable` (Date 1 6 2026) (Date 1 6 2026) EQUALS 0
#ASSERT `s 79(1) the sum payable` 3 (JUST 100) EQUALS JUST 300
#ASSERT `s 79(1) the sum payable` 3 NOTHING EQUALS NOTHING
-- the 30-day cap applies outside the subsection's own circumstances.
#ASSERT `s 79(1) the employer is liable to pay a sum in respect of the period` FALSE 31 EQUALS JUST FALSE
#ASSERT `s 79(1) the employer is liable to pay a sum in respect of the period` FALSE 30 EQUALS NOTHING
#ASSERT `s 79(1) the employer is liable to pay a sum in respect of the period` TRUE 40 EQUALS NOTHING
#ASSERT `s 79(2) the employer must pay a sum of money after her death` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 79(2) the employer must pay a sum of money after her death` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 79(2) the employer must pay a sum of money after her death` TRUE FALSE EQUALS JUST FALSE
-- benefit period 13 May to 7 July; she dies 1 June: paid up to 31 May, 19 days.
#ASSERT `s 79(2) the days of the benefit period up to the day before her death` (Date 13 5 2026) (Date 7 7 2026) (Date 1 6 2026) EQUALS 19
#ASSERT `s 79(2) the days of the benefit period up to the day before her death` (Date 13 5 2026) (Date 7 7 2026) (Date 13 5 2026) EQUALS 0
#ASSERT `s 79(2) the days of the benefit period up to the day before her death` (Date 13 5 2026) (Date 7 7 2026) (Date 8 7 2026) EQUALS 56
#ASSERT `s 79(2) the days of the benefit period up to the day before her death` (Date 13 5 2026) (Date 7 7 2026) (Date 20 7 2026) EQUALS 56

§ `Tests -- s 80 notice of confinement`

#ASSERT `s 80(1) the female employee must give her employer notice of the date she intends to begin absenting herself` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 80(1) the female employee must give her employer notice of the date she intends to begin absenting herself` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 80(1) the female employee must give her employer notice of the date she intends to begin absenting herself` NOTHING EQUALS NOTHING
-- notice on 1 June for an absence from 8 June is 7 days; from 7 June is 6 days.
#ASSERT `s 80(1) the notice is given at least one week before the first day of absence` (Date 1 6 2026) (Date 8 6 2026)
#ASSERT NOT (`s 80(1) the notice is given at least one week before the first day of absence` (Date 1 6 2026) (Date 7 6 2026))
#ASSERT `s 80(2) the female employee who has been confined must inform her employer of the date of the confinement` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 80(2) the female employee who has been confined must inform her employer of the date of the confinement` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 80(2) the female employee who has been confined must inform her employer of the date of the confinement` NOTHING EQUALS NOTHING
#ASSERT `s 80(3) the female employee is entitled to only half the amount of the payment` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 80(3) the female employee is entitled to only half the amount of the payment` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 80(3) the female employee is entitled to only half the amount of the payment` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 80(3) the female employee is entitled to only half the amount of the payment` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 80(3) the female employee is entitled to only half the amount of the payment` FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 80(3) the amount of the payment` 5600 (JUST TRUE) EQUALS JUST 2800
#ASSERT `s 80(3) the amount of the payment` 5600 (JUST FALSE) EQUALS NOTHING
#ASSERT `s 80(3) the amount of the payment` 5600 NOTHING EQUALS NOTHING
#ASSERT `s 80(4) the payment is deemed to be payment to the female employee` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 80(4) the payment is deemed to be payment to the female employee` FALSE TRUE EQUALS NOTHING
#ASSERT `s 80(4) the payment is deemed to be payment to the female employee` TRUE FALSE EQUALS NOTHING

§ `Tests -- the twins that can say no (rulings of 2026-11-05; fork F18)`

-- s 76(1)(b), confinement on 10 June 2026: the window is 13 May 2026 (28 days before) to 10 June 2026.
#ASSERT `s 76(1)(b) the agreed 12 weeks begin inside the window` (Date 10 6 2026) (Date 13 5 2026) EQUALS JUST TRUE
#ASSERT `s 76(1)(b) the agreed 12 weeks begin inside the window` (Date 10 6 2026) (Date 10 6 2026) EQUALS JUST TRUE
#ASSERT `s 76(1)(b) the agreed 12 weeks begin inside the window` (Date 10 6 2026) (Date 12 5 2026) EQUALS JUST FALSE
#ASSERT `s 76(1)(b) the agreed 12 weeks begin inside the window` (Date 10 6 2026) (Date 11 6 2026) EQUALS JUST FALSE
-- the period function itself still cannot say no.
#ASSERT `s 76(1)(b) the agreed 12 weeks` (Date 10 6 2026) (Date 11 6 2026) EQUALS NOTHING
-- s 76(1)(c)(i), the same window.
#ASSERT `s 76(1)(c)(i) the agreed 8 weeks begin inside the window` (Date 10 6 2026) (Date 13 5 2026) EQUALS JUST TRUE
#ASSERT `s 76(1)(c)(i) the agreed 8 weeks begin inside the window` (Date 10 6 2026) (Date 12 5 2026) EQUALS JUST FALSE
#ASSERT `s 76(1)(c)(i) the agreed 8 weeks begin inside the window` (Date 10 6 2026) (Date 11 6 2026) EQUALS JUST FALSE
-- s 76(1)(c)(ii): a period outside the 12 months is the text's no even when the Fifth Schedule's answer is not known.
#ASSERT `s 76(1)(c)(ii) the further periods taken satisfy the paragraph` (Date 10 6 2026) NOTHING (LIST (`Period of days` WITH `first day` IS Date 1 3 2027, `last day` IS Date 1 7 2027)) EQUALS JUST FALSE
-- and a period inside them when the Fifth Schedule's answer is not known stays unanswered.
#ASSERT `s 76(1)(c)(ii) helper: the total of the further periods is long enough` NOTHING (LIST (`Period of days` WITH `first day` IS Date 1 1 2027, `last day` IS Date 24 1 2027)) EQUALS NOTHING
-- s 76(1)(c)(ii): 1 to 24 January is 24 days (both ends counted), not shorter than the least total of 24; 23 days is shorter (the text says "no shorter than").
#ASSERT `s 76(1)(c)(ii) helper: the total of the further periods is long enough` (JUST 24) (LIST (`Period of days` WITH `first day` IS Date 1 1 2027, `last day` IS Date 24 1 2027)) EQUALS JUST TRUE
#ASSERT `s 76(1)(c)(ii) helper: the total of the further periods is long enough` (JUST 24) (LIST (`Period of days` WITH `first day` IS Date 1 1 2027, `last day` IS Date 23 1 2027)) EQUALS JUST FALSE

-- s 76(5A) and (6): the twins ask the text's own question, "does she forfeit?"; where the "Where" fails the text's answer is no.
#ASSERT `s 76(5A)(a) the female employee forfeits the entitlement to absent herself from work` `Ending: the employee resigned` TRUE EQUALS JUST TRUE
#ASSERT `s 76(5A)(a) the female employee forfeits the entitlement to absent herself from work` `Ending: the employee resigned` FALSE EQUALS JUST FALSE
#ASSERT `s 76(5A)(a) the female employee forfeits the entitlement to absent herself from work` `Ending: the employer dismissed the employee` TRUE EQUALS JUST FALSE
#ASSERT `s 76(5A)(a) the female employee forfeits the entitlement to absent herself from work` `Ending: it has not ended` TRUE EQUALS JUST FALSE
#ASSERT `s 76(5A)(b) the female employee forfeits the entitlement to payment at her gross rate of pay for the forfeited period` `Ending: the employee resigned` TRUE EQUALS JUST TRUE
#ASSERT `s 76(5A)(b) the female employee forfeits the entitlement to payment at her gross rate of pay for the forfeited period` `Ending: it has not ended` TRUE EQUALS JUST FALSE
#ASSERT `s 76(6) the female employee forfeits the entitlement under subsection (1)(c)(ii)` `Ending: the employer dismissed the employee` TRUE EQUALS JUST TRUE
#ASSERT `s 76(6) the female employee forfeits the entitlement under subsection (1)(c)(ii)` `Ending: the employer dismissed the employee` FALSE EQUALS JUST FALSE
#ASSERT `s 76(6) the female employee forfeits the entitlement under subsection (1)(c)(ii)` `Ending: the employee resigned` TRUE EQUALS JUST FALSE
#ASSERT `s 76(6) the female employee forfeits the entitlement under subsection (1)(c)(ii)` `Ending: it has not ended` TRUE EQUALS JUST FALSE

-- s 78(1): the first instalment is due within 7 days from 10 June 2026, so by 17 June 2026; the second within 7 days from 7 July 2026, so by 14 July 2026.
#ASSERT `s 78(1) the first instalment is paid within 7 days from the date of confinement` (Date 17 6 2026) (Date 10 6 2026) EMPTY EQUALS JUST TRUE
#ASSERT `s 78(1) the first instalment is paid within 7 days from the date of confinement` (Date 18 6 2026) (Date 10 6 2026) EMPTY EQUALS JUST FALSE
#ASSERT `s 78(1) the first instalment is paid within 7 days from the date of confinement` (Date 18 6 2026) (Date 10 6 2026) (LIST (Date 17 6 2026)) EQUALS JUST TRUE
#ASSERT `s 78(1) the second instalment is paid within 7 days from the end of the benefit period` (Date 14 7 2026) (Date 7 7 2026) EMPTY EQUALS JUST TRUE
#ASSERT `s 78(1) the second instalment is paid within 7 days from the end of the benefit period` (Date 15 7 2026) (Date 7 7 2026) EMPTY EQUALS JUST FALSE
