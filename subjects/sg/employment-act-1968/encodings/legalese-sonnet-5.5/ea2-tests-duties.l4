IMPORT prelude
IMPORT daydate
IMPORT `ea2-duties`

-- Tests for ea2-duties.l4 (the duties as regulative rules).  Expected values were decided from the text, and dates worked out on a calendar.
-- The regulative rules themselves are run with #TRACE in ea2-duties.l4: on the main build a #TRACE or #EVAL value of a regulative rule
-- cannot be compared in an #ASSERT (eval/unsupported-equality, NOTES.md), so what is asserted here is the DECISION FUNCTION that gives
-- each rule its days, and the traces in ea2-duties.l4 are read by eye and recorded in NOTES.md.

-- s 78(1): confinement Wednesday 10 June 2026.  First instalment within 7 days: Wednesday 17 June.
#ASSERT `s 78(1) the days allowed for the first instalment` (Date 10 6 2026) (LIST Date 17 6 2026) EQUALS JUST 8
#ASSERT `s 78(1) the days allowed for the first instalment` (Date 10 6 2026) (LIST Date 18 6 2026) EQUALS JUST 7
-- 12 June 2026 + 7 = 19 June (Friday)
#ASSERT `s 78(1) the days allowed for the first instalment` (Date 12 6 2026) EMPTY EQUALS JUST 7
-- Saturday 13 June + 7 = Saturday 20 June; not a Sunday, so the day stands
#ASSERT `s 78(1) the days allowed for the first instalment` (Date 13 6 2026) EMPTY EQUALS JUST 7
-- Sunday 14 June + 7 = Sunday 21 June: moves to Monday 22 June, 8 days from the confinement
#ASSERT `s 78(1) the days allowed for the first instalment` (Date 14 6 2026) EMPTY EQUALS JUST 8
-- second instalment: benefit period ends Tuesday 7 July; + 7 = Tuesday 14 July; the day of confinement 10 June is 34 days before
#ASSERT `s 78(1) the days allowed for the second instalment` (Date 10 6 2026) (Date 7 7 2026) EMPTY EQUALS JUST 34
#ASSERT `s 78(1) the days allowed for the second instalment` (Date 10 6 2026) (Date 7 7 2026) (LIST Date 14 7 2026) EQUALS JUST 35

-- s 80(1): notice at least one week before the first day of absence.  Today Monday 1 June, absence begins Monday 22 June:
-- 21 days away, so the notice is due within 14 days.
#ASSERT `s 80(1) the days from today until the last day for giving the notice` (Date 1 6 2026) (Date 22 6 2026) EQUALS 14
#ASSERT `s 80(1) the days from today until the last day for giving the notice` (Date 1 6 2026) (Date 8 6 2026) EQUALS 0
#ASSERT `s 80(1) the days from today until the last day for giving the notice` (Date 1 6 2026) (Date 7 6 2026) EQUALS -1

-- s 87A(4): the last day of the relevant period 31 December 2026; today 1 December 2026: 30 days.
#ASSERT `s 87A(4) the days from today until the last day of the relevant period` (Date 1 12 2026) (Date 31 12 2026) EQUALS 30
#ASSERT `s 87A(4) the days from today until the last day of the relevant period` (Date 31 12 2026) (Date 31 12 2026) EQUALS 0

-- s 88A(6)(a): 12 months of continuous service ended 31 March 2026; the last day is 31 March 2027, 365 days from 31 March 2026.
#ASSERT `s 88A(6)(a) the days from today until the last day for taking the paid annual leave` (Date 31 3 2026) (JUST TRUE) (JUST FALSE) (Date 31 3 2026) EQUALS JUST 365
#ASSERT `s 88A(6)(a) the days from today until the last day for taking the paid annual leave` (Date 31 3 2026) (JUST FALSE) (JUST FALSE) (Date 31 3 2026) EQUALS NOTHING

-- s 95A(2) and para 4 of the Notification, with the other boundaries.
#ASSERT `s 95A(2) the days allowed for giving the written record` (Date 4 5 2026) EMPTY EQUALS JUST 14
-- start Sunday 3 May: 17 May is a Sunday, so the last day is Monday 18 May: 15 days
#ASSERT `s 95A(2) the days allowed for giving the written record` (Date 3 5 2026) EMPTY EQUALS JUST 15
-- notice Friday 6 November 2026: Mon 9 (1), Tue 10 (2), Wed 11 (3), Thu 12 (4), Fri 13 (5): 7 days
#ASSERT `S 200/2019 para 4 the days allowed for giving the retrenchment report` (Date 6 11 2026) EMPTY EQUALS 7
-- notice Saturday 7 November 2026: Mon 9 (1) ... Fri 13 (5): 6 days
#ASSERT `S 200/2019 para 4 the days allowed for giving the retrenchment report` (Date 7 11 2026) EMPTY EQUALS 6
