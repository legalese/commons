#ASSERT `s 32(2) subsection (1) applies to the deduction` TRUE EQUALS JUST FALSE
#ASSERT `s 32(2) subsection (1) applies to the deduction` FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `s 33 Priority of salary to other debts`
-- A monthly pay record: 3000 for the work, 500 overtime, 400 bonus, 100 commission, 50 productivity incentive, 70 travelling allowance, 30 food allowance, 20 housing allowance, 200 other allowances.
-- Salary (s 2(1)) is 3000 + 500 + 400 + 100 + 50 + 30 + 20 + 200 = 4300 (the travelling allowance is out of salary).
-- Taking off overtime, bonus, productivity incentive and the allowances (500 + 400 + 50 + 30 + 20 + 200 = 1200) leaves 3100.
`a monthly pay record` MEANS `Pay for a period` WITH `the amounts are for` IS `Pay is fixed for each month`, `pay for the work, with wage adjustments and increments` IS 3000, `overtime payments` IS 500, `bonus payments or annual wage supplements` IS 400, `commissions` IS 100, `productivity incentive payments` IS 50, `sums paid to reimburse special expenses incurred in the course of employment` IS 0, `travelling allowances` IS 70, `food allowances` IS 30, `housing allowances` IS 20, `allowances of any other kind` IS 200, `value of house accommodation, electricity, water, medical attendance or other amenity` IS 0, `value of a service excluded by order of the Minister` IS 0, `value of a travelling concession` IS 0, `employer's contributions on its own account to a pension fund or provident fund` IS 0, `gratuity payable on discharge or retirement` IS 0, `retrenchment benefit payable on retrenchment` IS 0
`a weekly pay record` MEANS `Pay for a period` WITH `the amounts are for` IS `Pay is fixed for each week`, `pay for the work, with wage adjustments and increments` IS 700, `overtime payments` IS 0, `bonus payments or annual wage supplements` IS 0, `commissions` IS 0, `productivity incentive payments` IS 0, `sums paid to reimburse special expenses incurred in the course of employment` IS 0, `travelling allowances` IS 0, `food allowances` IS 0, `housing allowances` IS 0, `allowances of any other kind` IS 0, `value of house accommodation, electricity, water, medical attendance or other amenity` IS 0, `value of a service excluded by order of the Minister` IS 0, `value of a travelling concession` IS 0, `employer's contributions on its own account to a pension fund or provident fund` IS 0, `gratuity payable on discharge or retirement` IS 0, `retrenchment benefit payable on retrenchment` IS 0
#ASSERT `s 33(1) the monthly salary measured against the ceiling` `a monthly pay record` EQUALS JUST 3100
#ASSERT `s 33(1) the monthly salary measured against the ceiling` `a weekly pay record` EQUALS NOTHING
-- (1)(a): arguments are: a workman, the salary measured, the Minister's substitute for $4,500.
#ASSERT `s 33(1)(a) the person is a workman to whom this section applies` TRUE (JUST 3100) NOTHING EQUALS JUST TRUE
#ASSERT `s 33(1)(a) the person is a workman to whom this section applies` TRUE (JUST 4500) NOTHING EQUALS JUST TRUE
#ASSERT `s 33(1)(a) the person is a workman to whom this section applies` TRUE (JUST 4501) NOTHING EQUALS JUST FALSE
#ASSERT `s 33(1)(a) the person is a workman to whom this section applies` FALSE (JUST 3100) NOTHING EQUALS JUST FALSE
#ASSERT `s 33(1)(a) the person is a workman to whom this section applies` TRUE NOTHING NOTHING EQUALS NOTHING
-- a substitute amount takes the place of $4,500.
#ASSERT `s 33(1)(a) the person is a workman to whom this section applies` TRUE (JUST 3100) (JUST 3000) EQUALS JUST FALSE
#ASSERT `s 33(1)(a) the person is a workman to whom this section applies` TRUE (JUST 4800) (JUST 5000) EQUALS JUST TRUE
-- (1)(b): arguments are: a workman, managerial or executive, the salary measured, the Minister's substitute for $2,600.
#ASSERT `s 33(1)(b) the employee is one to whom this section applies` FALSE FALSE (JUST 2600) NOTHING EQUALS JUST TRUE
#ASSERT `s 33(1)(b) the employee is one to whom this section applies` FALSE FALSE (JUST 2601) NOTHING EQUALS JUST FALSE
#ASSERT `s 33(1)(b) the employee is one to whom this section applies` TRUE FALSE (JUST 2000) NOTHING EQUALS JUST FALSE
#ASSERT `s 33(1)(b) the employee is one to whom this section applies` FALSE TRUE (JUST 2000) NOTHING EQUALS JUST FALSE
#ASSERT `s 33(1)(b) the employee is one to whom this section applies` FALSE FALSE NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 33(1)(b) the employee is one to whom this section applies` FALSE FALSE (JUST 2700) (JUST 3000) EQUALS JUST TRUE
-- (2): arguments are: a sale or garnishment on the application of a mortgagee or judgment creditor, the court has ascertained and paid the salary due.
#ASSERT `s 33(2) the court may distribute the proceeds or the money to the person entitled` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 33(2) the court may distribute the proceeds or the money to the person entitled` TRUE TRUE EQUALS NOTHING
#ASSERT `s 33(2) the court may distribute the proceeds or the money to the person entitled` FALSE FALSE EQUALS NOTHING
-- (3): "applies only to" four kinds.
#ASSERT `s 33(3) subsection (2) applies to the property or money` `s 33(3)(a) property on which the employees were or are working` EQUALS JUST TRUE
#ASSERT `s 33(3) subsection (2) applies to the property or money` `s 33(3)(b) property that was or is the produce of the work of the employees` EQUALS JUST TRUE
#ASSERT `s 33(3) subsection (2) applies to the property or money` `s 33(3)(c) movable property used or being used by the employees in the course of their work` EQUALS JUST TRUE
#ASSERT `s 33(3) subsection (2) applies to the property or money` `s 33(3)(d) money due to the employer in respect of work done by the employees` EQUALS JUST TRUE
#ASSERT `s 33(3) subsection (2) applies to the property or money` `s 33(3) property or money of some other kind` EQUALS JUST FALSE
-- (4): five months' salary at most.
#ASSERT `s 33(4) the most payable to the employee under subsection (2)` 20000 3000 EQUALS 15000
#ASSERT `s 33(4) the most payable to the employee under subsection (2)` 10000 3000 EQUALS 10000
-- (7)
#ASSERT `s 33(7) the person is an employee for the purposes of this section` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 33(7) the person is an employee for the purposes of this section` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 33(7) the person is an employee for the purposes of this section` FALSE FALSE EQUALS NOTHING
#ASSERT `s 33(7) the sum is salary for the purposes of this section` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 33(7) the sum is salary for the purposes of this section` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 33(7) the sum is salary for the purposes of this section` FALSE FALSE EQUALS NOTHING

