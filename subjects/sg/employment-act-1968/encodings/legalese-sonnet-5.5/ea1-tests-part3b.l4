§ `s 31 Recovery of advances and loans`
-- (1): arguments are: an advance made before the commencement of the contract, the payment is the first for a completed salary period.
#ASSERT `s 31(1) the recovery of the advance may begin with the payment` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 31(1) the recovery of the advance may begin with the payment` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 31(1) the recovery of the advance may begin with the payment` FALSE TRUE EQUALS NOTHING
#ASSERT `s 31(1) the advance may be recovered` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 31(1) the advance may be recovered` TRUE FALSE EQUALS NOTHING
#ASSERT `s 31(1) the advance may be recovered` FALSE TRUE EQUALS NOTHING
-- (2): "not more than 12 months".
#ASSERT `s 31(2) the advance is recovered in instalments within the permitted spread` 12
#ASSERT NOT (`s 31(2) the advance is recovered in instalments within the permitted spread` 13)
-- (3), (5): one-quarter of the salary due, or the Minister's substitute.
#ASSERT `s 31(3) the largest instalment of an advance` 1000 NOTHING EQUALS 250
#ASSERT `s 31(3) the largest instalment of an advance` 1000 (JUST 0.5) EQUALS 500
#ASSERT `s 31(4) the loan may be recovered in instalments by deductions from salary` TRUE EQUALS JUST TRUE
#ASSERT `s 31(4) the loan may be recovered in instalments by deductions from salary` FALSE EQUALS NOTHING
#ASSERT `s 31(5) the largest instalment of a loan` 1000 NOTHING EQUALS 250
#ASSERT `s 31(5) the largest instalment of a loan` 1000 (JUST 0.5) EQUALS 500

