IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea-definitions`
IMPORT `ea1-part3b-deductions`

-- Tests for ea1-part3b-deductions.l4 (ss 26 to 34).  Every expected value is written from
-- the text of the section (inputs/EmA1968.txt) before the function was run.

-- ---------------------------------------------------------------------------
§ `s 26 No unauthorised deductions to be made`
-- (1): arguments are: authorised by the Act, court order, tax declaration, ITA direction, MediShield declaration, CSHL declaration.
#ASSERT `s 26(1) the employer may make the deduction from the salary of the employee` FALSE FALSE FALSE FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 26(1) the employer may make the deduction from the salary of the employee` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 26(1) the employer may make the deduction from the salary of the employee` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 26(1) the employer may make the deduction from the salary of the employee` FALSE FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 26(1) the employer may make the deduction from the salary of the employee` FALSE FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 26(1) the employer may make the deduction from the salary of the employee` FALSE FALSE FALSE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `s 26(1) the employer may make the deduction from the salary of the employee` FALSE FALSE FALSE FALSE FALSE TRUE EQUALS NOTHING
-- the prohibition: a deduction without authority is a breach (read the trace); an authorised one raises no duty.
#TRACE `s 26(1) the employer's prohibition on an unauthorised deduction` FALSE AT 0 WITH
    PARTY `s 26(1) the employer` DOES `s 26(1) make a deduction from the salary of the employee without authority` AT 3
-- (2): the definitions point outside the text and pass the answer on.
#ASSERT `s 26(2) "CSHL Scheme recovery body" the body is one` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 26(2) "CSHL Scheme recovery body" the body is one` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 26(2) "CSHL Scheme recovery body" the body is one` NOTHING EQUALS NOTHING
#ASSERT `s 26(2) "MediShield Life Scheme recovery body" the body is one` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 26(2) "MediShield Life Scheme recovery body" the body is one` NOTHING EQUALS NOTHING

