IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea-definitions`
IMPORT `ea1-part5-truck`

-- Tests for ea1-part5-truck.l4 (ss 54 to 64).  Every expected value is written from
-- the text of the section (inputs/EmA1968.txt) before the function was run.

-- ---------------------------------------------------------------------------
§ `s 54 Agreements to pay salary otherwise than in legal tender illegal`
#ASSERT `s 54 the salary may be made payable otherwise than in legal tender` TRUE EQUALS JUST FALSE
#ASSERT `s 54 the salary may be made payable otherwise than in legal tender` FALSE EQUALS NOTHING
-- arguments are: a workman, the whole or part of the salary is made payable in another manner.
#ASSERT `s 54 the contract of service is illegal and void` TRUE TRUE EQUALS JUST TRUE
-- s 54 "if in any contract of service the whole or any part of the salary is made payable in any other manner": an unmet "if" (ruled 2026-11-05).
#ASSERT `s 54 the contract of service is illegal and void` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 54 the contract of service is illegal and void` FALSE TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `s 55 Agreements as to place and manner, etc., of spending salary illegal`
#ASSERT `s 55 the contract of service may contain the term` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 55 the contract of service may contain the term` TRUE FALSE EQUALS NOTHING
#ASSERT `s 55 the contract of service may contain the term` FALSE TRUE EQUALS NOTHING
#ASSERT `s 55 the contract of service is illegal and void` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 55 the contract of service is illegal and void` TRUE FALSE EQUALS NOTHING
#ASSERT `s 55 the contract of service is illegal and void` FALSE TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `s 56 Salary to be paid entirely in legal tender`
#ASSERT `s 56 the entire amount of the salary has been actually paid in legal tender` 3000 3000
#ASSERT NOT (`s 56 the entire amount of the salary has been actually paid in legal tender` 3000 2999)
-- arguments are: a workman, the payment is in a form other than legal tender, this Act expressly permits it.
#ASSERT `s 56 the payment is illegal and void` TRUE TRUE FALSE EQUALS JUST TRUE
-- s 56 "Except where otherwise expressly permitted by the provisions of this Act": permitted, so the payment is not illegal and void on this ground.
#ASSERT `s 56 the payment is illegal and void` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 56 the payment is illegal and void` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 56 the payment is illegal and void` FALSE TRUE FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `s 57 Recovery of salary not paid in legal tender`
-- arguments are: a workman, the salary earned, the sums lawfully deducted, the amount actually paid in legal tender.
#ASSERT `s 57 the amount of salary the workman is entitled to recover` TRUE 3000 200 2500 EQUALS JUST 300
#ASSERT `s 57 the amount of salary the workman is entitled to recover` TRUE 3000 200 2800 EQUALS JUST 0
#ASSERT `s 57 the amount of salary the workman is entitled to recover` TRUE 3000 200 3000 EQUALS JUST 0
#ASSERT `s 57 the amount of salary the workman is entitled to recover` FALSE 3000 200 2500 EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `s 58 Interest on advances forbidden`
#ASSERT `s 58 the employer may make the deduction` TRUE EQUALS JUST FALSE
#ASSERT `s 58 the employer may make the deduction` FALSE EQUALS NOTHING
-- the prohibition: making the deduction is a breach (read the trace).
#TRACE `s 58 the employer's prohibition on a deduction by way of interest on an advance` TRUE AT 0 WITH
    PARTY `s 58 the employer` DOES `s 58 make a deduction by way of discount, interest or any similar charge on account of an advance of salary made to a workman` AT 3

-- ---------------------------------------------------------------------------
§ `s 59 Remuneration other than salary`
#ASSERT `s 59 this Part renders the contract of service illegal` TRUE EQUALS JUST FALSE
#ASSERT `s 59 this Part renders the contract of service illegal` FALSE EQUALS NOTHING
#ASSERT `s 59 the employer may give the workman the thing by way of remuneration` TRUE EQUALS JUST FALSE
#ASSERT `s 59 the employer may give the workman the thing by way of remuneration` FALSE EQUALS NOTHING
#TRACE `s 59 the employer's prohibition on giving noxious drugs or intoxicating liquor` TRUE AT 0 WITH
    PARTY `s 59 the employer` DOES `s 59 give a workman noxious drugs or intoxicating liquor by way of remuneration` AT 3

-- ---------------------------------------------------------------------------
§ `s 60 Shops and canteens`
#ASSERT `s 60(1) this Part prevents the employer from establishing or permitting the shop or canteen` TRUE EQUALS JUST FALSE
#ASSERT `s 60(1) this Part prevents the employer from establishing or permitting the shop or canteen` FALSE EQUALS NOTHING
#ASSERT `s 60(1) the workman may be compelled by a contract of service to purchase goods at the shop or canteen` TRUE EQUALS JUST FALSE
#ASSERT `s 60(1) the workman may be compelled by a contract of service to purchase goods at the shop or canteen` FALSE EQUALS NOTHING
#ASSERT `s 60(1) noxious drugs and intoxicating liquor may be sold at the shop or canteen` TRUE EQUALS JUST FALSE
#ASSERT `s 60(1) noxious drugs and intoxicating liquor may be sold at the shop or canteen` FALSE EQUALS NOTHING
-- (2): arguments are: a shop or canteen on a place of employment for sale to the employer's workmen, kept otherwise than in accordance with subsection (1).
#ASSERT `s 60(2) the employer may establish or keep the shop or canteen` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 60(2) the employer may establish or keep the shop or canteen` TRUE FALSE EQUALS NOTHING
#ASSERT `s 60(2) the employer may establish or keep the shop or canteen` FALSE TRUE EQUALS NOTHING
#TRACE `s 60(2) the employer's prohibition on a shop or canteen kept otherwise than in accordance with subsection (1)` TRUE TRUE AT 0 WITH
    PARTY `s 60(2) the employer` DOES `s 60(2) establish or keep, or permit to be established or kept, a shop or canteen on a place of employment for the sale to the employer's workmen otherwise than in accordance with subsection (1)` AT 3

-- ---------------------------------------------------------------------------
§ `s 61 Offence`
-- arguments are: contract or remuneration contrary to the Part, a payment received from a workman contrary to the Part, contravenes section 60(2).
#ASSERT `s 61 the employer is guilty of an offence` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 61 the employer is guilty of an offence` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61 the employer is guilty of an offence` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 61 the employer is guilty of an offence` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 61 the penalty on conviction` TRUE FALSE EQUALS JUST (`Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS NOTHING)
#ASSERT `s 61 the penalty on conviction` TRUE TRUE EQUALS JUST (`Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 10000, `longest imprisonment in months` IS JUST 12)
#ASSERT `s 61 the penalty on conviction` FALSE TRUE EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `s 63 Payment of salary through bank`
#ASSERT `s 63(1) section 54 or 56 renders the payment of salary unlawful or invalid` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 63(1) section 54 or 56 renders the payment of salary unlawful or invalid` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 63(1) section 54 or 56 renders the payment of salary unlawful or invalid` FALSE FALSE EQUALS NOTHING
-- (2): 300 is the amount under section 57; 100 was paid by bank or cheque: 200 remains.
#ASSERT `s 63(2) the amount of salary the workman has a right of recovery of under section 57` (JUST 300) 100 EQUALS JUST 200
#ASSERT `s 63(2) the amount of salary the workman has a right of recovery of under section 57` (JUST 300) 500 EQUALS JUST 0
#ASSERT `s 63(2) the amount of salary the workman has a right of recovery of under section 57` NOTHING 100 EQUALS NOTHING

-- ---------------------------------------------------------------------------
§ `s 64 Limitations on application of this Part`
#ASSERT `s 64 Part 5 applies to the body of persons` TRUE EQUALS JUST FALSE
#ASSERT `s 64 Part 5 applies to the body of persons` FALSE EQUALS NOTHING
