IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea2-part-10-holiday-annual`

-- Tests for ea2-part-10-holiday-annual.l4 (Employment Act 1968, ss 88 and 88A).  Expected values were
-- decided from the text before the functions were run.  Dates were worked out on a calendar.

`test employed from 2020` MEANS `Dates of the employment` WITH `began on` IS Date 1 1 2020, `ended on` IS NOTHING
`test employed to 24 December` MEANS `Dates of the employment` WITH `began on` IS Date 1 1 2020, `ended on` IS JUST (Date 24 12 2026)
`test employed to 25 December` MEANS `Dates of the employment` WITH `began on` IS Date 1 1 2020, `ended on` IS JUST (Date 25 12 2026)
`test employed from 25 December` MEANS `Dates of the employment` WITH `began on` IS Date 25 12 2026, `ended on` IS NOTHING
`test employed from 26 December` MEANS `Dates of the employment` WITH `began on` IS Date 26 12 2026, `ended on` IS NOTHING

§ `Tests -- s 88(1) to (3)`

#ASSERT `s 88(1) the employee is entitled to a paid holiday at the gross rate of pay on the public holiday` (Date 25 12 2026) `test employed from 2020` EQUALS JUST TRUE
#ASSERT `s 88(1) the employee is entitled to a paid holiday at the gross rate of pay on the public holiday` (Date 25 12 2026) `test employed to 25 December` EQUALS JUST TRUE
#ASSERT `s 88(1) the employee is entitled to a paid holiday at the gross rate of pay on the public holiday` (Date 25 12 2026) `test employed from 25 December` EQUALS JUST TRUE
#ASSERT `s 88(1) the employee is entitled to a paid holiday at the gross rate of pay on the public holiday` (Date 25 12 2026) `test employed to 24 December` EQUALS NOTHING
#ASSERT `s 88(1) the employee is entitled to a paid holiday at the gross rate of pay on the public holiday` (Date 25 12 2026) `test employed from 26 December` EQUALS NOTHING

#ASSERT `s 88(1)(a) the day may be substituted for the public holiday` TRUE EQUALS JUST TRUE
#ASSERT `s 88(1)(a) the day may be substituted for the public holiday` FALSE EQUALS NOTHING
#ASSERT `s 88(1)(b) the day that is a paid holiday` TRUE (Date 28 12 2026) EQUALS JUST (Date 28 12 2026)
#ASSERT `s 88(1)(b) the day that is a paid holiday` FALSE (Date 28 12 2026) EQUALS NOTHING
#ASSERT `s 88(1)(c) the employer may do this` TRUE `s 88(1)(c) pays the employee for the holiday at the gross rate of pay` EQUALS JUST TRUE
#ASSERT `s 88(1)(c) the employer may do this` TRUE `s 88(1)(c) gives the employee a day off in substitution for the holiday` EQUALS JUST TRUE
#ASSERT `s 88(1)(c) the employer may do this` FALSE `s 88(1)(c) pays the employee for the holiday at the gross rate of pay` EQUALS JUST FALSE

#ASSERT `s 88(2) the employee is entitled to holiday pay for the public holiday` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 88(2) the employee is entitled to holiday pay for the public holiday` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 88(2) the employee is entitled to holiday pay for the public holiday` NOTHING EQUALS NOTHING

-- absent, and no consent, no excuse; consent but no excuse; excuse but no consent: each loses pay
#ASSERT `s 88(3) the employee is entitled to holiday pay for that holiday` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 88(3) the employee is entitled to holiday pay for that holiday` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 88(3) the employee is entitled to holiday pay for that holiday` TRUE FALSE TRUE EQUALS JUST FALSE
-- consent and excuse: nothing is taken away
#ASSERT `s 88(3) the employee is entitled to holiday pay for that holiday` TRUE TRUE TRUE EQUALS NOTHING
-- not absent on the day before or after
#ASSERT `s 88(3) the employee is entitled to holiday pay for that holiday` FALSE FALSE FALSE EQUALS NOTHING

§ `Tests -- s 88(4) to (7)`

#ASSERT `s 88(4) the employee is entitled to an extra day's salary at the basic rate of pay` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 88(4) the employee is entitled to an extra day's salary at the basic rate of pay` TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 88(4) the employee is entitled to an extra day's salary at the basic rate of pay` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 88(4) the employee is entitled to an extra day's salary at the basic rate of pay` FALSE (JUST FALSE) EQUALS JUST FALSE
-- the gross rate $100, the basic rate $80, a travelling allowance $5: $185
#ASSERT `s 88(4) the total the employee must be paid for the day` (JUST 100) (JUST 80) 5 EQUALS JUST 185
#ASSERT `s 88(4) the total the employee must be paid for the day` (JUST 100) (JUST 80) 0 EQUALS JUST 180
#ASSERT `s 88(4) the total the employee must be paid for the day` NOTHING (JUST 80) 5 EQUALS NOTHING
#ASSERT `s 88(4) the total the employee must be paid for the day` (JUST 100) NOTHING 5 EQUALS NOTHING

-- (4A): not a 35(a) workman and not within 35(b); no agreement
#ASSERT `s 88(4A) the time off the employee may be given in lieu` (JUST FALSE) (JUST FALSE) NOTHING 3 EQUALS JUST (`s 88(4A) part of a day off comprising` 4)
#ASSERT `s 88(4A) the time off the employee may be given in lieu` (JUST FALSE) (JUST FALSE) NOTHING 4 EQUALS JUST (`s 88(4A) part of a day off comprising` 4)
#ASSERT `s 88(4A) the time off the employee may be given in lieu` (JUST FALSE) (JUST FALSE) NOTHING 4.5 EQUALS JUST `s 88(4A) a day off on a working day`
-- an agreed number of hours wins over the default
#ASSERT `s 88(4A) the time off the employee may be given in lieu` (JUST FALSE) (JUST FALSE) (JUST 2) 6 EQUALS JUST (`s 88(4A) part of a day off comprising` 2)
-- a 35(a) workman or a 35(b) employee is under subsection (4)
#ASSERT `s 88(4A) the time off the employee may be given in lieu` (JUST TRUE) (JUST FALSE) NOTHING 3 EQUALS NOTHING
#ASSERT `s 88(4A) the time off the employee may be given in lieu` (JUST FALSE) (JUST TRUE) NOTHING 3 EQUALS NOTHING
#ASSERT `s 88(4A) the time off the employee may be given in lieu` (JUST TRUE) NOTHING NOTHING 3 EQUALS NOTHING
-- the class is not answered
#ASSERT `s 88(4A) the time off the employee may be given in lieu` NOTHING (JUST FALSE) NOTHING 3 EQUALS NOTHING
#ASSERT `s 88(4A) the time off the employee may be given in lieu` (JUST FALSE) NOTHING NOTHING 3 EQUALS NOTHING
#ASSERT `s 88(4A) the pay the employee must be paid for the day` (JUST 100) EQUALS JUST 100
#ASSERT `s 88(4A) the pay the employee must be paid for the day` NOTHING EQUALS NOTHING

#ASSERT `s 88(5) the employee is entitled by reason of subsection (4) to receive double the allowance` TRUE EQUALS JUST FALSE
#ASSERT `s 88(5) the employee is entitled by reason of subsection (4) to receive double the allowance` FALSE EQUALS NOTHING

#ASSERT `s 88(6) subsection (4) applies to the employee` `Employer who is the Government` TRUE EQUALS JUST FALSE
#ASSERT `s 88(6) subsection (4) applies to the employee` `Employer who is a statutory authority` TRUE EQUALS JUST FALSE
#ASSERT `s 88(6) subsection (4) applies to the employee` `Employer who is the Government` FALSE EQUALS NOTHING
#ASSERT `s 88(6) subsection (4) applies to the employee` `Employer who is a body corporate` TRUE EQUALS NOTHING
#ASSERT `s 88(6)(a) the employee may be required to work on the public holiday` TRUE EQUALS JUST TRUE
#ASSERT `s 88(6)(a) the employee may be required to work on the public holiday` FALSE EQUALS NOTHING
#ASSERT `s 88(6)(b) the employee must be given a day or part of a day off in substitution` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 88(6)(b) the employee must be given a day or part of a day off in substitution` TRUE FALSE EQUALS NOTHING
#ASSERT `s 88(6)(b) the employee must be given a day or part of a day off in substitution` FALSE TRUE EQUALS NOTHING

#ASSERT `s 88(7) the rate of pay payable for the public holiday` TRUE (JUST 100) EQUALS JUST 100
#ASSERT `s 88(7) the rate of pay payable for the public holiday` FALSE (JUST 100) EQUALS NOTHING
#ASSERT `s 88(7) the rate of pay payable for the public holiday` TRUE NOTHING EQUALS NOTHING

§ `Tests -- s 88A(1) to (3) how much annual leave`

#ASSERT `s 88A(1)(a) the days of paid annual leave for the first 12 months` EQUALS 7
#ASSERT `s 88A(1)(b) the additional days for the year of continuous service` 1 EQUALS 0
#ASSERT `s 88A(1)(b) the additional days for the year of continuous service` 2 EQUALS 1
#ASSERT `s 88A(1)(b) the additional days for the year of continuous service` 8 EQUALS 7
#ASSERT `s 88A(1)(c) the most days of paid annual leave` EQUALS 14
#ASSERT `s 88A(1) the days of paid annual leave for a completed 12 months of continuous service` 2 1 EQUALS NOTHING
#ASSERT `s 88A(1) the days of paid annual leave for a completed 12 months of continuous service` 3 1 EQUALS JUST 7
#ASSERT `s 88A(1) the days of paid annual leave for a completed 12 months of continuous service` 12 1 EQUALS JUST 7
#ASSERT `s 88A(1) the days of paid annual leave for a completed 12 months of continuous service` 24 2 EQUALS JUST 8
#ASSERT `s 88A(1) the days of paid annual leave for a completed 12 months of continuous service` 36 3 EQUALS JUST 9
-- 7 + 7 = 14 in the 8th year; the 9th year would be 15, cut to 14
#ASSERT `s 88A(1) the days of paid annual leave for a completed 12 months of continuous service` 96 8 EQUALS JUST 14
#ASSERT `s 88A(1) the days of paid annual leave for a completed 12 months of continuous service` 108 9 EQUALS JUST 14
#ASSERT `s 88A(1) the days of paid annual leave for a completed 12 months of continuous service` 180 15 EQUALS JUST 14
-- 7 + 6 = 13 in the 7th year
#ASSERT `s 88A(1) the days of paid annual leave for a completed 12 months of continuous service` 84 7 EQUALS JUST 13

#ASSERT `s 88A(3) the whole days of proportionate annual leave` 2.5 EQUALS 3
#ASSERT `s 88A(3) the whole days of proportionate annual leave` 2.4999 EQUALS 2
#ASSERT `s 88A(3) the whole days of proportionate annual leave` 0.5 EQUALS 1
#ASSERT `s 88A(3) the whole days of proportionate annual leave` 0.4999 EQUALS 0
#ASSERT `s 88A(3) the whole days of proportionate annual leave` 3 EQUALS 3

-- year 1, 7 days: 6 months is 3.5, so 4; 5 months is 2.9167, so 3; 4 months is 2.333, so 2
#ASSERT `s 88A(2) with (3) the days of paid annual leave in proportion to the completed months` 6 6 7 EQUALS JUST 4
#ASSERT `s 88A(2) with (3) the days of paid annual leave in proportion to the completed months` 5 5 7 EQUALS JUST 3
#ASSERT `s 88A(2) with (3) the days of paid annual leave in proportion to the completed months` 4 4 7 EQUALS JUST 2
#ASSERT `s 88A(2) with (3) the days of paid annual leave in proportion to the completed months` 3 3 7 EQUALS JUST 2
#ASSERT `s 88A(2) with (3) the days of paid annual leave in proportion to the completed months` 11 11 7 EQUALS JUST 6
-- year 4, 10 days, 3 months: 2.5 exactly, so 3
#ASSERT `s 88A(2) with (3) the days of paid annual leave in proportion to the completed months` 39 3 10 EQUALS JUST 3
-- year 3, 9 days, 3 months: 2.25, so 2
#ASSERT `s 88A(2) with (3) the days of paid annual leave in proportion to the completed months` 27 3 9 EQUALS JUST 2
-- under 3 months of service in total
#ASSERT `s 88A(2) with (3) the days of paid annual leave in proportion to the completed months` 2 2 7 EQUALS NOTHING
-- 12 completed months in the year is not "has not completed 12 months"
#ASSERT `s 88A(2) with (3) the days of paid annual leave in proportion to the completed months` 12 12 7 EQUALS NOTHING

§ `Tests -- seam S4 the days of paid annual leave`

#ASSERT `s 88A the days of paid annual leave` 12 1 12 EQUALS JUST 7
#ASSERT `s 88A the days of paid annual leave` 24 2 12 EQUALS JUST 8
#ASSERT `s 88A the days of paid annual leave` 5 1 5 EQUALS JUST 3
#ASSERT `s 88A the days of paid annual leave` 3 1 3 EQUALS JUST 2
-- third year, 2 months in: 26 months in total, 9 x 2 / 12 = 1.5, so 2
#ASSERT `s 88A the days of paid annual leave` 26 3 2 EQUALS JUST 2
#ASSERT `s 88A the days of paid annual leave` 2 1 2 EQUALS NOTHING

§ `Tests -- s 88A(4) to (8)`

#ASSERT `s 88A(4) the days counted as continuous service` 365 30 EQUALS 335
#ASSERT `s 88A(4) the days counted as continuous service` 10 20 EQUALS 0

-- 4 absent of 20 working days is exactly 20%; 5 of 20 is more
#ASSERT `s 88A(5) the employee keeps the entitlement to annual leave` 20 4 EQUALS NOTHING
#ASSERT `s 88A(5) the employee keeps the entitlement to annual leave` 20 5 EQUALS JUST FALSE
#ASSERT `s 88A(5) the employee keeps the entitlement to annual leave` 250 50 EQUALS NOTHING
#ASSERT `s 88A(5) the employee keeps the entitlement to annual leave` 250 51 EQUALS JUST FALSE
#ASSERT `s 88A(5) the employee keeps the entitlement to annual leave` 20 0 EQUALS NOTHING

#ASSERT `s 88A(6)(a) the last day for taking the paid annual leave` (JUST TRUE) (JUST FALSE) (Date 31 3 2026) EQUALS JUST (Date 31 3 2027)
#ASSERT `s 88A(6)(a) the last day for taking the paid annual leave` (JUST FALSE) (JUST TRUE) (Date 29 2 2024) EQUALS JUST (Date 28 2 2025)
#ASSERT `s 88A(6)(a) the last day for taking the paid annual leave` (JUST FALSE) (JUST FALSE) (Date 31 3 2026) EQUALS NOTHING
#ASSERT `s 88A(6)(a) the last day for taking the paid annual leave` NOTHING NOTHING (Date 31 3 2026) EQUALS NOTHING
#ASSERT `s 88A(6)(b) the employee is still entitled to the paid annual leave not taken` (JUST TRUE) (JUST FALSE) 3 EQUALS JUST FALSE
#ASSERT `s 88A(6)(b) the employee is still entitled to the paid annual leave not taken` (JUST FALSE) (JUST TRUE) 3 EQUALS JUST FALSE
#ASSERT `s 88A(6)(b) the employee is still entitled to the paid annual leave not taken` (JUST TRUE) (JUST FALSE) 0 EQUALS NOTHING
#ASSERT `s 88A(6)(b) the employee is still entitled to the paid annual leave not taken` (JUST FALSE) (JUST FALSE) 3 EQUALS NOTHING

#ASSERT `s 88A(7) the amount the employer must pay for the paid annual leave` 5 (JUST 100) EQUALS JUST 500
#ASSERT `s 88A(7) the amount the employer must pay for the paid annual leave` 5 NOTHING EQUALS NOTHING

#ASSERT `s 88A(8) the amount the employer must pay for the paid annual leave not taken` `Ending: the employer dismissed the employee` `Ground: redundancy or reorganisation of the employer's profession, business, trade or work` 3 (JUST 100) EQUALS JUST 300
#ASSERT `s 88A(8) the amount the employer must pay for the paid annual leave not taken` `Ending: the employer dismissed the employee` `Ground: some other ground or none` 3 (JUST 100) EQUALS JUST 300
#ASSERT `s 88A(8) the amount the employer must pay for the paid annual leave not taken` `Ending: the employer dismissed the employee` `Ground: misconduct inconsistent with the fulfilment of the conditions of service` 3 (JUST 100) EQUALS JUST 0
#ASSERT `s 88A(8) the amount the employer must pay for the paid annual leave not taken` `Ending: the employee resigned` `Ground: some other ground or none` 3 (JUST 100) EQUALS JUST 0
#ASSERT `s 88A(8) the amount the employer must pay for the paid annual leave not taken` `Ending: the employer dismissed the employee` `Ground: some other ground or none` 0 (JUST 100) EQUALS JUST 0
#ASSERT `s 88A(8) the amount the employer must pay for the paid annual leave not taken` `Ending: the employer dismissed the employee` `Ground: some other ground or none` 3 NOTHING EQUALS NOTHING

§ `Tests -- the twins that can say no (rulings of 2026-11-05; fork F18)`

-- s 88(1)(b): the rule applies "if any public holiday falls on a rest day".
#ASSERT `s 88(1)(b) the rule of paragraph (b) applies` TRUE EQUALS JUST TRUE
#ASSERT `s 88(1)(b) the rule of paragraph (b) applies` FALSE EQUALS JUST FALSE
-- s 88(4A): "where any employee (other than ... 35(b) ... 35(a)) is required ... to work on any public holiday".
#ASSERT `s 88(4A) this rule applies to the employee` (JUST FALSE) (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 88(4A) this rule applies to the employee` (JUST FALSE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 88(4A) this rule applies to the employee` (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 88(4A) this rule applies to the employee` (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 88(4A) this rule applies to the employee` NOTHING (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 88(4A) this rule applies to the employee` NOTHING NOTHING FALSE EQUALS JUST FALSE
-- s 88(7): "if any public holiday falls on a half working day".
#ASSERT `s 88(7) the rule of subsection (7) applies` TRUE EQUALS JUST TRUE
#ASSERT `s 88(7) the rule of subsection (7) applies` FALSE EQUALS JUST FALSE
-- s 88A(5): the text's own verb.  20 absent days of 100 working days is exactly 20%, not "more than 20%", so she does not forfeit.
#ASSERT `s 88A(5) the employee forfeits the entitlement to annual leave` 100 21 EQUALS JUST TRUE
#ASSERT `s 88A(5) the employee forfeits the entitlement to annual leave` 100 20 EQUALS JUST FALSE
#ASSERT `s 88A(5) the employee forfeits the entitlement to annual leave` 100 0 EQUALS JUST FALSE
-- s 88A(6)(a): leave taken after the last day (12 months after the end of the 12 months of service ending 31 Mar 2026, so 31 Mar 2027) is outside the period.
#ASSERT `s 88A(6)(a) the paid annual leave is taken in time` (JUST TRUE) (JUST FALSE) (Date 31 3 2026) (Date 31 3 2027) EQUALS JUST TRUE
#ASSERT `s 88A(6)(a) the paid annual leave is taken in time` (JUST TRUE) (JUST FALSE) (Date 31 3 2026) (Date 1 4 2027) EQUALS JUST FALSE
#ASSERT `s 88A(6)(a) the paid annual leave is taken in time` (JUST FALSE) (JUST TRUE) (Date 31 3 2026) (Date 1 4 2027) EQUALS JUST FALSE
#ASSERT `s 88A(6)(a) the paid annual leave is taken in time` (JUST FALSE) (JUST FALSE) (Date 31 3 2026) (Date 1 4 2027) EQUALS NOTHING
#ASSERT `s 88A(6)(a) the paid annual leave is taken in time` NOTHING NOTHING (Date 31 3 2026) (Date 1 4 2027) EQUALS NOTHING
-- s 88A(6)(b): the text's own verb, "ceases to be entitled", asked of its "if the employee fails to take that leave".
#ASSERT `s 88A(6)(b) the employee ceases to be entitled to the paid annual leave not taken` (JUST TRUE) (JUST FALSE) 3 EQUALS JUST TRUE
#ASSERT `s 88A(6)(b) the employee ceases to be entitled to the paid annual leave not taken` (JUST TRUE) (JUST FALSE) 0 EQUALS JUST FALSE
#ASSERT `s 88A(6)(b) the employee ceases to be entitled to the paid annual leave not taken` (JUST FALSE) (JUST FALSE) 3 EQUALS NOTHING
