§ `Tests -- s 87 offences, penalties and repeat offenders`

#ASSERT `s 87(1) the employer is guilty of an offence` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 87(1) the employer is guilty of an offence` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 87(1) the employer is guilty of an offence` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 87(1) the employer is guilty of an offence` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 87(1) the penalty on conviction` EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 6
#ASSERT `s 87(2) the penalty on conviction for an offence under section 82` EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 6
#ASSERT `s 87(3) the penalty on conviction of a repeat offender` EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 10000, `longest imprisonment in months` IS JUST 12

`test earlier a` MEANS `s 87(4) Earlier conviction` WITH `kind of offence` IS `s 87(4)(a) an offence under section 87(1)(a), (b) or (c) or section 82`, `the day the person was convicted or found guilty` IS Date 2 5 2013
`test earlier before` MEANS `s 87(4) Earlier conviction` WITH `kind of offence` IS `s 87(4)(a) an offence under section 87(1)(a), (b) or (c) or section 82`, `the day the person was convicted or found guilty` IS Date 30 4 2013
`test earlier first day` MEANS `s 87(4) Earlier conviction` WITH `kind of offence` IS `s 87(4)(b) an offence under section 17(1) of the Child Development Co-Savings Act 2001`, `the day the person was convicted or found guilty` IS Date 1 5 2013
`test earlier other` MEANS `s 87(4) Earlier conviction` WITH `kind of offence` IS `s 87(4) an offence of some other kind`, `the day the person was convicted or found guilty` IS Date 2 5 2013
`test earlier same day` MEANS `s 87(4) Earlier conviction` WITH `kind of offence` IS `s 87(4)(a) an offence under section 87(1)(a), (b) or (c) or section 82`, `the day the person was convicted or found guilty` IS Date 1 6 2026

#ASSERT `s 87(4) the person is a repeat offender` (Date 1 6 2026) (LIST `test earlier a`) EQUALS JUST TRUE
#ASSERT `s 87(4) the person is a repeat offender` (Date 1 6 2026) (LIST `test earlier first day`) EQUALS JUST TRUE
-- one day before 1 May 2013 does not count; another kind of offence does not count; the same day is not "before"
#ASSERT `s 87(4) the person is a repeat offender` (Date 1 6 2026) (LIST `test earlier before`) EQUALS JUST FALSE
#ASSERT `s 87(4) the person is a repeat offender` (Date 1 6 2026) (LIST `test earlier other`) EQUALS JUST FALSE
#ASSERT `s 87(4) the person is a repeat offender` (Date 1 6 2026) (LIST `test earlier same day`) EQUALS JUST FALSE
#ASSERT `s 87(4) the person is a repeat offender` (Date 1 6 2026) EMPTY EQUALS JUST FALSE
#ASSERT `s 87(4) the person is a repeat offender` (Date 1 5 2013) (LIST `test earlier first day`) EQUALS JUST FALSE
-- one counting conviction among others is enough
#ASSERT `s 87(4) the person is a repeat offender` (Date 1 6 2026) (LIST `test earlier other`, `test earlier a`) EQUALS JUST TRUE

