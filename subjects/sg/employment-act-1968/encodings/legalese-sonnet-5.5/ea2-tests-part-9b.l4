#ASSERT `s 84(3)(a) the Tribunal may direct the employer to reinstate her and to pay her the wages she would have earned` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 84(3)(a) the Tribunal may direct the employer to reinstate her and to pay her the wages she would have earned` (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 84(3)(a) the Tribunal may direct the employer to reinstate her and to pay her the wages she would have earned` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 84(3)(a) the Tribunal may direct the employer to reinstate her and to pay her the wages she would have earned` NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 84(3)(b) the Tribunal may direct the employer to pay her compensation in wages` (JUST TRUE) TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 84(3)(b) the Tribunal may direct the employer to pay her compensation in wages` (JUST TRUE) TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 84(3)(b) the Tribunal may direct the employer to pay her compensation in wages` (JUST TRUE) FALSE TRUE EQUALS NOTHING
#ASSERT `s 84(3)(b) the Tribunal may direct the employer to pay her compensation in wages` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 84(3)(b) the Tribunal may direct the employer to pay her compensation in wages` NOTHING TRUE TRUE EQUALS NOTHING

