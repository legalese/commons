#ASSERT `s 84A(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 15 3 2013) (JUST (Date 1 9 2013)) NOTHING FALSE 0 EQUALS NOTHING
-- by the date of confinement, 3 months before 1 June 2013
#ASSERT `s 84A(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 15 3 2013) NOTHING (JUST (Date 1 6 2013)) FALSE 0 EQUALS JUST FALSE
-- not on the ground of redundancy or reorganisation
#ASSERT `s 84A(1) the notice of dismissal has the effect of depriving her of a payment under this Part` FALSE (Date 1 3 2013) (JUST (Date 1 6 2013)) NOTHING FALSE 0 EQUALS NOTHING
-- (b) pregnancy certified, 3 months' service
#ASSERT `s 84A(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 6 2013) NOTHING NOTHING TRUE 3 EQUALS JUST FALSE
#ASSERT `s 84A(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 6 2013) NOTHING NOTHING FALSE 3 EQUALS NOTHING
-- (c) 1 May to 31 July 2013, under 3 months' service, 3 months before 1 September 2013 begins 1 June
#ASSERT `s 84A(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 6 2013) (JUST (Date 1 9 2013)) NOTHING FALSE 2 EQUALS JUST FALSE
#ASSERT `s 84A(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 31 5 2013) (JUST (Date 1 9 2013)) NOTHING FALSE 2 EQUALS NOTHING
#ASSERT `s 84A(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 8 2013) (JUST (Date 1 9 2013)) NOTHING FALSE 2 EQUALS NOTHING
