IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea2-part-9a`
IMPORT `ea2-part-9b`

-- Tests for ea2-part-9b.l4 (Employment Act 1968, ss 81 to 87).  Expected values were decided from
-- the text of each section before the function was run.  Dates are worked out on a calendar.

-- A notice of termination given by the employer or the employee (the core's record).
GIVEN by IS A `Party to a contract of service`
      given IS A DATE
      last IS A DATE
GIVETH A `Notice of termination`
`test notice` MEANS `Notice of termination` WITH `given by` IS by, `given on` IS given, `last day of the notice` IS last, `in writing` IS TRUE

-- Her absence under the Part: 13 May to 4 August 2026.
`test absence` MEANS `Period of days` WITH `first day` IS Date 13 5 2026, `last day` IS Date 4 8 2026

§ `Tests -- s 81 no notice of dismissal during the absence`

-- given during the absence and expiring during it
#ASSERT `s 81 it is lawful for her employer to give her the notice of dismissal` TRUE `test absence` (`test notice` `Party who is the employer` (Date 1 6 2026) (Date 30 6 2026)) EQUALS JUST FALSE
-- given before the absence, expiring during it ("on such a day that the notice will expire during her absence")
#ASSERT `s 81 it is lawful for her employer to give her the notice of dismissal` TRUE `test absence` (`test notice` `Party who is the employer` (Date 1 5 2026) (Date 20 5 2026)) EQUALS JUST FALSE
-- given during the absence, expiring after it
#ASSERT `s 81 it is lawful for her employer to give her the notice of dismissal` TRUE `test absence` (`test notice` `Party who is the employer` (Date 1 6 2026) (Date 30 8 2026)) EQUALS JUST FALSE
-- boundaries: given on the first day; given on the last day
#ASSERT `s 81 it is lawful for her employer to give her the notice of dismissal` TRUE `test absence` (`test notice` `Party who is the employer` (Date 13 5 2026) (Date 13 6 2026)) EQUALS JUST FALSE
#ASSERT `s 81 it is lawful for her employer to give her the notice of dismissal` TRUE `test absence` (`test notice` `Party who is the employer` (Date 4 8 2026) (Date 4 9 2026)) EQUALS JUST FALSE
-- expiring on the first day of the absence is expiring during it
#ASSERT `s 81 it is lawful for her employer to give her the notice of dismissal` TRUE `test absence` (`test notice` `Party who is the employer` (Date 1 5 2026) (Date 13 5 2026)) EQUALS JUST FALSE
-- one day short on each side: nothing in the section
#ASSERT `s 81 it is lawful for her employer to give her the notice of dismissal` TRUE `test absence` (`test notice` `Party who is the employer` (Date 1 4 2026) (Date 12 5 2026)) EQUALS NOTHING
#ASSERT `s 81 it is lawful for her employer to give her the notice of dismissal` TRUE `test absence` (`test notice` `Party who is the employer` (Date 5 8 2026) (Date 5 9 2026)) EQUALS NOTHING
-- a notice she gave herself
#ASSERT `s 81 it is lawful for her employer to give her the notice of dismissal` TRUE `test absence` (`test notice` `Party who is the employee` (Date 1 6 2026) (Date 30 6 2026)) EQUALS NOTHING
-- she is not absent under this Part
#ASSERT `s 81 it is lawful for her employer to give her the notice of dismissal` FALSE `test absence` (`test notice` `Party who is the employer` (Date 1 6 2026) (Date 30 6 2026)) EQUALS NOTHING

§ `Tests -- ss 82 and 83`

-- s 82: 4 weeks from the confinement on 10 June 2026 are 10 June to 7 July.
#ASSERT `s 82 the employer is guilty of an offence` TRUE (Date 10 6 2026) (Date 10 6 2026) EQUALS JUST TRUE
#ASSERT `s 82 the employer is guilty of an offence` TRUE (Date 7 7 2026) (Date 10 6 2026) EQUALS JUST TRUE
#ASSERT `s 82 the employer is guilty of an offence` TRUE (Date 8 7 2026) (Date 10 6 2026) EQUALS JUST FALSE
#ASSERT `s 82 the employer is guilty of an offence` TRUE (Date 9 6 2026) (Date 10 6 2026) EQUALS JUST FALSE
#ASSERT `s 82 the employer is guilty of an offence` FALSE (Date 20 6 2026) (Date 10 6 2026) EQUALS NOTHING

#ASSERT `s 83 the female employee keeps her claim to payment under this Part` TRUE EQUALS JUST FALSE
#ASSERT `s 83 the female employee keeps her claim to payment under this Part` FALSE EQUALS NOTHING
#ASSERT `s 83 the employer may dismiss the female employee` TRUE EQUALS JUST TRUE
#ASSERT `s 83 the employer may dismiss the female employee` FALSE EQUALS NOTHING

§ `Tests -- s 84(1) a notice given without sufficient cause`

-- the helper: 6 months before 1 September 2013 is 1 March 2013; the window runs to 31 August.
#ASSERT `s 84(1) helper: the day is within the months preceding the date` (Date 1 3 2013) (Date 1 9 2013) 6
#ASSERT NOT (`s 84(1) helper: the day is within the months preceding the date` (Date 28 2 2013) (Date 1 9 2013) 6)
#ASSERT `s 84(1) helper: the day is within the months preceding the date` (Date 31 8 2013) (Date 1 9 2013) 6
#ASSERT NOT (`s 84(1) helper: the day is within the months preceding the date` (Date 1 9 2013) (Date 1 9 2013) 6)
-- 31 August less 6 months is 28 February (day clamped): 28 February 2014 is in, 27 February is not.
#ASSERT `s 84(1) helper: the day is within the months preceding the date` (Date 28 2 2014) (Date 31 8 2014) 6
#ASSERT NOT (`s 84(1) helper: the day is within the months preceding the date` (Date 27 2 2014) (Date 31 8 2014) 6)

-- (a) before 1 May 2013, due 1 September 2013: a notice on 15 March 2013 is within 6 months before.
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 15 3 2013) (JUST (Date 1 9 2013)) NOTHING FALSE 0 EQUALS JUST FALSE
-- the first day of the window, and one day before it
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 3 2013) (JUST (Date 1 9 2013)) NOTHING FALSE 0 EQUALS JUST FALSE
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 28 2 2013) (JUST (Date 1 9 2013)) NOTHING FALSE 0 EQUALS NOTHING
-- by the date of confinement instead: confined 20 August 2013, window 20 February to 19 August
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 15 3 2013) NOTHING (JUST (Date 20 8 2013)) FALSE 0 EQUALS JUST FALSE
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 19 2 2013) NOTHING (JUST (Date 20 8 2013)) FALSE 0 EQUALS NOTHING
-- sufficient cause: the section protects only a notice given without it
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` FALSE (Date 15 3 2013) (JUST (Date 1 9 2013)) NOTHING FALSE 0 EQUALS NOTHING
-- neither date known
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 15 3 2013) NOTHING NOTHING FALSE 0 EQUALS NOTHING
-- (b) on or after 1 May 2013: pregnancy certified, 3 completed months' service
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 6 2013) NOTHING NOTHING TRUE 3 EQUALS JUST FALSE
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 3 2026) NOTHING NOTHING TRUE 12 EQUALS JUST FALSE
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 5 2013) NOTHING NOTHING TRUE 3 EQUALS JUST FALSE
-- not certified before the notice
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 6 2013) NOTHING NOTHING FALSE 3 EQUALS NOTHING
-- (c) 1 May to 31 July 2013, under 3 months' service, within 6 months before the due date 1 December 2013
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 6 2013) (JUST (Date 1 12 2013)) NOTHING FALSE 2 EQUALS JUST FALSE
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 31 7 2013) (JUST (Date 1 12 2013)) NOTHING FALSE 2 EQUALS JUST FALSE
-- (c) outside its dates: 1 August 2013
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 8 2013) (JUST (Date 1 12 2013)) NOTHING FALSE 2 EQUALS NOTHING
-- (c) not within 6 months before the due date 1 January 2014 (window starts 1 July 2013)
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 6 2013) (JUST (Date 1 1 2014)) NOTHING FALSE 2 EQUALS NOTHING
-- (c) with under 3 months but the pregnancy certified and 2 months: (b) needs 3 months, so only (c)
#ASSERT `s 84(1) the notice of dismissal has the effect of depriving her of a payment under this Part` TRUE (Date 1 3 2026) NOTHING NOTHING TRUE 2 EQUALS NOTHING

§ `Tests -- s 84(1A) and s 84A(2) the relevant estimated delivery date`

-- two certifications: due 1 September certified 1 March; due 15 September certified 10 March
`test certified` MEANS LIST (`s 84(1A) Certified estimated delivery date` WITH `the estimated delivery date` IS Date 1 9 2026, `the day it was certified` IS Date 1 3 2026), (`s 84(1A) Certified estimated delivery date` WITH `the estimated delivery date` IS Date 15 9 2026, `the day it was certified` IS Date 10 3 2026)
#ASSERT `s 84(1A) the estimated delivery date that is relevant` (Date 20 3 2026) `test certified` EQUALS JUST (Date 15 9 2026)
-- a notice on 5 March: only the 1 March certification is before it
#ASSERT `s 84(1A) the estimated delivery date that is relevant` (Date 5 3 2026) `test certified` EQUALS JUST (Date 1 9 2026)
-- a notice on 10 March: the 10 March certification is not before the notice, the 1 March one is
#ASSERT `s 84(1A) the estimated delivery date that is relevant` (Date 10 3 2026) `test certified` EQUALS JUST (Date 1 9 2026)
-- a notice on 1 March: none is before it
#ASSERT `s 84(1A) the estimated delivery date that is relevant` (Date 1 3 2026) `test certified` EQUALS NOTHING
#ASSERT `s 84(1A) the estimated delivery date that is relevant` (Date 1 3 2026) EMPTY EQUALS NOTHING
-- two different dates certified on the same closest day: the Act does not choose
`test tie` MEANS LIST (`s 84(1A) Certified estimated delivery date` WITH `the estimated delivery date` IS Date 15 9 2026, `the day it was certified` IS Date 10 3 2026), (`s 84(1A) Certified estimated delivery date` WITH `the estimated delivery date` IS Date 16 9 2026, `the day it was certified` IS Date 10 3 2026)
#ASSERT `s 84(1A) the estimated delivery date that is relevant` (Date 20 3 2026) `test tie` EQUALS NOTHING
-- the same date certified twice on the same day names one date
`test same` MEANS LIST (`s 84(1A) Certified estimated delivery date` WITH `the estimated delivery date` IS Date 15 9 2026, `the day it was certified` IS Date 10 3 2026), (`s 84(1A) Certified estimated delivery date` WITH `the estimated delivery date` IS Date 15 9 2026, `the day it was certified` IS Date 10 3 2026)
#ASSERT `s 84(1A) the estimated delivery date that is relevant` (Date 20 3 2026) `test same` EQUALS JUST (Date 15 9 2026)
-- s 84A(2) is the same rule
#ASSERT `s 84A(2) the estimated delivery date that is relevant` (Date 20 3 2026) `test certified` EQUALS JUST (Date 15 9 2026)
#ASSERT `s 84A(2) the estimated delivery date that is relevant` (Date 1 3 2026) `test certified` EQUALS NOTHING

