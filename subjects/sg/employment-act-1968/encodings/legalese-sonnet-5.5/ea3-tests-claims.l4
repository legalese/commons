#ASSERT `s 119(1)(g) the order recording the settlement has effect as if made under paragraph (h)` TRUE EQUALS JUST TRUE
#ASSERT `s 119(1)(g) the order recording the settlement has effect as if made under paragraph (h)` FALSE EQUALS NOTHING
