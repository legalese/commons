-- An employee who is a member of a recognised trade union, represented by an officer of the union.
#ASSERT `s 120 the party may be represented by the person` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
-- An employer represented by one of the employer's employees.
#ASSERT `s 120 the party may be represented by the person` FALSE TRUE FALSE TRUE FALSE EQUALS JUST TRUE
-- Never by an advocate or solicitor or a paid agent, whoever the party is.
#ASSERT `s 120 the party may be represented by the person` FALSE TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 120 the party may be represented by the person` TRUE FALSE TRUE FALSE TRUE EQUALS JUST FALSE
-- An employee who is not in a recognised union, represented by anyone: the Act names who a party may be represented by and says nothing of anyone else.
#ASSERT `s 120 the party may be represented by the person` FALSE FALSE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 120 the party may be represented by the person` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
