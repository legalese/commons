#ASSERT `s 119(1)(a) the claim is made in a way that paragraph (a) provides` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 119(1)(a) the claim is made in a way that paragraph (a) provides` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 119(1)(a) the claim is made in a way that paragraph (a) provides` FALSE FALSE EQUALS NOTHING
