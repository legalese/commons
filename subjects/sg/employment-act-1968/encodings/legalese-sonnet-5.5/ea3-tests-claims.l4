#ASSERT `s 119(1)(b) the party against whom the claim is made has been summoned as paragraph (b) requires` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 119(1)(b) the party against whom the claim is made has been summoned as paragraph (b) requires` TRUE TRUE FALSE EQUALS JUST FALSE
