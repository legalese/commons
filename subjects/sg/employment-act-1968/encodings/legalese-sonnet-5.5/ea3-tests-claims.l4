#ASSERT `s 119(1)(d) the notice of the counterclaim is given not less than 3 days before the date of the inquiry` (Date 8 6 2025) (Date 10 6 2025) TRUE EQUALS JUST FALSE
#ASSERT `s 119(1)(d) the notice of the counterclaim is given not less than 3 days before the date of the inquiry` (Date 7 6 2025) (Date 10 6 2025) FALSE EQUALS JUST FALSE
