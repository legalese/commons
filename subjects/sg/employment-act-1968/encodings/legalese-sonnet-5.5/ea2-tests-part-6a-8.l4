IMPORT prelude
IMPORT daydate
IMPORT `ea-core`
IMPORT `ea2-part-6a-8`

-- Tests for ea2-part-6a-8.l4 (Employment Act 1968, ss 66A to 75).  Expected values were decided from the text
-- before the functions were run.

§ `Tests -- s 66A part-time employees`

#ASSERT `s 66A(1) the person is a part-time employee` (JUST TRUE) 34 EQUALS JUST TRUE
#ASSERT `s 66A(1) the person is a part-time employee` (JUST TRUE) 34.5 EQUALS JUST TRUE
#ASSERT `s 66A(1) the person is a part-time employee` (JUST TRUE) 35 EQUALS JUST FALSE
#ASSERT `s 66A(1) the person is a part-time employee` (JUST TRUE) 44 EQUALS JUST FALSE
#ASSERT `s 66A(1) the person is a part-time employee` (JUST TRUE) 0 EQUALS JUST TRUE
#ASSERT `s 66A(1) the person is a part-time employee` (JUST FALSE) 20 EQUALS JUST FALSE
#ASSERT `s 66A(1) the person is a part-time employee` NOTHING 20 EQUALS NOTHING
#ASSERT `s 66A(2) the employee is regarded as a part-time employee for the purposes of this Part` TRUE EQUALS JUST FALSE
#ASSERT `s 66A(2) the employee is regarded as a part-time employee for the purposes of this Part` FALSE EQUALS NOTHING
-- gathered: a declaration wins; otherwise (1)
#ASSERT `s 66A(1) gathered with (2): the employee is a part-time employee for the purposes of this Part` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 66A(1) gathered with (2): the employee is a part-time employee for the purposes of this Part` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 66A(1) gathered with (2): the employee is a part-time employee for the purposes of this Part` (JUST FALSE) NOTHING EQUALS JUST FALSE
#ASSERT `s 66A(1) gathered with (2): the employee is a part-time employee for the purposes of this Part` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 66A(1) gathered with (2): the employee is a part-time employee for the purposes of this Part` NOTHING (JUST FALSE) EQUALS JUST FALSE

§ `Tests -- s 67 domestic workers`

#ASSERT `s 67 the provision of the Act applies to the domestic worker` TRUE EQUALS JUST TRUE
#ASSERT `s 67 the provision of the Act applies to the domestic worker` FALSE EQUALS NOTHING

§ `Tests -- s 67A who is a child and who is a young person`

#ASSERT `s 67A "child" the person is a child` 14 EQUALS JUST TRUE
#ASSERT `s 67A "child" the person is a child` 0 EQUALS JUST TRUE
#ASSERT `s 67A "child" the person is a child` 15 EQUALS JUST FALSE
#ASSERT `s 67A "child" the person is a child` 30 EQUALS JUST FALSE
#ASSERT `s 67A "young person" the person is a young person` 14 EQUALS JUST FALSE
#ASSERT `s 67A "young person" the person is a young person` 15 EQUALS JUST TRUE
#ASSERT `s 67A "young person" the person is a young person` 16 EQUALS JUST FALSE

§ `Tests -- s 72 approved employment`

#ASSERT `s 72(1) sections 68 and 69 apply to the employment` (JUST FALSE) TRUE TRUE FALSE EQUALS JUST FALSE
-- (a) needs both limbs
#ASSERT `s 72(1) sections 68 and 69 apply to the employment` (JUST FALSE) TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 72(1) sections 68 and 69 apply to the employment` (JUST FALSE) FALSE TRUE FALSE EQUALS NOTHING
-- (b) apprenticeship, young person only
#ASSERT `s 72(1) sections 68 and 69 apply to the employment` (JUST TRUE) FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 72(1) sections 68 and 69 apply to the employment` (JUST FALSE) FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 72(1) sections 68 and 69 apply to the employment` NOTHING FALSE FALSE TRUE EQUALS NOTHING
#ASSERT `s 72(1) sections 68 and 69 apply to the employment` (JUST TRUE) FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 72(2) the body is the Institute of Technical Education, Singapore` TRUE EQUALS JUST TRUE
#ASSERT `s 72(2) the body is the Institute of Technical Education, Singapore` FALSE EQUALS JUST FALSE

§ `Tests -- s 68 children`

-- (2): industrial, only family
#ASSERT `s 68(2) a child may be employed in the undertaking` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 68(2) a child may be employed in the undertaking` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 68(2) a child may be employed in the undertaking` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 68(2) a child may be employed in the undertaking` NOTHING TRUE EQUALS NOTHING
-- (4): the certificate of a medical officer is conclusive
#ASSERT `s 68(4) the work is suited to the capacity of the child` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 68(4) the work is suited to the capacity of the child` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 68(4) the work is suited to the capacity of the child` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 68(4) the work is suited to the capacity of the child` NOTHING TRUE EQUALS NOTHING
-- (3): 13 or above, non-industrial, light work, certified suited
#ASSERT `s 68(3) a child may be employed in the undertaking` 13 (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 68(3) a child may be employed in the undertaking` 14 (JUST FALSE) TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 68(3) a child may be employed in the undertaking` 12 (JUST FALSE) TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 68(3) a child may be employed in the undertaking` 13 (JUST TRUE) TRUE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 68(3) a child may be employed in the undertaking` 13 (JUST FALSE) FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 68(3) a child may be employed in the undertaking` 13 (JUST FALSE) TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 68(3) a child may be employed in the undertaking` 13 (JUST FALSE) TRUE NOTHING EQUALS NOTHING
#ASSERT `s 68(3) a child may be employed in the undertaking` 13 NOTHING TRUE (JUST TRUE) EQUALS NOTHING
-- (1): the child, with the exceptions
#ASSERT `s 68(1) the person may employ the child` (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `s 68(1) the person may employ the child` (JUST TRUE) (JUST TRUE) NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `s 68(1) the person may employ the child` (JUST TRUE) NOTHING (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 68(1) the person may employ the child` (JUST TRUE) NOTHING NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 68(1) the person may employ the child` (JUST FALSE) NOTHING NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 68(1) the person may employ the child` NOTHING (JUST TRUE) NOTHING NOTHING EQUALS NOTHING

§ `Tests -- s 69 young persons`

#ASSERT `s 69 the young person may be employed in the undertaking` (JUST TRUE) TRUE NOTHING EQUALS JUST FALSE
#ASSERT `s 69 the young person may be employed in the undertaking` (JUST TRUE) FALSE NOTHING EQUALS NOTHING
#ASSERT `s 69 the young person may be employed in the undertaking` (JUST TRUE) TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 69 the young person may be employed in the undertaking` (JUST TRUE) TRUE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 69 the young person may be employed in the undertaking` (JUST FALSE) TRUE NOTHING EQUALS NOTHING
#ASSERT `s 69 the young person may be employed in the undertaking` NOTHING TRUE NOTHING EQUALS NOTHING

§ `Tests -- ss 71 to 75 salary orders, workmen, offence, Youth Court`

#ASSERT `s 71(2) the person is guilty of an offence` (JUST 500) 499 EQUALS JUST TRUE
#ASSERT `s 71(2) the person is guilty of an offence` (JUST 500) 500 EQUALS NOTHING
#ASSERT `s 71(2) the person is guilty of an offence` (JUST 500) 600 EQUALS NOTHING
#ASSERT `s 71(2) the person is guilty of an offence` NOTHING 100 EQUALS NOTHING
#ASSERT `s 71(2) the penalty on conviction` FALSE EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 6
#ASSERT `s 71(2) the penalty on conviction` TRUE EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 10000, `longest imprisonment in months` IS JUST 24

#ASSERT `s 73 the child or young person may be employed as a workman` (JUST TRUE) TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 73 the child or young person may be employed as a workman` (JUST TRUE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 73 the child or young person may be employed as a workman` (JUST FALSE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 73 the child or young person may be employed as a workman` NOTHING TRUE TRUE EQUALS NOTHING
#ASSERT `s 73 the child or young person may be employed as a workman` (JUST TRUE) FALSE TRUE EQUALS NOTHING

#ASSERT `s 74 the person is guilty of an offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 74 the person is guilty of an offence` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 74 the person is guilty of an offence` FALSE FALSE EQUALS NOTHING
#ASSERT `s 74 the penalty on conviction` FALSE EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 0, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 24
#ASSERT `s 74 the penalty on conviction` TRUE EQUALS `Penalty on conviction` WITH `least fine in dollars` IS 5000, `greatest fine in dollars` IS JUST 5000, `longest imprisonment in months` IS JUST 24

#ASSERT `s 75 the child or young person may be brought before a Youth Court` TRUE EQUALS JUST TRUE
#ASSERT `s 75 the child or young person may be brought before a Youth Court` FALSE EQUALS NOTHING
#ASSERT `s 75 the Youth Court may exercise the powers conferred by section 54 of the Children and Young Persons Act 1993` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 75 the Youth Court may exercise the powers conferred by section 54 of the Children and Young Persons Act 1993` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 75 the Youth Court may exercise the powers conferred by section 54 of the Children and Young Persons Act 1993` FALSE TRUE EQUALS NOTHING
