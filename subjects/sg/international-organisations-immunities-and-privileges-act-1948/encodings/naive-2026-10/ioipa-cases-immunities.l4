IMPORT prelude
IMPORT `ioipa-immunities`

-- International Organisations (Immunities and Privileges) Act 1948, ss 2 to 5 and the First and Second Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_international-organisations-immunities-and-privileges-act-1948.py). Expected results were written by
-- hand from the text.

`Rhea, a delegate on an organ` MEANS Person WITH
    `role` IS `a representative on an organ`
    `age` IS 50
    `an order covers the person or principal` IS TRUE
    `the order excludes Part 4` IS FALSE
    `accompanying the principal` IS FALSE

`Colm, a committee member` MEANS Person WITH
    `role` IS `a member of a committee`
    `age` IS 45
    `an order covers the person or principal` IS TRUE
    `the order excludes Part 4` IS FALSE
    `accompanying the principal` IS FALSE

`Hana, a deputy secretary-general` MEANS Person WITH
    `role` IS `a specified high officer`
    `age` IS 55
    `an order covers the person or principal` IS TRUE
    `the order excludes Part 4` IS FALSE
    `accompanying the principal` IS FALSE

`Milo, sent on a mission` MEANS Person WITH
    `role` IS `a person on a specified mission`
    `age` IS 40
    `an order covers the person or principal` IS TRUE
    `the order excludes Part 4` IS FALSE
    `accompanying the principal` IS FALSE

`Cara, a programme officer` MEANS Person WITH
    `role` IS `an officer or employee of a specified class`
    `age` IS 35
    `an order covers the person or principal` IS TRUE
    `the order excludes Part 4` IS FALSE
    `accompanying the principal` IS FALSE

`Nils, an unlisted analyst` MEANS Person WITH
    `role` IS `an officer or employee of a specified class`
    `age` IS 30
    `an order covers the person or principal` IS FALSE
    `the order excludes Part 4` IS FALSE
    `accompanying the principal` IS FALSE

`Sami, the delegate's aide at the meeting` MEANS Person WITH
    `role` IS `official staff of a representative or committee member`
    `age` IS 33
    `an order covers the person or principal` IS TRUE
    `the order excludes Part 4` IS FALSE
    `accompanying the principal` IS TRUE

`Tess, the delegate's aide left at home` MEANS Person WITH
    `role` IS `official staff of a representative or committee member`
    `age` IS 33
    `an order covers the person or principal` IS TRUE
    `the order excludes Part 4` IS FALSE
    `accompanying the principal` IS FALSE

`Pat, the high officer's husband` MEANS Person WITH
    `role` IS `the spouse of a high officer`
    `age` IS 56
    `an order covers the person or principal` IS TRUE
    `the order excludes Part 4` IS FALSE
    `accompanying the principal` IS FALSE

`Pia, a high officer's wife, Part 4 excluded` MEANS Person WITH
    `role` IS `the spouse of a high officer`
    `age` IS 52
    `an order covers the person or principal` IS TRUE
    `the order excludes Part 4` IS TRUE
    `accompanying the principal` IS FALSE

`Kai, the high officer's son aged 20` MEANS Person WITH
    `role` IS `a child of a high officer`
    `age` IS 20
    `an order covers the person or principal` IS TRUE
    `the order excludes Part 4` IS FALSE
    `accompanying the principal` IS FALSE

`Lia, the high officer's daughter aged 21` MEANS Person WITH
    `role` IS `a child of a high officer`
    `age` IS 21
    `an order covers the person or principal` IS TRUE
    `the order excludes Part 4` IS FALSE
    `accompanying the principal` IS FALSE

`Mona, the missioner's wife` MEANS Person WITH
    `role` IS `a family member of a person on a mission`
    `age` IS 40
    `an order covers the person or principal` IS TRUE
    `the order excludes Part 4` IS FALSE
    `accompanying the principal` IS FALSE

§ `s 2(1) and First Schedule`

#ASSERT `section 2 applies to the organisation` `the Organisation for Economic Co-operation and Development`
#ASSERT `section 2 applies to the organisation` `an organisation the President has declared under s 2(1)(a)`
#ASSERT NOT `section 2 applies to the organisation` `a foreign charity or industry association`

§ `s 2(2)(a) and Second Schedule Part 1`

#ASSERT `the organisation has the benefit` `the Organisation for Economic Co-operation and Development` `immunity from suit and legal process` TRUE FALSE
#ASSERT NOT `the organisation has the benefit` `the Organisation for Economic Co-operation and Development` `immunity from suit and legal process` FALSE FALSE
#ASSERT NOT `the organisation has the benefit` `a foreign charity or industry association` `immunity from suit and legal process` TRUE FALSE
#ASSERT NOT `the organisation has the benefit` `the Bank for International Settlements` `exemption from export duty` TRUE TRUE
#ASSERT `the organisation has the benefit` `the Bank for International Settlements` `exemption from import duty on goods imported for official use` TRUE TRUE
#ASSERT NOT `the organisation has the benefit` `the Bank for International Settlements` `exemption from import duty on goods imported for official use` TRUE FALSE
#ASSERT NOT `the organisation has the benefit` `the Bank for International Settlements` `exemption from excise duty on goods imported for official use` TRUE FALSE
#ASSERT NOT `the organisation has the benefit` `the Bank for International Settlements` `exemption from import duty on goods not for official use` TRUE TRUE
#ASSERT `the organisation has the benefit` `the International Tribunal for the Law of the Sea` `inviolability of official archives and office premises` TRUE FALSE
#ASSERT `the organisation has the benefit` `an organisation the President has declared under s 2(1)(a)` `the legal capacities of a body corporate` TRUE FALSE
#ASSERT `the organisation has the benefit` `the International Tribunal for the Law of the Sea` `reduced press telegram rates` TRUE FALSE

§ `s 2(2)(b), (c) and Second Schedule Parts 2 to 4`

#ASSERT `the Part that applies` `Rhea, a delegate on an organ` EQUALS `Part 2`
#ASSERT `the Part that applies` `Hana, a deputy secretary-general` EQUALS `Part 2`
#ASSERT `the Part that applies` `Milo, sent on a mission` EQUALS `Part 2`
#ASSERT `the Part that applies` `Cara, a programme officer` EQUALS `Part 3`
#ASSERT `the Part that applies` `Nils, an unlisted analyst` EQUALS `no Part`
#ASSERT `the Part that applies` `Sami, the delegate's aide at the meeting` EQUALS `Part 2 extended by Part 4`
#ASSERT `the Part that applies` `Tess, the delegate's aide left at home` EQUALS `no Part`
#ASSERT `the Part that applies` `Pat, the high officer's husband` EQUALS `Part 2 extended by Part 4`
#ASSERT `the Part that applies` `Pia, a high officer's wife, Part 4 excluded` EQUALS `no Part`
#ASSERT `the Part that applies` `Kai, the high officer's son aged 20` EQUALS `Part 2 extended by Part 4`
#ASSERT `the Part that applies` `Lia, the high officer's daughter aged 21` EQUALS `no Part`
#ASSERT `the Part that applies` `Mona, the missioner's wife` EQUALS `no Part`

#ASSERT `the person is immune from the suit` `Cara, a programme officer` TRUE
#ASSERT NOT `the person is immune from the suit` `Cara, a programme officer` FALSE
#ASSERT `the person is immune from the suit` `Rhea, a delegate on an organ` FALSE
#ASSERT `the person is immune from the suit` `Kai, the high officer's son aged 20` FALSE
#ASSERT NOT `the person is immune from the suit` `Nils, an unlisted analyst` TRUE
#ASSERT NOT `the person is immune from the suit` `Mona, the missioner's wife` TRUE

#ASSERT `the person's residence is inviolable` `Colm, a committee member`
#ASSERT NOT `the person's residence is inviolable` `Cara, a programme officer`
#ASSERT `the person's residence is inviolable` `Pat, the high officer's husband`

#ASSERT `the Act exempts the person's salary from the organisation from income tax` `Cara, a programme officer`
#ASSERT NOT `the Act exempts the person's salary from the organisation from income tax` `Hana, a deputy secretary-general`

§ `s 2(2) proviso`

#ASSERT `the order goes beyond the proviso` TRUE FALSE
#ASSERT NOT `the order goes beyond the proviso` TRUE TRUE
#ASSERT NOT `the order goes beyond the proviso` FALSE FALSE

§ `s 2(3)`

#ASSERT `a Gazette list must be compiled` `s 2(2)(b)`
#ASSERT NOT `a Gazette list must be compiled` `s 2(2)(c)`

§ `s 3`

#ASSERT `the conference status` `a representative of a foreign Power` TRUE TRUE EQUALS `treated as an envoy`
#ASSERT `the conference status` `official staff of a foreign representative` TRUE TRUE EQUALS `treated as an envoy's retinue`
#ASSERT `the conference status` `a representative of a foreign Power` TRUE FALSE EQUALS `no status under s 3`
#ASSERT `the conference status` `a delegate of a non-governmental body` TRUE TRUE EQUALS `no status under s 3`

§ `s 4(b)`

#ASSERT `an order under s 4(b) may reach the person` `a suitor to the International Court`
#ASSERT NOT `an order under s 4(b) may reach the person` `a journalist covering the Court`

§ `s 5`

#ASSERT `the President may withhold on the ground of reciprocity` TRUE
#ASSERT NOT `the President may withhold on the ground of reciprocity` FALSE

