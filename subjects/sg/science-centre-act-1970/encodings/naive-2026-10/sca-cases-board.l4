IMPORT prelude
IMPORT `sca-board`

-- Science Centre Act 1970, ss 2, 4, 6, 7(2), 10-12, 14, 15, 18, 19, 20(2) -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_science-centre-act-1970.py). Expected results were written by
-- hand from the text.

`a lease sealed before the Chairperson and one member, both signing` MEANS Sealing WITH
    `sealed with the common seal` IS TRUE
    `before the Chairperson or Deputy Chairperson, including a temporary one` IS TRUE
    `before one other member of the Board` IS TRUE
    `both of them signed` IS TRUE

`a deed sealed before a temporary Deputy Chairperson and one member, both signing` MEANS Sealing WITH
    `sealed with the common seal` IS TRUE
    `before the Chairperson or Deputy Chairperson, including a temporary one` IS TRUE
    `before one other member of the Board` IS TRUE
    `both of them signed` IS TRUE

`a contract sealed before the chief executive and one member, both signing` MEANS Sealing WITH
    `sealed with the common seal` IS TRUE
    `before the Chairperson or Deputy Chairperson, including a temporary one` IS FALSE
    `before one other member of the Board` IS TRUE
    `both of them signed` IS TRUE

`a deed sealed before the Deputy Chairperson alone` MEANS Sealing WITH
    `sealed with the common seal` IS TRUE
    `before the Chairperson or Deputy Chairperson, including a temporary one` IS TRUE
    `before one other member of the Board` IS FALSE
    `both of them signed` IS TRUE

`a deed sealed before the Chairperson and a member who did not sign` MEANS Sealing WITH
    `sealed with the common seal` IS TRUE
    `before the Chairperson or Deputy Chairperson, including a temporary one` IS TRUE
    `before one other member of the Board` IS TRUE
    `both of them signed` IS FALSE

