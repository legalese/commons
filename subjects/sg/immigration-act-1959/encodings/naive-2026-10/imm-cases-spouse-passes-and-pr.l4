IMPORT prelude
IMPORT `imm-spouse-passes-and-pr`

-- Immigration Act 1959, ss 2, 6-10, 12, 14(3), 55(1)(c) and 57C(6) -- a citizen's foreign spouse: worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case, the Immigration Regulations or ICA's published criteria (none was retrieved).
--
-- Expected results were written by hand from the text.

§ `Fixtures`

-- Haziq scenario h033: a Malaysian national married to a citizen, living in Singapore for three years, applying for PR.
`the Malaysian spouse` MEANS Applicant WITH
    `is a citizen` IS FALSE
    `is married to a citizen` IS TRUE
    `has applied in the form the Controller requires` IS TRUE
    `has paid the prescribed fee` IS TRUE
    `is a prohibited immigrant` IS FALSE
    `years lived in Singapore` IS 3
    `holds a passport of a country the Minister has approved` IS TRUE

-- The same person, unmarried.
`an unmarried foreigner` MEANS Applicant WITH
    `is a citizen` IS FALSE
    `is married to a citizen` IS FALSE
    `has applied in the form the Controller requires` IS TRUE
    `has paid the prescribed fee` IS TRUE
    `is a prohibited immigrant` IS FALSE
    `years lived in Singapore` IS 3
    `holds a passport of a country the Minister has approved` IS TRUE

-- Married to a citizen for twenty years, still a non-citizen.
`a long-married spouse` MEANS Applicant WITH
    `is a citizen` IS FALSE
    `is married to a citizen` IS TRUE
    `has applied in the form the Controller requires` IS TRUE
    `has paid the prescribed fee` IS TRUE
    `is a prohibited immigrant` IS FALSE
    `years lived in Singapore` IS 20
    `holds a passport of a country the Minister has approved` IS TRUE

-- A spouse just married, never lived in Singapore.
`a newly married spouse abroad` MEANS Applicant WITH
    `is a citizen` IS FALSE
    `is married to a citizen` IS TRUE
    `has applied in the form the Controller requires` IS TRUE
    `has paid the prescribed fee` IS TRUE
    `is a prohibited immigrant` IS FALSE
    `years lived in Singapore` IS 0
    `holds a passport of a country the Minister has approved` IS FALSE

-- Married to a citizen but has not paid the fee.
`a spouse who has not paid` MEANS Applicant WITH
    `is a citizen` IS FALSE
    `is married to a citizen` IS TRUE
    `has applied in the form the Controller requires` IS TRUE
    `has paid the prescribed fee` IS FALSE
    `is a prohibited immigrant` IS FALSE
    `years lived in Singapore` IS 5
    `holds a passport of a country the Minister has approved` IS TRUE

-- Married to a citizen, has not applied at all.
`a spouse who has not applied` MEANS Applicant WITH
    `is a citizen` IS FALSE
    `is married to a citizen` IS TRUE
    `has applied in the form the Controller requires` IS FALSE
    `has paid the prescribed fee` IS FALSE
    `is a prohibited immigrant` IS FALSE
    `years lived in Singapore` IS 5
    `holds a passport of a country the Minister has approved` IS TRUE

-- A prohibited immigrant married to a citizen.
`a prohibited spouse` MEANS Applicant WITH
    `is a citizen` IS FALSE
    `is married to a citizen` IS TRUE
    `has applied in the form the Controller requires` IS TRUE
    `has paid the prescribed fee` IS TRUE
    `is a prohibited immigrant` IS TRUE
    `years lived in Singapore` IS 4
    `holds a passport of a country the Minister has approved` IS TRUE

-- A citizen.
`a citizen` MEANS Applicant WITH
    `is a citizen` IS TRUE
    `is married to a citizen` IS TRUE
    `has applied in the form the Controller requires` IS TRUE
    `has paid the prescribed fee` IS TRUE
    `is a prohibited immigrant` IS FALSE
    `years lived in Singapore` IS 30
    `holds a passport of a country the Minister has approved` IS FALSE

§ `REQ-0286 (Haziq scenario h033)`

-- The pass: the Act creates no long-term visit pass. A pass is issued under the regulations (s 2, s 55(1)(c)).
#ASSERT `the instrument that creates a long-term visit pass` EQUALS `regulations under section 55`

-- Permanent residence: an entry permit under s 10, which the Controller MAY issue on application and fee.
#ASSERT `the instrument that empowers a grant of permanent residence` EQUALS `this Act`
#ASSERT `the footing for permanent residence of` `the Malaysian spouse` EQUALS `discretionary`

-- After how long: the Act states no period.
#ASSERT `the minimum years of residence the Act requires for permanent residence` EQUALS 0

-- Marriage to a citizen changes nothing in the Act: same footing married or not.
#ASSERT `the footing for permanent residence of` `an unmarried foreigner` EQUALS `discretionary`

-- And no length of marriage or residence turns it into a right.
#ASSERT NOT (`the footing for permanent residence of` `a long-married spouse` EQUALS `as of right`)

§ `ss 2, 55 -- where each status comes from`

#ASSERT `the instrument that empowers the cancellation of a pass` EQUALS `regulations under section 55`
#ASSERT NOT `a pass lets the holder remain permanently`

§ `s 10 -- the footing for permanent residence`

#ASSERT `the footing for permanent residence of` `a long-married spouse` EQUALS `discretionary`
#ASSERT `the footing for permanent residence of` `a spouse who has not paid` EQUALS `not available`
#ASSERT `the footing for permanent residence of` `a citizen` EQUALS `not available`

#ASSERT `the applicant has met every condition the Act sets for permanent residence` `a newly married spouse abroad`
#ASSERT NOT `the applicant has met every condition the Act sets for permanent residence` `a spouse who has not paid`

§ `ss 2, 10(1A), 14(3) -- what the entry permit does`

#ASSERT `the person is a permanent resident` TRUE
#ASSERT `what the entry permit authorises` TRUE EQUALS `remain in Singapore`
#ASSERT `what the entry permit authorises` FALSE EQUALS `enter once within the period in its conditions`

#ASSERT `an entry permit issued to the applicant would have to be cancelled` `a prohibited spouse`
#ASSERT NOT `an entry permit issued to the applicant would have to be cancelled` `the Malaysian spouse`

§ `s 10(4), (4A) -- notice of changed conditions`

#ASSERT `the notice requirement is satisfied` (ConditionChange TRUE FALSE FALSE FALSE)
#ASSERT `the notice requirement is satisfied` (ConditionChange FALSE TRUE TRUE TRUE)
#ASSERT NOT `the notice requirement is satisfied` (ConditionChange FALSE TRUE FALSE TRUE)

§ `ss 6, 7, 8 -- entering on a pass`

#ASSERT `the spouse may enter on the pass` (SpouseEntry FALSE TRUE FALSE FALSE)
#ASSERT NOT `the spouse may enter on the pass` (SpouseEntry FALSE FALSE FALSE FALSE)
#ASSERT NOT `the spouse may enter on the pass` (SpouseEntry FALSE TRUE TRUE FALSE)
#ASSERT `the spouse may enter on the pass` (SpouseEntry FALSE TRUE TRUE TRUE)

#ASSERT NOT `the spouse falls in class (a)` FALSE TRUE FALSE
#ASSERT `the spouse falls in class (a)` FALSE FALSE FALSE
#ASSERT `the spouse falls in class (a)` TRUE TRUE TRUE

§ `ss 9B, 9C, 10(2) -- visas`

#ASSERT NOT `a Singapore visa is needed to travel` `the Malaysian spouse`
#ASSERT `a Singapore visa is needed to travel` `a newly married spouse abroad`
#ASSERT `the Controller must grant a visa with the entry permit` `a newly married spouse abroad` TRUE
#ASSERT NOT `the Controller must grant a visa with the entry permit` `the Malaysian spouse` TRUE
#ASSERT NOT `a visa is itself permission to enter`

§ `s 12 -- endorsing the wife`

#ASSERT NOT `the spouse may be endorsed on the holder's document` FALSE `a wife`
#ASSERT `the spouse may be endorsed on the holder's document` TRUE `a wife`
#ASSERT NOT `the spouse may be endorsed on the holder's document` TRUE `a husband`

§ `s 57C(6) -- immigration advantage`

#ASSERT `the grant is an immigration advantage` `a pass` `the party`
#ASSERT `the grant is an immigration advantage` `an entry permit` `the party`
#ASSERT `the grant is an immigration advantage` `a visa` `a child of the party`
#ASSERT NOT `the grant is an immigration advantage` `a pass` `a sibling of the party`
#ASSERT NOT `the grant is an immigration advantage` `citizenship` `the party`
