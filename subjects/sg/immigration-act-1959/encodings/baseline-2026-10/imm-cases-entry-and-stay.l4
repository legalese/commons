IMPORT prelude
IMPORT `imm-entry-and-stay`
IMPORT daydate

-- Immigration Act 1959, entering, staying, losing status and removal -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case. The deposited Immigration Regulations are used where a section names
-- them (regs 6(1) and 12, Sixth Schedule).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_immigration-act-1959_baseline.py). Expected results were written by
-- hand from the text.

§ `s 5 -- where I may cross`

#ASSERT `Do I commit an offence by entering or leaving where I did` FALSE FALSE

§ `ss 6, 7, 8(2) -- may I enter`

`a citizen with no papers` MEANS `My papers` WITH
    `I am a citizen of Singapore` IS TRUE
    `I hold a valid entry permit or re-entry permit` IS FALSE
    `my name is endorsed on a valid permit and I am with its holder` IS FALSE
    `I hold a valid pass` IS FALSE
    `I am exempted by an order under section 56` IS FALSE
    `I am a prohibited immigrant` IS FALSE
    `I am banned by an order under section 9` IS FALSE
    `my pass is one issuable to a prohibited immigrant` IS FALSE

`a tourist with a visit pass` MEANS `My papers` WITH
    `I am a citizen of Singapore` IS FALSE
    `I hold a valid entry permit or re-entry permit` IS FALSE
    `my name is endorsed on a valid permit and I am with its holder` IS FALSE
    `I hold a valid pass` IS TRUE
    `I am exempted by an order under section 56` IS FALSE
    `I am a prohibited immigrant` IS FALSE
    `I am banned by an order under section 9` IS FALSE
    `my pass is one issuable to a prohibited immigrant` IS FALSE

`a foreigner with no papers` MEANS `My papers` WITH
    `I am a citizen of Singapore` IS FALSE
    `I hold a valid entry permit or re-entry permit` IS FALSE
    `my name is endorsed on a valid permit and I am with its holder` IS FALSE
    `I hold a valid pass` IS FALSE
    `I am exempted by an order under section 56` IS FALSE
    `I am a prohibited immigrant` IS FALSE
    `I am banned by an order under section 9` IS FALSE
    `my pass is one issuable to a prohibited immigrant` IS FALSE

`an exempt prohibited immigrant with a visit pass` MEANS `My papers` WITH
    `I am a citizen of Singapore` IS FALSE
    `I hold a valid entry permit or re-entry permit` IS FALSE
    `my name is endorsed on a valid permit and I am with its holder` IS FALSE
    `I hold a valid pass` IS TRUE
    `I am exempted by an order under section 56` IS FALSE
    `I am a prohibited immigrant` IS TRUE
    `I am banned by an order under section 9` IS FALSE
    `my pass is one issuable to a prohibited immigrant` IS TRUE

`a banned person with a pass` MEANS `My papers` WITH
    `I am a citizen of Singapore` IS FALSE
    `I hold a valid entry permit or re-entry permit` IS FALSE
    `my name is endorsed on a valid permit and I am with its holder` IS FALSE
    `I hold a valid pass` IS TRUE
    `I am exempted by an order under section 56` IS FALSE
    `I am a prohibited immigrant` IS TRUE
    `I am banned by an order under section 9` IS TRUE
    `my pass is one issuable to a prohibited immigrant` IS TRUE

#ASSERT `May I enter Singapore` `a citizen with no papers` EQUALS `by right, as a citizen`
#ASSERT `May I enter Singapore` `a tourist with a visit pass` EQUALS `on my permit or pass`
#ASSERT `May I enter Singapore` `a foreigner with no papers` EQUALS `I may not enter`
#ASSERT `May I enter Singapore` `an exempt prohibited immigrant with a visit pass` EQUALS `on my permit or pass`
#ASSERT `May I enter Singapore` `a banned person with a pass` EQUALS `I may not enter`

#ASSERT `What can I be sentenced to for entering without a permit or pass` TRUE EQUALS (Sentence OF TRUE, 0, 6, 0, TRUE, 3, 0)
#ASSERT `What can I be sentenced to for entering without a permit or pass` FALSE EQUALS (Sentence OF TRUE, 0, 6, 0, FALSE, 0, 6000)

§ `s 8 -- prohibited immigrants; regulation 12 -- visit passes`

#ASSERT `Am I a prohibited immigrant` (LIST `(ba) AIDS or HIV infection`) FALSE FALSE
#ASSERT `Am I a prohibited immigrant` (LIST `(n) family or dependant of a prohibited immigrant`) FALSE FALSE
#ASSERT NOT `Am I a prohibited immigrant` (LIST `(i) opposed to established government`) TRUE FALSE

#ASSERT `Does my conviction make me a prohibited immigrant` TRUE FALSE TRUE
#ASSERT NOT `Does my conviction make me a prohibited immigrant` FALSE FALSE TRUE

#ASSERT `Can I be issued a visit pass` (EMPTY) TRUE EQUALS `may be issued, if the Controller is satisfied of my purpose`
#ASSERT `Can I be issued a visit pass` (LIST `(ba) AIDS or HIV infection`) TRUE EQUALS `may be issued to me as an exempt prohibited immigrant, first valid for at most 90 days`
#ASSERT `Can I be issued a visit pass` (LIST `(ba) AIDS or HIV infection`, `(a) unable to show means of support`) TRUE EQUALS `not covered by this encoding`

§ `ss 9, 9AA -- entry bans and no-boarding directives`

`a PR abroad with a re-entry permit, economic order` MEANS `My position under a ban` WITH
    `I am a citizen of Singapore` IS FALSE
    `the order is for public security or public health` IS FALSE
    `I was outside Singapore when the order was made` IS TRUE
    `I hold a valid re-entry permit or pass` IS TRUE

`a PR abroad with a re-entry permit, health order` MEANS `My position under a ban` WITH
    `I am a citizen of Singapore` IS FALSE
    `the order is for public security or public health` IS TRUE
    `I was outside Singapore when the order was made` IS TRUE
    `I hold a valid re-entry permit or pass` IS TRUE

#ASSERT NOT `Does the entry ban apply to me` `a PR abroad with a re-entry permit, economic order`
#ASSERT `Does the entry ban apply to me` `a PR abroad with a re-entry permit, health order`

`a pass-holder the Controller thinks undesirable` MEANS `My boarding` WITH
    `the ground` IS `the Controller is satisfied my presence would be undesirable`
    `I am a citizen of Singapore` IS FALSE
    `I hold a valid permit or pass` IS TRUE
    `I am only transiting` IS FALSE
    `the order prohibits or limits arrival` IS FALSE

#ASSERT NOT `Can I be directed not to board` `a pass-holder the Controller thinks undesirable`

§ `ss 10, 11, 14A -- permanent residence and re-entry`

#ASSERT `On what footing can I be made a permanent resident` FALSE TRUE TRUE EQUALS `at the Controller's discretion`

#ASSERT `What do I pay in fees for an entry permit` TRUE EQUALS 120

#ASSERT `What is the last day I can apply for a re-entry permit` (Date 1 3 2026) EQUALS Date 27 8 2026

#ASSERT `On what day is my entry permit cancelled if I do not apply` (Date 1 3 2026) EQUALS Date 28 8 2026

`a PR who never applied` MEANS `My time abroad` WITH
    `I am outside Singapore without a valid re-entry permit` IS TRUE
    `I applied before the first day and it was pending then or rejected on or after it` IS FALSE
    `I applied within the 180 days` IS FALSE
    `my application was rejected` IS FALSE

`a PR who applied in time and is waiting` MEANS `My time abroad` WITH
    `I am outside Singapore without a valid re-entry permit` IS TRUE
    `I applied before the first day and it was pending then or rejected on or after it` IS FALSE
    `I applied within the 180 days` IS TRUE
    `my application was rejected` IS FALSE

`a PR who applied early and was refused` MEANS `My time abroad` WITH
    `I am outside Singapore without a valid re-entry permit` IS TRUE
    `I applied before the first day and it was pending then or rejected on or after it` IS TRUE
    `I applied within the 180 days` IS FALSE
    `my application was rejected` IS TRUE

#ASSERT `Is my permanent residence cancelled automatically` `a PR who never applied`
#ASSERT NOT `Is my permanent residence cancelled automatically` `a PR who applied in time and is waiting`
#ASSERT `Is my permanent residence cancelled automatically` `a PR who applied early and was refused`

#TRACE `Must I apply for a re-entry permit while abroad` AT 0 WITH
    PARTY `the permanent resident` DOES `apply for a re-entry permit` AT 179

#TRACE `Must I apply for a re-entry permit while abroad` AT 0 WITH
    PARTY `the permanent resident` DOES `apply for a re-entry permit` AT 200

#ASSERT `What does a re-entry permit cost me` 18 EQUALS 20

§ `s 11A -- ceasing to be a citizen`

`30 hours on, no application` MEANS `My loss of citizenship` WITH
    `hours since I ceased to be a citizen` IS 30
    `I hold a permit or pass to remain` IS FALSE
    `I applied within the 24 hours` IS FALSE
    `my application was rejected` IS FALSE
    `hours since I was told of the rejection` IS 0

`30 hours on, applied in time, pending` MEANS `My loss of citizenship` WITH
    `hours since I ceased to be a citizen` IS 30
    `I hold a permit or pass to remain` IS FALSE
    `I applied within the 24 hours` IS TRUE
    `my application was rejected` IS FALSE
    `hours since I was told of the rejection` IS 0

#ASSERT NOT `May I remain in Singapore after ceasing to be a citizen` `30 hours on, no application`
#ASSERT `May I remain in Singapore after ceasing to be a citizen` `30 hours on, applied in time, pending`

§ `ss 12, 14 -- endorsement and cancellation`

#ASSERT `Can my relative be endorsed on my permit, pass or certificate` `my wife`
#ASSERT NOT `Can my relative be endorsed on my permit, pass or certificate` `my husband`

#ASSERT `Can my permit be cancelled` `I am a prohibited immigrant` EQUALS `must be cancelled, if the Controller is satisfied of the ground`
#ASSERT `Can my permit be cancelled` `I arrived with a child not endorsed on my permit` EQUALS `may be cancelled`

#ASSERT NOT `Must I be given notice of the cancellation` `I arrived with a child not endorsed on my permit`

§ `ss 15, 32, 33, 39A -- remaining unlawfully, removal, review`

#ASSERT `What can I be sentenced to for remaining unlawfully` 90 TRUE EQUALS (Sentence OF FALSE, 0, 6, 4000, FALSE, 0, 0)
#ASSERT `What can I be sentenced to for remaining unlawfully` 91 TRUE EQUALS (Sentence OF TRUE, 0, 6, 0, TRUE, 3, 0)

#ASSERT `Can I be ordered to be removed from Singapore` `I am unlawfully in Singapore under section 15` FALSE
#ASSERT NOT `Can I be ordered to be removed from Singapore` `I was convicted under section 5, 6, 8 or 9` TRUE

#ASSERT NOT `Can I take the decision to court on this ground` `I was not heard`

