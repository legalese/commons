IMPORT prelude
IMPORT `imm-offences`
IMPORT `imm-entry-and-stay`

-- Immigration Act 1959, harbouring, employing, work places, marriages of convenience and false information -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or against the regulations.
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_immigration-act-1959_baseline.py). Expected results were written by
-- hand from the text.

§ `s 57(1)(d) -- harbouring`

`a landlord who looked at the pass and the passport` MEANS `My checks on the lodger` WITH
    `I inspected the permit or pass` IS TRUE
    `I checked the passport particulars match the permit or pass` IS TRUE
    `I checked validity with the Controller or with the named employer` IS FALSE

`a landlord who did all three checks` MEANS `My checks on the lodger` WITH
    `I inspected the permit or pass` IS TRUE
    `I checked the passport particulars match the permit or pass` IS TRUE
    `I checked validity with the Controller or with the named employer` IS TRUE

#ASSERT `Can I rely on the lodger's pass against a charge of reckless harbouring` `a landlord who looked at the pass and the passport`

#ASSERT NOT `Can I rely on the lodger's pass against a charge of negligent harbouring` `a landlord who looked at the pass and the passport`
#ASSERT `Can I rely on the lodger's pass against a charge of negligent harbouring` `a landlord who did all three checks`

#ASSERT `What can I be sentenced to for harbouring` `reckless, s 57(1)(d)(ii)` EQUALS (Sentence OF TRUE, 6, 24, 6000, FALSE, 0, 0)
#ASSERT `What can I be sentenced to for harbouring` `negligent, s 57(1)(d)(iii)` EQUALS (Sentence OF FALSE, 0, 12, 6000, FALSE, 0, 0)

§ `s 57(1)(e) -- employing`

`an employer who checked a visit pass only` MEANS `My hiring` WITH
    `I inspected the worker's permit or pass` IS TRUE
    `I checked the passport particulars match it` IS TRUE
    `the worker held a visit pass` IS TRUE
    `I had reasonable grounds to believe a work pass or written consent was in force` IS FALSE

`an employer who checked a work-pass holder` MEANS `My hiring` WITH
    `I inspected the worker's permit or pass` IS TRUE
    `I checked the passport particulars match it` IS TRUE
    `the worker held a visit pass` IS FALSE
    `I had reasonable grounds to believe a work pass or written consent was in force` IS FALSE

#ASSERT NOT `Can I rely on the worker's pass against a charge of employing an immigration offender` `an employer who checked a visit pass only`
#ASSERT `Can I rely on the worker's pass against a charge of employing an immigration offender` `an employer who checked a work-pass holder`

#ASSERT `What can I be sentenced to for employing immigration offenders` 5 TRUE EQUALS (Sentence OF TRUE, 6, 24, 6000, FALSE, 0, 0)
#ASSERT `What can I be sentenced to for employing immigration offenders` 6 TRUE EQUALS (Sentence OF TRUE, 6, 24, 6000, TRUE, 0, 0)

#ASSERT `Am I presumed to have knowingly employed the offender found there` TRUE FALSE

§ `s 57A -- work places`

#ASSERT `What is the least fine I face if fined as occupier of the work place` 3 FALSE EQUALS 45000

#ASSERT `What is the most I can be fined as occupier of the work place` 3 TRUE EQUALS 180000

§ `s 57C -- marriages of convenience`

`a spouse in a visa marriage, nothing paid` MEANS `My marriage facts` WITH
    `my part` IS `I am a party to the marriage`
    `I knew or had reason to believe a purpose was an immigration advantage` IS TRUE
    `I intended to help a party obtain an immigration advantage` IS FALSE
    `gratification was offered, given or received for entering the marriage` IS FALSE
    `I believed on reasonable grounds it would be a genuine marriage` IS FALSE

`an unpaid matchmaker aiming at a pass` MEANS `My marriage facts` WITH
    `my part` IS `I arranged or helped arrange it`
    `I knew or had reason to believe a purpose was an immigration advantage` IS FALSE
    `I intended to help a party obtain an immigration advantage` IS TRUE
    `gratification was offered, given or received for entering the marriage` IS FALSE
    `I believed on reasonable grounds it would be a genuine marriage` IS FALSE

`a paid spouse who believed it genuine` MEANS `My marriage facts` WITH
    `my part` IS `I am a party to the marriage`
    `I knew or had reason to believe a purpose was an immigration advantage` IS TRUE
    `I intended to help a party obtain an immigration advantage` IS FALSE
    `gratification was offered, given or received for entering the marriage` IS TRUE
    `I believed on reasonable grounds it would be a genuine marriage` IS TRUE

#ASSERT NOT `Do I commit the marriage of convenience offence` `a spouse in a visa marriage, nothing paid`
#ASSERT `Do I commit the marriage of convenience offence` `an unpaid matchmaker aiming at a pass`
#ASSERT NOT `Do I commit the marriage of convenience offence` `a paid spouse who believed it genuine`

#ASSERT NOT `Is what is sought an immigration advantage` `citizenship` `a party to the marriage`

§ `s 57(1)(k), (ka) -- false information`

#ASSERT `What can I be sentenced to for false information in my application` TRUE EQUALS (Sentence OF FALSE, 0, 12, 8000, FALSE, 0, 0)
#ASSERT `What can I be sentenced to for false information in my application` FALSE EQUALS (Sentence OF FALSE, 0, 0, 4000, FALSE, 0, 0)

