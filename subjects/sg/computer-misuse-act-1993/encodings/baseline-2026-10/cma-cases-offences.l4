§ `s 2 -- computer, access, authority, damage`

#ASSERT `Is it a computer` `a phone, laptop, server or other data processing device` FALSE
#ASSERT NOT `Is it a computer` `a portable hand-held calculator` FALSE
#ASSERT NOT `Is it a computer` `a phone, laptop, server or other data processing device` TRUE

#ASSERT `Have I secured access to the program or data` FALSE FALSE FALSE TRUE
#ASSERT NOT `Have I secured access to the program or data` FALSE FALSE FALSE FALSE

#ASSERT `Was my access without authority` FALSE FALSE
#ASSERT NOT `Was my access without authority` FALSE TRUE

#ASSERT NOT `Was my modification unauthorised` TRUE FALSE

#ASSERT NOT `Did my offence cause damage` 9999 NOTHING FALSE FALSE FALSE
#ASSERT `Did my offence cause damage` 10000 NOTHING FALSE FALSE FALSE
#ASSERT NOT `Did my offence cause damage` 12000 (JUST 20000) FALSE FALSE FALSE
#ASSERT `Did my offence cause damage` 0 NOTHING TRUE FALSE FALSE

§ `ss 3 to 8 -- the offences`

#ASSERT `Have I committed the section 3 offence` TRUE TRUE TRUE
#ASSERT NOT `Have I committed the section 3 offence` TRUE TRUE FALSE

#ASSERT `Have I committed the section 4 offence` TRUE TRUE TRUE 2
#ASSERT NOT `Have I committed the section 4 offence` TRUE TRUE TRUE 1
#ASSERT NOT `Have I committed the section 4 offence` TRUE TRUE FALSE 5

#ASSERT NOT `Have I committed the section 5 offence` TRUE FALSE

#ASSERT NOT `Have I committed the section 7 offence` TRUE TRUE TRUE FALSE

#ASSERT `Have I committed the section 8 offence` TRUE FALSE FALSE TRUE

§ `ss 8A and 8B -- Singpass`

#ASSERT `Have I committed the section 8A offence` `selling my Singpass to a stranger online`
#ASSERT NOT `Have I committed the section 8A offence` `selling it, but proving I had no reasonable grounds`
#ASSERT NOT `Have I committed the section 8A offence` `letting my daughter file my tax return in my name`
#ASSERT `Have I committed the section 8A offence` `lending it knowing it was for an offence`

#ASSERT NOT `Does the section 8A(3) presumption stand against me` `selling it, but proving I had no reasonable grounds`

#ASSERT NOT `Is it a Singpass credential of another person` `some other detail of theirs, such as an identity card number`

#ASSERT `Have I committed the section 8B offence by obtaining or retaining` `their Singpass password` TRUE TRUE
#ASSERT NOT `Have I committed the section 8B offence by obtaining or retaining` `their Singpass password` TRUE FALSE

#ASSERT `Have I committed the section 8B offence by supplying` `a Singpass app registered in their identity` TRUE FALSE FALSE TRUE
#ASSERT NOT `Have I committed the section 8B offence by supplying` `their Singpass password` TRUE TRUE TRUE TRUE

§ `ss 9, 10, 12 -- personal information, tools, participation`

-- s 9 Example 1: A downloads and keeps a list of hacked card numbers to report it to the police, and sends it to B.
-- Example 2: C, B's employee, sends it to D for B's investigation. Neither commits an offence.
#ASSERT NOT `Have I committed the section 9 offence by obtaining or retaining` TRUE TRUE FALSE

#ASSERT NOT `Have I committed the section 9 offence by supplying` TRUE TRUE FALSE FALSE FALSE
#ASSERT `Have I committed the section 9 offence by supplying` TRUE TRUE FALSE TRUE FALSE

#ASSERT NOT `Have I committed the section 10 offence` TRUE TRUE FALSE FALSE

#ASSERT `Am I guilty of the offence itself` `I did an act preparatory to or in furtherance of it`
#ASSERT NOT `Am I guilty of the offence itself` `I took no part`

