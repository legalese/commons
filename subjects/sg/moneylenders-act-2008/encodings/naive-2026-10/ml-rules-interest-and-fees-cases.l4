IMPORT prelude
IMPORT `ml-rules-interest-and-fees`

-- Moneylenders Act 2008 ss 35 and 36, Moneylenders Rules 2009 rules 11, 12, 12A, 12B and 21 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked against
-- a decided case. The Rules are the version in force from 1 August 2026; a question dated 2032 is answered on that text.
--
-- Expected results were written by hand from the text.

§ `REQ-0277 (Haziq scenario, event from the Jun Hao scenario)`

-- A licensed moneylender lends $8,000 (not a business loan) to a borrower earning $36,000 a year. ASSUMED, not supplied:
-- a Singapore borrower, no other unsecured loans outstanding, an unsecured loan.
-- Interest: at most 4% a month on the outstanding principal -- $320 in the first month. Late interest: at most 4% a month
-- on what is overdue. Fees: a grant fee of at most 10% ($800), late-payment fees of at most $60 a month in aggregate, and
-- court-ordered legal costs; nothing else. Interest, late interest and those two fees together: at most $8,000.
#ASSERT `the maximum monthly interest rate` EQUALS 0.04
#ASSERT `the most interest for the month` 8000 0 EQUALS 320
#ASSERT `the maximum monthly late interest rate` EQUALS 0.04
#ASSERT `the largest grant fee` 8000 EQUALS 800
#ASSERT `the monthly limit on late payment fees` EQUALS 60
#ASSERT `the ceiling on interest, late interest and fees` 8000 EQUALS 8000
#ASSERT NOT `the fee is permitted` `an administrative or processing fee` FALSE TRUE
#ASSERT `the unsecured borrowing ceiling` 36000 FALSE EQUALS 18000
#ASSERT `the unsecured loan is within rule 21` 8000 0 36000 FALSE

§ `Rule 11(2), (4) -- interest on the reducing balance, late interest on the overdue amount`

#ASSERT `the principal on which interest runs` 8000 2500 EQUALS 5500
#ASSERT `the most interest for the month` 8000 1000 EQUALS 280
#ASSERT `the most interest for the month` 8000 8000 EQUALS 0
#ASSERT `the most late interest for the month` 700 EQUALS 28
#ASSERT `the most late interest for the month` 0 EQUALS 0

§ `Rule 11, rule 12B, s 36 -- breaching the cap`

#ASSERT `the rule 11 caps apply` FALSE
#ASSERT NOT `the rule 11 caps apply` TRUE
#ASSERT NOT `the contract breaches the interest cap` FALSE 0.04 0.04
#ASSERT `the contract breaches the interest cap` FALSE 0.045 0.04
#ASSERT `the contract breaches the interest cap` FALSE 0.04 0.05
#ASSERT NOT `the contract breaches the interest cap` TRUE 0.08 0.08

§ `Rule 12 -- which fees are permitted`

#ASSERT `the fee is permitted` `a fee on the grant of the loan` FALSE TRUE
#ASSERT NOT `the fee is permitted` `a fee on the grant of the loan` TRUE TRUE
#ASSERT NOT `the fee is permitted` `a fee on the grant of the loan` FALSE FALSE
#ASSERT `the fee is permitted` `a late payment fee` FALSE TRUE
#ASSERT `the fee is permitted` `court-ordered legal costs of recovery` FALSE TRUE
#ASSERT NOT `the fee is permitted` `a fee for a dishonoured cheque` FALSE TRUE
#ASSERT `the fee is permitted` `a fee for a dishonoured cheque` TRUE TRUE
#ASSERT `the fee is permitted` `a fee for an unsuccessful GIRO deduction` TRUE TRUE
#ASSERT NOT `the fee is permitted` `a fee for varying the terms at the borrower's request` FALSE TRUE
#ASSERT `the fee is permitted` `an early redemption or termination fee on a term loan` TRUE TRUE
#ASSERT NOT `the fee is permitted` `an administrative or processing fee` TRUE TRUE

§ `Rule 12(1)(a) -- late payment fees, $60 a month in aggregate`

#ASSERT `the late payment fees recoverable for the month` 0 25 EQUALS 0
#ASSERT `the late payment fees recoverable for the month` 1 20 EQUALS 20
#ASSERT `the late payment fees recoverable for the month` 2 25 EQUALS 50
#ASSERT `the late payment fees recoverable for the month` 4 15 EQUALS 60
#ASSERT `the late payment fees recoverable for the month` 3 25 EQUALS 60

§ `Rule 12A -- the aggregate ceiling`

#ASSERT `the amount recoverable for interest and fees` 8000 FALSE 9500 EQUALS 8000
#ASSERT `the amount recoverable for interest and fees` 8000 FALSE 5000 EQUALS 5000
#ASSERT `the amount recoverable for interest and fees` 8000 TRUE 9500 EQUALS 9500

§ `Rule 21 -- unsecured loans by income`

#ASSERT `the unsecured borrowing ceiling` 19999 FALSE EQUALS 3000
#ASSERT `the unsecured borrowing ceiling` 20000 FALSE EQUALS 10000
#ASSERT `the unsecured borrowing ceiling` 120000 FALSE EQUALS 60000
#ASSERT `the unsecured borrowing ceiling` 15000 TRUE EQUALS 3000
#ASSERT `the unsecured borrowing ceiling` 9000 TRUE EQUALS 500
#ASSERT `annual income from three months` 9000 EQUALS 36000
#ASSERT `the unsecured loan is within rule 21` 8000 10000 36000 FALSE
#ASSERT NOT `the unsecured loan is within rule 21` 8000 10001 36000 FALSE
#ASSERT NOT `the unsecured loan is within rule 21` 3500 0 15000 FALSE
