IMPORT prelude
IMPORT `sbfa-membership`

-- Singapore Business Federation Act 2001, ss 4, 5, 7(2), 8(2)-(3), 9, 10, 11, 12 and the Schedule -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_singapore-business-federation-act-2001.py). Expected results were written by
-- hand from the text.

§ `s 5 -- membership by force of law`

#ASSERT `is a member by force of the Act` `a local company` 500000 0 FALSE FALSE
#ASSERT NOT `is a member by force of the Act` `a local company` 499999 0 FALSE FALSE
#ASSERT NOT `is a member by force of the Act` `a local company` 100000 5000000 FALSE FALSE
#ASSERT `is a member by force of the Act` `a foreign company` 0 500000 FALSE FALSE
#ASSERT NOT `is a member by force of the Act` `a foreign company` 2000000 499999 FALSE FALSE
#ASSERT NOT `is a member by force of the Act` `a local company` 1000000 0 TRUE FALSE
#ASSERT NOT `is a member by force of the Act` `a local company` 1000000 0 FALSE TRUE
#ASSERT NOT `is a member by force of the Act` `another kind of business` 10000000 10000000 FALSE FALSE

§ `s 12 -- subscriptions`

#ASSERT `the subscription is within the cap` 1500
#ASSERT NOT `the subscription is within the cap` 1501
#ASSERT `the subscription is within the cap` 1200

#ASSERT `the amount above the cap` 1500 EQUALS 0
#ASSERT `the amount above the cap` 2000 EQUALS 500
#ASSERT `the amount above the cap` 900 EQUALS 0

#ASSERT `the most that can lawfully be charged` 2000 EQUALS 1500
#ASSERT `the most that can lawfully be charged` 900 EQUALS 900

#ASSERT `the subscription is payable under s 12` TRUE TRUE TRUE 1500
#ASSERT NOT `the subscription is payable under s 12` FALSE TRUE TRUE 1000
#ASSERT NOT `the subscription is payable under s 12` TRUE TRUE FALSE 1000
#ASSERT NOT `the subscription is payable under s 12` TRUE FALSE TRUE 1000
#ASSERT NOT `the subscription is payable under s 12` TRUE TRUE TRUE 1600

