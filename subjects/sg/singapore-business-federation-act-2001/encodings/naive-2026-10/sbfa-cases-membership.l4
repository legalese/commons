#ASSERT `commits an offence under s 9(3)` FALSE FALSE FALSE TRUE FALSE
#ASSERT `commits an offence under s 9(3)` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT `commits an offence under s 9(3)` FALSE FALSE FALSE FALSE FALSE

#ASSERT `the maximum fine under s 9(3)` EQUALS 1000

§ `s 4 and the Schedule -- the Council`

#ASSERT `foreign representation is within the quarter` 0 40
#ASSERT `foreign representation is within the quarter` 10 40
#ASSERT NOT `foreign representation is within the quarter` 11 40
#ASSERT NOT `foreign representation is within the quarter` 4 13

#ASSERT `the Council is composed as s 4 requires` TRUE TRUE TRUE 5 20
#ASSERT NOT `the Council is composed as s 4 requires` TRUE FALSE TRUE 5 20
#ASSERT NOT `the Council is composed as s 4 requires` TRUE TRUE TRUE 6 20

§ `s 7(2) -- Board approval`

#ASSERT `needs the Board's approval` `the annual report and accounts`
#ASSERT `needs the Board's approval` `the annual budget`
#ASSERT `needs the Board's approval` `a property dealing at or above the Board's value`
#ASSERT NOT `needs the Board's approval` `a property dealing below the Board's value`
#ASSERT `needs the Board's approval` `appointing a Council member`
#ASSERT `needs the Board's approval` `amending the Constitution`
#ASSERT NOT `needs the Board's approval` `admitting a voluntary member`

§ `s 8(2), (3) -- the auditor`

#ASSERT `the auditor is validly appointed` TRUE TRUE TRUE
#ASSERT NOT `the auditor is validly appointed` TRUE TRUE FALSE
#ASSERT NOT `the auditor is validly appointed` TRUE FALSE TRUE

§ `ss 10 and 11`

#ASSERT `the Federation may be dissolved` TRUE
#ASSERT NOT `the Federation may be dissolved` FALSE

#ASSERT NOT `the Constitution provision has effect` TRUE
#ASSERT `the Constitution provision has effect` FALSE

