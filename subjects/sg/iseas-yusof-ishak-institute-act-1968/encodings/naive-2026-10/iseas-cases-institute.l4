#ASSERT NOT `the donation may be applied to the proposed use` TRUE FALSE
#ASSERT `the donation may be applied to the proposed use` FALSE FALSE

#ASSERT `the donation must be separately accounted for` TRUE
#ASSERT NOT `the donation must be separately accounted for` FALSE

§ `s 10 -- common seal`

#ASSERT `the instrument is properly sealed` `the Chairperson` `the Director` TRUE
#ASSERT `the instrument is properly sealed` `a Board member designated by the Chairperson` `an Executive Committee member designated by the Director` TRUE
#ASSERT NOT `the instrument is properly sealed` `the Chairperson` `the Director` FALSE
#ASSERT NOT `the instrument is properly sealed` `a Board member not designated by the Chairperson` `the Director` TRUE
#ASSERT NOT `the instrument is properly sealed` `the Chairperson` `an Executive Committee member not designated by the Director` TRUE
#ASSERT NOT `the instrument is properly sealed` `nobody from the Board` `the Director` TRUE

§ `s 14(2)(d)(vii), (h) -- fees`

#ASSERT `the Institute may demand the fee` TRUE TRUE
#ASSERT NOT `the Institute may demand the fee` TRUE FALSE
#ASSERT NOT `the Institute may demand the fee` FALSE TRUE

§ `s 14(4) -- inspection`

#ASSERT `may inspect the committee's proceedings under the Act` `a member of the Executive Committee`
#ASSERT `may inspect the committee's proceedings under the Act` `a member of the committee`
#ASSERT NOT `may inspect the committee's proceedings under the Act` `a Board member not on the Executive Committee`
#ASSERT NOT `may inspect the committee's proceedings under the Act` `a fellow of the Institute`
#ASSERT NOT `may inspect the committee's proceedings under the Act` `a member of the public`

§ `who decides what`

#ASSERT `who decides` `approving the annual report and accounts` EQUALS `the Board`
#ASSERT `who decides` `preparing the annual report` EQUALS `the Executive Committee`
#ASSERT `who decides` `approving the budget and research programme` EQUALS `the Board`
#ASSERT `who decides` `appointing senior research staff` EQUALS `the Executive Committee`
#ASSERT `who decides` `appointing other officers and employees` EQUALS `the Board`
#ASSERT `who decides` `appointing an acting Director` EQUALS `the Board`
#ASSERT `who decides` `disciplining a fellow` EQUALS `the Director`
#ASSERT `who decides` `authorising grants-in-aid` EQUALS `the Minister`
#ASSERT `who decides` `making rules under the Act` EQUALS `the Minister`

