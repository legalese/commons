§ `s 2`

#ASSERT `the person's status under section 2` `remanded in prison awaiting trial` EQUALS `a prisoner`
#ASSERT `the person's status under section 2` `detained in a reformative training centre` EQUALS `a prisoner`
#ASSERT `the person's status under section 2` `detained in an approved institution under the Misuse of Drugs Act 1973` EQUALS `an inmate`
#ASSERT `the person's status under section 2` `held in a police lock-up that is not prescribed` EQUALS `neither a prisoner nor an inmate`
#ASSERT `the person's status under section 2` `released from custody` EQUALS `neither a prisoner nor an inmate`

§ `s 15`

#ASSERT `the Corporation may provide technical training in a skilled trade under section 15(c)` `a sentenced prisoner working in a Corporation workshop`
#ASSERT NOT `the Corporation may provide technical training in a skilled trade under section 15(c)` `a remand prisoner not working`

#ASSERT `the Corporation may provide work for the purposes of section 67 of the Prisons Act 1933` `a remand prisoner not working`
#ASSERT NOT `the Corporation may provide work for the purposes of section 67 of the Prisons Act 1933` `an inmate on the Corporation's payroll`

#ASSERT `the Corporation may provide aftercare services under section 15(g)` `a remand prisoner not working`
#ASSERT `the Corporation may provide aftercare services under section 15(g)` `a discharged offender not in business`

§ `s 16`

#ASSERT `the Corporation may pay the person for work under section 16(c)` `a sentenced prisoner working in a Corporation workshop`
#ASSERT `the Corporation may pay the person for work under section 16(c)` `an inmate on the Corporation's payroll`
#ASSERT NOT `the Corporation may pay the person for work under section 16(c)` `a remand prisoner not working`

#ASSERT `the Corporation may make the person a staff or housing loan under section 16(g)` `a Corporation staff member`
#ASSERT NOT `the Corporation may make the person a staff or housing loan under section 16(g)` `an inmate on the Corporation's payroll`

#ASSERT `the Corporation may promote welfare activities for the person under section 16(h)` `a retired Corporation staff member`
#ASSERT NOT `the Corporation may promote welfare activities for the person under section 16(h)` `an inmate on the Corporation's payroll`

#ASSERT `the Corporation may make a business grant, loan or guarantee under section 16(k)` `a discharged offender running a food stall`
#ASSERT NOT `the Corporation may make a business grant, loan or guarantee under section 16(k)` `a discharged offender not in business`
#ASSERT NOT `the Corporation may make a business grant, loan or guarantee under section 16(k)` `a sentenced prisoner working in a Corporation workshop`

