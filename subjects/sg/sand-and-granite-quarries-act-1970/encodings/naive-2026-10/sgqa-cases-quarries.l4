IMPORT prelude
IMPORT `sgqa-quarries`

-- Sand and Granite Quarries Act 1970, ss 2, 4, 5, 7, 8, 9, 10, 12, 14, 16 to 20, 22 and 23 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_sand-and-granite-quarries-act-1970.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a clean sand quarry application` MEANS Application WITH
    `the kind of quarry` IS `a sand quarry`
    `refused information required` IS FALSE
    `deposited a Chief Surveyor's certified site plan` IS FALSE
    `likely to cause nuisance or damage to neighbours` IS FALSE
    `likely to depreciate neighbouring value or amenity` IS FALSE
    `likely to be dangerous to health, life or property` IS FALSE

`a sand application without a site plan` MEANS Application WITH
    `the kind of quarry` IS `a sand quarry`
    `refused information required` IS FALSE
    `deposited a Chief Surveyor's certified site plan` IS FALSE
    `likely to cause nuisance or damage to neighbours` IS FALSE
    `likely to depreciate neighbouring value or amenity` IS FALSE
    `likely to be dangerous to health, life or property` IS FALSE

`a granite application with a certified site plan` MEANS Application WITH
    `the kind of quarry` IS `a granite quarry`
    `refused information required` IS FALSE
    `deposited a Chief Surveyor's certified site plan` IS TRUE
    `likely to cause nuisance or damage to neighbours` IS FALSE
    `likely to depreciate neighbouring value or amenity` IS FALSE
    `likely to be dangerous to health, life or property` IS FALSE

`a granite application without a site plan` MEANS Application WITH
    `the kind of quarry` IS `a granite quarry`
    `refused information required` IS FALSE
    `deposited a Chief Surveyor's certified site plan` IS FALSE
    `likely to cause nuisance or damage to neighbours` IS FALSE
    `likely to depreciate neighbouring value or amenity` IS FALSE
    `likely to be dangerous to health, life or property` IS FALSE

`a sand application withholding information` MEANS Application WITH
    `the kind of quarry` IS `a sand quarry`
    `refused information required` IS TRUE
    `deposited a Chief Surveyor's certified site plan` IS FALSE
    `likely to cause nuisance or damage to neighbours` IS FALSE
    `likely to depreciate neighbouring value or amenity` IS FALSE
    `likely to be dangerous to health, life or property` IS FALSE

`a granite application likely to disturb neighbours` MEANS Application WITH
    `the kind of quarry` IS `a granite quarry`
    `refused information required` IS FALSE
    `deposited a Chief Surveyor's certified site plan` IS TRUE
    `likely to cause nuisance or damage to neighbours` IS TRUE
    `likely to depreciate neighbouring value or amenity` IS FALSE
    `likely to be dangerous to health, life or property` IS FALSE

`a granite application likely to endanger life` MEANS Application WITH
    `the kind of quarry` IS `a granite quarry`
    `refused information required` IS FALSE
    `deposited a Chief Surveyor's certified site plan` IS TRUE
    `likely to cause nuisance or damage to neighbours` IS FALSE
    `likely to depreciate neighbouring value or amenity` IS FALSE
    `likely to be dangerous to health, life or property` IS TRUE

§ `s 2`

#ASSERT `the land is a sand quarry` TRUE TRUE
#ASSERT NOT `the land is a sand quarry` TRUE FALSE

#ASSERT `the land is a granite quarry` TRUE FALSE
#ASSERT `the land is a granite quarry` TRUE TRUE

§ `ss 4, 23`

#ASSERT `quarrying without a licence is an offence` TRUE FALSE FALSE
#ASSERT NOT `quarrying without a licence is an offence` TRUE TRUE FALSE
#ASSERT NOT `quarrying without a licence is an offence` TRUE FALSE TRUE

#ASSERT `use as that kind of quarry is presumed` `a sand quarry` TRUE FALSE TRUE
#ASSERT NOT `use as that kind of quarry is presumed` `a sand quarry` FALSE TRUE TRUE
#ASSERT `use as that kind of quarry is presumed` `a granite quarry` FALSE TRUE TRUE

§ `ss 5, 8`

#ASSERT `the Licensing Officer may grant the licence` `a clean sand quarry application`
#ASSERT `the Licensing Officer may grant the licence` `a sand application without a site plan`
#ASSERT `the Licensing Officer may grant the licence` `a granite application with a certified site plan`
#ASSERT NOT `the Licensing Officer may grant the licence` `a granite application without a site plan`
#ASSERT NOT `the Licensing Officer may grant the licence` `a sand application withholding information`
#ASSERT NOT `the Licensing Officer may grant the licence` `a granite application likely to disturb neighbours`
#ASSERT NOT `the Licensing Officer may grant the licence` `a granite application likely to endanger life`

#ASSERT `the licence period is within section 5(4)` 12 FALSE
#ASSERT NOT `the licence period is within section 5(4)` 13 FALSE
#ASSERT `the licence period is within section 5(4)` 24 TRUE

#ASSERT NOT `the licence may be transferred` FALSE

#ASSERT `an appeal to the Minister lies` `a refusal to grant` TRUE
#ASSERT `an appeal to the Minister lies` `a revocation` TRUE
#ASSERT NOT `an appeal to the Minister lies` `conditions attached to a grant` TRUE
#ASSERT NOT `an appeal to the Minister lies` `a refusal of consent to transfer` TRUE
#ASSERT NOT `an appeal to the Minister lies` `a revocation` FALSE

§ `ss 7, 9, 22`

#ASSERT `the Licensing Officer may do the work at the licensee's expense` TRUE FALSE
#ASSERT NOT `the Licensing Officer may do the work at the licensee's expense` FALSE FALSE

#ASSERT `the expenses may be recovered as if a fine` 8 FALSE
#ASSERT NOT `the expenses may be recovered as if a fine` 7 FALSE

§ `ss 10, 12`

#ASSERT NOT `the licensee breaches section 10(1)` TRUE TRUE FALSE
#ASSERT `the licensee breaches section 10(1)` FALSE TRUE TRUE

#ASSERT `the licensee breaches section 12` TRUE FALSE

§ `s 14`

#ASSERT `the disused quarry is in breach of section 14` TRUE TRUE FALSE
#ASSERT NOT `the disused quarry is in breach of section 14` TRUE TRUE TRUE
#ASSERT NOT `the disused quarry is in breach of section 14` FALSE TRUE FALSE

#ASSERT `who is liable under section 14` TRUE EQUALS `the licensee`
#ASSERT `who is liable under section 14` FALSE EQUALS `the owner of the land`

§ `ss 4, 9, 14, 16 to 19`

#ASSERT `the maximum total fine` `unlicensed quarrying` 10 EQUALS 6000
#ASSERT `the maximum total fine` `leaving a dangerous disused quarry unfenced` 10 EQUALS 1500
#ASSERT `the maximum total fine` `defaulting on a notice with no special fine` 10 EQUALS 1000
#ASSERT `the maximum total fine` `any other contravention or breach of licence condition` 10 EQUALS 1500
#ASSERT `the maximum total fine` `unlicensed quarrying` 0 EQUALS 5000

#ASSERT `the maximum imprisonment in months` `obstructing an officer` EQUALS 12

#ASSERT `the sentence is within section 16` 1000 0
#ASSERT `the sentence is within section 16` 0 12
#ASSERT NOT `the sentence is within section 16` 500 6

