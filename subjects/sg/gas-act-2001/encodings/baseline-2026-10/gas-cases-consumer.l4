§ `s 2 -- my gas, and am I a consumer`

#ASSERT `Is my gas gas within the Act` `my flat on piped natural gas`
#ASSERT NOT `Is my gas gas within the Act` `my kitchen on an LPG cylinder`

#ASSERT `Am I a consumer` `my flat on piped natural gas`

§ `s 6 -- do I need a gas licence`

#ASSERT NOT `Do I need a gas licence for what I do` `me reselling retailed gas to my tenants`
#ASSERT NOT `Do I need a gas licence for what I do` `me retailing gas before the Minister's date`
#ASSERT `Do I need a gas licence for what I do` `me retailing gas after the Minister's date`

#ASSERT `Am I committing an offence by doing it without a licence` `me piping gas to my neighbour's premises unlicensed`

§ `ss 11 to 13 -- my gas worker`

#ASSERT `May my worker carry out my gas service work` `a professional engineer with a practising certificate`
#ASSERT `May my worker carry out my gas service work` `a fitter licensed for this class`
#ASSERT NOT `May my worker carry out my gas service work` `a fitter licensed for another class only`

#ASSERT `Am I committing an offence by engaging my worker` `a professional engineer with a practising certificate`
#ASSERT NOT `Am I committing an offence by engaging my worker` `a fitter licensed for another class only`
#ASSERT `Am I committing an offence by engaging my worker` `an unlicensed handyman`

§ `ss 22, 23 -- getting connected`

#ASSERT `Must the gas transporter connect my premises` `my plain connection request`
#ASSERT NOT `Must the gas transporter connect my premises` `my request where connecting is dangerous`
#ASSERT NOT `Must the gas transporter connect my premises` `my request needing a new main, no agreement`

#ASSERT `What is the most I can be charged for the connection` `my plain connection request` EQUALS 2000

§ `ss 29 to 31 -- the pipes on my land`

#ASSERT `Who pays to repair my gas service pipe` TRUE TRUE EQUALS `I pay`
#ASSERT `Who pays to repair my gas service pipe` TRUE FALSE EQUALS `the gas transporter pays`

#ASSERT `Must the gas transporter move the pipe for me` TRUE TRUE TRUE
#ASSERT NOT `Must the gas transporter move the pipe for me` FALSE TRUE TRUE

#ASSERT `Can I make the transporter remove the disused pipe at its own expense` FALSE FALSE 7
#ASSERT NOT `Can I make the transporter remove the disused pipe at its own expense` FALSE FALSE 6

#ASSERT `Am I committing an offence by building over the pipe` TRUE FALSE

#ASSERT `Who pays to divert the pipe from under my building` TRUE TRUE EQUALS `I pay`
#ASSERT `Who pays to divert the pipe from under my building` FALSE TRUE EQUALS `I pay to the extent I benefit, the gas transporter pays the rest`

§ `s 32 -- digging near a gas pipe`

#ASSERT `How many days' notice must I give before digging` `digging after 7 days' notice` EQUALS 7
#ASSERT `How many days' notice must I give before digging` `digging after 3 days' notice where the Authority set 3` EQUALS 3

#ASSERT `May I start the earthworks` `digging after 7 days' notice`
#ASSERT NOT `May I start the earthworks` `digging after 6 days' notice`

#ASSERT `Am I guilty of the earthworks offence` `digging after 6 days' notice`
#ASSERT `Am I guilty of the earthworks offence` `safety digging, notice 25 hours after`
#ASSERT `Am I guilty of the earthworks offence` `digging after 6 days' notice, defence on transporter's plans, prosecutor told 13 clear days before`
#ASSERT NOT `Am I guilty of the earthworks offence` `digging after 6 days' notice, defence on transporter's plans, prosecutor told 14 clear days before`

§ `ss 32A, 32B -- damaging a gas pipe`

#ASSERT `Am I committing an offence by what I did to the gas pipe` `my digger hit a pipe on land, without fault`
#ASSERT NOT `Am I committing an offence by what I did to the gas pipe` `my digger hit a pipe on land, with the defence`
#ASSERT NOT `Am I committing an offence by what I did to the gas pipe` `I negligently blocked a pipe on land`
#ASSERT `Am I committing an offence by what I did to the gas pipe` `my boat's anchor negligently dragged a submarine pipeline`

§ `ss 39, 44 -- reporting damage, and my meter`

#ASSERT `Am I committing an offence by not reporting the damaged pipe` TRUE TRUE FALSE

#ASSERT `Who must keep my meter in proper order` `a meter lent or hired to me by the gas transporter or gas shipper` EQUALS `the gas transporter or gas shipper must keep it in proper order, without charge to me`

§ `s 46 -- cut off for an unpaid bill`

#ASSERT `May my gas retailer cut off my supply for non-payment` `my bill unpaid 28 days after demand, 7 days' notice`
#ASSERT NOT `May my gas retailer cut off my supply for non-payment` `my disputed bill`
#ASSERT NOT `May my gas retailer cut off my supply for non-payment` `my bill unpaid, only 6 days' notice`

§ `ss 47, 49, 50, 52 -- the meter, reconnecting, getting supply back`

#ASSERT `Will I be presumed to have tampered with the meter` FALSE FALSE TRUE FALSE TRUE
#ASSERT NOT `Will I be presumed to have tampered with the meter` TRUE TRUE TRUE TRUE FALSE

#ASSERT `Am I committing an offence by reconnecting my supply` TRUE TRUE FALSE

#ASSERT `May I connect or disconnect the meter or internal pipe` TRUE `my gas shipper or gas retailer` 48
#ASSERT NOT `May I connect or disconnect the meter or internal pipe` TRUE `the gas transporter` 72

#ASSERT NOT `Have I done what section 52 requires before my supply comes back` FALSE TRUE FALSE

§ `ss 53 to 60 -- notice before entry`

#ASSERT `How many days' notice must I be given before they enter` `a suspected gas escape` EQUALS 0
#ASSERT `How many days' notice must I be given before they enter` `reading the meter or inspecting fittings during supply` EQUALS 14

§ `ss 64, 89 -- safety, and my company's offence`

#ASSERT NOT `May I use a flame or other source of ignition` `near a known gas leak` TRUE TRUE

#ASSERT `Am I guilty of my company's offence` TRUE TRUE TRUE FALSE

§ `ss 6, 13, 32, 47, 91, 92 -- penalties and composition`

#ASSERT `What is the most I can be punished with` `doing a licensable gas activity without a licence` 0 EQUALS `up to` 1000000 0 25000
#ASSERT `What is the most I can be punished with` `engaging an unlicensed gas service worker` 0 EQUALS `up to` 10000 12 250
#ASSERT `What is the most I can be punished with` `an earthworks offence` 0 EQUALS `up to` 100000 60 0
#ASSERT `What is the most I can be punished with` `meter tampering or taking gas` 2000 EQUALS `up to` 56000 60 250
#ASSERT `What is the most I can be punished with` `an offence created by regulations` 0 EQUALS NOTHING

#ASSERT `What is the most I can be asked to pay to compound my offence` TRUE EQUALS (JUST 3000)

