IMPORT prelude
IMPORT `crtpa-nouns`
IMPORT `crtpa-s7-exceptions`

-- Tests for section 7.  Every expected value is written from the text of s 7, with the reason beside it,
-- before the module was run.  In each call the inputs are, in order, those of the rule's GIVEN.

§ `Tests -- s 7(1) to (4)`

#ASSERT `s 7(1) section 2 confers a right on the third party in the case of the contract` TRUE EQUALS JUST FALSE
#ASSERT `s 7(1) section 2 confers a right on the third party in the case of the contract` FALSE EQUALS NOTHING
#ASSERT `s 7(2) section 2 confers a right on the third party in the case of the contract` TRUE EQUALS JUST FALSE
#ASSERT `s 7(2) section 2 confers a right on the third party in the case of the contract` FALSE EQUALS NOTHING
-- (3): a registration document, or a limited liability partnership agreement.
#ASSERT `s 7(3) section 2 confers a right on the third party in the case of the contract` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 7(3) section 2 confers a right on the third party in the case of the contract` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 7(3) section 2 confers a right on the third party in the case of the contract` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 7(3) section 2 confers a right on the third party in the case of the contract` FALSE FALSE EQUALS NOTHING
-- (4): a contract of employment AND enforcement against an employee.
#ASSERT `s 7(4) section 2 confers a right on the third party to enforce a term of the contract of employment against an employee` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 7(4) section 2 confers a right on the third party to enforce a term of the contract of employment against an employee` TRUE FALSE EQUALS NOTHING
#ASSERT `s 7(4) section 2 confers a right on the third party to enforce a term of the contract of employment against an employee` FALSE TRUE EQUALS NOTHING
#ASSERT `s 7(4) section 2 confers a right on the third party to enforce a term of the contract of employment against an employee` FALSE FALSE EQUALS NOTHING

§ `Tests -- s 7(6) and (7): the definitions`

-- (7): the meaning is the Bills of Lading Act 1992's, stated by the person.
#ASSERT `s 7(7) the document has the meaning given by the Bills of Lading Act 1992 for its name` `a bill of lading` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 7(7) the document has the meaning given by the Bills of Lading Act 1992 for its name` `a bill of lading` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 7(7) the document has the meaning given by the Bills of Lading Act 1992 for its name` `a bill of lading` NOTHING EQUALS NOTHING
#ASSERT `s 7(7) the document has the meaning given by the Bills of Lading Act 1992 for its name` `a sea waybill` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 7(7) the document has the meaning given by the Bills of Lading Act 1992 for its name` `a ship's delivery order` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 7(7) the document has the meaning given by the Bills of Lading Act 1992 for its name` `any other document` (JUST TRUE) EQUALS NOTHING
-- (6) sea: inputs: a contract of carriage; (a) bill of lading or sea waybill; (b) ship's delivery order undertaking.
#ASSERT `s 7(6) the contract is a contract for the carriage of goods by sea` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 7(6) the contract is a contract for the carriage of goods by sea` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 7(6) the contract is a contract for the carriage of goods by sea` TRUE (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 7(6) the contract is a contract for the carriage of goods by sea` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 7(6) the contract is a contract for the carriage of goods by sea` TRUE NOTHING (JUST FALSE) EQUALS NOTHING
#ASSERT `s 7(6) the contract is a contract for the carriage of goods by sea` TRUE NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 7(6) the contract is a contract for the carriage of goods by sea` FALSE NOTHING NOTHING EQUALS JUST FALSE
-- (6) the appropriate convention: inputs: the mode; the Carriage by Air Act 1988 s 3 fact; the Minister's order fact.
#ASSERT `s 7(6) the Convention is the appropriate international transport convention for the contract` `carriage of cargo by air` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 7(6) the Convention is the appropriate international transport convention for the contract` `carriage of cargo by air` (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 7(6) the Convention is the appropriate international transport convention for the contract` `carriage of cargo by air` NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 7(6) the Convention is the appropriate international transport convention for the contract` `carriage of goods by rail` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 7(6) the Convention is the appropriate international transport convention for the contract` `carriage of goods by rail` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 7(6) the Convention is the appropriate international transport convention for the contract` `carriage of goods by road` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 7(6) the Convention is the appropriate international transport convention for the contract` `carriage of goods by road` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 7(6) the Convention is the appropriate international transport convention for the contract` `carriage by sea` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 7(6) the Convention is the appropriate international transport convention for the contract` `carriage by some other mode` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
-- the words are "cargo" by air and "goods" by rail and road: the same carriage of passengers (say) has no appropriate convention under s 7(6), whatever the Convention says about it.
#ASSERT `s 7(6) the Convention is the appropriate international transport convention for the contract` `carriage by air of something other than cargo, such as passengers` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 7(6) the Convention is the appropriate international transport convention for the contract` `carriage by rail of something other than goods, such as passengers` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 7(6) the Convention is the appropriate international transport convention for the contract` `carriage by road of something other than goods, such as passengers` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE

§ `Tests -- s 7(5): carriage contracts`

-- the limbs.
#ASSERT `s 7(5)(a) the contract is a contract for the carriage of goods by sea` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 7(5)(a) the contract is a contract for the carriage of goods by sea` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 7(5)(a) the contract is a contract for the carriage of goods by sea` NOTHING EQUALS NOTHING
#ASSERT `s 7(5)(b) the contract is a contract for the carriage of goods by rail or road, or for the carriage of cargo by air, which is subject to the rules of the appropriate international transport convention` `carriage of cargo by air` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 7(5)(b) the contract is a contract for the carriage of goods by rail or road, or for the carriage of cargo by air, which is subject to the rules of the appropriate international transport convention` `carriage of goods by rail` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 7(5)(b) the contract is a contract for the carriage of goods by rail or road, or for the carriage of cargo by air, which is subject to the rules of the appropriate international transport convention` `carriage of goods by road` NOTHING EQUALS NOTHING
#ASSERT `s 7(5)(b) the contract is a contract for the carriage of goods by rail or road, or for the carriage of cargo by air, which is subject to the rules of the appropriate international transport convention` `carriage by sea` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 7(5)(b) the contract is a contract for the carriage of goods by rail or road, or for the carriage of cargo by air, which is subject to the rules of the appropriate international transport convention` `carriage by some other mode` (JUST TRUE) EQUALS JUST FALSE
-- not "cargo" or "goods": the same carriage of passengers (say) is not described by s 7(5)(b), even when the convention's rules govern it.
#ASSERT `s 7(5)(b) the contract is a contract for the carriage of goods by rail or road, or for the carriage of cargo by air, which is subject to the rules of the appropriate international transport convention` `carriage by air of something other than cargo, such as passengers` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 7(5)(b) the contract is a contract for the carriage of goods by rail or road, or for the carriage of cargo by air, which is subject to the rules of the appropriate international transport convention` `carriage by rail of something other than goods, such as passengers` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 7(5)(b) the contract is a contract for the carriage of goods by rail or road, or for the carriage of cargo by air, which is subject to the rules of the appropriate international transport convention` `carriage by road of something other than goods, such as passengers` (JUST TRUE) EQUALS JUST FALSE
-- the bar; inputs: (a) sea; (b) rail, road or air under a convention; the third party seeks only to avail itself of an exclusion or limitation.
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` (JUST TRUE) (JUST FALSE) FALSE EQUALS JUST FALSE
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` (JUST FALSE) (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` (JUST TRUE) (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` NOTHING (JUST TRUE) FALSE EQUALS JUST FALSE
-- the exception: availing of an exclusion or limitation lifts the bar, and a lifted bar grants nothing here.
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` (JUST TRUE) (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` (JUST FALSE) (JUST TRUE) TRUE EQUALS NOTHING
-- outside the carriage contracts the bar does not speak.
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` (JUST FALSE) (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` (JUST FALSE) (JUST FALSE) TRUE EQUALS NOTHING
-- not stated.
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` NOTHING NOTHING FALSE EQUALS NOTHING
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` NOTHING (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` NOTHING NOTHING TRUE EQUALS NOTHING
-- end to end, the same Convention in force: cargo by air is barred, passengers by air are not within (b), so the bar does not speak.
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` (JUST FALSE) (`s 7(5)(b) the contract is a contract for the carriage of goods by rail or road, or for the carriage of cargo by air, which is subject to the rules of the appropriate international transport convention` `carriage of cargo by air` (JUST TRUE)) FALSE EQUALS JUST FALSE
#ASSERT `s 7(5) section 2 confers a right on the third party in the case of the contract` (JUST FALSE) (`s 7(5)(b) the contract is a contract for the carriage of goods by rail or road, or for the carriage of cargo by air, which is subject to the rules of the appropriate international transport convention` `carriage by air of something other than cargo, such as passengers` (JUST TRUE)) FALSE EQUALS NOTHING
-- the text's own "may ... avail".
#ASSERT `s 7(5) the third party may in reliance on section 2 avail of an exclusion or limitation of liability in the contract` (JUST TRUE) (JUST FALSE) TRUE EQUALS JUST TRUE
#ASSERT `s 7(5) the third party may in reliance on section 2 avail of an exclusion or limitation of liability in the contract` (JUST FALSE) (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 7(5) the third party may in reliance on section 2 avail of an exclusion or limitation of liability in the contract` NOTHING (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 7(5) the third party may in reliance on section 2 avail of an exclusion or limitation of liability in the contract` (JUST TRUE) (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 7(5) the third party may in reliance on section 2 avail of an exclusion or limitation of liability in the contract` (JUST FALSE) (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 7(5) the third party may in reliance on section 2 avail of an exclusion or limitation of liability in the contract` NOTHING NOTHING TRUE EQUALS NOTHING
