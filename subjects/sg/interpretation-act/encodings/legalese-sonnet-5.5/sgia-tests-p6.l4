IMPORT prelude
IMPORT daydate
IMPORT `sgia-interpretation-time`
IMPORT `sgia-p6-misc`

-- Tests for sgia-p6-misc.l4 (ss 42 to 49, 54, 55). Expected values are written from the text of each section.

§ `ss 42, 43, 44`

#ASSERT `it is lawful to appoint the public officer by his or her official designation` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `it is lawful to appoint the public officer by his or her official designation` TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `it is lawful to appoint the public officer by his or her official designation` TRUE FALSE TRUE FALSE EQUALS NOTHING
#ASSERT `it is lawful to appoint the public officer by his or her official designation` TRUE TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `it is lawful to appoint the public officer by his or her official designation` FALSE TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `the person for the time being holding or carrying out the duties of the office is a member of the board` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the person for the time being holding or carrying out the duties of the office is a member of the board` TRUE TRUE EQUALS NOTHING
#ASSERT `the person for the time being holding or carrying out the duties of the office is a member of the board` FALSE FALSE EQUALS NOTHING
#ASSERT `it is lawful to appoint a chairperson of the body` TRUE FALSE EQUALS JUST TRUE
#ASSERT `it is lawful to appoint a chairperson of the body` TRUE TRUE EQUALS NOTHING
#ASSERT `it is lawful to appoint a chairperson of the body` FALSE FALSE EQUALS NOTHING
#ASSERT `the document is received as prima facie evidence without proof that the signature is that of the officer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `the document is received as prima facie evidence without proof that the signature is that of the officer` TRUE FALSE EQUALS NOTHING
#ASSERT `the document is received as prima facie evidence without proof that the signature is that of the officer` FALSE TRUE EQUALS NOTHING
#ASSERT `the reference is read as referring to the person for the time being holding or carrying out the duties of that office in Singapore` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `the reference is read as referring to the person for the time being holding or carrying out the duties of that office in Singapore` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `the reference is read as referring to the person for the time being holding or carrying out the duties of that office in Singapore` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `the reference is read as referring to the person for the time being holding or carrying out the duties of that office in Singapore` FALSE TRUE FALSE EQUALS NOTHING

§ `s 45: fees`

-- fee known: may decline until the fee is paid
#ASSERT `the person, officer, department or authority may decline to do the thing` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `the person, officer, department or authority may decline to do the thing` TRUE FALSE TRUE FALSE EQUALS JUST FALSE
-- amount not ascertainable until the thing is done: may decline until an estimated amount is paid
#ASSERT `the person, officer, department or authority may decline to do the thing` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `the person, officer, department or authority may decline to do the thing` TRUE TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `the person, officer, department or authority may decline to do the thing` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- (2): adjust by a further payment or a refund
#ASSERT `the adjustment after the thing has been done` 100 120 EQUALS 20
#ASSERT `the adjustment after the thing has been done` 130 120 EQUALS (0 MINUS 10)
#ASSERT `the adjustment after the thing has been done` 120 120 EQUALS 0

§ `s 46, 47`

#ASSERT `the Minister may by order published in the Gazette provide for fees or charges, charges and penalties for late payment, and interest` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the Minister may by order published in the Gazette provide for fees or charges, charges and penalties for late payment, and interest` TRUE TRUE EQUALS NOTHING
#ASSERT `the Minister may by order published in the Gazette provide for fees or charges, charges and penalties for late payment, and interest` FALSE FALSE EQUALS NOTHING
#ASSERT `the Minister may by order reduce, remit or refund it in whole or in part in the circumstances of a particular case` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the Minister may by order reduce, remit or refund it in whole or in part in the circumstances of a particular case` TRUE TRUE EQUALS NOTHING
#ASSERT `the Minister may by order reduce, remit or refund it in whole or in part in the circumstances of a particular case` FALSE FALSE EQUALS NOTHING
#ASSERT `the proceedings are discontinued or abated by the death, resignation, absence or removal from office` TRUE EQUALS JUST FALSE
#ASSERT `the proceedings are discontinued or abated by the death, resignation, absence or removal from office` FALSE EQUALS NOTHING
#ASSERT `the proceedings may be carried on by or against the person appointed to perform the duties of the office` TRUE EQUALS JUST TRUE
#ASSERT `the proceedings may be carried on by or against the person appointed to perform the duties of the office` FALSE EQUALS NOTHING

§ `s 48: the Gazette`

#ASSERT `the Gazette may be published in this form` TRUE `the prescribed website` EQUALS JUST TRUE
#ASSERT `the Gazette may be published in this form` TRUE `print` EQUALS JUST TRUE
#ASSERT `the Gazette may be published in this form` TRUE `another electronic form` EQUALS JUST TRUE
#ASSERT `the Gazette may be published in this form` TRUE `another prescribed form` EQUALS NOTHING
#ASSERT `the Gazette may be published in this form` FALSE `print` EQUALS NOTHING
-- (3): the earliest of the dates of publication in the several forms
#ASSERT `the date a Gazette published in 2 or more forms is deemed published` (LIST Date 2 3 2026, Date 1 3 2026, Date 3 3 2026) EQUALS JUST (Date 1 3 2026)
#ASSERT `the date a Gazette published in 2 or more forms is deemed published` (LIST Date 5 3 2026, Date 5 3 2026) EQUALS JUST (Date 5 3 2026)
#ASSERT `the date a Gazette published in 2 or more forms is deemed published` (LIST Date 5 3 2026) EQUALS NOTHING
#ASSERT `the date a Gazette published in 2 or more forms is deemed published` EMPTY EQUALS NOTHING
-- (4): judicial notice
#ASSERT `the Gazette in this form is to be judicially noticed` `the prescribed website` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the Gazette in this form is to be judicially noticed` `the prescribed website` FALSE FALSE EQUALS JUST FALSE
#ASSERT `the Gazette in this form is to be judicially noticed` `print` FALSE FALSE EQUALS JUST TRUE
#ASSERT `the Gazette in this form is to be judicially noticed` `another prescribed form` FALSE TRUE EQUALS JUST TRUE
#ASSERT `the Gazette in this form is to be judicially noticed` `another prescribed form` FALSE FALSE EQUALS JUST FALSE
#ASSERT `the Gazette in this form is to be judicially noticed` `another electronic form` FALSE TRUE EQUALS NOTHING
#ASSERT `it is, in all courts and for all purposes, prima facie evidence of the matters published in it` TRUE EQUALS JUST TRUE
#ASSERT `it is, in all courts and for all purposes, prima facie evidence of the matters published in it` FALSE EQUALS NOTHING
-- (6), (7): on or after the appointed date (here 2026-06-01) the website prevails over the Gazette in any other form; before it, print prevails.
-- The answer is for the first form against the second: JUST TRUE where the Act says it prevails, JUST FALSE where the Act says the other prevails over it,
-- NOTHING where neither (6) nor (7) speaks to the pair.
-- on or after the appointed date, (6): the website against every other form
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `the prescribed website` `print` (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `print` `the prescribed website` (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `the prescribed website` `another electronic form` (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `another electronic form` `the prescribed website` (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `the prescribed website` `another prescribed form` (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `another prescribed form` `the prescribed website` (Date 1 6 2026) (Date 1 6 2026) EQUALS JUST FALSE
-- on or after the appointed date, pairs (6) does not speak to: print and the other forms between themselves, and a form against itself
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `print` `another electronic form` (Date 1 6 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `another electronic form` `print` (Date 1 6 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `print` `another prescribed form` (Date 1 6 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `another prescribed form` `print` (Date 1 6 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `another electronic form` `another prescribed form` (Date 1 6 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `the prescribed website` `the prescribed website` (Date 1 6 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `print` `print` (Date 1 6 2026) (Date 1 6 2026) EQUALS NOTHING
-- before the appointed date, (7): print against every other form
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `print` `the prescribed website` (Date 31 5 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `the prescribed website` `print` (Date 31 5 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `print` `another electronic form` (Date 31 5 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `another electronic form` `print` (Date 31 5 2026) (Date 1 6 2026) EQUALS JUST FALSE
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `print` `another prescribed form` (Date 31 5 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `another prescribed form` `print` (Date 31 5 2026) (Date 1 6 2026) EQUALS JUST FALSE
-- before the appointed date, pairs (7) does not speak to
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `the prescribed website` `another electronic form` (Date 31 5 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `another electronic form` `the prescribed website` (Date 31 5 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `the prescribed website` `another prescribed form` (Date 31 5 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `another electronic form` `another prescribed form` (Date 31 5 2026) (Date 1 6 2026) EQUALS NOTHING
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `print` `print` (Date 31 5 2026) (Date 1 6 2026) EQUALS NOTHING
-- the day itself is on or after the appointed date; the day before it is not
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `the prescribed website` `print` (Date 2 6 2026) (Date 1 6 2026) EQUALS JUST TRUE
#ASSERT `this form prevails over the other form to the extent of any inconsistency` `print` `the prescribed website` (Date 31 5 2026) (Date 1 6 2026) EQUALS JUST TRUE

§ `s 48A: service of documents`

#ASSERT `the document may be served this way` TRUE `an individual` `by delivering it to the individual personally` FALSE EQUALS JUST TRUE
#ASSERT `the document may be served this way` TRUE `an individual` `by leaving it at the usual or last known address of the place of residence or business of the individual` FALSE EQUALS JUST TRUE
#ASSERT `the document may be served this way` TRUE `an individual` `by sending it by prepaid post to the usual or last known address of the place of residence or business of the individual` FALSE EQUALS JUST TRUE
#ASSERT `the document may be served this way` TRUE `a partnership` `by delivering it to the secretary or other like officer of the partnership` FALSE EQUALS JUST TRUE
#ASSERT `the document may be served this way` TRUE `a partnership` `by leaving it at the principal or last known place of business of the partnership in Singapore` FALSE EQUALS JUST TRUE
#ASSERT `the document may be served this way` TRUE `a partnership` `by sending it by prepaid post to the principal or last known place of business of the partnership in Singapore` FALSE EQUALS JUST TRUE
#ASSERT `the document may be served this way` TRUE `a body corporate` `by delivering it to the secretary or other like officer of the body corporate` FALSE EQUALS JUST TRUE
#ASSERT `the document may be served this way` TRUE `a body corporate` `by leaving it at the registered office or a principal office of the body corporate in Singapore` FALSE EQUALS JUST TRUE
#ASSERT `the document may be served this way` TRUE `a body corporate` `by sending it by prepaid post to the registered office or a principal office of the body corporate in Singapore` FALSE EQUALS JUST TRUE
-- a method that belongs to another kind of recipient, or no listed method: s 48A(1) does not say
#ASSERT `the document may be served this way` TRUE `an individual` `by delivering it to the secretary or other like officer of the partnership` FALSE EQUALS NOTHING
#ASSERT `the document may be served this way` TRUE `a body corporate` `by delivering it to the individual personally` FALSE EQUALS NOTHING
#ASSERT `the document may be served this way` TRUE `an individual` `in some other way` FALSE EQUALS NOTHING
#ASSERT `the document may be served this way` TRUE `an individual` `by delivering it to the individual personally` TRUE EQUALS NOTHING
#ASSERT `the document may be served this way` FALSE `an individual` `by delivering it to the individual personally` FALSE EQUALS NOTHING
#ASSERT NOT (`section 48A(1) affects that other way of serving` TRUE)

