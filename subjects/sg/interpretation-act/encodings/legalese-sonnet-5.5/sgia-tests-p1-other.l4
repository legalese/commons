IMPORT prelude
IMPORT daydate
IMPORT `sgia-interpretation-time`
IMPORT `sgia-p1-definitions`
IMPORT `sgia-p1-other`

-- Tests for sgia-p1-other.l4. Expected values are written from the text of s 2(1) chapeau, 2(2), 2(2A), 2(3), 2A.

§ `s 2(1) chapeau: to what the definitions apply`

#ASSERT `the definitions in section 2(1) apply to a written law enacted on` (Date 1 1 1900)
#ASSERT `the definitions in section 2(1) apply to a written law enacted on` (Date 28 12 1965)
#ASSERT `the definitions in section 2(1) apply to a written law enacted on` (Date 5 12 2025)
-- "without affecting anything done before that date": 27 December 1965 is before, 28 December 1965 is not
#ASSERT NOT (`the definitions in section 2(1) affect a thing done on` (Date 27 12 1965))
#ASSERT `the definitions in section 2(1) affect a thing done on` (Date 28 12 1965)
#ASSERT `the definitions in section 2(1) affect a thing done on` (Date 29 12 1965)
#ASSERT NOT (`the definitions in section 2(1) affect a thing done on` (Date 1 1 1900))

§ `s 2(1): the masculine, the singular and the plural`

#ASSERT `section 2(1) extends a word importing the masculine gender to` Female EQUALS JUST TRUE
#ASSERT `section 2(1) extends a word importing the masculine gender to` Male EQUALS NOTHING
-- the Act says nothing about words importing the feminine gender
#ASSERT `section 2(1) extends a word importing the feminine gender to` Male EQUALS NOTHING
#ASSERT `section 2(1) extends a word importing the feminine gender to` Female EQUALS NOTHING
#ASSERT `section 2(1) extends a word in one number to what is meant in the other` Singular Plural EQUALS JUST TRUE
#ASSERT `section 2(1) extends a word in one number to what is meant in the other` Plural Singular EQUALS JUST TRUE
#ASSERT `section 2(1) extends a word in one number to what is meant in the other` Singular Singular EQUALS NOTHING
#ASSERT `section 2(1) extends a word in one number to what is meant in the other` Plural Plural EQUALS NOTHING
-- the table of s 2(1) records the same two rules
#ASSERT `the kind of definition of` "words in the singular" EQUALS JUST `Rule of reading`
#ASSERT `the kind of definition of` "words importing the masculine gender" EQUALS JUST `Rule of reading`
-- the unit entries in the table say what the time module says
#ASSERT `what the Act names in defining` "month" EQUALS LIST "calendar month"
#ASSERT `what the Act says the unit means` Months EQUALS JUST "calendar month"
#ASSERT `what the Act names in defining` "year" EQUALS LIST "a year reckoned according to the Gregorian calendar"
#ASSERT `what the Act says the unit means` Years EQUALS JUST "a year reckoned according to the Gregorian calendar"

§ `s 2(2) and s 2(2A)`

#ASSERT `a variant of a defined word has a corresponding meaning in that law` `another part of speech` TRUE FALSE EQUALS JUST TRUE
#ASSERT `a variant of a defined word has a corresponding meaning in that law` `another grammatical form` TRUE FALSE EQUALS JUST TRUE
#ASSERT `a variant of a defined word has a corresponding meaning in that law` `a cognate expression` TRUE FALSE EQUALS JUST TRUE
#ASSERT `a variant of a defined word has a corresponding meaning in that law` `a cognate expression` TRUE TRUE EQUALS NOTHING
#ASSERT `a variant of a defined word has a corresponding meaning in that law` `another grammatical form` FALSE FALSE EQUALS NOTHING
#ASSERT `the definition a written law provides applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the definition a written law provides applies` TRUE TRUE EQUALS JUST FALSE
#ASSERT `the definition a written law provides applies` FALSE FALSE EQUALS NOTHING
#ASSERT `the definition a written law provides applies` FALSE TRUE EQUALS NOTHING

§ `s 2(3): references in a written law enacted before 28 December 1965`

#ASSERT count `the twelve rows of section 2(3)` EQUALS 12
-- (a) every old expression listed
#ASSERT `a reference in an old written law is to be construed as` "the Colony of the Straits Settlements" (Date 1 1 1950) FALSE EQUALS JUST "Singapore"
#ASSERT `a reference in an old written law is to be construed as` "the Settlement of Singapore" (Date 1 1 1950) FALSE EQUALS JUST "Singapore"
#ASSERT `a reference in an old written law is to be construed as` "the Colony of Singapore" (Date 1 1 1950) FALSE EQUALS JUST "Singapore"
#ASSERT `a reference in an old written law is to be construed as` "the Colony" (Date 1 1 1950) FALSE EQUALS JUST "Singapore"
#ASSERT `a reference in an old written law is to be construed as` "the State of Singapore" (Date 1 1 1950) FALSE EQUALS JUST "Singapore"
#ASSERT `a reference in an old written law is to be construed as` "the State" (Date 1 1 1950) FALSE EQUALS JUST "Singapore"
-- (a) has no qualification: the context does not displace it
#ASSERT `a reference in an old written law is to be construed as` "the State" (Date 1 1 1950) TRUE EQUALS JUST "Singapore"
-- (b) "unless the context otherwise requires"
#ASSERT `a reference in an old written law is to be construed as` "the Federated Malay States" (Date 1 1 1950) FALSE EQUALS JUST "the States of Malaya"
#ASSERT `a reference in an old written law is to be construed as` "the Federated Malay States" (Date 1 1 1950) TRUE EQUALS NOTHING
#ASSERT `a reference in an old written law is to be construed as` "the Governor of the Malayan Union" (Date 1 1 1950) FALSE EQUALS JUST "the Yang di-Pertuan Agong"
#ASSERT `a reference in an old written law is to be construed as` "the Malayan Union" (Date 1 1 1950) FALSE EQUALS JUST "Malaysia or the territories comprised therein"
#ASSERT `a reference in an old written law is to be construed as` "the Chief Justice" (Date 1 1 1950) FALSE EQUALS JUST "the Chief Justice or the corresponding court, judge or magistrate of Malaysia or the territories comprised therein"
#ASSERT `a reference in an old written law is to be construed as` "any court of the Malayan Union" (Date 1 1 1950) FALSE EQUALS JUST "the Chief Justice or the corresponding court, judge or magistrate of Malaysia or the territories comprised therein"
#ASSERT `a reference in an old written law is to be construed as` "any magistrate of any of the Malay States" (Date 1 1 1950) FALSE EQUALS JUST "the Chief Justice or the corresponding court, judge or magistrate of Malaysia or the territories comprised therein"
#ASSERT `a reference in an old written law is to be construed as` "an officer of the Malayan Union" (Date 1 1 1950) FALSE EQUALS JUST "the corresponding officer of, or authority or body constituted in or for, Malaysia or the territories comprised therein"
#ASSERT `a reference in an old written law is to be construed as` "an authority or body constituted in or for any Malay State" (Date 1 1 1950) FALSE EQUALS JUST "the corresponding officer of, or authority or body constituted in or for, Malaysia or the territories comprised therein"
#ASSERT `a reference in an old written law is to be construed as` "the Assembly" (Date 1 1 1950) FALSE EQUALS JUST "the Parliament"
#ASSERT `a reference in an old written law is to be construed as` "the Legislative Assembly" (Date 1 1 1950) FALSE EQUALS JUST "the Parliament"
#ASSERT `a reference in an old written law is to be construed as` "the Yang di-Pertuan Negara" (Date 1 1 1950) FALSE EQUALS JUST "the President"
#ASSERT `a reference in an old written law is to be construed as` "the Federal Minister" (Date 1 1 1950) FALSE EQUALS JUST "the appropriate Minister of Singapore"
#ASSERT `a reference in an old written law is to be construed as` "the State Advocate-General" (Date 1 1 1950) FALSE EQUALS JUST "the Attorney-General"
#ASSERT `a reference in an old written law is to be construed as` "the High Court in Singapore" (Date 1 1 1950) FALSE EQUALS JUST "the High Court of Singapore"
-- s 2(3)(l), "respectively": the Judge is construed as a Judge of the Supreme Court and the Registrar as the Registrar of the Supreme Court; each has its own replacement
#ASSERT `a reference in an old written law is to be construed as` "a Judge of the High Court" (Date 1 1 1950) FALSE EQUALS JUST "a Judge of the Supreme Court"
#ASSERT `a reference in an old written law is to be construed as` "the Registrar of the High Court" (Date 1 1 1950) FALSE EQUALS JUST "the Registrar of the Supreme Court"
-- the pairing does not mix: the Registrar is not construed as a Judge, and the Judge is not construed as the Registrar
#ASSERT NOT (`a reference in an old written law is to be construed as` "the Registrar of the High Court" (Date 1 1 1950) FALSE EQUALS JUST "a Judge of the Supreme Court")
#ASSERT NOT (`a reference in an old written law is to be construed as` "a Judge of the High Court" (Date 1 1 1950) FALSE EQUALS JUST "the Registrar of the Supreme Court")
-- the words as the Act prints them, whole, for either old expression, and for rows that have no pairing
#ASSERT `the words section 2(3) prints for` "a Judge of the High Court" EQUALS JUST "a Judge of the Supreme Court and the Registrar of the Supreme Court, respectively"
#ASSERT `the words section 2(3) prints for` "the Registrar of the High Court" EQUALS JUST "a Judge of the Supreme Court and the Registrar of the Supreme Court, respectively"
#ASSERT `the words section 2(3) prints for` "the Colony" EQUALS JUST "Singapore"
#ASSERT `the words section 2(3) prints for` "the Assembly" EQUALS JUST "the Parliament"
#ASSERT `the words section 2(3) prints for` "the Straits Dollar" EQUALS NOTHING
-- a word s 2(3) does not list
#ASSERT `a reference in an old written law is to be construed as` "the Straits Dollar" (Date 1 1 1950) FALSE EQUALS NOTHING
-- the day: 27 December 1965 is "before 28 December 1965"; 28 December 1965 is not
#ASSERT `a reference in an old written law is to be construed as` "the Assembly" (Date 27 12 1965) FALSE EQUALS JUST "the Parliament"
#ASSERT `a reference in an old written law is to be construed as` "the Assembly" (Date 28 12 1965) FALSE EQUALS NOTHING
#ASSERT `a reference in an old written law is to be construed as` "the Assembly" (Date 1 1 2020) FALSE EQUALS NOTHING

§ `s 2A: criteria for determining death`

#ASSERT `a person has died` TRUE FALSE
#ASSERT `a person has died` FALSE TRUE
#ASSERT `a person has died` TRUE TRUE
#ASSERT NOT (`a person has died` FALSE FALSE)

-- (2): circulatory ground, no organ removal: the ordinary standards, no certificate required by the Act
#ASSERT (`what the determination of death requires` `irreversible cessation of circulation of blood and respiration` FALSE)'s `ordinary standards of current medical practice`
#ASSERT NOT ((`what the determination of death requires` `irreversible cessation of circulation of blood and respiration` FALSE)'s `the prescribed criteria`)
#ASSERT (`what the determination of death requires` `irreversible cessation of circulation of blood and respiration` FALSE)'s `medical practitioners who must certify` EQUALS 0
-- (3), (4): brain ground, no organ removal: the prescribed criteria, 2 practitioners, one not involved, qualified
#ASSERT (`what the determination of death requires` `total and irreversible cessation of all functions of the brain` FALSE)'s `the prescribed criteria`
#ASSERT NOT ((`what the determination of death requires` `total and irreversible cessation of all functions of the brain` FALSE)'s `ordinary standards of current medical practice`)
#ASSERT (`what the determination of death requires` `total and irreversible cessation of all functions of the brain` FALSE)'s `medical practitioners who must certify` EQUALS 2
#ASSERT (`what the determination of death requires` `total and irreversible cessation of all functions of the brain` FALSE)'s `at least one not involved in the care or treatment`
#ASSERT (`what the determination of death requires` `total and irreversible cessation of all functions of the brain` FALSE)'s `the prescribed postgraduate medical qualifications`
#ASSERT NOT ((`what the determination of death requires` `total and irreversible cessation of all functions of the brain` FALSE)'s `none involved in the care or treatment`)
-- (5): circulatory ground, organ removal: 2 practitioners, none involved (a) to (d), no qualification required by (5)
#ASSERT (`what the determination of death requires` `irreversible cessation of circulation of blood and respiration` TRUE)'s `medical practitioners who must certify` EQUALS 2
#ASSERT (`what the determination of death requires` `irreversible cessation of circulation of blood and respiration` TRUE)'s `none involved in the care or treatment`
#ASSERT (`what the determination of death requires` `irreversible cessation of circulation of blood and respiration` TRUE)'s `none in the team that will remove the organ`
#ASSERT (`what the determination of death requires` `irreversible cessation of circulation of blood and respiration` TRUE)'s `none involved in selecting the recipient`
#ASSERT (`what the determination of death requires` `irreversible cessation of circulation of blood and respiration` TRUE)'s `none to be involved in the recipient's care in hospital`
#ASSERT NOT ((`what the determination of death requires` `irreversible cessation of circulation of blood and respiration` TRUE)'s `the prescribed postgraduate medical qualifications`)
-- (6): brain ground, organ removal: (a) to (d) as in (5), and (e) the qualifications
#ASSERT (`what the determination of death requires` `total and irreversible cessation of all functions of the brain` TRUE)'s `none involved in selecting the recipient`
#ASSERT (`what the determination of death requires` `total and irreversible cessation of all functions of the brain` TRUE)'s `the prescribed postgraduate medical qualifications`
#ASSERT (`what the determination of death requires` `total and irreversible cessation of all functions of the brain` TRUE)'s `the prescribed criteria`

-- (4): two practitioners; one fewer fails; more than two is not excluded by the text ("2 medical practitioners")
#ASSERT `the certificate meets section 2A(4)` 2 TRUE TRUE TRUE
#ASSERT NOT (`the certificate meets section 2A(4)` 1 TRUE TRUE TRUE)
#ASSERT `the certificate meets section 2A(4)` 3 TRUE TRUE TRUE
#ASSERT NOT (`the certificate meets section 2A(4)` 2 FALSE TRUE TRUE)
#ASSERT NOT (`the certificate meets section 2A(4)` 2 TRUE FALSE TRUE)
#ASSERT NOT (`the certificate meets section 2A(4)` 2 TRUE TRUE FALSE)
-- (5)
#ASSERT `the certificate meets section 2A(5)` 2 TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`the certificate meets section 2A(5)` 1 TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the certificate meets section 2A(5)` 2 FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the certificate meets section 2A(5)` 2 TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the certificate meets section 2A(5)` 2 TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the certificate meets section 2A(5)` 2 TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the certificate meets section 2A(5)` 2 TRUE TRUE TRUE TRUE FALSE)
-- (6)
#ASSERT `the certificate meets section 2A(6)` 2 TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`the certificate meets section 2A(6)` 1 TRUE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the certificate meets section 2A(6)` 2 FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the certificate meets section 2A(6)` 2 TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`the certificate meets section 2A(6)` 2 TRUE TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`the certificate meets section 2A(6)` 2 TRUE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`the certificate meets section 2A(6)` 2 TRUE TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`the certificate meets section 2A(6)` 2 TRUE TRUE TRUE TRUE TRUE FALSE)
-- (8), (9)
#ASSERT NOT (`section 2A affects the operation of a written law on the presumption of death` TRUE)
#ASSERT NOT (`section 2A prevents the certification or determination of death` TRUE)
#ASSERT `is a medical practitioner for section 2A` TRUE FALSE
#ASSERT `is a medical practitioner for section 2A` FALSE TRUE
#ASSERT NOT (`is a medical practitioner for section 2A` FALSE FALSE)

-- the deleted subsections: the text shows these words and nothing else (../../registers/source-bundle/IA1965.txt lines 655 and 665)
#ASSERT `s 2(4) is deleted` EQUALS "(4) [Deleted by Act 5 of 2014]"
#ASSERT `s 2(6) is deleted` EQUALS "(6) [Deleted by Act 5 of 2025 wef 09/03/2025]"
