IMPORT prelude
IMPORT daydate
IMPORT `sgia-interpretation-time`

-- Tests for sgia-interpretation-time.l4. Every expected value is written here from the text of the Act
-- and from a calendar (weekdays checked with the operating system's calendar, not with this code):
--   Sundays:   2025-12-28  2026-01-04  2026-01-11  2026-01-18  2026-02-01  2026-03-01  2028-07-16  2030-09-01
--   Saturdays: 2026-01-03  2026-01-10  2026-01-31  2026-02-28  2025-03-01
--   Weekdays:  2026-01-01 Thu, 01-02 Fri, 01-05 Mon, 01-06 Tue, 01-07 Wed, 01-08 Thu, 01-09 Fri, 01-12 Mon,
--              2026-02-02 Mon, 2026-03-02 Mon, 2025-07-16 Wed, 2030-01-15 Tue, 2025-09-01 Mon, 2025-12-31 Wed,
--              2024-01-31 Wed, 2024-02-29 Thu, 2025-02-28 Fri, 2028-07-17 Mon, 2030-09-02 Mon, 2030-09-03 Tue
-- "Saturday" and "a day on which an office is closed" are NOT excluded days: s 50(b) names exactly two kinds.

GIVETH A LIST OF DATE
`no public holidays` MEANS EMPTY

§ `Sundays and excluded days (s 50(b))`

#ASSERT `is a Sunday` (Date 4 1 2026)
#ASSERT `is a Sunday` (Date 28 12 2025)
#ASSERT `is a Sunday` (Date 16 7 2028)
#ASSERT `is a Sunday` (Date 1 9 2030)
#ASSERT NOT (`is a Sunday` (Date 3 1 2026))
#ASSERT NOT (`is a Sunday` (Date 5 1 2026))
#ASSERT NOT (`is a Sunday` (Date 31 1 2026))
#ASSERT NOT (`is a Sunday` (Date 16 7 2025))
#ASSERT NOT (`is a Sunday` (Date 15 1 2030))
#ASSERT NOT (`is a Sunday` (Date 1 9 2025))

-- a Sunday is excluded; a public holiday on a weekday is excluded; a Saturday (or an office-closure day) is not
#ASSERT `is an excluded day` (Date 4 1 2026) `no public holidays`
#ASSERT `is an excluded day` (Date 6 1 2026) (LIST Date 6 1 2026)
#ASSERT NOT (`is an excluded day` (Date 6 1 2026) `no public holidays`)
#ASSERT NOT (`is an excluded day` (Date 3 1 2026) `no public holidays`)
#ASSERT NOT (`is an excluded day` (Date 5 1 2026) (LIST Date 6 1 2026))

#ASSERT `the next day after that is not an excluded day` (Date 3 1 2026) `no public holidays` EQUALS Date 5 1 2026
#ASSERT `the next day after that is not an excluded day` (Date 2 1 2026) `no public holidays` EQUALS Date 3 1 2026
#ASSERT `the next day after that is not an excluded day` (Date 4 1 2026) (LIST Date 5 1 2026) EQUALS Date 6 1 2026
#ASSERT `the next day after that is not an excluded day` (Date 3 1 2026) (LIST Date 5 1 2026, Date 6 1 2026) EQUALS Date 7 1 2026

§ `A period of days from an event (s 50(a), (b), (d))`

-- (a): the day of the event is not counted
#ASSERT `the first day of a period of days from the event` (Date 1 1 2026) EQUALS Date 2 1 2026

-- thirty days from 2026-01-01: 2026-01-31, a Saturday, which s 50 does not exclude
#ASSERT `the last day of a period of days from the event` (Date 1 1 2026) 30 `no public holidays` FALSE EQUALS JUST (Date 31 1 2026)
#ASSERT `the last day of a period of days from the event` (Date 1 1 2026) 30 `no public holidays` FALSE EQUALS JUST (Date 31 1 2026)
-- the same with 2026-01-31 a public holiday: Sunday 2026-02-01 is excluded too, so Monday 2026-02-02
#ASSERT `the last day of a period of days from the event` (Date 1 1 2026) 30 (LIST Date 31 1 2026) FALSE EQUALS JUST (Date 2 2 2026)
-- fourteen days from 2026-01-01 is 2026-01-15, a Thursday
#ASSERT `the last day of a period of days from the event` (Date 1 1 2026) 14 `no public holidays` FALSE EQUALS JUST (Date 15 1 2026)
-- fourteen days from Sunday 2026-01-04 is Sunday 2026-01-18; the period includes Monday 2026-01-19
#ASSERT `the last day of a period of days from the event` (Date 4 1 2026) 14 `no public holidays` FALSE EQUALS JUST (Date 19 1 2026)
-- seven days from Saturday 2026-01-03 is Saturday 2026-01-10
#ASSERT `the last day of a period of days from the event` (Date 3 1 2026) 7 `no public holidays` FALSE EQUALS JUST (Date 10 1 2026)
-- seven days from Sunday 2026-01-04 is Sunday 2026-01-11, so Monday 2026-01-12
#ASSERT `the last day of a period of days from the event` (Date 4 1 2026) 7 `no public holidays` FALSE EQUALS JUST (Date 12 1 2026)
-- a period of no days, or of a negative number of days, is not a period the Act counts
#ASSERT `the last day of a period of days from the event` (Date 1 1 2026) 0 `no public holidays` FALSE EQUALS NOTHING
#ASSERT `the last day of a period of days from the event` (Date 1 1 2026) (0 MINUS 3) `no public holidays` FALSE EQUALS NOTHING

-- (d): in a period not exceeding 6 days, Sundays and public holidays are not reckoned
#ASSERT `excluded days are not reckoned` 1
#ASSERT `excluded days are not reckoned` 6
#ASSERT NOT (`excluded days are not reckoned` 7)
#ASSERT NOT (`excluded days are not reckoned` 0)
-- one day from Friday 2026-01-02 is Saturday 2026-01-03; one day from Saturday 2026-01-03 skips Sunday: Monday 2026-01-05
#ASSERT `the last day of a period of days from the event` (Date 2 1 2026) 1 `no public holidays` FALSE EQUALS JUST (Date 3 1 2026)
#ASSERT `the last day of a period of days from the event` (Date 3 1 2026) 1 `no public holidays` FALSE EQUALS JUST (Date 5 1 2026)
-- five days from Friday 2026-01-02: Sat 3, (Sun 4 not reckoned) Mon 5, Tue 6, Wed 7, Thu 8
#ASSERT `the last day of a period of days from the event` (Date 2 1 2026) 5 `no public holidays` FALSE EQUALS JUST (Date 8 1 2026)
-- the same with Tuesday 2026-01-06 a public holiday: Sat 3, Mon 5, Wed 7, Thu 8, Fri 9
#ASSERT `the last day of a period of days from the event` (Date 2 1 2026) 5 (LIST Date 6 1 2026) FALSE EQUALS JUST (Date 9 1 2026)
-- six days from Wednesday 2026-01-07, Thursday 2026-01-08 a public holiday: Fri 9, Sat 10, Mon 12, Tue 13, Wed 14, Thu 15
#ASSERT `the last day of a period of days from the event` (Date 7 1 2026) 6 (LIST Date 8 1 2026) FALSE EQUALS JUST (Date 15 1 2026)
-- seven days from the same Wednesday: (d) no longer applies, so Wednesday 2026-01-14, which is not excluded
#ASSERT `the last day of a period of days from the event` (Date 7 1 2026) 7 (LIST Date 8 1 2026) FALSE EQUALS JUST (Date 14 1 2026)

-- "unless the contrary intention appears": when one appears the Act's default no longer decides
#ASSERT `the last day of a period of days from the event` (Date 1 1 2026) 30 `no public holidays` TRUE EQUALS NOTHING
#ASSERT `the last day of a period` (Date 1 1 2026) 30 Days From `no public holidays` TRUE EQUALS NOTHING

§ `Periods the Act does not count (s 50(a) names only "from" and only days; s 2(1) defines month and year and nothing more)`

-- "after" an event: s 50(a) says "from"
#ASSERT `the last day of a period` (Date 1 1 2026) 30 Days After `no public holidays` FALSE EQUALS NOTHING
#ASSERT `the last day of a period` (Date 1 1 2026) 30 Days From `no public holidays` FALSE EQUALS JUST (Date 31 1 2026)
#ASSERT `the last day of a period` (Date 1 1 2026) 2 Weeks From `no public holidays` FALSE EQUALS NOTHING
-- the worked cases of the brief
#ASSERT `the last day of a period` (Date 16 7 2025) 3 Years From `no public holidays` FALSE EQUALS NOTHING
#ASSERT `the last day of a period` (Date 15 1 2025) 5 Years From `no public holidays` FALSE EQUALS NOTHING
#ASSERT `the last day of a period` (Date 1 9 2025) 5 Years From `no public holidays` FALSE EQUALS NOTHING
#ASSERT `the last day of a period` (Date 31 12 2025) 2 Months From `no public holidays` FALSE EQUALS NOTHING
#ASSERT `the last day of a period` (Date 31 1 2024) 1 Months From `no public holidays` FALSE EQUALS NOTHING
#ASSERT `the last day of a period` (Date 29 2 2024) 1 Years From `no public holidays` FALSE EQUALS NOTHING

-- s 50(b) applied to a last day the person has worked out for a month or year period.
-- Reading "every period" (the chosen reading, fork F4): the rule reaches months and years.
-- three years from 2025-07-16, if the person takes the last day as 2028-07-16 (a Sunday): Monday 2028-07-17
#ASSERT `the last day of the period once section 50(b) is applied` (Date 16 7 2028) Years `no public holidays` FALSE EQUALS JUST (Date 17 7 2028)
-- five years from 2025-01-15, last day 2030-01-15 (a Tuesday): unchanged
#ASSERT `the last day of the period once section 50(b) is applied` (Date 15 1 2030) Years `no public holidays` FALSE EQUALS JUST (Date 15 1 2030)
-- five years from 2025-09-01, last day 2030-09-01 (a Sunday): Monday 2030-09-02; if that is a holiday, Tuesday 2030-09-03
#ASSERT `the last day of the period once section 50(b) is applied` (Date 1 9 2030) Years `no public holidays` FALSE EQUALS JUST (Date 2 9 2030)
#ASSERT `the last day of the period once section 50(b) is applied` (Date 1 9 2030) Years (LIST Date 2 9 2030) FALSE EQUALS JUST (Date 3 9 2030)
-- two months from 2025-12-31: if the person takes 2026-02-28 (Saturday) it stays; if 2026-03-01 (Sunday), Monday 2026-03-02
#ASSERT `the last day of the period once section 50(b) is applied` (Date 28 2 2026) Months `no public holidays` FALSE EQUALS JUST (Date 28 2 2026)
#ASSERT `the last day of the period once section 50(b) is applied` (Date 1 3 2026) Months `no public holidays` FALSE EQUALS JUST (Date 2 3 2026)
-- one month from 2024-01-31: 2024-02-29 (Thursday) stays; one year from 2024-02-29: 2025-02-28 (Friday) and 2025-03-01 (Saturday) stay
#ASSERT `the last day of the period once section 50(b) is applied` (Date 29 2 2024) Months `no public holidays` FALSE EQUALS JUST (Date 29 2 2024)
#ASSERT `the last day of the period once section 50(b) is applied` (Date 28 2 2025) Years `no public holidays` FALSE EQUALS JUST (Date 28 2 2025)
#ASSERT `the last day of the period once section 50(b) is applied` (Date 1 3 2025) Years `no public holidays` FALSE EQUALS JUST (Date 1 3 2025)
-- Reading "periods of days only" (the other reading of fork F4): months and years are left where they fall
#ASSERT `the last day of the period once section 50(b) is applied, if it reaches periods of days only` (Date 16 7 2028) Years `no public holidays` FALSE EQUALS JUST (Date 16 7 2028)
#ASSERT `the last day of the period once section 50(b) is applied, if it reaches periods of days only` (Date 1 9 2030) Years `no public holidays` FALSE EQUALS JUST (Date 1 9 2030)
#ASSERT `the last day of the period once section 50(b) is applied, if it reaches periods of days only` (Date 1 3 2026) Months `no public holidays` FALSE EQUALS JUST (Date 1 3 2026)
#ASSERT `the last day of the period once section 50(b) is applied, if it reaches periods of days only` (Date 4 1 2026) Days `no public holidays` FALSE EQUALS JUST (Date 5 1 2026)

§ `An act directed for a day (s 50(c))`

-- directed for Sunday 2026-01-04: done on Monday 2026-01-05 is in due time
#ASSERT `section 50(c) treats the act as done in due time` (Date 4 1 2026) (Date 5 1 2026) `no public holidays` FALSE EQUALS JUST TRUE
-- done on Tuesday 2026-01-06: s 50(c) says nothing
#ASSERT `section 50(c) treats the act as done in due time` (Date 4 1 2026) (Date 6 1 2026) `no public holidays` FALSE EQUALS NOTHING
-- done on the Sunday itself: s 50(c) says nothing
#ASSERT `section 50(c) treats the act as done in due time` (Date 4 1 2026) (Date 4 1 2026) `no public holidays` FALSE EQUALS NOTHING
-- directed for a Monday that is not excluded: s 50(c) does not apply
#ASSERT `section 50(c) treats the act as done in due time` (Date 5 1 2026) (Date 5 1 2026) `no public holidays` FALSE EQUALS NOTHING
-- Sunday directed, Monday a public holiday: Tuesday 2026-01-06 is the next day not excluded; Monday itself is not
#ASSERT `section 50(c) treats the act as done in due time` (Date 4 1 2026) (Date 6 1 2026) (LIST Date 5 1 2026) FALSE EQUALS JUST TRUE
#ASSERT `section 50(c) treats the act as done in due time` (Date 4 1 2026) (Date 5 1 2026) (LIST Date 5 1 2026) FALSE EQUALS NOTHING
#ASSERT `the last day for an act directed for a day` (Date 3 1 2026) `no public holidays` FALSE EQUALS JUST (Date 3 1 2026)
#ASSERT `the last day for an act directed for a day` (Date 4 1 2026) `no public holidays` FALSE EQUALS JUST (Date 5 1 2026)
#ASSERT `the last day for an act directed for a day` (Date 4 1 2026) (LIST Date 5 1 2026) FALSE EQUALS JUST (Date 6 1 2026)

#ASSERT `section 50(c) treats the act as done in due time` (Date 4 1 2026) (Date 5 1 2026) `no public holidays` TRUE EQUALS NOTHING
#ASSERT `the last day for an act directed for a day` (Date 4 1 2026) `no public holidays` TRUE EQUALS NOTHING
#ASSERT `the last day of the period once section 50(b) is applied` (Date 16 7 2028) Years `no public holidays` TRUE EQUALS NOTHING
#ASSERT `the last day of the period once section 50(b) is applied, if it reaches periods of days only` (Date 16 7 2028) Years `no public holidays` TRUE EQUALS NOTHING

§ `Standard time (s 51)`

#ASSERT `standard time, in hours ahead of UTC` NOTHING EQUALS 8
#ASSERT `standard time, in hours ahead of UTC` (JUST 7) EQUALS 7
#ASSERT `a time of day is held to be standard time` FALSE
#ASSERT NOT (`a time of day is held to be standard time` TRUE)
-- midnight at the start of 2026-03-01 in Singapore is 16:00 on 2026-02-28 UTC
#ASSERT `the moment on the UTC clock` (Moment OF (Date 1 3 2026), 0, 8) EQUALS Moment OF (Date 28 2 2026), 57600, 0
-- 09:00 in Singapore is 01:00 UTC the same day; 08:00 is 00:00 UTC the same day
#ASSERT `the moment on the UTC clock` (Moment OF (Date 1 3 2026), 32400, 8) EQUALS Moment OF (Date 1 3 2026), 3600, 0
#ASSERT `the moment on the UTC clock` (Moment OF (Date 1 3 2026), 28800, 8) EQUALS Moment OF (Date 1 3 2026), 0, 0

§ `When a written law comes into operation (s 10)`

-- "on the expiration of the previous day" is the same instant as the first moment of the day itself
#ASSERT `the moment on the UTC clock` (`the expiration of the day before` (Date 1 3 2026) 8) EQUALS `the moment on the UTC clock` (`the first moment of the day` (Date 1 3 2026) 8)
#ASSERT `the moment on the UTC clock` (`the expiration of the day before` (Date 1 3 2026) 8) EQUALS Moment OF (Date 28 2 2026), 57600, 0
#ASSERT `the moment a written law comes into operation` `specified by the written law or by a notification made under it` (Date 1 3 2026) 8 EQUALS JUST (Moment OF (Date 1 3 2026), 0, 8)
#ASSERT `the moment a written law comes into operation` `the date of publication in the Gazette` (Date 1 3 2026) 8 EQUALS JUST (Moment OF (Date 1 3 2026), 0, 8)
-- the Act names no default when neither limb applies
#ASSERT `the moment a written law comes into operation` `fixed by neither` (Date 1 3 2026) 8 EQUALS NOTHING

-- s 10(2): different days for different provisions
GIVETH A LIST OF `Provision and its day`
`two notified provisions` MEANS
    LIST (`Provision and its day` OF "Part 2", (Date 1 4 2026)), (`Provision and its day` OF "Part 3", (Date 1 7 2026))

#ASSERT `the day a notification brings a provision into operation` `two notified provisions` "Part 3" EQUALS JUST (Date 1 7 2026)
#ASSERT `the day a notification brings a provision into operation` `two notified provisions` "Part 2" EQUALS JUST (Date 1 4 2026)
#ASSERT `the day a notification brings a provision into operation` `two notified provisions` "Part 9" EQUALS NOTHING

§ `No time prescribed; extending a time (ss 52, 53)`

#ASSERT `the time for doing a thing` FALSE EQUALS JUST `with all convenient speed and as often as the prescribed occasion arises`
#ASSERT `the time for doing a thing` TRUE EQUALS NOTHING
#ASSERT `the power to extend may be exercised after the time has run out` TRUE FALSE EQUALS JUST TRUE
#ASSERT `the power to extend may be exercised after the time has run out` TRUE TRUE EQUALS NOTHING
#ASSERT `the power to extend may be exercised after the time has run out` FALSE FALSE EQUALS NOTHING

§ `A document posted (s 2(5))`

#ASSERT `service by post is deemed effected` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT (`service by post is deemed effected` TRUE FALSE FALSE TRUE TRUE)
#ASSERT NOT (`service by post is deemed effected` TRUE FALSE TRUE FALSE TRUE)
#ASSERT NOT (`service by post is deemed effected` TRUE FALSE TRUE TRUE FALSE)
#ASSERT NOT (`service by post is deemed effected` TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`service by post is deemed effected` FALSE FALSE TRUE TRUE TRUE)
-- deemed at the time the letter would be delivered in the ordinary course of post, unless the contrary is proved
#ASSERT `the moment service by post is deemed effected` TRUE (Moment OF (Date 8 1 2026), 36000, 8) FALSE EQUALS JUST (Moment OF (Date 8 1 2026), 36000, 8)
#ASSERT `the moment service by post is deemed effected` TRUE (Moment OF (Date 8 1 2026), 36000, 8) TRUE EQUALS NOTHING
#ASSERT `the moment service by post is deemed effected` FALSE (Moment OF (Date 8 1 2026), 36000, 8) FALSE EQUALS NOTHING

§ `Units of time (s 2(1))`

#ASSERT `what the Act says the unit means` Months EQUALS JUST "calendar month"
#ASSERT `what the Act says the unit means` Years EQUALS JUST "a year reckoned according to the Gregorian calendar"
-- "day" and "week" are not defined by the Act
#ASSERT `what the Act says the unit means` Days EQUALS NOTHING
#ASSERT `what the Act says the unit means` Weeks EQUALS NOTHING

-- the two helpers under the public rules, asserted on their own
-- counting only days that are not Sundays or public holidays, from Monday 5 January 2026 (6 Jan Tue, 7 Wed, 8 Thu, 9 Fri, 10 Sat, 11 Sun skipped, 12 Mon)
#ASSERT `the nth day that is not an excluded day after` (Date 5 1 2026) 0 `no public holidays` EQUALS Date 5 1 2026
#ASSERT `the nth day that is not an excluded day after` (Date 5 1 2026) 6 `no public holidays` EQUALS Date 12 1 2026
#ASSERT `the nth day that is not an excluded day after` (Date 5 1 2026) 6 (LIST Date 6 1 2026) EQUALS Date 13 1 2026
-- s 50(b) on a last day already counted: Sunday 4 January 2026 moves to Monday 5 January in a period of days, and in a period of years under the reading that reaches every period
#ASSERT `the last day of the period after section 50(b)` (Date 4 1 2026) Days `every period` `no public holidays` EQUALS Date 5 1 2026
#ASSERT `the last day of the period after section 50(b)` (Date 4 1 2026) Years `every period` `no public holidays` EQUALS Date 5 1 2026
#ASSERT `the last day of the period after section 50(b)` (Date 4 1 2026) Years `periods of days only` `no public holidays` EQUALS Date 4 1 2026
#ASSERT `the last day of the period after section 50(b)` (Date 4 1 2026) Days `periods of days only` `no public holidays` EQUALS Date 5 1 2026
#ASSERT `the last day of the period after section 50(b)` (Date 3 1 2026) Days `every period` `no public holidays` EQUALS Date 3 1 2026

-- A longer period can end before a shorter one: with Wednesday 7 January 2026 a public holiday, 6 days from Monday
-- 5 January skip Sunday 11 January and Wednesday 7 January and end on Tuesday 13 January (s 50(d)), while 7 days
-- from the same Monday are counted straight through (s 50(a)) and end on Monday 12 January (not an excluded day).
#ASSERT `the last day of a period of days from the event` (Date 5 1 2026) 6 (LIST Date 7 1 2026) FALSE EQUALS JUST (Date 13 1 2026)
#ASSERT `the last day of a period of days from the event` (Date 5 1 2026) 7 (LIST Date 7 1 2026) FALSE EQUALS JUST (Date 12 1 2026)

-- LIBRARY BEHAVIOUR, NOT THE ACT: the daydate library's `add months` and `add years` clamp to the last day of a shorter month.
-- The Interpretation Act says nothing about this, so no rule of the encoding uses these functions (NOTES.md finding 4).
#ASSERT `add months` (Date 31 1 2024) 1 EQUALS Date 29 2 2024
#ASSERT `add months` (Date 31 12 2025) 2 EQUALS Date 28 2 2026
#ASSERT `add years` (Date 29 2 2024) 1 EQUALS Date 28 2 2025
