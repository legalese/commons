§ `ss 3(1), (2)`

#ASSERT `the conduct is hijacking` `a passenger seizes a civil airliner in flight by threats`
#ASSERT `the conduct is hijacking` `a foreigner abroad takes control of a foreign airliner by hacking`
#ASSERT NOT `the conduct is hijacking` `a stowaway takes the controls by stealth alone`
#ASSERT NOT `the conduct is hijacking` `a foreigner abroad seizes a foreign military aircraft by force`
#ASSERT `the conduct is hijacking` `a Singapore citizen abroad seizes a foreign military aircraft by force`
#ASSERT `the conduct is hijacking` `a foreigner seizes a foreign military aircraft over Singapore by force`
#ASSERT `the conduct is hijacking` `a foreigner abroad seizes a Singapore police aircraft by force`

§ `s 4`

#ASSERT `the violence is deemed committed in Singapore` TRUE TRUE TRUE
#ASSERT NOT `the violence is deemed committed in Singapore` TRUE TRUE FALSE

§ `s 5`

#ASSERT `the conduct is an offence under section 5(1)` `a mechanic sabotages an aircraft during pre-flight preparation`
#ASSERT NOT `the conduct is an offence under section 5(1)` `a passenger's violence endangers the aircraft before the doors close`
#ASSERT `the conduct is an offence under section 5(1)` `a passenger's violence endangers the aircraft in flight`

#ASSERT `the conduct is an offence under section 5(2)` `a person hides an explosive device in the hold before departure`

§ `s 6(3), (4)`

#ASSERT `the conduct is an offence under section 6(3)` `a caller knowingly gives a pilot in flight false runway information`
#ASSERT NOT `the conduct is an offence under section 6(3)` `a caller who reasonably believed the false runway information true`
#ASSERT NOT `the conduct is an offence under section 6(3)` `a controller relaying false information in good faith on duty`

§ `s 7`

#ASSERT `the conduct is an offence under section 7(1)` `a knife attack on travellers at an international airport`
#ASSERT NOT `the conduct is an offence under section 7(1)` `a bare-handed assault on a traveller at an international airport`

#ASSERT `the conduct is an offence under section 7(2)` `a drone flown to disrupt an international airport, endangering its operation`
#ASSERT NOT `the conduct is an offence under section 7(2)` `a drone flown to disrupt an international airport, endangering nobody`

§ `s 8(1)`

#ASSERT `the conduct is an offence under section 8(1)` `a passenger credibly threatens to hijack the flight`
#ASSERT NOT `the conduct is an offence under section 8(1)` `a passenger makes a hijacking remark nobody could take seriously`
#ASSERT NOT `the conduct is an offence under section 8(1)` `a person credibly threatens to give a flight crew false information`
#ASSERT NOT `the conduct is an offence under section 8(1)` `a person credibly threatens to carry a BCN weapon on board`
#ASSERT `the conduct is an offence under section 8(1)` `a person credibly threatens to bomb an international airport`

§ `s 9`

#ASSERT `the offender is liable to imprisonment for life` `hijacking (s 3)` `an individual`
#ASSERT NOT `the offender is liable to imprisonment for life` `a credible threat (s 8(1))` `an individual`
#ASSERT NOT `the offender is liable to imprisonment for life` `hijacking (s 3)` `a company or other non-individual`

#ASSERT `the maximum fine` `hijacking (s 3)` `a company or other non-individual` EQUALS 1000000
#ASSERT `the maximum fine` `hijacking (s 3)` `an individual` EQUALS 0
#ASSERT `the maximum fine` `a credible threat (s 8(1))` `an individual` EQUALS 500000
#ASSERT `the maximum fine` `assisting an offender to evade justice (s 8(2))` `a company or other non-individual` EQUALS 1000000

#ASSERT `the maximum term of years` `a credible threat (s 8(1))` `an individual` EQUALS 10
#ASSERT `the maximum term of years` `assisting an offender to evade justice (s 8(2))` `an individual` EQUALS 7

§ `s 9A(2), (5)`

#ASSERT `the person is guilty of the corporation's offence` `a director, partner, secretary or similar officer` FALSE FALSE TRUE FALSE
#ASSERT `the person is guilty of the corporation's offence` `a manager in a position to influence the offending conduct` TRUE FALSE FALSE FALSE
#ASSERT NOT `the person is guilty of the corporation's offence` `a member of staff with no such position` TRUE TRUE FALSE TRUE
#ASSERT NOT `the person is guilty of the corporation's offence` `a director, partner, secretary or similar officer` FALSE FALSE FALSE TRUE

§ `s 10`

#ASSERT `the step may be taken before the Public Prosecutor consents` `arrest`
#ASSERT `the step may be taken before the Public Prosecutor consents` `charging`
#ASSERT NOT `the step may be taken before the Public Prosecutor consents` `trial`

§ `s 11`

#ASSERT `it is an extradition offence and not political` `hijacking (s 3)` FALSE
#ASSERT NOT `it is an extradition offence and not political` `hijacking (s 3)` TRUE

