IMPORT prelude
IMPORT `hac-offences`

-- Hijacking of Aircraft and Protection of Aircraft and International Airports Act 1978, ss 2(2), 3, 4, 5, 6(3), 7, 8(1), 9, 9A, 10 and 11 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_hijacking-of-aircraft-and-protection-of-aircraft-and-international-airports-act-1978.py). Expected results were written by
-- hand from the text.

§ `Fixtures -- flights`

`boarding, doors still open` MEANS Flight WITH
    `pre-flight preparation has begun` IS TRUE
    `external doors closed after embarkation` IS FALSE
    `a door opened for disembarkation` IS FALSE
    `made a forced landing` IS FALSE
    `the authorities have taken over` IS FALSE
    `landed having completed the flight` IS FALSE
    `hours since landing` IS 0

`doors closed, taxiing out` MEANS Flight WITH
    `pre-flight preparation has begun` IS TRUE
    `external doors closed after embarkation` IS TRUE
    `a door opened for disembarkation` IS FALSE
    `made a forced landing` IS FALSE
    `the authorities have taken over` IS FALSE
    `landed having completed the flight` IS FALSE
    `hours since landing` IS 0

`landed, door opened, 3 hours later` MEANS Flight WITH
    `pre-flight preparation has begun` IS TRUE
    `external doors closed after embarkation` IS TRUE
    `a door opened for disembarkation` IS TRUE
    `made a forced landing` IS FALSE
    `the authorities have taken over` IS FALSE
    `landed having completed the flight` IS TRUE
    `hours since landing` IS 3

`landed, door opened, 24 hours later` MEANS Flight WITH
    `pre-flight preparation has begun` IS TRUE
    `external doors closed after embarkation` IS TRUE
    `a door opened for disembarkation` IS TRUE
    `made a forced landing` IS FALSE
    `the authorities have taken over` IS FALSE
    `landed having completed the flight` IS TRUE
    `hours since landing` IS 24

`landed, door opened, 30 hours later` MEANS Flight WITH
    `pre-flight preparation has begun` IS TRUE
    `external doors closed after embarkation` IS TRUE
    `a door opened for disembarkation` IS TRUE
    `made a forced landing` IS FALSE
    `the authorities have taken over` IS FALSE
    `landed having completed the flight` IS TRUE
    `hours since landing` IS 30

`forced landing, doors opened, authorities not yet in charge` MEANS Flight WITH
    `pre-flight preparation has begun` IS TRUE
    `external doors closed after embarkation` IS TRUE
    `a door opened for disembarkation` IS TRUE
    `made a forced landing` IS TRUE
    `the authorities have taken over` IS FALSE
    `landed having completed the flight` IS FALSE
    `hours since landing` IS 0

`forced landing, authorities have taken over` MEANS Flight WITH
    `pre-flight preparation has begun` IS TRUE
    `external doors closed after embarkation` IS TRUE
    `a door opened for disembarkation` IS TRUE
    `made a forced landing` IS TRUE
    `the authorities have taken over` IS TRUE
    `landed having completed the flight` IS FALSE
    `hours since landing` IS 0

`parked overnight, no flight being prepared` MEANS Flight WITH
    `pre-flight preparation has begun` IS FALSE
    `external doors closed after embarkation` IS FALSE
    `a door opened for disembarkation` IS FALSE
    `made a forced landing` IS FALSE
    `the authorities have taken over` IS FALSE
    `landed having completed the flight` IS FALSE
    `hours since landing` IS 0

§ `s 2(2)`

#ASSERT NOT `the aircraft is in flight` `boarding, doors still open`
#ASSERT `the aircraft is in flight` `doors closed, taxiing out`
#ASSERT NOT `the aircraft is in flight` `landed, door opened, 3 hours later`
#ASSERT `the aircraft is in flight` `forced landing, doors opened, authorities not yet in charge`
#ASSERT NOT `the aircraft is in flight` `forced landing, authorities have taken over`

#ASSERT `the aircraft is in service` `boarding, doors still open`
#ASSERT `the aircraft is in service` `landed, door opened, 3 hours later`
#ASSERT `the aircraft is in service` `landed, door opened, 24 hours later`
#ASSERT NOT `the aircraft is in service` `landed, door opened, 30 hours later`
#ASSERT NOT `the aircraft is in service` `parked overnight, no flight being prepared`

§ `Fixtures -- conduct`

`a passenger seizes a civil airliner in flight by threats` MEANS Conduct WITH
    `aircraft use` IS `civil`
    `in or over Singapore` IS FALSE
    `by a Singapore citizen` IS FALSE
    `unlawful` IS TRUE
    `intentional` IS TRUE
    `aircraft in service` IS TRUE
    `aircraft in flight` IS TRUE
    `seizes or exercises control of the aircraft` IS TRUE
    `means of control` IS `threats`
    `destroys the aircraft or damages it so as to disable or endanger it` IS FALSE
    `commits on board an act of violence likely to endanger the aircraft` IS FALSE
    `places a device or substance likely to destroy or endanger the aircraft` IS FALSE
    `communicates false or misleading information` IS FALSE
    `the information endangers or is likely to endanger an aircraft in flight` IS FALSE
    `believed it true on reasonable grounds` IS FALSE
    `communicated it in good faith in lawful employment duties` IS FALSE
    `at an aerodrome serving international civil aviation` IS FALSE
    `by means of a device, substance or weapon` IS FALSE
    `an act of violence likely to cause death or serious personal injury` IS FALSE
    `endangers or is likely to endanger the aerodrome or persons there` IS FALSE
    `destroys or seriously damages aerodrome facilities` IS FALSE
    `disrupts the aerodrome's services` IS FALSE
    `threatens to commit` IS `no offence`
    `the threat is credible` IS FALSE

