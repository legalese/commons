    `is appointed Senior Missionary by the Foreign Missions Committee` IS TRUE
    `the minute extract is certified by the Convenor` IS TRUE
    `the extract is filed in the office of the Minister` IS TRUE
    `the filing is notified in the Gazette` IS TRUE

`a successor filed but not yet gazetted` MEANS Claimant WITH
    `is the Reverend John Angus Bethune Cook` IS FALSE
    `is appointed Senior Missionary by the Foreign Missions Committee` IS TRUE
    `the minute extract is certified by the Convenor` IS TRUE
    `the extract is filed in the office of the Minister` IS TRUE
    `the filing is notified in the Gazette` IS FALSE

`a successor whose certified extract was never filed` MEANS Claimant WITH
    `is the Reverend John Angus Bethune Cook` IS FALSE
    `is appointed Senior Missionary by the Foreign Missions Committee` IS TRUE
    `the minute extract is certified by the Convenor` IS TRUE
    `the extract is filed in the office of the Minister` IS FALSE
    `the filing is notified in the Gazette` IS FALSE

`a successor gazetted on an uncertified extract` MEANS Claimant WITH
    `is the Reverend John Angus Bethune Cook` IS FALSE
    `is appointed Senior Missionary by the Foreign Missions Committee` IS TRUE
    `the minute extract is certified by the Convenor` IS FALSE
    `the extract is filed in the office of the Minister` IS TRUE
    `the filing is notified in the Gazette` IS TRUE

`a lease sealed before and signed by Mr Cook` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the Reverend John Angus Bethune Cook`
    `signed by` IS `the Reverend John Angus Bethune Cook`

`a conveyance sealed before a qualified successor and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a duly qualified successor`
    `signed by` IS `an attorney under a deposited power of attorney`

`a mortgage sealed before a church elder and signed by a qualified successor` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a church elder with no power of attorney`
    `signed by` IS `a duly qualified successor`

`a transfer sealed before and signed by an undeposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney whose power of attorney is not deposited`
    `signed by` IS `an attorney whose power of attorney is not deposited`

`a lease sealed before and signed by a successor not yet gazetted` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a successor appointed but not yet gazetted`
    `signed by` IS `a successor appointed but not yet gazetted`

`an unsealed deed signed by Mr Cook` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS FALSE
    `sealed in the presence of` IS `nobody`
    `signed by` IS `the Reverend John Angus Bethune Cook`

§ `ss 2(1) and 4 -- the Corporation and qualification`

#ASSERT `holds the office that is the Corporation` `Mr Cook himself`
#ASSERT `holds the office that is the Corporation` `a successor appointed, certified, filed and gazetted`
#ASSERT NOT `holds the office that is the Corporation` `a successor filed but not yet gazetted`
#ASSERT NOT `holds the office that is the Corporation` `a successor whose certified extract was never filed`
#ASSERT NOT `holds the office that is the Corporation` `a successor gazetted on an uncertified extract`

#ASSERT NOT `the Gazette notification is sufficient evidence of qualification` `Mr Cook himself`
#ASSERT `the Gazette notification is sufficient evidence of qualification` `a successor appointed, certified, filed and gazetted`
#ASSERT NOT `the Gazette notification is sufficient evidence of qualification` `a successor filed but not yet gazetted`
#ASSERT NOT `the Gazette notification is sufficient evidence of qualification` `a successor whose certified extract was never filed`
#ASSERT `the Gazette notification is sufficient evidence of qualification` `a successor gazetted on an uncertified extract`

§ `s 2(3) -- powers`

#ASSERT `the Ordinance empowers the Corporation to` `use and change its corporate seal` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `acquire or purchase property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `sell property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell property` FALSE
