-- The heaviest sentence: $5,000 and 6 months, or $10,000 and 12 months
#ASSERT `What is the heaviest sentence for the offence` `Dismissing an employee on the ground of age before the prescribed minimum retirement age (section 4(3))` EQUALS (Penalty OF 5_000, 6)
#ASSERT `What is the heaviest sentence for the offence` `Failing to comply with a direction of the Minister (sections 8(7) and 8B(13))` EQUALS (Penalty OF 10_000, 12)
#ASSERT `What is the heaviest sentence for the offence` `Hindering an investigating officer, or making a false statement to one (section 9(2))` EQUALS (Penalty OF 5_000, 6)
#ASSERT `What is the heaviest sentence for the offence` `Obstructing an employee in appearing before the Commissioner (section 9B(1))` EQUALS (Penalty OF 5_000, 6)
#ASSERT `What is the heaviest sentence for the offence` `Another breach or offence with no penalty otherwise provided, a first offence (section 9C)` EQUALS (Penalty OF 5_000, 6)
#ASSERT `What is the heaviest sentence for the offence` `Another breach or offence with no penalty otherwise provided, a subsequent offence under the same section (section 9C)` EQUALS (Penalty OF 10_000, 12)
-- s 10(1): the lower of half the maximum fine and $1,000 is $1,000 for every offence in the Act
#ASSERT `Can an investigating officer offer to settle my offence` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `Can an investigating officer offer to settle my offence` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `What is the most I can be asked to pay to settle` `Dismissing an employee on the ground of age before the prescribed minimum retirement age (section 4(3))` EQUALS 1_000
#ASSERT `What is the most I can be asked to pay to settle` `Failing to comply with a direction of the Minister (sections 8(7) and 8B(13))` EQUALS 1_000
#ASSERT `What is the most I can be asked to pay to settle` `Another breach or offence with no penalty otherwise provided, a subsequent offence under the same section (section 9C)` EQUALS 1_000
#ASSERT `Can I still be prosecuted after I pay` TRUE EQUALS JUST FALSE
#ASSERT `Can I still be prosecuted after I pay` FALSE EQUALS NOTHING

