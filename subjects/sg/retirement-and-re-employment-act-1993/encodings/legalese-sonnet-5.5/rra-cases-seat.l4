#ASSERT `Can I sue my employer for damages` `The denial of re-employment, or my dismissal without just cause or excuse, under section 8B` TRUE EQUALS JUST FALSE
#ASSERT `Can I sue my employer for damages` `My dismissal on the ground of age, under section 8` FALSE EQUALS NOTHING
