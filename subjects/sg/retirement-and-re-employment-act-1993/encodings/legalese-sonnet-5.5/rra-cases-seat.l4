§ `Cases -- if I believe I was dismissed, or denied re-employment, unlawfully (ss 8 to 8C)`

-- s 8(1): one month from the dismissal
#ASSERT `By what date may I make representations to be reinstated` (Date 15 12 2022) EQUALS Date 15 1 2023
#ASSERT `May I make representations to be reinstated` (Date 1 1 1960) 63 0 (Date 15 12 2022) TRUE (Date 15 1 2023) EQUALS JUST TRUE
#ASSERT `May I make representations to be reinstated` (Date 1 1 1960) 63 0 (Date 15 12 2022) TRUE (Date 16 1 2023) EQUALS NOTHING
-- Dismissed on the specified-age day itself: not "below the specified age", so the section does not answer.
#ASSERT `May I make representations to be reinstated` (Date 1 1 1960) 63 0 (Date 1 1 2023) TRUE (Date 1 2 2023) EQUALS NOTHING
-- s 8(3) and 8B(6): comply with the direction
#ASSERT `Has my employer complied with the direction` `My dismissal on the ground of age, under section 8` TRUE TRUE EQUALS JUST TRUE
#ASSERT `Has my employer complied with the direction` `My dismissal on the ground of age, under section 8` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Has my employer complied with the direction` `The denial of re-employment, or my dismissal without just cause or excuse, under section 8B` TRUE FALSE EQUALS JUST FALSE
#ASSERT `Has my employer complied with the direction` `My dismissal on the ground of age, under section 8` FALSE FALSE EQUALS NOTHING
-- s 8(4) and 8B(10)
