IMPORT prelude
IMPORT daydate
IMPORT `rra-nouns`
IMPORT `rra-logic`
IMPORT `rra-part1-preliminary`
IMPORT `rra-part5-general`

-- Retirement and Re-employment Act 1993 -- TESTS for Part 5 (ss 9 to 13).
-- Every expected value is written from the text of the provision named beside it, before the assertion was run.

§ `Tests -- section 9, powers and the offence`

-- (1): each power, for the purposes of this Act, by the Commissioner or an investigating officer
#ASSERT `s 9(1) the person has the power` TRUE TRUE `enter a place of employment without previous notice to conduct an audit or make an inquiry` TRUE EQUALS JUST TRUE
#ASSERT `s 9(1) the person has the power` TRUE TRUE `enter a place of employment without previous notice to conduct an audit or make an inquiry` FALSE EQUALS NOTHING
#ASSERT `s 9(1) the person has the power` TRUE TRUE `examine a person orally` FALSE EQUALS JUST TRUE
#ASSERT `s 9(1) the person has the power` TRUE TRUE `require the employer to produce an employee together with a contract of service or other document` FALSE EQUALS JUST TRUE
#ASSERT `s 9(1) the person has the power` TRUE TRUE `make copies of a document required to be produced` FALSE EQUALS JUST TRUE
#ASSERT `s 9(1) the person has the power` TRUE TRUE `take or remove a document for the purposes of investigations` FALSE EQUALS JUST TRUE
#ASSERT `s 9(1) the person has the power` TRUE TRUE `take photographs or audio or video recordings of the premises and of persons` FALSE EQUALS JUST TRUE
#ASSERT `s 9(1) the person has the power` TRUE TRUE `require a person to produce an article and take it into custody` FALSE EQUALS JUST TRUE
#ASSERT `s 9(1) the person has the power` TRUE TRUE `another power` FALSE EQUALS NOTHING
#ASSERT `s 9(1) the person has the power` FALSE TRUE `examine a person orally` FALSE EQUALS NOTHING
#ASSERT `s 9(1) the person has the power` TRUE FALSE `examine a person orally` FALSE EQUALS NOTHING
#ASSERT `s 9(1)(b) the person examined is bound to state truly the facts and circumstances` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9(1)(b) the person examined is bound to state truly the facts and circumstances` TRUE FALSE EQUALS NOTHING
#ASSERT `s 9(1)(b) the person examined is bound to state truly the facts and circumstances` FALSE TRUE EQUALS NOTHING
#ASSERT `s 9(1)(c) the Commissioner or investigating officer may require the employer to produce the employee and the documents` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9(1)(c) the Commissioner or investigating officer may require the employer to produce the employee and the documents` TRUE FALSE EQUALS NOTHING
#ASSERT `s 9(1)(g) the Commissioner or investigating officer may require a person to produce the article` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9(1)(g) the Commissioner or investigating officer may require a person to produce the article` TRUE FALSE EQUALS NOTHING
-- (2): the offence, and a fine not exceeding $5,000 or imprisonment not exceeding 6 months or both
#ASSERT `s 9(2) the person is guilty of an offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 9(2) the person is guilty of an offence` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 9(2) the person is guilty of an offence` FALSE FALSE EQUALS NOTHING
#ASSERT `s 9(2) the penalty on conviction` EQUALS (Penalty OF 5_000, 6)
#ASSERT `s 9(2) the sentence is within the penalty` TRUE 5_000 6 EQUALS JUST TRUE
#ASSERT `s 9(2) the sentence is within the penalty` TRUE 5_001 6 EQUALS JUST FALSE
#ASSERT `s 9(2) the sentence is within the penalty` FALSE 0 0 EQUALS NOTHING

§ `Tests -- section 9A and 9B, summons and obstruction`

-- 9A(1): any one of the three grounds
#ASSERT `s 9A(1) the person acting may summon the person` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 9A(1) the person acting may summon the person` TRUE FALSE TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 9A(1) the person acting may summon the person` TRUE FALSE FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 9A(1) the person acting may summon the person` TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 9A(1) the person acting may summon the person` TRUE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 9A(1) the person acting may summon the person` FALSE TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 9A(1) the person summoned is legally bound to attend and to answer truthfully` TRUE EQUALS JUST TRUE
#ASSERT `s 9A(1) the person summoned is legally bound to attend and to answer truthfully` FALSE EQUALS NOTHING
-- The summons names a time 7 days from the day it is served (day 0).
-- TRACE-EXPECT: FULFILLED  (attended on day 7)
#TRACE `s 9A(1) the person summoned must attend at the time and place specified in the summons` 7 AT 0 WITH
    PARTY `A person summoned` DOES `attend as the summons requires` AT 7
-- TRACE-EXPECT: BREACH  (attended on day 8, after the time specified)
#TRACE `s 9A(1) the person summoned must attend at the time and place specified in the summons` 7 AT 0 WITH
    PARTY `A person summoned` DOES `attend as the summons requires` AT 8
-- 9A(2) and (3)
#ASSERT `s 9A(2) the person is guilty of an offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 9A(2) the person is guilty of an offence` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 9A(2) the person is guilty of an offence` FALSE FALSE EQUALS NOTHING
#ASSERT `s 9A(3) the Commissioner or investigating officer may report the failure to a Magistrate, who may issue a warrant to secure the attendance` TRUE EQUALS JUST TRUE
#ASSERT `s 9A(3) the Commissioner or investigating officer may report the failure to a Magistrate, who may issue a warrant to secure the attendance` FALSE EQUALS NOTHING
-- 9B(1): the offence and the ceilings
#ASSERT `s 9B(1) the person is guilty of an offence` TRUE EQUALS JUST TRUE
#ASSERT `s 9B(1) the person is guilty of an offence` FALSE EQUALS NOTHING
#ASSERT `s 9B(1) the penalty on conviction` EQUALS (Penalty OF 5_000, 6)
#ASSERT `s 9B(1) the sentence is within the penalty` TRUE 5_000 6 EQUALS JUST TRUE
#ASSERT `s 9B(1) the sentence is within the penalty` TRUE 5_000 7 EQUALS JUST FALSE
#ASSERT `s 9B(1) the sentence is within the penalty` FALSE 0 0 EQUALS NOTHING
-- 9B(2): only where no penalty is expressly provided
#ASSERT `s 9B(2) the person is guilty of an offence` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 9B(2) the person is guilty of an offence` TRUE TRUE EQUALS NOTHING
#ASSERT `s 9B(2) the person is guilty of an offence` FALSE FALSE EQUALS NOTHING

§ `Tests -- section 9C, the penalty where none is otherwise provided`

#ASSERT `s 9C the penalty on conviction` FALSE EQUALS (Penalty OF 5_000, 6)
#ASSERT `s 9C the penalty on conviction` TRUE EQUALS (Penalty OF 10_000, 12)
-- A first offence: $5,000 and 6 months.
#ASSERT `s 9C the sentence is within the penalty` TRUE FALSE FALSE TRUE 5_000 6 EQUALS JUST TRUE
#ASSERT `s 9C the sentence is within the penalty` TRUE FALSE FALSE TRUE 5_001 6 EQUALS JUST FALSE
#ASSERT `s 9C the sentence is within the penalty` TRUE FALSE FALSE TRUE 5_000 7 EQUALS JUST FALSE
-- A subsequent offence under the same section: $10,000 and 12 months.
#ASSERT `s 9C the sentence is within the penalty` TRUE FALSE TRUE TRUE 10_000 12 EQUALS JUST TRUE
#ASSERT `s 9C the sentence is within the penalty` TRUE FALSE TRUE TRUE 10_001 12 EQUALS JUST FALSE
-- A penalty is otherwise provided, no conviction, or no breach: not this section.
#ASSERT `s 9C the sentence is within the penalty` TRUE TRUE FALSE TRUE 5_000 6 EQUALS NOTHING
#ASSERT `s 9C the sentence is within the penalty` TRUE FALSE FALSE FALSE 5_000 6 EQUALS NOTHING
#ASSERT `s 9C the sentence is within the penalty` FALSE FALSE FALSE TRUE 5_000 6 EQUALS NOTHING

§ `Tests -- section 10, composition of offences`

#ASSERT `s 10(1) the investigating officer may compound the offence` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 10(1) the investigating officer may compound the offence` FALSE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 10(1) the investigating officer may compound the offence` TRUE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 10(1) the investigating officer may compound the offence` TRUE TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 10(1) the investigating officer may compound the offence` TRUE TRUE TRUE FALSE EQUALS NOTHING
-- The lower of half the maximum fine and $1,000.  Every maximum fine in the Act is $5,000 or $10,000: the sum is $1,000 each time.
#ASSERT `s 10(1) the largest sum that may be collected` 5_000 EQUALS 1_000
#ASSERT `s 10(1) the largest sum that may be collected` 10_000 EQUALS 1_000
-- Only a maximum fine below $2,000 would make half the lower of the two; the Act has none.
#ASSERT `s 10(1) the largest sum that may be collected` 1_500 EQUALS 750
#ASSERT `s 10(1) the largest sum that may be collected` 2_000 EQUALS 1_000
#ASSERT `s 10(2) further proceedings may be taken against the person in respect of the offence` TRUE EQUALS JUST FALSE
#ASSERT `s 10(2) further proceedings may be taken against the person in respect of the offence` FALSE EQUALS NOTHING

§ `Tests -- sections 11, 11A, 11B and 13`

#ASSERT `s 11(1) the person is exempt from the provision` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 11(1) the person is exempt from the provision` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 11(1) the person is exempt from the provision` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 11(1) the person is exempt from the provision` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 11(2) the Minister may revoke the exemption, vary or revoke its conditions, or impose new conditions` TRUE EQUALS JUST TRUE
#ASSERT `s 11(2) the Minister may revoke the exemption, vary or revoke its conditions, or impose new conditions` FALSE EQUALS NOTHING
#ASSERT `s 11A the term is void insofar as it so purports` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 11A the term is void insofar as it so purports` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 11A the term is void insofar as it so purports` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 11A the term is void insofar as it so purports` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 11B regard may be had to the guidelines for the purpose` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 11B regard may be had to the guidelines for the purpose` TRUE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 11B regard may be had to the guidelines for the purpose` FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 11B regard may be had to the guidelines for the purpose` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 13 this Act relieves the employer of the duty or liability` TRUE EQUALS JUST FALSE
#ASSERT `s 13 this Act relieves the employer of the duty or liability` FALSE EQUALS NOTHING
