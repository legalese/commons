§ `s 2(1) -- specified age`

#ASSERT `What is my specified age` `a 60-year-old with no retirement age in her contract` EQUALS 63
#ASSERT `What is my specified age` `a 63-year-old whose contract says 65` EQUALS 65

§ `s 2(2) -- dismissal`

#ASSERT `Am I treated as dismissed` FALSE TRUE

§ `ss 4(1), 7A(11) -- the ranges`

#ASSERT `Are the prescribed ages I have stated within the ranges the Act allows` `a 60-year-old with no retirement age in her contract`
#ASSERT NOT `Are the prescribed ages I have stated within the ranges the Act allows` `an employee who states a minimum retirement age of 60`

§ `ss 4(2), 6, 11A`

#ASSERT `Is my employer forbidden to dismiss me on the ground of age` `a 62-year-old whose contract says 60`
#ASSERT NOT `Is my employer forbidden to dismiss me on the ground of age` `a 63-year-old whose contract says 65`

#ASSERT `Is the retirement age in my contract void` `a 62-year-old whose contract says 60`
#ASSERT NOT `Is the retirement age in my contract void` `a 60-year-old with no retirement age in her contract`

#ASSERT `Is this term of my contract void for contracting out` FALSE TRUE

§ `s 7 -- eligibility`

#ASSERT NOT `Am I eligible for re-employment` `an employee born in June 1952`
#ASSERT `Am I eligible for re-employment` `an employee born in July 1952`
#ASSERT NOT `Am I eligible for re-employment` `an employee assessed as not performing satisfactorily`
#ASSERT NOT `Am I eligible for re-employment` `an employee her employer has proved medically unfit`

#ASSERT `Must my employer give me written notice that it will not re-employ me` TRUE TRUE
#ASSERT NOT `Must my employer give me written notice that it will not re-employ me` TRUE FALSE

§ `ss 7A(1), 7A(9), 7C(1)-(3) -- what I am owed`

#ASSERT `What must my employer offer me` `an eligible employee who has just turned 63` EQUALS `an offer of re-employment, made before I reach my specified age`
#ASSERT `What must my employer offer me` `an employee assessed as not performing satisfactorily` EQUALS `nothing, because I am not eligible for re-employment`
#ASSERT `What must my employer offer me` `an employee for whom no suitable vacancy is found` EQUALS `an employment assistance payment, in place of re-employment`
#ASSERT `What must my employer offer me` `an employee who took another employer's offer when no vacancy was found` EQUALS `re-employment by the other employer, from the agreed date`
#ASSERT `What must my employer offer me` `an employee who took another employer's offer though a vacancy existed` EQUALS `an offer of re-employment, made before I reach my specified age`
#ASSERT `What must my employer offer me` `an employee who has turned 68` EQUALS `nothing more, because I have reached my prescribed re-employment age`
#ASSERT `What must my employer offer me` `an employee who said she will not continue, with no vacancy found` EQUALS `nothing, because I have said I will not continue`

#ASSERT `Before what age must my employer offer me re-employment` `a 63-year-old whose contract says 65` EQUALS JUST 65
#ASSERT `Before what age must my employer offer me re-employment` `an employee assessed as not performing satisfactorily` EQUALS NOTHING

#ASSERT `Is my employer's obligation to re-employ me running now` `an eligible employee who has just turned 63`
#ASSERT NOT `Is my employer's obligation to re-employ me running now` `a 63-year-old whose contract says 65`

§ `s 7C(4)`

#ASSERT NOT `Was my employment assistance payment paid as the Act requires` FALSE FALSE

§ `s 7A(6), (7)`

#ASSERT `What is the shortest re-employment term I can be offered, in months` 60 EQUALS 12
#ASSERT `What is the shortest re-employment term I can be offered, in months` 7 EQUALS 7

#ASSERT NOT `Is the re-employment term I was offered long enough` 6 60 FALSE
#ASSERT `Is the re-employment term I was offered long enough` 7 7 FALSE

§ `s 7A(2)`

#ASSERT `Are my rights under my old contract unaffected` `an eligible employee who has just turned 63` TRUE FALSE
#ASSERT NOT `Are my rights under my old contract unaffected` `a 63-year-old whose contract says 65` TRUE FALSE

§ `s 7B`

#ASSERT `Does my service before re-employment count` `the period of service for paid sick leave under the Employment Act` FALSE
#ASSERT NOT `Does my service before re-employment count` `any other right under my re-employment contract` FALSE

