§ `ss 6 and 8 -- do I need an electricity licence`

#ASSERT `Do I need an electricity licence for what I do` `produce electricity to supply premises, my own included` FALSE FALSE EQUALS `I need an electricity licence: without one this is an offence under section 6(2)`
#ASSERT `Do I need an electricity licence for what I do` `produce electricity to supply premises, my own included` FALSE TRUE EQUALS `I am covered: an exemption order under section 8 covers me`
#ASSERT `Do I need an electricity licence for what I do` `use electricity supplied to my premises` FALSE FALSE EQUALS `no licence is needed: section 6(1) does not list what I do`
#ASSERT `Do I need an electricity licence for what I do` `transmit electricity for a transmission licensee as its employee` FALSE FALSE EQUALS `no licence is needed: section 6(1) does not list what I do`

#ASSERT `What is the most I can be fined for an unlicensed activity` 10 EQUALS 625000

§ `ss 2, 67, 71, 83(4) -- the installation licence`

#ASSERT `Is my use of it an offence under section 83(4)` `the fixed wiring, switches and sockets of my premises` FALSE FALSE
#ASSERT NOT `Is my use of it an offence under section 83(4)` `the fixed wiring, switches and sockets of my premises` FALSE TRUE
#ASSERT NOT `Is my use of it an offence under section 83(4)` `an appliance plugged into a socket` FALSE FALSE

§ `s 24 -- disconnection and reconnection`

#ASSERT `May my supply be cut off for my unpaid account` `a household short of income, no offer of advice yet` EQUALS `not yet: section 24(2) protects me until the offer of advice and a period of at least 7 days have run`
#ASSERT `May my supply be cut off for my unpaid account` `a household short of income that let a 7-day offer of advice lapse` EQUALS `yes: section 24(1) allows it, failure to pay being good cause`
#ASSERT `May my supply be cut off for my unpaid account` `a household short of income given only 5 days to accept advice` EQUALS `not yet: section 24(2) protects me until the offer of advice and a period of at least 7 days have run`
#ASSERT `May my supply be cut off for my unpaid account` `a household that could pay and did not` EQUALS `yes: section 24(1) allows it, failure to pay being good cause`
#ASSERT `May my supply be cut off for my unpaid account` `a contestable consumer owing the transmission licensee` EQUALS `yes: section 24(4) allows the transmission licensee to disconnect me and recover its expenses`

#ASSERT `Must my supply be reconnected within a reasonable time` TRUE TRUE TRUE
#ASSERT NOT `Must my supply be reconnected within a reasonable time` TRUE TRUE FALSE

§ `s 26 -- supply during a dispute`

#ASSERT `Must I be supplied until my dispute is determined` TRUE FALSE FALSE FALSE

§ `s 31 -- the licensee's works on my land`

#ASSERT `May the licensee enter my land to do the works in its notice` TRUE 0 FALSE FALSE FALSE EQUALS `yes: an emergency from a fault, so no notice is needed`
#ASSERT `May the licensee enter my land to do the works in its notice` FALSE 20 TRUE FALSE FALSE EQUALS `only if the Authority authorises the works after an inquiry into my objection`
#ASSERT `May the licensee enter my land to do the works in its notice` FALSE 20 FALSE FALSE FALSE EQUALS `yes: I lodged no objection within 14 days, so I must facilitate the works`

§ `s 32 -- my trees`

#ASSERT `Am I owed compensation for my felled tree` TRUE FALSE 30 FALSE
#ASSERT NOT `Am I owed compensation for my felled tree` TRUE FALSE 15 FALSE

§ `ss 33 to 36 and 77 -- entry to my premises`

#ASSERT `Can this person insist on entering my premises` `a meter reader with an authority document at a reasonable time`
#ASSERT NOT `Can this person insist on entering my premises` `a meter reader with no document`
#ASSERT NOT `Can this person insist on entering my premises` `a disconnection crew at my occupied flat after 2 hours' notice`
#ASSERT NOT `Can this person insist on entering my premises` `a survey team after 3 days' notice`
#ASSERT `Can this person insist on entering my premises` `a repair crew in a fault emergency without notice`

§ `s 38 -- the licensee's equipment`

#ASSERT `Does section 38 keep the equipment from being taken for my debts or in my bankruptcy` TRUE

§ `s 41 -- buying as a contestable consumer`

#ASSERT `How am I buying electricity as a contestable consumer` `nothing yet` 31 0 EQUALS `deemed: indirectly from the wholesale market through the market support services licensee at prevailing market prices`
#ASSERT `How am I buying electricity as a contestable consumer` `nothing yet` 40 15 EQUALS `still mine to choose: the 30-day period has not run`

§ `s 23(3) -- the security duty, traced`

#TRACE `my duty to give security after a section 23(3) notice` AT 0 WITH
    PARTY Me DOES `give reasonable security for the money that may become due for my supply` AT 5
