§ `s 1`

#ASSERT `the kind of document` `an order bill of lading` EQUALS `a bill of lading`
#ASSERT `the kind of document` `a bearer bill of lading` EQUALS `a bill of lading`
#ASSERT `the kind of document` `a received for shipment bill` EQUALS `a bill of lading`
#ASSERT `the kind of document` `a straight bill naming the consignee` EQUALS `a sea waybill`
#ASSERT `the kind of document` `a non-transferable bill naming no one` EQUALS `a document outside the Act`
#ASSERT `the kind of document` `a waybill naming the consignee` EQUALS `a sea waybill`
#ASSERT `the kind of document` `a carrier's delivery order` EQUALS `a ship's delivery order`
#ASSERT `the kind of document` `a merchant's delivery order` EQUALS `a document outside the Act`

#ASSERT `the Act applies to the document` `a straight bill naming the consignee`
#ASSERT NOT `the Act applies to the document` `a merchant's delivery order`

§ `s 5(2)`

#ASSERT `is the holder of the bill` `an indorsee in good faith who never asks for the goods`
#ASSERT `is the holder of the bill` `the named consignee holding the bill`
#ASSERT `is the holder of the bill` `an indorsee in bad faith`
#ASSERT NOT `is the holder of the bill` `a consignee without the bill`
#ASSERT `is the holder of the bill` `a buyer of a spent bill`

#ASSERT `is the lawful holder of the bill` `an indorsee in good faith who never asks for the goods`
#ASSERT `is the lawful holder of the bill` `the named consignee holding the bill`
#ASSERT NOT `is the lawful holder of the bill` `an indorsee in bad faith`

§ `s 2(1), (2) and 5(4)`

#ASSERT `rights of suit vest in the claimant` `an indorsee in good faith who never asks for the goods`
#ASSERT `rights of suit vest in the claimant` `an indorsee in good faith who demands delivery`
#ASSERT `rights of suit vest in the claimant` `the named consignee holding the bill`
#ASSERT NOT `rights of suit vest in the claimant` `an indorsee in bad faith`
#ASSERT NOT `rights of suit vest in the claimant` `a consignee without the bill`
#ASSERT NOT `rights of suit vest in the claimant` `a buyer of a spent bill`
#ASSERT `rights of suit vest in the claimant` `a buyer of a spent bill under an earlier contract`
#ASSERT `rights of suit vest in the claimant` `a seller who got a spent bill back on rejection`
#ASSERT `rights of suit vest in the claimant` `a holder whose goods sank`
#ASSERT `rights of suit vest in the claimant` `a waybill consignee who sues`
#ASSERT NOT `rights of suit vest in the claimant` `a waybill shipper named as consignee`
#ASSERT `rights of suit vest in the claimant` `a delivery order holder`
#ASSERT NOT `rights of suit vest in the claimant` `a person named in a merchant's order`
#ASSERT `rights of suit vest in the claimant` `an earlier taker of delivery who later gets the bill`

§ `s 3`

#ASSERT NOT `the claimant takes on the liabilities of the contract` `an indorsee in good faith who never asks for the goods`
#ASSERT `the claimant takes on the liabilities of the contract` `an indorsee in good faith who demands delivery`
#ASSERT NOT `the claimant takes on the liabilities of the contract` `an indorsee in bad faith`
#ASSERT `the claimant takes on the liabilities of the contract` `a holder whose goods sank`
#ASSERT `the claimant takes on the liabilities of the contract` `a waybill consignee who sues`
#ASSERT NOT `the claimant takes on the liabilities of the contract` `a person named in a merchant's order`
#ASSERT `the claimant takes on the liabilities of the contract` `an earlier taker of delivery who later gets the bill`

#ASSERT `an original party remains liable under the contract` TRUE

§ `s 2(3), 3(2)`

#ASSERT `the Act confines rights and liabilities to the goods in the document` `a ship's delivery order` TRUE
#ASSERT NOT `the Act confines rights and liabilities to the goods in the document` `a ship's delivery order` FALSE
#ASSERT NOT `the Act confines rights and liabilities to the goods in the document` `a bill of lading` TRUE

§ `s 2(4)`

#ASSERT `the claimant may sue for the other person's loss` `a waybill consignee who sues` TRUE
#ASSERT NOT `the claimant may sue for the other person's loss` `an indorsee in bad faith` TRUE

§ `s 2(5)`

#ASSERT NOT `an original party keeps its rights of suit` `a bill of lading` TRUE
#ASSERT `an original party keeps its rights of suit` `a bill of lading` FALSE
#ASSERT `an original party keeps its rights of suit` `a sea waybill` TRUE
#ASSERT `an original party keeps its rights of suit` `a ship's delivery order` TRUE

#ASSERT NOT `an earlier holder keeps the rights it took under section 2` TRUE

§ `s 4`

#ASSERT `the bill is conclusive evidence of shipment against the carrier` `a bill of lading` TRUE TRUE FALSE TRUE
#ASSERT NOT `the bill is conclusive evidence of shipment against the carrier` `a bill of lading` TRUE FALSE TRUE FALSE
#ASSERT `the bill is conclusive evidence of shipment against the carrier` `a bill of lading` TRUE FALSE TRUE TRUE
#ASSERT NOT `the bill is conclusive evidence of shipment against the carrier` `a bill of lading` TRUE FALSE FALSE TRUE
#ASSERT NOT `the bill is conclusive evidence of shipment against the carrier` `a sea waybill` TRUE TRUE FALSE TRUE

