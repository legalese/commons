IMPORT prelude
IMPORT `meo-corporation`

-- Missions Etrangeres Ordinance 1891, ss 2-4 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_missions-trang-res-ordinance-1891.py). Expected results were written by
-- hand from the text.

`a Procureur whose approved filing has been gazetted` MEANS Claimant WITH
    `holds the office of Procureur at Singapore for the time being` IS TRUE
    `constituting instrument is filed in the Supreme Court Registry under section 48` IS TRUE
    `filing was approved by the Minister under hand and seal` IS TRUE
    `notification of the filing has appeared in the Gazette` IS TRUE

`a Procureur whose approved filing is not yet gazetted` MEANS Claimant WITH
    `holds the office of Procureur at Singapore for the time being` IS TRUE
    `constituting instrument is filed in the Supreme Court Registry under section 48` IS TRUE
    `filing was approved by the Minister under hand and seal` IS TRUE
    `notification of the filing has appeared in the Gazette` IS FALSE

`a Procureur whose filing was gazetted without the Minister's approval` MEANS Claimant WITH
    `holds the office of Procureur at Singapore for the time being` IS TRUE
    `constituting instrument is filed in the Supreme Court Registry under section 48` IS TRUE
    `filing was approved by the Minister under hand and seal` IS FALSE
    `notification of the filing has appeared in the Gazette` IS TRUE

`a newly appointed Procureur who has filed nothing` MEANS Claimant WITH
    `holds the office of Procureur at Singapore for the time being` IS TRUE
    `constituting instrument is filed in the Supreme Court Registry under section 48` IS FALSE
    `filing was approved by the Minister under hand and seal` IS FALSE
    `notification of the filing has appeared in the Gazette` IS FALSE

`a Procureur with the Minister's approval who has not filed` MEANS Claimant WITH
    `holds the office of Procureur at Singapore for the time being` IS TRUE
    `constituting instrument is filed in the Supreme Court Registry under section 48` IS FALSE
    `filing was approved by the Minister under hand and seal` IS TRUE
    `notification of the filing has appeared in the Gazette` IS FALSE

`a former Procureur whose gazetted filing still stands` MEANS Claimant WITH
    `holds the office of Procureur at Singapore for the time being` IS FALSE
    `constituting instrument is filed in the Supreme Court Registry under section 48` IS TRUE
    `filing was approved by the Minister under hand and seal` IS TRUE
    `notification of the filing has appeared in the Gazette` IS TRUE

`a lease sealed before and signed by the qualified Procureur` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the duly qualified Procureur`
    `signed by` IS `the duly qualified Procureur`

`a transfer sealed before and signed by a registered attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney under a registered power of attorney`
    `signed by` IS `an attorney under a registered power of attorney`

`a mortgage sealed before the Procureur and signed by a registered attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the duly qualified Procureur`
    `signed by` IS `an attorney under a registered power of attorney`

`a conveyance sealed before and signed by a Procureur not yet gazetted` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a Procureur not yet duly qualified`
    `signed by` IS `a Procureur not yet duly qualified`

`a conveyance sealed before and signed by an unregistered attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney whose power of attorney is not registered`
    `signed by` IS `an attorney whose power of attorney is not registered`

`a deed sealed before another member and signed by the Procureur` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `another member of the Society`
    `signed by` IS `the duly qualified Procureur`

`a document signed by the Procureur but never sealed` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS FALSE
    `sealed in the presence of` IS `the duly qualified Procureur`
    `signed by` IS `the duly qualified Procureur`

`a deed sealed before the Procureur but signed by nobody` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the duly qualified Procureur`
    `signed by` IS `nobody`

§ `s 2(1), (4), (5)`

#ASSERT `is a duly qualified Procureur` `a Procureur whose approved filing has been gazetted`
#ASSERT NOT `is a duly qualified Procureur` `a Procureur whose approved filing is not yet gazetted`
#ASSERT NOT `is a duly qualified Procureur` `a Procureur whose filing was gazetted without the Minister's approval`
#ASSERT NOT `is a duly qualified Procureur` `a newly appointed Procureur who has filed nothing`
#ASSERT NOT `is a duly qualified Procureur` `a Procureur with the Minister's approval who has not filed`
#ASSERT NOT `is a duly qualified Procureur` `a former Procureur whose gazetted filing still stands`

#ASSERT `the Gazette is sufficient evidence of appointment and qualification` `a Procureur whose approved filing has been gazetted`
#ASSERT NOT `the Gazette is sufficient evidence of appointment and qualification` `a Procureur whose approved filing is not yet gazetted`
#ASSERT `the Gazette is sufficient evidence of appointment and qualification` `a Procureur whose filing was gazetted without the Minister's approval`
#ASSERT NOT `the Gazette is sufficient evidence of appointment and qualification` `a newly appointed Procureur who has filed nothing`
#ASSERT NOT `the Gazette is sufficient evidence of appointment and qualification` `a Procureur with the Minister's approval who has not filed`
#ASSERT `the Gazette is sufficient evidence of appointment and qualification` `a former Procureur whose gazetted filing still stands`

§ `s 2(2), (3)`

#ASSERT `the Ordinance empowers the Corporation to` `use and change its corporate seal` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `acquire or purchase property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `hold and enjoy property` TRUE
#ASSERT `the Ordinance empowers the Corporation to` `sell property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `mortgage property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `mortgage property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `lease property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `lease property` FALSE
#ASSERT `the Ordinance empowers the Corporation to` `transfer or otherwise dispose of property` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `transfer or otherwise dispose of property` FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sue or be sued` TRUE
#ASSERT NOT `the Ordinance empowers the Corporation to` `borrow money without security` TRUE

§ `s 3`

#ASSERT `is duly sealed under section 3` `a lease sealed before and signed by the qualified Procureur`
#ASSERT `is duly sealed under section 3` `a transfer sealed before and signed by a registered attorney`
#ASSERT `is duly sealed under section 3` `a mortgage sealed before the Procureur and signed by a registered attorney`
#ASSERT NOT `is duly sealed under section 3` `a conveyance sealed before and signed by a Procureur not yet gazetted`
#ASSERT NOT `is duly sealed under section 3` `a conveyance sealed before and signed by an unregistered attorney`
#ASSERT NOT `is duly sealed under section 3` `a deed sealed before another member and signed by the Procureur`
#ASSERT NOT `is duly sealed under section 3` `a document signed by the Procureur but never sealed`
#ASSERT NOT `is duly sealed under section 3` `a deed sealed before the Procureur but signed by nobody`

#ASSERT `the signature is sufficient evidence of due sealing` `a lease sealed before and signed by the qualified Procureur`
#ASSERT `the signature is sufficient evidence of due sealing` `a transfer sealed before and signed by a registered attorney`
#ASSERT `the signature is sufficient evidence of due sealing` `a mortgage sealed before the Procureur and signed by a registered attorney`
#ASSERT NOT `the signature is sufficient evidence of due sealing` `a conveyance sealed before and signed by a Procureur not yet gazetted`
#ASSERT NOT `the signature is sufficient evidence of due sealing` `a conveyance sealed before and signed by an unregistered attorney`
#ASSERT `the signature is sufficient evidence of due sealing` `a deed sealed before another member and signed by the Procureur`
#ASSERT NOT `the signature is sufficient evidence of due sealing` `a document signed by the Procureur but never sealed`
#ASSERT NOT `the signature is sufficient evidence of due sealing` `a deed sealed before the Procureur but signed by nobody`

