#ASSERT NOT `process may be served there` `a committee room while the committee is sitting` FALSE
#ASSERT `process may be served there` `the precincts while Parliament is not sitting` FALSE
#ASSERT `process may be served there` `the precincts while Parliament is sitting` TRUE

§ `ss 13, 25, 26`

#ASSERT `the summons is duly served` `a copy left at his home with an adult` TRUE
#ASSERT NOT `the summons is duly served` `a copy left at his home with a child` TRUE
#ASSERT NOT `the summons is duly served` `a copy sent by email` TRUE

#ASSERT `the Speaker may issue a warrant to apprehend` `a copy delivered to him` TRUE FALSE
#ASSERT NOT `the Speaker may issue a warrant to apprehend` `a copy delivered to him` TRUE TRUE
#ASSERT NOT `the Speaker may issue a warrant to apprehend` `a copy left in his letterbox` TRUE FALSE

