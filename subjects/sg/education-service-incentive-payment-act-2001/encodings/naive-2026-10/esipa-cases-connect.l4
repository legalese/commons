IMPORT prelude
IMPORT `esipa-connect`

-- Education Service Incentive Payment Act 2001, ss 2, 3(1), 3(2), 6-10, 12-14, 15(4) and 16(6) -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_education-service-incentive-payment-act-2001.py). Expected results were written by
-- hand from the text.

§ `Fixtures`

`a permanent Education Service teacher below Superscale` MEANS Teacher WITH
    `employer` IS `the Government, in the Education Service`
    `on the permanent establishment` IS TRUE
    `below Superscale grade` IS TRUE
    `employed for a term` IS FALSE
    `employed for teaching duties` IS TRUE
    `remunerated on terms equivalent to an eligible public officer` IS FALSE

`a Superscale Education Service officer` MEANS Teacher WITH
    `employer` IS `the Government, in the Education Service`
    `on the permanent establishment` IS TRUE
    `below Superscale grade` IS FALSE
    `employed for a term` IS FALSE
    `employed for teaching duties` IS TRUE
    `remunerated on terms equivalent to an eligible public officer` IS FALSE

`a permanent Education Service officer in a ministry desk job` MEANS Teacher WITH
    `employer` IS `the Government, in the Education Service`
    `on the permanent establishment` IS TRUE
    `below Superscale grade` IS TRUE
    `employed for a term` IS FALSE
    `employed for teaching duties` IS FALSE
    `remunerated on terms equivalent to an eligible public officer` IS FALSE

`a permanent aided-school teacher on equivalent pay` MEANS Teacher WITH
    `employer` IS `the managers of an aided school`
    `on the permanent establishment` IS FALSE
    `below Superscale grade` IS FALSE
    `employed for a term` IS FALSE
    `employed for teaching duties` IS TRUE
    `remunerated on terms equivalent to an eligible public officer` IS TRUE

`an aided-school teacher on a fixed-term contract` MEANS Teacher WITH
    `employer` IS `the managers of an aided school`
    `on the permanent establishment` IS FALSE
    `below Superscale grade` IS FALSE
    `employed for a term` IS TRUE
    `employed for teaching duties` IS TRUE
    `remunerated on terms equivalent to an eligible public officer` IS TRUE

`an aided-school teacher on non-equivalent pay` MEANS Teacher WITH
    `employer` IS `the managers of an aided school`
    `on the permanent establishment` IS FALSE
    `below Superscale grade` IS FALSE
    `employed for a term` IS FALSE
    `employed for teaching duties` IS TRUE
    `remunerated on terms equivalent to an eligible public officer` IS FALSE

`a permanent independent-school teacher on equivalent pay` MEANS Teacher WITH
    `employer` IS `an independent school`
    `on the permanent establishment` IS FALSE
    `below Superscale grade` IS FALSE
    `employed for a term` IS FALSE
    `employed for teaching duties` IS TRUE
    `remunerated on terms equivalent to an eligible public officer` IS TRUE

`a member with a clean record` MEANS `Member's record` WITH
    `sentence` IS `no conviction`
    `received a free pardon` IS FALSE
    `dismissed` IS FALSE
    `reduced in rank` IS FALSE
    `charged with a disciplinary charge for negligence, irregularity or misconduct` IS FALSE

`a member fined for an offence` MEANS `Member's record` WITH
    `sentence` IS `a fine only`
    `received a free pardon` IS FALSE
    `dismissed` IS FALSE
    `reduced in rank` IS FALSE
    `charged with a disciplinary charge for negligence, irregularity or misconduct` IS FALSE

`a member jailed abroad for an offence` MEANS `Member's record` WITH
    `sentence` IS `a term of imprisonment`
    `received a free pardon` IS FALSE
    `dismissed` IS FALSE
    `reduced in rank` IS FALSE
    `charged with a disciplinary charge for negligence, irregularity or misconduct` IS FALSE

`a jailed member who received a free pardon` MEANS `Member's record` WITH
    `sentence` IS `a term of imprisonment`
    `received a free pardon` IS TRUE
    `dismissed` IS FALSE
    `reduced in rank` IS FALSE
    `charged with a disciplinary charge for negligence, irregularity or misconduct` IS FALSE

`a member reduced in rank` MEANS `Member's record` WITH
    `sentence` IS `no conviction`
    `received a free pardon` IS FALSE
    `dismissed` IS FALSE
    `reduced in rank` IS TRUE
    `charged with a disciplinary charge for negligence, irregularity or misconduct` IS FALSE

`a member dismissed from the teaching service` MEANS `Member's record` WITH
    `sentence` IS `no conviction`
    `received a free pardon` IS FALSE
    `dismissed` IS TRUE
    `reduced in rank` IS FALSE
    `charged with a disciplinary charge for negligence, irregularity or misconduct` IS FALSE

`a member charged but not yet heard on a misconduct charge` MEANS `Member's record` WITH
    `sentence` IS `no conviction`
    `received a free pardon` IS FALSE
    `dismissed` IS FALSE
    `reduced in rank` IS FALSE
    `charged with a disciplinary charge for negligence, irregularity or misconduct` IS TRUE

§ `s 2 teaching duties`

#ASSERT `the duty is a teaching duty` `classroom teaching`
#ASSERT `the duty is a teaching duty` `administering a school`
#ASSERT `the duty is a teaching duty` `a school duty where teaching experience is an advantage`
#ASSERT NOT `the duty is a teaching duty` `a school duty where teaching experience is no advantage`

