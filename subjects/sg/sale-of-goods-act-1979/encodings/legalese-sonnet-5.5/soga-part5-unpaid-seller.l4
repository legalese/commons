    WHEN `the person in actual possession of the goods` THEN JUST TRUE
    WHEN `the principal of the person in actual possession of the goods` THEN JUST TRUE
    -- NOTHING-kind (list not closed): the subsection says the notice "may be given either to the person in actual possession ... or to his principal".
    WHEN `some other person` THEN NOTHING

-- s 46(3).
