-- Sale of Goods Act 1979 (Singapore).  LAYER 1 TESTS for the interpretation section (s 61).
-- One test per entry on each side: a thing within the term, and a thing outside it.
-- Expected values are written from the text beside each assertion, before running.

IMPORT prelude
IMPORT daydate
IMPORT `soga-nouns`
IMPORT `soga-interpretation`

-- s 61(1) lead-in.
#ASSERT `s 61(1) the definitions of this section apply` FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the definitions of this section apply` TRUE EQUALS JUST FALSE
-- "action" includes counterclaim and set-off (open: an unnamed proceeding is NOTHING).
#ASSERT `s 61(1) the proceeding is an action` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the proceeding is an action` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the proceeding is an action` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 61(1) the proceeding is an action` FALSE FALSE FALSE EQUALS NOTHING
-- "bulk" means (closed).
#ASSERT `s 61(1) the mass or collection is a bulk` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 61(1) the mass or collection is a bulk` FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 61(1) the mass or collection is a bulk` TRUE FALSE TRUE EQUALS JUST FALSE -- not in a defined space
#ASSERT `s 61(1) the mass or collection is a bulk` TRUE TRUE FALSE EQUALS JUST FALSE -- not interchangeable
-- "business" includes (open).
#ASSERT `s 61(1) the activity is a business` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the activity is a business` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the activity is a business` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 61(1) the activity is a business` FALSE FALSE FALSE EQUALS NOTHING
-- "buyer" means (closed).
#ASSERT `s 61(1) the person is a buyer` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the person is a buyer` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 61(1) the person is a buyer` FALSE FALSE EQUALS JUST FALSE
-- "claimant" includes (open).
#ASSERT `s 61(1) the person is a claimant` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the person is a claimant` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 61(1) the person is a claimant` FALSE FALSE EQUALS NOTHING
-- "contract of sale" includes (open).
#ASSERT `s 61(1) the contract is a contract of sale` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the contract is a contract of sale` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 61(1) the contract is a contract of sale` FALSE FALSE EQUALS NOTHING
-- "credit-broker" means (closed).
#ASSERT `s 61(1) the person is a credit-broker` TRUE TRUE FALSE EQUALS JUST TRUE -- (a)
#ASSERT `s 61(1) the person is a credit-broker` TRUE FALSE TRUE EQUALS JUST TRUE -- (b)
#ASSERT `s 61(1) the person is a credit-broker` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 61(1) the person is a credit-broker` FALSE TRUE TRUE EQUALS JUST FALSE
-- "delivery" means (closed), widened for ss 20A and 20B.
#ASSERT `s 61(1) there is delivery` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) there is delivery` FALSE TRUE TRUE EQUALS JUST TRUE -- appropriation under s 20A or 20B
#ASSERT `s 61(1) there is delivery` FALSE FALSE TRUE EQUALS JUST FALSE -- appropriation outside ss 20A and 20B
#ASSERT `s 61(1) there is delivery` FALSE TRUE FALSE EQUALS JUST FALSE -- no appropriation that passes property
-- "document of title to goods": the Factors Act 1889 decides.
#ASSERT `s 61(1) the document is a document of title to goods` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 61(1) the document is a document of title to goods` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 61(1) the document is a document of title to goods` NOTHING EQUALS NOTHING
-- "fault" means (closed).
#ASSERT `s 61(1) the thing is fault` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the thing is fault` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 61(1) the thing is fault` FALSE FALSE EQUALS JUST FALSE
-- "future goods" means (closed).
#ASSERT `s 61(1) the goods are future goods` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the goods are future goods` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 61(1) the goods are future goods` FALSE FALSE EQUALS JUST FALSE
-- "goods" includes (open).
#ASSERT `s 61(1) the thing is goods` `a personal chattel other than a thing in action or money` EQUALS JUST TRUE
#ASSERT `s 61(1) the thing is goods` `emblements` EQUALS JUST TRUE
#ASSERT `s 61(1) the thing is goods` `industrial growing crops` EQUALS JUST TRUE
#ASSERT `s 61(1) the thing is goods` `a thing attached to or forming part of the land which is agreed to be severed before sale or under the contract of sale` EQUALS JUST TRUE
#ASSERT `s 61(1) the thing is goods` `an undivided share in goods` EQUALS JUST TRUE
#ASSERT `s 61(1) the thing is goods` `a thing in action` EQUALS JUST FALSE
#ASSERT `s 61(1) the thing is goods` `money` EQUALS JUST FALSE
#ASSERT `s 61(1) the thing is goods` `some other thing` EQUALS NOTHING
-- "property" means (closed).
#ASSERT `s 61(1) the interest is property` TRUE EQUALS JUST TRUE
#ASSERT `s 61(1) the interest is property` FALSE EQUALS JUST FALSE -- a special property only
-- "sale" includes (open).
#ASSERT `s 61(1) the transaction is a sale` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the transaction is a sale` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 61(1) the transaction is a sale` FALSE FALSE EQUALS NOTHING
-- "seller" means (closed).
#ASSERT `s 61(1) the person is a seller` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the person is a seller` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 61(1) the person is a seller` FALSE FALSE EQUALS JUST FALSE
-- "specific goods" means (closed) and includes an undivided share.
#ASSERT `s 61(1) the goods are specific goods` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the goods are specific goods` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 61(1) the goods are specific goods` FALSE FALSE EQUALS JUST FALSE
-- "warranty" means (closed).
#ASSERT `s 61(1) the agreement is a warranty` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(1) the agreement is a warranty` TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- breach gives a right to reject: that is a condition
#ASSERT `s 61(1) the agreement is a warranty` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- not collateral
#ASSERT `s 61(1) the agreement is a warranty` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- breach gives no claim for damages
#ASSERT `s 61(1) the agreement is a warranty` FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- not an agreement about goods under the contract
-- s 61(2).
#ASSERT `s 61(2) the thing is deemed to be done in good faith` TRUE EQUALS JUST TRUE
#ASSERT `s 61(2) the thing is deemed to be done in good faith` FALSE EQUALS JUST FALSE
-- s 61(3).
#ASSERT `s 61(3) the person is deemed to be insolvent` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 61(3) the person is deemed to be insolvent` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 61(3) the person is deemed to be insolvent` FALSE FALSE EQUALS JUST FALSE
-- s 61(4).
#ASSERT `s 61(4) the goods are in a deliverable state` TRUE EQUALS JUST TRUE
#ASSERT `s 61(4) the goods are in a deliverable state` FALSE EQUALS JUST FALSE
-- s 61(4A).
#ASSERT `s 61(4A) the buyer deals as consumer` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 61(4A) the buyer deals as consumer` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 61(4A) the buyer deals as consumer` NOTHING EQUALS NOTHING
-- s 61(4B).
#ASSERT `s 61(4B) the seller's claim that the buyer does not deal as consumer is made out` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 61(4B) the seller's claim that the buyer does not deal as consumer is made out` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 61(4B) the seller's claim that the buyer does not deal as consumer is made out` FALSE FALSE EQUALS NOTHING
-- s 61(5).
#ASSERT `s 61(5) paragraph 12 of the Schedule applies as regards the definition of business` (Date 18 5 1973) EQUALS JUST TRUE
#ASSERT `s 61(5) paragraph 12 of the Schedule applies as regards the definition of business` (Date 31 1 1978) EQUALS JUST TRUE
#ASSERT `s 61(5) paragraph 12 of the Schedule applies as regards the definition of business` (Date 17 5 1973) EQUALS JUST FALSE
#ASSERT `s 61(5) paragraph 12 of the Schedule applies as regards the definition of business` (Date 1 2 1978) EQUALS JUST FALSE
#ASSERT `s 61(5) paragraph 13 of the Schedule applies as regards the definition of business` (Date 17 5 1973) EQUALS JUST TRUE
#ASSERT `s 61(5) paragraph 13 of the Schedule applies as regards the definition of business` (Date 18 5 1973) EQUALS JUST FALSE

-- assertions written: 83
