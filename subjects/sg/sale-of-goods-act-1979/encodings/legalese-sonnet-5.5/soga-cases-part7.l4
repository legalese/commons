-- Sale of Goods Act 1979 (Singapore).  LAYER 1 TESTS for Part 7 (ss 55 to 60 and 62).
-- Expected values are written from the text beside each assertion, before running.

IMPORT prelude
IMPORT daydate
IMPORT `soga-nouns`
IMPORT `soga-part7-supplementary`

-- s 55(1).
#ASSERT `s 55(1) the right, duty or liability may be negatived or varied` TRUE FALSE `express agreement` EQUALS JUST TRUE
#ASSERT `s 55(1) the right, duty or liability may be negatived or varied` TRUE FALSE `the course of dealing between the parties` EQUALS JUST TRUE
#ASSERT `s 55(1) the right, duty or liability may be negatived or varied` TRUE FALSE `such usage as binds both parties to the contract` EQUALS JUST TRUE
#ASSERT `s 55(1) the right, duty or liability may be negatived or varied` TRUE FALSE `some other way` EQUALS NOTHING
#ASSERT `s 55(1) the right, duty or liability may be negatived or varied` TRUE TRUE `express agreement` EQUALS NOTHING -- the Unfair Contract Terms Act 1977 prevents it: the Act is outside the sources
#ASSERT `s 55(1) the right, duty or liability may be negatived or varied` FALSE FALSE `express agreement` EQUALS JUST FALSE -- no implied right, duty or liability
-- s 55(2).
#ASSERT `s 55(2) an express condition or warranty negatives a condition or warranty implied by this Act` FALSE EQUALS JUST FALSE
#ASSERT `s 55(2) an express condition or warranty negatives a condition or warranty implied by this Act` TRUE EQUALS NOTHING
-- s 55(3): paragraph 9 for 18 May 1973 up to (not including) 1 Feb 1978; paragraph 10 before 18 May 1973.
#ASSERT `s 55(3) paragraph 9 of the Schedule applies in relation to the contract` (Date 18 5 1973) EQUALS JUST TRUE
#ASSERT `s 55(3) paragraph 9 of the Schedule applies in relation to the contract` (Date 31 1 1978) EQUALS JUST TRUE
#ASSERT `s 55(3) paragraph 9 of the Schedule applies in relation to the contract` (Date 17 5 1973) EQUALS JUST FALSE
#ASSERT `s 55(3) paragraph 9 of the Schedule applies in relation to the contract` (Date 1 2 1978) EQUALS JUST FALSE
#ASSERT `s 55(3) paragraph 10 of the Schedule applies in relation to the contract` (Date 17 5 1973) EQUALS JUST TRUE
#ASSERT `s 55(3) paragraph 10 of the Schedule applies in relation to the contract` (Date 18 5 1973) EQUALS JUST FALSE
-- s 56.
#ASSERT `s 56 paragraph 11 of the Schedule applies in relation to the contract` (Date 18 5 1973) EQUALS JUST TRUE
#ASSERT `s 56 paragraph 11 of the Schedule applies in relation to the contract` (Date 31 1 1978) EQUALS JUST TRUE
#ASSERT `s 56 paragraph 11 of the Schedule applies in relation to the contract` (Date 17 5 1973) EQUALS JUST FALSE
#ASSERT `s 56 paragraph 11 of the Schedule applies in relation to the contract` (Date 1 2 1978) EQUALS JUST FALSE
-- s 57(1).
#ASSERT `s 57(1) each lot is deemed to be the subject of a separate contract of sale` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 57(1) each lot is deemed to be the subject of a separate contract of sale` TRUE TRUE EQUALS NOTHING -- prima facie only
#ASSERT `s 57(1) each lot is deemed to be the subject of a separate contract of sale` FALSE FALSE EQUALS JUST FALSE
-- s 57(2).
#ASSERT `s 57(2) the sale by auction is complete` TRUE EQUALS JUST TRUE
#ASSERT `s 57(2) the sale by auction is complete` FALSE EQUALS JUST FALSE
#ASSERT `s 57(2) any bidder may retract his bid` FALSE EQUALS JUST TRUE
#ASSERT `s 57(2) any bidder may retract his bid` TRUE EQUALS JUST FALSE
-- s 57(3).
#ASSERT `s 57(3) the sale by auction may be notified to be subject to, or a right may be reserved in respect of, this matter` `a reserve or upset price` EQUALS JUST TRUE
#ASSERT `s 57(3) the sale by auction may be notified to be subject to, or a right may be reserved in respect of, this matter` `a right to bid expressly reserved by or on behalf of the seller` EQUALS JUST TRUE
#ASSERT `s 57(3) the sale by auction may be notified to be subject to, or a right may be reserved in respect of, this matter` `some other matter an auction sale may be notified or reserved` EQUALS NOTHING
-- s 57(4).
#ASSERT `s 57(4) it is lawful for the seller to bid himself or to employ any person to bid at the sale` FALSE EQUALS JUST FALSE
#ASSERT `s 57(4) it is lawful for the seller to bid himself or to employ any person to bid at the sale` TRUE EQUALS NOTHING
#ASSERT `s 57(4) it is lawful for the auctioneer to take the bid` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 57(4) it is lawful for the auctioneer to take the bid` FALSE FALSE EQUALS NOTHING -- not knowingly
#ASSERT `s 57(4) it is lawful for the auctioneer to take the bid` TRUE TRUE EQUALS NOTHING -- right to bid notified
-- s 57(5).
#ASSERT `s 57(5) the sale may be treated as fraudulent by the buyer` TRUE EQUALS JUST TRUE
#ASSERT `s 57(5) the sale may be treated as fraudulent by the buyer` FALSE EQUALS NOTHING
-- s 57(6).
#ASSERT `s 57(6) the seller, or any one person on his behalf, may bid at the auction` FALSE TRUE 0 EQUALS JUST FALSE -- not reserved: "but not otherwise"
#ASSERT `s 57(6) the seller, or any one person on his behalf, may bid at the auction` TRUE TRUE 0 EQUALS JUST TRUE -- the seller himself
#ASSERT `s 57(6) the seller, or any one person on his behalf, may bid at the auction` TRUE FALSE 1 EQUALS JUST TRUE -- one person on his behalf
#ASSERT `s 57(6) the seller, or any one person on his behalf, may bid at the auction` TRUE FALSE 2 EQUALS NOTHING -- two persons
#ASSERT `s 57(6) the seller, or any one person on his behalf, may bid at the auction` TRUE TRUE 1 EQUALS NOTHING -- the seller and an agent
#ASSERT `s 57(6) the seller, or any one person on his behalf, may bid at the auction` TRUE FALSE 0 EQUALS NOTHING -- nobody bids
-- s 59.
#ASSERT `s 59 what is a reasonable time is a question of fact` TRUE EQUALS JUST TRUE
#ASSERT `s 59 what is a reasonable time is a question of fact` FALSE EQUALS JUST FALSE
-- s 60.
#ASSERT `s 60 the right, duty or liability may be enforced by action` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 60 the right, duty or liability may be enforced by action` TRUE TRUE EQUALS NOTHING
#ASSERT `s 60 the right, duty or liability may be enforced by action` FALSE FALSE EQUALS JUST FALSE
-- s 62.
#ASSERT `s 62(1) the rules in bankruptcy relating to contracts of sale apply to the contract notwithstanding anything in this Act` TRUE EQUALS JUST TRUE
#ASSERT `s 62(1) the rules in bankruptcy relating to contracts of sale apply to the contract notwithstanding anything in this Act` FALSE EQUALS NOTHING
#ASSERT `s 62(2) the rule of the common law applies to the contract` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 62(2) the rule of the common law applies to the contract` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 62(2) the rule of the common law applies to the contract` FALSE FALSE EQUALS NOTHING
#ASSERT `s 62(3) this Act affects the matter` `the enactments relating to bills of sale` EQUALS JUST FALSE
#ASSERT `s 62(3) this Act affects the matter` `the rules in bankruptcy relating to contracts of sale` EQUALS NOTHING
#ASSERT `s 62(3) this Act affects the matter` `some other matter under section 62(3)` EQUALS NOTHING
#ASSERT `s 62(4) the provisions of this Act about contracts of sale apply to the transaction` TRUE EQUALS JUST FALSE
#ASSERT `s 62(4) the provisions of this Act about contracts of sale apply to the transaction` FALSE EQUALS NOTHING

-- assertions written: 56
