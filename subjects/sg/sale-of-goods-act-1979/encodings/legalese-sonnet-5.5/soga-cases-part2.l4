-- Sale of Goods Act 1979 (Singapore).  LAYER 1 TESTS for Part 2 (ss 2 to 15A).
-- Expected values are written from the text beside each assertion, before running.
-- Each argument list follows the GIVEN order of the rule it calls.

IMPORT prelude
IMPORT daydate
IMPORT `soga-nouns`
IMPORT `soga-part2-formation`

-- s 2(1): a contract of sale of goods: transfer (or agreement to transfer) of the property in goods, for a money consideration.
#ASSERT `s 2(1) the contract is a contract of sale of goods` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(1) the contract is a contract of sale of goods` TRUE FALSE EQUALS JUST FALSE -- a swap of goods for goods has no money consideration
#ASSERT `s 2(1) the contract is a contract of sale of goods` FALSE TRUE EQUALS JUST FALSE -- no transfer of the property in goods
-- s 2(1) "the price": the money consideration is called the price.
#ASSERT `s 2(1) the price` 5000 EQUALS 5000
-- s 2(2): one part owner and another.
#ASSERT `s 2(2) there may be a contract of sale between one part owner and another` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 2(2) there may be a contract of sale between one part owner and another` TRUE FALSE EQUALS NOTHING -- buyer not a part owner: the subsection is silent
#ASSERT `s 2(2) there may be a contract of sale between one part owner and another` FALSE TRUE EQUALS NOTHING
-- s 2(3): absolute or conditional.
#ASSERT `s 2(3) the contract of sale is absolute or conditional` TRUE EQUALS `a conditional contract`
#ASSERT `s 2(3) the contract of sale is absolute or conditional` FALSE EQUALS `an absolute contract`
-- s 2(4): a sale.
#ASSERT `s 2(4) the contract is called a sale` TRUE EQUALS JUST `a sale`
#ASSERT `s 2(4) the contract is called a sale` FALSE EQUALS NOTHING
-- s 2(5): an agreement to sell (future time, or a condition later to be fulfilled).
#ASSERT `s 2(5) the contract is called an agreement to sell` TRUE FALSE EQUALS JUST `an agreement to sell`
#ASSERT `s 2(5) the contract is called an agreement to sell` FALSE TRUE EQUALS JUST `an agreement to sell`
#ASSERT `s 2(5) the contract is called an agreement to sell` FALSE FALSE EQUALS NOTHING
-- s 2(6): an agreement to sell becomes a sale when the time elapses or the conditions are fulfilled.
#ASSERT `s 2(6) the agreement to sell becomes a sale` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2(6) the agreement to sell becomes a sale` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2(6) the agreement to sell becomes a sale` FALSE FALSE EQUALS JUST FALSE
-- ss 2(4) to (6) gathered by hand (E1 option B).
#ASSERT `ss 2(4) to (6) the stage of the contract of sale` TRUE FALSE FALSE FALSE FALSE EQUALS JUST `a sale`
#ASSERT `ss 2(4) to (6) the stage of the contract of sale` FALSE TRUE FALSE FALSE FALSE EQUALS JUST `an agreement to sell`
#ASSERT `ss 2(4) to (6) the stage of the contract of sale` FALSE TRUE FALSE TRUE FALSE EQUALS JUST `a sale` -- time elapsed: becomes a sale
#ASSERT `ss 2(4) to (6) the stage of the contract of sale` FALSE FALSE TRUE FALSE TRUE EQUALS JUST `a sale` -- condition fulfilled: becomes a sale
#ASSERT `ss 2(4) to (6) the stage of the contract of sale` FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING
-- s 3(1): capacity is for the general law.
#ASSERT `s 3(1) the party has capacity to buy and sell` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 3(1) the party has capacity to buy and sell` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 3(1) the party has capacity to buy and sell` NOTHING EQUALS NOTHING
-- s 3(3): "necessaries" means goods suitable to the condition in life AND to his actual requirements.
#ASSERT `s 3(3) the goods are necessaries` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 3(3) the goods are necessaries` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 3(3) the goods are necessaries` FALSE TRUE EQUALS JUST FALSE
-- s 3(2): necessaries sold and delivered to a minor, or to a person incompetent to contract, for a reasonable price (80).
#ASSERT `s 3(2) the amount the buyer must pay for necessaries sold and delivered` TRUE TRUE TRUE FALSE 80 EQUALS JUST 80
#ASSERT `s 3(2) the amount the buyer must pay for necessaries sold and delivered` TRUE TRUE FALSE TRUE 80 EQUALS JUST 80 -- drunk or mentally incapable buyer
#ASSERT `s 3(2) the amount the buyer must pay for necessaries sold and delivered` TRUE TRUE FALSE FALSE 80 EQUALS NOTHING -- an adult of sound mind: the general law, not s 3(2)
#ASSERT `s 3(2) the amount the buyer must pay for necessaries sold and delivered` TRUE FALSE TRUE FALSE 80 EQUALS NOTHING -- sold but not delivered
#ASSERT `s 3(2) the amount the buyer must pay for necessaries sold and delivered` FALSE TRUE TRUE FALSE 80 EQUALS NOTHING -- luxuries
-- s 4(1): forms.
#ASSERT `s 4(1) a contract of sale may be made in this form` `made in writing` FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) a contract of sale may be made in this form` `made by word of mouth` FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) a contract of sale may be made in this form` `made partly in writing and partly by word of mouth` FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) a contract of sale may be made in this form` `implied from the conduct of the parties` FALSE EQUALS JUST TRUE
#ASSERT `s 4(1) a contract of sale may be made in this form` `made in some other form` FALSE EQUALS NOTHING -- list not closed
#ASSERT `s 4(1) a contract of sale may be made in this form` `made in writing` TRUE EQUALS NOTHING -- "Subject to this and any other Act"
-- s 4(2).
#ASSERT `s 4(2) section 4 affects the law relating to corporations` TRUE EQUALS JUST FALSE
#ASSERT `s 4(2) section 4 affects the law relating to corporations` FALSE EQUALS NOTHING
-- s 5(1): existing or future goods; "future goods" defined.
#ASSERT `s 5(1) the goods may be the subject of a contract of sale` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 5(1) the goods may be the subject of a contract of sale` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 5(1) the goods may be the subject of a contract of sale` FALSE FALSE EQUALS NOTHING
#ASSERT `s 5(1) the goods are future goods` TRUE EQUALS JUST TRUE
#ASSERT `s 5(1) the goods are future goods` FALSE EQUALS JUST FALSE -- goods that already exist and are the seller's are not future goods
-- s 5(2).
#ASSERT `s 5(2) there may be a contract for the sale of goods whose acquisition depends on a contingency` TRUE EQUALS JUST TRUE
#ASSERT `s 5(2) there may be a contract for the sale of goods whose acquisition depends on a contingency` FALSE EQUALS NOTHING
-- s 5(3): a purported present sale of future goods is an agreement to sell.
#ASSERT `s 5(3) a purported present sale of future goods operates as an agreement to sell` TRUE TRUE EQUALS JUST `an agreement to sell`
#ASSERT `s 5(3) a purported present sale of future goods operates as an agreement to sell` TRUE FALSE EQUALS NOTHING
#ASSERT `s 5(3) a purported present sale of future goods operates as an agreement to sell` FALSE TRUE EQUALS NOTHING
-- s 6.
#ASSERT `s 6 the contract is void` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 6 the contract is void` TRUE TRUE FALSE EQUALS JUST FALSE -- the seller knew the goods had perished: the section is silent
#ASSERT `s 6 the contract is void` FALSE TRUE TRUE EQUALS JUST FALSE -- not specific goods
#ASSERT `s 6 the contract is void` TRUE FALSE TRUE EQUALS JUST FALSE -- goods had not perished
-- s 7.
#ASSERT `s 7 the agreement to sell is avoided` TRUE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 7 the agreement to sell is avoided` FALSE TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 7 the agreement to sell is avoided` TRUE FALSE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 7 the agreement to sell is avoided` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- fault of seller or buyer
#ASSERT `s 7 the agreement to sell is avoided` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- the risk had already passed
-- s 8(1).
#ASSERT `s 8(1) the price is determined as the subsection mentions` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 8(1) the price is determined as the subsection mentions` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 8(1) the price is determined as the subsection mentions` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 8(1) the price is determined as the subsection mentions` FALSE FALSE FALSE EQUALS NOTHING
-- s 8(2): none of the three ways: a reasonable price (40).
#ASSERT `s 8(2) the amount the buyer must pay where the price is not determined` FALSE FALSE FALSE 40 EQUALS JUST 40
#ASSERT `s 8(2) the amount the buyer must pay where the price is not determined` TRUE FALSE FALSE 40 EQUALS NOTHING
#ASSERT `s 8(2) the amount the buyer must pay where the price is not determined` FALSE TRUE FALSE 40 EQUALS NOTHING
#ASSERT `s 8(2) the amount the buyer must pay where the price is not determined` FALSE FALSE TRUE 40 EQUALS NOTHING
-- s 8(3): a question of fact; no figure in the Act.
#ASSERT `s 8(3) the Act's own figure for a reasonable price` EQUALS NOTHING
-- s 9(1).
#ASSERT `s 9(1) the agreement to sell is avoided` TRUE TRUE FALSE EQUALS JUST TRUE -- the third party cannot value
#ASSERT `s 9(1) the agreement to sell is avoided` TRUE FALSE TRUE EQUALS JUST TRUE -- the third party does not value
#ASSERT `s 9(1) the agreement to sell is avoided` TRUE FALSE FALSE EQUALS JUST FALSE -- he valued
#ASSERT `s 9(1) the agreement to sell is avoided` FALSE TRUE TRUE EQUALS JUST FALSE -- no valuation term
#ASSERT `s 9(1) the amount the buyer must pay for goods delivered to and appropriated by him` TRUE TRUE TRUE 60 EQUALS JUST 60
#ASSERT `s 9(1) the amount the buyer must pay for goods delivered to and appropriated by him` TRUE TRUE FALSE 60 EQUALS NOTHING -- delivered but not appropriated
#ASSERT `s 9(1) the amount the buyer must pay for goods delivered to and appropriated by him` TRUE FALSE TRUE 60 EQUALS NOTHING
#ASSERT `s 9(1) the amount the buyer must pay for goods delivered to and appropriated by him` FALSE TRUE TRUE 60 EQUALS NOTHING
-- s 9(2).
#ASSERT `s 9(2) the party who may maintain an action for damages against the party at fault` TRUE TRUE FALSE EQUALS JUST Buyer -- the seller is at fault: the buyer sues
#ASSERT `s 9(2) the party who may maintain an action for damages against the party at fault` TRUE FALSE TRUE EQUALS JUST Seller -- the buyer is at fault: the seller sues
#ASSERT `s 9(2) the party who may maintain an action for damages against the party at fault` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 9(2) the party who may maintain an action for damages against the party at fault` TRUE FALSE FALSE EQUALS NOTHING
#ASSERT `s 9(2) the party who may maintain an action for damages against the party at fault` FALSE TRUE FALSE EQUALS NOTHING
-- s 10(1).
#ASSERT `s 10(1) a stipulation as to time of payment is of the essence of the contract` FALSE EQUALS JUST FALSE
#ASSERT `s 10(1) a stipulation as to time of payment is of the essence of the contract` TRUE EQUALS NOTHING
-- s 10(2).
#ASSERT `s 10(2) any other stipulation as to time is of the essence of the contract` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 10(2) any other stipulation as to time is of the essence of the contract` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 10(2) any other stipulation as to time is of the essence of the contract` NOTHING EQUALS NOTHING
-- s 10(3).
#ASSERT `s 10(3) a month in a contract of sale means a calendar month` FALSE EQUALS JUST TRUE
#ASSERT `s 10(3) a month in a contract of sale means a calendar month` TRUE EQUALS NOTHING
#ASSERT `s 10(3) the date on which a period of calendar months ends` (Date 15 1 2025) 2 EQUALS JUST (Date 15 3 2025)
#ASSERT `s 10(3) the date on which a period of calendar months ends` (Date 15 11 2025) 3 EQUALS JUST (Date 15 2 2026) -- across the year end
#ASSERT `s 10(3) the date on which a period of calendar months ends` (Date 31 1 2025) 1 EQUALS NOTHING -- no 31 February: the Act does not say
#ASSERT `s 10(3) the date is within the period of calendar months` (Date 15 1 2025) 2 (Date 15 3 2025) EQUALS JUST TRUE -- the last day of the period
#ASSERT `s 10(3) the date is within the period of calendar months` (Date 15 1 2025) 2 (Date 16 3 2025) EQUALS JUST FALSE -- the day after the period
#ASSERT `s 10(3) the date is within the period of calendar months` (Date 31 1 2025) 1 (Date 1 3 2025) EQUALS NOTHING
-- s 11(1).
#ASSERT `s 11(1) the buyer may waive the condition` TRUE EQUALS JUST TRUE
#ASSERT `s 11(1) the buyer may waive the condition` FALSE EQUALS JUST FALSE
#ASSERT `s 11(1) the buyer may elect to treat the breach of the condition as a breach of warranty` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 11(1) the buyer may elect to treat the breach of the condition as a breach of warranty` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 11(1) the buyer may elect to treat the breach of the condition as a breach of warranty` FALSE TRUE EQUALS JUST FALSE
-- s 11(2): the label does not decide it.
#ASSERT `s 11(2) the stipulation is a condition or a warranty` `the contract calls it a warranty` `construed as a condition` EQUALS JUST `a condition` -- "a stipulation may be a condition, though called a warranty"
#ASSERT `s 11(2) the stipulation is a condition or a warranty` `the contract calls it a condition` `construed as a warranty` EQUALS JUST `a warranty`
#ASSERT `s 11(2) the stipulation is a condition or a warranty` `the contract gives it no label` `not yet construed` EQUALS NOTHING
-- s 11(3): not severable + accepted -> only a breach of warranty; unless a contrary term; subject to s 35A.
#ASSERT `s 11(3) the breach of a condition can only be treated as a breach of warranty` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 11(3) the breach of a condition can only be treated as a breach of warranty` FALSE TRUE FALSE TRUE EQUALS JUST FALSE -- s 35A keeps the right to reject the rest
#ASSERT `s 11(3) the breach of a condition can only be treated as a breach of warranty` FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- contrary term
#ASSERT `s 11(3) the breach of a condition can only be treated as a breach of warranty` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- severable contract
#ASSERT `s 11(3) the breach of a condition can only be treated as a breach of warranty` FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- nothing accepted
-- s 11(4).
#ASSERT `s 11(4) section 11 affects the condition or warranty` TRUE EQUALS JUST FALSE
#ASSERT `s 11(4) section 11 affects the condition or warranty` FALSE EQUALS NOTHING
-- s 12(3): the limited-title contract.
#ASSERT `s 12(3) this subsection applies to the contract of sale` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 12(3) this subsection applies to the contract of sale` FALSE TRUE EQUALS JUST TRUE -- inferred from the circumstances
#ASSERT `s 12(3) this subsection applies to the contract of sale` FALSE FALSE EQUALS JUST FALSE
-- s 12(1): implied condition as to the right to sell.
#ASSERT `s 12(1) there is an implied condition that the seller has a right to sell the goods` FALSE EQUALS JUST TRUE
#ASSERT `s 12(1) there is an implied condition that the seller has a right to sell the goods` TRUE EQUALS JUST FALSE -- "other than one to which subsection (3) applies"
#ASSERT `s 12(1) the implied condition as to the right to sell is broken` FALSE TRUE FALSE TRUE EQUALS JUST TRUE -- a sale; no right to sell at the time of the contract
#ASSERT `s 12(1) the implied condition as to the right to sell is broken` FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- a sale; right to sell (a later right does not matter)
#ASSERT `s 12(1) the implied condition as to the right to sell is broken` FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- agreement to sell; will not have a right when the property is to pass
#ASSERT `s 12(1) the implied condition as to the right to sell is broken` FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- agreement to sell; will have a right at that time
#ASSERT `s 12(1) the implied condition as to the right to sell is broken` TRUE TRUE FALSE FALSE EQUALS NOTHING
-- s 12(2)(a).
#ASSERT `s 12(2)(a) the implied warranty that the goods are free from an undisclosed charge or encumbrance is broken` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 12(2)(a) the implied warranty that the goods are free from an undisclosed charge or encumbrance is broken` FALSE TRUE TRUE EQUALS JUST FALSE -- disclosed or known to the buyer
#ASSERT `s 12(2)(a) the implied warranty that the goods are free from an undisclosed charge or encumbrance is broken` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 12(2)(a) the implied warranty that the goods are free from an undisclosed charge or encumbrance is broken` TRUE TRUE FALSE EQUALS NOTHING -- s 12(3) contract
-- s 12(2)(b).
#ASSERT `s 12(2)(b) the implied warranty of quiet possession is broken` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 12(2)(b) the implied warranty of quiet possession is broken` FALSE TRUE TRUE EQUALS JUST FALSE -- disturbance by the holder of a disclosed charge
#ASSERT `s 12(2)(b) the implied warranty of quiet possession is broken` FALSE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 12(2)(b) the implied warranty of quiet possession is broken` TRUE TRUE FALSE EQUALS NOTHING
-- s 12(4).
#ASSERT `s 12(4) the implied warranty that known charges have been disclosed is broken` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 12(4) the implied warranty that known charges have been disclosed is broken` TRUE TRUE TRUE TRUE EQUALS JUST FALSE -- disclosed
#ASSERT `s 12(4) the implied warranty that known charges have been disclosed is broken` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- the buyer knew of it
#ASSERT `s 12(4) the implied warranty that known charges have been disclosed is broken` FALSE TRUE TRUE FALSE EQUALS NOTHING -- not a s 12(3) contract
-- s 12(5).
#ASSERT `s 12(5) the implied warranty that none of the named persons will disturb quiet possession is broken` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE -- the seller disturbs
#ASSERT `s 12(5) the implied warranty that none of the named persons will disturb quiet possession is broken` TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- the third person disturbs
#ASSERT `s 12(5) the implied warranty that none of the named persons will disturb quiet possession is broken` TRUE FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE -- a person claiming under the seller, not under a disclosed charge
#ASSERT `s 12(5) the implied warranty that none of the named persons will disturb quiet possession is broken` TRUE FALSE FALSE FALSE TRUE TRUE EQUALS JUST FALSE -- claiming under a disclosed charge
#ASSERT `s 12(5) the implied warranty that none of the named persons will disturb quiet possession is broken` TRUE FALSE FALSE FALSE FALSE FALSE EQUALS NOTHING -- some other disturbance
#ASSERT `s 12(5) the implied warranty that none of the named persons will disturb quiet possession is broken` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING -- not a s 12(3) contract
-- s 13(1).
#ASSERT `s 13(1) there is an implied condition that the goods will correspond with the description` TRUE EQUALS JUST TRUE
#ASSERT `s 13(1) there is an implied condition that the goods will correspond with the description` FALSE EQUALS JUST FALSE
#ASSERT `s 13(1) the implied condition that the goods will correspond with the description is broken` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 13(1) the implied condition that the goods will correspond with the description is broken` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 13(1) the implied condition that the goods will correspond with the description is broken` FALSE FALSE EQUALS JUST FALSE
-- s 13(2).
#ASSERT `s 13(2) it is sufficient that the bulk of the goods corresponds with the sample` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 13(2) it is sufficient that the bulk of the goods corresponds with the sample` TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 13(2) it is sufficient that the bulk of the goods corresponds with the sample` FALSE TRUE FALSE EQUALS NOTHING -- sale by sample only
-- s 13(3).
#ASSERT `s 13(3) the sale is prevented from being a sale by description` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 13(3) the sale is prevented from being a sale by description` TRUE TRUE FALSE EQUALS NOTHING -- another reason is given
#ASSERT `s 13(3) the sale is prevented from being a sale by description` FALSE TRUE TRUE EQUALS NOTHING
-- s 14(1).
#ASSERT `s 14(1) there is an implied condition or warranty about the quality or fitness of the goods` FALSE FALSE FALSE EQUALS JUST FALSE -- private seller, no other provision
#ASSERT `s 14(1) there is an implied condition or warranty about the quality or fitness of the goods` TRUE FALSE FALSE EQUALS NOTHING -- s 14(2) to (4) provides one
#ASSERT `s 14(1) there is an implied condition or warranty about the quality or fitness of the goods` FALSE TRUE FALSE EQUALS NOTHING -- s 15 provides one
#ASSERT `s 14(1) there is an implied condition or warranty about the quality or fitness of the goods` FALSE FALSE TRUE EQUALS NOTHING -- another enactment
-- s 14(2).
#ASSERT `s 14(2) there is an implied condition that the goods supplied are of satisfactory quality` TRUE EQUALS JUST TRUE
#ASSERT `s 14(2) there is an implied condition that the goods supplied are of satisfactory quality` FALSE EQUALS JUST FALSE
-- s 14(2A).
#ASSERT `s 14(2A) the goods are of satisfactory quality` TRUE EQUALS JUST TRUE
#ASSERT `s 14(2A) the goods are of satisfactory quality` FALSE EQUALS JUST FALSE
-- s 14(2) breach.
#ASSERT `s 14(2) the implied condition of satisfactory quality is broken` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 14(2) the implied condition of satisfactory quality is broken` TRUE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 14(2) the implied condition of satisfactory quality is broken` TRUE FALSE TRUE EQUALS JUST FALSE -- s 14(2C): the buyer was told of the defect
#ASSERT `s 14(2) the implied condition of satisfactory quality is broken` FALSE FALSE FALSE EQUALS JUST FALSE -- private seller
-- s 14(2B).
#ASSERT `s 14(2B) the aspect is an aspect of the quality of the goods` `the state and condition of the goods` FALSE EQUALS JUST TRUE -- unconditional: "includes their state and condition"
#ASSERT `s 14(2B) the aspect is an aspect of the quality of the goods` `safety` TRUE EQUALS JUST TRUE
#ASSERT `s 14(2B) the aspect is an aspect of the quality of the goods` `durability` FALSE EQUALS NOTHING -- not an appropriate case
#ASSERT `s 14(2B) the aspect is an aspect of the quality of the goods` `some other aspect` TRUE EQUALS NOTHING -- "includes ... (among others)"
-- s 14(2C).
#ASSERT `s 14(2C) the condition implied by s 14(2) extends to the matter making the quality unsatisfactory` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 14(2C) the condition implied by s 14(2) extends to the matter making the quality unsatisfactory` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 14(2C) the condition implied by s 14(2) extends to the matter making the quality unsatisfactory` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 14(2C) the condition implied by s 14(2) extends to the matter making the quality unsatisfactory` FALSE FALSE FALSE EQUALS JUST TRUE
-- s 14(3).
#ASSERT `s 14(3) there is an implied condition that the goods are reasonably fit for the purpose made known` TRUE TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 14(3) there is an implied condition that the goods are reasonably fit for the purpose made known` TRUE FALSE TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- made known to the credit-broker, instalments
#ASSERT `s 14(3) there is an implied condition that the goods are reasonably fit for the purpose made known` TRUE FALSE TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- instalment case but nothing made known to the credit-broker
#ASSERT `s 14(3) there is an implied condition that the goods are reasonably fit for the purpose made known` TRUE TRUE FALSE FALSE TRUE FALSE EQUALS JUST FALSE -- circumstances show the buyer does not rely
#ASSERT `s 14(3) there is an implied condition that the goods are reasonably fit for the purpose made known` TRUE TRUE FALSE FALSE FALSE TRUE EQUALS JUST FALSE -- unreasonable to rely
#ASSERT `s 14(3) there is an implied condition that the goods are reasonably fit for the purpose made known` FALSE TRUE FALSE FALSE FALSE FALSE EQUALS JUST FALSE -- not a business sale
#ASSERT `s 14(3) the implied condition of reasonable fitness is broken` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 14(3) the implied condition of reasonable fitness is broken` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 14(3) the implied condition of reasonable fitness is broken` FALSE FALSE EQUALS JUST FALSE
-- s 14(4).
#ASSERT `s 14(4) an implied condition or warranty about quality or fitness is annexed by usage` TRUE EQUALS JUST TRUE
#ASSERT `s 14(4) an implied condition or warranty about quality or fitness is annexed by usage` FALSE EQUALS NOTHING
-- s 14(5).
#ASSERT `s 14(5) the sale by the agent is treated as a sale by a principal in the course of a business` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 14(5) the sale by the agent is treated as a sale by a principal in the course of a business` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- principal private and the buyer knows
#ASSERT `s 14(5) the sale by the agent is treated as a sale by a principal in the course of a business` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- principal private and reasonable steps taken
#ASSERT `s 14(5) the sale by the agent is treated as a sale by a principal in the course of a business` TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- principal private, buyer not told: the exception does not apply
#ASSERT `s 14(5) the sale by the agent is treated as a sale by a principal in the course of a business` FALSE FALSE FALSE FALSE EQUALS NOTHING
-- s 15(1) and (2).
#ASSERT `s 15(1) the contract of sale is a contract for sale by sample` TRUE EQUALS JUST TRUE
#ASSERT `s 15(1) the contract of sale is a contract for sale by sample` FALSE EQUALS JUST FALSE
#ASSERT `s 15(2) there are implied conditions as to correspondence with the sample and freedom from defects` TRUE EQUALS JUST TRUE
#ASSERT `s 15(2) there are implied conditions as to correspondence with the sample and freedom from defects` FALSE EQUALS JUST FALSE
#ASSERT `s 15(2)(a) the implied condition that the bulk will correspond with the sample in quality is broken` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 15(2)(a) the implied condition that the bulk will correspond with the sample in quality is broken` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 15(2)(a) the implied condition that the bulk will correspond with the sample in quality is broken` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 15(2)(b) the implied condition that the goods will be free from a defect not apparent on examination of the sample is broken` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 15(2)(b) the implied condition that the goods will be free from a defect not apparent on examination of the sample is broken` TRUE TRUE FALSE EQUALS JUST FALSE -- apparent on examination: outside the condition
#ASSERT `s 15(2)(b) the implied condition that the goods will be free from a defect not apparent on examination of the sample is broken` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 15(2)(b) the implied condition that the goods will be free from a defect not apparent on examination of the sample is broken` FALSE TRUE TRUE EQUALS JUST FALSE
-- s 15A(1), (2).
#ASSERT `s 15A(1) the breach is not treated as a breach of condition but may be treated as a breach of warranty` TRUE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 15A(1) the breach is not treated as a breach of condition but may be treated as a breach of warranty` TRUE TRUE TRUE FALSE EQUALS JUST FALSE -- the buyer deals as consumer
#ASSERT `s 15A(1) the breach is not treated as a breach of condition but may be treated as a breach of warranty` TRUE TRUE FALSE TRUE EQUALS JUST FALSE -- contrary intention
#ASSERT `s 15A(1) the breach is not treated as a breach of condition but may be treated as a breach of warranty` TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- the breach is not slight
#ASSERT `s 15A(1) the breach is not treated as a breach of condition but may be treated as a breach of warranty` FALSE TRUE FALSE FALSE EQUALS JUST FALSE -- no right to reject in the first place
-- s 15A(3).
#ASSERT `s 15A(3) the breach is treated as one that fell within subsection (1)(b)` TRUE EQUALS JUST TRUE
#ASSERT `s 15A(3) the breach is treated as one that fell within subsection (1)(b)` FALSE EQUALS JUST FALSE

-- s 2(4) the rule naming the contract a sale applies
#ASSERT `s 2(4) the rule naming the contract a sale applies` TRUE EQUALS JUST TRUE
#ASSERT `s 2(4) the rule naming the contract a sale applies` FALSE EQUALS JUST FALSE
-- s 2(5) the rule naming the contract an agreement to sell applies
#ASSERT `s 2(5) the rule naming the contract an agreement to sell applies` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 2(5) the rule naming the contract an agreement to sell applies` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 2(5) the rule naming the contract an agreement to sell applies` FALSE FALSE EQUALS JUST FALSE
-- ss 2(4) to (6) a rule naming the stage of the contract applies
#ASSERT `ss 2(4) to (6) a rule naming the stage of the contract applies` TRUE FALSE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `ss 2(4) to (6) a rule naming the stage of the contract applies` FALSE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `ss 2(4) to (6) a rule naming the stage of the contract applies` FALSE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
