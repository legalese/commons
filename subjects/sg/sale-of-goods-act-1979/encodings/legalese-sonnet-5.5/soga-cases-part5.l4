-- Sale of Goods Act 1979 (Singapore).  LAYER 1 TESTS for Part 5 (ss 38 to 48).
-- Expected values are written from the text beside each assertion, before running.
-- Argument lists follow the GIVEN order of the rule called.

IMPORT prelude
IMPORT daydate
IMPORT `soga-nouns`
IMPORT `soga-part5-unpaid-seller`

-- s 38(1): unpaid seller.
#ASSERT `s 38(1) the seller of goods is an unpaid seller` TRUE FALSE FALSE EQUALS JUST TRUE -- price not paid
#ASSERT `s 38(1) the seller of goods is an unpaid seller` FALSE TRUE TRUE EQUALS JUST TRUE -- instrument dishonoured
#ASSERT `s 38(1) the seller of goods is an unpaid seller` FALSE TRUE FALSE EQUALS JUST FALSE -- instrument received, condition fulfilled
#ASSERT `s 38(1) the seller of goods is an unpaid seller` FALSE FALSE TRUE EQUALS JUST FALSE -- no instrument
#ASSERT `s 38(1) the seller of goods is an unpaid seller` FALSE FALSE FALSE EQUALS JUST FALSE -- paid in full
-- s 38(2).
#ASSERT `s 38(2) the person is a seller for the purposes of Part 5` TRUE EQUALS JUST TRUE
#ASSERT `s 38(2) the person is a seller for the purposes of Part 5` FALSE EQUALS NOTHING -- "includes": not closed
-- s 39(1).
#ASSERT `s 39(1)(a) the unpaid seller has by implication of law a lien on the goods or right to retain them for the price` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 39(1)(a) the unpaid seller has by implication of law a lien on the goods or right to retain them for the price` TRUE FALSE FALSE EQUALS JUST FALSE -- not in possession
#ASSERT `s 39(1)(a) the unpaid seller has by implication of law a lien on the goods or right to retain them for the price` FALSE TRUE FALSE EQUALS JUST FALSE -- not unpaid
#ASSERT `s 39(1)(a) the unpaid seller has by implication of law a lien on the goods or right to retain them for the price` TRUE TRUE TRUE EQUALS NOTHING -- another Act
#ASSERT `s 39(1)(b) the unpaid seller has by implication of law a right of stopping the goods in transit` TRUE TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 39(1)(b) the unpaid seller has by implication of law a right of stopping the goods in transit` TRUE FALSE TRUE FALSE EQUALS JUST FALSE -- buyer not insolvent
#ASSERT `s 39(1)(b) the unpaid seller has by implication of law a right of stopping the goods in transit` TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- not parted with possession
#ASSERT `s 39(1)(b) the unpaid seller has by implication of law a right of stopping the goods in transit` FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- not unpaid
#ASSERT `s 39(1)(b) the unpaid seller has by implication of law a right of stopping the goods in transit` TRUE TRUE TRUE TRUE EQUALS NOTHING -- another Act
#ASSERT `s 39(1)(c) the unpaid seller has by implication of law a right of re-sale as limited by this Act` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 39(1)(c) the unpaid seller has by implication of law a right of re-sale as limited by this Act` FALSE FALSE EQUALS NOTHING
#ASSERT `s 39(1)(c) the unpaid seller has by implication of law a right of re-sale as limited by this Act` TRUE TRUE EQUALS NOTHING
-- s 39(2).
#ASSERT `s 39(2) the unpaid seller has a right of withholding delivery similar to and co-extensive with his rights of lien or retention and stoppage in transit` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 39(2) the unpaid seller has a right of withholding delivery similar to and co-extensive with his rights of lien or retention and stoppage in transit` TRUE TRUE EQUALS JUST FALSE -- property has passed
#ASSERT `s 39(2) the unpaid seller has a right of withholding delivery similar to and co-extensive with his rights of lien or retention and stoppage in transit` FALSE FALSE EQUALS JUST FALSE
-- s 41(1): unpaid, in possession, and one of three cases.
#ASSERT `s 41(1) the unpaid seller is entitled to retain possession of the goods until payment or tender of the price` TRUE TRUE TRUE FALSE FALSE EQUALS JUST TRUE -- no stipulation as to credit
#ASSERT `s 41(1) the unpaid seller is entitled to retain possession of the goods until payment or tender of the price` TRUE TRUE FALSE TRUE FALSE EQUALS JUST TRUE -- credit expired
#ASSERT `s 41(1) the unpaid seller is entitled to retain possession of the goods until payment or tender of the price` TRUE TRUE FALSE FALSE TRUE EQUALS JUST TRUE -- buyer insolvent
#ASSERT `s 41(1) the unpaid seller is entitled to retain possession of the goods until payment or tender of the price` TRUE TRUE FALSE FALSE FALSE EQUALS JUST FALSE -- on credit, not expired, buyer solvent
#ASSERT `s 41(1) the unpaid seller is entitled to retain possession of the goods until payment or tender of the price` TRUE FALSE TRUE FALSE FALSE EQUALS JUST FALSE -- not in possession
#ASSERT `s 41(1) the unpaid seller is entitled to retain possession of the goods until payment or tender of the price` FALSE TRUE TRUE FALSE FALSE EQUALS JUST FALSE -- not unpaid
-- s 41(2).
#ASSERT `s 41(2) the seller may exercise his lien or right of retention although he is in possession as agent or bailee or custodier for the buyer` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 41(2) the seller may exercise his lien or right of retention although he is in possession as agent or bailee or custodier for the buyer` TRUE FALSE EQUALS NOTHING
#ASSERT `s 41(2) the seller may exercise his lien or right of retention although he is in possession as agent or bailee or custodier for the buyer` FALSE TRUE EQUALS NOTHING
-- s 42.
#ASSERT `s 42 the unpaid seller may exercise his lien or right of retention on the remainder` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 42 the unpaid seller may exercise his lien or right of retention on the remainder` TRUE TRUE EQUALS JUST FALSE -- waived
#ASSERT `s 42 the unpaid seller may exercise his lien or right of retention on the remainder` FALSE FALSE EQUALS JUST FALSE -- no part delivery
-- s 43(1).
#ASSERT `s 43(1) the unpaid seller loses his lien or right of retention` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 43(1) the unpaid seller loses his lien or right of retention` FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 43(1) the unpaid seller loses his lien or right of retention` FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 43(1) the unpaid seller loses his lien or right of retention` FALSE FALSE FALSE EQUALS NOTHING
-- s 43(2).
#ASSERT `s 43(2) the unpaid seller loses his lien or right of retention by reason only of obtaining judgment or decree for the price` TRUE EQUALS JUST FALSE
#ASSERT `s 43(2) the unpaid seller loses his lien or right of retention by reason only of obtaining judgment or decree for the price` FALSE EQUALS NOTHING
-- s 44.
#ASSERT `s 44 the unpaid seller has the right of stopping the goods in transit` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 44 the unpaid seller has the right of stopping the goods in transit` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 44 the unpaid seller has the right of stopping the goods in transit` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 44 the unpaid seller may resume possession of the goods and retain them until payment or tender of the price` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 44 the unpaid seller may resume possession of the goods and retain them until payment or tender of the price` TRUE FALSE EQUALS JUST FALSE -- no longer in transit
#ASSERT `s 44 the unpaid seller may resume possession of the goods and retain them until payment or tender of the price` FALSE TRUE EQUALS JUST FALSE -- no right
-- s 45(1).
#ASSERT `s 45(1) the goods are deemed to be in course of transit` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 45(1) the goods are deemed to be in course of transit` TRUE TRUE EQUALS JUST FALSE -- buyer has taken delivery
#ASSERT `s 45(1) the goods are deemed to be in course of transit` FALSE FALSE EQUALS JUST FALSE -- not yet delivered to a carrier
-- s 45(2), (3), (4), (5), (6), (7).
#ASSERT `s 45(2) the transit is at an end` TRUE EQUALS JUST TRUE
#ASSERT `s 45(2) the transit is at an end` FALSE EQUALS JUST FALSE
#ASSERT `s 45(3) the transit is at an end` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 45(3) the transit is at an end` FALSE TRUE TRUE EQUALS JUST FALSE -- not yet arrived
#ASSERT `s 45(3) the transit is at an end` TRUE FALSE TRUE EQUALS JUST FALSE -- no acknowledgment
#ASSERT `s 45(3) the transit is at an end` TRUE TRUE FALSE EQUALS JUST FALSE -- not in possession as bailee for the buyer
#ASSERT `s 45(4) the transit is at an end` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 45(4) the transit is at an end` TRUE FALSE EQUALS NOTHING
#ASSERT `s 45(4) the transit is at an end` FALSE TRUE EQUALS NOTHING
#ASSERT `s 45(5) the goods are in the possession of the master as a carrier and not as agent to the buyer` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 45(5) the goods are in the possession of the master as a carrier and not as agent to the buyer` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 45(5) the goods are in the possession of the master as a carrier and not as agent to the buyer` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 45(5) the goods are in the possession of the master as a carrier and not as agent to the buyer` FALSE (JUST TRUE) EQUALS NOTHING -- no chartered ship
#ASSERT `s 45(6) the transit is deemed to be at an end` TRUE EQUALS JUST TRUE
#ASSERT `s 45(6) the transit is deemed to be at an end` FALSE EQUALS JUST FALSE
#ASSERT `s 45(7) the remainder of the goods may be stopped in transit` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 45(7) the remainder of the goods may be stopped in transit` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 45(7) the remainder of the goods may be stopped in transit` FALSE FALSE EQUALS JUST FALSE
-- ss 45(1) to (7) gathered (E1 option B).
#ASSERT `ss 45(1) to (7) the goods are in course of transit` (JUST TRUE) NOTHING NOTHING NOTHING NOTHING EQUALS JUST TRUE
#ASSERT `ss 45(1) to (7) the goods are in course of transit` (JUST FALSE) NOTHING NOTHING NOTHING NOTHING EQUALS JUST FALSE
#ASSERT `ss 45(1) to (7) the goods are in course of transit` (JUST TRUE) (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST FALSE -- s 45(2): transit at an end
#ASSERT `ss 45(1) to (7) the goods are in course of transit` (JUST TRUE) NOTHING (JUST TRUE) NOTHING NOTHING EQUALS JUST FALSE -- s 45(3)
#ASSERT `ss 45(1) to (7) the goods are in course of transit` (JUST TRUE) NOTHING NOTHING NOTHING (JUST TRUE) EQUALS JUST FALSE -- s 45(6)
#ASSERT `ss 45(1) to (7) the goods are in course of transit` (JUST TRUE) (JUST TRUE) NOTHING (JUST FALSE) NOTHING EQUALS JUST TRUE -- s 45(4): the transit is not at an end although the buyer rejected
#ASSERT `ss 45(1) to (7) the goods are in course of transit` NOTHING NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING
-- s 46(1).
#ASSERT `s 46(1) the unpaid seller may exercise his right of stoppage in transit by this method` `taking actual possession of the goods` EQUALS JUST TRUE
#ASSERT `s 46(1) the unpaid seller may exercise his right of stoppage in transit by this method` `giving notice of his claim to the carrier or other bailee or custodier in whose possession the goods are` EQUALS JUST TRUE
#ASSERT `s 46(1) the unpaid seller may exercise his right of stoppage in transit by this method` `some other method` EQUALS NOTHING
-- s 46(2).
#ASSERT `s 46(2) the notice may be given to this person` `the person in actual possession of the goods` EQUALS JUST TRUE
#ASSERT `s 46(2) the notice may be given to this person` `the principal of the person in actual possession of the goods` EQUALS JUST TRUE
#ASSERT `s 46(2) the notice may be given to this person` `some other person` EQUALS NOTHING
-- s 46(3).
#ASSERT `s 46(3) the notice is effective` TRUE FALSE EQUALS JUST FALSE -- too late for the principal to communicate in time
#ASSERT `s 46(3) the notice is effective` TRUE TRUE EQUALS NOTHING -- timely: the subsection does not say it is effective
#ASSERT `s 46(3) the notice is effective` FALSE FALSE EQUALS NOTHING -- given to the person in possession
-- s 46(4).
#ASSERT `s 46(4) the carrier or other bailee or custodier must re-deliver the goods to, or according to the directions of, the seller` TRUE EQUALS JUST TRUE
#ASSERT `s 46(4) the carrier or other bailee or custodier must re-deliver the goods to, or according to the directions of, the seller` FALSE EQUALS JUST FALSE
#ASSERT `s 46(4) the party who must bear the expenses of the re-delivery` TRUE EQUALS JUST Seller
#ASSERT `s 46(4) the party who must bear the expenses of the re-delivery` FALSE EQUALS NOTHING
-- s 47(1).
#ASSERT `s 47(1) the unpaid seller's right of lien or retention or stoppage in transit is affected by the buyer's sale or other disposition` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 47(1) the unpaid seller's right of lien or retention or stoppage in transit is affected by the buyer's sale or other disposition` TRUE TRUE EQUALS NOTHING -- the seller assented
#ASSERT `s 47(1) the unpaid seller's right of lien or retention or stoppage in transit is affected by the buyer's sale or other disposition` FALSE FALSE EQUALS NOTHING -- no disposition
-- s 47(2).
#ASSERT `s 47(2) the unpaid seller's right of lien or retention or stoppage in transit is defeated` TRUE TRUE `a sale by the transferee` EQUALS JUST TRUE
#ASSERT `s 47(2) the unpaid seller's right of lien or retention or stoppage in transit is defeated` TRUE TRUE `a pledge or other disposition for value` EQUALS JUST FALSE
#ASSERT `s 47(2) the unpaid seller's right of lien or retention or stoppage in transit is defeated` TRUE TRUE `some other transfer` EQUALS NOTHING
#ASSERT `s 47(2) the unpaid seller's right of lien or retention or stoppage in transit is defeated` TRUE FALSE `a sale by the transferee` EQUALS JUST FALSE -- the sub-buyer is not in good faith for value
#ASSERT `s 47(2) the unpaid seller's right of lien or retention or stoppage in transit is defeated` FALSE TRUE `a sale by the transferee` EQUALS JUST FALSE -- the document was not lawfully transferred as buyer or owner
#ASSERT `s 47(2)(b) the unpaid seller's right can only be exercised subject to the rights of the transferee` TRUE TRUE `a pledge or other disposition for value` EQUALS JUST TRUE
#ASSERT `s 47(2)(b) the unpaid seller's right can only be exercised subject to the rights of the transferee` TRUE TRUE `a sale by the transferee` EQUALS JUST FALSE
#ASSERT `s 47(2)(b) the unpaid seller's right can only be exercised subject to the rights of the transferee` TRUE FALSE `a pledge or other disposition for value` EQUALS JUST FALSE
#ASSERT `s 47(2)(b) the unpaid seller's right can only be exercised subject to the rights of the transferee` FALSE TRUE `a pledge or other disposition for value` EQUALS JUST FALSE
-- s 48(1).
#ASSERT `s 48(1) the contract of sale is rescinded` TRUE EQUALS JUST FALSE
#ASSERT `s 48(1) the contract of sale is rescinded` FALSE EQUALS NOTHING
-- s 48(2).
#ASSERT `s 48(2) the buyer on the re-sale acquires a good title to the goods as against the original buyer` TRUE EQUALS JUST TRUE
#ASSERT `s 48(2) the buyer on the re-sale acquires a good title to the goods as against the original buyer` FALSE EQUALS JUST FALSE
-- s 48(3).
#ASSERT `s 48(3) the unpaid seller may re-sell the goods and recover from the original buyer damages for any loss occasioned by his breach of contract` TRUE FALSE FALSE EQUALS JUST FALSE -- perishable but the buyer did not fail to pay in time (fork F11: non-payment governs both limbs)
#ASSERT `s 48(3) the unpaid seller may re-sell the goods and recover from the original buyer damages for any loss occasioned by his breach of contract` FALSE TRUE TRUE EQUALS JUST TRUE -- notice and no payment within a reasonable time
#ASSERT `s 48(3) the unpaid seller may re-sell the goods and recover from the original buyer damages for any loss occasioned by his breach of contract` FALSE TRUE FALSE EQUALS JUST FALSE -- notice but the buyer paid in time
#ASSERT `s 48(3) the unpaid seller may re-sell the goods and recover from the original buyer damages for any loss occasioned by his breach of contract` FALSE FALSE TRUE EQUALS JUST FALSE -- no notice
-- s 48(4).
#ASSERT `s 48(4) the original contract of sale is rescinded` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 48(4) the original contract of sale is rescinded` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 48(4) the original contract of sale is rescinded` FALSE TRUE EQUALS JUST FALSE

-- s 48(3) fork F11: non-payment governs both limbs
#ASSERT `s 48(3) the unpaid seller may re-sell the goods and recover from the original buyer damages for any loss occasioned by his breach of contract` TRUE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 48(3) the unpaid seller may re-sell the goods and recover from the original buyer damages for any loss occasioned by his breach of contract` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 48(3) the unpaid seller may re-sell the goods and recover from the original buyer damages for any loss occasioned by his breach of contract` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 48(3) the unpaid seller may re-sell the goods and recover from the original buyer damages for any loss occasioned by his breach of contract` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 48(3) the unpaid seller may re-sell the goods and recover from the original buyer damages for any loss occasioned by his breach of contract` FALSE FALSE TRUE EQUALS JUST FALSE

-- s 46(4) expenses twin
#ASSERT `s 46(4) the rule placing the expenses of re-delivery on the seller applies` TRUE EQUALS JUST TRUE
#ASSERT `s 46(4) the rule placing the expenses of re-delivery on the seller applies` FALSE EQUALS JUST FALSE

-- s 48(4) damages limb (gap found on review)
#ASSERT `s 48(4) the rescission is without prejudice to any claim the seller may have for damages` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 48(4) the rescission is without prejudice to any claim the seller may have for damages` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 48(4) the rescission is without prejudice to any claim the seller may have for damages` FALSE TRUE EQUALS JUST FALSE

-- assertions written: 120
