-- Sale of Goods Act 1979 (Singapore).  LAYER 1 TESTS for Part 6 (ss 49 to 54).
-- Expected values are written from the text beside each assertion, before running.

IMPORT prelude
IMPORT daydate
IMPORT `soga-nouns`
IMPORT `soga-part6-actions`

-- s 49(1).
#ASSERT `s 49(1) the seller may maintain an action against the buyer for the price of the goods` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 49(1) the seller may maintain an action against the buyer for the price of the goods` TRUE FALSE EQUALS JUST FALSE -- buyer not in wrongful default
#ASSERT `s 49(1) the seller may maintain an action against the buyer for the price of the goods` FALSE TRUE EQUALS JUST FALSE -- property has not passed (see s 49(2))
-- s 49(2).
#ASSERT `s 49(2) the seller may maintain an action for the price although the property in the goods has not passed and the goods have not been appropriated to the contract` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 49(2) the seller may maintain an action for the price although the property in the goods has not passed and the goods have not been appropriated to the contract` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 49(2) the seller may maintain an action for the price although the property in the goods has not passed and the goods have not been appropriated to the contract` TRUE FALSE EQUALS JUST FALSE
-- ss 49(1) and (2) gathered.
#ASSERT `ss 49(1) and (2) the seller may maintain an action against the buyer for the price` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `ss 49(1) and (2) the seller may maintain an action against the buyer for the price` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `ss 49(1) and (2) the seller may maintain an action against the buyer for the price` NOTHING NOTHING EQUALS NOTHING
-- s 50(1).
#ASSERT `s 50(1) the seller may maintain an action against the buyer for damages for non-acceptance` TRUE EQUALS JUST TRUE
#ASSERT `s 50(1) the seller may maintain an action against the buyer for damages for non-acceptance` FALSE EQUALS JUST FALSE
-- s 50(2): estimated loss of 120.
#ASSERT `s 50(2) the measure of damages for non-acceptance` TRUE 120 EQUALS JUST 120
#ASSERT `s 50(2) the measure of damages for non-acceptance` FALSE 120 EQUALS NOTHING
-- s 50(3): contract price 1000; market price 900 gives 100.
#ASSERT `s 50(3) the measure of damages for non-acceptance where there is an available market` TRUE TRUE FALSE 1000 900 EQUALS JUST 100
#ASSERT `s 50(3) the measure of damages for non-acceptance where there is an available market` TRUE TRUE FALSE 1000 1000 EQUALS JUST 0 -- no difference
#ASSERT `s 50(3) the measure of damages for non-acceptance where there is an available market` TRUE TRUE FALSE 1000 1100 EQUALS NOTHING -- market above contract price: the text is silent
#ASSERT `s 50(3) the measure of damages for non-acceptance where there is an available market` TRUE TRUE TRUE 1000 900 EQUALS NOTHING -- prima facie only
#ASSERT `s 50(3) the measure of damages for non-acceptance where there is an available market` TRUE FALSE FALSE 1000 900 EQUALS NOTHING -- no available market
#ASSERT `s 50(3) the measure of damages for non-acceptance where there is an available market` FALSE TRUE FALSE 1000 900 EQUALS NOTHING -- no wrongful neglect or refusal
-- s 51(1).
#ASSERT `s 51(1) the buyer may maintain an action against the seller for damages for non-delivery` TRUE EQUALS JUST TRUE
#ASSERT `s 51(1) the buyer may maintain an action against the seller for damages for non-delivery` FALSE EQUALS JUST FALSE
-- s 51(2).
#ASSERT `s 51(2) the measure of damages for non-delivery` TRUE 75 EQUALS JUST 75
#ASSERT `s 51(2) the measure of damages for non-delivery` FALSE 75 EQUALS NOTHING
-- s 51(3): contract price 1000; market price 1150 gives 150.
#ASSERT `s 51(3) the measure of damages for non-delivery where there is an available market` TRUE TRUE FALSE 1000 1150 EQUALS JUST 150
#ASSERT `s 51(3) the measure of damages for non-delivery where there is an available market` TRUE TRUE FALSE 1000 1000 EQUALS JUST 0
#ASSERT `s 51(3) the measure of damages for non-delivery where there is an available market` TRUE TRUE FALSE 1000 950 EQUALS NOTHING -- market below contract price: the text is silent
#ASSERT `s 51(3) the measure of damages for non-delivery where there is an available market` TRUE TRUE TRUE 1000 1150 EQUALS NOTHING
#ASSERT `s 51(3) the measure of damages for non-delivery where there is an available market` TRUE FALSE FALSE 1000 1150 EQUALS NOTHING
#ASSERT `s 51(3) the measure of damages for non-delivery where there is an available market` FALSE TRUE FALSE 1000 1150 EQUALS NOTHING
-- s 52.
#ASSERT `s 52(1) the court has power to direct that the contract shall be performed specifically` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 52(1) the court has power to direct that the contract shall be performed specifically` FALSE TRUE EQUALS NOTHING -- not specific or ascertained goods
#ASSERT `s 52(1) the court has power to direct that the contract shall be performed specifically` TRUE FALSE EQUALS JUST FALSE -- no application
#ASSERT `s 52(2) the claimant's application may be made` TRUE EQUALS JUST TRUE
#ASSERT `s 52(2) the claimant's application may be made` FALSE EQUALS JUST FALSE
#ASSERT `s 52(3) the judgment or decree may take this form` `unconditional` EQUALS JUST TRUE
#ASSERT `s 52(3) the judgment or decree may take this form` `on such terms and conditions as to damages, payment of the price and otherwise as seem just to the court` EQUALS JUST TRUE
#ASSERT `s 52(3) the judgment or decree may take this form` `some other form` EQUALS NOTHING
-- s 53(1).
#ASSERT `s 53(1) the buyer is entitled to reject the goods by reason only of the breach of warranty` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 53(1) the buyer is entitled to reject the goods by reason only of the breach of warranty` FALSE TRUE EQUALS JUST FALSE -- elected to treat a breach of condition as a breach of warranty
#ASSERT `s 53(1) the buyer is entitled to reject the goods by reason only of the breach of warranty` FALSE FALSE EQUALS NOTHING
#ASSERT `s 53(1)(a) the buyer may set up against the seller the breach of warranty in diminution or extinction of the price` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 53(1)(a) the buyer may set up against the seller the breach of warranty in diminution or extinction of the price` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 53(1)(a) the buyer may set up against the seller the breach of warranty in diminution or extinction of the price` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 53(1)(b) the buyer may maintain an action against the seller for damages for the breach of warranty` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 53(1)(b) the buyer may maintain an action against the seller for damages for the breach of warranty` FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 53(1)(b) the buyer may maintain an action against the seller for damages for the breach of warranty` FALSE FALSE EQUALS JUST FALSE
-- s 53(2).
#ASSERT `s 53(2) the measure of damages for breach of warranty` TRUE 60 EQUALS JUST 60
#ASSERT `s 53(2) the measure of damages for breach of warranty` FALSE 60 EQUALS NOTHING
-- s 53(3): value as delivered 700, value if the warranty had been fulfilled 1000: loss 300.
#ASSERT `s 53(3) the loss for breach of warranty of quality` TRUE FALSE 700 1000 EQUALS JUST 300
#ASSERT `s 53(3) the loss for breach of warranty of quality` TRUE FALSE 1000 1000 EQUALS JUST 0
#ASSERT `s 53(3) the loss for breach of warranty of quality` TRUE FALSE 1100 1000 EQUALS NOTHING
#ASSERT `s 53(3) the loss for breach of warranty of quality` TRUE TRUE 700 1000 EQUALS NOTHING -- prima facie only
#ASSERT `s 53(3) the loss for breach of warranty of quality` FALSE FALSE 700 1000 EQUALS NOTHING -- not a warranty of quality
-- s 53(4).
#ASSERT `s 53(4) setting up the breach of warranty in diminution or extinction of the price prevents the buyer from maintaining an action for the same breach` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 53(4) setting up the breach of warranty in diminution or extinction of the price prevents the buyer from maintaining an action for the same breach` TRUE FALSE EQUALS NOTHING -- no further damage
#ASSERT `s 53(4) setting up the breach of warranty in diminution or extinction of the price prevents the buyer from maintaining an action for the same breach` FALSE TRUE EQUALS NOTHING
-- s 54.
#ASSERT `s 54 this Act affects the matter` `the right of the buyer or the seller to recover interest in a case where by law interest may be recoverable` EQUALS JUST FALSE
#ASSERT `s 54 this Act affects the matter` `the right of the buyer or the seller to recover special damages in a case where by law special damages may be recoverable` EQUALS JUST FALSE
#ASSERT `s 54 this Act affects the matter` `the right of the buyer or the seller to recover money paid where the consideration for the payment of it has failed` EQUALS JUST FALSE
#ASSERT `s 54 this Act affects the matter` `some other matter under section 54` EQUALS NOTHING

-- s 50(3) the market-price rule for non-acceptance applies
#ASSERT `s 50(3) the market-price rule for non-acceptance applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 50(3) the market-price rule for non-acceptance applies` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 50(3) the market-price rule for non-acceptance applies` FALSE TRUE EQUALS JUST FALSE
-- s 51(3) the market-price rule for non-delivery applies
#ASSERT `s 51(3) the market-price rule for non-delivery applies` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 51(3) the market-price rule for non-delivery applies` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 51(3) the market-price rule for non-delivery applies` FALSE TRUE EQUALS JUST FALSE
-- s 53(3) the rule for breach of warranty of quality applies
#ASSERT `s 53(3) the rule for breach of warranty of quality applies` TRUE EQUALS JUST TRUE
#ASSERT `s 53(3) the rule for breach of warranty of quality applies` FALSE EQUALS JUST FALSE
#ASSERT `s 52(1) the court has power to direct that the contract shall be performed specifically` TRUE FALSE EQUALS JUST FALSE -- the claimant has not applied
#ASSERT `s 52(1) the court has power to direct that the contract shall be performed specifically` FALSE TRUE EQUALS NOTHING -- not an action for breach of contract to deliver specific or ascertained goods: a scope limit, ruled (c)

-- assertions written: 70
