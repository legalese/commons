#ASSERT `s 26 the person is a mercantile agent for the purposes of ss 24 and 25` TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 26 the person is a mercantile agent for the purposes of ss 24 and 25` FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 26 the person is a mercantile agent for the purposes of ss 24 and 25` FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 26 the person is a mercantile agent for the purposes of ss 24 and 25` FALSE FALSE FALSE TRUE EQUALS JUST TRUE
#ASSERT `s 26 the person is a mercantile agent for the purposes of ss 24 and 25` FALSE FALSE FALSE FALSE EQUALS JUST FALSE

