#ASSERT `s 35(7) the unit is a commercial unit` TRUE EQUALS JUST TRUE
#ASSERT `s 35(7) the unit is a commercial unit` FALSE EQUALS JUST FALSE
#ASSERT `s 35(7) the buyer is deemed to have accepted all the goods making the unit` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 35(7) the buyer is deemed to have accepted all the goods making the unit` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 35(7) the buyer is deemed to have accepted all the goods making the unit` FALSE TRUE EQUALS JUST FALSE
-- ss 35(1) to (7) gathered.
#ASSERT `ss 35(1) to (7) the buyer is deemed to have accepted the goods` (JUST TRUE) NOTHING NOTHING NOTHING EQUALS JUST TRUE -- s 35(1) route, nothing blocks it
#ASSERT `ss 35(1) to (7) the buyer is deemed to have accepted the goods` (JUST TRUE) (JUST FALSE) NOTHING NOTHING EQUALS JUST FALSE -- s 35(2): no acceptance under (1) before a reasonable opportunity
#ASSERT `ss 35(1) to (7) the buyer is deemed to have accepted the goods` (JUST TRUE) (JUST FALSE) (JUST TRUE) NOTHING EQUALS JUST TRUE -- but s 35(4) still deems acceptance after a reasonable time
#ASSERT `ss 35(1) to (7) the buyer is deemed to have accepted the goods` NOTHING NOTHING NOTHING (JUST TRUE) EQUALS JUST TRUE -- s 35(7) route
#ASSERT `ss 35(1) to (7) the buyer is deemed to have accepted the goods` NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING
