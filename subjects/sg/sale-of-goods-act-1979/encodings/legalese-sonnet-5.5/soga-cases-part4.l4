#ASSERT `s 35(1) the buyer is deemed to have accepted the goods under subsection (1)` TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 35(1) the buyer is deemed to have accepted the goods under subsection (1)` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 35(1) the buyer is deemed to have accepted the goods under subsection (1)` FALSE TRUE FALSE EQUALS NOTHING -- delivered but no inconsistent act
#ASSERT `s 35(1) the buyer is deemed to have accepted the goods under subsection (1)` FALSE FALSE TRUE EQUALS NOTHING -- an act inconsistent with ownership but no delivery
