#ASSERT `s 35(2) the buyer is deemed to have accepted the goods under subsection (1)` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 35(2) the buyer is deemed to have accepted the goods under subsection (1)` TRUE FALSE TRUE EQUALS NOTHING -- he has had the opportunity
#ASSERT `s 35(2) the buyer is deemed to have accepted the goods under subsection (1)` TRUE TRUE FALSE EQUALS NOTHING -- previously examined
#ASSERT `s 35(2) the buyer is deemed to have accepted the goods under subsection (1)` FALSE FALSE FALSE EQUALS NOTHING
