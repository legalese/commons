#ASSERT `s 34 the seller is bound to afford the buyer a reasonable opportunity of examining the goods` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 34 the seller is bound to afford the buyer a reasonable opportunity of examining the goods` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 34 the seller is bound to afford the buyer a reasonable opportunity of examining the goods` FALSE TRUE FALSE EQUALS JUST FALSE -- no request
#ASSERT `s 34 the seller is bound to afford the buyer a reasonable opportunity of examining the goods` FALSE FALSE TRUE EQUALS JUST FALSE -- no tender
