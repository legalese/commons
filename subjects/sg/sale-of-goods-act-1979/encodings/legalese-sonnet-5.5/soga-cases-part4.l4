-- Sale of Goods Act 1979 (Singapore).  LAYER 1 TESTS for Part 4 (ss 27 to 37).
-- Expected values are written from the text beside each assertion, before running.
-- Argument lists follow the GIVEN order of the rule called.

IMPORT prelude
IMPORT daydate
IMPORT `soga-nouns`
IMPORT `soga-part4-performance`

-- s 27.
#ASSERT `s 27 the seller has performed his duty to deliver the goods in accordance with the terms of the contract` TRUE EQUALS JUST TRUE
#ASSERT `s 27 the seller has performed his duty to deliver the goods in accordance with the terms of the contract` FALSE EQUALS NOTHING
#ASSERT `s 27 the buyer has performed his duty to accept and pay for the goods in accordance with the terms of the contract` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 27 the buyer has performed his duty to accept and pay for the goods in accordance with the terms of the contract` TRUE FALSE EQUALS NOTHING -- accepted but not paid
#ASSERT `s 27 the buyer has performed his duty to accept and pay for the goods in accordance with the terms of the contract` FALSE TRUE EQUALS NOTHING -- paid but not accepted
-- s 28.
#ASSERT `s 28 delivery of the goods and payment of the price are concurrent conditions` FALSE EQUALS JUST TRUE
#ASSERT `s 28 delivery of the goods and payment of the price are concurrent conditions` TRUE EQUALS JUST FALSE
#ASSERT `s 28 the seller must be ready and willing to give possession of the goods to the buyer in exchange for the price` FALSE EQUALS JUST TRUE
#ASSERT `s 28 the seller must be ready and willing to give possession of the goods to the buyer in exchange for the price` TRUE EQUALS JUST FALSE
#ASSERT `s 28 the buyer must be ready and willing to pay the price in exchange for possession of the goods` FALSE EQUALS JUST TRUE
#ASSERT `s 28 the buyer must be ready and willing to pay the price in exchange for possession of the goods` TRUE EQUALS JUST FALSE
-- s 29(1).
#ASSERT `s 29(1) whether the buyer is to take possession of the goods or the seller is to send them` (JUST `the buyer is to take possession of the goods`) EQUALS JUST `the buyer is to take possession of the goods`
#ASSERT `s 29(1) whether the buyer is to take possession of the goods or the seller is to send them` (JUST `the seller is to send the goods to the buyer`) EQUALS JUST `the seller is to send the goods to the buyer`
#ASSERT `s 29(1) whether the buyer is to take possession of the goods or the seller is to send them` NOTHING EQUALS NOTHING
-- s 29(2): the place of delivery, apart from contract.
#ASSERT `s 29(2) the place of delivery` TRUE TRUE FALSE FALSE EQUALS NOTHING -- the contract fixes it
#ASSERT `s 29(2) the place of delivery` FALSE TRUE FALSE FALSE EQUALS JUST `the seller's place of business`
#ASSERT `s 29(2) the place of delivery` FALSE FALSE FALSE FALSE EQUALS JUST `the seller's residence` -- no place of business
#ASSERT `s 29(2) the place of delivery` FALSE TRUE TRUE TRUE EQUALS JUST `the place where the specific goods were, to the knowledge of the parties, when the contract was made`
#ASSERT `s 29(2) the place of delivery` FALSE TRUE TRUE FALSE EQUALS JUST `the seller's place of business` -- specific goods but not known to be elsewhere
#ASSERT `s 29(2) the place of delivery` FALSE TRUE FALSE TRUE EQUALS JUST `the seller's place of business` -- not specific goods
-- s 29(3).
#ASSERT `s 29(3) the seller is bound to send the goods within a reasonable time` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 29(3) the seller is bound to send the goods within a reasonable time` TRUE TRUE EQUALS JUST FALSE -- a time is fixed
#ASSERT `s 29(3) the seller is bound to send the goods within a reasonable time` FALSE FALSE EQUALS JUST FALSE
-- s 29(4).
#ASSERT `s 29(4) there is delivery by the seller to the buyer` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 29(4) there is delivery by the seller to the buyer` TRUE TRUE EQUALS NOTHING
#ASSERT `s 29(4) there is delivery by the seller to the buyer` FALSE FALSE EQUALS NOTHING
-- s 29(4), the bar (ruled 2026-11-05): JUST TRUE until the third person acknowledges, JUST FALSE from then on and where the goods were not with a third person.
#ASSERT `s 29(4) delivery is not yet possible` TRUE FALSE EQUALS JUST TRUE -- the goods are with a third person who has not acknowledged
#ASSERT `s 29(4) delivery is not yet possible` TRUE TRUE EQUALS JUST FALSE -- the third person has acknowledged: the bar is spent
#ASSERT `s 29(4) delivery is not yet possible` FALSE FALSE EQUALS JUST FALSE -- the goods were not with a third person: the "where" is unmet, no bar
#ASSERT `s 29(4) delivery is not yet possible` FALSE TRUE EQUALS JUST FALSE -- the goods were not with a third person (an acknowledgment is beside the point)
#ASSERT `s 29(4) section 29 affects the operation of the issue or transfer of a document of title to goods` TRUE EQUALS JUST FALSE
#ASSERT `s 29(4) section 29 affects the operation of the issue or transfer of a document of title to goods` FALSE EQUALS NOTHING
-- s 29(5).
#ASSERT `s 29(5) the demand or tender of delivery may be treated as ineffectual` FALSE EQUALS JUST TRUE -- not at a reasonable hour
#ASSERT `s 29(5) the demand or tender of delivery may be treated as ineffectual` TRUE EQUALS JUST FALSE
-- s 29(6).
#ASSERT `s 29(6) the party who must bear the expenses of putting the goods into a deliverable state` FALSE EQUALS JUST Seller
#ASSERT `s 29(6) the party who must bear the expenses of putting the goods into a deliverable state` TRUE EQUALS NOTHING
-- s 30(1).
#ASSERT `s 30(1) the buyer may reject the goods delivered` TRUE EQUALS JUST TRUE
#ASSERT `s 30(1) the buyer may reject the goods delivered` FALSE EQUALS JUST FALSE
#ASSERT `s 30(1) the amount the buyer must pay for the goods delivered and accepted` TRUE TRUE 8 5 EQUALS JUST 40 -- 8 units at the contract rate of 5
#ASSERT `s 30(1) the amount the buyer must pay for the goods delivered and accepted` TRUE FALSE 8 5 EQUALS NOTHING -- he rejects them
#ASSERT `s 30(1) the amount the buyer must pay for the goods delivered and accepted` FALSE TRUE 8 5 EQUALS NOTHING
-- s 30(2).
#ASSERT `s 30(2) the buyer may accept the goods included in the contract and reject the rest` TRUE EQUALS JUST TRUE
#ASSERT `s 30(2) the buyer may accept the goods included in the contract and reject the rest` FALSE EQUALS JUST FALSE
#ASSERT `s 30(2) the buyer may reject the whole` TRUE EQUALS JUST TRUE
#ASSERT `s 30(2) the buyer may reject the whole` FALSE EQUALS JUST FALSE
-- s 30(2A).
#ASSERT `s 30(2A) the buyer may reject the goods under subsection (1) or reject the whole under subsection (2)` FALSE TRUE EQUALS JUST FALSE -- not a consumer, slight shortfall
#ASSERT `s 30(2A) the buyer may reject the goods under subsection (1) or reject the whole under subsection (2)` TRUE TRUE EQUALS NOTHING -- a consumer
#ASSERT `s 30(2A) the buyer may reject the goods under subsection (1) or reject the whole under subsection (2)` FALSE FALSE EQUALS NOTHING -- not slight
-- s 30(2B).
#ASSERT `s 30(2B) the shortfall or excess is treated as one that fell within subsection (2A)` TRUE EQUALS JUST TRUE
#ASSERT `s 30(2B) the shortfall or excess is treated as one that fell within subsection (2A)` FALSE EQUALS JUST FALSE
-- s 30(3).
#ASSERT `s 30(3) the amount the buyer must pay for the whole of the goods delivered and accepted` TRUE TRUE 12 5 EQUALS JUST 60 -- the whole 12 units at 5
#ASSERT `s 30(3) the amount the buyer must pay for the whole of the goods delivered and accepted` TRUE FALSE 12 5 EQUALS NOTHING
#ASSERT `s 30(3) the amount the buyer must pay for the whole of the goods delivered and accepted` FALSE TRUE 12 5 EQUALS NOTHING
-- s 30(4).
#ASSERT `s 30(4) section 30 gives way to a usage of trade, special agreement or course of dealing` TRUE EQUALS JUST TRUE
#ASSERT `s 30(4) section 30 gives way to a usage of trade, special agreement or course of dealing` FALSE EQUALS NOTHING
-- s 31(1).
#ASSERT `s 31(1) the buyer is bound to accept delivery of the goods by instalments` FALSE EQUALS JUST FALSE
#ASSERT `s 31(1) the buyer is bound to accept delivery of the goods by instalments` TRUE EQUALS NOTHING
-- s 31(2).
#ASSERT `s 31(2) the breach of contract is a repudiation of the whole contract or a severable breach` TRUE TRUE `a repudiation of the whole contract` EQUALS JUST `a repudiation of the whole contract`
#ASSERT `s 31(2) the breach of contract is a repudiation of the whole contract or a severable breach` TRUE TRUE `a severable breach giving rise to a claim for compensation but not to a right to treat the whole contract as repudiated` EQUALS JUST `a severable breach giving rise to a claim for compensation but not to a right to treat the whole contract as repudiated`
#ASSERT `s 31(2) the breach of contract is a repudiation of the whole contract or a severable breach` TRUE TRUE `not yet resolved on the terms and circumstances` EQUALS NOTHING
#ASSERT `s 31(2) the breach of contract is a repudiation of the whole contract or a severable breach` FALSE TRUE `a repudiation of the whole contract` EQUALS NOTHING -- not an instalment contract
#ASSERT `s 31(2) the breach of contract is a repudiation of the whole contract or a severable breach` TRUE FALSE `a repudiation of the whole contract` EQUALS NOTHING -- no defective delivery or refusal
-- s 32(1).
#ASSERT `s 32(1) delivery of the goods to the carrier is deemed to be a delivery of the goods to the buyer` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 32(1) delivery of the goods to the carrier is deemed to be a delivery of the goods to the buyer` TRUE TRUE TRUE EQUALS NOTHING -- prima facie only
#ASSERT `s 32(1) delivery of the goods to the carrier is deemed to be a delivery of the goods to the buyer` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 32(1) delivery of the goods to the carrier is deemed to be a delivery of the goods to the buyer` TRUE FALSE FALSE EQUALS JUST FALSE
-- s 32(2).
#ASSERT `s 32(2) the seller must make such contract with the carrier on behalf of the buyer as may be reasonable` FALSE EQUALS JUST TRUE
#ASSERT `s 32(2) the seller must make such contract with the carrier on behalf of the buyer as may be reasonable` TRUE EQUALS JUST FALSE
#ASSERT `s 32(2) the buyer may decline to treat the delivery to the carrier as a delivery to himself or hold the seller responsible in damages` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 32(2) the buyer may decline to treat the delivery to the carrier as a delivery to himself or hold the seller responsible in damages` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 32(2) the buyer may decline to treat the delivery to the carrier as a delivery to himself or hold the seller responsible in damages` FALSE TRUE EQUALS JUST FALSE
-- s 32(3).
#ASSERT `s 32(3) the seller must give the buyer such notice as may enable him to insure the goods during their sea transit` FALSE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 32(3) the seller must give the buyer such notice as may enable him to insure the goods during their sea transit` TRUE TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 32(3) the seller must give the buyer such notice as may enable him to insure the goods during their sea transit` FALSE FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 32(3) the seller must give the buyer such notice as may enable him to insure the goods during their sea transit` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 32(3) the goods are at the seller's risk during the sea transit` FALSE TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 32(3) the goods are at the seller's risk during the sea transit` FALSE TRUE TRUE FALSE EQUALS JUST FALSE -- he gave the notice
#ASSERT `s 32(3) the goods are at the seller's risk during the sea transit` TRUE TRUE TRUE TRUE EQUALS NOTHING
#ASSERT `s 32(3) the goods are at the seller's risk during the sea transit` FALSE FALSE TRUE TRUE EQUALS JUST FALSE
-- s 33.
#ASSERT `s 33 the buyer must take any risk of deterioration in the goods necessarily incident to the course of transit` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 33 the buyer must take any risk of deterioration in the goods necessarily incident to the course of transit` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 33 the buyer must take any risk of deterioration in the goods necessarily incident to the course of transit` FALSE FALSE EQUALS JUST FALSE
