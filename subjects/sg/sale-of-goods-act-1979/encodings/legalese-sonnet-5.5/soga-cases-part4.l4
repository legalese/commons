#ASSERT `s 35(4) the buyer is deemed to have accepted the goods after a reasonable time` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 35(4) the buyer is deemed to have accepted the goods after a reasonable time` FALSE TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 35(4) the buyer is deemed to have accepted the goods after a reasonable time` TRUE FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 35(4) the buyer is deemed to have accepted the goods after a reasonable time` TRUE TRUE TRUE EQUALS JUST FALSE -- he intimated rejection
