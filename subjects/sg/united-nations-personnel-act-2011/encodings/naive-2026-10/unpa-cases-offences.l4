IMPORT prelude
IMPORT `unpa-offences`

-- United Nations Personnel Act 2011, ss 3 to 9, 11(9), 12(8), 13 and the First and Second Schedules -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_united-nations-personnel-act-2011.py). Expected results were written by
-- hand from the text.

`a peacekeeping mission` MEANS Operation WITH
    `established by a UN organ under the Charter` IS TRUE
    `under UN authority and control` IS TRUE
    `for international peace and security` IS TRUE
    `declared an exceptional risk` IS FALSE
    `for peacebuilding assistance` IS FALSE
    `for emergency humanitarian assistance` IS FALSE
    `a Chapter VII enforcement action` IS FALSE
    `UN workers engaged as combatants` IS FALSE
    `the law of international armed conflict applies` IS FALSE

`a peacebuilding mission` MEANS Operation WITH
    `established by a UN organ under the Charter` IS TRUE
    `under UN authority and control` IS TRUE
    `for international peace and security` IS FALSE
    `declared an exceptional risk` IS FALSE
    `for peacebuilding assistance` IS TRUE
    `for emergency humanitarian assistance` IS FALSE
    `a Chapter VII enforcement action` IS FALSE
    `UN workers engaged as combatants` IS FALSE
    `the law of international armed conflict applies` IS FALSE

`a mission declared an exceptional risk` MEANS Operation WITH
    `established by a UN organ under the Charter` IS TRUE
    `under UN authority and control` IS TRUE
    `for international peace and security` IS FALSE
    `declared an exceptional risk` IS TRUE
    `for peacebuilding assistance` IS FALSE
    `for emergency humanitarian assistance` IS FALSE
    `a Chapter VII enforcement action` IS FALSE
    `UN workers engaged as combatants` IS FALSE
    `the law of international armed conflict applies` IS FALSE

`an emergency humanitarian mission` MEANS Operation WITH
    `established by a UN organ under the Charter` IS TRUE
    `under UN authority and control` IS TRUE
    `for international peace and security` IS FALSE
    `declared an exceptional risk` IS FALSE
    `for peacebuilding assistance` IS FALSE
    `for emergency humanitarian assistance` IS TRUE
    `a Chapter VII enforcement action` IS FALSE
    `UN workers engaged as combatants` IS FALSE
    `the law of international armed conflict applies` IS FALSE

`a coalition force not under UN control` MEANS Operation WITH
