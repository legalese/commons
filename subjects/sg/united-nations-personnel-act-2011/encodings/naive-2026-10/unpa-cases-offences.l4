§ `ss 4, 5 and 8`

#ASSERT `s 4 makes the act an offence` `murder (Penal Code s 302)` `a UN worker` TRUE FALSE
#ASSERT NOT `s 4 makes the act an offence` `murder (Penal Code s 302)` `a UN worker` FALSE FALSE
#ASSERT NOT `s 4 makes the act an offence` `voluntarily causing grievous hurt (Penal Code s 325)` `a UN worker` TRUE TRUE
#ASSERT NOT `s 4 makes the act an offence` `simple hurt` `a UN worker` TRUE FALSE

#ASSERT `s 5 makes the act an offence` `mischief (Penal Code s 426)` `relevant premises or a vehicle used by a UN worker` TRUE TRUE FALSE
#ASSERT NOT `s 5 makes the act an offence` `mischief (Penal Code s 426)` `relevant premises or a vehicle used by a UN worker` TRUE FALSE FALSE
#ASSERT NOT `s 5 makes the act an offence` `theft` `relevant premises or a vehicle used by a UN worker` TRUE TRUE FALSE

