IMPORT prelude
IMPORT `liba-loans`

-- Loans (International Banks) Act 1958, ss 2, 3(2), 5-12 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_loans-international-banks-act-1958.py). Expected results were written by
-- hand from the text.

§ `s 2`

#ASSERT `the lender is the Bank` `the International Bank for Reconstruction and Development`
#ASSERT `the lender is the Bank` `the Asian Development Bank`
#ASSERT NOT `the lender is the Bank` `the Asian Infrastructure Investment Bank`
#ASSERT NOT `the lender is the Bank` `the International Development Association`
#ASSERT NOT `the lender is the Bank` `a commercial bank`

#ASSERT `is a statutory authority` TRUE FALSE FALSE
#ASSERT `is a statutory authority` FALSE TRUE TRUE
#ASSERT NOT `is a statutory authority` FALSE TRUE FALSE
#ASSERT NOT `is a statutory authority` FALSE FALSE TRUE

§ `ss 3(2) and 6`

#ASSERT `the loan money may be applied to it` TRUE FALSE FALSE FALSE
#ASSERT `the loan money may be applied to it` FALSE TRUE TRUE TRUE
#ASSERT NOT `the loan money may be applied to it` FALSE TRUE TRUE FALSE
#ASSERT NOT `the loan money may be applied to it` FALSE TRUE FALSE TRUE
#ASSERT NOT `the loan money may be applied to it` FALSE FALSE TRUE TRUE

§ `s 5`

#ASSERT `may borrow under section 5` TRUE `the Asian Development Bank` TRUE
#ASSERT NOT `may borrow under section 5` TRUE `the Asian Development Bank` FALSE
#ASSERT NOT `may borrow under section 5` TRUE `a commercial bank` TRUE
#ASSERT NOT `may borrow under section 5` FALSE `the Asian Development Bank` TRUE

#ASSERT `section 5(2) makes the agreement binding` TRUE
#ASSERT NOT `section 5(2) makes the agreement binding` FALSE

#ASSERT `section 5(4) allows the charge` TRUE TRUE
#ASSERT NOT `section 5(4) allows the charge` FALSE TRUE

§ `ss 7 and 8`

#ASSERT `the Government may guarantee it` TRUE TRUE
#ASSERT NOT `the Government may guarantee it` FALSE TRUE

#ASSERT NOT `may use another borrowing power` TRUE FALSE
#ASSERT `may use another borrowing power` TRUE TRUE
#ASSERT `may use another borrowing power` FALSE FALSE

§ `s 9`

#ASSERT `the President may order directions` TRUE TRUE
#ASSERT NOT `the President may order directions` TRUE FALSE

§ `s 10`

#ASSERT `the authority must repay` 2000000
#ASSERT NOT `the authority must repay` 0

#ASSERT `the interest rate on the repayment` 0.065 EQUALS 0.065

#ASSERT `the number of annual statements to Parliament` 2024 2024 EQUALS 1
#ASSERT `the number of annual statements to Parliament` 2024 2028 EQUALS 5

§ `s 11`

#ASSERT `section 11 sends it to arbitration` TRUE TRUE TRUE
#ASSERT NOT `section 11 sends it to arbitration` FALSE TRUE TRUE
#ASSERT NOT `section 11 sends it to arbitration` TRUE TRUE FALSE

§ `s 12(2)`

#ASSERT `the tax is remitted` `income tax` TRUE TRUE
#ASSERT `the tax is remitted` `stamp duty` TRUE TRUE
#ASSERT NOT `the tax is remitted` `goods and services tax` TRUE TRUE
#ASSERT NOT `the tax is remitted` `property tax` TRUE TRUE
#ASSERT NOT `the tax is remitted` `stamp duty` FALSE TRUE
#ASSERT NOT `the tax is remitted` `income tax` TRUE FALSE

#ASSERT `the Exchange Control Act is disapplied` TRUE

§ `s 12(3) and (4)`

#ASSERT `the debt is external` TRUE FALSE
#ASSERT `the debt is external` FALSE TRUE
#ASSERT NOT `the debt is external` FALSE FALSE

#ASSERT `section 12(3) forbids the lien` `the Government` TRUE FALSE FALSE
#ASSERT `section 12(3) forbids the lien` `a Government agency` TRUE FALSE FALSE
#ASSERT `section 12(3) forbids the lien` `a statutory authority` TRUE FALSE FALSE
#ASSERT `section 12(3) forbids the lien` `the central bank` TRUE FALSE FALSE
#ASSERT NOT `section 12(3) forbids the lien` `a private company` TRUE FALSE FALSE
#ASSERT NOT `section 12(3) forbids the lien` `a statutory authority` FALSE FALSE FALSE
#ASSERT NOT `section 12(3) forbids the lien` `a statutory authority` TRUE TRUE FALSE
#ASSERT NOT `section 12(3) forbids the lien` `the Government` TRUE FALSE TRUE

