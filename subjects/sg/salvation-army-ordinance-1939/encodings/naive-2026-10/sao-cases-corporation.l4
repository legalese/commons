IMPORT prelude
IMPORT `sao-corporation`

-- Salvation Army Ordinance 1939, ss 2-11 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_salvation-army-ordinance-1939.py). Expected results were written by
-- hand from the text.

`a General whose papers are lodged under the Chief of the Staff` MEANS Claimant WITH
    `is named in a copy lodged at the office of the Minister` IS TRUE
    `the lodged copy is certified by` IS `the Chief of the Staff`
    `the document records appointment and acceptance of office` IS TRUE
    `a later similarly certified copy has been lodged` IS FALSE

`a General whose papers are certified by the acting Commissioner` MEANS Claimant WITH
    `is named in a copy lodged at the office of the Minister` IS TRUE
    `the lodged copy is certified by` IS `the Commissioner acting as Chief of the Staff`
    `the document records appointment and acceptance of office` IS TRUE
    `a later similarly certified copy has been lodged` IS FALSE

`a former General whose successor has not yet been lodged` MEANS Claimant WITH
    `is named in a copy lodged at the office of the Minister` IS TRUE
    `the lodged copy is certified by` IS `the Chief of the Staff`
    `the document records appointment and acceptance of office` IS TRUE
    `a later similarly certified copy has been lodged` IS FALSE

`a former General whose successor's papers have been lodged` MEANS Claimant WITH
    `is named in a copy lodged at the office of the Minister` IS TRUE
    `the lodged copy is certified by` IS `the Chief of the Staff`
    `the document records appointment and acceptance of office` IS TRUE
    `a later similarly certified copy has been lodged` IS TRUE

`a General whose copy is certified only by a notary` MEANS Claimant WITH
    `is named in a copy lodged at the office of the Minister` IS TRUE
    `the lodged copy is certified by` IS `a notary public`
    `the document records appointment and acceptance of office` IS TRUE
    `a later similarly certified copy has been lodged` IS FALSE

`a General whose copy is certified by a territorial commander` MEANS Claimant WITH
    `is named in a copy lodged at the office of the Minister` IS TRUE
    `the lodged copy is certified by` IS `a territorial commander`
    `the document records appointment and acceptance of office` IS TRUE
    `a later similarly certified copy has been lodged` IS FALSE

`a General-elect whose acceptance is not recorded` MEANS Claimant WITH
    `is named in a copy lodged at the office of the Minister` IS TRUE
    `the lodged copy is certified by` IS `the Chief of the Staff`
    `the document records appointment and acceptance of office` IS FALSE
    `a later similarly certified copy has been lodged` IS FALSE

`a General whose papers were never lodged` MEANS Claimant WITH
    `is named in a copy lodged at the office of the Minister` IS FALSE
    `the lodged copy is certified by` IS `nobody`
    `the document records appointment and acceptance of office` IS TRUE
    `a later similarly certified copy has been lodged` IS FALSE

`a bank deposit held by Evangeline Booth for the Army in 1939` MEANS Item WITH
    `is movable` IS TRUE
    `is in this Colony` IS TRUE
    `was vested in Evangeline Booth before 15 September 1939` IS TRUE

`furniture of a Singapore hall held by Evangeline Booth in 1939` MEANS Item WITH
    `is movable` IS TRUE
    `is in this Colony` IS TRUE
    `was vested in Evangeline Booth before 15 September 1939` IS TRUE

`land in Singapore held by Evangeline Booth in 1939` MEANS Item WITH
    `is movable` IS FALSE
    `is in this Colony` IS TRUE
    `was vested in Evangeline Booth before 15 September 1939` IS TRUE

`movables held by Evangeline Booth outside the Colony` MEANS Item WITH
    `is movable` IS TRUE
    `is in this Colony` IS FALSE
    `was vested in Evangeline Booth before 15 September 1939` IS TRUE

`a vehicle the Army bought after 1939` MEANS Item WITH
    `is movable` IS TRUE
    `is in this Colony` IS TRUE
    `was vested in Evangeline Booth before 15 September 1939` IS FALSE

`a lease sealed before and signed by the General` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the General for the time being`
    `signed by` IS `the General for the time being`

`a transfer sealed before and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney under a deposited power of attorney`
    `signed by` IS `an attorney under a deposited power of attorney`

`a mortgage sealed before the General and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the General for the time being`
    `signed by` IS `an attorney under a deposited power of attorney`

`a conveyance sealed before and signed by an attorney lodged only with the Minister` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `an attorney lodged with the Minister but not deposited`
    `signed by` IS `an attorney lodged with the Minister but not deposited`

`a deed sealed before an Army officer and signed by a deposited attorney` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `a Salvation Army officer with no power of attorney`
    `signed by` IS `an attorney under a deposited power of attorney`

`a document signed by the General but never sealed` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS FALSE
    `sealed in the presence of` IS `the General for the time being`
    `signed by` IS `the General for the time being`

`a deed sealed before the General but signed by nobody` MEANS Instrument WITH
    `is sealed with the Corporation seal` IS TRUE
    `sealed in the presence of` IS `the General for the time being`
    `signed by` IS `nobody`

`the current Attorney with a lodged copy` MEANS Attorney WITH
    `was appointed by the General by power of attorney` IS TRUE
    `a notarially certified copy is lodged at the office of the Minister` IS TRUE
    `a subsequent similarly certified copy has been lodged` IS FALSE

`an Attorney whose copy was never lodged` MEANS Attorney WITH
    `was appointed by the General by power of attorney` IS TRUE
    `a notarially certified copy is lodged at the office of the Minister` IS FALSE
    `a subsequent similarly certified copy has been lodged` IS FALSE

`a former Attorney replaced by a later lodged copy` MEANS Attorney WITH
    `was appointed by the General by power of attorney` IS TRUE
    `a notarially certified copy is lodged at the office of the Minister` IS TRUE
    `a subsequent similarly certified copy has been lodged` IS TRUE

§ `ss 2 and 9`

#ASSERT `is conclusively the General in evidence` `a General whose papers are lodged under the Chief of the Staff`
#ASSERT `is conclusively the General in evidence` `a General whose papers are certified by the acting Commissioner`
#ASSERT `is conclusively the General in evidence` `a former General whose successor has not yet been lodged`
#ASSERT NOT `is conclusively the General in evidence` `a former General whose successor's papers have been lodged`
#ASSERT NOT `is conclusively the General in evidence` `a General whose copy is certified only by a notary`
#ASSERT NOT `is conclusively the General in evidence` `a General whose copy is certified by a territorial commander`
#ASSERT NOT `is conclusively the General in evidence` `a General-elect whose acceptance is not recorded`
#ASSERT NOT `is conclusively the General in evidence` `a General whose papers were never lodged`

§ `ss 3 and 8`

#ASSERT `section 3 vests it in the Corporation` `a bank deposit held by Evangeline Booth for the Army in 1939`
#ASSERT `section 3 vests it in the Corporation` `furniture of a Singapore hall held by Evangeline Booth in 1939`
#ASSERT NOT `section 3 vests it in the Corporation` `land in Singapore held by Evangeline Booth in 1939`
#ASSERT NOT `section 3 vests it in the Corporation` `movables held by Evangeline Booth outside the Colony`
#ASSERT NOT `section 3 vests it in the Corporation` `a vehicle the Army bought after 1939`

#ASSERT `is still vested in the Corporation` TRUE TRUE
#ASSERT `is still vested in the Corporation` TRUE FALSE
#ASSERT NOT `is still vested in the Corporation` FALSE TRUE

§ `ss 4, 5 and 7`

#ASSERT `the Ordinance empowers the Corporation to` `acquire property by purchase` FALSE FALSE
#ASSERT `the Ordinance empowers the Corporation to` `acquire property by devise or bequest` FALSE FALSE
#ASSERT `the Ordinance empowers the Corporation to` `acquire property by donation or gift` FALSE TRUE
#ASSERT `the Ordinance empowers the Corporation to` `sell property` TRUE FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell property` FALSE FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `sell property` TRUE TRUE
#ASSERT `the Ordinance empowers the Corporation to` `mortgage property` TRUE FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `mortgage property` TRUE TRUE
#ASSERT `the Ordinance empowers the Corporation to` `lease property` TRUE FALSE
#ASSERT `the Ordinance empowers the Corporation to` `exchange or partition property` TRUE FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `otherwise dispose of property` FALSE FALSE
#ASSERT `the Ordinance empowers the Corporation to` `sue or be sued in the courts` FALSE FALSE
#ASSERT NOT `the Ordinance empowers the Corporation to` `borrow money without security` TRUE FALSE

§ `s 6`

#ASSERT `is executed as section 6 requires` `a lease sealed before and signed by the General`
#ASSERT `is executed as section 6 requires` `a transfer sealed before and signed by a deposited attorney`
#ASSERT `is executed as section 6 requires` `a mortgage sealed before the General and signed by a deposited attorney`
#ASSERT NOT `is executed as section 6 requires` `a conveyance sealed before and signed by an attorney lodged only with the Minister`
#ASSERT NOT `is executed as section 6 requires` `a deed sealed before an Army officer and signed by a deposited attorney`
#ASSERT NOT `is executed as section 6 requires` `a document signed by the General but never sealed`
#ASSERT NOT `is executed as section 6 requires` `a deed sealed before the General but signed by nobody`

#ASSERT `the signature is sufficient evidence the seal was duly affixed` `a lease sealed before and signed by the General`
#ASSERT `the signature is sufficient evidence the seal was duly affixed` `a transfer sealed before and signed by a deposited attorney`
#ASSERT `the signature is sufficient evidence the seal was duly affixed` `a mortgage sealed before the General and signed by a deposited attorney`
#ASSERT NOT `the signature is sufficient evidence the seal was duly affixed` `a conveyance sealed before and signed by an attorney lodged only with the Minister`
#ASSERT `the signature is sufficient evidence the seal was duly affixed` `a deed sealed before an Army officer and signed by a deposited attorney`
#ASSERT NOT `the signature is sufficient evidence the seal was duly affixed` `a document signed by the General but never sealed`
#ASSERT NOT `the signature is sufficient evidence the seal was duly affixed` `a deed sealed before the General but signed by nobody`

§ `ss 10 and 7`

#ASSERT `is deemed the duly authorised Attorney` `the current Attorney with a lodged copy`
#ASSERT NOT `is deemed the duly authorised Attorney` `an Attorney whose copy was never lodged`
#ASSERT NOT `is deemed the duly authorised Attorney` `a former Attorney replaced by a later lodged copy`

#ASSERT `is service section 7 provides for` `the current Attorney with a lodged copy` TRUE TRUE
#ASSERT NOT `is service section 7 provides for` `the current Attorney with a lodged copy` TRUE FALSE
#ASSERT NOT `is service section 7 provides for` `the current Attorney with a lodged copy` FALSE TRUE
#ASSERT NOT `is service section 7 provides for` `a former Attorney replaced by a later lodged copy` TRUE TRUE

§ `s 11`

-- the Government
#ASSERT NOT `the Ordinance may affect their rights` FALSE FALSE
-- a neighbouring landowner
#ASSERT NOT `the Ordinance may affect their rights` FALSE FALSE
-- the Corporation
#ASSERT `the Ordinance may affect their rights` TRUE FALSE
-- a purchaser from the Corporation
#ASSERT `the Ordinance may affect their rights` FALSE TRUE

