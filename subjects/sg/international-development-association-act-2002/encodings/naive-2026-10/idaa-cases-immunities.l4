#ASSERT NOT `the Minister may issue the note` TRUE FALSE TRUE TRUE TRUE
#ASSERT NOT `the Minister may issue the note` TRUE FALSE FALSE FALSE TRUE
#ASSERT NOT `the Minister may issue the note` TRUE FALSE FALSE TRUE FALSE

