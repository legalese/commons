IMPORT prelude
IMPORT `idaa-immunities`

-- International Development Association Act 2002, ss 4(2), (3), 5(1), 8(2), 9 and Schedule Article VIII ss 3, 4, 8, 9 -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_international-development-association-act-2002.py). Expected results were written by
-- hand from the text.

§ `s 4(2), (3) -- subscription`

#ASSERT `the total subscription is within s 4(2)` 1 FALSE
#ASSERT `the total subscription is within s 4(2)` 0.5 FALSE
#ASSERT NOT `the total subscription is within s 4(2)` 1.2 FALSE
#ASSERT `the total subscription is within s 4(2)` 1.2 TRUE

#ASSERT `the additional subscription is within s 4(3)` 3 TRUE 5
#ASSERT `the additional subscription is within s 4(3)` 5 TRUE 5
#ASSERT NOT `the additional subscription is within s 4(3)` 6 TRUE 5
#ASSERT NOT `the additional subscription is within s 4(3)` 3 FALSE 5

