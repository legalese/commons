#ASSERT NOT `the Companies Act 1967 applies to the issue` TRUE
#ASSERT `the Companies Act 1967 applies to the issue` FALSE

§ `Article VIII s 3 -- suing the Association`

#ASSERT `an action may be brought against the Association` `a claim on the Association's borrowing` FALSE TRUE TRUE
#ASSERT `an action may be brought against the Association` `a supplier's claim for the price of goods` FALSE TRUE TRUE
#ASSERT `an action may be brought against the Association` `an employee's claim for wages` FALSE TRUE TRUE
#ASSERT `an action may be brought against the Association` `a claim for personal injury on Association premises` FALSE TRUE TRUE
#ASSERT NOT `an action may be brought against the Association` `a supplier's claim for the price of goods` FALSE FALSE TRUE
#ASSERT NOT `an action may be brought against the Association` `a supplier's claim for the price of goods` FALSE TRUE FALSE
#ASSERT NOT `an action may be brought against the Association` `a claim on the Association's borrowing` TRUE TRUE TRUE

§ `Article VIII ss 3, 4 -- seizure`

#ASSERT `the Association's property may be seized` TRUE FALSE
#ASSERT NOT `the Association's property may be seized` FALSE FALSE
#ASSERT NOT `the Association's property may be seized` TRUE TRUE

§ `Article VIII s 8 -- personnel`

#ASSERT `the person is immune from legal process for the act` `a Governor` TRUE FALSE
#ASSERT NOT `the person is immune from legal process for the act` `an officer` FALSE FALSE
#ASSERT NOT `the person is immune from legal process for the act` `an officer` TRUE TRUE
#ASSERT NOT `the person is immune from legal process for the act` `a consultant who is not an employee` TRUE FALSE

#ASSERT `the person gets the immigration and national service immunities` `an employee` FALSE
#ASSERT NOT `the person gets the immigration and national service immunities` `an employee` TRUE
#ASSERT NOT `the person gets the immigration and national service immunities` `a consultant who is not an employee` FALSE

§ `Article VIII s 9(a) and s 8(2) -- the Association's own taxes`

#ASSERT `the Association is exempt from the levy` `income tax on the Association's income`
#ASSERT `the Association is exempt from the levy` `customs duty on goods imported with a restriction on resale`
#ASSERT NOT `the Association is exempt from the levy` `customs duty on goods imported with no restriction on resale`
#ASSERT `the Association is exempt from the levy` `a tax forming part of the price of goods sold to the Association`
#ASSERT NOT `the Association is exempt from the levy` `a charge for services rendered dressed as a tax`
#ASSERT `the Association is exempt from the levy` `a duty to collect tax from the Association's payments`

§ `Article VIII s 9(b) -- salaries`

#ASSERT `section 9(b) bars tax on the Association salary` `an employee` FALSE
#ASSERT NOT `section 9(b) bars tax on the Association salary` `an employee` TRUE
#ASSERT `section 9(b) bars tax on the Association salary` `an Alternate` FALSE
#ASSERT NOT `section 9(b) bars tax on the Association salary` `a Governor` FALSE
#ASSERT `section 9(b) bars tax on the Association salary` `an officer` FALSE

