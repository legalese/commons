IMPORT prelude
IMPORT `pss-finality`

-- Payment and Settlement Systems (Finality and Netting) Act 2002, ss 3, 4, 4A, 6, 7, 8, 12, 13, 14, 15A, 15B, 16, 17, 17C, 19A, 20A -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_payment-and-settlement-systems-finality-and-netting-act-2002.py). Expected results were written by
-- hand from the text.

§ `s 3`

#ASSERT NOT `the Authority may designate the system` FALSE FALSE FALSE
#ASSERT `the Authority may designate the system` FALSE FALSE TRUE

§ `s 4`

#ASSERT `the operator must be heard before revocation` `the system ceased to operate`
#ASSERT NOT `the operator must be heard before revocation` `the operator or settlement institution is being wound up`
#ASSERT NOT `the operator must be heard before revocation` `a compromise or scheme with creditors`
#ASSERT NOT `the operator must be heard before revocation` `a receiver or judicial manager was appointed`
#ASSERT `the operator must be heard before revocation` `the public interest`

§ `s 4A`

#ASSERT `the holding out is an offence` TRUE FALSE FALSE
#ASSERT NOT `the holding out is an offence` TRUE TRUE TRUE
#ASSERT `the holding out is an offence` TRUE TRUE FALSE

§ `ss 6, 7, 12`

#ASSERT `Part 2 protects the transfer order` TRUE TRUE `no insolvency event` 0
#ASSERT `Part 2 protects the transfer order` TRUE TRUE `a bankruptcy order` 1
#ASSERT NOT `Part 2 protects the transfer order` TRUE TRUE `a winding up order` 2
#ASSERT NOT `Part 2 protects the transfer order` TRUE FALSE `a judicial management order` 0
#ASSERT NOT `Part 2 protects the transfer order` FALSE TRUE `no insolvency event` 0

#ASSERT NOT `the transfer may be reversed or set aside` TRUE TRUE TRUE `no insolvency event` 0
#ASSERT `the transfer may be reversed or set aside` TRUE FALSE TRUE `no insolvency event` 0
#ASSERT `the transfer may be reversed or set aside` TRUE TRUE TRUE `a judicial management resolution` 2
#ASSERT NOT `the transfer may be reversed or set aside` TRUE TRUE TRUE `a voluntary winding up resolution` 1

§ `s 8(3), (4)`

#ASSERT `the debt may now be proved or set off` FALSE FALSE
#ASSERT NOT `the debt may now be proved or set off` TRUE FALSE
#ASSERT `the debt may now be proved or set off` TRUE TRUE

§ `s 13`

#ASSERT `the operator may net the obligation under section 13` `a bankruptcy order` 1
#ASSERT `the operator may net the obligation under section 13` `a winding up order` 0
#ASSERT NOT `the operator may net the obligation under section 13` `a voluntary winding up resolution` 2
#ASSERT NOT `the operator may net the obligation under section 13` `a judicial management order` 0
#ASSERT NOT `the operator may net the obligation under section 13` `a judicial management resolution` 0

§ `s 14`

#ASSERT NOT `a Singapore court may give effect to the foreign order` TRUE
#ASSERT `a Singapore court may give effect to the foreign order` FALSE

§ `s 15B, 5(2)`

#ASSERT `must notify the Authority` TRUE TRUE FALSE FALSE
#ASSERT NOT `must notify the Authority` TRUE TRUE TRUE FALSE
#ASSERT NOT `must notify the Authority` TRUE TRUE FALSE TRUE
#ASSERT NOT `must notify the Authority` FALSE TRUE FALSE FALSE

§ `s 16`

#ASSERT `failing to notify the operator is an offence` `a bankruptcy order` FALSE FALSE FALSE
#ASSERT `failing to notify the operator is an offence` `a judicial management resolution` FALSE FALSE FALSE
#ASSERT NOT `failing to notify the operator is an offence` `a bankruptcy order` TRUE FALSE FALSE
#ASSERT NOT `failing to notify the operator is an offence` `a winding up order` FALSE TRUE FALSE
#ASSERT NOT `failing to notify the operator is an offence` `a voluntary winding up resolution` FALSE FALSE TRUE

