IMPORT prelude
IMPORT `nlba-deposit-and-records`

-- National Library Board Act 1995, ss 2, 7(2)(g), 10, 17, 18, 20, 21, 22, 44, 45 and 47(2)(j) -- worked cases.
--
-- Every assertion is a claim about the ENCODING on stated facts, not about the law. Nothing here has been checked
-- against a decided case or subsidiary legislation (none was retrieved).
--
-- Fixtures are generated from a table of which flags are set (scratchpad gen_national-library-board-act-1995.py). Expected results were written by
-- hand from the text.

§ `fixtures`

`a printed novel released in Singapore` MEANS LibraryMaterial WITH
    `is online material` IS FALSE
    `is in electronic form` IS FALSE
    `was produced and released in Singapore for sale or public distribution` IS TRUE
    `is exempted by regulations` IS FALSE

`an e-book released in Singapore` MEANS LibraryMaterial WITH
    `is online material` IS FALSE
    `is in electronic form` IS TRUE
    `was produced and released in Singapore for sale or public distribution` IS TRUE
    `is exempted by regulations` IS FALSE

`a blog post on a Singapore website` MEANS LibraryMaterial WITH
    `is online material` IS TRUE
    `is in electronic form` IS TRUE
    `was produced and released in Singapore for sale or public distribution` IS TRUE
    `is exempted by regulations` IS FALSE

`a pamphlet exempted by regulations` MEANS LibraryMaterial WITH
    `is online material` IS FALSE
    `is in electronic form` IS FALSE
    `was produced and released in Singapore for sale or public distribution` IS TRUE
    `is exempted by regulations` IS TRUE

§ `ss 2 and 10`

#ASSERT `the publisher must deposit it` `a printed novel released in Singapore`
#ASSERT `the publisher must deposit it` `an e-book released in Singapore`
#ASSERT NOT `the publisher must deposit it` `a blog post on a Singapore website`
#ASSERT NOT `the publisher must deposit it` `a pamphlet exempted by regulations`

#ASSERT `the number of copies to deposit` `a printed novel released in Singapore` EQUALS 2
#ASSERT `the number of copies to deposit` `an e-book released in Singapore` EQUALS 1
#ASSERT `the number of copies to deposit` `a blog post on a Singapore website` EQUALS 0

#ASSERT NOT `the publisher commits the deposit offence` `a printed novel released in Singapore` 2 20 TRUE
#ASSERT `the publisher commits the deposit offence` `a printed novel released in Singapore` 1 20 TRUE
#ASSERT `the publisher commits the deposit offence` `a printed novel released in Singapore` 2 29 TRUE
#ASSERT NOT `the publisher commits the deposit offence` `a printed novel released in Singapore` 2 28 TRUE
#ASSERT `the publisher commits the deposit offence` `an e-book released in Singapore` 1 10 FALSE
#ASSERT NOT `the publisher commits the deposit offence` `a blog post on a Singapore website` 0 100 FALSE

§ `ss 2 and 7(2)(g)`

#ASSERT `the Board may copy the online material` TRUE TRUE FALSE
#ASSERT `the Board may copy the online material` TRUE FALSE TRUE
#ASSERT NOT `the Board may copy the online material` TRUE FALSE FALSE

§ `s 2 public archives`

#ASSERT `the public records are public archives` 30 TRUE TRUE
#ASSERT NOT `the public records are public archives` 25 TRUE TRUE
#ASSERT NOT `the public records are public archives` 26 FALSE TRUE

§ `s 17`

#ASSERT `the destruction complies with s 17` TRUE TRUE FALSE FALSE
#ASSERT NOT `the destruction complies with s 17` FALSE TRUE FALSE FALSE
#ASSERT NOT `the destruction complies with s 17` TRUE TRUE TRUE FALSE

§ `s 18`

#ASSERT `inspecting breaches s 18(1)` FALSE FALSE FALSE
#ASSERT NOT `inspecting breaches s 18(1)` TRUE FALSE FALSE
#ASSERT NOT `inspecting breaches s 18(1)` FALSE TRUE FALSE

#ASSERT NOT `s 18(2) entitles the person to inspect` TRUE FALSE TRUE

§ `s 20`

#ASSERT `reproducing it is an offence under s 20` `a public record transferred to the National Archives` FALSE TRUE
#ASSERT NOT `reproducing it is an offence under s 20` `a public record transferred to the National Archives` TRUE TRUE
#ASSERT `reproducing it is an offence under s 20` `a public record transferred to the National Archives` TRUE FALSE
#ASSERT `reproducing it is an offence under s 20` `a recording deposited under s 22` FALSE TRUE
#ASSERT NOT `reproducing it is an offence under s 20` `a public record still held by the public office` FALSE TRUE

§ `s 21`

#ASSERT `the person commits an offence under s 21` TRUE FALSE FALSE FALSE
#ASSERT NOT `the person commits an offence under s 21` TRUE TRUE FALSE FALSE
#ASSERT `the person commits an offence under s 21` FALSE TRUE TRUE FALSE

§ `s 22`

#ASSERT `the producer commits an offence under s 22` TRUE TRUE FALSE FALSE 0
#ASSERT NOT `the producer commits an offence under s 22` TRUE TRUE FALSE TRUE 5
#ASSERT `the producer commits an offence under s 22` TRUE TRUE FALSE TRUE 7
#ASSERT NOT `the producer commits an offence under s 22` TRUE FALSE FALSE FALSE 0
#ASSERT NOT `the producer commits an offence under s 22` FALSE TRUE FALSE FALSE 0

§ `s 44`

#ASSERT `using the symbol is an offence under s 44` FALSE TRUE FALSE
#ASSERT NOT `using the symbol is an offence under s 44` TRUE TRUE FALSE
#ASSERT `using the symbol is an offence under s 44` FALSE FALSE TRUE

§ `maximum penalties`

#ASSERT `the maximum fine` `failing to deposit library material` EQUALS 5000

#ASSERT `the maximum imprisonment in months` `failing to deposit library material` EQUALS 0
#ASSERT `the maximum imprisonment in months` `reproducing archives without consent` EQUALS 12
#ASSERT `the maximum imprisonment in months` `taking abroad or damaging public records` EQUALS 12
#ASSERT `the maximum imprisonment in months` `failing to provide a recording` EQUALS 12
#ASSERT `the maximum imprisonment in months` `misusing the Board's symbol` EQUALS 6
#ASSERT `the maximum imprisonment in months` `breaching the Board's regulations` EQUALS 0

