#ASSERT     `the entry names the thing` (`entry` swear) "declare" TRUE
#ASSERT NOT `the entry names the thing` (`entry` swear) "affirm and declare" FALSE
#ASSERT NOT `the entry names the thing` (`entry` swear) "affirm" FALSE
#ASSERT REFUSED `the entry names the thing` (`entry` swear) "promise" TRUE
#ASSERT REFUSED `the entry names the thing` (`entry` swear) "affirm and promise" TRUE BECAUSE "an entry that says includes does not close the list, so a thing it does not name is not answered"

