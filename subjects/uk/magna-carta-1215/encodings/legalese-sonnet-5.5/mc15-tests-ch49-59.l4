§§ `Chapter 55 -- unjust fines and amercements`

-- Arguments are made or imposed unjustly, against the law of the land.
#ASSERT `ch 55 -- what is to be done with the fine or amercement` TRUE TRUE EQUALS `Remitted entirely, or else dealt with by the five-and-twenty barons`
#ASSERT `ch 55 -- what is to be done with the fine or amercement` TRUE FALSE EQUALS `Remedy not covered`
#ASSERT `ch 55 -- what is to be done with the fine or amercement` FALSE TRUE EQUALS `Remedy not covered`
-- Arguments add that the archbishop of Canterbury can be present; if he cannot, the business proceeds without him.
#ASSERT `ch 55 -- who decides what is done with the fine or amercement` TRUE TRUE TRUE EQUALS `the five-and-twenty barons, or the majority of them, along with the archbishop of Canterbury and such others as he brings`
#ASSERT `ch 55 -- who decides what is done with the fine or amercement` TRUE TRUE FALSE EQUALS `the five-and-twenty barons, or the majority of them, without the archbishop of Canterbury`
#ASSERT `ch 55 -- who decides what is done with the fine or amercement` TRUE FALSE TRUE EQUALS `Forum not covered`
#ASSERT `ch 55 -- who decides what is done with the fine or amercement` FALSE TRUE TRUE EQUALS `Forum not covered`
#ASSERT `ch 55 -- the baron may sit in this particular judgment` TRUE EQUALS Barred
#ASSERT `ch 55 -- the baron may sit in this particular judgment` FALSE EQUALS `Not barred`
#ASSERT `ch 55 -- the substitute may sit in the place of a baron in a similar suit` TRUE TRUE EQUALS Entitled
#ASSERT `ch 55 -- the substitute may sit in the place of a baron in a similar suit` TRUE FALSE EQUALS `Entitlement not covered`
#ASSERT `ch 55 -- the substitute may sit in the place of a baron in a similar suit` FALSE TRUE EQUALS `Entitlement not covered`

