#ASSERT `ch 51 -- the person is to be banished from the kingdom` TRUE `a knight` TRUE TRUE EQUALS Obliged
#ASSERT `ch 51 -- the person is to be banished from the kingdom` TRUE `a cross-bowman` TRUE TRUE EQUALS Obliged
#ASSERT `ch 51 -- the person is to be banished from the kingdom` TRUE `a serjeant` TRUE TRUE EQUALS Obliged
#ASSERT `ch 51 -- the person is to be banished from the kingdom` TRUE `a mercenary soldier` TRUE TRUE EQUALS Obliged
#ASSERT `ch 51 -- the person is to be banished from the kingdom` FALSE `a knight` TRUE TRUE EQUALS `Obligation not covered`
#ASSERT `ch 51 -- the person is to be banished from the kingdom` TRUE `a knight` FALSE TRUE EQUALS `Obligation not covered`
#ASSERT `ch 51 -- the person is to be banished from the kingdom` TRUE `a knight` TRUE FALSE EQUALS `Obligation not covered`
#ASSERT `ch 51 -- the person is to be banished from the kingdom` TRUE `someone of another kind` TRUE TRUE EQUALS `Obligation not covered`
-- expect: MUST `banish from the kingdom all foreign-born knights, cross-bowmen, serjeants and mercenary soldiers who have come with horses and arms to the kingdom's hurt`
