#TRACE `ch 56 -- they shall be immediately restored to them` TRUE TRUE TRUE AT 0 WITH
    WAITUNTIL 100
-- expect: FULFILLED
#TRACE `ch 56 -- they shall be immediately restored to them` TRUE TRUE TRUE AT 0 WITH
