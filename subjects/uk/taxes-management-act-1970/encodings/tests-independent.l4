IMPORT prelude
IMPORT daydate
IMPORT `tma-types`
IMPORT `tma-returns`
IMPORT `tma-payment`
IMPORT `tma-time-limits`
IMPORT `tma-goal`

-- Independent tests for the TMA 1970 self-assessment encoding.
-- Expected values were fixed in independent-expectations.md from the Act
-- and BRIEF.md before the encoding was read. Scenario ids (A1, B5, ...) refer
-- to that file. A failing assertion is a finding; values were not adjusted.

§ `Helpers`

GIVEN ty IS A NUMBER, nd IS A MAYBE DATE, el IS A BOOLEAN, dv IS A MAYBE DATE, am IS A MAYBE DATE
GIVETH A `Return facts`
mkR ty nd el dv am MEANS `Return facts` OF ty, nd, el, dv, am

-- notice date, electronic?, Y 2024, not delivered
GIVEN nd IS A DATE, el IS A BOOLEAN
GIVETH A `Return facts`
n24 nd el MEANS mkR 2024 (JUST nd) el NOTHING NOTHING

-- Y 2024, notice, electronic?, delivered
GIVEN nd IS A DATE, el IS A BOOLEAN, dv IS A DATE
GIVETH A `Return facts`
dl24 nd el dv MEANS mkR 2024 (JUST nd) el (JUST dv) NOTHING

-- Y 2024, notice, electronic?, delivered, amended
GIVEN nd IS A DATE, el IS A BOOLEAN, dv IS A DATE, am IS A DATE
GIVETH A `Return facts`
am24 nd el dv am MEANS mkR 2024 (JUST nd) el (JUST dv) (JUST am)

GIVEN ty IS A NUMBER, pa IS A NUMBER, pd IS A NUMBER, pm IS A NUMBER, pp IS A NUMBER, sa IS A NUMBER, pk IS A NUMBER, ds IS A NUMBER, nt IS A BOOLEAN, nd IS A MAYBE DATE
GIVETH A `Payment facts`
mkP ty pa pd pm pp sa pk ds nt nd MEANS `Payment facts` OF ty, pa, pd, pm, pp, sa, pk, ds, nt, nd

-- s 59A only: Y, previous assessed, previous deducted; prescribed 1000 and 20%
GIVEN ty IS A NUMBER, pa IS A NUMBER, pd IS A NUMBER
GIVETH A `Payment facts`
poa ty pa pd MEANS mkP ty pa pd 1000 0.2 0 0 0 FALSE NOTHING

-- s 59B(1) only: Y 2024, self-assessed, POAs made, deducted
GIVEN sa IS A NUMBER, pk IS A NUMBER, ds IS A NUMBER
GIVETH A `Payment facts`
bal sa pk ds MEANS mkP 2024 0 0 1000 0.2 sa pk ds FALSE NOTHING

-- s 59B(3)-(4) only: Y 2024, notified in time?, notice to file
GIVEN nt IS A BOOLEAN, nd IS A MAYBE DATE
GIVETH A `Payment facts`
bdt nt nd MEANS mkP 2024 0 0 1000 0.2 0 0 0 nt nd

GIVEN ty IS A NUMBER, ls IS A `Loss of tax`
GIVETH A DATE
lim ty ls MEANS `the last day for an assessment for` ty `where the loss is` ls

§ `A. s 7 notification`

#ASSERT `the last day to notify chargeability for` (mkR 2024 NOTHING TRUE NOTHING NOTHING) EQUALS Date 5 10 2025 -- A1
#ASSERT `the last day to notify chargeability for` (mkR 2023 NOTHING TRUE NOTHING NOTHING) EQUALS Date 5 10 2024 -- A2
#ASSERT `the last day to notify chargeability for` (mkR 2027 NOTHING FALSE NOTHING NOTHING) EQUALS Date 5 10 2028 -- A3

