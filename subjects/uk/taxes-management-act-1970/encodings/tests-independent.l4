§ `C. s 9ZA amendment`

#ASSERT `the last day to amend the return for` (n24 (Date 20 4 2025) TRUE) EQUALS Date 31 1 2027 -- C1
#ASSERT `the last day to amend the return for` (n24 (Date 1 8 2025) FALSE) EQUALS Date 31 1 2027 -- C2
#ASSERT `the last day to amend the return for` (n24 (Date 31 10 2025) TRUE) EQUALS Date 31 1 2027 -- C3
#ASSERT `the last day to amend the return for` (n24 (Date 1 11 2025) TRUE) EQUALS Date 31 1 2027 -- C4
#ASSERT `the last day to amend the return for` (n24 (Date 15 11 2025) TRUE) EQUALS Date 14 2 2027 -- C5
#ASSERT `the last day to amend the return for` (mkR 2026 (JUST (Date 30 11 2027)) TRUE NOTHING NOTHING) EQUALS Date 28 2 2029 -- C6
#ASSERT `the last day to amend the return for` (n24 (Date 31 12 2025) FALSE) EQUALS Date 30 3 2027 -- C7

§ `D. s 9A enquiry window`

#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 20 4 2025) TRUE (Date 15 1 2026)) EQUALS JUST (Date 15 1 2027) -- D1
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 20 4 2025) TRUE (Date 31 1 2026)) EQUALS JUST (Date 31 1 2027) -- D2
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 20 4 2025) TRUE (Date 1 2 2026)) EQUALS JUST (Date 30 4 2027) -- D3
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 20 4 2025) FALSE (Date 31 10 2025)) EQUALS JUST (Date 31 10 2026) -- D4
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 20 4 2025) FALSE (Date 1 11 2025)) EQUALS JUST (Date 31 1 2027) -- D5
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 20 4 2025) FALSE (Date 20 12 2025)) EQUALS JUST (Date 31 1 2027) -- D6
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 20 4 2025) TRUE (Date 30 4 2026)) EQUALS JUST (Date 31 7 2027) -- D7
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 20 4 2025) TRUE (Date 31 7 2026)) EQUALS JUST (Date 31 10 2027) -- D8
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 20 4 2025) TRUE (Date 31 10 2026)) EQUALS JUST (Date 31 1 2028) -- D9
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 20 4 2025) TRUE (Date 31 1 2027)) EQUALS JUST (Date 30 4 2028) -- D10
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 15 11 2025) TRUE (Date 14 2 2026)) EQUALS JUST (Date 14 2 2027) -- D11
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 15 11 2025) TRUE (Date 15 2 2026)) EQUALS JUST (Date 30 4 2027) -- D12
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 15 8 2025) FALSE (Date 14 11 2025)) EQUALS JUST (Date 14 11 2026) -- D13
#ASSERT `the last day for a notice of enquiry for` (dl24 (Date 15 8 2025) FALSE (Date 15 11 2025)) EQUALS JUST (Date 31 1 2027) -- D14
#ASSERT `the last day for a notice of enquiry for` (mkR 2026 (JUST (Date 30 4 2027)) TRUE (JUST (Date 29 2 2028)) NOTHING) EQUALS JUST (Date 30 4 2029) -- D15
#ASSERT `the last day for a notice of enquiry for` (mkR 2022 (JUST (Date 15 12 2023)) TRUE (JUST (Date 29 2 2024)) NOTHING) EQUALS JUST (Date 28 2 2025) -- D16
#ASSERT `the last day for a notice of enquiry for` (am24 (Date 20 4 2025) TRUE (Date 15 1 2026) (Date 10 3 2026)) EQUALS JUST (Date 30 4 2027) -- D17
#ASSERT `the last day for a notice of enquiry for` (am24 (Date 20 4 2025) TRUE (Date 15 1 2026) (Date 31 1 2027)) EQUALS JUST (Date 30 4 2028) -- D18
#ASSERT `the last day for a notice of enquiry for` (am24 (Date 20 4 2025) TRUE (Date 15 1 2026) (Date 20 1 2026)) EQUALS JUST (Date 31 1 2027) -- D19
#ASSERT `the last day for a notice of enquiry for` (am24 (Date 20 4 2025) FALSE (Date 31 10 2025) (Date 31 7 2026)) EQUALS JUST (Date 31 10 2027) -- D20

§ `E. s 59A payments on account`

#ASSERT `payments on account are due under` (poa 2024 5000 1000) -- E1
#ASSERT `each payment on account under` (poa 2024 5000 1000) EQUALS 2000 -- E1
#ASSERT `the first payment on account date for` (poa 2024 5000 1000) EQUALS Date 31 1 2025 -- E1
#ASSERT `the second payment on account date for` (poa 2024 5000 1000) EQUALS Date 31 7 2025 -- E1
#ASSERT `payments on account are due under` (poa 2024 5000 4000) -- E2
#ASSERT `each payment on account under` (poa 2024 5000 4000) EQUALS 500 -- E2
#ASSERT NOT (`payments on account are due under` (poa 2024 4999 4000)) -- E3
#ASSERT `each payment on account under` (poa 2024 4999 4000) EQUALS 0 -- E3
#ASSERT NOT (`payments on account are due under` (poa 2024 10000 8001)) -- E4
#ASSERT `payments on account are due under` (poa 2024 10000 8000) -- E5
#ASSERT `each payment on account under` (poa 2024 10000 8000) EQUALS 1000 -- E5
#ASSERT NOT (`payments on account are due under` (poa 2024 3000 3000)) -- E6
#ASSERT NOT (`payments on account are due under` (poa 2024 2000 3000)) -- E7
#ASSERT NOT (`payments on account are due under` (poa 2024 0 0)) -- E8
#ASSERT NOT (`payments on account are due under` (poa 2024 6001 5000)) -- E9
#ASSERT `payments on account are due under` (poa 2024 1001 0) -- E10
#ASSERT `each payment on account under` (poa 2024 1001 0) EQUALS 500.5 -- E10
#ASSERT `the first payment on account date for` (poa 2025 5000 1000) EQUALS Date 31 1 2026 -- E11
#ASSERT `the second payment on account date for` (poa 2025 5000 1000) EQUALS Date 31 7 2026 -- E11

§ `F. s 59B balancing payment`

#ASSERT `the balancing payment under` (bal 10000 6000 1000) EQUALS 3000 -- F1
#ASSERT `the balancing payment under` (bal 5000 6000 0) EQUALS 0 MINUS 1000 -- F2
#ASSERT `the balancing payment under` (bal 5000 4000 1000) EQUALS 0 -- F3
#ASSERT `the balancing payment date for` (bdt FALSE (JUST (Date 20 4 2025))) EQUALS Date 31 1 2026 -- F4
#ASSERT `the balancing payment date for` (bdt TRUE (JUST (Date 15 11 2025))) EQUALS Date 14 2 2026 -- F5
#ASSERT `the balancing payment date for` (bdt TRUE (JUST (Date 1 11 2025))) EQUALS Date 31 1 2026 -- F6
#ASSERT `the balancing payment date for` (bdt FALSE (JUST (Date 15 11 2025))) EQUALS Date 31 1 2026 -- F7
#ASSERT `the balancing payment date for` (bdt TRUE (JUST (Date 31 10 2025))) EQUALS Date 31 1 2026 -- F8
#ASSERT `the balancing payment date for` (bdt TRUE (JUST (Date 30 11 2025))) EQUALS Date 28 2 2026 -- F9
#ASSERT `the balancing payment under` (mkP 2024 0 0 1000 0.2 4000 0 500 TRUE (JUST (Date 31 12 2025))) EQUALS 3500 -- F10
#ASSERT `the balancing payment date for` (mkP 2024 0 0 1000 0.2 4000 0 500 TRUE (JUST (Date 31 12 2025))) EQUALS Date 30 3 2026 -- F10
#ASSERT `the due date for an assessment notified on` (Date 1 3 2026) EQUALS Date 31 3 2026 -- F11
#ASSERT `the due date for an assessment notified on` (Date 31 1 2026) EQUALS Date 2 3 2026 -- F12
#ASSERT `the due date for an assessment notified on` (Date 1 2 2028) EQUALS Date 2 3 2028 -- F13
#ASSERT `the due date for an assessment notified on` (Date 15 12 2025) EQUALS Date 14 1 2026 -- F14

§ `G. ss 34, 36, 36A time limits`

#ASSERT lim 2024 `no loss brought about by the taxpayer` EQUALS Date 5 4 2029 -- G1
#ASSERT lim 2024 `careless` EQUALS Date 5 4 2031 -- G2
#ASSERT lim 2024 `involving an offshore matter or transfer` EQUALS Date 5 4 2037 -- G3, G4 (careless + offshore can only be entered as offshore), G5
#ASSERT lim 2024 `deliberate, a section 7 failure, or a scheme disclosure failure` EQUALS Date 5 4 2045 -- G6, G7, G8, G9
#ASSERT lim 2019 `careless` EQUALS Date 5 4 2026 -- G10
#ASSERT lim 2019 `no loss brought about by the taxpayer` EQUALS Date 5 4 2024 -- G11

§ `H. The top-level goal, end to end`

-- Y 2024: notice 15 Nov 2025, electronic, delivered 1 Feb 2026 (on time:
-- filing date 14 Feb 2026), no amendment; prev year 5000 assessed / 1000
-- deducted; SA 9000, POAs 4000, deducted 1000; notified in time; careless.
GIVEN rf IS A `Return facts`, pf IS A `Payment facts`, ls IS A `Loss of tax`
GIVETH A `Self-assessment case`
mkC rf pf ls MEANS `Self-assessment case` OF rf, pf, ls

GIVETH A `Self-assessment position`
h1 MEANS `the self-assessment position for` c1
    WHERE
        c1 MEANS mkC (mkR 2024 (JUST (Date 15 11 2025)) TRUE (JUST (Date 1 2 2026)) NOTHING) (mkP 2024 5000 1000 1000 0.2 9000 4000 1000 TRUE (JUST (Date 15 11 2025))) `careless`

#ASSERT h1's `last day to notify chargeability` EQUALS Date 5 10 2025 -- H1
#ASSERT h1's `filing deadline` EQUALS JUST (Date 14 2 2026) -- H1
#ASSERT h1's `last day to amend the return` EQUALS Date 14 2 2027 -- H1
#ASSERT h1's `last day for a notice of enquiry` EQUALS JUST (Date 1 2 2027) -- H1
#ASSERT h1's `payments on account due` -- H1
#ASSERT h1's `each payment on account` EQUALS 2000 -- H1
#ASSERT h1's `first payment on account date` EQUALS Date 31 1 2025 -- H1
#ASSERT h1's `second payment on account date` EQUALS Date 31 7 2025 -- H1
#ASSERT h1's `balancing payment` EQUALS 4000 -- H1
#ASSERT h1's `balancing payment date` EQUALS Date 14 2 2026 -- H1
#ASSERT h1's `last day for an assessment` EQUALS Date 5 4 2031 -- H1
