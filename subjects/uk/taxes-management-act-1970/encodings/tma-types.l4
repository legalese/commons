IMPORT prelude
IMPORT daydate

-- Taxes Management Act 1970 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-1970-9.txt (point in time
-- 25 June 2026).

§ `Nouns`

DECLARE `Return facts` HAS
    -- The year of assessment, by the calendar year it begins in.
    `tax year`                                          IS A NUMBER
    -- s 8: the date of the notice to file; NOTHING if none was given.
    `notice to file given on`                           IS A MAYBE DATE
    `electronic return`                                 IS A BOOLEAN
    `delivered on`                                      IS A MAYBE DATE
    -- s 9ZA: the date of any amendment.
    `amended on`                                        IS A MAYBE DATE

DECLARE `Payment facts` HAS
    `tax year`                                          IS A NUMBER
    -- s 59A(1): for the preceding year, the amount assessed under s 9 and
    -- the tax deducted at source; and the prescribed minimum amount and
    -- proportion.
    `previous year's assessed amount`                   IS A NUMBER
    `previous year's tax deducted at source`            IS A NUMBER
    `prescribed minimum relevant amount`                IS A NUMBER
    `prescribed minimum proportion`                     IS A NUMBER
    -- s 59B(1): this year's self-assessed tax, payments on account made,
    -- and tax deducted at source.
    `self-assessed tax`                                 IS A NUMBER
    `payments on account made`                          IS A NUMBER
    `tax deducted at source`                            IS A NUMBER
    -- s 59B(3): notified chargeability within 6 months, and the date of the
    -- notice to file.
    `notified chargeability in time`                    IS A BOOLEAN
    `notice to file given on`                           IS A MAYBE DATE

DECLARE `Loss of tax` IS ONE OF
    `no loss brought about by the taxpayer`
    `careless`
    `involving an offshore matter or transfer`
    `deliberate, a section 7 failure, or a scheme disclosure failure`
