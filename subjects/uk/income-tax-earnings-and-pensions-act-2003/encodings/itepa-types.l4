IMPORT prelude
IMPORT daydate

-- Income Tax (Earnings and Pensions) Act 2003 (UK) — THE NOUNS. No rules
-- here. Source: ../registers/source-bundle/ukpga-2003-1.txt (point in time
-- 15 July 2026). Seat: the employee.

§ `Nouns`

§§ `Company car (ss 120-144)`

DECLARE `Company car` HAS
    -- the tax year that begins on 6 April of this calendar year
    `tax year beginning in`                             IS A NUMBER
    -- s 121(1) steps 1-2, ss 122-131
    `price of the car`                                  IS A NUMBER
    `price of accessories`                              IS A NUMBER
    -- s 132(3)(a): capital sums contributed in this and earlier years
    `capital contributions to date`                     IS A NUMBER
    -- s 134, 139(4)
    `CO2 emissions figure`                              IS A NUMBER
    -- s 141(1)-(1A): a diesel car to which s 141 applies
    `a diesel car under s 141`                          IS A BOOLEAN
    -- s 143(2)(a)-(b): the first and last days in the year it was available
    `first day available`                               IS A DATE
    `last day available`                                IS A DATE
    -- s 143(2)(c): days in periods of 30 days or more throughout which it was
    -- not available
    `days in long periods unavailable`                  IS A NUMBER
    -- s 144(1)
    `payment for private use required`                  IS A BOOLEAN
    `amount paid for private use`                       IS A NUMBER
    `paid for private use on`                           IS A MAYBE DATE

§§ `Cheap loans (ss 173-183)`

DECLARE `Cheap loan` HAS
    -- s 182 step 1: the maximum outstanding on the 5 April before the year
    -- (or the day made), and on the 5 April of the year (or the day
    -- discharged)
    `outstanding at the start`                          IS A NUMBER
    `outstanding at the end`                            IS A NUMBER
    -- s 181, 182 step 2: the official rate, or the average official rate, as
    -- a percentage
    `official rate, percent`                            IS A NUMBER
    -- s 182 step 3: whole months outstanding (a month begins on the 6th)
    `whole months outstanding`                          IS A NUMBER
    `interest paid for the year`                        IS A NUMBER
    -- s 180(2): the highest aggregate of taxable cheap loans outstanding at
    -- any time in the year
    `highest aggregate outstanding`                     IS A NUMBER
    -- ss 176-179
    `an exception applies`                              IS A BOOLEAN

§§ `Termination payments (ss 401-404)`

DECLARE `Termination case` HAS
    -- s 402E(3)
    `a notice case`                                     IS A BOOLEAN
    `notice given on`                                   IS A MAYBE DATE
    `last day of employment`                            IS A DATE
    -- s 402E(4): the minimum notice the employer must give, in days, or in
    -- whole months where the contract expresses it so (s 402D(6))
    `minimum notice in days`                            IS A NUMBER
    `minimum notice in whole months`                    IS A MAYBE NUMBER
    -- s 402D(3), (6)-(6A): the last pay period before the trigger date
    `basic pay for the last pay period`                 IS A NUMBER
    `days in the last pay period`                       IS A NUMBER
    `paid monthly in equal instalments`                 IS A BOOLEAN
    -- s 402D(1): T
    `T, the other taxable termination amounts`          IS A NUMBER
    -- s 402C(2): the relevant termination awards (not redundancy pay or the
    -- approved contractual part)
    `relevant termination awards`                       IS A NUMBER
    `redundancy and approved contractual parts`         IS A NUMBER
    -- s 403(4): earlier payments set against the £30,000 threshold
    `earlier amounts against the threshold`             IS A NUMBER
