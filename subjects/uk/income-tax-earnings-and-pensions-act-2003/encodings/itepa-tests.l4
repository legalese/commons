IMPORT prelude
IMPORT daydate
IMPORT `itepa-types`
IMPORT `itepa-rules`
IMPORT `itepa-goal`

-- Income Tax (Earnings and Pensions) Act 2003 (UK) — the encoder's tests.
-- Expected values are worked by hand from the Act.

§ `Tests`

§§ `Goal 1 — company car`

-- Fields: tax year, price, accessories, contributions, CO2, diesel, first
-- available, last available, long unavailable days, payment required,
-- amount paid, paid on.
-- 2026-27: price £30,000 + £1,000 accessories − £5,000 (of £6,000
-- contributed) = £26,000; 112 g/km rounds to 110: 21 + 7 = 28%: £7,280.
GIVEN co2 IS A NUMBER, dsl IS A BOOLEAN, fst IS A DATE, amt IS A NUMBER, pdon IS A MAYBE DATE
GIVETH A `Company car`
`a car of` co2 `g, diesel` dsl `, from` fst `, paying` amt `on` pdon MEANS
    `Company car` OF 2026, 30000, 1000, 6000, co2, dsl, fst, Date 5 4 2027, 0, TRUE, amt, pdon

#ASSERT `the interim sum for` (`a car of` 112 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 0 `on` NOTHING) EQUALS 26000
#ASSERT `the appropriate percentage for` (`a car of` 112 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 0 `on` NOTHING) EQUALS JUST 28
#ASSERT `the cash equivalent of my car` (`a car of` 112 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 0 `on` NOTHING) EQUALS JUST 7280
-- s 144: £1,200 paid on 6 July 2027 counts; on 7 July it does not.
#ASSERT `the cash equivalent of my car` (`a car of` 112 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 1200 `on` (JUST (Date 6 7 2027))) EQUALS JUST 6080
#ASSERT `the cash equivalent of my car` (`a car of` 112 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 1200 `on` (JUST (Date 7 7 2027))) EQUALS JUST 7280
#ASSERT `the cash equivalent of my car` (`a car of` 112 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 9000 `on` (JUST (Date 6 7 2027))) EQUALS JUST 0
-- s 143: first available 5 July 2026: 90 days unavailable of 365.
#ASSERT `the days unavailable for` (`a car of` 112 `g, diesel` FALSE `, from` (Date 5 7 2026) `, paying` 0 `on` NOTHING) EQUALS 90
#ASSERT `the days in the tax year for` (`a car of` 112 `g, diesel` FALSE `, from` (Date 5 7 2026) `, paying` 0 `on` NOTHING) EQUALS 365
#ASSERT `the cash equivalent of my car` (`a car of` 112 `g, diesel` FALSE `, from` (Date 5 7 2026) `, paying` 0 `on` NOTHING) EQUALS JUST (400400/73)
-- s 139(3)-(4), 141
#ASSERT `the appropriate percentage for` (`a car of` 75 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 0 `on` NOTHING) EQUALS JUST 21
#ASSERT `the appropriate percentage for` (`a car of` 79.9 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 0 `on` NOTHING) EQUALS JUST 21
#ASSERT `the appropriate percentage for` (`a car of` 80 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 0 `on` NOTHING) EQUALS JUST 22
#ASSERT `the appropriate percentage for` (`a car of` 160 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 0 `on` NOTHING) EQUALS JUST 37
#ASSERT `the appropriate percentage for` (`a car of` 160 `g, diesel` TRUE `, from` (Date 6 4 2026) `, paying` 0 `on` NOTHING) EQUALS JUST 35
#ASSERT `the appropriate percentage for` (`a car of` 112 `g, diesel` TRUE `, from` (Date 6 4 2026) `, paying` 0 `on` NOTHING) EQUALS JUST 32
#ASSERT `the appropriate percentage for` (`a car of` 74.9 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 0 `on` NOTHING) EQUALS NOTHING
#ASSERT `the cash equivalent of my car` (`a car of` 74.9 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 0 `on` NOTHING) EQUALS NOTHING
-- 2027-28 includes 29 February 2028: 366 days.
#ASSERT `the days in the tax year for` (`Company car` OF 2027, 30000, 0, 0, 112, FALSE, Date 6 4 2027, Date 5 4 2028, 0, FALSE, 0, NOTHING) EQUALS 366

§§ `Goal 2 — cheap loans`

-- Fields: start, end, rate, months, interest paid, highest, exception.
-- (£20,000 + £10,000) ÷ 2 × 3.75% × 12 ÷ 12 = £562.50.
#ASSERT `the cash equivalent of my loan` (`Cheap loan` OF 20000, 10000, 3.75, 12, 0, 20000, FALSE) EQUALS 562.5
#ASSERT `the cash equivalent of my loan` (`Cheap loan` OF 20000, 10000, 3.75, 12, 100, 20000, FALSE) EQUALS 462.5
#ASSERT `the cash equivalent of my loan` (`Cheap loan` OF 20000, 10000, 3.75, 6, 0, 20000, FALSE) EQUALS 281.25
#ASSERT `the cash equivalent of my loan` (`Cheap loan` OF 10000, 10000, 3.75, 12, 0, 10000, FALSE) EQUALS 0
#ASSERT `the cash equivalent of my loan` (`Cheap loan` OF 20000, 10000, 3.75, 12, 600, 20000, FALSE) EQUALS 0
#ASSERT `the cash equivalent of my loan` (`Cheap loan` OF 20000, 10000, 3.75, 12, 0, 20000, TRUE) EQUALS 0

§§ `Goal 3 — termination payments`

-- Fields: notice case, notice given, last day, notice days, notice months,
-- basic pay, pay period days, monthly, T, relevant awards, redundancy and
-- approved parts, earlier amounts.
-- No notice; last day 31 March 2026; 12 weeks' notice; weekly pay £1,400:
-- the earliest lawful termination date is 23 June; 84 days; £16,800.
weekly MEANS `Termination case` OF FALSE, NOTHING, Date 31 3 2026, 84, NOTHING, 1400, 7, FALSE, 0, 50000, 0, 0
#ASSERT `the earliest lawful termination date for` weekly EQUALS Date 23 6 2026
#ASSERT `my post-employment notice pay for` weekly EQUALS 16800
#ASSERT `the part taxed as earnings under s 402B for` weekly EQUALS 16800
#ASSERT `the part taxed above the threshold for` weekly EQUALS 3200
#ASSERT `my post-employment notice pay for` (`Termination case` OF FALSE, NOTHING, Date 31 3 2026, 84, NOTHING, 1400, 7, FALSE, 2000, 50000, 0, 0) EQUALS 14800

-- Monthly pay £3,000; three months' notice; no notice given; last day
-- 31 March 2026: 30 June, a whole three months: £9,000 (s 402D(6)).
monthly MEANS `Termination case` OF FALSE, NOTHING, Date 31 3 2026, 0, JUST 3, 3000, 31, TRUE, 0, 20000, 15000, 0
#ASSERT `the earliest lawful termination date for` monthly EQUALS Date 30 6 2026
#ASSERT `my post-employment notice pay for` monthly EQUALS 9000
#ASSERT `the part taxed as earnings under s 402B for` monthly EQUALS 9000
#ASSERT `the part taxed above the threshold for` monthly EQUALS 0
#ASSERT `the part taxed above the threshold for` (`Termination case` OF FALSE, NOTHING, Date 31 3 2026, 0, JUST 3, 3000, 31, TRUE, 0, 20000, 15000, 10000) EQUALS 6000

-- Notice given 15 March 2026 (three months: 15 June); last day 31 March:
-- 76 days, not a whole number of months: £3,000 × 76 ÷ 30.42 (s 402D(6A)).
#ASSERT `my post-employment notice pay for` (`Termination case` OF TRUE, JUST (Date 15 3 2026), Date 31 3 2026, 0, JUST 3, 3000, 31, TRUE, 0, 20000, 0, 0) EQUALS 3800000/507
-- Four weeks' notice given 1 January 2026, working until 31 March: nil.
#ASSERT `my post-employment notice pay for` (`Termination case` OF TRUE, JUST (Date 1 1 2026), Date 31 3 2026, 28, NOTHING, 1400, 7, FALSE, 0, 20000, 0, 0) EQUALS 0
#ASSERT `the part taxed above the threshold for` (`Termination case` OF TRUE, JUST (Date 1 1 2026), Date 31 3 2026, 28, NOTHING, 1400, 7, FALSE, 0, 40000, 0, 0) EQUALS 10000

§§ `The top-level goal`

empty MEANS `Employee case` OF NOTHING, NOTHING, NOTHING
full MEANS `Employee case` OF JUST (`a car of` 112 `g, diesel` FALSE `, from` (Date 6 4 2026) `, paying` 0 `on` NOTHING), JUST (`Cheap loan` OF 20000, 10000, 3.75, 12, 0, 20000, FALSE), JUST weekly

#ASSERT (`the employee position for` empty)'s `cash equivalent of the car` EQUALS NOTHING
#ASSERT (`the employee position for` empty)'s `post-employment notice pay` EQUALS NOTHING
#ASSERT (`the employee position for` full)'s `appropriate percentage for the car` EQUALS JUST 28
#ASSERT (`the employee position for` full)'s `cash equivalent of the car` EQUALS JUST 7280
#ASSERT (`the employee position for` full)'s `cash equivalent of the loan` EQUALS JUST 562.5
#ASSERT (`the employee position for` full)'s `earliest lawful termination date` EQUALS JUST (Date 23 6 2026)
#ASSERT (`the employee position for` full)'s `post-employment notice pay` EQUALS JUST 16800
#ASSERT (`the employee position for` full)'s `taxed as earnings under s 402B` EQUALS JUST 16800
#ASSERT (`the employee position for` full)'s `taxed above the £30,000 threshold` EQUALS JUST 3200
