IMPORT prelude
IMPORT daydate
IMPORT `itepa-types`
IMPORT `itepa-rules`
IMPORT `itepa-goal`

-- Independent tests for the ITEPA 2003 encoding. Expectations come from
-- independent-expectations.md, written from BRIEF.md and the source text
-- before the encoding was read. Scenario ids (A1, B1, C1 ...) match that file.

§ `Independent tests`

§§ `Helpers`

-- A car priced £30,000 with £1,000 accessories.
GIVEN yr IS A NUMBER, co IS A NUMBER, dz IS A BOOLEAN, cc IS A NUMBER,
      fd IS A DATE, ld IS A DATE, lg IS A NUMBER, am IS A NUMBER, pd IS A MAYBE DATE
GIVETH A `Company car`
`a test car` MEANS
    `Company car` OF yr, 30000, 1000, cc, co, dz, fd, ld, lg, am GREATER THAN 0, am, pd

-- The base car for 2025-26, available all year, no payments.
GIVEN co IS A NUMBER, dz IS A BOOLEAN
GIVETH A `Company car`
`a base car` MEANS
    `a test car` 2025 co dz 2000 (Date 6 4 2025) (Date 5 4 2026) 0 0 NOTHING

GIVEN c IS A `Company car`
GIVETH A MAYBE NUMBER
`pct` MEANS `the appropriate percentage for` c

GIVEN c IS A `Company car`
GIVETH A MAYBE NUMBER
`cash` MEANS `the cash equivalent of my car` c

GIVEN s IS A NUMBER, e IS A NUMBER, r IS A NUMBER, m IS A NUMBER, ip IS A NUMBER, h IS A NUMBER, x IS A BOOLEAN
GIVETH A `Cheap loan`
`a test loan` MEANS `Cheap loan` OF s, e, r, m, ip, h, x

GIVEN nc IS A BOOLEAN, ng IS A MAYBE DATE, ld IS A DATE, nd IS A NUMBER, nm IS A MAYBE NUMBER,
      bp IS A NUMBER, pp IS A NUMBER, mo IS A BOOLEAN, tt IS A NUMBER, rel IS A NUMBER,
      red IS A NUMBER, ea IS A NUMBER
GIVETH A `Termination case`
`a test termination` MEANS
    `Termination case` OF nc, ng, ld, nd, nm, bp, pp, mo, tt, rel, red, ea

-- Weekly-paid (£700 for 7 days), non-notice, last day 31 Mar 2026, 30 days' notice.
GIVEN tt IS A NUMBER, rel IS A NUMBER, red IS A NUMBER, ea IS A NUMBER
GIVETH A `Termination case`
`a weekly termination` MEANS
    `a test termination` FALSE NOTHING (Date 31 3 2026) 30 NOTHING 700 7 FALSE tt rel red ea

-- Monthly-paid (£3,000), notice case, notice 15 Jan 2026, 3 whole months.
GIVEN ld IS A DATE, rel IS A NUMBER
GIVETH A `Termination case`
`a monthly termination` MEANS
    `a test termination` TRUE (JUST (Date 15 1 2026)) ld 90 (JUST 3) 3000 31 TRUE 0 rel 0 0

GIVEN t IS A `Termination case`
GIVETH A NUMBER
`penp` MEANS `my post-employment notice pay for` t

GIVEN t IS A `Termination case`
GIVETH A DATE
`eltd` MEANS `the earliest lawful termination date for` t

GIVEN t IS A `Termination case`
GIVETH A NUMBER
`under 402B` MEANS `the part taxed as earnings under s 402B for` t

GIVEN t IS A `Termination case`
GIVETH A NUMBER
`under 403` MEANS `the part taxed above the threshold for` t

GIVEN t IS A `Termination case`
GIVETH A NUMBER
`penp days` MEANS `the days in the post-employment notice period for` t

§§ `A. Company car`

-- A1-A9: s 139(3)-(4), petrol
#ASSERT `pct` (`a base car` 75 FALSE) EQUALS JUST 21
#ASSERT `pct` (`a base car` 79.9 FALSE) EQUALS JUST 21
#ASSERT `pct` (`a base car` 79 FALSE) EQUALS JUST 21
#ASSERT `pct` (`a base car` 80 FALSE) EQUALS JUST 22
#ASSERT `pct` (`a base car` 120 FALSE) EQUALS JUST 30
#ASSERT `pct` (`a base car` 155 FALSE) EQUALS JUST 37
#ASSERT `pct` (`a base car` 160 FALSE) EQUALS JUST 37
#ASSERT `pct` (`a base car` 74.9 FALSE) EQUALS NOTHING
#ASSERT `pct` (`a base car` 74 FALSE) EQUALS NOTHING

-- A10-A15: s 141(2), diesel
#ASSERT `pct` (`a base car` 75 TRUE) EQUALS JUST 25
#ASSERT `pct` (`a base car` 120 TRUE) EQUALS JUST 34
#ASSERT `pct` (`a base car` 125 TRUE) EQUALS JUST 35
#ASSERT `pct` (`a base car` 140 TRUE) EQUALS JUST 35
#ASSERT `pct` (`a base car` 160 TRUE) EQUALS JUST 35
#ASSERT `pct` (`a base car` 74 TRUE) EQUALS NOTHING

-- A16: base car, interim £29,000, cash £8,700
#ASSERT `the interim sum for` (`a base car` 120 FALSE) EQUALS 29000
#ASSERT `cash` (`a base car` 120 FALSE) EQUALS JUST 8700

-- A17-A19: s 132(3) £5,000 cap
#ASSERT `the interim sum for` (`a test car` 2025 120 FALSE 7000 (Date 6 4 2025) (Date 5 4 2026) 0 0 NOTHING) EQUALS 26000
#ASSERT `cash` (`a test car` 2025 120 FALSE 7000 (Date 6 4 2025) (Date 5 4 2026) 0 0 NOTHING) EQUALS JUST 7800
#ASSERT `cash` (`a test car` 2025 120 FALSE 5000 (Date 6 4 2025) (Date 5 4 2026) 0 0 NOTHING) EQUALS JUST 7800
#ASSERT `cash` (`a test car` 2025 120 FALSE 0 (Date 6 4 2025) (Date 5 4 2026) 0 0 NOTHING) EQUALS JUST 9300

-- A20: first available 6 May 2025 (U = 30)
#ASSERT `the days unavailable for` (`a test car` 2025 120 FALSE 2000 (Date 6 5 2025) (Date 5 4 2026) 0 0 NOTHING) EQUALS 30
#ASSERT `cash` (`a test car` 2025 120 FALSE 2000 (Date 6 5 2025) (Date 5 4 2026) 0 0 NOTHING) EQUALS JUST (582900/73)

-- A21: last available 5 Jan 2026 (U = 90)
#ASSERT `the days unavailable for` (`a test car` 2025 120 FALSE 2000 (Date 6 4 2025) (Date 5 1 2026) 0 0 NOTHING) EQUALS 90
#ASSERT `cash` (`a test car` 2025 120 FALSE 2000 (Date 6 4 2025) (Date 5 1 2026) 0 0 NOTHING) EQUALS JUST (478500/73)

-- A22: a 45-day gap
#ASSERT `cash` (`a test car` 2025 120 FALSE 2000 (Date 6 4 2025) (Date 5 4 2026) 45 0 NOTHING) EQUALS JUST (556800/73)

-- A23: a 29-day gap does not count (s 143(2)(c) "30 days or more"); the
-- days input is of long periods only, so a 29-day gap is entered as 0.
#ASSERT `cash` (`a test car` 2025 120 FALSE 2000 (Date 6 4 2025) (Date 5 4 2026) 0 0 NOTHING) EQUALS JUST 8700

-- A24: a gap of exactly 30 days
#ASSERT `cash` (`a test car` 2025 120 FALSE 2000 (Date 6 4 2025) (Date 5 4 2026) 30 0 NOTHING) EQUALS JUST (582900/73)

-- A25: start 30 + end 90 + gap 45 = 165
#ASSERT `the days unavailable for` (`a test car` 2025 120 FALSE 2000 (Date 6 5 2025) (Date 5 1 2026) 45 0 NOTHING) EQUALS 165
#ASSERT `cash` (`a test car` 2025 120 FALSE 2000 (Date 6 5 2025) (Date 5 1 2026) 45 0 NOTHING) EQUALS JUST (348000/73)

-- A26: leap tax year 2023-24, first available 6 Jun 2023 (U = 61, Y = 366)
#ASSERT `the days in the tax year for` (`a test car` 2023 120 FALSE 2000 (Date 6 6 2023) (Date 5 4 2024) 0 0 NOTHING) EQUALS 366
#ASSERT `the days unavailable for` (`a test car` 2023 120 FALSE 2000 (Date 6 6 2023) (Date 5 4 2024) 0 0 NOTHING) EQUALS 61
#ASSERT `cash` (`a test car` 2023 120 FALSE 2000 (Date 6 6 2023) (Date 5 4 2024) 0 0 NOTHING) EQUALS JUST 7250
#ASSERT `the days in the tax year for` (`a base car` 120 FALSE) EQUALS 365

-- A27-A30: s 144, payments for private use
#ASSERT `cash` (`a test car` 2025 120 FALSE 2000 (Date 6 4 2025) (Date 5 4 2026) 0 1200 (JUST (Date 6 7 2026))) EQUALS JUST 7500
#ASSERT `cash` (`a test car` 2025 120 FALSE 2000 (Date 6 4 2025) (Date 5 4 2026) 0 1200 (JUST (Date 7 7 2026))) EQUALS JUST 8700
#ASSERT `cash` (`a test car` 2025 120 FALSE 2000 (Date 6 4 2025) (Date 5 4 2026) 0 1200 (JUST (Date 1 12 2025))) EQUALS JUST 7500
#ASSERT `cash` (`a test car` 2025 120 FALSE 2000 (Date 6 4 2025) (Date 5 4 2026) 0 10000 (JUST (Date 1 7 2026))) EQUALS JUST 0

-- A31: unavailability first, then payments
#ASSERT `cash` (`a test car` 2025 120 FALSE 2000 (Date 6 5 2025) (Date 5 4 2026) 0 1200 (JUST (Date 1 7 2026))) EQUALS JUST (495300/73)

-- A8 via the cash equivalent: below 75 g/km the cash equivalent is NOTHING
#ASSERT `cash` (`a base car` 74 FALSE) EQUALS NOTHING

§§ `B. Cheap loans`

-- B1: £20,000, 3.75%, 12 months, nothing paid
#ASSERT `the interest at the official rate on` (`a test loan` 20000 20000 3.75 12 0 20000 FALSE) EQUALS 750
#ASSERT `a taxable cheap loan` (`a test loan` 20000 20000 3.75 12 0 20000 FALSE)
#ASSERT `the cash equivalent of my loan` (`a test loan` 20000 20000 3.75 12 0 20000 FALSE) EQUALS 750
-- B2
#ASSERT `the cash equivalent of my loan` (`a test loan` 20000 20000 3.75 12 300 20000 FALSE) EQUALS 450
-- B3: interest paid above the official amount
#ASSERT NOT (`a taxable cheap loan` (`a test loan` 20000 20000 3.75 12 800 20000 FALSE))
#ASSERT `the cash equivalent of my loan` (`a test loan` 20000 20000 3.75 12 800 20000 FALSE) EQUALS 0
-- B4: interest paid equal to the official amount
#ASSERT NOT (`a taxable cheap loan` (`a test loan` 20000 20000 3.75 12 750 20000 FALSE))
#ASSERT `the cash equivalent of my loan` (`a test loan` 20000 20000 3.75 12 750 20000 FALSE) EQUALS 0
-- B5: £10,000 at all times
#ASSERT `the cash equivalent of my loan` (`a test loan` 10000 10000 3.75 12 0 10000 FALSE) EQUALS 0
-- B6: £10,001
#ASSERT `the cash equivalent of my loan` (`a test loan` 10001 10001 3.75 12 0 10001 FALSE) EQUALS 375.0375
-- B7: made in the year, 8 months
#ASSERT `the cash equivalent of my loan` (`a test loan` 30000 10000 3.75 8 0 30000 FALSE) EQUALS 500
-- B8: an exception applies
#ASSERT NOT (`a taxable cheap loan` (`a test loan` 20000 20000 3.75 12 0 20000 TRUE))
#ASSERT `the cash equivalent of my loan` (`a test loan` 20000 20000 3.75 12 0 20000 TRUE) EQUALS 0
-- B9: opening and closing £8,000, highest £12,000
#ASSERT `the cash equivalent of my loan` (`a test loan` 8000 8000 3.75 12 0 12000 FALSE) EQUALS 300
-- B10: average rate 2.5%, 6 months
#ASSERT `the cash equivalent of my loan` (`a test loan` 20000 20000 2.5 6 0 20000 FALSE) EQUALS 250

§§ `C. Termination`

-- C1: non-notice, last day 31 Mar 2026, 30 days
#ASSERT `the trigger date for` (`a weekly termination` 0 0 0 0) EQUALS Date 31 3 2026
#ASSERT `eltd` (`a weekly termination` 0 0 0 0) EQUALS Date 30 4 2026
#ASSERT `penp days` (`a weekly termination` 0 0 0 0) EQUALS 30
#ASSERT `penp` (`a weekly termination` 0 0 0 0) EQUALS 3000
-- C2, C3: T
#ASSERT `penp` (`a weekly termination` 1000 0 0 0) EQUALS 2000
#ASSERT `penp` (`a weekly termination` 5000 0 0 0) EQUALS 0
-- C4: awards £50,000
#ASSERT `under 402B` (`a weekly termination` 0 50000 0 0) EQUALS 3000
#ASSERT `under 403` (`a weekly termination` 0 50000 0 0) EQUALS 17000
-- C5: PENP nil, awards £50,000
#ASSERT `under 402B` (`a weekly termination` 5000 50000 0 0) EQUALS 0
#ASSERT `under 403` (`a weekly termination` 5000 50000 0 0) EQUALS 20000

-- C6: notice case, notice 1 Mar 2026, 84 days, last day 31 Mar 2026
#ASSERT `the trigger date for` (`a test termination` TRUE (JUST (Date 1 3 2026)) (Date 31 3 2026) 84 NOTHING 700 7 FALSE 0 0 0 0) EQUALS Date 1 3 2026
#ASSERT `eltd` (`a test termination` TRUE (JUST (Date 1 3 2026)) (Date 31 3 2026) 84 NOTHING 700 7 FALSE 0 0 0 0) EQUALS Date 24 5 2026
#ASSERT `penp days` (`a test termination` TRUE (JUST (Date 1 3 2026)) (Date 31 3 2026) 84 NOTHING 700 7 FALSE 0 0 0 0) EQUALS 54
#ASSERT `penp` (`a test termination` TRUE (JUST (Date 1 3 2026)) (Date 31 3 2026) 84 NOTHING 700 7 FALSE 0 0 0 0) EQUALS 5400
-- C7: notice served in full
#ASSERT `eltd` (`a test termination` TRUE (JUST (Date 1 3 2026)) (Date 31 3 2026) 30 NOTHING 700 7 FALSE 0 0 0 0) EQUALS Date 31 3 2026
#ASSERT `penp days` (`a test termination` TRUE (JUST (Date 1 3 2026)) (Date 31 3 2026) 30 NOTHING 700 7 FALSE 0 0 0 0) EQUALS 0
#ASSERT `penp` (`a test termination` TRUE (JUST (Date 1 3 2026)) (Date 31 3 2026) 30 NOTHING 700 7 FALSE 0 0 0 0) EQUALS 0
-- C8: worked beyond the notice
#ASSERT `penp days` (`a test termination` TRUE (JUST (Date 1 3 2026)) (Date 31 3 2026) 14 NOTHING 700 7 FALSE 0 0 0 0) EQUALS 0
#ASSERT `penp` (`a test termination` TRUE (JUST (Date 1 3 2026)) (Date 31 3 2026) 14 NOTHING 700 7 FALSE 0 0 0 0) EQUALS 0
-- C9: nil minimum notice
#ASSERT `eltd` (`a test termination` FALSE NOTHING (Date 31 3 2026) 0 NOTHING 700 7 FALSE 0 0 0 0) EQUALS Date 31 3 2026
#ASSERT `penp` (`a test termination` FALSE NOTHING (Date 31 3 2026) 0 NOTHING 700 7 FALSE 0 0 0 0) EQUALS 0

-- C10: whole months, last day 15 Jan 2026: D = 3, P = 1
#ASSERT `eltd` (`a monthly termination` (Date 15 1 2026) 0) EQUALS Date 15 4 2026
#ASSERT `penp` (`a monthly termination` (Date 15 1 2026) 0) EQUALS 9000
-- C11: last day 15 Feb 2026: 2 whole months
#ASSERT `penp` (`a monthly termination` (Date 15 2 2026) 0) EQUALS 6000
-- C12: last day 1 Feb 2026: 73 days ÷ 30.42
#ASSERT `penp days` (`a monthly termination` (Date 1 2 2026) 0) EQUALS 73
#ASSERT `penp` (`a monthly termination` (Date 1 2 2026) 0) EQUALS 3650000/507
-- C13: monthly pay, 56 days' notice, non-notice, last day 31 Mar 2026
#ASSERT `eltd` (`a test termination` FALSE NOTHING (Date 31 3 2026) 56 NOTHING 3000 31 TRUE 0 0 0 0) EQUALS Date 26 5 2026
#ASSERT `penp` (`a test termination` FALSE NOTHING (Date 31 3 2026) 56 NOTHING 3000 31 TRUE 0 0 0 0) EQUALS 2800000/507
-- C14, C15: month notice from a month end
#ASSERT `eltd` (`a test termination` FALSE NOTHING (Date 31 1 2026) 0 (JUST 1) 3000 31 TRUE 0 0 0 0) EQUALS Date 28 2 2026
#ASSERT `eltd` (`a test termination` FALSE NOTHING (Date 31 1 2028) 0 (JUST 1) 3000 31 TRUE 0 0 0 0) EQUALS Date 29 2 2028

-- C16: awards £30,000, PENP £3,000
#ASSERT `under 402B` (`a weekly termination` 0 30000 0 0) EQUALS 3000
#ASSERT `under 403` (`a weekly termination` 0 30000 0 0) EQUALS 0
-- C17: redundancy £10,000 + relevant £20,000
#ASSERT `under 402B` (`a weekly termination` 0 20000 10000 0) EQUALS 3000
#ASSERT `under 403` (`a weekly termination` 0 20000 10000 0) EQUALS 0
-- C18: with earlier £5,000
#ASSERT `under 403` (`a weekly termination` 0 20000 10000 5000) EQUALS 2000
-- C19, C20: PENP nil, relevant £40,000, earlier £25,000 / £35,000
#ASSERT `under 403` (`a test termination` TRUE (JUST (Date 1 3 2026)) (Date 31 3 2026) 30 NOTHING 700 7 FALSE 0 40000 0 25000) EQUALS 35000
#ASSERT `under 403` (`a test termination` TRUE (JUST (Date 1 3 2026)) (Date 31 3 2026) 30 NOTHING 700 7 FALSE 0 40000 0 35000) EQUALS 40000
-- C21: PENP £9,000 at least the relevant awards £8,000
#ASSERT `under 402B` (`a monthly termination` (Date 15 1 2026) 8000) EQUALS 8000
#ASSERT `under 403` (`a monthly termination` (Date 15 1 2026) 8000) EQUALS 0
-- C22: approved contractual £15,000, £12,000 within the redundancy amount
#ASSERT `under 402B` (`a weekly termination` 0 3000 12000 0) EQUALS 3000
#ASSERT `under 403` (`a weekly termination` 0 3000 12000 0) EQUALS 0

§§ `Top-level goal`

#ASSERT (`the employee position for` (`Employee case` OF (JUST (`a base car` 120 FALSE)), NOTHING, NOTHING))'s `cash equivalent of the car` EQUALS JUST 8700
#ASSERT (`the employee position for` (`Employee case` OF NOTHING, (JUST (`a test loan` 20000 20000 3.75 12 0 20000 FALSE)), NOTHING))'s `cash equivalent of the loan` EQUALS JUST 750
#ASSERT (`the employee position for` (`Employee case` OF NOTHING, NOTHING, (JUST (`a weekly termination` 0 50000 0 0))))'s `taxed above the £30,000 threshold` EQUALS JUST 17000
#ASSERT (`the employee position for` (`Employee case` OF NOTHING, NOTHING, NOTHING))'s `post-employment notice pay` EQUALS NOTHING
