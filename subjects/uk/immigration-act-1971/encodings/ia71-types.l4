IMPORT prelude
IMPORT daydate

-- Immigration Act 1971 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-1971-77.txt (point in time
-- 5 January 2026).

§ `Nouns`

DECLARE `Person facts` HAS
    `a British citizen`                                 IS A BOOLEAN
    -- s 2(1)(b): a Commonwealth citizen with the right of abode immediately
    -- before the British Nationality Act 1981 commenced.
    `a Commonwealth citizen with the right of abode before 1983` IS A BOOLEAN
    `still a Commonwealth citizen`                      IS A BOOLEAN
    `an Irish citizen`                                  IS A BOOLEAN
    -- s 3ZA(2)-(4): subject to a deportation order, notified exclusion
    -- directions, or an excluded person under s 8B.
    `deported, excluded by directions, or excluded under s 8B` IS A BOOLEAN
    -- s 1(3): arriving on a local journey from the Islands or Ireland.
    `arriving on a local journey within the common travel area` IS A BOOLEAN

DECLARE `Leave extension facts` HAS
    `leave expires on`                                  IS A DATE
    `application made on`                               IS A DATE
    -- s 3C(2)(a): the day the application was decided or withdrawn; NOTHING
    -- if still undecided.
    `decided or withdrawn on`                           IS A MAYBE DATE
    -- s 3C(2)(b)-(d): the last day an in-country appeal or administrative
    -- review could be brought or was pending; NOTHING if none.
    `appeal or review rights end on`                    IS A MAYBE DATE
    -- s 3C(3): the day the applicant left the UK; NOTHING if they have not.
    `left the United Kingdom on`                        IS A MAYBE DATE

DECLARE `Offence` IS ONE OF
    `entering in breach of a deportation order (A1)`
    `entering without leave (B1)`
    `overstaying (C1)`
    `arriving without entry clearance (D1)`
    `arriving without an ETA (E1)`
    `endangering life on a journey by water, with an (A1) offence (E1A)`
    `endangering life on a journey by water, with a (B1), (D1) or (E1) offence (E1A)`
    `failing to observe a condition of leave (1)(b)`
    `remaining beyond the time allowed by s 8(1) (1)(c)`
    `breaching an immigration bail condition (1)(h)`
    `illegal working (24B)`

DECLARE `Jurisdiction` IS ONE OF `England and Wales`, `Scotland`, `Northern Ireland`

DECLARE `Offence facts` HAS
    `offence`                                           IS AN `Offence`
    `committed on`                                      IS A DATE
    `jurisdiction`                                      IS A `Jurisdiction`
    -- s 24(F1)(a), (G1): the general limit in a magistrates' court, in
    -- months; and whether the offence was committed before it applied.
    `the general limit in months`                       IS A NUMBER
    `committed before the general limit applied`        IS A BOOLEAN
    -- s 24B(4): committed before s 281(5) of the Criminal Justice Act 2003
    -- came into force.
    `committed before s 281(5) CJA 2003 in force`       IS A BOOLEAN
    -- s 28(1)(a): the date certified as when sufficient evidence came to the
    -- police's notice; s 28(1A)(a)(ii): the first arrest.
    `evidence certified on`                             IS A MAYBE DATE
    `first arrested on`                                 IS A MAYBE DATE
