IMPORT prelude
IMPORT daydate
IMPORT `nmw-types`
IMPORT `nmw-qualification`
IMPORT `nmw-arrears`
IMPORT `nmw-records`
IMPORT `nmw-goal`

-- National Minimum Wage Act 1998 (UK) — INDEPENDENT TESTS.
--
-- The expected values come from independent-expectations.md, which was written
-- from the Act alone before any .l4 module was read. Scenario ids (Q, S, P, C,
-- E, F, G) match that file. A failing assertion is a finding: the expected
-- values have not been changed to match the code.

§ `Independent tests`

§§ `Builders`

noVol MEANS `Voluntary work facts` OF FALSE, FALSE, FALSE, FALSE, FALSE
noCom MEANS `Community facts` OF FALSE, FALSE, FALSE, FALSE, FALSE

-- Baseline: worker under a contract of employment, works in the UK, past
-- school age, no exclusion; only the kind of work varies.
GIVEN k IS A `Kind of work`
GIVETH A `Qualification facts`
baselineDoing k MEANS
    `Qualification facts` OF JUST TRUE, FALSE, FALSE, JUST TRUE, FALSE, FALSE, TRUE, JUST TRUE, FALSE, k, noVol, noCom

baseline MEANS baselineDoing `ordinary work`

-- The three s 1(2) MAYBE facts and the s 34 / s 35 flags.
GIVEN wc IS A MAYBE BOOLEAN, ag IS A BOOLEAN, hw IS A BOOLEAN, uk IS A MAYBE BOOLEAN, sch IS A MAYBE BOOLEAN
GIVETH A `Qualification facts`
personWith wc ag hw uk sch MEANS
    `Qualification facts` OF wc, ag, hw, uk, FALSE, FALSE, TRUE, sch, FALSE, `ordinary work`, noVol, noCom

-- The s 40 mariner facts, with the individual not otherwise working in the UK.
GIVEN ship IS A BOOLEAN, wout IS A BOOLEAN, ores IS A BOOLEAN
GIVETH A `Qualification facts`
marinerWith ship wout ores MEANS
    `Qualification facts` OF JUST TRUE, FALSE, FALSE, JUST FALSE, ship, wout, ores, JUST TRUE, FALSE, `ordinary work`, noVol, noCom

GIVEN v IS A `Voluntary work facts`
GIVETH A `Qualification facts`
volunteerWith v MEANS
    `Qualification facts` OF JUST TRUE, FALSE, FALSE, JUST TRUE, FALSE, FALSE, TRUE, JUST TRUE, FALSE, `ordinary work`, v, noCom

GIVEN cm IS A `Community facts`
GIVETH A `Qualification facts`
memberWith cm MEANS
    `Qualification facts` OF JUST TRUE, FALSE, FALSE, JUST TRUE, FALSE, FALSE, TRUE, JUST TRUE, FALSE, `ordinary work`, noVol, cm

GIVEN q IS A `Qualification facts`
GIVETH A BOOLEAN
qual q MEANS `qualifies for the national minimum wage` q `in civil proceedings` FALSE

GIVEN q IS A `Qualification facts`
GIVETH A BOOLEAN
qualCivil q MEANS `qualifies for the national minimum wage` q `in civil proceedings` TRUE

-- Pay reference periods.
GIVEN h IS A NUMBER, rec IS A NUMBER, r1 IS A NUMBER, pays IS A LIST OF `Payment of arrears`
GIVETH A `Pay reference period`
mkPeriod h rec r1 pays MEANS `Pay reference period` OF h, rec, r1, pays

GIVEN amt IS A NUMBER, rt IS A NUMBER
GIVETH A `Payment of arrears`
pay amt rt MEANS `Payment of arrears` OF amt, rt

GIVEN p IS A `Pay reference period`, r2 IS A NUMBER
GIVETH A NUMBER
owed p r2 MEANS `the additional remuneration for` p `at the time of determination, rate` r2

-- Records requests: reasonable belief and failure both TRUE; complaint
-- presented on the receipt day (in time); no s 11(4) allowance; rate 12.71.
GIVEN recv IS A DATE, later IS A MAYBE DATE, ec IS A MAYBE `Early conciliation`
GIVETH A `Records request`
req recv later ec MEANS
    `Records request` OF TRUE, recv, later, TRUE, ec, recv, FALSE, 12.71

GIVEN recv IS A DATE, ec IS A MAYBE `Early conciliation`, presented IS A DATE, allowed IS A BOOLEAN, failed IS A BOOLEAN, hourly IS A NUMBER
GIVETH A `Records request`
complaint recv ec presented allowed failed hourly MEANS
    `Records request` OF TRUE, recv, NOTHING, failed, ec, presented, allowed, hourly

GIVEN da IS A DATE, db IS A DATE
GIVETH A MAYBE `Early conciliation`
acas da db MEANS JUST (`Early conciliation` OF da, db)

GIVEN r IS A `Records request`
GIVETH A DATE
produceBy r MEANS `the last day to produce the records for` r

GIVEN r IS A `Records request`
GIVETH A DATE
complainBy r MEANS `the last day to present a complaint for` r

GIVEN r IS A `Records request`
GIVETH A NUMBER
award r MEANS `the s 11 award for` r

§§ `A. Who qualifies`

-- Q1 baseline: s 1(2)(a)-(c).
#ASSERT qual baseline
-- Q2 still of compulsory school age: s 1(2)(c).
#ASSERT NOT (qual (personWith (JUST TRUE) FALSE FALSE (JUST TRUE) (JUST FALSE)))
-- Q3 not working or ordinarily working in the UK: s 1(2)(b).
#ASSERT NOT (qual (personWith (JUST TRUE) FALSE FALSE (JUST FALSE) (JUST TRUE)))
-- Q4 ordinarily works in the UK: s 1(2)(b).
#ASSERT qual (personWith (JUST TRUE) FALSE FALSE (JUST TRUE) (JUST TRUE))
-- Q5 s 54(3)(b) worker (folded into "has a worker's contract").
#ASSERT qual (personWith (JUST TRUE) FALSE FALSE (JUST TRUE) (JUST TRUE))
-- Q6 / Q7 no worker's contract, not agency, not home worker: not a worker.
#ASSERT NOT (qual (personWith (JUST FALSE) FALSE FALSE (JUST TRUE) (JUST TRUE)))
-- Q8 home worker, work otherwise than personally: s 35(1).
#ASSERT qual (personWith (JUST FALSE) FALSE TRUE (JUST TRUE) (JUST TRUE))
-- Q10 agency worker: s 34(2).
#ASSERT qual (personWith (JUST FALSE) TRUE FALSE (JUST TRUE) (JUST TRUE))
-- Q10b agency worker still needs UK and school age.
#ASSERT NOT (qual (personWith (JUST FALSE) TRUE FALSE (JUST FALSE) (JUST TRUE)))
-- Q12 mariner on UK ship, not wholly outside, ordinarily resident: s 40.
#ASSERT qual (marinerWith TRUE FALSE TRUE)
-- Q13 employment wholly outside the UK: s 40(a).
#ASSERT NOT (qual (marinerWith TRUE TRUE TRUE))
-- Q14 not ordinarily resident: s 40(b).
#ASSERT NOT (qual (marinerWith TRUE FALSE FALSE))
-- Q12b ship not UK-registered: s 40 does not apply.
#ASSERT NOT (qual (marinerWith FALSE FALSE TRUE))
-- Q15 armed forces: s 37(1).
#ASSERT NOT (qual (baselineDoing `service in the armed forces`))
-- Q16 cadet force adult volunteer: s 37A.
#ASSERT NOT (qual (baselineDoing `assisting a cadet force`))
-- Q18 share fisherman paid only by a share: s 43.
#ASSERT NOT (qual (baselineDoing (`on a fishing vessel` OF TRUE)))
-- Q19 fishing crew paid a wage plus a share: s 43(b) "only".
#ASSERT qual (baselineDoing (`on a fishing vessel` OF FALSE))
-- Q20 / Q21 / Q28 voluntary worker, expenses only, subsistence/accommodation only: s 44(1).
#ASSERT NOT (qual (volunteerWith (`Voluntary work facts` OF TRUE, TRUE, FALSE, FALSE, TRUE)))
-- Q22 charity worker paid a wage: s 44(1)(a) fails.
#ASSERT qual (volunteerWith (`Voluntary work facts` OF TRUE, FALSE, FALSE, FALSE, TRUE))
-- Q23 other benefit in kind: s 44(1)(b) fails.
#ASSERT qual (volunteerWith (`Voluntary work facts` OF TRUE, TRUE, FALSE, FALSE, FALSE))
-- Q25 unpaid for a commercial company: s 44(1) employer types.
#ASSERT qual (volunteerWith (`Voluntary work facts` OF FALSE, TRUE, FALSE, FALSE, TRUE))
-- Q26 subsistence money, placed by a charity: s 44(2).
#ASSERT NOT (qual (volunteerWith (`Voluntary work facts` OF TRUE, TRUE, TRUE, TRUE, TRUE)))
-- Q27 subsistence money, no charity placement: s 44(2)(a) fails.
#ASSERT qual (volunteerWith (`Voluntary work facts` OF TRUE, TRUE, TRUE, FALSE, TRUE))
-- Q29 residential member of charity religious community: s 44A.
#ASSERT NOT (qual (memberWith (`Community facts` OF TRUE, TRUE, TRUE, TRUE, FALSE)))
-- Q30 / Q31 school or FE/HE provider: s 44A(3).
#ASSERT qual (memberWith (`Community facts` OF TRUE, TRUE, TRUE, TRUE, TRUE))
-- Q32 not residential: s 44A(4).
#ASSERT qual (memberWith (`Community facts` OF FALSE, TRUE, TRUE, TRUE, FALSE))
-- Q33 not a charity nor established by one: s 44A(2)(a).
#ASSERT qual (memberWith (`Community facts` OF TRUE, FALSE, TRUE, TRUE, FALSE))
-- Q33b no religious or similar purpose: s 44A(2)(b).
#ASSERT qual (memberWith (`Community facts` OF TRUE, TRUE, FALSE, TRUE, FALSE))
-- Q33c members do not live together for that purpose: s 44A(2)(c).
#ASSERT qual (memberWith (`Community facts` OF TRUE, TRUE, TRUE, FALSE, FALSE))
-- Q34 prison work under prison rules: s 45(1).
#ASSERT NOT (qual (baselineDoing `prison work under prison rules`))
-- Q36 fine work order: s 45A.
#ASSERT NOT (qual (baselineDoing `unpaid work to discharge a fine`))
-- Q37 IAA 1999 s 153A: s 45B.
#ASSERT NOT (qual (baselineDoing `work disqualified by s 153A of the Immigration and Asylum Act 1999`))
-- Q38 s 3 regulations.
#ASSERT NOT (qual (`Qualification facts` OF JUST TRUE, FALSE, FALSE, JUST TRUE, FALSE, FALSE, TRUE, JUST TRUE, TRUE, `ordinary work`, noVol, noCom))
-- Q40 civil proceedings, nothing established: presumed, s 28(1).
#ASSERT qualCivil (personWith NOTHING FALSE FALSE NOTHING NOTHING)
-- Q40b civil, contrary established on school age: s 28(1) "unless the contrary is established".
#ASSERT NOT (qualCivil (personWith NOTHING FALSE FALSE NOTHING (JUST FALSE)))
-- Q40c civil, contrary established on worker status.
#ASSERT NOT (qualCivil (personWith (JUST FALSE) FALSE FALSE NOTHING NOTHING))
-- Q41 civil, exclusion established (prison work).
#ASSERT NOT (qualCivil (`Qualification facts` OF NOTHING, FALSE, FALSE, NOTHING, FALSE, FALSE, TRUE, NOTHING, FALSE, `prison work under prison rules`, noVol, noCom))

§§ `B. Arrears (s 17)`

-- S1 A = 100, R1 = R2 = 10.
#ASSERT owed (mkPeriod 100 900 10 EMPTY) 10 EQUALS 100
-- S2 A/R1 x R2 = 100/10 x 12.5.
#ASSERT owed (mkPeriod 100 900 10 EMPTY) 12.5 EQUALS 125
-- S3 200/8 x 12.
#ASSERT owed (mkPeriod 100 600 8 EMPTY) 12 EQUALS 300
-- S4 rate fell: higher is A.
#ASSERT owed (mkPeriod 100 1080 12 EMPTY) 10 EQUALS 120
-- S5 paid exactly the NMW.
#ASSERT owed (mkPeriod 100 1000 10 EMPTY) 12 EQUALS 0
-- S6 paid above the NMW.
#ASSERT owed (mkPeriod 100 1100 10 EMPTY) 12 EQUALS 0
-- S7 one part payment of 50: s 17(6).
#ASSERT owed (mkPeriod 100 900 10 (LIST (pay 50 12.5))) 12.5 EQUALS 75
-- S8 paid 125 in full when R2 was 12.5; later R2 13: s 17(5).
#ASSERT owed (mkPeriod 100 900 10 (LIST (pay 125 12.5))) 13 EQUALS 0
-- S9 paid 100 when entitlement was 125; at determination 130 - 100.
#ASSERT owed (mkPeriod 100 900 10 (LIST (pay 100 12.5))) 13 EQUALS 30
-- S10 paid 100 when R2 = 10 (entitlement 100, full); later R2 13.
#ASSERT owed (mkPeriod 100 900 10 (LIST (pay 100 10))) 13 EQUALS 0
-- S11 60 at R2 11 (ent 110), then 60 at R2 12 (ent 60, full).
#ASSERT owed (mkPeriod 100 900 10 (LIST (pay 60 11), (pay 60 12))) 13 EQUALS 0
-- S12 60 at R2 11, then 50 at R2 12 (ent 60, not full); 130 - 110.
#ASSERT owed (mkPeriod 100 900 10 (LIST (pay 60 11), (pay 50 12))) 13 EQUALS 20
-- S13 overpayment of 200.
#ASSERT owed (mkPeriod 100 900 10 (LIST (pay 200 11))) 13 EQUALS 0
-- S14 part payment 30, R2 unchanged.
#ASSERT owed (mkPeriod 100 900 10 (LIST (pay 30 10))) 10 EQUALS 70
-- S19 paid exactly the entitlement at that time.
#ASSERT owed (mkPeriod 100 900 10 (LIST (pay 125 12.5))) 12.5 EQUALS 0
-- S18 40 h x 10 = 400, received 350, A = 50; x 11/10.
#ASSERT owed (mkPeriod 40 350 10 EMPTY) 11 EQUALS 55
-- S20 rate fell, part payment 20: max(120, 100) - 20.
#ASSERT owed (mkPeriod 100 1080 12 (LIST (pay 20 10))) 10 EQUALS 100
-- S17 two periods: 125 + 300.
#ASSERT `the additional remuneration for all of` (LIST (`Underpaid period` OF (mkPeriod 100 900 10 EMPTY), 12.5), (`Underpaid period` OF (mkPeriod 100 600 8 EMPTY), 12)) EQUALS 425

§§ `C. Production date (s 10(9))`

-- P1 Mon 1 Mar 2027 -> Mon 15 Mar 2027.
#ASSERT produceBy (req (Date 1 3 2027) NOTHING NOTHING) EQUALS Date 15 3 2027
-- P2 over the year end.
#ASSERT produceBy (req (Date 20 12 2027) NOTHING NOTHING) EQUALS Date 3 1 2028
-- P3 leap day.
#ASSERT produceBy (req (Date 15 2 2028) NOTHING NOTHING) EQUALS Date 29 2 2028
-- P4 non-leap.
#ASSERT produceBy (req (Date 15 2 2027) NOTHING NOTHING) EQUALS Date 1 3 2027
-- P5 Saturday, no move.
#ASSERT produceBy (req (Date 17 1 2026) NOTHING NOTHING) EQUALS Date 31 1 2026
-- P6 later day agreed: s 10(9)(b).
#ASSERT produceBy (req (Date 1 3 2027) (JUST (Date 10 4 2027)) NOTHING) EQUALS Date 10 4 2027

§§ `D. Complaint limit (s 11(3))`

-- C1 15 Mar 2027 -> Tue 15 Jun 2027.
#ASSERT complainBy (req (Date 1 3 2027) NOTHING NOTHING) EQUALS Date 15 6 2027
-- C2 31 Jan 2027 -> 30 Apr 2027.
#ASSERT complainBy (req (Date 17 1 2027) NOTHING NOTHING) EQUALS Date 30 4 2027
-- C3 30 Nov 2027 -> 29 Feb 2028.
#ASSERT complainBy (req (Date 16 11 2027) NOTHING NOTHING) EQUALS Date 29 2 2028
-- C4 30 Nov 2026 -> 28 Feb 2027.
#ASSERT complainBy (req (Date 16 11 2026) NOTHING NOTHING) EQUALS Date 28 2 2027
-- C5 28 Feb 2028 -> 28 May 2028 (reading R-a).
#ASSERT complainBy (req (Date 14 2 2028) NOTHING NOTHING) EQUALS Date 28 5 2028
-- C6 29 Feb 2028 -> 29 May 2028.
#ASSERT complainBy (req (Date 15 2 2028) NOTHING NOTHING) EQUALS Date 29 5 2028
-- C7 31 Dec 2027 -> 31 Mar 2028.
#ASSERT complainBy (req (Date 17 12 2027) NOTHING NOTHING) EQUALS Date 31 3 2028
-- C8 later day 31 Aug 2027 -> 30 Nov 2027: s 11(3)(b).
#ASSERT complainBy (req (Date 1 3 2027) (JUST (Date 31 8 2027)) NOTHING) EQUALS Date 30 11 2027
-- C8b later day 30 Nov 2027 -> 29 Feb 2028.
#ASSERT complainBy (req (Date 1 3 2027) (JUST (Date 30 11 2027)) NOTHING) EQUALS Date 29 2 2028
-- C10 28 Oct 2027 -> 28 Jan 2028.
#ASSERT complainBy (req (Date 14 10 2027) NOTHING NOTHING) EQUALS Date 28 1 2028
-- C11 28 Oct 2026 -> 28 Jan 2027.
#ASSERT complainBy (req (Date 14 10 2026) NOTHING NOTHING) EQUALS Date 28 1 2027

§§ `E. Early conciliation (s 11A)`

-- E1 limit 15 Jun; A 1 Jun, B 15 Jun; (2) gives 29 Jun, in window -> 15 Jul.
#ASSERT complainBy (req (Date 1 3 2027) NOTHING (acas (Date 1 6 2027) (Date 15 6 2027))) EQUALS Date 15 7 2027
-- E2 A 1 May, B 8 May; (2) 22 Jun, window ends 8 Jun -> 22 Jun.
#ASSERT complainBy (req (Date 1 3 2027) NOTHING (acas (Date 1 5 2027) (Date 8 5 2027))) EQUALS Date 22 6 2027
-- E3 Day A after the limit -> unchanged (reading R-e).
#ASSERT complainBy (req (Date 1 3 2027) NOTHING (acas (Date 16 6 2027) (Date 20 6 2027))) EQUALS Date 15 6 2027
-- E4 Day A = Day B = limit: limit equals Day A -> 15 Jul.
#ASSERT complainBy (req (Date 1 3 2027) NOTHING (acas (Date 15 6 2027) (Date 15 6 2027))) EQUALS Date 15 7 2027
-- E5 Day A on the limit, B 29 Jun -> 29 Jul.
#ASSERT complainBy (req (Date 1 3 2027) NOTHING (acas (Date 15 6 2027) (Date 29 6 2027))) EQUALS Date 29 7 2027
-- E6 (2) result exactly at B + 1 month (20 Jun) -> 20 Jun.
#ASSERT complainBy (req (Date 1 3 2027) NOTHING (acas (Date 15 5 2027) (Date 20 5 2027))) EQUALS Date 20 6 2027
-- E7 (2) result one day past the window -> 21 Jun.
#ASSERT complainBy (req (Date 1 3 2027) NOTHING (acas (Date 14 5 2027) (Date 20 5 2027))) EQUALS Date 21 6 2027
-- E8 (2) result 19 Jun inside window -> 20 Jun.
#ASSERT complainBy (req (Date 1 3 2027) NOTHING (acas (Date 16 5 2027) (Date 20 5 2027))) EQUALS Date 20 6 2027
-- E9 limit 30 Apr; A 20 Apr, B 31 May; B + 1 month = 30 Jun.
#ASSERT complainBy (req (Date 17 1 2027) NOTHING (acas (Date 20 4 2027) (Date 31 5 2027))) EQUALS Date 30 6 2027
-- E10 limit 28 Jan 2028; A 25 Jan, B 31 Jan; -> 29 Feb 2028.
#ASSERT complainBy (req (Date 14 10 2027) NOTHING (acas (Date 25 1 2028) (Date 31 1 2028))) EQUALS Date 29 2 2028
-- E11 limit 28 Jan 2027; A 25 Jan, B 31 Jan; -> 28 Feb 2027.
#ASSERT complainBy (req (Date 14 10 2026) NOTHING (acas (Date 25 1 2027) (Date 31 1 2027))) EQUALS Date 28 2 2027
-- E12 A 16 Mar, B 20 Mar; (2) 19 Jun, window ends 20 Apr -> 19 Jun.
#ASSERT complainBy (req (Date 1 3 2027) NOTHING (acas (Date 16 3 2027) (Date 20 3 2027))) EQUALS Date 19 6 2027
-- E14 Day A 14 Jun (day before the limit), B 15 Jun: (2) gives 16 Jun; window to 15 Jul -> 15 Jul.
#ASSERT complainBy (req (Date 1 3 2027) NOTHING (acas (Date 14 6 2027) (Date 15 6 2027))) EQUALS Date 15 7 2027

§§ `F. Award (s 11(2))`

-- F1 rate 12.71 -> 1016.80.
#ASSERT award (complaint (Date 1 3 2027) NOTHING (Date 1 6 2027) FALSE TRUE 12.71) EQUALS 1016.8
-- F2 rate 12.21 -> 976.80.
#ASSERT award (complaint (Date 1 3 2027) NOTHING (Date 1 6 2027) FALSE TRUE 12.21) EQUALS 976.8
-- F3 rate 10 -> 800.
#ASSERT award (complaint (Date 1 3 2027) NOTHING (Date 1 6 2027) FALSE TRUE 10) EQUALS 800
-- F5 presented on the last day (15 Jun 2027) -> in time.
#ASSERT award (complaint (Date 1 3 2027) NOTHING (Date 15 6 2027) FALSE TRUE 12.71) EQUALS 1016.8
-- F6 presented 16 Jun 2027, no s 11(4) -> not considered -> 0.
#ASSERT award (complaint (Date 1 3 2027) NOTHING (Date 16 6 2027) FALSE TRUE 12.71) EQUALS 0
-- F7 presented late but tribunal allows under s 11(4).
#ASSERT award (complaint (Date 1 3 2027) NOTHING (Date 16 6 2027) TRUE TRUE 12.71) EQUALS 1016.8
-- F8 not well-founded (no failure) -> 0.
#ASSERT award (complaint (Date 1 3 2027) NOTHING (Date 1 6 2027) FALSE FALSE 12.71) EQUALS 0
-- F9 with E1 conciliation, presented 15 Jul 2027 -> in time.
#ASSERT award (complaint (Date 1 3 2027) (acas (Date 1 6 2027) (Date 15 6 2027)) (Date 15 7 2027) FALSE TRUE 12.71) EQUALS 1016.8
-- F10 with E1 conciliation, presented 16 Jul 2027 -> out of time -> 0.
#ASSERT award (complaint (Date 1 3 2027) (acas (Date 1 6 2027) (Date 15 6 2027)) (Date 16 7 2027) FALSE TRUE 12.71) EQUALS 0

§§ `G. The top-level goal`

caseQualifying MEANS
    `Minimum wage case` OF baseline, FALSE, (LIST (`Underpaid period` OF (mkPeriod 100 900 10 EMPTY), 12.5)), (JUST (req (Date 1 3 2027) NOTHING NOTHING))

posQ MEANS `the national minimum wage position for` caseQualifying

-- G1 qualifies, owed 125, produce by 15 Mar 2027, complain by 15 Jun 2027, award 1016.80.
-- [Ported by the encoder after the independent pass: the field became MAYBE; expected value unchanged, wrapped in JUST.]
#ASSERT posQ's `qualifies` EQUALS JUST TRUE
-- [Ported by the encoder after the independent pass: the field became MAYBE; expected value unchanged, wrapped in JUST.]
#ASSERT posQ's `additional remuneration owed` EQUALS JUST 125
#ASSERT posQ's `last day to produce the records` EQUALS JUST (Date 15 3 2027)
#ASSERT posQ's `last day to present a records complaint` EQUALS JUST (Date 15 6 2027)
#ASSERT posQ's `records award` EQUALS JUST 1016.8

casePrisoner MEANS
    `Minimum wage case` OF (baselineDoing `prison work under prison rules`), TRUE, (LIST (`Underpaid period` OF (mkPeriod 100 900 10 EMPTY), 12.5)), NOTHING

posP MEANS `the national minimum wage position for` casePrisoner

-- G2 / S16 does not qualify -> nothing owed under s 17(1); no records request.
-- [Ported by the encoder after the independent pass: the field became MAYBE; expected value unchanged, wrapped in JUST.]
#ASSERT posP's `qualifies` EQUALS JUST FALSE
-- [Ported by the encoder after the independent pass: the field became MAYBE; expected value unchanged, wrapped in JUST.]
#ASSERT posP's `additional remuneration owed` EQUALS JUST 0
#ASSERT posP's `last day to produce the records` EQUALS NOTHING
#ASSERT posP's `records award` EQUALS NOTHING
