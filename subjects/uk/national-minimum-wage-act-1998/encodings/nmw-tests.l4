IMPORT prelude
IMPORT daydate
IMPORT `nmw-types`
IMPORT `nmw-qualification`
IMPORT `nmw-arrears`
IMPORT `nmw-records`
IMPORT `nmw-goal`

-- National Minimum Wage Act 1998 (UK) — the encoder's tests.
-- Expected values are worked by hand from the Act, not from the code.

§ `Tests`

§§ `Goal 1 — who qualifies`

GIVEN employer IS A BOOLEAN, money IS A BOOLEAN, subsistence IS A BOOLEAN, placed IS A BOOLEAN, benefits IS A BOOLEAN
GIVETH A `Voluntary work facts`
`volunteering` employer money subsistence placed benefits MEANS
    `Voluntary work facts` OF employer, money, subsistence, placed, benefits

nobody MEANS `volunteering` FALSE FALSE FALSE FALSE FALSE

GIVEN member IS A BOOLEAN, school IS A BOOLEAN
GIVETH A `Community facts`
`a religious community, member` member `, school` school MEANS
    `Community facts` OF member, TRUE, TRUE, TRUE, school

noCommunity MEANS `Community facts` OF FALSE, FALSE, FALSE, FALSE, FALSE

-- Fields in order: worker's contract, s 34, s 35, works in the UK, UK ship,
-- wholly outside the UK, ordinarily resident, past school age, s 3
-- regulations, kind of work, voluntary work, community.
GIVEN contract IS A MAYBE BOOLEAN, agency IS A BOOLEAN, home IS A BOOLEAN, uk IS A MAYBE BOOLEAN,
      ship IS A BOOLEAN, outside IS A BOOLEAN, resident IS A BOOLEAN, school IS A MAYBE BOOLEAN
GIVETH A `Qualification facts`
`someone` contract agency home uk ship outside resident school MEANS
    `Qualification facts` OF contract, agency, home, uk, ship, outside, resident, school, FALSE, `ordinary work`, nobody, noCommunity

worker MEANS `someone` (JUST TRUE) FALSE FALSE (JUST TRUE) FALSE FALSE TRUE (JUST TRUE)

GIVEN k IS A `Kind of work`
GIVETH A `Qualification facts`
`a worker doing` k MEANS
    `Qualification facts` OF JUST TRUE, FALSE, FALSE, JUST TRUE, FALSE, FALSE, TRUE, JUST TRUE, FALSE, k, nobody, noCommunity

GIVEN v IS A `Voluntary work facts`, c IS A `Community facts`, regs IS A BOOLEAN
GIVETH A `Qualification facts`
`a worker with` v `and` c `regulations` regs MEANS
    `Qualification facts` OF JUST TRUE, FALSE, FALSE, JUST TRUE, FALSE, FALSE, TRUE, JUST TRUE, regs, `ordinary work`, v, c

-- s 1(2): all three conditions met.
#ASSERT `qualifies for the national minimum wage` worker `in civil proceedings` FALSE
-- s 28(1): the contract, or school age, not established either way, in civil
-- proceedings.
#ASSERT `qualifies for the national minimum wage` (`someone` NOTHING FALSE FALSE (JUST TRUE) FALSE FALSE TRUE (JUST TRUE)) `in civil proceedings` TRUE
#ASSERT `qualifies for the national minimum wage` (`someone` (JUST TRUE) FALSE FALSE (JUST TRUE) FALSE FALSE TRUE NOTHING) `in civil proceedings` TRUE
-- The contrary established: no worker's contract.
#ASSERT NOT (`qualifies for the national minimum wage` (`someone` (JUST FALSE) FALSE FALSE (JUST TRUE) FALSE FALSE TRUE (JUST TRUE)) `in civil proceedings` TRUE)
-- s 34: an agency worker with no worker's contract.
#ASSERT `qualifies for the national minimum wage` (`someone` (JUST FALSE) TRUE FALSE (JUST TRUE) FALSE FALSE TRUE (JUST TRUE)) `in civil proceedings` FALSE
-- s 35: a home worker.
#ASSERT `qualifies for the national minimum wage` (`someone` (JUST FALSE) FALSE TRUE (JUST TRUE) FALSE FALSE TRUE (JUST TRUE)) `in civil proceedings` FALSE
-- s 1(2)(c): still of compulsory school age.
#ASSERT NOT (`qualifies for the national minimum wage` (`someone` (JUST TRUE) FALSE FALSE (JUST TRUE) FALSE FALSE TRUE (JUST FALSE)) `in civil proceedings` TRUE)
-- s 40: a mariner on a UK ship, resident, not wholly outside the UK; then
-- wholly outside; then not resident.
#ASSERT `qualifies for the national minimum wage` (`someone` (JUST TRUE) FALSE FALSE (JUST FALSE) TRUE FALSE TRUE (JUST TRUE)) `in civil proceedings` FALSE
#ASSERT NOT (`qualifies for the national minimum wage` (`someone` (JUST TRUE) FALSE FALSE (JUST FALSE) TRUE TRUE TRUE (JUST TRUE)) `in civil proceedings` FALSE)
#ASSERT NOT (`qualifies for the national minimum wage` (`someone` (JUST TRUE) FALSE FALSE (JUST FALSE) TRUE FALSE FALSE (JUST TRUE)) `in civil proceedings` FALSE)
-- ss 37, 37A, 45, 45A, 45B.
#ASSERT NOT (`qualifies for the national minimum wage` (`a worker doing` `service in the armed forces`) `in civil proceedings` FALSE)
#ASSERT NOT (`qualifies for the national minimum wage` (`a worker doing` `assisting a cadet force`) `in civil proceedings` FALSE)
#ASSERT NOT (`qualifies for the national minimum wage` (`a worker doing` `prison work under prison rules`) `in civil proceedings` FALSE)
#ASSERT NOT (`qualifies for the national minimum wage` (`a worker doing` `unpaid work to discharge a fine`) `in civil proceedings` FALSE)
#ASSERT NOT (`qualifies for the national minimum wage` (`a worker doing` `work disqualified by s 153A of the Immigration and Asylum Act 1999`) `in civil proceedings` FALSE)
-- s 43: a share fisherman, and a fisherman on wages.
#ASSERT NOT (`qualifies for the national minimum wage` (`a worker doing` (`on a fishing vessel` TRUE)) `in civil proceedings` FALSE)
#ASSERT `qualifies for the national minimum wage` (`a worker doing` (`on a fishing vessel` FALSE)) `in civil proceedings` FALSE
-- s 3(2)(a).
#ASSERT NOT (`qualifies for the national minimum wage` (`a worker with` nobody `and` noCommunity `regulations` TRUE) `in civil proceedings` FALSE)

-- s 44: a volunteer for a charity paid expenses only, with lunch.
#ASSERT NOT (`qualifies for the national minimum wage` (`a worker with` (`volunteering` TRUE TRUE FALSE FALSE TRUE) `and` noCommunity `regulations` FALSE) `in civil proceedings` FALSE)
-- s 44(2): subsistence money, but not placed by a charity: not excluded.
#ASSERT `qualifies for the national minimum wage` (`a worker with` (`volunteering` TRUE TRUE TRUE FALSE TRUE) `and` noCommunity `regulations` FALSE) `in civil proceedings` FALSE
-- ... and placed by a charity: excluded.
#ASSERT NOT (`qualifies for the national minimum wage` (`a worker with` (`volunteering` TRUE TRUE TRUE TRUE TRUE) `and` noCommunity `regulations` FALSE) `in civil proceedings` FALSE)
-- A volunteer also given a benefit in kind beyond subsistence: not excluded.
#ASSERT `qualifies for the national minimum wage` (`a worker with` (`volunteering` TRUE TRUE FALSE FALSE FALSE) `and` noCommunity `regulations` FALSE) `in civil proceedings` FALSE

-- s 44A: a resident member of a religious community, and of one that runs a
-- school.
#ASSERT NOT (`qualifies for the national minimum wage` (`a worker with` nobody `and` (`a religious community, member` TRUE `, school` FALSE) `regulations` FALSE) `in civil proceedings` FALSE)
#ASSERT `qualifies for the national minimum wage` (`a worker with` nobody `and` (`a religious community, member` TRUE `, school` TRUE) `regulations` FALSE) `in civil proceedings` FALSE

§§ `Goal 2 — arrears (s 17)`

GIVEN hours IS A NUMBER, received IS A NUMBER, r1 IS A NUMBER, payments IS A LIST OF `Payment of arrears`
GIVETH A `Pay reference period`
`a period of` hours `hours, paid` received `, R1` r1 `, arrears paid` payments MEANS
    `Pay reference period` OF hours, received, r1, payments

GIVEN amount IS A NUMBER, r IS A NUMBER
GIVETH A `Payment of arrears`
`paid` amount `when R2 was` r MEANS `Payment of arrears` OF amount, r

-- 100 hours at R1 = 10, paid 800: A = 1000 - 800 = 200.
period MEANS `a period of` 100 `hours, paid` 800 `, R1` 10 `, arrears paid` EMPTY

#ASSERT `the shortfall A for` period EQUALS 200
-- R2 = 12: A/R1 × R2 = 200/10 × 12 = 240, the higher.
#ASSERT `the additional remuneration for` period `at the time of determination, rate` 12 EQUALS 240
-- R2 = 10 (unchanged): both 200.
#ASSERT `the additional remuneration for` period `at the time of determination, rate` 10 EQUALS 200
-- R2 = 9 (lower): the higher is A = 200.
#ASSERT `the additional remuneration for` period `at the time of determination, rate` 9 EQUALS 200
-- Paid exactly the minimum (1000) or more: s 17(1) does not apply.
#ASSERT `the additional remuneration for` (`a period of` 100 `hours, paid` 1000 `, R1` 10 `, arrears paid` EMPTY) `at the time of determination, rate` 12 EQUALS 0
#ASSERT `the additional remuneration for` (`a period of` 100 `hours, paid` 1200 `, R1` 10 `, arrears paid` EMPTY) `at the time of determination, rate` 12 EQUALS 0
-- s 17(6): 100 paid when R2 was 10 (entitlement then 200, not paid in full);
-- now R2 = 12: 240 - 100 = 140.
#ASSERT `the additional remuneration for` (`a period of` 100 `hours, paid` 800 `, R1` 10 `, arrears paid` (LIST `paid` 100 `when R2 was` 10)) `at the time of determination, rate` 12 EQUALS 140
-- s 17(5): 200 paid when R2 was 10 (entitlement then 200, paid in full);
-- the rate rising to 12 afterwards revives nothing.
#ASSERT `the additional remuneration for` (`a period of` 100 `hours, paid` 800 `, R1` 10 `, arrears paid` (LIST `paid` 200 `when R2 was` 10)) `at the time of determination, rate` 12 EQUALS 0
-- Two payments: 100 at R2 10, then 150 at R2 12 (entitlement then 240 - 100
-- = 140, so paid in full).
#ASSERT `the additional remuneration for` (`a period of` 100 `hours, paid` 800 `, R1` 10 `, arrears paid` (LIST `paid` 100 `when R2 was` 10, `paid` 150 `when R2 was` 12)) `at the time of determination, rate` 13 EQUALS 0
-- Two payments of 50 at R2 10: 100 paid, not in full; R2 now 11: 220 - 100.
#ASSERT `the additional remuneration for` (`a period of` 100 `hours, paid` 800 `, R1` 10 `, arrears paid` (LIST `paid` 50 `when R2 was` 10, `paid` 50 `when R2 was` 10)) `at the time of determination, rate` 11 EQUALS 120

-- 40 hours at £11.44 (the 21-and-over rate from 1 April 2024), paid £400;
-- determined at £12.21 (from 1 April 2025): A = 457.60 - 400 = 57.60;
-- 57.60 / 11.44 × 12.21 = 703.296 / 11.44.
#ASSERT `the additional remuneration for` (`a period of` 40 `hours, paid` 400 `, R1` 11.44 `, arrears paid` EMPTY) `at the time of determination, rate` 12.21 EQUALS 703.296 DIVIDED BY 11.44

-- Two periods: 240 + 200.
#ASSERT `the additional remuneration for all of` (LIST (`Underpaid period` OF period, 12), (`Underpaid period` OF period, 9)) EQUALS 440

§§ `Goal 3 — access to records (ss 10, 11, 11A)`

GIVEN received IS A DATE, agreed IS A MAYBE DATE, conciliation IS A MAYBE `Early conciliation`, presented IS A DATE
GIVETH A `Records request`
`a request received` received `, agreed` agreed `, conciliation` conciliation `, presented` presented MEANS
    `Records request` OF TRUE, received, agreed, TRUE, conciliation, presented, FALSE, 12.21

GIVEN belief IS A BOOLEAN, failed IS A BOOLEAN, presented IS A DATE, allowed IS A BOOLEAN
GIVETH A `Records request`
`a complaint, belief` belief `, failure` failed `, presented` presented `, allowed` allowed MEANS
    `Records request` OF belief, Date 2 3 2026, NOTHING, failed, NOTHING, presented, allowed, 12.21

GIVEN a IS A DATE, b IS A DATE
GIVETH A `Records request`
`a request with conciliation from` a `to` b MEANS
    `a request received` (Date 2 3 2026) `, agreed` NOTHING `, conciliation` (JUST (`Early conciliation` OF a, b)) `, presented` (Date 1 6 2026)

request MEANS `a request received` (Date 2 3 2026) `, agreed` NOTHING `, conciliation` NOTHING `, presented` (Date 1 6 2026)

-- s 10(9)(a): received Monday 2 March 2026; the fourteen days run 3-16 March.
#ASSERT `the last day to produce the records for` request EQUALS Date 16 3 2026
-- s 10(9)(b): a later day agreed.
#ASSERT `the last day to produce the records for` (`a request received` (Date 2 3 2026) `, agreed` (JUST (Date 31 3 2026)) `, conciliation` NOTHING `, presented` (Date 1 6 2026)) EQUALS Date 31 3 2026
-- s 11(3)(a): three months following 16 March 2026.
#ASSERT `the last day to present a complaint for` request EQUALS Date 16 6 2026
-- s 11(3)(b): three months following 31 March 2026; June has no 31st.
#ASSERT `the last day to present a complaint for` (`a request received` (Date 2 3 2026) `, agreed` (JUST (Date 31 3 2026)) `, conciliation` NOTHING `, presented` (Date 1 6 2026)) EQUALS Date 30 6 2026
-- Received 16 November 2025: the fourteen days end 30 November; three months
-- following end on 28 February 2026.
#ASSERT `the last day to present a complaint for` (`a request received` (Date 16 11 2025) `, agreed` NOTHING `, conciliation` NOTHING `, presented` (Date 1 2 2026)) EQUALS Date 28 2 2026

-- s 11A: Day A 1 June, Day B 15 June 2026. (2): 2-15 June (14 days) not
-- counted, so 16 June becomes 30 June; (3): 30 June falls between 1 June and
-- 15 July (one month after Day B), so the limit is 15 July.
#ASSERT `the last day to present a complaint for` (`a request with conciliation from` (Date 1 6 2026) `to` (Date 15 6 2026)) EQUALS Date 15 7 2026
-- Day A 1 April, Day B 1 May 2026: 30 days added, 16 July; outside 1 April -
-- 1 June, so (3) does not apply.
#ASSERT `the last day to present a complaint for` (`a request with conciliation from` (Date 1 4 2026) `to` (Date 1 5 2026)) EQUALS Date 16 7 2026
-- Day A 20 June 2026, after the limit had expired: no extension.
#ASSERT `the last day to present a complaint for` (`a request with conciliation from` (Date 20 6 2026) `to` (Date 30 6 2026)) EQUALS Date 16 6 2026
-- Day A on the last day, 16 June; Day B 20 June: (2) adds nothing, (3) moves
-- it to 20 July.
#ASSERT `the last day to present a complaint for` (`a request with conciliation from` (Date 16 6 2026) `to` (Date 20 6 2026)) EQUALS Date 20 7 2026

-- s 11(2): 80 × £12.21 = £976.80.
#ASSERT `the s 11 award for` request EQUALS 976.8
-- Presented 17 June 2026, a day late, and not allowed: no award.
#ASSERT `the s 11 award for` (`a complaint, belief` TRUE `, failure` TRUE `, presented` (Date 17 6 2026) `, allowed` FALSE) EQUALS 0
-- ... allowed under s 11(4).
#ASSERT `the s 11 award for` (`a complaint, belief` TRUE `, failure` TRUE `, presented` (Date 17 6 2026) `, allowed` TRUE) EQUALS 976.8
-- s 10(2): no reasonable belief; and no failure.
#ASSERT `the s 11 award for` (`a complaint, belief` FALSE `, failure` TRUE `, presented` (Date 1 6 2026) `, allowed` FALSE) EQUALS 0
#ASSERT `the s 11 award for` (`a complaint, belief` TRUE `, failure` FALSE `, presented` (Date 1 6 2026) `, allowed` FALSE) EQUALS 0

§§ `The top-level goal`

GIVEN who IS A `Qualification facts`, r IS A MAYBE `Records request`
GIVETH A `Minimum wage case`
`a claim by` who `, records request` r MEANS
    `Minimum wage case` OF who, TRUE, (LIST (`Underpaid period` OF period, 12)), r

pos MEANS `the national minimum wage position for` (`a claim by` worker `, records request` (JUST request))
-- Changed after the independent pass: the two fields are now MAYBE.
#ASSERT pos's `qualifies` EQUALS JUST TRUE
#ASSERT pos's `additional remuneration owed` EQUALS JUST 240
#ASSERT pos's `last day to produce the records` EQUALS JUST (Date 16 3 2026)
#ASSERT pos's `last day to present a records complaint` EQUALS JUST (Date 16 6 2026)
#ASSERT pos's `records award` EQUALS JUST 976.8
-- A prisoner doing prison work: no arrears under the Act.
prisonerPos MEANS `the national minimum wage position for` (`a claim by` (`a worker doing` `prison work under prison rules`) `, records request` NOTHING)
#ASSERT prisonerPos's `additional remuneration owed` EQUALS JUST 0
#ASSERT prisonerPos's `records award` EQUALS NOTHING

-- Added after the independent pass: outside civil proceedings, with the
-- worker's contract not established, qualification cannot be decided, but
-- the records fields still answer.
unknownPos MEANS `the national minimum wage position for` (`Minimum wage case` OF (`someone` NOTHING FALSE FALSE (JUST TRUE) FALSE FALSE TRUE (JUST TRUE)), FALSE, (LIST (`Underpaid period` OF period, 12)), JUST request)
#ASSERT unknownPos's `qualifies` EQUALS NOTHING
#ASSERT unknownPos's `additional remuneration owed` EQUALS NOTHING
#ASSERT unknownPos's `last day to present a records complaint` EQUALS JUST (Date 16 6 2026)
#ASSERT unknownPos's `records award` EQUALS JUST 976.8
-- ... an agency worker with the contract unknown: decided.
agencyPos MEANS `the national minimum wage position for` (`Minimum wage case` OF (`someone` NOTHING TRUE FALSE (JUST TRUE) FALSE FALSE TRUE (JUST TRUE)), FALSE, (LIST (`Underpaid period` OF period, 12)), NOTHING)
#ASSERT agencyPos's `qualifies` EQUALS JUST TRUE
-- ... a prisoner with school age unknown: excluded, so decided.
prisonUnknownPos MEANS `the national minimum wage position for` (`Minimum wage case` OF (`Qualification facts` OF JUST TRUE, FALSE, FALSE, JUST TRUE, FALSE, FALSE, TRUE, NOTHING, FALSE, `prison work under prison rules`, nobody, noCommunity), FALSE, (LIST (`Underpaid period` OF period, 12)), NOTHING)
#ASSERT prisonUnknownPos's `qualifies` EQUALS JUST FALSE
