#ASSERT NOT (`Am I guilty of handling stolen goods` `the goods originally stolen, or parts of them` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE)
-- The stealing was no offence under this Act or where it happened.
#ASSERT NOT (`Am I guilty of handling stolen goods` `the goods originally stolen, or parts of them` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE)
