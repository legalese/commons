#ASSERT `Are the goods stolen goods` `goods representing stolen goods in the hands of a handler, as proceeds of a disposal or realisation` FALSE TRUE FALSE FALSE FALSE FALSE FALSE
-- Goods of some other origin.
#ASSERT NOT (`Are the goods stolen goods` `goods of some other origin` FALSE TRUE FALSE FALSE FALSE FALSE FALSE)
-- Money withdrawn from a wrongful credit, to the extent it derives from it (s 24A(8)).
#ASSERT `Are the goods stolen goods` `money dishonestly withdrawn from an account to which a wrongful credit was made` FALSE FALSE FALSE FALSE TRUE FALSE FALSE
-- Money withdrawn, but not deriving from the wrongful credit.
#ASSERT NOT (`Are the goods stolen goods` `money dishonestly withdrawn from an account to which a wrongful credit was made` FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- Land is not goods (s 34(2)(b)).
#ASSERT NOT (`Are the goods stolen goods` `the goods originally stolen, or parts of them` TRUE TRUE FALSE FALSE FALSE FALSE FALSE)

§§ `Section 24A -- wrongful credits`

-- Knows a bank credit derived from theft is wrongful and dishonestly leaves it.
#ASSERT `Am I guilty of dishonestly retaining a wrongful credit` TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE TRUE
-- The account is not the person's and they have no interest in it.
#ASSERT NOT (`Am I guilty of dishonestly retaining a wrongful credit` TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE TRUE)
-- The account is not with a bank or other listed business.
#ASSERT NOT (`Am I guilty of dishonestly retaining a wrongful credit` TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE TRUE)
-- A deposit-lending business (s 24A(10)(a)).
#ASSERT `Am I guilty of dishonestly retaining a wrongful credit` TRUE TRUE FALSE TRUE FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE TRUE
-- An electronic money issuer within the definition (s 24A(9)(c)).
#ASSERT `Am I guilty of dishonestly retaining a wrongful credit` TRUE TRUE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE TRUE TRUE TRUE
-- The credit derives from none of the four.
#ASSERT NOT (`Am I guilty of dishonestly retaining a wrongful credit` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE)
-- Derives from blackmail.
#ASSERT `Am I guilty of dishonestly retaining a wrongful credit` TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE TRUE TRUE TRUE
-- Derives from fraud under section 1 of the Fraud Act 2006.
#ASSERT `Am I guilty of dishonestly retaining a wrongful credit` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE TRUE TRUE TRUE
-- Derives from stolen goods.
#ASSERT `Am I guilty of dishonestly retaining a wrongful credit` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE TRUE TRUE TRUE
-- Did not know or believe it wrongful.
#ASSERT NOT (`Am I guilty of dishonestly retaining a wrongful credit` TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE TRUE)
-- Took the reasonable steps to have it cancelled.
#ASSERT NOT (`Am I guilty of dishonestly retaining a wrongful credit` TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE FALSE TRUE)
-- Not dishonest in failing to take them.
#ASSERT NOT (`Am I guilty of dishonestly retaining a wrongful credit` TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE FALSE)
-- Ten years on indictment.
#ASSERT (`What is the most that can follow if I am convicted of dishonestly retaining a wrongful credit` TRUE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE TRUE) EQUALS `an offence, liable to the penalty the section states` `pen 10 years`
-- Not an offence.
#ASSERT (`What is the most that can follow if I am convicted of dishonestly retaining a wrongful credit` FALSE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE TRUE TRUE TRUE) EQUALS `no offence under this section on these facts`

§§ `Section 25 -- going equipped`

-- An article with me for a burglary.
#ASSERT `Am I guilty of going equipped` FALSE TRUE TRUE FALSE FALSE
-- An article for a theft.
#ASSERT `Am I guilty of going equipped` FALSE TRUE FALSE TRUE FALSE
-- An article for taking a conveyance: treated as theft (s 25(5)).
#ASSERT `Am I guilty of going equipped` FALSE TRUE FALSE FALSE TRUE
-- At my place of abode.
#ASSERT NOT (`Am I guilty of going equipped` TRUE TRUE FALSE TRUE FALSE)
-- No article with me.
#ASSERT NOT (`Am I guilty of going equipped` FALSE FALSE FALSE TRUE FALSE)
-- An article, but not for any of those uses.
#ASSERT NOT (`Am I guilty of going equipped` FALSE TRUE FALSE FALSE FALSE)
-- Three years on indictment.
#ASSERT (`What is the most that can follow if I am convicted of going equipped` FALSE TRUE TRUE FALSE FALSE) EQUALS `an offence, liable to the penalty the section states` `pen 3 years`
-- Not an offence.
#ASSERT (`What is the most that can follow if I am convicted of going equipped` FALSE TRUE FALSE FALSE FALSE) EQUALS `no offence under this section on these facts`
-- Had with me an article made or adapted for burglary or theft: evidence of the use (s 25(3)).
#ASSERT `Is there evidence that I had the article for such use` TRUE TRUE
-- An ordinary article.
#ASSERT NOT (`Is there evidence that I had the article for such use` TRUE FALSE)
-- Not with me.
#ASSERT NOT (`Is there evidence that I had the article for such use` FALSE TRUE)
