IMPORT prelude
IMPORT `spr-part1-general`

-- Tests for regulations 1 and 1A (spr-part1-general.l4).
-- Each expected value is decided from the text of the regulation named beside it,
-- before running.

§ `Regulation 1(2): commencement`

-- Text: "These Regulations come into force on 6th April 2016."
#ASSERT `regulation 1(2): the commencement date` EQUALS YMD 2016 4 6

§ `Regulation 1(3): who the Regulations apply to`

-- Text: "These Regulations (except Part 5) do not apply to a person who reaches
-- pensionable age before 6th April 2016."
-- The day before commencement: reaches pensionable age before 6 April 2016, so they do not apply.
#ASSERT NOT (`regulation 1(3): these Regulations (except Part 5) apply to the person` (YMD 2016 4 5))
-- The day of commencement is not "before 6th April 2016", so they apply.
#ASSERT `regulation 1(3): these Regulations (except Part 5) apply to the person` (YMD 2016 4 6)
-- A person who reaches pensionable age years later is within them.
#ASSERT `regulation 1(3): these Regulations (except Part 5) apply to the person` (YMD 2041 9 1)
-- A person who reached pensionable age long before 2016 is outside them.
#ASSERT NOT (`regulation 1(3): these Regulations (except Part 5) apply to the person` (YMD 2010 1 1))
-- "(except Part 5)": Part 5 applies even to a person who reached pensionable age before 6 April 2016.
#ASSERT `regulation 1(3): Part 5 applies to the person` (YMD 2010 1 1)
#ASSERT `regulation 1(3): Part 5 applies to the person` (YMD 2016 4 6)

§ `Regulation 1(4): graduated retirement benefit`

-- Text: "any benefit under section 36 ... or 37 ... of the 1965 Act".
#ASSERT `regulation 1(4): the benefit is graduated retirement benefit` `a benefit under section 36 of the 1965 Act`
#ASSERT `regulation 1(4): the benefit is graduated retirement benefit` `a benefit under section 37 of the 1965 Act`
#ASSERT NOT (`regulation 1(4): the benefit is graduated retirement benefit` `a benefit under another provision`)

§ `Regulation 1(5): married to a third person`

-- Text: "two people are to be treated as if they are not married to each other in
-- relation to times when either of them is married to a third person."
#ASSERT `regulation 1(5): the two people are treated as spouses or civil partners at the time` `married to each other` FALSE
#ASSERT NOT (`regulation 1(5): the two people are treated as spouses or civil partners at the time` `married to each other` TRUE)
-- The paragraph says nothing about civil partners: a civil partnership stands as it is
-- (NOTES.md fork F9). Asserted.
#ASSERT `regulation 1(5): the two people are treated as spouses or civil partners at the time` `civil partners of each other` FALSE
#ASSERT `regulation 1(5): the two people are treated as spouses or civil partners at the time` `civil partners of each other` TRUE

§ `Regulation 1A: full rate`

-- Text: "£241.30 per week".
#ASSERT `regulation 1A: the full rate of the state pension, in pounds per week` EQUALS 241.30
-- 241.30 pounds a week is 24130 pence a week.
#ASSERT `regulation 1A: the full rate of the state pension, in pounds per week` TIMES 100 EQUALS 24130
