    AND `the survivor`'s `the survivor and the deceased were married or civil partners of each other when the deceased died`
    AND (    (    `the survivor was under pensionable age when the deceased died` `the survivor`
              AND (NOT `the survivor`'s `the survivor has married or formed a civil partnership since the death and before reaching pensionable age`))
         OR  `the survivor was over pensionable age when the deceased died` `the survivor`)
    AND (    `the survivor`'s `the deceased was entitled to an increase in graduated retirement benefit`
         OR  `the survivor`'s `the deceased's entitlement to graduated retirement benefit was deferred when the deceased died`)
    AND (    (NOT (`the conditions of regulation 18(1)(a) to (d) are met` `the survivor`))
         OR  `what is paid` EQUALS `a state pension under regulation 20`)

