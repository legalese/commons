§ `Regulation 28`

#ASSERT `regulation 28(2): the conditions are satisfied` `forces spouse, week of 7 Jun 2010, all in order`
#ASSERT NOT (`regulation 28(2): the conditions are satisfied` `not a forces spouse`)
#ASSERT NOT (`regulation 28(2): the conditions are satisfied` `not accompanying the member`)

-- (3): a year beginning on or after 6 April 1975 and ending before 6 April 2016, with the member's factors above the qualifying factor.
#ASSERT `regulation 28(3): the regulation applies to the week` `forces spouse, week of 7 Jun 2010, all in order`
#ASSERT `regulation 28(3): the regulation applies to the week` `week of 5 Apr 2016 (tax year 2015)`
#ASSERT NOT (`regulation 28(3): the regulation applies to the week` `week of 6 Apr 2016 (tax year 2016)`)
#ASSERT `regulation 28(3): the regulation applies to the week` `week of 6 Apr 1975 (tax year 1975)`
#ASSERT NOT (`regulation 28(3): the regulation applies to the week` `week of 5 Apr 1975 (tax year 1974)`)
-- "exceed": equal is not enough.
#ASSERT NOT (`regulation 28(3): the regulation applies to the week` `member earnings factors equal the qualifying earnings factor`)
#ASSERT NOT (`regulation 28(3): the regulation applies to the week` `member earnings factors below the qualifying earnings factor`)
#ASSERT `regulation 28(3): the regulation applies to the week` `member earnings factors one pound above`

-- (4): the exclusions.
#ASSERT NOT (`regulation 28(4): paragraph (1) does not apply` `forces spouse, week of 7 Jun 2010, all in order`)
#ASSERT `regulation 28(4): paragraph (1) does not apply` `entitled under the 1975 Regulations`
#ASSERT `regulation 28(4): paragraph (1) does not apply` `reduced rate election in force`

-- (5), (6): the application.
#ASSERT `regulation 28(5) and (6): a valid application has been received` `forces spouse, week of 7 Jun 2010, all in order`
#ASSERT NOT (`regulation 28(5) and (6): a valid application has been received` `no application received`)
#ASSERT NOT (`regulation 28(5) and (6): a valid application has been received` `application not for a past period`)
#ASSERT NOT (`regulation 28(5) and (6): a valid application has been received` `application not on an approved form`)
#ASSERT NOT (`regulation 28(5) and (6): a valid application has been received` `application lacking information`)

-- (1): everything together.
#ASSERT `regulation 28(1): the person is credited with a Class 3 contribution for the week` `forces spouse, week of 7 Jun 2010, all in order`
#ASSERT `regulation 28(1): the person is credited with a Class 3 contribution for the week` `week of 5 Apr 2016 (tax year 2015)`
#ASSERT NOT (`regulation 28(1): the person is credited with a Class 3 contribution for the week` `week of 6 Apr 2016 (tax year 2016)`)
#ASSERT NOT (`regulation 28(1): the person is credited with a Class 3 contribution for the week` `not a forces spouse`)
#ASSERT NOT (`regulation 28(1): the person is credited with a Class 3 contribution for the week` `not accompanying the member`)
#ASSERT NOT (`regulation 28(1): the person is credited with a Class 3 contribution for the week` `member earnings factors equal the qualifying earnings factor`)
#ASSERT NOT (`regulation 28(1): the person is credited with a Class 3 contribution for the week` `entitled under the 1975 Regulations`)
#ASSERT NOT (`regulation 28(1): the person is credited with a Class 3 contribution for the week` `reduced rate election in force`)
#ASSERT NOT (`regulation 28(1): the person is credited with a Class 3 contribution for the week` `no application received`)
#ASSERT NOT (`regulation 28(1): the person is credited with a Class 3 contribution for the week` `application not on an approved form`)
