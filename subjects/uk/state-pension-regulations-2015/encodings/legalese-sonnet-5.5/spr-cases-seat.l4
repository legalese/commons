-- Not an overseas resident.
#ASSERT `On which weekly rate is my increment for this part of my deferral worked` FALSE TRUE EQUALS `the weekly rate immediately before the end of that part of the deferral period`
-- Overseas but in Great Britain or a specified territory: no rate (F27).
#ASSERT `On which weekly rate is my increment for this part of my deferral worked` TRUE TRUE EQUALS `regulation 22 gives no reference rate for this part`

-- Q51. What is my increment for this part of my deferral, in pounds a week (reg 22)?
-- Overseas outside Great Britain: 10 weeks against the start rate 900.
#ASSERT `What is my increment for this part of my deferral, in pounds a week` TRUE FALSE 10 900 450 EQUALS JUST 10
-- Not overseas: 10 weeks against the end rate 450.
#ASSERT `What is my increment for this part of my deferral, in pounds a week` FALSE TRUE 10 900 450 EQUALS JUST 5
-- Overseas in Great Britain or a specified territory: nothing.
#ASSERT `What is my increment for this part of my deferral, in pounds a week` TRUE TRUE 10 900 450 EQUALS NOTHING

-- Q52. Do regulations 12A and 22 both apply to my deferral (reg 23(1))?
-- A rate change during a deferral spent partly overseas.
#ASSERT `Do regulations 12A and 22 both apply to my deferral` (YMD 2027 1 1) (YMD 2027 12 31) TRUE (YMD 2027 3 1) TRUE
-- No rate change.
#ASSERT NOT (`Do regulations 12A and 22 both apply to my deferral` (YMD 2027 1 1) (YMD 2027 12 31) FALSE (YMD 2027 3 1) TRUE)
-- Never overseas.
#ASSERT NOT (`Do regulations 12A and 22 both apply to my deferral` (YMD 2027 1 1) (YMD 2027 12 31) TRUE (YMD 2027 3 1) FALSE)

-- Q53. What is my increment where regulations 12A and 22 both apply, in pounds a week (reg 23(5))?
-- An increase of 2 on 10.
#ASSERT `What is my increment where regulations 12A and 22 both apply, in pounds a week` 10 2 EQUALS 12
-- A decrease of 3 on 10.
#ASSERT `What is my increment where regulations 12A and 22 both apply, in pounds a week` 10 (0 MINUS 3) EQUALS 7
-- No change.
#ASSERT `What is my increment where regulations 12A and 22 both apply, in pounds a week` 10 0 EQUALS 10


§§ `National Insurance credits towards my State Pension (regs 24 to 39)`


§§§ `Which rules cover which weeks (regs 24, 25)`

-- Q54. Can credits under Chapter 3 reach this day (reg 24(2))?
-- 5 April 2016.
#ASSERT NOT (`Can credits under Chapter 3 reach this day` (YMD 2016 4 5))
-- 6 April 2016.
#ASSERT `Can credits under Chapter 3 reach this day` (YMD 2016 4 6)
-- A day in 2020.
#ASSERT `Can credits under Chapter 3 reach this day` (YMD 2020 1 1)
-- A day in 2000.
#ASSERT NOT (`Can credits under Chapter 3 reach this day` (YMD 2000 1 1))

-- Q55. Which Chapter of Part 8 covers the week I am asking about (reg 25(1), (3))?
-- A week beginning 5 April 2016 runs into 6 April but counts in the year it begins, 2015: Chapter 2.
#ASSERT `Which Chapter of Part 8 covers the week I am asking about` (YMD 2016 4 5) EQUALS `Chapter 2 (a pre-commencement qualifying year)`
-- A week beginning 6 April 2016.
#ASSERT `Which Chapter of Part 8 covers the week I am asking about` (YMD 2016 4 6) EQUALS `Chapter 3 (a qualifying year or a post-commencement qualifying year)`
-- A week in 2010.
#ASSERT `Which Chapter of Part 8 covers the week I am asking about` (YMD 2010 1 1) EQUALS `Chapter 2 (a pre-commencement qualifying year)`
-- A week in 2030.
#ASSERT `Which Chapter of Part 8 covers the week I am asking about` (YMD 2030 1 1) EQUALS `Chapter 3 (a qualifying year or a post-commencement qualifying year)`

-- Q56. How much of a credit am I given for this year, in pounds (reg 25(2))?
-- 100 credit, 4900 held, 5000 needed.
#ASSERT `How much of a credit am I given for this year, in pounds` 100 4900 5000 EQUALS 100
-- 200 credit, only 100 needed.
#ASSERT `How much of a credit am I given for this year, in pounds` 200 4900 5000 EQUALS 100
-- Already at the factor: nothing is needed.
#ASSERT `How much of a credit am I given for this year, in pounds` 100 5000 5000 EQUALS 0
-- Above the factor: still nothing, never negative.
#ASSERT `How much of a credit am I given for this year, in pounds` 100 6000 5000 EQUALS 0


§§§ `Years before 6 April 2016 (regs 26 to 28)`

-- Q57. What am I credited with for a year before 6 April 2016 under the 1975 Credits Regulations, in pounds (reg 26)?
-- A week in 2010.
#ASSERT `What am I credited with for a year before 6 April 2016 under the 1975 Credits Regulations, in pounds` (YMD 2010 6 7) 52 EQUALS JUST 52
-- The week beginning 5 April 2016.
#ASSERT `What am I credited with for a year before 6 April 2016 under the 1975 Credits Regulations, in pounds` (YMD 2016 4 5) 52 EQUALS JUST 52
-- A week in Chapter 3.
#ASSERT `What am I credited with for a year before 6 April 2016 under the 1975 Credits Regulations, in pounds` (YMD 2016 4 6) 52 EQUALS NOTHING

-- Q58. What Class 3 contribution am I credited with as a parent or carer for a year before 6 April 2016, in pounds (reg 27)?
-- A week in 2010.
#ASSERT `What Class 3 contribution am I credited with as a parent or carer for a year before 6 April 2016, in pounds` (YMD 2010 6 7) 15.85 EQUALS JUST 15.85
-- A week in Chapter 3.
#ASSERT `What Class 3 contribution am I credited with as a parent or carer for a year before 6 April 2016, in pounds` (YMD 2016 4 6) 15.85 EQUALS NOTHING

-- Q59. Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces (regs 28, 33)?
-- A week in 2010, everything in order.
#ASSERT `Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2010 6 7) TRUE TRUE 12000 5000 FALSE FALSE TRUE TRUE TRUE TRUE
-- The week beginning 5 April 2016 is in tax year 2015: regulation 28.
#ASSERT `Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2016 4 5) TRUE TRUE 12000 5000 FALSE FALSE TRUE TRUE TRUE TRUE
-- The week beginning 6 April 2016: regulation 33.
#ASSERT `Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2016 4 6) TRUE TRUE 12000 5000 FALSE FALSE TRUE TRUE TRUE TRUE
-- The week beginning 6 April 1975 is in the first year regulation 28 can reach.
#ASSERT `Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 1975 4 6) TRUE TRUE 12000 5000 FALSE FALSE TRUE TRUE TRUE TRUE
-- The week beginning 5 April 1975 is in tax year 1974: before regulation 28 can reach.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 1975 4 5) TRUE TRUE 12000 5000 FALSE FALSE TRUE TRUE TRUE TRUE)
-- The member's earnings factors only equal the qualifying factor: 'exceed' is not met.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2010 6 7) TRUE TRUE 5000 5000 FALSE FALSE TRUE TRUE TRUE TRUE)
-- The same under regulation 33.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2016 4 6) TRUE TRUE 5000 5000 FALSE FALSE TRUE TRUE TRUE TRUE)
-- Not a spouse or civil partner of a member of the forces.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2010 6 7) FALSE TRUE 12000 5000 FALSE FALSE TRUE TRUE TRUE TRUE)
-- Not accompanying the member.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2010 6 7) TRUE FALSE 12000 5000 FALSE FALSE TRUE TRUE TRUE TRUE)
-- Entitled to credits under the 1975 Regulations for that week.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2010 6 7) TRUE TRUE 12000 5000 TRUE FALSE TRUE TRUE TRUE TRUE)
-- A woman with a reduced rate election in force.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2010 6 7) TRUE TRUE 12000 5000 FALSE TRUE TRUE TRUE TRUE TRUE)
-- No application.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2010 6 7) TRUE TRUE 12000 5000 FALSE FALSE FALSE TRUE TRUE TRUE)
-- An application not for a past period.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2010 6 7) TRUE TRUE 12000 5000 FALSE FALSE TRUE FALSE TRUE TRUE)
-- An application not on an approved form.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2010 6 7) TRUE TRUE 12000 5000 FALSE FALSE TRUE TRUE FALSE TRUE)
-- An application without the specified information.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week as the spouse or civil partner of a member of the forces` (YMD 2010 6 7) TRUE TRUE 12000 5000 FALSE FALSE TRUE TRUE TRUE FALSE)

-- Q60. Does my application to be credited as the spouse or civil partner of a member of the forces contain what the Regulations require (reg 28(5), (6))?
-- All four.
#ASSERT `Does my application to be credited as the spouse or civil partner of a member of the forces contain what the Regulations require` TRUE TRUE TRUE TRUE
-- No application received.
#ASSERT NOT (`Does my application to be credited as the spouse or civil partner of a member of the forces contain what the Regulations require` FALSE TRUE TRUE TRUE)
-- Not for a past period.
#ASSERT NOT (`Does my application to be credited as the spouse or civil partner of a member of the forces contain what the Regulations require` TRUE FALSE TRUE TRUE)
-- Not on an approved form.
#ASSERT NOT (`Does my application to be credited as the spouse or civil partner of a member of the forces contain what the Regulations require` TRUE TRUE FALSE TRUE)
-- Missing the specified information.
#ASSERT NOT (`Does my application to be credited as the spouse or civil partner of a member of the forces contain what the Regulations require` TRUE TRUE TRUE FALSE)


§§§ `Credits for benefits, tax credits and age (regs 29 to 33)`

-- Q61. Is a credit I get under the 1975 Credits Regulations also given for my State Pension (reg 29)?
-- Jury service.
#ASSERT `Is a credit I get under the 1975 Credits Regulations also given for my State Pension` `regulation 9B (credits for jury service)` TRUE
-- Approved training.
#ASSERT `Is a credit I get under the 1975 Credits Regulations also given for my State Pension` `regulation 7 (credits for approved training)` TRUE
-- Credited under a provision not on the list.
#ASSERT NOT (`Is a credit I get under the 1975 Credits Regulations also given for my State Pension` `another provision of the 1975 Regulations` TRUE)
-- Not credited under a listed provision.
#ASSERT NOT (`Is a credit I get under the 1975 Credits Regulations also given for my State Pension` `regulation 9B (credits for jury service)` FALSE)

-- Q62. Am I credited with earnings for this week because I am paid working tax credit (reg 30)?
-- An employed earner paid working tax credit.
#ASSERT `Am I credited with earnings for this week because I am paid working tax credit` TRUE `an employed earner` FALSE FALSE FALSE FALSE FALSE FALSE 123
-- A low-profit self-employed earner.
#ASSERT `Am I credited with earnings for this week because I am paid working tax credit` TRUE `a self-employed earner whose profits for the year are below the small profits threshold specified by section 11(4)(b) of the 1992 Act, who would otherwise ... be treated as having actually paid, a Class 2 contribution` FALSE FALSE FALSE FALSE FALSE FALSE 123
-- A person excepted by regulation 43.
#ASSERT `Am I credited with earnings for this week because I am paid working tax credit` TRUE `a person excepted from being treated as having actually paid a Class 2 contribution by virtue of regulation 43 of the Social Security (Contributions) Regulations 2001` FALSE FALSE FALSE FALSE FALSE FALSE 123
-- Another kind of person.
#ASSERT NOT (`Am I credited with earnings for this week because I am paid working tax credit` TRUE `another kind of person` FALSE FALSE FALSE FALSE FALSE FALSE 123)
-- No working tax credit for the week.
#ASSERT NOT (`Am I credited with earnings for this week because I am paid working tax credit` FALSE `an employed earner` FALSE FALSE FALSE FALSE FALSE FALSE 123)
-- Entitled to credits under the 1975 Regulations.
#ASSERT NOT (`Am I credited with earnings for this week because I am paid working tax credit` TRUE `an employed earner` FALSE FALSE FALSE FALSE TRUE FALSE 123)
-- A woman with a reduced rate election.
#ASSERT NOT (`Am I credited with earnings for this week because I am paid working tax credit` TRUE `an employed earner` FALSE FALSE FALSE FALSE FALSE TRUE 123)
-- A couple, only one assessed, and that is me.
#ASSERT `Am I credited with earnings for this week because I am paid working tax credit` TRUE `an employed earner` TRUE TRUE TRUE FALSE FALSE FALSE 123
-- A couple, only one assessed, and that is my partner.
#ASSERT NOT (`Am I credited with earnings for this week because I am paid working tax credit` TRUE `an employed earner` TRUE TRUE FALSE TRUE FALSE FALSE 123)
-- A couple, both assessed, paid to me.
#ASSERT `Am I credited with earnings for this week because I am paid working tax credit` TRUE `an employed earner` TRUE FALSE FALSE TRUE FALSE FALSE 123
-- A couple, both assessed, paid to my partner.
#ASSERT NOT (`Am I credited with earnings for this week because I am paid working tax credit` TRUE `an employed earner` TRUE FALSE TRUE FALSE FALSE FALSE 123)

-- Q63. How much earnings am I credited with for a week in which I am paid working tax credit, in pounds (reg 30(1))?
-- Employed earner, lower earnings limit 123.
#ASSERT `How much earnings am I credited with for a week in which I am paid working tax credit, in pounds` TRUE `an employed earner` FALSE FALSE FALSE FALSE FALSE FALSE 123 EQUALS JUST 123
-- Another kind of person.
#ASSERT `How much earnings am I credited with for a week in which I am paid working tax credit, in pounds` TRUE `another kind of person` FALSE FALSE FALSE FALSE FALSE FALSE 123 EQUALS NOTHING

-- Q64. Am I credited with a Class 3 contribution for this week because I am entitled to universal credit (reg 31)?
-- Entitled.
#ASSERT `Am I credited with a Class 3 contribution for this week because I am entitled to universal credit` TRUE
-- Not entitled.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week because I am entitled to universal credit` FALSE)

-- Q65. Am I credited with earnings for this week as a man approaching State Pension age (reg 32)?
-- Born 5 October 1953, a week in 2016.
#ASSERT `Am I credited with earnings for this week as a man approaching State Pension age` (YMD 1953 10 5) (YMD 2016 1 5) (YMD 2016 10 3) 0 FALSE FALSE FALSE 123
-- The year he reaches the woman's age (2015).
#ASSERT `Am I credited with earnings for this week as a man approaching State Pension age` (YMD 1953 10 5) (YMD 2016 1 5) (YMD 2015 10 5) 0 FALSE FALSE FALSE 123
-- The year before (2014).
#ASSERT NOT (`Am I credited with earnings for this week as a man approaching State Pension age` (YMD 1953 10 5) (YMD 2016 1 5) (YMD 2014 10 6) 0 FALSE FALSE FALSE 123)
-- The year he turns 65 (2018): a year 'prior to' it is needed.
#ASSERT NOT (`Am I credited with earnings for this week as a man approaching State Pension age` (YMD 1953 10 5) (YMD 2016 1 5) (YMD 2018 10 8) 0 FALSE FALSE FALSE 123)
-- Born 6 October 1953: not before it.
#ASSERT NOT (`Am I credited with earnings for this week as a man approaching State Pension age` (YMD 1953 10 6) (YMD 2016 1 5) (YMD 2016 10 3) 0 FALSE FALSE FALSE 123)
-- Absent 182 days.
#ASSERT `Am I credited with earnings for this week as a man approaching State Pension age` (YMD 1953 10 5) (YMD 2016 1 5) (YMD 2016 10 3) 182 FALSE FALSE FALSE 123
-- Absent 183 days.
#ASSERT NOT (`Am I credited with earnings for this week as a man approaching State Pension age` (YMD 1953 10 5) (YMD 2016 1 5) (YMD 2016 10 3) 183 FALSE FALSE FALSE 123)
-- Self-employed with neither (a) nor (b).
#ASSERT NOT (`Am I credited with earnings for this week as a man approaching State Pension age` (YMD 1953 10 5) (YMD 2016 1 5) (YMD 2016 10 3) 0 TRUE FALSE FALSE 123)
-- Self-employed, (a).
#ASSERT `Am I credited with earnings for this week as a man approaching State Pension age` (YMD 1953 10 5) (YMD 2016 1 5) (YMD 2016 10 3) 0 TRUE TRUE FALSE 123
-- Self-employed, (b).
#ASSERT `Am I credited with earnings for this week as a man approaching State Pension age` (YMD 1953 10 5) (YMD 2016 1 5) (YMD 2016 10 3) 0 TRUE FALSE TRUE 123

-- Q66. How much earnings am I credited with for that week as a man approaching State Pension age, in pounds (reg 32(1))?
-- Credited.
#ASSERT `How much earnings am I credited with for that week as a man approaching State Pension age, in pounds` (YMD 1953 10 5) (YMD 2016 1 5) (YMD 2016 10 3) 0 FALSE FALSE FALSE 123 EQUALS JUST 123
-- Born 6 October 1953.
#ASSERT `How much earnings am I credited with for that week as a man approaching State Pension age, in pounds` (YMD 1953 10 6) (YMD 2016 1 5) (YMD 2016 10 3) 0 FALSE FALSE FALSE 123 EQUALS NOTHING


§§§ `Credits for child benefit, caring and fostering (regs 34 to 39)`

-- Q67. Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12 (reg 34)?
-- A partner, everything met.
#ASSERT `Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12` FALSE TRUE TRUE TRUE TRUE FALSE TRUE 6000 0 5000
-- Awarded child benefit myself.
#ASSERT `Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12` TRUE FALSE FALSE FALSE FALSE FALSE FALSE 0 0 5000
-- Neither awarded nor a partner.
#ASSERT NOT (`Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12` FALSE FALSE TRUE TRUE TRUE FALSE TRUE 6000 0 5000)
-- Not living with them.
#ASSERT NOT (`Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12` FALSE TRUE FALSE TRUE TRUE FALSE TRUE 6000 0 5000)
-- Not sharing responsibility.
#ASSERT NOT (`Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12` FALSE TRUE TRUE FALSE TRUE FALSE TRUE 6000 0 5000)
-- Not ordinarily resident in Great Britain.
#ASSERT NOT (`Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12` FALSE TRUE TRUE TRUE FALSE FALSE TRUE 6000 0 5000)
-- In prison.
#ASSERT NOT (`Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12` FALSE TRUE TRUE TRUE TRUE TRUE TRUE 6000 0 5000)
-- No application.
#ASSERT NOT (`Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12` FALSE TRUE TRUE TRUE TRUE FALSE FALSE 6000 0 5000)
-- Their earnings factors only equal the qualifying factor.
#ASSERT NOT (`Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12` FALSE TRUE TRUE TRUE TRUE FALSE TRUE 5000 0 5000)
-- One above.
#ASSERT `Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12` FALSE TRUE TRUE TRUE TRUE FALSE TRUE 5001 0 5000
-- 6000 less 1000 derived from child benefit credits is 5000: not above.
#ASSERT NOT (`Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12` FALSE TRUE TRUE TRUE TRUE FALSE TRUE 6000 1000 5000)
-- 6000 less 999 is 5001.
#ASSERT `Am I entitled to be credited with a Class 3 contribution because child benefit is awarded for a child under 12` FALSE TRUE TRUE TRUE TRUE FALSE TRUE 6000 999 5000

-- Q68. Am I credited with a Class 3 contribution for this week because I cared for a child under 12 (reg 35(1) to (4))?
-- A grandparent, everything met, nobody else qualifies.
#ASSERT `Am I credited with a Class 3 contribution for this week because I cared for a child under 12` TRUE `a grandparent of the child` TRUE TRUE 6000 5000 TRUE 1 FALSE FALSE FALSE FALSE
-- Did not provide care.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week because I cared for a child under 12` FALSE `a grandparent of the child` TRUE TRUE 6000 5000 TRUE 1 FALSE FALSE FALSE FALSE)
-- Not a listed relationship.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week because I cared for a child under 12` TRUE `none of the relationships listed in regulation 35(6)` TRUE TRUE 6000 5000 TRUE 1 FALSE FALSE FALSE FALSE)
-- Not ordinarily resident in Great Britain.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week because I cared for a child under 12` TRUE `a grandparent of the child` FALSE TRUE 6000 5000 TRUE 1 FALSE FALSE FALSE FALSE)
-- Child benefit not awarded to another person.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week because I cared for a child under 12` TRUE `a grandparent of the child` TRUE FALSE 6000 5000 TRUE 1 FALSE FALSE FALSE FALSE)
-- Their earnings factors only equal the qualifying factor.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week because I cared for a child under 12` TRUE `a grandparent of the child` TRUE TRUE 5000 5000 TRUE 1 FALSE FALSE FALSE FALSE)
-- One above.
#ASSERT `Am I credited with a Class 3 contribution for this week because I cared for a child under 12` TRUE `a grandparent of the child` TRUE TRUE 5001 5000 TRUE 1 FALSE FALSE FALSE FALSE
-- No application.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week because I cared for a child under 12` TRUE `a grandparent of the child` TRUE TRUE 6000 5000 FALSE 1 FALSE FALSE FALSE FALSE)
-- Two could qualify; they elected me.
#ASSERT `Am I credited with a Class 3 contribution for this week because I cared for a child under 12` TRUE `a grandparent of the child` TRUE TRUE 6000 5000 TRUE 2 TRUE TRUE FALSE FALSE
-- Two could qualify; they elected the other.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week because I cared for a child under 12` TRUE `a grandparent of the child` TRUE TRUE 6000 5000 TRUE 2 TRUE FALSE FALSE FALSE)
-- Two could qualify; no election and the Secretary of State has not decided.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week because I cared for a child under 12` TRUE `a grandparent of the child` TRUE TRUE 6000 5000 TRUE 2 FALSE FALSE FALSE FALSE)
-- Two could qualify; no election; the Secretary of State chose me.
#ASSERT `Am I credited with a Class 3 contribution for this week because I cared for a child under 12` TRUE `a grandparent of the child` TRUE TRUE 6000 5000 TRUE 2 FALSE FALSE TRUE TRUE
-- Two could qualify; no election; the Secretary of State chose the other.
#ASSERT NOT (`Am I credited with a Class 3 contribution for this week because I cared for a child under 12` TRUE `a grandparent of the child` TRUE TRUE 6000 5000 TRUE 2 FALSE FALSE TRUE FALSE)

-- Q69. Which of the carers is credited for that week (reg 35(4))?
-- Only me.
#ASSERT `Which of the carers is credited for that week` 1 FALSE FALSE FALSE FALSE EQUALS `no other person can satisfy paragraph (3)(a)(i), so paragraph (4) does not arise`
-- Two, they elected me.
