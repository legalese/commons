-- Two, they elected the other.
#ASSERT `Which of the carers is credited for that week` 2 TRUE FALSE FALSE FALSE EQUALS `another carer is the carer credited`
-- Two, no election, not yet decided.
#ASSERT `Which of the carers is credited for that week` 2 FALSE FALSE FALSE FALSE EQUALS `the Secretary of State has not yet decided which carer is credited`
-- Two, no election, the Secretary of State chose me.
#ASSERT `Which of the carers is credited for that week` 2 FALSE FALSE TRUE TRUE EQUALS `the person is the carer credited`
-- Two, no election, the Secretary of State chose the other.
#ASSERT `Which of the carers is credited for that week` 2 FALSE FALSE TRUE FALSE EQUALS `another carer is the carer credited`

