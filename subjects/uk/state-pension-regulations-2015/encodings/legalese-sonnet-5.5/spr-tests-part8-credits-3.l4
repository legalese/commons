#ASSERT `regulation 37(2)(a): the person cares for 20 or more hours at an appropriate level` `carer, 20 hours, person cared for gets attendance allowance, applied`
#ASSERT NOT (`regulation 37(2)(a): the person cares for 20 or more hours at an appropriate level` `carer, 19 hours`)
#ASSERT NOT (`regulation 37(2)(a): the person cares for 20 or more hours at an appropriate level` `carer, 19.5 hours`)
#ASSERT `regulation 37(2)(a): the person cares for 20 or more hours at an appropriate level` `carer, 40 hours, two people cared for, both on a relevant benefit`
-- (i): each person cared for must be on a relevant benefit; (ii): or the Secretary of State considers the level appropriate.
#ASSERT NOT (`regulation 37(2)(a): the person cares for 20 or more hours at an appropriate level` `carer, 20 hours, one of two people cared for on no relevant benefit`)
#ASSERT `regulation 37(2)(a): the person cares for 20 or more hours at an appropriate level` `carer, 20 hours, one of two on no relevant benefit, but the Secretary of State considers the level appropriate`
#ASSERT NOT (`regulation 37(2)(a): the person cares for 20 or more hours at an appropriate level` `carer, 20 hours, nobody on a relevant benefit, no view from the Secretary of State`)
#ASSERT `regulation 37(2)(a): the person cares for 20 or more hours at an appropriate level` `carer, 20 hours, no benefit information, Secretary of State considers it appropriate`
-- Caring for nobody on a benefit is not "each person cared for is entitled".
#ASSERT NOT (`regulation 37(2)(a): the person cares for 20 or more hours at an appropriate level` `carer, 20 hours, no benefit information, no view from the Secretary of State`)
#ASSERT `regulation 37(2)(b): the person is within Schedule 1B to the Income Support (General) Regulations 1987` `Schedule 1B carer, no hours, no application`
#ASSERT `regulation 37(2): the person is engaged in caring in the week` `Schedule 1B carer, no hours, no application`
#ASSERT NOT (`regulation 37(2): the person is engaged in caring in the week` `carer, 19 hours`)
-- (3): not engaged in caring while not ordinarily resident in Great Britain or in prison.
#ASSERT NOT (`regulation 37(2): the person is engaged in caring in the week` `carer not ordinarily resident in Great Britain`)
#ASSERT NOT (`regulation 37(2): the person is engaged in caring in the week` `carer in prison`)
#ASSERT NOT (`regulation 37(2): the person is engaged in caring in the week` `Schedule 1B carer not ordinarily resident in Great Britain`)
-- (5), (8): an application is needed for (2)(a), except for a woman with a reduced rate election.
#ASSERT `regulation 37(5): an application is required` `carer, 20 hours, person cared for gets attendance allowance, applied`
#ASSERT NOT (`regulation 37(5): an application is required` `woman with a reduced rate election, 20 hours, no application`)
#ASSERT NOT (`regulation 37(5): an application is required` `Schedule 1B carer, no hours, no application`)
-- (1): credited.
#ASSERT `regulation 37(1): the person is credited with a Class 3 contribution for the week` `carer, 20 hours, person cared for gets attendance allowance, applied`
#ASSERT NOT (`regulation 37(1): the person is credited with a Class 3 contribution for the week` `carer, 20 hours, no application`)
#ASSERT `regulation 37(1): the person is credited with a Class 3 contribution for the week` `Schedule 1B carer, no hours, no application`
#ASSERT `regulation 37(1): the person is credited with a Class 3 contribution for the week` `woman with a reduced rate election, 20 hours, no application`
#ASSERT NOT (`regulation 37(1): the person is credited with a Class 3 contribution for the week` `woman with a reduced rate election, 10 hours, no application`)
#ASSERT NOT (`regulation 37(1): the person is credited with a Class 3 contribution for the week` `carer not ordinarily resident in Great Britain`)
#ASSERT NOT (`regulation 37(1): the person is credited with a Class 3 contribution for the week` `carer in prison`)
#ASSERT NOT (`regulation 37(1): the person is credited with a Class 3 contribution for the week` `Schedule 1B carer not ordinarily resident in Great Britain`)

-- (7): an appropriate person.
#ASSERT `regulation 37(7): the person is an appropriate person` TRUE TRUE
#ASSERT NOT (`regulation 37(7): the person is an appropriate person` TRUE FALSE)
#ASSERT NOT (`regulation 37(7): the person is an appropriate person` FALSE TRUE)

-- (6): content of the application.
`application, benefit named, no level declaration asked for` MEANS CaringApplication WITH
    `the application includes a declaration by the applicant that the applicant cares for a person or persons for 20 or more hours in a week` IS TRUE
    `the application includes the name and, where known, the national insurance number of each person cared for` IS TRUE
    `a person cared for is entitled to a relevant benefit` IS TRUE
    `the application says which relevant benefit each person cared for is entitled to` IS TRUE
    `the Secretary of State has asked for a declaration as to the level of care required` IS FALSE
    `the application includes a declaration signed by an appropriate person as to the level of care required for each person cared for` IS FALSE

`application without the 20-hour declaration` MEANS CaringApplication WITH
    `the application includes a declaration by the applicant that the applicant cares for a person or persons for 20 or more hours in a week` IS FALSE
    `the application includes the name and, where known, the national insurance number of each person cared for` IS TRUE
    `a person cared for is entitled to a relevant benefit` IS TRUE
    `the application says which relevant benefit each person cared for is entitled to` IS TRUE
    `the Secretary of State has asked for a declaration as to the level of care required` IS FALSE
    `the application includes a declaration signed by an appropriate person as to the level of care required for each person cared for` IS FALSE

