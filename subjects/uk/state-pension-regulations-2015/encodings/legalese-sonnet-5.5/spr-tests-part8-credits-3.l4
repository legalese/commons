§ `Regulation 34`

#ASSERT `regulation 34(1): the person is entitled to be credited with a Class 3 contribution for the week` `partner of the person awarded child benefit, all conditions met`
#ASSERT `regulation 34(1): the person is entitled to be credited with a Class 3 contribution for the week` `awarded child benefit for a child under 12`
#ASSERT NOT (`regulation 34(1): the person is entitled to be credited with a Class 3 contribution for the week` `neither awarded nor a partner`)
#ASSERT NOT (`regulation 34(1): the person is entitled to be credited with a Class 3 contribution for the week` `partner, not living with the person awarded`)
#ASSERT NOT (`regulation 34(1): the person is entitled to be credited with a Class 3 contribution for the week` `partner, not sharing responsibility`)
#ASSERT NOT (`regulation 34(1): the person is entitled to be credited with a Class 3 contribution for the week` `partner, not ordinarily resident in Great Britain`)
#ASSERT NOT (`regulation 34(1): the person is entitled to be credited with a Class 3 contribution for the week` `partner, in prison`)
#ASSERT NOT (`regulation 34(1): the person is entitled to be credited with a Class 3 contribution for the week` `partner, no application`)
-- (3): the person awarded must have earnings factors that exceed the qualifying factor.
#ASSERT NOT (`regulation 34(1): the person is entitled to be credited with a Class 3 contribution for the week` `partner, earnings factors equal the qualifying earnings factor`)
#ASSERT `regulation 34(1): the person is entitled to be credited with a Class 3 contribution for the week` `partner, earnings factors one above`
-- (4): earnings factors derived from child benefit credits are left out.
#ASSERT `regulation 34(4): the earnings factors that count` `partner, 6000 of which 1000 derived from child benefit credits` EQUALS 5000
#ASSERT NOT (`regulation 34(1): the person is entitled to be credited with a Class 3 contribution for the week` `partner, 6000 of which 1000 derived from child benefit credits`)
#ASSERT `regulation 34(1): the person is entitled to be credited with a Class 3 contribution for the week` `partner, 6000 of which 999 derived from child benefit credits`
#ASSERT `regulation 34(2): the circumstances are met` `partner of the person awarded child benefit, all conditions met`
#ASSERT NOT (`regulation 34(2): the circumstances are met` `partner, in prison`)
#ASSERT `regulation 34(3): the week falls within a year for which the earnings factors exceed the qualifying earnings factor` `partner, earnings factors one above`
#ASSERT NOT (`regulation 34(3): the week falls within a year for which the earnings factors exceed the qualifying earnings factor` `partner, earnings factors equal the qualifying earnings factor`)

§ `Regulation 35`

#ASSERT `regulation 35(6): the relationship is one the paragraph specifies` `a non-resident parent of the child`
#ASSERT `regulation 35(6): the relationship is one the paragraph specifies` `a grandparent of the child`
#ASSERT `regulation 35(6): the relationship is one the paragraph specifies` `a great-grandparent of the child`
#ASSERT `regulation 35(6): the relationship is one the paragraph specifies` `a great-great-grandparent of the child`
#ASSERT `regulation 35(6): the relationship is one the paragraph specifies` `a sibling of the child`
#ASSERT `regulation 35(6): the relationship is one the paragraph specifies` `a sibling of a parent of the child`
#ASSERT `regulation 35(6): the relationship is one the paragraph specifies` `a spouse or former spouse of a person listed in regulation 35(6)(a) to (f)`
#ASSERT `regulation 35(6): the relationship is one the paragraph specifies` `a civil partner or former civil partner of a person listed in regulation 35(6)(a) to (f)`
#ASSERT `regulation 35(6): the relationship is one the paragraph specifies` `a partner or former partner of a person listed in regulation 35(6)(a) to (h)`
#ASSERT `regulation 35(6): the relationship is one the paragraph specifies` `a son or daughter of a person listed in regulation 35(6)(e) to (i)`
#ASSERT `regulation 35(6): the relationship is one the paragraph specifies` `in respect of a son or daughter of a person listed in regulation 35(6)(f), that person's spouse, former spouse, civil partner, former civil partner, partner or former partner`
#ASSERT NOT (`regulation 35(6): the relationship is one the paragraph specifies` `none of the relationships listed in regulation 35(6)`)

-- (8): a partner is the other member of a couple who are not married or civil partners but live together as if they were.
#ASSERT `regulation 35(8): the person is a partner` TRUE FALSE TRUE
#ASSERT NOT (`regulation 35(8): the person is a partner` TRUE TRUE TRUE)
#ASSERT NOT (`regulation 35(8): the person is a partner` TRUE FALSE FALSE)
#ASSERT NOT (`regulation 35(8): the person is a partner` FALSE FALSE TRUE)
-- (7): a sibling includes half blood, step and adopted siblings.
#ASSERT `regulation 35(7): the person counts as a sibling` TRUE FALSE FALSE FALSE
#ASSERT `regulation 35(7): the person counts as a sibling` FALSE TRUE FALSE FALSE
#ASSERT `regulation 35(7): the person counts as a sibling` FALSE FALSE TRUE FALSE
#ASSERT `regulation 35(7): the person counts as a sibling` FALSE FALSE FALSE TRUE
#ASSERT NOT (`regulation 35(7): the person counts as a sibling` FALSE FALSE FALSE FALSE)

-- (4): several carers can satisfy (3)(a)(i): they elect, with B's agreement; failing that the Secretary of State decides.
#ASSERT `regulation 35(4): which carer is credited` 1 FALSE FALSE NOTHING EQUALS `no other person can satisfy paragraph (3)(a)(i), so paragraph (4) does not arise`
#ASSERT `regulation 35(4): which carer is credited` 2 TRUE TRUE NOTHING EQUALS `the person is the carer credited`
#ASSERT `regulation 35(4): which carer is credited` 2 TRUE FALSE NOTHING EQUALS `another carer is the carer credited`
#ASSERT `regulation 35(4): which carer is credited` 2 FALSE FALSE NOTHING EQUALS `the Secretary of State has not yet decided which carer is credited`
#ASSERT `regulation 35(4): which carer is credited` 2 FALSE FALSE (JUST TRUE) EQUALS `the person is the carer credited`
#ASSERT `regulation 35(4): which carer is credited` 2 FALSE FALSE (JUST FALSE) EQUALS `another carer is the carer credited`
-- Agreement decides, whatever the Secretary of State has since said.
#ASSERT `regulation 35(4): which carer is credited` 3 TRUE TRUE (JUST FALSE) EQUALS `the person is the carer credited`

`application with everything and no declaration asked for` MEANS ChildCareApplication WITH
    `the application includes the name and date of birth of the child, or each child, cared for` IS TRUE
    `the Secretary of State or the Commissioners for Her Majesty's Revenue and Customs have asked for a declaration by B that the conditions in paragraph (2) are satisfied` IS FALSE
    `the application includes that declaration by B` IS FALSE
    `the application specifies the relevant week or weeks in which the child, or each child, was cared for` IS TRUE

`application where a declaration was asked for and given` MEANS ChildCareApplication WITH
    `the application includes the name and date of birth of the child, or each child, cared for` IS TRUE
    `the Secretary of State or the Commissioners for Her Majesty's Revenue and Customs have asked for a declaration by B that the conditions in paragraph (2) are satisfied` IS TRUE
    `the application includes that declaration by B` IS TRUE
    `the application specifies the relevant week or weeks in which the child, or each child, was cared for` IS TRUE

`application where a declaration was asked for and not given` MEANS ChildCareApplication WITH
    `the application includes the name and date of birth of the child, or each child, cared for` IS TRUE
    `the Secretary of State or the Commissioners for Her Majesty's Revenue and Customs have asked for a declaration by B that the conditions in paragraph (2) are satisfied` IS TRUE
    `the application includes that declaration by B` IS FALSE
    `the application specifies the relevant week or weeks in which the child, or each child, was cared for` IS TRUE

`application without the child's name and date of birth` MEANS ChildCareApplication WITH
    `the application includes the name and date of birth of the child, or each child, cared for` IS FALSE
    `the Secretary of State or the Commissioners for Her Majesty's Revenue and Customs have asked for a declaration by B that the conditions in paragraph (2) are satisfied` IS FALSE
    `the application includes that declaration by B` IS FALSE
    `the application specifies the relevant week or weeks in which the child, or each child, was cared for` IS TRUE

`application without the weeks` MEANS ChildCareApplication WITH
    `the application includes the name and date of birth of the child, or each child, cared for` IS TRUE
    `the Secretary of State or the Commissioners for Her Majesty's Revenue and Customs have asked for a declaration by B that the conditions in paragraph (2) are satisfied` IS FALSE
    `the application includes that declaration by B` IS FALSE
    `the application specifies the relevant week or weeks in which the child, or each child, was cared for` IS FALSE

#ASSERT `regulation 35(5): the application has the required content` `application with everything and no declaration asked for`
#ASSERT `regulation 35(5): the application has the required content` `application where a declaration was asked for and given`
#ASSERT NOT (`regulation 35(5): the application has the required content` `application where a declaration was asked for and not given`)
#ASSERT NOT (`regulation 35(5): the application has the required content` `application without the child's name and date of birth`)
#ASSERT NOT (`regulation 35(5): the application has the required content` `application without the weeks`)

§ `Fixtures for regulation 35(1) to (3)`
`grandparent who cared for a child under 12, all conditions met` MEANS ChildCareFacts WITH
    `the person provided care in the week in respect of a child under the age of 12` IS TRUE
    `the person's relationship to the child` IS `a grandparent of the child`
    `the person was ordinarily resident in Great Britain in the week` IS TRUE
    `child benefit was awarded to another person, B, in respect of the child (or each child) cared for, and for the week in which the care was provided` IS TRUE
    `B's earnings factors, other than those derived from a Class 3 contribution credit awarded under regulation 34` IS 6000
    `the qualifying earnings factor for the year in which the week falls` IS 5000
    `the person has made an application to the Secretary of State in accordance with paragraph (5) and regulation 39` IS TRUE

`did not provide care` MEANS ChildCareFacts WITH
    `the person provided care in the week in respect of a child under the age of 12` IS FALSE
    `the person's relationship to the child` IS `a grandparent of the child`
    `the person was ordinarily resident in Great Britain in the week` IS TRUE
    `child benefit was awarded to another person, B, in respect of the child (or each child) cared for, and for the week in which the care was provided` IS TRUE
    `B's earnings factors, other than those derived from a Class 3 contribution credit awarded under regulation 34` IS 6000
    `the qualifying earnings factor for the year in which the week falls` IS 5000
    `the person has made an application to the Secretary of State in accordance with paragraph (5) and regulation 39` IS TRUE

`relationship not listed` MEANS ChildCareFacts WITH
    `the person provided care in the week in respect of a child under the age of 12` IS TRUE
    `the person's relationship to the child` IS `none of the relationships listed in regulation 35(6)`
    `the person was ordinarily resident in Great Britain in the week` IS TRUE
    `child benefit was awarded to another person, B, in respect of the child (or each child) cared for, and for the week in which the care was provided` IS TRUE
    `B's earnings factors, other than those derived from a Class 3 contribution credit awarded under regulation 34` IS 6000
    `the qualifying earnings factor for the year in which the week falls` IS 5000
    `the person has made an application to the Secretary of State in accordance with paragraph (5) and regulation 39` IS TRUE

`not ordinarily resident in Great Britain` MEANS ChildCareFacts WITH
    `the person provided care in the week in respect of a child under the age of 12` IS TRUE
    `the person's relationship to the child` IS `a grandparent of the child`
    `the person was ordinarily resident in Great Britain in the week` IS FALSE
    `child benefit was awarded to another person, B, in respect of the child (or each child) cared for, and for the week in which the care was provided` IS TRUE
    `B's earnings factors, other than those derived from a Class 3 contribution credit awarded under regulation 34` IS 6000
    `the qualifying earnings factor for the year in which the week falls` IS 5000
    `the person has made an application to the Secretary of State in accordance with paragraph (5) and regulation 39` IS TRUE

`child benefit not awarded to another person` MEANS ChildCareFacts WITH
    `the person provided care in the week in respect of a child under the age of 12` IS TRUE
    `the person's relationship to the child` IS `a grandparent of the child`
    `the person was ordinarily resident in Great Britain in the week` IS TRUE
    `child benefit was awarded to another person, B, in respect of the child (or each child) cared for, and for the week in which the care was provided` IS FALSE
    `B's earnings factors, other than those derived from a Class 3 contribution credit awarded under regulation 34` IS 6000
    `the qualifying earnings factor for the year in which the week falls` IS 5000
    `the person has made an application to the Secretary of State in accordance with paragraph (5) and regulation 39` IS TRUE

`B's earnings factors equal the qualifying earnings factor` MEANS ChildCareFacts WITH
    `the person provided care in the week in respect of a child under the age of 12` IS TRUE
    `the person's relationship to the child` IS `a grandparent of the child`
    `the person was ordinarily resident in Great Britain in the week` IS TRUE
    `child benefit was awarded to another person, B, in respect of the child (or each child) cared for, and for the week in which the care was provided` IS TRUE
    `B's earnings factors, other than those derived from a Class 3 contribution credit awarded under regulation 34` IS 5000
    `the qualifying earnings factor for the year in which the week falls` IS 5000
    `the person has made an application to the Secretary of State in accordance with paragraph (5) and regulation 39` IS TRUE

`B's earnings factors one above` MEANS ChildCareFacts WITH
    `the person provided care in the week in respect of a child under the age of 12` IS TRUE
    `the person's relationship to the child` IS `a grandparent of the child`
    `the person was ordinarily resident in Great Britain in the week` IS TRUE
    `child benefit was awarded to another person, B, in respect of the child (or each child) cared for, and for the week in which the care was provided` IS TRUE
    `B's earnings factors, other than those derived from a Class 3 contribution credit awarded under regulation 34` IS 5001
    `the qualifying earnings factor for the year in which the week falls` IS 5000
    `the person has made an application to the Secretary of State in accordance with paragraph (5) and regulation 39` IS TRUE

`no application` MEANS ChildCareFacts WITH
    `the person provided care in the week in respect of a child under the age of 12` IS TRUE
    `the person's relationship to the child` IS `a grandparent of the child`
    `the person was ordinarily resident in Great Britain in the week` IS TRUE
    `child benefit was awarded to another person, B, in respect of the child (or each child) cared for, and for the week in which the care was provided` IS TRUE
    `B's earnings factors, other than those derived from a Class 3 contribution credit awarded under regulation 34` IS 6000
    `the qualifying earnings factor for the year in which the week falls` IS 5000
    `the person has made an application to the Secretary of State in accordance with paragraph (5) and regulation 39` IS FALSE


§ `Regulation 35(1) to (3)`

#ASSERT `regulation 35(1): the person is credited with a Class 3 contribution for the week` `grandparent who cared for a child under 12, all conditions met` `no other person can satisfy paragraph (3)(a)(i), so paragraph (4) does not arise`
#ASSERT NOT (`regulation 35(1): the person is credited with a Class 3 contribution for the week` `did not provide care` `no other person can satisfy paragraph (3)(a)(i), so paragraph (4) does not arise`)
#ASSERT NOT (`regulation 35(1): the person is credited with a Class 3 contribution for the week` `relationship not listed` `no other person can satisfy paragraph (3)(a)(i), so paragraph (4) does not arise`)
#ASSERT NOT (`regulation 35(1): the person is credited with a Class 3 contribution for the week` `not ordinarily resident in Great Britain` `no other person can satisfy paragraph (3)(a)(i), so paragraph (4) does not arise`)
#ASSERT NOT (`regulation 35(1): the person is credited with a Class 3 contribution for the week` `child benefit not awarded to another person` `no other person can satisfy paragraph (3)(a)(i), so paragraph (4) does not arise`)
#ASSERT NOT (`regulation 35(1): the person is credited with a Class 3 contribution for the week` `B's earnings factors equal the qualifying earnings factor` `no other person can satisfy paragraph (3)(a)(i), so paragraph (4) does not arise`)
#ASSERT `regulation 35(1): the person is credited with a Class 3 contribution for the week` `B's earnings factors one above` `no other person can satisfy paragraph (3)(a)(i), so paragraph (4) does not arise`
#ASSERT NOT (`regulation 35(1): the person is credited with a Class 3 contribution for the week` `no application` `no other person can satisfy paragraph (3)(a)(i), so paragraph (4) does not arise`)
-- (4): where several carers qualify, only the elected one is credited.
#ASSERT `regulation 35(1): the person is credited with a Class 3 contribution for the week` `grandparent who cared for a child under 12, all conditions met` `the person is the carer credited`
#ASSERT NOT (`regulation 35(1): the person is credited with a Class 3 contribution for the week` `grandparent who cared for a child under 12, all conditions met` `another carer is the carer credited`)
#ASSERT NOT (`regulation 35(1): the person is credited with a Class 3 contribution for the week` `grandparent who cared for a child under 12, all conditions met` `the Secretary of State has not yet decided which carer is credited`)
#ASSERT `regulation 35(2): the conditions are satisfied` `grandparent who cared for a child under 12, all conditions met`
#ASSERT NOT (`regulation 35(2): the conditions are satisfied` `relationship not listed`)
#ASSERT `regulation 35(3): the person is not barred from being credited` `grandparent who cared for a child under 12, all conditions met`
#ASSERT NOT (`regulation 35(3): the person is not barred from being credited` `no application`)

§ `Regulation 36`

#ASSERT `regulation 36(2): the person is a foster parent` `a foster parent approved in accordance with Part 5 (approval of foster parents) of the Fostering Services (England) Regulations 2011`
#ASSERT `regulation 36(2): the person is a foster parent` `a kinship carer approved in accordance with Part 5 (kinship care) of the Looked After Children (Scotland) Regulations 2009`
#ASSERT `regulation 36(2): the person is a foster parent` `a foster carer approved in accordance with Part 7 (fostering) of the Looked After Children (Scotland) Regulations 2009`
#ASSERT `regulation 36(2): the person is a foster parent` `a foster parent approved in accordance with Part 2 (approvals and placements) of the Foster Placement (Children) Regulations (Northern Ireland) 1996`
#ASSERT NOT (`regulation 36(2): the person is a foster parent` `not approved in any of those ways`)
`approved English foster parent, all conditions met` MEANS FosterFacts WITH
    `how the person is approved` IS `a foster parent approved in accordance with Part 5 (approval of foster parents) of the Fostering Services (England) Regulations 2011`
    `the person is ordinarily resident in Great Britain in the week` IS TRUE
    `the person is undergoing imprisonment or detention in legal custody` IS FALSE
    `an application to be credited is received by the Commissioners for Her Majesty's Revenue and Customs in accordance with regulation 39` IS TRUE

`not approved` MEANS FosterFacts WITH
    `how the person is approved` IS `not approved in any of those ways`
    `the person is ordinarily resident in Great Britain in the week` IS TRUE
    `the person is undergoing imprisonment or detention in legal custody` IS FALSE
