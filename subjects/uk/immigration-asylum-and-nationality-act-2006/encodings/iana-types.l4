IMPORT prelude
IMPORT daydate

-- Immigration, Asylum and Nationality Act 2006 (UK) — THE NOUNS, for the
-- employment of illegal workers (ss 15-25). No rules here.
-- Source: ../registers/source-bundle/ukpga-2006-13.txt (point in time
-- 2 December 2025).

§ `Nouns`

-- s 15(1), s 24, s 25(c): the employee's position under the Immigration Act
-- 1971 during the employment.
DECLARE `Immigration position` IS ONE OF
    `not subject to immigration control`
    `no leave to enter or remain`
    `leave that is invalid`
    `leave that has ceased to have effect`
    `leave with a condition preventing this employment`
    `leave permitting this employment`
    `immigration bail with a restriction preventing this employment`
    `immigration bail without such a restriction`

DECLARE `Employment facts` HAS
    `employee's date of birth`                          IS A DATE
    `employed from`                                     IS A DATE
    `employed until`                                    IS A DATE
    -- s 25(b): under a contract of service or apprenticeship.
    `under a contract of service or apprenticeship`     IS A BOOLEAN
    `immigration position`                              IS AN `Immigration position`

-- s 16(4)-(5), s 17(4A): what happened to the employer's objection.
DECLARE `Objection outcome` IS ONE OF
    `no objection given`
    `penalty cancelled`
    -- s 16(4)(c), (5)(c): a new penalty notice, with the date it states as
    -- the date it is given.
    `penalty increased by a new notice given on` HAS `new notice date` IS A DATE
    -- s 16(4)(b), (d), (5)(b): the date the decision notice states as given.
    `penalty reduced or no action, decision given on` HAS `decision date` IS A DATE
    -- s 17(4A)(c): no decision informed within the s 16(5)(b) period, which
    -- ended on this date.
    `no decision, the period ended on` HAS `period end` IS A DATE

DECLARE `Penalty facts` HAS
    -- s 15(3)-(4)
    `complied with the prescribed requirements`         IS A BOOLEAN
    `knew at any time that the employment was contrary to s 15` IS A BOOLEAN
    -- s 15(2): the prescribed maximum (an input) and the amount specified.
    `the prescribed maximum`                            IS A NUMBER
    `the amount specified`                              IS A NUMBER
    -- s 15(6)(c)
    `notice states it is given on`                      IS A DATE
    `objection`                                         IS AN `Objection outcome`

DECLARE `Jurisdiction` IS ONE OF
    `England and Wales`
    `Scotland`
    `Northern Ireland`

DECLARE `Offence facts` HAS
    -- ss 21(1), 22(1): the employer (or a person responsible within a body
    -- for an aspect of the employment) knew the employee was disqualified.
    `knew the employee was disqualified`                IS A BOOLEAN
    -- ss 21(1A), 22(1A)
    `had reasonable cause to believe it`                IS A BOOLEAN
    `jurisdiction`                                      IS A `Jurisdiction`
    `convicted on`                                      IS A DATE
    -- s 21(2)(b)(i): the general limit in a magistrates' court in England and
    -- Wales, in months.
    `the general limit in months`                       IS A NUMBER
