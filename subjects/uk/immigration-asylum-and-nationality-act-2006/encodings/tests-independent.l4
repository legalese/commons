IMPORT prelude
IMPORT daydate
IMPORT `iana-types`
IMPORT `iana-employment`
IMPORT `iana-penalty`
IMPORT `iana-offence`
IMPORT `iana-goal`

-- Independent tests: IANA 2006 ss 15-25. Expected values were fixed in
-- independent-expectations.md from the Act, before the encoding was read.

§ `Helpers`

-- an employment on a single day d
GIVEN dob IS A DATE, d IS A DATE, svc IS A BOOLEAN, pos IS AN `Immigration position`
GIVETH AN `Employment facts`
emp dob d svc pos MEANS `Employment facts` OF dob, d, d, svc, pos

-- the default adult, contract of service, day 1 Mar 2026
GIVEN pos IS AN `Immigration position`
GIVETH AN `Employment facts`
adult pos MEANS emp (Date 1 1 1990) (Date 1 3 2026) TRUE pos

GIVEN complied IS A BOOLEAN, knew IS A BOOLEAN, mx IS A NUMBER, amt IS A NUMBER, given IS A DATE, obj IS AN `Objection outcome`
GIVETH A `Penalty facts`
pen complied knew mx amt given obj MEANS `Penalty facts` OF complied, knew, mx, amt, given, obj

GIVEN obj IS AN `Objection outcome`
GIVETH A `Penalty facts`
penObj obj MEANS pen FALSE FALSE 45000 20000 (Date 1 1 2026) obj

GIVEN given IS A DATE
GIVETH A `Penalty facts`
penGiven given MEANS pen FALSE FALSE 45000 20000 given `no objection given`

GIVEN knew IS A BOOLEAN, cause IS A BOOLEAN, jur IS A `Jurisdiction`, conv IS A DATE, lim IS A NUMBER
GIVETH AN `Offence facts`
off knew cause jur conv lim MEANS `Offence facts` OF knew, cause, jur, conv, lim

GIVEN knew IS A BOOLEAN, cause IS A BOOLEAN
GIVETH AN `Offence facts`
offK knew cause MEANS off knew cause `England and Wales` (Date 1 1 2026) 12

GIVEN jur IS A `Jurisdiction`, conv IS A DATE, lim IS A NUMBER
GIVETH AN `Offence facts`
offS jur conv lim MEANS off TRUE FALSE jur conv lim

§ `Goal 1 — s 15(1)`

-- E1-E8
#ASSERT `the employment is contrary to s 15 in` (adult `no leave to enter or remain`)
#ASSERT `the employment is contrary to s 15 in` (adult `leave that is invalid`)
#ASSERT `the employment is contrary to s 15 in` (adult `leave that has ceased to have effect`)
#ASSERT `the employment is contrary to s 15 in` (adult `leave with a condition preventing this employment`)
#ASSERT NOT (`the employment is contrary to s 15 in` (adult `leave permitting this employment`))
#ASSERT NOT (`the employment is contrary to s 15 in` (adult `not subject to immigration control`))
#ASSERT NOT (`the employment is contrary to s 15 in` (adult `immigration bail without such a restriction`))
#ASSERT `the employment is contrary to s 15 in` (adult `immigration bail with a restriction preventing this employment`)
-- E9, E11: age 15, day before 16th birthday
#ASSERT NOT (`the employment is contrary to s 15 in` (emp (Date 2 3 2010) (Date 1 3 2026) TRUE `no leave to enter or remain`))
-- E10: 16th birthday
#ASSERT `the employment is contrary to s 15 in` (emp (Date 1 3 2010) (Date 1 3 2026) TRUE `no leave to enter or remain`)
-- E12, E13: 29 Feb birthday, leap 16th birthday
#ASSERT `the employment is contrary to s 15 in` (emp (Date 29 2 2008) (Date 29 2 2024) TRUE `no leave to enter or remain`)
#ASSERT NOT (`the employment is contrary to s 15 in` (emp (Date 29 2 2008) (Date 28 2 2024) TRUE `no leave to enter or remain`))
-- E14-E16: 29 Feb 2084, 16th birthday in non-leap 2100
#ASSERT `the employment is contrary to s 15 in` (emp (Date 29 2 2084) (Date 28 2 2100) TRUE `no leave to enter or remain`)
#ASSERT NOT (`the employment is contrary to s 15 in` (emp (Date 29 2 2084) (Date 27 2 2100) TRUE `no leave to enter or remain`))
#ASSERT `the employment is contrary to s 15 in` (emp (Date 29 2 2084) (Date 1 3 2100) TRUE `no leave to enter or remain`)
-- E17: contract for services
#ASSERT NOT (`the employment is contrary to s 15 in` (emp (Date 1 1 1990) (Date 1 3 2026) FALSE `no leave to enter or remain`))
-- E18: apprenticeship (same boolean)
#ASSERT `the employment is contrary to s 15 in` (emp (Date 1 1 1990) (Date 1 3 2026) TRUE `no leave to enter or remain`)
-- E19
#ASSERT `the employment is contrary to s 15 in` (emp (Date 31 12 2009) (Date 31 12 2025) TRUE `no leave to enter or remain`)

§ `Goal 2 — the penalty`

-- P1-P4
#ASSERT `a penalty notice may be given for` (adult `no leave to enter or remain`) `with` (pen FALSE FALSE 45000 20000 (Date 1 1 2026) `no objection given`)
#ASSERT `a penalty notice may be given for` (adult `no leave to enter or remain`) `with` (pen FALSE FALSE 45000 45000 (Date 1 1 2026) `no objection given`)
#ASSERT NOT (`a penalty notice may be given for` (adult `no leave to enter or remain`) `with` (pen FALSE FALSE 45000 45001 (Date 1 1 2026) `no objection given`))
#ASSERT NOT (`a penalty notice may be given for` (adult `leave permitting this employment`) `with` (pen FALSE FALSE 45000 20000 (Date 1 1 2026) `no objection given`))

-- X1-X4
#ASSERT `the employer is excused under s 15(3) by` (pen TRUE FALSE 45000 20000 (Date 1 1 2026) `no objection given`)
#ASSERT NOT (`the employer is excused under s 15(3) by` (pen TRUE TRUE 45000 20000 (Date 1 1 2026) `no objection given`))
#ASSERT NOT (`the employer is excused under s 15(3) by` (pen FALSE FALSE 45000 20000 (Date 1 1 2026) `no objection given`))
#ASSERT NOT (`the employer is excused under s 15(3) by` (pen FALSE TRUE 45000 20000 (Date 1 1 2026) `no objection given`))
-- X1/X2 through the payable amount
#ASSERT `the penalty payable for` (adult `no leave to enter or remain`) `with` (pen TRUE FALSE 45000 20000 (Date 1 1 2026) `no objection given`) EQUALS 0
#ASSERT `the penalty payable for` (adult `no leave to enter or remain`) `with` (pen TRUE TRUE 45000 20000 (Date 1 1 2026) `no objection given`) EQUALS 20000
#ASSERT `the penalty payable for` (adult `no leave to enter or remain`) `with` (pen FALSE FALSE 45000 20000 (Date 1 1 2026) `no objection given`) EQUALS 20000

-- D1-D6: earliest pay-by date = given + 28
#ASSERT `the earliest pay-by date for` (penGiven (Date 1 1 2026)) EQUALS Date 29 1 2026
#ASSERT `the earliest pay-by date for` (penGiven (Date 1 2 2024)) EQUALS Date 29 2 2024
#ASSERT `the earliest pay-by date for` (penGiven (Date 1 2 2025)) EQUALS Date 1 3 2025
#ASSERT `the earliest pay-by date for` (penGiven (Date 15 12 2025)) EQUALS Date 12 1 2026
#ASSERT `the earliest pay-by date for` (penGiven (Date 31 1 2024)) EQUALS Date 28 2 2024
#ASSERT `the earliest pay-by date for` (penGiven (Date 2 2 2024)) EQUALS Date 1 3 2024

-- A1-A11: appeal availability and last day = relevant date + 27
#ASSERT `the last day to appeal for` (penObj `no objection given`) EQUALS NOTHING
#ASSERT `the last day to appeal for` (penObj `penalty cancelled`) EQUALS NOTHING
#ASSERT `the last day to appeal for` (penObj (`penalty increased by a new notice given on` (Date 1 1 2026))) EQUALS JUST (Date 28 1 2026)
#ASSERT `the last day to appeal for` (penObj (`penalty reduced or no action, decision given on` (Date 5 2 2024))) EQUALS JUST (Date 3 3 2024)
#ASSERT `the last day to appeal for` (penObj (`penalty reduced or no action, decision given on` (Date 5 2 2025))) EQUALS JUST (Date 4 3 2025)
#ASSERT `the last day to appeal for` (penObj (`penalty reduced or no action, decision given on` (Date 2 2 2024))) EQUALS JUST (Date 29 2 2024)
#ASSERT `the last day to appeal for` (penObj (`penalty reduced or no action, decision given on` (Date 2 2 2025))) EQUALS JUST (Date 1 3 2025)
#ASSERT `the last day to appeal for` (penObj (`no decision, the period ended on` (Date 15 12 2025))) EQUALS JUST (Date 11 1 2026)
#ASSERT `the last day to appeal for` (penObj (`no decision, the period ended on` (Date 31 1 2024))) EQUALS JUST (Date 27 2 2024)
#ASSERT `the last day to appeal for` (penObj (`penalty increased by a new notice given on` (Date 3 2 2100))) EQUALS JUST (Date 2 3 2100)
#ASSERT `the last day to appeal for` (penObj (`penalty reduced or no action, decision given on` (Date 1 1 2026))) EQUALS JUST (Date 28 1 2026)

§ `Goal 3 — the offence`

-- O1-O3
#ASSERT `an offence under s 21 is committed in` (adult `no leave to enter or remain`) `with` (offK TRUE FALSE)
#ASSERT `an offence under s 21 is committed in` (adult `no leave to enter or remain`) `with` (offK FALSE TRUE)
#ASSERT NOT (`an offence under s 21 is committed in` (adult `no leave to enter or remain`) `with` (offK FALSE FALSE))
-- O4: not disqualified, employer believed it
#ASSERT NOT (`an offence under s 21 is committed in` (adult `leave permitting this employment`) `with` (offK TRUE TRUE))
-- O5-O7: body corporate; knowledge / cause of a responsible person is the input (s 22)
#ASSERT `an offence under s 21 is committed in` (adult `leave that has ceased to have effect`) `with` (offK TRUE FALSE)
#ASSERT `an offence under s 21 is committed in` (adult `leave that is invalid`) `with` (offK FALSE TRUE)
#ASSERT NOT (`an offence under s 21 is committed in` (adult `leave that is invalid`) `with` (offK FALSE FALSE))
-- O8, O9: bail
#ASSERT `an offence under s 21 is committed in` (adult `immigration bail with a restriction preventing this employment`) `with` (offK TRUE FALSE)
#ASSERT NOT (`an offence under s 21 is committed in` (adult `immigration bail without such a restriction`) `with` (offK TRUE FALSE))
-- O10: age 15
#ASSERT NOT (`an offence under s 21 is committed in` (emp (Date 2 3 2010) (Date 1 3 2026) TRUE `no leave to enter or remain`) `with` (offK TRUE FALSE))
-- O11: contract for services
#ASSERT NOT (`an offence under s 21 is committed in` (emp (Date 1 1 1990) (Date 1 3 2026) FALSE `no leave to enter or remain`) `with` (offK TRUE FALSE))
-- O12
#ASSERT NOT (`an offence under s 21 is committed in` (adult `not subject to immigration control`) `with` (offK TRUE TRUE))
-- O13
#ASSERT `an offence under s 21 is committed in` (adult `leave with a condition preventing this employment`) `with` (offK FALSE TRUE)

-- S1-S8: maximum sentences (months); indictment 5 years
#ASSERT `the maximum imprisonment on indictment, in months` EQUALS 60
#ASSERT `the maximum imprisonment on summary conviction, in months, for` (offS `England and Wales` (Date 1 5 2022) 12) EQUALS 6
#ASSERT `the maximum imprisonment on summary conviction, in months, for` (offS `England and Wales` (Date 2 5 2022) 12) EQUALS 12
#ASSERT `the maximum imprisonment on summary conviction, in months, for` (offS `England and Wales` (Date 1 1 2026) 12) EQUALS 12
#ASSERT `the maximum imprisonment on summary conviction, in months, for` (offS `England and Wales` (Date 1 1 2026) 6) EQUALS 6
#ASSERT `the maximum imprisonment on summary conviction, in months, for` (offS `Scotland` (Date 1 1 2026) 12) EQUALS 6
#ASSERT `the maximum imprisonment on summary conviction, in months, for` (offS `Northern Ireland` (Date 1 1 2026) 12) EQUALS 6
#ASSERT `the maximum imprisonment on summary conviction, in months, for` (offS `Scotland` (Date 1 5 2022) 12) EQUALS 6
#ASSERT `the maximum imprisonment on summary conviction, in months, for` (offS `England and Wales` (Date 30 4 2022) 12) EQUALS 6

§ `Top-level goal`

GIVEN c IS AN `Illegal working case`
GIVETH AN `Illegal working position`
pos c MEANS `the illegal working position for` c

-- whole case: no leave, penalty given 1 Jan 2026 no objection; offence knowing, E&W 2026
caseA MEANS pos (`Illegal working case` OF (adult `no leave to enter or remain`), (JUST (penGiven (Date 1 1 2026))), (JUST (offK TRUE FALSE)))
#ASSERT caseA's `contrary to s 15`
#ASSERT caseA's `penalty payable` EQUALS JUST 20000
#ASSERT caseA's `earliest pay-by date` EQUALS JUST (Date 29 1 2026)
#ASSERT caseA's `last day to appeal` EQUALS NOTHING
#ASSERT caseA's `offence committed` EQUALS JUST TRUE
#ASSERT caseA's `maximum imprisonment on indictment, in months` EQUALS JUST 60
#ASSERT caseA's `maximum imprisonment on summary conviction, in months` EQUALS JUST 12
