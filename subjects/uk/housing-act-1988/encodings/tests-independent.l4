IMPORT prelude
IMPORT daydate
IMPORT `ha88-types`
IMPORT `ha88-possession`
IMPORT `ha88-damages`
IMPORT `ha88-goal`

-- Independent tests: expected values decided from the Act and BRIEF.md
-- before the encoding was read. See independent-expectations.md.
-- A failing assertion is a finding; expected values are never changed to
-- match the code.

§ `Helpers`

GIVETH A `Ground kind`
g7A MEANS `Ground 7A`
GIVETH A `Ground kind`
g14 MEANS `Ground 14`
GIVETH A `Ground kind`
g4A MEANS `a ground listed in s 8(4A)`
GIVETH A `Ground kind`
gOther MEANS `another ground`

-- s 8 notice, pre-2025: service, grounds, periodic, notice-to-quit date.
GIVEN p1 IS A DATE
      p2 IS A LIST OF `Ground kind`
      p3 IS A BOOLEAN
      p4 IS A DATE
GIVETH A `Section 8 notice`
mk8 p1 p2 p3 p4 MEANS
    `Section 8 notice` OF `before the Renters' Rights Act 2025`, p1, p2, p3, p4, p1, NOTHING, p1

-- Ground 7A notice: service, condition, trigger date.
GIVEN p1 IS A DATE, p2 IS A `Ground 7A condition`, p3 IS A DATE
GIVETH A `Section 8 notice`
mk7 p1 p2 p3 MEANS
    `Section 8 notice` OF `before the Renters' Rights Act 2025`, p1, (LIST `Ground 7A`), FALSE, p1, p1, (JUST p2), p3

GIVETH A `Ground 7A condition`
cConv MEANS `condition 1, 3 or 5 (conviction)`
GIVETH A `Ground 7A condition`
cFind MEANS `condition 2 (court finding)`
GIVETH A `Ground 7A condition`
cClos MEANS `condition 4 (closure order)`

-- s 21 notice: began (or original began), periodic, given, specified, NTQ date, s 5(2).
GIVEN p1 IS A DATE, p2 IS A BOOLEAN, p3 IS A DATE, p4 IS A DATE, p5 IS A DATE, p6 IS A BOOLEAN
GIVETH A `Section 21 notice`
mk21 p1 p2 p3 p4 p5 p6 MEANS
    `Section 21 notice` OF p1, p2, p3, p4, p5, p6

-- eviction: date, deprived, attempted/harassed-and-gave-up, reinstated,
-- belief defence, grounds defence, value with right, value without, reduction.
GIVEN p1 IS A DATE, p2 IS A BOOLEAN, p3 IS A BOOLEAN, p4 IS A BOOLEAN, p5 IS A BOOLEAN, p6 IS A BOOLEAN, p7 IS A NUMBER, p8 IS A NUMBER, p9 IS A NUMBER
GIVETH AN `Eviction facts`
mkE p1 p2 p3 p4 p5 p6 p7 p8 p9 MEANS
    `Eviction facts` OF p1, p2, p3, p4, p5, p6, p7, p8, p9

GIVEN p1 IS A `Section 8 notice`
GIVETH A DATE
early p1 MEANS `the earliest date for proceedings under` p1

GIVEN p1 IS A `Section 8 notice`
GIVETH A DATE
late p1 MEANS `the latest date for proceedings under` p1

GIVEN p1 IS A `Section 8 notice`
GIVETH A BOOLEAN
inTime p1 MEANS `a Ground 7A notice was served in time under` p1

GIVEN p1 IS A `Section 21 notice`
GIVETH A BOOLEAN
notEarly p1 MEANS `the s 21 notice was not given too early under` p1

GIVEN p1 IS A `Section 21 notice`
GIVETH A BOOLEAN
enough p1 MEANS `the s 21 notice gives enough notice under` p1

GIVEN p1 IS A `Section 21 notice`
GIVETH A BOOLEAN
valid21 p1 MEANS `the s 21 notice is valid as to timing` p1

GIVEN p1 IS A `Section 21 notice`
GIVETH A DATE
last21 p1 MEANS `the last day for s 21 proceedings under` p1

GIVEN p1 IS AN `Eviction facts`
GIVETH A BOOLEAN
liable p1 MEANS `the landlord is liable under s 27 for` p1

GIVEN p1 IS AN `Eviction facts`
GIVETH A NUMBER
damages p1 MEANS `the statutory damages for` p1

-- a periodic tenancy where the NTQ date is irrelevant
GIVETH A DATE
dummy MEANS Date 1 1 2000

§ `A — s 8 earliest date (pre-2025)`

-- A1 (3A)(b) fixed: one month after service
#ASSERT early (mk8 (Date 15 3 2025) (LIST g7A) FALSE dummy) EQUALS Date 15 4 2025
-- A2 month end
#ASSERT early (mk8 (Date 31 1 2025) (LIST g7A) FALSE dummy) EQUALS Date 28 2 2025
-- A3 leap year
#ASSERT early (mk8 (Date 31 1 2024) (LIST g7A) FALSE dummy) EQUALS Date 29 2 2024
-- A4 (3A)(a) periodic: NTQ date
#ASSERT early (mk8 (Date 10 3 2025) (LIST g7A) TRUE (Date 9 4 2025)) EQUALS Date 9 4 2025
-- A5 7A with a (4A) ground: (3A) only
#ASSERT early (mk8 (Date 10 3 2025) (LIST g7A, g4A) TRUE (Date 9 4 2025)) EQUALS Date 9 4 2025
#ASSERT early (mk8 (Date 10 3 2025) (LIST g4A, g7A) TRUE (Date 9 4 2025)) EQUALS Date 9 4 2025
-- A6 7A with 14, fixed
#ASSERT early (mk8 (Date 10 3 2025) (LIST g14, g7A) FALSE dummy) EQUALS Date 10 4 2025
-- A7 7A with 8, fixed
#ASSERT early (mk8 (Date 30 11 2025) (LIST g7A, gOther) FALSE dummy) EQUALS Date 30 12 2025
-- A8 Ground 14: date of service
#ASSERT early (mk8 (Date 10 3 2025) (LIST g14) FALSE dummy) EQUALS Date 10 3 2025
-- A9 14 with 1, periodic with late NTQ: still date of service
#ASSERT early (mk8 (Date 10 3 2025) (LIST g4A, g14) TRUE (Date 30 6 2025)) EQUALS Date 10 3 2025
-- A10 14 with 8
#ASSERT early (mk8 (Date 10 3 2025) (LIST gOther, g14) FALSE dummy) EQUALS Date 10 3 2025
-- A11 (4A)(a) fixed
#ASSERT early (mk8 (Date 10 3 2025) (LIST g4A) FALSE dummy) EQUALS Date 10 5 2025
-- A12 (4A) periodic, NTQ earlier than two months
#ASSERT early (mk8 (Date 10 3 2025) (LIST g4A) TRUE (Date 9 4 2025)) EQUALS Date 10 5 2025
-- A13 (4A) periodic, NTQ later than two months
#ASSERT early (mk8 (Date 10 3 2025) (LIST g4A) TRUE (Date 30 6 2025)) EQUALS Date 30 6 2025
-- A14 equal
#ASSERT early (mk8 (Date 10 3 2025) (LIST g4A) TRUE (Date 10 5 2025)) EQUALS Date 10 5 2025
-- A15 month end
#ASSERT early (mk8 (Date 31 12 2025) (LIST g4A) FALSE dummy) EQUALS Date 28 2 2026
-- A16 leap year
#ASSERT early (mk8 (Date 31 12 2023) (LIST g4A) FALSE dummy) EQUALS Date 29 2 2024
-- A17
#ASSERT early (mk8 (Date 30 11 2023) (LIST g4A) FALSE dummy) EQUALS Date 30 1 2024
-- A18 (4A) ground with another ground
#ASSERT early (mk8 (Date 10 3 2025) (LIST gOther, g4A) FALSE dummy) EQUALS Date 10 5 2025
-- A19 (4B) two weeks
#ASSERT early (mk8 (Date 10 3 2025) (LIST gOther) FALSE dummy) EQUALS Date 24 3 2025
-- A20 (4B) periodic, NTQ irrelevant, leap February
#ASSERT early (mk8 (Date 20 2 2024) (LIST gOther, gOther, gOther) TRUE (Date 20 3 2024)) EQUALS Date 5 3 2024
-- A21 across year end
#ASSERT early (mk8 (Date 25 12 2025) (LIST gOther) FALSE dummy) EQUALS Date 8 1 2026
-- A23
#ASSERT early (mk8 (Date 31 8 2025) (LIST g4A) FALSE dummy) EQUALS Date 31 10 2025

§ `B — s 8 latest date`

#ASSERT late (mk8 (Date 15 3 2025) (LIST gOther) FALSE dummy) EQUALS Date 15 3 2026
#ASSERT late (mk8 (Date 29 2 2024) (LIST gOther) FALSE dummy) EQUALS Date 28 2 2025
#ASSERT late (mk8 (Date 31 12 2025) (LIST gOther) FALSE dummy) EQUALS Date 31 12 2026
#ASSERT late (mk8 (Date 28 2 2023) (LIST gOther) FALSE dummy) EQUALS Date 28 2 2024

§ `C — Ground 7A service windows`

-- C1-C4 conviction 10 Mar 2025
#ASSERT inTime (mk7 (Date 9 3 2026) cConv (Date 10 3 2025))
#ASSERT NOT (inTime (mk7 (Date 10 3 2026) cConv (Date 10 3 2025)))
#ASSERT inTime (mk7 (Date 10 3 2025) cConv (Date 10 3 2025))
-- C4 served the day before conviction: not "within the period beginning with" it
#ASSERT NOT (inTime (mk7 (Date 9 3 2025) cConv (Date 10 3 2025)))
-- C5-C6 conviction 29 Feb 2024
#ASSERT inTime (mk7 (Date 28 2 2025) cConv (Date 29 2 2024))
#ASSERT NOT (inTime (mk7 (Date 1 3 2025) cConv (Date 29 2 2024)))
-- C7-C8 conviction 28 Feb 2023
#ASSERT inTime (mk7 (Date 27 2 2024) cConv (Date 28 2 2023))
#ASSERT NOT (inTime (mk7 (Date 28 2 2024) cConv (Date 28 2 2023)))
-- C9-C10 appeal finally determined 1 Jun 2025
#ASSERT inTime (mk7 (Date 31 5 2026) cConv (Date 1 6 2025))
#ASSERT NOT (inTime (mk7 (Date 1 6 2026) cConv (Date 1 6 2025)))
-- C11-C12 finding 1 Jun 2025
#ASSERT inTime (mk7 (Date 31 5 2026) cFind (Date 1 6 2025))
#ASSERT NOT (inTime (mk7 (Date 1 6 2026) cFind (Date 1 6 2025)))
-- C13 appeal withdrawn 15 Jan 2025
#ASSERT inTime (mk7 (Date 14 1 2026) cFind (Date 15 1 2025))
-- C14-C15 closure order 1 Jun 2025
#ASSERT inTime (mk7 (Date 31 8 2025) cClos (Date 1 6 2025))
#ASSERT NOT (inTime (mk7 (Date 1 9 2025) cClos (Date 1 6 2025)))
-- C16-C17 closure order 30 Nov 2025
#ASSERT inTime (mk7 (Date 28 2 2026) cClos (Date 30 11 2025))
#ASSERT NOT (inTime (mk7 (Date 1 3 2026) cClos (Date 30 11 2025)))
-- C18-C19 closure appeal 10 Apr 2025
#ASSERT inTime (mk7 (Date 9 7 2025) cClos (Date 10 4 2025))
#ASSERT NOT (inTime (mk7 (Date 10 7 2025) cClos (Date 10 4 2025)))
-- C20 closure order served before the order was made
#ASSERT NOT (inTime (mk7 (Date 31 5 2025) cClos (Date 1 6 2025)))

§ `D — s 21 (England)`

-- D1 four-month bar
#ASSERT NOT (notEarly (mk21 (Date 1 1 2025) FALSE (Date 30 4 2025) (Date 30 6 2025) dummy FALSE))
#ASSERT notEarly (mk21 (Date 1 1 2025) FALSE (Date 1 5 2025) (Date 1 7 2025) dummy FALSE)
#ASSERT NOT (notEarly (mk21 (Date 31 10 2024) FALSE (Date 28 2 2025) (Date 28 4 2025) dummy FALSE))
#ASSERT notEarly (mk21 (Date 31 10 2024) FALSE (Date 1 3 2025) (Date 1 5 2025) dummy FALSE)
-- D1e replacement tenancy: original began 1 Jan 2025
#ASSERT notEarly (mk21 (Date 1 1 2025) FALSE (Date 1 7 2025) (Date 1 9 2025) dummy FALSE)
-- D1f replacement: original began 1 Mar 2025
#ASSERT NOT (notEarly (mk21 (Date 1 3 2025) FALSE (Date 30 6 2025) (Date 31 8 2025) dummy FALSE))
-- D1g s 5(2)
#ASSERT notEarly (mk21 (Date 1 1 2025) TRUE (Date 15 1 2025) (Date 15 3 2025) (Date 15 2 2025) TRUE)
-- D1h
#ASSERT NOT (notEarly (mk21 (Date 1 1 2025) TRUE (Date 15 1 2025) (Date 15 3 2025) (Date 15 2 2025) FALSE))

-- D2 notice length
#ASSERT enough (mk21 (Date 1 1 2024) FALSE (Date 15 1 2025) (Date 15 3 2025) dummy FALSE)
#ASSERT NOT (enough (mk21 (Date 1 1 2024) FALSE (Date 15 1 2025) (Date 14 3 2025) dummy FALSE))
#ASSERT enough (mk21 (Date 1 1 2024) TRUE (Date 31 12 2024) (Date 28 2 2025) (Date 28 2 2025) FALSE)
#ASSERT NOT (enough (mk21 (Date 1 1 2024) TRUE (Date 31 12 2024) (Date 27 2 2025) (Date 27 2 2025) FALSE))
#ASSERT NOT (enough (mk21 (Date 1 1 2024) TRUE (Date 15 1 2025) (Date 15 3 2025) (Date 30 4 2025) FALSE))
#ASSERT enough (mk21 (Date 1 1 2024) TRUE (Date 15 1 2025) (Date 30 4 2025) (Date 30 4 2025) FALSE)
-- combined validity
#ASSERT valid21 (mk21 (Date 1 1 2024) TRUE (Date 15 1 2025) (Date 30 4 2025) (Date 30 4 2025) FALSE)
#ASSERT NOT (valid21 (mk21 (Date 1 1 2025) FALSE (Date 30 4 2025) (Date 30 6 2025) dummy FALSE))

-- D3 last day for proceedings
#ASSERT last21 (mk21 (Date 1 1 2024) FALSE (Date 15 1 2025) (Date 15 3 2025) dummy FALSE) EQUALS Date 14 7 2025
#ASSERT last21 (mk21 (Date 1 1 2024) TRUE (Date 15 1 2025) (Date 15 3 2025) (Date 15 3 2025) FALSE) EQUALS Date 14 7 2025
#ASSERT last21 (mk21 (Date 1 1 2024) TRUE (Date 15 1 2025) (Date 30 4 2025) (Date 30 4 2025) FALSE) EQUALS Date 29 8 2025
#ASSERT last21 (mk21 (Date 1 1 2024) TRUE (Date 31 1 2025) (Date 31 5 2025) (Date 31 5 2025) FALSE) EQUALS Date 30 9 2025
#ASSERT last21 (mk21 (Date 1 1 2024) FALSE (Date 31 8 2025) (Date 31 10 2025) dummy FALSE) EQUALS Date 28 2 2026
#ASSERT last21 (mk21 (Date 1 1 2024) FALSE (Date 1 3 2025) (Date 1 5 2025) dummy FALSE) EQUALS Date 31 8 2025

§ `E — ss 27-28`

-- E1 deprivation, values 210,000 (with right) / 250,000 (without)
#ASSERT liable (mkE (Date 1 5 2024) TRUE FALSE FALSE FALSE FALSE 210000 250000 0)
#ASSERT damages (mkE (Date 1 5 2024) TRUE FALSE FALSE FALSE FALSE 210000 250000 0) EQUALS 40000
-- E2 / E3 the 9 June 1988 edge
#ASSERT NOT (liable (mkE (Date 9 6 1988) TRUE FALSE FALSE FALSE FALSE 210000 250000 0))
#ASSERT liable (mkE (Date 10 6 1988) TRUE FALSE FALSE FALSE FALSE 210000 250000 0)
-- E4/E5 reinstatement (6)(a) or (b)
#ASSERT NOT (liable (mkE (Date 1 5 2024) TRUE FALSE TRUE FALSE FALSE 210000 250000 0))
#ASSERT damages (mkE (Date 1 5 2024) TRUE FALSE TRUE FALSE FALSE 210000 250000 0) EQUALS 0
-- E6 belief the occupier had ceased to reside (8)(a)
#ASSERT NOT (liable (mkE (Date 1 5 2024) TRUE FALSE FALSE TRUE FALSE 210000 250000 0))
-- E7 deprivation: (8)(b) not available
#ASSERT liable (mkE (Date 1 5 2024) TRUE FALSE FALSE FALSE TRUE 210000 250000 0)
-- E8 harassment only: (8)(b) available
#ASSERT NOT (liable (mkE (Date 1 5 2024) FALSE TRUE FALSE FALSE TRUE 210000 250000 0))
-- E9/E12/E14 harassment, attempt or withholding services, occupier gave up
#ASSERT liable (mkE (Date 1 5 2024) FALSE TRUE FALSE FALSE FALSE 210000 250000 0)
#ASSERT damages (mkE (Date 1 5 2024) FALSE TRUE FALSE FALSE FALSE 210000 250000 0) EQUALS 40000
-- E10/E11/E13 no deprivation, occupier did not give up as a result
#ASSERT NOT (liable (mkE (Date 1 5 2024) FALSE FALSE FALSE FALSE FALSE 210000 250000 0))
-- both deprivation and harassment: (8)(b) not "by virtue only of" acts
#ASSERT liable (mkE (Date 1 5 2024) TRUE TRUE FALSE FALSE TRUE 210000 250000 0)
-- E15 s 27(7) reduction of 10,000
#ASSERT damages (mkE (Date 1 5 2024) TRUE FALSE FALSE FALSE FALSE 210000 250000 10000) EQUALS 30000
-- harassment on 9 June 1988 is also outside
#ASSERT NOT (liable (mkE (Date 9 6 1988) FALSE TRUE FALSE FALSE FALSE 210000 250000 0))

§ `F — top-level goal`

GIVEN p1 IS A `Section 8 version`
GIVETH A `Possession position`
pos8 p1 MEANS
    `the possession position for` (`Possession case` OF (JUST (`Section 8 notice` OF p1, (Date 10 3 2025), (LIST g4A), FALSE, dummy, (Date 10 5 2025), NOTHING, (Date 10 3 2025))), NOTHING, NOTHING)

GIVETH A `Possession position`
amended MEANS pos8 `as amended by the Renters' Rights Act 2025`

GIVETH A `Possession position`
before MEANS pos8 `before the Renters' Rights Act 2025`

-- F1 amended version: NOTHING
#ASSERT amended's `earliest date for s 8 proceedings` EQUALS NOTHING
-- F2 pre-2025 version
#ASSERT before's `earliest date for s 8 proceedings` EQUALS JUST (Date 10 5 2025)
#ASSERT before's `latest date for s 8 proceedings` EQUALS JUST (Date 10 3 2026)
#ASSERT before's `s 21 notice valid as to timing` EQUALS NOTHING
#ASSERT before's `statutory damages` EQUALS NOTHING

GIVETH A `Possession position`
posAll MEANS
    `the possession position for` (`Possession case` OF NOTHING, (JUST (mk21 (Date 1 1 2024) TRUE (Date 15 1 2025) (Date 30 4 2025) (Date 30 4 2025) FALSE)), (JUST (mkE (Date 1 5 2024) TRUE FALSE FALSE FALSE FALSE 210000 250000 10000)))

#ASSERT posAll's `s 21 notice valid as to timing` EQUALS JUST TRUE
#ASSERT posAll's `last day for s 21 proceedings` EQUALS JUST (Date 29 8 2025)
#ASSERT posAll's `landlord liable for unlawful eviction` EQUALS JUST TRUE
#ASSERT posAll's `statutory damages` EQUALS JUST 30000
#ASSERT posAll's `earliest date for s 8 proceedings` EQUALS NOTHING
