IMPORT prelude
IMPORT daydate

-- Housing Act 1988 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-1988-50.txt (point in time
-- 29 June 2026).

§ `Nouns`

-- s 8(3)(b): the two versions printed together.
DECLARE `Section 8 version` IS ONE OF
    `before the Renters' Rights Act 2025`
    `as amended by the Renters' Rights Act 2025`

-- Schedule 2 grounds, so far as s 8's notice periods turn on them.
DECLARE `Ground kind` IS ONE OF
    `Ground 7A`
    `Ground 14`
    -- s 8(4A): Grounds 1, 2, 5 to 7, 9 and 16.
    `a ground listed in s 8(4A)`
    `another ground`

-- s 8(4D)-(4F): the Ground 7A condition relied on.
DECLARE `Ground 7A condition` IS ONE OF
    `condition 1, 3 or 5 (conviction)`
    `condition 2 (court finding)`
    `condition 4 (closure order)`

DECLARE `Section 8 notice` HAS
    `version`                                           IS A `Section 8 version`
    `served on`                                         IS A DATE
    `grounds`                                           IS A LIST OF `Ground kind`
    `periodic tenancy`                                  IS A BOOLEAN
    -- s 8(3A)(a), (4A)(b): the earliest date a landlord's notice to quit
    -- served the same day could end a periodic tenancy (apart from s 5(1)).
    `notice to quit could end the tenancy on`           IS A DATE
    `date specified for proceedings`                    IS A DATE
    -- s 8(4C)-(4F): for Ground 7A, the condition and the day of the
    -- conviction, finding or order (or the day any appeal was finally
    -- determined, abandoned or withdrawn).
    `Ground 7A condition`                               IS A MAYBE `Ground 7A condition`
    `Ground 7A trigger date`                            IS A DATE

DECLARE `Section 21 notice` HAS
    -- s 21(4B), (6)-(7): the day the tenancy began, or, for a replacement
    -- tenancy, the day the original tenancy began.
    `tenancy (or original tenancy) began on`            IS A DATE
    `periodic tenancy`                                  IS A BOOLEAN
    `given on`                                          IS A DATE
    `date specified`                                    IS A DATE
    -- s 21(4)(b): the earliest date a landlord's notice to quit given the
    -- same day could end the tenancy.
    `notice to quit could end the tenancy on`           IS A DATE
    -- s 21(4C): the tenancy arose under s 5(2).
    `arose under s 5(2)`                                IS A BOOLEAN

DECLARE `Eviction facts` HAS
    -- s 27(1)-(2): after 9 June 1988, the landlord (or someone on their
    -- behalf) unlawfully deprived the residential occupier of occupation, or
    -- attempted to or harassed them so that they gave up occupation.
    `occurred on`                                       IS A DATE
    `unlawfully deprived of occupation`                 IS A BOOLEAN
    `attempted or harassed, and the occupier gave up occupation as a result` IS A BOOLEAN
    -- s 27(6)
    `reinstated`                                        IS A BOOLEAN
    -- s 27(8)
    `defendant proves a reasonable belief the occupier had left` IS A BOOLEAN
    `defendant proves reasonable grounds for the acts`  IS A BOOLEAN
    -- s 28(1)
    `value with the occupier's right`                   IS A NUMBER
    `value without it`                                  IS A NUMBER
    -- s 27(7): the reduction the court thinks appropriate.
    `court's reduction`                                 IS A NUMBER
