IMPORT prelude
IMPORT daydate
IMPORT `uc-core`

-- Tests for uc-core.l4. Expected values are worked out by hand from the text or from the calendar, not read from output.

-- YMD is year, month, day; Date is day, month, year.
#ASSERT YMD 2026 1 2 EQUALS Date 2 1 2026
#ASSERT YMD 2026 3 1 AT LEAST YMD 2026 2 28

-- The percent literal: 55% is 0.55.
#ASSERT 55% EQUALS 0.55
#ASSERT 100 TIMES 63% EQUALS 63

-- An assessment period is a month; its last day is inside it. January has 31 days; February 2026 has 28; February 2028 has 29.
`January 2026` MEANS `Assessment period` WITH `first day` IS YMD 2026 1 1, `last day` IS YMD 2026 1 31
`February 2026` MEANS `Assessment period` WITH `first day` IS YMD 2026 2 1, `last day` IS YMD 2026 2 28
`February 2028` MEANS `Assessment period` WITH `first day` IS YMD 2028 2 1, `last day` IS YMD 2028 2 29
`one day` MEANS `Assessment period` WITH `first day` IS YMD 2026 5 5, `last day` IS YMD 2026 5 5
#ASSERT `core — the number of days in an assessment period` `January 2026` EQUALS 31
#ASSERT `core — the number of days in an assessment period` `February 2026` EQUALS 28
#ASSERT `core — the number of days in an assessment period` `February 2028` EQUALS 29
#ASSERT `core — the number of days in an assessment period` `one day` EQUALS 1

-- A time limit added to a date. 30 days from 1 January is 31 January; 2 weeks from 1 January is 15 January.
-- 6 months from 31 August 2025 is 28 February 2026 (the day of the month moves back to the last day of a shorter month).
-- 1 year from 29 February 2024 is 28 February 2025. 1 month from 31 January 2027 is 28 February 2027.
#ASSERT `core — the date reached by adding a time limit to a date` (YMD 2026 1 1) (`Time limit` WITH quantity IS 30, unit IS days) EQUALS YMD 2026 1 31
#ASSERT `core — the date reached by adding a time limit to a date` (YMD 2026 1 1) (`Time limit` WITH quantity IS 2, unit IS weeks) EQUALS YMD 2026 1 15
#ASSERT `core — the date reached by adding a time limit to a date` (YMD 2025 8 31) (`Time limit` WITH quantity IS 6, unit IS months) EQUALS YMD 2026 2 28
#ASSERT `core — the date reached by adding a time limit to a date` (YMD 2024 2 29) (`Time limit` WITH quantity IS 1, unit IS years) EQUALS YMD 2025 2 28
#ASSERT `core — the date reached by adding a time limit to a date` (YMD 2027 1 31) (`Time limit` WITH quantity IS 1, unit IS months) EQUALS YMD 2027 2 28

-- The monthly equivalent (regulation 73(2) and the two schedules): weekly times 52 over 12; two-weekly times 26 over 12;
-- four-weekly times 13 over 12; three-monthly times 4 over 12; annual over 12; monthly unchanged.
-- 100 a week is 5200 / 12 = 433.333...; 100 every two weeks is 2600 / 12 = 216.666...; 100 every four weeks is 1300 / 12 = 108.333...
#ASSERT `core — an amount rounded to the nearest penny` (`core — the monthly equivalent of a payment` 100 `weekly payments`) EQUALS 433.33
#ASSERT `core — an amount rounded to the nearest penny` (`core — the monthly equivalent of a payment` 100 `two-weekly payments`) EQUALS 216.67
#ASSERT `core — an amount rounded to the nearest penny` (`core — the monthly equivalent of a payment` 100 `four-weekly payments`) EQUALS 108.33
#ASSERT `core — the monthly equivalent of a payment` 300 `three-monthly payments` EQUALS 100
#ASSERT `core — the monthly equivalent of a payment` 1200 `annual payments` EQUALS 100
#ASSERT `core — the monthly equivalent of a payment` 77.5 `monthly payments` EQUALS 77.5
#ASSERT `core — the monthly equivalent of a payment` 12 `weekly payments` EQUALS 52

-- Rounding to the penny (regulation 6(1)): a fraction of a penny is disregarded if less than half a penny and otherwise is treated as a penny.
#ASSERT `core — an amount rounded to the nearest penny` 1.004 EQUALS 1
#ASSERT `core — an amount rounded to the nearest penny` 1.0049 EQUALS 1
#ASSERT `core — an amount rounded to the nearest penny` 1.005 EQUALS 1.01
#ASSERT `core — an amount rounded to the nearest penny` 1.0051 EQUALS 1.01
#ASSERT `core — an amount rounded to the nearest penny` 0.005 EQUALS 0.01
#ASSERT `core — an amount rounded to the nearest penny` 0 EQUALS 0
#ASSERT `core — an amount rounded to the nearest penny` 338.58 EQUALS 338.58
-- A negative amount is rounded on its size and keeps its sign (assumed, not ruled: fork F1).
#ASSERT `core — an amount rounded to the nearest penny` (0 MINUS 1.005) EQUALS (0 MINUS 1.01)
#ASSERT `core — an amount rounded to the nearest penny` (0 MINUS 1.004) EQUALS (0 MINUS 1)

-- A fraction of a pound disregarded (regulation 6(1A)): 12.99 pounds is 12 pounds, not 13.
#ASSERT `core — an amount with any fraction of a pound disregarded` 12.99 EQUALS 12
#ASSERT `core — an amount with any fraction of a pound disregarded` 12 EQUALS 12
#ASSERT `core — an amount with any fraction of a pound disregarded` 0.99 EQUALS 0
