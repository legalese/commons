#ASSERT `reg 39(4) and (5) — the points counted for Sch 6 activity 1` `fixture: 1(a), bodily cause` EQUALS 15
-- Without a cause, a descriptor counts for nothing (regulation 39(4) makes the cause a condition).
#ASSERT `reg 39(4) and (5) — the points counted for Sch 6 activity 1` `fixture: 1(a), no cause` EQUALS 0
-- A mental cause does not satisfy the condition for a Part 1 descriptor.
#ASSERT `reg 39(4) and (5) — the points counted for Sch 6 activity 1` `fixture: 1(a), mental cause only` EQUALS 0
#ASSERT `reg 39(4) and (5) — the points counted for Sch 6 activity 1` `fixture: 1(a), treatment for a physical disease` EQUALS 15
-- Highest only: 9, not 9 plus 6.
#ASSERT `reg 39(4) and (5) — the points counted for Sch 6 activity 1` `fixture: 1(c) and 1(d), bodily cause` EQUALS 9
#ASSERT `reg 39(4) and (5) — the points counted for Sch 6 activity 11` `fixture: 11(a), mental cause` EQUALS 15
#ASSERT `reg 39(4) and (5) — the points counted for Sch 6 activity 11` `fixture: 11(a), bodily cause only` EQUALS 0
#ASSERT `reg 39(4) and (5) — the points counted for Sch 6 activity 11` `fixture: 11(a), treatment for a mental illness` EQUALS 15
#ASSERT `reg 39(4) and (5) — the points counted for Sch 6 activity 1` `fixture: 1(e), none of the above` EQUALS 0

-- Part 1 scores: 1(a) alone is 15; 1(b) 9 plus 2(c) 6 is 15; 2(c) 6 plus 3(c) 6 is 12; 1(c) with 1(d) is 9.
#ASSERT `reg 39(3) — the points scored in Part 1 of Schedule 6` `fixture: 1(a), bodily cause` EQUALS 15
#ASSERT `reg 39(3) — the points scored in Part 1 of Schedule 6` `fixture: 1(b) and 2(c)` EQUALS 15
#ASSERT `reg 39(3) — the points scored in Part 1 of Schedule 6` `fixture: 2(c) and 3(c)` EQUALS 12
#ASSERT `reg 39(3) — the points scored in Part 1 of Schedule 6` `fixture: 1(c) and 1(d), bodily cause` EQUALS 9
#ASSERT `reg 39(3) — the points scored in Part 1 of Schedule 6` `fixture: nothing applies` EQUALS 0
-- Part 2 scores: 11(c) 6 plus 12(b) 9 is 15; 11(a) alone is 15.
#ASSERT `reg 39(3) — the points scored in Part 2 of Schedule 6` `fixture: 11(c) and 12(b)` EQUALS 15
#ASSERT `reg 39(3) — the points scored in Part 2 of Schedule 6` `fixture: 11(a), mental cause` EQUALS 15
#ASSERT `reg 39(3) — the points scored in Part 2 of Schedule 6` `fixture: nothing applies` EQUALS 0
-- The two Parts are scored apart: 3(b) is 9 in Part 1 and 11(c) is 6 in Part 2.
#ASSERT `reg 39(3) — the points scored in Part 1 of Schedule 6` `fixture: 3(b) and 11(c)` EQUALS 9
#ASSERT `reg 39(3) — the points scored in Part 2 of Schedule 6` `fixture: 3(b) and 11(c)` EQUALS 6
-- Each Part has its own cause condition: 1(a) with only a mental cause scores nothing in Part 1; 11(a) with only a bodily cause scores nothing in Part 2.
#ASSERT `reg 39(3) — the points scored in Part 1 of Schedule 6` `fixture: 1(a) with only a mental cause, 11(a) with only a bodily cause` EQUALS 0
#ASSERT `reg 39(3) — the points scored in Part 2 of Schedule 6` `fixture: 1(a) with only a mental cause, 11(a) with only a bodily cause` EQUALS 0
