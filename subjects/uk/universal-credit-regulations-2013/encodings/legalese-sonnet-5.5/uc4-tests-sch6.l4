-- ---------------------------------------------------------------------------------------------------------
-- Regulation 39(5): only the descriptor with the highest score for an activity is counted.
-- 1(c) scores 9 and 1(d) scores 6: counted 9, not 15.
#ASSERT `reg 39(5) — the highest points among the descriptors that apply for Sch 6 activity 1` (LIST `Sch 6 descriptor 1(c)`, `Sch 6 descriptor 1(d)`) EQUALS 9
-- 1(a) scores 15, "none of the above" 1(e) scores 0: counted 15, in either order.
#ASSERT `reg 39(5) — the highest points among the descriptors that apply for Sch 6 activity 1` (LIST `Sch 6 descriptor 1(a)`, `Sch 6 descriptor 1(e)`) EQUALS 15
#ASSERT `reg 39(5) — the highest points among the descriptors that apply for Sch 6 activity 1` (LIST `Sch 6 descriptor 1(e)`, `Sch 6 descriptor 1(a)`) EQUALS 15
-- No descriptor applies: nothing is counted.
#ASSERT `reg 39(5) — the highest points among the descriptors that apply for Sch 6 activity 1` EMPTY EQUALS 0
-- Activity 5: 5(b) scores 15 and 5(c) scores 9.
#ASSERT `reg 39(5) — the highest points among the descriptors that apply for Sch 6 activity 5` (LIST `Sch 6 descriptor 5(c)`, `Sch 6 descriptor 5(b)`) EQUALS 15
-- Activity 9 has three descriptors: 9(b) scores 6.
#ASSERT `reg 39(5) — the highest points among the descriptors that apply for Sch 6 activity 9` (LIST `Sch 6 descriptor 9(b)`) EQUALS 6
-- Activity 17 (Part 2), 17(c) scores 9 and 17(b) 15.
#ASSERT `reg 39(5) — the highest points among the descriptors that apply for Sch 6 activity 17` (LIST `Sch 6 descriptor 17(c)`, `Sch 6 descriptor 17(b)`) EQUALS 15

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 39(4): the cause of the incapability.
-- Part 1: a specific bodily disease or disablement, or a direct result of treatment for a specific physical disease or disablement.
#ASSERT `reg 39(4)(a) and (c)(i) — the incapability arises as paragraph (4) requires for a Part 1 descriptor` (LIST `a specific bodily disease or disablement`)
#ASSERT `reg 39(4)(a) and (c)(i) — the incapability arises as paragraph (4) requires for a Part 1 descriptor` (LIST `treatment by a registered medical practitioner for a specific physical disease or disablement`)
#ASSERT NOT (`reg 39(4)(a) and (c)(i) — the incapability arises as paragraph (4) requires for a Part 1 descriptor` (LIST `a specific mental illness or disablement`))
#ASSERT NOT (`reg 39(4)(a) and (c)(i) — the incapability arises as paragraph (4) requires for a Part 1 descriptor` (LIST `treatment by a registered medical practitioner for a specific mental illness or disablement`))
#ASSERT NOT (`reg 39(4)(a) and (c)(i) — the incapability arises as paragraph (4) requires for a Part 1 descriptor` EMPTY)
-- Part 2: a specific mental illness or disablement, or a direct result of treatment for a specific mental illness or disablement.
#ASSERT `reg 39(4)(b) and (c)(ii) — the incapability arises as paragraph (4) requires for a Part 2 descriptor` (LIST `a specific mental illness or disablement`)
#ASSERT `reg 39(4)(b) and (c)(ii) — the incapability arises as paragraph (4) requires for a Part 2 descriptor` (LIST `treatment by a registered medical practitioner for a specific mental illness or disablement`)
#ASSERT NOT (`reg 39(4)(b) and (c)(ii) — the incapability arises as paragraph (4) requires for a Part 2 descriptor` (LIST `a specific bodily disease or disablement`))
#ASSERT NOT (`reg 39(4)(b) and (c)(ii) — the incapability arises as paragraph (4) requires for a Part 2 descriptor` (LIST `treatment by a registered medical practitioner for a specific physical disease or disablement`))
-- Either of two causes is enough.
#ASSERT `reg 39(4)(a) and (c)(i) — the incapability arises as paragraph (4) requires for a Part 1 descriptor` (LIST `a specific mental illness or disablement`, `a specific bodily disease or disablement`)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 39(3), (4), (5) together: the points counted, activity by activity, and the score for each Part.
-- Fixtures are built by name; an activity not named has no descriptor, and its cause list is the Part's cause list.
