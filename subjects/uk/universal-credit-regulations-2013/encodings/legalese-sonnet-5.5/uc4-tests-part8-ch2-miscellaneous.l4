IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-persons`
IMPORT `uc4-part8-ch2-miscellaneous`

-- Tests of uc4-part8-ch2-miscellaneous.l4: regulations 112 to 114.
-- Expected values are written by hand from the text, beside the assertion.

-- Regulation 112.
#ASSERT `reg 112 — Schedule 11 has effect in relation to the person` TRUE TRUE
#ASSERT NOT (`reg 112 — Schedule 11 has effect in relation to the person` TRUE FALSE)
#ASSERT NOT (`reg 112 — Schedule 11 has effect in relation to the person` FALSE TRUE)

-- Regulation 113(1)(a).
#ASSERT `reg 113(1)(a) — no reduction: a vacancy because of a strike` TRUE TRUE
#ASSERT NOT (`reg 113(1)(a) — no reduction: a vacancy because of a strike` TRUE FALSE)
#ASSERT NOT (`reg 113(1)(a) — no reduction: a vacancy because of a strike` FALSE TRUE)

-- Regulation 113(1)(b): all of (i), (ii) and (iii), and the failure listed in section 26(2)(d).
#ASSERT `reg 113(1)(b) — no reduction: ceasing paid work or losing pay within a trial period` TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 113(1)(b) — no reduction: ceasing paid work or losing pay within a trial period` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 113(1)(b) — no reduction: ceasing paid work or losing pay within a trial period` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 113(1)(b) — no reduction: ceasing paid work or losing pay within a trial period` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`reg 113(1)(b) — no reduction: ceasing paid work or losing pay within a trial period` TRUE TRUE TRUE FALSE)

-- Regulation 113(1)(c) and (d).
#ASSERT `reg 113(1)(c) — no reduction: ceasing paid work or losing pay because of a strike` TRUE
#ASSERT NOT (`reg 113(1)(c) — no reduction: ceasing paid work or losing pay because of a strike` FALSE)
#ASSERT `reg 113(1)(d) — no reduction: ceasing paid work in the regular or reserve forces` TRUE
#ASSERT NOT (`reg 113(1)(d) — no reduction: ceasing paid work in the regular or reserve forces` FALSE)

-- Regulation 113(1)(e): the failure on 1 January 2026, a claim on 6 January 2026: the days from 2 to 6 January are 5.
#ASSERT `reg 113(1)(e) — no reduction: a pre-claim failure whose reduction is used up by the days before the claim` TRUE (JUST 5) (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 6)
#ASSERT NOT (`reg 113(1)(e) — no reduction: a pre-claim failure whose reduction is used up by the days before the claim` TRUE (JUST 6) (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 6))
#ASSERT `reg 113(1)(e) — no reduction: a pre-claim failure whose reduction is used up by the days before the claim` TRUE (JUST 4) (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 6)
-- A reduction period of nought or less (regulation 102(4)) is no longer than any number of days.
#ASSERT `reg 113(1)(e) — no reduction: a pre-claim failure whose reduction is used up by the days before the claim` TRUE (JUST (0 MINUS 59)) (YearMonthDay 2026 1 1) (YearMonthDay 2026 6 1)
#ASSERT `reg 113(1)(e) — no reduction: a pre-claim failure whose reduction is used up by the days before the claim` TRUE (JUST 0) (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 2)
-- No period from regulation 102(4): the comparison cannot be made.
#ASSERT NOT (`reg 113(1)(e) — no reduction: a pre-claim failure whose reduction is used up by the days before the claim` TRUE NOTHING (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 6))
#ASSERT NOT (`reg 113(1)(e) — no reduction: a pre-claim failure whose reduction is used up by the days before the claim` FALSE (JUST 5) (YearMonthDay 2026 1 1) (YearMonthDay 2026 1 6))

-- Regulation 113(1)(f): redundancy, voluntary redundancy or lay-off.
#ASSERT `reg 113(1)(f) — no reduction: ceasing paid work in a redundancy or lay-off` TRUE TRUE FALSE FALSE
#ASSERT `reg 113(1)(f) — no reduction: ceasing paid work in a redundancy or lay-off` TRUE FALSE TRUE FALSE
#ASSERT `reg 113(1)(f) — no reduction: ceasing paid work in a redundancy or lay-off` TRUE FALSE FALSE TRUE
#ASSERT NOT (`reg 113(1)(f) — no reduction: ceasing paid work in a redundancy or lay-off` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`reg 113(1)(f) — no reduction: ceasing paid work in a redundancy or lay-off` FALSE TRUE TRUE TRUE)

-- Regulation 113(1)(g): a single claimant at 10 pounds an hour: 18 hours is 780. Earnings of 780 have not fallen below it.
#ASSERT `reg 113(1)(g) — no reduction: earnings have not fallen below the amount in regulation 99(6)` TRUE `a single claimant` 780 10
#ASSERT NOT (`reg 113(1)(g) — no reduction: earnings have not fallen below the amount in regulation 99(6)` TRUE `a single claimant` 779.99 10)
-- A member of a couple: joint earnings against 29 hours, 29 x 10 x 52 / 12 = 1256.66..., truncated to 1256.
#ASSERT `reg 113(1)(g) — no reduction: earnings have not fallen below the amount in regulation 99(6)` TRUE `joint claimants` 1256 10
#ASSERT NOT (`reg 113(1)(g) — no reduction: earnings have not fallen below the amount in regulation 99(6)` TRUE `joint claimants` 1255.99 10)
#ASSERT `reg 113(1)(g) — no reduction: earnings have not fallen below the amount in regulation 99(6)` TRUE `a single claimant who is a member of a couple` 1300 10
-- The couple amount, not the 18-hour amount, applies to a member of a couple.
#ASSERT NOT (`reg 113(1)(g) — no reduction: earnings have not fallen below the amount in regulation 99(6)` TRUE `a single claimant who is a member of a couple` 800 10)
#ASSERT NOT (`reg 113(1)(g) — no reduction: earnings have not fallen below the amount in regulation 99(6)` FALSE `a single claimant` 2000 10)

-- Regulation 113(1): each case alone is enough.
#ASSERT `reg 113(1) — no reduction is made for the failure` TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 113(1) — no reduction is made for the failure` FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 113(1) — no reduction is made for the failure` FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `reg 113(1) — no reduction is made for the failure` FALSE FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `reg 113(1) — no reduction is made for the failure` FALSE FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `reg 113(1) — no reduction is made for the failure` FALSE FALSE FALSE FALSE FALSE TRUE FALSE
#ASSERT `reg 113(1) — no reduction is made for the failure` FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`reg 113(1) — no reduction is made for the failure` FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- Regulation 113(2) states no rule (coverage row: inert, a pure citation).
#ASSERT `reg 113(2) — "regular or reserve forces" has the meaning in section 374 of the Armed Forces Act 2006` EQUALS "In this regulation regular or reserve forces has the same meaning as in section 374 of the Armed Forces Act 2006."

-- Regulation 114(2): up to 30 hours a week over exactly 4 consecutive weeks.
#ASSERT `reg 114(2) — the Mandatory Work Activity Scheme` TRUE TRUE 30 4 TRUE
#ASSERT `reg 114(2) — the Mandatory Work Activity Scheme` TRUE TRUE 20 4 TRUE
#ASSERT NOT (`reg 114(2) — the Mandatory Work Activity Scheme` TRUE TRUE 31 4 TRUE)
#ASSERT NOT (`reg 114(2) — the Mandatory Work Activity Scheme` TRUE TRUE 30 3 TRUE)
#ASSERT NOT (`reg 114(2) — the Mandatory Work Activity Scheme` TRUE TRUE 30 5 TRUE)
#ASSERT NOT (`reg 114(2) — the Mandatory Work Activity Scheme` FALSE TRUE 30 4 TRUE)
#ASSERT NOT (`reg 114(2) — the Mandatory Work Activity Scheme` TRUE FALSE 30 4 TRUE)
#ASSERT NOT (`reg 114(2) — the Mandatory Work Activity Scheme` TRUE TRUE 30 4 FALSE)

-- Regulation 114(1).
#ASSERT `reg 114(1) — the placement is a prescribed placement for section 26(2)(a) of the Act` TRUE TRUE
#ASSERT NOT (`reg 114(1) — the placement is a prescribed placement for section 26(2)(a) of the Act` TRUE FALSE)
#ASSERT NOT (`reg 114(1) — the placement is a prescribed placement for section 26(2)(a) of the Act` FALSE TRUE)
