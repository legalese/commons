IMPORT prelude
IMPORT `uc-core`
IMPORT `uc1-common`
IMPORT `uc1-part3-awards`
IMPORT `uc1-part4-amounts`
IMPORT `uc1-part4-childcare`

-- Tests of uc1-part4-childcare.l4 (regulations 31 to 35) and of the helper `uc1 — the 1st September following a birthday`
-- of uc1-common.l4. Every expected value is written by hand from the text of the regulation named in the comment beside it, and
-- none was copied from the output of the rule.

-- ---------------------------------------------------------------------------------------------------------
-- The helper for regulations 5 and 33: the 1st September following a birthday (fork F-5-SEPT).
#ASSERT `uc1 — the 1st September following a birthday` (YMD 2009 8 31) 16 EQUALS YMD 2025 9 1
-- Born on 1 September: the 16th birthday is that day, and the 1st September following it is a year later.
#ASSERT `uc1 — the 1st September following a birthday` (YMD 2009 9 1) 16 EQUALS YMD 2026 9 1
#ASSERT `uc1 — the 1st September following a birthday` (YMD 2009 9 2) 16 EQUALS YMD 2026 9 1
#ASSERT `uc1 — the 1st September following a birthday` (YMD 2010 1 1) 16 EQUALS YMD 2026 9 1
#ASSERT `uc1 — the 1st September following a birthday` (YMD 2009 6 1) 19 EQUALS YMD 2028 9 1
#ASSERT `uc1 — the 1st September following a birthday` (YMD 2009 12 31) 19 EQUALS YMD 2029 9 1
#ASSERT `uc1 — the 1st September following a birthday` (YMD 2008 2 29) 16 EQUALS YMD 2024 9 1

-- ---------------------------------------------------------------------------------------------------------
-- The assessment periods, counted from 15 January 2025: period 0 is 15 January to 14 February, period 1 is 15 February to 14 March,
-- period 2 is 15 March to 14 April; period -1 is the month before the award, 15 December 2024 to 14 January 2025.
#ASSERT `uc1 — the position of the assessment period containing a day, counting months before the award` (YMD 2025 1 15) (YMD 2025 1 15) EQUALS 0
#ASSERT `uc1 — the position of the assessment period containing a day, counting months before the award` (YMD 2025 1 15) (YMD 2025 2 14) EQUALS 0
#ASSERT `uc1 — the position of the assessment period containing a day, counting months before the award` (YMD 2025 1 15) (YMD 2025 2 15) EQUALS 1
#ASSERT `uc1 — the position of the assessment period containing a day, counting months before the award` (YMD 2025 1 15) (YMD 2025 3 14) EQUALS 1
#ASSERT `uc1 — the position of the assessment period containing a day, counting months before the award` (YMD 2025 1 15) (YMD 2025 3 15) EQUALS 2
#ASSERT `uc1 — the position of the assessment period containing a day, counting months before the award` (YMD 2025 1 15) (YMD 2025 1 14) EQUALS (0 MINUS 1)
#ASSERT `uc1 — the position of the assessment period containing a day, counting months before the award` (YMD 2025 1 15) (YMD 2024 12 15) EQUALS (0 MINUS 1)
#ASSERT `uc1 — the position of the assessment period containing a day, counting months before the award` (YMD 2025 1 15) (YMD 2024 12 14) EQUALS (0 MINUS 2)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 31.
#ASSERT `reg 31 — the award includes the childcare costs element for the assessment period` TRUE TRUE
#ASSERT NOT (`reg 31 — the award includes the childcare costs element for the assessment period` TRUE FALSE)
#ASSERT NOT (`reg 31 — the award includes the childcare costs element for the assessment period` FALSE TRUE)
#ASSERT NOT (`reg 31 — the award includes the childcare costs element for the assessment period` FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 32(2)(a): ceased paid work. First date of entitlement 15 January 2025.
-- The assessment period in question is period 2 (20 March 2025): ceasing in period 2 or period 1 counts, period 0 or earlier does not.
#ASSERT `reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 3 20) (JUST (YMD 2025 4 1))
#ASSERT `reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 3 20) (JUST (YMD 2025 2 20))
#ASSERT NOT (`reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 3 20) (JUST (YMD 2025 1 20)))
-- The month before the award counts only for the first and second assessment periods, so not for period 2.
#ASSERT NOT (`reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 3 20) (JUST (YMD 2024 12 20)))
-- Period 1 (20 February 2025): ceasing in the month before the award counts (15 December to 14 January), two months before does not.
#ASSERT `reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 2 20) (JUST (YMD 2024 12 20))
#ASSERT `reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 2 20) (JUST (YMD 2025 1 10))
#ASSERT `reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 2 20) (JUST (YMD 2025 1 20))
#ASSERT NOT (`reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 2 20) (JUST (YMD 2024 11 20)))
-- Period 0 (20 January 2025): the previous period is the month before the award.
#ASSERT `reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 1 20) (JUST (YMD 2024 12 20))
#ASSERT `reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 1 20) (JUST (YMD 2025 2 10))
#ASSERT NOT (`reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 1 20) (JUST (YMD 2024 11 20)))
-- A cessation after the period in question is not covered.
#ASSERT NOT (`reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 1 20) (JUST (YMD 2025 2 20)))
-- Never ceased.
#ASSERT NOT (`reg 32(2)(a) — the claimant ceased paid work in time to be treated as in paid work` (YMD 2025 1 15) (YMD 2025 3 20) NOTHING)

-- (2)(b): each of the eight payments, and some that are not among them.
#ASSERT `reg 32(2)(b) — the claimant is receiving a payment that treats them as in paid work` (LIST `statutory sick pay`)
#ASSERT `reg 32(2)(b) — the claimant is receiving a payment that treats them as in paid work` (LIST `statutory maternity pay`)
#ASSERT `reg 32(2)(b) — the claimant is receiving a payment that treats them as in paid work` (LIST `statutory paternity pay`)
#ASSERT `reg 32(2)(b) — the claimant is receiving a payment that treats them as in paid work` (LIST `statutory adoption pay`)
#ASSERT `reg 32(2)(b) — the claimant is receiving a payment that treats them as in paid work` (LIST `statutory shared parental pay`)
#ASSERT `reg 32(2)(b) — the claimant is receiving a payment that treats them as in paid work` (LIST `statutory parental bereavement pay`)
#ASSERT `reg 32(2)(b) — the claimant is receiving a payment that treats them as in paid work` (LIST `statutory neonatal care pay`)
#ASSERT `reg 32(2)(b) — the claimant is receiving a payment that treats them as in paid work` (LIST `maternity allowance`)
#ASSERT `reg 32(2)(b) — the claimant is receiving a payment that treats them as in paid work` (LIST `carer's allowance`, `statutory sick pay`)
#ASSERT NOT (`reg 32(2)(b) — the claimant is receiving a payment that treats them as in paid work` (LIST `carer's allowance`, `employment and support allowance`))
#ASSERT NOT (`reg 32(2)(b) — the claimant is receiving a payment that treats them as in paid work` EMPTY)

#ASSERT `reg 32(2) — the claimant is treated as being in paid work` TRUE FALSE
#ASSERT `reg 32(2) — the claimant is treated as being in paid work` FALSE TRUE
#ASSERT NOT (`reg 32(2) — the claimant is treated as being in paid work` FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 32(1): the work condition.
GIVEN work IS A BOOLEAN
      treated IS A BOOLEAN
      offer IS A BOOLEAN
      couple IS A BOOLEAN
      other IS A BOOLEAN
      incapable IS A BOOLEAN
      carer IS A BOOLEAN
      absent IS A BOOLEAN
GIVETH A `Facts for the work condition`
`test — work facts` work treated offer couple other incapable carer absent MEANS
    `Facts for the work condition` WITH
        `the claimant is in paid work` IS work
        `the claimant is treated as being in paid work under paragraph (2)` IS treated
        `the claimant has an offer of paid work that is due to start before the end of the next assessment period` IS offer
        `the claimant is a member of a couple, whether claiming jointly or as a single person` IS couple
        `the other member is in paid work` IS other
        `the other member is unable to provide childcare because they have limited capability for work` IS incapable
        `the other member is unable to provide childcare because they have regular and substantial caring responsibilities for a severely disabled person` IS carer
        `the other member is unable to provide childcare because they are temporarily absent from the claimant's household` IS absent
-- A single claimant: limb (a) alone decides.
#ASSERT `reg 32(1) — the work condition is met` (`test — work facts` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `reg 32(1) — the work condition is met` (`test — work facts` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `reg 32(1) — the work condition is met` (`test — work facts` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`reg 32(1) — the work condition is met` (`test — work facts` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))
-- A member of a couple: the other member must also be in paid work or unable to provide childcare for one of the three reasons.
#ASSERT `reg 32(1) — the work condition is met` (`test — work facts` TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE)
#ASSERT `reg 32(1) — the work condition is met` (`test — work facts` TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE)
#ASSERT `reg 32(1) — the work condition is met` (`test — work facts` TRUE FALSE FALSE TRUE FALSE FALSE TRUE FALSE)
#ASSERT `reg 32(1) — the work condition is met` (`test — work facts` TRUE FALSE FALSE TRUE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`reg 32(1) — the work condition is met` (`test — work facts` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE))
-- ... and limb (a) must still be met.
#ASSERT NOT (`reg 32(1) — the work condition is met` (`test — work facts` FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE))
#ASSERT `reg 32(1) — the work condition is met` (`test — work facts` FALSE TRUE FALSE TRUE TRUE FALSE FALSE FALSE)
#ASSERT `reg 32(1) — the work condition is met` (`test — work facts` FALSE FALSE TRUE TRUE TRUE FALSE FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 33(3): the relevant notification period ends on the last day of the assessment period after the one of payment.
-- First date 15 January 2025. Paid on 20 February (period 1): the next, period 2, ends 14 April.
#ASSERT `reg 33(3) — the last day of the relevant notification period` (YMD 2025 1 15) (YMD 2025 2 20) EQUALS YMD 2025 4 14
#ASSERT `reg 33(3) — the last day of the relevant notification period` (YMD 2025 1 15) (YMD 2025 1 20) EQUALS YMD 2025 3 14
-- Paid in the month before the award (period -1): the next is period 0, which ends 14 February.
#ASSERT `reg 33(3) — the last day of the relevant notification period` (YMD 2025 1 15) (YMD 2024 12 20) EQUALS YMD 2025 2 14

-- (za): reported on the last day is in time; the day after is not, unless late reporting is accepted.
#ASSERT `reg 33(1)(za) — the charges have been paid and reported in time` (YMD 2025 1 15) TRUE (YMD 2025 2 20) (YMD 2025 4 14) FALSE
#ASSERT `reg 33(1)(za) — the charges have been paid and reported in time` (YMD 2025 1 15) TRUE (YMD 2025 2 20) (YMD 2025 2 21) FALSE
#ASSERT NOT (`reg 33(1)(za) — the charges have been paid and reported in time` (YMD 2025 1 15) TRUE (YMD 2025 2 20) (YMD 2025 4 15) FALSE)
#ASSERT `reg 33(1)(za) — the charges have been paid and reported in time` (YMD 2025 1 15) TRUE (YMD 2025 2 20) (YMD 2025 4 15) TRUE
#ASSERT NOT (`reg 33(1)(za) — the charges have been paid and reported in time` (YMD 2025 1 15) FALSE (YMD 2025 2 20) (YMD 2025 2 21) FALSE)
#ASSERT NOT (`reg 33(1)(za) — the charges have been paid and reported in time` (YMD 2025 1 15) FALSE (YMD 2025 2 20) (YMD 2025 4 15) TRUE)

-- (a): the person for whom the charges are paid.
GIVEN child IS A BOOLEAN
      young IS A BOOLEAN
      born IS A DATE
      responsible IS A BOOLEAN
      first IS A DATE
GIVETH A `Person for whom childcare charges are paid`
`test — person` child young born responsible first MEANS
    `Person for whom childcare charges are paid` WITH
        `the person is a child` IS child
        `the person is a qualifying young person` IS young
        `date of birth` IS born
        `the claimant is responsible for the person` IS responsible
        `first day of the assessment period` IS first
#ASSERT `reg 33(1)(a) — the charges are in respect of a child or qualifying young person for whom the claimant is responsible` (`test — person` TRUE FALSE (YMD 2020 5 5) TRUE (YMD 2025 1 15))
#ASSERT NOT (`reg 33(1)(a) — the charges are in respect of a child or qualifying young person for whom the claimant is responsible` (`test — person` TRUE FALSE (YMD 2020 5 5) FALSE (YMD 2025 1 15)))
-- A qualifying young person born 1 January 2010 reaches the 1st September following their 16th birthday on 1 September 2026.
#ASSERT `reg 33(1)(a) — the charges are in respect of a child or qualifying young person for whom the claimant is responsible` (`test — person` FALSE TRUE (YMD 2010 1 1) TRUE (YMD 2026 8 31))
#ASSERT NOT (`reg 33(1)(a) — the charges are in respect of a child or qualifying young person for whom the claimant is responsible` (`test — person` FALSE TRUE (YMD 2010 1 1) TRUE (YMD 2026 9 1)))
-- Born 31 August 2009: the 1st September following the 16th birthday (31 August 2025) is 1 September 2025.
#ASSERT `reg 33(1)(a) — the charges are in respect of a child or qualifying young person for whom the claimant is responsible` (`test — person` FALSE TRUE (YMD 2009 8 31) TRUE (YMD 2025 8 31))
#ASSERT NOT (`reg 33(1)(a) — the charges are in respect of a child or qualifying young person for whom the claimant is responsible` (`test — person` FALSE TRUE (YMD 2009 8 31) TRUE (YMD 2025 9 1)))
-- Neither a child nor a qualifying young person.
#ASSERT NOT (`reg 33(1)(a) — the charges are in respect of a child or qualifying young person for whom the claimant is responsible` (`test — person` FALSE FALSE (YMD 2005 5 5) TRUE (YMD 2025 1 15)))

-- (b): the arrangements.
#ASSERT `reg 33(1)(b) — the charges are for qualifying childcare arrangements` TRUE FALSE FALSE
#ASSERT NOT (`reg 33(1)(b) — the charges are for qualifying childcare arrangements` FALSE FALSE TRUE)
#ASSERT `reg 33(1)(b) — the charges are for qualifying childcare arrangements` FALSE TRUE TRUE
#ASSERT NOT (`reg 33(1)(b) — the charges are for qualifying childcare arrangements` FALSE TRUE FALSE)
#ASSERT NOT (`reg 33(1)(b) — the charges are for qualifying childcare arrangements` FALSE FALSE FALSE)

-- (1): the three limbs together.
#ASSERT `reg 33(1) — the childcare costs condition is met` TRUE TRUE TRUE
#ASSERT NOT (`reg 33(1) — the childcare costs condition is met` FALSE TRUE TRUE)
#ASSERT NOT (`reg 33(1) — the childcare costs condition is met` TRUE FALSE TRUE)
#ASSERT NOT (`reg 33(1) — the childcare costs condition is met` TRUE TRUE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 34A(1): attribution, with the assessment period in question being period 2 (20 March 2025), first date 15 January 2025.
-- (a) paid in the period for care in respect of it.
#ASSERT `reg 34A(1) — the charges are attributable to the assessment period` (YMD 2025 1 15) (YMD 2025 4 1) (YMD 2025 3 20) (YMD 2025 3 20)
-- (b) paid in the period for care in respect of a previous period.
#ASSERT `reg 34A(1) — the charges are attributable to the assessment period` (YMD 2025 1 15) (YMD 2025 4 1) (YMD 2025 1 20) (YMD 2025 3 20)
-- Paid in the period for care in respect of a later period.
#ASSERT NOT (`reg 34A(1) — the charges are attributable to the assessment period` (YMD 2025 1 15) (YMD 2025 4 1) (YMD 2025 4 20) (YMD 2025 3 20))
-- (c) paid in either of the two previous periods for care in respect of the period.
#ASSERT `reg 34A(1) — the charges are attributable to the assessment period` (YMD 2025 1 15) (YMD 2025 2 20) (YMD 2025 3 20) (YMD 2025 3 20)
#ASSERT `reg 34A(1) — the charges are attributable to the assessment period` (YMD 2025 1 15) (YMD 2025 1 20) (YMD 2025 3 20) (YMD 2025 3 20)
-- Three periods before is too early; paid in the previous period for care in respect of that period is not this period's.
#ASSERT NOT (`reg 34A(1) — the charges are attributable to the assessment period` (YMD 2025 1 15) (YMD 2024 12 20) (YMD 2025 3 20) (YMD 2025 3 20))
#ASSERT NOT (`reg 34A(1) — the charges are attributable to the assessment period` (YMD 2025 1 15) (YMD 2025 2 20) (YMD 2025 2 25) (YMD 2025 3 20))
-- Paid after the period for care in respect of it.
#ASSERT NOT (`reg 34A(1) — the charges are attributable to the assessment period` (YMD 2025 1 15) (YMD 2025 4 20) (YMD 2025 3 20) (YMD 2025 3 20))
-- (3) The months before the award count: period 1 (20 February), charges paid on 20 December 2024 (period -1) for care in period 1.
#ASSERT `reg 34A(1) — the charges are attributable to the assessment period` (YMD 2025 1 15) (YMD 2024 12 20) (YMD 2025 2 20) (YMD 2025 2 20)
-- Period 0 (20 January), charges paid on 20 December 2024 (period -1) for care in period 0.
#ASSERT `reg 34A(1) — the charges are attributable to the assessment period` (YMD 2025 1 15) (YMD 2024 12 20) (YMD 2025 1 20) (YMD 2025 1 20)
-- Paid in period -1 for care in period -1 is attributable to no period of the award in question 0.
#ASSERT NOT (`reg 34A(1) — the charges are attributable to the assessment period` (YMD 2025 1 15) (YMD 2024 12 20) (YMD 2024 12 25) (YMD 2025 1 20))

-- (2) The formula is not in the text: no amount.
#ASSERT `reg 34A(2) — the amount paid in advance in respect of an assessment period` 300 30 10 EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 34(3): other relevant support.
GIVEN funds IS A BOOLEAN
      byMinister IS A BOOLEAN
      work IS A BOOLEAN
      before IS A BOOLEAN
      less IS A BOOLEAN
GIVETH A `Payment that may be other relevant support`
`test — payment` funds byMinister work before less MEANS
    `Payment that may be other relevant support` WITH
        `the payment is out of funds provided by the Secretary of State or by Scottish or Welsh Ministers in connection with the claimant's participation in work-related activity or training` IS funds
        `the payment is made by the Secretary of State` IS byMinister
        `the claimant has taken up, or is due to take up, paid work, or has increased, or is due to increase, their hours of paid work` IS work
        `the claimant is required to pay the charges for relevant childcare before they receive a payment of universal credit that reflects the increase in the claimant's earned income` IS before
        `if the payment is not taken into account the claimant will be less likely to continue in paid work or maintain the increase in hours of paid work` IS less
#ASSERT `reg 34(3) — the payment is other relevant support` (`test — payment` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`reg 34(3) — the payment is other relevant support` (`test — payment` FALSE FALSE FALSE FALSE FALSE))
-- A Secretary of State payment that meets (a), (b) and (c) is not other relevant support.
#ASSERT NOT (`reg 34(3) — the payment is other relevant support` (`test — payment` TRUE TRUE TRUE TRUE TRUE))
#ASSERT `reg 34(3) — the payment is other relevant support` (`test — payment` TRUE TRUE TRUE TRUE FALSE)
#ASSERT `reg 34(3) — the payment is other relevant support` (`test — payment` TRUE TRUE TRUE FALSE TRUE)
#ASSERT `reg 34(3) — the payment is other relevant support` (`test — payment` TRUE TRUE FALSE TRUE TRUE)
-- The exclusion is for payments made by the Secretary of State only.
#ASSERT `reg 34(3) — the payment is other relevant support` (`test — payment` TRUE FALSE TRUE TRUE TRUE)

-- Regulation 34(2): charges after leaving amounts out of account.
#ASSERT `reg 34(2) — the charges paid after amounts are left out of account` 1000 100 200 EQUALS 700
#ASSERT `reg 34(2) — the charges paid after amounts are left out of account` 1000 0 0 EQUALS 1000
#ASSERT `reg 34(2) — the charges paid after amounts are left out of account` 100 150 0 EQUALS 0

-- Regulation 34(1): the lesser of 85% of the charges and the maximum (1,071.09 for one child, 1,836.16 for two or more).
#ASSERT `reg 34(1) — the amount of the childcare costs element for an assessment period` 1000 1 EQUALS JUST 850
#ASSERT `reg 34(1) — the amount of the childcare costs element for an assessment period` 1500 1 EQUALS JUST 1071.09
#ASSERT `reg 34(1) — the amount of the childcare costs element for an assessment period` 1500 2 EQUALS JUST 1275
#ASSERT `reg 34(1) — the amount of the childcare costs element for an assessment period` 3000 2 EQUALS JUST 1836.16
#ASSERT `reg 34(1) — the amount of the childcare costs element for an assessment period` 3000 3 EQUALS JUST 1836.16
#ASSERT `reg 34(1) — the amount of the childcare costs element for an assessment period` 1000 0 EQUALS NOTHING
-- 85% of 1,260.10 is 1,071.085, which regulation 6(1) rounds up to 1,071.09: equal to the maximum, not more.
#ASSERT `reg 34(1) — the amount of the childcare costs element for an assessment period` 1260.10 1 EQUALS JUST 1071.09
-- Fractions of a penny: 85% of 100.01 is 85.0085 (rounded up to 85.01), of 100.02 is 85.017 (85.02), of 100.03 is 85.0255 (85.03),
-- of 10.10 is 8.585 (exactly half a penny, treated as a penny: 8.59).
#ASSERT `reg 34(1) — the amount of the childcare costs element for an assessment period` 100.01 1 EQUALS JUST 85.01
#ASSERT `reg 34(1) — the amount of the childcare costs element for an assessment period` 100.02 1 EQUALS JUST 85.02
#ASSERT `reg 34(1) — the amount of the childcare costs element for an assessment period` 100.03 1 EQUALS JUST 85.03
#ASSERT `reg 34(1) — the amount of the childcare costs element for an assessment period` 10.10 1 EQUALS JUST 8.59

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 35(6)(a): the proprietor of a school.
#ASSERT `reg 35(6)(a) — the care is by or under the direction of the proprietor of the school` TRUE FALSE FALSE
#ASSERT `reg 35(6)(a) — the care is by or under the direction of the proprietor of the school` TRUE TRUE FALSE
#ASSERT `reg 35(6)(a) — the care is by or under the direction of the proprietor of the school` FALSE TRUE TRUE
-- The managing body is the proprietor only if there is no governing body.
#ASSERT NOT (`reg 35(6)(a) — the care is by or under the direction of the proprietor of the school` FALSE FALSE TRUE)
#ASSERT NOT (`reg 35(6)(a) — the care is by or under the direction of the proprietor of the school` FALSE TRUE FALSE)

-- Regulation 35: relevant childcare. Fixtures, one builder for the care of each place.

GIVEN child IS A BOOLEAN
      registered IS A BOOLEAN
      breach IS A BOOLEAN
      school IS A BOOLEAN
      inspected IS A BOOLEAN
      outofhours IS A BOOLEAN
      reached IS A BOOLEAN
      domiciliary IS A BOOLEAN
      relative IS A BOOLEAN
      foster IS A BOOLEAN
GIVETH A `Care that may be relevant childcare`
`test — English care` child registered breach school inspected outofhours reached domiciliary relative foster MEANS
    `Care that may be relevant childcare` WITH
        `the person cared for is a child, or a qualifying young person mentioned in regulation 33(1)(a)(ii)` IS child
        `where the care is provided` IS `in England`
        `the care is by a person registered under Part 3 of the Childcare Act 2006` IS registered
        `the care is provided in breach of a requirement to register under Part 3 of the Childcare Act 2006` IS breach
        `the care is provided as part of the school's activities` IS school
        `the school is one that the Chief Inspector of Education, Children's Services and Skills is, or may be, required to inspect` IS inspected
        `the care is out of school hours` IS outofhours
        `the child has reached compulsory school age` IS reached
        `the care is by a domiciliary care provider registered with the Care Quality Commission in accordance with the requirements of the Health and Social Care Act 2008` IS domiciliary
        `the care is by a person whose care service consists of child minding or of day care of children within the meaning of schedule 12 to the Public Services Reform (Scotland) Act 2010 and is registered under Part 5 of that Act` IS FALSE
        `the care is by a childcare agency whose care service consists of or includes supplying, or introducing to persons who use the service, childcarers within the meaning of paragraph 5 of schedule 12 to that Act` IS FALSE
        `the care is by a local authority whose care service consists of child minding or of day care of children within the meaning of schedule 12 to that Act and is registered under Part 5 of that Act` IS FALSE
        `the care is by a person registered under Part 2 of the Children and Families (Wales) Measure 2010` IS FALSE
        `but for article 11, 12 or 14 of the Child Minding and Day Care Exceptions (Wales) Order 2010 the care would be day care for the purposes of Part 2 of the Children and Families (Wales) Measure 2010` IS FALSE
        `the care is by a childcare provider approved in accordance with a scheme made under section 12(5) of the Tax Credits Act 2002 or under section 60 of the Government of Wales Act 2006` IS FALSE
        `the care is by a school on school premises, meaning premises that may be inspected as part of an inspection of the school` IS FALSE
        `the care is by a local authority` IS FALSE
        `the care is by a person employed, or engaged under a contract for services, to provide care and support by the provider of a domiciliary support service within the meaning of Part 1 of the Regulation and Inspection of Social Care (Wales) Act 2016` IS FALSE
        `the care is by a foster parent in relation to a child other than one whom the foster parent is fostering, and would be child minding or day care for the purposes of Part 2 of the Children and Families (Wales) Measure 2010 but for the fact that the child is over the age of the children to whom that Measure applies` IS FALSE
        `the care is by a childcare provider approved by an organisation accredited by the Secretary of State` IS FALSE
        `the care is provided by a close relative of the child, wholly or mainly in the child's home` IS relative
        `the care is provided by a person who is a foster parent of the child` IS foster

GIVEN child IS A BOOLEAN
      minder IS A BOOLEAN
      agency IS A BOOLEAN
      authority IS A BOOLEAN
      relative IS A BOOLEAN
      foster IS A BOOLEAN
GIVETH A `Care that may be relevant childcare`
`test — Scottish care` child minder agency authority relative foster MEANS
    `Care that may be relevant childcare` WITH
        `the person cared for is a child, or a qualifying young person mentioned in regulation 33(1)(a)(ii)` IS child
        `where the care is provided` IS `in Scotland`
        `the care is by a person registered under Part 3 of the Childcare Act 2006` IS FALSE
        `the care is provided in breach of a requirement to register under Part 3 of the Childcare Act 2006` IS FALSE
        `the care is provided as part of the school's activities` IS FALSE
        `the school is one that the Chief Inspector of Education, Children's Services and Skills is, or may be, required to inspect` IS FALSE
        `the care is out of school hours` IS FALSE
        `the child has reached compulsory school age` IS FALSE
        `the care is by a domiciliary care provider registered with the Care Quality Commission in accordance with the requirements of the Health and Social Care Act 2008` IS FALSE
        `the care is by a person whose care service consists of child minding or of day care of children within the meaning of schedule 12 to the Public Services Reform (Scotland) Act 2010 and is registered under Part 5 of that Act` IS minder
        `the care is by a childcare agency whose care service consists of or includes supplying, or introducing to persons who use the service, childcarers within the meaning of paragraph 5 of schedule 12 to that Act` IS agency
        `the care is by a local authority whose care service consists of child minding or of day care of children within the meaning of schedule 12 to that Act and is registered under Part 5 of that Act` IS authority
        `the care is by a person registered under Part 2 of the Children and Families (Wales) Measure 2010` IS FALSE
        `but for article 11, 12 or 14 of the Child Minding and Day Care Exceptions (Wales) Order 2010 the care would be day care for the purposes of Part 2 of the Children and Families (Wales) Measure 2010` IS FALSE
        `the care is by a childcare provider approved in accordance with a scheme made under section 12(5) of the Tax Credits Act 2002 or under section 60 of the Government of Wales Act 2006` IS FALSE
        `the care is by a school on school premises, meaning premises that may be inspected as part of an inspection of the school` IS FALSE
        `the care is by a local authority` IS FALSE
        `the care is by a person employed, or engaged under a contract for services, to provide care and support by the provider of a domiciliary support service within the meaning of Part 1 of the Regulation and Inspection of Social Care (Wales) Act 2016` IS FALSE
        `the care is by a foster parent in relation to a child other than one whom the foster parent is fostering, and would be child minding or day care for the purposes of Part 2 of the Children and Families (Wales) Measure 2010 but for the fact that the child is over the age of the children to whom that Measure applies` IS FALSE
        `the care is by a childcare provider approved by an organisation accredited by the Secretary of State` IS FALSE
        `the care is provided by a close relative of the child, wholly or mainly in the child's home` IS relative
        `the care is provided by a person who is a foster parent of the child` IS foster

GIVEN child IS A BOOLEAN
      registered IS A BOOLEAN
      exempt IS A BOOLEAN
      approved IS A BOOLEAN
      school IS A BOOLEAN
      authority IS A BOOLEAN
      outofhours IS A BOOLEAN
      domiciliary IS A BOOLEAN
      fosterer IS A BOOLEAN
      relative IS A BOOLEAN
      foster IS A BOOLEAN
