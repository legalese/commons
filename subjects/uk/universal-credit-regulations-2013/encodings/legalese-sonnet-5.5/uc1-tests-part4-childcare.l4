-- England, regulation 35(2): the ten arguments are: a child; registered under Part 3 of the Childcare Act 2006; in breach of a
-- requirement to register; as part of a school's activities; at a school the Chief Inspector may inspect; out of school hours; the
-- child has reached compulsory school age; by a registered domiciliary care provider; by a close relative; by a foster parent.
`English care by a registered childminder` MEANS `test — English care` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
`English care by a registered childminder, in breach of a requirement to register` MEANS `test — English care` TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
`English school care out of school hours for a child of school age` MEANS `test — English care` TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE
`English school care in school hours for a child of school age` MEANS `test — English care` TRUE FALSE FALSE TRUE TRUE FALSE TRUE FALSE FALSE FALSE
`English school care in school hours for a child under school age` MEANS `test — English care` TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE
`English school care at a school that the Chief Inspector does not inspect` MEANS `test — English care` TRUE FALSE FALSE TRUE FALSE TRUE TRUE FALSE FALSE FALSE
`English care by a registered domiciliary care provider` MEANS `test — English care` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE
`English care by a close relative` MEANS `test — English care` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE
`English care by a foster parent of the child` MEANS `test — English care` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
`English care that is not for a child` MEANS `test — English care` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 35(1) — the care is relevant childcare` `English care by a registered childminder` FALSE
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `English care by a registered childminder, in breach of a requirement to register` FALSE)
#ASSERT `reg 35(1) — the care is relevant childcare` `English school care out of school hours for a child of school age` TRUE
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `English school care in school hours for a child of school age` TRUE)
#ASSERT `reg 35(1) — the care is relevant childcare` `English school care in school hours for a child under school age` TRUE
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `English school care at a school that the Chief Inspector does not inspect` TRUE)
-- The care must be by or under the direction of the school's proprietor.
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `English school care out of school hours for a child of school age` FALSE)
#ASSERT `reg 35(1) — the care is relevant childcare` `English care by a registered domiciliary care provider` FALSE
-- (7) excludes a close relative's care in the child's home and a foster parent's care, even when otherwise within (2).
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `English care by a close relative` FALSE)
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `English care by a foster parent of the child` FALSE)
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `English care that is not for a child` FALSE)
#ASSERT `reg 35(2) — care provided in England for a child` `English care by a registered childminder` FALSE
#ASSERT NOT (`reg 35(2) — care provided in England for a child` `English care by a registered childminder, in breach of a requirement to register` FALSE)
#ASSERT `reg 35(7) — the care is excluded` `English care by a close relative`
#ASSERT `reg 35(7) — the care is excluded` `English care by a foster parent of the child`
#ASSERT NOT (`reg 35(7) — the care is excluded` `English care by a registered childminder`)

-- Scotland, regulation 35(3): a child; (a) a registered child minder or day care; (b) a childcare agency; (c) a local authority; a close relative; a foster parent.
`Scottish care by a registered child minder` MEANS `test — Scottish care` TRUE TRUE FALSE FALSE FALSE FALSE
`Scottish care by a childcare agency` MEANS `test — Scottish care` TRUE FALSE TRUE FALSE FALSE FALSE
`Scottish care by a local authority` MEANS `test — Scottish care` TRUE FALSE FALSE TRUE FALSE FALSE
`Scottish care of no described kind` MEANS `test — Scottish care` TRUE FALSE FALSE FALSE FALSE FALSE
`Scottish care by a child minder who is a close relative` MEANS `test — Scottish care` TRUE TRUE FALSE FALSE TRUE FALSE
#ASSERT `reg 35(1) — the care is relevant childcare` `Scottish care by a registered child minder` FALSE
#ASSERT `reg 35(1) — the care is relevant childcare` `Scottish care by a childcare agency` FALSE
#ASSERT `reg 35(1) — the care is relevant childcare` `Scottish care by a local authority` FALSE
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `Scottish care of no described kind` FALSE)
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `Scottish care by a child minder who is a close relative` FALSE)
-- The paragraph for England does not describe care provided in Scotland.
#ASSERT NOT (`reg 35(2) — care provided in England for a child` `Scottish care by a registered child minder` FALSE)
#ASSERT `reg 35(3) — care provided in Scotland for a child` `Scottish care by a registered child minder`

-- Wales, regulation 35(4): a child; (a) registered; (b) exempted; (c) approved provider; (d) by a school on school premises or by a local
-- authority, out of school hours; (e) domiciliary support; (f) a foster parent; a close relative; a foster parent of the child.
-- The arguments of `test — Welsh care` are: child, registered, exempt, approved, school, authority, out of school hours, domiciliary,
-- foster parent (f), close relative, foster parent of the child.
`Welsh care by a registered person` MEANS `test — Welsh care` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
`Welsh care that is exempt from registration` MEANS `test — Welsh care` TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
`Welsh care by an approved childcare provider` MEANS `test — Welsh care` TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
`Welsh care out of school hours by a school on school premises` MEANS `test — Welsh care` TRUE FALSE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE FALSE
`Welsh care out of school hours by a local authority` MEANS `test — Welsh care` TRUE FALSE FALSE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE
`Welsh care by a school on school premises, in school hours` MEANS `test — Welsh care` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE
`Welsh care by a local authority, in school hours` MEANS `test — Welsh care` TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
`Welsh domiciliary support care` MEANS `test — Welsh care` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE
`Welsh care by a foster parent of another child, over the Measure's age` MEANS `test — Welsh care` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE
`Welsh care of no described kind` MEANS `test — Welsh care` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
`Welsh care by a registered person who is a foster parent of the child` MEANS `test — Welsh care` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT `reg 35(1) — the care is relevant childcare` `Welsh care by a registered person` FALSE
#ASSERT `reg 35(1) — the care is relevant childcare` `Welsh care that is exempt from registration` FALSE
#ASSERT `reg 35(1) — the care is relevant childcare` `Welsh care by an approved childcare provider` FALSE
#ASSERT `reg 35(1) — the care is relevant childcare` `Welsh care out of school hours by a school on school premises` FALSE
#ASSERT `reg 35(1) — the care is relevant childcare` `Welsh care out of school hours by a local authority` FALSE
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `Welsh care by a school on school premises, in school hours` FALSE)
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `Welsh care by a local authority, in school hours` FALSE)
#ASSERT `reg 35(1) — the care is relevant childcare` `Welsh domiciliary support care` FALSE
#ASSERT `reg 35(1) — the care is relevant childcare` `Welsh care by a foster parent of another child, over the Measure's age` FALSE
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `Welsh care of no described kind` FALSE)
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `Welsh care by a registered person who is a foster parent of the child` FALSE)

-- Outside Great Britain, regulation 35(5): a child; a provider approved by an organisation the Secretary of State has accredited; a close relative; a foster parent.
`care abroad by an approved provider` MEANS `test — care abroad` TRUE TRUE FALSE FALSE
`care abroad by an unapproved provider` MEANS `test — care abroad` TRUE FALSE FALSE FALSE
`care abroad by an approved provider who is a close relative` MEANS `test — care abroad` TRUE TRUE TRUE FALSE
#ASSERT `reg 35(1) — the care is relevant childcare` `care abroad by an approved provider` FALSE
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `care abroad by an unapproved provider` FALSE)
#ASSERT NOT (`reg 35(1) — the care is relevant childcare` `care abroad by an approved provider who is a close relative` FALSE)
#ASSERT `reg 35(5) — care provided outside Great Britain for a child` `care abroad by an approved provider`
