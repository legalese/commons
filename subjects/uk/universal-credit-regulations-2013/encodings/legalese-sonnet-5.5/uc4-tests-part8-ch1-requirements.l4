-- Regulation 98(4): domestic violence is controlling behaviour, coercive behaviour, violence or abuse.
#ASSERT `reg 98(4) — domestic violence` (`test — incident` TRUE FALSE FALSE FALSE)
#ASSERT `reg 98(4) — domestic violence` (`test — incident` FALSE TRUE FALSE FALSE)
#ASSERT `reg 98(4) — domestic violence` (`test — incident` FALSE FALSE TRUE FALSE)
#ASSERT `reg 98(4) — domestic violence` (`test — incident` FALSE FALSE FALSE TRUE)
#ASSERT NOT (`reg 98(4) — domestic violence` (`test — incident` FALSE FALSE FALSE FALSE))
-- Family member: one of the listed relations, or the other member of a couple of which one is.
#ASSERT `reg 98(4) — family member` (`test — possible family member` `a grandparent of the claimant` `not one of the relations of a family member`)
#ASSERT `reg 98(4) — family member` (`test — possible family member` `a sister-in-law of the claimant` `not one of the relations of a family member`)
#ASSERT `reg 98(4) — family member` (`test — possible family member` `not one of the relations of a family member` `a step-brother of the claimant`)
#ASSERT NOT (`reg 98(4) — family member` (`test — possible family member` `not one of the relations of a family member` `not one of the relations of a family member`))
-- Person acting in an official capacity.
#ASSERT `reg 98(4) — person acting in an official capacity` (`test — official` TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `reg 98(4) — person acting in an official capacity` (`test — official` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `reg 98(4) — person acting in an official capacity` (`test — official` FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `reg 98(4) — person acting in an official capacity` (`test — official` FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE)
#ASSERT `reg 98(4) — person acting in an official capacity` (`test — official` FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE)
#ASSERT `reg 98(4) — person acting in an official capacity` (`test — official` FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE)
#ASSERT `reg 98(4) — person acting in an official capacity` (`test — official` FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE)
#ASSERT `reg 98(4) — person acting in an official capacity` (`test — official` FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE)
#ASSERT `reg 98(4) — person acting in an official capacity` (`test — official` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`reg 98(4) — person acting in an official capacity` (`test — official` FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))

-- Regulation 98(2): violence on 15 January 2026; 6 months have not expired on 14 July 2026, and have on 15 July 2026.
#ASSERT `reg 98(2) — the claimant has recently been a victim of domestic violence` (YearMonthDay 2026 1 15) (YearMonthDay 2026 7 14)
#ASSERT `reg 98(2) — the claimant has recently been a victim of domestic violence` (YearMonthDay 2026 1 15) (YearMonthDay 2026 1 15)
#ASSERT NOT (`reg 98(2) — the claimant has recently been a victim of domestic violence` (YearMonthDay 2026 1 15) (YearMonthDay 2026 7 15))
#ASSERT NOT (`reg 98(2) — the claimant has recently been a victim of domestic violence` (YearMonthDay 2026 1 15) (YearMonthDay 2026 1 14))

-- Regulation 98(3)(a): violence on 1 May 2026, notified on 1 July 2026, by a partner.
#ASSERT `reg 98(3)(a) — the claimant has notified the Secretary of State of domestic violence in the last 6 months` `test — a good notification`
-- By a family member rather than a partner or former partner.
#ASSERT `reg 98(3)(a) — the claimant has notified the Secretary of State of domestic violence in the last 6 months` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) FALSE TRUE NOTHING FALSE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE TRUE)
-- By someone who is neither.
#ASSERT NOT (`reg 98(3)(a) — the claimant has notified the Secretary of State of domestic violence in the last 6 months` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) FALSE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE TRUE))
-- Violence on 2 January 2026: the 6 months run to 1 July 2026, so the notification on 1 July 2026 is the last day.
#ASSERT `reg 98(3)(a) — the claimant has notified the Secretary of State of domestic violence in the last 6 months` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 1 2) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 98(3)(a) — the claimant has notified the Secretary of State of domestic violence in the last 6 months` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 1 1) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE TRUE))
-- Not notified, or not domestic violence.
#ASSERT NOT (`reg 98(3)(a) — the claimant has notified the Secretary of State of domestic violence in the last 6 months` (`test — notification` (YearMonthDay 2026 7 1) FALSE TRUE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE TRUE))
#ASSERT NOT (`reg 98(3)(a) — the claimant has notified the Secretary of State of domestic violence in the last 6 months` (`test — notification` (YearMonthDay 2026 7 1) TRUE FALSE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE TRUE))

-- Regulation 98(3)(b): the regulation last applied up to 1 July 2025, so 12 months have run by 1 July 2026 (fork F-98-2).
#ASSERT `reg 98(3)(b) — this regulation has not applied to the claimant for 12 months` `test — a good notification`
#ASSERT `reg 98(3)(b) — this regulation has not applied to the claimant for 12 months` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE (JUST (YearMonthDay 2025 7 1)) FALSE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 98(3)(b) — this regulation has not applied to the claimant for 12 months` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE (JUST (YearMonthDay 2025 7 2)) FALSE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE TRUE))
-- Regulation 98(3)(c).
#ASSERT `reg 98(3)(c) — the claimant is not living at the same address` `test — a good notification`
#ASSERT NOT (`reg 98(3)(c) — the claimant is not living at the same address` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING TRUE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE TRUE))
-- Regulation 98(3)(d): evidence no later than 1 month after the notification: 1 August 2026.
#ASSERT `reg 98(3)(d) — the claimant provides the evidence in time` `test — a good notification`
#ASSERT `reg 98(3)(d) — the claimant provides the evidence in time` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 8 1)) TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 98(3)(d) — the claimant provides the evidence in time` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 8 2)) TRUE TRUE TRUE TRUE))
#ASSERT NOT (`reg 98(3)(d) — the claimant provides the evidence in time` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 6 30)) TRUE TRUE TRUE TRUE))
#ASSERT NOT (`reg 98(3)(d) — the claimant provides the evidence in time` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING FALSE NOTHING TRUE TRUE TRUE TRUE))
#ASSERT NOT (`reg 98(3)(d) — the claimant provides the evidence in time` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 7 20)) FALSE TRUE TRUE TRUE))
#ASSERT NOT (`reg 98(3)(d) — the claimant provides the evidence in time` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 7 20)) TRUE FALSE TRUE TRUE))
#ASSERT NOT (`reg 98(3)(d) — the claimant provides the evidence in time` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE FALSE TRUE))
#ASSERT NOT (`reg 98(3)(d) — the claimant provides the evidence in time` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE FALSE))
-- Regulation 98(3) and (1).
#ASSERT `reg 98(3) — the circumstances apply` `test — a good notification`
#ASSERT `reg 98(1) — this regulation applies to the claimant` `test — a good notification`
#ASSERT NOT (`reg 98(3) — the circumstances apply` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING TRUE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE TRUE))
#ASSERT NOT (`reg 98(1) — this regulation applies to the claimant` (`test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 1 1) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE TRUE))

-- Regulation 98(1)(a) and (b): 13 consecutive weeks starting on the date of the notification, 1 July 2026: 91 days, the last 29 September 2026.
#ASSERT `reg 98(1)(a) — a work-related requirement imposed on the claimant has no effect on the date` TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 7 1)
#ASSERT `reg 98(1)(a) — a work-related requirement imposed on the claimant has no effect on the date` TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 9 29)
#ASSERT NOT (`reg 98(1)(a) — a work-related requirement imposed on the claimant has no effect on the date` TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 9 30))
#ASSERT NOT (`reg 98(1)(a) — a work-related requirement imposed on the claimant has no effect on the date` TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 6 30))
#ASSERT NOT (`reg 98(1)(a) — a work-related requirement imposed on the claimant has no effect on the date` FALSE (YearMonthDay 2026 7 1) (YearMonthDay 2026 7 2))
#ASSERT `reg 98(1)(b) — the Secretary of State must not impose another work-related requirement on the date` TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 9 29)
#ASSERT NOT (`reg 98(1)(b) — the Secretary of State must not impose another work-related requirement on the date` TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 9 30))
#ASSERT NOT (`reg 98(1)(b) — the Secretary of State must not impose another work-related requirement on the date` FALSE (YearMonthDay 2026 7 1) (YearMonthDay 2026 7 2))
-- Regulation 98(1A): a further 13 weeks, 30 September 2026 to 29 December 2026, for a section 22 claimant who is the responsible carer of a child.
#ASSERT `reg 98(1A) — the Secretary of State must not impose a work search or work availability requirement on the date` TRUE TRUE TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 9 30)
#ASSERT `reg 98(1A) — the Secretary of State must not impose a work search or work availability requirement on the date` TRUE TRUE TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 12 29)
#ASSERT NOT (`reg 98(1A) — the Secretary of State must not impose a work search or work availability requirement on the date` TRUE TRUE TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 12 30))
#ASSERT NOT (`reg 98(1A) — the Secretary of State must not impose a work search or work availability requirement on the date` TRUE TRUE TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 9 29))
#ASSERT NOT (`reg 98(1A) — the Secretary of State must not impose a work search or work availability requirement on the date` TRUE FALSE TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 10 15))
#ASSERT NOT (`reg 98(1A) — the Secretary of State must not impose a work search or work availability requirement on the date` TRUE TRUE FALSE (YearMonthDay 2026 7 1) (YearMonthDay 2026 10 15))
#ASSERT NOT (`reg 98(1A) — the Secretary of State must not impose a work search or work availability requirement on the date` FALSE TRUE TRUE (YearMonthDay 2026 7 1) (YearMonthDay 2026 10 15))
