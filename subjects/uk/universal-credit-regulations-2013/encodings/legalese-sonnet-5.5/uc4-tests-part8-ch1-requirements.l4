IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-persons`
IMPORT `uc4-part8-ch1-requirements`

-- Tests of uc4-part8-ch1-requirements.l4: regulations 93 to 98.
-- Expected values are written by hand from the text, beside the assertion.

-- ---------------------------------------------------------------------------------------------------------
-- Fixtures.
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
GIVETH AN `Incident of domestic violence`
`test — incident` a b c d MEANS `Incident of domestic violence` WITH
    `the incident or pattern of incidents is controlling behaviour` IS a
    `the incident or pattern of incidents is coercive behaviour` IS b
    `the incident or pattern of incidents is violence` IS c
    `the incident or pattern of incidents is abuse, including psychological, physical, sexual, emotional or financial abuse` IS d

GIVEN own IS A `Relation of a family member to the claimant`
      partner IS A `Relation of a family member to the claimant`
GIVETH A `Possible family member of the claimant`
`test — possible family member` own partner MEANS `Possible family member of the claimant` WITH
    `relation of the person to the claimant` IS own
    `relation of the person's partner to the claimant` IS partner

GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
      e IS A BOOLEAN
      f IS A BOOLEAN
      g IS A BOOLEAN
      h IS A BOOLEAN
      i IS A BOOLEAN
GIVETH A `Person acting in an official capacity facts`
`test — official` a b c d e f g h i MEANS `Person acting in an official capacity facts` WITH
    `a member of a profession regulated by a body mentioned in section 25(3) of the National Health Service Reform and Health Care Professions Act 2002` IS a
    `a police officer` IS b
    `registered as a social worker in a register maintained by Social Work England` IS c
    `registered as a social worker in a register maintained by Social Care Wales` IS d
    `registered as a social worker in a register maintained by the Scottish Social Services Council` IS e
    `registered as a social worker in a register maintained by the Northern Ireland Social Care Council` IS f
    `the claimant's employer` IS g
    `a representative of the claimant's trade union` IS h
    `a public, voluntary or charitable body which has had direct contact with the claimant in connection with domestic violence` IS i

GIVEN notifiedDate IS A DATE
      notified IS A BOOLEAN
      dv IS A BOOLEAN
      incidentDate IS A DATE
      partner IS A BOOLEAN
      family IS A BOOLEAN
      last IS A MAYBE DATE
      sameAddress IS A BOOLEAN
      evidenceDate IS A MAYBE DATE
      asap IS A BOOLEAN
      official IS A BOOLEAN
      consistent IS A BOOLEAN
      contact IS A BOOLEAN
GIVETH A `Domestic violence notification facts`
`test — notification` notifiedDate notified dv incidentDate partner family last sameAddress evidenceDate asap official consistent contact MEANS `Domestic violence notification facts` WITH
    `date of the notification` IS notifiedDate
    `the claimant notifies the Secretary of State, in such manner as the Secretary of State specifies, that domestic violence has been inflicted on or threatened against the claimant` IS notified
    `the incident is domestic violence` IS dv
    `date on which the violence was inflicted or threatened` IS incidentDate
    `the violence was inflicted or threatened by the claimant's partner or former partner` IS partner
    `the violence was inflicted or threatened by a family member` IS family
    `last day on which this regulation applied to the claimant` IS last
    `on the date of the notification the claimant is living at the same address as the person who inflicted or threatened the domestic violence` IS sameAddress
    `date on which the claimant provided the evidence` IS evidenceDate
    `the claimant provided the evidence as soon as possible` IS asap
    `the evidence is from a person acting in an official capacity` IS official
    `the evidence demonstrates that the claimant's circumstances are consistent with those of a person who has had domestic violence inflicted or threatened against them during the period of 6 months ending on the date of the notification` IS consistent
    `the evidence demonstrates that the claimant has made contact with the person acting in an official capacity in relation to such an incident, which occurred during that period` IS contact

-- The facts of a claimant who notified on 1 July 2026 of violence on 1 May 2026 by a partner, who sent evidence on 20 July 2026.
`test — a good notification` MEANS `test — notification` (YearMonthDay 2026 7 1) TRUE TRUE (YearMonthDay 2026 5 1) TRUE FALSE NOTHING FALSE (JUST (YearMonthDay 2026 7 20)) TRUE TRUE TRUE TRUE

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 93.
#ASSERT `reg 93 — the interview has a purpose of a work-focused interview` (LIST `assessing the claimant's prospects for remaining in or obtaining paid work`)
#ASSERT `reg 93 — the interview has a purpose of a work-focused interview` (LIST `ascertaining whether a claimant is in gainful self-employment or meets the conditions in regulation 63 (start-up period)`, `assisting or encouraging the claimant to remain in or obtain paid work`)
#ASSERT NOT (`reg 93 — the interview has a purpose of a work-focused interview` EMPTY)

-- Regulation 94: treated as not having complied where the claimant fails to participate in an interview offered in connection with the vacancy.
#ASSERT `reg 94 — the claimant is treated as not having complied with a work search requirement to apply for a vacancy` TRUE TRUE
#ASSERT NOT (`reg 94 — the claimant is treated as not having complied with a work search requirement to apply for a vacancy` TRUE FALSE)
#ASSERT NOT (`reg 94 — the claimant is treated as not having complied with a work search requirement to apply for a vacancy` FALSE TRUE)

-- Regulation 95(4): voluntary work preparation.
#ASSERT `reg 95(4) — voluntary work preparation` TRUE TRUE TRUE FALSE
#ASSERT NOT (`reg 95(4) — voluntary work preparation` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 95(4) — voluntary work preparation` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`reg 95(4) — voluntary work preparation` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`reg 95(4) — voluntary work preparation` TRUE TRUE FALSE FALSE)

-- Regulation 95(2) and (3): relevant deductions. Paid work 4, voluntary work 10, work preparation 3, voluntary work preparation 2, temporary
-- circumstances 5: 4 + 10 + 3 + 2 + 5 = 24 (voluntary work 10 is below half of 35 hours, 17.5).
#ASSERT `reg 95(2) and (3) — the relevant deductions` 4 10 3 2 5 35 EQUALS 24
-- Voluntary work 20 hours is capped at half of 35: 17.5. 4 + 17.5 + 3 + 2 + 5 = 31.5.
#ASSERT `reg 95(2) and (3) — the relevant deductions` 4 20 3 2 5 35 EQUALS 31.5
-- The cap is half of the expected hours: expected 20, voluntary 12 counts as 10.
#ASSERT `reg 95(2) and (3) — the relevant deductions` 0 12 0 0 0 20 EQUALS 10
#ASSERT `reg 95(2) and (3) — the relevant deductions` 0 0 0 0 0 35 EQUALS 0

-- Regulation 95(1): all reasonable action. Not complied unless (time at least expected minus deductions, or satisfied) and best prospects.
#ASSERT NOT (`reg 95(1) — the claimant is treated as not having complied with the work search requirement to take all reasonable action` 35 35 0 FALSE TRUE)
#ASSERT `reg 95(1) — the claimant is treated as not having complied with the work search requirement to take all reasonable action` 34.9 35 0 FALSE TRUE
-- The Secretary of State's satisfaction makes up the shortfall.
#ASSERT NOT (`reg 95(1) — the claimant is treated as not having complied with the work search requirement to take all reasonable action` 20 35 0 TRUE TRUE)
-- Deductions lower the hours needed: expected 35 minus deductions 15 is 20.
#ASSERT NOT (`reg 95(1) — the claimant is treated as not having complied with the work search requirement to take all reasonable action` 20 35 15 FALSE TRUE)
#ASSERT `reg 95(1) — the claimant is treated as not having complied with the work search requirement to take all reasonable action` 19.99 35 15 FALSE TRUE
-- Without the best prospects the claimant is treated as not having complied, however many hours.
#ASSERT `reg 95(1) — the claimant is treated as not having complied with the work search requirement to take all reasonable action` 40 35 0 TRUE FALSE

-- Regulation 96(3): a responsible carer or relevant carer; the Secretary of State satisfied; able and willing on notice.
#ASSERT `reg 96(3) — this paragraph applies to a carer` TRUE TRUE TRUE
#ASSERT NOT (`reg 96(3) — this paragraph applies to a carer` FALSE TRUE TRUE)
#ASSERT NOT (`reg 96(3) — this paragraph applies to a carer` TRUE FALSE TRUE)
#ASSERT NOT (`reg 96(3) — this paragraph applies to a carer` TRUE TRUE FALSE)
-- Regulation 96(4): voluntary work.
#ASSERT `reg 96(4) — this paragraph applies to a claimant doing voluntary work` TRUE TRUE TRUE
#ASSERT NOT (`reg 96(4) — this paragraph applies to a claimant doing voluntary work` FALSE TRUE TRUE)
#ASSERT NOT (`reg 96(4) — this paragraph applies to a claimant doing voluntary work` TRUE FALSE TRUE)
#ASSERT NOT (`reg 96(4) — this paragraph applies to a claimant doing voluntary work` TRUE TRUE FALSE)
-- Regulation 96(5): a notice period.
#ASSERT `reg 96(5) — this paragraph applies to a claimant working out a notice period` TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 96(5) — this paragraph applies to a claimant working out a notice period` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 96(5) — this paragraph applies to a claimant working out a notice period` TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 96(5) — this paragraph applies to a claimant working out a notice period` TRUE TRUE FALSE TRUE)
#ASSERT NOT (`reg 96(5) — this paragraph applies to a claimant working out a notice period` TRUE TRUE TRUE FALSE)
-- Regulation 96(2): paragraph (3), (4) or (5).
#ASSERT `reg 96(2) — the claimant is treated as having complied despite not being able immediately to take up paid work` TRUE FALSE FALSE
#ASSERT `reg 96(2) — the claimant is treated as having complied despite not being able immediately to take up paid work` FALSE TRUE FALSE
#ASSERT `reg 96(2) — the claimant is treated as having complied despite not being able immediately to take up paid work` FALSE FALSE TRUE
#ASSERT NOT (`reg 96(2) — the claimant is treated as having complied despite not being able immediately to take up paid work` FALSE FALSE FALSE)
-- Regulation 96(1): treated as not having complied if not able and willing immediately to attend an interview, unless paragraph (2) applies.
#ASSERT `reg 96(1) — the claimant is treated as not having complied with a work availability requirement` FALSE FALSE
#ASSERT NOT (`reg 96(1) — the claimant is treated as not having complied with a work availability requirement` TRUE FALSE)
#ASSERT NOT (`reg 96(1) — the claimant is treated as not having complied with a work availability requirement` FALSE TRUE)
#ASSERT NOT (`reg 96(1) — the claimant is treated as not having complied with a work availability requirement` TRUE TRUE)

-- Regulation 97(2): the hours limit, for a relevant carer, a responsible carer or a claimant with an impairment.
#ASSERT `reg 97(2) — the hours to which a work search and work availability requirement must be limited` TRUE FALSE FALSE 25 EQUALS JUST 25
#ASSERT `reg 97(2) — the hours to which a work search and work availability requirement must be limited` FALSE TRUE FALSE 16 EQUALS JUST 16
#ASSERT `reg 97(2) — the hours to which a work search and work availability requirement must be limited` FALSE FALSE TRUE 20 EQUALS JUST 20
-- Any other claimant: paragraph (2) sets no limit (not covered).
#ASSERT `reg 97(2) — the hours to which a work search and work availability requirement must be limited` FALSE FALSE FALSE 35 EQUALS NOTHING

-- Regulation 97(3): 90 minutes each way.
#ASSERT `reg 97(3) — the location is within the travelling limit` 90 90
#ASSERT NOT (`reg 97(3) — the location is within the travelling limit` 91 90)
#ASSERT NOT (`reg 97(3) — the location is within the travelling limit` 90 91)
#ASSERT `reg 97(3) — the location is within the travelling limit` 0 0

-- Regulation 97(4) and (5): date of claim 2 March 2026, no later cessation of paid work, the Secretary of State considers 14 days appropriate.
#ASSERT `reg 97(4) and (5) — the work must be of a similar nature or remuneration` TRUE TRUE (YearMonthDay 2026 3 2) NOTHING 14 (YearMonthDay 2026 3 2)
#ASSERT `reg 97(4) and (5) — the work must be of a similar nature or remuneration` TRUE TRUE (YearMonthDay 2026 3 2) NOTHING 14 (YearMonthDay 2026 3 15)
#ASSERT NOT (`reg 97(4) and (5) — the work must be of a similar nature or remuneration` TRUE TRUE (YearMonthDay 2026 3 2) NOTHING 14 (YearMonthDay 2026 3 16))
-- Before the date of claim.
#ASSERT NOT (`reg 97(4) and (5) — the work must be of a similar nature or remuneration` TRUE TRUE (YearMonthDay 2026 3 2) NOTHING 14 (YearMonthDay 2026 3 1))
-- A period of 60 days is cut to 4 weeks: 28 days from 2 March are 2 March to 29 March.
#ASSERT `reg 97(4) and (5) — the work must be of a similar nature or remuneration` TRUE TRUE (YearMonthDay 2026 3 2) NOTHING 60 (YearMonthDay 2026 3 29)
#ASSERT NOT (`reg 97(4) and (5) — the work must be of a similar nature or remuneration` TRUE TRUE (YearMonthDay 2026 3 2) NOTHING 60 (YearMonthDay 2026 3 30))
-- If the claimant ceases paid work later (10 April 2026), the period begins on that later date.
#ASSERT NOT (`reg 97(4) and (5) — the work must be of a similar nature or remuneration` TRUE TRUE (YearMonthDay 2026 3 2) (JUST (YearMonthDay 2026 4 10)) 14 (YearMonthDay 2026 3 20))
#ASSERT `reg 97(4) and (5) — the work must be of a similar nature or remuneration` TRUE TRUE (YearMonthDay 2026 3 2) (JUST (YearMonthDay 2026 4 10)) 14 (YearMonthDay 2026 4 10)
-- If the cessation was before the date of claim, the date of claim governs.
#ASSERT `reg 97(4) and (5) — the work must be of a similar nature or remuneration` TRUE TRUE (YearMonthDay 2026 3 2) (JUST (YearMonthDay 2026 2 1)) 14 (YearMonthDay 2026 3 2)
-- No previous work of a particular nature, or no satisfaction about reasonable prospects.
#ASSERT NOT (`reg 97(4) and (5) — the work must be of a similar nature or remuneration` FALSE TRUE (YearMonthDay 2026 3 2) NOTHING 14 (YearMonthDay 2026 3 2))
#ASSERT NOT (`reg 97(4) and (5) — the work must be of a similar nature or remuneration` TRUE FALSE (YearMonthDay 2026 3 2) NOTHING 14 (YearMonthDay 2026 3 2))

-- Regulation 97(6).
#ASSERT `reg 97(6) — a work search or work availability requirement must not relate to the work` TRUE TRUE
#ASSERT NOT (`reg 97(6) — a work search or work availability requirement must not relate to the work` TRUE FALSE)
#ASSERT NOT (`reg 97(6) — a work search or work availability requirement must not relate to the work` FALSE TRUE)

