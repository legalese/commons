-- Regulation 40(1): determined under this Part, or limited capability for work related activity under Part 5 of the ESA Regulations, or treated (paragraph (5), Schedule 9).
`test — no Schedule 9 circumstance` MEANS `Sch 9 circumstances` WITH
    `paragraph 1 facts` IS Illness WITH
        `suffering from a progressive disease` IS FALSE
        `months within which death in consequence of that disease can reasonably be expected` IS 0
    `paragraph 2 facts` IS `Sch 9 para 2 pregnancy facts` WITH
        `a pregnant woman` IS FALSE
        `there is a serious risk of damage to her health or to the health of her unborn child if she does not refrain from work and work-related activity` IS FALSE
    `paragraph 3 facts` IS `Sch 9 para 3 cancer treatment facts` WITH
        `receiving treatment for cancer by way of chemotherapy or radiotherapy` IS FALSE
        `likely to receive such treatment within 6 months after the date of the determination of capability for work and work-related activity` IS FALSE
        `recovering from such treatment` IS FALSE
        `the Secretary of State is satisfied that the claimant should be treated as having limited capability for work and work-related activity` IS FALSE
    `paragraph 4 facts` IS `Sch 9 para 4 risk facts` WITH
        `suffering from a specific illness, disease or disablement` IS FALSE
        `by reason of it there would be a substantial risk to the physical or mental health of any person were the claimant found not to have limited capability for work and work-related activity` IS FALSE
    `paragraph 5 facts` IS `Sch 9 para 5 facts` WITH
        `reached the qualifying age for state pension credit` IS FALSE
        `entitled to` IS EMPTY
        `entitled to the care component of disability living allowance at the highest rate` IS FALSE
        `entitled to the care component of Scottish adult disability living allowance at the highest rate in accordance with regulation 6(4) of the Disability Assistance (Scottish Adult Disability Living Allowance) Regulations 2025` IS FALSE
        `entitled to the daily living component of personal independence payment at the enhanced rate` IS FALSE
        `entitled to the daily living component of adult disability payment at the enhanced rate in accordance with regulation 5(3) of the Disability Assistance for Working Age People (Scotland) Regulations 2022` IS FALSE

`test — Schedule 9 paragraph 1 applies` MEANS `Sch 9 circumstances` WITH
    `paragraph 1 facts` IS Illness WITH
        `suffering from a progressive disease` IS TRUE
        `months within which death in consequence of that disease can reasonably be expected` IS 12
    `paragraph 2 facts` IS `test — no Schedule 9 circumstance`'s `paragraph 2 facts`
    `paragraph 3 facts` IS `test — no Schedule 9 circumstance`'s `paragraph 3 facts`
    `paragraph 4 facts` IS `test — no Schedule 9 circumstance`'s `paragraph 4 facts`
    `paragraph 5 facts` IS `test — no Schedule 9 circumstance`'s `paragraph 5 facts`

#ASSERT `reg 40(1) — limited capability for work and work-related activity` TRUE FALSE `test — no Schedule 9 circumstance`
#ASSERT `reg 40(1) — limited capability for work and work-related activity` FALSE TRUE `test — no Schedule 9 circumstance`
#ASSERT NOT (`reg 40(1) — limited capability for work and work-related activity` FALSE FALSE `test — no Schedule 9 circumstance`)
#ASSERT `reg 40(1) — limited capability for work and work-related activity` FALSE FALSE `test — Schedule 9 paragraph 1 applies`

