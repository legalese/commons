#ASSERT `reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 constant and lifelong and diagnosed` TRUE TRUE
#ASSERT `reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 constant and lifelong and diagnosed, in Scotland` TRUE TRUE
#ASSERT `reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 constant and lifelong and diagnosed, in Wales` TRUE TRUE
#ASSERT `reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 constant and lifelong and diagnosed, in Northern Ireland` TRUE TRUE
#ASSERT NOT (`reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 constant and lifelong and diagnosed, privately` TRUE TRUE)
#ASSERT NOT (`reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 constant and lifelong, not diagnosed` TRUE TRUE)
#ASSERT NOT (`reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 constant and diagnosed, not lifelong` TRUE TRUE)
#ASSERT NOT (`reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 lifelong and diagnosed, not constant` TRUE TRUE)
#ASSERT NOT (`reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 constant and diagnosed, not for the rest of life` TRUE TRUE)
-- A registered nurse is a health care professional (regulation 2); an unregistered person is not; an unqualified one is not "appropriately qualified".
#ASSERT `reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 diagnosed by a nurse` TRUE TRUE
#ASSERT NOT (`reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 diagnosed by someone who is not a health care professional` TRUE TRUE)
#ASSERT NOT (`reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 diagnosed by a professional who is not appropriately qualified` TRUE TRUE)
-- Limb (a): limited capability for work and work-related activity on the basis of an assessment must also be established.
#ASSERT NOT (`reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 constant and lifelong and diagnosed` FALSE TRUE)
#ASSERT NOT (`reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 2 constant and lifelong and diagnosed` TRUE FALSE)
-- A mental descriptor needs a lifelong, diagnosed mental illness; a bodily one does not do.
#ASSERT `reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 9 constant and lifelong and diagnosed, mental` TRUE TRUE
#ASSERT NOT (`reg 40A(2) — severe conditions criteria claimant on the basis of an assessment under this Part` `fixture A: 9 mental but the lifelong disease is bodily` TRUE TRUE)
-- Direct: the descriptor test of paragraphs (2)(b) and (4).
#ASSERT `reg 40A(2)(b) and (4) — the descriptor constantly applies and will do so for the rest of the claimant's life` `Sch 7 descriptor 2` `fixture A: 2 constant and lifelong and diagnosed`
#ASSERT NOT (`reg 40A(2)(b) and (4) — the descriptor constantly applies and will do so for the rest of the claimant's life` `Sch 7 descriptor 3` `fixture A: 2 constant and lifelong and diagnosed`)
