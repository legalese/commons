-- Regulation 40(4) and (3): a descriptor applies if it applies for the majority of the time or occasions and the incapability arises as paragraph (3) requires.
#ASSERT `reg 40(4) — the descriptor applies` `Sch 7 descriptor 2` `fixture 7: 2, majority, bodily cause`
#ASSERT `reg 40(4) — the descriptor applies` `Sch 7 descriptor 2` `fixture 7: 2, majority, treatment for a physical disease`
#ASSERT NOT (`reg 40(4) — the descriptor applies` `Sch 7 descriptor 2` `fixture 7: 2, majority, no cause`)
#ASSERT NOT (`reg 40(4) — the descriptor applies` `Sch 7 descriptor 2` `fixture 7: 2, not the majority, bodily cause`)
#ASSERT `reg 40(4) — the descriptor applies` `Sch 7 descriptor 9` `fixture 7: 9, majority, mental cause`
#ASSERT `reg 40(4) — the descriptor applies` `Sch 7 descriptor 9` `fixture 7: 9, majority, treatment for a mental illness`
#ASSERT NOT (`reg 40(4) — the descriptor applies` `Sch 7 descriptor 9` `fixture 7: 9, majority, bodily cause only`)
#ASSERT `reg 40(4) — the descriptor applies` `Sch 7 descriptor 15(a)` `fixture 7: 15(a), majority, bodily cause`
#ASSERT NOT (`reg 40(4) — the descriptor applies` `Sch 7 descriptor 15(c)` `fixture 7: 15(c), majority, bodily cause only`)
#ASSERT `reg 40(4) — the descriptor applies` `Sch 7 descriptor 15(c)` `fixture 7: 15(c), majority, mental cause`

-- Regulation 40(2): (a) a descriptor applies, (b) capability is limited, (c) the limitation is such that it is not reasonable to require the claimant to undertake the activity.
#ASSERT `reg 40(2) — limited capability for work and work-related activity on the basis of an assessment under this Part` `fixture 7: 2, majority, bodily cause` TRUE TRUE
#ASSERT NOT (`reg 40(2) — limited capability for work and work-related activity on the basis of an assessment under this Part` `fixture 7: 2, majority, bodily cause` FALSE TRUE)
#ASSERT NOT (`reg 40(2) — limited capability for work and work-related activity on the basis of an assessment under this Part` `fixture 7: 2, majority, bodily cause` TRUE FALSE)
#ASSERT NOT (`reg 40(2) — limited capability for work and work-related activity on the basis of an assessment under this Part` `fixture 7: 2, majority, no cause` TRUE TRUE)
#ASSERT NOT (`reg 40(2) — limited capability for work and work-related activity on the basis of an assessment under this Part` `fixture 7: nothing applies` TRUE TRUE)
#ASSERT `reg 40(2) — limited capability for work and work-related activity on the basis of an assessment under this Part` `fixture 7: 9, majority, mental cause` TRUE TRUE

