-- 15 points in Part 1 by one descriptor (limb (a)).
#ASSERT `reg 39(3) — limited capability for work on the basis of the points scored` `fixture: 1(a)`
-- 15 points in Part 1 by two descriptors, 9 + 6.
#ASSERT `reg 39(3) — limited capability for work on the basis of the points scored` `fixture: 1(b) and 2(c)`
-- 12 points in Part 1 (6 + 6): below the threshold. (No combination of these descriptors scores 13 or 14.)
#ASSERT NOT (`reg 39(3) — limited capability for work on the basis of the points scored` `fixture: 2(c) and 3(c)`)
-- Regulation 39(5): 1(c) scores 9 and 1(d) scores 6, but only the highest is counted: 9, not 15.
#ASSERT NOT (`reg 39(3) — limited capability for work on the basis of the points scored` `fixture: 1(c) and 1(d)`)
-- 15 points in Part 2 (limb (b)).
#ASSERT `reg 39(3) — limited capability for work on the basis of the points scored` `fixture: 11(c) and 12(b)`
-- 9 in Part 1 and 6 in Part 2: 15 only by the combination, limb (c).
#ASSERT `reg 39(3) — limited capability for work on the basis of the points scored` `fixture: 3(b) and 11(c)`
-- 6 in Part 1 and 6 in Part 2: 12, below the threshold.
#ASSERT NOT (`reg 39(3) — limited capability for work on the basis of the points scored` `fixture: 2(c) and 11(c)`)
-- 9 in Part 1 and 9 in Part 2: 18, above the threshold.
#ASSERT `reg 39(3) — limited capability for work on the basis of the points scored` `fixture: 3(b) and 11(b)`
-- Without the required cause nothing is counted (regulation 39(4)).
#ASSERT NOT (`reg 39(3) — limited capability for work on the basis of the points scored` `fixture: 1(a) with no cause`)
#ASSERT NOT (`reg 39(3) — limited capability for work on the basis of the points scored` `fixture: no descriptor`)
-- Regulations 39(2) to (5) together.
#ASSERT `reg 39(2) to (5) — limited capability for work on the basis of an assessment under this Part` TRUE `fixture: 1(a)`
#ASSERT NOT (`reg 39(2) to (5) — limited capability for work on the basis of an assessment under this Part` FALSE `fixture: 1(a)`)
#ASSERT NOT (`reg 39(2) to (5) — limited capability for work on the basis of an assessment under this Part` TRUE `fixture: 2(c) and 3(c)`)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 40(3): which descriptors need a bodily cause and which a mental one.
#ASSERT `reg 40(3)(a) — the descriptor is one of descriptors 1 to 8, 15(a), 15(b), 16(a) and 16(b)` `Sch 7 descriptor 1`
#ASSERT `reg 40(3)(a) — the descriptor is one of descriptors 1 to 8, 15(a), 15(b), 16(a) and 16(b)` `Sch 7 descriptor 8`
#ASSERT `reg 40(3)(a) — the descriptor is one of descriptors 1 to 8, 15(a), 15(b), 16(a) and 16(b)` `Sch 7 descriptor 15(b)`
#ASSERT `reg 40(3)(a) — the descriptor is one of descriptors 1 to 8, 15(a), 15(b), 16(a) and 16(b)` `Sch 7 descriptor 16(a)`
#ASSERT NOT (`reg 40(3)(a) — the descriptor is one of descriptors 1 to 8, 15(a), 15(b), 16(a) and 16(b)` `Sch 7 descriptor 9`)
#ASSERT NOT (`reg 40(3)(a) — the descriptor is one of descriptors 1 to 8, 15(a), 15(b), 16(a) and 16(b)` `Sch 7 descriptor 15(c)`)
#ASSERT `reg 40(3)(b) — the descriptor is one of descriptors 9 to 14, 15(c), 15(d), 16(c) and 16(d)` `Sch 7 descriptor 9`
#ASSERT `reg 40(3)(b) — the descriptor is one of descriptors 9 to 14, 15(c), 15(d), 16(c) and 16(d)` `Sch 7 descriptor 14`
#ASSERT `reg 40(3)(b) — the descriptor is one of descriptors 9 to 14, 15(c), 15(d), 16(c) and 16(d)` `Sch 7 descriptor 15(d)`
#ASSERT `reg 40(3)(b) — the descriptor is one of descriptors 9 to 14, 15(c), 15(d), 16(c) and 16(d)` `Sch 7 descriptor 16(c)`
#ASSERT NOT (`reg 40(3)(b) — the descriptor is one of descriptors 9 to 14, 15(c), 15(d), 16(c) and 16(d)` `Sch 7 descriptor 8`)
#ASSERT NOT (`reg 40(3)(b) — the descriptor is one of descriptors 9 to 14, 15(c), 15(d), 16(c) and 16(d)` `Sch 7 descriptor 16(b)`)
-- The two groups together cover the 22 descriptors, 12 and 10, and no descriptor is in both.
#ASSERT count (filter (GIVEN d YIELD `reg 40(3)(a) — the descriptor is one of descriptors 1 to 8, 15(a), 15(b), 16(a) and 16(b)` d) `reg 40(2)(a) — the descriptors of Schedule 7`) EQUALS 12
#ASSERT count (filter (GIVEN d YIELD `reg 40(3)(b) — the descriptor is one of descriptors 9 to 14, 15(c), 15(d), 16(c) and 16(d)` d) `reg 40(2)(a) — the descriptors of Schedule 7`) EQUALS 10
#ASSERT count `reg 40(2)(a) — the descriptors of Schedule 7` EQUALS 22
#ASSERT all (GIVEN d YIELD NOT ((`reg 40(3)(a) — the descriptor is one of descriptors 1 to 8, 15(a), 15(b), 16(a) and 16(b)` d) AND (`reg 40(3)(b) — the descriptor is one of descriptors 9 to 14, 15(c), 15(d), 16(c) and 16(d)` d))) `reg 40(2)(a) — the descriptors of Schedule 7`

