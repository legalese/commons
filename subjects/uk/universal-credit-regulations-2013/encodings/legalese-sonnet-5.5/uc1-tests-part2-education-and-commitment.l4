IMPORT prelude
IMPORT `uc-core`
IMPORT `uc1-common`
IMPORT `uc1-part2-education-and-commitment`

-- Tests of uc1-part2-education-and-commitment.l4 (regulations 12 to 16). Every expected value is written by hand from the text of
-- the regulation named in the comment beside it, and none was copied from the output of the rule.

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 12(1B): traineeship. A course beginning 1 January 2025 and ending on 1 July 2025 lasts no more than 6 months.
GIVEN funded IS A BOOLEAN
      first IS A DATE
      last IS A DATE
      training IS A BOOLEAN
      open IS A BOOLEAN
GIVETH A `Course that may be a traineeship`
`test — course` funded first last training open MEANS
    `Course that may be a traineeship` WITH
        `the course is funded in whole or in part by, or under arrangements made by, the Secretary of State under section 14 of the Education Act 2002 or the Chief Executive of Education and Skills Funding` IS funded
        `first day of the course` IS first
        `last day of the course` IS last
        `the course includes training to help prepare the participant for work and a work experience placement` IS training
        `the course is open to persons who on the first day of the course have reached the age of 16 but not 25` IS open
#ASSERT `reg 12(1B) — the course is a traineeship` (`test — course` TRUE (YMD 2025 1 1) (YMD 2025 7 1) TRUE TRUE)
#ASSERT NOT (`reg 12(1B) — the course is a traineeship` (`test — course` TRUE (YMD 2025 1 1) (YMD 2025 7 2) TRUE TRUE))
#ASSERT NOT (`reg 12(1B) — the course is a traineeship` (`test — course` FALSE (YMD 2025 1 1) (YMD 2025 3 1) TRUE TRUE))
#ASSERT NOT (`reg 12(1B) — the course is a traineeship` (`test — course` TRUE (YMD 2025 1 1) (YMD 2025 3 1) FALSE TRUE))
#ASSERT NOT (`reg 12(1B) — the course is a traineeship` (`test — course` TRUE (YMD 2025 1 1) (YMD 2025 3 1) TRUE FALSE))

-- (1B) relevant training scheme: a traineeship, or all three of the limbs of (b).
#ASSERT `reg 12(1B) — the person is participating in a relevant training scheme` TRUE FALSE FALSE FALSE
#ASSERT `reg 12(1B) — the person is participating in a relevant training scheme` FALSE TRUE TRUE TRUE
#ASSERT NOT (`reg 12(1B) — the person is participating in a relevant training scheme` FALSE TRUE TRUE FALSE)
#ASSERT NOT (`reg 12(1B) — the person is participating in a relevant training scheme` FALSE TRUE FALSE TRUE)
#ASSERT NOT (`reg 12(1B) — the person is participating in a relevant training scheme` FALSE FALSE TRUE TRUE)

-- (3) course of advanced education.
GIVEN postgraduate IS A BOOLEAN
      first IS A BOOLEAN
      diploma IS A BOOLEAN
      national IS A BOOLEAN
      above IS A BOOLEAN
GIVETH A `Course that may be a course of advanced education`
`test — advanced course` postgraduate first diploma national above MEANS
    `Course that may be a course of advanced education` WITH
        `the course leads to a postgraduate degree or comparable qualification` IS postgraduate
        `the course leads to a first degree or comparable qualification` IS first
        `the course leads to a diploma of higher education` IS diploma
        `the course leads to a higher national diploma` IS national
        `the course is of a standard above advanced GNVQ or equivalent, including above a general certificate of education (advanced level) or above a Scottish national qualification (higher or advanced higher)` IS above
#ASSERT `reg 12(3) — the course is a course of advanced education` (`test — advanced course` TRUE FALSE FALSE FALSE FALSE)
#ASSERT `reg 12(3) — the course is a course of advanced education` (`test — advanced course` FALSE TRUE FALSE FALSE FALSE)
#ASSERT `reg 12(3) — the course is a course of advanced education` (`test — advanced course` FALSE FALSE TRUE FALSE FALSE)
#ASSERT `reg 12(3) — the course is a course of advanced education` (`test — advanced course` FALSE FALSE FALSE TRUE FALSE)
#ASSERT `reg 12(3) — the course is a course of advanced education` (`test — advanced course` FALSE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`reg 12(3) — the course is a course of advanced education` (`test — advanced course` FALSE FALSE FALSE FALSE FALSE))

-- Regulation 12: receiving education. Arguments: a qualifying young person; in a relevant training scheme; advanced full-time course;
-- other full-time course with a student loan or grant; course not compatible with a work-related requirement.
#ASSERT `reg 12 — the person is receiving education` TRUE FALSE FALSE FALSE FALSE
#ASSERT NOT (`reg 12 — the person is receiving education` TRUE TRUE FALSE FALSE FALSE)
#ASSERT NOT (`reg 12 — the person is receiving education` TRUE TRUE TRUE TRUE TRUE)
#ASSERT `reg 12 — the person is receiving education` FALSE FALSE TRUE FALSE FALSE
#ASSERT `reg 12 — the person is receiving education` FALSE FALSE FALSE TRUE FALSE
#ASSERT `reg 12 — the person is receiving education` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`reg 12 — the person is receiving education` FALSE FALSE FALSE FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 13: undertaking a course.
GIVEN modular IS A BOOLEAN
      start IS A DATE
      last IS A DATE
      abandoned IS A MAYBE DATE
      retaking IS A LIST OF `Period of days`
      vacations IS A LIST OF `Vacation during a course`
GIVETH A `Course that a person may be undertaking`
`test — course undertaken` modular start last abandoned retaking vacations MEANS
    `Course that a person may be undertaking` WITH
        `the course is a modular course` IS modular
        `day on which the person starts undertaking the course, or the part of the modular course` IS start
        `last day of the course or, for a part of a modular course, last day on which the person is registered as undertaking that part` IS last
        `day on which the person finally abandons the course or is dismissed from it` IS abandoned
        `periods in which the person undertakes the course to retake examinations or to complete a module after failing` IS retaking
        `vacations` IS vacations
`a period from 1 May to 15 May 2025` MEANS `Period of days` WITH `first day` IS YMD 2025 5 1, `last day` IS YMD 2025 5 15
`a vacation from 1 to 7 February 2025` MEANS `Vacation during a course` WITH
    `period of the vacation` IS `Period of days` WITH `first day` IS YMD 2025 2 1, `last day` IS YMD 2025 2 7
    `the vacation is immediately after the last day on which the person is to attend or undertake the final module in the course that the person has registered to attend or undertake` IS FALSE
`a vacation from 1 to 14 April 2025 after the last day of the part` MEANS `Vacation during a course` WITH
    `period of the vacation` IS `Period of days` WITH `first day` IS YMD 2025 4 1, `last day` IS YMD 2025 4 14
    `the vacation is immediately after the last day on which the person is to attend or undertake the final module in the course that the person has registered to attend or undertake` IS FALSE
`a vacation from 1 to 14 April 2025 after the final module` MEANS `Vacation during a course` WITH
    `period of the vacation` IS `Period of days` WITH `first day` IS YMD 2025 4 1, `last day` IS YMD 2025 4 14
    `the vacation is immediately after the last day on which the person is to attend or undertake the final module in the course that the person has registered to attend or undertake` IS TRUE
`a vacation from 1 to 14 May 2025 not adjoining the part` MEANS `Vacation during a course` WITH
    `period of the vacation` IS `Period of days` WITH `first day` IS YMD 2025 5 1, `last day` IS YMD 2025 5 14
    `the vacation is immediately after the last day on which the person is to attend or undertake the final module in the course that the person has registered to attend or undertake` IS FALSE
-- A course from 1 September 2024 to 30 June 2025.
`a course from 1 September 2024 to 30 June 2025` MEANS `test — course undertaken` FALSE (YMD 2024 9 1) (YMD 2025 6 30) NOTHING EMPTY EMPTY
`that course abandoned on 15 December 2024` MEANS `test — course undertaken` FALSE (YMD 2024 9 1) (YMD 2025 6 30) (JUST (YMD 2024 12 15)) EMPTY EMPTY
`that course with a dismissal date after its last day` MEANS `test — course undertaken` FALSE (YMD 2024 9 1) (YMD 2025 6 30) (JUST (YMD 2025 8 1)) EMPTY EMPTY
#ASSERT NOT (`reg 13(1) — the day falls within the period of the course or part` `a course from 1 September 2024 to 30 June 2025` (YMD 2024 8 31))
#ASSERT `reg 13(1) — the day falls within the period of the course or part` `a course from 1 September 2024 to 30 June 2025` (YMD 2024 9 1)
#ASSERT `reg 13(1) — the day falls within the period of the course or part` `a course from 1 September 2024 to 30 June 2025` (YMD 2025 6 30)
#ASSERT NOT (`reg 13(1) — the day falls within the period of the course or part` `a course from 1 September 2024 to 30 June 2025` (YMD 2025 7 1))
#ASSERT `reg 13(1) — the day falls within the period of the course or part` `that course abandoned on 15 December 2024` (YMD 2024 12 15)
#ASSERT NOT (`reg 13(1) — the day falls within the period of the course or part` `that course abandoned on 15 December 2024` (YMD 2024 12 16))
-- An abandonment after the last day does not extend the course.
#ASSERT `reg 13(1) — the last day of the period of the course or part` `that course with a dismissal date after its last day` EQUALS YMD 2025 6 30
#ASSERT `reg 13(1) — the last day of the period of the course or part` `that course abandoned on 15 December 2024` EQUALS YMD 2024 12 15
-- A modular course: the part begins 1 January 2025 and the registration ends 31 March 2025.
`a modular course part from 1 January to 31 March 2025 with retaking and vacations` MEANS `test — course undertaken` TRUE (YMD 2025 1 1) (YMD 2025 3 31) NOTHING (LIST `a period from 1 May to 15 May 2025`) (LIST `a vacation from 1 to 7 February 2025`, `a vacation from 1 to 14 April 2025 after the last day of the part`, `a vacation from 1 to 14 May 2025 not adjoining the part`)
`a modular course part where the vacation follows the final module` MEANS `test — course undertaken` TRUE (YMD 2025 1 1) (YMD 2025 3 31) NOTHING EMPTY (LIST `a vacation from 1 to 14 April 2025 after the final module`)
`a course that is not modular with the same retaking period` MEANS `test — course undertaken` FALSE (YMD 2025 1 1) (YMD 2025 3 31) NOTHING (LIST `a period from 1 May to 15 May 2025`) (LIST `a vacation from 1 to 7 February 2025`)
#ASSERT `reg 13(2)(a) — the day falls within a period of retaking or completing` `a modular course part from 1 January to 31 March 2025 with retaking and vacations` (YMD 2025 5 10)
#ASSERT NOT (`reg 13(2)(a) — the day falls within a period of retaking or completing` `a modular course part from 1 January to 31 March 2025 with retaking and vacations` (YMD 2025 5 16))
#ASSERT NOT (`reg 13(2)(a) — the day falls within a period of retaking or completing` `a course that is not modular with the same retaking period` (YMD 2025 5 10))
#ASSERT `reg 13(2)(b) — the day falls within a vacation that the period includes` `a modular course part from 1 January to 31 March 2025 with retaking and vacations` (YMD 2025 2 3)
-- A vacation immediately following the period (starting 1 April, the day after 31 March) is included.
#ASSERT `reg 13(2)(b) — the day falls within a vacation that the period includes` `a modular course part from 1 January to 31 March 2025 with retaking and vacations` (YMD 2025 4 5)
-- ... but not one that follows the final module the person registered for.
#ASSERT NOT (`reg 13(2)(b) — the day falls within a vacation that the period includes` `a modular course part where the vacation follows the final module` (YMD 2025 4 5))
-- A vacation that neither lies within the period nor adjoins it is not included.
#ASSERT NOT (`reg 13(2)(b) — the day falls within a vacation that the period includes` `a modular course part from 1 January to 31 March 2025 with retaking and vacations` (YMD 2025 5 5))
#ASSERT NOT (`reg 13(2)(b) — the day falls within a vacation that the period includes` `a course that is not modular with the same retaking period` (YMD 2025 2 3))

-- (4) An interruption by illness or caring, from a recovery on 1 March 2025.
GIVEN consent IS A BOOLEAN
      recovered IS A MAYBE DATE
      resumed IS A MAYBE DATE
      eligible IS A BOOLEAN
GIVETH AN `Interruption of a course`
`test — interruption` consent recovered resumed eligible MEANS
    `Interruption of a course` WITH
        `the person has, with the consent of the relevant educational establishment, ceased to attend or undertake the course because they are ill or caring for another person` IS consent
        `day on which the person recovered from that illness or ceased caring for that person` IS recovered
        `day on which the person resumed the course` IS resumed
        `the person is eligible for a grant or student loan` IS eligible
#ASSERT `reg 13(4) — the person is not regarded as undertaking the course on the day` (`test — interruption` TRUE (JUST (YMD 2025 3 1)) NOTHING FALSE) (YMD 2025 3 1)
#ASSERT NOT (`reg 13(4) — the person is not regarded as undertaking the course on the day` (`test — interruption` TRUE (JUST (YMD 2025 3 1)) NOTHING FALSE) (YMD 2025 2 28))
-- The past year runs through 28 February 2026.
#ASSERT `reg 13(4) — the person is not regarded as undertaking the course on the day` (`test — interruption` TRUE (JUST (YMD 2025 3 1)) NOTHING FALSE) (YMD 2026 2 28)
#ASSERT NOT (`reg 13(4) — the person is not regarded as undertaking the course on the day` (`test — interruption` TRUE (JUST (YMD 2025 3 1)) NOTHING FALSE) (YMD 2026 3 1))
-- Resumed on 1 June 2025.
#ASSERT `reg 13(4) — the person is not regarded as undertaking the course on the day` (`test — interruption` TRUE (JUST (YMD 2025 3 1)) (JUST (YMD 2025 6 1)) FALSE) (YMD 2025 5 31)
#ASSERT NOT (`reg 13(4) — the person is not regarded as undertaking the course on the day` (`test — interruption` TRUE (JUST (YMD 2025 3 1)) (JUST (YMD 2025 6 1)) FALSE) (YMD 2025 6 1))
-- Eligible for a grant or loan, no consent, or not yet recovered.
#ASSERT NOT (`reg 13(4) — the person is not regarded as undertaking the course on the day` (`test — interruption` TRUE (JUST (YMD 2025 3 1)) NOTHING TRUE) (YMD 2025 3 1))
#ASSERT NOT (`reg 13(4) — the person is not regarded as undertaking the course on the day` (`test — interruption` FALSE (JUST (YMD 2025 3 1)) NOTHING FALSE) (YMD 2025 3 1))
#ASSERT NOT (`reg 13(4) — the person is not regarded as undertaking the course on the day` (`test — interruption` TRUE NOTHING NOTHING FALSE) (YMD 2025 3 1))

-- Regulation 13 as a whole.
#ASSERT `reg 13 — the person is regarded as undertaking the course on the day` TRUE FALSE FALSE FALSE
#ASSERT `reg 13 — the person is regarded as undertaking the course on the day` FALSE TRUE FALSE FALSE
#ASSERT `reg 13 — the person is regarded as undertaking the course on the day` FALSE FALSE TRUE FALSE
#ASSERT NOT (`reg 13 — the person is regarded as undertaking the course on the day` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 13 — the person is regarded as undertaking the course on the day` FALSE FALSE FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 14(1)(a): born 1 June 2005, so 20 on 31 May 2026, 21 on 1 June 2026 and 22 on 1 June 2027.
#ASSERT `reg 14(1)(a) — the person is on a full-time course, under 21, without parental support` TRUE (YMD 2005 6 1) (YMD 2026 5 31) FALSE TRUE
#ASSERT `reg 14(1)(a) — the person is on a full-time course, under 21, without parental support` TRUE (YMD 2005 6 1) (YMD 2026 6 1) TRUE TRUE
#ASSERT NOT (`reg 14(1)(a) — the person is on a full-time course, under 21, without parental support` TRUE (YMD 2005 6 1) (YMD 2026 6 1) FALSE TRUE)
#ASSERT NOT (`reg 14(1)(a) — the person is on a full-time course, under 21, without parental support` TRUE (YMD 2005 6 1) (YMD 2027 6 1) TRUE TRUE)
#ASSERT NOT (`reg 14(1)(a) — the person is on a full-time course, under 21, without parental support` TRUE (YMD 2005 6 1) (YMD 2026 5 31) FALSE FALSE)
#ASSERT NOT (`reg 14(1)(a) — the person is on a full-time course, under 21, without parental support` FALSE (YMD 2005 6 1) (YMD 2026 5 31) FALSE TRUE)

-- (1)(b): one of the seven benefits and a prior finding of limited capability for work.
#ASSERT `reg 14(1)(b) — the person is entitled to a disability benefit and was found to have limited capability for work` (LIST `personal independence payment`) TRUE FALSE
#ASSERT `reg 14(1)(b) — the person is entitled to a disability benefit and was found to have limited capability for work` (LIST `personal independence payment`) FALSE TRUE
#ASSERT NOT (`reg 14(1)(b) — the person is entitled to a disability benefit and was found to have limited capability for work` (LIST `personal independence payment`) FALSE FALSE)
#ASSERT NOT (`reg 14(1)(b) — the person is entitled to a disability benefit and was found to have limited capability for work` (LIST `carer's allowance`) TRUE TRUE)
#ASSERT NOT (`reg 14(1)(b) — the person is entitled to a disability benefit and was found to have limited capability for work` EMPTY TRUE TRUE)
#ASSERT `reg 14(1)(b) — the person is entitled to a disability benefit and was found to have limited capability for work` (LIST `attendance allowance`) TRUE FALSE
#ASSERT `reg 14(1)(b) — the person is entitled to a disability benefit and was found to have limited capability for work` (LIST `pension age disability payment`) TRUE FALSE
#ASSERT `reg 14(1)(b) — the person is entitled to a disability benefit and was found to have limited capability for work` (LIST `disability living allowance`) TRUE FALSE
#ASSERT `reg 14(1)(b) — the person is entitled to a disability benefit and was found to have limited capability for work` (LIST `Scottish adult disability living allowance`) TRUE FALSE
#ASSERT `reg 14(1)(b) — the person is entitled to a disability benefit and was found to have limited capability for work` (LIST `child disability payment`) TRUE FALSE
#ASSERT `reg 14(1)(b) — the person is entitled to a disability benefit and was found to have limited capability for work` (LIST `adult disability payment`) TRUE FALSE

-- (1)(e): both receiving education and the other responsible for a child or a foster parent.
#ASSERT `reg 14(1)(e) — both members of the couple are receiving education and the other is responsible for a child or is a foster parent` TRUE TRUE FALSE
#ASSERT `reg 14(1)(e) — both members of the couple are receiving education and the other is responsible for a child or is a foster parent` TRUE FALSE TRUE
#ASSERT NOT (`reg 14(1)(e) — both members of the couple are receiving education and the other is responsible for a child or is a foster parent` TRUE FALSE FALSE)
#ASSERT NOT (`reg 14(1)(e) — both members of the couple are receiving education and the other is responsible for a child or is a foster parent` FALSE TRUE TRUE)

-- (1): any limb.
#ASSERT `reg 14(1) — the person is excepted from the basic condition in section 4(1)(d)` TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 14(1) — the person is excepted from the basic condition in section 4(1)(d)` FALSE TRUE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 14(1) — the person is excepted from the basic condition in section 4(1)(d)` FALSE FALSE TRUE FALSE FALSE FALSE FALSE
#ASSERT `reg 14(1) — the person is excepted from the basic condition in section 4(1)(d)` FALSE FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT `reg 14(1) — the person is excepted from the basic condition in section 4(1)(d)` FALSE FALSE FALSE FALSE TRUE FALSE FALSE
#ASSERT `reg 14(1) — the person is excepted from the basic condition in section 4(1)(d)` FALSE FALSE FALSE FALSE FALSE TRUE TRUE
-- (f) needs both: the person has reached the qualifying age and the other member has not.
#ASSERT NOT (`reg 14(1) — the person is excepted from the basic condition in section 4(1)(d)` FALSE FALSE FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`reg 14(1) — the person is excepted from the basic condition in section 4(1)(d)` FALSE FALSE FALSE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`reg 14(1) — the person is excepted from the basic condition in section 4(1)(d)` FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 15(1) and (3): claim period beginning 1 March 2025, acceptance required by 15 March 2025.
#ASSERT `reg 15(1) — the day on which the claimant commitment is treated as accepted` (YMD 2025 3 1) (JUST (YMD 2025 3 15)) (YMD 2025 3 15) NOTHING EQUALS JUST (YMD 2025 3 1)
#ASSERT `reg 15(1) — the day on which the claimant commitment is treated as accepted` (YMD 2025 3 1) (JUST (YMD 2025 3 16)) (YMD 2025 3 15) NOTHING EQUALS NOTHING
-- Extended by the Secretary of State to 31 March 2025.
#ASSERT `reg 15(1) — the day on which the claimant commitment is treated as accepted` (YMD 2025 3 1) (JUST (YMD 2025 3 16)) (YMD 2025 3 15) (JUST (YMD 2025 3 31)) EQUALS JUST (YMD 2025 3 1)
#ASSERT `reg 15(1) — the day on which the claimant commitment is treated as accepted` (YMD 2025 3 1) (JUST (YMD 2025 4 1)) (YMD 2025 3 15) (JUST (YMD 2025 3 31)) EQUALS NOTHING
-- An "extension" to an earlier day does not shorten the period.
#ASSERT `reg 15(1) — the day on which the claimant commitment is treated as accepted` (YMD 2025 3 1) (JUST (YMD 2025 3 12)) (YMD 2025 3 15) (JUST (YMD 2025 3 10)) EQUALS JUST (YMD 2025 3 1)
-- Never accepted.
#ASSERT `reg 15(1) — the day on which the claimant commitment is treated as accepted` (YMD 2025 3 1) NOTHING (YMD 2025 3 15) NOTHING EQUALS NOTHING

-- (2): where an award may be made without a claim, the first day of the first assessment period is 5 April 2025.
#ASSERT `reg 15(2) — the day on which the claimant commitment is treated as accepted where an award may be made without a claim` (YMD 2025 4 5) (JUST (YMD 2025 4 10)) (YMD 2025 4 15) EQUALS JUST (YMD 2025 4 5)
#ASSERT `reg 15(2) — the day on which the claimant commitment is treated as accepted where an award may be made without a claim` (YMD 2025 4 5) (JUST (YMD 2025 4 16)) (YMD 2025 4 15) EQUALS NOTHING
#ASSERT `reg 15(2) — the day on which the claimant commitment is treated as accepted where an award may be made without a claim` (YMD 2025 4 5) NOTHING (YMD 2025 4 15) EQUALS NOTHING

-- (4): the method.
#ASSERT `reg 15(4) — the claimant commitment was accepted by the method the Secretary of State specified` `electronically` `electronically`
#ASSERT `reg 15(4) — the claimant commitment was accepted by the method the Secretary of State specified` `by telephone` `by telephone`
#ASSERT `reg 15(4) — the claimant commitment was accepted by the method the Secretary of State specified` `in writing` `in writing`
#ASSERT NOT (`reg 15(4) — the claimant commitment was accepted by the method the Secretary of State specified` `by telephone` `in writing`)
#ASSERT NOT (`reg 15(4) — the claimant commitment was accepted by the method the Secretary of State specified` `electronically` `by telephone`)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 16.
#ASSERT `reg 16 — the person does not have to meet the basic condition to have accepted a claimant commitment` TRUE FALSE FALSE
#ASSERT `reg 16 — the person does not have to meet the basic condition to have accepted a claimant commitment` FALSE TRUE FALSE
#ASSERT `reg 16 — the person does not have to meet the basic condition to have accepted a claimant commitment` FALSE FALSE TRUE
#ASSERT NOT (`reg 16 — the person does not have to meet the basic condition to have accepted a claimant commitment` FALSE FALSE FALSE)
