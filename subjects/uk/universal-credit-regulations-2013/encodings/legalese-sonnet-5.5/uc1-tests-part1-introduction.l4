IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-persons`
IMPORT `uc1-common`
IMPORT `uc1-part1-introduction`

-- Tests of uc1-part1-introduction.l4 (the title block, regulation 1 and regulations 3 to 6(2)). Every expected value is written by
-- hand from the text of the regulation named in the comment beside it, and none was copied from the output of the rule.

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 1: the dates.
#ASSERT `reg 1 — the day on which these Regulations were made` EQUALS YearMonthDay 2013 2 25
#ASSERT `reg 1 — the day on which these Regulations come into force` EQUALS YearMonthDay 2013 4 29
#ASSERT NOT (`reg 1 — these Regulations are in force on a day` (YearMonthDay 2013 4 28))
#ASSERT `reg 1 — these Regulations are in force on a day` (YearMonthDay 2013 4 29)
#ASSERT `reg 1 — these Regulations are in force on a day` (YearMonthDay 2026 7 16)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 3(2): a couple may be entitled as joint claimants despite a basic condition.
GIVEN age IS A BOOLEAN
      education IS A BOOLEAN
      excepted IS A BOOLEAN
GIVETH A `Member of a couple and the basic conditions of section 4(1)(b) and (d)`
`test — member` age education excepted MEANS
    `Member of a couple and the basic conditions of section 4(1)(b) and (d)` WITH
        `meets the basic condition in section 4(1)(b), under the qualifying age for state pension credit` IS age
        `meets the basic condition in section 4(1)(d), not receiving education` IS education
        `is excepted from the basic condition in section 4(1)(d) by regulation 14` IS excepted
`a member who meets both conditions` MEANS `test — member` TRUE TRUE FALSE
`a member over the qualifying age` MEANS `test — member` FALSE TRUE FALSE
`a member receiving education who is not excepted` MEANS `test — member` TRUE FALSE FALSE
`a member receiving education who is excepted` MEANS `test — member` TRUE FALSE TRUE
`a member over the qualifying age and receiving education` MEANS `test — member` FALSE FALSE FALSE
-- (a): one member over the qualifying age if the other is not.
#ASSERT `reg 3(2) — a couple may be entitled as joint claimants despite a basic condition` `a member over the qualifying age` `a member who meets both conditions`
#ASSERT `reg 3(2) — a couple may be entitled as joint claimants despite a basic condition` `a member who meets both conditions` `a member over the qualifying age`
#ASSERT NOT (`reg 3(2)(a) — one member does not meet the age condition and the other does` `a member over the qualifying age and receiving education` `a member over the qualifying age`)
-- (b): one member receiving education who is not excepted, if the other is not receiving it or is excepted.
#ASSERT `reg 3(2) — a couple may be entitled as joint claimants despite a basic condition` `a member receiving education who is not excepted` `a member who meets both conditions`
#ASSERT `reg 3(2) — a couple may be entitled as joint claimants despite a basic condition` `a member who meets both conditions` `a member receiving education who is not excepted`
#ASSERT `reg 3(2) — a couple may be entitled as joint claimants despite a basic condition` `a member receiving education who is not excepted` `a member receiving education who is excepted`
-- Both receiving education and neither excepted: not covered by (b).
#ASSERT NOT (`reg 3(2) — a couple may be entitled as joint claimants despite a basic condition` `a member receiving education who is not excepted` `a member receiving education who is not excepted`)
-- The member receiving education is excepted, so does not fail the condition: nothing in (a) or (b) applies.
#ASSERT NOT (`reg 3(2) — a couple may be entitled as joint claimants despite a basic condition` `a member receiving education who is excepted` `a member who meets both conditions`)
-- Both over the qualifying age: (a) needs the other to meet the age condition.
#ASSERT NOT (`reg 3(2) — a couple may be entitled as joint claimants despite a basic condition` `a member over the qualifying age` `a member over the qualifying age`)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 3(3): a member of a couple may claim as a single person.
GIVEN adult IS A BOOLEAN
      minimum IS A BOOLEAN
      inGB IS A BOOLEAN
      prisoner IS A BOOLEAN
      reg19 IS A BOOLEAN
      asylum IS A BOOLEAN
GIVETH AN `Other member of a couple and the basic conditions of section 4(1)(a) and (c)`
`test — other member` adult minimum inGB prisoner reg19 asylum MEANS
    `Other member of a couple and the basic conditions of section 4(1)(a) and (c)` WITH
        `meets the basic condition in section 4(1)(a), at least 18 years old` IS adult
        `is a person in respect of whom the minimum age specified in regulation 8 applies` IS minimum
        `meets the basic condition in section 4(1)(c), in Great Britain` IS inGB
        `is a prisoner` IS prisoner
        `is a person in respect of whom entitlement does not arise by virtue of regulation 19` IS reg19
        `is a person to whom section 115 of the Immigration and Asylum Act 1999 applies` IS asylum
-- No limb: an adult in Great Britain, free, entitled, not excluded.
#ASSERT NOT (`reg 3(3) — a member of a couple may make a claim as a single person` (`test — other member` TRUE FALSE TRUE FALSE FALSE FALSE))
-- (a) under 18 and not within regulation 8's minimum age.
#ASSERT `reg 3(3) — a member of a couple may make a claim as a single person` (`test — other member` FALSE FALSE TRUE FALSE FALSE FALSE)
-- Under 18 but regulation 8's minimum age applies (a 16 year old): not (a).
#ASSERT NOT (`reg 3(3) — a member of a couple may make a claim as a single person` (`test — other member` FALSE TRUE TRUE FALSE FALSE FALSE))
-- (b) not in Great Britain.
#ASSERT `reg 3(3) — a member of a couple may make a claim as a single person` (`test — other member` TRUE FALSE FALSE FALSE FALSE FALSE)
-- (c) a prisoner.
#ASSERT `reg 3(3) — a member of a couple may make a claim as a single person` (`test — other member` TRUE FALSE TRUE TRUE FALSE FALSE)
-- (d) a person other than a prisoner for whom entitlement does not arise by virtue of regulation 19.
#ASSERT `reg 3(3) — a member of a couple may make a claim as a single person` (`test — other member` TRUE FALSE TRUE FALSE TRUE FALSE)
-- (e) section 115 of the Immigration and Asylum Act 1999.
#ASSERT `reg 3(3) — a member of a couple may make a claim as a single person` (`test — other member` TRUE FALSE TRUE FALSE FALSE TRUE)

-- Regulation 3(4) and (5): polygamous marriages.
#ASSERT `reg 3(5) — a polygamous marriage` TRUE TRUE
#ASSERT NOT (`reg 3(5) — a polygamous marriage` TRUE FALSE)
#ASSERT NOT (`reg 3(5) — a polygamous marriage` FALSE TRUE)
#ASSERT `reg 3(4) — the fact that they are husband and wife is disregarded` TRUE TRUE TRUE
#ASSERT NOT (`reg 3(4) — the fact that they are husband and wife is disregarded` FALSE TRUE TRUE)
#ASSERT NOT (`reg 3(4) — the fact that they are husband and wife is disregarded` TRUE FALSE TRUE)
#ASSERT NOT (`reg 3(4) — the fact that they are husband and wife is disregarded` TRUE TRUE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 3(6) and 4(7): absences, counted from 1 January 2025 (fork F-ABS: an absence ending on the day N months after it began
-- does not exceed N months).
GIVEN lasted IS A DATE
      expected IS A DATE
GIVETH AN `Absence that is measured against a limit`
`test — absence from 1 January 2025` lasted expected MEANS
    `Absence that is measured against a limit` WITH
        `first day of the absence` IS YearMonthDay 2025 1 1
        `day to which the absence has lasted` IS lasted
        `expected last day of the absence` IS expected
`an absence expected to end on 1 July 2025` MEANS `test — absence from 1 January 2025` (YearMonthDay 2025 1 10) (YearMonthDay 2025 7 1)
`an absence expected to end on 2 July 2025` MEANS `test — absence from 1 January 2025` (YearMonthDay 2025 1 10) (YearMonthDay 2025 7 2)
`an absence that has lasted to 2 July 2025` MEANS `test — absence from 1 January 2025` (YearMonthDay 2025 7 2) (YearMonthDay 2025 1 10)
`an absence expected to end on 1 February 2025` MEANS `test — absence from 1 January 2025` (YearMonthDay 2025 1 10) (YearMonthDay 2025 2 1)
`an absence expected to end on 2 February 2025` MEANS `test — absence from 1 January 2025` (YearMonthDay 2025 1 10) (YearMonthDay 2025 2 2)
#ASSERT NOT (`reg 3(6) — the members of a couple cease to be treated as a couple` `an absence expected to end on 1 July 2025`)
#ASSERT `reg 3(6) — the members of a couple cease to be treated as a couple` `an absence expected to end on 2 July 2025`
#ASSERT `reg 3(6) — the members of a couple cease to be treated as a couple` `an absence that has lasted to 2 July 2025`
#ASSERT NOT (`reg 3(6) — the members of a couple cease to be treated as a couple` `an absence expected to end on 2 February 2025`)

-- The basis on which a person claims (fork F-3-BASIS).
#ASSERT `reg 3 — the basis on which the person claims` FALSE FALSE FALSE FALSE EQUALS JUST `a single claimant`
#ASSERT `reg 3 — the basis on which the person claims` FALSE TRUE TRUE TRUE EQUALS JUST `a single claimant`
#ASSERT `reg 3 — the basis on which the person claims` TRUE TRUE FALSE FALSE EQUALS JUST `a single claimant who is a member of a couple`
#ASSERT `reg 3 — the basis on which the person claims` TRUE TRUE TRUE FALSE EQUALS JUST `a single claimant who is a member of a couple`
#ASSERT `reg 3 — the basis on which the person claims` TRUE FALSE TRUE FALSE EQUALS JUST `joint claimants`
#ASSERT `reg 3 — the basis on which the person claims` TRUE FALSE FALSE TRUE EQUALS JUST `joint claimants`
#ASSERT `reg 3 — the basis on which the person claims` TRUE FALSE FALSE FALSE EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 4(6): not the responsibility of any person.
#ASSERT `reg 4(6) — the child or qualifying young person is treated as not being the responsibility of any person` TRUE FALSE FALSE
-- A period that regulation 4A excludes is not one in which the child is looked after for this purpose.
#ASSERT NOT (`reg 4(6) — the child or qualifying young person is treated as not being the responsibility of any person` TRUE TRUE FALSE)
#ASSERT `reg 4(6) — the child or qualifying young person is treated as not being the responsibility of any person` FALSE FALSE TRUE
#ASSERT `reg 4(6) — the child or qualifying young person is treated as not being the responsibility of any person` TRUE TRUE TRUE
#ASSERT NOT (`reg 4(6) — the child or qualifying young person is treated as not being the responsibility of any person` FALSE FALSE FALSE)

-- Regulation 4(7): temporary absence of the child or young person, from 1 January 2025.
-- Six months: an absence to 1 July does not exceed; to 2 July does. One month from Great Britain: to 1 February does not; to 2 February does.
#ASSERT `reg 4(7) — the person ceases to be responsible because of a temporary absence` `an absence expected to end on 2 July 2025` FALSE FALSE
#ASSERT NOT (`reg 4(7) — the person ceases to be responsible because of a temporary absence` `an absence expected to end on 1 July 2025` FALSE FALSE)
#ASSERT `reg 4(7) — the person ceases to be responsible because of a temporary absence` `an absence expected to end on 2 February 2025` TRUE FALSE
#ASSERT NOT (`reg 4(7) — the person ceases to be responsible because of a temporary absence` `an absence expected to end on 1 February 2025` TRUE FALSE)
-- Not from Great Britain: only the six months applies.
#ASSERT NOT (`reg 4(7) — the person ceases to be responsible because of a temporary absence` `an absence expected to end on 2 February 2025` FALSE FALSE)
-- From Great Britain for more than one month, but in circumstances where regulation 11(2) or (3) would disregard a longer absence.
#ASSERT NOT (`reg 4(7) — the person ceases to be responsible because of a temporary absence` `an absence expected to end on 2 February 2025` TRUE TRUE)
-- ... which does not help once the absence passes six months.
#ASSERT `reg 4(7) — the person ceases to be responsible because of a temporary absence` `an absence expected to end on 2 July 2025` TRUE TRUE

-- Regulation 4(2) to (5).
GIVEN lives IS A BOOLEAN
      young IS A BOOLEAN
      couple IS A BOOLEAN
      several IS A BOOLEAN
      main IS A BOOLEAN
GIVETH A `Child or qualifying young person and the person who may be responsible`
`test — household` lives young couple several main MEANS
    `Child or qualifying young person and the person who may be responsible` WITH
        `the child or qualifying young person normally lives with the person` IS lives
        `the child or qualifying young person is a qualifying young person` IS young
        `the person and the qualifying young person are living as a couple` IS couple
        `the child or qualifying young person normally lives with two or more persons who are not a couple` IS several
        `the person has the main responsibility, by nomination under paragraph (5) or by the Secretary of State's determination` IS main
#ASSERT `reg 4(2) to (5) — the person is responsible for the child or qualifying young person apart from paragraphs (6) and (7)` (`test — household` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`reg 4(2) to (5) — the person is responsible for the child or qualifying young person apart from paragraphs (6) and (7)` (`test — household` FALSE FALSE FALSE FALSE FALSE))
-- (3) A qualifying young person living with the person as a couple.
#ASSERT NOT (`reg 4(2) to (5) — the person is responsible for the child or qualifying young person apart from paragraphs (6) and (7)` (`test — household` TRUE TRUE TRUE FALSE FALSE))
-- ... but a child (not a qualifying young person) cannot be living as a couple with the person for this purpose.
#ASSERT `reg 4(2) to (5) — the person is responsible for the child or qualifying young person apart from paragraphs (6) and (7)` (`test — household` TRUE FALSE TRUE FALSE FALSE)
#ASSERT `reg 4(2) to (5) — the person is responsible for the child or qualifying young person apart from paragraphs (6) and (7)` (`test — household` TRUE TRUE FALSE FALSE FALSE)
-- (4) and (5) Two or more persons who are not a couple: only the one with the main responsibility.
#ASSERT NOT (`reg 4(2) to (5) — the person is responsible for the child or qualifying young person apart from paragraphs (6) and (7)` (`test — household` TRUE FALSE FALSE TRUE FALSE))
#ASSERT `reg 4(2) to (5) — the person is responsible for the child or qualifying young person apart from paragraphs (6) and (7)` (`test — household` TRUE FALSE FALSE TRUE TRUE)

-- Regulation 4 as a whole.
#ASSERT `reg 4 — the person is responsible for the child or qualifying young person` TRUE FALSE FALSE
#ASSERT NOT (`reg 4 — the person is responsible for the child or qualifying young person` TRUE TRUE FALSE)
#ASSERT NOT (`reg 4 — the person is responsible for the child or qualifying young person` TRUE FALSE TRUE)
#ASSERT NOT (`reg 4 — the person is responsible for the child or qualifying young person` FALSE FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 4A(2): parental responsibility.
#ASSERT `reg 4A(2) — the person has parental responsibility` England FALSE TRUE FALSE
#ASSERT `reg 4A(2) — the person has parental responsibility` Wales FALSE TRUE FALSE
#ASSERT NOT (`reg 4A(2) — the person has parental responsibility` England FALSE FALSE TRUE)
#ASSERT NOT (`reg 4A(2) — the person has parental responsibility` England TRUE TRUE FALSE)
#ASSERT `reg 4A(2) — the person has parental responsibility` Scotland FALSE FALSE TRUE
#ASSERT NOT (`reg 4A(2) — the person has parental responsibility` Scotland FALSE TRUE FALSE)
#ASSERT NOT (`reg 4A(2) — the person has parental responsibility` Scotland TRUE FALSE TRUE)

-- Regulation 4A(1): the periods excluded from regulation 4(6)(a).
#ASSERT `reg 4A(1) — the period is excluded from regulation 4(6)(a)` TRUE FALSE FALSE FALSE
#ASSERT `reg 4A(1) — the period is excluded from regulation 4(6)(a)` FALSE TRUE FALSE FALSE
#ASSERT `reg 4A(1) — the period is excluded from regulation 4(6)(a)` FALSE FALSE TRUE FALSE
#ASSERT `reg 4A(1) — the period is excluded from regulation 4(6)(a)` FALSE FALSE FALSE TRUE
#ASSERT NOT (`reg 4A(1) — the period is excluded from regulation 4(6)(a)` FALSE FALSE FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 5: qualifying young person. Born 15 May 2009: 16 on 15 May 2025, 19 on 15 May 2028, 20 on 15 May 2029.
GIVEN born IS A DATE
      enrolled IS A BOOLEAN
      advanced IS A BOOLEAN
      school IS A BOOLEAN
      hours IS A NUMBER
      started IS A BOOLEAN
      contract IS A BOOLEAN
      credit IS A BOOLEAN
      receiving IS A LIST OF Benefit
GIVETH A `Young person and the education or training`
`test — young person` born enrolled advanced school hours started contract credit receiving MEANS
    `Young person and the education or training` WITH
        `date of birth` IS born
        `the person is enrolled on, or accepted for, approved training or a course of education` IS enrolled
        `the course is a course of advanced education` IS advanced
        `the course is provided at a school or college, or elsewhere but approved by the Secretary of State` IS school
        `the average time spent during term time in tuition, practical work, supervised study or examinations` IS hours
        `the person started the education or training, or was enrolled on or accepted for it, before reaching the age of 19` IS started
        `the education or training is provided by means of a contract of employment` IS contract
        `the person is receiving universal credit` IS credit
        `the person is receiving` IS receiving
`a young person with no course` MEANS `test — young person` (YearMonthDay 2009 5 15) FALSE FALSE FALSE 0 FALSE FALSE FALSE EMPTY
`a young person on a 13 hour course` MEANS `test — young person` (YearMonthDay 2009 5 15) TRUE FALSE TRUE 13 TRUE FALSE FALSE EMPTY
`a young person on a 12 hour course` MEANS `test — young person` (YearMonthDay 2009 5 15) TRUE FALSE TRUE 12 TRUE FALSE FALSE EMPTY
`a young person on a 12.5 hour course` MEANS `test — young person` (YearMonthDay 2009 5 15) TRUE FALSE TRUE 12.5 TRUE FALSE FALSE EMPTY
`a young person on an advanced course` MEANS `test — young person` (YearMonthDay 2009 5 15) TRUE TRUE TRUE 13 TRUE FALSE FALSE EMPTY
`a young person on a course elsewhere that is not approved` MEANS `test — young person` (YearMonthDay 2009 5 15) TRUE FALSE FALSE 13 TRUE FALSE FALSE EMPTY
`a young person on a course under a contract of employment` MEANS `test — young person` (YearMonthDay 2009 5 15) TRUE FALSE TRUE 13 TRUE TRUE FALSE EMPTY
`a young person who started the course only after turning 19` MEANS `test — young person` (YearMonthDay 2009 5 15) TRUE FALSE TRUE 13 FALSE FALSE FALSE EMPTY
`a young person receiving universal credit` MEANS `test — young person` (YearMonthDay 2009 5 15) FALSE FALSE FALSE 0 FALSE FALSE TRUE EMPTY
`a young person receiving an employment and support allowance` MEANS `test — young person` (YearMonthDay 2009 5 15) FALSE FALSE FALSE 0 FALSE FALSE FALSE (LIST `employment and support allowance`)
`a young person receiving a jobseeker's allowance` MEANS `test — young person` (YearMonthDay 2009 5 15) FALSE FALSE FALSE 0 FALSE FALSE FALSE (LIST `jobseeker's allowance`)
`a young person receiving a carer's allowance` MEANS `test — young person` (YearMonthDay 2009 5 15) FALSE FALSE FALSE 0 FALSE FALSE FALSE (LIST `carer's allowance`)
`a young person born on 1 September 2008 on a 13 hour course` MEANS `test — young person` (YearMonthDay 2008 9 1) TRUE FALSE TRUE 13 TRUE FALSE FALSE EMPTY
-- (1)(a) Up to, but not including, the 1st September following the 16th birthday (1 September 2025); not before reaching 16.
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person with no course` (YearMonthDay 2025 5 14))
#ASSERT `reg 5 — the person is a qualifying young person on a day` `a young person with no course` (YearMonthDay 2025 5 15)
#ASSERT `reg 5 — the person is a qualifying young person on a day` `a young person with no course` (YearMonthDay 2025 8 31)
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person with no course` (YearMonthDay 2025 9 1))
-- (1)(b) With a course (13 hours, more than 12): up to but not including 1 September 2028.
#ASSERT `reg 5 — the person is a qualifying young person on a day` `a young person on a 13 hour course` (YearMonthDay 2025 9 1)
#ASSERT `reg 5 — the person is a qualifying young person on a day` `a young person on a 13 hour course` (YearMonthDay 2028 8 31)
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person on a 13 hour course` (YearMonthDay 2028 9 1))
-- Never at 20, even with a course: 15 May 2029 is the 20th birthday.
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person on a 13 hour course` (YearMonthDay 2029 5 15))
-- Born on 1 September 2008: the 1st September following the 19th birthday (1 September 2027) is 1 September 2028, the 20th birthday.
#ASSERT `reg 5 — the person is a qualifying young person on a day` `a young person born on 1 September 2008 on a 13 hour course` (YearMonthDay 2028 8 31)
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person born on 1 September 2008 on a 13 hour course` (YearMonthDay 2028 9 1))
-- (iii) More than 12 hours a week: 12 is not enough, 12.5 is.
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person on a 12 hour course` (YearMonthDay 2025 9 1))
#ASSERT `reg 5 — the person is a qualifying young person on a day` `a young person on a 12.5 hour course` (YearMonthDay 2025 9 1)
-- (i) not advanced education, (ii) at a school or college or approved by the Secretary of State.
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person on an advanced course` (YearMonthDay 2025 9 1))
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person on a course elsewhere that is not approved` (YearMonthDay 2025 9 1))
-- (3) A contract of employment.
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person on a course under a contract of employment` (YearMonthDay 2025 9 1))
-- (2) Aged 19: the course must have been started, or the person enrolled or accepted, before reaching 19.
#ASSERT `reg 5 — the person is a qualifying young person on a day` `a young person who started the course only after turning 19` (YearMonthDay 2027 9 1)
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person who started the course only after turning 19` (YearMonthDay 2028 5 15))
-- (5) Receiving universal credit, an employment and support allowance or a jobseeker's allowance.
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person receiving universal credit` (YearMonthDay 2025 5 15))
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person receiving an employment and support allowance` (YearMonthDay 2025 5 15))
#ASSERT NOT (`reg 5 — the person is a qualifying young person on a day` `a young person receiving a jobseeker's allowance` (YearMonthDay 2025 5 15))
#ASSERT `reg 5 — the person is a qualifying young person on a day` `a young person receiving a carer's allowance` (YearMonthDay 2025 5 15)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 6(2).
#ASSERT `reg 6(2) — regulation 6 applies to the calculation` FALSE
#ASSERT NOT (`reg 6(2) — regulation 6 applies to the calculation` TRUE)
