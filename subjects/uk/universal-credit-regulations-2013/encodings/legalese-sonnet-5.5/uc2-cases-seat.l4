#ASSERT NOT (`Is early years assistance I received disregarded` FALSE (YMD 2026 3 1) (YMD 2026 4 1))
-- 12 months
#ASSERT `Is funeral expense assistance I received disregarded` TRUE (YMD 2026 3 1) (YMD 2027 3 1)
#ASSERT NOT (`Is funeral expense assistance I received disregarded` TRUE (YMD 2026 3 1) (YMD 2027 3 2))
#ASSERT NOT (`Is funeral expense assistance I received disregarded` FALSE (YMD 2026 3 1) (YMD 2026 4 1))
-- 52 weeks from 1 March 2026 is 28 February 2027
#ASSERT `Is a young carer grant I received disregarded` TRUE (YMD 2026 3 1) (YMD 2027 2 28)
-- 52 weeks is shorter than 12 months by a day: 1 March 2027 is past it
#ASSERT NOT (`Is a young carer grant I received disregarded` TRUE (YMD 2026 3 1) (YMD 2027 3 1))
#ASSERT NOT (`Is a young carer grant I received disregarded` FALSE (YMD 2026 3 1) (YMD 2026 4 1))
#ASSERT `Is winter heating assistance I received disregarded` TRUE (YMD 2026 3 1) (YMD 2027 2 28)
#ASSERT NOT (`Is winter heating assistance I received disregarded` TRUE (YMD 2026 3 1) (YMD 2027 3 1))
#ASSERT NOT (`Is winter heating assistance I received disregarded` FALSE (YMD 2026 3 1) (YMD 2026 4 1))

§ `Questions added after the first pass of the seat`

-- reg 68(3): args = the rent amount in the grant, the other person's maintenance amount in the grant
#ASSERT `How much of my grant still counts when I have a student loan` 300 150 EQUALS 450
#ASSERT `How much of my grant still counts when I have a student loan` 300 0 EQUALS 300
-- the rest of the grant is disregarded
#ASSERT `How much of my grant still counts when I have a student loan` 0 0 EQUALS 0
-- reg 77(2): the holding is disregarded where reg 77(1) makes me the sole owner or a partner. args = analogous, trade, property business, intermediary income, that income from main employment
#ASSERT `Is the value of my holding in my company disregarded` TRUE TRUE FALSE FALSE FALSE
-- a property business
#ASSERT `Is the value of my holding in my company disregarded` TRUE FALSE TRUE FALSE FALSE
-- neither a trade nor a property business
#ASSERT NOT (`Is the value of my holding in my company disregarded` TRUE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`Is the value of my holding in my company disregarded` FALSE TRUE FALSE FALSE FALSE)
-- reg 77(5)
#ASSERT NOT (`Is the value of my holding in my company disregarded` TRUE TRUE FALSE TRUE TRUE)
-- reg 82(1): args = earned income, the rate, then the 31 of the grace-period day question, then the first and last day of the assessment period
-- (a): 900 is at least the threshold of 832
#ASSERT `Am I exempt from the benefit cap because of my earnings` 900 12 (YMD 2026 3 1) FALSE FALSE 0 12 FALSE FALSE 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 (YMD 2026 5 1) (YMD 2026 5 31)
-- below the threshold and no day on which a grace period may begin
#ASSERT NOT (`Am I exempt from the benefit cap because of my earnings` 500 12 (YMD 2026 3 1) FALSE FALSE 0 12 FALSE FALSE 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 (YMD 2026 3 1) (YMD 2026 3 31))
-- (b): a grace period begins on 1 March and runs to 30 November; May is within it
#ASSERT `Am I exempt from the benefit cap because of my earnings` 500 12 (YMD 2026 3 1) TRUE TRUE 500 12 FALSE FALSE 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 (YMD 2026 5 1) (YMD 2026 5 31)
-- (b): December is after the grace period
#ASSERT NOT (`Am I exempt from the benefit cap because of my earnings` 500 12 (YMD 2026 3 1) TRUE TRUE 500 12 FALSE FALSE 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 (YMD 2026 12 1) (YMD 2026 12 31))
-- (b): the grace period ends in this assessment period
#ASSERT `Am I exempt from the benefit cap because of my earnings` 500 12 (YMD 2026 3 1) TRUE TRUE 500 12 FALSE FALSE 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 (YMD 2026 11 15) (YMD 2026 12 14)
-- the candidate day is after the end of this period, so it is not a candidate (fork F-C5)
#ASSERT NOT (`Am I exempt from the benefit cap because of my earnings` 500 12 (YMD 2026 3 1) TRUE TRUE 500 12 FALSE FALSE 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 (YMD 2026 2 1) (YMD 2026 2 28))
-- (b) route (2)(b): the day after I stopped paid work, before this entitlement
#ASSERT `Am I exempt from the benefit cap because of my earnings` 500 12 (YMD 2026 3 1) FALSE FALSE 0 12 TRUE TRUE 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 (YMD 2026 3 1) (YMD 2026 3 31)
-- the 12-month condition fails in the fourth month
#ASSERT NOT (`Am I exempt from the benefit cap because of my earnings` 500 12 (YMD 2026 3 1) TRUE TRUE 500 12 FALSE FALSE 900 12 900 12 900 12 800 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 900 12 (YMD 2026 5 1) (YMD 2026 5 31))
