-- Q66. Conditions met on the normal payment date: the period would be nil days, which is 7 or less.
#ASSERT `Until what day will my hardship payment run` (YMD 2026 6 28) (YMD 2026 6 28) (YMD 2026 7 28) NOTHING EQUALS (YMD 2026 7 28)

-- Q67. 60% of 393 x 12 / 365 = 7.7523, to the penny: 7.75 (reg 118, fork F-118-1).
#ASSERT `How much is my hardship payment for each day` 393 EQUALS 7.75

-- Q67. 60% of 400 x 12 / 365 = 7.8904: 7.89.
#ASSERT `How much is my hardship payment for each day` 400 EQUALS 7.89

-- Q67. No reduction in the earlier period.
#ASSERT `How much is my hardship payment for each day` 0 EQUALS 0

-- Q68. None of paragraphs (2) and (3) applies: hardship payments are recoverable (reg 119(1)).
#ASSERT `Must I repay hardship payments for this assessment period` FALSE FALSE FALSE 0 NOTHING 0 0 EQUALS TRUE

-- Q68. Within section 19 by regulation 90 in this assessment period (reg 119(2)(a)).
#ASSERT `Must I repay hardship payments for this assessment period` TRUE FALSE FALSE 0 NOTHING 0 0 EQUALS FALSE

-- Q68. Regulation 90 applies to one joint claimant only and the combined earnings reach the individual threshold (reg 119(2)(b)).
#ASSERT `Must I repay hardship payments for this assessment period` FALSE TRUE FALSE 693 (JUST 693) 0 0 EQUALS FALSE

-- Q68. Combined earnings of 692.99 fall short of the threshold of 693.
#ASSERT `Must I repay hardship payments for this assessment period` FALSE TRUE FALSE 692.99 (JUST 693) 0 0 EQUALS TRUE

-- Q68. Regulation 90 applies to neither: earnings reach 16 hours at 10 an hour x 52 / 12 = 693.33 (reg 119(2)(c), reg 6(1)).
#ASSERT `Must I repay hardship payments for this assessment period` FALSE FALSE TRUE 693.33 NOTHING 10 0 EQUALS FALSE

-- Q68. 693.32 is a penny short.
#ASSERT `Must I repay hardship payments for this assessment period` FALSE FALSE TRUE 693.32 NOTHING 10 0 EQUALS TRUE

-- Q68. Five earlier assessment periods of the kind in paragraph (2): short of six months (reg 119(3)).
#ASSERT `Must I repay hardship payments for this assessment period` FALSE FALSE FALSE 0 NOTHING 0 5 EQUALS TRUE

-- Q68. Six earlier assessment periods: paragraph (1) has ceased to apply (reg 119(3)).
#ASSERT `Must I repay hardship payments for this assessment period` FALSE FALSE FALSE 0 NOTHING 0 6 EQUALS FALSE

-- Q68. This assessment period and five earlier ones: not recoverable (paragraph (2) now, and six in all under paragraph (3)).
#ASSERT `Must I repay hardship payments for this assessment period` TRUE FALSE FALSE 0 NOTHING 0 5 EQUALS FALSE
