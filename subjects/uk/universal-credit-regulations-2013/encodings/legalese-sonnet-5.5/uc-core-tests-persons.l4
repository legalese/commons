IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-persons`

-- Tests for uc-core-persons.l4. Expected values are written by hand from the text of regulation 2, not read from the encoding's output.

-- blind: certified as severely sight impaired or blind by a consultant ophthalmologist (line 26). Both elements are needed.
-- certified, by a consultant ophthalmologist
#ASSERT `reg 2 — blind` (`Sight certificate` WITH `certified as severely sight impaired or blind` IS TRUE, `certified by a consultant ophthalmologist` IS TRUE) EQUALS TRUE
-- certified, but not by a consultant ophthalmologist (for example by an optometrist)
#ASSERT `reg 2 — blind` (`Sight certificate` WITH `certified as severely sight impaired or blind` IS TRUE, `certified by a consultant ophthalmologist` IS FALSE) EQUALS FALSE
-- a consultant ophthalmologist did not certify the person as severely sight impaired or blind
#ASSERT `reg 2 — blind` (`Sight certificate` WITH `certified as severely sight impaired or blind` IS FALSE, `certified by a consultant ophthalmologist` IS TRUE) EQUALS FALSE
-- neither
#ASSERT `reg 2 — blind` (`Sight certificate` WITH `certified as severely sight impaired or blind` IS FALSE, `certified by a consultant ophthalmologist` IS FALSE) EQUALS FALSE

-- close relative (lines 34-36): limb (a) lists eleven relations; limb (b) adds the other member of a couple of which one member is listed.
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `a parent`, `relation of the partner to the person` IS `not a listed relation`) EQUALS TRUE
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `a parent-in-law`, `relation of the partner to the person` IS `not a listed relation`) EQUALS TRUE
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `a son`, `relation of the partner to the person` IS `not a listed relation`) EQUALS TRUE
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `a son-in-law`, `relation of the partner to the person` IS `not a listed relation`) EQUALS TRUE
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `a daughter`, `relation of the partner to the person` IS `not a listed relation`) EQUALS TRUE
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `a daughter-in-law`, `relation of the partner to the person` IS `not a listed relation`) EQUALS TRUE
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `a step-parent`, `relation of the partner to the person` IS `not a listed relation`) EQUALS TRUE
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `a step-son`, `relation of the partner to the person` IS `not a listed relation`) EQUALS TRUE
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `a step-daughter`, `relation of the partner to the person` IS `not a listed relation`) EQUALS TRUE
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `a brother`, `relation of the partner to the person` IS `not a listed relation`) EQUALS TRUE
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `a sister`, `relation of the partner to the person` IS `not a listed relation`) EQUALS TRUE
-- a brother's wife is not on the list herself, but her partner is a brother: limb (b)
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `not a listed relation`, `relation of the partner to the person` IS `a brother`) EQUALS TRUE
-- the partner of a parent-in-law, limb (b)
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `not a listed relation`, `relation of the partner to the person` IS `a parent-in-law`) EQUALS TRUE
-- an aunt, with no partner on the list, is not a close relative
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `not a listed relation`, `relation of the partner to the person` IS `not a listed relation`) EQUALS FALSE
-- a listed relation and a partner who is also listed
#ASSERT `reg 2 — close relative` (`Possible close relative` WITH `relation to the person` IS `a sister`, `relation of the partner to the person` IS `a brother`) EQUALS TRUE

-- foster parent (lines 48-51): placement under the placement regulations; in Scotland the person must also be a foster carer or kinship carer.
-- England, placed under the 2010 Regulations
#ASSERT `reg 2 — foster parent` (`Placement of a child with a person` WITH `nation in which the child is placed` IS England, `child is placed with the person under the placement regulations` IS TRUE, `person is a foster carer or a kinship carer` IS FALSE) EQUALS TRUE
-- England, not placed under them
#ASSERT `reg 2 — foster parent` (`Placement of a child with a person` WITH `nation in which the child is placed` IS England, `child is placed with the person under the placement regulations` IS FALSE, `person is a foster carer or a kinship carer` IS TRUE) EQUALS FALSE
-- Wales, placed under the 2015 Regulations
#ASSERT `reg 2 — foster parent` (`Placement of a child with a person` WITH `nation in which the child is placed` IS Wales, `child is placed with the person under the placement regulations` IS TRUE, `person is a foster carer or a kinship carer` IS FALSE) EQUALS TRUE
-- Wales, not placed under them
#ASSERT `reg 2 — foster parent` (`Placement of a child with a person` WITH `nation in which the child is placed` IS Wales, `child is placed with the person under the placement regulations` IS FALSE, `person is a foster carer or a kinship carer` IS FALSE) EQUALS FALSE
-- Scotland, placed and a foster carer or kinship carer
#ASSERT `reg 2 — foster parent` (`Placement of a child with a person` WITH `nation in which the child is placed` IS Scotland, `child is placed with the person under the placement regulations` IS TRUE, `person is a foster carer or a kinship carer` IS TRUE) EQUALS TRUE
-- Scotland, placed but not a foster carer or kinship carer
#ASSERT `reg 2 — foster parent` (`Placement of a child with a person` WITH `nation in which the child is placed` IS Scotland, `child is placed with the person under the placement regulations` IS TRUE, `person is a foster carer or a kinship carer` IS FALSE) EQUALS FALSE
-- Scotland, a carer but the child is not placed under the 2009 Regulations
#ASSERT `reg 2 — foster parent` (`Placement of a child with a person` WITH `nation in which the child is placed` IS Scotland, `child is placed with the person under the placement regulations` IS FALSE, `person is a foster carer or a kinship carer` IS TRUE) EQUALS FALSE

-- health care professional (lines 53-56): a registered medical practitioner; a registered nurse; or an occupational therapist or physiotherapist who is registered.
-- a registered medical practitioner
#ASSERT `reg 2 — health care professional` (`Practitioner` WITH `registered medical practitioner` IS TRUE, `registered nurse` IS FALSE, `occupational therapist or physiotherapist` IS FALSE, `registered with a regulatory body established under section 60 of the Health Act 1999` IS FALSE) EQUALS TRUE
-- a registered nurse
#ASSERT `reg 2 — health care professional` (`Practitioner` WITH `registered medical practitioner` IS FALSE, `registered nurse` IS TRUE, `occupational therapist or physiotherapist` IS FALSE, `registered with a regulatory body established under section 60 of the Health Act 1999` IS FALSE) EQUALS TRUE
-- a physiotherapist registered with the regulatory body
#ASSERT `reg 2 — health care professional` (`Practitioner` WITH `registered medical practitioner` IS FALSE, `registered nurse` IS FALSE, `occupational therapist or physiotherapist` IS TRUE, `registered with a regulatory body established under section 60 of the Health Act 1999` IS TRUE) EQUALS TRUE
-- a physiotherapist who is not registered with the regulatory body
#ASSERT `reg 2 — health care professional` (`Practitioner` WITH `registered medical practitioner` IS FALSE, `registered nurse` IS FALSE, `occupational therapist or physiotherapist` IS TRUE, `registered with a regulatory body established under section 60 of the Health Act 1999` IS FALSE) EQUALS FALSE
-- registered with the body but neither a therapist nor a physiotherapist
#ASSERT `reg 2 — health care professional` (`Practitioner` WITH `registered medical practitioner` IS FALSE, `registered nurse` IS FALSE, `occupational therapist or physiotherapist` IS FALSE, `registered with a regulatory body established under section 60 of the Health Act 1999` IS TRUE) EQUALS FALSE
-- none of the three
#ASSERT `reg 2 — health care professional` (`Practitioner` WITH `registered medical practitioner` IS FALSE, `registered nurse` IS FALSE, `occupational therapist or physiotherapist` IS FALSE, `registered with a regulatory body established under section 60 of the Health Act 1999` IS FALSE) EQUALS FALSE

-- looked after by a local authority (line 74): within the meaning of any of the three statutes.
-- England
#ASSERT `reg 2 — looked after by a local authority` (`Care of a child` WITH `looked after within the meaning of section 22 of the Children Act 1989` IS TRUE, `looked after within the meaning of section 17(6) of the Children (Scotland) Act 1995` IS FALSE, `looked after within the meaning of section 74 of the Social Services and Well-being (Wales) Act 2014` IS FALSE) EQUALS TRUE
-- Scotland
#ASSERT `reg 2 — looked after by a local authority` (`Care of a child` WITH `looked after within the meaning of section 22 of the Children Act 1989` IS FALSE, `looked after within the meaning of section 17(6) of the Children (Scotland) Act 1995` IS TRUE, `looked after within the meaning of section 74 of the Social Services and Well-being (Wales) Act 2014` IS FALSE) EQUALS TRUE
-- Wales
#ASSERT `reg 2 — looked after by a local authority` (`Care of a child` WITH `looked after within the meaning of section 22 of the Children Act 1989` IS FALSE, `looked after within the meaning of section 17(6) of the Children (Scotland) Act 1995` IS FALSE, `looked after within the meaning of section 74 of the Social Services and Well-being (Wales) Act 2014` IS TRUE) EQUALS TRUE
-- none
#ASSERT `reg 2 — looked after by a local authority` (`Care of a child` WITH `looked after within the meaning of section 22 of the Children Act 1989` IS FALSE, `looked after within the meaning of section 17(6) of the Children (Scotland) Act 1995` IS FALSE, `looked after within the meaning of section 74 of the Social Services and Well-being (Wales) Act 2014` IS FALSE) EQUALS FALSE

-- paid work (line 82): work done for payment or in expectation of payment, except being engaged by a charitable or voluntary organisation, or as a volunteer, where the payment is in respect of expenses.
-- an employee paid a wage
#ASSERT `reg 2 — paid work` (`Work done by a person` WITH `work is done for payment or in expectation of payment` IS TRUE, `person is engaged by a charitable or voluntary organisation, or as a volunteer` IS FALSE, `payment received or due to be paid is only in respect of expenses` IS FALSE) EQUALS TRUE
-- a volunteer, or someone engaged by a charity, who is paid only their expenses is not in paid work
#ASSERT `reg 2 — paid work` (`Work done by a person` WITH `work is done for payment or in expectation of payment` IS TRUE, `person is engaged by a charitable or voluntary organisation, or as a volunteer` IS TRUE, `payment received or due to be paid is only in respect of expenses` IS TRUE) EQUALS FALSE
-- a volunteer who is paid a wage as well as expenses is in paid work
#ASSERT `reg 2 — paid work` (`Work done by a person` WITH `work is done for payment or in expectation of payment` IS TRUE, `person is engaged by a charitable or voluntary organisation, or as a volunteer` IS TRUE, `payment received or due to be paid is only in respect of expenses` IS FALSE) EQUALS TRUE
-- a person employed by a charity at a salary is in paid work
#ASSERT `reg 2 — paid work` (`Work done by a person` WITH `work is done for payment or in expectation of payment` IS TRUE, `person is engaged by a charitable or voluntary organisation, or as a volunteer` IS TRUE, `payment received or due to be paid is only in respect of expenses` IS FALSE) EQUALS TRUE
-- work done with no payment and no expectation of it is not paid work
#ASSERT `reg 2 — paid work` (`Work done by a person` WITH `work is done for payment or in expectation of payment` IS FALSE, `person is engaged by a charitable or voluntary organisation, or as a volunteer` IS FALSE, `payment received or due to be paid is only in respect of expenses` IS FALSE) EQUALS FALSE
-- a volunteer with no payment of any kind
#ASSERT `reg 2 — paid work` (`Work done by a person` WITH `work is done for payment or in expectation of payment` IS FALSE, `person is engaged by a charitable or voluntary organisation, or as a volunteer` IS TRUE, `payment received or due to be paid is only in respect of expenses` IS FALSE) EQUALS FALSE

-- partner (line 83): the other member of a couple. A single claimant who is not a member of a couple has none.
#ASSERT `reg 2 — the claimant has a partner` `a single claimant` EQUALS FALSE
#ASSERT `reg 2 — the claimant has a partner` `joint claimants` EQUALS TRUE
#ASSERT `reg 2 — the claimant has a partner` `a single claimant who is a member of a couple` EQUALS TRUE

-- prisoner (lines 87-90): custody pending trial or sentence, under a sentence, or on temporary release; but not a person detained in hospital under the mental health Acts.
-- on remand
#ASSERT `reg 2 — prisoner` (`Detention` WITH `detained in custody pending trial or sentence upon conviction` IS TRUE, `detained in custody under a sentence imposed by a court` IS FALSE, `on temporary release under the Prison Act 1952 or the Prisons (Scotland) Act 1989` IS FALSE, `detained in hospital under the mental health Acts` IS FALSE) EQUALS TRUE
-- serving a sentence
#ASSERT `reg 2 — prisoner` (`Detention` WITH `detained in custody pending trial or sentence upon conviction` IS FALSE, `detained in custody under a sentence imposed by a court` IS TRUE, `on temporary release under the Prison Act 1952 or the Prisons (Scotland) Act 1989` IS FALSE, `detained in hospital under the mental health Acts` IS FALSE) EQUALS TRUE
-- on temporary release
#ASSERT `reg 2 — prisoner` (`Detention` WITH `detained in custody pending trial or sentence upon conviction` IS FALSE, `detained in custody under a sentence imposed by a court` IS FALSE, `on temporary release under the Prison Act 1952 or the Prisons (Scotland) Act 1989` IS TRUE, `detained in hospital under the mental health Acts` IS FALSE) EQUALS TRUE
-- detained in hospital under the Mental Health Act 1983 and in no other custody
#ASSERT `reg 2 — prisoner` (`Detention` WITH `detained in custody pending trial or sentence upon conviction` IS FALSE, `detained in custody under a sentence imposed by a court` IS FALSE, `on temporary release under the Prison Act 1952 or the Prisons (Scotland) Act 1989` IS FALSE, `detained in hospital under the mental health Acts` IS TRUE) EQUALS FALSE
-- sentenced but detained in hospital: the closing words take the person out of (a) and (b) alike (fork F4)
#ASSERT `reg 2 — prisoner` (`Detention` WITH `detained in custody pending trial or sentence upon conviction` IS FALSE, `detained in custody under a sentence imposed by a court` IS TRUE, `on temporary release under the Prison Act 1952 or the Prisons (Scotland) Act 1989` IS FALSE, `detained in hospital under the mental health Acts` IS TRUE) EQUALS FALSE
-- on temporary release but detained in hospital
#ASSERT `reg 2 — prisoner` (`Detention` WITH `detained in custody pending trial or sentence upon conviction` IS FALSE, `detained in custody under a sentence imposed by a court` IS FALSE, `on temporary release under the Prison Act 1952 or the Prisons (Scotland) Act 1989` IS TRUE, `detained in hospital under the mental health Acts` IS TRUE) EQUALS FALSE
-- at liberty
#ASSERT `reg 2 — prisoner` (`Detention` WITH `detained in custody pending trial or sentence upon conviction` IS FALSE, `detained in custody under a sentence imposed by a court` IS FALSE, `on temporary release under the Prison Act 1952 or the Prisons (Scotland) Act 1989` IS FALSE, `detained in hospital under the mental health Acts` IS FALSE) EQUALS FALSE

-- step-parent (lines 104-106), in relation to a child or qualifying young person A.
-- limb (a): in a couple with A's parent and both are responsible for A
#ASSERT `reg 2 — step-parent` (`Relationship to a child or qualifying young person` WITH `person is a parent of A` IS FALSE, `person is a member of a couple, the other member of which is a parent of A` IS TRUE, `the person and that parent are both responsible for A` IS TRUE, `person was previously a member of a couple, the other member of which was a parent of A` IS FALSE, `immediately before ceasing to be a member of that couple the person was responsible for A` IS FALSE, `since then the person has continued to be responsible for A` IS FALSE) EQUALS TRUE
-- limb (a) fails: in a couple with A's parent but only the parent is responsible for A
#ASSERT `reg 2 — step-parent` (`Relationship to a child or qualifying young person` WITH `person is a parent of A` IS FALSE, `person is a member of a couple, the other member of which is a parent of A` IS TRUE, `the person and that parent are both responsible for A` IS FALSE, `person was previously a member of a couple, the other member of which was a parent of A` IS FALSE, `immediately before ceasing to be a member of that couple the person was responsible for A` IS FALSE, `since then the person has continued to be responsible for A` IS FALSE) EQUALS FALSE
-- limb (b): was in a couple with A's parent, responsible before it ended and ever since
#ASSERT `reg 2 — step-parent` (`Relationship to a child or qualifying young person` WITH `person is a parent of A` IS FALSE, `person is a member of a couple, the other member of which is a parent of A` IS FALSE, `the person and that parent are both responsible for A` IS FALSE, `person was previously a member of a couple, the other member of which was a parent of A` IS TRUE, `immediately before ceasing to be a member of that couple the person was responsible for A` IS TRUE, `since then the person has continued to be responsible for A` IS TRUE) EQUALS TRUE
-- limb (b) fails: no longer responsible for A since the couple ended
#ASSERT `reg 2 — step-parent` (`Relationship to a child or qualifying young person` WITH `person is a parent of A` IS FALSE, `person is a member of a couple, the other member of which is a parent of A` IS FALSE, `the person and that parent are both responsible for A` IS FALSE, `person was previously a member of a couple, the other member of which was a parent of A` IS TRUE, `immediately before ceasing to be a member of that couple the person was responsible for A` IS TRUE, `since then the person has continued to be responsible for A` IS FALSE) EQUALS FALSE
-- limb (b) fails: was not responsible immediately before the couple ended
#ASSERT `reg 2 — step-parent` (`Relationship to a child or qualifying young person` WITH `person is a parent of A` IS FALSE, `person is a member of a couple, the other member of which is a parent of A` IS FALSE, `the person and that parent are both responsible for A` IS FALSE, `person was previously a member of a couple, the other member of which was a parent of A` IS TRUE, `immediately before ceasing to be a member of that couple the person was responsible for A` IS FALSE, `since then the person has continued to be responsible for A` IS TRUE) EQUALS FALSE
-- A's own parent is not a step-parent even if the other facts hold
#ASSERT `reg 2 — step-parent` (`Relationship to a child or qualifying young person` WITH `person is a parent of A` IS TRUE, `person is a member of a couple, the other member of which is a parent of A` IS TRUE, `the person and that parent are both responsible for A` IS TRUE, `person was previously a member of a couple, the other member of which was a parent of A` IS FALSE, `immediately before ceasing to be a member of that couple the person was responsible for A` IS FALSE, `since then the person has continued to be responsible for A` IS FALSE) EQUALS FALSE
-- nothing applies
#ASSERT `reg 2 — step-parent` (`Relationship to a child or qualifying young person` WITH `person is a parent of A` IS FALSE, `person is a member of a couple, the other member of which is a parent of A` IS FALSE, `the person and that parent are both responsible for A` IS FALSE, `person was previously a member of a couple, the other member of which was a parent of A` IS FALSE, `immediately before ceasing to be a member of that couple the person was responsible for A` IS FALSE, `since then the person has continued to be responsible for A` IS FALSE) EQUALS FALSE
#ASSERT `reg 2 — step-parent, limb (a)` (`Relationship to a child or qualifying young person` WITH `person is a parent of A` IS FALSE, `person is a member of a couple, the other member of which is a parent of A` IS TRUE, `the person and that parent are both responsible for A` IS TRUE, `person was previously a member of a couple, the other member of which was a parent of A` IS FALSE, `immediately before ceasing to be a member of that couple the person was responsible for A` IS FALSE, `since then the person has continued to be responsible for A` IS FALSE) EQUALS TRUE
#ASSERT `reg 2 — step-parent, limb (b)` (`Relationship to a child or qualifying young person` WITH `person is a parent of A` IS FALSE, `person is a member of a couple, the other member of which is a parent of A` IS FALSE, `the person and that parent are both responsible for A` IS FALSE, `person was previously a member of a couple, the other member of which was a parent of A` IS TRUE, `immediately before ceasing to be a member of that couple the person was responsible for A` IS TRUE, `since then the person has continued to be responsible for A` IS TRUE) EQUALS TRUE

-- terminally ill (line 108): a progressive disease, where death in consequence of it can reasonably be expected within 12 months.
-- exactly 12 months is within 12 months
#ASSERT `reg 2 — terminally ill` (`Illness` WITH `suffering from a progressive disease` IS TRUE, `months within which death in consequence of that disease can reasonably be expected` IS 12) EQUALS TRUE
-- 6 months
#ASSERT `reg 2 — terminally ill` (`Illness` WITH `suffering from a progressive disease` IS TRUE, `months within which death in consequence of that disease can reasonably be expected` IS 6) EQUALS TRUE
-- 13 months is not within 12 months
#ASSERT `reg 2 — terminally ill` (`Illness` WITH `suffering from a progressive disease` IS TRUE, `months within which death in consequence of that disease can reasonably be expected` IS 13) EQUALS FALSE
-- 18 months
#ASSERT `reg 2 — terminally ill` (`Illness` WITH `suffering from a progressive disease` IS TRUE, `months within which death in consequence of that disease can reasonably be expected` IS 18) EQUALS FALSE
-- death expected within 3 months but no progressive disease
#ASSERT `reg 2 — terminally ill` (`Illness` WITH `suffering from a progressive disease` IS FALSE, `months within which death in consequence of that disease can reasonably be expected` IS 3) EQUALS FALSE
#ASSERT `reg 2 — the months within which death must be expected for a person to be terminally ill` EQUALS 12
