IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-persons`
IMPORT `uc4-part8-ch2-reduction-effect`

-- Tests of uc4-part8-ch2-reduction-effect.l4: regulations 106 to 111.
-- Expected values are written by hand from the text, beside the assertion.

-- ---------------------------------------------------------------------------------------------------------
-- Fixtures.
GIVEN young IS A BOOLEAN
      carerUnder1 IS A BOOLEAN
      reg89 IS A BOOLEAN
      section20 IS A BOOLEAN
      lcwra IS A BOOLEAN
GIVETH A `Position at the end of the assessment period`
`test — position` young carerUnder1 reg89 section20 lcwra MEANS `Position at the end of the assessment period` WITH
    `the claimant is aged 16 or 17` IS young
    `the claimant falls within section 19 of the Act by virtue of subsection (2)(c) of that section (responsible carer for a child under the age of 1)` IS carerUnder1
    `the claimant falls within section 19 of the Act by virtue of regulation 89(1)(c), (d) or (f)` IS reg89
    `the claimant falls within section 20 of the Act` IS section20
    `the claimant falls within section 19 of the Act by virtue of having limited capability for work and work-related activity` IS lcwra

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 106: assessment period 1 to 30 June 2026; the next begins on 1 July 2026.
#ASSERT `reg 106 — the day from which the reduction period takes effect` (YMD 2026 6 1) FALSE (YMD 2026 7 1) FALSE NOTHING EQUALS JUST (YMD 2026 6 1)
#ASSERT `reg 106 — the day from which the reduction period takes effect` (YMD 2026 6 1) TRUE (YMD 2026 7 1) FALSE NOTHING EQUALS JUST (YMD 2026 7 1)
#ASSERT `reg 106 — the day from which the reduction period takes effect` (YMD 2026 6 1) FALSE (YMD 2026 7 1) TRUE (JUST (YMD 2026 8 1)) EQUALS JUST (YMD 2026 8 1)
-- Paragraph (c) governs over (b) and over (a).
#ASSERT `reg 106 — the day from which the reduction period takes effect` (YMD 2026 6 1) TRUE (YMD 2026 7 1) TRUE (JUST (YMD 2026 8 1)) EQUALS JUST (YMD 2026 8 1)
-- Paragraph (c) with the day not yet known: not covered.
#ASSERT `reg 106 — the day from which the reduction period takes effect` (YMD 2026 6 1) FALSE (YMD 2026 7 1) TRUE NOTHING EQUALS NOTHING

-- Regulation 107(1): 91 days outstanding when the award terminated on 31 March 2026. The new award begins on the day after: nothing has run.
#ASSERT `reg 107(1) — the remainder of the total outstanding reduction period when the new award begins` 91 (YMD 2026 3 31) (YMD 2026 4 1) EQUALS 91
#ASSERT `reg 107(1) — the remainder of the total outstanding reduction period when the new award begins` 91 (YMD 2026 3 31) (YMD 2026 4 30) EQUALS 62
-- The period runs for the 91 days 1 April to 30 June 2026. A new award on 30 June has one day left; on 1 July none.
#ASSERT `reg 107(1) — the remainder of the total outstanding reduction period when the new award begins` 91 (YMD 2026 3 31) (YMD 2026 6 30) EQUALS 1
#ASSERT `reg 107(1) — the remainder of the total outstanding reduction period when the new award begins` 91 (YMD 2026 3 31) (YMD 2026 7 1) EQUALS 0
#ASSERT `reg 107(1) — the remainder of the total outstanding reduction period when the new award begins` 91 (YMD 2026 3 31) (YMD 2027 3 31) EQUALS 0
#ASSERT `reg 107(1) — the new award is subject to a reduction` 1
#ASSERT NOT (`reg 107(1) — the new award is subject to a reduction` 0)

-- Regulation 107(2): treated as made on the day before the previous award terminated (30 March 2026).
#ASSERT `reg 107(2) — the day on which the determination is treated as made` TRUE TRUE (YMD 2026 3 31) (YMD 2026 5 1) EQUALS YMD 2026 3 30
#ASSERT `reg 107(2) — the day on which the determination is treated as made` TRUE FALSE (YMD 2026 3 31) (YMD 2026 5 1) EQUALS YMD 2026 5 1
#ASSERT `reg 107(2) — the day on which the determination is treated as made` FALSE TRUE (YMD 2026 3 31) (YMD 2026 5 1) EQUALS YMD 2026 5 1

-- Regulation 108: section 6B, 7 or 9 applies from 10 April to 20 April 2026. The reduction does not have effect on those days.
#ASSERT NOT (`reg 108 — the reduction is suspended on the day` (JUST (YMD 2026 4 10)) (JUST (YMD 2026 4 20)) (YMD 2026 4 9))
#ASSERT `reg 108 — the reduction is suspended on the day` (JUST (YMD 2026 4 10)) (JUST (YMD 2026 4 20)) (YMD 2026 4 10)
#ASSERT `reg 108 — the reduction is suspended on the day` (JUST (YMD 2026 4 10)) (JUST (YMD 2026 4 20)) (YMD 2026 4 20)
#ASSERT NOT (`reg 108 — the reduction is suspended on the day` (JUST (YMD 2026 4 10)) (JUST (YMD 2026 4 20)) (YMD 2026 4 21))
-- A period with no end yet runs on; no period at all suspends nothing.
#ASSERT `reg 108 — the reduction is suspended on the day` (JUST (YMD 2026 4 10)) NOTHING (YMD 2026 12 31)
#ASSERT NOT (`reg 108 — the reduction is suspended on the day` (JUST (YMD 2026 4 10)) NOTHING (YMD 2026 4 9))
#ASSERT NOT (`reg 108 — the reduction is suspended on the day` NOTHING NOTHING (YMD 2026 4 15))

-- Regulation 109(1)(b): at 10 pounds an hour 16 hours a week is 16 x 10 x 52 / 12 = 693.33..., rounded to the penny by regulation 6(1): 693.33.
#ASSERT `reg 109(1)(b) — a month's earnings equal or exceed the amount` 693 (JUST 693) 10 FALSE 35 5
#ASSERT NOT (`reg 109(1)(b) — a month's earnings equal or exceed the amount` 692.99 (JUST 693) 10 FALSE 35 5)
#ASSERT `reg 109(1)(b) — a month's earnings equal or exceed the amount` 693.33 NOTHING 10 FALSE 35 5
#ASSERT NOT (`reg 109(1)(b) — a month's earnings equal or exceed the amount` 693.32 NOTHING 10 FALSE 35 5)
-- At 11 pounds an hour it is 762.66..., which rounds up to 762.67.
#ASSERT `reg 109(1)(b) — a month's earnings equal or exceed the amount` 762.67 NOTHING 11 FALSE 35 5
#ASSERT NOT (`reg 109(1)(b) — a month's earnings equal or exceed the amount` 762.66 NOTHING 11 FALSE 35 5)
-- With an individual threshold the 16 hours route is not used.
#ASSERT NOT (`reg 109(1)(b) — a month's earnings equal or exceed the amount` 693.34 (JUST 800) 10 FALSE 35 5)
-- The apprentice route: 30 hours at 5 pounds is 30 x 5 x 52 / 12 = 650, truncated by regulation 6(1A) to 650.
#ASSERT `reg 109(1)(b) — a month's earnings equal or exceed the amount` 650 (JUST 693) 10 TRUE 35 5
#ASSERT NOT (`reg 109(1)(b) — a month's earnings equal or exceed the amount` 649.99 (JUST 693) 10 TRUE 35 5)
#ASSERT NOT (`reg 109(1)(b) — a month's earnings equal or exceed the amount` 650 (JUST 693) 10 FALSE 35 5)

-- Regulation 109(1): six months of paid work, and every month's earnings reaching the amount.
#ASSERT `reg 109(1) — the reduction is to be terminated` 6 (LIST 700, 800, 693, 693, 693, 693) (JUST 693) 10 FALSE 35 5
#ASSERT NOT (`reg 109(1) — the reduction is to be terminated` 5.99 (LIST 700, 800, 693, 693, 693, 693) (JUST 693) 10 FALSE 35 5)
#ASSERT NOT (`reg 109(1) — the reduction is to be terminated` 6 (LIST 700, 800, 692, 693, 693, 693) (JUST 693) 10 FALSE 35 5)
#ASSERT NOT (`reg 109(1) — the reduction is to be terminated` 6 EMPTY (JUST 693) 10 FALSE 35 5)
#ASSERT `reg 109(1) — the reduction is to be terminated` 12 (LIST 800, 800) NOTHING 10 FALSE 35 5

-- Regulation 109(2): from the start of the assessment period in which the date falls, or of the first one of a later award.
#ASSERT `reg 109(2) — the day from which the termination of the reduction has effect` TRUE (JUST (YMD 2026 9 1)) (JUST (YMD 2026 12 1)) EQUALS JUST (YMD 2026 9 1)
#ASSERT `reg 109(2) — the day from which the termination of the reduction has effect` FALSE (JUST (YMD 2026 9 1)) (JUST (YMD 2026 12 1)) EQUALS JUST (YMD 2026 12 1)
#ASSERT `reg 109(2) — the day from which the termination of the reduction has effect` FALSE (JUST (YMD 2026 9 1)) NOTHING EQUALS NOTHING

-- Regulation 109(3): a claimant treated as having earned income under regulation 62 is taken to have the individual threshold.
#ASSERT `reg 109(3) — the monthly earnings the claimant is taken to have` TRUE 100 (JUST 693) EQUALS JUST 693
#ASSERT `reg 109(3) — the monthly earnings the claimant is taken to have` FALSE 100 (JUST 693) EQUALS JUST 100
-- No individual threshold: not covered.
#ASSERT `reg 109(3) — the monthly earnings the claimant is taken to have` TRUE 100 NOTHING EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 111(2): 40% where aged 16 or 17, section 19(2)(c), regulation 89(1)(c), (d) or (f), or section 20.
#ASSERT `reg 111(2) — the daily reduction rate is 40% of the rate in paragraph (1)` (`test — position` TRUE FALSE FALSE FALSE FALSE)
#ASSERT `reg 111(2) — the daily reduction rate is 40% of the rate in paragraph (1)` (`test — position` FALSE TRUE FALSE FALSE FALSE)
#ASSERT `reg 111(2) — the daily reduction rate is 40% of the rate in paragraph (1)` (`test — position` FALSE FALSE TRUE FALSE FALSE)
#ASSERT `reg 111(2) — the daily reduction rate is 40% of the rate in paragraph (1)` (`test — position` FALSE FALSE FALSE TRUE FALSE)
#ASSERT NOT (`reg 111(2) — the daily reduction rate is 40% of the rate in paragraph (1)` (`test — position` FALSE FALSE FALSE FALSE FALSE))
#ASSERT NOT (`reg 111(2) — the daily reduction rate is 40% of the rate in paragraph (1)` (`test — position` FALSE FALSE FALSE FALSE TRUE))
#ASSERT `reg 111(3) — the daily reduction rate is nil` (`test — position` FALSE FALSE FALSE FALSE TRUE)
#ASSERT NOT (`reg 111(3) — the daily reduction rate is nil` (`test — position` TRUE TRUE TRUE TRUE FALSE))

-- Regulation 111(1) and (4): 400 pounds x 12 / 365 = 13.1506..., rounded down to 13.10.
#ASSERT `reg 111(1) to (4) — the daily reduction rate for one claimant before paragraph (5)` (`test — position` FALSE FALSE FALSE FALSE FALSE) 400 EQUALS 13.1
-- Paragraph (2): 40% of 13.1506... is 5.2602..., rounded down to 5.20.
#ASSERT `reg 111(1) to (4) — the daily reduction rate for one claimant before paragraph (5)` (`test — position` TRUE FALSE FALSE FALSE FALSE) 400 EQUALS 5.2
#ASSERT `reg 111(1) to (4) — the daily reduction rate for one claimant before paragraph (5)` (`test — position` FALSE FALSE FALSE TRUE FALSE) 400 EQUALS 5.2
-- Rounded once, at the end (fork F-111-1): 388.20 x 12 / 365 = 12.7627..., 40% of which is 5.1050... and rounds down to 5.10.
-- (Taking 40% of the already rounded 12.70 would give 5.08, which rounds down to 5.00.)
#ASSERT `reg 111(1) to (4) — the daily reduction rate for one claimant before paragraph (5)` (`test — position` TRUE FALSE FALSE FALSE FALSE) 388.2 EQUALS 5.1
#ASSERT `reg 111(1) to (4) — the daily reduction rate for one claimant before paragraph (5)` (`test — position` FALSE FALSE FALSE FALSE FALSE) 388.2 EQUALS 12.7
#ASSERT `reg 111(1) to (4) — the daily reduction rate for one claimant before paragraph (5)` (`test — position` FALSE FALSE FALSE FALSE FALSE) 393.45 EQUALS 12.9
-- Paragraph (3): nil, and it governs when paragraph (2) also applies (fork F-111-2).
#ASSERT `reg 111(1) to (4) — the daily reduction rate for one claimant before paragraph (5)` (`test — position` FALSE FALSE FALSE FALSE TRUE) 400 EQUALS 0
#ASSERT `reg 111(1) to (4) — the daily reduction rate for one claimant before paragraph (5)` (`test — position` TRUE FALSE FALSE FALSE TRUE) 400 EQUALS 0
-- Paragraph (5): joint claimants each bear half of the rate (of the rounded rate: fork F-111-3).
#ASSERT `reg 111 — the daily reduction rate applied to the claimant` (`test — position` FALSE FALSE FALSE FALSE FALSE) 400 TRUE EQUALS 6.55
#ASSERT `reg 111 — the daily reduction rate applied to the claimant` (`test — position` TRUE FALSE FALSE FALSE FALSE) 400 TRUE EQUALS 2.6
#ASSERT `reg 111 — the daily reduction rate applied to the claimant` (`test — position` FALSE FALSE FALSE FALSE FALSE) 400 FALSE EQUALS 13.1
#ASSERT `reg 111 — the daily reduction rate applied to the claimant` (`test — position` FALSE FALSE FALSE FALSE TRUE) 400 TRUE EQUALS 0

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 110, Step 1: a 30-day assessment period.
#ASSERT `reg 110 Step 1 — the number of days` 30 91 0 EQUALS 30
-- ... with only 20 days left of the reduction period: the lower is taken.
#ASSERT `reg 110 Step 1 — the number of days` 30 20 0 EQUALS 20
-- ... with 5 days suspended.
#ASSERT `reg 110 Step 1 — the number of days` 30 91 5 EQUALS 25
#ASSERT `reg 110 Step 1 — the number of days` 30 20 5 EQUALS 15
-- ... both equal.
#ASSERT `reg 110 Step 1 — the number of days` 30 30 0 EQUALS 30
-- More days suspended than there are to reduce: not below nought (fork F-110-1).
#ASSERT `reg 110 Step 1 — the number of days` 30 20 40 EQUALS 0

-- Step 2: 30 days x 13.10 a day = 393.
#ASSERT `reg 110 Step 2 — the number of days multiplied by the daily reduction rate` 30 13.1 EQUALS 393
#ASSERT `reg 110 Step 2 — the number of days multiplied by the daily reduction rate` 0 13.1 EQUALS 0

-- Step 3: not above the standard allowance (400), or half of it for a joint claim in which only one claimant is the subject of a determination.
#ASSERT `reg 110 Step 3 — the amount adjusted so that it does not exceed the limit` 393 400 FALSE FALSE EQUALS 393
#ASSERT `reg 110 Step 3 — the amount adjusted so that it does not exceed the limit` 450 400 FALSE FALSE EQUALS 400
#ASSERT `reg 110 Step 3 — the amount adjusted so that it does not exceed the limit` 400 400 FALSE FALSE EQUALS 400
#ASSERT `reg 110 Step 3 — the amount adjusted so that it does not exceed the limit` 300 400 TRUE TRUE EQUALS 200
#ASSERT `reg 110 Step 3 — the amount adjusted so that it does not exceed the limit` 150 400 TRUE TRUE EQUALS 150
-- A joint claim with determinations for both claimants: the whole allowance. A single claim: the flag is ignored.
#ASSERT `reg 110 Step 3 — the amount adjusted so that it does not exceed the limit` 300 400 TRUE FALSE EQUALS 300
#ASSERT `reg 110 Step 3 — the amount adjusted so that it does not exceed the limit` 450 400 FALSE TRUE EQUALS 400

-- Steps 1 to 3: 30 days of a 91-day period at 13.10, allowance 400: 393.
#ASSERT `reg 110 — the amount of the reduction for the assessment period` 30 91 0 13.1 400 FALSE FALSE EQUALS 393
-- A joint claim, one claimant sanctioned, at half the rate (6.55): 30 x 6.55 = 196.50, below half the allowance (200).
#ASSERT `reg 110 — the amount of the reduction for the assessment period` 30 91 0 6.55 400 TRUE TRUE EQUALS 196.5
-- A rate high enough to reach the limit: 30 x 15 = 450, cut to 400.
#ASSERT `reg 110 — the amount of the reduction for the assessment period` 30 91 0 15 400 FALSE FALSE EQUALS 400

-- Step 4: an award of 500 reduced by 393 is 107; reduced by more than the award, the answer is below nothing, as the text does not stop it.
#ASSERT `reg 110 Step 4 — the amount of the award after the reduction` 500 393 EQUALS 107
#ASSERT `reg 110 Step 4 — the amount of the award after the reduction` 300 393 EQUALS (0 MINUS 93)
