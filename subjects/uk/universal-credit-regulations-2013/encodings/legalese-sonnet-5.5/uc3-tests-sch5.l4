IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-persons`
IMPORT `uc-core-bodies`
IMPORT `uc3-disability-payments`
IMPORT `uc3-sch1-interpretation`
IMPORT `uc3-sch4-interpretation`
IMPORT `uc3-sch1-payments`
IMPORT `uc3-sch5-owner-occupiers`
IMPORT `uc3-sch5a-pre-2026-claimant`

-- The Universal Credit Regulations 2013 (S.I. 2013/376), Schedule 5 (housing costs element for owner-occupiers) and Schedule 5A (pre-2026 claimants). Tests of layer 1.
-- Source: ../../registers/source-bundle/uksi-2013-376.txt (plain-text rendering, not the official text).
--
-- EVERY EXPECTED VALUE IS WRITTEN HERE FROM THE TEXT, beside the assertion, before the file was run: none was copied from what the encoding printed.
-- Amounts are in pounds.

-- ---------------------------------------------------------------------------------------------------------
-- Schedule 5 paragraph 1: who is an owner-occupier. A claimant to whom regulation 26(3) applies is one; joint owner-occupiers are joint claimants to whom it applies.
GIVEN applies IS A BOOLEAN
      basis IS A `Claim basis`
GIVETH A `Claimant who may be an owner-occupier`
`uc3 test — a claimant who may be an owner-occupier` applies basis MEANS
    `Claimant who may be an owner-occupier` WITH
        `regulation 26(3) applies to the claimant` IS applies
        `claim basis` IS basis
-- Expected: regulation 26(3) applying gives an owner-occupier; not applying gives FALSE; joint owner-occupiers need joint claimants as well as regulation 26(3).
#ASSERT `Sch 5 para 1(2) — a claimant is an owner-occupier` (`uc3 test — a claimant who may be an owner-occupier` TRUE `a single claimant`) EQUALS TRUE
#ASSERT `Sch 5 para 1(2) — a claimant is an owner-occupier` (`uc3 test — a claimant who may be an owner-occupier` FALSE `a single claimant`) EQUALS FALSE
#ASSERT `Sch 5 para 1(2) — a joint owner-occupier` (`uc3 test — a claimant who may be an owner-occupier` TRUE `joint claimants`) EQUALS TRUE
#ASSERT `Sch 5 para 1(2) — a joint owner-occupier` (`uc3 test — a claimant who may be an owner-occupier` TRUE `a single claimant`) EQUALS FALSE
#ASSERT `Sch 5 para 1(2) — a joint owner-occupier` (`uc3 test — a claimant who may be an owner-occupier` FALSE `joint claimants`) EQUALS FALSE
-- Paragraph 2: "relevant date" is the date on which an amount calculated under this Schedule is first included in the award. Expected: the date given back.
#ASSERT `Sch 5 para 2 — the relevant date` (YearMonthDay 2025 3 1) EQUALS YearMonthDay 2025 3 1

-- ---------------------------------------------------------------------------------------------------------
-- Paragraph 3: the relevant payments are service charge payments (paragraphs 7 and 8 of Schedule 1), for a calculation under this Schedule.
GIVETH A `Accommodation in the Schedule 1 tests`
`uc3 test — ordinary accommodation` MEANS
    `Accommodation in the Schedule 1 tests` WITH
        structure IS `Structure that may be a tent` WITH
            `moveable structure` IS FALSE
            `designed or adapted (solely or mainly) for the purpose of sleeping in a place for any period` IS FALSE
            `caravan` IS FALSE
            `mobile home` IS FALSE
            `houseboat` IS FALSE
        `approved premises` IS FALSE
        `care home premises` IS `Premises that may be a care home` WITH
            `nation of Great Britain in which the premises are` IS England
            `a care home within the meaning of section 3 of the Care Standards Act 2000` IS FALSE
            `a place at which a care home service within the meaning of Part 1 of the Regulation and Inspection of Social Care (Wales) Act 2016 is provided wholly or mainly to persons aged 18 or over` IS FALSE
            `a care home service within the meaning of paragraph 2 of Schedule 12 to the Public Services Reform (Scotland) Act 2010` IS FALSE
            `the premises as a hospital that may be an independent hospital` IS `Hospital that may be an independent hospital` WITH
                `a hospital as defined by section 275 of the National Health Service Act 2006` IS FALSE
                `a health service hospital as defined by section 275 of the National Health Service Act 2006` IS FALSE
                `an independent hospital as the meaning is assigned to it by section 2 of the Care Standards Act 2000` IS FALSE
                `an independent health care service as defined in section 10F(1)(a) and (b) of the National Health Service (Scotland) Act 1978` IS FALSE
        `exempt accommodation` IS FALSE

-- A payment that may be a service charge payment under this Schedule. code: 0 meets every requirement (payment for services; the calculation is under Schedule 5; paragraph 8 first condition, Category B,
-- third condition, fourth condition); 1 not a payment for services; 2 the calculation is not under Part 5 of Schedule 4 or Schedule 5; 3 the first condition fails; 4 no category fits; 5 the third condition fails.
GIVEN code IS A NUMBER
GIVETH A `Payment that may be a service charge payment`
`uc3 test — a payment for Schedule 5` code MEANS
    `Payment that may be a service charge payment` WITH
        `the payment is, in whole or in part, a payment of, or towards, the costs of or charges for providing services or facilities for the use or benefit of persons occupying accommodation` IS NOT (code EQUALS 1)
        `the payment is, in whole or in part, fairly attributable to the costs of or charges for providing such services or facilities connected with accommodation as are available for the use or benefit of persons occupying accommodation` IS FALSE
        `a qualifying loan within the meaning of regulation 2 of the Loans for Mortgage Interest Regulations 2017 was taken out for the purposes of making the payments` IS FALSE
        `the accommodation occupied by the person for whose use or benefit the services or facilities are provided` IS `uc3 test — ordinary accommodation`
        `the payments are separately identified as relating to the costs or charges referred to in sub-paragraph (2)` IS FALSE
        `the payments are made in addition to or as part of any other payment` IS FALSE
        `the payments are made under the same agreement as that under which the accommodation is occupied` IS FALSE
        `facts for paragraph 8` IS `Service charge payment, as paragraph 8 looks at it` WITH
            `the calculation is made under Part 5 of Schedule 4 or under Schedule 5` IS NOT (code EQUALS 2)
            `making the payments is a condition on which the right to occupy the accommodation depends` IS NOT (code EQUALS 3)
            `external cleaning of windows` IS FALSE
            `the windows are in upper floors of a multi-storey building` IS FALSE
            `other internal or external maintenance or repair of the accommodation` IS FALSE
            `the payments are separately identifiable as relating to such maintenance or repair` IS FALSE
            `the payments are payable by a claimant who occupies accommodation under a shared ownership tenancy` IS FALSE
            `any amount of housing costs element in respect of those payments would fall to be calculated under Schedule 5` IS FALSE
            `ongoing maintenance or cleaning of, and the supply of water, fuel or any other commodity relating to the common use of, internal or external areas, including areas for reasonable facilities` IS NOT (code EQUALS 4)
            `provision, ongoing maintenance, cleaning or repair in connection with basic services generally available to all persons living in the accommodation` IS FALSE
            `payments specific to the particular accommodation occupied by the claimant for the use of essential items contained in it` IS FALSE
            `the costs and charges to which the payments relate are of a reasonable amount` IS NOT (code EQUALS 5)
            `the costs and charges relate to services or facilities of such description as it is reasonable to provide` IS TRUE
            `the payments relate to the costs of or charges for providing services or facilities in respect of which payments out of public funds might otherwise be made` IS FALSE
            `the payments are in connection with the use of an asset and result in the transfer of the asset or any interest in it` IS FALSE
            `the payments relate to the costs of or charges for providing food, medical services or personal services (including personal care) of any description` IS FALSE
-- Expected: code 0 gives TRUE; every other code gives FALSE (codes 3 to 5: the payment is not a service charge payment, paragraph 7(1)(c); paragraph 8(7) treats it as one only for paragraphs 3(g) and 4(2) of Schedule 1).
#ASSERT `Sch 5 para 3 — the payment is a relevant payment` (`uc3 test — a payment for Schedule 5` 0) EQUALS TRUE
#ASSERT `Sch 5 para 3 — the payment is a relevant payment` (`uc3 test — a payment for Schedule 5` 1) EQUALS FALSE
#ASSERT `Sch 5 para 3 — the payment is a relevant payment` (`uc3 test — a payment for Schedule 5` 2) EQUALS FALSE
#ASSERT `Sch 5 para 3 — the payment is a relevant payment` (`uc3 test — a payment for Schedule 5` 3) EQUALS FALSE
#ASSERT `Sch 5 para 3 — the payment is a relevant payment` (`uc3 test — a payment for Schedule 5` 4) EQUALS FALSE
#ASSERT `Sch 5 para 3 — the payment is a relevant payment` (`uc3 test — a payment for Schedule 5` 5) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------
-- Part 2, paragraph 4: no housing costs element for an assessment period in which the owner-occupier, or either member of a couple, has any earned income, whatever the work, its duration or the amount.
GIVEN basis IS A `Claim basis`
      own IS A BOOLEAN
      other IS A BOOLEAN
      work IS A STRING
      duration IS A NUMBER
      amount IS A NUMBER
GIVETH A `Owner-occupier's earned income in an assessment period`
`uc3 test — earned income` basis own other work duration amount MEANS
    `Owner-occupier's earned income in an assessment period` WITH
        `claim basis` IS basis
        `the owner-occupier has any earned income` IS own
        `the other member of the couple has any earned income` IS other
        `the nature of the work engaged in` IS work
        `the duration of the work` IS duration
        `the amount of the earned income` IS amount
-- Expected: the owner-occupier's own earned income gives TRUE; none gives FALSE; for a single claimant with no partner, another person's earned income does not count (FALSE);
-- for joint claimants, or a single claimant who is a member of a couple, the other member's earned income gives TRUE (4(1)(b)); sub-paragraph (2): nature, duration and amount make no difference.
#ASSERT `Sch 5 para 4 — section 11(1) of the Act does not apply to the owner-occupier for the assessment period` (`uc3 test — earned income` `a single claimant` TRUE FALSE "an office job" 40 2000) EQUALS TRUE
#ASSERT `Sch 5 para 4 — section 11(1) of the Act does not apply to the owner-occupier for the assessment period` (`uc3 test — earned income` `a single claimant` FALSE FALSE "none" 0 0) EQUALS FALSE
#ASSERT `Sch 5 para 4 — section 11(1) of the Act does not apply to the owner-occupier for the assessment period` (`uc3 test — earned income` `a single claimant` FALSE TRUE "none" 0 0) EQUALS FALSE
#ASSERT `Sch 5 para 4 — section 11(1) of the Act does not apply to the owner-occupier for the assessment period` (`uc3 test — earned income` `joint claimants` FALSE TRUE "none" 0 0) EQUALS TRUE
#ASSERT `Sch 5 para 4 — section 11(1) of the Act does not apply to the owner-occupier for the assessment period` (`uc3 test — earned income` `a single claimant who is a member of a couple` FALSE TRUE "none" 0 0) EQUALS TRUE
#ASSERT `Sch 5 para 4 — section 11(1) of the Act does not apply to the owner-occupier for the assessment period` (`uc3 test — earned income` `joint claimants` FALSE FALSE "none" 0 0) EQUALS FALSE
#ASSERT `Sch 5 para 4 — section 11(1) of the Act does not apply to the owner-occupier for the assessment period` (`uc3 test — earned income` `joint claimants` TRUE FALSE "casual work" 1 1) EQUALS TRUE
#ASSERT `Sch 5 para 4 — section 11(1) of the Act does not apply to the owner-occupier for the assessment period` (`uc3 test — earned income` `joint claimants` TRUE FALSE "full-time employment" 52 9999) EQUALS TRUE
-- Paragraph 4(3): this paragraph does not prevent an amount calculated under Schedule 4 for a claimant within regulation 26(4) to (6) (shared ownership). Expected: the fact given back.
#ASSERT `Sch 5 para 4(3) — paragraph 4 does not prevent an amount calculated under Schedule 4 from being included` TRUE EQUALS TRUE
#ASSERT `Sch 5 para 4(3) — paragraph 4 does not prevent an amount calculated under Schedule 4 from being included` FALSE EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------
-- Part 3, paragraph 5: the qualifying period is 9 consecutive assessment periods; the element is not included until the assessment period after the one in which it ends.
-- An assessment period for the qualifying period: receiving universal credit, and would otherwise qualify.
GIVEN receiving IS A BOOLEAN
      qualifies IS A BOOLEAN
GIVETH A `Assessment period for the qualifying period`
`uc3 test — an assessment period` receiving qualifies MEANS
    `Assessment period for the qualifying period` WITH
        `the owner-occupier has been receiving universal credit in the assessment period` IS receiving
        `the owner-occupier would otherwise qualify for the inclusion of an amount calculated under this Schedule in their award` IS qualifies

-- n assessment periods in which the owner-occupier is receiving universal credit and would otherwise qualify, except that the one numbered gap (counting from 1) does not qualify; gap 0 means none.
-- receiving: whether the owner-occupier has been receiving universal credit in every period.
GIVEN n IS A NUMBER
      gap IS A NUMBER
      receiving IS A BOOLEAN
GIVETH A LIST OF `Assessment period for the qualifying period`
`uc3 test — assessment periods` n gap receiving MEANS
    IF n EQUALS 0
    THEN EMPTY
    ELSE append (`uc3 test — assessment periods` (n MINUS 1) gap receiving) (LIST `uc3 test — an assessment period` receiving (NOT (n EQUALS gap)))

GIVEN kind IS A `Kind of qualifying period`
      periods IS A LIST OF `Assessment period for the qualifying period`
      credited IS A NUMBER
      already IS A BOOLEAN
GIVETH A `Facts about the qualifying period`
`uc3 test — facts about the qualifying period` kind periods credited already MEANS
    `Facts about the qualifying period` WITH
        `kind of qualifying period` IS kind
        `assessment periods, oldest first, ending with the one in question` IS periods
        `assessment periods credited under paragraph 6(2) or carried forward under paragraph 7(2)` IS credited
        `paragraph 7(3) applies: an amount calculated under this Schedule was already included in the award that ended` IS already

-- Paragraph 5(2): an assessment period counts towards a new award's qualifying period when the owner-occupier has been receiving universal credit and would otherwise qualify (2)(a);
-- towards the qualifying period of an award from which an amount has ceased to be included when the owner-occupier would otherwise qualify (2)(b).
-- Expected: (receiving, qualifies) = TRUE TRUE counts for both kinds; TRUE FALSE counts for neither; FALSE TRUE counts only for the second kind.
#ASSERT `Sch 5 para 5(2) — the assessment period counts towards the qualifying period` `a new award` (`uc3 test — an assessment period` TRUE TRUE) EQUALS TRUE
#ASSERT `Sch 5 para 5(2) — the assessment period counts towards the qualifying period` `an award from which an amount calculated under this Schedule has ceased to be included` (`uc3 test — an assessment period` TRUE TRUE) EQUALS TRUE
#ASSERT `Sch 5 para 5(2) — the assessment period counts towards the qualifying period` `a new award` (`uc3 test — an assessment period` TRUE FALSE) EQUALS FALSE
#ASSERT `Sch 5 para 5(2) — the assessment period counts towards the qualifying period` `an award from which an amount calculated under this Schedule has ceased to be included` (`uc3 test — an assessment period` TRUE FALSE) EQUALS FALSE
#ASSERT `Sch 5 para 5(2) — the assessment period counts towards the qualifying period` `a new award` (`uc3 test — an assessment period` FALSE TRUE) EQUALS FALSE
#ASSERT `Sch 5 para 5(2) — the assessment period counts towards the qualifying period` `an award from which an amount calculated under this Schedule has ceased to be included` (`uc3 test — an assessment period` FALSE TRUE) EQUALS TRUE
-- Paragraph 5(1) and (2)(a), a new award, all periods qualifying: 8 periods and 9 periods end in or before the assessment period in question, so no element yet (the 9th period is the one in question: the qualifying period ends in it);
-- 10 periods: the qualifying period ended in the 9th, so the element is included from the 10th; 12 periods: also TRUE.
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 8 0 TRUE) 0 FALSE) EQUALS FALSE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 9 0 TRUE) 0 FALSE) EQUALS FALSE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 10 0 TRUE) 0 FALSE) EQUALS TRUE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 12 0 TRUE) 0 FALSE) EQUALS TRUE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` EMPTY 0 FALSE) EQUALS FALSE
-- Paragraph 5(3): a period in which the owner-occupier ceases to qualify stops the qualifying period running, and a new one starts only when the requirements are met again.
-- Expected, with the 3rd period not qualifying: 12 periods leave 9 consecutive (the 4th to the 12th), which end in the 12th, the one in question: FALSE; 13 periods: TRUE; 14 periods: TRUE;
-- with the 5th not qualifying and 10 periods: the periods after it are only 5, so FALSE; with the 5th not qualifying and 14 periods: the 6th to the 14th are 9, ending in the 14th: FALSE; 15 periods: TRUE.
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 12 3 TRUE) 0 FALSE) EQUALS FALSE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 13 3 TRUE) 0 FALSE) EQUALS TRUE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 14 3 TRUE) 0 FALSE) EQUALS TRUE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 10 5 TRUE) 0 FALSE) EQUALS FALSE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 14 5 TRUE) 0 FALSE) EQUALS FALSE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 15 5 TRUE) 0 FALSE) EQUALS TRUE
-- Paragraph 5(2)(b): where an amount has ceased to be included, the owner-occupier need not have been receiving universal credit. Expected: 10 periods in which the owner-occupier is not receiving but would otherwise qualify:
-- a new award FALSE; an award from which an amount has ceased to be included TRUE; 9 such periods: TRUE is not reached (FALSE).
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 10 0 FALSE) 0 FALSE) EQUALS FALSE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `an award from which an amount calculated under this Schedule has ceased to be included` (`uc3 test — assessment periods` 10 0 FALSE) 0 FALSE) EQUALS TRUE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `an award from which an amount calculated under this Schedule has ceased to be included` (`uc3 test — assessment periods` 9 0 FALSE) 0 FALSE) EQUALS FALSE
-- Paragraphs 6(2) and 7(2): periods credited or carried forward count towards the 9. Expected: 4 credited and 5 qualifying periods complete the 9 in the 5th, the one in question: FALSE; 4 credited and 6 periods: TRUE;
-- 8 credited and 1 period: FALSE; 8 credited and 2 periods: TRUE; credit does not survive a break: 8 credited and a first period that does not qualify, then 2 that do: FALSE.
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 5 0 TRUE) 4 FALSE) EQUALS FALSE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 6 0 TRUE) 4 FALSE) EQUALS TRUE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 1 0 TRUE) 8 FALSE) EQUALS FALSE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 2 0 TRUE) 8 FALSE) EQUALS TRUE
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` (`uc3 test — assessment periods` 3 1 TRUE) 8 FALSE) EQUALS FALSE
-- Paragraph 7(3): where an amount was already included in the terminated award, no qualifying period applies. Expected: TRUE with no periods at all.
#ASSERT `Sch 5 para 5 — the owner-occupier is past the qualifying period` (`uc3 test — facts about the qualifying period` `a new award` EMPTY 0 TRUE) EQUALS TRUE

-- ---------------------------------------------------------------------------------------------------------
-- Paragraph 6: an owner-occupier entitled to a jobseeker's allowance or an employment and support allowance immediately before the award. Days of benefit MAY be treated as the whole or part of assessment periods.
-- The assessment period used for the count runs from 1 to 30 September 2025: 30 days.
GIVEN jsa IS A BOOLEAN
      esa IS A BOOLEAN
      days IS A NUMBER
      only IS A BOOLEAN
      treated IS A BOOLEAN
      firstDay IS A DATE
      lastDay IS A DATE
GIVETH A `Owner-occupier entitled to a jobseeker's allowance or an employment and support allowance`
`uc3 test — an owner-occupier entitled to a benefit` jsa esa days only treated firstDay lastDay MEANS
    `Owner-occupier entitled to a jobseeker's allowance or an employment and support allowance` WITH
        `immediately before the commencement of the award of universal credit the owner-occupier is entitled to a jobseeker's allowance` IS jsa
        `immediately before the commencement of the award of universal credit the owner-occupier is entitled to an employment and support allowance` IS esa
        `number of days on which the owner-occupier was receiving that benefit in the period` IS days
        `the period comprises only days on which the owner-occupier was receiving that benefit` IS only
        `the period is treated as if it were the whole or part of one or more assessment periods` IS treated
        `the assessment period used for the count` IS `Assessment period` WITH `first day` IS firstDay, `last day` IS lastDay
-- Expected: 30 days of jobseeker's allowance in a 30-day assessment period are 1 assessment period; 45 days are 1.5; 60 days are 2; employment and support allowance counts the same;
-- neither benefit gives 0; days that are not only days of benefit give 0; no permission gives 0; a 31-day assessment period (1 to 31 October) with 62 days gives 2.
#ASSERT `Sch 5 para 6(2) — the assessment periods that the days of benefit are treated as` (`uc3 test — an owner-occupier entitled to a benefit` TRUE FALSE 30 TRUE TRUE (YearMonthDay 2025 9 1) (YearMonthDay 2025 9 30)) EQUALS 1
#ASSERT `Sch 5 para 6(2) — the assessment periods that the days of benefit are treated as` (`uc3 test — an owner-occupier entitled to a benefit` TRUE FALSE 45 TRUE TRUE (YearMonthDay 2025 9 1) (YearMonthDay 2025 9 30)) EQUALS 1.5
#ASSERT `Sch 5 para 6(2) — the assessment periods that the days of benefit are treated as` (`uc3 test — an owner-occupier entitled to a benefit` TRUE FALSE 60 TRUE TRUE (YearMonthDay 2025 9 1) (YearMonthDay 2025 9 30)) EQUALS 2
#ASSERT `Sch 5 para 6(2) — the assessment periods that the days of benefit are treated as` (`uc3 test — an owner-occupier entitled to a benefit` FALSE TRUE 30 TRUE TRUE (YearMonthDay 2025 9 1) (YearMonthDay 2025 9 30)) EQUALS 1
#ASSERT `Sch 5 para 6(2) — the assessment periods that the days of benefit are treated as` (`uc3 test — an owner-occupier entitled to a benefit` FALSE FALSE 30 TRUE TRUE (YearMonthDay 2025 9 1) (YearMonthDay 2025 9 30)) EQUALS 0
#ASSERT `Sch 5 para 6(2) — the assessment periods that the days of benefit are treated as` (`uc3 test — an owner-occupier entitled to a benefit` TRUE FALSE 30 FALSE TRUE (YearMonthDay 2025 9 1) (YearMonthDay 2025 9 30)) EQUALS 0
#ASSERT `Sch 5 para 6(2) — the assessment periods that the days of benefit are treated as` (`uc3 test — an owner-occupier entitled to a benefit` TRUE FALSE 30 TRUE FALSE (YearMonthDay 2025 9 1) (YearMonthDay 2025 9 30)) EQUALS 0
#ASSERT `Sch 5 para 6(2) — the assessment periods that the days of benefit are treated as` (`uc3 test — an owner-occupier entitled to a benefit` TRUE FALSE 62 TRUE TRUE (YearMonthDay 2025 10 1) (YearMonthDay 2025 10 31)) EQUALS 2

-- Paragraph 7: joint owner-occupiers whose award is terminated because they cease to be a couple; a further award follows and the occupation condition is met for the same accommodation.
GIVEN ended IS A BOOLEAN
      further IS A BOOLEAN
      occupation IS A BOOLEAN
      counted IS A NUMBER
      onClaim IS A BOOLEAN
GIVETH A `Further award after joint owner-occupiers cease to be a couple`
`uc3 test — a further award` ended further occupation counted onClaim MEANS
    `Further award after joint owner-occupiers cease to be a couple` WITH
        `an award of universal credit to joint owner-occupiers is terminated because they cease to be a couple` IS ended
        `a further award is made to one of them (or to each of them)` IS further
        `in relation to the further award the occupation condition is met in respect of the same accommodation as that occupied by the joint owner-occupiers as their home` IS occupation
        `assessment periods which would have counted in relation to the award that is terminated` IS counted
        `the further award is made on a claim` IS onClaim
-- Expected: all three of (a), (b) and (c) give TRUE and 5 periods carried forward; each missing gives FALSE and 0; whether the further award is made on a claim is irrelevant (7(4)).
#ASSERT `Sch 5 para 7(1) — this paragraph applies` (`uc3 test — a further award` TRUE TRUE TRUE 5 TRUE) EQUALS TRUE
#ASSERT `Sch 5 para 7(1) — this paragraph applies` (`uc3 test — a further award` TRUE TRUE TRUE 5 FALSE) EQUALS TRUE
#ASSERT `Sch 5 para 7(1) — this paragraph applies` (`uc3 test — a further award` FALSE TRUE TRUE 5 TRUE) EQUALS FALSE
#ASSERT `Sch 5 para 7(1) — this paragraph applies` (`uc3 test — a further award` TRUE FALSE TRUE 5 TRUE) EQUALS FALSE
#ASSERT `Sch 5 para 7(1) — this paragraph applies` (`uc3 test — a further award` TRUE TRUE FALSE 5 TRUE) EQUALS FALSE
#ASSERT `Sch 5 para 7(2) — the assessment periods carried forward to the further award` (`uc3 test — a further award` TRUE TRUE TRUE 5 TRUE) EQUALS 5
#ASSERT `Sch 5 para 7(2) — the assessment periods carried forward to the further award` (`uc3 test — a further award` TRUE TRUE TRUE 5 FALSE) EQUALS 5
#ASSERT `Sch 5 para 7(2) — the assessment periods carried forward to the further award` (`uc3 test — a further award` TRUE TRUE FALSE 5 TRUE) EQUALS 0
#ASSERT `Sch 5 para 7(2) — the assessment periods carried forward to the further award` (`uc3 test — a further award` FALSE TRUE TRUE 5 TRUE) EQUALS 0

-- ---------------------------------------------------------------------------------------------------------
-- Part 4, paragraph 8: payments to be taken into account. A liability of an owner-occupier for a service charge payment.
-- code: 0 a relevant payment; 1 a payment that is not a service charge payment (not for services). fields: pay, liab, occ: the three conditions; ended: the qualifying period has ended; already: already brought into account;
-- free: service charge free periods; n: the total number of payments in the 12 months.
GIVEN code IS A NUMBER
      amount IS A NUMBER
      interval IS A `Payment interval`
      pay IS A BOOLEAN
      liab IS A BOOLEAN
      occ IS A BOOLEAN
      ended IS A BOOLEAN
      already IS A BOOLEAN
      free IS A BOOLEAN
      n IS A NUMBER
GIVETH A `Liability of an owner-occupier for a service charge payment`
`uc3 test — an owner-occupier's liability` code amount interval pay liab occ ended already free n MEANS
    `Liability of an owner-occupier for a service charge payment` WITH
        payment IS `uc3 test — a payment for Schedule 5` code
        `amount of each payment in pounds` IS amount
        `how often the payment falls due` IS interval
        `the owner-occupier meets the payment condition in respect of the relevant payment` IS pay
        `the owner-occupier meets the liability condition in respect of the relevant payment` IS liab
        `the owner-occupier meets the occupation condition in respect of the relevant payment` IS occ
        `the qualifying period has ended` IS ended
        `the payment has already been brought into account in relation to the same or a different owner-occupier` IS already
        `the arrangements provide for one or more service charge free periods` IS free
        `total number of the service charge payments which the owner-occupier is liable to make in that 12 month period` IS n
-- Expected: a relevant payment with the three conditions met, the qualifying period ended and not already counted gives TRUE; each of the six missing gives FALSE.
#ASSERT `Sch 5 para 8 — the payment is taken into account` (`uc3 test — an owner-occupier's liability` 0 100 `monthly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0) EQUALS TRUE
#ASSERT `Sch 5 para 8 — the payment is taken into account` (`uc3 test — an owner-occupier's liability` 0 100 `monthly payments` FALSE TRUE TRUE TRUE FALSE FALSE 0) EQUALS FALSE
#ASSERT `Sch 5 para 8 — the payment is taken into account` (`uc3 test — an owner-occupier's liability` 0 100 `monthly payments` TRUE FALSE TRUE TRUE FALSE FALSE 0) EQUALS FALSE
#ASSERT `Sch 5 para 8 — the payment is taken into account` (`uc3 test — an owner-occupier's liability` 0 100 `monthly payments` TRUE TRUE FALSE TRUE FALSE FALSE 0) EQUALS FALSE
#ASSERT `Sch 5 para 8 — the payment is taken into account` (`uc3 test — an owner-occupier's liability` 0 100 `monthly payments` TRUE TRUE TRUE FALSE FALSE FALSE 0) EQUALS FALSE
#ASSERT `Sch 5 para 8 — the payment is taken into account` (`uc3 test — an owner-occupier's liability` 0 100 `monthly payments` TRUE TRUE TRUE TRUE TRUE FALSE 0) EQUALS FALSE
#ASSERT `Sch 5 para 8 — the payment is taken into account` (`uc3 test — an owner-occupier's liability` 1 100 `monthly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0) EQUALS FALSE
-- Paragraph 13(3) and (4): the monthly equivalent. Expected: weekly 120 gives 520; four-weekly 480 gives 520; three-monthly 1560 gives 520; annual 6240 gives 520; monthly 520 gives 520;
-- with service charge free periods, weekly 120 and 48 payments in the 12 months give 120 x 48 / 12 = 480; the number of payments is not read when there are none (99 ignored: 520).
#ASSERT `Sch 5 para 13 — the monthly amount of a service charge payment` (`uc3 test — an owner-occupier's liability` 0 120 `weekly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0) EQUALS 520
#ASSERT `Sch 5 para 13 — the monthly amount of a service charge payment` (`uc3 test — an owner-occupier's liability` 0 480 `four-weekly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0) EQUALS 520
#ASSERT `Sch 5 para 13 — the monthly amount of a service charge payment` (`uc3 test — an owner-occupier's liability` 0 1560 `three-monthly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0) EQUALS 520
#ASSERT `Sch 5 para 13 — the monthly amount of a service charge payment` (`uc3 test — an owner-occupier's liability` 0 6240 `annual payments` TRUE TRUE TRUE TRUE FALSE FALSE 0) EQUALS 520
#ASSERT `Sch 5 para 13 — the monthly amount of a service charge payment` (`uc3 test — an owner-occupier's liability` 0 520 `monthly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0) EQUALS 520
#ASSERT `Sch 5 para 13 — the monthly amount of a service charge payment` (`uc3 test — an owner-occupier's liability` 0 120 `weekly payments` TRUE TRUE TRUE TRUE FALSE TRUE 48) EQUALS 480
#ASSERT `Sch 5 para 13 — the monthly amount of a service charge payment` (`uc3 test — an owner-occupier's liability` 0 120 `weekly payments` TRUE TRUE TRUE TRUE FALSE FALSE 99) EQUALS 520
-- Paragraph 13(5): a service charge free period is a period in which the owner-occupier has no liability to make one or more of the service charge payments taken into account. Expected: no liability gives TRUE; liability gives FALSE.
#ASSERT `Sch 5 para 13(5) — a service charge free period` (`Period of the arrangements for service charge payments` WITH `the owner-occupier has no liability in respect of the period to make one or more of the service charge payments which are to be taken into account under paragraph 8` IS TRUE) EQUALS TRUE
#ASSERT `Sch 5 para 13(5) — a service charge free period` (`Period of the arrangements for service charge payments` WITH `the owner-occupier has no liability in respect of the period to make one or more of the service charge payments which are to be taken into account under paragraph 8` IS FALSE) EQUALS FALSE
-- Paragraphs 9 and 13(2): the element is the total of the monthly amounts of the payments taken into account. Expected: weekly 120 (520) and monthly 30 (30) give 550;
-- a payment already brought into account adds nothing (550); a payment for which the qualifying period has not ended adds nothing (520 alone); no payments give 0.
#ASSERT `Sch 5 para 13 — the amount in respect of service charge payments` (LIST `uc3 test — an owner-occupier's liability` 0 120 `weekly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0, `uc3 test — an owner-occupier's liability` 0 30 `monthly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0) EQUALS 550
#ASSERT `Sch 5 para 9 — the amount of the owner-occupier's housing costs element` (LIST `uc3 test — an owner-occupier's liability` 0 120 `weekly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0, `uc3 test — an owner-occupier's liability` 0 30 `monthly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0) EQUALS 550
#ASSERT `Sch 5 para 9 — the amount of the owner-occupier's housing costs element` (LIST `uc3 test — an owner-occupier's liability` 0 120 `weekly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0, `uc3 test — an owner-occupier's liability` 0 30 `monthly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0, `uc3 test — an owner-occupier's liability` 0 1000 `monthly payments` TRUE TRUE TRUE TRUE TRUE FALSE 0) EQUALS 550
#ASSERT `Sch 5 para 9 — the amount of the owner-occupier's housing costs element` (LIST `uc3 test — an owner-occupier's liability` 0 120 `weekly payments` TRUE TRUE TRUE TRUE FALSE FALSE 0, `uc3 test — an owner-occupier's liability` 0 30 `monthly payments` TRUE TRUE TRUE FALSE FALSE FALSE 0) EQUALS 520
#ASSERT `Sch 5 para 9 — the amount of the owner-occupier's housing costs element` EMPTY EQUALS 0

-- ---------------------------------------------------------------------------------------------------------
-- Schedule 5A. The date everything turns on. Expected: 6 April 2026.
#ASSERT `Sch 5A — 6th April 2026` EQUALS YearMonthDay 2026 4 6

-- Paragraph 2: awaiting an assessment under Part 5 (regulation 41(1)(a)) before 6th April 2026; on or after it, determined to have LCWRA and a decision that the award includes the LCWRA element.
-- Sub-paragraph (2): the decision may be made on a revision, a supersession or an appeal. Expected: 5 April 2026 is before and 6 April 2026 is on or after: TRUE; awaiting on 6 April 2026 is not "before": FALSE;
-- determined on 5 April 2026 is not "on or after": FALSE; the route makes no difference: TRUE for each of the four.
GIVEN awaiting IS A DATE
      determined IS A DATE
      route IS A `Route by which a decision is made`
GIVETH A `Claimant awaiting an assessment under Part 5`
`uc3 test — a claimant awaiting an assessment` awaiting determined route MEANS
    `Claimant awaiting an assessment under Part 5` WITH
        `a day before 6th April 2026 on which, in accordance with regulation 41(1)(a), the claimant was awaiting an assessment under Part 5` IS awaiting
        `the day on or after 6th April 2026 on which the claimant is determined to have limited capability for work and work-related activity and a decision is made that the claimant is entitled to an award that includes the LCWRA element` IS determined
        `the route by which that decision is made` IS route
#ASSERT `Sch 5A para 2 — the claimant was awaiting an assessment before 6th April 2026 and is determined to have LCWRA on or after it` (`uc3 test — a claimant awaiting an assessment` (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 6) `an appeal`) EQUALS TRUE
#ASSERT `Sch 5A para 2 — the claimant was awaiting an assessment before 6th April 2026 and is determined to have LCWRA on or after it` (`uc3 test — a claimant awaiting an assessment` (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 6) `a revision of a decision under section 9 of the Social Security Act 1998`) EQUALS TRUE
#ASSERT `Sch 5A para 2 — the claimant was awaiting an assessment before 6th April 2026 and is determined to have LCWRA on or after it` (`uc3 test — a claimant awaiting an assessment` (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 6) `a supersession of a decision under section 10 of that Act`) EQUALS TRUE
#ASSERT `Sch 5A para 2 — the claimant was awaiting an assessment before 6th April 2026 and is determined to have LCWRA on or after it` (`uc3 test — a claimant awaiting an assessment` (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 6) `some other route`) EQUALS TRUE
#ASSERT `Sch 5A para 2 — the claimant was awaiting an assessment before 6th April 2026 and is determined to have LCWRA on or after it` (`uc3 test — a claimant awaiting an assessment` (YearMonthDay 2026 4 6) (YearMonthDay 2026 4 6) `an appeal`) EQUALS FALSE
#ASSERT `Sch 5A para 2 — the claimant was awaiting an assessment before 6th April 2026 and is determined to have LCWRA on or after it` (`uc3 test — a claimant awaiting an assessment` (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 5) `an appeal`) EQUALS FALSE
#ASSERT `Sch 5A para 2 — the claimant was awaiting an assessment before 6th April 2026 and is determined to have LCWRA on or after it` (`uc3 test — a claimant awaiting an assessment` (YearMonthDay 2025 1 1) (YearMonthDay 2027 1 1) `an appeal`) EQUALS TRUE

-- Paragraph 3: limited capability for work before 6th April 2026 and awaiting a further assessment (regulation 41(1)(b)); LCWRA determined on or after it.
-- Expected: 5 April, 5 April, 6 April: TRUE; any of the first two on 6 April 2026: FALSE; determined on 5 April 2026: FALSE.
GIVEN lcw IS A DATE
      awaiting IS A DATE
      determined IS A DATE
GIVETH A `Claimant with limited capability for work awaiting a further assessment`
`uc3 test — a claimant awaiting a further assessment` lcw awaiting determined MEANS
    `Claimant with limited capability for work awaiting a further assessment` WITH
        `a day before 6th April 2026 on which the claimant had limited capability for work` IS lcw
        `a day before 6th April 2026 on which, in accordance with regulation 41(1)(b), the claimant was awaiting a further assessment under Part 5` IS awaiting
        `the day on or after 6th April 2026 on which the claimant is determined to have limited capability for work and work-related activity and a decision is made that the claimant is entitled to an award that includes the LCWRA element` IS determined
        `the route by which that decision is made` IS `a supersession of a decision under section 10 of that Act`
#ASSERT `Sch 5A para 3 — limited capability for work and awaiting a further assessment before 6th April 2026` (`uc3 test — a claimant awaiting a further assessment` (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 6)) EQUALS TRUE
#ASSERT `Sch 5A para 3 — limited capability for work and awaiting a further assessment before 6th April 2026` (`uc3 test — a claimant awaiting a further assessment` (YearMonthDay 2026 4 6) (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 6)) EQUALS FALSE
#ASSERT `Sch 5A para 3 — limited capability for work and awaiting a further assessment before 6th April 2026` (`uc3 test — a claimant awaiting a further assessment` (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 6) (YearMonthDay 2026 4 6)) EQUALS FALSE
#ASSERT `Sch 5A para 3 — limited capability for work and awaiting a further assessment before 6th April 2026` (`uc3 test — a claimant awaiting a further assessment` (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 5)) EQUALS FALSE

-- Paragraph 4: LCWRA before 6th April 2026 but the award does not include the LCWRA element by virtue of regulation 28(1) (relevant period); the element is included on or after 6th April 2026.
-- Expected: 5 April, 5 April, 6 April: TRUE; either of the first two on 6 April: FALSE; included on 5 April 2026: FALSE.
GIVEN lcwra IS A DATE
      left IS A DATE
      included IS A DATE
GIVETH A `Claimant whose award does not include the LCWRA element on 6th April 2026`
`uc3 test — a claimant whose award leaves out the element` lcwra left included MEANS
    `Claimant whose award does not include the LCWRA element on 6th April 2026` WITH
        `a day before 6th April 2026 on which the claimant had limited capability for work and work-related activity` IS lcwra
        `a day before 6th April 2026 on which the claimant's award did not include the LCWRA element by virtue of regulation 28(1) (relevant period)` IS left
        `the day on or after 6th April 2026 on which the LCWRA element is included in the claimant's award of universal credit` IS included
#ASSERT `Sch 5A para 4 — LCWRA before 6th April 2026 with the element left out by regulation 28(1)` (`uc3 test — a claimant whose award leaves out the element` (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 6)) EQUALS TRUE
#ASSERT `Sch 5A para 4 — LCWRA before 6th April 2026 with the element left out by regulation 28(1)` (`uc3 test — a claimant whose award leaves out the element` (YearMonthDay 2026 4 6) (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 6)) EQUALS FALSE
#ASSERT `Sch 5A para 4 — LCWRA before 6th April 2026 with the element left out by regulation 28(1)` (`uc3 test — a claimant whose award leaves out the element` (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 6) (YearMonthDay 2026 4 6)) EQUALS FALSE
#ASSERT `Sch 5A para 4 — LCWRA before 6th April 2026 with the element left out by regulation 28(1)` (`uc3 test — a claimant whose award leaves out the element` (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 5) (YearMonthDay 2026 4 5)) EQUALS FALSE

-- Paragraph 5: entitled to an employment and support allowance with the support component before 6th April 2026, and so entitled throughout the period from 6th April 2026 to the date of an award that includes the LCWRA element.
-- Expected: 5 April and throughout: TRUE; 6 April: FALSE; not throughout: FALSE.
GIVEN day IS A DATE
      throughout IS A BOOLEAN
GIVETH A `Claimant entitled to an employment and support allowance before 6th April 2026`
`uc3 test — a claimant entitled to a support component` day throughout MEANS
    `Claimant entitled to an employment and support allowance before 6th April 2026` WITH
        `a day before 6th April 2026 on which the claimant was entitled to an employment and support allowance under Part 1 of the Welfare Reform Act 2007 that includes the support component within the meaning of that Part` IS day
        `the claimant has been so entitled throughout the period beginning with 6th April 2026 and ending with the date on which the claimant is awarded universal credit that includes the LCWRA element` IS throughout
#ASSERT `Sch 5A para 5 — entitled to an employment and support allowance before 6th April 2026` (`uc3 test — a claimant entitled to a support component` (YearMonthDay 2026 4 5) TRUE) EQUALS TRUE
#ASSERT `Sch 5A para 5 — entitled to an employment and support allowance before 6th April 2026` (`uc3 test — a claimant entitled to a support component` (YearMonthDay 2026 4 6) TRUE) EQUALS FALSE
#ASSERT `Sch 5A para 5 — entitled to an employment and support allowance before 6th April 2026` (`uc3 test — a claimant entitled to a support component` (YearMonthDay 2026 4 5) FALSE) EQUALS FALSE

-- Paragraph 1: a claimant with limited capability for work and work-related activity is a pre-2026 claimant if (a) entitled to an award including the LCWRA element by virtue of paragraph 2, 3, 4 or 5, and
-- (b) so entitled continuously from the time the element was included.
-- via: the paragraph (2 to 5) by virtue of which the claimant is entitled, or 0 for none; the other paragraphs' circumstances are made to fail by dating them on 6th April 2026.
GIVEN via IS A NUMBER
      lcwra IS A BOOLEAN
      entitled IS A BOOLEAN
      continuously IS A BOOLEAN
GIVETH A `Claimant who may be a pre-2026 claimant`
`uc3 test — a claimant who may be a pre-2026 claimant` via lcwra entitled continuously MEANS
    `Claimant who may be a pre-2026 claimant` WITH
        capability IS `Capability for work` WITH
            `limited capability for work` IS TRUE
            `limited capability for work and work-related activity` IS lcwra
            `severe conditions criteria claimant` IS FALSE
        `the claimant is entitled to an award of universal credit that includes the LCWRA element` IS entitled
        `the claimant has been so entitled continuously from the time that the LCWRA element was included in the award` IS continuously
        `circumstances of paragraph 2` IS `uc3 test — a claimant awaiting an assessment` (IF via EQUALS 2 THEN YearMonthDay 2026 4 5 ELSE YearMonthDay 2026 4 6) (YearMonthDay 2026 4 6) `an appeal`
        `circumstances of paragraph 3` IS `uc3 test — a claimant awaiting a further assessment` (IF via EQUALS 3 THEN YearMonthDay 2026 4 5 ELSE YearMonthDay 2026 4 6) (IF via EQUALS 3 THEN YearMonthDay 2026 4 5 ELSE YearMonthDay 2026 4 6) (YearMonthDay 2026 4 6)
        `circumstances of paragraph 4` IS `uc3 test — a claimant whose award leaves out the element` (IF via EQUALS 4 THEN YearMonthDay 2026 4 5 ELSE YearMonthDay 2026 4 6) (IF via EQUALS 4 THEN YearMonthDay 2026 4 5 ELSE YearMonthDay 2026 4 6) (YearMonthDay 2026 4 6)
        `circumstances of paragraph 5` IS `uc3 test — a claimant entitled to a support component` (IF via EQUALS 5 THEN YearMonthDay 2026 4 5 ELSE YearMonthDay 2026 4 6) TRUE
-- Expected: by virtue of each of paragraphs 2, 3, 4 and 5, with LCWRA, entitled and continuously: TRUE; by virtue of none: FALSE; without limited capability for work and work-related activity: FALSE;
-- not entitled to an award that includes the LCWRA element: FALSE; not continuously entitled: FALSE.
#ASSERT `Sch 5A para 1 — the claimant is a pre-2026 claimant` (`uc3 test — a claimant who may be a pre-2026 claimant` 2 TRUE TRUE TRUE) EQUALS TRUE
#ASSERT `Sch 5A para 1 — the claimant is a pre-2026 claimant` (`uc3 test — a claimant who may be a pre-2026 claimant` 3 TRUE TRUE TRUE) EQUALS TRUE
#ASSERT `Sch 5A para 1 — the claimant is a pre-2026 claimant` (`uc3 test — a claimant who may be a pre-2026 claimant` 4 TRUE TRUE TRUE) EQUALS TRUE
#ASSERT `Sch 5A para 1 — the claimant is a pre-2026 claimant` (`uc3 test — a claimant who may be a pre-2026 claimant` 5 TRUE TRUE TRUE) EQUALS TRUE
#ASSERT `Sch 5A para 1 — the claimant is a pre-2026 claimant` (`uc3 test — a claimant who may be a pre-2026 claimant` 0 TRUE TRUE TRUE) EQUALS FALSE
#ASSERT `Sch 5A para 1 — the claimant is a pre-2026 claimant` (`uc3 test — a claimant who may be a pre-2026 claimant` 2 FALSE TRUE TRUE) EQUALS FALSE
#ASSERT `Sch 5A para 1 — the claimant is a pre-2026 claimant` (`uc3 test — a claimant who may be a pre-2026 claimant` 2 TRUE FALSE TRUE) EQUALS FALSE
#ASSERT `Sch 5A para 1 — the claimant is a pre-2026 claimant` (`uc3 test — a claimant who may be a pre-2026 claimant` 2 TRUE TRUE FALSE) EQUALS FALSE
#ASSERT `Sch 5A para 1(a) — entitled to an award including the LCWRA element by virtue of one of paragraphs 2 to 5` (`uc3 test — a claimant who may be a pre-2026 claimant` 4 TRUE TRUE TRUE) EQUALS TRUE
#ASSERT `Sch 5A para 1(a) — entitled to an award including the LCWRA element by virtue of one of paragraphs 2 to 5` (`uc3 test — a claimant who may be a pre-2026 claimant` 0 TRUE TRUE TRUE) EQUALS FALSE
