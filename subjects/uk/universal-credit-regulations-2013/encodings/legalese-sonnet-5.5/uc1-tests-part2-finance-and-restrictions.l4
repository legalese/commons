IMPORT prelude
IMPORT `uc-core`
IMPORT `uc1-common`
IMPORT `uc1-part2-finance-and-restrictions`

-- Tests of uc1-part2-finance-and-restrictions.l4 (regulations 7, 17, 18 and 19). Every expected value is written by hand from the
-- text of the regulation named in the comment beside it, and none was copied from the output of the rule.

-- Regulation 7.
#ASSERT `reg 7 — entitlement to universal credit can arise` TRUE TRUE FALSE
#ASSERT NOT (`reg 7 — entitlement to universal credit can arise` FALSE TRUE FALSE)
#ASSERT NOT (`reg 7 — entitlement to universal credit can arise` TRUE FALSE FALSE)
-- Case (c): no entitlement arises even if the basic conditions and the financial conditions are met.
#ASSERT NOT (`reg 7 — entitlement to universal credit can arise` TRUE TRUE TRUE)

-- Regulation 17: the minimum is one penny.
#ASSERT `reg 17 — the minimum amount` EQUALS 0.01
#ASSERT `reg 17 — the amount payable is not less than the minimum` 0.01
#ASSERT `reg 17 — the amount payable is not less than the minimum` 250
#ASSERT NOT (`reg 17 — the amount payable is not less than the minimum` 0)
#ASSERT NOT (`reg 17 — the amount payable is not less than the minimum` 0.009)

-- Regulation 18(1): £16,000 for a single claimant and £16,000 for joint claimants.
#ASSERT `reg 18(1) — the prescribed capital amount` `a single claimant` EQUALS 16000
#ASSERT `reg 18(1) — the prescribed capital amount` `joint claimants` EQUALS 16000
#ASSERT `reg 18(1) — the prescribed capital amount` `a single claimant who is a member of a couple` EQUALS 16000
-- (2): a member of a couple who claims as a single person is treated as having the other member's capital too.
#ASSERT `reg 18(2) — the capital taken into account` `a single claimant` 9000 8000 EQUALS 9000
#ASSERT `reg 18(2) — the capital taken into account` `a single claimant who is a member of a couple` 9000 8000 EQUALS 17000
#ASSERT `reg 18(2) — the capital taken into account` `joint claimants` 9000 8000 EQUALS 17000
-- The limit: not more than £16,000.
#ASSERT `reg 18(1) — the capital is within the limit` `a single claimant` 16000
#ASSERT NOT (`reg 18(1) — the capital is within the limit` `a single claimant` 16000.01)
#ASSERT `reg 18(1) — the capital is within the limit` `joint claimants` 15999.99
#ASSERT NOT (`reg 18(1) — the capital is within the limit` `a single claimant who is a member of a couple` 17000)

-- Regulation 19(4): serving a sentence of imprisonment detained in hospital.
`a person detained under section 45A or 47 with no certified release date` MEANS `Person who may be serving a sentence of imprisonment detained in hospital` WITH
    `the person is being detained under section 45A or 47 of the Mental Health Act 1983` IS TRUE
    `release date that the Secretary of State certifies, within the meaning of section 50(3) of that Act` IS NOTHING
    `the person is being detained under section 59A of the Criminal Procedure (Scotland) Act 1995` IS FALSE
    `the person is being detained under section 136 of the Mental Health (Care and Treatment) (Scotland) Act 2003` IS FALSE
`a person detained under section 45A or 47 with a release date of 1 June 2026` MEANS `Person who may be serving a sentence of imprisonment detained in hospital` WITH
    `the person is being detained under section 45A or 47 of the Mental Health Act 1983` IS TRUE
    `release date that the Secretary of State certifies, within the meaning of section 50(3) of that Act` IS JUST (YMD 2026 6 1)
    `the person is being detained under section 59A of the Criminal Procedure (Scotland) Act 1995` IS FALSE
    `the person is being detained under section 136 of the Mental Health (Care and Treatment) (Scotland) Act 2003` IS FALSE
`a person detained under section 59A of the Criminal Procedure (Scotland) Act 1995` MEANS `Person who may be serving a sentence of imprisonment detained in hospital` WITH
    `the person is being detained under section 45A or 47 of the Mental Health Act 1983` IS FALSE
    `release date that the Secretary of State certifies, within the meaning of section 50(3) of that Act` IS NOTHING
    `the person is being detained under section 59A of the Criminal Procedure (Scotland) Act 1995` IS TRUE
    `the person is being detained under section 136 of the Mental Health (Care and Treatment) (Scotland) Act 2003` IS FALSE
`a person detained under section 136 of the Scottish 2003 Act` MEANS `Person who may be serving a sentence of imprisonment detained in hospital` WITH
    `the person is being detained under section 45A or 47 of the Mental Health Act 1983` IS FALSE
    `release date that the Secretary of State certifies, within the meaning of section 50(3) of that Act` IS NOTHING
    `the person is being detained under section 59A of the Criminal Procedure (Scotland) Act 1995` IS FALSE
    `the person is being detained under section 136 of the Mental Health (Care and Treatment) (Scotland) Act 2003` IS TRUE
`a person not detained under any of the sections` MEANS `Person who may be serving a sentence of imprisonment detained in hospital` WITH
    `the person is being detained under section 45A or 47 of the Mental Health Act 1983` IS FALSE
    `release date that the Secretary of State certifies, within the meaning of section 50(3) of that Act` IS JUST (YMD 2026 6 1)
    `the person is being detained under section 59A of the Criminal Procedure (Scotland) Act 1995` IS FALSE
    `the person is being detained under section 136 of the Mental Health (Care and Treatment) (Scotland) Act 2003` IS FALSE
#ASSERT `reg 19(4) — the person is serving a sentence of imprisonment detained in hospital` `a person detained under section 45A or 47 with no certified release date` (YMD 2026 1 1)
#ASSERT `reg 19(4) — the person is serving a sentence of imprisonment detained in hospital` `a person detained under section 45A or 47 with a release date of 1 June 2026` (YMD 2026 5 31)
#ASSERT NOT (`reg 19(4) — the person is serving a sentence of imprisonment detained in hospital` `a person detained under section 45A or 47 with a release date of 1 June 2026` (YMD 2026 6 1))
#ASSERT `reg 19(4) — the person is serving a sentence of imprisonment detained in hospital` `a person detained under section 59A of the Criminal Procedure (Scotland) Act 1995` (YMD 2030 1 1)
#ASSERT `reg 19(4) — the person is serving a sentence of imprisonment detained in hospital` `a person detained under section 136 of the Scottish 2003 Act` (YMD 2030 1 1)
#ASSERT NOT (`reg 19(4) — the person is serving a sentence of imprisonment detained in hospital` `a person not detained under any of the sections` (YMD 2026 1 1))

-- Regulation 19(2): the first 6 months of a prisoner who became one on 10 January 2026 end on 9 July 2026.
#ASSERT `reg 19(2) — paragraph (1)(b) does not apply` (YMD 2026 1 10) (YMD 2026 1 10) TRUE TRUE FALSE
#ASSERT `reg 19(2) — paragraph (1)(b) does not apply` (YMD 2026 1 10) (YMD 2026 7 9) TRUE TRUE FALSE
#ASSERT NOT (`reg 19(2) — paragraph (1)(b) does not apply` (YMD 2026 1 10) (YMD 2026 7 10) TRUE TRUE FALSE)
#ASSERT NOT (`reg 19(2) — paragraph (1)(b) does not apply` (YMD 2026 1 10) (YMD 2026 1 9) TRUE TRUE FALSE)
-- Both conditions in (a) are needed, and (b) fails if the sentence is expected to extend beyond the 6 months.
#ASSERT NOT (`reg 19(2) — paragraph (1)(b) does not apply` (YMD 2026 1 10) (YMD 2026 3 1) FALSE TRUE FALSE)
#ASSERT NOT (`reg 19(2) — paragraph (1)(b) does not apply` (YMD 2026 1 10) (YMD 2026 3 1) TRUE FALSE FALSE)
#ASSERT NOT (`reg 19(2) — paragraph (1)(b) does not apply` (YMD 2026 1 10) (YMD 2026 3 1) TRUE TRUE TRUE)

-- Regulation 19(1).
#ASSERT `reg 19(1) — entitlement does not arise` TRUE FALSE FALSE FALSE
#ASSERT `reg 19(1) — entitlement does not arise` FALSE TRUE FALSE FALSE
#ASSERT NOT (`reg 19(1) — entitlement does not arise` FALSE TRUE TRUE FALSE)
#ASSERT `reg 19(1) — entitlement does not arise` FALSE FALSE FALSE TRUE
#ASSERT NOT (`reg 19(1) — entitlement does not arise` FALSE FALSE FALSE FALSE)
-- A prisoner within paragraph (2) who is also detained in hospital serving a sentence is still excluded under (1)(c).
#ASSERT `reg 19(1) — entitlement does not arise` FALSE TRUE TRUE TRUE

-- Regulation 19(3): a prisoner within paragraph (2) has only the housing costs element.
#ASSERT `reg 19(3) — the award may include the element` `housing costs element` TRUE
#ASSERT NOT (`reg 19(3) — the award may include the element` `standard allowance` TRUE)
#ASSERT NOT (`reg 19(3) — the award may include the element` `child element` TRUE)
#ASSERT NOT (`reg 19(3) — the award may include the element` `LCWRA element` TRUE)
#ASSERT NOT (`reg 19(3) — the award may include the element` `carer element` TRUE)
#ASSERT NOT (`reg 19(3) — the award may include the element` `childcare costs element` TRUE)
#ASSERT `reg 19(3) — the award may include the element` `standard allowance` FALSE
#ASSERT `reg 19(3) — the award may include the element` `childcare costs element` FALSE
