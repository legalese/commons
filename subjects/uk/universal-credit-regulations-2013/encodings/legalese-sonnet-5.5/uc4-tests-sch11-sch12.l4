IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-persons`
IMPORT `uc4-part8-ch2-reduction-periods`
IMPORT `uc4-sch11-sanctions`
IMPORT `uc4-sch12-omitted`

-- Tests of uc4-sch11-sanctions.l4 and uc4-sch12-omitted.l4: Schedule 11 and the omitted Schedule 12.
-- Expected values are written by hand from the text, beside the assertion.

GIVEN found IS A MAYBE `Previous sanctionable failure`
GIVETH A NUMBER
`test — period of` found MEANS
    CONSIDER found
    WHEN NOTHING THEN 0
    WHEN JUST p THEN p's `reduction period applicable to the previous sanctionable failure, in days`

-- The previous failure the caller says corresponds: 91 days, higher-level, on 1 March 2026.
`test — the corresponding failure` MEANS `Previous sanctionable failure` WITH
    `date of the previous sanctionable failure` IS YearMonthDay 2026 3 1
    `reduction period applicable to the previous sanctionable failure, in days` IS 91
    `the previous sanctionable failure was a pre-claim failure` IS FALSE
    `the previous sanctionable failure gave rise to a higher-level sanction` IS TRUE
    `the previous sanctionable failure falls within regulation 103(1)` IS FALSE
    `the previous sanctionable failure falls within regulation 104(1)` IS FALSE

-- Paragraph 1(1) and (2).
#ASSERT `Sch 11 para 1(1) — this paragraph applies` TRUE TRUE TRUE
#ASSERT NOT (`Sch 11 para 1(1) — this paragraph applies` FALSE TRUE TRUE)
#ASSERT NOT (`Sch 11 para 1(1) — this paragraph applies` TRUE FALSE TRUE)
#ASSERT NOT (`Sch 11 para 1(1) — this paragraph applies` TRUE TRUE FALSE)
#ASSERT `Sch 11 para 1(2) — the reduction is applied to the award of universal credit` TRUE
#ASSERT NOT (`Sch 11 para 1(2) — the reduction is applied to the award of universal credit` FALSE)

-- Paragraph 1(3): 91 days under regulations 52 and 53, 20 already served, the ESA award not terminated: 71.
#ASSERT `Sch 11 para 1(3) — the period for which the reduction is to have effect` 91 20 NOTHING (YearMonthDay 2026 4 10) EQUALS 71
-- The ESA award terminated on 31 March 2026 and universal credit starts on 10 April 2026: the 9 days 1 to 9 April come off: 62.
#ASSERT `Sch 11 para 1(3) — the period for which the reduction is to have effect` 91 20 (JUST (YearMonthDay 2026 3 31)) (YearMonthDay 2026 4 10) EQUALS 62
-- Universal credit starting the day after the termination leaves no days between.
#ASSERT `Sch 11 para 1(3) — the period for which the reduction is to have effect` 91 20 (JUST (YearMonthDay 2026 3 31)) (YearMonthDay 2026 4 1) EQUALS 71
-- Universal credit starting before the termination (an overlap): no days to take off.
#ASSERT `Sch 11 para 1(3) — the period for which the reduction is to have effect` 91 20 (JUST (YearMonthDay 2026 3 31)) (YearMonthDay 2026 3 30) EQUALS 71
-- More already served than apply: not below nought (fork F-sch11-1).
#ASSERT `Sch 11 para 1(3) — the period for which the reduction is to have effect` 10 20 NOTHING (YearMonthDay 2026 4 10) EQUALS 0
#ASSERT `Sch 11 para 1(3) — the period for which the reduction is to have effect` 91 20 (JUST (YearMonthDay 2026 3 31)) (YearMonthDay 2026 7 31) EQUALS 0
-- ... added to a total outstanding reduction period of 100 days.
#ASSERT `Sch 11 para 1(3) — the total outstanding reduction period once the period is added` 100 62 EQUALS 162
#ASSERT `Sch 11 para 1(4) — the amount of the reduction is the amount calculated in accordance with regulation 110` EQUALS "The amount of the reduction in the award of universal credit for any assessment period in which the reduction is applied is the amount calculated in accordance with regulation 110."

-- Paragraph 2(1) and (2).
#ASSERT `Sch 11 para 2(1) — this paragraph applies` TRUE TRUE TRUE
#ASSERT NOT (`Sch 11 para 2(1) — this paragraph applies` FALSE TRUE TRUE)
#ASSERT NOT (`Sch 11 para 2(1) — this paragraph applies` TRUE FALSE TRUE)
#ASSERT NOT (`Sch 11 para 2(1) — this paragraph applies` TRUE TRUE FALSE)
#ASSERT `Sch 11 para 2(2) — the reduction is applied to the award of universal credit` TRUE
#ASSERT NOT (`Sch 11 para 2(2) — the reduction is applied to the award of universal credit` FALSE)

-- Paragraph 2(3): the same arithmetic with the Jobseeker's Allowance Regulations 2013.
#ASSERT `Sch 11 para 2(3) — the period for which the reduction is to have effect` 28 7 NOTHING (YearMonthDay 2026 4 10) EQUALS 21
#ASSERT `Sch 11 para 2(3) — the period for which the reduction is to have effect` 28 7 (JUST (YearMonthDay 2026 3 31)) (YearMonthDay 2026 4 10) EQUALS 12
#ASSERT `Sch 11 para 2(3) — the period for which the reduction is to have effect` 28 7 (JUST (YearMonthDay 2026 3 31)) (YearMonthDay 2026 4 1) EQUALS 21
#ASSERT `Sch 11 para 2(3) — the period for which the reduction is to have effect` 5 7 NOTHING (YearMonthDay 2026 4 10) EQUALS 0
#ASSERT `Sch 11 para 2(3) — the total outstanding reduction period once the period is added` 0 21 EQUALS 21
#ASSERT `Sch 11 para 2(4) — the amount of the reduction is the amount calculated in accordance with regulation 110` EQUALS "The amount of the reduction in the award of universal credit for any assessment period in which the reduction is applied is the amount calculated in accordance with regulation 110."

-- Paragraph 3: the three conditions together; then the previous failure counts as the corresponding one.
#ASSERT `test — period of` (`Sch 11 para 3 — the previous failure is treated as the corresponding failure` TRUE TRUE TRUE `test — the corresponding failure`) EQUALS 91
#ASSERT `Sch 11 para 3 — the previous failure is treated as the corresponding failure` FALSE TRUE TRUE `test — the corresponding failure` EQUALS NOTHING
#ASSERT `Sch 11 para 3 — the previous failure is treated as the corresponding failure` TRUE FALSE TRUE `test — the corresponding failure` EQUALS NOTHING
#ASSERT `Sch 11 para 3 — the previous failure is treated as the corresponding failure` TRUE TRUE FALSE `test — the corresponding failure` EQUALS NOTHING
-- Treated as the corresponding failure, it escalates the next higher-level sanction: aged 25, 92 days after it, 182 days.
#ASSERT `reg 102(2) — the reduction period for a sanctionable failure that is not a pre-claim failure` 25 (YearMonthDay 2026 6 1) (LIST `test — the corresponding failure`) EQUALS JUST 182

-- Schedule 12 is a title and six headings over runs of dots: each heading is cited and says it is not encoded.
#ASSERT `Sch 12 para 1 — a heading over a run of dots in the text, not encoded` EQUALS "1 ...Introduction"
#ASSERT `Sch 12 para 2 — a heading over a run of dots in the text, not encoded` EQUALS "2 Multiple births"
#ASSERT `Sch 12 para 3 — a heading over a run of dots in the text, not encoded` EQUALS "3 Adoptions"
#ASSERT `Sch 12 para 4 — a heading over a run of dots in the text, not encoded` EQUALS "4 Non-parental caring arrangements"
#ASSERT `Sch 12 para 5 — a heading over a run of dots in the text, not encoded` EQUALS "5 Non-consensual conception"
#ASSERT `Sch 12 para 6 — a heading over a run of dots in the text, not encoded` EQUALS "6 Continuation of existing exception in a subsequent award"
