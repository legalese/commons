-- ---------------------------------------------------------------------------------------------------------
-- Schedule 4 paragraphs 27 and 28: the specified renter, and the category of accommodation.

GIVEN basis IS A `Claim basis`
      age IS A NUMBER
      limb IS A NUMBER
      children IS A BOOLEAN
      nondependant IS A BOOLEAN
GIVETH A `Renter who may be a specified renter`
`uc3 test — a renter who may be specified` basis age limb children nondependant MEANS
    `Renter who may be a specified renter` WITH
        `claim basis` IS basis
        `the renter as a possible excepted person` IS `uc3 test — a renter who may be an excepted person` age England limb EMPTY
        `the renter is responsible for any children or qualifying young persons` IS children
        `any person is a non-dependant in relation to the renter` IS nondependant

-- Para 28: a specified renter is a single person (or a member of a couple claiming as a single person) under 35, not an excepted person, with no children or qualifying young persons and no non-dependant.
-- Expected: a single claimant of 30 with nothing else TRUE; the same as a single claimant who is a member of a couple TRUE; joint claimants FALSE; age 34 TRUE; age 35 FALSE;
-- an excepted person (positive conclusive grounds determination) FALSE; responsible for a child FALSE; with a non-dependant FALSE.
#ASSERT `Sch 4 para 28(1) — a specified renter` (`uc3 test — a renter who may be specified` `a single claimant` 30 0 FALSE FALSE) EQUALS TRUE
#ASSERT `Sch 4 para 28(1) — a specified renter` (`uc3 test — a renter who may be specified` `a single claimant who is a member of a couple` 30 0 FALSE FALSE) EQUALS TRUE
#ASSERT `Sch 4 para 28(1) — a specified renter` (`uc3 test — a renter who may be specified` `joint claimants` 30 0 FALSE FALSE) EQUALS FALSE
#ASSERT `Sch 4 para 28(1) — a specified renter` (`uc3 test — a renter who may be specified` `a single claimant` 34 0 FALSE FALSE) EQUALS TRUE
#ASSERT `Sch 4 para 28(1) — a specified renter` (`uc3 test — a renter who may be specified` `a single claimant` 35 0 FALSE FALSE) EQUALS FALSE
#ASSERT `Sch 4 para 28(1) — a specified renter` (`uc3 test — a renter who may be specified` `a single claimant` 30 93 FALSE FALSE) EQUALS FALSE
#ASSERT `Sch 4 para 28(1) — a specified renter` (`uc3 test — a renter who may be specified` `a single claimant` 30 0 TRUE FALSE) EQUALS FALSE
#ASSERT `Sch 4 para 28(1) — a specified renter` (`uc3 test — a renter who may be specified` `a single claimant` 30 0 FALSE TRUE) EQUALS FALSE

-- Para 27(1): a specified renter is entitled to shared accommodation only; any other renter to the number of bedrooms from paragraph 26.
-- The helper returns the number of bedrooms, or 0 for shared accommodation (which has no bedroom count in the text).
GIVEN category IS A `Category of accommodation`
GIVETH A NUMBER
`uc3 test — the number of bedrooms in a category of accommodation` category MEANS
    CONSIDER category
    WHEN `shared accommodation` THEN 0
    WHEN `accommodation of a size given by a number of bedrooms` n THEN n
-- Expected: a specified renter with a unit of three bedrooms gets shared accommodation (0 in the helper); a renter who is not specified gets 3; one who is not specified with a unit of 6 gets 4 (para 26).
#ASSERT `uc3 test — the number of bedrooms in a category of accommodation` (`Sch 4 para 27(1) — the category of accommodation to which a renter is entitled under Part 4` TRUE (`uc3 test — a unit with no additional bedroom` 1 1 0 0 0 0)) EQUALS 0
#ASSERT `uc3 test — the number of bedrooms in a category of accommodation` (`Sch 4 para 27(1) — the category of accommodation to which a renter is entitled under Part 4` FALSE (`uc3 test — a unit with no additional bedroom` 1 1 0 0 0 0)) EQUALS 3
#ASSERT `uc3 test — the number of bedrooms in a category of accommodation` (`Sch 4 para 27(1) — the category of accommodation to which a renter is entitled under Part 4` FALSE (`uc3 test — a unit with no additional bedroom` 3 2 0 0 0 0)) EQUALS 4
