@ref reg 83(1) (src:1322-1347)
DECLARE `Member of the household for regulation 83` HAS
    role                   IS A `Person in the household`
    payments               IS A LIST OF `Payment to a person for regulation 83`

-- src:1322 | 83 Exceptions - entitlement or receipt of certain benefits
-- src:1323 | (1) The benefit cap does not apply in relation to any assessment period where—
-- src:1324 | (a) the LCWRA element is included in the award of universal credit or the claimant is receiving an employment and support allowance that includes the support component;
-- src:1325 | (b) a claimant is receiving industrial injuries benefit;
-- src:1326 | (c) a claimant is receiving attendance allowance;
-- src:1327 | (ca) a claimant is receiving pension age disability payment;
-- src:1328 | (d) a claimant is receiving a war pension;
-- src:1329 | (e) a claimant is receiving a payment under article 15(1)(c) or article 29(1)(a) of the Armed Forces and Reserve Forces (Compensation Scheme) Order 2011;
-- src:1330 | (f) a claimant, or a child or qualifying young person for whom a claimant is responsible, is receiving disability living allowance;
-- src:1331 | (fa) a claimant, or qualifying young person for whom a claimant is responsible, is receiving Scottish adult disability living allowance;
-- src:1332 | (g) a claimant, or a qualifying young person for whom a claimant is responsible, is receiving personal independence payment;
