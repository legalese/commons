IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-payments`

-- Tests for uc-core-payments.l4. Expected values are written by hand from the text of regulation 2, not read from the encoding's output.

-- attendance allowance (lines 18-24): limbs (a), (b), (d), (e), (f); limb (c) is blank in this text.
-- limb (a)
#ASSERT `reg 2 — attendance allowance` (`Payment that may be an attendance allowance` WITH `attendance allowance under section 64 of the Contributions and Benefits Act` IS TRUE, `increase of disablement pension under section 104 or 105 of that Act` IS FALSE, `payment by virtue of article 14, 15, 16, 43 or 44 of the Personal Injuries (Civilians) Scheme 1983 or any analogous payment` IS FALSE, `payment based on the need for attendance which is paid as an addition to a war disablement pension` IS FALSE, `armed forces independence payment under the Armed Forces and Reserve Forces (Compensation Scheme) Order 2011` IS FALSE) EQUALS TRUE
-- limb (b)
#ASSERT `reg 2 — attendance allowance` (`Payment that may be an attendance allowance` WITH `attendance allowance under section 64 of the Contributions and Benefits Act` IS FALSE, `increase of disablement pension under section 104 or 105 of that Act` IS TRUE, `payment by virtue of article 14, 15, 16, 43 or 44 of the Personal Injuries (Civilians) Scheme 1983 or any analogous payment` IS FALSE, `payment based on the need for attendance which is paid as an addition to a war disablement pension` IS FALSE, `armed forces independence payment under the Armed Forces and Reserve Forces (Compensation Scheme) Order 2011` IS FALSE) EQUALS TRUE
-- limb (d)
#ASSERT `reg 2 — attendance allowance` (`Payment that may be an attendance allowance` WITH `attendance allowance under section 64 of the Contributions and Benefits Act` IS FALSE, `increase of disablement pension under section 104 or 105 of that Act` IS FALSE, `payment by virtue of article 14, 15, 16, 43 or 44 of the Personal Injuries (Civilians) Scheme 1983 or any analogous payment` IS TRUE, `payment based on the need for attendance which is paid as an addition to a war disablement pension` IS FALSE, `armed forces independence payment under the Armed Forces and Reserve Forces (Compensation Scheme) Order 2011` IS FALSE) EQUALS TRUE
-- limb (e)
#ASSERT `reg 2 — attendance allowance` (`Payment that may be an attendance allowance` WITH `attendance allowance under section 64 of the Contributions and Benefits Act` IS FALSE, `increase of disablement pension under section 104 or 105 of that Act` IS FALSE, `payment by virtue of article 14, 15, 16, 43 or 44 of the Personal Injuries (Civilians) Scheme 1983 or any analogous payment` IS FALSE, `payment based on the need for attendance which is paid as an addition to a war disablement pension` IS TRUE, `armed forces independence payment under the Armed Forces and Reserve Forces (Compensation Scheme) Order 2011` IS FALSE) EQUALS TRUE
-- limb (f)
#ASSERT `reg 2 — attendance allowance` (`Payment that may be an attendance allowance` WITH `attendance allowance under section 64 of the Contributions and Benefits Act` IS FALSE, `increase of disablement pension under section 104 or 105 of that Act` IS FALSE, `payment by virtue of article 14, 15, 16, 43 or 44 of the Personal Injuries (Civilians) Scheme 1983 or any analogous payment` IS FALSE, `payment based on the need for attendance which is paid as an addition to a war disablement pension` IS FALSE, `armed forces independence payment under the Armed Forces and Reserve Forces (Compensation Scheme) Order 2011` IS TRUE) EQUALS TRUE
-- none of the five
#ASSERT `reg 2 — attendance allowance` (`Payment that may be an attendance allowance` WITH `attendance allowance under section 64 of the Contributions and Benefits Act` IS FALSE, `increase of disablement pension under section 104 or 105 of that Act` IS FALSE, `payment by virtue of article 14, 15, 16, 43 or 44 of the Personal Injuries (Civilians) Scheme 1983 or any analogous payment` IS FALSE, `payment based on the need for attendance which is paid as an addition to a war disablement pension` IS FALSE, `armed forces independence payment under the Armed Forces and Reserve Forces (Compensation Scheme) Order 2011` IS FALSE) EQUALS FALSE
-- two limbs at once
#ASSERT `reg 2 — attendance allowance` (`Payment that may be an attendance allowance` WITH `attendance allowance under section 64 of the Contributions and Benefits Act` IS TRUE, `increase of disablement pension under section 104 or 105 of that Act` IS FALSE, `payment by virtue of article 14, 15, 16, 43 or 44 of the Personal Injuries (Civilians) Scheme 1983 or any analogous payment` IS FALSE, `payment based on the need for attendance which is paid as an addition to a war disablement pension` IS TRUE, `armed forces independence payment under the Armed Forces and Reserve Forces (Compensation Scheme) Order 2011` IS FALSE) EQUALS TRUE

-- war disablement pension (line 112): any retired pay, pension or allowance payable in respect of disablement under an instrument specified in section 639(2) of ITEPA.
-- all three
#ASSERT `reg 2 — war disablement pension` (`Payment that may be a war disablement pension` WITH `retired pay, pension or allowance` IS TRUE, `payable in respect of disablement` IS TRUE, `payable under an instrument specified in section 639(2) of ITEPA` IS TRUE) EQUALS TRUE
-- not payable under an instrument specified in section 639(2) of ITEPA
#ASSERT `reg 2 — war disablement pension` (`Payment that may be a war disablement pension` WITH `retired pay, pension or allowance` IS TRUE, `payable in respect of disablement` IS TRUE, `payable under an instrument specified in section 639(2) of ITEPA` IS FALSE) EQUALS FALSE
-- not payable in respect of disablement
#ASSERT `reg 2 — war disablement pension` (`Payment that may be a war disablement pension` WITH `retired pay, pension or allowance` IS TRUE, `payable in respect of disablement` IS FALSE, `payable under an instrument specified in section 639(2) of ITEPA` IS TRUE) EQUALS FALSE
-- not retired pay, a pension or an allowance
#ASSERT `reg 2 — war disablement pension` (`Payment that may be a war disablement pension` WITH `retired pay, pension or allowance` IS FALSE, `payable in respect of disablement` IS TRUE, `payable under an instrument specified in section 639(2) of ITEPA` IS TRUE) EQUALS FALSE
