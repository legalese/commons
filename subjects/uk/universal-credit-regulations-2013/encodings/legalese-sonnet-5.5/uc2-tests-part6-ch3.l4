#ASSERT `reg 74(3) — the retirement pension income the person is treated as possessing` TRUE TRUE 150.555 EQUALS JUST 150.56
#ASSERT `reg 74(3) — the retirement pension income the person is treated as possessing` FALSE TRUE 150.5 EQUALS NOTHING
#ASSERT `reg 74(3) — the retirement pension income the person is treated as possessing` TRUE FALSE 150.5 EQUALS NOTHING
