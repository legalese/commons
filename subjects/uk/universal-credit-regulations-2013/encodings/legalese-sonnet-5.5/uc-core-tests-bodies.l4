IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-bodies`

-- Tests for uc-core-bodies.l4. Expected values are written by hand from the text of regulation 2, not read from the encoding's output.

-- local authority (lines 62-65). England: county, district, parish, London borough, the Common Council of the City of London, the Council of the Isles of Scilly.
-- Wales: county, county borough, community. Scotland: a council constituted under section 2 of the Local Government etc. (Scotland) Act 1994.
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS England, `kind of body` IS `a county council`) EQUALS TRUE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS England, `kind of body` IS `a district council`) EQUALS TRUE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS England, `kind of body` IS `a parish council`) EQUALS TRUE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS England, `kind of body` IS `a London borough council`) EQUALS TRUE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS England, `kind of body` IS `the Common Council of the City of London`) EQUALS TRUE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS England, `kind of body` IS `the Council of the Isles of Scilly`) EQUALS TRUE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS England, `kind of body` IS `a county borough council`) EQUALS FALSE
-- a community council is Welsh only
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS England, `kind of body` IS `a community council`) EQUALS FALSE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS England, `kind of body` IS `another kind of body`) EQUALS FALSE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS Wales, `kind of body` IS `a county council`) EQUALS TRUE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS Wales, `kind of body` IS `a county borough council`) EQUALS TRUE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS Wales, `kind of body` IS `a community council`) EQUALS TRUE
-- a district council, a parish council and the City of London are English only
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS Wales, `kind of body` IS `a district council`) EQUALS FALSE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS Wales, `kind of body` IS `a parish council`) EQUALS FALSE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS Wales, `kind of body` IS `the Common Council of the City of London`) EQUALS FALSE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS Wales, `kind of body` IS `another kind of body`) EQUALS FALSE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS Scotland, `kind of body` IS `a council constituted under section 2 of the Local Government etc. (Scotland) Act 1994`) EQUALS TRUE
-- a county council in Scotland is not on the Scottish list
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS Scotland, `kind of body` IS `a county council`) EQUALS FALSE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS Scotland, `kind of body` IS `a community council`) EQUALS FALSE
#ASSERT `reg 2 — local authority` (`Body that may be a local authority` WITH `nation of Great Britain in relation to which it is asked` IS Scotland, `kind of body` IS `another kind of body`) EQUALS FALSE

-- local welfare provision (lines 66-72).
-- a local authority meets an immediate need that arose from an exceptional event and must be met to avoid risk to well-being: limb (a)
#ASSERT `reg 2 — local welfare provision` (`Assistance given to individuals` WITH `giver` IS `a local authority`, `assistance is occasional financial or other assistance` IS TRUE, `purpose is meeting, or helping to meet, an immediate short term need` IS TRUE, `need arises out of an exceptional event, or exceptional circumstances` IS TRUE, `need requires to be met in order to avoid a risk to the well-being of an individual` IS TRUE, `purpose is enabling individuals to establish or maintain a settled home` IS FALSE, `individuals have been or, without the assistance, might otherwise be in prison, hospital, a residential care establishment or other institution` IS FALSE, `individuals have been or, without the assistance, might otherwise be homeless or otherwise living an unsettled way of life` IS FALSE) EQUALS TRUE
-- limb (a) fails: the need does not require meeting to avoid a risk to well-being
#ASSERT `reg 2 — local welfare provision` (`Assistance given to individuals` WITH `giver` IS `a local authority`, `assistance is occasional financial or other assistance` IS TRUE, `purpose is meeting, or helping to meet, an immediate short term need` IS TRUE, `need arises out of an exceptional event, or exceptional circumstances` IS TRUE, `need requires to be met in order to avoid a risk to the well-being of an individual` IS FALSE, `purpose is enabling individuals to establish or maintain a settled home` IS FALSE, `individuals have been or, without the assistance, might otherwise be in prison, hospital, a residential care establishment or other institution` IS FALSE, `individuals have been or, without the assistance, might otherwise be homeless or otherwise living an unsettled way of life` IS FALSE) EQUALS FALSE
-- limb (a) fails: the need did not arise from an exceptional event or exceptional circumstances
#ASSERT `reg 2 — local welfare provision` (`Assistance given to individuals` WITH `giver` IS `a local authority`, `assistance is occasional financial or other assistance` IS TRUE, `purpose is meeting, or helping to meet, an immediate short term need` IS TRUE, `need arises out of an exceptional event, or exceptional circumstances` IS FALSE, `need requires to be met in order to avoid a risk to the well-being of an individual` IS TRUE, `purpose is enabling individuals to establish or maintain a settled home` IS FALSE, `individuals have been or, without the assistance, might otherwise be in prison, hospital, a residential care establishment or other institution` IS FALSE, `individuals have been or, without the assistance, might otherwise be homeless or otherwise living an unsettled way of life` IS FALSE) EQUALS FALSE
-- limb (b), (i): helping people leaving prison to establish a settled home
#ASSERT `reg 2 — local welfare provision` (`Assistance given to individuals` WITH `giver` IS `a local authority`, `assistance is occasional financial or other assistance` IS TRUE, `purpose is meeting, or helping to meet, an immediate short term need` IS FALSE, `need arises out of an exceptional event, or exceptional circumstances` IS FALSE, `need requires to be met in order to avoid a risk to the well-being of an individual` IS FALSE, `purpose is enabling individuals to establish or maintain a settled home` IS TRUE, `individuals have been or, without the assistance, might otherwise be in prison, hospital, a residential care establishment or other institution` IS TRUE, `individuals have been or, without the assistance, might otherwise be homeless or otherwise living an unsettled way of life` IS FALSE) EQUALS TRUE
-- limb (b), (ii): helping people who are homeless to establish a settled home
#ASSERT `reg 2 — local welfare provision` (`Assistance given to individuals` WITH `giver` IS `the Scottish Ministers`, `assistance is occasional financial or other assistance` IS TRUE, `purpose is meeting, or helping to meet, an immediate short term need` IS FALSE, `need arises out of an exceptional event, or exceptional circumstances` IS FALSE, `need requires to be met in order to avoid a risk to the well-being of an individual` IS FALSE, `purpose is enabling individuals to establish or maintain a settled home` IS TRUE, `individuals have been or, without the assistance, might otherwise be in prison, hospital, a residential care establishment or other institution` IS FALSE, `individuals have been or, without the assistance, might otherwise be homeless or otherwise living an unsettled way of life` IS TRUE) EQUALS TRUE
-- limb (b) fails: a settled home, but the people are neither in an institution nor homeless
#ASSERT `reg 2 — local welfare provision` (`Assistance given to individuals` WITH `giver` IS `a local authority`, `assistance is occasional financial or other assistance` IS TRUE, `purpose is meeting, or helping to meet, an immediate short term need` IS FALSE, `need arises out of an exceptional event, or exceptional circumstances` IS FALSE, `need requires to be met in order to avoid a risk to the well-being of an individual` IS FALSE, `purpose is enabling individuals to establish or maintain a settled home` IS TRUE, `individuals have been or, without the assistance, might otherwise be in prison, hospital, a residential care establishment or other institution` IS FALSE, `individuals have been or, without the assistance, might otherwise be homeless or otherwise living an unsettled way of life` IS FALSE) EQUALS FALSE
-- the Welsh Ministers meeting an immediate need in the way of limb (a)
#ASSERT `reg 2 — local welfare provision` (`Assistance given to individuals` WITH `giver` IS `the Welsh Ministers`, `assistance is occasional financial or other assistance` IS TRUE, `purpose is meeting, or helping to meet, an immediate short term need` IS TRUE, `need arises out of an exceptional event, or exceptional circumstances` IS TRUE, `need requires to be met in order to avoid a risk to the well-being of an individual` IS TRUE, `purpose is enabling individuals to establish or maintain a settled home` IS FALSE, `individuals have been or, without the assistance, might otherwise be in prison, hospital, a residential care establishment or other institution` IS FALSE, `individuals have been or, without the assistance, might otherwise be homeless or otherwise living an unsettled way of life` IS FALSE) EQUALS TRUE
-- a person authorised to act for the Scottish Ministers
#ASSERT `reg 2 — local welfare provision` (`Assistance given to individuals` WITH `giver` IS `a person authorised to exercise any function of, or provide a service to, a local authority or the Scottish Ministers or the Welsh Ministers`, `assistance is occasional financial or other assistance` IS TRUE, `purpose is meeting, or helping to meet, an immediate short term need` IS TRUE, `need arises out of an exceptional event, or exceptional circumstances` IS TRUE, `need requires to be met in order to avoid a risk to the well-being of an individual` IS TRUE, `purpose is enabling individuals to establish or maintain a settled home` IS FALSE, `individuals have been or, without the assistance, might otherwise be in prison, hospital, a residential care establishment or other institution` IS FALSE, `individuals have been or, without the assistance, might otherwise be homeless or otherwise living an unsettled way of life` IS FALSE) EQUALS TRUE
-- given by another giver, such as a charity with no authority from them
#ASSERT `reg 2 — local welfare provision` (`Assistance given to individuals` WITH `giver` IS `another giver`, `assistance is occasional financial or other assistance` IS TRUE, `purpose is meeting, or helping to meet, an immediate short term need` IS TRUE, `need arises out of an exceptional event, or exceptional circumstances` IS TRUE, `need requires to be met in order to avoid a risk to the well-being of an individual` IS TRUE, `purpose is enabling individuals to establish or maintain a settled home` IS FALSE, `individuals have been or, without the assistance, might otherwise be in prison, hospital, a residential care establishment or other institution` IS FALSE, `individuals have been or, without the assistance, might otherwise be homeless or otherwise living an unsettled way of life` IS FALSE) EQUALS FALSE
-- not occasional assistance
#ASSERT `reg 2 — local welfare provision` (`Assistance given to individuals` WITH `giver` IS `a local authority`, `assistance is occasional financial or other assistance` IS FALSE, `purpose is meeting, or helping to meet, an immediate short term need` IS TRUE, `need arises out of an exceptional event, or exceptional circumstances` IS TRUE, `need requires to be met in order to avoid a risk to the well-being of an individual` IS TRUE, `purpose is enabling individuals to establish or maintain a settled home` IS FALSE, `individuals have been or, without the assistance, might otherwise be in prison, hospital, a residential care establishment or other institution` IS FALSE, `individuals have been or, without the assistance, might otherwise be homeless or otherwise living an unsettled way of life` IS FALSE) EQUALS FALSE
-- neither purpose
#ASSERT `reg 2 — local welfare provision` (`Assistance given to individuals` WITH `giver` IS `a local authority`, `assistance is occasional financial or other assistance` IS TRUE, `purpose is meeting, or helping to meet, an immediate short term need` IS FALSE, `need arises out of an exceptional event, or exceptional circumstances` IS FALSE, `need requires to be met in order to avoid a risk to the well-being of an individual` IS FALSE, `purpose is enabling individuals to establish or maintain a settled home` IS FALSE, `individuals have been or, without the assistance, might otherwise be in prison, hospital, a residential care establishment or other institution` IS FALSE, `individuals have been or, without the assistance, might otherwise be homeless or otherwise living an unsettled way of life` IS FALSE) EQUALS FALSE

-- enactment (line 45) says "includes", so it can answer yes for two things and cannot answer no.
-- comprised in an Act of the Scottish Parliament or of the National Assembly of Wales
#ASSERT `reg 2 — enactment` (`Provision whose standing as an enactment is asked` WITH `enactment comprised in an Act of the Scottish Parliament or the National Assembly of Wales` IS TRUE, `instrument made under an Act of the Scottish Parliament or the National Assembly of Wales` IS FALSE) EQUALS `included by the definition of enactment`
-- an instrument made under such an Act
#ASSERT `reg 2 — enactment` (`Provision whose standing as an enactment is asked` WITH `enactment comprised in an Act of the Scottish Parliament or the National Assembly of Wales` IS FALSE, `instrument made under an Act of the Scottish Parliament or the National Assembly of Wales` IS TRUE) EQUALS `included by the definition of enactment`
-- neither: the definition does not say it is not an enactment, it says nothing
#ASSERT `reg 2 — enactment` (`Provision whose standing as an enactment is asked` WITH `enactment comprised in an Act of the Scottish Parliament or the National Assembly of Wales` IS FALSE, `instrument made under an Act of the Scottish Parliament or the National Assembly of Wales` IS FALSE) EQUALS `not decided by the definition of enactment`
