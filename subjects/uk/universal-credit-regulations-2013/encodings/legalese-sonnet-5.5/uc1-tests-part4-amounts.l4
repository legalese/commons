IMPORT prelude
IMPORT `uc-core`
IMPORT `uc1-part3-awards`
IMPORT `uc1-part4-amounts`

-- Tests of uc1-part4-amounts.l4 (regulations 36 and 37). Every expected value is written by hand from the table in
-- regulation 36 (lines 716-735) or from the text of regulation 37, and none was copied from the output of the rule.

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 36(1), the standard allowance: single claimant aged under 25 or 25 or over.
#ASSERT `reg 36(1) — the standard allowance` `a single claimant` 24 40 EQUALS 338.58
#ASSERT `reg 36(1) — the standard allowance` `a single claimant` 25 20 EQUALS 424.90
#ASSERT `reg 36(1) — the standard allowance` `a single claimant` 18 18 EQUALS 338.58
-- Joint claimants both aged under 25; where either is aged 25 or over.
#ASSERT `reg 36(1) — the standard allowance` `joint claimants` 24 24 EQUALS 528.34
#ASSERT `reg 36(1) — the standard allowance` `joint claimants` 25 24 EQUALS 666.97
#ASSERT `reg 36(1) — the standard allowance` `joint claimants` 24 25 EQUALS 666.97
#ASSERT `reg 36(1) — the standard allowance` `joint claimants` 25 25 EQUALS 666.97
-- (3) A member of a couple claiming as a single person gets the single claimant's amount, whatever the other member's age.
#ASSERT `reg 36(1) — the standard allowance` `a single claimant who is a member of a couple` 24 50 EQUALS 338.58
#ASSERT `reg 36(1) — the standard allowance` `a single claimant who is a member of a couple` 25 20 EQUALS 424.90

-- The child element and the additional amounts.
#ASSERT `reg 36(1) — the amount of the child element for each child or qualifying young person` EQUALS 303.94
#ASSERT `reg 36(1) — the additional amount for a disabled child or qualifying young person` `the lower rate` EQUALS 164.79
#ASSERT `reg 36(1) — the additional amount for a disabled child or qualifying young person` `the higher rate` EQUALS 514.71
#ASSERT `reg 36(1) — the additional amount for a disabled child or qualifying young person` `no additional amount` EQUALS 0

-- The LCWRA element: 429.80 for a pre-2026 claimant, a severe conditions criteria claimant or a terminally ill claimant; 217.26 otherwise.
#ASSERT `reg 36(1) — the amount of the LCWRA element` TRUE FALSE FALSE EQUALS 429.80
#ASSERT `reg 36(1) — the amount of the LCWRA element` FALSE TRUE FALSE EQUALS 429.80
#ASSERT `reg 36(1) — the amount of the LCWRA element` FALSE FALSE TRUE EQUALS 429.80
#ASSERT `reg 36(1) — the amount of the LCWRA element` TRUE TRUE TRUE EQUALS 429.80
#ASSERT `reg 36(1) — the amount of the LCWRA element` FALSE FALSE FALSE EQUALS 217.26

-- The carer element.
#ASSERT `reg 36(1) — the amount of the carer element` EQUALS 209.34

-- The maximum amount of the childcare costs element: one child; two or more; none (not covered).
#ASSERT `reg 36(1) — the maximum amount of the childcare costs element` 1 EQUALS JUST 1071.09
#ASSERT `reg 36(1) — the maximum amount of the childcare costs element` 2 EQUALS JUST 1836.16
#ASSERT `reg 36(1) — the maximum amount of the childcare costs element` 3 EQUALS JUST 1836.16
#ASSERT `reg 36(1) — the maximum amount of the childcare costs element` 0 EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 37: the four kinds of person named, and any other.
#ASSERT `reg 37 — the death is of a person that the regulation names` `one member of the couple, in the case of a joint award`
#ASSERT `reg 37 — the death is of a person that the regulation names` `a child or qualifying young person for whom a claimant was responsible`
#ASSERT `reg 37 — the death is of a person that the regulation names` `a severely disabled person for whom a claimant had regular and substantial caring responsibilities`
#ASSERT `reg 37 — the death is of a person that the regulation names` `a non-dependant within the meaning of paragraph 9(2) of Schedule 4`
#ASSERT NOT (`reg 37 — the death is of a person that the regulation names` `another person`)

-- The award began on 15 January 2024, so the periods begin on the 15th: 15 Jan to 14 Feb is the first, 15 Feb to 14 Mar the
-- second, 15 Mar to 14 Apr the third, 15 Apr to 14 May the fourth.
-- A death on 20 February 2024 is in the second period (position 1). The run-on covers that period and the following two (positions 1, 2, 3):
-- 15 February to 14 March, 15 March to 14 April, and 15 April to 14 May. 14 May is the last day covered; 15 May is not.
#ASSERT NOT (`reg 37 — the assessment period is one for which the person is treated as not having died` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 20) (YearMonthDay 2024 2 14))
#ASSERT `reg 37 — the assessment period is one for which the person is treated as not having died` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 20) (YearMonthDay 2024 2 15)
#ASSERT `reg 37 — the assessment period is one for which the person is treated as not having died` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 20) (YearMonthDay 2024 3 14)
#ASSERT `reg 37 — the assessment period is one for which the person is treated as not having died` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 20) (YearMonthDay 2024 3 15)
#ASSERT `reg 37 — the assessment period is one for which the person is treated as not having died` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 20) (YearMonthDay 2024 4 14)
#ASSERT `reg 37 — the assessment period is one for which the person is treated as not having died` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 20) (YearMonthDay 2024 4 15)
#ASSERT `reg 37 — the assessment period is one for which the person is treated as not having died` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 20) (YearMonthDay 2024 5 14)
#ASSERT NOT (`reg 37 — the assessment period is one for which the person is treated as not having died` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 20) (YearMonthDay 2024 5 15))
-- A death on the first day of a period (15 February) is in that period; on the last day (14 February) in the one before.
#ASSERT `reg 37 — the assessment period is one for which the person is treated as not having died` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 15) (YearMonthDay 2024 2 15)
#ASSERT NOT (`reg 37 — the assessment period is one for which the person is treated as not having died` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 14) (YearMonthDay 2024 5 15))
#ASSERT `reg 37 — the assessment period is one for which the person is treated as not having died` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 14) (YearMonthDay 2024 4 14)
-- A death before the award began: no assessment period contains it, so nothing runs on.
#ASSERT NOT (`reg 37 — the assessment period is one for which the person is treated as not having died` (YearMonthDay 2024 1 15) (YearMonthDay 2024 1 10) (YearMonthDay 2024 1 20))
-- Both questions together.
#ASSERT `reg 37 — the maximum amount is calculated as if the person had not died` `a child or qualifying young person for whom a claimant was responsible` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 20) (YearMonthDay 2024 4 15)
#ASSERT NOT (`reg 37 — the maximum amount is calculated as if the person had not died` `another person` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 20) (YearMonthDay 2024 4 15))
#ASSERT NOT (`reg 37 — the maximum amount is calculated as if the person had not died` `a child or qualifying young person for whom a claimant was responsible` (YearMonthDay 2024 1 15) (YearMonthDay 2024 2 20) (YearMonthDay 2024 5 15))
