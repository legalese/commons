IMPORT prelude
IMPORT `uc-core`
IMPORT `uc1-common`
IMPORT `uc1-part3-awards`

-- Tests of uc1-part3-awards.l4 (regulations 21 to 22A). Every expected value is written by hand from the text of the
-- regulation named in the comment beside it, and none was copied from the output of the rule.

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 21(2): the day on which each assessment period begins.

-- A first date of entitlement on the 15th: every period begins on the 15th.
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2024 1 15) 0 EQUALS YMD 2024 1 15
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2024 1 15) 1 EQUALS YMD 2024 2 15
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2024 1 15) 12 EQUALS YMD 2025 1 15
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2023 11 15) 2 EQUALS YMD 2024 1 15
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2023 1 28) 1 EQUALS YMD 2023 2 28

-- (2)(a) A first date on the 31st: each period begins on the last day of the month.
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2024 1 31) 0 EQUALS YMD 2024 1 31
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2024 1 31) 1 EQUALS YMD 2024 2 29
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2024 1 31) 2 EQUALS YMD 2024 3 31
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2024 1 31) 3 EQUALS YMD 2024 4 30
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2023 1 31) 1 EQUALS YMD 2023 2 28

-- (2)(b) A first date on the 29th or 30th: the 29th or 30th, except in February, when it is the 27th or, in a leap year, the 28th.
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2023 1 30) 1 EQUALS YMD 2023 2 27
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2023 1 30) 2 EQUALS YMD 2023 3 30
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2024 1 30) 1 EQUALS YMD 2024 2 28
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2023 1 29) 1 EQUALS YMD 2023 2 27
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2024 1 29) 1 EQUALS YMD 2024 2 28
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2023 10 29) 4 EQUALS YMD 2024 2 28
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2023 10 29) 2 EQUALS YMD 2023 12 29
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2023 11 30) 1 EQUALS YMD 2023 12 30
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2023 11 30) 3 EQUALS YMD 2024 2 28

-- The century rule for a leap year (reg 21(2)(b) says "in a leap year"): 2100 is not one, 2000 is.
#ASSERT NOT (`uc1 — a leap year` 2100)
#ASSERT `uc1 — a leap year` 2000
#ASSERT `uc1 — a leap year` 2024
#ASSERT NOT (`uc1 — a leap year` 2023)
#ASSERT `reg 21(2) — the first day of an assessment period` (YMD 2099 12 30) 2 EQUALS YMD 2100 2 27

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 21(1): the assessment period itself, the last day inside it.
`period starting 15 January 2024` MEANS `reg 21(1) — an assessment period` (YMD 2024 1 15) 0
`period starting 31 January 2024` MEANS `reg 21(1) — an assessment period` (YMD 2024 1 31) 0
`second period from 31 January 2024` MEANS `reg 21(1) — an assessment period` (YMD 2024 1 31) 1
#ASSERT (`period starting 15 January 2024`'s `first day`) EQUALS YMD 2024 1 15
#ASSERT (`period starting 15 January 2024`'s `last day`) EQUALS YMD 2024 2 14
#ASSERT (`period starting 31 January 2024`'s `last day`) EQUALS YMD 2024 2 28
#ASSERT (`second period from 31 January 2024`'s `first day`) EQUALS YMD 2024 2 29
#ASSERT (`second period from 31 January 2024`'s `last day`) EQUALS YMD 2024 3 30
#ASSERT `core — the number of days in an assessment period` `period starting 15 January 2024` EQUALS 31

-- Which period contains a day (boundaries on each side of the first day and of the last day).
#ASSERT `reg 21(1) — the position of the assessment period containing a day` (YMD 2024 1 15) (YMD 2024 1 14) EQUALS NOTHING
#ASSERT `reg 21(1) — the position of the assessment period containing a day` (YMD 2024 1 15) (YMD 2024 1 15) EQUALS JUST 0
#ASSERT `reg 21(1) — the position of the assessment period containing a day` (YMD 2024 1 15) (YMD 2024 2 14) EQUALS JUST 0
#ASSERT `reg 21(1) — the position of the assessment period containing a day` (YMD 2024 1 15) (YMD 2024 2 15) EQUALS JUST 1
#ASSERT `reg 21(1) — the position of the assessment period containing a day` (YMD 2024 1 15) (YMD 2024 3 14) EQUALS JUST 1
#ASSERT `reg 21(1) — the position of the assessment period containing a day` (YMD 2024 1 31) (YMD 2024 2 28) EQUALS JUST 0
#ASSERT `reg 21(1) — the position of the assessment period containing a day` (YMD 2024 1 31) (YMD 2024 2 29) EQUALS JUST 1
#ASSERT `reg 21(1) — the position of the assessment period containing a day` (YMD 2024 1 31) (YMD 2024 3 30) EQUALS JUST 1
#ASSERT `reg 21(1) — the position of the assessment period containing a day` (YMD 2024 1 31) (YMD 2024 3 31) EQUALS JUST 2
#ASSERT `reg 21(1) — the position of the assessment period containing a day` (YMD 2023 1 30) (YMD 2023 2 26) EQUALS JUST 0
#ASSERT `reg 21(1) — the position of the assessment period containing a day` (YMD 2023 1 30) (YMD 2023 2 27) EQUALS JUST 1
#ASSERT `reg 21(1) — the position of the assessment period containing a day` (YMD 2023 11 15) (YMD 2024 1 20) EQUALS JUST 2
`period containing 20 February 2024 from 15 January 2024` MEANS `reg 21(1) — the assessment period containing a day` (YMD 2024 1 15) (YMD 2024 2 20)
#ASSERT `period containing 20 February 2024 from 15 January 2024` EQUALS JUST (`reg 21(1) — an assessment period` (YMD 2024 1 15) 1)
#ASSERT `reg 21(1) — the assessment period containing a day` (YMD 2024 1 15) (YMD 2023 12 31) EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 21(3) to (3C): which first date of entitlement the cycle follows.
`old award that ended on 14 February 2024` MEANS `Old award whose assessment periods a new award follows` WITH
    `first date of entitlement of the old award` IS YMD 2023 6 10
    `last day of the old award's last assessment period` IS YMD 2024 2 14
`old award that ended on 14 March 2024` MEANS `Old award whose assessment periods a new award follows` WITH
    `first date of entitlement of the old award` IS YMD 2023 8 20
    `last day of the old award's last assessment period` IS YMD 2024 3 14

-- (3) applies: the old award's cycle (10 June); does not apply: NOTHING.
#ASSERT `reg 21(3) — the first date of entitlement whose cycle the new award follows` TRUE `old award that ended on 14 February 2024` EQUALS JUST (YMD 2023 6 10)
#ASSERT `reg 21(3) — the first date of entitlement whose cycle the new award follows` FALSE `old award that ended on 14 February 2024` EQUALS NOTHING

-- (3A) the old award that ended earlier is the one ending 14 February, whichever way round they are given.
#ASSERT `reg 21(3A) — whichever of the old awards ended earlier` `old award that ended on 14 February 2024` `old award that ended on 14 March 2024` EQUALS `old award that ended on 14 February 2024`
#ASSERT `reg 21(3A) — whichever of the old awards ended earlier` `old award that ended on 14 March 2024` `old award that ended on 14 February 2024` EQUALS `old award that ended on 14 February 2024`
#ASSERT `reg 21(3A) — the first date of entitlement whose cycle the new award follows` TRUE `old award that ended on 14 March 2024` `old award that ended on 14 February 2024` EQUALS JUST (YMD 2023 6 10)
#ASSERT `reg 21(3A) — the first date of entitlement whose cycle the new award follows` FALSE `old award that ended on 14 March 2024` `old award that ended on 14 February 2024` EQUALS NOTHING

-- (3B)
#ASSERT `reg 21(3B) — the first date of entitlement whose cycle the new award follows` TRUE `old award that ended on 14 March 2024` EQUALS JUST (YMD 2023 8 20)
#ASSERT `reg 21(3B) — the first date of entitlement whose cycle the new award follows` FALSE `old award that ended on 14 March 2024` EQUALS NOTHING

-- (3C)(a): the last day of the previous award fell within the 6 months preceding the claim of 1 September 2024.
-- The 6 months before 1 September 2024 begin on 1 March 2024: a last day of 1 March is within, 29 February is not.
`claim on 1 September 2024 after an award that ended on 1 March 2024` MEANS `Claim made within 6 months of the end of a previous award` WITH
    `date on which the claim is made` IS YMD 2024 9 1
    `last day of the previous award` IS YMD 2024 3 1
    `during those 6 months the claimant continued to meet the basic conditions in section 4 of the Act` IS TRUE
    `during those 6 months the claimant was not excluded from entitlement by regulation 19` IS TRUE
`claim on 1 September 2024 after an award that ended on 29 February 2024` MEANS `Claim made within 6 months of the end of a previous award` WITH
    `date on which the claim is made` IS YMD 2024 9 1
    `last day of the previous award` IS YMD 2024 2 29
    `during those 6 months the claimant continued to meet the basic conditions in section 4 of the Act` IS TRUE
    `during those 6 months the claimant was not excluded from entitlement by regulation 19` IS TRUE
`claim on 1 September 2024 after an award that ended on 31 August 2024` MEANS `Claim made within 6 months of the end of a previous award` WITH
    `date on which the claim is made` IS YMD 2024 9 1
    `last day of the previous award` IS YMD 2024 8 31
    `during those 6 months the claimant continued to meet the basic conditions in section 4 of the Act` IS TRUE
    `during those 6 months the claimant was not excluded from entitlement by regulation 19` IS TRUE
`claim on 1 September 2024 after an award that ended on 1 September 2024` MEANS `Claim made within 6 months of the end of a previous award` WITH
    `date on which the claim is made` IS YMD 2024 9 1
    `last day of the previous award` IS YMD 2024 9 1
    `during those 6 months the claimant continued to meet the basic conditions in section 4 of the Act` IS TRUE
    `during those 6 months the claimant was not excluded from entitlement by regulation 19` IS TRUE
`claim after an award, but the basic conditions were not all met` MEANS `Claim made within 6 months of the end of a previous award` WITH
    `date on which the claim is made` IS YMD 2024 9 1
    `last day of the previous award` IS YMD 2024 8 31
    `during those 6 months the claimant continued to meet the basic conditions in section 4 of the Act` IS FALSE
    `during those 6 months the claimant was not excluded from entitlement by regulation 19` IS TRUE
`claim after an award, but regulation 19 excluded the claimant` MEANS `Claim made within 6 months of the end of a previous award` WITH
    `date on which the claim is made` IS YMD 2024 9 1
    `last day of the previous award` IS YMD 2024 8 31
    `during those 6 months the claimant continued to meet the basic conditions in section 4 of the Act` IS TRUE
    `during those 6 months the claimant was not excluded from entitlement by regulation 19` IS FALSE
#ASSERT `reg 21(3C)(a) — the last day of the previous award fell within the 6 months preceding the claim` `claim on 1 September 2024 after an award that ended on 1 March 2024`
#ASSERT NOT (`reg 21(3C)(a) — the last day of the previous award fell within the 6 months preceding the claim` `claim on 1 September 2024 after an award that ended on 29 February 2024`)
#ASSERT `reg 21(3C)(a) — the last day of the previous award fell within the 6 months preceding the claim` `claim on 1 September 2024 after an award that ended on 31 August 2024`
#ASSERT NOT (`reg 21(3C)(a) — the last day of the previous award fell within the 6 months preceding the claim` `claim on 1 September 2024 after an award that ended on 1 September 2024`)
#ASSERT `reg 21(3C) — the claim is made within 6 months of the end of a previous award` `claim on 1 September 2024 after an award that ended on 31 August 2024`
#ASSERT NOT (`reg 21(3C) — the claim is made within 6 months of the end of a previous award` `claim after an award, but the basic conditions were not all met`)
#ASSERT NOT (`reg 21(3C) — the claim is made within 6 months of the end of a previous award` `claim after an award, but regulation 19 excluded the claimant`)

-- (3C): one old award, or two (one for each joint claimant, the one that ends earlier).
#ASSERT `reg 21(3C) — the first date of entitlement whose cycle the new award follows` `claim on 1 September 2024 after an award that ended on 31 August 2024` `old award that ended on 14 March 2024` NOTHING EQUALS JUST (YMD 2023 8 20)
#ASSERT `reg 21(3C) — the first date of entitlement whose cycle the new award follows` `claim on 1 September 2024 after an award that ended on 31 August 2024` `old award that ended on 14 March 2024` (JUST `old award that ended on 14 February 2024`) EQUALS JUST (YMD 2023 6 10)
#ASSERT `reg 21(3C) — the first date of entitlement whose cycle the new award follows` `claim after an award, but regulation 19 excluded the claimant` `old award that ended on 14 March 2024` NOTHING EQUALS NOTHING

-- (3D)
#ASSERT `reg 21(3D) — the member's position at the beginning of the first assessment period does not matter` TRUE TRUE
#ASSERT NOT (`reg 21(3D) — the member's position at the beginning of the first assessment period does not matter` TRUE FALSE)
#ASSERT NOT (`reg 21(3D) — the member's position at the beginning of the first assessment period does not matter` FALSE TRUE)

-- Which first date of entitlement the periods run from: paragraph order, then the award's own first date.
#ASSERT `reg 21 — the first date of entitlement from which the assessment periods run` (YMD 2024 5 5) NOTHING NOTHING NOTHING NOTHING EQUALS YMD 2024 5 5
#ASSERT `reg 21 — the first date of entitlement from which the assessment periods run` (YMD 2024 5 5) (JUST (YMD 2023 6 10)) NOTHING NOTHING NOTHING EQUALS YMD 2023 6 10
#ASSERT `reg 21 — the first date of entitlement from which the assessment periods run` (YMD 2024 5 5) NOTHING (JUST (YMD 2023 7 11)) NOTHING NOTHING EQUALS YMD 2023 7 11
#ASSERT `reg 21 — the first date of entitlement from which the assessment periods run` (YMD 2024 5 5) NOTHING NOTHING (JUST (YMD 2023 8 12)) NOTHING EQUALS YMD 2023 8 12
#ASSERT `reg 21 — the first date of entitlement from which the assessment periods run` (YMD 2024 5 5) NOTHING NOTHING NOTHING (JUST (YMD 2023 9 13)) EQUALS YMD 2023 9 13

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 21A.
`a change that satisfies regulation 21A(1)` MEANS `Change in the first date of entitlement` WITH
    `the first date of entitlement has been determined` IS TRUE
    `it is subsequently determined that the first date of entitlement falls on a different date` IS TRUE
    `in the opinion of the Secretary of State applying regulation 21(1) and (2) would cause unnecessary disruption to the administration of the claim` IS TRUE
`a change with no unnecessary disruption` MEANS `Change in the first date of entitlement` WITH
    `the first date of entitlement has been determined` IS TRUE
    `it is subsequently determined that the first date of entitlement falls on a different date` IS TRUE
    `in the opinion of the Secretary of State applying regulation 21(1) and (2) would cause unnecessary disruption to the administration of the claim` IS FALSE
`a change with no different date` MEANS `Change in the first date of entitlement` WITH
    `the first date of entitlement has been determined` IS TRUE
    `it is subsequently determined that the first date of entitlement falls on a different date` IS FALSE
    `in the opinion of the Secretary of State applying regulation 21(1) and (2) would cause unnecessary disruption to the administration of the claim` IS TRUE
`a change before the first date was determined` MEANS `Change in the first date of entitlement` WITH
    `the first date of entitlement has been determined` IS FALSE
    `it is subsequently determined that the first date of entitlement falls on a different date` IS TRUE
    `in the opinion of the Secretary of State applying regulation 21(1) and (2) would cause unnecessary disruption to the administration of the claim` IS TRUE
#ASSERT `reg 21A(1) — this regulation applies` `a change that satisfies regulation 21A(1)`
#ASSERT NOT (`reg 21A(1) — this regulation applies` `a change with no unnecessary disruption`)
#ASSERT NOT (`reg 21A(1) — this regulation applies` `a change with no different date`)
#ASSERT NOT (`reg 21A(1) — this regulation applies` `a change before the first date was determined`)
`first period under regulation 21A from 10 March 2024` MEANS `reg 21A(2)(a) — the first assessment period` (YMD 2024 3 10) (YMD 2024 4 5)
#ASSERT (`first period under regulation 21A from 10 March 2024`'s `first day`) EQUALS YMD 2024 3 10
#ASSERT (`first period under regulation 21A from 10 March 2024`'s `last day`) EQUALS YMD 2024 4 5
-- N is 22 days in March (10 to 31) and 5 in April.
#ASSERT `core — the number of days in an assessment period` `first period under regulation 21A from 10 March 2024` EQUALS 27
-- The formula is not in the deposited text: the amount is not covered.
#ASSERT `reg 21A(2)(b) — the amount payable for the first assessment period` `first period under regulation 21A from 10 March 2024` 500 EQUALS NOTHING
#ASSERT `reg 21A(2)(c) — the first date of entitlement from which the second and later assessment periods run` `first period under regulation 21A from 10 March 2024` EQUALS YMD 2024 4 6

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 22.

-- (2) and the table: the higher allowance (710) with no housing costs element, the lower (427) with one; none where
-- the claimant is not responsible for a child or qualifying young person and does not have limited capability for work.
#ASSERT `reg 22(2) — the work allowance` FALSE TRUE FALSE EQUALS JUST 710
#ASSERT `reg 22(2) — the work allowance` FALSE FALSE TRUE EQUALS JUST 710
#ASSERT `reg 22(2) — the work allowance` FALSE TRUE TRUE EQUALS JUST 710
#ASSERT `reg 22(2) — the work allowance` TRUE TRUE FALSE EQUALS JUST 427
#ASSERT `reg 22(2) — the work allowance` TRUE FALSE TRUE EQUALS JUST 427
#ASSERT `reg 22(2) — the work allowance` FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `reg 22(2) — the work allowance` TRUE FALSE FALSE EQUALS NOTHING

-- (3) A member of a couple claiming as a single person is treated as one of joint claimants: the two incomes are combined.
#ASSERT `reg 22(3) — the income taken into account` `a single claimant` 100 40 EQUALS 100
#ASSERT `reg 22(3) — the income taken into account` `joint claimants` 100 40 EQUALS 140
#ASSERT `reg 22(3) — the income taken into account` `a single claimant who is a member of a couple` 100 40 EQUALS 140

-- (1)(a) all of the unearned income.
#ASSERT `reg 22(1)(a) — the unearned income deducted` 123.45 EQUALS 123.45

-- (1)(b)(i) no work allowance: 55% of the earned income.
#ASSERT `reg 22(1)(b) — the earned income deducted` 1000 NOTHING EQUALS 550
#ASSERT `reg 22(1)(b) — the earned income deducted` 0 NOTHING EQUALS 0
-- 55% of 100.01 is 55.0055, a fraction of 0.55 of a penny: half a penny or more, so it is treated as a penny (regulation 6(1)).
#ASSERT `reg 22(1)(b) — the earned income deducted` 100.01 NOTHING EQUALS 55.01
-- 55% of 100.02 is 55.011, a fraction of 0.1 of a penny: less than half a penny, so it is disregarded.
#ASSERT `reg 22(1)(b) — the earned income deducted` 100.02 NOTHING EQUALS 55.01
-- 55% of 100.03 is 55.0165, a fraction of 0.65 of a penny: treated as a penny, 55.02.
#ASSERT `reg 22(1)(b) — the earned income deducted` 100.03 NOTHING EQUALS 55.02
-- (1)(b)(ii) a work allowance: 55% of the amount by which the earned income exceeds it.
#ASSERT `reg 22(1)(b) — the earned income deducted` 1000 (JUST 710) EQUALS 159.5
#ASSERT `reg 22(1)(b) — the earned income deducted` 710 (JUST 710) EQUALS 0
#ASSERT `reg 22(1)(b) — the earned income deducted` 500 (JUST 710) EQUALS 0
-- 55% of 0.01 is 0.0055, half a penny or more, so it is treated as a penny.
#ASSERT `reg 22(1)(b) — the earned income deducted` 710.01 (JUST 710) EQUALS 0.01
#ASSERT `reg 22(1)(b) — the earned income deducted` 427.01 (JUST 427) EQUALS 0.01

-- (1) the whole deduction, and the amount of the award it gives.
#ASSERT `reg 22(1) — the amount deducted from the maximum amount` 100 1000 NOTHING EQUALS 650
#ASSERT `reg 22(1) — the amount deducted from the maximum amount` 100 1000 (JUST 710) EQUALS 259.5
#ASSERT `reg 22(1) — the amount of an award` 800 650 EQUALS 150
-- A deduction above the maximum amount gives a negative figure here. Regulation 22 does not say that the award is then nil (that is
-- section 8 of the Act, out of range); regulation 17 decides whether the amount payable reaches the minimum. This line records only that
-- the rule does not floor the figure (see the finding on regulation 22 in NOTES.md); it is not a statement of what is paid.
#ASSERT `reg 22(1) — the amount of an award` 400 650 EQUALS (0 MINUS 250)

