-- 6 April 2026 is not before 6 April 2026.
#ASSERT NOT (`Am I a pre-2026 claimant for the LCWRA element` TRUE TRUE (YearMonthDay 2026 4 6) FALSE FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2000 1 1) FALSE)
-- The claimant must have limited capability for work and work-related activity.
#ASSERT NOT (`Am I a pre-2026 claimant for the LCWRA element` FALSE TRUE (YearMonthDay 2025 10 1) FALSE FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2000 1 1) FALSE)
-- Never entitled to an award that included the LCWRA element.
#ASSERT NOT (`Am I a pre-2026 claimant for the LCWRA element` TRUE FALSE (YearMonthDay 2000 1 1) FALSE FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2000 1 1) FALSE)
-- A gap in entitlement that did not begin because the financial condition ceased to be met breaks continuity.
#ASSERT NOT (`Am I a pre-2026 claimant for the LCWRA element` TRUE TRUE (YearMonthDay 2025 10 1) TRUE FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2026 5 9) FALSE)
-- (2): a gap that began because the financial condition ceased to be met and ended within the six months beginning with 10 January 2026.
#ASSERT `Am I a pre-2026 claimant for the LCWRA element` TRUE TRUE (YearMonthDay 2025 10 1) TRUE TRUE (YearMonthDay 2026 1 10) (YearMonthDay 2026 5 9) FALSE
-- The six months beginning with 10 January end on 9 July (fork F-6-MONTHS).
#ASSERT `Am I a pre-2026 claimant for the LCWRA element` TRUE TRUE (YearMonthDay 2025 10 1) TRUE TRUE (YearMonthDay 2026 1 10) (YearMonthDay 2026 7 9) FALSE
-- A gap ending after the six months.
#ASSERT NOT (`Am I a pre-2026 claimant for the LCWRA element` TRUE TRUE (YearMonthDay 2025 10 1) TRUE TRUE (YearMonthDay 2026 1 10) (YearMonthDay 2026 7 10) FALSE)
-- (1A): a circumstance in Schedule 5A.
#ASSERT `Am I a pre-2026 claimant for the LCWRA element` TRUE FALSE (YearMonthDay 2000 1 1) FALSE FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2000 1 1) TRUE
-- Schedule 5A applies to a claimant with limited capability for work and work-related activity.
#ASSERT NOT (`Am I a pre-2026 claimant for the LCWRA element` FALSE FALSE (YearMonthDay 2000 1 1) FALSE FALSE (YearMonthDay 2000 1 1) (YearMonthDay 2000 1 1) TRUE)
