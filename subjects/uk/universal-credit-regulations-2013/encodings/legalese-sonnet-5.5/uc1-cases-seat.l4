-- (2)(b)(ii): at any time, where the child has not reached compulsory school age.
#ASSERT `Is my childcare in England relevant childcare` TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE
-- In school hours, for a child of compulsory school age.
#ASSERT NOT (`Is my childcare in England relevant childcare` TRUE FALSE FALSE TRUE TRUE FALSE TRUE FALSE FALSE FALSE TRUE FALSE FALSE)
-- (5A): not a school the Chief Inspector must or may inspect.
#ASSERT NOT (`Is my childcare in England relevant childcare` TRUE FALSE FALSE TRUE FALSE TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE)
-- (6)(a)(ii): no governing body, so the people responsible for the management of the school.
#ASSERT `Is my childcare in England relevant childcare` TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE TRUE
-- No governing body and not by those who manage the school.
#ASSERT NOT (`Is my childcare in England relevant childcare` TRUE FALSE FALSE TRUE TRUE TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE)
-- (2)(c): a registered domiciliary care provider.
#ASSERT `Is my childcare in England relevant childcare` TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE FALSE
-- (7)(a): a close relative of the child, wholly or mainly in the child's home.
#ASSERT NOT (`Is my childcare in England relevant childcare` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE)
-- (7)(b): the child's foster parent.
#ASSERT NOT (`Is my childcare in England relevant childcare` TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE)
-- Care for a person who is neither a child nor a qualifying young person.
#ASSERT NOT (`Is my childcare in England relevant childcare` FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
-- 35(3): Scotland. Arguments: a child or qualifying young person, registered child minding or day care, a registered childcare agency, a local authority service registered under Part 5, a close relative in the child's home, the child's foster parent.
-- (3)(a).
#ASSERT `Is my childcare in Scotland relevant childcare` TRUE TRUE FALSE FALSE FALSE FALSE
-- (3)(b).
#ASSERT `Is my childcare in Scotland relevant childcare` TRUE FALSE TRUE FALSE FALSE FALSE
-- (3)(c).
#ASSERT `Is my childcare in Scotland relevant childcare` TRUE FALSE FALSE TRUE FALSE FALSE
-- None of the limbs.
#ASSERT NOT (`Is my childcare in Scotland relevant childcare` TRUE FALSE FALSE FALSE FALSE FALSE)
-- (7)(a): a close relative.
#ASSERT NOT (`Is my childcare in Scotland relevant childcare` TRUE TRUE FALSE FALSE TRUE FALSE)
-- (7)(b): the child's foster parent.
#ASSERT NOT (`Is my childcare in Scotland relevant childcare` TRUE TRUE FALSE FALSE FALSE TRUE)
-- Not a child or qualifying young person.
#ASSERT NOT (`Is my childcare in Scotland relevant childcare` FALSE TRUE FALSE FALSE FALSE FALSE)
