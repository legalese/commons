IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-persons`
IMPORT `uc4-part8-ch2-reduction-effect`
IMPORT `uc4-part8-ch3-hardship`

-- Tests of uc4-part8-ch3-hardship.l4: regulations 115 to 119 and the signature line.
-- Expected values are written by hand from the text, beside the assertion.

-- ---------------------------------------------------------------------------------------------------------
-- Fixtures.
GIVEN compliance IS A BOOLEAN
      application IS A BOOLEAN
      manner IS A BOOLEAN
      furnishes IS A BOOLEAN
      accepts IS A BOOLEAN
      complied IS A BOOLEAN
      hardship IS A BOOLEAN
GIVETH A `Hardship conditions of one claimant`
`test — claimant` compliance application manner furnishes accepts complied hardship MEANS `Hardship conditions of one claimant` WITH
    `has met any compliance condition specified by the Secretary of State under regulation 104(2)(a)(i)` IS compliance
    `completes and submits an application approved for the purpose by the Secretary of State, or in such other form as the Secretary of State accepts as sufficient` IS application
    `completes and submits the application in such manner as the Secretary of State determines` IS manner
    `furnishes such information or evidence as the Secretary of State may require, in such manner as the Secretary of State determines` IS furnishes
    `accepts that any hardship payments that are paid are recoverable` IS accepts
    `the Secretary of State is satisfied that the claimant has complied with all the work-related requirements that they were required to comply with in the 7 days preceding the day on which the application was submitted` IS complied
    `the Secretary of State is satisfied that the claimant is in hardship` IS hardship

-- A claimant who meets every condition about themselves.
`test — a claimant who meets every condition` MEANS `test — claimant` TRUE TRUE TRUE TRUE TRUE TRUE TRUE

GIVEN own IS A LIST OF `Essential need`
      child IS A LIST OF `Essential need`
      routeOne IS A BOOLEAN
      routeTwo IS A BOOLEAN
      support IS A BOOLEAN
      expenditure IS A BOOLEAN
GIVETH A `Facts for hardship`
`test — hardship facts` own child routeOne routeTwo support expenditure MEANS `Facts for hardship` WITH
    `essential needs that the claimants cannot meet only because the amount of their award has been reduced` IS own
    `essential needs of a child or qualifying young person for whom a claimant is responsible that cannot be met only because the amount of the award has been reduced` IS child
    `the reduction is by the daily reduction rate set out in regulation 111(1) under section 26 or 27 of the Act` IS routeOne
    `the reduction is by the equivalent daily reduction rate prescribed in regulations made under section 6B(5A), 7(2A) or 9(2A) of the Social Security Fraud Act 2001` IS routeTwo
    `they have made every effort to access alternative sources of support to meet, or partially meet, such needs` IS support
    `they have made every effort to cease to incur any expenditure which does not relate to such needs` IS expenditure

GIVEN young IS A BOOLEAN
      carerUnder1 IS A BOOLEAN
      reg89 IS A BOOLEAN
      section20 IS A BOOLEAN
      lcwra IS A BOOLEAN
GIVETH A `Position at the end of the assessment period`
`test — position` young carerUnder1 reg89 section20 lcwra MEANS `Position at the end of the assessment period` WITH
    `the claimant is aged 16 or 17` IS young
    `the claimant falls within section 19 of the Act by virtue of subsection (2)(c) of that section (responsible carer for a child under the age of 1)` IS carerUnder1
    `the claimant falls within section 19 of the Act by virtue of regulation 89(1)(c), (d) or (f)` IS reg89
    `the claimant falls within section 20 of the Act` IS section20
    `the claimant falls within section 19 of the Act by virtue of having limited capability for work and work-related activity` IS lcwra

GIVEN byReg90 IS A BOOLEAN
      oneOnly IS A BOOLEAN
      neither IS A BOOLEAN
      earnings IS A NUMBER
      threshold IS A MAYBE NUMBER
      rate IS A NUMBER
GIVETH A `Facts for the recoverability of hardship payments`
`test — recovery facts` byReg90 oneOnly neither earnings threshold rate MEANS `Facts for the recoverability of hardship payments` WITH
    `the single claimant, or each joint claimant, falls within section 19 of the Act by virtue of regulation 90` IS byReg90
    `regulation 90 applies to one of the joint claimants only` IS oneOnly
    `regulation 90 applies to neither the single claimant nor either joint claimant` IS neither
    `the single claimant's monthly earnings, or the joint claimants' combined monthly earnings` IS earnings
    `the amount of the individual threshold` IS threshold
    `the hourly rate in regulation 4 or 4A(1)(a) to (c) of the National Minimum Wage Regulations for a person of the same age as the claimant, or the youngest of the joint claimants` IS rate

-- An assessment period in which regulation 119(2)(c) is met: neither route of regulation 90, earnings of 800 at 10 pounds an hour.
`test — a month outside the recovery` MEANS `test — recovery facts` FALSE FALSE TRUE 800 NOTHING 10
-- An assessment period in which none of (a), (b) or (c) is met.
`test — a month within the recovery` MEANS `test — recovery facts` FALSE FALSE TRUE 100 NOTHING 10

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 115 states no rule (coverage row: inert, a pure citation).
#ASSERT `reg 115 — the Chapter is about hardship payments under section 28 of the Act` EQUALS "This Chapter contains provisions under section 28 of the Act for the making of hardship payments where the amount of an award is reduced under section 26 or 27 of the Act."

-- Regulation 116(3): the four needs.
#ASSERT `reg 116(3) — an essential need specified in paragraph (3)` accommodation
#ASSERT `reg 116(3) — an essential need specified in paragraph (3)` heating
#ASSERT `reg 116(3) — an essential need specified in paragraph (3)` food
#ASSERT `reg 116(3) — an essential need specified in paragraph (3)` hygiene
#ASSERT NOT (`reg 116(3) — an essential need specified in paragraph (3)` `a need not specified in paragraph (3)`)

-- Regulation 116(2): hardship.
#ASSERT `reg 116(2) — the claimants are in hardship` (`test — hardship facts` (LIST food) EMPTY TRUE FALSE TRUE TRUE)
-- A child's need counts although the claimants' own list is empty.
#ASSERT `reg 116(2) — the claimants are in hardship` (`test — hardship facts` EMPTY (LIST heating) TRUE FALSE TRUE TRUE)
-- The equivalent rate under the Social Security Fraud Act 2001 will do for the reduction.
#ASSERT `reg 116(2) — the claimants are in hardship` (`test — hardship facts` (LIST accommodation, hygiene) EMPTY FALSE TRUE TRUE TRUE)
-- A need that paragraph (3) does not specify is not enough, nor is no need.
#ASSERT NOT (`reg 116(2) — the claimants are in hardship` (`test — hardship facts` (LIST `a need not specified in paragraph (3)`) EMPTY TRUE FALSE TRUE TRUE))
#ASSERT NOT (`reg 116(2) — the claimants are in hardship` (`test — hardship facts` EMPTY EMPTY TRUE FALSE TRUE TRUE))
-- A need that is specified together with one that is not.
#ASSERT `reg 116(2) — the claimants are in hardship` (`test — hardship facts` (LIST `a need not specified in paragraph (3)`, food) EMPTY TRUE FALSE TRUE TRUE)
-- Neither kind of reduction; no effort to find other support; no effort to cut other spending.
#ASSERT NOT (`reg 116(2) — the claimants are in hardship` (`test — hardship facts` (LIST food) EMPTY FALSE FALSE TRUE TRUE))
#ASSERT NOT (`reg 116(2) — the claimants are in hardship` (`test — hardship facts` (LIST food) EMPTY TRUE FALSE FALSE TRUE))
#ASSERT NOT (`reg 116(2) — the claimants are in hardship` (`test — hardship facts` (LIST food) EMPTY TRUE FALSE TRUE FALSE))

-- Regulation 116(1)(a).
#ASSERT `reg 116(1)(a) — the sanctioned claimant is aged 18 or over` 18
#ASSERT NOT (`reg 116(1)(a) — the sanctioned claimant is aged 18 or over` 17)

-- Regulation 116(1)(b): each claimant has met any compliance condition.
#ASSERT `reg 116(1)(b) — each claimant has met any compliance condition` (LIST `test — a claimant who meets every condition`)
#ASSERT `reg 116(1)(b) — each claimant has met any compliance condition` (LIST `test — a claimant who meets every condition`, `test — a claimant who meets every condition`)
#ASSERT NOT (`reg 116(1)(b) — each claimant has met any compliance condition` (LIST `test — a claimant who meets every condition`, `test — claimant` FALSE TRUE TRUE TRUE TRUE TRUE TRUE))
-- No claimant at all meets nothing.
#ASSERT NOT (`reg 116(1)(b) — each claimant has met any compliance condition` EMPTY)

-- Regulation 116(1)(c): the same claimant completes and submits the application in the manner determined. Either joint claimant will do.
#ASSERT `reg 116(1)(c) — a claimant completes and submits an application` (LIST `test — a claimant who meets every condition`)
#ASSERT `reg 116(1)(c) — a claimant completes and submits an application` (LIST `test — claimant` TRUE FALSE FALSE TRUE TRUE TRUE TRUE, `test — a claimant who meets every condition`)
-- One claimant completes the application and the other supplies the manner: neither does both.
#ASSERT NOT (`reg 116(1)(c) — a claimant completes and submits an application` (LIST `test — claimant` TRUE TRUE FALSE TRUE TRUE TRUE TRUE, `test — claimant` TRUE FALSE TRUE TRUE TRUE TRUE TRUE))
#ASSERT NOT (`reg 116(1)(c) — a claimant completes and submits an application` EMPTY)

-- Regulation 116(1)(d): either joint claimant furnishes the information or evidence.
#ASSERT `reg 116(1)(d) — a claimant furnishes the information or evidence required` (LIST `test — claimant` TRUE TRUE TRUE FALSE TRUE TRUE TRUE, `test — a claimant who meets every condition`)
#ASSERT NOT (`reg 116(1)(d) — a claimant furnishes the information or evidence required` (LIST `test — claimant` TRUE TRUE TRUE FALSE TRUE TRUE TRUE))
#ASSERT NOT (`reg 116(1)(d) — a claimant furnishes the information or evidence required` EMPTY)

-- Regulation 116(1)(e): each claimant accepts that hardship payments are recoverable.
#ASSERT `reg 116(1)(e) — each claimant accepts that hardship payments are recoverable` (LIST `test — a claimant who meets every condition`, `test — a claimant who meets every condition`)
#ASSERT NOT (`reg 116(1)(e) — each claimant accepts that hardship payments are recoverable` (LIST `test — a claimant who meets every condition`, `test — claimant` TRUE TRUE TRUE TRUE FALSE TRUE TRUE))
#ASSERT NOT (`reg 116(1)(e) — each claimant accepts that hardship payments are recoverable` EMPTY)

-- Regulation 116(1)(f): each claimant has complied with the work-related requirements in the 7 days before the application.
#ASSERT `reg 116(1)(f) — each claimant has complied with the work-related requirements in the 7 days before the application` (LIST `test — a claimant who meets every condition`)
#ASSERT NOT (`reg 116(1)(f) — each claimant has complied with the work-related requirements in the 7 days before the application` (LIST `test — a claimant who meets every condition`, `test — claimant` TRUE TRUE TRUE TRUE TRUE FALSE TRUE))
#ASSERT NOT (`reg 116(1)(f) — each claimant has complied with the work-related requirements in the 7 days before the application` EMPTY)

-- Regulation 116(1)(g): each claimant is in hardship, and paragraph (2) allows it.
#ASSERT `reg 116(1)(g) — each claimant is in hardship` (LIST `test — a claimant who meets every condition`) TRUE
#ASSERT NOT (`reg 116(1)(g) — each claimant is in hardship` (LIST `test — a claimant who meets every condition`) FALSE)
#ASSERT NOT (`reg 116(1)(g) — each claimant is in hardship` (LIST `test — a claimant who meets every condition`, `test — claimant` TRUE TRUE TRUE TRUE TRUE TRUE FALSE) TRUE)
#ASSERT NOT (`reg 116(1)(g) — each claimant is in hardship` EMPTY TRUE)

-- Regulation 116(1)(h): the rate of regulation 111(1) applies unless regulation 111(2) or (3) does.
#ASSERT `reg 116(1)(h) — the daily reduction rate in regulation 111(1) applies` (`test — position` FALSE FALSE FALSE FALSE FALSE)
#ASSERT NOT (`reg 116(1)(h) — the daily reduction rate in regulation 111(1) applies` (`test — position` TRUE FALSE FALSE FALSE FALSE))
#ASSERT NOT (`reg 116(1)(h) — the daily reduction rate in regulation 111(1) applies` (`test — position` FALSE FALSE FALSE TRUE FALSE))
#ASSERT NOT (`reg 116(1)(h) — the daily reduction rate in regulation 111(1) applies` (`test — position` FALSE FALSE FALSE FALSE TRUE))

-- Regulation 116(1): all eight limbs.
#ASSERT `reg 116(1) — the conditions for a hardship payment are met` TRUE TRUE TRUE TRUE TRUE TRUE TRUE TRUE
#ASSERT NOT (`reg 116(1) — the conditions for a hardship payment are met` FALSE TRUE TRUE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 116(1) — the conditions for a hardship payment are met` TRUE FALSE TRUE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 116(1) — the conditions for a hardship payment are met` TRUE TRUE FALSE TRUE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 116(1) — the conditions for a hardship payment are met` TRUE TRUE TRUE FALSE TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 116(1) — the conditions for a hardship payment are met` TRUE TRUE TRUE TRUE FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 116(1) — the conditions for a hardship payment are met` TRUE TRUE TRUE TRUE TRUE FALSE TRUE TRUE)
#ASSERT NOT (`reg 116(1) — the conditions for a hardship payment are met` TRUE TRUE TRUE TRUE TRUE TRUE FALSE TRUE)
#ASSERT NOT (`reg 116(1) — the conditions for a hardship payment are met` TRUE TRUE TRUE TRUE TRUE TRUE TRUE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 117: the conditions are met on 1 June 2026; the normal payment date for that assessment period is 28 June 2026 and for the
-- next 28 July 2026. The period of 1 to 27 June is 27 days: it ends on the day before the payment date.
#ASSERT `reg 117 — the period in respect of which a hardship payment is made` (YMD 2026 6 1) (YMD 2026 6 28) (YMD 2026 7 28) NOTHING EQUALS `Period of a hardship payment` WITH `first day of the period` IS YMD 2026 6 1, `last day of the period` IS YMD 2026 6 27
-- Conditions met on 21 June: 21 to 27 June is 7 days, so the period ends on the next normal payment date, 28 July.
#ASSERT `reg 117 — the period in respect of which a hardship payment is made` (YMD 2026 6 21) (YMD 2026 6 28) (YMD 2026 7 28) NOTHING EQUALS `Period of a hardship payment` WITH `first day of the period` IS YMD 2026 6 21, `last day of the period` IS YMD 2026 7 28
-- Conditions met on 20 June: 20 to 27 June is 8 days, so the first rule stands.
#ASSERT `reg 117 — the period in respect of which a hardship payment is made` (YMD 2026 6 20) (YMD 2026 6 28) (YMD 2026 7 28) NOTHING EQUALS `Period of a hardship payment` WITH `first day of the period` IS YMD 2026 6 20, `last day of the period` IS YMD 2026 6 27
-- Conditions met on the payment date itself: nought days, so the second rule applies.
#ASSERT `reg 117 — the period in respect of which a hardship payment is made` (YMD 2026 6 28) (YMD 2026 6 28) (YMD 2026 7 28) NOTHING EQUALS `Period of a hardship payment` WITH `first day of the period` IS YMD 2026 6 28, `last day of the period` IS YMD 2026 7 28
-- A reduction that ends sooner than the next payment date cuts the period short: 5 July.
#ASSERT `reg 117 — the period in respect of which a hardship payment is made` (YMD 2026 6 21) (YMD 2026 6 28) (YMD 2026 7 28) (JUST (YMD 2026 7 5)) EQUALS `Period of a hardship payment` WITH `first day of the period` IS YMD 2026 6 21, `last day of the period` IS YMD 2026 7 5
-- A reduction that ends later than the next payment date does not extend it.
#ASSERT `reg 117 — the period in respect of which a hardship payment is made` (YMD 2026 6 21) (YMD 2026 6 28) (YMD 2026 7 28) (JUST (YMD 2026 9 1)) EQUALS `Period of a hardship payment` WITH `first day of the period` IS YMD 2026 6 21, `last day of the period` IS YMD 2026 7 28
-- A reduction that ends on the next payment date.
#ASSERT `reg 117 — the period in respect of which a hardship payment is made` (YMD 2026 6 21) (YMD 2026 6 28) (YMD 2026 7 28) (JUST (YMD 2026 7 28)) EQUALS `Period of a hardship payment` WITH `first day of the period` IS YMD 2026 6 21, `last day of the period` IS YMD 2026 7 28
-- A reduction's end is not read where the period is more than 7 days.
#ASSERT `reg 117 — the period in respect of which a hardship payment is made` (YMD 2026 6 1) (YMD 2026 6 28) (YMD 2026 7 28) (JUST (YMD 2026 7 5)) EQUALS `Period of a hardship payment` WITH `first day of the period` IS YMD 2026 6 1, `last day of the period` IS YMD 2026 6 27

-- Regulation 118: 60% of (A x 12 / 365). A reduction of 393 gives 0.6 x 12.9205... = 7.7523..., which is 7.75.
#ASSERT `reg 118 — the amount of a hardship payment for each day` 393 EQUALS 7.75
-- 400 gives 0.6 x 13.1506... = 7.8904..., which is 7.89.
#ASSERT `reg 118 — the amount of a hardship payment for each day` 400 EQUALS 7.89
-- 380 gives 0.6 x 12.4931... = 7.4958..., which rounds up to 7.50.
#ASSERT `reg 118 — the amount of a hardship payment for each day` 380 EQUALS 7.5
#ASSERT `reg 118 — the amount of a hardship payment for each day` 0 EQUALS 0

-- Regulation 119(2): the assessment period is outside the recovery.
#ASSERT `reg 119(2) — the assessment period is outside the recovery of paragraph (1)` (`test — recovery facts` TRUE FALSE FALSE 0 NOTHING 10)
-- Limb (b): regulation 90 applies to one joint claimant only, and combined earnings reach the individual threshold (693).
#ASSERT `reg 119(2) — the assessment period is outside the recovery of paragraph (1)` (`test — recovery facts` FALSE TRUE FALSE 693 (JUST 693) 10)
#ASSERT NOT (`reg 119(2) — the assessment period is outside the recovery of paragraph (1)` (`test — recovery facts` FALSE TRUE FALSE 692.99 (JUST 693) 10))
#ASSERT NOT (`reg 119(2) — the assessment period is outside the recovery of paragraph (1)` (`test — recovery facts` FALSE TRUE FALSE 5000 NOTHING 10))
-- Limb (c): regulation 90 applies to neither; 16 hours at 10 pounds an hour is 693.33 (rounded to the penny).
#ASSERT `reg 119(2) — the assessment period is outside the recovery of paragraph (1)` (`test — recovery facts` FALSE FALSE TRUE 693.33 NOTHING 10)
#ASSERT NOT (`reg 119(2) — the assessment period is outside the recovery of paragraph (1)` (`test — recovery facts` FALSE FALSE TRUE 693.32 NOTHING 10))
-- Limb (c) at 11 pounds: 762.67.
#ASSERT `reg 119(2) — the assessment period is outside the recovery of paragraph (1)` (`test — recovery facts` FALSE FALSE TRUE 762.67 NOTHING 11)
#ASSERT NOT (`reg 119(2) — the assessment period is outside the recovery of paragraph (1)` (`test — recovery facts` FALSE FALSE TRUE 762.66 NOTHING 11))
-- A limb whose own condition (the claimants' position under regulation 90) is not met does not apply, however high the earnings.
#ASSERT NOT (`reg 119(2) — the assessment period is outside the recovery of paragraph (1)` (`test — recovery facts` FALSE FALSE FALSE 5000 (JUST 693) 10))
#ASSERT `reg 119(2) — the assessment period is outside the recovery of paragraph (1)` `test — a month outside the recovery`
#ASSERT NOT (`reg 119(2) — the assessment period is outside the recovery of paragraph (1)` `test — a month within the recovery`)

-- Regulation 119(3): six assessment periods, not necessarily together, in which (a), (b) or (c) was met.
#ASSERT `reg 119(3) — paragraph (1) has ceased to apply` (LIST `test — a month outside the recovery`, `test — a month outside the recovery`, `test — a month outside the recovery`, `test — a month outside the recovery`, `test — a month outside the recovery`, `test — a month outside the recovery`)
#ASSERT NOT (`reg 119(3) — paragraph (1) has ceased to apply` (LIST `test — a month outside the recovery`, `test — a month outside the recovery`, `test — a month outside the recovery`, `test — a month outside the recovery`, `test — a month outside the recovery`))
#ASSERT `reg 119(3) — paragraph (1) has ceased to apply` (LIST `test — a month outside the recovery`, `test — a month within the recovery`, `test — a month outside the recovery`, `test — a month outside the recovery`, `test — a month within the recovery`, `test — a month outside the recovery`, `test — a month outside the recovery`, `test — a month outside the recovery`)
#ASSERT NOT (`reg 119(3) — paragraph (1) has ceased to apply` (LIST `test — a month outside the recovery`, `test — a month within the recovery`, `test — a month outside the recovery`, `test — a month outside the recovery`, `test — a month within the recovery`, `test — a month outside the recovery`, `test — a month within the recovery`))
#ASSERT NOT (`reg 119(3) — paragraph (1) has ceased to apply` EMPTY)

-- Regulation 119(1): recoverable unless paragraph (2) applies to the assessment period or paragraph (3) has ended it.
#ASSERT `reg 119(1) — hardship payments are recoverable` FALSE FALSE
#ASSERT NOT (`reg 119(1) — hardship payments are recoverable` TRUE FALSE)
#ASSERT NOT (`reg 119(1) — hardship payments are recoverable` FALSE TRUE)
#ASSERT NOT (`reg 119(1) — hardship payments are recoverable` TRUE TRUE)

-- The signature line states no rule (coverage row: inert, machinery).
#ASSERT `the signature line — signed by authority of the Secretary of State for Work and Pensions` EQUALS "Signed by authority of the Secretary of State for Work and Pensions."
