IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-persons`
IMPORT `uc4-part8-ch1-carers-hours`
IMPORT `uc4-part8-ch1-groups`

-- Tests of uc4-part8-ch1-groups.l4: regulations 89 to 92.
-- Expected values are written by hand from the text, beside the assertion.

-- ---------------------------------------------------------------------------------------------------------
-- Fixtures.
GIVEN caring IS A BOOLEAN
      allowance IS A BOOLEAN
      support IS A BOOLEAN
      satisfied IS A BOOLEAN
GIVETH A `Caring for a severely disabled person`
`test — caring` caring allowance support satisfied MEANS `Caring for a severely disabled person` WITH
    `the claimant has caring responsibilities for one or more severely disabled persons for at least 35 hours a week` IS caring
    `the claimant meets the conditions for entitlement to a carer's allowance` IS allowance
    `the claimant has entitlement to carer support payment` IS support
    `the Secretary of State is satisfied that it would be unreasonable to require the claimant to comply with a work search requirement and a work availability requirement, including if such a requirement were limited in accordance with section 17(4) or 18(3) of the Act` IS satisfied

GIVEN pregnant IS A BOOLEAN
      expected IS A MAYBE DATE
      was IS A BOOLEAN
      confined IS A MAYBE DATE
GIVETH A `Pregnancy or confinement`
`test — pregnancy` pregnant expected was confined MEANS `Pregnancy or confinement` WITH
    `the claimant is pregnant` IS pregnant
    `first day of her expected week of confinement` IS expected
    `the claimant was pregnant` IS was
    `date of her confinement` IS confined

GIVEN matched IS A BOOLEAN
      rc IS A BOOLEAN
      fostered IS A MAYBE `Placement of a child with a person`
      relation IS A `Listed relation`
GIVETH AN `Adopter facts`
`test — adopter` matched rc fostered relation MEANS `Adopter facts` WITH
    `an adoption agency has decided that the person would be a suitable adoptive parent for the child` IS matched
    `the person is, or is intended to be, the responsible carer for the child` IS rc
    `the person's placement of the child as a foster parent` IS fostered
    `the person's relation to the child` IS `Possible close relative` WITH
        `relation to the person` IS relation
        `relation of the partner to the person` IS `not a listed relation`

GIVEN placed IS A DATE
      requested IS A BOOLEAN
      from IS A MAYBE DATE
GIVETH AN `Adoption placement`
`test — adoption placement` placed requested from MEANS `Adoption placement` WITH
    `date on which the child was placed with the claimant` IS placed
    `the claimant requested that the 12 months should run from a date within 14 days before the child was expected to be placed` IS requested
    `the date from which the claimant requested that the 12 months should run` IS from

`test — an adopter` MEANS `test — adopter` TRUE TRUE NOTHING `not a listed relation`

GIVEN nation IS A `Nation of Great Britain`
      placed IS A BOOLEAN
      carer IS A BOOLEAN
GIVETH A `Placement of a child with a person`
`test — placement` nation placed carer MEANS `Placement of a child with a person` WITH
    `nation in which the child is placed` IS nation
    `child is placed with the person under the placement regulations` IS placed
    `person is a foster carer or a kinship carer` IS carer

GIVEN claimant IS A `Placement of a child with a person`
      other IS A MAYBE `Placement of a child with a person`
      anyone IS A BOOLEAN
      nominated IS A BOOLEAN
GIVETH A `Foster parents of a child`
`test — foster parents` claimant other anyone nominated MEANS `Foster parents of a child` WITH
    `the claimant's placement of the child` IS claimant
    `the other member of the couple's placement of the child` IS other
    `any other person, not a member of the couple, is a foster parent in relation to the child` IS anyone
    `the claimant is the member nominated in accordance with regulation 86` IS nominated

-- The only foster parent: a placement in England, no partner, no one else.
`test — the responsible foster parent` MEANS `test — foster parents` (`test — placement` England TRUE FALSE) NOTHING FALSE FALSE
-- A foster parent who is not the responsible one: both members of the couple are foster parents and the other member is the nominated one.
`test — a foster parent who is not the responsible one` MEANS `test — foster parents` (`test — placement` England TRUE FALSE) (JUST (`test — placement` England TRUE FALSE)) FALSE FALSE
-- Not a foster parent at all.
`test — not a foster parent` MEANS `test — foster parents` (`test — placement` England FALSE FALSE) NOTHING FALSE FALSE

GIVEN foster IS A `Foster parents of a child`
      child IS A BOOLEAN
      young IS A BOOLEAN
      atleast1 IS A BOOLEAN
      care IS A BOOLEAN
GIVETH A `Fostered person facts`
`test — fostered person` foster child young atleast1 care MEANS `Fostered person facts` WITH
    `the claimant's foster parenthood of the person` IS foster
    `the person fostered is a child` IS child
    `the person fostered is a qualifying young person` IS young
    `the person fostered is aged at least 1` IS atleast1
    `the Secretary of State is satisfied that the child or qualifying young person has care needs which would make it unreasonable to require the claimant to comply with a work search requirement or a work availability requirement, including if such a requirement were limited in accordance with section 17(4) or 18(3) of the Act` IS care

GIVEN parent IS A BOOLEAN
      couple IS A BOOLEAN
      both IS A BOOLEAN
GIVETH A `Relationship to a child or qualifying young person`
`test — relationship` parent couple both MEANS `Relationship to a child or qualifying young person` WITH
    `person is a parent of A` IS parent
    `person is a member of a couple, the other member of which is a parent of A` IS couple
    `the person and that parent are both responsible for A` IS both
    `person was previously a member of a couple, the other member of which was a parent of A` IS FALSE
    `immediately before ceasing to be a member of that couple the person was responsible for A` IS FALSE
    `since then the person has continued to be responsible for A` IS FALSE

GIVEN responsible IS A BOOLEAN
      relationship IS A `Relationship to a child or qualifying young person`
      noparent IS A BOOLEAN
      looked IS A BOOLEAN
GIVETH A `Friend or family carer facts`
`test — friend or family carer` responsible relationship noparent looked MEANS `Friend or family carer facts` WITH
    `the claimant is responsible for the child` IS responsible
    `the claimant's relationship to the child` IS relationship
    `the child has no parent or has parents who are unable to care for the child` IS noparent
    `it is likely that the child would otherwise be looked after by a local authority because of concerns in relation to the child's welfare` IS looked

GIVEN income IS A NUMBER
      fluctuates IS A BOOLEAN
      cycle IS A BOOLEAN
      cycleaverage IS A NUMBER
      otheraverage IS A NUMBER
GIVETH AN `Earnings for the monthly earnings of regulation 90(6)`
`test — earnings` income fluctuates cycle cycleaverage otheraverage MEANS `Earnings for the monthly earnings of regulation 90(6)` WITH
    `earned income calculated or estimated in relation to the current assessment period before any deduction` IS income
    `the person's earned income fluctuates (or is likely to fluctuate)` IS fluctuates
    `there is an identifiable cycle` IS cycle
    `monthly average over the duration of one such cycle` IS cycleaverage
    `monthly average over three months or such other period as may enable the monthly average to be determined more accurately` IS otheraverage

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 89(1)(a).
#ASSERT `reg 89(1)(a) — the claimant has reached the qualifying age for state pension credit` TRUE
#ASSERT NOT (`reg 89(1)(a) — the claimant has reached the qualifying age for state pension credit` FALSE)

-- Regulation 89(1)(b): caring for a severely disabled person for 35 hours a week, not meeting the carer's allowance conditions nor entitled to carer
-- support payment, and the Secretary of State satisfied that work search and work availability requirements are unreasonable.
#ASSERT `reg 89(1)(b) — the claimant cares for a severely disabled person` (`test — caring` TRUE FALSE FALSE TRUE)
#ASSERT NOT (`reg 89(1)(b) — the claimant cares for a severely disabled person` (`test — caring` FALSE FALSE FALSE TRUE))
-- Meeting the carer's allowance conditions takes the claimant out of (b); so does entitlement to carer support payment; so does a lack of the satisfaction (fork F-89-1).
#ASSERT NOT (`reg 89(1)(b) — the claimant cares for a severely disabled person` (`test — caring` TRUE TRUE FALSE TRUE))
#ASSERT NOT (`reg 89(1)(b) — the claimant cares for a severely disabled person` (`test — caring` TRUE FALSE TRUE TRUE))
#ASSERT NOT (`reg 89(1)(b) — the claimant cares for a severely disabled person` (`test — caring` TRUE TRUE TRUE TRUE))
#ASSERT NOT (`reg 89(1)(b) — the claimant cares for a severely disabled person` (`test — caring` TRUE FALSE FALSE FALSE))

-- Regulation 89(1)(c). As at 1 June 2026. The expected week begins on 17 August 2026: 77 days (11 weeks) later.
#ASSERT `reg 89(1)(c) — the claimant is pregnant or recently confined` (`test — pregnancy` TRUE (JUST (YMD 2026 8 17)) FALSE NOTHING) (YMD 2026 6 1)
-- 78 days: one day too early.
#ASSERT NOT (`reg 89(1)(c) — the claimant is pregnant or recently confined` (`test — pregnancy` TRUE (JUST (YMD 2026 8 18)) FALSE NOTHING) (YMD 2026 6 1))
-- Not pregnant.
#ASSERT NOT (`reg 89(1)(c) — the claimant is pregnant or recently confined` (`test — pregnancy` FALSE (JUST (YMD 2026 8 17)) FALSE NOTHING) (YMD 2026 6 1))
-- Pregnant but no expected week given: the limb cannot be shown.
#ASSERT NOT (`reg 89(1)(c) — the claimant is pregnant or recently confined` (`test — pregnancy` TRUE NOTHING FALSE NOTHING) (YMD 2026 6 1))
-- Confined on 16 February 2026: 105 days (15 weeks) before 1 June 2026.
#ASSERT `reg 89(1)(c) — the claimant is pregnant or recently confined` (`test — pregnancy` FALSE NOTHING TRUE (JUST (YMD 2026 2 16))) (YMD 2026 6 1)
#ASSERT `reg 89(1)(c) — the claimant is pregnant or recently confined` (`test — pregnancy` FALSE NOTHING TRUE (JUST (YMD 2026 2 17))) (YMD 2026 6 1)
-- Confined on 15 February 2026: 106 days, one day too late.
#ASSERT NOT (`reg 89(1)(c) — the claimant is pregnant or recently confined` (`test — pregnancy` FALSE NOTHING TRUE (JUST (YMD 2026 2 15))) (YMD 2026 6 1))
-- A confinement date after the date asked about is not "since the date of confinement".
#ASSERT NOT (`reg 89(1)(c) — the claimant is pregnant or recently confined` (`test — pregnancy` FALSE NOTHING TRUE (JUST (YMD 2026 6 2))) (YMD 2026 6 1))
#ASSERT NOT (`reg 89(1)(c) — the claimant is pregnant or recently confined` (`test — pregnancy` FALSE NOTHING FALSE (JUST (YMD 2026 2 16))) (YMD 2026 6 1))

-- Regulation 89(3): adopter.
#ASSERT `reg 89(3) — adopter` (`test — adopter` TRUE TRUE NOTHING `not a listed relation`)
#ASSERT NOT (`reg 89(3) — adopter` (`test — adopter` FALSE TRUE NOTHING `not a listed relation`))
#ASSERT NOT (`reg 89(3) — adopter` (`test — adopter` TRUE FALSE NOTHING `not a listed relation`))
-- A foster parent of the child is excluded; so is a close relative.
#ASSERT NOT (`reg 89(3) — adopter` (`test — adopter` TRUE TRUE (JUST (`test — placement` England TRUE FALSE)) `not a listed relation`))
#ASSERT NOT (`reg 89(3) — adopter` (`test — adopter` TRUE TRUE NOTHING `a brother`))
-- A placement that is not a foster placement does not exclude.
#ASSERT `reg 89(3) — adopter` (`test — adopter` TRUE TRUE (JUST (`test — placement` England FALSE FALSE)) `not a listed relation`)

-- Regulation 89(1)(d): the child was placed on 1 March 2026; 12 months or less since is up to and including 1 March 2027.
#ASSERT `reg 89(1)(d) — the claimant is an adopter within 12 months of the placement` `test — an adopter` (`test — adoption placement` (YMD 2026 3 1) FALSE NOTHING) (YMD 2026 3 1)
#ASSERT `reg 89(1)(d) — the claimant is an adopter within 12 months of the placement` `test — an adopter` (`test — adoption placement` (YMD 2026 3 1) FALSE NOTHING) (YMD 2027 3 1)
#ASSERT NOT (`reg 89(1)(d) — the claimant is an adopter within 12 months of the placement` `test — an adopter` (`test — adoption placement` (YMD 2026 3 1) FALSE NOTHING) (YMD 2027 3 2))
-- Before the placement, with no request: not yet "since" the placement.
#ASSERT NOT (`reg 89(1)(d) — the claimant is an adopter within 12 months of the placement` `test — an adopter` (`test — adoption placement` (YMD 2026 3 1) FALSE NOTHING) (YMD 2026 2 28))
-- A request that the 12 months run from 20 February 2026: that date counts from the requested date.
#ASSERT `reg 89(1)(d) — the claimant is an adopter within 12 months of the placement` `test — an adopter` (`test — adoption placement` (YMD 2026 3 1) TRUE (JUST (YMD 2026 2 20))) (YMD 2026 2 25)
#ASSERT `reg 89(1)(d) — the claimant is an adopter within 12 months of the placement` `test — an adopter` (`test — adoption placement` (YMD 2026 3 1) TRUE (JUST (YMD 2026 2 20))) (YMD 2027 3 1)
#ASSERT NOT (`reg 89(1)(d) — the claimant is an adopter within 12 months of the placement` `test — an adopter` (`test — adoption placement` (YMD 2026 3 1) TRUE (JUST (YMD 2026 2 20))) (YMD 2027 3 2))
#ASSERT NOT (`reg 89(1)(d) — the claimant is an adopter within 12 months of the placement` `test — an adopter` (`test — adoption placement` (YMD 2026 3 1) TRUE (JUST (YMD 2026 2 20))) (YMD 2026 2 19))
-- Without the request, the same early date is not within the period.
#ASSERT NOT (`reg 89(1)(d) — the claimant is an adopter within 12 months of the placement` `test — an adopter` (`test — adoption placement` (YMD 2026 3 1) FALSE (JUST (YMD 2026 2 20))) (YMD 2026 2 25))
-- Not an adopter.
#ASSERT NOT (`reg 89(1)(d) — the claimant is an adopter within 12 months of the placement` (`test — adopter` FALSE TRUE NOTHING `not a listed relation`) (`test — adoption placement` (YMD 2026 3 1) FALSE NOTHING) (YMD 2026 6 1))

-- Regulation 89(4): a postgraduate loan on a course that is not full-time is not student income.
#ASSERT `reg 89(4) — the claimant is treated as having student income` TRUE FALSE FALSE
#ASSERT `reg 89(4) — the claimant is treated as having student income` TRUE TRUE TRUE
#ASSERT NOT (`reg 89(4) — the claimant is treated as having student income` TRUE TRUE FALSE)
#ASSERT NOT (`reg 89(4) — the claimant is treated as having student income` FALSE FALSE FALSE)

-- Regulation 89(1)(da), (e), (f).
#ASSERT `reg 89(1)(da) — a member of a couple with student income` TRUE TRUE
#ASSERT NOT (`reg 89(1)(da) — a member of a couple with student income` TRUE FALSE)
#ASSERT NOT (`reg 89(1)(da) — a member of a couple with student income` FALSE TRUE)
#ASSERT `reg 89(1)(e) — the claimant need not meet the condition of not receiving education` TRUE TRUE FALSE
#ASSERT `reg 89(1)(e) — the claimant need not meet the condition of not receiving education` TRUE FALSE TRUE
#ASSERT NOT (`reg 89(1)(e) — the claimant need not meet the condition of not receiving education` TRUE FALSE FALSE)
#ASSERT NOT (`reg 89(1)(e) — the claimant need not meet the condition of not receiving education` FALSE TRUE TRUE)
#ASSERT `reg 89(1)(f) — the responsible foster parent of a child under 1` `test — the responsible foster parent` TRUE
#ASSERT NOT (`reg 89(1)(f) — the responsible foster parent of a child under 1` `test — the responsible foster parent` FALSE)
#ASSERT NOT (`reg 89(1)(f) — the responsible foster parent of a child under 1` `test — a foster parent who is not the responsible one` TRUE)

-- Regulation 89(1) as a whole.
#ASSERT `reg 89(1) — the claimant falls within section 19 of the Act` TRUE FALSE FALSE FALSE FALSE FALSE FALSE
#ASSERT `reg 89(1) — the claimant falls within section 19 of the Act` FALSE FALSE FALSE FALSE FALSE FALSE TRUE
#ASSERT `reg 89(1) — the claimant falls within section 19 of the Act` FALSE FALSE FALSE TRUE FALSE FALSE FALSE
#ASSERT NOT (`reg 89(1) — the claimant falls within section 19 of the Act` FALSE FALSE FALSE FALSE FALSE FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 90: the monthly amount for 16 hours a week at 12 pounds an hour is 16 x 12 x 52 / 12 = 832.
#ASSERT `reg 90 — the monthly amount paid for hours a week at an hourly rate, fraction of a pound disregarded` 16 12 EQUALS 832
-- 16 hours at 12.50 is 200 a week, 10400 a year-week product, / 12 = 866.666...: the fraction of a pound is disregarded.
#ASSERT `reg 90 — the monthly amount paid for hours a week at an hourly rate, fraction of a pound disregarded` 16 12.5 EQUALS 866
#ASSERT `reg 90 — the monthly amount paid for hours a week at an hourly rate` 16 12.5 EQUALS 10400 DIVIDED BY 12
-- 35 hours at 12 pounds: 35 x 12 x 52 / 12 = 1820.
#ASSERT `reg 90 — the monthly amount paid for hours a week at an hourly rate, fraction of a pound disregarded` 35 12 EQUALS 1820

-- Regulation 90(2): the individual threshold.
#ASSERT `reg 90(2) — the individual threshold` `subject to work-focused interview requirement only` 12 35 EQUALS JUST 832
#ASSERT `reg 90(2) — the individual threshold` `subject to work-preparation requirement` 12 35 EQUALS JUST 832
#ASSERT `reg 90(2) — the individual threshold` `subject to all work-related requirements` 12 35 EQUALS JUST 1820
-- With a lesser expected number of hours, 20: 20 x 12 x 52 / 12 = 1040.
#ASSERT `reg 90(2) — the individual threshold` `subject to all work-related requirements` 12 20 EQUALS JUST 1040
-- Sections 20 and 21 use 16 hours whatever the expected hours.
#ASSERT `reg 90(2) — the individual threshold` `subject to work-focused interview requirement only` 12 20 EQUALS JUST 832
-- A claimant who would otherwise fall within section 19 has no individual threshold: not covered.
#ASSERT `reg 90(2) — the individual threshold` `subject to no work-related requirements` 12 35 EQUALS NOTHING

-- Regulation 90(1): monthly earnings equal to or exceeding the threshold.
#ASSERT `reg 90(1) — the claimant's monthly earnings equal or exceed the individual threshold` 832 (JUST 832) EQUALS JUST TRUE
#ASSERT `reg 90(1) — the claimant's monthly earnings equal or exceed the individual threshold` 1000 (JUST 832) EQUALS JUST TRUE
#ASSERT `reg 90(1) — the claimant's monthly earnings equal or exceed the individual threshold` 831.99 (JUST 832) EQUALS JUST FALSE
#ASSERT `reg 90(1) — the claimant's monthly earnings equal or exceed the individual threshold` 900 NOTHING EQUALS NOTHING

-- Regulation 90(3): the couple's threshold. Joint claimants: 832 + 1040 = 1872.
#ASSERT `reg 90(3) — the threshold for the couple's combined monthly earnings` `joint claimants` 832 1040 12 EQUALS JUST 1872
-- A member of a couple claiming as a single person: 832 + (35 hours at 12 pounds = 1820) = 2652.
#ASSERT `reg 90(3) — the threshold for the couple's combined monthly earnings` `a single claimant who is a member of a couple` 832 0 12 EQUALS JUST 2652
-- A single claimant who is not a member of a couple: not covered.
#ASSERT `reg 90(3) — the threshold for the couple's combined monthly earnings` `a single claimant` 832 0 12 EQUALS NOTHING
#ASSERT `reg 90(3) — the couple's combined monthly earnings equal or exceed the threshold` 1872 (JUST 1872) EQUALS JUST TRUE
#ASSERT `reg 90(3) — the couple's combined monthly earnings equal or exceed the threshold` 1871.99 (JUST 1872) EQUALS JUST FALSE
#ASSERT `reg 90(3) — the couple's combined monthly earnings equal or exceed the threshold` 2000 NOTHING EQUALS NOTHING

-- Regulation 90(4): an apprentice, at a rate of 10 pounds: 30 hours is 30 x 10 x 52 / 12 = 1300.
#ASSERT `reg 90(4) — the apprentice's monthly earnings equal or exceed the threshold` TRUE 1300 35 10
#ASSERT NOT (`reg 90(4) — the apprentice's monthly earnings equal or exceed the threshold` TRUE 1299.99 35 10)
-- With expected hours of 20 (less than 30): 20 x 10 x 52 / 12 = 866.67, fraction disregarded: 866.
#ASSERT `reg 90(4) — the apprentice's monthly earnings equal or exceed the threshold` TRUE 866 20 10
#ASSERT NOT (`reg 90(4) — the apprentice's monthly earnings equal or exceed the threshold` TRUE 865.99 20 10)
-- Not an apprentice.
#ASSERT NOT (`reg 90(4) — the apprentice's monthly earnings equal or exceed the threshold` FALSE 5000 35 10)

-- Regulation 90(5).
#ASSERT `reg 90(5) — the claimant is treated as having earned income under the minimum income floor` TRUE
#ASSERT NOT (`reg 90(5) — the claimant is treated as having earned income under the minimum income floor` FALSE)

-- Regulation 90(6): monthly earnings.
#ASSERT `reg 90(6) — the person's monthly earnings` (`test — earnings` 1200 FALSE FALSE 999 888) EQUALS 1200
#ASSERT `reg 90(6) — the person's monthly earnings` (`test — earnings` 1200 TRUE TRUE 999 888) EQUALS 999
#ASSERT `reg 90(6) — the person's monthly earnings` (`test — earnings` 1200 TRUE FALSE 999 888) EQUALS 888

-- Regulation 90 as a whole. A NOTHING route does not apply.
#ASSERT `reg 90 — the claimant falls within section 19 of the Act by the earnings thresholds` (JUST TRUE) NOTHING FALSE FALSE
#ASSERT `reg 90 — the claimant falls within section 19 of the Act by the earnings thresholds` NOTHING (JUST TRUE) FALSE FALSE
#ASSERT `reg 90 — the claimant falls within section 19 of the Act by the earnings thresholds` (JUST FALSE) (JUST FALSE) TRUE FALSE
#ASSERT `reg 90 — the claimant falls within section 19 of the Act by the earnings thresholds` NOTHING NOTHING FALSE TRUE
#ASSERT NOT (`reg 90 — the claimant falls within section 19 of the Act by the earnings thresholds` (JUST FALSE) NOTHING FALSE FALSE)
#ASSERT NOT (`reg 90 — the claimant falls within section 19 of the Act by the earnings thresholds` NOTHING NOTHING FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 91(2)(a): the responsible foster parent of a child aged at least 1.
#ASSERT `reg 91(2)(a) — the responsible foster parent of a child aged at least 1` (`test — fostered person` `test — the responsible foster parent` TRUE FALSE TRUE FALSE)
-- A child under 1 is regulation 89(1)(f).
#ASSERT NOT (`reg 91(2)(a) — the responsible foster parent of a child aged at least 1` (`test — fostered person` `test — the responsible foster parent` TRUE FALSE FALSE FALSE))
-- A qualifying young person is limb (b).
#ASSERT NOT (`reg 91(2)(a) — the responsible foster parent of a child aged at least 1` (`test — fostered person` `test — the responsible foster parent` FALSE TRUE TRUE FALSE))
#ASSERT NOT (`reg 91(2)(a) — the responsible foster parent of a child aged at least 1` (`test — fostered person` `test — a foster parent who is not the responsible one` TRUE FALSE TRUE FALSE))

-- Regulation 91(2)(b): the responsible foster parent of a qualifying young person with care needs.
#ASSERT `reg 91(2)(b) — the responsible foster parent of a qualifying young person with care needs` (`test — fostered person` `test — the responsible foster parent` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 91(2)(b) — the responsible foster parent of a qualifying young person with care needs` (`test — fostered person` `test — the responsible foster parent` FALSE TRUE TRUE FALSE))
#ASSERT NOT (`reg 91(2)(b) — the responsible foster parent of a qualifying young person with care needs` (`test — fostered person` `test — the responsible foster parent` TRUE FALSE TRUE TRUE))

-- Regulation 91(2)(c): a foster parent who is not the responsible foster parent, of a child or a qualifying young person, with care needs.
#ASSERT `reg 91(2)(c) — a foster parent who is not the responsible foster parent, with care needs` (`test — fostered person` `test — a foster parent who is not the responsible one` TRUE FALSE TRUE TRUE)
#ASSERT `reg 91(2)(c) — a foster parent who is not the responsible foster parent, with care needs` (`test — fostered person` `test — a foster parent who is not the responsible one` FALSE TRUE TRUE TRUE)
#ASSERT NOT (`reg 91(2)(c) — a foster parent who is not the responsible foster parent, with care needs` (`test — fostered person` `test — a foster parent who is not the responsible one` TRUE FALSE TRUE FALSE))
#ASSERT NOT (`reg 91(2)(c) — a foster parent who is not the responsible foster parent, with care needs` (`test — fostered person` `test — the responsible foster parent` TRUE FALSE TRUE TRUE))
#ASSERT NOT (`reg 91(2)(c) — a foster parent who is not the responsible foster parent, with care needs` (`test — fostered person` `test — not a foster parent` TRUE FALSE TRUE TRUE))

-- Regulation 91(2)(d): last within (a), (b) or (c) on 6 April 2026; 56 days (8 weeks) later is 1 June 2026.
#ASSERT `reg 91(2)(d) — a foster parent between placements` (JUST (YMD 2026 4 6)) TRUE TRUE (YMD 2026 6 1)
#ASSERT NOT (`reg 91(2)(d) — a foster parent between placements` (JUST (YMD 2026 4 6)) TRUE TRUE (YMD 2026 6 2))
#ASSERT NOT (`reg 91(2)(d) — a foster parent between placements` (JUST (YMD 2026 4 6)) FALSE TRUE (YMD 2026 6 1))
#ASSERT NOT (`reg 91(2)(d) — a foster parent between placements` (JUST (YMD 2026 4 6)) TRUE FALSE (YMD 2026 6 1))
#ASSERT NOT (`reg 91(2)(d) — a foster parent between placements` NOTHING TRUE TRUE (YMD 2026 6 1))
-- A date after the date asked about is not "within the past 8 weeks".
#ASSERT NOT (`reg 91(2)(d) — a foster parent between placements` (JUST (YMD 2026 6 2)) TRUE TRUE (YMD 2026 6 1))

-- Regulation 91(3): friend or family carer.
#ASSERT `reg 91(3) — friend or family carer` (`test — friend or family carer` TRUE (`test — relationship` FALSE FALSE FALSE) TRUE FALSE)
#ASSERT `reg 91(3) — friend or family carer` (`test — friend or family carer` TRUE (`test — relationship` FALSE FALSE FALSE) FALSE TRUE)
#ASSERT NOT (`reg 91(3) — friend or family carer` (`test — friend or family carer` TRUE (`test — relationship` FALSE FALSE FALSE) FALSE FALSE))
-- Not a friend or family carer if responsible but the child's parent, or the child's step-parent, or not responsible.
#ASSERT NOT (`reg 91(3) — friend or family carer` (`test — friend or family carer` TRUE (`test — relationship` TRUE FALSE FALSE) TRUE TRUE))
#ASSERT NOT (`reg 91(3) — friend or family carer` (`test — friend or family carer` TRUE (`test — relationship` FALSE TRUE TRUE) TRUE TRUE))
#ASSERT NOT (`reg 91(3) — friend or family carer` (`test — friend or family carer` FALSE (`test — relationship` FALSE FALSE FALSE) TRUE TRUE))

-- Regulation 91(2)(e): became a friend or family carer on 1 March 2026; within the past 12 months up to and including 1 March 2027.
#ASSERT `reg 91(2)(e) — a friend or family carer within 12 months` (`test — friend or family carer` TRUE (`test — relationship` FALSE FALSE FALSE) TRUE FALSE) (YMD 2026 3 1) TRUE (YMD 2027 3 1)
#ASSERT NOT (`reg 91(2)(e) — a friend or family carer within 12 months` (`test — friend or family carer` TRUE (`test — relationship` FALSE FALSE FALSE) TRUE FALSE) (YMD 2026 3 1) TRUE (YMD 2027 3 2))
#ASSERT NOT (`reg 91(2)(e) — a friend or family carer within 12 months` (`test — friend or family carer` TRUE (`test — relationship` FALSE FALSE FALSE) TRUE FALSE) (YMD 2026 3 1) TRUE (YMD 2026 2 28))
-- ... and also the responsible carer in relation to that child.
#ASSERT NOT (`reg 91(2)(e) — a friend or family carer within 12 months` (`test — friend or family carer` TRUE (`test — relationship` FALSE FALSE FALSE) TRUE FALSE) (YMD 2026 3 1) FALSE (YMD 2026 6 1))

-- Regulation 91(2) as a whole.
#ASSERT `reg 91(2) — the claimant falls within section 20 of the Act` TRUE FALSE FALSE FALSE FALSE
#ASSERT `reg 91(2) — the claimant falls within section 20 of the Act` FALSE FALSE FALSE FALSE TRUE
#ASSERT NOT (`reg 91(2) — the claimant falls within section 20 of the Act` FALSE FALSE FALSE FALSE FALSE)
