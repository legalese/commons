IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-persons`
IMPORT `uc4-part5-assessment`

-- Tests of uc4-part5-assessment.l4: regulations 41 to 44.
-- Expected values are written by hand from the text, beside the assertion.

-- ---------------------------------------------------------------------------------------------------------
-- Fixtures.
GIVEN a IS A BOOLEAN, b IS A BOOLEAN
GIVETH A `Change of circumstances`
`test — change` a b MEANS `Change of circumstances` WITH
    `the change relates to the claimant's physical or mental condition` IS a
    `the change consists of doing work for payment or in expectation of payment, or doing voluntary work` IS b

GIVEN a IS A BOOLEAN, b IS A BOOLEAN
GIVETH A `Review of a previous determination`
`test — review` a b MEANS `Review of a previous determination` WITH
    `the assessment is for the purposes of reviewing a previous determination that the claimant has limited capability for work or for work and work-related activity that was made on the basis of an assessment under this Part or under Part 4 or 5 of the ESA Regulations` IS a
    `the assessment is for the purposes of reviewing a previous determination that the claimant is a severe conditions criteria claimant made on the basis of an assessment under this Part` IS b

GIVEN a IS A BOOLEAN, b IS A BOOLEAN, c IS A BOOLEAN, d IS A BOOLEAN
GIVETH A `Previous determinations`
`test — previous` a b c d MEANS `Previous determinations` WITH
    `determined on the basis of an assessment under this Part or under Part 4 or 5 of the ESA Regulations that the claimant does not have limited capability for work` IS a
    `determined on the basis of an assessment under this Part that the claimant is a severe conditions criteria claimant` IS b
    `determined on the basis of an assessment under this Part or under Part 4 or 5 of the ESA Regulations that the claimant has limited capability for work` IS c
    `determined on the basis of an assessment under this Part that the claimant is not a severe conditions criteria claimant` IS d

GIVEN firstdate IS A DATE, further IS A MAYBE DATE
GIVETH A `Requests for information`
`test — requests` firstdate further MEANS `Requests for information` WITH
    `date of the first request` IS firstdate
    `date on which a further request was sent` IS further

GIVEN given IS A DATE, exam IS A DATE, details IS A BOOLEAN, agreed IS A BOOLEAN
GIVETH A `Notice of a medical examination`
`test — notice` given exam details agreed MEANS `Notice of a medical examination` WITH
    `date on which the notice was given` IS given
    `date of the examination` IS exam
    `the notice gave the date, time and place of the examination` IS details
    `the claimant agreed to accept less than 7 days' notice` IS agreed

`test — a doctor` MEANS Practitioner WITH
    `registered medical practitioner` IS TRUE
    `registered nurse` IS FALSE
    `occupational therapist or physiotherapist` IS FALSE
    `registered with a regulatory body established under section 60 of the Health Act 1999` IS FALSE

`test — a physiotherapist who is not registered` MEANS Practitioner WITH
    `registered medical practitioner` IS FALSE
    `registered nurse` IS FALSE
    `occupational therapist or physiotherapist` IS TRUE
    `registered with a regulatory body established under section 60 of the Health Act 1999` IS FALSE

`test — a registered physiotherapist` MEANS Practitioner WITH
    `registered medical practitioner` IS FALSE
    `registered nurse` IS FALSE
    `occupational therapist or physiotherapist` IS TRUE
    `registered with a regulatory body established under section 60 of the Health Act 1999` IS TRUE

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 41(1): first determination, or a previous determination and the Secretary of State's wish.
#ASSERT `reg 41(1) — the occasion for an assessment` TRUE FALSE FALSE
#ASSERT `reg 41(1) — the occasion for an assessment` FALSE TRUE TRUE
#ASSERT NOT (`reg 41(1) — the occasion for an assessment` FALSE TRUE FALSE)
#ASSERT NOT (`reg 41(1) — the occasion for an assessment` FALSE FALSE TRUE)
#ASSERT NOT (`reg 41(1) — the occasion for an assessment` FALSE FALSE FALSE)
-- A first determination suffices without any wish.
#ASSERT `reg 41(1) — the occasion for an assessment` TRUE TRUE FALSE

-- Regulation 41(1A): a change counts only if it relates to the claimant's condition, and doing work or voluntary work never counts.
#ASSERT `reg 41(1A) — a relevant change of circumstances` (`test — change` TRUE FALSE)
#ASSERT NOT (`reg 41(1A) — a relevant change of circumstances` (`test — change` TRUE TRUE))
#ASSERT NOT (`reg 41(1A) — a relevant change of circumstances` (`test — change` FALSE TRUE))
#ASSERT NOT (`reg 41(1A) — a relevant change of circumstances` (`test — change` FALSE FALSE))

-- Regulation 41(3): 12 pounds an hour for 16 hours a week for 52 weeks over 12 months is 12 x 16 x 52 / 12 = 832 pounds a month.
#ASSERT `reg 41(3) — the relevant threshold` 12 EQUALS 832
-- 10 x 16 x 52 / 12 = 8320 / 12 = 693.33...: regulation 6(1) disregards a fraction of a penny of less than half a penny (693.33), and it is not
-- rounded to the pound.
#ASSERT `reg 41(3) — the relevant threshold` 10 EQUALS 693.33
-- 11 x 16 x 52 / 12 = 9152 / 12 = 762.66...: half a penny or more counts as a penny (762.67).
#ASSERT `reg 41(3) — the relevant threshold` 11 EQUALS 762.67
#ASSERT `reg 41(3) — the relevant threshold` 0 EQUALS 0

-- Regulation 41(2)(a): the seven benefits.
#ASSERT `reg 41(2)(a) — the claimant is entitled to one of the benefits listed` (LIST `attendance allowance`)
#ASSERT `reg 41(2)(a) — the claimant is entitled to one of the benefits listed` (LIST `pension age disability payment`)
#ASSERT `reg 41(2)(a) — the claimant is entitled to one of the benefits listed` (LIST `disability living allowance`)
#ASSERT `reg 41(2)(a) — the claimant is entitled to one of the benefits listed` (LIST `Scottish adult disability living allowance`)
#ASSERT `reg 41(2)(a) — the claimant is entitled to one of the benefits listed` (LIST `child disability payment`)
#ASSERT `reg 41(2)(a) — the claimant is entitled to one of the benefits listed` (LIST `adult disability payment`)
#ASSERT `reg 41(2)(a) — the claimant is entitled to one of the benefits listed` (LIST `personal independence payment`)
#ASSERT `reg 41(2)(a) — the claimant is entitled to one of the benefits listed` (LIST `carer's allowance`, `personal independence payment`)
-- Not on the list: carer's allowance, war disablement pension, employment and support allowance, nothing.
#ASSERT NOT (`reg 41(2)(a) — the claimant is entitled to one of the benefits listed` (LIST `carer's allowance`))
#ASSERT NOT (`reg 41(2)(a) — the claimant is entitled to one of the benefits listed` (LIST `war disablement pension`, `employment and support allowance`))
#ASSERT NOT (`reg 41(2)(a) — the claimant is entitled to one of the benefits listed` EMPTY)

-- Regulation 41(2)(b): reviewing a previous determination of either kind.
#ASSERT `reg 41(2)(b) — the assessment is for reviewing a previous determination of the kind listed` (`test — review` TRUE FALSE)
#ASSERT `reg 41(2)(b) — the assessment is for reviewing a previous determination of the kind listed` (`test — review` FALSE TRUE)
#ASSERT NOT (`reg 41(2)(b) — the assessment is for reviewing a previous determination of the kind listed` (`test — review` FALSE FALSE))

-- Regulation 41(2): the earnings bar. At the threshold the bar applies ("equal to or exceed").
#ASSERT `reg 41(2) — the claimant's earnings bar an assessment` 832 12 EMPTY (`test — review` FALSE FALSE)
#ASSERT `reg 41(2) — the claimant's earnings bar an assessment` 900 12 EMPTY (`test — review` FALSE FALSE)
#ASSERT NOT (`reg 41(2) — the claimant's earnings bar an assessment` 831.99 12 EMPTY (`test — review` FALSE FALSE))
#ASSERT NOT (`reg 41(2) — the claimant's earnings bar an assessment` 0 12 EMPTY (`test — review` FALSE FALSE))
-- The bar is lifted by one of the benefits, or by a review of the listed kind.
#ASSERT NOT (`reg 41(2) — the claimant's earnings bar an assessment` 900 12 (LIST `personal independence payment`) (`test — review` FALSE FALSE))
#ASSERT NOT (`reg 41(2) — the claimant's earnings bar an assessment` 900 12 EMPTY (`test — review` TRUE FALSE))
#ASSERT NOT (`reg 41(2) — the claimant's earnings bar an assessment` 900 12 EMPTY (`test — review` FALSE TRUE))
-- A benefit not on the list does not lift it.
#ASSERT `reg 41(2) — the claimant's earnings bar an assessment` 900 12 (LIST `carer's allowance`) (`test — review` FALSE FALSE)

-- The last limb of regulation 41(2): not having limited capability for work, unless treated as having it.
#ASSERT `reg 41(2) — the claimant is treated as not having limited capability for work` TRUE TRUE FALSE FALSE
#ASSERT NOT (`reg 41(2) — the claimant is treated as not having limited capability for work` TRUE TRUE TRUE FALSE)
#ASSERT NOT (`reg 41(2) — the claimant is treated as not having limited capability for work` TRUE TRUE FALSE TRUE)
-- Only where the assessment was for limited capability for work and work-related activity, and only where the bar applies.
#ASSERT NOT (`reg 41(2) — the claimant is treated as not having limited capability for work` FALSE TRUE FALSE FALSE)
#ASSERT NOT (`reg 41(2) — the claimant is treated as not having limited capability for work` TRUE FALSE FALSE FALSE)

-- Regulation 41(6): relevant evidence is evidence of a mistake or ignorance, or of a relevant change.
#ASSERT `reg 41(6) — relevant evidence` TRUE NOTHING
#ASSERT `reg 41(6) — relevant evidence` FALSE (JUST (`test — change` TRUE FALSE))
-- Evidence only of the claimant doing work is not relevant evidence (regulation 41(1A)).
#ASSERT NOT (`reg 41(6) — relevant evidence` FALSE (JUST (`test — change` TRUE TRUE)))
#ASSERT NOT (`reg 41(6) — relevant evidence` FALSE (JUST (`test — change` FALSE TRUE)))
#ASSERT NOT (`reg 41(6) — relevant evidence` FALSE NOTHING)
-- Evidence of a mistake is enough even if the evidence of a change is not.
#ASSERT `reg 41(6) — relevant evidence` TRUE (JUST (`test — change` FALSE TRUE))

-- Regulation 41(4): after a determination of no limited capability for work, or of severe conditions criteria claimant status, no further assessment without relevant evidence.
#ASSERT `reg 41(4) — no further assessment may be carried out` (`test — previous` TRUE FALSE FALSE FALSE) FALSE
#ASSERT `reg 41(4) — no further assessment may be carried out` (`test — previous` FALSE TRUE FALSE FALSE) FALSE
#ASSERT NOT (`reg 41(4) — no further assessment may be carried out` (`test — previous` TRUE FALSE FALSE FALSE) TRUE)
#ASSERT NOT (`reg 41(4) — no further assessment may be carried out` (`test — previous` FALSE FALSE FALSE FALSE) FALSE)
-- Limited capability for work and not a severe conditions criteria claimant is not within paragraph (4).
#ASSERT NOT (`reg 41(4) — no further assessment may be carried out` (`test — previous` FALSE FALSE TRUE TRUE) FALSE)

-- Regulation 41(5): limited capability for work and not a severe conditions criteria claimant: no review of the second without relevant evidence.
#ASSERT `reg 41(5) — no further assessment for reviewing a determination that the claimant is not a severe conditions criteria claimant may be carried out` (`test — previous` FALSE FALSE TRUE TRUE) TRUE FALSE
#ASSERT NOT (`reg 41(5) — no further assessment for reviewing a determination that the claimant is not a severe conditions criteria claimant may be carried out` (`test — previous` FALSE FALSE TRUE TRUE) TRUE TRUE)
-- An assessment for another purpose is not barred by paragraph (5).
#ASSERT NOT (`reg 41(5) — no further assessment for reviewing a determination that the claimant is not a severe conditions criteria claimant may be carried out` (`test — previous` FALSE FALSE TRUE TRUE) FALSE FALSE)
#ASSERT NOT (`reg 41(5) — no further assessment for reviewing a determination that the claimant is not a severe conditions criteria claimant may be carried out` (`test — previous` FALSE FALSE TRUE FALSE) TRUE FALSE)
#ASSERT NOT (`reg 41(5) — no further assessment for reviewing a determination that the claimant is not a severe conditions criteria claimant may be carried out` (`test — previous` FALSE FALSE FALSE TRUE) TRUE FALSE)

-- Regulation 41 as a whole.
#ASSERT `reg 41 — the Secretary of State may carry out an assessment` TRUE FALSE FALSE FALSE
#ASSERT NOT (`reg 41 — the Secretary of State may carry out an assessment` FALSE FALSE FALSE FALSE)
#ASSERT NOT (`reg 41 — the Secretary of State may carry out an assessment` TRUE TRUE FALSE FALSE)
#ASSERT NOT (`reg 41 — the Secretary of State may carry out an assessment` TRUE FALSE TRUE FALSE)
#ASSERT NOT (`reg 41 — the Secretary of State may carry out an assessment` TRUE FALSE FALSE TRUE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 42(2): a prosthesis normally fitted or worn; an aid or appliance normally worn or used, or that could reasonably be expected to be.
#ASSERT `reg 42(2) — the claimant is assessed as if fitted with, wearing or using it` (`Prosthesis, aid or appliance` WITH `a prosthesis with which the claimant is normally fitted or which the claimant normally wears` IS TRUE, `an aid or appliance which is normally worn or used` IS FALSE, `an aid or appliance which could reasonably be expected to be worn or used` IS FALSE)
#ASSERT `reg 42(2) — the claimant is assessed as if fitted with, wearing or using it` (`Prosthesis, aid or appliance` WITH `a prosthesis with which the claimant is normally fitted or which the claimant normally wears` IS FALSE, `an aid or appliance which is normally worn or used` IS TRUE, `an aid or appliance which could reasonably be expected to be worn or used` IS FALSE)
#ASSERT `reg 42(2) — the claimant is assessed as if fitted with, wearing or using it` (`Prosthesis, aid or appliance` WITH `a prosthesis with which the claimant is normally fitted or which the claimant normally wears` IS FALSE, `an aid or appliance which is normally worn or used` IS FALSE, `an aid or appliance which could reasonably be expected to be worn or used` IS TRUE)
#ASSERT NOT (`reg 42(2) — the claimant is assessed as if fitted with, wearing or using it` (`Prosthesis, aid or appliance` WITH `a prosthesis with which the claimant is normally fitted or which the claimant normally wears` IS FALSE, `an aid or appliance which is normally worn or used` IS FALSE, `an aid or appliance which could reasonably be expected to be worn or used` IS FALSE))

-- Regulation 42(3): a descriptor that applies as a direct result of treatment is treated as applying by reason of the disease.
#ASSERT `reg 42(3) — the descriptor is treated as applying by reason of the disease, illness or disablement` TRUE
#ASSERT NOT (`reg 42(3) — the descriptor is treated as applying by reason of the disease, illness or disablement` FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 43(1) and (2): the questionnaire information is required unless the Secretary of State is satisfied there is enough without it.
#ASSERT `reg 43(1)(a) and (2) — the questionnaire information is required` TRUE FALSE
#ASSERT NOT (`reg 43(1)(a) and (2) — the questionnaire information is required` TRUE TRUE)
#ASSERT NOT (`reg 43(1)(a) and (2) — the questionnaire information is required` FALSE FALSE)
#ASSERT `reg 43(1)(b) — the additional information is required` TRUE
#ASSERT NOT (`reg 43(1)(b) — the additional information is required` FALSE)

-- Regulation 43(4): a further request at least 3 weeks after the first (21 days), at least a week (7 days) before the date asked about.
-- First request on 1 March 2026; further request on 22 March 2026 (21 days later); as at 29 March 2026 (7 days after the further request).
#ASSERT `reg 43(4) — the further request has been sent in time` (`test — requests` (YMD 2026 3 1) (JUST (YMD 2026 3 22))) (YMD 2026 3 29)
-- A day short on the first limb: further request on 21 March (20 days after the first).
#ASSERT NOT (`reg 43(4) — the further request has been sent in time` (`test — requests` (YMD 2026 3 1) (JUST (YMD 2026 3 21))) (YMD 2026 4 30))
-- A day short on the second limb: as at 28 March (6 days after a further request on 22 March).
#ASSERT NOT (`reg 43(4) — the further request has been sent in time` (`test — requests` (YMD 2026 3 1) (JUST (YMD 2026 3 22))) (YMD 2026 3 28))
-- Long after both.
#ASSERT `reg 43(4) — the further request has been sent in time` (`test — requests` (YMD 2026 3 1) (JUST (YMD 2026 4 1))) (YMD 2026 6 1)
-- No further request: not in time, whatever the date.
#ASSERT NOT (`reg 43(4) — the further request has been sent in time` (`test — requests` (YMD 2026 3 1) NOTHING) (YMD 2027 3 1))

-- Regulation 43(3): the consequence, with all four conditions met, and the not-covered value (NOTHING) otherwise.
#ASSERT `reg 43(3) — the determination that the claimant is treated as not satisfying` `whether the claimant has limited capability for work` TRUE FALSE (`test — requests` (YMD 2026 3 1) (JUST (YMD 2026 3 22))) (YMD 2026 3 29) EQUALS JUST `whether the claimant has limited capability for work`
#ASSERT `reg 43(3) — the determination that the claimant is treated as not satisfying` `whether the claimant has limited capability for work and work-related activity` TRUE FALSE (`test — requests` (YMD 2026 3 1) (JUST (YMD 2026 3 22))) (YMD 2026 3 29) EQUALS JUST `whether the claimant has limited capability for work and work-related activity`
#ASSERT `reg 43(3) — the determination that the claimant is treated as not satisfying` `whether the claimant is a severe conditions criteria claimant` TRUE FALSE (`test — requests` (YMD 2026 3 1) (JUST (YMD 2026 3 22))) (YMD 2026 3 29) EQUALS JUST `whether the claimant is a severe conditions criteria claimant`
-- A good reason, no failure, or a premature further request each give NOTHING.
#ASSERT `reg 43(3) — the determination that the claimant is treated as not satisfying` `whether the claimant has limited capability for work` TRUE TRUE (`test — requests` (YMD 2026 3 1) (JUST (YMD 2026 3 22))) (YMD 2026 3 29) EQUALS NOTHING
#ASSERT `reg 43(3) — the determination that the claimant is treated as not satisfying` `whether the claimant has limited capability for work` FALSE FALSE (`test — requests` (YMD 2026 3 1) (JUST (YMD 2026 3 22))) (YMD 2026 3 29) EQUALS NOTHING
#ASSERT `reg 43(3) — the determination that the claimant is treated as not satisfying` `whether the claimant has limited capability for work` TRUE FALSE (`test — requests` (YMD 2026 3 1) (JUST (YMD 2026 3 22))) (YMD 2026 3 28) EQUALS NOTHING
#ASSERT `reg 43(3) — the determination that the claimant is treated as not satisfying` `whether the claimant has limited capability for work` TRUE FALSE (`test — requests` (YMD 2026 3 1) NOTHING) (YMD 2026 9 1) EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 44(1): a health care professional approved by the Secretary of State, where a determination falls to be made.
#ASSERT `reg 44(1) — the claimant may be called to attend a medical examination` `test — a doctor` TRUE TRUE
#ASSERT `reg 44(1) — the claimant may be called to attend a medical examination` `test — a registered physiotherapist` TRUE TRUE
-- Not approved; no determination to make; not a health care professional (a physiotherapist who is not registered with the regulatory body).
#ASSERT NOT (`reg 44(1) — the claimant may be called to attend a medical examination` `test — a doctor` FALSE TRUE)
#ASSERT NOT (`reg 44(1) — the claimant may be called to attend a medical examination` `test — a doctor` TRUE FALSE)
#ASSERT NOT (`reg 44(1) — the claimant may be called to attend a medical examination` `test — a physiotherapist who is not registered` TRUE TRUE)

-- Regulation 44(3): notice of date, time and place at least 7 days in advance, or less and agreed.
-- Notice on 1 March for an examination on 8 March: exactly 7 days.
#ASSERT `reg 44(3) — the notice was in time` (`test — notice` (YMD 2026 3 1) (YMD 2026 3 8) TRUE FALSE)
-- Notice on 2 March for 8 March: 6 days, not agreed.
#ASSERT NOT (`reg 44(3) — the notice was in time` (`test — notice` (YMD 2026 3 2) (YMD 2026 3 8) TRUE FALSE))
-- The same, agreed.
#ASSERT `reg 44(3) — the notice was in time` (`test — notice` (YMD 2026 3 2) (YMD 2026 3 8) TRUE TRUE)
-- Without the date, time and place the notice is not in time either way.
#ASSERT NOT (`reg 44(3) — the notice was in time` (`test — notice` (YMD 2026 3 1) (YMD 2026 3 20) FALSE FALSE))
#ASSERT NOT (`reg 44(3) — the notice was in time` (`test — notice` (YMD 2026 3 7) (YMD 2026 3 8) FALSE TRUE))
-- An agreement to accept short notice adds nothing when the notice was long.
#ASSERT `reg 44(3) — the notice was in time` (`test — notice` (YMD 2026 3 1) (YMD 2026 3 20) TRUE FALSE)

-- Regulation 44(2): the consequence.
#ASSERT `reg 44(2) — the determination that the claimant is treated as not satisfying` `whether the claimant has limited capability for work` TRUE TRUE FALSE (`test — notice` (YMD 2026 3 1) (YMD 2026 3 8) TRUE FALSE) EQUALS JUST `whether the claimant has limited capability for work`
#ASSERT `reg 44(2) — the determination that the claimant is treated as not satisfying` `whether the claimant is a severe conditions criteria claimant` TRUE TRUE FALSE (`test — notice` (YMD 2026 3 2) (YMD 2026 3 8) TRUE TRUE) EQUALS JUST `whether the claimant is a severe conditions criteria claimant`
#ASSERT `reg 44(2) — the determination that the claimant is treated as not satisfying` `whether the claimant has limited capability for work` TRUE TRUE FALSE (`test — notice` (YMD 2026 3 2) (YMD 2026 3 8) TRUE FALSE) EQUALS NOTHING
#ASSERT `reg 44(2) — the determination that the claimant is treated as not satisfying` `whether the claimant has limited capability for work` TRUE TRUE TRUE (`test — notice` (YMD 2026 3 1) (YMD 2026 3 8) TRUE FALSE) EQUALS NOTHING
#ASSERT `reg 44(2) — the determination that the claimant is treated as not satisfying` `whether the claimant has limited capability for work` TRUE FALSE FALSE (`test — notice` (YMD 2026 3 1) (YMD 2026 3 8) TRUE FALSE) EQUALS NOTHING
#ASSERT `reg 44(2) — the determination that the claimant is treated as not satisfying` `whether the claimant has limited capability for work` FALSE TRUE FALSE (`test — notice` (YMD 2026 3 1) (YMD 2026 3 8) TRUE FALSE) EQUALS NOTHING
