IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-bodies`
IMPORT `uc3-sch1-interpretation`
IMPORT `uc3-sch4-interpretation`
IMPORT `uc3-sch4-bedrooms`
IMPORT `uc3-sch1-payments`

-- The Universal Credit Regulations 2013 (S.I. 2013/376), Schedule 1 paragraphs 2 to 8: tests of layer 1.
-- Source: ../../registers/source-bundle/uksi-2013-376.txt (plain-text rendering, not the official text).
--
-- EVERY EXPECTED VALUE IS WRITTEN HERE FROM THE TEXT, beside the assertion, before the file was run: none was copied from what the encoding printed.
-- Helpers are named "uc3 test" because every name sits in one folder after the merge.

-- ---------------------------------------------------------------------------------------------------------
-- Helpers.

-- Accommodation of a kind: 0 ordinary; 1 a tent; 2 approved premises; 3 a care home (in England); 4 exempt accommodation.
GIVEN kind IS A NUMBER
GIVETH A `Accommodation in the Schedule 1 tests`
`uc3 test — accommodation of a kind` kind MEANS
    `Accommodation in the Schedule 1 tests` WITH
        structure IS `Structure that may be a tent` WITH
            `moveable structure` IS kind EQUALS 1
            `designed or adapted (solely or mainly) for the purpose of sleeping in a place for any period` IS kind EQUALS 1
            `caravan` IS FALSE
            `mobile home` IS FALSE
            `houseboat` IS FALSE
        `approved premises` IS kind EQUALS 2
        `care home premises` IS `Premises that may be a care home` WITH
            `nation of Great Britain in which the premises are` IS England
            `a care home within the meaning of section 3 of the Care Standards Act 2000` IS kind EQUALS 3
            `a place at which a care home service within the meaning of Part 1 of the Regulation and Inspection of Social Care (Wales) Act 2016 is provided wholly or mainly to persons aged 18 or over` IS FALSE
            `a care home service within the meaning of paragraph 2 of Schedule 12 to the Public Services Reform (Scotland) Act 2010` IS FALSE
            `the premises as a hospital that may be an independent hospital` IS `Hospital that may be an independent hospital` WITH
                `a hospital as defined by section 275 of the National Health Service Act 2006` IS FALSE
                `a health service hospital as defined by section 275 of the National Health Service Act 2006` IS FALSE
                `an independent hospital as the meaning is assigned to it by section 2 of the Care Standards Act 2000` IS FALSE
                `an independent health care service as defined in section 10F(1)(a) and (b) of the National Health Service (Scotland) Act 1978` IS FALSE
        `exempt accommodation` IS kind EQUALS 4

-- A charity: registered in England (the Charities Act 2011 register) or not.
GIVEN registered IS A BOOLEAN
GIVETH A `Charity that may be a registered charity`
`uc3 test — a charity` registered MEANS
    `Charity that may be a registered charity` WITH
        `entered in the register of charities maintained under Part 4 of the Charities Act 2011` IS registered
        `entered on the register of charities maintained under the Charities and Trustee Investment (Scotland) Act 2005` IS FALSE

-- A voluntary organisation: a body that is not a public authority and not for profit (TRUE), or one that is neither (FALSE).
GIVEN voluntary IS A BOOLEAN
GIVETH A `Body that may be a voluntary organisation`
`uc3 test — a voluntary body` voluntary MEANS
    `Body that may be a voluntary organisation` WITH
        `public authority` IS FALSE
        `the body as a possible local authority` IS `Body that may be a local authority` WITH
            `nation of Great Britain in relation to which it is asked` IS England
            `kind of body` IS `another kind of body`
        `activities are carried on otherwise than for profit` IS voluntary

-- A provider of accommodation: 0 none of the kinds; 1 a London borough council (a local authority); 2 a county council in a two-tier area of England;
-- 3 a housing association; 4 a registered charity; 5 a voluntary organisation.
GIVEN kind IS A NUMBER
GIVETH A `Provider of accommodation that may be a relevant body`
`uc3 test — a provider of accommodation` kind MEANS
    `Provider of accommodation that may be a relevant body` WITH
        `the provider as a possible local authority` IS `Body that may be a local authority` WITH
            `nation of Great Britain in relation to which it is asked` IS England
            `kind of body` IS IF kind EQUALS 1 THEN `a London borough council` ELSE `another kind of body`
        `council for a county in England for each part of which there is a district council` IS kind EQUALS 2
        `housing association` IS kind EQUALS 3
        `the provider as a possible registered charity` IS `uc3 test — a charity` (kind EQUALS 4)
        `the provider as a possible voluntary organisation` IS `uc3 test — a voluntary body` (kind EQUALS 5)

-- A building with domestic accommodation and board, run commercially and managed by no voluntary body, whose owner is: 0 no provider of social housing, 1 a non-profit registered provider
-- (which makes it a hostel under Schedule 4 paragraph 29(10)(b)(i)), 2 a local authority (a provider of social housing that limb (i) excludes); careHome says whether it is a care home.
GIVEN owner IS A NUMBER
      careHome IS A BOOLEAN
GIVETH A `Building that may be a hostel`
`uc3 test — a building with a given owner` owner careHome MEANS
    `Building that may be a hostel` WITH
        `domestic accommodation is provided for persons generally or for a class of persons otherwise than in separate and self-contained premises` IS TRUE
        `board is provided` IS TRUE
        `facilities for the preparation of food adequate to the needs of those persons are provided` IS FALSE
        `the owner or manager as a possible provider of social housing` IS `Landlord that may be a provider of social housing` WITH
            `the landlord as a possible local authority` IS `Body that may be a local authority` WITH
                `nation of Great Britain in relation to which it is asked` IS England
                `kind of body` IS IF owner EQUALS 2 THEN `a London borough council` ELSE `another kind of body`
            `non-profit registered provider of social housing` IS owner EQUALS 1
            `profit-making registered provider of social housing` IS FALSE
            `the accommodation is social housing` IS FALSE
            `the landlord as a possible registered social landlord` IS `Landlord that may be a registered social landlord` WITH
                `registered in the register maintained by the Welsh Ministers under Chapter 1 of Part 1 of the Housing Act 1996` IS FALSE
                `registered in the register maintained by the Scottish Housing Regulator under section 20(1) of the Housing (Scotland) Act 2010` IS FALSE
        `the building is operated other than on a commercial basis` IS FALSE
        `funds are provided wholly or in part by a government department or agency or a local authority` IS FALSE
        `the manager as a possible voluntary organisation` IS `uc3 test — a voluntary body` FALSE
        `the manager as a possible registered charity` IS `uc3 test — a charity` FALSE
        `the building provides care, support or supervision with a view to assisting those persons to be rehabilitated or resettled within the community` IS FALSE
        `the building as possible care home premises` IS `Premises that may be a care home` WITH
            `nation of Great Britain in which the premises are` IS England
            `a care home within the meaning of section 3 of the Care Standards Act 2000` IS careHome
            `a place at which a care home service within the meaning of Part 1 of the Regulation and Inspection of Social Care (Wales) Act 2016 is provided wholly or mainly to persons aged 18 or over` IS FALSE
            `a care home service within the meaning of paragraph 2 of Schedule 12 to the Public Services Reform (Scotland) Act 2010` IS FALSE
            `the premises as a hospital that may be an independent hospital` IS `Hospital that may be an independent hospital` WITH
                `a hospital as defined by section 275 of the National Health Service Act 2006` IS FALSE
                `a health service hospital as defined by section 275 of the National Health Service Act 2006` IS FALSE
                `an independent hospital as the meaning is assigned to it by section 2 of the Care Standards Act 2000` IS FALSE
                `an independent health care service as defined in section 10F(1)(a) and (b) of the National Health Service (Scotland) Act 1978` IS FALSE

-- The accommodation of paragraph 3A. code: 0 nothing special; 1 exempt accommodation; 2 provided by a relevant body (a housing association) to a claimant admitted for care and receiving it;
-- 3 provided by a local authority to a claimant who has left home as a result of domestic violence, in a building used wholly or mainly for the purpose;
-- 4 a building that is a hostel except for being owned by a local authority, and the claimant receives care; 5 as 4 but the claimant receives no care;
-- 6 as 2 but the claimant is not admitted for care; 7 as 2 but the claimant receives no care; 8 as 3 but the building is not used for the purpose; 9 as 3 but the provider is not a local authority or relevant body;
-- 10 as 3 but the claimant did not leave home as a result of domestic violence; 11 as 4 but the building is also a care home; 12 as 4 but the owner is a non-profit provider of social housing, which makes it a hostel.
GIVEN code IS A NUMBER
GIVETH A `Accommodation that may be specified in paragraph 3A`
`uc3 test — accommodation for paragraph 3A` code MEANS
    `Accommodation that may be specified in paragraph 3A` WITH
        `the accommodation as it is looked at in the Schedule 1 tests` IS `uc3 test — accommodation of a kind` (IF code EQUALS 1 THEN 4 ELSE 0)
        `the provider` IS `uc3 test — a provider of accommodation` (IF (code EQUALS 3) OR (code EQUALS 8) OR (code EQUALS 10) THEN 1 ELSE IF (code EQUALS 9) THEN 0 ELSE 3)
        `the claimant has been admitted into the accommodation in order to meet a need for care, support or supervision` IS (code EQUALS 2) OR (code EQUALS 7)
        `the claimant receives care, support or supervision` IS (code EQUALS 2) OR (code EQUALS 4) OR (code EQUALS 6) OR (code EQUALS 11) OR (code EQUALS 12)
        `the accommodation is provided to the claimant because the claimant has left the home as a result of domestic violence` IS (code EQUALS 3) OR (code EQUALS 8) OR (code EQUALS 9)
        `the accommodation consists of a building, or part of a building, which is used wholly or mainly for the non-permanent accommodation of persons who have left their homes as a result of domestic violence` IS (code EQUALS 3) OR (code EQUALS 9) OR (code EQUALS 10)
        `the accommodation as a building that may be a hostel` IS `uc3 test — a building with a given owner` (IF code EQUALS 12 THEN 1 ELSE IF (code EQUALS 4) OR (code EQUALS 5) OR (code EQUALS 11) THEN 2 ELSE 0) (code EQUALS 11)

-- The accommodation of paragraph 3B. landlord: 0 another body, 1 a London borough council, 2 a non-profit registered provider of social housing;
-- discharge: made available to discharge the local authority's housing functions; prevent: made available to prevent homelessness; exempt: exempt accommodation;
-- alsoServiceCharge: the renter is also liable to make service charge payments (3B(4): irrelevant).
GIVEN landlord IS A NUMBER
      discharge IS A BOOLEAN
      prevent IS A BOOLEAN
      exempt IS A BOOLEAN
      alsoServiceCharge IS A BOOLEAN
GIVETH A `Accommodation that may be temporary accommodation`
`uc3 test — accommodation for paragraph 3B` landlord discharge prevent exempt alsoServiceCharge MEANS
    `Accommodation that may be temporary accommodation` WITH
        `the landlord that rent payments are payable to` IS `Landlord that may be a provider of social housing` WITH
            `the landlord as a possible local authority` IS `Body that may be a local authority` WITH
                `nation of Great Britain in relation to which it is asked` IS England
                `kind of body` IS IF landlord EQUALS 1 THEN `a London borough council` ELSE `another kind of body`
            `non-profit registered provider of social housing` IS landlord EQUALS 2
            `profit-making registered provider of social housing` IS FALSE
            `the accommodation is social housing` IS FALSE
            `the landlord as a possible registered social landlord` IS `Landlord that may be a registered social landlord` WITH
                `registered in the register maintained by the Welsh Ministers under Chapter 1 of Part 1 of the Housing Act 1996` IS FALSE
                `registered in the register maintained by the Scottish Housing Regulator under section 20(1) of the Housing (Scotland) Act 2010` IS FALSE
        `the accommodation is exempt accommodation` IS exempt
        `the accommodation is made available to the renter to discharge any of the local authority's functions under Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014` IS discharge
        `the accommodation is made available to the renter to prevent the person being or becoming homeless within the meaning of Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014` IS prevent
        `the renter is also liable to make service charge payments` IS alsoServiceCharge

-- The facts paragraph 8 looks at. part5: the calculation is under Part 5 of Schedule 4 or Schedule 5; first: making the payments is a condition of the right to occupy;
-- cat: 0 none of the categories; 1 external window cleaning, upper floors; 2 external window cleaning, not upper floors; 3 other maintenance or repair, separately identifiable,
-- payable by a shared owner; 4 the same, payable by a claimant whose housing costs element would be calculated under Schedule 5; 5 other maintenance or repair, not separately identifiable;
-- 6 Category B (communal areas); 7 Category C (basic communal services); 8 Category D (accommodation-specific charges);
-- 9 other maintenance or repair, separately identifiable, payable by neither of the two kinds of claimant;
-- amount: the costs and charges are of a reasonable amount; description: they relate to services of a reasonable description;
-- excl: 0 none of the fourth condition's exclusions; 1 public funds; 2 transfer of an asset; 3 food, medical or personal services.
GIVEN part5 IS A BOOLEAN
      first IS A BOOLEAN
      cat IS A NUMBER
      amount IS A BOOLEAN
      description IS A BOOLEAN
      excl IS A NUMBER
GIVETH A `Service charge payment, as paragraph 8 looks at it`
`uc3 test — facts for paragraph 8` part5 first cat amount description excl MEANS
    `Service charge payment, as paragraph 8 looks at it` WITH
        `the calculation is made under Part 5 of Schedule 4 or under Schedule 5` IS part5
        `making the payments is a condition on which the right to occupy the accommodation depends` IS first
        `external cleaning of windows` IS (cat EQUALS 1) OR (cat EQUALS 2)
        `the windows are in upper floors of a multi-storey building` IS cat EQUALS 1
        `other internal or external maintenance or repair of the accommodation` IS (cat EQUALS 3) OR (cat EQUALS 4) OR (cat EQUALS 5) OR (cat EQUALS 9)
        `the payments are separately identifiable as relating to such maintenance or repair` IS (cat EQUALS 3) OR (cat EQUALS 4) OR (cat EQUALS 9)
        `the payments are payable by a claimant who occupies accommodation under a shared ownership tenancy` IS cat EQUALS 3
        `any amount of housing costs element in respect of those payments would fall to be calculated under Schedule 5` IS cat EQUALS 4
        `ongoing maintenance or cleaning of, and the supply of water, fuel or any other commodity relating to the common use of, internal or external areas, including areas for reasonable facilities` IS cat EQUALS 6
        `provision, ongoing maintenance, cleaning or repair in connection with basic services generally available to all persons living in the accommodation` IS cat EQUALS 7
        `payments specific to the particular accommodation occupied by the claimant for the use of essential items contained in it` IS cat EQUALS 8
        `the costs and charges to which the payments relate are of a reasonable amount` IS amount
        `the costs and charges relate to services or facilities of such description as it is reasonable to provide` IS description
        `the payments relate to the costs of or charges for providing services or facilities in respect of which payments out of public funds might otherwise be made` IS excl EQUALS 1
        `the payments are in connection with the use of an asset and result in the transfer of the asset or any interest in it` IS excl EQUALS 2
        `the payments relate to the costs of or charges for providing food, medical services or personal services (including personal care) of any description` IS excl EQUALS 3

-- A payment that may be a service charge payment. forServices: falls within 7(2)(a); attributable: falls within 7(2)(b); loan: a qualifying loan was taken out (7(3)(a));
-- kind: the kind of accommodation of the occupant (7(3)(b)); the three irrelevant facts of 7(4) are given by irrelevant (TRUE sets all three, FALSE none).
GIVEN forServices IS A BOOLEAN
      attributable IS A BOOLEAN
      loan IS A BOOLEAN
      kind IS A NUMBER
      irrelevant IS A BOOLEAN
      facts IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A `Payment that may be a service charge payment`
`uc3 test — a payment that may be a service charge payment` forServices attributable loan kind irrelevant facts MEANS
    `Payment that may be a service charge payment` WITH
        `the payment is, in whole or in part, a payment of, or towards, the costs of or charges for providing services or facilities for the use or benefit of persons occupying accommodation` IS forServices
        `the payment is, in whole or in part, fairly attributable to the costs of or charges for providing such services or facilities connected with accommodation as are available for the use or benefit of persons occupying accommodation` IS attributable
        `a qualifying loan within the meaning of regulation 2 of the Loans for Mortgage Interest Regulations 2017 was taken out for the purposes of making the payments` IS loan
        `the accommodation occupied by the person for whose use or benefit the services or facilities are provided` IS `uc3 test — accommodation of a kind` kind
        `the payments are separately identified as relating to the costs or charges referred to in sub-paragraph (2)` IS irrelevant
        `the payments are made in addition to or as part of any other payment` IS irrelevant
        `the payments are made under the same agreement as that under which the accommodation is occupied` IS irrelevant
        `facts for paragraph 8` IS facts

-- A service charge payment in the ordinary case: a payment for services, nothing excluded, in ordinary accommodation, and paragraph 8 not applying (the calculation is under Part 4),
-- or applying with every condition met (first condition met, Category B, reasonable amount and description, no exclusion).
GIVETH A `Payment that may be a service charge payment`
`uc3 test — an ordinary service charge payment under Part 4` MEANS
    `uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)

GIVETH A `Payment that may be a service charge payment`
`uc3 test — an ordinary service charge payment under Part 5` MEANS
    `uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` TRUE TRUE 6 TRUE TRUE 0)

-- A payment in respect of accommodation. description: 0 none of the five descriptions; 1 payment of rent; 2 a licence payment; 3 a mooring charge; 4 a caravan or mobile home site payment;
-- 5 an almshouse contribution by a resident to a housing association that is a registered charity; 6 an almshouse contribution to an exempt charity;
-- 7 an almshouse contribution to a housing association that is neither; kind: the accommodation kind (see above); the booleans are ground rent, tent site, owner-occupier payment.
GIVEN description IS A NUMBER
      kind IS A NUMBER
      groundRent IS A BOOLEAN
      tentSite IS A BOOLEAN
      ownerOccupier IS A BOOLEAN
      scp IS A `Payment that may be a service charge payment`
      specified IS A `Accommodation that may be specified in paragraph 3A`
      temporary IS A `Accommodation that may be temporary accommodation`
GIVETH A `Payment in respect of accommodation`
`uc3 test — a payment in respect of accommodation` description kind groundRent tentSite ownerOccupier scp specified temporary MEANS
    `Payment in respect of accommodation` WITH
        description IS `Description of a payment for accommodation` WITH
            `payment of rent` IS description EQUALS 1
            `payment for a licence or other permission to occupy accommodation` IS description EQUALS 2
            `mooring charge payable for a houseboat` IS description EQUALS 3
            `accommodation is a caravan or mobile home and the payment is in respect of the site on which the accommodation stands` IS description EQUALS 4
            `contribution towards almshouses` IS `Almshouse contribution` WITH
                `contribution by a resident towards maintaining almshouses (and essential services in them)` IS (description EQUALS 5) OR (description EQUALS 6) OR (description EQUALS 7)
                `the almshouses are provided by a housing association` IS (description EQUALS 5) OR (description EQUALS 6) OR (description EQUALS 7)
                `the housing association as a possible registered charity` IS `uc3 test — a charity` (description EQUALS 5)
                `the housing association is an exempt charity within Schedule 3 to the Charities Act 2011` IS description EQUALS 6
        `the accommodation` IS `uc3 test — accommodation of a kind` kind
        `ground rent` IS groundRent
        `the payment is in respect of the site on which a tent stands` IS tentSite
        `owner-occupier payment within the meaning of Schedule 1 of the Loans for Mortgage Regulations 2017` IS ownerOccupier
        `the payment as a possible service charge payment` IS scp
        `the accommodation as it may be specified in paragraph 3A` IS specified
        `the accommodation as it may be temporary accommodation` IS temporary

-- A plain rent payment in ordinary accommodation, with every exclusion absent: the base case that the tests below change one thing in.
GIVEN description IS A NUMBER
GIVETH A `Payment in respect of accommodation`
`uc3 test — a plain payment in respect of accommodation` description MEANS
    `uc3 test — a payment in respect of accommodation` description 0 FALSE FALSE FALSE
        (`uc3 test — a payment that may be a service charge payment` FALSE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0))
        (`uc3 test — accommodation for paragraph 3A` 0)
        (`uc3 test — accommodation for paragraph 3B` 0 FALSE FALSE FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Paragraph 2(e): a contribution by residents towards maintaining almshouses provided by a housing association that is a registered charity or an exempt charity within Schedule 3 to the Charities Act 2011.
-- Expected: to a registered charity TRUE; to an exempt charity TRUE; to a housing association that is neither FALSE.
GIVEN payment IS A `Payment in respect of accommodation`
GIVETH A `Almshouse contribution`
`uc3 test — the almshouse contribution of a payment` payment MEANS
    (payment's description)'s `contribution towards almshouses`

#ASSERT `Sch 1 para 2(e) — a contribution towards almshouses` (`uc3 test — the almshouse contribution of a payment` (`uc3 test — a plain payment in respect of accommodation` 5)) EQUALS TRUE
#ASSERT `Sch 1 para 2(e) — a contribution towards almshouses` (`uc3 test — the almshouse contribution of a payment` (`uc3 test — a plain payment in respect of accommodation` 6)) EQUALS TRUE
#ASSERT `Sch 1 para 2(e) — a contribution towards almshouses` (`uc3 test — the almshouse contribution of a payment` (`uc3 test — a plain payment in respect of accommodation` 7)) EQUALS FALSE

-- Paragraph 2(a) to (e): the five descriptions. Expected: each alone gives TRUE; none gives FALSE.
GIVEN payment IS A `Payment in respect of accommodation`
GIVETH A `Description of a payment for accommodation`
`uc3 test — the description of a payment` payment MEANS payment's description
#ASSERT `Sch 1 para 2 — a payment of a description in paragraph 2(a) to (e)` (`uc3 test — the description of a payment` (`uc3 test — a plain payment in respect of accommodation` 1)) EQUALS TRUE
#ASSERT `Sch 1 para 2 — a payment of a description in paragraph 2(a) to (e)` (`uc3 test — the description of a payment` (`uc3 test — a plain payment in respect of accommodation` 2)) EQUALS TRUE
#ASSERT `Sch 1 para 2 — a payment of a description in paragraph 2(a) to (e)` (`uc3 test — the description of a payment` (`uc3 test — a plain payment in respect of accommodation` 3)) EQUALS TRUE
#ASSERT `Sch 1 para 2 — a payment of a description in paragraph 2(a) to (e)` (`uc3 test — the description of a payment` (`uc3 test — a plain payment in respect of accommodation` 4)) EQUALS TRUE
#ASSERT `Sch 1 para 2 — a payment of a description in paragraph 2(a) to (e)` (`uc3 test — the description of a payment` (`uc3 test — a plain payment in respect of accommodation` 5)) EQUALS TRUE
#ASSERT `Sch 1 para 2 — a payment of a description in paragraph 2(a) to (e)` (`uc3 test — the description of a payment` (`uc3 test — a plain payment in respect of accommodation` 0)) EQUALS FALSE

-- Paragraph 3A(6), "relevant body": (a) a council for a county in England for each part of which there is a district council; (b) a housing association; (c) a registered charity; (d) a voluntary organisation.
-- Expected: each of the four gives TRUE; a London borough council (a local authority, but not a county council in a two-tier area) gives FALSE; none of them gives FALSE.
#ASSERT `Sch 1 para 3A(6) — relevant body` (`uc3 test — a provider of accommodation` 2) EQUALS TRUE
#ASSERT `Sch 1 para 3A(6) — relevant body` (`uc3 test — a provider of accommodation` 3) EQUALS TRUE
#ASSERT `Sch 1 para 3A(6) — relevant body` (`uc3 test — a provider of accommodation` 4) EQUALS TRUE
#ASSERT `Sch 1 para 3A(6) — relevant body` (`uc3 test — a provider of accommodation` 5) EQUALS TRUE
#ASSERT `Sch 1 para 3A(6) — relevant body` (`uc3 test — a provider of accommodation` 1) EQUALS FALSE
#ASSERT `Sch 1 para 3A(6) — relevant body` (`uc3 test — a provider of accommodation` 0) EQUALS FALSE

-- Paragraph 3A(2) exempt accommodation; 3A(3) a relevant body, a claimant admitted to meet a need for care, support or supervision, who receives it (all three);
-- 3A(4) provided by a local authority or a relevant body because the claimant left home as a result of domestic violence, in a building used wholly or mainly for the purpose;
-- 3A(5) a building that would be a hostel within Schedule 4 paragraph 29(10) but for being owned or managed by a local authority, where the claimant receives care, support or supervision.
-- Expected, one code at a time (see the helper): 1 gives 3A(2) TRUE; 2 gives 3A(3) TRUE; 6 (not admitted) and 7 (no care received) give 3A(3) FALSE;
-- 3 gives 3A(4) TRUE; 8 (building not so used), 9 (provider neither a local authority nor a relevant body) and 10 (did not leave as a result of domestic violence) give 3A(4) FALSE;
-- 4 gives 3A(5) TRUE; 5 (no care received), 11 (a care home) and 12 (owned by a non-profit provider, which makes it an ordinary hostel) give 3A(5) FALSE.
#ASSERT `Sch 1 para 3A(2) — exempt accommodation` (`uc3 test — accommodation for paragraph 3A` 1) EQUALS TRUE
#ASSERT `Sch 1 para 3A(2) — exempt accommodation` (`uc3 test — accommodation for paragraph 3A` 0) EQUALS FALSE
#ASSERT `Sch 1 para 3A(3) — accommodation provided by a relevant body for care, support or supervision` (`uc3 test — accommodation for paragraph 3A` 2) EQUALS TRUE
#ASSERT `Sch 1 para 3A(3) — accommodation provided by a relevant body for care, support or supervision` (`uc3 test — accommodation for paragraph 3A` 6) EQUALS FALSE
#ASSERT `Sch 1 para 3A(3) — accommodation provided by a relevant body for care, support or supervision` (`uc3 test — accommodation for paragraph 3A` 7) EQUALS FALSE
#ASSERT `Sch 1 para 3A(4) — accommodation for a person who has left home as a result of domestic violence` (`uc3 test — accommodation for paragraph 3A` 3) EQUALS TRUE
#ASSERT `Sch 1 para 3A(4) — accommodation for a person who has left home as a result of domestic violence` (`uc3 test — accommodation for paragraph 3A` 8) EQUALS FALSE
#ASSERT `Sch 1 para 3A(4) — accommodation for a person who has left home as a result of domestic violence` (`uc3 test — accommodation for paragraph 3A` 9) EQUALS FALSE
#ASSERT `Sch 1 para 3A(4) — accommodation for a person who has left home as a result of domestic violence` (`uc3 test — accommodation for paragraph 3A` 10) EQUALS FALSE
#ASSERT `Sch 1 para 3A(5) — a building that would be a hostel but for local authority ownership, where care is received` (`uc3 test — accommodation for paragraph 3A` 4) EQUALS TRUE
#ASSERT `Sch 1 para 3A(5) — a building that would be a hostel but for local authority ownership, where care is received` (`uc3 test — accommodation for paragraph 3A` 5) EQUALS FALSE
#ASSERT `Sch 1 para 3A(5) — a building that would be a hostel but for local authority ownership, where care is received` (`uc3 test — accommodation for paragraph 3A` 11) EQUALS FALSE
#ASSERT `Sch 1 para 3A(5) — a building that would be a hostel but for local authority ownership, where care is received` (`uc3 test — accommodation for paragraph 3A` 12) EQUALS FALSE
-- 3A(1): any one of (2) to (5). Expected: codes 1, 2, 3 and 4 give TRUE; code 0 and codes that meet none (5, 6, 7, 8, 9, 10, 11, 12) give FALSE.
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 1) EQUALS TRUE
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 2) EQUALS TRUE
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 3) EQUALS TRUE
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 4) EQUALS TRUE
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 0) EQUALS FALSE
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 5) EQUALS FALSE
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 6) EQUALS FALSE
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 7) EQUALS FALSE
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 8) EQUALS FALSE
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 9) EQUALS FALSE
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 10) EQUALS FALSE
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 11) EQUALS FALSE
#ASSERT `Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (`uc3 test — accommodation for paragraph 3A` 12) EQUALS FALSE

-- Paragraph 3B: Case 1 (rent payable to a local authority, which makes the accommodation available to discharge its housing functions or to prevent homelessness, not exempt accommodation);
-- Case 2 (rent payable to a provider of social housing other than a local authority, which makes it available under arrangements made with it by a local authority for either purpose, not exempt accommodation).
-- Expected: a local authority landlord and the discharge purpose gives Case 1 TRUE; the prevention purpose alone gives Case 1 TRUE; neither purpose gives FALSE; exempt accommodation gives FALSE;
-- a non-profit registered provider with the prevention purpose gives Case 2 TRUE and Case 1 FALSE; a local authority landlord gives Case 2 FALSE (a local authority is not "other than a local authority");
-- another body (not a provider of social housing) gives both FALSE; 3B(1) is either case; being also liable to service charge payments changes nothing (3B(4)).
#ASSERT `Sch 1 para 3B(2) — Case 1` (`uc3 test — accommodation for paragraph 3B` 1 TRUE FALSE FALSE FALSE) EQUALS TRUE
#ASSERT `Sch 1 para 3B(2) — Case 1` (`uc3 test — accommodation for paragraph 3B` 1 FALSE TRUE FALSE FALSE) EQUALS TRUE
#ASSERT `Sch 1 para 3B(2) — Case 1` (`uc3 test — accommodation for paragraph 3B` 1 FALSE FALSE FALSE FALSE) EQUALS FALSE
#ASSERT `Sch 1 para 3B(2) — Case 1` (`uc3 test — accommodation for paragraph 3B` 1 TRUE FALSE TRUE FALSE) EQUALS FALSE
#ASSERT `Sch 1 para 3B(3) — Case 2` (`uc3 test — accommodation for paragraph 3B` 2 FALSE TRUE FALSE FALSE) EQUALS TRUE
#ASSERT `Sch 1 para 3B(2) — Case 1` (`uc3 test — accommodation for paragraph 3B` 2 FALSE TRUE FALSE FALSE) EQUALS FALSE
#ASSERT `Sch 1 para 3B(3) — Case 2` (`uc3 test — accommodation for paragraph 3B` 1 TRUE FALSE FALSE FALSE) EQUALS FALSE
#ASSERT `Sch 1 para 3B(3) — Case 2` (`uc3 test — accommodation for paragraph 3B` 2 TRUE FALSE TRUE FALSE) EQUALS FALSE
#ASSERT `Sch 1 para 3B(1) — temporary accommodation` (`uc3 test — accommodation for paragraph 3B` 0 TRUE TRUE FALSE FALSE) EQUALS FALSE
#ASSERT `Sch 1 para 3B(1) — temporary accommodation` (`uc3 test — accommodation for paragraph 3B` 1 TRUE FALSE FALSE FALSE) EQUALS TRUE
#ASSERT `Sch 1 para 3B(1) — temporary accommodation` (`uc3 test — accommodation for paragraph 3B` 2 TRUE FALSE FALSE FALSE) EQUALS TRUE
#ASSERT `Sch 1 para 3B(1) — temporary accommodation` (`uc3 test — accommodation for paragraph 3B` 1 TRUE FALSE FALSE TRUE) EQUALS TRUE
#ASSERT `Sch 1 para 3B(1) — temporary accommodation` (`uc3 test — accommodation for paragraph 3B` 2 FALSE TRUE FALSE TRUE) EQUALS TRUE

-- ---------------------------------------------------------------------------------------------------------
-- Paragraph 7(2): payments of or towards the costs of providing services or facilities for the use of persons occupying accommodation (a), or fairly attributable to such costs (b).
-- Expected: (a) alone gives TRUE; (b) alone gives TRUE; neither gives FALSE.
#ASSERT `Sch 1 para 7(2) — the payment falls within sub-paragraph (2)` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS TRUE
#ASSERT `Sch 1 para 7(2) — the payment falls within sub-paragraph (2)` (`uc3 test — a payment that may be a service charge payment` FALSE TRUE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS TRUE
#ASSERT `Sch 1 para 7(2) — the payment falls within sub-paragraph (2)` (`uc3 test — a payment that may be a service charge payment` FALSE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS FALSE

-- Paragraph 7(3): excluded where (a) a qualifying loan was taken out for the purposes of making the payments, or (b) the services are for a person occupying a tent, approved premises, a care home or exempt accommodation.
-- Expected: a loan gives TRUE; each of the four kinds gives TRUE; ordinary accommodation with no loan gives FALSE.
#ASSERT `Sch 1 para 7(3) — the payment is excluded by sub-paragraph (3)` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE TRUE 0 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS TRUE
#ASSERT `Sch 1 para 7(3) — the payment is excluded by sub-paragraph (3)` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 1 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS TRUE
#ASSERT `Sch 1 para 7(3) — the payment is excluded by sub-paragraph (3)` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 2 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS TRUE
#ASSERT `Sch 1 para 7(3) — the payment is excluded by sub-paragraph (3)` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 3 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS TRUE
#ASSERT `Sch 1 para 7(3) — the payment is excluded by sub-paragraph (3)` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 4 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS TRUE
#ASSERT `Sch 1 para 7(3) — the payment is excluded by sub-paragraph (3)` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS FALSE

-- Paragraph 7(1): a service charge payment falls within (2), is not excluded by (3), and in any case to which paragraph 8 applies meets all its conditions.
-- Expected: a payment for services in ordinary accommodation under Part 4 (paragraph 8 does not apply) gives TRUE even though no paragraph 8 condition is met;
-- the same under Part 5 with all four conditions met gives TRUE; excluded by a loan gives FALSE; outside (2) gives FALSE; a care home occupant gives FALSE.
#ASSERT `Sch 1 para 7(1) — a service charge payment` (`uc3 test — an ordinary service charge payment under Part 4`) EQUALS TRUE
#ASSERT `Sch 1 para 7(1) — a service charge payment` (`uc3 test — an ordinary service charge payment under Part 5`) EQUALS TRUE
#ASSERT `Sch 1 para 7(1) — a service charge payment` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE TRUE 0 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS FALSE
#ASSERT `Sch 1 para 7(1) — a service charge payment` (`uc3 test — a payment that may be a service charge payment` FALSE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS FALSE
#ASSERT `Sch 1 para 7(1) — a service charge payment` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 3 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS FALSE
-- Paragraph 7(4): whether the payments are separately identified, whether they are made in addition to or as part of another payment, and whether they are made under the same agreement are irrelevant.
-- Expected: the answer is the same with all three set and with none set.
#ASSERT `Sch 1 para 7(1) — a service charge payment` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 0 TRUE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS TRUE
#ASSERT `Sch 1 para 7(1) — a service charge payment` (`uc3 test — a payment that may be a service charge payment` FALSE FALSE FALSE 0 TRUE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0)) EQUALS FALSE

-- Paragraph 8: under Part 5 of Schedule 4 and Schedule 5, a payment must also meet four conditions.
-- First condition: making the payments is a condition on which the right to occupy depends. Expected: missing gives 8(3) FALSE and 7(1)(c) FALSE; present gives TRUE.
#ASSERT `Sch 1 para 8(3) — the first condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 6 TRUE TRUE 0) EQUALS TRUE
#ASSERT `Sch 1 para 8(3) — the first condition` (`uc3 test — facts for paragraph 8` TRUE FALSE 6 TRUE TRUE 0) EQUALS FALSE
-- Second condition, the categories. Expected: A(a) windows in upper floors TRUE, windows not in upper floors FALSE; A(b) separately identifiable and payable by a shared owner TRUE,
-- by a claimant whose housing costs element falls under Schedule 5 TRUE, not separately identifiable FALSE, separately identifiable but payable by neither kind FALSE;
-- Category B TRUE; Category C TRUE; Category D TRUE; none of the categories FALSE.
#ASSERT `Sch 1 para 8(4) — the second condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 1 TRUE TRUE 0) EQUALS TRUE
#ASSERT `Sch 1 para 8(4) — the second condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 2 TRUE TRUE 0) EQUALS FALSE
#ASSERT `Sch 1 para 8(4) — the second condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 3 TRUE TRUE 0) EQUALS TRUE
#ASSERT `Sch 1 para 8(4) — the second condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 4 TRUE TRUE 0) EQUALS TRUE
#ASSERT `Sch 1 para 8(4) — the second condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 5 TRUE TRUE 0) EQUALS FALSE
#ASSERT `Sch 1 para 8(4) — the second condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 9 TRUE TRUE 0) EQUALS FALSE
#ASSERT `Sch 1 para 8(4) — the second condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 6 TRUE TRUE 0) EQUALS TRUE
#ASSERT `Sch 1 para 8(4) — the second condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 7 TRUE TRUE 0) EQUALS TRUE
#ASSERT `Sch 1 para 8(4) — the second condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 8 TRUE TRUE 0) EQUALS TRUE
#ASSERT `Sch 1 para 8(4) — the second condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 0 TRUE TRUE 0) EQUALS FALSE
-- Third condition: a reasonable amount AND a reasonable description. Expected: both TRUE; either missing FALSE.
#ASSERT `Sch 1 para 8(5) — the third condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 6 TRUE TRUE 0) EQUALS TRUE
#ASSERT `Sch 1 para 8(5) — the third condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 6 FALSE TRUE 0) EQUALS FALSE
#ASSERT `Sch 1 para 8(5) — the third condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 6 TRUE FALSE 0) EQUALS FALSE
-- Fourth condition: none of (a) public funds, (b) transfer of an asset, (c) food, medical or personal services. Expected: none TRUE; each alone FALSE.
#ASSERT `Sch 1 para 8(6) — the fourth condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 6 TRUE TRUE 0) EQUALS TRUE
#ASSERT `Sch 1 para 8(6) — the fourth condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 6 TRUE TRUE 1) EQUALS FALSE
#ASSERT `Sch 1 para 8(6) — the fourth condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 6 TRUE TRUE 2) EQUALS FALSE
#ASSERT `Sch 1 para 8(6) — the fourth condition` (`uc3 test — facts for paragraph 8` TRUE TRUE 6 TRUE TRUE 3) EQUALS FALSE
-- Paragraphs 8(2) and 7(1)(c): all four. Expected: all four met gives TRUE; any one failing gives FALSE; where paragraph 8 does not apply (Part 4) the conditions are not asked (TRUE).
#ASSERT `Sch 1 para 8(2) — all four conditions are met` (`uc3 test — facts for paragraph 8` TRUE TRUE 6 TRUE TRUE 0) EQUALS TRUE
#ASSERT `Sch 1 para 8(2) — all four conditions are met` (`uc3 test — facts for paragraph 8` TRUE TRUE 0 TRUE TRUE 0) EQUALS FALSE
#ASSERT `Sch 1 para 7(1)(c) — in any case to which paragraph 8 applies, the payments meet all of its conditions` (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 3) EQUALS TRUE
#ASSERT `Sch 1 para 7(1)(c) — in any case to which paragraph 8 applies, the payments meet all of its conditions` (`uc3 test — facts for paragraph 8` TRUE TRUE 6 TRUE TRUE 3) EQUALS FALSE

-- Under Part 5, a payment for services that fails a condition is not a service charge payment (paragraph 7(1)(c)).
-- Expected: first condition missing under Part 5 gives 7(1) FALSE; every condition met gives TRUE (above).
#ASSERT `Sch 1 para 7(1) — a service charge payment` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` TRUE FALSE 6 TRUE TRUE 0)) EQUALS FALSE
#ASSERT `Sch 1 para 7(1) — a service charge payment` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` TRUE TRUE 0 TRUE TRUE 0)) EQUALS FALSE
-- Paragraph 8(7): a payment that is not a service charge payment only because it fails a condition in 8(3) to (6) is treated as one for paragraph 3(g).
-- Expected: the payment above, failing the first condition, gives TRUE; one outside 7(2) gives FALSE; one excluded by a loan gives FALSE.
#ASSERT `Sch 1 para 8(7) — the payment is treated as a service charge payment for the purposes of paragraph 3(g)` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` TRUE FALSE 6 TRUE TRUE 0)) EQUALS TRUE
#ASSERT `Sch 1 para 8(7) — the payment is treated as a service charge payment for the purposes of paragraph 3(g)` (`uc3 test — a payment that may be a service charge payment` FALSE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` TRUE FALSE 6 TRUE TRUE 0)) EQUALS FALSE
#ASSERT `Sch 1 para 8(7) — the payment is treated as a service charge payment for the purposes of paragraph 3(g)` (`uc3 test — a payment that may be a service charge payment` TRUE FALSE TRUE 0 FALSE (`uc3 test — facts for paragraph 8` TRUE FALSE 6 TRUE TRUE 0)) EQUALS FALSE

-- ---------------------------------------------------------------------------------------------------------
-- Paragraphs 2 and 3: a rent payment is a payment of one of the five descriptions that none of (a) to (i) of paragraph 3 excludes.
-- Expected: a plain payment of rent in ordinary accommodation gives TRUE; a payment of no listed description gives FALSE; each exclusion gives FALSE:
-- (a) ground rent; (b) a tent, and a payment for the site of a tent; (c) approved premises; (d) a care home; (f) an owner-occupier payment; (g) a service charge payment (under Part 4, paragraph 7);
-- (h) accommodation specified in paragraph 3A (exempt accommodation here); (i) temporary accommodation (Case 1 here).
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a plain payment in respect of accommodation` 1) EQUALS TRUE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a plain payment in respect of accommodation` 0) EQUALS FALSE

-- A payment of rent with one change from the plain case. code: 1 ground rent (3(a)); 2 a payment for the site of a tent (3(b)); 3 a tent (3(b)); 4 approved premises (3(c)); 5 a care home (3(d));
-- 6 an owner-occupier payment within the Loans for Mortgage Regulations 2017 (3(f)); 7 a service charge payment under Part 4 (3(g)); 8 a payment for services under Part 5 that fails the first condition,
-- which paragraph 8(7) treats as a service charge payment for 3(g); 9 accommodation specified in paragraph 3A (3(h)); 10 temporary accommodation, Case 1 (3(i));
-- 11 a payment for services excluded from being a service charge payment by a qualifying loan (7(3)(a)); 12 a payment that is not for services at all (outside 7(2)).
GIVEN code IS A NUMBER
GIVETH A `Payment in respect of accommodation`
`uc3 test — a payment of rent with one change` code MEANS
    `uc3 test — a payment in respect of accommodation` 1
        (IF code EQUALS 3 THEN 1 ELSE IF code EQUALS 4 THEN 2 ELSE IF code EQUALS 5 THEN 3 ELSE 0)
        (code EQUALS 1) (code EQUALS 2) (code EQUALS 6)
        (IF code EQUALS 7 THEN `uc3 test — an ordinary service charge payment under Part 4` ELSE IF code EQUALS 8 THEN `uc3 test — a payment that may be a service charge payment` TRUE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` TRUE FALSE 6 TRUE TRUE 0) ELSE IF code EQUALS 11 THEN `uc3 test — a payment that may be a service charge payment` TRUE FALSE TRUE 0 FALSE (`uc3 test — facts for paragraph 8` TRUE FALSE 6 TRUE TRUE 0) ELSE `uc3 test — a payment that may be a service charge payment` FALSE FALSE FALSE 0 FALSE (`uc3 test — facts for paragraph 8` FALSE FALSE 0 FALSE FALSE 0))
        (`uc3 test — accommodation for paragraph 3A` (IF code EQUALS 9 THEN 1 ELSE 0))
        (`uc3 test — accommodation for paragraph 3B` (IF code EQUALS 10 THEN 1 ELSE 0) (code EQUALS 10) FALSE FALSE FALSE)

#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a payment of rent with one change` 1) EQUALS FALSE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a payment of rent with one change` 2) EQUALS FALSE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a payment of rent with one change` 3) EQUALS FALSE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a payment of rent with one change` 4) EQUALS FALSE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a payment of rent with one change` 5) EQUALS FALSE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a payment of rent with one change` 6) EQUALS FALSE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a payment of rent with one change` 7) EQUALS FALSE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a payment of rent with one change` 8) EQUALS FALSE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a payment of rent with one change` 9) EQUALS FALSE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a payment of rent with one change` 10) EQUALS FALSE
-- A payment for services that a qualifying loan took out of the service charge payments is nothing paragraph 3(g) catches, so it stays a rent payment; so does a payment not for services at all.
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a payment of rent with one change` 11) EQUALS TRUE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a payment of rent with one change` 12) EQUALS TRUE
-- Paragraph 3 itself: the exclusion is TRUE for a Part 4 service charge payment and FALSE for the loan case, which leaves the payment a rent payment.
#ASSERT `Sch 1 para 3 — a payment is excluded from being a rent payment` (`uc3 test — a payment of rent with one change` 7) EQUALS TRUE
#ASSERT `Sch 1 para 3 — a payment is excluded from being a rent payment` (`uc3 test — a payment of rent with one change` 11) EQUALS FALSE
-- The other four descriptions of rent payment behave the same way when nothing excludes them.
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a plain payment in respect of accommodation` 2) EQUALS TRUE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a plain payment in respect of accommodation` 3) EQUALS TRUE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a plain payment in respect of accommodation` 4) EQUALS TRUE
#ASSERT `Sch 1 para 2 — a rent payment` (`uc3 test — a plain payment in respect of accommodation` 5) EQUALS TRUE
