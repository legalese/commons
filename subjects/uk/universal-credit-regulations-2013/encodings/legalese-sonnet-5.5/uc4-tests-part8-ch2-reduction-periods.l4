IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-persons`
IMPORT `uc4-part8-ch2-reduction-periods`

-- Tests of uc4-part8-ch2-reduction-periods.l4: regulations 100 to 105.
-- Expected values are written by hand from the text, beside the assertion.
-- The current sanctionable failure is on 1 June 2026 unless a case says otherwise.

-- ---------------------------------------------------------------------------------------------------------
-- Fixtures.
GIVEN date IS A DATE
      period IS A NUMBER
      pre IS A BOOLEAN
      higher IS A BOOLEAN
      medium IS A BOOLEAN
      low IS A BOOLEAN
GIVETH A `Previous sanctionable failure`
`test — failure` date period pre higher medium low MEANS `Previous sanctionable failure` WITH
    `date of the previous sanctionable failure` IS date
    `reduction period applicable to the previous sanctionable failure, in days` IS period
    `the previous sanctionable failure was a pre-claim failure` IS pre
    `the previous sanctionable failure gave rise to a higher-level sanction` IS higher
    `the previous sanctionable failure falls within regulation 103(1)` IS medium
    `the previous sanctionable failure falls within regulation 104(1)` IS low

-- The period of the failure a MAYBE holds, or 0 if there is none, and its date as a day number, or 0.
GIVEN found IS A MAYBE `Previous sanctionable failure`
GIVETH A NUMBER
`test — period of` found MEANS
    CONSIDER found
    WHEN NOTHING THEN 0
    WHEN JUST p THEN p's `reduction period applicable to the previous sanctionable failure, in days`

-- A higher-level failure of 91 days on 1 March 2026 (92 days before the current failure).
`test — an earlier higher-level failure` MEANS `test — failure` (YearMonthDay 2026 3 1) 91 FALSE TRUE FALSE FALSE

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 100(1) and (1A).
#ASSERT `reg 100(1) — a sanctionable failure` TRUE FALSE
#ASSERT `reg 100(1) — a sanctionable failure` FALSE TRUE
#ASSERT NOT (`reg 100(1) — a sanctionable failure` FALSE FALSE)
#ASSERT `reg 100(1A) — a current sanctionable failure` TRUE FALSE
#ASSERT NOT (`reg 100(1A) — a current sanctionable failure` TRUE TRUE)
#ASSERT NOT (`reg 100(1A) — a current sanctionable failure` FALSE FALSE)

-- Regulation 100(2) to (5), 101(1) and 101(4) state no rule: the rows are cited and say so.
#ASSERT `reg 100(2) to (5) — where the Chapter deals with the period of a reduction, when it takes effect, how much it is, and some other matters` EQUALS "Regulations 101 to 105 determine the period of a reduction, regulations 106 to 109 when it begins or ceases to have effect, regulations 110 and 111 its amount, and regulations 112 to 114 some miscellaneous matters."
#ASSERT `reg 101(4) — a run of dots in the text, not encoded` EQUALS "(4) . . . ."

-- Regulation 101(2): consecutive periods.
#ASSERT `reg 101(2) — the first day on which the next reduction period can run` (YearMonthDay 2026 6 30) EQUALS YearMonthDay 2026 7 1
#ASSERT `reg 101(2) — the first day on which the next reduction period can run` (YearMonthDay 2026 12 31) EQUALS YearMonthDay 2027 1 1

-- Regulation 101(5) and (3): the cap of 1095 days.
#ASSERT `reg 101(5) — the total outstanding reduction period` (LIST 28, 91, 7) EQUALS 126
#ASSERT `reg 101(5) — the total outstanding reduction period` EMPTY EQUALS 0
#ASSERT `reg 101(3) — the reduction period adjusted so that the total outstanding reduction period does not exceed 1095 days` 91 0 EQUALS 91
-- 1004 + 91 = 1095 exactly: not exceeding it, so not adjusted.
#ASSERT `reg 101(3) — the reduction period adjusted so that the total outstanding reduction period does not exceed 1095 days` 91 1004 EQUALS 91
-- 1005 + 91 = 1096 exceeds it by one day: adjusted to 90.
#ASSERT `reg 101(3) — the reduction period adjusted so that the total outstanding reduction period does not exceed 1095 days` 91 1005 EQUALS 90
#ASSERT `reg 101(3) — the reduction period adjusted so that the total outstanding reduction period does not exceed 1095 days` 91 1095 EQUALS 0
-- Nothing is left to apply; the period is not made negative (fork F-101-2).
#ASSERT `reg 101(3) — the reduction period adjusted so that the total outstanding reduction period does not exceed 1095 days` 91 1100 EQUALS 0

-- ---------------------------------------------------------------------------------------------------------
-- The age band.
#ASSERT `reg 102(2) — the age band of the claimant on the date of the sanctionable failure` 18 EQUALS JUST `aged 18 or over`
#ASSERT `reg 102(2) — the age band of the claimant on the date of the sanctionable failure` 40 EQUALS JUST `aged 18 or over`
#ASSERT `reg 102(2) — the age band of the claimant on the date of the sanctionable failure` 17 EQUALS JUST `aged 16 or 17`
#ASSERT `reg 102(2) — the age band of the claimant on the date of the sanctionable failure` 16 EQUALS JUST `aged 16 or 17`
-- No table has a column for a claimant under 16.
#ASSERT `reg 102(2) — the age band of the claimant on the date of the sanctionable failure` 15 EQUALS NOTHING

-- The most recent previous failure: the latest date.
#ASSERT `test — period of` (`reg 102(2) — the most recent of some previous sanctionable failures` EMPTY) EQUALS 0
#ASSERT `reg 102(2) — the most recent of some previous sanctionable failures` EMPTY EQUALS NOTHING
#ASSERT `test — period of` (`reg 102(2) — the most recent of some previous sanctionable failures` (LIST `test — failure` (YearMonthDay 2026 1 1) 14 FALSE TRUE FALSE FALSE, `test — failure` (YearMonthDay 2026 3 1) 28 FALSE TRUE FALSE FALSE)) EQUALS 28
#ASSERT `test — period of` (`reg 102(2) — the most recent of some previous sanctionable failures` (LIST `test — failure` (YearMonthDay 2026 3 1) 28 FALSE TRUE FALSE FALSE, `test — failure` (YearMonthDay 2026 1 1) 14 FALSE TRUE FALSE FALSE)) EQUALS 28

-- How recent: the current failure is on 1 June 2026. A gap counts both ends (fork F-102-1).
#ASSERT `reg 102(2) — how recent the most recent previous sanctionable failure is` (YearMonthDay 2026 6 1) NOTHING EQUALS JUST `no previous sanctionable failure`
-- A gap of 365 days (1 June 2025): not within 365 days.
#ASSERT `reg 102(2) — how recent the most recent previous sanctionable failure is` (YearMonthDay 2026 6 1) (JUST (`test — failure` (YearMonthDay 2025 6 1) 91 FALSE TRUE FALSE FALSE)) EQUALS JUST `previous failure not within 365 days`
-- A gap of 364 days (2 June 2025): within 365 days, not within 14.
#ASSERT `reg 102(2) — how recent the most recent previous sanctionable failure is` (YearMonthDay 2026 6 1) (JUST (`test — failure` (YearMonthDay 2025 6 2) 91 FALSE TRUE FALSE FALSE)) EQUALS JUST `previous failure within 365 days but not within 14 days`
-- A gap of 14 days (18 May 2026): within 365 days, not within 14.
#ASSERT `reg 102(2) — how recent the most recent previous sanctionable failure is` (YearMonthDay 2026 6 1) (JUST (`test — failure` (YearMonthDay 2026 5 18) 91 FALSE TRUE FALSE FALSE)) EQUALS JUST `previous failure within 365 days but not within 14 days`
-- A gap of 13 days (19 May 2026): within 14 days. A gap of 0 days also.
#ASSERT `reg 102(2) — how recent the most recent previous sanctionable failure is` (YearMonthDay 2026 6 1) (JUST (`test — failure` (YearMonthDay 2026 5 19) 91 FALSE TRUE FALSE FALSE)) EQUALS JUST `previous failure within 14 days`
#ASSERT `reg 102(2) — how recent the most recent previous sanctionable failure is` (YearMonthDay 2026 6 1) (JUST (`test — failure` (YearMonthDay 2026 6 1) 91 FALSE TRUE FALSE FALSE)) EQUALS JUST `previous failure within 14 days`
-- A "previous" failure dated after the current one is not previous: not covered.
#ASSERT `reg 102(2) — how recent the most recent previous sanctionable failure is` (YearMonthDay 2026 6 1) (JUST (`test — failure` (YearMonthDay 2026 6 2) 91 FALSE TRUE FALSE FALSE)) EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 102(1) and (5).
#ASSERT `reg 102(1) — this regulation specifies the reduction period for the failure` TRUE
#ASSERT NOT (`reg 102(1) — this regulation specifies the reduction period for the failure` FALSE)
#ASSERT `reg 102(5) — a pre-claim failure` TRUE
#ASSERT NOT (`reg 102(5) — a pre-claim failure` FALSE)

-- Regulation 102(2), the table, cell by cell. First row: no previous failure, or one not within 365 days.
#ASSERT `reg 102(2) — the reduction period in the table` `aged 18 or over` `no previous sanctionable failure` 0 EQUALS JUST 91
#ASSERT `reg 102(2) — the reduction period in the table` `aged 16 or 17` `no previous sanctionable failure` 0 EQUALS JUST 14
#ASSERT `reg 102(2) — the reduction period in the table` `aged 18 or over` `previous failure not within 365 days` 182 EQUALS JUST 91
#ASSERT `reg 102(2) — the reduction period in the table` `aged 16 or 17` `previous failure not within 365 days` 28 EQUALS JUST 14
-- Within 365 days but not within 14 days: (a) 14 days, (b) 28, (c) 91, (d) 182.
#ASSERT `reg 102(2) — the reduction period in the table` `aged 18 or over` `previous failure within 365 days but not within 14 days` 14 EQUALS NOTHING
#ASSERT `reg 102(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 365 days but not within 14 days` 14 EQUALS JUST 28
#ASSERT `reg 102(2) — the reduction period in the table` `aged 18 or over` `previous failure within 365 days but not within 14 days` 28 EQUALS NOTHING
#ASSERT `reg 102(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 365 days but not within 14 days` 28 EQUALS JUST 28
#ASSERT `reg 102(2) — the reduction period in the table` `aged 18 or over` `previous failure within 365 days but not within 14 days` 91 EQUALS JUST 182
#ASSERT `reg 102(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 365 days but not within 14 days` 91 EQUALS NOTHING
#ASSERT `reg 102(2) — the reduction period in the table` `aged 18 or over` `previous failure within 365 days but not within 14 days` 182 EQUALS JUST 182
#ASSERT `reg 102(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 365 days but not within 14 days` 182 EQUALS NOTHING
-- A prior period that is in no row of the table (7 days): row (e) is blank in this text.
#ASSERT `reg 102(2) — the reduction period in the table` `aged 18 or over` `previous failure within 365 days but not within 14 days` 7 EQUALS NOTHING
#ASSERT `reg 102(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 365 days but not within 14 days` 7 EQUALS NOTHING
-- Within 14 days.
#ASSERT `reg 102(2) — the reduction period in the table` `aged 18 or over` `previous failure within 14 days` 14 EQUALS NOTHING
#ASSERT `reg 102(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 14 days` 14 EQUALS JUST 14
#ASSERT `reg 102(2) — the reduction period in the table` `aged 18 or over` `previous failure within 14 days` 28 EQUALS NOTHING
#ASSERT `reg 102(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 14 days` 28 EQUALS JUST 28
#ASSERT `reg 102(2) — the reduction period in the table` `aged 18 or over` `previous failure within 14 days` 91 EQUALS JUST 91
#ASSERT `reg 102(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 14 days` 91 EQUALS NOTHING
#ASSERT `reg 102(2) — the reduction period in the table` `aged 18 or over` `previous failure within 14 days` 182 EQUALS JUST 182
#ASSERT `reg 102(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 14 days` 182 EQUALS NOTHING
#ASSERT `reg 102(2) — the reduction period in the table` `aged 18 or over` `previous failure within 14 days` 7 EQUALS NOTHING

-- Regulation 102(3): the pre-claim failure is disregarded, so that the next most recent counts.
#ASSERT `test — period of` (`reg 102(3) — the most recent previous sanctionable failure giving rise to a higher-level sanction, disregarding a pre-claim failure` (LIST `test — an earlier higher-level failure`, `test — failure` (YearMonthDay 2026 5 25) 14 TRUE TRUE FALSE FALSE)) EQUALS 91
-- A failure that did not give rise to a higher-level sanction does not count either.
#ASSERT `reg 102(3) — the most recent previous sanctionable failure giving rise to a higher-level sanction, disregarding a pre-claim failure` (LIST `test — failure` (YearMonthDay 2026 5 25) 28 FALSE FALSE TRUE FALSE) EQUALS NOTHING

-- Regulation 102(2) as a whole. Aged 25, with the earlier 91-day failure 92 days before: within 365 days, not within 14: 182.
#ASSERT `reg 102(2) — the reduction period for a sanctionable failure that is not a pre-claim failure` 25 (YearMonthDay 2026 6 1) (LIST `test — an earlier higher-level failure`) EQUALS JUST 182
-- ... with a more recent pre-claim failure that is disregarded: still 182.
#ASSERT `reg 102(2) — the reduction period for a sanctionable failure that is not a pre-claim failure` 25 (YearMonthDay 2026 6 1) (LIST `test — an earlier higher-level failure`, `test — failure` (YearMonthDay 2026 5 25) 14 TRUE TRUE FALSE FALSE) EQUALS JUST 182
-- ... with only a pre-claim failure before: no previous failure counts: 91.
#ASSERT `reg 102(2) — the reduction period for a sanctionable failure that is not a pre-claim failure` 25 (YearMonthDay 2026 6 1) (LIST `test — failure` (YearMonthDay 2026 5 25) 14 TRUE TRUE FALSE FALSE) EQUALS JUST 91
#ASSERT `reg 102(2) — the reduction period for a sanctionable failure that is not a pre-claim failure` 25 (YearMonthDay 2026 6 1) EMPTY EQUALS JUST 91
#ASSERT `reg 102(2) — the reduction period for a sanctionable failure that is not a pre-claim failure` 17 (YearMonthDay 2026 6 1) EMPTY EQUALS JUST 14
-- A 17-year-old whose earlier failure drew 91 days has no cell in the table.
#ASSERT `reg 102(2) — the reduction period for a sanctionable failure that is not a pre-claim failure` 17 (YearMonthDay 2026 6 1) (LIST `test — an earlier higher-level failure`) EQUALS NOTHING
#ASSERT `reg 102(2) — the reduction period for a sanctionable failure that is not a pre-claim failure` 15 (YearMonthDay 2026 6 1) EMPTY EQUALS NOTHING

-- Regulation 102(4): a pre-claim failure on 1 January 2026, claim on 11 January 2026: 9 days from 2 to 10 January are taken off.
#ASSERT `reg 102(4) — the reduction period for a pre-claim failure` (JUST 91) (YearMonthDay 2026 1 1) NOTHING (YearMonthDay 2026 1 11) EQUALS JUST 82
-- Paid work due to last until 1 February 2026: 31 days, which is less than 91; 31 less 9 is 22.
#ASSERT `reg 102(4) — the reduction period for a pre-claim failure` (JUST 91) (YearMonthDay 2026 1 1) (JUST (YearMonthDay 2026 2 1)) (YearMonthDay 2026 1 11) EQUALS JUST 22
-- Paid work due to last longer than the 91 days: the lesser is 91.
#ASSERT `reg 102(4) — the reduction period for a pre-claim failure` (JUST 91) (YearMonthDay 2026 1 1) (JUST (YearMonthDay 2026 6 1)) (YearMonthDay 2026 1 11) EQUALS JUST 82
#ASSERT `reg 102(4) — the reduction period for a pre-claim failure` NOTHING (YearMonthDay 2026 1 1) NOTHING (YearMonthDay 2026 1 11) EQUALS NOTHING
-- A claim on the day after the failure leaves no days to take away.
#ASSERT `reg 102(4) — the reduction period for a pre-claim failure` (JUST 91) (YearMonthDay 2026 1 1) NOTHING (YearMonthDay 2026 1 2) EQUALS JUST 91
-- A claim on a day that is not after the failure: no days are taken off.
#ASSERT `reg 102(4) — the reduction period for a pre-claim failure` (JUST 91) (YearMonthDay 2026 1 1) NOTHING (YearMonthDay 2026 1 1) EQUALS JUST 91
-- A claim 5 months later: 150 days taken off 91 leaves a negative number, which regulation 113(1)(e) deals with.
#ASSERT `reg 102(4) — the reduction period for a pre-claim failure` (JUST 91) (YearMonthDay 2026 1 1) NOTHING (YearMonthDay 2026 6 1) EQUALS JUST (0 MINUS 59)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 103(1).
#ASSERT `reg 103(1) — this regulation specifies the reduction period for the failure` TRUE TRUE FALSE
#ASSERT `reg 103(1) — this regulation specifies the reduction period for the failure` TRUE FALSE TRUE
#ASSERT NOT (`reg 103(1) — this regulation specifies the reduction period for the failure` TRUE FALSE FALSE)
#ASSERT NOT (`reg 103(1) — this regulation specifies the reduction period for the failure` FALSE TRUE TRUE)

-- Regulation 103(2), the table. First row.
#ASSERT `reg 103(2) — the reduction period in the table` `aged 18 or over` `no previous sanctionable failure` 0 EQUALS JUST 28
#ASSERT `reg 103(2) — the reduction period in the table` `aged 16 or 17` `no previous sanctionable failure` 0 EQUALS JUST 7
#ASSERT `reg 103(2) — the reduction period in the table` `aged 18 or over` `previous failure not within 365 days` 91 EQUALS JUST 28
#ASSERT `reg 103(2) — the reduction period in the table` `aged 16 or 17` `previous failure not within 365 days` 14 EQUALS JUST 7
-- Within 365 days but not within 14 days: (a) 7, (b) 14, (c) 28, (d) 91.
#ASSERT `reg 103(2) — the reduction period in the table` `aged 18 or over` `previous failure within 365 days but not within 14 days` 7 EQUALS NOTHING
#ASSERT `reg 103(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 365 days but not within 14 days` 7 EQUALS JUST 14
#ASSERT `reg 103(2) — the reduction period in the table` `aged 18 or over` `previous failure within 365 days but not within 14 days` 14 EQUALS NOTHING
#ASSERT `reg 103(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 365 days but not within 14 days` 14 EQUALS JUST 14
#ASSERT `reg 103(2) — the reduction period in the table` `aged 18 or over` `previous failure within 365 days but not within 14 days` 28 EQUALS JUST 91
#ASSERT `reg 103(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 365 days but not within 14 days` 28 EQUALS NOTHING
#ASSERT `reg 103(2) — the reduction period in the table` `aged 18 or over` `previous failure within 365 days but not within 14 days` 91 EQUALS JUST 91
#ASSERT `reg 103(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 365 days but not within 14 days` 91 EQUALS NOTHING
-- Within 14 days.
#ASSERT `reg 103(2) — the reduction period in the table` `aged 18 or over` `previous failure within 14 days` 7 EQUALS NOTHING
#ASSERT `reg 103(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 14 days` 7 EQUALS JUST 7
#ASSERT `reg 103(2) — the reduction period in the table` `aged 18 or over` `previous failure within 14 days` 14 EQUALS NOTHING
#ASSERT `reg 103(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 14 days` 14 EQUALS JUST 14
#ASSERT `reg 103(2) — the reduction period in the table` `aged 18 or over` `previous failure within 14 days` 28 EQUALS JUST 28
#ASSERT `reg 103(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 14 days` 28 EQUALS NOTHING
#ASSERT `reg 103(2) — the reduction period in the table` `aged 18 or over` `previous failure within 14 days` 91 EQUALS JUST 91
#ASSERT `reg 103(2) — the reduction period in the table` `aged 16 or 17` `previous failure within 14 days` 91 EQUALS NOTHING
-- The most recent failure within paragraph (1), and the whole rule.
#ASSERT `test — period of` (`reg 103(2) — the most recent previous sanctionable failure that falls within paragraph (1)` (LIST `test — failure` (YearMonthDay 2026 3 1) 28 FALSE FALSE TRUE FALSE, `test — failure` (YearMonthDay 2026 5 1) 91 FALSE TRUE FALSE FALSE)) EQUALS 28
#ASSERT `reg 103(2) — the most recent previous sanctionable failure that falls within paragraph (1)` (LIST `test — failure` (YearMonthDay 2026 5 1) 91 FALSE TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT `reg 103(2) — the reduction period for a failure within paragraph (1)` 30 (YearMonthDay 2026 6 1) EMPTY EQUALS JUST 28
#ASSERT `reg 103(2) — the reduction period for a failure within paragraph (1)` 30 (YearMonthDay 2026 6 1) (LIST `test — failure` (YearMonthDay 2026 3 1) 28 FALSE FALSE TRUE FALSE) EQUALS JUST 91
#ASSERT `reg 103(2) — the reduction period for a failure within paragraph (1)` 30 (YearMonthDay 2026 6 1) (LIST `test — failure` (YearMonthDay 2026 5 25) 28 FALSE FALSE TRUE FALSE) EQUALS JUST 28
#ASSERT `reg 103(2) — the reduction period for a failure within paragraph (1)` 16 (YearMonthDay 2026 6 1) (LIST `test — failure` (YearMonthDay 2026 3 1) 7 FALSE FALSE TRUE FALSE) EQUALS JUST 14
#ASSERT `reg 103(2) — the reduction period for a failure within paragraph (1)` 16 (YearMonthDay 2026 6 1) (LIST `test — failure` (YearMonthDay 2026 3 1) 28 FALSE FALSE TRUE FALSE) EQUALS NOTHING
#ASSERT `reg 103(2) — the reduction period for a failure within paragraph (1)` 14 (YearMonthDay 2026 6 1) EMPTY EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 104(1): a claimant within section 21 or 22, and a failure of one of the four kinds.
#ASSERT `reg 104(1) — this regulation specifies the reduction period for the failure` TRUE `subject to work-preparation requirement` TRUE FALSE FALSE FALSE
#ASSERT `reg 104(1) — this regulation specifies the reduction period for the failure` TRUE `subject to all work-related requirements` FALSE TRUE FALSE FALSE
#ASSERT `reg 104(1) — this regulation specifies the reduction period for the failure` TRUE `subject to all work-related requirements` FALSE FALSE TRUE FALSE
#ASSERT `reg 104(1) — this regulation specifies the reduction period for the failure` TRUE `subject to all work-related requirements` FALSE FALSE FALSE TRUE
#ASSERT NOT (`reg 104(1) — this regulation specifies the reduction period for the failure` TRUE `subject to work-focused interview requirement only` TRUE FALSE FALSE FALSE)
#ASSERT NOT (`reg 104(1) — this regulation specifies the reduction period for the failure` TRUE `subject to no work-related requirements` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 104(1) — this regulation specifies the reduction period for the failure` TRUE `subject to all work-related requirements` FALSE FALSE FALSE FALSE)
#ASSERT NOT (`reg 104(1) — this regulation specifies the reduction period for the failure` FALSE `subject to all work-related requirements` TRUE TRUE TRUE TRUE)

-- Regulation 104(2)(a) and (3)(a): the failure is on 1 June 2026. The day before 11 June is 10 June: 10 days. The day before 6 June: 5 days.
-- The day before 20 June: 19 days. The award terminating on 4 June: the days 1 to 4 June are 4.
#ASSERT `reg 104(2)(a) — the days up to the day before the date of an event` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 6 11)) EQUALS JUST 10
#ASSERT `reg 104(2)(a) — the days up to the day before the date of an event` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 6 1)) EQUALS JUST 0
#ASSERT `reg 104(2)(a) — the days up to the day before the date of an event` (YearMonthDay 2026 6 1) NOTHING EQUALS NOTHING
#ASSERT `reg 104(2)(a)(iv) — the days up to the date on which the award terminates` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 6 4)) EQUALS JUST 4
#ASSERT `reg 104(2)(a)(iv) — the days up to the date on which the award terminates` (YearMonthDay 2026 6 1) NOTHING EQUALS NOTHING
#ASSERT `reg 104(2)(a) — the smaller of two numbers of days, whichever has one` (JUST 5) (JUST 9) EQUALS JUST 5
#ASSERT `reg 104(2)(a) — the smaller of two numbers of days, whichever has one` (JUST 9) (JUST 5) EQUALS JUST 5
#ASSERT `reg 104(2)(a) — the smaller of two numbers of days, whichever has one` NOTHING (JUST 5) EQUALS JUST 5
#ASSERT `reg 104(2)(a) — the smaller of two numbers of days, whichever has one` (JUST 5) NOTHING EQUALS JUST 5
#ASSERT `reg 104(2)(a) — the smaller of two numbers of days, whichever has one` NOTHING NOTHING EQUALS NOTHING
-- All four events given: the award terminating (4 days) is the soonest.
#ASSERT `reg 104(2)(a) — the number of days beginning with the date of the sanctionable failure and ending with whichever event is soonest` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 6 11)) (JUST (YearMonthDay 2026 6 6)) (JUST (YearMonthDay 2026 6 20)) (JUST (YearMonthDay 2026 6 4)) EQUALS JUST 4
-- Without the termination, the day before falling within section 19 (5 days).
#ASSERT `reg 104(2)(a) — the number of days beginning with the date of the sanctionable failure and ending with whichever event is soonest` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 6 11)) (JUST (YearMonthDay 2026 6 6)) (JUST (YearMonthDay 2026 6 20)) NOTHING EQUALS JUST 5
#ASSERT `reg 104(2)(a) — the number of days beginning with the date of the sanctionable failure and ending with whichever event is soonest` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 6 11)) NOTHING NOTHING NOTHING EQUALS JUST 10
#ASSERT `reg 104(2)(a) — the number of days beginning with the date of the sanctionable failure and ending with whichever event is soonest` (YearMonthDay 2026 6 1) NOTHING NOTHING (JUST (YearMonthDay 2026 6 20)) NOTHING EQUALS JUST 19
-- No event has a date yet: the period has not been fixed.
#ASSERT `reg 104(2)(a) — the number of days beginning with the date of the sanctionable failure and ending with whichever event is soonest` (YearMonthDay 2026 6 1) NOTHING NOTHING NOTHING NOTHING EQUALS NOTHING

-- Regulation 104(2)(b): the table for a claimant aged 18 or over.
#ASSERT `reg 104(2)(b) — the number of days in the table` `no previous sanctionable failure` 0 EQUALS JUST 7
#ASSERT `reg 104(2)(b) — the number of days in the table` `previous failure not within 365 days` 28 EQUALS JUST 7
#ASSERT `reg 104(2)(b) — the number of days in the table` `previous failure within 365 days but not within 14 days` 7 EQUALS JUST 14
#ASSERT `reg 104(2)(b) — the number of days in the table` `previous failure within 365 days but not within 14 days` 14 EQUALS JUST 28
#ASSERT `reg 104(2)(b) — the number of days in the table` `previous failure within 365 days but not within 14 days` 28 EQUALS JUST 28
#ASSERT `reg 104(2)(b) — the number of days in the table` `previous failure within 365 days but not within 14 days` 91 EQUALS NOTHING
#ASSERT `reg 104(2)(b) — the number of days in the table` `previous failure within 14 days` 7 EQUALS JUST 7
#ASSERT `reg 104(2)(b) — the number of days in the table` `previous failure within 14 days` 14 EQUALS JUST 14
#ASSERT `reg 104(2)(b) — the number of days in the table` `previous failure within 14 days` 28 EQUALS JUST 28
#ASSERT `reg 104(2)(b) — the number of days in the table` `previous failure within 14 days` 91 EQUALS NOTHING
#ASSERT `reg 104(2)(b) — the most recent previous sanctionable failure that falls within paragraph (1)` (LIST `test — failure` (YearMonthDay 2026 5 1) 91 FALSE TRUE FALSE FALSE) EQUALS NOTHING
#ASSERT `test — period of` (`reg 104(2)(b) — the most recent previous sanctionable failure that falls within paragraph (1)` (LIST `test — failure` (YearMonthDay 2026 5 1) 14 FALSE FALSE FALSE TRUE, `test — failure` (YearMonthDay 2026 3 1) 7 FALSE FALSE FALSE TRUE)) EQUALS 14

-- Regulation 104(2) as a whole: aged 25, 10 days to the compliance condition, no earlier failure: 10 + 7.
#ASSERT `reg 104(2) — the reduction period of a claimant aged 18 or over` 25 (YearMonthDay 2026 6 1) (JUST 10) EMPTY EQUALS JUST 17
-- An earlier failure 92 days before, with 14 days applicable: within 365 days, not within 14: 28; 10 + 28.
#ASSERT `reg 104(2) — the reduction period of a claimant aged 18 or over` 25 (YearMonthDay 2026 6 1) (JUST 10) (LIST `test — failure` (YearMonthDay 2026 3 1) 14 FALSE FALSE FALSE TRUE) EQUALS JUST 38
-- ... within 14 days with 14 days applicable: 14; 10 + 14.
#ASSERT `reg 104(2) — the reduction period of a claimant aged 18 or over` 25 (YearMonthDay 2026 6 1) (JUST 10) (LIST `test — failure` (YearMonthDay 2026 5 25) 14 FALSE FALSE FALSE TRUE) EQUALS JUST 24
-- An earlier failure of another kind is not counted.
#ASSERT `reg 104(2) — the reduction period of a claimant aged 18 or over` 25 (YearMonthDay 2026 6 1) (JUST 10) (LIST `test — failure` (YearMonthDay 2026 5 25) 14 FALSE TRUE TRUE FALSE) EQUALS JUST 17
-- No period fixed yet; an earlier period that is in no cell; a claimant who is not 18 or over.
#ASSERT `reg 104(2) — the reduction period of a claimant aged 18 or over` 25 (YearMonthDay 2026 6 1) NOTHING EMPTY EQUALS NOTHING
#ASSERT `reg 104(2) — the reduction period of a claimant aged 18 or over` 25 (YearMonthDay 2026 6 1) (JUST 10) (LIST `test — failure` (YearMonthDay 2026 5 25) 91 FALSE FALSE FALSE TRUE) EQUALS NOTHING
#ASSERT `reg 104(2) — the reduction period of a claimant aged 18 or over` 17 (YearMonthDay 2026 6 1) (JUST 10) EMPTY EQUALS NOTHING
#ASSERT `reg 104(2) — the reduction period of a claimant aged 18 or over` 15 (YearMonthDay 2026 6 1) (JUST 10) EMPTY EQUALS NOTHING

-- Regulation 104(3)(b): another failure of a kind in paragraph (1) 14 to 364 days before the current failure adds 7 days.
#ASSERT `reg 104(3)(b) — the days for another failure within 365 days but not within 14 days` (YearMonthDay 2026 6 1) (LIST `test — failure` (YearMonthDay 2026 5 18) 7 FALSE FALSE FALSE TRUE) EQUALS 7
#ASSERT `reg 104(3)(b) — the days for another failure within 365 days but not within 14 days` (YearMonthDay 2026 6 1) (LIST `test — failure` (YearMonthDay 2025 6 2) 7 FALSE FALSE FALSE TRUE) EQUALS 7
#ASSERT `reg 104(3)(b) — the days for another failure within 365 days but not within 14 days` (YearMonthDay 2026 6 1) (LIST `test — failure` (YearMonthDay 2026 5 19) 7 FALSE FALSE FALSE TRUE) EQUALS 0
#ASSERT `reg 104(3)(b) — the days for another failure within 365 days but not within 14 days` (YearMonthDay 2026 6 1) (LIST `test — failure` (YearMonthDay 2025 6 1) 7 FALSE FALSE FALSE TRUE) EQUALS 0
#ASSERT `reg 104(3)(b) — the days for another failure within 365 days but not within 14 days` (YearMonthDay 2026 6 1) (LIST `test — failure` (YearMonthDay 2026 3 1) 7 FALSE TRUE TRUE FALSE) EQUALS 0
-- Not the most recent only: an older one in the stretch counts although a newer one is within 14 days.
#ASSERT `reg 104(3)(b) — the days for another failure within 365 days but not within 14 days` (YearMonthDay 2026 6 1) (LIST `test — failure` (YearMonthDay 2026 5 25) 7 FALSE FALSE FALSE TRUE, `test — failure` (YearMonthDay 2026 3 1) 7 FALSE FALSE FALSE TRUE) EQUALS 7
#ASSERT `reg 104(3)(b) — the days for another failure within 365 days but not within 14 days` (YearMonthDay 2026 6 1) EMPTY EQUALS 0

-- Regulation 104(3): aged 16 or 17.
#ASSERT `reg 104(3) — the reduction period of a claimant aged 16 or 17` 17 (YearMonthDay 2026 6 1) (JUST 10) EMPTY EQUALS JUST 10
#ASSERT `reg 104(3) — the reduction period of a claimant aged 16 or 17` 16 (YearMonthDay 2026 6 1) (JUST 10) (LIST `test — failure` (YearMonthDay 2026 3 1) 7 FALSE FALSE FALSE TRUE) EQUALS JUST 17
#ASSERT `reg 104(3) — the reduction period of a claimant aged 16 or 17` 17 (YearMonthDay 2026 6 1) NOTHING EMPTY EQUALS NOTHING
#ASSERT `reg 104(3) — the reduction period of a claimant aged 16 or 17` 18 (YearMonthDay 2026 6 1) (JUST 10) EMPTY EQUALS NOTHING
#ASSERT `reg 104(3) — the reduction period of a claimant aged 16 or 17` 15 (YearMonthDay 2026 6 1) (JUST 10) EMPTY EQUALS NOTHING

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 105(1): section 27, the claimant within section 20 (work-focused interview only), a requirement under that section.
#ASSERT `reg 105(1) — this regulation specifies the reduction period for the failure` TRUE `subject to work-focused interview requirement only` TRUE
#ASSERT NOT (`reg 105(1) — this regulation specifies the reduction period for the failure` TRUE `subject to work-preparation requirement` TRUE)
#ASSERT NOT (`reg 105(1) — this regulation specifies the reduction period for the failure` TRUE `subject to all work-related requirements` TRUE)
#ASSERT NOT (`reg 105(1) — this regulation specifies the reduction period for the failure` TRUE `subject to no work-related requirements` TRUE)
#ASSERT NOT (`reg 105(1) — this regulation specifies the reduction period for the failure` FALSE `subject to work-focused interview requirement only` TRUE)
#ASSERT NOT (`reg 105(1) — this regulation specifies the reduction period for the failure` TRUE `subject to work-focused interview requirement only` FALSE)
-- Regulation 105(2): the failure on 1 June 2026; compliance on 11 June (10 days); section 19 on 6 June (5 days); termination on 4 June (4 days).
#ASSERT `reg 105(2) — the number of days beginning with the date of the sanctionable failure and ending with whichever event is soonest` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 6 11)) (JUST (YearMonthDay 2026 6 6)) (JUST (YearMonthDay 2026 6 4)) EQUALS JUST 4
#ASSERT `reg 105(2) — the number of days beginning with the date of the sanctionable failure and ending with whichever event is soonest` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 6 11)) (JUST (YearMonthDay 2026 6 6)) NOTHING EQUALS JUST 5
#ASSERT `reg 105(2) — the number of days beginning with the date of the sanctionable failure and ending with whichever event is soonest` (YearMonthDay 2026 6 1) (JUST (YearMonthDay 2026 6 11)) NOTHING NOTHING EQUALS JUST 10
#ASSERT `reg 105(2) — the number of days beginning with the date of the sanctionable failure and ending with whichever event is soonest` (YearMonthDay 2026 6 1) NOTHING NOTHING (JUST (YearMonthDay 2026 6 30)) EQUALS JUST 30
#ASSERT `reg 105(2) — the number of days beginning with the date of the sanctionable failure and ending with whichever event is soonest` (YearMonthDay 2026 6 1) NOTHING NOTHING NOTHING EQUALS NOTHING
