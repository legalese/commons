IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-bodies`
IMPORT `uc3-sch1-interpretation`
IMPORT `uc3-sch4-interpretation`
IMPORT `uc3-sch4-bedrooms`

-- The Universal Credit Regulations 2013 (S.I. 2013/376), Schedule 1 (meaning of payments in respect of accommodation), paragraphs 2 to 8.
-- Source: ../../registers/source-bundle/uksi-2013-376.txt (plain-text rendering, not the official text). Target: the stable build 1.6.98. Layer 1.
--
-- WHAT THIS SCHEDULE DECIDES. Regulation 25 gives a housing costs element for payments for accommodation. This Schedule says which payments
-- are "rent payments" (paragraphs 2, 3, 3A, 3B) and which are "service charge payments" (paragraphs 7 and 8). Paragraphs 4, 5 and 6 (owner-occupier
-- payments, loan interest payments, alternative finance payments) show only dots in this text. Everything the text defines by pointing to an Act
-- not among the inputs (approved premises, exempt accommodation, a housing association, owner-occupier payments, qualifying loans, an exempt
-- charity) is a stated input.
--
-- ORDER OF THE MODULE. The module imports Schedule 4's definitions, because paragraph 3A(5) uses the hostel test of Schedule 4 paragraph 29(10)
-- and paragraph 3B uses Schedule 4's "provider of social housing"; Schedule 4 reads Schedule 1 in the modules that come after this one.

-- ---------------------------------------------------------------------------------------------------------
-- The accommodation, as the tests in this Schedule look at it.
-- src:1855 | (b) payments in respect of a tent or the site on which a tent stands;
-- src:1856 | (c) payments in respect of approved premises;
-- src:1857 | (d) payments in respect of a care home;
-- src:1858 | (e) . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .
-- src:1859 | (f) payments which are owner-occupier payments within the meaning of Schedule 1 of the Loans for Mortgage Regulations 2017;
-- src:1860 | (g) payments which are service charge payments within the meaning of paragraph 7;
-- src:1861 | (h) payments in respect of accommodation specified in paragraph 3A;
-- src:1862 | (i) payments in respect of accommodation specified in paragraph 3B.
@ref Sch 1 para 3 (src:1855-1862)
DECLARE `Accommodation in the Schedule 1 tests` HAS
    `structure`                                                          IS A `Structure that may be a tent`
    `approved premises`                                                  IS A BOOLEAN
    `care home premises`                                                 IS A `Premises that may be a care home`
    `exempt accommodation`                                               IS A BOOLEAN

-- ---------------------------------------------------------------------------------------------------------
-- Paragraph 2(e): contributions towards almshouses provided by a housing association that is a registered charity or an exempt charity.
-- src:1849 | (e) contributions by residents towards maintaining almshouses (and essential services in them) provided by a housing association which is—
-- src:1850 | (i) a registered charity, or
-- src:1851 | (ii) an exempt charity within Schedule 3 to the Charities Act 2011.
@ref Sch 1 para 2(e) (src:1849-1851)
DECLARE `Almshouse contribution` HAS
    `contribution by a resident towards maintaining almshouses (and essential services in them)`   IS A BOOLEAN
    `the almshouses are provided by a housing association`                                         IS A BOOLEAN
    `the housing association as a possible registered charity`                                     IS A `Charity that may be a registered charity`
    `the housing association is an exempt charity within Schedule 3 to the Charities Act 2011`     IS A BOOLEAN

-- src:1849 | (e) contributions by residents towards maintaining almshouses (and essential services in them) provided by a housing association which is—
-- src:1850 | (i) a registered charity, or
-- src:1851 | (ii) an exempt charity within Schedule 3 to the Charities Act 2011.
@ref Sch 1 para 2(e) (src:1849-1851)
GIVEN contribution IS A `Almshouse contribution`
GIVETH A BOOLEAN
`Sch 1 para 2(e) — a contribution towards almshouses` contribution MEANS
    (contribution's `contribution by a resident towards maintaining almshouses (and essential services in them)`)
    AND (contribution's `the almshouses are provided by a housing association`)
    AND (    (`Sch 1 para 1 — registered charity` (contribution's `the housing association as a possible registered charity`))
          OR (contribution's `the housing association is an exempt charity within Schedule 3 to the Charities Act 2011`))

-- Paragraph 2(a) to (e): the five descriptions of payment.
-- src:1844 | “Rent payments” are such of the following as are not excluded by paragraph 3—
-- src:1845 | (a) payments of rent;
-- src:1846 | (b) payments for a licence or other permission to occupy accommodation;
-- src:1847 | (c) mooring charges payable for a houseboat;
-- src:1848 | (d) in relation to accommodation which is a caravan or mobile home, payments in respect of the site on which the accommodation stands;
@ref Sch 1 para 2(a) to (d) (src:1844-1848)
DECLARE `Description of a payment for accommodation` HAS
    `payment of rent`                                                                                                                     IS A BOOLEAN
    `payment for a licence or other permission to occupy accommodation`                                                                   IS A BOOLEAN
    `mooring charge payable for a houseboat`                                                                                              IS A BOOLEAN
    `accommodation is a caravan or mobile home and the payment is in respect of the site on which the accommodation stands`              IS A BOOLEAN
    `contribution towards almshouses`                                                                                                     IS A `Almshouse contribution`

-- src:1844 | “Rent payments” are such of the following as are not excluded by paragraph 3—
-- src:1845 | (a) payments of rent;
-- src:1846 | (b) payments for a licence or other permission to occupy accommodation;
-- src:1847 | (c) mooring charges payable for a houseboat;
-- src:1848 | (d) in relation to accommodation which is a caravan or mobile home, payments in respect of the site on which the accommodation stands;
-- src:1849 | (e) contributions by residents towards maintaining almshouses (and essential services in them) provided by a housing association which is—
-- src:1850 | (i) a registered charity, or
-- src:1851 | (ii) an exempt charity within Schedule 3 to the Charities Act 2011.
@ref Sch 1 para 2 (src:1844-1851)
GIVEN description IS A `Description of a payment for accommodation`
GIVETH A BOOLEAN
`Sch 1 para 2 — a payment of a description in paragraph 2(a) to (e)` description MEANS
    (description's `payment of rent`)
    OR (description's `payment for a licence or other permission to occupy accommodation`)
    OR (description's `mooring charge payable for a houseboat`)
    OR (description's `accommodation is a caravan or mobile home and the payment is in respect of the site on which the accommodation stands`)
    OR (`Sch 1 para 2(e) — a contribution towards almshouses` (description's `contribution towards almshouses`))

-- ---------------------------------------------------------------------------------------------------------
-- Paragraph 3A(6): "relevant body" is a county council in a two-tier area of England, a housing association, a registered charity or a voluntary organisation.
-- src:1878 | “relevant body” means a—
-- src:1879 | (a) council for a county in England for each part of which there is a district council;
-- src:1880 | (b) housing association;
-- src:1881 | (c) registered charity; or
-- src:1882 | (d) voluntary organisation.
@ref Sch 1 para 3A(6) "relevant body" (src:1878-1882)
DECLARE `Provider of accommodation that may be a relevant body` HAS
    `the provider as a possible local authority`                                                               IS A `Body that may be a local authority`
    `council for a county in England for each part of which there is a district council`                       IS A BOOLEAN
    `housing association`                                                                                      IS A BOOLEAN
    `the provider as a possible registered charity`                                                            IS A `Charity that may be a registered charity`
    `the provider as a possible voluntary organisation`                                                        IS A `Body that may be a voluntary organisation`

-- src:1878 | “relevant body” means a—
-- src:1879 | (a) council for a county in England for each part of which there is a district council;
-- src:1880 | (b) housing association;
-- src:1881 | (c) registered charity; or
-- src:1882 | (d) voluntary organisation.
@ref Sch 1 para 3A(6) "relevant body" (src:1878-1882)
GIVEN provider IS A `Provider of accommodation that may be a relevant body`
GIVETH A BOOLEAN
`Sch 1 para 3A(6) — relevant body` provider MEANS
    (provider's `council for a county in England for each part of which there is a district council`)
    OR (provider's `housing association`)
    OR (`Sch 1 para 1 — registered charity` (provider's `the provider as a possible registered charity`))
    OR (`Sch 1 para 1 — voluntary organisation` (provider's `the provider as a possible voluntary organisation`))

-- Paragraph 3A: accommodation specified in sub-paragraphs (2) to (5).
-- src:1864 | (1) The accommodation referred to in paragraph 3(h) is accommodation to which one or more of the following sub-paragraphs applies.
-- src:1865 | (2) This sub-paragraph applies to accommodation which is exempt accommodation.
-- src:1866 | (3) This sub-paragraph applies to accommodation—
-- src:1867 | (a) which is provided by a relevant body;
-- src:1868 | (b) into which the claimant has been admitted in order to meet a need for care, support or supervision; and
-- src:1869 | (c) where the claimant receives care, support or supervision.
-- src:1870 | (4) This sub-paragraph applies to accommodation which—
-- src:1871 | (a) is provided by a local authority or a relevant body to the claimant because the claimant has left the home as a result of domestic violence; and
-- src:1872 | (b) consists of a building, or part of a building, which is used wholly or mainly for the non-permanent accommodation of persons who have left their homes as a result of domestic violence.
-- src:1873 | (5) This sub-paragraph applies to accommodation—
-- src:1874 | (a) which would be a hostel within the meaning of paragraph 29(10) (renters excepted form shared accommodation) of Schedule 4 (housing costs element for renters) but for it being owned or managed by a local authority; and
-- src:1875 | (b) where the claimant receives care, support or supervision.
@ref Sch 1 para 3A (src:1864-1875)
DECLARE `Accommodation that may be specified in paragraph 3A` HAS
    `the accommodation as it is looked at in the Schedule 1 tests`                                             IS A `Accommodation in the Schedule 1 tests`
    `the provider`                                                                                             IS A `Provider of accommodation that may be a relevant body`
    `the claimant has been admitted into the accommodation in order to meet a need for care, support or supervision`  IS A BOOLEAN
    `the claimant receives care, support or supervision`                                                       IS A BOOLEAN
    `the accommodation is provided to the claimant because the claimant has left the home as a result of domestic violence`  IS A BOOLEAN
    `the accommodation consists of a building, or part of a building, which is used wholly or mainly for the non-permanent accommodation of persons who have left their homes as a result of domestic violence`  IS A BOOLEAN
    `the accommodation as a building that may be a hostel`                                                     IS A `Building that may be a hostel`

-- src:1865 | (2) This sub-paragraph applies to accommodation which is exempt accommodation.
@ref Sch 1 para 3A(2) (src:1865)
GIVEN accommodation IS A `Accommodation that may be specified in paragraph 3A`
GIVETH A BOOLEAN
`Sch 1 para 3A(2) — exempt accommodation` accommodation MEANS
    (accommodation's `the accommodation as it is looked at in the Schedule 1 tests`)'s `exempt accommodation`

-- src:1866 | (3) This sub-paragraph applies to accommodation—
-- src:1867 | (a) which is provided by a relevant body;
-- src:1868 | (b) into which the claimant has been admitted in order to meet a need for care, support or supervision; and
-- src:1869 | (c) where the claimant receives care, support or supervision.
@ref Sch 1 para 3A(3) (src:1866-1869)
GIVEN accommodation IS A `Accommodation that may be specified in paragraph 3A`
GIVETH A BOOLEAN
`Sch 1 para 3A(3) — accommodation provided by a relevant body for care, support or supervision` accommodation MEANS
    (`Sch 1 para 3A(6) — relevant body` (accommodation's `the provider`))
    AND (accommodation's `the claimant has been admitted into the accommodation in order to meet a need for care, support or supervision`)
    AND (accommodation's `the claimant receives care, support or supervision`)

-- src:1871 | (a) is provided by a local authority or a relevant body to the claimant because the claimant has left the home as a result of domestic violence; and
@ref Sch 1 para 3A(4)(a) (src:1871)
GIVEN accommodation IS A `Accommodation that may be specified in paragraph 3A`
GIVETH A BOOLEAN
`Sch 1 para 3A(4)(a) — provided by a local authority or a relevant body` accommodation MEANS
    (`reg 2 — local authority` ((accommodation's `the provider`)'s `the provider as a possible local authority`))
    OR (`Sch 1 para 3A(6) — relevant body` (accommodation's `the provider`))

-- src:1870 | (4) This sub-paragraph applies to accommodation which—
-- src:1871 | (a) is provided by a local authority or a relevant body to the claimant because the claimant has left the home as a result of domestic violence; and
-- src:1872 | (b) consists of a building, or part of a building, which is used wholly or mainly for the non-permanent accommodation of persons who have left their homes as a result of domestic violence.
@ref Sch 1 para 3A(4) (src:1870-1872)
GIVEN accommodation IS A `Accommodation that may be specified in paragraph 3A`
GIVETH A BOOLEAN
`Sch 1 para 3A(4) — accommodation for a person who has left home as a result of domestic violence` accommodation MEANS
    (`Sch 1 para 3A(4)(a) — provided by a local authority or a relevant body` accommodation)
    AND (accommodation's `the accommodation is provided to the claimant because the claimant has left the home as a result of domestic violence`)
    AND (accommodation's `the accommodation consists of a building, or part of a building, which is used wholly or mainly for the non-permanent accommodation of persons who have left their homes as a result of domestic violence`)

-- Paragraph 3A(5): a building that would be a hostel within Schedule 4 paragraph 29(10) but for being owned or managed by a local authority.
-- The building is not a hostel on that test; it satisfies the test once a local authority counts as a provider of social housing.
-- src:1873 | (5) This sub-paragraph applies to accommodation—
-- src:1874 | (a) which would be a hostel within the meaning of paragraph 29(10) (renters excepted form shared accommodation) of Schedule 4 (housing costs element for renters) but for it being owned or managed by a local authority; and
-- src:1875 | (b) where the claimant receives care, support or supervision.
@ref Sch 1 para 3A(5) (src:1873-1875)
GIVEN accommodation IS A `Accommodation that may be specified in paragraph 3A`
GIVETH A BOOLEAN
`Sch 1 para 3A(5)(a) — would be a hostel but for being owned or managed by a local authority` accommodation MEANS
    (`Sch 4 para 29(10) — hostel, limb (a)` (accommodation's `the accommodation as a building that may be a hostel`))
    AND (NOT (`Sch 1 para 1 — care home` ((accommodation's `the accommodation as a building that may be a hostel`)'s `the building as possible care home premises`)))
    AND (`Sch 4 para 2 — provider of social housing` ((accommodation's `the accommodation as a building that may be a hostel`)'s `the owner or manager as a possible provider of social housing`))
    AND (NOT (`Sch 4 para 29(10) — hostel` (accommodation's `the accommodation as a building that may be a hostel`)))

-- src:1873 | (5) This sub-paragraph applies to accommodation—
-- src:1874 | (a) which would be a hostel within the meaning of paragraph 29(10) (renters excepted form shared accommodation) of Schedule 4 (housing costs element for renters) but for it being owned or managed by a local authority; and
-- src:1875 | (b) where the claimant receives care, support or supervision.
@ref Sch 1 para 3A(5) (src:1873-1875)
GIVEN accommodation IS A `Accommodation that may be specified in paragraph 3A`
GIVETH A BOOLEAN
`Sch 1 para 3A(5) — a building that would be a hostel but for local authority ownership, where care is received` accommodation MEANS
    (`Sch 1 para 3A(5)(a) — would be a hostel but for being owned or managed by a local authority` accommodation)
    AND (accommodation's `the claimant receives care, support or supervision`)

-- src:1863 | 3A Specified accommodation
-- src:1864 | (1) The accommodation referred to in paragraph 3(h) is accommodation to which one or more of the following sub-paragraphs applies.
@ref Sch 1 para 3A(1) (src:1863-1864)
GIVEN accommodation IS A `Accommodation that may be specified in paragraph 3A`
GIVETH A BOOLEAN
`Sch 1 para 3A(1) — accommodation specified in paragraph 3A` accommodation MEANS
    (`Sch 1 para 3A(2) — exempt accommodation` accommodation)
    OR (`Sch 1 para 3A(3) — accommodation provided by a relevant body for care, support or supervision` accommodation)
    OR (`Sch 1 para 3A(4) — accommodation for a person who has left home as a result of domestic violence` accommodation)
    OR (`Sch 1 para 3A(5) — a building that would be a hostel but for local authority ownership, where care is received` accommodation)

-- ---------------------------------------------------------------------------------------------------------
-- Paragraph 3B: temporary accommodation, Case 1 (rent payable to a local authority) and Case 2 (rent payable to a provider of social housing
-- that is not a local authority, which provides under arrangements made with it by a local authority).
-- "Paragraph (3)(i)" in sub-paragraph (1) is read as paragraph 3(i) (fork U3-F4).
-- src:1884 | (1) The accommodation referred to in paragraph (3)(i) is accommodation which falls within Case 1 or Case 2.
-- src:1885 | (2) Case 1 is where—
-- src:1886 | (a) rent payments are payable to a local authority;
-- src:1887 | (b) the local authority makes the accommodation available to the renter—
-- src:1888 | (i) to discharge any of the local authority's functions under Part II of the Housing (Scotland) Act 1987 , Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014 , or
-- src:1889 | (ii) to prevent the person being or becoming homeless within the meaning of Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014; and
-- src:1890 | (c) the accommodation is not exempt accommodation.
-- src:1891 | (3) Case 2 is where—
-- src:1892 | (a) rent payments are payable to a provider of social housing other than a local authority;
-- src:1893 | (b) that provider makes the accommodation available to the renter in pursuance of arrangements made with it by a local authority—
-- src:1894 | (i) to discharge any of the local authority's functions under Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014, or
-- src:1895 | (ii) to prevent the person being or becoming homeless within the meaning of Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014; and
-- src:1896 | (c) the accommodation is not exempt accommodation.
-- src:1897 | (4) Sub-paragraph (1) applies irrespective of whether the renter is also liable to make service charge payments.
-- src:1898 | (5) In sub-paragraph (3), “provider of social housing” has the meaning given in paragraph 2 of Schedule 4.
@ref Sch 1 para 3B (src:1884-1898)
DECLARE `Accommodation that may be temporary accommodation` HAS
    `the landlord that rent payments are payable to`                                                           IS A `Landlord that may be a provider of social housing`
    `the accommodation is exempt accommodation`                                                                IS A BOOLEAN
    `the accommodation is made available to the renter to discharge any of the local authority's functions under Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014`  IS A BOOLEAN
    `the accommodation is made available to the renter to prevent the person being or becoming homeless within the meaning of Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014`  IS A BOOLEAN
    `the renter is also liable to make service charge payments`                                                IS A BOOLEAN

-- src:1885 | (2) Case 1 is where—
-- src:1886 | (a) rent payments are payable to a local authority;
-- src:1887 | (b) the local authority makes the accommodation available to the renter—
-- src:1888 | (i) to discharge any of the local authority's functions under Part II of the Housing (Scotland) Act 1987 , Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014 , or
-- src:1889 | (ii) to prevent the person being or becoming homeless within the meaning of Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014; and
-- src:1890 | (c) the accommodation is not exempt accommodation.
@ref Sch 1 para 3B(2) (src:1885-1890)
GIVEN accommodation IS A `Accommodation that may be temporary accommodation`
GIVETH A BOOLEAN
`Sch 1 para 3B(2) — Case 1` accommodation MEANS
    (`reg 2 — local authority` ((accommodation's `the landlord that rent payments are payable to`)'s `the landlord as a possible local authority`))
    AND ((accommodation's `the accommodation is made available to the renter to discharge any of the local authority's functions under Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014`) OR (accommodation's `the accommodation is made available to the renter to prevent the person being or becoming homeless within the meaning of Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014`))
    AND (NOT (accommodation's `the accommodation is exempt accommodation`))

-- src:1891 | (3) Case 2 is where—
-- src:1892 | (a) rent payments are payable to a provider of social housing other than a local authority;
-- src:1893 | (b) that provider makes the accommodation available to the renter in pursuance of arrangements made with it by a local authority—
-- src:1894 | (i) to discharge any of the local authority's functions under Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014, or
-- src:1895 | (ii) to prevent the person being or becoming homeless within the meaning of Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014; and
-- src:1896 | (c) the accommodation is not exempt accommodation.
@ref Sch 1 para 3B(3) (src:1891-1896)
GIVEN accommodation IS A `Accommodation that may be temporary accommodation`
GIVETH A BOOLEAN
`Sch 1 para 3B(3) — Case 2` accommodation MEANS
    (`Sch 4 para 2 — provider of social housing` (accommodation's `the landlord that rent payments are payable to`))
    AND (NOT (`reg 2 — local authority` ((accommodation's `the landlord that rent payments are payable to`)'s `the landlord as a possible local authority`)))
    AND ((accommodation's `the accommodation is made available to the renter to discharge any of the local authority's functions under Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014`) OR (accommodation's `the accommodation is made available to the renter to prevent the person being or becoming homeless within the meaning of Part II of the Housing (Scotland) Act 1987, Part VII of the Housing Act 1996 or Part 2 of the Housing (Wales) Act 2014`))
    AND (NOT (accommodation's `the accommodation is exempt accommodation`))

-- Paragraph 3B(1) and (4): Case 1 or Case 2, whether or not the renter is also liable to make service charge payments (which the rule does not read).
-- src:1884 | (1) The accommodation referred to in paragraph (3)(i) is accommodation which falls within Case 1 or Case 2.
-- src:1897 | (4) Sub-paragraph (1) applies irrespective of whether the renter is also liable to make service charge payments.
@ref Sch 1 para 3B(1) and (4) (src:1884) (src:1897)
GIVEN accommodation IS A `Accommodation that may be temporary accommodation`
GIVETH A BOOLEAN
`Sch 1 para 3B(1) — temporary accommodation` accommodation MEANS
    (`Sch 1 para 3B(2) — Case 1` accommodation)
    OR (`Sch 1 para 3B(3) — Case 2` accommodation)

-- ---------------------------------------------------------------------------------------------------------
-- Paragraph 8: the four additional conditions on service charge payments in the social rented sector and for owner-occupiers.
-- src:1927 | (1) This paragraph applies for the purposes of calculating the amount of housing costs element to be included in a claimant's award of universal credit but only as regards calculations made under—
-- src:1928 | (a) Part 5 of Schedule 4 (social rented sector...); or
-- src:1929 | (b) Schedule 5 (housing costs element for owner-occupiers).
@ref Sch 1 para 8(1) (src:1927-1929)
DECLARE `Service charge payment, as paragraph 8 looks at it` HAS
    `the calculation is made under Part 5 of Schedule 4 or under Schedule 5`                                    IS A BOOLEAN
    `making the payments is a condition on which the right to occupy the accommodation depends`                 IS A BOOLEAN
    `external cleaning of windows`                                                                              IS A BOOLEAN
    `the windows are in upper floors of a multi-storey building`                                                IS A BOOLEAN
    `other internal or external maintenance or repair of the accommodation`                                     IS A BOOLEAN
    `the payments are separately identifiable as relating to such maintenance or repair`                        IS A BOOLEAN
    `the payments are payable by a claimant who occupies accommodation under a shared ownership tenancy`        IS A BOOLEAN
    `any amount of housing costs element in respect of those payments would fall to be calculated under Schedule 5`  IS A BOOLEAN
    `ongoing maintenance or cleaning of, and the supply of water, fuel or any other commodity relating to the common use of, internal or external areas, including areas for reasonable facilities`  IS A BOOLEAN
    `provision, ongoing maintenance, cleaning or repair in connection with basic services generally available to all persons living in the accommodation`  IS A BOOLEAN
    `payments specific to the particular accommodation occupied by the claimant for the use of essential items contained in it`  IS A BOOLEAN
    `the costs and charges to which the payments relate are of a reasonable amount`                             IS A BOOLEAN
    `the costs and charges relate to services or facilities of such description as it is reasonable to provide`  IS A BOOLEAN
    `the payments relate to the costs of or charges for providing services or facilities in respect of which payments out of public funds might otherwise be made`  IS A BOOLEAN
    `the payments are in connection with the use of an asset and result in the transfer of the asset or any interest in it`  IS A BOOLEAN
    `the payments relate to the costs of or charges for providing food, medical services or personal services (including personal care) of any description`  IS A BOOLEAN

-- src:1931 | (3) The first condition is that making the payments is a condition on which the right to occupy the accommodation depends.
@ref Sch 1 para 8(3) (src:1931)
GIVEN payment IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A BOOLEAN
`Sch 1 para 8(3) — the first condition` payment MEANS
    payment's `making the payments is a condition on which the right to occupy the accommodation depends`

-- The four categories of the second condition. "Payments to the extent that" is read as: the payment under test is the part that fits (fork U3-F13).
-- src:1935 | (a) the external cleaning of windows, but only in relation to upper floors of a multi-storey building;
@ref Sch 1 para 8(4) Category A(a) (src:1935)
GIVEN payment IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A BOOLEAN
`Sch 1 para 8(4) — Category A(a), external cleaning of windows` payment MEANS
    (payment's `external cleaning of windows`)
    AND (payment's `the windows are in upper floors of a multi-storey building`)

-- src:1936 | (b) other internal or external maintenance or repair of the accommodation, but only where the payments are separately identifiable as relating to such maintenance or repair and payable by—
-- src:1937 | (i) a claimant who occupies accommodation under a shared ownership tenancy, or
-- src:1938 | (ii) a claimant in whose case any amount of housing costs element to be included in their award in respect of those payments would fall to be calculated under Schedule 5.
@ref Sch 1 para 8(4) Category A(b) (src:1936-1938)
GIVEN payment IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A BOOLEAN
`Sch 1 para 8(4) — Category A(b), other maintenance or repair` payment MEANS
    (payment's `other internal or external maintenance or repair of the accommodation`)
    AND (payment's `the payments are separately identifiable as relating to such maintenance or repair`)
    AND (    (payment's `the payments are payable by a claimant who occupies accommodation under a shared ownership tenancy`)
          OR (payment's `any amount of housing costs element in respect of those payments would fall to be calculated under Schedule 5`))

-- src:1935 | (a) the external cleaning of windows, but only in relation to upper floors of a multi-storey building;
-- src:1936 | (b) other internal or external maintenance or repair of the accommodation, but only where the payments are separately identifiable as relating to such maintenance or repair and payable by—
-- src:1937 | (i) a claimant who occupies accommodation under a shared ownership tenancy, or
-- src:1938 | (ii) a claimant in whose case any amount of housing costs element to be included in their award in respect of those payments would fall to be calculated under Schedule 5.
@ref Sch 1 para 8(4) Category A (src:1935-1938)
GIVEN payment IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A BOOLEAN
`Sch 1 para 8(4) — Category A, payments to maintain the general standard of the accommodation` payment MEANS
    (`Sch 1 para 8(4) — Category A(a), external cleaning of windows` payment)
    OR (`Sch 1 para 8(4) — Category A(b), other maintenance or repair` payment)

-- src:1939 | Category B - Payments for the general upkeep of areas of communal use
-- src:1940 | Payments within this category are for ongoing maintenance or cleaning of, and the supply of water, fuel or any other commodity relating to the common use of, internal or external areas, including areas for reasonable facilities (such as laundry rooms or children's play areas).
@ref Sch 1 para 8(4) Category B (src:1939-1940)
GIVEN payment IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A BOOLEAN
`Sch 1 para 8(4) — Category B, payments for the general upkeep of areas of communal use` payment MEANS
    payment's `ongoing maintenance or cleaning of, and the supply of water, fuel or any other commodity relating to the common use of, internal or external areas, including areas for reasonable facilities`

-- src:1941 | Category C - Payments in respect of basic communal services
-- src:1942 | Payments within this category are for provision, ongoing maintenance, cleaning or repair in connection with basic services generally available to all persons living in the accommodation (such as refuse collection, communal lifts, secure building access or wireless or television aerials to receive a service free of charge).
@ref Sch 1 para 8(4) Category C (src:1941-1942)
GIVEN payment IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A BOOLEAN
`Sch 1 para 8(4) — Category C, payments in respect of basic communal services` payment MEANS
    payment's `provision, ongoing maintenance, cleaning or repair in connection with basic services generally available to all persons living in the accommodation`

-- src:1943 | Category D – Accommodation-specific charges
-- src:1944 | Payments within this category are specific to the particular accommodation occupied by a claimant but are limited to payments for the use of essential items contained in it (such as furniture or domestic appliances).
@ref Sch 1 para 8(4) Category D (src:1943-1944)
GIVEN payment IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A BOOLEAN
`Sch 1 para 8(4) — Category D, accommodation-specific charges` payment MEANS
    payment's `payments specific to the particular accommodation occupied by the claimant for the use of essential items contained in it`

-- src:1932 | (4) The second condition is that the payments fall within one or more of the following categories:
-- src:1933 | Category A - Payments to maintain the general standard of the accommodation
-- src:1934 | Payments within this category are for—
-- src:1935 | (a) the external cleaning of windows, but only in relation to upper floors of a multi-storey building;
-- src:1936 | (b) other internal or external maintenance or repair of the accommodation, but only where the payments are separately identifiable as relating to such maintenance or repair and payable by—
-- src:1937 | (i) a claimant who occupies accommodation under a shared ownership tenancy, or
-- src:1938 | (ii) a claimant in whose case any amount of housing costs element to be included in their award in respect of those payments would fall to be calculated under Schedule 5.
-- src:1939 | Category B - Payments for the general upkeep of areas of communal use
-- src:1940 | Payments within this category are for ongoing maintenance or cleaning of, and the supply of water, fuel or any other commodity relating to the common use of, internal or external areas, including areas for reasonable facilities (such as laundry rooms or children's play areas).
-- src:1941 | Category C - Payments in respect of basic communal services
-- src:1942 | Payments within this category are for provision, ongoing maintenance, cleaning or repair in connection with basic services generally available to all persons living in the accommodation (such as refuse collection, communal lifts, secure building access or wireless or television aerials to receive a service free of charge).
-- src:1943 | Category D – Accommodation-specific charges
-- src:1944 | Payments within this category are specific to the particular accommodation occupied by a claimant but are limited to payments for the use of essential items contained in it (such as furniture or domestic appliances).
@ref Sch 1 para 8(4) (src:1932-1944)
GIVEN payment IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A BOOLEAN
`Sch 1 para 8(4) — the second condition` payment MEANS
    (`Sch 1 para 8(4) — Category A, payments to maintain the general standard of the accommodation` payment)
    OR (`Sch 1 para 8(4) — Category B, payments for the general upkeep of areas of communal use` payment)
    OR (`Sch 1 para 8(4) — Category C, payments in respect of basic communal services` payment)
    OR (`Sch 1 para 8(4) — Category D, accommodation-specific charges` payment)

-- src:1945 | (5) The third condition is that the costs and charges to which the payments relate are of a reasonable amount and relate to services or facilities of such description as it is reasonable to provide.
@ref Sch 1 para 8(5) (src:1945)
GIVEN payment IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A BOOLEAN
`Sch 1 para 8(5) — the third condition` payment MEANS
    (payment's `the costs and charges to which the payments relate are of a reasonable amount`)
    AND (payment's `the costs and charges relate to services or facilities of such description as it is reasonable to provide`)

-- src:1946 | (6) The fourth condition is that the payments are none of the following—
-- src:1947 | (a) payments to the extent that they relate to the costs of or charges for providing services or facilities in respect of which payments out of public funds might otherwise be made (irrespective of whether the claimant has any entitlement to payments so made);
-- src:1948 | (b) payments in connection with the use of an asset which result in the transfer of the asset or any interest in it;
-- src:1949 | (c) payments to the extent that they relate to the costs of or charges for providing food, medical services or personal services (including personal care) of any description.
@ref Sch 1 para 8(6) (src:1946-1949)
GIVEN payment IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A BOOLEAN
`Sch 1 para 8(6) — the fourth condition` payment MEANS
    NOT (    (payment's `the payments relate to the costs of or charges for providing services or facilities in respect of which payments out of public funds might otherwise be made`)
          OR (payment's `the payments are in connection with the use of an asset and result in the transfer of the asset or any interest in it`)
          OR (payment's `the payments relate to the costs of or charges for providing food, medical services or personal services (including personal care) of any description`))

-- src:1930 | (2) The following are the conditions referred to in paragraph 7(1)(c).
@ref Sch 1 para 8(2) (src:1930)
GIVEN payment IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A BOOLEAN
`Sch 1 para 8(2) — all four conditions are met` payment MEANS
    (`Sch 1 para 8(3) — the first condition` payment)
    AND (`Sch 1 para 8(4) — the second condition` payment)
    AND (`Sch 1 para 8(5) — the third condition` payment)
    AND (`Sch 1 para 8(6) — the fourth condition` payment)

-- Paragraph 7(1)(c): in a case to which paragraph 8 applies, the payments meet all of the conditions in paragraph 8.
-- src:1911 | (c) in any case to which paragraph 8 applies, meet all of the conditions set out in that paragraph.
-- src:1927 | (1) This paragraph applies for the purposes of calculating the amount of housing costs element to be included in a claimant's award of universal credit but only as regards calculations made under—
-- src:1928 | (a) Part 5 of Schedule 4 (social rented sector...); or
-- src:1929 | (b) Schedule 5 (housing costs element for owner-occupiers).
@ref Sch 1 para 7(1)(c) (src:1911) (src:1927-1929)
GIVEN payment IS A `Service charge payment, as paragraph 8 looks at it`
GIVETH A BOOLEAN
`Sch 1 para 7(1)(c) — in any case to which paragraph 8 applies, the payments meet all of its conditions` payment MEANS
    (NOT (payment's `the calculation is made under Part 5 of Schedule 4 or under Schedule 5`))
    OR (`Sch 1 para 8(2) — all four conditions are met` payment)

-- ---------------------------------------------------------------------------------------------------------
-- Paragraph 7(2) to (4): what falls within the meaning of a service charge payment, what is excluded, and what is irrelevant.
-- src:1912 | (2) The payments falling within this sub-paragraph are payments of amounts which are, in whole or in part—
-- src:1913 | (a) payments of, or towards, the costs of or charges for providing services or facilities for the use or benefit of persons occupying accommodation; or
-- src:1914 | (b) fairly attributable to the costs of or charges for providing such services or facilities connected with accommodation as are available for the use or benefit of persons occupying accommodation.
@ref Sch 1 para 7(2) (src:1912-1914)
DECLARE `Payment that may be a service charge payment` HAS
    `the payment is, in whole or in part, a payment of, or towards, the costs of or charges for providing services or facilities for the use or benefit of persons occupying accommodation`  IS A BOOLEAN
    `the payment is, in whole or in part, fairly attributable to the costs of or charges for providing such services or facilities connected with accommodation as are available for the use or benefit of persons occupying accommodation`  IS A BOOLEAN
    `a qualifying loan within the meaning of regulation 2 of the Loans for Mortgage Interest Regulations 2017 was taken out for the purposes of making the payments`  IS A BOOLEAN
    `the accommodation occupied by the person for whose use or benefit the services or facilities are provided`  IS A `Accommodation in the Schedule 1 tests`
    -- sub-paragraph (4): none of these three facts is read by any rule
    `the payments are separately identified as relating to the costs or charges referred to in sub-paragraph (2)`  IS A BOOLEAN
    `the payments are made in addition to or as part of any other payment`                                      IS A BOOLEAN
    `the payments are made under the same agreement as that under which the accommodation is occupied`          IS A BOOLEAN
    `facts for paragraph 8`                                                                                     IS A `Service charge payment, as paragraph 8 looks at it`

-- src:1912 | (2) The payments falling within this sub-paragraph are payments of amounts which are, in whole or in part—
-- src:1913 | (a) payments of, or towards, the costs of or charges for providing services or facilities for the use or benefit of persons occupying accommodation; or
-- src:1914 | (b) fairly attributable to the costs of or charges for providing such services or facilities connected with accommodation as are available for the use or benefit of persons occupying accommodation.
@ref Sch 1 para 7(2) (src:1912-1914)
GIVEN payment IS A `Payment that may be a service charge payment`
GIVETH A BOOLEAN
`Sch 1 para 7(2) — the payment falls within sub-paragraph (2)` payment MEANS
    (payment's `the payment is, in whole or in part, a payment of, or towards, the costs of or charges for providing services or facilities for the use or benefit of persons occupying accommodation`)
    OR (payment's `the payment is, in whole or in part, fairly attributable to the costs of or charges for providing such services or facilities connected with accommodation as are available for the use or benefit of persons occupying accommodation`)

-- Paragraph 7(3)(b): the services or facilities are for a person occupying a tent, approved premises, a care home or exempt accommodation.
-- src:1917 | (b) the services or facilities to which the payments relate are provided for the use or benefit of any person occupying—
-- src:1918 | (i) a tent,
-- src:1919 | (ii) approved premises,
-- src:1920 | (iii) a care home, or
-- src:1921 | (iv) exempt accommodation.
@ref Sch 1 para 7(3)(b) (src:1917-1921)
GIVEN accommodation IS A `Accommodation in the Schedule 1 tests`
GIVETH A BOOLEAN
`Sch 1 para 7(3)(b) — the occupant is in a tent, approved premises, a care home or exempt accommodation` accommodation MEANS
    (`Sch 1 para 1 — tent` (accommodation's structure))
    OR (accommodation's `approved premises`)
    OR (`Sch 1 para 1 — care home` (accommodation's `care home premises`))
    OR (accommodation's `exempt accommodation`)

-- src:1915 | (3) Payments are excluded by this sub-paragraph where—
-- src:1916 | (a) a qualifying loan within the meaning of regulation 2 of the Loans for Mortgage Interest Regulations 2017 was taken out for the purposes of making the payments; or
-- src:1917 | (b) the services or facilities to which the payments relate are provided for the use or benefit of any person occupying—
-- src:1918 | (i) a tent,
-- src:1919 | (ii) approved premises,
-- src:1920 | (iii) a care home, or
-- src:1921 | (iv) exempt accommodation.
@ref Sch 1 para 7(3) (src:1915-1921)
GIVEN payment IS A `Payment that may be a service charge payment`
GIVETH A BOOLEAN
`Sch 1 para 7(3) — the payment is excluded by sub-paragraph (3)` payment MEANS
    (payment's `a qualifying loan within the meaning of regulation 2 of the Loans for Mortgage Interest Regulations 2017 was taken out for the purposes of making the payments`)
    OR (`Sch 1 para 7(3)(b) — the occupant is in a tent, approved premises, a care home or exempt accommodation` (payment's `the accommodation occupied by the person for whose use or benefit the services or facilities are provided`))

-- src:1908 | (1) “Service charge payments” are payments which—
-- src:1909 | (a) fall within sub-paragraph (2);
-- src:1910 | (b) are not excluded by sub-paragraph (3); and
-- src:1911 | (c) in any case to which paragraph 8 applies, meet all of the conditions set out in that paragraph.
@ref Sch 1 para 7(1) (src:1908-1911)
GIVEN payment IS A `Payment that may be a service charge payment`
GIVETH A BOOLEAN
`Sch 1 para 7(1) — a service charge payment` payment MEANS
    (`Sch 1 para 7(2) — the payment falls within sub-paragraph (2)` payment)
    AND (NOT (`Sch 1 para 7(3) — the payment is excluded by sub-paragraph (3)` payment))
    AND (`Sch 1 para 7(1)(c) — in any case to which paragraph 8 applies, the payments meet all of its conditions` (payment's `facts for paragraph 8`))

-- Paragraph 8(7): a payment that is not a service charge payment only because it fails a condition in paragraph 8(3) to (6) is treated as one
-- for the purposes of paragraph 3(g) (and paragraph 4(2), which shows dots in this text: fork U3-F3). It is therefore excluded from being a rent
-- payment and is not a service charge payment either.
-- src:1950 | (7) Payments that are not service charge payments within the meaning of paragraph 7 by reason only that they fail to meet any of the conditions set out in sub-paragraphs (3) to (6) are nevertheless to be treated as if they were such service charge payments for the purposes of paragraphs 3(g) and 4(2).
@ref Sch 1 para 8(7) (src:1950)
GIVEN payment IS A `Payment that may be a service charge payment`
GIVETH A BOOLEAN
`Sch 1 para 8(7) — the payment is treated as a service charge payment for the purposes of paragraph 3(g)` payment MEANS
    (`Sch 1 para 7(2) — the payment falls within sub-paragraph (2)` payment)
    AND (NOT (`Sch 1 para 7(3) — the payment is excluded by sub-paragraph (3)` payment))

-- ---------------------------------------------------------------------------------------------------------
-- Paragraph 3: payments excluded from being rent payments.
-- src:1853 | The following are excluded from being “rent payments”—
-- src:1854 | (a) payments of ground rent;
-- src:1855 | (b) payments in respect of a tent or the site on which a tent stands;
-- src:1856 | (c) payments in respect of approved premises;
-- src:1857 | (d) payments in respect of a care home;
-- src:1858 | (e) . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .
-- src:1859 | (f) payments which are owner-occupier payments within the meaning of Schedule 1 of the Loans for Mortgage Regulations 2017;
-- src:1860 | (g) payments which are service charge payments within the meaning of paragraph 7;
-- src:1861 | (h) payments in respect of accommodation specified in paragraph 3A;
-- src:1862 | (i) payments in respect of accommodation specified in paragraph 3B.
@ref Sch 1 para 3 (src:1853-1862)
DECLARE `Payment in respect of accommodation` HAS
    `description`                                                                                               IS A `Description of a payment for accommodation`
    `the accommodation`                                                                                         IS A `Accommodation in the Schedule 1 tests`
    `ground rent`                                                                                               IS A BOOLEAN
    `the payment is in respect of the site on which a tent stands`                                              IS A BOOLEAN
    `owner-occupier payment within the meaning of Schedule 1 of the Loans for Mortgage Regulations 2017`        IS A BOOLEAN
    `the payment as a possible service charge payment`                                                          IS A `Payment that may be a service charge payment`
    `the accommodation as it may be specified in paragraph 3A`                                                  IS A `Accommodation that may be specified in paragraph 3A`
    `the accommodation as it may be temporary accommodation`                                                    IS A `Accommodation that may be temporary accommodation`

-- src:1853 | The following are excluded from being “rent payments”—
-- src:1854 | (a) payments of ground rent;
-- src:1855 | (b) payments in respect of a tent or the site on which a tent stands;
-- src:1856 | (c) payments in respect of approved premises;
-- src:1857 | (d) payments in respect of a care home;
-- src:1858 | (e) . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .
-- src:1859 | (f) payments which are owner-occupier payments within the meaning of Schedule 1 of the Loans for Mortgage Regulations 2017;
-- src:1860 | (g) payments which are service charge payments within the meaning of paragraph 7;
-- src:1861 | (h) payments in respect of accommodation specified in paragraph 3A;
-- src:1862 | (i) payments in respect of accommodation specified in paragraph 3B.
@ref Sch 1 para 3 (src:1853-1862)
GIVEN payment IS A `Payment in respect of accommodation`
GIVETH A BOOLEAN
`Sch 1 para 3 — a payment is excluded from being a rent payment` payment MEANS
    (payment's `ground rent`)
    OR (`Sch 1 para 1 — tent` ((payment's `the accommodation`)'s structure))
    OR (payment's `the payment is in respect of the site on which a tent stands`)
    OR ((payment's `the accommodation`)'s `approved premises`)
    OR (`Sch 1 para 1 — care home` ((payment's `the accommodation`)'s `care home premises`))
    OR (payment's `owner-occupier payment within the meaning of Schedule 1 of the Loans for Mortgage Regulations 2017`)
    OR (`Sch 1 para 8(7) — the payment is treated as a service charge payment for the purposes of paragraph 3(g)` (payment's `the payment as a possible service charge payment`))
    OR (`Sch 1 para 3A(1) — accommodation specified in paragraph 3A` (payment's `the accommodation as it may be specified in paragraph 3A`))
    OR (`Sch 1 para 3B(1) — temporary accommodation` (payment's `the accommodation as it may be temporary accommodation`))

-- Paragraph 2: a rent payment is a payment of one of the five descriptions that paragraph 3 does not exclude.
-- src:1844 | “Rent payments” are such of the following as are not excluded by paragraph 3—
@ref Sch 1 para 2 (src:1844)
GIVEN payment IS A `Payment in respect of accommodation`
GIVETH A BOOLEAN
`Sch 1 para 2 — a rent payment` payment MEANS
    (`Sch 1 para 2 — a payment of a description in paragraph 2(a) to (e)` (payment's description))
    AND (NOT (`Sch 1 para 3 — a payment is excluded from being a rent payment` payment))
