#ASSERT `reg 11(4) — paragraph (4) applies` `an absence expected to end on 1 July 2025` `an absence of a mariner`
#ASSERT `reg 11(4) — paragraph (4) applies` `an absence expected to end on 1 July 2025` `an absence of a continental shelf worker`
#ASSERT NOT (`reg 11(4) — paragraph (4) applies` `an absence expected to end on 2 July 2025` `an absence of a mariner`)
#ASSERT NOT (`reg 11(4) — paragraph (4) applies` `an absence expected to end on 1 July 2025` `an absence for treatment`)

-- (4A).
#ASSERT `reg 11(4A) — paragraph (4A) applies` `a person within every limb of paragraph (4A)`
#ASSERT NOT (`reg 11(4A) — paragraph (4A) applies` `a person not present abroad before the advice`)
#ASSERT NOT (`reg 11(4A) — paragraph (4A) applies` `a person to whom no earlier paragraph applied`)
#ASSERT NOT (`reg 11(4A) — paragraph (4A) applies` `a person the Secretary of State is not satisfied about`)
#ASSERT NOT (`reg 11(4A) — paragraph (4A) applies` `a person who entered the country after the advice to leave`)

-- (1) and (4B): the absence is disregarded.
#ASSERT `reg 11 — the temporary absence is disregarded` `an absence expected to end on 1 February 2025` TRUE 1 FALSE FALSE FALSE
#ASSERT NOT (`reg 11 — the temporary absence is disregarded` `an absence expected to end on 2 February 2025` TRUE 1 FALSE FALSE FALSE)
#ASSERT `reg 11 — the temporary absence is disregarded` `an absence expected to end on 1 March 2025` TRUE 2 FALSE FALSE FALSE
#ASSERT NOT (`reg 11 — the temporary absence is disregarded` `an absence expected to end on 2 March 2025` TRUE 2 FALSE FALSE FALSE)
#ASSERT `reg 11 — the temporary absence is disregarded` `an absence expected to end on 2 March 2025` TRUE 1 TRUE FALSE FALSE
#ASSERT `reg 11 — the temporary absence is disregarded` `an absence expected to end on 2 March 2025` TRUE 1 FALSE TRUE FALSE
#ASSERT `reg 11 — the temporary absence is disregarded` `an absence expected to end on 2 July 2025` TRUE 1 FALSE FALSE TRUE
-- The person must have been entitled immediately before the absence began.
#ASSERT NOT (`reg 11 — the temporary absence is disregarded` `an absence expected to end on 1 February 2025` FALSE 1 TRUE TRUE TRUE)
-- (4B) The total period disregarded does not exceed 6 months: an absence that has lasted to 1 July is still disregarded, to 2 July is not.
#ASSERT `reg 11 — the temporary absence is disregarded` `an absence that has lasted to 1 July 2025` TRUE 1 TRUE FALSE FALSE
#ASSERT NOT (`reg 11 — the temporary absence is disregarded` `an absence that has lasted to 2 July 2025` TRUE 1 TRUE FALSE FALSE)
#ASSERT NOT (`reg 11 — the temporary absence is disregarded` `an absence that has lasted to 2 July 2025` TRUE 1 FALSE FALSE TRUE)
