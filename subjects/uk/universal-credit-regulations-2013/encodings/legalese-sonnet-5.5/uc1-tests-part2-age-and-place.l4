#ASSERT `reg 8(4) — the person is a care leaver` `a Scottish young person under 18 owed advice and assistance who was looked after for 3 months`
#ASSERT NOT (`reg 8(4) — the person is a care leaver` `a Scottish young person under 18 who is looked after but not for 3 months`)
#ASSERT NOT (`reg 8(4) — the person is a care leaver` `a Scottish young person aged 18 who is looked after for 3 months`)
#ASSERT NOT (`reg 8(4) — the person is a care leaver` `a Scottish young person under 18 neither looked after nor owed advice`)

-- Regulation 8(4): confinement.
#ASSERT `reg 8(4) — a confinement` TRUE FALSE
#ASSERT `reg 8(4) — a confinement` FALSE TRUE
#ASSERT NOT (`reg 8(4) — a confinement` FALSE FALSE)

-- Regulation 8(1)(f): pregnancy. The expected week of confinement begins on 1 October 2025; 77 days before is 16 July 2025.
-- The confinement was on 10 October 2025; 105 days after is 23 January 2026.
`a pregnant person due on 1 October 2025` MEANS `Pregnancy of a person` WITH
    `first day of the expected week of confinement, if the person is pregnant` IS JUST (YearMonthDay 2025 10 1)
    `date of confinement, if the person was pregnant and has been confined` IS NOTHING
`a person confined on 10 October 2025` MEANS `Pregnancy of a person` WITH
    `first day of the expected week of confinement, if the person is pregnant` IS NOTHING
    `date of confinement, if the person was pregnant and has been confined` IS JUST (YearMonthDay 2025 10 10)
`a person neither pregnant nor recently confined` MEANS `Pregnancy of a person` WITH
    `first day of the expected week of confinement, if the person is pregnant` IS NOTHING
    `date of confinement, if the person was pregnant and has been confined` IS NOTHING
#ASSERT `reg 8(1)(f) — pregnant or recently confined on a day` `a pregnant person due on 1 October 2025` (YearMonthDay 2025 7 16)
#ASSERT NOT (`reg 8(1)(f) — pregnant or recently confined on a day` `a pregnant person due on 1 October 2025` (YearMonthDay 2025 7 15))
#ASSERT `reg 8(1)(f) — pregnant or recently confined on a day` `a pregnant person due on 1 October 2025` (YearMonthDay 2025 9 30)
-- Still pregnant after the expected week began (fork F-8-OVERDUE).
#ASSERT `reg 8(1)(f) — pregnant or recently confined on a day` `a pregnant person due on 1 October 2025` (YearMonthDay 2025 10 5)
#ASSERT `reg 8(1)(f) — pregnant or recently confined on a day` `a person confined on 10 October 2025` (YearMonthDay 2025 10 10)
#ASSERT `reg 8(1)(f) — pregnant or recently confined on a day` `a person confined on 10 October 2025` (YearMonthDay 2026 1 23)
#ASSERT NOT (`reg 8(1)(f) — pregnant or recently confined on a day` `a person confined on 10 October 2025` (YearMonthDay 2026 1 24))
#ASSERT NOT (`reg 8(1)(f) — pregnant or recently confined on a day` `a person confined on 10 October 2025` (YearMonthDay 2025 10 9))
#ASSERT NOT (`reg 8(1)(f) — pregnant or recently confined on a day` `a person neither pregnant nor recently confined` (YearMonthDay 2025 10 10))

-- Regulation 8(3): without parental support.
`a parent who is impaired` MEANS `Parent of a young person` WITH
    `the parent has a physical or mental impairment` IS TRUE
    `the parent is detained in custody pending trial or sentence upon conviction or under a sentence imposed by a court` IS FALSE
    `the parent is prohibited from entering or re-entering Great Britain` IS FALSE
`a parent who is detained` MEANS `Parent of a young person` WITH
    `the parent has a physical or mental impairment` IS FALSE
    `the parent is detained in custody pending trial or sentence upon conviction or under a sentence imposed by a court` IS TRUE
    `the parent is prohibited from entering or re-entering Great Britain` IS FALSE
`a parent who is prohibited from entering Great Britain` MEANS `Parent of a young person` WITH
    `the parent has a physical or mental impairment` IS FALSE
    `the parent is detained in custody pending trial or sentence upon conviction or under a sentence imposed by a court` IS FALSE
    `the parent is prohibited from entering or re-entering Great Britain` IS TRUE
`a parent who is able to support the person` MEANS `Parent of a young person` WITH
    `the parent has a physical or mental impairment` IS FALSE
    `the parent is detained in custody pending trial or sentence upon conviction or under a sentence imposed by a court` IS FALSE
    `the parent is prohibited from entering or re-entering Great Britain` IS FALSE
#ASSERT `reg 8(3)(c) — the parent is unable to support the person financially` `a parent who is impaired`
#ASSERT `reg 8(3)(c) — the parent is unable to support the person financially` `a parent who is detained`
#ASSERT `reg 8(3)(c) — the parent is unable to support the person financially` `a parent who is prohibited from entering Great Britain`
#ASSERT NOT (`reg 8(3)(c) — the parent is unable to support the person financially` `a parent who is able to support the person`)

GIVEN looked IS A BOOLEAN
      none IS A BOOLEAN
      estranged IS A BOOLEAN
      risk IS A BOOLEAN
      away IS A BOOLEAN
      parents IS A LIST OF `Parent of a young person`
GIVETH A `Young person who may be without parental support`
`test — young person without parental support` looked none estranged risk away parents MEANS
    `Young person who may be without parental support` WITH
        `the person is being looked after by a local authority` IS looked
        `the person has no parent` IS none
        `the person cannot live with their parents because the person is estranged from them` IS estranged
        `the person cannot live with their parents because there is a serious risk to the person's physical or mental health, or that the person would suffer significant harm if the person lived with them` IS risk
        `the person is living away from their parents` IS away
        `the person's parents` IS parents
#ASSERT `reg 8(3) — the person is without parental support` (`test — young person without parental support` FALSE TRUE FALSE FALSE FALSE EMPTY)
#ASSERT NOT (`reg 8(3) — the person is without parental support` (`test — young person without parental support` TRUE TRUE FALSE FALSE FALSE EMPTY))
#ASSERT `reg 8(3) — the person is without parental support` (`test — young person without parental support` FALSE FALSE TRUE FALSE FALSE (LIST `a parent who is able to support the person`))
#ASSERT `reg 8(3) — the person is without parental support` (`test — young person without parental support` FALSE FALSE FALSE TRUE FALSE (LIST `a parent who is able to support the person`))
#ASSERT `reg 8(3) — the person is without parental support` (`test — young person without parental support` FALSE FALSE FALSE FALSE TRUE (LIST `a parent who is impaired`, `a parent who is detained`))
#ASSERT `reg 8(3) — the person is without parental support` (`test — young person without parental support` FALSE FALSE FALSE FALSE TRUE (LIST `a parent who is prohibited from entering Great Britain`))
-- Neither parent is able to support: one able parent is enough to fail (c).
#ASSERT NOT (`reg 8(3) — the person is without parental support` (`test — young person without parental support` FALSE FALSE FALSE FALSE TRUE (LIST `a parent who is impaired`, `a parent who is able to support the person`)))
-- Not living away from the parents.
#ASSERT NOT (`reg 8(3) — the person is without parental support` (`test — young person without parental support` FALSE FALSE FALSE FALSE FALSE (LIST `a parent who is impaired`, `a parent who is detained`)))
#ASSERT NOT (`reg 8(3) — the person is without parental support` (`test — young person without parental support` FALSE FALSE FALSE FALSE FALSE (LIST `a parent who is able to support the person`)))

