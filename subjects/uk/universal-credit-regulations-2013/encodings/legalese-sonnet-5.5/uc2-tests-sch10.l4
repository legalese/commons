IMPORT prelude
IMPORT daydate
IMPORT `uc-core`
IMPORT `uc-core-persons`
IMPORT `uc-core-bodies`
IMPORT `uc2-domain`
IMPORT `uc2-part6-ch3-unearned-income`
IMPORT `uc2-part6-ch1-capital`
IMPORT `uc2-sch10-capital-disregards`

-- Tests of Schedule 10 (capital to be disregarded). Every expected value is worked out by hand from the text and written beside
-- the assertion. The date on which the capital is calculated is 22 October 2026 throughout, unless a test says otherwise.

§ `Helpers: the past periods`

`test six months` MEANS `Time limit` WITH quantity IS 6, unit IS months

-- Six months before 22 October 2026 is 22 April 2026: that day is the last on which an event is still within the past six months
-- (fork F-S10-1: the last day counts). The day before is not.
#ASSERT `Sch 10 helper — an event falls within the past period` (YearMonthDay 2026 4 22) (YearMonthDay 2026 10 22) `test six months`
#ASSERT `Sch 10 helper — an event falls within the past period` (YearMonthDay 2026 4 23) (YearMonthDay 2026 10 22) `test six months`
#ASSERT NOT (`Sch 10 helper — an event falls within the past period` (YearMonthDay 2026 4 21) (YearMonthDay 2026 10 22) `test six months`)
-- An event on the day of calculation is within the period; an event after it is not.
#ASSERT `Sch 10 helper — an event falls within the past period` (YearMonthDay 2026 10 22) (YearMonthDay 2026 10 22) `test six months`
#ASSERT NOT (`Sch 10 helper — an event falls within the past period` (YearMonthDay 2026 10 23) (YearMonthDay 2026 10 22) `test six months`)
-- Twelve months: 22 October 2025 is the last day.
#ASSERT `Sch 10 helper — an event falls within the past period` (YearMonthDay 2025 10 22) (YearMonthDay 2026 10 22) `Sch 10 helper — the period of 12 months`
#ASSERT NOT (`Sch 10 helper — an event falls within the past period` (YearMonthDay 2025 10 21) (YearMonthDay 2026 10 22) `Sch 10 helper — the period of 12 months`)
-- 52 weeks is 364 days: 23 October 2025 plus 364 days is 22 October 2026.
#ASSERT `Sch 10 helper — an event falls within the past period` (YearMonthDay 2025 10 23) (YearMonthDay 2026 10 22) `Sch 10 helper — the period of 52 weeks`
#ASSERT NOT (`Sch 10 helper — an event falls within the past period` (YearMonthDay 2025 10 22) (YearMonthDay 2026 10 22) `Sch 10 helper — the period of 52 weeks`)
-- An event that has not happened is not within any period.
#ASSERT NOT (`Sch 10 helper — an event that may not have happened falls within the past period` NOTHING (YearMonthDay 2026 10 22) `test six months`)
#ASSERT `Sch 10 helper — an event that may not have happened falls within the past period` (JUST (YearMonthDay 2026 6 1)) (YearMonthDay 2026 10 22) `test six months`
-- Regulation 48(2): the Secretary of State extends six months to nine; the paragraph then looks back to 22 January 2026.
#ASSERT NOT (`Sch 10 helper — an event falls within the past period` (YearMonthDay 2026 2 1) (YearMonthDay 2026 10 22) `test six months`)
#ASSERT `Sch 10 helper — an event falls within the past period` (YearMonthDay 2026 2 1) (YearMonthDay 2026 10 22) (`reg 48(2) — the period that Schedule 10 specifies as 6 months` (JUST 9))

§ `Paragraphs 1 to 6 -- Premises`

-- Paragraph 1(1): both limbs are needed.
#ASSERT `Sch 10 para 1(1) — premises occupied as the person's home` TRUE TRUE
#ASSERT NOT (`Sch 10 para 1(1) — premises occupied as the person's home` TRUE FALSE)
#ASSERT NOT (`Sch 10 para 1(1) — premises occupied as the person's home` FALSE TRUE)
-- Paragraph 1(2): only one set of premises may be treated as the home.
#ASSERT `Sch 10 para 1(2) — at most one set of premises is treated as the person's home` (LIST FALSE, FALSE)
#ASSERT `Sch 10 para 1(2) — at most one set of premises is treated as the person's home` (LIST TRUE, FALSE)
#ASSERT NOT (`Sch 10 para 1(2) — at most one set of premises is treated as the person's home` (LIST TRUE, TRUE))
#ASSERT NOT (`Sch 10 para 1(2) — at most one set of premises is treated as the person's home` (LIST TRUE, FALSE, TRUE))

-- Paragraph 2.
GIVEN relation IS A `Listed relation`
      partner IS A `Listed relation`
GIVETH A `Possible close relative`
`test relative` relation partner MEANS
    `Possible close relative` WITH
        `relation to the person` IS relation
        `relation of the partner to the person` IS partner

`test limited` MEANS `Capability for work` WITH
    `limited capability for work` IS TRUE
    `limited capability for work and work-related activity` IS FALSE
    `severe conditions criteria claimant` IS FALSE
`test not limited` MEANS `Capability for work` WITH
    `limited capability for work` IS FALSE
    `limited capability for work and work-related activity` IS FALSE
    `severe conditions criteria claimant` IS FALSE

-- A parent with limited capability for work, in their own home: disregarded.
#ASSERT `Sch 10 para 2 — premises occupied by a close relative` TRUE (`test relative` `a parent` `not a listed relation`) `test limited` FALSE
-- Not a close relative (a cousin, or here a person not on the list): not disregarded.
#ASSERT NOT (`Sch 10 para 2 — premises occupied by a close relative` TRUE (`test relative` `not a listed relation` `not a listed relation`) `test limited` FALSE)
-- The partner of a listed relative is a close relative (reg 2 limb (b)).
#ASSERT `Sch 10 para 2 — premises occupied by a close relative` TRUE (`test relative` `not a listed relation` `a sister`) `test not limited` TRUE
-- Neither limited capability for work nor the qualifying age: not disregarded.
#ASSERT NOT (`Sch 10 para 2 — premises occupied by a close relative` TRUE (`test relative` `a son` `not a listed relation`) `test not limited` FALSE)
-- Not occupied as their home: not disregarded.
#ASSERT NOT (`Sch 10 para 2 — premises occupied by a close relative` FALSE (`test relative` `a son` `not a listed relation`) `test limited` TRUE)

-- Paragraph 3: all three limbs.
#ASSERT `Sch 10 para 3 — premises occupied by a former partner` TRUE TRUE TRUE
#ASSERT NOT (`Sch 10 para 3 — premises occupied by a former partner` TRUE TRUE FALSE)
#ASSERT NOT (`Sch 10 para 3 — premises occupied by a former partner` TRUE FALSE TRUE)
#ASSERT NOT (`Sch 10 para 3 — premises occupied by a former partner` FALSE TRUE TRUE)

-- Paragraph 4.
GIVEN intends IS A BOOLEAN
      home IS A BOOLEAN
      acquired IS A MAYBE DATE
      `not yet occupied` IS A BOOLEAN
      steps IS A BOOLEAN
      advice IS A MAYBE DATE
      proceedings IS A MAYBE DATE
      repairs IS A BOOLEAN
      `repairs began` IS A MAYBE DATE
GIVETH A `Premises that a person intends to occupy as their home`
`test intended home` intends home acquired `not yet occupied` steps advice proceedings repairs `repairs began` MEANS
    `Premises that a person intends to occupy as their home` WITH
        `the person intends to occupy the premises as their home` IS intends
        `the premises are the one set treated as the person's home` IS home
        `date on which the person acquired the premises` IS acquired
        `the person has not yet taken up occupation` IS `not yet occupied`
        `the person is taking steps to obtain possession` IS steps
        `date on which legal advice was first sought` IS advice
        `date on which proceedings were commenced` IS proceedings
        `the person is carrying out essential repairs or alterations required to render the premises fit for occupation` IS repairs
        `date on which the repairs or alterations were commenced` IS `repairs began`

-- (2): the earlier of the two dates, or the only one, or none.
#ASSERT `Sch 10 para 4(2) — the date steps to obtain possession are taken to have commenced` (`test intended home` TRUE TRUE NOTHING FALSE TRUE (JUST (YearMonthDay 2026 3 1)) (JUST (YearMonthDay 2026 2 1)) FALSE NOTHING) EQUALS JUST (YearMonthDay 2026 2 1)
#ASSERT `Sch 10 para 4(2) — the date steps to obtain possession are taken to have commenced` (`test intended home` TRUE TRUE NOTHING FALSE TRUE (JUST (YearMonthDay 2026 2 1)) (JUST (YearMonthDay 2026 3 1)) FALSE NOTHING) EQUALS JUST (YearMonthDay 2026 2 1)
#ASSERT `Sch 10 para 4(2) — the date steps to obtain possession are taken to have commenced` (`test intended home` TRUE TRUE NOTHING FALSE TRUE (JUST (YearMonthDay 2026 3 1)) NOTHING FALSE NOTHING) EQUALS JUST (YearMonthDay 2026 3 1)
#ASSERT `Sch 10 para 4(2) — the date steps to obtain possession are taken to have commenced` (`test intended home` TRUE TRUE NOTHING FALSE TRUE NOTHING (JUST (YearMonthDay 2026 4 1)) FALSE NOTHING) EQUALS JUST (YearMonthDay 2026 4 1)
#ASSERT `Sch 10 para 4(2) — the date steps to obtain possession are taken to have commenced` (`test intended home` TRUE TRUE NOTHING FALSE TRUE NOTHING NOTHING FALSE NOTHING) EQUALS NOTHING
-- (a) acquired on 1 June 2026 and not yet occupied: within six months of 22 October 2026.
#ASSERT `Sch 10 para 4(1) — premises the person intends to occupy as their home` (`test intended home` TRUE TRUE (JUST (YearMonthDay 2026 6 1)) TRUE FALSE NOTHING NOTHING FALSE NOTHING) (YearMonthDay 2026 10 22) `test six months`
-- Occupation already taken up: (a) fails, and nothing else is in play.
#ASSERT NOT (`Sch 10 para 4(1) — premises the person intends to occupy as their home` (`test intended home` TRUE TRUE (JUST (YearMonthDay 2026 6 1)) FALSE FALSE NOTHING NOTHING FALSE NOTHING) (YearMonthDay 2026 10 22) `test six months`)
-- Acquired on 1 April 2026: more than six months before, so (a) fails ...
#ASSERT NOT (`Sch 10 para 4(1) — premises the person intends to occupy as their home` (`test intended home` TRUE TRUE (JUST (YearMonthDay 2026 4 1)) TRUE FALSE NOTHING NOTHING FALSE NOTHING) (YearMonthDay 2026 10 22) `test six months`)
-- ... unless the Secretary of State extends the period to nine months (reg 48(2)): 1 April plus nine months is 1 January 2027.
#ASSERT `Sch 10 para 4(1) — premises the person intends to occupy as their home` (`test intended home` TRUE TRUE (JUST (YearMonthDay 2026 4 1)) TRUE FALSE NOTHING NOTHING FALSE NOTHING) (YearMonthDay 2026 10 22) (`reg 48(2) — the period that Schedule 10 specifies as 6 months` (JUST 9))
-- (b) steps commenced when legal advice was first sought (1 May 2026).
#ASSERT `Sch 10 para 4(1) — premises the person intends to occupy as their home` (`test intended home` TRUE TRUE NOTHING FALSE TRUE (JUST (YearMonthDay 2026 5 1)) NOTHING FALSE NOTHING) (YearMonthDay 2026 10 22) `test six months`
-- (b) the earlier date governs: advice on 1 May but proceedings on 1 January means steps began on 1 January, outside six months.
#ASSERT NOT (`Sch 10 para 4(1) — premises the person intends to occupy as their home` (`test intended home` TRUE TRUE NOTHING FALSE TRUE (JUST (YearMonthDay 2026 5 1)) (JUST (YearMonthDay 2026 1 1)) FALSE NOTHING) (YearMonthDay 2026 10 22) `test six months`)
-- (b) needs steps to be taken at all.
#ASSERT NOT (`Sch 10 para 4(1) — premises the person intends to occupy as their home` (`test intended home` TRUE TRUE NOTHING FALSE FALSE (JUST (YearMonthDay 2026 5 1)) NOTHING FALSE NOTHING) (YearMonthDay 2026 10 22) `test six months`)
-- (c) repairs commenced on 1 September 2026.
#ASSERT `Sch 10 para 4(1) — premises the person intends to occupy as their home` (`test intended home` TRUE TRUE NOTHING FALSE FALSE NOTHING NOTHING TRUE (JUST (YearMonthDay 2026 9 1))) (YearMonthDay 2026 10 22) `test six months`
#ASSERT NOT (`Sch 10 para 4(1) — premises the person intends to occupy as their home` (`test intended home` TRUE TRUE NOTHING FALSE FALSE NOTHING NOTHING TRUE (JUST (YearMonthDay 2026 3 1))) (YearMonthDay 2026 10 22) `test six months`)
-- No intention to occupy, or not the one set treated as the home: none of the limbs helps.
#ASSERT NOT (`Sch 10 para 4(1) — premises the person intends to occupy as their home` (`test intended home` FALSE TRUE (JUST (YearMonthDay 2026 6 1)) TRUE FALSE NOTHING NOTHING FALSE NOTHING) (YearMonthDay 2026 10 22) `test six months`)
#ASSERT NOT (`Sch 10 para 4(1) — premises the person intends to occupy as their home` (`test intended home` TRUE FALSE (JUST (YearMonthDay 2026 6 1)) TRUE FALSE NOTHING NOTHING FALSE NOTHING) (YearMonthDay 2026 10 22) `test six months`)

-- Paragraph 5.
GIVEN ceased IS A BOOLEAN
      home IS A BOOLEAN
      `ceased on` IS A DATE
      lone IS A BOOLEAN
      occupies IS A BOOLEAN
GIVETH A `Premises that a person has ceased to occupy after an estrangement`
`test estranged premises` ceased home `ceased on` lone occupies MEANS
    `Premises that a person has ceased to occupy after an estrangement` WITH
        `the person has ceased to occupy the premises as their home following an estrangement from their former partner` IS ceased
        `the premises are the one set treated as the person's home` IS home
        `date on which the person ceased to occupy the premises` IS `ceased on`
        `the former partner is a lone parent` IS lone
        `the former partner occupies the premises as their home` IS occupies

-- Ceased on 1 June 2026: within six months.
#ASSERT `Sch 10 para 5 — premises ceased to be occupied after an estrangement` (`test estranged premises` TRUE TRUE (YearMonthDay 2026 6 1) FALSE FALSE) (YearMonthDay 2026 10 22) `test six months`
-- Ceased on 1 February 2026: outside six months, and the former partner is not a lone parent.
#ASSERT NOT (`Sch 10 para 5 — premises ceased to be occupied after an estrangement` (`test estranged premises` TRUE TRUE (YearMonthDay 2026 2 1) FALSE TRUE) (YearMonthDay 2026 10 22) `test six months`)
-- A lone-parent former partner who lives there keeps the premises disregarded however long ago the person left.
#ASSERT `Sch 10 para 5 — premises ceased to be occupied after an estrangement` (`test estranged premises` TRUE TRUE (YearMonthDay 2026 2 1) TRUE TRUE) (YearMonthDay 2026 10 22) `test six months`
-- Lone parent who has moved out: no.
#ASSERT NOT (`Sch 10 para 5 — premises ceased to be occupied after an estrangement` (`test estranged premises` TRUE TRUE (YearMonthDay 2026 2 1) TRUE FALSE) (YearMonthDay 2026 10 22) `test six months`)
-- Ceasing must follow an estrangement; the premises must be the one set.
#ASSERT NOT (`Sch 10 para 5 — premises ceased to be occupied after an estrangement` (`test estranged premises` FALSE TRUE (YearMonthDay 2026 6 1) TRUE TRUE) (YearMonthDay 2026 10 22) `test six months`)
#ASSERT NOT (`Sch 10 para 5 — premises ceased to be occupied after an estrangement` (`test estranged premises` TRUE FALSE (YearMonthDay 2026 6 1) TRUE TRUE) (YearMonthDay 2026 10 22) `test six months`)

-- Paragraph 6.
#ASSERT `Sch 10 para 6 — premises the person is taking reasonable steps to dispose of` TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22) `test six months`
#ASSERT NOT (`Sch 10 para 6 — premises the person is taking reasonable steps to dispose of` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 10 22) `test six months`)
#ASSERT NOT (`Sch 10 para 6 — premises the person is taking reasonable steps to dispose of` FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22) `test six months`)
#ASSERT `Sch 10 para 6 — premises the person is taking reasonable steps to dispose of` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 10 22) (`reg 48(2) — the period that Schedule 10 specifies as 6 months` (JUST 9))

§ `Paragraphs 7 and 8 -- Business assets`

#ASSERT `Sch 10 para 7 — assets used for a trade, profession or vocation the person carries on` TRUE TRUE
#ASSERT NOT (`Sch 10 para 7 — assets used for a trade, profession or vocation the person carries on` TRUE FALSE)
#ASSERT NOT (`Sch 10 para 7 — assets used for a trade, profession or vocation the person carries on` FALSE TRUE)

GIVEN used IS A BOOLEAN
      `ceased on` IS A DATE
      dispose IS A BOOLEAN
      incapacity IS A BOOLEAN
      reengaged IS A BOOLEAN
GIVETH AN `Assets of a trade, profession or vocation that has ceased`
`test ceased business` used `ceased on` dispose incapacity reengaged MEANS
    `Assets of a trade, profession or vocation that has ceased` WITH
        `assets were used wholly or mainly for a trade, profession or vocation that the person has ceased to carry on` IS used
        `date on which the person ceased to carry it on` IS `ceased on`
        `the person is taking reasonable steps to dispose of the assets` IS dispose
        `the person ceased to be engaged in carrying it on because of incapacity` IS incapacity
        `the person can reasonably expect to be reengaged on recovery` IS reengaged

-- Ceased on 1 August 2026 and disposing: disregarded.
#ASSERT `Sch 10 para 8 — assets of a trade, profession or vocation ceased within the past period` (`test ceased business` TRUE (YearMonthDay 2026 8 1) TRUE FALSE FALSE) (YearMonthDay 2026 10 22) `test six months`
-- Ceased because of incapacity with the expectation of returning: disregarded without disposal.
#ASSERT `Sch 10 para 8 — assets of a trade, profession or vocation ceased within the past period` (`test ceased business` TRUE (YearMonthDay 2026 8 1) FALSE TRUE TRUE) (YearMonthDay 2026 10 22) `test six months`
-- Incapacity without the expectation of returning, and no disposal: not.
#ASSERT NOT (`Sch 10 para 8 — assets of a trade, profession or vocation ceased within the past period` (`test ceased business` TRUE (YearMonthDay 2026 8 1) FALSE TRUE FALSE) (YearMonthDay 2026 10 22) `test six months`)
#ASSERT NOT (`Sch 10 para 8 — assets of a trade, profession or vocation ceased within the past period` (`test ceased business` TRUE (YearMonthDay 2026 8 1) FALSE FALSE TRUE) (YearMonthDay 2026 10 22) `test six months`)
-- Ceased on 1 March 2026: outside six months.
#ASSERT NOT (`Sch 10 para 8 — assets of a trade, profession or vocation ceased within the past period` (`test ceased business` TRUE (YearMonthDay 2026 3 1) TRUE FALSE FALSE) (YearMonthDay 2026 10 22) `test six months`)
-- The business must have ceased.
#ASSERT NOT (`Sch 10 para 8 — assets of a trade, profession or vocation ceased within the past period` (`test ceased business` FALSE (YearMonthDay 2026 8 1) TRUE FALSE FALSE) (YearMonthDay 2026 10 22) `test six months`)

§ `Paragraphs 9 to 11 -- Rights in pensions schemes etc`

#ASSERT `Sch 10 para 9 — the value of a policy of life insurance` TRUE
#ASSERT NOT (`Sch 10 para 9 — the value of a policy of life insurance` FALSE)

GIVEN pension IS A BOOLEAN
      occupational IS A BOOLEAN
      personal IS A BOOLEAN
      registered IS A BOOLEAN
GIVETH A `Right to receive a pension`
`test pension right` pension occupational personal registered MEANS
    `Right to receive a pension` WITH
        `the capital is the value of a right to receive a pension` IS pension
        `occupational pension scheme within the meaning of section 1 of the Pension Schemes Act 1993` IS occupational
        `personal pension scheme within the meaning of section 1 of the Pension Schemes Act 1993` IS personal
        `other pension scheme registered under section 153 of the Finance Act 2004` IS registered

#ASSERT `Sch 10 para 10 — the value of a right to receive a pension` (`test pension right` TRUE TRUE FALSE FALSE)
#ASSERT `Sch 10 para 10 — the value of a right to receive a pension` (`test pension right` TRUE FALSE TRUE FALSE)
#ASSERT `Sch 10 para 10 — the value of a right to receive a pension` (`test pension right` TRUE FALSE FALSE TRUE)
-- A right to a pension under a scheme of none of the three kinds: not disregarded.
#ASSERT NOT (`Sch 10 para 10 — the value of a right to receive a pension` (`test pension right` TRUE FALSE FALSE FALSE))
-- The capital must be the value of the right.
#ASSERT NOT (`Sch 10 para 10 — the value of a right to receive a pension` (`test pension right` FALSE TRUE TRUE TRUE))

-- (1) the capital is the value of a contract that meets the definition in (2).
#ASSERT `Sch 10 para 11(1) — the value of a funeral plan contract` TRUE TRUE TRUE
#ASSERT NOT (`Sch 10 para 11(1) — the value of a funeral plan contract` FALSE TRUE TRUE)
-- A plan that has some purpose besides the funeral, or no payments to secure one, is not a funeral plan contract.
#ASSERT NOT (`Sch 10 para 11(1) — the value of a funeral plan contract` TRUE TRUE FALSE)
#ASSERT NOT (`Sch 10 para 11(1) — the value of a funeral plan contract` TRUE FALSE TRUE)
#ASSERT `Sch 10 para 11(2) — funeral plan contract` TRUE TRUE
#ASSERT NOT (`Sch 10 para 11(2) — funeral plan contract` TRUE FALSE)
#ASSERT NOT (`Sch 10 para 11(2) — funeral plan contract` FALSE TRUE)

§ `Paragraphs 12 to 15 -- Amounts earmarked for special purposes`

#ASSERT `Sch 10 para 12 — an amount deposited with a housing association` TRUE TRUE
#ASSERT NOT (`Sch 10 para 12 — an amount deposited with a housing association` TRUE FALSE)
#ASSERT NOT (`Sch 10 para 12 — an amount deposited with a housing association` FALSE TRUE)

GIVEN purchase IS A BOOLEAN
      received IS A DATE
      proceeds IS A BOOLEAN
      deposited IS A BOOLEAN
      grant IS A BOOLEAN
GIVETH AN `Amount received for the purchase of a home`
`test home purchase amount` purchase received proceeds deposited grant MEANS
    `Amount received for the purchase of a home` WITH
        `the amount is to be used for the purchase of premises that the person intends to occupy as their home` IS purchase
        `date on which the amount was received` IS received
        `the amount is attributable to the proceeds of sale of premises formerly occupied by the person as their home` IS proceeds
        `the amount has been deposited with a housing association as mentioned in paragraph 12` IS deposited
        `the amount is a grant made to the person for the sole purpose of the purchase of a home` IS grant

-- Each of the three sources alone: disregarded when received on 1 August 2026.
#ASSERT `Sch 10 para 13 — an amount received for the purchase of a home` (`test home purchase amount` TRUE (YearMonthDay 2026 8 1) TRUE FALSE FALSE) (YearMonthDay 2026 10 22) `test six months`
#ASSERT `Sch 10 para 13 — an amount received for the purchase of a home` (`test home purchase amount` TRUE (YearMonthDay 2026 8 1) FALSE TRUE FALSE) (YearMonthDay 2026 10 22) `test six months`
#ASSERT `Sch 10 para 13 — an amount received for the purchase of a home` (`test home purchase amount` TRUE (YearMonthDay 2026 8 1) FALSE FALSE TRUE) (YearMonthDay 2026 10 22) `test six months`
-- None of the three sources: not.
#ASSERT NOT (`Sch 10 para 13 — an amount received for the purchase of a home` (`test home purchase amount` TRUE (YearMonthDay 2026 8 1) FALSE FALSE FALSE) (YearMonthDay 2026 10 22) `test six months`)
-- Received on 1 March 2026: outside six months.
#ASSERT NOT (`Sch 10 para 13 — an amount received for the purchase of a home` (`test home purchase amount` TRUE (YearMonthDay 2026 3 1) TRUE FALSE FALSE) (YearMonthDay 2026 10 22) `test six months`)
-- Not to be used for the purchase of a home: not.
#ASSERT NOT (`Sch 10 para 13 — an amount received for the purchase of a home` (`test home purchase amount` FALSE (YearMonthDay 2026 8 1) TRUE FALSE FALSE) (YearMonthDay 2026 10 22) `test six months`)

#ASSERT `Sch 10 para 14 — an amount received under an insurance policy` TRUE (YearMonthDay 2026 8 1) (YearMonthDay 2026 10 22) `test six months`
#ASSERT NOT (`Sch 10 para 14 — an amount received under an insurance policy` TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 10 22) `test six months`)
#ASSERT NOT (`Sch 10 para 14 — an amount received under an insurance policy` FALSE (YearMonthDay 2026 8 1) (YearMonthDay 2026 10 22) `test six months`)

#ASSERT `Sch 10 para 15 — an amount for essential repairs or alterations` TRUE TRUE (YearMonthDay 2026 8 1) (YearMonthDay 2026 10 22) `test six months`
#ASSERT NOT (`Sch 10 para 15 — an amount for essential repairs or alterations` TRUE FALSE (YearMonthDay 2026 8 1) (YearMonthDay 2026 10 22) `test six months`)
#ASSERT NOT (`Sch 10 para 15 — an amount for essential repairs or alterations` FALSE TRUE (YearMonthDay 2026 8 1) (YearMonthDay 2026 10 22) `test six months`)
#ASSERT NOT (`Sch 10 para 15 — an amount for essential repairs or alterations` TRUE TRUE (YearMonthDay 2026 3 1) (YearMonthDay 2026 10 22) `test six months`)

§ `Paragraphs 16 to 24 -- Other payments`

-- Paragraph 16: twelve months. Paid 22 October 2025 is the last day; the day before is not.
#ASSERT `Sch 10 para 16 — a social fund payment` TRUE (YearMonthDay 2025 10 22) (YearMonthDay 2026 10 22)
#ASSERT NOT (`Sch 10 para 16 — a social fund payment` TRUE (YearMonthDay 2025 10 21) (YearMonthDay 2026 10 22))
#ASSERT NOT (`Sch 10 para 16 — a social fund payment` FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22))

-- Paragraph 17.
`test England county council` MEANS `Body that may be a local authority` WITH
    `nation of Great Britain in relation to which it is asked` IS England
    `kind of body` IS `a county council`
`test England charity` MEANS `Body that may be a local authority` WITH
    `nation of Great Britain in relation to which it is asked` IS England
    `kind of body` IS `another kind of body`

`test scottish act` MEANS `Provision whose standing as an enactment is asked by uc2` WITH
    `enactment comprised in an Act of the Scottish Parliament or the National Assembly of Wales` IS TRUE
    `instrument made under an Act of the Scottish Parliament or the National Assembly of Wales` IS FALSE
    `an enactment apart from the inclusions in regulation 2` IS FALSE
`test unknown provision` MEANS `Provision whose standing as an enactment is asked by uc2` WITH
    `enactment comprised in an Act of the Scottish Parliament or the National Assembly of Wales` IS FALSE
    `instrument made under an Act of the Scottish Parliament or the National Assembly of Wales` IS FALSE
    `an enactment apart from the inclusions in regulation 2` IS FALSE
`test an enactment` MEANS `Provision whose standing as an enactment is asked by uc2` WITH
    `enactment comprised in an Act of the Scottish Parliament or the National Assembly of Wales` IS FALSE
    `instrument made under an Act of the Scottish Parliament or the National Assembly of Wales` IS FALSE
    `an enactment apart from the inclusions in regulation 2` IS TRUE

GIVEN food IS A BOOLEAN
GIVETH A `Cost that may be a living expense`
`test living cost` food MEANS
    `Cost that may be a living expense` WITH
        `cost of food` IS food
        `cost of ordinary clothing or footwear` IS FALSE
        `cost of household fuel, rent or other housing costs (including council tax)` IS FALSE
        `for the person` IS TRUE
        `for the person's partner` IS FALSE
        `for a child or qualifying young person for whom the person is responsible` IS FALSE

GIVEN `made on` IS A DATE
      body IS A `Body that may be a local authority`
      listed IS A BOOLEAN
      provision IS A `Provision whose standing as an enactment is asked by uc2`
      welfare IS A BOOLEAN
      cost IS A `Cost that may be a living expense`
GIVETH A `Payment by or on behalf of a local authority`
`test authority payment` `made on` body listed provision welfare cost MEANS
    `Payment by or on behalf of a local authority` WITH
        `date on which the payment was made` IS `made on`
        body IS body
        `payment made under section 17, 23B, 23C or 24A of the Children Act 1989, section 12 of the Social Work (Scotland) Act 1968, section 29 or 30 of the Children (Scotland) Act 1995 or section 37, 38, 109, 110, 114 or 115 of the Social Services and Well-being (Wales) Act 2014` IS listed
        provision IS provision
        `payment made in order to meet a person's welfare needs related to old age or disability` IS welfare
        cost IS cost

-- (1)(a): a payment under one of the listed sections, within twelve months (paid 1 May 2026).
#ASSERT `Sch 10 para 17 — a payment by or on behalf of a local authority` (`test authority payment` (YearMonthDay 2026 5 1) `test England county council` TRUE `test unknown provision` FALSE (`test living cost` TRUE)) (YearMonthDay 2026 10 22)
-- Paid 21 October 2025: outside twelve months.
#ASSERT NOT (`Sch 10 para 17 — a payment by or on behalf of a local authority` (`test authority payment` (YearMonthDay 2025 10 21) `test England county council` TRUE `test unknown provision` FALSE (`test living cost` TRUE)) (YearMonthDay 2026 10 22))
-- A body that is not a local authority: no, whatever the section.
#ASSERT NOT (`Sch 10 para 17 — a payment by or on behalf of a local authority` (`test authority payment` (YearMonthDay 2026 5 1) `test England charity` TRUE `test unknown provision` FALSE (`test living cost` TRUE)) (YearMonthDay 2026 10 22))
-- (1)(b): another enactment, to meet welfare needs related to old age, and not a living expense (here the cost is not of food, clothing or housing).
#ASSERT `Sch 10 para 17(1)(b) — a payment under any other enactment to meet welfare needs related to old age or disability` (`test authority payment` (YearMonthDay 2026 5 1) `test England county council` FALSE `test an enactment` TRUE (`test living cost` FALSE))
#ASSERT `Sch 10 para 17 — a payment by or on behalf of a local authority` (`test authority payment` (YearMonthDay 2026 5 1) `test England county council` FALSE `test an enactment` TRUE (`test living cost` FALSE)) (YearMonthDay 2026 10 22)
-- A Scottish Parliament Act is included by regulation 2 even where it is not otherwise known to be an enactment.
#ASSERT `Sch 10 para 17(1)(b) — a payment under any other enactment to meet welfare needs related to old age or disability` (`test authority payment` (YearMonthDay 2026 5 1) `test England county council` FALSE `test scottish act` TRUE (`test living cost` FALSE))
-- (2): a payment towards living expenses is excluded.
#ASSERT NOT (`Sch 10 para 17(1)(b) — a payment under any other enactment to meet welfare needs related to old age or disability` (`test authority payment` (YearMonthDay 2026 5 1) `test England county council` FALSE `test an enactment` TRUE (`test living cost` TRUE)))
-- Not an enactment, or not for welfare needs: no.
#ASSERT NOT (`Sch 10 para 17(1)(b) — a payment under any other enactment to meet welfare needs related to old age or disability` (`test authority payment` (YearMonthDay 2026 5 1) `test England county council` FALSE `test unknown provision` TRUE (`test living cost` FALSE)))
#ASSERT NOT (`Sch 10 para 17(1)(b) — a payment under any other enactment to meet welfare needs related to old age or disability` (`test authority payment` (YearMonthDay 2026 5 1) `test England county council` FALSE `test an enactment` FALSE (`test living cost` FALSE)))

-- Paragraph 18(2): a social security benefit.
GIVEN benefit IS A BOOLEAN
      provision IS A `Provision whose standing as an enactment is asked by uc2`
      social IS A BOOLEAN
      afip IS A BOOLEAN
GIVETH A `Payment that may be a social security benefit`
`test social security payment` benefit provision social afip MEANS
    `Payment that may be a social security benefit` WITH
        `benefit under an enactment` IS benefit
        provision IS provision
        `enactment relating to social security in any part of the United Kingdom` IS social
        `armed forces independence payment under the Armed Forces and Reserve Forces (Compensation Scheme) Order 2011` IS afip

#ASSERT `Sch 10 para 18(2) — social security benefit` (`test social security payment` TRUE `test an enactment` TRUE FALSE)
-- Armed forces independence payment is included whatever else is true.
#ASSERT `Sch 10 para 18(2) — social security benefit` (`test social security payment` FALSE `test unknown provision` FALSE TRUE)
#ASSERT NOT (`Sch 10 para 18(2) — social security benefit` (`test social security payment` TRUE `test an enactment` FALSE FALSE))
#ASSERT NOT (`Sch 10 para 18(2) — social security benefit` (`test social security payment` TRUE `test unknown provision` TRUE FALSE))
#ASSERT NOT (`Sch 10 para 18(2) — social security benefit` (`test social security payment` FALSE `test an enactment` TRUE FALSE))

-- Paragraph 18(1): arrears of universal credit, an abolished benefit, or a social security benefit that is not unearned income under regulation 66(1)(a) or (b).
`test an ordinary social security benefit` MEANS `test social security payment` TRUE `test an enactment` TRUE FALSE
`test no social security benefit` MEANS `test social security payment` FALSE `test unknown provision` FALSE FALSE

-- Arrears of universal credit within twelve months (paid 1 May 2026).
#ASSERT `Sch 10 para 18(1) — arrears of, or compensation for late payment of, a benefit` TRUE TRUE FALSE `test no social security benefit` FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22)
-- A benefit abolished by section 33 of the Act.
#ASSERT `Sch 10 para 18(1) — arrears of, or compensation for late payment of, a benefit` TRUE FALSE TRUE `test no social security benefit` FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22)
-- A social security benefit that is not counted as unearned income.
#ASSERT `Sch 10 para 18(1) — arrears of, or compensation for late payment of, a benefit` TRUE FALSE FALSE `test an ordinary social security benefit` FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22)
-- A social security benefit that IS counted as unearned income is not disregarded here.
#ASSERT NOT (`Sch 10 para 18(1) — arrears of, or compensation for late payment of, a benefit` TRUE FALSE FALSE `test an ordinary social security benefit` TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22))
-- Universal credit arrears are disregarded even where the (irrelevant) unearned-income flag is set.
#ASSERT `Sch 10 para 18(1) — arrears of, or compensation for late payment of, a benefit` TRUE TRUE FALSE `test an ordinary social security benefit` TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22)
-- Nothing of the three: the benefit is not a social security benefit, nor universal credit, nor abolished.
#ASSERT NOT (`Sch 10 para 18(1) — arrears of, or compensation for late payment of, a benefit` TRUE FALSE FALSE `test no social security benefit` FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22))
-- Not by way of arrears or compensation at all: no.
#ASSERT NOT (`Sch 10 para 18(1) — arrears of, or compensation for late payment of, a benefit` FALSE TRUE FALSE `test no social security benefit` FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22))
-- Out of time: paid 21 October 2025.
#ASSERT NOT (`Sch 10 para 18(1) — arrears of, or compensation for late payment of, a benefit` TRUE TRUE FALSE `test no social security benefit` FALSE (YearMonthDay 2025 10 21) (YearMonthDay 2026 10 22))
-- Armed forces independence payment is a social security benefit (18(2)), so its arrears are disregarded too.
#ASSERT `Sch 10 para 18(1) — arrears of, or compensation for late payment of, a benefit` TRUE FALSE FALSE (`test social security payment` FALSE `test unknown provision` FALSE TRUE) FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22)

-- Paragraph 18ZA: all four limbs.
#ASSERT `Sch 10 para 18ZA — a payment of widowed parent's allowance to the survivor of a cohabiting partnership` TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22) TRUE TRUE
#ASSERT NOT (`Sch 10 para 18ZA — a payment of widowed parent's allowance to the survivor of a cohabiting partnership` FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22) TRUE TRUE)
#ASSERT NOT (`Sch 10 para 18ZA — a payment of widowed parent's allowance to the survivor of a cohabiting partnership` TRUE (YearMonthDay 2025 10 21) (YearMonthDay 2026 10 22) TRUE TRUE)
#ASSERT NOT (`Sch 10 para 18ZA — a payment of widowed parent's allowance to the survivor of a cohabiting partnership` TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22) FALSE TRUE)
#ASSERT NOT (`Sch 10 para 18ZA — a payment of widowed parent's allowance to the survivor of a cohabiting partnership` TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22) TRUE FALSE)

-- Paragraph 18ZB: no time limit.
#ASSERT `Sch 10 para 18ZB — a payment on the recalculation of carer's allowance` TRUE TRUE
#ASSERT NOT (`Sch 10 para 18ZB — a payment on the recalculation of carer's allowance` TRUE FALSE)
#ASSERT NOT (`Sch 10 para 18ZB — a payment on the recalculation of carer's allowance` FALSE TRUE)

-- Paragraph 18A: local welfare provision, as the keel defines it, or arrears of or in lieu of it.
GIVEN giver IS A `Giver of assistance`
      occasional IS A BOOLEAN
      short IS A BOOLEAN
GIVETH AN `Assistance given to individuals`
`test assistance` giver occasional short MEANS
    `Assistance given to individuals` WITH
        giver IS giver
        `assistance is occasional financial or other assistance` IS occasional
        `purpose is meeting, or helping to meet, an immediate short term need` IS short
        `need arises out of an exceptional event, or exceptional circumstances` IS short
        `need requires to be met in order to avoid a risk to the well-being of an individual` IS short
        `purpose is enabling individuals to establish or maintain a settled home` IS FALSE
        `individuals have been or, without the assistance, might otherwise be in prison, hospital, a residential care establishment or other institution` IS FALSE
        `individuals have been or, without the assistance, might otherwise be homeless or otherwise living an unsettled way of life` IS FALSE

#ASSERT `Sch 10 para 18A — a payment by way of local welfare provision` (`test assistance` `a local authority` TRUE TRUE) FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22)
-- Not local welfare provision, but the payment is arrears of it: disregarded.
#ASSERT `Sch 10 para 18A — a payment by way of local welfare provision` (`test assistance` `another giver` TRUE TRUE) TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22)
-- Neither: not.
#ASSERT NOT (`Sch 10 para 18A — a payment by way of local welfare provision` (`test assistance` `another giver` TRUE TRUE) FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22))
-- Out of time: received 21 October 2025.
#ASSERT NOT (`Sch 10 para 18A — a payment by way of local welfare provision` (`test assistance` `a local authority` TRUE TRUE) FALSE (YearMonthDay 2025 10 21) (YearMonthDay 2026 10 22))

-- Paragraph 19: no time limit.
#ASSERT `Sch 10 para 19 — a payment to a holder of the Victoria Cross or the George Cross` TRUE
#ASSERT NOT (`Sch 10 para 19 — a payment to a holder of the Victoria Cross or the George Cross` FALSE)

-- Paragraph 20.
GIVEN `paid on` IS A DATE
      rate IS A BOOLEAN
      cohabiting IS A BOOLEAN
      `at rate 3(1)` IS A NUMBER
      lump IS A NUMBER
GIVETH A `Bereavement support payment`
`test bereavement payment` `paid on` rate cohabiting `at rate 3(1)` lump MEANS
    `Bereavement support payment` WITH
        `date on which the payment was made` IS `paid on`
        `payment in respect of the rate set out in regulation 3(2) or (5) of the Bereavement Support Payment Regulations 2017` IS rate
        `paid to the survivor of a cohabiting partnership in respect of a death before the day the Bereavement Benefits (Remedial) Order 2023 comes into force` IS cohabiting
        `amount of the payment in respect of the rate set out in regulation 3(1) of the Bereavement Support Payment Regulations 2017` IS `at rate 3(1)`
        `amount of that payment paid as a lump sum for more than one monthly recurrence of the day of the month on which their cohabiting partner died` IS lump

#ASSERT `Sch 10 para 20(1) — a payment of bereavement support payment at the rate in regulation 3(2) or (5)` (`test bereavement payment` (YearMonthDay 2026 5 1) TRUE FALSE 0 0) (YearMonthDay 2026 10 22)
#ASSERT NOT (`Sch 10 para 20(1) — a payment of bereavement support payment at the rate in regulation 3(2) or (5)` (`test bereavement payment` (YearMonthDay 2026 5 1) FALSE FALSE 0 0) (YearMonthDay 2026 10 22))
#ASSERT NOT (`Sch 10 para 20(1) — a payment of bereavement support payment at the rate in regulation 3(2) or (5)` (`test bereavement payment` (YearMonthDay 2025 10 21) TRUE FALSE 0 0) (YearMonthDay 2026 10 22))
-- (2): the amount that is both at the 3(1) rate and a lump sum for more than one recurrence. 3,500 at the rate and a 2,000 lump sum: 2,000 (the smaller; fork F-S10-3).
#ASSERT `Sch 10 para 20(2) — the amount of the payment that is disregarded` (`test bereavement payment` (YearMonthDay 2026 5 1) FALSE TRUE 3500 2000) (YearMonthDay 2026 10 22) EQUALS 2000
#ASSERT `Sch 10 para 20(2) — the amount of the payment that is disregarded` (`test bereavement payment` (YearMonthDay 2026 5 1) FALSE TRUE 1500 2000) (YearMonthDay 2026 10 22) EQUALS 1500
-- Not a cohabiting survivor, or out of time: nothing is disregarded under (2).
#ASSERT `Sch 10 para 20(2) — the amount of the payment that is disregarded` (`test bereavement payment` (YearMonthDay 2026 5 1) FALSE FALSE 3500 2000) (YearMonthDay 2026 10 22) EQUALS 0
#ASSERT `Sch 10 para 20(2) — the amount of the payment that is disregarded` (`test bereavement payment` (YearMonthDay 2025 10 21) FALSE TRUE 3500 2000) (YearMonthDay 2026 10 22) EQUALS 0

-- Paragraphs 21 to 24.
#ASSERT `Sch 10 para 21 — early years assistance` TRUE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22)
#ASSERT NOT (`Sch 10 para 21 — early years assistance` FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22))
#ASSERT NOT (`Sch 10 para 21 — early years assistance` TRUE (YearMonthDay 2025 10 21) (YearMonthDay 2026 10 22))
#ASSERT `Sch 10 para 22 — funeral expense assistance` TRUE (YearMonthDay 2025 10 22) (YearMonthDay 2026 10 22)
#ASSERT NOT (`Sch 10 para 22 — funeral expense assistance` TRUE (YearMonthDay 2025 10 21) (YearMonthDay 2026 10 22))
#ASSERT NOT (`Sch 10 para 22 — funeral expense assistance` FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22))
-- Paragraphs 23 and 24 run for 52 weeks (364 days).
#ASSERT `Sch 10 para 23 — young carer grant assistance` TRUE (YearMonthDay 2025 10 23) (YearMonthDay 2026 10 22)
#ASSERT NOT (`Sch 10 para 23 — young carer grant assistance` TRUE (YearMonthDay 2025 10 22) (YearMonthDay 2026 10 22))
#ASSERT NOT (`Sch 10 para 23 — young carer grant assistance` FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22))
#ASSERT `Sch 10 para 24 — winter heating assistance` TRUE (YearMonthDay 2025 10 23) (YearMonthDay 2026 10 22)
#ASSERT NOT (`Sch 10 para 24 — winter heating assistance` TRUE (YearMonthDay 2025 10 22) (YearMonthDay 2026 10 22))
#ASSERT NOT (`Sch 10 para 24 — winter heating assistance` FALSE (YearMonthDay 2026 5 1) (YearMonthDay 2026 10 22))
