#ASSERT `Am I treated as having lived in my home before I moved in after a stay in hospital or a care home` England TRUE TRUE `joint claimants` TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE 2025 1 1 2025 1 15 EQUALS TRUE

