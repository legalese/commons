IMPORT prelude
IMPORT `uc-core`
IMPORT `uc-core-persons`
IMPORT `uc4-part8-ch1-carers-hours`

-- Tests of uc4-part8-ch1-carers-hours.l4: regulations 84 to 88.
-- Expected values are written by hand from the text, beside the assertion.

-- ---------------------------------------------------------------------------------------------------------
-- Fixtures.
GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
GIVETH A `Relevant carer facts`
`test — relevant carer` a b c d MEANS `Relevant carer facts` WITH
    `the claimant is a parent of a child` IS a
    `the claimant is the responsible carer for that child` IS b
    `the claimant has caring responsibilities for that child` IS c
    `the claimant has caring responsibilities for a person who has a physical or mental impairment` IS d

GIVEN nation IS A `Nation of Great Britain`
      placed IS A BOOLEAN
      carer IS A BOOLEAN
GIVETH A `Placement of a child with a person`
`test — placement` nation placed carer MEANS `Placement of a child with a person` WITH
    `nation in which the child is placed` IS nation
    `child is placed with the person under the placement regulations` IS placed
    `person is a foster carer or a kinship carer` IS carer

GIVEN claimant IS A `Placement of a child with a person`
      other IS A MAYBE `Placement of a child with a person`
      anyone IS A BOOLEAN
      nominated IS A BOOLEAN
GIVETH A `Foster parents of a child`
`test — foster parents` claimant other anyone nominated MEANS `Foster parents of a child` WITH
    `the claimant's placement of the child` IS claimant
    `the other member of the couple's placement of the child` IS other
    `any other person, not a member of the couple, is a foster parent in relation to the child` IS anyone
    `the claimant is the member nominated in accordance with regulation 86` IS nominated

GIVEN a IS A BOOLEAN
      b IS A BOOLEAN
      c IS A BOOLEAN
      d IS A BOOLEAN
GIVETH A `Nominations by joint claimants`
`test — nominations` a b c d MEANS `Nominations by joint claimants` WITH
    `the first joint claimant is nominated as a responsible carer` IS a
    `the first joint claimant is nominated as a responsible foster parent` IS b
    `the second joint claimant is nominated as a responsible carer` IS c
    `the second joint claimant is nominated as a responsible foster parent` IS d

GIVEN relevant IS A BOOLEAN
      rc IS A BOOLEAN
      rfp IS A BOOLEAN
      prospects IS A BOOLEAN
      hoursa IS A NUMBER
      underage IS A BOOLEAN
      hoursaa IS A NUMBER
      school IS A BOOLEAN
      hoursb IS A NUMBER
      impairment IS A BOOLEAN
      hoursc IS A NUMBER
GIVETH AN `Expected hours facts`
`test — hours facts` relevant rc rfp prospects hoursa underage hoursaa school hoursb impairment hoursc MEANS `Expected hours facts` WITH
    `the claimant is a relevant carer` IS relevant
    `the claimant is a responsible carer` IS rc
    `the claimant is a responsible foster parent` IS rfp
    `the Secretary of State is satisfied that the claimant has reasonable prospects of obtaining paid work` IS prospects
    `the number of hours that the Secretary of State considers is compatible with those caring responsibilities, limb (a)` IS hoursa
    `the claimant is a responsible carer of a child who has not yet reached compulsory school age` IS underage
    `the number of hours that the Secretary of State considers is compatible with those caring responsibilities, limb (aa)` IS hoursaa
    `the claimant is a responsible carer for a child who has reached compulsory school age but who is under the age of 13` IS school
    `the number of hours that the Secretary of State considers is compatible with the child's normal school hours` IS hoursb
    `the claimant has a physical or mental impairment` IS impairment
    `the number of hours that the Secretary of State considers is reasonable in light of the impairment` IS hoursc

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 85, "relevant carer": (a) a parent of a child who is not the responsible carer but has caring responsibilities for the child;
-- (b) a person who has caring responsibilities for a person who has a physical or mental impairment.
#ASSERT `reg 85 — relevant carer, limb (a)` (`test — relevant carer` TRUE FALSE TRUE FALSE)
-- A parent who is the responsible carer is not a relevant carer under (a).
#ASSERT NOT (`reg 85 — relevant carer, limb (a)` (`test — relevant carer` TRUE TRUE TRUE FALSE))
-- A parent with no caring responsibilities for the child.
#ASSERT NOT (`reg 85 — relevant carer, limb (a)` (`test — relevant carer` TRUE FALSE FALSE FALSE))
-- Not a parent.
#ASSERT NOT (`reg 85 — relevant carer, limb (a)` (`test — relevant carer` FALSE FALSE TRUE FALSE))
#ASSERT `reg 85 — relevant carer, limb (b)` (`test — relevant carer` FALSE FALSE FALSE TRUE)
#ASSERT NOT (`reg 85 — relevant carer, limb (b)` (`test — relevant carer` TRUE FALSE TRUE FALSE))
#ASSERT `reg 85 — relevant carer` (`test — relevant carer` TRUE FALSE TRUE FALSE)
#ASSERT `reg 85 — relevant carer` (`test — relevant carer` FALSE FALSE FALSE TRUE)
-- The responsible carer who is a parent and also cares for an impaired person is a relevant carer by limb (b).
#ASSERT `reg 85 — relevant carer` (`test — relevant carer` TRUE TRUE TRUE TRUE)
#ASSERT NOT (`reg 85 — relevant carer` (`test — relevant carer` TRUE TRUE TRUE FALSE))
#ASSERT NOT (`reg 85 — relevant carer` (`test — relevant carer` FALSE FALSE FALSE FALSE))

-- Regulation 85, "responsible foster parent".
-- The only foster parent of the child, placed in England under the placement regulations.
#ASSERT `reg 85 — responsible foster parent` (`test — foster parents` (`test — placement` England TRUE FALSE) NOTHING FALSE FALSE)
-- Both members of the couple are foster parents and the claimant is the nominated member.
#ASSERT `reg 85 — responsible foster parent` (`test — foster parents` (`test — placement` Wales TRUE FALSE) (JUST (`test — placement` Wales TRUE FALSE)) FALSE TRUE)
-- Both are foster parents and the claimant is not the nominated member.
#ASSERT NOT (`reg 85 — responsible foster parent` (`test — foster parents` (`test — placement` Wales TRUE FALSE) (JUST (`test — placement` Wales TRUE FALSE)) FALSE FALSE))
-- The other member's placement is not under the regulations, so the other member is not a foster parent and the claimant is the only one.
#ASSERT `reg 85 — responsible foster parent` (`test — foster parents` (`test — placement` England TRUE FALSE) (JUST (`test — placement` England FALSE FALSE)) FALSE FALSE)
-- Another person outside the couple is also a foster parent: the claimant is not the only foster parent.
#ASSERT NOT (`reg 85 — responsible foster parent` (`test — foster parents` (`test — placement` England TRUE FALSE) NOTHING TRUE FALSE))
-- In Scotland the placement must be of a foster carer or kinship carer (the core's definition of foster parent).
#ASSERT `reg 85 — responsible foster parent` (`test — foster parents` (`test — placement` Scotland TRUE TRUE) NOTHING FALSE FALSE)
#ASSERT NOT (`reg 85 — responsible foster parent` (`test — foster parents` (`test — placement` Scotland TRUE FALSE) NOTHING FALSE FALSE))
-- The claimant is not a foster parent at all.
#ASSERT NOT (`reg 85 — responsible foster parent` (`test — foster parents` (`test — placement` England FALSE FALSE) NOTHING FALSE TRUE))

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 86(2): only one of joint claimants may be nominated, as a responsible carer or a responsible foster parent.
#ASSERT `reg 86(2) — only one of joint claimants is nominated` (`test — nominations` TRUE FALSE FALSE FALSE)
#ASSERT `reg 86(2) — only one of joint claimants is nominated` (`test — nominations` FALSE FALSE FALSE TRUE)
-- The same member may be nominated in both roles.
#ASSERT `reg 86(2) — only one of joint claimants is nominated` (`test — nominations` TRUE TRUE FALSE FALSE)
-- Neither is nominated: no limit is exceeded.
#ASSERT `reg 86(2) — only one of joint claimants is nominated` (`test — nominations` FALSE FALSE FALSE FALSE)
-- Both members are nominated, in the same role or in different roles.
#ASSERT NOT (`reg 86(2) — only one of joint claimants is nominated` (`test — nominations` TRUE FALSE TRUE FALSE))
#ASSERT NOT (`reg 86(2) — only one of joint claimants is nominated` (`test — nominations` TRUE FALSE FALSE TRUE))
#ASSERT NOT (`reg 86(2) — only one of joint claimants is nominated` (`test — nominations` FALSE TRUE TRUE FALSE))

-- Regulation 86(3): the nomination applies to all the children for whom either joint claimant is responsible.
#ASSERT `reg 86(3) — the nomination applies to a child` "Asha" (LIST "Asha", "Ben") (LIST "Chen")
#ASSERT `reg 86(3) — the nomination applies to a child` "Chen" (LIST "Asha", "Ben") (LIST "Chen")
#ASSERT NOT (`reg 86(3) — the nomination applies to a child` "Dina" (LIST "Asha", "Ben") (LIST "Chen"))
#ASSERT NOT (`reg 86(3) — the nomination applies to a child` "Asha" EMPTY EMPTY)

-- Regulation 86(4): previous nomination on 1 March 2026. Under (a) a change is allowed from 1 March 2027 (fork F-86-1).
#ASSERT `reg 86(4) — the joint claimants may change which member is nominated` (YearMonthDay 2026 3 1) (YearMonthDay 2027 3 1) FALSE
#ASSERT `reg 86(4) — the joint claimants may change which member is nominated` (YearMonthDay 2026 3 1) (YearMonthDay 2027 3 2) FALSE
#ASSERT `reg 86(4) — the joint claimants may change which member is nominated` (YearMonthDay 2026 3 1) (YearMonthDay 2030 1 1) FALSE
-- The day before the twelve months are up: not allowed under (a).
#ASSERT NOT (`reg 86(4) — the joint claimants may change which member is nominated` (YearMonthDay 2026 3 1) (YearMonthDay 2027 2 28) FALSE)
#ASSERT NOT (`reg 86(4) — the joint claimants may change which member is nominated` (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 2) FALSE)
-- Under (b), the Secretary of State considers there has been a relevant change of circumstances: allowed at any time.
#ASSERT `reg 86(4) — the joint claimants may change which member is nominated` (YearMonthDay 2026 3 1) (YearMonthDay 2026 3 2) TRUE
#ASSERT `reg 86(4) — the joint claimants may change which member is nominated` (YearMonthDay 2026 3 1) (YearMonthDay 2027 2 28) TRUE

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 87: obtaining paid work includes obtaining more paid work or better-paid work.
#ASSERT `reg 87 — the claimant obtains paid work, including more or better-paid work` TRUE FALSE FALSE
#ASSERT `reg 87 — the claimant obtains paid work, including more or better-paid work` FALSE TRUE FALSE
#ASSERT `reg 87 — the claimant obtains paid work, including more or better-paid work` FALSE FALSE TRUE
#ASSERT NOT (`reg 87 — the claimant obtains paid work, including more or better-paid work` FALSE FALSE FALSE)

-- ---------------------------------------------------------------------------------------------------------
-- Regulation 88(1): 35 unless a lesser number applies.
#ASSERT `reg 88(1) — the expected number of hours per week, unless a lesser number applies` EQUALS 35
-- No limb applies.
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` FALSE FALSE FALSE FALSE 0 FALSE 0 FALSE 0 FALSE 0) EQUALS 35
-- Limb (a): a relevant carer with reasonable prospects of work, 25 hours.
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` TRUE FALSE FALSE TRUE 25 FALSE 0 FALSE 0 FALSE 0) EQUALS 25
-- Limb (a) needs the Secretary of State's satisfaction as to reasonable prospects: without it a relevant carer has 35.
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` TRUE FALSE FALSE FALSE 25 FALSE 0 FALSE 0 FALSE 0) EQUALS 35
-- Limb (a): a responsible foster parent with reasonable prospects, 30 hours.
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` FALSE FALSE TRUE TRUE 30 FALSE 0 FALSE 0 FALSE 0) EQUALS 30
-- Limb (a): a responsible carer of an older child (neither (aa) nor (b)) with reasonable prospects, 28 hours.
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` FALSE TRUE FALSE TRUE 28 FALSE 0 FALSE 0 FALSE 0) EQUALS 28
-- ... but not without the Secretary of State's satisfaction.
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` FALSE TRUE FALSE FALSE 28 FALSE 0 FALSE 0 FALSE 0) EQUALS 35
-- Limb (aa): a responsible carer of a child below compulsory school age: 16 hours, with or without reasonable prospects.
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` FALSE TRUE FALSE FALSE 0 TRUE 16 FALSE 0 FALSE 0) EQUALS 16
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` FALSE TRUE FALSE TRUE 28 TRUE 16 FALSE 0 FALSE 0) EQUALS 16
-- Limb (a) does not apply to a responsible carer to whom (aa) applies (fork F-88-2): the (a) number 10 is not read.
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` FALSE TRUE FALSE TRUE 10 TRUE 16 FALSE 0 FALSE 0) EQUALS 16
-- Limb (b): a responsible carer of a child of compulsory school age under 13: 24 hours.
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` FALSE TRUE FALSE FALSE 0 FALSE 0 TRUE 24 FALSE 0) EQUALS 24
-- Limb (aa) and (b) apply to responsible carers only: the (aa) fact without being a responsible carer gives 35.
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` FALSE FALSE FALSE FALSE 0 TRUE 16 FALSE 0 FALSE 0) EQUALS 35
-- Limb (c): a claimant with a physical or mental impairment, 20 hours.
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` FALSE FALSE FALSE FALSE 0 FALSE 0 FALSE 0 TRUE 20) EQUALS 20
-- More than one limb: the least is taken (fork F-88-1).
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` TRUE FALSE FALSE TRUE 25 FALSE 0 FALSE 0 TRUE 20) EQUALS 20
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` TRUE FALSE FALSE TRUE 25 FALSE 0 FALSE 0 TRUE 30) EQUALS 25
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` TRUE TRUE TRUE TRUE 25 TRUE 16 TRUE 24 TRUE 22) EQUALS 16
-- A number above 35 is not a "lesser number": the expected hours stay at 35.
#ASSERT `reg 88 — the expected number of hours per week` (`test — hours facts` TRUE FALSE FALSE TRUE 40 FALSE 0 FALSE 0 FALSE 0) EQUALS 35
-- The limbs one by one.
#ASSERT `reg 88(2)(aa) — the lesser number applies for a responsible carer of a child below compulsory school age` (`test — hours facts` FALSE TRUE FALSE FALSE 0 TRUE 16 FALSE 0 FALSE 0)
#ASSERT NOT (`reg 88(2)(aa) — the lesser number applies for a responsible carer of a child below compulsory school age` (`test — hours facts` FALSE FALSE FALSE FALSE 0 TRUE 16 FALSE 0 FALSE 0))
#ASSERT `reg 88(2)(b) — the lesser number applies for a responsible carer of a child of compulsory school age under 13` (`test — hours facts` FALSE TRUE FALSE FALSE 0 FALSE 0 TRUE 24 FALSE 0)
#ASSERT NOT (`reg 88(2)(b) — the lesser number applies for a responsible carer of a child of compulsory school age under 13` (`test — hours facts` FALSE FALSE FALSE FALSE 0 FALSE 0 TRUE 24 FALSE 0))
#ASSERT `reg 88(2)(c) — the lesser number applies for a claimant with an impairment` (`test — hours facts` FALSE FALSE FALSE FALSE 0 FALSE 0 FALSE 0 TRUE 20)
#ASSERT NOT (`reg 88(2)(c) — the lesser number applies for a claimant with an impairment` (`test — hours facts` FALSE FALSE FALSE FALSE 0 FALSE 0 FALSE 0 FALSE 0))
#ASSERT `reg 88(2)(a) — the lesser number applies for a carer or foster parent with reasonable prospects of work` (`test — hours facts` TRUE FALSE FALSE TRUE 25 FALSE 0 FALSE 0 FALSE 0)
#ASSERT NOT (`reg 88(2)(a) — the lesser number applies for a carer or foster parent with reasonable prospects of work` (`test — hours facts` TRUE FALSE FALSE FALSE 25 FALSE 0 FALSE 0 FALSE 0))
