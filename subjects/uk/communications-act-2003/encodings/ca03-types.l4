IMPORT prelude
IMPORT daydate

-- Communications Act 2003 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-2003-21.txt (point in time
-- 6 April 2026). Seat: the individual end-user.

§ `Nouns`

§§ `Ending a contract early (ss 124U-124V)`

-- s 51(9): the kinds of "qualifying end-user", and the rest.
DECLARE `End-user` IS ONE OF
    `an individual not acting for a business`
    `a business with no more than 10 workers`
    `a not-for-profit body with no more than 10 workers`
    `another end-user`

DECLARE `Early termination` HAS
    `who I am`                                          IS A `End-user`
    -- s 124U(1): a right (under an enactment or at common law) to terminate
    -- before the end of the agreed contract period
    `I have a right to terminate early`                 IS A BOOLEAN
    -- s 124U(3): an automated machine-to-machine transmission service
    `a machine-to-machine service`                      IS A BOOLEAN
    `I keep the terminal equipment`                     IS A BOOLEAN
    -- s 124U(2)(a)
    `remaining fees to the end of the period`           IS A NUMBER
    -- s 124U(2)(b): the value agreed at the conclusion of the contract
    `agreed value of the equipment`                     IS A NUMBER
    `agreed contract months`                            IS A NUMBER
    `unexpired months`                                  IS A NUMBER
    -- s 124U(4), 51(8)
    `a bundled contract`                                IS A BOOLEAN
    `I waived the bundle rights`                        IS A BOOLEAN
    -- s 124V(1)(b): the right arises from a lack of conformity or a failure
    -- to supply an element.
    `an element did not conform or was not supplied`    IS A BOOLEAN

§§ `TV licensing (ss 363-368)`

DECLARE `TV case` HAS
    -- s 363(1), 368(3): installing or using a receiver to receive
    -- television programmes or BBC on-demand programmes
    `I install or use a receiver for TV or BBC on-demand` IS A BOOLEAN
    `I hold a TV licence covering it`                   IS A BOOLEAN
    -- s 363(5): a dealer installing on delivery, demonstrating, testing or
    -- repairing
    `only for a dealer's purposes`                      IS A BOOLEAN
    -- s 363(6): an exemption in regulations
    `exempt by regulations`                             IS A BOOLEAN

DECLARE `Concession case` HAS
    `born on`                                           IS A DATE
    `licence issued on`                                 IS A DATE
    -- s 365A(2): the age the concession specifies
    `specified age`                                     IS A NUMBER

§§ `Misuse of a network (ss 127-130)`

DECLARE `Message case` HAS
    -- s 127(1)
    `grossly offensive, indecent, obscene or menacing`  IS A BOOLEAN
    -- s 127(2): for the purpose of causing annoyance, inconvenience or
    -- needless anxiety
    `a message I knew to be false, to annoy`            IS A BOOLEAN
    `persistent use, to annoy`                          IS A BOOLEAN
    -- s 127(4)
    `in the course of providing a programme service`    IS A BOOLEAN
    `offence on`                                        IS A DATE
    -- s 127(5)(b), (7)
    `evidence known to the prosecutor on`               IS A DATE
    `information laid on`                               IS A DATE

DECLARE `Misuse notification` HAS
    `notified on`                                       IS A DATE
    -- s 128(4): Ofcom consider the misuse continuing and in need of being
    -- stopped as soon as possible.
    `an urgent case`                                    IS A BOOLEAN
    `representations allowed until`                     IS A DATE
    `Ofcom act on`                                      IS A DATE
    `penalty`                                           IS A NUMBER
