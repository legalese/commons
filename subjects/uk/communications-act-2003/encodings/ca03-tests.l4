IMPORT prelude
IMPORT daydate
IMPORT `ca03-types`
IMPORT `ca03-rules`
IMPORT `ca03-goal`

-- Communications Act 2003 (UK) — the encoder's tests. Expected values are
-- worked by hand from the Act.

§ `Tests`

§§ `Goal 1 — ending a contract early`

-- Fields: who I am, right to terminate, machine-to-machine, keep equipment,
-- remaining fees, equipment value, agreed months, unexpired months, bundled,
-- waived, element failed.
-- 24-month contract, 6 months left: £600 of the £800 phone's value is 6/24,
-- £200; remaining fees £150: the lesser is £150.
GIVEN who IS A `End-user`, keep IS A BOOLEAN, fees IS A NUMBER
GIVETH A `Early termination`
`ending as` who `keeping` keep `with fees left` fees MEANS
    `Early termination` OF who, TRUE, FALSE, keep, fees, 800, 24, 6, TRUE, FALSE, FALSE

#ASSERT `the most I can be made to pay for ending early` (`ending as` `an individual not acting for a business` `keeping` TRUE `with fees left` 150) EQUALS JUST 150
#ASSERT `the most I can be made to pay for ending early` (`ending as` `an individual not acting for a business` `keeping` TRUE `with fees left` 300) EQUALS JUST 200
#ASSERT `the most I can be made to pay for ending early` (`ending as` `an individual not acting for a business` `keeping` FALSE `with fees left` 300) EQUALS JUST 0
#ASSERT `the most I can be made to pay for ending early` (`Early termination` OF `an individual not acting for a business`, FALSE, FALSE, TRUE, 300, 800, 24, 6, FALSE, FALSE, FALSE) EQUALS NOTHING
-- s 124U(3): machine-to-machine only for qualifying end-users.
#ASSERT `the most I can be made to pay for ending early` (`Early termination` OF `another end-user`, TRUE, TRUE, TRUE, 300, 800, 24, 6, FALSE, FALSE, FALSE) EQUALS NOTHING
#ASSERT `the most I can be made to pay for ending early` (`Early termination` OF `a business with no more than 10 workers`, TRUE, TRUE, TRUE, 300, 800, 24, 6, FALSE, FALSE, FALSE) EQUALS JUST 200
#ASSERT `the most I can be made to pay for ending early` (`Early termination` OF `another end-user`, TRUE, FALSE, TRUE, 300, 800, 24, 6, FALSE, FALSE, FALSE) EQUALS JUST 200
-- s 124U(4)
#ASSERT `my rights cover the whole bundle for` (`ending as` `an individual not acting for a business` `keeping` TRUE `with fees left` 150)
#ASSERT `my rights cover the whole bundle for` (`Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 300, 800, 24, 6, TRUE, TRUE, FALSE)
#ASSERT NOT (`my rights cover the whole bundle for` (`Early termination` OF `a business with no more than 10 workers`, TRUE, FALSE, TRUE, 300, 800, 24, 6, TRUE, TRUE, FALSE))
#ASSERT `my rights cover the whole bundle for` (`Early termination` OF `a business with no more than 10 workers`, TRUE, FALSE, TRUE, 300, 800, 24, 6, TRUE, FALSE, FALSE)
#ASSERT NOT (`my rights cover the whole bundle for` (`Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 300, 800, 24, 6, FALSE, FALSE, FALSE))
-- s 124V
#ASSERT `I may end the whole bundle for` (`Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 300, 800, 24, 6, TRUE, FALSE, TRUE)
#ASSERT NOT (`I may end the whole bundle for` (`Early termination` OF `a business with no more than 10 workers`, TRUE, FALSE, TRUE, 300, 800, 24, 6, TRUE, FALSE, TRUE))
#ASSERT NOT (`I may end the whole bundle for` (`Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 300, 800, 24, 6, TRUE, FALSE, FALSE))

§§ `Goal 2 — TV licensing`

#ASSERT `I would commit a TV licence offence for` (`TV case` OF TRUE, FALSE, FALSE, FALSE)
#ASSERT NOT (`I would commit a TV licence offence for` (`TV case` OF TRUE, TRUE, FALSE, FALSE))
#ASSERT NOT (`I would commit a TV licence offence for` (`TV case` OF FALSE, FALSE, FALSE, FALSE))
#ASSERT NOT (`I would commit a TV licence offence for` (`TV case` OF TRUE, FALSE, TRUE, FALSE))
#ASSERT NOT (`I would commit a TV licence offence for` (`TV case` OF TRUE, FALSE, FALSE, TRUE))

-- Born 20 June 1951; licence issued 3 June 2026: 75 on 20 June, before the
-- end of June.
#ASSERT `I meet the concession's age for` (`Concession case` OF Date 20 6 1951, Date 3 6 2026, 75)
#ASSERT NOT (`I meet the concession's age for` (`Concession case` OF Date 1 7 1951, Date 3 6 2026, 75))
#ASSERT `I meet the concession's age for` (`Concession case` OF Date 30 6 1951, Date 3 6 2026, 75)
-- 29 February 1952: 74 on 28 February 2026.
#ASSERT `I meet the concession's age for` (`Concession case` OF Date 29 2 1952, Date 1 2 2026, 74)
#ASSERT NOT (`I meet the concession's age for` (`Concession case` OF Date 29 2 1952, Date 31 1 2026, 74))
#ASSERT `the concession's age is allowed for` (`Concession case` OF Date 29 2 1952, Date 1 2 2026, 65)
#ASSERT NOT (`the concession's age is allowed for` (`Concession case` OF Date 29 2 1952, Date 1 2 2026, 64))

-- s 366(4): granted 10 March 2026: entry up to 10 April; 31 January: 28
-- February.
#ASSERT `the last day the warrant can be used, granted on` (Date 10 3 2026) EQUALS Date 10 4 2026
#ASSERT `the last day the warrant can be used, granted on` (Date 31 1 2026) EQUALS Date 28 2 2026

§§ `Goal 3 — misuse of a network`

-- Fields: offensive, false to annoy, persistent to annoy, programme service,
-- offence day, evidence day, information laid.
GIVEN off IS A DATE, ev IS A DATE, laid IS A DATE
GIVETH A `Message case`
`a menacing message on` off `, evidence` ev `, laid` laid MEANS
    `Message case` OF TRUE, FALSE, FALSE, FALSE, off, ev, laid

#ASSERT `it is an offence under s 127 for` (`a menacing message on` (Date 1 3 2025) `, evidence` (Date 1 3 2025) `, laid` (Date 1 6 2025))
#ASSERT `it is an offence under s 127 for` (`Message case` OF FALSE, FALSE, TRUE, FALSE, Date 1 3 2025, Date 1 3 2025, Date 1 6 2025)
#ASSERT NOT (`it is an offence under s 127 for` (`Message case` OF TRUE, FALSE, FALSE, TRUE, Date 1 3 2025, Date 1 3 2025, Date 1 6 2025))
#ASSERT NOT (`it is an offence under s 127 for` (`Message case` OF FALSE, FALSE, FALSE, FALSE, Date 1 3 2025, Date 1 3 2025, Date 1 6 2025))
-- Offence 1 March 2023 (3 years end 28 February 2026); evidence 1 December
-- 2025 (6 months end 31 May 2026): the earlier is 28 February 2026.
#ASSERT `the last day to prosecute for` (`a menacing message on` (Date 1 3 2023) `, evidence` (Date 1 12 2025) `, laid` (Date 28 2 2026)) EQUALS Date 28 2 2026
#ASSERT `the prosecution is in time for` (`a menacing message on` (Date 1 3 2023) `, evidence` (Date 1 12 2025) `, laid` (Date 28 2 2026))
#ASSERT NOT (`the prosecution is in time for` (`a menacing message on` (Date 1 3 2023) `, evidence` (Date 1 12 2025) `, laid` (Date 1 3 2026)))
-- Offence 10 January 2025, evidence 15 August 2025: 6 months end 14 February
-- 2026.
#ASSERT `the last day to prosecute for` (`a menacing message on` (Date 10 1 2025) `, evidence` (Date 15 8 2025) `, laid` (Date 14 2 2026)) EQUALS Date 14 2 2026
#ASSERT NOT (`the prosecution is in time for` (`a menacing message on` (Date 10 1 2025) `, evidence` (Date 15 8 2025) `, laid` (Date 15 2 2026)))
-- Evidence 31 August 2025: 6 months end 28 February 2026.
#ASSERT `the last day to prosecute for` (`a menacing message on` (Date 10 1 2025) `, evidence` (Date 31 8 2025) `, laid` (Date 1 1 2026)) EQUALS Date 28 2 2026

-- Fields: notified, urgent, representations until, Ofcom act on, penalty.
#ASSERT `the shortest representation period ends on` (`Misuse notification` OF Date 10 3 2026, TRUE, Date 17 3 2026, Date 18 3 2026, 1000) EQUALS Date 17 3 2026
#ASSERT `the shortest representation period ends on` (`Misuse notification` OF Date 10 3 2026, FALSE, Date 10 4 2026, Date 11 4 2026, 1000) EQUALS Date 10 4 2026
#ASSERT `the representation period is long enough for` (`Misuse notification` OF Date 10 3 2026, FALSE, Date 10 4 2026, Date 11 4 2026, 1000)
#ASSERT NOT (`the representation period is long enough for` (`Misuse notification` OF Date 10 3 2026, FALSE, Date 9 4 2026, Date 11 4 2026, 1000))
#ASSERT NOT (`the representation period is long enough for` (`Misuse notification` OF Date 10 3 2026, TRUE, Date 16 3 2026, Date 18 3 2026, 1000))
#ASSERT `Ofcom may act on the day for` (`Misuse notification` OF Date 10 3 2026, FALSE, Date 10 4 2026, Date 11 4 2026, 1000)
#ASSERT NOT (`Ofcom may act on the day for` (`Misuse notification` OF Date 10 3 2026, FALSE, Date 10 4 2026, Date 10 4 2026, 1000))
#ASSERT NOT (`Ofcom may act on the day for` (`Misuse notification` OF Date 10 3 2026, FALSE, Date 9 4 2026, Date 11 4 2026, 1000))
#ASSERT `the penalty is within the maximum for` (`Misuse notification` OF Date 10 3 2026, FALSE, Date 10 4 2026, Date 11 4 2026, 2000000)
#ASSERT NOT (`the penalty is within the maximum for` (`Misuse notification` OF Date 10 3 2026, FALSE, Date 10 4 2026, Date 11 4 2026, 2000001))

§§ `The top-level goal`

empty MEANS `End-user case` OF NOTHING, NOTHING, NOTHING, NOTHING, NOTHING, NOTHING
full MEANS `End-user case` OF JUST (`ending as` `an individual not acting for a business` `keeping` TRUE `with fees left` 150), JUST (`TV case` OF TRUE, FALSE, FALSE, FALSE), JUST (`Concession case` OF Date 20 6 1951, Date 3 6 2026, 75), JUST (Date 10 3 2026), JUST (`a menacing message on` (Date 1 3 2023) `, evidence` (Date 1 12 2025) `, laid` (Date 28 2 2026)), JUST (`Misuse notification` OF Date 10 3 2026, FALSE, Date 10 4 2026, Date 11 4 2026, 1000)

#ASSERT (`the end-user position for` empty)'s `most I can be made to pay for ending early` EQUALS NOTHING
#ASSERT (`the end-user position for` empty)'s `TV licence offence` EQUALS NOTHING
#ASSERT (`the end-user position for` empty)'s `last day to prosecute` EQUALS NOTHING
#ASSERT (`the end-user position for` full)'s `most I can be made to pay for ending early` EQUALS JUST 150
#ASSERT (`the end-user position for` full)'s `rights cover the whole bundle` EQUALS JUST TRUE
#ASSERT (`the end-user position for` full)'s `I may end the whole bundle` EQUALS JUST FALSE
#ASSERT (`the end-user position for` full)'s `TV licence offence` EQUALS JUST TRUE
#ASSERT (`the end-user position for` full)'s `I meet the concession's age` EQUALS JUST TRUE
#ASSERT (`the end-user position for` full)'s `the concession's age is allowed` EQUALS JUST TRUE
#ASSERT (`the end-user position for` full)'s `last day the warrant can be used` EQUALS JUST (Date 10 4 2026)
#ASSERT (`the end-user position for` full)'s `offence under s 127` EQUALS JUST TRUE
#ASSERT (`the end-user position for` full)'s `last day to prosecute` EQUALS JUST (Date 28 2 2026)
#ASSERT (`the end-user position for` full)'s `prosecution in time` EQUALS JUST TRUE
#ASSERT (`the end-user position for` full)'s `shortest representation period ends` EQUALS JUST (Date 10 4 2026)
#ASSERT (`the end-user position for` full)'s `representation period long enough` EQUALS JUST TRUE
#ASSERT (`the end-user position for` full)'s `Ofcom may act on the day` EQUALS JUST TRUE
#ASSERT (`the end-user position for` full)'s `penalty within the maximum` EQUALS JUST TRUE
