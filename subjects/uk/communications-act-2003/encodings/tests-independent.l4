IMPORT prelude
IMPORT daydate
IMPORT `ca03-types`
IMPORT `ca03-rules`
IMPORT `ca03-goal`

-- Independent tests: Communications Act 2003 (UK).
-- Expectations fixed in independent-expectations.md before the code was read.

§ `Independent tests`

§§ `Goal 1 - ending a contract early`

-- field order: who, right, m2m, keep, fees, value, months, unexpired, bundled, waived, nonconform
DECIDE c1 IS `Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 240, 600, 24, 12, FALSE, FALSE, FALSE
DECIDE c2 IS `Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 400, 600, 24, 12, FALSE, FALSE, FALSE
DECIDE c3 IS `Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 300, 600, 24, 12, FALSE, FALSE, FALSE
DECIDE c4 IS `Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 200, 500, 24, 5, FALSE, FALSE, FALSE
DECIDE c5 IS `Early termination` OF `an individual not acting for a business`, TRUE, FALSE, FALSE, 240, 600, 24, 12, FALSE, FALSE, FALSE
DECIDE c6 IS `Early termination` OF `an individual not acting for a business`, FALSE, FALSE, TRUE, 240, 600, 24, 12, FALSE, FALSE, FALSE
DECIDE c7 IS `Early termination` OF `a business with no more than 10 workers`, TRUE, TRUE, TRUE, 240, 600, 24, 12, FALSE, FALSE, FALSE
DECIDE c8 IS `Early termination` OF `another end-user`, TRUE, TRUE, TRUE, 240, 600, 24, 12, FALSE, FALSE, FALSE
DECIDE c9 IS `Early termination` OF `another end-user`, TRUE, FALSE, TRUE, 240, 600, 24, 12, FALSE, FALSE, FALSE
DECIDE c10 IS `Early termination` OF `an individual not acting for a business`, TRUE, TRUE, TRUE, 240, 600, 24, 12, FALSE, FALSE, FALSE
DECIDE c11 IS `Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 240, 600, 24, 12, TRUE, TRUE, FALSE
DECIDE c12 IS `Early termination` OF `a business with no more than 10 workers`, TRUE, FALSE, TRUE, 240, 600, 24, 12, TRUE, TRUE, FALSE
DECIDE c13 IS `Early termination` OF `a business with no more than 10 workers`, TRUE, FALSE, TRUE, 240, 600, 24, 12, TRUE, FALSE, FALSE
DECIDE c14 IS `Early termination` OF `a not-for-profit body with no more than 10 workers`, TRUE, FALSE, TRUE, 240, 600, 24, 12, TRUE, TRUE, FALSE
DECIDE c15 IS `Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 240, 600, 24, 12, FALSE, FALSE, FALSE
DECIDE c16 IS `Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 240, 600, 24, 12, TRUE, FALSE, TRUE
DECIDE c17 IS `Early termination` OF `a business with no more than 10 workers`, TRUE, FALSE, TRUE, 240, 600, 24, 12, TRUE, FALSE, TRUE
DECIDE c18 IS `Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 240, 600, 24, 12, TRUE, FALSE, FALSE
DECIDE c19 IS `Early termination` OF `an individual not acting for a business`, TRUE, FALSE, TRUE, 240, 600, 24, 12, FALSE, FALSE, TRUE

-- C1-C4: s 124U(2) the lesser of fees and the unexpired share of equipment value
#ASSERT `s 124U applies to` c1
#ASSERT `the most I can be made to pay for ending early` c1 EQUALS JUST 240
#ASSERT `the most I can be made to pay for ending early` c2 EQUALS JUST 300
#ASSERT `the most I can be made to pay for ending early` c3 EQUALS JUST 300
#ASSERT `the most I can be made to pay for ending early` c4 EQUALS JUST (625/6)
-- C5: s 124U(1)(a) nothing due if no equipment kept
#ASSERT `the most I can be made to pay for ending early` c5 EQUALS JUST 0
-- C6: no right to terminate: s 124U does not apply
#ASSERT NOT (`s 124U applies to` c6)
#ASSERT `the most I can be made to pay for ending early` c6 EQUALS NOTHING
-- C7-C10: s 124U(3) machine-to-machine
#ASSERT `s 124U applies to` c7
#ASSERT NOT (`s 124U applies to` c8)
#ASSERT `the most I can be made to pay for ending early` c8 EQUALS NOTHING
#ASSERT `s 124U applies to` c9
#ASSERT `s 124U applies to` c10
-- C11-C15: s 124U(4) bundles and waiver
#ASSERT `my rights cover the whole bundle for` c11
#ASSERT NOT (`my rights cover the whole bundle for` c12)
#ASSERT `my rights cover the whole bundle for` c13
#ASSERT NOT (`my rights cover the whole bundle for` c14)
#ASSERT NOT (`my rights cover the whole bundle for` c15)
-- C16-C19: s 124V
#ASSERT `I may end the whole bundle for` c16
#ASSERT NOT (`I may end the whole bundle for` c17)
#ASSERT NOT (`I may end the whole bundle for` c18)
#ASSERT NOT (`I may end the whole bundle for` c19)

§§ `Goal 2 - TV licensing`

-- field order: install/use, licensed, dealer only, exempt
#ASSERT `I would commit a TV licence offence for` (`TV case` OF TRUE, FALSE, FALSE, FALSE)
#ASSERT NOT (`I would commit a TV licence offence for` (`TV case` OF TRUE, TRUE, FALSE, FALSE))
-- T3 BBC on-demand only, T8 installation alone: both fall within the input
#ASSERT `I would commit a TV licence offence for` (`TV case` OF TRUE, FALSE, FALSE, FALSE)
-- T4 non-BBC on-demand only: not "using" a receiver
#ASSERT NOT (`I would commit a TV licence offence for` (`TV case` OF FALSE, FALSE, FALSE, FALSE))
-- T5, T6 dealer purposes; T7 exemption
#ASSERT NOT (`I would commit a TV licence offence for` (`TV case` OF TRUE, FALSE, TRUE, FALSE))
#ASSERT NOT (`I would commit a TV licence offence for` (`TV case` OF TRUE, FALSE, FALSE, TRUE))

GIVEN b IS A DATE, i IS A DATE, a IS A NUMBER
GIVETH A BOOLEAN
DECIDE `meets age` b i a IF `I meet the concession's age for` (`Concession case` OF b, i, a)

#ASSERT `meets age` (Date 15 3 1961) (Date 1 3 2026) 65
#ASSERT NOT (`meets age` (Date 15 3 1961) (Date 28 2 2026) 65)
#ASSERT `meets age` (Date 31 3 1961) (Date 31 3 2026) 65
#ASSERT NOT (`meets age` (Date 1 4 1961) (Date 31 3 2026) 65)
#ASSERT `meets age` (Date 29 2 1960) (Date 10 2 2025) 65
#ASSERT NOT (`meets age` (Date 29 2 1960) (Date 10 1 2025) 65)
#ASSERT NOT (`meets age` (Date 29 2 1960) (Date 10 2 2024) 65)
#ASSERT `meets age` (Date 10 6 1950) (Date 5 6 2025) 75
#ASSERT NOT (`meets age` (Date 1 7 1950) (Date 30 6 2025) 75)
-- T19 s 365A(2) "must be 65 or higher"
#ASSERT NOT (`the concession's age is allowed for` (`Concession case` OF (Date 1 1 1960), (Date 1 1 2026), 64))
#ASSERT `the concession's age is allowed for` (`Concession case` OF (Date 1 1 1960), (Date 1 1 2026), 65)
#ASSERT `the concession's age is allowed for` (`Concession case` OF (Date 1 1 1960), (Date 1 1 2026), 75)

-- T20-T24 s 366(4)
GIVEN g IS A DATE, e IS A DATE
GIVETH A BOOLEAN
DECIDE `entry allowed` g e IF
    e AT LEAST g AND e AT MOST `the last day the warrant can be used, granted on` g

#ASSERT `the last day the warrant can be used, granted on` (Date 15 3 2026) EQUALS Date 15 4 2026
#ASSERT `entry allowed` (Date 15 3 2026) (Date 14 4 2026)
#ASSERT `entry allowed` (Date 15 3 2026) (Date 15 4 2026)
#ASSERT NOT (`entry allowed` (Date 15 3 2026) (Date 16 4 2026))
#ASSERT `the last day the warrant can be used, granted on` (Date 31 1 2026) EQUALS Date 28 2 2026
#ASSERT NOT (`entry allowed` (Date 31 1 2026) (Date 1 3 2026))
#ASSERT `the last day the warrant can be used, granted on` (Date 31 1 2024) EQUALS Date 29 2 2024
#ASSERT `the last day the warrant can be used, granted on` (Date 30 12 2025) EQUALS Date 30 1 2026
#ASSERT `entry allowed` (Date 15 3 2026) (Date 15 3 2026)

§§ `Goal 3 - misuse of a network`

-- field order: grossly offensive, false to annoy, persistent to annoy, programme service, offence, evidence, laid
GIVEN g IS A BOOLEAN, f IS A BOOLEAN, p IS A BOOLEAN, s IS A BOOLEAN
GIVETH A BOOLEAN
DECIDE `offence for conduct` g f p s IF
    `it is an offence under s 127 for` (`Message case` OF g, f, p, s, (Date 1 1 2025), (Date 1 1 2025), (Date 1 2 2025))

#ASSERT `offence for conduct` TRUE FALSE FALSE FALSE
#ASSERT NOT (`offence for conduct` TRUE FALSE FALSE TRUE)
#ASSERT `offence for conduct` FALSE TRUE FALSE FALSE
#ASSERT NOT (`offence for conduct` FALSE FALSE FALSE FALSE)
#ASSERT `offence for conduct` FALSE FALSE TRUE FALSE
#ASSERT NOT (`offence for conduct` FALSE TRUE FALSE TRUE)

GIVEN o IS A DATE, k IS A DATE, l IS A DATE
GIVETH A `Message case`
`msg` o k l MEANS `Message case` OF TRUE, FALSE, FALSE, FALSE, o, k, l

GIVEN o IS A DATE, k IS A DATE, l IS A DATE
GIVETH A BOOLEAN
DECIDE `in time` o k l IF `the prosecution is in time for` (`msg` o k l)

-- M9-M10: 3-year limit binds
#ASSERT `the last day to prosecute for` (`msg` (Date 10 3 2023) (Date 1 12 2025) (Date 9 3 2026)) EQUALS Date 9 3 2026
#ASSERT `in time` (Date 10 3 2023) (Date 1 12 2025) (Date 8 3 2026)
#ASSERT `in time` (Date 10 3 2023) (Date 1 12 2025) (Date 9 3 2026)
#ASSERT NOT (`in time` (Date 10 3 2023) (Date 1 12 2025) (Date 10 3 2026))
-- M11: 6-month limit binds
#ASSERT `the last day to prosecute for` (`msg` (Date 1 1 2025) (Date 15 3 2025) (Date 1 9 2025)) EQUALS Date 14 9 2025
#ASSERT `in time` (Date 1 1 2025) (Date 15 3 2025) (Date 13 9 2025)
#ASSERT `in time` (Date 1 1 2025) (Date 15 3 2025) (Date 14 9 2025)
#ASSERT NOT (`in time` (Date 1 1 2025) (Date 15 3 2025) (Date 15 9 2025))
-- M12: no 31 February
#ASSERT `the last day to prosecute for` (`msg` (Date 1 6 2025) (Date 31 8 2025) (Date 1 1 2026)) EQUALS Date 28 2 2026
#ASSERT `in time` (Date 1 6 2025) (Date 31 8 2025) (Date 28 2 2026)
#ASSERT NOT (`in time` (Date 1 6 2025) (Date 31 8 2025) (Date 1 3 2026))
-- M13: leap year
#ASSERT `the last day to prosecute for` (`msg` (Date 1 6 2023) (Date 31 8 2023) (Date 1 1 2024)) EQUALS Date 29 2 2024
#ASSERT `in time` (Date 1 6 2023) (Date 31 8 2023) (Date 29 2 2024)
#ASSERT NOT (`in time` (Date 1 6 2023) (Date 31 8 2023) (Date 1 3 2024))
-- M14: offence on 29 February
#ASSERT `the last day to prosecute for` (`msg` (Date 29 2 2024) (Date 1 12 2026) (Date 1 1 2027)) EQUALS Date 28 2 2027
#ASSERT `in time` (Date 29 2 2024) (Date 1 12 2026) (Date 28 2 2027)
#ASSERT NOT (`in time` (Date 29 2 2024) (Date 1 12 2026) (Date 1 3 2027))
-- M15: 28 August + 6 months
#ASSERT `the last day to prosecute for` (`msg` (Date 1 1 2025) (Date 28 8 2025) (Date 1 1 2026)) EQUALS Date 27 2 2026
#ASSERT `in time` (Date 1 1 2025) (Date 28 8 2025) (Date 27 2 2026)
#ASSERT NOT (`in time` (Date 1 1 2025) (Date 28 8 2025) (Date 28 2 2026))

-- s 128: field order notified, urgent, allowed until, Ofcom act on, penalty
GIVEN d IS A DATE, u IS A BOOLEAN, x IS A DATE, y IS A DATE, p IS A NUMBER
GIVETH A `Misuse notification`
`notice` d u x y p MEANS `Misuse notification` OF d, u, x, y, p

-- M16-M17 urgent
#ASSERT `the shortest representation period ends on` (`notice` (Date 1 3 2026) TRUE (Date 8 3 2026) (Date 20 3 2026) 1000) EQUALS Date 8 3 2026
#ASSERT NOT (`the representation period is long enough for` (`notice` (Date 1 3 2026) TRUE (Date 7 3 2026) (Date 20 3 2026) 1000))
#ASSERT `the representation period is long enough for` (`notice` (Date 1 3 2026) TRUE (Date 8 3 2026) (Date 20 3 2026) 1000)
#ASSERT `the shortest representation period ends on` (`notice` (Date 25 12 2025) TRUE (Date 1 1 2026) (Date 20 1 2026) 1000) EQUALS Date 1 1 2026
-- M18 not urgent (continuing but no need to stop asap) -> one month
#ASSERT `the shortest representation period ends on` (`notice` (Date 1 3 2026) FALSE (Date 8 3 2026) (Date 20 3 2026) 1000) EQUALS Date 1 4 2026
-- M19-M21 one month
#ASSERT `the shortest representation period ends on` (`notice` (Date 15 1 2026) FALSE (Date 15 2 2026) (Date 1 3 2026) 1000) EQUALS Date 15 2 2026
#ASSERT NOT (`the representation period is long enough for` (`notice` (Date 15 1 2026) FALSE (Date 14 2 2026) (Date 1 3 2026) 1000))
#ASSERT `the shortest representation period ends on` (`notice` (Date 31 1 2026) FALSE (Date 28 2 2026) (Date 1 3 2026) 1000) EQUALS Date 28 2 2026
#ASSERT NOT (`the representation period is long enough for` (`notice` (Date 31 1 2026) FALSE (Date 27 2 2026) (Date 1 3 2026) 1000))
#ASSERT `the representation period is long enough for` (`notice` (Date 31 1 2026) FALSE (Date 28 2 2026) (Date 1 3 2026) 1000)
#ASSERT `the shortest representation period ends on` (`notice` (Date 31 1 2024) FALSE (Date 29 2 2024) (Date 1 3 2024) 1000) EQUALS Date 29 2 2024
-- M22 ss 129(1)(c), 130(1)(c)
#ASSERT NOT (`Ofcom may act on the day for` (`notice` (Date 15 1 2026) FALSE (Date 15 2 2026) (Date 15 2 2026) 1000))
#ASSERT `Ofcom may act on the day for` (`notice` (Date 15 1 2026) FALSE (Date 15 2 2026) (Date 16 2 2026) 1000)
-- M23 period too short
#ASSERT NOT (`Ofcom may act on the day for` (`notice` (Date 1 3 2026) TRUE (Date 7 3 2026) (Date 20 3 2026) 1000))
-- M24 s 130(4)
#ASSERT `the penalty is within the maximum for` (`notice` (Date 1 3 2026) TRUE (Date 8 3 2026) (Date 20 3 2026) 2000000)
#ASSERT `the penalty is within the maximum for` (`notice` (Date 1 3 2026) TRUE (Date 8 3 2026) (Date 20 3 2026) 1999999)
#ASSERT NOT (`the penalty is within the maximum for` (`notice` (Date 1 3 2026) TRUE (Date 8 3 2026) (Date 20 3 2026) 2000001))

§§ `Top-level goal`

DECIDE `top` IS `the end-user position for` (`End-user case` OF (JUST c2), NOTHING, NOTHING, (JUST (Date 31 1 2024)), NOTHING, NOTHING)
#ASSERT `top`'s `most I can be made to pay for ending early` EQUALS JUST 300
#ASSERT `top`'s `last day the warrant can be used` EQUALS JUST (Date 29 2 2024)
#ASSERT `top`'s `TV licence offence` EQUALS NOTHING
