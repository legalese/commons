IMPORT prelude
IMPORT daydate
IMPORT `pa14-types`
IMPORT `pa14-state-pension`
IMPORT `pa14-deferral`
IMPORT `pa14-bereavement`
IMPORT `pa14-goal`

-- Pensions Act 2014 (UK) — the encoder's tests. Expected values are worked
-- by hand from the Act.

§ `Tests`

-- Fields: pensionable age, pre years, post years, minimum, full rate 2016,
-- full rate at pensionable age, old-system rate, contracting-out amount,
-- revaluing percentage.
GIVEN np IS A NUMBER, nq IS A NUMBER, o IS A NUMBER, co IS A NUMBER, pr IS A NUMBER
GIVETH A `Pension facts`
`a 2030 pensioner with` np `pre and` nq `post years, old` o `, contracted out` co `, prices` pr MEANS
    `Pension facts` OF Date 1 5 2030, np, nq, 10, 150, 180, o, co, pr

GIVEN nq IS A NUMBER
GIVETH A `Pension facts`
`new pensioner` nq MEANS
    `a 2030 pensioner with` 0 `pre and` nq `post years, old` 0 `, contracted out` 0 `, prices` 0

§§ `Goal 1 — state pension`

-- s 1(2)
#ASSERT `the kind of state pension for` (`Pension facts` OF Date 5 4 2016, 30, 0, 10, 150, 150, 120, 0, 0) EQUALS `none under this Part (old state pension instead)`
#ASSERT `the kind of state pension for` (`Pension facts` OF Date 6 4 2016, 30, 0, 10, 150, 150, 120, 0, 0) EQUALS `transitional rate`
-- s 2: full, reduced (20/35 of £180 = £102.857...), too few.
#ASSERT `the kind of state pension for` ((`new pensioner` 35)) EQUALS `full rate`
#ASSERT `the weekly state pension for` ((`new pensioner` 40)) EQUALS 180
#ASSERT `the kind of state pension for` ((`new pensioner` 20)) EQUALS `reduced rate`
#ASSERT `the weekly state pension for` ((`new pensioner` 21)) EQUALS 108
#ASSERT `the weekly state pension for` ((`new pensioner` 10)) EQUALS 180 TIMES 10 DIVIDED BY 35
#ASSERT `the kind of state pension for` ((`new pensioner` 9)) EQUALS `none (too few qualifying years)`
#ASSERT `the weekly state pension for` ((`new pensioner` 9)) EQUALS 0

-- s 4, s 5, Sch 1. 28 pre-commencement years: Step 2 = 28/35 × £150 = £120.
-- Old system £120 too: foundation £120, revalued × 180/150 = £144. Post 7
-- years: 7/35 × £180 = £36; £144 + £36 = £180, the cap.
#ASSERT `the amount for pre-commencement qualifying years for` (`a 2030 pensioner with` 28 `pre and` 7 `post years, old` 120 `, contracted out` 0 `, prices` 0) EQUALS 144
#ASSERT `the weekly state pension for` (`a 2030 pensioner with` 28 `pre and` 7 `post years, old` 120 `, contracted out` 0 `, prices` 0) EQUALS 180
#ASSERT `the weekly state pension for` (`a 2030 pensioner with` 28 `pre and` 0 `post years, old` 120 `, contracted out` 0 `, prices` 0) EQUALS 144
-- Post 14 years: £144 + £72 = £216, capped at £180.
#ASSERT `the weekly state pension for` (`a 2030 pensioner with` 28 `pre and` 14 `post years, old` 120 `, contracted out` 0 `, prices` 0) EQUALS 180
-- Above the full rate: old system £170; revalued £150 × 1.2 + £20 × 1.03 =
-- £200.60, kept under s 5(1)(b).
#ASSERT `the weekly state pension for` (`a 2030 pensioner with` 35 `pre and` 3 `post years, old` 170 `, contracted out` 0 `, prices` 3) EQUALS 200.6
-- Contracting out: 35 years, £150 − £30 = £120 beats an old-system £100.
#ASSERT `the amount for pre-commencement qualifying years for` (`a 2030 pensioner with` 35 `pre and` 0 `post years, old` 100 `, contracted out` 30 `, prices` 0) EQUALS 144
-- Fewer than the minimum, even with a pre-commencement year.
#ASSERT `the kind of state pension for` (`a 2030 pensioner with` 5 `pre and` 4 `post years, old` 50 `, contracted out` 0 `, prices` 0) EQUALS `none (too few qualifying years)`
#ASSERT `the kind of state pension for` (`a 2030 pensioner with` 5 `pre and` 5 `post years, old` 50 `, contracted out` 0 `, prices` 0) EQUALS `transitional rate`

§§ `Goal 2 — deferral`

GIVEN until IS A DATE, pct IS A NUMBER
GIVETH A `Deferral facts`
`deferred from 1 January 2025 to` until `at` pct MEANS
    `Deferral facts` OF Date 1 1 2025, until, 200, pct

ninth MEANS 1 DIVIDED BY 9
#ASSERT `the whole weeks deferred in` (`deferred from 1 January 2025 to` (Date 28 1 2025) `at` ninth) EQUALS 4
#ASSERT `the whole weeks deferred in` (`deferred from 1 January 2025 to` (Date 27 1 2025) `at` ninth) EQUALS 3
-- 52 weeks at 1/9% of £200: £104/9.
#ASSERT `the whole weeks deferred in` (`deferred from 1 January 2025 to` (Date 30 12 2025) `at` ninth) EQUALS 52
#ASSERT `the weekly increase for deferral in` (`deferred from 1 January 2025 to` (Date 30 12 2025) `at` ninth) EQUALS 104 DIVIDED BY 9
-- s 17(2): 8 weeks give £16/9, under 1% (£2): nothing; 9 weeks give £2.
#ASSERT `the weekly increase for deferral in` (`deferred from 1 January 2025 to` (Date 25 2 2025) `at` ninth) EQUALS 0
#ASSERT `the weekly increase for deferral in` (`deferred from 1 January 2025 to` (Date 4 3 2025) `at` ninth) EQUALS 2

§§ `Goal 3 — bereavement support payment`

GIVEN ef IS A NUMBER
GIVETH A `Contribution year`
`a year with earnings factor` ef MEANS `Contribution year` OF TRUE, ef, 6396

GIVEN rel IS A `Relationship`, child IS A BOOLEAN, died IS A DATE, ef IS A NUMBER, industrial IS A BOOLEAN
GIVETH A `Bereavement facts`
`bereaved` rel `, child` child `, died` died `, earnings factor` ef `, industrial` industrial MEANS
    `Bereavement facts` OF rel, died, child, Date 1 1 2045, TRUE, (LIST (`a year with earnings factor` ef)), industrial, FALSE

-- 25 × £6,396 = £159,900.
#ASSERT `is entitled to bereavement support payment` (`bereaved` `spouse` `, child` FALSE `, died` (Date 1 6 2025) `, earnings factor` 159900 `, industrial` FALSE)
#ASSERT NOT (`is entitled to bereavement support payment` (`bereaved` `spouse` `, child` FALSE `, died` (Date 1 6 2025) `, earnings factor` 159899 `, industrial` FALSE))
#ASSERT `is entitled to bereavement support payment` (`bereaved` `civil partner` `, child` FALSE `, died` (Date 1 6 2025) `, earnings factor` 0 `, industrial` TRUE)
#ASSERT NOT (`is entitled to bereavement support payment` (`bereaved` `cohabiting partner` `, child` FALSE `, died` (Date 1 6 2025) `, earnings factor` 159900 `, industrial` FALSE))
#ASSERT `is entitled to bereavement support payment` (`bereaved` `cohabiting partner` `, child` TRUE `, died` (Date 1 6 2025) `, earnings factor` 159900 `, industrial` FALSE)
-- s 30(1)(b): under pensionable age when the partner dies.
#ASSERT NOT (`is entitled to bereavement support payment` (`bereaved` `spouse` `, child` FALSE `, died` (Date 1 1 2045) `, earnings factor` 159900 `, industrial` FALSE))
#ASSERT `is entitled to bereavement support payment` (`bereaved` `spouse` `, child` FALSE `, died` (Date 31 12 2044) `, earnings factor` 159900 `, industrial` FALSE)
-- Contributions not actually paid.
#ASSERT NOT (`is entitled to bereavement support payment` (`Bereavement facts` OF `spouse`, Date 1 6 2025, FALSE, Date 1 1 2045, TRUE, (LIST (`Contribution year` OF FALSE, 200000, 6396)), FALSE, FALSE))
-- Not resident; death before s 30 in force.
#ASSERT NOT (`is entitled to bereavement support payment` (`Bereavement facts` OF `spouse`, Date 1 6 2025, FALSE, Date 1 1 2045, FALSE, (LIST (`a year with earnings factor` 200000)), FALSE, FALSE))
#ASSERT NOT (`is entitled to bereavement support payment` (`Bereavement facts` OF `spouse`, Date 1 6 2016, FALSE, Date 1 1 2045, TRUE, (LIST (`a year with earnings factor` 200000)), FALSE, TRUE))

§§ `The top-level goal`

pos MEANS `the pension position for` (`Pension case` OF ((`new pensioner` 21)), JUST (`deferred from 1 January 2025 to` (Date 4 3 2025) `at` ninth), NOTHING)
#ASSERT pos's `kind of state pension` EQUALS `reduced rate`
#ASSERT pos's `weekly state pension` EQUALS 108
#ASSERT pos's `whole weeks deferred` EQUALS JUST 9
#ASSERT pos's `weekly increase for deferral` EQUALS JUST 2
#ASSERT pos's `entitled to bereavement support payment` EQUALS NOTHING
