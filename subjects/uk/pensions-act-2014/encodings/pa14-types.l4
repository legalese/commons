IMPORT prelude
IMPORT daydate

-- Pensions Act 2014 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-2014-19.txt (point in time
-- 29 April 2026).

§ `Nouns`

DECLARE `Pension facts` HAS
    `reaches pensionable age on`                        IS A DATE
    -- s 4(4): qualifying years from 6 April 1978 to 5 April 2016 (and
    -- reckonable years counted by s 4(5)).
    `pre-commencement qualifying years`                 IS A NUMBER
    -- s 4(4): qualifying years beginning on or after 6 April 2016.
    `post-commencement qualifying years`                IS A NUMBER
    -- ss 2(3), 4(2): set by regulations, at most 10.
    `minimum qualifying years`                          IS A NUMBER
    -- s 3(1): the full rate on 6 April 2016 and on the day of pensionable age.
    `full rate on 6 April 2016`                         IS A NUMBER
    `full rate at pensionable age`                      IS A NUMBER
    -- Sch 1 para 3: Step 1, the weekly rate under the old system.
    `old-system rate`                                   IS A NUMBER
    -- Sch 1 para 5: the amount to reflect contracting out.
    `contracting-out amount`                            IS A NUMBER
    -- Sch 1 para 6(5): the revaluing percentage in the last order under
    -- s 148AC(3) of the Administration Act before pensionable age.
    `revaluing percentage for prices`                   IS A NUMBER

DECLARE `Deferral facts` HAS
    `deferred from`                                     IS A DATE
    `deferred until`                                    IS A DATE
    -- s 17(4): the weekly rate the person would have had.
    `weekly rate`                                       IS A NUMBER
    -- s 17(4)-(5): the percentage specified in regulations, per increment.
    `increment percentage`                              IS A NUMBER

DECLARE `Relationship` IS ONE OF
    `spouse`
    `civil partner`
    `cohabiting partner`

-- s 31(1): one tax year of the deceased's working life.
DECLARE `Contribution year` HAS
    `actually paid Class 1 or Class 2 contributions`    IS A BOOLEAN
    `earnings factor from those contributions`          IS A NUMBER
    `lower earnings limit`                              IS A NUMBER

DECLARE `Bereavement facts` HAS
    `relationship to the deceased`                      IS A `Relationship`
    `died on`                                           IS A DATE
    -- s 30(1)(aa)
    `pregnant or entitled to child benefit as specified` IS A BOOLEAN
    -- s 30(1)(b): the claimant's pensionable age.
    `claimant reaches pensionable age on`               IS A DATE
    -- s 30(1)(c)
    `ordinarily resident in Great Britain or a specified territory` IS A BOOLEAN
    -- s 31(1)
    `the deceased's contribution years`                 IS A LIST OF `Contribution year`
    -- s 31(3): an employed earner who died of an industrial injury or
    -- prescribed disease.
    `died of an industrial injury or prescribed disease as an employed earner` IS A BOOLEAN
    -- s 30(6): the death occurred before s 30 came fully into force.
    `death before section 30 fully in force`            IS A BOOLEAN
