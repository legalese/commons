IMPORT prelude
IMPORT daydate

-- Taxation (Cross-border Trade) Act 2018 (UK) — THE NOUNS. No rules here.
-- Source: ../registers/source-bundle/ukpga-2018-22.txt (point in time
-- 18 March 2026).

§ `Nouns`

-- s 3(3)-(4), s 5: what happened to the goods on import.
DECLARE `Procedure` IS ONE OF
    `free-circulation procedure`
    `storage procedure`
    `transit procedure`
    `inward processing procedure`
    `authorised use procedure`
    `temporary admission procedure`
    `not presented or not declared`

DECLARE `Goods facts` HAS
    -- s 2(1), s 33
    `domestic goods`                                    IS A BOOLEAN
    `procedure`                                         IS A `Procedure`
    -- s 4(3)(a), (4)(b)-(c)
    `entitled to make the declaration`                  IS A BOOLEAN
    `declaration made on`                               IS A DATE
    `declaration accepted on`                           IS A MAYBE DATE
    -- s 4(3)(b), (4)(d): the first breach of a requirement of the procedure.
    `first breach on`                                   IS A MAYBE DATE
    -- s 5: the day the goods became liable to forfeiture.
    `liable to forfeiture on`                           IS A MAYBE DATE

DECLARE `Person` HAS
    `name`                                              IS A STRING
    -- s 6(1)
    `the declaration was made in their name`            IS A BOOLEAN
    -- s 6(2)
    `in possession or control on entry`                 IS A BOOLEAN
    -- s 6(3)(a)
    `the declaration was made on their behalf`          IS A BOOLEAN
    -- s 6(3)(b)-(d), (4): a customs agent, or otherwise involved in a breach
    -- with knowledge or reason to know.
    `otherwise liable under s 6(3)`                     IS A BOOLEAN

DECLARE `Duty facts` HAS
    -- s 7: the applicable rate after any provision under ss 9-15 and reliefs.
    `rate, percent`                                     IS A NUMBER
    -- s 16(2)-(3)
    `transaction value`                                 IS A NUMBER
    -- Sch 6 para 4(2)
    `an officer thinks an offence was committed`        IS A BOOLEAN
    `notified on`                                       IS A MAYBE DATE
