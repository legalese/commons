IMPORT prelude
IMPORT daydate

-- Insurance Act 2015 (UK) — THE NOUNS. Facts about the contract, the
-- presentation of the risk, warranties and terms, fraud and the claim. No
-- rules here. Source: ../registers/source-bundle/ukpga-2015-4.txt (point in
-- time 4 May 2017).

§ `Nouns`

DECLARE `Contract facts` HAS
    -- s 1: a consumer insurance contract within the 2012 Act.
    `a consumer insurance contract`                     IS A BOOLEAN
    `entered into on`                                   IS A DATE

-- ss 3(4)-(5), 7(3): one circumstance.
DECLARE `Circumstance` HAS
    -- s 7(3): would influence the judgement of a prudent insurer.
    `material`                                          IS A BOOLEAN
    -- ss 4, 6: the insured knows or ought to know it.
    `the insured knows or ought to know it`             IS A BOOLEAN
    `disclosed`                                         IS A BOOLEAN
    -- s 3(4)(b): enough was disclosed to put a prudent insurer on notice to
    -- enquire.
    `enough disclosed to put a prudent insurer on notice` IS A BOOLEAN
    `the insurer enquired about it`                     IS A BOOLEAN
    -- s 3(5)(a)-(e)
    `it diminishes the risk`                            IS A BOOLEAN
    `the insurer knows it`                              IS A BOOLEAN
    `the insurer ought to know it`                      IS A BOOLEAN
    `the insurer is presumed to know it`                IS A BOOLEAN
    `the insurer waives information about it`           IS A BOOLEAN

DECLARE `Presentation` HAS
    `circumstances`                                     IS A LIST OF `Circumstance`
    -- s 3(3)(b)
    `reasonably clear and accessible to a prudent insurer` IS A BOOLEAN
    -- s 3(3)(c), 7(5)
    `material representations of fact substantially correct` IS A BOOLEAN
    `material representations of expectation or belief in good faith` IS A BOOLEAN
    -- s 8(5): the insured knew it was in breach, or did not care.
    `the insured knew of the breach or did not care`    IS A BOOLEAN

-- s 8(1), Sch 1 para 4: what the insurer would have done but for the
-- breach.
DECLARE `What the insurer would have done` IS ONE OF
    `the same contract on the same terms`
    `no contract on any terms`
    `the contract, on these terms` HAS
        `different terms, other than the premium`       IS A BOOLEAN
        `the premium it would have charged`             IS A NUMBER

DECLARE `Money facts` HAS
    `the premium actually charged`                      IS A NUMBER
    `the premiums paid`                                 IS A NUMBER
    `the claim under the actual terms`                  IS A NUMBER
    `the claim under the different terms`               IS A NUMBER

-- s 10: a warranty that was breached.
DECLARE `Warranty breach` HAS
    `breached on`                                       IS A DATE
    -- s 10(5)-(6): NOTHING if not remedied (or it cannot be).
    `remedied on`                                       IS A MAYBE DATE
    -- s 10(3)
    `ceased to be applicable by a change of circumstances` IS A BOOLEAN
    `compliance made unlawful by a later law`           IS A BOOLEAN
    `the insurer waived the breach`                     IS A BOOLEAN

-- s 11: a term that was not complied with.
DECLARE `Term non-compliance` HAS
    `the term defines the risk as a whole`              IS A BOOLEAN
    -- s 11(1)(a)-(c)
    `compliance would tend to reduce the risk of loss of a particular kind, place or time` IS A BOOLEAN
    -- s 11(3)
    `the insured shows it could not have increased the risk of the actual loss` IS A BOOLEAN

DECLARE `Fraud facts` HAS
    -- s 12(1): this claim is fraudulent.
    `this claim is fraudulent`                          IS A BOOLEAN
    `sums already paid on this claim`                   IS A NUMBER
    -- An earlier fraudulent claim, for which the insurer gave notice treating
    -- the contract as terminated from the time of the fraudulent act;
    -- NOTHING if none.
    `terminated from a fraudulent act on`               IS A MAYBE DATE

DECLARE `Claim` HAS
    -- The relevant event (s 12(4)) and the loss (s 10).
    `the event occurred on`                             IS A DATE
