IMPORT prelude
IMPORT daydate
IMPORT `ia-types`
IMPORT `ia-presentation`
IMPORT `ia-terms-and-fraud`
IMPORT `ia-goal`

-- Insurance Act 2015 (UK) — the encoder's tests. Expected values are worked
-- by hand from the Act.

§ `Tests`

business MEANS `Contract facts` OF FALSE, Date 1 1 2025

-- Fields: material, knows, disclosed, on notice, enquired, diminishes,
-- insurer knows, ought to know, presumed, waives.
GIVEN material IS A BOOLEAN, knows IS A BOOLEAN, disclosed IS A BOOLEAN, notice IS A BOOLEAN, enquired IS A BOOLEAN,
      diminishes IS A BOOLEAN, insurerKnows IS A BOOLEAN
GIVETH A `Circumstance`
`circumstance, material` material `, known` knows `, disclosed` disclosed `, on notice` notice `, enquired` enquired `, diminishes` diminishes `, insurer knows` insurerKnows MEANS
    `Circumstance` OF material, knows, disclosed, notice, enquired, diminishes, insurerKnows, FALSE, FALSE, FALSE

undisclosed MEANS `circumstance, material` TRUE `, known` TRUE `, disclosed` FALSE `, on notice` FALSE `, enquired` FALSE `, diminishes` FALSE `, insurer knows` FALSE
told MEANS `circumstance, material` TRUE `, known` TRUE `, disclosed` TRUE `, on notice` FALSE `, enquired` FALSE `, diminishes` FALSE `, insurer knows` FALSE

GIVEN cs IS A LIST OF `Circumstance`
GIVETH A `Presentation`
`presenting` cs MEANS `Presentation` OF cs, TRUE, TRUE, TRUE, FALSE

GIVEN cs IS A LIST OF `Circumstance`
GIVETH A `Presentation`
`presenting knowingly` cs MEANS `Presentation` OF cs, TRUE, TRUE, TRUE, TRUE

fair MEANS `presenting` (LIST told)
unfair MEANS `presenting` (LIST told, undisclosed)
-- Premium charged £10,000 and paid; claim £200,000, or £150,000 under the
-- different terms.
money MEANS `Money facts` OF 10000, 10000, 200000, 150000

§§ `Goal 1 — application`

#ASSERT `the last day of the relevant period` EQUALS Date 11 8 2016
#ASSERT `Parts 2 to 4 apply to` business
#ASSERT `Parts 2 to 4 apply to` (`Contract facts` OF FALSE, Date 12 8 2016)
#ASSERT NOT (`Parts 2 to 4 apply to` (`Contract facts` OF FALSE, Date 11 8 2016))
#ASSERT NOT (`Parts 2 to 4 apply to` (`Contract facts` OF TRUE, Date 1 1 2025))

§§ `Goal 2 — fair presentation`

#ASSERT `a fair presentation was made in` fair
#ASSERT NOT (`a fair presentation was made in` unfair)
-- s 3(4)(b): enough to put a prudent insurer on notice.
#ASSERT `a fair presentation was made in` (`presenting` (LIST (`circumstance, material` TRUE `, known` TRUE `, disclosed` FALSE `, on notice` TRUE `, enquired` FALSE `, diminishes` FALSE `, insurer knows` FALSE)))
-- Not material, or not known: no duty.
#ASSERT `a fair presentation was made in` (`presenting` (LIST (`circumstance, material` FALSE `, known` TRUE `, disclosed` FALSE `, on notice` FALSE `, enquired` FALSE `, diminishes` FALSE `, insurer knows` FALSE)))
#ASSERT `a fair presentation was made in` (`presenting` (LIST (`circumstance, material` TRUE `, known` FALSE `, disclosed` FALSE `, on notice` FALSE `, enquired` FALSE `, diminishes` FALSE `, insurer knows` FALSE)))
-- s 3(5): absent enquiry, the insurer knows it, or it diminishes the risk;
-- but not if the insurer enquired.
#ASSERT `a fair presentation was made in` (`presenting` (LIST (`circumstance, material` TRUE `, known` TRUE `, disclosed` FALSE `, on notice` FALSE `, enquired` FALSE `, diminishes` FALSE `, insurer knows` TRUE)))
#ASSERT `a fair presentation was made in` (`presenting` (LIST (`circumstance, material` TRUE `, known` TRUE `, disclosed` FALSE `, on notice` FALSE `, enquired` FALSE `, diminishes` TRUE `, insurer knows` FALSE)))
#ASSERT NOT (`a fair presentation was made in` (`presenting` (LIST (`circumstance, material` TRUE `, known` TRUE `, disclosed` FALSE `, on notice` FALSE `, enquired` TRUE `, diminishes` FALSE `, insurer knows` TRUE))))
-- s 3(5)(c)-(e)
#ASSERT `a fair presentation was made in` (`presenting` (LIST (`Circumstance` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, FALSE)))
#ASSERT `a fair presentation was made in` (`presenting` (LIST (`Circumstance` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE)))
#ASSERT `a fair presentation was made in` (`presenting` (LIST (`Circumstance` OF TRUE, TRUE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, FALSE, TRUE)))
-- s 3(3)(b)-(c)
#ASSERT NOT (`a fair presentation was made in` (`Presentation` OF (LIST told), FALSE, TRUE, TRUE, FALSE))
#ASSERT NOT (`a fair presentation was made in` (`Presentation` OF (LIST told), TRUE, FALSE, TRUE, FALSE))
#ASSERT NOT (`a fair presentation was made in` (`Presentation` OF (LIST told), TRUE, TRUE, FALSE, FALSE))

-- s 8(1): inducement.
#ASSERT NOT (`there is a qualifying breach in` unfair `given` `the same contract on the same terms` `and` money)
#ASSERT `there is a qualifying breach in` unfair `given` `no contract on any terms` `and` money
#ASSERT `there is a qualifying breach in` unfair `given` (`the contract, on these terms` FALSE 12500) `and` money
#ASSERT NOT (`there is a qualifying breach in` fair `given` `no contract on any terms` `and` money)

-- Sch 1 para 2: deliberate or reckless — avoid, keep the premiums.
r1 MEANS `the remedy for the presentation in` (`presenting knowingly` (LIST undisclosed)) `given` (`the contract, on these terms` FALSE 12500) `and` money
#ASSERT r1's `may avoid the contract and refuse all claims`
#ASSERT r1's `must return the premiums paid` EQUALS 0
-- Para 4: not on any terms — avoid, return £10,000.
r2 MEANS `the remedy for the presentation in` unfair `given` `no contract on any terms` `and` money
#ASSERT r2's `may avoid the contract and refuse all claims`
#ASSERT r2's `must return the premiums paid` EQUALS 10000
-- Para 6: £12,500 instead of £10,000 — X = 80%: £160,000.
r3 MEANS `the remedy for the presentation in` unfair `given` (`the contract, on these terms` FALSE 12500) `and` money
#ASSERT NOT (r3's `may avoid the contract and refuse all claims`)
#ASSERT r3's `amount payable on the claim` EQUALS 160000
-- Paras 5 and 6: different terms (£150,000) and £20,000 — 50%: £75,000.
r4 MEANS `the remedy for the presentation in` unfair `given` (`the contract, on these terms` TRUE 20000) `and` money
#ASSERT r4's `contract treated as on the different terms`
#ASSERT r4's `amount payable on the claim` EQUALS 75000
-- Para 5 alone: £150,000.
r5 MEANS `the remedy for the presentation in` unfair `given` (`the contract, on these terms` TRUE 10000) `and` money
#ASSERT r5's `amount payable on the claim` EQUALS 150000

§§ `Goal 3 — warranties, other terms, fraud`

-- Breached 1 March 2025, remedied 1 May 2025.
warranty MEANS `Warranty breach` OF Date 1 3 2025, JUST (Date 1 5 2025), FALSE, FALSE, FALSE
#ASSERT NOT (`the breach of warranty` warranty `suspends liability for a loss on` (Date 28 2 2025))
#ASSERT NOT (`the breach of warranty` warranty `suspends liability for a loss on` (Date 1 3 2025))
#ASSERT `the breach of warranty` warranty `suspends liability for a loss on` (Date 2 3 2025)
#ASSERT `the breach of warranty` warranty `suspends liability for a loss on` (Date 30 4 2025)
#ASSERT NOT (`the breach of warranty` warranty `suspends liability for a loss on` (Date 1 5 2025))
-- Never remedied.
#ASSERT `the breach of warranty` (`Warranty breach` OF Date 1 3 2025, NOTHING, FALSE, FALSE, FALSE) `suspends liability for a loss on` (Date 1 1 2026)
-- s 10(3)
#ASSERT NOT (`the breach of warranty` (`Warranty breach` OF Date 1 3 2025, NOTHING, TRUE, FALSE, FALSE) `suspends liability for a loss on` (Date 1 4 2025))
#ASSERT NOT (`the breach of warranty` (`Warranty breach` OF Date 1 3 2025, NOTHING, FALSE, TRUE, FALSE) `suspends liability for a loss on` (Date 1 4 2025))
#ASSERT NOT (`the breach of warranty` (`Warranty breach` OF Date 1 3 2025, NOTHING, FALSE, FALSE, TRUE) `suspends liability for a loss on` (Date 1 4 2025))

-- s 11
#ASSERT NOT (`the insurer may rely on the non-compliance in` (`Term non-compliance` OF FALSE, TRUE, TRUE))
#ASSERT `the insurer may rely on the non-compliance in` (`Term non-compliance` OF FALSE, TRUE, FALSE)
#ASSERT `the insurer may rely on the non-compliance in` (`Term non-compliance` OF TRUE, TRUE, TRUE)
#ASSERT `the insurer may rely on the non-compliance in` (`Term non-compliance` OF FALSE, FALSE, TRUE)

-- s 12
noFraud MEANS `Fraud facts` OF FALSE, 0, NOTHING
#ASSERT NOT (`fraud excludes liability under` noFraud `for an event on` (Date 1 6 2025))
#ASSERT `fraud excludes liability under` (`Fraud facts` OF TRUE, 5000, NOTHING) `for an event on` (Date 1 6 2025)
#ASSERT `the sums the insurer may recover under` (`Fraud facts` OF TRUE, 5000, NOTHING) EQUALS 5000
-- Terminated from a fraudulent act on 1 April 2025: an event on 1 April is
-- not after it; 2 April is.
#ASSERT NOT (`fraud excludes liability under` (`Fraud facts` OF FALSE, 0, JUST (Date 1 4 2025)) `for an event on` (Date 1 4 2025))
#ASSERT `fraud excludes liability under` (`Fraud facts` OF FALSE, 0, JUST (Date 1 4 2025)) `for an event on` (Date 2 4 2025)

§§ `The top-level goal`

GIVEN d IS A DATE, w IS A `What the insurer would have done`, b IS A MAYBE `Warranty breach`, f IS A `Fraud facts`
GIVETH A `Claim case`
`a claim on` d `for` w `with warranty` b `and fraud` f MEANS
    `Claim case` OF business, unfair, w, money, (`Claim` OF d), b, NOTHING, f

pos1 MEANS `the claim position for` (`a claim on` (Date 1 6 2025) `for` (`the contract, on these terms` FALSE 12500) `with warranty` NOTHING `and fraud` noFraud)
#ASSERT pos1's `Parts 2 to 4 apply`
#ASSERT pos1's `qualifying breach`
#ASSERT pos1's `amount payable on the claim` EQUALS 160000
pos2 MEANS `the claim position for` (`a claim on` (Date 2 3 2025) `for` (`the contract, on these terms` FALSE 12500) `with warranty` (JUST warranty) `and fraud` noFraud)
#ASSERT pos2's `suspended by breach of warranty`
#ASSERT pos2's `amount payable on the claim` EQUALS 0
pos3 MEANS `the claim position for` (`a claim on` (Date 1 6 2025) `for` `the same contract on the same terms` `with warranty` (JUST warranty) `and fraud` (`Fraud facts` OF TRUE, 5000, NOTHING))
#ASSERT pos3's `excluded by fraud`
#ASSERT pos3's `amount payable on the claim` EQUALS 0
#ASSERT pos3's `sums the insurer may recover` EQUALS 5000
pos4 MEANS `the claim position for` (`a claim on` (Date 1 6 2025) `for` `no contract on any terms` `with warranty` NOTHING `and fraud` noFraud)
#ASSERT pos4's `amount payable on the claim` EQUALS 0
#ASSERT pos4's `remedy for the presentation`'s `must return the premiums paid` EQUALS 10000

§§ `Added after the independent pass`

-- s 22(2): Parts 3 and 4 also reach consumer contracts.
#ASSERT `Parts 3 and 4 apply to` (`Contract facts` OF TRUE, Date 1 1 2025)
#ASSERT NOT (`Parts 3 and 4 apply to` (`Contract facts` OF FALSE, Date 11 8 2016))
-- Para 5 "if the insurer so requires": different terms that would raise the
-- claim (£250,000) are not required: X = 80% of £200,000.
r6 MEANS `the remedy for the presentation in` unfair `given` (`the contract, on these terms` TRUE 12500) `and` (`Money facts` OF 10000, 10000, 200000, 250000)
#ASSERT NOT (r6's `contract treated as on the different terms`)
#ASSERT r6's `amount payable on the claim` EQUALS 160000
-- A consumer contract after 12 August 2016: no Part 2 remedy, but fraud
-- still excludes the claim.
consumerFraud MEANS `the claim position for` (`Claim case` OF (`Contract facts` OF TRUE, Date 1 1 2025), unfair, `no contract on any terms`, money, (`Claim` OF Date 1 6 2025), NOTHING, NOTHING, (`Fraud facts` OF TRUE, 0, NOTHING))
#ASSERT consumerFraud's `amount payable on the claim` EQUALS 0
#ASSERT consumerFraud's `Parts 3 and 4 apply`
#ASSERT NOT (consumerFraud's `Parts 2 to 4 apply`)
consumerClean MEANS `the claim position for` (`Claim case` OF (`Contract facts` OF TRUE, Date 1 1 2025), unfair, `no contract on any terms`, money, (`Claim` OF Date 1 6 2025), NOTHING, NOTHING, noFraud)
#ASSERT consumerClean's `amount payable on the claim` EQUALS 200000
