IMPORT prelude
IMPORT daydate
IMPORT `ia-types`
IMPORT `ia-presentation`
IMPORT `ia-terms-and-fraud`
IMPORT `ia-goal`

-- Independent tests for the Insurance Act 2015 encoding. Expected values were
-- fixed in independent-expectations.md from the Act and BRIEF.md before the
-- encoding was read. Scenario ids (A1, B2, ...) refer to that file. A failing
-- assertion is a finding; expected values are never changed to match.

§ `Builders`

GIVEN xc IS A BOOLEAN, xd IS A DATE
GIVETH A `Contract facts`
mkContract xc xd MEANS `Contract facts` OF xc, xd

GIVEN xm IS A BOOLEAN, xk IS A BOOLEAN, xd IS A BOOLEAN, xn IS A BOOLEAN, xe IS A BOOLEAN,
      xa IS A BOOLEAN, xb IS A BOOLEAN, xo IS A BOOLEAN, xp IS A BOOLEAN, xw IS A BOOLEAN
GIVETH A `Circumstance`
mkCirc xm xk xd xn xe xa xb xo xp xw MEANS
    `Circumstance` OF xm, xk, xd, xn, xe, xa, xb, xo, xp, xw

-- material, known, nothing disclosed, no notice, no enquiry, no exception
bad MEANS mkCirc TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE
good MEANS mkCirc TRUE TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE

GIVEN xs IS A LIST OF `Circumstance`
      xr IS A BOOLEAN
      xf IS A BOOLEAN
      xg IS A BOOLEAN
      xk IS A BOOLEAN
GIVETH A `Presentation`
mkPres xs xr xf xg xk MEANS `Presentation` OF xs, xr, xf, xg, xk

GIVEN xs IS A LIST OF `Circumstance`
GIVETH A `Presentation`
okPres xs MEANS mkPres xs TRUE TRUE TRUE FALSE

GIVEN xs IS A LIST OF `Circumstance`
GIVETH A BOOLEAN
fairWith xs MEANS `a fair presentation was made in` (okPres xs)

GIVEN xa IS A NUMBER, xb IS A NUMBER, xc IS A NUMBER, xd IS A NUMBER
GIVETH A `Money facts`
mkMoney xa xb xc xd MEANS `Money facts` OF xa, xb, xc, xd

GIVEN xd IS A BOOLEAN, xh IS A NUMBER
GIVETH A `What the insurer would have done`
terms xd xh MEANS `the contract, on these terms` OF xd, xh

-- premium 10,000 charged and paid; claim 100,000 actual, 60,000 different
stdMoney MEANS mkMoney 10000 10000 100000 60000

innocentBreach MEANS mkPres (LIST bad) TRUE TRUE TRUE FALSE
knowingBreach MEANS mkPres (LIST bad) TRUE TRUE TRUE TRUE

GIVEN xb IS A DATE, xr IS A MAYBE DATE, xc IS A BOOLEAN, xu IS A BOOLEAN, xw IS A BOOLEAN
GIVETH A `Warranty breach`
mkWarranty xb xr xc xu xw MEANS `Warranty breach` OF xb, xr, xc, xu, xw

GIVEN xb IS A DATE, xr IS A MAYBE DATE
GIVETH A `Warranty breach`
plainWarranty xb xr MEANS mkWarranty xb xr FALSE FALSE FALSE

stdWarranty MEANS plainWarranty (Date 10 3 2020) (JUST (Date 20 3 2020))
neverRemedied MEANS plainWarranty (Date 10 3 2020) NOTHING

GIVEN xd IS A DATE
GIVETH A BOOLEAN
suspStd xd MEANS `the breach of warranty` stdWarranty `suspends liability for a loss on` xd

GIVEN xd IS A DATE
GIVETH A BOOLEAN
suspNever xd MEANS `the breach of warranty` neverRemedied `suspends liability for a loss on` xd

GIVEN xd IS A BOOLEAN, xr IS A BOOLEAN, xs IS A BOOLEAN
GIVETH A `Term non-compliance`
mkTerm xd xr xs MEANS `Term non-compliance` OF xd, xr, xs

GIVEN xf IS A BOOLEAN, xs IS A NUMBER, xt IS A MAYBE DATE
GIVETH A `Fraud facts`
mkFraud xf xs xt MEANS `Fraud facts` OF xf, xs, xt

noFraud MEANS mkFraud FALSE 0 NOTHING
terminatedJune MEANS mkFraud FALSE 0 (JUST (Date 1 6 2021))

GIVEN xd IS A DATE
GIVETH A BOOLEAN
fraudJune xd MEANS `fraud excludes liability under` terminatedJune `for an event on` xd

business MEANS mkContract FALSE (Date 1 1 2020)

GIVEN xp IS A `Presentation`, xw IS A `What the insurer would have done`, xm IS A `Money facts`,
      xd IS A DATE, xb IS A MAYBE `Warranty breach`, xt IS A MAYBE `Term non-compliance`, xf IS A `Fraud facts`
GIVETH A `Claim case`
mkCase xp xw xm xd xb xt xf MEANS
    `Claim case` OF business, xp, xw, xm, (`Claim` OF xd), xb, xt, xf

GIVEN xc IS A `Claim case`
GIVETH A NUMBER
payable xc MEANS
    pos's `amount payable on the claim`
    WHERE pos MEANS `the claim position for` xc

GIVEN xp IS A `Presentation`, xw IS A `What the insurer would have done`, xm IS A `Money facts`
GIVETH A NUMBER
remedyAmount xp xw xm MEANS
    rr's `amount payable on the claim`
    WHERE rr MEANS `the remedy for the presentation in` xp `given` xw `and` xm

GIVEN xp IS A `Presentation`, xw IS A `What the insurer would have done`, xm IS A `Money facts`
GIVETH A BOOLEAN
remedyAvoids xp xw xm MEANS
    rr's `may avoid the contract and refuse all claims`
    WHERE rr MEANS `the remedy for the presentation in` xp `given` xw `and` xm

GIVEN xp IS A `Presentation`, xw IS A `What the insurer would have done`, xm IS A `Money facts`
GIVETH A NUMBER
remedyReturns xp xw xm MEANS
    rr's `must return the premiums paid`
    WHERE rr MEANS `the remedy for the presentation in` xp `given` xw `and` xm

GIVEN xp IS A `Presentation`, xw IS A `What the insurer would have done`, xm IS A `Money facts`
GIVETH A BOOLEAN
qualifies xp xw xm MEANS `there is a qualifying breach in` xp `given` xw `and` xm

§ `A. Application`

-- A1
#ASSERT `Parts 2 to 4 apply to` (mkContract FALSE (Date 12 8 2016))
-- A2
#ASSERT NOT (`Parts 2 to 4 apply to` (mkContract FALSE (Date 11 8 2016)))
-- A3
#ASSERT NOT (`Parts 2 to 4 apply to` (mkContract FALSE (Date 12 2 2015)))
-- A4
#ASSERT `Parts 2 to 4 apply to` (mkContract FALSE (Date 1 1 2020))
-- A5
#ASSERT NOT (`Parts 2 to 4 apply to` (mkContract FALSE (Date 12 2 2016)))
-- A6 (Part 2 at least does not apply to a consumer contract)
#ASSERT NOT (`Parts 2 to 4 apply to` (mkContract TRUE (Date 1 1 2020)))
-- A7
#ASSERT NOT (`Parts 2 to 4 apply to` (mkContract TRUE (Date 11 8 2016)))
-- A8
#ASSERT `Parts 2 to 4 apply to` (mkContract FALSE (Date 13 8 2016))
-- relevant period end
#ASSERT `the last day of the relevant period` EQUALS Date 11 8 2016

§ `B. Circumstance by circumstance`

-- B1 known, disclosed
#ASSERT fairWith (LIST good)
-- B2 known, not disclosed, nothing else
#ASSERT NOT (fairWith (LIST bad))
-- B3 ought to know (same input flag), not disclosed
#ASSERT NOT (`the disclosure required by s 3(4) was made of` bad)
-- B4 neither knows nor ought to know
#ASSERT fairWith (LIST (mkCirc TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))
-- B5 notice given
#ASSERT fairWith (LIST (mkCirc TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE))
-- B6 diminishes the risk, no enquiry
#ASSERT fairWith (LIST (mkCirc TRUE TRUE FALSE FALSE FALSE TRUE FALSE FALSE FALSE FALSE))
-- B7 insurer knows
#ASSERT fairWith (LIST (mkCirc TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE))
-- B8 insurer ought to know
#ASSERT fairWith (LIST (mkCirc TRUE TRUE FALSE FALSE FALSE FALSE FALSE TRUE FALSE FALSE))
-- B9 insurer presumed to know
#ASSERT fairWith (LIST (mkCirc TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE TRUE FALSE))
-- B10 insurer waives information
#ASSERT fairWith (LIST (mkCirc TRUE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE TRUE))
-- B11 enquiry, diminishes the risk
#ASSERT NOT (fairWith (LIST (mkCirc TRUE TRUE FALSE FALSE TRUE TRUE FALSE FALSE FALSE FALSE)))
-- B12 enquiry, insurer knows
#ASSERT NOT (fairWith (LIST (mkCirc TRUE TRUE FALSE FALSE TRUE FALSE TRUE FALSE FALSE FALSE)))
-- B13 enquiry, waiver
#ASSERT NOT (fairWith (LIST (mkCirc TRUE TRUE FALSE FALSE TRUE FALSE FALSE FALSE FALSE TRUE)))
-- B14 enquiry, disclosed
#ASSERT fairWith (LIST (mkCirc TRUE TRUE TRUE FALSE TRUE FALSE FALSE FALSE FALSE FALSE))
-- B15 enquiry, notice given
#ASSERT fairWith (LIST (mkCirc TRUE TRUE FALSE TRUE TRUE FALSE FALSE FALSE FALSE FALSE))
-- B16 not material
#ASSERT fairWith (LIST (mkCirc FALSE TRUE FALSE FALSE FALSE FALSE FALSE FALSE FALSE FALSE))
-- B: all five exceptions together but enquiry made
#ASSERT NOT (fairWith (LIST (mkCirc TRUE TRUE FALSE FALSE TRUE TRUE TRUE TRUE TRUE TRUE)))

§ `C. The presentation as a whole`

-- C1
#ASSERT `a fair presentation was made in` (okPres (LIST good, good))
-- C2 not clear and accessible
#ASSERT NOT (`a fair presentation was made in` (mkPres (LIST good) FALSE TRUE TRUE FALSE))
-- C3 factual representation not substantially correct
#ASSERT NOT (`a fair presentation was made in` (mkPres (LIST good) TRUE FALSE TRUE FALSE))
-- C3b expectation or belief not in good faith
#ASSERT NOT (`a fair presentation was made in` (mkPres (LIST good) TRUE TRUE FALSE FALSE))
-- C4 one of two fails
#ASSERT NOT (`a fair presentation was made in` (okPres (LIST good, bad)))
-- C5 no circumstances
#ASSERT `a fair presentation was made in` (okPres (LIST))
-- C6 one disclosed, one excepted (insurer knows)
#ASSERT fairWith (LIST good, (mkCirc TRUE TRUE FALSE FALSE FALSE FALSE TRUE FALSE FALSE FALSE))

§ `D. Qualifying breach`

-- D1 same contract, same terms
#ASSERT NOT (qualifies innocentBreach `the same contract on the same terms` stdMoney)
-- D1b on "these terms" which are the same terms and the same premium
#ASSERT NOT (qualifies innocentBreach (terms FALSE 10000) stdMoney)
-- D2 no contract on any terms
#ASSERT qualifies innocentBreach `no contract on any terms` stdMoney
-- D3 different non-premium terms
#ASSERT qualifies innocentBreach (terms TRUE 10000) stdMoney
-- D4 higher premium only
#ASSERT qualifies innocentBreach (terms FALSE 15000) stdMoney
-- D5 no breach
#ASSERT NOT (qualifies (okPres (LIST good)) `no contract on any terms` stdMoney)
-- D9 not qualifying though insured knew: full claim, no avoidance
#ASSERT remedyAmount knowingBreach `the same contract on the same terms` stdMoney EQUALS 100000
#ASSERT NOT (remedyAvoids knowingBreach `the same contract on the same terms` stdMoney)

§ `E. Schedule 1 Part 1 remedies`

-- E1 / D6-D7 deliberate or reckless: avoid, refuse all, keep premiums
#ASSERT remedyAvoids knowingBreach `no contract on any terms` stdMoney
#ASSERT remedyReturns knowingBreach `no contract on any terms` stdMoney EQUALS 0
#ASSERT remedyAmount knowingBreach `no contract on any terms` stdMoney EQUALS 0
-- E9 deliberate, though only a higher premium would have been charged
#ASSERT remedyAvoids knowingBreach (terms FALSE 15000) stdMoney
#ASSERT remedyReturns knowingBreach (terms FALSE 15000) stdMoney EQUALS 0
-- E2 innocent, no contract on any terms: avoid, return premiums
#ASSERT remedyAvoids innocentBreach `no contract on any terms` stdMoney
#ASSERT remedyReturns innocentBreach `no contract on any terms` stdMoney EQUALS 10000
#ASSERT remedyAmount innocentBreach `no contract on any terms` stdMoney EQUALS 0
-- E3 innocent, different terms (claim 60,000 under them), same premium
#ASSERT remedyAmount innocentBreach (terms TRUE 10000) stdMoney EQUALS 60000
#ASSERT NOT (remedyAvoids innocentBreach (terms TRUE 10000) stdMoney)
-- E4' para 5 "if the insurer so requires": an insurer would not require terms
-- under which it pays more (different-terms claim 120,000 > 100,000)
#ASSERT remedyAmount innocentBreach (terms TRUE 10000) (mkMoney 10000 10000 100000 120000) EQUALS 100000
-- E5 10,000 vs 15,000: two-thirds of 100,000
#ASSERT remedyAmount innocentBreach (terms FALSE 15000) stdMoney EQUALS 200000 DIVIDED BY 3
-- E6 1,000 vs 2,000: 50%
#ASSERT remedyAmount innocentBreach (terms FALSE 2000) (mkMoney 1000 1000 100000 0) EQUALS 50000
-- E7 paras 5 and 6 together: 80,000 under different terms, 8,000 vs 10,000
#ASSERT remedyAmount innocentBreach (terms TRUE 10000) (mkMoney 8000 8000 100000 80000) EQUALS 64000
-- E8 different terms exclude the claim, and higher premium
#ASSERT remedyAmount innocentBreach (terms TRUE 20000) (mkMoney 10000 10000 100000 0) EQUALS 0
-- E10 no qualifying breach
#ASSERT remedyAmount innocentBreach `the same contract on the same terms` stdMoney EQUALS 100000
-- E11 3,000 vs 4,000 on 20,000: 15,000
#ASSERT remedyAmount innocentBreach (terms FALSE 4000) (mkMoney 3000 3000 20000 0) EQUALS 15000
-- E12 no contract at all: no proportional payment
#ASSERT remedyAmount innocentBreach `no contract on any terms` (mkMoney 3000 3000 20000 0) EQUALS 0
-- fair presentation: remedy leaves full claim
#ASSERT remedyAmount (okPres (LIST good)) (terms FALSE 15000) stdMoney EQUALS 100000

§ `F. s 10 suspension`

-- F1
#ASSERT suspStd (Date 15 3 2020)
-- F2 breach day
#ASSERT NOT (suspStd (Date 10 3 2020))
-- F3
#ASSERT suspStd (Date 11 3 2020)
-- F4
#ASSERT suspStd (Date 19 3 2020)
-- F5 remedy day
#ASSERT NOT (suspStd (Date 20 3 2020))
-- F6
#ASSERT NOT (suspStd (Date 21 3 2020))
-- F7
#ASSERT NOT (suspStd (Date 9 3 2020))
-- F8 never remedied
#ASSERT suspNever (Date 1 1 2021)
-- F9
#ASSERT NOT (suspNever (Date 10 3 2020))
-- F10
#ASSERT suspNever (Date 11 3 2020)
-- F11 ceased to be applicable
#ASSERT NOT (`the breach of warranty` (mkWarranty (Date 10 3 2020) (JUST (Date 20 3 2020)) TRUE FALSE FALSE) `suspends liability for a loss on` (Date 15 3 2020))
-- F12 compliance unlawful
#ASSERT NOT (`the breach of warranty` (mkWarranty (Date 10 3 2020) (JUST (Date 20 3 2020)) FALSE TRUE FALSE) `suspends liability for a loss on` (Date 15 3 2020))
-- F13 waived
#ASSERT NOT (`the breach of warranty` (mkWarranty (Date 10 3 2020) (JUST (Date 20 3 2020)) FALSE FALSE TRUE) `suspends liability for a loss on` (Date 15 3 2020))
-- F15 never remedied, waived
#ASSERT NOT (`the breach of warranty` (mkWarranty (Date 10 3 2020) NOTHING FALSE FALSE TRUE) `suspends liability for a loss on` (Date 1 1 2021))
-- F16 breach 31 Dec, remedy 1 Jan, loss 1 Jan
#ASSERT NOT (`the breach of warranty` (plainWarranty (Date 31 12 2020) (JUST (Date 1 1 2021))) `suspends liability for a loss on` (Date 1 1 2021))
-- F16b same, loss 31 Dec
#ASSERT NOT (`the breach of warranty` (plainWarranty (Date 31 12 2020) (JUST (Date 1 1 2021))) `suspends liability for a loss on` (Date 31 12 2020))
-- F17 month edge: breach 29 Feb 2020, remedy 2 Mar 2020, loss 1 Mar 2020
#ASSERT `the breach of warranty` (plainWarranty (Date 29 2 2020) (JUST (Date 2 3 2020))) `suspends liability for a loss on` (Date 1 3 2020)

§ `G. s 11`

-- G1
#ASSERT NOT (`the insurer may rely on the non-compliance in` (mkTerm FALSE TRUE TRUE))
-- G2
#ASSERT `the insurer may rely on the non-compliance in` (mkTerm FALSE TRUE FALSE)
-- G3 defines the risk as a whole
#ASSERT `the insurer may rely on the non-compliance in` (mkTerm TRUE TRUE TRUE)
-- G5 not a risk-reducing term of s 11(1)
#ASSERT `the insurer may rely on the non-compliance in` (mkTerm FALSE FALSE TRUE)

§ `H. s 12 fraud`

-- H1 this claim fraudulent
#ASSERT `fraud excludes liability under` (mkFraud TRUE 5000 NOTHING) `for an event on` (Date 1 6 2021)
#ASSERT `the sums the insurer may recover under` (mkFraud TRUE 5000 NOTHING) EQUALS 5000
-- H2 event after the fraudulent act
#ASSERT fraudJune (Date 2 6 2021)
-- H3 event before
#ASSERT NOT (fraudJune (Date 31 5 2021))
-- H4 same day
#ASSERT NOT (fraudJune (Date 1 6 2021))
-- H5 no termination
#ASSERT NOT (`fraud excludes liability under` noFraud `for an event on` (Date 2 6 2021))
-- H7 no fraud: nothing to recover
#ASSERT `the sums the insurer may recover under` (mkFraud FALSE 5000 NOTHING) EQUALS 0
-- H8 fraudulent claim whose event precedes an earlier termination date: still not liable
#ASSERT `fraud excludes liability under` (mkFraud TRUE 0 (JUST (Date 1 6 2021))) `for an event on` (Date 1 1 2021)

§ `I. The overall amount payable`

-- I1 clean
#ASSERT payable (mkCase (okPres (LIST good)) `the same contract on the same terms` stdMoney (Date 15 3 2020) NOTHING NOTHING noFraud) EQUALS 100000
-- I2 innocent breach, 10,000 vs 12,500: 80,000
#ASSERT payable (mkCase innocentBreach (terms FALSE 12500) stdMoney (Date 15 3 2020) NOTHING NOTHING noFraud) EQUALS 80000
-- I3 as I2, loss inside suspension
#ASSERT payable (mkCase innocentBreach (terms FALSE 12500) stdMoney (Date 15 3 2020) (JUST stdWarranty) NOTHING noFraud) EQUALS 0
-- I4 as I2, loss on the remedy day
#ASSERT payable (mkCase innocentBreach (terms FALSE 12500) stdMoney (Date 20 3 2020) (JUST stdWarranty) NOTHING noFraud) EQUALS 80000
-- I5 fraudulent claim
#ASSERT payable (mkCase (okPres (LIST good)) `the same contract on the same terms` stdMoney (Date 15 3 2020) NOTHING NOTHING (mkFraud TRUE 0 NOTHING)) EQUALS 0
-- I6 deliberate breach
#ASSERT payable (mkCase knowingBreach (terms FALSE 12500) stdMoney (Date 15 3 2020) NOTHING NOTHING noFraud) EQUALS 0
-- I7 s 11 term breached, insured shows
#ASSERT payable (mkCase (okPres (LIST good)) `the same contract on the same terms` stdMoney (Date 15 3 2020) NOTHING (JUST (mkTerm FALSE TRUE TRUE)) noFraud) EQUALS 100000
-- I8 s 11 term breached, insured cannot show
#ASSERT payable (mkCase (okPres (LIST good)) `the same contract on the same terms` stdMoney (Date 15 3 2020) NOTHING (JUST (mkTerm FALSE TRUE FALSE)) noFraud) EQUALS 0
-- I9 paras 5 and 6
#ASSERT payable (mkCase innocentBreach (terms TRUE 10000) (mkMoney 8000 8000 100000 80000) (Date 15 3 2020) NOTHING NOTHING noFraud) EQUALS 64000
-- I11 terminated 1 Jun 2021, loss 2 Jun 2021
#ASSERT payable (mkCase (okPres (LIST good)) `the same contract on the same terms` stdMoney (Date 2 6 2021) NOTHING NOTHING terminatedJune) EQUALS 0
-- I12 terminated 1 Jun 2021, loss 31 May 2021, innocent breach at 50%
#ASSERT payable (mkCase innocentBreach (terms FALSE 20000) stdMoney (Date 31 5 2021) NOTHING NOTHING terminatedJune) EQUALS 50000
-- I13 terminated 1 Jun 2021, loss on 1 Jun 2021 (same day, R10)
#ASSERT payable (mkCase (okPres (LIST good)) `the same contract on the same terms` stdMoney (Date 1 6 2021) NOTHING NOTHING terminatedJune) EQUALS 100000
-- I14 innocent no-contract breach: avoided, nothing payable
#ASSERT payable (mkCase innocentBreach `no contract on any terms` stdMoney (Date 15 3 2020) NOTHING NOTHING noFraud) EQUALS 0
-- I15 never-remedied warranty, loss a year later
#ASSERT payable (mkCase (okPres (LIST good)) `the same contract on the same terms` stdMoney (Date 1 3 2021) (JUST neverRemedied) NOTHING noFraud) EQUALS 0
-- I16 position flags for I2
i2 MEANS `the claim position for` (mkCase innocentBreach (terms FALSE 12500) stdMoney (Date 15 3 2020) NOTHING NOTHING noFraud)
#ASSERT i2's `Parts 2 to 4 apply`
#ASSERT NOT (i2's `fair presentation made`)
#ASSERT i2's `qualifying breach`
#ASSERT NOT (i2's `suspended by breach of warranty`)
#ASSERT NOT (i2's `excluded by fraud`)
-- I17 sums recoverable on a fraudulent claim
i17 MEANS `the claim position for` (mkCase (okPres (LIST good)) `the same contract on the same terms` stdMoney (Date 15 3 2020) NOTHING NOTHING (mkFraud TRUE 7500 NOTHING))
#ASSERT i17's `sums the insurer may recover` EQUALS 7500
