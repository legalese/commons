IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra2-s44-jsa-commitment`

-- wra2-tests-s44-jsa-commitment.l4: tests for s 44 (JSA 1(2)(b), 9, 10, 35(1)).
-- Expected values are written from the text of the Act (inputs/ukpga-2012-5.txt lines 521-577), not from the output.

§ `s 44(2) JSA 1(2)(b)`

-- line 523: the condition is "accepted a claimant commitment"; JSA 9(9) (line 552): regulations may treat a claimant as having satisfied it
#ASSERT `s 44(2) JSA 1(2)(b) the claimant satisfies the condition of having accepted a claimant commitment` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 44(2) JSA 1(2)(b) the claimant satisfies the condition of having accepted a claimant commitment` TRUE (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 44(2) JSA 1(2)(b) the claimant satisfies the condition of having accepted a claimant commitment` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 44(2) JSA 1(2)(b) the claimant satisfies the condition of having accepted a claimant commitment` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 44(2) JSA 1(2)(b) the claimant satisfies the condition of having accepted a claimant commitment` FALSE NOTHING EQUALS NOTHING

§ `s 44 JSA 9(1): the definition`

#ASSERT `s 44 JSA 9(1) the award is an award of a jobseeker's allowance` `contribution-based jobseeker's allowance`
#ASSERT `s 44 JSA 9(1) the award is an award of a jobseeker's allowance` `income-based jobseeker's allowance`
#ASSERT NOT (`s 44 JSA 9(1) the award is an award of a jobseeker's allowance` `universal credit`)
#ASSERT NOT (`s 44 JSA 9(1) the award is an award of a jobseeker's allowance` `income support`)
#ASSERT `s 44 JSA 9(1) the document is a claimant commitment` TRUE `income-based jobseeker's allowance`
#ASSERT `s 44 JSA 9(1) the document is a claimant commitment` TRUE `contribution-based jobseeker's allowance`
#ASSERT NOT (`s 44 JSA 9(1) the document is a claimant commitment` FALSE `income-based jobseeker's allowance`)
#ASSERT NOT (`s 44 JSA 9(1) the document is a claimant commitment` TRUE `income support`)

§ `s 44 JSA 9(2): what the commitment shall be and include`

#ASSERT `s 44 JSA 9(2) the claimant commitment is as the subsection requires` `an employment officer` TRUE (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 44 JSA 9(2) the claimant commitment is as the subsection requires` `an employment officer` TRUE NOTHING TRUE EQUALS NOTHING
#ASSERT `s 44 JSA 9(2) the claimant commitment is as the subsection requires` `an employment officer` TRUE (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 44 JSA 9(2) the claimant commitment is as the subsection requires` `the Secretary of State` TRUE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 44 JSA 9(2) the claimant commitment is as the subsection requires` `an employment officer` FALSE (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 44 JSA 9(2) the claimant commitment is as the subsection requires` `an employment officer` TRUE (JUST TRUE) FALSE EQUALS JUST FALSE
-- a failed paragraph (a) answers no even when the prescribed information (c) is unknown
#ASSERT `s 44 JSA 9(2) the claimant commitment is as the subsection requires` `the Secretary of State` TRUE NOTHING TRUE EQUALS JUST FALSE

§ `s 44 JSA 9(3): information that may be included`

#ASSERT `s 44 JSA 9(3) the information may be included under subsection (2)(d)` `s 44 JSA 9(3)(a) information on the conditions of availability and actively seeking employment` EQUALS JUST TRUE
#ASSERT `s 44 JSA 9(3) the information may be included under subsection (2)(d)` `s 44 JSA 9(3)(b) details of a requirement under regulations under section 8 or 17A or a jobseeker's direction` EQUALS JUST TRUE
#ASSERT `s 44 JSA 9(3) the information may be included under subsection (2)(d)` `s 44 JSA 9(3)(c) details of the consequences of a failure to comply with such a requirement` EQUALS JUST TRUE
#ASSERT `s 44 JSA 9(3) the information may be included under subsection (2)(d)` `s 44 JSA 9(3) some other kind of information` EQUALS NOTHING

§ `s 44 JSA 9(4)-(6): inviting, referring`

#ASSERT `s 44 JSA 9(4) the claimant is not barred from being invited by an employment officer to accept the claimant commitment` TRUE EQUALS JUST TRUE
#ASSERT `s 44 JSA 9(4) the claimant is not barred from being invited by an employment officer to accept the claimant commitment` FALSE EQUALS JUST FALSE
#ASSERT `s 44 JSA 9(5) the employment officer must refer the proposed claimant commitment to the Secretary of State forthwith` TRUE EQUALS JUST TRUE
#ASSERT `s 44 JSA 9(5) the employment officer must refer the proposed claimant commitment to the Secretary of State forthwith` FALSE EQUALS NOTHING
#ASSERT `s 44 JSA 9(6) the reference under subsection (5) may relate to that information` `s 44 JSA 9(3)(a) information on the conditions of availability and actively seeking employment`
#ASSERT NOT (`s 44 JSA 9(6) the reference under subsection (5) may relate to that information` `s 44 JSA 9(3)(b) details of a requirement under regulations under section 8 or 17A or a jobseeker's direction`)
#ASSERT NOT (`s 44 JSA 9(6) the reference under subsection (5) may relate to that information` `s 44 JSA 9(3)(c) details of the consequences of a failure to comply with such a requirement`)

§ `s 44 JSA 9(7): the Secretary of State on a reference`

-- 14 days from the date of the reference: a reference on 1 March 2013 must be disposed of by 15 March 2013 (fork F-44-1)
#ASSERT `s 44 JSA 9(7)(a) the last day of the period of 14 days from the date of the reference` (Date 1 3 2013) EQUALS Date 15 3 2013
#ASSERT `s 44 JSA 9(7)(a) the Secretary of State has disposed of the reference in time` (Date 1 3 2013) (Date 15 3 2013) TRUE EQUALS JUST TRUE
#ASSERT `s 44 JSA 9(7)(a) the Secretary of State has disposed of the reference in time` (Date 1 3 2013) (Date 1 3 2013) FALSE EQUALS JUST TRUE
#ASSERT `s 44 JSA 9(7)(a) the Secretary of State has disposed of the reference in time` (Date 1 3 2013) (Date 16 3 2013) TRUE EQUALS JUST FALSE
#ASSERT `s 44 JSA 9(7)(a) the Secretary of State has disposed of the reference in time` (Date 1 3 2013) (Date 16 3 2013) FALSE EQUALS NOTHING
-- a reference on 20 February 2013 (2013 is not a leap year): the 14th day is 6 March
#ASSERT `s 44 JSA 9(7)(a) the last day of the period of 14 days from the date of the reference` (Date 20 2 2013) EQUALS Date 6 3 2013
#ASSERT `s 44 JSA 9(7)(b) the Secretary of State may give directions on the terms of the proposed claimant commitment` TRUE EQUALS JUST TRUE
#ASSERT `s 44 JSA 9(7)(b) the Secretary of State may give directions on the terms of the proposed claimant commitment` FALSE EQUALS NOTHING
#ASSERT `s 44 JSA 9(7)(c) the date on which the proposed claimant commitment is treated as accepted` TRUE TRUE TRUE (Date 4 3 2013) EQUALS JUST (Date 4 3 2013)
#ASSERT `s 44 JSA 9(7)(c) the date on which the proposed claimant commitment is treated as accepted` FALSE TRUE TRUE (Date 4 3 2013) EQUALS NOTHING
#ASSERT `s 44 JSA 9(7)(c) the date on which the proposed claimant commitment is treated as accepted` TRUE FALSE TRUE (Date 4 3 2013) EQUALS NOTHING
#ASSERT `s 44 JSA 9(7)(c) the date on which the proposed claimant commitment is treated as accepted` TRUE TRUE FALSE (Date 4 3 2013) EQUALS NOTHING

#TRACE `s 44 JSA 9(7)(a) the Secretary of State must dispose of the reference within 14 days` AT 0 WITH
    PARTY `the Secretary of State` DOES `s 44 JSA 9(7)(a) dispose of the reference` AT 14

#TRACE `s 44 JSA 9(7)(a) the Secretary of State must dispose of the reference within 14 days` AT 0 WITH
    PARTY `the Secretary of State` DOES `s 44 JSA 9(7)(a) dispose of the reference` AT 15

§ `s 44 JSA 9(10): acceptance`

#ASSERT `s 44 JSA 9(10) the claimant accepts the claimant commitment` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 44 JSA 9(10) the claimant accepts the claimant commitment` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 44 JSA 9(10) the claimant accepts the claimant commitment` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 44 JSA 9(10) the claimant accepts the claimant commitment` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 44 JSA 9(10) the claimant accepts the claimant commitment` FALSE NOTHING EQUALS JUST FALSE

§ `s 44 JSA 10: variation`

#ASSERT `s 44 JSA 10(1) the claimant commitment may be varied by that person` `an employment officer` EQUALS JUST TRUE
#ASSERT `s 44 JSA 10(1) the claimant commitment may be varied by that person` `the Secretary of State` EQUALS NOTHING
#ASSERT `s 44 JSA 10(2) the employment officer is not barred from varying the claimant commitment` TRUE EQUALS JUST TRUE
#ASSERT `s 44 JSA 10(2) the employment officer is not barred from varying the claimant commitment` FALSE EQUALS JUST FALSE
#ASSERT `s 44 JSA 10(4) the variation is a relevant variation` TRUE
#ASSERT NOT (`s 44 JSA 10(4) the variation is a relevant variation` FALSE)
#ASSERT `s 44 JSA 10(3) the employment officer has notified the claimant before making the variation` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 44 JSA 10(3) the employment officer has notified the claimant before making the variation` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 44 JSA 10(3) the employment officer has notified the claimant before making the variation` FALSE FALSE EQUALS NOTHING
#ASSERT `s 44 JSA 10(5) the employment officer must refer the proposed variation to the Secretary of State forthwith` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 44 JSA 10(5) the employment officer must refer the proposed variation to the Secretary of State forthwith` TRUE (JUST FALSE) EQUALS NOTHING
#ASSERT `s 44 JSA 10(5) the employment officer must refer the proposed variation to the Secretary of State forthwith` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 44 JSA 10(5) the employment officer must refer the proposed variation to the Secretary of State forthwith` FALSE (JUST TRUE) EQUALS NOTHING
#ASSERT `s 44 JSA 10(6)(a) the Secretary of State has disposed of the reference in time` (Date 1 3 2013) (Date 15 3 2013) TRUE EQUALS JUST TRUE
#ASSERT `s 44 JSA 10(6)(a) the Secretary of State has disposed of the reference in time` (Date 1 3 2013) (Date 16 3 2013) TRUE EQUALS JUST FALSE
#ASSERT `s 44 JSA 10(6)(a) the Secretary of State has disposed of the reference in time` (Date 1 3 2013) (Date 16 3 2013) FALSE EQUALS NOTHING
#ASSERT `s 44 JSA 10(6)(b) the Secretary of State must give directions on whether and on what terms the claimant commitment is varied` TRUE EQUALS JUST TRUE
#ASSERT `s 44 JSA 10(6)(b) the Secretary of State must give directions on whether and on what terms the claimant commitment is varied` FALSE EQUALS NOTHING
#ASSERT `s 44 JSA 10(6)(c) the date on which the claimant commitment as varied is treated as accepted` TRUE TRUE TRUE (Date 9 4 2013) EQUALS JUST (Date 9 4 2013)
#ASSERT `s 44 JSA 10(6)(c) the date on which the claimant commitment as varied is treated as accepted` TRUE FALSE TRUE (Date 9 4 2013) EQUALS NOTHING

#TRACE `s 44 JSA 10(3) the employment officer must notify the claimant of a proposed relevant variation` AT 0 WITH
    PARTY `an employment officer` DOES `s 44 JSA 10(3) notify the claimant of the proposed variation` AT 3

§ `s 44(5) JSA 35(1): employment officer`

#ASSERT `s 44(5) JSA 35(1) the person is an employment officer` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 44(5) JSA 35(1) the person is an employment officer` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 44(5) JSA 35(1) the person is an employment officer` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 44(5) JSA 35(1) the person is an employment officer` FALSE NOTHING EQUALS NOTHING
