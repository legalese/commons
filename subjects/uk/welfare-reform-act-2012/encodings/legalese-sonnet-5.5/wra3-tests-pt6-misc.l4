IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra3-pt4-s77-84`
IMPORT `wra3-pt6-misc`

-- Tests for wra3-pt6-misc.l4 (Part 6, sections 135 to 146). Expected values are written from the text (raw lines 2477-2578),
-- decided before running, never copied from the output. Dates are invented.

`s 138 CSA 9A(2) a child aged 12` MEANS Person WITH
    `reference` IS "C12"
    `age in years` IS 12
    `date of birth` IS Date 1 1 2014
    `where the person is` IS Scotland
    `where the person lives` IS Scotland

`s 138 CSA 9A(2) a child aged 11` MEANS Person WITH
    `reference` IS "C11"
    `age in years` IS 11
    `date of birth` IS Date 1 1 2015
    `where the person is` IS Scotland
    `where the person lives` IS Scotland

§ `s 135`

-- RSA 19A(1): functions include transmit and verify, for the purposes of the service in (2)
#ASSERT `s 135 RSA 19A(1) the functions of a registrar include the power to transmit and verify the information for the Secretary of State` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 135 RSA 19A(1) the functions of a registrar include the power to transmit and verify the information for the Secretary of State` TRUE FALSE EQUALS NOTHING
#ASSERT `s 135 RSA 19A(1) the functions of a registrar include the power to transmit and verify the information for the Secretary of State` FALSE TRUE EQUALS NOTHING
-- RSA 19A(2): the service
#ASSERT `s 135 RSA 19A(2) the arrangement is the service in subsection (2)` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 135 RSA 19A(2) the arrangement is the service in subsection (2)` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 135 RSA 19A(2) the arrangement is the service in subsection (2)` FALSE TRUE TRUE EQUALS NOTHING
-- RSA 19A(3): references to the Secretary of State include persons providing services for the service
#ASSERT `s 135 RSA 19A(3) the person is within the references to the Secretary of State in subsections (1) and (2)` TRUE EQUALS JUST TRUE
#ASSERT `s 135 RSA 19A(3) the person is within the references to the Secretary of State in subsections (1) and (2)` FALSE EQUALS NOTHING
-- RSA 19A(4): no authority for a disclosure that is unlawful by an enactment or by confidentiality or privacy law
#ASSERT `s 135 RSA 19A(4) the section authorises the disclosure` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 135 RSA 19A(4) the section authorises the disclosure` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 135 RSA 19A(4) the section authorises the disclosure` TRUE TRUE EQUALS JUST FALSE
#ASSERT `s 135 RSA 19A(4) the section authorises the disclosure` FALSE FALSE EQUALS NOTHING

§ `s 136`

#ASSERT `s 136(1) CSA 9(2A)(a) the Secretary of State may take the step` TRUE EQUALS JUST TRUE
#ASSERT `s 136(1) CSA 9(2A)(a) the Secretary of State may take the step` FALSE EQUALS NOTHING
-- before accepting an application the Secretary of State may invite; after acceptance the text is silent
#ASSERT `s 136(1) CSA 9(2A)(b) the Secretary of State may invite the applicant to consider whether it is possible to make a maintenance agreement` FALSE EQUALS JUST TRUE
#ASSERT `s 136(1) CSA 9(2A)(b) the Secretary of State may invite the applicant to consider whether it is possible to make a maintenance agreement` TRUE EQUALS NOTHING
#ASSERT `s 136(2) CMOPA Sch 5 para 3(3) the Secretary of State may invite the applicant to consider whether it is possible to make a maintenance agreement` TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 136(2) CMOPA Sch 5 para 3(3) the Secretary of State may invite the applicant to consider whether it is possible to make a maintenance agreement` TRUE TRUE EQUALS NOTHING
#ASSERT `s 136(2) CMOPA Sch 5 para 3(3) the Secretary of State may invite the applicant to consider whether it is possible to make a maintenance agreement` FALSE FALSE EQUALS NOTHING

§ `s 137`

-- CSA 4(2A): the Secretary of State may ONLY make arrangements if the non-resident parent agrees OR the Secretary of State is satisfied
#ASSERT `s 137(2) CSA 4(2A) the condition for arrangements under section 4(2)(a) is met` TRUE FALSE
#ASSERT `s 137(2) CSA 4(2A) the condition for arrangements under section 4(2)(a) is met` FALSE TRUE
#ASSERT NOT (`s 137(2) CSA 4(2A) the condition for arrangements under section 4(2)(a) is met` FALSE FALSE)
#ASSERT `s 137(2) CSA 4(2A) the Secretary of State may make arrangements under section 4(2)(a)` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 137(2) CSA 4(2A) the Secretary of State may make arrangements under section 4(2)(a)` TRUE FALSE EQUALS NOTHING
#ASSERT `s 137(2) CSA 4(2A) the Secretary of State may make arrangements under section 4(2)(a)` FALSE TRUE EQUALS NOTHING
-- CSA 7(3A): the same condition for section 7(3)(a)
#ASSERT `s 137(3) CSA 7(3A) the condition for arrangements under section 7(3)(a) is met` TRUE FALSE
#ASSERT `s 137(3) CSA 7(3A) the condition for arrangements under section 7(3)(a) is met` FALSE TRUE
#ASSERT NOT (`s 137(3) CSA 7(3A) the condition for arrangements under section 7(3)(a) is met` FALSE FALSE)
#ASSERT `s 137(3) CSA 7(3A) the Secretary of State may make arrangements under section 7(3)(a)` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 137(3) CSA 7(3A) the Secretary of State may make arrangements under section 7(3)(a)` TRUE TRUE EQUALS NOTHING
-- CSA 29(1): collection is subject to 4(2A) and 7(3A)
#ASSERT `s 137(4) CSA 29(1) the Secretary of State may make the arrangement for collection, subject to sections 4(2A) and 7(3A)` `s 137(4) an arrangement under section 4(2)(a) of the Child Support Act 1991` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 137(4) CSA 29(1) the Secretary of State may make the arrangement for collection, subject to sections 4(2A) and 7(3A)` `s 137(4) an arrangement under section 4(2)(a) of the Child Support Act 1991` TRUE FALSE EQUALS NOTHING
#ASSERT `s 137(4) CSA 29(1) the Secretary of State may make the arrangement for collection, subject to sections 4(2A) and 7(3A)` `s 137(4) an arrangement under section 7(3)(a) of the Child Support Act 1991` FALSE FALSE EQUALS JUST FALSE
#ASSERT `s 137(4) CSA 29(1) the Secretary of State may make the arrangement for collection, subject to sections 4(2A) and 7(3A)` `s 137(4) an arrangement under section 7(3)(a) of the Child Support Act 1991` FALSE TRUE EQUALS NOTHING
#ASSERT `s 137(4) CSA 29(1) the Secretary of State may make the arrangement for collection, subject to sections 4(2A) and 7(3A)` `s 137(4) any other arrangement` FALSE FALSE EQUALS NOTHING

§ `s 138`

-- CSA 9A(1): a person with care or non-resident parent in relation to a qualifying child may apply
#ASSERT `s 138 CSA 9A(1) the person may apply for an indicative calculation` `s 138 a person with care` TRUE EQUALS JUST TRUE
#ASSERT `s 138 CSA 9A(1) the person may apply for an indicative calculation` `s 138 a non-resident parent` TRUE EQUALS JUST TRUE
#ASSERT `s 138 CSA 9A(1) the person may apply for an indicative calculation` `s 138 a person with care` FALSE EQUALS NOTHING
#ASSERT `s 138 CSA 9A(1) the person may apply for an indicative calculation` `s 138 a non-resident parent` FALSE EQUALS NOTHING
#ASSERT `s 138 CSA 9A(1) the person may apply for an indicative calculation` `s 138 neither a person with care nor a non-resident parent` TRUE EQUALS NOTHING
-- CSA 9A(2): a qualifying child aged 12 or over and habitually resident in Scotland may apply for themselves: 12 yes, 11 not covered
#ASSERT `s 138 CSA 9A(2) the child may apply for an indicative calculation with respect to themselves` `s 138 CSA 9A(2) a child aged 12` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 138 CSA 9A(2) the child may apply for an indicative calculation with respect to themselves` `s 138 CSA 9A(2) a child aged 11` TRUE TRUE EQUALS NOTHING
#ASSERT `s 138 CSA 9A(2) the child may apply for an indicative calculation with respect to themselves` `s 138 CSA 9A(2) a child aged 12` TRUE FALSE EQUALS NOTHING
#ASSERT `s 138 CSA 9A(2) the child may apply for an indicative calculation with respect to themselves` `s 138 CSA 9A(2) a child aged 12` FALSE TRUE EQUALS NOTHING
-- CSA 9A(3): definition
#ASSERT `s 138 CSA 9A(3) the calculation is an indicative calculation` TRUE EQUALS JUST TRUE
#ASSERT `s 138 CSA 9A(3) the calculation is an indicative calculation` FALSE EQUALS NOTHING
-- CSA 9A(4): an indicative calculation does not create any liability
#ASSERT `s 138 CSA 9A(4) the calculation creates a liability to pay child support maintenance` TRUE EQUALS JUST FALSE
#ASSERT `s 138 CSA 9A(4) the calculation creates a liability to pay child support maintenance` FALSE EQUALS NOTHING
-- CSA 9A(5): a limit of 2 (invented): the 1st and 2nd applications are not barred; once 2 have been accepted the text does not say
#ASSERT `s 138 CSA 9A(5) the application is not barred by a limit on the number of applications` FALSE 2 5 EQUALS JUST TRUE
#ASSERT `s 138 CSA 9A(5) the application is not barred by a limit on the number of applications` TRUE 2 0 EQUALS JUST TRUE
#ASSERT `s 138 CSA 9A(5) the application is not barred by a limit on the number of applications` TRUE 2 1 EQUALS JUST TRUE
#ASSERT `s 138 CSA 9A(5) the application is not barred by a limit on the number of applications` TRUE 2 2 EQUALS NOTHING
#ASSERT `s 138 CSA 9A(5) the application is not barred by a limit on the number of applications` TRUE 2 3 EQUALS NOTHING
-- CSA 9A(6): shall not assume parentage where the alleged parent denies it, unless Case A3(b)
#ASSERT `s 138 CSA 9A(6) the Secretary of State is not barred from making the calculation on the assumption that the person is a parent` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 138 CSA 9A(6) the Secretary of State is not barred from making the calculation on the assumption that the person is a parent` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 138 CSA 9A(6) the Secretary of State is not barred from making the calculation on the assumption that the person is a parent` TRUE TRUE EQUALS JUST TRUE

§ `s 139`

#ASSERT `s 139 CSA 43 the regulations power under section 5(1)(p) of the Social Security Administration Act 1992 may be exercised to secure the payment` `s 139 a payment in respect of child support maintenance by a non-resident parent` EQUALS JUST TRUE
#ASSERT `s 139 CSA 43 the regulations power under section 5(1)(p) of the Social Security Administration Act 1992 may be exercised to secure the payment` `s 139 arrears of child support maintenance` EQUALS JUST TRUE
#ASSERT `s 139 CSA 43 the regulations power under section 5(1)(p) of the Social Security Administration Act 1992 may be exercised to secure the payment` `s 139 fees payable under section 6 of the Child Maintenance and Other Payments Act 2008` EQUALS JUST TRUE
#ASSERT `s 139 CSA 43 the regulations power under section 5(1)(p) of the Social Security Administration Act 1992 may be exercised to secure the payment` `s 139 any other payment` EQUALS NOTHING

§ `s 141`

-- first fees regulations in force on 1 October 2020 (invented): 30 months end on 31 March 2023
#ASSERT `s 141 CMOPA 6(3B) the last day of the 30 months beginning with the day the first fees regulations come into force` (Date 1 10 2020) EQUALS Date 31 3 2023
#ASSERT `s 141 CMOPA 6(3B) the review took place within the 30 months` (Date 1 10 2020) (Date 31 3 2023)
#ASSERT NOT (`s 141 CMOPA 6(3B) the review took place within the 30 months` (Date 1 10 2020) (Date 1 4 2023))
-- in force on 15 October 2020: 30 months end on 14 April 2023
#ASSERT `s 141 CMOPA 6(3B) the last day of the 30 months beginning with the day the first fees regulations come into force` (Date 15 10 2020) EQUALS Date 14 4 2023
#ASSERT `s 141 CMOPA 6(3B) the review took place within the 30 months` (Date 15 10 2020) (Date 14 4 2023)
#ASSERT NOT (`s 141 CMOPA 6(3B) the review took place within the 30 months` (Date 15 10 2020) (Date 15 4 2023))
-- the regulative rule: 1 October 2020 to 31 March 2023 is 911 days; the review on day 911 is in time, on day 912 is a breach
-- (read from the printed result: the stable binary cannot compare DEONTIC values in an #ASSERT)
#TRACE `s 141 the duty to review the effect of the first fees regulations` (Date 1 10 2020) AT 0 WITH
    PARTY `the Secretary of State` DOES `s 141 review the effect of the first fees regulations` AT 911

#TRACE `s 141 the duty to review the effect of the first fees regulations` (Date 1 10 2020) AT 0 WITH
    PARTY `the Secretary of State` DOES `s 141 review the effect of the first fees regulations` AT 912

-- (3C)-(3D): the report contains the conclusions and a statement and is laid; the text states no consequence and no time limit
#ASSERT `s 141 CMOPA 6(3C)-(3D) the Secretary of State has done what the report provisions require` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 141 CMOPA 6(3C)-(3D) the Secretary of State has done what the report provisions require` TRUE TRUE FALSE EQUALS NOTHING
#ASSERT `s 141 CMOPA 6(3C)-(3D) the Secretary of State has done what the report provisions require` FALSE TRUE TRUE EQUALS NOTHING

§ `s 142`

#ASSERT `s 142(1) IA 382(5) the liability is a debt or liability for the purposes of Part 8 of the Insolvency Act 1986` TRUE EQUALS JUST FALSE
#ASSERT `s 142(1) IA 382(5) the liability is a debt or liability for the purposes of Part 8 of the Insolvency Act 1986` FALSE EQUALS NOTHING

§ `s 144`

-- ETA 2A(2): employment for sexual purposes if (a) an activity AND (b) reasonably assumed intended to stimulate sexually
#ASSERT `s 144 ETA 2A(2) the employment is employment for sexual purposes` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 144 ETA 2A(2) the employment is employment for sexual purposes` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 144 ETA 2A(2) the employment is employment for sexual purposes` FALSE TRUE EQUALS JUST FALSE
-- ETA 2A(1): may not include arrangements for such employment, (3) unless an order specifies an exception
#ASSERT `s 144 ETA 2A(1) the arrangements under section 2 are not barred from including arrangements in respect of the employment` (JUST FALSE) NOTHING EQUALS JUST TRUE
#ASSERT `s 144 ETA 2A(1) the arrangements under section 2 are not barred from including arrangements in respect of the employment` (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 144 ETA 2A(1) the arrangements under section 2 are not barred from including arrangements in respect of the employment` (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 144 ETA 2A(1) the arrangements under section 2 are not barred from including arrangements in respect of the employment` (JUST TRUE) NOTHING EQUALS NOTHING
#ASSERT `s 144 ETA 2A(1) the arrangements under section 2 are not barred from including arrangements in respect of the employment` NOTHING (JUST TRUE) EQUALS NOTHING
