IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra4-ss121-126`

-- Tests for wra4-ss121-126.l4. Every expected value is written from the text of the Act, beside the assertion.

§ `s 121 cautions`

#ASSERT `s 121(1)(c) SSFA 6B(1)(c) a caution is a ground for the loss of benefit` TRUE EQUALS JUST FALSE
#ASSERT `s 121(1)(c) SSFA 6B(1)(c) a caution is a ground for the loss of benefit` FALSE EQUALS NOTHING

§ `s 122 SSAA 109A(9)`

#ASSERT `s 122 SSAA 109A(9)(a) the legislation is treated as relevant social security legislation` TRUE EQUALS JUST TRUE
#ASSERT `s 122 SSAA 109A(9)(a) the legislation is treated as relevant social security legislation` FALSE EQUALS NOTHING
#ASSERT `s 122 SSAA 109A(9)(b) the benefit is treated as a relevant social security benefit for the definition of benefit offence` `child tax credit` EQUALS JUST TRUE
#ASSERT `s 122 SSAA 109A(9)(b) the benefit is treated as a relevant social security benefit for the definition of benefit offence` `working tax credit` EQUALS JUST TRUE
#ASSERT `s 122 SSAA 109A(9)(b) the benefit is treated as a relevant social security benefit for the definition of benefit offence` `housing benefit` EQUALS NOTHING

§ `s 123 SSAA 122B(3)(d)`

#ASSERT `s 123(3)(c) SSAA 122B(3)(d) paragraph (d) is met` TRUE EQUALS JUST TRUE
#ASSERT `s 123(3)(c) SSAA 122B(3)(d) paragraph (d) is met` FALSE EQUALS NOTHING

§ `s 124 TCA 35: mode of trial`

-- up to and including 20,000 pounds: summarily only; above it: either way
#ASSERT `s 124 TCA 35(2) the mode of trial` 0 EQUALS `s 124 TCA 35(2) triable summarily only`
#ASSERT `s 124 TCA 35(2) the mode of trial` 20000 EQUALS `s 124 TCA 35(2) triable summarily only`
#ASSERT `s 124 TCA 35(2) the mode of trial` 20000.01 EQUALS `s 124 TCA 35(5) triable either on indictment or summarily`
#ASSERT `s 124 TCA 35(2) the mode of trial` 150000 EQUALS `s 124 TCA 35(5) triable either on indictment or summarily`

§ `s 124 TCA 35: the applicable terms`

#ASSERT `s 124 TCA 35(4) the applicable term` `England outside Greater London` EQUALS JUST `s 124 TCA 35(4)(a) a term of 51 weeks`
#ASSERT `s 124 TCA 35(4) the applicable term` `Greater London` EQUALS JUST `s 124 TCA 35(4)(a) a term of 51 weeks`
#ASSERT `s 124 TCA 35(4) the applicable term` Wales EQUALS JUST `s 124 TCA 35(4)(a) a term of 51 weeks`
#ASSERT `s 124 TCA 35(4) the applicable term` Scotland EQUALS JUST `s 124 TCA 35 a term of 6 months`
#ASSERT `s 124 TCA 35(4) the applicable term` `Northern Ireland` EQUALS JUST `s 124 TCA 35 a term of 6 months`
#ASSERT `s 124 TCA 35(4) the applicable term` `outside the United Kingdom` EQUALS NOTHING
#ASSERT `s 124 TCA 35(7) the applicable term` Wales EQUALS JUST `s 124 TCA 35(7)(a) a term of 12 months`
#ASSERT `s 124 TCA 35(7) the applicable term` Scotland EQUALS JUST `s 124 TCA 35(7)(a) a term of 12 months`
#ASSERT `s 124 TCA 35(7) the applicable term` `Northern Ireland` EQUALS JUST `s 124 TCA 35 a term of 6 months`
#ASSERT `s 124 TCA 35(7) the applicable term` `outside the United Kingdom` EQUALS NOTHING
-- (8), (9): before commencement, 51 weeks and 12 months are read as 6 months; only for the figure each subsection names
#ASSERT `s 124 TCA 35(8) the term as read for an offence committed before commencement` `s 124 TCA 35(4)(a) a term of 51 weeks` TRUE EQUALS `s 124 TCA 35 a term of 6 months`
#ASSERT `s 124 TCA 35(8) the term as read for an offence committed before commencement` `s 124 TCA 35(4)(a) a term of 51 weeks` FALSE EQUALS `s 124 TCA 35(4)(a) a term of 51 weeks`
#ASSERT `s 124 TCA 35(8) the term as read for an offence committed before commencement` `s 124 TCA 35(7)(a) a term of 12 months` TRUE EQUALS `s 124 TCA 35(7)(a) a term of 12 months`
#ASSERT `s 124 TCA 35(9) the term as read for an offence committed before commencement` `s 124 TCA 35(7)(a) a term of 12 months` TRUE EQUALS `s 124 TCA 35 a term of 6 months`
#ASSERT `s 124 TCA 35(9) the term as read for an offence committed before commencement` `s 124 TCA 35(7)(a) a term of 12 months` FALSE EQUALS `s 124 TCA 35(7)(a) a term of 12 months`
#ASSERT `s 124 TCA 35(9) the term as read for an offence committed before commencement` `s 124 TCA 35(4)(a) a term of 51 weeks` TRUE EQUALS `s 124 TCA 35(4)(a) a term of 51 weeks`

§ `s 124 TCA 35: the greatest punishments`

-- (3): summary conviction of an offence triable summarily only: 51 weeks (England and Wales) or 6 months, or a fine up to level 5
#ASSERT `s 124 TCA 35(3) the greatest punishment on summary conviction for an offence triable summarily only` Wales FALSE EQUALS JUST (`s 124 TCA 35 punishment` WITH `the term of imprisonment not exceeded` IS `s 124 TCA 35(4)(a) a term of 51 weeks`, `the fine not exceeded` IS `s 124 TCA 35(3) level 5 on the standard scale`)
#ASSERT `s 124 TCA 35(3) the greatest punishment on summary conviction for an offence triable summarily only` Wales TRUE EQUALS JUST (`s 124 TCA 35 punishment` WITH `the term of imprisonment not exceeded` IS `s 124 TCA 35 a term of 6 months`, `the fine not exceeded` IS `s 124 TCA 35(3) level 5 on the standard scale`)
#ASSERT `s 124 TCA 35(3) the greatest punishment on summary conviction for an offence triable summarily only` Scotland FALSE EQUALS JUST (`s 124 TCA 35 punishment` WITH `the term of imprisonment not exceeded` IS `s 124 TCA 35 a term of 6 months`, `the fine not exceeded` IS `s 124 TCA 35(3) level 5 on the standard scale`)
#ASSERT `s 124 TCA 35(3) the greatest punishment on summary conviction for an offence triable summarily only` `outside the United Kingdom` FALSE EQUALS NOTHING
-- (6)(a): summary conviction of an offence triable either way: 12 months (England and Wales, Scotland) or 6 months, or a fine up to the statutory maximum
#ASSERT `s 124 TCA 35(6)(a) the greatest punishment on summary conviction for an offence triable either way` `England outside Greater London` FALSE EQUALS JUST (`s 124 TCA 35 punishment` WITH `the term of imprisonment not exceeded` IS `s 124 TCA 35(7)(a) a term of 12 months`, `the fine not exceeded` IS `s 124 TCA 35(6)(a) the statutory maximum`)
#ASSERT `s 124 TCA 35(6)(a) the greatest punishment on summary conviction for an offence triable either way` `England outside Greater London` TRUE EQUALS JUST (`s 124 TCA 35 punishment` WITH `the term of imprisonment not exceeded` IS `s 124 TCA 35 a term of 6 months`, `the fine not exceeded` IS `s 124 TCA 35(6)(a) the statutory maximum`)
#ASSERT `s 124 TCA 35(6)(a) the greatest punishment on summary conviction for an offence triable either way` `Northern Ireland` FALSE EQUALS JUST (`s 124 TCA 35 punishment` WITH `the term of imprisonment not exceeded` IS `s 124 TCA 35 a term of 6 months`, `the fine not exceeded` IS `s 124 TCA 35(6)(a) the statutory maximum`)
#ASSERT `s 124 TCA 35(6)(a) the greatest punishment on summary conviction for an offence triable either way` `outside the United Kingdom` FALSE EQUALS NOTHING
-- (6)(b): conviction on indictment: 7 years, or a fine, or both
#ASSERT `s 124 TCA 35(6)(b) the greatest punishment on conviction on indictment` EQUALS (`s 124 TCA 35 punishment` WITH `the term of imprisonment not exceeded` IS `s 124 TCA 35(6)(b) a term of 7 years`, `the fine not exceeded` IS `s 124 TCA 35(6)(b) a fine without a stated limit`)

§ `s 126 definitions`

#ASSERT `s 126(11) the benefit is a tax credit` `child tax credit` EQUALS TRUE
#ASSERT `s 126(11) the benefit is a tax credit` `working tax credit` EQUALS TRUE
#ASSERT `s 126(11) the benefit is a tax credit` `universal credit` EQUALS FALSE
#ASSERT `s 126(11) the benefit is a tax credit` `state pension credit` EQUALS FALSE
#ASSERT `s 126(13) the body is the Commissioners` `Her Majesty's Revenue and Customs` EQUALS TRUE
#ASSERT `s 126(13) the body is the Commissioners` `the Secretary of State` EQUALS FALSE
#ASSERT `s 126(13) the legislation is primary legislation` `s 126(13) an Act, including the Welfare Reform Act 2012` EQUALS TRUE
#ASSERT `s 126(13) the legislation is primary legislation` `s 126(13) Northern Ireland legislation` EQUALS TRUE
#ASSERT `s 126(13) the legislation is primary legislation` `s 126(13) an instrument made under primary legislation, including an Order in Council under section 126` EQUALS FALSE
#ASSERT `s 126(13) the legislation is secondary legislation` `s 126(13) an instrument made under primary legislation, including an Order in Council under section 126` EQUALS TRUE
#ASSERT `s 126(13) the legislation is secondary legislation` `s 126(13) an Act, including the Welfare Reform Act 2012` EQUALS FALSE
#ASSERT `s 126(13) the legislation is secondary legislation` `s 126(13) some other kind of legislation` EQUALS FALSE
#ASSERT `s 126(13) the function is a tax credit function` TRUE TRUE EQUALS TRUE
#ASSERT `s 126(13) the function is a tax credit function` TRUE FALSE EQUALS FALSE
#ASSERT `s 126(13) the function is a tax credit function` FALSE TRUE EQUALS FALSE
