IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra1-ch3-general`

-- Tests for wra1-ch3-general.l4 (sections 33, 37, 38, 39, 40, 41 of the Welfare Reform Act 2012).
-- Every expected value is written by hand from the text quoted in the module, beside the assertion.

§ `Fixtures`

GIVEN age IS A NUMBER
GIVETH A Person
`s 40 test: a person of age` MEANS Person WITH
    `reference` IS "T"
    `age in years` IS age
    `date of birth` IS Date 1 1 2000     -- placeholder: no rule reads it
    `where the person is` IS Wales
    `where the person lives` IS Wales

GIVEN married IS A BOOLEAN, household IS A BOOLEAN, living IS A BOOLEAN
GIVETH A `Two people`
`s 39(1) test: two people` MEANS `Two people` WITH
    `the first person` IS `s 40 test: a person of age` 30
    `the second person` IS `s 40 test: a person of age` 31
    `their relationship` IS `Relationship of two people` WITH
        `married to each other or civil partners of each other` IS married
        `members of the same household` IS household
        `living together as if married or civil partners` IS living

§ `s 33 -- abolition of benefits`

-- s 33(1)(a)-(f) name seven of the core's benefits; the list is not closed, so any other benefit is NOTHING
#ASSERT `s 33(1) the benefit is abolished` `income-based jobseeker's allowance` EQUALS JUST TRUE
#ASSERT `s 33(1) the benefit is abolished` `income-related employment and support allowance` EQUALS JUST TRUE
#ASSERT `s 33(1) the benefit is abolished` `income support` EQUALS JUST TRUE
#ASSERT `s 33(1) the benefit is abolished` `housing benefit` EQUALS JUST TRUE
#ASSERT `s 33(1) the benefit is abolished` `council tax benefit` EQUALS JUST TRUE
#ASSERT `s 33(1) the benefit is abolished` `child tax credit` EQUALS JUST TRUE
#ASSERT `s 33(1) the benefit is abolished` `working tax credit` EQUALS JUST TRUE
#ASSERT `s 33(1) the benefit is abolished` `contribution-based jobseeker's allowance` EQUALS NOTHING
#ASSERT `s 33(1) the benefit is abolished` `universal credit` EQUALS NOTHING
#ASSERT `s 33(1) the benefit is abolished` `personal independence payment` EQUALS NOTHING
-- s 33(2): both limbs are definitions that say "means" or "has the same meaning"
#ASSERT `s 33(2)(a) the allowance is income-based jobseeker's allowance` TRUE EQUALS TRUE
#ASSERT `s 33(2)(a) the allowance is income-based jobseeker's allowance` FALSE EQUALS FALSE
#ASSERT `s 33(2)(b) the allowance is income-related employment and support allowance` TRUE EQUALS TRUE
#ASSERT `s 33(2)(b) the allowance is income-related employment and support allowance` FALSE EQUALS FALSE

§ `s 37 -- limited capability for work or work-related activity`

-- s 37(1): "if (a) ... and (b) ...": both limbs are needed
#ASSERT `s 37(1) the claimant has limited capability for work on the Act's own test` TRUE TRUE EQUALS TRUE
#ASSERT `s 37(1) the claimant has limited capability for work on the Act's own test` TRUE FALSE EQUALS FALSE
#ASSERT `s 37(1) the claimant has limited capability for work on the Act's own test` FALSE TRUE EQUALS FALSE
#ASSERT `s 37(1) the claimant has limited capability for work on the Act's own test` FALSE FALSE EQUALS FALSE
-- s 37(2): the same two limbs for work-related activity
#ASSERT `s 37(2) the claimant has limited capability for work-related activity on the Act's own test` TRUE TRUE EQUALS TRUE
#ASSERT `s 37(2) the claimant has limited capability for work-related activity on the Act's own test` TRUE FALSE EQUALS FALSE
#ASSERT `s 37(2) the claimant has limited capability for work-related activity on the Act's own test` FALSE TRUE EQUALS FALSE
-- s 37(3): the determination under regulations governs; without it the answer is not covered
#ASSERT `s 37(3) the claimant has limited capability as determined in accordance with regulations` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 37(3) the claimant has limited capability as determined in accordance with regulations` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 37(3) the claimant has limited capability as determined in accordance with regulations` NOTHING EQUALS NOTHING

§ `s 38 -- information`

#ASSERT `s 38 the information is information relating to social security` TRUE EQUALS JUST TRUE
-- the section says nothing about information supplied in any other way
#ASSERT `s 38 the information is information relating to social security` FALSE EQUALS NOTHING

§ `s 39 -- couples`

-- s 39(1)(a): married or civil partners AND members of the same household
#ASSERT `s 39(1) the two people are a couple` (`s 39(1) test: two people` TRUE TRUE FALSE) EQUALS TRUE
-- married, but not members of the same household and not living together: neither limb
#ASSERT `s 39(1) the two people are a couple` (`s 39(1) test: two people` TRUE FALSE FALSE) EQUALS FALSE
-- married, in different households, but living together as if married: limb (b) needs them NOT to be married, so neither limb
#ASSERT `s 39(1) the two people are a couple` (`s 39(1) test: two people` TRUE FALSE TRUE) EQUALS FALSE
-- s 39(1)(b): not married or civil partners but living together as if they were
#ASSERT `s 39(1) the two people are a couple` (`s 39(1) test: two people` FALSE FALSE TRUE) EQUALS TRUE
#ASSERT `s 39(1) the two people are a couple` (`s 39(1) test: two people` FALSE TRUE TRUE) EQUALS TRUE
#ASSERT `s 39(1) the two people are a couple` (`s 39(1) test: two people` FALSE TRUE FALSE) EQUALS FALSE
#ASSERT `s 39(1) the two people are a couple` (`s 39(1) test: two people` FALSE FALSE FALSE) EQUALS FALSE
-- married, same household, and also living together as if married: limb (a) holds
#ASSERT `s 39(1) the two people are a couple` (`s 39(1) test: two people` TRUE TRUE TRUE) EQUALS TRUE
-- s 39(3): with no regulations supplied the Act's own words (s 39(1)) apply
#ASSERT `s 39(3) the two people are a couple once the regulations supplied are applied` (`s 39(1) test: two people` TRUE TRUE FALSE) NOTHING NOTHING NOTHING EQUALS TRUE
#ASSERT `s 39(3) the two people are a couple once the regulations supplied are applied` (`s 39(1) test: two people` TRUE FALSE FALSE) NOTHING NOTHING NOTHING EQUALS FALSE
-- s 39(3)(a): regulations disregard the marriage, so limb (a) fails; they are not living together as if married, so no couple
#ASSERT `s 39(3) the two people are a couple once the regulations supplied are applied` (`s 39(1) test: two people` TRUE TRUE FALSE) (JUST TRUE) NOTHING NOTHING EQUALS FALSE
-- s 39(3)(a) with living together: the marriage is disregarded and they live together as if married, so limb (b)
#ASSERT `s 39(3) the two people are a couple once the regulations supplied are applied` (`s 39(1) test: two people` TRUE TRUE TRUE) (JUST TRUE) NOTHING NOTHING EQUALS TRUE
-- s 39(3)(b): regulations treat them as living together as if married
#ASSERT `s 39(3) the two people are a couple once the regulations supplied are applied` (`s 39(1) test: two people` FALSE FALSE FALSE) NOTHING (JUST TRUE) NOTHING EQUALS TRUE
-- s 39(3)(c): regulations treat married people as not members of the same household, so limb (a) fails
#ASSERT `s 39(3) the two people are a couple once the regulations supplied are applied` (`s 39(1) test: two people` TRUE TRUE FALSE) NOTHING NOTHING (JUST FALSE) EQUALS FALSE
-- s 39(3)(c): regulations treat married people in different households as members of the same household
#ASSERT `s 39(3) the two people are a couple once the regulations supplied are applied` (`s 39(1) test: two people` TRUE FALSE FALSE) NOTHING NOTHING (JUST TRUE) EQUALS TRUE

§ `s 40 -- interpretation: where each term gets its meaning (one assertion per entry of the list)`

#ASSERT `s 40 where the meaning is given` `s 40 assessment period` EQUALS "section 7(2)"
#ASSERT `s 40 where the meaning is given` `s 40 child` EQUALS "section 40"
#ASSERT `s 40 where the meaning is given` `s 40 claim` EQUALS "section 40"
#ASSERT `s 40 where the meaning is given` `s 40 claimant` EQUALS "section 40"
#ASSERT `s 40 where the meaning is given` `s 40 couple` EQUALS "section 39"
#ASSERT `s 40 where the meaning is given` `s 40 disabled` EQUALS "regulations"
#ASSERT `s 40 where the meaning is given` `s 40 joint claimants` EQUALS "section 40"
#ASSERT `s 40 where the meaning is given` `s 40 limited capability for work` EQUALS "section 37(1)"
#ASSERT `s 40 where the meaning is given` `s 40 limited capability for work-related activity` EQUALS "section 37(2)"
#ASSERT `s 40 where the meaning is given` `s 40 prescribed` EQUALS "section 40"
#ASSERT `s 40 where the meaning is given` `s 40 primary legislation` EQUALS "section 40"
#ASSERT `s 40 where the meaning is given` `s 40 qualifying young person` EQUALS "section 10(5)"
#ASSERT `s 40 where the meaning is given` `s 40 regular and substantial caring responsibilities` EQUALS "regulations"
#ASSERT `s 40 where the meaning is given` `s 40 responsible carer` EQUALS "section 19(6)"
#ASSERT `s 40 where the meaning is given` `s 40 secondary legislation` EQUALS "section 40"
#ASSERT `s 40 where the meaning is given` `s 40 severely disabled` EQUALS "regulations"
#ASSERT `s 40 where the meaning is given` `s 40 single claimant` EQUALS "section 40"
#ASSERT `s 40 where the meaning is given` `s 40 single person` EQUALS "section 1(2)(a)"
#ASSERT `s 40 where the meaning is given` `s 40 work` EQUALS "regulations"
#ASSERT `s 40 where the meaning is given` `s 40 work availability requirement` EQUALS "section 18(1)"
#ASSERT `s 40 where the meaning is given` `s 40 work preparation requirement` EQUALS "section 16(1)"
#ASSERT `s 40 where the meaning is given` `s 40 work search requirement` EQUALS "section 17(1)"
#ASSERT `s 40 where the meaning is given` `s 40 work-focused interview requirement` EQUALS "section 15(1)"
#ASSERT `s 40 where the meaning is given` `s 40 work-related activity` EQUALS "section 40"
#ASSERT `s 40 where the meaning is given` `s 40 work-related requirement` EQUALS "section 13(2)"

§ `s 40 -- interpretation: the terms s 40 defines itself`

-- "child" means a person under the age of 16: 15 completed years is a child, 16 is not
#ASSERT `s 40 the person is a child` (`s 40 test: a person of age` 15) EQUALS TRUE
#ASSERT `s 40 the person is a child` (`s 40 test: a person of age` 16) EQUALS FALSE
#ASSERT `s 40 the person is a child` (`s 40 test: a person of age` 0) EQUALS TRUE
-- "claim" means claim for universal credit
#ASSERT `s 40 the claim is a claim in this Part` TRUE EQUALS TRUE
#ASSERT `s 40 the claim is a claim in this Part` FALSE EQUALS FALSE
-- "claimant" means a single claimant or each of joint claimants
#ASSERT count (`s 40 the claimants` (`a single claimant` (`s 40 test: a person of age` 40))) EQUALS 1
#ASSERT count (`s 40 the claimants` (`joint claimants` (`s 39(1) test: two people` TRUE TRUE FALSE))) EQUALS 2
-- "joint claimants" means members of a couple who jointly make a claim or in relation to whom an award is made
#ASSERT `s 40 the two people are joint claimants` (`s 39(1) test: two people` TRUE TRUE FALSE) TRUE FALSE EQUALS TRUE
#ASSERT `s 40 the two people are joint claimants` (`s 39(1) test: two people` TRUE TRUE FALSE) FALSE TRUE EQUALS TRUE
#ASSERT `s 40 the two people are joint claimants` (`s 39(1) test: two people` TRUE TRUE FALSE) FALSE FALSE EQUALS FALSE
#ASSERT `s 40 the two people are joint claimants` (`s 39(1) test: two people` TRUE FALSE FALSE) TRUE TRUE EQUALS FALSE
-- "single claimant" means a single person who makes a claim or in relation to whom an award is made as a single person
#ASSERT `s 40 the person is a single claimant` TRUE TRUE FALSE EQUALS TRUE
#ASSERT `s 40 the person is a single claimant` TRUE FALSE TRUE EQUALS TRUE
#ASSERT `s 40 the person is a single claimant` TRUE FALSE FALSE EQUALS FALSE
#ASSERT `s 40 the person is a single claimant` FALSE TRUE TRUE EQUALS FALSE
-- "prescribed" means specified or provided for in regulations
#ASSERT `s 40 the matter is prescribed` TRUE EQUALS TRUE
#ASSERT `s 40 the matter is prescribed` FALSE EQUALS FALSE
-- "primary legislation" means an Act, Act of the Scottish Parliament or Act or Measure of the National Assembly for Wales
#ASSERT `s 40 the legislation is primary legislation` `s 40 an Act` EQUALS TRUE
#ASSERT `s 40 the legislation is primary legislation` `s 40 an Act of the Scottish Parliament` EQUALS TRUE
#ASSERT `s 40 the legislation is primary legislation` `s 40 an Act of the National Assembly for Wales` EQUALS TRUE
#ASSERT `s 40 the legislation is primary legislation` `s 40 a Measure of the National Assembly for Wales` EQUALS TRUE
#ASSERT `s 40 the legislation is primary legislation` `s 40 an instrument made under primary legislation` EQUALS FALSE
#ASSERT `s 40 the legislation is primary legislation` `s 40 some other kind of legislation` EQUALS FALSE
-- "secondary legislation" means an instrument made under primary legislation
#ASSERT `s 40 the instrument is secondary legislation` TRUE EQUALS TRUE
#ASSERT `s 40 the instrument is secondary legislation` FALSE EQUALS FALSE
-- "work-related activity" means activity which makes it more likely that the person will obtain or remain in work
#ASSERT `s 40 the activity is work-related activity` TRUE EQUALS TRUE
#ASSERT `s 40 the activity is work-related activity` FALSE EQUALS FALSE
-- "disabled", "regular and substantial caring responsibilities", "severely disabled" and "work" have such meaning as may be prescribed
#ASSERT `s 40 the person or matter has the prescribed meaning of the term` `s 40 disabled` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 40 the person or matter has the prescribed meaning of the term` `s 40 regular and substantial caring responsibilities` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 40 the person or matter has the prescribed meaning of the term` `s 40 severely disabled` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 40 the person or matter has the prescribed meaning of the term` `s 40 work` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 40 the person or matter has the prescribed meaning of the term` `s 40 work` NOTHING EQUALS NOTHING
-- a term the Act defines itself does not take its meaning from regulations
#ASSERT `s 40 the person or matter has the prescribed meaning of the term` `s 40 child` (JUST TRUE) EQUALS NOTHING

§ `s 41 -- pilot schemes: the two limits`

-- "may not have effect for a period exceeding three years": 36 months is within, 37 is not
#ASSERT `s 41(5) the pilot scheme's own period is within three years` 36 EQUALS TRUE
#ASSERT `s 41(5) the pilot scheme's own period is within three years` 37 EQUALS FALSE
-- an order may continue it "for a period not exceeding twelve months": 12 within, 13 not
#ASSERT `s 41(5)(a) the order's continuation is within twelve months` 12 EQUALS TRUE
#ASSERT `s 41(5)(a) the order's continuation is within twelve months` 13 EQUALS FALSE
