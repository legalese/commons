IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra4-ss117-119`

-- Tests for wra4-ss117-119.l4. Every expected value is written from the text of the Act, beside the assertion.

§ `s 117 disqualifying and sanctionable benefits`

#ASSERT `s 117(2) SSFA 6A(1) the benefit is a disqualifying benefit` `child tax credit` EQUALS JUST TRUE
#ASSERT `s 117(2) SSFA 6A(1) the benefit is a disqualifying benefit` `working tax credit` EQUALS JUST TRUE
-- the list is not closed here: any other benefit is not covered (never FALSE)
#ASSERT `s 117(2) SSFA 6A(1) the benefit is a disqualifying benefit` `universal credit` EQUALS NOTHING
#ASSERT `s 117(2) SSFA 6A(1) the benefit is a disqualifying benefit` `housing benefit` EQUALS NOTHING
#ASSERT `s 117(3) SSFA 6A(1) the benefit is a sanctionable benefit` `child tax credit` EQUALS JUST TRUE
#ASSERT `s 117(3) SSFA 6A(1) the benefit is a sanctionable benefit` `working tax credit` EQUALS JUST TRUE
#ASSERT `s 117(3) SSFA 6A(1) the benefit is a sanctionable benefit` `universal credit` EQUALS NOTHING
#ASSERT `s 117(3) SSFA 6A(1) the benefit is a sanctionable benefit` `income support` EQUALS NOTHING

§ `s 118 SSFA 6B(14): relevant offence`

-- a conviction with nothing that makes the offence relevant
`s 118(5) SSFA 6B(14) test conviction with nothing relevant` MEANS
    `s 118(5) SSFA 6B(14) conviction for a benefit offence` WITH
        `the place where the proceedings were brought` IS `England outside Greater London`,
        `the offence is the common law offence of conspiracy to defraud` IS FALSE,
        `the offence is a prescribed offence` IS JUST TRUE,
        `the offence was committed in the circumstances regulations prescribe` IS JUST TRUE,
        `the overpayment the court found the offence to relate to, in pounds` IS NOTHING,
        `the sentence imposed` IS `s 118(5) SSFA 6B(14)(b)(ii) some other sentence`,
        `the length of the sentence imposed, in months` IS 0,
        `the period the court found the offence to have been committed over, in months` IS NOTHING

`s 118(5) SSFA 6B(14) test conspiracy to defraud in Wales` MEANS
    `s 118(5) SSFA 6B(14) conviction for a benefit offence` WITH
        `the place where the proceedings were brought` IS Wales,
        `the offence is the common law offence of conspiracy to defraud` IS TRUE,
        `the offence is a prescribed offence` IS JUST FALSE,
        `the offence was committed in the circumstances regulations prescribe` IS JUST FALSE,
        `the overpayment the court found the offence to relate to, in pounds` IS NOTHING,
        `the sentence imposed` IS `s 118(5) SSFA 6B(14)(b)(ii) some other sentence`,
        `the length of the sentence imposed, in months` IS 0,
        `the period the court found the offence to have been committed over, in months` IS NOTHING

`s 118(5) SSFA 6B(14) test conspiracy to defraud in Scotland` MEANS
    `s 118(5) SSFA 6B(14) conviction for a benefit offence` WITH
        `the place where the proceedings were brought` IS Scotland,
        `the offence is the common law offence of conspiracy to defraud` IS TRUE,
        `the offence is a prescribed offence` IS JUST FALSE,
        `the offence was committed in the circumstances regulations prescribe` IS JUST FALSE,
        `the overpayment the court found the offence to relate to, in pounds` IS NOTHING,
        `the sentence imposed` IS `s 118(5) SSFA 6B(14)(b)(ii) some other sentence`,
        `the length of the sentence imposed, in months` IS 0,
        `the period the court found the offence to have been committed over, in months` IS NOTHING

`s 118(5) SSFA 6B(14) test prescribed offence with 50,000 pounds found` MEANS
    `s 118(5) SSFA 6B(14) conviction for a benefit offence` WITH
        `the place where the proceedings were brought` IS Scotland,
        `the offence is the common law offence of conspiracy to defraud` IS FALSE,
        `the offence is a prescribed offence` IS JUST TRUE,
        `the offence was committed in the circumstances regulations prescribe` IS JUST TRUE,
        `the overpayment the court found the offence to relate to, in pounds` IS JUST 50000,
        `the sentence imposed` IS `s 118(5) SSFA 6B(14)(b)(ii) some other sentence`,
        `the length of the sentence imposed, in months` IS 0,
        `the period the court found the offence to have been committed over, in months` IS NOTHING

`s 118(5) SSFA 6B(14) test prescribed offence with 49,999 pounds found` MEANS
    `s 118(5) SSFA 6B(14) conviction for a benefit offence` WITH
        `the place where the proceedings were brought` IS Scotland,
        `the offence is the common law offence of conspiracy to defraud` IS FALSE,
        `the offence is a prescribed offence` IS JUST TRUE,
        `the offence was committed in the circumstances regulations prescribe` IS JUST TRUE,
        `the overpayment the court found the offence to relate to, in pounds` IS JUST 49999,
        `the sentence imposed` IS `s 118(5) SSFA 6B(14)(b)(ii) some other sentence`,
        `the length of the sentence imposed, in months` IS 0,
        `the period the court found the offence to have been committed over, in months` IS NOTHING

`s 118(5) SSFA 6B(14) test prescribed offence with a 12-month suspended sentence` MEANS
    `s 118(5) SSFA 6B(14) conviction for a benefit offence` WITH
        `the place where the proceedings were brought` IS Scotland,
        `the offence is the common law offence of conspiracy to defraud` IS FALSE,
        `the offence is a prescribed offence` IS JUST TRUE,
        `the offence was committed in the circumstances regulations prescribe` IS JUST TRUE,
        `the overpayment the court found the offence to relate to, in pounds` IS NOTHING,
        `the sentence imposed` IS `s 118(5) SSFA 6B(14)(b)(ii) a suspended sentence as defined in section 189(7)(b) of the Criminal Justice Act 2003`,
        `the length of the sentence imposed, in months` IS 12,
        `the period the court found the offence to have been committed over, in months` IS NOTHING

`s 118(5) SSFA 6B(14) test prescribed offence with an 11-month custodial sentence` MEANS
    `s 118(5) SSFA 6B(14) conviction for a benefit offence` WITH
        `the place where the proceedings were brought` IS Scotland,
        `the offence is the common law offence of conspiracy to defraud` IS FALSE,
        `the offence is a prescribed offence` IS JUST TRUE,
        `the offence was committed in the circumstances regulations prescribe` IS JUST TRUE,
        `the overpayment the court found the offence to relate to, in pounds` IS NOTHING,
        `the sentence imposed` IS `s 118(5) SSFA 6B(14)(b)(ii) a custodial sentence`,
        `the length of the sentence imposed, in months` IS 11,
        `the period the court found the offence to have been committed over, in months` IS NOTHING

`s 118(5) SSFA 6B(14) test prescribed offence committed over 24 months` MEANS
    `s 118(5) SSFA 6B(14) conviction for a benefit offence` WITH
        `the place where the proceedings were brought` IS Scotland,
        `the offence is the common law offence of conspiracy to defraud` IS FALSE,
        `the offence is a prescribed offence` IS JUST TRUE,
        `the offence was committed in the circumstances regulations prescribe` IS JUST TRUE,
        `the overpayment the court found the offence to relate to, in pounds` IS NOTHING,
        `the sentence imposed` IS `s 118(5) SSFA 6B(14)(b)(ii) some other sentence`,
        `the length of the sentence imposed, in months` IS 0,
        `the period the court found the offence to have been committed over, in months` IS JUST 24

`s 118(5) SSFA 6B(14) test offence not known to be prescribed` MEANS
    `s 118(5) SSFA 6B(14) conviction for a benefit offence` WITH
        `the place where the proceedings were brought` IS Scotland,
        `the offence is the common law offence of conspiracy to defraud` IS FALSE,
        `the offence is a prescribed offence` IS NOTHING,
        `the offence was committed in the circumstances regulations prescribe` IS JUST TRUE,
        `the overpayment the court found the offence to relate to, in pounds` IS JUST 60000,
        `the sentence imposed` IS `s 118(5) SSFA 6B(14)(b)(ii) some other sentence`,
        `the length of the sentence imposed, in months` IS 0,
        `the period the court found the offence to have been committed over, in months` IS NOTHING

`s 118(5) SSFA 6B(14) test circumstances not known to be prescribed` MEANS
    `s 118(5) SSFA 6B(14) conviction for a benefit offence` WITH
        `the place where the proceedings were brought` IS Scotland,
        `the offence is the common law offence of conspiracy to defraud` IS FALSE,
        `the offence is a prescribed offence` IS JUST TRUE,
        `the offence was committed in the circumstances regulations prescribe` IS NOTHING,
        `the overpayment the court found the offence to relate to, in pounds` IS JUST 60000,
        `the sentence imposed` IS `s 118(5) SSFA 6B(14)(b)(ii) some other sentence`,
        `the length of the sentence imposed, in months` IS 0,
        `the period the court found the offence to have been committed over, in months` IS NOTHING

`s 118(5) SSFA 6B(14) test circumstances not prescribed` MEANS
    `s 118(5) SSFA 6B(14) conviction for a benefit offence` WITH
        `the place where the proceedings were brought` IS Scotland,
        `the offence is the common law offence of conspiracy to defraud` IS FALSE,
        `the offence is a prescribed offence` IS JUST TRUE,
        `the offence was committed in the circumstances regulations prescribe` IS JUST FALSE,
        `the overpayment the court found the offence to relate to, in pounds` IS JUST 60000,
        `the sentence imposed` IS `s 118(5) SSFA 6B(14)(b)(ii) some other sentence`,
        `the length of the sentence imposed, in months` IS 0,
        `the period the court found the offence to have been committed over, in months` IS NOTHING

-- (a): conspiracy to defraud counts in England and Wales only
#ASSERT `s 118(5) SSFA 6B(14)(a) the offence is the common law offence of conspiracy to defraud in England and Wales` `s 118(5) SSFA 6B(14) test conspiracy to defraud in Wales` EQUALS TRUE
#ASSERT `s 118(5) SSFA 6B(14)(a) the offence is the common law offence of conspiracy to defraud in England and Wales` `s 118(5) SSFA 6B(14) test conspiracy to defraud in Scotland` EQUALS FALSE
#ASSERT `s 118(5) SSFA 6B(14)(a) the offence is the common law offence of conspiracy to defraud in England and Wales` `s 118(5) SSFA 6B(14) test conviction with nothing relevant` EQUALS FALSE
#ASSERT `s 118(5) SSFA 6B(14) the offence is a relevant offence` `s 118(5) SSFA 6B(14) test conspiracy to defraud in Wales` EQUALS JUST TRUE
-- (b)(i): 50,000 pounds is "at least 50,000"; 49,999 is not
#ASSERT `s 118(5) SSFA 6B(14)(b)(i) the court found an overpayment of at least 50,000 pounds` `s 118(5) SSFA 6B(14) test prescribed offence with 50,000 pounds found` EQUALS TRUE
#ASSERT `s 118(5) SSFA 6B(14)(b)(i) the court found an overpayment of at least 50,000 pounds` `s 118(5) SSFA 6B(14) test prescribed offence with 49,999 pounds found` EQUALS FALSE
#ASSERT `s 118(5) SSFA 6B(14)(b)(i) the court found an overpayment of at least 50,000 pounds` `s 118(5) SSFA 6B(14) test conviction with nothing relevant` EQUALS FALSE
#ASSERT `s 118(5) SSFA 6B(14) the offence is a relevant offence` `s 118(5) SSFA 6B(14) test prescribed offence with 50,000 pounds found` EQUALS JUST TRUE
#ASSERT `s 118(5) SSFA 6B(14) the offence is a relevant offence` `s 118(5) SSFA 6B(14) test prescribed offence with 49,999 pounds found` EQUALS JUST FALSE
-- (b)(ii): a suspended sentence of 12 months counts; a custodial sentence of 11 months does not
#ASSERT `s 118(5) SSFA 6B(14)(b)(ii) the sentence is a custodial sentence of at least one year` `s 118(5) SSFA 6B(14) test prescribed offence with a 12-month suspended sentence` EQUALS TRUE
#ASSERT `s 118(5) SSFA 6B(14)(b)(ii) the sentence is a custodial sentence of at least one year` `s 118(5) SSFA 6B(14) test prescribed offence with an 11-month custodial sentence` EQUALS FALSE
#ASSERT `s 118(5) SSFA 6B(14)(b)(ii) the sentence is a custodial sentence of at least one year` `s 118(5) SSFA 6B(14) test conviction with nothing relevant` EQUALS FALSE
#ASSERT `s 118(5) SSFA 6B(14) the offence is a relevant offence` `s 118(5) SSFA 6B(14) test prescribed offence with a 12-month suspended sentence` EQUALS JUST TRUE
#ASSERT `s 118(5) SSFA 6B(14) the offence is a relevant offence` `s 118(5) SSFA 6B(14) test prescribed offence with an 11-month custodial sentence` EQUALS JUST FALSE
-- (b)(iii): two years is 24 months
#ASSERT `s 118(5) SSFA 6B(14)(b)(iii) the court found the offence to have been committed over at least two years` `s 118(5) SSFA 6B(14) test prescribed offence committed over 24 months` EQUALS TRUE
#ASSERT `s 118(5) SSFA 6B(14)(b)(iii) the court found the offence to have been committed over at least two years` `s 118(5) SSFA 6B(14) test conviction with nothing relevant` EQUALS FALSE
#ASSERT `s 118(5) SSFA 6B(14) the offence is a relevant offence` `s 118(5) SSFA 6B(14) test prescribed offence committed over 24 months` EQUALS JUST TRUE
-- (b): what regulations prescribe decides the rest; an unanswered question is not covered, a "no" is the text's no
#ASSERT `s 118(5) SSFA 6B(14) the offence is a relevant offence` `s 118(5) SSFA 6B(14) test offence not known to be prescribed` EQUALS NOTHING
#ASSERT `s 118(5) SSFA 6B(14) the offence is a relevant offence` `s 118(5) SSFA 6B(14) test circumstances not known to be prescribed` EQUALS NOTHING
#ASSERT `s 118(5) SSFA 6B(14) the offence is a relevant offence` `s 118(5) SSFA 6B(14) test circumstances not prescribed` EQUALS JUST FALSE
#ASSERT `s 118(5) SSFA 6B(14) the offence is a relevant offence` `s 118(5) SSFA 6B(14) test conviction with nothing relevant` EQUALS JUST FALSE
#ASSERT `s 118(5) SSFA 6B(14) the offence is a relevant offence` `s 118(5) SSFA 6B(14) test conspiracy to defraud in Scotland` EQUALS JUST FALSE

§ `s 118 SSFA 6B(11A): the relevant period`

#ASSERT `s 118(4) SSFA 6B(11A) the relevant period` `s 118(4) SSFA 6B(11A) a case within subsection (1)(a)` (JUST TRUE) EQUALS JUST `s 118(4) SSFA 6B(11A) the period of three years`
#ASSERT `s 118(4) SSFA 6B(11A) the relevant period` `s 118(4) SSFA 6B(11A) a case within subsection (1)(a)` (JUST FALSE) EQUALS JUST `s 118(4) SSFA 6B(11A) the period of 13 weeks`
#ASSERT `s 118(4) SSFA 6B(11A) the relevant period` `s 118(4) SSFA 6B(11A) a case within subsection (1)(a)` NOTHING EQUALS NOTHING
#ASSERT `s 118(4) SSFA 6B(11A) the relevant period` `s 118(4) SSFA 6B(11A) a case within subsection (1)(b)` (JUST TRUE) EQUALS JUST `s 118(4) SSFA 6B(11A) the period of four weeks`
#ASSERT `s 118(4) SSFA 6B(11A) the relevant period` `s 118(4) SSFA 6B(11A) a case within subsection (1)(c)` NOTHING EQUALS JUST `s 118(4) SSFA 6B(11A) the period of four weeks`
#ASSERT `s 118(4) SSFA 6B(11A) the relevant period` `s 118(4) SSFA 6B(11A) a case within none of paragraphs (a) to (c)` (JUST TRUE) EQUALS NOTHING
-- both days count: 1 January to 31 December 2027 is three years; 91 days make 13 weeks; 28 make four weeks
#ASSERT `s 118(4) SSFA 6B(11A) the last day of the relevant period` `s 118(4) SSFA 6B(11A) the period of three years` (Date 1 1 2025) EQUALS Date 31 12 2027
#ASSERT `s 118(4) SSFA 6B(11A) the last day of the relevant period` `s 118(4) SSFA 6B(11A) the period of 13 weeks` (Date 1 1 2025) EQUALS Date 1 4 2025
#ASSERT `s 118(4) SSFA 6B(11A) the last day of the relevant period` `s 118(4) SSFA 6B(11A) the period of four weeks` (Date 1 1 2025) EQUALS Date 28 1 2025

§ `s 118 SSFA 7(1A)`

#ASSERT `s 118(7) SSFA 7(1A) the restrictions in section 7 do not apply` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 118(7) SSFA 7(1A) the restrictions in section 7 do not apply` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 118(7) SSFA 7(1A) the restrictions in section 7 do not apply` NOTHING EQUALS NOTHING

§ `s 119 SSFA 7(1): the five conditions`

-- the most recent of a list of dates
#ASSERT `s 119(5) SSFA 7(1)(b) the most recent of the dates` (LIST (Date 1 1 2020), (Date 1 6 2022), (Date 1 3 2021)) EQUALS JUST (Date 1 6 2022)
#ASSERT `s 119(5) SSFA 7(1)(b) the most recent of the dates` (LIST (Date 1 1 2020)) EQUALS JUST (Date 1 1 2020)
-- (b): offence committed 1 January 2025; an event on 1 January 2020 is exactly five years earlier, outside the five years ending on 1 January 2025
#ASSERT `s 119(5) SSFA 7(1)(b) the earlier disqualifying event` (LIST (Date 1 1 2025)) (LIST (Date 1 1 2020)) EQUALS NOTHING
#ASSERT `s 119(5) SSFA 7(1)(b) the earlier disqualifying event` (LIST (Date 1 1 2025)) (LIST (Date 2 1 2020)) EQUALS JUST (Date 2 1 2020)
#ASSERT `s 119(5) SSFA 7(1)(b) the earlier disqualifying event` (LIST (Date 1 1 2025)) (LIST (Date 1 1 2025)) EQUALS JUST (Date 1 1 2025)
#ASSERT `s 119(5) SSFA 7(1)(b) the earlier disqualifying event` (LIST (Date 1 1 2025)) (LIST (Date 2 1 2025)) EQUALS NOTHING
-- a mid-year offence date (the boundary is the same day five years earlier) and a leap-day offence date (29 February clamps to 28 February)
#ASSERT `s 119(5) SSFA 7(1)(b) the earlier disqualifying event` (LIST (Date 15 6 2025)) (LIST (Date 15 6 2020)) EQUALS NOTHING
#ASSERT `s 119(5) SSFA 7(1)(b) the earlier disqualifying event` (LIST (Date 15 6 2025)) (LIST (Date 16 6 2020)) EQUALS JUST (Date 16 6 2020)
#ASSERT `s 119(5) SSFA 7(1)(b) the earlier disqualifying event` (LIST (Date 29 2 2024)) (LIST (Date 28 2 2019)) EQUALS NOTHING
#ASSERT `s 119(5) SSFA 7(1)(b) the earlier disqualifying event` (LIST (Date 29 2 2024)) (LIST (Date 1 3 2019)) EQUALS JUST (Date 1 3 2019)
-- the event, or the most recent of them, is the earlier disqualifying event
#ASSERT `s 119(5) SSFA 7(1)(b) the earlier disqualifying event` (LIST (Date 1 1 2025)) (LIST (Date 2 1 2021), (Date 5 5 2023), (Date 3 3 2022)) EQUALS JUST (Date 5 5 2023)
-- any of the offences' five years will do
#ASSERT `s 119(5) SSFA 7(1)(b) the earlier disqualifying event` (LIST (Date 1 1 2025), (Date 1 1 2030)) (LIST (Date 5 5 2027)) EQUALS JUST (Date 5 5 2027)
#ASSERT `s 119(5) SSFA 7(1)(b) a disqualifying event occurred within five years before a benefit offence` (LIST (Date 1 1 2025)) (LIST (Date 2 1 2020)) EQUALS TRUE
#ASSERT `s 119(5) SSFA 7(1)(b) a disqualifying event occurred within five years before a benefit offence` (LIST (Date 1 1 2025)) (LIST (Date 1 1 2020)) EQUALS FALSE
#ASSERT `s 119(5) SSFA 7(1)(b) a disqualifying event occurred within five years before a benefit offence` (LIST (Date 1 1 2025)) EMPTY EQUALS FALSE
-- (a) to (e): all five must be met
#ASSERT `s 119(5) SSFA 7(1) the conditions in paragraphs (a) to (e) are met` TRUE (LIST (Date 1 1 2025)) (LIST (Date 2 1 2020)) TRUE TRUE TRUE EQUALS TRUE
#ASSERT `s 119(5) SSFA 7(1) the conditions in paragraphs (a) to (e) are met` FALSE (LIST (Date 1 1 2025)) (LIST (Date 2 1 2020)) TRUE TRUE TRUE EQUALS FALSE
#ASSERT `s 119(5) SSFA 7(1) the conditions in paragraphs (a) to (e) are met` TRUE (LIST (Date 1 1 2025)) (LIST (Date 1 1 2020)) TRUE TRUE TRUE EQUALS FALSE
#ASSERT `s 119(5) SSFA 7(1) the conditions in paragraphs (a) to (e) are met` TRUE (LIST (Date 1 1 2025)) (LIST (Date 2 1 2020)) FALSE TRUE TRUE EQUALS FALSE
#ASSERT `s 119(5) SSFA 7(1) the conditions in paragraphs (a) to (e) are met` TRUE (LIST (Date 1 1 2025)) (LIST (Date 2 1 2020)) TRUE FALSE TRUE EQUALS FALSE
#ASSERT `s 119(5) SSFA 7(1) the conditions in paragraphs (a) to (e) are met` TRUE (LIST (Date 1 1 2025)) (LIST (Date 2 1 2020)) TRUE TRUE FALSE EQUALS FALSE

§ `s 119 SSFA 7(6), (6A): the disqualification period`

-- (a): a previous event within five years ending on the earlier event gives three years; otherwise 26 weeks
#ASSERT `s 119(7) SSFA 7(6A) the relevant period` (LIST (Date 1 1 2025)) (LIST (Date 2 1 2020)) EQUALS `s 119(7) SSFA 7(6A) the period of three years`
#ASSERT `s 119(7) SSFA 7(6A) the relevant period` (LIST (Date 1 1 2025)) (LIST (Date 1 1 2020)) EQUALS `s 119(7) SSFA 7(6A) the period of 26 weeks`
#ASSERT `s 119(7) SSFA 7(6A) the relevant period` (LIST (Date 1 1 2025)) EMPTY EQUALS `s 119(7) SSFA 7(6A) the period of 26 weeks`
-- 7(8A)(c), (d): with several convictions in a set, any conviction's date will do
#ASSERT `s 119(7) SSFA 7(6A) the relevant period` (LIST (Date 1 1 2022), (Date 1 1 2025)) (LIST (Date 1 6 2021)) EQUALS `s 119(7) SSFA 7(6A) the period of three years`
#ASSERT `s 119(7) SSFA 7(6A) the relevant period` (LIST (Date 1 1 2025)) (LIST (Date 1 1 2010), (Date 1 6 2022)) EQUALS `s 119(7) SSFA 7(6A) the period of three years`
-- a previous event after the earlier one is not "within the five years ending on" its date
#ASSERT `s 119(7) SSFA 7(6A) the relevant period` (LIST (Date 1 1 2025)) (LIST (Date 2 1 2025)) EQUALS `s 119(7) SSFA 7(6A) the period of 26 weeks`
-- both days count: 26 weeks from 1 January 2025 ends on 1 July 2025
#ASSERT `s 119(7) SSFA 7(6A) the last day of the relevant period` `s 119(7) SSFA 7(6A) the period of three years` (Date 1 1 2025) EQUALS Date 31 12 2027
#ASSERT `s 119(7) SSFA 7(6A) the last day of the relevant period` `s 119(7) SSFA 7(6A) the period of 26 weeks` (Date 1 1 2025) EQUALS Date 1 7 2025
-- 7(6): the period begins with a prescribed date after the conviction
#ASSERT `s 119(6) SSFA 7(6) the disqualification period` (Date 1 3 2025) (JUST (Date 1 4 2025)) `s 119(7) SSFA 7(6A) the period of 26 weeks` EQUALS JUST (Period WITH `first day` IS Date 1 4 2025, `last day` IS Date 29 9 2025)
#ASSERT `s 119(6) SSFA 7(6) the disqualification period` (Date 1 3 2025) (JUST (Date 1 3 2025)) `s 119(7) SSFA 7(6A) the period of 26 weeks` EQUALS NOTHING
#ASSERT `s 119(6) SSFA 7(6) the disqualification period` (Date 1 3 2025) (JUST (Date 1 2 2025)) `s 119(7) SSFA 7(6A) the period of 26 weeks` EQUALS NOTHING
#ASSERT `s 119(6) SSFA 7(6) the disqualification period` (Date 1 3 2025) NOTHING `s 119(7) SSFA 7(6A) the period of 26 weeks` EQUALS NOTHING

§ `s 119 SSFA 7(7A), (7B): withdrawal, appeal and revision`

-- args: taken into account, withdrawn, decided not recoverable, revised, new agreement
#ASSERT `s 119(8) SSFA 7(7A) subsection (7B) applies` TRUE TRUE FALSE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 119(8) SSFA 7(7A) subsection (7B) applies` TRUE FALSE TRUE FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 119(8) SSFA 7(7A) subsection (7B) applies` TRUE FALSE FALSE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 119(8) SSFA 7(7A) subsection (7B) applies` TRUE FALSE FALSE TRUE TRUE EQUALS NOTHING
#ASSERT `s 119(8) SSFA 7(7A) subsection (7B) applies` TRUE FALSE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 119(8) SSFA 7(7A) subsection (7B) applies` FALSE TRUE FALSE FALSE FALSE EQUALS NOTHING
#ASSERT `s 119(8) SSFA 7(7B) the restriction is to be treated as not imposed` (JUST TRUE) FALSE EQUALS JUST TRUE
#ASSERT `s 119(8) SSFA 7(7B) the restriction is to be treated as not imposed` (JUST TRUE) TRUE EQUALS JUST FALSE
#ASSERT `s 119(8) SSFA 7(7B) the restriction is to be treated as not imposed` (JUST FALSE) FALSE EQUALS NOTHING
#ASSERT `s 119(8) SSFA 7(7B) the restriction is to be treated as not imposed` NOTHING FALSE EQUALS NOTHING
#ASSERT `s 119(9) SSFA 7(8) the provision is the appropriate penalty provision` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 119(9) SSFA 7(8) the provision is the appropriate penalty provision` NOTHING EQUALS NOTHING
#ASSERT `s 119(9) SSFA 7(8) the event is a disqualifying event` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 119(9) SSFA 7(8) the event is a disqualifying event` NOTHING EQUALS NOTHING

§ `s 119 SSFA 7(8A): one disqualifying event for a set of proceedings`

#ASSERT `s 119(10) SSFA 7(8A) the number of disqualifying events in the set of proceedings` 2 EQUALS JUST 1
#ASSERT `s 119(10) SSFA 7(8A) the number of disqualifying events in the set of proceedings` 5 EQUALS JUST 1
#ASSERT `s 119(10) SSFA 7(8A) the number of disqualifying events in the set of proceedings` 1 EQUALS NOTHING
#ASSERT `s 119(10) SSFA 7(8A)(a) subsection (1)(b) is satisfied` (LIST (Date 1 1 2025)) (LIST (Date 1 1 2010), (Date 2 1 2020)) EQUALS JUST TRUE
#ASSERT `s 119(10) SSFA 7(8A)(a) subsection (1)(b) is satisfied` (LIST (Date 1 1 2025)) (LIST (Date 1 1 2010), (Date 1 1 2020)) EQUALS NOTHING
#ASSERT `s 119(10) SSFA 7(8A)(b) the event is taken into account for the purposes of subsection (1)(d)` (LIST FALSE, TRUE, FALSE) EQUALS JUST TRUE
#ASSERT `s 119(10) SSFA 7(8A)(b) the event is taken into account for the purposes of subsection (1)(d)` (LIST FALSE, FALSE) EQUALS NOTHING
#ASSERT `s 119(10) SSFA 7(8A)(b) the event is taken into account for the purposes of subsection (1)(d)` EMPTY EQUALS NOTHING
