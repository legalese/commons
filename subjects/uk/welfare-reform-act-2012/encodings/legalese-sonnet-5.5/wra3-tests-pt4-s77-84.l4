IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra3-pt4-s95`
IMPORT `wra3-pt4-s77-84`

-- Tests for wra3-pt4-s77-84.l4 (Part 4, sections 77 to 84). Expected values are written from the text of the sections
-- (raw lines 1346-1446), decided before running, and never copied from the output. Weekly rates and ages below are
-- INVENTED test numbers: the Act leaves the real ones to regulations, and no real figure is used anywhere.

§ `Cast`

`s 83(2) a person aged 15` MEANS Person WITH
    `reference` IS "P15"
    `age in years` IS 15
    `date of birth` IS Date 1 1 2011
    `where the person is` IS `England outside Greater London`
    `where the person lives` IS `England outside Greater London`

`s 83(2) a person aged 16` MEANS Person WITH
    `reference` IS "P16"
    `age in years` IS 16
    `date of birth` IS Date 1 1 2010
    `where the person is` IS Wales
    `where the person lives` IS Wales

`s 83(2) a person aged 64` MEANS Person WITH
    `reference` IS "P64"
    `age in years` IS 64
    `date of birth` IS Date 1 1 1962
    `where the person is` IS Scotland
    `where the person lives` IS Scotland

`s 83(2) a person aged 65` MEANS Person WITH
    `reference` IS "P65"
    `age in years` IS 65
    `date of birth` IS Date 1 1 1961
    `where the person is` IS Scotland
    `where the person lives` IS Scotland

`s 83(2) a person aged 66` MEANS Person WITH
    `reference` IS "P66"
    `age in years` IS 66
    `date of birth` IS Date 1 1 1960
    `where the person is` IS Scotland
    `where the person lives` IS Scotland

§ `s 77`

-- (1) "An allowance known as personal independence payment is payable in accordance with this Part."
#ASSERT `s 77(1) the allowance known as personal independence payment` EQUALS `personal independence payment`

-- (2) entitlement may be to (a) the daily living component, (b) the mobility component, or (c) both
#ASSERT `s 77(2) the components the person's entitlement is an entitlement to` TRUE TRUE EQUALS LIST `daily living component`, `mobility component`
#ASSERT `s 77(2) the components the person's entitlement is an entitlement to` TRUE FALSE EQUALS LIST `daily living component`
#ASSERT `s 77(2) the components the person's entitlement is an entitlement to` FALSE TRUE EQUALS LIST `mobility component`
#ASSERT `s 77(2) the components the person's entitlement is an entitlement to` FALSE FALSE EQUALS EMPTY

-- (3) "not entitled ... unless the person meets prescribed conditions": met -> not barred; not met -> barred; unknown -> not covered
#ASSERT `s 77(3) the person is not barred for want of the prescribed residence and presence conditions` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 77(3) the person is not barred for want of the prescribed residence and presence conditions` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 77(3) the person is not barred for want of the prescribed residence and presence conditions` NOTHING EQUALS NOTHING

-- (4) "not entitled ... while they are entitled to" any of the four Scottish payments (line 1353)
#ASSERT `s 77(4) the person is not barred by being entitled to a Scottish disability payment` EMPTY EQUALS JUST TRUE
#ASSERT `s 77(4) the person is not barred by being entitled to a Scottish disability payment` (LIST `s 95 adult disability payment`) EQUALS JUST FALSE
#ASSERT `s 77(4) the person is not barred by being entitled to a Scottish disability payment` (LIST `s 95 child disability payment`) EQUALS JUST FALSE
#ASSERT `s 77(4) the person is not barred by being entitled to a Scottish disability payment` (LIST `s 95 pension age disability payment`) EQUALS JUST FALSE
#ASSERT `s 77(4) the person is not barred by being entitled to a Scottish disability payment` (LIST `s 95 Scottish adult disability living allowance`) EQUALS JUST FALSE

§ `s 78`

-- the conjunction used by section 78(6): any "no" is a "no"; otherwise any not-covered is not covered; otherwise yes
#ASSERT `s 78(6) the conjunction of the results` EMPTY EQUALS JUST TRUE
#ASSERT `s 78(6) the conjunction of the results` (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 78(6) the conjunction of the results` (LIST JUST TRUE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 78(6) the conjunction of the results` (LIST JUST TRUE, NOTHING) EQUALS NOTHING
#ASSERT `s 78(6) the conjunction of the results` (LIST NOTHING, JUST FALSE) EQUALS JUST FALSE
-- the disjunction used for a section's own result: any "yes" is a "yes"; otherwise any not-covered is not covered; otherwise no
#ASSERT `s 78(6) the disjunction of the results` EMPTY EQUALS JUST FALSE
#ASSERT `s 78(6) the disjunction of the results` (LIST JUST FALSE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 78(6) the disjunction of the results` (LIST NOTHING, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 78(6) the disjunction of the results` (LIST JUST FALSE, NOTHING) EQUALS NOTHING
#ASSERT `s 78(6) the disjunction of the results` (LIST JUST FALSE, JUST FALSE) EQUALS JUST FALSE

-- (1) standard rate: (a) ability limited AND (b) required period condition met
#ASSERT `s 78(1) the person is entitled to the daily living component at the standard rate` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 78(1) the person is entitled to the daily living component at the standard rate` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 78(1) the person is entitled to the daily living component at the standard rate` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 78(1) the person is entitled to the daily living component at the standard rate` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 78(1) the person is entitled to the daily living component at the standard rate` FALSE NOTHING EQUALS JUST FALSE

-- (2) enhanced rate: (a) severely limited AND (b) required period condition met
#ASSERT `s 78(2) the person is entitled to the daily living component at the enhanced rate` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 78(2) the person is entitled to the daily living component at the enhanced rate` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 78(2) the person is entitled to the daily living component at the enhanced rate` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 78(2) the person is entitled to the daily living component at the enhanced rate` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 78(2) the person is entitled to the daily living component at the enhanced rate` FALSE NOTHING EQUALS JUST FALSE

-- (3) "such weekly rate as may be prescribed": invented test rates 10 and 20; unknown rates are not covered
#ASSERT `s 78(3)(a) the weekly rate of the daily living component at the standard rate` (JUST 10) EQUALS JUST 10
#ASSERT `s 78(3)(a) the weekly rate of the daily living component at the standard rate` NOTHING EQUALS NOTHING
#ASSERT `s 78(3)(b) the weekly rate of the daily living component at the enhanced rate` (JUST 20) EQUALS JUST 20
#ASSERT `s 78(3)(b) the weekly rate of the daily living component at the enhanced rate` NOTHING EQUALS NOTHING
#ASSERT `s 78(3) the weekly rate of the daily living component at the rate` `standard rate` (JUST 10) (JUST 20) EQUALS JUST 10
#ASSERT `s 78(3) the weekly rate of the daily living component at the rate` `enhanced rate` (JUST 10) (JUST 20) EQUALS JUST 20
#ASSERT `s 78(3) the weekly rate of the daily living component at the rate` `enhanced rate` (JUST 10) NOTHING EQUALS NOTHING

-- (4) "daily living activities" means such activities as may be prescribed (invented prescribed list)
#ASSERT `s 78(4) the activity is a daily living activity` "preparing food" (JUST (LIST "preparing food", "washing")) EQUALS JUST TRUE
#ASSERT `s 78(4) the activity is a daily living activity` "driving" (JUST (LIST "preparing food", "washing")) EQUALS JUST FALSE
#ASSERT `s 78(4) the activity is a daily living activity` "driving" NOTHING EQUALS NOTHING

-- (6) subject to the other provisions of Part 4
#ASSERT `s 78(6) the person is entitled to the daily living component, subject to the other provisions of Part 4 relating to entitlement` (JUST TRUE) (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 78(6) the person is entitled to the daily living component, subject to the other provisions of Part 4 relating to entitlement` (JUST TRUE) (LIST JUST TRUE, JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 78(6) the person is entitled to the daily living component, subject to the other provisions of Part 4 relating to entitlement` (JUST TRUE) (LIST JUST TRUE, NOTHING) EQUALS NOTHING
#ASSERT `s 78(6) the person is entitled to the daily living component, subject to the other provisions of Part 4 relating to entitlement` NOTHING (LIST JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 78(6) the person is entitled to the daily living component, subject to the other provisions of Part 4 relating to entitlement` (JUST FALSE) EMPTY EQUALS JUST FALSE

§ `s 79`

-- (1)(a) "of or over the age prescribed": invented age 16, tested on both sides
#ASSERT `s 79(1)(a) the person is of or over the age prescribed` `s 83(2) a person aged 16` (JUST 16) EQUALS JUST TRUE
#ASSERT `s 79(1)(a) the person is of or over the age prescribed` `s 83(2) a person aged 15` (JUST 16) EQUALS JUST FALSE
#ASSERT `s 79(1)(a) the person is of or over the age prescribed` `s 83(2) a person aged 16` NOTHING EQUALS NOTHING
#ASSERT `s 79(2)(a) the person is of or over the age prescribed` `s 83(2) a person aged 16` (JUST 16) EQUALS JUST TRUE
#ASSERT `s 79(2)(a) the person is of or over the age prescribed` `s 83(2) a person aged 15` (JUST 16) EQUALS JUST FALSE
#ASSERT `s 79(2)(a) the person is of or over the age prescribed` `s 83(2) a person aged 15` NOTHING EQUALS NOTHING

-- (1) standard rate: (a) age AND (b) ability limited AND (c) required period condition
#ASSERT `s 79(1) the person is entitled to the mobility component at the standard rate` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 79(1) the person is entitled to the mobility component at the standard rate` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 79(1) the person is entitled to the mobility component at the standard rate` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 79(1) the person is entitled to the mobility component at the standard rate` TRUE NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 79(1) the person is entitled to the mobility component at the standard rate` TRUE NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 79(1) the person is entitled to the mobility component at the standard rate` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 79(1) the person is entitled to the mobility component at the standard rate` FALSE NOTHING NOTHING EQUALS JUST FALSE

-- (2) enhanced rate: the same three limbs, with "severely limited"
#ASSERT `s 79(2) the person is entitled to the mobility component at the enhanced rate` TRUE (JUST TRUE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 79(2) the person is entitled to the mobility component at the enhanced rate` TRUE (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 79(2) the person is entitled to the mobility component at the enhanced rate` TRUE (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 79(2) the person is entitled to the mobility component at the enhanced rate` TRUE NOTHING (JUST TRUE) EQUALS NOTHING
#ASSERT `s 79(2) the person is entitled to the mobility component at the enhanced rate` FALSE (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE

-- (3) rates (invented 5 and 8), (4) activities, (6) subject to the Part, (7) regulations about unlikelihood of benefit
#ASSERT `s 79(3)(a) the weekly rate of the mobility component at the standard rate` (JUST 5) EQUALS JUST 5
#ASSERT `s 79(3)(a) the weekly rate of the mobility component at the standard rate` NOTHING EQUALS NOTHING
#ASSERT `s 79(3)(b) the weekly rate of the mobility component at the enhanced rate` (JUST 8) EQUALS JUST 8
#ASSERT `s 79(3)(b) the weekly rate of the mobility component at the enhanced rate` NOTHING EQUALS NOTHING
#ASSERT `s 79(3) the weekly rate of the mobility component at the rate` `standard rate` (JUST 5) (JUST 8) EQUALS JUST 5
#ASSERT `s 79(3) the weekly rate of the mobility component at the rate` `enhanced rate` (JUST 5) (JUST 8) EQUALS JUST 8
#ASSERT `s 79(4) the activity is a mobility activity` "moving around" (JUST (LIST "moving around", "planning a journey")) EQUALS JUST TRUE
#ASSERT `s 79(4) the activity is a mobility activity` "cooking" (JUST (LIST "moving around", "planning a journey")) EQUALS JUST FALSE
#ASSERT `s 79(4) the activity is a mobility activity` "cooking" NOTHING EQUALS NOTHING
#ASSERT `s 79(6) the person is entitled to the mobility component, subject to the other provisions of Part 4 relating to entitlement` (JUST TRUE) (LIST JUST TRUE, JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 79(6) the person is entitled to the mobility component, subject to the other provisions of Part 4 relating to entitlement` (JUST TRUE) (LIST JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 79(6) the person is entitled to the mobility component, subject to the other provisions of Part 4 relating to entitlement` (JUST TRUE) (LIST NOTHING) EQUALS NOTHING
#ASSERT `s 79(7) the person is not barred by regulations about unlikelihood of benefiting from enhanced mobility` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 79(7) the person is not barred by regulations about unlikelihood of benefiting from enhanced mobility` (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 79(7) the person is not barred by regulations about unlikelihood of benefiting from enhanced mobility` NOTHING EQUALS NOTHING

§ `s 80`

`s 80(1) determinations of the four questions` MEANS `s 80(1) determinations made in accordance with regulations` WITH
    `the answer to question (a)` IS JUST TRUE
    `the answer to question (b)` IS JUST FALSE
    `the answer to question (c)` IS NOTHING
    `the answer to question (d)` IS JUST TRUE

#ASSERT `s 80(1) the question as determined in accordance with regulations` `s 80(1)(a) daily living activities limited` `s 80(1) determinations of the four questions` EQUALS JUST TRUE
#ASSERT `s 80(1) the question as determined in accordance with regulations` `s 80(1)(b) daily living activities severely limited` `s 80(1) determinations of the four questions` EQUALS JUST FALSE
#ASSERT `s 80(1) the question as determined in accordance with regulations` `s 80(1)(c) mobility activities limited` `s 80(1) determinations of the four questions` EQUALS NOTHING
#ASSERT `s 80(1) the question as determined in accordance with regulations` `s 80(1)(d) mobility activities severely limited` `s 80(1) determinations of the four questions` EQUALS JUST TRUE

-- (5)(a) regulations may treat a negative determination as made if a person fails WITHOUT a good reason to comply with (4)
#ASSERT `s 80(5)(a) a negative determination is treated as made against the person` (JUST TRUE) TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 80(5)(a) a negative determination is treated as made against the person` (JUST TRUE) TRUE TRUE EQUALS NOTHING
#ASSERT `s 80(5)(a) a negative determination is treated as made against the person` (JUST TRUE) FALSE FALSE EQUALS NOTHING
#ASSERT `s 80(5)(a) a negative determination is treated as made against the person` (JUST FALSE) TRUE FALSE EQUALS NOTHING
#ASSERT `s 80(5)(a) a negative determination is treated as made against the person` NOTHING TRUE FALSE EQUALS NOTHING

-- (6) a "negative determination" means a determination that the person does not meet the requirements of 78(1)(a),(b) / (2)(a),(b) or 79(1)(a)-(c) / (2)(a)-(c)
#ASSERT `s 80(6) the determination is a negative determination` `s 80(6)(a) a finding that the person does not meet the requirements of section 78(1)(a) and (b) or (2)(a) and (b)` EQUALS JUST TRUE
#ASSERT `s 80(6) the determination is a negative determination` `s 80(6)(b) a finding that the person does not meet the requirements of section 79(1)(a) to (c) or (2)(a) to (c)` EQUALS JUST TRUE
#ASSERT `s 80(6) the determination is a negative determination` `s 80(6) any other determination` EQUALS JUST FALSE

§ `s 81(2) and (3)(a) definitions`

#ASSERT `s 81(2) the relevant ability` `daily living component` EQUALS "the person's ability to carry out daily living activities"
#ASSERT `s 81(2) the relevant ability` `mobility component` EQUALS "the person's ability to carry out mobility activities"
#ASSERT `s 81(3)(a) the assessment is an assessment for the purposes of section 81(1)` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 81(3)(a) the assessment is an assessment for the purposes of section 81(1)` (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 81(3)(a) the assessment is an assessment for the purposes of section 81(1)` NOTHING EQUALS NOTHING

§ `s 81`

-- (3)(b) the previous 3 months ending with the prescribed date, (3)(c) the next 9 months beginning with the day after it.
-- Prescribed date 15 June 2026: previous = 16 March 2026 to 15 June 2026; next = 16 June 2026 to 15 March 2027.
`s 81(3) previous 3 months for 15 June 2026` MEANS `s 81(3)(b) the previous 3 months ending with the prescribed date` (Date 15 6 2026)
`s 81(3) next 9 months for 15 June 2026` MEANS `s 81(3)(c) the next 9 months beginning with the day after the prescribed date` (Date 15 6 2026)
#ASSERT `s 81(3) previous 3 months for 15 June 2026`'s `first day` EQUALS Date 16 3 2026
#ASSERT `s 81(3) previous 3 months for 15 June 2026`'s `last day` EQUALS Date 15 6 2026
#ASSERT `s 81(3) next 9 months for 15 June 2026`'s `first day` EQUALS Date 16 6 2026
#ASSERT `s 81(3) next 9 months for 15 June 2026`'s `last day` EQUALS Date 15 3 2027

-- a prescribed date at the end of a month: whole calendar months. 31 May 2026: previous = 1 March to 31 May; next = 1 June 2026 to 28 February 2027.
`s 81(3) previous 3 months for 31 May 2026` MEANS `s 81(3)(b) the previous 3 months ending with the prescribed date` (Date 31 5 2026)
`s 81(3) next 9 months for 31 May 2026` MEANS `s 81(3)(c) the next 9 months beginning with the day after the prescribed date` (Date 31 5 2026)
#ASSERT `s 81(3) previous 3 months for 31 May 2026`'s `first day` EQUALS Date 1 3 2026
#ASSERT `s 81(3) next 9 months for 31 May 2026`'s `first day` EQUALS Date 1 6 2026
#ASSERT `s 81(3) next 9 months for 31 May 2026`'s `last day` EQUALS Date 28 2 2027

-- 28 February 2026 is the last day of a month: previous = 1 December 2025 to 28 February 2026; next = 1 March 2026 to 30 November 2026
`s 81(3) previous 3 months for 28 February 2026` MEANS `s 81(3)(b) the previous 3 months ending with the prescribed date` (Date 28 2 2026)
`s 81(3) next 9 months for 28 February 2026` MEANS `s 81(3)(c) the next 9 months beginning with the day after the prescribed date` (Date 28 2 2026)
#ASSERT `s 81(3) previous 3 months for 28 February 2026`'s `first day` EQUALS Date 1 12 2025
#ASSERT `s 81(3) next 9 months for 28 February 2026`'s `first day` EQUALS Date 1 3 2026
#ASSERT `s 81(3) next 9 months for 28 February 2026`'s `last day` EQUALS Date 30 11 2026

-- the helper: 9 months beginning 31 May end on the last day of February (no 31 February); 12 months beginning 29 February 2024 end on 28 February 2025
#ASSERT `s 81(3) the last day of the months beginning with the day` (Date 31 5 2026) 9 EQUALS Date 28 2 2027
#ASSERT `s 81(3) the last day of the months beginning with the day` (Date 29 2 2024) 12 EQUALS Date 28 2 2025
#ASSERT `s 81(3) the last day of the months beginning with the day` (Date 16 6 2026) 9 EQUALS Date 15 3 2027

-- (1)(a) and (b): which limb a time belongs to, on both sides of each edge (prescribed date 15 June 2026)
#ASSERT `s 81(1)(a) the time is within the previous 3 months` (Date 16 3 2026) (Date 15 6 2026)
#ASSERT NOT (`s 81(1)(a) the time is within the previous 3 months` (Date 15 3 2026) (Date 15 6 2026))
#ASSERT `s 81(1)(a) the time is within the previous 3 months` (Date 15 6 2026) (Date 15 6 2026)
#ASSERT NOT (`s 81(1)(a) the time is within the previous 3 months` (Date 16 6 2026) (Date 15 6 2026))
#ASSERT `s 81(1)(b) the time is within the next 9 months` (Date 16 6 2026) (Date 15 6 2026)
#ASSERT NOT (`s 81(1)(b) the time is within the next 9 months` (Date 15 6 2026) (Date 15 6 2026))
#ASSERT `s 81(1)(b) the time is within the next 9 months` (Date 15 3 2027) (Date 15 6 2026)
#ASSERT NOT (`s 81(1)(b) the time is within the next 9 months` (Date 16 3 2027) (Date 15 6 2026))

-- (1) both limbs -> met; either fails -> not met (fork F-81-1)
#ASSERT `s 81(1) the person meets the required period condition on the usual test` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 81(1) the person meets the required period condition on the usual test` TRUE FALSE EQUALS JUST FALSE
#ASSERT `s 81(1) the person meets the required period condition on the usual test` FALSE TRUE EQUALS JUST FALSE
#ASSERT `s 81(1) the person meets the required period condition on the usual test` FALSE FALSE EQUALS JUST FALSE

-- (4) a prescribed case is decided by the regulations' own provision; otherwise the usual test; unknown is not covered
#ASSERT `s 81(4) the person meets the required period condition` (JUST TRUE) (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 81(4) the person meets the required period condition` (JUST TRUE) (JUST TRUE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 81(4) the person meets the required period condition` (JUST FALSE) (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 81(4) the person meets the required period condition` (JUST FALSE) (JUST FALSE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 81(4) the person meets the required period condition` NOTHING (JUST TRUE) (JUST TRUE) EQUALS NOTHING

§ `s 82`

-- (4) terminally ill: progressive disease AND death can reasonably be expected within 12 months. Time 15 January 2026: the 12 months end on 14 January 2027.
#ASSERT `s 82(4) the last day of the 12 months beginning with the time` (Date 15 1 2026) EQUALS Date 14 1 2027
#ASSERT `s 82(4) the person is terminally ill at the time` TRUE (Date 15 1 2026) (Date 14 1 2027) EQUALS JUST TRUE
#ASSERT `s 82(4) the person is terminally ill at the time` TRUE (Date 15 1 2026) (Date 15 1 2027) EQUALS JUST FALSE
#ASSERT `s 82(4) the person is terminally ill at the time` TRUE (Date 15 1 2026) (Date 15 1 2026) EQUALS JUST TRUE
#ASSERT `s 82(4) the person is terminally ill at the time` FALSE (Date 15 1 2026) (Date 14 1 2027) EQUALS JUST FALSE
#ASSERT `s 82(4) the person is terminally ill at the time` TRUE (Date 29 2 2024) (Date 28 2 2025) EQUALS JUST TRUE
#ASSERT `s 82(4) the person is terminally ill at the time` TRUE (Date 29 2 2024) (Date 1 3 2025) EQUALS JUST FALSE

-- (1) the section applies to a person who is terminally ill AND has claimed expressly on that ground
#ASSERT `s 82(1) this section applies to the person` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 82(1) this section applies to the person` (JUST TRUE) FALSE EQUALS NOTHING
#ASSERT `s 82(1) this section applies to the person` (JUST FALSE) TRUE EQUALS NOTHING
#ASSERT `s 82(1) this section applies to the person` NOTHING TRUE EQUALS NOTHING

-- (2) enhanced rate, and (accordingly) section 78(1) and (2) do not apply
#ASSERT `s 82(2) the person is entitled to the daily living component at the enhanced rate` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 82(2) the person is entitled to the daily living component at the enhanced rate` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 82(2) the person is entitled to the daily living component at the enhanced rate` NOTHING EQUALS NOTHING
#ASSERT `s 82(2) section 78(1) and (2) apply to the person` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 82(2) section 78(1) and (2) apply to the person` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 82(2) section 78(1) and (2) apply to the person` NOTHING EQUALS NOTHING
#ASSERT `s 82(2) the person is entitled to the daily living component at the enhanced rate, section 82 displacing section 78(2)` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 82(2) the person is entitled to the daily living component at the enhanced rate, section 82 displacing section 78(2)` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 82(2) the person is entitled to the daily living component at the enhanced rate, section 82 displacing section 78(2)` NOTHING (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 82(2) the person is entitled to the daily living component at the enhanced rate, section 82 displacing section 78(2)` NOTHING NOTHING EQUALS NOTHING

-- (3) section 79(1)(c) and (2)(c) do not apply to a person to whom the section applies
-- the result under section 78(1), section 82 displacing it: no entitlement under 78(1) where section 82 applies
#ASSERT `s 82(2) the result under section 78(1), section 82 displacing section 78(1)` (JUST TRUE) (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 82(2) the result under section 78(1), section 82 displacing section 78(1)` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 82(2) the result under section 78(1), section 82 displacing section 78(1)` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 82(2) the result under section 78(1), section 82 displacing section 78(1)` NOTHING (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 82(2) the result under section 78(1), section 82 displacing section 78(1)` NOTHING NOTHING EQUALS NOTHING
#ASSERT `s 82(3) the required period condition of section 79(1)(c) and (2)(c) applies to the person` (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 82(3) the required period condition of section 79(1)(c) and (2)(c) applies to the person` (JUST FALSE) EQUALS NOTHING
#ASSERT `s 82(3) the required period condition of section 79(1)(c) and (2)(c) applies to the person` NOTHING EQUALS NOTHING
-- the limb as it stands: dropped (satisfied) where section 82 applies; otherwise the caller's result
#ASSERT `s 82(3) the required period condition limb of section 79(1)(c) and (2)(c), as it stands for the person` (JUST TRUE) (JUST FALSE) EQUALS JUST TRUE
#ASSERT `s 82(3) the required period condition limb of section 79(1)(c) and (2)(c), as it stands for the person` (JUST TRUE) NOTHING EQUALS JUST TRUE
#ASSERT `s 82(3) the required period condition limb of section 79(1)(c) and (2)(c), as it stands for the person` (JUST FALSE) (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 82(3) the required period condition limb of section 79(1)(c) and (2)(c), as it stands for the person` (JUST FALSE) (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 82(3) the required period condition limb of section 79(1)(c) and (2)(c), as it stands for the person` NOTHING NOTHING EQUALS NOTHING

-- (5) a claim on another's behalf, expressly on the ground of terminal illness, is regarded as that person's claim even without their knowledge or authority
#ASSERT `s 82(5) the person on whose behalf the claim purports to be made is regarded as making the claim` TRUE TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 82(5) the person on whose behalf the claim purports to be made is regarded as making the claim` TRUE TRUE FALSE EQUALS JUST TRUE
#ASSERT `s 82(5) the person on whose behalf the claim purports to be made is regarded as making the claim` TRUE FALSE TRUE EQUALS NOTHING
#ASSERT `s 82(5) the person on whose behalf the claim purports to be made is regarded as making the claim` FALSE TRUE TRUE EQUALS NOTHING

-- (6) "the enhanced rate" has the meaning given by section 78(3) (invented test rate 20)
#ASSERT `s 82(6) the enhanced rate for the purposes of section 82(2)` (JUST 20) EQUALS JUST 20
#ASSERT `s 82(6) the enhanced rate for the purposes of section 82(2)` NOTHING EQUALS NOTHING

§ `s 83`

-- (2) the relevant age is pensionable age or, if higher, 65: both must be reached
#ASSERT NOT (`s 83(2) the person has reached the relevant age` `s 83(2) a person aged 64` TRUE)
#ASSERT `s 83(2) the person has reached the relevant age` `s 83(2) a person aged 65` TRUE
#ASSERT NOT (`s 83(2) the person has reached the relevant age` `s 83(2) a person aged 65` FALSE)
#ASSERT `s 83(2) the person has reached the relevant age` `s 83(2) a person aged 66` TRUE
-- (1) not entitled for any period after the person reaches the relevant age; (3) subject to exceptions regulations provide
#ASSERT `s 83(1) the person is not barred by having reached the relevant age` `s 83(2) a person aged 64` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 83(1) the person is not barred by having reached the relevant age` `s 83(2) a person aged 65` FALSE NOTHING EQUALS JUST TRUE
#ASSERT `s 83(1) the person is not barred by having reached the relevant age` `s 83(2) a person aged 65` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 83(1) the person is not barred by having reached the relevant age` `s 83(2) a person aged 66` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 83(1) the person is not barred by having reached the relevant age` `s 83(2) a person aged 65` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 83(1) the person is not barred by having reached the relevant age` `s 83(2) a person aged 65` TRUE NOTHING EQUALS NOTHING

§ `s 84`

#ASSERT `s 84(2) the instrument is a relevant EU Regulation` `s 84(2)(a) Council Regulation (EC) No 1408/71 of 14 June 1971` EQUALS JUST TRUE
#ASSERT `s 84(2) the instrument is a relevant EU Regulation` `s 84(2)(b) Regulation (EC) No 883/2004 of the European Parliament and of the Council of 29 April 2004` EQUALS JUST TRUE
#ASSERT `s 84(2) the instrument is a relevant EU Regulation` `s 84(2) any other instrument` EQUALS NOTHING
-- (1) not entitled to the daily living component unless the UK is competent, where a relevant EU Regulation applies
#ASSERT `s 84(1) the person is not barred from the daily living component by the United Kingdom not being the competent state` FALSE FALSE EQUALS JUST TRUE
#ASSERT `s 84(1) the person is not barred from the daily living component by the United Kingdom not being the competent state` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 84(1) the person is not barred from the daily living component by the United Kingdom not being the competent state` TRUE FALSE EQUALS JUST FALSE
