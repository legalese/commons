IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra2-s54-esa-commitment`

-- wra2-tests-s54-esa-commitment.l4: tests for ss 54 to 56 (WRA2007 1(3)(aa), 1C, Sch 2 para 4A, 13(8), 16A).
-- Expected values are written from the text of the Act (inputs/ukpga-2012-5.txt lines 923-958), not from the output.

§ `s 54(2) WRA2007 1(3)(aa) and 1C(6)`

#ASSERT `s 54(2) WRA2007 1(3)(aa) the claimant satisfies the condition of having accepted a claimant commitment` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 54(2) WRA2007 1(3)(aa) the claimant satisfies the condition of having accepted a claimant commitment` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 54(2) WRA2007 1(3)(aa) the claimant satisfies the condition of having accepted a claimant commitment` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 54(2) WRA2007 1(3)(aa) the claimant satisfies the condition of having accepted a claimant commitment` FALSE NOTHING EQUALS NOTHING
#ASSERT `s 54(6) WRA2007 Sch 2 para 4A the person may be entitled without having accepted a claimant commitment` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 54(6) WRA2007 Sch 2 para 4A the person may be entitled without having accepted a claimant commitment` NOTHING EQUALS NOTHING

§ `WRA2007 1C: the claimant commitment`

#ASSERT `s 54 WRA2007 1C(1) the award is an award of an employment and support allowance` `contributory employment and support allowance`
#ASSERT `s 54 WRA2007 1C(1) the award is an award of an employment and support allowance` `income-related employment and support allowance`
#ASSERT NOT (`s 54 WRA2007 1C(1) the award is an award of an employment and support allowance` `income-based jobseeker's allowance`)
#ASSERT `s 54 WRA2007 1C(1) the document is a claimant commitment` TRUE `contributory employment and support allowance`
#ASSERT NOT (`s 54 WRA2007 1C(1) the document is a claimant commitment` FALSE `contributory employment and support allowance`)
#ASSERT NOT (`s 54 WRA2007 1C(1) the document is a claimant commitment` TRUE `income support`)
#ASSERT `s 54 WRA2007 1C(2) the claimant commitment was prepared by the Secretary of State` `the Secretary of State` EQUALS JUST TRUE
#ASSERT `s 54 WRA2007 1C(2) the claimant commitment was prepared by the Secretary of State` `an authorised person` EQUALS JUST TRUE
#ASSERT `s 54 WRA2007 1C(2) the claimant commitment was prepared by the Secretary of State` `an employment officer` EQUALS NOTHING
#ASSERT `s 54 WRA2007 1C(3) the claimant commitment is in the form the Secretary of State thinks fit` TRUE
#ASSERT NOT (`s 54 WRA2007 1C(3) the claimant commitment is in the form the Secretary of State thinks fit` FALSE)
#ASSERT `s 54 WRA2007 1C(4) the claimant commitment includes what the subsection requires` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 54 WRA2007 1C(4) the claimant commitment includes what the subsection requires` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 54 WRA2007 1C(4) the claimant commitment includes what the subsection requires` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 54 WRA2007 1C(4) the claimant commitment includes what the subsection requires` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 54 WRA2007 1C(4) the claimant commitment includes what the subsection requires` NOTHING FALSE EQUALS JUST FALSE
#ASSERT `s 54 WRA2007 1C(5) the claimant accepts the claimant commitment` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 54 WRA2007 1C(5) the claimant accepts the claimant commitment` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 54 WRA2007 1C(5) the claimant accepts the claimant commitment` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 54 WRA2007 1C(5) the claimant accepts the claimant commitment` FALSE (JUST TRUE) EQUALS JUST FALSE
#ASSERT `s 54 WRA2007 1C(5) the claimant accepts the claimant commitment` FALSE NOTHING EQUALS JUST FALSE

§ `s 55 WRA2007 13(8)`

#ASSERT `s 55 WRA2007 13(8) the activity is within the reference to activity in subsection (7)` `s 55 WRA2007 13(8) work experience or a work placement` EQUALS JUST TRUE
#ASSERT `s 55 WRA2007 13(8) the activity is within the reference to activity in subsection (7)` `s 55 WRA2007 13(7) some other activity` EQUALS NOTHING

§ `s 56 WRA2007 16A(1)`

#ASSERT `s 56 WRA2007 16A(1) regulations may provide for hardship payments to the person` TRUE TRUE EQUALS JUST TRUE
#ASSERT `s 56 WRA2007 16A(1) regulations may provide for hardship payments to the person` TRUE FALSE EQUALS NOTHING
#ASSERT `s 56 WRA2007 16A(1) regulations may provide for hardship payments to the person` FALSE TRUE EQUALS NOTHING
#ASSERT `s 56 WRA2007 16A(1) regulations may provide for hardship payments to the person` FALSE FALSE EQUALS NOTHING


§ `s 56 WRA2007 16A(2): hardship regulations`

#ASSERT `s 56 WRA2007 16A(2) regulations may make provision as to that matter` `s 56 WRA2007 16A(2)(a) circumstances in which a person is to be treated as being or not being in hardship` EQUALS JUST TRUE
#ASSERT `s 56 WRA2007 16A(2) regulations may make provision as to that matter` `s 56 WRA2007 16A(2)(b) matters to be taken into account in determining whether a person is or will be in hardship` EQUALS JUST TRUE
#ASSERT `s 56 WRA2007 16A(2) regulations may make provision as to that matter` `s 56 WRA2007 16A(2)(c) requirements or conditions to be met by a person in order to receive hardship payments` EQUALS JUST TRUE
#ASSERT `s 56 WRA2007 16A(2) regulations may make provision as to that matter` `s 56 WRA2007 16A(2)(d) the amount or rate of hardship payments` EQUALS JUST TRUE
#ASSERT `s 56 WRA2007 16A(2) regulations may make provision as to that matter` `s 56 WRA2007 16A(2)(e) the period for which hardship payments may be made` EQUALS JUST TRUE
#ASSERT `s 56 WRA2007 16A(2) regulations may make provision as to that matter` `s 56 WRA2007 16A(2) some other matter` EQUALS NOTHING
