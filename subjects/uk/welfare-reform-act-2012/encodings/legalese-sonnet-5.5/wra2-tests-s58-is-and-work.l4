IMPORT prelude
IMPORT daydate
IMPORT `wra-core`
IMPORT `wra2-s58-is-and-work`

-- wra2-tests-s58-is-and-work.l4: tests for ss 58 to 63.
-- Expected values are written from the text of the Act (inputs/ukpga-2012-5.txt lines 1133-1236), not from the output.

§ `s 58 lone parents`
-- line 1136: lone parents with a child under 5 are the category to be included in regulations

#ASSERT `s 58(2) SSCBA 124(1A)(b) the person is in the category to be included in regulations as entitled to income support` (JUST TRUE) 4 EQUALS JUST TRUE
#ASSERT `s 58(2) SSCBA 124(1A)(b) the person is in the category to be included in regulations as entitled to income support` (JUST TRUE) 0 EQUALS JUST TRUE
#ASSERT `s 58(2) SSCBA 124(1A)(b) the person is in the category to be included in regulations as entitled to income support` (JUST TRUE) 5 EQUALS NOTHING
#ASSERT `s 58(2) SSCBA 124(1A)(b) the person is in the category to be included in regulations as entitled to income support` (JUST FALSE) 3 EQUALS NOTHING
#ASSERT `s 58(2) SSCBA 124(1A)(b) the person is in the category to be included in regulations as entitled to income support` NOTHING 3 EQUALS NOTHING

§ `s 59 claimant commitment for income support`
-- lines 1141-1142, 1154: the condition of having accepted a claimant commitment, and treating it as satisfied

#ASSERT `s 59(2)(a) SSCBA 124(1)(ea) the claimant satisfies the condition of having accepted a claimant commitment` TRUE NOTHING EQUALS JUST TRUE
#ASSERT `s 59(2)(a) SSCBA 124(1)(ea) the claimant satisfies the condition of having accepted a claimant commitment` FALSE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 59(2)(a) SSCBA 124(1)(ea) the claimant satisfies the condition of having accepted a claimant commitment` FALSE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 59(2)(a) SSCBA 124(1)(ea) the claimant satisfies the condition of having accepted a claimant commitment` FALSE NOTHING EQUALS NOTHING
#ASSERT `s 59(2)(b) SSCBA 124(1C) the person may be entitled to income support without having accepted a claimant commitment` (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 59(2)(b) SSCBA 124(1C) the person may be entitled to income support without having accepted a claimant commitment` NOTHING EQUALS NOTHING
-- line 1147: a record of the claimant's responsibilities in relation to an award of income support
#ASSERT `s 59(3) SSCBA 124A(1) the award is an award of income support` `income support`
#ASSERT NOT (`s 59(3) SSCBA 124A(1) the award is an award of income support` `universal credit`)
#ASSERT NOT (`s 59(3) SSCBA 124A(1) the award is an award of income support` `income-based jobseeker's allowance`)
#ASSERT `s 59(3) SSCBA 124A(1) the document is a claimant commitment` TRUE `income support`
#ASSERT NOT (`s 59(3) SSCBA 124A(1) the document is a claimant commitment` FALSE `income support`)
#ASSERT NOT (`s 59(3) SSCBA 124A(1) the document is a claimant commitment` TRUE `contributory employment and support allowance`)
-- line 1148 with 1157: prepared by the Secretary of State (or an authorised person under SSAA 2G(1)(d))
#ASSERT `s 59(3) SSCBA 124A(2) the claimant commitment was prepared by the Secretary of State` `the Secretary of State` EQUALS JUST TRUE
#ASSERT `s 59(3) SSCBA 124A(2) the claimant commitment was prepared by the Secretary of State` `an authorised person` EQUALS JUST TRUE
#ASSERT `s 59(3) SSCBA 124A(2) the claimant commitment was prepared by the Secretary of State` `an employment officer` EQUALS NOTHING
-- line 1149
#ASSERT `s 59(3) SSCBA 124A(3) the claimant commitment is in the form the Secretary of State thinks fit` TRUE
#ASSERT NOT (`s 59(3) SSCBA 124A(3) the claimant commitment is in the form the Secretary of State thinks fit` FALSE)
-- lines 1150-1152: (a) any prescribed information, (b) any other information the Secretary of State considers appropriate
#ASSERT `s 59(3) SSCBA 124A(4) the claimant commitment includes what the subsection requires` (JUST TRUE) TRUE EQUALS JUST TRUE
#ASSERT `s 59(3) SSCBA 124A(4) the claimant commitment includes what the subsection requires` (JUST FALSE) TRUE EQUALS JUST FALSE
#ASSERT `s 59(3) SSCBA 124A(4) the claimant commitment includes what the subsection requires` NOTHING TRUE EQUALS NOTHING
#ASSERT `s 59(3) SSCBA 124A(4) the claimant commitment includes what the subsection requires` (JUST TRUE) FALSE EQUALS JUST FALSE
#ASSERT `s 59(3) SSCBA 124A(4) the claimant commitment includes what the subsection requires` NOTHING FALSE EQUALS JUST FALSE
-- line 1153
#ASSERT `s 59(3) SSCBA 124A(5) the claimant accepts the claimant commitment` TRUE (JUST TRUE) EQUALS JUST TRUE
#ASSERT `s 59(3) SSCBA 124A(5) the claimant accepts the claimant commitment` TRUE (JUST FALSE) EQUALS JUST FALSE
#ASSERT `s 59(3) SSCBA 124A(5) the claimant accepts the claimant commitment` TRUE NOTHING EQUALS NOTHING
#ASSERT `s 59(3) SSCBA 124A(5) the claimant accepts the claimant commitment` FALSE NOTHING EQUALS JUST FALSE

